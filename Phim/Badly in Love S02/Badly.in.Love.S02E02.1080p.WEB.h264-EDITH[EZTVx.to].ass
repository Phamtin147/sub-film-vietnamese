Dialogue: 0,0:00:06.01,0:00:07.72,Default,,0,0,0,,- Được rồi, ra ngoài thôi.\N- Được.
Dialogue: 0,0:00:07.80,0:00:09.39,Default,,0,0,0,,- Thế nhé.\N- Chào.
Dialogue: 0,0:00:09.47,0:00:10.30,Default,,0,0,0,,XẢ HƠI
Dialogue: 0,0:00:10.39,0:00:11.39,Default,,0,0,0,,Tôi về rồi.
Dialogue: 0,0:00:11.47,0:00:12.51,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:00:12.60,0:00:14.69,Default,,0,0,0,,Xông hơi chẳng thần kỳ gì cả.
Dialogue: 0,0:00:14.76,0:00:16.18,Default,,0,0,0,,- Hả?\N- Tại sao?
Dialogue: 0,0:00:16.27,0:00:17.65,Default,,0,0,0,,Kiểu…
Dialogue: 0,0:00:17.73,0:00:20.02,Default,,0,0,0,,Tôi hỏi: "Nếu anh muốn ăn thịt nướng,
Dialogue: 0,0:00:20.10,0:00:22.89,Default,,0,0,0,,còn bạn gái muốn ăn sushi,\Nthì anh sẽ làm gì?"
Dialogue: 0,0:00:22.98,0:00:24.23,Default,,0,0,0,,Nhưng rồi anh ta kiểu…
Dialogue: 0,0:00:24.32,0:00:25.16,Default,,0,0,0,,RURU\NNGƯỜI MẪU
Dialogue: 0,0:00:25.23,0:00:26.82,Default,,0,0,0,,"Tôi muốn ăn thịt nướng,
Dialogue: 0,0:00:26.90,0:00:28.28,Default,,0,0,0,,nên tôi sẽ ăn cái đó".
Dialogue: 0,0:00:28.36,0:00:29.70,Default,,0,0,0,,"Tôi không nhượng bộ".
Dialogue: 0,0:00:29.78,0:00:32.78,Default,,0,0,0,,- Phải rồi.\N- Thật sao? Dã man.
Dialogue: 0,0:00:32.87,0:00:35.75,Default,,0,0,0,,Ừ. Tôi không ngờ tới sự khác biệt đó
Dialogue: 0,0:00:35.83,0:00:37.92,Default,,0,0,0,,khi nói chuyện riêng với anh ta.
Dialogue: 0,0:00:38.00,0:00:40.04,Default,,0,0,0,,Ừ, nói chuyện riêng khác mà.
Dialogue: 0,0:00:40.12,0:00:42.29,Default,,0,0,0,,Eo. Anh ta trẻ con hơn tôi tưởng.
Dialogue: 0,0:00:42.38,0:00:43.21,Default,,0,0,0,,Có vậy thôi!
Dialogue: 0,0:00:43.29,0:00:46.42,Default,,0,0,0,,Anh ta trẻ con hơn tôi tưởng.
Dialogue: 0,0:00:46.50,0:00:48.04,Default,,0,0,0,,Tôi không biết nữa…
Dialogue: 0,0:00:48.13,0:00:49.55,Default,,0,0,0,,ASSUN\NDOANH NHÂN/TIẾP VIÊN
Dialogue: 0,0:00:49.63,0:00:50.84,Default,,0,0,0,,Như vậy là không được.
Dialogue: 0,0:00:50.93,0:00:51.93,Default,,0,0,0,,Khá là thất vọng.
Dialogue: 0,0:00:52.01,0:00:55.26,Default,,0,0,0,,Ma-kun chỉ được cái mã thôi.
Dialogue: 0,0:00:59.06,0:01:00.35,Default,,0,0,0,,Thư tình làm tôi xốn xang.
Dialogue: 0,0:01:00.44,0:01:01.36,Default,,0,0,0,,HIKARU\NTIẾP VIÊN
Dialogue: 0,0:01:01.44,0:01:02.65,Default,,0,0,0,,Hẳn rồi.
Dialogue: 0,0:01:02.73,0:01:04.36,Default,,0,0,0,,- Cô viết cho ai?\N- Tôi á?
Dialogue: 0,0:01:04.44,0:01:05.40,Default,,0,0,0,,TAI-CHAN\NTẠO MẪU TÓC
Dialogue: 0,0:01:05.48,0:01:07.57,Default,,0,0,0,,- Cậu ấy tưởng cô ấy viết cho mình.\N- Ừ.
Dialogue: 0,0:01:07.65,0:01:08.74,Default,,0,0,0,,Ồ, phải rồi.
Dialogue: 0,0:01:08.82,0:01:12.74,Default,,0,0,0,,Cho Ma-kun.
Dialogue: 0,0:01:14.16,0:01:16.25,Default,,0,0,0,,Khoan, vậy ai viết cho tôi nhỉ?
Dialogue: 0,0:01:16.91,0:01:18.62,Default,,0,0,0,,Rõ ràng rồi mà nhỉ?
Dialogue: 0,0:01:19.37,0:01:21.75,Default,,0,0,0,,Ồ, cô ấy à? Maririn?
Dialogue: 0,0:01:22.37,0:01:23.54,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:01:23.63,0:01:25.05,Default,,0,0,0,,Đúng rồi!
Dialogue: 0,0:01:25.96,0:01:28.30,Default,,0,0,0,,Tôi lại cứ cho là cô cơ.
Dialogue: 0,0:01:28.38,0:01:29.97,Default,,0,0,0,,Ra là vậy à?
Dialogue: 0,0:01:31.05,0:01:32.55,Default,,0,0,0,,Khoan, tôi vừa làm hỏng rồi à?
Dialogue: 0,0:01:32.63,0:01:33.88,Default,,0,0,0,,- Không hẳn?\N- Chắc chứ?
Dialogue: 0,0:01:33.97,0:01:35.56,Default,,0,0,0,,Chúng ta mới ở đây một ngày mà.
Dialogue: 0,0:01:35.64,0:01:36.85,Default,,0,0,0,,- Phải.\N- Mới một ngày.
Dialogue: 0,0:01:36.93,0:01:41.31,Default,,0,0,0,,Tôi đã nói rõ rằng tôi để ý đến cô chưa?
Dialogue: 0,0:01:42.27,0:01:43.10,Default,,0,0,0,,Cậu nói rồi.
Dialogue: 0,0:01:44.94,0:01:46.90,Default,,0,0,0,,Giờ tôi có hai lựa chọn.
Dialogue: 0,0:01:50.82,0:01:53.53,Default,,0,0,0,,Tôi làm gì cũng nhanh.\NCả việc bộc bạch nữa.
Dialogue: 0,0:01:53.61,0:01:54.44,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:01:54.53,0:01:55.57,Default,,0,0,0,,Vừa tốt vừa xấu.
Dialogue: 0,0:01:55.66,0:01:56.74,Default,,0,0,0,,Phải.
Dialogue: 0,0:01:57.28,0:01:58.41,Default,,0,0,0,,Tôi tốc độ lắm.
Dialogue: 0,0:01:59.16,0:02:01.66,Default,,0,0,0,,- Tốc độ?\N- Ừ, tôi đó.
Dialogue: 0,0:02:06.13,0:02:11.51,Default,,0,0,0,,Một phần trong tôi thấy Ruru thu hút\Nvì cô ấy là người mẫu.
Dialogue: 0,0:02:11.59,0:02:15.72,Default,,0,0,0,,Nhưng giờ tôi toàn tâm\Nđể ý đến Hikaru rồi.
Dialogue: 0,0:02:16.55,0:02:18.18,Default,,0,0,0,,Cô ấy leo hạng rồi.
Dialogue: 0,0:02:32.03,0:02:34.12,Default,,0,0,0,,CHƯƠNG TRÌNH HẸN HÒ THỰC TẾ CỦA TRẺ TRÂU
Dialogue: 0,0:02:35.03,0:02:37.28,Default,,0,0,0,,RAPPER ĐẾN TỪ SAGAMIHARA\NBẮN RAP TÌNH TỨ
Dialogue: 0,0:02:37.37,0:02:38.79,Default,,0,0,0,,ARI
Dialogue: 0,0:02:38.87,0:02:41.00,Default,,0,0,0,,NỮ TIẾP VIÊN KAWASAKI\NTÌM ĐÀN ÔNG CHÂN CHÍNH
Dialogue: 0,0:02:41.08,0:02:42.00,Default,,0,0,0,,HIKARU
Dialogue: 0,0:02:42.08,0:02:43.75,Default,,0,0,0,,CHỦ BAR KYOTO\NTẤT TAY VÌ BẠN GÁI
Dialogue: 0,0:02:45.04,0:02:46.67,Default,,0,0,0,,NGƯỜI ĐẸP NANIWA\NĐI TÌM TÌNH YÊU
Dialogue: 0,0:02:46.75,0:02:47.84,Default,,0,0,0,,MARIRIN
Dialogue: 0,0:02:47.92,0:02:49.30,Default,,0,0,0,,TRẺ TRÂU\NLỚN NHỜ CƠM TÙ
Dialogue: 0,0:02:49.38,0:02:50.51,Default,,0,0,0,,BO
Dialogue: 0,0:02:52.51,0:02:54.39,Default,,0,0,0,,VÕ SĨ MMA CỰU XÃ HỘI ĐEN\NTÌM KIẾM TRI KỶ
Dialogue: 0,0:02:54.47,0:02:55.85,Default,,0,0,0,,MA-KUN
Dialogue: 0,0:02:55.93,0:02:57.72,Default,,0,0,0,,TIẾP VIÊN NAGOYA\NCHỈNH ĐỐN ĐÀN ÔNG
Dialogue: 0,0:02:57.80,0:02:58.80,Default,,0,0,0,,ASSUN
Dialogue: 0,0:02:58.89,0:03:00.27,Default,,0,0,0,,NHÀ TẠO MẪU TÓC\NYÊU CUỒNG SI
Dialogue: 0,0:03:00.35,0:03:01.73,Default,,0,0,0,,TAI-CHAN
Dialogue: 0,0:03:01.81,0:03:03.02,Default,,0,0,0,,NGƯỜI MẪU\NTÌM TÌNH YÊU
Dialogue: 0,0:03:03.10,0:03:04.18,Default,,0,0,0,,RURU
Dialogue: 0,0:03:08.23,0:03:10.86,Default,,0,0,0,,CHIẾN ĐẤU ĐI SỢ CHI\NYÊU ĐI NGẠI CHI
Dialogue: 0,0:03:32.21,0:03:34.25,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN
Dialogue: 0,0:03:39.93,0:03:43.93,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN 2
Dialogue: 0,0:03:44.02,0:03:45.10,Default,,0,0,0,,Ăn thôi nào!
Dialogue: 0,0:03:45.18,0:03:47.10,Default,,0,0,0,,- Ăn nào!\N- Ăn nào!
Dialogue: 0,0:03:48.94,0:03:50.07,Default,,0,0,0,,Trông ngon ghê.
Dialogue: 0,0:03:50.15,0:03:51.28,Default,,0,0,0,,Mì Ý gì đây?
Dialogue: 0,0:03:51.36,0:03:52.44,Default,,0,0,0,,Carbonara?
Dialogue: 0,0:03:52.52,0:03:53.98,Default,,0,0,0,,- Đâu phải nhỉ?\N- Không phải à?
Dialogue: 0,0:03:54.07,0:03:56.36,Default,,0,0,0,,Hôm nay tìm hiểu Maririn kỹ hơn nhé.
Dialogue: 0,0:03:56.44,0:03:58.07,Default,,0,0,0,,- Đồng ý.\N- Tôi cũng thế.
Dialogue: 0,0:03:58.15,0:03:59.32,Default,,0,0,0,,MARIRIN (25)\NPHỤC VỤ BAR
Dialogue: 0,0:03:59.41,0:04:00.95,Default,,0,0,0,,Mà không có rượu á?
Dialogue: 0,0:04:01.03,0:04:02.16,Default,,0,0,0,,Không uống khó nói à?
Dialogue: 0,0:04:02.24,0:04:04.33,Default,,0,0,0,,Không, tôi không ngại chia sẻ, nhưng…
Dialogue: 0,0:04:04.41,0:04:06.08,Default,,0,0,0,,Cô sẽ lắng nghe tôi chứ?
Dialogue: 0,0:04:06.16,0:04:07.45,Default,,0,0,0,,- Có chứ.\N- Thế hả?
Dialogue: 0,0:04:07.54,0:04:10.04,Default,,0,0,0,,- Cô nữa, Maririn. Kể đi.\N- Ừ, giãi bày đi.
Dialogue: 0,0:04:10.96,0:04:13.88,Default,,0,0,0,,Không cần ép bản thân đâu.\NMới là ngày thứ hai mà.
Dialogue: 0,0:04:13.96,0:04:15.04,Default,,0,0,0,,Thật đó.
Dialogue: 0,0:04:15.13,0:04:16.51,Default,,0,0,0,,Khi nào muốn thì kể nha.
Dialogue: 0,0:04:16.59,0:04:18.51,Default,,0,0,0,,Chắc có rượu cô ấy mới thoải mái hơn.
Dialogue: 0,0:04:18.59,0:04:22.14,Default,,0,0,0,,Để dành lúc uống nha?\NKhông nhất thiết phải là hôm nay.
Dialogue: 0,0:04:22.22,0:04:23.05,Default,,0,0,0,,Ừ.
Dialogue: 0,0:04:26.02,0:04:27.77,Default,,0,0,0,,Sao thế này?
Dialogue: 0,0:04:27.85,0:04:29.64,Default,,0,0,0,,Khoan, tại sao nhỉ?
Dialogue: 0,0:04:31.15,0:04:32.40,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:04:32.48,0:04:33.90,Default,,0,0,0,,Lúc tôi nghĩ về quá khứ…
Dialogue: 0,0:04:37.61,0:04:39.28,Default,,0,0,0,,Không sao chứ, Maririn? Ổn chứ?
Dialogue: 0,0:04:39.36,0:04:40.36,Default,,0,0,0,,MA-KUN (28)\NVÕ SĨ MMA
Dialogue: 0,0:04:41.91,0:04:43.70,Default,,0,0,0,,Không phải kể luôn hôm nay đâu.
Dialogue: 0,0:04:43.78,0:04:44.95,Default,,0,0,0,,Đừng ép bản thân.
Dialogue: 0,0:04:45.03,0:04:45.86,Default,,0,0,0,,BO (27)\NTHỢ SƠN
Dialogue: 0,0:04:45.95,0:04:46.78,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:04:46.87,0:04:49.00,Default,,0,0,0,,Có lẽ không nên bắt đầu với "Sao rồi".
Dialogue: 0,0:04:49.08,0:04:50.42,Default,,0,0,0,,ARI (29)\NRAPPER/NGƯỜI MẪU
Dialogue: 0,0:04:50.50,0:04:53.00,Default,,0,0,0,,Ai mở đầu với "Sao rồi" chứ?
Dialogue: 0,0:04:53.08,0:04:55.21,Default,,0,0,0,,Chúng tôi nhìn thấy và cười phá lên.
Dialogue: 0,0:04:55.30,0:04:56.43,Default,,0,0,0,,Ai vậy?
Dialogue: 0,0:04:57.01,0:04:58.05,Default,,0,0,0,,- Hút thuốc đi.\N- Đi.
Dialogue: 0,0:04:58.13,0:05:00.34,Default,,0,0,0,,- Tôi muốn đi với Hikaru.\N- Đi thôi.
Dialogue: 0,0:05:01.76,0:05:02.80,Default,,0,0,0,,Đi không?
Dialogue: 0,0:05:04.22,0:05:05.05,Default,,0,0,0,,Đi nhé?
Dialogue: 0,0:05:10.27,0:05:13.06,Default,,0,0,0,,SỐNG ĐI NGẠI CHI
Dialogue: 0,0:05:13.56,0:05:15.90,Default,,0,0,0,,Trong lớp à?
Dialogue: 0,0:05:15.98,0:05:17.19,Default,,0,0,0,,Hoài niệm nhỉ?
Dialogue: 0,0:05:21.20,0:05:22.37,Default,,0,0,0,,Đối mặt nói chuyện nha.
Dialogue: 0,0:05:22.45,0:05:23.53,Default,,0,0,0,,Đối mặt à?
Dialogue: 0,0:05:23.61,0:05:26.28,Default,,0,0,0,,Ừ. Sao ban nãy cô khóc vậy?
Dialogue: 0,0:05:28.24,0:05:30.20,Default,,0,0,0,,- Cô không phải nói đâu.\N- Tôi biết mà.
Dialogue: 0,0:05:34.33,0:05:35.25,Default,,0,0,0,,À thì…
Dialogue: 0,0:05:36.21,0:05:38.17,Default,,0,0,0,,Tôi không biết phải nói từ đâu.
Dialogue: 0,0:05:38.25,0:05:39.38,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:05:40.21,0:05:43.09,Default,,0,0,0,,Nhưng bạn trai cũ của tôi toàn bạo hành.
Dialogue: 0,0:05:43.18,0:05:45.10,Default,,0,0,0,,Thằng tồi tệ nhất trong đó
Dialogue: 0,0:05:45.76,0:05:48.60,Default,,0,0,0,,là thành viên băng đảng tôi từng hẹn hò.
Dialogue: 0,0:05:48.68,0:05:51.68,Default,,0,0,0,,Hắn tóm lấy đầu tôi…
Dialogue: 0,0:05:51.77,0:05:54.02,Default,,0,0,0,,Trong nhà tắm, hắn kiểu…
Dialogue: 0,0:05:54.10,0:05:58.02,Default,,0,0,0,,"Tao sẽ rút sạch máu mày\Nvà nhổ hết móng tay mày ra,
Dialogue: 0,0:05:58.69,0:06:00.90,Default,,0,0,0,,nên cút mẹ mày đi".
Dialogue: 0,0:06:01.61,0:06:07.16,Default,,0,0,0,,Hắn từng giết người rồi,\Nvà hắn còn dí súng vào mặt tôi.
Dialogue: 0,0:06:07.78,0:06:11.78,Default,,0,0,0,,Hắn lấy hết tiền và mọi thứ tôi có.
Dialogue: 0,0:06:11.87,0:06:13.71,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:06:14.29,0:06:17.92,Default,,0,0,0,,Chỉ là…
Dialogue: 0,0:06:19.92,0:06:22.21,Default,,0,0,0,,Tôi chưa từng được ai yêu.
Dialogue: 0,0:06:29.18,0:06:32.35,Default,,0,0,0,,Tôi không hiểu nổi\Ntại sao cuộc đời lại khó khăn đến vậy.
Dialogue: 0,0:06:33.23,0:06:36.78,Default,,0,0,0,,Tôi còn không biết hắn là ai.\NMọi thứ, đến cái tên cũng là giả.
Dialogue: 0,0:06:38.11,0:06:39.32,Default,,0,0,0,,Và…
Dialogue: 0,0:06:40.73,0:06:43.32,Default,,0,0,0,,Và ta không thể\Ncứ thản nhiên kể chuyện nặng nề.
Dialogue: 0,0:06:46.61,0:06:50.41,Default,,0,0,0,,Việc đó khiến tôi\Ntrở nên u sầu và khép kín.
Dialogue: 0,0:06:50.49,0:06:52.24,Default,,0,0,0,,Tôi chẳng biết gì về yêu đương.
Dialogue: 0,0:06:52.33,0:06:56.21,Default,,0,0,0,,Tôi sợ bị đánh,\Nnên chuyện gì tôi cũng nghe theo.
Dialogue: 0,0:06:56.83,0:07:00.50,Default,,0,0,0,,Nhưng cuối cùng chỉ toàn\Nnghe chuyện của người khác.
Dialogue: 0,0:07:00.59,0:07:03.09,Default,,0,0,0,,Nên tôi ngừng mở lòng.
Dialogue: 0,0:07:08.72,0:07:10.85,Default,,0,0,0,,Chuyện đó…
Dialogue: 0,0:07:13.52,0:07:15.15,Default,,0,0,0,,Xin lỗi. Cảm ơn cậu.
Dialogue: 0,0:07:15.98,0:07:18.77,Default,,0,0,0,,Ừ, tôi hiểu vì sao cô\Nkhông thể nói gì ban nãy.
Dialogue: 0,0:07:19.86,0:07:21.74,Default,,0,0,0,,Nhưng dù vậy…
Dialogue: 0,0:07:22.73,0:07:25.48,Default,,0,0,0,,tôi cũng muốn được ai đó yêu.
Dialogue: 0,0:07:26.57,0:07:29.03,Default,,0,0,0,,Tôi không biết tình yêu đích thực là gì.
Dialogue: 0,0:07:30.91,0:07:33.46,Default,,0,0,0,,Và tôi nghĩ tại đây…
Dialogue: 0,0:07:35.71,0:07:38.42,Default,,0,0,0,,tôi sẽ tìm được ai đó\Nsẵn lòng nói lời yêu tôi.
Dialogue: 0,0:07:40.17,0:07:41.63,Default,,0,0,0,,Cảm ơn vì đã nhìn vào mắt tôi
Dialogue: 0,0:07:41.71,0:07:43.21,Default,,0,0,0,,- và lắng nghe.\N- Không có gì.
Dialogue: 0,0:07:44.96,0:07:48.21,Default,,0,0,0,,Nói ra mà cảm thấy nhẹ lòng hơn hẳn.
Dialogue: 0,0:07:48.30,0:07:49.84,Default,,0,0,0,,Tôi không hay kể lể đâu.
Dialogue: 0,0:07:51.76,0:07:53.47,Default,,0,0,0,,- Nặng nề nhỉ?\N- Không hề.
Dialogue: 0,0:07:53.56,0:07:55.10,Default,,0,0,0,,- Thật à?\N- Ừ.
Dialogue: 0,0:07:55.89,0:07:58.02,Default,,0,0,0,,Dù thế nào, cảm ơn cậu.
Dialogue: 0,0:07:58.77,0:08:03.40,Default,,0,0,0,,Hãy tìm tình yêu đích thực ở đây nhé.
Dialogue: 0,0:08:03.48,0:08:05.02,Default,,0,0,0,,Taichan thật tử tế.
Dialogue: 0,0:08:05.11,0:08:06.65,Default,,0,0,0,,Tôi mừng vì cậu đã rủ tôi.
Dialogue: 0,0:08:06.74,0:08:08.33,Default,,0,0,0,,- Sao?\N- Tôi mừng vì cậu rủ tôi.
Dialogue: 0,0:08:08.40,0:08:10.40,Default,,0,0,0,,Ôi, có gì đâu.
Dialogue: 0,0:08:10.49,0:08:13.95,Default,,0,0,0,,Vậy là Maririn từng bị tổn thương sâu sắc.
Dialogue: 0,0:08:15.29,0:08:16.29,Default,,0,0,0,,Này, máy ảnh Cheki!
Dialogue: 0,0:08:16.37,0:08:17.54,Default,,0,0,0,,Chụp thế này đi.
Dialogue: 0,0:08:17.62,0:08:18.91,Default,,0,0,0,,- Làm tử tế.\N- Theo tôi.
Dialogue: 0,0:08:19.00,0:08:20.92,Default,,0,0,0,,- "Một, hai, sao rồi!" Nhé?\N- Được, một…
Dialogue: 0,0:08:21.00,0:08:23.00,Default,,0,0,0,,- Sao rồi, bạn ơi!\N- Sao rồi, bạn ơi!
Dialogue: 0,0:08:24.50,0:08:26.25,Default,,0,0,0,,Đẹp đấy!
Dialogue: 0,0:08:26.34,0:08:29.26,Default,,0,0,0,,Hình như đó là lần đầu\Ntôi chụp ảnh Cheki với một cô gái.
Dialogue: 0,0:08:29.34,0:08:31.13,Default,,0,0,0,,- Tôi cũng thế.\N- Nhỉ?
Dialogue: 0,0:08:31.22,0:08:36.48,Default,,0,0,0,,Chắc chúng ta là người\Nầm ĩ, ngớ ngẩn nhất hội đấy.
Dialogue: 0,0:08:36.56,0:08:39.23,Default,,0,0,0,,Nên tôi không biết sẽ thế nào\Nkhi chỉ có hai ta.
Dialogue: 0,0:08:39.31,0:08:40.81,Default,,0,0,0,,Ừ, ta như cây hài trong lớp.
Dialogue: 0,0:08:40.90,0:08:42.90,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:08:42.98,0:08:46.32,Default,,0,0,0,,- Cứ như mình ngốc hay gì đó.\N- Nhỉ? Tôi cũng nghĩ thế.
Dialogue: 0,0:08:46.40,0:08:48.24,Default,,0,0,0,,Thấy tôi nghiêm túc hơn bề ngoài chứ?
Dialogue: 0,0:08:48.32,0:08:50.11,Default,,0,0,0,,Ý tôi là trong chuyện hẹn hò.
Dialogue: 0,0:08:50.20,0:08:53.08,Default,,0,0,0,,Phải rồi. Tôi làm trong CLB tiếp viên.
Dialogue: 0,0:08:53.16,0:08:54.83,Default,,0,0,0,,Nên ai cũng nghĩ tôi làm điếm.
Dialogue: 0,0:08:55.83,0:08:57.83,Default,,0,0,0,,Nhưng không hề. Tôi có tự trọng.
Dialogue: 0,0:08:57.91,0:08:59.75,Default,,0,0,0,,Có được nói "điếm" không nhỉ?
Dialogue: 0,0:09:00.58,0:09:02.37,Default,,0,0,0,,Một lần này thì cho phép.
Dialogue: 0,0:09:02.46,0:09:03.96,Default,,0,0,0,,Ồ, thế à?
Dialogue: 0,0:09:04.71,0:09:05.80,Default,,0,0,0,,- Anh là Kanagawa.\N- Ừ.
Dialogue: 0,0:09:05.88,0:09:07.92,Default,,0,0,0,,Kawasaki khá là gần.
Dialogue: 0,0:09:08.01,0:09:11.60,Default,,0,0,0,,Tin đồn cũng lan xa mà, anh biết chứ?
Dialogue: 0,0:09:11.68,0:09:14.22,Default,,0,0,0,,Dù anh có hỏi khắp nơi thì cũng không thấy
Dialogue: 0,0:09:14.30,0:09:16.14,Default,,0,0,0,,có tin đồn tôi làm điếm đâu.
Dialogue: 0,0:09:16.22,0:09:17.60,Default,,0,0,0,,- Ồ, thế hả?\N- Ừ.
Dialogue: 0,0:09:18.27,0:09:19.98,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:09:20.06,0:09:21.60,Default,,0,0,0,,Tôi chưa sẵn sàng cho chuyện đó.
Dialogue: 0,0:09:21.69,0:09:23.69,Default,,0,0,0,,Lúc cô bảo tôi sẽ không thấy tin đồn.
Dialogue: 0,0:09:23.77,0:09:25.36,Default,,0,0,0,,Chưa có ai nói vậy với tôi.
Dialogue: 0,0:09:25.44,0:09:27.57,Default,,0,0,0,,Tôi không dễ dãi.\NTôi biết giá trị của mình.
Dialogue: 0,0:09:27.65,0:09:28.69,Default,,0,0,0,,Ồ, vậy hả?
Dialogue: 0,0:09:29.36,0:09:32.32,Default,,0,0,0,,Tiện đang nói chuyện,\Ncô có hứng thú với ai không?
Dialogue: 0,0:09:32.41,0:09:34.66,Default,,0,0,0,,Cô cảm thấy thế nào?
Dialogue: 0,0:09:34.74,0:09:37.49,Default,,0,0,0,,Không phải tôi thì cũng buồn phết.
Dialogue: 0,0:09:38.08,0:09:40.08,Default,,0,0,0,,Có gì buồn cười à?
Dialogue: 0,0:09:44.25,0:09:46.59,Default,,0,0,0,,Cậu mang thư của tôi trong túi hả?
Dialogue: 0,0:09:46.67,0:09:47.71,Default,,0,0,0,,- Phải.\N- Tại sao?
Dialogue: 0,0:09:47.80,0:09:49.51,Default,,0,0,0,,- Phải.\N- Chữ tôi xấu mù.
Dialogue: 0,0:09:49.59,0:09:50.67,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:09:50.76,0:09:53.18,Default,,0,0,0,,Tôi viết bừa lúc say đó.
Dialogue: 0,0:09:53.26,0:09:54.64,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:09:54.72,0:09:56.47,Default,,0,0,0,,Đừng mang ra mà.
Dialogue: 0,0:09:56.55,0:09:57.55,Default,,0,0,0,,Tôi cất đi nhé?
Dialogue: 0,0:09:57.64,0:09:59.27,Default,,0,0,0,,- Không nhất thiết.\N- Thế hả?
Dialogue: 0,0:10:02.60,0:10:05.14,Default,,0,0,0,,Nhưng tôi sẽ viết bức khác.\NLần này viết tử tế.
Dialogue: 0,0:10:07.36,0:10:08.40,Default,,0,0,0,,Cô ấy đây rồi.
Dialogue: 0,0:10:08.48,0:10:10.27,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:10:11.07,0:10:12.74,Default,,0,0,0,,Tôi đột kích tí nha?
Dialogue: 0,0:10:12.82,0:10:14.16,Default,,0,0,0,,Đột kích? Được mà.
Dialogue: 0,0:10:14.24,0:10:15.41,Default,,0,0,0,,Được mà.
Dialogue: 0,0:10:15.49,0:10:16.70,Default,,0,0,0,,Hikaru "đột kích".
Dialogue: 0,0:10:16.78,0:10:18.74,Default,,0,0,0,,Đột kích…
Dialogue: 0,0:10:18.83,0:10:20.25,Default,,0,0,0,,Gấu ghê.
Dialogue: 0,0:10:20.33,0:10:23.67,Default,,0,0,0,,Không ngờ cô ấy đi vào thật.
Dialogue: 0,0:10:23.75,0:10:24.79,Default,,0,0,0,,Chúng ta làm gì nhỉ?
Dialogue: 0,0:10:25.50,0:10:27.75,Default,,0,0,0,,Muốn nói chuyện nhóm hay…
Dialogue: 0,0:10:28.92,0:10:30.67,Default,,0,0,0,,Ta đi nói chuyện một lát nha?
Dialogue: 0,0:10:30.76,0:10:33.60,Default,,0,0,0,,Ồ, được. Anh muốn đi hút thuốc hả?
Dialogue: 0,0:10:33.67,0:10:35.13,Default,,0,0,0,,- Tôi đi hút thuốc nha?\N- Được.
Dialogue: 0,0:10:35.68,0:10:38.22,Default,,0,0,0,,- Tôi đi nhé? Xin lỗi.\N- Không sao đâu.
Dialogue: 0,0:10:43.77,0:10:45.81,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:10:45.90,0:10:47.15,Default,,0,0,0,,Cô gái đó quyết liệt ghê.
Dialogue: 0,0:10:47.23,0:10:48.52,Default,,0,0,0,,Bánh xe đã lăn rồi.
Dialogue: 0,0:10:48.61,0:10:51.32,Default,,0,0,0,,Phải, bắt đầu căng rồi đây.
Dialogue: 0,0:10:52.36,0:10:54.11,Default,,0,0,0,,- Cô quay lại hả?\N- Sao?
Dialogue: 0,0:10:54.20,0:10:55.58,Default,,0,0,0,,- Tôi biết mà.\N- Tại sao?
Dialogue: 0,0:10:55.66,0:10:56.91,Default,,0,0,0,,Cô đã quay lại.
Dialogue: 0,0:10:57.66,0:10:58.58,Default,,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:10:58.66,0:11:00.29,Default,,0,0,0,,Cảm ơn nha. Tôi vui lắm.
Dialogue: 0,0:11:00.37,0:11:04.00,Default,,0,0,0,,Thật ra, cậu là đàn ông mà!
Dialogue: 0,0:11:04.08,0:11:06.04,Default,,0,0,0,,- Cậu là đàn ông nhỉ?\N- Ý cô là sao?
Dialogue: 0,0:11:06.12,0:11:08.62,Default,,0,0,0,,- Cậu là đàn ông đó.\N- Ừ, tôi là đàn ông.
Dialogue: 0,0:11:08.71,0:11:10.59,Default,,0,0,0,,Cô đã muốn tôi ra chỗ cô hả?
Dialogue: 0,0:11:10.67,0:11:11.75,Default,,0,0,0,,Rõ ràng rồi.
Dialogue: 0,0:11:11.84,0:11:13.05,Default,,0,0,0,,Xin lỗi nha.
Dialogue: 0,0:11:13.13,0:11:15.05,Default,,0,0,0,,Nhưng nghe tôi đã.
Dialogue: 0,0:11:15.13,0:11:17.30,Default,,0,0,0,,- Cậu nói chiều nay mà.\N- Thế à?
Dialogue: 0,0:11:18.01,0:11:19.26,Default,,0,0,0,,- Chiều nay?\N- Ừ.
Dialogue: 0,0:11:19.35,0:11:23.56,Default,,0,0,0,,Cậu bảo cậu có hai lựa chọn,\Nnhưng là nhiều hơn hai mà.
Dialogue: 0,0:11:23.64,0:11:27.35,Default,,0,0,0,,Ban nãy chúng tôi chỉ tâm sự thôi…
Dialogue: 0,0:11:27.44,0:11:29.15,Default,,0,0,0,,Cô ấy đã khóc. Tôi bất ngờ lắm.
Dialogue: 0,0:11:29.23,0:11:30.44,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:11:30.52,0:11:34.77,Default,,0,0,0,,Tôi nghĩ lại về những gì\Ncậu nói chiều nay.
Dialogue: 0,0:11:34.86,0:11:36.45,Default,,0,0,0,,Thế nên tôi quay lại.
Dialogue: 0,0:11:36.53,0:11:39.41,Default,,0,0,0,,Cậu bảo cậu đang dao động\Ngiữa hai lựa chọn.
Dialogue: 0,0:11:39.49,0:11:40.70,Default,,0,0,0,,Và tôi kiểu: "Hả?"
Dialogue: 0,0:11:41.49,0:11:42.32,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:11:43.04,0:11:47.80,Default,,0,0,0,,Tôi chờ đến đúng thời điểm thôi.
Dialogue: 0,0:11:48.83,0:11:49.83,Default,,0,0,0,,Tôi nói với cô rồi.
Dialogue: 0,0:11:49.92,0:11:50.75,Default,,0,0,0,,Phải.
Dialogue: 0,0:11:50.84,0:11:53.01,Default,,0,0,0,,Nên tôi đã định qua rủ cô.
Dialogue: 0,0:11:53.09,0:11:54.47,Default,,0,0,0,,- Thế à?\N- Ừ.
Dialogue: 0,0:11:55.05,0:11:56.34,Default,,0,0,0,,Tôi đã định mà.
Dialogue: 0,0:11:56.42,0:11:57.71,Default,,0,0,0,,Xin lỗi nha.
Dialogue: 0,0:11:57.80,0:11:59.14,Default,,0,0,0,,Tôi muốn cậu máu chiến hơn.
Dialogue: 0,0:11:59.22,0:12:02.27,Default,,0,0,0,,Nếu cậu thật sự có cảm xúc với tôi.
Dialogue: 0,0:12:02.35,0:12:04.31,Default,,0,0,0,,Nếu thật sự có hứng thú,
Dialogue: 0,0:12:04.39,0:12:05.77,Default,,0,0,0,,cậu nên máu chiến.
Dialogue: 0,0:12:06.68,0:12:08.39,Default,,0,0,0,,Nhưng ở đây tôi trẻ nhất.
Dialogue: 0,0:12:08.48,0:12:10.02,Default,,0,0,0,,Điều đó làm tôi chùn bước.
Dialogue: 0,0:12:10.10,0:12:12.39,Default,,0,0,0,,Tuổi tác đâu có quan trọng, được chứ?
Dialogue: 0,0:12:12.48,0:12:13.98,Default,,0,0,0,,- Ngầu thế.\N- Không quan trọng.
Dialogue: 0,0:12:14.07,0:12:15.99,Default,,0,0,0,,- Không đâu nhỉ?\N- Không mà.
Dialogue: 0,0:12:16.07,0:12:18.16,Default,,0,0,0,,Nên tôi muốn máu chiến lắm.
Dialogue: 0,0:12:18.24,0:12:19.87,Default,,0,0,0,,Đôi khi như thế quan trọng đó…
Dialogue: 0,0:12:19.95,0:12:21.33,Default,,0,0,0,,Ừ, khi nào đi riêng nha.
Dialogue: 0,0:12:21.41,0:12:24.20,Default,,0,0,0,,- Ừ. Rủ tôi đi.\N- Chắc chắn.
Dialogue: 0,0:12:24.70,0:12:26.24,Default,,0,0,0,,Tôi thấy cô dễ thương lắm.
Dialogue: 0,0:12:26.33,0:12:27.17,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:12:29.21,0:12:30.71,Default,,0,0,0,,Vậy cứ khen tôi dễ thương đi.
Dialogue: 0,0:12:30.79,0:12:31.83,Default,,0,0,0,,Lúc cô tỉnh giấc,
Dialogue: 0,0:12:31.92,0:12:34.80,Default,,0,0,0,,tôi qua giường cô khen dễ thương nha?
Dialogue: 0,0:12:38.72,0:12:41.89,Default,,0,0,0,,- Tôi sẽ lải nhải mãi.\N- Đừng chỉ có nói. Thể hiện nữa.
Dialogue: 0,0:12:41.97,0:12:44.51,Default,,0,0,0,,Đương nhiên. Không thì tôi đâu được ở đây.
Dialogue: 0,0:12:44.60,0:12:45.56,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:12:45.64,0:12:47.60,Default,,0,0,0,,- Tôi làm gì kỳ lạ thì cứ tẩn nha.\N- Được.
Dialogue: 0,0:12:47.68,0:12:49.81,Default,,0,0,0,,- Cô có thể tát tôi.\N- Cậu nói đó nha.
Dialogue: 0,0:12:49.89,0:12:52.02,Default,,0,0,0,,Và bảo: "Chỉ biết nói mồm!"
Dialogue: 0,0:12:52.10,0:12:53.23,Default,,0,0,0,,Maririn!
Dialogue: 0,0:12:53.31,0:12:54.60,Default,,0,0,0,,Cô viết thư nữa sao?
Dialogue: 0,0:12:54.69,0:12:55.69,Default,,0,0,0,,Nhìn mà đau lòng.
Dialogue: 0,0:12:55.77,0:12:57.40,Default,,0,0,0,,Trời…
Dialogue: 0,0:12:58.69,0:13:00.36,Default,,0,0,0,,Tôi muốn tìm hiểu cô thêm.
Dialogue: 0,0:13:00.45,0:13:02.87,Default,,0,0,0,,Tôi muốn tìm hiểu cậu\Nvà cũng muốn cậu hiểu tôi.
Dialogue: 0,0:13:03.41,0:13:04.24,Default,,0,0,0,,- Vậy hả?\N- Ừ.
Dialogue: 0,0:13:04.33,0:13:06.08,Default,,0,0,0,,Tôi muốn tìm hiểu thêm.
Dialogue: 0,0:13:06.16,0:13:08.33,Default,,0,0,0,,Xin lỗi, xin phép nha?
Dialogue: 0,0:13:08.41,0:13:09.29,Default,,0,0,0,,- Ừ.\N- Được.
Dialogue: 0,0:13:09.37,0:13:10.75,Default,,0,0,0,,Tôi viết lại thư rồi.
Dialogue: 0,0:13:11.62,0:13:12.87,Default,,0,0,0,,Về phòng đọc nhé.
Dialogue: 0,0:13:12.96,0:13:14.30,Default,,0,0,0,,- Được rồi.\N- Được.
Dialogue: 0,0:13:16.00,0:13:17.75,Default,,0,0,0,,- Cảm ơn.\N- Cảm ơn và xin lỗi.
Dialogue: 0,0:13:19.63,0:13:21.47,Default,,0,0,0,,Ý cô ấy viết lại là sao?
Dialogue: 0,0:13:22.93,0:13:24.72,Default,,0,0,0,,- Nhỏ tiếng thôi.\N- Ý cô ấy là sao?
Dialogue: 0,0:13:24.80,0:13:27.22,Default,,0,0,0,,- Thư hôm qua đó.\N- Thế à?
Dialogue: 0,0:13:27.31,0:13:29.27,Default,,0,0,0,,Đó là ấn tượng ban đầu của chúng ta, nhỉ?
Dialogue: 0,0:13:37.07,0:13:39.61,Default,,0,0,0,,KHU HÚT THUỐC
Dialogue: 0,0:13:44.20,0:13:47.29,Default,,0,0,0,,Tôi viết rằng tôi có hứng thú với cậu ấy,
Dialogue: 0,0:13:47.87,0:13:51.37,Default,,0,0,0,,và về chuyện lúc cậu ấy rời đi với Hikaru,
Dialogue: 0,0:13:51.46,0:13:53.21,Default,,0,0,0,,cậu ấy nói: "Xin lỗi nha".
Dialogue: 0,0:13:53.29,0:13:57.50,Default,,0,0,0,,Chuyện đó khiến tôi hơi ghen,\Nnên tôi đã viết ra.
Dialogue: 0,0:13:57.59,0:14:00.55,Default,,0,0,0,,Hy vọng cậu ấy hiểu.
Dialogue: 0,0:14:00.63,0:14:02.72,Default,,0,0,0,,Cậu ấy mang theo thư trong túi suốt,
Dialogue: 0,0:14:02.80,0:14:05.51,Default,,0,0,0,,và tôi thấy thế thật dễ thương.
Dialogue: 0,0:14:05.59,0:14:09.51,Default,,0,0,0,,Tôi không ngờ cô ấy sẽ viết lại.\NCả một bức thư mới.
Dialogue: 0,0:14:10.93,0:14:12.31,Default,,0,0,0,,Nhưng tôi không biết nữa…
Dialogue: 0,0:14:12.94,0:14:17.53,Default,,0,0,0,,Tâm trí tôi toàn Hikaru thôi, nên là…
Dialogue: 0,0:14:20.69,0:14:22.28,Default,,0,0,0,,Buổi xông hơi thế nào?
Dialogue: 0,0:14:22.36,0:14:24.40,Default,,0,0,0,,Cá nhân tôi thì thấy
Dialogue: 0,0:14:25.03,0:14:28.24,Default,,0,0,0,,vụ đó càng khiến tôi\Ncó hứng thú với cậu hơn Ma-kun.
Dialogue: 0,0:14:28.33,0:14:30.33,Default,,0,0,0,,- Hả?\N- Ôi, trời.
Dialogue: 0,0:14:31.25,0:14:32.92,Default,,0,0,0,,- Sau khi xông hơi?\N- Ừ, sau đó.
Dialogue: 0,0:14:33.00,0:14:34.67,Default,,0,0,0,,- Tại sao?\N- Tôi…
Dialogue: 0,0:14:34.75,0:14:37.13,Default,,0,0,0,,Tôi không thấy rung động gì với Ma-kun cả.
Dialogue: 0,0:14:40.67,0:14:44.01,Default,,0,0,0,,Tôi chỉ cảm thấy\Nlúc nói chuyện với Ma-kun,
Dialogue: 0,0:14:44.09,0:14:45.68,Default,,0,0,0,,tôi muốn nói chuyện với cậu hơn.
Dialogue: 0,0:14:45.76,0:14:48.93,Default,,0,0,0,,Nghe vậy tôi cũng thấy vui.
Dialogue: 0,0:14:49.60,0:14:52.31,Default,,0,0,0,,Lá thư của cô khiến tôi rung rinh lắm.
Dialogue: 0,0:14:52.39,0:14:53.39,Default,,0,0,0,,Ồ, thế hả?
Dialogue: 0,0:14:53.48,0:14:54.69,Default,,0,0,0,,Nên là…
Dialogue: 0,0:14:55.44,0:14:58.07,Default,,0,0,0,,Tôi xúc động lắm.
Dialogue: 0,0:14:59.73,0:15:04.65,Default,,0,0,0,,Lúc đầu tới đây,\Ntôi toàn bật chế độ đối kháng.
Dialogue: 0,0:15:04.74,0:15:06.87,Default,,0,0,0,,Nhưng rồi tôi chuyển sang\Nchế độ yêu đương.
Dialogue: 0,0:15:08.45,0:15:11.75,Default,,0,0,0,,- Chà, nghe mà mừng.\N- Thật đó.
Dialogue: 0,0:15:11.83,0:15:14.12,Default,,0,0,0,,Tôi xúc động lắm.\NTôi còn kể với mọi người.
Dialogue: 0,0:15:14.20,0:15:15.33,Default,,0,0,0,,- Ồ, vậy hả?\N- Ừ.
Dialogue: 0,0:15:16.08,0:15:18.79,Default,,0,0,0,,Nhưng khi hai người đi mất,\Ntôi lại về chế độ đối kháng.
Dialogue: 0,0:15:21.84,0:15:25.43,Default,,0,0,0,,Tim tôi không đập rộn ràng khi ở bên Leo.
Dialogue: 0,0:15:25.51,0:15:27.43,Default,,0,0,0,,Không biết tại sao nữa.
Dialogue: 0,0:15:27.51,0:15:31.43,Default,,0,0,0,,Khoan, gì cơ? Cô gái này làm sao vậy?
Dialogue: 0,0:15:31.51,0:15:33.30,Default,,0,0,0,,Ừ. Đúng là khó hiểu.
Dialogue: 0,0:15:33.39,0:15:37.56,Default,,0,0,0,,Tôi không thấy xốn xang…
Dialogue: 0,0:15:38.19,0:15:40.44,Default,,0,0,0,,Tôi cũng thấy khó hiểu lắm.
Dialogue: 0,0:15:40.52,0:15:43.69,Default,,0,0,0,,Tôi không biết tại sao,\Nnhưng tôi không thấy xốn xang thôi.
Dialogue: 0,0:15:43.78,0:15:45.91,Default,,0,0,0,,Nhưng tôi vẫn muốn tìm hiểu cậu ấy.
Dialogue: 0,0:15:45.99,0:15:49.87,Default,,0,0,0,,Nhưng tôi rất muốn cậu ấy\Nchỉnh lại gu thời trang.
Dialogue: 0,0:15:49.95,0:15:53.83,Default,,0,0,0,,Bộ đồ Leo mặc hôm nay xấu tệ.\NCứ như sắp đi thẳng đến hộp đêm.
Dialogue: 0,0:15:53.91,0:15:57.46,Default,,0,0,0,,Cậu ấy mặc quần bò sáng màu bó giò.
Dialogue: 0,0:15:57.54,0:15:58.92,Default,,0,0,0,,Tôi kiểu:
Dialogue: 0,0:15:59.00,0:16:03.63,Default,,0,0,0,,"Thời này ai còn mặc kiểu quần thế nữa?"
Dialogue: 0,0:16:03.71,0:16:05.46,Default,,0,0,0,,Sau cùng thì tính cách là trên hết,
Dialogue: 0,0:16:05.55,0:16:08.10,Default,,0,0,0,,nhưng gu thời trang cũng quan trọng mà.
Dialogue: 0,0:16:08.18,0:16:09.52,Default,,0,0,0,,Đối với cả nam lẫn nữ.
Dialogue: 0,0:16:11.05,0:16:12.51,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:16:12.60,0:16:14.85,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:16:14.93,0:16:16.18,Default,,0,0,0,,Đến giờ học đạo đức.
Dialogue: 0,0:16:16.27,0:16:17.23,Default,,0,0,0,,- Đạo đức?\N- Đạo đức?
Dialogue: 0,0:16:17.31,0:16:21.65,Default,,0,0,0,,Cuộc sống thực sự bắt đầu\Nkhi bạn ngừng chạy trốn quá khứ.
Dialogue: 0,0:16:22.36,0:16:28.24,Default,,0,0,0,,Hãy kiểm điểm lại những lỗi lầm ngày xưa\Nvà chia sẻ câu chuyện của mình với cả lớp.
Dialogue: 0,0:16:28.32,0:16:31.57,Default,,0,0,0,,Hãy lắng nghe những lỗi lầm\Nvà nỗi ân hận của người khác,
Dialogue: 0,0:16:31.66,0:16:34.66,Default,,0,0,0,,so sánh với chuyện của mình\Nvà rút ra bài học.
Dialogue: 0,0:16:34.74,0:16:36.83,Default,,0,0,0,,Việc này ở nước ngoài thường thấy lắm.
Dialogue: 0,0:16:37.62,0:16:40.50,Default,,0,0,0,,Bo, mời bạn lên trước.
Dialogue: 0,0:16:40.58,0:16:41.67,Default,,0,0,0,,- Tôi à?\N- Bo!
Dialogue: 0,0:16:41.75,0:16:42.71,Default,,0,0,0,,Bo.
Dialogue: 0,0:16:43.21,0:16:44.34,Default,,0,0,0,,- Cố lên nào.\N- Phải.
Dialogue: 0,0:16:44.42,0:16:46.09,Default,,0,0,0,,- Thầy Bo.\N- Hợp anh ấy đó.
Dialogue: 0,0:16:46.59,0:16:48.09,Default,,0,0,0,,À thì…
Dialogue: 0,0:16:48.80,0:16:53.81,Default,,0,0,0,,Sau khi tốt nghiệp cấp một,\Nmọi người quanh tôi toàn người xấu.
Dialogue: 0,0:16:53.89,0:16:56.35,Default,,0,0,0,,Nên tôi tự nhiên nghe lời họ thôi.
Dialogue: 0,0:16:57.27,0:17:00.69,Default,,0,0,0,,Tôi quay về từ trại giáo dưỡng\Nlần hai tầm năm 17 tuổi.
Dialogue: 0,0:17:00.77,0:17:04.73,Default,,0,0,0,,Tình hình khá là ổn\Nmột thời gian sau khi tôi quay về.
Dialogue: 0,0:17:04.82,0:17:08.28,Default,,0,0,0,,Nhưng đến năm tầm 20 tuổi,
Dialogue: 0,0:17:08.36,0:17:12.36,Default,,0,0,0,,tôi đi vận chuyển ma túy và các thứ khác.
Dialogue: 0,0:17:13.07,0:17:14.86,Default,,0,0,0,,Ai lôi kéo cậu vào ma túy đá?
Dialogue: 0,0:17:15.62,0:17:18.08,Default,,0,0,0,,Bạn bè và các tiền bối chăng?
Dialogue: 0,0:17:19.50,0:17:21.21,Default,,0,0,0,,Tôi thấy nể vì cậu cai được.
Dialogue: 0,0:17:21.29,0:17:22.75,Default,,0,0,0,,Giờ thì kiểu…
Dialogue: 0,0:17:22.83,0:17:25.67,Default,,0,0,0,,Tôi từng định chơi mấy lần\Nkể từ khi ra tù.
Dialogue: 0,0:17:25.75,0:17:26.63,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:17:29.17,0:17:32.67,Default,,0,0,0,,Nhưng tôi có người giúp đỡ,\Nvà giờ tôi biết mình là ai.
Dialogue: 0,0:17:32.76,0:17:35.05,Default,,0,0,0,,Và điều đó cũng đã đưa tôi tới đây.
Dialogue: 0,0:17:35.64,0:17:37.64,Default,,0,0,0,,Tôi nhận ra môi trường rất quan trọng.
Dialogue: 0,0:17:37.72,0:17:41.10,Default,,0,0,0,,Tôi đã nhận ra điều đó.
Dialogue: 0,0:17:42.02,0:17:43.35,Default,,0,0,0,,Anh đã tiêm chích hả?
Dialogue: 0,0:17:43.44,0:17:45.36,Default,,0,0,0,,- Hay anh hút?\N- Bo!
Dialogue: 0,0:17:45.44,0:17:47.36,Default,,0,0,0,,- Anh hút hả?\N- Bo, cô ấy hỏi kìa.
Dialogue: 0,0:17:47.44,0:17:49.57,Default,,0,0,0,,- Ừ, tôi hút.\N- Ồ, không tiêm chích.
Dialogue: 0,0:17:49.65,0:17:51.15,Default,,0,0,0,,Nếu chích thì khó bỏ lắm.
Dialogue: 0,0:17:51.24,0:17:52.78,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:17:52.86,0:17:54.15,Default,,0,0,0,,Khác hẳn đấy.
Dialogue: 0,0:17:54.24,0:17:55.66,Default,,0,0,0,,- Họ tra hỏi cậu ấy.\N- Ừ.
Dialogue: 0,0:17:55.74,0:17:57.24,Default,,0,0,0,,Chỉ hút thôi thì cai được.
Dialogue: 0,0:17:57.33,0:17:59.54,Default,,0,0,0,,- Thế hả?\N- Tiêm chích thì coi như bỏ.
Dialogue: 0,0:17:59.62,0:18:01.33,Default,,0,0,0,,Awich làm anh bất ngờ lắm.
Dialogue: 0,0:18:01.41,0:18:02.83,Default,,0,0,0,,Cô ấy nói làm em hết hồn.
Dialogue: 0,0:18:02.92,0:18:04.80,Default,,0,0,0,,Khác hẳn đấy.
Dialogue: 0,0:18:04.88,0:18:07.26,Default,,0,0,0,,- Cô biết nhiều thế.\N- Thật đó.
Dialogue: 0,0:18:07.34,0:18:08.26,Default,,0,0,0,,"Hút hay chích?"
Dialogue: 0,0:18:08.34,0:18:09.93,Default,,0,0,0,,Bọn tôi hỏi thì cũng dễ hiểu.
Dialogue: 0,0:18:10.01,0:18:12.68,Default,,0,0,0,,Nhưng họ kiểu: "Anh hút hay chích?"
Dialogue: 0,0:18:13.30,0:18:14.30,Default,,0,0,0,,Nhưng đừng đi tù.
Dialogue: 0,0:18:14.38,0:18:15.51,Default,,0,0,0,,- Ừ.\N- Phải.
Dialogue: 0,0:18:15.59,0:18:17.76,Default,,0,0,0,,Hãy nghĩ đến mọi người ở đây nữa.
Dialogue: 0,0:18:17.85,0:18:19.23,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:18:19.81,0:18:22.06,Default,,0,0,0,,Chúng ta ngồi chung bàn, ăn chung món.
Dialogue: 0,0:18:22.14,0:18:23.31,Default,,0,0,0,,Đã là bạn chưa nhỉ?
Dialogue: 0,0:18:23.39,0:18:24.68,Default,,0,0,0,,- Là bạn mà.\N- Phải.
Dialogue: 0,0:18:24.77,0:18:25.85,Default,,0,0,0,,Cậu nói gì vậy?
Dialogue: 0,0:18:27.11,0:18:27.94,Default,,0,0,0,,Đúng là đàn ông.
Dialogue: 0,0:18:28.02,0:18:29.52,Default,,0,0,0,,Cảm ơn vì đã nói thế.
Dialogue: 0,0:18:29.61,0:18:31.49,Default,,0,0,0,,Tôi nghĩ chúng tôi muốn cậu
Dialogue: 0,0:18:31.57,0:18:35.24,Default,,0,0,0,,chăm sóc bản thân và vui vẻ.\NChắc chắn ai cũng cảm thấy thế.
Dialogue: 0,0:18:35.32,0:18:36.45,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:18:36.53,0:18:37.78,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:18:40.74,0:18:44.20,Default,,0,0,0,,Tiếp theo, mời Maririn.
Dialogue: 0,0:18:44.29,0:18:45.25,Default,,0,0,0,,Ồ, được rồi.
Dialogue: 0,0:18:47.88,0:18:48.97,Default,,0,0,0,,Cô giáo Maririn.
Dialogue: 0,0:18:49.04,0:18:50.88,Default,,0,0,0,,- Xin chào.\N- Xin mời.
Dialogue: 0,0:18:50.96,0:18:53.63,Default,,0,0,0,,Sao tôi lại thành ra thế này hả trời.
Dialogue: 0,0:18:53.72,0:18:55.01,Default,,0,0,0,,À thì…
Dialogue: 0,0:18:55.09,0:18:59.14,Default,,0,0,0,,Từ nhỏ đến lớn,\Ntôi không sống chung với bố mẹ.
Dialogue: 0,0:18:59.22,0:19:02.72,Default,,0,0,0,,Tôi sống với bà, bà đã nuôi tôi khôn lớn.
Dialogue: 0,0:19:02.81,0:19:05.48,Default,,0,0,0,,Tôi không muốn trở thành gánh nặng với bà,
Dialogue: 0,0:19:05.56,0:19:09.73,Default,,0,0,0,,nên tôi bắt đầu đi làm ở quán bar\Nvà hộp đêm từ khi lên cấp hai.
Dialogue: 0,0:19:09.82,0:19:13.53,Default,,0,0,0,,Tôi ở ký túc xá và gần như chẳng đi học.
Dialogue: 0,0:19:14.24,0:19:18.79,Default,,0,0,0,,Lý do khác tôi không muốn về nhà là…
Dialogue: 0,0:19:18.87,0:19:22.75,Default,,0,0,0,,Ông tôi cứ cầm gậy và chửi tôi:
Dialogue: 0,0:19:22.83,0:19:24.71,Default,,0,0,0,,"Cút về nước mày đi!"
Dialogue: 0,0:19:24.79,0:19:26.29,Default,,0,0,0,,Dù tôi chưa từng ở nước ngoài.
Dialogue: 0,0:19:26.37,0:19:28.62,Default,,0,0,0,,Nhưng ông cứ đánh tôi và nói như vậy.
Dialogue: 0,0:19:28.71,0:19:30.34,Default,,0,0,0,,Gì…
Dialogue: 0,0:19:31.84,0:19:34.93,Default,,0,0,0,,Thế nên tôi không muốn ở nhà.
Dialogue: 0,0:19:35.01,0:19:38.39,Default,,0,0,0,,Tôi đã làm rất nhiều chuyện đáng xấu hổ.
Dialogue: 0,0:19:39.22,0:19:40.43,Default,,0,0,0,,Mọi thứ bắt đầu từ đó.
Dialogue: 0,0:19:42.31,0:19:44.40,Default,,0,0,0,,Vậy người nhà kỳ thị chủng tộc với cô?
Dialogue: 0,0:19:44.47,0:19:48.35,Default,,0,0,0,,Vâng. Ông cũng già rồi,\Nnên ông rất bảo thủ.
Dialogue: 0,0:19:49.73,0:19:52.65,Default,,0,0,0,,Nhưng là học sinh cấp một,\Ntôi thấy tổn thương lắm.
Dialogue: 0,0:19:52.73,0:19:54.90,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:19:54.99,0:19:56.87,Default,,0,0,0,,- Tôi hiểu.\N- Thế hả?
Dialogue: 0,0:19:56.95,0:20:00.66,Default,,0,0,0,,Tôi đến từ Kanagawa,\Nnhưng toàn bị chửi là cút về nước đi.
Dialogue: 0,0:20:00.74,0:20:02.12,Default,,0,0,0,,Tôi sinh ra ở đây mà.
Dialogue: 0,0:20:02.20,0:20:04.49,Default,,0,0,0,,- Nhỉ?\N- Tôi cứ nghĩ thế mãi.
Dialogue: 0,0:20:04.58,0:20:07.00,Default,,0,0,0,,Ơ, bà cô không bênh vực cô sao?
Dialogue: 0,0:20:07.08,0:20:10.08,Default,,0,0,0,,Ban đầu thì có,
Dialogue: 0,0:20:10.17,0:20:13.80,Default,,0,0,0,,nhưng ông cũng đánh chửi bà luôn.
Dialogue: 0,0:20:13.88,0:20:15.55,Default,,0,0,0,,Thấy đó…
Dialogue: 0,0:20:15.63,0:20:18.09,Default,,0,0,0,,Tôi không muốn bà bị đánh,\Nnên ở một mình thì hơn.
Dialogue: 0,0:20:18.93,0:20:20.56,Default,,0,0,0,,Tôi thấy như vậy đấy.
Dialogue: 0,0:20:22.10,0:20:24.52,Default,,0,0,0,,Vào thời gian đó, tôi muốn tìm ai đó
Dialogue: 0,0:20:24.60,0:20:26.06,Default,,0,0,0,,yêu con người thật của tôi.
Dialogue: 0,0:20:26.14,0:20:27.98,Default,,0,0,0,,Nhưng bạn trai cũ toàn kẻ bạo hành.
Dialogue: 0,0:20:29.14,0:20:30.60,Default,,0,0,0,,- Hiểu chứ?\N- Ừ.
Dialogue: 0,0:20:30.69,0:20:33.61,Default,,0,0,0,,Vì thế, tôi luôn khao khát được yêu.
Dialogue: 0,0:20:33.69,0:20:35.69,Default,,0,0,0,,Cô muốn cảm nhận tình yêu thương.
Dialogue: 0,0:20:35.78,0:20:36.78,Default,,0,0,0,,Tôi thèm khát ấy chứ.
Dialogue: 0,0:20:36.86,0:20:41.49,Default,,0,0,0,,Tôi không biết tình yêu đích thực là gì,\Nvà tôi chưa từng thấy tình yêu gia đình.
Dialogue: 0,0:20:41.57,0:20:43.86,Default,,0,0,0,,Nắm tay, đi dạo như trên truyền hình.
Dialogue: 0,0:20:43.95,0:20:48.00,Default,,0,0,0,,Được xoa đầu các thứ.\NTôi tưởng chuyện đó không có thật.
Dialogue: 0,0:20:48.08,0:20:51.38,Default,,0,0,0,,Đó là khi tôi nhận ra\Ntôi không giống những người khác.
Dialogue: 0,0:20:51.46,0:20:54.34,Default,,0,0,0,,Nhưng điều đó có thể thay đổi,\Nvì cô ở đây rồi.
Dialogue: 0,0:20:54.42,0:20:56.26,Default,,0,0,0,,Phải, tôi hy vọng là thế.
Dialogue: 0,0:20:56.34,0:20:59.39,Default,,0,0,0,,Tôi chưa từng kể về bản thân thế này.\NLớn rồi thì không.
Dialogue: 0,0:21:01.55,0:21:03.55,Default,,0,0,0,,Không nhất thiết phải là tình ái.
Dialogue: 0,0:21:03.64,0:21:06.77,Default,,0,0,0,,Tôi muốn cô cảm nhận được\Ntình yêu thương khi ở đây.
Dialogue: 0,0:21:06.85,0:21:10.15,Default,,0,0,0,,- Hơn cả tình yêu tình ái.\N- Phải, hơn cả tình ái nữa.
Dialogue: 0,0:21:10.77,0:21:13.86,Default,,0,0,0,,Tôi muốn yêu cô thật nhiều\Nsau khi nghe chuyện của cô.
Dialogue: 0,0:21:13.94,0:21:16.07,Default,,0,0,0,,Ừ, cảm ơn.
Dialogue: 0,0:21:19.95,0:21:22.04,Default,,0,0,0,,Bạn bè quan trọng nhỉ?
Dialogue: 0,0:21:22.11,0:21:23.49,Default,,0,0,0,,Quan trọng lắm.
Dialogue: 0,0:21:24.83,0:21:29.25,Default,,0,0,0,,Không có người để dựa dẫm
Dialogue: 0,0:21:29.33,0:21:31.75,Default,,0,0,0,,thật sự rất khó khăn. Tôi biết điều đó.
Dialogue: 0,0:21:31.83,0:21:33.33,Default,,0,0,0,,Từ góc nhìn của cô,
Dialogue: 0,0:21:33.42,0:21:36.63,Default,,0,0,0,,có lẽ cô không biết\Ntình yêu thế nào là bình thường.
Dialogue: 0,0:21:37.38,0:21:40.38,Default,,0,0,0,,Nhưng với tôi và người khác,
Dialogue: 0,0:21:41.09,0:21:44.97,Default,,0,0,0,,chúng tôi biết cảm giác\Nđược bạn bè và bạn đời yêu thương.
Dialogue: 0,0:21:45.51,0:21:48.85,Default,,0,0,0,,Việc đó khiến tôi nhận ra\Ntầm quan trọng của việc đó.
Dialogue: 0,0:21:48.93,0:21:52.31,Default,,0,0,0,,Nhưng này, ở đây không ai\Nđối xử tệ với cô như vậy đâu.
Dialogue: 0,0:21:52.39,0:21:54.23,Default,,0,0,0,,- Phải.\N- Ừ.
Dialogue: 0,0:21:54.31,0:21:56.85,Default,,0,0,0,,Chẳng thay đổi được gì nếu không nói ra.
Dialogue: 0,0:21:58.32,0:22:01.16,Default,,0,0,0,,Tôi nhận ra rằng giữ im lặng\Nchẳng có ích gì cho mình.
Dialogue: 0,0:22:02.40,0:22:04.57,Default,,0,0,0,,- Cảm ơn cô.\N- Cảm ơn.
Dialogue: 0,0:22:05.37,0:22:06.50,Default,,0,0,0,,Thật tuyệt vời.
Dialogue: 0,0:22:06.58,0:22:08.08,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:22:09.54,0:22:11.04,Default,,0,0,0,,Tôi yêu cô, Maririn.
Dialogue: 0,0:22:11.54,0:22:12.50,Default,,0,0,0,,Tôi cũng thế.
Dialogue: 0,0:22:19.55,0:22:26.27,Default,,0,0,0,,Khu vực này của Okinawa đang bị suy giảm\Ndân số nghiêm trọng tới mức đáng báo động.
Dialogue: 0,0:22:26.35,0:22:31.52,Default,,0,0,0,,Hãy tận dụng năng lượng tuổi trẻ\Nđể giúp đỡ người dân ở đây.
Dialogue: 0,0:22:32.52,0:22:38.99,Default,,0,0,0,,Các bạn đã từng bị xã hội ruồng bỏ,\Nnhưng giúp đỡ người dân ở đây
Dialogue: 0,0:22:39.07,0:22:44.70,Default,,0,0,0,,có thể giúp các bạn thấu hiểu hơn\Nvề xã hội và khơi gợi những góc nhìn mới.
Dialogue: 0,0:22:47.24,0:22:49.28,Default,,0,0,0,,Mùa này có nhiều người
Dialogue: 0,0:22:49.37,0:22:51.54,Default,,0,0,0,,có trải nghiệm sống nặng nề quá.
Dialogue: 0,0:22:51.62,0:22:52.79,Default,,0,0,0,,Ừ, nhiều thật!
Dialogue: 0,0:22:52.87,0:22:56.33,Default,,0,0,0,,Đầu tiên thì có Bo với ma túy đá.
Dialogue: 0,0:22:56.42,0:22:58.59,Default,,0,0,0,,Mừng là cậu ấy cai được.
Dialogue: 0,0:22:58.67,0:23:03.38,Default,,0,0,0,,Em nghĩ phải dũng cảm lắm\Nmới chia sẻ chuyện như vậy.
Dialogue: 0,0:23:03.47,0:23:06.26,Default,,0,0,0,,Anh thấy Maririn nhẫn nhục dã man.
Dialogue: 0,0:23:06.34,0:23:08.09,Default,,0,0,0,,Nhưng giờ anh hiểu vì sao rồi.
Dialogue: 0,0:23:08.18,0:23:14.35,Default,,0,0,0,,Ngày xưa em cũng từng bị bạo hành.
Dialogue: 0,0:23:14.43,0:23:17.60,Default,,0,0,0,,Những kẻ một khi đã bạo hành
Dialogue: 0,0:23:17.69,0:23:20.07,Default,,0,0,0,,thì sẽ tiếp tục bạo hành.
Dialogue: 0,0:23:20.15,0:23:21.69,Default,,0,0,0,,Chỉ có mục tiêu thay đổi.
Dialogue: 0,0:23:21.78,0:23:25.53,Default,,0,0,0,,Khi em nhận ra tình hình,
Dialogue: 0,0:23:25.61,0:23:28.91,Default,,0,0,0,,em mới vượt qua được.
Dialogue: 0,0:23:28.99,0:23:32.83,Default,,0,0,0,,Còn Maririn, nhờ tham gia\Nchương trình này,
Dialogue: 0,0:23:32.91,0:23:36.16,Default,,0,0,0,,có khi cô ấy sẽ cố đi bước đầu tiên.
Dialogue: 0,0:23:36.25,0:23:37.08,Default,,0,0,0,,Cô ấy đã mở lòng.
Dialogue: 0,0:23:37.17,0:23:39.42,Default,,0,0,0,,Phải, cô ấy đã mở lòng với họ.
Dialogue: 0,0:23:39.50,0:23:42.80,Default,,0,0,0,,Tức là cô ấy nhìn nhận\Nchuyện của mình là chuyện quá khứ rồi,
Dialogue: 0,0:23:42.88,0:23:45.72,Default,,0,0,0,,và giờ cô ấy đang thử\Ntrải nghiệm sống mới.
Dialogue: 0,0:23:45.80,0:23:46.93,Default,,0,0,0,,Có lý.
Dialogue: 0,0:23:52.31,0:23:53.44,Default,,0,0,0,,Xin chào!
Dialogue: 0,0:23:53.52,0:23:54.60,Default,,0,0,0,,- Xin chào.\N- Chào.
Dialogue: 0,0:23:55.56,0:23:56.73,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:23:56.81,0:23:57.64,Default,,0,0,0,,Ở đằng này.
Dialogue: 0,0:23:57.73,0:23:58.86,Default,,0,0,0,,Thiên nhiên!
Dialogue: 0,0:23:59.77,0:24:01.44,Default,,0,0,0,,Phải, đang ở trên núi đó.
Dialogue: 0,0:24:01.52,0:24:03.23,Default,,0,0,0,,- Thích quá!\N- Cảm ơn đã đến!
Dialogue: 0,0:24:03.32,0:24:04.82,Default,,0,0,0,,- Hân hạnh.\N- Hân hạnh.
Dialogue: 0,0:24:04.90,0:24:05.82,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:24:05.90,0:24:07.78,Default,,0,0,0,,Cả nhóm đây hả?
Dialogue: 0,0:24:07.86,0:24:08.78,Default,,0,0,0,,- Dạ.\N- Được rồi.
Dialogue: 0,0:24:08.86,0:24:10.07,Default,,0,0,0,,Có thư cho mấy đứa đây.
Dialogue: 0,0:24:12.08,0:24:13.08,Default,,0,0,0,,Thư à?
Dialogue: 0,0:24:13.16,0:24:18.50,Default,,0,0,0,,"Bà Higa từng là phiên dịch\Ncho một bác sĩ người Mỹ sau chiến tranh
Dialogue: 0,0:24:18.58,0:24:23.96,Default,,0,0,0,,và đã giúp vô số\Nngười dân ốm đau hàng chục năm qua.
Dialogue: 0,0:24:24.46,0:24:27.92,Default,,0,0,0,,Giờ đây, bà góp sức\Nbảo vệ thiên nhiên nơi đây,
Dialogue: 0,0:24:28.01,0:24:30.47,Default,,0,0,0,,nơi vẫn còn lưu giữ dấu tích\Ncủa Okinawa năm xưa.
Dialogue: 0,0:24:31.34,0:24:32.93,Default,,0,0,0,,Hãy vận dụng năng lượng tuổi trẻ
Dialogue: 0,0:24:33.01,0:24:38.14,Default,,0,0,0,,để giúp người dân Okinawa\Nmuốn bảo vệ môi trường nơi đây".
Dialogue: 0,0:24:38.69,0:24:40.90,Default,,0,0,0,,- Được rồi.\N- Cảm ơn đã tới giúp.
Dialogue: 0,0:24:40.98,0:24:42.48,Default,,0,0,0,,Rất vui được giúp ạ.
Dialogue: 0,0:24:42.56,0:24:43.39,Default,,0,0,0,,BÀ HIGA
Dialogue: 0,0:24:43.48,0:24:46.28,Default,,0,0,0,,Thỉnh thoảng,
Dialogue: 0,0:24:46.82,0:24:49.28,Default,,0,0,0,,chúng tôi chăm sóc người khuyết tật ở đây.
Dialogue: 0,0:24:49.36,0:24:51.57,Default,,0,0,0,,Họ không có nhiều bạn bè.
Dialogue: 0,0:24:51.66,0:24:55.04,Default,,0,0,0,,Lúc chăm sóc họ,
Dialogue: 0,0:24:55.12,0:25:00.67,Default,,0,0,0,,kể cả có mất một, hai tiếng\Nđể đi bộ hay làm việc,
Dialogue: 0,0:25:00.75,0:25:03.09,Default,,0,0,0,,thì ban đêm cũng ngủ rất ngon.
Dialogue: 0,0:25:03.17,0:25:07.59,Default,,0,0,0,,Tôi muốn nơi này là nơi giúp đỡ\Nnhưng thành viên kém may mắn của xã hội,
Dialogue: 0,0:25:07.67,0:25:11.13,Default,,0,0,0,,nên sau này hãy ghé thăm nữa nhé?
Dialogue: 0,0:25:11.22,0:25:13.06,Default,,0,0,0,,Mấy đứa đều đến từ đất liền hả?
Dialogue: 0,0:25:13.14,0:25:14.56,Default,,0,0,0,,- Đất liền ạ.\N- Ra vậy.
Dialogue: 0,0:25:14.64,0:25:16.73,Default,,0,0,0,,Ồ, phải rồi, thật joto!
Dialogue: 0,0:25:16.81,0:25:17.65,Default,,0,0,0,,Nói với tôi nào.
Dialogue: 0,0:25:18.23,0:25:19.69,Default,,0,0,0,,- Joto!\N- Joto!
Dialogue: 0,0:25:19.77,0:25:23.44,Default,,0,0,0,,Ở Okinawa, khi thấy\Nthứ gì đó đẹp đẽ, họ nói: "Joto!"
Dialogue: 0,0:25:23.52,0:25:24.77,Default,,0,0,0,,- Thế ạ?\N- Không ngờ luôn.
Dialogue: 0,0:25:24.86,0:25:28.32,Default,,0,0,0,,Có thể dùng để khen ngợi\Nvà thay cho lời cảm ơn.
Dialogue: 0,0:25:28.40,0:25:29.28,Default,,0,0,0,,Cháu sẽ dùng luôn.
Dialogue: 0,0:25:29.36,0:25:30.82,Default,,0,0,0,,- Joto!\N- Joto!
Dialogue: 0,0:25:30.90,0:25:32.78,Default,,0,0,0,,Nhờ cậy mấy đứa nhé.
Dialogue: 0,0:25:32.86,0:25:34.03,Default,,0,0,0,,- Nhờ bà ạ.\N- Joto!
Dialogue: 0,0:25:34.12,0:25:35.08,Default,,0,0,0,,- Joto!\N- Joto!
Dialogue: 0,0:25:35.87,0:25:36.96,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:25:37.04,0:25:38.58,Default,,0,0,0,,- Ở Okinawa.\N- Cũng từng nghe.
Dialogue: 0,0:25:38.66,0:25:41.08,Default,,0,0,0,,Kiểu: "Ôi, trang phục joto thế!"
Dialogue: 0,0:25:41.16,0:25:42.08,Default,,0,0,0,,Ồ, thế hả?
Dialogue: 0,0:25:42.17,0:25:44.17,Default,,0,0,0,,Không phải tại tiêu đề tiếng Nhật hả?
Dialogue: 0,0:25:44.25,0:25:45.38,Default,,0,0,0,,Chắc bà chưa xem đâu.
Dialogue: 0,0:25:47.46,0:25:50.63,Default,,0,0,0,,Được rồi, đi hái shikuwasa nha.
Dialogue: 0,0:25:50.72,0:25:51.68,Default,,0,0,0,,Shikuwasa?
Dialogue: 0,0:25:51.76,0:25:53.01,Default,,0,0,0,,- Tuyệt!\N- Chanh Okinawa.
Dialogue: 0,0:25:53.09,0:25:56.39,Default,,0,0,0,,Nhiều lắm, thấy không?\NChúng tôi không tự hái hết nổi.
Dialogue: 0,0:25:56.47,0:25:59.35,Default,,0,0,0,,Chúng tôi muốn các cháu\Nhọc cách hái, mang ra đây,
Dialogue: 0,0:25:59.43,0:26:05.23,Default,,0,0,0,,vắt rồi đóng chai,\Nrồi học cả quá trình đến khi vận chuyển.
Dialogue: 0,0:26:05.31,0:26:06.94,Default,,0,0,0,,- Được rồi.\N- Triển thôi!
Dialogue: 0,0:26:07.52,0:26:08.73,Default,,0,0,0,,- Joto!\N- Joto!
Dialogue: 0,0:26:09.23,0:26:10.65,Default,,0,0,0,,Được rồi, đi nào.
Dialogue: 0,0:26:10.74,0:26:12.08,Default,,0,0,0,,Đi thôi!
Dialogue: 0,0:26:13.11,0:26:14.19,Default,,0,0,0,,Bắt đầu nè.
Dialogue: 0,0:26:14.28,0:26:15.61,Default,,0,0,0,,Quốc tế quá.
Dialogue: 0,0:26:15.70,0:26:16.53,Default,,0,0,0,,To thế.
Dialogue: 0,0:26:16.62,0:26:17.58,Default,,0,0,0,,Hái đầy vào nha.
Dialogue: 0,0:26:17.66,0:26:19.12,Default,,0,0,0,,Ta sẽ hái đầy hết chỗ này.
Dialogue: 0,0:26:19.20,0:26:20.87,Default,,0,0,0,,Hái nhiều vào nhé.
Dialogue: 0,0:26:20.95,0:26:22.70,Default,,0,0,0,,- Hay thật.\N- Mình muốn uống.
Dialogue: 0,0:26:22.79,0:26:23.87,Default,,0,0,0,,Được hái không ạ?
Dialogue: 0,0:26:23.96,0:26:26.05,Default,,0,0,0,,Được. Hái hết mới có lợi cho cây.
Dialogue: 0,0:26:26.13,0:26:26.96,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:26:27.04,0:26:27.87,Default,,0,0,0,,Phải.
Dialogue: 0,0:26:27.96,0:26:30.55,Default,,0,0,0,,- Được rồi.\N- Hiểu rồi.
Dialogue: 0,0:26:30.63,0:26:33.13,Default,,0,0,0,,Trời, mê thứ này quá. Dã man!
Dialogue: 0,0:26:33.22,0:26:34.10,Default,,0,0,0,,Làm thế nào nhỉ?
Dialogue: 0,0:26:34.18,0:26:35.02,Default,,0,0,0,,Thế này.
Dialogue: 0,0:26:36.34,0:26:38.30,Default,,0,0,0,,Anh làm nghề này bao giờ chưa?
Dialogue: 0,0:26:38.39,0:26:39.56,Default,,0,0,0,,Chưa.
Dialogue: 0,0:26:40.85,0:26:41.77,Default,,0,0,0,,Chắc là hồi ở trại.
Dialogue: 0,0:26:41.85,0:26:42.68,Default,,0,0,0,,Ở trại!
Dialogue: 0,0:26:42.77,0:26:44.02,Default,,0,0,0,,Gọi là "trại".
Dialogue: 0,0:26:44.10,0:26:45.48,Default,,0,0,0,,- Nâng tôi lên nhé.\N- Được.
Dialogue: 0,0:26:46.31,0:26:47.14,Default,,0,0,0,,Lên vai tôi hả?
Dialogue: 0,0:26:47.23,0:26:48.06,Default,,0,0,0,,- Sẵn sàng?\N- Rồi.
Dialogue: 0,0:26:48.15,0:26:48.98,Default,,0,0,0,,- Trời.\N- Chà.
Dialogue: 0,0:26:49.07,0:26:50.24,Default,,0,0,0,,- Khoan.\N- Ừ.
Dialogue: 0,0:26:50.94,0:26:52.69,Default,,0,0,0,,Một, hai, lên nè!
Dialogue: 0,0:26:53.28,0:26:54.41,Default,,0,0,0,,Tuyệt quá.
Dialogue: 0,0:26:55.49,0:26:56.95,Default,,0,0,0,,Đừng để cành cây đập mặt tôi.
Dialogue: 0,0:26:57.03,0:26:58.36,Default,,0,0,0,,Tôi sẽ bị đâm đó.
Dialogue: 0,0:26:58.45,0:26:59.91,Default,,0,0,0,,Nếu không tôi sẽ kêu: "Joto!"
Dialogue: 0,0:27:01.24,0:27:02.95,Default,,0,0,0,,Đừng cười nữa, hái đi.
Dialogue: 0,0:27:03.04,0:27:04.42,Default,,0,0,0,,Không hết được đâu, Leo.
Dialogue: 0,0:27:04.50,0:27:06.21,Default,,0,0,0,,Tự nhiên lại thân nhau hơn.
Dialogue: 0,0:27:06.29,0:27:08.00,Default,,0,0,0,,Này, nhìn ổn nhỉ?
Dialogue: 0,0:27:08.08,0:27:09.17,Default,,0,0,0,,Ổn đó.
Dialogue: 0,0:27:11.21,0:27:14.38,Default,,0,0,0,,Giúp đỡ bà cụ cũng tuyệt nhỉ?
Dialogue: 0,0:27:14.47,0:27:15.30,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:27:16.26,0:27:21.97,Default,,0,0,0,,Tôi luôn đi làm tình nguyện
Dialogue: 0,0:27:22.06,0:27:25.44,Default,,0,0,0,,Tôi là kiểu người hay làm việc đó.
Dialogue: 0,0:27:26.35,0:27:29.31,Default,,0,0,0,,Thậm chí sau trận động đất Tohoku 2011…
Dialogue: 0,0:27:29.40,0:27:34.16,Default,,0,0,0,,Lúc đó tôi mới 15 tuổi,\Nnhưng tôi đã đến tình nguyện ở đó.
Dialogue: 0,0:27:34.78,0:27:37.03,Default,,0,0,0,,Tôi muốn tiêu tiền
Dialogue: 0,0:27:37.86,0:27:42.41,Default,,0,0,0,,cho mái ấm tình thương các thứ\Nđể giúp mọi người.
Dialogue: 0,0:27:42.49,0:27:44.20,Default,,0,0,0,,- Tuyệt quá.\N- Tốt bụng quá.
Dialogue: 0,0:27:44.29,0:27:45.71,Default,,0,0,0,,Tự hào về cô quá, Assun.
Dialogue: 0,0:27:46.33,0:27:48.96,Default,,0,0,0,,Anh từng đi tù hả?\NCó được làm hộ chiếu không?
Dialogue: 0,0:27:49.04,0:27:50.58,Default,,0,0,0,,Chủ đề gì vậy trời?
Dialogue: 0,0:27:51.29,0:27:54.63,Default,,0,0,0,,Tôi được làm hộ chiếu,\Nnhưng để đi Mỹ các thứ,
Dialogue: 0,0:27:55.13,0:27:56.13,Default,,0,0,0,,thì lắm thủ tục.
Dialogue: 0,0:27:56.22,0:27:57.05,Default,,0,0,0,,Ồ, vậy à?
Dialogue: 0,0:27:57.13,0:27:58.80,Default,,0,0,0,,Tôi có tiền án mà.
Dialogue: 0,0:27:58.89,0:28:00.10,Default,,0,0,0,,- Phải.\N- Họ sẽ chặn lại.
Dialogue: 0,0:28:00.18,0:28:01.06,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:28:01.14,0:28:03.85,Default,,0,0,0,,Có khả năng không được làm\Nhộ chiếu nếu có tiền án.
Dialogue: 0,0:28:03.93,0:28:04.85,Default,,0,0,0,,Ồ, vậy à?
Dialogue: 0,0:28:04.93,0:28:07.31,Default,,0,0,0,,- Cô ấy cái gì cũng biết.\N- Đâu có.
Dialogue: 0,0:28:07.39,0:28:08.47,Default,,0,0,0,,Cô ấy quốc tế mà.
Dialogue: 0,0:28:09.31,0:28:10.44,Default,,0,0,0,,Hikaru?
Dialogue: 0,0:28:10.52,0:28:11.35,Default,,0,0,0,,Vâng?
Dialogue: 0,0:28:11.44,0:28:12.69,Default,,0,0,0,,Vào trong này đi.
Dialogue: 0,0:28:13.36,0:28:14.32,Default,,0,0,0,,Được.
Dialogue: 0,0:28:15.82,0:28:16.99,Default,,0,0,0,,Cô dùng dầu gội tím hả?
Dialogue: 0,0:28:17.07,0:28:17.90,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:28:17.99,0:28:19.91,Default,,0,0,0,,Biết ngay mà. Tôi cũng thế.
Dialogue: 0,0:28:19.99,0:28:22.33,Default,,0,0,0,,- Cậu ấy là nhà tạo mẫu tóc.\N- Phải.
Dialogue: 0,0:28:22.41,0:28:23.37,Default,,0,0,0,,Cô dễ thương ghê.
Dialogue: 0,0:28:25.04,0:28:26.29,Default,,0,0,0,,Cô đang đỏ mặt à?
Dialogue: 0,0:28:26.37,0:28:27.50,Default,,0,0,0,,- Cô đỏ mặt à?\N- Đâu.
Dialogue: 0,0:28:27.58,0:28:28.42,Default,,0,0,0,,Không à?
Dialogue: 0,0:28:28.50,0:28:30.46,Default,,0,0,0,,Không mà, nhưng tự dưng có thêm động lực.
Dialogue: 0,0:28:30.54,0:28:32.13,Default,,0,0,0,,Ồ, thế à? Dễ thương ghê.
Dialogue: 0,0:28:33.38,0:28:35.55,Default,,0,0,0,,Cô là kiểu gyaru da trắng nhỉ?
Dialogue: 0,0:28:35.63,0:28:37.09,Default,,0,0,0,,Tôi không phải gyaru.
Dialogue: 0,0:28:37.17,0:28:38.55,Default,,0,0,0,,Hả? Chỉ da trắng thôi à?
Dialogue: 0,0:28:38.63,0:28:39.46,Default,,0,0,0,,Kiểu Hàn Quốc.
Dialogue: 0,0:28:39.55,0:28:40.93,Default,,0,0,0,,Kiểu Hàn Quốc à?
Dialogue: 0,0:28:41.01,0:28:42.80,Default,,0,0,0,,- Giống tôi.\N- Giống ư?
Dialogue: 0,0:28:42.89,0:28:43.77,Default,,0,0,0,,Ta cùng kiểu.
Dialogue: 0,0:28:43.85,0:28:46.02,Default,,0,0,0,,- Tôi có một phần tư gốc Hàn đấy.\N- Hả?
Dialogue: 0,0:28:46.52,0:28:49.02,Default,,0,0,0,,Ừ. Anh sẽ hiểu nếu thấy mặt mộc của tôi.
Dialogue: 0,0:28:49.10,0:28:50.35,Default,,0,0,0,,Cho tôi xem đi.
Dialogue: 0,0:28:50.44,0:28:51.27,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:28:51.35,0:28:52.35,Default,,0,0,0,,- Thật à?\N- Ừ.
Dialogue: 0,0:28:53.27,0:28:55.36,Default,,0,0,0,,Tâm trí tôi giờ chỉ nghĩ đến việc đó.
Dialogue: 0,0:28:55.94,0:28:58.11,Default,,0,0,0,,Vậy coi đó là động lực\Nđể hái thật nhiều đi.
Dialogue: 0,0:28:58.19,0:28:59.40,Default,,0,0,0,,Tuân lệnh.
Dialogue: 0,0:29:00.24,0:29:02.62,Default,,0,0,0,,Cẩn thận, Hikaru! Rơi rồi nè!
Dialogue: 0,0:29:04.66,0:29:07.37,Default,,0,0,0,,Tôi thấy Taisei và Hikaru\Nnói chuyện rất nhiều.
Dialogue: 0,0:29:07.45,0:29:08.70,Default,,0,0,0,,Tôi thấy khó chịu.
Dialogue: 0,0:29:08.79,0:29:11.17,Default,,0,0,0,,Nhưng tôi sẵn sàng đấu tranh.
Dialogue: 0,0:29:11.96,0:29:16.01,Default,,0,0,0,,Nếu cùng chọn một cô gái,\Nthì có thể tranh giành mà.
Dialogue: 0,0:29:16.09,0:29:19.09,Default,,0,0,0,,Tôi chỉ kiểu:\N"Chơi luôn! Tôi muốn xem cậu thử đấy!"
Dialogue: 0,0:29:19.17,0:29:22.01,Default,,0,0,0,,Tôi thấy cô ấy sẽ có\Nnhiều cơ hội hơn nếu chọn tôi.
Dialogue: 0,0:29:22.09,0:29:25.43,Default,,0,0,0,,Tôi muốn cô ấy hình dung\Nmột tương lai khi ở bên tôi.
Dialogue: 0,0:29:26.60,0:29:27.93,Default,,0,0,0,,Thơm quá.
Dialogue: 0,0:29:28.02,0:29:29.44,Default,,0,0,0,,- Thơm thật.\N- Gì vậy?
Dialogue: 0,0:29:29.52,0:29:31.61,Default,,0,0,0,,- Giỏi lắm, mọi người.\N- Để ở đâu ạ?
Dialogue: 0,0:29:31.69,0:29:34.03,Default,,0,0,0,,- Vắt hoa quả ở đây.\N- Vâng.
Dialogue: 0,0:29:34.11,0:29:35.15,Default,,0,0,0,,- Rồi.\N- Làm thôi.
Dialogue: 0,0:29:35.23,0:29:36.06,Default,,0,0,0,,Đây.
Dialogue: 0,0:29:36.86,0:29:38.20,Default,,0,0,0,,Thế này.
Dialogue: 0,0:29:38.90,0:29:40.99,Default,,0,0,0,,- Ngày nào cũng làm vất ghê.\N- Phải.
Dialogue: 0,0:29:42.70,0:29:44.45,Default,,0,0,0,,- Bọn mình không hay làm.\N- Phải.
Dialogue: 0,0:29:45.78,0:29:47.11,Default,,0,0,0,,Quả là trải nghiệm hay.
Dialogue: 0,0:29:48.54,0:29:50.21,Default,,0,0,0,,Trên mặt cậu là bản đồ à?
Dialogue: 0,0:29:50.29,0:29:51.46,Default,,0,0,0,,Ai cũng hỏi vậy ạ.
Dialogue: 0,0:29:51.54,0:29:52.71,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:29:52.79,0:29:54.00,Default,,0,0,0,,Hay ghê.
Dialogue: 0,0:29:54.08,0:29:55.21,Default,,0,0,0,,Bác ấy thẳng thắn ghê.
Dialogue: 0,0:29:55.29,0:29:56.88,Default,,0,0,0,,- Giống bản đồ.\N- Không phải ạ.
Dialogue: 0,0:29:56.96,0:29:58.38,Default,,0,0,0,,- Thế à?\N- Là tia sét ạ.
Dialogue: 0,0:29:58.46,0:29:59.29,Default,,0,0,0,,Tia sét?
Dialogue: 0,0:29:59.38,0:30:01.93,Default,,0,0,0,,- Dạ.\N- Tia sét trên khuôn mặt xinh đẹp này?
Dialogue: 0,0:30:02.01,0:30:03.64,Default,,0,0,0,,- Xinh đẹp ạ?\N- Ừ.
Dialogue: 0,0:30:03.72,0:30:04.89,Default,,0,0,0,,Cậu rất đẹp trai.
Dialogue: 0,0:30:04.97,0:30:06.06,Default,,0,0,0,,- Cảm ơn bà.\N- Ừ.
Dialogue: 0,0:30:06.14,0:30:07.14,Default,,0,0,0,,Cháu vui lắm.
Dialogue: 0,0:30:08.93,0:30:10.01,Default,,0,0,0,,Thấy không?
Dialogue: 0,0:30:10.52,0:30:11.40,Default,,0,0,0,,Tuyệt!
Dialogue: 0,0:30:11.48,0:30:12.61,Default,,0,0,0,,Hay nhỉ?
Dialogue: 0,0:30:12.69,0:30:13.61,Default,,0,0,0,,- Chà!\N- Ừ.
Dialogue: 0,0:30:13.69,0:30:14.90,Default,,0,0,0,,Đỉnh quá!
Dialogue: 0,0:30:24.03,0:30:25.49,Default,,0,0,0,,- Thơm quá.\N- Được rồi.
Dialogue: 0,0:30:25.99,0:30:27.74,Default,,0,0,0,,Chờ đến lúc ăn xong đã.
Dialogue: 0,0:30:27.83,0:30:29.21,Default,,0,0,0,,Muốn ăn quá ạ.
Dialogue: 0,0:30:29.29,0:30:30.83,Default,,0,0,0,,Đây nhé.
Dialogue: 0,0:30:30.91,0:30:31.79,Default,,0,0,0,,Trông ngon quá.
Dialogue: 0,0:30:31.87,0:30:32.70,Default,,0,0,0,,Măm măm.
Dialogue: 0,0:30:33.71,0:30:34.71,Default,,0,0,0,,Đây nhé.
Dialogue: 0,0:30:34.79,0:30:37.13,Default,,0,0,0,,- Ăn nào.\N- Xin mời.
Dialogue: 0,0:30:37.21,0:30:38.75,Default,,0,0,0,,Thử đi.
Dialogue: 0,0:30:38.84,0:30:39.92,Default,,0,0,0,,Ngon quá.
Dialogue: 0,0:30:40.00,0:30:41.54,Default,,0,0,0,,- Ngon không?\N- Chua!
Dialogue: 0,0:30:41.63,0:30:42.80,Default,,0,0,0,,Chua nhỉ?
Dialogue: 0,0:30:42.88,0:30:44.38,Default,,0,0,0,,- Trông lành mạnh ghê.\N- Ừ.
Dialogue: 0,0:30:44.47,0:30:45.68,Default,,0,0,0,,Ngon quá!
Dialogue: 0,0:30:45.76,0:30:46.72,Default,,0,0,0,,- Ngon hả?\N- Ừ.
Dialogue: 0,0:30:46.80,0:30:48.22,Default,,0,0,0,,- Ngon ghê.\N- Đỉnh thật.
Dialogue: 0,0:30:48.30,0:30:49.13,Default,,0,0,0,,- Ồ?\N- Đỉnh.
Dialogue: 0,0:30:49.22,0:30:50.14,Default,,0,0,0,,Thế thì mừng.
Dialogue: 0,0:30:50.22,0:30:51.43,Default,,0,0,0,,Mà mấy đứa…
Dialogue: 0,0:30:51.98,0:30:54.48,Default,,0,0,0,,Dù đã có chuyện gì xảy ra trong quá khứ,
Dialogue: 0,0:30:54.56,0:31:00.15,Default,,0,0,0,,nếu hiện tại làm việc vui vẻ,\Nthì mình còn đòi hỏi gì hơn nào?
Dialogue: 0,0:31:00.23,0:31:01.82,Default,,0,0,0,,Tại sao hả?
Dialogue: 0,0:31:01.90,0:31:06.28,Default,,0,0,0,,Thời đại hiện nay rất đáng sợ.
Dialogue: 0,0:31:06.36,0:31:10.03,Default,,0,0,0,,Con cái giết bố mẹ, bố mẹ giết con cái.
Dialogue: 0,0:31:10.12,0:31:13.08,Default,,0,0,0,,Nghĩ thôi mà thấy đau lòng.
Dialogue: 0,0:31:13.16,0:31:16.00,Default,,0,0,0,,Mỗi lần nghe tin tức kiểu đó,\Ntôi lại thắc mắc.
Dialogue: 0,0:31:16.08,0:31:19.42,Default,,0,0,0,,Chắc hẳn là có lý do,
Dialogue: 0,0:31:19.50,0:31:22.04,Default,,0,0,0,,nhưng tôi luôn nghĩ rằng
Dialogue: 0,0:31:22.13,0:31:26.09,Default,,0,0,0,,giá mà họ được giúp đỡ\Ntrước khi tình hình tiến triển đến mức đó.
Dialogue: 0,0:31:26.18,0:31:30.56,Default,,0,0,0,,Tôi muốn mấy đứa hãy nhớ điều đó\Nkhi bước tiếp trên con đường đời.
Dialogue: 0,0:31:31.89,0:31:35.81,Default,,0,0,0,,Chúng cháu đến đây để tìm tình yêu.
Dialogue: 0,0:31:35.89,0:31:38.60,Default,,0,0,0,,Chúng cháu nên làm gì\Nnếu thấy hứng thú với ai đó?
Dialogue: 0,0:31:38.69,0:31:42.24,Default,,0,0,0,,Cười thật tươi chào hỏi họ thôi.
Dialogue: 0,0:31:42.32,0:31:43.32,Default,,0,0,0,,- Phải.\N- Yêu ghê.
Dialogue: 0,0:31:43.40,0:31:45.07,Default,,0,0,0,,- Ừ.\N- Thế mới quan trọng.
Dialogue: 0,0:31:45.15,0:31:46.36,Default,,0,0,0,,- Quan trọng nhất đó.\N- Ừ.
Dialogue: 0,0:31:46.45,0:31:48.74,Default,,0,0,0,,Nếu cậu thích ai…
Dialogue: 0,0:31:48.82,0:31:49.86,Default,,0,0,0,,Nên rủ đi chơi ạ?
Dialogue: 0,0:31:49.95,0:31:51.87,Default,,0,0,0,,Ban đầu thì không làm thế.
Dialogue: 0,0:31:51.95,0:31:53.79,Default,,0,0,0,,Chậm mà chắc ạ?
Dialogue: 0,0:31:53.87,0:31:55.20,Default,,0,0,0,,Đừng làm họ giật mình.
Dialogue: 0,0:31:55.29,0:31:57.92,Default,,0,0,0,,Tôi hiểu cảm xúc của cậu. Cậu thích họ.
Dialogue: 0,0:31:58.00,0:32:01.38,Default,,0,0,0,,Nhưng nếu vừa thích đã rủ đi chơi,
Dialogue: 0,0:32:01.46,0:32:04.21,Default,,0,0,0,,cậu sẽ làm họ sợ và xa lánh.
Dialogue: 0,0:32:04.30,0:32:06.26,Default,,0,0,0,,- Lời khuyên từ một huyền thoại!\N- Phải.
Dialogue: 0,0:32:06.34,0:32:08.18,Default,,0,0,0,,- Nhỉ?\N- Bác ấy nói sự thật.
Dialogue: 0,0:32:08.26,0:32:09.64,Default,,0,0,0,,Chuẩn đét.
Dialogue: 0,0:32:09.72,0:32:10.76,Default,,0,0,0,,- Cháu hiểu ạ.\N- Tốt.
Dialogue: 0,0:32:10.85,0:32:12.64,Default,,0,0,0,,- Chúc may mắn.\N- Cảm ơn bà!
Dialogue: 0,0:32:13.22,0:32:14.06,Default,,0,0,0,,Bà ơi!
Dialogue: 0,0:32:15.85,0:32:17.60,Default,,0,0,0,,Hôm nay thật là vui.
Dialogue: 0,0:32:17.69,0:32:18.52,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:32:18.60,0:32:19.68,Default,,0,0,0,,- Mừng quá.\N- Vô giá.
Dialogue: 0,0:32:19.77,0:32:21.06,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:32:21.15,0:32:23.07,Default,,0,0,0,,Ngày mai mấy giờ cắt quả thế ạ?
Dialogue: 0,0:32:25.40,0:32:27.15,Default,,0,0,0,,À, mai à?
Dialogue: 0,0:32:27.24,0:32:28.62,Default,,0,0,0,,Cùng giờ? Buổi trưa?
Dialogue: 0,0:32:28.70,0:32:30.87,Default,,0,0,0,,Xin lỗi ạ.
Dialogue: 0,0:32:30.95,0:32:32.12,Default,,0,0,0,,Cháu đùa đó.
Dialogue: 0,0:32:32.20,0:32:33.45,Default,,0,0,0,,- Đùa à?\N- Cháu cuốn quá.
Dialogue: 0,0:32:37.46,0:32:40.17,Default,,0,0,0,,Thấy tay của bà không?
Dialogue: 0,0:32:40.88,0:32:42.01,Default,,0,0,0,,- Vết ố nâu.\N- Có.
Dialogue: 0,0:32:42.09,0:32:45.39,Default,,0,0,0,,Hẳn là vì bà đã làm việc này\Nmỗi ngày nhiều năm rồi,
Dialogue: 0,0:32:45.46,0:32:47.55,Default,,0,0,0,,những gì bà dựng xây thể hiện qua đôi tay.
Dialogue: 0,0:32:48.34,0:32:49.22,Default,,0,0,0,,Rất vất vả.
Dialogue: 0,0:32:49.30,0:32:50.13,Default,,0,0,0,,- Đúng vậy.\N- Ừ.
Dialogue: 0,0:32:50.22,0:32:54.68,Default,,0,0,0,,Nghĩ đến việc bà đã làm\Nviệc này 40 năm rồi.
Dialogue: 0,0:32:54.76,0:32:56.30,Default,,0,0,0,,Thật là tuyệt vời.
Dialogue: 0,0:32:56.39,0:32:58.60,Default,,0,0,0,,Thật tuyệt khi những nơi này tồn tại
Dialogue: 0,0:32:58.69,0:33:02.03,Default,,0,0,0,,để giúp đỡ trẻ em.
Dialogue: 0,0:33:02.11,0:33:04.20,Default,,0,0,0,,Thật tuyệt khi có ai đó\Nchăm lo cho lũ trẻ.
Dialogue: 0,0:33:05.15,0:33:08.28,Default,,0,0,0,,Những đứa trẻ được giúp đỡ…
Dialogue: 0,0:33:08.36,0:33:13.24,Default,,0,0,0,,Chúng lớn lên và cũng làm như vậy\Ncho những đứa trẻ cùng hoàn cảnh.
Dialogue: 0,0:33:13.32,0:33:17.74,Default,,0,0,0,,Chúng đền đáp bằng cách giúp người khác,\Ntôi thấy việc đó thật tuyệt.
Dialogue: 0,0:33:18.41,0:33:23.25,Default,,0,0,0,,Tôi nhận ra chúng ta\Ncần phải trân trọng những việc này.
Dialogue: 0,0:33:23.33,0:33:24.25,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:33:24.34,0:33:25.88,Default,,0,0,0,,Bà quả là một người ấm áp.
Dialogue: 0,0:33:26.75,0:33:29.00,Default,,0,0,0,,Mừng là họ rút ra được điều gì đó.
Dialogue: 0,0:33:32.34,0:33:34.18,Default,,0,0,0,,Đến giờ xông hơi buổi tối.
Dialogue: 0,0:33:34.26,0:33:35.43,Default,,0,0,0,,Hôm nay à?
Dialogue: 0,0:33:35.51,0:33:37.51,Default,,0,0,0,,Người được dùng hôm nay…
Dialogue: 0,0:33:38.64,0:33:42.27,Default,,0,0,0,,đã dũng cảm chia sẻ về quá khứ của mình.
Dialogue: 0,0:33:43.44,0:33:44.44,Default,,0,0,0,,Đó là Maririn.
Dialogue: 0,0:33:44.52,0:33:45.35,Default,,0,0,0,,Maririn!
Dialogue: 0,0:33:45.44,0:33:47.90,Default,,0,0,0,,Hãy chọn một chàng trai đi cùng.
Dialogue: 0,0:33:47.98,0:33:49.77,Default,,0,0,0,,- Hay quá.\N- Phấn khích ghê.
Dialogue: 0,0:33:49.86,0:33:51.57,Default,,0,0,0,,- Phấn khích!\N- Thật đó.
Dialogue: 0,0:33:51.65,0:33:53.07,Default,,0,0,0,,Tuyệt quá.
Dialogue: 0,0:33:53.16,0:33:54.66,Default,,0,0,0,,- Một phần thưởng.\N- Ôi, không.
Dialogue: 0,0:33:54.74,0:33:55.57,Default,,0,0,0,,Thật à?
Dialogue: 0,0:33:55.66,0:33:56.58,Default,,0,0,0,,Thì…
Dialogue: 0,0:33:56.66,0:33:58.83,Default,,0,0,0,,- Khó đây.\N- Phải.
Dialogue: 0,0:33:58.91,0:33:59.75,Default,,0,0,0,,Khó chọn ghê.
Dialogue: 0,0:33:59.83,0:34:01.83,Default,,0,0,0,,Các chàng trai tránh đi được không?
Dialogue: 0,0:34:01.91,0:34:03.12,Default,,0,0,0,,Anh em ra ngoài.
Dialogue: 0,0:34:03.21,0:34:05.42,Default,,0,0,0,,- Anh em ra ngoài.\N- Ừ, đi đây.
Dialogue: 0,0:34:05.50,0:34:07.00,Default,,0,0,0,,Không phải ở đây. Nghe thấy đó.
Dialogue: 0,0:34:07.09,0:34:08.18,Default,,0,0,0,,Tạm thời thôi.
Dialogue: 0,0:34:08.25,0:34:09.08,Default,,0,0,0,,Không sao.
Dialogue: 0,0:34:09.17,0:34:10.30,Default,,0,0,0,,- Hút thuốc.\N- Bàn nhau?
Dialogue: 0,0:34:10.38,0:34:12.01,Default,,0,0,0,,- Ừ, nào.\N- Lại đây.
Dialogue: 0,0:34:12.09,0:34:13.34,Default,,0,0,0,,Có mấy lựa chọn?
Dialogue: 0,0:34:13.43,0:34:14.26,Default,,0,0,0,,Mấy người?
Dialogue: 0,0:34:14.34,0:34:15.63,Default,,0,0,0,,Xem nào…
Dialogue: 0,0:34:15.72,0:34:17.01,Default,,0,0,0,,Ra rồi nha!
Dialogue: 0,0:34:17.10,0:34:20.94,Default,,0,0,0,,Tôi đã nói chuyện với Tai-chan…
Dialogue: 0,0:34:25.19,0:34:27.11,Default,,0,0,0,,nhưng chắc là Leo.
Dialogue: 0,0:34:27.19,0:34:28.27,Default,,0,0,0,,- Ồ?\N- Ừ.
Dialogue: 0,0:34:29.53,0:34:32.95,Default,,0,0,0,,Cảm giác Tai-chan\Nkhông muốn nói chuyện với tôi.
Dialogue: 0,0:34:33.03,0:34:35.91,Default,,0,0,0,,Tối qua tôi đưa thư mà cậu ấy chưa nói gì.
Dialogue: 0,0:34:35.99,0:34:38.37,Default,,0,0,0,,Ồ, cô ấy cảm thấy không được đáp lại.
Dialogue: 0,0:34:38.45,0:34:40.33,Default,,0,0,0,,Vậy là Tai-chan hoặc Leo.
Dialogue: 0,0:34:40.41,0:34:41.58,Default,,0,0,0,,- Tạm thế.\N- Ừ.
Dialogue: 0,0:34:42.58,0:34:46.25,Default,,0,0,0,,Nói thật, tôi muốn tán đổ Leo.\NHy vọng cô đừng chọn cậu ấy.
Dialogue: 0,0:34:47.88,0:34:48.96,Default,,0,0,0,,Căng rồi đây.
Dialogue: 0,0:34:49.05,0:34:49.88,Default,,0,0,0,,Hay.
Dialogue: 0,0:34:49.96,0:34:50.80,Default,,0,0,0,,Cô chọn chưa?
Dialogue: 0,0:34:51.46,0:34:52.71,Default,,0,0,0,,Các chàng trai sẽ làm gì?
Dialogue: 0,0:34:52.80,0:34:53.84,Default,,0,0,0,,Xong rồi!
Dialogue: 0,0:34:53.93,0:34:55.35,Default,,0,0,0,,Họ đi ra xa thật.
Dialogue: 0,0:34:55.43,0:34:56.31,Default,,0,0,0,,Chạy vội tới kìa.
Dialogue: 0,0:34:56.39,0:34:57.60,Default,,0,0,0,,Đáng yêu ghê.
Dialogue: 0,0:34:58.43,0:34:59.97,Default,,0,0,0,,Sao rồi!
Dialogue: 0,0:35:00.47,0:35:02.68,Default,,0,0,0,,Tôi đang nhìn tất cả mọi người!
Dialogue: 0,0:35:02.77,0:35:04.06,Default,,0,0,0,,Sao nhìn chằm chằm thế?
Dialogue: 0,0:35:04.14,0:35:07.94,Default,,0,0,0,,Giờ chúng tôi sẽ tuyên bố\Nngười Maririn chọn đi xông hơi cùng.
Dialogue: 0,0:35:12.78,0:35:14.03,Default,,0,0,0,,Leo.
Dialogue: 0,0:35:14.70,0:35:16.16,Default,,0,0,0,,Được rồi, đi thôi.
Dialogue: 0,0:35:16.24,0:35:17.49,Default,,0,0,0,,- Vâng.\N- Nhanh thế!
Dialogue: 0,0:35:18.20,0:35:20.16,Default,,0,0,0,,Ai cũng trả lời tức thì.
Dialogue: 0,0:35:20.24,0:35:22.58,Default,,0,0,0,,Mọi người đồng ý dễ thật!
Dialogue: 0,0:35:22.66,0:35:23.70,Default,,0,0,0,,Ặc.
Dialogue: 0,0:35:23.79,0:35:24.92,Default,,0,0,0,,Cô không thích đâu nhỉ?
Dialogue: 0,0:35:25.00,0:35:26.38,Default,,0,0,0,,Cô ấy không thèm giấu giếm.
Dialogue: 0,0:35:27.33,0:35:28.41,Default,,0,0,0,,Rất chân thật.
Dialogue: 0,0:35:28.50,0:35:30.34,Default,,0,0,0,,- Phải.\N- Ruru.
Dialogue: 0,0:35:30.42,0:35:31.92,Default,,0,0,0,,Lộ hết cả ra mặt.
Dialogue: 0,0:35:32.51,0:35:33.34,Default,,0,0,0,,Đi nha.
Dialogue: 0,0:35:33.42,0:35:34.88,Default,,0,0,0,,- Chào nha.\N- Vui nha.
Dialogue: 0,0:35:41.56,0:35:43.02,Default,,0,0,0,,Cô thấy thế nào?
Dialogue: 0,0:35:43.10,0:35:44.52,Default,,0,0,0,,Hơi khó chịu nhỉ?
Dialogue: 0,0:35:44.60,0:35:45.52,Default,,0,0,0,,- Nhỉ?\N- Ừ.
Dialogue: 0,0:35:46.10,0:35:48.39,Default,,0,0,0,,Tôi còn bảo cô ấy đừng chọn Leo.
Dialogue: 0,0:35:48.48,0:35:49.44,Default,,0,0,0,,- Ừ.\N- Thế à?
Dialogue: 0,0:35:50.02,0:35:51.52,Default,,0,0,0,,- Cô bảo thế?\N- Ừ.
Dialogue: 0,0:35:51.61,0:35:52.44,Default,,0,0,0,,Rồi sao?
Dialogue: 0,0:35:52.53,0:35:54.37,Default,,0,0,0,,- Cô ấy chọn luôn.\N- Chọn Leo luôn.
Dialogue: 0,0:35:54.44,0:35:55.28,Default,,0,0,0,,Máu chiến.
Dialogue: 0,0:35:56.24,0:35:58.33,Default,,0,0,0,,- Ừ, Maririn máu thật.\N- Chắc rồi.
Dialogue: 0,0:36:00.24,0:36:04.33,Default,,0,0,0,,Chúng tôi chưa từng nói chuyện\Nnên tôi muốn thử nói chuyện xem.
Dialogue: 0,0:36:04.41,0:36:08.87,Default,,0,0,0,,Tôi muốn xem chúng tôi\Nnói chuyện riêng sẽ như thế nào.
Dialogue: 0,0:36:08.96,0:36:12.88,Default,,0,0,0,,Maririn vừa bắt đầu mở lòng,
Dialogue: 0,0:36:12.96,0:36:15.55,Default,,0,0,0,,nên cô ấy muốn tìm hiểu từng người một.
Dialogue: 0,0:36:15.63,0:36:17.97,Default,,0,0,0,,Tôi không phiền. Kiểu như
Dialogue: 0,0:36:18.05,0:36:20.30,Default,,0,0,0,,Maririn xứng đáng được yêu\Nnhư bao người khác.
Dialogue: 0,0:36:20.85,0:36:24.15,Default,,0,0,0,,Nên nếu cô ấy muốn chọn Leo,\Nthì tôi cũng thấy ổn,
Dialogue: 0,0:36:24.22,0:36:26.01,Default,,0,0,0,,và tôi sẵn sàng tranh đấu.
Dialogue: 0,0:36:26.10,0:36:27.27,Default,,0,0,0,,Ê, ngầu nè.
Dialogue: 0,0:36:27.77,0:36:29.19,Default,,0,0,0,,Áo choàng tắm thích quá.
Dialogue: 0,0:36:29.27,0:36:30.19,Default,,0,0,0,,Nhìn ổn nhỉ?
Dialogue: 0,0:36:30.27,0:36:31.31,Default,,0,0,0,,Ổn lắm.
Dialogue: 0,0:36:31.81,0:36:32.69,Default,,0,0,0,,Trông đại gia chứ?
Dialogue: 0,0:36:32.77,0:36:33.90,Default,,0,0,0,,Chuẩn xã hội đen.
Dialogue: 0,0:36:33.98,0:36:34.81,Default,,0,0,0,,Thôi đi.
Dialogue: 0,0:36:35.82,0:36:36.86,Default,,0,0,0,,Ôi, chà.
Dialogue: 0,0:36:37.90,0:36:38.98,Default,,0,0,0,,Ồ, cậu có hình xăm?
Dialogue: 0,0:36:39.07,0:36:39.91,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:36:39.99,0:36:40.91,Default,,0,0,0,,Bất ngờ ghê.
Dialogue: 0,0:36:41.45,0:36:42.66,Default,,0,0,0,,Thế à?
Dialogue: 0,0:36:42.74,0:36:44.62,Default,,0,0,0,,Tôi tưởng cậu không có. Không lộ mà.
Dialogue: 0,0:36:44.70,0:36:45.87,Default,,0,0,0,,Xăm ở chân thì lộ.
Dialogue: 0,0:36:45.95,0:36:46.83,Default,,0,0,0,,- Đi nào.\N- Ừ.
Dialogue: 0,0:36:50.75,0:36:52.25,Default,,0,0,0,,Để dép ở đây à?
Dialogue: 0,0:36:52.34,0:36:53.30,Default,,0,0,0,,Cứ đi vào.
Dialogue: 0,0:36:53.38,0:36:54.22,Default,,0,0,0,,- Cứ đi hả?\N- Ừ.
Dialogue: 0,0:36:54.30,0:36:55.26,Default,,0,0,0,,Nóng thế.
Dialogue: 0,0:36:55.34,0:36:56.55,Default,,0,0,0,,Sao lại chọn tôi?
Dialogue: 0,0:36:56.63,0:37:01.05,Default,,0,0,0,,Tôi thấy thật tuyệt\Nkhi cậu chú ý lắng nghe tôi nói.
Dialogue: 0,0:37:01.14,0:37:02.60,Default,,0,0,0,,Lưng tôi xăm kín.
Dialogue: 0,0:37:02.68,0:37:03.60,Default,,0,0,0,,Chà, đỉnh!
Dialogue: 0,0:37:04.26,0:37:05.68,Default,,0,0,0,,- Đẹp không?\N- To đến đâu?
Dialogue: 0,0:37:05.77,0:37:06.73,Default,,0,0,0,,Đến tận khe mông.
Dialogue: 0,0:37:06.81,0:37:07.85,Default,,0,0,0,,Ngầu ghê.
Dialogue: 0,0:37:07.93,0:37:08.89,Default,,0,0,0,,- Thích chứ?\N- Thích.
Dialogue: 0,0:37:09.52,0:37:11.48,Default,,0,0,0,,Đẹp lắm, dù tôi không hiểu biết lắm.
Dialogue: 0,0:37:11.56,0:37:13.15,Default,,0,0,0,,Ừ, màu sắc rực rỡ.
Dialogue: 0,0:37:13.23,0:37:15.82,Default,,0,0,0,,Chà, tôi không ngờ đấy. Nóng bỏng phết.
Dialogue: 0,0:37:15.90,0:37:18.07,Default,,0,0,0,,Thế à? Vậy là điểm cộng rồi.
Dialogue: 0,0:37:18.15,0:37:19.15,Default,,0,0,0,,- Tốt.\N- Ừ, điểm cộng.
Dialogue: 0,0:37:19.24,0:37:20.91,Default,,0,0,0,,Gyaru nêu thứ gì cũng là điểm cộng.
Dialogue: 0,0:37:23.70,0:37:25.20,Default,,0,0,0,,Tôi thấy rất tuyệt.
Dialogue: 0,0:37:25.28,0:37:27.12,Default,,0,0,0,,Lúc trước cậu đã rất lắng nghe.
Dialogue: 0,0:37:27.20,0:37:31.29,Default,,0,0,0,,Và cậu cũng nhìn vào mắt bà cụ nữa.
Dialogue: 0,0:37:31.37,0:37:34.62,Default,,0,0,0,,Điều đó khiến tôi cảm thấy\Ncó khi cậu rất tuyệt vời.
Dialogue: 0,0:37:37.00,0:37:40.71,Default,,0,0,0,,Vì hôm nay các bạn đã giúp người dân,
Dialogue: 0,0:37:40.80,0:37:43.64,Default,,0,0,0,,nên các bạn được thưởng đồ uống.
Dialogue: 0,0:37:44.64,0:37:47.02,Default,,0,0,0,,Assun sung sướng.
Dialogue: 0,0:37:47.10,0:37:48.48,Default,,0,0,0,,- Nấu ăn.\N- Vừa uống vừa nấu.
Dialogue: 0,0:37:49.64,0:37:50.81,Default,,0,0,0,,Đỉnh thật.
Dialogue: 0,0:37:50.89,0:37:52.68,Default,,0,0,0,,Có khi tôi về trồng shikuwasa.
Dialogue: 0,0:37:52.77,0:37:53.98,Default,,0,0,0,,Phần thưởng của tôi đâu?
Dialogue: 0,0:37:54.65,0:37:56.82,Default,,0,0,0,,Ồ, phải, cô không uống rượu.
Dialogue: 0,0:37:57.40,0:37:59.40,Default,,0,0,0,,Không có phần thưởng cho cô ấy à?
Dialogue: 0,0:37:59.49,0:38:01.53,Default,,0,0,0,,Ồ, phải. Cô ấy không uống rượu.
Dialogue: 0,0:38:05.03,0:38:06.20,Default,,0,0,0,,Sao, cô dỗi gì vậy?
Dialogue: 0,0:38:07.29,0:38:09.63,Default,,0,0,0,,Sao thế? Vui lên nào.
Dialogue: 0,0:38:10.54,0:38:13.04,Default,,0,0,0,,Thôi. Tối này tôi không uống với cô vậy.
Dialogue: 0,0:38:13.12,0:38:15.08,Default,,0,0,0,,Chất thế.
Dialogue: 0,0:38:15.17,0:38:18.30,Default,,0,0,0,,Để một mình cô không uống\Nthật không phải. Tôi không cần uống.
Dialogue: 0,0:38:18.38,0:38:19.21,Default,,0,0,0,,Tử tế quá.
Dialogue: 0,0:38:19.30,0:38:21.64,Default,,0,0,0,,Nếu cô không uống, tôi cũng không.
Dialogue: 0,0:38:22.97,0:38:24.39,Default,,0,0,0,,Thế được chứ?
Dialogue: 0,0:38:24.47,0:38:26.39,Default,,0,0,0,,Anh được điểm cao.
Dialogue: 0,0:38:26.47,0:38:27.56,Default,,0,0,0,,Điểm cao?
Dialogue: 0,0:38:27.64,0:38:29.43,Default,,0,0,0,,- Ừ.\N- Chúc mừng.
Dialogue: 0,0:38:29.97,0:38:32.31,Default,,0,0,0,,Hay ghê.
Dialogue: 0,0:38:32.98,0:38:34.57,Default,,0,0,0,,Nhiệt huyết lên nhé.
Dialogue: 0,0:38:34.65,0:38:36.03,Default,,0,0,0,,Lạnh vãi chưởng.
Dialogue: 0,0:38:36.11,0:38:37.03,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:38:37.86,0:38:38.69,Default,,0,0,0,,Ặc.
Dialogue: 0,0:38:39.57,0:38:41.20,Default,,0,0,0,,Khoan, không đùa đâu.
Dialogue: 0,0:38:41.82,0:38:43.16,Default,,0,0,0,,Khoan, tạm dừng! Lạnh quá!
Dialogue: 0,0:38:43.24,0:38:44.58,Default,,0,0,0,,Trẻ ghê.
Dialogue: 0,0:38:45.36,0:38:47.32,Default,,0,0,0,,Như thể khởi động mùa hè sớm vậy!
Dialogue: 0,0:38:51.33,0:38:52.46,Default,,0,0,0,,Hôm nay là bước đầu.
Dialogue: 0,0:38:52.54,0:38:53.96,Default,,0,0,0,,Cô đã đi bước đầu hả?
Dialogue: 0,0:38:54.04,0:38:55.96,Default,,0,0,0,,- Ừ.\N- Chuyện lớn đó.
Dialogue: 0,0:38:56.04,0:38:57.08,Default,,0,0,0,,Quá lớn.
Dialogue: 0,0:38:57.17,0:38:58.17,Default,,0,0,0,,Thân hơn với tôi nhé.
Dialogue: 0,0:38:58.25,0:38:59.29,Default,,0,0,0,,- Đương nhiên.\N- Tốt.
Dialogue: 0,0:39:00.34,0:39:01.17,Default,,0,0,0,,Kể từ bây giờ.
Dialogue: 0,0:39:01.26,0:39:05.10,Default,,0,0,0,,Tâm trí tôi trống rỗng.\NTôi không nhớ chúng tôi đã nói gì.
Dialogue: 0,0:39:05.18,0:39:08.60,Default,,0,0,0,,Như cơ thể hai đứa chúng tôi\Nđã hòa làm một vậy.
Dialogue: 0,0:39:08.68,0:39:10.85,Default,,0,0,0,,Chúng tôi nói chuyện rất hợp.
Dialogue: 0,0:39:11.64,0:39:13.06,Default,,0,0,0,,Thế chứ.
Dialogue: 0,0:39:13.14,0:39:15.68,Default,,0,0,0,,Nghĩa là sao? "Xương sống quấn lấy nhau".
Dialogue: 0,0:39:15.77,0:39:17.77,Default,,0,0,0,,- Hay quá.\N- Hay quá.
Dialogue: 0,0:39:17.86,0:39:19.82,Default,,0,0,0,,Miêu tả rất là hay.
Dialogue: 0,0:39:19.90,0:39:21.23,Default,,0,0,0,,Em thích giải phẫu.
Dialogue: 0,0:39:21.32,0:39:22.15,Default,,0,0,0,,Thế à?
Dialogue: 0,0:39:22.23,0:39:23.48,Default,,0,0,0,,- Em thích lắm.\N- Thế à?
Dialogue: 0,0:39:23.57,0:39:24.86,Default,,0,0,0,,Sợ thế.
Dialogue: 0,0:39:24.95,0:39:27.50,Default,,0,0,0,,Lâu lắm rồi tim tôi mới đập thình thịch.
Dialogue: 0,0:39:27.57,0:39:30.41,Default,,0,0,0,,Ruru bảo xông hơi chẳng thần kỳ gì cả,
Dialogue: 0,0:39:30.49,0:39:33.33,Default,,0,0,0,,nhưng với tôi thì có.
Dialogue: 0,0:39:33.91,0:39:35.83,Default,,0,0,0,,- Tốt rồi.\N- Tôi sẽ rửa bát.
Dialogue: 0,0:39:35.92,0:39:37.09,Default,,0,0,0,,- Không sao.\N- Để tôi.
Dialogue: 0,0:39:37.17,0:39:38.34,Default,,0,0,0,,Cho món hamburger…
Dialogue: 0,0:39:38.42,0:39:39.25,Default,,0,0,0,,Uống bia không?
Dialogue: 0,0:39:39.34,0:39:40.17,Default,,0,0,0,,Tôi không.
Dialogue: 0,0:39:40.71,0:39:43.30,Default,,0,0,0,,Anh không uống thật à?
Dialogue: 0,0:39:43.38,0:39:44.71,Default,,0,0,0,,- Tối nay thì không.\N- Hay.
Dialogue: 0,0:39:44.80,0:39:45.88,Default,,0,0,0,,Tôi hứa với cô ấy rồi.
Dialogue: 0,0:39:50.26,0:39:51.47,Default,,0,0,0,,- Dễ thương.\N- Đây.
Dialogue: 0,0:39:52.10,0:39:53.39,Default,,0,0,0,,Cô thấy vui không?
Dialogue: 0,0:39:53.47,0:39:55.31,Default,,0,0,0,,Nghe nè.
Dialogue: 0,0:39:56.10,0:39:57.85,Default,,0,0,0,,Đừng khen nhiều quá.
Dialogue: 0,0:39:57.94,0:39:58.94,Default,,0,0,0,,Ồ, được rồi.
Dialogue: 0,0:39:59.02,0:40:00.23,Default,,0,0,0,,- Chỉ khi đặc biệt?\N- Ừ.
Dialogue: 0,0:40:00.31,0:40:01.14,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:40:06.49,0:40:09.49,Default,,0,0,0,,- Cô đang đỏ mặt kìa.\N- Tôi bảo nói thì nói, dừng thì dừng.
Dialogue: 0,0:40:10.78,0:40:12.03,Default,,0,0,0,,Tôi như con mèo vậy.
Dialogue: 0,0:40:12.12,0:40:14.33,Default,,0,0,0,,Ừ, con mèo. Lúc nóng lúc lạnh.
Dialogue: 0,0:40:14.41,0:40:15.41,Default,,0,0,0,,Toàn làm theo ý mình.
Dialogue: 0,0:40:19.50,0:40:24.05,Default,,0,0,0,,Cậu ta cứ dính lấy cô ấy.\NGhét vãi. Tôi muốn tẩn cậu ta.
Dialogue: 0,0:40:24.13,0:40:25.80,Default,,0,0,0,,Kiểu: "Bắt cóc đấy nhé, ranh con".
Dialogue: 0,0:40:27.43,0:40:28.85,Default,,0,0,0,,Tôi thấy thế đấy.
Dialogue: 0,0:40:29.51,0:40:31.72,Default,,0,0,0,,Nhưng thế thì dễ quá.
Dialogue: 0,0:40:31.80,0:40:34.93,Default,,0,0,0,,Chắc là tôi sẽ giành lấy cô ấy\Nmột cách công bằng.
Dialogue: 0,0:40:35.77,0:40:39.11,Default,,0,0,0,,Đàn ông bình tĩnh và điềm đạm\Nrõ ràng là hấp dẫn hơn.
Dialogue: 0,0:40:39.19,0:40:40.73,Default,,0,0,0,,Nên tôi sẽ không vội.
Dialogue: 0,0:40:41.69,0:40:42.52,Default,,0,0,0,,Ăn thôi!
Dialogue: 0,0:40:42.61,0:40:44.36,Default,,0,0,0,,Ăn nào.
Dialogue: 0,0:40:44.44,0:40:45.32,Default,,0,0,0,,Tuyệt.
Dialogue: 0,0:40:48.95,0:40:50.49,Default,,0,0,0,,Ừ, ngon quá.
Dialogue: 0,0:40:51.20,0:40:52.08,Default,,0,0,0,,Canh miso ngon.
Dialogue: 0,0:40:53.03,0:40:53.87,Default,,0,0,0,,Cay quá.
Dialogue: 0,0:40:54.87,0:40:55.70,Default,,0,0,0,,Chà! Măm măm!
Dialogue: 0,0:40:55.79,0:40:57.21,Default,,0,0,0,,Tuyệt quá nhỉ?
Dialogue: 0,0:40:57.79,0:40:58.96,Default,,0,0,0,,- Họ kìa.\N- Về rồi nè.
Dialogue: 0,0:40:59.04,0:41:00.75,Default,,0,0,0,,- Chào mừng.\N- Cảm ơn.
Dialogue: 0,0:41:00.83,0:41:01.83,Default,,0,0,0,,- Chào mừng.\N- Ừ.
Dialogue: 0,0:41:01.92,0:41:02.88,Default,,0,0,0,,- Chào.\N- Cảm ơn.
Dialogue: 0,0:41:02.96,0:41:04.50,Default,,0,0,0,,Buổi tối dã man phết.
Dialogue: 0,0:41:04.59,0:41:05.63,Default,,0,0,0,,- Thế à?\N- Thần kỳ hả?
Dialogue: 0,0:41:05.71,0:41:07.34,Default,,0,0,0,,Xông hơi có thần kỳ thật không?
Dialogue: 0,0:41:07.42,0:41:09.26,Default,,0,0,0,,- Xông hơi thần kỳ.\N- Xông hơi thần kỳ?
Dialogue: 0,0:41:09.34,0:41:10.93,Default,,0,0,0,,- Bầu không khí dã man.\N- Ừ.
Dialogue: 0,0:41:11.64,0:41:13.73,Default,,0,0,0,,- Tâm sự sâu chứ?\N- Ừ.
Dialogue: 0,0:41:13.80,0:41:14.97,Default,,0,0,0,,Kiểu…
Dialogue: 0,0:41:15.64,0:41:19.35,Default,,0,0,0,,Nóng quá nên đầu tôi trống rỗng.
Dialogue: 0,0:41:19.44,0:41:20.98,Default,,0,0,0,,Tôi chẳng nhớ đã nói gì.
Dialogue: 0,0:41:21.06,0:41:23.27,Default,,0,0,0,,- Thế à?\N- Cậu làm tâm trí cô ấy trống rỗng à?
Dialogue: 0,0:41:23.36,0:41:25.53,Default,,0,0,0,,Cháy thế!
Dialogue: 0,0:41:26.32,0:41:27.40,Default,,0,0,0,,Không phải như thế.
Dialogue: 0,0:41:28.19,0:41:29.23,Default,,0,0,0,,Không phải như vậy.
Dialogue: 0,0:41:29.32,0:41:33.41,Default,,0,0,0,,Hai cái đồ ngốc này\Nđừng vội kết luận được không?
Dialogue: 0,0:41:33.49,0:41:34.32,Default,,0,0,0,,Thật đó.
Dialogue: 0,0:41:37.04,0:41:37.96,Default,,0,0,0,,Được rồi, ngủ ngon.
Dialogue: 0,0:41:38.04,0:41:38.87,Default,,0,0,0,,Ngủ ngon.
Dialogue: 0,0:41:38.95,0:41:40.62,Default,,0,0,0,,Ngủ ngon nha.
Dialogue: 0,0:41:41.92,0:41:42.92,Default,,0,0,0,,Thế nào?
Dialogue: 0,0:41:43.00,0:41:45.63,Default,,0,0,0,,Chúng tôi không nói nhiều về yêu đương.
Dialogue: 0,0:41:46.80,0:41:50.72,Default,,0,0,0,,Lúc nói chuyện, tôi nhận ra\Ntôi rất thụ động trong chuyện tình cảm.
Dialogue: 0,0:41:50.80,0:41:52.05,Default,,0,0,0,,- Ồ, cô hả?\N- Ừ.
Dialogue: 0,0:41:52.13,0:41:53.26,Default,,0,0,0,,- Có lý.\N- Ừ.
Dialogue: 0,0:41:53.34,0:41:54.17,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:41:54.26,0:41:57.01,Default,,0,0,0,,Tai-chan tán cô dồn dập nhỉ?
Dialogue: 0,0:41:57.10,0:41:59.10,Default,,0,0,0,,Cậu ấy định rủ cô đi xông hơi nhỉ?
Dialogue: 0,0:41:59.18,0:42:00.01,Default,,0,0,0,,Ồ, thế à?
Dialogue: 0,0:42:00.10,0:42:02.02,Default,,0,0,0,,Hai người đó máu ghê cơ.
Dialogue: 0,0:42:02.10,0:42:02.94,Default,,0,0,0,,Ai cơ?
Dialogue: 0,0:42:03.02,0:42:04.73,Default,,0,0,0,,Ari và Tai-chan.
Dialogue: 0,0:42:04.81,0:42:06.77,Default,,0,0,0,,- Cô ấy bị bủa vây.\N- Kể nữa đi.
Dialogue: 0,0:42:07.82,0:42:09.99,Default,,0,0,0,,Kiểu như lá thư của tôi không tồn tại.
Dialogue: 0,0:42:10.07,0:42:12.11,Default,,0,0,0,,- Ồ, phải.\N- Đó là mơ à?
Dialogue: 0,0:42:12.20,0:42:14.04,Default,,0,0,0,,- Đó là mơ à?\N- Ý cô là sao?
Dialogue: 0,0:42:14.11,0:42:16.20,Default,,0,0,0,,Tôi đã đưa thư lúc hai người nói chuyện.
Dialogue: 0,0:42:16.28,0:42:17.16,Default,,0,0,0,,Ồ, phải.
Dialogue: 0,0:42:17.24,0:42:19.24,Default,,0,0,0,,Tôi cũng nghe nói.
Dialogue: 0,0:42:19.33,0:42:21.04,Default,,0,0,0,,- Cậu ấy bảo gì?\N- Cậu ấy kiểu:
Dialogue: 0,0:42:21.12,0:42:27.50,Default,,0,0,0,,"Tôi không định nói về\Nviệc trả lời thư của Maririn đâu".
Dialogue: 0,0:42:27.59,0:42:28.68,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:42:28.75,0:42:29.96,Default,,0,0,0,,Đó đâu phải câu trả lời.
Dialogue: 0,0:42:30.05,0:42:32.89,Default,,0,0,0,,Tôi chịu. Tôi không biết\Ncô viết gì trong thư.
Dialogue: 0,0:42:32.97,0:42:35.18,Default,,0,0,0,,Vậy thì Tai-chan sai lè.
Dialogue: 0,0:42:35.26,0:42:37.22,Default,,0,0,0,,Tôi viết là tôi có hứng thú với cậu ấy.
Dialogue: 0,0:42:37.30,0:42:39.76,Default,,0,0,0,,"Tôi muốn cậu nói chuyện,\Ntiếp cận tôi nhiều hơn,
Dialogue: 0,0:42:39.85,0:42:41.89,Default,,0,0,0,,và tôi cũng thế. Tôi có hứng thú với cậu".
Dialogue: 0,0:42:41.98,0:42:43.94,Default,,0,0,0,,Thế cậu ấy muốn tôi hiểu ý hả?
Dialogue: 0,0:42:44.02,0:42:45.65,Default,,0,0,0,,- Gì vậy trời?\N- Ghét thế.
Dialogue: 0,0:42:45.73,0:42:47.11,Default,,0,0,0,,- Chẳng đàn ông gì cả.\N- Đùa.
Dialogue: 0,0:42:47.19,0:42:49.36,Default,,0,0,0,,Ừ, cậu ấy chẳng phải đàn ông.
Dialogue: 0,0:42:49.44,0:42:51.94,Default,,0,0,0,,Nếu cậu ấy không thích tôi,\Nthì cứ nói là được.
Dialogue: 0,0:42:52.03,0:42:55.87,Default,,0,0,0,,Cậu ta kiểu: Tôi quyết định\Nchọn Hikaru trong đầu rồi.
Dialogue: 0,0:42:55.95,0:42:57.54,Default,,0,0,0,,Cứ nói với tôi là được mà.
Dialogue: 0,0:42:57.62,0:42:58.83,Default,,0,0,0,,Ừ, kiểu…
Dialogue: 0,0:42:58.91,0:43:02.46,Default,,0,0,0,,Nói với tôi mới công bằng với Hikaru chứ.
Dialogue: 0,0:43:02.54,0:43:06.50,Default,,0,0,0,,Phải, cậu ta có thể bảo Maririn\Nlà cậu ta chọn Hikaru rồi.
Dialogue: 0,0:43:07.08,0:43:09.46,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:43:09.55,0:43:11.14,Default,,0,0,0,,Không ngờ Hikaru lại nói thế.
Dialogue: 0,0:43:11.21,0:43:13.05,Default,,0,0,0,,- Cô ấy nói hết luôn.\N- Họ như thế đấy.
Dialogue: 0,0:43:13.13,0:43:14.21,Default,,0,0,0,,Không ngần ngại gì.
Dialogue: 0,0:43:14.30,0:43:17.43,Default,,0,0,0,,Đó là chàng trai\Nđang thích cô đấy, biết chứ?
Dialogue: 0,0:43:17.51,0:43:21.64,Default,,0,0,0,,Cá nhân tôi thì thấy\Nđó không phải thứ ta đang tìm kiếm, nhỉ?
Dialogue: 0,0:43:21.72,0:43:26.02,Default,,0,0,0,,Chúng ta đã hẹn hò những người\Nbiết làm điều đúng đắn.
Dialogue: 0,0:43:26.10,0:43:29.02,Default,,0,0,0,,Nên ta tham gia Tình yêu nổi loạn\Nđể tìm kiểu người đó.
Dialogue: 0,0:43:29.11,0:43:30.99,Default,,0,0,0,,- Ta không ở đây để tìm bọn khốn.\N- Ừ.
Dialogue: 0,0:43:31.07,0:43:31.99,Default,,0,0,0,,Chính là thế.
Dialogue: 0,0:43:32.07,0:43:33.91,Default,,0,0,0,,Tôi muốn chửi Tai-chan một trận.
Dialogue: 0,0:43:33.99,0:43:36.45,Default,,0,0,0,,Tra khảo luôn. Kiểu: "Cậu làm sao vậy?"
Dialogue: 0,0:43:36.53,0:43:39.87,Default,,0,0,0,,Cô nên nói chuyện với cậu ta\Ntrước khi cảm xúc này dịu đi.
Dialogue: 0,0:43:40.78,0:43:43.78,Default,,0,0,0,,Nếu cậu ta lảng tránh,\Nchúng tôi sẽ can thiệp.
Dialogue: 0,0:43:43.87,0:43:46.71,Default,,0,0,0,,Chúng ta nên chửi cậu ta một trận.
Dialogue: 0,0:43:46.79,0:43:47.88,Default,,0,0,0,,Đừng chần chừ.
Dialogue: 0,0:43:47.96,0:43:51.80,Default,,0,0,0,,Hơn nữa, Maririn từng bị chấn thương\Nvì những mối tình cũ.
Dialogue: 0,0:43:51.88,0:43:55.01,Default,,0,0,0,,Nên Tai-chan phải trả lời cô ấy rõ ràng.
Dialogue: 0,0:43:55.09,0:43:57.89,Default,,0,0,0,,Là đàn ông mà cậu ta\Ncư xử không phải. Thật thảm hại.
Dialogue: 0,0:43:58.55,0:44:01.64,Default,,0,0,0,,Chị em rất đáng sợ khi họ như thế này.
Dialogue: 0,0:44:01.72,0:44:02.80,Default,,0,0,0,,Đáng sợ lắm.
Dialogue: 0,0:44:03.31,0:44:04.81,Default,,0,0,0,,Được rồi, hiểu rồi.
Dialogue: 0,0:44:15.36,0:44:16.19,Default,,0,0,0,,Ê này.
Dialogue: 0,0:44:16.28,0:44:17.99,Default,,0,0,0,,- Chào mừng.\N- Sao rồi?
Dialogue: 0,0:44:18.07,0:44:19.07,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:44:19.16,0:44:20.45,Default,,0,0,0,,Tai-chan, nói chuyện nhé.
Dialogue: 0,0:44:20.53,0:44:21.41,Default,,0,0,0,,- Tôi à?\N- Ừ.
Dialogue: 0,0:44:22.24,0:44:23.28,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:44:23.37,0:44:24.62,Default,,0,0,0,,Cậu ấy chẳng biết gì.
Dialogue: 0,0:44:24.70,0:44:25.74,Default,,0,0,0,,Mặt đỏ bừng!
Dialogue: 0,0:44:25.83,0:44:27.00,Default,,0,0,0,,- Mượn tí nhé.\N- Ừ.
Dialogue: 0,0:44:27.08,0:44:27.91,Default,,0,0,0,,Không sao.
Dialogue: 0,0:44:28.00,0:44:30.13,Default,,0,0,0,,Được, cứ mang cậu ấy đi.
Dialogue: 0,0:44:30.63,0:44:31.46,Default,,0,0,0,,Năm tiếng đi.
Dialogue: 0,0:44:32.17,0:44:33.63,Default,,0,0,0,,Qua lớp học nhé.
Dialogue: 0,0:44:34.46,0:44:35.67,Default,,0,0,0,,- Lớp học?\N- Ừ.
Dialogue: 0,0:44:35.76,0:44:37.60,Default,,0,0,0,,- Tôi muốn nói chuyện.\N- Được.
Dialogue: 0,0:44:38.30,0:44:39.80,Default,,0,0,0,,- Đau đây.\N- Nhỉ?
Dialogue: 0,0:44:39.89,0:44:41.35,Default,,0,0,0,,Cậu ấy còn uống rồi.
Dialogue: 0,0:44:41.43,0:44:44.31,Default,,0,0,0,,Có khi cậu ấy nghĩ\Ncô ấy sẽ nói thích mình.
Dialogue: 0,0:44:44.39,0:44:45.81,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:44:50.90,0:44:51.98,Default,,0,0,0,,Được rồi…
Dialogue: 0,0:44:52.73,0:44:54.32,Default,,0,0,0,,Tôi đưa cậu thư rồi nhỉ?
Dialogue: 0,0:44:54.98,0:44:57.27,Default,,0,0,0,,Không biết có phải cậu coi như không.
Dialogue: 0,0:44:58.28,0:45:00.20,Default,,0,0,0,,Tôi đã muốn cậu hồi đáp.
Dialogue: 0,0:45:00.28,0:45:01.45,Default,,0,0,0,,Chắc là chưa nhỉ?
Dialogue: 0,0:45:01.53,0:45:05.16,Default,,0,0,0,,Kiểu cậu nghĩ sao.\NSao cậu không nói với tôi?
Dialogue: 0,0:45:06.66,0:45:08.79,Default,,0,0,0,,Cậu đã có cơ hội khi ta hái shikuwasa.
Dialogue: 0,0:45:08.87,0:45:11.50,Default,,0,0,0,,Ừ, chắc là cô nói đúng.
Dialogue: 0,0:45:12.21,0:45:16.34,Default,,0,0,0,,Cảm giác như\Ncậu tránh nói chuyện với tôi vậy.
Dialogue: 0,0:45:16.42,0:45:18.42,Default,,0,0,0,,Vậy cậu không để ý đến tôi nữa hả?
Dialogue: 0,0:45:18.51,0:45:20.93,Default,,0,0,0,,Không phải thế. Mà kiểu…
Dialogue: 0,0:45:21.01,0:45:25.43,Default,,0,0,0,,Tôi thích Hikaru, cô biết chứ?
Dialogue: 0,0:45:25.51,0:45:26.34,Default,,0,0,0,,Ừ.
Dialogue: 0,0:45:27.47,0:45:30.77,Default,,0,0,0,,Và cô viết thư cho tôi.
Dialogue: 0,0:45:31.73,0:45:33.23,Default,,0,0,0,,Và…
Dialogue: 0,0:45:34.73,0:45:37.36,Default,,0,0,0,,- Nói thật, tôi…\N- Ừ?
Dialogue: 0,0:45:38.44,0:45:39.52,Default,,0,0,0,,Cậu ấy hoảng rồi.
Dialogue: 0,0:45:39.61,0:45:41.70,Default,,0,0,0,,Cậu ấy hẳn là bé ngoan mà.
Dialogue: 0,0:45:42.53,0:45:45.16,Default,,0,0,0,,Trong tình yêu, tôi toàn yêu đơn phương.
Dialogue: 0,0:45:45.24,0:45:47.08,Default,,0,0,0,,Được rồi, và?
Dialogue: 0,0:45:48.70,0:45:52.50,Default,,0,0,0,,Nếu tôi chọn ai, tôi luôn toàn tâm với họ.
Dialogue: 0,0:45:52.58,0:45:54.21,Default,,0,0,0,,Thế mới là đàn ông mà.
Dialogue: 0,0:45:54.29,0:45:56.79,Default,,0,0,0,,- Ừ.\N- Nhưng nếu thế…
Dialogue: 0,0:45:56.88,0:45:59.42,Default,,0,0,0,,hoặc cậu muốn\Ntìm hiểu chúng tôi, không sao.
Dialogue: 0,0:45:59.51,0:46:00.85,Default,,0,0,0,,Không phải tất cả đâu.
Dialogue: 0,0:46:00.92,0:46:02.09,Default,,0,0,0,,Không? Vậy thì ai?
Dialogue: 0,0:46:02.72,0:46:05.47,Default,,0,0,0,,Hiện tại, có lẽ tôi chỉ\Nđơn phương Hikaru thôi.
Dialogue: 0,0:46:05.55,0:46:06.72,Default,,0,0,0,,"Có lẽ" à?
Dialogue: 0,0:46:06.81,0:46:08.02,Default,,0,0,0,,- Chắc chắn.\N- Ừ.
Dialogue: 0,0:46:08.10,0:46:11.48,Default,,0,0,0,,Vậy cậu chưa từng nghĩ đến thư của tôi à?
Dialogue: 0,0:46:11.56,0:46:12.69,Default,,0,0,0,,Không hẳn là thế.
Dialogue: 0,0:46:12.77,0:46:13.90,Default,,0,0,0,,Cái gì không hẳn?
Dialogue: 0,0:46:15.77,0:46:17.52,Default,,0,0,0,,Thì…
Dialogue: 0,0:46:21.40,0:46:23.86,Default,,0,0,0,,Có lẽ phần nào đó trong tôi đang đợi.
Dialogue: 0,0:46:23.95,0:46:25.16,Default,,0,0,0,,Đợi tôi à?
Dialogue: 0,0:46:26.33,0:46:29.25,Default,,0,0,0,,Tôi bộc bạch rồi, nhưng cậu…
Dialogue: 0,0:46:30.12,0:46:31.21,Default,,0,0,0,,Cậu muốn nhiều hơn?
Dialogue: 0,0:46:31.29,0:46:32.25,Default,,0,0,0,,Thì…
Dialogue: 0,0:46:33.71,0:46:34.71,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:46:34.79,0:46:36.42,Default,,0,0,0,,- Hả?\N- Ôi, nhưng…
Dialogue: 0,0:46:36.50,0:46:39.29,Default,,0,0,0,,- Nói thẳng vào mặt cô ấy thì khó quá.\N- Phải.
Dialogue: 0,0:46:41.05,0:46:43.64,Default,,0,0,0,,Nhưng tôi thừa nhận mình đã sai.
Dialogue: 0,0:46:44.30,0:46:45.72,Default,,0,0,0,,Tôi xin lỗi nhé.
Dialogue: 0,0:46:45.80,0:46:48.22,Default,,0,0,0,,- Cậu chờ ở đây nhé?\N- Ừ.
Dialogue: 0,0:46:48.31,0:46:49.23,Default,,0,0,0,,- Hả?\N- Gì vậy?
Dialogue: 0,0:46:50.06,0:46:51.31,Default,,0,0,0,,Phải chăng?
Dialogue: 0,0:46:51.93,0:46:52.76,Default,,0,0,0,,Cô lạnh không?
Dialogue: 0,0:46:52.85,0:46:54.14,Default,,0,0,0,,Không, chờ chút nhé.
Dialogue: 0,0:46:54.23,0:46:55.27,Default,,0,0,0,,- Sợ thế.\N- Ừ.
Dialogue: 0,0:46:59.98,0:47:01.57,Default,,0,0,0,,- Không xong rồi.\N- Sao?
Dialogue: 0,0:47:01.65,0:47:03.24,Default,,0,0,0,,Cậu ấy cứ né chủ đề.
Dialogue: 0,0:47:03.32,0:47:04.70,Default,,0,0,0,,- Đi nào.\N- Đi.
Dialogue: 0,0:47:04.78,0:47:06.11,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:47:06.20,0:47:07.70,Default,,0,0,0,,Xảy ra thật rồi!
Dialogue: 0,0:47:07.78,0:47:09.41,Default,,0,0,0,,Biết ý đi chứ.
Dialogue: 0,0:47:09.49,0:47:11.28,Default,,0,0,0,,Đến giờ tấn công!
Dialogue: 0,0:47:11.37,0:47:14.58,Default,,0,0,0,,Nói rõ nhé, cậu ấy đã bảo\Ncậu ấy toàn tâm với Hikaru.
Dialogue: 0,0:47:14.67,0:47:17.42,Default,,0,0,0,,Nên tôi hỏi\Ncậu ấy có nghĩ đến thư của tôi.
Dialogue: 0,0:47:17.50,0:47:21.21,Default,,0,0,0,,Cậu ấy bảo không hẳn,\Nnhưng chắc là tôi đang đợi.
Dialogue: 0,0:47:21.30,0:47:22.18,Default,,0,0,0,,Nghĩa là sao?
Dialogue: 0,0:47:22.26,0:47:23.26,Default,,0,0,0,,Kiểu: "Tôi đang đợi".
Dialogue: 0,0:47:23.34,0:47:25.38,Default,,0,0,0,,Tôi đang đợi cô đến nói chuyện.
Dialogue: 0,0:47:25.47,0:47:28.39,Default,,0,0,0,,- Gì? Cô chủ động rồi mà.\N- Phải đó. Tôi kiểu: Hả?
Dialogue: 0,0:47:28.47,0:47:29.93,Default,,0,0,0,,Không khớp gì cả.
Dialogue: 0,0:47:30.01,0:47:32.56,Default,,0,0,0,,Cậu ấy cứ tránh rồi xin lỗi.\NTôi không chịu nổi nữa.
Dialogue: 0,0:47:32.64,0:47:34.48,Default,,0,0,0,,Họ đều cứng đầu.
Dialogue: 0,0:47:44.74,0:47:46.41,Default,,0,0,0,,Sao Hikaru không đi?
Dialogue: 0,0:47:46.49,0:47:50.83,Default,,0,0,0,,Nhỉ? Cô ấy ba hoa mà.
Dialogue: 0,0:47:53.54,0:47:54.37,Default,,0,0,0,,Cậu ngủ à?
Dialogue: 0,0:47:54.96,0:47:56.21,Default,,0,0,0,,Dậy nào!
Dialogue: 0,0:47:56.29,0:47:57.12,Default,,0,0,0,,Cậu ngủ à?
Dialogue: 0,0:47:57.21,0:47:58.09,Default,,0,0,0,,Ngủ gật à?
Dialogue: 0,0:47:58.75,0:47:59.63,Default,,0,0,0,,Dậy đi!
Dialogue: 0,0:48:01.50,0:48:04.71,Default,,0,0,0,,Tôi nghe chuyện rồi,\Nthấy bực nên tới mắng cậu đây.
Dialogue: 0,0:48:06.51,0:48:09.47,Default,,0,0,0,,Tôi phải chửi cậu một trận, Tai-chan.
Dialogue: 0,0:48:09.55,0:48:12.05,Default,,0,0,0,,Nói cho rõ, chúng tôi…
Dialogue: 0,0:48:12.14,0:48:14.98,Default,,0,0,0,,Chúng tôi luôn tìm\Nđàn ông đích thực để yêu,
Dialogue: 0,0:48:15.06,0:48:17.19,Default,,0,0,0,,và đến để tìm đàn ông đích thực.
Dialogue: 0,0:48:17.27,0:48:18.10,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:48:18.19,0:48:21.40,Default,,0,0,0,,Hiện tại, chúng tôi cảm thấy\Nkhông cần người như cậu.
Dialogue: 0,0:48:22.11,0:48:24.70,Default,,0,0,0,,Cậu cười nhạo quá khứ\Nvà nỗi đau của Maririn à?
Dialogue: 0,0:48:26.07,0:48:29.41,Default,,0,0,0,,Không được đâu. Đồ rác rưởi.
Dialogue: 0,0:48:32.16,0:48:36.21,Default,,0,0,0,,Nếu cậu không thay đổi,\Nkhông ai yêu cậu đâu.
Dialogue: 0,0:48:38.12,0:48:39.79,Default,,0,0,0,,Họ quá đáng vậy luôn?
Dialogue: 0,0:48:41.00,0:48:42.42,Default,,0,0,0,,Chửi thế ổn không vậy?
Dialogue: 0,0:48:42.50,0:48:43.79,Default,,0,0,0,,- Chà.\N- Sợ thế.
Dialogue: 0,0:48:43.88,0:48:46.63,Default,,0,0,0,,Mặt cậu ấy như kiểu bị rơi vào bẫy.
Dialogue: 0,0:48:47.26,0:48:48.60,Default,,0,0,0,,Tai-chan.
Dialogue: 0,0:48:48.68,0:48:50.35,Default,,0,0,0,,Tai-chan sẽ sao đây?
Dialogue: 0,0:48:50.43,0:48:52.64,Default,,0,0,0,,- Đừng thế.\N- Cậu ấy sẽ thế nào?
Dialogue: 0,0:48:52.72,0:48:54.72,Default,,0,0,0,,Cậu ấy nguy to rồi nhỉ?
Dialogue: 0,0:49:03.86,0:49:08.87,Default,,0,0,0,,Biên dịch: Trang Tran
