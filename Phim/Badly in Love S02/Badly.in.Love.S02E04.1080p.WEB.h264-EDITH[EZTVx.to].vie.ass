Dialogue: 0,0:00:06.26,0:00:09.72,Default,,0,0,0,,Tự đi mà nấu, thằng ranh.\NMày bảo không đến để kết bạn mà.
Dialogue: 0,0:00:09.80,0:00:10.97,Default,,0,0,0,,Họ bảo thì làm đi.
Dialogue: 0,0:00:11.05,0:00:12.89,Default,,0,0,0,,Tự đi mà nấu.
Dialogue: 0,0:00:12.97,0:00:14.64,Default,,0,0,0,,Nghe thông báo rồi đó. Làm theo đi.
Dialogue: 0,0:00:15.43,0:00:17.68,Default,,0,0,0,,Mày tự đi mà nấu. Rõ chưa?
Dialogue: 0,0:00:18.39,0:00:19.93,Default,,0,0,0,,Mày nấu.
Dialogue: 0,0:00:21.69,0:00:23.36,Default,,0,0,0,,Bo, nguy hiểm lắm.
Dialogue: 0,0:00:28.32,0:00:30.66,Default,,0,0,0,,Khoan đã nào!
Dialogue: 0,0:00:31.24,0:00:33.03,Default,,0,0,0,,Dừng lại. Bình tĩnh đi.
Dialogue: 0,0:00:33.12,0:00:34.16,Default,,0,0,0,,Thằng ranh!
Dialogue: 0,0:00:35.20,0:00:36.29,Default,,0,0,0,,Sợ quá.
Dialogue: 0,0:00:40.79,0:00:42.33,Default,,0,0,0,,Qua phòng khách đi.
Dialogue: 0,0:00:42.42,0:00:43.34,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:00:44.75,0:00:46.67,Default,,0,0,0,,Đừng quên túi.
Dialogue: 0,0:00:48.17,0:00:49.09,Default,,0,0,0,,Xung đột nảy lửa.
Dialogue: 0,0:00:49.17,0:00:50.34,Default,,0,0,0,,Qua phòng khách đi.
Dialogue: 0,0:00:58.93,0:01:00.22,Default,,0,0,0,,Chính hắn nói mà.
Dialogue: 0,0:01:01.02,0:01:03.61,Default,,0,0,0,,Tôi chẳng việc gì phải nấu. Hắn tự mà nấu.
Dialogue: 0,0:01:03.69,0:01:04.73,Default,,0,0,0,,Bo (27)\NTHỢ SƠN
Dialogue: 0,0:01:04.81,0:01:06.19,Default,,0,0,0,,- Đúng không?\N- Ừ.
Dialogue: 0,0:01:06.69,0:01:08.57,Default,,0,0,0,,Xin lỗi, nhưng tôi cũng không đi.
Dialogue: 0,0:01:08.65,0:01:09.86,Default,,0,0,0,,Đúng không, Leo?
Dialogue: 0,0:01:11.15,0:01:14.07,Default,,0,0,0,,Dù thế nào tôi cũng không nấu.
Dialogue: 0,0:01:15.20,0:01:18.16,Default,,0,0,0,,Đấy nhé. Nấu bữa trưa cho chúng ta thôi.
Dialogue: 0,0:01:21.00,0:01:22.84,Default,,0,0,0,,Tôi không chấp nhận chuyện đó.
Dialogue: 0,0:01:29.55,0:01:30.97,Default,,0,0,0,,Đẹp nhỉ?
Dialogue: 0,0:01:31.05,0:01:32.93,Default,,0,0,0,,Ngồi đâu cũng được hả?
Dialogue: 0,0:01:33.01,0:01:34.01,Default,,0,0,0,,- Ừ.\N- Đâu cũng được.
Dialogue: 0,0:01:34.09,0:01:36.05,Default,,0,0,0,,Muốn ngồi đâu cũng được.
Dialogue: 0,0:01:37.06,0:01:38.19,Default,,0,0,0,,Cậu ổn chứ?
Dialogue: 0,0:01:38.26,0:01:39.09,Default,,0,0,0,,Ừ, tôi ổn.
Dialogue: 0,0:01:39.18,0:01:40.47,Default,,0,0,0,,- Còn dây chuyền?\N- Nó ư?
Dialogue: 0,0:01:40.98,0:01:42.32,Default,,0,0,0,,- Nó bị đứt à?\N- Tôi sửa rồi.
Dialogue: 0,0:01:42.39,0:01:43.35,Default,,0,0,0,,Nó bị tuột thôi.
Dialogue: 0,0:01:43.44,0:01:44.57,Default,,0,0,0,,KAZU-KUN\NCHỦ CLB
Dialogue: 0,0:01:44.65,0:01:45.82,Default,,0,0,0,,May thế. Trông đắt mà.
Dialogue: 0,0:01:45.90,0:01:46.94,Default,,0,0,0,,Ừ.
Dialogue: 0,0:01:47.02,0:01:49.27,Default,,0,0,0,,Kể về quá khứ của anh đi. Sao anh đến đây?
Dialogue: 0,0:01:49.36,0:01:50.28,Default,,0,0,0,,Quá khứ à?
Dialogue: 0,0:01:51.24,0:01:52.53,Default,,0,0,0,,Tôi từng kết hôn.
Dialogue: 0,0:01:52.61,0:01:53.61,Default,,0,0,0,,Hả?
Dialogue: 0,0:01:55.70,0:01:56.58,Default,,0,0,0,,Ha-chan (27)\NHLV
Dialogue: 0,0:01:56.66,0:01:57.49,Default,,0,0,0,,Rất tự nhiên.
Dialogue: 0,0:01:57.58,0:01:58.41,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:01:58.49,0:01:59.78,Default,,0,0,0,,- Nói rất tự nhiên.\N- Ừ.
Dialogue: 0,0:02:00.37,0:02:03.04,Default,,0,0,0,,Anh kết hôn được bao lâu?
Dialogue: 0,0:02:03.12,0:02:04.00,Default,,0,0,0,,Tầm sáu tháng.
Dialogue: 0,0:02:04.08,0:02:04.91,Default,,0,0,0,,- Hả?\N- Ừ.
Dialogue: 0,0:02:05.00,0:02:05.84,Default,,0,0,0,,- Có con?\N- Ngắn!
Dialogue: 0,0:02:05.92,0:02:08.76,Default,,0,0,0,,Ồ, vậy là không có con. Ra vậy.
Dialogue: 0,0:02:09.59,0:02:11.01,Default,,0,0,0,,Chắc tại chúng tôi kiệt quệ.
Dialogue: 0,0:02:11.09,0:02:12.68,Default,,0,0,0,,Anh kết hôn khi nào vậy?
Dialogue: 0,0:02:12.76,0:02:14.76,Default,,0,0,0,,Ồ, hè năm ngoái.
Dialogue: 0,0:02:14.84,0:02:16.22,Default,,0,0,0,,Ừ, tôi cũng nghĩ vậy.
Dialogue: 0,0:02:16.30,0:02:17.30,Default,,0,0,0,,Mới đây đấy chứ.
Dialogue: 0,0:02:17.39,0:02:19.27,Default,,0,0,0,,- Rất mới.\N- Phải.
Dialogue: 0,0:02:19.35,0:02:20.18,Default,,0,0,0,,Gu của anh là gì?
Dialogue: 0,0:02:20.27,0:02:21.69,Default,,0,0,0,,Ruru tấn công rồi.
Dialogue: 0,0:02:21.77,0:02:26.65,Default,,0,0,0,,Tôi thích những cô gái có duyên.\NChỉ xinh đẹp thôi không thu hút tôi nữa.
Dialogue: 0,0:02:26.73,0:02:27.57,Default,,0,0,0,,Ồ, phải.
Dialogue: 0,0:02:27.65,0:02:28.48,Default,,0,0,0,,Đâu cũng có mà.
Dialogue: 0,0:02:28.57,0:02:29.40,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:02:29.48,0:02:32.53,Default,,0,0,0,,Tôi muốn có thể vui vẻ bên cô ấy,\Ndù ở quán nhậu bình dân.
Dialogue: 0,0:02:33.07,0:02:33.99,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:02:34.07,0:02:37.74,Default,,0,0,0,,Nếu cô ấy là kiểu:\N"Tôi chỉ ăn nhà hàng sang chảnh",
Dialogue: 0,0:02:37.82,0:02:40.45,Default,,0,0,0,,tôi sẽ phải gồng\Nđể làm cô ấy vui, mệt lắm.
Dialogue: 0,0:02:40.54,0:02:41.92,Default,,0,0,0,,Nhìn ánh mắt Ruru kìa.
Dialogue: 0,0:02:42.00,0:02:43.42,Default,,0,0,0,,Nhóm máu của anh là gì?
Dialogue: 0,0:02:43.50,0:02:44.92,Default,,0,0,0,,- O.\N- Gì cơ?
Dialogue: 0,0:02:45.00,0:02:45.83,Default,,0,0,0,,Chà.
Dialogue: 0,0:02:45.92,0:02:47.42,Default,,0,0,0,,Tôi cũng O nè.
Dialogue: 0,0:02:47.50,0:02:49.00,Default,,0,0,0,,Tôi cũng O đó.
Dialogue: 0,0:02:49.09,0:02:52.26,Default,,0,0,0,,Ruru mê cậu ấy rồi nhỉ?
Dialogue: 0,0:02:55.68,0:02:58.10,Default,,0,0,0,,LEO (25)\NCHỦ BAR
Dialogue: 0,0:02:58.18,0:03:00.98,Default,,0,0,0,,ARI (29)\NRAPPER/NGƯỜI MẪU
Dialogue: 0,0:03:01.06,0:03:03.02,Default,,0,0,0,,Hắn kêu: "Nấu đi". Không ai nhờ kiểu đó.
Dialogue: 0,0:03:03.10,0:03:04.06,Default,,0,0,0,,Hắn kêu: "Nấu đi" á?
Dialogue: 0,0:03:04.14,0:03:05.22,Default,,0,0,0,,Ừ.
Dialogue: 0,0:03:05.31,0:03:07.40,Default,,0,0,0,,"Nghe lời và đi nấu đi".
Dialogue: 0,0:03:08.19,0:03:11.28,Default,,0,0,0,,Phải là: "Nấu cho tôi với".\NThế mới là nhờ chứ.
Dialogue: 0,0:03:13.23,0:03:15.07,Default,,0,0,0,,Đừng hòng nhảy cóc, thằng ranh.
Dialogue: 0,0:03:16.28,0:03:17.45,Default,,0,0,0,,Trong lúc vo gạo.
Dialogue: 0,0:03:17.53,0:03:18.57,Default,,0,0,0,,NAGANO
Dialogue: 0,0:03:20.12,0:03:21.20,Default,,0,0,0,,Để tôi giúp.
Dialogue: 0,0:03:21.28,0:03:24.07,Default,,0,0,0,,Thôi khỏi. Không phải làm đâu.
Dialogue: 0,0:03:25.41,0:03:26.83,Default,,0,0,0,,- Cứ để chúng tôi làm.\N- Ừ.
Dialogue: 0,0:03:26.92,0:03:28.67,Default,,0,0,0,,Không nên gây rắc rối cho mọi người.
Dialogue: 0,0:03:28.75,0:03:29.58,Default,,0,0,0,,Tôi thấy có lỗi.
Dialogue: 0,0:03:29.67,0:03:30.92,Default,,0,0,0,,Tôi cũng giúp.
Dialogue: 0,0:03:31.00,0:03:34.38,Default,,0,0,0,,Ari, Bo, không sao đâu.\NĐừng nghĩ là đang nấu cho hắn.
Dialogue: 0,0:03:34.46,0:03:35.46,Default,,0,0,0,,Leo người lớn ghê.
Dialogue: 0,0:03:35.55,0:03:37.72,Default,,0,0,0,,Nhưng làm phiền cậu cũng không đúng.
Dialogue: 0,0:03:37.80,0:03:38.76,Default,,0,0,0,,Không sao đâu.
Dialogue: 0,0:03:38.84,0:03:39.72,Default,,0,0,0,,Tôi sẽ giúp.
Dialogue: 0,0:03:40.22,0:03:42.47,Default,,0,0,0,,MA-KUN (28)\NVÕ SĨ MMA
Dialogue: 0,0:03:42.56,0:03:44.02,Default,,0,0,0,,Tôi chẳng muốn làm.
Dialogue: 0,0:03:44.97,0:03:49.27,Default,,0,0,0,,Nếu anh ta tới cảm ơn chúng ta,\Ntôi sẽ tha thứ một chút.
Dialogue: 0,0:03:49.35,0:03:50.35,Default,,0,0,0,,- Không.\N- Còn lâu.
Dialogue: 0,0:03:50.44,0:03:51.57,Default,,0,0,0,,Cư xử thế thì còn lâu.
Dialogue: 0,0:03:51.65,0:03:53.32,Default,,0,0,0,,- Hả?\N- Hắn còn lâu mới cảm ơn.
Dialogue: 0,0:03:53.40,0:03:54.94,Default,,0,0,0,,Quyết định như vậy đi.
Dialogue: 0,0:03:55.03,0:03:56.78,Default,,0,0,0,,Nếu hắn cảm ơn thì thôi.
Dialogue: 0,0:03:56.86,0:03:59.82,Default,,0,0,0,,Nhưng nếu hắn bảo không ăn,\Nthì tôi sẽ cho hắn một trận.
Dialogue: 0,0:04:01.45,0:04:04.58,Default,,0,0,0,,Bo làm gì cũng rất hiệu quả.
Dialogue: 0,0:04:04.66,0:04:05.70,Default,,0,0,0,,- Nhỉ?\N- Phải đó.
Dialogue: 0,0:04:05.79,0:04:06.96,Default,,0,0,0,,Cậu ấy làm suốt rồi.
Dialogue: 0,0:04:07.04,0:04:09.54,Default,,0,0,0,,- Ừ, cậu ấy luyện nhiều rồi.\N- Hồi đi tù.
Dialogue: 0,0:04:11.50,0:04:13.92,Default,,0,0,0,,- Anh ấy mang "hàng".\N- Bo, anh chuyển "hàng" hả?
Dialogue: 0,0:04:14.00,0:04:16.25,Default,,0,0,0,,Tôi bảo không làm gì là nói dối.\NTôi vo gạo đó.
Dialogue: 0,0:04:16.34,0:04:18.18,Default,,0,0,0,,Ôi, cảm ơn anh.
Dialogue: 0,0:04:19.63,0:04:20.59,Default,,0,0,0,,Giờ sao?
Dialogue: 0,0:04:20.68,0:04:22.39,Default,,0,0,0,,- Bò hầm?\N- Bò hầm.
Dialogue: 0,0:04:23.10,0:04:24.52,Default,,0,0,0,,- Anh nấu à?\N- Thèm quá.
Dialogue: 0,0:04:24.60,0:04:26.39,Default,,0,0,0,,Tôi cũng muốn làm.
Dialogue: 0,0:04:26.47,0:04:27.64,Default,,0,0,0,,Không phải bò hầm.
Dialogue: 0,0:04:27.73,0:04:28.86,Default,,0,0,0,,Taisei nấu đó.
Dialogue: 0,0:04:28.94,0:04:30.11,Default,,0,0,0,,Chà.
Dialogue: 0,0:04:30.19,0:04:31.44,Default,,0,0,0,,Chuyện gì sẽ xảy ra đây?
Dialogue: 0,0:04:31.52,0:04:32.65,Default,,0,0,0,,Giờ sao đây?
Dialogue: 0,0:04:32.73,0:04:33.65,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:35.32,0:04:36.78,Default,,0,0,0,,Cậu ấy tức kìa.
Dialogue: 0,0:04:36.86,0:04:37.86,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:04:37.94,0:04:38.82,Default,,0,0,0,,- Ăn thôi.\N- Ừ.
Dialogue: 0,0:04:38.90,0:04:39.73,Default,,0,0,0,,- Ừ.\N- Được rồi.
Dialogue: 0,0:04:39.82,0:04:40.82,Default,,0,0,0,,Cảm ơn Ma-kun.
Dialogue: 0,0:04:46.12,0:04:47.20,Default,,0,0,0,,- Cả lũ nấu.\N- Cảm ơn.
Dialogue: 0,0:04:47.29,0:04:48.12,Default,,0,0,0,,Rồi, ăn thôi.
Dialogue: 0,0:04:48.20,0:04:49.16,Default,,0,0,0,,- Ăn nào.\N- Ừ.
Dialogue: 0,0:04:49.25,0:04:50.67,Default,,0,0,0,,Ăn nào.
Dialogue: 0,0:04:50.75,0:04:51.63,Default,,0,0,0,,TAI-CHAN\NTẠO MẪU
Dialogue: 0,0:04:51.71,0:04:53.00,Default,,0,0,0,,- Chuyện gì vậy?\N- Hả?
Dialogue: 0,0:04:53.08,0:04:53.96,Default,,0,0,0,,Ngon quá.
Dialogue: 0,0:04:54.04,0:04:55.83,Default,,0,0,0,,Thấy không?
Dialogue: 0,0:04:57.38,0:04:58.92,Default,,0,0,0,,Cảm ơn nhé, Taisei.
Dialogue: 0,0:04:59.01,0:05:01.05,Default,,0,0,0,,Không có gì. Anh thích không?
Dialogue: 0,0:05:01.59,0:05:03.13,Default,,0,0,0,,"Anh thích không?"
Dialogue: 0,0:05:03.22,0:05:05.14,Default,,0,0,0,,Cậu nói như Tamori.
Dialogue: 0,0:05:05.22,0:05:06.51,Default,,0,0,0,,- Cậu ấy cười rồi.\N- Ừ!
Dialogue: 0,0:05:06.60,0:05:07.48,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:05:08.22,0:05:09.31,Default,,0,0,0,,Gì vậy trời?
Dialogue: 0,0:05:09.39,0:05:11.23,Default,,0,0,0,,Đừng nghĩ, cảm nhận thôi.
Dialogue: 0,0:05:11.31,0:05:12.44,Default,,0,0,0,,Cứ như cá vàng vậy.
Dialogue: 0,0:05:12.52,0:05:13.69,Default,,0,0,0,,- Đâu.\N- Bơi tí là quên.
Dialogue: 0,0:05:13.77,0:05:14.81,Default,,0,0,0,,Họ là người mà.
Dialogue: 0,0:05:14.90,0:05:17.24,Default,,0,0,0,,Đó là tư duy đáng yêu của trẻ trâu.
Dialogue: 0,0:05:30.25,0:05:32.34,Default,,0,0,0,,CHƯƠNG TRÌNH THỰC TẾ TRẺ TRÂU HẸN HÒ
Dialogue: 0,0:05:33.25,0:05:35.34,Default,,0,0,0,,RAPPER TỪ SAGAMIHARA\NBẮN RAP TÌNH TỨ
Dialogue: 0,0:05:35.42,0:05:37.01,Default,,0,0,0,,ARI
Dialogue: 0,0:05:37.09,0:05:39.05,Default,,0,0,0,,TIẾP VIÊN KAWASAKI\NTÌM ĐÀN ÔNG CHÂN CHÍNH
Dialogue: 0,0:05:39.13,0:05:40.21,Default,,0,0,0,,HIKARU
Dialogue: 0,0:05:40.30,0:05:41.97,Default,,0,0,0,,CHỦ BAR KYOTO\NTẤT TAY VÌ BẠN GÁI
Dialogue: 0,0:05:43.26,0:05:44.89,Default,,0,0,0,,NGƯỜI ĐẸP NANIWA\NĐI TÌM TÌNH YÊU
Dialogue: 0,0:05:44.97,0:05:46.06,Default,,0,0,0,,MARIRIN
Dialogue: 0,0:05:46.14,0:05:47.52,Default,,0,0,0,,TRẺ TRÂU\NLỚN NHỜ CƠM TÙ
Dialogue: 0,0:05:47.60,0:05:48.73,Default,,0,0,0,,BO
Dialogue: 0,0:05:50.73,0:05:52.61,Default,,0,0,0,,VÕ SĨ MMA CỰU XÃ HỘI ĐEN\NTÌM KIẾM TRI KỶ
Dialogue: 0,0:05:52.69,0:05:54.07,Default,,0,0,0,,MA-KUN
Dialogue: 0,0:05:54.15,0:05:55.94,Default,,0,0,0,,TIẾP VIÊN NAGOYA\NCHỈNH ĐỐN ĐÀN ÔNG
Dialogue: 0,0:05:56.02,0:05:57.02,Default,,0,0,0,,ASSUN
Dialogue: 0,0:05:57.11,0:05:58.49,Default,,0,0,0,,NHÀ TẠO MẪU\NYÊU CUỒNG SI
Dialogue: 0,0:05:58.57,0:05:59.95,Default,,0,0,0,,TAI-CHAN
Dialogue: 0,0:06:00.03,0:06:01.24,Default,,0,0,0,,NGƯỜI MẪU\NTÌM TÌNH YÊU
Dialogue: 0,0:06:01.32,0:06:02.40,Default,,0,0,0,,RURU
Dialogue: 0,0:06:06.32,0:06:09.07,Default,,0,0,0,,CHIẾN ĐẤU ĐI SỢ CHI\NYÊU ĐI NGẠI CHI
Dialogue: 0,0:06:09.16,0:06:10.29,Default,,0,0,0,,VÕ SĨ KICKBOX\NTỪ MIYAGI
Dialogue: 0,0:06:10.37,0:06:11.54,Default,,0,0,0,,HA-CHAN
Dialogue: 0,0:06:11.62,0:06:12.79,Default,,0,0,0,,CỰU TIẾP VIÊN SỐ 1
Dialogue: 0,0:06:12.87,0:06:13.87,Default,,0,0,0,,KAZU-KUN
Dialogue: 0,0:06:30.56,0:06:32.48,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN
Dialogue: 0,0:06:37.56,0:06:42.15,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN 2
Dialogue: 0,0:06:42.65,0:06:43.48,Default,,0,0,0,,- Kìa.\N- Chuông.
Dialogue: 0,0:06:43.57,0:06:45.61,Default,,0,0,0,,- Biết là gì rồi đó!\N- Tôi nói đúng nhỉ?
Dialogue: 0,0:06:45.70,0:06:47.62,Default,,0,0,0,,- Đúng!\N- Thật là tuyệt.
Dialogue: 0,0:06:47.70,0:06:48.99,Default,,0,0,0,,Như tôi đã nói, nhỉ?
Dialogue: 0,0:06:49.08,0:06:51.67,Default,,0,0,0,,- Đã đến giờ xông hơi.\N- Đấy, bảo mà.
Dialogue: 0,0:06:51.74,0:06:52.87,Default,,0,0,0,,Không phải Ari.
Dialogue: 0,0:06:52.95,0:06:55.24,Default,,0,0,0,,Người được đi hôm nay là…
Dialogue: 0,0:06:55.33,0:06:56.33,Default,,0,0,0,,Hikaru nhỉ?
Dialogue: 0,0:06:56.92,0:06:59.71,Default,,0,0,0,,…học sinh chuyển trường, Kazu-kun.
Dialogue: 0,0:06:59.79,0:07:01.04,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:07:02.09,0:07:02.92,Default,,0,0,0,,Bây giờ à?
Dialogue: 0,0:07:03.01,0:07:04.18,Default,,0,0,0,,Ừ, bây giờ.
Dialogue: 0,0:07:06.55,0:07:07.51,Default,,0,0,0,,Vậy thì…
Dialogue: 0,0:07:08.30,0:07:09.47,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:07:09.55,0:07:10.55,Default,,0,0,0,,Nhìn cô ấy kìa.
Dialogue: 0,0:07:10.64,0:07:11.68,Default,,0,0,0,,- Đi thôi.\N- Đi thôi.
Dialogue: 0,0:07:14.14,0:07:16.85,Default,,0,0,0,,Phải. Cậu ấy chỉ để ý cô ấy mà.
Dialogue: 0,0:07:21.48,0:07:22.90,Default,,0,0,0,,Chà chà.
Dialogue: 0,0:07:22.98,0:07:25.52,Default,,0,0,0,,Không mặc áo choàng tắm luôn.
Dialogue: 0,0:07:30.49,0:07:33.20,Default,,0,0,0,,Anh đến kỳ rồi à?
Dialogue: 0,0:07:33.29,0:07:35.17,Default,,0,0,0,,Đâu, vào thôi.
Dialogue: 0,0:07:38.25,0:07:39.21,Default,,0,0,0,,Trong này nóng ghê.
Dialogue: 0,0:07:40.13,0:07:42.55,Default,,0,0,0,,Hai người này có gì đó…
Dialogue: 0,0:07:47.01,0:07:48.05,Default,,0,0,0,,Thích ghê.
Dialogue: 0,0:07:48.13,0:07:54.14,Default,,0,0,0,,Tình hình hiện tại thế nào?
Dialogue: 0,0:07:54.22,0:07:56.56,Default,,0,0,0,,Assun đang để ý đến Ma-kun.
Dialogue: 0,0:07:56.64,0:07:57.64,Default,,0,0,0,,Có vẻ là vậy.
Dialogue: 0,0:07:57.73,0:08:02.23,Default,,0,0,0,,Ừ, đó là lựa chọn của cô ấy,\Nvà ban đầu tôi có hứng thú với Leo.
Dialogue: 0,0:08:02.32,0:08:03.15,Default,,0,0,0,,Giờ không còn?
Dialogue: 0,0:08:03.23,0:08:07.49,Default,,0,0,0,,Không hẳn, nhưng tôi không biết\Ncậu ấy đang nghĩ gì.
Dialogue: 0,0:08:07.57,0:08:10.20,Default,,0,0,0,,Chúng tôi nói chuyện\Ncũng nhiều, nhưng kiểu…
Dialogue: 0,0:08:10.28,0:08:11.16,Default,,0,0,0,,Chẳng có gì?
Dialogue: 0,0:08:11.24,0:08:12.49,Default,,0,0,0,,Ừ, chẳng có gì.
Dialogue: 0,0:08:13.49,0:08:15.58,Default,,0,0,0,,Không biết cậu ấy cảm thấy gì về tôi.
Dialogue: 0,0:08:15.66,0:08:17.12,Default,,0,0,0,,Cô không chủ động gì à?
Dialogue: 0,0:08:17.21,0:08:19.50,Default,,0,0,0,,Nếu thích thì chắc chắn là có.
Dialogue: 0,0:08:19.58,0:08:23.75,Default,,0,0,0,,Về cơ bản, có mỗi cậu ấy\Nlà chọn được trong nhóm nam.
Dialogue: 0,0:08:23.84,0:08:27.84,Default,,0,0,0,,Tôi chưa chạm đến ngưỡng\Nmà tôi cảm thấy mình có hứng thú.
Dialogue: 0,0:08:27.92,0:08:29.00,Default,,0,0,0,,Hiện tại là vậy.
Dialogue: 0,0:08:29.09,0:08:30.51,Default,,0,0,0,,Cô vẫn chưa thấy thế?
Dialogue: 0,0:08:30.59,0:08:34.18,Default,,0,0,0,,Ừ, và cậu ấy chẳng chủ động làm gì cả.
Dialogue: 0,0:08:34.85,0:08:36.56,Default,,0,0,0,,Tình hình hiện tại là như vậy đó.
Dialogue: 0,0:08:36.64,0:08:37.93,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:08:43.61,0:08:44.49,Default,,0,0,0,,Nhìn hút kìa.
Dialogue: 0,0:08:44.57,0:08:46.11,Default,,0,0,0,,Trong khi đó, Leo đây…
Dialogue: 0,0:08:47.32,0:08:48.99,Default,,0,0,0,,Cậu thấy thế nào?
Dialogue: 0,0:08:50.53,0:08:51.53,Default,,0,0,0,,Tôi không vui lắm.
Dialogue: 0,0:08:51.61,0:08:52.69,Default,,0,0,0,,Ừ, cũng đúng.
Dialogue: 0,0:08:52.78,0:08:54.24,Default,,0,0,0,,- Ừ.\N- Phải.
Dialogue: 0,0:08:55.74,0:09:02.41,Default,,0,0,0,,Mọi người nghĩ tôi là người lăng nhăng.
Dialogue: 0,0:09:02.50,0:09:04.42,Default,,0,0,0,,Thật ra tôi cũng hơi nghĩ thế.
Dialogue: 0,0:09:05.13,0:09:07.34,Default,,0,0,0,,Hơn nữa, tôi uống với anh rồi.
Dialogue: 0,0:09:07.42,0:09:08.26,Default,,0,0,0,,- Tôi biết.\N- Ừ.
Dialogue: 0,0:09:08.34,0:09:10.63,Default,,0,0,0,,- Anh nhớ à?\N- Nhưng không nhớ ở đâu.
Dialogue: 0,0:09:10.72,0:09:13.27,Default,,0,0,0,,- Chắc ta có cùng vòng tròn bạn bè.\N- Đúng.
Dialogue: 0,0:09:13.76,0:09:15.39,Default,,0,0,0,,Biết ngay mà.
Dialogue: 0,0:09:15.47,0:09:17.43,Default,,0,0,0,,- Họ từng gặp nhau.\N- Đoán đúng à.
Dialogue: 0,0:09:17.52,0:09:19.31,Default,,0,0,0,,Nhìn ánh mắt là biết cô ấy quen.
Dialogue: 0,0:09:19.39,0:09:20.89,Default,,0,0,0,,- Em nói thế thật.\N- Phải.
Dialogue: 0,0:09:20.98,0:09:26.61,Default,,0,0,0,,Lúc anh bước vào, tôi sốc lắm.\NKhông ngờ họ lại chọn anh.
Dialogue: 0,0:09:26.69,0:09:29.48,Default,,0,0,0,,Tôi biết anh từ hồi\Nmặt anh trên biển quảng cáo kìa.
Dialogue: 0,0:09:29.57,0:09:33.57,Default,,0,0,0,,Tôi bảo với bạn bè rằng\Ncó tiếp viên này nóng bỏng lắm.
Dialogue: 0,0:09:34.49,0:09:36.16,Default,,0,0,0,,Em là bà bói à?
Dialogue: 0,0:09:36.91,0:09:37.74,Default,,0,0,0,,Em cứ đoán đúng.
Dialogue: 0,0:09:37.83,0:09:38.75,Default,,0,0,0,,Em ăn gian à?
Dialogue: 0,0:09:38.83,0:09:40.37,Default,,0,0,0,,- Em xem rồi chứ gì?\N- Đâu!
Dialogue: 0,0:09:40.45,0:09:44.75,Default,,0,0,0,,Em có năng khiếu làm thám tử.
Dialogue: 0,0:09:44.83,0:09:47.08,Default,,0,0,0,,- Nói chuyện sợ quá.\N- Lại nữa.
Dialogue: 0,0:09:47.17,0:09:48.59,Default,,0,0,0,,Em có năng khiếu làm thám tử?
Dialogue: 0,0:09:48.67,0:09:50.76,Default,,0,0,0,,- Em phát hiện nói dối…\N- Ừ, em biết ngay.
Dialogue: 0,0:09:50.84,0:09:52.93,Default,,0,0,0,,Em đoán được suy nghĩ người khác không?
Dialogue: 0,0:09:53.01,0:09:54.97,Default,,0,0,0,,Đặc biệt là chuyện hẹn hò.
Dialogue: 0,0:09:55.05,0:09:56.39,Default,,0,0,0,,- Chà.\N- Khỉ thật.
Dialogue: 0,0:09:56.47,0:09:57.72,Default,,0,0,0,,- Mừng là có em.\N- Phải.
Dialogue: 0,0:09:57.81,0:09:59.65,Default,,0,0,0,,Anh mãi chẳng hiểu Ruru nghĩ gì.
Dialogue: 0,0:09:59.72,0:10:00.97,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:10:01.06,0:10:05.40,Default,,0,0,0,,Anh bắt đầu nghi ngờ\Nviệc cô ấy có thích Leo thật không.
Dialogue: 0,0:10:05.48,0:10:08.44,Default,,0,0,0,,Phải, vì cô ấy bảo\Ncô ấy vẫn chưa đến ngưỡng đó.
Dialogue: 0,0:10:08.52,0:10:09.35,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:10:09.44,0:10:13.15,Default,,0,0,0,,Có chuyện đó à? Anh nghĩ là không phải.
Dialogue: 0,0:10:13.24,0:10:16.24,Default,,0,0,0,,- Cô ấy chưa chạm đến đó.\N- Phức tạp vậy à?
Dialogue: 0,0:10:16.32,0:10:17.15,Default,,0,0,0,,Cảm giác thật…
Dialogue: 0,0:10:17.24,0:10:21.29,Default,,0,0,0,,Cảm giác thân mật lạ thường.\NCứ như đang xem phim người lớn.
Dialogue: 0,0:10:21.37,0:10:23.16,Default,,0,0,0,,- Hiểu mà.\N- Đâu phải kiểu người lớn.
Dialogue: 0,0:10:23.25,0:10:27.67,Default,,0,0,0,,Chuyện này vui. Một bạn cùng trường\Ncủa anh xem Tình yêu nổi loạn Mùa 1.
Dialogue: 0,0:10:27.75,0:10:30.88,Default,,0,0,0,,Cậu ấy cứ lậm mấy cảnh nóng mãi,
Dialogue: 0,0:10:30.96,0:10:33.42,Default,,0,0,0,,cố phóng to trên Netflix\Nbao lần mà không được.
Dialogue: 0,0:10:34.51,0:10:36.76,Default,,0,0,0,,- Cậu ấy bực lắm.\N- Mừng là anh ấy thích.
Dialogue: 0,0:10:36.84,0:10:37.67,Default,,0,0,0,,Anh ấy lậm hả?
Dialogue: 0,0:10:37.76,0:10:39.26,Default,,0,0,0,,Thử đi thử lại…
Dialogue: 0,0:10:39.35,0:10:40.18,Default,,0,0,0,,Để phóng to.
Dialogue: 0,0:10:40.26,0:10:41.60,Default,,0,0,0,,Trên điện thoại.
Dialogue: 0,0:10:41.68,0:10:42.89,Default,,0,0,0,,Để xem cơ thể họ.
Dialogue: 0,0:10:42.98,0:10:45.86,Default,,0,0,0,,Đâu có được.\NTrên Netflix có phóng to được đâu.
Dialogue: 0,0:10:45.94,0:10:47.61,Default,,0,0,0,,Có fan mê lắm, trong đám bạn anh.
Dialogue: 0,0:10:47.69,0:10:49.82,Default,,0,0,0,,- Fan xông hơi?\N- Phải.
Dialogue: 0,0:10:49.90,0:10:52.11,Default,,0,0,0,,Anh ấy đẹp trai nhỉ?
Dialogue: 0,0:10:53.07,0:10:54.15,Default,,0,0,0,,Tôi cũng thấy thế.
Dialogue: 0,0:10:54.24,0:10:55.66,Default,,0,0,0,,Anh ấy rất xinh trai.
Dialogue: 0,0:10:55.74,0:10:57.45,Default,,0,0,0,,Ai chẳng thấy cậu ấy nóng bỏng.
Dialogue: 0,0:10:57.53,0:10:58.74,Default,,0,0,0,,ASSUN\NDOANH NHÂN/TIẾP VIÊN
Dialogue: 0,0:10:58.82,0:11:00.91,Default,,0,0,0,,Giá mà anh ấy chọn tôi đi xông hơi.
Dialogue: 0,0:11:00.99,0:11:01.82,Default,,0,0,0,,Thế à?
Dialogue: 0,0:11:01.91,0:11:02.79,Default,,0,0,0,,Tôi muốn đi.
Dialogue: 0,0:11:02.87,0:11:04.50,Default,,0,0,0,,- Hả?\N- Hà?
Dialogue: 0,0:11:04.58,0:11:05.41,Default,,0,0,0,,Thật thà ghê.
Dialogue: 0,0:11:05.50,0:11:06.33,Default,,0,0,0,,HIKARU\NTIẾP VIÊN
Dialogue: 0,0:11:07.46,0:11:10.63,Default,,0,0,0,,Tôi tò mò muốn xem anh sẽ hẹn hò thế nào,
Dialogue: 0,0:11:10.71,0:11:12.71,Default,,0,0,0,,và kết cục ra làm sao.
Dialogue: 0,0:11:12.80,0:11:17.39,Default,,0,0,0,,Ý tôi là ở trong trường này.\NTôi không hình dung nổi.
Dialogue: 0,0:11:17.47,0:11:21.14,Default,,0,0,0,,Được ăn cả, ngã về không thôi.\NTôi không quan tâm đến ai thì đúng là vậy.
Dialogue: 0,0:11:21.22,0:11:22.89,Default,,0,0,0,,- Ra vậy.\N- Ừ.
Dialogue: 0,0:11:22.97,0:11:25.18,Default,,0,0,0,,Nhưng thế thì tốt hơn.
Dialogue: 0,0:11:25.68,0:11:27.93,Default,,0,0,0,,- Nhỉ?\N- Đúng là tốt hơn.
Dialogue: 0,0:11:30.40,0:11:31.53,Default,,0,0,0,,- Cô ấy về rồi.\N- Ừ.
Dialogue: 0,0:11:31.61,0:11:32.82,Default,,0,0,0,,- Chào mừng.\N- Ừ.
Dialogue: 0,0:11:32.90,0:11:33.73,Default,,0,0,0,,Tôi về rồi.
Dialogue: 0,0:11:33.82,0:11:35.74,Default,,0,0,0,,- Rạng rỡ thế.\N- Cười tươi kìa.
Dialogue: 0,0:11:35.82,0:11:36.78,Default,,0,0,0,,- Toe toét.\N- Sao?
Dialogue: 0,0:11:36.86,0:11:40.32,Default,,0,0,0,,Tôi nghĩ quan điểm của tôi\Nvề xông hơi thay đổi rồi. Vui thật.
Dialogue: 0,0:11:42.12,0:11:45.54,Default,,0,0,0,,Hôm đi với Ma-kun,\Nbuổi xông hơi gượng gạo dã man.
Dialogue: 0,0:11:45.62,0:11:47.62,Default,,0,0,0,,Nhưng lần này thì không gượng gạo.
Dialogue: 0,0:11:47.71,0:11:52.55,Default,,0,0,0,,Tôi quen anh ấy trước rồi,\Nvà tôi khen anh ấy nóng bỏng.
Dialogue: 0,0:11:53.46,0:11:59.05,Default,,0,0,0,,Anh ấy đúng là gu tôi, nên tôi bảo:\N"Ừ, tôi thấy anh nóng bỏng".
Dialogue: 0,0:12:06.27,0:12:08.52,Default,,0,0,0,,Còn bên phòng các chàng trai thì sao?
Dialogue: 0,0:12:10.69,0:12:12.23,Default,,0,0,0,,Đừng có hoảng.
Dialogue: 0,0:12:12.31,0:12:14.19,Default,,0,0,0,,Xin phép.
Dialogue: 0,0:12:16.94,0:12:18.86,Default,,0,0,0,,Ta nói chuyện được không?
Dialogue: 0,0:12:23.83,0:12:28.50,Default,,0,0,0,,Mọi chuyện xảy ra bởi vì tôi bảo\Ntôi không tới để kết bạn.
Dialogue: 0,0:12:28.58,0:12:32.67,Default,,0,0,0,,Nhưng ta không thể tập trung hẹn hò\Nnếu cứ gượng gạo thế này.
Dialogue: 0,0:12:32.75,0:12:34.92,Default,,0,0,0,,Nên để tôi giải thích vì sao tôi nói thế.
Dialogue: 0,0:12:35.00,0:12:37.38,Default,,0,0,0,,Tôi đến để tìm tình yêu, nên nếu kết bạn…
Dialogue: 0,0:12:37.47,0:12:43.73,Default,,0,0,0,,thì tôi có thói quen xấu là nhường anh em\Nnếu chúng ta thích cùng một cô gái.
Dialogue: 0,0:12:43.80,0:12:47.76,Default,,0,0,0,,Thế nên tôi không muốn thân thiện.\NĐể tránh việc đó. Nên tôi mới nói vậy.
Dialogue: 0,0:12:47.85,0:12:53.27,Default,,0,0,0,,Ít nhất thì tôi muốn chúng ta\Ncó quan hệ tốt với nhau. Các cậu nghĩ sao?
Dialogue: 0,0:12:53.36,0:12:54.57,Default,,0,0,0,,- Được.\N- Ừ.
Dialogue: 0,0:12:55.32,0:12:56.95,Default,,0,0,0,,Miễn là anh hiểu.
Dialogue: 0,0:12:57.03,0:12:58.53,Default,,0,0,0,,Xin lỗi vụ dây chuyền.
Dialogue: 0,0:12:58.61,0:12:59.61,Default,,0,0,0,,Tôi cũng xin lỗi.
Dialogue: 0,0:13:00.45,0:13:01.45,Default,,0,0,0,,Anh thích cà ri chứ?
Dialogue: 0,0:13:01.53,0:13:04.07,Default,,0,0,0,,Ngon lắm, nhưng tôi\Nphấn khích quá nên không đói.
Dialogue: 0,0:13:04.16,0:13:06.54,Default,,0,0,0,,Nhỉ? Anh đoán đúng! Anh bảo thế mà!
Dialogue: 0,0:13:06.62,0:13:07.45,Default,,0,0,0,,Vô vị nhỉ?
Dialogue: 0,0:13:07.54,0:13:09.29,Default,,0,0,0,,Chúng tôi bảo anh không ăn nổi.
Dialogue: 0,0:13:09.37,0:13:11.66,Default,,0,0,0,,Kiểu sao không nuốt trôi nhỉ?
Dialogue: 0,0:13:11.75,0:13:14.88,Default,,0,0,0,,Bo cũng cười rồi. Em nhẹ lòng quá.
Dialogue: 0,0:13:16.05,0:13:17.18,Default,,0,0,0,,Họ thật đáng yêu.
Dialogue: 0,0:13:17.25,0:13:19.96,Default,,0,0,0,,Ôi, thôi nào. Mình anh vẫn thấy bực.
Dialogue: 0,0:13:20.05,0:13:22.22,Default,,0,0,0,,- Em cũng bực mà.\N- Nhỉ?
Dialogue: 0,0:13:22.30,0:13:23.13,Default,,0,0,0,,- Vâng.\N- Vẫn bực?
Dialogue: 0,0:13:23.22,0:13:26.81,Default,,0,0,0,,Anh vẫn bực trước thái độ của Kazu-kun.\NSao họ quên được vậy?
Dialogue: 0,0:13:26.89,0:13:29.64,Default,,0,0,0,,Anh thấy bực vì bị chạm vào tự ái.
Dialogue: 0,0:13:29.73,0:13:32.69,Default,,0,0,0,,Nhưng cậu ấy cảm ơn Ma-kun\Nvì món cà ri rồi. Chưa đủ à?
Dialogue: 0,0:13:32.77,0:13:34.27,Default,,0,0,0,,Chuyện gì cũng thoát được hả?
Dialogue: 0,0:13:34.36,0:13:37.03,Default,,0,0,0,,Phải học cách bỏ qua chuyện nhỏ nhặt.
Dialogue: 0,0:13:37.69,0:13:38.53,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:13:38.61,0:13:41.61,Default,,0,0,0,,Nagano, anh đã đồng hành từ Mùa 1 rồi.
Dialogue: 0,0:13:41.70,0:13:43.70,Default,,0,0,0,,Đừng quay về điểm xuất phát chứ.
Dialogue: 0,0:13:43.78,0:13:47.95,Default,,0,0,0,,Anh muốn lắm, nhưng chắc chắn\Nnhiều người xem đồng tình với anh.
Dialogue: 0,0:13:48.04,0:13:50.96,Default,,0,0,0,,Kiểu một ông già bị kích động\Nngồi xem Tình yêu nổi loạn.
Dialogue: 0,0:13:51.04,0:13:51.87,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:13:51.96,0:13:53.00,Default,,0,0,0,,QUÁN ĂN TÌNH YÊU
Dialogue: 0,0:13:53.08,0:13:54.37,Default,,0,0,0,,Còn bát phải rửa không?
Dialogue: 0,0:13:54.46,0:13:56.13,Default,,0,0,0,,Tai-chan mang vào rồi.
Dialogue: 0,0:13:56.21,0:13:58.38,Default,,0,0,0,,Để tôi làm cho.
Dialogue: 0,0:13:58.46,0:13:59.50,Default,,0,0,0,,MARIRIN\NPHỤC VỤ BAR
Dialogue: 0,0:14:02.88,0:14:07.05,Default,,0,0,0,,Tôi bị đẩy văng vì anh đánh nhau đó, Bo.
Dialogue: 0,0:14:08.31,0:14:09.27,Default,,0,0,0,,Văng đi luôn.
Dialogue: 0,0:14:09.35,0:14:10.85,Default,,0,0,0,,- Thế à?\N- Ừ.
Dialogue: 0,0:14:12.69,0:14:13.82,Default,,0,0,0,,"Thế à?" Dã man.
Dialogue: 0,0:14:14.35,0:14:15.69,Default,,0,0,0,,"Thế à?" Dã man.
Dialogue: 0,0:14:15.77,0:14:18.86,Default,,0,0,0,,Cô ấy từng nghe Bo kể là\Ncậu ấy từng đánh con gái.
Dialogue: 0,0:14:18.94,0:14:20.28,Default,,0,0,0,,Ồ, phải rồi.
Dialogue: 0,0:14:26.70,0:14:28.54,Default,,0,0,0,,Đàn ông bạo lực đáng sợ ghê.
Dialogue: 0,0:14:28.62,0:14:29.66,Default,,0,0,0,,Phải.
Dialogue: 0,0:14:35.25,0:14:36.63,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:14:39.71,0:14:41.46,Default,,0,0,0,,Cảm ơn đã tới.
Dialogue: 0,0:14:41.96,0:14:48.13,Default,,0,0,0,,Maririn đã nhắc đến lúc trước,\Nvà chuyện này… là về Bo.
Dialogue: 0,0:14:48.68,0:14:53.73,Default,,0,0,0,,Mục tiêu của cô ấy ở đây là đầu tiên\Nvượt qua chấn thương, đúng không?
Dialogue: 0,0:14:53.81,0:14:56.52,Default,,0,0,0,,Đó là ưu tiên hàng đầu\Nvì việc đó cản trở chuyện hẹn hò.
Dialogue: 0,0:14:56.60,0:15:02.06,Default,,0,0,0,,Bo, Maririn, Ruru và LEO\Ncó vẻ như đã ngồi nói chuyện với nhau.
Dialogue: 0,0:15:02.15,0:15:03.40,Default,,0,0,0,,- Được rồi.\N- Vâng.
Dialogue: 0,0:15:03.49,0:15:07.41,Default,,0,0,0,,Và Bo kể chuyện gì đó\Nkiểu như cậu ta từng đánh con gái.
Dialogue: 0,0:15:07.49,0:15:09.37,Default,,0,0,0,,- Có vẻ vậy.\N- Anh ấy từng đánh con gái.
Dialogue: 0,0:15:10.45,0:15:11.28,Default,,0,0,0,,Hả?
Dialogue: 0,0:15:11.91,0:15:16.08,Default,,0,0,0,,Ngay sau đó, cậu ta gây gổ\Nvới học sinh chuyển trường.
Dialogue: 0,0:15:16.62,0:15:19.75,Default,,0,0,0,,Họ va vào tôi, nhớ chứ?
Dialogue: 0,0:15:19.84,0:15:25.35,Default,,0,0,0,,Tôi nhắc tới chuyện đó lúc rửa bát,\Nvà anh ta chỉ: "Ồ, thế à?"
Dialogue: 0,0:15:26.43,0:15:29.35,Default,,0,0,0,,Tôi thấy anh ta không nghĩ gì nhiều.
Dialogue: 0,0:15:29.43,0:15:32.93,Default,,0,0,0,,Tôi muốn hỏi thẳng anh ta\Nsao không xin lỗi.
Dialogue: 0,0:15:33.02,0:15:38.32,Default,,0,0,0,,Tôi đã nghĩ vậy nhưng lại sợ hãi\Nvì nghĩ: "Nhỡ anh ta đánh mình thì sao?"
Dialogue: 0,0:15:38.40,0:15:39.57,Default,,0,0,0,,Cứ nói thẳng thôi.
Dialogue: 0,0:15:39.65,0:15:40.86,Default,,0,0,0,,- Ừ.\N- Vậy đi.
Dialogue: 0,0:15:40.94,0:15:41.77,Default,,0,0,0,,- Tôi đi gọi.\N- Ừ.
Dialogue: 0,0:15:41.86,0:15:44.61,Default,,0,0,0,,Cứ giữ khúc mắc thế này không tốt.
Dialogue: 0,0:15:44.69,0:15:47.61,Default,,0,0,0,,Thế mạnh của cậu ấy lộ rõ. Ý em là Ma-kun.
Dialogue: 0,0:15:52.28,0:15:57.83,Default,,0,0,0,,Cậu nhớ những gì Maririn kể\Nvề chuyện bị bạn trai cũ bạo hành chứ?
Dialogue: 0,0:15:57.92,0:16:02.13,Default,,0,0,0,,Cậu biết với con gái rất đáng sợ đấy.\NNam giới chúng ta khỏe hơn.
Dialogue: 0,0:16:02.21,0:16:03.17,Default,,0,0,0,,Phải.
Dialogue: 0,0:16:04.05,0:16:04.88,Default,,0,0,0,,- Nhỉ?\N- Ừ.
Dialogue: 0,0:16:04.96,0:16:09.30,Default,,0,0,0,,Lúc trước cậu va vào cô ấy\Nlúc đánh nhau với Kazuma.
Dialogue: 0,0:16:09.39,0:16:11.02,Default,,0,0,0,,Ồ, xin lỗi nhé.
Dialogue: 0,0:16:14.31,0:16:16.23,Default,,0,0,0,,Tôi nghe nói ban nãy cậu chưa xin lỗi.
Dialogue: 0,0:16:16.81,0:16:20.36,Default,,0,0,0,,Ồ, xin lỗi cả chuyện đó nữa.\NTại tôi chưa thấu đáo. Xin lỗi.
Dialogue: 0,0:16:21.15,0:16:22.61,Default,,0,0,0,,Không sao.
Dialogue: 0,0:16:23.36,0:16:27.36,Default,,0,0,0,,Kẻ ngoại tình hiển nhiên là sai.
Dialogue: 0,0:16:27.44,0:16:32.78,Default,,0,0,0,,Dù thế nào, đàn ông không nên đánh phụ nữ.\NKhông được đánh người yếu hơn mình.
Dialogue: 0,0:16:32.87,0:16:34.16,Default,,0,0,0,,- Không đúng.\N- Phải.
Dialogue: 0,0:16:34.24,0:16:36.24,Default,,0,0,0,,Cậu thề sẽ không đánh con gái được không?
Dialogue: 0,0:16:37.16,0:16:40.83,Default,,0,0,0,,Ừ, tôi thề. Cảm ơn đã nói thẳng với tôi.
Dialogue: 0,0:16:40.92,0:16:44.55,Default,,0,0,0,,Cư xử tử tế nhé?\NTrời, anh duỗi chân được xa thế?
Dialogue: 0,0:16:45.25,0:16:46.08,Default,,0,0,0,,Thật điên rồ.
Dialogue: 0,0:16:46.17,0:16:47.26,Default,,0,0,0,,Hông dẻo dai thế.
Dialogue: 0,0:16:47.34,0:16:50.18,Default,,0,0,0,,Bo đúng là trẻ trâu chính hiệu.
Dialogue: 0,0:16:50.26,0:16:51.30,Default,,0,0,0,,- Xin lỗi.\N- Ổn mà.
Dialogue: 0,0:16:51.39,0:16:52.93,Default,,0,0,0,,Mừng là họ nói rõ hết được.
Dialogue: 0,0:16:59.14,0:17:01.39,Default,,0,0,0,,Hôm nay là ngày Valentine.
Dialogue: 0,0:17:01.48,0:17:03.15,Default,,0,0,0,,- Quên mất đó.\N- Được nói vậy à?
Dialogue: 0,0:17:03.23,0:17:08.61,Default,,0,0,0,,Đây là ngày thể hiện tình yêu\Nvà lòng biết ơn với bạn đời.
Dialogue: 0,0:17:08.69,0:17:15.20,Default,,0,0,0,,Các chàng trai, hãy làm kẹo\Ncho cô gái mà mình thích
Dialogue: 0,0:17:15.28,0:17:18.37,Default,,0,0,0,,và bộc bạch cảm xúc với cô ấy.
Dialogue: 0,0:17:18.45,0:17:20.70,Default,,0,0,0,,- Rõ!\N- Rõ!
Dialogue: 0,0:17:20.79,0:17:21.71,Default,,0,0,0,,Làm thôi!
Dialogue: 0,0:17:21.79,0:17:23.58,Default,,0,0,0,,Được rồi! Đi nào!
Dialogue: 0,0:17:23.67,0:17:27.26,Default,,0,0,0,,Xem họ kìa. Ban nãy vừa cãi nhau xong.
Dialogue: 0,0:17:27.34,0:17:28.76,Default,,0,0,0,,Chà.
Dialogue: 0,0:17:42.14,0:17:43.02,Default,,0,0,0,,Cậu ấy khéo ghê.
Dialogue: 0,0:17:43.60,0:17:45.48,Default,,0,0,0,,Bo đang vẽ hình trái tim.
Dialogue: 0,0:17:45.56,0:17:47.85,Default,,0,0,0,,Sô-cô-la trắng chắc ngon hơn.
Dialogue: 0,0:17:48.82,0:17:51.91,Default,,0,0,0,,Tôi từng được tặng sô-cô-la.\NGiờ hiểu cảm giác lúc làm rồi.
Dialogue: 0,0:17:56.24,0:17:57.37,Default,,0,0,0,,Chà.
Dialogue: 0,0:17:57.45,0:17:58.99,Default,,0,0,0,,- Tai-chan.\N- Đó là Tai-chan.
Dialogue: 0,0:17:59.08,0:18:00.50,Default,,0,0,0,,Thể hiện rõ cá tính riêng.
Dialogue: 0,0:18:00.58,0:18:01.66,Default,,0,0,0,,Đáng yêu ghê.
Dialogue: 0,0:18:01.75,0:18:06.84,Default,,0,0,0,,THÀNH PHẨM CỦA MA-KUN
Dialogue: 0,0:18:06.92,0:18:12.01,Default,,0,0,0,,THÀNH PHẨM CỦA KAZU-KUN
Dialogue: 0,0:18:12.09,0:18:13.30,Default,,0,0,0,,THÀNH PHẨM CỦA Bo
Dialogue: 0,0:18:13.38,0:18:15.55,Default,,0,0,0,,- Bo!\N- Đáng yêu quá, Bo.
Dialogue: 0,0:18:15.64,0:18:16.68,Default,,0,0,0,,- Yêu ghê.\N- Ừ.
Dialogue: 0,0:18:16.76,0:18:17.59,Default,,0,0,0,,Đẳng cấp.
Dialogue: 0,0:18:20.89,0:18:22.56,Default,,0,0,0,,Đó là hoa quả à?
Dialogue: 0,0:18:23.31,0:18:24.69,Default,,0,0,0,,- Hay.\N- Hay ghê.
Dialogue: 0,0:18:24.77,0:18:26.56,Default,,0,0,0,,THÀNH PHẨM CỦA ARI
Dialogue: 0,0:18:30.53,0:18:33.20,Default,,0,0,0,,GỬI RURU\NCHÚC MỪNG BALEN
Dialogue: 0,0:18:33.28,0:18:35.74,Default,,0,0,0,,Phải là "T-A". Xóa "N" đi.
Dialogue: 0,0:18:35.82,0:18:36.78,Default,,0,0,0,,N? N-T?
Dialogue: 0,0:18:36.87,0:18:38.21,Default,,0,0,0,,N-T-A.
Dialogue: 0,0:18:38.28,0:18:39.24,Default,,0,0,0,,Valen… tain?
Dialogue: 0,0:18:39.33,0:18:42.00,Default,,0,0,0,,Thôi, không nghe anh đâu!
Dialogue: 0,0:18:42.08,0:18:43.96,Default,,0,0,0,,Nếu tôi không đúng, cậu ta cũng thế!
Dialogue: 0,0:18:44.04,0:18:45.92,Default,,0,0,0,,Này, tôi có máy tính mà.
Dialogue: 0,0:18:46.00,0:18:47.84,Default,,0,0,0,,Anh đánh vần theo phát âm tiếng Nhật.
Dialogue: 0,0:18:47.92,0:18:48.92,Default,,0,0,0,,Cậu không muốn thế à?
Dialogue: 0,0:18:49.00,0:18:50.88,Default,,0,0,0,,Tôi muốn "Valentine" trong tiếng Anh!
Dialogue: 0,0:18:50.96,0:18:56.42,Default,,0,0,0,,Thật luôn… Thôi nào! Ai lại hỏi…
Dialogue: 0,0:18:56.51,0:19:00.10,Default,,0,0,0,,Ai lại hỏi đánh vần\Ntheo phát âm thế nào? Đồ ngốc!
Dialogue: 0,0:19:00.18,0:19:01.52,Default,,0,0,0,,Họ vui quá kìa.
Dialogue: 0,0:19:01.60,0:19:03.73,Default,,0,0,0,,Tôi biết phát âm trong tiếng Nhật mà!
Dialogue: 0,0:19:05.02,0:19:06.94,Default,,0,0,0,,Những lúc này là vui nhất.
Dialogue: 0,0:19:07.02,0:19:08.52,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:19:08.61,0:19:11.03,Default,,0,0,0,,THÀNH PHẨM CỦA LEO
Dialogue: 0,0:19:11.11,0:19:12.82,Default,,0,0,0,,- Giỏi thế.\N- Giỏi quá, Leo.
Dialogue: 0,0:19:12.90,0:19:14.69,Default,,0,0,0,,Leo giỏi ghê.
Dialogue: 0,0:19:14.78,0:19:16.95,Default,,0,0,0,,- Có khi là đẹp nhất.\N- Chà.
Dialogue: 0,0:19:18.45,0:19:21.08,Default,,0,0,0,,Kazuma hẳn làm sô-cô-la ngon lắm.
Dialogue: 0,0:19:21.16,0:19:22.33,Default,,0,0,0,,Cô muốn à?
Dialogue: 0,0:19:23.25,0:19:24.21,Default,,0,0,0,,Cô muốn nó.
Dialogue: 0,0:19:24.29,0:19:26.00,Default,,0,0,0,,Kazuma hẳn làm sô-cô-la ngon lắm.
Dialogue: 0,0:19:26.08,0:19:27.87,Default,,0,0,0,,Nhưng có khi Leo làm ngon hơn.
Dialogue: 0,0:19:27.96,0:19:29.09,Default,,0,0,0,,Thế hả?
Dialogue: 0,0:19:31.75,0:19:38.26,Default,,0,0,0,,Sau khi làm xong, hãy mời cô gái đó\Nqua hệ thống phát thanh của trường.
Dialogue: 0,0:19:42.93,0:19:46.39,Default,,0,0,0,,ĐANG PHÁT
Dialogue: 0,0:19:47.10,0:19:48.69,Default,,0,0,0,,Ma-kun đây.
Dialogue: 0,0:19:50.77,0:19:53.02,Default,,0,0,0,,Người tôi muốn tặng sô-cô-la…
Dialogue: 0,0:19:54.03,0:19:54.86,Default,,0,0,0,,là Assun.
Dialogue: 0,0:19:54.94,0:19:55.77,Default,,0,0,0,,Biết mà.
Dialogue: 0,0:19:56.45,0:19:57.91,Default,,0,0,0,,Hãy tới phòng xông hơi.
Dialogue: 0,0:19:57.99,0:19:59.24,Default,,0,0,0,,- Phòng xông hơi?\N- Hả?
Dialogue: 0,0:19:59.95,0:20:00.87,Default,,0,0,0,,Cô được đi đó.
Dialogue: 0,0:20:00.95,0:20:02.04,Default,,0,0,0,,Chúc vui vẻ.
Dialogue: 0,0:20:02.12,0:20:04.62,Default,,0,0,0,,Sẽ không đi xông hơi thật đâu nhỉ?
Dialogue: 0,0:20:09.71,0:20:11.17,Default,,0,0,0,,- Ai vậy? Kazuma à?\N- Tai-chan.
Dialogue: 0,0:20:11.25,0:20:12.96,Default,,0,0,0,,Tai-chan đây.
Dialogue: 0,0:20:13.55,0:20:15.14,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:20:15.84,0:20:17.51,Default,,0,0,0,,Tai-chan sẽ làm gì đây?
Dialogue: 0,0:20:18.55,0:20:20.43,Default,,0,0,0,,Người tôi muốn tặng sô-cô-la…
Dialogue: 0,0:20:25.14,0:20:26.14,Default,,0,0,0,,là Hikaru.
Dialogue: 0,0:20:26.93,0:20:29.10,Default,,0,0,0,,Tôi sẽ chờ cô trong sân ở khu hút thuốc.
Dialogue: 0,0:20:29.19,0:20:31.65,Default,,0,0,0,,Chắc cậu ấy chỉ muốn hút thuốc thôi.
Dialogue: 0,0:20:33.02,0:20:33.85,Default,,0,0,0,,Biết mà.
Dialogue: 0,0:20:33.94,0:20:36.15,Default,,0,0,0,,Nhưng cô ấy từng nổi giận\Nvới cậu ấy một lần.
Dialogue: 0,0:20:40.74,0:20:42.91,Default,,0,0,0,,Bo muốn tặng sô-cô-la cho…
Dialogue: 0,0:20:42.99,0:20:44.33,Default,,0,0,0,,"Bo"? Đáng yêu thế.
Dialogue: 0,0:20:49.00,0:20:50.54,Default,,0,0,0,,…Hikaru.
Dialogue: 0,0:20:52.29,0:20:53.58,Default,,0,0,0,,Cô ấy được yêu mến quá.
Dialogue: 0,0:20:53.67,0:20:55.80,Default,,0,0,0,,Trông cô ấy ra vẻ kinh ngạc kìa.
Dialogue: 0,0:20:55.88,0:20:58.59,Default,,0,0,0,,Thật mà. Tôi không ngờ tới Bo.
Dialogue: 0,0:21:05.43,0:21:09.89,Default,,0,0,0,,Kiểm tra Mic! Một, hai, một hai! Sao rồi!
Dialogue: 0,0:21:09.98,0:21:12.52,Default,,0,0,0,,Đây là Ari rồi.
Dialogue: 0,0:21:12.60,0:21:16.40,Default,,0,0,0,,Cô gái tôi muốn tặng sô-cô-la là…
Dialogue: 0,0:21:18.07,0:21:20.49,Default,,0,0,0,,Hikaru!
Dialogue: 0,0:21:20.57,0:21:21.49,Default,,0,0,0,,Cậu ấy quậy ghê.
Dialogue: 0,0:21:21.57,0:21:22.91,Default,,0,0,0,,Cô ấy là người được chọn.
Dialogue: 0,0:21:22.99,0:21:23.87,Default,,0,0,0,,Diễn hay quá.
Dialogue: 0,0:21:23.95,0:21:25.74,Default,,0,0,0,,Khó rồi đây.
Dialogue: 0,0:21:26.62,0:21:29.62,Default,,0,0,0,,Tôi không giỏi làm kẹo,\Nnhưng tôi đã cố hết sức.
Dialogue: 0,0:21:29.71,0:21:30.59,Default,,0,0,0,,Đáng yêu quá.
Dialogue: 0,0:21:30.66,0:21:31.79,Default,,0,0,0,,Tôi đã toàn tâm làm đó.
Dialogue: 0,0:21:31.87,0:21:32.71,Default,,0,0,0,,Đáng yêu ghê.
Dialogue: 0,0:21:33.21,0:21:35.71,Default,,0,0,0,,Tôi sẽ chờ trong bếp.
Dialogue: 0,0:21:35.79,0:21:37.75,Default,,0,0,0,,Triển thôi nào!
Dialogue: 0,0:21:37.84,0:21:38.67,Default,,0,0,0,,Tuyệt đấy.
Dialogue: 0,0:21:38.76,0:21:40.72,Default,,0,0,0,,Anh ấy có bài thông báo hay nhất.
Dialogue: 0,0:21:46.35,0:21:47.69,Default,,0,0,0,,Leo đây.
Dialogue: 0,0:21:49.85,0:21:52.19,Default,,0,0,0,,Người tôi muốn tặng sô-cô-la…
Dialogue: 0,0:21:54.40,0:21:55.57,Default,,0,0,0,,là Ruru.
Dialogue: 0,0:21:56.27,0:21:57.10,Default,,0,0,0,,Một lòng một dạ.
Dialogue: 0,0:21:57.19,0:21:58.03,Default,,0,0,0,,Không đổi thay.
Dialogue: 0,0:21:58.11,0:22:00.32,Default,,0,0,0,,Tôi đã dốc hết tâm ý để làm.
Dialogue: 0,0:22:01.28,0:22:04.95,Default,,0,0,0,,Hãy gặp nhau phía sau nhà thể chất nhé.
Dialogue: 0,0:22:05.03,0:22:10.33,Default,,0,0,0,,Có khi cậu ấy sẽ chì chiết cô\Nvì vụ đi xông hơi với Kazuma.
Dialogue: 0,0:22:10.41,0:22:11.62,Default,,0,0,0,,Quỳ xuống xin lỗi hả?
Dialogue: 0,0:22:11.71,0:22:13.25,Default,,0,0,0,,Bậy bạ quá.
Dialogue: 0,0:22:14.37,0:22:15.46,Default,,0,0,0,,Kazu-kun đây.
Dialogue: 0,0:22:15.54,0:22:16.75,Default,,0,0,0,,"Kazu-kun đây".
Dialogue: 0,0:22:16.84,0:22:18.09,Default,,0,0,0,,Cô gái mà tôi…
Dialogue: 0,0:22:18.17,0:22:20.92,Default,,0,0,0,,muốn tặng sô-cô-la là…
Dialogue: 0,0:22:23.84,0:22:24.92,Default,,0,0,0,,Ruru.
Dialogue: 0,0:22:27.89,0:22:28.72,Default,,0,0,0,,Cô ấy vui kìa.
Dialogue: 0,0:22:28.81,0:22:30.35,Default,,0,0,0,,Hãy qua phòng khách nhé.
Dialogue: 0,0:22:30.43,0:22:32.35,Default,,0,0,0,,Gì cơ? Tôi phải đi đâu?
Dialogue: 0,0:22:32.43,0:22:33.93,Default,,0,0,0,,Phòng? Phòng khách?
Dialogue: 0,0:22:34.02,0:22:35.19,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:22:36.15,0:22:37.86,Default,,0,0,0,,Hiểu rồi!
Dialogue: 0,0:22:45.49,0:22:46.87,Default,,0,0,0,,Được rồi, tôi đi đây.
Dialogue: 0,0:22:46.95,0:22:48.45,Default,,0,0,0,,Đi nha.
Dialogue: 0,0:22:49.03,0:22:51.07,Default,,0,0,0,,Tôi sẽ mặc áo khoác của Masaya.
Dialogue: 0,0:22:51.16,0:22:52.29,Default,,0,0,0,,Bảo trọng.
Dialogue: 0,0:22:52.37,0:22:53.83,Default,,0,0,0,,- Đi nha.\N- Tạm biệt.
Dialogue: 0,0:22:59.59,0:23:01.05,Default,,0,0,0,,Chà, cảm ơn.
Dialogue: 0,0:23:01.13,0:23:01.96,Default,,0,0,0,,Lần đầu tiên đó.
Dialogue: 0,0:23:02.05,0:23:06.14,Default,,0,0,0,,Tôi cũng chưa từng nhận thứ gì thế này.\NCái này là tự làm nhỉ?
Dialogue: 0,0:23:06.22,0:23:07.26,Default,,0,0,0,,Ừ. Đúng vậy.
Dialogue: 0,0:23:07.34,0:23:09.22,Default,,0,0,0,,Đáng yêu ghê. Tôi vui quá.
Dialogue: 0,0:23:09.30,0:23:12.14,Default,,0,0,0,,Lúc làm tôi đỏ hết cả mặt.
Dialogue: 0,0:23:12.22,0:23:15.68,Default,,0,0,0,,Đây là lần đầu tiên\Ntôi được tặng đồ tự làm.
Dialogue: 0,0:23:16.90,0:23:20.24,Default,,0,0,0,,Đáng yêu quá! Chà!
Dialogue: 0,0:23:20.32,0:23:21.57,Default,,0,0,0,,Mừng quá.
Dialogue: 0,0:23:22.19,0:23:24.82,Default,,0,0,0,,- Cậu tự trang trí hả?\N- Phải.
Dialogue: 0,0:23:24.90,0:23:26.44,Default,,0,0,0,,Đáng yêu quá.
Dialogue: 0,0:23:26.53,0:23:27.95,Default,,0,0,0,,Chắc cái đó là nhẹ nhất.
Dialogue: 0,0:23:28.03,0:23:29.62,Default,,0,0,0,,- Dâu tây à?\N- Ừ.
Dialogue: 0,0:23:29.70,0:23:31.41,Default,,0,0,0,,- Tôi ăn nha?\N- Được.
Dialogue: 0,0:23:32.20,0:23:33.99,Default,,0,0,0,,- Cảm ơn. Ăn đây.\N- Xin mời.
Dialogue: 0,0:23:37.37,0:23:38.33,Default,,0,0,0,,Ngon thế.
Dialogue: 0,0:23:38.42,0:23:39.38,Default,,0,0,0,,- Ngon à?\N- Ừ.
Dialogue: 0,0:23:40.71,0:23:42.46,Default,,0,0,0,,Họ thật ổn định.
Dialogue: 0,0:23:42.55,0:23:43.88,Default,,0,0,0,,Họ rất thân thiết.
Dialogue: 0,0:23:43.96,0:23:45.63,Default,,0,0,0,,- Nhỉ?\N- Cảm giác như vậy.
Dialogue: 0,0:23:45.72,0:23:47.93,Default,,0,0,0,,Cứ như đôi vợ chồng lâu năm vậy.
Dialogue: 0,0:23:48.01,0:23:50.22,Default,,0,0,0,,Hai người này cũng có cùng tần số.
Dialogue: 0,0:23:50.30,0:23:52.01,Default,,0,0,0,,- Họ hợp đôi ghê.\N- Phải.
Dialogue: 0,0:23:52.10,0:23:56.06,Default,,0,0,0,,Nếu bạn được nhiều chàng trai lựa chọn,
Dialogue: 0,0:23:56.14,0:24:00.31,Default,,0,0,0,,hãy cho họ cơ hội\Nthể hiện cảm xúc của mình.
Dialogue: 0,0:24:00.40,0:24:05.74,Default,,0,0,0,,Bạn được tự do chọn thứ tự.
Dialogue: 0,0:24:05.82,0:24:07.03,Default,,0,0,0,,Khó thế!
Dialogue: 0,0:24:07.11,0:24:08.78,Default,,0,0,0,,- Nhỉ?\N- Khó hả?
Dialogue: 0,0:24:16.08,0:24:17.87,Default,,0,0,0,,Cô sẽ gặp theo thứ tự nào?
Dialogue: 0,0:24:20.13,0:24:21.46,Default,,0,0,0,,Ôi, tôi không biết.
Dialogue: 0,0:24:21.54,0:24:25.13,Default,,0,0,0,,Đúng là sướng quá hóa rồ nhỉ?\NChuyện này không hay xảy ra trong đời.
Dialogue: 0,0:24:31.09,0:24:32.01,Default,,0,0,0,,Tôi lâm trận đây.
Dialogue: 0,0:24:32.10,0:24:33.23,Default,,0,0,0,,- Cố lên!\N- Vui nha.
Dialogue: 0,0:24:33.31,0:24:34.64,Default,,0,0,0,,- Đi nha!\N- Đi đây.
Dialogue: 0,0:24:38.56,0:24:41.19,Default,,0,0,0,,Tôi phải chủ động\Nvà tiếp cận riêng mới được.
Dialogue: 0,0:24:41.77,0:24:42.94,Default,,0,0,0,,Cứ đà này…
Dialogue: 0,0:24:43.02,0:24:43.90,Default,,0,0,0,,Phải.
Dialogue: 0,0:24:51.11,0:24:52.74,Default,,0,0,0,,Hikaru sẽ gặp ai trước?
Dialogue: 0,0:25:07.51,0:25:08.68,Default,,0,0,0,,- Hả?\N- Gì thế?
Dialogue: 0,0:25:08.76,0:25:12.51,Default,,0,0,0,,Cô ấy đi qua luôn.
Dialogue: 0,0:25:19.06,0:25:20.48,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:25:20.56,0:25:21.85,Default,,0,0,0,,Sao rồi!
Dialogue: 0,0:25:21.94,0:25:23.57,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:25:24.27,0:25:25.19,Default,,0,0,0,,Bất ngờ quá.
Dialogue: 0,0:25:25.27,0:25:27.36,Default,,0,0,0,,Xin chào. Ngồi đi.
Dialogue: 0,0:25:28.65,0:25:29.90,Default,,0,0,0,,Cô tới đây đầu tiên à?
Dialogue: 0,0:25:29.99,0:25:30.91,Default,,0,0,0,,Phải.
Dialogue: 0,0:25:30.99,0:25:32.83,Default,,0,0,0,,Ồ, thế à?
Dialogue: 0,0:25:33.41,0:25:34.33,Default,,0,0,0,,Tôi đã làm cái này.
Dialogue: 0,0:25:34.41,0:25:36.20,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:25:36.28,0:25:38.41,Default,,0,0,0,,Tôi làm cái này cho cô.
Dialogue: 0,0:25:38.50,0:25:42.67,Default,,0,0,0,,Tôi nghĩ cô đang giữ cân,\Nnên tôi chọn chủ yếu là hoa quả.
Dialogue: 0,0:25:42.75,0:25:43.83,Default,,0,0,0,,- Thế à?\N- Cô không ăn
Dialogue: 0,0:25:43.92,0:25:45.26,Default,,0,0,0,,vì cô đang tránh sô-cô-la.
Dialogue: 0,0:25:45.34,0:25:49.01,Default,,0,0,0,,Tôi nghĩ sô-cô-la thì không ổn.
Dialogue: 0,0:25:49.09,0:25:50.76,Default,,0,0,0,,Vậy sao lại gặp tôi trước?
Dialogue: 0,0:25:50.84,0:25:55.43,Default,,0,0,0,,Tôi nghĩ kỹ rồi,\Nnhưng trong số những người tiếp cận tôi,
Dialogue: 0,0:25:55.51,0:25:59.06,Default,,0,0,0,,anh là người thẳng thắn nhất.
Dialogue: 0,0:26:00.06,0:26:02.06,Default,,0,0,0,,Chà, anh đúng là thiên tài!
Dialogue: 0,0:26:02.14,0:26:03.31,Default,,0,0,0,,- Nhỉ?\N- Ừ.
Dialogue: 0,0:26:03.40,0:26:05.57,Default,,0,0,0,,Không biết cô có ngại ăn sô-cô-la.
Dialogue: 0,0:26:05.65,0:26:07.11,Default,,0,0,0,,- Không sao.\N- Thật à?
Dialogue: 0,0:26:08.11,0:26:09.36,Default,,0,0,0,,- Ngon.\N- Cô thích chứ?
Dialogue: 0,0:26:09.44,0:26:10.65,Default,,0,0,0,,Cô thích chứ?
Dialogue: 0,0:26:18.33,0:26:19.71,Default,,0,0,0,,- Cảm ơn.\N- Cảm ơn.
Dialogue: 0,0:26:19.79,0:26:21.92,Default,,0,0,0,,Tôi rất mừng vì cô chọn tôi đầu tiên.
Dialogue: 0,0:26:22.66,0:26:23.95,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:26:24.71,0:26:26.17,Default,,0,0,0,,Bắt tay nha.
Dialogue: 0,0:26:27.17,0:26:28.01,Default,,0,0,0,,- Sao rồi.\N- Yê.
Dialogue: 0,0:26:28.09,0:26:29.05,Default,,0,0,0,,Tôi cảm thấy rồi.
Dialogue: 0,0:26:29.13,0:26:30.21,Default,,0,0,0,,Thẳng thắn ghê.
Dialogue: 0,0:26:30.30,0:26:32.39,Default,,0,0,0,,- Ari là vậy.\N- Nghĩ gì nói nấy.
Dialogue: 0,0:26:32.47,0:26:33.56,Default,,0,0,0,,Đáng yêu ghê.
Dialogue: 0,0:26:35.59,0:26:36.88,Default,,0,0,0,,Đáng yêu thật!
Dialogue: 0,0:26:36.97,0:26:38.60,Default,,0,0,0,,Quá đáng yêu.
Dialogue: 0,0:26:38.68,0:26:40.43,Default,,0,0,0,,- Siêu đáng yêu.\N- Dáng kiểu Platoon.
Dialogue: 0,0:26:42.60,0:26:44.23,Default,,0,0,0,,Tuyệt!
Dialogue: 0,0:26:45.23,0:26:48.73,Default,,0,0,0,,Em chỉ thấy kiểu ăn mừng đó\Nlúc ghi bàn trong bóng đá.
Dialogue: 0,0:26:48.82,0:26:49.65,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:26:49.73,0:26:51.27,Default,,0,0,0,,Cậu ấy làm thế thật.
Dialogue: 0,0:26:58.03,0:27:00.62,Default,,0,0,0,,Cảm ơn cậu đã chờ.
Dialogue: 0,0:27:00.70,0:27:02.12,Default,,0,0,0,,Mừng ngày Valentine.
Dialogue: 0,0:27:02.20,0:27:03.95,Default,,0,0,0,,Mừng ngày Valentine.
Dialogue: 0,0:27:04.04,0:27:07.59,Default,,0,0,0,,Đây là lần đầu tôi làm sô-cô-la,\Ndành riêng cho cô đó.
Dialogue: 0,0:27:07.67,0:27:09.67,Default,,0,0,0,,Cảm ơn. Túi xinh quá.
Dialogue: 0,0:27:09.75,0:27:14.21,Default,,0,0,0,,Tôi làm nhưng tôi biết\Ncô không thể ăn hết được.
Dialogue: 0,0:27:14.30,0:27:15.13,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:27:15.22,0:27:16.56,Default,,0,0,0,,Nhiều lắm.
Dialogue: 0,0:27:17.47,0:27:20.39,Default,,0,0,0,,- Đáng yêu quá.\N- Mở đi!
Dialogue: 0,0:27:23.22,0:27:25.77,Default,,0,0,0,,- Chà, khéo tay quá.\N- Nhỉ?
Dialogue: 0,0:27:25.85,0:27:28.14,Default,,0,0,0,,Gu của tôi không chê vào đâu được.
Dialogue: 0,0:27:28.23,0:27:30.15,Default,,0,0,0,,Đáng yêu thế! Tôi muốn đặt lên kệ!
Dialogue: 0,0:27:30.23,0:27:31.73,Default,,0,0,0,,- Nhỉ?\N- Ừ.
Dialogue: 0,0:27:31.82,0:27:34.07,Default,,0,0,0,,- Nhưng cậu thay đổi rồi.\N- Sao cơ?
Dialogue: 0,0:27:34.15,0:27:36.19,Default,,0,0,0,,Tôi thấy được.
Dialogue: 0,0:27:36.28,0:27:37.20,Default,,0,0,0,,Ý cô là sao?
Dialogue: 0,0:27:37.28,0:27:40.49,Default,,0,0,0,,Ban đầu, tôi thấy cậu khá là mềm yếu.
Dialogue: 0,0:27:40.58,0:27:45.46,Default,,0,0,0,,Nhưng khi thấy cậu nói chuyện\Nvới các anh em,
Dialogue: 0,0:27:45.54,0:27:48.38,Default,,0,0,0,,tôi thấy cậu không hề yếm mềm.
Dialogue: 0,0:27:48.46,0:27:52.71,Default,,0,0,0,,Cô nghĩ vậy sao?\NTôi mừng vì cô nhận ra đấy.
Dialogue: 0,0:27:52.80,0:27:55.43,Default,,0,0,0,,- Ngủ ngon. Tôi vui lắm.\N- Ngủ ngon. Cảm ơn.
Dialogue: 0,0:27:55.51,0:27:57.26,Default,,0,0,0,,- Ngủ ngon.\N- Cảm ơn nha.
Dialogue: 0,0:27:59.05,0:28:00.43,Default,,0,0,0,,Dễ thương ghê.
Dialogue: 0,0:28:02.43,0:28:05.31,Default,,0,0,0,,Không rủ cô ấy hẹn hò được à?\NChắc là không được.
Dialogue: 0,0:28:06.56,0:28:07.40,Default,,0,0,0,,Đây.
Dialogue: 0,0:28:07.48,0:28:08.73,Default,,0,0,0,,- Cảm ơn.\N- Ừ.
Dialogue: 0,0:28:11.94,0:28:13.94,Default,,0,0,0,,Của cô nè.
Dialogue: 0,0:28:14.03,0:28:15.03,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:28:15.11,0:28:16.15,Default,,0,0,0,,Tôi không khéo lắm.
Dialogue: 0,0:28:16.82,0:28:22.37,Default,,0,0,0,,Đáng yêu! Chà, tôi không ngờ\Nanh làm được thế này đấy, Bo.
Dialogue: 0,0:28:23.12,0:28:24.33,Default,,0,0,0,,Đáng yêu lắm.
Dialogue: 0,0:28:24.41,0:28:26.37,Default,,0,0,0,,Anh chọn sự tương phản.
Dialogue: 0,0:28:26.45,0:28:27.91,Default,,0,0,0,,- Hả?\N- Tương phản.
Dialogue: 0,0:28:28.96,0:28:32.67,Default,,0,0,0,,Cô là người tôi thích nhất ở đây.
Dialogue: 0,0:28:33.96,0:28:35.38,Default,,0,0,0,,- Thế hả?\N- Ừ.
Dialogue: 0,0:28:36.55,0:28:41.05,Default,,0,0,0,,Tôi gặp theo thứ tự\NAri, Tai-chan rồi đến anh.
Dialogue: 0,0:28:41.14,0:28:45.69,Default,,0,0,0,,Đó là vì anh là người\Ntôi ít hiểu rõ nhất hiện tại.
Dialogue: 0,0:28:45.77,0:28:46.65,Default,,0,0,0,,Có lẽ ta chưa…
Dialogue: 0,0:28:46.73,0:28:47.69,Default,,0,0,0,,- Tâm sự nha.\N- Ừ.
Dialogue: 0,0:28:47.77,0:28:54.74,Default,,0,0,0,,Lúc tôi nghe anh từng đánh một cô gái,\Ntôi kiểu: "Khoan, thật sao?"
Dialogue: 0,0:28:54.82,0:28:57.45,Default,,0,0,0,,Tôi không biết anh như vậy đấy.
Dialogue: 0,0:28:57.94,0:29:00.78,Default,,0,0,0,,Tôi muốn mọi người hiểu về tôi.
Dialogue: 0,0:29:00.86,0:29:04.07,Default,,0,0,0,,Tôi nói ra dù biết\Nđiều đó sẽ khiến mình trông tệ hại.
Dialogue: 0,0:29:04.16,0:29:08.04,Default,,0,0,0,,Tôi có khuyết điểm,\Nnhưng đó vẫn là một phần con người tôi.
Dialogue: 0,0:29:08.12,0:29:14.00,Default,,0,0,0,,Mọi thứ tôi trải qua đã đưa tôi đến đây,\Nvà tôi biết mình không được đánh con gái.
Dialogue: 0,0:29:14.09,0:29:17.55,Default,,0,0,0,,Tôi thấy chắc chắn về chuyện đó.
Dialogue: 0,0:29:17.63,0:29:22.80,Default,,0,0,0,,Đánh cô ấy là sai, nhưng nhờ vậy tôi nhận\Nra mình muốn trở thành người như thế nào.
Dialogue: 0,0:29:24.18,0:29:25.93,Default,,0,0,0,,Là như vậy đấy.
Dialogue: 0,0:29:29.23,0:29:30.40,Default,,0,0,0,,Tôi đi đây.
Dialogue: 0,0:29:30.48,0:29:31.52,Default,,0,0,0,,Đi nha.
Dialogue: 0,0:29:33.73,0:29:35.02,Default,,0,0,0,,Ruru.
Dialogue: 0,0:29:38.19,0:29:40.78,Default,,0,0,0,,Sao cô ấy vui mừng\Ntrước hai người này thế nhỉ?
Dialogue: 0,0:29:41.70,0:29:43.87,Default,,0,0,0,,- Chính là ý em.\N- Nhỉ?
Dialogue: 0,0:29:43.95,0:29:47.20,Default,,0,0,0,,- Ruru có gan vậy đấy.\N- Đúng vậy.
Dialogue: 0,0:30:01.47,0:30:02.89,Default,,0,0,0,,Vậy sẽ là ai đây?
Dialogue: 0,0:30:05.14,0:30:06.23,Default,,0,0,0,,Cúc cu.
Dialogue: 0,0:30:06.30,0:30:07.13,Default,,0,0,0,,Hả?
Dialogue: 0,0:30:07.22,0:30:08.60,Default,,0,0,0,,- Cúc cu.\N- Cúc cu.
Dialogue: 0,0:30:09.64,0:30:10.47,Default,,0,0,0,,Tặng cô nè.
Dialogue: 0,0:30:10.56,0:30:12.23,Default,,0,0,0,,Tuyệt, cảm ơn.
Dialogue: 0,0:30:12.94,0:30:14.15,Default,,0,0,0,,Đáng yêu thật sự.
Dialogue: 0,0:30:14.23,0:30:16.94,Default,,0,0,0,,Đây là lần đầu tiên tôi làm kẹo đó.
Dialogue: 0,0:30:17.02,0:30:21.36,Default,,0,0,0,,Hả? Đáng yêu quá. Lần đầu mà làm giỏi quá.
Dialogue: 0,0:30:23.53,0:30:26.41,Default,,0,0,0,,Ngon ghê! Đây là kẹo dẻo hả?
Dialogue: 0,0:30:26.49,0:30:27.95,Default,,0,0,0,,Ừ, chắc thế.
Dialogue: 0,0:30:28.03,0:30:28.95,Default,,0,0,0,,Ngon tuyệt.
Dialogue: 0,0:30:30.91,0:30:33.58,Default,,0,0,0,,Tôi đã có cảm giác\Ncô không tới gặp tôi trước.
Dialogue: 0,0:30:33.67,0:30:37.09,Default,,0,0,0,,Ngày đầu đã làm việc này?\NNhưng tôi biết là điểm bất lợi.
Dialogue: 0,0:30:37.17,0:30:39.21,Default,,0,0,0,,nhưng cũng không có cách nào khác.
Dialogue: 0,0:30:39.30,0:30:40.22,Default,,0,0,0,,Tôi hiểu mà.
Dialogue: 0,0:30:40.30,0:30:41.47,Default,,0,0,0,,Được chọn trước vui quá.
Dialogue: 0,0:30:41.55,0:30:42.63,Default,,0,0,0,,Phải.
Dialogue: 0,0:30:48.01,0:30:50.35,Default,,0,0,0,,Ui, Leo.
Dialogue: 0,0:30:55.98,0:30:57.48,Default,,0,0,0,,Tôi vui lắm.
Dialogue: 0,0:30:58.48,0:31:00.07,Default,,0,0,0,,Đổi lại, tôi được gì nhỉ?
Dialogue: 0,0:31:00.15,0:31:03.95,Default,,0,0,0,,Tôi muốn chúng ta\Ndành thời gian nói chuyện nhiều hơn.
Dialogue: 0,0:31:06.32,0:31:07.61,Default,,0,0,0,,- Nói chuyện nha.\N- Ừ.
Dialogue: 0,0:31:08.78,0:31:10.03,Default,,0,0,0,,Hãy luôn ở bên tôi.
Dialogue: 0,0:31:10.12,0:31:10.95,Default,,0,0,0,,Ồ?
Dialogue: 0,0:31:11.04,0:31:12.42,Default,,0,0,0,,- Dù tôi đi đâu.\N- Được.
Dialogue: 0,0:31:12.50,0:31:14.17,Default,,0,0,0,,Thế thì được nói chuyện suốt.
Dialogue: 0,0:31:14.25,0:31:15.17,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:31:24.09,0:31:26.01,Default,,0,0,0,,- Cúc cu.\N- Chào.
Dialogue: 0,0:31:26.09,0:31:27.17,Default,,0,0,0,,- Không lạnh à?\N- Lạnh.
Dialogue: 0,0:31:27.26,0:31:29.18,Default,,0,0,0,,- Dã man.\N- Cô đã nhận một cái rồi.
Dialogue: 0,0:31:29.26,0:31:31.97,Default,,0,0,0,,Tôi gặp anh thứ hai\Nvì tôi muốn nói chuyện lâu hơn.
Dialogue: 0,0:31:32.06,0:31:33.90,Default,,0,0,0,,- Thế à?\N- Cố tình đó.
Dialogue: 0,0:31:33.98,0:31:35.90,Default,,0,0,0,,Thôi nào!
Dialogue: 0,0:31:35.98,0:31:37.32,Default,,0,0,0,,Cô gái này!
Dialogue: 0,0:31:37.40,0:31:38.78,Default,,0,0,0,,- Đáng sợ!\N- Cô gái này!
Dialogue: 0,0:31:38.86,0:31:40.70,Default,,0,0,0,,- Awich bực rồi đó.\N- Mèo vờn chuột.
Dialogue: 0,0:31:41.27,0:31:43.52,Default,,0,0,0,,- Nghi lắm.\N- Thật mà. Cố tình mà.
Dialogue: 0,0:31:43.61,0:31:45.99,Default,,0,0,0,,Tôi đến đó,\Nnói chuyện nhanh rồi qua chỗ cậu.
Dialogue: 0,0:31:46.07,0:31:50.16,Default,,0,0,0,,Tôi muốn nói chuyện với cậu. Hôm qua\Nđã nói vậy mà chưa được nói chuyện.
Dialogue: 0,0:31:50.24,0:31:53.33,Default,,0,0,0,,Tôi muốn dành nhiều thời gian với cậu,\Nnên mới đến gặp cậu sau.
Dialogue: 0,0:31:53.41,0:31:54.70,Default,,0,0,0,,- Ồ, vậy hả?\N- Ừ.
Dialogue: 0,0:31:55.62,0:31:56.70,Default,,0,0,0,,Xin lỗi đã để cô chờ.
Dialogue: 0,0:31:58.46,0:32:00.00,Default,,0,0,0,,Chà, đỉnh thật đó.
Dialogue: 0,0:32:00.08,0:32:02.08,Default,,0,0,0,,Tôi đã dốc hết tâm ý để làm đó. Nhận nha.
Dialogue: 0,0:32:02.17,0:32:04.55,Default,,0,0,0,,Chà, cảm ơn!
Dialogue: 0,0:32:04.63,0:32:07.22,Default,,0,0,0,,Thật tuyệt vời! Chà, đáng yêu quá.
Dialogue: 0,0:32:07.30,0:32:09.14,Default,,0,0,0,,Tôi muốn làm con toy poodle.
Dialogue: 0,0:32:09.22,0:32:10.39,Default,,0,0,0,,- Ồ, chó của tôi hả?\N- Ừ.
Dialogue: 0,0:32:10.47,0:32:12.60,Default,,0,0,0,,Nhưng tôi không biết vẽ.
Dialogue: 0,0:32:12.68,0:32:15.06,Default,,0,0,0,,Lát về phòng tôi mới ăn.
Dialogue: 0,0:32:15.14,0:32:20.44,Default,,0,0,0,,Cậu và tôi chơi với nhau suốt,\Nnhưng chẳng tán tỉnh nhau mấy.
Dialogue: 0,0:32:20.52,0:32:22.36,Default,,0,0,0,,Ừ, tôi cũng nghĩ vậy.
Dialogue: 0,0:32:22.44,0:32:27.36,Default,,0,0,0,,Tôi muốn nhắc tới chuyện đó.\NTôi thấy phải nói ra.
Dialogue: 0,0:32:27.45,0:32:30.54,Default,,0,0,0,,Ta sẽ không tiến triển nếu cứ vậy.\NTôi cũng nghĩ thế.
Dialogue: 0,0:32:30.62,0:32:34.50,Default,,0,0,0,,Hiện tại, tôi sẽ nói là\Ntôi có hứng thú với cậu.
Dialogue: 0,0:32:36.83,0:32:41.04,Default,,0,0,0,,Nhưng tôi không biết\Nliệu cậu có cảm thấy như vậy với tôi.
Dialogue: 0,0:32:41.13,0:32:42.47,Default,,0,0,0,,Cậu chưa từng nói thành lời.
Dialogue: 0,0:32:42.54,0:32:45.79,Default,,0,0,0,,Nên tôi muốn biết ta đang ở đâu.
Dialogue: 0,0:32:47.80,0:32:49.05,Default,,0,0,0,,Nói thật…
Dialogue: 0,0:32:51.26,0:32:55.14,Default,,0,0,0,,Vào những buổi hẹn hò,\Nbữa ăn và thời gian riêng…
Dialogue: 0,0:32:56.06,0:32:57.69,Default,,0,0,0,,tôi sẽ luôn chọn cô.
Dialogue: 0,0:32:58.85,0:33:00.94,Default,,0,0,0,,Ừ, phải rồi.
Dialogue: 0,0:33:01.02,0:33:03.90,Default,,0,0,0,,Cô là người tôi muốn ở bên\Ntrong suốt thời gian ở đây.
Dialogue: 0,0:33:03.98,0:33:08.48,Default,,0,0,0,,Lúc học sinh chuyển trường\Nngồi cạnh cô sáng nay,
Dialogue: 0,0:33:08.57,0:33:11.49,Default,,0,0,0,,tôi thấy hơi bực.
Dialogue: 0,0:33:11.57,0:33:12.74,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:33:12.82,0:33:16.95,Default,,0,0,0,,Khi hẹn hò, tôi chỉ nghĩ đến lâu dài.\NMột người tôi thấy có tương lai.
Dialogue: 0,0:33:17.04,0:33:21.59,Default,,0,0,0,,Nhưng cậu ở Kyoto, còn tôi ở Tokyo.
Dialogue: 0,0:33:21.67,0:33:26.09,Default,,0,0,0,,Cậu đã có cuộc sống ở đó rồi,\Nnên ta sẽ phải yêu xa.
Dialogue: 0,0:33:26.17,0:33:27.88,Default,,0,0,0,,Đến lúc chuyển đến Tokyo rồi.
Dialogue: 0,0:33:27.96,0:33:29.29,Default,,0,0,0,,Đó là điều tôi lo đấy.
Dialogue: 0,0:33:29.80,0:33:31.01,Default,,0,0,0,,Nhưng sau này hẵng lo.
Dialogue: 0,0:33:31.09,0:33:32.84,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:33:33.43,0:33:34.93,Default,,0,0,0,,Hiện tại, tôi rất thích cô.
Dialogue: 0,0:33:39.39,0:33:42.98,Default,,0,0,0,,Tôi không biết nói thế nào.\NTôi chỉ biết mình thích cô thôi.
Dialogue: 0,0:33:43.06,0:33:46.48,Default,,0,0,0,,Tôi tin vào bản tính thẳng thắn của cậu.
Dialogue: 0,0:33:46.57,0:33:48.86,Default,,0,0,0,,Cảm ơn. Mai gặp nha.
Dialogue: 0,0:33:48.94,0:33:49.77,Default,,0,0,0,,Ngủ ngon.
Dialogue: 0,0:33:49.86,0:33:50.74,Default,,0,0,0,,Kìa!
Dialogue: 0,0:33:50.82,0:33:52.20,Default,,0,0,0,,- Cảm ơn.\N- Cảm ơn.
Dialogue: 0,0:33:57.66,0:33:59.45,Default,,0,0,0,,Đến lúc chuyển đến Tokyo chưa?
Dialogue: 0,0:33:59.54,0:34:01.42,Default,,0,0,0,,Leo đáng yêu quá.
Dialogue: 0,0:34:02.17,0:34:05.26,Default,,0,0,0,,Hai người nghĩ sao về Ruru?
Dialogue: 0,0:34:05.33,0:34:06.83,Default,,0,0,0,,Thám tử, em nghĩ sao?
Dialogue: 0,0:34:07.55,0:34:09.18,Default,,0,0,0,,Em sẽ tránh xa cô ấy.
Dialogue: 0,0:34:09.26,0:34:11.39,Default,,0,0,0,,Nhỉ? Anh biết em nhịn lắm rồi đấy.
Dialogue: 0,0:34:11.47,0:34:12.43,Default,,0,0,0,,Cô ấy thật là tồi.
Dialogue: 0,0:34:12.51,0:34:14.30,Default,,0,0,0,,Tránh xa Ruru ra.
Dialogue: 0,0:34:14.39,0:34:18.73,Default,,0,0,0,,Theo cách nào đó, Kazu-kun và Ruru\Ncó khi là trời sinh một cặp.
Dialogue: 0,0:34:18.81,0:34:21.61,Default,,0,0,0,,Phải, Kazu-kun cũng nổi mà.
Dialogue: 0,0:34:21.68,0:34:22.77,Default,,0,0,0,,Cả hai người họ.
Dialogue: 0,0:34:22.85,0:34:23.93,Default,,0,0,0,,Vậy cả hai có thể…
Dialogue: 0,0:34:24.02,0:34:25.02,Default,,0,0,0,,Chơi đùa?
Dialogue: 0,0:34:25.10,0:34:26.35,Default,,0,0,0,,- Sau lưng.\N- Phải.
Dialogue: 0,0:34:26.44,0:34:30.03,Default,,0,0,0,,Họ nói chuyện cũng đầy toan tính.
Dialogue: 0,0:34:30.11,0:34:33.07,Default,,0,0,0,,"Đây là lần đầu tiên\Ntôi làm sô-cô-la cho gái đó".
Dialogue: 0,0:34:33.15,0:34:35.44,Default,,0,0,0,,"Tôi muốn ở bên anh,\Nhãy luôn ở bên tôi nhé".
Dialogue: 0,0:34:35.53,0:34:37.41,Default,,0,0,0,,Họ thật… tính toán.
Dialogue: 0,0:34:37.49,0:34:39.08,Default,,0,0,0,,- Họ có chiêu trò.\N- Họ thử nhau.
Dialogue: 0,0:34:39.16,0:34:42.00,Default,,0,0,0,,Họ không nói chuyện.\NHọ chỉ đang thi xem ai tán giỏi hơn.
Dialogue: 0,0:34:42.08,0:34:45.71,Default,,0,0,0,,Về bản năng, cô ấy hẳn muốn\Ngắn bó với một người duy nhất.
Dialogue: 0,0:34:45.79,0:34:47.00,Default,,0,0,0,,Ồ, ra vậy!
Dialogue: 0,0:34:47.09,0:34:50.68,Default,,0,0,0,,Cô ấy muốn cân nhắc\Nmột tương lai với người kia.
Dialogue: 0,0:34:50.76,0:34:52.39,Default,,0,0,0,,Một cuộc sống bên nhau.
Dialogue: 0,0:34:52.47,0:34:53.89,Default,,0,0,0,,Chắc cô ấy định như vậy.
Dialogue: 0,0:34:53.97,0:34:57.02,Default,,0,0,0,,Cô ấy không hề nói thế với Kazu-kun nhỉ?
Dialogue: 0,0:34:57.10,0:34:57.93,Default,,0,0,0,,Không hề.
Dialogue: 0,0:34:58.01,0:35:00.43,Default,,0,0,0,,Chắc là có cách lý giải đơn giản hơn.
Dialogue: 0,0:35:00.52,0:35:04.82,Default,,0,0,0,,Cô ấy dây dưa với Leo\Nđể đề phòng bị Kazu-kun từ chối.
Dialogue: 0,0:35:04.89,0:35:05.97,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:35:06.06,0:35:07.77,Default,,0,0,0,,Lý giải như vậy là đơn giản nhất.
Dialogue: 0,0:35:08.36,0:35:10.28,Default,,0,0,0,,Nhưng cũng khó nói.
Dialogue: 0,0:35:10.36,0:35:13.07,Default,,0,0,0,,Cứ như Ruru bắt thóp được\Ncả ba chúng ta vậy.
Dialogue: 0,0:35:13.15,0:35:16.15,Default,,0,0,0,,Như ta đang phân tích tâm lý tội phạm vậy.
Dialogue: 0,0:35:16.24,0:35:20.12,Default,,0,0,0,,Ta nói về cô ấy\Nnhư thể cô ấy là tội phạm nguy hiểm.
Dialogue: 0,0:35:26.04,0:35:27.33,Default,,0,0,0,,Búa, bao…
Dialogue: 0,0:35:28.17,0:35:29.26,Default,,0,0,0,,Trời.
Dialogue: 0,0:35:29.75,0:35:31.25,Default,,0,0,0,,Phải xăm mới được nhập hội.
Dialogue: 0,0:35:32.05,0:35:33.59,Default,,0,0,0,,Giống giờ nghỉ trưa trong tù.
Dialogue: 0,0:35:34.13,0:35:34.96,Default,,0,0,0,,Ngầu ghê.
Dialogue: 0,0:35:47.94,0:35:49.36,Default,,0,0,0,,Này, thôi đi.
Dialogue: 0,0:35:50.23,0:35:51.48,Default,,0,0,0,,Đừng chọc tôi cười.
Dialogue: 0,0:35:54.40,0:35:56.40,Default,,0,0,0,,Cái xanh lá của tôi hả?
Dialogue: 0,0:35:59.74,0:36:01.49,Default,,0,0,0,,- Chào buổi sáng.\N- Chào.
Dialogue: 0,0:36:01.58,0:36:02.75,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:36:03.24,0:36:07.62,Default,,0,0,0,,Hôm nay cô mặc màu đen,\Nnhưng tôi chỉ thấy trắng toát.
Dialogue: 0,0:36:07.71,0:36:08.59,Default,,0,0,0,,- Đẹp quá.\N- Chào.
Dialogue: 0,0:36:08.67,0:36:09.92,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:36:10.50,0:36:12.84,Default,,0,0,0,,Em thấy đáng yêu đấy chứ.
Dialogue: 0,0:36:12.92,0:36:13.75,Default,,0,0,0,,Bắt đầu nè.
Dialogue: 0,0:36:18.43,0:36:21.73,Default,,0,0,0,,Hôm nay, chúng tôi đã sắp xếp\Nmột cuộc hẹn hò.
Dialogue: 0,0:36:21.80,0:36:23.01,Default,,0,0,0,,Tuyệt.
Dialogue: 0,0:36:23.10,0:36:24.06,Default,,0,0,0,,Được đó.
Dialogue: 0,0:36:24.56,0:36:26.44,Default,,0,0,0,,Các chàng trai sẽ so tài hả?
Dialogue: 0,0:36:26.52,0:36:31.94,Default,,0,0,0,,Người được đi hẹn hò sẽ là\Ncô gái nhận được nhiều sô-cô-la nhất,
Dialogue: 0,0:36:33.61,0:36:34.90,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:36:36.24,0:36:38.58,Default,,0,0,0,,Chán thế. Nếu được thêm\Nhai hộp thì thắng rồi.
Dialogue: 0,0:36:39.91,0:36:45.62,Default,,0,0,0,,Hãy đi hẹn hò với tất cả\Ncác chàng trai đã tặng bạn sô-cô-la.
Dialogue: 0,0:36:45.70,0:36:46.91,Default,,0,0,0,,- Tất cả?\N- Tất cả ư?
Dialogue: 0,0:36:47.00,0:36:47.83,Default,,0,0,0,,Thật à?
Dialogue: 0,0:36:47.91,0:36:49.54,Default,,0,0,0,,Nghĩa là sao?
Dialogue: 0,0:36:49.62,0:36:51.37,Default,,0,0,0,,- Cô sẽ đi với cả ba.\N- Cả ba.
Dialogue: 0,0:36:51.46,0:36:53.42,Default,,0,0,0,,- Ghen tị quá.\N- Nghĩa là vậy à?
Dialogue: 0,0:36:53.50,0:36:55.67,Default,,0,0,0,,- Bốn chúng ta?\N- Hậu cung đảo ngược.
Dialogue: 0,0:36:57.13,0:36:58.05,Default,,0,0,0,,Khó đây.
Dialogue: 0,0:36:58.13,0:36:59.22,Default,,0,0,0,,Sẽ không dễ đâu.
Dialogue: 0,0:36:59.30,0:37:00.76,Default,,0,0,0,,- Chết mất.\N- Hikaru sẽ sao?
Dialogue: 0,0:37:00.84,0:37:03.26,Default,,0,0,0,,Các chàng trai sẽ biết\Ncô ấy thế nào với người kia.
Dialogue: 0,0:37:03.35,0:37:04.73,Default,,0,0,0,,Không giấu được nữa.
Dialogue: 0,0:37:05.56,0:37:06.77,Default,,0,0,0,,Nơi này là gì?
Dialogue: 0,0:37:06.85,0:37:07.77,Default,,0,0,0,,Làng Ryukyu.
Dialogue: 0,0:37:07.85,0:37:10.65,Default,,0,0,0,,Tuyệt, Ryukyu! Sao rồi, Shisa!
Dialogue: 0,0:37:10.73,0:37:11.65,Default,,0,0,0,,LÀNG RYUKYU
Dialogue: 0,0:37:14.82,0:37:15.95,Default,,0,0,0,,Chuẩn Okinawa.
Dialogue: 0,0:37:16.03,0:37:16.86,Default,,0,0,0,,- Ôi, trời.\N- Vãi.
Dialogue: 0,0:37:16.94,0:37:18.40,Default,,0,0,0,,- Đừng chạy.\N- Cứ như trẻ con!
Dialogue: 0,0:37:18.49,0:37:20.03,Default,,0,0,0,,Ăn mặc như thế thì đừng chạy.
Dialogue: 0,0:37:21.03,0:37:21.86,Default,,0,0,0,,Suýt toi!
Dialogue: 0,0:37:21.95,0:37:23.74,Default,,0,0,0,,Suýt toi. Suýt thì ngã.
Dialogue: 0,0:37:23.82,0:37:25.70,Default,,0,0,0,,Cẩn thận đó.
Dialogue: 0,0:37:27.29,0:37:30.00,Default,,0,0,0,,Chắc là họ sắp xếp gì đó\Ncho chúng ta ở đây.
Dialogue: 0,0:37:30.08,0:37:31.00,Default,,0,0,0,,Tô tượng shisa?
Dialogue: 0,0:37:31.08,0:37:32.29,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:37:32.38,0:37:33.55,Default,,0,0,0,,- Tô cái này?\N- Ra vậy.
Dialogue: 0,0:37:33.63,0:37:35.26,Default,,0,0,0,,- Hiểu rồi.\N- Tô mấy cái này.
Dialogue: 0,0:37:35.34,0:37:37.26,Default,,0,0,0,,Trang trí tượng shisa hả?
Dialogue: 0,0:37:37.76,0:37:41.60,Default,,0,0,0,,Con bên phải là đực.
Dialogue: 0,0:37:41.68,0:37:45.10,Default,,0,0,0,,Con bên trái là cái. Chúng là một cặp.
Dialogue: 0,0:37:45.18,0:37:48.68,Default,,0,0,0,,Để Hikaru chấm điểm con của ai đẹp nhất.
Dialogue: 0,0:37:48.77,0:37:49.60,Default,,0,0,0,,Được.
Dialogue: 0,0:37:49.68,0:37:51.31,Default,,0,0,0,,Đừng nghĩ nhiều. Theo cảm tính.
Dialogue: 0,0:38:04.95,0:38:07.49,Default,,0,0,0,,Đây là cách thể hiện bản thân của anh hả?
Dialogue: 0,0:38:07.58,0:38:08.42,Default,,0,0,0,,Phải, là tôi đó.
Dialogue: 0,0:38:08.49,0:38:09.66,Default,,0,0,0,,Hay đó. Tuyệt ghê.
Dialogue: 0,0:38:09.75,0:38:10.92,Default,,0,0,0,,Siêu hơn cả Picasso.
Dialogue: 0,0:38:11.75,0:38:13.00,Default,,0,0,0,,Hay không?
Dialogue: 0,0:38:13.08,0:38:14.33,Default,,0,0,0,,Chủ đề này là "Phẫn nộ".
Dialogue: 0,0:38:14.42,0:38:15.25,Default,,0,0,0,,Tuyệt quá.
Dialogue: 0,0:38:15.33,0:38:17.25,Default,,0,0,0,,Tai-chan khéo tay quá.
Dialogue: 0,0:38:17.34,0:38:21.14,Default,,0,0,0,,Chủ đề này là "Cảm xúc của tôi\Ndành cho Hikaru" thể hiện theo màu.
Dialogue: 0,0:38:21.22,0:38:22.64,Default,,0,0,0,,Vậy là anh làm theo cảm tính?
Dialogue: 0,0:38:22.72,0:38:23.85,Default,,0,0,0,,Không phải cảm tính.
Dialogue: 0,0:38:24.51,0:38:25.68,Default,,0,0,0,,"Màu sắc tôi yêu".
Dialogue: 0,0:38:25.76,0:38:27.05,Default,,0,0,0,,Ồ, thế à?
Dialogue: 0,0:38:27.60,0:38:29.02,Default,,0,0,0,,Vàng và xanh lá.
Dialogue: 0,0:38:29.10,0:38:31.89,Default,,0,0,0,,Đó là tác phẩm của người sáu mấy tuổi.
Dialogue: 0,0:38:31.98,0:38:32.94,Default,,0,0,0,,Thật đó.
Dialogue: 0,0:38:33.02,0:38:37.36,Default,,0,0,0,,Do người thấu hiểu\Nchủ nghĩa tối giản làm ra.
Dialogue: 0,0:38:37.44,0:38:40.07,Default,,0,0,0,,"Tốt hơn là không tô kín".
Dialogue: 0,0:38:40.15,0:38:43.11,Default,,0,0,0,,Cứ như cậu ấy đã tô\Nhàng nghìn cái rồi mới thế này.
Dialogue: 0,0:38:43.20,0:38:44.99,Default,,0,0,0,,Ừ, 10.000 cái.
Dialogue: 0,0:38:45.07,0:38:47.28,Default,,0,0,0,,Tiêu đề nữa,\N"Màu sắc tôi yêu". Sâu sắc quá.
Dialogue: 0,0:38:47.37,0:38:48.29,Default,,0,0,0,,- Phải.\N- Đúng.
Dialogue: 0,0:38:48.37,0:38:52.33,Default,,0,0,0,,Câu đó có thể hiểu theo nhiều ý khác nhau.
Dialogue: 0,0:38:52.41,0:38:53.70,Default,,0,0,0,,"Màu sắc tôi yêu"!
Dialogue: 0,0:38:53.79,0:38:55.67,Default,,0,0,0,,Thề là siêu tối giản.
Dialogue: 0,0:38:55.75,0:38:58.71,Default,,0,0,0,,Cô thấy con nào nghệ nhất?
Dialogue: 0,0:38:58.79,0:39:01.21,Default,,0,0,0,,Con đáng yêu nhất là…
Dialogue: 0,0:39:02.88,0:39:04.97,Default,,0,0,0,,- của Tai-chan.\N- Cảm ơn.
Dialogue: 0,0:39:05.05,0:39:06.13,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:39:06.22,0:39:10.98,Default,,0,0,0,,Đừng nghĩ nhiều quá,\Nnhưng tôi thích gu của Tai-chan.
Dialogue: 0,0:39:11.06,0:39:14.52,Default,,0,0,0,,Tôi đập được không? Tôi tức rồi đó.
Dialogue: 0,0:39:15.14,0:39:16.31,Default,,0,0,0,,Tôi đùa đó.
Dialogue: 0,0:39:17.61,0:39:22.74,Default,,0,0,0,,Nông trại chuối gần đây\Nđang thiếu bàn tay trẻ tuổi giúp đỡ.
Dialogue: 0,0:39:22.82,0:39:27.08,Default,,0,0,0,,Những người còn lại,\Nhãy tới nông trại chuối giúp đỡ.
Dialogue: 0,0:39:27.16,0:39:29.04,Default,,0,0,0,,- Chào buổi sáng.\N- Chào buổi sáng.
Dialogue: 0,0:39:29.12,0:39:30.25,Default,,0,0,0,,- Xin chào.\N- Xin chào.
Dialogue: 0,0:39:30.33,0:39:31.16,Default,,0,0,0,,ÔNG HENTONA
Dialogue: 0,0:39:31.24,0:39:32.08,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:39:32.16,0:39:33.16,Default,,0,0,0,,Chào chú.
Dialogue: 0,0:39:33.87,0:39:35.25,Default,,0,0,0,,Trùm cuối đây rồi.
Dialogue: 0,0:39:35.92,0:39:36.96,Default,,0,0,0,,Trong Dragon Quest.
Dialogue: 0,0:39:37.50,0:39:38.92,Default,,0,0,0,,Thần sắc ai cũng tốt quá.
Dialogue: 0,0:39:39.00,0:39:40.17,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:39:40.25,0:39:41.13,Default,,0,0,0,,Khỏe ghê.
Dialogue: 0,0:39:41.21,0:39:42.88,Default,,0,0,0,,Đàn ông được ôm.
Dialogue: 0,0:39:45.17,0:39:47.30,Default,,0,0,0,,Mong mấy đứa sẽ quay lại.
Dialogue: 0,0:39:47.39,0:39:48.77,Default,,0,0,0,,Ai là trưởng nhóm?
Dialogue: 0,0:39:48.84,0:39:49.67,Default,,0,0,0,,- Của cậu.\N- Dạ.
Dialogue: 0,0:39:49.76,0:39:50.89,Default,,0,0,0,,Đây.
Dialogue: 0,0:39:50.97,0:39:52.60,Default,,0,0,0,,- Ông Hentona.\N- Ừ.
Dialogue: 0,0:39:52.68,0:39:55.06,Default,,0,0,0,,"Ông Hentona từng là…"
Dialogue: 0,0:39:55.73,0:39:56.98,Default,,0,0,0,,- Đọc thế nào?\N- Bashofu.
Dialogue: 0,0:39:57.06,0:39:59.98,Default,,0,0,0,,"Được biết đến\Nlà làng vải dệt từ sợi tơ chuối…"
Dialogue: 0,0:40:00.06,0:40:01.02,Default,,0,0,0,,Làng Ogimi.
Dialogue: 0,0:40:02.07,0:40:03.66,Default,,0,0,0,,- Dai… Ogimi…\N- Để cậu ấy đọc.
Dialogue: 0,0:40:03.73,0:40:05.07,Default,,0,0,0,,Thử đọc đi.
Dialogue: 0,0:40:05.15,0:40:10.11,Default,,0,0,0,,"Ông đã cống hiến cả đời cho chuối,\Ncố gắng hồi sinh Làng Ogimi bằng chuối".
Dialogue: 0,0:40:12.24,0:40:17.50,Default,,0,0,0,,Ông Hentona đã dành mười năm qua\Nđể tự tay xây dựng nông trại chuối.
Dialogue: 0,0:40:17.58,0:40:18.79,Default,,0,0,0,,Tuyệt quá.
Dialogue: 0,0:40:18.87,0:40:22.71,Default,,0,0,0,,Hãy giúp ông Hentona làm việc nhé.
Dialogue: 0,0:40:24.09,0:40:25.97,Default,,0,0,0,,Biết chuối xa xỉ 1.000 yên một quả chứ?
Dialogue: 0,0:40:26.05,0:40:28.68,Default,,0,0,0,,Quả ăn được cả vỏ ấy.\NChúng được trồng ở đây.
Dialogue: 0,0:40:28.76,0:40:30.26,Default,,0,0,0,,- Thật ạ?\N- Chà.
Dialogue: 0,0:40:30.34,0:40:31.51,Default,,0,0,0,,Ăn được cả vỏ?
Dialogue: 0,0:40:31.60,0:40:32.48,Default,,0,0,0,,Đi nào!
Dialogue: 0,0:40:32.56,0:40:33.69,Default,,0,0,0,,Được ở đây thật vui.
Dialogue: 0,0:40:33.76,0:40:36.72,Default,,0,0,0,,Vặt lá khô đi như thế này.
Dialogue: 0,0:40:45.90,0:40:49.49,Default,,0,0,0,,Ông đã xây dựng nông trại này thế nào ạ?
Dialogue: 0,0:40:49.57,0:40:51.61,Default,,0,0,0,,Hồi trước nó là rừng cây như thế kia.
Dialogue: 0,0:40:51.70,0:40:52.53,Default,,0,0,0,,Thế ạ?
Dialogue: 0,0:40:52.62,0:40:54.08,Default,,0,0,0,,Toàn cây là cây.
Dialogue: 0,0:40:54.79,0:40:58.38,Default,,0,0,0,,Tôi dùng máy xúc đốn sạch.
Dialogue: 0,0:40:58.46,0:41:00.30,Default,,0,0,0,,Dọn sạch cả khu vực.
Dialogue: 0,0:41:00.37,0:41:01.20,Default,,0,0,0,,Một mình ông ạ?
Dialogue: 0,0:41:01.29,0:41:03.75,Default,,0,0,0,,- Một mình tôi.\N- Mình ông?
Dialogue: 0,0:41:03.84,0:41:04.72,Default,,0,0,0,,Thật ạ?
Dialogue: 0,0:41:04.80,0:41:05.84,Default,,0,0,0,,- Thật.\N- Vãi.
Dialogue: 0,0:41:05.92,0:41:07.17,Default,,0,0,0,,- Trời.\N- Đỉnh.
Dialogue: 0,0:41:07.26,0:41:08.85,Default,,0,0,0,,Bốn khu, mỗi khu 13.000 m2.
Dialogue: 0,0:41:08.92,0:41:09.92,Default,,0,0,0,,Một mình ông?
Dialogue: 0,0:41:10.01,0:41:11.22,Default,,0,0,0,,Một mình.
Dialogue: 0,0:41:11.30,0:41:13.26,Default,,0,0,0,,Vậy ông một mình chăm sóc 5.000 cây?
Dialogue: 0,0:41:13.35,0:41:14.89,Default,,0,0,0,,Ừ, mỗi ngày.
Dialogue: 0,0:41:15.56,0:41:16.94,Default,,0,0,0,,Ông ngủ vào lúc nào ạ?
Dialogue: 0,0:41:17.02,0:41:18.10,Default,,0,0,0,,- Ông ngủ không?\N- Có.
Dialogue: 0,0:41:18.18,0:41:20.72,Default,,0,0,0,,Nhưng ngày nào cũng có việc.\NTôi phải cắt cỏ nữa.
Dialogue: 0,0:41:20.81,0:41:22.40,Default,,0,0,0,,- Ông là nông dân.\N- Đúng.
Dialogue: 0,0:41:22.48,0:41:24.27,Default,,0,0,0,,- Hẳn là khó khăn lắm.\N- Nhỉ?
Dialogue: 0,0:41:24.36,0:41:25.45,Default,,0,0,0,,Từ từ, từng việc một.
Dialogue: 0,0:41:25.52,0:41:27.40,Default,,0,0,0,,- Phải.\N- Hầu như chẳng ai làm được.
Dialogue: 0,0:41:27.49,0:41:30.41,Default,,0,0,0,,Không ai lớn lên\Nvà to khỏe sau một đêm cả.
Dialogue: 0,0:41:30.49,0:41:33.20,Default,,0,0,0,,Ban đầu ai cũng yếu ớt.
Dialogue: 0,0:41:33.28,0:41:35.82,Default,,0,0,0,,- Thấm quá.\N- Phải.
Dialogue: 0,0:41:35.91,0:41:36.99,Default,,0,0,0,,Cố hết sức nha.
Dialogue: 0,0:41:37.08,0:41:38.50,Default,,0,0,0,,Ôi, áp lực quá! Sẽ cố!
Dialogue: 0,0:41:38.58,0:41:40.42,Default,,0,0,0,,Mình muốn lấy số để gọi hàng ngày.
Dialogue: 0,0:41:40.50,0:41:41.96,Default,,0,0,0,,Lát nữa tôi đưa cho.
Dialogue: 0,0:41:42.04,0:41:43.37,Default,,0,0,0,,Trời, ông khéo quá.
Dialogue: 0,0:41:43.46,0:41:44.92,Default,,0,0,0,,Mình muốn lấy số của ông.
Dialogue: 0,0:41:45.00,0:41:48.17,Default,,0,0,0,,Mấy đứa trông khỏe đó. Đào hố cho tôi nhé?
Dialogue: 0,0:41:48.26,0:41:49.60,Default,,0,0,0,,- Dạ.\N- Được ạ.
Dialogue: 0,0:42:01.89,0:42:03.31,Default,,0,0,0,,Mấy cậu trông như côn đồ.
Dialogue: 0,0:42:05.02,0:42:06.02,Default,,0,0,0,,Trông như vượt ngục.
Dialogue: 0,0:42:08.15,0:42:11.86,Default,,0,0,0,,Họ vượt ngục rồi. Bảo vệ bắt họ lại đi.
Dialogue: 0,0:42:11.95,0:42:13.12,Default,,0,0,0,,Không cần đâu.
Dialogue: 0,0:42:13.20,0:42:14.99,Default,,0,0,0,,Nóng quá.
Dialogue: 0,0:42:15.07,0:42:16.61,Default,,0,0,0,,Khó quá.
Dialogue: 0,0:42:16.70,0:42:20.58,Default,,0,0,0,,Ba hố một ngày. Mỗi hố sâu một mét.
Dialogue: 0,0:42:20.66,0:42:24.87,Default,,0,0,0,,Bốn năm qua, tôi đã đào 500 hố rồi.
Dialogue: 0,0:42:24.96,0:42:26.21,Default,,0,0,0,,- Năm trăm?\N- Ừ.
Dialogue: 0,0:42:26.29,0:42:29.67,Default,,0,0,0,,Ngày nào cũng đào. Từ sáng sớm.
Dialogue: 0,0:42:29.76,0:42:30.72,Default,,0,0,0,,- Đùa.\N- Một nửa rồi.
Dialogue: 0,0:42:30.80,0:42:31.93,Default,,0,0,0,,- Nửa?\N- Vâng.
Dialogue: 0,0:42:32.01,0:42:33.14,Default,,0,0,0,,- 50 cm hả?\N- Vâng.
Dialogue: 0,0:42:33.22,0:42:34.93,Default,,0,0,0,,- Giờ là 50.\N- Làm tốt đó.
Dialogue: 0,0:42:35.55,0:42:36.43,Default,,0,0,0,,Tốt lắm, Kazu-kun.
Dialogue: 0,0:42:36.51,0:42:38.68,Default,,0,0,0,,Cậu ấy làm thật đó.
Dialogue: 0,0:42:38.76,0:42:41.97,Default,,0,0,0,,Các cậu đều có kinh nghiệm\Nlàm công trường hả?
Dialogue: 0,0:42:42.06,0:42:43.31,Default,,0,0,0,,Cháu từng dựng dàn giáo.
Dialogue: 0,0:42:43.39,0:42:44.39,Default,,0,0,0,,- Dựng dàn giáo?\N- Dạ.
Dialogue: 0,0:42:44.48,0:42:46.07,Default,,0,0,0,,Cháu từng trải đường nhựa.
Dialogue: 0,0:42:46.15,0:42:47.57,Default,,0,0,0,,Ồ, thế hả? Ra vậy.
Dialogue: 0,0:42:47.65,0:42:50.24,Default,,0,0,0,,Còn Kazuma cũng dựng dàn giáo.
Dialogue: 0,0:42:50.32,0:42:51.70,Default,,0,0,0,,Ra vậy, cũng dựng dàn giáo.
Dialogue: 0,0:42:51.78,0:42:54.12,Default,,0,0,0,,- Asuka làm… phá dỡ nhỉ?\N- Phải.
Dialogue: 0,0:42:54.20,0:42:55.12,Default,,0,0,0,,- Thật à?\N- Thật.
Dialogue: 0,0:42:55.20,0:42:57.04,Default,,0,0,0,,- Chuẩn.\N- Cậu đoán đúng rồi đó.
Dialogue: 0,0:42:58.24,0:43:02.45,Default,,0,0,0,,Ta sẽ trồng một cây chuối ở đây\Nđể đánh dấu ngày hôm nay.
Dialogue: 0,0:43:02.54,0:43:03.46,Default,,0,0,0,,- Tuyệt.\N- Hay.
Dialogue: 0,0:43:07.13,0:43:08.21,Default,,0,0,0,,Chà, giỏi quá.
Dialogue: 0,0:43:08.29,0:43:09.62,Default,,0,0,0,,Giỏi ghê!
Dialogue: 0,0:43:13.42,0:43:15.76,Default,,0,0,0,,Xong rồi. Giỏi lắm, mọi người.
Dialogue: 0,0:43:15.84,0:43:16.80,Default,,0,0,0,,- Lớn mau.\N- Cảm ơn.
Dialogue: 0,0:43:16.89,0:43:18.31,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:43:18.39,0:43:19.52,Default,,0,0,0,,Chuối joto?
Dialogue: 0,0:43:19.60,0:43:20.43,Default,,0,0,0,,Chuối joto.
Dialogue: 0,0:43:20.51,0:43:22.05,Default,,0,0,0,,Giờ gọi nó là chuối Joto hả?
Dialogue: 0,0:43:22.14,0:43:24.23,Default,,0,0,0,,- Hay nhỉ?\N- Thích luôn.
Dialogue: 0,0:43:24.31,0:43:25.69,Default,,0,0,0,,- Ăn nào.\N- Cảm ơn.
Dialogue: 0,0:43:26.48,0:43:27.40,Default,,0,0,0,,Chuối cao cấp.
Dialogue: 0,0:43:27.48,0:43:28.86,Default,,0,0,0,,- Tuyệt quá.\N- Ngon.
Dialogue: 0,0:43:28.94,0:43:31.48,Default,,0,0,0,,Tôi trồng 13 giống chuối ở đây.
Dialogue: 0,0:43:31.98,0:43:35.11,Default,,0,0,0,,Có chuối táo, chuối kem,\Nchuối Namwa đá và nhiều loại khác.
Dialogue: 0,0:43:35.20,0:43:36.70,Default,,0,0,0,,Đây là chuối huyền thoại.
Dialogue: 0,0:43:36.78,0:43:39.53,Default,,0,0,0,,Ồ, giống đó chỉ được trông ở đây ạ?
Dialogue: 0,0:43:39.62,0:43:41.08,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:43:41.16,0:43:42.33,Default,,0,0,0,,Ngon tuyệt.
Dialogue: 0,0:43:42.41,0:43:43.70,Default,,0,0,0,,Tôi muốn thử. Cho tôi!
Dialogue: 0,0:43:43.79,0:43:45.63,Default,,0,0,0,,- Ngon tuyệt!\N- Chính nó!
Dialogue: 0,0:43:45.71,0:43:48.17,Default,,0,0,0,,Làm trẻ trâu khiến mấy đứa mạnh mẽ.
Dialogue: 0,0:43:48.25,0:43:50.96,Default,,0,0,0,,Đặc biệt là đàn ông. Ta trở nên gan góc.
Dialogue: 0,0:43:52.13,0:43:56.43,Default,,0,0,0,,Tôi cũng từng là dân tổ\Nhồi thập niên 1980.
Dialogue: 0,0:43:56.51,0:44:00.81,Default,,0,0,0,,Hồi trẻ tôi cũng nổi loạn như các cậu.\NTôi có hội cả nghìn người.
Dialogue: 0,0:44:00.89,0:44:02.10,Default,,0,0,0,,- Chà!\N- Phải.
Dialogue: 0,0:44:02.18,0:44:07.52,Default,,0,0,0,,Cũng như cô cậu, tôi đánh nhau\Nrồi làm đủ trò hư hỏng.
Dialogue: 0,0:44:08.10,0:44:09.81,Default,,0,0,0,,Nhưng đánh nhau chẳng có ích gì.
Dialogue: 0,0:44:10.40,0:44:12.53,Default,,0,0,0,,Rốt cuộc, tình yêu vẫn luôn thắng thế.
Dialogue: 0,0:44:13.44,0:44:16.94,Default,,0,0,0,,Đàn ông ngầu nhất khi họ dịu dàng.\NTôi nói rõ đấy nhé.
Dialogue: 0,0:44:17.03,0:44:20.49,Default,,0,0,0,,Không được bạo lực với chị em.\NCác cậu hiểu vì sao sai chứ?
Dialogue: 0,0:44:20.57,0:44:25.20,Default,,0,0,0,,Đơn giản thôi,\Nđánh phụ nữ là hành vi rác rưởi.
Dialogue: 0,0:44:25.29,0:44:29.29,Default,,0,0,0,,Đàn ông như thế cần được dạy bảo.\NMang đến đây cho tôi. Tôi tẩn cho.
Dialogue: 0,0:44:29.38,0:44:30.96,Default,,0,0,0,,- Ngầu quá.\N- Phải.
Dialogue: 0,0:44:31.04,0:44:31.87,Default,,0,0,0,,Đến thăm được ạ?
Dialogue: 0,0:44:31.96,0:44:34.55,Default,,0,0,0,,Đương nhiên. Lúc nào cũng chào đón.
Dialogue: 0,0:44:34.63,0:44:37.13,Default,,0,0,0,,Nếu thích Okinawa,\Nhãy ghé thăm lần nữa nhé.
Dialogue: 0,0:44:37.72,0:44:41.47,Default,,0,0,0,,Ông ấy lớn lên ở thời kỳ\Nmà mọi thứ giải quyết bằng vũ lực.
Dialogue: 0,0:44:41.55,0:44:44.18,Default,,0,0,0,,Vậy mà ông ấy nói như vậy.\NTôi thấy thật ngầu.
Dialogue: 0,0:44:44.26,0:44:46.72,Default,,0,0,0,,Lúc ông bảo: "Quay lại lúc nào cũng được",
Dialogue: 0,0:44:46.81,0:44:50.15,Default,,0,0,0,,tôi thấy rất vui,\Nvì tôi chưa từng có tổ ấm.
Dialogue: 0,0:44:50.23,0:44:54.32,Default,,0,0,0,,Tôi muốn gặp lại ông. Ông làm tôi rất vui.
Dialogue: 0,0:44:54.86,0:44:56.53,Default,,0,0,0,,Cô ấy phải lòng ông chú rồi à?
Dialogue: 0,0:44:57.82,0:45:00.78,Default,,0,0,0,,Khoan, sắp có thành viên mới hả?
Dialogue: 0,0:45:00.86,0:45:02.03,Default,,0,0,0,,- Phải.\N- Ông chú?
Dialogue: 0,0:45:02.57,0:45:04.86,Default,,0,0,0,,- Học sinh chuyển trường.\N- Chuyển trường.
Dialogue: 0,0:45:04.95,0:45:07.04,Default,,0,0,0,,- Cô ấy mở lòng với ông Hentona.\N- Khoan.
Dialogue: 0,0:45:07.12,0:45:09.75,Default,,0,0,0,,Chương trình đi theo hướng đó đấy à?
Dialogue: 0,0:45:11.08,0:45:11.91,Default,,0,0,0,,Em không biết.
Dialogue: 0,0:45:12.00,0:45:15.05,Default,,0,0,0,,Anh xem hết thì nghĩ\Nđến giờ trồng chuối rồi.
Dialogue: 0,0:45:15.13,0:45:17.63,Default,,0,0,0,,Anh thấy quả là một ông chú dễ chịu.
Dialogue: 0,0:45:17.71,0:45:18.92,Default,,0,0,0,,Đừng mất cảnh giác.
Dialogue: 0,0:45:19.01,0:45:20.05,Default,,0,0,0,,Sao có thể không?
Dialogue: 0,0:45:20.13,0:45:23.51,Default,,0,0,0,,Ông ấy cứ làm anh phải đề phòng.\NĐây là Tình yêu nổi loạn.
Dialogue: 0,0:45:23.60,0:45:27.40,Default,,0,0,0,,Anh không muốn\Nthấy ông Hentona quyến rũ ai đâu.
Dialogue: 0,0:45:27.47,0:45:29.76,Default,,0,0,0,,Có khi được thấy ông ấy đi xông hơi.
Dialogue: 0,0:45:29.85,0:45:30.85,Default,,0,0,0,,Có khi có hoặc không.
Dialogue: 0,0:45:30.94,0:45:32.40,Default,,0,0,0,,- Ông Hentona.\N- Có khả năng.
Dialogue: 0,0:45:32.48,0:45:37.32,Default,,0,0,0,,"Đến giờ xông hơi rồi.\NHôm nay ông Hentona làm việc vất vả nhất".
Dialogue: 0,0:45:38.57,0:45:40.11,Default,,0,0,0,,"Ông Hentona…"
Dialogue: 0,0:45:40.99,0:45:43.12,Default,,0,0,0,,Xin chào. Thật vui được gặp.
Dialogue: 0,0:45:43.20,0:45:46.75,Default,,0,0,0,,Đẹp quá. Đây là công viên gì?
Dialogue: 0,0:45:48.83,0:45:50.00,Default,,0,0,0,,Chà.
Dialogue: 0,0:45:53.21,0:45:54.88,Default,,0,0,0,,Này, sao rồi.
Dialogue: 0,0:45:55.63,0:45:57.30,Default,,0,0,0,,Đẹp đó.
Dialogue: 0,0:45:57.38,0:45:58.42,Default,,0,0,0,,Thật đó.
Dialogue: 0,0:45:59.17,0:46:02.21,Default,,0,0,0,,Thích quá đi.
Dialogue: 0,0:46:02.89,0:46:06.69,Default,,0,0,0,,Chà! Hay quá!
Dialogue: 0,0:46:10.73,0:46:12.27,Default,,0,0,0,,Chuyện này khó quá.
Dialogue: 0,0:46:13.81,0:46:18.90,Default,,0,0,0,,Tình cảm của tôi chưa đủ rõ ràng sao?
Dialogue: 0,0:46:19.61,0:46:23.99,Default,,0,0,0,,Tôi cứ hỏi cô thế nào,\Ncó thích ai không các thứ.
Dialogue: 0,0:46:24.78,0:46:26.45,Default,,0,0,0,,Lúc tôi hỏi,
Dialogue: 0,0:46:26.53,0:46:30.53,Default,,0,0,0,,cô bảo: "Không, tôi vẫn chưa quyết định".
Dialogue: 0,0:46:30.62,0:46:34.62,Default,,0,0,0,,Trước khi phải lòng ai,\Ncô phải có hứng thú với người ta đã.
Dialogue: 0,0:46:34.71,0:46:39.38,Default,,0,0,0,,Ở đây được một nửa thời gian rồi,\Nmà cô vẫn chưa có hứng thú với ai.
Dialogue: 0,0:46:39.46,0:46:44.17,Default,,0,0,0,,Điều đó làm tôi lo mọi thứ sẽ kết thúc\Ntrước khi chúng ta đi được đến đâu.
Dialogue: 0,0:46:44.26,0:46:49.18,Default,,0,0,0,,Tôi muốn biết\Nliệu cô có tiến triển gì không.
Dialogue: 0,0:46:49.68,0:46:54.73,Default,,0,0,0,,Đến hôm qua, tôi đã khoanh vùng rồi.
Dialogue: 0,0:46:54.81,0:46:57.90,Default,,0,0,0,,Tôi muốn chọn giữa anh và Tai-chan.
Dialogue: 0,0:46:59.32,0:47:01.36,Default,,0,0,0,,Tôi cũng có lý do.
Dialogue: 0,0:47:01.44,0:47:05.61,Default,,0,0,0,,Nghe nói Bo đã từng dùng vũ lực.
Dialogue: 0,0:47:05.70,0:47:08.12,Default,,0,0,0,,Tôi nghĩ thói đó không sửa được.
Dialogue: 0,0:47:08.20,0:47:11.33,Default,,0,0,0,,Đến lúc đó,\NBo bị loại khỏi danh sách rồi.
Dialogue: 0,0:47:13.54,0:47:16.79,Default,,0,0,0,,Tôi định nói với Bo chuyện đó hôm nay.
Dialogue: 0,0:47:16.88,0:47:21.26,Default,,0,0,0,,Cô sẽ bảo với cậu ta,\Nrồi chọn giữa hai chúng tôi hả?
Dialogue: 0,0:47:21.34,0:47:27.30,Default,,0,0,0,,Từ chối Bo rồi cân nhắc\Ngiữa Taisei và tôi. Nghe mà vui quá.
Dialogue: 0,0:47:31.14,0:47:33.98,Default,,0,0,0,,Này. Sao rồi?
Dialogue: 0,0:47:34.06,0:47:37.98,Default,,0,0,0,,Hai người nói chuyện đi.\NTôi đang bận uống trà đá.
Dialogue: 0,0:47:39.15,0:47:39.99,Default,,0,0,0,,Vậy?
Dialogue: 0,0:47:40.07,0:47:42.57,Default,,0,0,0,,Chúng ta đi được một nửa rồi.
Dialogue: 0,0:47:42.65,0:47:44.36,Default,,0,0,0,,- Đúng vậy.\N- Nhỉ?
Dialogue: 0,0:47:44.95,0:47:46.33,Default,,0,0,0,,Liệu cô ấy có thành thật?
Dialogue: 0,0:47:46.41,0:47:49.87,Default,,0,0,0,,Hôm nay, tôi muốn nói với anh một chuyện.
Dialogue: 0,0:47:49.95,0:47:53.29,Default,,0,0,0,,Có chuyện này tôi muốn đề cập…\Nhay đúng hơn là hỏi anh.
Dialogue: 0,0:47:53.37,0:47:54.87,Default,,0,0,0,,- Ồ, hỏi tôi?\N- Được.
Dialogue: 0,0:47:55.46,0:47:58.67,Default,,0,0,0,,Nghe nói anh từng đánh phụ nữ.
Dialogue: 0,0:47:59.59,0:48:06.56,Default,,0,0,0,,Thật ra, bố tôi là kẻ bạo hành.\NCòn hơn cả đánh đấm vớ vẩn và tát.
Dialogue: 0,0:48:06.63,0:48:10.72,Default,,0,0,0,,Ông ta đòi mát-xa và sẽ động tay\Nnếu không được như ý. Dã man lắm.
Dialogue: 0,0:48:10.80,0:48:15.89,Default,,0,0,0,,Cá nhân tôi, dù là lý do gì,
Dialogue: 0,0:48:15.98,0:48:21.61,Default,,0,0,0,,tôi không thể hẹn hò\Nvới người đánh phụ nữ.
Dialogue: 0,0:48:23.78,0:48:28.99,Default,,0,0,0,,Hôm qua, tôi đã nghĩ rằng\Nanh không còn trong danh sách của tôi nữa.
Dialogue: 0,0:48:30.41,0:48:36.50,Default,,0,0,0,,Nhưng hôm nay, trong lần hẹn nhóm này,
Dialogue: 0,0:48:37.37,0:48:39.96,Default,,0,0,0,,tôi chỉ thấy những điểm tốt đẹp ở anh.
Dialogue: 0,0:48:40.04,0:48:40.92,Default,,0,0,0,,Hả?
Dialogue: 0,0:48:41.00,0:48:45.50,Default,,0,0,0,,Tôi nhận ra anh cũng có sức hút riêng.
Dialogue: 0,0:48:45.59,0:48:46.67,Default,,0,0,0,,Phải.
Dialogue: 0,0:48:46.76,0:48:52.10,Default,,0,0,0,,Sức hút của riêng anh\Nmà Ari hay Tai-chan đều không có.
Dialogue: 0,0:48:52.18,0:48:53.10,Default,,0,0,0,,Phải.
Dialogue: 0,0:48:53.18,0:48:54.93,Default,,0,0,0,,Phù! Tôi tưởng cô từ chối tôi cơ.
Dialogue: 0,0:48:55.02,0:48:56.19,Default,,0,0,0,,Không.
Dialogue: 0,0:48:56.68,0:48:58.31,Default,,0,0,0,,Tôi muốn nói rõ chuyện đó.
Dialogue: 0,0:48:58.39,0:48:59.35,Default,,0,0,0,,Phải.
Dialogue: 0,0:48:59.85,0:49:02.44,Default,,0,0,0,,- Tôi muốn nói rõ.\N- Ừ.
Dialogue: 0,0:49:07.49,0:49:09.45,Default,,0,0,0,,- Cô ấy dắt mũi cậu ấy rồi.\N- Ừ.
Dialogue: 0,0:49:09.53,0:49:12.33,Default,,0,0,0,,Cô ấy đổi giọng giữa Ari và Bo.
Dialogue: 0,0:49:12.41,0:49:14.16,Default,,0,0,0,,Họ sẽ phát hiện ra thôi.
Dialogue: 0,0:49:17.58,0:49:22.96,Default,,0,0,0,,Tôi không thể tìm hiểu toàn bộ quá khứ\Ncủa anh, nhưng tôi nghĩ ta giống nhau.
Dialogue: 0,0:49:23.04,0:49:23.96,Default,,0,0,0,,Thế hả?
Dialogue: 0,0:49:24.46,0:49:25.29,Default,,0,0,0,,Xong chưa?
Dialogue: 0,0:49:25.38,0:49:27.01,Default,,0,0,0,,- Giật cả mình.\N- Chưa xong hả?
Dialogue: 0,0:49:27.51,0:49:28.59,Default,,0,0,0,,Chưa đủ thời gian.
Dialogue: 0,0:49:28.67,0:49:29.59,Default,,0,0,0,,Chưa đủ thời gian?
Dialogue: 0,0:49:29.68,0:49:33.52,Default,,0,0,0,,Ý tôi không phải vậy.\NTôi cũng muốn nói chuyện với Tai-chan.
Dialogue: 0,0:49:34.26,0:49:35.43,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:49:39.39,0:49:42.02,Default,,0,0,0,,Tôi đã chia sẻ suy nghĩ với từng người.
Dialogue: 0,0:49:42.10,0:49:43.98,Default,,0,0,0,,Được. Nói đi.
Dialogue: 0,0:49:44.06,0:49:46.40,Default,,0,0,0,,Mấy người đều có khiếm khuyết.
Dialogue: 0,0:49:46.48,0:49:48.07,Default,,0,0,0,,Phải, tôi hiểu mà.
Dialogue: 0,0:49:48.15,0:49:50.74,Default,,0,0,0,,Và mỗi người đều có sức hút riêng.
Dialogue: 0,0:49:50.82,0:49:52.36,Default,,0,0,0,,- Ồ, vậy hả?\N- Đúng chứ?
Dialogue: 0,0:49:52.45,0:49:54.83,Default,,0,0,0,,Tôi cũng nói vậy với Ari,
Dialogue: 0,0:49:55.33,0:49:57.58,Default,,0,0,0,,nhưng tôi thấy\Nanh ấy và tôi chỉ làm bạn thôi.
Dialogue: 0,0:49:57.66,0:49:59.50,Default,,0,0,0,,Ồ, vậy hả?
Dialogue: 0,0:49:59.58,0:50:02.33,Default,,0,0,0,,Với Bo, quá khứ bạo lực\Ncũng khiến tôi khó chịu.
Dialogue: 0,0:50:02.42,0:50:04.30,Default,,0,0,0,,Ồ, phải, tôi nghe nói rồi.
Dialogue: 0,0:50:04.38,0:50:05.38,Default,,0,0,0,,Tôi thấy khó chịu.
Dialogue: 0,0:50:05.46,0:50:07.75,Default,,0,0,0,,Còn với cậu…
Dialogue: 0,0:50:07.84,0:50:08.67,Default,,0,0,0,,Đến lượt tôi rồi.
Dialogue: 0,0:50:08.76,0:50:10.10,Default,,0,0,0,,- Mãi mới đến.\N- Mãi mới đến.
Dialogue: 0,0:50:10.17,0:50:13.26,Default,,0,0,0,,Cậu tỏa ra năng lượng nhẹ nhàng.
Dialogue: 0,0:50:13.34,0:50:14.17,Default,,0,0,0,,Phải.
Dialogue: 0,0:50:14.26,0:50:16.05,Default,,0,0,0,,- Cách cậu nói chuyện.\N- Thế à?
Dialogue: 0,0:50:16.14,0:50:18.06,Default,,0,0,0,,Tôi từng không thích đâu.
Dialogue: 0,0:50:18.14,0:50:19.64,Default,,0,0,0,,- Thế á?\N- Nhưng giờ hết rồi.
Dialogue: 0,0:50:19.73,0:50:21.57,Default,,0,0,0,,Ồ, thế à? Cô nghĩ vậy à?
Dialogue: 0,0:50:21.64,0:50:23.85,Default,,0,0,0,,Lúc điều đó biến mất,
Dialogue: 0,0:50:24.86,0:50:29.03,Default,,0,0,0,,thì cậu trở thành người\Ncó tiềm năng làm người yêu nhất.
Dialogue: 0,0:50:29.11,0:50:30.32,Default,,0,0,0,,Hả?
Dialogue: 0,0:50:32.15,0:50:33.48,Default,,0,0,0,,Nói lại được không?
Dialogue: 0,0:50:33.57,0:50:36.66,Default,,0,0,0,,Tôi thấy cậu có tiềm năng\Nlàm người yêu nhất.
Dialogue: 0,0:50:38.83,0:50:45.25,Default,,0,0,0,,Đúng vãi. Đùa đó.\NCảm ơn vì đã nói thế, thật đấy.
Dialogue: 0,0:50:45.33,0:50:48.50,Default,,0,0,0,,Từ đầu tôi đã thấy cậu chuẩn gu tôi rồi.
Dialogue: 0,0:50:48.59,0:50:49.67,Default,,0,0,0,,- Tôi?\N- Ăn mặc nữa.
Dialogue: 0,0:50:49.76,0:50:50.59,Default,,0,0,0,,Ồ, vậy hả?
Dialogue: 0,0:50:50.67,0:50:56.09,Default,,0,0,0,,Lúc cậu cười đùa với anh em,\Ntôi kiểu: "Tai-chan nóng bỏng phết".
Dialogue: 0,0:50:56.18,0:50:57.39,Default,,0,0,0,,Đúng nhỉ?
Dialogue: 0,0:50:58.10,0:51:00.02,Default,,0,0,0,,Ari nói nhiều dã man.
Dialogue: 0,0:51:00.10,0:51:02.69,Default,,0,0,0,,Anh ta cứ lảm nhảm mãi\Nvà tôi không hiểu gì cả.
Dialogue: 0,0:51:02.77,0:51:04.77,Default,,0,0,0,,Hikaru!
Dialogue: 0,0:51:06.27,0:51:08.90,Default,,0,0,0,,Nhưng tôi rất vui\Nkhi được nghe cảm xúc thật của cô.
Dialogue: 0,0:51:08.98,0:51:14.28,Default,,0,0,0,,Mừng là tôi có được câu trả lời thẳng thắn\Nthay vì bắt cô nói chuyện dài dòng.
Dialogue: 0,0:51:14.36,0:51:16.36,Default,,0,0,0,,Thực sự tôi thấy vui lắm.
Dialogue: 0,0:51:17.87,0:51:21.79,Default,,0,0,0,,Tôi biết cuối cùng mình sẽ thắng mà.
Dialogue: 0,0:51:21.87,0:51:23.54,Default,,0,0,0,,Thật đó.
Dialogue: 0,0:51:24.04,0:51:25.63,Default,,0,0,0,,Tôi lường được trước rồi.
Dialogue: 0,0:51:28.84,0:51:30.38,Default,,0,0,0,,Phải là tôi mới được.
Dialogue: 0,0:51:34.26,0:51:36.93,Default,,0,0,0,,Chị muốn nghe ý kiến của Thám tử.
Dialogue: 0,0:51:37.01,0:51:41.14,Default,,0,0,0,,Hikaru nghĩ gì khi cô ấy\Nnói chuyện với ba người họ như vậy?
Dialogue: 0,0:51:41.22,0:51:44.26,Default,,0,0,0,,Được nhiều người thích\Nrất sướng, đúng chứ?
Dialogue: 0,0:51:44.35,0:51:45.23,Default,,0,0,0,,Hẳn là thế.
Dialogue: 0,0:51:45.31,0:51:47.35,Default,,0,0,0,,Hiện có nhiều người mến cô ấy nhất.
Dialogue: 0,0:51:47.44,0:51:51.53,Default,,0,0,0,,Cô ấy muốn duy trì điều này\Ncàng lâu càng tốt, có lẽ vậy.
Dialogue: 0,0:51:51.61,0:51:52.44,Default,,0,0,0,,Ồ, vậy sao?
Dialogue: 0,0:51:52.53,0:51:56.58,Default,,0,0,0,,Nhưng nếu cứ làm thế,\Nkiểu gì cũng bị gậy ông đập lưng ông.
Dialogue: 0,0:51:56.66,0:51:57.79,Default,,0,0,0,,- Nhỉ?\N- Đúng.
Dialogue: 0,0:51:59.20,0:52:01.12,Default,,0,0,0,,- Hút thuốc nha.\N- Ừ, đi thôi.
Dialogue: 0,0:52:02.33,0:52:06.50,Default,,0,0,0,,Tôi sợ xem điện thoại\Nsau khi chuyện này kết thúc quá.
Dialogue: 0,0:52:06.58,0:52:08.25,Default,,0,0,0,,Tôi cũng thế, thật đó.
Dialogue: 0,0:52:08.33,0:52:11.08,Default,,0,0,0,,Hiện thực sẽ quay lại vả vào mặt chúng ta.
Dialogue: 0,0:52:11.17,0:52:14.67,Default,,0,0,0,,Thế nên tôi mới có thể quyết định được.
Dialogue: 0,0:52:15.38,0:52:16.84,Default,,0,0,0,,Tôi sẽ chọn cô, Asuka.
Dialogue: 0,0:52:17.34,0:52:18.34,Default,,0,0,0,,Chọn tôi?
Dialogue: 0,0:52:21.39,0:52:22.77,Default,,0,0,0,,Tôi mặc kệ chuyện gì xảy ra.
Dialogue: 0,0:52:22.85,0:52:23.98,Default,,0,0,0,,Hôn không?
Dialogue: 0,0:52:24.06,0:52:25.10,Default,,0,0,0,,- Hả?\N- Trời.
Dialogue: 0,0:52:25.18,0:52:26.43,Default,,0,0,0,,Liệu có bị đuổi học không?
Dialogue: 0,0:52:26.52,0:52:27.90,Default,,0,0,0,,Có đấy.
Dialogue: 0,0:52:32.52,0:52:36.65,Default,,0,0,0,,Nhưng mà cái chính là\Ntôi không dễ tin tưởng người khác.
Dialogue: 0,0:52:36.74,0:52:38.16,Default,,0,0,0,,Vì tôi sợ bị phản bội.
Dialogue: 0,0:52:38.24,0:52:40.95,Default,,0,0,0,,- Phải.\N- Nhưng cứ đâm sau lưng tôi đi.
Dialogue: 0,0:52:41.03,0:52:44.24,Default,,0,0,0,,Tôi muốn biết cảm giác. Thử đi.
Dialogue: 0,0:52:44.74,0:52:46.49,Default,,0,0,0,,Cậu nói thế thật với tôi đấy à?
Dialogue: 0,0:52:47.21,0:52:48.04,Default,,0,0,0,,Ừ.
Dialogue: 0,0:52:49.29,0:52:50.96,Default,,0,0,0,,Không có cách nào biết chắc mà.
Dialogue: 0,0:52:52.09,0:52:54.01,Default,,0,0,0,,Vậy cậu để tôi quyết định hết?
Dialogue: 0,0:52:54.09,0:52:55.55,Default,,0,0,0,,Không hẳn là thế.
Dialogue: 0,0:52:55.63,0:52:56.76,Default,,0,0,0,,Tôi chỉ…
Dialogue: 0,0:52:56.84,0:52:58.80,Default,,0,0,0,,Sau những gì tôi…
Dialogue: 0,0:53:02.68,0:53:04.81,Default,,0,0,0,,Sau việc tôi chân thật với cảm xúc hả?
Dialogue: 0,0:53:08.73,0:53:09.94,Default,,0,0,0,,Được rồi, tôi sai rồi.
Dialogue: 0,0:53:10.02,0:53:14.27,Default,,0,0,0,,Tôi là người cuối cùng\Ncậu muốn gây sự đấy nhé.
Dialogue: 0,0:53:14.86,0:53:18.20,Default,,0,0,0,,Tôi luôn thẳng thắn với cậu mà.
Dialogue: 0,0:53:20.32,0:53:22.91,Default,,0,0,0,,Tôi sai rồi. Tôi xin rút lại.
Dialogue: 0,0:53:24.70,0:53:30.37,Default,,0,0,0,,Ngoài lá thư trong ngày đầu tiên,\Nchỉ có tôi là đơn phương với cậu ấy.
Dialogue: 0,0:53:30.46,0:53:36.13,Default,,0,0,0,,Tôi viết thư cho cậu ấy, tôi thắng kéo co\Nrồi chọn cậu ấy đi hẹn hò.
Dialogue: 0,0:53:36.21,0:53:41.84,Default,,0,0,0,,Đến thế rồi\Nmà cậu ấy vẫn không đáp lại tình cảm,
Dialogue: 0,0:53:41.93,0:53:46.52,Default,,0,0,0,,thì cuối cùng\Ntôi sẽ ngừng chờ đợi và bước tiếp.
Dialogue: 0,0:53:47.85,0:53:49.77,Default,,0,0,0,,Cô vẫn dây đưa với chúng tôi hả?
Dialogue: 0,0:53:49.85,0:53:51.52,Default,,0,0,0,,Đó là điều tôi muốn tránh.
Dialogue: 0,0:53:51.60,0:53:54.52,Default,,0,0,0,,Nhưng ta đã nói rõ rồi,\Nvà trông có vẻ là như thế.
Dialogue: 0,0:53:55.48,0:53:56.31,Default,,0,0,0,,Hả?
Dialogue: 0,0:53:57.03,0:53:58.45,Default,,0,0,0,,Ôi, không…
Dialogue: 0,0:54:02.86,0:54:05.36,Default,,0,0,0,,- Khoan! Chuyện gì đây?\N- Ôi, không!
Dialogue: 0,0:54:05.45,0:54:06.87,Default,,0,0,0,,Họ khóc dữ quá!
Dialogue: 0,0:54:06.95,0:54:09.33,Default,,0,0,0,,Khoan đã, lúc cuối là sao vậy?
Dialogue: 0,0:54:10.54,0:54:13.46,Default,,0,0,0,,Anh biết rồi.\NHẳn là ông Hentona đã xuất hiện.
Dialogue: 0,0:54:13.96,0:54:15.42,Default,,0,0,0,,Làm họ sợ chết khiếp.
Dialogue: 0,0:54:15.50,0:54:18.63,Default,,0,0,0,,Họ kiểu: "Sợ quá" đến mức bật khóc.
Dialogue: 0,0:54:18.71,0:54:20.88,Default,,0,0,0,,Học cách xem chương trình hẹn hò đi ạ.
Dialogue: 0,0:54:30.18,0:54:35.19,Default,,0,0,0,,Biên dịch: Trang Tran
