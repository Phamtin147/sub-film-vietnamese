Dialogue: 0,0:00:06.01,0:00:09.30,Default,,0,0,0,,Tôi nghe chuyện rồi,\Nthấy bực nên tới mắng cậu đây.
Dialogue: 0,0:00:09.38,0:00:10.46,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:00:10.55,0:00:12.47,Default,,0,0,0,,TAI-CHAN (22)\NNHÀ TẠO MẪU TÓC
Dialogue: 0,0:00:12.55,0:00:15.89,Default,,0,0,0,,Cậu nhận được thư vào ngày đầu tiên nhỉ?
Dialogue: 0,0:00:15.97,0:00:17.81,Default,,0,0,0,,Cậu thấy vui chứ?
Dialogue: 0,0:00:17.89,0:00:19.93,Default,,0,0,0,,- Vui.\N- Vui, đúng không?
Dialogue: 0,0:00:20.02,0:00:21.23,Default,,0,0,0,,ASSUN\NDOANH NHÂN/TIẾP VIÊN
Dialogue: 0,0:00:21.31,0:00:25.19,Default,,0,0,0,,Cậu đã làm cô ấy buồn\Nvì cậu chẳng nói gì về chuyện đó đấy.
Dialogue: 0,0:00:25.28,0:00:26.11,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:00:27.94,0:00:30.94,Default,,0,0,0,,Cậu không thấy\Ncậu nợ Maririn ít nhất một câu trả lời à?
Dialogue: 0,0:00:31.03,0:00:32.74,Default,,0,0,0,,Chia sẻ với cô ấy đi.
Dialogue: 0,0:00:32.82,0:00:33.65,Default,,0,0,0,,Phải.
Dialogue: 0,0:00:35.04,0:00:37.79,Default,,0,0,0,,Không ai phải lòng\Nngười không thể thành thật.
Dialogue: 0,0:00:37.87,0:00:39.04,Default,,0,0,0,,Phải.
Dialogue: 0,0:00:39.12,0:00:41.96,Default,,0,0,0,,Lúc nghe kể, tôi thấy\Ncậu không đáng mặt đàn ông.
Dialogue: 0,0:00:42.04,0:00:46.04,Default,,0,0,0,,Chúng tôi luôn tìm\Nđàn ông đích thực để yêu,
Dialogue: 0,0:00:46.13,0:00:48.26,Default,,0,0,0,,và đến để tìm đàn ông đích thực.
Dialogue: 0,0:00:48.34,0:00:49.18,Default,,0,0,0,,RURU\NNGƯỜI MẪU
Dialogue: 0,0:00:49.26,0:00:52.26,Default,,0,0,0,,Hiện tại, chúng tôi cảm thấy\Nkhông cần người như cậu.
Dialogue: 0,0:00:56.47,0:00:58.97,Default,,0,0,0,,Tìm hiểu nhiều người không sao,\Nnhưng cư xử cho đúng.
Dialogue: 0,0:00:59.06,0:00:59.89,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:00:59.98,0:01:02.94,Default,,0,0,0,,Hơn nữa, Maririn có những vết thương\Ntừ các mối tình cũ.
Dialogue: 0,0:01:03.02,0:01:03.94,Default,,0,0,0,,MARIRIN\NPHỤC VỤ BAR
Dialogue: 0,0:01:04.02,0:01:05.48,Default,,0,0,0,,Hôm nay cậu nghe rồi đó.
Dialogue: 0,0:01:05.57,0:01:08.74,Default,,0,0,0,,Cậu cười nhạo quá khứ\Nvà nỗi đau của Maririn à?
Dialogue: 0,0:01:12.07,0:01:15.07,Default,,0,0,0,,Biết không, tôi thừa nhận.
Dialogue: 0,0:01:15.16,0:01:16.66,Default,,0,0,0,,Cô nói đúng.
Dialogue: 0,0:01:16.74,0:01:19.41,Default,,0,0,0,,Tôi không thẳng thắn với cô ấy.
Dialogue: 0,0:01:19.50,0:01:22.80,Default,,0,0,0,,Nên tôi xin lỗi vì chuyện đó.
Dialogue: 0,0:01:22.87,0:01:25.25,Default,,0,0,0,,Ai cũng có thể nói xin lỗi.
Dialogue: 0,0:01:25.34,0:01:28.22,Default,,0,0,0,,Đâu phải chúng tôi\Nđến đây để đòi cậu xin lỗi.
Dialogue: 0,0:01:28.30,0:01:30.05,Default,,0,0,0,,Không phải vì thế đâu.
Dialogue: 0,0:01:30.13,0:01:32.22,Default,,0,0,0,,Vậy họ muốn gì?
Dialogue: 0,0:01:32.30,0:01:35.26,Default,,0,0,0,,Cậu ấy xin lỗi là tốt mà.
Dialogue: 0,0:01:35.35,0:01:36.48,Default,,0,0,0,,Ừ, tốt mà.
Dialogue: 0,0:01:36.55,0:01:39.60,Default,,0,0,0,,Nếu cậu không thích cô ấy\Nthì chỉ phải nói thôi.
Dialogue: 0,0:01:39.68,0:01:45.23,Default,,0,0,0,,Nhưng cậu lại bơ cô ấy,\Nchẳng hồi đáp câu nào.
Dialogue: 0,0:01:45.73,0:01:49.61,Default,,0,0,0,,Không được đâu. Đồ rác rưởi.
Dialogue: 0,0:01:49.69,0:01:52.32,Default,,0,0,0,,Họ quá đáng vậy luôn?
Dialogue: 0,0:01:52.95,0:01:57.33,Default,,0,0,0,,Nếu cậu không thay đổi,\Nkhông ai yêu cậu đâu.
Dialogue: 0,0:02:00.79,0:02:04.38,Default,,0,0,0,,Như thể nước mắt của tôi\Ntối qua thật vô nghĩa.
Dialogue: 0,0:02:05.13,0:02:08.09,Default,,0,0,0,,Tôi đã lấy hết can đảm,\Ntừ đầu đến cuối tôi đều run rẩy.
Dialogue: 0,0:02:08.63,0:02:11.72,Default,,0,0,0,,Nhưng cứ như cậu quên hết sạch.\NNhư không có thật.
Dialogue: 0,0:02:13.30,0:02:14.47,Default,,0,0,0,,Cậu thật nông cạn.
Dialogue: 0,0:02:17.39,0:02:23.44,Default,,0,0,0,,Giờ tôi thấy thảm hại quá.\NTôi thật sự đã làm sai rồi.
Dialogue: 0,0:02:23.52,0:02:24.98,Default,,0,0,0,,- Thế à?\N- Vâng.
Dialogue: 0,0:02:30.40,0:02:31.28,Default,,0,0,0,,Hả?
Dialogue: 0,0:02:31.36,0:02:33.32,Default,,0,0,0,,- Ôi, không, Tai-chan!\N- Khoan đã.
Dialogue: 0,0:02:33.40,0:02:34.36,Default,,0,0,0,,Hả?
Dialogue: 0,0:02:36.16,0:02:38.54,Default,,0,0,0,,Tai-chan khóc mất rồi.
Dialogue: 0,0:02:40.12,0:02:46.21,Default,,0,0,0,,Nói thật, giờ tôi thấy hỗn loạn lắm.\NThật là thảm hại toàn tập.
Dialogue: 0,0:02:47.08,0:02:49.88,Default,,0,0,0,,Cô ấy đã toàn tâm viết lá thư đó.
Dialogue: 0,0:02:51.13,0:02:54.55,Default,,0,0,0,,Vậy mà tôi làm tổn thương cô ấy.
Dialogue: 0,0:02:55.93,0:02:59.18,Default,,0,0,0,,Tôi thấy thảm hại quá.
Dialogue: 0,0:03:00.60,0:03:02.31,Default,,0,0,0,,Em nghĩ sao về chuyện này?
Dialogue: 0,0:03:02.39,0:03:03.85,Default,,0,0,0,,Em thấy thương cậu ấy.
Dialogue: 0,0:03:04.93,0:03:07.89,Default,,0,0,0,,- Em nói được gì đây?\N- Chuyện này thôi.
Dialogue: 0,0:03:07.98,0:03:09.57,Default,,0,0,0,,Ồ, cậu ấy kìa.
Dialogue: 0,0:03:09.65,0:03:11.40,Default,,0,0,0,,Cậu ấy về rồi.
Dialogue: 0,0:03:11.48,0:03:13.23,Default,,0,0,0,,- Sao?\N- Thế nào rồi?
Dialogue: 0,0:03:13.32,0:03:14.99,Default,,0,0,0,,- Chuyện gì thế?\N- Sao thế?
Dialogue: 0,0:03:15.07,0:03:16.36,Default,,0,0,0,,Đừng nghiêm trọng thế.
Dialogue: 0,0:03:16.45,0:03:17.37,Default,,0,0,0,,MA-KUN\NVÕ SĨ MMA
Dialogue: 0,0:03:17.45,0:03:18.99,Default,,0,0,0,,- Cậu có đổ không?\N- Sao?
Dialogue: 0,0:03:19.07,0:03:21.49,Default,,0,0,0,,- Đừng bảo cậu chỉ buồn ngủ.\N- Không phải.
Dialogue: 0,0:03:21.58,0:03:22.87,Default,,0,0,0,,Vậy thì sao thế?
Dialogue: 0,0:03:24.91,0:03:26.58,Default,,0,0,0,,Tôi bị ăn chửi.
Dialogue: 0,0:03:26.66,0:03:28.00,Default,,0,0,0,,Hả?
Dialogue: 0,0:03:28.08,0:03:31.83,Default,,0,0,0,,Bị Assun, Ruru và Maririn chửi.
Dialogue: 0,0:03:31.92,0:03:35.13,Default,,0,0,0,,Họ chửi cậu? Chuyện gì vậy?
Dialogue: 0,0:03:35.21,0:03:40.67,Default,,0,0,0,,Maririn viết thư mới cho tôi tối qua.
Dialogue: 0,0:03:40.76,0:03:41.97,Default,,0,0,0,,Ồ, được rồi.
Dialogue: 0,0:03:42.06,0:03:42.89,Default,,0,0,0,,LEO\NCHỦ BAR
Dialogue: 0,0:03:42.97,0:03:47.02,Default,,0,0,0,,Và cả ngày tôi không trả lời cô ấy.
Dialogue: 0,0:03:47.10,0:03:51.36,Default,,0,0,0,,Tôi tiến thẳng đến với Hikaru\Nmà không xử lý vụ đó trước.
Dialogue: 0,0:03:53.61,0:03:54.99,Default,,0,0,0,,ARI\NRAPPER/NGƯỜI MẪU
Dialogue: 0,0:03:55.86,0:03:59.28,Default,,0,0,0,,Lẽ ra cậu nên nói chuyện\Nvới cô ấy hôm nay.
Dialogue: 0,0:04:00.49,0:04:05.04,Default,,0,0,0,,Từ đầu tôi đã toàn tâm để ý Hikaru rồi.\NLẽ ra ai cũng thấy rõ mà.
Dialogue: 0,0:04:05.58,0:04:07.46,Default,,0,0,0,,Tôi muốn ta cạnh tranh công bằng.
Dialogue: 0,0:04:07.54,0:04:11.84,Default,,0,0,0,,Nếu cậu làm trò nửa mùa,\Nthì được tiến tới làm gì.
Dialogue: 0,0:04:11.92,0:04:15.42,Default,,0,0,0,,Có thể lần này\Ncậu đã làm tổn thương Maririn,
Dialogue: 0,0:04:15.51,0:04:18.35,Default,,0,0,0,,nhưng lần sau có khi là Hikaru.\NTôi không muốn thế.
Dialogue: 0,0:04:18.42,0:04:19.59,Default,,0,0,0,,Phải.
Dialogue: 0,0:04:20.84,0:04:24.34,Default,,0,0,0,,Có lẽ chúng ta hiểu sai các cô gái rồi.
Dialogue: 0,0:04:24.43,0:04:25.27,Default,,0,0,0,,Phải.
Dialogue: 0,0:04:25.35,0:04:26.18,Default,,0,0,0,,Họ nghiêm túc.
Dialogue: 0,0:04:26.27,0:04:28.52,Default,,0,0,0,,- Về việc đối mặt với quá khứ.\N- Ừ.
Dialogue: 0,0:04:28.60,0:04:30.52,Default,,0,0,0,,Họ thật sự nghiêm túc đấy.
Dialogue: 0,0:04:53.67,0:04:55.67,Default,,0,0,0,,CHƯƠNG TRÌNH THỰC TẾ TRẺ TRÂU HẸN HÒ
Dialogue: 0,0:04:56.84,0:04:58.68,Default,,0,0,0,,RAPPER TỪ SAGAMIHARA\NBẮN RAP TÌNH TỨ
Dialogue: 0,0:04:58.76,0:05:00.35,Default,,0,0,0,,ARI
Dialogue: 0,0:05:00.43,0:05:02.39,Default,,0,0,0,,TIẾP VIÊN KAWASAKI\NTÌM ĐÀN ÔNG CHÂN CHÍNH
Dialogue: 0,0:05:02.47,0:05:03.56,Default,,0,0,0,,HIKARU
Dialogue: 0,0:05:03.64,0:05:05.31,Default,,0,0,0,,CHỦ BAR KYOTO\NTẤT TAY VÌ BẠN GÁI
Dialogue: 0,0:05:06.60,0:05:08.23,Default,,0,0,0,,NGƯỜI ĐẸP NANIWA\NĐI TÌM TÌNH YÊU
Dialogue: 0,0:05:08.31,0:05:09.39,Default,,0,0,0,,MARIRIN
Dialogue: 0,0:05:09.48,0:05:11.07,Default,,0,0,0,,TRẺ TRÂU KURUME\NLỚN NHỜ CƠM TÙ
Dialogue: 0,0:05:11.14,0:05:12.27,Default,,0,0,0,,BO
Dialogue: 0,0:05:14.06,0:05:15.94,Default,,0,0,0,,VÕ SĨ MMA CỰU XÃ HỘI ĐEN\NTÌM KIẾM TRI KỶ
Dialogue: 0,0:05:16.02,0:05:17.40,Default,,0,0,0,,MA-KUN
Dialogue: 0,0:05:17.48,0:05:19.27,Default,,0,0,0,,TIẾP VIÊN NAGOYA\NCHỈNH ĐỐN ĐÀN ÔNG
Dialogue: 0,0:05:19.36,0:05:20.36,Default,,0,0,0,,ASSUN
Dialogue: 0,0:05:20.45,0:05:21.83,Default,,0,0,0,,NHÀ TẠO MẪU\NYÊU CUỒNG SI
Dialogue: 0,0:05:21.90,0:05:23.28,Default,,0,0,0,,TAI-CHAN
Dialogue: 0,0:05:23.36,0:05:24.95,Default,,0,0,0,,NGƯỜI MẪU CHÂN THẬT\NTÌM TÌNH YÊU
Dialogue: 0,0:05:25.03,0:05:26.11,Default,,0,0,0,,RURU
Dialogue: 0,0:05:29.79,0:05:32.42,Default,,0,0,0,,CHIẾN ĐẤU ĐI SỢ CHI\NYÊU ĐI NGẠI CHI
Dialogue: 0,0:05:53.77,0:05:55.81,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN
Dialogue: 0,0:06:00.90,0:06:05.49,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN 2
Dialogue: 0,0:06:08.33,0:06:10.75,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN\NHỌC VIỆN HÀNG HẢI
Dialogue: 0,0:06:11.37,0:06:12.33,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:06:14.42,0:06:16.21,Default,,0,0,0,,- Ồ?\N- Cô ấy chưa trang điểm.
Dialogue: 0,0:06:16.29,0:06:17.63,Default,,0,0,0,,Để mặt mộc.
Dialogue: 0,0:06:20.96,0:06:21.80,Default,,0,0,0,,HIKARU\NTIẾP VIÊN
Dialogue: 0,0:06:21.88,0:06:23.84,Default,,0,0,0,,Hikaru ở dưới nhà và để mặt mộc.
Dialogue: 0,0:06:23.93,0:06:25.01,Default,,0,0,0,,Thật bất ngờ.
Dialogue: 0,0:06:25.09,0:06:29.76,Default,,0,0,0,,Cô ấy để mặt mộc mà trông vẫn thế.\NVẫn xinh ơi là xinh.
Dialogue: 0,0:06:29.85,0:06:31.73,Default,,0,0,0,,Thật ra tôi đã tới nói vậy với cô ấy.
Dialogue: 0,0:06:31.81,0:06:32.81,Default,,0,0,0,,BO\NTHỢ SƠN
Dialogue: 0,0:06:32.89,0:06:33.89,Default,,0,0,0,,Ồ?
Dialogue: 0,0:06:34.39,0:06:36.52,Default,,0,0,0,,- Cười tươi kìa.\N- Tươi ghê.
Dialogue: 0,0:06:37.02,0:06:38.69,Default,,0,0,0,,Tôi thích vẻ đẹp tự nhiên.
Dialogue: 0,0:06:39.27,0:06:43.36,Default,,0,0,0,,Cô ấy như vậy thu hút tôi lắm.
Dialogue: 0,0:06:43.44,0:06:45.23,Default,,0,0,0,,Đến lúc tôi chủ động rồi.
Dialogue: 0,0:06:48.28,0:06:49.12,Default,,0,0,0,,Phải.
Dialogue: 0,0:06:50.95,0:06:52.28,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:06:52.37,0:06:54.21,Default,,0,0,0,,- Chào.\N- Chào.
Dialogue: 0,0:06:54.29,0:06:57.04,Default,,0,0,0,,Được rồi, xin phép một lát nhé?
Dialogue: 0,0:06:57.54,0:06:59.00,Default,,0,0,0,,- Được.\N- Lên đi.
Dialogue: 0,0:07:06.43,0:07:08.02,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:07:08.09,0:07:09.84,Default,,0,0,0,,- Xin chào.\N- Chào.
Dialogue: 0,0:07:09.93,0:07:15.81,Default,,0,0,0,,Sau cuộc nói chuyện hôm qua,\Ntôi nghĩ mình chưa thành thật với cảm xúc.
Dialogue: 0,0:07:16.48,0:07:20.90,Default,,0,0,0,,Tôi đã quá thiếu dứt khoát,\Nvà sự tự ti đã lấn át lý trí.
Dialogue: 0,0:07:20.98,0:07:23.73,Default,,0,0,0,,Chuyện hẳn đã không xảy ra\Nnếu tôi thẳng thắn hơn.
Dialogue: 0,0:07:23.82,0:07:26.49,Default,,0,0,0,,Anh em và tôi đã nói chuyện.
Dialogue: 0,0:07:26.57,0:07:30.78,Default,,0,0,0,,Các cô gái có lẽ\Ncũng đã nói chuyện rất lâu về việc đó.
Dialogue: 0,0:07:30.87,0:07:35.58,Default,,0,0,0,,Nên tôi muốn nhân đây xin lỗi mọi người.
Dialogue: 0,0:07:38.75,0:07:45.38,Default,,0,0,0,,Nhưng lời nói không quan trọng.\NTôi phải chứng tỏ bằng hành động.
Dialogue: 0,0:07:45.88,0:07:49.76,Default,,0,0,0,,Từ giờ tôi sẽ cố gắng hơn,\Nnên hy vọng mọi người cho tôi cơ hội.
Dialogue: 0,0:07:49.84,0:07:51.97,Default,,0,0,0,,- Tuyệt.\N- Nói hay lắm.
Dialogue: 0,0:07:52.76,0:07:54.14,Default,,0,0,0,,Đổi cảnh.
Dialogue: 0,0:07:57.23,0:07:58.90,Default,,0,0,0,,Cậu đổi cảnh chưa?
Dialogue: 0,0:07:58.98,0:08:00.15,Default,,0,0,0,,Rồi.
Dialogue: 0,0:08:00.23,0:08:02.94,Default,,0,0,0,,Nghe nói cậu ấy ngủ ngon lắm.
Dialogue: 0,0:08:03.77,0:08:04.86,Default,,0,0,0,,Cậu ấy ngủ như heo.
Dialogue: 0,0:08:04.94,0:08:06.53,Default,,0,0,0,,Tôi không ngờ đấy.
Dialogue: 0,0:08:07.11,0:08:08.28,Default,,0,0,0,,Cứ thế hả?
Dialogue: 0,0:08:08.82,0:08:10.74,Default,,0,0,0,,- Đâu, cậu ấy trằn trọc đó.\N- Ừ.
Dialogue: 0,0:08:10.82,0:08:14.12,Default,,0,0,0,,YÊU ĐI NGẠI CHI
Dialogue: 0,0:08:14.20,0:08:17.37,Default,,0,0,0,,Hôm nay, chúng tôi đã sắp xếp\Nmột buổi hẹn hò.
Dialogue: 0,0:08:17.46,0:08:18.67,Default,,0,0,0,,Điên rồ nhỉ?
Dialogue: 0,0:08:18.75,0:08:20.63,Default,,0,0,0,,- Tuyệt!\N- Tôi mà được chọn thì khó tin.
Dialogue: 0,0:08:20.71,0:08:26.13,Default,,0,0,0,,Buổi hẹn hò hôm nay bao gồm các hoạt động\Nchỉ có thể trải nghiệm ở Okinawa.
Dialogue: 0,0:08:26.21,0:08:27.54,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:08:28.05,0:08:30.76,Default,,0,0,0,,Chị em sẽ thi đấu,
Dialogue: 0,0:08:30.84,0:08:35.80,Default,,0,0,0,,và người thắng cuộc\Nsẽ được chọn một chàng trai để đi hẹn hò.
Dialogue: 0,0:08:37.56,0:08:39.98,Default,,0,0,0,,Mọi người, hãy ra biển nào.
Dialogue: 0,0:08:40.06,0:08:41.14,Default,,0,0,0,,Biển?
Dialogue: 0,0:08:41.65,0:08:42.86,Default,,0,0,0,,Chuyện gì đây nhỉ?
Dialogue: 0,0:08:42.94,0:08:44.69,Default,,0,0,0,,Khoan, có dây thừng kìa.
Dialogue: 0,0:08:44.77,0:08:45.94,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:08:46.03,0:08:47.16,Default,,0,0,0,,- Gì?\N- Kéo co à?
Dialogue: 0,0:08:47.24,0:08:48.24,Default,,0,0,0,,Kéo co à?
Dialogue: 0,0:08:48.32,0:08:50.07,Default,,0,0,0,,- Kéo co à?\N- Hẳn là vậy.
Dialogue: 0,0:08:50.15,0:08:51.49,Default,,0,0,0,,Ai lại bắt chị em kéo co?
Dialogue: 0,0:08:51.57,0:08:52.70,Default,,0,0,0,,Kéo co thật.
Dialogue: 0,0:08:52.78,0:08:54.99,Default,,0,0,0,,Này, kiểu như đấu giải vậy.
Dialogue: 0,0:08:55.08,0:08:56.04,Default,,0,0,0,,Vậy là một chọi một
Dialogue: 0,0:08:56.12,0:08:58.04,Default,,0,0,0,,- rồi xem ai vô địch.\N- Hay thế!
Dialogue: 0,0:08:58.12,0:09:00.75,Default,,0,0,0,,- Vãi…\N- Chúc may mắn, Maririn và Ruru.
Dialogue: 0,0:09:00.83,0:09:01.67,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:09:01.75,0:09:03.25,Default,,0,0,0,,Tôi hồi hộp quá.
Dialogue: 0,0:09:03.33,0:09:04.33,Default,,0,0,0,,- Hồi hộp quá.\N- Thật.
Dialogue: 0,0:09:04.42,0:09:05.59,Default,,0,0,0,,VÁN ĐẦU\NMARIRIN VÀ RURU
Dialogue: 0,0:09:05.67,0:09:07.13,Default,,0,0,0,,- Được rồi.\N- Hồi hộp hơn đây.
Dialogue: 0,0:09:07.21,0:09:08.50,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:09:08.59,0:09:10.01,Default,,0,0,0,,- Bắt đầu nè.\N- Cố lên!
Dialogue: 0,0:09:12.97,0:09:14.47,Default,,0,0,0,,Sẵn sàng… chiến!
Dialogue: 0,0:09:14.55,0:09:16.51,Default,,0,0,0,,Khó thế!
Dialogue: 0,0:09:16.60,0:09:18.52,Default,,0,0,0,,Tôi không giữ nổi!
Dialogue: 0,0:09:18.60,0:09:20.35,Default,,0,0,0,,- Cố lên nào.\N- Tiến lên.
Dialogue: 0,0:09:20.94,0:09:22.86,Default,,0,0,0,,Chịu thôi!
Dialogue: 0,0:09:22.94,0:09:25.44,Default,,0,0,0,,- Cô chẳng di chuyển!\N- Cố lên!
Dialogue: 0,0:09:28.03,0:09:30.07,Default,,0,0,0,,- Chưa xong!\N- Nghỉ tí nha?
Dialogue: 0,0:09:30.15,0:09:31.74,Default,,0,0,0,,- Nghỉ?\N- Được nghỉ à?
Dialogue: 0,0:09:31.82,0:09:33.32,Default,,0,0,0,,- Không.\N- Không được nghỉ.
Dialogue: 0,0:09:33.41,0:09:36.04,Default,,0,0,0,,- Kéo co rồi thắng.\N- Kéo rồi thắng.
Dialogue: 0,0:09:36.12,0:09:37.37,Default,,0,0,0,,- Cô thắng.\N- Thắng rồi!
Dialogue: 0,0:09:38.08,0:09:39.71,Default,,0,0,0,,VÁN ĐẦU\NTHẮNG: MARIRIN, THUA: RURU
Dialogue: 0,0:09:39.79,0:09:41.71,Default,,0,0,0,,Lực nắm của cô ít nhất phải 50 nhỉ?
Dialogue: 0,0:09:41.79,0:09:43.08,Default,,0,0,0,,Cô khỏe ghê.
Dialogue: 0,0:09:43.83,0:09:47.08,Default,,0,0,0,,- Đừng nghỉ vì Ruru.\N- Phải đó, nhỉ?
Dialogue: 0,0:09:47.71,0:09:49.55,Default,,0,0,0,,Cậu có phải trọng tài công bằng không?
Dialogue: 0,0:09:49.63,0:09:52.05,Default,,0,0,0,,- Làm sao?\N- Ừ, làm sao?
Dialogue: 0,0:09:52.13,0:09:53.46,Default,,0,0,0,,VÁN HAI\NHIKARU VÀ ASSUN
Dialogue: 0,0:09:53.55,0:09:54.97,Default,,0,0,0,,Chơi đê! Tôi sẽ chiến thắng.
Dialogue: 0,0:09:55.05,0:09:56.43,Default,,0,0,0,,Cố lên, Hikaru!
Dialogue: 0,0:09:56.51,0:09:57.72,Default,,0,0,0,,Cô làm được mà, Hikaru!
Dialogue: 0,0:09:57.81,0:09:59.90,Default,,0,0,0,,- Được chứ.\N- Cố lên!
Dialogue: 0,0:09:59.97,0:10:02.72,Default,,0,0,0,,Đã chơi thì phải thắng.\NTôi sẽ thắng bất chấp.
Dialogue: 0,0:10:02.81,0:10:05.40,Default,,0,0,0,,Được rồi, chơi nào.
Dialogue: 0,0:10:06.36,0:10:08.65,Default,,0,0,0,,Assun trông khỏe ghê.
Dialogue: 0,0:10:08.73,0:10:09.98,Default,,0,0,0,,Sẵn sàng… chiến!
Dialogue: 0,0:10:10.07,0:10:12.36,Default,,0,0,0,,Cố lên, Hikaru! Tiêu diệt cô ấy!
Dialogue: 0,0:10:13.07,0:10:13.95,Default,,0,0,0,,- Dã man!\N- Cố lên!
Dialogue: 0,0:10:14.03,0:10:15.66,Default,,0,0,0,,- Dễ thế.\N- Chà, Assun.
Dialogue: 0,0:10:15.74,0:10:17.87,Default,,0,0,0,,- Thắng dễ dàng.\N- Cô ấy khỏe thật.
Dialogue: 0,0:10:17.95,0:10:19.79,Default,,0,0,0,,- Ừ, rất ngầu.\N- Con gái cũng khỏe mà.
Dialogue: 0,0:10:19.87,0:10:21.20,Default,,0,0,0,,THUA: HIKARU, THẮNG: ASSUN
Dialogue: 0,0:10:21.29,0:10:24.38,Default,,0,0,0,,- Cô khỏe quá.\N- Cô ấy còn chưa hết sức cơ.
Dialogue: 0,0:10:25.42,0:10:26.63,Default,,0,0,0,,Vào vòng chung kết.
Dialogue: 0,0:10:26.71,0:10:28.38,Default,,0,0,0,,VÁN CUỐI\NMARIRIN VỚI ASSUN
Dialogue: 0,0:10:28.46,0:10:29.92,Default,,0,0,0,,Tôi sẽ chiến thắng.
Dialogue: 0,0:10:30.00,0:10:31.04,Default,,0,0,0,,- Phải!\N- Sẽ thắng.
Dialogue: 0,0:10:31.13,0:10:32.97,Default,,0,0,0,,- Tôi sẽ tất tay.\N- Phải!
Dialogue: 0,0:10:33.05,0:10:34.18,Default,,0,0,0,,Cố lên.
Dialogue: 0,0:10:34.26,0:10:35.47,Default,,0,0,0,,- Vừa dậy à?\N- Chào.
Dialogue: 0,0:10:35.55,0:10:37.26,Default,,0,0,0,,- Sẵn sàng chưa?\N- Rồi.
Dialogue: 0,0:10:37.35,0:10:39.64,Default,,0,0,0,,- Ai sẽ thắng?\N- Chúc cả hai may mắn!
Dialogue: 0,0:10:39.72,0:10:40.85,Default,,0,0,0,,Sẵn sàng… chiến!
Dialogue: 0,0:10:42.43,0:10:44.68,Default,,0,0,0,,- Cô ấy khỏe quá.\N- Hả?
Dialogue: 0,0:10:45.65,0:10:46.98,Default,,0,0,0,,- Thua dễ thế.\N- Cô ấy cừ đó.
Dialogue: 0,0:10:47.06,0:10:48.23,Default,,0,0,0,,VÁN CUỐI\NTHẮNG: ASSUN
Dialogue: 0,0:10:48.31,0:10:49.39,Default,,0,0,0,,- Quá dễ.\N- Nhìn kìa!
Dialogue: 0,0:10:49.48,0:10:51.57,Default,,0,0,0,,Ta đã có người chiến thắng!
Dialogue: 0,0:10:51.65,0:10:53.78,Default,,0,0,0,,Giỏi lắm, Assun. Hay quá.
Dialogue: 0,0:10:53.86,0:10:54.99,Default,,0,0,0,,- Khỏe thật!\N- Thế đó!
Dialogue: 0,0:10:55.07,0:10:56.66,Default,,0,0,0,,- Assun khỏe ghê.\N- Tôi thắng rồi.
Dialogue: 0,0:10:56.74,0:11:01.58,Default,,0,0,0,,Người chiến thắng có thể\Nchọn một chàng trai để đi hẹn hò.
Dialogue: 0,0:11:03.25,0:11:04.25,Default,,0,0,0,,Được rồi, Ma-kun.
Dialogue: 0,0:11:05.04,0:11:06.83,Default,,0,0,0,,Ta đi nhé?
Dialogue: 0,0:11:06.92,0:11:08.63,Default,,0,0,0,,- Đi thôi.\N- Vui vẻ nha.
Dialogue: 0,0:11:08.71,0:11:09.71,Default,,0,0,0,,Đi cẩn thận.
Dialogue: 0,0:11:09.79,0:11:11.21,Default,,0,0,0,,- Vui vẻ nha.\N- Thế nha.
Dialogue: 0,0:11:11.30,0:11:12.59,Default,,0,0,0,,Đi cẩn thận!
Dialogue: 0,0:11:13.13,0:11:15.34,Default,,0,0,0,,Biển đẹp quá!
Dialogue: 0,0:11:15.42,0:11:16.67,Default,,0,0,0,,Thật vậy.
Dialogue: 0,0:11:16.76,0:11:18.05,Default,,0,0,0,,Đỉnh thật.
Dialogue: 0,0:11:18.14,0:11:20.52,Default,,0,0,0,,Ba, hai, một, đi!
Dialogue: 0,0:11:21.01,0:11:22.60,Default,,0,0,0,,Đi vui vẻ nha!
Dialogue: 0,0:11:32.53,0:11:34.49,Default,,0,0,0,,Nhanh quá!
Dialogue: 0,0:11:36.49,0:11:37.83,Default,,0,0,0,,Cậu nhanh quá!
Dialogue: 0,0:11:38.57,0:11:40.41,Default,,0,0,0,,Sao cậu lại nhanh thế?
Dialogue: 0,0:11:56.30,0:11:58.39,Default,,0,0,0,,Tuyệt!
Dialogue: 0,0:12:01.93,0:12:03.60,Default,,0,0,0,,Họ nắm tay kìa.
Dialogue: 0,0:12:03.68,0:12:06.68,Default,,0,0,0,,Ơ, hình như đây là\Nlần đầu tiên ta chạm vào nhau.
Dialogue: 0,0:12:06.77,0:12:09.02,Default,,0,0,0,,- Chạm gì?\N- Chạm vào cô đó, Asuka.
Dialogue: 0,0:12:09.10,0:12:11.27,Default,,0,0,0,,Phải. Cậu hay nắm tay lắm à?
Dialogue: 0,0:12:11.77,0:12:12.73,Default,,0,0,0,,Không.
Dialogue: 0,0:12:13.77,0:12:15.11,Default,,0,0,0,,Chưa bao giờ.
Dialogue: 0,0:12:15.19,0:12:16.44,Default,,0,0,0,,Còn cô?
Dialogue: 0,0:12:16.94,0:12:18.19,Default,,0,0,0,,Không nhiều lắm.
Dialogue: 0,0:12:18.28,0:12:19.99,Default,,0,0,0,,- Nhỉ?\N- Với bạn đời thì muốn.
Dialogue: 0,0:12:20.49,0:12:22.28,Default,,0,0,0,,- Xe địa hình?\N- Xe địa hình.
Dialogue: 0,0:12:22.37,0:12:25.79,Default,,0,0,0,,Xe địa hình hai chỗ ngồi\Nthường không có trong gói,
Dialogue: 0,0:12:25.87,0:12:28.91,Default,,0,0,0,,nhưng chúng tôi\Nđã đặc biệt chuẩn bị cho hai bạn.
Dialogue: 0,0:12:29.00,0:12:30.29,Default,,0,0,0,,- Bám chắc nha.\N- Ừ.
Dialogue: 0,0:12:35.88,0:12:37.76,Default,,0,0,0,,Ta từng nói về việc lái xe cùng nhau.
Dialogue: 0,0:12:37.84,0:12:40.13,Default,,0,0,0,,Nhỉ? Vui ghê.
Dialogue: 0,0:12:48.89,0:12:52.52,Default,,0,0,0,,Việc này giúp họ thân thiết hơn,\Ncũng thú vị nữa.
Dialogue: 0,0:12:56.57,0:12:58.99,Default,,0,0,0,,Cậu ấy lái xe địa hình rất thành thạo.
Dialogue: 0,0:12:59.49,0:13:02.33,Default,,0,0,0,,Sẽ thật mất hứng nếu cậu ấy lái dở.
Dialogue: 0,0:13:02.41,0:13:03.91,Default,,0,0,0,,Hiểu mà.
Dialogue: 0,0:13:03.99,0:13:05.16,Default,,0,0,0,,Đúng thế.
Dialogue: 0,0:13:05.24,0:13:07.74,Default,,0,0,0,,Tôi không thích đàn ông lái xe kém.
Dialogue: 0,0:13:07.83,0:13:10.83,Default,,0,0,0,,Nếu không lái xe máy hay ô tô giỏi,
Dialogue: 0,0:13:10.92,0:13:13.34,Default,,0,0,0,,thì chắc chẳng giỏi chuyện gì.
Dialogue: 0,0:13:13.92,0:13:17.92,Default,,0,0,0,,Còn nữa, lúc tôi ôm cậu ấy,\Ntôi thấy cơ bụng rất săn chắc.
Dialogue: 0,0:13:18.01,0:13:20.39,Default,,0,0,0,,Tôi kiểu, chà, cậu ấy cơ bắp quá.
Dialogue: 0,0:13:20.47,0:13:23.56,Default,,0,0,0,,Tay tôi cứ sờ soạng\Ncơ bụng của cậu ấy mãi.
Dialogue: 0,0:13:24.72,0:13:26.26,Default,,0,0,0,,Sờ nhiều quá rồi.
Dialogue: 0,0:13:26.35,0:13:28.10,Default,,0,0,0,,- Nhỉ?\N- Mới lần đầu hẹn hò.
Dialogue: 0,0:13:28.18,0:13:30.35,Default,,0,0,0,,Cô ấy sờ cậu ấy lấy được.
Dialogue: 0,0:13:33.52,0:13:39.98,Default,,0,0,0,,Những người còn lại\Nhãy lại giúp đỡ ở nông trại shikuwasa nhé.
Dialogue: 0,0:13:40.99,0:13:41.82,Default,,0,0,0,,Vào việc nào.
Dialogue: 0,0:13:41.90,0:13:43.03,Default,,0,0,0,,Đến giờ nhổ cỏ dại.
Dialogue: 0,0:13:43.11,0:13:44.53,Default,,0,0,0,,Hôm qua cậu cứ ngái ngủ.
Dialogue: 0,0:13:44.62,0:13:45.87,Default,,0,0,0,,- Tôi hả?\N- Ừ, cậu đó.
Dialogue: 0,0:13:45.95,0:13:49.20,Default,,0,0,0,,- Lúc ta nói chuyện hả?\N- Không biết, trông cậu lơ mơ.
Dialogue: 0,0:13:49.29,0:13:51.58,Default,,0,0,0,,- Tôi tỉnh dậy thì thấy ba cô.\N- Vậy à?
Dialogue: 0,0:13:51.66,0:13:53.91,Default,,0,0,0,,- Sợ ơi là sợ.\N- Sợ à?
Dialogue: 0,0:13:54.00,0:13:57.05,Default,,0,0,0,,- Bị ba chị quây như vậy mà.\N- Thật đó.
Dialogue: 0,0:13:57.13,0:13:59.34,Default,,0,0,0,,Nhưng bị cô đối chất cũng ý nghĩa lắm.
Dialogue: 0,0:13:59.42,0:14:01.55,Default,,0,0,0,,- Đó là tình yêu.\N- Nghĩa là cô quan tâm.
Dialogue: 0,0:14:01.63,0:14:03.30,Default,,0,0,0,,- Ừ.\N- Nhỉ?
Dialogue: 0,0:14:03.84,0:14:05.97,Default,,0,0,0,,- Khoan.\N- Sao thế?
Dialogue: 0,0:14:06.05,0:14:09.01,Default,,0,0,0,,Tạm dừng. Bà ơi.
Dialogue: 0,0:14:09.10,0:14:12.60,Default,,0,0,0,,- Cứu cháu với. Cháu không dám.\N- Châu chấu à?
Dialogue: 0,0:14:12.69,0:14:14.73,Default,,0,0,0,,Chúng thích đậu lên người ghét chúng.
Dialogue: 0,0:14:14.81,0:14:16.31,Default,,0,0,0,,Sợ quá.
Dialogue: 0,0:14:16.40,0:14:18.86,Default,,0,0,0,,- Buồn cười quá. Giật cả mình.\N- Lưng có không?
Dialogue: 0,0:14:18.94,0:14:21.28,Default,,0,0,0,,Nghe bà nói cậu sợ hả?
Dialogue: 0,0:14:21.78,0:14:24.74,Default,,0,0,0,,- Chịu thôi.\N- Biểu cảm lộ hết kìa.
Dialogue: 0,0:14:24.82,0:14:25.65,Default,,0,0,0,,Ồ?
Dialogue: 0,0:14:25.74,0:14:27.33,Default,,0,0,0,,- Hikaru thấy khó chịu rồi.\N- Ừ.
Dialogue: 0,0:14:30.20,0:14:31.83,Default,,0,0,0,,Anh thích thiên nhiên không, Bo?
Dialogue: 0,0:14:31.91,0:14:34.62,Default,,0,0,0,,Tôi quen việc này rồi thì đúng hơn.
Dialogue: 0,0:14:34.71,0:14:36.42,Default,,0,0,0,,Tại sao? Ở quê hay làm à?
Dialogue: 0,0:14:36.50,0:14:38.04,Default,,0,0,0,,Những năm đi "du học" đó.
Dialogue: 0,0:14:38.13,0:14:39.21,Default,,0,0,0,,Ồ, tôi hiểu rồi.
Dialogue: 0,0:14:39.30,0:14:41.30,Default,,0,0,0,,- Đúng vậy.\N- Trong đó làm việc này à?
Dialogue: 0,0:14:41.38,0:14:42.63,Default,,0,0,0,,- Ừ.\N- Thật hả?
Dialogue: 0,0:14:42.72,0:14:45.85,Default,,0,0,0,,Cỏ dại quanh Bo bị nhổ sạch.
Dialogue: 0,0:14:46.34,0:14:48.59,Default,,0,0,0,,Kinh nghiệm của anh có ích quá.
Dialogue: 0,0:14:48.68,0:14:49.93,Default,,0,0,0,,- Vào lúc thế này.\N- Ừ.
Dialogue: 0,0:14:50.01,0:14:53.22,Default,,0,0,0,,- Cậu ấy quen rồi!\N- Có kinh nghiệm mà.
Dialogue: 0,0:14:53.31,0:14:55.81,Default,,0,0,0,,Hôm nay trời đẹp quá. Họ thật bất công.
Dialogue: 0,0:14:55.90,0:14:58.44,Default,,0,0,0,,- Đi hẹn hò.\N- Nói lại đi.
Dialogue: 0,0:14:58.94,0:15:00.11,Default,,0,0,0,,Leo.
Dialogue: 0,0:15:00.65,0:15:01.65,Default,,0,0,0,,Tôi không muốn đâu.
Dialogue: 0,0:15:03.03,0:15:03.86,Default,,0,0,0,,Đừng mà.
Dialogue: 0,0:15:03.94,0:15:05.48,Default,,0,0,0,,Ồ? Cô ấy vui quá kìa.
Dialogue: 0,0:15:05.57,0:15:07.99,Default,,0,0,0,,- Đây là buổi hẹn hò tiêu calo.\N- Đúng vậy.
Dialogue: 0,0:15:08.07,0:15:08.99,Default,,0,0,0,,Rất năng động.
Dialogue: 0,0:15:09.07,0:15:10.86,Default,,0,0,0,,Chẳng muốn nghĩ tới chỗ họ đến.
Dialogue: 0,0:15:10.95,0:15:13.12,Default,,0,0,0,,- Họ về sẽ cười toe toét.\N- Đúng đó.
Dialogue: 0,0:15:13.20,0:15:14.70,Default,,0,0,0,,- Thấy rõ mồn một luôn.\N- Nhỉ?
Dialogue: 0,0:15:14.79,0:15:16.63,Default,,0,0,0,,- Chưa gì đã thấy rồi.\N- Cũng thế.
Dialogue: 0,0:15:16.71,0:15:19.25,Default,,0,0,0,,Chà, bồn sục nè.
Dialogue: 0,0:15:19.75,0:15:20.83,Default,,0,0,0,,Có cả rượu.
Dialogue: 0,0:15:30.72,0:15:32.01,Default,,0,0,0,,Ôi, trời.
Dialogue: 0,0:15:32.10,0:15:32.98,Default,,0,0,0,,Tôi vào nha?
Dialogue: 0,0:15:33.06,0:15:34.60,Default,,0,0,0,,Vào đi.
Dialogue: 0,0:15:34.68,0:15:35.97,Default,,0,0,0,,Quyến rũ quá.
Dialogue: 0,0:15:36.64,0:15:39.14,Default,,0,0,0,,- Thích ghê.\N- Cảnh đẹp nhỉ?
Dialogue: 0,0:15:39.65,0:15:41.69,Default,,0,0,0,,Cứ tưởng buổi tối sẽ thích hơn,
Dialogue: 0,0:15:41.77,0:15:44.77,Default,,0,0,0,,- nhưng ngắm cảnh tuyệt hơn.\N- Đúng. Tôi thích thế này hơn.
Dialogue: 0,0:15:44.86,0:15:47.70,Default,,0,0,0,,Xăm hình đó đau không? Đau nhỉ?
Dialogue: 0,0:15:47.78,0:15:49.91,Default,,0,0,0,,- Đau chứ. Cậu biết mà.\N- Nhỉ?
Dialogue: 0,0:15:49.99,0:15:51.16,Default,,0,0,0,,Tôi biết.
Dialogue: 0,0:15:52.03,0:15:54.45,Default,,0,0,0,,- Cậu không gây tê à?\N- Có chứ.
Dialogue: 0,0:15:55.41,0:15:57.29,Default,,0,0,0,,- Có dùng.\N- Kém thế.
Dialogue: 0,0:15:58.67,0:16:00.21,Default,,0,0,0,,Tôi không gây tê luôn.
Dialogue: 0,0:16:00.29,0:16:02.08,Default,,0,0,0,,Thật sao? Siêu thế.
Dialogue: 0,0:16:02.59,0:16:03.84,Default,,0,0,0,,Cậu xăm vào năm nào?
Dialogue: 0,0:16:03.92,0:16:05.63,Default,,0,0,0,,Hình đầu ấy hả?
Dialogue: 0,0:16:05.71,0:16:08.30,Default,,0,0,0,,Hình như tầm 17 tuổi.
Dialogue: 0,0:16:08.38,0:16:09.26,Default,,0,0,0,,Tôi cũng vậy nè.
Dialogue: 0,0:16:09.34,0:16:11.18,Default,,0,0,0,,- Nhiều điểm chung ghê.\N- Nhỉ?
Dialogue: 0,0:16:15.52,0:16:16.98,Default,,0,0,0,,Yêu đương là thế nào nhỉ?
Dialogue: 0,0:16:17.06,0:16:19.52,Default,,0,0,0,,Chịu. Đừng hỏi tôi.
Dialogue: 0,0:16:19.60,0:16:22.44,Default,,0,0,0,,Hiện tại ta vẫn đang ở\Ngiai đoạn trong sáng.
Dialogue: 0,0:16:22.52,0:16:24.61,Default,,0,0,0,,Phải. Khoan, trong sáng là gì?
Dialogue: 0,0:16:25.15,0:16:26.99,Default,,0,0,0,,- Tình yêu trong sáng.\N- Là gì?
Dialogue: 0,0:16:27.07,0:16:28.24,Default,,0,0,0,,Là thuần khiết đó.
Dialogue: 0,0:16:28.32,0:16:29.41,Default,,0,0,0,,À, hiểu rồi. Phải.
Dialogue: 0,0:16:29.49,0:16:32.16,Default,,0,0,0,,- Nắm tay thôi cũng vui rồi.\N- Phải.
Dialogue: 0,0:16:34.99,0:16:36.78,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:16:36.87,0:16:38.46,Default,,0,0,0,,Mọi người gọi cậu là Ma-kun à?
Dialogue: 0,0:16:38.96,0:16:40.46,Default,,0,0,0,,Bạn gái cũ gọi thế.
Dialogue: 0,0:16:40.54,0:16:42.67,Default,,0,0,0,,Vậy tôi gọi cậu bằng tên khác nhé?
Dialogue: 0,0:16:42.75,0:16:44.09,Default,,0,0,0,,Ừ. Tên gì?
Dialogue: 0,0:16:44.17,0:16:45.38,Default,,0,0,0,,Cậu thích tên gì?
Dialogue: 0,0:16:45.46,0:16:46.88,Default,,0,0,0,,Masaya thôi.
Dialogue: 0,0:16:46.96,0:16:47.79,Default,,0,0,0,,Cậu thích vậy hả?
Dialogue: 0,0:16:47.88,0:16:50.55,Default,,0,0,0,,Ừ, tôi thích Masaya thôi.
Dialogue: 0,0:16:50.63,0:16:56.05,Default,,0,0,0,,Người duy nhất gọi tôi là Masaya\Nlà đại ca của tôi khi còn trong băng đảng.
Dialogue: 0,0:16:56.14,0:16:57.81,Default,,0,0,0,,Tôi thân và theo anh ấy từ lâu.
Dialogue: 0,0:16:57.89,0:16:59.56,Default,,0,0,0,,Có mỗi đại ca gọi tôi là Masaya.
Dialogue: 0,0:16:59.64,0:17:01.27,Default,,0,0,0,,- Vì Masaya.\N- Vì Masaya.
Dialogue: 0,0:17:01.77,0:17:03.36,Default,,0,0,0,,Masaya trong sáng.
Dialogue: 0,0:17:04.44,0:17:06.23,Default,,0,0,0,,Khoan đã. Cụt hứng thế.
Dialogue: 0,0:17:07.65,0:17:09.78,Default,,0,0,0,,Này, gọi tôi bằng tên của tôi.
Dialogue: 0,0:17:09.86,0:17:10.69,Default,,0,0,0,,Phải.
Dialogue: 0,0:17:10.78,0:17:12.66,Default,,0,0,0,,Mỗi đại ca xã hội đen gọi tôi như vậy.
Dialogue: 0,0:17:12.74,0:17:15.03,Default,,0,0,0,,Sợ thế. Nghe như đe dọa vậy.
Dialogue: 0,0:17:15.12,0:17:16.08,Default,,0,0,0,,MA-KUN, ASSUN
Dialogue: 0,0:17:16.16,0:17:17.66,Default,,0,0,0,,- Tùy chỗ nữa.\N- Đúng thế.
Dialogue: 0,0:17:17.75,0:17:20.54,Default,,0,0,0,,Chắc như thế gợi lại cảm xúc cũ,\Nkhiến cậu ấy rạo rực.
Dialogue: 0,0:17:20.62,0:17:23.04,Default,,0,0,0,,- Cậu ấy nhầm với rung động yêu đương.\N- Phải.
Dialogue: 0,0:17:23.13,0:17:25.42,Default,,0,0,0,,- Nhưng lại là rung động thời xã hội đen.\N- Phải.
Dialogue: 0,0:17:25.50,0:17:27.88,Default,,0,0,0,,- Rung động!\N- "Ôi, đại ca của tôi!" Kiểu thế.
Dialogue: 0,0:17:27.96,0:17:30.05,Default,,0,0,0,,Cậu ấy nhầm lẫn hai cảm xúc khác nhau.
Dialogue: 0,0:17:30.13,0:17:31.80,Default,,0,0,0,,Họ đúng là hai thái cực.
Dialogue: 0,0:17:31.88,0:17:32.88,Default,,0,0,0,,Khác hẳn nhau.
Dialogue: 0,0:17:36.31,0:17:37.35,Default,,0,0,0,,Xin một lát nha?
Dialogue: 0,0:17:37.43,0:17:38.35,Default,,0,0,0,,Được.
Dialogue: 0,0:17:44.86,0:17:46.03,Default,,0,0,0,,Tai-chan.
Dialogue: 0,0:17:46.11,0:17:47.15,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:17:49.19,0:17:50.27,Default,,0,0,0,,Cầm thuốc chưa?
Dialogue: 0,0:17:50.36,0:17:51.24,Default,,0,0,0,,Tôi cầm rồi.
Dialogue: 0,0:17:52.49,0:17:53.91,Default,,0,0,0,,Thật đấy à?
Dialogue: 0,0:17:57.79,0:17:59.00,Default,,0,0,0,,Chị em khó hiểu ghê.
Dialogue: 0,0:17:59.08,0:18:00.12,Default,,0,0,0,,Khó hiểu toàn tập.
Dialogue: 0,0:18:02.41,0:18:05.16,Default,,0,0,0,,Nhìn Ari đi.
Dialogue: 0,0:18:07.38,0:18:08.47,Default,,0,0,0,,Thật rõ ràng.
Dialogue: 0,0:18:08.55,0:18:09.43,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:18:10.13,0:18:11.26,Default,,0,0,0,,Không quan trọng.
Dialogue: 0,0:18:11.92,0:18:14.34,Default,,0,0,0,,Rõ ràng cậu ấy bực bội.
Dialogue: 0,0:18:14.43,0:18:15.77,Default,,0,0,0,,Hẳn là khó chịu lắm.
Dialogue: 0,0:18:17.55,0:18:19.34,Default,,0,0,0,,Cậu biết sao tôi muốn nói chuyện chứ?
Dialogue: 0,0:18:20.31,0:18:21.90,Default,,0,0,0,,Hôm nay ta tới nông trại.
Dialogue: 0,0:18:21.98,0:18:24.69,Default,,0,0,0,,Và cậu chẳng qua nói chuyện với tôi gì cả.
Dialogue: 0,0:18:24.77,0:18:25.81,Default,,0,0,0,,Tôi biết.
Dialogue: 0,0:18:25.90,0:18:30.40,Default,,0,0,0,,Tôi cũng có lý do.
Dialogue: 0,0:18:30.48,0:18:34.40,Default,,0,0,0,,Hình như Ari cũng theo đuổi cô.
Dialogue: 0,0:18:34.49,0:18:37.74,Default,,0,0,0,,Bo và tôi cũng muốn tìm hiểu cô.
Dialogue: 0,0:18:38.28,0:18:41.16,Default,,0,0,0,,Và cảm giác không đúng\Nkhi tự dưng xen ngang như thế.
Dialogue: 0,0:18:41.25,0:18:42.54,Default,,0,0,0,,Vậy là cậu lùi lại à?
Dialogue: 0,0:18:42.62,0:18:46.87,Default,,0,0,0,,Tôi sẽ nói thật. Tôi sẽ không viện cớ đâu.
Dialogue: 0,0:18:46.96,0:18:50.09,Default,,0,0,0,,Hôm nay tâm trí tôi rối bời lắm.
Dialogue: 0,0:18:50.17,0:18:52.05,Default,,0,0,0,,Sau chuyện xảy ra tối qua à?
Dialogue: 0,0:18:54.22,0:18:57.22,Default,,0,0,0,,Thật luôn, chuyện gì vậy?
Dialogue: 0,0:18:58.47,0:19:00.31,Default,,0,0,0,,Tôi thấy bực quá.
Dialogue: 0,0:19:01.14,0:19:03.02,Default,,0,0,0,,Mau lên.
Dialogue: 0,0:19:03.10,0:19:04.64,Default,,0,0,0,,Ồ, anh ấy đi rồi.
Dialogue: 0,0:19:06.69,0:19:08.15,Default,,0,0,0,,Hikaru và Taisei có đây không?
Dialogue: 0,0:19:08.23,0:19:09.52,Default,,0,0,0,,Họ đi hút thuốc rồi.
Dialogue: 0,0:19:09.61,0:19:11.61,Default,,0,0,0,,- Cảm ơn. Xin lỗi đã làm phiền.\N- Thế nhé.
Dialogue: 0,0:19:11.69,0:19:13.15,Default,,0,0,0,,Gì vậy?
Dialogue: 0,0:19:13.74,0:19:14.99,Default,,0,0,0,,Chán vãi.
Dialogue: 0,0:19:16.36,0:19:18.70,Default,,0,0,0,,Hai người đó đi đâu rồi?
Dialogue: 0,0:19:22.70,0:19:24.70,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:19:27.37,0:19:29.87,Default,,0,0,0,,Mình không biết đường!
Dialogue: 0,0:19:29.96,0:19:31.50,Default,,0,0,0,,Đừng có kêu ca với chúng tôi.
Dialogue: 0,0:19:31.59,0:19:33.18,Default,,0,0,0,,Cậu ấy không tìm được họ kìa.
Dialogue: 0,0:19:33.26,0:19:35.76,Default,,0,0,0,,Không phải tại chúng ta.
Dialogue: 0,0:19:35.84,0:19:41.68,Default,,0,0,0,,Nhớ bài phát biểu của cậu\Ntrong lớp sáng nay chứ?
Dialogue: 0,0:19:42.22,0:19:44.56,Default,,0,0,0,,Tôi thấy cậu thật nam tính.
Dialogue: 0,0:19:45.06,0:19:47.65,Default,,0,0,0,,Lần đầu tiên đấy.\NTôi thấy cậu đã thay đổi.
Dialogue: 0,0:19:50.65,0:19:56.36,Default,,0,0,0,,Cô là người tôi để ý đến mà.
Dialogue: 0,0:19:59.41,0:20:00.91,Default,,0,0,0,,Tôi sẽ nói với Maririn.
Dialogue: 0,0:20:00.99,0:20:01.91,Default,,0,0,0,,Nói gì cơ?
Dialogue: 0,0:20:04.20,0:20:08.25,Default,,0,0,0,,Rằng hiện tại tôi chỉ để ý đến cô thôi.
Dialogue: 0,0:20:14.17,0:20:15.59,Default,,0,0,0,,Gì vậy trời?
Dialogue: 0,0:20:16.09,0:20:18.84,Default,,0,0,0,,- Cười!\N- Vẻ mặt gì vậy?
Dialogue: 0,0:20:18.93,0:20:21.93,Default,,0,0,0,,- Cô ấy cười toe toét.\N- Như thể họ bảo cô ấy giữ nguyên.
Dialogue: 0,0:20:24.06,0:20:25.56,Default,,0,0,0,,Đến là bực mình.
Dialogue: 0,0:20:29.19,0:20:30.57,Default,,0,0,0,,Ở đây cũng không có!
Dialogue: 0,0:20:30.65,0:20:32.19,Default,,0,0,0,,Cậu ấy vẫn đang tìm.
Dialogue: 0,0:20:32.81,0:20:34.27,Default,,0,0,0,,Họ đâu rồi?
Dialogue: 0,0:20:35.19,0:20:37.73,Default,,0,0,0,,Chẳng thấy ai cả. Nơi này bị bỏ hoang à?
Dialogue: 0,0:20:37.82,0:20:39.36,Default,,0,0,0,,Họ đi đâu rồi?
Dialogue: 0,0:20:39.45,0:20:41.95,Default,,0,0,0,,Cậu đang ở trường. Cậu nên biết ở đâu chứ.
Dialogue: 0,0:20:42.03,0:20:45.12,Default,,0,0,0,,Cảm xúc của tôi vẫn y nguyên.
Dialogue: 0,0:20:47.00,0:20:48.00,Default,,0,0,0,,Của tôi thì không.
Dialogue: 0,0:20:49.29,0:20:51.04,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:20:52.25,0:20:55.50,Default,,0,0,0,,Hai người đi năm tiếng rồi đấy.
Dialogue: 0,0:20:56.26,0:20:57.59,Default,,0,0,0,,Đã năm tiếng đâu.
Dialogue: 0,0:20:57.67,0:20:59.42,Default,,0,0,0,,Tôi xen vào đây.
Dialogue: 0,0:20:59.51,0:21:01.26,Default,,0,0,0,,- Nói chuyện đi.\N- Được.
Dialogue: 0,0:21:01.34,0:21:02.47,Default,,0,0,0,,- Bận à?\N- Tôi đi đây.
Dialogue: 0,0:21:04.22,0:21:05.18,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:21:05.26,0:21:08.76,Default,,0,0,0,,- Chào. Hân hạnh.\N- Hân hạnh. Tôi là Ari.
Dialogue: 0,0:21:09.73,0:21:12.48,Default,,0,0,0,,Cô bảo cô không có hứng thú với ai lắm.
Dialogue: 0,0:21:12.56,0:21:14.15,Default,,0,0,0,,- Ừ.\N- Đã thay đổi chưa?
Dialogue: 0,0:21:15.02,0:21:16.61,Default,,0,0,0,,Không rõ tốt hay xấu,
Dialogue: 0,0:21:17.15,0:21:21.15,Default,,0,0,0,,nhưng tôi thấy mình quá thoải mái\Nkhi ở bên anh.
Dialogue: 0,0:21:22.66,0:21:24.83,Default,,0,0,0,,Như thế nghĩa là sao?
Dialogue: 0,0:21:24.91,0:21:27.00,Default,,0,0,0,,Anh không phải lốp dự phòng của tôi đâu.
Dialogue: 0,0:21:27.08,0:21:28.29,Default,,0,0,0,,- Không.\N- Anh không phải…
Dialogue: 0,0:21:28.37,0:21:32.04,Default,,0,0,0,,Tôi lo là anh nghĩ tôi đang làm như vậy.
Dialogue: 0,0:21:32.12,0:21:34.83,Default,,0,0,0,,Nhưng cô nghiêm túc với tôi, phải không?
Dialogue: 0,0:21:35.34,0:21:40.14,Default,,0,0,0,,Ừ. Tôi muốn kết hôn,\Nnên tôi đang thận trọng.
Dialogue: 0,0:21:43.01,0:21:45.30,Default,,0,0,0,,Tôi vẫn chưa phải lòng ai.
Dialogue: 0,0:21:45.39,0:21:46.68,Default,,0,0,0,,Thế hả?
Dialogue: 0,0:21:47.56,0:21:49.60,Default,,0,0,0,,- Ồ?\N- Ra vậy.
Dialogue: 0,0:21:53.23,0:21:55.36,Default,,0,0,0,,Chắc họ đang hẹn hò vui hết nấc.
Dialogue: 0,0:21:55.44,0:21:57.90,Default,,0,0,0,,Có khi họ có tiến triển rồi ấy.
Dialogue: 0,0:21:57.98,0:21:59.23,Default,,0,0,0,,Cá là hôn rồi.
Dialogue: 0,0:21:59.32,0:22:00.36,Default,,0,0,0,,Hy vọng là rồi.
Dialogue: 0,0:22:00.44,0:22:01.73,Default,,0,0,0,,Ê, họ về rồi. Đằng này.
Dialogue: 0,0:22:01.82,0:22:02.99,Default,,0,0,0,,Chúng tôi về rồi.
Dialogue: 0,0:22:05.91,0:22:08.08,Default,,0,0,0,,Chúng tôi về rồi. Sao rồi?
Dialogue: 0,0:22:08.16,0:22:10.12,Default,,0,0,0,,Ê, đói quá. Chúng tôi cũng muốn ăn.
Dialogue: 0,0:22:10.20,0:22:11.20,Default,,0,0,0,,Đói meo rồi.
Dialogue: 0,0:22:11.29,0:22:12.29,Default,,0,0,0,,Nhìn hai người kìa.
Dialogue: 0,0:22:12.79,0:22:14.54,Default,,0,0,0,,- Món gì thơm thế.\N- Hay quá.
Dialogue: 0,0:22:14.62,0:22:16.75,Default,,0,0,0,,Đừng túm tụm ở bên đó được không?
Dialogue: 0,0:22:16.84,0:22:17.80,Default,,0,0,0,,Không sao.
Dialogue: 0,0:22:17.88,0:22:19.30,Default,,0,0,0,,Thế hôn nhau chưa?
Dialogue: 0,0:22:19.38,0:22:20.30,Default,,0,0,0,,- Chưa.\N- Không hôn.
Dialogue: 0,0:22:20.38,0:22:22.34,Default,,0,0,0,,- Thấy chưa?\N- Chưa á?
Dialogue: 0,0:22:22.84,0:22:25.01,Default,,0,0,0,,Nói thật không vậy?
Dialogue: 0,0:22:25.09,0:22:27.05,Default,,0,0,0,,- Chưa hôn mà.\N- Không. Sao lại hôn?
Dialogue: 0,0:22:27.14,0:22:29.02,Default,,0,0,0,,Không hôn? Sao lại thế?
Dialogue: 0,0:22:29.10,0:22:31.60,Default,,0,0,0,,- Vì chúng tôi trong sáng.\N- Trong sáng.
Dialogue: 0,0:22:31.68,0:22:33.47,Default,,0,0,0,,Có biết trong sáng là gì không?
Dialogue: 0,0:22:33.56,0:22:34.44,Default,,0,0,0,,Không biết.
Dialogue: 0,0:22:34.52,0:22:36.61,Default,,0,0,0,,- Trong sáng là gì vậy?\N- Chưa từng nghe hả?
Dialogue: 0,0:22:36.69,0:22:39.23,Default,,0,0,0,,Nghĩa là chúng tôi thích kiểu thuần khiết.
Dialogue: 0,0:22:40.98,0:22:42.52,Default,,0,0,0,,Mọi thứ bắt đầu tiến triển rồi.
Dialogue: 0,0:22:42.61,0:22:44.03,Default,,0,0,0,,Lan tỏa tình yêu rồi đó.
Dialogue: 0,0:22:44.11,0:22:47.11,Default,,0,0,0,,Trông họ thoải mái bên nhau\Nkhiến tôi hơi khó chịu đấy.
Dialogue: 0,0:22:49.58,0:22:51.67,Default,,0,0,0,,- Chúng tôi chán nên qua chơi.\N- Xin phép.
Dialogue: 0,0:22:53.21,0:22:57.71,Default,,0,0,0,,Tôi nghe chị em nói chuyện rồi,\Ncác cô toàn kể chuyện bạo hành.
Dialogue: 0,0:22:57.79,0:22:59.12,Default,,0,0,0,,Tôi thật sự không hiểu.
Dialogue: 0,0:22:59.21,0:23:00.04,Default,,0,0,0,,Tại sao không?
Dialogue: 0,0:23:00.13,0:23:04.59,Default,,0,0,0,,Chị em nóng máu, anh em cũng nóng máu mà.
Dialogue: 0,0:23:04.67,0:23:08.67,Default,,0,0,0,,Nhưng tôi vẫn không hiểu\Nsao họ lại trở nên bạo lực.
Dialogue: 0,0:23:09.43,0:23:11.60,Default,,0,0,0,,Là vì hai bên không hiểu lời nói của nhau.
Dialogue: 0,0:23:11.68,0:23:13.35,Default,,0,0,0,,Tôi cũng nghe nói thế.
Dialogue: 0,0:23:13.43,0:23:17.64,Default,,0,0,0,,Tôi biết việc này\Ncó thể làm tổn hại hình ảnh, nhưng…
Dialogue: 0,0:23:17.73,0:23:20.73,Default,,0,0,0,,Hồi trẻ hơn, tôi bị cắm sừng.
Dialogue: 0,0:23:20.82,0:23:24.37,Default,,0,0,0,,Lúc đó, đầu óc tôi trống rỗng,\Nvà tôi đã tát cô ấy.
Dialogue: 0,0:23:27.91,0:23:32.25,Default,,0,0,0,,Nhưng tôi không thấy như thế là vô căn cứ.
Dialogue: 0,0:23:33.33,0:23:37.13,Default,,0,0,0,,Nhưng tôi không thể\Nđánh phụ nữ. Không thể.
Dialogue: 0,0:23:37.21,0:23:41.92,Default,,0,0,0,,Nghe thì giống như viện cớ,\Nnhưng khi đó tôi còn trẻ dại.
Dialogue: 0,0:23:42.00,0:23:43.67,Default,,0,0,0,,Giờ sẽ không bao giờ có chuyện đó.
Dialogue: 0,0:23:43.76,0:23:44.59,Default,,0,0,0,,Phải rồi.
Dialogue: 0,0:23:44.67,0:23:47.01,Default,,0,0,0,,Anh có nhận ra việc mình làm không?
Dialogue: 0,0:23:47.09,0:23:49.13,Default,,0,0,0,,Có. Tôi biết mình đã vượt giới hạn.
Dialogue: 0,0:23:49.68,0:23:51.89,Default,,0,0,0,,Nhưng lúc đó tôi tức quá.
Dialogue: 0,0:23:51.97,0:23:55.64,Default,,0,0,0,,Tôi nghĩ tôi phải đối chất thằng kia,\Nnên tôi đi tìm và đánh hắn một trận.
Dialogue: 0,0:23:59.19,0:24:00.28,Default,,0,0,0,,Hẳn là rất đáng sợ.
Dialogue: 0,0:24:00.36,0:24:01.24,Default,,0,0,0,,BO, MARIRIN
Dialogue: 0,0:24:01.31,0:24:02.98,Default,,0,0,0,,Chắc cô ấy thấy hơi sợ cậu ấy rồi.
Dialogue: 0,0:24:03.07,0:24:06.41,Default,,0,0,0,,Nhưng nếu cậu ấy giấu giếm\Nthì cũng đáng sợ mà.
Dialogue: 0,0:24:06.49,0:24:07.74,Default,,0,0,0,,- Phải.\N- Hợp lý.
Dialogue: 0,0:24:07.82,0:24:10.74,Default,,0,0,0,,Cậu ấy thành thật là rất tốt.
Dialogue: 0,0:24:10.82,0:24:13.11,Default,,0,0,0,,Cảm giác như lần này,\Nchị em nắm quyền trong tay.
Dialogue: 0,0:24:13.20,0:24:15.16,Default,,0,0,0,,- Mùa này, đúng.\N- Mùa này.
Dialogue: 0,0:24:15.25,0:24:16.75,Default,,0,0,0,,Anh em cứ phải rón rén.
Dialogue: 0,0:24:16.83,0:24:17.66,Default,,0,0,0,,Phải đó.
Dialogue: 0,0:24:17.75,0:24:20.67,Default,,0,0,0,,Leo gọi họ là "chị em".
Dialogue: 0,0:24:20.75,0:24:22.25,Default,,0,0,0,,- "Nghe chị em nói".\N- "Chị em".
Dialogue: 0,0:24:23.34,0:24:26.30,Default,,0,0,0,,Leo trông như thành viên\NDàn nhạc Tokyo Ska Paradise.
Dialogue: 0,0:24:26.38,0:24:30.59,Default,,0,0,0,,Trông cậu ấy như bé cưng của ban nhạc.
Dialogue: 0,0:24:30.68,0:24:33.10,Default,,0,0,0,,- Ừ.\N- Như sự kết hợp của tất cả bọn họ.
Dialogue: 0,0:24:39.52,0:24:40.73,Default,,0,0,0,,HỌC VIỆN HÀNG HẢI\NTÌNH YÊU
Dialogue: 0,0:24:40.81,0:24:42.31,Default,,0,0,0,,Thấy đẹp hay xấu thì bảo nha.
Dialogue: 0,0:24:43.32,0:24:44.15,Default,,0,0,0,,Trông bảnh lắm.
Dialogue: 0,0:24:44.23,0:24:46.73,Default,,0,0,0,,Hôm nay, các bạn có hoạt động ngoại khóa.
Dialogue: 0,0:24:47.40,0:24:53.70,Default,,0,0,0,,Hãy gắn kết với nhau hơn thông qua\Ntruyền thống "Mouashibi" của Okinawa.
Dialogue: 0,0:24:53.78,0:24:56.24,Default,,0,0,0,,- Gì cơ?\N- Mouashibi là gì?
Dialogue: 0,0:24:56.33,0:24:57.46,Default,,0,0,0,,Làm thật hả?
Dialogue: 0,0:24:57.54,0:24:58.67,Default,,0,0,0,,Đó là gì vậy?
Dialogue: 0,0:24:58.75,0:25:00.84,Default,,0,0,0,,Chúng ta làm Mouashibi thật hả?
Dialogue: 0,0:25:00.92,0:25:05.51,Default,,0,0,0,,Mouashibi là một truyền thống\Ncổ xưa ở Okinawa.
Dialogue: 0,0:25:06.55,0:25:10.85,Default,,0,0,0,,Đó là nơi giới trẻ tụ tập,\Nca hát, nhảy múa
Dialogue: 0,0:25:10.93,0:25:14.14,Default,,0,0,0,,và tìm kiếm bạn đời tương lai.
Dialogue: 0,0:25:14.85,0:25:16.44,Default,,0,0,0,,- Tuyệt, Okinawa!\N- Ôi, chà!
Dialogue: 0,0:25:16.51,0:25:17.55,Default,,0,0,0,,Xem này.
Dialogue: 0,0:25:17.64,0:25:19.81,Default,,0,0,0,,- Chào Shikuwasa!\N- Giống Taiko Drum Master!
Dialogue: 0,0:25:19.89,0:25:21.18,Default,,0,0,0,,Tuyệt quá.
Dialogue: 0,0:25:22.10,0:25:23.44,Default,,0,0,0,,- Hả?\N- Thật điên rồ.
Dialogue: 0,0:26:05.73,0:26:06.56,Default,,0,0,0,,Tuyệt quá!
Dialogue: 0,0:26:06.65,0:26:08.90,Default,,0,0,0,,Sao rồi, bạn ơi?
Dialogue: 0,0:26:10.36,0:26:11.82,Default,,0,0,0,,Hay quá đi mất!
Dialogue: 0,0:26:11.90,0:26:13.24,Default,,0,0,0,,Đỉnh.
Dialogue: 0,0:26:13.32,0:26:15.45,Default,,0,0,0,,- Đến giờ ăn rồi.\N- Mãi mới được ăn.
Dialogue: 0,0:26:15.53,0:26:17.41,Default,,0,0,0,,- Chà.\N- Hên quá.
Dialogue: 0,0:26:17.49,0:26:18.99,Default,,0,0,0,,Thật đấy à?
Dialogue: 0,0:26:19.08,0:26:19.91,Default,,0,0,0,,Trông tuyệt quá!
Dialogue: 0,0:26:20.00,0:26:22.59,Default,,0,0,0,,- Đống này là sao?\N- Ôi, trời.
Dialogue: 0,0:26:22.66,0:26:24.37,Default,,0,0,0,,- Xin mời nhỉ?\N- Ừ.
Dialogue: 0,0:26:24.46,0:26:25.67,Default,,0,0,0,,Một, hai…
Dialogue: 0,0:26:25.75,0:26:27.67,Default,,0,0,0,,Sao rồi!
Dialogue: 0,0:26:28.42,0:26:30.26,Default,,0,0,0,,Ăn nào.
Dialogue: 0,0:26:31.21,0:26:32.42,Default,,0,0,0,,- Trời!\N- Ngon quá!
Dialogue: 0,0:26:32.51,0:26:33.34,Default,,0,0,0,,Gì đây nhỉ?
Dialogue: 0,0:26:33.43,0:26:34.51,Default,,0,0,0,,Thịt heo ba chỉ.
Dialogue: 0,0:26:34.59,0:26:36.43,Default,,0,0,0,,Ngon dã man.
Dialogue: 0,0:26:37.10,0:26:38.44,Default,,0,0,0,,- Ngon quá!\N- Đói quá.
Dialogue: 0,0:26:38.51,0:26:39.34,Default,,0,0,0,,Thật điên rồ.
Dialogue: 0,0:26:42.10,0:26:42.93,Default,,0,0,0,,Khoan, gì vậy?
Dialogue: 0,0:26:43.56,0:26:45.02,Default,,0,0,0,,- Có người mới.\N- Phải.
Dialogue: 0,0:26:53.74,0:26:55.03,Default,,0,0,0,,Này, có người tới!
Dialogue: 0,0:26:55.11,0:26:55.94,Default,,0,0,0,,Chào!
Dialogue: 0,0:27:08.46,0:27:09.42,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:27:09.50,0:27:10.38,Default,,0,0,0,,Sao rồi? Chào!
Dialogue: 0,0:27:10.46,0:27:11.38,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:27:11.46,0:27:12.54,Default,,0,0,0,,- Sao rồi!\N- Xin chào.
Dialogue: 0,0:27:12.63,0:27:16.30,Default,,0,0,0,,Tôi là Hazuki, học sinh chuyển trường.\NCứ gọi tôi là Ha-chan. Hân hạnh.
Dialogue: 0,0:27:16.38,0:27:18.26,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:27:18.35,0:27:19.18,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:27:19.26,0:27:20.64,Default,,0,0,0,,Chào mừng!
Dialogue: 0,0:27:20.72,0:27:21.80,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:27:21.89,0:27:24.93,Default,,0,0,0,,Tôi là Abe Hazuki, 27 tuổi.\NTôi đến từ Miyagi.
Dialogue: 0,0:27:25.02,0:27:26.10,Default,,0,0,0,,ABE HAZUKI\NHAY HA-CHAN
Dialogue: 0,0:27:26.19,0:27:27.57,Default,,0,0,0,,Cứ gọi tôi là Ha-chan.
Dialogue: 0,0:27:28.06,0:27:30.85,Default,,0,0,0,,Tôi làm nghề HLV kickboxing.
Dialogue: 0,0:27:30.94,0:27:32.90,Default,,0,0,0,,Tôi nghiêm túc với nghề này lúc tầm 19.
Dialogue: 0,0:27:32.98,0:27:33.81,Default,,0,0,0,,Tuyệt.
Dialogue: 0,0:27:33.90,0:27:39.20,Default,,0,0,0,,Tôi cũng đã trải qua\Nkhoảng thời gian khó khăn trong đời.
Dialogue: 0,0:27:39.70,0:27:41.29,Default,,0,0,0,,Tôi chưa từng có tổ ấm.
Dialogue: 0,0:27:41.37,0:27:45.75,Default,,0,0,0,,Hầu hết các mối quan hệ đều kết thúc\Nvì các bạn trai cũ bị bắt.
Dialogue: 0,0:27:45.83,0:27:47.33,Default,,0,0,0,,Ma túy, lừa đảo, đủ thứ.
Dialogue: 0,0:27:47.42,0:27:50.55,Default,,0,0,0,,Tất cả đều đã đi tù vài năm.
Dialogue: 0,0:27:50.63,0:27:51.46,Default,,0,0,0,,MA TÚY LỪA ĐẢO
Dialogue: 0,0:27:51.54,0:27:53.58,Default,,0,0,0,,Nên tôi muốn có ai đó không đi tù.
Dialogue: 0,0:27:53.67,0:27:55.42,Default,,0,0,0,,Cứ như quảng cáo chống tội phạm.
Dialogue: 0,0:27:55.51,0:27:59.51,Default,,0,0,0,,Chữ ma túy và lừa đảo in đậm\Nnhư áp phích ở đồn cảnh sát.
Dialogue: 0,0:27:59.59,0:28:00.97,Default,,0,0,0,,Là kiểu: "Quyết nói không".
Dialogue: 0,0:28:02.14,0:28:04.73,Default,,0,0,0,,Tôi muốn một chàng trai\Nnghiêm túc biết giữ lời.
Dialogue: 0,0:28:04.81,0:28:07.60,Default,,0,0,0,,Tôi không chịu nổi kiểu trẻ trâu hổ giấy.
Dialogue: 0,0:28:07.69,0:28:11.44,Default,,0,0,0,,Gần đây tôi chưa được cảm thấy nữ tính.\NTôi quên mất cách rồi.
Dialogue: 0,0:28:12.61,0:28:15.07,Default,,0,0,0,,Nên ai đó làm ơn giúp tôi tìm lại.
Dialogue: 0,0:28:17.11,0:28:18.11,Default,,0,0,0,,Chào mừng, sao rồi?
Dialogue: 0,0:28:18.20,0:28:20.66,Default,,0,0,0,,Chào mừng, sao rồi!\NChào mừng đến Đội Sao rồi.
Dialogue: 0,0:28:20.74,0:28:21.70,Default,,0,0,0,,Trời!
Dialogue: 0,0:28:22.24,0:28:23.37,Default,,0,0,0,,Mọi người căng ghê.
Dialogue: 0,0:28:23.45,0:28:24.37,Default,,0,0,0,,Căng?
Dialogue: 0,0:28:24.45,0:28:26.20,Default,,0,0,0,,- Thích đó.\N- Căng à?
Dialogue: 0,0:28:26.29,0:28:28.21,Default,,0,0,0,,Ai trông căng nhất?
Dialogue: 0,0:28:28.29,0:28:29.42,Default,,0,0,0,,- Không biết.\N- Không à?
Dialogue: 0,0:28:29.50,0:28:33.55,Default,,0,0,0,,Trông anh như con nghiện đã cai.
Dialogue: 0,0:28:33.63,0:28:34.84,Default,,0,0,0,,Nói năng cẩn thận.
Dialogue: 0,0:28:34.92,0:28:36.09,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:28:37.38,0:28:38.51,Default,,0,0,0,,Cậu ấy không cười.
Dialogue: 0,0:28:38.59,0:28:40.47,Default,,0,0,0,,Cậu ấy không thấy vui thật hả?
Dialogue: 0,0:28:41.22,0:28:43.93,Default,,0,0,0,,Ấn tượng đầu tiên.\NAnh chàng nào giống gu của cô nhất?
Dialogue: 0,0:28:44.47,0:28:46.14,Default,,0,0,0,,Ồ, gu của tôi à?
Dialogue: 0,0:28:46.22,0:28:47.39,Default,,0,0,0,,Tôi thích mặt cậu ấy.
Dialogue: 0,0:28:48.89,0:28:50.85,Default,,0,0,0,,Cảm ơn cô.
Dialogue: 0,0:28:50.94,0:28:53.11,Default,,0,0,0,,Tôi thích chàng trai biết mình là ai.
Dialogue: 0,0:28:53.19,0:28:58.20,Default,,0,0,0,,Tôi không chịu nổi mấy người yếu đuối\Nẩn nấp dưới lớp da xăm trổ.
Dialogue: 0,0:28:58.28,0:29:02.12,Default,,0,0,0,,Tôi tìm kiếm một người\Nbiết chấp nhận và yêu bản thân.
Dialogue: 0,0:29:05.03,0:29:05.87,Default,,0,0,0,,Ôi thôi.
Dialogue: 0,0:29:05.95,0:29:07.20,Default,,0,0,0,,Chuyện gì thế?
Dialogue: 0,0:29:07.29,0:29:09.71,Default,,0,0,0,,- Chào mừng.\N- Ngồi cạnh cô gái tôi thích thôi.
Dialogue: 0,0:29:09.79,0:29:11.21,Default,,0,0,0,,Hợp lý.
Dialogue: 0,0:29:11.29,0:29:12.54,Default,,0,0,0,,Giới thiệu bản thân nha.
Dialogue: 0,0:29:12.63,0:29:14.17,Default,,0,0,0,,Được, xin bắt đầu.
Dialogue: 0,0:29:14.25,0:29:15.92,Default,,0,0,0,,Tôi là Tai-chan. Năm nay 22 tuổi.
Dialogue: 0,0:29:16.00,0:29:16.83,Default,,0,0,0,,Vâng.
Dialogue: 0,0:29:16.92,0:29:18.30,Default,,0,0,0,,Tôi đến từ Tokyo.
Dialogue: 0,0:29:18.38,0:29:19.59,Default,,0,0,0,,Hay quá.
Dialogue: 0,0:29:19.67,0:29:21.09,Default,,0,0,0,,- Cậu làm gì?\N- Tạo mẫu tóc.
Dialogue: 0,0:29:21.18,0:29:23.27,Default,,0,0,0,,- Hân hạnh.\N- Cũng vậy.
Dialogue: 0,0:29:23.34,0:29:24.38,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:29:24.47,0:29:26.31,Default,,0,0,0,,- Bài kiểm tra nhân cách mới.\N- Gì đây?
Dialogue: 0,0:29:27.43,0:29:28.47,Default,,0,0,0,,Khó chịu vãi.
Dialogue: 0,0:29:28.56,0:29:29.94,Default,,0,0,0,,- Bài mới.\N- Giống MBTI.
Dialogue: 0,0:29:30.02,0:29:32.02,Default,,0,0,0,,Gì cơ? Gì đó em bé à?
Dialogue: 0,0:29:32.10,0:29:33.10,Default,,0,0,0,,Tự dưng bỏ đi à?
Dialogue: 0,0:29:33.19,0:29:34.32,Default,,0,0,0,,Bỏ đi rồi.
Dialogue: 0,0:29:34.40,0:29:35.65,Default,,0,0,0,,Chắc là không vui.
Dialogue: 0,0:29:35.73,0:29:36.61,Default,,0,0,0,,Không vui?
Dialogue: 0,0:29:36.69,0:29:39.53,Default,,0,0,0,,- Kệ đi vậy.\N- Đi vệ sinh đã.
Dialogue: 0,0:29:40.24,0:29:41.49,Default,,0,0,0,,Anh ấy đi mất rồi à?
Dialogue: 0,0:29:41.57,0:29:42.65,Default,,0,0,0,,Đi mất rồi.
Dialogue: 0,0:29:42.74,0:29:44.07,Default,,0,0,0,,- Toàn thế à?\N- Mệt thôi.
Dialogue: 0,0:29:50.66,0:29:51.62,Default,,0,0,0,,Anh không sao chứ?
Dialogue: 0,0:29:51.71,0:29:53.46,Default,,0,0,0,,- Anh giận à?\N- Tôi bực lắm.
Dialogue: 0,0:29:53.54,0:29:55.50,Default,,0,0,0,,Tôi lập tức xem phản ứng của anh.
Dialogue: 0,0:29:55.59,0:29:59.64,Default,,0,0,0,,Ai lại nói: "Trông như con nghiện"\Nvới người vừa gặp chứ? Cô ta sao vậy?
Dialogue: 0,0:30:00.22,0:30:03.43,Default,,0,0,0,,Không phải tôi quan tâm\Nđến người khác hơn cô đâu.
Dialogue: 0,0:30:03.51,0:30:07.18,Default,,0,0,0,,Cô ta là ai cũng kệ.\NCó khi là củ khoai tây luôn đi.
Dialogue: 0,0:30:07.26,0:30:09.18,Default,,0,0,0,,Vụ đó làm tôi thấy bực cả mình.
Dialogue: 0,0:30:09.27,0:30:11.94,Default,,0,0,0,,Một con mụ ở đâu chui ra\Nvà gọi tôi là con nghiện.
Dialogue: 0,0:30:12.02,0:30:13.36,Default,,0,0,0,,Chắc cô ta là kiểu vô tri.
Dialogue: 0,0:30:14.48,0:30:18.07,Default,,0,0,0,,Cô ta bảo tôi giống con nghiện.\NKhác xa tinh thần "sao rồi".
Dialogue: 0,0:30:18.57,0:30:19.91,Default,,0,0,0,,Đừng hòng tôi "sao rồi"!
Dialogue: 0,0:30:20.40,0:30:22.24,Default,,0,0,0,,Không hiểu "sao rồi" là gì nữa.
Dialogue: 0,0:30:22.32,0:30:25.45,Default,,0,0,0,,Thế "sao rồi" là gì? Không kịp hiểu luôn.
Dialogue: 0,0:30:25.53,0:30:28.07,Default,,0,0,0,,- "Khác xa tinh thần 'sao rồi'".\N- Đừng hòng.
Dialogue: 0,0:30:28.70,0:30:30.66,Default,,0,0,0,,Không biết cô ta sẽ tung chiêu gì.
Dialogue: 0,0:30:30.75,0:30:31.71,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:30:36.58,0:30:39.96,Default,,0,0,0,,Nếu phải miêu tả bản thân,\Ncậu sẽ nói sao, Bo?
Dialogue: 0,0:30:40.05,0:30:44.56,Default,,0,0,0,,Nếu tôi phải miêu tả bản thân\Ntrong một từ, thì chắc là hay đùa.
Dialogue: 0,0:30:45.05,0:30:46.89,Default,,0,0,0,,Hình như chúng ta bằng tuổi.
Dialogue: 0,0:30:46.97,0:30:47.97,Default,,0,0,0,,Tôi sinh năm 1998.
Dialogue: 0,0:30:48.05,0:30:48.93,Default,,0,0,0,,Phải.
Dialogue: 0,0:30:49.01,0:30:51.81,Default,,0,0,0,,Không ngờ có người\Nbằng tuổi tôi sẽ xuất hiện.
Dialogue: 0,0:30:51.89,0:30:53.31,Default,,0,0,0,,Vậy 1998 hả? Năm Dần?
Dialogue: 0,0:30:53.39,0:30:55.81,Default,,0,0,0,,- Dần.\N- Tôi cũng thế!
Dialogue: 0,0:30:56.52,0:30:58.02,Default,,0,0,0,,Sao hồi trước lại đi tù?
Dialogue: 0,0:30:58.11,0:31:00.15,Default,,0,0,0,,Hành hung, tống tiền và…
Dialogue: 0,0:31:00.23,0:31:02.48,Default,,0,0,0,,Chưa phải là tất cả hả?
Dialogue: 0,0:31:02.57,0:31:04.41,Default,,0,0,0,,Và cả chơi ma túy đá nữa.
Dialogue: 0,0:31:04.49,0:31:06.58,Default,,0,0,0,,Ma túy đá? Ý anh là đá đó hả?
Dialogue: 0,0:31:06.66,0:31:07.58,Default,,0,0,0,,Ừ.
Dialogue: 0,0:31:07.66,0:31:10.12,Default,,0,0,0,,Cho tôi xem cánh tay đi.
Dialogue: 0,0:31:12.95,0:31:14.03,Default,,0,0,0,,Tôi chỉ hút thôi.
Dialogue: 0,0:31:14.12,0:31:14.95,Default,,0,0,0,,Hút à?
Dialogue: 0,0:31:19.84,0:31:24.93,Default,,0,0,0,,Để chào mừng học sinh chuyển trường,\Ntối nay các bạn được uống rượu.
Dialogue: 0,0:31:25.01,0:31:26.64,Default,,0,0,0,,- Tiệc chào mừng!\N- Được đó!
Dialogue: 0,0:31:26.72,0:31:29.43,Default,,0,0,0,,Cô có muốn hỏi gì chúng tôi không?
Dialogue: 0,0:31:29.51,0:31:33.35,Default,,0,0,0,,Hỏi à? Tôi chưa biết gì nhiều để hỏi.
Dialogue: 0,0:31:33.43,0:31:34.81,Default,,0,0,0,,Chúng ta giới thiệu nhé?
Dialogue: 0,0:31:34.89,0:31:36.81,Default,,0,0,0,,Thế thì thật cảm kích.
Dialogue: 0,0:31:36.90,0:31:39.57,Default,,0,0,0,,Ơ, nhưng bữa trưa làm rồi mà.
Dialogue: 0,0:31:39.65,0:31:41.49,Default,,0,0,0,,Nếu quên tên thì cứ hỏi.
Dialogue: 0,0:31:41.57,0:31:43.53,Default,,0,0,0,,Cô ấy làm sao nhớ hết tên được.
Dialogue: 0,0:31:45.28,0:31:46.62,Default,,0,0,0,,Mừng chúng ta!
Dialogue: 0,0:31:46.70,0:31:48.37,Default,,0,0,0,,- Cạn ly!\N- Cạn ly!
Dialogue: 0,0:31:51.74,0:31:54.70,Default,,0,0,0,,Cô ấy không hẳn được chào đón lắm nhỉ?
Dialogue: 0,0:31:54.79,0:31:55.79,Default,,0,0,0,,Nhỉ?
Dialogue: 0,0:31:57.04,0:31:59.21,Default,,0,0,0,,Mọi người có vẻ rất thân thiết rồi.
Dialogue: 0,0:31:59.71,0:32:03.21,Default,,0,0,0,,Tôi sẽ nói thật với cô.
Dialogue: 0,0:32:03.30,0:32:07.35,Default,,0,0,0,,Tôi vẫn chưa chấp nhận được việc\Ntự dưng có học sinh chuyển trường.
Dialogue: 0,0:32:10.01,0:32:13.01,Default,,0,0,0,,Tôi chuyển đến Tokyo năm 20 tuổi.
Dialogue: 0,0:32:13.10,0:32:15.69,Default,,0,0,0,,Tôi không có bạn bè\Nngoài những người ở quê.
Dialogue: 0,0:32:15.77,0:32:19.02,Default,,0,0,0,,Tôi không phải người dễ tin tưởng.
Dialogue: 0,0:32:19.10,0:32:21.73,Default,,0,0,0,,Nhưng tôi coi những người ở đây là bạn bè
Dialogue: 0,0:32:21.81,0:32:25.11,Default,,0,0,0,,vì chúng tôi đã chia sẻ\Nvề cuộc đời và quá khứ của mình.
Dialogue: 0,0:32:25.19,0:32:28.11,Default,,0,0,0,,Không nói với cô\Nthì thật là không trung thực.
Dialogue: 0,0:32:28.20,0:32:29.91,Default,,0,0,0,,Thế nên tôi mới nói.
Dialogue: 0,0:32:29.99,0:32:34.16,Default,,0,0,0,,Hãy hiểu rằng tôi không thân thiện lắm.
Dialogue: 0,0:32:35.66,0:32:37.70,Default,,0,0,0,,Họ khó tính với người mới ghê.
Dialogue: 0,0:32:39.21,0:32:42.17,Default,,0,0,0,,Này, nói chuyện riêng nha?
Dialogue: 0,0:32:43.59,0:32:46.43,Default,,0,0,0,,Tôi dễ dựng lông nhím lắm.
Dialogue: 0,0:32:46.51,0:32:49.89,Default,,0,0,0,,Tôi không chịu nổi người lạ.
Dialogue: 0,0:32:49.97,0:32:52.68,Default,,0,0,0,,Tôi hiểu ý cô, nhưng nói vậy\Nchẳng thay đổi được gì.
Dialogue: 0,0:32:52.76,0:32:54.68,Default,,0,0,0,,Tôi biết là sẽ không.
Dialogue: 0,0:32:54.76,0:32:58.22,Default,,0,0,0,,Nhưng sẽ mất một lúc\Nđể tôi coi cô là người nhà.
Dialogue: 0,0:32:58.31,0:32:59.31,Default,,0,0,0,,Vậy là sẽ không à?
Dialogue: 0,0:32:59.39,0:33:00.85,Default,,0,0,0,,Chỗ đó thì cô nhầm rồi.
Dialogue: 0,0:33:00.94,0:33:02.90,Default,,0,0,0,,Tôi mong cô khao khát nhiều hơn.
Dialogue: 0,0:33:02.98,0:33:06.94,Default,,0,0,0,,Tôi muốn cô tiếp tục cố gắng,\Ndù cô đang bị yêu cho roi cho vọt.
Dialogue: 0,0:33:07.03,0:33:09.03,Default,,0,0,0,,- Tôi muốn cô cố hơn.\N- Cô mong vậy hả?
Dialogue: 0,0:33:09.11,0:33:10.36,Default,,0,0,0,,Khó lắm đó.
Dialogue: 0,0:33:10.45,0:33:13.45,Default,,0,0,0,,Không phải bảo ai đó quý mình đi\Nthì họ sẽ quý.
Dialogue: 0,0:33:13.53,0:33:16.53,Default,,0,0,0,,- Không thấy thế cũng được.\N- Tôi không muốn coi ai là người nhà
Dialogue: 0,0:33:16.62,0:33:18.04,Default,,0,0,0,,nếu họ không coi tôi như vậy.
Dialogue: 0,0:33:18.12,0:33:21.16,Default,,0,0,0,,Tôi hiểu. Ta đều muốn\Ntìm hiểu người khác trước.
Dialogue: 0,0:33:21.25,0:33:23.59,Default,,0,0,0,,Tôi nghĩ mình nên\Nngười lớn hơn về việc này,
Dialogue: 0,0:33:23.67,0:33:26.59,Default,,0,0,0,,nhưng tôi phải nói với cô\Nvì ta sẽ sống chung.
Dialogue: 0,0:33:26.67,0:33:27.55,Default,,0,0,0,,Phải để cô biết.
Dialogue: 0,0:33:27.63,0:33:33.47,Default,,0,0,0,,Tôi thấy cô đang rất cố gắng\Nđối xử tốt với tôi.
Dialogue: 0,0:33:33.55,0:33:36.05,Default,,0,0,0,,Ta mới gặp nhau hôm nay thôi mà.
Dialogue: 0,0:33:36.14,0:33:40.10,Default,,0,0,0,,Đây là lần đầu tiên\Nchúng ta nói chuyện riêng.
Dialogue: 0,0:33:41.73,0:33:43.23,Default,,0,0,0,,Ta giống nhau hơn ta nghĩ đó.
Dialogue: 0,0:33:43.31,0:33:47.19,Default,,0,0,0,,Nhỉ? Tôi không hòa hợp\Nvới người giống mình.
Dialogue: 0,0:33:47.28,0:33:51.66,Default,,0,0,0,,Nam châm cùng cực đẩy nhau mà.\NTôi nghĩ mình sẽ xung đột.
Dialogue: 0,0:33:52.16,0:33:54.75,Default,,0,0,0,,Là học sinh chuyển trường\Ntới đây thật khó khăn.
Dialogue: 0,0:33:54.82,0:33:56.03,Default,,0,0,0,,Hẳn rồi.
Dialogue: 0,0:33:56.12,0:33:57.29,Default,,0,0,0,,Cô ấy đang chống đỡ.
Dialogue: 0,0:33:57.37,0:34:03.25,Default,,0,0,0,,Tôi đã nói chuyện với Ma-kun, anh ấy bảo\Ntôi nên xin lỗi vì nói Ari là con nghiện.
Dialogue: 0,0:34:03.33,0:34:07.92,Default,,0,0,0,,Anh ấy nói có lý,\Nnên tôi sẽ tìm cơ hội xin lỗi.
Dialogue: 0,0:34:09.92,0:34:10.96,Default,,0,0,0,,Ari, anh rảnh không?
Dialogue: 0,0:34:11.05,0:34:12.38,Default,,0,0,0,,- Tôi hả?\N- Vâng.
Dialogue: 0,0:34:14.30,0:34:16.01,Default,,0,0,0,,Có một chuyện tôi muốn nói.
Dialogue: 0,0:34:16.10,0:34:16.98,Default,,0,0,0,,Gì vậy?
Dialogue: 0,0:34:17.06,0:34:20.61,Default,,0,0,0,,- Hôm nay lúc tôi xuất hiện đó.\N- Ừ?
Dialogue: 0,0:34:20.68,0:34:25.14,Default,,0,0,0,,Và ban đầu tôi ngồi cạnh anh?
Dialogue: 0,0:34:25.23,0:34:29.57,Default,,0,0,0,,Tôi kiểu hơi cuốn quá\Nvà nói anh trông như con nghiện.
Dialogue: 0,0:34:29.65,0:34:31.99,Default,,0,0,0,,Tôi thật sự chỉ đùa thôi.
Dialogue: 0,0:34:32.07,0:34:33.28,Default,,0,0,0,,À, phải.
Dialogue: 0,0:34:33.36,0:34:34.74,Default,,0,0,0,,Tôi chỉ nói lung tung thôi.
Dialogue: 0,0:34:34.82,0:34:37.20,Default,,0,0,0,,Và tôi muốn xin lỗi vì chuyện đó.
Dialogue: 0,0:34:37.28,0:34:38.11,Default,,0,0,0,,Ồ, được rồi.
Dialogue: 0,0:34:38.20,0:34:40.58,Default,,0,0,0,,- Tôi muốn xin lỗi.\N- Thế à?
Dialogue: 0,0:34:40.66,0:34:45.96,Default,,0,0,0,,Một bạn trai cũ của tôi từng nghiện ngập,\Nvà anh ta hay bóp cổ hoặc đè tôi ra.
Dialogue: 0,0:34:46.04,0:34:52.42,Default,,0,0,0,,Nên tôi có cảm xúc mãnh liệt về chuyện đó.\NĐiều đó nói thật là quá thành kiến.
Dialogue: 0,0:34:53.13,0:34:57.05,Default,,0,0,0,,Thậm chí trong bối cảnh nhạc rap,\Nđó là một phần trong văn hóa đó.
Dialogue: 0,0:34:57.14,0:34:59.18,Default,,0,0,0,,Có một số rapper chơi đồ.
Dialogue: 0,0:34:59.26,0:35:03.43,Default,,0,0,0,,Một người bạn rapper của tôi\Nlà con nghiện đấy.
Dialogue: 0,0:35:03.52,0:35:08.65,Default,,0,0,0,,Cậu ta mắc sai lầm suốt.\NNghiện ma túy rất nặng.
Dialogue: 0,0:35:08.73,0:35:10.98,Default,,0,0,0,,Cảnh sát suốt ngày truy đuổi.
Dialogue: 0,0:35:11.07,0:35:14.82,Default,,0,0,0,,Có hôm chúng tôi đi gặp nhau\Ntrước kèo diễn, cảnh sát ập tới.
Dialogue: 0,0:35:14.90,0:35:17.07,Default,,0,0,0,,Họ bắt hết cả lũ.
Dialogue: 0,0:35:17.16,0:35:19.96,Default,,0,0,0,,Họ cũng bắt tôi xét nghiệm ma túy.
Dialogue: 0,0:35:20.03,0:35:22.91,Default,,0,0,0,,Tôi bị đưa về đồn tra khảo các kiểu,
Dialogue: 0,0:35:23.00,0:35:26.55,Default,,0,0,0,,và chúng tôi phải hủy\Nmột đống chương trình.
Dialogue: 0,0:35:26.62,0:35:29.58,Default,,0,0,0,,Tôi kiểu, làm thế để làm gì?
Dialogue: 0,0:35:29.67,0:35:33.05,Default,,0,0,0,,- Khiến bạn bè bị vạ lây.\N- Dù anh đang cố hết sức…
Dialogue: 0,0:35:33.13,0:35:36.09,Default,,0,0,0,,Kể từ đó, tôi ghét ma túy lắm.
Dialogue: 0,0:35:36.18,0:35:37.01,Default,,0,0,0,,Anh ghét hả?
Dialogue: 0,0:35:37.09,0:35:40.68,Default,,0,0,0,,Tôi nhận việc từ cơ quan nhà nước suốt,
Dialogue: 0,0:35:40.76,0:35:42.97,Default,,0,0,0,,nên tôi quyết không bao giờ chơi đồ.
Dialogue: 0,0:35:43.06,0:35:45.40,Default,,0,0,0,,Tôi tránh xa mấy nơi có người chơi đồ.
Dialogue: 0,0:35:45.48,0:35:47.11,Default,,0,0,0,,Giờ tôi thấy có lỗi quá.
Dialogue: 0,0:35:47.19,0:35:51.11,Default,,0,0,0,,Không sao. Tôi không nói\Nthì cô cũng không biết.
Dialogue: 0,0:35:51.19,0:35:55.07,Default,,0,0,0,,Cô xin lỗi rồi mà,\Ntôi sẽ không để bụng đâu.
Dialogue: 0,0:35:55.15,0:35:59.45,Default,,0,0,0,,Tôi chỉ muốn cô biết\Ntôi đã trải qua những chuyện này.
Dialogue: 0,0:35:59.53,0:36:00.61,Default,,0,0,0,,Vâng, tôi xin lỗi.
Dialogue: 0,0:36:00.70,0:36:01.91,Default,,0,0,0,,- Không sao.\N- Thật đó.
Dialogue: 0,0:36:01.99,0:36:03.70,Default,,0,0,0,,- Cô ấy xin lỗi rồi.\N- Tốt quá.
Dialogue: 0,0:36:03.79,0:36:05.96,Default,,0,0,0,,Tôi có cái nhìn mới về rapper rồi.
Dialogue: 0,0:36:07.50,0:36:09.29,Default,,0,0,0,,Cô ấy bảo có cái nhìn mới về rapper.
Dialogue: 0,0:36:09.38,0:36:10.21,Default,,0,0,0,,Nghe mà mừng.
Dialogue: 0,0:36:10.29,0:36:11.54,Default,,0,0,0,,Nghe mà mừng?
Dialogue: 0,0:36:11.63,0:36:14.30,Default,,0,0,0,,- Nghe mà mừng.\N- Anh cũng thế.
Dialogue: 0,0:36:14.38,0:36:16.59,Default,,0,0,0,,Ai cũng cho rằng rapper đều chơi đồ.
Dialogue: 0,0:36:16.67,0:36:18.38,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:36:18.47,0:36:23.52,Default,,0,0,0,,Khi hip hop bắt đầu\Ngây tiếng vang vào thập niên 80,
Dialogue: 0,0:36:23.60,0:36:25.81,Default,,0,0,0,,chuyện đó ở khắp nơi.
Dialogue: 0,0:36:26.31,0:36:32.82,Default,,0,0,0,,Bạo lực và kỳ thị chủng tộc\Nở Mỹ hồi đó cũng như vậy.
Dialogue: 0,0:36:32.90,0:36:37.15,Default,,0,0,0,,Nên người ta hát rap\Nđể thoát khỏi khốn cảnh.
Dialogue: 0,0:36:37.24,0:36:38.20,Default,,0,0,0,,- Phải.\N- Ra vậy.
Dialogue: 0,0:36:38.28,0:36:43.79,Default,,0,0,0,,Họ rap về môi trường\Nđể thoát khỏi tình cảnh đó.
Dialogue: 0,0:36:44.49,0:36:50.79,Default,,0,0,0,,Và vì loại nhạc giúp đỡ họ,\Nnên chúng ta bắt đầu thấy hay.
Dialogue: 0,0:36:50.88,0:36:53.13,Default,,0,0,0,,Ta vẫn chưa thoát khỏi tư tưởng đó.
Dialogue: 0,0:36:53.21,0:36:54.46,Default,,0,0,0,,Cũng có lý.
Dialogue: 0,0:36:54.55,0:36:56.93,Default,,0,0,0,,Một nhân vật mới nhập hội…
Dialogue: 0,0:36:57.01,0:36:59.22,Default,,0,0,0,,Anh tưởng em bảo "một tội phạm nhập hội".
Dialogue: 0,0:37:00.05,0:37:02.43,Default,,0,0,0,,Thời đại thay đổi nhiều quá.
Dialogue: 0,0:37:02.51,0:37:04.60,Default,,0,0,0,,- Chưa đâu.\N- Anh kiểu: "Họ toàn tội phạm!"
Dialogue: 0,0:37:04.68,0:37:06.39,Default,,0,0,0,,- Cả ê kíp luôn.\N- Đâu có.
Dialogue: 0,0:37:06.47,0:37:07.30,Default,,0,0,0,,Không à? Xin lỗi.
Dialogue: 0,0:37:07.39,0:37:10.02,Default,,0,0,0,,- Không được lên Netflix đâu.\N- Xin lỗi.
Dialogue: 0,0:37:10.10,0:37:11.56,Default,,0,0,0,,KHU TRÒ CHƠI
Dialogue: 0,0:37:11.65,0:37:13.15,Default,,0,0,0,,Này, hay quá.
Dialogue: 0,0:37:13.23,0:37:14.06,Default,,0,0,0,,Hay quá!
Dialogue: 0,0:37:14.15,0:37:15.44,Default,,0,0,0,,- Thêm nữa.\N- Cô ấy giỏi.
Dialogue: 0,0:37:15.52,0:37:17.06,Default,,0,0,0,,- Chơi nè.\N- Hay quá.
Dialogue: 0,0:37:17.15,0:37:18.44,Default,,0,0,0,,Tôi nhắm vào hồng tâm.
Dialogue: 0,0:37:18.95,0:37:21.41,Default,,0,0,0,,- Ừ, không.\N- Đến lượt tôi hả?
Dialogue: 0,0:37:21.49,0:37:23.08,Default,,0,0,0,,Nào!
Dialogue: 0,0:37:24.20,0:37:25.53,Default,,0,0,0,,Đừng tán nhau nữa.
Dialogue: 0,0:37:25.62,0:37:27.41,Default,,0,0,0,,- Ồ?\N- Họ cứ dính lấy nhau.
Dialogue: 0,0:37:27.50,0:37:30.75,Default,,0,0,0,,Cô ấy chủ động\Nđến chỗ tôi như vậy thật dễ thương.
Dialogue: 0,0:37:31.87,0:37:34.29,Default,,0,0,0,,Không còn chỉ thích nữa. Tôi yêu mất rồi.
Dialogue: 0,0:37:35.25,0:37:37.59,Default,,0,0,0,,Cô ấy chiếm mất trái tim tôi rồi.
Dialogue: 0,0:37:38.09,0:37:40.43,Default,,0,0,0,,Hôm nay tôi yêu cô ấy, mai tôi cũng yêu.
Dialogue: 0,0:37:40.93,0:37:43.72,Default,,0,0,0,,Tôi đổ Ruru rầm rầm rồi. Cạn ly!
Dialogue: 0,0:37:52.69,0:37:54.82,Default,,0,0,0,,- Ôi, hay thế.\N- Ừ.
Dialogue: 0,0:37:54.90,0:37:56.57,Default,,0,0,0,,Họ là tình địch mà vẫn…
Dialogue: 0,0:37:56.65,0:37:58.44,Default,,0,0,0,,Tai-chan là nhà tạo mẫu tóc mà.
Dialogue: 0,0:38:00.49,0:38:02.37,Default,,0,0,0,,- Cảm ơn Taisei.\N- Vâng.
Dialogue: 0,0:38:05.28,0:38:06.57,Default,,0,0,0,,Cậu ấy dễ chịu ghê.
Dialogue: 0,0:38:06.66,0:38:07.83,Default,,0,0,0,,Càng đẹp khi làm việc.
Dialogue: 0,0:38:07.91,0:38:09.08,Default,,0,0,0,,- Nhỉ?\N- Phải.
Dialogue: 0,0:38:09.16,0:38:11.83,Default,,0,0,0,,Không ngờ nhà tạo mẫu tóc\Nlắm hình xăm thế.
Dialogue: 0,0:38:11.91,0:38:14.16,Default,,0,0,0,,Ừ, tôi cũng không ngờ.
Dialogue: 0,0:38:14.25,0:38:15.71,Default,,0,0,0,,Tôi tưởng cậu là rapper kìa.
Dialogue: 0,0:38:15.79,0:38:18.75,Default,,0,0,0,,- Thế à?\N- Ban đầu tôi tưởng cậu là vậy cơ.
Dialogue: 0,0:38:18.84,0:38:21.09,Default,,0,0,0,,- Trông giống mà.\N- Tôi nghĩ, lắm rapper thế.
Dialogue: 0,0:38:21.17,0:38:24.05,Default,,0,0,0,,Kiểu rapper, xã hội đen, rapper.
Dialogue: 0,0:38:24.55,0:38:25.38,Default,,0,0,0,,Xong rồi.
Dialogue: 0,0:38:25.47,0:38:27.35,Default,,0,0,0,,Cảm ơn nha.
Dialogue: 0,0:38:27.85,0:38:29.64,Default,,0,0,0,,Được đó. Đẹp lắm.
Dialogue: 0,0:38:36.81,0:38:38.69,Default,,0,0,0,,Chúng ta có học sinh chuyển trường mới.
Dialogue: 0,0:38:38.77,0:38:40.11,Default,,0,0,0,,Hả? Đủ rồi đó.
Dialogue: 0,0:38:40.19,0:38:41.44,Default,,0,0,0,,Khoan, trật tự.
Dialogue: 0,0:38:41.53,0:38:42.66,Default,,0,0,0,,Thật à?
Dialogue: 0,0:38:42.74,0:38:45.24,Default,,0,0,0,,Mời mọi người gặp mặt\Nhọc sinh mới trong lớp.
Dialogue: 0,0:38:45.32,0:38:46.53,Default,,0,0,0,,Hả?
Dialogue: 0,0:38:46.62,0:38:47.71,Default,,0,0,0,,Một chàng trai?
Dialogue: 0,0:38:47.78,0:38:48.95,Default,,0,0,0,,Hẳn là thế nhỉ?
Dialogue: 0,0:38:49.04,0:38:50.83,Default,,0,0,0,,Này!
Dialogue: 0,0:38:58.04,0:38:58.87,Default,,0,0,0,,Một chàng trai.
Dialogue: 0,0:38:58.96,0:39:00.55,Default,,0,0,0,,Ồ, cá tính ghê.
Dialogue: 0,0:39:01.55,0:39:03.89,Default,,0,0,0,,Trông đẹp trai đấy.
Dialogue: 0,0:39:11.39,0:39:15.31,Default,,0,0,0,,TÌNH YÊU NỔI LOẠN\NHỌC VIỆN HÀNG HẢI
Dialogue: 0,0:39:27.20,0:39:28.24,Default,,0,0,0,,Phản ứng gì vậy?
Dialogue: 0,0:39:28.32,0:39:30.24,Default,,0,0,0,,- Hả?\N- Hẳn là thấy nóng bỏng quá.
Dialogue: 0,0:39:31.54,0:39:32.92,Default,,0,0,0,,Hả?
Dialogue: 0,0:39:34.91,0:39:38.83,Default,,0,0,0,,Xin chào. Tôi tên là Shioda Kazuma.
Dialogue: 0,0:39:38.92,0:39:40.34,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:39:43.96,0:39:45.09,Default,,0,0,0,,Gọi tôi là Kazu-kun.
Dialogue: 0,0:39:45.17,0:39:46.38,Default,,0,0,0,,SHIODA KAZUMA\NHAY KAZU-KUN
Dialogue: 0,0:39:46.47,0:39:49.85,Default,,0,0,0,,Tôi điều hành CLB tiếp viên.
Dialogue: 0,0:39:50.60,0:39:56.48,Default,,0,0,0,,Tôi luôn sống một mình,\Ntiếp xúc với bạo lực như cơm bữa.
Dialogue: 0,0:39:56.56,0:39:59.23,Default,,0,0,0,,Cả đời tôi đã luôn nổi tiếng.
Dialogue: 0,0:39:59.31,0:40:02.52,Default,,0,0,0,,Tôi không nhớ\Nmình đã cặp với bao nhiêu người nữa.
Dialogue: 0,0:40:03.03,0:40:06.53,Default,,0,0,0,,Mọi người có đếm\Nsố lần mình ăn thịt không?
Dialogue: 0,0:40:07.28,0:40:12.99,Default,,0,0,0,,Tôi có ngoại hình, có tiền,\Ncó khiếu hài hước và cá tính.
Dialogue: 0,0:40:14.04,0:40:16.13,Default,,0,0,0,,Tôi thích khuôn mặt mình lắm.
Dialogue: 0,0:40:16.87,0:40:19.29,Default,,0,0,0,,Ngày nào cũng nghĩ:\N"Trời, là mình thật thích".
Dialogue: 0,0:40:19.38,0:40:21.09,Default,,0,0,0,,Tôi kiểu: "Chào soái ca".
Dialogue: 0,0:40:23.13,0:40:25.55,Default,,0,0,0,,- Cảm ơn nhá.\N- Anh chàng này cá tính đây.
Dialogue: 0,0:40:25.63,0:40:26.80,Default,,0,0,0,,Gần như là làn gió mới.
Dialogue: 0,0:40:26.88,0:40:29.88,Default,,0,0,0,,Ruru khóa mục tiêu\Nngay từ ánh nhìn đầu tiên.
Dialogue: 0,0:40:29.97,0:40:32.31,Default,,0,0,0,,Ai lại như thế chứ?
Dialogue: 0,0:40:33.01,0:40:35.22,Default,,0,0,0,,Kiểu phụ nữ trung niên mê mẩn sao K-pop.
Dialogue: 0,0:40:35.31,0:40:36.98,Default,,0,0,0,,"Chà! Cậu ấy đẹp trai quá!"
Dialogue: 0,0:40:37.06,0:40:41.31,Default,,0,0,0,,Không sao vì cô ấy còn trẻ mà,\Nnhưng có thể hình dung lúc cô ấy lớn hơn.
Dialogue: 0,0:40:41.40,0:40:44.07,Default,,0,0,0,,Cô ấy là kiểu mê mẩn idol Hàn Quốc.
Dialogue: 0,0:40:44.57,0:40:46.61,Default,,0,0,0,,Nhưng hơi lộ liễu quá.
Dialogue: 0,0:40:46.69,0:40:48.28,Default,,0,0,0,,Họ là bạn bè hay gì chăng?
Dialogue: 0,0:40:48.95,0:40:53.83,Default,,0,0,0,,Tôi năm nay 29 tuổi, đến từ Toyama.
Dialogue: 0,0:40:53.91,0:40:55.20,Default,,0,0,0,,KAZU-KUN\NTOKYO - CHỦ CLB
Dialogue: 0,0:40:55.29,0:40:59.38,Default,,0,0,0,,Để mọi người biết, tôi tới để tìm\Ntình yêu, không phải kết bạn với anh em.
Dialogue: 0,0:41:03.79,0:41:05.92,Default,,0,0,0,,Hân hạnh được gặp, các chị em.
Dialogue: 0,0:41:06.01,0:41:07.64,Default,,0,0,0,,- Hân hạnh.\N- Biến đi.
Dialogue: 0,0:41:07.72,0:41:08.76,Default,,0,0,0,,Vậy thì biến đi.
Dialogue: 0,0:41:09.26,0:41:11.39,Default,,0,0,0,,Ở đây không có chỗ cho cậu.
Dialogue: 0,0:41:11.47,0:41:13.14,Default,,0,0,0,,Không tới để kết bạn hả?
Dialogue: 0,0:41:13.22,0:41:15.39,Default,,0,0,0,,- Không.\N- Vậy đừng ở với bọn này.
Dialogue: 0,0:41:15.47,0:41:16.47,Default,,0,0,0,,Hiểu chưa?
Dialogue: 0,0:41:16.56,0:41:19.15,Default,,0,0,0,,- Ngồi đi.\N- Mày làm sao, thằng ranh?
Dialogue: 0,0:41:19.23,0:41:20.06,Default,,0,0,0,,Ngồi đi.
Dialogue: 0,0:41:20.14,0:41:22.10,Default,,0,0,0,,Đừng có ở với bọn này, ranh con.
Dialogue: 0,0:41:22.19,0:41:24.36,Default,,0,0,0,,Hiểu chưa, thằng ranh?
Dialogue: 0,0:41:24.98,0:41:27.11,Default,,0,0,0,,- Ari nổi nóng rồi.\N- Nhỉ?
Dialogue: 0,0:41:27.19,0:41:28.40,Default,,0,0,0,,Thằng bã đậu.
Dialogue: 0,0:41:28.49,0:41:30.28,Default,,0,0,0,,- Cậu ấy thường rất thân thiện.\N- Ừ.
Dialogue: 0,0:41:39.91,0:41:43.41,Default,,0,0,0,,Các chàng trai, hãy chào mừng\Nhọc sinh chuyển trường mới
Dialogue: 0,0:41:43.50,0:41:47.00,Default,,0,0,0,,bằng cách nấu một bữa tiệc chào mừng.
Dialogue: 0,0:41:47.51,0:41:49.39,Default,,0,0,0,,Tôi đếch nấu.
Dialogue: 0,0:41:49.88,0:41:54.80,Default,,0,0,0,,Tự đi mà nấu, thằng ranh.\NMày bảo không đến để kết bạn mà.
Dialogue: 0,0:41:55.97,0:41:57.81,Default,,0,0,0,,Ngừng lải nhải và nấu cho tôi đi.
Dialogue: 0,0:41:57.89,0:42:01.27,Default,,0,0,0,,Nếu không bắt buộc thì tôi xin kiếu.
Dialogue: 0,0:42:01.35,0:42:03.19,Default,,0,0,0,,Mày bảo không muốn kết bạn mà.
Dialogue: 0,0:42:03.27,0:42:04.44,Default,,0,0,0,,- Ừ.\N- Thì?
Dialogue: 0,0:42:04.94,0:42:06.27,Default,,0,0,0,,Tao phải nấu cho mày?
Dialogue: 0,0:42:06.36,0:42:07.65,Default,,0,0,0,,Họ bảo thì làm đi.
Dialogue: 0,0:42:07.73,0:42:09.57,Default,,0,0,0,,Tự đi mà nấu.
Dialogue: 0,0:42:09.65,0:42:11.32,Default,,0,0,0,,Nghe thông báo rồi đó. Làm theo đi.
Dialogue: 0,0:42:12.24,0:42:13.32,Default,,0,0,0,,Mày làm sao?
Dialogue: 0,0:42:15.49,0:42:16.41,Default,,0,0,0,,Sao?
Dialogue: 0,0:42:16.49,0:42:18.83,Default,,0,0,0,,Mày tự đi mà nấu. Rõ chưa?
Dialogue: 0,0:42:19.33,0:42:21.00,Default,,0,0,0,,Mày nấu.
Dialogue: 0,0:42:23.08,0:42:24.75,Default,,0,0,0,,- Ôi, trời.\N- Thôi nào!
Dialogue: 0,0:42:27.84,0:42:29.18,Default,,0,0,0,,Đi ra đi.
Dialogue: 0,0:42:29.26,0:42:31.47,Default,,0,0,0,,Ra ngoài mà đánh.
Dialogue: 0,0:42:31.55,0:42:33.43,Default,,0,0,0,,Không sao. Cứ ở đây.
Dialogue: 0,0:42:34.59,0:42:36.05,Default,,0,0,0,,Ranh con!
Dialogue: 0,0:42:36.14,0:42:37.81,Default,,0,0,0,,Giữ chặt!
Dialogue: 0,0:42:38.43,0:42:40.18,Default,,0,0,0,,Dừng lại. Bình tĩnh đi.
Dialogue: 0,0:42:40.27,0:42:41.19,Default,,0,0,0,,Thằng ranh!
Dialogue: 0,0:42:41.98,0:42:42.81,Default,,0,0,0,,Không sao.
Dialogue: 0,0:42:42.89,0:42:45.10,Default,,0,0,0,,- Không sao chứ?\N- Sợ quá.
Dialogue: 0,0:42:59.54,0:43:01.50,Default,,0,0,0,,Biên dịch: Trang Tran
