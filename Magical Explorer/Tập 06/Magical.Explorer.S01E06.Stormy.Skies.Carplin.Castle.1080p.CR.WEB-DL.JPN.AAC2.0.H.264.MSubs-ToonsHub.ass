Dialogue: 0,0:00:01.13,0:00:04.68,Default,Hatsumi,0,0,0,,Các em sẽ đến một hầm ngục đặc biệt.
Dialogue: 0,0:00:08.74,0:00:11.21,Default,Kousuke(M),0,0,0,,{\i1}Khoan đã, chuyện này là sao?{\i0}
Dialogue: 0,0:00:11.21,0:00:13.45,Default,Kousuke(M),0,0,0,,{\i1}Sao mình không được lập đội cùng Iori?{\i0}
Dialogue: 0,0:00:13.45,0:00:15.46,Default,Kousuke(M),0,0,0,,{\i1}Còn hầm ngục đặc biệt này rốt cuộc là cái quái gì nữa?!{\i0}
Dialogue: 0,0:00:15.78,0:00:18.57,Default,Ludie,0,0,0,,Chị có thể giải thích rõ hơn\Nđược không ạ? Chuyện này là thế nào?
Dialogue: 0,0:00:19.11,0:00:23.09,Default,Hatsumi,0,0,0,,Chị chắc chắn rằng Kousuke sẽ\Nchẳng gặp chút khó khăn nào trong hầm ngục đó đâu.
Dialogue: 0,0:00:23.53,0:00:26.05,Default,Hatsumi,0,0,0,,Ludie thì đã học được cách\Nrút ngắn thần chú niệm pháp,
Dialogue: 0,0:00:26.05,0:00:28.51,Default,Hatsumi,0,0,0,,lại còn có tận hai người dùng được\Nma pháp trung cấp trong đội.
Dialogue: 0,0:00:28.94,0:00:30.56,Default,Hatsumi,0,0,0,,Từng đó là quá đủ rồi.
Dialogue: 0,0:00:30.56,0:00:31.76,Default,Ludie,0,0,0,,Nhưng mà...
Dialogue: 0,0:00:31.76,0:00:33.84,Default,Hatsumi,0,0,0,,Chị hiểu sự e ngại của em, Ludie.
Dialogue: 0,0:00:33.84,0:00:37.71,Default,Hatsumi,0,0,0,,Đó là lý do chị đã nhờ Mizumori Yukine\Nđể mắt trông chừng hai đứa.
Dialogue: 0,0:00:38.03,0:00:40.33,Default,Hatsumi,0,0,0,,Và theo gợi ý của mẹ chị,\Nthì có cả Nanami đi cùng nữa.
Dialogue: 0,0:00:40.87,0:00:43.68,Default,Nanami,0,0,0,,Bất cứ nơi nào Chủ nhân tới, tôi đều đi theo.
Dialogue: 0,0:00:44.08,0:00:46.58,Default,Nanami,0,0,0,,Cứ gọi tôi là Nanami, thưa tiểu thư Yukine.
Dialogue: 0,0:00:46.58,0:00:48.07,Default,Yukine,0,0,0,,Được thôi.
Dialogue: 0,0:00:48.07,0:00:49.45,Default,Yukine,0,0,0,,Rất vui được gặp cô nhé.
Dialogue: 0,0:00:49.45,0:00:52.28,Default,Ludie,0,0,0,,Nếu chị đã nói vậy...
Dialogue: 0,0:00:52.28,0:00:54.58,Default,Kousuke,0,0,0,,Vậy thì chúng ta xuất phát thôi!
Dialogue: 0,0:00:57.92,0:01:00.25,Default,Ludie,0,0,0,,Phong Búa! (Storm Hammer!)
Dialogue: 0,0:01:05.57,0:01:08.76,Default,Kousuke,0,0,0,,Ước gì mình cũng dùng được\Nma pháp xịn như Ludie nhỉ.
Dialogue: 0,0:01:08.76,0:01:10.80,Default,Kousuke,0,0,0,,Khoan đã, giờ đâu phải lúc\Nđể đứng đây trầm trồ.
Dialogue: 0,0:01:20.00,0:01:22.85,Default,Nanami,0,0,0,,Chủ nhân, sao ngài không dùng\Nphép thuật tấn công tầm xa?
Dialogue: 0,0:01:23.26,0:01:24.97,Default,Kousuke,0,0,0,,Ta chẳng bảo với cô rồi sao?
Dialogue: 0,0:01:24.97,0:01:28.20,Default,Kousuke,0,0,0,,Bẩm sinh ta đã cực kỳ tệ khoản\Nma pháp phóng xuất rồi!
Dialogue: 0,0:01:29.28,0:01:31.54,Default,Kousuke,0,0,0,,Bọn chúng mà cứ giữ khoảng cách\Nthế này thì khoai lắm đấy!
Dialogue: 0,0:01:31.97,0:01:35.85,Default,Yukine,0,0,0,,Người ta thường bảo đứng núi này\Ntrông núi nọ mà.
Dialogue: 0,0:01:38.96,0:01:39.75,Default,Nanami,0,0,0,,Tôi hiểu ý của tiểu thư rồi.
Dialogue: 0,0:01:41.46,0:01:43.71,Default,Ludie,0,0,0,,Đây là cái nút bấm à?
Dialogue: 0,0:01:43.71,0:01:44.80,Default,Kousuke,0,0,0,,Khoan đã! Đừng có bấm!
Dialogue: 0,0:01:45.12,0:01:46.92,Default,Kousuke,0,0,0,,Tuyệt đối đừng ấn vào đó!
Dialogue: 0,0:02:08.26,0:02:10.15,Default,Ludie,0,0,0,,Hả, cái gì thế này?!
Dialogue: 0,0:02:10.15,0:02:11.67,Default,Ludie,0,0,0,,Chúng ta đang ở đâu đây?!
Dialogue: 0,0:02:12.17,0:02:14.58,Default,Yukine,0,0,0,,Chị có linh cảm chẳng lành về chỗ này.
Dialogue: 0,0:02:14.94,0:02:18.46,Default,Kousuke(M),0,0,0,,{\i1}Có nên nói hết tất cả những gì\Nmình biết cho họ không nhỉ?{\i0}
Dialogue: 0,0:02:19.54,0:02:23.42,Default,Kousuke,0,0,0,,Thật ra em từng đọc về nơi này\Nở đâu đó rồi.
Dialogue: 0,0:02:24.37,0:02:25.57,Default,Kousuke,0,0,0,,Hai người còn nhớ không?
Dialogue: 0,0:02:26.19,0:02:28.79,Default,Kousuke,0,0,0,,Cái vụ mà phải tạo dáng gợi cảm ấy?
Dialogue: 0,0:02:30.19,0:02:32.77,Default,Ludie,0,0,0,,Kousuke, đừng nói với tôi là...
Dialogue: 0,0:02:32.77,0:02:35.93,Default,Yukine,0,0,0,,Chúng ta lại phải làm...\Ncái trò đó nữa sao?!
Dialogue: 0,0:02:36.31,0:02:38.43,Default,Kousuke,0,0,0,,Em thành thật xin lỗi hai người!
Dialogue: 0,0:02:38.43,0:02:39.91,Default,Kousuke,0,0,0,,Không phải làm lại trò cũ đâu,
Dialogue: 0,0:02:39.91,0:02:42.06,Default,Kousuke,0,0,0,,nhưng em nghĩ lần này hai người\Ncòn cảm thấy ngượng ngùng hơn gấp bội đấy!
Dialogue: 0,0:02:42.06,0:02:44.01,Default,Ludie,0,0,0,,Lại nữa sao?! Tại sao chứ?!
Dialogue: 0,0:02:44.01,0:02:47.12,Default,Yukine,0,0,0,,Khó khăn lắm chị mới bắt đầu\Nquên được chuyện đó...
Dialogue: 0,0:02:47.12,0:02:49.52,Default,Ludie,0,0,0,,Sao lại xảy ra cơ sự này chứ?!
Dialogue: 0,0:02:51.11,0:02:52.03,Default,Nanami,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:02:52.03,0:02:57.04,sign_4125_47_Stormy_Skies__Ca,SIGN,0,0,0,,{\pos(302.222,9.111)}Phong Vân Biến Sắc! Lâu Đài Carplin
Dialogue: 0,0:02:53.89,0:02:56.14,Default,Nanami,0,0,0,,Xem ra nơi này được gọi là\NLâu đài Carplin.
Dialogue: 0,0:04:28.12,0:04:29.38,Default,Nanami,0,0,0,,Để tôi giải thích cho!
Dialogue: 0,0:04:29.77,0:04:32.15,Default,Nanami,0,0,0,,"Hãy hướng về đích trong khi phải\Nchú ý đến chất dầu bôi trơn!
Dialogue: 0,0:04:32.15,0:04:35.41,Default,Nanami,0,0,0,,Ma pháp bị cấm hoàn toàn,\Nvới chỉ một vài kỹ năng được phép sử dụng!
Dialogue: 0,0:04:35.94,0:04:39.67,Default,Nanami,0,0,0,,Nếu tất cả cùng ngã xuống,\Ncả đội sẽ phải bắt đầu lại từ đầu!
Dialogue: 0,0:04:40.25,0:04:43.63,Default,Nanami,0,0,0,,Hãy cẩn thận, vì nếu chạm vào dầu bôi trơn\Nngười chơi sẽ cảm thấy bị kích thích tột độ!"
Dialogue: 0,0:04:44.62,0:04:45.55,Default,Nanami,0,0,0,,Đó là những gì được viết ở đây.
Dialogue: 0,0:04:45.89,0:04:48.90,Default,Ludie,0,0,0,,D-Dầu bôi trơn khiến người ta\Nbị kích thích sao?!
Dialogue: 0,0:04:49.68,0:04:51.77,Default,Yukine,0,0,0,,Chết tiệt. Phù văn dịch chuyển trở về...
Dialogue: 0,0:04:52.14,0:04:53.29,Default,Yukine,0,0,0,,Không có tác dụng rồi!
Dialogue: 0,0:04:55.24,0:04:58.40,Default,Kousuke(M),0,0,0,,{\i1}Đây chính là hầm ngục do đám quý ông quý bà\Nbiến thái yêu cầu nhà phát triển làm thêm đây mà.{\i0}
Dialogue: 0,0:04:58.97,0:05:00.48,Default,Kousuke(M),0,0,0,,{\i1}Không có đường thoát đâu.{\i0}
Dialogue: 0,0:05:01.28,0:05:02.95,Default,Ludie,0,0,0,,Vậy là lựa chọn duy nhất\Nchỉ có tiến lên thôi sao...
Dialogue: 0,0:05:15.04,0:05:17.29,Default,Yukine,0,0,0,,Chúng ta thực sự phải mặc thế này\Nmà đi tiếp thật sao?
Dialogue: 0,0:05:17.29,0:05:22.69,sign_7608_63_Nanami,SIGN,0,0,0,,{\frz10.3\fs12\pos(420.222,172.11)}Nanami
Dialogue: 0,0:05:17.81,0:05:19.62,Default,Nanami,0,0,0,,Bộ này co giãn tùy ý theo ý muốn.
Dialogue: 0,0:05:20.00,0:05:23.37,Default,Nanami,0,0,0,,Tôi thấy chúng có tiềm năng rất lớn\Nđể làm trang phục chiến đấu đấy.
Dialogue: 0,0:05:24.70,0:05:27.66,Default,Kousuke,0,0,0,,Chất liệu có vẻ xịn hơn hẳn\Nchiếc khăn quàng bình thường của em,
Dialogue: 0,0:05:28.23,0:05:30.31,Default,Kousuke,0,0,0,,cảm giác như nó có thể\Nkéo dài gần như vô hạn vậy...
Dialogue: 0,0:05:31.05,0:05:33.35,Default,Kousuke,0,0,0,,Nhưng quan trọng hơn hết,\Ntại sao em lại phải đóng mỗi cái khố thế này?!
Dialogue: 0,0:05:33.35,0:05:35.75,Default,Kousuke,0,0,0,,Cái này tính là trang phục thể thao\Ndạng đóng khố à?!
Dialogue: 0,0:05:35.75,0:05:37.98,Default,Kousuke,0,0,0,,Không đời nào, kỳ quặc chết đi được ấy chứ?!
Dialogue: 0,0:05:37.98,0:05:39.97,Default,Nanami,0,0,0,,Nhưng nó rất hợp với ngài mà.
Dialogue: 0,0:05:39.97,0:05:41.90,Default,Nanami,0,0,0,,Hợp đến mức tôi chẳng phân biệt nổi\Nđâu mới là Chủ nhân,
Dialogue: 0,0:05:41.90,0:05:43.44,Default,Nanami,0,0,0,,cơ thể ngài hay là chiếc khố kia nữa.
Dialogue: 0,0:05:43.44,0:05:46.10,Default,Kousuke,0,0,0,,Ta nghe mà chẳng hiểu cô\Nđang nói cái quái gì luôn...
Dialogue: 0,0:05:46.10,0:05:49.62,Default,Yukine,0,0,0,,Mà chị lại khá thích phong cách\Nnam tính đầy mạnh mẽ đó đấy.
Dialogue: 0,0:05:50.03,0:05:52.06,Default,Ludie,0,0,0,,Hai người đỉnh thật đấy.
Dialogue: 0,0:05:52.06,0:05:55.62,Default,Ludie,0,0,0,,Tâm trạng tôi tụt xuống đáy rồi,\Nchẳng còn hơi sức đâu mà đùa nữa.
Dialogue: 0,0:05:59.21,0:06:01.00,sign_8613_79_1st_Stage,SIGN,0,0,0,,{\fs20\3c&H000000&\pos(319,293.444)}Màn 1
Dialogue: 0,0:05:59.47,0:06:00.70,Default,Yukine,0,0,0,,{\an8}Bức vẽ này có ý nghĩa gì thế?
Dialogue: 0,0:06:01.00,0:06:01.97,Default,Nanami,0,0,0,,Nó viết là:
Dialogue: 0,0:06:01.97,0:06:03.85,Default,Nanami,0,0,0,,"Một người sẽ phải cưỡi lên lưng\Nmột thành viên khác trong đội,
Dialogue: 0,0:06:03.85,0:06:05.95,Default,Nanami,0,0,0,,trong khi những người còn lại\Nsẽ đẩy thật mạnh về phía trước.
Dialogue: 0,0:06:05.95,0:06:08.42,Default,Nanami,0,0,0,,Nếu dừng lại đúng ngay trên vạch kẻ\Nngay trước khi rơi xuống hồ,
Dialogue: 0,0:06:08.95,0:06:10.05,Default,Nanami,0,0,0,,thì coi như vượt qua màn này."
Dialogue: 0,0:06:11.13,0:06:15.57,Default,Kousuke(M),0,0,0,,{\i1}Lũ nhà phát triển MagiEx rốt cuộc làm cách quái nào\Nmà nghĩ ra được cái trò bựa lòi này vậy trời?{\i0}
Dialogue: 0,0:06:17.06,0:06:20.52,Default,Nanami,0,0,0,,Chủ nhân, tôi nghĩ màn này\Nngài và tôi nên phối hợp cùng nhau.
Dialogue: 0,0:06:20.52,0:06:21.73,Default,Kousuke,0,0,0,,Hả?
Dialogue: 0,0:06:26.94,0:06:29.48,Default,Kousuke,0,0,0,,Chắc chắn người làm tấm đệm ở dưới\Nphải là ta rồi...
Dialogue: 0,0:06:29.90,0:06:31.62,Default,Nanami,0,0,0,,Cảm giác được cưỡi lên người\Nthấy thế nào hả Chủ nhân?
Dialogue: 0,0:06:31.62,0:06:34.28,Default,Kousuke,0,0,0,,Cô đang ăn nói cái quái gì thế hả?!
Dialogue: 0,0:06:37.04,0:06:38.12,Default,Yukine,0,0,0,,Hai người chuẩn bị xong chưa?
Dialogue: 0,0:06:38.37,0:06:39.58,Default,Kousuke,0,0,0,,Khoan đã... ch... chờ...
Dialogue: 0,0:06:39.96,0:06:41.46,Default,Nanami,0,0,0,,Đẩy chúng tôi thật mạnh vào!
Dialogue: 0,0:06:41.46,0:06:43.46,Default,Both,0,0,0,,Cùng nhau nào!
Dialogue: 0,0:06:46.65,0:06:47.72,Default,Nanami,0,0,0,,Chủ nhân!
Dialogue: 0,0:06:47.72,0:06:50.07,Default,Nanami,0,0,0,,Phía trước có vòi phun dầu bôi trơn!
Dialogue: 0,0:06:50.88,0:06:52.42,Default,Kousuke,0,0,0,,Có cả cái thứ đó nữa sao?!
Dialogue: 0,0:06:53.34,0:06:55.06,Default,Kousuke,0,0,0,,Muốn vượt qua thì bắt buộc\Nphải lao thẳng qua nó.
Dialogue: 0,0:06:55.06,0:06:57.55,Default,Kousuke,0,0,0,,Nhưng nếu dính phải nó,\Nchúng ta sẽ bị kích thích mất!
Dialogue: 0,0:06:57.77,0:06:59.43,Default,Kousuke,0,0,0,,Mình phải ráng chịu đựng mới được!
Dialogue: 0,0:07:12.07,0:07:13.20,Default,Kousuke,0,0,0,,Bọn chúng đang cầm thứ gì đó kìa!
Dialogue: 0,0:07:17.97,0:07:18.85,Default,Kousuke,0,0,0,,Chết tiệt thật!
Dialogue: 0,0:07:18.85,0:07:21.13,Default,Kousuke,0,0,0,,Vì dính dầu trơn nên tốc độ\Nvẫn chẳng chịu giảm lại!
Dialogue: 0,0:07:21.13,0:07:22.46,Default,Kousuke,0,0,0,,Cứ đà này thì...
Dialogue: 0,0:07:22.46,0:07:23.25,Default,Kousuke,0,0,0,,Phải rồi!
Dialogue: 0,0:07:23.56,0:07:25.57,Default,Kousuke,0,0,0,,Bám chắc vào, Nanami!
Dialogue: 0,0:07:27.32,0:07:30.29,Default,Kousuke,0,0,0,,Dài ra nào!
Dialogue: 0,0:07:32.42,0:07:33.89,Default,Kousuke,0,0,0,,Tiền bối, Ludie!
Dialogue: 0,0:07:33.89,0:07:34.63,Default,Kousuke,0,0,0,,Chộp lấy nó đi!
Dialogue: 0,0:07:34.85,0:07:35.93,Default,Yukine,0,0,0,,Bắt được rồi!
Dialogue: 0,0:07:38.33,0:07:39.93,Default,Ludie,0,0,0,,Nhưng mà nó trơn tuột thế này sao giữ nổi?!
Dialogue: 0,0:07:40.28,0:07:42.02,Default,Yukine,0,0,0,,Hãy dùng ma pháp cường hóa rồi kéo lại nào!
Dialogue: 0,0:07:54.41,0:07:56.48,Default,Kousuke,0,0,0,,Nanami!
Dialogue: 0,0:07:57.28,0:08:01.11,Default,Kousuke,0,0,0,,Tên nam chính nguyên bản đã vượt qua\Ncái màn này kiểu quái gì vậy trời?
Dialogue: 0,0:08:07.00,0:08:10.23,sign_11677_115_2nd_Stage,SIGN,0,0,0,,Màn 2
Dialogue: 0,0:08:08.66,0:08:10.23,Default,Kousuke,0,0,0,,{\an8}Cái gì đây nữa thế này?
Dialogue: 0,0:08:12.70,0:08:14.49,Default,Kousuke,0,0,0,,Vậy là chúng ta phải leo lên đó sao.
Dialogue: 0,0:08:14.92,0:08:17.93,Default,Kousuke,0,0,0,,Hah, chỉ cần kéo dài cái khố của mình ra rồi—
Dialogue: 0,0:08:20.72,0:08:22.41,Default,Kousuke,0,0,0,,Hả?
Dialogue: 0,0:08:25.95,0:08:28.10,Default,Ludie,0,0,0,,Khoan đã, nó ghi là cấm dùng khố kìa?
Dialogue: 0,0:08:28.36,0:08:30.78,Default,Kousuke,0,0,0,,Cái gì, không được phép dùng sao?!
Dialogue: 0,0:08:34.36,0:08:36.83,Default,Kousuke,0,0,0,,Toang rồi, lại là thứ dầu bôi trơn đó!
Dialogue: 0,0:08:36.83,0:08:38.09,Default,Ludie,0,0,0,,Đùa tôi đấy à?!
Dialogue: 0,0:08:38.41,0:08:41.33,Default,Yukine,0,0,0,,Chị hiểu rồi, còn có cả giới hạn thời gian nữa.
Dialogue: 0,0:08:43.84,0:08:45.35,Default,Kousuke,0,0,0,,Vậy để em đi trước cho!
Dialogue: 0,0:08:45.35,0:08:48.41,Default,Yukine,0,0,0,,Không, chúng ta nên để Ludie đi trước!
Dialogue: 0,0:08:48.41,0:08:50.06,Default,Ludie,0,0,0,,Em á?
Dialogue: 0,0:08:50.06,0:08:52.89,Default,Yukine,0,0,0,,Nếu có chuyện gì xảy ra,\Nchị có thể đỡ em từ bên dưới.
Dialogue: 0,0:08:53.62,0:08:54.92,Default,Yukine,0,0,0,,Chị cũng trông cậy vào em đấy, Takioto!
Dialogue: 0,0:08:54.92,0:08:56.49,Default,Kousuke,0,0,0,,Rõ rồi ạ!
Dialogue: 0,0:08:56.49,0:08:57.85,Default,Kousuke,0,0,0,,Cứ tin tưởng ở em!
Dialogue: 0,0:09:00.15,0:09:02.05,Default,Ludie,0,0,0,,Xem ra tôi đành phải đi thôi...
Dialogue: 0,0:09:12.26,0:09:14.31,Default,Yukine,0,0,0,,Cứ bình tĩnh tiến lên, không phải vội đâu.
Dialogue: 0,0:09:14.31,0:09:15.59,Default,Yukine,0,0,0,,Từng bước một thôi.
Dialogue: 0,0:09:16.55,0:09:18.61,Default,Yukine,0,0,0,,Tất cả những gì em cần làm là tiếp tục bước đi.
Dialogue: 0,0:09:19.94,0:09:23.00,Default,Kousuke(M),0,0,0,,{\i1}Đúng là mình có thể đỡ họ\Nnếu có chuyện gì xảy ra thật...{\i0}
Dialogue: 0,0:09:23.00,0:09:25.20,Default,Kousuke(M),0,0,0,,{\i1}nhưng góc này thì biết nhìn đi đâu cho đàng hoàng đây trời?!{\i0}
Dialogue: 0,0:09:32.00,0:09:33.09,Default,Both,0,0,0,,Ludie!
Dialogue: 0,0:09:37.59,0:09:38.67,Default,Yukine,0,0,0,,Hỏng rồi!
Dialogue: 0,0:09:42.87,0:09:44.35,Default,Kousuke,0,0,0,,Em sẽ đỡ hai người!
Dialogue: 0,0:09:44.35,0:09:46.47,Default,Yukine,0,0,0,,Chị xin lỗi nhé, Takioto!
Dialogue: 0,0:09:46.78,0:09:48.73,Default,Kousuke,0,0,0,,K-Không có vấn đề gì đâu ạ!
Dialogue: 0,0:09:53.08,0:09:54.90,Default,Ludie,0,0,0,,Tôi không... chịu nổi nữa rồi...
Dialogue: 0,0:09:55.17,0:09:57.07,Default,Yukine,0,0,0,,Đừng bỏ cuộc, Ludie!
Dialogue: 0,0:09:58.90,0:09:59.86,Default,Kousuke,0,0,0,,Ludie?!
Dialogue: 0,0:10:04.74,0:10:07.29,Default,Ludie,0,0,0,,Phần còn lại nhờ hai người...
Dialogue: 0,0:10:18.92,0:10:21.34,Default,Yukine,0,0,0,,Chị thề nhất định chúng ta sẽ qua màn.
Dialogue: 0,0:10:25.68,0:10:29.52,sign_15002_148_3rd_Stage,SIGN,0,0,0,,{\pos(323.444,292.556)}Màn 3
Dialogue: 0,0:10:30.56,0:10:32.85,Default,Yukine,0,0,0,,Vậy chúng ta chỉ cần băng qua cây cầu này thôi sao?
Dialogue: 0,0:10:33.11,0:10:34.53,Default,Kousuke,0,0,0,,Nếu những tài liệu em đọc là chính xác,
Dialogue: 0,0:10:34.53,0:10:36.09,Default,Kousuke,0,0,0,,thì một thợ săn sẽ xuất hiện ở đây.
Dialogue: 0,0:10:36.50,0:10:39.94,Default,Kousuke,0,0,0,,Chúng ta phải thoát khỏi hắn\Nvà đặt những quả cầu vàng vào cánh cửa kia.
Dialogue: 0,0:10:40.71,0:10:42.12,Default,Kousuke,0,0,0,,Thế là chúng ta thắng!
Dialogue: 0,0:10:56.46,0:10:58.00,Default,Kousuke,0,0,0,,Tiền bối! Coi chừng!
Dialogue: 0,0:10:59.47,0:11:01.01,Default,Kousuke,0,0,0,,Làm tốt lắm, Tiền bối!
Dialogue: 0,0:11:04.56,0:11:05.64,Default,Kousuke,0,0,0,,Cẩn thận đấy ạ!
Dialogue: 0,0:11:08.18,0:11:09.26,Default,Yukine,0,0,0,,Takioto!
Dialogue: 0,0:11:12.26,0:11:14.01,Default,Kousuke,0,0,0,,Vừa rồi... suýt chết!
Dialogue: 0,0:11:26.56,0:11:28.27,Default,Kousuke,0,0,0,,Cảm ơn chị nhiều lắm.
Dialogue: 0,0:11:28.27,0:11:30.39,Default,Yukine,0,0,0,,Chị mừng là lần này\Nđã kịp cứu được em.
Dialogue: 0,0:11:30.39,0:11:32.77,Default,Kousuke,0,0,0,,Em cũng mừng vì chị vẫn bình an vô sự.
Dialogue: 0,0:11:32.77,0:11:34.08,Default,Kousuke,0,0,0,,Nhưng bây giờ...
Dialogue: 0,0:11:35.69,0:11:37.54,Default,Yukine,0,0,0,,Takioto, cái gì kia?
Dialogue: 0,0:11:39.50,0:11:42.20,Default,Kousuke,0,0,0,,B-Bọn chúng thả thợ săn ra rồi!
Dialogue: 0,0:11:42.20,0:11:43.22,Default,Yukine,0,0,0,,Chuyện gì đang diễn ra thế này?!
Dialogue: 0,0:11:50.10,0:11:51.47,Default,Kousuke(M),0,0,0,,{\i1}Mình biết mục tiêu của thợ săn là...{\i0}
Dialogue: 0,0:11:51.72,0:11:53.28,Default,Kousuke,0,0,0,,Em sẽ cản hắn lại!
Dialogue: 0,0:11:53.28,0:11:56.94,Default,Kousuke,0,0,0,,Tiền bối, cầm lấy bi của em...\Ný em là, cầm lấy quả cầu vàng của em đi!
Dialogue: 0,0:11:57.69,0:11:59.03,Default,Yukine,0,0,0,,Chị hiểu rồi.
Dialogue: 0,0:12:00.77,0:12:02.73,Default,Kousuke,0,0,0,,Ngươi đừng hòng bước thêm bước nào nữa!
Dialogue: 0,0:12:06.24,0:12:07.20,Default,Yukine,0,0,0,,Takioto!
Dialogue: 0,0:12:07.20,0:12:10.16,Default,Kousuke,0,0,0,,Xin chị hãy tiếp tục chạy đi! Đừng dừng lại!
Dialogue: 0,0:12:14.40,0:12:16.79,Default,Kousuke(M),0,0,0,,{\i1}Mình không thể giữ chân hắn mãi được...{\i0}
Dialogue: 0,0:12:17.48,0:12:18.42,Default,Kousuke,0,0,0,,Dù chỉ còn một mình chị,
Dialogue: 0,0:12:18.42,0:12:21.39,Default,Kousuke,0,0,0,,chỉ cần chị chạm đích là màn này\Nsẽ được tính là vượt qua!
Dialogue: 0,0:12:23.20,0:12:24.40,Default,Kousuke,0,0,0,,Nên xin chị đấy!
Dialogue: 0,0:12:24.40,0:12:26.55,Default,Kousuke,0,0,0,,Đây là thỉnh cầu cuối cùng của em!
Dialogue: 0,0:12:26.55,0:12:30.26,Default,Kousuke,0,0,0,,Xin chị một lát nữa đừng nhìn em\Ntrong bộ dạng thảm hại nhất này nhé!
Dialogue: 0,0:12:30.54,0:12:32.68,Default,Yukine,0,0,0,,Khoan đã, em định làm gì thế?!
Dialogue: 0,0:12:35.49,0:12:39.60,Default,Kousuke,0,0,0,,Ta bay được đây này!
Dialogue: 0,0:12:50.62,0:12:53.08,Default,Yukine,0,0,0,,Takioto!
Dialogue: 0,0:13:06.49,0:13:09.29,Default,Yukine,0,0,0,,Sự hy sinh của em sẽ không uổng phí đâu!
Dialogue: 0,0:13:11.15,0:13:13.12,Default,Yukine,0,0,0,,Em không hề thảm hại chút nào cả!
Dialogue: 0,0:13:13.97,0:13:15.97,Default,Yukine,0,0,0,,Em là một người đàn ông đích thực.
Dialogue: 0,0:13:29.60,0:13:30.63,Default,Ludie,0,0,0,,Chị Yukine!
Dialogue: 0,0:13:31.86,0:13:33.07,Default,Ludie,0,0,0,,Kousuke đâu rồi chị?
Dialogue: 0,0:13:34.70,0:13:37.16,Default,Yukine,0,0,0,,Takioto đã kéo tên trùm rơi xuống cùng...
Dialogue: 0,0:13:37.48,0:13:39.54,Default,Yukine,0,0,0,,và cả hai đã rơi vào hồ dầu trơn rồi.
Dialogue: 0,0:13:39.54,0:13:40.93,Default,Ludie,0,0,0,,Ôi không!
Dialogue: 0,0:13:40.93,0:13:43.85,Default,Nanami,0,0,0,,Đến cả tôi cũng chẳng thể làm được gì...
Dialogue: 0,0:13:58.50,0:13:59.23,Default,Kousuke,0,0,0,,Mọi người...
Dialogue: 0,0:14:06.57,0:14:09.99,Default,CarpLord,0,0,0,,Làm tốt lắm!
Dialogue: 0,0:14:09.99,0:14:13.78,Default,CarpLord,0,0,0,,Các ngươi đã vượt qua mọi thử thách vô cùng xuất sắc!
Dialogue: 0,0:14:13.78,0:14:19.29,Default,CarpLord,0,0,0,,Phần thưởng xứng đáng sẽ thuộc về các ngươi!
Dialogue: 0,0:14:19.96,0:14:21.74,Default,Kousuke,0,0,0,,Đây là...
Dialogue: 0,0:14:23.44,0:14:25.48,Default,Nanami,0,0,0,,Vâng, chính là dầu bôi trơn đấy ạ.
Dialogue: 0,0:14:26.01,0:14:28.22,sign_20764_198__Super_sale___Sp,SIGN,0,0,0,,{\fs12\move(505.556,285,478,255.667,21,2190)}<Đại Hạ Giá> Thuốc Phục Hồi Đặc Biệt
Dialogue: 0,0:14:34.14,0:14:35.39,Default,Kousuke,0,0,0,,Này, Iori.
Dialogue: 0,0:14:35.89,0:14:37.10,Default,Iori,0,0,0,,Kousuke-kun.
Dialogue: 0,0:14:37.52,0:14:40.10,Default,Kousuke,0,0,0,,Lúc nào cậu cũng ăn nhiều thế à?
Dialogue: 0,0:14:41.44,0:14:43.69,Default,Iori,0,0,0,,Hôm nay tớ tự thưởng cho mình một bữa ấy mà.
Dialogue: 0,0:14:43.69,0:14:48.11,Default,Iori,0,0,0,,Tớ kiếm được rất nhiều Điểm Tsukuyomi\Nnhờ phá đảo hầm ngục tân thủ.
Dialogue: 0,0:14:48.11,0:14:49.61,Default,Kousuke,0,0,0,,Hiểu rồi.
Dialogue: 0,0:14:49.61,0:14:52.28,Default,Kousuke,0,0,0,,Nhắc mới nhớ, Hội trưởng Monica\Ncũng đi cùng cậu đúng không?
Dialogue: 0,0:14:52.28,0:14:53.03,Default,Iori,0,0,0,,Ừ.
Dialogue: 0,0:14:53.45,0:14:56.87,Default,Iori,0,0,0,,Nhưng đột nhiên lũ ác ma xuất hiện,
Dialogue: 0,0:14:56.87,0:14:58.37,Default,Iori,0,0,0,,và thành thật mà nói,
Dialogue: 0,0:14:58.37,0:15:00.37,Default,Iori,0,0,0,,bọn tớ sống sót vượt qua được\Nphần lớn đều nhờ có chị ấy.
Dialogue: 0,0:15:00.37,0:15:01.46,Default,Kousuke,0,0,0,,Ra là thế.
Dialogue: 0,0:15:01.46,0:15:02.88,Default,Lunchlady,0,0,0,,Của cháu đây.
Dialogue: 0,0:15:02.88,0:15:04.09,Default,Kousuke,0,0,0,,Cháu cảm ơn cô ạ.
Dialogue: 0,0:15:04.75,0:15:05.46,Default,Kousuke,0,0,0,,Ái chà.
Dialogue: 0,0:15:07.96,0:15:09.88,Default,Kousuke,0,0,0,,Mấy người đó bị làm sao thế nhỉ?
Dialogue: 0,0:15:09.88,0:15:13.01,Default,Iori,0,0,0,,Tớ nghĩ chắc họ là người bên LLL đấy.
Dialogue: 0,0:15:14.97,0:15:15.97,Default,Kousuke,0,0,0,,Cũng phải thôi.
Dialogue: 0,0:15:17.22,0:15:21.48,Default,Kousuke,0,0,0,,Chắc là họ đang muốn đuổi cổ tớ\Nra khỏi học viện này lắm đây.
Dialogue: 0,0:15:21.48,0:15:24.48,Default,Kousuke,0,0,0,,Tất cả chỉ vì tớ có vẻ thân thiết với\Ntiểu thư Ludivine mà ai nấy đều yêu quý.
Dialogue: 0,0:15:29.90,0:15:32.78,Default,Kousuke,0,0,0,,Thôi thì nhìn vào cũng thấy rõ\Ntớ học hành chẳng nghiêm túc gì rồi.
Dialogue: 0,0:15:33.91,0:15:36.20,Default,Kousuke,0,0,0,,Chiều nay tớ còn dự định\Ncúp tiết luôn đây này.
Dialogue: 0,0:15:36.20,0:15:37.91,Default,Iori,0,0,0,,Tại sao chứ?
Dialogue: 0,0:15:37.91,0:15:39.50,Default,Kousuke,0,0,0,,Để đi luyện tập chứ sao nữa.
Dialogue: 0,0:15:41.62,0:15:44.29,Default,Kousuke,0,0,0,,Xin lỗi vì đã làm cậu phải lo lắng nhé.
Dialogue: 0,0:15:44.29,0:15:45.75,Default,Iori,0,0,0,,Người lo cho cậu đâu phải là tớ...
Dialogue: 0,0:15:45.75,0:15:47.00,Default,Kousuke,0,0,0,,Không sao đâu mà.
Dialogue: 0,0:15:47.55,0:15:50.67,Default,Kousuke,0,0,0,,Tớ là kẻ sẽ trở thành người mạnh nhất\Nở học viện này đấy.
Dialogue: 0,0:15:51.09,0:15:53.39,Default,Kousuke,0,0,0,,Chút nghịch cảnh cỏn con này chẳng là cái đinh gì đâu.
Dialogue: 0,0:15:53.39,0:15:54.64,Default,Iori,0,0,0,,Bây giờ tớ hiểu rồi.
Dialogue: 0,0:15:54.64,0:15:56.97,Default,Iori,0,0,0,,Cậu mạnh mẽ thật đấy nhỉ?
Dialogue: 0,0:15:56.97,0:15:59.52,Default,Kousuke,0,0,0,,Chứ sao nữa, mạnh nhất luôn đấy!
Dialogue: 0,0:16:04.27,0:16:05.94,Default,Katorina,0,0,0,,Thật không thể tin nổi.
Dialogue: 0,0:16:05.94,0:16:08.57,Default,Katorina,0,0,0,,Tên Takioto đó tính cúp tiết thật đấy à?
Dialogue: 0,0:16:08.57,0:16:09.78,Default,Katorina,0,0,0,,Hắn ta rốt cuộc đang nghĩ cái gì trong đầu thế?!
Dialogue: 0,0:16:09.78,0:16:12.03,Default,Iori,0,0,0,,Nhưng cậu ấy bảo là đi luyện tập mà.
Dialogue: 0,0:16:12.53,0:16:14.91,Default,Iinchou,0,0,0,,Không biết cậu ấy đã báo với giáo viên chưa nhỉ.
Dialogue: 0,0:16:15.37,0:16:18.08,Default,Iinchou,0,0,0,,À, chắc chúng ta nên chép bài hộ cậu ấy thôi.
Dialogue: 0,0:16:18.08,0:16:19.58,Default,Katorina,0,0,0,,Tớ thì mặc kệ hắn ta luôn cho rồi.
Dialogue: 0,0:16:19.58,0:16:23.33,Default,Katorina,0,0,0,,Cá chắc ngoài chúng ta ra chẳng ai thèm tin\Nlà hắn ta đi luyện tập đâu.
Dialogue: 0,0:16:24.17,0:16:25.79,Default,Ludie,0,0,0,,Tôi tự hỏi sao lại như vậy nhỉ.
Dialogue: 0,0:16:25.79,0:16:27.13,Default,Katorina,0,0,0,,Thì đấy...
Dialogue: 0,0:16:27.63,0:16:29.50,Default,Katorina,0,0,0,,Hắn kè kè bên người một cô hầu gái,
Dialogue: 0,0:16:29.50,0:16:31.51,Default,Katorina,0,0,0,,lại còn nổi bần bật theo cái cách khó ưa nữa chứ.
Dialogue: 0,0:16:31.51,0:16:32.59,Default,Katorina,0,0,0,,Mà nhìn kìa.
Dialogue: 0,0:16:35.43,0:16:38.10,Default,Iinchou,0,0,0,,Nhưng tớ không nghĩ\Nhọ là người xấu đâu...
Dialogue: 0,0:16:38.47,0:16:40.06,Default,Ludie,0,0,0,,LLL sao...
Dialogue: 0,0:16:40.06,0:16:43.02,Default,Katorina,0,0,0,,Rõ ràng là bọn họ đang ghen ăn tức ở đấy!
Dialogue: 0,0:16:44.31,0:16:47.52,Default,Ludie,0,0,0,,Nếu mọi người biết được chỉ một phần nhỏ\Nnhững gì mà cậu ấy phải trải qua khi luyện tập,
Dialogue: 0,0:16:47.52,0:16:51.23,Default,Ludie,0,0,0,,tôi nghĩ họ sẽ không còn\Nthù hằn với cậu ấy như thế nữa đâu...
Dialogue: 0,0:16:52.65,0:16:55.70,Default,Katorina,0,0,0,,Thế rốt cuộc hắn ta nỗ lực đến mức nào cơ chứ?
Dialogue: 0,0:16:56.36,0:16:59.20,Default,Ludie,0,0,0,,Bọn tôi có quen một người ở Ban Kỷ Luật,
Dialogue: 0,0:16:59.20,0:17:01.29,Default,Ludie,0,0,0,,và chị ấy nói rằng cậu ấy đang luyện tập\Nvới cường độ phi thường ngoài sức tưởng tượng.
Dialogue: 0,0:17:01.29,0:17:04.66,Default,Ludie,0,0,0,,Chị ấy còn thán phục nỗ lực của cậu ấy\Nlà vượt xa mọi chuẩn mực.
Dialogue: 0,0:17:05.25,0:17:08.67,Default,Iori,0,0,0,,Nghe thế với tớ lại thấy giống như\Nchị ấy đang chết khiếp thì đúng hơn...
Dialogue: 0,0:17:08.92,0:17:11.63,Default,Katorina,0,0,0,,Đến chúng ta còn chẳng hiểu nổi hắn,
Dialogue: 0,0:17:11.63,0:17:15.63,Default,Katorina,0,0,0,,thì những người còn ít tiếp xúc với hắn hơn\Nlàm sao mà hiểu cho nổi.
Dialogue: 0,0:17:16.13,0:17:17.59,Default,Iori,0,0,0,,Cậu nói cũng có lý.
Dialogue: 0,0:17:18.01,0:17:19.85,Default,Ludie,0,0,0,,Nhưng ở nhà thì cậu ấy...
Dialogue: 0,0:17:21.64,0:17:24.27,Default,Ludie,0,0,0,,Chắc ở nhà hắn ta cũng vô tư hời hợt thế thôi.
Dialogue: 0,0:17:24.64,0:17:26.06,Default,Iori,0,0,0,,Ừm, tớ cũng đoán vậy.
Dialogue: 0,0:17:27.06,0:17:30.65,Default,Ludie,0,0,0,,T-Tôi tự hỏi cậu ấy cảm thấy thế nào\Nvề hoàn cảnh của mình,
Dialogue: 0,0:17:30.65,0:17:32.32,Default,Ludie,0,0,0,,và về những lời đàm tiếu xì xào của mọi người xung quanh.
Dialogue: 0,0:17:32.61,0:17:36.32,Default,Iori,0,0,0,,À, nhìn qua thì có vẻ cậu ấy\Nchẳng bận tâm chút nào đâu.
Dialogue: 0,0:17:37.66,0:17:40.03,Default,Iori,0,0,0,,Cậu ấy còn thưởng thức món bánh parfait cực kỳ ngon lành,
Dialogue: 0,0:17:40.03,0:17:43.33,Default,Iori,0,0,0,,thậm chí còn đãi tớ một ly\Nvì "đã làm tớ phải lo lắng" nữa cơ.
Dialogue: 0,0:17:43.33,0:17:45.50,Default,Iori,0,0,0,,Và món đó thực sự ngon tuyệt đỉnh luôn ấy!
Dialogue: 0,0:17:45.50,0:17:47.62,Default,Katorina,0,0,0,,Ai thèm quan tâm cái đó chứ!
Dialogue: 0,0:17:47.62,0:17:49.00,Default,Iincho,0,0,0,,Thôi nào, thôi nào.
Dialogue: 0,0:17:51.38,0:17:54.21,Default,Yukine,0,0,0,,Chị nghĩ em không cần phải lo lắng đâu.
Dialogue: 0,0:17:54.59,0:17:56.55,Default,Yukine,0,0,0,,Takioto không hề ngốc nghếch chút nào đâu.
Dialogue: 0,0:17:56.55,0:17:59.84,Default,Yukine,0,0,0,,Chắc chắn em ấy thừa biết mối quan hệ thân thiết\Ngiữa hai đứa cùng sự tồn tại của LLL
Dialogue: 0,0:17:59.84,0:18:02.60,Default,Yukine,0,0,0,,sẽ dẫn đến cục diện như thế này.
Dialogue: 0,0:18:03.81,0:18:07.19,Default,Ludie,0,0,0,,Nhưng em có thể lên tiếng bảo ban LLL mà...
Dialogue: 0,0:18:07.19,0:18:11.40,Default,Yukine,0,0,0,,Không, em cứ mặc kệ họ đi, trừ khi có biến cố\Ngì đó thực sự lớn xảy ra.
Dialogue: 0,0:18:11.40,0:18:15.99,Default,Yukine,0,0,0,,Cách làm đó đã được chứng minh là hiệu quả nhất\Nvới cả MMM lẫn SSS rồi.
Dialogue: 0,0:18:17.49,0:18:19.86,Default,Ludie,0,0,0,,Hai người đó cũng chẳng dễ dàng gì nhỉ?
Dialogue: 0,0:18:21.16,0:18:23.54,Default,Yukine,0,0,0,,Nhưng trong tương lai,\NTakioto chắc chắn sẽ còn làm cho mọi người
Dialogue: 0,0:18:23.54,0:18:25.95,Default,Yukine,0,0,0,,càng thêm ghen tị và đố kỵ hơn nữa đấy.
Dialogue: 0,0:18:29.08,0:18:33.29,Default,Yukine,0,0,0,,Càng tiếp xúc nhiều với em ấy,\Nchị lại càng yêu quý em ấy hơn.
Dialogue: 0,0:18:33.84,0:18:35.30,Default,Yukine,0,0,0,,Chính vì thế chị mới có thể khẳng định điều này:
Dialogue: 0,0:18:35.71,0:18:38.26,Default,Yukine,0,0,0,,Dù Takioto có bị mọi người căm ghét đến mức nào đi nữa,
Dialogue: 0,0:18:38.26,0:18:40.76,Default,Yukine,0,0,0,,chị vẫn sẽ mãi là đồng minh kiên định nhất của em ấy.
Dialogue: 0,0:18:41.64,0:18:43.05,Default,Yukine,0,0,0,,Còn em thì sao?
Dialogue: 0,0:18:43.43,0:18:44.68,Default,Ludie,0,0,0,,Em...
Dialogue: 0,0:18:46.43,0:18:49.89,Default,Ludie,0,0,0,,Em cũng muốn tiếp tục làm đồng minh của cậu ấy.
Dialogue: 0,0:18:52.81,0:18:57.28,Default,Ludie,0,0,0,,Nhưng em thực sự xin kiếu mấy cái hầm ngục\Nnhư ngày hôm qua rồi đấy ạ.
Dialogue: 0,0:18:57.28,0:19:00.11,Default,Yukine,0,0,0,,Chị không thể đồng tình hơn được nữa.
Dialogue: 0,0:19:00.11,0:19:03.49,Default,Yukine,0,0,0,,Dù chị có tắm rửa bao nhiêu lần đi nữa\Nthì người vẫn cứ thấy trơn tuột thế này.
Dialogue: 0,0:19:08.54,0:19:12.79,Default,Marino,0,0,0,,Thật ra phía học viện đều nắm rất rõ\Ntình hình vắng mặt của Kou-chan.
Dialogue: 0,0:19:13.54,0:19:15.63,Default,Marino,0,0,0,,Cả sự thù địch mà các học sinh khác\Ndành cho thằng bé nữa.
Dialogue: 0,0:19:16.00,0:19:19.13,Default,Marino,0,0,0,,Nhưng thằng bé chẳng thèm để bụng đâu.
Dialogue: 0,0:19:19.13,0:19:23.01,Default,Hatsumi,0,0,0,,Điều đáng chú ý hơn cả là việc\Nem ấy tiến bộ vượt bậc đến nhường nào.
Dialogue: 0,0:19:23.39,0:19:26.22,Default,Claris,0,0,0,,Cậu ấy chưa từng bỏ một ngày nào\Nvung kiếm hay chạy bộ rèn thể lực,
Dialogue: 0,0:19:26.22,0:19:30.14,Default,Claris,0,0,0,,và còn duy trì ma thuật cường hóa liên tục\Ncho Cánh Tay Thứ Ba và Cánh Tay Thứ Tư nữa.
Dialogue: 0,0:19:30.73,0:19:34.98,Default,Claris,0,0,0,,Nhưng chỉ bấy nhiêu thôi thì vẫn chưa đủ\Nđể giải thích cho tốc độ mạnh lên thần kỳ đó.
Dialogue: 0,0:19:35.27,0:19:37.48,Default,Hatsumi,0,0,0,,Có lẽ điều khiến em ấy trở nên phi thường đến vậy
Dialogue: 0,0:19:37.48,0:19:39.99,Default,Hatsumi,0,0,0,,chính là khả năng suy tính cho những kế hoạch\Ndài hạn trong tương lai...
Dialogue: 0,0:19:41.61,0:19:45.33,Default,Marino,0,0,0,,Nhưng mẹ cứ cảm thấy thằng bé\Nđang liều mạng quá mức thế nào ấy.
Dialogue: 0,0:19:45.33,0:19:46.16,Default,Ludie,0,0,0,,Dạ?
Dialogue: 0,0:19:47.58,0:19:50.41,Default,Marino,0,0,0,,Kou-chan đang dốc hết sức mình\Nđể trở nên mạnh mẽ hơn.
Dialogue: 0,0:19:50.91,0:19:54.96,Default,Marino,0,0,0,,Vậy thì chúng ta nên thưởng cho thằng bé\Nvì đã làm việc chăm chỉ như thế chứ.
Dialogue: 0,0:19:55.50,0:19:58.67,Default,Marino,0,0,0,,Chắc hẳn trong lòng thằng bé đang tích tụ\Nkhông ít nỗi niềm bực dọc đè nén đâu.
Dialogue: 0,0:20:00.92,0:20:04.51,Default,Ludie,0,0,0,,Dạ, ừm, cụ thể thì chúng ta nên làm gì ạ?
Dialogue: 0,0:20:04.51,0:20:08.18,Default,Marino,0,0,0,,Để xem nào. Chẳng hạn như em có thể khen ngợi nó.
Dialogue: 0,0:20:08.18,0:20:12.48,Default,Marino,0,0,0,,Hoặc đấm bóp xoa vai, nằm cạnh nó, xoa đầu nó.
Dialogue: 0,0:20:12.98,0:20:14.56,Default,Marino,0,0,0,,Phải rồi, nằm ngủ cùng nó.
Dialogue: 0,0:20:14.56,0:20:16.15,Default,Marino,0,0,0,,Hay là vào ngủ cạnh thằng bé xem sao?
Dialogue: 0,0:20:16.36,0:20:19.15,Default,Ludie,0,0,0,,Hả!? N-Ngủ chung với cậu ấy á?
Dialogue: 0,0:20:20.11,0:20:21.11,Default,Claris,0,0,0,,Tiểu thư Hatsumi?
Dialogue: 0,0:20:25.57,0:20:27.95,Default,Marino,0,0,0,,Tương lai của dòng tộc Hanamura coi như được bảo đảm rồi.
Dialogue: 0,0:20:29.49,0:20:33.62,Default,Kousuke,0,0,0,,C-Chị làm cái gì thế hả, Chị ơi?!
Dialogue: 0,0:20:34.83,0:20:35.96,Default,Hatsumi,0,0,0,,Ngủ cùng em.
Dialogue: 0,0:20:36.83,0:20:38.54,Default,Kousuke,0,0,0,,Ơ-Ơ kìa...
Dialogue: 0,0:20:39.46,0:20:40.55,Default,Hatsumi,0,0,0,,Kousuke.
Dialogue: 0,0:20:41.21,0:20:42.38,Default,Hatsumi,0,0,0,,Quay mặt sang phía chị đi.
Dialogue: 0,0:20:44.51,0:20:45.34,Default,Kousuke,0,0,0,,Chị nghiêm túc đấy à?
Dialogue: 0,0:20:47.72,0:20:50.10,Default,Kousuke(M),0,0,0,,{\i1}T-Tuyệt cú mèo.{\i0}
Dialogue: 0,0:20:50.10,0:20:53.18,Default,Kousuke(M),0,0,0,,{\i1}Đầu mình như đang được bao bọc bởi tất cả niềm hoan lạc\Nmà mình từng trải nghiệm trên cõi đời này,{\i0}
Dialogue: 0,0:20:53.18,0:20:56.10,Default,Kousuke(M),0,0,0,,{\i1}nén trọn lại dưới hình hài của hai ngọn núi đôi khổng lồ kia.{\i0}
Dialogue: 0,0:20:56.10,0:20:57.11,Default,Kousuke(M),0,0,0,,{\i1}Mình phải làm gì bây giờ?{\i0}
Dialogue: 0,0:20:57.11,0:20:58.94,Default,Kousuke(M),0,0,0,,{\i1}Rốt cuộc mình nên làm gì đây trời?!{\i0}
Dialogue: 0,0:20:58.94,0:21:02.13,sign_4125_47_Stormy_Skies__Ca,SIGN,0,0,0,,{\fad(318,1)\3c&HC61B80&\c&HFFE0FA&\pos(325.333,28.667)}{\blur3}Ác Quỷ
Dialogue: 0,0:20:59.73,0:21:01.03,Default,DevilA,0,0,0,,Game 18+ thì xá gì cơ chứ?!
Dialogue: 0,0:21:01.03,0:21:02.53,Default,DevilB,0,0,0,,Đây chính là thiên đường!
Dialogue: 0,0:21:02.53,0:21:04.45,Default,DevilC,0,0,0,,Chuẩn luôn, thiên đường trần gian!
Dialogue: 0,0:21:04.45,0:21:08.03,Default,Kousuke(M),0,0,0,,{\i1}Chết tiệt thật! Lũ ác quỷ trong lòng mình\Nđang thì thầm cám dỗ vào tai kìa!{\i0}
Dialogue: 0,0:21:08.03,0:21:08.99,Default,DevilA,0,0,0,,Nào, người anh em.
Dialogue: 0,0:21:08.99,0:21:11.45,Default,DevilA,0,0,0,,Bà chị xinh đẹp đã chủ động bật đèn xanh\Nmạnh mẽ tới mức này rồi cơ mà.
Dialogue: 0,0:21:11.45,0:21:14.41,Default,DevilA,0,0,0,,Quên cái thân phận ở nhà Hanamura đi\Nmà cứ đè ra tới luôn đi chứ lị!
Dialogue: 0,0:21:14.41,0:21:15.87,Default,Both,0,0,0,,Đúng đấy, tới luôn đi!
Dialogue: 0,0:21:15.87,0:21:16.96,Default,Kousuke(M),0,0,0,,{\i1}Cứ thế này thì mình không cầm cự nổi mất!{\i0}
Dialogue: 0,0:21:17.33,0:21:20.38,Default,Kousuke(M),0,0,0,,{\i1}Mình phải nhờ những thiên thần trong tâm trí\Nra tay dập tắt lũ ác quỷ này mới được!{\i0}
Dialogue: 0,0:21:20.38,0:21:23.21,Default,Kousuke(M),0,0,0,,{\i1}Xin các vị, hãy ngăn lũ ác quỷ lại giúp con với!{\i0}
Dialogue: 0,0:21:24.22,0:21:26.63,Default,AngelA,0,0,0,,Hai người đâu phải là người yêu của nhau, đúng chứ?
Dialogue: 0,0:21:26.63,0:21:29.47,Default,AngelB,0,0,0,,Nếu để người ngoài phát hiện ra thì đời cậu coi như tàn đời.
Dialogue: 0,0:21:29.47,0:21:31.31,Default,AngelC,0,0,0,,Vậy nên chẳng phải vì thế hay sao?
Dialogue: 0,0:21:31.31,0:21:32.47,Default,AngelA,0,0,0,,Cậu nói chí phải!
Dialogue: 0,0:21:32.47,0:21:33.52,Default,AngelB,0,0,0,,Tôi hoàn toàn đồng ý!
Dialogue: 0,0:21:34.14,0:21:35.64,Default,All,0,0,0,,Chính vì thế nên cậu lại càng phải làm tới!
Dialogue: 0,0:21:36.10,0:21:39.48,Default,All,0,0,0,,Hãy nghĩ cho Chị ấy mà nhớ phải thật dịu dàng\Nkhi làm chuyện đó đấy nhé!
Dialogue: 0,0:21:39.86,0:21:41.98,Default,Kousuke(M),0,0,0,,{\i1}Làm quái gì có thiên thần nào ở đây đâu...{\i0}
Dialogue: 0,0:21:41.98,0:21:43.90,Default,Kousuke(M),0,0,0,,{\i1}Cả bọn chúng nó nhất trí một lòng luôn kìa...{\i0}
Dialogue: 0,0:21:43.90,0:21:46.70,Default,Kousuke(M),0,0,0,,{\i1}Được rồi. Đàn ông từ chối lời mời gọi của phụ nữ\Nthì còn mặt mũi nào nữa.{\i0}
Dialogue: 0,0:21:46.70,0:21:48.57,Default,Kousuke(M),0,0,0,,{\i1}Trái tim mình đã sẵn sàng rồi.{\i0}
Dialogue: 0,0:21:51.74,0:21:52.66,Default,Kousuke,0,0,0,,Chị ơi?
Dialogue: 0,0:22:00.29,0:22:03.25,Default,Kousuke,0,0,0,,Chị ấy... ngủ mất rồi à?
Dialogue: 0,0:22:06.76,0:22:07.76,Default,Kousuke,0,0,0,,Còn mình thì...
Dialogue: 0,0:22:08.55,0:22:09.68,Default,Kousuke,0,0,0,,làm sao mà ngủ lại cho nổi nữa đây trời!
Comment: 0,0:00:00.02,0:00:00.02,Default,,0,0,0,,
Comment: 0,0:14:08.59,0:14:10.68,Default,SIGN,0,0,0,,{\an8}Brilliant

