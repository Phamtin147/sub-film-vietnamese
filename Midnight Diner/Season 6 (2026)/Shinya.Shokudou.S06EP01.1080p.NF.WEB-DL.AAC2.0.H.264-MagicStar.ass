Dialogue: 0,0:01:04.73,0:01:09.19,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày{\i0}\N{\i1}và vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:09.78,0:01:11.57,Default,,0,0,0,,{\i1}thì ngày mới của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:28.25,0:01:32.92,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa{\i0}\N{\i1}từ nửa đêm đến khoảng 7 giờ sáng.{\i0}
Dialogue: 0,0:01:34.80,0:01:37.89,Default,,0,0,0,,{\i1}Người ta thường gọi nó là Quán Ăn Đêm.{\i0}
Dialogue: 0,0:01:41.02,0:01:42.65,Default,,0,0,0,,{\i1}Thực đơn chỉ có vỏn vẹn chừng này.{\i0}
Dialogue: 0,0:01:43.31,0:01:45.81,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì,{\i0}
Dialogue: 0,0:01:46.61,0:01:49.20,Default,,0,0,0,,{\i1}chỉ cần có sẵn nguyên liệu là tôi đều sẽ làm.{\i0}
Dialogue: 0,0:01:49.28,0:01:51.03,Default,,0,0,0,,{\i1}Phương châm của tôi là vậy.{\i0}
Dialogue: 0,0:01:55.28,0:01:56.78,Default,,0,0,0,,{\i1}Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?{\i0}
Dialogue: 0,0:01:57.66,0:01:59.91,Default,,0,0,0,,{\i1}Thực ra là đông hơn bạn tưởng nhiều đấy.{\i0}
Dialogue: 0,0:02:12.63,0:02:17.59,Default,,0,0,0,,THÁNG 5 NĂM 2021
Dialogue: 0,0:02:20.31,0:02:23.90,Default,,0,0,0,,SUẤT CƠM SÚP MISO THỊT HEO 600 YÊN\NBIA CỠ LỚN 600 YÊN
Dialogue: 0,0:02:23.98,0:02:28.11,Default,,0,0,0,,NƯỚC RỬA TAY SÁT KHUẨN
Dialogue: 0,0:02:28.19,0:02:33.20,Default,,0,0,0,,XIN VUI LÒNG TUÂN THỦ QUY ĐỊNH GIÃN CÁCH XÃ HỘI
Dialogue: 0,0:02:49.38,0:02:50.80,Default,,0,0,0,,{\i1}Một đêm vắng lặng.{\i0}
Dialogue: 0,0:02:51.67,0:02:53.42,Default,,0,0,0,,{\i1}Chẳng có vị khách nào ghé qua.{\i0}
Dialogue: 0,0:02:54.55,0:02:57.89,Default,,0,0,0,,{\i1}Mà cũng phải thôi, ai nấy đều được khuyến cáo{\i0}\N{\i1}hạn chế ra đường nếu không thật sự cần thiết,{\i0}
Dialogue: 0,0:02:58.55,0:03:00.39,Default,,0,0,0,,{\i1}nên tôi cũng chẳng trách họ được.{\i0}
Dialogue: 0,0:03:22.37,0:03:24.87,Default,,0,0,0,,ĐỀN INARI
Dialogue: 0,0:04:18.63,0:04:20.42,Default,,0,0,0,,Ông chủ còn mở cửa không?
Dialogue: 0,0:04:21.47,0:04:22.47,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:04:38.86,0:04:39.86,Default,,0,0,0,,Ngồi ở đây thư thái thật đấy.
Dialogue: 0,0:04:41.99,0:04:44.49,Default,,0,0,0,,Thú thật, ngại quá không dám giấu gì Ông chủ.
Dialogue: 0,0:04:44.58,0:04:49.34,Default,,0,0,0,,Tôi vừa xuất bản một cuốn sách dạy nấu món ăn 3 sao\Ntại nhà, và nó bán chạy như tôm tươi.
Dialogue: 0,0:04:50.04,0:04:52.92,Default,,0,0,0,,Nhưng sự thật là người ta chẳng thể nào\Ntự nấu mấy món đó ở nhà được đâu.
Dialogue: 0,0:04:53.00,0:04:55.46,Default,,0,0,0,,Nguyên liệu thì khó kiếm,
Dialogue: 0,0:04:56.09,0:04:57.72,Default,,0,0,0,,mà tay nghề của người thường cũng chẳng đủ trình.
Dialogue: 0,0:04:57.80,0:05:00.05,Default,,0,0,0,,Quán này không phải chỗ hợp lý\Nđể anh khoe khoang chuyện đó đâu.
Dialogue: 0,0:05:00.13,0:05:02.88,Default,,0,0,0,,Ồ, cho tôi xin lỗi. Tự dưng buột miệng nói ra mất.
Dialogue: 0,0:05:05.10,0:05:06.69,Default,,0,0,0,,Dạo này bên chỗ Ông chủ làm ăn thế nào?
Dialogue: 0,0:05:07.68,0:05:09.02,Default,,0,0,0,,Như anh thấy đấy,
Dialogue: 0,0:05:09.98,0:05:12.44,Default,,0,0,0,,ở đâu cũng ảm đạm như nhau cả thôi.
Dialogue: 0,0:05:13.73,0:05:16.27,Default,,0,0,0,,Đây là đợt giãn cách thứ mấy rồi ấy nhỉ?
Dialogue: 0,0:05:17.32,0:05:18.36,Default,,0,0,0,,Đợt thứ ba rồi.
Dialogue: 0,0:05:20.53,0:05:22.37,Default,,0,0,0,,Không biết cảnh này còn kéo dài đến bao giờ nữa?
Dialogue: 0,0:05:22.45,0:05:23.62,Default,,0,0,0,,Ai mà biết được.
Dialogue: 0,0:05:24.16,0:05:25.54,Default,,0,0,0,,Nhưng gặp phải thời buổi dịch giã thế này,
Dialogue: 0,0:05:26.16,0:05:28.25,Default,,0,0,0,,chúng ta cũng đành chịu chứ biết làm sao.
Dialogue: 0,0:05:30.54,0:05:32.29,Default,,0,0,0,,Cảm ơn vì bữa ăn nhé.
Dialogue: 0,0:05:35.79,0:05:36.71,Default,,0,0,0,,Lần sau tôi lại ghé.
Dialogue: 0,0:05:36.79,0:05:38.75,Default,,0,0,0,,- Cảm ơn quý khách.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:05:40.26,0:05:41.60,Default,,0,0,0,,Chà, no căng cả bụng.
Dialogue: 0,0:05:41.67,0:05:43.05,Default,,0,0,0,,Ngon tuyệt cú mèo.
Dialogue: 0,0:05:43.13,0:05:46.30,Default,,0,0,0,,{\i1}Rốt cuộc, chẳng có thêm vị khách nào ghé qua sau đó,{\i0}
Dialogue: 0,0:05:47.01,0:05:48.30,Default,,0,0,0,,{\i1}và tôi đóng cửa quán{\i0}
Dialogue: 0,0:05:48.81,0:05:51.23,Default,,0,0,0,,{\i1}vào lúc tám giờ sáng như thường lệ.{\i0}
Dialogue: 0,0:05:54.94,0:05:57.03,Default,,0,0,0,,TẠM NGHỈ MỘT THỜI GIAN
Dialogue: 0,0:05:57.11,0:05:59.45,Default,,0,0,0,,Lệnh giãn cách lại bị gia hạn\Nđến tận hết tháng Chín rồi.
Dialogue: 0,0:05:59.53,0:06:01.87,Default,,0,0,0,,Đến cả Ông chủ cuối cùng cũng nản lòng rồi sao?
Dialogue: 0,0:06:02.74,0:06:05.70,Default,,0,0,0,,Nhưng tuần trước lúc tôi ghé qua\Nthì quán vẫn còn mở cửa mà.
Dialogue: 0,0:06:05.78,0:06:09.78,Default,,0,0,0,,Có khi cứ đóng cửa nghỉ hẳn\Nrồi nhận tiền trợ cấp của chính phủ lại khỏe hơn.
Dialogue: 0,0:06:09.87,0:06:11.66,Default,,0,0,0,,Chuyện này đâu nằm ở tiền bạc hay lời lãi.
Dialogue: 0,0:06:12.46,0:06:15.59,Default,,0,0,0,,Ông chủ quán này không phải hạng người tính toán nhỏ nhen thế đâu.
Dialogue: 0,0:06:16.13,0:06:17.80,Default,,0,0,0,,- Khẩu trang của chú em kìa.\N- Dạ, phải rồi.
Dialogue: 0,0:06:20.17,0:06:21.30,Default,,0,0,0,,Thôi thì đành chịu vậy.
Dialogue: 0,0:06:22.26,0:06:25.31,Default,,0,0,0,,Thời thế bắt thế mà, biết sao được?
Dialogue: 0,0:06:25.97,0:06:26.81,Default,,0,0,0,,Này.
Dialogue: 0,0:06:26.89,0:06:27.72,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:06:27.80,0:06:30.80,Default,,0,0,0,,Anh không nghĩ là Ông chủ sẽ đóng cửa quán\Nluôn đấy chứ?
Dialogue: 0,0:06:31.60,0:06:32.68,Default,,0,0,0,,Biết đâu được?
Dialogue: 0,0:06:33.73,0:06:35.32,Default,,0,0,0,,Suy cho cùng,
Dialogue: 0,0:06:36.56,0:06:38.35,Default,,0,0,0,,cái nghề của chúng ta vốn dĩ chẳng nói trước được điều gì.
Dialogue: 0,0:06:41.40,0:06:43.07,Default,,0,0,0,,Quán vẫn đóng cửa im ỉm.
Dialogue: 0,0:06:43.61,0:06:45.82,Default,,0,0,0,,Mong sao Ông chủ sớm mở cửa trở lại.
Dialogue: 0,0:06:45.91,0:06:49.46,Default,,0,0,0,,Dù không được phép bán rượu bia,\Nông ấy vẫn có thể mở cửa rút ngắn giờ mà.
Dialogue: 0,0:06:49.53,0:06:50.49,Default,,0,0,0,,Nhưng mà…
Dialogue: 0,0:06:50.58,0:06:54.00,Default,,0,0,0,,Tất cả hàng quán đều phải đóng cửa trước 8 giờ tối.
Dialogue: 0,0:06:54.71,0:06:57.59,Default,,0,0,0,,Em nhớ món gà chiên của Ông chủ làm quá đi mất.
Dialogue: 0,0:07:01.46,0:07:04.42,Default,,0,0,0,,Cơm chan trà {\i1}ochazuke{\i0} thì ăn ở đâu chẳng có, cơ mà…
Dialogue: 0,0:07:04.51,0:07:07.47,Default,,0,0,0,,Mình chỉ thèm đúng bát cơm chan trà do tay Ông chủ nấu thôi.
Dialogue: 0,0:07:07.55,0:07:10.05,Default,,0,0,0,,Chứ ăn ở chỗ khác cứ thấy thiếu thiếu làm sao ấy.
Dialogue: 0,0:07:10.68,0:07:12.43,Default,,0,0,0,,- Đúng đấy.\N- Chuẩn luôn.
Dialogue: 0,0:07:13.43,0:07:16.31,Default,,0,0,0,,Xem ra quán vẫn chưa mở cửa lại nhỉ.
Dialogue: 0,0:07:19.19,0:07:21.36,Default,,0,0,0,,Chẳng còn chốn nào để đi nữa hả, Hachiro?
Dialogue: 0,0:07:22.36,0:07:24.82,Default,,0,0,0,,Đến cả ông cũng lặn lội ghé qua đây sao, ông Kanemoto?
Dialogue: 0,0:07:25.53,0:07:28.16,Default,,0,0,0,,Nhỡ Ông chủ đóng cửa nghỉ bán luôn thì sao?
Dialogue: 0,0:07:28.82,0:07:29.95,Default,,0,0,0,,Làm gì có chuyện đó.
Dialogue: 0,0:07:32.41,0:07:33.54,Default,,0,0,0,,Này,
Dialogue: 0,0:07:34.37,0:07:36.12,Default,,0,0,0,,chị có bắt chước được hương vị của Ông chủ không?
Dialogue: 0,0:07:37.17,0:07:38.67,Default,,0,0,0,,Tôi thèm ăn trứng cá tuyết nướng quá.
Dialogue: 0,0:07:40.17,0:07:42.84,Default,,0,0,0,,Cái độ xém cạnh vừa chín tới hoàn hảo đó… Tôi hiểu mà.
Dialogue: 0,0:07:43.50,0:07:45.50,Default,,0,0,0,,Cơ mà liệu tôi có làm nổi không đây?
Dialogue: 0,0:07:46.09,0:07:47.01,Default,,0,0,0,,Marilyn kìa.
Dialogue: 0,0:07:47.76,0:07:49.89,Default,,0,0,0,,- Bên câu lạc bộ thoát y dạo này thế nào?\N- Thì cũng…
Dialogue: 0,0:07:49.97,0:07:53.02,Default,,0,0,0,,Em có thể cởi quần lót trên sân khấu,\Nnhưng khẩu trang thì tuyệt đối không tháo đâu nhé!
Dialogue: 0,0:07:53.10,0:07:54.19,Default,,0,0,0,,Ôi trời đất ơi.
Dialogue: 0,0:07:55.35,0:07:58.40,Default,,0,0,0,,Cầu mong Ông chủ sớm mở quán lại.
Dialogue: 0,0:08:25.63,0:08:26.88,Default,,0,0,0,,Hi vọng không phải là ông ấy qua đời rồi chứ.
Dialogue: 0,0:08:28.63,0:08:29.46,Default,,0,0,0,,Đại ca à.
Dialogue: 0,0:08:30.09,0:08:33.01,Default,,0,0,0,,Bình thường nếu người ta có mệnh hệ gì,\Nchẳng phải là sẽ mất ở nhà sao?
Dialogue: 0,0:08:35.18,0:08:37.18,Default,,0,0,0,,Người đàn ông đó mà có chết thì cũng sẽ chết ở cái quán này.
Dialogue: 0,0:09:50.97,0:09:52.81,Default,,0,0,0,,Ồ, lâu lắm rồi mới gặp.
Dialogue: 0,0:09:52.88,0:09:54.76,Default,,0,0,0,,Chào anh, lâu ngày quá nhỉ.
Dialogue: 0,0:09:55.47,0:09:56.31,Default,,0,0,0,,À, phải rồi.
Dialogue: 0,0:09:56.39,0:09:58.48,Default,,0,0,0,,Thật ra tôi có chuyện này muốn nhờ một tay được không?
Dialogue: 0,0:09:58.56,0:09:59.56,Default,,0,0,0,,Ồ, tất nhiên rồi.
Dialogue: 0,0:10:05.35,0:10:06.48,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:10:19.79,0:10:20.83,Default,,0,0,0,,Là ai được nhỉ?
Dialogue: 0,0:10:21.54,0:10:22.96,Default,,0,0,0,,Em cũng chịu thôi.
Dialogue: 0,0:10:23.87,0:10:25.96,Default,,0,0,0,,Cái này là đồ tự đóng bằng tay đúng không?
Dialogue: 0,0:10:26.04,0:10:29.29,Default,,0,0,0,,Chứ còn gì nữa.\NLàm gì có tiệm nào bán thứ như thế này.
Dialogue: 0,0:10:32.05,0:10:35.05,Default,,0,0,0,,Chà, lắm chìa khóa thế.
Dialogue: 0,0:10:35.13,0:10:36.88,Default,,0,0,0,,Chìa nào mới đúng đây nhỉ?
Dialogue: 0,0:10:37.60,0:10:39.44,Default,,0,0,0,,Hay là chìa này?
Dialogue: 0,0:10:42.27,0:10:45.27,Default,,0,0,0,,Rọi đèn sang bên này giúp tôi với.\NTối quá chẳng nhìn thấy gì cả.
Dialogue: 0,0:10:45.35,0:10:47.23,Default,,0,0,0,,- Mắt mũi tôi dạo này kèm nhèm lắm.\N- Xin lỗi nhé.
Dialogue: 0,0:10:49.98,0:10:51.40,Default,,0,0,0,,Không phải chìa này rồi.
Dialogue: 0,0:10:53.65,0:10:54.65,Default,,0,0,0,,Thử chìa này xem sao?
Dialogue: 0,0:10:59.49,0:11:03.04,Default,,0,0,0,,Ông chủ vừa mới nhắn tin bảo là\Nông ấy đang đi du lịch một chuyến.
Dialogue: 0,0:11:03.70,0:11:05.41,Default,,0,0,0,,Ông ấy bảo làm cái nghề bán hàng ăn này,
Dialogue: 0,0:11:05.50,0:11:08.13,Default,,0,0,0,,chẳng mấy khi được đi xa,\Nnên nhân dịp này đổi gió một phen.
Dialogue: 0,0:11:08.21,0:11:09.75,Default,,0,0,0,,Ông ấy còn tận dụng gói ưu đãi kích cầu du lịch nữa cơ.
Dialogue: 0,0:11:09.84,0:11:11.13,Default,,0,0,0,,À, thảo nào.
Dialogue: 0,0:11:11.21,0:11:14.84,Default,,0,0,0,,Tầm này giá khách sạn đang rẻ bèo,\Nlại chẳng mấy ai đi du lịch.
Dialogue: 0,0:11:15.51,0:11:18.18,Default,,0,0,0,,Cơ mà khéo người dưới quê lại nổi quạu\Nkhi biết ông ấy từ Tokyo xuống cho xem.
Dialogue: 0,0:11:18.26,0:11:20.10,Default,,0,0,0,,Kiểu như: "Lão ta tha lôi mầm bệnh về đây kìa!"
Dialogue: 0,0:11:20.89,0:11:23.02,Default,,0,0,0,,Thế Ông chủ có nhắn bao giờ\Nông ấy quay về không?
Dialogue: 0,0:11:23.10,0:11:24.85,Default,,0,0,0,,Không, chẳng thấy ông ấy đả động gì.
Dialogue: 0,0:11:44.12,0:11:48.92,Default,,0,0,0,,NGÀY 1 THÁNG 10 NĂM 2021
Dialogue: 0,0:13:23.01,0:13:23.89,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:13:24.43,0:13:26.52,Default,,0,0,0,,Tụi em vào được không ạ? Đây là lần đầu tụi em ghé quán.
Dialogue: 0,0:13:27.01,0:13:29.22,Default,,0,0,0,,- Tất nhiên rồi, mời vào.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:13:30.64,0:13:33.18,Default,,0,0,0,,Bắt đầu từ hôm nay quán được phép phục vụ rượu bia trở lại rồi.
Dialogue: 0,0:13:33.94,0:13:35.90,Default,,0,0,0,,Tiếc là tụi em vẫn đang trong ca trực mất rồi.
Dialogue: 0,0:13:36.61,0:13:38.49,Default,,0,0,0,,- Nào, ngồi đi.\N- Dạ, cảm ơn.
Dialogue: 0,0:13:38.57,0:13:40.82,Default,,0,0,0,,Thực đơn của quán chỉ có bấy nhiêu thôi,\Nnhưng hai cậu muốn gọi món gì cũng được.
Dialogue: 0,0:13:41.36,0:13:42.78,Default,,0,0,0,,Chỉ cần làm được là tôi sẽ nấu.
Dialogue: 0,0:13:44.07,0:13:46.07,Default,,0,0,0,,Vậy cho tôi một suất cơm súp miso thịt heo nhé.
Dialogue: 0,0:13:46.66,0:13:47.49,Default,,0,0,0,,Cho em một suất giống vậy luôn ạ.
Dialogue: 0,0:13:47.58,0:13:49.08,Default,,0,0,0,,- Có ngay đây.\N- Làm ơn nhé.
Dialogue: 0,0:13:59.51,0:14:00.51,Default,,0,0,0,,Món này ngon thật đấy.
Dialogue: 0,0:14:00.59,0:14:01.84,Default,,0,0,0,,- Công nhận ngon.\N- Ừ.
Dialogue: 0,0:14:09.68,0:14:11.85,Default,,0,0,0,,- Cảm ơn Ông chủ vì bữa ăn.\N- Không có gì. Cảm ơn hai cậu.
Dialogue: 0,0:14:22.40,0:14:24.90,Default,,0,0,0,,Ông chủ mở cửa lại rồi!
Dialogue: 0,0:14:24.99,0:14:26.91,Default,,0,0,0,,- Lâu quá không gặp Ông chủ.\N- Chào mừng ba cô.
Dialogue: 0,0:14:26.99,0:14:28.58,Default,,0,0,0,,Ông chủ ơi, lâu ngày quá!
Dialogue: 0,0:14:28.66,0:14:30.00,Default,,0,0,0,,Một khởi đầu mới rồi đây!
Dialogue: 0,0:14:30.83,0:14:32.33,Default,,0,0,0,,Trước mắt cho tụi em ba cốc bia đã nhé.
Dialogue: 0,0:14:34.33,0:14:35.46,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:14:35.54,0:14:37.96,Default,,0,0,0,,Vậy cho em thêm món đậu phụ{\i1}{\i0} chiên giòn\Nvới vây cá đuối nướng nhé.
Dialogue: 0,0:14:38.04,0:14:40.29,Default,,0,0,0,,Còn em gọi tempura gừng đỏ.
Dialogue: 0,0:14:41.34,0:14:43.13,Default,,0,0,0,,Vậy thì em gọi…
Dialogue: 0,0:14:43.22,0:14:46.22,Default,,0,0,0,,Tôi vừa kiếm được mẻ khoai lang ngon tuyệt\Ngửi từ Kagoshima lên đấy.
Dialogue: 0,0:14:46.30,0:14:49.14,Default,,0,0,0,,Nếu đem xào chung với thịt gà,\Nnêm nếm vị mặn ngọt đậm đà,
Dialogue: 0,0:14:49.22,0:14:50.97,Default,,0,0,0,,nhắm cùng rượu bia là hết sẩy.
Dialogue: 0,0:14:51.06,0:14:53.02,Default,,0,0,0,,- Thế cho em gọi món đó luôn nhé!\N- Có ngay đây.
Dialogue: 0,0:15:00.77,0:15:01.98,Default,,0,0,0,,Ngon tuyệt cú mèo luôn.
Dialogue: 0,0:15:06.57,0:15:07.57,Default,,0,0,0,,Anh ăn thử một miếng không?
Dialogue: 0,0:15:09.16,0:15:11.37,Default,,0,0,0,,Được chứ. Vậy tôi không khách sáo nhé.
Dialogue: 0,0:15:16.33,0:15:17.66,Default,,0,0,0,,Biết ngay là Ông chủ đã mở cửa lại mà.
Dialogue: 0,0:15:17.75,0:15:18.58,Default,,0,0,0,,Chào mừng bác.
Dialogue: 0,0:15:19.84,0:15:21.88,Default,,0,0,0,,Tôi đoán thế nào hôm nay quán cũng mở lại.
Dialogue: 0,0:15:21.96,0:15:23.30,Default,,0,0,0,,Lâu ngày không gặp.
Dialogue: 0,0:15:23.38,0:15:25.63,Default,,0,0,0,,Lâu quá không gặp. Ô, bác Chu!
Dialogue: 0,0:15:26.55,0:15:28.39,Default,,0,0,0,,Ông chủ ơi, cho tôi như mọi khi nhé.
Dialogue: 0,0:15:28.47,0:15:29.30,Default,,0,0,0,,Vâng, có ngay.
Dialogue: 0,0:15:41.94,0:15:43.23,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:15:43.32,0:15:45.32,Default,,0,0,0,,Trứng cá tuyết nướng lòng đào.
Dialogue: 0,0:15:45.40,0:15:47.15,Default,,0,0,0,,Chính là nó! Đúng cái vị này rồi!
Dialogue: 0,0:15:47.78,0:15:49.11,Default,,0,0,0,,Tôi nhớ món này biết bao nhiêu.
Dialogue: 0,0:16:02.59,0:16:04.51,Default,,0,0,0,,Chào buổi tối cả nhà.
Dialogue: 0,0:16:04.59,0:16:05.55,Default,,0,0,0,,Chào mừng chị.
Dialogue: 0,0:16:06.47,0:16:07.30,Default,,0,0,0,,Ái chà!
Dialogue: 0,0:16:08.01,0:16:10.55,Default,,0,0,0,,Chị Kosuzu! Chị vẫn còn sống khỏe cơ à!
Dialogue: 0,0:16:10.64,0:16:11.98,Default,,0,0,0,,Mấy cái đứa này ăn nói kiểu gì thế hả?
Dialogue: 0,0:16:12.05,0:16:15.30,Default,,0,0,0,,Mấy cưng còn chưa chết\Nthì làm sao chị chết trước cho được?
Dialogue: 0,0:16:15.89,0:16:17.39,Default,,0,0,0,,Đổi chỗ cho nhau đi nào!
Dialogue: 0,0:16:17.48,0:16:19.61,Default,,0,0,0,,Đông quá lại chật kín cả quán bây giờ.
Dialogue: 0,0:16:19.69,0:16:22.90,Default,,0,0,0,,Phải luân phiên nhường chỗ cho người khác vào\Nđể không khí còn lưu thông nữa chứ.
Dialogue: 0,0:16:26.40,0:16:27.61,Default,,0,0,0,,Em no căng rồi.
Dialogue: 0,0:16:28.11,0:16:29.74,Default,,0,0,0,,- Cảm ơn vì bữa ăn nhé.\N- Ừ.
Dialogue: 0,0:16:30.99,0:16:32.62,Default,,0,0,0,,- Cảm ơn Ông chủ vì bữa ăn.\N- Hẹn gặp lại nhé.
Dialogue: 0,0:16:34.74,0:16:36.28,Default,,0,0,0,,- Cảm ơn mấy cô.\N- Cứ thong thả nhé.
Dialogue: 0,0:16:36.37,0:16:38.04,Default,,0,0,0,,Xin lỗi vì tụi em ngồi chiếm chỗ hơi lâu.
Dialogue: 0,0:16:38.12,0:16:40.46,Default,,0,0,0,,Ồ, có sao đâu. Hẹn gặp lại sau nhé.
Dialogue: 0,0:16:40.54,0:16:42.04,Default,,0,0,0,,- Hẹn gặp lại mọi người.\N- Chào nhé.
Dialogue: 0,0:16:44.75,0:16:45.84,Default,,0,0,0,,Hay mình vào quán nhé?
Dialogue: 0,0:16:46.55,0:16:47.63,Default,,0,0,0,,Em thấy ngồi ở đây là vừa đẹp rồi.
Dialogue: 0,0:16:48.17,0:16:49.01,Default,,0,0,0,,Ừ nhỉ.
Dialogue: 0,0:17:01.94,0:17:02.77,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:17:03.52,0:17:05.27,Default,,0,0,0,,Trứng cuộn tamagoyaki vị ngọt.
Dialogue: 0,0:17:05.36,0:17:06.57,Default,,0,0,0,,Xin phép thưởng thức ạ.
Dialogue: 0,0:17:15.95,0:17:17.24,Default,,0,0,0,,Cái hương vị này…
Dialogue: 0,0:17:19.58,0:17:21.96,Default,,0,0,0,,Thấm tận vào đáy lòng.
Dialogue: 0,0:17:23.54,0:17:25.38,Default,,0,0,0,,Thôi nhé Ông chủ. Cảm ơn vì bữa ăn.
Dialogue: 0,0:17:25.46,0:17:27.34,Default,,0,0,0,,Chúc Ông chủ ngủ ngon.
Dialogue: 0,0:17:29.05,0:17:29.88,Default,,0,0,0,,Cảm ơn hai người.
Dialogue: 0,0:17:29.97,0:17:31.39,Default,,0,0,0,,Chúc ngủ ngon nhé.
Dialogue: 0,0:17:31.47,0:17:33.06,Default,,0,0,0,,Ủa, sao hai người không vào trong quán ngồi?
Dialogue: 0,0:17:33.14,0:17:34.48,Default,,0,0,0,,Ngồi ngoài này cũng tuyệt lắm rồi, cảm ơn nhé.
Dialogue: 0,0:17:34.55,0:17:36.55,Default,,0,0,0,,- Hẹn gặp lại sau nha.\N- Ừ.
Dialogue: 0,0:17:40.39,0:17:41.64,Default,,0,0,0,,Hay là anh em mình vào quán đi?
Dialogue: 0,0:17:41.73,0:17:42.98,Default,,0,0,0,,Ừ, chí phải đấy.
Dialogue: 0,0:17:43.06,0:17:44.35,Default,,0,0,0,,Ô, ông Kanemoto!
Dialogue: 0,0:17:44.44,0:17:45.86,Default,,0,0,0,,Hachiro đấy à! Lâu quá không gặp!
Dialogue: 0,0:17:47.82,0:17:50.11,Default,,0,0,0,,Mừng quá vì được gặp lại anh!
Dialogue: 0,0:17:50.19,0:17:52.65,Default,,0,0,0,,- Ồ, đông đủ cả nhà rồi!\N- Mời vào!
Dialogue: 0,0:17:52.74,0:17:53.99,Default,,0,0,0,,Chào buổi tối mọi người.
Dialogue: 0,0:17:55.91,0:17:57.79,Default,,0,0,0,,- Ngồi đây ổn mà.\N- Ừ.
Dialogue: 0,0:17:57.87,0:18:01.00,Default,,0,0,0,,- Này Kosuzu, dịch vào trong một chút đi.\N- Cái gì cơ?
Dialogue: 0,0:18:01.08,0:18:03.37,Default,,0,0,0,,Cứ giục cuống lên là cậu ấy mắc nghẹn bây giờ!
Dialogue: 0,0:18:03.46,0:18:04.92,Default,,0,0,0,,Này chị Kosuzu.
Dialogue: 0,0:18:05.00,0:18:06.84,Default,,0,0,0,,Em vừa dính COVID đấy.
Dialogue: 0,0:18:06.92,0:18:08.96,Default,,0,0,0,,Cái gì? Dính COVID á?
Dialogue: 0,0:18:09.05,0:18:11.68,Default,,0,0,0,,- Tránh xa bà ra ngay, đồ COVID!\N- Không, ý em không phải thế!
Dialogue: 0,0:18:11.76,0:18:13.39,Default,,0,0,0,,- Cái gì thế?\N- Khoan đã, cái tấm chắn này không phải của mình!
Dialogue: 0,0:18:13.47,0:18:15.35,Default,,0,0,0,,- Đừng mà…\N- Chỗ này dành cho hai người ngồi cơ mà!
Dialogue: 0,0:18:15.43,0:18:17.89,Default,,0,0,0,,- Làm rớt đồ rồi kìa!\N- Cứu tôi với!
Dialogue: 0,0:18:17.97,0:18:21.27,Default,,0,0,0,,- Có COVID kìa!\N- Đã bảo là không phải thế mà!
Dialogue: 0,0:18:21.35,0:18:22.18,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:18:22.77,0:18:23.60,Default,,0,0,0,,Là sao thế?
Dialogue: 0,0:18:25.94,0:18:26.77,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:18:26.86,0:18:28.61,Default,,0,0,0,,Em khỏi bệnh hoàn toàn rồi mà!
Dialogue: 0,0:18:28.69,0:18:30.57,Default,,0,0,0,,Cậu may mắn đấy, chỉ bị nhẹ thôi.
Dialogue: 0,0:18:32.19,0:18:33.82,Default,,0,0,0,,Khoan đã, thế là sao?
Dialogue: 0,0:18:33.90,0:18:35.90,Default,,0,0,0,,Em khỏe re rồi.
Dialogue: 0,0:18:35.99,0:18:37.24,Default,,0,0,0,,Thôi dừng lại đi, thiệt tình.
Dialogue: 0,0:18:37.32,0:18:39.16,Default,,0,0,0,,Sao mọi người cứ làm quá lên thế?
Dialogue: 0,0:18:57.14,0:18:58.72,Default,,0,0,0,,Cứ như đang ở trên thiên đường vậy!
Dialogue: 0,0:18:59.22,0:19:01.01,Default,,0,0,0,,Cái cảm giác này…
Dialogue: 0,0:19:01.10,0:19:02.60,Default,,0,0,0,,Hoài niệm quá đỗi, đúng không?
Dialogue: 0,0:19:02.68,0:19:03.51,Default,,0,0,0,,Đúng thế!
Dialogue: 0,0:19:03.60,0:19:06.69,Default,,0,0,0,,Suốt thời gian qua cứ phải ru rú trong phòng\Năn cơm một mình bức bối muốn chết!
Dialogue: 0,0:19:09.94,0:19:10.94,Default,,0,0,0,,Ngon quá đi mất!
Dialogue: 0,0:19:13.99,0:19:15.45,Default,,0,0,0,,Quán vẫn còn giới hạn giờ mở cửa đấy!
Dialogue: 0,0:19:15.53,0:19:17.28,Default,,0,0,0,,- Phải tranh thủ ăn lẹ thôi.\N- Ờ ha, quên mất.
Dialogue: 0,0:19:17.36,0:19:19.28,Default,,0,0,0,,Ông chủ ơi, có cần em phụ giúp gì không?
Dialogue: 0,0:19:19.87,0:19:21.66,Default,,0,0,0,,Cứ bảo em nhé. Em rửa bát phụ cho.
Dialogue: 0,0:19:21.74,0:19:23.37,Default,,0,0,0,,Ồ, cảm ơn cô.
Dialogue: 0,0:19:24.25,0:19:26.79,Default,,0,0,0,,Nhưng hiện tại tôi vẫn tự xoay xở được.
Dialogue: 0,0:19:55.94,0:19:57.65,Default,,0,0,0,,Món quà này đại ca em gửi biếu Ông chủ.
Dialogue: 0,0:20:00.41,0:20:01.79,Default,,0,0,0,,Để chúc mừng quán mở cửa trở lại.
Dialogue: 0,0:20:03.54,0:20:05.63,Default,,0,0,0,,Tôi xin nhận tấm lòng nhé.
Dialogue: 0,0:20:08.12,0:20:09.29,Default,,0,0,0,,Hai người có muốn…
Dialogue: 0,0:20:10.08,0:20:11.21,Default,,0,0,0,,ngồi lại ăn chút gì không?
Dialogue: 0,0:20:18.22,0:20:19.14,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:20:19.89,0:20:22.48,Default,,0,0,0,,Xúc xích đỏ chiên kiểu bạch tuộc sáu chân.
Dialogue: 0,0:20:47.00,0:20:48.42,Default,,0,0,0,,Ngon thật sự đấy ạ.
Dialogue: 0,0:20:51.38,0:20:53.51,Default,,0,0,0,,Biết rồi, lần nào ăn chú mày cũng nói đúng câu đó.
Dialogue: 0,0:20:54.84,0:20:55.68,Default,,0,0,0,,Dạ vâng, thưa đại ca.
Dialogue: 0,0:21:02.43,0:21:03.89,Default,,0,0,0,,{\i1}Sau một khoảng thời gian,{\i0}
Dialogue: 0,0:21:04.51,0:21:07.64,Default,,0,0,0,,{\i1}tôi đã có thể mở cửa buôn bán bình thường trở lại.{\i0}
Dialogue: 0,0:21:08.85,0:21:11.02,Default,,0,0,0,,{\i1}Nhịp sống tấp nập quen thuộc ngày nào đã quay về.{\i0}
Dialogue: 0,0:21:12.15,0:21:13.65,Default,,0,0,0,,{\i1}Tôi thực sự biết ơn vì điều đó.{\i0}
Dialogue: 0,0:21:17.53,0:21:22.33,Default,,0,0,0,,NĂM 2026
Dialogue: 0,0:21:41.09,0:21:42.34,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:21:42.43,0:21:43.68,Default,,0,0,0,,Hôm nay anh đến sớm vậy.
Dialogue: 0,0:21:43.76,0:21:44.64,Default,,0,0,0,,Đây.
Dialogue: 0,0:21:45.22,0:21:47.35,Default,,0,0,0,,Tôi có món quà tặng Ông chủ.
Dialogue: 0,0:21:47.43,0:21:48.43,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:21:48.52,0:21:49.90,Default,,0,0,0,,Bảng thực đơn mới đấy.
Dialogue: 0,0:21:49.98,0:21:52.40,Default,,0,0,0,,Chẳng phải Ông chủ đã báo với mọi người\Nlà quán sắp tăng giá còn gì.
Dialogue: 0,0:21:53.90,0:21:56.45,Default,,0,0,0,,Tôi tăng đồng loạt mỗi món thêm 100 yên.\NNhư vậy có ổn không?
Dialogue: 0,0:21:57.11,0:21:58.74,Default,,0,0,0,,Ổn thì ổn, cơ mà…
Dialogue: 0,0:21:59.99,0:22:03.74,Default,,0,0,0,,Nếu viết lên giấy mới tinh\Nthì lại lạc quẻ với không khí cổ kính của quán mất.
Dialogue: 0,0:22:04.61,0:22:07.86,Default,,0,0,0,,Còn nếu chỉ dán đè giá mới lên tờ giấy cũ\Nthì trông lại chắp vá kỳ cục.
Dialogue: 0,0:22:09.95,0:22:11.74,Default,,0,0,0,,Ồ, vừa vặn hoàn hảo luôn.
Dialogue: 0,0:22:12.50,0:22:15.88,Default,,0,0,0,,Khéo bác Chu nhìn vào cũng chẳng nhận ra\Nlà bảng thực đơn đã bị thay mới đâu nhỉ.
Dialogue: 0,0:22:15.96,0:22:16.88,Default,,0,0,0,,Đúng không nào?
Dialogue: 0,0:22:19.63,0:22:20.84,Default,,0,0,0,,Anh uống chút gì nhé?
Dialogue: 0,0:22:21.84,0:22:23.34,Default,,0,0,0,,Ông chủ cứ chọn giúp tôi một món đi.
Dialogue: 0,0:22:25.43,0:22:26.51,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:23:41.04,0:23:43.88,Default,,0,0,0,,ĐÂY LÀ TÁC PHẨM HƯ CẤU
Dialogue: 0,0:23:43.96,0:23:46.92,Default,,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)
