Dialogue: 0,0:00:04.12,0:00:07.17,Default,,0,0,0,,KOBAYASHI Kaoru
Dialogue: 0,0:00:18.12,0:00:21.17,Default,,0,0,0,,KUROTANI Tomoka
Dialogue: 0,0:00:38.52,0:00:41.57,Default,,0,0,0,,LILY Franky
Dialogue: 0,0:00:54.12,0:00:57.12,Default,,0,0,0,,ODAGIRI Joe
Dialogue: 0,0:00:56.42,0:00:58.49,Default,,0,0,0,,- Tìm thấy hắn rồi!\N- Hắn ở đằng kia...
Dialogue: 0,0:00:58.92,0:01:00.94,Default,,0,0,0,,Đúng là hắn rồi...
Dialogue: 0,0:01:02.69,0:01:04.84,Default,,0,0,0,,Đứng im, không được chống cự!
Dialogue: 0,0:01:08.56,0:01:10.18,Default,,0,0,0,,("Triệt phá đường dây cờ bạc phi pháp lớn nhất Shinjuku...\NBắt giữ các đối tượng tổ chức đánh bạc trục lợi...")
Dialogue: 0,0:01:10.18,0:01:10.86,Default,,0,0,0,,("Nghi phạm bị bắt giữ: Katagiri")
Dialogue: 0,0:01:10.86,0:01:12.81,Default,,0,0,0,,Vào đêm hôm ấy, 8 năm về trước...\N("Nghi phạm bị bắt giữ: Katagiri")
Dialogue: 0,0:01:12.81,0:01:13.56,Default,,0,0,0,,("Nghi phạm bị bắt giữ: Katagiri")
Dialogue: 0,0:01:13.56,0:01:15.88,Default,,0,0,0,,Thời gian dường như đã ngưng đọng lại đối với anh.\N("Nghi phạm bị bắt giữ: Katagiri")
Dialogue: 0,0:01:15.88,0:01:16.52,Default,,0,0,0,,("Nghi phạm bị bắt giữ: Katagiri")
Dialogue: 0,0:01:19.40,0:01:22.40,Default,,0,0,0,,Đạo diễn: MATSUOKA Joji
Dialogue: 0,0:01:22.40,0:01:24.21,Default,,0,0,0,,Anh đã mất đi tất cả mọi thứ.\NĐạo diễn: MATSUOKA Joji
Dialogue: 0,0:01:24.72,0:01:27.52,Default,,0,0,0,,Vẫn siết chặt trong tay những hạt mầm hy vọng...
Dialogue: 0,0:01:28.31,0:01:32.61,Default,,0,0,0,,...được phong kín lại cùng bao ký ức đắng cay muộn màng.
Dialogue: 0,0:01:50.01,0:01:55.61,Default,,0,0,0,,QUÁN ĂN ĐÊM (Mùa 2)\N"Shinya Shokudo"
Dialogue: 0,0:01:59.31,0:02:04.31,Default,,0,0,0,,Câu chuyện cuối cùng (Tập 10):\N"Há cảo Gyoza"
Dialogue: 0,0:02:05.31,0:02:09.31,Default,,0,0,0,,Biên dịch và căn chỉnh thời gian:\NAmtia(NOFACE)
Dialogue: 0,0:02:10.46,0:02:16.06,Default,,0,0,0,,Ông chủ... Cho tôi thêm một ly bia gừng\Nvới một đĩa há cảo gyoza vị tỏi nữa nhé.
Dialogue: 0,0:02:16.85,0:02:18.88,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:02:19.02,0:02:21.08,Default,,0,0,0,,Giao hàng đấy à chú?
Dialogue: 0,0:02:24.45,0:02:28.76,Default,,0,0,0,,A lô?\NQuán có còn nhận giao hàng đến quán Meshiya không ạ?
Dialogue: 0,0:02:33.69,0:02:35.03,Default,,0,0,0,,Cảm ơn quý khách đã ủng hộ quán.
Dialogue: 0,0:02:35.08,0:02:35.70,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:02:35.70,0:02:38.80,Default,,0,0,0,,Xin lỗi anh nhé... Đã đến giờ quán đóng cửa rồi\Nmà còn phiền anh phải cất công mang đồ tới tận đây.
Dialogue: 0,0:02:38.80,0:02:40.86,Default,,0,0,0,,Dạ không có gì đâu ạ.
Dialogue: 0,0:02:41.35,0:02:45.10,Default,,0,0,0,,Bình thường quán em nhận giao hàng đến 1 giờ sáng,\Nnhưng vì con gái nhỏ còn bé quá nên...
Dialogue: 0,0:02:45.56,0:02:46.98,Default,,0,0,0,,- Của anh đây ạ.\N- Cảm ơn chú em nhé.
Dialogue: 0,0:02:48.62,0:02:51.56,Default,,0,0,0,,Còn cái này nữa ạ...\NEm tự tay chưng hũ sa tế ớt này, anh cứ dùng thử nhé.
Dialogue: 0,0:02:51.56,0:02:53.13,Default,,0,0,0,,Thật thế à?
Dialogue: 0,0:02:53.13,0:02:55.98,Default,,0,0,0,,Thế thì cảm ơn chú em nhiều nhé, tôi xin nhận.
Dialogue: 0,0:02:55.98,0:02:57.83,Default,,0,0,0,,Cảm ơn quý khách đã luôn ủng hộ ạ.
Dialogue: 0,0:02:57.83,0:02:59.50,Default,,0,0,0,,- Cảm ơn chú em nhé.\N- Dạ không có chi ạ.
Dialogue: 0,0:03:12.85,0:03:15.09,Default,,0,0,0,,Món này ăn ngon tuyệt đỉnh luôn đấy...
Dialogue: 0,0:03:15.50,0:03:19.13,Default,,0,0,0,,Nhưng mà này ông chủ...\NTrước đây chú cũng tự tay làm há cảo gyoza cơ mà?
Dialogue: 0,0:03:19.39,0:03:23.79,Default,,0,0,0,,Ừ.\NNhưng tôi thích ăn đồ tiệm đó làm hơn là tự mình lăn vào bếp.
Dialogue: 0,0:03:24.38,0:03:26.38,Default,,0,0,0,,Nên tôi cứ gọi điện đặt người ta mang tới cho tiện.
Dialogue: 0,0:03:26.90,0:03:30.46,Default,,0,0,0,,Ở Kamata vùng Tokyo, đặc biệt là quanh khu vực Haneda,\Nmón há cảo gyoza ở đó nổi tiếng nức danh đấy.
Dialogue: 0,0:03:31.93,0:03:36.27,Default,,0,0,0,,Cậu chủ vừa mang bánh tới đây...\Ntừng theo học nghề ở một nhà hàng Trung Hoa tại Haneda đấy.
Dialogue: 0,0:03:36.70,0:03:38.72,Default,,0,0,0,,Cậu ấy luôn ấp ủ ước mơ mở được\Nmột quán ăn của riêng mình...
Dialogue: 0,0:03:39.20,0:03:41.49,Default,,0,0,0,,Đến giờ thì rốt cuộc cũng khai trương được một quán nhỏ ở gần đây rồi.
Dialogue: 0,0:03:44.83,0:03:47.13,Default,,0,0,0,,Công nhận... ngon quá xá!
Dialogue: 0,0:03:47.13,0:03:49.12,Default,,0,0,0,,Đúng không nào?
Dialogue: 0,0:04:00.45,0:04:02.91,Default,,0,0,0,,Để anh làm nốt chỗ còn lại cho, em đi ngủ trước đi.
Dialogue: 0,0:04:04.25,0:04:06.24,Default,,0,0,0,,Em gói nốt một cái nữa thôi mà.
Dialogue: 0,0:04:07.84,0:04:10.38,Default,,0,0,0,,"Nốt một cái... nốt một cái..."\Nanh nghe em lặp đi lặp lại câu đó suốt 3 phút rồi đấy nhé.
Dialogue: 0,0:04:11.12,0:04:13.14,Default,,0,0,0,,Thế ạ.
Dialogue: 0,0:04:14.90,0:04:16.68,Default,,0,0,0,,Không sao đâu anh.
Dialogue: 0,0:04:16.76,0:04:19.24,Default,,0,0,0,,Hai người cùng làm thì sẽ nhanh hơn nhiều mà.
Dialogue: 0,0:04:23.93,0:04:25.99,Default,,0,0,0,,Kìa em, sao tự dưng dừng tay lại thế...
Dialogue: 0,0:04:27.90,0:04:29.95,Default,,0,0,0,,À, dạ vâng.
Dialogue: 0,0:04:49.62,0:04:53.64,Default,,0,0,0,,Này ông chủ... món há cảo vẫn chưa tới nơi sao?
Dialogue: 0,0:04:54.50,0:04:56.59,Default,,0,0,0,,Để tôi gọi điện giục họ xem sao nhé.
Dialogue: 0,0:04:59.60,0:05:02.12,Default,,0,0,0,,Xin lỗi mọi người! Cảm ơn vì đã kiên nhẫn chờ tôi nhé.
Dialogue: 0,0:05:03.20,0:05:05.61,Default,,0,0,0,,- Hàng tới rồi kìa!\N- Cuối cùng cũng đến!
Dialogue: 0,0:05:06.57,0:05:09.90,Default,,0,0,0,,Cuối cùng tụi mình cũng được thưởng thức\Nmón há cảo gyoza huyền thoại rồi.
Dialogue: 0,0:05:11.05,0:05:13.24,Default,,0,0,0,,- Sao hôm nay lại là chị đi giao hàng thế?\N- Em đặt đĩa bánh ở đây được không ạ?
Dialogue: 0,0:05:12.84,0:05:14.91,Default,,0,0,0,,- Được chứ!\N- Vâng ạ.
Dialogue: 0,0:05:15.70,0:05:19.48,Default,,0,0,0,,Hôm nay quán em có nhiều đơn đặt hàng quá...
Dialogue: 0,0:05:19.48,0:05:21.47,Default,,0,0,0,,...nên thành thử ra...
Dialogue: 0,0:05:21.75,0:05:24.23,Default,,0,0,0,,...chồng em mới bảo em\Nchạy ù qua đây giao giúp.
Dialogue: 0,0:05:24.65,0:05:26.70,Default,,0,0,0,,Ra là vậy...\NÀ, tiền đây cô.
Dialogue: 0,0:05:27.53,0:05:29.56,Default,,0,0,0,,Cô cầm lấy nhé.
Dialogue: 0,0:05:32.14,0:05:34.14,Default,,0,0,0,,Cảm ơn mọi người đã ủng hộ quán em ạ.
Dialogue: 0,0:05:34.37,0:05:36.54,Default,,0,0,0,,Hẹn gặp lại lần sau nhé.
Dialogue: 0,0:06:21.41,0:06:23.47,Default,,0,0,0,,Sao cô ấy lại là người đi giao hàng thế nhỉ?
Dialogue: 0,0:06:26.19,0:06:31.11,Default,,0,0,0,,Chính tôi cũng bất ngờ đấy chứ... Tôi đâu có ngờ cô ấy\Nlại là vợ của anh chủ tiệm há cảo đâu.
Dialogue: 0,0:06:37.19,0:06:40.54,Default,,0,0,0,,Cậu còn nhớ chuyện 8 năm về trước không?
Dialogue: 0,0:06:46.71,0:06:49.93,Default,,0,0,0,,{\i1}Anh ấy đến muộn quá nhỉ?{\i0}
Dialogue: 0,0:06:53.05,0:06:56.39,Default,,0,0,0,,{\i1}Hôm nay là sinh nhật của tôi đấy.{\i0}
Dialogue: 0,0:06:58.67,0:07:03.32,Default,,0,0,0,,{\i1}Tôi bắt đầu thấy bồn chồn sốt ruột vì anh ấy gọi điện bảo tôi đợi ở đây...{\i0}
Dialogue: 0,0:07:05.77,0:07:09.44,Default,,0,0,0,,{\i1}Và bảo rằng đúng 12 giờ đêm,\Nanh ấy sẽ trao nhẫn cho tôi.{\i0}
Dialogue: 0,0:07:12.52,0:07:15.18,Default,,0,0,0,,{\i1}Hóa ra anh ấy cũng chỉ là hạng đàn ông\Nchẳng biết giữ lời hứa.{\i0}
Dialogue: 0,0:07:16.85,0:07:20.59,Default,,0,0,0,,{\i1}Thế mà tôi đã trót tin anh ấy thật lòng.{\i0}
Dialogue: 0,0:07:23.73,0:07:26.87,Default,,0,0,0,,Tốt nhất là cậu nên dẹp bỏ những suy nghĩ viển vông đó đi.
Dialogue: 0,0:07:33.18,0:07:35.56,Default,,0,0,0,,Tôi chỉ muốn tìm lại cuộc sống năm xưa của mình thôi mà.
Dialogue: 0,0:07:36.89,0:07:38.43,Default,,0,0,0,,Đừng dính líu đến chuyện đó nữa.
Dialogue: 0,0:07:40.65,0:07:45.31,Default,,0,0,0,,Chuyện ngày đó giữa cậu và cô ấy\Nđã chấm dứt từ lâu lắm rồi.
Dialogue: 0,0:07:48.82,0:07:50.84,Default,,0,0,0,,Suốt tám năm ròng rã vừa qua...
Dialogue: 0,0:07:51.99,0:07:54.25,Default,,0,0,0,,...đối với cô ấy cũng từng là những chuỗi ngày đau khổ, thế nhưng...
Dialogue: 0,0:07:55.03,0:07:57.25,Default,,0,0,0,,...cô ấy đã chọn bước đi trên\Nmột con đường hoàn toàn khác rồi.
Dialogue: 0,0:08:01.05,0:08:03.36,Default,,0,0,0,,Kể từ bây giờ cũng sẽ là như vậy.
Dialogue: 0,0:08:07.28,0:08:10.48,Default,,0,0,0,,Đúng là hổ thẹn thật đấy...\Nnhưng chẳng lẽ thật sự không còn cách nào cứu vãn sao?
Dialogue: 0,0:08:16.42,0:08:18.60,Default,,0,0,0,,Chào buổi tối cả nhà.
Dialogue: 0,0:08:20.42,0:08:22.40,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:08:23.57,0:08:25.25,Default,,0,0,0,,Ông chủ này.
Dialogue: 0,0:08:26.47,0:08:28.90,Default,,0,0,0,,Anh rất hài lòng với món há cảo quán em làm đúng không?
Dialogue: 0,0:08:29.70,0:08:31.70,Default,,0,0,0,,Ừ.
Dialogue: 0,0:08:32.62,0:08:35.03,Default,,0,0,0,,Nhưng anh cũng nên tự tay học làm món này đi...
Dialogue: 0,0:08:35.46,0:08:38.56,Default,,0,0,0,,...để những hôm quán em đóng cửa nghỉ bán...
Dialogue: 0,0:08:38.94,0:08:41.56,Default,,0,0,0,,...thì anh vẫn có thể tự tin phục vụ há cảo gyoza\Ncho các thực khách của mình chứ.
Dialogue: 0,0:08:42.43,0:08:46.05,Default,,0,0,0,,Món của chú làm ngon hơn nhiều... Tay nghề của tôi\Nsao bì được với há cảo của chú được.
Dialogue: 0,0:08:46.78,0:08:49.43,Default,,0,0,0,,Anh đừng khách sáo quá thế, ông chủ.
Dialogue: 0,0:08:51.74,0:08:55.16,Default,,0,0,0,,Tuần sau là sinh nhật của vợ em rồi.
Dialogue: 0,0:08:55.67,0:08:57.62,Default,,0,0,0,,Hôm đó quán em sẽ đóng cửa nghỉ một ngày.
Dialogue: 0,0:08:57.62,0:08:59.62,Default,,0,0,0,,Thật thế à?
Dialogue: 0,0:09:02.18,0:09:04.46,Default,,0,0,0,,Đây là cuộc hôn nhân thứ hai của em.
Dialogue: 0,0:09:05.33,0:09:08.37,Default,,0,0,0,,Bé Asuka là con gái riêng của em với người vợ trước.
Dialogue: 0,0:09:09.01,0:09:13.27,Default,,0,0,0,,Thế nhưng vợ em bây giờ đối xử với con bé\Nthương yêu chẳng khác nào mẹ ruột.
Dialogue: 0,0:09:15.44,0:09:19.00,Default,,0,0,0,,Ông chủ ơi, con bé nhà em từ lâu\Nđã hằng mong ước được ghé quán anh chơi rồi đấy.
Dialogue: 0,0:09:19.23,0:09:21.24,Default,,0,0,0,,Em muốn đưa cả vợ em cùng tới đây.
Dialogue: 0,0:09:21.24,0:09:25.62,Default,,0,0,0,,Em sẽ chỉ cho anh bí quyết làm há cảo gyoza, đổi lại,\Nanh cùng chung vui mừng sinh nhật cô ấy với gia đình em nhé.
Dialogue: 0,0:09:27.40,0:09:30.20,Default,,0,0,0,,Nhưng không cần phải quà cáp gì đâu anh.
Dialogue: 0,0:09:30.56,0:09:32.51,Default,,0,0,0,,Chỉ cần có mặt anh chung vui là quý hóa lắm rồi.
Dialogue: 0,0:09:33.26,0:09:34.92,Default,,0,0,0,,Được chứ, nhất trí luôn.
Dialogue: 0,0:09:45.17,0:09:47.61,Default,,0,0,0,,Bốn suất há cảo áp chảo nhé em.
Dialogue: 0,0:09:47.61,0:09:49.65,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:09:52.96,0:09:55.43,Default,,0,0,0,,Cảm ơn quý khách đã gọi điện,\Nđây là tiệm Há cảo Anomori xin nghe...
Dialogue: 0,0:09:58.23,0:10:00.13,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:10:00.75,0:10:02.73,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:04.51,0:10:06.51,Default,,0,0,0,,Có đơn đặt hàng mới à em?
Dialogue: 0,0:10:07.97,0:10:09.92,Default,,0,0,0,,Điện thoại của gia đình gọi đấy anh.
Dialogue: 0,0:10:12.30,0:10:16.04,Default,,0,0,0,,Bố em bảo ông vẫn muốn tiếp tục\Nlàm việc ở xưởng cơ khí...
Dialogue: 0,0:10:16.78,0:10:18.72,Default,,0,0,0,,Ngày mai em phải qua thăm ông một chuyến mới được.
Dialogue: 0,0:10:19.01,0:10:22.09,Default,,0,0,0,,Được rồi...\NEm nhớ khuyên ông nghỉ ngơi, đừng làm việc quá sức nữa nhé.
Dialogue: 0,0:10:23.90,0:10:25.96,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:10:42.70,0:10:46.14,Default,,0,0,0,,Em cũng đâu có biết chuyện ngày đó anh bị bắt giam.
Dialogue: 0,0:10:49.30,0:10:51.51,Default,,0,0,0,,Mãi sau này, bố em ngã bệnh nặng...
Dialogue: 0,0:10:53.48,0:10:56.24,Default,,0,0,0,,Em đã phải túc trực chăm sóc ông suốt ngày đêm\Ntrong bệnh viện.
Dialogue: 0,0:11:03.17,0:11:05.58,Default,,0,0,0,,Em cứ ngỡ là anh đã nhẫn tâm bỏ rơi em rồi.
Dialogue: 0,0:11:08.83,0:11:10.85,Default,,0,0,0,,Tôi cũng từng nghĩ về cô như thế.
Dialogue: 0,0:11:13.46,0:11:16.49,Default,,0,0,0,,Dù trong lòng chưa từng một giây phút nào nguôi quên hình bóng anh...
Dialogue: 0,0:11:17.20,0:11:19.37,Default,,0,0,0,,...thế nhưng lúc đó em chẳng còn tâm trí đâu để bận lòng về chuyện đó nữa.
Dialogue: 0,0:11:25.20,0:11:29.97,Default,,0,0,0,,Sau khi bố em xuất viện được một thời gian ngắn...
Dialogue: 0,0:11:29.97,0:11:35.87,Default,,0,0,0,,Em đã đi xem mắt với anh ấy...\N...và rồi gật đầu nên duyên vợ chồng.
Dialogue: 0,0:11:39.87,0:11:42.01,Default,,0,0,0,,Cô có con chưa?
Dialogue: 0,0:11:43.33,0:11:48.23,Default,,0,0,0,,Vợ chồng em có một đứa con gái...\Ncon bé đang học tiểu học rồi.
Dialogue: 0,0:11:50.62,0:11:52.80,Default,,0,0,0,,Thế còn anh?
Dialogue: 0,0:12:00.07,0:12:04.49,Default,,0,0,0,,Sắp đến ngày sinh nhật của em rồi nhỉ.
Dialogue: 0,0:12:09.62,0:12:11.59,Default,,0,0,0,,Liệu bây giờ tôi còn cơ hội để thực hiện lời hứa năm xưa với em không?
Dialogue: 0,0:12:13.04,0:12:15.08,Default,,0,0,0,,Chúng mình cùng nhau đi đến một nơi nào đó thật xa nhé.
Dialogue: 0,0:12:17.60,0:12:19.72,Default,,0,0,0,,Anh đừng đùa cợt như thế nữa!
Dialogue: 0,0:12:21.45,0:12:23.20,Default,,0,0,0,,Chuyện đó cũng đã là dĩ vãng xa xôi rồi.
Dialogue: 0,0:12:28.02,0:12:30.86,Default,,0,0,0,,Em cứ ngỡ cả đời này sẽ chẳng bao giờ còn gặp lại anh nữa.
Dialogue: 0,0:12:31.01,0:12:34.35,Default,,0,0,0,,Nên em đã chôn chặt và xóa sạch khỏi tâm trí\Nnhững tháng ngày tươi đẹp từng bên anh rồi.
Dialogue: 0,0:12:36.96,0:12:39.03,Default,,0,0,0,,Như thế thì có gì sai trái chứ?
Dialogue: 0,0:12:40.60,0:12:43.68,Default,,0,0,0,,Nếu không tình cờ gặp lại anh ở đây,\Ncả đời này em sẽ chẳng bao giờ nhớ về anh nữa đâu.
Dialogue: 0,0:12:47.21,0:12:49.75,Default,,0,0,0,,Em phải về sớm đây...
Dialogue: 0,0:12:53.08,0:12:55.01,Default,,0,0,0,,Xin anh đừng làm như thế nữa.
Dialogue: 0,0:12:55.47,0:12:59.87,Default,,0,0,0,,Đúng 7 giờ tối vào đêm sinh nhật của em,\Ntôi sẽ đứng đợi em ở ngay trước cửa quán ăn này.
Dialogue: 0,0:13:52.89,0:13:55.12,Default,,0,0,0,,{\i1}Trận tuyết rơi từ hôm qua\Nvẫn chưa kịp tan biến...{\i0}
Dialogue: 0,0:13:56.18,0:14:00.91,Default,,0,0,0,,{\i1}Hiếm khi nào tuyết đọng lại lâu đến thế...\Nnó vẫn vương lại trắng xóa đúng vào ngày sinh nhật của cô ấy.{\i0}
Dialogue: 0,0:14:04.80,0:14:06.83,Default,,0,0,0,,Ông chủ ơi.
Dialogue: 0,0:14:07.40,0:14:09.88,Default,,0,0,0,,Cháu biết vì sao chú lại có vết sẹo dài trên mặt rồi nhé.
Dialogue: 0,0:14:10.35,0:14:13.49,Default,,0,0,0,,- Asuka, không được thất lễ thế con.\N- Cháu nói xem vết sẹo này từ đâu mà có nào?
Dialogue: 0,0:14:13.95,0:14:16.13,Default,,0,0,0,,Chú bị người ta ném trúng con quay yoyo đúng không ạ?
Dialogue: 0,0:14:16.22,0:14:18.37,Default,,0,0,0,,Hồi trước cháu cũng lỡ tay ném trúng bạn Kaoru-chan\Nchảy cả máu đầu luôn đấy.
Dialogue: 0,0:14:18.94,0:14:20.66,Default,,0,0,0,,Nhưng mà chẳng mấy chốc là bạn ấy khỏi liền à.
Dialogue: 0,0:14:20.74,0:14:24.06,Default,,0,0,0,,Em xin lỗi anh nhiều lắm nhé, ông chủ.\NCon bé này chuyên gia nói năng bộc trực thế đấy ạ.
Dialogue: 0,0:14:28.87,0:14:31.09,Default,,0,0,0,,Bố ơi, bố đoán xem con đang làm cái gì này.
Dialogue: 0,0:14:31.09,0:14:32.98,Default,,0,0,0,,- Trông hơi méo mó một tí.\N- Cái gì thế con?
Dialogue: 0,0:14:34.25,0:14:36.21,Default,,0,0,0,,Trông xấu xí ghê cơ.
Dialogue: 0,0:14:36.74,0:14:38.23,Default,,0,0,0,,Có phải là cái bánh sừng bò không con gái?
Dialogue: 0,0:14:38.23,0:14:40.26,Default,,0,0,0,,Bố đoán chuẩn luôn!
Dialogue: 0,0:14:43.33,0:14:48.14,Default,,0,0,0,,Ông chủ ơi.\NBố mẹ cháu chẳng bao giờ cãi nhau đâu nhé.
Dialogue: 0,0:14:48.66,0:14:50.50,Default,,0,0,0,,Hai người họ thương nhau lắm cơ.
Dialogue: 0,0:14:50.59,0:14:53.10,Default,,0,0,0,,- Tình cảm mặn nồng lắm đúng không cháu?\N- Chuẩn luôn chú ơi, siêu cấp ngọt ngào luôn!
Dialogue: 0,0:14:55.78,0:14:59.15,Default,,0,0,0,,- Ủa? Để đâu mất rồi nhỉ?\N- Sao thế anh?
Dialogue: 0,0:14:59.74,0:15:02.95,Default,,0,0,0,,Tờ công thức chưng dầu sa tế ớt\Nanhi viết riêng cho ông chủ ấy mà...
Dialogue: 0,0:15:03.45,0:15:05.90,Default,,0,0,0,,Hình như anh quên mang theo rồi.
Dialogue: 0,0:15:06.29,0:15:09.63,Default,,0,0,0,,- Thôi để dịp khác đưa cũng được mà chú em.\N- Dạ không sao đâu, để em chạy về lấy loáng cái là xong.
Dialogue: 0,0:15:12.79,0:15:14.67,Default,,0,0,0,,Bố ơi, cho con đi cùng với bố nhé?
Dialogue: 0,0:15:14.67,0:15:16.58,Default,,0,0,0,,- Ừ, đi với bố nào con gái.\N- Hoan hô!
Dialogue: 0,0:15:16.66,0:15:18.62,Default,,0,0,0,,Mình đi thôi con.
Dialogue: 0,0:15:19.88,0:15:21.82,Default,,0,0,0,,- Ngoài đường tuyết vẫn còn đọng dày lắm đấy.\N- Dạ vâng.
Dialogue: 0,0:15:22.89,0:15:24.70,Default,,0,0,0,,Có khi đêm nay trời lại đổ thêm tuyết nữa cũng nên.
Dialogue: 0,0:15:24.70,0:15:26.65,Default,,0,0,0,,Asuka ngoan.
Dialogue: 0,0:15:43.32,0:15:45.36,Default,,0,0,0,,Bố con em đi đây nhé mẹ nó.
Dialogue: 0,0:15:45.37,0:15:47.32,Default,,0,0,0,,Hai bố con đi cẩn thận kẻo trượt ngã nhé.
Dialogue: 0,0:15:47.42,0:15:49.43,Default,,0,0,0,,- Bố con em về ngay thôi mà.\N- Về sớm nhé hai bố con.
Dialogue: 0,0:15:50.55,0:15:53.21,Default,,0,0,0,,Ôi, con nhìn thấy bông hoa tuyết kết tinh này bố ơi.
Dialogue: 0,0:15:53.21,0:15:57.19,Default,,0,0,0,,- Sao con nhìn thấy hay thế?\N- Cô giáo Tachibana cho tụi con xem ở lớp đấy ạ.
Dialogue: 0,0:15:57.19,0:15:58.64,Default,,0,0,0,,- Xem qua kính hiển vi đúng không con?\N- Dạ đúng rồi ạ.
Dialogue: 0,0:16:18.98,0:16:21.32,Default,,0,0,0,,Xem ra món này gói cũng không đơn giản chút nào nhỉ.
Dialogue: 0,0:16:25.64,0:16:30.18,Default,,0,0,0,,Mấy cái há cảo tôi vừa gói... nom xấu xí\Nchẳng khác nào cái bánh sừng bò của bé Asuka cả.
Dialogue: 0,0:16:32.24,0:16:34.99,Default,,0,0,0,,Hồi mới đầu em cũng vụng về chẳng biết gói gyoza đâu chú.
Dialogue: 0,0:16:35.76,0:16:37.78,Default,,0,0,0,,Nhà em ngày nào cũng cằn nhằn mắng em suốt thôi...
Dialogue: 0,0:16:39.33,0:16:41.96,Default,,0,0,0,,Cậu ấy làm vậy là muốn cho cô hiểu...
Dialogue: 0,0:16:42.24,0:16:44.32,Default,,0,0,0,,...rằng đó chính là tất cả niềm đam mê tâm huyết của cả đời cậu ấy đấy.
Dialogue: 0,0:16:50.26,0:16:52.28,Default,,0,0,0,,Em biết chứ.
Dialogue: 0,0:16:54.76,0:16:56.65,Default,,0,0,0,,Ông chủ này.
Dialogue: 0,0:16:57.21,0:16:59.89,Default,,0,0,0,,Có phải chú cũng muốn khuyên em\Nrằng em nên tiếp tục sống vui vẻ hạnh phúc bên gia đình mình không?
Dialogue: 0,0:17:05.26,0:17:07.22,Default,,0,0,0,,Thế nhưng người ta đâu thể nào quay ngược trở lại quá khứ được nữa chứ!
Dialogue: 0,0:17:08.75,0:17:10.78,Default,,0,0,0,,Cô định đi thật đấy à?
Dialogue: 0,0:17:17.89,0:17:21.00,Default,,0,0,0,,Cuộc đời của cô... đâu phải chỉ thuộc về một mình cô nữa đâu.
Dialogue: 0,0:17:24.79,0:17:28.44,Default,,0,0,0,,Cuộc đời của em...\Nlà thuộc về chính em.
Dialogue: 0,0:18:10.07,0:18:12.26,Default,,0,0,0,,Mẹ ơi.
Dialogue: 0,0:18:15.21,0:18:17.61,Default,,0,0,0,,Mẹ ơi, chúc mừng sinh nhật mẹ nhé!
Dialogue: 0,0:18:19.22,0:18:22.68,Default,,0,0,0,,- Sao hai bố con lại có cái này thế?\N- Bí mật của hai bố con con đấy mẹ ơi.
Dialogue: 0,0:18:22.68,0:18:24.69,Default,,0,0,0,,Hai bố con đã lén đặt bánh kem sinh nhật cho mẹ\Nvà vừa chạy qua tiệm lấy về đấy ạ.
Dialogue: 0,0:18:26.11,0:18:30.66,Default,,0,0,0,,- Bố con em muốn dành cho em một bất ngờ mà.\N- A, để con mang vào khoe với ông chủ nhé.
Dialogue: 0,0:18:37.71,0:18:39.53,Default,,0,0,0,,Em...
Dialogue: 0,0:19:13.87,0:19:16.18,Default,,0,0,0,,Đứng ngoài này lạnh lắm, em coi chừng bị cảm đấy.
Dialogue: 0,0:19:26.88,0:19:30.18,Default,,0,0,0,,Mẹ ơi, mình mau vào nướng há cảo thôi mẹ.
Dialogue: 0,0:19:33.84,0:19:35.90,Default,,0,0,0,,Được rồi, mẹ con mình vào thôi.
Dialogue: 0,0:19:48.35,0:19:53.12,Default,,0,0,0,,{\i1}Sau đêm hôm ấy, người đàn ông đó không còn xuất hiện ở quán của tôi thêm một lần nào nữa.{\i0}
Dialogue: 0,0:20:01.92,0:20:04.80,Default,,0,0,0,,- Của cả nhà đây nhé.\N- Trông ngon mắt quá đi mất!
Dialogue: 0,0:20:08.05,0:20:10.06,Default,,0,0,0,,Xin mời cả nhà cùng thưởng thức bữa ăn ạ.
Dialogue: 0,0:20:20.41,0:20:22.46,Default,,0,0,0,,- Ngon tuyệt cú mèo!\N- Ngon xuất sắc luôn.
Dialogue: 0,0:20:24.37,0:20:29.23,Default,,0,0,0,,~ Watashi no umareta kono machi wa ~\N*Thành phố nơi tôi cất tiếng khóc chào đời*
Dialogue: 0,0:20:30.14,0:20:35.43,Default,,0,0,0,,~ Taitei konkuriito de dekite ite ~\N*Khắp bốn bề phủ kín bởi những khối bê tông xám xịt*
Dialogue: 0,0:20:35.91,0:20:41.58,Default,,0,0,0,,~ Tonari no kojo kara wa kikai no oto ga kikoeru ~\N*Vang vọng bên tai là tiếng máy móc ầm ầm từ xưởng cơ khí kề bên*
Dialogue: 0,0:20:41.58,0:20:46.13,Default,,0,0,0,,Khi một ngày khép lại, người ta lại vội vã trở về nhà...\N~ Tonari no kojo kara wa kikai no oto ga kikoeru ~\N*Vang vọng bên tai là tiếng máy móc ầm ầm từ xưởng cơ khí kề bên*
Dialogue: 0,0:20:47.61,0:20:48.03,Default,,0,0,0,,~ Watashi to ittara mukiryoku de ~\N*Còn bản thân tôi thì cứ mãi vô hồn, kiệt quệ*
Dialogue: 0,0:20:48.03,0:20:50.68,Default,,0,0,0,,Thế nhưng nếu bạn cũng cảm thấy trong lòng còn điều gì dang dở...\N~ Watashi to ittara mukiryoku de ~\N*Còn bản thân tôi thì cứ mãi vô hồn, kiệt quệ*
Dialogue: 0,0:20:50.68,0:20:52.16,Default,,0,0,0,,~ Watashi to ittara mukiryoku de ~\N*Còn bản thân tôi thì cứ mãi vô hồn, kiệt quệ*
Dialogue: 0,0:20:52.16,0:20:53.14,Default,,0,0,0,,Vào những đêm như thế, bạn sẽ muốn rẽ vào một lối khác.\N~ Watashi to ittara mukiryoku de ~\N*Còn bản thân tôi thì cứ mãi vô hồn, kiệt quệ*
Dialogue: 0,0:20:53.14,0:20:54.77,Default,,0,0,0,,Vào những đêm như thế, bạn sẽ muốn rẽ vào một lối khác.\N~ Sora bakkari nagamete ita ~\N*Chỉ biết ngước mắt lặng nhìn lên bầu trời cao*
Dialogue: 0,0:20:54.77,0:20:58.33,Default,,0,0,0,,~ Sora bakkari nagamete ita ~\N*Chỉ biết ngước mắt lặng nhìn lên bầu trời cao*
Dialogue: 0,0:20:58.78,0:21:04.34,Default,,0,0,0,,~ Tori no uta mo kikoenai foroo o ~\N*Nơi chẳng còn nghe thấy tiếng chim muông ríu rít ca vang*
Dialogue: 0,0:21:04.55,0:21:08.57,Default,,0,0,0,,~ Kikai wa utatte ita ~\N*Chỉ có những cỗ máy vô tri vẫn ngày đêm cất lên khúc hát*
Dialogue: 0,0:21:12.10,0:21:20.45,Default,,0,0,0,,~ Son'na machi ga watashi no furusato ~\N*Khu phố như thế chính là quê hương dấu yêu của tôi*
Dialogue: 0,0:21:23.58,0:21:31.89,Default,,0,0,0,,~ Subete no dekigoto wa itoshii omoide ~\N*Tất cả những gì đã qua đều là những kỷ niệm thân thương khắc sâu*
Dialogue: 0,0:21:35.00,0:21:43.09,Default,,0,0,0,,~ Son'na machi ga watashi no furusato ~\N*Khu phố như thế chính là quê hương dấu yêu của tôi*
Dialogue: 0,0:21:46.50,0:21:55.37,Default,,0,0,0,,~ Kikai no oto wa natsukashii komoriuta ~\N*Tiếng máy móc rền vang tựa khúc hát ru ngọt ngào thuở ấu thơ*
Dialogue: 0,0:21:59.80,0:22:01.95,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:22:03.44,0:22:06.68,Default,,0,0,0,,Chỉ cần có sẵn nguyên liệu, quý khách muốn ăn món gì tôi đều sẽ làm.
Dialogue: 0,0:22:08.65,0:22:12.70,Default,,0,0,0,,= QUÁN ĂN ĐÊM (Mùa 2) =\N- Hết Mùa 2 -
Dialogue: 0,0:22:12.85,0:22:19.45,Default,,0,0,0,,~ Yarusenai yuhi yori ~\N*Hơn cả ánh hoàng hôn buồn bã hiu hắt*
Dialogue: 0,0:22:13.95,0:22:16.45,Default,,0,0,0,,{\i1}"Ông chủ"\NKOBAYASHI Kaoru{\i0}
Dialogue: 0,0:22:16.55,0:22:19.40,Default,,0,0,0,,{\i1}      "Murata"                                 "Momoko"\NLILY Franky                      KUROTANI Tomoka{\i0}
Dialogue: 0,0:22:19.65,0:22:26.47,Default,,0,0,0,,~ Shinji reru asahi o mitai ~\N*Em khát khao nhìn thấy ánh bình minh để vững tin*
Dialogue: 0,0:22:20.40,0:22:23.40,Default,,0,0,0,,{\i1}      "Saya"                                   "Kanemoto"\NHIRATA Kaoru                     KANEKO Kiyobumi{\i0}
Dialogue: 0,0:22:23.90,0:22:26.40,Default,,0,0,0,,{\i1}      "Rumi"                                     "Kana"\NKOBAYASHI Asako               YOSHIMOTO Naoko{\i0}
Dialogue: 0,0:22:26.79,0:22:33.86,Default,,0,0,0,,~ Dakara sukoshi yume o mi sasete ~\N*Vì vậy, xin hãy cho em được mơ một giấc mơ nho nhỏ*
Dialogue: 0,0:22:26.81,0:22:29.41,Default,,0,0,0,,{\i1}      "Goro"                                    "Bác Chu"\NMATSUO Satoru                     FUWA Mansaku{\i0}
Dialogue: 0,0:22:29.91,0:22:31.90,Default,,0,0,0,,{\i1}     "Komichi"                                 "Marilyn"\NUNO Shohei                         ANDO Tamae{\i0}
Dialogue: 0,0:22:32.00,0:22:33.80,Default,,0,0,0,,{\i1}     "Kosuzu"                                   "Hana"\NAYATA Toshiki                     ASAKURA Aki{\i0}
Dialogue: 0,0:22:33.86,0:22:38.81,Default,,0,0,0,,~ Ashita e mukau tame ~\N*Để em có thể bước tiếp tới ngày mai*
Dialogue: 0,0:22:33.90,0:22:36.90,Default,,0,0,0,,{\i1}     "Tsukiko"                                  "Take"\NICHIKAWA Miwako                 HOTARU Yukijiro{\i0}
Dialogue: 0,0:22:37.00,0:22:38.80,Default,,0,0,0,,{\i1}       "Ryu"                                     "Gen"\NMATSUSHIGE Yutaka               YAMANAKA Takashi{\i0}
Dialogue: 0,0:22:38.81,0:22:45.36,Default,,0,0,0,,~ Waraetara waraetara ~\N*Nếu chúng ta có thể cất tiếng cười*
Dialogue: 0,0:22:39.90,0:22:43.90,Default,,0,0,0,,{\i1}            "Katagiri"\Nvà ODAGIRI Joe{\i0}
Dialogue: 0,0:22:45.36,0:22:52.20,Default,,0,0,0,,~ Bokura warai aeru nara ~\N*Nếu chúng ta có thể mỉm cười cùng nhau*
Dialogue: 0,0:22:45.59,0:22:47.59,Default,,0,0,0,,{\i1}Âm nhạc: SATOU Kimihiko{\i0}
Dialogue: 0,0:22:48.90,0:22:50.90,Default,,0,0,0,,{\i1}Ca khúc mở đầu: "Omoide" do SUZUKI Tsunekichi trình bày{\i0}
Dialogue: 0,0:22:52.25,0:22:59.52,Default,,0,0,0,,~ Tsumetai te o nigirishimete ~\N*Em sẽ siết chặt lấy bàn tay lạnh giá của người*
Dialogue: 0,0:22:52.40,0:22:55.40,Default,,0,0,0,,{\i1}Ca khúc chủ đề: "Uso no Tsuki Kata"\Ndo LOVE LOVE LOVE trình bày{\i0}
Dialogue: 0,0:22:56.40,0:22:59.50,Default,,0,0,0,,{\i1}Ca khúc lồng ghép: "Haneda" do FUKUHARA Kimie trình bày{\i0}
Dialogue: 0,0:22:59.55,0:23:06.80,Default,,0,0,0,,~ Sotto uso tsuku yo ~\N*Và khẽ buông một lời dối gian*
