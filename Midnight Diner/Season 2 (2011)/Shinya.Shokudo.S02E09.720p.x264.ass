Dialogue: 0,0:00:05.06,0:00:09.56,Default,,0,0,0,,Biên dịch và căn chỉnh thời gian:\NAmtia(NOFACE)
Dialogue: 0,0:00:09.56,0:00:13.56,Default,,0,0,0,,Cảm ơn bản raw và phụ đề gốc:\Nyyets.com và \( -o _ o- )/
Dialogue: 0,0:00:26.16,0:00:31.53,Default,,0,0,0,,~ Kimi ga haita shiroi iki ga ~\N*Làn khói trắng em khẽ thở ra*
Dialogue: 0,0:00:31.53,0:00:35.39,Default,,0,0,0,,~ Ima yukkuri kaze ni notte ~\N*Giờ chầm chậm nương theo làn gió*
Dialogue: 0,0:00:36.27,0:00:41.39,Default,,0,0,0,,~ Sora ni ukabu kumo no naka ni ~\N*Hòa vào những đám mây trôi trên bầu trời*
Dialogue: 0,0:00:41.39,0:00:46.38,Default,,0,0,0,,~ Sukoshi zutsu kiete yuku ~\N*Rồi cứ thế tan biến dần đi*
Dialogue: 0,0:00:46.59,0:00:51.68,Default,,0,0,0,,~ Toku takai sora no naka de ~\N*Giữa bầu trời cao vời vợi xa xăm*
Dialogue: 0,0:00:51.68,0:00:56.11,Default,,0,0,0,,~ Te o nobasu shiroi kumo ~\N*Đám mây trắng vươn bàn tay xuống*
Dialogue: 0,0:00:56.58,0:00:58.07,Default,,0,0,0,,~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:58.07,0:00:59.36,Default,,0,0,0,,Khi một ngày khép lại...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:59.36,0:01:01.84,Default,,0,0,0,,Khi người ta vội vã trở về nhà...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:01:01.84,0:01:02.50,Default,,0,0,0,,Khi người ta vội vã trở về nhà...\N~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:02.50,0:01:03.67,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:03.67,0:01:05.52,Default,,0,0,0,,Thì ngày mới của tôi mới bắt đầu.\N~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:05.52,0:01:05.74,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:07.64,0:01:16.93,Default,,0,0,0,,~ Zutto mukashi no koto no yoda ne ~\N*Ngỡ như chuyện của thuở xa xưa lắm rồi*
Dialogue: 0,0:01:17.66,0:01:26.35,Default,,0,0,0,,~ Kawamo no ue o kumo ga nagareru ~\N*Mây lững lờ trôi trên mặt sông êm đềm*
Dialogue: 0,0:01:29.66,0:01:33.61,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm đến bảy giờ sáng.
Dialogue: 0,0:01:35.00,0:01:38.48,Default,,0,0,0,,Người ta thường gọi nó là 'Quán Ăn Đêm'.
Dialogue: 0,0:01:41.15,0:01:42.75,Default,,0,0,0,,Thực đơn của tôi chỉ có vỏn vẹn bấy nhiêu đây.*\N(*súp miso thịt heo, bia, rượu sake, shochu)
Dialogue: 0,0:01:43.25,0:01:45.62,Default,,0,0,0,,Nhưng hễ khách muốn gọi món gì khác...
Dialogue: 0,0:01:46.37,0:01:48.28,Default,,0,0,0,,...tôi đều sẽ đáp: "Chỉ cần làm được là tôi sẽ nấu ngay."
Dialogue: 0,0:01:48.89,0:01:50.92,Default,,0,0,0,,Phương châm buôn bán của tôi là vậy.
Dialogue: 0,0:01:54.99,0:01:56.29,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư...
Dialogue: 0,0:01:57.30,0:01:59.19,Default,,0,0,0,,...Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:02:02.60,0:02:09.39,Default,,0,0,0,,~ SHINYA SHOKUDO (Phần 2) ~\N"Quán Ăn Đêm"
Dialogue: 0,0:02:12.50,0:02:17.59,Default,,0,0,0,,Câu chuyện thứ 19 (Tập 9):\N"Nikujaga (Thịt hầm khoai tây)"
Dialogue: 0,0:02:21.74,0:02:23.69,Default,,0,0,0,,{\i1}Thi thoảng, chính tôi cũng muốn ăn món này.{\i0}
Dialogue: 0,0:02:24.45,0:02:29.69,Default,,0,0,0,,{\i1}Thế nên mỗi lần nấu là tôi lại làm hẳn một nồi thật đầy.{\i0}
Dialogue: 0,0:02:34.20,0:02:36.15,Default,,0,0,0,,- Vị thế nào?\N- Ngon lắm Ông chủ ạ.
Dialogue: 0,0:02:37.01,0:02:38.98,Default,,0,0,0,,Đúng chuẩn 'hương vị cơm mẹ nấu' luôn.
Dialogue: 0,0:02:39.01,0:02:41.79,Default,,0,0,0,,Có điều mẹ cháu ở nhà nấu vị hơi ngọt hơn một chút.
Dialogue: 0,0:02:43.37,0:02:45.00,Default,,0,0,0,,- Chào buổi tối.\N- Mời vào.
Dialogue: 0,0:02:45.00,0:02:46.85,Default,,0,0,0,,Ồ, hai người đến đúng lúc lắm!
Dialogue: 0,0:02:47.60,0:02:50.24,Default,,0,0,0,,- Anh chị có muốn ăn món "nikujaga" (thịt hầm khoai tây) không?\N- Thế thì còn gì bằng.
Dialogue: 0,0:02:51.34,0:02:53.98,Default,,0,0,0,,Em có muốn ăn chút không, Chiaki?
Dialogue: 0,0:02:55.02,0:02:57.69,Default,,0,0,0,,Em tùy anh quyết định cả đấy, anh Kanemoto.
Dialogue: 0,0:02:58.68,0:03:01.08,Default,,0,0,0,,Ý của cô ấy, tức là ý của Chiaki đây...
Dialogue: 0,0:03:01.63,0:03:03.59,Default,,0,0,0,,...bảo tôi là một người đàn ông chu đáo đấy mà.
Dialogue: 0,0:03:11.24,0:03:13.73,Default,,0,0,0,,- Ngon thật đấy.\N- Thật hả anh?
Dialogue: 0,0:03:18.85,0:03:21.77,Default,,0,0,0,,- Sao thế em?\N- Món này nấu bằng thịt bò, phải không ạ?
Dialogue: 0,0:03:23.47,0:03:27.03,Default,,0,0,0,,Ở quê tôi người ta toàn nấu bằng thịt bò...\NBộ cô không hợp khẩu vị sao?
Dialogue: 0,0:03:29.96,0:03:31.98,Default,,0,0,0,,Thực ra nói ra thì hơi xấu hổ ạ.
Dialogue: 0,0:03:31.98,0:03:34.65,Default,,0,0,0,,Ở quê em ngày xưa, gia đình nghèo chẳng đủ tiền mua thịt bò.
Dialogue: 0,0:03:34.65,0:03:37.08,Default,,0,0,0,,Nên nhà em toàn phải dùng thịt heo để nấu thay thế.
Dialogue: 0,0:03:37.08,0:03:40.30,Default,,0,0,0,,Ngay cả món lẩu sukiyaki, trong ký ức của em cũng toàn là nấu bằng thịt heo.
Dialogue: 0,0:03:41.48,0:03:43.60,Default,,0,0,0,,Mỗi cây mỗi hoa, mỗi nhà mỗi cảnh mà.
Dialogue: 0,0:03:43.76,0:03:45.92,Default,,0,0,0,,...Đúng không, Ông chủ?\N- Ừ.
Dialogue: 0,0:03:46.85,0:03:50.25,Default,,0,0,0,,Từ nay về sau, em muốn ăn bao nhiêu thịt bò cũng được hết.
Dialogue: 0,0:03:51.41,0:03:55.33,Default,,0,0,0,,Em hạnh phúc quá...\NVậy lần tới, để em tự tay nấu món thịt hầm khoai tây cho anh ăn nhé.
Dialogue: 0,0:03:56.62,0:03:58.97,Default,,0,0,0,,Nhưng nếu nấu bằng thịt bò thì không biết em có\Nnêm nếm được ngon miệng không nữa.
Dialogue: 0,0:03:59.25,0:04:03.16,Default,,0,0,0,,Không sao đâu, em đừng bận tâm.\NChỉ cần được ngắm nhìn gương mặt em thế này thôi...
Dialogue: 0,0:04:03.29,0:04:05.29,Default,,0,0,0,,...là lòng anh đã thấy no ấm lắm rồi.
Dialogue: 0,0:04:06.96,0:04:09.47,Default,,0,0,0,,Anh Kanemoto à.
Dialogue: 0,0:04:10.04,0:04:11.94,Default,,0,0,0,,Bé Chiaki của anh.
Dialogue: 0,0:04:20.85,0:04:22.79,Default,,0,0,0,,Cuộc đời đúng là chẳng biết đâu mà lần, nhỉ?
Dialogue: 0,0:04:22.79,0:04:24.60,Default,,0,0,0,,Chẳng phải ông anh đó từng tan vỡ gia đình một lần rồi sao?
Dialogue: 0,0:04:25.76,0:04:27.62,Default,,0,0,0,,Thế mới thấy, con người ta chỉ cần còn sống,\Nlà chuyện tốt đẹp rồi sẽ lại mỉm cười.
Dialogue: 0,0:04:27.99,0:04:29.75,Default,,0,0,0,,Giờ thì tôi thực sự tin vào câu nói đó rồi đấy.
Dialogue: 0,0:04:30.75,0:04:32.56,Default,,0,0,0,,Nhưng mà nghĩ cũng lạ, một người phụ nữ xinh đẹp như cô nàng đó...
Dialogue: 0,0:04:32.56,0:04:35.21,Default,,0,0,0,,...sao lại chịu lấy một gã đàn ông\Nnhạt nhẽo từng qua một đời vợ như anh ta nhỉ?
Dialogue: 0,0:04:35.78,0:04:38.49,Default,,0,0,0,,Ngoài kia thiếu gì những người đàn ông sáng giá hơn gấp bội\Nđể cô ta tha hồ lựa chọn cơ chứ.
Dialogue: 0,0:04:38.71,0:04:41.27,Default,,0,0,0,,Liệu có khi nào cô ta đang lừa ông ấy không?\NChắc không phải loại phụ nữ đào mỏ đâu nhỉ?
Dialogue: 0,0:04:42.05,0:04:45.27,Default,,0,0,0,,Chính vì cả hai người đều đã\Nnếm trải đủ mọi cay đắng của cuộc đời...
Dialogue: 0,0:04:45.40,0:04:46.62,Default,,0,0,0,,...nên lòng dạ mới đâm ra đa nghi, hẹp hòi như thế đấy.
Dialogue: 0,0:04:46.62,0:04:50.12,Default,,0,0,0,,- Hãy tập mở rộng lòng mình ra mà đón nhận đi.\N- Tôi đâu có lo lắng chuyện đó.
Dialogue: 0,0:04:50.12,0:04:52.79,Default,,0,0,0,,Chà, quả thực một người phụ nữ hiền thục nết na\Nnhư cô ấy mà lấy anh ta thì đúng là hơi phí thật.
Dialogue: 0,0:04:53.27,0:04:56.13,Default,,0,0,0,,Cô ấy còn dịu dàng bảo: "Để em nấu món thịt hầm khoai tây cho anh ăn nhé."
Dialogue: 0,0:04:56.73,0:04:59.11,Default,,0,0,0,,Thì tôi đây... món đó tôi cũng tự nấu ngon lành được chứ bộ.
Dialogue: 0,0:04:59.61,0:05:03.03,Default,,0,0,0,,Ý mấy người là nếu phụ nữ không biết nấu nướng\Ncho đàn ông ăn thì không được coi là phụ nữ tốt chứ gì?
Dialogue: 0,0:05:03.06,0:05:06.40,Default,,0,0,0,,Rồi mấy người định bảo phụ nữ mà tự nấu thịt hầm khoai tây\Năn một mình ở nhà tức là hạng gái ế cô đơn chứ gì?
Dialogue: 0,0:05:06.59,0:05:10.10,Default,,0,0,0,,Ơ kìa, có ai nói thế đâu... Đúng không?
Dialogue: 0,0:05:13.27,0:05:14.97,Default,,0,0,0,,Xin chúc mừng sinh nhật!
Dialogue: 0,0:05:15.46,0:05:21.98,Default,,0,0,0,,~ Chúc mừng sinh nhật anh! ~
Dialogue: 0,0:05:21.98,0:05:26.23,Default,,0,0,0,,~ Chúc mừng sinh nhật anh Chou thân mến ~
Dialogue: 0,0:05:26.23,0:05:28.70,Default,,0,0,0,,Ờm, tôi đâu phải là Chou.
Dialogue: 0,0:05:28.70,0:05:31.01,Default,,0,0,0,,Tôi là Chu cơ mà.
Dialogue: 0,0:05:31.01,0:05:32.83,Default,,0,0,0,,Bác Chu ạ.
Dialogue: 0,0:05:33.67,0:05:35.88,Default,,0,0,0,,"Chúc mừng sinh nhật..."
Dialogue: 0,0:05:36.25,0:05:40.05,Default,,0,0,0,,"...Gửi trọn tình yêu của em đến anh Chou."\N("Chúc anh sớm chiến thắng căn bệnh phì đại tuyến tiền liệt nhé!")
Dialogue: 0,0:05:41.04,0:05:43.27,Default,,0,0,0,,Ôi, cháu xin lỗi ạ.
Dialogue: 0,0:05:45.79,0:05:47.88,Default,,0,0,0,,Đưa đây tôi xem thử nào?
Dialogue: 0,0:05:50.16,0:05:54.51,Default,,0,0,0,,À, đơn này là giao cho cái quán rượu\Nngay bên kia đường cơ mà.
Dialogue: 0,0:05:55.15,0:05:58.78,Default,,0,0,0,,Cháu cảm ơn chú nhiều lắm ạ.\NXin lỗi vì đã làm phiền mọi người.
Dialogue: 0,0:05:58.78,0:06:00.75,Default,,0,0,0,,Cháu xin phép đi trước ạ.
Dialogue: 0,0:06:06.95,0:06:09.03,Default,,0,0,0,,Cái quái gì vừa diễn ra thế nhỉ?
Dialogue: 0,0:06:09.79,0:06:12.25,Default,,0,0,0,,Mà công nhận... cô bé đó dễ thương thật đấy nhỉ?
Dialogue: 0,0:06:12.77,0:06:14.78,Default,,0,0,0,,Đừng có buông mấy lời thừa thãi đó nữa coi.
Dialogue: 0,0:06:14.78,0:06:17.00,Default,,0,0,0,,Quả nhiên, suy cho cùng,\Nđàn ông các người ai cũng chỉ thích mỗi thế thôi.
Dialogue: 0,0:06:17.69,0:06:20.95,Default,,0,0,0,,Vâng, xin thứ lỗi nếu chị em chúng tôi vừa chẳng còn\Ntrẻ trung lại vừa chẳng đủ dễ thương trong mắt các người.
Dialogue: 0,0:06:22.79,0:06:26.26,Default,,0,0,0,,Ông chủ, cô ấy gọi thêm món gì ông cứ làm nhé...\N...Hôm nay để tôi khao.
Dialogue: 0,0:06:27.07,0:06:29.34,Default,,0,0,0,,- Được thôi, vậy cho tôi một bát cơm trà chan mận muối nhé.\N- Có ngay.
Dialogue: 0,0:06:30.53,0:06:32.85,Default,,0,0,0,,Chà, xem chừng cậu cũng bắt đầu nắm bắt được tâm lý rồi đấy nhỉ?
Dialogue: 0,0:06:32.85,0:06:34.58,Default,,0,0,0,,Cách chiều lòng phụ nữ ấy mà.
Dialogue: 0,0:06:40.67,0:06:42.70,Default,,0,0,0,,{\i1}Cô bé giao bánh sinh nhật hôm ấy...{\i0}
Dialogue: 0,0:06:43.42,0:06:45.67,Default,,0,0,0,,{\i1}...sau đó còn ghé nhầm vào quán thêm hai, ba bận nữa.{\i0}
Dialogue: 0,0:06:47.10,0:06:48.81,Default,,0,0,0,,{\i1}Rồi một hôm nọ...{\i0}
Dialogue: 0,0:06:48.81,0:06:51.04,Default,,0,0,0,,{\i1}...cô bé được đặt giao một chiếc bánh kem\Nmà xem chừng chẳng giống bánh mừng sinh nhật chút nào.{\i0}
Dialogue: 0,0:06:53.19,0:06:57.99,Default,,0,0,0,,Trông cứ như cảnh bước ra từ mấy bộ phim xã hội đen yakuza ấy nhỉ?
Dialogue: 0,0:06:58.60,0:07:03.00,Default,,0,0,0,,Làm lễ của dân anh chị mà lại ăn mừng bằng bánh kem ư?\NXem ra thời đại Chiêu Hòa đã lùi xa thật rồi.
Dialogue: 0,0:07:03.63,0:07:06.46,Default,,0,0,0,,"Chúc mừng Lễ 'Long Danh' Đời thứ 3,\NGiám đốc Công ty Giải trí Niwatori!*"\N(*tên bình phong của một băng đảng yakuza)
Dialogue: 0,0:07:06.46,0:07:08.48,Default,,0,0,0,,Mà chữ Hán viết trên bánh trông cứ sai sai thế nào ấy nhỉ?
Dialogue: 0,0:07:11.05,0:07:15.39,Default,,0,0,0,,Đáng lẽ đâu phải là "Đời thứ 3 'Long Danh' (Ryuumei)"...\NPhải viết là "Đời thứ 3 Tập Danh (Shuumei)*" mới đúng chứ!\N(*lễ kế vị chức danh đại ca đời tiếp theo)
Dialogue: 0,0:07:15.39,0:07:18.39,Default,,0,0,0,,Đúng rồi! Chữ 'Long' (Rồng) bị viết thiếu mất bộ 'Y' ở dưới rồi.\N[Chữ 'Long' (Rồng) + bộ 'Y' (Áo) = chữ 'Tập' (Kế vị)]
Dialogue: 0,0:07:18.39,0:07:20.52,Default,,0,0,0,,Thôi chết, giờ cháu phải làm sao đây ạ?
Dialogue: 0,0:08:18.07,0:08:20.00,Default,,0,0,0,,Tuyệt cú mèo~!
Dialogue: 0,0:08:29.53,0:08:32.29,Default,,0,0,0,,"Đừng ngăn cản con nữa, mẹ ơi..."
Dialogue: 0,0:08:32.29,0:08:36.42,Default,,0,0,0,,"Con rồng (ryuu)* xăm trên lưng con, vẫn còn thiếu một nét chấm phá."\N(*hình xăm rồng của giới yakuza)
Dialogue: 0,0:08:36.93,0:08:38.94,Default,,0,0,0,,Đừng có bước đi vấp váp giữa đường đời thế chứ.
Dialogue: 0,0:09:06.01,0:09:07.84,Default,,0,0,0,,- Chào buổi tối.\N- Mời vào.
Dialogue: 0,0:09:08.67,0:09:13.07,Default,,0,0,0,,Hôm nay cô không đi giao nhầm bánh\Nở đâu nữa đấy chứ?
Dialogue: 0,0:09:13.86,0:09:17.22,Default,,0,0,0,,Hôm nay cháu hết ca làm rồi ạ.\NCháu chỉ định ghé qua cảm ơn vị khách lần trước đã cứu nguy cho cháu thôi.
Dialogue: 0,0:09:19.12,0:09:21.14,Default,,0,0,0,,Hôm nay anh ấy lại không ghé quán rồi.
Dialogue: 0,0:09:21.65,0:09:23.94,Default,,0,0,0,,Vậy ạ.
Dialogue: 0,0:09:24.02,0:09:25.83,Default,,0,0,0,,Mà đằng nào bụng cháu cũng đang đói meo.
Dialogue: 0,0:09:25.83,0:09:29.24,Default,,0,0,0,,Cô muốn ăn món gì nào?\NChỉ cần làm được là tôi sẽ nấu cho cô ngay.
Dialogue: 0,0:09:30.65,0:09:33.52,Default,,0,0,0,,Dạ, vậy chú làm cho cháu món thịt hầm khoai tây được không ạ?
Dialogue: 0,0:09:33.95,0:09:35.89,Default,,0,0,0,,- Cô chịu khó đợi một lát nhé?\N- Dạ không sao đâu ạ.
Dialogue: 0,0:09:36.56,0:09:38.54,Default,,0,0,0,,Sẽ có ngay đây.
Dialogue: 0,0:09:45.75,0:09:47.79,Default,,0,0,0,,Ngon quá đi mất.
Dialogue: 0,0:09:48.64,0:09:52.89,Default,,0,0,0,,Giá mà có thời gian ninh thêm một lúc nữa,\Nthì gia vị sẽ còn ngấm đậm đà hơn nhiều.
Dialogue: 0,0:09:53.10,0:09:55.10,Default,,0,0,0,,Dạ không, thế này là vừa vặn... và ngon lắm rồi ạ.
Dialogue: 0,0:09:56.71,0:09:59.55,Default,,0,0,0,,Ở nhà cháu, mẹ cháu toàn nấu món thịt hầm khoai tây bằng thịt heo thôi.
Dialogue: 0,0:09:59.87,0:10:01.53,Default,,0,0,0,,Tại gia đình cháu vốn nghèo khó mà.
Dialogue: 0,0:10:02.89,0:10:06.05,Default,,0,0,0,,Hôm trước cũng có một nữ thực khách ghé quán nói y hệt như cô vậy...
Dialogue: 0,0:10:07.48,0:10:10.17,Default,,0,0,0,,Cô ấy bảo ở nhà cô ấy ngay cả món lẩu sukiyaki cũng nấu bằng thịt heo.
Dialogue: 0,0:10:10.70,0:10:13.57,Default,,0,0,0,,Nhà cháu cũng thế đấy ạ...\NGiá mà cháu được trò chuyện với vị khách đó nhỉ.
Dialogue: 0,0:10:17.87,0:10:21.13,Default,,0,0,0,,Cháu là con út trong một gia đình có sáu anh chị em.
Dialogue: 0,0:10:22.11,0:10:24.09,Default,,0,0,0,,Trước khi khăn gói lên Tokyo học đại học...
Dialogue: 0,0:10:24.32,0:10:26.64,Default,,0,0,0,,...chị em tụi cháu lớn lên ở một vùng quê hẻo lánh thuộc Hokkaido.
Dialogue: 0,0:10:28.44,0:10:31.17,Default,,0,0,0,,Gia đình cô đông anh chị em thật đấy nhỉ?
Dialogue: 0,0:10:32.17,0:10:33.63,Default,,0,0,0,,Anh chị em trong nhà cháu thương yêu đùm bọc nhau lắm ạ.
Dialogue: 0,0:10:35.05,0:10:38.66,Default,,0,0,0,,Chị gái cháu làm chuyên viên tư vấn\Ncho một tập đoàn mỹ phẩm lớn.
Dialogue: 0,0:10:39.35,0:10:41.86,Default,,0,0,0,,Chị ấy thường xuyên phải đi công tác\Ngiao dịch khắp mọi miền đất nước.
Dialogue: 0,0:10:42.92,0:10:46.59,Default,,0,0,0,,Thế nhưng khoảng sáu tháng trước,\Ncháu bỗng dưng mất hẳn liên lạc với chị ấy.
Dialogue: 0,0:10:49.87,0:10:51.92,Default,,0,0,0,,Tiền chị ấy gửi về phụ giúp gia đình cũng ngưng bặt từ đó.
Dialogue: 0,0:10:52.80,0:10:54.53,Default,,0,0,0,,Trong lá thư cuối cùng chị ấy gửi về cho gia đình...
Dialogue: 0,0:10:55.07,0:10:57.53,Default,,0,0,0,,Chị ấy có nhắc đến chuyện đang làm việc ở khu Shinjuku này.
Dialogue: 0,0:10:58.84,0:11:00.61,Default,,0,0,0,,Cháu nghĩ biết đâu mình có thể tìm thấy chị gái ở quanh đây.
Dialogue: 0,0:11:01.18,0:11:03.48,Default,,0,0,0,,Đó là lý do cháu xin vào làm thêm\Ncông việc giao bánh kem ban đêm này đấy ạ.
Dialogue: 0,0:11:06.88,0:11:09.39,Default,,0,0,0,,Hồi mới đi làm, cháu cứ thấy kỳ lạ làm sao ấy.
Dialogue: 0,0:11:10.41,0:11:12.27,Default,,0,0,0,,Chuyện gì cơ?
Dialogue: 0,0:11:12.54,0:11:14.98,Default,,0,0,0,,Chuyện có quá nhiều cô tiếp viên quán rượu có cùng ngày sinh nhật ấy ạ?
Dialogue: 0,0:11:15.40,0:11:17.38,Default,,0,0,0,,Nhiều không đếm xuể luôn.
Dialogue: 0,0:11:20.14,0:11:23.88,Default,,0,0,0,,Cả mấy vị khách làng chơi nữa... Họ thừa biết mình đang\Nbị các cô nàng nói dối, thế mà trông ai nấy vẫn cứ hớn hở vui vẻ.
Dialogue: 0,0:11:26.41,0:11:29.89,Default,,0,0,0,,Chà, tôi đoán ở chốn này, ngày nào\Ncũng có thể là "ngày sinh nhật" của một ai đó cả.
Dialogue: 0,0:11:31.41,0:11:32.99,Default,,0,0,0,,Nhưng rốt cuộc đâu mới là sự thật đây ạ?
Dialogue: 0,0:11:48.04,0:11:50.45,Default,,0,0,0,,Mong là cô sẽ sớm tìm gặp lại được chị gái mình.
Dialogue: 0,0:11:53.36,0:11:55.15,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:12:20.47,0:12:22.99,Default,,0,0,0,,À, chuyện cái bánh kem hôm nọ...
Dialogue: 0,0:12:26.73,0:12:31.05,Default,,0,0,0,,Cả thế gian này, hãy lấp đầy nó... lấp đầy... bằng tất cả sức lực của mình...
Dialogue: 0,0:12:32.07,0:12:33.51,Default,,0,0,0,,Đừng có quá câu nệ tiểu tiết\Ntrong cuộc đời này nhé.
Dialogue: 0,0:12:46.17,0:12:48.10,Default,,0,0,0,,Cháu cảm ơn chú nhiều lắm ạ!
Dialogue: 0,0:13:01.08,0:13:03.04,Default,,0,0,0,,Xin phép dùng bữa nhé.
Dialogue: 0,0:13:06.31,0:13:08.38,Default,,0,0,0,,Vị thế nào hả cậu?
Dialogue: 0,0:13:09.59,0:13:11.68,Default,,0,0,0,,Ngon tuyệt cú mèo luôn.
Dialogue: 0,0:13:12.03,0:13:14.04,Default,,0,0,0,,Quả nhiên, món thịt hầm khoai tây...
Dialogue: 0,0:13:14.06,0:13:17.46,Default,,0,0,0,,...là món ăn gắn liền với tôi từ thuở ấu thơ,\Nhương vị của nó đã ăn sâu vào tiềm thức mất rồi.
Dialogue: 0,0:13:17.54,0:13:19.40,Default,,0,0,0,,Ừ, công nhận đúng thế thật.
Dialogue: 0,0:13:19.47,0:13:22.55,Default,,0,0,0,,Còn tôi thì lại ghét cay ghét đắng món đó.
Dialogue: 0,0:13:34.78,0:13:37.35,Default,,0,0,0,,Cách đây hai năm, hồi công ty\Nđiều chuyển tôi về chi nhánh Fukuoka...
Dialogue: 0,0:13:37.49,0:13:39.42,Default,,0,0,0,,...tôi có tình cờ quen một người phụ nữ.
Dialogue: 0,0:13:40.40,0:13:44.69,Default,,0,0,0,,Thoạt nhìn cô ấy có vẻ rất dịu dàng, đoan trang,\Nđúng mẫu phụ nữ lý tưởng mà đàn ông muốn cưới làm vợ.
Dialogue: 0,0:13:46.93,0:13:49.00,Default,,0,0,0,,Tôi có buột miệng bảo với cô ấy rằng tôi rất thích ăn thịt hầm khoai tây.
Dialogue: 0,0:13:49.00,0:13:50.92,Default,,0,0,0,,Thế là cô ấy liền qua căn hộ của tôi để tự tay nấu món đó cho tôi ăn.
Dialogue: 0,0:13:52.39,0:13:54.83,Default,,0,0,0,,Món cô ấy nấu quả thực rất ngon.
Dialogue: 0,0:14:01.78,0:14:04.31,Default,,0,0,0,,Rồi hai chúng tôi bắt đầu dọn về sống chung với nhau.
Dialogue: 0,0:14:05.40,0:14:08.48,Default,,0,0,0,,Thế nhưng ròng rã suốt từ ngày này qua ngày khác,\Nhôm nào cô ấy cũng chỉ nấu độc mỗi món thịt hầm khoai tây.
Dialogue: 0,0:14:09.90,0:14:12.15,Default,,0,0,0,,Tôi mới góp ý bảo hay là em thử\Nđổi bữa nấu sang món khác xem sao.
Dialogue: 0,0:14:12.72,0:14:14.32,Default,,0,0,0,,Thế cô nàng trả lời sao?
Dialogue: 0,0:14:14.32,0:14:17.32,Default,,0,0,0,,Cô ấy rơm rớm bảo: "Em xin lỗi vì suốt ngày chỉ biết nấu mỗi thịt hầm khoai tây."
Dialogue: 0,0:14:18.39,0:14:22.79,Default,,0,0,0,,"Chỉ tại em muốn nấu được món anh thích ăn nhất,\Nnên em mới dày công tập luyện nấu món thịt hầm khoai tây này thôi."
Dialogue: 0,0:14:23.66,0:14:25.34,Default,,0,0,0,,Nghe cảm động quá đấy chứ, hả?
Dialogue: 0,0:14:25.34,0:14:27.61,Default,,0,0,0,,Lúc đó tôi cũng mủi lòng cảm động lắm.
Dialogue: 0,0:14:28.21,0:14:31.74,Default,,0,0,0,,Và thế là ngày qua ngày, tôi lại càng...\Nà tên cô ấy là Akiko...
Dialogue: 0,0:14:32.41,0:14:34.14,Default,,0,0,0,,...càng thêm say đắm và thương yêu cô ấy hết mực.
Dialogue: 0,0:14:34.63,0:14:36.68,Default,,0,0,0,,Tụi này hiểu cảm giác đó của cậu mà.
Dialogue: 0,0:14:41.23,0:14:43.84,Default,,0,0,0,,Thế rồi, mới chỉ chung sống được đúng hai tháng...
Dialogue: 0,0:14:44.09,0:14:46.69,Default,,0,0,0,,...Akiko đã cuỗm sạch toàn bộ tiền tiết kiệm của tôi rồi bốc hơi không dấu vết.
Dialogue: 0,0:14:52.56,0:14:54.85,Default,,0,0,0,,Chúc mừng sinh nhật!
Dialogue: 0,0:14:54.85,0:15:01.35,Default,,0,0,0,,~ Chúc mừng sinh nhật anh ~
Dialogue: 0,0:15:01.42,0:15:03.74,Default,,0,0,0,,Khoan đã nào cô em,\Ncô có chắc là lần này vào đúng quán không đấy?
Dialogue: 0,0:15:03.74,0:15:06.48,Default,,0,0,0,,Cô bé giao đúng chỗ rồi đấy.\NChính tay tôi đặt chiếc bánh này mà.
Dialogue: 0,0:15:06.54,0:15:09.03,Default,,0,0,0,,Cái gì cơ? Hôm nay là sinh nhật của cậu á?
Dialogue: 0,0:15:09.27,0:15:12.53,Default,,0,0,0,,~ Chúc mừng sinh nhật anh Goro! ~
Dialogue: 0,0:15:13.48,0:15:16.34,Default,,0,0,0,,Ngon lành rồi, chú Goro!\NHôm nay chính là ngày chú mày được tái sinh đấy...
Dialogue: 0,0:15:16.59,0:15:19.33,Default,,0,0,0,,Hãy quẳng hết quá khứ đau thương lại phía sau, và tung cánh bay cao\Nnhư chim phượng hoàng lửa xem nào.
Dialogue: 0,0:15:21.42,0:15:26.39,Default,,0,0,0,,- Cảm ơn cô bé nhiều lắm nhé.\N- Nào, cô bé cũng ngồi xuống đây chung vui với tụi tôi luôn đi.
Dialogue: 0,0:15:26.39,0:15:28.18,Default,,0,0,0,,- Dạ thôi, cháu vẫn còn đang trong ca làm việc...\N- Ối dào, có sao đâu mà...
Dialogue: 0,0:15:29.10,0:15:31.09,Default,,0,0,0,,- Làm một ly đi nào, ngồi xuống đi, ngồi xuống đây.\N- Cứ tự nhiên ngồi xuống đi em.
Dialogue: 0,0:15:31.09,0:15:33.43,Default,,0,0,0,,- Ông chủ, cho thêm bia nhé!\N- Có ngay đây.
Dialogue: 0,0:15:34.59,0:15:37.56,Default,,0,0,0,,- Nhìn chiếc bánh hấp dẫn quá nhỉ?\N- Của mọi người đây.
Dialogue: 0,0:15:39.82,0:15:40.91,Default,,0,0,0,,Uống đi em.
Dialogue: 0,0:15:40.91,0:15:42.35,Default,,0,0,0,,Thực sự là em chỉ nhấp môi được một chút xíu thôi ạ.
Dialogue: 0,0:15:42.55,0:15:44.55,Default,,0,0,0,,Em mà uống bia vào là mặt mũi cứ đỏ bừng hết cả lên.
Dialogue: 0,0:15:44.89,0:15:47.57,Default,,0,0,0,,Con gái má hồng nhìn lại càng thêm phần e ấp đáng yêu chứ sao,\Nanh chẳng thấy phiền chút nào đâu.
Dialogue: 0,0:15:49.16,0:15:51.70,Default,,0,0,0,,Ồ, để em rót mời anh một ly nhé ạ.
Dialogue: 0,0:15:54.34,0:15:56.33,Default,,0,0,0,,Mong là anh sẽ sớm gặp được một người phụ nữ thật tốt nhé.
Dialogue: 0,0:15:57.82,0:16:00.69,Default,,0,0,0,,Không, anh nghĩ là mình đã gặp được người ấy ngay trước mắt rồi.
Dialogue: 0,0:16:04.77,0:16:06.91,Default,,0,0,0,,Ông chủ, cho tôi gọi món thịt hầm khoai tây nhé!
Dialogue: 0,0:16:07.64,0:16:09.50,Default,,0,0,0,,Bạn gái tôi cứ nằng nặc đòi đến đây để ăn lại món đó.
Dialogue: 0,0:16:09.66,0:16:11.40,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:16:14.38,0:16:17.85,Default,,0,0,0,,Thú thực với mọi người, hai chúng tôi vừa mới chính thức đính hôn rồi.
Dialogue: 0,0:16:19.95,0:16:22.70,Default,,0,0,0,,Ái chà, đúng là song hỷ lâm môn mà!\NNgồi xuống đi, ngồi xuống đây nào!
Dialogue: 0,0:16:23.33,0:16:25.25,Default,,0,0,0,,Xin chúc mừng hai người nhé!
Dialogue: 0,0:16:36.93,0:16:40.38,Default,,0,0,0,,Một lần nữa, xin phép được giới thiệu với mọi người,\Nđây là vị hôn thê của tôi, cô Chiaki.
Dialogue: 0,0:16:41.47,0:16:43.79,Default,,0,0,0,,Cuối cùng tôi cũng đã tìm thấy người bạn đời trăm năm của mình.
Dialogue: 0,0:16:44.02,0:16:46.55,Default,,0,0,0,,Ngày mai, hai chúng tôi sẽ về\Nthăm quê nhà của cô ấy ở Tokushima.
Dialogue: 0,0:16:46.92,0:16:49.76,Default,,0,0,0,,Đi du lịch trăng mật trước đám cưới hả?
Dialogue: 0,0:16:50.32,0:16:52.31,Default,,0,0,0,,Thời buổi này rồi thì trước hay sau có khác gì nhau đâu chứ?
Dialogue: 0,0:16:53.00,0:16:55.25,Default,,0,0,0,,Tôi hơi bất ngờ khi nghe một người nghiêm túc như anh nói câu đó đấy.
Dialogue: 0,0:17:01.37,0:17:03.32,Default,,0,0,0,,Ông chú này nói thế là có ý gì hả?
Dialogue: 0,0:17:03.32,0:17:05.30,Default,,0,0,0,,Đầu phải quê chị ở Tokushima,\Nchẳng phải chị là người Hokkaido hay sao?
Dialogue: 0,0:17:06.57,0:17:08.44,Default,,0,0,0,,Chị đổi tên thành "Chiaki" từ bao giờ thế?
Dialogue: 0,0:17:09.49,0:17:11.02,Default,,0,0,0,,Chị là Sachiko cơ mà, đúng không... Chị hai?
Dialogue: 0,0:17:11.46,0:17:13.68,Default,,0,0,0,,- Chị hai ư?\N- Akiko!!
Dialogue: 0,0:17:14.37,0:17:16.42,Default,,0,0,0,,Chiaki...!
Dialogue: 0,0:17:16.82,0:17:20.62,Default,,0,0,0,,"Chiaki" ư?\NChẳng lẽ đây chính là... trò lừa đảo bằng món thịt hầm khoai tây sao?!
Dialogue: 0,0:17:21.42,0:17:24.03,Default,,0,0,0,,Sachiko nào cơ?\N"Lừa đảo" gì ở đây?
Dialogue: 0,0:17:26.19,0:17:28.67,Default,,0,0,0,,Chị hai à, thôi ngay cái trò đóng kịch đó đi được không hả?
Dialogue: 0,0:17:31.84,0:17:33.28,Default,,0,0,0,,Bị mày bắt thóp mất rồi.
Dialogue: 0,0:17:36.59,0:17:38.21,Default,,0,0,0,,Chị vẫn còn chưa chịu bỏ cái nghề lừa đảo này sao?
Dialogue: 0,0:17:49.86,0:17:52.87,Default,,0,0,0,,Ngày xưa chị diễn trò khóc giả tạo giỏi lắm cơ mà.
Dialogue: 0,0:17:53.30,0:17:56.03,Default,,0,0,0,,Sao bây giờ trông chị diễn vụng về giả trân thế hả.
Dialogue: 0,0:17:56.14,0:17:58.58,Default,,0,0,0,,Thôi đừng có đứng đó lên mặt dạy đời chị nữa.
Dialogue: 0,0:17:59.84,0:18:02.09,Default,,0,0,0,,Đồn cảnh sát gần nhất là ở chỗ nào thế ạ?
Dialogue: 0,0:18:03.67,0:18:06.13,Default,,0,0,0,,Nó nằm ngay ngoài đầu con phố kia thôi.
Dialogue: 0,0:18:10.30,0:18:13.89,Default,,0,0,0,,Cháu thực sự xin lỗi vì đã gây phiền hà cho mọi người ạ.
Dialogue: 0,0:18:14.33,0:18:16.98,Default,,0,0,0,,Cháu sẽ tự mình chịu trách nhiệm\Náp giải chị gái cháu ra trình diện cảnh sát.
Dialogue: 0,0:18:17.64,0:18:20.30,Default,,0,0,0,,Cháu thành thật xin lỗi mọi người rất nhiều ạ!
Dialogue: 0,0:18:21.11,0:18:26.06,Default,,0,0,0,,Ui da! Khoan đã, chờ chị lấy đồ đạc đã chứ...
Dialogue: 0,0:18:27.81,0:18:29.94,Default,,0,0,0,,Chết tiệt thật... Biết rồi, từ từ thôi nào...!
Dialogue: 0,0:18:42.93,0:18:46.29,Default,,0,0,0,,Này khoan đã, chẳng phải lúc nãy mày\Nđập cái bánh kem vào mặt tao hơi bị mạnh tay quá rồi đấy phỏng?
Dialogue: 0,0:18:46.29,0:18:48.77,Default,,0,0,0,,Làm giờ mặt mũi tao nhớp nháp dính đầy kem đây này.
Dialogue: 0,0:18:48.77,0:18:51.69,Default,,0,0,0,,Chị hai đó, tự dưng mò vào giẫm chân lên địa bàn làm ăn\Ncủa em làm cái quái gì không biết?
Dialogue: 0,0:18:52.04,0:18:55.02,Default,,0,0,0,,Thì tại món thịt hầm khoai tây của Ông chủ quán đó nấu ngon quá chứ sao.
Dialogue: 0,0:18:55.59,0:18:56.81,Default,,0,0,0,,Thôi cho chị mày xin lỗi đi.
Dialogue: 0,0:18:57.42,0:18:59.19,Default,,0,0,0,,Ờ thì, công nhận món đó NGON thật chị nhỉ?
Dialogue: 0,0:18:59.56,0:19:01.03,Default,,0,0,0,,Ngon đến mức cảm giác như mang tội luôn ấy chứ, nhỉ?
Dialogue: 0,0:19:02.09,0:19:04.67,Default,,0,0,0,,Làm hai chị em mình bồi hồi nhớ lại hương vị quê nhà biết bao...
Dialogue: 0,0:19:05.21,0:19:07.41,Default,,0,0,0,,Mà cái kiểu ủy mị đa sầu đa cảm đó vốn đâu hợp với chị em mình.
Dialogue: 0,0:19:07.60,0:19:09.23,Default,,0,0,0,,Ừ, mày nói chí phải.
Dialogue: 0,0:19:11.45,0:19:14.39,Default,,0,0,0,,Đồn cảnh sát ở ngay đằng kia kìa.
Dialogue: 0,0:19:19.46,0:19:23.17,Default,,0,0,0,,{\i1}Sau cái đêm hôm ấy, hai chị em họ không hề xuất hiện ở đồn cảnh sát...{\i0}
Dialogue: 0,0:19:24.03,0:19:26.22,Default,,0,0,0,,{\i1}Xem chừng cả hai đã cao chạy xa bay khỏi thành phố này rồi.{\i0}
Dialogue: 0,0:19:33.09,0:19:39.06,Default,,0,0,0,,("Bắt giữ Cặp Chị Em Lừa Đảo Thịt Hầm Khoai Tây!...\NLên tới 20 nạn nhân sập bẫy trên khắp cả nước...")
Dialogue: 0,0:20:10.21,0:20:12.64,Default,,0,0,0,,"Cả thế gian này..."
Dialogue: 0,0:20:17.94,0:20:20.07,Default,,0,0,0,,"Cả thế gian này" làm sao cơ?
Dialogue: 0,0:20:35.43,0:20:39.95,Default,,0,0,0,,{\i1}Đến cả một người như anh ta... cũng phải cạn lời.{\i0}
Dialogue: 0,0:21:02.03,0:21:05.77,Default,,0,0,0,,Nếu muốn món thịt hầm khoai tây có hương vị\Nđậm đà sắc nét hơn, hãy thử nêm bằng đường thô hạt to.
Dialogue: 0,0:21:06.07,0:21:09.07,Default,,0,0,0,,Các bạn cũng có thể dùng loại hành tây ngọt để hầm cùng.
Dialogue: 0,0:21:13.07,0:21:15.35,Default,,0,0,0,,Ồ, dậy mùi thơm quá đi mất...
Dialogue: 0,0:21:19.28,0:21:21.99,Default,,0,0,0,,Bọn tôi sực nhớ ra có chút việc gấp phải giải quyết.
Dialogue: 0,0:21:22.63,0:21:23.72,Default,,0,0,0,,Nên phần này xin nhường lại cho cô ăn đấy.
Dialogue: 0,0:21:24.64,0:21:26.79,Default,,0,0,0,,Xin lỗi nhé, nhưng bọn tôi phải đi ngay đây.
Dialogue: 0,0:21:27.13,0:21:29.00,Default,,0,0,0,,Đúng là xấu hổ chết đi được.
Dialogue: 0,0:21:29.01,0:21:31.70,Default,,0,0,0,,Vậy nhé, chúc quý vị ngủ ngon.
Dialogue: 0,0:21:38.22,0:21:42.10,Default,,0,0,0,,{\i1}Còn tiếp...{\i0}
Dialogue: 0,0:21:43.58,0:21:55.72,Default,,0,0,0,,~ Heya no katasumi de bon'yari hikaru terebi ~\N*Trong góc phòng, màn hình tivi lấp lánh ánh sáng mờ ảo*
