Dialogue: 0,0:00:06.36,0:00:10.86,Default,,0,0,0,,Biên dịch và căn chỉnh thời gian:\NAmtia(NOFACE)
Dialogue: 0,0:00:10.86,0:00:14.86,Default,,0,0,0,,Cảm ơn bản raw và phụ đề gốc:\Nyyets.com và \( -o _ o- )/
Dialogue: 0,0:00:21.16,0:00:26.53,Default,,0,0,0,,~ Kimi ga haita shiroi iki ga ~\N*Làn khói trắng em khẽ thở ra*
Dialogue: 0,0:00:26.53,0:00:30.39,Default,,0,0,0,,~ Ima yukkuri kaze ni notte ~\N*Giờ chầm chậm nương theo làn gió*
Dialogue: 0,0:00:31.27,0:00:36.39,Default,,0,0,0,,~ Sora ni ukabu kumo no naka ni ~\N*Hòa vào những đám mây trôi trên bầu trời*
Dialogue: 0,0:00:36.39,0:00:41.38,Default,,0,0,0,,~ Sukoshi zutsu kiete yuku ~\N*Rồi cứ thế tan biến dần đi*
Dialogue: 0,0:00:41.59,0:00:46.68,Default,,0,0,0,,~ Toku takai sora no naka de ~\N*Giữa bầu trời cao vời vợi xa xăm*
Dialogue: 0,0:00:46.68,0:00:51.11,Default,,0,0,0,,~ Te o nobasu shiroi kumo ~\N*Đám mây trắng vươn bàn tay xuống*
Dialogue: 0,0:00:51.36,0:00:53.07,Default,,0,0,0,,Khi một ngày khép lại...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:53.07,0:00:53.36,Default,,0,0,0,,~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:53.36,0:00:55.98,Default,,0,0,0,,Khi người ta vội vã trở về nhà...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:55.98,0:00:56.84,Default,,0,0,0,,~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:56.84,0:00:56.96,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Cứ thế lững lờ trôi đi*
Dialogue: 0,0:00:56.96,0:00:59.08,Default,,0,0,0,,Thì ngày mới của tôi mới bắt đầu.\N~ Pokkari to ukan deru ~\N*Cứ thế lững lờ trôi đi*
Dialogue: 0,0:00:59.08,0:01:00.74,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Cứ thế lững lờ trôi đi*
Dialogue: 0,0:01:02.64,0:01:11.93,Default,,0,0,0,,~ Zutto mukashi no koto no yoda ne ~\N*Tựa như chuyện của một thuở rất xa xưa*
Dialogue: 0,0:01:12.66,0:01:21.35,Default,,0,0,0,,~ Kawamo no ue o kumo ga nagareru ~\N*Mây lặng lẽ trôi trên mặt sông êm đềm*
Dialogue: 0,0:01:23.16,0:01:27.29,Default,,0,0,0,,Quán của tôi mở cửa từ nửa đêm đến bảy giờ sáng.
Dialogue: 0,0:01:28.62,0:01:32.29,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:34.71,0:01:36.26,Default,,0,0,0,,Thực đơn chỉ có súp miso thịt heo, bia, rượu sake và shochu.
Dialogue: 0,0:01:36.89,0:01:39.19,Default,,0,0,0,,Nếu khách có yêu cầu món khác...
Dialogue: 0,0:01:39.82,0:01:41.84,Default,,0,0,0,,...tôi sẽ bảo "Chỉ cần có nguyên liệu là tôi sẽ làm."
Dialogue: 0,0:01:42.40,0:01:44.33,Default,,0,0,0,,Phương châm của tôi là vậy.
Dialogue: 0,0:01:46.73,0:01:48.43,Default,,0,0,0,,(Biển hiệu: Quán Meshiya)
Dialogue: 0,0:01:48.50,0:01:50.70,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:50.79,0:01:52.84,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:57.54,0:02:02.54,Default,,0,0,0,,~ QUÁN ĂN ĐÊM ~\N(Shinya Shokudo)\N= Mùa 2 =
Dialogue: 0,0:02:03.44,0:02:07.94,Default,,0,0,0,,Câu chuyện thứ 14 (Tập 4):\N"Thạch cá đông Nikogori"
Dialogue: 0,0:02:12.41,0:02:15.75,Default,,0,0,0,,Trông cậu mệt mỏi quá đấy.\NNhất là hôm nay, hiện rõ mồn một trên mặt luôn.
Dialogue: 0,0:02:16.02,0:02:18.18,Default,,0,0,0,,Tại cái cậu làm thêm mới vào chỗ cháu\Nlàm ăn tắc trách vụng về quá ấy mà.
Dialogue: 0,0:02:18.19,0:02:20.93,Default,,0,0,0,,- Cháu làm ở đâu thế?\N- Ở tiệm cơm hộp bento ạ.
Dialogue: 0,0:02:21.05,0:02:23.66,Default,,0,0,0,,Cái cậu đó thậm chí còn chẳng biết\Ncầm dao làm bếp sao cho đúng cách nữa cơ.
Dialogue: 0,0:02:23.87,0:02:26.26,Default,,0,0,0,,Ai mới bắt đầu thì cũng đều như thế cả thôi mà.
Dialogue: 0,0:02:26.45,0:02:29.06,Default,,0,0,0,,Bác ấy nói phải đấy.. Tôi cá hồi mới vào nghề\NMasashi-san cũng lóng ngóng y như vậy cho xem.
Dialogue: 0,0:02:29.17,0:02:30.96,Default,,0,0,0,,Nhưng ở quê, nhà cháu mở quán ăn bình dân mà.
Dialogue: 0,0:02:31.39,0:02:32.89,Default,,0,0,0,,Bố cháu mất sớm.
Dialogue: 0,0:02:32.95,0:02:35.57,Default,,0,0,0,,Nên từ nhỏ mẹ đã bắt cháu\Nphụ giúp việc bếp núc trong quán rồi.
Dialogue: 0,0:02:36.15,0:02:38.52,Default,,0,0,0,,Thế thì sao cậu không tận tình chỉ bảo\Ncho cậu nhân viên mới đó?
Dialogue: 0,0:02:39.01,0:02:41.50,Default,,0,0,0,,Như thế chẳng phải sẽ giúp cậu ấy lẫn bản thân cậu\Ncùng tiến bộ và trưởng thành hơn sao?
Dialogue: 0,0:02:41.83,0:02:43.89,Default,,0,0,0,,Nhưng cậu ta vô dụng, hậu đậu lắm bác ơi.
Dialogue: 0,0:02:43.96,0:02:45.93,Default,,0,0,0,,Có khi sắp tới cậu ta cũng nghỉ việc sớm thôi.
Dialogue: 0,0:02:46.03,0:02:49.52,Default,,0,0,0,,- Chào buổi tối ạ.\N- Ô, mừng cô ghé quán.
Dialogue: 0,0:02:50.16,0:02:53.22,Default,,0,0,0,,Tôi có làm một ít "nikogori" đấy nhé.\N(*Thạch nước dùng cá đông kiểu Nhật)
Dialogue: 0,0:02:54.82,0:02:56.88,Default,,0,0,0,,{\i1}Cứ cách một ngày, quán của tôi lại nấu...{\i0}
Dialogue: 0,0:02:57.27,0:02:59.84,Default,,0,0,0,,{\i1}...món cá bơn kho đậm vị "karei no nitsuke".{\i0}
Dialogue: 0,0:03:01.05,0:03:03.57,Default,,0,0,0,,{\i1}Đến ngày hôm sau, phần nước dùng cá nhiều collagen\Nsẽ tự nhiên đông đặc lại thành thạch.{\i0}
Dialogue: 0,0:03:04.45,0:03:05.87,Default,,0,0,0,,{\i1}Tôi thường múc riêng ra từng đĩa nhỏ...{\i0}
Dialogue: 0,0:03:05.98,0:03:09.53,Default,,0,0,0,,{\i1}...để dành tặng miễn phí cho những vị khách yêu thích món này.{\i0}
Dialogue: 0,0:03:11.38,0:03:13.30,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:03:14.32,0:03:16.43,Default,,0,0,0,,Món "nikogori" này, trông giống như...
Dialogue: 0,0:03:16.67,0:03:19.11,Default,,0,0,0,,...miếng thạch trong suốt vậy nhỉ?
Dialogue: 0,0:03:19.50,0:03:24.42,Default,,0,0,0,,Món ăn ở quán này lúc nào cũng được nấu riêng\Nchiều theo khẩu vị của từng thực khách... đúng không bác?
Dialogue: 0,0:03:24.42,0:03:26.22,Default,,0,0,0,,Ừ.
Dialogue: 0,0:03:26.37,0:03:28.45,Default,,0,0,0,,Xin mời cả nhà dùng bữa ạ.
Dialogue: 0,0:03:53.98,0:03:56.19,Default,,0,0,0,,Ông chủ ơi, cho tôi một đĩa nikogori với nhé.
Dialogue: 0,0:03:57.02,0:03:59.77,Default,,0,0,0,,Tiếc quá, hôm nay tôi chỉ làm vừa vặn một phần thôi.
Dialogue: 0,0:04:00.42,0:04:01.51,Default,,0,0,0,,Bởi vì linh tính mách bảo tôi...
Dialogue: 0,0:04:01.69,0:04:03.98,Default,,0,0,0,,...rằng hôm nay thế nào Ikumi-chan cũng sẽ ghé quán.
Dialogue: 0,0:04:04.95,0:04:06.95,Default,,0,0,0,,Cháu cảm ơn ông chủ nhiều nhé.
Dialogue: 0,0:04:23.34,0:04:25.94,Default,,0,0,0,,Nhìn cô bé ăn ngon lành hạnh phúc ghê cơ.
Dialogue: 0,0:04:26.03,0:04:28.63,Default,,0,0,0,,Ừ...\NĐược ngắm nhìn nét mặt rạng rỡ của người ta như thế...
Dialogue: 0,0:04:28.86,0:04:31.99,Default,,0,0,0,,...thì dù bận rộn đến mấy cũng không thể nào quên chuẩn bị sẵn\Nmột đĩa thạch cá đông cho cô ấy được.
Dialogue: 0,0:04:31.99,0:04:33.48,Default,,0,0,0,,Bác nói quá chuẩn luôn.
Dialogue: 0,0:04:33.49,0:04:36.34,Default,,0,0,0,,Cô ấy là khách quen ở đây à?\NCô ấy làm nghề gì thế bác?
Dialogue: 0,0:04:36.41,0:04:41.11,Default,,0,0,0,,Tôi nghĩ tốt nhất là chú không nên soi mói\Ntìm hiểu sâu về đời tư của người khác làm gì.
Dialogue: 0,0:04:41.11,0:04:43.04,Default,,0,0,0,,Dạ, cháu xin lỗi ạ.
Dialogue: 0,0:04:47.50,0:04:49.58,Default,,0,0,0,,Cơm hộp gà rán của tôi vẫn chưa xong nữa à?
Dialogue: 0,0:04:49.95,0:04:52.74,Default,,0,0,0,,Dạ cháu đang làm ngay đây ạ.
Dialogue: 0,0:04:52.74,0:04:54.09,Default,,0,0,0,,Cái thằng lính mới chết tiệt...
Dialogue: 0,0:04:54.09,0:04:56.18,Default,,0,0,0,,...thế mà nó dám bùng làm, chẳng thèm tới nữa chứ.
Dialogue: 0,0:05:23.04,0:05:25.10,Default,,0,0,0,,Anh còn nhớ không? Cái món thạch cá đông hôm nọ ấy.
Dialogue: 0,0:05:30.93,0:05:33.95,Default,,0,0,0,,- Này, cơm hộp gà rán của tôi xong chưa đấy?!\N- Dạ cháu xin lỗi, có ngay đây ạ!
Dialogue: 0,0:05:33.96,0:05:36.19,Default,,0,0,0,,Sắp hết giờ nghỉ trưa của tôi rồi đấy,\Nnhanh cái tay lên giùm coi.
Dialogue: 0,0:05:37.14,0:05:40.39,Default,,0,0,0,,- Bán cho tôi với nào!\N- Dạ xin quý khách đợi một lát ạ!
Dialogue: 0,0:05:54.57,0:05:57.42,Default,,0,0,0,,Xin lỗi vì đã để quý khách phải đợi lâu.\NQuý khách muốn dùng món gì ạ?
Dialogue: 0,0:05:59.58,0:06:02.69,Default,,0,0,0,,- Để xem nào...\N- Dạ?\N- Cho tôi một suất cơm thập cẩm chiên xù và...
Dialogue: 0,0:06:03.16,0:06:05.14,Default,,0,0,0,,Một cơm thập cẩm chiên xù... có ngay ạ.
Dialogue: 0,0:06:05.15,0:06:06.47,Default,,0,0,0,,Với lại một phần salad rau xanh nữa nhé.
Dialogue: 0,0:06:06.47,0:06:08.44,Default,,0,0,0,,Dạ, salad rau xanh, vâng ạ.
Dialogue: 0,0:06:11.82,0:06:14.17,Default,,0,0,0,,Suất cơm gà rán của bác đây ạ...\NCảm ơn bác đã chờ.... Ôi, em xin lỗi chị.
Dialogue: 0,0:06:14.18,0:06:15.72,Default,,0,0,0,,- Để tôi lo bên này cho.\N- Nhưng mà...
Dialogue: 0,0:06:15.81,0:06:17.89,Default,,0,0,0,,Không sao đâu, cứ để tôi.
Dialogue: 0,0:06:31.22,0:06:33.83,Default,,0,0,0,,Của quý khách một suất cơm bento gà rán...\Ntổng cộng hết 2500 yên ạ.
Dialogue: 0,0:06:33.83,0:06:35.42,Default,,0,0,0,,Đây.
Dialogue: 0,0:06:36.13,0:06:38.45,Default,,0,0,0,,- Vâng, xin cảm ơn quý khách nhiều ạ.\N- Cảm ơn cô bé nhé.
Dialogue: 0,0:06:41.03,0:06:43.79,Default,,0,0,0,,Cho tôi một suất cơm chiên thập cẩm\Nvới một phần salad rau nhé.
Dialogue: 0,0:06:44.50,0:06:46.35,Default,,0,0,0,,Dạ... vâng ạ!
Dialogue: 0,0:06:46.41,0:06:48.69,Default,,0,0,0,,- Quý khách có dùng thêm gì nữa không ạ?\N- Cho tôi bát súp gà nữa.
Dialogue: 0,0:06:48.69,0:06:50.88,Default,,0,0,0,,Dạ súp gà, có ngay đây ạ.
Dialogue: 0,0:06:52.31,0:06:54.20,Default,,0,0,0,,Á, nóng quá!
Dialogue: 0,0:06:54.26,0:06:58.34,Default,,0,0,0,,Hôm nay cô cứ uống thoải mái nhé, tôi bao.
Dialogue: 0,0:07:01.64,0:07:03.34,Default,,0,0,0,,Anh đãi thế này liệu có ổn không đấy?
Dialogue: 0,0:07:03.40,0:07:05.67,Default,,0,0,0,,Không sao đâu, coi như đây là lời cảm ơn chuyện ban trưa...\Nhôm nay thật sự nhờ có cô cứu nguy giúp một bàn thua trông thấy đấy.
Dialogue: 0,0:07:05.75,0:07:07.82,Default,,0,0,0,,Cả ông chủ nữa đấy... chú cũng nên học hỏi\Nkỹ năng tiếp khách niềm nở của Ikumi-chan đi nhé.
Dialogue: 0,0:07:11.56,0:07:14.38,Default,,0,0,0,,- Xin thứ lỗi... nếu như tôi là một người tiếp khách vụng về.\N- Nhưng cháu lại cực kỳ thích sự điềm đạm, ít nói của ông chủ đấy chứ.
Dialogue: 0,0:07:15.07,0:07:18.75,Default,,0,0,0,,Đấy nhé, ông chủ lúc nào cũng được lòng phái nữ ghê ha.
Dialogue: 0,0:07:18.84,0:07:22.15,Default,,0,0,0,,Nhưng mà một mình cậu phải xoay xở cả cửa tiệm\Nvào mỗi giờ ăn trưa cao điểm thế cũng vất vả thật đấy nhỉ?
Dialogue: 0,0:07:22.81,0:07:25.46,Default,,0,0,0,,Dạ không... cũng chẳng có vấn đề gì to tát đâu ạ.
Dialogue: 0,0:07:25.47,0:07:26.91,Default,,0,0,0,,Ước mơ tương lai của cháu là tự mình mở một quán ăn riêng.
Dialogue: 0,0:07:27.06,0:07:29.51,Default,,0,0,0,,Vả lại tự ép mình bận rộn vất vả một chút\Ncũng là cách để tôi rèn giũa và tự mình trưởng thành hơn mà.
Dialogue: 0,0:07:29.51,0:07:35.51,Default,,0,0,0,,Mà này, câu nói triết lý đó là của ai đấy nhỉ?
Dialogue: 0,0:07:35.79,0:07:38.12,Default,,0,0,0,,À thì... Nếu quán ăn của tôi sau này mà có một "nàng thơ hút khách"*\Nxinh đẹp như Ikumi-san thì tuyệt biết bao.\N(*Kanban-musume - cô gái duyên dáng làm gương mặt đại diện hút khách)
Dialogue: 0,0:07:38.99,0:07:45.76,Default,,0,0,0,,À, Ikumi-san này...
Dialogue: 0,0:07:59.60,0:08:01.85,Default,,0,0,0,,Liệu cô có thể... hẹn hò với tôi được không...?
Dialogue: 0,0:08:02.92,0:08:04.92,Default,,0,0,0,,Hay là... không được hả cô?
Dialogue: 0,0:08:07.91,0:08:10.28,Default,,0,0,0,,Tôi...
Dialogue: 0,0:08:11.76,0:08:16.53,Default,,0,0,0,,Tôi có bạn trai mất rồi.
Dialogue: 0,0:08:16.53,0:08:18.55,Default,,0,0,0,,À... thế à cô.
Dialogue: 0,0:08:18.65,0:08:22.06,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:08:22.99,0:08:24.53,Default,,0,0,0,,Tất nhiên rồi, người như cô sao mà chưa có được chứ.
Dialogue: 0,0:08:24.59,0:08:26.23,Default,,0,0,0,,Ý tôi là, một người duyên dáng như cô làm sao mà lẻ bóng được...
Dialogue: 0,0:08:26.46,0:08:28.91,Default,,0,0,0,,- Tôi xin lỗi anh nhé.\N- Đừng bận tâm... là do tôi đường đột quá thôi.
Dialogue: 0,0:08:29.53,0:08:34.19,Default,,0,0,0,,Cảm ơn anh vì bữa ăn ngon miệng này nhé.
Dialogue: 0,0:08:41.41,0:08:43.49,Default,,0,0,0,,Đêm muộn rồi...\Nđể tôi tiễn cô một đoạn về nhà nhé.
Dialogue: 0,0:08:46.48,0:08:48.51,Default,,0,0,0,,Thôi khỏi cần đâu anh.\NVậy nhé... chúc anh ngủ ngon.
Dialogue: 0,0:08:48.51,0:08:51.34,Default,,0,0,0,,Hẹn gặp lại cô.
Dialogue: 0,0:08:52.18,0:08:54.28,Default,,0,0,0,,Sao tự dưng mình lại buột mồm nói ra những lời ngốc nghếch thế không biết?
Dialogue: 0,0:09:05.27,0:09:08.77,Default,,0,0,0,,Chắc tại lúc đó cậu không kìm nén nổi\Ntiếng lòng thổn thức của con tim chứ gì.
Dialogue: 0,0:09:10.36,0:09:13.93,Default,,0,0,0,,Tuổi trẻ bồng bột đáng yêu ghê nhỉ?
Dialogue: 0,0:09:14.71,0:09:16.12,Default,,0,0,0,,Nhưng mà nhiều cô gái lại thích mẫu đàn ông\Nmạnh mẽ, chủ động tấn công một chút đấy.
Dialogue: 0,0:09:16.39,0:09:21.02,Default,,0,0,0,,Thật thế hả bác? Vậy thì cháu sẽ cố gắng hết mình ạ.
Dialogue: 0,0:09:21.08,0:09:23.04,Default,,0,0,0,,- Chào buổi tối cả nhà.\N- Mừng cậu ghé quán.
Dialogue: 0,0:09:23.52,0:09:25.83,Default,,0,0,0,,Vừa nãy có phải là bé Miku không chú?
Dialogue: 0,0:09:27.95,0:09:30.09,Default,,0,0,0,,Lâu lắm rồi mới thấy em ấy đấy...
Dialogue: 0,0:09:30.10,0:09:31.75,Default,,0,0,0,,Nghe đồn dạo này em ấy đắt khách lắm cơ--
Dialogue: 0,0:09:31.83,0:09:33.18,Default,,0,0,0,,Ấy kìa, Komichi... à ừm...
Dialogue: 0,0:09:33.18,0:09:34.12,Default,,0,0,0,,Hôm nay.. à... quán tôi có món cá bơn kho đậm vị đấy,\Nngon xuất sắc luôn đấy nhé.
Dialogue: 0,0:09:34.65,0:09:37.60,Default,,0,0,0,,Phải rồi... đúng đúng đúng.
Dialogue: 0,0:09:38.10,0:09:38.74,Default,,0,0,0,,- Món đó đỉnh của chóp luôn đấy.\N- Thật thế cơ à?
Dialogue: 0,0:09:38.74,0:09:40.80,Default,,0,0,0,,Mọi người đã khen nức nở thế thì chẳng có lý do gì\Nmà tôi lại không nếm thử cả, đúng không nào.
Dialogue: 0,0:09:41.33,0:09:43.54,Default,,0,0,0,,Đây, ăn đi.\NTrật tự mà tập trung ăn đi xem nào.
Dialogue: 0,0:09:43.76,0:09:46.11,Default,,0,0,0,,- Lúc nãy tôi vừa mới xơi món này xong đấy.\N- Thật á?
Dialogue: 0,0:09:47.68,0:09:51.02,Default,,0,0,0,,Ừ.\NAnh có muốn dùng chung đôi đũa này của tôi không?
Dialogue: 0,0:09:51.06,0:09:53.26,Default,,0,0,0,,À... xin thứ lỗi! Vừa nãy,\Nanh có nhắc tới một người phụ nữ nào đó...
Dialogue: 0,0:09:59.90,0:10:06.53,Default,,0,0,0,,À... bé Miku ấy hả?
Dialogue: 0,0:10:06.82,0:10:09.31,Default,,0,0,0,,Có phải ý anh muốn nói đến "Ikumi-san" không ạ?
Dialogue: 0,0:10:10.53,0:10:12.56,Default,,0,0,0,,À, chuẩn chuẩn..\NTên thật của em ấy là Ikumi.
Dialogue: 0,0:10:12.68,0:10:14.73,Default,,0,0,0,,Ý anh là sao khi bảo "tên thật"?
Dialogue: 0,0:10:15.23,0:10:16.77,Default,,0,0,0,,Thì bé Miku là gái bán hoa cao cấp mà...
Dialogue: 0,0:10:16.81,0:10:18.33,Default,,0,0,0,,...em ấy đi khách ở động SILKY bên khu phố Kabukicho ấy.
Dialogue: 0,0:10:18.96,0:10:21.67,Default,,0,0,0,,Tôi nghe bảo muốn đặt lịch hẹn với em ấy khó như lên trời vậy.
Dialogue: 0,0:10:21.91,0:10:24.42,Default,,0,0,0,,Không... cháu đâu có tính làm chuyện đó đâu.\NCháu chỉ muốn hỏi thăm chút thôi mà.
Dialogue: 0,0:10:27.64,0:10:30.94,Default,,0,0,0,,Miku-san, có khách đặt phòng rồi nhé em.
Dialogue: 0,0:10:40.52,0:10:42.90,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:10:44.22,0:10:46.09,Default,,0,0,0,,Em là Miku ạ.
Dialogue: 0,0:10:56.45,0:10:57.70,Default,,0,0,0,,Rất mong anh chiếu cố nhẹ nhàng cho em.
Dialogue: 0,0:10:57.70,0:10:59.78,Default,,0,0,0,,Mừng anh đế--...
Dialogue: 0,0:11:26.55,0:11:28.55,Default,,0,0,0,,Nhưng mà Rumi-san này, chẳng phải anh chàng đó\Nchỉ đang buông lời nịnh đầm tâng bốc bà thôi sao?
Dialogue: 0,0:11:33.94,0:11:37.16,Default,,0,0,0,,Hả? Mấy bà nghĩ thế thật đấy à?
Dialogue: 0,0:11:37.25,0:11:38.69,Default,,0,0,0,,- Nhưng mà mấy bà biết đấy...\N- Chuẩn luôn, chuẩn luôn...
Dialogue: 0,0:11:38.69,0:11:40.07,Default,,0,0,0,,...một người đàn ông đàng hoàng chẳng bao giờ buông lời ngon ngọt như thế đâu.
Dialogue: 0,0:11:40.07,0:11:42.09,Default,,0,0,0,,Nói năng tàn nhẫn thế không biết...\NHóa ra trong mắt các bà tôi là người như thế đấy hả?
Dialogue: 0,0:11:42.47,0:11:45.84,Default,,0,0,0,,Không phải, không phải...\N...ý tụi này là nói chung trên mặt bằng xã hội thôi mà.
Dialogue: 0,0:11:45.84,0:11:49.28,Default,,0,0,0,,Nói cho cùng, mấy bà chỉ ghen ăn tức ở vì nghĩ một phụ nữ như tôi\Nkhông xứng đáng nhận được sự săn đón của một người đàn ông như thế chứ gì.
Dialogue: 0,0:11:49.30,0:11:53.56,Default,,0,0,0,,Nhưng mà Rumi-san à...
Dialogue: 0,0:11:53.56,0:11:55.51,Default,,0,0,0,,...chẳng phải bà đang tự huyễn hoặc, ảo tưởng quá đà rồi sao?
Dialogue: 0,0:11:55.72,0:11:57.70,Default,,0,0,0,,Dù sao đi nữa... tôi là một người phụ nữ tự tin tràn trề,\Nvà có cá tính cực kỳ độc lập đấy nhé.
Dialogue: 0,0:11:58.14,0:12:02.08,Default,,0,0,0,,Đấy, lại bắt đầu bài ca muôn thuở rồi đấy.
Dialogue: 0,0:12:02.11,0:12:04.19,Default,,0,0,0,,Thì những cái nét tính cách đó chính là khuyết điểm\Nmà bà cần phải sửa đổi gấp đấy, hiểu chưa?
Dialogue: 0,0:12:04.20,0:12:06.80,Default,,0,0,0,,Mấy cái bà này đúng là rách việc, bao đồng quá đi mất.
Dialogue: 0,0:12:06.86,0:12:09.07,Default,,0,0,0,,{\i1}Khi một ngày khép lại,\Nngười ta lại vội vã trở về tổ ấm của mình.{\i0}
Dialogue: 0,0:12:15.38,0:12:19.27,Default,,0,0,0,,{\i1}Thế nhưng nếu trong lòng vẫn còn điều gì vương vấn dở dang...{\i0}
Dialogue: 0,0:12:20.27,0:12:23.63,Default,,0,0,0,,{\i1}...vào những đêm như thế, người ta sẽ muốn rẽ vào một lối khác.{\i0}
Dialogue: 0,0:12:24.25,0:12:26.40,Default,,0,0,0,,Ý anh là cái xẻng dùng để lật bánh xèo okonomiyaki ấy hả?
Dialogue: 0,0:12:27.53,0:12:30.56,Default,,0,0,0,,Đúng rồi, chuẩn đấy... ở Hiroshima người ta\Ngọi cái đó là "cái bay" (kote).
Dialogue: 0,0:12:30.56,0:12:32.74,Default,,0,0,0,,Thế nhưng dân ở Osaka thì lại gọi nó là "cái đòn bẩy" (teko).
Dialogue: 0,0:12:32.74,0:12:34.87,Default,,0,0,0,,Ông chủ ơi, cho tôi thêm chén nữa.
Dialogue: 0,0:12:35.23,0:12:36.48,Default,,0,0,0,,"Cái bay" là dụng cụ thợ hồ dùng để trát xi măng cơ mà...
Dialogue: 0,0:12:36.48,0:12:40.15,Default,,0,0,0,,Nhưng mà "cái đòn bẩy" ấy mà, anh hiểu không...
Dialogue: 0,0:12:40.15,0:12:41.80,Default,,0,0,0,,...Vì bánh xèo kiểu Osaka hay dính chặt vào chảo gang, nên người ta phải dùng nó bẩy chiếc bánh lên như một chiếc đòn bẩy.
Dialogue: 0,0:12:41.80,0:12:45.99,Default,,0,0,0,,À, đúng rồi, đúng rồi.
Dialogue: 0,0:12:45.99,0:12:47.62,Default,,0,0,0,,Bởi thế người ta mới gọi nó là "cái đòn bẩy".
Dialogue: 0,0:12:47.62,0:12:49.64,Default,,0,0,0,,Thế nhưng tên gọi chính xác trong từ điển của nó là gì mới được chứ?
Dialogue: 0,0:12:49.92,0:12:51.92,Default,,0,0,0,,Thế là lần này tôi cất công đi hỏi một người bạn quê ở Kyoto.
Dialogue: 0,0:12:52.10,0:12:54.07,Default,,0,0,0,,Anh chàng đó bảo là...
Dialogue: 0,0:12:54.18,0:12:55.07,Default,,0,0,0,,"Ô, ý bác là cái xẻng lật thức ăn (okoshi-gane) ấy hả?"
Dialogue: 0,0:12:56.24,0:13:00.02,Default,,0,0,0,,Tôi cứ thắc mắc trăn trở mãi bao lâu nay...\Nhóa ra nó chỉ đơn giản là cái xẻng lật thức ăn thôi đấy.
Dialogue: 0,0:13:01.09,0:13:05.13,Default,,0,0,0,,Sao lòng cháu lại nặng trĩu thế này không biết?
Dialogue: 0,0:13:13.84,0:13:16.01,Default,,0,0,0,,Cô ấy đã nói rõ là mình có bạn trai rồi mà.
Dialogue: 0,0:13:18.90,0:13:21.39,Default,,0,0,0,,Nếu trong lòng cảm thấy đau đớn, giằng xé như thế...
Dialogue: 0,0:13:25.34,0:13:27.38,Default,,0,0,0,,...thì tại sao cháu không thẳng thắn giãi bày lòng mình với cô ấy?
Dialogue: 0,0:13:27.93,0:13:30.90,Default,,0,0,0,,Đúng là cháu rất thích cô ấy...\Ncháu si mê cô ấy đến phát điên lên được.
Dialogue: 0,0:13:31.56,0:13:35.96,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:13:37.99,0:13:40.16,Default,,0,0,0,,Nếu cháu cứ trốn tránh và ngập ngừng do dự mãi như thế...
Dialogue: 0,0:13:42.22,0:13:44.42,Default,,0,0,0,,...thì đó mới là điều bất kính và thiếu tôn trọng\Nnhất đối với Ikumi-chan đấy.
Dialogue: 0,0:13:47.65,0:13:49.92,Default,,0,0,0,,{\i1}Thế rồi hai tháng nữa lại êm đềm trôi qua...{\i0}
Dialogue: 0,0:13:58.88,0:14:02.39,Default,,0,0,0,,Ông chủ.
Dialogue: 0,0:14:03.51,0:14:05.61,Default,,0,0,0,,Kìa em.
Dialogue: 0,0:14:05.61,0:14:07.31,Default,,0,0,0,,Đang giờ làm việc không được lười biếng đâu đấy nhé.
Dialogue: 0,0:14:07.99,0:14:10.19,Default,,0,0,0,,Em xin lỗi...\NEm chỉ tranh thủ nghỉ giải lao chút thôi mà.
Dialogue: 0,0:14:11.19,0:14:14.02,Default,,0,0,0,,- Sắp xong xuôi hết cả rồi đúng không em?\N- Dạ vâng ạ.
Dialogue: 0,0:14:25.07,0:14:30.37,Default,,0,0,0,,Mừng cho em nhé.\NCuối cùng em cũng sắp được tự do giải thoát rồi.
Dialogue: 0,0:14:31.13,0:14:35.41,Default,,0,0,0,,Thế nhưng trong lòng em lại thấy bất an, trống trải quá.
Dialogue: 0,0:14:39.34,0:14:42.51,Default,,0,0,0,,Bao năm qua em cắn răng làm công việc này...
Dialogue: 0,0:14:45.90,0:14:47.72,Default,,0,0,0,,...cũng chỉ để gom góp trả nốt món nợ khổng lồ của cha mẹ.
Dialogue: 0,0:14:47.81,0:14:51.10,Default,,0,0,0,,Nó đã tước đoạt và giam cầm em khỏi biết bao nhiêu ước mơ.
Dialogue: 0,0:14:52.08,0:14:55.11,Default,,0,0,0,,Dẫu sao thì...\Nchuỗi ngày tăm tối ấy cũng sắp khép lại rồi.
Dialogue: 0,0:14:56.96,0:15:00.97,Default,,0,0,0,,Giờ đây em có thể tự do làm bất cứ điều gì mình hằng mong muốn.
Dialogue: 0,0:15:02.39,0:15:04.76,Default,,0,0,0,,Thế nhưng em cứ tự hỏi liệu mình có còn cơ hội\Nđược trở lại làm một cô gái bình thường như xưa nữa hay không...
Dialogue: 0,0:15:09.29,0:15:11.35,Default,,0,0,0,,Thôi nào... cứ thong thả mà suy nghĩ cho thấu đáo.
Dialogue: 0,0:15:17.53,0:15:21.79,Default,,0,0,0,,Đến ngày em chính thức hoàn lương giải nghệ,\Nquán chúng ta sẽ mở tiệc chúc mừng thật linh đình.
Dialogue: 0,0:15:24.63,0:15:27.66,Default,,0,0,0,,Coi như đó là món quà tốt nghiệp dành tặng cho em.
Dialogue: 0,0:15:29.51,0:15:31.94,Default,,0,0,0,,Em cảm ơn ông chủ nhiều lắm.
Dialogue: 0,0:15:34.55,0:15:36.57,Default,,0,0,0,,- Quản lý ơi, cho em ra ngoài nghe điện thoại một lát được không ạ?\N- Ừ, cứ tự nhiên đi em.
Dialogue: 0,0:15:53.30,0:15:55.34,Default,,0,0,0,,A lô... vâng, em nghe đây.
Dialogue: 0,0:15:57.51,0:16:00.71,Default,,0,0,0,,~ Anata no kokoro wa ano yama no yuki no yo ni ~\N*Trái tim người tựa như đỉnh núi phủ đầy tuyết trắng*
Dialogue: 0,0:16:15.47,0:16:26.79,Default,,0,0,0,,~ Fukaku tsumori tozasa rete iru no deshou ~\N*Phải chăng bao nỗi niềm sâu kín đều bị vùi lấp dưới lớp tuyết dày?*
Dialogue: 0,0:16:31.87,0:16:44.43,Default,,0,0,0,,~ Setsunai omoi wa ano yama ni ~\N*Những nỗi niềm đau đáu xót xa giấu kín*
Dialogue: 0,0:16:49.33,0:16:54.29,Default,,0,0,0,,~ Kiite moraeba iikara ~\N*Hãy gửi gắm cho ngọn núi cao thấu tỏ giùm người*
Dialogue: 0,0:16:55.47,0:17:00.39,Default,,0,0,0,,~ Itoshii kimochi wa ano tsuki ni ~\N*Còn tình cảm yêu thương tha thiết nồng nàn*
Dialogue: 0,0:17:02.17,0:17:08.29,Default,,0,0,0,,~ Uta tte kika sereba iikara ~\N*Xin hãy cất cao tiếng hát gửi tới vầng trăng sáng*
Dialogue: 0,0:17:09.25,0:17:14.51,Default,,0,0,0,,~ Nakanaide ~\N*Xin người đừng khóc nữa*
Dialogue: 0,0:17:19.29,0:17:22.89,Default,,0,0,0,,Ông chủ.
Dialogue: 0,0:18:00.40,0:18:02.30,Default,,0,0,0,,Ô, chào cậu.\NDạo gần đây chẳng thấy cậu ghé quán nữa nhỉ.
Dialogue: 0,0:18:03.43,0:18:07.97,Default,,0,0,0,,Cậu sắp sửa về quê rồi đấy à?
Dialogue: 0,0:18:18.42,0:18:19.89,Default,,0,0,0,,Mẹ cháu vừa trải qua một cơn nhồi máu cơ tim.
Dialogue: 0,0:18:19.91,0:18:23.07,Default,,0,0,0,,Tuy bà cụ đã qua cơn nguy kịch và dần hồi phục...
Dialogue: 0,0:18:25.99,0:18:28.43,Default,,0,0,0,,...thế nhưng sức khỏe bà ấy không thể nào\Nmột mình quán xuyến nổi cái quán ăn gia đình ở quê được nữa.
Dialogue: 0,0:18:29.59,0:18:32.12,Default,,0,0,0,,Nên cháu đã quyết định sẽ về tiếp quản lại quán ăn của mẹ.
Dialogue: 0,0:18:36.12,0:18:38.26,Default,,0,0,0,,Trưa mai cháu sẽ bắt chuyến tàu shinkansen về quê rồi.
Dialogue: 0,0:18:38.97,0:18:41.28,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:18:42.37,0:18:44.07,Default,,0,0,0,,Đêm nay chú cho cháu ngồi ở quán tới sáng mai được không ạ?
Dialogue: 0,0:18:44.57,0:18:47.53,Default,,0,0,0,,Được chứ, đêm nay cậu muốn uống bao nhiêu tôi cũng chiều.
Dialogue: 0,0:18:48.44,0:18:51.34,Default,,0,0,0,,Cháu cảm ơn ông chủ nhiều lắm ạ.
Dialogue: 0,0:18:51.51,0:18:53.87,Default,,0,0,0,,- Chào buổi tối cả nhà.\N- Mừng cô ghé quán.
Dialogue: 0,0:19:00.46,0:19:02.58,Default,,0,0,0,,Masashi-san, lâu lắm rồi không gặp anh nhỉ.
Dialogue: 0,0:19:03.95,0:19:05.97,Default,,0,0,0,,Chào cô, tôi cũng thế.
Dialogue: 0,0:19:06.16,0:19:08.03,Default,,0,0,0,,Ông chủ ơi, chúng ta mở tiệc ăn mừng thôi nào.
Dialogue: 0,0:19:13.08,0:19:16.16,Default,,0,0,0,,Mọi chuyện đã kết thúc êm đẹp cả rồi.
Dialogue: 0,0:19:17.68,0:19:19.91,Default,,0,0,0,,Thế cơ à... chúc mừng em nhé.
Dialogue: 0,0:19:20.43,0:19:22.82,Default,,0,0,0,,Hai người đang ăn mừng chuyện gì vui thế ạ?
Dialogue: 0,0:19:24.09,0:19:26.54,Default,,0,0,0,,À, thì là...\Ntôi vừa mới chính thức chia tay bạn trai xong.
Dialogue: 0,0:19:27.36,0:19:32.19,Default,,0,0,0,,Tôi hiểu rồi... tuyệt vời quá.
Dialogue: 0,0:19:35.60,0:19:38.38,Default,,0,0,0,,Ông chủ ơi, cho cháu thêm một ly bia nữa nhé.
Dialogue: 0,0:19:45.67,0:19:48.00,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:19:48.29,0:19:50.31,Default,,0,0,0,,Ikumi-san này...
Dialogue: 0,0:20:02.67,0:20:04.69,Default,,0,0,0,,À thì...
Dialogue: 0,0:20:05.98,0:20:07.79,Default,,0,0,0,,Trưa mai tôi phải về quê rồi.
Dialogue: 0,0:20:08.68,0:20:12.45,Default,,0,0,0,,Và tôi sẽ không bao giờ quay lại Tokyo sinh sống nữa đâu.
Dialogue: 0,0:20:13.77,0:20:16.06,Default,,0,0,0,,Thế nhưng...
Dialogue: 0,0:20:17.06,0:20:17.93,Default,,0,0,0,,Liệu cô có bằng lòng... cùng về quê sinh sống và làm việc bên cạnh tôi không?
Dialogue: 0,0:20:20.14,0:20:23.60,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:20:28.14,0:20:29.92,Default,,0,0,0,,Chẳng phải cô vừa mới chia tay với... "bạn trai" rồi sao?
Dialogue: 0,0:20:31.61,0:20:35.10,Default,,0,0,0,,{\i1}Thế rồi một năm sau đó...{\i0}
Dialogue: 0,0:21:07.99,0:21:10.44,Default,,0,0,0,,- Cậu ấy nghe theo lời khuyên của tôi đấy nhé.\N- Lời khuyên gì cơ?
Dialogue: 0,0:21:11.35,0:21:15.28,Default,,0,0,0,,Trông hai đứa mặc bộ đồ "samue" của thợ bếp nom chững chạc, bảnh bao ghê nhỉ.
Dialogue: 0,0:21:15.28,0:21:18.00,Default,,0,0,0,,"Tụi con xin phép được đặt tên quán ăn ở quê là chi nhánh không chính thức của Quán Ăn Đêm."
Dialogue: 0,0:21:19.66,0:21:23.97,Default,,0,0,0,,Ông chủ cũng đọc thư của tụi nó đi này.
Dialogue: 0,0:21:24.74,0:21:27.02,Default,,0,0,0,,{\i1}Khoảnh khắc đó quả thực có thể ví như\N"thời khắc định mệnh đẹp nhất" trong cuộc đời của một con người.{\i0}
Dialogue: 0,0:21:31.06,0:21:33.74,Default,,0,0,0,,{\i1}Chỉ cần đúng người và đúng thời điểm...{\i0}
Dialogue: 0,0:21:35.56,0:21:37.64,Default,,0,0,0,,{\i1}...thì mọi điều kỳ diệu trên đời đều có thể xảy ra.{\i0}
Dialogue: 0,0:21:38.02,0:21:40.04,Default,,0,0,0,,Khi chế biến cá tươi,\Nphải sơ chế thật cẩn thận và kỹ lưỡng từ trước.
Dialogue: 0,0:21:45.05,0:21:48.48,Default,,0,0,0,,Chần sơ cá qua nước sôi một lát,\Nrồi vớt ra thả ngay vào thau nước đá lạnh.
Dialogue: 0,0:21:49.33,0:21:51.73,Default,,0,0,0,,Làm sạch nhớt và cạo sạch vảy để khử hết mùi tanh nồng...\NSau đó bạn sẽ nấu được một nồi nước dùng thanh ngọt tuyệt hảo.
Dialogue: 0,0:21:51.73,0:21:56.13,Default,,0,0,0,,Đến ngày hôm sau, phần nước dùng nguội đi sẽ tự động đông đặc lại.
Dialogue: 0,0:21:57.30,0:21:59.73,Default,,0,0,0,,Thế là các bạn đã có ngay một đĩa thạch cá đông nikogori thơm ngon chuẩn vị rồi.
Dialogue: 0,0:21:59.98,0:22:01.95,Default,,0,0,0,,Xin mời cô nếm thử xem nào.
Dialogue: 0,0:22:04.54,0:22:06.42,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:22:12.39,0:22:13.70,Default,,0,0,0,,Tạ ơn trời phật, ngon quá.
Dialogue: 0,0:22:13.83,0:22:15.23,Default,,0,0,0,,Vậy thì...\Nchúc mọi người ngủ ngon nhé.
Dialogue: 0,0:22:15.26,0:22:17.29,Default,,0,0,0,,Vậy thì...\Nchúc mọi người ngủ ngon nhé.
Dialogue: 0,0:22:18.95,0:22:25.55,Default,,0,0,0,,~ Yarusenai yuhi yori ~N*Hơn cả ánh hoàng hôn buồn bã hiu hắt*
Dialogue: 0,0:22:19.25,0:22:23.55,Default,,0,0,0,,{\i1}Còn tiếp...{\i0}
Dialogue: 0,0:22:25.75,0:22:32.57,Default,,0,0,0,,~ Shinji reru asahi o mitai ~N*Em khát khao nhìn thấy ánh bình minh để vững tin*
