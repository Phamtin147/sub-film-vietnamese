Dialogue: 0,0:00:06.36,0:00:10.86,Default,,0,0,0,,Biên dịch và căn chỉnh thời gian:\NAmtia(NOFACE)
Dialogue: 0,0:00:10.86,0:00:14.86,Default,,0,0,0,,Cảm ơn bản raw và phụ đề gốc:\Nyyets.com và \( -o _ o- )/
Dialogue: 0,0:00:26.16,0:00:31.53,Default,,0,0,0,,~ Kimi ga haita shiroi iki ga ~\N*Làn khói trắng em khẽ thở ra*
Dialogue: 0,0:00:31.53,0:00:35.39,Default,,0,0,0,,~ Ima yukkuri kaze ni notte ~\N*Giờ chầm chậm nương theo làn gió*
Dialogue: 0,0:00:36.27,0:00:41.39,Default,,0,0,0,,~ Sora ni ukabu kumo no naka ni ~\N*Hòa vào những đám mây trôi trên bầu trời*
Dialogue: 0,0:00:41.39,0:00:46.38,Default,,0,0,0,,~ Sukoshi zutsu kiete yuku ~\N*Rồi cứ thế tan biến dần đi*
Dialogue: 0,0:00:46.59,0:00:51.68,Default,,0,0,0,,~ Toku takai sora no naka de ~\N*Giữa bầu trời cao vời vợi xa xăm*
Dialogue: 0,0:00:51.68,0:00:56.11,Default,,0,0,0,,~ Te o nobasu shiroi kumo ~\N*Đám mây trắng vươn bàn tay xuống*
Dialogue: 0,0:00:56.58,0:00:57.78,Default,,0,0,0,,~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:57.78,0:00:59.23,Default,,0,0,0,,Khi một ngày khép lại...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:59.23,0:00:59.76,Default,,0,0,0,,~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:00:59.76,0:01:01.84,Default,,0,0,0,,Khi người ta vội vã trở về nhà...\N~ Kimi ga haita iki o sutte ~\N*Hít lấy hơi thở của em*
Dialogue: 0,0:01:01.84,0:01:02.39,Default,,0,0,0,,Khi người ta vội vã trở về nhà...\N~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:02.39,0:01:03.48,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:03.48,0:01:05.32,Default,,0,0,0,,Thì ngày mới của tôi mới bắt đầu.\N~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:05.32,0:01:05.74,Default,,0,0,0,,~ Pokkari to ukan deru ~\N*Rồi lại lững lờ trôi đi*
Dialogue: 0,0:01:07.64,0:01:16.93,Default,,0,0,0,,~ Zutto mukashi no koto no yoda ne ~\N*Ngỡ như chuyện của thuở xa xưa lắm rồi*
Dialogue: 0,0:01:17.66,0:01:22.38,Default,,0,0,0,,~ Kawamo no ue o kumo ga nagareru ~\N*Mây lững lờ trôi trên mặt sông êm đềm*
Dialogue: 0,0:01:22.68,0:01:26.65,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm đến bảy giờ sáng.\N~ Kawamo no ue o kumo ga nagareru ~\N*Mây lững lờ trôi trên mặt sông êm đềm*
Dialogue: 0,0:01:28.04,0:01:31.66,Default,,0,0,0,,Người ta thường gọi nó là 'Quán Ăn Đêm'.
Dialogue: 0,0:01:36.00,0:01:37.40,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:38.37,0:01:40.22,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:42.72,0:01:47.72,Default,,0,0,0,,~ SHINYA SHOKUDO (Phần 2) ~\N'Quán Ăn Đêm'
Dialogue: 0,0:01:52.32,0:01:57.32,Default,,0,0,0,,Câu chuyện thứ 16 (Tập 6):\N"Súp kem hầm"
Dialogue: 0,0:02:32.05,0:02:34.19,Default,,0,0,0,,{\i1}Hôm nay, tôi nấu món súp kem hầm.{\i0}
Dialogue: 0,0:02:35.31,0:02:37.41,Default,,0,0,0,,{\i1}Làm cái nghề này đã lâu năm...{\i0}
Dialogue: 0,0:02:37.83,0:02:40.75,Default,,0,0,0,,{\i1}...chẳng biết từ bao giờ, tôi lại có được\Ncái trực giác nhạy bén với nó.{\i0}
Dialogue: 0,0:02:45.50,0:02:47.54,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:02:48.91,0:02:51.24,Default,,0,0,0,,Ông chủ ơi, chú có làm món súp kem hầm được không ạ?
Dialogue: 0,0:02:52.29,0:02:54.18,Default,,0,0,0,,Tôi đang nấu ngay đây.
Dialogue: 0,0:02:54.25,0:02:56.34,Default,,0,0,0,,Đúng lúc thật đấy.
Dialogue: 0,0:02:57.83,0:02:59.89,Default,,0,0,0,,Trời bắt đầu trở lạnh rồi nhỉ!
Dialogue: 0,0:03:19.11,0:03:20.14,Default,,0,0,0,,{\i1}Giống như việc tôi biết chắc rằng...{\i0}
Dialogue: 0,0:03:20.79,0:03:22.94,Default,,0,0,0,,{\i1}...chẳng mấy chốc nữa, khi khách khứa bước vào quán...{\i0}
Dialogue: 0,0:03:23.01,0:03:25.63,Default,,0,0,0,,{\i1}...ai nấy đều sẽ hỏi gọi\Nmón súp kem hầm vậy.{\i0}
Dialogue: 0,0:03:34.25,0:03:36.50,Default,,0,0,0,,Chào.\NMời vào.
Dialogue: 0,0:03:37.02,0:03:39.40,Default,,0,0,0,,- Cho một bình sake hâm nóng nhé.\N- Có ngay đây.
Dialogue: 0,0:03:41.07,0:03:43.96,Default,,0,0,0,,- Ông chủ.\N- Các vị cũng muốn ăn món đó hả?
Dialogue: 0,0:03:44.30,0:03:46.88,Default,,0,0,0,,Cho em một phần với nhé ạ?
Dialogue: 0,0:03:46.90,0:03:48.99,Default,,0,0,0,,Trong nồi chỉ còn đủ cho hai phần thôi.
Dialogue: 0,0:03:49.57,0:03:53.57,Default,,0,0,0,,- Anh Suzuki, anh có ăn không?\N- Tôi... ừm...
Dialogue: 0,0:03:53.58,0:03:55.59,Default,,0,0,0,,Thôi, cảm ơn nhé.
Dialogue: 0,0:04:00.29,0:04:03.13,Default,,0,0,0,,Anh đâu cần phải xé nó đi chứ.
Dialogue: 0,0:04:04.26,0:04:08.18,Default,,0,0,0,,- Này... Vứt đống này đi giùm tôi.\N- Anh chắc chứ?
Dialogue: 0,0:04:08.63,0:04:11.72,Default,,0,0,0,,Cậu Nagata đây đã bảo là\Nsẽ không xuất bản nó rồi...
Dialogue: 0,0:04:11.72,0:04:13.71,Default,,0,0,0,,...thế thì đống này cũng chỉ là\Ngiấy lộn mà thôi.
Dialogue: 0,0:04:13.79,0:04:15.82,Default,,0,0,0,,Cả xấp này nữa.
Dialogue: 0,0:04:15.84,0:04:18.22,Default,,0,0,0,,Em chỉ bảo anh viết lại thôi mà.
Dialogue: 0,0:04:19.04,0:04:22.47,Default,,0,0,0,,Bối cảnh lấy một gã vô gia cư làm\Nnhân vật chính đã quá lỗi thời rồi.
Dialogue: 0,0:04:23.85,0:04:26.92,Default,,0,0,0,,Tôi lại thấy rất sâu sắc đấy chứ.\NĐối với tôi...
Dialogue: 0,0:04:27.59,0:04:30.07,Default,,0,0,0,,...tác phẩm đó thế là\Nđã hoàn chỉnh rồi.
Dialogue: 0,0:04:31.38,0:04:33.81,Default,,0,0,0,,Thôi thì anh đừng trách em nhé.
Dialogue: 0,0:04:34.69,0:04:37.56,Default,,0,0,0,,Em cần uống một ly.\NCho em một ly Highball nhé!
Dialogue: 0,0:04:37.69,0:04:38.96,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:04:39.05,0:04:42.76,Default,,0,0,0,,Anh rõ ràng có một mái ấm đàng hoàng...\Nchỉ là anh không muốn quay về đó mà thôi.
Dialogue: 0,0:04:43.42,0:04:45.95,Default,,0,0,0,,Người vô gia cư là những người\Nthực sự không có nhà để về kìa.
Dialogue: 0,0:04:46.40,0:04:50.90,Default,,0,0,0,,Người ta chẳng thường nói: 'Hạnh phúc gia đình\Nlà cội nguồn của mọi tội lỗi' đó sao.\N[Trích lời nhà văn Dazai Osamu]
Dialogue: 0,0:04:52.92,0:04:56.07,Default,,0,0,0,,Anh Suzuki à, hãy viết tiểu thuyết như Dazai đi.
Dialogue: 0,0:04:56.57,0:05:00.17,Default,,0,0,0,,Thị trường vẫn còn chỗ đứng cho dòng "Tiểu thuyết Tự thuật" đấy.\N(tiểu thuyết văn học viết theo ngôi thứ nhất)
Dialogue: 0,0:05:00.22,0:05:03.50,Default,,0,0,0,,Cũng có người từng nói: "Dẫu có cha mẹ,\Ncon trẻ vẫn cứ lớn khôn."\N(Trích lời nhà văn Sakaguchi Ango)
Dialogue: 0,0:05:04.38,0:05:07.02,Default,,0,0,0,,Dạo gần đây có biết bao vụ việc\Ncha mẹ sát hại chính con ruột của mình.
Dialogue: 0,0:05:08.09,0:05:10.78,Default,,0,0,0,,Kỳ lạ thay, đôi khi những đứa trẻ\Nkhông có cha mẹ lại tốt hơn.
Dialogue: 0,0:05:10.86,0:05:14.86,Default,,0,0,0,,Thế nên người ta mới có câu... 'Không có cha mẹ,\Ncon trẻ vẫn tự khắc lớn khôn.'*\N[*Ngạn ngữ Nhật Bản]
Dialogue: 0,0:05:21.96,0:05:24.06,Default,,0,0,0,,Đó là con gái anh à?
Dialogue: 0,0:05:24.66,0:05:27.08,Default,,0,0,0,,Thi thoảng vợ tôi lại gửi\Nảnh con bé cho tôi.
Dialogue: 0,0:05:27.62,0:05:30.09,Default,,0,0,0,,- Cho em xem kỹ hơn một chút được không?\N- Để quý khách đợi lâu rồi.
Dialogue: 0,0:05:39.50,0:05:44.27,Default,,0,0,0,,- Sao anh không quay về nhà đi?\N- Hả? Tôi đã bỏ lỡ\Ncơ hội để quay về từ lâu rồi.
Dialogue: 0,0:05:44.31,0:05:48.72,Default,,0,0,0,,Cho tôi xin điếu thuốc luôn nhé.\NHồi đầu, cứ hai ngày tôi lại về nhà một lần.
Dialogue: 0,0:05:50.05,0:05:52.89,Default,,0,0,0,,Dần dà, rút xuống chỉ còn mỗi dịp cuối tuần.
Dialogue: 0,0:05:54.42,0:05:57.06,Default,,0,0,0,,Rồi cuối cùng, mỗi tháng chỉ về một bận vào cuối tháng.
Dialogue: 0,0:05:58.00,0:06:00.50,Default,,0,0,0,,Đến lúc nhận ra thì tôi đã chẳng còn bước chân về nhà nữa.
Dialogue: 0,0:06:01.38,0:06:03.46,Default,,0,0,0,,Thoắt cái đã mười năm trôi qua mất rồi.
Dialogue: 0,0:06:04.38,0:06:07.16,Default,,0,0,0,,Vậy nghĩa là con gái anh\Ngiờ đã học đại học rồi nhỉ?
Dialogue: 0,0:06:09.10,0:06:11.33,Default,,0,0,0,,Thế mới bảo không có cha mẹ\Nthì con trẻ vẫn cứ lớn khôn.
Dialogue: 0,0:06:11.80,0:06:14.59,Default,,0,0,0,,Ừ thì đúng thế, nhưng chẳng phải một tay vợ anh\Nđã tần tảo nuôi con bé khôn lớn hay sao?
Dialogue: 0,0:06:14.59,0:06:16.61,Default,,0,0,0,,Thật tình chứ.
Dialogue: 0,0:06:19.34,0:06:22.94,Default,,0,0,0,,- Cẩn thận đấy nhé.\N- Nào... một, hai, ba.
Dialogue: 0,0:06:26.81,0:06:28.91,Default,,0,0,0,,Chào cả nhà!
Dialogue: 0,0:06:28.99,0:06:30.86,Default,,0,0,0,,- Chào buổi tối!\N- Xin chào.
Dialogue: 0,0:06:30.86,0:06:34.25,Default,,0,0,0,,- Bé Hana đấy à!\N- Lâu quá không gặp mọi người!
Dialogue: 0,0:06:35.31,0:06:38.99,Default,,0,0,0,,- Hương thơm này có phải là súp kem hầm không ạ?\N- Đúng rồi đấy.
Dialogue: 0,0:06:39.04,0:06:41.21,Default,,0,0,0,,- Vẫn còn vừa đủ một phần cuối cùng.\N- Ôi may quá đi mất!
Dialogue: 0,0:06:41.27,0:06:43.32,Default,,0,0,0,,May cho cô là nãy có một vị khách\Nkhông gọi món này đấy.
Dialogue: 0,0:06:43.95,0:06:46.46,Default,,0,0,0,,- Chú Hoko không ăn thật ạ?\N- Ừ, cháu cứ ăn đi, Hana.
Dialogue: 0,0:06:47.20,0:06:49.74,Default,,0,0,0,,- Ông chủ, cho tôi một phần súp miso thịt heo với bia nhé.\N- Có ngay đây.
Dialogue: 0,0:06:58.37,0:07:00.47,Default,,0,0,0,,Ngon quá đi mất!
Dialogue: 0,0:07:00.81,0:07:02.90,Default,,0,0,0,,Cô thấy hợp miệng là tốt rồi.
Dialogue: 0,0:07:03.55,0:07:05.63,Default,,0,0,0,,Ông chủ dùng viên súp kem đóng hộp phải không ạ?
Dialogue: 0,0:07:08.40,0:07:10.38,Default,,0,0,0,,Nhưng tôi có cho thêm chút bơ vào đấy.
Dialogue: 0,0:07:10.78,0:07:12.83,Default,,0,0,0,,...rồi rắc thêm cả\Nđậu Hà Lan lên trên nữa.
Dialogue: 0,0:07:14.53,0:07:17.08,Default,,0,0,0,,Hồi em còn học tiểu học,\Nvào mùa đông năm ấy...
Dialogue: 0,0:07:17.95,0:07:21.53,Default,,0,0,0,,...cậu bạn em thích có rủ em qua nhà\Ncùng làm bài tập về nhà...
Dialogue: 0,0:07:22.89,0:07:25.73,Default,,0,0,0,,...Hôm đó em ở lại ăn tối và\Nđược ăn món súp kem hầm.
Dialogue: 0,0:07:26.91,0:07:29.01,Default,,0,0,0,,Ngay khoảnh khắc ấy, em đã thầm nghĩ...
Dialogue: 0,0:07:29.18,0:07:32.09,Default,,0,0,0,,..."Mình không thể làm cô dâu của cậu ấy được rồi."
Dialogue: 0,0:07:35.39,0:07:38.21,Default,,0,0,0,,Mẹ em ở nhà lúc nào cũng nấu món này\Nbằng viên súp đóng hộp làm sẵn.
Dialogue: 0,0:07:39.35,0:07:42.00,Default,,0,0,0,,Chứ nếu tự xào bằng bột mì thì không bị vón cục...
Dialogue: 0,0:07:42.39,0:07:44.45,Default,,0,0,0,,...cũng dễ bị cháy khét lắm.
Dialogue: 0,0:07:45.26,0:07:49.91,Default,,0,0,0,,Bởi vậy nên trong tâm trí em,\Nđây mới chính là hương vị chuẩn của món súp kem hầm.
Dialogue: 0,0:07:52.52,0:07:54.57,Default,,0,0,0,,Sao thế, Hana?
Dialogue: 0,0:07:55.45,0:07:56.97,Default,,0,0,0,,Ồ, cháu xin lỗi!
Dialogue: 0,0:07:56.97,0:07:59.14,Default,,0,0,0,,Chỉ tại đã lâu lắm rồi\Ncháu mới lại được ăn món này.
Dialogue: 0,0:07:59.55,0:08:03.07,Default,,0,0,0,,Cháu chợt nhớ về những ngày xưa,\Nkhi cả nhà quây quần bên nồi súp kem hầm mẹ nấu.
Dialogue: 0,0:08:24.94,0:08:26.85,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:08:26.85,0:08:28.87,Default,,0,0,0,,Bên mình có thể điều một em qua chỗ tôi được không?
Dialogue: 0,0:08:31.32,0:08:33.99,Default,,0,0,0,,Cho tôi gọi bé Kaede nhé?
Dialogue: 0,0:08:35.68,0:08:38.81,Default,,0,0,0,,Tôi là Suzuki, mã số hội viên 5432.
Dialogue: 0,0:09:02.26,0:09:04.30,Default,,0,0,0,,Trời sáng rồi cơ à?
Dialogue: 0,0:09:04.46,0:09:06.54,Default,,0,0,0,,Cháu làm chú thức giấc hả?
Dialogue: 0,0:09:09.14,0:09:11.43,Default,,0,0,0,,Cháu phải thay đồ để đến trường nữa.
Dialogue: 0,0:09:11.53,0:09:13.85,Default,,0,0,0,,Cháu làm việc như thế không thấy quá sức sao?
Dialogue: 0,0:09:23.87,0:09:25.82,Default,,0,0,0,,Ngon thật đấy.
Dialogue: 0,0:09:25.92,0:09:28.15,Default,,0,0,0,,Một tách trà xanh rang\Nvào buổi sớm mai.
Dialogue: 0,0:09:28.91,0:09:31.11,Default,,0,0,0,,Thơm ngon lắm phải không?
Dialogue: 0,0:09:40.15,0:09:43.04,Default,,0,0,0,,Người ta bảo rằng nếu ai có thể nắm trọn được\Nnốt ruồi trong lòng bàn tay mình...
Dialogue: 0,0:09:43.58,0:09:45.99,Default,,0,0,0,,...thì người đó sẽ chạm được vào hạnh phúc.
Dialogue: 0,0:09:47.66,0:09:49.85,Default,,0,0,0,,Hình như...
Dialogue: 0,0:09:49.94,0:09:52.61,Default,,0,0,0,,...chú cũng từng nghe nói thế ở đâu đó rồi.
Dialogue: 0,0:09:53.69,0:09:55.97,Default,,0,0,0,,Có nốt ruồi trong lòng bàn tay vốn là chuyện hiếm gặp lắm nhỉ?
Dialogue: 0,0:09:57.34,0:09:59.11,Default,,0,0,0,,Nhưng chú biết không...
Dialogue: 0,0:09:59.16,0:10:01.50,Default,,0,0,0,,Cháu không tài nào nắm lấy nó được.
Dialogue: 0,0:10:05.48,0:10:07.72,Default,,0,0,0,,Hồi còn bé xíu, cháu vẫn nắm trọn được nó...
Dialogue: 0,0:10:10.51,0:10:12.73,Default,,0,0,0,,Thế nhưng, kể từ ngày bố bỏ mẹ con cháu mà đi...
Dialogue: 0,0:10:13.25,0:10:15.47,Default,,0,0,0,,...cháu chẳng thể nào nắm chạm vào nó được nữa.
Dialogue: 0,0:10:30.88,0:10:35.39,Default,,0,0,0,,"Tyltyl và Mytyl* cũng đâu có cha mẹ bên cạnh."\N(Trích anime thập niên 80: 'Con Chim Xanh của Maeterlinck')
Dialogue: 0,0:10:35.72,0:10:38.09,Default,,0,0,0,,"Từ đôi bàn tay nhỏ bé ấy, chú chim xanh\Nmang tên hạnh phúc đã vỗ cánh bay đi."
Dialogue: 0,0:10:39.18,0:10:41.72,Default,,0,0,0,,"Dẫu mong manh khó nắm bắt,\Nhọ vẫn ôm chặt lấy những giấc mơ."
Dialogue: 0,0:10:47.04,0:10:49.21,Default,,0,0,0,,Đừng có xem thường cuộc đời này nhé.
Dialogue: 0,0:10:58.11,0:11:00.16,Default,,0,0,0,,Đó là con gái anh à?
Dialogue: 0,0:11:00.81,0:11:03.20,Default,,0,0,0,,Con bé xinh xắn quá nhỉ?
Dialogue: 0,0:11:05.26,0:11:07.19,Default,,0,0,0,,Tôi không biết lát nữa anh có định đi tăng hai\Nở quán nào khác nữa không.
Dialogue: 0,0:11:07.23,0:11:09.74,Default,,0,0,0,,Nhưng ở quán của tôi thì đây sẽ là\Nchung rượu sake cuối cùng của anh đêm nay đấy.
Dialogue: 0,0:11:15.30,0:11:17.30,Default,,0,0,0,,Tên con bé là Sumire.
Dialogue: 0,0:11:20.29,0:11:22.35,Default,,0,0,0,,Giống hệt mẹ nó, đúng không?
Dialogue: 0,0:11:38.55,0:11:40.60,Default,,0,0,0,,Tôi xin phép về trước nhé.
Dialogue: 0,0:11:51.81,0:11:53.87,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:11:53.93,0:11:56.54,Default,,0,0,0,,Phải đúng 12 giờ đêm quán mới mở cửa.
Dialogue: 0,0:12:00.44,0:12:02.46,Default,,0,0,0,,Sao hôm nay lại diện bộ đồ này thế?
Dialogue: 0,0:12:03.27,0:12:05.36,Default,,0,0,0,,Đồ công sở cho chỗ làm tương lai của cháu đấy ạ...
Dialogue: 0,0:12:05.44,0:12:08.64,Default,,0,0,0,,- Hôm nay cháu đã nhận được thông báo trúng tuyển nội bộ rồi!\N- Chà, chúc mừng cô nhé.
Dialogue: 0,0:12:09.01,0:12:11.10,Default,,0,0,0,,Chúc cô làm việc thuận buồm xuôi gió.
Dialogue: 0,0:12:12.04,0:12:14.06,Default,,0,0,0,,Cháu sắp được 'tốt nghiệp' khỏi quán rượu tiếp viên rồi.
Dialogue: 0,0:12:14.27,0:12:16.75,Default,,0,0,0,,Sang năm cháu cũng sẽ\Ntốt nghiệp đại học luôn.
Dialogue: 0,0:12:17.88,0:12:20.83,Default,,0,0,0,,Cháu còn phải hoàn thành mấy bài báo cáo để mai nộp nữa.\NChào chú cháu đi nhé!
Dialogue: 0,0:12:32.09,0:12:34.94,Default,,0,0,0,,{\i1}Có lẽ bởi vì con bé chẳng thể\Nnắm giữ được nốt ruồi trong lòng bàn tay mình...{\i0}
Dialogue: 0,0:12:35.49,0:12:37.62,Default,,0,0,0,,{\i1}Nên rốt cuộc con bé đã bị hủy kết quả tuyển dụng...{\i0}
Dialogue: 0,0:12:37.77,0:12:40.70,Default,,0,0,0,,{\i1}...sau khi công ty phát hiện ra chuyện\NHana đi làm tiếp viên quán rượu.{\i0}
Dialogue: 0,0:12:59.24,0:13:01.37,Default,,0,0,0,,Chào buổi tối, em được gọi đến\Ntừ câu lạc bộ Milky ạ.
Dialogue: 0,0:13:01.37,0:13:03.37,Default,,0,0,0,,Ờ, tôi vừa mới tắm xong.
Dialogue: 0,0:13:03.37,0:13:05.75,Default,,0,0,0,,Đợi tôi một lát nhé?
Dialogue: 0,0:13:08.47,0:13:10.56,Default,,0,0,0,,Xin phép làm phiền anh ạ.
Dialogue: 0,0:13:15.79,0:13:18.72,Default,,0,0,0,,- Anh vui lòng thanh toán trước giúp em được không ạ?\N- Ờ, tôi biết rồi.
Dialogue: 0,0:13:28.14,0:13:30.87,Default,,0,0,0,,Mà này, em có uống cà phê không?
Dialogue: 0,0:13:33.50,0:13:36.16,Default,,0,0,0,,Tôi có sẵn hạt cà phê trồng theo phương pháp hữu cơ đây.
Dialogue: 0,0:13:37.00,0:13:38.89,Default,,0,0,0,,Thơm ngon lắm đấy.
Dialogue: 0,0:13:38.92,0:13:41.10,Default,,0,0,0,,Loại rang thủ công tại nhà hẳn hoi.
Dialogue: 0,0:13:41.26,0:13:43.52,Default,,0,0,0,,Nói thế thôi chứ cũng chẳng phải tự tay tôi rang đâu.
Dialogue: 0,0:13:44.61,0:13:46.94,Default,,0,0,0,,Hay là em thích uống bia hơn?
Dialogue: 0,0:13:46.99,0:13:49.93,Default,,0,0,0,,Mà chắc đang trong giờ làm việc\Nthì em không được phép uống bia rượu nhỉ?
Dialogue: 0,0:13:52.38,0:13:54.43,Default,,0,0,0,,Em ĐANG đi làm đấy chứ hả?
Dialogue: 0,0:13:55.16,0:13:57.62,Default,,0,0,0,,Khoan đã... em đi đâu thế?
Dialogue: 0,0:13:58.03,0:14:00.07,Default,,0,0,0,,Tôi sẽ trả tiền trước đàng hoàng mà, được chưa?
Dialogue: 0,0:14:05.01,0:14:07.18,Default,,0,0,0,,Ông không nhận ra tôi sao?
Dialogue: 0,0:14:10.02,0:14:13.01,Default,,0,0,0,,Sumire đó ư?... Nhưng tại sao con lại...?
Dialogue: 0,0:14:14.12,0:14:16.72,Default,,0,0,0,,Bố đang tính làm cái trò gì thế hả, Bố?
Dialogue: 0,0:14:18.77,0:14:21.38,Default,,0,0,0,,Bố chỉ đang thu thập tư liệu về gái gọi thôi mà.
Dialogue: 0,0:14:22.81,0:14:26.45,Default,,0,0,0,,Thật đấy! Hiện giờ bố đang viết một cuốn tiểu thuyết\Nmang tựa đề 'Cảnh Sát Đêm Sakura'.
Dialogue: 0,0:14:26.44,0:14:29.90,Default,,0,0,0,,Đồ dối trá...\NBố thật đê tiện!
Dialogue: 0,0:14:30.17,0:14:32.59,Default,,0,0,0,,Em đâu thể ngờ được, vì Suzuki\Nvốn là một cái họ quá đỗi phổ biến mà.
Dialogue: 0,0:14:34.86,0:14:37.07,Default,,0,0,0,,Giờ em xin phép về ngay đây,\Nchắc anh không phiền đâu nhỉ?
Dialogue: 0,0:14:37.10,0:14:39.50,Default,,0,0,0,,- Quý khách có muốn đổi một cô gái khác không ạ?\N- Khoan đã, chờ một chút.
Dialogue: 0,0:14:39.78,0:14:43.02,Default,,0,0,0,,- Quý khách thích gu như thế nào ạ? Chỗ chúng tôi còn rất nhiều\Ncác em khác để anh lựa chọn.\N- Sumire!
Dialogue: 0,0:14:43.35,0:14:45.43,Default,,0,0,0,,Con đang làm cái trò gì vậy hả?!
Dialogue: 0,0:14:49.37,0:14:52.28,Default,,0,0,0,,Tôi bỗng nhớ vị ngọt bùi\Ncủa khoai lang quá.
Dialogue: 0,0:14:56.85,0:14:58.60,Default,,0,0,0,,Chào anh Suzuki.
Dialogue: 0,0:14:58.62,0:15:00.78,Default,,0,0,0,,- Bé Hana đấy ư!\N- Mời vào.
Dialogue: 0,0:15:00.83,0:15:02.83,Default,,0,0,0,,Sao đùng một cái cháu lại nghỉ làm\Nở câu lạc bộ thế?
Dialogue: 0,0:15:02.98,0:15:05.54,Default,,0,0,0,,Bọn chú cứ tìm cháu mãi đấy.
Dialogue: 0,0:15:05.75,0:15:08.51,Default,,0,0,0,,Không có tiền thì cháu xoay xở\Nsinh hoạt bằng cách nào hả?
Dialogue: 0,0:15:09.42,0:15:12.13,Default,,0,0,0,,Đây là con gái tôi, Sumire.
Dialogue: 0,0:15:13.99,0:15:16.07,Default,,0,0,0,,Con gái ư?
Dialogue: 0,0:15:34.49,0:15:36.60,Default,,0,0,0,,Cho tôi xin một điếu nữa.
Dialogue: 0,0:15:36.68,0:15:39.09,Default,,0,0,0,,Con cũng hút thuốc sao?
Dialogue: 0,0:15:43.76,0:15:46.09,Default,,0,0,0,,Bố chẳng biết bất cứ thứ gì về con cả.
Dialogue: 0,0:15:52.02,0:15:54.45,Default,,0,0,0,,Nếu mẹ con mà phát hiện ra chuyện\Ncon đang làm...
Dialogue: 0,0:15:54.82,0:15:56.86,Default,,0,0,0,,...chắc chắn bà ấy sẽ tự vẫn mất.
Dialogue: 0,0:15:57.52,0:15:59.50,Default,,0,0,0,,Sao chính BỐ không tự vẫn luôn đi?
Dialogue: 0,0:15:59.57,0:16:01.31,Default,,0,0,0,,Con mong bố chết đi đến thế sao?
Dialogue: 0,0:16:01.33,0:16:04.86,Default,,0,0,0,,Bố có bao giờ vác mặt về nhà đâu, nên bố\Ncòn sống hay đã chết thì có khác gì nhau chứ.
Dialogue: 0,0:16:09.17,0:16:11.24,Default,,0,0,0,,Bố xin lỗi.
Dialogue: 0,0:16:12.31,0:16:14.44,Default,,0,0,0,,Một lời xin lỗi thì giải quyết được gì cơ chứ?
Dialogue: 0,0:16:15.79,0:16:17.84,Default,,0,0,0,,Tất cả là lỗi của bố.
Dialogue: 0,0:16:18.42,0:16:20.59,Default,,0,0,0,,Giá như bố không bỏ mặc hai mẹ con...
Dialogue: 0,0:16:21.60,0:16:24.19,Default,,0,0,0,,...thì con đã chẳng phải sa chân làm gái gọi thế này.
Dialogue: 0,0:16:25.45,0:16:27.46,Default,,0,0,0,,Bố xin lỗi con.
Dialogue: 0,0:16:33.15,0:16:38.39,Default,,0,0,0,,Mẹ chưa bao giờ nói xấu bố lấy nửa lời.
Dialogue: 0,0:16:39.77,0:16:41.80,Default,,0,0,0,,Và con từng rất ghét điều đó.
Dialogue: 0,0:16:43.82,0:16:45.96,Default,,0,0,0,,Nhưng con không giống như mẹ.
Dialogue: 0,0:16:47.18,0:16:49.23,Default,,0,0,0,,Và con cũng chẳng giống bố đâu.
Dialogue: 0,0:16:50.21,0:16:53.89,Default,,0,0,0,,Con sẽ tự lập và sống một cuộc đời\Nthật tích cực theo cách của riêng mình.
Dialogue: 0,0:16:56.87,0:17:00.68,Default,,0,0,0,,Nếu bố đang trông mong con sẽ\Nnhận bố là cha...
Dialogue: 0,0:17:01.80,0:17:04.25,Default,,0,0,0,,...thì con thà oán hận bố\Ncòn hơn là nhìn nhận bố!
Dialogue: 0,0:17:20.82,0:17:22.84,Default,,0,0,0,,Mời vào.
Dialogue: 0,0:17:25.69,0:17:27.76,Default,,0,0,0,,Cháu xin phép ạ.
Dialogue: 0,0:17:32.19,0:17:34.28,Default,,0,0,0,,Mời cô ngồi.
Dialogue: 0,0:17:49.55,0:17:52.00,Default,,0,0,0,,- Cháu xin lỗi ạ.\N- Khoan đã!
Dialogue: 0,0:17:55.49,0:17:57.55,Default,,0,0,0,,Cô cứ ngồi xuống đi.
Dialogue: 0,0:17:57.91,0:18:00.49,Default,,0,0,0,,Tôi vẫn chưa phỏng vấn xong mà.
Dialogue: 0,0:18:24.84,0:18:26.91,Default,,0,0,0,,Cô Suzuki Sumire.
Dialogue: 0,0:18:29.73,0:18:33.32,Default,,0,0,0,,Cháu còn nhớ chuyện nốt ruồi trong lòng bàn tay\Nmà cháu từng kể cho chú nghe không?
Dialogue: 0,0:18:39.98,0:18:44.09,Default,,0,0,0,,Hôm đó chú quên khuấy mất không bảo cháu...\Nlà phải làm như thế này.
Dialogue: 0,0:18:44.15,0:18:48.03,Default,,0,0,0,,Đặt lòng bàn tay bên kia úp chồng lên nó.
Dialogue: 0,0:18:58.22,0:19:02.39,Default,,0,0,0,,Thấy chưa? Làm thế này là cháu nắm giữ được nó rồi.
Dialogue: 0,0:19:03.86,0:19:06.41,Default,,0,0,0,,Mọi chuyện rồi sẽ ổn cả thôi, đừng lo lắng nhé.
Dialogue: 0,0:19:08.95,0:19:12.78,Default,,0,0,0,,Nhưng làm thế này chẳng phải là ăn gian sao ạ?
Dialogue: 0,0:19:14.10,0:19:18.41,Default,,0,0,0,,Có sao đâu... cứ coi như đó là\Nmột lối tắt dẫn đến hạnh phúc đi.
Dialogue: 0,0:19:31.46,0:19:34.65,Default,,0,0,0,,Cháu cảm ơn chú, chú Hoko.
Dialogue: 0,0:19:36.56,0:19:38.59,Default,,0,0,0,,Cháu cảm ơn chú nhiều lắm ạ.
Dialogue: 0,0:19:39.70,0:19:42.22,Default,,0,0,0,,{\i1}Sau khi bé Hana nắm giữ được\Nnốt ruồi trong lòng bàn tay mình...{\i0}
Dialogue: 0,0:19:42.89,0:19:48.03,Default,,0,0,0,,{\i1}...anh Hoko đã nhận con bé vào làm\Nnhân viên hợp đồng tại công ty của anh ấy.{\i0}
Dialogue: 0,0:20:02.15,0:20:04.22,Default,,0,0,0,,Để quý khách đợi lâu rồi.
Dialogue: 0,0:20:07.09,0:20:09.61,Default,,0,0,0,,À... Ông chủ cho tôi gọi thêm một bát này nữa nhé.
Dialogue: 0,0:20:10.10,0:20:12.16,Default,,0,0,0,,Có ngay đây!
Dialogue: 0,0:20:12.44,0:20:14.61,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:20:21.68,0:20:23.76,Default,,0,0,0,,Mẹ ơi...
Dialogue: 0,0:20:25.77,0:20:28.98,Default,,0,0,0,,- Lâu lắm rồi mới gặp lại anh.\N- Ừ, tôi cũng vậy.
Dialogue: 0,0:20:42.91,0:20:44.87,Default,,0,0,0,,Cuốn này thú vị lắm đấy.
Dialogue: 0,0:20:44.92,0:20:47.13,Default,,0,0,0,,Con vẫn chưa đọc tiểu thuyết của bố viết bao giờ, phải không?
Dialogue: 0,0:20:51.87,0:20:54.38,Default,,0,0,0,,Con sẽ đọc thử xem sao.
Dialogue: 0,0:20:55.52,0:20:57.57,Default,,0,0,0,,Cháu cũng muốn đọc nữa ạ.
Dialogue: 0,0:21:02.51,0:21:04.73,Default,,0,0,0,,Để bố sửa lại nó trước đã.
Dialogue: 0,0:21:05.02,0:21:07.54,Default,,0,0,0,,Đợi bố viết lại xong xuôi rồi,\Nlúc ấy mọi người hãy đọc nhé.
Dialogue: 0,0:21:16.86,0:21:21.40,Default,,0,0,0,,{\i1}Món súp kem hầm quả thực rất hợp\Nvới tiết trời se lạnh thế này, phải không?{\i0}
Dialogue: 0,0:21:28.71,0:21:33.79,Default,,0,0,0,,~ Samui yoru ni wa oishii shichuu ~\N*Đêm lạnh giá, bên nồi súp hầm thơm ngon*
Dialogue: 0,0:21:34.18,0:21:37.29,Default,,0,0,0,,~ Shichuu tsukurou ~\N*Cùng nấu súp kem hầm nào*
Dialogue: 0,0:21:37.36,0:21:40.24,Default,,0,0,0,,~ Kotokoto nimashou ~\N*Tiếng nồi sôi lục bục thật vui tai*
Dialogue: 0,0:21:40.24,0:21:59.06,Default,,0,0,0,,~ Mukashi-mukashi no... mama no shichuu ~\N*Thuở ngày xửa ngày xưa... món súp hầm của mẹ*
Dialogue: 0,0:21:59.10,0:22:02.12,Default,,0,0,0,,Áo một lớp bột mì quanh thịt gà\Nsẽ giúp nước súp hầm sánh mịn hơn.
Dialogue: 0,0:22:02.57,0:22:05.65,Default,,0,0,0,,Nếu cho thêm kem tươi đặc hoặc bơ\Ncùng với một chút viên súp đóng hộp...
Dialogue: 0,0:22:05.65,0:22:07.72,Default,,0,0,0,,...hương vị của món ăn sẽ càng thêm đậm đà, béo ngậy.
Dialogue: 0,0:22:10.40,0:22:12.44,Default,,0,0,0,,Của quý khách đây.
Dialogue: 0,0:22:15.46,0:22:19.73,Default,,0,0,0,,Thơm quá đi mất...\NMọi người cũng nên nấu thử ở nhà xem sao nhé.
Dialogue: 0,0:22:20.00,0:22:22.16,Default,,0,0,0,,Vậy thôi, chúc ngủ ngon nhé.
Dialogue: 0,0:22:23.80,0:22:25.82,Default,,0,0,0,,Mời cả nhà dùng bữa ạ.~
Dialogue: 0,0:22:30.35,0:22:36.95,Default,,0,0,0,,~ Yarusenai yuhi yori ~\N*Hơn cả ánh hoàng hôn u buồn*
Dialogue: 0,0:22:30.65,0:22:34.95,Default,,0,0,0,,{\i1}Còn tiếp{\i0}
Dialogue: 0,0:22:37.15,0:22:43.97,Default,,0,0,0,,~ Shinji reru asahi o mitai ~\N*Tôi muốn ngắm nhìn bình minh của niềm tin*
Dialogue: 0,0:22:38.40,0:22:43.00,Default,,0,0,0,,{\i1}KOBAYASHI KAORU trong vai 'Ông chủ'{\i0}
Dialogue: 0,0:22:44.29,0:22:51.36,Default,,0,0,0,,~ Dakara sukoshi yume o mi sasete ~\N*Vậy nên hãy để tôi mơ một chút thôi*
Dialogue: 0,0:22:45.10,0:22:48.10,Default,,0,0,0,,{\i1}FUKIKOSHI MITSURU trong vai 'Suzuki'{\i0}
Dialogue: 0,0:22:48.40,0:22:50.40,Default,,0,0,0,,{\i1}ASAKURA AKI trong vai 'Hana/Sumire'{\i0}
Dialogue: 0,0:22:51.36,0:22:56.31,Default,,0,0,0,,~ Ashita e mukau tame ~\N*Để vững bước tiến về ngày mai*
Dialogue: 0,0:22:51.50,0:22:53.50,Default,,0,0,0,,{\i1}TOKUI YU trong vai 'Hoko'{\i0}\N{\i1}FUWA MANSAKU trong vai 'Bác Chu'{\i0}
Dialogue: 0,0:22:53.90,0:22:55.90,Default,,0,0,0,,{\i1}MATSUO SATORU trong vai 'Goro'\NKOBAYASHI ASAKO trong vai 'Rumi'{\i0}
