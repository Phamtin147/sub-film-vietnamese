Dialogue: 0,0:01:10.40,0:01:14.82,Default,,0,0,0,,Khi người ta kết thúc một ngày\Nvà vội vã trở về nhà,
Dialogue: 0,0:01:15.58,0:01:17.21,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:41.68,0:01:45.27,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm\Nđến bảy giờ sáng.
Dialogue: 0,0:01:46.94,0:01:49.98,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:51.99,0:01:53.62,Default,,0,0,0,,COMBO SÚP MISO THỊT HEO\NBIA, RƯỢU SAKE, SHOCHU
Dialogue: 0,0:01:53.70,0:01:55.16,Default,,0,0,0,,Thực đơn của tôi chỉ có vỏn vẹn từng ấy.
Dialogue: 0,0:01:55.66,0:01:58.12,Default,,0,0,0,,Nhưng hễ khách gọi món gì,
Dialogue: 0,0:01:58.66,0:02:00.70,Default,,0,0,0,,chỉ cần có sẵn nguyên liệu là tôi đều sẽ làm.
Dialogue: 0,0:02:01.04,0:02:02.63,Default,,0,0,0,,Phương châm của tôi là vậy.
Dialogue: 0,0:02:07.63,0:02:11.13,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?\NThực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:02:14.47,0:02:17.93,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN Ở TOKYO
Dialogue: 0,0:02:18.01,0:02:21.81,Default,,0,0,0,,MÌ TAN-MEN
Dialogue: 0,0:02:43.87,0:02:46.54,Default,,0,0,0,,Với mì ramen, tôi dùng mì gói sấy khô.
Dialogue: 0,0:02:47.21,0:02:49.38,Default,,0,0,0,,Nhưng với tan-men, tôi lại dùng mì tươi.
Dialogue: 0,0:02:50.34,0:02:52.34,Default,,0,0,0,,Sợi mì tươi hợp với món tan-men\Nhơn hẳn.
Dialogue: 0,0:02:59.97,0:03:02.14,Default,,0,0,0,,Ăn ramen vào ban đêm làm tôi thấy tội lỗi lắm.
Dialogue: 0,0:03:02.52,0:03:04.81,Default,,0,0,0,,Mì tan-men thì ổn hơn\Nvì có nhiều rau củ.
Dialogue: 0,0:03:05.31,0:03:06.44,Default,,0,0,0,,Anh lại bắt đầu rồi đấy.
Dialogue: 0,0:03:07.65,0:03:10.70,Default,,0,0,0,,Nếu đã phải viện cớ như thế,\Nthì tốt nhất đừng ăn nữa.
Dialogue: 0,0:03:11.23,0:03:14.61,Default,,0,0,0,,Cũng giống như cuộc đời vậy. Đâu phải lúc nào\Nta cũng đưa ra lựa chọn lý trí được.
Dialogue: 0,0:03:15.99,0:03:19.33,Default,,0,0,0,,Cẩn thận đấy.\NChính cái miếng cố ăn thêm đó mới làm anh phát phì đấy.
Dialogue: 0,0:03:20.99,0:03:24.62,Default,,0,0,0,,Anh Shimada là một phát thanh viên radio.
Dialogue: 0,0:03:25.16,0:03:30.37,Default,,0,0,0,,Đoán chừng bác sĩ đã dặn anh ấy\Nphải chú ý cân nặng.
Dialogue: 0,0:03:34.09,0:03:34.97,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:03:35.55,0:03:36.38,Default,,0,0,0,,Chào ông chủ.
Dialogue: 0,0:03:43.10,0:03:44.64,Default,,0,0,0,,Cho tôi một tô tan-men, không lấy mì.
Dialogue: 0,0:03:45.68,0:03:46.64,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:03:53.15,0:03:55.44,Default,,0,0,0,,Của cô đây. Tan-men không mì.
Dialogue: 0,0:03:56.03,0:03:57.16,Default,,0,0,0,,Cảm ơn ông chủ.
Dialogue: 0,0:04:13.59,0:04:14.55,Default,,0,0,0,,Xin lỗi cho tôi hỏi chút.
Dialogue: 0,0:04:15.76,0:04:17.55,Default,,0,0,0,,Tôi chưa từng nghe đến món nào như vậy cả.
Dialogue: 0,0:04:19.97,0:04:22.93,Default,,0,0,0,,Tôi không muốn nạp tinh bột\Nvào lúc đêm muộn thế này.
Dialogue: 0,0:04:23.89,0:04:24.81,Default,,0,0,0,,Hơn nữa,
Dialogue: 0,0:04:25.56,0:04:26.90,Default,,0,0,0,,sợi mì sẽ bị trương nở mất
Dialogue: 0,0:04:27.64,0:04:29.73,Default,,0,0,0,,trong lúc tôi gắp ăn hết chỗ rau củ.
Dialogue: 0,0:04:30.14,0:04:33.06,Default,,0,0,0,,À, nghe cũng có lý đấy, nhưng mà...
Dialogue: 0,0:04:33.56,0:04:35.98,Default,,0,0,0,,Ông chủ, hủy phần cơm chan trà của em nhé.
Dialogue: 0,0:04:36.07,0:04:38.70,Default,,0,0,0,,Cho em một phần tan-men không mì\Ngiống hệt chị ấy.
Dialogue: 0,0:04:38.78,0:04:39.61,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:04:42.37,0:04:44.21,Default,,0,0,0,,Hôm nay cô nghỉ làm rồi à?
Dialogue: 0,0:04:47.54,0:04:49.38,Default,,0,0,0,,Vẫn chưa đâu. Tôi còn chạy xe đến sáng cơ.
Dialogue: 0,0:04:50.46,0:04:52.34,Default,,0,0,0,,Em ngưỡng mộ chị thật đấy.
Dialogue: 0,0:04:52.42,0:04:54.26,Default,,0,0,0,,Em thì mù đường bẩm sinh luôn.
Dialogue: 0,0:04:55.04,0:04:57.29,Default,,0,0,0,,Cô có dùng hệ thống dẫn đường không?
Dialogue: 0,0:04:58.63,0:05:01.34,Default,,0,0,0,,Mọi con đường ở Tokyo này tôi đều nắm rõ trong lòng bàn tay.
Dialogue: 0,0:05:03.85,0:05:05.89,Default,,0,0,0,,Không lấy mì sao?
Dialogue: 0,0:05:06.85,0:05:10.85,Default,,0,0,0,,Anh Shimada ấn tượng với chuyện đó đến mức...
Dialogue: 0,0:05:10.94,0:05:11.77,Default,,0,0,0,,SHIMA-CHAN ĐÊM KHUYA
Dialogue: 0,0:05:11.85,0:05:15.85,Default,,0,0,0,,Chào bạn Phù Thủy Vùng Tabata,\Ntôi cũng đã thử đủ mọi phương pháp giảm cân rồi.
Dialogue: 0,0:05:16.44,0:05:18.94,Default,,0,0,0,,Có cái phương pháp gọi là Ăn Kiêng Bằng Táo.
Dialogue: 0,0:05:19.03,0:05:21.16,Default,,0,0,0,,Đừng có thử nhé. Ăn chẳng bõ dính răng đâu.
Dialogue: 0,0:05:21.57,0:05:26.28,Default,,0,0,0,,Thế là tôi chuyển sang ăn bánh táo nướng,\Nrốt cuộc lại càng béo thêm.
Dialogue: 0,0:05:26.87,0:05:28.71,Default,,0,0,0,,Bao nhiêu mỡ dồn hết vào bụng cả.
Dialogue: 0,0:05:30.08,0:05:34.63,Default,,0,0,0,,À mà này, gọi món "không mì" ở tiệm mì\Nthường có nghĩa là soba tempura không lấy sợi mì.
Dialogue: 0,0:05:34.71,0:05:36.80,Default,,0,0,0,,Nếu ai đó vừa nhâm nhi rượu vừa gọi món ấy,
Dialogue: 0,0:05:37.17,0:05:39.67,Default,,0,0,0,,thì tôi biết ngay đó là một tay sành ăn thứ thiệt.
Dialogue: 0,0:05:40.38,0:05:42.01,Default,,0,0,0,,Dạo gần đây tôi có gặp một người
Dialogue: 0,0:05:42.55,0:05:46.51,Default,,0,0,0,,gọi món tan-men không lấy mì\Ntại quán ăn quen thuộc của tôi.
Dialogue: 0,0:05:47.14,0:05:52.69,Default,,0,0,0,,Mì tan-men mà bỏ sợi mì đi\Nthì về cơ bản chính là một tô súp rau củ đầy đặn.
Dialogue: 0,0:05:53.06,0:05:56.86,Default,,0,0,0,,Đó hẳn là một bữa ăn tuyệt vời\Ncho những ai đang muốn kiểm soát cân nặng.
Dialogue: 0,0:05:56.94,0:06:01.24,Default,,0,0,0,,Thật sao? Đúng là một cách gọi món kỳ lạ.
Dialogue: 0,0:06:03.70,0:06:04.87,Default,,0,0,0,,Anh nói phải.
Dialogue: 0,0:06:05.28,0:06:07.32,Default,,0,0,0,,Nhưng chính tôi cũng chưa ăn thử món đó bao giờ.
Dialogue: 0,0:06:09.66,0:06:12.37,Default,,0,0,0,,Chuyện đó là nói về quán này phải không?
Dialogue: 0,0:06:12.46,0:06:15.46,Default,,0,0,0,,Đúng thế.\NĐó là chương trình radio của anh Shimada đấy.
Dialogue: 0,0:06:15.63,0:06:17.72,Default,,0,0,0,,Anh ấy đã kể về món tan-men không mì.
Dialogue: 0,0:06:17.79,0:06:20.63,Default,,0,0,0,,Chuyện đó là nói về chị Harumi đúng không nhỉ?
Dialogue: 0,0:06:20.96,0:06:23.88,Default,,0,0,0,,- Đúng rồi.\N- Cô ấy là ai thế?
Dialogue: 0,0:06:23.97,0:06:27.10,Default,,0,0,0,,Bác không nhớ sao?\NCái chị nữ tài xế taxi ấy.
Dialogue: 0,0:06:27.43,0:06:29.81,Default,,0,0,0,,Cái cô trông khá ưa nhìn\Nnhưng đã qua thời xuân sắc đó hả?
Dialogue: 0,0:06:30.35,0:06:32.19,Default,,0,0,0,,Qua thời xuân sắc á? Thế cô ấy bao nhiêu tuổi rồi?
Dialogue: 0,0:06:32.27,0:06:34.02,Default,,0,0,0,,Theo tôi đoán thì...
Dialogue: 0,0:06:34.14,0:06:37.23,Default,,0,0,0,,- Cô ấy tầm ngoài bốn mươi.\N- Thế thì so với tôi vẫn còn trẻ chán.
Dialogue: 0,0:06:37.31,0:06:39.77,Default,,0,0,0,,Tôi thậm chí còn chẳng gọi tầm tuổi đó là chín chắn nữa kìa.
Dialogue: 0,0:06:40.36,0:06:44.07,Default,,0,0,0,,Tôi lại cứ có cảm tình đặc biệt với mấy phụ nữ\Ncó tốc độ trao đổi chất thấp.
Dialogue: 0,0:06:44.15,0:06:46.65,Default,,0,0,0,,Đứng trước những người phụ nữ như thế là lòng ham muốn của tôi lại trỗi dậy mãnh liệt.
Dialogue: 0,0:06:47.32,0:06:48.91,Default,,0,0,0,,Ông đúng là số hưởng, sống thọ lắm đấy.
Dialogue: 0,0:06:49.74,0:06:52.95,Default,,0,0,0,,Cho em thử một tô tan-men không mì được không?
Dialogue: 0,0:06:53.08,0:06:55.58,Default,,0,0,0,,- Cho tôi một phần nữa.\N- Được thôi.
Dialogue: 0,0:06:57.58,0:06:59.17,Default,,0,0,0,,Thêm mì được không ông chủ? Trông bác hiền khô thế kia mà.
Dialogue: 0,0:07:00.67,0:07:01.75,Default,,0,0,0,,- Của anh đây.\N- Hiền khô á?
Dialogue: 0,0:07:02.38,0:07:04.17,Default,,0,0,0,,- Cho thêm một vắt nữa.\N- Im đi.
Dialogue: 0,0:07:07.68,0:07:10.85,Default,,0,0,0,,Hai tuần sau...
Dialogue: 0,0:07:16.64,0:07:19.35,Default,,0,0,0,,Biết ngay mà. Chuyện đó là nói về tôi đúng không?
Dialogue: 0,0:07:19.98,0:07:23.48,Default,,0,0,0,,Tôi xin lỗi vì đã đem câu chuyện của cô lên sóng\Nmà chưa xin phép.
Dialogue: 0,0:07:23.78,0:07:27.95,Default,,0,0,0,,Tại dáng vẻ lúc ăn của cô\Nlàm món đó trông ngon miệng quá.
Dialogue: 0,0:07:29.32,0:07:31.20,Default,,0,0,0,,Làm tôi nhớ lại có một lần...
Dialogue: 0,0:07:31.83,0:07:34.00,Default,,0,0,0,,tôi gọi điện tới chương trình radio để yêu cầu bài hát,
Dialogue: 0,0:07:34.08,0:07:35.67,Default,,0,0,0,,và tên của tôi đã được đọc lên sóng.
Dialogue: 0,0:07:36.16,0:07:37.87,Default,,0,0,0,,Đúng là thế hệ nghe đài đêm khuya rồi!
Dialogue: 0,0:07:38.25,0:07:39.92,Default,,0,0,0,,Giờ thì anh biết tuổi của tôi rồi đấy.
Dialogue: 0,0:07:41.88,0:07:43.84,Default,,0,0,0,,Mà sao anh lại theo nghề phát thanh viên radio?
Dialogue: 0,0:07:45.42,0:07:48.42,Default,,0,0,0,,Tôi từng rất ngưỡng mộ các phát thanh viên chương trình đêm khuya.
Dialogue: 0,0:07:49.51,0:07:51.39,Default,,0,0,0,,Mỗi khi tôi buồn bã hay căng thẳng,
Dialogue: 0,0:07:51.97,0:07:53.64,Default,,0,0,0,,và chẳng biết phải làm sao,
Dialogue: 0,0:07:54.02,0:07:57.02,Default,,0,0,0,,họ đã giúp tôi cảm thấy mình không hề cô độc.
Dialogue: 0,0:07:58.98,0:08:00.77,Default,,0,0,0,,Tôi hiểu cảm giác đó của anh.
Dialogue: 0,0:08:08.28,0:08:09.11,Default,,0,0,0,,Vâng.
Dialogue: 0,0:08:10.74,0:08:11.57,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:08:12.12,0:08:14.25,Default,,0,0,0,,Tôi đang ở gần đây thôi.
Dialogue: 0,0:08:14.91,0:08:16.66,Default,,0,0,0,,Tôi sẽ tới đón quý khách trong năm phút nữa.
Dialogue: 0,0:08:18.00,0:08:19.50,Default,,0,0,0,,Hẹn gặp lại ở chỗ cũ nhé.
Dialogue: 0,0:08:20.54,0:08:21.83,Default,,0,0,0,,Tôi tới ngay đây.
Dialogue: 0,0:08:25.96,0:08:27.34,Default,,0,0,0,,Đó là khách quen của cô à?
Dialogue: 0,0:08:28.01,0:08:29.72,Default,,0,0,0,,Có khách quen tốt thật đấy.
Dialogue: 0,0:08:30.01,0:08:33.14,Default,,0,0,0,,Cứ lái xe lòng vòng ngoài đường\Nđâu phải lúc nào cũng dễ bắt được khách.
Dialogue: 0,0:08:34.43,0:08:36.14,Default,,0,0,0,,Ông chủ, tính tiền giúp tôi nhé.
Dialogue: 0,0:08:38.85,0:08:40.81,Default,,0,0,0,,- Cảm ơn vì bữa ăn.\N- Cảm ơn cô.
Dialogue: 0,0:08:52.11,0:08:55.41,Default,,0,0,0,,Sao nhìn cô ấy cứ quen mắt thế nhỉ?
Dialogue: 0,0:08:58.66,0:08:59.49,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:08:59.58,0:09:02.96,Default,,0,0,0,,Ông chủ không thấy họ rất giống nhau sao?\NChắc chắn không lệch đi đâu được.
Dialogue: 0,0:09:03.04,0:09:04.38,Default,,0,0,0,,Hồng Phong.
Dialogue: 0,0:09:06.84,0:09:08.63,Default,,0,0,0,,Trông giống nhau thật đấy.
Dialogue: 0,0:09:09.05,0:09:10.18,Default,,0,0,0,,Mà cái này là gì thế?
Dialogue: 0,0:09:10.84,0:09:12.93,Default,,0,0,0,,Cô ấy là Hồng Phong.
Dialogue: 0,0:09:13.01,0:09:15.93,Default,,0,0,0,,Nhân vật trong bộ phim truyền hình huyền thoại\NChiến Đội Siêu Ninja Koga đấy.
Dialogue: 0,0:09:16.01,0:09:16.84,Default,,0,0,0,,Ông chủ có biết phim đó không?
Dialogue: 0,0:09:16.93,0:09:20.14,Default,,0,0,0,,Không. Ngày xưa có biết bao nhiêu là\Nphim chiến đội ninja chứ.
Dialogue: 0,0:09:22.81,0:09:23.98,Default,,0,0,0,,Hắc Phi Sóc,
Dialogue: 0,0:09:24.06,0:09:28.19,Default,,0,0,0,,Lam Cuồng Phong, Lục Yonezo,\NCam Tasuke,
Dialogue: 0,0:09:28.28,0:09:29.95,Default,,0,0,0,,và Hồng Phong.
Dialogue: 0,0:09:32.49,0:09:36.83,Default,,0,0,0,,Năm siêu ninja trừng trị kẻ ác,\Nkhông để lại bất kỳ dấu vết nào!
Dialogue: 0,0:09:39.83,0:09:42.87,Default,,0,0,0,,Hồi còn nhỏ, tôi đã từng gửi thư hâm mộ cho cô ấy.
Dialogue: 0,0:09:43.08,0:09:45.17,Default,,0,0,0,,Sau đó cô ấy gửi tặng lại tôi tấm ảnh này.
Dialogue: 0,0:09:47.17,0:09:49.13,Default,,0,0,0,,Không biết cô ấy còn nhớ tôi không nhỉ.
Dialogue: 0,0:09:54.22,0:09:55.81,Default,,0,0,0,,Này bạn Kỵ Sĩ Tuổi Trung Niên,
Dialogue: 0,0:09:56.35,0:09:58.89,Default,,0,0,0,,chuyện phải lòng một ai đó thì chẳng có giới hạn tuổi tác nào cả.
Dialogue: 0,0:09:59.22,0:10:01.22,Default,,0,0,0,,Nhưng tuyệt đối đừng biến thành kẻ bám đuôi nhé.
Dialogue: 0,0:10:01.35,0:10:03.60,Default,,0,0,0,,Xin hãy nghĩ đến cảm xúc\Ncủa người mà bạn thầm thương trộm nhớ.
Dialogue: 0,0:10:04.65,0:10:05.94,Default,,0,0,0,,Nhân tiện nói về chuyện tình cảm...
Dialogue: 0,0:10:06.56,0:10:11.82,Default,,0,0,0,,Gần đây tôi vô tình chạm mặt mối tình đầu của mình\Nở một nơi chẳng ngờ tới nhất.
Dialogue: 0,0:10:12.86,0:10:15.45,Default,,0,0,0,,Tiếc thay,\Nđó chỉ là mối tình đơn phương.
Dialogue: 0,0:10:15.53,0:10:18.12,Default,,0,0,0,,Cô ấy thậm chí còn chẳng biết tôi là ai.
Dialogue: 0,0:10:19.12,0:10:22.92,Default,,0,0,0,,Chắc hẳn một số thính giả vẫn còn nhớ bộ phim truyền hình\Nmang tên Chiến Đội Siêu Ninja Koga,
Dialogue: 0,0:10:23.16,0:10:26.41,Default,,0,0,0,,từng rất nổi tiếng hồi tôi còn nhỏ.
Dialogue: 0,0:10:26.71,0:10:29.67,Default,,0,0,0,,Một trong những nhân vật của bộ phim đó,\NHồng Phong,
Dialogue: 0,0:10:29.84,0:10:31.51,Default,,0,0,0,,chính là mối tình đầu của tôi.
Dialogue: 0,0:10:32.30,0:10:34.34,Default,,0,0,0,,Khi tôi nhận ra\Ncô ấy chính là Hồng Phong năm nào,
Dialogue: 0,0:10:34.43,0:10:36.89,Default,,0,0,0,,bài hát này đã lập tức vang lên trong đầu tôi.
Dialogue: 0,0:10:37.43,0:10:41.81,Default,,0,0,0,,Đó là ca khúc chủ đề chính\Ncủa bộ phim Chiến Đội Siêu Ninja Koga.
Dialogue: 0,0:10:47.44,0:10:49.36,Default,,0,0,0,,Nghe mà bao nhiêu ký ức ùa về.
Dialogue: 0,0:10:49.65,0:10:51.86,Default,,0,0,0,,Anh định lập câu lạc bộ người hâm mộ cho bộ phim đó thật à?
Dialogue: 0,0:10:51.94,0:10:52.78,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:10:52.86,0:10:56.11,Default,,0,0,0,,Tôi đã đăng thông báo trên trang web của mình\Nđể thăm dò phản ứng của thính giả.
Dialogue: 0,0:10:56.20,0:10:57.99,Default,,0,0,0,,Phản hồi nhận về thực sự rất tuyệt vời.
Dialogue: 0,0:10:58.07,0:11:01.11,Default,,0,0,0,,Tập phim tôi thích nhất là lúc đội trưởng\Nđón nhận Hồng Phong,
Dialogue: 0,0:11:01.20,0:11:02.87,Default,,0,0,0,,vốn là một nữ ninja đơn độc, gia nhập vào chiến đội của họ.
Dialogue: 0,0:11:02.95,0:11:05.16,Default,,0,0,0,,- Tập "Ẩn Mình Mới Chính Là Hoa".\N- Đúng rồi!
Dialogue: 0,0:11:05.25,0:11:06.46,Default,,0,0,0,,Lúc đó Phi Sóc đã nói rằng...
Dialogue: 0,0:11:07.04,0:11:08.38,Default,,0,0,0,,"Đã có bọn tôi ở phía sau làm hậu thuẫn.
Dialogue: 0,0:11:08.88,0:11:10.26,Default,,0,0,0,,Vì thế đừng chạy trốn. Hãy chiến đấu đi."
Dialogue: 0,0:11:10.34,0:11:11.26,Default,,0,0,0,,TUẦN SAU PHÁT SÓNG TIẾP Ư?!
Dialogue: 0,0:11:11.34,0:11:13.01,Default,,0,0,0,,Hồi đó dù còn là con nít nhưng tôi đã vô cùng xúc động.
Dialogue: 0,0:11:13.09,0:11:14.47,Default,,0,0,0,,Tôi cũng có chung cảm xúc đó.
Dialogue: 0,0:11:14.55,0:11:17.05,Default,,0,0,0,,Rồi cảnh Phi Sóc cùng với...
Dialogue: 0,0:11:17.13,0:11:18.84,Default,,0,0,0,,Đàn ông...
Dialogue: 0,0:11:18.93,0:11:20.26,Default,,0,0,0,,chẳng bao giờ chịu lớn cả.
Dialogue: 0,0:11:21.56,0:11:22.65,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:11:23.43,0:11:25.47,Default,,0,0,0,,Combo súp miso thịt heo rau củ cỡ đại.
Dialogue: 0,0:11:27.19,0:11:28.19,Default,,0,0,0,,Chúc ngon miệng.
Dialogue: 0,0:11:29.44,0:11:30.44,Default,,0,0,0,,Này hai anh.
Dialogue: 0,0:11:31.27,0:11:33.02,Default,,0,0,0,,Các anh hâm mộ ủng hộ cô ấy thì cũng tốt thôi,
Dialogue: 0,0:11:33.32,0:11:36.57,Default,,0,0,0,,nhưng hai người đã từng nghĩ xem\Ncô ấy sẽ cảm thấy thế nào chưa?
Dialogue: 0,0:11:37.07,0:11:38.57,Default,,0,0,0,,Ông chủ cũng thấy vậy đúng không?
Dialogue: 0,0:11:38.99,0:11:39.83,Default,,0,0,0,,Ừm...
Dialogue: 0,0:11:40.70,0:11:43.70,Default,,0,0,0,,Chắc hẳn cô ấy đã phải trải qua rất nhiều biến cố\Nmới đi đến được ngày hôm nay.
Dialogue: 0,0:11:44.45,0:11:48.66,Default,,0,0,0,,Và đó cũng chính là điều tôi muốn mời cô ấy\Nchia sẻ trên chương trình của mình.
Dialogue: 0,0:11:49.63,0:11:53.30,Default,,0,0,0,,Cô ấy là người chăm chỉ và rất tận tụy với công việc.
Dialogue: 0,0:11:53.55,0:11:56.26,Default,,0,0,0,,Ngay từ lúc gặp cô ấy là tôi đã cảm nhận được rồi.\NTuy chỉ là trực giác thôi, nhưng...
Dialogue: 0,0:11:57.05,0:12:00.80,Default,,0,0,0,,tôi nghĩ cô ấy thậm chí có thể kể lại\Nnhững thăng trầm của mình một cách đầy tích cực.
Dialogue: 0,0:12:00.89,0:12:03.48,Default,,0,0,0,,Đúng thế.\NChắc chắn giờ này cô ấy đã bước qua chuyện cũ rồi.
Dialogue: 0,0:12:03.56,0:12:05.90,Default,,0,0,0,,Hiện tại cô ấy đang là một tài xế taxi rất cừ mà.
Dialogue: 0,0:12:06.43,0:12:08.68,Default,,0,0,0,,Tôi tin chắc quá khứ đó giờ chỉ còn là\Nmột kỷ niệm đẹp với cô ấy thôi.
Dialogue: 0,0:12:11.61,0:12:13.28,Default,,0,0,0,,Đó là kỷ niệm đẹp đối với các anh,
Dialogue: 0,0:12:13.94,0:12:15.28,Default,,0,0,0,,nhưng với tôi thì không.
Dialogue: 0,0:12:17.61,0:12:19.61,Default,,0,0,0,,Ngay từ đầu tôi đã chẳng thích vai diễn đó rồi.
Dialogue: 0,0:12:21.82,0:12:23.32,Default,,0,0,0,,Bất kể tôi có hóa thân vào vai diễn nào đi chăng nữa,
Dialogue: 0,0:12:23.41,0:12:24.95,Default,,0,0,0,,trong mắt người ta tôi vẫn luôn chỉ là Hồng Phong của Koga.
Dialogue: 0,0:12:27.04,0:12:29.54,Default,,0,0,0,,Đó chính là lý do lớn nhất khiến tôi từ bỏ nghề diễn.
Dialogue: 0,0:12:31.46,0:12:32.71,Default,,0,0,0,,Tôi thực sự không hề biết chuyện đó.
Dialogue: 0,0:12:33.21,0:12:35.67,Default,,0,0,0,,Tôi đã phải chật vật lắm mới có được cuộc sống như hiện tại.
Dialogue: 0,0:12:36.80,0:12:39.01,Default,,0,0,0,,Đừng phơi bày cuộc đời tôi ra\Nchỉ để thỏa mãn sự hiếu kỳ của bản thân anh.
Dialogue: 0,0:12:39.09,0:12:40.34,Default,,0,0,0,,Tôi không hề có ý đó--
Dialogue: 0,0:12:41.09,0:12:42.09,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:12:42.39,0:12:43.98,Default,,0,0,0,,Tôi hiểu ý của cô rồi.
Dialogue: 0,0:12:44.89,0:12:45.97,Default,,0,0,0,,Tôi thực sự rất xin lỗi.
Dialogue: 0,0:13:02.62,0:13:04.75,Default,,0,0,0,,Ông chủ, cho tôi thêm một ly nữa.
Dialogue: 0,0:13:09.37,0:13:12.83,Default,,0,0,0,,Hôm nay có dịp gì thế?\NTrước giờ cô chưa từng uống rượu ở đây mà.
Dialogue: 0,0:13:15.71,0:13:17.25,Default,,0,0,0,,Anh Shimada vẫn còn ghé quán chứ ạ?
Dialogue: 0,0:13:18.05,0:13:21.55,Default,,0,0,0,,Nhắc mới nhớ... dạo này cũng không thấy anh ấy ghé qua.
Dialogue: 0,0:13:26.01,0:13:26.93,Default,,0,0,0,,Tôi...
Dialogue: 0,0:13:27.85,0:13:30.52,Default,,0,0,0,,cuối cùng cũng có thể tự hào nói với tất cả mọi người rằng...
Dialogue: 0,0:13:31.14,0:13:32.73,Default,,0,0,0,,tôi yêu công việc hiện tại của mình nhiều đến nhường nào.
Dialogue: 0,0:13:34.27,0:13:36.02,Default,,0,0,0,,Anh Shimada cũng từng nói y hệt như vậy đấy.
Dialogue: 0,0:13:37.23,0:13:40.61,Default,,0,0,0,,"Cô ấy là người chăm chỉ và rất tận tụy với công việc."
Dialogue: 0,0:13:43.28,0:13:44.11,Default,,0,0,0,,Anh ấy nói thế sao?
Dialogue: 0,0:13:48.54,0:13:51.21,Default,,0,0,0,,Ông chủ, cho tôi một phần "không mì" nhé.
Dialogue: 0,0:13:52.37,0:13:53.20,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:14:08.06,0:14:11.86,Default,,0,0,0,,Hồi đó,\Ntôi là đứa diễn tệ nhất trong cả nhóm.
Dialogue: 0,0:14:12.35,0:14:13.94,Default,,0,0,0,,Vậy mà tôi lại chẳng chịu thừa nhận điều đó.
Dialogue: 0,0:14:15.19,0:14:16.86,Default,,0,0,0,,Tôi cứ tự cho mình là ngôi sao,
Dialogue: 0,0:14:17.27,0:14:19.06,Default,,0,0,0,,rồi trút hết mọi áp lực, bực dọc lên đầu người khác.
Dialogue: 0,0:14:19.69,0:14:21.07,Default,,0,0,0,,Lúc ấy tính tình tôi thực sự rất tệ.
Dialogue: 0,0:14:24.28,0:14:28.83,Default,,0,0,0,,Thế nhưng ngay cả như vậy,\Nanh đội trưởng vẫn luôn đứng ra bênh vực tôi.
Dialogue: 0,0:14:31.08,0:14:33.37,Default,,0,0,0,,Nhân vật của anh ấy tên là gì ấy nhỉ?
Dialogue: 0,0:14:34.87,0:14:35.79,Default,,0,0,0,,Phi Sóc.
Dialogue: 0,0:14:36.50,0:14:37.67,Default,,0,0,0,,À, đúng rồi.
Dialogue: 0,0:14:39.38,0:14:42.88,Default,,0,0,0,,Phi Sóc quả là một người đàn ông tốt, nhỉ?
Dialogue: 0,0:14:47.51,0:14:48.64,Default,,0,0,0,,Tôi đã từng đem lòng yêu anh ấy.
Dialogue: 0,0:14:51.81,0:14:52.64,Default,,0,0,0,,Nhưng rồi...
Dialogue: 0,0:14:57.44,0:14:58.48,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:15:02.53,0:15:05.62,Default,,0,0,0,,Một hôm, tôi đến phim trường\Nsớm hơn thường lệ.
Dialogue: 0,0:15:19.17,0:15:20.00,Default,,0,0,0,,Tôi...
Dialogue: 0,0:15:22.59,0:15:23.51,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:15:29.09,0:15:31.18,Default,,0,0,0,,Chầu này để tôi mời.
Dialogue: 0,0:15:31.26,0:15:34.47,Default,,0,0,0,,Không cần đâu, anh thực sự không phải khách sáo thế đâu.
Dialogue: 0,0:15:34.56,0:15:35.56,Default,,0,0,0,,Cứ để tôi trả mà.
Dialogue: 0,0:15:35.85,0:15:39.23,Default,,0,0,0,,Anh ấy từng ước giá như mình được sinh ra là con gái.
Dialogue: 0,0:15:39.61,0:15:41.24,Default,,0,0,0,,Anh ấy đã tâm sự hết nỗi lòng đó với tôi.
Dialogue: 0,0:15:43.94,0:15:46.32,Default,,0,0,0,,Cũng nhờ vậy mà\Ndù không thể đến với anh ấy như người yêu,
Dialogue: 0,0:15:47.03,0:15:49.82,Default,,0,0,0,,nhưng tôi lại có được một tình bạn không gì thay thế nổi.
Dialogue: 0,0:15:54.66,0:15:55.49,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:15:58.75,0:16:00.21,Default,,0,0,0,,Hồi đó tụi tôi chẳng có mấy đồng bạc trong túi...
Dialogue: 0,0:16:01.59,0:16:04.26,Default,,0,0,0,,nên lúc nào cũng chỉ gọi món này để nhắm rượu.
Dialogue: 0,0:16:08.43,0:16:11.85,Default,,0,0,0,,Tôi sợ rằng đám người hâm mộ năm xưa\Nsẽ lại soi mói cuộc sống hiện tại của anh ấy
Dialogue: 0,0:16:11.93,0:16:13.85,Default,,0,0,0,,nếu bộ phim đó bỗng dưng gây chú ý trở lại.
Dialogue: 0,0:16:16.43,0:16:18.35,Default,,0,0,0,,Vì ngày xưa anh ấy đã luôn che chở cho tôi,
Dialogue: 0,0:16:18.44,0:16:20.23,Default,,0,0,0,,nên tôi nghĩ giờ là lúc đến lượt mình bảo vệ anh ấy.
Dialogue: 0,0:16:25.36,0:16:27.90,Default,,0,0,0,,Nhưng hóa ra\Ntôi lại lo bò trắng răng mất rồi.
Dialogue: 0,0:16:29.99,0:16:31.78,Default,,0,0,0,,Là chính Phi Sóc đã nói với cô như thế à?
Dialogue: 0,0:16:34.08,0:16:36.25,Default,,0,0,0,,"Cuộc đời cậu là chuyện của cậu.
Dialogue: 0,0:16:36.79,0:16:38.79,Default,,0,0,0,,Còn cuộc đời tôi là chuyện của tôi.
Dialogue: 0,0:16:39.67,0:16:41.88,Default,,0,0,0,,Hai chúng ta đang bước đi trên những con đường riêng biệt.
Dialogue: 0,0:16:42.29,0:16:43.75,Default,,0,0,0,,Cứ để mọi thứ tự nhiên như thế đi."
Dialogue: 0,0:16:45.50,0:16:47.25,Default,,0,0,0,,Thế... nhắc mới nhớ...
Dialogue: 0,0:16:47.80,0:16:49.14,Default,,0,0,0,,Dạo này anh ấy sống thế nào rồi?
Dialogue: 0,0:17:02.48,0:17:04.86,Default,,0,0,0,,Chính tôi mới là người đã làm phiền cô ấy trước.
Dialogue: 0,0:17:05.65,0:17:06.53,Default,,0,0,0,,Vậy sao cô ấy lại làm thế?
Dialogue: 0,0:17:07.40,0:17:10.03,Default,,0,0,0,,Cô ấy cảm thấy hôm đó mình đã nói năng hơi quá lời.
Dialogue: 0,0:17:10.90,0:17:12.82,Default,,0,0,0,,Nên cô ấy muốn gửi lời xin lỗi đến anh đấy.
Dialogue: 0,0:17:16.83,0:17:17.79,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:17:18.33,0:17:19.29,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:17:30.55,0:17:31.38,Default,,0,0,0,,Ờ thì...
Dialogue: 0,0:17:31.88,0:17:34.38,Default,,0,0,0,,Do tôi đã thiếu hiểu biết và quá vô tâm.
Dialogue: 0,0:17:34.72,0:17:36.72,Default,,0,0,0,,Tôi thực sự rất xin lỗi. Đáng lẽ tôi không nên--
Dialogue: 0,0:17:41.06,0:17:42.69,Default,,0,0,0,,"Đã có bọn tôi ở phía sau làm hậu thuẫn.
Dialogue: 0,0:17:43.35,0:17:44.19,Default,,0,0,0,,Vì thế...
Dialogue: 0,0:17:44.73,0:17:46.11,Default,,0,0,0,,đừng chạy trốn. Hãy chiến đấu đi."
Dialogue: 0,0:17:49.94,0:17:50.78,Default,,0,0,0,,Harumi này,
Dialogue: 0,0:17:51.57,0:17:54.62,Default,,0,0,0,,tự tôi sẽ kể hết mọi chuyện cho cậu ấy nghe.\NCậu rõ chưa hả?
Dialogue: 0,0:17:55.37,0:17:58.33,Default,,0,0,0,,Tùy cậu thôi.\NĂn xong bữa này là tôi về luôn đây.
Dialogue: 0,0:17:58.66,0:18:02.12,Default,,0,0,0,,- Cậu đúng là đồ cộc cằn khó gần.\N- Tôi bỏ cái thói bao đồng lo chuyện thiên hạ rồi.
Dialogue: 0,0:18:05.00,0:18:06.46,Default,,0,0,0,,Cậu không nhận ra tôi sao?
Dialogue: 0,0:18:15.01,0:18:16.39,Default,,0,0,0,,Hồng Phong và...
Dialogue: 0,0:18:18.93,0:18:20.10,Default,,0,0,0,,Hồng Phong và...
Dialogue: 0,0:18:21.27,0:18:22.11,Default,,0,0,0,,Phi Sóc ư?
Dialogue: 0,0:18:23.52,0:18:24.73,Default,,0,0,0,,Anh chính là Phi Sóc!
Dialogue: 0,0:18:26.81,0:18:28.23,Default,,0,0,0,,Thật sao? Thật đấy hả?
Dialogue: 0,0:18:29.27,0:18:31.11,Default,,0,0,0,,- Phi...\N- Uống chút nước cho bình tĩnh nhé?
Dialogue: 0,0:18:40.58,0:18:41.58,Default,,0,0,0,,Phi Sóc thật ư?
Dialogue: 0,0:18:42.87,0:18:44.33,Default,,0,0,0,,Chuẩn bị lên sóng nhé.
Dialogue: 0,0:18:44.62,0:18:46.87,Default,,0,0,0,,Chương trình phát sóng trực tiếp đấy,\Nnên xin hãy chú ý lời ăn tiếng nói nhé.
Dialogue: 0,0:18:48.13,0:18:50.51,Default,,0,0,0,,Sắp hết giờ giải lao quảng cáo rồi.
Dialogue: 0,0:18:52.59,0:18:55.01,Default,,0,0,0,,Shima, vào việc thôi.
Dialogue: 0,0:18:56.05,0:18:58.89,Default,,0,0,0,,Đây là chương trình "Shima-chan Đêm Khuya".
Dialogue: 0,0:18:59.56,0:19:02.81,Default,,0,0,0,,Tin hay không tùy bạn,\Nnhưng tối nay tôi có một vị khách mời vô cùng đặc biệt.
Dialogue: 0,0:19:03.23,0:19:06.07,Default,,0,0,0,,Thú thật là tôi cũng chẳng dám nghĩ\Nanh ấy sẽ thực sự nhận lời đến đây.
Dialogue: 0,0:19:06.15,0:19:07.69,Default,,0,0,0,,Đã lâu không gặp mọi người.
Dialogue: 0,0:19:08.56,0:19:11.56,Default,,0,0,0,,Tôi là Hắc Phi Sóc\Ntrong bộ phim Chiến Đội Siêu Ninja Koga.
Dialogue: 0,0:19:11.65,0:19:15.20,Default,,0,0,0,,Tôi thực sự rất hạnh phúc khi biết\Nmọi người vẫn còn nhớ đến mình.
Dialogue: 0,0:19:22.66,0:19:26.91,Default,,0,0,0,,Hôm nay chỉ có một mình tôi ở phòng thu thôi,\Nnhưng mọi người hãy chuẩn bị tinh thần nghe câu khẩu hiệu quen thuộc nhé.
Dialogue: 0,0:19:27.00,0:19:29.13,Default,,0,0,0,,"Khi năm siêu ninja hợp sức,
Dialogue: 0,0:19:29.21,0:19:31.59,Default,,0,0,0,,kẻ ác sẽ bị trừng trị không còn một dấu vết!
Dialogue: 0,0:19:31.96,0:19:34.13,Default,,0,0,0,,Khi năm tiếng chuông ngân vang,
Dialogue: 0,0:19:34.21,0:19:36.34,Default,,0,0,0,,đó là lúc tận số của lũ ác nhân.
Dialogue: 0,0:19:36.43,0:19:38.72,Default,,0,0,0,,Koga sẽ xuất hiện ở bất cứ nơi đâu,
Dialogue: 0,0:19:38.80,0:19:42.18,Default,,0,0,0,,vượt lên trên cả ranh giới thiện ác!"
Dialogue: 0,0:19:48.23,0:19:50.73,Default,,0,0,0,,Mọi người có tin được không,\Nchương trình hôm nay đã sắp phải khép lại rồi.
Dialogue: 0,0:19:51.52,0:19:56.11,Default,,0,0,0,,Phi Sóc muốn gửi một lời nhắn nhủ\Nđến một người bạn vô cùng trân quý của anh ấy.
Dialogue: 0,0:20:03.16,0:20:05.83,Default,,0,0,0,,Tôi xin phép được gửi một lời nhắn cá nhân\Ntrên sóng radio này.
Dialogue: 0,0:20:07.25,0:20:11.84,Default,,0,0,0,,Tôi yêu con người hiện tại của mình, cũng như yêu chính mình của ngày xưa.
Dialogue: 0,0:20:15.42,0:20:19.05,Default,,0,0,0,,Dù người đời có bàn tán ra sao về tôi,\Ntôi cũng chẳng bận tâm. Đây mới chính là tôi.
Dialogue: 0,0:20:20.34,0:20:23.97,Default,,0,0,0,,Có lẽ mặt tôi bây giờ cũng đã dày hơn\Nhồi còn trẻ nhiều rồi...
Dialogue: 0,0:20:27.31,0:20:28.27,Default,,0,0,0,,Dẫu nói là vậy...
Dialogue: 0,0:20:30.60,0:20:32.06,Default,,0,0,0,,nhưng tôi vẫn rất trân trọng...
Dialogue: 0,0:20:33.65,0:20:35.03,Default,,0,0,0,,tấm lòng luôn lo lắng và quan tâm cho tôi của cậu.
Dialogue: 0,0:20:37.78,0:20:40.78,Default,,0,0,0,,Tôi muốn gửi tới cậu lời cảm ơn chân thành nhất.
Dialogue: 0,0:20:47.29,0:20:49.46,Default,,0,0,0,,Lần sau lại ghé chơi nhé, Phi Sóc.
Dialogue: 0,0:20:50.42,0:20:51.71,Default,,0,0,0,,Hẹn gặp lại các bạn vào tuần sau.
Dialogue: 0,0:20:52.42,0:20:53.63,Default,,0,0,0,,Chúc mọi người ngủ ngon.
Dialogue: 0,0:21:07.77,0:21:09.36,Default,,0,0,0,,Xin lỗi nhé. Tôi không để ý thấy cô.
Dialogue: 0,0:21:10.14,0:21:11.68,Default,,0,0,0,,Quý khách muốn đi đâu ạ?
Dialogue: 0,0:21:43.39,0:21:44.64,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:21:47.64,0:21:50.69,Default,,0,0,0,,Tôi là Siêu Ninja thứ sáu,\NBạch Shima-chan.
Dialogue: 0,0:21:51.10,0:21:53.85,Default,,0,0,0,,Sau tất cả thì món khoái khẩu của tôi\Nvẫn là phải "có mì" cơ.
Dialogue: 0,0:21:54.40,0:21:56.11,Default,,0,0,0,,Này lính mới, không được thì thầm to nhỏ.
Dialogue: 0,0:21:56.57,0:21:57.40,Default,,0,0,0,,Dạ rõ, thưa tiền bối.
Dialogue: 0,0:21:58.86,0:22:00.32,Default,,0,0,0,,Xin mọi người chú ý lắng nghe.
Dialogue: 0,0:22:01.03,0:22:02.57,Default,,0,0,0,,Chúc mọi người một đêm ngon giấc.
Dialogue: 0,0:23:49.01,0:23:53.85,Default,,0,0,0,,CÂU CHUYỆN NÀY CHỈ LÀ HƯ CẤU
