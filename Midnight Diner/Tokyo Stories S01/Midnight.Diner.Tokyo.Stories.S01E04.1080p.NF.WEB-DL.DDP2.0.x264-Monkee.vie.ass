Dialogue: 0,0:01:04.90,0:01:06.69,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:06.90,0:01:09.36,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:10.20,0:01:11.58,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:29.42,0:01:32.01,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:32.59,0:01:34.13,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:35.14,0:01:38.06,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:42.77,0:01:44.02,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:44.81,0:01:46.48,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:50.24,0:01:53.49,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN Ở TOKYO
Dialogue: 0,0:01:53.57,0:01:56.78,Default,,0,0,0,,CƠM TRỨNG CUỘN OMURICE
Dialogue: 0,0:02:01.29,0:02:05.38,Default,,0,0,0,,Ai trong đời mà chẳng có đôi lần\Nbỏ quên ô ở một nơi nào đó.
Dialogue: 0,0:02:05.79,0:02:08.08,Default,,0,0,0,,Nhưng trường hợp của anh chàng này thì thuộc hàng cực phẩm.
Dialogue: 0,0:02:12.17,0:02:14.92,Default,,0,0,0,,Lần nào ghé đến quán tôi,\Nanh ta cũng trong bộ dạng ướt như chuột lột.
Dialogue: 0,0:02:15.97,0:02:18.06,Default,,0,0,0,,Lại quên ô nữa à? Cậu cứ đứng yên ngay đó đi.
Dialogue: 0,0:02:23.77,0:02:26.77,Default,,0,0,0,,Anh ấy tên là Amamiya.
Dialogue: 0,0:02:26.86,0:02:29.78,Default,,0,0,0,,Nghe đâu anh ấy là\Nmột nhà vật lý học trẻ tuổi đầy triển vọng.
Dialogue: 0,0:02:30.90,0:02:35.20,Default,,0,0,0,,- Cảm ơn ông chủ. Cho tôi một đĩa cơm trứng cuộn nhé.\N- Có ngay.
Dialogue: 0,0:02:42.54,0:02:44.25,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:02:48.29,0:02:49.46,Default,,0,0,0,,Xin phép dùng bữa ạ.
Dialogue: 0,0:03:08.69,0:03:10.19,Default,,0,0,0,,À, mình hiểu ra rồi!
Dialogue: 0,0:03:47.35,0:03:49.10,Default,,0,0,0,,Ông chủ, tính tiền giúp tôi nhé.
Dialogue: 0,0:03:49.65,0:03:51.78,Default,,0,0,0,,- Có ngay đây.\N- Ôi thôi chết...
Dialogue: 0,0:03:51.86,0:03:53.61,Default,,0,0,0,,Ông chủ tính tiền phần của em luôn nhé?
Dialogue: 0,0:03:54.86,0:03:57.20,Default,,0,0,0,,Cậu phải về ngay bây giờ à?
Dialogue: 0,0:03:57.45,0:03:59.95,Default,,0,0,0,,Sắp tới có một hội thảo khoa học quan trọng.\NNên dạo này tôi bận túi bụi.
Dialogue: 0,0:04:00.28,0:04:01.32,Default,,0,0,0,,Cảm ơn ông chủ vì bữa ăn.
Dialogue: 0,0:04:14.71,0:04:16.00,Default,,0,0,0,,Ôi trời đất ơi...
Dialogue: 0,0:04:22.97,0:04:23.93,Default,,0,0,0,,Cảm ơn ông chủ.
Dialogue: 0,0:04:30.98,0:04:32.19,Default,,0,0,0,,Lại thêm một cây ô nữa ra đi...
Dialogue: 0,0:04:34.32,0:04:35.53,Default,,0,0,0,,Cảm ơn cậu nhiều lắm.
Dialogue: 0,0:04:43.95,0:04:45.54,Default,,0,0,0,,Tôi đi về hướng đằng kia.
Dialogue: 0,0:04:46.20,0:04:47.66,Default,,0,0,0,,Vậy cô cứ cầm lấy cây ô này mà dùng.
Dialogue: 0,0:04:48.83,0:04:50.21,Default,,0,0,0,,Chỗ làm của tôi ở ngay đằng trước thôi.
Dialogue: 0,0:04:51.08,0:04:52.04,Default,,0,0,0,,Tôi chạy ù qua là tới ấy mà.
Dialogue: 0,0:04:53.00,0:04:54.00,Default,,0,0,0,,Khoan đã...
Dialogue: 0,0:04:55.00,0:04:57.17,Default,,0,0,0,,Có thể tôi sẽ không mang trả lại ô cho cậu được đâu.
Dialogue: 0,0:04:58.84,0:04:59.76,Default,,0,0,0,,Sao lại không trả được?
Dialogue: 0,0:05:05.18,0:05:08.23,Default,,0,0,0,,- Đây là chỗ tôi làm việc.\N- À vâng.
Dialogue: 0,0:05:09.35,0:05:12.02,Default,,0,0,0,,Tôi không có ý chèo kéo cậu vào làm khách của tôi đâu nhé.
Dialogue: 0,0:05:14.02,0:05:15.44,Default,,0,0,0,,Vậy sao?
Dialogue: 0,0:05:18.40,0:05:19.32,Default,,0,0,0,,Cái này...
Dialogue: 0,0:05:21.90,0:05:23.28,Default,,0,0,0,,Một chai sâm panh.
Dialogue: 0,0:05:27.20,0:05:29.58,Default,,0,0,0,,Khoan đã, cái gì thế? Chuyện gì đang xảy ra vậy?
Dialogue: 0,0:05:30.58,0:05:33.00,Default,,0,0,0,,Người ngợm cậu ướt sũng cả rồi kìa.\NĐã có chuyện gì thế?
Dialogue: 0,0:05:33.08,0:05:36.67,Default,,0,0,0,,Chỗ này chưa đúng.\NPhải giải theo hướng này mới phải.
Dialogue: 0,0:05:36.75,0:05:39.59,Default,,0,0,0,,Nó phải có dạng như thế này.
Dialogue: 0,0:05:39.67,0:05:42.55,Default,,0,0,0,,- Viết ngay lên đó á?\N- Vâng, tôi muốn viết công thức lên ngay chỗ đó.
Dialogue: 0,0:05:44.18,0:05:46.06,Default,,0,0,0,,- Thực sự cấp thiết đến thế cơ à?\N- Vâng!
Dialogue: 0,0:05:50.81,0:05:52.02,Default,,0,0,0,,Cảm ơn nhé. Tôi mượn cây bút này.
Dialogue: 0,0:05:55.81,0:05:58.02,Default,,0,0,0,,Đúng rồi. Chính là như thế này.
Dialogue: 0,0:06:04.61,0:06:06.36,Default,,0,0,0,,Đây chính là thế năng Higgs.
Dialogue: 0,0:06:07.78,0:06:11.41,Default,,0,0,0,,THẾ NĂNG HIGGS LÀ MỘT LÝ THUYẾT VẬT LÝ\NDO PETER HIGGS ĐỀ XUẤT.
Dialogue: 0,0:06:11.50,0:06:13.25,Default,,0,0,0,,Đó là bút lông dầu không xóa được phải không?
Dialogue: 0,0:06:14.00,0:06:17.63,Default,,0,0,0,,NÓ CÓ BIỂU ĐỒ HÌNH DẠNG GIỐNG HỆT\NMỘT ĐÁY CHAI SÂM PANH.
Dialogue: 0,0:06:17.71,0:06:20.92,Default,,0,0,0,,Ra là vậy. Giờ thì tôi đã thông suốt rồi.
Dialogue: 0,0:06:23.26,0:06:25.51,Default,,0,0,0,,Bạn của anh hơi lập dị đấy nhé.
Dialogue: 0,0:06:26.01,0:06:27.35,Default,,0,0,0,,Thành thật xin lỗi cô.
Dialogue: 0,0:06:30.52,0:06:31.90,Default,,0,0,0,,Ôi trời ơi...
Dialogue: 0,0:06:33.60,0:06:35.85,Default,,0,0,0,,Tôi không thể nào vác nguyên tấm bảng này về nhà được.
Dialogue: 0,0:06:40.90,0:06:42.53,Default,,0,0,0,,- Xin lỗi cho tôi hỏi...\N- Vâng?
Dialogue: 0,0:06:54.54,0:06:56.25,Default,,0,0,0,,Đúng là một thiết bị mang tính đột phá!
Dialogue: 0,0:06:56.58,0:06:58.42,Default,,0,0,0,,Thứ này tuyệt vời quá đỗi.
Dialogue: 0,0:06:59.54,0:07:03.54,Default,,0,0,0,,Tôi biết phải cảm ơn cô thế nào đây? Nhưng mà...
Dialogue: 0,0:07:03.80,0:07:05.34,Default,,0,0,0,,Làm thế nào để tôi lấy được tấm ảnh chụp này về?
Dialogue: 0,0:07:07.39,0:07:10.35,Default,,0,0,0,,Trước tiên cậu cứ viết nốt cho xong phương trình đi\Nkẻo lại quên mất bây giờ.
Dialogue: 0,0:07:11.35,0:07:12.23,Default,,0,0,0,,À phải rồi.
Dialogue: 0,0:07:44.71,0:07:47.92,Default,,0,0,0,,Tôi không ngờ là\Ncậu lại thực sự ghé đến đây đấy.
Dialogue: 0,0:07:49.68,0:07:52.02,Default,,0,0,0,,Tôi chỉ muốn trực tiếp nói lời cảm ơn cô thôi.
Dialogue: 0,0:07:53.26,0:07:54.97,Default,,0,0,0,,Có gì to tát đâu mà.
Dialogue: 0,0:07:57.31,0:07:58.39,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:07:59.19,0:08:00.82,Default,,0,0,0,,Tôi rất vui vì được gặp lại cô.
Dialogue: 0,0:08:12.41,0:08:13.54,Default,,0,0,0,,Cô có sao không?
Dialogue: 0,0:08:15.58,0:08:17.46,Default,,0,0,0,,Trông mặt cô có vẻ buồn.
Dialogue: 0,0:08:18.46,0:08:19.67,Default,,0,0,0,,Tôi xin lỗi nhé.
Dialogue: 0,0:08:22.79,0:08:24.04,Default,,0,0,0,,Thú thật với cậu là,
Dialogue: 0,0:08:25.71,0:08:26.84,Default,,0,0,0,,hôm qua...
Dialogue: 0,0:08:29.59,0:08:32.59,Default,,0,0,0,,CHAPPIE
Dialogue: 0,0:08:56.04,0:08:57.33,Default,,0,0,0,,Cậu Amamiya này,
Dialogue: 0,0:08:59.12,0:09:00.50,Default,,0,0,0,,cảm ơn cậu vì hôm nay đã đến dự.
Dialogue: 0,0:09:03.17,0:09:04.92,Default,,0,0,0,,Không có gì đâu mà, Rei.
Dialogue: 0,0:09:06.92,0:09:11.26,Default,,0,0,0,,Tên thật của tôi là Yoona.
Dialogue: 0,0:09:11.63,0:09:12.51,Default,,0,0,0,,Còn Rei chỉ là...
Dialogue: 0,0:09:13.14,0:09:14.93,Default,,0,0,0,,nghệ danh của tôi ở hộp đêm thôi.
Dialogue: 0,0:09:16.60,0:09:17.56,Default,,0,0,0,,Yoona sao?
Dialogue: 0,0:09:20.73,0:09:23.32,Default,,0,0,0,,Komichi này, anh kiếm đâu ra\Nmón đồ chơi cổ lỗ sĩ thế hả?
Dialogue: 0,0:09:24.11,0:09:26.86,Default,,0,0,0,,Tôi nghe bảo chơi trò này tốt cho trí não lắm,\Nnên mới mua về thử.
Dialogue: 0,0:09:27.69,0:09:30.90,Default,,0,0,0,,Nhưng mà khó nhằn quá,\Nnên giờ tôi chỉ dùng để xoay tập thể dục cho ngón tay thôi.
Dialogue: 0,0:09:33.78,0:09:36.20,Default,,0,0,0,,- Chào buổi tối.\N- Chào buổi tối.
Dialogue: 0,0:09:37.24,0:09:38.24,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:09:40.75,0:09:42.79,Default,,0,0,0,,Hai người đang đi hẹn hò sau giờ làm đấy à?
Dialogue: 0,0:09:43.04,0:09:45.54,Default,,0,0,0,,Cậu Amamiya,\Nxem ra cậu cũng là đàn ông con trai đích thực đấy nhỉ.
Dialogue: 0,0:09:45.79,0:09:47.83,Default,,0,0,0,,Hẹn hò sau giờ làm là cái gì cơ?
Dialogue: 0,0:09:49.96,0:09:55.05,Default,,0,0,0,,Khoan đã, thế tức là... hai người đang hẹn hò với nhau thật đấy hả?
Dialogue: 0,0:10:15.03,0:10:15.99,Default,,0,0,0,,Xin lỗi cô nhé.
Dialogue: 0,0:10:16.28,0:10:17.95,Default,,0,0,0,,Phải đúng nửa đêm quán tôi mới mở cửa cơ.
Dialogue: 0,0:10:18.58,0:10:21.54,Default,,0,0,0,,Ông chủ ơi, xin lỗi vì đã làm phiền ông chủ\Ntrước giờ mở cửa quán nhé.
Dialogue: 0,0:10:22.33,0:10:24.62,Default,,0,0,0,,Em có một chuyện muốn nhờ ông chủ giúp ạ.
Dialogue: 0,0:11:10.71,0:11:11.88,Default,,0,0,0,,Như thế này...
Dialogue: 0,0:11:13.21,0:11:14.09,Default,,0,0,0,,đã được chưa ạ?
Dialogue: 0,0:11:14.80,0:11:16.01,Default,,0,0,0,,Cô làm khéo lắm rồi.
Dialogue: 0,0:11:20.22,0:11:23.85,Default,,0,0,0,,- Vậy tên thật của cô ấy là Yoona à?\N- Dạ vâng.
Dialogue: 0,0:11:23.93,0:11:26.85,Default,,0,0,0,,Cô ấy đã tự tay vào bếp làm món đó chỉ để dành riêng cho cậu thôi hả?
Dialogue: 0,0:11:26.94,0:11:31.15,Default,,0,0,0,,- Ngọt ngào quá đi mất.\N- Món đó thực sự rất ngon.
Dialogue: 0,0:11:32.32,0:11:35.41,Default,,0,0,0,,Cứ thế này thì gay go cho việc làm ăn của quán tôi rồi.
Dialogue: 0,0:11:36.61,0:11:40.28,Default,,0,0,0,,- Mấy cô cũng nên học hỏi cô ấy đi.\N- Bác cứ lo chuyện của bác đi.
Dialogue: 0,0:11:40.37,0:11:43.42,Default,,0,0,0,,Nếu tụi cháu mà có người thương đặc biệt,\Nthì tất nhiên tụi cháu cũng sẽ nấu ăn cho anh ấy rồi.
Dialogue: 0,0:11:43.49,0:11:44.83,Default,,0,0,0,,Đúng không chị em?
Dialogue: 0,0:11:46.54,0:11:47.37,Default,,0,0,0,,Ông chủ này,
Dialogue: 0,0:11:47.92,0:11:50.26,Default,,0,0,0,,tôi đã quyết định sẽ dọn về sống chung với Yoona.
Dialogue: 0,0:11:51.38,0:11:55.30,Default,,0,0,0,,- Thật vậy sao? Chúc hai người trăm năm hạnh phúc nhé.\N- Cảm ơn ông chủ.
Dialogue: 0,0:11:58.05,0:12:00.97,Default,,0,0,0,,Tôi dự định sẽ sang Hàn Quốc để ra mắt gia đình cô ấy.
Dialogue: 0,0:12:01.72,0:12:05.60,Default,,0,0,0,,Nhưng khi tôi thưa chuyện với mẹ rằng\Ntôi và Yoona định dọn về sống chung,
Dialogue: 0,0:12:05.68,0:12:07.89,Default,,0,0,0,,bà đã bảo tôi phải suy nghĩ lại cho thật kỹ.
Dialogue: 0,0:12:08.52,0:12:12.48,Default,,0,0,0,,Đó là cách mẹ cậu khéo léo bày tỏ thái độ phản đối\Nchuyện của hai người đấy à?
Dialogue: 0,0:12:12.82,0:12:15.66,Default,,0,0,0,,Bác gái phản đối chuyện kết hôn với người nước ngoài sao?
Dialogue: 0,0:12:15.73,0:12:20.32,Default,,0,0,0,,Chuyện quốc tịch đâu phải là vấn đề gì to tát,\Nchỉ cần hai người thật lòng yêu thương nhau là được mà.
Dialogue: 0,0:12:20.95,0:12:24.66,Default,,0,0,0,,Nhưng nếu xét đến những khác biệt\Nvề văn hóa lẫn ngôn ngữ,
Dialogue: 0,0:12:24.74,0:12:26.95,Default,,0,0,0,,thì tôi cũng hiểu vì sao bậc làm cha làm mẹ\Nlại lo lắng như vậy.
Dialogue: 0,0:12:27.04,0:12:28.17,Default,,0,0,0,,Mẹ tôi thậm chí còn nói rằng...
Dialogue: 0,0:12:28.71,0:12:32.80,Default,,0,0,0,,có lẽ đầu óc tôi bị làm sao rồi.
Dialogue: 0,0:12:33.63,0:12:34.67,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:12:35.67,0:12:38.30,Default,,0,0,0,,khi yêu vào thì con người ta\Nphải mất trí một chút mới là bình thường, đúng không?
Dialogue: 0,0:12:46.35,0:12:47.56,Default,,0,0,0,,Hôm nay em tráng trứng vẫn chưa được đẹp mắt lắm.
Dialogue: 0,0:12:49.69,0:12:50.73,Default,,0,0,0,,Anh đang có chuyện gì phiền lòng sao?
Dialogue: 0,0:12:57.74,0:12:58.78,Default,,0,0,0,,Cảm ơn em nhé.
Dialogue: 0,0:12:59.70,0:13:01.33,Default,,0,0,0,,Cậu Amamiya đã thử đủ mọi cách
Dialogue: 0,0:13:01.74,0:13:04.16,Default,,0,0,0,,để thuyết phục bố mẹ mình,
Dialogue: 0,0:13:04.49,0:13:07.08,Default,,0,0,0,,nhưng ông bà vẫn chưa chịu chấp thuận\Nhôn sự của hai người.
Dialogue: 0,0:13:14.50,0:13:16.34,Default,,0,0,0,,- Xin mời vào.\N- Chào buổi tối ông chủ.
Dialogue: 0,0:13:18.01,0:13:19.47,Default,,0,0,0,,Hôm nay...
Dialogue: 0,0:13:20.97,0:13:22.47,Default,,0,0,0,,là ngày làm việc cuối cùng của em ở câu lạc bộ.
Dialogue: 0,0:13:24.89,0:13:27.31,Default,,0,0,0,,Đây là món cà tím muối chua.
Dialogue: 0,0:13:27.97,0:13:30.06,Default,,0,0,0,,Em hy vọng là hợp khẩu vị của ông chủ.
Dialogue: 0,0:13:36.94,0:13:39.11,Default,,0,0,0,,- Ngon lắm.\N- Thật sao ạ?
Dialogue: 0,0:13:56.29,0:13:57.54,Default,,0,0,0,,Em sang Nhật Bản...
Dialogue: 0,0:13:58.59,0:14:02.47,Default,,0,0,0,,là để đi làm kiếm tiền trả hết
Dialogue: 0,0:14:03.18,0:14:04.52,Default,,0,0,0,,khoản nợ làm ăn thua lỗ của bố em.
Dialogue: 0,0:14:08.56,0:14:10.14,Default,,0,0,0,,Bố mẹ em...
Dialogue: 0,0:14:10.85,0:14:12.10,Default,,0,0,0,,vốn mở...
Dialogue: 0,0:14:13.64,0:14:15.64,Default,,0,0,0,,một quán ăn nhỏ.
Dialogue: 0,0:14:16.61,0:14:20.95,Default,,0,0,0,,Nhưng việc buôn bán của ông bà ngày càng sa sút\Nkhi xung quanh có nhiều nhà hàng mới mọc lên.
Dialogue: 0,0:14:23.45,0:14:27.00,Default,,0,0,0,,Nếu đi làm ở hộp đêm tại Seoul,\Nrất có thể sẽ bị người quen bắt gặp.
Dialogue: 0,0:14:27.62,0:14:29.75,Default,,0,0,0,,Nên em đã nói dối bố mẹ rằng
Dialogue: 0,0:14:30.16,0:14:31.83,Default,,0,0,0,,mình sang bên này để làm nghề phiên dịch viên.
Dialogue: 0,0:14:32.45,0:14:35.58,Default,,0,0,0,,Thực tâm em chỉ muốn nhanh chóng\Ntrả hết nợ nần cho bố mẹ thôi.
Dialogue: 0,0:14:37.38,0:14:38.76,Default,,0,0,0,,Thời gian qua cô đã vất vả nhiều rồi.
Dialogue: 0,0:14:39.80,0:14:42.18,Default,,0,0,0,,Thế giờ cô đã trả dứt hết nợ nần chưa?
Dialogue: 0,0:14:43.88,0:14:48.43,Default,,0,0,0,,Bố mẹ em đang muốn mở cửa lại quán ăn của gia đình.
Dialogue: 0,0:14:48.51,0:14:50.60,Default,,0,0,0,,Ông bà ở nhà đang phấn khởi lắm.
Dialogue: 0,0:14:51.35,0:14:52.48,Default,,0,0,0,,Thế thì mừng cho hai bác quá.
Dialogue: 0,0:14:56.52,0:14:57.73,Default,,0,0,0,,Cô đã kể...
Dialogue: 0,0:14:59.11,0:15:00.78,Default,,0,0,0,,cho cậu Amamiya nghe về chuyện khoản nợ đó chưa?
Dialogue: 0,0:15:02.48,0:15:05.94,Default,,0,0,0,,Em vốn định đợi khi nào trả xong hết nợ\Nthì mới kể cho anh ấy nghe.
Dialogue: 0,0:15:07.03,0:15:07.95,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:15:10.20,0:15:11.20,Default,,0,0,0,,Hôm nay...
Dialogue: 0,0:15:12.12,0:15:14.50,Default,,0,0,0,,- bữa ăn của cô để tôi mời nhé.\N- Thật sao ạ?
Dialogue: 0,0:15:20.46,0:15:21.84,Default,,0,0,0,,Vậy ông chủ cho em xin thêm một chén rượu nữa được không?
Dialogue: 0,0:15:22.46,0:15:23.34,Default,,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:15:43.11,0:15:44.03,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:15:47.28,0:15:48.24,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:15:53.54,0:15:54.46,Default,,0,0,0,,Cô ấy chỉ để lại...
Dialogue: 0,0:15:55.25,0:15:56.21,Default,,0,0,0,,bức thư này.
Dialogue: 0,0:16:02.75,0:16:05.09,Default,,0,0,0,,GỬI ANH AMAMIYA
Dialogue: 0,0:16:07.80,0:16:09.09,Default,,0,0,0,,Trong thư cô ấy viết gì?
Dialogue: 0,0:16:15.02,0:16:18.44,Default,,0,0,0,,"Em thực sự xin lỗi vì đã giấu không nói cho anh biết\Nvề chuyện khoản nợ của gia đình.
Dialogue: 0,0:16:19.19,0:16:22.24,Default,,0,0,0,,Khi em thưa chuyện với bố mẹ\Nrằng em muốn kết hôn cùng anh,
Dialogue: 0,0:16:22.73,0:16:24.19,Default,,0,0,0,,ông bà đã kịch liệt phản đối.
Dialogue: 0,0:16:24.94,0:16:26.23,Default,,0,0,0,,Em sẽ trở về Seoul.
Dialogue: 0,0:16:26.78,0:16:29.07,Default,,0,0,0,,Và phụ giúp bố mẹ mở lại quán ăn của gia đình.
Dialogue: 0,0:16:30.11,0:16:31.57,Default,,0,0,0,,Em không thể bỏ mặc gia đình mình
Dialogue: 0,0:16:32.32,0:16:33.70,Default,,0,0,0,,để lấy anh được.
Dialogue: 0,0:16:35.08,0:16:36.25,Default,,0,0,0,,Em thực sự rất xin lỗi anh."
Dialogue: 0,0:16:42.17,0:16:43.13,Default,,0,0,0,,Yoona...
Dialogue: 0,0:16:48.42,0:16:50.01,Default,,0,0,0,,Sau biến cố đó, cậu Amamiya dồn toàn bộ
Dialogue: 0,0:16:50.47,0:16:52.56,Default,,0,0,0,,thời gian và tâm huyết vào công việc nghiên cứu
Dialogue: 0,0:16:52.89,0:16:55.94,Default,,0,0,0,,và từ chối tất cả những buổi xem mắt\Ndo gia đình sắp đặt.
Dialogue: 0,0:17:09.95,0:17:10.87,Default,,0,0,0,,Đó chẳng phải là...?
Dialogue: 0,0:17:11.32,0:17:12.16,Default,,0,0,0,,Nhìn kìa.
Dialogue: 0,0:17:13.20,0:17:15.87,Default,,0,0,0,,AMAMIYA, NGƯỜI NHẬT THỨ BA\NGIÀNH ĐƯỢC GIẢI THƯỞNG VẬT LÝ DANH GIÁ
Dialogue: 0,0:17:23.04,0:17:24.54,Default,,0,0,0,,- Của quý khách đây.\N- Cảm ơn.
Dialogue: 0,0:17:28.38,0:17:29.30,Default,,0,0,0,,Mời dùng bữa.
Dialogue: 0,0:17:32.59,0:17:35.26,Default,,0,0,0,,Tôi chợt nhớ ở Seoul có một quán ăn nhỏ
Dialogue: 0,0:17:35.68,0:17:38.02,Default,,0,0,0,,làm món cơm trứng cuộn omurice cực kỳ ngon.
Dialogue: 0,0:17:39.10,0:17:41.19,Default,,0,0,0,,Thật sao? Ở Hàn Quốc mà cũng có món cơm trứng cuộn kiểu Nhật à?
Dialogue: 0,0:17:42.60,0:17:44.69,Default,,0,0,0,,Đó là món tủ làm nên tên tuổi của cô đầu bếp ở quán đó đấy.
Dialogue: 0,0:17:45.73,0:17:47.11,Default,,0,0,0,,Nghe đâu cô ấy đã học cách làm món này khi còn ở Tokyo.
Dialogue: 0,0:18:18.56,0:18:20.15,Default,,0,0,0,,Của quý khách đây ạ.
Dialogue: 0,0:18:20.52,0:18:23.90,Default,,0,0,0,,- Chính là món này hả?\N- Cậu ăn thử đi. Ngon tuyệt cú mèo luôn đấy.
Dialogue: 0,0:18:23.98,0:18:24.98,Default,,0,0,0,,Cho gọi thêm một phần nữa nhé.
Dialogue: 0,0:18:27.06,0:18:28.31,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:18:53.13,0:18:55.22,Default,,0,0,0,,Cuối cùng anh cũng tìm thấy em rồi.
Dialogue: 0,0:18:59.93,0:19:01.60,Default,,0,0,0,,Anh cần có em trong đời.
Dialogue: 0,0:19:05.19,0:19:08.36,Default,,0,0,0,,Chà, lãng mạn ghê chưa kìa.
Dialogue: 0,0:19:09.69,0:19:12.86,Default,,0,0,0,,Ông chú ơi, ông lớn tuổi rồi mà còn sến súa thế.
Dialogue: 0,0:19:12.94,0:19:14.65,Default,,0,0,0,,Tỏ tình giữa ban ngày ban mặt thế này luôn hả?
Dialogue: 0,0:19:19.20,0:19:22.20,Default,,0,0,0,,Ăn nói cho cẩn thận cái mồm đấy.
Dialogue: 0,0:19:22.83,0:19:25.67,Default,,0,0,0,,Đây không phải chuyện của mấy người.
Dialogue: 0,0:19:26.92,0:19:28.13,Default,,0,0,0,,Cậu ta đang nói cái gì thế?
Dialogue: 0,0:19:28.58,0:19:31.79,Default,,0,0,0,,Hai chúng tôi... đang yêu nhau say đắm đấy.
Dialogue: 0,0:19:34.59,0:19:36.68,Default,,0,0,0,,Tụi mình đi thôi.
Dialogue: 0,0:19:41.22,0:19:42.31,Default,,0,0,0,,Anh Amamiya.
Dialogue: 0,0:19:44.06,0:19:46.35,Default,,0,0,0,,Em xin lỗi, nhưng ngay lúc này...
Dialogue: 0,0:19:47.10,0:19:48.44,Default,,0,0,0,,em vẫn chưa thể đón nhận tình cảm của anh được.
Dialogue: 0,0:19:49.94,0:19:52.82,Default,,0,0,0,,- Yoona...\N- Nhưng xin anh hãy luôn nhớ rằng
Dialogue: 0,0:19:53.65,0:19:56.24,Default,,0,0,0,,em chưa bao giờ ước giá như hai chúng ta được sinh ra
Dialogue: 0,0:19:57.40,0:19:58.86,Default,,0,0,0,,cùng một đất nước.
Dialogue: 0,0:20:00.53,0:20:02.74,Default,,0,0,0,,Bởi chính nhờ việc em được sinh ra ở một đất nước khác,
Dialogue: 0,0:20:03.79,0:20:06.71,Default,,0,0,0,,nên em mới có cơ hội được gặp gỡ anh.
Dialogue: 0,0:20:12.13,0:20:14.01,Default,,0,0,0,,Cảm ơn anh vì đã vượt đường xa tìm đến đây.
Dialogue: 0,0:20:50.29,0:20:51.46,Default,,0,0,0,,Của quý khách đây. Chúc quý khách ngon miệng.
Dialogue: 0,0:20:56.00,0:20:57.63,Default,,0,0,0,,Để tôi nướng thịt giúp mọi người nhé?
Dialogue: 0,0:21:07.52,0:21:10.40,Default,,0,0,0,,- Của cậu đây.\N- Cháu cảm ơn bác.
Dialogue: 0,0:21:10.94,0:21:13.99,Default,,0,0,0,,Món canh hầm jjigae ngon tuyệt vời luôn đấy, thưa Mẹ.
Dialogue: 0,0:21:14.82,0:21:16.03,Default,,0,0,0,,Mẹ ư?
Dialogue: 0,0:21:19.44,0:21:21.90,Default,,0,0,0,,Cậu gọi tôi như thế là hơi bị sớm quá rồi đấy nhé.
Dialogue: 0,0:21:28.41,0:21:32.16,Default,,0,0,0,,Tôi nghe nói cậu Amamiya đã quyết tâm\Nsẽ kiên trì lui tới phụ giúp quán ăn đó
Dialogue: 0,0:21:32.58,0:21:35.25,Default,,0,0,0,,cho đến tận khi nào bố mẹ Yoona chịu chấp thuận\Nhôn sự của hai người,
Dialogue: 0,0:21:35.75,0:21:38.21,Default,,0,0,0,,song song với công việc nghiên cứu của cậu ấy tại Seoul.
Dialogue: 0,0:21:43.72,0:21:45.18,Default,,0,0,0,,Kiếp nhân sinh cũng giống như cánh bèo trôi nổi
Dialogue: 0,0:21:46.68,0:21:49.81,Default,,0,0,0,,bị cuốn đi theo dòng chảy\Ncủa con sông Imjin vậy.
Dialogue: 0,0:21:51.94,0:21:53.57,Default,,0,0,0,,Tình yêu vốn chẳng có biên giới.
Dialogue: 0,0:21:54.06,0:21:55.69,Default,,0,0,0,,Hãy cứ kiên trì bơi đến tận bến bờ cuối cùng nhé.
Dialogue: 0,0:22:14.96,0:22:17.25,Default,,0,0,0,,Để làm ra một lớp trứng tráng bông xốp mềm mịn,
Dialogue: 0,0:22:17.34,0:22:20.51,Default,,0,0,0,,hãy nhớ cho thật nhiều bơ vào chảo.
Dialogue: 0,0:22:20.59,0:22:22.88,Default,,0,0,0,,- Của cô đây.\N- Cảm ơn ông chủ.
Dialogue: 0,0:22:24.80,0:22:25.84,Default,,0,0,0,,Chúc cô ngon miệng.
Dialogue: 0,0:22:30.89,0:22:32.68,Default,,0,0,0,,Dục tốc thì...
Dialogue: 0,0:22:33.69,0:22:35.03,Default,,0,0,0,,Bất đạt.
Dialogue: 0,0:22:37.77,0:22:40.40,Default,,0,0,0,,Chúc mọi người ngủ ngon.
Dialogue: 0,0:23:49.05,0:23:53.89,Default,,0,0,0,,CÂU CHUYỆN NÀY CHỈ LÀ HƯ CẤU
