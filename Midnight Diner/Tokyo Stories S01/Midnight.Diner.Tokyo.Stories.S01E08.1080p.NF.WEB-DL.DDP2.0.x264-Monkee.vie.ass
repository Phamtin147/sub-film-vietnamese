Dialogue: 0,0:01:03.69,0:01:05.40,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:05.48,0:01:08.11,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:08.86,0:01:10.28,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:28.05,0:01:30.76,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:31.30,0:01:32.72,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:33.80,0:01:36.80,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:41.52,0:01:42.85,Default,,0,0,0,,Bạn hỏi liệu có khách khứa nào ghé không ư?
Dialogue: 0,0:01:43.52,0:01:45.15,Default,,0,0,0,,Đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:48.61,0:01:52.03,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN ĐỜI TOKYO
Dialogue: 0,0:01:52.11,0:01:55.86,Default,,0,0,0,,KHOAI MÀI ÁP CHẢO
Dialogue: 0,0:01:58.66,0:01:59.70,Default,,0,0,0,,Tao nghĩ đúng là con nhỏ Ami rồi.
Dialogue: 0,0:02:00.37,0:02:01.87,Default,,0,0,0,,Tao cũng chẳng biết nữa...
Dialogue: 0,0:02:01.96,0:02:03.34,Default,,0,0,0,,Trông giống nó như đúc còn gì.
Dialogue: 0,0:02:03.41,0:02:06.12,Default,,0,0,0,,- Nhìn cặp môi của cổ xem.\N- Nhưng mà...
Dialogue: 0,0:02:06.21,0:02:07.96,Default,,0,0,0,,Tao không tin Ami lại đi đóng cái thứ đó đâu.
Dialogue: 0,0:02:09.09,0:02:10.26,Default,,0,0,0,,Này Ông chủ.
Dialogue: 0,0:02:11.80,0:02:13.09,Default,,0,0,0,,Ông chủ thấy sao ạ?
Dialogue: 0,0:02:13.88,0:02:15.76,Default,,0,0,0,,Cậu này khăng khăng cô gái trong hình là Ami.
Dialogue: 0,0:02:15.84,0:02:19.05,Default,,0,0,0,,Ông chủ còn nhớ Ami không?\NCổ từng là hát chính trong ban nhạc của tụi cháu đấy.
Dialogue: 0,0:02:19.56,0:02:21.35,Default,,0,0,0,,Tụi cháu từng dẫn cổ tới quán mình vài lần rồi mà.
Dialogue: 0,0:02:21.89,0:02:23.39,Default,,0,0,0,,Trông cũng có nét giống thật.
Dialogue: 0,0:02:24.10,0:02:25.39,Default,,0,0,0,,Nhưng tôi cũng không dám chắc.
Dialogue: 0,0:02:27.86,0:02:31.20,Default,,0,0,0,,- Sao mày không tải video về luôn đi?\N- Ý hay đấy.
Dialogue: 0,0:02:31.28,0:02:32.57,Default,,0,0,0,,Anh em mình phải soi cho thật kỹ mới được.
Dialogue: 0,0:02:33.28,0:02:34.78,Default,,0,0,0,,Thống nhất thế nhé?
Dialogue: 0,0:02:35.28,0:02:36.41,Default,,0,0,0,,Tất cả kéo về phòng tao đi.
Dialogue: 0,0:02:40.70,0:02:41.74,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn nhé.
Dialogue: 0,0:02:43.71,0:02:46.17,Default,,0,0,0,,Bắt taxi đi cho lẹ.
Dialogue: 0,0:02:47.92,0:02:49.21,Default,,0,0,0,,Vụ gì mà rôm rả thế?
Dialogue: 0,0:02:50.13,0:02:53.97,Default,,0,0,0,,Có cô bé tên Ami từng là hoa khôi\Nhồi mấy cậu nhóc đó còn học đại học.
Dialogue: 0,0:02:54.05,0:02:56.43,Default,,0,0,0,,Ra vậy. Giờ cô nàng đi đóng phim người lớn hả?
Dialogue: 0,0:02:56.51,0:02:57.89,Default,,0,0,0,,Bởi thế mấy cậu chàng mới nháo nhào cả lên.
Dialogue: 0,0:02:57.97,0:03:01.27,Default,,0,0,0,,À nhắc tới phim người lớn,\Nanh Oki đang được lên báo đây này.
Dialogue: 0,0:03:03.52,0:03:06.98,Default,,0,0,0,,Chà, ngưỡng mộ thật đấy.
Dialogue: 0,0:03:10.19,0:03:11.03,Default,,0,0,0,,Mời hai vị vào trong ạ.
Dialogue: 0,0:03:13.03,0:03:13.86,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:03:15.28,0:03:18.20,Default,,0,0,0,,Đây là ngài Hisamatsu,\NGiám đốc Công ty In ấn Hisamatsu.
Dialogue: 0,0:03:18.28,0:03:21.66,Default,,0,0,0,,Còn đây là phu nhân Fujiko.\NNgài ấy là khách hàng lớn nhất của em đấy.
Dialogue: 0,0:03:22.04,0:03:23.58,Default,,0,0,0,,Chào mọi người, tôi là Hisamatsu.
Dialogue: 0,0:03:24.16,0:03:26.87,Default,,0,0,0,,Cô Rumi có kể với tôi\Nlà ở đây có một quán ăn đêm rất độc đáo.
Dialogue: 0,0:03:26.96,0:03:28.63,Default,,0,0,0,,Thế nên tôi mới nhờ cô ấy dẫn vợ chồng tôi tới đây.
Dialogue: 0,0:03:31.54,0:03:33.38,Default,,0,0,0,,Mình uống sake hâm nóng nhé? Được không?
Dialogue: 0,0:03:34.21,0:03:35.05,Default,,0,0,0,,Fujiko?
Dialogue: 0,0:03:35.59,0:03:37.97,Default,,0,0,0,,- Vâng, được chứ ạ.\N- Thế thì cho em một bình luôn nhé.
Dialogue: 0,0:03:38.05,0:03:40.72,Default,,0,0,0,,- Sake hâm nóng. Có ngay.\N- Nghe nói ở đây khách gọi món gì...
Dialogue: 0,0:03:40.80,0:03:43.14,Default,,0,0,0,,Ông chủ cũng đều làm được hết,\Ncó đúng thế không?
Dialogue: 0,0:03:44.14,0:03:47.48,Default,,0,0,0,,- Vâng, miễn là trong bếp có sẵn nguyên liệu.\N- Em có muốn gọi món gì không, Fujiko?
Dialogue: 0,0:03:48.39,0:03:49.48,Default,,0,0,0,,Để em xem nào...
Dialogue: 0,0:03:53.19,0:03:54.23,Default,,0,0,0,,Mình ơi,
Dialogue: 0,0:03:54.32,0:03:56.91,Default,,0,0,0,,em nghe nói Ông chủ ở đây làm món khoai mài áp chảo ngon lắm đấy.
Dialogue: 0,0:03:57.24,0:03:59.58,Default,,0,0,0,,Anh cũng mê món đó thật, nhưng mà...
Dialogue: 0,0:04:00.24,0:04:02.24,Default,,0,0,0,,Không sao đâu mà. Mình gọi món đó đi.
Dialogue: 0,0:04:03.79,0:04:06.21,Default,,0,0,0,,Ông chủ, làm ơn cho tụi em một phần khoai mài áp chảo nhé.
Dialogue: 0,0:04:06.29,0:04:07.21,Default,,0,0,0,,Vâng, có ngay.
Dialogue: 0,0:04:32.06,0:04:33.10,Default,,0,0,0,,Món của quý khách đây.
Dialogue: 0,0:04:46.91,0:04:48.12,Default,,0,0,0,,Sao ạ, ngài thấy hương vị thế nào?
Dialogue: 0,0:04:53.04,0:04:54.25,Default,,0,0,0,,Thật lòng xin lỗi Ông chủ,
Dialogue: 0,0:04:54.88,0:04:56.72,Default,,0,0,0,,nhưng món khoai mài vợ tôi làm vẫn ngon hơn.
Dialogue: 0,0:04:57.84,0:04:59.09,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:04:59.88,0:05:01.09,Default,,0,0,0,,Xem ra tay nghề của tôi không sánh bằng phu nhân rồi nhỉ?
Dialogue: 0,0:05:02.22,0:05:03.43,Default,,0,0,0,,Không sánh bằng được đâu.
Dialogue: 0,0:05:03.97,0:05:05.43,Default,,0,0,0,,Ảnh nói quá lên đấy.
Dialogue: 0,0:05:05.72,0:05:07.97,Default,,0,0,0,,Món Ông chủ làm ngon hơn của tôi nhiều.
Dialogue: 0,0:05:08.43,0:05:11.73,Default,,0,0,0,,Ở nhà tôi chỉ bỏ bơ vào áp chảo khoai mài,\Nchứ có bí quyết gì đâu.
Dialogue: 0,0:05:11.81,0:05:13.73,Default,,0,0,0,,Chính cái sự mộc mạc đó mới làm nên vị ngon đấy.
Dialogue: 0,0:05:14.31,0:05:16.90,Default,,0,0,0,,Nhà tôi lúc nào cũng chiều chuộng tôi quá mức.
Dialogue: 0,0:05:17.65,0:05:20.78,Default,,0,0,0,,Phu nhân được ngài ấy cưng chiều hết mực nhỉ?
Dialogue: 0,0:05:20.86,0:05:22.11,Default,,0,0,0,,Em phát ghen tị với phu nhân đấy.
Dialogue: 0,0:05:22.20,0:05:24.87,Default,,0,0,0,,Tôi phải nâng niu bà ấy chứ.\NKhông thương chiều là mang tội đấy.
Dialogue: 0,0:05:26.16,0:05:30.37,Default,,0,0,0,,Tôi đem lòng yêu bà ấy\Ntừ hồi bà ấy còn là một cô sinh viên.
Dialogue: 0,0:05:31.21,0:05:33.21,Default,,0,0,0,,Chính tôi đã năn nỉ cầu hôn bà ấy.
Dialogue: 0,0:05:34.21,0:05:36.38,Default,,0,0,0,,Hồi đó bà ấy còn chẳng biết\Nnấu nướng là gì.
Dialogue: 0,0:05:36.46,0:05:39.92,Default,,0,0,0,,Tôi cũng chẳng để cho bà ấy có thời gian\Nmà học nữ công gia chánh nữa.
Dialogue: 0,0:05:40.76,0:05:43.10,Default,,0,0,0,,Mọi người thấy chưa? Tới giờ ảnh vẫn cứ chiều hư tôi như thế đấy.
Dialogue: 0,0:05:43.68,0:05:45.35,Default,,0,0,0,,Ngưỡng mộ hai vị thật đấy.
Dialogue: 0,0:05:45.85,0:05:48.14,Default,,0,0,0,,Nếu là vợ chồng son thì đã đành, đằng này...
Dialogue: 0,0:05:48.22,0:05:49.39,Default,,0,0,0,,hai vị đã cưới nhau được bao lâu rồi nhỉ?
Dialogue: 0,0:05:49.81,0:05:52.06,Default,,0,0,0,,Hai mươi ba năm bốn tháng rồi.
Dialogue: 0,0:05:57.02,0:05:57.90,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:05:58.52,0:06:00.52,Default,,0,0,0,,Anh Oki, em có đọc bài báo viết về anh rồi đấy.
Dialogue: 0,0:06:01.11,0:06:03.11,Default,,0,0,0,,Cảm ơn cậu. Chào Ông chủ,
Dialogue: 0,0:06:03.20,0:06:05.58,Default,,0,0,0,,- cho tôi một cốc bia và một phần salad khoai tây nhé.\N- Có ngay.
Dialogue: 0,0:06:08.66,0:06:10.91,Default,,0,0,0,,Như nhiều người đã biết,
Dialogue: 0,0:06:11.00,0:06:14.09,Default,,0,0,0,,anh "Oki Khổng Lồ" là\Nmột ngôi sao phim người lớn lừng danh
Dialogue: 0,0:06:14.17,0:06:16.30,Default,,0,0,0,,với vô số giai thoại huyền thoại trong nghề.
Dialogue: 0,0:06:16.38,0:06:19.68,Default,,0,0,0,,Anh Oki này, nghe nói cô Yukino Miku đã đích thân chọn anh
Dialogue: 0,0:06:19.75,0:06:21.67,Default,,0,0,0,,làm bạn diễn trong bộ phim giã từ sự nghiệp của cô ấy hả?
Dialogue: 0,0:06:21.76,0:06:23.51,Default,,0,0,0,,Em ghen tị với anh thật đấy, anh Oki.
Dialogue: 0,0:06:23.59,0:06:25.97,Default,,0,0,0,,Anh luôn được lòng\Nmấy cô diễn viên trẻ đẹp như thế.
Dialogue: 0,0:06:26.05,0:06:28.26,Default,,0,0,0,,- Cũng chỉ là công việc thôi mà.\N- Thì em biết thế.
Dialogue: 0,0:06:28.35,0:06:31.27,Default,,0,0,0,,Nhưng dù sao anh cũng được đóng cảnh thân mật\Nvới bao nhiêu cô gái trẻ đẹp còn gì.
Dialogue: 0,0:06:31.35,0:06:33.89,Default,,0,0,0,,Tính đến giờ anh đã hợp tác\Nvới bao nhiêu phụ nữ rồi?
Dialogue: 0,0:06:34.31,0:06:36.40,Default,,0,0,0,,Chà, tôi cũng không nhớ rõ nữa.
Dialogue: 0,0:06:36.48,0:06:37.48,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:06:39.69,0:06:43.11,Default,,0,0,0,,Từ lúc chạm mốc một ngàn người,\Ntôi cũng chẳng buồn đếm nữa.
Dialogue: 0,0:06:43.19,0:06:48.49,Default,,0,0,0,,Bái phục anh luôn.\NThế anh có nhớ hết từng người trong số họ không?
Dialogue: 0,0:06:49.41,0:06:50.58,Default,,0,0,0,,Làm sao mà nhớ xuể.
Dialogue: 0,0:06:51.12,0:06:52.58,Default,,0,0,0,,- Nhưng mà...\N- Nhưng sao cơ?
Dialogue: 0,0:06:55.29,0:06:57.67,Default,,0,0,0,,Tôi không thể nhớ hết từng gương mặt hay tên tuổi...
Dialogue: 0,0:06:58.58,0:06:59.92,Default,,0,0,0,,nhưng mùi hương cơ thể họ,
Dialogue: 0,0:07:00.63,0:07:04.09,Default,,0,0,0,,những tiếng rên siết đê mê,\Nđường nét cơ thể của từng người...
Dialogue: 0,0:07:04.67,0:07:06.13,Default,,0,0,0,,tôi đều nhớ rất rõ những chi tiết ấy.
Dialogue: 0,0:07:06.63,0:07:09.43,Default,,0,0,0,,Đôi khi tôi còn chẳng nhận ra\Nbạn diễn cũ của mình
Dialogue: 0,0:07:09.51,0:07:11.51,Default,,0,0,0,,cho đến khi cảm nhận lại được những giác quan đó.
Dialogue: 0,0:07:12.81,0:07:15.77,Default,,0,0,0,,- Em xin lỗi.\N- Em làm đổ rượu lên áo kimono rồi hả?
Dialogue: 0,0:07:17.23,0:07:18.86,Default,,0,0,0,,Áo kimono không sao đâu ạ. Em xin lỗi mọi người.
Dialogue: 0,0:07:19.23,0:07:21.15,Default,,0,0,0,,Hay là vợ chồng mình về thôi nhé?
Dialogue: 0,0:07:21.73,0:07:22.69,Default,,0,0,0,,Vâng.
Dialogue: 0,0:07:23.61,0:07:25.61,Default,,0,0,0,,Ông chủ tính tiền giùm tôi nhé.
Dialogue: 0,0:07:26.99,0:07:29.03,Default,,0,0,0,,- Để em tiễn hai vị ra ngoài.\N- Không cần khách sáo thế đâu.
Dialogue: 0,0:07:29.53,0:07:32.24,Default,,0,0,0,,- Ông chủ, cảm ơn vì bữa ăn nhé.\N- Cảm ơn quý khách đã ghé quán.
Dialogue: 0,0:07:47.18,0:07:48.22,Default,,0,0,0,,Thiệt tình, mấy cái anh này.
Dialogue: 0,0:07:48.30,0:07:51.01,Default,,0,0,0,,Mấy anh nói chuyện dung tục quá\Nlàm vợ chồng người ta ngại bỏ về luôn kìa.
Dialogue: 0,0:07:51.30,0:07:53.93,Default,,0,0,0,,Dung tục gì đâu? Tôi chỉ đang hỏi chuyện\Nsự nghiệp của anh Oki thôi mà.
Dialogue: 0,0:07:54.89,0:07:56.35,Default,,0,0,0,,Cô nói thế là thiếu tôn trọng anh Oki đấy.
Dialogue: 0,0:07:57.31,0:07:59.69,Default,,0,0,0,,Em xin lỗi. Em không có ý đó đâu ạ.
Dialogue: 0,0:07:59.77,0:08:00.94,Default,,0,0,0,,Không sao đâu cô.
Dialogue: 0,0:08:01.61,0:08:04.24,Default,,0,0,0,,Làm tình mà cứ đạo mạo lễ nghĩa quá thì còn gì là thú vị nữa.
Dialogue: 0,0:08:23.84,0:08:26.64,Default,,0,0,0,,Miku tặng anh bó hoa này luôn hả?\NAnh sướng thật đấy.
Dialogue: 0,0:08:28.38,0:08:29.51,Default,,0,0,0,,Tôi tặng lại cho cậu đấy.
Dialogue: 0,0:08:29.59,0:08:31.26,Default,,0,0,0,,Anh nói thật chứ?
Dialogue: 0,0:08:31.34,0:08:34.09,Default,,0,0,0,,Em là fan cuồng của Yukino Miku đấy ạ.
Dialogue: 0,0:08:34.18,0:08:35.72,Default,,0,0,0,,Của anh đây. Chúc ngon miệng.
Dialogue: 0,0:08:37.68,0:08:39.77,Default,,0,0,0,,Giờ giải nghệ rồi thì cô ấy định làm gì?
Dialogue: 0,0:08:40.19,0:08:42.48,Default,,0,0,0,,Nghe bảo cô ấy sang Paris học thiết kế thời trang.
Dialogue: 0,0:08:42.56,0:08:44.65,Default,,0,0,0,,Chà, giỏi thật đấy.
Dialogue: 0,0:08:45.27,0:08:49.86,Default,,0,0,0,,Nhiều cô gái sau khi rút lui khỏi ngành phim người lớn\Nthường chẳng có được một sự nghiệp suôn sẻ.
Dialogue: 0,0:08:50.53,0:08:51.95,Default,,0,0,0,,Nên tôi thực lòng mong cô ấy sẽ thành công.
Dialogue: 0,0:08:52.78,0:08:54.82,Default,,0,0,0,,- Sao thế?\N- Ngon tuyệt.
Dialogue: 0,0:08:54.91,0:08:56.33,Default,,0,0,0,,Anh Oki, đĩa này của anh đây.
Dialogue: 0,0:09:05.42,0:09:06.46,Default,,0,0,0,,Có chuyện gì thế anh?
Dialogue: 0,0:09:16.64,0:09:18.85,Default,,0,0,0,,Anh có sao không đấy, anh Oki?
Dialogue: 0,0:09:20.06,0:09:21.23,Default,,0,0,0,,À không...
Dialogue: 0,0:09:26.82,0:09:27.78,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:09:51.72,0:09:53.60,Default,,0,0,0,,Hả? Sao lại thế được?
Dialogue: 0,0:09:54.05,0:09:56.34,Default,,0,0,0,,- Sao hai người đó lại đứng cùng nhau?\N- Cứ bình tĩnh nghe em kể đã.
Dialogue: 0,0:09:56.85,0:09:58.69,Default,,0,0,0,,"Giờ thì anh đã nhớ ra tôi chưa?"
Dialogue: 0,0:09:58.76,0:10:01.56,Default,,0,0,0,,"Tại lúc nãy tôi không nhận ra cô thôi."\NHai người họ đã nói với nhau như thế đấy.
Dialogue: 0,0:10:01.64,0:10:03.98,Default,,0,0,0,,Là sao cơ?\NHai người họ từng quen biết nhau ư?
Dialogue: 0,0:10:04.06,0:10:06.73,Default,,0,0,0,,- Bà Fujiko và anh Oki á?\N- Em đoán là vậy.
Dialogue: 0,0:10:07.27,0:10:09.61,Default,,0,0,0,,Sao lúc đó em không hỏi thẳng luôn đi?
Dialogue: 0,0:10:09.69,0:10:12.11,Default,,0,0,0,,Tất nhiên là tụi em có gặng hỏi rồi. Đúng không?
Dialogue: 0,0:10:12.49,0:10:15.91,Default,,0,0,0,,Nhưng ai trong đời mà chẳng có đôi ba chuyện\Nkhông muốn nhắc lại.
Dialogue: 0,0:10:16.49,0:10:17.41,Default,,0,0,0,,Hả?
Dialogue: 0,0:10:17.91,0:10:19.41,Default,,0,0,0,,Đừng bảo là ý chị đang nói...
Dialogue: 0,0:10:19.95,0:10:21.99,Default,,0,0,0,,Có đúng như em nghĩ không?
Dialogue: 0,0:10:22.71,0:10:24.42,Default,,0,0,0,,Hiểu rồi. Là đóng phim người lớn chứ gì.
Dialogue: 0,0:10:30.17,0:10:32.34,Default,,0,0,0,,Chuyện đó là từ khi nào nhỉ?
Dialogue: 0,0:10:33.42,0:10:35.05,Default,,0,0,0,,Hai mươi ba năm về trước.
Dialogue: 0,0:10:35.80,0:10:37.51,Default,,0,0,0,,Cũng đã lâu lắm rồi nhỉ?
Dialogue: 0,0:10:39.51,0:10:42.64,Default,,0,0,0,,Thực ra hồi đó tôi đã rất ngạc nhiên\Nkhi một nữ diễn viên mới đóng lần đầu
Dialogue: 0,0:10:42.73,0:10:44.19,Default,,0,0,0,,lại đích thân chỉ định tôi làm bạn diễn.
Dialogue: 0,0:10:47.27,0:10:48.56,Default,,0,0,0,,Thế cô kết hôn từ năm nào?
Dialogue: 0,0:10:50.40,0:10:51.90,Default,,0,0,0,,Cũng hai mươi ba năm trước.
Dialogue: 0,0:10:52.44,0:10:56.61,Default,,0,0,0,,Vậy có nghĩa là\Nlúc đóng bộ phim đó cô đã đính hôn rồi sao?
Dialogue: 0,0:10:57.37,0:10:59.71,Default,,0,0,0,,Vâng, tôi đến trường quay...
Dialogue: 0,0:11:00.16,0:11:03.62,Default,,0,0,0,,ngay sau khi vừa đi thử\Nváy cưới xong.
Dialogue: 0,0:11:03.70,0:11:04.53,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:11:06.42,0:11:08.26,Default,,0,0,0,,Chồng cô có biết chuyện đó không?
Dialogue: 0,0:11:09.13,0:11:10.26,Default,,0,0,0,,Không ạ.
Dialogue: 0,0:11:11.50,0:11:14.00,Default,,0,0,0,,Nếu biết tôi từng đóng phim người lớn,
Dialogue: 0,0:11:14.88,0:11:16.67,Default,,0,0,0,,chắc chắn anh ấy đã không cưới tôi đâu,
Dialogue: 0,0:11:16.76,0:11:19.10,Default,,0,0,0,,dù anh ấy có yêu tôi\Nnhiều đến nhường nào đi chăng nữa.
Dialogue: 0,0:11:22.89,0:11:27.06,Default,,0,0,0,,Có người đồn rằng đó là một cuộc hôn nhân\Nvì mục đích thương trường.
Dialogue: 0,0:11:27.14,0:11:30.06,Default,,0,0,0,,Để đổi lấy việc cưới Fujiko,
Dialogue: 0,0:11:30.15,0:11:33.32,Default,,0,0,0,,ông Hisamatsu đã ra tay cứu công ty của bố Fujiko\Nthoát khỏi cảnh phá sản.
Dialogue: 0,0:11:34.03,0:11:35.12,Default,,0,0,0,,Ra là thế.
Dialogue: 0,0:11:35.69,0:11:38.40,Default,,0,0,0,,Cô ấy bị ép phải lấy\Nmột người đàn ông mình không hề yêu.
Dialogue: 0,0:11:38.49,0:11:40.62,Default,,0,0,0,,Trong cơn tuyệt vọng,\Ncô ấy mới liều mình đi đóng phim người lớn.
Dialogue: 0,0:11:40.70,0:11:42.99,Default,,0,0,0,,- Nghe hợp lý phết đấy chứ.\N- Không phải thế đâu.
Dialogue: 0,0:11:43.08,0:11:45.29,Default,,0,0,0,,Hai vợ chồng họ thực sự rất mực yêu thương nhau.
Dialogue: 0,0:11:45.37,0:11:48.00,Default,,0,0,0,,Thì bây giờ có thể là vậy, nhưng hồi đó...
Dialogue: 0,0:11:50.88,0:11:53.51,Default,,0,0,0,,Tôi tin chắc cô ấy phải có nỗi niềm riêng nào khác.
Dialogue: 0,0:12:03.64,0:12:06.23,Default,,0,0,0,,Tôi nghĩ trong lòng anh Hisamatsu vẫn luôn hoài nghi
Dialogue: 0,0:12:07.02,0:12:09.31,Default,,0,0,0,,rằng tôi chấp nhận lấy anh ấy
Dialogue: 0,0:12:10.35,0:12:13.15,Default,,0,0,0,,chỉ để cứu công việc làm ăn của cha mình.
Dialogue: 0,0:12:14.11,0:12:15.19,Default,,0,0,0,,Thế ông ấy nghi ngờ có đúng không?
Dialogue: 0,0:12:17.86,0:12:20.07,Default,,0,0,0,,Tôi không thể phủ nhận hoàn toàn điều đó.
Dialogue: 0,0:12:21.32,0:12:22.99,Default,,0,0,0,,Nhưng đó không phải là lý do duy nhất.
Dialogue: 0,0:12:26.00,0:12:29.25,Default,,0,0,0,,Tôi thực sự bị cuốn hút bởi con người anh ấy.
Dialogue: 0,0:12:30.17,0:12:31.38,Default,,0,0,0,,Đó là...
Dialogue: 0,0:12:32.04,0:12:33.33,Default,,0,0,0,,sự thật.
Dialogue: 0,0:12:35.13,0:12:37.63,Default,,0,0,0,,Vậy tại sao cô lại làm chuyện đó?
Dialogue: 0,0:12:41.14,0:12:42.22,Default,,0,0,0,,Khi ấy...
Dialogue: 0,0:12:43.72,0:12:44.97,Default,,0,0,0,,tôi vẫn còn là một cô gái trinh nguyên.
Dialogue: 0,0:12:50.56,0:12:51.90,Default,,0,0,0,,Lúc đó anh có nhận ra không?
Dialogue: 0,0:12:52.77,0:12:54.27,Default,,0,0,0,,Có chứ. Trông cô lúc ấy e ấp và ngượng ngùng lắm.
Dialogue: 0,0:12:57.82,0:13:00.32,Default,,0,0,0,,Đóng cảnh chăn gối với một cô gái còn trinh\Ncũng áp lực ra phết đấy nhỉ?
Dialogue: 0,0:13:01.32,0:13:03.61,Default,,0,0,0,,Trong cái ngành này,\Ngái còn trinh là của hiếm có khó tìm đấy.
Dialogue: 0,0:13:05.45,0:13:07.24,Default,,0,0,0,,Đâu chỉ riêng trong ngành của anh.
Dialogue: 0,0:13:07.33,0:13:10.75,Default,,0,0,0,,Đàn ông trên đời này có biết bao người\Ncoi trọng sự trinh tiết của người phụ nữ.
Dialogue: 0,0:13:12.37,0:13:16.08,Default,,0,0,0,,Tôi từng nghĩ Hisamatsu cũng là một người trong số đó.
Dialogue: 0,0:13:16.67,0:13:17.84,Default,,0,0,0,,Thế nhưng...
Dialogue: 0,0:13:18.38,0:13:21.01,Default,,0,0,0,,tôi lại cảm thấy như vậy thật bất công.
Dialogue: 0,0:13:25.05,0:13:26.51,Default,,0,0,0,,Rất khó để diễn tả thành lời.
Dialogue: 0,0:13:27.39,0:13:28.64,Default,,0,0,0,,Chỉ là tôi không cam lòng.
Dialogue: 0,0:13:29.89,0:13:32.43,Default,,0,0,0,,Một cô gái còn trinh nguyên đi lấy một người đàn ông lớn tuổi\Nđã dày dạn phong trần.
Dialogue: 0,0:13:33.94,0:13:37.03,Default,,0,0,0,,Trong ký ức của anh ấy\Nđã có bóng hình những người phụ nữ trong quá khứ.
Dialogue: 0,0:13:37.65,0:13:39.19,Default,,0,0,0,,Còn tôi thì chưa từng có một ai.
Dialogue: 0,0:13:41.03,0:13:42.99,Default,,0,0,0,,Vậy đây là cuộc hôn nhân thứ hai của ông ấy à?
Dialogue: 0,0:13:45.20,0:13:47.74,Default,,0,0,0,,Người vợ đầu của anh ấy đã qua đời vì bạo bệnh\Ntừ lâu lắm rồi.
Dialogue: 0,0:13:48.58,0:13:51.96,Default,,0,0,0,,Nhưng dù vậy, sao cô lại chọn\Nđi đóng phim người lớn?
Dialogue: 0,0:13:52.46,0:13:54.38,Default,,0,0,0,,Thời điểm đó cô không có người thương nào sao?
Dialogue: 0,0:13:59.42,0:14:00.55,Default,,0,0,0,,Tôi...
Dialogue: 0,0:14:02.97,0:14:04.72,Default,,0,0,0,,đã trúng tiếng sét ái tình ngay từ cái nhìn đầu tiên...
Dialogue: 0,0:14:07.22,0:14:10.60,Default,,0,0,0,,khi vô tình nhìn thấy ảnh của anh trên một cuốn tạp chí.
Dialogue: 0,0:14:16.56,0:14:17.89,Default,,0,0,0,,Chỉ cần một lần gặp gỡ duy nhất,
Dialogue: 0,0:14:18.52,0:14:22.15,Default,,0,0,0,,tôi tin rằng anh sẽ mang lại cho tôi\Ntrải nghiệm khắc cốt ghi tâm nhất trong cuộc đời.
Dialogue: 0,0:14:24.66,0:14:26.16,Default,,0,0,0,,Đối với tôi khi ấy, anh đặc biệt đến nhường vậy đấy.
Dialogue: 0,0:14:30.16,0:14:32.08,Default,,0,0,0,,Tôi vẫn còn giữ...
Dialogue: 0,0:14:34.67,0:14:36.30,Default,,0,0,0,,lá thư của cô.
Dialogue: 0,0:15:23.30,0:15:24.59,Default,,0,0,0,,Cô không nghe máy sao?
Dialogue: 0,0:15:42.73,0:15:44.19,Default,,0,0,0,,Cô nên nghe máy đi.
Dialogue: 0,0:16:02.88,0:16:03.71,Default,,0,0,0,,Alo?
Dialogue: 0,0:16:07.84,0:16:08.88,Default,,0,0,0,,Chồng tôi sao cơ?
Dialogue: 0,0:16:10.01,0:16:11.05,Default,,0,0,0,,Ở bệnh viện nào ạ?
Dialogue: 0,0:16:13.26,0:16:14.47,Default,,0,0,0,,Tôi sẽ đến đó ngay lập tức.
Dialogue: 0,0:16:20.90,0:16:26.20,Default,,0,0,0,,GỬI ANH OKI, CẢM ƠN ANH RẤT NHIỀU.\NĐÓ KHÔNG CHỈ ĐƠN THUẦN LÀ CÔNG VIỆC.
Dialogue: 0,0:16:26.28,0:16:27.57,Default,,0,0,0,,Là thư tình hả anh?
Dialogue: 0,0:16:29.61,0:16:31.03,Default,,0,0,0,,Chỉ là một bức thư cảm ơn thôi.
Dialogue: 0,0:16:31.62,0:16:34.92,Default,,0,0,0,,Cách đây lâu lắm rồi, một cô gái đã gửi nó cho tôi\Nsau khi chúng tôi quay xong một bộ phim.
Dialogue: 0,0:16:35.62,0:16:37.96,Default,,0,0,0,,Thật á? Thư cảm ơn sau khi đóng phim sao?
Dialogue: 0,0:16:38.58,0:16:40.37,Default,,0,0,0,,Đúng là một cô gái lịch sự hiếm thấy.
Dialogue: 0,0:16:42.04,0:16:43.88,Default,,0,0,0,,Đó cũng là bộ phim duy nhất của cô ấy.
Dialogue: 0,0:16:44.67,0:16:46.67,Default,,0,0,0,,Cô ấy chỉ xuất hiện đúng một lần...
Dialogue: 0,0:16:48.09,0:16:49.51,Default,,0,0,0,,rồi biến mất mãi mãi.
Dialogue: 0,0:16:55.89,0:16:58.60,Default,,0,0,0,,Ông chủ, cho em một bình sake.
Dialogue: 0,0:17:00.81,0:17:01.81,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:17:03.77,0:17:05.48,Default,,0,0,0,,Sao thế, nhà ai có đám tang à?
Dialogue: 0,0:17:06.23,0:17:07.69,Default,,0,0,0,,Là ngài Hisamatsu.
Dialogue: 0,0:17:08.32,0:17:10.41,Default,,0,0,0,,Ông ấy qua đời đột ngột vì vỡ phình động mạch chủ.
Dialogue: 0,0:17:18.70,0:17:20.37,Default,,0,0,0,,Người ta kết thúc một ngày
Dialogue: 0,0:17:20.46,0:17:22.46,Default,,0,0,0,,và vội vã trở về nhà.
Dialogue: 0,0:17:23.83,0:17:27.17,Default,,0,0,0,,Nhưng đôi khi, có những người lại chẳng muốn\Nđi thẳng một mạch về nhà.
Dialogue: 0,0:17:27.80,0:17:30.22,Default,,0,0,0,,Thế là họ lại tạt ngang qua một chốn nào đó\Ntrên đường về.
Dialogue: 0,0:17:57.37,0:17:58.79,Default,,0,0,0,,Em còn nhớ...
Dialogue: 0,0:18:00.79,0:18:02.63,Default,,0,0,0,,những lời anh từng hứa khi chúng mình mới cưới nhau không?
Dialogue: 0,0:18:04.25,0:18:08.71,Default,,0,0,0,,"Từ giờ trở đi,\Nanh muốn sống để mang lại hạnh phúc cho em."
Dialogue: 0,0:18:10.09,0:18:11.01,Default,,0,0,0,,Vâng, em nhớ chứ.
Dialogue: 0,0:18:13.18,0:18:16.10,Default,,0,0,0,,Đến tận bây giờ... lòng anh vẫn vẹn nguyên như thế.
Dialogue: 0,0:18:19.68,0:18:21.56,Default,,0,0,0,,Em vẫn đẹp lắm.
Dialogue: 0,0:18:22.81,0:18:23.85,Default,,0,0,0,,Thực sự vô cùng xinh đẹp.
Dialogue: 0,0:18:45.17,0:18:46.17,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:18:48.59,0:18:51.09,Default,,0,0,0,,Mừng quá, chị đây rồi.
Dialogue: 0,0:18:52.55,0:18:55.43,Default,,0,0,0,,Mấy hôm nay không thấy tin tức gì của chị,\Nem đâm ra lo quá.
Dialogue: 0,0:18:58.26,0:19:01.39,Default,,0,0,0,,- Đúng là tai họa ập đến bất ngờ quá.\N- Anh Oki.
Dialogue: 0,0:19:02.35,0:19:04.14,Default,,0,0,0,,Anh có thể dành cho tôi chút thời gian được không?
Dialogue: 0,0:19:05.77,0:19:06.73,Default,,0,0,0,,Đừng là lúc này.
Dialogue: 0,0:19:07.31,0:19:08.19,Default,,0,0,0,,Để ngày mai đi.
Dialogue: 0,0:19:21.24,0:19:24.16,Default,,0,0,0,,Tôi đã tìm thấy những chiếc đĩa này\Nkhi dọn dẹp di vật của chồng tôi.
Dialogue: 0,0:19:33.71,0:19:35.09,Default,,0,0,0,,Anh cứ mở ra xem đi.
Dialogue: 0,0:19:46.64,0:19:49.81,Default,,0,0,0,,BÍ MẬT CỦA NÀNG TIỂU THƯ KHUÊ CÁC
Dialogue: 0,0:19:55.11,0:19:56.78,Default,,0,0,0,,Tất cả chỗ này đều là cùng một bộ phim sao?
Dialogue: 0,0:20:13.13,0:20:14.84,Default,,0,0,0,,"Tôi không thể gặp lại anh được nữa rồi.
Dialogue: 0,0:20:14.92,0:20:17.92,Default,,0,0,0,,Tôi có cảm giác như anh ấy vẫn luôn\Ndõi theo tôi từ trên cao."
Dialogue: 0,0:20:18.01,0:20:19.89,Default,,0,0,0,,Fujiko đã nói với anh ấy như vậy đấy.
Dialogue: 0,0:20:22.05,0:20:23.51,Default,,0,0,0,,Cho tôi thêm một bình sake nóng nữa.
Dialogue: 0,0:20:24.77,0:20:25.77,Default,,0,0,0,,Thôi xin thứ lỗi.
Dialogue: 0,0:20:26.31,0:20:27.98,Default,,0,0,0,,Anh đã uống hết ba bình rồi đấy.
Dialogue: 0,0:20:29.65,0:20:31.69,Default,,0,0,0,,Của anh đây. Chúc ngon miệng.
Dialogue: 0,0:20:40.99,0:20:44.66,Default,,0,0,0,,"Thật lòng xin lỗi Ông chủ,\Nnhưng món khoai mài vợ tôi làm vẫn ngon hơn."
Dialogue: 0,0:20:47.20,0:20:49.08,Default,,0,0,0,,"Nhà tôi lúc nào cũng chiều chuộng tôi quá mức."
Dialogue: 0,0:20:52.54,0:20:53.83,Default,,0,0,0,,Fujiko từng nói như vậy...
Dialogue: 0,0:20:54.50,0:20:56.75,Default,,0,0,0,,khi nhắc về người chồng của mình.
Dialogue: 0,0:21:06.52,0:21:07.44,Default,,0,0,0,,Ổng ở đằng kia kìa.
Dialogue: 0,0:21:11.10,0:21:12.43,Default,,0,0,0,,Ông là Oki Khổng Lồ đúng không?
Dialogue: 0,0:21:14.44,0:21:15.65,Default,,0,0,0,,OKI KHỔNG LỒ ĐẠI CHIẾN THIẾU PHỤ
Dialogue: 0,0:21:15.73,0:21:17.61,Default,,0,0,0,,Ông từng đóng chung với cô gái trong đĩa này.
Dialogue: 0,0:21:19.99,0:21:21.24,Default,,0,0,0,,Là cô ta đây đúng không?
Dialogue: 0,0:21:21.32,0:21:24.03,Default,,0,0,0,,- Cổ từng là bạn học cùng lớp với tụi tôi đấy.\N- Mấy cậu có biết tên thật của cô ấy không?
Dialogue: 0,0:21:24.20,0:21:25.91,Default,,0,0,0,,Ami. Tên thật của cổ là Ami.
Dialogue: 0,0:21:25.99,0:21:26.91,Default,,0,0,0,,Ami à.
Dialogue: 0,0:21:28.58,0:21:30.17,Default,,0,0,0,,Chắc chắn là cùng một người đúng không ông?
Dialogue: 0,0:21:32.00,0:21:33.04,Default,,0,0,0,,Nếu đúng thì đã làm sao?
Dialogue: 0,0:21:35.63,0:21:37.51,Default,,0,0,0,,Nếu đó thực sự là bạn học cũ của mấy cậu,
Dialogue: 0,0:21:38.21,0:21:39.59,Default,,0,0,0,,thì mấy cậu định làm cái trò gì hả?
Dialogue: 0,0:21:47.18,0:21:48.64,Default,,0,0,0,,Đúng là lũ tiểu nhân hẹp hòi.
Dialogue: 0,0:21:52.44,0:21:53.57,Default,,0,0,0,,Mấy người...
Dialogue: 0,0:21:54.98,0:21:56.44,Default,,0,0,0,,thật nhỏ nhen và đáng khinh.
Dialogue: 0,0:22:01.82,0:22:04.41,Default,,0,0,0,,Cho một nhúm muối nhỏ vào chảo dầu ô liu.
Dialogue: 0,0:22:04.49,0:22:06.78,Default,,0,0,0,,Sau đó xếp những lát khoai mài vào áp chảo
Dialogue: 0,0:22:06.87,0:22:10.58,Default,,0,0,0,,rồi rưới thêm chút nước tương vào lúc cuối.
Dialogue: 0,0:22:12.54,0:22:14.38,Default,,0,0,0,,Lớp cạnh hơi cháy xém chính là điểm nhấn hương vị của món này.
Dialogue: 0,0:22:14.46,0:22:16.63,Default,,0,0,0,,Chỉ cần áp chảo cho đến khi hai mặt vàng ruộm.
Dialogue: 0,0:22:16.71,0:22:18.38,Default,,0,0,0,,Món của mấy chị đây.
Dialogue: 0,0:22:19.34,0:22:21.18,Default,,0,0,0,,Chúc mọi người ngon miệng.
Dialogue: 0,0:22:21.26,0:22:22.76,Default,,0,0,0,,Món này giúp bồi bổ sinh lực tốt lắm đấy.
Dialogue: 0,0:22:23.93,0:22:26.89,Default,,0,0,0,,- Mời chị ăn trước đi.\N- Thôi, chị cứ gắp trước đi.
Dialogue: 0,0:22:26.97,0:22:30.43,Default,,0,0,0,,- Đừng ngại mà, chị ăn trước đi.\N- Thôi mà, mời chị gắp trước.
Dialogue: 0,0:22:40.03,0:22:41.36,Default,,0,0,0,,Chúc quý khách ngủ ngon.
Dialogue: 0,0:23:48.97,0:23:53.77,Default,,0,0,0,,CÂU CHUYỆN NÀY LÀ HƯ CẤU
