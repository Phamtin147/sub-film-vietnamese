Dialogue: 0,0:01:03.10,0:01:04.64,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:04.94,0:01:07.53,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:08.28,0:01:09.66,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:27.50,0:01:30.17,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:30.72,0:01:32.14,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:33.18,0:01:36.06,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:40.93,0:01:42.43,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:42.94,0:01:44.69,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:48.61,0:01:51.70,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN Ở TOKYO
Dialogue: 0,0:01:51.78,0:01:54.95,Default,,0,0,0,,THỊT HEO BÍT TẾT TONTEKI
Dialogue: 0,0:01:59.41,0:02:01.25,Default,,0,0,0,,Mỗi độ tiết trời bắt đầu chuyển lạnh,
Dialogue: 0,0:02:01.70,0:02:05.58,Default,,0,0,0,,năm nào Shigemi cũng đan một chiếc áo len mới.
Dialogue: 0,0:02:09.59,0:02:10.47,Default,,0,0,0,,Chị khéo tay thật đấy.
Dialogue: 0,0:02:11.63,0:02:12.71,Default,,0,0,0,,Tại chị đan quen tay rồi thôi.
Dialogue: 0,0:02:13.47,0:02:14.85,Default,,0,0,0,,Quà tặng bạn trai hả chị?
Dialogue: 0,0:02:15.55,0:02:17.39,Default,,0,0,0,,Bạn trai á? Cũng đại loại thế.
Dialogue: 0,0:02:17.47,0:02:19.81,Default,,0,0,0,,Nói thật với bạn nhé,\Nmỗi lần cô ấy đan áo
Dialogue: 0,0:02:20.18,0:02:22.18,Default,,0,0,0,,là lại dành tặng cho một "bạn trai" khác nhau.
Dialogue: 0,0:02:22.93,0:02:24.81,Default,,0,0,0,,Món thịt heo bít tết tonteki của cô đây.
Dialogue: 0,0:02:25.85,0:02:27.77,Default,,0,0,0,,Thời buổi này hiếm khi nào còn thấy
Dialogue: 0,0:02:28.23,0:02:29.98,Default,,0,0,0,,có người ngồi đan len ở chốn đông người thế này.
Dialogue: 0,0:02:30.94,0:02:32.19,Default,,0,0,0,,Chị nói đúng thật đấy.
Dialogue: 0,0:02:36.95,0:02:37.78,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:02:39.45,0:02:40.83,Default,,0,0,0,,Anh Ichihara!
Dialogue: 0,0:02:41.45,0:02:43.29,Default,,0,0,0,,Chào cô Suzuki. Dạo này cô khỏe chứ?
Dialogue: 0,0:02:43.37,0:02:44.66,Default,,0,0,0,,Dạ khỏe. Cảm ơn anh.
Dialogue: 0,0:02:51.55,0:02:52.47,Default,,0,0,0,,Anh ấy là bạn của chị à?
Dialogue: 0,0:02:53.55,0:02:55.76,Default,,0,0,0,,Đây là anh Ichihara,\Nmột nhà thiết kế nội thất.
Dialogue: 0,0:02:56.09,0:02:58.51,Default,,0,0,0,,Anh ấy vừa mới mở văn phòng\Nở khu vực gần đây.
Dialogue: 0,0:02:58.60,0:03:00.73,Default,,0,0,0,,Chính cô Suzuki đã giới thiệu quán này cho tôi đấy.
Dialogue: 0,0:03:02.81,0:03:04.35,Default,,0,0,0,,Cho tôi hai phần combo súp miso thịt heo nhé.
Dialogue: 0,0:03:04.43,0:03:06.43,Default,,0,0,0,,- Cho em phần cơm ít thôi nhé.\N- Có ngay.
Dialogue: 0,0:03:08.81,0:03:12.02,Default,,0,0,0,,Đây là cô Suzuki, nhân viên môi giới bất động sản\Nđã giúp anh tìm được văn phòng.
Dialogue: 0,0:03:12.40,0:03:15.82,Default,,0,0,0,,Cảm ơn cô vì đã tìm giúp chúng tôi\Nmột mặt bằng tuyệt vời đến vậy.
Dialogue: 0,0:03:16.24,0:03:17.99,Default,,0,0,0,,Tôi chỉ làm đúng bổn phận công việc của mình thôi mà.
Dialogue: 0,0:03:19.20,0:03:23.16,Default,,0,0,0,,Hay là mình nhờ cô ấy\Ntìm giúp căn hộ chung cư cho tụi mình luôn đi anh?
Dialogue: 0,0:03:23.24,0:03:24.45,Default,,0,0,0,,Ý kiến hay đấy.
Dialogue: 0,0:03:24.95,0:03:28.16,Default,,0,0,0,,Tụi tôi đang tính dọn về sống gần văn phòng của tôi.\NCô tìm giúp tụi tôi một căn được chứ?
Dialogue: 0,0:03:29.17,0:03:30.59,Default,,0,0,0,,Vâng, tất nhiên rồi ạ.
Dialogue: 0,0:03:47.19,0:03:48.02,Default,,0,0,0,,Sao lại thế chứ?
Dialogue: 0,0:03:49.81,0:03:50.65,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:03:55.15,0:03:56.61,Default,,0,0,0,,Đừng nói với em là...
Dialogue: 0,0:03:57.78,0:03:59.07,Default,,0,0,0,,chiếc áo này vốn đan để tặng cho anh chàng đó nhé.
Dialogue: 0,0:03:59.91,0:04:03.87,Default,,0,0,0,,Rõ ràng đối với anh Ichihara,\Ntôi chỉ đơn thuần là một nhân viên môi giới nhà đất.
Dialogue: 0,0:04:04.41,0:04:07.66,Default,,0,0,0,,Chị ngồi đan áo suốt bao ngày cho một người đàn ông\Nthậm chí còn chẳng phải bạn trai mình ư?
Dialogue: 0,0:04:10.25,0:04:12.63,Default,,0,0,0,,Chị còn chẳng hề biết chuyện\Nanh ta đã có bạn gái rồi sao?
Dialogue: 0,0:04:14.05,0:04:16.14,Default,,0,0,0,,Đúng là cầm đèn chạy trước ô tô mà.
Dialogue: 0,0:04:16.84,0:04:18.38,Default,,0,0,0,,Không sao đâu. Tôi quen với cảnh này rồi!
Dialogue: 0,0:04:32.40,0:04:33.73,Default,,0,0,0,,Mọi người nghĩ cô ấy có ổn không?
Dialogue: 0,0:04:34.07,0:04:35.86,Default,,0,0,0,,Trông cô ấy sốc nặng lắm.
Dialogue: 0,0:04:36.94,0:04:38.69,Default,,0,0,0,,Đừng lo.
Dialogue: 0,0:04:39.61,0:04:40.44,Default,,0,0,0,,Ông chủ chắc chứ?
Dialogue: 0,0:04:41.41,0:04:42.91,Default,,0,0,0,,Shigemi nhìn bề ngoài có vẻ yếu đuối mong manh,
Dialogue: 0,0:04:43.12,0:04:44.29,Default,,0,0,0,,nhưng thực ra cô ấy kiên cường lắm.
Dialogue: 0,0:04:47.70,0:04:48.53,Default,,0,0,0,,Quả nhiên tôi đoán không sai.
Dialogue: 0,0:04:48.91,0:04:51.71,Default,,0,0,0,,Khoảng mười ngày sau đó...
Dialogue: 0,0:04:52.58,0:04:53.42,Default,,0,0,0,,Quán mở cửa rồi đấy.
Dialogue: 0,0:04:55.42,0:04:56.30,Default,,0,0,0,,Chào ông chủ!
Dialogue: 0,0:04:57.34,0:04:58.30,Default,,0,0,0,,Của mọi người đây.
Dialogue: 0,0:04:58.67,0:05:00.26,Default,,0,0,0,,Cảm ơn ông chủ.
Dialogue: 0,0:05:01.51,0:05:05.26,Default,,0,0,0,,Ông chủ sẽ làm bất cứ món gì mấy đứa muốn,\Nnên thích ăn gì cứ gọi thoải mái nhé.
Dialogue: 0,0:05:06.72,0:05:09.22,Default,,0,0,0,,Miễn là trong bếp tôi có sẵn nguyên liệu.
Dialogue: 0,0:05:09.98,0:05:12.32,Default,,0,0,0,,Đây là Kurihara, Yoshida và Shirano.
Dialogue: 0,0:05:12.40,0:05:14.36,Default,,0,0,0,,Họ đều là các đồng nghiệp đàn em ở công ty tôi.
Dialogue: 0,0:05:15.52,0:05:16.65,Default,,0,0,0,,Ông chủ có biết không?
Dialogue: 0,0:05:16.73,0:05:20.28,Default,,0,0,0,,Kurihara quê ở Yokkaichi đấy,\Nvà tonteki chính là món khoái khẩu của cậu ấy.
Dialogue: 0,0:05:20.36,0:05:23.32,Default,,0,0,0,,Tôi có nghe nói vùng Yokkaichi\Nrất nổi tiếng với món thịt heo bít tết tonteki.
Dialogue: 0,0:05:23.41,0:05:25.41,Default,,0,0,0,,Dạ vâng, miếng thịt được khía thành nhiều đường,
Dialogue: 0,0:05:25.49,0:05:27.03,Default,,0,0,0,,và phần nước sốt sánh đặc có hương vị rất độc đáo.
Dialogue: 0,0:05:28.20,0:05:31.79,Default,,0,0,0,,Nước sốt tôi làm có vị thanh nhẹ hơn,\Nnên không biết có hợp khẩu vị của cậu không.
Dialogue: 0,0:05:31.87,0:05:32.91,Default,,0,0,0,,Em rất muốn ăn thử xem sao ạ.
Dialogue: 0,0:05:34.33,0:05:35.62,Default,,0,0,0,,Còn em thì sao, Yoshida?
Dialogue: 0,0:05:35.71,0:05:39.76,Default,,0,0,0,,Xin lỗi chị, sau chín giờ tối là em không ăn gì nữa,\Nđể giữ dáng khỏi bị tăng cân ạ.
Dialogue: 0,0:05:39.84,0:05:40.76,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:05:41.17,0:05:42.21,Default,,0,0,0,,Thế còn cậu, Shirano?
Dialogue: 0,0:05:43.97,0:05:45.56,Default,,0,0,0,,Em cũng xin gọi món tonteki luôn ạ.
Dialogue: 0,0:05:46.26,0:05:48.55,Default,,0,0,0,,- Vậy cho tụi tôi ba phần tonteki nhé.\N- Có ngay.
Dialogue: 0,0:05:49.77,0:05:51.23,Default,,0,0,0,,Cạn ly nào.
Dialogue: 0,0:05:51.31,0:05:52.64,Default,,0,0,0,,Cạn ly.
Dialogue: 0,0:06:05.11,0:06:07.82,Default,,0,0,0,,Chị Suzuki này, chị thích đan len lắm ạ?
Dialogue: 0,0:06:09.29,0:06:11.38,Default,,0,0,0,,Chị thích đan từ hồi còn bé xíu cơ.
Dialogue: 0,0:06:11.45,0:06:14.50,Default,,0,0,0,,Em rất thích những người phụ nữ biết đan lát.\NTrông họ dịu dàng nữ tính lắm.
Dialogue: 0,0:06:17.42,0:06:19.42,Default,,0,0,0,,Vậy thì em cũng muốn học đan len.
Dialogue: 0,0:06:19.50,0:06:21.75,Default,,0,0,0,,Chị Suzuki, chị dạy cho em đan với nhé?
Dialogue: 0,0:06:36.19,0:06:37.02,Default,,0,0,0,,Của mọi người đây.
Dialogue: 0,0:06:46.03,0:06:46.86,Default,,0,0,0,,Hợp vị chứ?
Dialogue: 0,0:06:50.91,0:06:51.74,Default,,0,0,0,,Thì ra là vậy.
Dialogue: 0,0:06:52.91,0:06:55.79,Default,,0,0,0,,Món tonteki kiểu Yokkaichi thì cực kỳ bắt cơm.
Dialogue: 0,0:06:56.50,0:06:57.92,Default,,0,0,0,,Còn tonteki của ông chủ làm thì lại là mồi nhậu tuyệt hảo.
Dialogue: 0,0:07:01.13,0:07:02.80,Default,,0,0,0,,À mà ông chủ ơi, cho tôi xin thêm bát cơm được không?
Dialogue: 0,0:07:03.42,0:07:04.26,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:07:05.55,0:07:07.84,Default,,0,0,0,,Ăn món này kèm với cơm trắng lúc đêm hôm thế này ư?\NChị sẽ tăng cân vù vù cho mà xem.
Dialogue: 0,0:07:09.10,0:07:11.69,Default,,0,0,0,,Tôi đoán đối tượng thầm thương trộm nhớ hiện tại của Shigemi...
Dialogue: 0,0:07:12.52,0:07:13.81,Default,,0,0,0,,chính là anh chàng này đây.
Dialogue: 0,0:07:16.27,0:07:17.10,Default,,0,0,0,,Chị về trước nhé.
Dialogue: 0,0:07:17.77,0:07:18.65,Default,,0,0,0,,Hẹn gặp lại chị ngày mai.
Dialogue: 0,0:07:27.20,0:07:28.03,Default,,0,0,0,,Em xin phép về đây ạ.
Dialogue: 0,0:07:39.54,0:07:41.42,Default,,0,0,0,,Mai gặp lại nhé.
Dialogue: 0,0:07:44.21,0:07:46.00,Default,,0,0,0,,- Kurihara này.\N- Dạ?
Dialogue: 0,0:07:47.63,0:07:48.72,Default,,0,0,0,,Tặng cậu đấy.
Dialogue: 0,0:07:51.01,0:07:51.84,Default,,0,0,0,,Thật sao ạ?
Dialogue: 0,0:07:55.77,0:07:57.11,Default,,0,0,0,,Chị hy vọng là vừa vặn với cỡ người của cậu.
Dialogue: 0,0:08:12.37,0:08:13.29,Default,,0,0,0,,Vừa in luôn ạ.
Dialogue: 0,0:08:15.04,0:08:16.33,Default,,0,0,0,,Em nhận chiếc áo này thật sự được chứ ạ?
Dialogue: 0,0:08:21.17,0:08:22.96,Default,,0,0,0,,Em đã muốn có một chiếc áo len như thế này từ lâu rồi.
Dialogue: 0,0:08:24.13,0:08:25.17,Default,,0,0,0,,Em cảm ơn chị nhiều lắm.
Dialogue: 0,0:08:30.22,0:08:33.26,Default,,0,0,0,,Rồi sao nữa? Phản ứng của cậu ta thế nào?
Dialogue: 0,0:08:34.68,0:08:36.39,Default,,0,0,0,,Em nghĩ là cậu ấy thích chiếc áo đó.
Dialogue: 0,0:08:37.52,0:08:40.73,Default,,0,0,0,,Nhưng em chẳng cảm thấy\Nnhờ nó mà hai đứa xích lại gần nhau hơn chút nào.
Dialogue: 0,0:08:40.81,0:08:44.23,Default,,0,0,0,,Thế lúc đưa áo cho cậu ta,\Nem có thổ lộ tình cảm của mình không?
Dialogue: 0,0:08:49.78,0:08:52.37,Default,,0,0,0,,Nhưng cậu ấy đã nhận món quà rồi mà.
Dialogue: 0,0:08:52.45,0:08:55.58,Default,,0,0,0,,Điều đó có nghĩa là cậu ấy hẳn cũng đã đón nhận\Ntình cảm của em rồi còn gì. Đúng không ạ?
Dialogue: 0,0:08:56.04,0:08:57.21,Default,,0,0,0,,Em nói có đúng không?
Dialogue: 0,0:08:58.75,0:09:00.63,Default,,0,0,0,,Đàn ông con trai sẽ chẳng bao giờ tỏ ra hào hứng
Dialogue: 0,0:09:00.71,0:09:02.63,Default,,0,0,0,,khi nhận một chiếc áo len đan tay\Ntừ một người phụ nữ
Dialogue: 0,0:09:02.71,0:09:04.30,Default,,0,0,0,,mà họ không hề có chút cảm tình nào đâu.
Dialogue: 0,0:09:04.38,0:09:07.05,Default,,0,0,0,,Nhưng đằng này cậu ấy đã vui vẻ nhận nó.
Dialogue: 0,0:09:07.13,0:09:09.34,Default,,0,0,0,,Tức là\Ncậu ấy đã chấp nhận tình cảm của chị ấy rồi, đúng không?
Dialogue: 0,0:09:09.84,0:09:11.05,Default,,0,0,0,,Thôi đi cô ơi.
Dialogue: 0,0:09:11.38,0:09:13.80,Default,,0,0,0,,Đan áo len tặng để thu hút sự chú ý của đàn ông á?
Dialogue: 0,0:09:13.89,0:09:15.60,Default,,0,0,0,,Làm thế cứ lòng vòng mất thời gian.
Dialogue: 0,0:09:16.01,0:09:18.26,Default,,0,0,0,,Sao không nói thẳng toẹt ra một câu là "Em yêu anh" đi?
Dialogue: 0,0:09:18.35,0:09:20.02,Default,,0,0,0,,Cô đâu còn là thiếu nữ mới lớn nữa.
Dialogue: 0,0:09:20.10,0:09:23.69,Default,,0,0,0,,Đâu phải ai cũng có thần kinh thép\Nnhư chị đâu, chị Rumi.
Dialogue: 0,0:09:23.77,0:09:25.40,Default,,0,0,0,,Chuyện tình cảm cũng giống như lúc bị gãy xương vậy.
Dialogue: 0,0:09:25.61,0:09:28.49,Default,,0,0,0,,Một khi vết thương đã lành lại, thì chỗ xương đó sẽ càng cứng cáp hơn xưa.
Dialogue: 0,0:09:29.44,0:09:30.40,Default,,0,0,0,,Ý chị là sao cơ?
Dialogue: 0,0:09:34.07,0:09:34.90,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:09:47.04,0:09:49.79,Default,,0,0,0,,Không biết Kurihara nghĩ thế nào về chị nhỉ?
Dialogue: 0,0:09:51.30,0:09:53.22,Default,,0,0,0,,Cậu có thể giả vờ dò hỏi cậu ấy một cách tự nhiên giúp chị được không?
Dialogue: 0,0:09:53.97,0:09:54.97,Default,,0,0,0,,Chị muốn em đi hỏi giúp ạ?
Dialogue: 0,0:09:55.68,0:09:58.85,Default,,0,0,0,,Chuyện này chị chỉ biết trông cậy vào mỗi mình cậu thôi.
Dialogue: 0,0:10:06.77,0:10:07.61,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:08.82,0:10:09.86,Default,,0,0,0,,Để em hỏi cậu ấy thử xem.
Dialogue: 0,0:10:10.36,0:10:11.40,Default,,0,0,0,,Chị cảm kích lắm.
Dialogue: 0,0:10:18.58,0:10:20.42,Default,,0,0,0,,À này, chị Suzuki ơi.
Dialogue: 0,0:10:21.45,0:10:22.28,Default,,0,0,0,,Ơi?
Dialogue: 0,0:10:23.58,0:10:24.87,Default,,0,0,0,,À thì...
Dialogue: 0,0:10:26.67,0:10:28.80,Default,,0,0,0,,để đổi lại việc đó,
Dialogue: 0,0:10:30.38,0:10:32.38,Default,,0,0,0,,chị có thể chỉ cho em cách đan len được không?
Dialogue: 0,0:10:33.26,0:10:34.22,Default,,0,0,0,,Hả?
Dialogue: 0,0:10:36.05,0:10:37.64,Default,,0,0,0,,Em muốn tự tay đan một chiếc khăn quàng cổ.
Dialogue: 0,0:10:39.01,0:10:39.97,Default,,0,0,0,,Được thôi, nhưng mà...
Dialogue: 0,0:10:40.68,0:10:42.02,Default,,0,0,0,,Đan để làm quà tặng cho ai đó hả?
Dialogue: 0,0:10:44.89,0:10:46.81,Default,,0,0,0,,Đan khăn quàng cổ có khó lắm không chị?
Dialogue: 0,0:10:47.44,0:10:48.98,Default,,0,0,0,,Không khó chút nào đâu. Cậu đừng lo.
Dialogue: 0,0:10:49.36,0:10:51.11,Default,,0,0,0,,Điều quan trọng nhất là tấm lòng mình đặt vào đó.
Dialogue: 0,0:10:51.53,0:10:54.12,Default,,0,0,0,,Nếu cậu đem tặng chiếc khăn tự đan,\Nchắc chắn cô ấy sẽ hạnh phúc lắm đấy.
Dialogue: 0,0:10:55.53,0:10:56.45,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:10:56.86,0:10:59.07,Default,,0,0,0,,- Chúc hai người ngon miệng.\N- Vâng.
Dialogue: 0,0:11:00.08,0:11:02.92,Default,,0,0,0,,Ra là vậy. Đan khăn quàng cổ tặng bạn gái cơ đấy?
Dialogue: 0,0:11:03.79,0:11:04.96,Default,,0,0,0,,Cô gái đó bao nhiêu tuổi rồi?
Dialogue: 0,0:11:06.62,0:11:09.08,Default,,0,0,0,,Cô ấy cũng trạc tuổi chị đấy ạ.
Dialogue: 0,0:11:18.51,0:11:20.97,Default,,0,0,0,,Em vụng về quá đi mất.
Dialogue: 0,0:11:23.06,0:11:24.98,Default,,0,0,0,,Chị lại thấy cậu khá khéo tay đấy chứ.
Dialogue: 0,0:11:28.19,0:11:29.86,Default,,0,0,0,,Hồi chị còn học tiểu học,
Dialogue: 0,0:11:30.36,0:11:34.03,Default,,0,0,0,,chị từng viết trong một bài văn\Nrằng món ăn yêu thích nhất của chị là tonteki.
Dialogue: 0,0:11:35.28,0:11:40.58,Default,,0,0,0,,Thế là cậu con trai mà chị thầm thích lúc đó bắt đầu trêu chọc,\Ngọi chị là "Cô nàng heo mê ăn tonteki".
Dialogue: 0,0:11:41.12,0:11:42.50,Default,,0,0,0,,Hồi đó thân hình chị hơi mũm mĩm thừa cân thật.
Dialogue: 0,0:11:47.16,0:11:49.00,Default,,0,0,0,,Chị vốn rất tự ti về bản thân mình.
Dialogue: 0,0:11:49.08,0:11:52.54,Default,,0,0,0,,Mỗi khi phải lòng một ai đó,\Nchị lại ngồi đan một chiếc áo len, hoặc một chiếc khăn quàng.
Dialogue: 0,0:11:53.71,0:11:56.26,Default,,0,0,0,,Mà phần lớn các lần đó,\Nchị thậm chí còn chẳng dám đem tặng cho người ta.
Dialogue: 0,0:12:03.18,0:12:04.68,Default,,0,0,0,,À nhân tiện, cậu đã hỏi giúp chị chưa?
Dialogue: 0,0:12:05.10,0:12:05.93,Default,,0,0,0,,Hỏi gì cơ ạ?
Dialogue: 0,0:12:08.27,0:12:09.10,Default,,0,0,0,,À phải rồi.
Dialogue: 0,0:12:12.27,0:12:13.48,Default,,0,0,0,,Em nghĩ là...
Dialogue: 0,0:12:15.23,0:12:17.27,Default,,0,0,0,,hình như Kurihara không thích...
Dialogue: 0,0:12:17.95,0:12:21.79,Default,,0,0,0,,màu sắc của chiếc áo len\Nmà chị đã tặng cậu ấy.
Dialogue: 0,0:12:23.45,0:12:24.37,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:12:25.37,0:12:26.91,Default,,0,0,0,,cậu ấy vẫn mặc nó ở nhà suốt đấy ạ.
Dialogue: 0,0:12:28.33,0:12:29.58,Default,,0,0,0,,Cậu ấy là người tốt bụng mà.
Dialogue: 0,0:12:30.88,0:12:34.13,Default,,0,0,0,,Thế nên cậu ấy mới ngại không dám nói thẳng với chị\Nrằng đó không phải màu cậu ấy thích.
Dialogue: 0,0:12:34.21,0:12:36.00,Default,,0,0,0,,Thật vậy sao?
Dialogue: 0,0:12:36.42,0:12:39.26,Default,,0,0,0,,Lẽ ra cậu ấy cứ nói thẳng với chị mới phải.\NChị đâu có vì chuyện cỏn con đó mà tổn thương đâu.
Dialogue: 0,0:12:40.43,0:12:43.02,Default,,0,0,0,,Thế màu sắc yêu thích của cậu ấy là màu gì?
Dialogue: 0,0:12:45.18,0:12:47.81,Default,,0,0,0,,Ra thế. Vấn đề nằm ở màu áo sao?
Dialogue: 0,0:12:48.52,0:12:49.90,Default,,0,0,0,,Ông chủ thấy màu len này thế nào?
Dialogue: 0,0:12:53.86,0:12:54.69,Default,,0,0,0,,Hoặc là...
Dialogue: 0,0:12:55.44,0:12:57.40,Default,,0,0,0,,chọn tông màu tươi sáng hơn chút nhỉ?
Dialogue: 0,0:13:01.16,0:13:01.99,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:13:06.49,0:13:08.78,Default,,0,0,0,,Đây là lần đầu tiên thấy cậu ghé quán một mình đấy.
Dialogue: 0,0:13:09.87,0:13:10.70,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:13:13.50,0:13:16.00,Default,,0,0,0,,Chiếc khăn quàng cổ cậu đan xong rồi chứ?
Dialogue: 0,0:13:23.26,0:13:25.55,Default,,0,0,0,,Chuyện đó là tôi nói dối đấy.
Dialogue: 0,0:13:27.39,0:13:28.23,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:13:29.10,0:13:30.14,Default,,0,0,0,,Tôi về trước đây.
Dialogue: 0,0:13:30.23,0:13:31.36,Default,,0,0,0,,Hẹn gặp lại ngày mai nhé.
Dialogue: 0,0:13:37.86,0:13:39.86,Default,,0,0,0,,Này Shirano. Cậu có rảnh một lát không?
Dialogue: 0,0:13:44.32,0:13:46.24,Default,,0,0,0,,Tôi đang hẹn hò với Yoshida rồi.
Dialogue: 0,0:13:46.58,0:13:47.58,Default,,0,0,0,,Ồ, thật vậy sao?
Dialogue: 0,0:13:48.99,0:13:49.87,Default,,0,0,0,,Với lại...
Dialogue: 0,0:13:50.83,0:13:54.13,Default,,0,0,0,,chị Suzuki đã tặng chiếc áo này cho tôi.
Dialogue: 0,0:13:57.59,0:14:01.26,Default,,0,0,0,,Yoshida đã cố tình giằng rách nó\Nđể thử xem sợi len bền cỡ nào.
Dialogue: 0,0:14:03.72,0:14:04.89,Default,,0,0,0,,Phụ nữ đôi khi thật độc địa.
Dialogue: 0,0:14:09.64,0:14:10.56,Default,,0,0,0,,Thế nên...
Dialogue: 0,0:14:11.68,0:14:14.35,Default,,0,0,0,,Cậu vứt nó đi giúp tôi được không?
Dialogue: 0,0:14:20.32,0:14:21.15,Default,,0,0,0,,Cậu làm giúp tôi thật chứ?
Dialogue: 0,0:14:21.90,0:14:22.82,Default,,0,0,0,,Cảm ơn cậu nhiều lắm.
Dialogue: 0,0:14:23.45,0:14:25.87,Default,,0,0,0,,Một chiếc áo len đan tay chất chứa
Dialogue: 0,0:14:25.95,0:14:27.24,Default,,0,0,0,,biết bao nhiêu tình cảm nặng nề trong đó.
Dialogue: 0,0:14:28.16,0:14:29.29,Default,,0,0,0,,Tự tay tôi không sao nhẫn tâm vứt đi được.
Dialogue: 0,0:14:40.46,0:14:41.46,Default,,0,0,0,,Cậu đang làm gì thế?
Dialogue: 0,0:14:42.88,0:14:43.80,Default,,0,0,0,,Chỉ là đồ bỏ đi thôi mà.
Dialogue: 0,0:14:47.34,0:14:49.47,Default,,0,0,0,,Tôi thực sự thất vọng về bản thân mình.
Dialogue: 0,0:14:53.27,0:14:55.11,Default,,0,0,0,,Chị Suzuki đã tin tưởng tâm sự với tôi.
Dialogue: 0,0:14:56.85,0:14:59.48,Default,,0,0,0,,Tôi biết rõ đáng lẽ mình phải nói sự thật cho chị ấy,
Dialogue: 0,0:15:02.03,0:15:03.11,Default,,0,0,0,,nhưng tôi lại không mở lời nổi.
Dialogue: 0,0:15:06.24,0:15:07.07,Default,,0,0,0,,Chị ấy...
Dialogue: 0,0:15:08.49,0:15:11.74,Default,,0,0,0,,lại đang cặm cụi đan thêm một chiếc áo len khác cho Kurihara.
Dialogue: 0,0:15:13.62,0:15:14.87,Default,,0,0,0,,Lòng tôi thấy day dứt quá.
Dialogue: 0,0:15:17.29,0:15:18.42,Default,,0,0,0,,Vậy ra...
Dialogue: 0,0:15:19.84,0:15:21.68,Default,,0,0,0,,lý do cậu nhờ cô ấy dạy đan khăn quàng cổ là...
Dialogue: 0,0:15:24.55,0:15:27.26,Default,,0,0,0,,Tôi muốn tự tay mình vá lại chiếc áo len này.
Dialogue: 0,0:15:28.14,0:15:30.06,Default,,0,0,0,,Đó là lý do vì sao tôi xin học đan len.
Dialogue: 0,0:15:32.31,0:15:35.23,Default,,0,0,0,,Tôi biết rõ chị ấy chẳng phải đan nó cho tôi, nhưng...
Dialogue: 0,0:15:37.48,0:15:39.82,Default,,0,0,0,,chiếc áo này được dệt nên từ trọn vẹn tấm chân tình của chị Suzuki.
Dialogue: 0,0:15:43.32,0:15:44.24,Default,,0,0,0,,Giờ cậu tính sao?
Dialogue: 0,0:15:45.24,0:15:46.20,Default,,0,0,0,,Cậu vẫn định...
Dialogue: 0,0:15:46.74,0:15:48.62,Default,,0,0,0,,tiếp tục giữ kín lời nói dối đó ư?
Dialogue: 0,0:16:02.13,0:16:02.97,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:16:05.09,0:16:06.09,Default,,0,0,0,,Chị Suzuki?
Dialogue: 0,0:16:07.05,0:16:09.72,Default,,0,0,0,,Kurihara đấy à.\NSao cậu lại ở đây?
Dialogue: 0,0:16:10.22,0:16:13.06,Default,,0,0,0,,Shirano nhắn em tới đây,\Nbảo là có chuyện muốn nói.
Dialogue: 0,0:16:13.14,0:16:14.39,Default,,0,0,0,,Cậu ấy cũng nhắn gọi chị tới đây.
Dialogue: 0,0:16:16.93,0:16:18.14,Default,,0,0,0,,Chị ngồi xuống đi.
Dialogue: 0,0:16:31.74,0:16:33.53,Default,,0,0,0,,Sao cậu lại mặc chiếc áo đó trên người?
Dialogue: 0,0:16:34.74,0:16:36.24,Default,,0,0,0,,Kurihara đã cho tôi chiếc áo này.
Dialogue: 0,0:16:38.58,0:16:41.25,Default,,0,0,0,,Kurihara hiện đang hẹn hò với Yoshida.
Dialogue: 0,0:16:41.33,0:16:42.50,Default,,0,0,0,,Tại sao cậu lại...?
Dialogue: 0,0:16:50.63,0:16:52.17,Default,,0,0,0,,Ra là vậy sao?
Dialogue: 0,0:16:52.89,0:16:54.60,Default,,0,0,0,,Thôi nào, Kurihara.
Dialogue: 0,0:16:55.01,0:16:58.39,Default,,0,0,0,,Lẽ ra cậu phải nói thẳng chuyện đó với chị từ đầu chứ.
Dialogue: 0,0:17:11.11,0:17:12.03,Default,,0,0,0,,Chị Suzuki.
Dialogue: 0,0:17:14.28,0:17:15.28,Default,,0,0,0,,Em biết phải nói sao đây...
Dialogue: 0,0:17:17.08,0:17:18.00,Default,,0,0,0,,Em xin lỗi chị.
Dialogue: 0,0:17:25.13,0:17:26.17,Default,,0,0,0,,Chị Shigemi!
Dialogue: 0,0:17:29.38,0:17:30.51,Default,,0,0,0,,Chiếc áo len này...
Dialogue: 0,0:17:31.68,0:17:33.06,Default,,0,0,0,,ấm áp lắm...
Dialogue: 0,0:17:33.97,0:17:35.06,Default,,0,0,0,,mặc vào cực kỳ dễ chịu.
Dialogue: 0,0:17:36.72,0:17:37.76,Default,,0,0,0,,Em thực sự rất thích nó.
Dialogue: 0,0:17:40.98,0:17:42.15,Default,,0,0,0,,Thế thì đã sao nào?
Dialogue: 0,0:17:45.23,0:17:46.15,Default,,0,0,0,,Nên là...
Dialogue: 0,0:17:48.23,0:17:50.57,Default,,0,0,0,,tôi chẳng thèm bận tâm gì tới cái áo len đó nữa đâu!
Dialogue: 0,0:17:54.24,0:17:56.12,Default,,0,0,0,,Sau đêm hôm đó, cả Shigemi lẫn Shirano
Dialogue: 0,0:17:56.58,0:17:59.75,Default,,0,0,0,,đều không thấy ghé lại quán trong một thời gian dài.
Dialogue: 0,0:18:17.43,0:18:19.56,Default,,0,0,0,,Mời hai người vào. Đi lối này ạ.
Dialogue: 0,0:18:23.19,0:18:25.11,Default,,0,0,0,,Căn này rộng rãi hơn anh tưởng đấy.
Dialogue: 0,0:18:26.15,0:18:28.07,Default,,0,0,0,,Mình có thể kê một chiếc bàn ăn ở góc này.
Dialogue: 0,0:18:29.65,0:18:31.36,Default,,0,0,0,,Còn tivi thì đặt ở chỗ kia nhỉ?
Dialogue: 0,0:18:33.61,0:18:37.20,Default,,0,0,0,,- Căn hộ này quá hoàn hảo cho hai đứa mình, nhưng mà...\N- Sao thế anh?
Dialogue: 0,0:18:38.74,0:18:40.45,Default,,0,0,0,,Anh đang tính đến chuyện tụi mình sẽ có thêm em bé nữa.
Dialogue: 0,0:19:00.72,0:19:02.26,Default,,0,0,0,,Nãy giờ cô ngồi uống rượu một mình đấy à?
Dialogue: 0,0:19:07.77,0:19:10.19,Default,,0,0,0,,Tôi bỏ đan len rồi.
Dialogue: 0,0:19:13.28,0:19:14.32,Default,,0,0,0,,Tôi chợt nhận ra rằng...
Dialogue: 0,0:19:14.90,0:19:16.53,Default,,0,0,0,,việc đem tặng
Dialogue: 0,0:19:16.61,0:19:20.03,Default,,0,0,0,,một chiếc áo len tự đan cho một người\Nthậm chí còn chưa hẹn hò với mình là điều hết sức kỳ cục.
Dialogue: 0,0:19:20.95,0:19:22.70,Default,,0,0,0,,Tự mình đa tình rồi tự mình háo hức, đúng là ngốc nghếch.
Dialogue: 0,0:19:23.37,0:19:25.16,Default,,0,0,0,,Tôi đúng là một con ngốc mà.
Dialogue: 0,0:19:27.58,0:19:28.62,Default,,0,0,0,,Tôi thì lại không nghĩ vậy đâu.
Dialogue: 0,0:19:32.05,0:19:33.09,Default,,0,0,0,,Hôm trước...
Dialogue: 0,0:19:34.26,0:19:35.30,Default,,0,0,0,,cậu Shirano...
Dialogue: 0,0:19:35.92,0:19:37.67,Default,,0,0,0,,đã ghé quán một mình.
Dialogue: 0,0:19:39.97,0:19:41.18,Default,,0,0,0,,Cậu ấy ngồi ngay ở chỗ kia...
Dialogue: 0,0:19:42.06,0:19:44.27,Default,,0,0,0,,và cặm cụi ngồi khâu vá lại chiếc áo len.
Dialogue: 0,0:19:45.81,0:19:47.02,Default,,0,0,0,,Ngay ở phần vai áo trên này...
Dialogue: 0,0:19:47.81,0:19:49.10,Default,,0,0,0,,có một vết rách thủng.
Dialogue: 0,0:19:52.44,0:19:53.98,Default,,0,0,0,,Tay nghề đan vá của cậu ấy vụng về lắm.
Dialogue: 0,0:19:54.74,0:19:56.16,Default,,0,0,0,,Nhìn mà tôi cũng thấy thương thay cho cậu ấy.
Dialogue: 0,0:19:57.95,0:20:00.75,Default,,0,0,0,,Cậu ấy đã nói rằng:\N"Chiếc áo này được dệt nên từ trọn vẹn tấm chân tình của chị Suzuki."
Dialogue: 0,0:20:01.78,0:20:03.66,Default,,0,0,0,,Cậu ấy đã vô cùng trân trọng và cố gắng hết sức để vá lại nó.
Dialogue: 0,0:20:24.81,0:20:26.52,Default,,0,0,0,,Chuyện đó làm sao có thật được.
Dialogue: 0,0:20:31.48,0:20:32.90,Default,,0,0,0,,Cảm giác này là sao đây?
Dialogue: 0,0:20:33.86,0:20:35.24,Default,,0,0,0,,Cảm giác...
Dialogue: 0,0:20:35.90,0:20:37.32,Default,,0,0,0,,này là gì thế này?
Dialogue: 0,0:20:37.69,0:20:39.40,Default,,0,0,0,,Cảm giác này là sao chứ?
Dialogue: 0,0:20:39.49,0:20:42.37,Default,,0,0,0,,Cảm giác trong lòng mình lúc này là gì đây?
Dialogue: 0,0:20:42.45,0:20:43.37,Default,,0,0,0,,Shigemi?
Dialogue: 0,0:20:43.91,0:20:44.83,Default,,0,0,0,,Cô có sao không đấy?
Dialogue: 0,0:20:50.50,0:20:52.71,Default,,0,0,0,,Cái cảm giác quái quỷ này là sao chứ?
Dialogue: 0,0:21:08.02,0:21:09.23,Default,,0,0,0,,Chị có sao không?
Dialogue: 0,0:21:10.89,0:21:12.02,Default,,0,0,0,,Chị Suzuki?
Dialogue: 0,0:21:19.40,0:21:20.53,Default,,0,0,0,,Shirano này...
Dialogue: 0,0:21:20.90,0:21:21.86,Default,,0,0,0,,Trước giờ chị cứ ngỡ...
Dialogue: 0,0:21:22.20,0:21:24.87,Default,,0,0,0,,bản thân mình chỉ thích những anh chàng đẹp trai thôi.
Dialogue: 0,0:21:25.37,0:21:29.25,Default,,0,0,0,,Ơ kìa, biết nói sao cho phải nhỉ?\NÝ của chị không phải thế, mà là...
Dialogue: 0,0:21:29.33,0:21:31.83,Default,,0,0,0,,À thì... chuyện cậu...
Dialogue: 0,0:21:31.92,0:21:33.59,Default,,0,0,0,,đã vá lại chiếc áo len của chị.
Dialogue: 0,0:21:33.67,0:21:36.05,Default,,0,0,0,,Ông chủ đã kể hết cho chị nghe rồi.
Dialogue: 0,0:21:36.13,0:21:37.38,Default,,0,0,0,,Thế nên...
Dialogue: 0,0:21:37.80,0:21:39.34,Default,,0,0,0,,chị thực sự rất cảm động trước tấm lòng của cậu.
Dialogue: 0,0:21:39.42,0:21:41.59,Default,,0,0,0,,Không, nói thế vẫn chưa đúng ý.
Dialogue: 0,0:21:41.68,0:21:44.43,Default,,0,0,0,,- Điều mà chị đang cố nói là...\N- Em yêu chị.
Dialogue: 0,0:21:50.14,0:21:51.47,Default,,0,0,0,,Em yêu chị,
Dialogue: 0,0:21:52.35,0:21:53.35,Default,,0,0,0,,chị Shigemi.
Dialogue: 0,0:21:58.98,0:22:01.44,Default,,0,0,0,,Chị cũng yêu em.
Dialogue: 0,0:22:15.25,0:22:17.63,Default,,0,0,0,,Nếu bạn áo qua một lớp bột mì mỏng lên miếng thịt heo,
Dialogue: 0,0:22:18.13,0:22:20.88,Default,,0,0,0,,thịt sẽ thấm đẫm nước sốt hơn khi áp chảo.
Dialogue: 0,0:22:21.34,0:22:24.51,Default,,0,0,0,,Sau khi rưới nước sốt vào chảo,\Nhãy cho thêm hành tây mài nhuyễn vào.
Dialogue: 0,0:22:25.09,0:22:26.72,Default,,0,0,0,,Nó sẽ tạo thêm độ sánh và chiều sâu hương vị
Dialogue: 0,0:22:27.01,0:22:28.76,Default,,0,0,0,,cho phần nước sốt thanh nhẹ.
Dialogue: 0,0:22:31.02,0:22:31.98,Default,,0,0,0,,Chị Shigemi.
Dialogue: 0,0:22:32.31,0:22:33.98,Default,,0,0,0,,Chị đang đan món đồ gì thế?
Dialogue: 0,0:22:36.77,0:22:37.77,Default,,0,0,0,,Quần lót len đấy.
Dialogue: 0,0:22:39.02,0:22:40.23,Default,,0,0,0,,Nhìn có vẻ ấm áp quá nhỉ.
Dialogue: 0,0:22:43.82,0:22:45.61,Default,,0,0,0,,- Chúc mọi người ngủ ngon.\N- Chúc ngủ ngon.
Dialogue: 0,0:23:49.09,0:23:53.93,Default,,0,0,0,,CÂU CHUYỆN NÀY CHỈ LÀ HƯ CẤU
