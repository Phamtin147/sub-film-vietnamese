Dialogue: 0,0:01:08.65,0:01:10.44,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:10.53,0:01:12.70,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:13.78,0:01:15.24,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:39.81,0:01:42.10,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:42.19,0:01:43.40,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:45.15,0:01:47.99,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:50.11,0:01:51.69,Default,,0,0,0,,PHẦN SÚP MISO THỊT HEO\NBIA, RƯỢU SAKE, SHOCHU
Dialogue: 0,0:01:51.78,0:01:53.70,Default,,0,0,0,,Thực đơn của tôi chỉ có vỏn vẹn từng ấy món.
Dialogue: 0,0:01:53.78,0:01:56.78,Default,,0,0,0,,Nhưng hễ khách gọi món gì,
Dialogue: 0,0:01:56.87,0:01:59.04,Default,,0,0,0,,chỉ cần có sẵn nguyên liệu là tôi đều sẽ làm.
Dialogue: 0,0:01:59.12,0:02:00.70,Default,,0,0,0,,Phương châm của tôi là vậy.
Dialogue: 0,0:02:05.79,0:02:07.63,Default,,0,0,0,,Bạn hỏi liệu có khách khứa nào ghé không ư?
Dialogue: 0,0:02:07.71,0:02:09.25,Default,,0,0,0,,Đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:02:12.34,0:02:15.22,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN ĐỜI TOKYO
Dialogue: 0,0:02:15.30,0:02:19.35,Default,,0,0,0,,MƠ MUỐI & RƯỢU MƠ
Dialogue: 0,0:02:38.03,0:02:39.82,Default,,0,0,0,,Tiếng ve kêu điếc cả tai.
Dialogue: 0,0:02:44.96,0:02:47.80,Default,,0,0,0,,Tôi mê món này lắm.
Dialogue: 0,0:02:48.75,0:02:51.75,Default,,0,0,0,,- Bia đen hả?\N- Nước ngọt có ga đen đấy.
Dialogue: 0,0:02:52.46,0:02:54.42,Default,,0,0,0,,Một người bạn ở Toyama gửi cho tôi.
Dialogue: 0,0:02:54.80,0:02:57.43,Default,,0,0,0,,Nó có vị nước tương\Npha chút tiêu. Ngon lắm.
Dialogue: 0,0:03:00.39,0:03:01.43,Default,,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:03:06.10,0:03:08.56,Default,,0,0,0,,Bán mấy thứ này\Nthì làm sao anh kiếm đủ sống được nhỉ?
Dialogue: 0,0:03:10.65,0:03:11.69,Default,,0,0,0,,Cũng tàm tạm thôi.
Dialogue: 0,0:03:13.03,0:03:15.45,Default,,0,0,0,,Thế tới mùa đông thì anh làm gì?
Dialogue: 0,0:03:17.20,0:03:19.54,Default,,0,0,0,,Tôi bán mấy thứ khác.
Dialogue: 0,0:03:57.86,0:03:59.15,Default,,0,0,0,,Ông chủ có sao không ạ?
Dialogue: 0,0:04:00.70,0:04:01.62,Default,,0,0,0,,Tôi không sao.
Dialogue: 0,0:04:09.54,0:04:11.04,Default,,0,0,0,,Ổng bị làm sao thế nhỉ?
Dialogue: 0,0:04:11.13,0:04:13.59,Default,,0,0,0,,Trông cứ thẫn thờ làm sao ấy.
Dialogue: 0,0:04:16.59,0:04:17.42,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:04:22.55,0:04:23.93,Default,,0,0,0,,Hôm nay lạ nhỉ.
Dialogue: 0,0:04:24.01,0:04:25.18,Default,,0,0,0,,Giữa tuần mà anh cũng ghé sao?
Dialogue: 0,0:04:26.93,0:04:28.85,Default,,0,0,0,,Tại tôi không ngủ được.
Dialogue: 0,0:04:30.40,0:04:31.99,Default,,0,0,0,,Cho tôi một ly shochu đá nhé.
Dialogue: 0,0:04:32.56,0:04:33.69,Default,,0,0,0,,Anh có dùng thêm món gì không?
Dialogue: 0,0:04:34.32,0:04:36.66,Default,,0,0,0,,Cho tôi... mơ muối thôi.
Dialogue: 0,0:04:37.86,0:04:38.70,Default,,0,0,0,,Một quả thôi hả?
Dialogue: 0,0:04:40.41,0:04:41.24,Default,,0,0,0,,Hai quả đi.
Dialogue: 0,0:04:48.58,0:04:49.42,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:04:54.38,0:04:55.21,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:04:59.59,0:05:02.34,Default,,0,0,0,,Anh Hoshino là chủ một tiệm rau củ quả\Ntrong khu phố này.
Dialogue: 0,0:05:02.84,0:05:06.55,Default,,0,0,0,,Tất cả rau củ dùng trong quán,\Ntôi đều mua từ chỗ anh ấy.
Dialogue: 0,0:05:13.86,0:05:14.94,Default,,0,0,0,,Vẫn không đúng vị.
Dialogue: 0,0:05:15.86,0:05:17.11,Default,,0,0,0,,Cái gì không đúng cơ?
Dialogue: 0,0:05:18.44,0:05:20.94,Default,,0,0,0,,Mấy quả mơ này Ông chủ mua\Nở tiệm tôi đúng không?
Dialogue: 0,0:05:21.11,0:05:23.82,Default,,0,0,0,,Ừ. Giống mơ Nankobai vùng Kishu đấy.
Dialogue: 0,0:05:26.87,0:05:30.25,Default,,0,0,0,,Dù có dùng cùng một loại mơ,\Nvị của nó vẫn chẳng giống chút nào.
Dialogue: 0,0:05:30.79,0:05:31.92,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:05:34.29,0:05:37.34,Default,,0,0,0,,Hũ mơ muối của mẹ tôi làm cuối cùng cũng hết sạch rồi.
Dialogue: 0,0:05:38.09,0:05:39.30,Default,,0,0,0,,Tôi đã ăn hết nhẵn rồi.
Dialogue: 0,0:05:40.63,0:05:41.47,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:05:43.01,0:05:43.84,Default,,0,0,0,,Bà cụ...
Dialogue: 0,0:05:44.93,0:05:46.22,Default,,0,0,0,,mất từ khi nào nhỉ?
Dialogue: 0,0:05:46.39,0:05:47.52,Default,,0,0,0,,Gần bốn năm trước rồi.
Dialogue: 0,0:05:48.77,0:05:50.52,Default,,0,0,0,,Đã lâu vậy rồi sao?
Dialogue: 0,0:05:53.48,0:05:57.11,Default,,0,0,0,,Tôi biết ngày nào cũng ăn\Nthì sớm muộn gì cũng sẽ hết.
Dialogue: 0,0:05:57.19,0:05:59.03,Default,,0,0,0,,Nhưng mỗi khi ngồi uống rượu một mình ở nhà,
Dialogue: 0,0:05:59.78,0:06:01.66,Default,,0,0,0,,tôi lại thấy cô đơn kinh khủng.
Dialogue: 0,0:06:01.74,0:06:03.83,Default,,0,0,0,,Thế là cứ bất giác lấy ra ăn một, hai quả.
Dialogue: 0,0:06:05.62,0:06:08.87,Default,,0,0,0,,Cũng tại tôi sống với mẹ\Nsuốt bao nhiêu năm trời mà.
Dialogue: 0,0:06:11.66,0:06:14.12,Default,,0,0,0,,Năm nào tôi cũng tự tay ngâm mơ muối.
Dialogue: 0,0:06:15.33,0:06:17.87,Default,,0,0,0,,Nhưng chẳng tài nào làm ra được\Nhương vị giống của mẹ tôi.
Dialogue: 0,0:06:20.00,0:06:21.79,Default,,0,0,0,,Chỉ có mẹ anh mới biết...
Dialogue: 0,0:06:22.80,0:06:24.34,Default,,0,0,0,,cần đong bao nhiêu muối là vừa đủ.
Dialogue: 0,0:06:26.76,0:06:27.72,Default,,0,0,0,,Độ mặn hoàn hảo.
Dialogue: 0,0:06:28.55,0:06:29.64,Default,,0,0,0,,Điều đó quan trọng lắm đấy.
Dialogue: 0,0:06:33.85,0:06:38.15,Default,,0,0,0,,Khi hũ mơ muối cạn sạch,\Ntôi mới thực sự thấm thía rằng mẹ đã đi xa rồi.
Dialogue: 0,0:06:40.23,0:06:42.32,Default,,0,0,0,,Rằng giờ đây tôi thực sự chỉ còn lại một mình.
Dialogue: 0,0:06:46.49,0:06:47.53,Default,,0,0,0,,Dạo gần đây...
Dialogue: 0,0:06:47.95,0:06:51.33,Default,,0,0,0,,tôi cảm giác thời gian trôi nhanh hơn\Ntrước kia nhiều.
Dialogue: 0,0:06:58.08,0:06:59.33,Default,,0,0,0,,Ông chủ,
Dialogue: 0,0:06:59.42,0:07:00.26,Default,,0,0,0,,cho tôi thêm một ly nữa thôi.
Dialogue: 0,0:07:01.38,0:07:03.88,Default,,0,0,0,,Anh uống nữa có sao không đấy?\NSáng mai còn phải dậy sớm mà.
Dialogue: 0,0:07:04.76,0:07:05.85,Default,,0,0,0,,Ừ. Bốn rưỡi sáng là phải dậy rồi.
Dialogue: 0,0:07:19.86,0:07:21.74,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:07:23.28,0:07:25.57,Default,,0,0,0,,Nghe nói ông chủ tiệm rau\Nphải nhập viện hả?
Dialogue: 0,0:07:26.11,0:07:27.65,Default,,0,0,0,,Tiểu đường giai đoạn đầu.
Dialogue: 0,0:07:27.86,0:07:30.36,Default,,0,0,0,,Anh ấy phải nằm viện\Nhai tuần đấy.
Dialogue: 0,0:07:30.87,0:07:32.71,Default,,0,0,0,,- Ông chủ vào thăm ảnh rồi à?\N- Ừ.
Dialogue: 0,0:07:33.37,0:07:35.50,Default,,0,0,0,,Bà chủ quán Kotodama\Nbiết bệnh viện của anh ấy.
Dialogue: 0,0:07:36.91,0:07:38.41,Default,,0,0,0,,Từ ngày mẹ anh ấy qua đời,
Dialogue: 0,0:07:38.83,0:07:40.79,Default,,0,0,0,,chắc việc ăn uống chẳng được tử tế.
Dialogue: 0,0:07:41.75,0:07:43.84,Default,,0,0,0,,Xưa nay anh ấy có bao giờ đụng tay làm việc nhà đâu.
Dialogue: 0,0:07:44.17,0:07:48.80,Default,,0,0,0,,Anh ấy bảo cảm giác như giờ mình đang phải trả giá\Ncho suốt quãng thời gian lười biếng trước kia vậy.
Dialogue: 0,0:07:50.93,0:07:51.85,Default,,0,0,0,,Anh giữ gìn sức khỏe nhé.
Dialogue: 0,0:07:57.31,0:07:58.23,Default,,0,0,0,,Anh Hoshino.
Dialogue: 0,0:07:59.31,0:08:00.81,Default,,0,0,0,,Xong các xét nghiệm hôm nay rồi ạ?
Dialogue: 0,0:08:03.44,0:08:04.32,Default,,0,0,0,,Anh Hoshino?
Dialogue: 0,0:08:05.78,0:08:09.95,Default,,0,0,0,,Mọi hôm vào giờ này\Nluôn có một cụ bà ngồi ở đằng kia.
Dialogue: 0,0:08:11.07,0:08:12.57,Default,,0,0,0,,Sao hôm nay không thấy cụ ấy đâu nhỉ?
Dialogue: 0,0:08:14.58,0:08:16.71,Default,,0,0,0,,Cụ ấy được xuất viện\Nrồi ạ.
Dialogue: 0,0:08:32.30,0:08:35.68,Default,,0,0,0,,Sao người ta lại ăn thạch tokoroten bằng một chiếc đũa thế nhỉ?
Dialogue: 0,0:08:35.97,0:08:37.68,Default,,0,0,0,,Có phải kiêng kỵ hay mê tín gì không?
Dialogue: 0,0:08:38.14,0:08:39.43,Default,,0,0,0,,Tôi cũng không rõ nữa,
Dialogue: 0,0:08:39.52,0:08:43.07,Default,,0,0,0,,nhưng nghe bảo ăn kiểu đó\Nmới là sành điệu nhất.
Dialogue: 0,0:08:43.48,0:08:45.32,Default,,0,0,0,,Thời xưa,
Dialogue: 0,0:08:45.40,0:08:48.57,Default,,0,0,0,,người ta ăn món này bằng một que tăm dài\Ngiống như ăn bánh ngọt vậy.
Dialogue: 0,0:08:50.28,0:08:51.41,Default,,0,0,0,,Ở vùng Kansai,
Dialogue: 0,0:08:51.49,0:08:53.24,Default,,0,0,0,,người ta lại rưới nước đường đen lên ăn.
Dialogue: 0,0:08:56.74,0:08:57.57,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:08:58.33,0:08:59.16,Default,,0,0,0,,Chào mọi người.
Dialogue: 0,0:09:01.12,0:09:03.67,Default,,0,0,0,,Ông chủ, cảm ơn anh đã vào viện\Nthăm tôi nhé.
Dialogue: 0,0:09:04.04,0:09:07.25,Default,,0,0,0,,Mọi người ai cũng lo cho anh đấy.\NBệnh tiểu đường sao rồi?
Dialogue: 0,0:09:07.84,0:09:09.43,Default,,0,0,0,,Đã kiểm soát được rồi.
Dialogue: 0,0:09:11.68,0:09:14.06,Default,,0,0,0,,Có điều dạo này tôi chẳng tài nào ngủ ngon được.
Dialogue: 0,0:09:14.14,0:09:16.60,Default,,0,0,0,,Tại trời nóng quá mức đấy mà.
Dialogue: 0,0:09:16.68,0:09:18.27,Default,,0,0,0,,À thì đó cũng là một phần lý do, nhưng...
Dialogue: 0,0:09:19.85,0:09:23.06,Default,,0,0,0,,Ở trong bệnh viện,\Nngày nào cũng chứng kiến có người qua đời.
Dialogue: 0,0:09:24.23,0:09:27.65,Default,,0,0,0,,Đêm đến tôi cứ nghĩ vẩn vơ về bản thân\Nrồi đâm ra bất an.
Dialogue: 0,0:09:29.15,0:09:30.74,Default,,0,0,0,,Tôi chẳng có gia đình vợ con gì.
Dialogue: 0,0:09:30.82,0:09:34.16,Default,,0,0,0,,Không biết sau khi mình chết đi,\Nai sẽ dọn dẹp di vật cho mình đây.
Dialogue: 0,0:09:34.53,0:09:36.07,Default,,0,0,0,,Chết là hết thôi mà.
Dialogue: 0,0:09:36.58,0:09:38.87,Default,,0,0,0,,Lo chuyện sau khi khuất núi\Nlàm gì cho mệt.
Dialogue: 0,0:09:38.95,0:09:40.99,Default,,0,0,0,,Hay là anh lấy vợ đi?
Dialogue: 0,0:09:41.08,0:09:43.54,Default,,0,0,0,,Tìm người phụ nữ nào khỏe mạnh\Nsống lâu hơn anh ấy.
Dialogue: 0,0:09:45.13,0:09:48.30,Default,,0,0,0,,- Thôi cho tôi xin đi.\N- Anh đang tính nói chuyện gì thế?
Dialogue: 0,0:09:50.26,0:09:51.68,Default,,0,0,0,,Sau khi tôi chết đi...
Dialogue: 0,0:09:52.59,0:09:55.72,Default,,0,0,0,,đống đĩa DVD phim người lớn tôi giấu kỹ trong nhà\Nsẽ bị người ta phát hiện mất.
Dialogue: 0,0:09:55.80,0:09:59.14,Default,,0,0,0,,Thế thì vứt quách đi cho rồi.\NAnh có còn là trai mới lớn nữa đâu.
Dialogue: 0,0:09:59.22,0:10:02.10,Default,,0,0,0,,Đâu có dễ thế được.
Dialogue: 0,0:10:02.18,0:10:03.60,Default,,0,0,0,,Trong đó có mấy cuốn thuộc hàng hiếm đấy.
Dialogue: 0,0:10:07.23,0:10:08.27,Default,,0,0,0,,Nghe tôi nói này Ông chủ,
Dialogue: 0,0:10:08.86,0:10:11.86,Default,,0,0,0,,lỡ một ngày anh ghé tiệm tôi\Nmà thấy tôi đột tử...
Dialogue: 0,0:10:13.40,0:10:14.86,Default,,0,0,0,,anh làm ơn lẻn vào nhà tôi
Dialogue: 0,0:10:14.95,0:10:16.58,Default,,0,0,0,,rồi âm thầm vứt giùm tôi đống đĩa đó nhé?
Dialogue: 0,0:10:17.20,0:10:18.33,Default,,0,0,0,,Cái gì cơ?
Dialogue: 0,0:10:18.45,0:10:21.58,Default,,0,0,0,,Ông chủ cũng độc thân mà.\NAnh hiểu nỗi lòng này đúng không?
Dialogue: 0,0:10:23.12,0:10:25.75,Default,,0,0,0,,Anh em mình lập một giao ước quý ông đi.
Dialogue: 0,0:10:28.25,0:10:29.42,Default,,0,0,0,,Ông chủ,
Dialogue: 0,0:10:30.00,0:10:32.67,Default,,0,0,0,,làm ơn đi mà. Tôi van anh đấy.
Dialogue: 0,0:10:32.76,0:10:33.80,Default,,0,0,0,,Đúng là vớ vẩn hết sức.
Dialogue: 0,0:10:34.97,0:10:39.06,Default,,0,0,0,,Đúng là đến lúc nhắm mắt xuôi tay\Ncũng chẳng rũ bỏ nổi trần tục mà, hả?
Dialogue: 0,0:10:57.70,0:11:01.37,Default,,0,0,0,,Mở cửa ra đi con.
Dialogue: 0,0:11:07.29,0:11:08.12,Default,,0,0,0,,Ai đấy?
Dialogue: 0,0:11:09.71,0:11:12.55,Default,,0,0,0,,Mở cửa ra đi con.
Dialogue: 0,0:11:14.05,0:11:18.18,Default,,0,0,0,,Cho mẹ vào nhà với.
Dialogue: 0,0:11:20.26,0:11:23.01,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:11:24.68,0:11:25.52,Default,,0,0,0,,Mẹ ư?
Dialogue: 0,0:11:25.98,0:11:27.32,Default,,0,0,0,,Mở cửa ra đi con.
Dialogue: 0,0:11:28.06,0:11:31.56,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:11:31.65,0:11:36.53,Default,,0,0,0,,cho mẹ vào nhà với.
Dialogue: 0,0:11:38.95,0:11:40.28,Default,,0,0,0,,Mẹ ơi,
Dialogue: 0,0:11:40.37,0:11:42.58,Default,,0,0,0,,mẹ đã khuất rồi mà.
Dialogue: 0,0:11:43.99,0:11:48.50,Default,,0,0,0,,Vì mẹ đã khuất rồi nên mẹ mới phải xin con thế này.
Dialogue: 0,0:11:51.00,0:11:54.25,Default,,0,0,0,,Cho mẹ vào nhà với.
Dialogue: 0,0:11:54.34,0:11:56.26,Default,,0,0,0,,Làm ơn đi con.
Dialogue: 0,0:11:58.47,0:11:59.39,Default,,0,0,0,,Mẹ ơi,
Dialogue: 0,0:12:00.93,0:12:02.60,Default,,0,0,0,,xin mẹ hãy yên nghỉ nơi chín suối đi.
Dialogue: 0,0:12:04.97,0:12:05.80,Default,,0,0,0,,Xin lỗi cho tôi hỏi.
Dialogue: 0,0:12:08.89,0:12:09.81,Default,,0,0,0,,Xin lỗi cho tôi hỏi.
Dialogue: 0,0:12:14.90,0:12:15.73,Default,,0,0,0,,Vâng.
Dialogue: 0,0:12:17.03,0:12:18.28,Default,,0,0,0,,Tôi lấy quả này nhé.
Dialogue: 0,0:12:24.03,0:12:25.32,Default,,0,0,0,,Quả đó bị dập rồi mà cô?
Dialogue: 0,0:12:29.62,0:12:30.54,Default,,0,0,0,,Quả này cơ à?
Dialogue: 0,0:12:36.42,0:12:38.38,Default,,0,0,0,,Suốt mấy đêm liền gần đây,
Dialogue: 0,0:12:38.72,0:12:40.26,Default,,0,0,0,,cứ lúc tôi đang thiu thiu ngủ,
Dialogue: 0,0:12:41.01,0:12:42.97,Default,,0,0,0,,người mẹ quá cố của tôi lại hiện về gọi cửa.
Dialogue: 0,0:12:43.05,0:12:44.84,Default,,0,0,0,,"Mở cửa ra đi con."
Dialogue: 0,0:12:44.93,0:12:47.06,Default,,0,0,0,,"Cho mẹ vào nhà với."
Dialogue: 0,0:12:47.14,0:12:48.39,Default,,0,0,0,,Bà cụ cứ nói với tôi như thế.
Dialogue: 0,0:12:49.14,0:12:51.81,Default,,0,0,0,,Ông chủ, chắc là ông nằm mơ thôi.
Dialogue: 0,0:12:53.61,0:12:56.78,Default,,0,0,0,,Hễ tôi trùm chăn kín đầu\Nrồi tụng kinh Phật...
Dialogue: 0,0:12:57.36,0:12:59.86,Default,,0,0,0,,là mẹ tôi lại buồn bã nói:
Dialogue: 0,0:13:01.28,0:13:03.37,Default,,0,0,0,,"Cho mẹ vào nhà với.
Dialogue: 0,0:13:03.45,0:13:05.79,Default,,0,0,0,,Mẹ có để quên một thứ."
Dialogue: 0,0:13:06.95,0:13:07.91,Default,,0,0,0,,Để quên một thứ ư?
Dialogue: 0,0:13:09.04,0:13:11.75,Default,,0,0,0,,Biết đâu bà cụ vẫn còn giấu\Ntiền tiết kiệm bí mật ở đâu đó.
Dialogue: 0,0:13:11.83,0:13:14.79,Default,,0,0,0,,Đúng đấy. Chắc cụ còn vướng bận khoản đó.
Dialogue: 0,0:13:14.88,0:13:16.63,Default,,0,0,0,,Tôi không nghĩ vậy đâu.
Dialogue: 0,0:13:17.38,0:13:20.51,Default,,0,0,0,,Toàn bộ gia tài dành dụm được,\Nmẹ tôi đều bỏ vào túi rồi trao hết cho tôi
Dialogue: 0,0:13:20.59,0:13:23.22,Default,,0,0,0,,trước lúc lâm chung rồi.
Dialogue: 0,0:13:23.30,0:13:26.01,Default,,0,0,0,,Sao anh không mở cửa cho cụ vào đại đi?
Dialogue: 0,0:13:27.31,0:13:28.19,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:13:29.31,0:13:31.06,Default,,0,0,0,,Dù có là mẹ ruột đi chăng nữa,
Dialogue: 0,0:13:31.14,0:13:32.27,Default,,0,0,0,,thì giờ bà cụ cũng là ma rồi.
Dialogue: 0,0:13:33.10,0:13:35.94,Default,,0,0,0,,Âm dương cách biệt, có những ranh giới không nên bước qua.
Dialogue: 0,0:13:39.49,0:13:41.28,Default,,0,0,0,,- Chào buổi tối.\N- Xin mời vào.
Dialogue: 0,0:13:43.66,0:13:45.87,Default,,0,0,0,,Em đoán là tầm này đã uống được rồi.
Dialogue: 0,0:13:45.95,0:13:50.04,Default,,0,0,0,,- Ý em là rượu mơ của Ông chủ ấy.\N- Cô đoán chuẩn đấy.
Dialogue: 0,0:13:50.12,0:13:52.37,Default,,0,0,0,,- Rượu mơ Ông chủ tự ngâm hả?\N- Ừ.
Dialogue: 0,0:13:52.83,0:13:55.29,Default,,0,0,0,,Năm nào tôi cũng ngâm một bình lớn.
Dialogue: 0,0:13:55.38,0:13:57.72,Default,,0,0,0,,Mùa hè nóng bức nên em ghét lắm.
Dialogue: 0,0:13:57.80,0:13:59.51,Default,,0,0,0,,Nhưng bù lại được thưởng thức rượu mơ của Ông chủ.
Dialogue: 0,0:14:00.30,0:14:01.43,Default,,0,0,0,,Có ai muốn uống thử không?
Dialogue: 0,0:14:01.51,0:14:03.51,Default,,0,0,0,,Ngâm tròn một năm rồi, đang độ ngon nhất đấy.
Dialogue: 0,0:14:03.59,0:14:04.84,Default,,0,0,0,,Cho em một ly!
Dialogue: 0,0:14:09.68,0:14:13.14,Default,,0,0,0,,- Tim anh có sao không đấy?\N- Không ăn thua rồi.
Dialogue: 0,0:14:14.14,0:14:16.48,Default,,0,0,0,,Vậy là bà cụ đang vướng bận bình rượu này sao?
Dialogue: 0,0:14:17.52,0:14:21.19,Default,,0,0,0,,Hồi còn sống, mỗi lần làm mơ muối\Nlà mẹ tôi cũng ngâm cả rượu mơ.
Dialogue: 0,0:14:22.11,0:14:23.74,Default,,0,0,0,,Mẹ tôi thích rượu mơ lắm.
Dialogue: 0,0:14:24.70,0:14:27.41,Default,,0,0,0,,Tôi cứ đinh ninh là bà cụ đã uống hết sạch rồi cơ.
Dialogue: 0,0:14:28.66,0:14:31.41,Default,,0,0,0,,- Mọi người uống một ly nhé?\N- Thôi, cảm ơn anh.
Dialogue: 0,0:14:32.00,0:14:35.71,Default,,0,0,0,,- Em không muốn làm mẹ anh nổi giận đâu.\N- Đừng lo.
Dialogue: 0,0:14:36.21,0:14:39.67,Default,,0,0,0,,Tôi đã rót một ly dâng lên bàn thờ mẹ rồi.\NVới lại...
Dialogue: 0,0:14:39.75,0:14:43.00,Default,,0,0,0,,hôm nay cũng chính là ngày giỗ\Ncủa mẹ tôi.
Dialogue: 0,0:14:43.97,0:14:45.60,Default,,0,0,0,,Mọi người hãy uống một ly để tưởng nhớ bà cụ nhé.
Dialogue: 0,0:14:46.39,0:14:47.64,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:14:48.72,0:14:50.22,Default,,0,0,0,,Vậy tôi xin một ly nhé.
Dialogue: 0,0:14:51.77,0:14:53.69,Default,,0,0,0,,Thế thì cho em nữa.
Dialogue: 0,0:14:54.60,0:14:56.14,Default,,0,0,0,,Vậy cho em xin một ly luôn nhé?
Dialogue: 0,0:14:58.02,0:14:59.56,Default,,0,0,0,,Em rất thích rượu mơ của Ông chủ,
Dialogue: 0,0:15:00.69,0:15:04.69,Default,,0,0,0,,nhưng rượu của mẹ anh cũng đậm đà hương vị\Nmà hậu vị lại êm dịu nữa.
Dialogue: 0,0:15:05.28,0:15:06.28,Default,,0,0,0,,Thế là,
Dialogue: 0,0:15:06.78,0:15:10.03,Default,,0,0,0,,lấy cớ tưởng nhớ bà cụ,\Nhọ đã uống cạn sạch cả bình rượu.
Dialogue: 0,0:15:10.53,0:15:11.70,Default,,0,0,0,,Thế nhưng ngay đêm hôm đó...
Dialogue: 0,0:15:13.66,0:15:15.79,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:15:17.25,0:15:21.21,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:15:23.84,0:15:27.97,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:15:30.60,0:15:32.94,Default,,0,0,0,,Vậy thứ bà cụ tìm không phải là rượu mơ sao?
Dialogue: 0,0:15:56.58,0:15:59.29,Default,,0,0,0,,Nếu không phải rượu mơ,\Nthì còn có thể là thứ gì được chứ?
Dialogue: 0,0:16:04.09,0:16:05.80,Default,,0,0,0,,Mẹ anh ấy muốn rước anh ấy đi cùng đấy.
Dialogue: 0,0:16:06.59,0:16:08.84,Default,,0,0,0,,Qua sông Tam Đồ là coi như đi đời luôn.
Dialogue: 0,0:16:10.55,0:16:11.47,Default,,0,0,0,,Mọi người đang bàn chuyện gì thế?
Dialogue: 0,0:16:12.97,0:16:14.76,Default,,0,0,0,,Chuyện ông chủ tiệm rau củ ấy mà.
Dialogue: 0,0:16:15.56,0:16:18.90,Default,,0,0,0,,Hồn ma của người mẹ quá cố\Nđêm nào cũng hiện về
Dialogue: 0,0:16:19.40,0:16:20.65,Default,,0,0,0,,khiến anh ấy mất ăn mất ngủ.
Dialogue: 0,0:16:21.40,0:16:24.90,Default,,0,0,0,,Ra vậy. Liệu bà cụ còn điều gì nuối tiếc chăng?
Dialogue: 0,0:16:25.07,0:16:26.61,Default,,0,0,0,,Tụi này nghĩ mãi mà chưa ra.
Dialogue: 0,0:16:28.57,0:16:31.62,Default,,0,0,0,,Làm cái nghề cảnh sát này,\Ntôi đã chứng kiến đủ kiểu người ta qua đời.
Dialogue: 0,0:16:31.99,0:16:34.70,Default,,0,0,0,,Ra đi thanh thản không chút vướng bận ư?
Dialogue: 0,0:16:34.79,0:16:37.79,Default,,0,0,0,,Hiếm lắm. Đa số ai cũng mang theo nỗi niềm nuối tiếc.
Dialogue: 0,0:16:38.66,0:16:41.29,Default,,0,0,0,,Nhưng nghe mọi người nói cứ phản khoa học thế nào ấy.
Dialogue: 0,0:16:42.75,0:16:45.59,Default,,0,0,0,,Bà cụ bảo để quên thứ gì đó\Nnên mới xin vào nhà đúng không?
Dialogue: 0,0:16:46.05,0:16:47.93,Default,,0,0,0,,Vậy thì thứ đó chắc chắn phải nằm trong nhà.
Dialogue: 0,0:16:48.63,0:16:50.63,Default,,0,0,0,,Nếu đã vậy,
Dialogue: 0,0:16:50.72,0:16:53.18,Default,,0,0,0,,anh ấy nên lục tìm khắp nhà một lượt xem sao.
Dialogue: 0,0:16:53.26,0:16:56.14,Default,,0,0,0,,- Nhưng tìm hết cả nhà đâu có dễ.\N- Đúng đấy.
Dialogue: 0,0:16:56.89,0:17:00.94,Default,,0,0,0,,Khoan đã. Chẳng phải ở đây có sẵn một chuyên gia\Nkhám xét hiện trường sao?
Dialogue: 0,0:17:39.27,0:17:42.27,Default,,0,0,0,,Đàn ông mà mất đi ham muốn thì còn gì là đàn ông nữa.
Dialogue: 0,0:17:42.69,0:17:44.90,Default,,0,0,0,,Nhưng đồng thời,\Nnó cũng đem lại lắm phiền phức.
Dialogue: 0,0:17:45.81,0:17:48.06,Default,,0,0,0,,Làm đàn ông đâu có dễ dàng gì.
Dialogue: 0,0:17:49.03,0:17:51.32,Default,,0,0,0,,Cuốn này quý giá chẳng kém gì\Nbảo vật quốc gia đâu đấy.
Dialogue: 0,0:17:53.74,0:17:54.57,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:17:56.70,0:17:57.95,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:18:00.75,0:18:02.84,Default,,0,0,0,,Mọi người tìm thấy gì rồi hả?
Dialogue: 0,0:18:10.42,0:18:11.25,Default,,0,0,0,,Thứ gì thế?
Dialogue: 0,0:18:21.56,0:18:22.52,Default,,0,0,0,,Cái quái gì đây...?
Dialogue: 0,0:18:23.27,0:18:26.77,Default,,0,0,0,,Tranh Xuân Cung (Shunga), một tên gọi khác của\Ndòng tranh khắc gỗ Ukiyo-e về nghệ thuật phòng the.
Dialogue: 0,0:18:26.86,0:18:28.24,Default,,0,0,0,,Người xưa còn gọi là "Tranh Vui",
Dialogue: 0,0:18:28.32,0:18:31.07,Default,,0,0,0,,được dùng như một lá bùa\Nđể trừ tà và bảo vệ gia chủ.
Dialogue: 0,0:18:31.44,0:18:34.99,Default,,0,0,0,,Theo phong tục xưa, người ta thường trao nó\Ncho cô dâu mới như một cuốn cẩm nang
Dialogue: 0,0:18:35.07,0:18:38.07,Default,,0,0,0,,để cô dâu khỏi bỡ ngỡ\Ntrong đêm tân hôn.
Dialogue: 0,0:18:42.04,0:18:45.34,Default,,0,0,0,,Chắc là mẹ tôi đã mang theo những bức tranh này\Nkhi bà về làm dâu.
Dialogue: 0,0:18:48.25,0:18:49.75,Default,,0,0,0,,Chắc chắn là thứ này rồi.
Dialogue: 0,0:18:51.92,0:18:55.88,Default,,0,0,0,,Ngay khi tìm thấy, tôi liền mang chúng\Nđến ngôi chùa của gia đình để làm lễ hóa giải.
Dialogue: 0,0:18:55.97,0:18:57.72,Default,,0,0,0,,Kể từ đó, hồn ma của mẹ tôi không còn hiện về nữa.
Dialogue: 0,0:19:00.18,0:19:04.60,Default,,0,0,0,,Nhưng sao mãi tận bây giờ,\Nsau khi mất bao lâu rồi bà cụ mới sực nhớ ra nhỉ?
Dialogue: 0,0:19:05.39,0:19:09.10,Default,,0,0,0,,Còn sao nữa, tại cậu con trai cứ nơm nớp lo chuyện\Nđống đĩa DVD người lớn của mình chứ sao.
Dialogue: 0,0:19:09.57,0:19:11.78,Default,,0,0,0,,Chắc điều đó đã khiến bà cụ\Nsực nhớ tới món đồ bí mật của mình.
Dialogue: 0,0:19:14.24,0:19:15.91,Default,,0,0,0,,Mẹ tôi cũng giống hệt tôi.
Dialogue: 0,0:19:15.99,0:19:17.99,Default,,0,0,0,,Chẳng bao giờ nỡ vứt đi thứ gì.
Dialogue: 0,0:19:18.78,0:19:20.12,Default,,0,0,0,,Đó là bản tính tiết kiệm của gia đình tôi rồi.
Dialogue: 0,0:19:20.49,0:19:22.83,Default,,0,0,0,,Bà cụ lo cho anh đấy thôi.
Dialogue: 0,0:19:24.41,0:19:28.00,Default,,0,0,0,,Mẹ anh ấy mà.\NBà cụ thấy anh sống cô đơn quá.
Dialogue: 0,0:19:28.54,0:19:31.38,Default,,0,0,0,,Nên mới hiện về\Nđể giục anh sớm tìm một người bầu bạn.
Dialogue: 0,0:19:32.21,0:19:34.80,Default,,0,0,0,,Dù ở thế giới bên kia\Nhay ở cõi trần này,
Dialogue: 0,0:19:35.22,0:19:36.43,Default,,0,0,0,,bà cụ vẫn mãi là mẹ của anh.
Dialogue: 0,0:19:36.51,0:19:38.05,Default,,0,0,0,,Và anh vẫn mãi là đứa con trai của bà.
Dialogue: 0,0:19:44.10,0:19:45.77,Default,,0,0,0,,Mọi người uống đi nhé.
Dialogue: 0,0:19:46.60,0:19:48.81,Default,,0,0,0,,Hôm nay tôi khao tất cả.
Dialogue: 0,0:19:48.90,0:19:51.65,Default,,0,0,0,,Tụi này trúng số rồi.
Dialogue: 0,0:20:06.79,0:20:08.00,Default,,0,0,0,,Xin chào.
Dialogue: 0,0:20:08.50,0:20:09.42,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:20:11.08,0:20:12.17,Default,,0,0,0,,Trông anh hồng hào khỏe mạnh quá.
Dialogue: 0,0:20:14.30,0:20:16.18,Default,,0,0,0,,May mắn là được như vậy.
Dialogue: 0,0:20:17.84,0:20:19.18,Default,,0,0,0,,Tôi là Okubo, y tá ở viện đây.
Dialogue: 0,0:20:21.93,0:20:24.39,Default,,0,0,0,,À phải rồi. Cảm ơn cô đã tận tình chăm sóc tôi nhé.
Dialogue: 0,0:20:25.64,0:20:28.39,Default,,0,0,0,,Cô không mặc đồng phục y tá\Nlàm tôi không nhận ra ngay.
Dialogue: 0,0:20:28.48,0:20:29.94,Default,,0,0,0,,Ai gặp tôi ở ngoài cũng bảo thế đấy.
Dialogue: 0,0:20:31.44,0:20:32.69,Default,,0,0,0,,Trong người anh thấy thế nào rồi?
Dialogue: 0,0:20:33.82,0:20:37.62,Default,,0,0,0,,Như cô thấy đấy, tôi khỏe hơn nhiều rồi,\Ncứ như được sinh ra lần nữa vậy.
Dialogue: 0,0:20:40.82,0:20:43.03,Default,,0,0,0,,Hôm nay có dịp gì mà cô ghé qua khu này thế?
Dialogue: 0,0:20:43.33,0:20:45.37,Default,,0,0,0,,Tại tôi muốn ghé thăm tiệm rau của anh.
Dialogue: 0,0:20:46.58,0:20:49.21,Default,,0,0,0,,Thật sao? Cô cất công đến tận đây chỉ để xem tiệm thôi à?
Dialogue: 0,0:20:50.42,0:20:52.59,Default,,0,0,0,,Vì tôi cứ lo cho anh mãi.
Dialogue: 0,0:20:58.17,0:20:59.21,Default,,0,0,0,,Ở đây có món gì ngon nhỉ?
Dialogue: 0,0:21:02.89,0:21:06.14,Default,,0,0,0,,Để xem nào. Cô ăn thử đậu bắp nhé?
Dialogue: 0,0:21:06.68,0:21:08.77,Default,,0,0,0,,- Cho tôi một phần.\N- Một phần thôi hả?
Dialogue: 0,0:21:09.06,0:21:11.10,Default,,0,0,0,,- Vậy cho hai phần đi.\N- Hai phần nhé.
Dialogue: 0,0:21:20.28,0:21:21.11,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:21:24.24,0:21:26.91,Default,,0,0,0,,Muối chính là yếu tố quyết định hương vị của mơ muối.
Dialogue: 0,0:21:27.24,0:21:29.95,Default,,0,0,0,,Nếu dùng muối hạt thô còn giữ nguyên khoáng chất tự nhiên
Dialogue: 0,0:21:30.04,0:21:34.67,Default,,0,0,0,,thay vì muối tinh luyện, nó sẽ làm dậy lên\Nvị ngọt umami tự nhiên của quả mơ.
Dialogue: 0,0:21:35.92,0:21:38.92,Default,,0,0,0,,Những quả mơ ngâm trong bình rượu mơ\Ncó thể lấy ra ăn trực tiếp.
Dialogue: 0,0:21:39.63,0:21:41.92,Default,,0,0,0,,Hoặc dùng làm mứt hay thạch đều rất ngon.
Dialogue: 0,0:21:43.18,0:21:44.02,Default,,0,0,0,,Chỉ đơn giản vậy thôi.
Dialogue: 0,0:21:44.93,0:21:47.27,Default,,0,0,0,,Chúc quý khách ngủ ngon.
Dialogue: 0,0:21:49.60,0:21:53.77,Default,,0,0,0,,Yoichi...
Dialogue: 0,0:21:55.36,0:21:56.95,Default,,0,0,0,,Giờ thì mẹ có thể nhắm mắt yên nghỉ được rồi.
Dialogue: 0,0:21:57.94,0:22:00.19,Default,,0,0,0,,Con đã tìm được một người đặc biệt cho riêng mình rồi.
Dialogue: 0,0:22:00.99,0:22:02.24,Default,,0,0,0,,Con chào bác ạ.
Dialogue: 0,0:22:02.32,0:22:04.66,Default,,0,0,0,,Con sẽ chăm sóc thật tốt cho sức khỏe của anh ấy.
Dialogue: 0,0:22:05.95,0:22:07.87,Default,,0,0,0,,Và con cũng sẽ tiếp nối việc ngâm mơ muối mỗi năm.
Dialogue: 0,0:22:09.54,0:22:10.62,Default,,0,0,0,,Còn nữa...
Dialogue: 0,0:22:10.70,0:22:13.58,Default,,0,0,0,,con sẽ giữ gìn thật cẩn thận\Nnhững bức tranh Xuân Cung của mẹ ạ.
Dialogue: 0,0:22:22.30,0:22:24.18,Default,,0,0,0,,- Mong mẹ yên nghỉ.\N- Mong bác yên nghỉ.
Dialogue: 0,0:23:49.01,0:23:53.85,Default,,0,0,0,,CÂU CHUYỆN NÀY LÀ HƯ CẤU
