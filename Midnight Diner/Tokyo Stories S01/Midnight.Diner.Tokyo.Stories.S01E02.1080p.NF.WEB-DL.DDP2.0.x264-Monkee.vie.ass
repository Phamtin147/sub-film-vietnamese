Dialogue: 0,0:01:02.65,0:01:07.07,Default,,0,0,0,,Khi người ta kết thúc một ngày\Nvà vội vã trở về nhà,
Dialogue: 0,0:01:07.82,0:01:09.28,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:27.09,0:01:31.72,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm\Nđến bảy giờ sáng.
Dialogue: 0,0:01:32.76,0:01:35.89,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:40.52,0:01:41.77,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:42.52,0:01:44.23,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:47.73,0:01:51.03,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN Ở TOKYO
Dialogue: 0,0:01:51.11,0:01:54.99,Default,,0,0,0,,XÚC XÍCH TẨM BỘT CHIÊN
Dialogue: 0,0:02:02.83,0:02:04.21,Default,,0,0,0,,Ông chủ, tôi mua đủ đồ rồi đây.
Dialogue: 0,0:02:05.13,0:02:05.96,Default,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:02:06.04,0:02:07.17,Default,,0,0,0,,Làm cái gì mà đi lâu thế hả?
Dialogue: 0,0:02:07.71,0:02:11.55,Default,,0,0,0,,Đây là ông Serao Kesera,\Nmột nghệ sĩ hài gạo cội ở vùng Asakusa.
Dialogue: 0,0:02:11.92,0:02:14.59,Default,,0,0,0,,Ông ấy đột nhiên đòi ăn bánh kếp,
Dialogue: 0,0:02:14.93,0:02:19.27,Default,,0,0,0,,nên đã bắt cậu học trò cũ là Hajime\Nchạy ra ngoài mua nguyên liệu.
Dialogue: 0,0:02:19.47,0:02:20.30,Default,,0,0,0,,Này.
Dialogue: 0,0:02:23.02,0:02:27.02,Default,,0,0,0,,Hajime giờ đã trở thành một diễn viên truyền hình ăn khách.
Dialogue: 0,0:02:27.40,0:02:30.28,Default,,0,0,0,,Nghe đâu cậu ấy còn nổi tiếng hơn\Ncả sư phụ của mình.
Dialogue: 0,0:02:40.29,0:02:41.92,Default,,0,0,0,,- Của ngài đây.\N- Cảm ơn nhé.
Dialogue: 0,0:02:43.08,0:02:44.92,Default,,0,0,0,,Còn phần này là cho cậu, Hajime.
Dialogue: 0,0:02:48.71,0:02:52.05,Default,,0,0,0,,Tôi không có sẵn xúc xích thường,\Nnên đã dùng tạm xúc xích cá.
Dialogue: 0,0:02:52.17,0:02:54.46,Default,,0,0,0,,Tiện còn dư chút bột pha,\Ntôi làm tặng cậu cây này đấy.
Dialogue: 0,0:02:55.05,0:02:57.72,Default,,0,0,0,,Cảm ơn ông chủ. Nhìn ngon quá đi mất.
Dialogue: 0,0:02:58.26,0:03:00.76,Default,,0,0,0,,Khoan đã. Đưa đây cho ta.
Dialogue: 0,0:03:01.22,0:03:02.14,Default,,0,0,0,,Không đời nào.
Dialogue: 0,0:03:02.60,0:03:05.73,Default,,0,0,0,,- Sao lại không?\N- Tại con rất mê món xúc xích tẩm bột chiên này.
Dialogue: 0,0:03:06.10,0:03:09.15,Default,,0,0,0,,Thôi nào, Hajime. Đi mà.
Dialogue: 0,0:03:09.23,0:03:10.82,Default,,0,0,0,,Mình đổi cho nhau đi.
Dialogue: 0,0:03:10.90,0:03:14.45,Default,,0,0,0,,Chính thầy đòi ăn bánh kếp,\Nnên con mới phải lặn lội đi mua nguyên liệu về đấy.
Dialogue: 0,0:03:14.61,0:03:17.15,Default,,0,0,0,,Ta đổi ý rồi. Được chưa hả?
Dialogue: 0,0:03:17.28,0:03:19.24,Default,,0,0,0,,- Không là không.\N- Vậy cho cắn một miếng thôi.
Dialogue: 0,0:03:19.32,0:03:20.53,Default,,0,0,0,,- Đúng một miếng thôi.\N- Không.
Dialogue: 0,0:03:21.33,0:03:22.16,Default,,0,0,0,,Cái thằng này!
Dialogue: 0,0:03:22.66,0:03:25.04,Default,,0,0,0,,Ta đã hạ giọng năn nỉ đàng hoàng,\Nmà mày đối xử với sư phụ thế hả?
Dialogue: 0,0:03:25.12,0:03:27.66,Default,,0,0,0,,Mày nghĩ nhờ ai mà mày mới\Ntrở thành diễn viên được như hôm nay hả?
Dialogue: 0,0:03:27.75,0:03:29.54,Default,,0,0,0,,Đừng có làm ầm lên chỉ vì một cây xúc xích chiên chứ.
Dialogue: 0,0:03:29.63,0:03:33.68,Default,,0,0,0,,Có mỗi cây xúc xích chiên mà làm gì căng thế?\NBánh kếp của thầy sắp--
Dialogue: 0,0:03:36.63,0:03:39.09,Default,,0,0,0,,Này! Đừng, dừng lại đi!
Dialogue: 0,0:03:41.01,0:03:43.55,Default,,0,0,0,,Hajime, cứ nhường cho ông ấy đi.
Dialogue: 0,0:03:43.64,0:03:45.31,Default,,0,0,0,,Để tôi làm cái mới cho cậu.
Dialogue: 0,0:03:45.39,0:03:47.43,Default,,0,0,0,,Vấn đề không phải ở chuyện đó.
Dialogue: 0,0:03:47.77,0:03:49.73,Default,,0,0,0,,Lúc nào ông ấy cũng giở cái thói ngang ngược này cả.
Dialogue: 0,0:03:50.31,0:03:53.48,Default,,0,0,0,,Dùng xúc xích cá làm nhân công nhận hợp vị thật.
Dialogue: 0,0:03:53.57,0:03:55.45,Default,,0,0,0,,Ông chủ, món này ngon tuyệt cú mèo.
Dialogue: 0,0:03:57.95,0:04:00.54,Default,,0,0,0,,Món xúc xích tẩm bột chiên của tôi đã trở thành món ruột của ông ấy.
Dialogue: 0,0:04:00.82,0:04:04.78,Default,,0,0,0,,Kể từ dạo đó, ông Serao thường xuyên\Nmột mình ghé đến quán tôi.
Dialogue: 0,0:04:06.91,0:04:08.04,Default,,0,0,0,,- Chào.\N- Xin mời vào.
Dialogue: 0,0:04:08.12,0:04:09.91,Default,,0,0,0,,- Ông ấy tới kìa.\N- Chào danh hài đại sư!
Dialogue: 0,0:04:11.46,0:04:13.46,Default,,0,0,0,,Nhiều vị khách quen ở quán tôi là người hâm mộ của ông ấy.
Dialogue: 0,0:04:13.54,0:04:15.79,Default,,0,0,0,,Mỗi lần ông ấy ghé là họ lại hào hứng ra mặt.
Dialogue: 0,0:04:15.88,0:04:17.63,Default,,0,0,0,,Ông chủ, cho tôi một cây xúc xích tẩm bột chiên nhé.
Dialogue: 0,0:04:18.17,0:04:20.01,Default,,0,0,0,,- Cho em một cây nữa.\N- Em cũng thế.
Dialogue: 0,0:04:20.59,0:04:21.42,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:04:33.15,0:04:36.24,Default,,0,0,0,,Dù bà ta đã qua cái thời xuân sắc từ lâu rồi,
Dialogue: 0,0:04:36.32,0:04:38.11,Default,,0,0,0,,nhưng nhìn vẫn còn mặn mà chán.
Dialogue: 0,0:04:38.57,0:04:41.03,Default,,0,0,0,,Lúc tôi chọt nhẹ từ đằng sau...
Dialogue: 0,0:04:43.87,0:04:45.71,Default,,0,0,0,,Đúng kiểu như thế này này.
Dialogue: 0,0:04:46.70,0:04:49.37,Default,,0,0,0,,Thế là máu trong người tôi bắt đầu rạo rực lên.
Dialogue: 0,0:04:49.66,0:04:51.58,Default,,0,0,0,,Tôi mới tính luồn tay sờ nắn cặp tuyết lê của bả.
Dialogue: 0,0:04:51.75,0:04:53.29,Default,,0,0,0,,Tôi vòng tay ôm từ phía sau.
Dialogue: 0,0:04:54.25,0:04:56.29,Default,,0,0,0,,Đôi gò bồng đảo chín muồi của bà ấy...
Dialogue: 0,0:04:57.26,0:04:59.55,Default,,0,0,0,,vừa mềm mại lại vừa mướt mát.\NVừa khít trong lòng bàn tay tôi.
Dialogue: 0,0:04:59.76,0:05:02.18,Default,,0,0,0,,Thế rồi bả đột nhiên thốt lên:
Dialogue: 0,0:05:02.26,0:05:03.89,Default,,0,0,0,,"Ông đang tính sờ mó cái chỗ nào đấy?"
Dialogue: 0,0:05:04.51,0:05:06.14,Default,,0,0,0,,"Thì ngực của em chứ còn gì nữa."
Dialogue: 0,0:05:06.43,0:05:10.18,Default,,0,0,0,,"Chỗ đó làm gì phải ngực.\NNgực của tôi nằm ở tuốt trên cao hơn cơ."
Dialogue: 0,0:05:10.27,0:05:12.06,Default,,0,0,0,,Hóa ra, thứ mà tôi nắn bóp nãy giờ
Dialogue: 0,0:05:12.31,0:05:14.52,Default,,0,0,0,,lại là ngấn mỡ bụng của bà già đó!
Dialogue: 0,0:05:17.48,0:05:20.82,Default,,0,0,0,,Đừng có kể chuyện tiếu lâm tục tĩu trước mặt phụ nữ chứ.
Dialogue: 0,0:05:20.90,0:05:24.28,Default,,0,0,0,,Thôi nào người đẹp. Chẳng phải cô cũng khoái nghe lắm sao?
Dialogue: 0,0:05:25.24,0:05:26.78,Default,,0,0,0,,Thế này là quấy rối tình dục đấy nhé.
Dialogue: 0,0:05:27.37,0:05:30.21,Default,,0,0,0,,Bình tĩnh nào, Rumi.\NĐó chỉ là một đoạn trong tiết mục tấu hài của bác ấy thôi.
Dialogue: 0,0:05:30.50,0:05:31.38,Default,,0,0,0,,Tiết mục tấu hài á?
Dialogue: 0,0:05:32.08,0:05:35.04,Default,,0,0,0,,Cậu không biết bác ấy sao? Nghệ sĩ Serao Kesera đấy.
Dialogue: 0,0:05:35.21,0:05:38.80,Default,,0,0,0,,Người ta vẫn mệnh danh ông ấy là bậc thầy tấu hài cuối cùng\Ncủa vùng Asakusa đấy.
Dialogue: 0,0:05:38.92,0:05:42.59,Default,,0,0,0,,Hồi còn nhỏ cháu toàn xem các tiết mục hài độc thoại\Ncủa bác trên tivi suốt thôi.
Dialogue: 0,0:05:42.68,0:05:43.51,Default,,0,0,0,,Thật thế à?
Dialogue: 0,0:05:44.72,0:05:47.06,Default,,0,0,0,,Cậu biết nam diễn viên truyền hình Hajime Moriwaki\Nchứ hả?
Dialogue: 0,0:05:47.22,0:05:48.56,Default,,0,0,0,,Biết chứ, mình biết anh ấy.
Dialogue: 0,0:05:48.64,0:05:51.35,Default,,0,0,0,,Anh ấy từng là đệ tử ruột\Ncủa vị danh hài này đấy.
Dialogue: 0,0:05:53.52,0:05:54.44,Default,,0,0,0,,Cũng có gì to tát đâu.
Dialogue: 0,0:05:54.94,0:05:57.69,Default,,0,0,0,,Hajime Moriwaki.\NAnh chàng đó điển trai thật đấy, nhỉ?
Dialogue: 0,0:05:57.77,0:06:01.23,Default,,0,0,0,,Lại còn hài hước nữa. Mình rất thích\Ncách dùng từ dí dỏm của anh ấy.
Dialogue: 0,0:06:01.32,0:06:04.74,Default,,0,0,0,,Vừa đẹp trai lại vừa hài hước ư?\NĐúng chuẩn người đàn ông hoàn hảo rồi.
Dialogue: 0,0:06:04.82,0:06:06.24,Default,,0,0,0,,Chà, đáng tiếc thay,
Dialogue: 0,0:06:06.78,0:06:10.53,Default,,0,0,0,,"cậu nhỏ" của thằng đó lại chẳng có gì ấn tượng cả.
Dialogue: 0,0:06:10.62,0:06:13.21,Default,,0,0,0,,Hajime Moriwaki có con trai rồi cơ á?
Dialogue: 0,0:06:13.29,0:06:14.67,Default,,0,0,0,,Ý bác ấy không phải là con trai đâu.
Dialogue: 0,0:06:15.12,0:06:17.75,Default,,0,0,0,,Hàng cực phẩm thì người ta gọi là\N"ngàn con giun đất".
Dialogue: 0,0:06:17.84,0:06:20.30,Default,,0,0,0,,Nhưng của thằng đó thì trông chỉ như một con giun đất lẻ loi thôi.
Dialogue: 0,0:06:20.88,0:06:23.26,Default,,0,0,0,,Chẳng dài. Mà cũng chẳng cứng.
Dialogue: 0,0:06:23.34,0:06:27.22,Default,,0,0,0,,Ông trời chẳng cho ai hoàn hảo đôi đường.\NGiờ thì tôi đã tin là có Chúa thật rồi.
Dialogue: 0,0:06:28.18,0:06:29.39,Default,,0,0,0,,Bộ bác nhìn thấy tận mắt rồi sao?
Dialogue: 0,0:06:29.47,0:06:32.06,Default,,0,0,0,,Thấy lúc nó kỳ lưng cho tôi\Nở nhà tắm công cộng chứ đâu.
Dialogue: 0,0:06:33.35,0:06:34.18,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:34.27,0:06:37.73,Default,,0,0,0,,Đi nhà tắm công cộng thì nhìn qua là biết\Ndài hay ngắn ngay thôi.
Dialogue: 0,0:06:38.06,0:06:40.23,Default,,0,0,0,,Nhưng làm sao bác biết được là nó mềm hay cứng chứ?
Dialogue: 0,0:06:41.44,0:06:42.86,Default,,0,0,0,,Thế còn của đại sư thì sao?
Dialogue: 0,0:06:43.69,0:06:46.82,Default,,0,0,0,,Người đời vẫn gọi hàng của tôi là Trăn Khổng Lồ Vùng Asakusa đấy.
Dialogue: 0,0:06:47.20,0:06:49.91,Default,,0,0,0,,Một con trăn khổng lồ cực kỳ biết cách ẩn mình.
Dialogue: 0,0:06:51.79,0:06:53.50,Default,,0,0,0,,SERAO KESERA
Dialogue: 0,0:06:53.62,0:06:55.37,Default,,0,0,0,,Tôi vừa bị một cơn đau tim vật.
Dialogue: 0,0:06:55.46,0:07:00.05,Default,,0,0,0,,May mà vẫn còn giữ được mạng.\NMọi người biết nguyên nhân tại sao không? Tại thuốc Viagra đấy.
Dialogue: 0,0:07:00.13,0:07:02.13,Default,,0,0,0,,Ừ. Thủ phạm chính là nó đấy.
Dialogue: 0,0:07:02.21,0:07:03.88,Default,,0,0,0,,Thứ đó chẳng tốt cho tim mạch của tôi chút nào.
Dialogue: 0,0:07:03.97,0:07:08.81,Default,,0,0,0,,Nhưng quý vị biết đấy, ở cái tuổi xế chiều này của tôi,\Ntôi thực sự rất cần đến nó.
Dialogue: 0,0:07:08.89,0:07:10.10,Default,,0,0,0,,Này, nhìn ngay dưới đây đi.
Dialogue: 0,0:07:10.18,0:07:13.31,Default,,0,0,0,,Không có nó thì "thằng nhỏ" của tôi chịu chết không nhúc nhích nổi.
Dialogue: 0,0:07:13.39,0:07:16.98,Default,,0,0,0,,Thế nên giờ mỗi lần ân ái là tôi phải đánh cược cả mạng sống đấy.
Dialogue: 0,0:07:17.06,0:07:18.90,Default,,0,0,0,,Đại văn hào Shakespeare từng nói:
Dialogue: 0,0:07:19.27,0:07:22.19,Default,,0,0,0,,"Làm tình hay là chết. Đó chính là vấn đề."
Dialogue: 0,0:07:26.11,0:07:30.61,Default,,0,0,0,,"Thằng nhỏ" của tôi chỉ sung sức nhất\Nđúng cái lúc tôi vừa mới ngủ dậy thôi.
Dialogue: 0,0:07:31.95,0:07:32.78,Default,,0,0,0,,Đại sư vất vả rồi ạ.
Dialogue: 0,0:07:33.54,0:07:35.67,Default,,0,0,0,,- Ông vất vả rồi.\N- Cảm ơn.
Dialogue: 0,0:07:45.30,0:07:46.13,Default,,0,0,0,,Chào mọi người.
Dialogue: 0,0:07:47.47,0:07:49.64,Default,,0,0,0,,- Ái chà, ngôi sao truyền hình kìa.\N- Thầy dạo này khỏe không ạ?
Dialogue: 0,0:07:51.93,0:07:53.89,Default,,0,0,0,,- Có xem tiết mục của ta không đấy?\N- Dạ có.
Dialogue: 0,0:07:54.35,0:07:56.31,Default,,0,0,0,,Lâu rồi không ghé thăm thầy nên hôm nay con qua.
Dialogue: 0,0:07:57.06,0:07:58.52,Default,,0,0,0,,Nay mày ăn trúng cái gì mà lạ thế?
Dialogue: 0,0:07:59.19,0:08:01.32,Default,,0,0,0,,Chú mày nói thế nghe cũng mát lòng mát dạ đấy.
Dialogue: 0,0:08:02.02,0:08:03.90,Default,,0,0,0,,- Đi kiếm gì bỏ bụng thôi.\N- Dạ vâng.
Dialogue: 0,0:08:03.98,0:08:05.19,Default,,0,0,0,,Đợi anh một lát nhé, được không?
Dialogue: 0,0:08:06.44,0:08:09.65,Default,,0,0,0,,- Xong chưa nào? Cười lên nhé.\N- Đủ hết mọi người trong khung hình chưa?
Dialogue: 0,0:08:09.74,0:08:11.70,Default,,0,0,0,,Ảnh bị nhòe mất rồi. Chụp lại tấm nữa đi.
Dialogue: 0,0:08:11.78,0:08:13.62,Default,,0,0,0,,Xin phép cho chúng tôi đi qua.
Dialogue: 0,0:08:15.29,0:08:17.46,Default,,0,0,0,,Xin lỗi.\NAnh có phải là diễn viên Hajime Moriwaki không ạ?
Dialogue: 0,0:08:17.54,0:08:19.00,Default,,0,0,0,,- Vâng, chính tôi.\N- Ôi may quá đi mất!
Dialogue: 0,0:08:19.08,0:08:21.29,Default,,0,0,0,,Anh cho em xin chữ ký được không ạ?
Dialogue: 0,0:08:24.17,0:08:25.55,Default,,0,0,0,,Tụi em chụp chung một tấm hình được không anh?
Dialogue: 0,0:08:25.63,0:08:27.84,Default,,0,0,0,,- Được chứ.\N- Em mê các chương trình anh đóng lắm.
Dialogue: 0,0:08:27.92,0:08:29.92,Default,,0,0,0,,- Bác chụp giúp tụi cháu nhé?\N- Tôi á?
Dialogue: 0,0:08:30.59,0:08:31.55,Default,,0,0,0,,Cảm ơn bác ạ.
Dialogue: 0,0:08:32.76,0:08:35.01,Default,,0,0,0,,- Chuẩn bị xong chưa?\N- Cảm ơn bác.
Dialogue: 0,0:08:35.10,0:08:36.23,Default,,0,0,0,,Chuẩn bị nhé.
Dialogue: 0,0:08:36.85,0:08:38.06,Default,,0,0,0,,Vâng. Bác chụp cho tụi cháu tấm thật đẹp nhé.
Dialogue: 0,0:08:40.39,0:08:42.60,Default,,0,0,0,,- Của mấy đứa đây.\N- Cháu cảm ơn bác.
Dialogue: 0,0:08:42.69,0:08:43.53,Default,,0,0,0,,Thôi mình đi nào.
Dialogue: 0,0:08:43.61,0:08:46.15,Default,,0,0,0,,Xin lỗi bác.\NTụi cháu xin luôn chữ ký của bác được không ạ?
Dialogue: 0,0:08:46.23,0:08:47.06,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:08:47.15,0:08:48.11,Default,,0,0,0,,Bác ký vào tờ này nhé.
Dialogue: 0,0:08:48.19,0:08:49.82,Default,,0,0,0,,Xin gửi bác. Cảm ơn bác nhiều ạ.
Dialogue: 0,0:08:54.87,0:08:56.41,Default,,0,0,0,,Cảm ơn bác.
Dialogue: 0,0:08:56.49,0:08:58.95,Default,,0,0,0,,Bác ơi, bác bắt giùm tụi cháu chiếc taxi được không ạ?
Dialogue: 0,0:08:59.04,0:09:00.58,Default,,0,0,0,,Ờ. Để đó cho bác.
Dialogue: 0,0:09:02.50,0:09:05.00,Default,,0,0,0,,Này. Đằng này. Ngay đây này.
Dialogue: 0,0:09:06.21,0:09:09.00,Default,,0,0,0,,Xin lỗi mấy cô gái nhé.
Dialogue: 0,0:09:09.09,0:09:10.93,Default,,0,0,0,,Giờ anh ấy phải đi ngay rồi.
Dialogue: 0,0:09:11.01,0:09:12.89,Default,,0,0,0,,Thông cảm cho tôi nhé. Hẹn gặp lại mọi người sau.
Dialogue: 0,0:09:16.81,0:09:18.02,Default,,0,0,0,,Cái quái gì thế không biết?
Dialogue: 0,0:09:18.93,0:09:20.85,Default,,0,0,0,,Đáng lẽ ta mới phải là nhân vật chính được săn đón chứ.
Dialogue: 0,0:09:21.81,0:09:24.65,Default,,0,0,0,,Thôi nào anh. Đáng ra anh phải thấy tự hào về cậu ấy mới đúng.
Dialogue: 0,0:09:25.06,0:09:27.40,Default,,0,0,0,,Đệ tử do tay anh dìu dắt giờ đã thành ngôi sao lớn rồi còn gì.
Dialogue: 0,0:09:27.86,0:09:30.07,Default,,0,0,0,,Thời buổi này chỉ cần cái mã đẹp trai là trên hết sao?
Dialogue: 0,0:09:30.65,0:09:33.11,Default,,0,0,0,,Đàn ông đích thực là phải được đánh giá qua thực lực chứ.
Dialogue: 0,0:09:33.49,0:09:36.41,Default,,0,0,0,,Đừng trách con chứ. Đâu phải tự con chọn được khuôn mặt này.
Dialogue: 0,0:09:36.66,0:09:40.04,Default,,0,0,0,,- Vậy thì đổi mặt cho ta đi.\N- Tuyệt đối không đời nào.
Dialogue: 0,0:09:40.37,0:09:42.50,Default,,0,0,0,,Mày vừa nói cái gì hả, thằng ranh con?
Dialogue: 0,0:09:42.83,0:09:47.75,Default,,0,0,0,,"Tuyệt đối không đời nào" ư? Đồ tàn nhẫn.\NMày đúng là thằng khốn nạn.
Dialogue: 0,0:09:47.84,0:09:49.30,Default,,0,0,0,,SHIORI
Dialogue: 0,0:10:07.94,0:10:10.19,Default,,0,0,0,,Đúng là đồ trẻ con!
Dialogue: 0,0:10:13.61,0:10:15.49,Default,,0,0,0,,Chị cũng vất vả với ông ấy thật đấy.
Dialogue: 0,0:10:16.95,0:10:18.70,Default,,0,0,0,,Cô thì cũng kém gì tôi đâu.
Dialogue: 0,0:10:25.83,0:10:26.66,Default,,0,0,0,,Miyoko này...
Dialogue: 0,0:10:28.17,0:10:29.96,Default,,0,0,0,,chẳng phải chị rất thích trai trẻ sao?
Dialogue: 0,0:10:30.63,0:10:32.13,Default,,0,0,0,,Ừ, thích chứ.
Dialogue: 0,0:10:35.68,0:10:36.72,Default,,0,0,0,,Ý cô là sao?
Dialogue: 0,0:10:42.68,0:10:43.51,Default,,0,0,0,,Chẳng có gì đâu.
Dialogue: 0,0:10:46.52,0:10:49.15,Default,,0,0,0,,Chị làm gì có gan đó.
Dialogue: 0,0:10:53.53,0:10:54.37,Default,,0,0,0,,Alo?
Dialogue: 0,0:10:55.49,0:10:57.41,Default,,0,0,0,,Cho tôi gọi một chiếc xe.
Dialogue: 0,0:11:16.76,0:11:21.06,Default,,0,0,0,,Này, cái người ngồi đằng kia.\NCó phải là Hajime Moriwaki không nhỉ?
Dialogue: 0,0:11:21.18,0:11:23.89,Default,,0,0,0,,- Cô cũng nhận ra cậu ta à? Nổi tiếng gớm nhỉ?\N- Ai cơ?
Dialogue: 0,0:11:23.97,0:11:26.26,Default,,0,0,0,,Diễn viên truyền hình đấy. Dạo này cậu ta đang nổi đình nổi đám lắm.
Dialogue: 0,0:11:28.35,0:11:29.77,Default,,0,0,0,,Tôi có bao giờ xem tivi đâu.
Dialogue: 0,0:11:36.74,0:11:37.99,Default,,0,0,0,,Ông Serao Kesera ư?
Dialogue: 0,0:11:39.70,0:11:42.66,Default,,0,0,0,,- Mày ở đây thật à. Ta biết ngay mà.\N- Chào buổi tối, thưa thầy.
Dialogue: 0,0:11:43.24,0:11:45.87,Default,,0,0,0,,"Chào buổi tối" cái con khỉ! Đồ khốn nạn!
Dialogue: 0,0:11:46.37,0:11:48.41,Default,,0,0,0,,- Có chuyện gì thế hả thầy?\N- Mày...
Dialogue: 0,0:11:49.42,0:11:51.71,Default,,0,0,0,,Mày đã ngủ với Miyoko rồi đúng không?
Dialogue: 0,0:11:52.55,0:11:53.38,Default,,0,0,0,,Vâng.
Dialogue: 0,0:11:53.88,0:11:56.43,Default,,0,0,0,,- Mày dám mở mồm nói "Vâng" à?\N- Đúng là như vậy.
Dialogue: 0,0:11:57.22,0:12:00.35,Default,,0,0,0,,Đệ tử mà lại dám tòm tem với người đàn bà của sư phụ mình ư?
Dialogue: 0,0:12:01.89,0:12:05.14,Default,,0,0,0,,Mày từ hành tinh nào rơi xuống thế hả? Thằng khốn kiếp!
Dialogue: 0,0:12:05.22,0:12:06.22,Default,,0,0,0,,Ái đau!
Dialogue: 0,0:12:10.06,0:12:12.48,Default,,0,0,0,,Lúc nào thầy cũng toàn giành giật đồ của con trước còn gì.
Dialogue: 0,0:12:12.65,0:12:15.11,Default,,0,0,0,,Cái gì? Câm mồm!
Dialogue: 0,0:12:16.24,0:12:17.24,Default,,0,0,0,,Thằng mất dạy này!
Dialogue: 0,0:12:17.32,0:12:19.82,Default,,0,0,0,,Xin hai người dừng tay đi.
Dialogue: 0,0:12:21.16,0:12:24.20,Default,,0,0,0,,- Thầy có sao không?\N- Đừng có đụng vào người ta!
Dialogue: 0,0:12:25.95,0:12:28.91,Default,,0,0,0,,Cái xúc xích của mày bé tí tẹo...
Dialogue: 0,0:12:30.12,0:12:35.46,Default,,0,0,0,,nhét vừa khít vào hộp cơm trưa\Ncủa mấy đứa nhóc mẫu giáo luôn đấy.
Dialogue: 0,0:12:35.80,0:12:40.72,Default,,0,0,0,,Sao mày có thể vác theo cái nấm kim châm bé tẹo thế trên người hả?
Dialogue: 0,0:12:45.31,0:12:46.69,Default,,0,0,0,,Đứng dậy ngay, thằng khốn!
Dialogue: 0,0:12:48.43,0:12:49.77,Default,,0,0,0,,Ông ngon thì nói lại câu nữa xem. Tôi giết ông đấy.
Dialogue: 0,0:12:49.85,0:12:52.23,Default,,0,0,0,,Mày biết Miyoko đã nói gì với ta không?
Dialogue: 0,0:12:52.94,0:12:54.61,Default,,0,0,0,,Cô ấy bảo có lên giường với mày thật,
Dialogue: 0,0:12:55.27,0:12:59.07,Default,,0,0,0,,nhưng cái của nợ của mày bé đến mức\Ncô ấy còn chẳng biết là đã đút vào hay chưa nữa kìa.
Dialogue: 0,0:12:59.15,0:13:02.28,Default,,0,0,0,,- Hết chịu nổi rồi! Tôi phải giết ông!\N- Câm mồm đi!
Dialogue: 0,0:13:02.36,0:13:04.45,Default,,0,0,0,,Này, đủ rồi đấy.
Dialogue: 0,0:13:05.58,0:13:09.00,Default,,0,0,0,,Muốn đánh lộn thì kéo nhau ra ngoài kia.\NĐó là quy tắc của quán này.
Dialogue: 0,0:13:16.25,0:13:17.08,Default,,0,0,0,,Hajime.
Dialogue: 0,0:13:19.05,0:13:20.93,Default,,0,0,0,,Mày chính thức bị trục xuất khỏi sư môn.
Dialogue: 0,0:13:22.30,0:13:23.59,Default,,0,0,0,,Đằng nào tôi cũng chẳng thiết tha gì nữa.
Dialogue: 0,0:13:28.60,0:13:30.06,Default,,0,0,0,,Sau vụ lùm xùm đó,
Dialogue: 0,0:13:30.60,0:13:33.94,Default,,0,0,0,,ông Serao bắt đầu lao vào rượu chè be bét.
Dialogue: 0,0:13:41.24,0:13:42.07,Default,,0,0,0,,Cho thêm rượu đây.
Dialogue: 0,0:14:16.11,0:14:19.74,Default,,0,0,0,,HAJIME MORIWAKI\NBƯỚC NGOẶT LỚN TRÊN SÂN KHẤU
Dialogue: 0,0:14:20.53,0:14:23.87,Default,,0,0,0,,- Chào đại sư. Hôm nay ngài khỏe chứ ạ?\N- Chào đại sư ạ!
Dialogue: 0,0:14:25.82,0:14:27.53,Default,,0,0,0,,Đại sư Serao, đến giờ lên sân khấu rồi ạ.
Dialogue: 0,0:14:33.71,0:14:36.75,Default,,0,0,0,,- Sắp đến lượt biểu diễn của ngài rồi.\N- Câm mồm đi!
Dialogue: 0,0:14:37.63,0:14:40.22,Default,,0,0,0,,Đại sư? Ngài đi đâu thế ạ?
Dialogue: 0,0:14:46.84,0:14:47.67,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:14:49.26,0:14:51.43,Default,,0,0,0,,Tôi xin lỗi về chuyện ồn ào hôm trước.
Dialogue: 0,0:14:52.18,0:14:53.52,Default,,0,0,0,,Lúc đó tôi xử sự bồng bột quá.
Dialogue: 0,0:14:54.44,0:14:56.86,Default,,0,0,0,,Từ hôm đó đến giờ cậu có gặp lại ông Serao không?
Dialogue: 0,0:14:59.48,0:15:00.32,Default,,0,0,0,,Dạ không, tôi không gặp.
Dialogue: 0,0:15:02.23,0:15:04.61,Default,,0,0,0,,Dạo này ông ấy cứ làm bạn với ma men suốt.
Dialogue: 0,0:15:05.99,0:15:07.58,Default,,0,0,0,,Thường xuyên uống đến mức say bí tỉ.
Dialogue: 0,0:15:09.03,0:15:11.37,Default,,0,0,0,,Tôi e là ông ấy còn chẳng\Nđi diễn nữa rồi.
Dialogue: 0,0:15:12.62,0:15:14.66,Default,,0,0,0,,Chẳng một ai ưa nổi tính nết của ông ấy.
Dialogue: 0,0:15:18.33,0:15:22.17,Default,,0,0,0,,Làm người thì có những chuyện\Nphải biết giữ mồm giữ miệng.
Dialogue: 0,0:15:23.71,0:15:26.17,Default,,0,0,0,,Ông ấy chẳng bao giờ biết điểm dừng là gì.
Dialogue: 0,0:15:27.51,0:15:30.35,Default,,0,0,0,,"Họa từ miệng mà ra."\NCâu đó tả ông ấy đúng không trật phát nào.
Dialogue: 0,0:15:30.64,0:15:33.02,Default,,0,0,0,,Ông ấy say xỉn đến mức bỏ cả buổi diễn.
Dialogue: 0,0:15:36.85,0:15:37.89,Default,,0,0,0,,Chà...
Dialogue: 0,0:15:39.10,0:15:40.77,Default,,0,0,0,,có lẽ đã đến lúc ông ấy nên giải nghệ rồi.
Dialogue: 0,0:15:42.23,0:15:46.44,Default,,0,0,0,,Người ta vẫn bảo phải biết dừng lại đúng lúc mà.
Dialogue: 0,0:16:10.93,0:16:12.93,Default,,0,0,0,,Hồi đó trông ông ấy ngầu lắm.
Dialogue: 0,0:16:18.52,0:16:19.35,Default,,0,0,0,,Tôi...
Dialogue: 0,0:16:21.02,0:16:22.61,Default,,0,0,0,,từng là một võ sĩ.
Dialogue: 0,0:16:24.86,0:16:27.78,Default,,0,0,0,,Tôi đã theo đuổi võ thuật một cách vô cùng nghiêm túc.
Dialogue: 0,0:16:30.41,0:16:32.16,Default,,0,0,0,,Thực lực của tôi cũng thuộc hàng khá...
Dialogue: 0,0:16:33.74,0:16:35.45,Default,,0,0,0,,nhưng rồi mắt tôi bị chấn thương.
Dialogue: 0,0:16:36.41,0:16:37.45,Default,,0,0,0,,Bị bong võng mạc.
Dialogue: 0,0:16:41.54,0:16:44.29,Default,,0,0,0,,Đột nhiên tôi đánh mất mục tiêu sống của đời mình.
Dialogue: 0,0:16:46.13,0:16:48.13,Default,,0,0,0,,Tôi cảm thấy bản thân chẳng còn chút giá trị nào.
Dialogue: 0,0:16:49.30,0:16:50.72,Default,,0,0,0,,Lúc ấy tâm trạng tôi suy sụp thảm hại.
Dialogue: 0,0:16:53.26,0:16:54.43,Default,,0,0,0,,Thế rồi...
Dialogue: 0,0:16:56.02,0:16:57.48,Default,,0,0,0,,tôi tình cờ gặp được ông ấy.
Dialogue: 0,0:16:59.60,0:17:00.69,Default,,0,0,0,,Ở Asakusa à?
Dialogue: 0,0:17:02.02,0:17:03.06,Default,,0,0,0,,Vâng. Trong một quán bar.
Dialogue: 0,0:17:05.98,0:17:09.23,Default,,0,0,0,,Lúc đó tôi chẳng có xu dính túi, cũng chẳng có chốn dung thân.\NÔng ấy đã đứng ra trả tiền hết mọi thứ.
Dialogue: 0,0:17:11.78,0:17:13.91,Default,,0,0,0,,Khi tôi tỉnh rượu thì thấy mình đang nằm ở hậu trường.
Dialogue: 0,0:17:18.08,0:17:21.25,Default,,0,0,0,,Đó cũng là lần đầu tiên\Ntôi được xem ông ấy diễn hài độc thoại.
Dialogue: 0,0:17:24.08,0:17:29.25,Default,,0,0,0,,Diễn xong vừa lĩnh được tiền cát-xê,\Nông ấy liền rủ ngay: "Đi nhậu thôi."
Dialogue: 0,0:17:31.09,0:17:34.09,Default,,0,0,0,,Cách sống phóng khoáng của ông ấy\Nđã cuốn hút tôi hoàn toàn.
Dialogue: 0,0:17:35.76,0:17:37.55,Default,,0,0,0,,Bỗng dưng lòng tôi thấy nhẹ nhõm hơn hẳn.
Dialogue: 0,0:17:39.52,0:17:42.19,Default,,0,0,0,,Ngay ngày hôm sau,\Ntôi đã xin được làm đệ tử theo hầu ông ấy.
Dialogue: 0,0:17:45.23,0:17:46.07,Default,,0,0,0,,Vậy thì...
Dialogue: 0,0:17:47.82,0:17:50.36,Default,,0,0,0,,có lẽ giờ đã đến lượt cậu rồi đấy.
Dialogue: 0,0:17:52.70,0:17:54.24,Default,,0,0,0,,Tất cả những gì ông ấy đã làm cho cậu năm xưa,
Dialogue: 0,0:17:55.45,0:17:58.45,Default,,0,0,0,,sao giờ cậu không đáp đền lại ân tình đó?
Dialogue: 0,0:18:14.34,0:18:15.72,Default,,0,0,0,,Ông chủ, cho tôi thêm một cốc bia.
Dialogue: 0,0:18:16.22,0:18:17.05,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:18:43.00,0:18:45.38,Default,,0,0,0,,- Cụ Kinzo!\N- Nghe tôi nói này.
Dialogue: 0,0:18:45.87,0:18:48.83,Default,,0,0,0,,Tôi chỉ còn sống được chưa đầy nửa năm nữa thôi.
Dialogue: 0,0:18:49.09,0:18:53.59,Default,,0,0,0,,Cho tôi ân ái một lần đi. Hãy làm người phụ nữ cuối cùng của đời tôi nhé.
Dialogue: 0,0:18:53.67,0:18:56.59,Default,,0,0,0,,Đủ rồi đấy ông cụ!\NTôi kiện ông tội quấy rối tình dục bây giờ.
Dialogue: 0,0:18:58.80,0:18:59.97,Default,,0,0,0,,Đây chẳng phải ông Serao sao.
Dialogue: 0,0:19:00.06,0:19:03.15,Default,,0,0,0,,Tụi này cứ lo lắng mãi\Nvì dạo này chẳng thấy ông ấy xuất hiện.
Dialogue: 0,0:19:03.52,0:19:07.48,Default,,0,0,0,,Ai dè lại thấy ông ấy đóng\Ntrong một bộ phim truyền hình phát sóng đêm khuya.
Dialogue: 0,0:19:07.65,0:19:09.74,Default,,0,0,0,,Bác ấy diễn đạt phết đấy chứ, nhỉ?
Dialogue: 0,0:19:09.82,0:19:12.78,Default,,0,0,0,,Tập nào cũng chỉ xuất hiện đúng một phân cảnh ngắn,\Nnhưng diễn vẫn rất ra chất.
Dialogue: 0,0:19:12.86,0:19:15.86,Default,,0,0,0,,Nhân vật của bác ấy sắp gần đất xa trời rồi\Nmà vẫn còn mê gái như điếu đổ.
Dialogue: 0,0:19:15.95,0:19:17.24,Default,,0,0,0,,Vai đó đúng là đo ni đóng giày cho ông ấy còn gì.
Dialogue: 0,0:19:21.41,0:19:22.24,Default,,0,0,0,,Chào mọi người.
Dialogue: 0,0:19:22.91,0:19:24.79,Default,,0,0,0,,- Xin mời vào.\N- Đại diễn viên giá lâm rồi kìa.
Dialogue: 0,0:19:24.87,0:19:26.87,Default,,0,0,0,,- Chào danh hài đại sư!\N- Lâu quá không gặp bác.
Dialogue: 0,0:19:27.33,0:19:30.00,Default,,0,0,0,,- Ông chủ, cho tôi một cây xúc xích tẩm bột chiên nhé?\N- Có ngay.
Dialogue: 0,0:19:32.09,0:19:34.05,Default,,0,0,0,,- Để em cất áo khoác giúp bác nhé.\N- Cảm ơn cô.
Dialogue: 0,0:19:39.72,0:19:43.77,Default,,0,0,0,,Tụi em lo cho bác lắm đấy,\Ntại thấy lâu rồi bác không ghé quán.
Dialogue: 0,0:19:43.85,0:19:47.81,Default,,0,0,0,,Cho tôi xin lỗi nhé.\NDạo này công việc của tôi bận rộn quá mà.
Dialogue: 0,0:19:47.90,0:19:49.94,Default,,0,0,0,,Tuần nào tụi em cũng đón xem phim bác đóng đấy.
Dialogue: 0,0:19:50.02,0:19:51.81,Default,,0,0,0,,Thế thì tôi cảm kích quá.
Dialogue: 0,0:19:51.90,0:19:54.15,Default,,0,0,0,,Mấy cô có biết cái ứng dụng gì đó không nhỉ?\NCái hình con chim ấy?
Dialogue: 0,0:19:54.23,0:19:55.86,Default,,0,0,0,,- Ý bác là Twitter hả?\N- Ờ, chính nó đấy.
Dialogue: 0,0:19:55.94,0:20:00.70,Default,,0,0,0,,Mấy đứa fan trẻ tuổi dùng cái đó\Nđể bình luận khen ngợi diễn xuất của tôi.
Dialogue: 0,0:20:01.12,0:20:04.46,Default,,0,0,0,,Thậm chí có mấy đứa còn lặn lội tìm đến tận\Nrạp hát hài kịch để xem tôi biểu diễn nữa cơ.
Dialogue: 0,0:20:11.13,0:20:12.26,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:20:24.14,0:20:26.06,Default,,0,0,0,,- Cho tôi một cốc bia nhé.\N- Có ngay.
Dialogue: 0,0:20:28.48,0:20:30.44,Default,,0,0,0,,Không chỉ có khán giả hâm mộ đâu,
Dialogue: 0,0:20:31.02,0:20:34.57,Default,,0,0,0,,mà cả một vị đạo diễn điện ảnh\Ncũng đã xem màn trình diễn của tôi.
Dialogue: 0,0:20:35.19,0:20:38.36,Default,,0,0,0,,Ông ấy đang muốn mời tôi đóng một vai\Ntrong bộ phim điện ảnh mới của ông ấy đấy.
Dialogue: 0,0:20:38.57,0:20:41.70,Default,,0,0,0,,Tuyệt cú mèo.\NĐây chắc chắn là bước ngoặt lớn trong sự nghiệp của bác rồi.
Dialogue: 0,0:20:42.87,0:20:45.12,Default,,0,0,0,,Tôi vẫn chưa muốn nghỉ hưu đâu.
Dialogue: 0,0:20:45.45,0:20:48.29,Default,,0,0,0,,Tôi còn phải cạnh tranh sòng phẳng với đám trai trẻ
Dialogue: 0,0:20:48.75,0:20:51.71,Default,,0,0,0,,cả về công việc lẫn phụ nữ nữa chứ.
Dialogue: 0,0:20:58.13,0:20:58.97,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:21:03.51,0:21:04.59,Default,,0,0,0,,Phần này gửi tặng cậu.
Dialogue: 0,0:21:05.76,0:21:07.35,Default,,0,0,0,,Là ông Serao khao cậu đấy.
Dialogue: 0,0:21:08.10,0:21:08.93,Default,,0,0,0,,Ơ kìa, Ông chủ...
Dialogue: 0,0:21:10.10,0:21:12.19,Default,,0,0,0,,Tôi làm gì có lý do nào để khao cái thằng ranh con hỗn láo đó chứ.
Dialogue: 0,0:21:13.36,0:21:15.90,Default,,0,0,0,,Chà, ông có lý do chính đáng đấy chứ.
Dialogue: 0,0:21:18.78,0:21:19.78,Default,,0,0,0,,Vai diễn trong bộ phim truyền hình của ông...
Dialogue: 0,0:21:21.66,0:21:23.66,Default,,0,0,0,,chính là do một tay Hajime thu xếp cho đấy.
Dialogue: 0,0:21:26.66,0:21:27.91,Default,,0,0,0,,Ông thật may mắn...
Dialogue: 0,0:21:29.20,0:21:31.16,Default,,0,0,0,,khi có được một người đệ tử tốt bụng đến vậy.
Dialogue: 0,0:21:50.73,0:21:51.86,Default,,0,0,0,,Cảm ơn mày nhé.
Dialogue: 0,0:21:52.89,0:21:56.89,Default,,0,0,0,,Giờ tên tuổi mày đã lớn đến mức\Ncan thiệp được vào cả khâu tuyển chọn diễn viên rồi cơ à?
Dialogue: 0,0:21:56.98,0:21:59.98,Default,,0,0,0,,Đâu có chuyện đó.\NChỉ là con vô tình buột miệng gợi ý thôi mà.
Dialogue: 0,0:22:00.36,0:22:03.78,Default,,0,0,0,,Ta già cả rồi, không kham nổi nhiều sô diễn cùng lúc đâu.
Dialogue: 0,0:22:04.20,0:22:06.79,Default,,0,0,0,,Con chưa cho phép thầy nghỉ hưu sớm thế đâu nhé.
Dialogue: 0,0:22:06.87,0:22:08.75,Default,,0,0,0,,Mày dám chắc không đấy?
Dialogue: 0,0:22:08.83,0:22:11.92,Default,,0,0,0,,Chẳng mấy chốc ta sẽ cướp sạch hết\Ncác vai diễn của mày cho mà xem.
Dialogue: 0,0:22:12.54,0:22:14.17,Default,,0,0,0,,Thật thế á? Vậy thầy cứ thử xem.
Dialogue: 0,0:22:16.34,0:22:20.05,Default,,0,0,0,,Thôi, hôm nay thế là đủ rồi.\NTạm thời ta tha cho mày một phen đấy.
Dialogue: 0,0:22:22.67,0:22:26.55,Default,,0,0,0,,Khi lớp vỏ bột phồng đều lên,\Nhãy dùng đũa lăn nhẹ.
Dialogue: 0,0:22:26.64,0:22:28.48,Default,,0,0,0,,Làm cách đó thì bánh sẽ chín vàng đều các mặt.
Dialogue: 0,0:22:29.26,0:22:31.93,Default,,0,0,0,,Lớp bột pha này không chỉ hợp để làm đồ ngọt,
Dialogue: 0,0:22:32.02,0:22:34.69,Default,,0,0,0,,mà đem chiên cùng vài nguyên liệu mặn khác cũng rất tuyệt.\NMọi người nên làm thử xem.
Dialogue: 0,0:22:34.77,0:22:35.60,Default,,0,0,0,,Của mọi người đây.
Dialogue: 0,0:22:36.94,0:22:39.19,Default,,0,0,0,,Xúc xích cá tẩm bột chiên giòn. Chúc ngon miệng.
Dialogue: 0,0:22:42.11,0:22:43.03,Default,,0,0,0,,Ngon tuyệt cú mèo.
Dialogue: 0,0:22:44.11,0:22:45.95,Default,,0,0,0,,- Cho tôi xin miếng được không?\N- Hả?
Dialogue: 0,0:22:46.70,0:22:48.79,Default,,0,0,0,,- Xin đúng một miếng thôi mà.\N- Không đời nào.
Dialogue: 0,0:22:49.24,0:22:51.41,Default,,0,0,0,,Mày nghĩ mày là ai hả, thằng khốn?
Dialogue: 0,0:22:51.50,0:22:53.09,Default,,0,0,0,,Chúc quý khán giả ngủ ngon.
Dialogue: 0,0:22:53.16,0:22:56.54,Default,,0,0,0,,Này, cho xin miếng đi mà.
Dialogue: 0,0:23:49.01,0:23:52.01,Default,,0,0,0,,CÂU CHUYỆN NÀY CHỈ LÀ HƯ CẤU
