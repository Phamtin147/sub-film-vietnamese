Dialogue: 0,0:01:10.70,0:01:12.29,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:12.57,0:01:15.11,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:15.87,0:01:17.29,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:41.64,0:01:44.14,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:44.56,0:01:46.15,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:47.27,0:01:50.15,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:52.28,0:01:53.87,Default,,0,0,0,,PHẦN SÚP MISO THỊT HEO,\NBIA, RƯỢU SAKE, SHOCHU
Dialogue: 0,0:01:53.95,0:01:55.41,Default,,0,0,0,,Thực đơn của tôi chỉ có vỏn vẹn từng ấy món.
Dialogue: 0,0:01:55.95,0:01:58.41,Default,,0,0,0,,Nhưng hễ khách gọi món gì,
Dialogue: 0,0:01:58.99,0:02:01.12,Default,,0,0,0,,chỉ cần có sẵn nguyên liệu là tôi đều sẽ làm.
Dialogue: 0,0:02:01.37,0:02:02.91,Default,,0,0,0,,Phương châm của tôi là vậy.
Dialogue: 0,0:02:07.92,0:02:09.17,Default,,0,0,0,,Bạn hỏi liệu có khách khứa nào ghé không ư?
Dialogue: 0,0:02:09.80,0:02:11.43,Default,,0,0,0,,Đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:02:14.80,0:02:18.01,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN ĐỜI TOKYO
Dialogue: 0,0:02:18.10,0:02:21.94,Default,,0,0,0,,LẨU MỘT NGƯỜI
Dialogue: 0,0:02:25.73,0:02:26.77,Default,,0,0,0,,Nóng quá...
Dialogue: 0,0:02:29.48,0:02:30.48,Default,,0,0,0,,Okae này,
Dialogue: 0,0:02:31.07,0:02:31.90,Default,,0,0,0,,bà thích món này lắm hả?
Dialogue: 0,0:02:32.94,0:02:34.15,Default,,0,0,0,,Ừ, tôi mê món này lắm.
Dialogue: 0,0:02:34.61,0:02:36.57,Default,,0,0,0,,Ở nhà một mình bày vẽ nấu nướng lích kích lắm.
Dialogue: 0,0:02:37.16,0:02:40.08,Default,,0,0,0,,Đã thế nấu xong lúc nào cũng thừa mứa\Năn mãi không hết.
Dialogue: 0,0:02:43.50,0:02:45.71,Default,,0,0,0,,Bà Kae là bạn học thuở nhỏ của bác Chu.
Dialogue: 0,0:02:46.17,0:02:48.67,Default,,0,0,0,,Dạo gần đây, bà ấy thường ghé quán sau giờ làm
Dialogue: 0,0:02:49.00,0:02:51.17,Default,,0,0,0,,và gọi món lẩu một người này.
Dialogue: 0,0:03:00.93,0:03:02.31,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn nhé.
Dialogue: 0,0:03:03.64,0:03:04.47,Default,,0,0,0,,Bà ăn sạch bách luôn nhỉ.
Dialogue: 0,0:03:05.31,0:03:07.23,Default,,0,0,0,,- Bà có làm một ly không?\N- Thôi cho tôi cáo từ.
Dialogue: 0,0:03:07.31,0:03:08.90,Default,,0,0,0,,Tôi phải quay lại chỗ làm đây.
Dialogue: 0,0:03:09.23,0:03:10.11,Default,,0,0,0,,Giờ này á?
Dialogue: 0,0:03:10.77,0:03:14.02,Default,,0,0,0,,Dọn phòng ở khách sạn tình nhân ư?\NTầm này làm gì có khách nào trả phòng trước sáng đâu.
Dialogue: 0,0:03:14.11,0:03:16.45,Default,,0,0,0,,Thực ra tầm giờ này lại có khối người trả phòng đấy.
Dialogue: 0,0:03:17.28,0:03:19.95,Default,,0,0,0,,Cậu nhân viên trẻ làm bán thời gian hôm nay xin nghỉ,
Dialogue: 0,0:03:20.03,0:03:21.62,Default,,0,0,0,,nên tôi phải làm thay ca của cậu ta.
Dialogue: 0,0:03:21.87,0:03:23.37,Default,,0,0,0,,Chán thế nhỉ.
Dialogue: 0,0:03:24.58,0:03:25.75,Default,,0,0,0,,Bà nhớ giữ gìn sức khỏe đấy.
Dialogue: 0,0:03:26.12,0:03:29.08,Default,,0,0,0,,Ông lo cho bản thân mình trước đi, ông Chu.\NÔng uống nhiều quá rồi đấy.
Dialogue: 0,0:03:30.50,0:03:31.34,Default,,0,0,0,,Tôi gửi tiền.
Dialogue: 0,0:03:31.84,0:03:32.76,Default,,0,0,0,,Xin cảm ơn.
Dialogue: 0,0:03:34.26,0:03:35.09,Default,,0,0,0,,Thôi nhé...
Dialogue: 0,0:03:38.22,0:03:39.26,Default,,0,0,0,,Hẹn gặp lại sau.
Dialogue: 0,0:03:39.34,0:03:40.47,Default,,0,0,0,,Bà đi cẩn thận nhé.
Dialogue: 0,0:03:44.43,0:03:48.18,Default,,0,0,0,,Okae vốn là con gái\Ncủa ông chủ tiệm giày
Dialogue: 0,0:03:48.52,0:03:50.06,Default,,0,0,0,,từng nằm ở ngay góc phố kia.
Dialogue: 0,0:03:50.19,0:03:51.82,Default,,0,0,0,,Hồi trẻ cổ xinh đẹp lắm.
Dialogue: 0,0:03:53.94,0:03:56.40,Default,,0,0,0,,Dù sinh ra\Nvà lớn lên ở khu Shinjuku này,
Dialogue: 0,0:03:56.78,0:03:58.37,Default,,0,0,0,,nhưng cổ cứ như một tiểu thư khuê các,
Dialogue: 0,0:03:58.74,0:04:01.16,Default,,0,0,0,,lúc nào ra đường cũng che chiếc ô trắng.
Dialogue: 0,0:04:01.66,0:04:04.50,Default,,0,0,0,,- Cách ăn nói cũng y hệt tiểu thư nhà quyền quý.\N- Em chả ưa kiểu người đó.
Dialogue: 0,0:04:04.91,0:04:06.79,Default,,0,0,0,,Nghe cứ làm màu kiểu gì ấy.
Dialogue: 0,0:04:06.87,0:04:10.50,Default,,0,0,0,,Mình cũng biết mấy nhỏ kiểu đó.\NChẳng biết tự lượng sức mình là ai.
Dialogue: 0,0:04:10.58,0:04:13.12,Default,,0,0,0,,Chị em mình chịu chẳng kết bạn nổi với kiểu tiểu thư đó đâu.
Dialogue: 0,0:04:14.50,0:04:18.05,Default,,0,0,0,,Bác Chu, bà ấy là mối tình đầu của bác chứ gì?
Dialogue: 0,0:04:18.47,0:04:19.76,Default,,0,0,0,,Thôi đi mấy cô.
Dialogue: 0,0:04:20.59,0:04:21.80,Default,,0,0,0,,Mấy cô hiểu lầm cả rồi.
Dialogue: 0,0:04:23.43,0:04:24.43,Default,,0,0,0,,Thế rồi sau đó...
Dialogue: 0,0:04:25.31,0:04:27.90,Default,,0,0,0,,cổ được một đạo diễn điện ảnh nổi tiếng\Nphát hiện,
Dialogue: 0,0:04:28.31,0:04:30.35,Default,,0,0,0,,nhưng sự nghiệp diễn xuất lại chẳng mấy thành công.
Dialogue: 0,0:04:31.15,0:04:32.15,Default,,0,0,0,,Về sau,
Dialogue: 0,0:04:32.86,0:04:36.07,Default,,0,0,0,,tôi nghe phong thanh là\Ncổ lấy một người chồng giàu có.
Dialogue: 0,0:04:36.15,0:04:39.45,Default,,0,0,0,,Nhưng trông bà ấy bây giờ có giống người giàu đâu nhỉ?
Dialogue: 0,0:04:40.20,0:04:42.41,Default,,0,0,0,,Khéo toàn chuyện bịa đặt cả thôi.
Dialogue: 0,0:04:43.20,0:04:44.70,Default,,0,0,0,,Đấy, bảo sao tôi chả ưa nổi đàn bà.
Dialogue: 0,0:04:45.58,0:04:48.21,Default,,0,0,0,,Thú thực là\Ntôi cũng chẳng rõ thực hư thế nào.
Dialogue: 0,0:04:48.29,0:04:51.25,Default,,0,0,0,,Dù sao thì chúng tôi cũng đã chẳng gặp nhau\Ngần bốn chục năm trời rồi.
Dialogue: 0,0:04:52.79,0:04:55.42,Default,,0,0,0,,Xem chừng cuộc sống mưu sinh của bà ấy cũng vất vả.
Dialogue: 0,0:04:55.50,0:04:57.00,Default,,0,0,0,,Vậy là bác cũng không biết rõ
Dialogue: 0,0:04:57.09,0:04:59.22,Default,,0,0,0,,suốt ngần ấy năm qua bà ấy sống ra sao à?
Dialogue: 0,0:05:00.30,0:05:02.72,Default,,0,0,0,,Gần đây cổ mới dọn về lại khu này.
Dialogue: 0,0:05:03.59,0:05:06.14,Default,,0,0,0,,Lúc mới gặp lại, tôi thậm chí còn chẳng nhận ra cổ.
Dialogue: 0,0:05:07.18,0:05:10.31,Default,,0,0,0,,Bánh croquette ở tiệm này ngon tuyệt cú mèo.\NCô ăn lúc còn nóng mới ngon.
Dialogue: 0,0:05:10.39,0:05:12.27,Default,,0,0,0,,Về tới nhà là phải ăn ngay đấy. Nhớ nhé?
Dialogue: 0,0:05:13.19,0:05:15.48,Default,,0,0,0,,Hay là cô ăn luôn bây giờ đi?
Dialogue: 0,0:05:16.27,0:05:17.27,Default,,0,0,0,,Sao cơ?
Dialogue: 0,0:05:18.78,0:05:19.74,Default,,0,0,0,,Của cô đ...
Dialogue: 0,0:05:28.83,0:05:30.00,Default,,0,0,0,,Ông Chu?
Dialogue: 0,0:05:33.75,0:05:34.75,Default,,0,0,0,,Đúng là ông thật rồi.
Dialogue: 0,0:05:35.54,0:05:36.79,Default,,0,0,0,,Ông Chu phải không?
Dialogue: 0,0:05:37.63,0:05:38.47,Default,,0,0,0,,Hả?
Dialogue: 0,0:05:39.63,0:05:42.43,Default,,0,0,0,,Tôi là Kae ở tiệm giày ngày xưa đây mà.
Dialogue: 0,0:05:46.39,0:05:47.35,Default,,0,0,0,,Okae đó ư?
Dialogue: 0,0:05:48.31,0:05:49.69,Default,,0,0,0,,Lâu lắm rồi không gặp ông.
Dialogue: 0,0:05:50.14,0:05:51.18,Default,,0,0,0,,Dạo này ông sống thế nào?
Dialogue: 0,0:05:52.94,0:05:54.40,Default,,0,0,0,,Cũng trải qua bao phen sóng gió...
Dialogue: 0,0:05:55.31,0:05:58.44,Default,,0,0,0,,nhưng như bà thấy đấy, tôi vẫn khỏe.
Dialogue: 0,0:05:59.69,0:06:01.07,Default,,0,0,0,,Khi nào rảnh lại gặp nhau nhé.
Dialogue: 0,0:06:03.15,0:06:04.19,Default,,0,0,0,,Teppei.
Dialogue: 0,0:06:04.49,0:06:05.66,Default,,0,0,0,,Đợi cô với.
Dialogue: 0,0:06:12.21,0:06:13.38,Default,,0,0,0,,Ông bảo tôi làm sao cơ?
Dialogue: 0,0:06:13.46,0:06:15.55,Default,,0,0,0,,Bao nuôi tình nhân trẻ á?
Dialogue: 0,0:06:18.88,0:06:21.93,Default,,0,0,0,,Ông Chu dạo này lẩm cẩm mất rồi phải không?
Dialogue: 0,0:06:22.01,0:06:23.22,Default,,0,0,0,,Mong là đầu óc ổng vẫn bình thường.
Dialogue: 0,0:06:24.97,0:06:26.72,Default,,0,0,0,,Nhưng thực ra bác ấy đoán...
Dialogue: 0,0:06:27.39,0:06:29.68,Default,,0,0,0,,cũng chẳng sai hoàn toàn đâu.
Dialogue: 0,0:06:32.43,0:06:36.68,Default,,0,0,0,,Gã thanh niên đó là đứa con trai độc nhất\Ncủa anh trai bà Kae.
Dialogue: 0,0:06:37.15,0:06:39.57,Default,,0,0,0,,Bà ấy gặp lại cậu ta\Ntrong đám tang của anh trai mình hồi năm ngoái
Dialogue: 0,0:06:39.65,0:06:42.44,Default,,0,0,0,,sau hơn mười năm trời bặt vô âm tín.
Dialogue: 0,0:07:04.34,0:07:05.26,Default,,0,0,0,,Vậy...
Dialogue: 0,0:07:05.93,0:07:08.31,Default,,0,0,0,,cháu có tiền\Nđể trả chi phí tang lễ không?
Dialogue: 0,0:07:08.39,0:07:09.47,Default,,0,0,0,,Làm gì có đồng nào ạ.
Dialogue: 0,0:07:10.60,0:07:11.64,Default,,0,0,0,,Không có sao?
Dialogue: 0,0:07:12.39,0:07:14.27,Default,,0,0,0,,Thi hài thì cũng đã hỏa táng xong xuôi rồi.
Dialogue: 0,0:07:14.35,0:07:15.98,Default,,0,0,0,,Thế nên cháu mới phải gọi cầu cứu cô đấy.
Dialogue: 0,0:07:16.64,0:07:19.06,Default,,0,0,0,,Gọi cô để xin tiền á? Cô làm gì có tiền.
Dialogue: 0,0:07:21.77,0:07:22.94,Default,,0,0,0,,Thế thì cô cháu mình đành đánh bài chuồn thôi.
Dialogue: 0,0:07:23.48,0:07:25.65,Default,,0,0,0,,Làm sao mà bỏ trốn như thế được?
Dialogue: 0,0:07:26.11,0:07:29.11,Default,,0,0,0,,- Thế còn hũ tro cốt thì sao?\N- Cháu cóc cần.
Dialogue: 0,0:07:29.20,0:07:32.41,Default,,0,0,0,,Thôi nào. Dù gì ông ấy cũng là bố ruột của cháu mà.
Dialogue: 0,0:07:32.49,0:07:34.87,Default,,0,0,0,,Ông già khốn nạn đó á? Cháu chả coi ổng là gì hết.
Dialogue: 0,0:07:35.41,0:07:38.83,Default,,0,0,0,,Hồi ổng bốc hơi không một dấu vết, cháu đã nhẹ cả người.\NĐùng một cái ổng lăn ra chết.
Dialogue: 0,0:07:38.92,0:07:41.55,Default,,0,0,0,,Ngay cả việc nhặt xương cốt cho ổng cháu còn thấy phí công.
Dialogue: 0,0:07:42.13,0:07:43.09,Default,,0,0,0,,Nghe cô nói đây.
Dialogue: 0,0:07:43.63,0:07:46.34,Default,,0,0,0,,Dù ông ấy có tồi tệ đến mức nào,\Nthì vẫn là cha sinh thành của cháu.
Dialogue: 0,0:07:46.72,0:07:48.26,Default,,0,0,0,,Một giọt máu đào hơn ao nước lã.
Dialogue: 0,0:07:48.80,0:07:51.14,Default,,0,0,0,,Cháu không thể làm ngơ như thế được.
Dialogue: 0,0:07:51.51,0:07:53.93,Default,,0,0,0,,Trong thâm tâm cháu cũng hiểu rõ điều đó.\NThế nên cháu mới gọi cho cô chứ gì.
Dialogue: 0,0:07:59.77,0:08:02.44,Default,,0,0,0,,Thiệt tình, cháu hết thuốc chữa rồi.
Dialogue: 0,0:08:03.48,0:08:06.48,Default,,0,0,0,,Để cô vào xin người ta\Ncho trả góp từng đợt xem sao.
Dialogue: 0,0:08:08.57,0:08:09.95,Default,,0,0,0,,Khổ nỗi,
Dialogue: 0,0:08:10.49,0:08:11.91,Default,,0,0,0,,cậu cháu trai của bà Kae cũng là một gã ăn không ngồi rồi,
Dialogue: 0,0:08:12.41,0:08:14.70,Default,,0,0,0,,chẳng khác gì ông bố của cậu ta.
Dialogue: 0,0:08:15.29,0:08:16.83,Default,,0,0,0,,Vợ cậu ta cũng đã bỏ đi.
Dialogue: 0,0:08:17.41,0:08:20.87,Default,,0,0,0,,Đã ngoài bốn mươi tuổi đầu mà vẫn thất nghiệp ăn bám.
Dialogue: 0,0:08:23.88,0:08:25.42,Default,,0,0,0,,Cô về rồi đây.
Dialogue: 0,0:08:25.96,0:08:26.96,Default,,0,0,0,,Teppei,
Dialogue: 0,0:08:27.59,0:08:29.01,Default,,0,0,0,,cháu đã ăn tối chưa?
Dialogue: 0,0:08:39.89,0:08:42.35,Default,,0,0,0,,Sao bừa bộn thế này hả trời!
Dialogue: 0,0:08:47.82,0:08:48.78,Default,,0,0,0,,Cô im đi.
Dialogue: 0,0:08:54.53,0:08:57.16,Default,,0,0,0,,Cháu sống bê bối quá đấy.
Dialogue: 0,0:09:09.09,0:09:10.47,Default,,0,0,0,,Này Nguyễn, lại đây một tay nào.
Dialogue: 0,0:09:11.72,0:09:12.76,Default,,0,0,0,,Đỡ lấy đầu bên kia đi.
Dialogue: 0,0:09:14.76,0:09:15.72,Default,,0,0,0,,Xong chưa?
Dialogue: 0,0:09:16.35,0:09:17.81,Default,,0,0,0,,Nắm chặt bốn góc tấm ga nhé.
Dialogue: 0,0:09:19.23,0:09:20.15,Default,,0,0,0,,Rồi.
Dialogue: 0,0:09:36.87,0:09:37.79,Default,,0,0,0,,Của hai cô cháu đây.
Dialogue: 0,0:09:45.71,0:09:47.50,Default,,0,0,0,,Cháu thấy sao? Ngon lắm phải không?
Dialogue: 0,0:09:49.80,0:09:53.51,Default,,0,0,0,,Cô cứ muốn dẫn cháu đi ăn\Nmón lẩu một người này từ lâu rồi.
Dialogue: 0,0:09:55.51,0:09:57.47,Default,,0,0,0,,Nhưng hai cô cháu mình ngồi ăn chung thế này
Dialogue: 0,0:09:57.93,0:09:59.77,Default,,0,0,0,,thì đâu còn gọi là "lẩu một người" nữa.
Dialogue: 0,0:10:01.43,0:10:02.26,Default,,0,0,0,,Okae.
Dialogue: 0,0:10:02.60,0:10:04.35,Default,,0,0,0,,- Bà uống một ly nhé?\N- Xin lỗi ông nhé.
Dialogue: 0,0:10:04.44,0:10:06.19,Default,,0,0,0,,Tôi phải quay lại chỗ làm ngay bây giờ.
Dialogue: 0,0:10:06.77,0:10:08.40,Default,,0,0,0,,Cậu nhân viên làm thêm nghỉ việc luôn rồi.
Dialogue: 0,0:10:09.61,0:10:12.45,Default,,0,0,0,,Đám thanh niên thời nay chẳng biết\Nchịu thương chịu khó là gì cả.
Dialogue: 0,0:10:13.11,0:10:16.16,Default,,0,0,0,,Sao bà không bảo\Ncậu cháu trai quý hóa ra phụ một tay?
Dialogue: 0,0:10:16.62,0:10:18.96,Default,,0,0,0,,- Ông chủ cũng thấy phải không?\N- Ông bớt nói nhảm đi.
Dialogue: 0,0:10:20.75,0:10:21.79,Default,,0,0,0,,Cháu lại đi đâu đấy?
Dialogue: 0,0:10:22.41,0:10:24.08,Default,,0,0,0,,Cháu ăn xong rồi, cô đừng có cằn nhằn nữa.
Dialogue: 0,0:10:24.46,0:10:25.75,Default,,0,0,0,,Cho cháu mượn ít tiền đi.
Dialogue: 0,0:10:26.75,0:10:28.42,Default,,0,0,0,,Lại định đi nhậu nhẹt nữa hả?
Dialogue: 0,0:10:28.88,0:10:31.47,Default,,0,0,0,,Mới hôm trước cô vừa đưa tiền cho cháu rồi mà.
Dialogue: 0,0:10:32.13,0:10:32.96,Default,,0,0,0,,Thôi khỏi.
Dialogue: 0,0:10:33.42,0:10:34.30,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:10:34.80,0:10:36.72,Default,,0,0,0,,Thiệt tình, hết cách với cháu luôn.
Dialogue: 0,0:10:41.39,0:10:43.93,Default,,0,0,0,,Cậu không có công ăn việc làm gì à?
Dialogue: 0,0:10:45.44,0:10:47.03,Default,,0,0,0,,Thất nghiệp ăn bám mà suốt ngày chỉ biết đi nhậu nhẹt?
Dialogue: 0,0:10:47.48,0:10:49.15,Default,,0,0,0,,Cậu không biết thương cô mình mà đỡ đần cho bà ấy một chút sao?
Dialogue: 0,0:10:49.57,0:10:51.28,Default,,0,0,0,,Này ông già, im cái miệng đi.
Dialogue: 0,0:10:51.36,0:10:53.95,Default,,0,0,0,,Chuyện của tôi không mượn ông lo.
Dialogue: 0,0:10:58.45,0:11:00.12,Default,,0,0,0,,Ông làm cái trò gì thế hả?
Dialogue: 0,0:11:00.20,0:11:03.95,Default,,0,0,0,,Nó đang chật vật tìm hướng đi tiếp\Ncho cuộc đời mình.
Dialogue: 0,0:11:04.04,0:11:05.67,Default,,0,0,0,,Đi uống một ly giải sầu thì đã làm sao?
Dialogue: 0,0:11:06.12,0:11:08.16,Default,,0,0,0,,Ông lo chuyện bao đồng vừa thôi.
Dialogue: 0,0:11:08.54,0:11:09.79,Default,,0,0,0,,Ông chủ, tính tiền cho tôi.
Dialogue: 0,0:11:11.25,0:11:12.50,Default,,0,0,0,,Của bà hết một ngàn hai trăm yên.
Dialogue: 0,0:11:16.13,0:11:17.09,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:11:23.60,0:11:26.40,Default,,0,0,0,,Lẽ nào tôi không nên nói lời nào thì hơn?
Dialogue: 0,0:11:29.15,0:11:30.78,Default,,0,0,0,,Bác là bạn thanh mai trúc mã của bà ấy mà.
Dialogue: 0,0:11:31.82,0:11:33.86,Default,,0,0,0,,Bác có nói thế cũng là lẽ thường tình thôi.
Dialogue: 0,0:11:35.24,0:11:36.41,Default,,0,0,0,,Tình đầu...
Dialogue: 0,0:11:36.82,0:11:38.24,Default,,0,0,0,,chẳng bao giờ trọn vẹn cả.
Dialogue: 0,0:11:38.95,0:11:41.20,Default,,0,0,0,,Đúng không Ông chủ?
Dialogue: 0,0:11:44.41,0:11:47.45,Default,,0,0,0,,Đợi cô với, Teppei. Nhìn xem này.
Dialogue: 0,0:11:48.17,0:11:50.71,Default,,0,0,0,,Cô đã khoanh tròn mấy chỗ tuyển dụng tốt rồi đấy.
Dialogue: 0,0:11:51.67,0:11:52.59,Default,,0,0,0,,Cháu xem đi.
Dialogue: 0,0:11:55.30,0:11:56.34,Default,,0,0,0,,Cô ơi,
Dialogue: 0,0:11:56.80,0:12:00.35,Default,,0,0,0,,cô nghĩ một gã từng tuyên bố phá sản như cháu\Nlại có thể xin được một công việc tử tế sao?
Dialogue: 0,0:12:00.89,0:12:04.39,Default,,0,0,0,,Chỉ cần cháu đừng đòi hỏi cao quá\Nthì thiếu gì việc để làm.
Dialogue: 0,0:12:04.47,0:12:07.18,Default,,0,0,0,,Hay là làm theo lời ông Chu nói hôm nọ cũng được đấy.\NChỗ khách sạn tình nhân cô đang làm.
Dialogue: 0,0:12:07.27,0:12:09.44,Default,,0,0,0,,Để cô hỏi xin quản lý giúp cháu nhé.
Dialogue: 0,0:12:09.52,0:12:10.44,Default,,0,0,0,,Thôi đi cô ơi.
Dialogue: 0,0:12:10.81,0:12:12.40,Default,,0,0,0,,Cháu vẫn còn trẻ chán.
Dialogue: 0,0:12:12.86,0:12:15.57,Default,,0,0,0,,Cháu đâu có giống như cô,\Ncháu chưa thể buông xuôi tương lai của mình được.
Dialogue: 0,0:12:20.11,0:12:22.99,Default,,0,0,0,,Thế... rốt cuộc cháu muốn làm cái gì?
Dialogue: 0,0:12:26.00,0:12:27.08,Default,,0,0,0,,Ngày xưa cô cũng từng giống hệt cháu.
Dialogue: 0,0:12:27.37,0:12:28.58,Default,,0,0,0,,Hồi còn trẻ,
Dialogue: 0,0:12:29.04,0:12:32.46,Default,,0,0,0,,cô cũng từng mải miết chạy theo những thứ hào nhoáng.
Dialogue: 0,0:12:33.38,0:12:35.80,Default,,0,0,0,,Một cuộc sống xa hoa khiến ai nhìn vào cũng phải ghen tị.
Dialogue: 0,0:12:37.17,0:12:38.13,Default,,0,0,0,,Thế nhưng...
Dialogue: 0,0:12:39.05,0:12:41.47,Default,,0,0,0,,đến lúc ngỡ như đã chạm tay được vào nó,
Dialogue: 0,0:12:42.14,0:12:44.43,Default,,0,0,0,,thì nhìn lại trong tay chỉ toàn là hư không.
Dialogue: 0,0:12:50.48,0:12:54.03,Default,,0,0,0,,Cô biết con người ta phải tự mình vấp ngã\Nthì mới khôn ra được.
Dialogue: 0,0:12:56.69,0:12:57.82,Default,,0,0,0,,Cháu đi uống giải khuây đi nhé?
Dialogue: 0,0:13:00.91,0:13:02.20,Default,,0,0,0,,Nhớ về nhà cẩn thận đấy.
Dialogue: 0,0:13:24.60,0:13:25.68,Default,,0,0,0,,Teppei?
Dialogue: 0,0:13:26.56,0:13:27.85,Default,,0,0,0,,Dậy đi cháu.
Dialogue: 0,0:13:28.56,0:13:30.23,Default,,0,0,0,,Về chuyện công việc hôm trước,
Dialogue: 0,0:13:30.94,0:13:32.65,Default,,0,0,0,,quản lý chỗ cô bảo muốn phỏng vấn...
Dialogue: 0,0:13:54.71,0:13:55.67,Default,,0,0,0,,Này bác Chu.
Dialogue: 0,0:13:56.21,0:13:58.30,Default,,0,0,0,,Bác lại thua cá ngựa nữa rồi hả?
Dialogue: 0,0:13:58.38,0:13:59.59,Default,,0,0,0,,Không phải.
Dialogue: 0,0:14:01.13,0:14:02.80,Default,,0,0,0,,Cậu còn nhớ thằng cháu trai của bà Kae không?
Dialogue: 0,0:14:03.76,0:14:06.14,Default,,0,0,0,,Nó cuỗm sạch sành sanh mọi thứ,\Ntừ thẻ tín dụng,
Dialogue: 0,0:14:06.22,0:14:09.10,Default,,0,0,0,,thẻ ATM cho tới tiền mặt của cổ rồi cao chạy xa bay rồi.
Dialogue: 0,0:14:10.47,0:14:12.76,Default,,0,0,0,,Đúng là Okae không nên chiều hư thằng đó mới phải.
Dialogue: 0,0:14:13.35,0:14:14.98,Default,,0,0,0,,Nhưng dù sao thì...
Dialogue: 0,0:14:22.86,0:14:24.36,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:14:24.70,0:14:25.66,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:14:26.74,0:14:29.16,Default,,0,0,0,,Cho tôi một bình sake hâm nóng và một phần lẩu nhé.
Dialogue: 0,0:14:29.54,0:14:32.08,Default,,0,0,0,,Chị Kae, hôm nay có chuyện gì vui sao?
Dialogue: 0,0:14:36.08,0:14:37.12,Default,,0,0,0,,Mọi người nhìn xem này.
Dialogue: 0,0:14:37.88,0:14:38.96,Default,,0,0,0,,Có đẹp không?
Dialogue: 0,0:14:40.46,0:14:43.63,Default,,0,0,0,,Thằng Teppei gửi về cho tôi đấy,
Dialogue: 0,0:14:44.09,0:14:45.93,Default,,0,0,0,,nó bảo là quà sinh nhật tặng cô.
Dialogue: 0,0:14:46.93,0:14:48.18,Default,,0,0,0,,Chiếc trâm hợp với chị lắm.
Dialogue: 0,0:14:48.26,0:14:49.51,Default,,0,0,0,,Đúng không nào?
Dialogue: 0,0:14:49.60,0:14:51.94,Default,,0,0,0,,Tôi đã bảo rồi mà.\NMột giọt máu đào hơn ao nước lã.
Dialogue: 0,0:14:53.18,0:14:55.68,Default,,0,0,0,,Thế chị đã lấy lại được số tiền bị mất chưa?
Dialogue: 0,0:14:56.56,0:14:59.61,Default,,0,0,0,,Tôi chẳng bận tâm chuyện tiền nong đó nữa đâu.
Dialogue: 0,0:15:11.49,0:15:12.45,Default,,0,0,0,,Okae,
Dialogue: 0,0:15:13.20,0:15:14.79,Default,,0,0,0,,bà làm tôi thất vọng quá đấy.
Dialogue: 0,0:15:15.66,0:15:16.62,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:15:17.08,0:15:18.79,Default,,0,0,0,,Chỉ một món quà cỏn con thế này mà đã làm bà mờ mắt rồi.
Dialogue: 0,0:15:19.46,0:15:22.09,Default,,0,0,0,,Tôi dám cá là nó dùng chính tiền ăn cắp của bà để mua đấy.
Dialogue: 0,0:15:23.26,0:15:24.89,Default,,0,0,0,,Tôi đã bảo ông rồi,
Dialogue: 0,0:15:24.97,0:15:27.56,Default,,0,0,0,,vấn đề không nằm ở chuyện tiền bạc.
Dialogue: 0,0:15:27.64,0:15:29.27,Default,,0,0,0,,Bà bị làm sao thế hả?
Dialogue: 0,0:15:29.97,0:15:31.14,Default,,0,0,0,,Tỉnh mộng lại đi!
Dialogue: 0,0:15:31.97,0:15:33.31,Default,,0,0,0,,Hồi còn trẻ,
Dialogue: 0,0:15:33.72,0:15:35.81,Default,,0,0,0,,bà vừa xinh đẹp lại vừa kiêu hãnh, tự lập.
Dialogue: 0,0:15:36.23,0:15:38.15,Default,,0,0,0,,Bà từng là một người phụ nữ tuyệt vời biết bao.
Dialogue: 0,0:15:39.02,0:15:42.94,Default,,0,0,0,,Ý ông muốn nói\Nbây giờ tôi trông thảm hại và đáng xấu hổ lắm chứ gì?
Dialogue: 0,0:15:43.03,0:15:44.32,Default,,0,0,0,,Phải, trông bà bây giờ đáng xấu hổ lắm.
Dialogue: 0,0:15:45.03,0:15:47.24,Default,,0,0,0,,Nó là người thân duy nhất của bà ư?\NThế thì đã sao nào?
Dialogue: 0,0:15:47.32,0:15:48.66,Default,,0,0,0,,Bà đang mù quáng quá rồi đấy.
Dialogue: 0,0:15:49.82,0:15:51.41,Default,,0,0,0,,Ông thì biết cái gì chứ.
Dialogue: 0,0:15:51.99,0:15:55.04,Default,,0,0,0,,Từ ngày dọn về sống chung với thằng Teppei,\Nlần đầu tiên trong đời tôi mới cảm nhận được
Dialogue: 0,0:15:55.62,0:15:59.00,Default,,0,0,0,,niềm vui khi được lao động vất vả\Nvì một người khác.
Dialogue: 0,0:15:59.46,0:16:00.96,Default,,0,0,0,,Có khi tôi còn phải cảm ơn nó ấy chứ.
Dialogue: 0,0:16:01.54,0:16:03.75,Default,,0,0,0,,Okae, bà nói thật đấy à?
Dialogue: 0,0:16:04.96,0:16:07.17,Default,,0,0,0,,Tôi nói thật. Hoàn toàn thật lòng.
Dialogue: 0,0:16:09.09,0:16:11.05,Default,,0,0,0,,Ông lấy tư cách gì mà phán xét tôi chứ?
Dialogue: 0,0:16:11.72,0:16:13.14,Default,,0,0,0,,Bản thân ông cũng có gia đình vợ con gì đâu.
Dialogue: 0,0:16:13.72,0:16:16.22,Default,,0,0,0,,Đêm nào cũng ngồi uống rượu say khướt một mình.
Dialogue: 0,0:16:16.64,0:16:19.27,Default,,0,0,0,,Trông ông còn thảm hại và đáng xấu hổ hơn tôi gấp trăm lần.
Dialogue: 0,0:16:27.95,0:16:29.12,Default,,0,0,0,,Của bà đây.
Dialogue: 0,0:16:30.24,0:16:31.16,Default,,0,0,0,,Chúc bà ngon miệng.
Dialogue: 0,0:16:47.80,0:16:48.80,Default,,0,0,0,,Cho tôi xin lỗi nhé.
Dialogue: 0,0:16:49.68,0:16:50.72,Default,,0,0,0,,Tôi nặng lời quá.
Dialogue: 0,0:16:57.81,0:16:58.98,Default,,0,0,0,,Ông ăn chung một miếng đi.
Dialogue: 0,0:16:59.89,0:17:00.98,Default,,0,0,0,,Thôi, tôi xin kiếu.
Dialogue: 0,0:17:03.52,0:17:05.48,Default,,0,0,0,,Bảo ăn thì cứ ăn đi.
Dialogue: 0,0:17:21.96,0:17:23.42,Default,,0,0,0,,Thế nào, ngon đúng không?
Dialogue: 0,0:17:32.22,0:17:34.93,Default,,0,0,0,,Lát nữa ăn xong, tôi có thể lấy nước dùng này\Nnấu cháo trứng cho hai người nhé.
Dialogue: 0,0:17:36.31,0:17:37.31,Default,,0,0,0,,Ý kiến hay đấy!
Dialogue: 0,0:17:50.99,0:17:51.95,Default,,0,0,0,,Alo?
Dialogue: 0,0:17:55.70,0:17:56.53,Default,,0,0,0,,Vâng.
Dialogue: 0,0:18:05.33,0:18:06.33,Default,,0,0,0,,Tôi hiểu rồi ạ.
Dialogue: 0,0:18:10.09,0:18:11.72,Default,,0,0,0,,Thằng Teppei bị cảnh sát bắt rồi.
Dialogue: 0,0:18:26.19,0:18:27.82,Default,,0,0,0,,Cháu trai của bà Kae bị khởi tố
Dialogue: 0,0:18:28.27,0:18:30.69,Default,,0,0,0,,với hàng loạt tội danh,\Nbao gồm trộm cắp tài sản,
Dialogue: 0,0:18:31.19,0:18:32.78,Default,,0,0,0,,lừa đảo vay tín dụng nhỏ lẻ,
Dialogue: 0,0:18:33.36,0:18:35.32,Default,,0,0,0,,và nhiều tội khác nữa.
Dialogue: 0,0:18:35.86,0:18:37.45,Default,,0,0,0,,Cậu ta bị tuyên án tù giam.
Dialogue: 0,0:18:37.95,0:18:41.58,Default,,0,0,0,,Tôi nghe nói giờ đây\Nbà Kae vẫn thường xuyên vào tù thăm nuôi cậu ta.
Dialogue: 0,0:18:46.79,0:18:50.21,Default,,0,0,0,,Thấm thoắt đã khoảng sáu tháng trôi qua\Nkể từ dạo ấy.
Dialogue: 0,0:18:55.88,0:18:58.55,Default,,0,0,0,,- Chào buổi tối.\N- Xin mời vào.
Dialogue: 0,0:18:59.35,0:19:00.73,Default,,0,0,0,,Con ngồi vào ghế kia đi.
Dialogue: 0,0:19:01.47,0:19:04.43,Default,,0,0,0,,Ông chủ, thằng bé thích ăn gì anh cứ làm cho nó nhé.
Dialogue: 0,0:19:04.94,0:19:06.57,Default,,0,0,0,,Chị Kae, cậu bé nào thế này?
Dialogue: 0,0:19:07.06,0:19:09.98,Default,,0,0,0,,Đây là con trai của thằng Teppei.\NCháu nó tên là Shohei.
Dialogue: 0,0:19:11.78,0:19:15.12,Default,,0,0,0,,Tôi không ngờ\Nthằng Teppei lại có đứa con trai lớn tướng thế này rồi đấy.
Dialogue: 0,0:19:15.82,0:19:19.53,Default,,0,0,0,,Từ ngày mẹ cháu đi bước nữa,\Nthằng bé chẳng còn chốn nào nương tựa.
Dialogue: 0,0:19:19.99,0:19:22.20,Default,,0,0,0,,Thế nên tôi đã nhận quyền nuôi dưỡng cháu.
Dialogue: 0,0:19:22.83,0:19:23.83,Default,,0,0,0,,Trời đất,
Dialogue: 0,0:19:24.33,0:19:26.12,Default,,0,0,0,,lại tự rước thêm cục nợ vào người hả?
Dialogue: 0,0:19:27.17,0:19:28.75,Default,,0,0,0,,Cháu thích ăn món gì nào?
Dialogue: 0,0:19:29.63,0:19:30.46,Default,,0,0,0,,Thịt ạ!
Dialogue: 0,0:19:32.25,0:19:34.71,Default,,0,0,0,,- Thế còn bà Kae? Vẫn lẩu một người nhé?\N- Tôi không ăn đâu.
Dialogue: 0,0:19:35.09,0:19:37.30,Default,,0,0,0,,Tối qua hai bà cháu tôi\Nvừa nấu lẩu ăn chung ở nhà rồi.
Dialogue: 0,0:19:39.60,0:19:40.68,Default,,0,0,0,,À khoan. Cho tôi một bình sake ấm nhé.
Dialogue: 0,0:19:41.51,0:19:42.43,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:19:53.61,0:19:56.28,Default,,0,0,0,,Của cháu đây.\NMột đĩa đầy ắp thịt đặc biệt nhé.
Dialogue: 0,0:19:58.99,0:20:00.99,Default,,0,0,0,,- Cháu xin phép ăn ạ.\N- Ừ, con ăn đi.
Dialogue: 0,0:20:06.08,0:20:07.04,Default,,0,0,0,,Này.
Dialogue: 0,0:20:07.33,0:20:10.21,Default,,0,0,0,,Nhớ phải nhai cho thật kỹ đấy nhé.
Dialogue: 0,0:20:15.63,0:20:18.05,Default,,0,0,0,,- Ông chủ, cho thằng bé một ly nước trái cây nhé.\N- Được thôi.
Dialogue: 0,0:20:24.56,0:20:26.02,Default,,0,0,0,,Chưa bao giờ tôi ngờ rằng...
Dialogue: 0,0:20:27.10,0:20:28.31,Default,,0,0,0,,ở cái tuổi xế chiều này...
Dialogue: 0,0:20:28.94,0:20:31.82,Default,,0,0,0,,mình lại có cơ hội được nuôi dạy một đứa trẻ.
Dialogue: 0,0:20:45.16,0:20:46.29,Default,,0,0,0,,Okae...
Dialogue: 0,0:20:47.04,0:20:49.33,Default,,0,0,0,,dù là con gái của chủ tiệm giày,
Dialogue: 0,0:20:49.83,0:20:52.21,Default,,0,0,0,,nhưng chưa bao giờ cổ chịu cúi nhìn xuống đôi chân mình,\Nnhìn vào thực tại ngay trước mắt.
Dialogue: 0,0:20:54.25,0:20:56.00,Default,,0,0,0,,Tôi đoán là...
Dialogue: 0,0:20:56.92,0:21:00.05,Default,,0,0,0,,cổ luôn khao khát được ngắm nhìn những chân trời khác.
Dialogue: 0,0:21:02.97,0:21:04.05,Default,,0,0,0,,Ông nói đúng đấy.
Dialogue: 0,0:21:06.18,0:21:07.81,Default,,0,0,0,,Đó chính là điều cô ấy hằng mong ước.
Dialogue: 0,0:21:09.73,0:21:12.98,Default,,0,0,0,,Đêm nay, trông cô ấy còn rạng rỡ và đẹp hơn
Dialogue: 0,0:21:13.48,0:21:14.77,Default,,0,0,0,,cả thời thiếu nữ ngày xưa.
Dialogue: 0,0:21:18.28,0:21:19.20,Default,,0,0,0,,Bác Chu này,
Dialogue: 0,0:21:20.32,0:21:21.95,Default,,0,0,0,,bình rượu này tôi mời bác nhé.
Dialogue: 0,0:21:26.58,0:21:27.54,Default,,0,0,0,,Ông chủ nói thật hả?
Dialogue: 0,0:22:01.03,0:22:02.91,Default,,0,0,0,,Cuộc đời này vốn dĩ chẳng hề dễ dàng,
Dialogue: 0,0:22:03.49,0:22:06.08,Default,,0,0,0,,dù ta sống một mình\Nhay có một ai đó kề bên.
Dialogue: 0,0:22:10.41,0:22:11.37,Default,,0,0,0,,Ngon thật đấy.
Dialogue: 0,0:22:11.75,0:22:13.29,Default,,0,0,0,,Trong một chiếc nồi đất nhỏ cho một người ăn,
Dialogue: 0,0:22:13.71,0:22:15.75,Default,,0,0,0,,chỉ cần ninh cải thảo,
Dialogue: 0,0:22:15.83,0:22:18.33,Default,,0,0,0,,thịt heo và nấm kim châm\Ntrong nước dùng cá bào.
Dialogue: 0,0:22:18.75,0:22:20.29,Default,,0,0,0,,Chỉ đơn giản có vậy thôi.
Dialogue: 0,0:22:21.72,0:22:23.76,Default,,0,0,0,,Đơn giản bao giờ cũng là tuyệt nhất.
Dialogue: 0,0:22:26.01,0:22:28.22,Default,,0,0,0,,Trông ngon mắt quá đi mất.
Dialogue: 0,0:22:29.85,0:22:30.81,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:22:32.14,0:22:33.35,Default,,0,0,0,,Khoan đã nào, chị Kae.
Dialogue: 0,0:22:34.23,0:22:35.86,Default,,0,0,0,,Đừng quên vắt chanh bushukan nhé.
Dialogue: 0,0:22:36.90,0:22:39.61,Default,,0,0,0,,Thiếu cái đó là mất ngon đấy.
Dialogue: 0,0:22:41.15,0:22:43.94,Default,,0,0,0,,Bushukan là một giống chanh thơm đặc sản vùng Tosa.
Dialogue: 0,0:22:44.40,0:22:47.82,Default,,0,0,0,,Nước cốt của nó hợp với món lẩu của quán tôi\Nđến hoàn hảo.
Dialogue: 0,0:22:49.20,0:22:50.62,Default,,0,0,0,,Cháu nhớ ăn thật nhiều vào nhé.
Dialogue: 0,0:22:56.71,0:22:59.42,Default,,0,0,0,,- Ngon tuyệt cú mèo luôn ạ.\N- Ngon đúng không nào?
Dialogue: 0,0:23:49.14,0:23:53.94,Default,,0,0,0,,CÂU CHUYỆN NÀY LÀ HƯ CẤU
