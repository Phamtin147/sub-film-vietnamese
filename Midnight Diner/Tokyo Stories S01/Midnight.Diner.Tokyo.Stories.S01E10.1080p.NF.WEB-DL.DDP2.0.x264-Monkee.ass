Dialogue: 0,0:01:10.49,0:01:11.91,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:12.49,0:01:14.91,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:15.70,0:01:17.49,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:41.52,0:01:44.11,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:44.19,0:01:45.48,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:47.11,0:01:50.11,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:52.20,0:01:53.83,Default,,0,0,0,,PHẦN SÚP MISO THỊT HEO,\NBIA, RƯỢU SAKE, SHOCHU
Dialogue: 0,0:01:53.91,0:01:55.37,Default,,0,0,0,,Thực đơn của tôi chỉ có vỏn vẹn từng ấy món.
Dialogue: 0,0:01:55.87,0:01:58.87,Default,,0,0,0,,Nhưng hễ khách gọi món gì,
Dialogue: 0,0:01:58.95,0:02:01.16,Default,,0,0,0,,chỉ cần có sẵn nguyên liệu là tôi đều sẽ làm.
Dialogue: 0,0:02:01.25,0:02:02.92,Default,,0,0,0,,Phương châm của tôi là vậy.
Dialogue: 0,0:02:07.92,0:02:09.17,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:02:09.80,0:02:11.47,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:02:14.51,0:02:18.14,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NNHỮNG CÂU CHUYỆN TOKYO
Dialogue: 0,0:02:18.22,0:02:21.85,Default,,0,0,0,,LẠI ĐẾN MÌ SOBA ĐÊM GIAO THỪA
Dialogue: 0,0:02:28.06,0:02:30.19,Default,,0,0,0,,Thoắt cái mà một năm đã trôi qua.
Dialogue: 0,0:02:30.65,0:02:33.32,Default,,0,0,0,,Lại thêm một đêm Giao thừa nữa gõ cửa rồi.
Dialogue: 0,0:02:36.95,0:02:40.91,Default,,0,0,0,,Cuộc đời mà sáu phần thắng, bốn phần bại,\Nthì âu cũng là một đời viên mãn.
Dialogue: 0,0:02:40.99,0:02:42.70,Default,,0,0,0,,Có bậc hiền triết nào đó từng nói vậy.
Dialogue: 0,0:02:43.29,0:02:44.33,Default,,0,0,0,,Vui vẻ lên nào.
Dialogue: 0,0:02:46.33,0:02:48.00,Default,,0,0,0,,Đừng có ủ rũ rầu rĩ như thế nữa.
Dialogue: 0,0:02:48.08,0:02:50.17,Default,,0,0,0,,Trông cậu làm tôi thấy lạnh cả người đấy.
Dialogue: 0,0:02:51.25,0:02:53.29,Default,,0,0,0,,Cái ví tiền rỗng tuếch mới làm tôi thấy lạnh buốt này.
Dialogue: 0,0:02:54.67,0:02:56.63,Default,,0,0,0,,Đời có ngày nắng thì cũng có ngày mưa chứ.
Dialogue: 0,0:02:57.05,0:02:58.93,Default,,0,0,0,,Cứ như đang trôi dạt giữa sa mạc ấy.
Dialogue: 0,0:02:59.35,0:03:02.52,Default,,0,0,0,,Sau chuỗi ngày xui rủi rồi sẽ đến ngày may mắn.
Dialogue: 0,0:03:02.60,0:03:04.69,Default,,0,0,0,,Đó là quy luật của vũ trụ rồi.
Dialogue: 0,0:03:08.02,0:03:10.23,Default,,0,0,0,,Hồi mùa xuân, thần đua ngựa
Dialogue: 0,0:03:11.02,0:03:12.86,Default,,0,0,0,,đã mang lại cho tôi cả một cơ hội đổi đời
Dialogue: 0,0:03:13.48,0:03:15.94,Default,,0,0,0,,cùng với mùa hoa anh đào nở.
Dialogue: 0,0:03:17.49,0:03:18.66,Default,,0,0,0,,Thế rồi mùa đông ùa tới.
Dialogue: 0,0:03:19.53,0:03:21.91,Default,,0,0,0,,Vận may của tôi tan biến theo từng bông tuyết rơi.
Dialogue: 0,0:03:23.95,0:03:25.95,Default,,0,0,0,,Dù sao thì cậu cũng có khiếu cờ bạc đâu.
Dialogue: 0,0:03:27.00,0:03:28.59,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:03:29.21,0:03:31.50,Default,,0,0,0,,Nghe này,\Nít nhất cậu cũng đã có một giấc mơ đẹp rồi còn gì.
Dialogue: 0,0:03:32.50,0:03:34.63,Default,,0,0,0,,Nhưng giấc mơ đó làm phiền Ông chủ không ít đâu.
Dialogue: 0,0:03:35.22,0:03:36.05,Default,,0,0,0,,Sao cơ ạ?
Dialogue: 0,0:03:39.34,0:03:44.18,Default,,0,0,0,,Được rồi. Tốt lắm. Cứ tiến lên nào.
Dialogue: 0,0:03:45.23,0:03:46.48,Default,,0,0,0,,Này, cẩn thận chút chứ.
Dialogue: 0,0:03:46.56,0:03:49.94,Default,,0,0,0,,Chuyện đó cứ như một giấc mộng ngọt ngào\Ngiữa ngày xuân ấm áp vậy.
Dialogue: 0,0:03:50.19,0:03:51.44,Default,,0,0,0,,Đặt ở đây là được rồi.
Dialogue: 0,0:03:55.15,0:03:57.86,Default,,0,0,0,,- Xong xuôi rồi nhé.\N- Mời vào, mời vào.
Dialogue: 0,0:03:59.28,0:04:00.49,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:04:01.62,0:04:04.12,Default,,0,0,0,,Ông chủ ơi, tôi làm được rồi!
Dialogue: 0,0:04:04.70,0:04:06.49,Default,,0,0,0,,Một triệu... Một triệu yên lận đấy...
Dialogue: 0,0:04:06.58,0:04:08.33,Default,,0,0,0,,Cậu làm tôi thất vọng quá đấy, Komichi.
Dialogue: 0,0:04:08.96,0:04:12.71,Default,,0,0,0,,- Cậu ăn trộm tiền à? Tận một triệu cơ đấy?\N- Một triệu yên thật đấy!
Dialogue: 0,0:04:12.79,0:04:16.25,Default,,0,0,0,,Anh ấy cược vào con ngựa ô ít ai ngờ tới\Nở giải Cúp Hoàng Đế đấy.
Dialogue: 0,0:04:23.85,0:04:26.14,Default,,0,0,0,,Ban đầu tôi định cược\Nvào con ngựa hạt giống cơ,
Dialogue: 0,0:04:26.22,0:04:28.26,Default,,0,0,0,,nhưng tay run thế nào lại bấm nhầm sang con ngựa ô kia.
Dialogue: 0,0:04:29.02,0:04:33.02,Default,,0,0,0,,Vừa vào đầu cuộc đua,\Ncon ngựa dẫn đầu bỗng ngã nhào,
Dialogue: 0,0:04:33.11,0:04:35.90,Default,,0,0,0,,tạo nên một mớ hỗn loạn.\NThế là con ngựa ô sống sót và về đích đầu tiên!
Dialogue: 0,0:04:37.24,0:04:41.08,Default,,0,0,0,,- Tôi sợ cái vận may từ trên trời rơi xuống này quá.\N- Chúc mừng anh nhé!
Dialogue: 0,0:04:41.16,0:04:43.87,Default,,0,0,0,,Cầm số tiền đó muốn làm gì thì làm thôi.
Dialogue: 0,0:04:43.95,0:04:47.33,Default,,0,0,0,,Cả đời tôi chưa từng nhìn thấy hay kiếm được\Nmột khoản tiền lớn nhường này.
Dialogue: 0,0:04:47.41,0:04:48.91,Default,,0,0,0,,Tôi chẳng biết phải tiêu gì cho hết nữa.
Dialogue: 0,0:04:49.00,0:04:51.92,Default,,0,0,0,,Ít nhất thì,\Ntối nay hãy để tôi chiêu đãi mọi người một bữa no nê nhé!
Dialogue: 0,0:04:52.00,0:04:53.00,Default,,0,0,0,,Thôi khỏi đi.
Dialogue: 0,0:04:53.54,0:04:57.21,Default,,0,0,0,,- Cảm ơn lòng tốt của anh, nhưng chúng tôi phải đi rồi.\N- Sao lại thế?
Dialogue: 0,0:04:57.30,0:04:59.72,Default,,0,0,0,,Tụi mình hộ tống anh ấy tới đây mà.\NĂn một bữa bằng tiền của anh ấy đi.
Dialogue: 0,0:04:59.80,0:05:01.89,Default,,0,0,0,,- Cô ấy nói chuẩn đấy.\N- Không đúng chuẩn mực đâu.
Dialogue: 0,0:05:02.43,0:05:05.02,Default,,0,0,0,,Chúng tôi là thám tử,\Nlà công chức nhà nước đấy.
Dialogue: 0,0:05:05.10,0:05:08.81,Default,,0,0,0,,- Đây là tấm lòng bạn bè với nhau thôi mà, đúng không?\N- Đương nhiên rồi, tình bạn là trên hết chứ!
Dialogue: 0,0:05:09.98,0:05:10.94,Default,,0,0,0,,Chuyện này...
Dialogue: 0,0:05:11.23,0:05:12.86,Default,,0,0,0,,Hoàn toàn vô tư mà.
Dialogue: 0,0:05:12.94,0:05:16.90,Default,,0,0,0,,Nó dựa trên tình cảm khăng khít gắn bó,\Nmọi người quan tâm chăm sóc lẫn nhau.
Dialogue: 0,0:05:16.98,0:05:19.73,Default,,0,0,0,,- Đó là một...\N- Tình bạn tuyệt đẹp!
Dialogue: 0,0:05:20.19,0:05:21.78,Default,,0,0,0,,Nếu vậy thì các vị sẽ làm gì?
Dialogue: 0,0:05:23.45,0:05:26.04,Default,,0,0,0,,Nếu thế thì chúng tôi xin hoan hỷ nhận lời.
Dialogue: 0,0:05:27.20,0:05:28.62,Default,,0,0,0,,Coi như một phép lịch sự xã giao.
Dialogue: 0,0:05:29.70,0:05:32.91,Default,,0,0,0,,Ông chủ ơi, phục vụ mọi thứ họ muốn đi!
Dialogue: 0,0:05:33.00,0:05:35.25,Default,,0,0,0,,- Tôi muốn ăn sushi cơ.\N- Khoan đã nào.
Dialogue: 0,0:05:35.34,0:05:37.63,Default,,0,0,0,,Muốn ăn sushi\Nthì phải sang quán khác chứ.
Dialogue: 0,0:05:37.71,0:05:38.54,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:05:39.05,0:05:41.72,Default,,0,0,0,,Tôi muốn chia sẻ niềm vui này
Dialogue: 0,0:05:41.80,0:05:43.97,Default,,0,0,0,,với tất cả mọi người tại quán của ông.
Dialogue: 0,0:05:48.56,0:05:51.52,Default,,0,0,0,,Buổi tiệc mai mối tối nay chán òm như mọi khi.
Dialogue: 0,0:05:51.60,0:05:53.89,Default,,0,0,0,,Đám đàn ông mồm mép thì ra vẻ tôn trọng phụ nữ,
Dialogue: 0,0:05:53.98,0:05:57.94,Default,,0,0,0,,nhưng tận sâu trong thâm tâm\Nlại coi phụ nữ chỉ như bình hoa di động.
Dialogue: 0,0:05:58.02,0:06:00.48,Default,,0,0,0,,Đã sang thế kỷ 21 rồi\Nmọi chuyện vẫn chẳng có gì thay đổi.
Dialogue: 0,0:06:00.57,0:06:01.49,Default,,0,0,0,,Được lắm!
Dialogue: 0,0:06:02.24,0:06:03.78,Default,,0,0,0,,Bà đây quyết không lấy chồng nữa!
Dialogue: 0,0:06:05.45,0:06:07.24,Default,,0,0,0,,Cá cam Amberjack thượng hạng tới rồi đây!
Dialogue: 0,0:06:12.50,0:06:13.63,Default,,0,0,0,,Có chuyện gì rôm rả thế?
Dialogue: 0,0:06:14.08,0:06:16.83,Default,,0,0,0,,Komichi vừa trúng quả đậm đua ngựa đấy.
Dialogue: 0,0:06:16.92,0:06:18.84,Default,,0,0,0,,Nên cậu ấy khao cả quán ăn sushi tẹt ga.
Dialogue: 0,0:06:20.00,0:06:21.04,Default,,0,0,0,,Vào chung vui với bọn tôi đi!
Dialogue: 0,0:06:21.51,0:06:23.68,Default,,0,0,0,,Thật sao? Bọn em ăn ké được à?
Dialogue: 0,0:06:23.76,0:06:27.56,Default,,0,0,0,,Muốn ăn gì cứ việc gọi nhé.\NMọi người cứ ăn tự nhiên vào!
Dialogue: 0,0:06:27.64,0:06:29.77,Default,,0,0,0,,- Cho em cá ngừ béo ngậy nhé.\N- Em ăn trứng cá hồi!
Dialogue: 0,0:06:29.85,0:06:30.85,Default,,0,0,0,,Có ngay, có ngay đây!
Dialogue: 0,0:06:36.90,0:06:38.32,Default,,0,0,0,,Ông chủ ơi, cho tôi xin lỗi nhé...
Dialogue: 0,0:06:39.07,0:06:40.40,Default,,0,0,0,,vì đã làm ầm ĩ cả quán của ông.
Dialogue: 0,0:06:41.69,0:06:43.98,Default,,0,0,0,,- Chỉ ngoại lệ lần này thôi đấy nhé?\N- Tôi biết rồi mà.
Dialogue: 0,0:06:52.04,0:06:55.54,Default,,0,0,0,,Đó là sự kiện chấn động nhất\Ngiữa chúng tôi vào mùa xuân năm nay.
Dialogue: 0,0:06:58.33,0:07:01.88,Default,,0,0,0,,Đến mùa hè,\Nchúng tôi lại gặp một sự cố hiếm có.
Dialogue: 0,0:07:03.34,0:07:06.51,Default,,0,0,0,,- Món ngon nhất mùa hè chính là dưa hấu đấy.\N- Chuẩn không cần chỉnh.
Dialogue: 0,0:07:07.59,0:07:11.47,Default,,0,0,0,,Có thêm nén nhang muỗi nữa\Nthì đúng là chuẩn bài.
Dialogue: 0,0:07:12.31,0:07:13.52,Default,,0,0,0,,Tôi có nhang muỗi đây.
Dialogue: 0,0:07:16.06,0:07:17.77,Default,,0,0,0,,Cảm ơn Ông chủ đã cho mượn lọ muối nhé.
Dialogue: 0,0:07:18.81,0:07:19.77,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:07:21.32,0:07:24.49,Default,,0,0,0,,Đúng là nó rồi. Thế này mới đúng chuẩn\Nmùa hè truyền thống của Nhật Bản chứ.
Dialogue: 0,0:07:37.54,0:07:38.37,Default,,0,0,0,,Cái gì thế kia?
Dialogue: 0,0:07:39.38,0:07:42.01,Default,,0,0,0,,Đó là chuông gió phát sáng\Nnhờ sức gió sao?
Dialogue: 0,0:07:43.09,0:07:44.51,Default,,0,0,0,,Đẹp thật đấy.
Dialogue: 0,0:07:49.22,0:07:50.05,Default,,0,0,0,,Đại ca!
Dialogue: 0,0:07:50.55,0:07:52.18,Default,,0,0,0,,Bình tĩnh nào.
Dialogue: 0,0:07:52.26,0:07:53.97,Default,,0,0,0,,Chắc chập điện cục bộ thôi.
Dialogue: 0,0:07:55.31,0:07:57.27,Default,,0,0,0,,Không biết quán bar của mình có sao không nhỉ.
Dialogue: 0,0:07:57.81,0:07:59.52,Default,,0,0,0,,Không phải động đất đâu.
Dialogue: 0,0:07:59.60,0:08:01.35,Default,,0,0,0,,Chắc mất điện chút xíu là có lại thôi.
Dialogue: 0,0:08:02.32,0:08:04.91,Default,,0,0,0,,Thắp tạm nến lên\Nchúng ta cầm cự một lát vậy.
Dialogue: 0,0:08:16.58,0:08:17.66,Default,,0,0,0,,Biết nói sao nhỉ?
Dialogue: 0,0:08:18.37,0:08:21.83,Default,,0,0,0,,Cảm giác cứ như đêm kinh dị ấy nhỉ.
Dialogue: 0,0:08:22.25,0:08:25.34,Default,,0,0,0,,Đừng nói thế chứ. Em mê truyện kinh dị lắm đấy.
Dialogue: 0,0:08:26.05,0:08:29.18,Default,,0,0,0,,Có ai biết kể chuyện ma nào ghê ghê không?
Dialogue: 0,0:08:30.68,0:08:32.68,Default,,0,0,0,,Tôi chẳng biết nó có đáng sợ hay không nữa.
Dialogue: 0,0:08:33.22,0:08:35.14,Default,,0,0,0,,Nhưng chuyện này có liên quan đến quả dưa hấu đấy.
Dialogue: 0,0:08:35.22,0:08:36.26,Default,,0,0,0,,Mọi người có muốn nghe không?
Dialogue: 0,0:08:36.68,0:08:37.72,Default,,0,0,0,,Kể đi, kể đi anh!
Dialogue: 0,0:08:38.39,0:08:41.56,Default,,0,0,0,,Đây là chuyện có thật từng xảy ra với
Dialogue: 0,0:08:42.06,0:08:43.56,Default,,0,0,0,,ông nội của tôi.
Dialogue: 0,0:08:45.40,0:08:47.82,Default,,0,0,0,,Vào một đêm hè cách đây 60 năm,
Dialogue: 0,0:08:48.49,0:08:50.28,Default,,0,0,0,,cũng vào tầm giờ này,
Dialogue: 0,0:08:50.82,0:08:53.87,Default,,0,0,0,,ông nội tôi đang ngồi uống rượu\Ntại nhà một người đồng nghiệp
Dialogue: 0,0:08:53.95,0:08:55.45,Default,,0,0,0,,sống độc thân một mình.
Dialogue: 0,0:08:56.08,0:08:57.50,Default,,0,0,0,,Trời oi ả và ngột ngạt vô cùng.
Dialogue: 0,0:08:58.00,0:09:01.25,Default,,0,0,0,,Cạn sạch cả rượu lẫn mồi nhắm.\NCổ họng ai nấy khát khô cả ra.
Dialogue: 0,0:09:01.83,0:09:04.96,Default,,0,0,0,,Thế là người đồng nghiệp mới bảo:\N"Đi kiếm quả dưa hấu ăn đi."
Dialogue: 0,0:09:05.71,0:09:06.96,Default,,0,0,0,,Đi ăn trộm dưa hấu á?
Dialogue: 0,0:09:08.59,0:09:12.01,Default,,0,0,0,,Say quá rồi nên hai ông\Nlẻn thẳng vào một ruộng dưa hấu.
Dialogue: 0,0:09:12.51,0:09:15.18,Default,,0,0,0,,Mỗi người trộm lấy một quả,
Dialogue: 0,0:09:15.26,0:09:18.14,Default,,0,0,0,,rồi lần theo đường ray xe lửa\Nđể mò về nhà.
Dialogue: 0,0:09:18.52,0:09:20.56,Default,,0,0,0,,Bất ngờ họ đụng phải một bãi tha ma,
Dialogue: 0,0:09:21.10,0:09:24.44,Default,,0,0,0,,nơi mà lúc đi vào ruộng dưa\Nhai người chẳng hề nhìn thấy.
Dialogue: 0,0:09:25.15,0:09:27.82,Default,,0,0,0,,"Sao tự nhiên ở đây lại có nghĩa địa nhỉ?"
Dialogue: 0,0:09:28.28,0:09:32.58,Default,,0,0,0,,Đúng lúc hai người vừa khựng lại,\Nmột luồng sáng chói lòa bỗng từ đâu rọi tới.
Dialogue: 0,0:09:32.66,0:09:36.21,Default,,0,0,0,,Đêm muộn thế này tàu hỏa đâu có chạy nữa,\Nthế mà lại có một đoàn tàu đang lao vùn vụt tới!
Dialogue: 0,0:09:37.16,0:09:40.50,Default,,0,0,0,,Rồi sau đó, ông nội tôi tỉnh dậy\Nthấy mình nằm bên vệ đường ray.
Dialogue: 0,0:09:40.75,0:09:42.79,Default,,0,0,0,,Chắc là ông đã kịp nhảy tránh\Nkhỏi đoàn tàu trong gang tấc.
Dialogue: 0,0:09:42.87,0:09:46.71,Default,,0,0,0,,Nhưng ông không thể tìm thấy bạn mình đâu cả.\NKhông đèn đường. Xung quanh tối đen như mực.
Dialogue: 0,0:09:47.63,0:09:51.88,Default,,0,0,0,,Ông gào thét gọi tên nhưng không ai đáp lại. Ông nghĩ\Nchắc bạn mình đã bỏ về nhà trước rồi.
Dialogue: 0,0:09:51.97,0:09:55.52,Default,,0,0,0,,Thế là ông nội tôi đành ôm quả dưa\Nlủi thủi đi bộ về nhà người bạn,
Dialogue: 0,0:09:55.60,0:09:57.77,Default,,0,0,0,,quả dưa vẫn còn nguyên vẹn\Nchẳng hề sứt mẻ tí nào.
Dialogue: 0,0:09:58.56,0:10:01.73,Default,,0,0,0,,Đến khi ông mang quả dưa ra bồn rửa,\Nông mới rụng rời nhận ra rằng...
Dialogue: 0,0:10:02.18,0:10:03.43,Default,,0,0,0,,đó không phải là một quả dưa hấu,
Dialogue: 0,0:10:04.23,0:10:07.15,Default,,0,0,0,,mà là cái đầu lâu đầm đìa máu tươi\Ncủa người bạn mình!
Dialogue: 0,0:10:25.67,0:10:27.30,Default,,0,0,0,,Anh có sao không thế?
Dialogue: 0,0:10:28.04,0:10:31.04,Default,,0,0,0,,- Anh Ryu, anh có sao không?\N- Tôi được người ta tặng quả này.
Dialogue: 0,0:10:31.13,0:10:32.92,Default,,0,0,0,,Nên muốn mang qua đây chia sẻ cùng mọi người.
Dialogue: 0,0:10:33.84,0:10:34.84,Default,,0,0,0,,Anh Ryu...
Dialogue: 0,0:10:49.65,0:10:50.73,Default,,0,0,0,,Này, đại ca!
Dialogue: 0,0:10:52.40,0:10:54.24,Default,,0,0,0,,Kể từ đêm hôm đó,
Dialogue: 0,0:10:54.32,0:10:56.74,Default,,0,0,0,,anh Ryu không bao giờ dám đụng vào dưa hấu nữa.
Dialogue: 0,0:10:57.91,0:10:59.29,Default,,0,0,0,,Khổ thân anh Ryu ghê.
Dialogue: 0,0:11:04.83,0:11:07.50,Default,,0,0,0,,Mùa thu là mùa thu hoạch ấm no.
Dialogue: 0,0:11:08.04,0:11:11.17,Default,,0,0,0,,Mùa thu cũng là mùa của tình yêu đôi lứa.
Dialogue: 0,0:11:11.80,0:11:13.76,Default,,0,0,0,,Khi tiết trời se lạnh dần,
Dialogue: 0,0:11:14.30,0:11:16.14,Default,,0,0,0,,người ta lại thèm có một bóng hình kề bên.
Dialogue: 0,0:11:16.22,0:11:18.22,Default,,0,0,0,,- Của quý khách đây.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:11:18.80,0:11:19.88,Default,,0,0,0,,Thèm chảy nước miếng luôn rồi.
Dialogue: 0,0:11:20.39,0:11:21.81,Default,,0,0,0,,Tôi xin phép dùng bữa đây.
Dialogue: 0,0:11:23.10,0:11:24.81,Default,,0,0,0,,Không thể nào như thế được...
Dialogue: 0,0:11:59.09,0:12:02.30,Default,,0,0,0,,Một vụ án mạng sao? Chắc chắn là án hình sự rồi.
Dialogue: 0,0:12:02.39,0:12:05.52,Default,,0,0,0,,Cũng có thể là một tai nạn.
Dialogue: 0,0:12:05.60,0:12:07.77,Default,,0,0,0,,Hoặc là cả hai.
Dialogue: 0,0:12:07.85,0:12:10.89,Default,,0,0,0,,Tôi phải đi ngay đây.\NĐúng rồi, mình phải đến đó gấp.
Dialogue: 0,0:12:12.98,0:12:14.36,Default,,0,0,0,,Alo?
Dialogue: 0,0:12:15.65,0:12:17.82,Default,,0,0,0,,Thế rồi một mùa đông nữa lại về.
Dialogue: 0,0:12:18.24,0:12:21.91,Default,,0,0,0,,Một năm cũ sắp sửa khép lại.
Dialogue: 0,0:12:28.79,0:12:29.62,Default,,0,0,0,,Cô Kasumi.
Dialogue: 0,0:12:32.96,0:12:34.30,Default,,0,0,0,,Cô đang đi làm đấy à?
Dialogue: 0,0:12:35.05,0:12:37.39,Default,,0,0,0,,Thời điểm này trong năm bận rộn lắm đây.
Dialogue: 0,0:12:37.84,0:12:39.51,Default,,0,0,0,,Cô nhớ nắm bắt lấy cơ hội may mắn nhé.
Dialogue: 0,0:12:39.93,0:12:42.27,Default,,0,0,0,,- Chúc mừng năm mới trước nhé!\N- Bác cũng vậy nhé.
Dialogue: 0,0:12:49.52,0:12:51.36,Default,,0,0,0,,Qua mùa đông lạnh giá thì mùa xuân lại tới thôi.
Dialogue: 0,0:12:52.10,0:12:54.14,Default,,0,0,0,,Mình đâu thể xui xẻo mãi cả đời được.
Dialogue: 0,0:12:55.11,0:12:57.99,Default,,0,0,0,,Sang năm mới tôi sẽ cố gắng hết mình\Nđể rước tài rước lộc về.
Dialogue: 0,0:12:58.07,0:13:00.45,Default,,0,0,0,,Tinh thần thế là tốt đấy. Uống một ly đi nào.
Dialogue: 0,0:13:00.95,0:13:02.91,Default,,0,0,0,,Quên hết mọi chuyện thất bại đi.
Dialogue: 0,0:13:03.45,0:13:04.28,Default,,0,0,0,,Cảm ơn bác nhé.
Dialogue: 0,0:13:06.83,0:13:09.25,Default,,0,0,0,,- Chào buổi tối cả nhà.\N- Kính chào quý khách.
Dialogue: 0,0:13:10.29,0:13:13.17,Default,,0,0,0,,Tôi biết ngay mọi người sẽ tụ tập đông đủ ở đây mà.
Dialogue: 0,0:13:14.04,0:13:17.38,Default,,0,0,0,,Thảm hại thật đấy. Đêm Giao thừa rồi cơ mà.
Dialogue: 0,0:13:17.46,0:13:19.30,Default,,0,0,0,,Bộ mấy người không có chốn nào khác để đi sao?
Dialogue: 0,0:13:19.38,0:13:22.09,Default,,0,0,0,,Đúng thế đấy. Và cô cũng y chang tụi tôi thôi.
Dialogue: 0,0:13:22.47,0:13:23.68,Default,,0,0,0,,Cho mì soba đón Giao thừa nhé?
Dialogue: 0,0:13:23.76,0:13:26.14,Default,,0,0,0,,- Đương nhiên rồi.\N- Cho em một tô cỡ đại nhé!
Dialogue: 0,0:13:26.22,0:13:27.14,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:13:33.98,0:13:35.69,Default,,0,0,0,,- Xin chào.\N- Kính chào quý khách.
Dialogue: 0,0:13:35.77,0:13:37.90,Default,,0,0,0,,- Chào buổi tối.\N- Chúc buổi tối tốt lành.
Dialogue: 0,0:13:53.04,0:13:54.29,Default,,0,0,0,,Ngon tuyệt cú mèo.
Dialogue: 0,0:13:55.79,0:13:58.54,Default,,0,0,0,,Thật tuyệt khi được ăn mì soba\Ntrước khoảnh khắc năm mới sang.
Dialogue: 0,0:13:59.00,0:14:02.13,Default,,0,0,0,,Qua nửa đêm rồi thì đâu còn gọi là\N"mì đón Giao thừa" nữa chứ.
Dialogue: 0,0:14:02.22,0:14:05.18,Default,,0,0,0,,Ở một số vùng, người ta kiêng cữ rằng\Năn mì sau giao thừa sẽ rước xui xẻo vào người đấy.
Dialogue: 0,0:14:05.26,0:14:07.68,Default,,0,0,0,,Ăn mì sau khoảnh khắc giao thừa\Nsẽ rước điềm xui vào người đấy.
Dialogue: 0,0:14:08.18,0:14:10.77,Default,,0,0,0,,- Thật thế sao?\N- Em biết nhiều ghê nhỉ?
Dialogue: 0,0:14:11.23,0:14:13.44,Default,,0,0,0,,- Em tra trên Wiki cả đấy.\N- Wiki á?
Dialogue: 0,0:14:14.69,0:14:16.15,Default,,0,0,0,,Đó là loài khỉ đột nào thế?
Dialogue: 0,0:14:18.40,0:14:20.03,Default,,0,0,0,,Là bách khoa toàn thư Wikipedia ấy ạ.
Dialogue: 0,0:14:20.57,0:14:21.65,Default,,0,0,0,,Pedia á?
Dialogue: 0,0:14:22.65,0:14:25.86,Default,,0,0,0,,Nghe cái tên thôi là biết\Nchẳng dính dáng gì tới tôi rồi.
Dialogue: 0,0:14:30.24,0:14:33.16,Default,,0,0,0,,- Kính chào quý khách.\N- Chào mọi người nhé.
Dialogue: 0,0:14:34.16,0:14:35.41,Default,,0,0,0,,Hành lý gì thế kia?
Dialogue: 0,0:14:35.96,0:14:38.88,Default,,0,0,0,,Bọn em sắp bay đi Hawaii\Ntrên chuyến bay sáng sớm đấy ạ.
Dialogue: 0,0:14:39.38,0:14:41.59,Default,,0,0,0,,Đón Tết ở Hawaii cơ à?
Dialogue: 0,0:14:42.38,0:14:44.47,Default,,0,0,0,,Chị cứ nghĩ đi Saipan\Nlà đã xịn sò lắm rồi, ai ngờ...
Dialogue: 0,0:14:44.55,0:14:47.26,Default,,0,0,0,,Em muốn được sang chảnh như giới siêu sao ở Hawaii cơ.
Dialogue: 0,0:14:47.34,0:14:49.72,Default,,0,0,0,,Bọn em ghé qua đây uống một chầu\Nchờ đến giờ bay ấy mà.
Dialogue: 0,0:14:50.56,0:14:53.15,Default,,0,0,0,,- Nhưng trước hết thì...\N- Ông chủ ơi!
Dialogue: 0,0:14:53.98,0:14:55.27,Default,,0,0,0,,Cho tụi em mì soba đón Giao thừa với nhé!
Dialogue: 0,0:14:56.02,0:14:56.94,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:15:00.40,0:15:03.78,Default,,0,0,0,,Không biết tại sao người ta lại có tục lệ\Năn mì soba vào đêm Giao thừa nhỉ?
Dialogue: 0,0:15:04.49,0:15:06.83,Default,,0,0,0,,- Chiêu trò của mấy tiệm mì chăng?\N- Sợi mì kiều mạch soba
Dialogue: 0,0:15:06.91,0:15:09.41,Default,,0,0,0,,dễ cắn đứt hơn hẳn\Nso với các loại mì sợi khác.
Dialogue: 0,0:15:09.49,0:15:13.58,Default,,0,0,0,,Thế nên người ta ăn mì soba để cắt đứt\N"mọi tai ương và vận rủi của năm cũ".
Dialogue: 0,0:15:14.08,0:15:16.50,Default,,0,0,0,,Tục lệ này bắt đầu hình thành\Ntừ thời kỳ Edo đấy ạ.
Dialogue: 0,0:15:16.58,0:15:19.04,Default,,0,0,0,,- Chị biết nhiều ghê ta.\N- Toàn kiến thức trên Wikipedia cả đấy.
Dialogue: 0,0:15:20.04,0:15:23.79,Default,,0,0,0,,Nghĩa là chúng ta không nên ăn\Nmấy loại mì dai nhách như ramen sao?
Dialogue: 0,0:15:24.88,0:15:27.09,Default,,0,0,0,,Mì dai thì khó mà dứt bỏ được nhỉ?
Dialogue: 0,0:15:32.64,0:15:35.27,Default,,0,0,0,,- Anh Ryu!\N- Tụi em đã hộ tống tới nơi rồi đây.
Dialogue: 0,0:15:36.44,0:15:40.36,Default,,0,0,0,,- Chúc buổi tối tốt lành.\N- Oa, đồ ăn đón năm mới kìa!
Dialogue: 0,0:15:52.99,0:15:55.53,Default,,0,0,0,,Chị vẫn ăn chậm như rùa như mọi khi nhỉ.
Dialogue: 0,0:15:56.37,0:16:00.00,Default,,0,0,0,,Tôi mà ăn nhanh là bị ợ chua ngay.\NChắc tại tôi có tuổi rồi đấy nhỉ?
Dialogue: 0,0:16:02.54,0:16:05.00,Default,,0,0,0,,Cảm giác như cái Tết năm ngoái\Nmới chỉ là ngày hôm qua thôi.
Dialogue: 0,0:16:05.80,0:16:08.14,Default,,0,0,0,,Thoắt cái mà cả một năm đã vù qua rồi.
Dialogue: 0,0:16:08.88,0:16:11.05,Default,,0,0,0,,Cứ qua tuổi 30 là thời gian trôi nhanh như gió thoảng ấy.
Dialogue: 0,0:16:11.14,0:16:13.39,Default,,0,0,0,,- Chuẩn bị tinh thần đi nhé.\N- Em cũng đầu ba rồi mà lại.
Dialogue: 0,0:16:14.68,0:16:15.60,Default,,0,0,0,,Chị biết thừa rồi.
Dialogue: 0,0:16:19.23,0:16:22.65,Default,,0,0,0,,Năm nay chẳng có biến cố gì đặc biệt xảy ra cả.
Dialogue: 0,0:16:24.40,0:16:26.49,Default,,0,0,0,,Cậu phải hiểu chuyện hơn chứ.
Dialogue: 0,0:16:27.61,0:16:30.20,Default,,0,0,0,,"Không có biến cố gì đặc biệt"\Nnghĩa là bình yên đấy.
Dialogue: 0,0:16:31.16,0:16:36.00,Default,,0,0,0,,Mình nên biết ơn\Nkhi mọi sự đều trôi qua êm đềm như vậy.
Dialogue: 0,0:16:36.41,0:16:37.33,Default,,0,0,0,,Bác nói chí phải.
Dialogue: 0,0:16:38.87,0:16:39.83,Default,,0,0,0,,Năm.
Dialogue: 0,0:16:40.50,0:16:41.38,Default,,0,0,0,,Bốn.
Dialogue: 0,0:16:42.29,0:16:44.38,Default,,0,0,0,,Ba. Hai.
Dialogue: 0,0:16:45.34,0:16:46.26,Default,,0,0,0,,Một.
Dialogue: 0,0:16:47.05,0:16:49.68,Default,,0,0,0,,Chúc mừng năm mới!
Dialogue: 0,0:16:50.18,0:16:52.47,Default,,0,0,0,,Kính chúc mọi người\Nmột năm mới an khang thịnh vượng!
Dialogue: 0,0:16:53.76,0:16:57.06,Default,,0,0,0,,- Nào, cùng...\N- Thôi ngay đi. Cấm uống rượu đấy.
Dialogue: 0,0:16:57.52,0:17:00.65,Default,,0,0,0,,Nâng chén thứ này đi. Nước dùng mì soba đấy.
Dialogue: 0,0:17:13.32,0:17:15.20,Default,,0,0,0,,Cạn ly chúc mừng năm mới nào!
Dialogue: 0,0:17:31.18,0:17:32.14,Default,,0,0,0,,Ông chủ ơi?
Dialogue: 0,0:17:33.05,0:17:35.76,Default,,0,0,0,,Bà chủ quán bar sẽ đến trễ một chút đấy nhé.
Dialogue: 0,0:17:57.16,0:17:58.70,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:17:59.24,0:18:01.33,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:18:02.29,0:18:04.00,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:18:05.17,0:18:07.96,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:18:08.05,0:18:09.51,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:18:09.96,0:18:13.63,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:18:15.97,0:18:19.06,Default,,0,0,0,,Chào Ông chủ nhé. Năm mới chúc quán ta\Nluôn buôn may bán đắt và làm ăn phát đạt nhé!
Dialogue: 0,0:18:19.39,0:18:22.31,Default,,0,0,0,,- Chào anh nhé.\N- Chúc hai người đi chơi vui vẻ!
Dialogue: 0,0:18:22.39,0:18:25.31,Default,,0,0,0,,- Tạm biệt nhé.\N- Tạm biệt!
Dialogue: 0,0:18:34.95,0:18:36.49,Default,,0,0,0,,Mong là chuyến đi sẽ thuận buồm xuôi gió.
Dialogue: 0,0:18:40.62,0:18:42.71,Default,,0,0,0,,Này Michiru, em muốn chị mua quà lưu niệm gì nào?
Dialogue: 0,0:18:43.00,0:18:44.00,Default,,0,0,0,,Lại đây buôn chuyện tí nào.
Dialogue: 0,0:18:49.38,0:18:52.26,Default,,0,0,0,,Cậu vừa bảo có quán rượu phong cách Hawaii\Nmới mở ở khu này hả?
Dialogue: 0,0:19:11.86,0:19:13.03,Default,,0,0,0,,Chúc mừng năm mới anh nhé.
Dialogue: 0,0:19:22.29,0:19:25.92,Default,,0,0,0,,Cảm ơn cô đã phụ tôi rửa đống bát đĩa này nhé.
Dialogue: 0,0:19:26.87,0:19:27.87,Default,,0,0,0,,Có gì đâu anh.
Dialogue: 0,0:19:27.96,0:19:29.80,Default,,0,0,0,,Hôm nay khách đông nghìn nghịt, anh một mình làm sao xuể.
Dialogue: 0,0:19:33.26,0:19:35.43,Default,,0,0,0,,Ông chủ à, anh quả là một người đàn ông may mắn đấy.
Dialogue: 0,0:19:36.30,0:19:38.80,Default,,0,0,0,,Quán anh lúc nào cũng có những vị khách tuyệt vời ghé thăm.
Dialogue: 0,0:19:40.39,0:19:41.43,Default,,0,0,0,,Cô nói đúng đấy.
Dialogue: 0,0:19:45.48,0:19:48.44,Default,,0,0,0,,- Anh có duyên hút khách lắm đấy.\N- Đâu có.
Dialogue: 0,0:19:49.27,0:19:52.32,Default,,0,0,0,,Tôi chỉ mở quán vào đúng khung giờ đó\Nmỗi đêm thôi,
Dialogue: 0,0:19:52.82,0:19:54.78,Default,,0,0,0,,khách gọi món gì thì nấu món nấy,
Dialogue: 0,0:19:55.32,0:19:57.82,Default,,0,0,0,,rồi dọn dẹp đóng cửa quán\Nvào cùng một thời điểm mỗi sáng.
Dialogue: 0,0:19:57.95,0:20:00.37,Default,,0,0,0,,- Chỉ đơn giản vậy thôi.\N- Nghe thật là một quán ăn ấm cúng.
Dialogue: 0,0:20:02.58,0:20:03.50,Default,,0,0,0,,Này anh,
Dialogue: 0,0:20:06.46,0:20:09.05,Default,,0,0,0,,anh có muốn cùng tôi đi viếng đền chùa\Nđầu năm mới không?
Dialogue: 0,0:20:13.67,0:20:14.84,Default,,0,0,0,,Xin lỗi cô nhé.
Dialogue: 0,0:20:16.55,0:20:19.85,Default,,0,0,0,,Hôm nay tôi định tổng vệ sinh nhà cửa\Ncho sạch sẽ tươm tất đã.
Dialogue: 0,0:20:23.68,0:20:24.51,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:20:29.90,0:20:31.03,Default,,0,0,0,,Tôi hiểu ý anh mà.
Dialogue: 0,0:20:42.70,0:20:45.62,Default,,0,0,0,,Năm mới mong anh tiếp tục chiếu cố\Nvới giúp đỡ tôi nhé.
Dialogue: 0,0:20:48.00,0:20:48.88,Default,,0,0,0,,Tôi cũng vậy, mong cô giúp đỡ nhiều hơn.
Dialogue: 0,0:23:49.09,0:23:53.89,Default,,0,0,0,,CÂU CHUYỆN NÀY LÀ HƯ CẤU
