Dialogue: 0,0:01:03.19,0:01:07.61,Default,,0,0,0,,Khi người ta kết thúc một ngày\Nvà vội vã trở về nhà,
Dialogue: 0,0:01:08.36,0:01:09.78,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:27.59,0:01:30.26,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:30.84,0:01:32.18,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:33.26,0:01:36.10,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:40.98,0:01:42.23,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:43.02,0:01:44.77,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:48.69,0:01:52.40,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NCHUYỆN Ở TOKYO
Dialogue: 0,0:01:52.49,0:01:55.08,Default,,0,0,0,,ĐẬU HŨ TRỨNG
Dialogue: 0,0:01:57.49,0:01:58.78,Default,,0,0,0,,Anh đã đánh mạt chược với gã đó rồi à?
Dialogue: 0,0:01:59.41,0:02:00.50,Default,,0,0,0,,Chỉ mới giao lưu hai ván thôi.
Dialogue: 0,0:02:01.20,0:02:03.99,Default,,0,0,0,,Hắn đã vét sạch sành sanh số tiền tôi vừa thắng được\Nở tiệm pachinko.
Dialogue: 0,0:02:04.83,0:02:07.96,Default,,0,0,0,,Nếu tay nghề hắn cao thủ đến thế,\Nchẳng phải sẽ kiếm được bộn tiền sao?
Dialogue: 0,0:02:08.80,0:02:11.30,Default,,0,0,0,,Phải cô thì cô có chịu ngồi vào bàn mạt chược\Nđấu với một tay cao thủ cỡ đó không?
Dialogue: 0,0:02:11.76,0:02:14.35,Default,,0,0,0,,Tất nhiên là không rồi,\Nbiết trước cầm chắc phần thua thì chơi làm gì.
Dialogue: 0,0:02:14.43,0:02:15.47,Default,,0,0,0,,Chính xác là vậy đấy.
Dialogue: 0,0:02:19.10,0:02:20.31,Default,,0,0,0,,Nhắc Tào Tháo là Tào Tháo tới liền kìa.
Dialogue: 0,0:02:20.85,0:02:22.27,Default,,0,0,0,,Mừng anh quay trở lại.
Dialogue: 0,0:02:24.77,0:02:26.98,Default,,0,0,0,,Chỉ có về đến Shinjuku tôi mới thấy thoải mái như ở nhà.
Dialogue: 0,0:02:28.36,0:02:29.53,Default,,0,0,0,,Cảm ơn vì chầu tối qua nhé.
Dialogue: 0,0:02:29.69,0:02:32.61,Default,,0,0,0,,Cứ coi như đó là chút quà mọn tôi mừng anh\Nsau một năm trời mới quay lại đây đi.
Dialogue: 0,0:02:32.82,0:02:34.16,Default,,0,0,0,,Chú mày đúng là dân cờ bạc có khí phách đấy.
Dialogue: 0,0:02:36.61,0:02:38.32,Default,,0,0,0,,Vào lẹ đi, không là tao bỏ mày lại ngoài đường đấy.
Dialogue: 0,0:02:44.71,0:02:46.50,Default,,0,0,0,,Đứa bé đó là con trai anh à?
Dialogue: 0,0:02:49.79,0:02:51.75,Default,,0,0,0,,Ông chủ, cho tôi gọi "món đó" nhé?
Dialogue: 0,0:02:52.63,0:02:54.09,Default,,0,0,0,,Còn phần của thằng nhóc này...
Dialogue: 0,0:02:55.97,0:02:56.80,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:02:59.89,0:03:01.43,Default,,0,0,0,,Tay cờ bạc mạt chược chuyên nghiệp, anh Ogami,
Dialogue: 0,0:03:02.27,0:03:03.77,Default,,0,0,0,,cực kỳ mê món đậu hũ trứng.
Dialogue: 0,0:03:04.35,0:03:06.94,Default,,0,0,0,,Ở siêu thị nào người ta cũng bán món này\Ntheo từng lốc ba hộp một.
Dialogue: 0,0:03:09.52,0:03:10.98,Default,,0,0,0,,Hồi tôi còn đang phiêu bạt ở dưới Kyushu,
Dialogue: 0,0:03:12.23,0:03:14.02,Default,,0,0,0,,người tình cũ đã đem thằng bé đến vứt lại cho tôi.
Dialogue: 0,0:03:15.61,0:03:18.11,Default,,0,0,0,,Cô ta chỉ để lại độc một mảnh giấy nhắn,\Nkhang khăng rằng thằng bé là giọt máu của tôi,
Dialogue: 0,0:03:18.91,0:03:19.87,Default,,0,0,0,,nhưng có trời mới biết thực hư thế nào.
Dialogue: 0,0:03:20.78,0:03:23.16,Default,,0,0,0,,Thế là anh nhận nuôi thằng bé luôn à?
Dialogue: 0,0:03:24.33,0:03:25.37,Default,,0,0,0,,Còn cách nào khác đâu.
Dialogue: 0,0:03:26.25,0:03:28.34,Default,,0,0,0,,Làm gì còn ai khác đứng ra chăm sóc cho nó nữa.
Dialogue: 0,0:03:35.59,0:03:36.42,Default,,0,0,0,,Chà...
Dialogue: 0,0:03:36.76,0:03:38.09,Default,,0,0,0,,Nếu hai người mà không có quan hệ máu mủ ruột rà,
Dialogue: 0,0:03:38.18,0:03:40.89,Default,,0,0,0,,thì chắc chắn ai đó đã\Nnhân bản vô tính ra anh đấy.
Dialogue: 0,0:03:40.97,0:03:41.89,Default,,0,0,0,,Ông chủ nói chí phải.
Dialogue: 0,0:03:44.14,0:03:44.97,Default,,0,0,0,,Ông chủ này.
Dialogue: 0,0:03:46.77,0:03:48.02,Default,,0,0,0,,Ông có thể cho thằng bé ăn bất cứ món gì
Dialogue: 0,0:03:48.39,0:03:50.06,Default,,0,0,0,,mỗi khi nó ghé qua đây một mình được không?
Dialogue: 0,0:03:53.11,0:03:55.78,Default,,0,0,0,,Cháu thích ăn gì cứ nói với bác, đừng ngại nhé.
Dialogue: 0,0:04:08.21,0:04:10.55,Default,,0,0,0,,Nếu chú mày cứ đánh theo lối phòng thủ an toàn thế,
Dialogue: 0,0:04:10.63,0:04:12.47,Default,,0,0,0,,thì chẳng bao giờ vươn lên dẫn đầu được đâu.
Dialogue: 0,0:04:13.50,0:04:15.34,Default,,0,0,0,,Tiếc quá nhỉ. Nhà cái này không cho phép điều đó xảy ra đâu.
Dialogue: 0,0:04:16.30,0:04:18.43,Default,,0,0,0,,Riichi, Tanyao, Pinfu. Thêm hai Dora nữa.
Dialogue: 0,0:04:18.51,0:04:19.34,Default,,0,0,0,,Tổng cộng 12.000 điểm.
Dialogue: 0,0:04:20.97,0:04:23.60,Default,,0,0,0,,Tôi nên chuồn lẹ trước khi bị lột sạch túi thì hơn.
Dialogue: 0,0:04:24.31,0:04:25.98,Default,,0,0,0,,Thôi nào bác. Vẫn còn sớm chán mà.
Dialogue: 0,0:04:28.02,0:04:30.69,Default,,0,0,0,,Cái này là anh Kazuma gửi cho chị ạ.
Dialogue: 0,0:04:36.69,0:04:38.07,Default,,0,0,0,,Mấy cái đứa ranh con này.
Dialogue: 0,0:04:38.74,0:04:39.62,Default,,0,0,0,,Xin lỗi ông nhé.
Dialogue: 0,0:04:42.49,0:04:43.45,Default,,0,0,0,,Tụi cháu cười nói hơi ồn ào quá.
Dialogue: 0,0:04:44.49,0:04:46.99,Default,,0,0,0,,Không sao đâu. Cứ tự nhiên đi, đừng bận tâm.
Dialogue: 0,0:04:49.21,0:04:51.96,Default,,0,0,0,,Con người sống ở đời phải biết đùm bọc lẫn nhau\Nthì xã hội mới vận hành êm đẹp được.
Dialogue: 0,0:04:53.17,0:04:55.38,Default,,0,0,0,,Thế giới hòa bình đúng là tuyệt nhất.
Dialogue: 0,0:05:03.18,0:05:05.56,Default,,0,0,0,,Có ai muốn so tài cao thấp với tôi\Nđể gỡ gạc lại điểm không?
Dialogue: 0,0:05:06.89,0:05:08.43,Default,,0,0,0,,Tha cho tụi tôi đi, cậu Kazuma.
Dialogue: 0,0:05:08.52,0:05:11.02,Default,,0,0,0,,Cậu lúc nào cũng hiếu thắng hung hãn\Ncả trên chiếu mạt chược lẫn trên tình trường.
Dialogue: 0,0:05:11.10,0:05:12.27,Default,,0,0,0,,Anh nói chuẩn không cần chỉnh.
Dialogue: 0,0:05:16.61,0:05:18.28,Default,,0,0,0,,Sao anh không ra tay dạy cho thằng nhóc đó một bài học đi?
Dialogue: 0,0:05:18.99,0:05:21.20,Default,,0,0,0,,Với trình độ thượng thừa của anh,\Nnghiền nát hắn dễ như trở bàn tay còn gì.
Dialogue: 0,0:05:21.28,0:05:22.11,Default,,0,0,0,,Pung quân đó.
Dialogue: 0,0:05:25.07,0:05:26.03,Default,,0,0,0,,Mày vừa nói cái gì cơ?
Dialogue: 0,0:05:28.37,0:05:31.08,Default,,0,0,0,,Xem ra dạo này anh cũng hiền đi nhiều rồi nhỉ?
Dialogue: 0,0:05:35.21,0:05:36.75,Default,,0,0,0,,Nếu anh mà xúi anh ấy làm chuyện đó,
Dialogue: 0,0:05:36.84,0:05:38.30,Default,,0,0,0,,chị Marilyn sẽ nổi trận lôi đình với anh cho xem.
Dialogue: 0,0:05:38.38,0:05:40.47,Default,,0,0,0,,Chẳng có vấn đề gì hết.
Dialogue: 0,0:05:41.13,0:05:43.80,Default,,0,0,0,,"Trong thời gian em đi lưu diễn xa,\Nanh nhớ canh chừng giúp để anh ấy chung thủy với em nhé."
Dialogue: 0,0:05:43.89,0:05:45.48,Default,,0,0,0,,Chính miệng Marilyn đã nhờ vả tôi như thế đấy.
Dialogue: 0,0:05:46.14,0:05:49.35,Default,,0,0,0,,- Đúng không hả, Kimitoshi?\N- Chuẩn luôn đại ca.
Dialogue: 0,0:05:50.06,0:05:51.39,Default,,0,0,0,,Chuyện này đã được chính chủ Marilyn thông qua rồi.
Dialogue: 0,0:05:51.85,0:05:54.06,Default,,0,0,0,,Em thật chẳng thể hiểu nổi anh Ogami nghĩ gì nữa.
Dialogue: 0,0:05:54.15,0:05:57.03,Default,,0,0,0,,Anh ta dẫn theo cả thằng nhóc này\Nđến rạp xem buổi diễn thoát y của tụi em đấy.
Dialogue: 0,0:05:57.11,0:06:00.28,Default,,0,0,0,,Anh ta còn viện cớ rằng thằng bé\Nnhớ bầu sữa mẹ nên mới đưa đi xem.
Dialogue: 0,0:06:00.36,0:06:01.24,Default,,0,0,0,,Này.
Dialogue: 0,0:06:02.11,0:06:04.40,Default,,0,0,0,,Ngực của chị Katherine thế nào hả nhóc?
Dialogue: 0,0:06:08.08,0:06:10.29,Default,,0,0,0,,Chắc là thằng bé chẳng khoái rồi.
Dialogue: 0,0:06:10.37,0:06:12.58,Default,,0,0,0,,Chuyện này gay go đây.
Dialogue: 0,0:06:17.71,0:06:19.17,Default,,0,0,0,,Xin mời vào, Midori.
Dialogue: 0,0:06:19.80,0:06:21.64,Default,,0,0,0,,- Cho em một cốc bia nhé ông chủ?\N- Có ngay.
Dialogue: 0,0:06:35.44,0:06:37.65,Default,,0,0,0,,- Cậu muốn tôi mách lẻo chuyện này với Marilyn hả?\N- Không, ờ thì...
Dialogue: 0,0:06:37.73,0:06:38.56,Default,,0,0,0,,chuyện là...
Dialogue: 0,0:06:39.07,0:06:40.28,Default,,0,0,0,,Em đang ăn món gì thế?
Dialogue: 0,0:06:42.32,0:06:43.57,Default,,0,0,0,,Cơm trộn đậu hũ trứng ạ.
Dialogue: 0,0:06:47.12,0:06:47.95,Default,,0,0,0,,Có ngon không?
Dialogue: 0,0:06:56.83,0:06:57.66,Default,,0,0,0,,Cho cô thật hả?
Dialogue: 0,0:07:02.76,0:07:04.43,Default,,0,0,0,,Con cũng thích ngực của chị lắm hả?
Dialogue: 0,0:07:11.89,0:07:13.18,Default,,0,0,0,,Món này ngon thật đấy.
Dialogue: 0,0:07:15.77,0:07:17.19,Default,,0,0,0,,Nhóc tên là gì thế?
Dialogue: 0,0:07:18.65,0:07:19.48,Default,,0,0,0,,Taizo ạ.
Dialogue: 0,0:07:23.86,0:07:25.99,Default,,0,0,0,,Taizo này, em có thích ăn bánh pudding không?
Dialogue: 0,0:07:26.86,0:07:27.69,Default,,0,0,0,,Dạ thích ạ.
Dialogue: 0,0:07:37.67,0:07:40.21,Default,,0,0,0,,Em có muốn lên lầu chợp mắt một lát không?
Dialogue: 0,0:07:44.09,0:07:45.63,Default,,0,0,0,,Hai chị em mình cùng lên ngủ nhé.
Dialogue: 0,0:07:46.34,0:07:48.59,Default,,0,0,0,,Khi nào có người tới đón\Nthì chị sẽ gọi em dậy.
Dialogue: 0,0:07:51.85,0:07:54.60,Default,,0,0,0,,Không biết tối nay ai trong hai chị em mình\Nsẽ có người tới đón trước đây nhỉ.
Dialogue: 0,0:08:04.07,0:08:05.45,Default,,0,0,0,,Thằng bé ngủ thiếp đi nhanh thế cơ à?
Dialogue: 0,0:08:06.07,0:08:06.91,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:08:11.57,0:08:13.24,Default,,0,0,0,,Trẻ con đúng là đáng yêu thật đấy.
Dialogue: 0,0:08:14.04,0:08:15.71,Default,,0,0,0,,Nhìn thằng bé làm em cũng muốn có một đứa con của riêng mình.
Dialogue: 0,0:08:16.41,0:08:18.70,Default,,0,0,0,,Để tôi mời cô một ly coi như lời cảm ơn nhé.
Dialogue: 0,0:08:20.50,0:08:21.33,Default,,0,0,0,,Tuyệt vời ông mặt trời!
Dialogue: 0,0:08:55.28,0:08:56.20,Default,,0,0,0,,Cảm ơn ông chủ nhiều lắm.
Dialogue: 0,0:08:57.04,0:08:58.63,Default,,0,0,0,,Xin lỗi vì đã làm phiền mọi người nhé.
Dialogue: 0,0:08:59.37,0:09:00.20,Default,,0,0,0,,Có gì đâu anh.
Dialogue: 0,0:09:00.71,0:09:01.96,Default,,0,0,0,,Nhờ vậy mà em cũng được đánh một giấc ngon lành.
Dialogue: 0,0:09:06.55,0:09:07.72,Default,,0,0,0,,Alo?
Dialogue: 0,0:09:08.59,0:09:10.76,Default,,0,0,0,,Dạo này em làm ăn ra sao rồi?
Dialogue: 0,0:09:13.84,0:09:15.18,Default,,0,0,0,,Đúng là cái gen di truyền trong máu rồi.
Dialogue: 0,0:09:16.26,0:09:17.26,Default,,0,0,0,,Ý anh là sao?
Dialogue: 0,0:09:18.14,0:09:19.68,Default,,0,0,0,,Con bé nói câu thích ngực giống hệt tính tôi.
Dialogue: 0,0:09:25.52,0:09:28.73,Default,,0,0,0,,Cô gái đó làm tôi nhớ tới mẹ ruột của thằng bé.
Dialogue: 0,0:09:30.70,0:09:31.87,Default,,0,0,0,,Giờ anh tính sao đây?
Dialogue: 0,0:09:33.41,0:09:35.04,Default,,0,0,0,,Sang năm là thằng bé đến tuổi đi học tiểu học rồi đấy.
Dialogue: 0,0:09:39.00,0:09:39.83,Default,,0,0,0,,Này ông chủ...
Dialogue: 0,0:09:40.33,0:09:41.50,Default,,0,0,0,,Cái cô gái tên Midori đó.
Dialogue: 0,0:09:42.37,0:09:43.62,Default,,0,0,0,,Cô ấy làm nghề gì thế?
Dialogue: 0,0:09:45.33,0:09:47.46,Default,,0,0,0,,Tôi nghe đâu cô ấy đang làm tiếp viên ở một quán bar.
Dialogue: 0,0:09:47.59,0:09:48.92,Default,,0,0,0,,Đúng là trùng hợp thật đấy!
Dialogue: 0,0:09:50.34,0:09:51.51,Default,,0,0,0,,Mẹ của thằng bé này
Dialogue: 0,0:09:52.43,0:09:53.51,Default,,0,0,0,,cũng từng làm việc ở một quán bar.
Dialogue: 0,0:10:13.95,0:10:14.95,Default,,0,0,0,,Hôm nay tôi đã trót hứa với Taizo
Dialogue: 0,0:10:15.16,0:10:18.08,Default,,0,0,0,,là sẽ dẫn cu cậu đi ăn bánh pudding rồi.
Dialogue: 0,0:10:18.62,0:10:20.37,Default,,0,0,0,,Vậy cứ để tôi đưa hai người đi.
Dialogue: 0,0:10:20.79,0:10:23.54,Default,,0,0,0,,Chúng ta có thể ghé ăn lót dạ món gì đó\Ntrước khi đi ăn bánh pudding.
Dialogue: 0,0:10:23.62,0:10:25.16,Default,,0,0,0,,- Hay là đi xem phim nhé?\N- Này ông chú.
Dialogue: 0,0:10:25.58,0:10:27.33,Default,,0,0,0,,Chính ông còn chẳng muốn nhận làm bố của thằng bé.
Dialogue: 0,0:10:27.42,0:10:29.21,Default,,0,0,0,,Đừng có tự tiện bám càng theo tụi tôi như thế.
Dialogue: 0,0:10:29.34,0:10:31.38,Default,,0,0,0,,Bộ tôi là kẻ thứ ba vô duyên cản mũi hai người à?
Dialogue: 0,0:10:31.67,0:10:32.92,Default,,0,0,0,,Chứ còn gì nữa, chuẩn xác luôn đấy.
Dialogue: 0,0:10:36.64,0:10:37.81,Default,,0,0,0,,Khi nào xong xuôi thì gọi cho tôi vào số này nhé.
Dialogue: 0,0:10:38.47,0:10:39.89,Default,,0,0,0,,Qua giờ trưa tôi sẽ tới đón thằng bé.
Dialogue: 0,0:10:49.77,0:10:51.94,Default,,0,0,0,,Lẽ ra chị phải kiểm tra kỹ giờ mở cửa của tiệm mới phải.
Dialogue: 0,0:10:54.07,0:10:54.90,Default,,0,0,0,,Chị xin lỗi em nhé.
Dialogue: 0,0:11:06.21,0:11:07.96,Default,,0,0,0,,Bố mẹ chị đang làm thủ tục ly hôn đấy.
Dialogue: 0,0:11:09.42,0:11:12.34,Default,,0,0,0,,Chị biết trước kiểu gì cũng có ngày này rồi,\Nnên chẳng thấy ngạc nhiên chút nào cả.
Dialogue: 0,0:11:12.67,0:11:13.67,Default,,0,0,0,,Nghĩ lại chỉ thấy nực cười thôi.
Dialogue: 0,0:11:16.88,0:11:18.55,Default,,0,0,0,,Nhưng cũng nhờ hoàn cảnh đó mà chị trở nên cứng cỏi hơn nhiều.
Dialogue: 0,0:11:19.89,0:11:21.02,Default,,0,0,0,,Suy cho cùng thì,
Dialogue: 0,0:11:21.10,0:11:23.85,Default,,0,0,0,,chẳng một ai trên đời này bảo vệ được mình ngoài chính bản thân mình cả.
Dialogue: 0,0:11:29.23,0:11:30.36,Default,,0,0,0,,Em có hiểu ý chị nói không?
Dialogue: 0,0:11:35.19,0:11:36.02,Default,,0,0,0,,Tất nhiên là hiểu rồi.
Dialogue: 0,0:11:36.90,0:11:38.74,Default,,0,0,0,,Bản thân em cũng đã phải trải qua đủ thứ chuyện còn gì.
Dialogue: 0,0:11:41.20,0:11:42.79,Default,,0,0,0,,Hai chị em mình cũng khá giống nhau đấy nhỉ.
Dialogue: 0,0:11:50.46,0:11:51.29,Default,,0,0,0,,Này nhóc.
Dialogue: 0,0:11:52.13,0:11:54.22,Default,,0,0,0,,Tuần sau hai chị em mình lại đi phục thù món bánh pudding nhé.
Dialogue: 0,0:11:55.01,0:11:56.80,Default,,0,0,0,,Cứ tin ở chị. Bánh pudding ở tiệm đó là ngon nhất quả đất luôn.
Dialogue: 0,0:12:10.19,0:12:11.15,Default,,0,0,0,,Mấy viên bi đó em cho chị hả?
Dialogue: 0,0:12:49.94,0:12:50.77,Default,,0,0,0,,Ấm áp thật đấy.
Dialogue: 0,0:12:57.23,0:12:58.40,Default,,0,0,0,,Người ta kết thúc một ngày làm việc
Dialogue: 0,0:12:58.86,0:13:00.86,Default,,0,0,0,,và vội vã trở về nhà.
Dialogue: 0,0:13:02.24,0:13:03.20,Default,,0,0,0,,Nhưng đôi khi,
Dialogue: 0,0:13:03.28,0:13:05.49,Default,,0,0,0,,họ lại chẳng muốn lập tức bước chân về nhà ngay,
Dialogue: 0,0:13:06.20,0:13:08.41,Default,,0,0,0,,nên đành ghé tạm vào một chốn nào đó\Ntrên đường về.
Dialogue: 0,0:13:11.08,0:13:13.79,Default,,0,0,0,,Ông chủ, xin lỗi vì lại làm phiền ông giữ thằng bé giúp nhé.
Dialogue: 0,0:13:13.88,0:13:15.51,Default,,0,0,0,,Đừng bận tâm chuyện đó.
Dialogue: 0,0:13:16.21,0:13:17.80,Default,,0,0,0,,- Nhưng mà--\N- Tôi biết chứ.
Dialogue: 0,0:13:19.17,0:13:22.09,Default,,0,0,0,,Tôi không thể cứ mãi sống cuộc đời rày đây mai đó thế này khi đèo bồng theo một đứa trẻ được.
Dialogue: 0,0:13:23.39,0:13:24.93,Default,,0,0,0,,Tuần tới có một ván cược lớn rất quan trọng.
Dialogue: 0,0:13:25.89,0:13:27.06,Default,,0,0,0,,Cho đến khi giải quyết xong trận đó,
Dialogue: 0,0:13:27.47,0:13:29.56,Default,,0,0,0,,tôi vẫn chưa có tâm trí đâu mà tính chuyện tương lai cho thằng bé.
Dialogue: 0,0:13:53.50,0:13:54.63,Default,,0,0,0,,Ông là ông Ogami phải không?
Dialogue: 0,0:13:56.09,0:13:57.38,Default,,0,0,0,,Midori đã kể cho tôi nghe về ông.
Dialogue: 0,0:13:59.46,0:14:01.55,Default,,0,0,0,,Vậy phiền cậu nhắn lại với cô ấy...
Dialogue: 0,0:14:02.47,0:14:05.39,Default,,0,0,0,,khi nào rảnh rỗi thì ghé qua quán ăn đêm một lát nhé?
Dialogue: 0,0:14:06.76,0:14:08.05,Default,,0,0,0,,Thằng nhóc ở nhà nhớ cô ấy lắm.
Dialogue: 0,0:14:09.01,0:14:10.97,Default,,0,0,0,,Cô ấy đang ở ngay dưới lầu thôi.\NTôi có thể xuống gọi cô ấy lên cho ông gặp.
Dialogue: 0,0:14:11.06,0:14:11.89,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:14:13.14,0:14:14.93,Default,,0,0,0,,Cứ nhắn lại đúng những gì tôi vừa nhờ cậu là được.
Dialogue: 0,0:14:19.28,0:14:20.11,Default,,0,0,0,,Tôi...
Dialogue: 0,0:14:21.36,0:14:22.82,Default,,0,0,0,,rất mong chờ đến ván đấu sắp tới giữa hai chúng ta đấy.
Dialogue: 0,0:14:29.20,0:14:30.20,Default,,0,0,0,,Cảm ơn quý khách.
Dialogue: 0,0:14:34.96,0:14:35.88,Default,,0,0,0,,Taizo!
Dialogue: 0,0:14:39.88,0:14:40.71,Default,,0,0,0,,Chào chị.
Dialogue: 0,0:14:44.17,0:14:46.72,Default,,0,0,0,,Kiểu tóc mới của chị nhìn dễ thương cực kỳ.\NChị mới làm tóc đấy ạ?
Dialogue: 0,0:14:59.86,0:15:01.45,Default,,0,0,0,,Thằng nhóc đó cũng là người cùng hội cùng thuyền với chú mày đấy.
Dialogue: 0,0:15:02.82,0:15:04.20,Default,,0,0,0,,Hắn từng làm trai bao ở câu lạc bộ.
Dialogue: 0,0:15:04.45,0:15:05.83,Default,,0,0,0,,Trên sới bạc thì hắn là một tay chơi cừ khôi,
Dialogue: 0,0:15:07.03,0:15:08.74,Default,,0,0,0,,nhưng lại là một gã đào mỏ rắc rối không vừa đâu.
Dialogue: 0,0:15:11.54,0:15:12.79,Default,,0,0,0,,Tôi nghĩ là...
Dialogue: 0,0:15:13.62,0:15:14.95,Default,,0,0,0,,cô ấy đã nghỉ làm ở quán bar tiếp viên rồi.
Dialogue: 0,0:15:15.50,0:15:17.38,Default,,0,0,0,,Đoán chừng cô ấy đã bị gã đó ép phải chuyển sang làm...
Dialogue: 0,0:15:18.13,0:15:19.80,Default,,0,0,0,,ở một nơi kiếm được nhiều tiền hơn.
Dialogue: 0,0:15:25.01,0:15:25.84,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:15:26.43,0:15:27.26,Default,,0,0,0,,Anh Ogami.
Dialogue: 0,0:15:27.64,0:15:28.77,Default,,0,0,0,,Đến giờ xuất phát rồi.
Dialogue: 0,0:15:36.56,0:15:38.73,Default,,0,0,0,,Tôi sẽ quay lại đón thằng bé trước khi ông đóng cửa quán.
Dialogue: 0,0:15:39.56,0:15:40.81,Default,,0,0,0,,Nhờ ông trông nom thằng bé giúp tôi nhé.
Dialogue: 0,0:15:56.12,0:15:58.87,Default,,0,0,0,,Hiện giờ Midori đang làm việc ở đâu?
Dialogue: 0,0:15:59.71,0:16:01.75,Default,,0,0,0,,Cô ấy vẫn ổn cả.\NVẫn chăm chỉ cày cuốc như mọi khi thôi.
Dialogue: 0,0:16:03.46,0:16:05.34,Default,,0,0,0,,Cô nàng đâu thể sống thiếu tôi được.
Dialogue: 0,0:16:07.05,0:16:08.09,Default,,0,0,0,,Chàng trai trẻ này,
Dialogue: 0,0:16:09.09,0:16:11.51,Default,,0,0,0,,cậu không thể buông tha cho cô ấy được sao?
Dialogue: 0,0:16:13.72,0:16:14.55,Default,,0,0,0,,Không được à?
Dialogue: 0,0:16:16.43,0:16:17.93,Default,,0,0,0,,Xin ông đừng làm tôi thất vọng thế chứ.
Dialogue: 0,0:16:20.40,0:16:21.53,Default,,0,0,0,,Giữa tôi và ông...
Dialogue: 0,0:16:22.73,0:16:24.48,Default,,0,0,0,,đang có một cuộc quyết đấu sinh tử nghiêm túc đấy.
Dialogue: 0,0:16:30.82,0:16:31.65,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:16:33.74,0:16:36.58,Default,,0,0,0,,Muốn làm gì thì tùy ý ông.\NĐưa cô ta cho ông tất đấy.
Dialogue: 0,0:16:38.75,0:16:39.75,Default,,0,0,0,,Nhưng với điều kiện...
Dialogue: 0,0:16:40.50,0:16:41.71,Default,,0,0,0,,ông phải đánh bại được tôi trên bàn mạt chược này đã.
Dialogue: 0,0:16:43.79,0:16:45.75,Default,,0,0,0,,Đúng là một ngày dài mệt mỏi.
Dialogue: 0,0:16:45.84,0:16:46.76,Default,,0,0,0,,Em vất vả rồi.
Dialogue: 0,0:17:01.98,0:17:02.81,Default,,0,0,0,,Dạ?
Dialogue: 0,0:17:03.73,0:17:04.56,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:17:06.44,0:17:09.07,Default,,0,0,0,,Khách sạn Florida. Phòng số 906.
Dialogue: 0,0:17:09.86,0:17:10.69,Default,,0,0,0,,Em rõ rồi ạ.
Dialogue: 0,0:17:14.78,0:17:15.78,Default,,0,0,0,,Riichi.
Dialogue: 0,0:17:21.54,0:17:22.37,Default,,0,0,0,,Riichi.
Dialogue: 0,0:17:36.18,0:17:38.85,Default,,0,0,0,,Tự bốc ù Tsumo.\N2.000 - 1.000 điểm.
Dialogue: 0,0:17:41.02,0:17:41.94,Default,,0,0,0,,Đúng là ván bài còm nhom rẻ rúng!
Dialogue: 0,0:17:58.04,0:17:58.87,Default,,0,0,0,,Ù rồi!
Dialogue: 0,0:18:00.33,0:18:01.79,Default,,0,0,0,,Ván này ăn 8.000 điểm.
Dialogue: 0,0:18:24.14,0:18:25.35,Default,,0,0,0,,32.000 điểm.
Dialogue: 0,0:18:36.28,0:18:37.28,Default,,0,0,0,,Ù!
Dialogue: 0,0:18:37.37,0:18:38.62,Default,,0,0,0,,Ù tiếp!
Dialogue: 0,0:18:49.80,0:18:50.63,Default,,0,0,0,,Tôi van ông đấy.
Dialogue: 0,0:18:56.30,0:18:57.59,Default,,0,0,0,,Cho gỡ thêm đúng một ván nữa thôi?
Dialogue: 0,0:19:02.43,0:19:03.31,Default,,0,0,0,,Đánh hay lắm, đại ca.
Dialogue: 0,0:19:05.77,0:19:06.60,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:19:08.94,0:19:09.77,Default,,0,0,0,,Anh vất vả rồi.
Dialogue: 0,0:19:21.12,0:19:23.96,Default,,0,0,0,,Cảm giác nhẹ nhõm cứ như vừa mới được trục xuất\Ntà ma ra khỏi người vậy.
Dialogue: 0,0:19:25.16,0:19:26.33,Default,,0,0,0,,Giờ dự định của anh là gì?
Dialogue: 0,0:19:29.33,0:19:30.29,Default,,0,0,0,,Tôi định...
Dialogue: 0,0:19:31.13,0:19:33.30,Default,,0,0,0,,sẽ dẫn thằng bé về quê viếng mộ ông bà nội của nó.
Dialogue: 0,0:19:33.84,0:19:36.01,Default,,0,0,0,,Nhân lúc trong túi tôi vẫn còn rủng rỉnh tiền.
Dialogue: 0,0:19:36.88,0:19:37.71,Default,,0,0,0,,Thật vậy sao?
Dialogue: 0,0:19:44.02,0:19:44.85,Default,,0,0,0,,Này.
Dialogue: 0,0:19:45.93,0:19:46.81,Default,,0,0,0,,Giờ thì cô cứ yên tâm kê cao gối mà ngủ nhé.
Dialogue: 0,0:19:47.94,0:19:51.03,Default,,0,0,0,,Tên ký sinh trùng bám váy phụ nữ đó\Nsẽ không dám bén mảng về thành phố này trong một thời gian dài đâu.
Dialogue: 0,0:19:55.15,0:19:58.57,Default,,0,0,0,,Ông nghĩ mình là ai thế hả?\NLà siêu anh hùng cứu nhân độ thế chắc?
Dialogue: 0,0:20:01.74,0:20:03.24,Default,,0,0,0,,Ông đã đuổi Kazuma của tôi đi đâu rồi?
Dialogue: 0,0:20:03.70,0:20:05.70,Default,,0,0,0,,Trả lại Kazuma đây cho tôi!
Dialogue: 0,0:20:06.79,0:20:08.96,Default,,0,0,0,,Giá như ông đừng bao giờ quay trở lại cái chốn này.
Dialogue: 0,0:20:09.04,0:20:10.96,Default,,0,0,0,,Ông đã gây ra chuyện quái quỷ gì thế này hả?
Dialogue: 0,0:20:11.34,0:20:12.88,Default,,0,0,0,,Kazuma đang ở đâu rồi?
Dialogue: 0,0:20:13.42,0:20:14.55,Default,,0,0,0,,Kazuma đâu...
Dialogue: 0,0:20:15.63,0:20:16.92,Default,,0,0,0,,Đồ ngốc hết thuốc chữa!
Dialogue: 0,0:20:44.20,0:20:46.66,Default,,0,0,0,,Lần nào làm ơn cũng mắc oán y như rằng.
Dialogue: 0,0:20:49.79,0:20:51.08,Default,,0,0,0,,Xem ra anh cũng quen với cảnh này lắm rồi nhỉ?
Dialogue: 0,0:20:55.96,0:20:57.46,Default,,0,0,0,,Cảm ơn lòng tốt của ông chủ suốt thời gian qua nhé.
Dialogue: 0,0:21:03.14,0:21:03.98,Default,,0,0,0,,Đi thôi con trai.
Dialogue: 0,0:21:13.06,0:21:14.14,Default,,0,0,0,,Xin lỗi cho tôi hỏi.
Dialogue: 0,0:21:15.48,0:21:17.07,Default,,0,0,0,,Anh có phải là người nổi tiếng trong giới giang hồ,
Dialogue: 0,0:21:17.15,0:21:18.65,Default,,0,0,0,,anh Ogami dẫn theo con nhỏ không?
Dialogue: 0,0:21:20.40,0:21:21.82,Default,,0,0,0,,Cũng có vài người gọi tôi bằng cái biệt danh đó.
Dialogue: 0,0:21:22.28,0:21:23.41,Default,,0,0,0,,Các anh tìm tôi có việc gì?
Dialogue: 0,0:21:24.49,0:21:26.53,Default,,0,0,0,,Chúng tôi muốn mời anh về đồn hỏi vài câu được chứ?
Dialogue: 0,0:21:31.75,0:21:33.09,Default,,0,0,0,,Chỉ mất vài phút của anh thôi.
Dialogue: 0,0:21:33.75,0:21:34.96,Default,,0,0,0,,Xin lỗi đã làm phiền.
Dialogue: 0,0:21:35.54,0:21:36.75,Default,,0,0,0,,Lúc đó anh Ogami đã vô cùng hoảng hốt,
Dialogue: 0,0:21:36.84,0:21:39.68,Default,,0,0,0,,cứ đinh ninh rằng mình bị bắt\Nvì tội đánh bạc trái phép.
Dialogue: 0,0:21:40.26,0:21:43.43,Default,,0,0,0,,Nhưng hóa ra lại là về việc vi phạm\NLuật Phúc lợi Trẻ em.
Dialogue: 0,0:21:43.51,0:21:47.60,Default,,0,0,0,,Bé Taizo sau đó đã được đưa vào trung tâm bảo trợ xã hội.
Dialogue: 0,0:21:49.31,0:21:50.98,Default,,0,0,0,,Thế chuyện sau đó ra sao rồi?
Dialogue: 0,0:21:51.60,0:21:55.60,Default,,0,0,0,,Ù rồi! Tam sắc đồng thuận.\NBa mươi fu.
Dialogue: 0,0:21:57.23,0:21:58.11,Default,,0,0,0,,Khá lắm nhóc.
Dialogue: 0,0:21:59.65,0:22:00.48,Default,,0,0,0,,Taizo ơi.
Dialogue: 0,0:22:01.24,0:22:02.91,Default,,0,0,0,,Bố con tới thăm con này.
Dialogue: 0,0:22:04.57,0:22:05.57,Default,,0,0,0,,Chào con trai, Taizo.
Dialogue: 0,0:22:06.62,0:22:08.96,Default,,0,0,0,,Bố có mua bánh pudding cho con đây. Hai bố con mình cùng ăn nhé.
Dialogue: 0,0:22:12.66,0:22:13.95,Default,,0,0,0,,Bố ơi, hôm nay con đánh thắng đấy.
Dialogue: 0,0:22:14.37,0:22:15.66,Default,,0,0,0,,- Thế cơ à?\N- Thắng đậm luôn ạ.
Dialogue: 0,0:22:15.75,0:22:17.42,Default,,0,0,0,,- Thắng đậm luôn cơ à?\N- Con thắng được nhiều ván lắm.
Dialogue: 0,0:22:17.50,0:22:19.13,Default,,0,0,0,,Con thắng được nhiều thế cơ à. Giỏi lắm.
Dialogue: 0,0:22:19.21,0:22:22.30,Default,,0,0,0,,- Con ù được ván 50 fu tới mấy lần liền.\N- Thật sao?
Dialogue: 0,0:22:22.38,0:22:23.26,Default,,0,0,0,,Giỏi quá đi mất.
Dialogue: 0,0:22:23.80,0:22:26.39,Default,,0,0,0,,- Tối nay hai bố con mình ra ngoài ăn sushi nhé.\N- Dạ vâng!
Dialogue: 0,0:22:29.93,0:22:31.72,Default,,0,0,0,,Trên miếng đậu hũ trứng mềm mịn...
Dialogue: 0,0:22:32.02,0:22:34.27,Default,,0,0,0,,rắc thêm chút cá mồi nhỏ sấy khô\Nvà lá tía tô thái chỉ thơm lừng.
Dialogue: 0,0:22:35.35,0:22:36.73,Default,,0,0,0,,Của cậu đây. Chúc ngon miệng.
Dialogue: 0,0:22:39.61,0:22:41.20,Default,,0,0,0,,Món này chế biến rất đơn giản.
Dialogue: 0,0:22:42.57,0:22:43.91,Default,,0,0,0,,Mềm mại và bông xốp...
Dialogue: 0,0:22:44.70,0:22:45.95,Default,,0,0,0,,Này, đừng có nghịch nữa.
Dialogue: 0,0:22:46.45,0:22:47.58,Default,,0,0,0,,Em xin lỗi mà.
Dialogue: 0,0:23:49.05,0:23:53.97,Default,,0,0,0,,CÂU CHUYỆN NÀY CHỈ LÀ HƯ CẤU
