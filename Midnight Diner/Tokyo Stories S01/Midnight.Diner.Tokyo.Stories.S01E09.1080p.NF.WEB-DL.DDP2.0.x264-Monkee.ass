Dialogue: 0,0:01:03.27,0:01:04.69,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:01:05.11,0:01:07.70,Default,,0,0,0,,và vội vã trở về nhà,
Dialogue: 0,0:01:08.49,0:01:09.82,Default,,0,0,0,,thì ngày mới của tôi mới bắt đầu.
Dialogue: 0,0:01:27.67,0:01:30.34,Default,,0,0,0,,Quán ăn của tôi mở cửa từ nửa đêm
Dialogue: 0,0:01:30.92,0:01:32.25,Default,,0,0,0,,đến bảy giờ sáng.
Dialogue: 0,0:01:33.34,0:01:36.18,Default,,0,0,0,,Người ta thường gọi nó là "Quán Ăn Đêm".
Dialogue: 0,0:01:41.10,0:01:42.52,Default,,0,0,0,,Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?
Dialogue: 0,0:01:43.06,0:01:44.85,Default,,0,0,0,,Thực ra là đông hơn bạn tưởng nhiều đấy.
Dialogue: 0,0:01:48.23,0:01:51.65,Default,,0,0,0,,QUÁN ĂN ĐÊM:\NNHỮNG CÂU CHUYỆN TOKYO
Dialogue: 0,0:01:51.74,0:01:55.24,Default,,0,0,0,,THỊT GIĂM BÔNG TẨM BỘT CHIÊN XÙ
Dialogue: 0,0:01:57.99,0:01:59.12,Default,,0,0,0,,Xin mời dùng bữa.
Dialogue: 0,0:02:06.54,0:02:09.04,Default,,0,0,0,,Đó là lần đầu tiên ông Nakatsuka\Nghé quán ăn của tôi.
Dialogue: 0,0:02:10.00,0:02:14.30,Default,,0,0,0,,Ông ấy ăn thịt giăm bông chiên xù ngon lành đến mức\Nđể lại ấn tượng sâu sắc trong lòng tôi.
Dialogue: 0,0:02:16.80,0:02:18.43,Default,,0,0,0,,Ông ăn làm tôi thèm chảy cả nước miếng đấy.
Dialogue: 0,0:02:20.06,0:02:22.94,Default,,0,0,0,,Thịt giăm bông tẩm bột chiên xù\Nphải thế này mới chuẩn vị.
Dialogue: 0,0:02:23.52,0:02:26.27,Default,,0,0,0,,Giăm bông thì phải mỏng,\Nnhưng lớp bột áo ngoài thì phải dày giòn.
Dialogue: 0,0:02:26.81,0:02:29.48,Default,,0,0,0,,Dạo gần đây nhiều tiệm cứ thích dùng\Nlát thịt giăm bông dày cộm.
Dialogue: 0,0:02:29.57,0:02:30.61,Default,,0,0,0,,Đúng không nào?
Dialogue: 0,0:02:31.07,0:02:35.37,Default,,0,0,0,,Tôi từng gọi món này ở một nhà hàng Tây,\Nnhưng mà sốc thật đấy.
Dialogue: 0,0:02:36.07,0:02:37.66,Default,,0,0,0,,Lát giăm bông của họ dày cùi cụi.
Dialogue: 0,0:02:37.74,0:02:39.87,Default,,0,0,0,,Lại còn là loại thượng hạng nữa chứ.
Dialogue: 0,0:02:45.67,0:02:47.55,Default,,0,0,0,,Hồi xưa chơi cùng em trai chứ gì?
Dialogue: 0,0:02:48.42,0:02:50.84,Default,,0,0,0,,Hễ mà thua cờ Othello,
Dialogue: 0,0:02:50.92,0:02:53.17,Default,,0,0,0,,là phải chạy ra ngoài\Nmua hai miếng thịt giăm bông chiên xù.
Dialogue: 0,0:02:54.55,0:02:55.51,Default,,0,0,0,,Mời ông dùng thêm.
Dialogue: 0,0:02:55.59,0:02:58.05,Default,,0,0,0,,Tôi chẳng có anh em gì cả,
Dialogue: 0,0:02:58.14,0:02:59.60,Default,,0,0,0,,nên nhìn ông mà ghen tị thật đấy.
Dialogue: 0,0:03:01.10,0:03:03.19,Default,,0,0,0,,À, nó không phải em ruột tôi đâu.
Dialogue: 0,0:03:03.77,0:03:04.61,Default,,0,0,0,,Dạ?
Dialogue: 0,0:03:05.77,0:03:09.36,Default,,0,0,0,,Thằng bé là con trai riêng\Ncủa người vợ kế của bố tôi.
Dialogue: 0,0:03:10.57,0:03:14.57,Default,,0,0,0,,Hai đứa tôi làm anh em được có bốn năm\Nthì bố mẹ ly hôn.
Dialogue: 0,0:03:15.82,0:03:17.53,Default,,0,0,0,,Hồi ấy tôi mới học tiểu học.
Dialogue: 0,0:03:18.03,0:03:20.03,Default,,0,0,0,,Cũng mấy chục năm trôi qua rồi.
Dialogue: 0,0:03:21.33,0:03:23.54,Default,,0,0,0,,Thế mà hai anh em vẫn thân thiết vậy sao?
Dialogue: 0,0:03:25.16,0:03:27.95,Default,,0,0,0,,Thằng bé tính nóng như lửa,\Nnhưng lại rất tình cảm và dễ mến.
Dialogue: 0,0:03:28.96,0:03:30.50,Default,,0,0,0,,Nó ngoan lắm.
Dialogue: 0,0:03:31.79,0:03:33.71,Default,,0,0,0,,Lúc hai anh em phải chia xa,
Dialogue: 0,0:03:34.13,0:03:35.30,Default,,0,0,0,,lòng tôi đau thắt lại.
Dialogue: 0,0:03:35.80,0:03:38.68,Default,,0,0,0,,Thật là một câu chuyện cảm động.\NĐúng không, Ông chủ?
Dialogue: 0,0:03:40.05,0:03:42.34,Default,,0,0,0,,Thế giờ em trai ông đang ở đâu rồi?
Dialogue: 0,0:03:42.97,0:03:46.22,Default,,0,0,0,,Sau khi bố mẹ ly hôn,\Ntôi bặt vô âm tín của thằng bé.
Dialogue: 0,0:03:47.31,0:03:50.27,Default,,0,0,0,,Đáng tiếc là,\Nmấy chục năm nay tôi chưa từng gặp lại nó.
Dialogue: 0,0:03:56.24,0:03:58.12,Default,,0,0,0,,- Chào đằng ấy.\N- Kính chào quý khách.
Dialogue: 0,0:03:58.66,0:03:59.87,Default,,0,0,0,,Cho một chai bia khai vị trước nhé.
Dialogue: 0,0:04:00.45,0:04:01.28,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:04:03.79,0:04:04.75,Default,,0,0,0,,Này, Ông chủ.
Dialogue: 0,0:04:05.33,0:04:06.46,Default,,0,0,0,,Tôi nghĩ ta có thể nhìn thấu
Dialogue: 0,0:04:06.54,0:04:09.21,Default,,0,0,0,,bản chất thật của một con người\Nqua cái cách họ chia tay đấy.
Dialogue: 0,0:04:10.38,0:04:11.21,Default,,0,0,0,,Bia của anh đây.
Dialogue: 0,0:04:12.92,0:04:13.96,Default,,0,0,0,,Có chuyện gì thế anh?
Dialogue: 0,0:04:14.67,0:04:16.51,Default,,0,0,0,,Bạn tôi đang làm thủ tục ly hôn.
Dialogue: 0,0:04:16.59,0:04:19.89,Default,,0,0,0,,Hai vợ chồng đang cãi nhau ầm ĩ\Nchỉ vì tranh quyền nuôi con thỏ cưng.
Dialogue: 0,0:04:20.55,0:04:22.97,Default,,0,0,0,,- Đùn đẩy cho nhau à?\N- Không, ngược lại ấy chứ.
Dialogue: 0,0:04:23.35,0:04:24.64,Default,,0,0,0,,Cả hai bên đều nằng nặc đòi nuôi.
Dialogue: 0,0:04:25.72,0:04:28.01,Default,,0,0,0,,- Cứ như con nít ấy nhỉ.\N- Thế mới nói.
Dialogue: 0,0:04:28.10,0:04:29.89,Default,,0,0,0,,Chẳng bên nào chịu nhường bên nào.
Dialogue: 0,0:04:31.06,0:04:33.94,Default,,0,0,0,,Dưới góc độ pháp luật,\Nthú cưng được coi là tài sản.
Dialogue: 0,0:04:34.32,0:04:38.20,Default,,0,0,0,,Bên nào muốn giữ thú cưng thì\Nphải từ bỏ các tài sản khác,
Dialogue: 0,0:04:38.28,0:04:40.16,Default,,0,0,0,,hoặc bồi hoàn tiền cho bên kia.
Dialogue: 0,0:04:40.24,0:04:42.33,Default,,0,0,0,,Hầu hết các vụ việc đều được giải quyết như vậy.
Dialogue: 0,0:04:42.41,0:04:44.91,Default,,0,0,0,,Thật thế ạ? Giờ tôi mới biết đấy.
Dialogue: 0,0:04:46.49,0:04:48.53,Default,,0,0,0,,Xin lỗi vì đã đường đột chen ngang câu chuyện.
Dialogue: 0,0:04:49.75,0:04:50.58,Default,,0,0,0,,Tôi là...
Dialogue: 0,0:04:51.25,0:04:52.58,Default,,0,0,0,,Nakatsuka.
Dialogue: 0,0:04:53.17,0:04:55.88,Default,,0,0,0,,LUẬT SƯ\NNAKATSUKA YUKIO
Dialogue: 0,0:04:55.96,0:04:57.25,Default,,0,0,0,,Bác là luật sư sao ạ?
Dialogue: 0,0:05:02.22,0:05:03.89,Default,,0,0,0,,Văn phòng của bác ở gần đây ư?
Dialogue: 0,0:05:04.60,0:05:06.44,Default,,0,0,0,,Bác mở ở đây lâu chưa?
Dialogue: 0,0:05:07.18,0:05:08.97,Default,,0,0,0,,Vâng. Được 35 năm rồi.
Dialogue: 0,0:05:09.06,0:05:10.77,Default,,0,0,0,,Ba mươi lăm năm? Giỏi thật đấy!
Dialogue: 0,0:05:11.31,0:05:14.81,Default,,0,0,0,,Nhưng tháng sau tôi sẽ đóng cửa văn phòng.
Dialogue: 0,0:05:15.73,0:05:16.61,Default,,0,0,0,,Tôi có thể mạn phép hỏi lý do được không?
Dialogue: 0,0:05:18.19,0:05:20.78,Default,,0,0,0,,Vì thời thế thay đổi rồi.
Dialogue: 0,0:05:22.16,0:05:24.91,Default,,0,0,0,,"Người lính già rồi cũng sẽ lùi vào dĩ vãng."
Dialogue: 0,0:05:34.04,0:05:37.71,Default,,0,0,0,,Tại khu tập thể công cộng của thành phố\Nsắp bị dỡ bỏ vào tháng Một tới,
Dialogue: 0,0:05:37.80,0:05:40.60,Default,,0,0,0,,các cán bộ chính quyền đang cố gắng thuyết phục
Dialogue: 0,0:05:40.72,0:05:44.35,Default,,0,0,0,,một cư dân kiên quyết không chịu di dời\Nngồi vào bàn đàm phán.
Dialogue: 0,0:05:51.18,0:05:53.27,Default,,0,0,0,,Ông Ishibashi. Xin ông đấy. Ông Ishibashi.
Dialogue: 0,0:05:53.35,0:05:54.52,Default,,0,0,0,,Xin ông mở cửa cho.
Dialogue: 0,0:05:54.85,0:05:55.85,Default,,0,0,0,,Biến đi!
Dialogue: 0,0:05:57.44,0:05:59.69,Default,,0,0,0,,Xin ông hãy bình tĩnh lại, ông Ishibashi.
Dialogue: 0,0:06:01.82,0:06:02.95,Default,,0,0,0,,Đây là nhà của tôi!
Dialogue: 0,0:06:03.36,0:06:08.53,Default,,0,0,0,,Người mẹ quá cố và tôi đã vất vả bao năm\Nmới giữ được nó!
Dialogue: 0,0:06:09.08,0:06:13.46,Default,,0,0,0,,Không kẻ nào được phép cướp nó khỏi tay tôi!
Dialogue: 0,0:06:14.04,0:06:17.29,Default,,0,0,0,,Các cán bộ chính quyền cho biết\Ncông tác phá dỡ sẽ sớm bắt đầu--
Dialogue: 0,0:06:18.88,0:06:21.38,Default,,0,0,0,,Tôi đã phân loại xong\Ntoàn bộ tài liệu tài chính rồi nhé.
Dialogue: 0,0:06:21.46,0:06:24.59,Default,,0,0,0,,Bác xem nốt phần còn lại để quyết định\Nxem tài liệu nào mang về nhà,
Dialogue: 0,0:06:25.18,0:06:27.06,Default,,0,0,0,,còn tài liệu nào thì tiêu hủy.
Dialogue: 0,0:06:29.18,0:06:30.10,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:06:31.39,0:06:34.56,Default,,0,0,0,,Biện pháp cưỡng chế hành chính có thể\Nsẽ là một phương án--
Dialogue: 0,0:06:37.69,0:06:38.86,Default,,0,0,0,,Cút hết đi!
Dialogue: 0,0:06:39.44,0:06:41.90,Default,,0,0,0,,- Cảm ơn vì bữa ăn nhé.\N- Cảm ơn quý khách đã ghé quán.
Dialogue: 0,0:06:46.36,0:06:48.24,Default,,0,0,0,,Tôi vừa thấy vụ đó trên bản tin thời sự tối nay.
Dialogue: 0,0:06:49.28,0:06:52.41,Default,,0,0,0,,Chính quyền sẽ áp dụng\Nbiện pháp cưỡng chế hành chính thôi.
Dialogue: 0,0:06:52.50,0:06:54.04,Default,,0,0,0,,Chỉ là vấn đề thời gian.
Dialogue: 0,0:06:54.16,0:06:55.12,Default,,0,0,0,,Tôi cũng nghĩ vậy.
Dialogue: 0,0:06:55.54,0:06:57.00,Default,,0,0,0,,Hai người đang bàn chuyện gì thế?
Dialogue: 0,0:06:57.38,0:06:59.97,Default,,0,0,0,,Để xây sân vận động Olympic,
Dialogue: 0,0:07:00.04,0:07:03.04,Default,,0,0,0,,người ta phải phá dỡ\Nmột khu chung cư cũ của thành phố.
Dialogue: 0,0:07:03.42,0:07:06.17,Default,,0,0,0,,Có một ông lão kiên quyết không dọn đi\Nvà đang làm loạn lên.
Dialogue: 0,0:07:06.59,0:07:07.97,Default,,0,0,0,,Bác Chu, bác chưa nghe tin đó à?
Dialogue: 0,0:07:08.34,0:07:12.01,Default,,0,0,0,,Ông lão đó khó chịu lắm, cứ đứng trên\Nchửi bới sa sả vào mặt cán bộ chính quyền.
Dialogue: 0,0:07:12.10,0:07:15.10,Default,,0,0,0,,Điện bị cắt, gas cũng cắt.\NThế mà ông ta vẫn bám trụ một mình ở đó.
Dialogue: 0,0:07:15.31,0:07:17.90,Default,,0,0,0,,Nhưng đó là chung cư công thuộc sở hữu thành phố,\Nđúng không?
Dialogue: 0,0:07:18.06,0:07:19.56,Default,,0,0,0,,Ông ta đâu có quyền sở hữu mảnh đất ấy.
Dialogue: 0,0:07:19.90,0:07:22.61,Default,,0,0,0,,Sớm muộn gì cũng phải dọn đi thôi.
Dialogue: 0,0:07:23.11,0:07:25.07,Default,,0,0,0,,Chắc hẳn nơi đó có ý nghĩa đặc biệt với ông ấy.
Dialogue: 0,0:07:25.61,0:07:27.65,Default,,0,0,0,,Anh không thấy chút xót thương nào sao?
Dialogue: 0,0:07:29.03,0:07:30.32,Default,,0,0,0,,- Thì cũng có, nhưng mà...\N- Của ông đây.
Dialogue: 0,0:07:30.41,0:07:32.29,Default,,0,0,0,,- Mời ông dùng thịt giăm bông chiên xù.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:07:33.87,0:07:36.29,Default,,0,0,0,,Giăm bông tẩm bột chiên xù hả?\NĐúng là một món ăn xưa cũ hoài niệm.
Dialogue: 0,0:07:37.21,0:07:41.21,Default,,0,0,0,,Hồi bé tôi hay ăn món này ở tiệm thịt đầu ngõ lắm.
Dialogue: 0,0:07:42.46,0:07:46.13,Default,,0,0,0,,Hồi đó tình làng nghĩa xóm ấm áp biết bao.\NÔi, những ngày tháng tươi đẹp.
Dialogue: 0,0:07:46.51,0:07:49.56,Default,,0,0,0,,Thôi đi bác Chu. Đừng có hoài cổ quá như thế.
Dialogue: 0,0:07:50.64,0:07:52.52,Default,,0,0,0,,Cô em còn trẻ quá, chưa hiểu được đâu.
Dialogue: 0,0:07:53.97,0:07:55.31,Default,,0,0,0,,Cứ mãi tôn sùng quá khứ,
Dialogue: 0,0:07:55.39,0:07:59.81,Default,,0,0,0,,thì làm sao vui nổi với hiện tại\Nvà tương lai, những thứ quan trọng hơn chứ.
Dialogue: 0,0:08:01.23,0:08:02.69,Default,,0,0,0,,Cô nói đúng đấy.
Dialogue: 0,0:08:03.48,0:08:05.23,Default,,0,0,0,,Cô gái trẻ nói hoàn toàn chính xác.
Dialogue: 0,0:08:07.40,0:08:08.44,Default,,0,0,0,,Cô gái trẻ cơ đấy?
Dialogue: 0,0:08:56.91,0:08:58.25,Default,,0,0,0,,Khi người ta kết thúc một ngày
Dialogue: 0,0:08:58.41,0:09:00.41,Default,,0,0,0,,và vội vã trở về nhà.
Dialogue: 0,0:09:02.25,0:09:05.46,Default,,0,0,0,,Nhưng đôi khi họ lại chẳng muốn\Nvề thẳng nhà ngay,
Dialogue: 0,0:09:06.17,0:09:08.42,Default,,0,0,0,,thế là họ ghé vào một chốn nào đó\Ntrên đường về.
Dialogue: 0,0:09:10.13,0:09:11.34,Default,,0,0,0,,Mời anh xơi một miếng.
Dialogue: 0,0:09:11.76,0:09:13.26,Default,,0,0,0,,Cảm ơn ông.
Dialogue: 0,0:09:13.47,0:09:15.43,Default,,0,0,0,,Tôi không dám nhận lòng tốt này đâu.
Dialogue: 0,0:09:15.51,0:09:17.18,Default,,0,0,0,,Anh biếu tôi nguyên cả quả dưa lưới thế này,
Dialogue: 0,0:09:17.52,0:09:19.36,Default,,0,0,0,,một mình tôi làm sao ăn hết nổi.
Dialogue: 0,0:09:33.61,0:09:35.86,Default,,0,0,0,,Tôi đã một mình lèo lái cái văn phòng luật nhỏ này.
Dialogue: 0,0:09:36.70,0:09:38.95,Default,,0,0,0,,Tôi tin là mình đã làm việc hết sức tận tụy,
Dialogue: 0,0:09:40.25,0:09:43.59,Default,,0,0,0,,nhưng lượng thân chủ tìm đến\Nngày càng giảm sút thê thảm.
Dialogue: 0,0:09:44.21,0:09:46.88,Default,,0,0,0,,Ông đã gắn bó với nghề suốt 35 năm.
Dialogue: 0,0:09:47.80,0:09:49.18,Default,,0,0,0,,Đó là một thành tựu đáng nể đấy chứ.
Dialogue: 0,0:09:49.46,0:09:52.21,Default,,0,0,0,,Tôi mở văn phòng này cùng với vợ mình.
Dialogue: 0,0:09:53.26,0:09:54.76,Default,,0,0,0,,Hai năm trước,
Dialogue: 0,0:09:55.22,0:09:56.76,Default,,0,0,0,,bà ấy đã qua đời.
Dialogue: 0,0:09:58.06,0:10:02.48,Default,,0,0,0,,Tôi nghĩ ngọn lửa nhiệt huyết trong mình\Ncũng nguội lạnh từ dạo đó.
Dialogue: 0,0:10:04.69,0:10:06.11,Default,,0,0,0,,Hôm nay ông có muốn dùng giăm bông chiên xù không?
Dialogue: 0,0:10:07.32,0:10:08.15,Default,,0,0,0,,Thôi đợi chút đã.
Dialogue: 0,0:10:08.57,0:10:09.95,Default,,0,0,0,,Tối nay tôi không ăn đâu.
Dialogue: 0,0:10:10.78,0:10:11.62,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:10:12.19,0:10:13.23,Default,,0,0,0,,Hôm nay là một ngày khác lạ nhỉ?
Dialogue: 0,0:10:15.82,0:10:18.28,Default,,0,0,0,,Tôi đã tìm thấy đứa em trai của mình rồi.
Dialogue: 0,0:10:19.83,0:10:20.75,Default,,0,0,0,,Thật thế sao?
Dialogue: 0,0:10:21.29,0:10:22.58,Default,,0,0,0,,Tôi mừng cho ông quá.
Dialogue: 0,0:10:22.87,0:10:25.29,Default,,0,0,0,,Thằng bé sống ngay gần đây thôi.
Dialogue: 0,0:10:26.79,0:10:28.71,Default,,0,0,0,,- Thật ư? Thế thì--\N- Chưa được đâu.
Dialogue: 0,0:10:29.50,0:10:31.63,Default,,0,0,0,,Tôi khao khát được gặp lại nó vô cùng,
Dialogue: 0,0:10:32.59,0:10:35.18,Default,,0,0,0,,nhưng đến khoảnh khắc ấy,\Ntôi lại thấy chùn bước và sợ hãi.
Dialogue: 0,0:10:36.51,0:10:37.60,Default,,0,0,0,,Sao lại thế hả ông?
Dialogue: 0,0:10:38.76,0:10:39.59,Default,,0,0,0,,Hôm nọ,
Dialogue: 0,0:10:40.22,0:10:42.26,Default,,0,0,0,,tôi có kể về trò cờ Othello rồi, đúng không?
Dialogue: 0,0:10:42.68,0:10:43.51,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:43.93,0:10:47.02,Default,,0,0,0,,Ông chơi cược với em trai\Nlấy thịt giăm bông chiên xù.
Dialogue: 0,0:10:48.61,0:10:50.49,Default,,0,0,0,,Lần nào tôi cũng thắng,
Dialogue: 0,0:10:50.98,0:10:54.73,Default,,0,0,0,,và bắt thằng bé phải chi tiền\Nmua thịt giăm bông chiên xù.
Dialogue: 0,0:10:55.86,0:10:58.70,Default,,0,0,0,,Thằng bé tiêu hết sạch tiền tiêu vặt,
Dialogue: 0,0:10:59.49,0:11:00.95,Default,,0,0,0,,rồi đi tống tiền
Dialogue: 0,0:11:01.95,0:11:03.66,Default,,0,0,0,,một bạn cùng lớp.
Dialogue: 0,0:11:05.75,0:11:07.79,Default,,0,0,0,,Khi nhà trường phát hiện ra,
Dialogue: 0,0:11:08.46,0:11:09.88,Default,,0,0,0,,họ đã tra hỏi thằng bé.
Dialogue: 0,0:11:11.13,0:11:14.59,Default,,0,0,0,,Nhưng nó không hề hé răng nửa lời\Nvề những ván cờ của hai đứa tôi.
Dialogue: 0,0:11:16.43,0:11:17.89,Default,,0,0,0,,Nó đã bao che cho tôi.
Dialogue: 0,0:11:19.39,0:11:20.27,Default,,0,0,0,,Tôi đoán...
Dialogue: 0,0:11:21.47,0:11:25.52,Default,,0,0,0,,nó không muốn làm phật lòng\Nngười anh trai mà nó vừa mới có được.
Dialogue: 0,0:11:30.11,0:11:31.78,Default,,0,0,0,,Bố tôi đã đánh nó một trận nhừ tử
Dialogue: 0,0:11:32.53,0:11:35.12,Default,,0,0,0,,để răn đe.
Dialogue: 0,0:11:36.95,0:11:38.16,Default,,0,0,0,,Tôi cảm thấy tội lỗi vô cùng.
Dialogue: 0,0:11:38.57,0:11:40.03,Default,,0,0,0,,Tất cả là tại tôi.
Dialogue: 0,0:11:42.03,0:11:44.53,Default,,0,0,0,,Tôi chỉ biết câm lặng đứng nhìn em trai mình...
Dialogue: 0,0:11:45.62,0:11:47.12,Default,,0,0,0,,bị đánh đòn đau đớn.
Dialogue: 0,0:11:50.08,0:11:52.92,Default,,0,0,0,,Tôi sợ bố tôi.
Dialogue: 0,0:11:54.92,0:11:56.88,Default,,0,0,0,,Tôi sợ rằng ông ấy cũng sẽ bỏ rơi tôi.
Dialogue: 0,0:11:57.93,0:11:59.22,Default,,0,0,0,,Y như người mẹ ruột của tôi vậy.
Dialogue: 0,0:12:02.97,0:12:03.97,Default,,0,0,0,,Đứa em trai của tôi...
Dialogue: 0,0:12:04.68,0:12:06.68,Default,,0,0,0,,đã mỉm cười nhìn tôi
Dialogue: 0,0:12:07.27,0:12:08.73,Default,,0,0,0,,khi ánh mắt hai đứa chạm nhau,
Dialogue: 0,0:12:09.40,0:12:10.94,Default,,0,0,0,,ngay giữa lúc thằng bé đang bị đòn roi trút xuống.
Dialogue: 0,0:12:12.23,0:12:13.15,Default,,0,0,0,,Như thể nó muốn nhắn nhủ với tôi rằng:
Dialogue: 0,0:12:13.77,0:12:15.15,Default,,0,0,0,,"Em không sao đâu anh."
Dialogue: 0,0:12:19.45,0:12:22.08,Default,,0,0,0,,Nỗi cắn rứt ấy vẫn đeo bám ông suốt bấy lâu, đúng không?
Dialogue: 0,0:12:23.24,0:12:24.24,Default,,0,0,0,,Phải...
Dialogue: 0,0:12:25.08,0:12:26.67,Default,,0,0,0,,nỗi ân hận trong lòng tôi
Dialogue: 0,0:12:27.37,0:12:29.25,Default,,0,0,0,,như một cái gai đâm vào kẽ móng, chẳng có gì to tát.
Dialogue: 0,0:12:34.55,0:12:35.89,Default,,0,0,0,,Nhưng người ta vẫn bảo...
Dialogue: 0,0:12:36.38,0:12:37.97,Default,,0,0,0,,rằng vết thương nhỏ không lành\Ncó thể biến thành uốn ván đấy.
Dialogue: 0,0:12:38.34,0:12:40.59,Default,,0,0,0,,nếu như ta cứ để mặc nó.
Dialogue: 0,0:12:48.10,0:12:48.93,Default,,0,0,0,,Cút đi!
Dialogue: 0,0:12:50.31,0:12:51.73,Default,,0,0,0,,Biến đi cho khuất mắt tao, lũ khốn!
Dialogue: 0,0:12:51.81,0:12:52.98,Default,,0,0,0,,Đừng làm ông ấy kích động thêm nữa.
Dialogue: 0,0:12:53.06,0:12:54.15,Default,,0,0,0,,Cút ngay!
Dialogue: 0,0:12:56.44,0:12:58.28,Default,,0,0,0,,Chúng ta hãy ra đằng kia nói chuyện đi.
Dialogue: 0,0:13:09.87,0:13:11.12,Default,,0,0,0,,Mày là thằng chết giẫm nào thế hả?
Dialogue: 0,0:13:13.29,0:13:15.13,Default,,0,0,0,,Nếu anh không chịu đi, anh sẽ bị ướt sũng đấy.
Dialogue: 0,0:13:15.21,0:13:16.04,Default,,0,0,0,,Kenta.
Dialogue: 0,0:13:21.43,0:13:22.26,Default,,0,0,0,,Anh đây.
Dialogue: 0,0:13:25.64,0:13:26.93,Default,,0,0,0,,Lâu lắm rồi không gặp em.
Dialogue: 0,0:13:32.35,0:13:33.18,Default,,0,0,0,,Anh hai?
Dialogue: 0,0:13:42.74,0:13:45.87,Default,,0,0,0,,Thật sao? Giờ anh làm luật sư cơ à?
Dialogue: 0,0:13:46.20,0:13:47.62,Default,,0,0,0,,Em tự hào về anh lắm đấy.
Dialogue: 0,0:13:48.16,0:13:50.04,Default,,0,0,0,,Anh thi trượt chứng chỉ luật sư bao nhiêu lần,
Dialogue: 0,0:13:50.37,0:13:52.12,Default,,0,0,0,,có gì đáng để tự hào đâu em.
Dialogue: 0,0:13:52.41,0:13:55.21,Default,,0,0,0,,- Của hai vị đây.\N- Vẫn y hệt như những ngày xưa cũ.
Dialogue: 0,0:13:56.29,0:13:57.38,Default,,0,0,0,,Xin mời dùng bữa.
Dialogue: 0,0:14:08.06,0:14:09.31,Default,,0,0,0,,Ngon tuyệt cú mèo.
Dialogue: 0,0:14:16.02,0:14:18.98,Default,,0,0,0,,Em định bám trụ ở đó đến bao giờ nữa?
Dialogue: 0,0:14:23.03,0:14:24.32,Default,,0,0,0,,Sao anh lại hỏi thế?
Dialogue: 0,0:14:25.74,0:14:28.08,Default,,0,0,0,,Điện và gas\Nngười ta đều đã cắt hết rồi.
Dialogue: 0,0:14:28.20,0:14:30.29,Default,,0,0,0,,Sao em sống nổi ở đó chứ?
Dialogue: 0,0:14:32.58,0:14:33.50,Default,,0,0,0,,Kệ em đi.
Dialogue: 0,0:14:34.33,0:14:35.67,Default,,0,0,0,,Việc này không liên quan đến anh.
Dialogue: 0,0:14:36.46,0:14:38.96,Default,,0,0,0,,Họ sắp bắt đầu phá dỡ rồi.
Dialogue: 0,0:14:39.88,0:14:40.92,Default,,0,0,0,,Người ta sẽ...
Dialogue: 0,0:14:41.76,0:14:43.80,Default,,0,0,0,,dùng vũ lực để cưỡng chế em đấy.
Dialogue: 0,0:14:44.80,0:14:46.64,Default,,0,0,0,,Cứ việc. Em chẳng sợ đâu.
Dialogue: 0,0:14:48.14,0:14:50.23,Default,,0,0,0,,Cho dù có bị máy xúc\Ncào nát xác ra,
Dialogue: 0,0:14:50.31,0:14:51.77,Default,,0,0,0,,em cũng quyết không rời khỏi nơi đó.
Dialogue: 0,0:14:53.27,0:14:55.27,Default,,0,0,0,,Em vẫn bướng bỉnh y như ngày xưa nhỉ?
Dialogue: 0,0:14:59.90,0:15:00.94,Default,,0,0,0,,Đây là...?
Dialogue: 0,0:15:01.36,0:15:03.24,Default,,0,0,0,,Là bộ cờ ngày xưa anh em mình hay chơi đấy.
Dialogue: 0,0:15:03.94,0:15:04.90,Default,,0,0,0,,Anh vẫn giữ nó.
Dialogue: 0,0:15:06.28,0:15:08.91,Default,,0,0,0,,Ông chủ, tôi mở ra ở đây được chứ?
Dialogue: 0,0:15:11.16,0:15:12.04,Default,,0,0,0,,Cứ tự nhiên đi ông.
Dialogue: 0,0:15:16.96,0:15:19.67,Default,,0,0,0,,Em thấy sao? Muốn làm một ván không?
Dialogue: 0,0:15:23.01,0:15:23.97,Default,,0,0,0,,Chơi cược cái gì nào?
Dialogue: 0,0:15:25.22,0:15:26.47,Default,,0,0,0,,Nếu em thắng,
Dialogue: 0,0:15:26.72,0:15:29.39,Default,,0,0,0,,anh sẽ mua cho em\Nbao nhiêu miếng giăm bông chiên xù tùy thích.
Dialogue: 0,0:15:30.10,0:15:31.02,Default,,0,0,0,,Cả bia nữa.
Dialogue: 0,0:15:32.81,0:15:34.15,Default,,0,0,0,,Còn nếu anh thắng,
Dialogue: 0,0:15:34.89,0:15:36.68,Default,,0,0,0,,em phải dọn khỏi khu tập thể đó.
Dialogue: 0,0:15:42.94,0:15:47.15,Default,,0,0,0,,Nơi đó không còn là chỗ ở\Nthích hợp cho em nữa rồi.
Dialogue: 0,0:15:52.79,0:15:54.08,Default,,0,0,0,,Được thôi. Em sẽ đè bẹp anh cho xem.
Dialogue: 0,0:15:54.66,0:15:55.62,Default,,0,0,0,,Anh hai,
Dialogue: 0,0:15:56.41,0:15:57.75,Default,,0,0,0,,tay nghề em giờ đỉnh hơn xưa nhiều rồi.
Dialogue: 0,0:15:59.38,0:16:00.67,Default,,0,0,0,,Để rồi xem.
Dialogue: 0,0:16:07.42,0:16:11.01,Default,,0,0,0,,Sau này lớn lên, em sẽ làm giàu\Nvà xây một căn nhà thật to.
Dialogue: 0,0:16:11.64,0:16:12.64,Default,,0,0,0,,Rồi đón mẹ về ở cùng.
Dialogue: 0,0:16:13.06,0:16:14.73,Default,,0,0,0,,Anh hai cũng đến ở với em nhé.
Dialogue: 0,0:16:15.06,0:16:17.02,Default,,0,0,0,,Bố thì không được đâu, vì ông ấy hay đánh mẹ.
Dialogue: 0,0:16:33.33,0:16:36.42,Default,,0,0,0,,Tốt lắm. Anh thắng rồi. Đi mua như mọi khi đi.
Dialogue: 0,0:16:36.50,0:16:39.71,Default,,0,0,0,,Cho em gỡ ván nữa đi mà.\NNếu thua ván nữa em sẽ đi mua.
Dialogue: 0,0:16:39.79,0:16:42.96,Default,,0,0,0,,- Đi mà anh.\N- Không được. Khóc lóc không xóa được trận thua đâu.
Dialogue: 0,0:16:43.21,0:16:45.80,Default,,0,0,0,,Được rồi. Em đi mua chứ gì?
Dialogue: 0,0:16:46.17,0:16:47.88,Default,,0,0,0,,Dù sao ván sau em cũng sẽ thắng cho xem.
Dialogue: 0,0:16:48.63,0:16:50.92,Default,,0,0,0,,Nước này... rồi đến nước này.
Dialogue: 0,0:16:52.85,0:16:56.73,Default,,0,0,0,,Căn nhà ngày xưa mình ở\Ncòn đó không anh?
Dialogue: 0,0:16:57.56,0:16:58.94,Default,,0,0,0,,Không. Bị phá đi rồi.
Dialogue: 0,0:16:59.73,0:17:01.86,Default,,0,0,0,,Giờ người ta xây một tòa nhà cao tầng ở đó.
Dialogue: 0,0:17:02.44,0:17:03.69,Default,,0,0,0,,Em hiểu rồi.
Dialogue: 0,0:17:05.11,0:17:08.45,Default,,0,0,0,,Tại sao căn hộ đó\Nlại quan trọng với em đến vậy?
Dialogue: 0,0:17:10.70,0:17:12.87,Default,,0,0,0,,Em đã sống ở đó gần như cả cuộc đời mình.
Dialogue: 0,0:17:13.95,0:17:15.16,Default,,0,0,0,,Mẹ đã qua đời tại nơi đó.
Dialogue: 0,0:17:15.58,0:17:17.12,Default,,0,0,0,,Em cũng sẽ nhắm mắt xuôi tay ở đó.
Dialogue: 0,0:17:18.87,0:17:20.20,Default,,0,0,0,,Em chẳng thay đổi chút nào cả.
Dialogue: 0,0:17:20.29,0:17:23.59,Default,,0,0,0,,Chơi cờ mà chẳng có chút\Nchiến thuật nào hết.
Dialogue: 0,0:17:25.25,0:17:27.63,Default,,0,0,0,,Mấy ván thắng cỏn con em thèm vào.
Dialogue: 0,0:17:29.01,0:17:31.60,Default,,0,0,0,,Em vẫn còn cơ hội\Nlội ngược dòng để giành chiến thắng đấy.
Dialogue: 0,0:17:39.85,0:17:40.77,Default,,0,0,0,,Thôi chết rồi...
Dialogue: 0,0:17:41.60,0:17:43.31,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:18:05.04,0:18:06.12,Default,,0,0,0,,Em phải bỏ lượt sao?
Dialogue: 0,0:18:11.42,0:18:12.25,Default,,0,0,0,,Nhìn này.
Dialogue: 0,0:18:21.85,0:18:23.39,Default,,0,0,0,,Anh thua rồi.
Dialogue: 0,0:18:26.27,0:18:28.90,Default,,0,0,0,,Anh hai sao thế hả?
Dialogue: 0,0:18:29.32,0:18:30.95,Default,,0,0,0,,Già rồi nên lú lẫn rồi sao anh?
Dialogue: 0,0:18:32.32,0:18:34.82,Default,,0,0,0,,Ông chủ ơi, cho thêm bia nhé.
Dialogue: 0,0:18:34.91,0:18:36.50,Default,,0,0,0,,- Hai chai nữa.\N- Có ngay.
Dialogue: 0,0:18:38.33,0:18:40.62,Default,,0,0,0,,Phiền ông quá, để tôi tự lấy cho.
Dialogue: 0,0:18:44.37,0:18:45.29,Default,,0,0,0,,Để em khui nắp cho.
Dialogue: 0,0:18:46.00,0:18:47.84,Default,,0,0,0,,Ông chủ, ông có muốn uống một ly bia không?
Dialogue: 0,0:18:48.75,0:18:50.09,Default,,0,0,0,,- Mời Ông chủ nhé?\N- Nhưng mà...
Dialogue: 0,0:18:51.05,0:18:52.93,Default,,0,0,0,,- Cứ tự nhiên đi.\N- Anh xin lỗi em nhiều lắm.
Dialogue: 0,0:18:54.30,0:18:55.64,Default,,0,0,0,,Anh làm gì thế này?
Dialogue: 0,0:18:55.97,0:18:58.72,Default,,0,0,0,,"Khóc lóc không xóa được trận thua đâu."\NChẳng phải anh luôn miệng nói thế sao.
Dialogue: 0,0:18:59.35,0:19:02.56,Default,,0,0,0,,Anh đã chỉ trơ mắt đứng nhìn\Ntrong lúc bố trút giận lên người em.
Dialogue: 0,0:19:02.89,0:19:03.98,Default,,0,0,0,,Anh thực sự xin lỗi em.
Dialogue: 0,0:19:09.77,0:19:12.52,Default,,0,0,0,,Chuyện từ kiếp nào rồi.\NEm đã quên sạch từ lâu rồi.
Dialogue: 0,0:19:14.24,0:19:16.20,Default,,0,0,0,,Anh sẽ đứng ra đàm phán với chính quyền,
Dialogue: 0,0:19:16.28,0:19:18.07,Default,,0,0,0,,và đòi cho em mức tiền đền bù tốt nhất
Dialogue: 0,0:19:18.16,0:19:20.12,Default,,0,0,0,,để đổi lấy việc chuyển khỏi khu chung cư đó.
Dialogue: 0,0:19:20.53,0:19:21.87,Default,,0,0,0,,Anh là luật sư mà.
Dialogue: 0,0:19:22.33,0:19:24.21,Default,,0,0,0,,Hãy để anh được làm những gì có thể.
Dialogue: 0,0:19:24.75,0:19:26.71,Default,,0,0,0,,Kìa anh. Rõ ràng là em thắng mà.
Dialogue: 0,0:19:27.46,0:19:29.00,Default,,0,0,0,,Anh em mình đâu có giao kèo như thế.
Dialogue: 0,0:19:29.08,0:19:31.12,Default,,0,0,0,,Anh đã tìm sẵn cho em một nơi ở mới rồi.
Dialogue: 0,0:19:31.80,0:19:34.05,Default,,0,0,0,,Tuy nó nhỏ hơn chỗ ở hiện tại của em,
Dialogue: 0,0:19:34.13,0:19:36.55,Default,,0,0,0,,nhưng sạch sẽ, ngăn nắp và chan hòa ánh nắng.
Dialogue: 0,0:19:36.80,0:19:37.97,Default,,0,0,0,,Tiền thuê nhà lại rất rẻ nữa.
Dialogue: 0,0:19:38.72,0:19:41.56,Default,,0,0,0,,Nếu em không ưng, anh có thể tìm chỗ khác.
Dialogue: 0,0:19:42.85,0:19:45.64,Default,,0,0,0,,Hoặc em có thể về ở cùng với anh...
Dialogue: 0,0:19:46.73,0:19:49.52,Default,,0,0,0,,nếu em không thấy phiền.
Dialogue: 0,0:19:50.56,0:19:52.15,Default,,0,0,0,,Dù sao nhà anh cũng còn phòng trống.
Dialogue: 0,0:19:52.61,0:19:54.74,Default,,0,0,0,,Cả hai anh em mình đều sống độc thân.
Dialogue: 0,0:19:55.74,0:19:58.83,Default,,0,0,0,,Cùng nhau trải qua tuổi già bình lặng bên nhau,\Nchẳng phải cũng tốt sao?
Dialogue: 0,0:19:59.24,0:20:01.37,Default,,0,0,0,,Thi thoảng hai anh em mình lại chơi cờ Othello.
Dialogue: 0,0:20:02.12,0:20:03.12,Default,,0,0,0,,Đồ ngốc này!
Dialogue: 0,0:20:10.25,0:20:12.38,Default,,0,0,0,,Đừng có nuông chiều em quá.
Dialogue: 0,0:20:19.38,0:20:20.72,Default,,0,0,0,,Cứ suy nghĩ kỹ đi nhé.
Dialogue: 0,0:20:35.36,0:20:37.57,Default,,0,0,0,,- Hẹn gặp lại nhé.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:20:37.65,0:20:39.49,Default,,0,0,0,,- Chào anh nhé.\N- Này, anh hai.
Dialogue: 0,0:20:47.45,0:20:48.45,Default,,0,0,0,,Sau đó,
Dialogue: 0,0:20:48.96,0:20:52.21,Default,,0,0,0,,ông Nakatsuka đã đại diện đàm phán\Nvới chính quyền thành phố,
Dialogue: 0,0:20:52.71,0:20:55.76,Default,,0,0,0,,và đưa cả hai bên đi đến thống nhất\Nvề phương án giải quyết vụ việc.
Dialogue: 0,0:20:55.96,0:21:00.30,Default,,0,0,0,,Người em trai cuối cùng cũng đồng ý\Nrời khỏi khu tập thể đó.
Dialogue: 0,0:21:28.08,0:21:29.00,Default,,0,0,0,,Nghĩa là...
Dialogue: 0,0:21:30.46,0:21:34.01,Default,,0,0,0,,Tôi đã dọn dẹp nhà cửa sẵn sàng\Nđể đón thằng bé về ở cùng.
Dialogue: 0,0:21:34.29,0:21:37.00,Default,,0,0,0,,Nhưng nó lại muốn chơi một canh bạc\Nlớn nhất trong cuộc đời mình
Dialogue: 0,0:21:37.50,0:21:41.05,Default,,0,0,0,,bằng số tiền đền bù giải tỏa đó.
Dialogue: 0,0:21:45.76,0:21:47.76,Default,,0,0,0,,Và nó đã thắng đậm ở một sòng bạc,
Dialogue: 0,0:21:47.85,0:21:50.10,Default,,0,0,0,,rồi tậu hẳn một căn biệt thự\Ncó bể bơi ở nước ngoài.
Dialogue: 0,0:21:50.18,0:21:51.52,Default,,0,0,0,,Thật không thể tin nổi.
Dialogue: 0,0:21:52.48,0:21:53.48,Default,,0,0,0,,Giờ thằng bé lại muốn...
Dialogue: 0,0:21:54.15,0:21:57.82,Default,,0,0,0,,tôi sang bên đó\Nở cùng với nó.
Dialogue: 0,0:21:58.57,0:21:59.57,Default,,0,0,0,,Thế ông có định đi không?
Dialogue: 0,0:22:01.57,0:22:03.16,Default,,0,0,0,,- Chào mọi người.\N- Kính chào quý khách.
Dialogue: 0,0:22:03.24,0:22:06.08,Default,,0,0,0,,Luật sư Nakatsuka ơi, về cái vụ hôm trước...
Dialogue: 0,0:22:06.91,0:22:08.58,Default,,0,0,0,,Tôi có mang ít tài liệu qua đây này.
Dialogue: 0,0:22:09.16,0:22:11.12,Default,,0,0,0,,Bạn tôi đang vướng vào chuyện nợ nần cá nhân,
Dialogue: 0,0:22:11.20,0:22:13.37,Default,,0,0,0,,nên tôi muốn nhờ luật sư Nakatsuka\Ntư vấn giúp đôi điều.
Dialogue: 0,0:22:13.79,0:22:18.25,Default,,0,0,0,,Dù đã đóng cửa văn phòng,\Nnhưng tôi vẫn giữ chứng chỉ hành nghề.
Dialogue: 0,0:22:19.05,0:22:21.43,Default,,0,0,0,,Tôi vẫn có thể làm việc được mà.
Dialogue: 0,0:22:25.72,0:22:27.01,Default,,0,0,0,,Để xem nào...
Dialogue: 0,0:22:27.68,0:22:28.85,Default,,0,0,0,,Tài liệu ở chỗ này đây.
Dialogue: 0,0:22:29.35,0:22:32.73,Default,,0,0,0,,Đây là phần mục lục.
Dialogue: 0,0:22:32.81,0:22:35.65,Default,,0,0,0,,Cả hai người cùng xem kỹ nhé.
Dialogue: 0,0:22:44.24,0:22:45.95,Default,,0,0,0,,Khi làm món thịt giăm bông tẩm bột chiên xù,
Dialogue: 0,0:22:46.03,0:22:49.37,Default,,0,0,0,,điều quan trọng nhất là phải đảm bảo\Nlớp bột mì không bị vón cục.
Dialogue: 0,0:22:49.95,0:22:52.83,Default,,0,0,0,,Lăn qua lớp bột chiên xù thật đều tay\Nvà ấn nhẹ cho dính chặt.
Dialogue: 0,0:22:52.91,0:22:54.20,Default,,0,0,0,,Mời quý khách thưởng thức.
Dialogue: 0,0:22:57.46,0:22:59.30,Default,,0,0,0,,Bí quyết tốt nhất để giành chiến thắng là gì vậy?
Dialogue: 0,0:22:59.50,0:23:00.46,Default,,0,0,0,,Tôi chịu thôi.
Dialogue: 0,0:23:49.09,0:23:53.97,Default,,0,0,0,,CÂU CHUYỆN NÀY LÀ HƯ CẤU
