Dialogue: 0,0:00:10.02,0:00:14.26,Default,,0,0,0,,KOBAYASHI KAORU
Dialogue: 0,0:00:15.76,0:00:20.03,Default,,0,0,0,,TANIMURA MITSUKI\NARATANI KIYOMI
Dialogue: 0,0:00:21.53,0:00:23.50,Default,,0,0,0,,UNO SHOHEI
Dialogue: 0,0:00:23.50,0:00:33.08,Default,,0,0,0,,Kimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Làn hơi trắng em thở ra, giờ đây chầm chậm cưỡi lên làn gió{\i0}
Dialogue: 0,0:00:33.60,0:00:43.64,Default,,0,0,0,,Sora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi dần dần tan biến{\i0}
Dialogue: 0,0:00:43.64,0:00:53.53,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ bầu trời cao vời vợi, đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:53.53,0:00:58.65,Default,,0,0,0,,Kimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:00:58.65,0:01:03.78,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:01:03.78,0:01:04.39,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:01:04.39,0:01:06.16,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}\NZutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:06.16,0:01:13.86,Default,,0,0,0,,Zutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:14.73,0:01:25.50,Default,,0,0,0,,Kawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông{\i0}
Dialogue: 0,0:01:29.17,0:01:34.89,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa từ nửa đêm đến 7 giờ sáng.{\i0}
Dialogue: 0,0:01:34.89,0:01:38.71,Default,,0,0,0,,{\i1}Người ta thường gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:40.14,0:01:41.38,Default,,0,0,0,,[Phần Súp Miso Thịt Heo 600 yên, Bia 600 yên, Sake 500 yên, Shochu 400 yên,\NRượu bia chỉ phục vụ tối đa 3 phần mỗi người]
Dialogue: 0,0:01:41.38,0:01:43.79,Default,,0,0,0,,{\i1}Thực đơn của quán chỉ có vỏn vẹn bấy nhiêu món.{\i0}\N[Phần Súp Miso Thịt Heo 600 yên, Bia 600 yên, Sake 500 yên, Shochu 400 yên,\NRượu bia chỉ phục vụ tối đa 3 phần mỗi người]
Dialogue: 0,0:01:43.79,0:01:46.94,Default,,0,0,0,,{\i1}Nhưng nếu khách có gọi món gì\Nngoài những món này...{\i0}
Dialogue: 0,0:01:46.94,0:01:49.06,Default,,0,0,0,,{\i1}...chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:01:49.06,0:01:51.59,Default,,0,0,0,,{\i1}Phương châm buôn bán của tôi là vậy.{\i0}
Dialogue: 0,0:01:53.19,0:01:55.59,Default,,0,0,0,,[QUÁN CƠM ĐÊM - MESHIYA]
Dialogue: 0,0:01:55.59,0:02:00.36,Default,,0,0,0,,{\i1}Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?...\NThực ra là đông hơn bạn tưởng nhiều đấy.{\i0}
Dialogue: 0,0:02:02.45,0:02:11.03,Default,,0,0,0,,{\i1}Phụ đề Việt ngữ bởi Amtia(NOFACE):{\i0}\NSHINYA SHOKUDO - QUÁN ĂN ĐÊM (Phần 3)\NTập 4: "Tempura Gừng Đỏ Muối Chua..."
Dialogue: 0,0:02:11.50,0:02:13.53,Default,,0,0,0,,- Qua lọt không?\N- Từ từ thôi, chậm thôi...
Dialogue: 0,0:02:13.53,0:02:15.90,Default,,0,0,0,,- Rồi, lọt rồi.\N- Đã bảo chạy chậm lại mà!
Dialogue: 0,0:02:15.90,0:02:18.24,Default,,0,0,0,,- Tiến lên! Được rồi, được rồi...\N- Ổn chứ hả?
Dialogue: 0,0:02:18.24,0:02:20.56,Default,,0,0,0,,- Ừ, qua ngon lành rồi.\N- Cảm ơn nhé!
Dialogue: 0,0:02:30.48,0:02:33.78,Default,,0,0,0,,- Gặp lại sau nhé.\N- Cảm ơn đã xi-nhan giúp nhé!
Dialogue: 0,0:02:34.59,0:02:37.61,Default,,0,0,0,,Sao lần nào tên đó cũng cố lách xe qua cái hẻm này thế nhỉ?
Dialogue: 0,0:02:40.76,0:02:45.08,Default,,0,0,0,,Ngon tuyệt! Xem ra vẫn còn là mùa hè nhỉ?
Dialogue: 0,0:02:45.08,0:02:47.49,Default,,0,0,0,,Tiếng chuông gió nghe êm tai quá...
Dialogue: 0,0:02:47.62,0:02:51.21,Default,,0,0,0,,Sắp tới lễ hội mùa hè ở khu này rồi đúng không ạ?
Dialogue: 0,0:02:51.21,0:02:54.53,Default,,0,0,0,,Tụi em sẽ diện yukata* đến quán chơi nhé, Ông chủ!\N(*Kimono mùa hè mỏng nhẹ)
Dialogue: 0,0:02:56.01,0:02:57.70,Default,,0,0,0,,Ơ kìa, Ông chủ không thấy vui sao?
Dialogue: 0,0:02:58.94,0:03:01.60,Default,,0,0,0,,Chỉ là khói bếp làm cay mắt tôi thôi mà.
Dialogue: 0,0:03:03.60,0:03:06.24,Default,,0,0,0,,Cậu Komichi này, hôm nay trông sắc mặt cậu kém thế.
Dialogue: 0,0:03:06.24,0:03:08.27,Default,,0,0,0,,Mà thực ra lúc nào trông cậu chẳng phờ phạc như vậy...
Dialogue: 0,0:03:08.27,0:03:09.36,Default,,0,0,0,,Cậu ấy đang khổ tâm lắm đấy các cô ạ.
Dialogue: 0,0:03:09.36,0:03:11.39,Default,,0,0,0,,Hả? Bị xơ gan cổ trướng hả?
Dialogue: 0,0:03:11.39,0:03:14.88,Default,,0,0,0,,Hay là cậu cũng mắc phải căn bệnh\Ngiống hệt chị em tụi tôi rồi?
Dialogue: 0,0:03:14.88,0:03:18.68,Default,,0,0,0,,Đang tương tư ai hả? Với ai thế?\NNgười như thế nào? Lớn tuổi hơn hay trẻ hơn?
Dialogue: 0,0:03:18.82,0:03:21.12,Default,,0,0,0,,Cô nàng là nhân viên chính thức?\NHay là nhân viên hợp đồng?
Dialogue: 0,0:03:21.12,0:03:23.64,Default,,0,0,0,,Mấy cô đừng có đánh đồng chuyện tình cảm của người ta\Nvới mấy buổi xem mắt thực dụng của mấy cô chứ?
Dialogue: 0,0:03:23.64,0:03:27.66,Default,,0,0,0,,Bệnh của cậu chàng này nhìn thì giống nhưng bản chất khác hẳn đấy.
Dialogue: 0,0:03:28.08,0:03:30.56,Default,,0,0,0,,Chà, thế thì thứ lỗi cho tụi này nhé.
Dialogue: 0,0:03:31.13,0:03:37.08,Default,,0,0,0,,{\i1}Thực ra ngay từ đầu, Komichi đã\Ntìm đến nhờ tôi giúp một tay.{\i0}
Dialogue: 0,0:03:37.08,0:03:39.87,Default,,0,0,0,,Ý chị bảo "nhìn thì giống nhưng bản chất khác hẳn" là sao cơ?
Dialogue: 0,0:03:44.98,0:03:47.41,Default,,0,0,0,,Ngại quá Ông chủ ơi, lần nào cũng làm phiền anh giúp...
Dialogue: 0,0:03:48.33,0:03:51.60,Default,,0,0,0,,Ngày xưa hồi còn làm thêm ở một quầy hàng rong,\Ntôi cũng từng tự tay làm món này suốt.
Dialogue: 0,0:03:52.17,0:03:54.67,Default,,0,0,0,,Em có mua sẵn cả nguyên liệu đây rồi. Nhờ Ông chủ chế biến giúp nhé.
Dialogue: 0,0:03:54.67,0:03:56.70,Default,,0,0,0,,Không cần đâu. Trong bếp của tôi cũng có sẵn mà.
Dialogue: 0,0:03:56.70,0:03:59.00,Default,,0,0,0,,À, tất nhiên rồi nhỉ.
Dialogue: 0,0:04:01.03,0:04:04.08,Default,,0,0,0,,Em thấy sao hả Kasumi?\NÔng chủ ở đây làm món kushi-age (xiên que tẩm bột chiên) cũng đỉnh lắm đúng không?
Dialogue: 0,0:04:04.08,0:04:07.33,Default,,0,0,0,,Làm gì có thứ nào gọi là "kushi-age". Phải gọi là "kushi-katsu" chứ.
Dialogue: 0,0:04:07.33,0:04:12.42,Default,,0,0,0,,{\i1}Cô bé Kasumi thỉnh thoảng lại ghé quán tôi;\Ncô nàng là một cô gái chính gốc vùng Naniwa*.{\i0}\N(*Tên gọi cổ của vùng Osaka)
Dialogue: 0,0:04:12.42,0:04:15.54,Default,,0,0,0,,{\i1}Và đây chính là bóng hồng mà cậu chàng Komichi đang ngày đêm thương nhớ.{\i0}
Dialogue: 0,0:04:15.54,0:04:19.93,Default,,0,0,0,,À phải rồi. Ở Osaka người ta gọi món này là "kushi-katsu" nhỉ?
Dialogue: 0,0:04:19.93,0:04:22.25,Default,,0,0,0,,Đi khắp thiên hạ ở đâu người ta chẳng gọi là "kushi-katsu".
Dialogue: 0,0:04:22.25,0:04:25.27,Default,,0,0,0,,{\i1}Để lấy lòng người con gái mình thầm thương trộm nhớ...{\i0}
Dialogue: 0,0:04:25.27,0:04:29.22,Default,,0,0,0,,{\i1}...cậu ấy cất công đặt toàn đặc sản vùng Osaka cho cô nàng, thế nhưng...{\i0}
Dialogue: 0,0:04:30.49,0:04:34.65,Default,,0,0,0,,Mà công nhận mấy món kushi-age ở Tokyo làm ra vẻ sang chảnh thế thôi,\Nchứ ăn vào vị nào cũng y chang nhau.
Dialogue: 0,0:04:34.96,0:04:37.96,Default,,0,0,0,,Thì tất nhiên, nếu đem so với hương vị chính gốc...
Dialogue: 0,0:04:37.96,0:04:40.06,Default,,0,0,0,,Nhưng anh lại rất thích món kushi-age của Ông chủ làm.
Dialogue: 0,0:04:40.06,0:04:43.00,Default,,0,0,0,,Đã bảo là kushi-katsu cơ mà.
Dialogue: 0,0:04:43.00,0:04:45.67,Default,,0,0,0,,{\i1}Xem chừng hai người họ chẳng tìm được tiếng nói chung chút nào.{\i0}
Dialogue: 0,0:04:45.90,0:04:48.79,Default,,0,0,0,,Ái chà chà, bỏng mất!
Dialogue: 0,0:04:48.79,0:04:51.77,Default,,0,0,0,,Ông chú ăn uống cũng hậu đậu ghê nhỉ?
Dialogue: 0,0:04:54.86,0:04:57.58,Default,,0,0,0,,- Góc này hơi... Anh dịch giúp tôi chút nhé...\N- Ồ, được chứ.\N[Nhà thuốc - Khai trương lúc 9 giờ sáng]
Dialogue: 0,0:04:59.22,0:05:01.32,Default,,0,0,0,,Rồi, chuẩn bị chụp nhé...
Dialogue: 0,0:05:03.18,0:05:04.62,Default,,0,0,0,,Vâng.
Dialogue: 0,0:05:04.62,0:05:07.68,Default,,0,0,0,,Đẹp lắm ạ... Nhưng giám đốc có thể\Nmỉm cười tươi hơn một chút nữa được không?
Dialogue: 0,0:05:07.68,0:05:10.39,Default,,0,0,0,,- Cười tươi lên nhé.\N- Nào, chụp tiếp đây...
Dialogue: 0,0:05:16.65,0:05:19.65,Default,,0,0,0,,Ồ, cảm ơn, cảm ơn cậu nhiều nhé...
Dialogue: 0,0:05:21.41,0:05:23.83,Default,,0,0,0,,Ngại quá, đêm hôm khuya khoắt còn kéo cậu ra ngoài này!
Dialogue: 0,0:05:23.90,0:05:25.41,Default,,0,0,0,,Ồ, không sao đâu ạ. Giám đốc đừng bận tâm.
Dialogue: 0,0:05:25.41,0:05:27.93,Default,,0,0,0,,- Thế cái quán cậu nói nằm ở đâu?\N- Dạ, đi lối này thưa Giám đốc.
Dialogue: 0,0:05:27.93,0:05:30.47,Default,,0,0,0,,Ngay hướng này thôi ạ.
Dialogue: 0,0:05:30.47,0:05:31.53,Default,,0,0,0,,Khu này nhìn hay phết nhỉ.
Dialogue: 0,0:05:31.82,0:05:33.92,Default,,0,0,0,,Mời Giám đốc đi lối này ạ.\NGần tới nơi rồi.
Dialogue: 0,0:05:33.92,0:05:35.62,Default,,0,0,0,,Ờ... ồ, quán này hả?
Dialogue: 0,0:05:35.62,0:05:37.52,Default,,0,0,0,,Dạ không, quán bên này cơ ạ.
Dialogue: 0,0:05:38.02,0:05:41.69,Default,,0,0,0,,Ông Ide đây là giám đốc một chuỗi nhà thuốc lớn,\Nvừa mới mở thêm chi nhánh tiến quân vào thị trường Tokyo...
Dialogue: 0,0:05:41.69,0:05:44.33,Default,,0,0,0,,Giám đốc vừa thuê em chụp bộ ảnh\Nđể đăng lên tạp chí quảng cáo của công ty.
Dialogue: 0,0:05:44.33,0:05:46.43,Default,,0,0,0,,Chà, tại cậu ấy cứ năn nỉ nhờ tôi giúp...
Dialogue: 0,0:05:46.43,0:05:49.32,Default,,0,0,0,,Cậu ấy tâm sự là đang hết cách\Nvới một cô nàng đồng hương Osaka của tôi.
Dialogue: 0,0:05:49.64,0:05:51.30,Default,,0,0,0,,Để lát nữa tôi cũng lựa lời khuyên giải cô bé đó giúp cho...
Dialogue: 0,0:05:51.30,0:05:53.82,Default,,0,0,0,,Xong xuôi là hai đứa tâm đầu ý hợp ngay,\Ndễ như trở bàn tay ấy mà!
Dialogue: 0,0:05:53.82,0:05:57.06,Default,,0,0,0,,Em cảm ơn Giám đốc. Giám đốc dùng\Nmột chút bia nhé ạ?
Dialogue: 0,0:05:57.06,0:05:59.04,Default,,0,0,0,,Chú mày bao đấy hả?
Dialogue: 0,0:05:59.04,0:06:02.16,Default,,0,0,0,,- Tất nhiên rồi ạ.\N- Thế thì tốt quá. Tôi chẳng khách sáo đâu nhé.
Dialogue: 0,0:06:02.16,0:06:04.20,Default,,0,0,0,,Vâng ạ. Ông chủ, cho tụi em bia nhé.
Dialogue: 0,0:06:04.20,0:06:06.78,Default,,0,0,0,,- Hai cốc nhé.\N- Có ngay đây.
Dialogue: 0,0:06:07.63,0:06:08.82,Default,,0,0,0,,- Giám đốc ơi.\N- Hả?
Dialogue: 0,0:06:12.72,0:06:14.76,Default,,0,0,0,,Người Osaka ngoài đời cũng hay làm trò đó thật hả?
Dialogue: 0,0:06:14.76,0:06:16.59,Default,,0,0,0,,Chú mày đang làm cái trò khỉ gì thế hả...
Dialogue: 0,0:06:16.59,0:06:17.75,Default,,0,0,0,,Đoàng!
Dialogue: 0,0:06:19.28,0:06:20.58,Default,,0,0,0,,Diễn thế trật nhịp rồi.
Dialogue: 0,0:06:20.58,0:06:23.10,Default,,0,0,0,,Nhịp tung hứng của chú mày sai bét nhè.
Dialogue: 0,0:06:23.10,0:06:24.67,Default,,0,0,0,,Khó quá đi mất.
Dialogue: 0,0:06:24.67,0:06:29.04,Default,,0,0,0,,Công ty của tôi ứng dụng công nghệ cao\Ntrong việc đánh giá hiệu suất thể chất của vận động viên.
Dialogue: 0,0:06:29.04,0:06:31.44,Default,,0,0,0,,Sắp tới rất có thể sẽ được áp dụng trong hệ thống\Nchấm điểm thi đấu tại Thế vận hội Olympic Tokyo đấy.
Dialogue: 0,0:06:31.44,0:06:33.73,Default,,0,0,0,,Nếu dự án đó được duyệt, tôi dự kiến sẽ\Nđảm nhận chức Chủ tịch Hội đồng Giám khảo luôn.
Dialogue: 0,0:06:33.73,0:06:38.05,Default,,0,0,0,,Thế bác có kiếm được vé vào xem ở Sân vận động Quốc gia mới không ạ?\NDù phải tận 6 năm nữa mới diễn ra...
Dialogue: 0,0:06:38.05,0:06:42.19,Default,,0,0,0,,Chuyện nhỏ như con thỏ. Không thành vấn đề.\NThế cô muốn xem nội dung chạy nước rút 100 mét hả?
Dialogue: 0,0:06:42.19,0:06:44.95,Default,,0,0,0,,Không... Cho tôi xin vé xem môn\Nnhảy cao nữ nhé.
Dialogue: 0,0:06:44.95,0:06:47.18,Default,,0,0,0,,Môn đó xem cũng hấp dẫn đấy.
Dialogue: 0,0:06:47.85,0:06:49.52,Default,,0,0,0,,Xin lỗi đã để quý khách đợi.
Dialogue: 0,0:06:52.63,0:06:54.02,Default,,0,0,0,,Xin kính chào quý khách.
Dialogue: 0,0:06:55.00,0:06:58.39,Default,,0,0,0,,- Kasumi.\N- Tới đúng như lời đã hứa rồi nhé.
Dialogue: 0,0:06:58.56,0:07:00.42,Default,,0,0,0,,Hôm nay anh định khao tôi món gì nào?
Dialogue: 0,0:07:00.42,0:07:03.72,Default,,0,0,0,,- Ồ, cô bé mà cậu kể là đây hả?\N- Dạ vâng.
Dialogue: 0,0:07:03.72,0:07:05.97,Default,,0,0,0,,Cháu ở quận nào của Osaka thế?
Dialogue: 0,0:07:05.97,0:07:08.31,Default,,0,0,0,,Gì thế này? Ông chú này là nhà tài trợ của anh đấy à?
Dialogue: 0,0:07:08.50,0:07:10.26,Default,,0,0,0,,Cháu cứ yên tâm tin tưởng ở ta.
Dialogue: 0,0:07:10.26,0:07:14.75,Default,,0,0,0,,Mà trước khi nói chuyện khác, cậu Komichi đây lúc nào\Ncũng hào phóng bao cháu ăn uống...
Dialogue: 0,0:07:14.75,0:07:17.89,Default,,0,0,0,,...thế mà cháu lại chẳng thèm cho cậu ấy\Nlấy một số điện thoại hay địa chỉ email để liên lạc.
Dialogue: 0,0:07:17.89,0:07:19.94,Default,,0,0,0,,Cháu làm thế chẳng phải là quá phũ phàng hay sao?
Dialogue: 0,0:07:19.94,0:07:23.78,Default,,0,0,0,,Sống trong xã hội là phải biết nương tựa lẫn nhau.\NPhải có qua có lại mới toại lòng nhau chứ.
Dialogue: 0,0:07:23.78,0:07:26.38,Default,,0,0,0,,Cho một cốc bia với chỗ này... Làm thành món tempura giúp tôi nhé.
Dialogue: 0,0:07:31.29,0:07:32.76,Default,,0,0,0,,Cứ để nguyên củ thế này rồi tẩm bột chiên lên à?
Dialogue: 0,0:07:32.76,0:07:36.22,Default,,0,0,0,,À, thái lát xéo mỏng ra...\Nrồi thả vào chảo dầu chiên lên là được.
Dialogue: 0,0:07:41.10,0:07:43.13,Default,,0,0,0,,Cô bé này đúng là thuộc hàng đáo để gớm mặt đấy, nhưng mà...
Dialogue: 0,0:07:43.13,0:07:45.17,Default,,0,0,0,,...thế lại càng kích thích máu chinh phục của tôi.
Dialogue: 0,0:07:45.17,0:07:47.17,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:07:53.92,0:07:56.58,Default,,0,0,0,,Ngầu quá đi mất...
Dialogue: 0,0:08:11.84,0:08:13.84,Default,,0,0,0,,Xin lỗi đã để quý khách đợi.
Dialogue: 0,0:08:15.26,0:08:16.72,Default,,0,0,0,,Món gì đỏ chót thế kia?
Dialogue: 0,0:08:16.72,0:08:18.83,Default,,0,0,0,,Beniten* đấy.\N(*Viết tắt của Benishoga Tempura - Tempura gừng đỏ muối chua)
Dialogue: 0,0:08:18.83,0:08:20.87,Default,,0,0,0,,Beniten ư?
Dialogue: 0,0:08:25.64,0:08:28.61,Default,,0,0,0,,Thế là từ hôm đó Ông chủ bắt đầu nhập sẵn củ gừng đỏ muối chua về quán à?
Dialogue: 0,0:08:28.61,0:08:32.20,Default,,0,0,0,,Ừ. Kể cả mấy nguyên liệu lắt nhắt không có sẵn ở Tokyo,\Ntôi cũng đặt mua về luôn.
Dialogue: 0,0:08:32.48,0:08:35.35,Default,,0,0,0,,Cái cô bé người vùng Naniwa đó, rốt cuộc cô nàng làm nghề gì thế nhỉ?
Dialogue: 0,0:08:35.45,0:08:39.52,Default,,0,0,0,,Tôi có hỏi thử cậu Komichi xem cô bé làm nghề gì,\Nnhưng cậu ấy bảo chính cậu ấy cũng chịu chết không biết.
Dialogue: 0,0:08:39.72,0:08:42.19,Default,,0,0,0,,Lần nào ghé quán cô nàng cũng chẳng trả một xu tiền ăn nào đúng không?
Dialogue: 0,0:08:42.42,0:08:44.64,Default,,0,0,0,,Nói giảm nói tránh thì thế thôi,\Nchứ chẳng phải là chuyên gia ăn quỵt rồi chuồn êm hay sao?
Dialogue: 0,0:08:45.05,0:08:46.68,Default,,0,0,0,,Chuẩn luôn nhỉ~?
Dialogue: 0,0:08:46.68,0:08:49.45,Default,,0,0,0,,- Xin lỗi đã để quý khách đợi.\N- Tempura gừng đỏ muối chua...
Dialogue: 0,0:08:49.45,0:08:50.81,Default,,0,0,0,,Ông chủ ăn thử một miếng không?
Dialogue: 0,0:08:51.75,0:08:53.64,Default,,0,0,0,,Thôi, cảm ơn cô.
Dialogue: 0,0:08:54.99,0:08:58.44,Default,,0,0,0,,Gừng đỏ muối chua mà ăn kèm\Nvới mì xào yakisoba thì hợp thật đấy, nhưng mà...
Dialogue: 0,0:08:58.83,0:09:02.29,Default,,0,0,0,,Màu phẩm đỏ chót thế kia nhìn cứ ghê ghê sao ấy nhỉ?
Dialogue: 0,0:09:02.50,0:09:06.71,Default,,0,0,0,,Không biết người ta bỏ những chất phụ gia gì vào trong đó nữa?
Dialogue: 0,0:09:06.98,0:09:13.20,Default,,0,0,0,,Nghe nói ở mấy quán mì soba đứng ăn quanh khu Akihabara với Asakusa,\Nngười ta cũng hay bỏ món này vào bát nước dùng đấy.
Dialogue: 0,0:09:13.20,0:09:16.54,Default,,0,0,0,,- Ưm! Tôi hiểu vì sao người ta thích rồi...\N- Đúng không! Đúng không!
Dialogue: 0,0:09:16.71,0:09:18.96,Default,,0,0,0,,Ăn bắt vị phết đấy chứ!
Dialogue: 0,0:09:18.96,0:09:21.55,Default,,0,0,0,,Quả thực là...
Dialogue: 0,0:09:21.73,0:09:23.98,Default,,0,0,0,,...trông nó cứ nhạt nhòa vô hồn chẳng có chút điểm nhấn nào.
Dialogue: 0,0:09:23.98,0:09:27.39,Default,,0,0,0,,Ở Osaka, người ta bày bán món này như đồ ăn kèm bình dân ở khắp nơi...
Dialogue: 0,0:09:27.60,0:09:29.25,Default,,0,0,0,,Nghe bảo các gia đình ở bển cũng hay ăn trong bữa cơm hàng ngày lắm.
Dialogue: 0,0:09:29.62,0:09:33.31,Default,,0,0,0,,Chuyện lạ đời thật. Chẳng nhẽ người dân ở bển\Nai sinh ra cũng nghèo khổ túng thiếu đến mức phải ăn thứ này sao?
Dialogue: 0,0:09:33.31,0:09:36.12,Default,,0,0,0,,Ê này, bà chị không cần phải ăn nói quá đáng tới mức đó đâu nghen!\N(Lưu ý: cậu ta bất giác buột miệng nói bằng phương ngữ Osaka)
Dialogue: 0,0:09:37.11,0:09:42.25,Default,,0,0,0,,Kou-chan... Chẳng lẽ em cũng là...
Dialogue: 0,0:09:42.25,0:09:46.05,Default,,0,0,0,,Tôi ghé quán để ăn tối đây.
Dialogue: 0,0:10:08.25,0:10:17.72,Default,,0,0,0,,♫ Kon'na yoru daremoga warai uka re teru kisetsu\N{\i1}Trong đêm hội giao mùa, ai nấy đều rộn ràng cười nói{\i0}
Dialogue: 0,0:10:17.72,0:10:28.31,Default,,0,0,0,,♫ Sake o nomi, uta o utai, shinda yo ni yoruru no sa\N{\i1}Cùng nâng chén rượu nồng, ngân nga câu hát cho đến khi màn đêm tàn lụi{\i0}
Dialogue: 0,0:10:28.58,0:10:34.60,Default,,0,0,0,,♫ Doko made mo, doko made mo\N{\i1}Về nơi đâu, mãi tận phương trời nào{\i0}
Dialogue: 0,0:10:34.60,0:10:38.72,Default,,0,0,0,,♫ Tabi wa hatenaku tsudzuku ka\N{\i1}Hành trình phiêu lãng này liệu sẽ nối dài bất tận{\i0}
Dialogue: 0,0:10:38.72,0:10:43.72,Default,,0,0,0,,♫ Deau saki de warai ai\N{\i1}Cùng mỉm cười kết giao với những người tình cờ gặp gỡ phía trước{\i0}
Dialogue: 0,0:10:44.09,0:10:45.71,Default,,0,0,0,,♫ Wakareru toki ne\N{\i1}Rồi lại đến lúc phải nói lời chia xa{\i0}
Dialogue: 0,0:10:45.71,0:10:48.30,Default,,0,0,0,,Ông chủ ơi! Cho tôi một phần Beniten luôn nhé.
Dialogue: 0,0:10:48.65,0:10:50.93,Default,,0,0,0,,Xin lỗi bác nhé, hôm nay quán vừa hết sạch gừng đỏ rồi.
Dialogue: 0,0:10:51.28,0:10:55.56,Default,,0,0,0,,Nhưng tôi vẫn còn ít đồ băm vụn khác đây.\NNếu bác thích thì tôi tẩm bột chiên lên cho bác nhé.
Dialogue: 0,0:10:55.56,0:10:58.16,Default,,0,0,0,,Tôi không ăn mấy thứ đó đâu. Này cô bé...
Dialogue: 0,0:10:58.16,0:11:00.23,Default,,0,0,0,,Cháu chia cho ta xin một miếng được không?
Dialogue: 0,0:11:00.23,0:11:02.56,Default,,0,0,0,,- Phần này là của tôi mà.\N- Cháu mua chỗ đó hết bao nhiêu tiền thế?
Dialogue: 0,0:11:03.00,0:11:04.51,Default,,0,0,0,,Một triệu yên đấy.\N(*Ở các khu chợ Osaka, người ta hay nói đùa 1 yên\Nlà 1 triệu yên, 5 yên là 5 triệu yên...)
Dialogue: 0,0:11:04.51,0:11:06.70,Default,,0,0,0,,Rẻ bèo thế cơ à?\N(*Ở các khu chợ Osaka, người ta hay nói đùa 1 yên\Nlà 1 triệu yên, 5 yên là 5 triệu yên...)
Dialogue: 0,0:11:06.94,0:11:08.89,Default,,0,0,0,,Thôi, tôi ăn no rồi.
Dialogue: 0,0:11:08.89,0:11:12.71,Default,,0,0,0,,- Anh Komichi, anh thanh toán hóa đơn luôn nhé?\N- Hả? Nhưng mà hôm trước...
Dialogue: 0,0:11:12.71,0:11:14.93,Default,,0,0,0,,Chuyện hôm trước là của hôm trước.\NHôm nay là chuyện của hôm nay.
Dialogue: 0,0:11:15.19,0:11:17.29,Default,,0,0,0,,Thời thế luôn thay đổi từng ngày mà.
Dialogue: 0,0:11:17.29,0:11:20.59,Default,,0,0,0,,Chẳng phải ông chú đang thèm nhỏ dãi tấm vé\Nhạng kim cương bạch kim của Thế vận hội Olympic hay sao?
Dialogue: 0,0:11:20.59,0:11:21.72,Default,,0,0,0,,Ồ...
Dialogue: 0,0:11:22.07,0:11:25.30,Default,,0,0,0,,Này ông chú. Bộ tóc giả của chú bị lệch lộ cả ra ngoài rồi kìa.
Dialogue: 0,0:11:25.54,0:11:29.62,Default,,0,0,0,,Đừng có ăn nói hàm hồ.\NLàm gì có bộ tóc giả nào ở đây.
Dialogue: 0,0:11:29.62,0:11:33.37,Default,,0,0,0,,Cô bé nói đúng đấy. Làm gì có ai lại đi đội\Nmột bộ tóc giả lộ liễu đến mức ai nhìn cũng biết thế này nhỉ?
Dialogue: 0,0:11:33.99,0:11:36.60,Default,,0,0,0,,Ờ... không phải... à ừm...
Dialogue: 0,0:11:37.39,0:11:39.40,Default,,0,0,0,,Cháu nghĩ chú cứ tháo quách nó ra trông còn đỡ hơn đấy.
Dialogue: 0,0:11:49.08,0:11:52.08,Default,,0,0,0,,Cô bé này thực sự thú vị thật đấy...
Dialogue: 0,0:11:57.58,0:11:59.99,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:12:00.77,0:12:02.29,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:12:10.24,0:12:11.84,Default,,0,0,0,,- Xin kính chào quý khách.\N- Chào Ông chủ.
Dialogue: 0,0:12:21.96,0:12:24.96,Default,,0,0,0,,- Cho tôi gọi một phần Beniten nữa nhé?\N- Làm một phần cho một người ăn hả bác?
Dialogue: 0,0:12:24.96,0:12:27.41,Default,,0,0,0,,Không không, mọi khi tôi chỉ gọi nửa phần thôi mà, nhớ không?
Dialogue: 0,0:12:27.41,0:12:29.97,Default,,0,0,0,,Ai đời lại bỏ ra tận 400 yên chỉ để ăn cái món bình dân đó...
Dialogue: 0,0:12:30.52,0:12:32.40,Default,,0,0,0,,Ngày xưa tôi mua có 5 yên một miếng thôi đấy.
Dialogue: 0,0:12:32.40,0:12:34.36,Default,,0,0,0,,Vâng, có ngay đây.
Dialogue: 0,0:12:34.79,0:12:39.48,Default,,0,0,0,,Cho tôi xin thêm một cốc trà đá lạnh nữa nhé.
Dialogue: 0,0:12:39.48,0:12:41.81,Default,,0,0,0,,Giám đốc ơi, cái đầu của bác...
Dialogue: 0,0:12:41.81,0:12:45.00,Default,,0,0,0,,- Ồ, cậu nhận ra ngay hả?\N- Nhìn một cái là thấy liền mà bác.
Dialogue: 0,0:12:45.00,0:12:47.43,Default,,0,0,0,,Trông phong độ tươi mới hẳn ra đấy ạ.
Dialogue: 0,0:12:47.70,0:12:52.33,Default,,0,0,0,,Cánh thương nhân tụi tôi vẫn hay bảo nhau:\N"Làm ăn mà sợ thay đổi là dở rồi."
Dialogue: 0,0:12:55.14,0:12:59.21,Default,,0,0,0,,Bác Ide này... Bác chỉ được lấy tối đa 3 cây tăm xỉa răng thôi nhé.
Dialogue: 0,0:12:59.21,0:13:02.22,Default,,0,0,0,,Thôi nào, làm gì mà keo kiệt thế.
Dialogue: 0,0:13:02.59,0:13:06.30,Default,,0,0,0,,Ông chủ quán này tính tình bủn xỉn thật đấy.
Dialogue: 0,0:13:07.55,0:13:10.12,Default,,0,0,0,,Nào cô bé, cháu nhìn thấy sao hả?
Dialogue: 0,0:13:10.37,0:13:12.58,Default,,0,0,0,,- Thấy sao về chuyện gì cơ?\N- Thì về quả đầu mới này này.
Dialogue: 0,0:13:13.13,0:13:15.28,Default,,0,0,0,,Tự dưng tôi lại thấy hồi ông chú đội tóc giả\Nnhìn còn tấu hài vui mắt hơn đấy.
Dialogue: 0,0:13:16.71,0:13:18.44,Default,,0,0,0,,Nhưng để đầu trọc thế này trông cũng dễ thương phết.
Dialogue: 0,0:13:19.64,0:13:21.02,Default,,0,0,0,,Dễ thương cơ à?
Dialogue: 0,0:13:21.02,0:13:24.82,Default,,0,0,0,,Hợp với tướng của chú lắm. Nhìn y chang tượng thần Billiken*\Nlúc ban phước lành cho người ta ấy...\N(*Bức tượng thần may mắn nổi tiếng ở Osaka có hình dáng đầu trọc và nụ cười tươi)
Dialogue: 0,0:13:24.82,0:13:30.45,Default,,0,0,0,,Thế nào hả cô bé? Cháu có muốn làm\Nbồ nhí của ta không? Nếu cháu cần tiền thì ta đây chẳng thiếu.
Dialogue: 0,0:13:31.24,0:13:34.06,Default,,0,0,0,,Má tôi từng dặn là...
Dialogue: 0,0:13:34.32,0:13:37.43,Default,,0,0,0,,"Đừng bao giờ hạ mình làm thứ nhân tình rẻ rúng."
Dialogue: 0,0:13:37.43,0:13:41.06,Default,,0,0,0,,Thôi, tôi về đây. Nhớ trả tiền phần ăn cho tôi luôn nhé!
Dialogue: 0,0:13:47.46,0:13:51.84,Default,,0,0,0,,Con nhỏ này đúng là một cô gái thú vị hết sức...
Dialogue: 0,0:13:52.53,0:13:57.29,Default,,0,0,0,,{\i1}Nếu bạn đã bắt đầu cảm thấy nhàm chán với những màn\Nđấu khẩu bằng phương ngữ Osaka như thế này...{\i0}
Dialogue: 0,0:13:57.29,0:14:02.89,Default,,0,0,0,,{\i1}...thì hãy coi chừng.\NTai họa luôn ập đến vào lúc bạn mất cảnh giác nhất đấy.{\i0}
Dialogue: 0,0:14:03.66,0:14:05.66,Default,,0,0,0,,- Xin lỗi đã để quý khách đợi.\N- Cảm ơn Ông chủ.
Dialogue: 0,0:14:05.66,0:14:09.68,Default,,0,0,0,,Thôi nào, mình cứ thử với nhau một lần xem sao đi.\NNgười xưa chẳng có câu...
Dialogue: 0,0:14:09.68,0:14:12.92,Default,,0,0,0,,..."chưa cưỡi thử làm sao biết ngựa hay dở", đúng không nào?
Dialogue: 0,0:14:12.92,0:14:15.72,Default,,0,0,0,,Bệnh viêm nướu răng của ta cũng vừa chữa khỏi dứt điểm rồi.
Dialogue: 0,0:14:19.13,0:14:21.44,Default,,0,0,0,,Mũi của ông chú mềm oặt y như cục kẹo dẻo marshmallow ấy nhỉ.
Dialogue: 0,0:14:22.00,0:14:25.20,Default,,0,0,0,,- Chào buổi tối.\N- Xin kính chào quý khách!
Dialogue: 0,0:14:26.54,0:14:27.65,Default,,0,0,0,,Ông xã!
Dialogue: 0,0:14:27.65,0:14:29.49,Default,,0,0,0,,Mỗi lần ông mở miệng báo bận tăng ca làm muộn...
Dialogue: 0,0:14:29.49,0:14:31.59,Default,,0,0,0,,...là tôi biết thừa ông lại trốn ra ngoài hú hí mà.
Dialogue: 0,0:14:31.59,0:14:34.64,Default,,0,0,0,,A- Anh có làm cái gì mờ ám đâu...
Dialogue: 0,0:14:34.64,0:14:36.93,Default,,0,0,0,,Ủa? Mà sao bà lại biết tôi đang ở quán này mà tìm tới...
Dialogue: 0,0:14:36.93,0:14:42.16,Default,,0,0,0,,Tôi đã thuê cả một đội thám tử tư\Nbám sát nhất cử nhất động của ông đấy.
Dialogue: 0,0:14:42.38,0:14:45.09,Default,,0,0,0,,Thậm chí tôi còn định đánh tiếng thuê luôn cả cựu điệp viên CIA Snowden kìa.
Dialogue: 0,0:14:45.09,0:14:49.06,Default,,0,0,0,,Thật thế á? Đúng là thời đại toàn cầu hóa có khác nhỉ?
Dialogue: 0,0:14:49.65,0:14:50.93,Default,,0,0,0,,Cái lão già ngu xuẩn đồi bại này!
Dialogue: 0,0:14:50.93,0:14:54.80,Default,,0,0,0,,Ông tự nhìn lại xem mình bao nhiêu tuổi đầu rồi hả?\NĐồ quỷ già háo sắc!
Dialogue: 0,0:14:54.80,0:14:58.10,Default,,0,0,0,,Tôi xin miếng này của chú nhé, ông chú.
Dialogue: 0,0:14:58.40,0:14:59.96,Default,,0,0,0,,Đúng là đồ thảm hại!
Dialogue: 0,0:15:01.64,0:15:03.39,Default,,0,0,0,,Đi về nhà ngay cho tôi! Trời đất quỷ thần ơi...
Dialogue: 0,0:15:03.39,0:15:06.32,Default,,0,0,0,,- Á! Tiền thừa của bà đây ạ!\N- Ồ, phải rồi.
Dialogue: 0,0:15:06.32,0:15:08.62,Default,,0,0,0,,Gửi lại bà 5 triệu yên tiền thừa nhé.
Dialogue: 0,0:15:11.24,0:15:13.28,Default,,0,0,0,,Ồ, Ông chủ học lỏm nhanh phết đấy nhỉ.
Dialogue: 0,0:15:13.28,0:15:15.25,Default,,0,0,0,,Câu vừa rồi khéo lắm.
Dialogue: 0,0:15:15.25,0:15:17.74,Default,,0,0,0,,Ông đúng là đồ kém cỏi hết thuốc chữa!
Dialogue: 0,0:15:19.17,0:15:22.41,Default,,0,0,0,,Cảm ơn vì bữa ăn nhé.\NXin phép chào mọi người tôi về.
Dialogue: 0,0:15:23.84,0:15:25.71,Default,,0,0,0,,{\i1}Ông xã~!{\i0}
Dialogue: 0,0:15:35.36,0:15:40.58,Default,,0,0,0,,{\i1}Một khoảng thời gian sau vụ náo loạn ồn ào đêm hôm ấy...{\i0}
Dialogue: 0,0:15:51.02,0:15:53.96,Default,,0,0,0,,May mà phát hiện ra bệnh sớm đấy ông ạ.
Dialogue: 0,0:15:53.96,0:15:57.08,Default,,0,0,0,,Giờ ông chỉ cần chuyên tâm làm phẫu thuật để chữa trị dứt điểm thôi.
Dialogue: 0,0:15:57.08,0:15:59.37,Default,,0,0,0,,Bà đừng có nói nghe nhẹ tựa lông hồng như thế.
Dialogue: 0,0:16:00.20,0:16:02.60,Default,,0,0,0,,Nhỡ đâu ca phẫu thuật thất bại...
Dialogue: 0,0:16:04.60,0:16:08.68,Default,,0,0,0,,Nhỡ tôi mất đi "báu vật truyền đời" của đàn ông...
Dialogue: 0,0:16:09.21,0:16:14.01,Default,,0,0,0,,...thì cuộc đời này còn thú vui gì để mà sống tiếp nữa chứ.
Dialogue: 0,0:16:19.85,0:16:22.41,Default,,0,0,0,,- Này cô bé.\N- Chuyện gì?
Dialogue: 0,0:16:22.41,0:16:25.09,Default,,0,0,0,,Ngày kia là ta phải lên bàn mổ rồi.
Dialogue: 0,0:16:25.09,0:16:29.33,Default,,0,0,0,,Sau ca mổ đó, e là ta sẽ chẳng còn khả năng làm cháu thỏa mãn được nữa.
Dialogue: 0,0:16:29.90,0:16:33.98,Default,,0,0,0,,Ta van cháu... Đêm nay cháu có thể ở bên ta một đêm được không?
Dialogue: 0,0:16:33.98,0:16:37.11,Default,,0,0,0,,Giám đốc! Chẳng phải bác vừa hứa với phu nhân là\Nsẽ chừa thói trăng hoa vô trách nhiệm rồi sao...
Dialogue: 0,0:16:37.27,0:16:38.86,Default,,0,0,0,,Cũng được thôi.
Dialogue: 0,0:16:39.97,0:16:43.17,Default,,0,0,0,,Nào, thế thì đi thôi. Nhớ trả tiền đồ ăn cho tôi đấy.
Dialogue: 0,0:16:46.61,0:16:50.61,Default,,0,0,0,,À... ừm... Em cũng xin phép về luôn. Cảm ơn Ông chủ.
Dialogue: 0,0:17:04.06,0:17:09.01,Default,,0,0,0,,Có khi nào lão già đó bịa chuyện\Nphải đi phẫu thuật để lừa con bé không nhỉ, Ông chủ?
Dialogue: 0,0:17:12.11,0:17:14.32,Default,,0,0,0,,Khách sạn nằm ở hướng đằng kia cơ mà.
Dialogue: 0,0:17:14.32,0:17:17.63,Default,,0,0,0,,- Tới nước này rồi mà ông vẫn chưa nhận ra sao?\N- Cháu cứ yên tâm đi.
Dialogue: 0,0:17:17.63,0:17:20.78,Default,,0,0,0,,Nếu là tiền tiêu vặt thì ta sẽ\Ncho cháu dư dả để tha hồ mua sắm xả láng.
Dialogue: 0,0:17:23.23,0:17:25.82,Default,,0,0,0,,"Đừng bao giờ hạ mình làm thứ nhân tình rẻ rúng..."
Dialogue: 0,0:17:25.82,0:17:30.46,Default,,0,0,0,,Đó là lời trănối mà má tôi đã dặn dò\Ntrước khi bà nhắm mắt xuôi tay về thế giới bên kia.
Dialogue: 0,0:17:30.46,0:17:34.13,Default,,0,0,0,,Phải rồi! Đêm nay ta với cháu cũng cùng nhau lên thiên đường sung sướng nhé.
Dialogue: 0,0:17:34.13,0:17:35.59,Default,,0,0,0,,Nào, mình đi vào khách sạn thôi.
Dialogue: 0,0:17:35.59,0:17:38.15,Default,,0,0,0,,Ông nhìn kỹ xem, rồi ông sẽ hiểu ra ngay thôi.
Dialogue: 0,0:17:38.15,0:17:40.04,Default,,0,0,0,,Hiểu ra chuyện gì cơ?
Dialogue: 0,0:17:40.04,0:17:41.80,Default,,0,0,0,,Món Beniten...
Dialogue: 0,0:17:41.80,0:17:44.50,Default,,0,0,0,,...chính là hương vị gắn liền với ký ức về người má\Nvà mái ấm không cha của tôi...
Dialogue: 0,0:17:44.50,0:17:47.09,Default,,0,0,0,,Đó là hương vị của sự nghèo đói cơ cực.
Dialogue: 0,0:17:47.09,0:17:49.51,Default,,0,0,0,,Dù ông chỉ là một kẻ tồi tệ\Nchuyên đâm sau lưng và ruồng bỏ người khác...
Dialogue: 0,0:17:49.51,0:17:52.15,Default,,0,0,0,,...nhưng phận làm con mà không gửi lời cảm ơn thì thật chẳng phải đạo...
Dialogue: 0,0:17:52.15,0:17:54.15,Default,,0,0,0,,...thưa Ba.
Dialogue: 0,0:17:55.43,0:17:57.60,Default,,0,0,0,,Cô là ai?
Dialogue: 0,0:17:57.60,0:18:01.70,Default,,0,0,0,,Làm sao mà ông nhận ra nổi chứ.\NHồi ông bỏ đi, tôi mới vừa lọt lòng mẹ mà.
Dialogue: 0,0:18:03.54,0:18:05.83,Default,,0,0,0,,Cô đang nói cái quái gì thế hả?
Dialogue: 0,0:18:05.83,0:18:09.91,Default,,0,0,0,,Ông hãy nhìn thật kỹ gương mặt tôi đi.\NChẳng phải vẫn phảng phất nét người xưa hay sao?
Dialogue: 0,0:18:09.91,0:18:13.63,Default,,0,0,0,,25 năm về trước, người phụ nữ mà ông nhẫn tâm vứt bỏ\Nở khu Higashi-Sumiyoshi...
Dialogue: 0,0:18:13.63,0:18:15.73,Default,,0,0,0,,...chính là má của tôi đấy.
Dialogue: 0,0:18:43.08,0:18:44.60,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:18:48.18,0:18:52.14,Default,,0,0,0,,Ôi chao! Cái ghế mát-xa này êm cực kỳ luôn bà nó ơi!
Dialogue: 0,0:18:53.04,0:18:55.21,Default,,0,0,0,,Ca phẫu thuật của ông đã thành công mỹ mãn rồi...
Dialogue: 0,0:18:55.21,0:18:57.84,Default,,0,0,0,,Từ nay về sau lo mà tu chí làm ăn, nghe rõ chưa hả?
Dialogue: 0,0:18:57.84,0:19:00.78,Default,,0,0,0,,Tôi biết rồi mà. Bà không cần\Nphải nhắc đi nhắc lại nữa đâu.
Dialogue: 0,0:19:00.78,0:19:03.07,Default,,0,0,0,,Nếu không có bà ở bên thì làm gì có tôi của ngày hôm nay.
Dialogue: 0,0:19:03.07,0:19:05.47,Default,,0,0,0,,Từ nay về sau mọi chuyện trong nhà cứ giao cả cho tôi.
Dialogue: 0,0:19:05.47,0:19:08.22,Default,,0,0,0,,Bà đúng là khắc tinh đời tôi mà.
Dialogue: 0,0:19:08.22,0:19:10.26,Default,,0,0,0,,Ối khoan đã... Cái ghế nó ngả ra sâu quá...
Dialogue: 0,0:19:24.20,0:19:29.59,Default,,0,0,0,,Cái quái gì thế này, chẳng có lấy một dòng tin nhắn\Nmà chỉ gửi độc một tấm ảnh chụp đĩa Beniten.
Dialogue: 0,0:19:29.59,0:19:31.28,Default,,0,0,0,,Đây là loại mật mã ám hiệu gì hả ông kia?
Dialogue: 0,0:19:31.28,0:19:34.23,Default,,0,0,0,,Tha cho tôi đi mà, bà xã ơi...
Dialogue: 0,0:19:34.23,0:19:38.50,Default,,0,0,0,,Tôi thực sự đã cắt đứt hoàn toàn mọi dây dưa\Nvới con nhỏ đó rồi. Xin bà hãy tin tôi đi.
Dialogue: 0,0:19:38.50,0:19:42.39,Default,,0,0,0,,Nếu đã cắt đứt hoàn toàn rồi thì làm sao\Nngười ta lại gửi cái thứ này vào máy ông hả?
Dialogue: 0,0:19:42.97,0:19:44.97,Default,,0,0,0,,À thì...
Dialogue: 0,0:19:44.97,0:19:47.58,Default,,0,0,0,,Cái điện thoại này lúc mua bao nhiêu tiền?
Dialogue: 0,0:19:48.21,0:19:51.51,Default,,0,0,0,,Ơ~ Khoảng 3.000 yên.
Dialogue: 0,0:19:51.51,0:19:53.55,Default,,0,0,0,,Thế thì tốt.
Dialogue: 0,0:19:54.92,0:19:56.74,Default,,0,0,0,,Trong chuyện làm ăn buôn bán mà hét giá kiểu đó...
Dialogue: 0,0:19:56.74,0:19:59.86,Default,,0,0,0,,...thì đúng là làm nhục mặt giới thương nhân Osaka.
Dialogue: 0,0:19:59.86,0:20:01.70,Default,,0,0,0,,Đúng không hả?
Dialogue: 0,0:20:10.92,0:20:17.39,Default,,0,0,0,,♫ Tabako o kuyurase\N{\i1}Thả làn khói thuốc lững lờ bay{\i0}
Dialogue: 0,0:20:20.38,0:20:22.96,Default,,0,0,0,,Lần nào ăn cậu cũng phải chụp lại một tấm ảnh thế à?\N♫ Kon'ya wa doko e nagarete ku no\N{\i1}Đêm nay bước chân em sẽ trôi dạt về đâu{\i0}
Dialogue: 0,0:20:22.96,0:20:24.96,Default,,0,0,0,,Coi như viết nhật ký bằng hình ảnh ấy mà anh.\N♫ Kon'ya wa doko e nagarete ku no\N{\i1}Đêm nay bước chân em sẽ trôi dạt về đâu{\i0}
Dialogue: 0,0:20:24.96,0:20:28.44,Default,,0,0,0,,♫ Kon'ya wa doko e nagarete ku no\N{\i1}Đêm nay bước chân em sẽ trôi dạt về đâu{\i0}
Dialogue: 0,0:20:28.98,0:20:43.32,Default,,0,0,0,,♫ Akai kuchibiru wa subete o miryō shite shimau\N{\i1}Bờ môi đỏ thắm mê hoặc mọi ánh nhìn{\i0}
Dialogue: 0,0:20:43.32,0:20:45.09,Default,,0,0,0,,Thấm khô nước trên củ gừng muối, sau đó thái lát.\N♫ Akai kuchibiru wa subete o miryō shite shimau\N{\i1}Bờ môi đỏ thắm mê hoặc mọi ánh nhìn{\i0}
Dialogue: 0,0:20:45.09,0:20:46.57,Default,,0,0,0,,Thấm khô nước trên củ gừng muối, sau đó thái lát.\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:46.57,0:20:48.39,Default,,0,0,0,,Sau khi nhúng đều qua lớp bột áo...\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:48.39,0:20:49.36,Default,,0,0,0,,Nhẹ nhàng thả vào chảo dầu...\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:49.36,0:20:50.24,Default,,0,0,0,,Vâng.\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:50.24,0:20:51.91,Default,,0,0,0,,Vậy nhé, chào tạm biệt mọi người.\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:51.91,0:20:53.94,Default,,0,0,0,,Kasumi ơi, rốt cuộc em làm công việc gì thế?\N♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:53.94,0:20:54.36,Default,,0,0,0,,♫ Beniten na manazashi de kokoro o misukashi teru\N{\i1}Ánh mắt sắc đỏ như Beniten nhìn thấu cả tâm can{\i0}
Dialogue: 0,0:20:54.36,0:20:54.38,Default,,0,0,0,,♫ Beniten yona anata\N{\i1}Em tựa như món gừng đỏ Beniten vậy{\i0}
Dialogue: 0,0:20:54.38,0:20:56.00,Default,,0,0,0,,Kasumi ơi!\N♫ Beniten yona anata\N{\i1}Em tựa như món gừng đỏ Beniten vậy{\i0}
