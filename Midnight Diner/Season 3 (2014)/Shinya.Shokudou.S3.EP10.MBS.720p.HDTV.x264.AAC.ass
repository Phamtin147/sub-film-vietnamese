Dialogue: 0,0:00:07.95,0:00:12.26,Default,,0,0,0,,KOBAYASHI KAORU
Dialogue: 0,0:00:13.66,0:00:18.03,Default,,0,0,0,,TANIMURA MITSUKI\NMITSUISHI KEN\NSHINOHARA YUKIKO
Dialogue: 0,0:00:20.40,0:00:24.77,Default,,0,0,0,,AYATA TOSHIKI\NFUWA MANSAKU\NMATSUSHIGE YUTAKA
Dialogue: 0,0:00:25.00,0:00:27.37,Default,,0,0,0,,Kimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Làn hơi trắng em thở ra, giờ đây chầm chậm cưỡi lên làn gió{\i0}
Dialogue: 0,0:00:27.37,0:00:31.61,Default,,0,0,0,,NAKAYAMA YUICHIRO / ANDO TAMAE / YAMANAKA TAKAHASHI\NKimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Làn hơi trắng em thở ra, giờ đây chầm chậm cưỡi lên làn gió{\i0}
Dialogue: 0,0:00:31.61,0:00:34.58,Default,,0,0,0,,Kimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Làn hơi trắng em thở ra, giờ đây chầm chậm cưỡi lên làn gió{\i0}
Dialogue: 0,0:00:35.10,0:00:38.08,Default,,0,0,0,,Sora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi dần dần tan biến{\i0}
Dialogue: 0,0:00:38.08,0:00:42.25,Default,,0,0,0,,SUDO RISA / KOBAYASHI ASAKO / YOSHIMOTO NAHOKO\NSora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi dần dần tan biến{\i0}
Dialogue: 0,0:00:42.25,0:00:45.14,Default,,0,0,0,,Sora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi dần dần tan biến{\i0}
Dialogue: 0,0:00:45.14,0:00:45.46,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ tít trên bầu trời cao vời vợi, áng mây trắng khẽ vươn tay đón lấy{\i0}
Dialogue: 0,0:00:45.46,0:00:49.49,Default,,0,0,0,,KIYOBUMI KANEKO / UNO SHOHEI / YOSHIMI YUKIHIRO\NToku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ tít trên bầu trời cao vời vợi, áng mây trắng khẽ vươn tay đón lấy{\i0}
Dialogue: 0,0:00:49.49,0:00:54.80,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ tít trên bầu trời cao vời vợi, áng mây trắng khẽ vươn tay đón lấy{\i0}
Dialogue: 0,0:00:54.80,0:00:55.03,Default,,0,0,0,,SHUHEI TAKAHASHI / KAWASE YOTA\NOGURA KENTO / ISHIZAWA EMI\NToku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ tít trên bầu trời cao vời vợi, áng mây trắng khẽ vươn tay đón lấy{\i0}
Dialogue: 0,0:00:55.03,0:00:58.47,Default,,0,0,0,,SHUHEI TAKAHASHI / KAWASE YOTA\NOGURA KENTO / ISHIZAWA EMI\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy làn hơi em thở ra, rồi lơ lửng bềnh bồng{\i0}
Dialogue: 0,0:00:58.47,0:01:00.20,Default,,0,0,0,,Kimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy làn hơi em thở ra, rồi lơ lửng bềnh bồng{\i0}
Dialogue: 0,0:01:00.20,0:01:00.41,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy làn hơi em thở ra, rồi lơ lửng bềnh bồng{\i0}
Dialogue: 0,0:01:00.41,0:01:04.24,Default,,0,0,0,,ODAGIRI JOE\N{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy làn hơi em thở ra, rồi lơ lửng bềnh bồng{\i0}
Dialogue: 0,0:01:04.24,0:01:05.33,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy làn hơi em thở ra, rồi lơ lửng bềnh bồng{\i0}
Dialogue: 0,0:01:05.33,0:01:07.71,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}\NZutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:07.71,0:01:11.18,Default,,0,0,0,,Đạo diễn: MATSUOKA JOJI\NZutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:11.18,0:01:15.36,Default,,0,0,0,,Zutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:16.23,0:01:27.00,Default,,0,0,0,,Kawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông{\i0}
Dialogue: 0,0:01:30.72,0:01:36.44,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa từ nửa đêm đến 7 giờ sáng.{\i0}
Dialogue: 0,0:01:36.44,0:01:40.26,Default,,0,0,0,,{\i1}Người ta thường gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:42.08,0:01:42.93,Default,,0,0,0,,[Phần Súp Miso Thịt Heo 600 yên, Bia 600 yên, Sake 500 yên, Shochu 400 yên,\NRượu bia chỉ phục vụ tối đa 3 phần mỗi người]
Dialogue: 0,0:01:42.93,0:01:45.34,Default,,0,0,0,,{\i1}Thực đơn của quán chỉ có vỏn vẹn bấy nhiêu món.{\i0}\N[Phần Súp Miso Thịt Heo 600 yên, Bia 600 yên, Sake 500 yên, Shochu 400 yên,\NRượu bia chỉ phục vụ tối đa 3 phần mỗi người]
Dialogue: 0,0:01:45.34,0:01:48.49,Default,,0,0,0,,{\i1}Nhưng nếu khách có gọi món gì ngoài những món này...{\i0}
Dialogue: 0,0:01:48.49,0:01:50.61,Default,,0,0,0,,{\i1}...chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:01:50.61,0:01:53.14,Default,,0,0,0,,{\i1}Phương châm buôn bán của tôi là vậy.{\i0}
Dialogue: 0,0:01:55.13,0:01:57.14,Default,,0,0,0,,[QUÁN CƠM ĐÊM - MESHIYA]
Dialogue: 0,0:01:57.14,0:02:01.91,Default,,0,0,0,,{\i1}Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?...\NThực ra là đông hơn bạn tưởng nhiều đấy.{\i0}
Dialogue: 0,0:02:04.20,0:02:12.68,Default,,0,0,0,,{\i1}Phụ đề tiếng Việt bởi Amtia(NOFACE):{\i0}\N{\b1}QUÁN ĂN ĐÊM (SHINYA SHOKUDO) - Phần 3{\b0}\NTập 10: "Mì Soba Tất Niên..."
Dialogue: 0,0:02:19.58,0:02:23.86,Default,,0,0,0,,{\i1}Vào đêm Tất niên, tôi thường\Nmở quán sớm hơn lệ thường.{\i0}
Dialogue: 0,0:02:24.14,0:02:25.39,Default,,0,0,0,,{\i1}Bạn hỏi tại sao ư?{\i0}
Dialogue: 0,0:02:25.70,0:02:28.98,Default,,0,0,0,,{\i1}Là bởi vì có khá nhiều khách quen\Nmuốn đón giao thừa tại quán của tôi.{\i0}
Dialogue: 0,0:02:28.98,0:02:33.20,Default,,0,0,0,,{\i1}Thế nên tôi phải chuẩn bị\Nmọi thứ từ sớm.{\i0}
Dialogue: 0,0:02:34.99,0:02:37.18,Default,,0,0,0,,Hóa ra cô sinh ra ở vùng Aizu (thuộc tỉnh Fukushima) à?
Dialogue: 0,0:02:37.18,0:02:39.05,Default,,0,0,0,,Nhìn biển số xe của tôi\Nlà thấy rõ mồn một rồi còn gì?
Dialogue: 0,0:02:39.26,0:02:40.94,Default,,0,0,0,,À ừ, đúng thế thật.
Dialogue: 0,0:02:41.42,0:02:43.71,Default,,0,0,0,,Biển số của tỉnh đó\Ncó vấn đề gì sao?
Dialogue: 0,0:02:44.38,0:02:47.41,Default,,0,0,0,,Không biết hồi đi học cô có được dạy điều này không...
Dialogue: 0,0:02:47.41,0:02:50.99,Default,,0,0,0,,Cô có biết quy định "Cảnh giác súng vào và\Nđàn bà ra" không? Ý tôi là...
Dialogue: 0,0:02:50.99,0:02:53.74,Default,,0,0,0,,"Đàn bà ra", tức là những người phụ nữ rời khỏi kinh thành ấy.\N(*Thời Edo, lính canh phải đề phòng súng đạn lọt vào kinh đô và phụ nữ của các lãnh chúa rời đi, dấu hiệu nổi loạn chống lại Mạc phủ)
Dialogue: 0,0:02:53.74,0:02:55.21,Default,,0,0,0,,Làm sao mà tôi biết được chứ...
Dialogue: 0,0:02:55.42,0:02:57.74,Default,,0,0,0,,Tôi rất thích vùng Urabandai (ở Fukushima).
Dialogue: 0,0:02:57.74,0:03:01.97,Default,,0,0,0,,Em họ người vợ thứ hai của chú tôi là\Nngười vùng Nekoma (thuộc Urabandai, Fukushima) đấy.
Dialogue: 0,0:03:01.97,0:03:04.09,Default,,0,0,0,,Nhưng tôi chỉ vừa đỗ xe lại có một phút thôi mà...
Dialogue: 0,0:03:04.30,0:03:06.56,Default,,0,0,0,,Pháp luật vốn nghiêm minh mà, đúng không?
Dialogue: 0,0:03:07.14,0:03:08.73,Default,,0,0,0,,Anh châm chước bỏ qua cho tôi đượ~c khô~ng?
Dialogue: 0,0:03:10.34,0:03:13.20,Default,,0,0,0,,Nghe cái giọng điệu nũng nịu đó cũng chẳng tệ chút nào đâu.
Dialogue: 0,0:03:14.70,0:03:15.74,Default,,0,0,0,,Vậy là được rồi đúng không?
Dialogue: 0,0:03:16.30,0:03:18.91,Default,,0,0,0,,Tôi lại đâm ra thích cái âm điệu đó rồi đấy.
Dialogue: 0,0:03:19.10,0:03:22.11,Default,,0,0,0,,Khi ai đó bị dồn vào chân tường,\Nhọ thường hay kéo dài âm tiết cuối cùng ra.
Dialogue: 0,0:03:22.62,0:03:24.32,Default,,0,0,0,,Gửi anh này.
Dialogue: 0,0:03:52.46,0:03:53.51,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:03:53.86,0:03:58.18,Default,,0,0,0,,Đến đêm Tất niên mà ông chủ vẫn mở cửa à?\NĐúng là "kẻ nghèo khó thì chẳng có lúc thảnh thơi" nhỉ?
Dialogue: 0,0:03:58.18,0:04:01.30,Default,,0,0,0,,Cô có muốn ăn mì Soba Tất niên không?\NTôi vừa làm xong một mẻ sợi tươi mới đấy.
Dialogue: 0,0:04:02.20,0:04:05.46,Default,,0,0,0,,Hôm nay tôi được người ta tặng đủ thứ mì soba rồi.\NCho ông chủ hết đấy.
Dialogue: 0,0:04:05.46,0:04:07.53,Default,,0,0,0,,Với lại, tôi chỉ thích ăn mì udon thôi.
Dialogue: 0,0:04:14.70,0:04:15.83,Default,,0,0,0,,Cảm ơn cô nhé.
Dialogue: 0,0:04:16.14,0:04:19.57,Default,,0,0,0,,Để đáp lại, tôi sẽ chiêu đãi cô\Nmón tempura gừng đỏ nhé.
Dialogue: 0,0:04:19.57,0:04:23.50,Default,,0,0,0,,Để lần sau đi. Hôm nay tôi bận lắm.
Dialogue: 0,0:04:23.50,0:04:24.50,Default,,0,0,0,,Cô có việc phải làm à?
Dialogue: 0,0:04:24.50,0:04:27.57,Default,,0,0,0,,Ừm, đại loại thế. Dịp cuối năm này\Nlà thời điểm kiếm tiền ngon ăn nhất mà.
Dialogue: 0,0:04:27.74,0:04:28.55,Default,,0,0,0,,Hẹn gặp lại nhé.
Dialogue: 0,0:04:35.58,0:04:43.23,Default,,0,0,0,,Chị Kasumi! Chị về sớm thế à?
Dialogue: 0,0:04:40.54,0:04:43.23,Default,,0,0,0,,Cậu phản ứng hơi sớm đấy.
Dialogue: 0,0:04:43.38,0:04:47.33,Default,,0,0,0,,Ở đời này, thời điểm là quan trọng nhất.
Dialogue: 0,0:04:47.83,0:04:49.73,Default,,0,0,0,,Không thể chỉ dựa vào mỗi vận may được đâu.
Dialogue: 0,0:04:50.22,0:04:51.74,Default,,0,0,0,,Thôi thì chúc mừng năm mới nhé.
Dialogue: 0,0:04:52.22,0:04:53.67,Default,,0,0,0,,Chúc chị năm mới an lành.
Dialogue: 0,0:05:01.10,0:05:04.35,Default,,0,0,0,,Ở Osaka, người ta lại ăn\Nmì Udon Tất niên thay vì mì Soba đúng không nhỉ?
Dialogue: 0,0:05:04.48,0:05:08.32,Default,,0,0,0,,Chà, cái đó thì tôi chịu...
Dialogue: 0,0:05:09.54,0:05:13.90,Default,,0,0,0,,Ông chủ, nấu phần mì soba\Ncủa chị Kasumi cho tôi được không?
Dialogue: 0,0:05:14.33,0:05:15.89,Default,,0,0,0,,Có phải cô ấy tự tay làm đâu.
Dialogue: 0,0:05:16.14,0:05:17.81,Default,,0,0,0,,Không sao cả.
Dialogue: 0,0:05:17.81,0:05:22.60,Default,,0,0,0,,Tôi sẽ cảm thấy như có một sợi dây tơ duyên\Nđược nối kết giữa hai người nhờ tô mì này.
Dialogue: 0,0:05:24.58,0:05:26.10,Default,,0,0,0,,Thế thì tùy chú mày.
Dialogue: 0,0:05:29.66,0:05:31.21,Default,,0,0,0,,Chào ông chủ.
Dialogue: 0,0:05:31.78,0:05:33.18,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:05:33.50,0:05:36.46,Default,,0,0,0,,Hiếm khi thấy hai cậu\Nlại cùng nhau tới quán thế này nhỉ.
Dialogue: 0,0:05:36.46,0:05:38.93,Default,,0,0,0,,Tụi cháu tình cờ chạm mặt nhau ở ga tàu thôi ạ.
Dialogue: 0,0:05:40.18,0:05:43.15,Default,,0,0,0,,Đây là mì soba làm thủ công đấy.\NKhách hàng tặng cho cháu.
Dialogue: 0,0:05:43.18,0:05:47.82,Default,,0,0,0,,Cháu cũng thế. Sếp cháu tự tay làm mì soba tuyệt hảo lắm,\Ncứ nằng nặc bắt cháu phải ăn thử.
Dialogue: 0,0:05:47.82,0:05:50.05,Default,,0,0,0,,Vậy hai cậu muốn tôi nấu giùm à?
Dialogue: 0,0:05:50.30,0:05:52.06,Default,,0,0,0,,Sếp muốn biết cảm nhận của cháu sau khi ăn thế nào.
Dialogue: 0,0:05:52.06,0:05:58.87,Default,,0,0,0,,Cháu cũng vậy. Lát nữa tụi cháu mới ăn, nên\Ngiờ gửi ông chủ giữ giùm và nấu giúp tụi cháu nhé?
Dialogue: 0,0:05:59.49,0:06:01.62,Default,,0,0,0,,Cảm ơn ông chủ.
Dialogue: 0,0:06:06.26,0:06:08.55,Default,,0,0,0,,Đúng là dạo này phong trào\Ntự làm mì soba rộ lên ghê nhỉ?
Dialogue: 0,0:06:08.86,0:06:11.42,Default,,0,0,0,,Nó trở thành thú vui tao nhã của mấy ông chú về hưu rồi mà.
Dialogue: 0,0:06:11.50,0:06:14.86,Default,,0,0,0,,Bây giờ có bao nhiêu là khóa đào tạo,\Nthậm chí cả đĩa DVD hướng dẫn từng bước nữa.
Dialogue: 0,0:06:14.86,0:06:18.18,Default,,0,0,0,,Vừa không tốn kém nhiều tiền,\Nlại vừa thỏa mãn tính tỉ mỉ cầu kỳ.
Dialogue: 0,0:06:18.18,0:06:20.49,Default,,0,0,0,,Ý nghĩa của nó cũng sâu sắc\Nlắm đấy chứ?
Dialogue: 0,0:06:20.94,0:06:25.33,Default,,0,0,0,,Nhưng không biết sau này về già\Ntụi mình có như thế không nhỉ.
Dialogue: 0,0:06:25.62,0:06:29.63,Default,,0,0,0,,Chắc chắn là có rồi, một khi\Ngia đình bắt đầu lục đục bất hòa.
Dialogue: 0,0:06:30.42,0:06:34.28,Default,,0,0,0,,Cơ mà ngay cả khi tụi mình không có gia đình...
Dialogue: 0,0:06:34.28,0:06:37.24,Default,,0,0,0,,...thì dù là đêm giao thừa,\Ntụi mình vẫn tụ tập ở đây còn gì?
Dialogue: 0,0:06:37.24,0:06:39.85,Default,,0,0,0,,Năm nay chúng ta lại cùng nhau\Nđón giao thừa nữa rồi nhỉ?
Dialogue: 0,0:06:50.34,0:06:51.85,Default,,0,0,0,,- Ngon thật đấy.\N- Của tớ cũng ngon.
Dialogue: 0,0:06:56.26,0:06:58.33,Default,,0,0,0,,- Đến sớm thế cơ à!\N- Kính chào quý khách.
Dialogue: 0,0:06:58.82,0:06:59.90,Default,,0,0,0,,Đây, biếu ông chủ này.
Dialogue: 0,0:07:01.18,0:07:02.63,Default,,0,0,0,,Đừng nói với tôi đây lại là...
Dialogue: 0,0:07:02.82,0:07:04.84,Default,,0,0,0,,Tôi được một bệnh nhân tặng đấy.
Dialogue: 0,0:07:05.02,0:07:09.11,Default,,0,0,0,,Anh ta bảo cất công lấy được mì soba ở một quán nổi tiếng trên tỉnh Nagano,\Nchỉ xin được đúng phần cho một người ăn thôi.
Dialogue: 0,0:07:09.26,0:07:11.06,Default,,0,0,0,,Ông chủ nấu nhanh cho tôi được không?
Dialogue: 0,0:07:11.46,0:07:13.76,Default,,0,0,0,,Ông chủ, cho cháu một bát với tempura nhé.\NCòn cậu thì sao, Kimi-kun?
Dialogue: 0,0:07:13.98,0:07:15.68,Default,,0,0,0,,Cho tớ một bát thêm trứng.
Dialogue: 0,0:07:16.62,0:07:17.65,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:07:22.52,0:07:24.61,Default,,0,0,0,,- Ngon đúng không?\N- Ngon thật đấy!
Dialogue: 0,0:07:24.69,0:07:26.36,Default,,0,0,0,,Sợi mì dai giòn đậm đà ghê.
Dialogue: 0,0:07:26.46,0:07:27.89,Default,,0,0,0,,Đổi cho nhau ăn thử một miếng đi.
Dialogue: 0,0:07:31.02,0:07:33.86,Default,,0,0,0,,Kimi-kun, tớ ăn lòng đỏ trứng nhé?
Dialogue: 0,0:07:34.22,0:07:35.20,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:07:38.28,0:07:40.24,Default,,0,0,0,,Chẳng còn việc gì làm nữa rồi.
Dialogue: 0,0:07:41.82,0:07:42.96,Default,,0,0,0,,Hay là tụi mình uống rượu đi?
Dialogue: 0,0:07:43.90,0:07:44.91,Default,,0,0,0,,Ừ, uống thôi.
Dialogue: 0,0:07:44.99,0:07:48.61,Default,,0,0,0,,Ông chủ, cho một ginger ale và một bia nhé.
Dialogue: 0,0:07:49.26,0:07:50.38,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:08:02.14,0:08:03.09,Default,,0,0,0,,Chơi bài không?
Dialogue: 0,0:08:05.74,0:08:06.80,Default,,0,0,0,,Mấy người không chơi đúng không?
Dialogue: 0,0:08:09.02,0:08:12.62,Default,,0,0,0,,Gì thế hả mấy đứa?\NNgồi tụm lại mặt dài như cái bơm thế kia.
Dialogue: 0,0:08:12.62,0:08:14.47,Default,,0,0,0,,Nào. Chơi thôi.
Dialogue: 0,0:08:14.67,0:08:16.16,Default,,0,0,0,,- Muốn chơi không?\N- Có chứ. Chơi luôn!
Dialogue: 0,0:08:16.16,0:08:17.70,Default,,0,0,0,,Ồ, tất nhiên rồi.
Dialogue: 0,0:08:17.70,0:08:18.59,Default,,0,0,0,,Chơi thôi nào.
Dialogue: 0,0:08:31.25,0:08:32.69,Default,,0,0,0,,Ôi, cô là bà ba bị rồi.
Dialogue: 0,0:08:32.79,0:08:34.02,Default,,0,0,0,,Cấm nhìn lén đấy nhé.
Dialogue: 0,0:08:37.91,0:08:39.16,Default,,0,0,0,,Biết rồi, biết rồi.
Dialogue: 0,0:08:40.58,0:08:41.87,Default,,0,0,0,,Kimi-kun, cậu sẽ chọn lá nào đây?
Dialogue: 0,0:08:43.30,0:08:45.47,Default,,0,0,0,,Ông chủ, cho chén rượu hâm nóng nhé.
Dialogue: 0,0:08:45.96,0:08:47.03,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:08:47.23,0:08:49.94,Default,,0,0,0,,Bên ngoài trời rét căm căm.
Dialogue: 0,0:08:49.97,0:08:52.53,Default,,0,0,0,,Bác nên ở nhà ngủ cuộn trong bàn sưởi kotatsu đi.\NLại sắp cảm lạnh nữa cho mà xem.
Dialogue: 0,0:08:52.70,0:08:53.74,Default,,0,0,0,,Chuẩn không cần chỉnh.
Dialogue: 0,0:08:53.91,0:08:54.95,Default,,0,0,0,,Bác vừa đi lượn quanh phố về à?
Dialogue: 0,0:08:55.38,0:08:58.36,Default,,0,0,0,,Lúc nãy tôi lỡ nướng sạch tiền lì xì ở tiệm pachinko rồi.\N(*Tiền lì xì otoshidama dự định cho các cháu)
Dialogue: 0,0:08:58.36,0:09:00.45,Default,,0,0,0,,Giờ trong lòng lạnh ngắt như băng đây này.
Dialogue: 0,0:09:00.45,0:09:01.87,Default,,0,0,0,,Bác có muốn vào chơi cùng tụi cháu không?
Dialogue: 0,0:09:02.14,0:09:05.09,Default,,0,0,0,,Mấy đứa này thật là. Đêm giao thừa\Nmà làm cái trò gì thế này...
Dialogue: 0,0:09:05.26,0:09:07.49,Default,,0,0,0,,Có phải đi dã ngoại thời cấp hai đâu chứ.
Dialogue: 0,0:09:08.35,0:09:10.16,Default,,0,0,0,,Tại chẳng có gì làm mà bác.
Dialogue: 0,0:09:11.06,0:09:14.60,Default,,0,0,0,,Dù vậy thì... Ấy chết, suýt nữa thì quên...
Dialogue: 0,0:09:14.74,0:09:16.03,Default,,0,0,0,,Xin phép mọi người một lát.
Dialogue: 0,0:09:17.18,0:09:20.37,Default,,0,0,0,,Ông chủ, tôi nhận được cái này từ quê gửi lên.
Dialogue: 0,0:09:20.83,0:09:22.87,Default,,0,0,0,,Làm bằng bột kiều mạch nguyên chất\Nnên sợi hơi khô một chút...
Dialogue: 0,0:09:23.02,0:09:26.21,Default,,0,0,0,,Nhưng thỉnh thoảng tôi vẫn muốn ăn lại.\NNhờ ông chủ nấu giúp tôi nhé...
Dialogue: 0,0:09:35.24,0:09:36.62,Default,,0,0,0,,Để mọi người đợi lâu rồi.
Dialogue: 0,0:09:37.36,0:09:39.42,Default,,0,0,0,,Nào, tạm dừng một lát nào. Tạm dừng đã.
Dialogue: 0,0:09:52.69,0:09:55.75,Default,,0,0,0,,Bác không nhai à?\NBác Chu, coi chừng nghẹn đấy nhé.
Dialogue: 0,0:09:55.90,0:09:59.98,Default,,0,0,0,,Này nhé, cái thú thưởng thức mì soba là\Nphải để nó tuột thẳng xuống cổ họng ấy.
Dialogue: 0,0:10:03.38,0:10:04.42,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:10:04.74,0:10:06.19,Default,,0,0,0,,Chào ông chủ.
Dialogue: 0,0:10:09.30,0:10:12.60,Default,,0,0,0,,Cho tụi em ba phần mì zaru soba Tất niên nhé.\N(*Mì soba lạnh chấm nước tương)
Dialogue: 0,0:10:17.18,0:10:19.20,Default,,0,0,0,,À, ông chủ gói mang về cho tụi em được không?
Dialogue: 0,0:10:21.14,0:10:22.77,Default,,0,0,0,,Mấy cô muốn ăn mì soba DO TÔI LÀM à?
Dialogue: 0,0:10:24.42,0:10:26.30,Default,,0,0,0,,Đương nhiên rồi ạ.
Dialogue: 0,0:10:29.34,0:10:30.55,Default,,0,0,0,,Có ngay!
Dialogue: 0,0:10:57.82,0:11:02.51,Default,,0,0,0,,Củ wasabi này được trồng ở dòng suối trong vắt,\Nđặc sản tự nhiên của vùng Amagi (tỉnh Shizuoka) đấy.
Dialogue: 0,0:11:02.98,0:11:03.85,Default,,0,0,0,,Xin mời các cô.
Dialogue: 0,0:11:04.90,0:11:08.28,Default,,0,0,0,,Mọi người có thể khuấy tan vào nước chấm\Nhoặc phết thẳng lên sợi mì đều được.
Dialogue: 0,0:11:08.80,0:11:11.08,Default,,0,0,0,,Cảm ơn ông chủ nhiều nha~.
Dialogue: 0,0:11:12.26,0:11:16.23,Default,,0,0,0,,Mì soba thủ công ăn kèm wasabi xịn sò.\NQuá là xa xỉ luôn nhỉ?
Dialogue: 0,0:11:16.42,0:11:19.09,Default,,0,0,0,,Bình thường tụi mình toàn ăn mì soba\Nở mấy quầy đứng thôi...
Dialogue: 0,0:11:19.10,0:11:24.29,Default,,0,0,0,,Ngày xưa, mì soba vốn là món ăn của dân lao động bình dân mà.\NKhông ăn ở quầy đứng thì mất cả phong vị.
Dialogue: 0,0:11:27.98,0:11:31.44,Default,,0,0,0,,Lúc này wasabi cay nồng nhất đấy nhé.\NĐừng có húp một hơi kẻo sặc.
Dialogue: 0,0:11:32.22,0:11:34.20,Default,,0,0,0,,Sao không nhắc sớm hơn hả trời!
Dialogue: 0,0:11:44.58,0:11:47.37,Default,,0,0,0,,Năm cũ sắp sửa qua đi rồi.
Dialogue: 0,0:11:58.43,0:12:00.74,Default,,0,0,0,,Trượt vào căn cứ an toàn... Thoát hiểm trong gang tấc!
Dialogue: 0,0:12:01.10,0:12:03.50,Default,,0,0,0,,- Vẫn kịp giờ này.\N- Kính chào quý khách.
Dialogue: 0,0:12:03.65,0:12:05.71,Default,,0,0,0,,Chị Kosuzu, còn quán của chị thì sao?
Dialogue: 0,0:12:05.82,0:12:11.21,Default,,0,0,0,,Tôi muốn đón năm mới ở đây, nên đã đuổi khéo\Nmấy ông khách khó tính về để đóng cửa quán rồi.
Dialogue: 0,0:12:12.02,0:12:14.39,Default,,0,0,0,,Ông chủ, cho một bát mì soba nhé.
Dialogue: 0,0:12:14.94,0:12:16.77,Default,,0,0,0,,- Còn Koucchan thì sao nào?\N- Cho em tô cỡ đại được không ạ?
Dialogue: 0,0:12:16.98,0:12:20.45,Default,,0,0,0,,Đương nhiên rồi. Ông chủ ơi, một tô cỡ đại nhé.
Dialogue: 0,0:12:20.58,0:12:22.57,Default,,0,0,0,,- Có ngay.\N- Cho cháu một bát mì soba nóng được không?
Dialogue: 0,0:12:22.70,0:12:23.37,Default,,0,0,0,,Cháu nữa!
Dialogue: 0,0:12:23.37,0:12:26.32,Default,,0,0,0,,Lần này tụi cháu muốn ăn mì chính tay ông chủ làm cơ.
Dialogue: 0,0:12:26.46,0:12:27.31,Default,,0,0,0,,Tụi tôi cũng thế.
Dialogue: 0,0:12:27.54,0:12:29.75,Default,,0,0,0,,Thôi thì cho tôi một bát luôn vậy.\NNấu thanh đạm thôi nhé.
Dialogue: 0,0:12:29.90,0:12:31.10,Default,,0,0,0,,Có ngay!
Dialogue: 0,0:12:46.72,0:12:50.48,Default,,0,0,0,,Chúc toàn thể mọi người\Nmột năm mới an khang thịnh vượng.
Dialogue: 0,0:12:50.51,0:12:52.79,Default,,0,0,0,,Chúc mừng năm mới!
Dialogue: 0,0:12:53.28,0:12:54.92,Default,,0,0,0,,Mong được mọi người tiếp tục ủng hộ quán trong năm tới.
Dialogue: 0,0:12:54.92,0:12:56.36,Default,,0,0,0,,- Bọn cháu cũng nhờ ông chủ chiếu cố ạ.\N- Năm mới hãy tiếp tục hòa thuận bên nhau nhé.
Dialogue: 0,0:12:56.36,0:13:00.79,Default,,0,0,0,,- Cùng chúc một năm mới vạn sự như ý nào.\N- Chúc bác một năm bình an vô sự.
Dialogue: 0,0:13:01.96,0:13:04.36,Default,,0,0,0,,Cảm ơn mọi người nhiều lắm.
Dialogue: 0,0:13:14.56,0:13:15.91,Default,,0,0,0,,Của các vị đây.
Dialogue: 0,0:13:17.80,0:13:24.41,Default,,0,0,0,,Nào, thay cho lời chúc đầu năm,\Nchúng ta cùng cạn ly thôi.
Dialogue: 0,0:13:27.28,0:13:29.95,Default,,0,0,0,,- Khoan đã nào--\N- Chờ tụi em với!
Dialogue: 0,0:13:30.88,0:13:32.42,Default,,0,0,0,,Cảm ơn ông chủ~.
Dialogue: 0,0:13:32.80,0:13:36.07,Default,,0,0,0,,Nào, chúc cho một khởi đầu mới... Cạn ly!
Dialogue: 0,0:13:36.32,0:13:37.86,Default,,0,0,0,,Cạn ly!
Dialogue: 0,0:13:37.86,0:13:39.46,Default,,0,0,0,,[Rượu bia chỉ phục vụ tối đa 3 phần mỗi người]
Dialogue: 0,0:13:39.46,0:13:41.93,Default,,0,0,0,,[Chúc Mừng Năm Mới]
Dialogue: 0,0:13:43.71,0:13:45.40,Default,,0,0,0,,Uống thêm được không ông chủ?
Dialogue: 0,0:13:46.24,0:13:49.27,Default,,0,0,0,,Đây là món quà mừng năm mới của tôi dành cho mọi người đấy.
Dialogue: 0,0:13:56.88,0:13:58.55,Default,,0,0,0,,Bé Ryucchan!
Dialogue: 0,0:13:58.84,0:13:59.88,Default,,0,0,0,,Giã xong rồi này.
Dialogue: 0,0:14:14.16,0:14:15.45,Default,,0,0,0,,Cậu thử xem.
Dialogue: 0,0:14:15.87,0:14:17.20,Default,,0,0,0,,Tới luôn đi! Thử một phát xem nào!
Dialogue: 0,0:14:17.39,0:14:19.50,Default,,0,0,0,,- Em cũng muốn thử!\N- Cố lên anh ơi!
Dialogue: 0,0:14:19.50,0:14:20.52,Default,,0,0,0,,Cố lên!
Dialogue: 0,0:14:20.52,0:14:21.64,Default,,0,0,0,,Một, hai, ba...
Dialogue: 0,0:14:23.95,0:14:27.31,Default,,0,0,0,,Tôi giã đây! Tôi giã đây!
Dialogue: 0,0:14:30.80,0:14:32.48,Default,,0,0,0,,Tiếp theo là ông chủ nào.
Dialogue: 0,0:14:32.48,0:14:33.39,Default,,0,0,0,,Lên đi ông chủ ơi!
Dialogue: 0,0:14:33.39,0:14:36.85,Default,,0,0,0,,Thôi tôi xin kiếu. Bây giờ tôi phải\Nđi chuẩn bị đây.
Dialogue: 0,0:14:38.00,0:14:39.88,Default,,0,0,0,,Chuẩn bị cho món này ấy ạ?\N(*Canh bánh dày Ozoni đón năm mới)
Dialogue: 0,0:14:40.76,0:14:42.49,Default,,0,0,0,,Thế thì để em giã thay cho.
Dialogue: 0,0:14:43.68,0:14:45.25,Default,,0,0,0,,Chị làm được mà, cố lên chị ơi!
Dialogue: 0,0:15:02.72,0:15:05.35,Default,,0,0,0,,Em bị đôi chim cu ríu rít bên cạnh\Nlàm cho chạnh lòng rồi đúng không?
Dialogue: 0,0:15:06.24,0:15:13.12,Default,,0,0,0,,Đừng lo. Năm nay em nhất định sẽ gặp được người đàn ông tốt\Nrồi lấy chồng thôi.
Dialogue: 0,0:15:14.11,0:15:15.92,Default,,0,0,0,,Không phải chuyện đó đâu ạ.
Dialogue: 0,0:15:16.24,0:15:22.43,Default,,0,0,0,,Chỉ là... được ở bên cạnh mọi người như thế này,\Nem cảm thấy hạnh phúc lắm.
Dialogue: 0,0:15:23.56,0:15:29.01,Default,,0,0,0,,Em nói đúng đấy. Khoảnh khắc này chính là điều\N"quý giá không gì có thể thay thế được."
Dialogue: 0,0:15:29.60,0:15:33.34,Default,,0,0,0,,Vâng, em cũng nghĩ như vậy.
Dialogue: 0,0:15:33.47,0:15:40.12,Default,,0,0,0,,Và nghĩ đến việc rồi sớm muộn gì,\Ntừng người trong chúng ta cũng sẽ lần lượt qua đời...
Dialogue: 0,0:15:40.36,0:15:42.22,Default,,0,0,0,,Đời người thực sự...
Dialogue: 0,0:15:42.40,0:15:44.05,Default,,0,0,0,,...phù du ngắn ngủi quá.
Dialogue: 0,0:15:44.48,0:15:46.79,Default,,0,0,0,,- Đúng không?\N- Đúng nhỉ?\N- Đúng thật.
Dialogue: 0,0:15:50.56,0:15:53.10,Default,,0,0,0,,Sao tự dưng lại sầu não thế kia?
Dialogue: 0,0:15:53.72,0:15:56.47,Default,,0,0,0,,Sầu não đâu có hợp với mấy cô tí nào.
Dialogue: 0,0:15:56.72,0:15:58.00,Default,,0,0,0,,Mấy cô vẫn còn nhiều...
Dialogue: 0,0:15:58.28,0:16:04.75,Default,,0,0,0,,...nhiều mét hay là kilômét gì đó,\Nchặng đường phía trước vẫn còn dài lắm...
Dialogue: 0,0:16:06.77,0:16:08.16,Default,,0,0,0,,Ơ? Ôi thôi chết rồi!
Dialogue: 0,0:16:08.16,0:16:09.52,Default,,0,0,0,,Trời đất ơi! Chị có sao không đấy?!
Dialogue: 0,0:16:10.30,0:16:11.92,Default,,0,0,0,,Chị Kosuzu!
Dialogue: 0,0:16:11.92,0:16:13.11,Default,,0,0,0,,Một, hai, ba...!
Dialogue: 0,0:16:19.52,0:16:22.96,Default,,0,0,0,,Ủa? Anh có nghe thấy tiếng súng nổ không?
Dialogue: 0,0:16:22.96,0:16:25.16,Default,,0,0,0,,Chắc anh nghe nhầm rồi đấy.
Dialogue: 0,0:16:28.28,0:16:29.67,Default,,0,0,0,,Hay tụi mình làm một ly đi?
Dialogue: 0,0:16:29.88,0:16:31.84,Default,,0,0,0,,Đang làm nhiệm vụ không được uống rượu đâu.
Dialogue: 0,0:16:34.64,0:16:38.35,Default,,0,0,0,,Xin lỗi hai anh. Có một ông chú trung niên ở bên vệ đường bị trật khớp vai...
Dialogue: 0,0:16:38.44,0:16:40.28,Default,,0,0,0,,...do đi đập tay ăn mừng với nhiều người quá.
Dialogue: 0,0:16:40.52,0:16:43.66,Default,,0,0,0,,Cứ rên rỉ than vãn mãi:\N"Nó trật ra rồi! Nó sái quai rồi!"
Dialogue: 0,0:16:44.68,0:16:47.11,Default,,0,0,0,,Vậy thì mau tới nắn lại cho ông ấy thôi!
Dialogue: 0,0:16:47.28,0:16:49.23,Default,,0,0,0,,Đi thôi. Ông ta ở đâu thế?
Dialogue: 0,0:16:49.32,0:16:50.47,Default,,0,0,0,,Lối này ạ.
Dialogue: 0,0:17:05.24,0:17:07.04,Default,,0,0,0,,Thế này xem ra cũng chẳng tệ chút nào.
Dialogue: 0,0:17:09.88,0:17:11.92,Default,,0,0,0,,Ông chủ ơi, cho cháu thêm một bát canh Ozoni nữa nhé!
Dialogue: 0,0:17:11.92,0:17:13.31,Default,,0,0,0,,- Cháu nữa!\N- Cho em một bát nữa!
Dialogue: 0,0:17:13.56,0:17:15.02,Default,,0,0,0,,Tôi nữa nhé!
Dialogue: 0,0:17:15.16,0:17:16.41,Default,,0,0,0,,Có ngay!
Dialogue: 0,0:17:19.20,0:17:24.39,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}
Dialogue: 0,0:17:24.80,0:17:27.32,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:17:28.12,0:17:33.76,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa từ nửa đêm đến 7 giờ sáng.{\i0}
Dialogue: 0,0:17:34.01,0:17:37.42,Default,,0,0,0,,{\i1}Người ta thường gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:17:38.92,0:17:40.27,Default,,0,0,0,,Ông chủ ơi, món của cháu vẫn chưa xong ạ?
Dialogue: 0,0:17:40.40,0:17:41.75,Default,,0,0,0,,À, đợi tôi thêm một lát nữa nhé.
Dialogue: 0,0:17:41.75,0:17:43.51,Default,,0,0,0,,- Dạ vâng.\N- Sắp xong rồi đây.
Dialogue: 0,0:17:51.76,0:17:52.95,Default,,0,0,0,,{\i1}Kính chào quý khách.{\i0}
Dialogue: 0,0:17:54.66,0:17:56.06,Default,,0,0,0,,{\i1}Chào ông chủ.{\i0}
Dialogue: 0,0:17:58.40,0:18:01.92,Default,,0,0,0,,{\i1}Ừm. Ngon thật đấy.{\i0}
Dialogue: 0,0:18:02.00,0:18:03.99,Default,,0,0,0,,{\i1}Quý khách có cần thêm gì không?{\i0}
Dialogue: 0,0:18:05.28,0:18:09.07,Default,,0,0,0,,{\i1}Cô có thể hát lại bài "Đừng nói điều chi"\Nmột lần nữa được không? Cho vợ tôi nghe.{\i0}
Dialogue: 0,0:18:14.04,0:18:17.24,Default,,0,0,0,,{\i1}Ông chủ, cho cháu thịt băm viên chiên xù menchi nhé!{\i0}
Dialogue: 0,0:18:19.88,0:18:21.65,Default,,0,0,0,,{\i1}Bản thân cậu có thấy bộ truyện này thú vị không?{\i0}
Dialogue: 0,0:18:22.16,0:18:23.89,Default,,0,0,0,,{\i1}Thú thật là... chán ngắt ạ.{\i0}
Dialogue: 0,0:18:24.00,0:18:26.22,Default,,0,0,0,,{\i1}Chẳng phải anh từng bảo sẽ sớm\Ntrở thành họa sĩ manga chuyên nghiệp sao!{\i0}
Dialogue: 0,0:18:29.96,0:18:35.46,Default,,0,0,0,,{\i1}Khi nào con tim cháu thật sự thôi thúc muốn vẽ...\Nthì khi ấy hãy cầm bút vẽ lại nhé.{\i0}
Dialogue: 0,0:18:39.28,0:18:41.57,Default,,0,0,0,,{\i1}Chúng ta hẹn hò\Nđể hướng tới việc kết hôn nhé?{\i0}
Dialogue: 0,0:18:41.84,0:18:46.04,Default,,0,0,0,,{\i1}Tình cảm của tôi ấy à...\Nđâu có đơn giản như vậy.{\i0}
Dialogue: 0,0:18:49.40,0:18:50.54,Default,,0,0,0,,{\i1}Khinh bỉ tôi sao?{\i0}
Dialogue: 0,0:18:50.64,0:18:54.34,Default,,0,0,0,,{\i1}Nếu không tự trở nên mạnh mẽ,\Nlàm sao mà sống tiếp được chứ, đúng không?{\i0}
Dialogue: 0,0:18:56.72,0:18:57.61,Default,,0,0,0,,{\i1}Giám đốc.{\i0}
Dialogue: 0,0:18:59.24,0:19:00.32,Default,,0,0,0,,{\i1}Món gì kia?{\i0}
Dialogue: 0,0:19:00.92,0:19:02.12,Default,,0,0,0,,{\i1}Tempura gừng đỏ Beniten đấy.{\i0}
Dialogue: 0,0:19:03.32,0:19:04.86,Default,,0,0,0,,{\i1}Tóc giả của ông lòi ra rồi kìa.{\i0}
Dialogue: 0,0:19:05.40,0:19:07.20,Default,,0,0,0,,{\i1}Đây không phải là tóc giả nhé.{\i0}
Dialogue: 0,0:19:08.68,0:19:11.19,Default,,0,0,0,,{\i1}Sao hả cô bé? Em có muốn\Nlàm người tình nhỏ của tôi không?{\i0}
Dialogue: 0,0:19:11.64,0:19:16.73,Default,,0,0,0,,{\i1}Mẹ cháu dạy rồi... "Đừng bao giờ\Nhạ mình làm một con bồ nhí rẻ tiền."{\i0}
Dialogue: 0,0:19:17.11,0:19:18.34,Default,,0,0,0,,{\i1}Chào ông chủ.{\i0}
Dialogue: 0,0:19:18.48,0:19:20.17,Default,,0,0,0,,{\i1}Kính chào quý khách!{\i0}
Dialogue: 0,0:19:22.24,0:19:26.04,Default,,0,0,0,,{\i1}Thật ra hồi đấy mình ghét gỏi miến lắm.{\i0}
Dialogue: 0,0:19:26.12,0:19:28.45,Default,,0,0,0,,{\i1}Nhưng vì Shiga-kun rất thích món này...{\i0}
Dialogue: 0,0:19:30.04,0:19:31.63,Default,,0,0,0,,{\i1}...nên mình nghĩ, chắc rồi mình cũng sẽ thích nó thôi.{\i0}
Dialogue: 0,0:19:32.12,0:19:33.78,Default,,0,0,0,,{\i1}Shiga-kun đã nói với mình...{\i0}
Dialogue: 0,0:19:34.48,0:19:35.79,Default,,0,0,0,,{\i1}...rằng cậu ấy yêu mình.{\i0}
Dialogue: 0,0:19:38.21,0:19:42.06,Default,,0,0,0,,{\i1}Bắp cải cuộn thịt tốn nhiều thời gian và công sức lắm.{\i0}
Dialogue: 0,0:19:42.06,0:19:45.23,Default,,0,0,0,,{\i1}Ngày trước mẹ tôi luôn là người làm món đó.{\i0}
Dialogue: 0,0:19:45.66,0:19:49.50,Default,,0,0,0,,{\i1}Bộ ngực của em y hệt như ngực của chị\Nhồi trẻ vậy.{\i0}
Dialogue: 0,0:19:49.74,0:19:53.37,Default,,0,0,0,,{\i1}Chị như một quả bóng bay trôi dạt hết từ người đàn ông này sang người khác...{\i0}
Dialogue: 0,0:19:53.66,0:19:56.01,Default,,0,0,0,,{\i1}Chị không có tư cách để phán xét\Nđàn ông tốt hay xấu đâu!{\i0}
Dialogue: 0,0:19:57.62,0:20:00.74,Default,,0,0,0,,{\i1}Mẹ của cậu đã dạy cho tôi công thức nấu món này đấy.{\i0}
Dialogue: 0,0:20:01.10,0:20:06.22,Default,,0,0,0,,{\i1}Cháu luôn ao ước được ăn lại\Nmón bắp cải cuộn thịt của mẹ.{\i0}
Dialogue: 0,0:20:07.78,0:20:08.92,Default,,0,0,0,,{\i1}Để quý khách đợi lâu rồi.{\i0}
Dialogue: 0,0:20:09.50,0:20:12.72,Default,,0,0,0,,{\i1}Ai cũng bảo canh hến là món tẩm bổ giải nhiệt\Ntuyệt vời cho cơ thể giữa mùa hè.{\i0}
Dialogue: 0,0:20:13.26,0:20:14.96,Default,,0,0,0,,{\i1}Cô có thích cờ Vây không?{\i0}
Dialogue: 0,0:20:15.02,0:20:18.96,Default,,0,0,0,,{\i1}Cháu chẳng hiểu mô tê gì cả.\NCứ mỗi lần nhìn người ta chơi là cháu lại buồn ngủ.{\i0}
Dialogue: 0,0:20:21.22,0:20:23.50,Default,,0,0,0,,{\i1}Có thể sau này chúng ta sẽ lại\Nđưa ra những lựa chọn ngu ngốc nữa...{\i0}
Dialogue: 0,0:20:26.66,0:20:29.18,Default,,0,0,0,,{\i1}Anh có thể cho em một cơ hội được không?{\i0}
Dialogue: 0,0:20:31.90,0:20:37.85,Default,,0,0,0,,{\i1}Nếu không ngâm nhả sạch cát,\Nthì không thể nấu được một bát canh ngon đâu.{\i0}
Dialogue: 0,0:20:40.34,0:20:41.90,Default,,0,0,0,,{\i1}Ở đây có món củ ngưu bàng xào cay ngọt Kinpira Gobo không ông chủ?{\i0}
Dialogue: 0,0:20:44.58,0:20:46.41,Default,,0,0,0,,{\i1}Nhưng em yêu anh ấy nhiều lắm!{\i0}
Dialogue: 0,0:20:46.50,0:20:47.37,Default,,0,0,0,,{\i1}Ái chà đau quá!{\i0}
Dialogue: 0,0:20:48.44,0:20:49.79,Default,,0,0,0,,{\i1}Đừng đi mà!{i0}
Dialogue: 0,0:20:52.98,0:20:56.65,Default,,0,0,0,,{\i1}Anh tính định cư luôn ở bên Mỹ à?{\i0}
Dialogue: 0,0:20:56.74,0:21:00.50,Default,,0,0,0,,{\i1}Không. Lần này anh sẽ đi tới một nơi xa xôi hơn nữa.{\i0}
Dialogue: 0,0:21:06.58,0:21:11.51,Default,,0,0,0,,{\i1}Đây là đĩa Hẹ xào Gan.\NVà đĩa này là Gan xào Hẹ.{\i0}
Dialogue: 0,0:21:11.58,0:21:13.46,Default,,0,0,0,,{\i1}Của tôi là đĩa Gan xào Hẹ nhé.{\i0}
Dialogue: 0,0:21:13.46,0:21:14.86,Default,,0,0,0,,{\i1}Còn của tôi là Hẹ xào Gan.{\i0}
Dialogue: 0,0:21:19.58,0:21:21.57,Default,,0,0,0,,{\i1}Nhưng ánh mắt anh nhìn tôi có vẻ hơi đê tiện đấy...{\i0}
Dialogue: 0,0:21:24.82,0:21:26.37,Default,,0,0,0,,{\i1}Anh ấy là vị hôn phu của tôi.{\i0}
Dialogue: 0,0:21:26.58,0:21:28.93,Default,,0,0,0,,{\i1}Hiện giờ tụi tôi đang sống chung với nhau.{\i0}
Dialogue: 0,0:21:29.22,0:21:30.87,Default,,0,0,0,,{\i1}Lòng tôi đang xao xuyến ngả nghiêng...{\i0}
Dialogue: 0,0:21:33.62,0:21:35.67,Default,,0,0,0,,{\i1}Thế này xem ra cũng chẳng tệ chút nào.{\i0}
Dialogue: 0,0:21:43.02,0:21:44.95,Default,,0,0,0,,Xin thứ lỗi, xin thứ lỗi cho tôi chen qua một chút.
Dialogue: 0,0:21:44.95,0:21:46.42,Default,,0,0,0,,Ủa? Có chuyện gì đang diễn ra thế?
Dialogue: 0,0:21:46.42,0:21:48.55,Default,,0,0,0,,Tụi tôi vừa nhận được tin mật báo.
Dialogue: 0,0:21:49.14,0:21:50.68,Default,,0,0,0,,Người ta bảo quán sắp được lên phim điện ảnh rồi đấy.
Dialogue: 0,0:21:53.54,0:21:55.63,Default,,0,0,0,,Chà, cuối cùng thì ngày này cũng tới!
Dialogue: 0,0:21:56.46,0:22:01.17,Default,,0,0,0,,Chỉ cần khách gọi món gì...\Nchỉ cần làm được là tôi đều sẽ nấu.
Dialogue: 0,0:22:01.17,0:22:03.40,Default,,0,0,0,,Phương châm buôn bán của tôi là vậy.
Dialogue: 0,0:22:03.48,0:22:08.38,Default,,0,0,0,,Nếu quý vị có dịp ghé qua khu này...\Nvà tình cờ bắt gặp "Quán Cơm Đêm - Meshiya"...
Dialogue: 0,0:22:08.50,0:22:10.96,Default,,0,0,0,,...thì xin mời cứ tự nhiên bước vào nhé!
Dialogue: 0,0:22:16.01,0:22:18.98,Default,,0,0,0,,"Ông chủ"\NKOBAYASHI KAORU
Dialogue: 0,0:22:19.48,0:22:22.52,Default,,0,0,0,,"Kasumi" - TANIMURA MITSUKI\N"Noguchi" - MITSUISHI KEN\N"Natsuki Izumi" - SHINOHARA YUKIKO
Dialogue: 0,0:22:22.99,0:22:25.99,Default,,0,0,0,,"Kosuzu" - AYATA TOSHIKI\N"Bác Chu" - FUWA MANSAKU\N"Ryu" - MATSUSHIGE YUTAKA
