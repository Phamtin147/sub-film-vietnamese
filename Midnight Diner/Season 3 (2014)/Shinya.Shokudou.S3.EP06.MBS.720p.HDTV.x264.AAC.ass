Dialogue: 0,0:00:10.25,0:00:14.53,Default,,0,0,0,,KOBAYASHI KAORU
Dialogue: 0,0:00:15.94,0:00:20.28,Default,,0,0,0,,ANDO TAMAE
Dialogue: 0,0:00:22.75,0:00:29.69,Default,,0,0,0,,TAKAHASHI SHUHEI / FUWA MANSAKU\NKimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Hơi thở trắng xóa em thở ra, giờ chầm chậm nương theo làn gió{\i0}
Dialogue: 0,0:00:29.69,0:00:33.08,Default,,0,0,0,,NAKAYAMA YUICHIRO / UNO SHOHEI\NKimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Hơi thở trắng xóa em thở ra, giờ chầm chậm nương theo làn gió{\i0}
Dialogue: 0,0:00:33.08,0:00:33.91,Default,,0,0,0,,NAKAYAMA YUICHIRO / UNO SHOHEI\NSora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi tan biến dần{\i0}
Dialogue: 0,0:00:33.91,0:00:40.44,Default,,0,0,0,,Sora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi tan biến dần{\i0}
Dialogue: 0,0:00:40.44,0:00:43.64,Default,,0,0,0,,RYUKYU TARO / MOTOI HIROYUKI\NSora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi tan biến dần{\i0}
Dialogue: 0,0:00:43.64,0:00:44.56,Default,,0,0,0,,RYUKYU TARO / MOTOI HIROYUKI\NToku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ nơi bầu trời cao vời vợi, những đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:44.56,0:00:48.18,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ nơi bầu trời cao vời vợi, những đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:48.18,0:00:52.21,Default,,0,0,0,,SAGARA AKIRA / MOROHASHI REIKO / YAMAGUCHI MIYOKO\NToku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ nơi bầu trời cao vời vợi, những đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:52.21,0:00:53.53,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ nơi bầu trời cao vời vợi, những đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:53.53,0:00:56.77,Default,,0,0,0,,Kimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở của em rồi lững lờ trôi nổi{\i0}
Dialogue: 0,0:00:56.77,0:00:58.59,Default,,0,0,0,,SHIBATA RIE\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở của em rồi lững lờ trôi nổi{\i0}
Dialogue: 0,0:00:58.59,0:01:04.10,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở của em rồi lững lờ trôi nổi{\i0}
Dialogue: 0,0:01:04.10,0:01:06.66,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}\NZutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện từ thuở xa xưa lắm rồi{\i0}
Dialogue: 0,0:01:06.66,0:01:09.55,Default,,0,0,0,,Đạo diễn: MATSUOKA JOJI\NZutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện từ thuở xa xưa lắm rồi{\i0}
Dialogue: 0,0:01:09.55,0:01:13.86,Default,,0,0,0,,Zutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện từ thuở xa xưa lắm rồi{\i0}
Dialogue: 0,0:01:14.73,0:01:23.21,Default,,0,0,0,,Kawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông êm đềm{\i0}
Dialogue: 0,0:01:23.21,0:01:28.56,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa từ nửa đêm đến bảy giờ sáng.{\i0}\NKawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông êm đềm{\i0}
Dialogue: 0,0:01:29.09,0:01:33.27,Default,,0,0,0,,{\i1}Người ta thường gọi nó là 'Quán Ăn Đêm'.{\i0}
Dialogue: 0,0:01:34.41,0:01:36.45,Default,,0,0,0,,QUÁN ĂN ĐÊM (MESHIYA)
Dialogue: 0,0:01:36.45,0:01:41.37,Default,,0,0,0,,{\i1}Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?\NThực ra là đông hơn bạn tưởng nhiều đấy.{\i0}
Dialogue: 0,0:01:43.68,0:01:52.16,Default,,0,0,0,,{\i1}Phụ đề tiếng Việt bởi Amtia(NOFACE):{\i0}\N{\b1}QUÁN ĂN ĐÊM (SHINYA SHOKUDO) - Phần 3{\b0}\NTập 6: "Bắp cải cuộn thịt..."
Dialogue: 0,0:02:05.71,0:02:12.02,Default,,0,0,0,,{\i1}Khi tiết trời thu se lạnh tràn về,\Ncó rất nhiều thực khách thích gọi món bắp cải cuộn thịt.{\i0}
Dialogue: 0,0:02:12.22,0:02:15.80,Default,,0,0,0,,{\i1}Tôi thường chuẩn bị sẵn một nồi lớn từ trước.{\i0}
Dialogue: 0,0:02:15.98,0:02:19.03,Default,,0,0,0,,{\i1}Dù sao thì đây cũng là một món\Ntốn khá nhiều thời gian và công sức.{\i0}
Dialogue: 0,0:02:22.22,0:02:24.49,Default,,0,0,0,,Hai người quen nhau được bao lâu rồi nhỉ?
Dialogue: 0,0:02:26.74,0:02:28.46,Default,,0,0,0,,Tính đến giờ cũng gần ba tháng rồi ạ.
Dialogue: 0,0:02:29.14,0:02:31.06,Default,,0,0,0,,Lâu hơn tôi tưởng đấy nhỉ?
Dialogue: 0,0:02:31.50,0:02:35.80,Default,,0,0,0,,Mà anh chàng lần này kể cũng lạ thật...\NBình thường gu của Marilyn toàn là mấy anh đẹp trai cơ mà.
Dialogue: 0,0:02:36.86,0:02:44.73,Default,,0,0,0,,Điều em tìm kiếm ở một người đàn ông không phải là gương mặt...\Nmà là tâm hồn và đôi bàn tay của anh ấy.
Dialogue: 0,0:02:45.62,0:02:51.82,Default,,0,0,0,,{\i1}Cậu ấy tên là Kimitoshi...\Nđang làm việc tại một phòng khám nắn chỉnh xương khớp gần đây...{\i0}
Dialogue: 0,0:02:51.82,0:02:56.78,Default,,0,0,0,,{\i1}Nghe đâu Marilyn quen cậu ấy khi ghé khám\Nsau những buổi tập nhảy mệt nhoài.{\i0}
Dialogue: 0,0:03:01.66,0:03:03.39,Default,,0,0,0,,Của em đây, Mari-chan.
Dialogue: 0,0:03:04.02,0:03:08.30,Default,,0,0,0,,Khéo quá đi mất! Đúng là đôi bàn tay vàng mà.
Dialogue: 0,0:03:09.34,0:03:10.35,Default,,0,0,0,,Của anh đây...
Dialogue: 0,0:03:10.86,0:03:11.81,Default,,0,0,0,,À...
Dialogue: 0,0:03:14.06,0:03:17.98,Default,,0,0,0,,Cậu cũng bị Marilyn "rút hết xương cốt" rồi hả?\N(Chơi chữ: Nắn xương / Mê mệt vì tình)
Dialogue: 0,0:03:18.14,0:03:21.08,Default,,0,0,0,,Chắc chắn là cậu ấy bị hạ gục bởi những điệu nhảy của cô rồi.
Dialogue: 0,0:03:21.18,0:03:22.02,Default,,0,0,0,,Không đâu ạ...
Dialogue: 0,0:03:22.02,0:03:26.18,Default,,0,0,0,,Anh ấy chưa từng xem em nhảy bao giờ.\NAnh ấy bảo không muốn xem.
Dialogue: 0,0:03:26.26,0:03:28.95,Default,,0,0,0,,À thì, ý tôi là...
Dialogue: 0,0:03:29.30,0:03:34.66,Default,,0,0,0,,Tôi cũng hiểu tâm lý của cậu.\NKiểu như phải lấy hết can đảm, hoặc chuẩn bị tinh thần trước...
Dialogue: 0,0:03:35.22,0:03:38.26,Default,,0,0,0,,À... mọi người từng xem cô ấy diễn rồi ạ?
Dialogue: 0,0:03:38.79,0:03:41.97,Default,,0,0,0,,Ừ, nhưng cũng chỉ xem trong phạm vi vé mua thôi.
Dialogue: 0,0:03:43.10,0:03:44.17,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:03:45.92,0:03:47.31,Default,,0,0,0,,Chào mọi người...
Dialogue: 0,0:03:47.74,0:03:51.31,Default,,0,0,0,,Ông chủ, ông làm món đó chưa?\NMón bắp cải cuộn thịt ấy.
Dialogue: 0,0:03:51.42,0:03:52.54,Default,,0,0,0,,Tôi làm rồi đây.
Dialogue: 0,0:04:03.82,0:04:05.29,Default,,0,0,0,,Ngon quá!
Dialogue: 0,0:04:05.50,0:04:07.43,Default,,0,0,0,,Của hai người đây, xin lỗi vì để chờ lâu.
Dialogue: 0,0:04:09.78,0:04:13.81,Default,,0,0,0,,Ngày xưa mẹ em cũng hay làm món này lắm.
Dialogue: 0,0:04:14.10,0:04:16.17,Default,,0,0,0,,Vậy chắc hẳn bác gái là một người mẹ rất chu đáo nhỉ?
Dialogue: 0,0:04:16.44,0:04:20.42,Default,,0,0,0,,Món bắp cải cuộn thịt vốn tốn nhiều thời gian và công sức lắm.
Dialogue: 0,0:04:20.70,0:04:22.70,Default,,0,0,0,,Nhưng hồi đó em lại chẳng thích món này chút nào.
Dialogue: 0,0:04:22.70,0:04:24.10,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:04:24.62,0:04:29.65,Default,,0,0,0,,Bà ấy thường làm sẵn bắp cải cuộn thịt cho em\Ntrước khi sang nhà người đàn ông nào đó ở lì cả ngày trời.
Dialogue: 0,0:04:30.54,0:04:33.06,Default,,0,0,0,,Vì cảm thấy áy náy khi bỏ con gái\Nở nhà một mình...
Dialogue: 0,0:04:33.06,0:04:35.39,Default,,0,0,0,,...nên bà ấy mới bày vẽ nấu nướng\Nmột món cầu kỳ như vậy.
Dialogue: 0,0:04:36.30,0:04:39.72,Default,,0,0,0,,Bà ấy rất dễ phải lòng đàn ông,\Nmà cũng rất mau chán họ.
Dialogue: 0,0:04:42.82,0:04:46.06,Default,,0,0,0,,Ôi, em xin lỗi... Đang trong bữa ăn tối thế này mà...
Dialogue: 0,0:04:47.14,0:04:51.14,Default,,0,0,0,,Anh không sao đâu. Vì anh là người "trước sau như một" mà.\N(Chơi chữ: Hitosuji - Chung thủy / Thẳng tính)
Dialogue: 0,0:04:58.98,0:05:00.34,Default,,0,0,0,,[Marilyn: Hôm nay hủy lịch diễn]
Dialogue: 0,0:05:00.34,0:05:01.75,Default,,0,0,0,,Cô ấy về quê ở Fukushima rồi hả?\N[Marilyn: Hôm nay hủy lịch diễn]
Dialogue: 0,0:05:02.10,0:05:05.78,Default,,0,0,0,,Vâng, nghe nói là ở gần Koriyama...
Dialogue: 0,0:05:05.78,0:05:10.18,Default,,0,0,0,,Hình như mẹ cô ấy đột ngột phải nhập viện\Nnên cô ấy vội vã bắt tàu về ngay...
Dialogue: 0,0:05:10.30,0:05:15.44,Default,,0,0,0,,Ra là vậy. Tôi cứ tưởng\NMarilyn bị ốm chứ.
Dialogue: 0,0:05:15.54,0:05:19.26,Default,,0,0,0,,Thế tình hình sao rồi? Mẹ cô ấy có sao không?
Dialogue: 0,0:05:19.42,0:05:21.40,Default,,0,0,0,,Dạ, tôi cũng chưa rõ nữa...
Dialogue: 0,0:05:21.82,0:05:25.86,Default,,0,0,0,,Nhưng mới hôm nọ cô ấy vừa kể với chúng tôi\Nlà hai mẹ con vốn chẳng mấy hòa thuận.
Dialogue: 0,0:05:25.86,0:05:30.01,Default,,0,0,0,,Nghe bảo nhờ trận động đất năm 2011 mà cô ấy\Nmới liên lạc lại với mẹ lần đầu tiên sau 10 năm trời.
Dialogue: 0,0:05:31.18,0:05:32.38,Default,,0,0,0,,Xin kính chào quý khách.
Dialogue: 0,0:05:33.17,0:05:36.28,Default,,0,0,0,,Mari-chan, em về sớm thế.
Dialogue: 0,0:05:38.70,0:05:41.14,Default,,0,0,0,,Ông chủ, cho em một ly shochu pha nước nóng.
Dialogue: 0,0:05:41.26,0:05:43.97,Default,,0,0,0,,À thôi, cho em uống với đá đi. Kèm món trứng cá tuyết nướng tái nhé.
Dialogue: 0,0:05:44.62,0:05:46.02,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:05:46.02,0:05:49.66,Default,,0,0,0,,Bọn anh lo cho em lắm đấy. Vừa nãy mọi người\Nđang hỏi thăm Kimi-kun về em xong.
Dialogue: 0,0:05:50.02,0:05:51.06,Default,,0,0,0,,Vậy hả anh.
Dialogue: 0,0:05:51.14,0:05:53.46,Default,,0,0,0,,Thế mẹ em sao rồi?
Dialogue: 0,0:05:54.66,0:05:57.27,Default,,0,0,0,,Hóa ra bà ấy chẳng làm sao cả.
Dialogue: 0,0:05:58.42,0:06:00.05,Default,,0,0,0,,Dù sao thì tay nghề anh ta cũng nhanh nhạy đấy chứ.
Dialogue: 0,0:06:01.30,0:06:03.94,Default,,0,0,0,,Bận mấy anh ấy cũng làm được hết.
Dialogue: 0,0:06:10.26,0:06:11.73,Default,,0,0,0,,Mariko đấy à?
Dialogue: 0,0:06:13.74,0:06:16.85,Default,,0,0,0,,Con lặn lội về tận đây cơ à.
Dialogue: 0,0:06:17.10,0:06:20.62,Default,,0,0,0,,Chẳng phải chính mẹ gọi điện bảo\N"Về nhà gấp đi" còn gì?
Dialogue: 0,0:06:20.62,0:06:23.74,Default,,0,0,0,,Đây là con gái tôi, Mariko.
Dialogue: 0,0:06:23.74,0:06:27.73,Default,,0,0,0,,Con bé đang sống trên Tokyo.\NNó là vũ công đấy, vũ công cơ đấy!
Dialogue: 0,0:06:28.58,0:06:31.87,Default,,0,0,0,,Thảo nào, trông cô ấy ra dáng phụ nữ thành đạt quá.
Dialogue: 0,0:06:33.82,0:06:36.31,Default,,0,0,0,,Quan trọng hơn là sức khỏe của mẹ thế nào rồi?
Dialogue: 0,0:06:36.78,0:06:38.71,Default,,0,0,0,,Ôi, Yuu-chan, Yuu-chan à...
Dialogue: 0,0:06:38.86,0:06:41.41,Default,,0,0,0,,Đây là bé Mariko nhà em, nó về thăm em này.
Dialogue: 0,0:06:44.82,0:06:46.88,Default,,0,0,0,,Ra cháu là Mariko à.
Dialogue: 0,0:06:48.34,0:06:50.65,Default,,0,0,0,,Cháu về thăm mẹ được thế này là tốt quá rồi.
Dialogue: 0,0:06:58.81,0:07:03.68,Default,,0,0,0,,Bà ấy cứ than thở trên điện thoại là chẳng có ai\Nđể nương tựa làm em cuống cuồng chạy về, vậy mà...
Dialogue: 0,0:07:04.16,0:07:06.00,Default,,0,0,0,,...bà ấy lại có bồ mới.
Dialogue: 0,0:07:07.94,0:07:10.71,Default,,0,0,0,,Dù sao thì bác gái không sao là mừng rồi, phải không?
Dialogue: 0,0:07:11.06,0:07:16.28,Default,,0,0,0,,Bác sĩ bảo bị viêm dạ dày thần kinh, đoán là do\Ntích tụ căng thẳng, dù bà ấy vốn chẳng phải tạng người biết lo nghĩ gì.
Dialogue: 0,0:07:17.42,0:07:20.91,Default,,0,0,0,,Kimi-kun, bóp vai cho em một chút nhé?
Dialogue: 0,0:07:36.84,0:07:39.02,Default,,0,0,0,,Em xin lỗi...
Dialogue: 0,0:07:39.02,0:07:40.74,Default,,0,0,0,,Sắp xong rồi.
Dialogue: 0,0:07:41.66,0:07:44.35,Default,,0,0,0,,{\i1}Marilyn đã về thăm quê nhà...{\i0}
Dialogue: 0,0:07:44.54,0:07:49.12,Default,,0,0,0,,{\i1}Nhưng xem chừng cuộc hội ngộ ấy\Nchẳng mấy êm đẹp.{\i0}
Dialogue: 0,0:07:53.02,0:07:55.82,Default,,0,0,0,,[Marilyn: Suất diễn đêm muộn]
Dialogue: 0,0:08:04.54,0:08:08.83,Default,,0,0,0,,Chị ơi, đây không phải kiểu múa\Nmà phụ nữ nên vào xem đâu ạ.
Dialogue: 0,0:08:14.14,0:08:15.50,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:08:15.50,0:08:16.77,Default,,0,0,0,,Xin kính chào quý khách.
Dialogue: 0,0:08:18.46,0:08:22.01,Default,,0,0,0,,Con về muộn thế!
Dialogue: 0,0:08:22.60,0:08:24.10,Default,,0,0,0,,Mẹ làm cái gì ở đây thế?
Dialogue: 0,0:08:24.10,0:08:25.98,Default,,0,0,0,,Còn làm gì nữa?
Dialogue: 0,0:08:25.98,0:08:29.85,Default,,0,0,0,,Mẹ đi du lịch ăn mừng xuất viện\Nsẵn tiện ghé thăm con luôn.
Dialogue: 0,0:08:29.85,0:08:33.37,Default,,0,0,0,,Đột ngột quá đấy...\NChỗ ở của con không đủ rộng để mẹ ngủ lại đâu.
Dialogue: 0,0:08:33.37,0:08:36.54,Default,,0,0,0,,Mẹ tự đặt phòng khách sạn cho mình rồi.
Dialogue: 0,0:08:36.66,0:08:39.67,Default,,0,0,0,,Con cũng chẳng có thời gian đi cùng mẹ đâu,\Nphần lớn thời gian con phải ở trên sân khấu rồi.
Dialogue: 0,0:08:39.67,0:08:41.10,Default,,0,0,0,,Hôm nay con còn có cả suất diễn đêm muộn nữa.
Dialogue: 0,0:08:41.10,0:08:43.62,Default,,0,0,0,,Bác Chuu đây sẽ làm hướng dẫn viên du lịch cho mẹ.
Dialogue: 0,0:08:43.62,0:08:44.87,Default,,0,0,0,,Cứ giao cho tôi.
Dialogue: 0,0:08:46.26,0:08:50.46,Default,,0,0,0,,Tôi vung tay đặt hẳn một phòng giường đôi\Nở khách sạn đấy nhé.
Dialogue: 0,0:08:50.46,0:08:53.61,Default,,0,0,0,,Có điều ngủ một mình trên chiếc giường rộng thế\Nnghĩ cũng thấy cô đơn thật.
Dialogue: 0,0:08:54.02,0:08:57.75,Default,,0,0,0,,Tôi vốn chẳng cầm lòng nổi trước một người phụ nữ\Nvừa sắc sảo mặn mà lại vừa quyến rũ thế này đâu.
Dialogue: 0,0:08:59.85,0:09:01.12,Default,,0,0,0,,Không biết thế này có ổn không nữa.
Dialogue: 0,0:09:01.72,0:09:04.20,Default,,0,0,0,,Ông chủ, cảm ơn ông nhé!
Dialogue: 0,0:09:04.55,0:09:07.76,Default,,0,0,0,,Hả? Cậu này là bạn trai con đấy ư?
Dialogue: 0,0:09:09.02,0:09:14.50,Default,,0,0,0,,Con cất công lên tận Tokyo mà cuối cùng lại vớ phải\Nmột gã nhà quê chính hiệu thế này ư...
Dialogue: 0,0:09:14.50,0:09:17.05,Default,,0,0,0,,Bộ hết đàn ông rồi hay sao hả?
Dialogue: 0,0:09:17.54,0:09:21.50,Default,,0,0,0,,Một người cứ như quả bóng bay trôi dạt\Ntừ gã đàn ông này sang gã đàn ông khác như mẹ...
Dialogue: 0,0:09:21.50,0:09:24.04,Default,,0,0,0,,Thì không có tư cách phán xét\Nđàn ông tốt hay xấu đâu!
Dialogue: 0,0:09:24.10,0:09:25.34,Default,,0,0,0,,Kimi-kun, mình đi thôi.
Dialogue: 0,0:09:25.34,0:09:26.55,Default,,0,0,0,,Ơ, nhưng mà...
Dialogue: 0,0:09:26.74,0:09:28.24,Default,,0,0,0,,Marilyn!
Dialogue: 0,0:09:36.66,0:09:40.29,Default,,0,0,0,,Không biết lần đầu tiên tôi đặt chân đến Tokyo\Nlà từ bao giờ nhỉ.
Dialogue: 0,0:09:40.98,0:09:47.33,Default,,0,0,0,,Hình như là trong chuyến dã ngoại thời cấp ba...\NTôi cũng chẳng còn nhớ rõ nữa.
Dialogue: 0,0:09:47.54,0:09:49.98,Default,,0,0,0,,Tokyo thay đổi nhiều quá rồi.
Dialogue: 0,0:09:51.66,0:09:57.71,Default,,0,0,0,,Cả con bé Mariko nữa... suốt quãng thời gian\Nhai mẹ con không gặp nhau, nó đã thay đổi nhiều thật.
Dialogue: 0,0:09:58.18,0:10:03.75,Default,,0,0,0,,Ngay cả người lớn lên ở đây còn thấy chật vật nữa là,\Nvì ai nấy đều đổ xô về Tokyo mà.
Dialogue: 0,0:10:04.22,0:10:07.25,Default,,0,0,0,,Marilyn thực sự rất trân trọng khán giả của mình.
Dialogue: 0,0:10:07.66,0:10:11.33,Default,,0,0,0,,Bất luận thế nào, dù trong người không khỏe,\Nhay có chuyện bất trắc xảy ra...
Dialogue: 0,0:10:11.74,0:10:14.61,Default,,0,0,0,,...cô ấy vẫn luôn bước lên sân khấu\Nvì khán giả đang chờ đợi mình.
Dialogue: 0,0:10:15.30,0:10:17.36,Default,,0,0,0,,Lần duy nhất cô ấy nghỉ diễn...
Dialogue: 0,0:10:17.54,0:10:21.49,Default,,0,0,0,,...chính là hôm cô ấy bỏ ngang về quê\Nthăm bà vào mấy ngày trước đấy.
Dialogue: 0,0:10:26.86,0:10:34.28,Default,,0,0,0,,À phải rồi. Bác Chuu này, giờ mình đi xem\Ncon bé Mariko nhảy đi. Suất diễn đêm muộn ấy.
Dialogue: 0,0:10:37.78,0:10:39.98,Default,,0,0,0,,Phụ nữ không được vào xem sao?
Dialogue: 0,0:10:39.98,0:10:44.62,Default,,0,0,0,,Không, không phải thế... Nhưng với một người mẹ,\Ncó những thứ ở con gái mình mà...
Dialogue: 0,0:10:44.62,0:10:46.92,Default,,0,0,0,,Ông chủ, tính tiền giúp tôi nhé.
Dialogue: 0,0:10:47.67,0:10:48.93,Default,,0,0,0,,Vâng, có ngay.
Dialogue: 0,0:10:51.10,0:10:54.93,Default,,0,0,0,,Dù mang tiếng là vũ nữ thoát y, nhưng đời nào con bé\Nlại cởi sạch sành sanh trước mặt người ta chứ, đúng không?
Dialogue: 0,0:10:56.18,0:10:58.78,Default,,0,0,0,,Sao cơ? Cậu không rời chỗ làm được à?
Dialogue: 0,0:10:58.78,0:11:01.54,Default,,0,0,0,,Cứ viện đại lý do gì đó đi.\NDù thế nào thì cậu cũng phải tới đây ngay.
Dialogue: 0,0:11:01.54,0:11:04.37,Default,,0,0,0,,Tôi không đủ can đảm\Nđể đi xem cảnh này một mình đâu.
Dialogue: 0,0:11:04.74,0:11:07.43,Default,,0,0,0,,Bác Chuu ơi, đi lối này hả?
Dialogue: 0,0:11:09.54,0:11:11.15,Default,,0,0,0,,Trời ạ, nhanh cái chân lên, đi thôi!
Dialogue: 0,0:11:12.38,0:11:14.82,Default,,0,0,0,,Nó kiểu như nghệ thuật "nửa kín nửa hở" thôi phải không?\N(Chirarism: Nghệ thuật hé lộ thấp thoáng gợi cảm)
Dialogue: 0,0:11:14.82,0:11:17.59,Default,,0,0,0,,Không đâu. Nếu phải dùng từ chính xác,\Nthì nó thiên về chủ nghĩa "hiện thực trần trụi" hơn.
Dialogue: 0,0:11:18.71,0:11:20.99,Default,,0,0,0,,- Marilyn!\N- Marilyn!
Dialogue: 0,0:11:57.56,0:12:01.61,Default,,0,0,0,,Nghĩ đi nghĩ lại thì tôi vẫn thấy\Nmình không chịu nổi cảnh này đâu.
Dialogue: 0,0:12:01.61,0:12:04.17,Default,,0,0,0,,Xin mọi người dừng lại đi!
Dialogue: 0,0:12:06.28,0:12:09.61,Default,,0,0,0,,Mari-chan, xin em đừng\Nlàm công việc này nữa!
Dialogue: 0,0:12:16.85,0:12:18.82,Default,,0,0,0,,{\i1}Bộ kịch bản vốn là như thế hả?{\i0}
Dialogue: 0,0:12:33.22,0:12:35.63,Default,,0,0,0,,Anh đừng có làm em muối mặt như thế.
Dialogue: 0,0:12:37.22,0:12:40.30,Default,,0,0,0,,Có lẽ anh không thể chịu đựng nổi cảnh đó.
Dialogue: 0,0:12:41.30,0:12:45.04,Default,,0,0,0,,Dù có là múa thoát y đi chăng nữa...\Nthì đó cũng là thiên chức của em.
Dialogue: 0,0:12:45.54,0:12:47.18,Default,,0,0,0,,Đừng bao giờ làm gián đoạn màn trình diễn của em nữa.
Dialogue: 0,0:12:48.34,0:12:51.28,Default,,0,0,0,,Nhưng anh cũng là một thằng đàn ông mà...
Dialogue: 0,0:12:52.26,0:12:55.82,Default,,0,0,0,,Nếu anh là đàn ông, thì anh phải\Nchấp nhận mọi thứ thuộc về em chứ.
Dialogue: 0,0:12:58.38,0:13:00.89,Default,,0,0,0,,Xin phép cho tôi qua.
Dialogue: 0,0:13:02.30,0:13:06.82,Default,,0,0,0,,Ồ, anh bạn trai đây mà!\NPha vừa nãy của cậu ngầu lắm đấy.
Dialogue: 0,0:13:06.82,0:13:08.97,Default,,0,0,0,,Tôi cứ nghĩ đáng lẽ cậu phải\Nlàm thế ngay từ đầu rồi cơ.
Dialogue: 0,0:13:14.02,0:13:16.15,Default,,0,0,0,,Xin lỗi đã làm phiền.
Dialogue: 0,0:13:23.46,0:13:26.52,Default,,0,0,0,,Mẹ thấy vui không khi nhìn cảnh con gái mình trần truồng?
Dialogue: 0,0:13:26.58,0:13:28.19,Default,,0,0,0,,Con nhìn thấy mẹ à?
Dialogue: 0,0:13:32.38,0:13:35.73,Default,,0,0,0,,Có thể mẹ không biết chứ đứng trên sân khấu\Ncon nhìn rõ từng khán giả ở dưới đấy.
Dialogue: 0,0:13:36.06,0:13:38.56,Default,,0,0,0,,Đâu chỉ có khuôn mặt là thứ con cái\Nthừa hưởng từ cha mẹ mình...
Dialogue: 0,0:13:38.62,0:13:42.83,Default,,0,0,0,,Bộ ngực của con giống hệt của mẹ\Nhồi còn trẻ vậy.
Dialogue: 0,0:13:44.21,0:13:49.31,Default,,0,0,0,,Nhưng con định làm cái nghề này\Nđến bao giờ nữa hả?
Dialogue: 0,0:13:50.38,0:13:56.38,Default,,0,0,0,,Thề có Chúa... chưa bao giờ mẹ công nhận\Nbất cứ việc gì con làm cả.
Dialogue: 0,0:13:56.74,0:14:00.38,Default,,0,0,0,,Ngay cả ở trong bệnh viện, mẹ nói năng kiểu gì thế?\N"Con gái tôi là vũ công đấy."
Dialogue: 0,0:14:00.79,0:14:03.22,Default,,0,0,0,,Mẹ cứ nói thẳng con là "vũ nữ thoát y" đi cũng được mà.
Dialogue: 0,0:14:03.26,0:14:05.69,Default,,0,0,0,,Con sẽ tiếp tục nhảy cho đến khi thành một bà già thì thôi.
Dialogue: 0,0:14:05.91,0:14:08.81,Default,,0,0,0,,Tính con vẫn cứ bướng bỉnh như thế.
Dialogue: 0,0:14:08.81,0:14:11.26,Default,,0,0,0,,Từ bé đến lớn chẳng thay đổi\Nđược chút nào cả.
Dialogue: 0,0:14:11.47,0:14:13.91,Default,,0,0,0,,Mẹ về quê đi.
Dialogue: 0,0:14:14.21,0:14:17.30,Default,,0,0,0,,Suất diễn tiếp theo của con sắp bắt đầu rồi.
Dialogue: 0,0:14:30.18,0:14:31.42,Default,,0,0,0,,Con nhảy đẹp lắm.
Dialogue: 0,0:14:32.97,0:14:35.99,Default,,0,0,0,,{\i1}Vài ngày sau đó...{\i0}
Dialogue: 0,0:14:36.86,0:14:40.14,Default,,0,0,0,,- Ra vậy. Ngày mai bà sẽ bắt xe buýt về quê à.\N- Ừ.
Dialogue: 0,0:14:40.14,0:14:42.52,Default,,0,0,0,,Nhưng cứ thế mà về thì có ổn không, chuyện với Marilyn ấy...
Dialogue: 0,0:14:42.74,0:14:48.11,Default,,0,0,0,,Không sao đâu. Đằng nào gặp mặt nhau\Nhết chuyện lại quay ra cãi vã ấy mà...
Dialogue: 0,0:14:48.26,0:14:51.14,Default,,0,0,0,,Dù sao thì trước mắt tôi cũng đã báo cho con bé biết\Nchuyện tôi sắp kết hôn rồi.
Dialogue: 0,0:14:51.14,0:14:52.30,Default,,0,0,0,,Hả?
Dialogue: 0,0:14:52.82,0:14:54.42,Default,,0,0,0,,Bà sắp kết hôn ư?
Dialogue: 0,0:14:55.06,0:14:59.01,Default,,0,0,0,,Ông thấy đấy, người bạn trai hiện tại\Nvừa ngỏ lời cầu hôn tôi.
Dialogue: 0,0:14:59.90,0:15:04.11,Default,,0,0,0,,Tôi đã qua lại với biết bao người đàn ông rồi...\Nnhưng không biết người này đã là bến đỗ cuối cùng chưa.
Dialogue: 0,0:15:04.38,0:15:06.75,Default,,0,0,0,,Thế à. Ra là vậy...
Dialogue: 0,0:15:07.14,0:15:08.59,Default,,0,0,0,,Ông ấy là người thế nào hả bà?
Dialogue: 0,0:15:09.02,0:15:13.42,Default,,0,0,0,,Anh ấy là người đàn ông giản dị, chất phác nhất\Nmà tôi từng hẹn hò, nhưng mà...
Dialogue: 0,0:15:13.42,0:15:16.86,Default,,0,0,0,,Yuu-chan có điều gì đó rất khác với những người đàn ông trước đây.
Dialogue: 0,0:15:16.98,0:15:19.40,Default,,0,0,0,,Ra là một người khác biệt.
Dialogue: 0,0:15:20.06,0:15:25.81,Default,,0,0,0,,Yuu-chan có gu kỳ lạ lắm,\Nanh ấy lại muốn lấy một người đang mang bệnh vào thân.
Dialogue: 0,0:15:26.22,0:15:27.65,Default,,0,0,0,,Người mang bệnh ư!?
Dialogue: 0,0:15:28.82,0:15:32.78,Default,,0,0,0,,Thực ra chuyến này tôi lên Tokyo\Nlà để kiểm tra sức khỏe chuyên sâu.
Dialogue: 0,0:15:32.90,0:15:33.88,Default,,0,0,0,,Kiểm tra sức khỏe ư?
Dialogue: 0,0:15:34.74,0:15:35.88,Default,,0,0,0,,Bà khám bệnh gì cơ?
Dialogue: 0,0:15:35.88,0:15:38.39,Default,,0,0,0,,Khám xong xuôi cả rồi. Vừa đặt chân tới Tokyo\Nlà tôi đến bệnh viện ngay.
Dialogue: 0,0:15:38.39,0:15:39.38,Default,,0,0,0,,Rồi kết quả sao rồi?
Dialogue: 0,0:15:39.38,0:15:41.86,Default,,0,0,0,,Giờ tôi về quê chờ kết quả gửi về thôi.
Dialogue: 0,0:15:41.86,0:15:45.56,Default,,0,0,0,,Nếu không phải ung thư di căn thì sẽ không\Ncần phải dùng đến thuốc chống ung thư.
Dialogue: 0,0:15:45.66,0:15:48.83,Default,,0,0,0,,Chuyện hệ trọng như thế mà bà không nói cho Marilyn biết\Nlà không được đâu.
Dialogue: 0,0:15:48.86,0:15:53.53,Default,,0,0,0,,Từ trước đến nay tôi vốn sống ích kỷ cho riêng mình rồi,\Nđến nước này tôi không muốn làm gánh nặng cho con bé nữa.
Dialogue: 0,0:15:53.67,0:15:54.90,Default,,0,0,0,,Của bà đây.
Dialogue: 0,0:15:58.06,0:15:59.17,Default,,0,0,0,,Món này...
Dialogue: 0,0:16:01.54,0:16:04.81,Default,,0,0,0,,Hôm nhìn thấy món này...
Dialogue: 0,0:16:06.38,0:16:14.08,Default,,0,0,0,,...Marilyn đã bồi hồi nhớ lại ngày xưa\Nbà thường xuyên làm món này cho cô ấy ăn.
Dialogue: 0,0:16:15.90,0:16:17.79,Default,,0,0,0,,Tôi tự hỏi liệu hương vị ấy...
Dialogue: 0,0:16:18.38,0:16:21.16,Default,,0,0,0,,...có phải là thứ mà con bé chưa bao giờ quên được hay không.
Dialogue: 0,0:16:33.57,0:16:36.27,Default,,0,0,0,,Mari-chan có ghé qua đây không hả Ông chủ?
Dialogue: 0,0:16:37.06,0:16:37.98,Default,,0,0,0,,Không thấy đâu.
Dialogue: 0,0:16:38.62,0:16:45.02,Default,,0,0,0,,Vậy ạ. Có chuyện này tôi muốn\Nxin lỗi cô ấy.
Dialogue: 0,0:16:47.30,0:16:50.69,Default,,0,0,0,,À, mẹ của cô ấy vừa mới rời khỏi đây một lúc trước...
Dialogue: 0,0:16:51.38,0:16:54.69,Default,,0,0,0,,Bà ấy đang ra bến xe,\Nhôm nay bà ấy sẽ về quê đấy.
Dialogue: 0,0:16:55.10,0:16:56.39,Default,,0,0,0,,Vậy sao ạ...
Dialogue: 0,0:17:08.10,0:17:09.97,Default,,0,0,0,,Bà Eri này, tôi...
Dialogue: 0,0:17:11.22,0:17:14.64,Default,,0,0,0,,Bác Chuu à, tôi thực sự rất cảm ơn bác.
Dialogue: 0,0:17:15.66,0:17:20.49,Default,,0,0,0,,Tôi đã được gặp lại Mariko, và\Nthấy con bé vẫn khỏe mạnh...
Dialogue: 0,0:17:21.62,0:17:24.22,Default,,0,0,0,,Tất cả là nhờ có bác đấy.
Dialogue: 0,0:17:25.34,0:17:29.39,Default,,0,0,0,,Tôi chỉ là một lão già nát rượu thôi mà.
Dialogue: 0,0:17:31.50,0:17:32.49,Default,,0,0,0,,Bà nhớ giữ gìn sức khỏe nhé.
Dialogue: 0,0:17:33.26,0:17:36.77,Default,,0,0,0,,À phải rồi. Lần tới bác nhớ\Nghé quê tôi chơi một chuyến nhé!
Dialogue: 0,0:17:42.56,0:17:44.01,Default,,0,0,0,,Kimi-kun...
Dialogue: 0,0:17:48.85,0:17:52.13,Default,,0,0,0,,Chị Marilyn, có hoa gửi tặng chị này.
Dialogue: 0,0:17:52.18,0:17:53.22,Default,,0,0,0,,Hả?
Dialogue: 0,0:17:53.42,0:17:55.82,Default,,0,0,0,,À... cứ để ở đằng kia giúp chị.
Dialogue: 0,0:17:56.38,0:17:59.33,Default,,0,0,0,,Còn mười phút nữa là tới giờ diễn nhé.\NHẹn gặp lại chị sau.
Dialogue: 0,0:17:59.54,0:18:00.55,Default,,0,0,0,,Ừ, cảm ơn em.
Dialogue: 0,0:18:07.86,0:18:13.70,Default,,0,0,0,,[Ít nhất hãy biết giữ gìn thân thể mình nhé con. Mẹ có thể\Nlà một người mẹ tồi nhưng mẹ vẫn luôn mong hai ta\Nmãi là mẹ con của nhau cho đến cuối đời. ~Mẹ]
Dialogue: 0,0:18:17.06,0:18:18.41,Default,,0,0,0,,Chuyện này là sao?
Dialogue: 0,0:18:18.41,0:18:19.64,Default,,0,0,0,,Hoa của mẹ em gửi đấy.
Dialogue: 0,0:18:20.02,0:18:21.24,Default,,0,0,0,,Cái đó thì em biết rồi.
Dialogue: 0,0:18:22.10,0:18:26.42,Default,,0,0,0,,Ông chủ Quán Ăn Đêm đã báo cho anh biết\Nlà sáng nay mẹ em bắt xe về quê.
Dialogue: 0,0:18:26.50,0:18:28.89,Default,,0,0,0,,Nên anh đã ra bến xe tiễn bác ấy.
Dialogue: 0,0:18:29.18,0:18:31.02,Default,,0,0,0,,Anh đâu cần phải làm thế!
Dialogue: 0,0:18:31.02,0:18:36.53,Default,,0,0,0,,Sự thật là mẹ em lên Tokyo lần này\Nlà để làm xét nghiệm chuyên sâu tại bệnh viện đại học.
Dialogue: 0,0:18:39.74,0:18:45.37,Default,,0,0,0,,Nhưng vì không muốn làm em lo lắng,\Nbác ấy đã nói dối rằng mình lên đây đi du lịch.
Dialogue: 0,0:18:46.66,0:18:52.40,Default,,0,0,0,,Rồi bác ấy đưa tiền nhờ anh\Nmua một bó hoa gửi tặng em.
Dialogue: 0,0:18:55.38,0:18:59.02,Default,,0,0,0,,Mẹ em đã cúi đầu trước anh...
Dialogue: 0,0:18:59.82,0:19:05.16,Default,,0,0,0,,...bác ấy nói "Xin cậu hãy chăm sóc cho Mariko"\Nvà cứ thế cúi đầu hết lần này đến lần khác.
Dialogue: 0,0:19:09.82,0:19:12.03,Default,,0,0,0,,Đúng là bà mẹ ngốc nghếch.
Dialogue: 0,0:19:13.94,0:19:17.13,Default,,0,0,0,,Anh sẽ chấp nhận...
Dialogue: 0,0:19:17.74,0:19:18.96,Default,,0,0,0,,...tất cả mọi thứ thuộc về em.
Dialogue: 0,0:19:19.34,0:19:23.47,Default,,0,0,0,,{\i1}"Tiếp theo là màn trình diễn của Marilyn..."{\i0}
Dialogue: 0,0:19:23.78,0:19:26.13,Default,,0,0,0,,Chị Marilyn ơi, đến lượt chị rồi.
Dialogue: 0,0:19:26.14,0:19:27.17,Default,,0,0,0,,Ừ, chị ra ngay.
Dialogue: 0,0:19:46.23,0:19:51.57,Default,,0,0,0,,{\i1}Nghe đâu kết quả xét nghiệm chuyên sâu cho thấy\Nkhông có dấu hiệu của ung thư di căn.{\i0}
Dialogue: 0,0:19:52.97,0:19:57.77,Default,,0,0,0,,{\i1}Rồi một tháng sau đó,\Nbà Eri tổ chức đám cưới.{\i0}
Dialogue: 0,0:20:00.78,0:20:06.18,Default,,0,0,0,,{\i1}Nghe nói buổi lễ chỉ có cô dâu chú rể, Marilyn\Nvà vài người bạn thân thiết góp mặt, nhưng...{\i0}
Dialogue: 0,0:20:06.18,0:20:09.79,Default,,0,0,0,,{\i1}...bà Eri đã vô cùng hạnh phúc.{\i0}
Dialogue: 0,0:20:10.78,0:20:15.66,Default,,0,0,0,,Sao lại trưng ra cái mặt phụng phịu thế kia hả Marilyn,\Ntrong một dịp trọng đại đáng mừng thế này.
Dialogue: 0,0:20:15.66,0:20:17.19,Default,,0,0,0,,Hai mẹ con cô ấy lại cãi nhau đấy ạ.
Dialogue: 0,0:20:17.50,0:20:20.16,Default,,0,0,0,,Tại bà ấy cứ chê bộ đồ em mặc trông bần tiện.
Dialogue: 0,0:20:20.22,0:20:23.03,Default,,0,0,0,,Xong mẹ cô ấy còn bồi thêm một câu:\N"Mày chẳng mặc gì trông còn đẹp hơn."
Dialogue: 0,0:20:25.70,0:20:27.17,Default,,0,0,0,,Xin lỗi vì đã để mọi người chờ lâu.
Dialogue: 0,0:20:29.88,0:20:31.91,Default,,0,0,0,,Em xin phép dùng bữa ạ.
Dialogue: 0,0:20:41.42,0:20:43.02,Default,,0,0,0,,Hương vị có giống với ngày xưa cô từng ăn không?
Dialogue: 0,0:20:45.16,0:20:48.49,Default,,0,0,0,,Mẹ cô đã truyền lại công thức của bà ấy cho tôi đấy.
Dialogue: 0,0:21:03.02,0:21:08.08,Default,,0,0,0,,Em đã luôn khao khát được ăn lại\Nmón bắp cải cuộn thịt của mẹ.
Dialogue: 0,0:21:30.25,0:21:34.65,Default,,0,0,0,,Khi sơ chế trước, mọi người hãy vạt bớt phần cuống thế này\Nthì lúc cuộn sẽ dễ dàng hơn nhiều.
Dialogue: 0,0:21:34.66,0:21:37.42,Default,,0,0,0,,Hãy cuộn thật nhẹ nhàng và gửi gắm cả tấm lòng vào đó.
Dialogue: 0,0:21:37.42,0:21:40.68,Default,,0,0,0,,Phụ nữ mà không được nâng niu như thế là không xong đâu.
Dialogue: 0,0:21:41.96,0:21:47.68,Default,,0,0,0,,Khi xếp bắp cải cuộn vào nồi súp, tuyệt đối đừng chạm đũa vào\Ntrong lúc đang ninh kẻo chúng sẽ bị bung nát.
Dialogue: 0,0:21:47.72,0:21:49.71,Default,,0,0,0,,Vậy nhé, chúc mọi người một đêm ngon giấc.
