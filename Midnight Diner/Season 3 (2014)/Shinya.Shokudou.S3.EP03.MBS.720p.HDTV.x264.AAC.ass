Dialogue: 0,0:00:06.67,0:00:10.90,Default,,0,0,0,,KOBAYASHI KAORU
Dialogue: 0,0:00:12.37,0:00:16.64,Default,,0,0,0,,ISHIBASHI KEI
Dialogue: 0,0:00:19.13,0:00:23.50,Default,,0,0,0,,FUCHIGAMI YASUSHI
Dialogue: 0,0:00:23.50,0:00:33.08,Default,,0,0,0,,Kimi ga haita shiroi iki ga ima yukkuri kaze ni notte\N{\i1}Làn hơi trắng em thở ra, giờ đây chầm chậm cưỡi lên làn gió{\i0}
Dialogue: 0,0:00:33.08,0:00:43.64,Default,,0,0,0,,Sora ni ukabu kumo no naka ni sukoshi zutsu kiete yuku\N{\i1}Hòa vào những đám mây trôi trên bầu trời, rồi dần dần tan biến{\i0}
Dialogue: 0,0:00:43.64,0:00:53.53,Default,,0,0,0,,Toku takai sora no naka de te o nobasu shiroi kumo\N{\i1}Từ bầu trời cao vời vợi, đám mây trắng vươn tay xuống{\i0}
Dialogue: 0,0:00:53.53,0:00:55.00,Default,,0,0,0,,Kimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:00:55.00,0:01:00.51,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày và vội vã trở về nhà...{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:01:00.51,0:01:03.07,Default,,0,0,0,,{\i1}...thì ngày mới của tôi mới bắt đầu.{\i0}\NKimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:01:03.07,0:01:03.35,Default,,0,0,0,,Kimi ga haita iki o sutte pokkari to ukan deru\N{\i1}Hít lấy hơi thở em phả ra rồi lơ lửng trôi{\i0}
Dialogue: 0,0:01:04.39,0:01:13.86,Default,,0,0,0,,Zutto mukashi no koto no yoda ne\N{\i1}Ngỡ như đã là chuyện của ngày xưa cũ{\i0}
Dialogue: 0,0:01:14.73,0:01:19.83,Default,,0,0,0,,Kawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông{\i0}
Dialogue: 0,0:01:19.83,0:01:24.97,Default,,0,0,0,,{\i1}Quán ăn của tôi mở cửa từ nửa đêm đến 7 giờ sáng.{\i0}\NKawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông{\i0}
Dialogue: 0,0:01:24.97,0:01:25.50,Default,,0,0,0,,Kawamo no ue o kumo ga nagareru\N{\i1}Mây trôi lững lờ trên mặt sông{\i0}
Dialogue: 0,0:01:25.50,0:01:30.03,Default,,0,0,0,,{\i1}Người ta thường gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:33.14,0:01:37.78,Default,,0,0,0,,{\i1}Bạn hỏi liệu giờ đó có khách khứa nào ghé không ư?...\NThực ra là đông hơn bạn tưởng nhiều đấy.{\i0}
Dialogue: 0,0:01:40.04,0:01:48.62,Default,,0,0,0,,{\i1}Phụ đề Việt ngữ bởi Amtia(NOFACE):{\i0}\N{\b1}SHINYA SHOKUDO - QUÁN ĂN ĐÊM (Phần 3){\b0}\NTập 3: "Khoai Sọ Ninh Mực Ống..."
Dialogue: 0,0:02:09.29,0:02:11.96,Default,,0,0,0,,{\i1}Vào những ngày tôi lỡ tay nấu hơi nhiều\Nmột món ninh kho nào đó...{\i0}
Dialogue: 0,0:02:11.96,0:02:17.68,Default,,0,0,0,,{\i1}...đôi khi tôi lại đun nóng lên để hương thơm\Nlan tỏa khắp không gian quán.{\i0}
Dialogue: 0,0:02:20.79,0:02:22.98,Default,,0,0,0,,Là khoai sọ ninh mực ống phải không?
Dialogue: 0,0:02:23.12,0:02:28.11,Default,,0,0,0,,Đoán chuẩn đấy. Khứu giác của cô lúc nào cũng\Nnhạy bén thật nhỉ, cô Satomi?
Dialogue: 0,0:02:28.11,0:02:29.64,Default,,0,0,0,,Cho tôi một phần món đó nhé.
Dialogue: 0,0:02:29.64,0:02:31.18,Default,,0,0,0,,À, cho tôi một phần nữa.
Dialogue: 0,0:02:31.18,0:02:33.36,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:02:35.32,0:02:37.32,Default,,0,0,0,,{\i1}Đây cũng là một chiêu bán hàng của riêng tôi đấy.{\i0}
Dialogue: 0,0:02:48.46,0:02:50.47,Default,,0,0,0,,Ông chủ ơi, ngon tuyệt cú mèo!
Dialogue: 0,0:02:50.47,0:02:52.18,Default,,0,0,0,,Mừng vì cô hợp khẩu vị.
Dialogue: 0,0:02:52.18,0:02:55.28,Default,,0,0,0,,Chẳng hiểu sao hai nguyên liệu này kết hợp với nhau lại ăn ý đến lạ.
Dialogue: 0,0:02:58.30,0:03:00.41,Default,,0,0,0,,Cậu cũng gọi món gì đi chứ,\Nđừng có ngại.
Dialogue: 0,0:03:02.34,0:03:06.73,Default,,0,0,0,,Dạ thôi... Tự dưng em chẳng thấy đói bụng chút nào.
Dialogue: 0,0:03:07.69,0:03:10.47,Default,,0,0,0,,Đúng như chị nghĩ, cậu không hợp với nghề này đâu.
Dialogue: 0,0:03:10.47,0:03:12.34,Default,,0,0,0,,Cậu ấy là người mới à?
Dialogue: 0,0:03:12.44,0:03:15.04,Default,,0,0,0,,Cậu ấy đang trong thời gian thử việc. Tên là Sasaki.
Dialogue: 0,0:03:16.52,0:03:19.08,Default,,0,0,0,,Thú thật là...
Dialogue: 0,0:03:19.33,0:03:23.02,Default,,0,0,0,,Em không ngờ chuyện ngoại tình và phản bội...
Dialogue: 0,0:03:23.02,0:03:25.67,Default,,0,0,0,,...lại xảy ra nhan nhản nhiều đến mức này.
Dialogue: 0,0:03:25.67,0:03:27.85,Default,,0,0,0,,Đó chẳng phải là bản năng của con người hay sao?
Dialogue: 0,0:03:27.85,0:03:31.18,Default,,0,0,0,,Chính vì người ta cứ cố tô hồng\Ngông cùm của hôn nhân...
Dialogue: 0,0:03:31.18,0:03:33.34,Default,,0,0,0,,...nên mọi chuyện mới trở nên rắc rối phức tạp đấy thôi.
Dialogue: 0,0:03:33.34,0:03:35.65,Default,,0,0,0,,Hai người làm nghề gì thế?
Dialogue: 0,0:03:35.78,0:03:38.93,Default,,0,0,0,,Văn phòng thám tử tư. Chuyên điều tra\Nmấy vụ ngoại tình và những chuyện đại loại thế.
Dialogue: 0,0:03:38.93,0:03:40.97,Default,,0,0,0,,Ồ, ra hai người là thám tử tư à.
Dialogue: 0,0:03:40.97,0:03:43.37,Default,,0,0,0,,Thảo nào mũi cô lại thính đến thế.
Dialogue: 0,0:03:49.96,0:03:52.75,Default,,0,0,0,,Nhưng mà chị Satomi này...
Dialogue: 0,0:03:52.75,0:03:55.56,Default,,0,0,0,,...sao chị lại chọn dấn thân vào công việc này thế ạ?
Dialogue: 0,0:03:55.74,0:03:59.76,Default,,0,0,0,,Chuyện dài lắm, chỉ một bình rượu thế này\Nthì chẳng thể nào kể hết được đâu.
Dialogue: 0,0:03:59.84,0:04:02.05,Default,,0,0,0,,Ông chủ, cho tụi tôi thêm rượu nhé.
Dialogue: 0,0:04:02.15,0:04:04.37,Default,,0,0,0,,Quán tôi chỉ phục vụ tối đa 3 bình thôi đấy nhé.
Dialogue: 0,0:04:10.03,0:04:14.08,Default,,0,0,0,,Dù cậu ta có bảo là tửu lượng kém,\Nnhưng không ngờ lại gục nhanh đến thế.
Dialogue: 0,0:04:14.20,0:04:16.51,Default,,0,0,0,,Kém cỏi quá nhỉ?
Dialogue: 0,0:04:17.46,0:04:20.04,Default,,0,0,0,,Cậu ta tốt nghiệp từ một trường đại học danh giá...
Dialogue: 0,0:04:20.04,0:04:22.67,Default,,0,0,0,,...lúc mới đi làm nghe đâu cũng\Nchăm chỉ đàng hoàng lắm, nhưng mà...
Dialogue: 0,0:04:22.67,0:04:25.69,Default,,0,0,0,,...chẳng hiểu sao đùng một cái lại đâm ra\Nsợ hãi không dám bước chân tới công ty nữa.
Dialogue: 0,0:04:25.79,0:04:27.30,Default,,0,0,0,,Tại sao thế?
Dialogue: 0,0:04:27.60,0:04:31.78,Default,,0,0,0,,Cậu ta bảo có lẽ do mình thất bại trong việc\Nxây dựng các mối quan hệ giữa người với người...
Dialogue: 0,0:04:32.05,0:04:33.79,Default,,0,0,0,,Thế mà chẳng hiểu nghĩ sao...
Dialogue: 0,0:04:33.79,0:04:37.59,Default,,0,0,0,,...giờ lại đòi nghỉ luôn cả cái nghề\Nchuyên đi đào bới mặt tối của thiên hạ này.
Dialogue: 0,0:04:46.54,0:04:49.28,Default,,0,0,0,,Sasaki, dậy đi nào.\NVề nhà thôi.
Dialogue: 0,0:04:52.94,0:04:55.01,Default,,0,0,0,,Hai người có ổn không đấy?
Dialogue: 0,0:04:55.24,0:04:57.46,Default,,0,0,0,,Không sao đâu, tôi lo được mà.
Dialogue: 0,0:04:59.96,0:05:01.65,Default,,0,0,0,,Taxi!
Dialogue: 0,0:05:02.02,0:05:05.37,Default,,0,0,0,,Kiểu phụ nữ như cô nàng đó người ta gọi là\Nphụ nữ có phong thái "soái ca" đấy nhỉ?
Dialogue: 0,0:05:05.37,0:05:07.07,Default,,0,0,0,,Nhưng một người phụ nữ như thế...
Dialogue: 0,0:05:07.07,0:05:10.22,Default,,0,0,0,,...lại chẳng bao giờ muốn ràng buộc đời mình làm bạn đời của ai đâu.
Dialogue: 0,0:05:10.94,0:05:15.44,Default,,0,0,0,,{\i1}Dẫu vậy, chuyện tình cảm giữa đàn ông và phụ nữ\Nđối với tôi vẫn luôn là một ẩn số khó lường.{\i0}
Dialogue: 0,0:05:35.10,0:05:38.12,Default,,0,0,0,,Tôi chẳng bao giờ mua vé số (takarakuji) cả.
Dialogue: 0,0:05:38.12,0:05:40.52,Default,,0,0,0,,Nó chẳng khác nào bỏ tiền mua "lâu đài trên không" ấy nhỉ?
Dialogue: 0,0:05:40.77,0:05:42.71,Default,,0,0,0,,Mấy thứ đó đúng là trò "tanuki*" mà, phải không?\N(*Lừa phỉnh; đồng thời là chơi chữ "loại bỏ chữ 'ta'" trong tiếng Nhật).
Dialogue: 0,0:05:42.78,0:05:44.05,Default,,0,0,0,,"Tanuki" là sao cơ?
Dialogue: 0,0:05:44.05,0:05:46.62,Default,,0,0,0,,Thì suy cho cùng nó cũng chỉ là "karakuji" thôi mà.
Dialogue: 0,0:05:48.34,0:05:53.18,Default,,0,0,0,,Nghĩ mà xem... Nếu cậu bỏ chữ "ta" (tanuki)\Nra khỏi chữ "takarakuji" (vé số)...
Dialogue: 0,0:05:53.18,0:05:55.29,Default,,0,0,0,,Ồ, thế thì nó thành "karakuji" (vé trật lất)...
Dialogue: 0,0:05:55.48,0:05:57.97,Default,,0,0,0,,Thiệt tình, bác Chu ơi, mấy câu chơi chữ của bác\Nxoắn não quá, cháu chẳng cười nổi đâu.
Dialogue: 0,0:05:57.97,0:06:00.17,Default,,0,0,0,,Tại cậu thiếu kiến thức đấy thôi.
Dialogue: 0,0:06:00.98,0:06:01.75,Default,,0,0,0,,Chào buổi tối.
Dialogue: 0,0:06:01.75,0:06:02.74,Default,,0,0,0,,Xin kính chào quý khách.
Dialogue: 0,0:06:03.44,0:06:05.03,Default,,0,0,0,,- Chào mọi người.\N- Chào cô.
Dialogue: 0,0:06:06.26,0:06:08.68,Default,,0,0,0,,Ông chủ, cho tôi một cốc bia nhé.
Dialogue: 0,0:06:09.31,0:06:12.01,Default,,0,0,0,,Cô ấy chính là người phụ nữ "soái tỷ"\Nmà hôm trước tôi kể với cậu đấy.
Dialogue: 0,0:06:13.48,0:06:16.07,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:06:16.07,0:06:19.88,Default,,0,0,0,,Cậu thanh niên hôm nọ không sao chứ?\NHôm đó cậu ta say bí tỉ còn gì.
Dialogue: 0,0:06:20.02,0:06:21.73,Default,,0,0,0,,Tôi đã có một phen bất ngờ đấy.
Dialogue: 0,0:06:21.83,0:06:24.40,Default,,0,0,0,,...Cậu Sasaki hóa ra vẫn còn là trai tân.
Dialogue: 0,0:06:24.83,0:06:26.25,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:28.37,0:06:31.45,Default,,0,0,0,,Này cô em, cô đã làm chuyện đó với cậu ta rồi hả?
Dialogue: 0,0:06:31.65,0:06:34.16,Default,,0,0,0,,À thì, đại loại vậy.
Dialogue: 0,0:06:34.16,0:06:36.59,Default,,0,0,0,,Không ngờ đó lại là lần đầu tiên của cậu ta.
Dialogue: 0,0:06:36.69,0:06:38.78,Default,,0,0,0,,Giờ cậu ta chẳng chịu đến văn phòng làm việc nữa.
Dialogue: 0,0:06:38.78,0:06:42.31,Default,,0,0,0,,Tin nhắn tôi gửi cũng chẳng thèm hồi âm...\NKhông biết có phải tôi đã làm mọi chuyện tệ hơn không.
Dialogue: 0,0:06:42.31,0:06:44.95,Default,,0,0,0,,Chẳng biết như thế là tốt...\Nhay là xấu nữa...
Dialogue: 0,0:06:44.95,0:06:46.48,Default,,0,0,0,,Cậu ấy có ghé qua đây không Ông chủ?
Dialogue: 0,0:06:46.48,0:06:47.83,Default,,0,0,0,,Không thấy cậu ấy ghé.
Dialogue: 0,0:06:48.10,0:06:51.04,Default,,0,0,0,,Trước mắt thì tôi vẫn đang đợi cậu ấy nhắn lại.
Dialogue: 0,0:06:53.59,0:06:55.18,Default,,0,0,0,,Cậu Sasaki.
Dialogue: 0,0:06:55.71,0:06:57.91,Default,,0,0,0,,Cậu đã đọc tin nhắn của chị chưa?
Dialogue: 0,0:07:03.34,0:07:05.47,Default,,0,0,0,,Chị Satomi...
Dialogue: 0,0:07:06.84,0:07:08.83,Default,,0,0,0,,À ừm...
Dialogue: 0,0:07:10.16,0:07:11.94,Default,,0,0,0,,Chúng mình có thể...
Dialogue: 0,0:07:13.23,0:07:16.33,Default,,0,0,0,,...hẹn hò nghiêm túc\Nvới tiền đề tiến tới hôn nhân được không ạ?
Dialogue: 0,0:07:16.33,0:07:17.38,Default,,0,0,0,,Cái gì cơ?
Dialogue: 0,0:07:17.38,0:07:21.90,Default,,0,0,0,,Hả? Sao tự dưng cậu lại muốn\Nkết hôn với chị?
Dialogue: 0,0:07:22.30,0:07:24.86,Default,,0,0,0,,Thì tại đêm hôm đó...
Dialogue: 0,0:07:25.06,0:07:27.24,Default,,0,0,0,,Cậu bị ngốc à?
Dialogue: 0,0:07:27.24,0:07:30.03,Default,,0,0,0,,Chúng ta mới chỉ ngủ với nhau có một lần thôi mà.
Dialogue: 0,0:07:30.03,0:07:34.12,Default,,0,0,0,,Chị Satomi, chẳng lẽ chị không thích em sao?
Dialogue: 0,0:07:34.38,0:07:38.88,Default,,0,0,0,,Chị đã ngủ với em rồi\Nmà lại chẳng có chút tình cảm nào với em ư?
Dialogue: 0,0:07:38.88,0:07:41.47,Default,,0,0,0,,Sao cậu lại thốt ra mấy câu\Ny hệt phụ nữ hay trách móc thế hả?
Dialogue: 0,0:07:41.47,0:07:45.17,Default,,0,0,0,,Ngay từ đầu, chị đã chẳng có chút hứng thú nào với chuyện kết hôn rồi.
Dialogue: 0,0:07:47.05,0:07:51.75,Default,,0,0,0,,Tình cảm của chị ấy à...\Nkhông đơn giản như cậu nghĩ đâu.
Dialogue: 0,0:07:58.19,0:08:00.50,Default,,0,0,0,,Tôi nói có sai đâu? Cô nàng đúng chuẩn "soái tỷ" mà.
Dialogue: 0,0:08:00.50,0:08:02.29,Default,,0,0,0,,Phải gọi là quá "ngầu" mới đúng.
Dialogue: 0,0:08:02.29,0:08:11.02,Default,,0,0,0,,Kiểu phụ nữ như cô ấy có thể dễ dàng\Ntrao thân xác, nhưng... trái tim thì tuyệt đối không.
Dialogue: 0,0:08:12.43,0:08:14.92,Default,,0,0,0,,Ngày xửa ngày xưa, có một...
Dialogue: 0,0:08:15.21,0:08:20.58,Default,,0,0,0,,...cô gái trong sáng, chẳng bao giờ biết nghi ngờ ai.
Dialogue: 0,0:08:20.98,0:08:25.26,Default,,0,0,0,,Cô gái ấy có một vị hôn phu vô cùng tuyệt vời.
Dialogue: 0,0:08:26.27,0:08:30.01,Default,,0,0,0,,Một ngày nọ, cô gái tình cờ nhìn thấy vị hôn phu của mình...
Dialogue: 0,0:08:30.01,0:08:33.48,Default,,0,0,0,,...bước lên một chiếc xe taxi...
Dialogue: 0,0:08:33.98,0:08:36.49,Default,,0,0,0,,Nổi hứng tinh nghịch...
Dialogue: 0,0:08:36.49,0:08:40.02,Default,,0,0,0,,...cô nàng bèn nảy ra ý định bám theo chiếc taxi đó xem sao.
Dialogue: 0,0:08:40.57,0:08:43.67,Default,,0,0,0,,Bởi lẽ cô gái ấy vốn rất mê phim trinh thám.
Dialogue: 0,0:08:46.51,0:08:48.49,Default,,0,0,0,,Rồi sau đó...
Dialogue: 0,0:08:49.79,0:08:51.65,Default,,0,0,0,,...chuyện gì đã xảy ra ạ?
Dialogue: 0,0:08:51.92,0:08:54.24,Default,,0,0,0,,Cô gái ấy...
Dialogue: 0,0:08:54.88,0:08:57.68,Default,,0,0,0,,...đã tận mắt chứng kiến cảnh vị hôn phu của mình ngoại tình.
Dialogue: 0,0:09:01.47,0:09:03.93,Default,,0,0,0,,Kể từ ngày hôm đó...
Dialogue: 0,0:09:03.93,0:09:07.88,Default,,0,0,0,,...ngày nào cô cũng âm thầm theo dõi vị hôn phu.
Dialogue: 0,0:09:08.36,0:09:12.63,Default,,0,0,0,,Lâu dần, cô đâm ra nghiện luôn\Ncái cảm giác rình rập theo dõi ấy...
Dialogue: 0,0:09:13.60,0:09:16.85,Default,,0,0,0,,Và đó chính là lý do đưa đẩy cô vào làm việc\Ntại một văn phòng thám tử tư.
Dialogue: 0,0:09:21.97,0:09:27.59,Default,,0,0,0,,Thế còn... người vị hôn phu kia thì sao ạ?
Dialogue: 0,0:09:27.94,0:09:30.40,Default,,0,0,0,,Cô gái đã thu thập đầy đủ bằng chứng ngoại tình...
Dialogue: 0,0:09:30.40,0:09:35.50,Default,,0,0,0,,...đòi một khoản tiền bồi thường tổn thất tinh thần,\Nrồi thẳng tay hủy bỏ hôn ước.
Dialogue: 0,0:09:35.50,0:09:37.38,Default,,0,0,0,,Cậu Sasaki này.
Dialogue: 0,0:09:38.33,0:09:39.69,Default,,0,0,0,,Dạ.
Dialogue: 0,0:09:41.28,0:09:46.24,Default,,0,0,0,,Con người ta sẽ chẳng thể nào sinh tồn nổi nếu không tự biến mình trở nên mạnh mẽ.
Dialogue: 0,0:10:01.52,0:10:04.22,Default,,0,0,0,,Này. Vụ tiếp theo là một ca điều tra ngoại tình đấy.
Dialogue: 0,0:10:05.67,0:10:08.39,Default,,0,0,0,,Tại sao con người ta lại cứ phạm sai lầm thế nhỉ?
Dialogue: 0,0:10:11.13,0:10:15.80,Default,,0,0,0,,Em cứ nghĩ nếu một sai lầm được che giấu hoàn hảo không kẽ hở,\Nthì nó sẽ nghiễm nhiên trở thành đáp án đúng.
Dialogue: 0,0:10:15.80,0:10:17.32,Default,,0,0,0,,Cậu nói cũng có lý đấy.
Dialogue: 0,0:10:18.15,0:10:22.22,Default,,0,0,0,,À này, hay là vụ này chúng ta giao cho\Ncậu Sasaki tự mình đảm nhận luôn đi?
Dialogue: 0,0:10:22.22,0:10:23.69,Default,,0,0,0,,Cậu ấy á?
Dialogue: 0,0:10:23.69,0:10:25.18,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:25.18,0:10:27.78,Default,,0,0,0,,Coi như đây là bài thi tốt nghiệp để cậu ấy\Nđược nhận làm nhân viên chính thức luôn.
Dialogue: 0,0:10:35.39,0:10:36.88,Default,,0,0,0,,Món đó là cá bơn kho (karei no nitsuke) phải không ạ?
Dialogue: 0,0:10:37.13,0:10:39.81,Default,,0,0,0,,Rất tiếc, đoán trật rồi. Của cậu đây.
Dialogue: 0,0:10:39.81,0:10:41.96,Default,,0,0,0,,Em đoán cũng gần trúng rồi mà.\NChỉ khác mỗi chữ "karei" (cá bơn) với "karee" (cà ri) thôi nhỉ?\N(*Trong tiếng Nhật "karee" và "karei" phát âm gần giống nhau)
Dialogue: 0,0:10:41.96,0:10:44.36,Default,,0,0,0,,Chẳng phải là trật lất một trời một vực luôn hay sao?
Dialogue: 0,0:10:44.36,0:10:46.38,Default,,0,0,0,,Dạo này công việc của cậu thế nào rồi?
Dialogue: 0,0:10:46.70,0:10:51.14,Default,,0,0,0,,Dạ... cũng khá vất vả nhưng...\Nnhìn chung em vẫn xoay xở ổn ạ.
Dialogue: 0,0:10:51.80,0:10:54.09,Default,,0,0,0,,Chỉ có điều, chị Satomi...
Dialogue: 0,0:10:54.09,0:10:57.74,Default,,0,0,0,,...cứ giữ thái độ lạnh nhạt với em suốt từ sau hôm đó...
Dialogue: 0,0:10:57.74,0:11:01.61,Default,,0,0,0,,Thật sao? Hôm nọ lúc cô ấy ghé quán\Nmột mình...
Dialogue: 0,0:11:01.61,0:11:06.92,Default,,0,0,0,,...cô ấy đã khen cậu đấy, bảo là:\N"Dạo này cậu ấy làm việc chăm chỉ lắm."
Dialogue: 0,0:11:06.92,0:11:09.07,Default,,0,0,0,,Thật thế hả Ông chủ?
Dialogue: 0,0:11:09.62,0:11:12.62,Default,,0,0,0,,Hy vọng là nếu phi vụ điều tra tiếp theo này suôn sẻ...
Dialogue: 0,0:11:12.62,0:11:16.46,Default,,0,0,0,,...em sẽ chính thức được công nhận\Nlà một thám tử thực thụ.
Dialogue: 0,0:11:16.46,0:11:20.67,Default,,0,0,0,,Và khi ấy, một lần nữa...
Dialogue: 0,0:11:20.67,0:11:24.47,Default,,0,0,0,,...em sẽ tỏ tình với chị Satomi.
Dialogue: 0,0:11:26.62,0:11:31.14,Default,,0,0,0,,Ra là vậy... Chị ấy đã khen mình sao?
Dialogue: 0,0:11:31.14,0:11:33.63,Default,,0,0,0,,Ông chủ, cho em một bình rượu hâm nóng nhé.
Dialogue: 0,0:11:33.93,0:11:35.32,Default,,0,0,0,,Cậu uống có sao không đấy?
Dialogue: 0,0:11:35.32,0:11:37.38,Default,,0,0,0,,Đêm nay em muốn uống một chút.
Dialogue: 0,0:11:39.03,0:11:41.07,Default,,0,0,0,,Cảm ơn anh vì buổi làm việc hôm nay.
Dialogue: 0,0:12:42.75,0:12:44.80,Default,,0,0,0,,Anh Yoshino đây.
Dialogue: 0,0:13:15.08,0:13:17.28,Default,,0,0,0,,- Xin kính chào quý khách.\N- Chào buổi tối.
Dialogue: 0,0:13:20.22,0:13:22.21,Default,,0,0,0,,Anh đợi em có lâu không?
Dialogue: 0,0:13:22.21,0:13:23.90,Default,,0,0,0,,Không lâu đâu.
Dialogue: 0,0:13:25.00,0:13:26.84,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:14:04.24,0:14:06.29,Default,,0,0,0,,Cậu điều tra giỏi lắm.
Dialogue: 0,0:14:10.23,0:14:13.47,Default,,0,0,0,,Người đàn ông đó chính là vị hôn phu cũ của chị.
Dialogue: 0,0:14:14.90,0:14:18.96,Default,,0,0,0,,Hai năm trước, chị tình cờ gặp lại anh ta\Nsau suốt 10 năm xa cách.
Dialogue: 0,0:14:20.94,0:14:24.12,Default,,0,0,0,,Cuộc đời đúng là chẳng biết đâu mà lần, nhỉ?
Dialogue: 0,0:14:24.67,0:14:27.36,Default,,0,0,0,,Dù năm xưa chính chị đã chia tay anh ta vì tội ngoại tình...
Dialogue: 0,0:14:27.45,0:14:31.35,Default,,0,0,0,,Thế mà giờ đây, chính chị lại trở thành kẻ thứ ba... Nực cười nhỉ?
Dialogue: 0,0:14:34.36,0:14:39.03,Default,,0,0,0,,Chị không thấy làm vậy là sai trái sao?\NAnh ta đã có vợ con đề huề rồi cơ mà...
Dialogue: 0,0:14:39.24,0:14:41.03,Default,,0,0,0,,Hoàn toàn không.
Dialogue: 0,0:14:42.79,0:14:45.03,Default,,0,0,0,,Thế thì công việc này của chúng ta có ý nghĩa gì chứ?
Dialogue: 0,0:14:45.90,0:14:47.84,Default,,0,0,0,,Cái nghề thám tử mà chúng ta đang làm đây này.
Dialogue: 0,0:14:48.93,0:14:51.29,Default,,0,0,0,,Cái gọi là "Khao khát muốn biết sự thật"...
Dialogue: 0,0:14:51.29,0:14:53.51,Default,,0,0,0,,...chẳng phải cũng chỉ là bản năng của con người thôi sao?
Dialogue: 0,0:14:57.98,0:15:00.06,Default,,0,0,0,,Em thực sự...
Dialogue: 0,0:15:01.40,0:15:03.40,Default,,0,0,0,,...không thể nào hiểu nổi chị.
Dialogue: 0,0:15:04.89,0:15:09.81,Default,,0,0,0,,Chị nhận ra rằng bản thân thấy thanh thản hơn\Nkhi làm kẻ đi phản bội người khác thay vì bị người ta phản bội.
Dialogue: 0,0:15:09.81,0:15:11.81,Default,,0,0,0,,Suốt 10 năm qua vẫn luôn như vậy.
Dialogue: 0,0:15:16.99,0:15:20.64,Default,,0,0,0,,Một khi em nộp bản báo cáo này lên...
Dialogue: 0,0:15:20.64,0:15:24.46,Default,,0,0,0,,...chị có biết hậu quả sẽ thế nào không?
Dialogue: 0,0:15:24.46,0:15:25.94,Default,,0,0,0,,Dĩ nhiên là biết chứ.
Dialogue: 0,0:15:26.19,0:15:27.06,Default,,0,0,0,,Chị chấp nhận chuyện đó sao?
Dialogue: 0,0:15:27.06,0:15:28.50,Default,,0,0,0,,Ừ.
Dialogue: 0,0:15:35.52,0:15:40.59,Default,,0,0,0,,Xin cho phép em được hỏi một câu cuối cùng.
Dialogue: 0,0:15:44.35,0:15:52.69,Default,,0,0,0,,Tại sao chị lại chấp nhận người đàn ông đó...\Nmà không phải là em?
Dialogue: 0,0:15:58.99,0:16:01.69,Default,,0,0,0,,Có lẽ hai người bọn chị giống như khoai sọ và mực ống vậy.
Dialogue: 0,0:16:04.96,0:16:08.68,Default,,0,0,0,,Bằng một cách kỳ lạ nào đó, lại rất hợp nhau.
Dialogue: 0,0:16:16.71,0:16:18.83,Default,,0,0,0,,Em xin phép đi trước.
Dialogue: 0,0:16:20.40,0:16:21.91,Default,,0,0,0,,Cậu không cần trả đâu.
Dialogue: 0,0:16:40.30,0:16:41.89,Default,,0,0,0,,Để vậy có sao không ạ?
Dialogue: 0,0:16:42.76,0:16:44.45,Default,,0,0,0,,Trông chị có đáng khinh lắm không?
Dialogue: 0,0:16:46.81,0:16:50.91,Default,,0,0,0,,Nếu không tự biến mình trở nên mạnh mẽ,\Nthì sẽ chẳng thể nào sinh tồn nổi, đúng không chị?
Dialogue: 0,0:17:09.40,0:17:13.37,Default,,0,0,0,,Đây là... những bức ảnh bằng chứng ạ.
Dialogue: 0,0:17:13.37,0:17:19.32,Default,,0,0,0,,{\i1}Xem ra cậu Sasaki, đúng như lời đã hứa,\Nđã nộp bản báo cáo điều tra lên công ty.{\i0}
Dialogue: 0,0:17:40.62,0:17:45.10,Default,,0,0,0,,{\i1}Và đúng như dự đoán, cô Satomi đã\Nbị văn phòng thám tử sa thải.{\i0}
Dialogue: 0,0:17:51.17,0:17:54.04,Default,,0,0,0,,{\i1}Rồi một thời gian sau đó...{\i0}
Dialogue: 0,0:18:19.02,0:18:21.70,Default,,0,0,0,,Trong lúc đang sắp xếp lại đống dữ liệu...
Dialogue: 0,0:18:21.70,0:18:23.77,Default,,0,0,0,,...tôi mới chợt phát hiện ra điều đó.
Dialogue: 0,0:18:27.06,0:18:30.06,Default,,0,0,0,,Cô ấy vốn đã biết rõ hai chúng tôi đang bị theo dõi.
Dialogue: 0,0:18:36.27,0:18:39.86,Default,,0,0,0,,Chuyện vợ tôi phát hiện ra vốn dĩ\Nchỉ còn là vấn đề thời gian mà thôi...
Dialogue: 0,0:18:40.14,0:18:43.83,Default,,0,0,0,,...thậm chí chẳng cần phải nhờ đến\Nvăn phòng thám tử tư...
Dialogue: 0,0:18:43.83,0:18:46.83,Default,,0,0,0,,...cô ấy cũng đã nghi ngờ tôi từ lâu rồi...
Dialogue: 0,0:18:46.83,0:18:49.76,Default,,0,0,0,,Bản thân tôi cũng nghĩ thà cứ bị bắt quả tang ở đâu đó cho xong...
Dialogue: 0,0:18:57.46,0:19:01.53,Default,,0,0,0,,Tôi cũng đã suy nghĩ rất nghiêm túc về chuyện đó...
Dialogue: 0,0:19:01.53,0:19:03.93,Default,,0,0,0,,...rằng nếu hai đứa cứ tiếp tục lén lút bên nhau thế này,\Nsớm muộn gì tôi cũng sẽ tiến tới bước ly hôn.
Dialogue: 0,0:19:08.06,0:19:13.23,Default,,0,0,0,,Vậy tại sao...\Nnếu chị Satomi đã biết rõ hai người đang bị theo dõi...
Dialogue: 0,0:19:17.60,0:19:21.34,Default,,0,0,0,,Đêm hôm ấy, ở trong khách sạn...
Dialogue: 0,0:19:22.97,0:19:25.74,Default,,0,0,0,,Lúc đầu, cô ấy đã bật khóc...
Dialogue: 0,0:19:26.05,0:19:28.19,Default,,0,0,0,,...và nghẹn ngào nói rằng...
Dialogue: 0,0:19:28.75,0:19:32.05,Default,,0,0,0,,"Em đã phản bội lại chính bản thân mình của ngày xưa."
Dialogue: 0,0:19:35.67,0:19:38.68,Default,,0,0,0,,Đây chính là cách cô ấy tự nhận lấy trách nhiệm.
Dialogue: 0,0:19:38.85,0:19:44.05,Default,,0,0,0,,Vì tôi... và cũng là vì cả cậu nữa...
Dialogue: 0,0:19:44.05,0:19:46.35,Default,,0,0,0,,...cô ấy đã tự biến mình thành kẻ xấu xa.
Dialogue: 0,0:19:58.90,0:20:02.80,Default,,0,0,0,,Chị ấy đã cố tình để lộ diện trước ống kính của em.
Dialogue: 0,0:20:07.24,0:20:09.24,Default,,0,0,0,,Cô ấy thực sự là một người phụ nữ tốt.
Dialogue: 0,0:20:10.63,0:20:14.03,Default,,0,0,0,,Bản lĩnh và đáng mặt đàn ông hơn tôi gấp trăm lần.
Dialogue: 0,0:20:30.97,0:20:33.87,Default,,0,0,0,,Đĩa này tôi mời cậu.\NĐể chúc mừng cậu chính thức được thăng chức.
Dialogue: 0,0:20:39.41,0:20:41.11,Default,,0,0,0,,Phụ nữ...
Dialogue: 0,0:20:42.23,0:20:44.10,Default,,0,0,0,,...em thực sự chẳng thể nào hiểu thấu được họ.
Dialogue: 0,0:20:44.10,0:20:45.86,Default,,0,0,0,,Chà, biết làm sao được.
Dialogue: 0,0:20:47.87,0:20:49.76,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:20:50.99,0:20:56.27,Default,,0,0,0,,...em nghĩ chính chị ấy đã giúp em trưởng thành thành một người đàn ông thực thụ.
Dialogue: 0,0:20:56.27,0:20:58.27,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:21:00.80,0:21:05.05,Default,,0,0,0,,Nhất định một ngày nào đó...
Dialogue: 0,0:21:05.32,0:21:07.15,Default,,0,0,0,,...em sẽ tìm được chị Satomi.
Dialogue: 0,0:21:08.95,0:21:12.52,Default,,0,0,0,,Tối nay anh muốn dùng món gì ạ?
Dialogue: 0,0:21:18.83,0:21:21.65,Default,,0,0,0,,Khoai sọ ninh...
Dialogue: 0,0:21:21.65,0:21:23.87,Default,,0,0,0,,...với mực ống phải không?
Dialogue: 0,0:21:24.11,0:21:27.09,Default,,0,0,0,,Mũi của anh bắt đầu thính hơn một chút rồi đấy nhỉ?
Dialogue: 0,0:21:32.39,0:21:34.11,Default,,0,0,0,,Này Daigo, đi thôi!
Dialogue: 0,0:21:34.11,0:21:36.11,Default,,0,0,0,,Ừ, biết rồi.
Dialogue: 0,0:21:38.15,0:21:39.32,Default,,0,0,0,,Chà...
Dialogue: 0,0:21:39.32,0:21:40.80,Default,,0,0,0,,Ngầu thật đấy.
Dialogue: 0,0:21:58.17,0:22:01.91,Default,,0,0,0,,Chà~! Ngầu quá đi mất!!
Dialogue: 0,0:22:02.21,0:22:04.08,Default,,0,0,0,,Cú vừa rồi đỉnh thật đấy!
Dialogue: 0,0:22:11.07,0:22:14.24,Default,,0,0,0,,Đầu tiên, trụng sơ mực ống qua nước sôi rồi vớt ra ngay.
Dialogue: 0,0:22:14.24,0:22:16.79,Default,,0,0,0,,Trước khi khoai sọ chín mềm,\Nhãy cho mực ống vào nồi trở lại...
Dialogue: 0,0:22:16.79,0:22:19.74,Default,,0,0,0,,...rồi ninh cho đến khi khoai sọ chín bở,\Nkhông còn bị sượng cứng nữa.
Dialogue: 0,0:22:19.74,0:22:22.34,Default,,0,0,0,,Nhân tiện, thay vì luộc khoai sọ\Nbằng nước sôi thông thường...
Dialogue: 0,0:22:22.34,0:22:27.10,Default,,0,0,0,,...hãy ninh khoai trực tiếp trong nước sốt luộc mực,\Nnhư vậy bạn sẽ không còn phải bận tâm về độ nhớt của khoai sọ nữa.
Dialogue: 0,0:22:27.10,0:22:29.10,Default,,0,0,0,,Xin lỗi đã để quý khách đợi.
Dialogue: 0,0:22:33.99,0:22:36.79,Default,,0,0,0,,Tôi ngửi thấy mùi hương của một người phụ nữ đâu đây*.\N(*Gợi ý về bộ phim điện ảnh sắp ra mắt\Nvới sự góp mặt của nữ diễn viên khách mời Tabe Mikako)
Dialogue: 0,0:22:38.02,0:22:40.96,Default,,0,0,0,,"Ông chủ"\NKOBAYASHI KAORU
Dialogue: 0,0:22:41.52,0:22:44.46,Default,,0,0,0,,"Satomi"\NISHIBASHI KEI
