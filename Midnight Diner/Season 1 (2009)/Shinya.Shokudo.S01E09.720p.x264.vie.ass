Dialogue: 0,0:00:00.44,0:00:02.15,Default,,0,0,0,,Bản dịch được thực hiện bởi Amtia(NOFACE)\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:00:00.44,0:00:02.15,Default,,0,0,0,,Phụ đề miễn phí phục vụ cộng đồng.\Nghiêm cấm mua bán dưới mọi hình thức!
Dialogue: 0,0:00:03.44,0:00:05.65,Default,,0,0,0,,~ Ca khúc mở đầu ~\NOmohide (Ký ức) - Trình bày: Suzuki Tsunekichi
Dialogue: 0,0:00:06.73,0:00:10.17,Default,,0,0,0,,~ KOBAYASHI Kaoru ~
Dialogue: 0,0:00:12.57,0:00:16.17,Default,,0,0,0,,~ LILY ~
Dialogue: 0,0:00:18.68,0:00:22.13,Default,,0,0,0,,~ ANDO Tamae ~
Dialogue: 0,0:00:26.33,0:00:31.13,Default,,0,0,0,,kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra
Dialogue: 0,0:00:30.75,0:00:34.16,Default,,0,0,0,,Đạo diễn: YAMASHITA Nobuhiro
Dialogue: 0,0:00:31.35,0:00:36.06,Default,,0,0,0,,ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió
Dialogue: 0,0:00:36.44,0:00:41.29,Default,,0,0,0,,sora ni ukabu kumo no naka ni\NRồi từng chút, từng chút một tan biến
Dialogue: 0,0:00:41.55,0:00:46.37,Default,,0,0,0,,sukoshi zutsu kie te yuku\NVào giữa những tầng mây trôi bồng bềnh trên cao
Dialogue: 0,0:00:46.69,0:00:51.41,Default,,0,0,0,,tooku takai sora no naka de\NTừ nơi bầu trời cao vời vợi xa xăm
Dialogue: 0,0:00:51.74,0:00:56.50,Default,,0,0,0,,te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em
Dialogue: 0,0:00:56.82,0:01:01.59,Default,,0,0,0,,kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra
Dialogue: 0,0:01:01.68,0:01:07.04,Default,,0,0,0,,pokkari to ukan de iru\NRồi lững lờ trôi giữa không trung
Dialogue: 0,0:01:07.82,0:01:16.99,Default,,0,0,0,,zutto mukashi no koto no you da ne\NCảm giác tựa như một ký ức tự thuở xa xưa lắm rồi
Dialogue: 0,0:01:17.74,0:01:26.53,Default,,0,0,0,,kawamo no ue o kumo ga nagareru\NNhững đám mây trôi lững lờ in bóng trên mặt sông
Dialogue: 0,0:01:46.24,0:01:48.19,Default,,0,0,0,,{\i1}Khi một ngày khép lại,{\i0}
Dialogue: 0,0:01:48.30,0:01:51.57,Default,,0,0,0,,{\i1}và mọi người vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:51.83,0:01:54.20,Default,,0,0,0,,{\i1}thì ngày mới của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:54.56,0:01:58.76,Default,,0,0,0,,[~ Suất súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly]\NThực đơn của tôi chỉ có bấy nhiêu đó.
Dialogue: 0,0:01:58.94,0:02:01.72,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì khác...{\i0}
Dialogue: 0,0:02:01.93,0:02:04.15,Default,,0,0,0,,{\i1}chỉ cần có thể làm được là tôi đều phục vụ,{\i0}
Dialogue: 0,0:02:04.28,0:02:07.15,Default,,0,0,0,,{\i1}phương châm làm nghề của tôi là vậy.{\i0}
Dialogue: 0,0:02:07.66,0:02:12.87,Default,,0,0,0,,{\i1}Quán tôi mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:02:13.23,0:02:14.40,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:02:14.43,0:02:17.63,Default,,0,0,0,,{\i1}Quán Ăn Đêm.{\i0}
Dialogue: 0,0:02:17.86,0:02:19.80,Default,,0,0,0,,{\i1}Bạn hỏi làm ăn thế này có khách không ư?!{\i0}
Dialogue: 0,0:02:19.92,0:02:22.82,Default,,0,0,0,,{\i1}Cũng khấm khá lắm đấy chứ.{\i0}
Dialogue: 0,0:02:24.44,0:02:27.36,Default,,0,0,0,,~ Bản dịch của Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:02:27.46,0:02:32.93,Default,,0,0,0,,Tập 9\NCá Sòng Sẻ Đôi Nướng
Dialogue: 0,0:02:35.27,0:02:39.00,Default,,0,0,0,,~ Khu phố Shinjuku Golden Gai ~
Dialogue: 0,0:02:44.98,0:02:47.40,Default,,0,0,0,,{\i1}Mấy ngày gần đây,{\i0}
Dialogue: 0,0:02:47.52,0:02:50.14,Default,,0,0,0,,{\i1}cứ vào lúc rạng đông tinh mơ,{\i0}
Dialogue: 0,0:02:50.27,0:02:53.92,Default,,0,0,0,,{\i1}quý bà lớn tuổi có phong thái sành điệu này\Nlại ghé qua quán tôi để dùng bữa sáng.{\i0}
Dialogue: 0,0:02:59.17,0:03:00.94,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn nhé.
Dialogue: 0,0:03:01.91,0:03:03.76,Default,,0,0,0,,Tôi hút một điếu thuốc được chứ?
Dialogue: 0,0:03:04.99,0:03:08.52,Default,,0,0,0,,Ăn cơm xong mà không được làm một hơi thuốc\Nthì đúng là bức bối chết đi được, nhỉ?
Dialogue: 0,0:03:08.65,0:03:12.08,Default,,0,0,0,,Giờ ở Tokyo đi tới bất cứ xó xỉnh nào, người ta cũng\Nđập vào mặt mình cái biển "cấm hút thuốc".
Dialogue: 0,0:03:12.11,0:03:14.09,Default,,0,0,0,,Sống ở cái đất này đúng là ngột ngạt phát mệt.
Dialogue: 0,0:03:14.30,0:03:16.75,Default,,0,0,0,,Mà càng ngày người ta lại càng làm gắt hơn mới khổ chứ.
Dialogue: 0,0:03:16.77,0:03:19.69,Default,,0,0,0,,Tôi từng thấy khối người hút thuốc phì phèo mà vẫn sống thọ tới chín mươi tuổi,
Dialogue: 0,0:03:19.80,0:03:22.20,Default,,0,0,0,,ai mà biết trước được lúc nào thần chết sẽ gọi tên mình cơ chứ?
Dialogue: 0,0:03:23.41,0:03:27.06,Default,,0,0,0,,Thế cơn gió nào đưa bà ghé tới vùng này vậy?
Dialogue: 0,0:03:28.01,0:03:30.37,Default,,0,0,0,,Tôi giao lại toàn bộ việc kinh doanh cho con trai rồi.
Dialogue: 0,0:03:30.48,0:03:34.05,Default,,0,0,0,,Cuộc sống ở dưới tỉnh lẻ đôi khi cũng tẻ nhạt lắm.
Dialogue: 0,0:03:34.43,0:03:35.55,Default,,0,0,0,,Tỉnh lẻ là ở vùng nào thế ạ?
Dialogue: 0,0:03:35.56,0:03:37.39,Default,,0,0,0,,Ở Kumamoto thuộc xứ Higo* xưa ấy.
Dialogue: 0,0:03:35.56,0:03:37.39,Default,,0,0,0,,{\i1}(*Tên gọi cổ của tỉnh\NKumamoto thuộc vùng Kyushu){\i0}
Dialogue: 0,0:03:37.40,0:03:38.76,Default,,0,0,0,,Tôi thấy giọng của bà chẳng pha chút âm sắc địa phương nào cả.
Dialogue: 0,0:03:38.96,0:03:40.85,Default,,0,0,0,,Tôi vốn là người gốc Tokyo mà,
Dialogue: 0,0:03:40.96,0:03:44.36,Default,,0,0,0,,Kumamoto chỉ là quê hương\Ncủa người chồng quá cố của tôi thôi.
Dialogue: 0,0:03:44.67,0:03:47.56,Default,,0,0,0,,Hiện tôi đang thuê một căn hộ ngắn hạn theo tuần ở cuối con đường này.
Dialogue: 0,0:03:47.68,0:03:50.75,Default,,0,0,0,,Tính dành chút thời gian sống thảnh thơi cho riêng mình.
Dialogue: 0,0:03:51.22,0:03:54.37,Default,,0,0,0,,Dù là ăn ngay giữa lòng Tokyo, nhưng con cá sòng\Nở quán này quả thực ngon xuất sắc đấy.
Dialogue: 0,0:03:54.38,0:03:55.74,Default,,0,0,0,,Đúng thế nhỉ?
Dialogue: 0,0:03:55.75,0:03:57.97,Default,,0,0,0,,Nhờ một người quen gửi từ cảng Numazu lên đấy...
Dialogue: 0,0:03:58.47,0:03:59.62,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:03:59.75,0:04:02.14,Default,,0,0,0,,Ồ... Chuyến đi thế nào rồi?
Dialogue: 0,0:04:02.32,0:04:04.10,Default,,0,0,0,,Em vừa mới đi lưu diễn ở tỉnh về xong.
Dialogue: 0,0:04:08.93,0:04:12.50,Default,,0,0,0,,Ngồi ròng rã suốt cả đêm trên xe khách,\Ngiờ người ngợm em ê ẩm cứng đờ hết cả.
Dialogue: 0,0:04:12.91,0:04:14.24,Default,,0,0,0,,Cho em cốc bia nhé.
Dialogue: 0,0:04:15.42,0:04:18.19,Default,,0,0,0,,Chẳng phải giờ này cô nên về thẳng nhà\Nđể đánh một giấc cho lại sức sao?
Dialogue: 0,0:04:18.30,0:04:20.67,Default,,0,0,0,,Hôm nay em phải uống cho say mới được.
Dialogue: 0,0:04:21.28,0:04:25.25,Default,,0,0,0,,Đàn ông trên đời này cần ở phụ nữ tụi em\Nduy nhất mỗi tấm thân xác thôi, đúng không hả?!
Dialogue: 0,0:04:26.04,0:04:28.45,Default,,0,0,0,,Nghe giọng điệu là biết đang có chuyện ấm ức rồi đây.
Dialogue: 0,0:04:34.53,0:04:35.73,Default,,0,0,0,,Chào cô.
Dialogue: 0,0:04:37.35,0:04:40.36,Default,,0,0,0,,Cháu là diễn viên của đoàn kịch sân khấu nào à?
Dialogue: 0,0:04:40.38,0:04:41.88,Default,,0,0,0,,Dạ không... cháu bên đoàn múa ạ.
Dialogue: 0,0:04:42.09,0:04:44.64,Default,,0,0,0,,Cháu là nghệ sĩ múa, Marilyn Matsushima.
Dialogue: 0,0:04:44.75,0:04:46.37,Default,,0,0,0,,Rất vui được làm quen với cô.
Dialogue: 0,0:05:09.56,0:05:12.28,Default,,0,0,0,,Cái máy chết tiệt này bị làm sao thế không biết?
Dialogue: 0,0:06:07.06,0:06:08.48,Default,,0,0,0,,Mọi người biết tin gì chưa?
Dialogue: 0,0:06:08.59,0:06:10.34,Default,,0,0,0,,Hôm nay em trúng quả đậm,\Ntất cả là nhờ cô ấy cả đấy.
Dialogue: 0,0:06:10.68,0:06:12.63,Default,,0,0,0,,Em ngồi đúng vào cái máy pachinko\Nmà cô Yachiyo chỉ cho,
Dialogue: 0,0:06:12.66,0:06:14.96,Default,,0,0,0,,thế là nổ hũ thắng sạch sành sanh cả tiệm luôn.
Dialogue: 0,0:06:16.25,0:06:18.78,Default,,0,0,0,,Ôi... Cảm giác lúc đó sướng tê người luôn ạ.
Dialogue: 0,0:06:19.90,0:06:23.21,Default,,0,0,0,,Cô Yachiyo ơi, cô cứ uống\Ntự nhiên nhé. Đêm nay cháu khao cô.
Dialogue: 0,0:06:23.32,0:06:24.88,Default,,0,0,0,,Quán này không phải là quán bar đâu nhé.
Dialogue: 0,0:06:24.93,0:06:26.88,Default,,0,0,0,,Mỗi khách chỉ được uống tối đa ba ly thôi.
Dialogue: 0,0:06:27.43,0:06:29.27,Default,,0,0,0,,Ông chủ đừng có khắt khe thế chứ!
Dialogue: 0,0:06:29.43,0:06:33.10,Default,,0,0,0,,Cứ để tụi em uống thâu đêm suốt sáng\Ncho quên đi thực tại phũ phàng một chút nào.
Dialogue: 0,0:06:34.23,0:06:35.65,Default,,0,0,0,,Mà cô nói cho cháu nghe với.
Dialogue: 0,0:06:35.78,0:06:38.74,Default,,0,0,0,,Làm sao cô nhìn ra được máy nào\Nlà máy pachinko sắp nổ giải hay vậy ạ?
Dialogue: 0,0:06:38.85,0:06:41.33,Default,,0,0,0,,Trước hết là tuyệt đối không được để lòng tham\Nlàm mờ mắt mình.
Dialogue: 0,0:06:41.44,0:06:44.44,Default,,0,0,0,,Lòng tham chỉ làm hỏng hết cuộc vui mà thôi.
Dialogue: 0,0:06:44.70,0:06:46.28,Default,,0,0,0,,Và nó sẽ khiến cháu mù quáng\Nđưa ra những lựa chọn sai lầm.
Dialogue: 0,0:06:46.39,0:06:49.25,Default,,0,0,0,,Chuyện chọn đàn ông cũng y hệt như thế, đúng không nào?!
Dialogue: 0,0:06:49.62,0:06:51.70,Default,,0,0,0,,Sao lại lôi cánh đàn ông tụi tôi vào đây?
Dialogue: 0,0:06:53.79,0:06:56.10,Default,,0,0,0,,Ô kìa! Marilyn đấy à.\NEm đi lưu diễn về rồi hả?
Dialogue: 0,0:06:56.23,0:06:57.49,Default,,0,0,0,,Em về rồi đây.
Dialogue: 0,0:06:57.51,0:06:59.06,Default,,0,0,0,,Khi nào tới lịch diễn tiếp theo thế?\NAnh sẽ mang hoa tới tặng em nhé.
Dialogue: 0,0:06:59.16,0:07:01.31,Default,,0,0,0,,Cảm ơn anh. Em được nghỉ ngơi\Nvài ngày để dưỡng sức đã.
Dialogue: 0,0:07:03.31,0:07:06.79,Default,,0,0,0,,Cô cũng rất muốn được đi xem cháu biểu diễn một lần.
Dialogue: 0,0:07:07.43,0:07:08.88,Default,,0,0,0,,Cô cũng muốn xem ạ?!
Dialogue: 0,0:07:08.99,0:07:10.08,Default,,0,0,0,,Cháu theo thể loại múa nào thế?
Dialogue: 0,0:07:10.19,0:07:12.37,Default,,0,0,0,,À thì... biết nói thế nào nhỉ...
Dialogue: 0,0:07:12.49,0:07:14.53,Default,,0,0,0,,Cô ấy biểu diễn ở đâu thế mấy chú?
Dialogue: 0,0:07:17.17,0:07:18.81,Default,,0,0,0,,Để cháu dẫn cô tới tận nơi xem luôn.
Dialogue: 0,0:07:18.91,0:07:20.56,Default,,0,0,0,,Mình đi thôi, cô Yachiyo.
Dialogue: 0,0:07:20.68,0:07:23.50,Default,,0,0,0,,Ông chủ ơi. Cảm ơn vì bữa ăn nhé.\NÔng chủ khỏi cần thối lại tiền thừa đâu.
Dialogue: 0,0:07:24.92,0:07:26.79,Default,,0,0,0,,Cảm ơn cô nhé.
Dialogue: 0,0:07:31.35,0:07:33.69,Default,,0,0,0,,Ồ... Của anh đây.
Dialogue: 0,0:07:34.36,0:07:40.01,Default,,0,0,0,,Cái bà cô vừa nãy...\NHình như tôi từng gặp ở đâu rồi thì phải?
Dialogue: 0,0:08:54.55,0:08:57.05,Default,,0,0,0,,Đỉnh quá đi mất, cô Yachiyo ơi!
Dialogue: 0,0:09:20.47,0:09:23.40,Default,,0,0,0,,Vừa nãy cô nhảy tuyệt vời lắm luôn ấy!
Dialogue: 0,0:09:24.59,0:09:26.41,Default,,0,0,0,,Cô có năng khiếu bẩm sinh thật đấy.
Dialogue: 0,0:09:26.67,0:09:29.91,Default,,0,0,0,,Chắc cũng chỉ là chút dư âm sót lại của một thời dĩ vãng thôi.
Dialogue: 0,0:09:30.34,0:09:32.12,Default,,0,0,0,,Ủa sao thế ạ, ngày xưa cô từng làm nghề gì hả cô?
Dialogue: 0,0:09:34.44,0:09:35.54,Default,,0,0,0,,Sao hả?
Dialogue: 0,0:09:35.78,0:09:37.42,Default,,0,0,0,,Sao cơ ạ?
Dialogue: 0,0:09:37.53,0:09:39.50,Default,,0,0,0,,Ở cái tuổi gần đất xa trời như cô đây,
Dialogue: 0,0:09:39.78,0:09:42.00,Default,,0,0,0,,ai mà chẳng có cả một bầu trời quá khứ để kể lể cơ chứ.
Dialogue: 0,0:09:53.42,0:09:55.07,Default,,0,0,0,,Cô Yachiyo ơi, lối này ạ.
Dialogue: 0,0:09:55.19,0:09:56.91,Default,,0,0,0,,- Sao thế? Ở đằng đó có gì à?\N- Cô cứ đi theo cháu.
Dialogue: 0,0:09:57.01,0:09:59.07,Default,,0,0,0,,- Đi lối này ạ.\N- Hả?
Dialogue: 0,0:10:19.18,0:10:21.16,Default,,0,0,0,,Cô Yachiyo à, thật ra thì...
Dialogue: 0,0:10:22.22,0:10:26.00,Default,,0,0,0,,Cháu từng giới thiệu với cô mình là\Nnghệ sĩ múa, nhưng sự thật thì...
Dialogue: 0,0:10:26.01,0:10:27.79,Default,,0,0,0,,Cháu là một vũ nữ thoát y.
Dialogue: 0,0:10:33.66,0:10:36.44,Default,,0,0,0,,Cháu không có ý định cố tình giấu giếm cô đâu.
Dialogue: 0,0:10:36.52,0:10:40.69,Default,,0,0,0,,Mà... chắc là cháu cũng có chút ngại ngùng thật.
Dialogue: 0,0:10:46.87,0:10:51.80,Default,,0,0,0,,~ Hộp đêm thoát y Shinjuku New Art ~
Dialogue: 0,0:10:59.46,0:11:02.73,Default,,0,0,0,,Cháu vừa mới có chuyến\Nlưu diễn xa nhà đầu tiên trong đời,
Dialogue: 0,0:11:03.39,0:11:06.71,Default,,0,0,0,,tới một thị trấn suối nước nóng (onsen)\Nở tận dưới vùng tỉnh lẻ.
Dialogue: 0,0:11:07.01,0:11:12.27,Default,,0,0,0,,Cháu đã dốc hết tâm sức để múa cho thật đẹp,\Nnhưng chẳng một ai dưới khán đài thèm đoái hoài tới.
Dialogue: 0,0:11:14.97,0:11:17.20,Default,,0,0,0,,Thứ duy nhất đám đàn ông đó quan tâm\Nlà chờ xem khoảnh khắc cháu cởi sạch đồ trên người,
Dialogue: 0,0:11:17.30,0:11:19.55,Default,,0,0,0,,đúng như những gì người ta vẫn nghĩ về một vũ nữ thoát y.
Dialogue: 0,0:11:21.92,0:11:26.67,Default,,0,0,0,,Thế nhưng trong thâm tâm cháu luôn tự nhủ rằng\Ntrước hết mình phải là một nghệ sĩ múa thực thụ.
Dialogue: 0,0:11:30.13,0:11:32.53,Default,,0,0,0,,Chắc hẳn cháu cũng phải\Ncó nhiều người hâm mộ lắm nhỉ?
Dialogue: 0,0:11:33.27,0:11:35.34,Default,,0,0,0,,Dạ có chứ ạ!
Dialogue: 0,0:11:35.47,0:11:38.37,Default,,0,0,0,,Mỗi đợt cháu có lịch biểu diễn, người ta gửi\Nlẵng hoa chúc mừng xếp kín cả lối vào rạp luôn đấy.
Dialogue: 0,0:11:38.47,0:11:40.86,Default,,0,0,0,,Vậy thì cháu quả thực rất tài giỏi đấy.
Dialogue: 0,0:11:43.70,0:11:47.49,Default,,0,0,0,,Cháu có muốn về chỗ cô\Nuống thêm vài ly nữa không?
Dialogue: 0,0:11:47.61,0:11:49.22,Default,,0,0,0,,- Thật hả cô?\N- Ừ.
Dialogue: 0,0:11:49.73,0:11:51.55,Default,,0,0,0,,Tuyệt quá đi mất!
Dialogue: 0,0:12:03.61,0:12:05.25,Default,,0,0,0,,Này! Marilyn.
Dialogue: 0,0:12:05.37,0:12:08.70,Default,,0,0,0,,- Chào buổi tối mọi người.\N- Hai cô cháu đã thành đôi bạn thân thiết nhanh thế cơ à.
Dialogue: 0,0:12:08.82,0:12:11.68,Default,,0,0,0,,Ông chủ ơi.\NCho tụi em bia và...
Dialogue: 0,0:12:11.79,0:12:13.70,Default,,0,0,0,,Mari đấy à?!
Dialogue: 0,0:12:13.96,0:12:16.52,Default,,0,0,0,,Không ngờ lại tình cờ gặp lại em ở chốn này đấy?!
Dialogue: 0,0:12:16.65,0:12:18.20,Default,,0,0,0,,Anh Kazama, hai người quen biết nhau từ trước à?
Dialogue: 0,0:12:18.22,0:12:20.63,Default,,0,0,0,,Hồi xưa hai tụi tôi từng học chung\Nmột trường đào tạo diễn xuất với nhau mà, nhỉ?
Dialogue: 0,0:12:21.88,0:12:25.50,Default,,0,0,0,,Chà! Marilyn, em qua ngồi chung bàn bên này đi.
Dialogue: 0,0:12:25.82,0:12:27.32,Default,,0,0,0,,Oách quá ta, Marilyn.
Dialogue: 0,0:12:27.46,0:12:29.83,Default,,0,0,0,,Hóa ra em từng là bạn học chung lớp với một ngôi sao lớn cơ đấy?!
Dialogue: 0,0:12:29.94,0:12:32.12,Default,,0,0,0,,Anh Komichi này, thôi đừng trêu em nữa!
Dialogue: 0,0:12:32.23,0:12:34.42,Default,,0,0,0,,Trước đây tôi cũng từng chụp bộ ảnh người mẫu\Ncho cô ấy một lần rồi đấy, cậu biết không?
Dialogue: 0,0:12:34.54,0:12:37.43,Default,,0,0,0,,Thân hình quyến rũ của cô ấy lên hình đúng là chuẩn không cần chỉnh.
Dialogue: 0,0:12:37.57,0:12:38.60,Default,,0,0,0,,À vâng...
Dialogue: 0,0:12:38.71,0:12:43.33,Default,,0,0,0,,Anh Kazama đây vừa mới lọt vào mắt xanh\Ncủa một đạo diễn lừng danh bên sân khấu Broadway,
Dialogue: 0,0:12:43.45,0:12:45.65,Default,,0,0,0,,nên sắp tới anh ấy sẽ sang nước ngoài đóng vở nhạc kịch lớn đấy.
Dialogue: 0,0:12:45.76,0:12:48.55,Default,,0,0,0,,Chà! Hẳn anh phải là một\Ndiễn viên tài năng xuất chúng lắm.
Dialogue: 0,0:12:48.66,0:12:50.90,Default,,0,0,0,,Đâu có, chỉ là một vai phụ nhỏ nhoi thôi mà.
Dialogue: 0,0:12:51.50,0:12:53.76,Default,,0,0,0,,Vai phụ gì chứ?! Anh đóng vai bạn trai của nữ chính còn gì.
Dialogue: 0,0:12:53.87,0:12:56.94,Default,,0,0,0,,- Vai đó làm sao gọi là vai phụ được.\N- Chắc cũng coi là có chút đất diễn.
Dialogue: 0,0:12:57.05,0:12:58.57,Default,,0,0,0,,Cho em sờ thử một chút được không?
Dialogue: 0,0:13:01.23,0:13:04.22,Default,,0,0,0,,Nhìn cơ bắp săn chắc chưa này.\NÔm em một cái đi được không anh?!
Dialogue: 0,0:13:14.72,0:13:17.59,Default,,0,0,0,,Thế dạo này em sao rồi, Mari.\NCông việc vẫn tốt chứ?
Dialogue: 0,0:13:19.29,0:13:20.79,Default,,0,0,0,,Chúc mừng anh nhé.
Dialogue: 0,0:13:21.28,0:13:24.26,Default,,0,0,0,,Nhưng anh nghe phong thanh hình như em\Nvẫn còn làm cái nghề đó thì phải.
Dialogue: 0,0:13:25.13,0:13:28.38,Default,,0,0,0,,Xin lỗi nhé, anh nói đúng đấy.\NNgười ta đâu có gọi cái nghề đó là múa nghệ thuật...
Dialogue: 0,0:13:28.65,0:13:30.62,Default,,0,0,0,,Dù sao thì lúc mới nghe tin anh cũng bị sốc nặng đấy,
Dialogue: 0,0:13:30.76,0:13:33.75,Default,,0,0,0,,khi biết cô bạn gái cũ của mình giờ lại đi uốn éo\Ntrần truồng trên sân khấu rồi tự huyễn hoặc đó là nghệ thuật múa.
Dialogue: 0,0:13:37.91,0:13:41.14,Default,,0,0,0,,Làm một vũ nữ thoát y\Nthì có gì là xấu xa đê tiện hả?
Dialogue: 0,0:13:41.14,0:13:45.20,Default,,0,0,0,,Bộ được đóng một vai trong vở nhạc kịch\Nlàm anh tưởng mình cao quý hơn người khác chắc?
Dialogue: 0,0:13:45.32,0:13:47.12,Default,,0,0,0,,Chúng mình đi khỏi đây thôi cô.
Dialogue: 0,0:13:47.36,0:13:48.69,Default,,0,0,0,,Khoan đã nào!
Dialogue: 0,0:13:48.80,0:13:52.06,Default,,0,0,0,,Xin hỏi có phải bà chính là\Nhuyền thoại Rose Michiyo năm xưa không ạ?
Dialogue: 0,0:13:52.35,0:13:54.76,Default,,0,0,0,,Đúng rồi!\NGiờ thì tôi nhớ ra rồi.
Dialogue: 0,0:13:55.14,0:13:59.31,Default,,0,0,0,,Tôi cứ thấy gương mặt bà quen lắm.\NBà chính là nữ hoàng thoát y Rose Michiyo!
Dialogue: 0,0:13:59.34,0:14:01.79,Default,,0,0,0,,Thật không thể tin nổi (Unbelievable)*!!
Dialogue: 0,0:13:59.34,0:14:01.79,Default,,0,0,0,,{\i1}(*Nhại lại câu khẩu hiệu nổi tiếng từ chương trình\Năn khách Unbelievable của đài Fuji TV){\i0}
Dialogue: 0,0:14:01.89,0:14:03.32,Default,,0,0,0,,- Bà ấy chính là...\N- Ồ... Tôi cũng nhớ ra rồi...
Dialogue: 0,0:14:03.43,0:14:05.58,Default,,0,0,0,,Đường nét chiếc cổ kiêu sa và đôi tai kia...
Dialogue: 0,0:14:18.37,0:14:23.27,Default,,0,0,0,,Rose Michiyo từng là một trong những vũ nữ thoát y\Nđình đám bậc nhất cách đây khoảng bốn thập kỷ,
Dialogue: 0,0:14:23.41,0:14:25.37,Default,,0,0,0,,nhưng rồi đột ngột giải nghệ biến mất không để lại chút dấu vết.
Dialogue: 0,0:14:25.48,0:14:28.18,Default,,0,0,0,,Bà ấy thực sự là một huyền thoại sống trong giới đấy.
Dialogue: 0,0:14:28.54,0:14:34.82,Default,,0,0,0,,Bà biết không? Chính nhờ ngưỡng mộ bà\Nmà tôi mới bắt đầu mê đi xem biểu diễn thoát y đấy, bà Rose ạ.
Dialogue: 0,0:14:35.84,0:14:38.91,Default,,0,0,0,,Làm ơn đừng gọi tôi\Nbằng cái nghệ danh Rose đó nữa, cảm ơn.
Dialogue: 0,0:14:39.77,0:14:41.98,Default,,0,0,0,,Cơ mà sao chị Kosuzu lại biết rõ về bà ấy thế?
Dialogue: 0,0:14:42.11,0:14:46.62,Default,,0,0,0,,Hồi còn trẻ,\Nchị mày cũng là khách quen thường trực ở các rạp thoát y đấy.
Dialogue: 0,0:14:47.46,0:14:50.91,Default,,0,0,0,,Chị tới xem để học lỏm\Nphong thái quyến rũ của các cô ấy.
Dialogue: 0,0:14:51.29,0:14:55.44,Default,,0,0,0,,Và tất nhiên, từng cử chỉ điệu bộ của chị mày\Nđều là học hỏi từ thần tượng Rose Michiyo mà ra cả...
Dialogue: 0,0:14:55.56,0:14:57.86,Default,,0,0,0,,Thời đó bà ấy đúng là độc nhất vô nhị, không ai sánh bằng.
Dialogue: 0,0:14:58.00,0:15:01.94,Default,,0,0,0,,Nhưng tại sao năm xưa đang ở đỉnh cao mà bà lại\Nđột ngột biến mất thế? Lúc đó tôi đã hụt hẫng buồn suốt một thời gian dài đấy.
Dialogue: 0,0:15:02.37,0:15:05.09,Default,,0,0,0,,Vì một người đàn ông, chứ còn vì lý do gì khác nữa?
Dialogue: 0,0:15:05.22,0:15:08.34,Default,,0,0,0,,Suy cho cùng tôi cũng chỉ là một người phụ nữ bình thường như bao người phụ nữ khác thôi.
Dialogue: 0,0:15:09.16,0:15:13.50,Default,,0,0,0,,Người đàn ông khiến một huyền thoại như bà phải si mê,\Nhẳn cũng phải là một nhân vật phi thường lắm.
Dialogue: 0,0:15:14.75,0:15:17.22,Default,,0,0,0,,Có điều ông ấy lại đoản mệnh qua đời sớm quá.
Dialogue: 0,0:15:24.85,0:15:28.38,Default,,0,0,0,,Lịch sử nhân loại đã dạy cho chúng ta thấy rằng\Nluôn luôn là cánh đàn ông...
Dialogue: 0,0:15:28.52,0:15:32.00,Default,,0,0,0,,làm lỡ dở cuộc đời của người phụ nữ, chẳng phải vậy sao?!
Dialogue: 0,0:15:32.12,0:15:34.12,Default,,0,0,0,,Cuộc đời tôi cũng đã trải qua đủ mọi thăng trầm dâu bể,
Dialogue: 0,0:15:34.25,0:15:38.69,Default,,0,0,0,,nhưng giờ tôi đã lui về nghỉ hưu\Nvà tận hưởng quãng đời bình yên còn lại của mình.
Dialogue: 0,0:15:43.42,0:15:47.06,Default,,0,0,0,,Bằng chính những đồng tiền mồ hôi nước mắt kiếm được\Ntừ việc "uốn éo trần truồng trên sân khấu" mà cậu vừa dè bỉu,
Dialogue: 0,0:15:47.19,0:15:52.58,Default,,0,0,0,,tôi đã một mình nuôi nấng đứa con trai khôn lớn thành người.\NCháu nghe rõ chứ, bé Marilyn?
Dialogue: 0,0:15:52.73,0:15:57.30,Default,,0,0,0,,Cả cuộc đời này tôi chưa từng một lần nào\Ncảm thấy hổ thẹn vì nghề nghiệp của mình cả.
Dialogue: 0,0:16:01.06,0:16:03.95,Default,,0,0,0,,Cô Yachiyo...
Dialogue: 0,0:16:09.39,0:16:15.10,Default,,0,0,0,,Thế gian này của chúng ta, vừa đắng cay\Nlại vừa ngọt ngào tựa như dòng sông Nagara vậy.
Dialogue: 0,0:16:15.65,0:16:18.43,Default,,0,0,0,,Một câu nói mới thấm thía làm sao.
Dialogue: 0,0:16:38.25,0:16:41.21,Default,,0,0,0,,Nếu cậu còn muốn tiếp tục bước chân vào quán này,
Dialogue: 0,0:16:41.32,0:16:44.67,Default,,0,0,0,,thì hãy vứt ngay cái thái độ khinh người đó ở ngoài cửa đi.
Dialogue: 0,0:17:03.35,0:17:05.61,Default,,0,0,0,,Đêm nay tụi tôi xin phép về trước nhé.
Dialogue: 0,0:17:16.00,0:17:18.39,Default,,0,0,0,,Thế dạo gần đây bác vẫn\Nloanh quanh ở khu Shinjuku này suốt à?
Dialogue: 0,0:17:18.73,0:17:20.57,Default,,0,0,0,,Tôi vừa mới ở bên khu Ikebukuro* về.\N[*Nghĩa đen là "chiếc túi ao"]
Dialogue: 0,0:17:20.69,0:17:22.45,Default,,0,0,0,,Bukuro (chiếc túi nhỏ) á?!
Dialogue: 0,0:17:22.85,0:17:26.13,Default,,0,0,0,,Trong ống quần tôi giờ chẳng còn gì ngóc đầu lên nổi nữa,\Nnhưng cái "túi nhỏ" (bukuro) thì vẫn còn nguyên chỗ cũ nhé!
Dialogue: 0,0:17:27.01,0:17:29.06,Default,,0,0,0,,Ông chủ ơi.\NLàm ơn cho tôi một phần cá sòng sẻ đôi nướng nhé.
Dialogue: 0,0:17:29.15,0:17:30.53,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:17:34.23,0:17:37.86,Default,,0,0,0,,Bà Rose này, xem ra bà vẫn mê\Nmón cá sòng phanh đôi nướng* này quá nhỉ?
Dialogue: 0,0:17:34.23,0:17:37.86,Default,,0,0,0,,{\i1}(*Trong tiếng Nhật, món này gọi là "Aji no Hiraki"\N- vừa có nghĩa là cá sòng sẻ đôi, vừa chơi chữ chỉ động tác xoạc chân trên sân khấu){\i0}
Dialogue: 0,0:17:37.97,0:17:41.74,Default,,0,0,0,,Phanh rộng hết cỡ vốn là nghề của vũ nữ thoát y mà lại!
Dialogue: 0,0:17:42.18,0:17:44.19,Default,,0,0,0,,Bà ấy vẫn còn giữ vững phong độ lắm!
Dialogue: 0,0:17:44.30,0:17:46.84,Default,,0,0,0,,- Câu trả lời hay tuyệt cú mèo!\N- Đúng là gừng càng già càng cay.
Dialogue: 0,0:17:46.95,0:17:50.18,Default,,0,0,0,,Mà tôi đã bảo đừng có gọi tôi là Rose nữa.\NTên của tôi là Yachiyo.
Dialogue: 0,0:17:50.30,0:17:52.95,Default,,0,0,0,,Rồi, rồi. Bà Yachiyo thì bà Yachiyo.
Dialogue: 0,0:18:21.38,0:18:23.77,Default,,0,0,0,,Cháu tiễn cô tới đây được rồi.
Dialogue: 0,0:18:23.91,0:18:25.56,Default,,0,0,0,,Để cháu đi bộ tiễn cô ra tới tận nhà ga nhé.
Dialogue: 0,0:18:25.67,0:18:28.85,Default,,0,0,0,,Cô không thích kiểu chia tay bịn rịn đưa tiễn như thế đâu.
Dialogue: 0,0:18:28.98,0:18:31.90,Default,,0,0,0,,Cô bắt một chiếc taxi ở đây là được rồi.
Dialogue: 0,0:18:32.21,0:18:33.83,Default,,0,0,0,,Cảm ơn cháu vì tất cả nhé.
Dialogue: 0,0:18:37.78,0:18:40.81,Default,,0,0,0,,Vậy... Cháu ở lại giữ gìn sức khỏe nhé.
Dialogue: 0,0:18:41.82,0:18:44.13,Default,,0,0,0,,Cô về quê cũng giữ gìn sức khỏe nhé, cô Yachiyo.
Dialogue: 0,0:18:44.49,0:18:47.88,Default,,0,0,0,,Hãy luôn ngẩng cao đầu mà sống và làm nghề, cháu nhé?
Dialogue: 0,0:18:50.36,0:18:52.08,Default,,0,0,0,,Tạm biệt cháu.
Dialogue: 0,0:19:35.79,0:19:38.02,Default,,0,0,0,,- Xin chào quý khách, mời vào ạ.\N- Dạo này làm ăn thế nào?
Dialogue: 0,0:19:38.55,0:19:40.21,Default,,0,0,0,,- Vé vào cửa là năm ngàn yên ạ.\N- Năm ngàn yên hả?
Dialogue: 0,0:19:40.30,0:19:41.49,Default,,0,0,0,,Vâng.
Dialogue: 0,0:19:41.74,0:19:44.56,Default,,0,0,0,,- Tiết mục của bé Marilyn vẫn còn đang diễn chứ?\N- Hai bác cứ yên tâm, cô ấy vừa mới lên sân khấu thôi.
Dialogue: 0,0:19:44.67,0:19:46.51,Default,,0,0,0,,- Tiền vé của hai tụi tôi đây, cảm ơn cậu.\N- Xin cảm ơn hai bác.
Dialogue: 0,0:21:48.26,0:21:52.63,Default,,0,0,0,,Màn trình diễn tuyệt vời lắm!\NDáng xoạc chân mở rộng đẹp hết nước chấm!
Dialogue: 0,0:21:52.76,0:21:54.86,Default,,0,0,0,,Marilyn ơi!
Dialogue: 0,0:21:55.24,0:21:57.41,Default,,0,0,0,,Marilyn!
Dialogue: 0,0:22:09.63,0:22:14.04,Default,,0,0,0,,~ Còn tiếp ~
Dialogue: 0,0:22:14.49,0:22:17.75,Default,,0,0,0,,Cá sông nướng mặt da,\Ncá biển nướng mặt thịt.
Dialogue: 0,0:22:18.12,0:22:19.19,Default,,0,0,0,,Câu đó có nghĩa là gì thế Ông chủ?
Dialogue: 0,0:22:19.31,0:22:21.90,Default,,0,0,0,,Đó là một câu khẩu quyết truyền thống khi nướng cá ấy mà.
Dialogue: 0,0:22:22.09,0:22:24.93,Default,,0,0,0,,{\i1}Khi nướng các loại cá nước ngọt\Nthì phải đặt mặt da xuống nướng trước,{\i0}
Dialogue: 0,0:22:25.05,0:22:28.70,Default,,0,0,0,,{\i1}còn đối với cá biển thì phải nướng mặt thịt trước tiên.{\i0}
Dialogue: 0,0:22:29.06,0:22:31.47,Default,,0,0,0,,{\i1}Cá sông nướng da trước,\Ncá biển nướng thịt trước ư?{\i0}
Dialogue: 0,0:22:31.60,0:22:33.10,Default,,0,0,0,,{\i1}Nghe cũng dễ nhớ phết đấy nhỉ?{\i0}
Dialogue: 0,0:22:34.79,0:22:36.74,Default,,0,0,0,,- Thế còn cá hồi thì tính sao?\N- Cá hồi ư...
Dialogue: 0,0:22:36.84,0:22:38.45,Default,,0,0,0,,Nướng cá hồi thì phải bắt đầu\Nnướng từ mặt nào trước hả Ông chủ?
Dialogue: 0,0:22:38.57,0:22:40.78,Default,,0,0,0,,Cá hồi thì...
Dialogue: 0,0:22:43.63,0:22:45.02,Default,,0,0,0,,{\i1}À, còn một lưu ý quan trọng nữa!{\i0}
Dialogue: 0,0:22:45.15,0:22:48.22,Default,,0,0,0,,{\i1}Trước khi đặt cá lên nướng,\Nnhất định phải làm nóng thật kỹ vỉ nướng trước,{\i0}
Dialogue: 0,0:22:48.54,0:22:51.25,Default,,0,0,0,,{\i1}bằng không thịt cá sẽ bị dính chặt vào vỉ đấy.{\i0}
Dialogue: 0,0:22:52.20,0:22:54.02,Default,,0,0,0,,Xem Ông chủ đánh trống lảng chuyển chủ đề mượt chưa kìa.
Dialogue: 0,0:22:54.13,0:22:55.35,Default,,0,0,0,,Thôi chào tạm biệt nhé.
Dialogue: 0,0:22:55.57,0:22:58.07,Default,,0,0,0,,- Chúc mọi người ngủ ngon nhé.\N- Chúc ngủ ngon.
Dialogue: 0,0:22:58.15,0:23:01.10,Default,,0,0,0,,Bản dịch được thực hiện bởi Amtia(NOFACE)\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:22:58.15,0:23:01.10,Default,,0,0,0,,Phụ đề miễn phí phục vụ cộng đồng.\Nghiêm cấm mua bán dưới mọi hình thức!
Dialogue: 0,0:23:01.30,0:23:05.66,Default,,0,0,0,,Diễn viên chính\N~ KOBAYASHI Kaoru ~\Ntrong vai Ông chủ
Dialogue: 0,0:23:05.94,0:23:09.77,Default,,0,0,0,,~ LILY ~\Ntrong vai Yachiyo / Rose Michiyo
Dialogue: 0,0:23:10.07,0:23:12.34,Default,,0,0,0,,~ ANDO Tamae ~\Ntrong vai Marilyn
Dialogue: 0,0:23:12.54,0:23:15.42,Default,,0,0,0,,~ FUWA Mansaku ~\Ntrong vai bác Atsushi
Dialogue: 0,0:23:18.09,0:23:30.31,Default,,0,0,0,,~ Phụ đề tiếng Việt: Amtia(NOFACE) ~\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:24:11.35,0:24:18.64,Default,,0,0,0,,~ Trong Tập Cuối Của ~\NQUÁN ĂN ĐÊM (SHINYA SHOKUDO)
Dialogue: 0,0:24:19.82,0:24:21.95,Default,,0,0,0,,- Có chuyện gì thế?\N- Em...
Dialogue: 0,0:24:22.04,0:24:24.55,Default,,0,0,0,,Em nghĩ nếu cứ đứng đợi ở đây,\Nbiết đâu sẽ được gặp lại đại ca.
Dialogue: 0,0:24:24.67,0:24:27.08,Default,,0,0,0,,Ông Kenzaki,\Ntôi cần nói chuyện với ông một lát.
Dialogue: 0,0:24:27.20,0:24:29.34,Default,,0,0,0,,Vậy là mày gây chuyện tày đình xong\Nrồi bắt người khác phải đi dọn bãi chiến trường cho mày hả?
Dialogue: 0,0:24:29.43,0:24:30.48,Default,,0,0,0,,Khôn ngoan tiện lợi quá nhỉ.
Dialogue: 0,0:24:30.60,0:24:32.08,Default,,0,0,0,,Đó thực sự là một sai lầm khủng khiếp của em.
Dialogue: 0,0:24:32.20,0:24:34.80,Default,,0,0,0,,Ngồi xuống ăn bát mì ramen cho ấm bụng đã.\NChuyện quá khứ cứ để nó ngủ yên đi.
Dialogue: 0,0:24:34.91,0:24:38.87,Default,,0,0,0,,Mày tưởng tao rảnh rỗi đến mức\Nphải bận tâm tới lũ tép riu như tụi mày chắc?
Dialogue: 0,0:24:38.99,0:24:42.42,Default,,0,0,0,,- Anh định rời đi thật xa luôn sao?\N- Lần này có lẽ sẽ là một chuyến đi rất dài đấy.
Dialogue: 0,0:24:42.54,0:24:43.98,Default,,0,0,0,,Tôi gửi lại số tiền hôm trước còn nợ Ông chủ.
Dialogue: 0,0:24:44.08,0:24:45.58,Default,,0,0,0,,Thời buổi này hẳn là cậu\Nsẽ cần dùng đến kha khá tiền bạc đấy.
Dialogue: 0,0:24:45.69,0:24:47.14,Default,,0,0,0,,Chào chú ạ? Cháu tên là Kenta.
Dialogue: 0,0:24:47.26,0:24:48.77,Default,,0,0,0,,Chú chính là bố ruột của cháu, đúng không ạ?
Dialogue: 0,0:24:49.80,0:24:52.90,Default,,0,0,0,,~ Nghe mấy vị khách bàn tán chuyện "xoạc rộng"\Nlàm tôi cũng ngứa ngáy chân tay muốn tập tành gì đó ~
Dialogue: 0,0:24:53.43,0:24:54.97,Default,,0,0,0,,~ Tập Yoga ấy mà! Chứ các bạn đang nghĩ đi đâu thế? ~
Dialogue: 0,0:24:55.19,0:24:57.14,Default,,0,0,0,,~ Mấy người tưởng tôi là hạng người gì chứ... ~
