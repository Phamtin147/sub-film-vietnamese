Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:00:07.85,0:00:10.64,Default,,0,0,0,,Ca khúc mở đầu\NOmohide (Hoài Niệm) - Trình bày: Suzuki Tsunekichi
Dialogue: 0,0:00:07.85,0:00:10.64,Default,,0,0,0,,~ KOBAYASHI Kaoru ~
Dialogue: 0,0:00:13.45,0:00:16.60,Default,,0,0,0,,~ IWAMATSU Ryo ~
Dialogue: 0,0:00:19.00,0:00:22.43,Default,,0,0,0,,~ OGATA Morio ~
Dialogue: 0,0:00:22.90,0:00:27.60,Default,,0,0,0,,kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra
Dialogue: 0,0:00:22.90,0:00:27.60,Default,,0,0,0,,Đạo diễn: TOSAKA Takuma
Dialogue: 0,0:00:27.83,0:00:32.89,Default,,0,0,0,,ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió
Dialogue: 0,0:00:33.00,0:00:37.77,Default,,0,0,0,,sora ni ukabu kumo no naka ni\NRồi từng chút một tan biến dần
Dialogue: 0,0:00:37.99,0:00:43.08,Default,,0,0,0,,sukoshi zutsu kie te yuku\NVào tầng mây trôi bồng bềnh trên cao
Dialogue: 0,0:00:43.28,0:00:47.94,Default,,0,0,0,,tooku takai sora no naka de\NTừ giữa bầu trời cao vời vợi
Dialogue: 0,0:00:48.21,0:00:53.07,Default,,0,0,0,,te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em
Dialogue: 0,0:00:53.20,0:00:57.54,Default,,0,0,0,,kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra
Dialogue: 0,0:00:57.46,0:00:58.99,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày,{\i0}
Dialogue: 0,0:00:59.12,0:01:01.86,Default,,0,0,0,,{\i1}và vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:02.82,0:01:05.46,Default,,0,0,0,,{\i1}thì một ngày của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:05.71,0:01:08.53,Default,,0,0,0,,[~ Súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly]\NThực đơn của tôi chỉ có vỏn vẹn chừng đó.
Dialogue: 0,0:01:08.74,0:01:11.14,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì,{\i0}
Dialogue: 0,0:01:11.77,0:01:13.96,Default,,0,0,0,,{\i1}chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:01:14.06,0:01:16.67,Default,,0,0,0,,{\i1}Phương châm làm việc của tôi là vậy.{\i0}
Dialogue: 0,0:01:17.29,0:01:22.91,Default,,0,0,0,,{\i1}Quán mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:01:23.01,0:01:24.31,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:01:24.43,0:01:26.66,Default,,0,0,0,,{\i1}'Quán Ăn Đêm'.{\i0}
Dialogue: 0,0:01:27.06,0:01:29.19,Default,,0,0,0,,{\i1}Bạn hỏi liệu có khách khứa nào ghé không ư?{\i0}
Dialogue: 0,0:01:29.30,0:01:31.72,Default,,0,0,0,,{\i1}Thực ra là đông hơn bạn tưởng đấy.{\i0}
Dialogue: 0,0:01:32.29,0:01:35.89,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:01:36.61,0:01:39.66,Default,,0,0,0,,Tập 5\NCơm Trộn Bơ (Butter Rice)
Dialogue: 0,0:01:45.13,0:01:46.79,Default,,0,0,0,,À... Đúng rồi!
Dialogue: 0,0:01:46.88,0:01:49.40,Default,,0,0,0,,Con bé Yuriko sắp kết hôn rồi đấy!
Dialogue: 0,0:01:49.52,0:01:52.08,Default,,0,0,0,,Nghe bảo chú rể chính là mối tình đầu của nó\Ntừ hồi học cấp hai hay sao ấy,
Dialogue: 0,0:01:52.20,0:01:54.95,Default,,0,0,0,,rồi tình cờ gặp lại nhau nhờ công việc làm ăn,\Nđúng là duyên tiền định mà!
Dialogue: 0,0:01:55.05,0:01:56.55,Default,,0,0,0,,Khoan đã nào...
Dialogue: 0,0:01:56.64,0:01:58.11,Default,,0,0,0,,Nhắc lại xem năm nay Yuriko bao nhiêu tuổi rồi nhỉ?
Dialogue: 0,0:01:58.21,0:01:59.27,Default,,0,0,0,,36 tuổi.
Dialogue: 0,0:01:59.36,0:02:00.64,Default,,0,0,0,,Xấp xỉ hàng bốn (Arafo)* rồi còn đâu.\N(*Viết tắt của Around 40 - quanh ngưỡng 40 tuổi)
Dialogue: 0,0:02:00.73,0:02:03.20,Default,,0,0,0,,Vậy tính ra là... bao lâu nhỉ...
Dialogue: 0,0:02:03.59,0:02:06.87,Default,,0,0,0,,Cuộc hội ngộ sau tận hai mươi năm xa cách ư?!
Dialogue: 0,0:02:06.98,0:02:08.40,Default,,0,0,0,,Chứ còn gì nữa!
Dialogue: 0,0:02:08.50,0:02:11.08,Default,,0,0,0,,Lãng mạn như tiểu thuyết vậy!!
Dialogue: 0,0:02:11.56,0:02:14.44,Default,,0,0,0,,Đem so với người ta thì chị em tụi mình đúng là...
Dialogue: 0,0:02:14.54,0:02:16.65,Default,,0,0,0,,'Chị em tụi mình' cái gì cơ?\NĐừng có vơ đũa cả nắm đánh đồng tụi này với bà chứ?
Dialogue: 0,0:02:16.76,0:02:19.49,Default,,0,0,0,,Mình biết ngay mà.\NThứ đó thực sự tồn tại trên đời!
Dialogue: 0,0:02:19.60,0:02:21.00,Default,,0,0,0,,Là định mệnh ư?
Dialogue: 0,0:02:21.18,0:02:23.40,Default,,0,0,0,,Sợi chỉ đỏ định mệnh đó...
Dialogue: 0,0:02:23.48,0:02:26.77,Default,,0,0,0,,Sợi chỉ đỏ duy nhất mà bà làm tôi liên tưởng tới\Nlà một cuộn chỉ rối bù thì có.
Dialogue: 0,0:02:27.48,0:02:30.54,Default,,0,0,0,,Thà có sợi chỉ rối bù\Ncòn đỡ hơn là chẳng có sợi nào nhé!
Dialogue: 0,0:02:30.63,0:02:31.68,Default,,0,0,0,,Ờ ha, cũng đúng nhỉ?!
Dialogue: 0,0:02:31.77,0:02:34.62,Default,,0,0,0,,Nhưng cứ thử lại gần săm soi kỹ mà xem,\Nkiểu gì cũng lòi ra cả đống tật xấu cho coi.
Dialogue: 0,0:02:34.72,0:02:37.16,Default,,0,0,0,,Thôi dẹp mấy lời bàn lùi đó đi.
Dialogue: 0,0:02:47.44,0:02:48.73,Default,,0,0,0,,Lâu lắm không gặp Ông chủ.
Dialogue: 0,0:02:48.81,0:02:49.92,Default,,0,0,0,,Ồ!
Dialogue: 0,0:02:51.64,0:02:56.35,Default,,0,0,0,,Ồ... Không gian quán này trông cũng triển vọng phết đấy.
Dialogue: 0,0:02:57.61,0:03:00.32,Default,,0,0,0,,Hồi xưa khi tôi còn du học\Nở Paris trong cảnh không một xu dính túi,
Dialogue: 0,0:03:00.42,0:03:04.73,Default,,0,0,0,,tôi vẫn thường xuyên la cà\Nở mấy quán rượu bình dân (bistrot) kiểu thế này.
Dialogue: 0,0:03:05.88,0:03:07.47,Default,,0,0,0,,Nào, chúng ta ngồi vào góc đằng kia nhé?
Dialogue: 0,0:03:07.55,0:03:09.30,Default,,0,0,0,,Vâng, mời bác.
Dialogue: 0,0:03:09.42,0:03:11.69,Default,,0,0,0,,Hình như mình từng thấy ông này trên tivi rồi thì phải.
Dialogue: 0,0:03:14.14,0:03:19.35,Default,,0,0,0,,{\i1}Dù là ba sao hay năm sao Michelin đi chăng nữa,\Nthì cái quán nhỏ này cũng chẳng liên quan gì đến cuộc chơi đó.{\i0}
Dialogue: 0,0:03:19.36,0:03:21.67,Default,,0,0,0,,Ông chủ ơi.\NTrước tiên cứ cho tụi tôi vài chai bia đã.
Dialogue: 0,0:03:21.78,0:03:23.56,Default,,0,0,0,,À với lại...\NQuán mình còn đậu phụ chiên dày atsuage* không?
Dialogue: 0,0:03:21.78,0:03:23.56,Default,,0,0,0,,{\i1}(*loại đậu phụ cắt miếng dày chiên ngập dầu){\i0}
Dialogue: 0,0:03:23.65,0:03:24.46,Default,,0,0,0,,Vẫn còn đấy.
Dialogue: 0,0:03:24.69,0:03:27.00,Default,,0,0,0,,{\i1}- Vậy cho tụi tôi gọi món đó nhé.\N- Cơ mà, cậu Komi-chan này...{\i0}
Dialogue: 0,0:03:27.10,0:03:30.63,Default,,0,0,0,,{\i1}lại dẫn tới quán đúng cái kiểu người\Nmà tôi chúa ghét: mấy tay nhà phê bình ẩm thực.{\i0}
Dialogue: 0,0:03:35.77,0:03:37.91,Default,,0,0,0,,Ngon đấy.
Dialogue: 0,0:03:40.15,0:03:43.61,Default,,0,0,0,,Đã lâu lắm rồi tôi mới lại được\Nuống một ngụm bia ở Nhật Bản thế này.
Dialogue: 0,0:03:43.75,0:03:46.45,Default,,0,0,0,,Tôi cũng phát ngấy rượu vang Pháp rồi,\Nnên uống bia lại càng thấy sảng khoái hơn.
Dialogue: 0,0:03:46.55,0:03:48.05,Default,,0,0,0,,À... Vậy thì may quá,\Nem đưa bác tới đây đúng là chuẩn bài rồi.
Dialogue: 0,0:03:48.14,0:03:52.54,Default,,0,0,0,,Nhưng cái món tuyến ức bê Pháp (ris de veau)* hồi chiều nay\Nđúng là một thảm họa ẩm thực.
Dialogue: 0,0:03:48.14,0:03:52.54,Default,,0,0,0,,{\i1}(*món ăn thượng hạng của Pháp làm từ tuyến ức bê non){\i0}
Dialogue: 0,0:03:52.63,0:03:55.20,Default,,0,0,0,,Cố nuốt thêm một miếng nữa thôi\Nchắc tôi đã nôn thốc nôn tháo ngay tại bàn rồi.
Dialogue: 0,0:03:55.29,0:03:56.62,Default,,0,0,0,,Tệ đến mức đó cơ ạ?
Dialogue: 0,0:03:56.74,0:03:59.09,Default,,0,0,0,,Hương vị đậm đặc của nước sốt\Nchỉ miễn cưỡng che đậy được phần nào,
Dialogue: 0,0:03:59.19,0:04:02.18,Default,,0,0,0,,nhưng tay đầu bếp thậm chí còn chẳng biết\Nkhử sạch mùi máu tanh đúng cách.
Dialogue: 0,0:04:02.29,0:04:05.70,Default,,0,0,0,,Thật đáng sợ khi mấy kẻ nghiệp dư như thế\Nlại được phép đứng bếp phục vụ thực khách rồi nhận lời tung hô.
Dialogue: 0,0:04:05.83,0:04:11.07,Default,,0,0,0,,Nếu ở Paris thì cái nhà hàng đó\Nđã sập tiệm phá sản từ tám đời rồi.
Dialogue: 0,0:04:20.14,0:04:22.78,Default,,0,0,0,,À mà này.\NCô có thích ăn trứng cá muối caviar không?
Dialogue: 0,0:04:22.88,0:04:24.10,Default,,0,0,0,,À, tôi cũng không có sở thích đặc biệt nào với món đó...
Dialogue: 0,0:04:24.20,0:04:27.10,Default,,0,0,0,,Lần tới tôi sẽ dẫn cô đến\Nmột nhà hàng ruột mà tôi vẫn thường lui tới,
Dialogue: 0,0:04:27.19,0:04:29.62,Default,,0,0,0,,và cho cô nếm thử món bánh kếp blini*.
Dialogue: 0,0:04:27.19,0:04:29.62,Default,,0,0,0,,{\i1}(*Bánh kếp truyền thống của Nga){\i0}
Dialogue: 0,0:04:29.81,0:04:33.71,Default,,0,0,0,,Trong tất cả các món chế biến cùng trứng cá muối caviar,\Nthì đó là món ngon tuyệt đỉnh nhất mà cô có thể thưởng thức.
Dialogue: 0,0:04:35.78,0:04:39.42,Default,,0,0,0,,Đổi lại, cô chỉ cần mở cho tôi\Nmột chai sâm panh hảo hạng là được.
Dialogue: 0,0:04:42.95,0:04:47.51,Default,,0,0,0,,Tự dưng có kẻ ở đâu mò tới bốc mùi\Nlàm mất hết cả vị ngon bát cơm chan trà của mình.
Dialogue: 0,0:04:48.64,0:04:51.38,Default,,0,0,0,,Của hai người đây, đậu phụ chiên atsuage có rồi nhé.
Dialogue: 0,0:04:52.12,0:04:55.81,Default,,0,0,0,,- Ồ!\N- Cảm ơn Ông chủ.
Dialogue: 0,0:05:00.87,0:05:03.97,Default,,0,0,0,,Thế còn cái tiệm bánh pizza\Ntrong chương trình kỳ trước của bác thì sao ạ...
Dialogue: 0,0:05:04.06,0:05:06.23,Default,,0,0,0,,- Cái tiệm phong cách Ý đó hả?\N- Vâng.
Dialogue: 0,0:05:06.34,0:05:09.51,Default,,0,0,0,,À... Cái tiệm pizza đó ấy à...
Dialogue: 0,0:05:09.61,0:05:12.14,Default,,0,0,0,,chỉ đáng xếp hạng hai\Nngay cả khi tính theo mặt bằng chung ở Tokyo.
Dialogue: 0,0:05:12.24,0:05:18.23,Default,,0,0,0,,Ngay cái lúc ông ta chuẩn bị\Ndội gáo nước lạnh làm hỏng bét bầu không khí trong quán...
Dialogue: 0,0:05:21.29,0:05:22.75,Default,,0,0,0,,Mời vào!
Dialogue: 0,0:05:23.12,0:05:25.33,Default,,0,0,0,,Dạo này Ông chủ khỏe chứ?
Dialogue: 0,0:05:26.29,0:05:29.25,Default,,0,0,0,,Bác Goro là một trong số rất ít ỏi những người còn sót lại\Ncủa một nghề sắp mai một,
Dialogue: 0,0:05:29.37,0:05:31.44,Default,,0,0,0,,nghề nghệ sĩ hát rong (nagashi).
Dialogue: 0,0:05:46.76,0:05:48.07,Default,,0,0,0,,Của bác đây.
Dialogue: 0,0:05:48.16,0:05:50.90,Default,,0,0,0,,Một bát cơm trộn bơ và\Nmột chén súp Tonjiru nhỏ nhé.
Dialogue: 0,0:05:53.05,0:05:55.94,Default,,0,0,0,,Lần nào tôi cũng phải mang ơn Ông chủ rồi.
Dialogue: 0,0:06:11.99,0:06:14.62,Default,,0,0,0,,{\i1}Đợi khoảng chừng ba mươi giây\Ncho miếng bơ tan chảy thấm vào cơm nóng...{\i0}
Dialogue: 0,0:06:14.72,0:06:17.73,Default,,0,0,0,,{\i1}đó chính là phong cách thưởng thức của bác Goro.{\i0}
Dialogue: 0,0:06:29.01,0:06:31.31,Default,,0,0,0,,Rưới thêm một chút thôi...
Dialogue: 0,0:06:31.84,0:06:33.56,Default,,0,0,0,,Một chút thế này...
Dialogue: 0,0:06:37.92,0:06:42.60,Default,,0,0,0,,{\i1}Và sau đó, nhỏ thêm vài giọt nước tương,\Nrồi nhẹ nhàng đảo đều bát cơm lên.{\i0}
Dialogue: 0,0:06:51.92,0:06:54.18,Default,,0,0,0,,Xin lỗi Ông chủ.\NCho em gọi một bát y hệt như thế được không?
Dialogue: 0,0:06:54.28,0:06:55.57,Default,,0,0,0,,Cho cả tôi nữa nhé.
Dialogue: 0,0:06:55.97,0:06:57.41,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:06:58.14,0:06:59.61,Default,,0,0,0,,Lại cái gì nữa đây...
Dialogue: 0,0:06:59.70,0:07:03.60,Default,,0,0,0,,Đừng ăn nữa! Hai bà đã chén tì tì\Nhết hai bát cơm chan trà rồi còn gì.
Dialogue: 0,0:07:05.31,0:07:08.13,Default,,0,0,0,,Tôi không bao giờ lấy tiền cơm của bác Goro.
Dialogue: 0,0:07:08.24,0:07:09.54,Default,,0,0,0,,Và để thay cho tiền bữa ăn...
Dialogue: 0,0:07:09.63,0:07:13.16,Default,,0,0,0,,{\i1}bác ấy luôn tặng lại cho quán tôi đúng một bản nhạc.{\i0}
Dialogue: 0,0:07:13.28,0:07:15.37,Default,,0,0,0,,Lần nào cũng chỉ duy nhất bài hát ấy.
Dialogue: 0,0:07:23.70,0:07:27.64,Default,,0,0,0,,~ Phiêu bạt giang hồ suốt 40 năm qua,'
Dialogue: 0,0:07:27.78,0:07:32.04,Default,,0,0,0,,'Người vùng này ai cũng biết đến tiếng tôi,\Nngười có thể làm trẻ con đang khóc cũng phải nhoẻn miệng cười,'
Dialogue: 0,0:07:32.11,0:07:33.84,Default,,0,0,0,,'Tên của tôi là Goro.'
Dialogue: 0,0:07:35.79,0:07:39.89,Default,,0,0,0,,À... Nếu mọi người đang dùng bữa dở,\Nthì cứ tự nhiên ăn tiếp đi nhé, đừng ngại.
Dialogue: 0,0:07:45.81,0:07:54.04,Default,,0,0,0,,'Con đường tìm về Hakodate\Nôi sao xa xôi và khúc khuỷu quanh co.'
Dialogue: 0,0:07:54.16,0:08:01.63,Default,,0,0,0,,'Tôi đã băng qua muôn trùng sóng dữ bão giông.'
Dialogue: 0,0:08:01.97,0:08:10.99,Default,,0,0,0,,'Ngày em tiễn bước tôi đi, em đã quay mặt giấu đi\Nnhững giọt nước mắt đang lăn dài trên gò má.'
Dialogue: 0,0:08:11.10,0:08:18.95,Default,,0,0,0,,'Ký ức về em nhói buốt trong tim\Nnhư một vết thương từ thuở xa xôi,'
Dialogue: 0,0:08:19.14,0:08:26.58,Default,,0,0,0,,'một nỗi khát khao chẳng cách nào kìm nén nổi.'
Dialogue: 0,0:08:32.72,0:08:38.85,Default,,0,0,0,,'Từng đợt sóng đau thương thiêu đốt cả tâm hồn tôi.'
Dialogue: 0,0:08:43.50,0:08:45.45,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn nhé.
Dialogue: 0,0:08:50.27,0:08:52.57,Default,,0,0,0,,Mấy bà có nghe thấy tiếng hát vừa rồi không?!\NHay tuyệt vời luôn ấy!
Dialogue: 0,0:08:52.66,0:08:56.04,Default,,0,0,0,,Nghe mà da diết thấu tận tâm can.
Dialogue: 0,0:08:57.20,0:08:59.01,Default,,0,0,0,,Cho tôi một bát cơm trộn bơ.
Dialogue: 0,0:09:01.85,0:09:04.67,Default,,0,0,0,,Ông chủ làm cho tôi\Nmột suất cơm trộn bơ luôn nhé.
Dialogue: 0,0:09:07.02,0:09:08.85,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:09:28.84,0:09:34.50,Default,,0,0,0,,Xin giới thiệu món thịt bò Wagyu* áp chảo kiểu Pháp (poêlé)**\Nđặt trên lớp sốt rượu vang đỏ ăn kèm chả nghiền quenelle***.
Dialogue: 0,0:09:28.84,0:09:34.50,Default,,0,0,0,,{\i1}(*Thịt bò Nhật thượng hạng **Áp chảo kiểu Pháp\N***Viên thịt/cá nghiền trộn vụn bánh mì và kem){\i0}
Dialogue: 0,0:09:59.09,0:10:00.44,Default,,0,0,0,,Thầy thấy thế nào ạ?!
Dialogue: 0,0:10:00.55,0:10:01.92,Default,,0,0,0,,Ồ...
Dialogue: 0,0:10:03.90,0:10:05.44,Default,,0,0,0,,Nguyên liệu nhìn chung cũng tạm chấp nhận được.
Dialogue: 0,0:10:05.54,0:10:10.75,Default,,0,0,0,,Dạ vâng, nhà hàng chúng tôi nhập trực tiếp thịt bò lông đen\Nhạng A5 thượng hạng tươi mới mỗi ngày đấy ạ.
Dialogue: 0,0:10:11.01,0:10:14.94,Default,,0,0,0,,Thớ thịt tươi ngon và mềm mịn đến mức\Nthậm chí có thể thưởng thức sống ngay được.
Dialogue: 0,0:10:16.35,0:10:19.02,Default,,0,0,0,,Phần viên quenelle được chế biến từ\Nba loại sốt thảo mộc pesto khác nhau,
Dialogue: 0,0:10:19.16,0:10:21.46,Default,,0,0,0,,trong khi nước sốt vang đỏ được ủ hương nấm cục truffle, và...
Dialogue: 0,0:10:21.55,0:10:22.58,Default,,0,0,0,,Xin thứ lỗi cho sự bất tiện này,
Dialogue: 0,0:10:22.67,0:10:25.37,Default,,0,0,0,,nhưng đã đến giờ thầy phải có mặt\Ntại một bữa tiệc chiêu đãi ở khu Hiroo* rồi ạ.
Dialogue: 0,0:10:22.67,0:10:25.37,Default,,0,0,0,,{\i1}(*khu phố nhà giàu sang trọng ở quận Shibuya){\i0}
Dialogue: 0,0:10:25.46,0:10:28.18,Default,,0,0,0,,Mời thầy...
Dialogue: 0,0:10:29.66,0:10:31.61,Default,,0,0,0,,Chúng ta lên đường thôi chứ ạ?
Dialogue: 0,0:10:31.71,0:10:33.05,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:38.34,0:10:39.54,Default,,0,0,0,,{\i1}Ông chủ à.{\i0}
Dialogue: 0,0:10:39.64,0:10:41.70,Default,,0,0,0,,{\i1}Hôm qua tôi đã làm anh phật lòng phải không?{\i0}
Dialogue: 0,0:10:41.80,0:10:45.68,Default,,0,0,0,,Vì đã tự ý dẫn một nhà phê bình ẩm thực trứ danh\Nnhư bác Toyama Masao tới quán mình...
Dialogue: 0,0:10:45.79,0:10:47.39,Default,,0,0,0,,Cũng có một chút đấy.
Dialogue: 0,0:10:47.51,0:10:49.95,Default,,0,0,0,,Tôi chỉ muốn cho ông ấy được tận mắt chứng kiến thôi.
Dialogue: 0,0:10:50.25,0:10:52.63,Default,,0,0,0,,Xem thế nào mới là hương vị của những món ăn chân thực.
Dialogue: 0,0:10:54.46,0:10:56.03,Default,,0,0,0,,Cho tôi một bát cơm trộn bơ.
Dialogue: 0,0:10:56.87,0:10:58.69,Default,,0,0,0,,Một món giản dị như cơm trộn bơ thế này,
Dialogue: 0,0:10:58.80,0:11:02.97,Default,,0,0,0,,chỉ cần xới cơm nóng rồi đặt miếng bơ lên trên là xong,\Nchẳng phải bác hoàn toàn có thể tự làm ở nhà sao.
Dialogue: 0,0:11:04.06,0:11:06.69,Default,,0,0,0,,Bà vợ nhà tôi sống ở nước ngoài lâu năm quá rồi,
Dialogue: 0,0:11:06.81,0:11:09.79,Default,,0,0,0,,nên ở nhà suốt ngày bà ấy chỉ dọn toàn bánh mì cho tôi ăn thôi.
Dialogue: 0,0:11:10.27,0:11:12.06,Default,,0,0,0,,Ồ ra thế!
Dialogue: 0,0:12:02.58,0:12:04.37,Default,,0,0,0,,Không biết tối nay...
Dialogue: 0,0:12:04.50,0:12:06.85,Default,,0,0,0,,người nghệ sĩ hát rong hôm trước có ghé quán không nhỉ?
Dialogue: 0,0:12:07.81,0:12:09.84,Default,,0,0,0,,Ý bác hỏi bác Goro ấy hả?
Dialogue: 0,0:12:10.50,0:12:14.76,Default,,0,0,0,,Bác ấy chỉ ghé quán đúng mỗi tuần một lần,\Nvào các tối thứ Năm thôi.
Dialogue: 0,0:12:17.01,0:12:21.23,Default,,0,0,0,,Cái nghề đi hát rong dạo qua các quán rượu như thế,\Nliệu ông ấy có kiếm đủ tiền nuôi sống bản thân không?
Dialogue: 0,0:12:22.03,0:12:24.17,Default,,0,0,0,,Chuyện đó thì tôi cũng chịu thôi.
Dialogue: 0,0:12:35.91,0:12:38.67,Default,,0,0,0,,Vậy... Tiền ăn của tôi đây.
Dialogue: 0,0:12:38.78,0:12:42.73,Default,,0,0,0,,Tiếc quá, hiện trong ngăn kéo tôi lại\Nkhông có đủ tiền lẻ để thối lại tờ mệnh giá lớn này rồi.
Dialogue: 0,0:12:42.83,0:12:45.65,Default,,0,0,0,,Ồ... Đằng nào tuần sau tôi cũng lại ghé nữa mà,
Dialogue: 0,0:12:45.76,0:12:48.16,Default,,0,0,0,,nên cứ để lần tới thối lại cho tôi cũng được.
Dialogue: 0,0:13:08.24,0:13:10.86,Default,,0,0,0,,Bác tài cho tôi xuống ở góc đường đằng kia nhé?
Dialogue: 0,0:13:10.97,0:13:12.70,Default,,0,0,0,,Nhưng chỗ này vẫn còn cách nhà của thầy xa lắm mà?!
Dialogue: 0,0:13:12.97,0:13:14.07,Default,,0,0,0,,Không sao đâu.
Dialogue: 0,0:13:14.17,0:13:17.07,Default,,0,0,0,,Tôi có một chốn cần phải\Nghé qua một lát đã.
Dialogue: 0,0:13:17.18,0:13:18.79,Default,,0,0,0,,Cô cứ đi xe về trước đi.
Dialogue: 0,0:13:18.88,0:13:22.03,Default,,0,0,0,,À... Dạ vâng.
Dialogue: 0,0:13:24.66,0:13:26.52,Default,,0,0,0,,Kể từ sau đêm hôm ấy,
Dialogue: 0,0:13:26.64,0:13:30.13,Default,,0,0,0,,đều đặn tối thứ Năm hàng tuần,\Nbác Toyama đều ghé quán tôi.
Dialogue: 0,0:13:40.11,0:13:41.52,Default,,0,0,0,,Tình hình công việc dạo này thế nào?
Dialogue: 0,0:13:41.82,0:13:43.13,Default,,0,0,0,,À... Chào thầy ạ!
Dialogue: 0,0:13:43.29,0:13:45.94,Default,,0,0,0,,Cái tiệm sushi mà thầy viết bài phê bình dạo trước\Nđúng là tạo nên cơn sốt lớn thật đấy.
Dialogue: 0,0:13:46.05,0:13:47.82,Default,,0,0,0,,Tổng biên tập cũng hài lòng với bài viết đó lắm ạ.
Dialogue: 0,0:13:47.93,0:13:51.13,Default,,0,0,0,,Ghen tị với hai người quá đi mất!\NƯớc gì mình cũng được đặt chân tới nhà hàng đó một lần.
Dialogue: 0,0:13:51.26,0:13:55.39,Default,,0,0,0,,Nhưng với đồng lương còm cõi của tôi\Nthì chắc là trèo cao quá sức rồi nhỉ?
Dialogue: 0,0:13:59.67,0:14:02.41,Default,,0,0,0,,Ông chủ.\NCho một bát cơm trộn bơ.
Dialogue: 0,0:14:03.39,0:14:04.86,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:14:05.35,0:14:06.44,Default,,0,0,0,,Tụi mình gọi món gì bây giờ nhỉ?
Dialogue: 0,0:14:06.52,0:14:09.53,Default,,0,0,0,,Vị nhà phê bình ẩm thực đáng kính của chúng ta\Ntối thứ Năm nào cũng ghé quán không sót buổi nào,
Dialogue: 0,0:14:09.64,0:14:12.98,Default,,0,0,0,,nhưng suốt một thời gian dài lại chẳng thấy\Nbóng dáng bác Goro xuất hiện đâu cả.
Dialogue: 0,0:14:16.63,0:14:18.18,Default,,0,0,0,,Bác Goro ơi!
Dialogue: 0,0:14:18.28,0:14:19.53,Default,,0,0,0,,Đống hàng này bác vác nổi chứ?
Dialogue: 0,0:14:19.67,0:14:20.62,Default,,0,0,0,,Được mà.
Dialogue: 0,0:14:20.71,0:14:22.26,Default,,0,0,0,,Ngại quá, cứ phải bắt bác làm việc nặng nhọc thế này.
Dialogue: 0,0:14:22.37,0:14:27.24,Default,,0,0,0,,Nhưng thời buổi kinh tế suy thoái khó khăn thế này,\Nmấy công việc lao động chân tay lương thấp lại đang nhiều việc.
Dialogue: 0,0:14:28.70,0:14:30.65,Default,,0,0,0,,Vậy phần việc này tôi giao lại cho bác nhé.
Dialogue: 0,0:14:52.28,0:14:54.78,Default,,0,0,0,,Ngày mà bác Goro cuối cùng cũng xuất hiện trở lại...
Dialogue: 0,0:14:54.90,0:14:59.71,Default,,0,0,0,,là vào khoảng ba tháng sau khi\Nbác Toyama trở thành khách quen của quán.
Dialogue: 0,0:15:07.48,0:15:09.57,Default,,0,0,0,,Bác Goro...
Dialogue: 0,0:15:13.23,0:15:15.94,Default,,0,0,0,,Suốt bao năm qua tôi đã mang ơn Ông chủ nhiều lắm,
Dialogue: 0,0:15:16.51,0:15:19.19,Default,,0,0,0,,nhưng giờ đây sự nghiệp làm nghệ sĩ hát rong của tôi\Nđến lúc phải khép lại rồi.
Dialogue: 0,0:15:19.29,0:15:21.64,Default,,0,0,0,,Đã xảy ra chuyện gì sao bác?
Dialogue: 0,0:15:22.27,0:15:25.23,Default,,0,0,0,,Đôi tay tôi không còn gảy đàn guitar được nữa rồi.
Dialogue: 0,0:15:25.93,0:15:29.94,Default,,0,0,0,,Tôi bị dập gãy mấy ngón tay trong lúc làm việc ở nhà máy.
Dialogue: 0,0:15:30.19,0:15:34.16,Default,,0,0,0,,Hôm nay tôi đi một vòng để nói lời cảm tạ và từ biệt tất cả những người\Nđã từng rộng lòng cưu mang ủng hộ tiếng hát của tôi.
Dialogue: 0,0:15:34.25,0:15:36.47,Default,,0,0,0,,Sao mọi chuyện lại đột ngột quá thế này...
Dialogue: 0,0:15:36.93,0:15:38.61,Default,,0,0,0,,Tôi xin phép cáo từ nhé.
Dialogue: 0,0:15:39.03,0:15:41.17,Default,,0,0,0,,Anh Goro.
Dialogue: 0,0:15:41.27,0:15:44.70,Default,,0,0,0,,Liệu rằng...\Nanh có còn nhận ra em là ai không?
Dialogue: 0,0:15:46.18,0:15:50.22,Default,,0,0,0,,Em là Masao, cậu em trai của chị Ritsuko đây.
Dialogue: 0,0:15:50.50,0:15:53.98,Default,,0,0,0,,Cậu nhóc mà ngày xưa\Nđược anh dạy gảy đàn guitar ấy...
Dialogue: 0,0:15:54.36,0:15:56.11,Default,,0,0,0,,Ngón trỏ của em đặt vào phím này nhé.
Dialogue: 0,0:15:56.21,0:15:58.05,Default,,0,0,0,,Còn ngón giữa thì bấm vào dây này.
Dialogue: 0,0:15:58.15,0:16:00.18,Default,,0,0,0,,Dùng ngón áp út ấn thật mạnh vào điểm này.
Dialogue: 0,0:16:00.28,0:16:00.32,Default,,0,0,0,,Của hai anh em đây.
Dialogue: 0,0:16:02.48,0:16:03.18,Default,,0,0,0,,- Em mời anh ăn ạ!\N- Ừ.
Dialogue: 0,0:16:04.93,0:16:07.24,Default,,0,0,0,,Em xin lỗi nhé,\Ntrong nhà chỉ còn mỗi chừng này đồ ăn thôi.
Dialogue: 0,0:16:08.43,0:16:12.18,Default,,0,0,0,,Masao này, em làm theo cách này,\Ncơm sẽ còn thơm ngon hơn gấp bội đấy.
Dialogue: 0,0:16:12.45,0:16:14.20,Default,,0,0,0,,Nhỏ một chút thôi...
Dialogue: 0,0:16:15.91,0:16:17.63,Default,,0,0,0,,Rưới nhẹ một chút vào đây...
Dialogue: 0,0:16:21.03,0:16:22.70,Default,,0,0,0,,Đúng rồi đấy!\NNgon tuyệt cú mèo luôn.
Dialogue: 0,0:16:24.12,0:16:26.01,Default,,0,0,0,,'Đúng rồi đấy!\NNgon tuyệt cú mèo luôn!'
Dialogue: 0,0:16:26.38,0:16:27.67,Default,,0,0,0,,Đừng có nhại lại lời anh nữa!
Dialogue: 0,0:16:33.40,0:16:36.49,Default,,0,0,0,,Thì ra là vậy sao?
Dialogue: 0,0:16:36.82,0:16:39.74,Default,,0,0,0,,Thế anh đã lập gia đình riêng gì chưa?
Dialogue: 0,0:16:40.93,0:16:43.59,Default,,0,0,0,,Không, tôi vẫn cứ thui thủi một mình thôi.
Dialogue: 0,0:16:44.90,0:16:47.56,Default,,0,0,0,,Chị gái của em hiện giờ cũng vẫn đang sống một mình đấy.
Dialogue: 0,0:16:49.15,0:16:51.55,Default,,0,0,0,,Nhưng mà, chẳng phải Ritsuko...
Dialogue: 0,0:16:51.76,0:16:56.46,Default,,0,0,0,,Năm xưa chị ấy từng định nhắm mắt đưa chân\Nlấy người đàn ông do bố mẹ sắp đặt,
Dialogue: 0,0:16:56.63,0:17:01.29,Default,,0,0,0,,nhưng cuối cùng chị ấy đã đổi ý\Nvà bỏ trốn quay trở về tìm anh.
Dialogue: 0,0:17:08.48,0:17:14.94,Default,,0,0,0,,Thế nhưng khi chị ấy quay về đến nơi,\Nthì anh đã rời khỏi mảnh đất Hakodate mất rồi.
Dialogue: 0,0:17:28.15,0:17:31.41,Default,,0,0,0,,Biết bao biến cố thăng trầm đã xảy ra kể từ ngày ấy,
Dialogue: 0,0:17:31.51,0:17:35.73,Default,,0,0,0,,nhưng cho đến tận bây giờ chị ấy vẫn sống cô đơn lẻ bóng một mình.
Dialogue: 0,0:17:36.73,0:17:41.72,Default,,0,0,0,,Hiện chị ấy đang mở một quán karaoke nhỏ\Nở khu phố Matsukaze-cho.
Dialogue: 0,0:17:43.63,0:17:48.72,Default,,0,0,0,,Em tin chắc rằng trong thâm tâm,\Nchị ấy vẫn luôn mỏi mắt chờ đợi anh quay về.
Dialogue: 0,0:17:55.60,0:17:57.62,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:17:57.73,0:18:00.02,Default,,0,0,0,,Mọi chuyện giờ đây đã quá muộn màng rồi.
Dialogue: 0,0:18:01.68,0:18:05.36,Default,,0,0,0,,Món cơm trộn bơ dù có trải qua bao nhiêu năm tháng đi chăng nữa,\Nvẫn chẳng bao giờ mất đi hương vị nguyên vẹn ban đầu của nó.
Dialogue: 0,0:18:11.98,0:18:13.83,Default,,0,0,0,,Của bác đây.
Dialogue: 0,0:18:17.30,0:18:19.98,Default,,0,0,0,,Bác Goro à.
Dialogue: 0,0:18:20.09,0:18:25.47,Default,,0,0,0,,Hóa ra ở mảnh đất Hakodate thực sự có một người thương\Nđang chờ đợi bác y như trong lời bài hát ấy.
Dialogue: 0,0:19:22.52,0:19:24.60,Default,,0,0,0,,Chỉ một chút thôi...
Dialogue: 0,0:20:36.54,0:20:38.76,Default,,0,0,0,,{\i1}Theo lời bác Toyama kể lại,{\i0}
Dialogue: 0,0:20:39.53,0:20:43.22,Default,,0,0,0,,{\i1}sau đêm hôm đó, bác Goro đã khăn gói\Ntrở về mảnh đất Hakodate,{\i0}
Dialogue: 0,0:20:43.86,0:20:47.80,Default,,0,0,0,,{\i1}và nghe đâu hiện giờ bác ấy đang\Nphụ giúp chị gái của bác Toyama trông coi quán bar nhỏ.{\i0}
Dialogue: 0,0:20:53.73,0:20:55.65,Default,,0,0,0,,Món gì thế này?
Dialogue: 0,0:20:55.75,0:20:58.55,Default,,0,0,0,,Không sao đâu, chị cứ ăn thử đi.
Dialogue: 0,0:20:58.93,0:21:00.62,Default,,0,0,0,,Ừ...
Dialogue: 0,0:21:04.83,0:21:07.25,Default,,0,0,0,,Sau khi bác Goro rời khỏi thành phố,
Dialogue: 0,0:21:07.36,0:21:10.23,Default,,0,0,0,,số lượng khách gọi món cơm trộn bơ ở quán tôi cũng thưa dần đi.
Dialogue: 0,0:21:12.21,0:21:14.46,Default,,0,0,0,,Thế nhưng, ít nhất là đối với người đàn ông này,
Dialogue: 0,0:21:14.69,0:21:17.00,Default,,0,0,0,,thói quen ấy vẫn chẳng hề thay đổi.
Dialogue: 0,0:21:22.13,0:21:24.23,Default,,0,0,0,,Ngon tuyệt vời!
Dialogue: 0,0:21:27.01,0:21:28.09,Default,,0,0,0,,Ông chủ ơi!
Dialogue: 0,0:21:28.20,0:21:30.21,Default,,0,0,0,,Cho ba bát cơm trộn bơ cho ba cô gái bên này nhé!
Dialogue: 0,0:21:30.48,0:21:32.04,Default,,0,0,0,,Ủa?!
Dialogue: 0,0:21:32.13,0:21:34.09,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:21:36.06,0:21:37.17,Default,,0,0,0,,Thầy này.
Dialogue: 0,0:21:37.28,0:21:40.15,Default,,0,0,0,,Có phải thầy đang định viết bài đánh giá về quán ăn này\Ncho một tờ tạp chí ẩm thực nào đó không ạ?
Dialogue: 0,0:21:40.28,0:21:41.89,Default,,0,0,0,,Đừng hòng tôi viết một chữ nào!
Dialogue: 0,0:21:42.14,0:21:44.82,Default,,0,0,0,,Tôi tuyệt đối không muốn thiên hạ\Nbiết đến sự tồn tại của cái quán nhỏ này.
Dialogue: 0,0:21:44.91,0:21:46.97,Default,,0,0,0,,Sao lại thế ạ?
Dialogue: 0,0:21:47.14,0:21:50.33,Default,,0,0,0,,Nếu khách khứa kéo đến đây đông nghẹt,\Nthì tôi còn chỗ đâu mà ngồi ăn nữa.
Dialogue: 0,0:21:50.43,0:21:53.47,Default,,0,0,0,,- Đã thế lại còn...\N- Lại còn sao nữa cơ ạ?
Dialogue: 0,0:21:53.63,0:21:57.39,Default,,0,0,0,,Làm sao người ta có thể chấm điểm xếp hạng\Ncho những món ăn mang hương vị như thế này được.
Dialogue: 0,0:22:01.05,0:22:02.64,Default,,0,0,0,,Cho thêm một bát nữa nhé!
Dialogue: 0,0:22:06.67,0:22:08.02,Default,,0,0,0,,Cơ mà,
Dialogue: 0,0:22:08.13,0:22:12.21,Default,,0,0,0,,trên đời này thực sự có một nhà phê bình ẩm thực\Ngiản dị đến thế sao?
Dialogue: 0,0:22:12.39,0:22:13.78,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:22:16.64,0:22:20.28,Default,,0,0,0,,~ Còn tiếp ~
Dialogue: 0,0:22:21.45,0:22:24.56,Default,,0,0,0,,Vừa giản dị dễ làm lại vừa thơm ngon nức mũi,
Dialogue: 0,0:22:24.67,0:22:28.41,Default,,0,0,0,,{\i1}món cơm trộn bơ đơn giản chỉ là đặt một miếng bơ\Nlên trên mặt bát cơm trắng vừa xới nóng hổi,{\i0}
Dialogue: 0,0:22:28.75,0:22:30.54,Default,,0,0,0,,{\i1}rồi kiên nhẫn chờ cho bơ tan chảy ra, chỉ có vậy mà thôi.{\i0}
Dialogue: 0,0:22:30.66,0:22:32.89,Default,,0,0,0,,Hương thơm béo ngậy của bơ\Nthực sự quyến rũ không sao cưỡng lại nổi.
Dialogue: 0,0:22:33.46,0:22:36.51,Default,,0,0,0,,Ngoài ra, vì các loại bơ bán ngoài cửa hàng\Nvốn đã có sẵn vị mặn của muối rồi,
Dialogue: 0,0:22:36.60,0:22:39.99,Default,,0,0,0,,nên các bạn chỉ cần nhỏ thêm một chút xíu,
Dialogue: 0,0:22:40.21,0:22:43.15,Default,,0,0,0,,đúng một chút xíu nước tương thôi nhé.
Dialogue: 0,0:22:44.78,0:22:46.39,Default,,0,0,0,,Cảnh báo hấp thụ quá nhiều lượng muối đấy nhé!
Dialogue: 0,0:22:46.51,0:22:51.28,Default,,0,0,0,,Cho nhiều nước tương hơn mức đó sẽ làm át mất,\Ncòn vừa đủ một chút sẽ tôn lên hương vị béo ngậy khó cưỡng của bơ.
Dialogue: 0,0:22:51.40,0:22:54.08,Default,,0,0,0,,Bạn có thể lấy lá rong biển khô (nori) cuộn cơm lại để ăn,
Dialogue: 0,0:22:54.20,0:22:57.13,Default,,0,0,0,,hoặc rắc thêm chút gia vị yêu thích nào khác cũng đều hợp cả.
Dialogue: 0,0:22:58.11,0:23:00.10,Default,,0,0,0,,Ủa?! Bác Goro,\Nbác vẫn còn ngồi ở đây sao?
Dialogue: 0,0:23:00.23,0:23:06.00,Default,,0,0,0,,Chúc mọi người có những giấc mơ thật đẹp...
Dialogue: 0,0:23:06.15,0:23:12.12,Default,,0,0,0,,Chúc mọi người ngủ ngon nhé!
Dialogue: 0,0:23:12.30,0:23:14.80,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:23:12.30,0:23:14.80,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:23:14.96,0:23:19.75,Default,,0,0,0,,~ KOBAYASHI Kaoru ~\NÔng chủ
Dialogue: 0,0:23:20.47,0:23:24.04,Default,,0,0,0,,~ IWAMATSU Ryo ~\NToyama Masao
Dialogue: 0,0:23:24.62,0:23:25.97,Default,,0,0,0,,~ SUDO Risa ~\NMiki
Dialogue: 0,0:23:26.24,0:23:27.94,Default,,0,0,0,,~ KOBAYASHI Asako ~\NRumi
Dialogue: 0,0:23:28.37,0:23:30.86,Default,,0,0,0,,~ YOSHIMOTO Naoko ~\NKana
