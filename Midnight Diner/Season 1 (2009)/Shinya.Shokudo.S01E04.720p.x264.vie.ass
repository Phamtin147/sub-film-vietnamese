Dialogue: 0,0:00:00.00,0:00:01.81,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:00:00.00,0:00:01.81,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:00:02.31,0:00:05.79,Default,,0,0,0,,Ca khúc mở đầu\NOmohide (Hoài Niệm) - Trình bày: Suzuki Tsunekichi
Dialogue: 0,0:00:02.31,0:00:05.79,Default,,0,0,0,,~ KOBAYASHI Kaoru ~
Dialogue: 0,0:00:09.13,0:00:12.61,Default,,0,0,0,,~ KAZAMA Toru ~
Dialogue: 0,0:00:14.40,0:00:17.47,Default,,0,0,0,,~ TANAKA Sogen ~
Dialogue: 0,0:00:18.95,0:00:21.83,Default,,0,0,0,,~ SASAKI Sumie ~
Dialogue: 0,0:00:22.75,0:00:27.48,Default,,0,0,0,,kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra
Dialogue: 0,0:00:23.15,0:00:26.58,Default,,0,0,0,,Đạo diễn: OIKAWA Takuro
Dialogue: 0,0:00:27.76,0:00:32.50,Default,,0,0,0,,ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió
Dialogue: 0,0:00:32.77,0:00:37.64,Default,,0,0,0,,sora ni ukabu kumo no naka ni\NRồi từng chút một tan biến dần
Dialogue: 0,0:00:37.87,0:00:42.83,Default,,0,0,0,,sukoshi zutsu kie te yuku\NVào tầng mây trôi bồng bềnh trên cao
Dialogue: 0,0:00:43.07,0:00:48.16,Default,,0,0,0,,tooku takai sora no naka de\NTừ giữa bầu trời cao vời vợi
Dialogue: 0,0:00:48.28,0:00:52.77,Default,,0,0,0,,te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em
Dialogue: 0,0:00:53.02,0:00:57.42,Default,,0,0,0,,kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra
Dialogue: 0,0:00:57.23,0:00:59.10,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày,{\i0}
Dialogue: 0,0:00:59.20,0:01:02.38,Default,,0,0,0,,{\i1}và vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:02.79,0:01:05.48,Default,,0,0,0,,{\i1}thì một ngày của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:06.44,0:01:08.58,Default,,0,0,0,,[~ Súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly]\NThực đơn của tôi chỉ có vỏn vẹn chừng đó.
Dialogue: 0,0:01:08.79,0:01:11.63,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì,{\i0}
Dialogue: 0,0:01:11.75,0:01:13.92,Default,,0,0,0,,{\i1}chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:01:14.06,0:01:16.06,Default,,0,0,0,,{\i1}Phương châm làm việc của tôi là vậy.{\i0}
Dialogue: 0,0:01:17.25,0:01:22.72,Default,,0,0,0,,{\i1}Quán mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:01:22.94,0:01:24.00,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:01:24.11,0:01:26.36,Default,,0,0,0,,{\i1}'Quán Ăn Đêm'.{\i0}
Dialogue: 0,0:01:26.95,0:01:28.68,Default,,0,0,0,,{\i1}Bạn hỏi liệu có khách khứa nào ghé không ư?{\i0}
Dialogue: 0,0:01:29.18,0:01:31.29,Default,,0,0,0,,{\i1}Thực ra là đông hơn bạn tưởng đấy.{\i0}
Dialogue: 0,0:01:31.74,0:01:34.64,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:01:34.86,0:01:40.23,Default,,0,0,0,,Tập 4\NSalad Khoai Tây
Dialogue: 0,0:01:47.71,0:01:50.48,Default,,0,0,0,,{\i1}Món đầu tiên tôi bắt tay vào chuẩn bị\Ntrước giờ mở cửa quán chính là...{\i0}
Dialogue: 0,0:01:50.58,0:01:52.26,Default,,0,0,0,,{\i1}salad khoai tây.{\i0}
Dialogue: 0,0:01:52.70,0:01:55.51,Default,,0,0,0,,{\i1}Bởi lẽ món này khi để mát trong tủ lạnh\Nsẽ đậm đà và ngon hơn rất nhiều...{\i0}
Dialogue: 0,0:01:55.65,0:01:58.44,Default,,0,0,0,,{\i1}so với lúc vừa mới trộn xong.{\i0}
Dialogue: 0,0:02:05.71,0:02:07.34,Default,,0,0,0,,Xong rồi đây...
Dialogue: 0,0:02:08.17,0:02:09.40,Default,,0,0,0,,{\i1}Và nhân tiện,{\i0}
Dialogue: 0,0:02:09.56,0:02:12.41,Default,,0,0,0,,{\i1}nhắc đến món salad khoai tây...{\i0}
Dialogue: 0,0:02:15.37,0:02:16.71,Default,,0,0,0,,Mời vào.
Dialogue: 0,0:02:16.80,0:02:18.06,Default,,0,0,0,,Cho một phần salad khoai tây.
Dialogue: 0,0:02:18.38,0:02:19.80,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:02:21.00,0:02:27.07,Default,,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)\NQuán Ăn Đêm - Shinya Shokudō
Dialogue: 0,0:02:29.36,0:02:30.95,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:02:38.83,0:02:41.77,Default,,0,0,0,,{\i1}Dạo gần đây, vị khách này\Nthỉnh thoảng lại ghé qua quán.{\i0}
Dialogue: 0,0:02:41.86,0:02:43.98,Default,,0,0,0,,- Cho tôi gọi thêm một đĩa nữa nhé.\N- Có ngay.
Dialogue: 0,0:02:44.09,0:02:48.32,Default,,0,0,0,,{\i1}Lần nào ghé anh ta cũng gọi\Nđúng hai đĩa salad khoai tây.{\i0}
Dialogue: 0,0:02:48.96,0:02:53.98,Default,,0,0,0,,Xin thứ lỗi cho sự đường đột của em,
Dialogue: 0,0:02:54.34,0:02:57.27,Default,,0,0,0,,nhưng chẳng phải anh chính là\Ndanh thủ Erect Ohki đó sao?
Dialogue: 0,0:02:57.58,0:02:59.53,Default,,0,0,0,,Cậu nhầm người rồi.
Dialogue: 0,0:02:59.84,0:03:02.35,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:03:02.97,0:03:07.10,Default,,0,0,0,,{\i1}Chiếc nhẫn kia cùng với\Nvết bớt đặc trưng đó rõ ràng là...{\i0}
Dialogue: 0,0:03:07.21,0:03:09.33,Default,,0,0,0,,Em chắc chắn không thể nào nhầm được.
Dialogue: 0,0:03:09.73,0:03:11.65,Default,,0,0,0,,Anh chính là huyền thoại\NErect Ohki bằng xương bằng thịt, đúng không ạ?
Dialogue: 0,0:03:12.53,0:03:14.30,Default,,0,0,0,,Tôi đã bảo không phải tôi mà.
Dialogue: 0,0:03:14.41,0:03:16.46,Default,,0,0,0,,Ủa? Thật hả?
Dialogue: 0,0:03:16.56,0:03:19.51,Default,,0,0,0,,Đỉnh thật sự luôn đấy.\NTối hôm qua tôi vừa mới xem phim của anh xong.
Dialogue: 0,0:03:19.70,0:03:22.79,Default,,0,0,0,,Tôi đã nói là cậu nhầm người rồi...
Dialogue: 0,0:03:28.37,0:03:29.55,Default,,0,0,0,,Đúng chuẩn là anh ấy trăm phần trăm rồi!
Dialogue: 0,0:03:29.54,0:03:32.06,Default,,0,0,0,,Người đàn ông này chính là thánh Erect Ohki hàng thật giá thật!\NMọi người nhìn xem này!
Dialogue: 0,0:03:32.07,0:03:34.61,Default,,0,0,0,,~ Erect Ohki đại chiến 100 Nữ nhân viên văn phòng ~
Dialogue: 0,0:03:37.14,0:03:39.41,Default,,0,0,0,,Sao lúc nào cậu cũng kè kè\Ncái băng hình đó trong cặp thế hả?
Dialogue: 0,0:03:39.42,0:03:42.22,Default,,0,0,0,,Bởi vì đối với tôi, cuốn băng này\Nchẳng khác nào Kinh Thánh cả.
Dialogue: 0,0:03:51.89,0:03:54.79,Default,,0,0,0,,{\i1}Hóa ra vị khách có nghệ danh 'Erect Ohki' này...{\i0}
Dialogue: 0,0:03:54.89,0:03:57.76,Default,,0,0,0,,{\i1}lại là một nam diễn viên phim người lớn\Ncó sức hút huyền thoại trong giới,{\i0}
Dialogue: 0,0:03:58.19,0:04:04.77,Default,,0,0,0,,{\i1}người từng đóng chính trong khoảng 400 bộ phim người lớn\Nmỗi năm vào thời kỳ đỉnh cao phong độ.{\i0}
Dialogue: 0,0:04:11.30,0:04:12.85,Default,,0,0,0,,Anh Ohki ơi!
Dialogue: 0,0:04:12.95,0:04:15.34,Default,,0,0,0,,Xin hãy nhận em làm đệ tử của anh!
Dialogue: 0,0:04:17.57,0:04:19.74,Default,,0,0,0,,Trăm sự nhờ cậy vào anh đấy, anh Ohki!
Dialogue: 0,0:04:20.97,0:04:22.71,Default,,0,0,0,,Thôi dẹp cái ý định đó đi.
Dialogue: 0,0:04:22.82,0:04:26.56,Default,,0,0,0,,Em muốn chứng tỏ bản thân để trả đũa tất cả những kẻ\Nđã từng coi thường em như một thằng thất bại.
Dialogue: 0,0:04:27.71,0:04:29.34,Default,,0,0,0,,Xin anh hãy thu nhận em!
Dialogue: 0,0:04:31.50,0:04:33.71,Default,,0,0,0,,Em van nài anh đấy, anh Ohki ơi!!
Dialogue: 0,0:04:44.81,0:04:46.80,Default,,0,0,0,,Thế cậu tên là gì...
Dialogue: 0,0:04:48.60,0:04:49.60,Default,,0,0,0,,Dạ Tanaka ạ.
Dialogue: 0,0:04:49.69,0:04:51.22,Default,,0,0,0,,Em tên là Tanaka Yuichi, thưa sư phụ.
Dialogue: 0,0:04:52.55,0:04:54.59,Default,,0,0,0,,Cậu có thể bắt đầu đi làm ngay được không?
Dialogue: 0,0:04:55.23,0:04:56.73,Default,,0,0,0,,Dạ được ạ!
Dialogue: 0,0:05:01.92,0:05:04.32,Default,,0,0,0,,Em đội ơn sư phụ!!
Dialogue: 0,0:05:05.01,0:05:06.88,Default,,0,0,0,,Em biết ơn sư phụ nhiều lắm...
Dialogue: 0,0:05:10.94,0:05:17.45,Default,,0,0,0,,Xem ra sự nhiệt huyết tuổi trẻ của cậu chàng\Nđã làm lay động được lòng Erect Ohki.
Dialogue: 0,0:05:26.02,0:05:31.04,Default,,0,0,0,,Và kể từ sau đêm hôm đó,\Nhai thầy trò họ thường xuyên sánh bước ghé quán cùng nhau.
Dialogue: 0,0:05:32.59,0:05:36.21,Default,,0,0,0,,- Cho một salad khoai tây.\N- Một phần súp Tonjiru truyền thống kèm bát cơm đầy nhé.
Dialogue: 0,0:05:36.35,0:05:42.14,Default,,0,0,0,,Có vẻ như cậu Tanaka đang làm rất tốt\Nbổn phận của một người đệ tử đầy nhiệt huyết.
Dialogue: 0,0:05:44.19,0:05:47.71,Default,,0,0,0,,Cứ tưởng cậu ta sẽ sớm nản chí\Nrồi bỏ cuộc chỉ sau vài ngày,
Dialogue: 0,0:05:47.82,0:05:51.13,Default,,0,0,0,,nhưng hóa ra cậu chàng lại kiên trì bền bỉ phết,\Ntrái ngược hẳn với vẻ bề ngoài.
Dialogue: 0,0:05:51.29,0:05:52.68,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:05:52.78,0:05:54.86,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:05:55.30,0:05:58.00,Default,,0,0,0,,Và sự nhiệt huyết đó cũng thể hiện rõ\Nngay trong cả tướng ăn của cậu ta.
Dialogue: 0,0:05:58.79,0:06:00.79,Default,,0,0,0,,À... Sư phụ Ohki này.
Dialogue: 0,0:06:01.69,0:06:03.45,Default,,0,0,0,,Khi lần đầu tiên hợp tác quay chung\Nvới một nữ diễn viên mới,
Dialogue: 0,0:06:03.56,0:06:06.18,Default,,0,0,0,,thường thì sư phụ sẽ bắt chuyện làm quen với cô ấy thế nào ạ?
Dialogue: 0,0:06:06.38,0:06:08.62,Default,,0,0,0,,Hỏi nhiều quá... Lo mà ăn đi.
Dialogue: 0,0:06:08.72,0:06:10.70,Default,,0,0,0,,Cho em hỏi nốt câu này thôi rồi em ăn liền ạ.
Dialogue: 0,0:06:10.81,0:06:12.45,Default,,0,0,0,,Tôi bảo là lo ăn trước đi.
Dialogue: 0,0:06:12.67,0:06:14.31,Default,,0,0,0,,Nhưng em chỉ thắc mắc một chút...
Dialogue: 0,0:06:14.42,0:06:16.37,Default,,0,0,0,,Đây là mệnh lệnh của sư phụ đấy!
Dialogue: 0,0:06:16.48,0:06:18.11,Default,,0,0,0,,Em xin lỗi sư phụ ạ.
Dialogue: 0,0:06:18.98,0:06:20.54,Default,,0,0,0,,Em xin phép dùng bữa ạ!
Dialogue: 0,0:06:20.88,0:06:21.97,Default,,0,0,0,,Nóng...
Dialogue: 0,0:06:22.05,0:06:23.86,Default,,0,0,0,,Ái chà... Bỏng lưỡi mất!
Dialogue: 0,0:06:24.36,0:06:26.31,Default,,0,0,0,,Tôi xin lỗi nhé.\NCậu có bị sao không?
Dialogue: 0,0:06:27.04,0:06:29.41,Default,,0,0,0,,Tuy thỉnh thoảng cậu học trò có hơi hỏi nhiều làm phiền,
Dialogue: 0,0:06:29.44,0:06:33.10,Default,,0,0,0,,nhưng trông anh Ohki có vẻ chẳng hề\Nkhó chịu chút nào khi có thêm cậu đệ tử mới này.
Dialogue: 0,0:06:41.14,0:06:42.71,Default,,0,0,0,,Xin phép làm phiền ạ.
Dialogue: 0,0:06:43.08,0:06:45.65,Default,,0,0,0,,Đoàn quay chuẩn bị bấm máy xong xuôi cả rồi.\NMời anh Erect vào set quay ạ.
Dialogue: 0,0:06:45.91,0:06:47.33,Default,,0,0,0,,Ừ, tôi ra ngay.
Dialogue: 0,0:06:51.89,0:06:53.63,Default,,0,0,0,,Thầy trò mình vào việc thôi nhỉ?
Dialogue: 0,0:06:53.74,0:06:55.35,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:06:56.66,0:07:01.42,Default,,0,0,0,,- Nào... Thế này thấy sao hả...\N- Sung sướng quá anh ơi...
Dialogue: 0,0:07:08.51,0:07:10.11,Default,,0,0,0,,Cứng quá đi mất...
Dialogue: 0,0:07:10.21,0:07:11.70,Default,,0,0,0,,Thế kiểu này thì sao...
Dialogue: 0,0:07:12.00,0:07:13.97,Default,,0,0,0,,Còn thế này thì sao hả?!
Dialogue: 0,0:07:15.40,0:07:20.25,Default,,0,0,0,,Á... Đừng mà...\NEm ra mất...
Dialogue: 0,0:07:23.96,0:07:27.83,Default,,0,0,0,,Thấm thoắt thế mà cũng đã\Nhai tháng trôi qua rồi nhỉ?
Dialogue: 0,0:07:30.41,0:07:31.64,Default,,0,0,0,,Chào buổi tối Ông chủ.
Dialogue: 0,0:07:31.75,0:07:33.22,Default,,0,0,0,,- Mời hai người vào.\N- Chào Ông chủ ạ.
Dialogue: 0,0:07:33.32,0:07:36.90,Default,,0,0,0,,Ông chủ làm cho cậu ấy món gì\Ngiúp bồi bổ sung sức thật tốt nhé?
Dialogue: 0,0:07:37.24,0:07:40.47,Default,,0,0,0,,Nhờ có sự dìu dắt của sư phụ và Ông chủ cổ vũ,\Nngày mai em sẽ chính thức bấm máy vai diễn đầu đời rồi ạ.
Dialogue: 0,0:07:40.56,0:07:44.02,Default,,0,0,0,,Ồ...\NXin chúc mừng cậu nhé.
Dialogue: 0,0:07:44.18,0:07:46.45,Default,,0,0,0,,- Cố gắng trổ hết tài năng nhé.\N- Em cảm ơn Ông chủ nhiều lắm.
Dialogue: 0,0:07:46.60,0:07:48.51,Default,,0,0,0,,Em sẽ dốc toàn bộ sức lực của mình ạ.
Dialogue: 0,0:07:58.86,0:08:00.00,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:08:00.09,0:08:02.31,Default,,0,0,0,,Nóng hổi vừa thổi vừa ăn nhé.
Dialogue: 0,0:08:02.40,0:08:03.89,Default,,0,0,0,,Suất ăn đặc biệt đại bổ tăng lực của cậu đây.
Dialogue: 0,0:08:03.99,0:08:06.30,Default,,0,0,0,,- Em cảm ơn Ông chủ.\N- Và còn món này nữa...
Dialogue: 0,0:08:06.54,0:08:10.55,Default,,0,0,0,,Hai đĩa này là gửi cho anh Ohki.
Dialogue: 0,0:08:11.86,0:08:15.33,Default,,0,0,0,,Đĩa thứ hai là do mấy vị khách đằng kia mời anh đấy.
Dialogue: 0,0:08:17.53,0:08:20.05,Default,,0,0,0,,Hôm qua tụi em vừa mới rủ nhau\Ncùng xem tác phẩm mới nhất của anh xong.
Dialogue: 0,0:08:20.13,0:08:22.70,Default,,0,0,0,,Bộ 'Đại Tiệc Tuôn Trào\Ncủa Erect Ohki' ấy ạ.
Dialogue: 0,0:08:22.80,0:08:24.68,Default,,0,0,0,,Xem mà nóng bỏng cả mắt luôn.
Dialogue: 0,0:08:24.83,0:08:26.23,Default,,0,0,0,,Ồ... Cảm ơn các cô nhé.
Dialogue: 0,0:08:26.34,0:08:30.55,Default,,0,0,0,,Chỉ là chút quà nhỏ tỏ lòng hâm mộ thôi ạ,\Nvì tụi em nghe nói anh rất thích ăn món salad khoai tây.
Dialogue: 0,0:08:30.63,0:08:32.01,Default,,0,0,0,,Vâng...
Dialogue: 0,0:08:32.47,0:08:37.35,Default,,0,0,0,,Hương vị món salad khoai tây ở quán này\Nluôn gợi lại trong tôi những ký ức êm đềm thuở xưa.
Dialogue: 0,0:08:39.48,0:08:42.46,Default,,0,0,0,,- Kìa! Anh ấy đang ăn món tụi mình mời kìa!\N- Xúc động muốn khóc luôn ấy...
Dialogue: 0,0:08:42.58,0:08:45.16,Default,,0,0,0,,Ồ... Cảm ơn mọi người nhé.
Dialogue: 0,0:08:47.33,0:08:48.80,Default,,0,0,0,,Xin phép mọi người một lát.
Dialogue: 0,0:08:51.56,0:08:53.29,Default,,0,0,0,,Alo?
Dialogue: 0,0:08:53.38,0:08:55.05,Default,,0,0,0,,Ồ... Có chuyện gì thế?
Dialogue: 0,0:08:57.11,0:09:00.21,Default,,0,0,0,,Hả? Bị đột quỵ á?!
Dialogue: 0,0:09:01.25,0:09:02.64,Default,,0,0,0,,Xin phép một chút.
Dialogue: 0,0:09:06.72,0:09:08.58,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:09:08.99,0:09:11.92,Default,,0,0,0,,À... Nhưng tình hình cụ\Nkhông có gì nguy kịch lắm, đúng không?
Dialogue: 0,0:09:12.01,0:09:14.31,Default,,0,0,0,,Dạo này công việc của tôi bận tối mắt tối mũi, không về quê ngay được đâu.
Dialogue: 0,0:09:14.82,0:09:16.54,Default,,0,0,0,,Ừ...
Dialogue: 0,0:09:16.64,0:09:18.67,Default,,0,0,0,,Thôi cứ vậy đi nhé,\Ntôi cúp máy đây.
Dialogue: 0,0:09:20.65,0:09:22.40,Default,,0,0,0,,Xin lỗi đã làm gián đoạn bữa ăn.
Dialogue: 0,0:09:22.90,0:09:24.34,Default,,0,0,0,,Có chuyện gì thế ạ?
Dialogue: 0,0:09:24.43,0:09:26.41,Default,,0,0,0,,À... Chẳng có gì hệ trọng đâu.
Dialogue: 0,0:09:26.52,0:09:28.83,Default,,0,0,0,,Nghe giọng sư phụ căng thẳng thế kia mà bảo không có gì sao được ạ?!
Dialogue: 0,0:09:31.43,0:09:33.90,Default,,0,0,0,,Nghe bảo mẹ của em ở dưới quê\Nvừa mới bị ngất xỉu.
Dialogue: 0,0:09:34.01,0:09:36.97,Default,,0,0,0,,Nhưng không sao đâu.\NChỉ là một cơn tai biến nhẹ thôi mà.
Dialogue: 0,0:09:37.70,0:09:39.34,Default,,0,0,0,,Cậu mau thu xếp về quê chăm bà cụ ngay đi.
Dialogue: 0,0:09:39.60,0:09:41.88,Default,,0,0,0,,Không sao thật mà sư phụ.\NSáng mai em còn có lịch bấm máy đầu tay nữa.
Dialogue: 0,0:09:41.98,0:09:43.93,Default,,0,0,0,,- Em xin phép ăn tiếp ạ.\N- Thằng ngu này!
Dialogue: 0,0:09:44.68,0:09:48.36,Default,,0,0,0,,Bộ mấy cái cảnh quay phim người lớn vớ vẩn đó\Nquan trọng hơn cả mẹ ruột của mày hả?
Dialogue: 0,0:09:51.66,0:09:55.70,Default,,0,0,0,,Nếu bây giờ mày bắt xe về ngay,\Nthì vẫn còn kịp nhìn mặt bà cụ đấy.
Dialogue: 0,0:09:55.81,0:09:58.82,Default,,0,0,0,,Hãy về bên mẹ khi cậu vẫn còn cơ hội.
Dialogue: 0,0:10:02.41,0:10:04.64,Default,,0,0,0,,Cút ngay khỏi đây cho khuất mắt tôi.
Dialogue: 0,0:10:05.13,0:10:10.40,Default,,0,0,0,,Tôi không muốn nhìn thấy bản mặt của anh\Nở đám cưới của con bé Yayoi đâu!
Dialogue: 0,0:10:11.11,0:10:14.88,Default,,0,0,0,,Tại sao anh lại cứ phải làm cái nghề nhục nhã đó\Nđể bắt cả gia đình phải muối mặt vì anh thế hả?
Dialogue: 0,0:10:20.21,0:10:21.86,Default,,0,0,0,,Anh hai ơi!
Dialogue: 0,0:10:26.50,0:10:28.84,Default,,0,0,0,,Anh xin lỗi em.
Dialogue: 0,0:10:29.76,0:10:31.10,Default,,0,0,0,,Em đừng bận tâm chuyện đó làm gì.
Dialogue: 0,0:10:31.21,0:10:32.32,Default,,0,0,0,,Dù sao đi nữa...
Dialogue: 0,0:10:34.10,0:10:36.18,Default,,0,0,0,,anh thật lòng chúc em được hạnh phúc.
Dialogue: 0,0:10:45.47,0:10:51.10,Default,,0,0,0,,Cả mẹ tôi, các anh trai tôi,\Nvà ngay cả người cha quá cố của tôi...
Dialogue: 0,0:10:51.24,0:10:53.73,Default,,0,0,0,,tất cả đều là nhà giáo cả.
Dialogue: 0,0:10:55.32,0:10:59.60,Default,,0,0,0,,Chưa kể đến chồng của em gái tôi,\Ncùng với bố mẹ chồng của con bé.
Dialogue: 0,0:10:59.69,0:11:01.91,Default,,0,0,0,,Tất thảy cũng đều làm nghề gõ đầu trẻ.
Dialogue: 0,0:11:02.41,0:11:07.40,Default,,0,0,0,,Sẽ thật khó xử cho mọi người biết bao,\Nnếu một kẻ như tôi lại vác mặt đến dự lễ cưới.
Dialogue: 0,0:11:09.51,0:11:12.12,Default,,0,0,0,,Kể từ sau ngày hôm đó\Nsuốt hai mươi năm ròng rã trôi qua,
Dialogue: 0,0:11:12.21,0:11:15.78,Default,,0,0,0,,tôi chưa một lần nào đặt chân trở về quê hương.
Dialogue: 0,0:11:18.94,0:11:19.94,Default,,0,0,0,,Cậu phải lên đường ngay bây giờ đi.
Dialogue: 0,0:11:20.05,0:11:23.12,Default,,0,0,0,,Ra ga bắt chuyến tàu sớm nhất vào sáng mai.
Dialogue: 0,0:11:23.23,0:11:25.38,Default,,0,0,0,,- Nhưng còn lịch quay...\N- Tôi đã bảo mọi chuyện ở đây cứ để tôi lo.
Dialogue: 0,0:11:25.55,0:11:27.70,Default,,0,0,0,,Nghe lời sư phụ của cậu đi.
Dialogue: 0,0:11:27.80,0:11:29.80,Default,,0,0,0,,Cậu bắt buộc phải về thăm mẹ.
Dialogue: 0,0:11:34.67,0:11:36.34,Default,,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:12:01.56,0:12:03.57,Default,,0,0,0,,Alo?
Dialogue: 0,0:12:08.29,0:12:09.94,Default,,0,0,0,,- Cảm ơn quý khách.\N- Lần sau lại ghé nhé.
Dialogue: 0,0:12:12.40,0:12:13.96,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:12:19.34,0:12:22.80,Default,,0,0,0,,Nhờ nghe theo lời khuyên của Ông chủ và sư phụ\Nmà mẹ của em ở quê mừng rỡ hạnh phúc lắm ạ.
Dialogue: 0,0:12:23.63,0:12:25.48,Default,,0,0,0,,Thật thế à?
Dialogue: 0,0:12:25.58,0:12:27.56,Default,,0,0,0,,Thế sức khỏe của bà cụ đã đỡ nhiều chưa?
Dialogue: 0,0:12:27.64,0:12:28.47,Default,,0,0,0,,Dạ rồi ạ.
Dialogue: 0,0:12:28.56,0:12:30.04,Default,,0,0,0,,Bệnh viện vẫn giữ mẹ em lại\Nđể theo dõi thêm một thời gian,
Dialogue: 0,0:12:30.15,0:12:32.01,Default,,0,0,0,,nhưng bác sĩ bảo may mắn là không có biến chứng gì nghiêm trọng.
Dialogue: 0,0:12:32.09,0:12:33.86,Default,,0,0,0,,Nghe vậy là mừng rồi.
Dialogue: 0,0:12:34.36,0:12:37.74,Default,,0,0,0,,Nhưng mà... Sư phụ Ohki đâu rồi Ông chủ?
Dialogue: 0,0:12:37.95,0:12:42.43,Default,,0,0,0,,Hôm trước hai thầy trò em vô tình đi ngược đường nhau,\Nvì sư phụ cũng vừa mới bắt tàu trở về quê nhà rồi ạ.
Dialogue: 0,0:12:42.52,0:12:44.33,Default,,0,0,0,,Về quê nhà ư?!
Dialogue: 0,0:12:44.45,0:12:47.65,Default,,0,0,0,,Chẳng phải anh ấy từng nói là\Nđã hai mươi năm rồi chưa từng về quê sao?
Dialogue: 0,0:12:47.75,0:12:50.03,Default,,0,0,0,,Sao tự dưng lại đột ngột thế nhỉ...
Dialogue: 0,0:12:50.32,0:12:54.89,Default,,0,0,0,,Chỉ còn hai ngày nữa là tới lịch quay tiếp theo rồi,\Nmà em gọi điện mãi không tài nào liên lạc được với sư phụ.
Dialogue: 0,0:13:28.51,0:13:31.23,Default,,0,0,0,,Số máy quý khách vừa gọi hiện không liên lạc được...
Dialogue: 0,0:13:36.86,0:13:38.44,Default,,0,0,0,,Tanaka-kun.
Dialogue: 0,0:13:38.70,0:13:39.67,Default,,0,0,0,,Cậu chuẩn bị sẵn sàng chưa?
Dialogue: 0,0:13:39.78,0:13:41.74,Default,,0,0,0,,Đội quay chuẩn bị xong hết cả rồi đấy.
Dialogue: 0,0:13:45.64,0:13:46.84,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:13:47.70,0:13:50.99,Default,,0,0,0,,Nào... Thế này thấy sao hả?\NEm có thích không?
Dialogue: 0,0:13:51.34,0:13:53.76,Default,,0,0,0,,- Em có cảm nhận được nó không?\N- Á đau quá! Á... Dừng lại đi!
Dialogue: 0,0:13:53.88,0:13:55.87,Default,,0,0,0,,- Thành thật xin lỗi...\N- Cắt!
Dialogue: 0,0:13:56.01,0:13:57.56,Default,,0,0,0,,Tanaka, cậu đang làm\Ncái trò khỉ gió gì thế hả?
Dialogue: 0,0:13:57.65,0:13:58.91,Default,,0,0,0,,- Em xin lỗi đạo diễn!\N- Đầu óc cậu có bị làm sao không đấy?
Dialogue: 0,0:13:59.00,0:14:00.47,Default,,0,0,0,,Đồ nghiệp dư vô tích sự,\Ncút xéo ngay khỏi trường quay cho tôi!
Dialogue: 0,0:14:00.58,0:14:01.95,Default,,0,0,0,,Em xin lỗi mọi người!!
Dialogue: 0,0:15:04.90,0:15:07.97,Default,,0,0,0,,Chúc mừng cậu đã hoàn thành vai diễn đầu tay nhé!
Dialogue: 0,0:15:09.72,0:15:11.11,Default,,0,0,0,,Em cảm ơn mọi người ạ.
Dialogue: 0,0:15:11.29,0:15:13.30,Default,,0,0,0,,Bao giờ băng hình phát hành,\Ntôi nhất định sẽ là người đầu tiên mua ủng hộ!
Dialogue: 0,0:15:13.49,0:15:15.09,Default,,0,0,0,,Bác đây sẽ mua hẳn hai cuốn luôn.
Dialogue: 0,0:15:15.23,0:15:16.31,Default,,0,0,0,,Em cảm ơn các bác ạ.
Dialogue: 0,0:15:16.42,0:15:17.61,Default,,0,0,0,,Thế buổi quay thực tế diễn ra thế nào?
Dialogue: 0,0:15:17.70,0:15:20.51,Default,,0,0,0,,À... Dạ, lúc đó em bị cuốn vào\Nkhông khí hưng phấn của cảnh quay quá,
Dialogue: 0,0:15:20.60,0:15:22.55,Default,,0,0,0,,nên thú thật là chính em cũng chẳng nhớ rõ\Nmình đã diễn những gì nữa ạ.
Dialogue: 0,0:15:22.64,0:15:24.53,Default,,0,0,0,,Vậy cơ à?
Dialogue: 0,0:15:24.62,0:15:27.20,Default,,0,0,0,,Nhưng giá như có sư phụ Ohki ở đó\Nđể tận mắt chứng kiến màn ra mắt của em thì tốt biết mấy.
Dialogue: 0,0:15:27.29,0:15:29.27,Default,,0,0,0,,Cậu vẫn chưa liên lạc được với anh ấy à?
Dialogue: 0,0:15:29.54,0:15:32.35,Default,,0,0,0,,Em gọi cháy máy mà vẫn bặt vô âm tín.
Dialogue: 0,0:15:37.10,0:15:39.41,Default,,0,0,0,,- Mời vào!\N- Ông chủ ơi!
Dialogue: 0,0:15:49.05,0:15:50.94,Default,,0,0,0,,Mẹ của tôi...
Dialogue: 0,0:15:51.05,0:15:53.56,Default,,0,0,0,,bà cụ mắc chứng lẫn tuổi già (dementia) mất rồi.
Dialogue: 0,0:15:54.84,0:15:57.29,Default,,0,0,0,,Em gái tôi đã gọi điện báo tin,
Dialogue: 0,0:15:57.40,0:16:00.25,Default,,0,0,0,,nên mấy ngày vừa rồi tôi đã về quê\Nđể ở bên cạnh chăm sóc bà cụ.
Dialogue: 0,0:16:49.90,0:16:52.35,Default,,0,0,0,,Này anh thanh niên...
Dialogue: 0,0:16:54.84,0:16:57.42,Default,,0,0,0,,Cho tôi hỏi khí không phải,\Nanh từ đâu ghé đến vùng này thế?
Dialogue: 0,0:17:00.69,0:17:03.22,Default,,0,0,0,,Tôi từ... trên Tokyo về đây ạ.
Dialogue: 0,0:17:03.32,0:17:05.69,Default,,0,0,0,,Ồ... Từ tận Tokyo cơ à?
Dialogue: 0,0:17:05.78,0:17:09.65,Default,,0,0,0,,Chắc hẳn là anh đã phải trải qua\Nmột chặng đường dài vất vả lắm nhỉ.
Dialogue: 0,0:17:09.79,0:17:12.64,Default,,0,0,0,,Lặn lội đường xá xa xôi về tận chốn này.
Dialogue: 0,0:17:13.11,0:17:15.47,Default,,0,0,0,,Dạ vâng, cũng khá xa ạ.
Dialogue: 0,0:17:16.35,0:17:20.50,Default,,0,0,0,,Anh về đây là vì công việc\Nhay là đi du lịch ngắm cảnh thế?
Dialogue: 0,0:17:24.85,0:17:27.48,Default,,0,0,0,,Tôi về đây là để thăm...
Dialogue: 0,0:17:28.83,0:17:30.56,Default,,0,0,0,,người mẹ của mình ạ.
Dialogue: 0,0:17:30.72,0:17:33.68,Default,,0,0,0,,À... Ra là vậy sao?
Dialogue: 0,0:17:34.83,0:17:39.49,Default,,0,0,0,,Anh biết không, tôi cũng có một\Nthằng con trai út hiện đang sống ở trên Tokyo đấy.
Dialogue: 0,0:17:43.61,0:17:50.22,Default,,0,0,0,,Nhưng đã lâu lắm rồi\Nchẳng thấy nó về thăm cái thân già này.
Dialogue: 0,0:17:52.64,0:17:57.91,Default,,0,0,0,,Chẳng biết có phải vì công việc trên đó\Nbận rộn quá làm nó chẳng dứt ra được hay không...
Dialogue: 0,0:18:01.17,0:18:03.80,Default,,0,0,0,,Mẹ ơi...
Dialogue: 0,0:18:05.21,0:18:08.30,Default,,0,0,0,,Không biết là...
Dialogue: 0,0:18:08.31,0:18:12.25,Default,,0,0,0,,năm nay thằng bé có thu xếp về thăm tôi được hay không nữa.
Dialogue: 0,0:18:14.23,0:18:16.54,Default,,0,0,0,,Mẹ ơi!
Dialogue: 0,0:18:16.85,0:18:18.53,Default,,0,0,0,,Mẹ à!!
Dialogue: 0,0:18:18.63,0:18:19.85,Default,,0,0,0,,Là con đây mà...
Dialogue: 0,0:18:19.94,0:18:21.18,Default,,0,0,0,,Con bảo chính là con đây mà!!
Dialogue: 0,0:18:21.27,0:18:22.91,Default,,0,0,0,,Mẹ à.
Dialogue: 0,0:18:23.02,0:18:26.00,Default,,0,0,0,,Con trai của mẹ đây mà, mẹ ơi...
Dialogue: 0,0:18:37.62,0:18:40.52,Default,,0,0,0,,Cái thằng nhóc đó ấy à...
Dialogue: 0,0:18:40.63,0:18:45.20,Default,,0,0,0,,từ bé nó đã mê ăn món salad khoai tây lắm.
Dialogue: 0,0:18:47.08,0:18:49.49,Default,,0,0,0,,Mẹ ơi...
Dialogue: 0,0:18:59.05,0:19:02.28,Default,,0,0,0,,Thế rồi, dưới sự phụ giúp của cô em gái tôi,
Dialogue: 0,0:19:02.42,0:19:08.08,Default,,0,0,0,,hai mẹ con họ đã cùng nhau vào bếp\Nlàm món salad khoai tây cho tôi ăn.
Dialogue: 0,0:19:32.68,0:19:34.56,Default,,0,0,0,,Sao hả...
Dialogue: 0,0:19:34.69,0:19:36.69,Default,,0,0,0,,Anh ăn thấy vị thế nào?
Dialogue: 0,0:19:37.08,0:19:40.43,Default,,0,0,0,,Cái thằng nhóc nghịch ngợm nhà tôi mê món này đến nỗi,
Dialogue: 0,0:19:40.59,0:19:44.40,Default,,0,0,0,,lần nào ăn nó cũng đòi xới thêm đĩa nữa mãi không thôi.
Dialogue: 0,0:19:46.89,0:19:49.89,Default,,0,0,0,,Thằng bé sống tình cảm...
Dialogue: 0,0:19:51.38,0:19:55.97,Default,,0,0,0,,và hiếu thảo lắm, đúng là một đứa con ngoan.
Dialogue: 0,0:20:01.65,0:20:04.69,Default,,0,0,0,,Nhưng mà đĩa salad hôm ấy...
Dialogue: 0,0:20:04.91,0:20:07.44,Default,,0,0,0,,lại mặn lắm.
Dialogue: 0,0:20:07.53,0:20:09.85,Default,,0,0,0,,Mặn chát cả đầu lưỡi.
Dialogue: 0,0:20:13.42,0:20:15.75,Default,,0,0,0,,Sư phụ...
Dialogue: 0,0:20:19.06,0:20:21.90,Default,,0,0,0,,Xin sư phụ...
Dialogue: 0,0:20:22.04,0:20:24.50,Default,,0,0,0,,hãy tha lỗi cho sự dối trá của em.
Dialogue: 0,0:20:30.37,0:20:33.71,Default,,0,0,0,,Cũng nhờ có sư phụ...
Dialogue: 0,0:20:34.03,0:20:38.26,Default,,0,0,0,,Nhờ những lời răn dạy hôm ấy của sư phụ...
Dialogue: 0,0:20:39.43,0:20:44.53,Default,,0,0,0,,mà em đã kịp trở về gặp mặt mẹ em.
Dialogue: 0,0:20:48.18,0:20:50.22,Default,,0,0,0,,Em thành thật xin lỗi sư phụ!
Dialogue: 0,0:20:50.68,0:20:53.89,Default,,0,0,0,,Em xin lỗi sư phụ...
Dialogue: 0,0:20:57.09,0:20:59.59,Default,,0,0,0,,Cậu đang nói cái gì thế hả?
Dialogue: 0,0:20:59.82,0:21:02.32,Default,,0,0,0,,Em có lỗi với sư phụ...
Dialogue: 0,0:21:02.45,0:21:04.84,Default,,0,0,0,,Thôi đừng nói lời xin lỗi nữa!
Dialogue: 0,0:21:05.26,0:21:07.59,Default,,0,0,0,,Chẳng phải mọi chuyện như thế là tốt đẹp lắm rồi sao?
Dialogue: 0,0:21:11.48,0:21:14.54,Default,,0,0,0,,Sau này nhớ năng về quê thăm bà cụ thường xuyên vào nhé.
Dialogue: 0,0:21:17.01,0:21:19.16,Default,,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:21:27.46,0:21:29.04,Default,,0,0,0,,Của hai người đây.
Dialogue: 0,0:21:30.01,0:21:32.61,Default,,0,0,0,,Đĩa này tôi mời hai thầy trò nhé.
Dialogue: 0,0:21:35.40,0:21:37.37,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:22:04.95,0:22:06.69,Default,,0,0,0,,Ngon quá...
Dialogue: 0,0:22:12.06,0:22:14.52,Default,,0,0,0,,Ăn vào một miếng là thấy nhớ quê nhà da diết.
Dialogue: 0,0:22:19.77,0:22:21.82,Default,,0,0,0,,Chẳng lẽ mình cũng đã già thật rồi sao?!
Dialogue: 0,0:22:21.91,0:22:23.20,Default,,0,0,0,,Dạo gần đây không hiểu sao...
Dialogue: 0,0:22:23.30,0:22:26.37,Default,,0,0,0,,hễ cứ đụng chuyện gì nhỏ nhặt là nước mắt tôi lại trực trào ra.
Dialogue: 0,0:22:30.86,0:22:35.17,Default,,0,0,0,,~ Còn tiếp ~
Dialogue: 0,0:22:35.62,0:22:40.60,Default,,0,0,0,,Và sau đây là mẹo nhỏ của quán\Nđể làm món salad khoai tây thật ngon.
Dialogue: 0,0:22:40.93,0:22:45.09,Default,,0,0,0,,{\i1}Hãy để nguyên cả vỏ khoai tây khi luộc,{\i0}
Dialogue: 0,0:22:45.21,0:22:47.15,Default,,0,0,0,,{\i1}như vậy sẽ giữ trọn được hương vị thơm bùi tự nhiên của khoai.{\i0}
Dialogue: 0,0:22:47.80,0:22:51.09,Default,,0,0,0,,Nếu bạn trộn hành tây thái mỏng vào\Nngay khi khoai tây nghiền vẫn còn đang nóng,
Dialogue: 0,0:22:51.35,0:22:54.24,Default,,0,0,0,,hành tây sẽ chín tái đi, trở nên mềm dịu và hết hăng.
Dialogue: 0,0:22:59.67,0:23:03.94,Default,,0,0,0,,{\i1}Hãy đợi cho khoai tây nguội hẳn\Nrồi mới cho sốt mayonnaise vào trộn đều nhé.{\i0}
Dialogue: 0,0:23:06.88,0:23:09.71,Default,,0,0,0,,{\i1}Đó chính là bí quyết để làm nên\Nmột đĩa salad khoai tây chuẩn vị đấy.{\i0}
Dialogue: 0,0:23:10.06,0:23:11.44,Default,,0,0,0,,Và thành phẩm của chúng ta đã hoàn tất rồi đây...
Dialogue: 0,0:23:12.06,0:23:13.39,Default,,0,0,0,,Chúc mọi người ngủ ngon nhé.
Dialogue: 0,0:23:13.39,0:23:15.39,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:23:13.39,0:23:15.39,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:23:16.42,0:23:20.80,Default,,0,0,0,,~ KOBAYASHI Kaoru ~\NÔng chủ
Dialogue: 0,0:23:21.02,0:23:24.81,Default,,0,0,0,,~ KAZAMA Toru ~\NErect Ohki
Dialogue: 0,0:23:25.28,0:23:27.23,Default,,0,0,0,,~ TANAKA Sogen ~\NTanaka-kun
Dialogue: 0,0:23:27.46,0:23:29.54,Default,,0,0,0,,~ SASAKI Sumie ~\NMẹ của Erect Ohki
Dialogue: 0,0:23:30.69,0:23:49.91,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NBiên tập & Căn chỉnh: Amtia(NOFACE)
Dialogue: 0,0:24:26.43,0:24:33.76,Default,,0,0,0,,~ Trong tập tiếp theo của ~\NQUÁN ĂN ĐÊM (SHINYA SHOKUDO)
Dialogue: 0,0:24:35.10,0:24:36.51,Default,,0,0,0,,Không gian quán này cũng không tệ chút nào.
Dialogue: 0,0:24:36.61,0:24:37.90,Default,,0,0,0,,Mà này, cô có thích ăn trứng cá muối caviar không?
Dialogue: 0,0:24:38.01,0:24:40.55,Default,,0,0,0,,Nhìn lão ta kìa,\Nlàm mất hết cả vị ngon bát cơm chan trà của tôi.
Dialogue: 0,0:24:40.64,0:24:42.31,Default,,0,0,0,,Tôi lại phải cảm ơn Ông chủ nữa rồi!
Dialogue: 0,0:24:44.29,0:24:46.92,Default,,0,0,0,,Cho tôi gọi một bát cơm trộn bơ luôn nhé.
Dialogue: 0,0:24:47.03,0:24:49.64,Default,,0,0,0,,Hóa ra ở Hakodate thực sự có một người\Nnhư trong bài hát của bác ấy.
Dialogue: 0,0:24:49.75,0:24:52.05,Default,,0,0,0,,~ Giữa ngôi sao phim người lớn và củ khoai tây\Ncó nhiều điểm chung hơn bạn tưởng đấy. ~
Dialogue: 0,0:24:52.22,0:24:54.76,Default,,0,0,0,,~ Phụ đề Việt ngữ được thực hiện bởi Amtia(NOFACE) ~
Dialogue: 0,0:24:54.90,0:24:58.77,Default,,0,0,0,,~ Bạn sẽ chẳng bao giờ còn nhìn củ khoai tây\Nhay diễn viên phim người lớn bằng ánh mắt cũ nữa đâu ~
Dialogue: 0,0:24:59.31,0:25:05.74,Default,,0,0,0,,Cảm ơn các bạn đã theo dõi bộ phim\NPhụ đề Việt ngữ bởi Amtia(NOFACE)
