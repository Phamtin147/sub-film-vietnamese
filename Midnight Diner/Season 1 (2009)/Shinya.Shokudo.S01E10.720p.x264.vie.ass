Dialogue: 0,0:02:15.57,0:02:21.11,Default,,0,0,0,,Tập cuối\N~ MÌ RAMEN ~
Dialogue: 0,0:02:24.46,0:02:27.35,Default,,0,0,0,,PHỤ ĐỀ VIỆT NGỮ THỰC HIỆN BỞI\NAMTIA(NOFACE) - SHINYA SHOKUDO
Dialogue: 0,0:02:42.23,0:02:46.70,Default,,0,0,0,,Ta thấy anh từng gánh trên vai\Nkhông ít tội nghiệt sát sinh đâu.
Dialogue: 0,0:02:48.28,0:02:49.90,Default,,0,0,0,,Ở kiếp trước của con sao thầy?
Dialogue: 0,0:02:50.02,0:02:53.47,Default,,0,0,0,,Không... Kiếp trước của kiếp trước nữa cơ.
Dialogue: 0,0:02:54.53,0:02:56.86,Default,,0,0,0,,Đó là vào thời điểm nào vậy thầy?
Dialogue: 0,0:02:57.02,0:02:59.69,Default,,0,0,0,,Ta đoán chừng là khoảng\Nmột nghìn năm về trước.
Dialogue: 0,0:02:59.78,0:03:03.70,Default,,0,0,0,,Lúc đó chúng ta đang ở Kumano,\Nthuộc tỉnh Wakayama.
Dialogue: 0,0:03:06.98,0:03:09.74,Default,,0,0,0,,Chỗ Di sản Thế giới ấy hả thầy?
Dialogue: 0,0:03:09.84,0:03:12.25,Default,,0,0,0,,Gieo nhân nào,\Nắt sẽ gặt quả nấy.
Dialogue: 0,0:03:12.37,0:03:15.33,Default,,0,0,0,,Đó là vòng luân hồi bất tận của kiếp nhân sinh.
Dialogue: 0,0:03:18.58,0:03:22.56,Default,,0,0,0,,Vì vậy anh mới dứt áo ra đi\Nđể tìm lại bản ngã của chính mình.
Dialogue: 0,0:03:22.65,0:03:26.16,Default,,0,0,0,,Một hành trình mà anh đã hằng mong mỏi từ lâu.
Dialogue: 0,0:03:33.58,0:03:35.70,Default,,0,0,0,,Con xin gửi thầy tiền quẻ ạ.
Dialogue: 0,0:03:45.81,0:03:48.00,Default,,0,0,0,,Xin mời thầy.
Dialogue: 0,0:03:58.28,0:04:03.23,Default,,0,0,0,,Ngay lúc này đây, anh đang bước chân vào\Nmột vực thẳm tăm tối không đáy.
Dialogue: 0,0:04:04.48,0:04:08.64,Default,,0,0,0,,Chỉ có duy nhất anh mới nắm giữ chiếc chìa khóa\Nđể thoát khỏi định mệnh nghiệt ngã đó.
Dialogue: 0,0:04:14.67,0:04:16.54,Default,,0,0,0,,Này!
Dialogue: 0,0:04:20.71,0:04:25.77,Default,,0,0,0,,Hôm đó là lần đầu tiên\Ntôi thấy Gen-chan ghé quán một mình.
Dialogue: 0,0:04:33.01,0:04:34.55,Default,,0,0,0,,Cho thêm rong biển nhé?
Dialogue: 0,0:04:34.56,0:04:36.51,Default,,0,0,0,,Tiếc quá, tôi vừa hết rong biển mất rồi.
Dialogue: 0,0:04:36.75,0:04:39.68,Default,,0,0,0,,Hết rồi á?!
Dialogue: 0,0:04:39.81,0:04:42.91,Default,,0,0,0,,Hết sạch rồi...
Dialogue: 0,0:04:43.02,0:04:47.17,Default,,0,0,0,,Mì ramen mà không có rong biển,\Nthì còn ra cái thể thống gì nữa chứ?
Dialogue: 0,0:04:50.74,0:04:52.24,Default,,0,0,0,,Ái chà... Chết tiệt thật!
Dialogue: 0,0:04:52.33,0:04:55.53,Default,,0,0,0,,Á... Nóng phỏng lưỡi rồi....
Dialogue: 0,0:04:57.04,0:05:00.07,Default,,0,0,0,,Tôi đã bảo là tôi không ăn nóng được mà lại.
Dialogue: 0,0:05:12.17,0:05:14.27,Default,,0,0,0,,Đây, nước đây.
Dialogue: 0,0:05:15.53,0:05:20.93,Default,,0,0,0,,Lần sau ghé, tôi sẽ chuẩn bị\Nsẵn rong biển cho cậu nhé.
Dialogue: 0,0:05:35.21,0:05:39.69,Default,,0,0,0,,{\i1}Ánh mắt bồn chồn, bất an trên gương mặt cậu ta\Nngay trước khi bước ra khỏi quán...{\i0}
Dialogue: 0,0:05:39.74,0:05:42.84,Default,,0,0,0,,{\i1}khiến lòng tôi không khỏi dấy lên nỗi âu lo.{\i0}
Dialogue: 0,0:05:54.04,0:05:58.93,Default,,0,0,0,,{\i1}Đêm hôm đó, Gen-chan đã đâm trọng thương\Nmột gã thủ lĩnh trẻ của băng Yakuza đối địch,{\i0}
Dialogue: 0,0:05:59.03,0:06:01.42,Default,,0,0,0,,{\i1}rồi mai danh ẩn tích bỏ trốn biệt tăm.{\i0}
Dialogue: 0,0:06:03.67,0:06:05.99,Default,,0,0,0,,{\i1}~ Hai tuần sau ~\NCảm ơn ông nhé.{\i0}
Dialogue: 0,0:06:06.09,0:06:07.75,Default,,0,0,0,,{\i1}Cảm ơn Ông chủ.{\i0}
Dialogue: 0,0:06:09.16,0:06:10.45,Default,,0,0,0,,Tối nay đi có một mình thôi à?
Dialogue: 0,0:06:10.58,0:06:13.78,Default,,0,0,0,,Hai mụ kia cho em leo cây\Nđể đi tiệc làm quen gokon mất rồi.
Dialogue: 0,0:06:13.87,0:06:17.63,Default,,0,0,0,,Chuyện đó thì tính sau, mà này,\Ncái cậu Gen-chan dạo này sao rồi bác?
Dialogue: 0,0:06:17.72,0:06:20.23,Default,,0,0,0,,Bốc hơi không dấu vết rồi.
Dialogue: 0,0:06:20.85,0:06:23.91,Default,,0,0,0,,Quả đúng như tôi nghĩ, cậu ta là một kẻ\Nluôn làm việc đến nơi đến chốn.
Dialogue: 0,0:06:24.01,0:06:27.51,Default,,0,0,0,,Dân Yakuza sống chết\Ncũng vì một lời thề son sắt mà.
Dialogue: 0,0:06:27.70,0:06:31.23,Default,,0,0,0,,Xem chừng cậu ta đã hạ quyết tâm\Nphải trả đũa cho bằng được mối thù lần trước.
Dialogue: 0,0:06:36.85,0:06:37.94,Default,,0,0,0,,Đại ca!
Dialogue: 0,0:06:38.03,0:06:39.87,Default,,0,0,0,,Đại ca!
Dialogue: 0,0:06:40.30,0:06:45.12,Default,,0,0,0,,Chắc giờ này cậu ta đã bị chôn xác\Nở xó xỉnh nào đó quanh Tokyo rồi cũng nên.
Dialogue: 0,0:06:45.66,0:06:48.38,Default,,0,0,0,,Tôi đùa đấy!\NĐùa tí thôi mà...
Dialogue: 0,0:06:48.70,0:06:50.65,Default,,0,0,0,,Sao mặt mày ai nấy đều nghiêm trọng thế?
Dialogue: 0,0:06:52.79,0:06:54.79,Default,,0,0,0,,Tôi chỉ cầu mong cho cậu ấy bình an vô sự thôi...
Dialogue: 0,0:07:08.16,0:07:10.27,Default,,0,0,0,,Anh Kenzaki.
Dialogue: 0,0:07:14.19,0:07:17.20,Default,,0,0,0,,Tôi có chuyện muốn nói riêng với anh.
Dialogue: 0,0:07:43.17,0:07:46.35,Default,,0,0,0,,Có chuyện gì thế, nhóc con?
Dialogue: 0,0:07:49.15,0:07:50.54,Default,,0,0,0,,Cứ vào trong này đi cháu.
Dialogue: 0,0:07:50.63,0:07:51.80,Default,,0,0,0,,Chào mọi người nhé.
Dialogue: 0,0:07:51.87,0:07:53.84,Default,,0,0,0,,Hôm nay chị ghé sớm thế, chị Kosuzu.
Dialogue: 0,0:07:53.93,0:07:56.82,Default,,0,0,0,,Ôi chà... Nhóc con ơi, vào đây với bác nào.
Dialogue: 0,0:07:57.40,0:08:00.82,Default,,0,0,0,,Đáng yêu quá! Chị Kosuzu ơi,\Ncháu trai chị đấy à?
Dialogue: 0,0:08:00.92,0:08:04.62,Default,,0,0,0,,Người như chị làm sao có con được,\Nlấy đâu ra cháu trai cơ chứ?
Dialogue: 0,0:08:04.70,0:08:06.33,Default,,0,0,0,,Tôi đây vẫn còn giống nòi đàng hoàng đấy nhé,\Nkhỏi cần các người lo bò trắng răng.
Dialogue: 0,0:08:06.81,0:08:08.87,Default,,0,0,0,,Thằng bé cứ đứng tần ngần ngoài cửa quán nãy giờ.
Dialogue: 0,0:08:09.05,0:08:12.60,Default,,0,0,0,,Nhóc con à, cháu đến đây\Nđể tìm ai thế?
Dialogue: 0,0:08:13.37,0:08:17.15,Default,,0,0,0,,Cháu chỉ nghĩ rằng, nếu cháu đến nơi này\Nthì cháu có thể gặp được bố cháu.
Dialogue: 0,0:08:19.02,0:08:21.60,Default,,0,0,0,,Cháu chào các bác, cháu là Kenta.
Dialogue: 0,0:08:21.69,0:08:24.31,Default,,0,0,0,,Bác chính là bố cháu, đúng không ạ?
Dialogue: 0,0:08:25.54,0:08:28.05,Default,,0,0,0,,Nếu bác muốn xem chứng cứ, thì đây ạ.
Dialogue: 0,0:08:42.72,0:08:45.21,Default,,0,0,0,,Anh thừa biết tôi đang nói\Nvề ai mà.
Dialogue: 0,0:08:45.31,0:08:48.60,Default,,0,0,0,,Hiện giờ cậu ta đang trốn ở đâu?
Dialogue: 0,0:08:50.90,0:08:54.03,Default,,0,0,0,,Nếu tôi mà biết,\Nthì nãy giờ tôi đã khai hết với anh rồi.
Dialogue: 0,0:08:55.42,0:08:59.76,Default,,0,0,0,,Xin lỗi anh trước nhé,\Nnhưng cấm hút thuốc trong xe.
Dialogue: 0,0:09:00.67,0:09:06.45,Default,,0,0,0,,Anh biết đấy, dạo gần đây băng chúng tôi\Ncũng gặp đủ thứ rắc rối rồi,
Dialogue: 0,0:09:06.54,0:09:12.37,Default,,0,0,0,,nên chẳng còn bụng dạ đâu\Nmà để tâm đến mấy lời hăm dọa của các anh đâu.
Dialogue: 0,0:09:18.68,0:09:22.82,Default,,0,0,0,,Cứ bảo cậu ta mau ra đầu thú đi.
Dialogue: 0,0:09:28.25,0:09:30.78,Default,,0,0,0,,Nước trái cây của cháu đây.
Dialogue: 0,0:09:33.70,0:09:38.21,Default,,0,0,0,,Nếu không phải Ông chủ, thì là ai được nhỉ?
Dialogue: 0,0:09:41.45,0:09:45.64,Default,,0,0,0,,Rõ ràng đây đúng là địa chỉ này mà...
Dialogue: 0,0:09:46.72,0:09:50.23,Default,,0,0,0,,Ông chủ ơi, em nhờ chút việc được không?
Dialogue: 0,0:09:50.38,0:09:54.96,Default,,0,0,0,,Em tính nhờ ông giao một tô mì ramen\Nqua quán bar của em được không?
Dialogue: 0,0:09:55.06,0:09:57.10,Default,,0,0,0,,Sang bảo anh Chin giao cho.
Dialogue: 0,0:09:57.21,0:10:01.34,Default,,0,0,0,,Quán tôi chỉ có mì ăn liền thôi,\Ngiao qua tới nơi thì mì nguội ngắt mất rồi.
Dialogue: 0,0:10:01.86,0:10:05.90,Default,,0,0,0,,Không sao đâu mà,\Ndù gì người đó cũng đâu có ăn nóng được.
Dialogue: 0,0:10:07.02,0:10:10.51,Default,,0,0,0,,Thấy chưa?\NEm thấy Ông chủ nói có lý đấy chứ....
Dialogue: 0,0:10:10.67,0:10:14.20,Default,,0,0,0,,Nguội thế thì còn gì là hương vị nữa.\NThôi coi như em chưa nhờ vả gì đi.
Dialogue: 0,0:10:14.33,0:10:17.38,Default,,0,0,0,,Em quay lại làm việc đây.
Dialogue: 0,0:10:17.46,0:10:19.39,Default,,0,0,0,,Lát nữa em gặp lại sau nhé.
Dialogue: 0,0:10:21.85,0:10:24.72,Default,,0,0,0,,Ơ kìa?! Chị về luôn bây giờ đấy à?
Dialogue: 0,0:10:25.46,0:10:27.61,Default,,0,0,0,,Em vừa sực nhớ ra\Ncòn có việc cần phải giải quyết gấp.
Dialogue: 0,0:10:27.71,0:10:29.90,Default,,0,0,0,,Được rồi, hẹn gặp lại nhé.
Dialogue: 0,0:10:30.46,0:10:33.98,Default,,0,0,0,,Cơ mà lũ trẻ con thời nay\Nchẳng giống thế hệ chúng mình ngày xưa chút nào.
Dialogue: 0,0:10:34.64,0:10:36.74,Default,,0,0,0,,Đến cái mũi thò lò cũng chẳng có nữa là.
Dialogue: 0,0:10:36.85,0:10:39.97,Default,,0,0,0,,Thì đương nhiên rồi!\NChuyện từ đời tám hoánh nào rồi cơ chứ?
Dialogue: 0,0:10:40.26,0:10:42.79,Default,,0,0,0,,Thế thì đã làm sao nào?
Dialogue: 0,0:10:47.28,0:10:50.17,Default,,0,0,0,,Cháu đói bụng chưa?
Dialogue: 0,0:10:50.28,0:10:52.84,Default,,0,0,0,,Để bác nấu món gì cho cháu ăn nhé?
Dialogue: 0,0:10:58.02,0:11:00.64,Default,,0,0,0,,Đây là bàn tính gẩy sao ạ?
Dialogue: 0,0:11:00.82,0:11:02.51,Default,,0,0,0,,Làm bằng hạt đậu phộng ư?!
Dialogue: 0,0:11:02.65,0:11:04.74,Default,,0,0,0,,Tuyệt đỉnh thật đấy!
Dialogue: 0,0:11:04.85,0:11:08.66,Default,,0,0,0,,Bác tìm đâu ra những hạt đậu phộng\Ntrông y hệt nhau thế này vậy?!
Dialogue: 0,0:11:09.75,0:11:13.52,Default,,0,0,0,,Nhìn hoa cả mắt luôn rồi.
Dialogue: 0,0:11:14.74,0:11:18.62,Default,,0,0,0,,Cháu chạm vào được không ạ?
Dialogue: 0,0:11:19.71,0:11:22.52,Default,,0,0,0,,Nhẹ tay thôi nhé cháu...
Dialogue: 0,0:11:24.32,0:11:26.61,Default,,0,0,0,,Dusseldorf ư?
Dialogue: 0,0:11:26.73,0:11:28.03,Default,,0,0,0,,Đó là ở đâu thế bác?
Dialogue: 0,0:11:28.13,0:11:29.44,Default,,0,0,0,,Ở bên nước Đức đấy.
Dialogue: 0,0:11:29.54,0:11:32.24,Default,,0,0,0,,Gần nơi đó, người ta đã khai quật được\Ndi cốt của người Neanderthal cổ đại.
Dialogue: 0,0:11:33.46,0:11:37.10,Default,,0,0,0,,Hóa ra bố cháu từng sống ở nước ngoài sao...\NGiỏi giang thật đấy.
Dialogue: 0,0:11:37.19,0:11:41.15,Default,,0,0,0,,Thế nên, trước khi ra đi,
Dialogue: 0,0:11:41.30,0:11:46.14,Default,,0,0,0,,thằng bé luôn nghĩ về người bố ruột của mình,\Nnăm nào cũng đều đặn gửi thiệp chúc mừng sinh nhật cho bố.
Dialogue: 0,0:11:47.40,0:11:49.00,Default,,0,0,0,,Thật là một đứa trẻ ngoan ngoãn hiếu thảo!
Dialogue: 0,0:11:49.11,0:11:53.17,Default,,0,0,0,,Cháu không biết mặt mũi bố cháu ra sao cả,\Ncũng chẳng có lấy một tấm ảnh nào của bố.
Dialogue: 0,0:11:57.53,0:11:59.83,Default,,0,0,0,,Ôi chà... Chào anh Yuki.\NLâu lắm rồi không gặp anh.
Dialogue: 0,0:11:59.93,0:12:01.71,Default,,0,0,0,,Dạo này anh khỏe chứ?
Dialogue: 0,0:12:02.09,0:12:05.46,Default,,0,0,0,,Ra là đống này nhiều đến thế.
Dialogue: 0,0:12:05.57,0:12:08.05,Default,,0,0,0,,- Ông chủ ơi, cho tô ramen nhé.\N- Có ngay đây.
Dialogue: 0,0:12:08.23,0:12:10.76,Default,,0,0,0,,Lại là ramen nữa à.
Dialogue: 0,0:12:11.20,0:12:16.23,Default,,0,0,0,,Đúng là một đêm kỳ lạ thật đấy,\Nai nấy đều thi nhau gọi ramen.
Dialogue: 0,0:12:23.77,0:12:27.59,Default,,0,0,0,,Cậu mà để nó nguội ngắt như thế,\Nsợi mì sẽ trương phềnh lên đấy.
Dialogue: 0,0:12:27.80,0:12:30.36,Default,,0,0,0,,Em không chịu được đồ nóng mà.
Dialogue: 0,0:12:42.44,0:12:44.61,Default,,0,0,0,,Cứ tự nhiên vào đi.
Dialogue: 0,0:12:45.02,0:12:47.50,Default,,0,0,0,,Ô... Ông chủ.
Dialogue: 0,0:12:48.75,0:12:53.26,Default,,0,0,0,,Tôi muốn xem xem\Nai là người gọi tô ramen này ấy mà.
Dialogue: 0,0:13:06.42,0:13:09.47,Default,,0,0,0,,Cậu có muốn uống một ly bia không?
Dialogue: 0,0:13:17.31,0:13:19.36,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:13:19.65,0:13:24.99,Default,,0,0,0,,Làm gì có ai thèm ngồi cạn ly\Nvới một kẻ tội đồ như em cơ chứ?
Dialogue: 0,0:13:26.59,0:13:32.70,Default,,0,0,0,,Cậu để đại ca của mình một mình gánh hết rắc rối,\Ntrong khi cậu lại ngồi trốn chui trốn lủi ở đây sao?
Dialogue: 0,0:13:33.96,0:13:37.30,Default,,0,0,0,,Em biết ngay là Ông chủ sẽ nói vậy mà.
Dialogue: 0,0:13:38.33,0:13:43.10,Default,,0,0,0,,Chuyện đã xảy ra trong quá khứ\Nthì vĩnh viễn không bao giờ xóa bỏ được.
Dialogue: 0,0:13:45.56,0:13:50.99,Default,,0,0,0,,Điều quan trọng nhất bây giờ là\Ncậu sẽ đối mặt và giải quyết hậu quả ra sao.
Dialogue: 0,0:13:55.37,0:13:57.55,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:13:58.67,0:14:01.48,Default,,0,0,0,,em đã bước qua cây cầu không có lối quay đầu rồi.
Dialogue: 0,0:14:01.58,0:14:04.84,Default,,0,0,0,,Đó chẳng qua chỉ là cái cớ ngụy biện\Ncủa những kẻ hèn nhát...
Dialogue: 0,0:14:04.87,0:14:09.51,Default,,0,0,0,,trốn tránh việc đối diện với vấn đề của mình thôi sao?
Dialogue: 0,0:14:23.62,0:14:26.11,Default,,0,0,0,,Cảm ơn Ông chủ.
Dialogue: 0,0:14:27.74,0:14:29.81,Default,,0,0,0,,Này...
Dialogue: 0,0:14:34.54,0:14:37.82,Default,,0,0,0,,Đến quán tôi ăn bát mì ramen đi.
Dialogue: 0,0:14:38.59,0:14:44.12,Default,,0,0,0,,Đêm nay tôi có sẵn bao nhiêu rong biển\Nmà cậu thích ăn rồi đây.
Dialogue: 0,0:14:49.80,0:14:51.75,Default,,0,0,0,,Cậu chỉ đâm sượt qua hắn một nhát thôi, đúng không?
Dialogue: 0,0:14:51.86,0:14:53.96,Default,,0,0,0,,Thế thì bên công tố sẽ chỉ truy tố cậu\Ntội cố ý gây thương tích thôi,
Dialogue: 0,0:14:54.06,0:14:55.86,Default,,0,0,0,,và nếu thần may mắn mỉm cười,\Ncậu sẽ chỉ phải nhận án treo.
Dialogue: 0,0:14:55.90,0:14:57.77,Default,,0,0,0,,Đại ca nói thật chứ?
Dialogue: 0,0:14:58.25,0:15:00.34,Default,,0,0,0,,Chắc là vậy rồi.
Dialogue: 0,0:15:10.19,0:15:13.95,Default,,0,0,0,,Bác muốn cháu được gặp mặt bố mình...
Dialogue: 0,0:15:15.62,0:15:20.93,Default,,0,0,0,,Con trai cậu đến đây để tìm gặp cậu đấy.
Dialogue: 0,0:15:31.70,0:15:33.26,Default,,0,0,0,,Này nhóc...
Dialogue: 0,0:15:36.31,0:15:40.41,Default,,0,0,0,,Cháu là... Kenta đấy à?
Dialogue: 0,0:15:46.28,0:15:48.58,Default,,0,0,0,,Dạo này con khỏe không?
Dialogue: 0,0:15:49.18,0:15:51.81,Default,,0,0,0,,Cháu chào chú ạ.
Dialogue: 0,0:15:52.32,0:15:55.87,Default,,0,0,0,,Cháu có muốn ăn món gì không nào?
Dialogue: 0,0:15:58.22,0:16:00.79,Default,,0,0,0,,Cháu muốn ăn mì ramen ạ...
Dialogue: 0,0:16:01.52,0:16:05.73,Default,,0,0,0,,Ở đây người ta chỉ có mì gói ăn liền thôi cháu.
Dialogue: 0,0:16:06.62,0:16:09.83,Default,,0,0,0,,Ở nhà cháu không được ăn món đó đâu,
Dialogue: 0,0:16:10.04,0:16:14.33,Default,,0,0,0,,vì mẹ cháu ghét mì ăn liền lắm.
Dialogue: 0,0:16:16.58,0:16:18.93,Default,,0,0,0,,Ông chủ ơi! Cho một tô ramen nhé!
Dialogue: 0,0:16:19.92,0:16:21.39,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:17:12.41,0:17:13.99,Default,,0,0,0,,Cháu thấy ngon miệng không?
Dialogue: 0,0:17:16.84,0:17:18.86,Default,,0,0,0,,Thật thế sao?
Dialogue: 0,0:17:19.58,0:17:21.87,Default,,0,0,0,,Bố con mình sẽ còn gặp lại nhau nữa chứ bố?
Dialogue: 0,0:17:22.64,0:17:24.72,Default,,0,0,0,,Ừ, chắc chắn rồi con.
Dialogue: 0,0:17:25.03,0:17:27.02,Default,,0,0,0,,Lần sau con sẽ viết thư gửi cho bố nhé.
Dialogue: 0,0:17:27.10,0:17:29.90,Default,,0,0,0,,Thế địa chỉ của bố là gì ạ?
Dialogue: 0,0:17:36.14,0:17:40.64,Default,,0,0,0,,Cứ gửi về địa chỉ quán này như mọi khi là được.
Dialogue: 0,0:17:55.84,0:18:01.02,Default,,0,0,0,,- Con nhớ giữ gìn sức khỏe nhé.\N- Bố cũng vậy nhé bố.
Dialogue: 0,0:18:16.93,0:18:19.01,Default,,0,0,0,,Đại ca...
Dialogue: 0,0:18:21.38,0:18:22.98,Default,,0,0,0,,Em có thể tự mình đối diện được rồi.
Dialogue: 0,0:18:23.38,0:18:27.20,Default,,0,0,0,,Giờ em sẽ không chạy trốn nữa đâu.
Dialogue: 0,0:18:29.99,0:18:31.93,Default,,0,0,0,,Đi sát bên cạnh tao.
Dialogue: 0,0:18:39.85,0:18:41.93,Default,,0,0,0,,Con nhất định sẽ viết thư cho bố đấy nhé!
Dialogue: 0,0:18:42.23,0:18:44.77,Default,,0,0,0,,Địa chỉ ở đây này bố ơi!
Dialogue: 0,0:19:02.04,0:19:07.02,Default,,0,0,0,,Vậy là người ta không được phép buồn\Nvào dịp Giáng sinh sao?
Dialogue: 0,0:19:07.13,0:19:10.66,Default,,0,0,0,,Thôi... Coi như tôi chưa nói gì đi.
Dialogue: 0,0:19:11.37,0:19:15.48,Default,,0,0,0,,Nhưng cả năm mới có đúng một ngày lễ,\Nvới lại tôi cũng không có ý chê bai gì đâu,
Dialogue: 0,0:19:15.60,0:19:19.02,Default,,0,0,0,,chỉ là đón Giáng sinh ở một nơi thế này\Nthì hơi có chút...
Dialogue: 0,0:19:21.54,0:19:23.68,Default,,0,0,0,,Tôi xin lỗi nhé.
Dialogue: 0,0:19:27.30,0:19:29.27,Default,,0,0,0,,Ôi! Anh Ryu kìa!
Dialogue: 0,0:19:29.36,0:19:31.40,Default,,0,0,0,,Kìa anh... Vào đây đi anh!
Dialogue: 0,0:19:32.38,0:19:34.61,Default,,0,0,0,,Cậu ấy được hưởng án treo rồi.
Dialogue: 0,0:19:34.75,0:19:36.93,Default,,0,0,0,,Thật thế sao anh?
Dialogue: 0,0:19:38.20,0:19:43.27,Default,,0,0,0,,Tôi nợ Ông chủ ân tình này nhiều lắm đấy....
Dialogue: 0,0:19:46.40,0:19:49.28,Default,,0,0,0,,Nhìn xem này mọi người ơi!
Dialogue: 0,0:19:49.39,0:19:52.00,Default,,0,0,0,,- Cua biển kìa!\N- Cua ngon quá...
Dialogue: 0,0:19:52.11,0:19:55.35,Default,,0,0,0,,Ông già Noel có thật trên đời đấy, Ông chủ ơi!
Dialogue: 0,0:19:55.44,0:19:58.66,Default,,0,0,0,,Triển luôn thôi nào!
Dialogue: 0,0:19:59.22,0:20:00.37,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:20:00.82,0:20:04.36,Default,,0,0,0,,Đêm nay chúng ta hãy xõa hết mình với tiệc cua nào!
Dialogue: 0,0:20:47.17,0:20:49.54,Default,,0,0,0,,Đây chính là thứ mà người ta hay gọi là....
Dialogue: 0,0:20:49.66,0:20:52.87,Default,,0,0,0,,"Đêm Thánh vô cùng" đấy.
Dialogue: 0,0:21:13.03,0:21:15.80,Default,,0,0,0,,Cuối cùng thì anh cũng quyết định lên đường rồi sao.
Dialogue: 0,0:21:16.85,0:21:19.50,Default,,0,0,0,,Nếu tôi cứ lưu lại một nơi ấm áp quá lâu,
Dialogue: 0,0:21:19.59,0:21:22.49,Default,,0,0,0,,trong lòng tôi lại cồn cào thôi thúc\Nphải đi tới một nơi hoàn toàn trái ngược.
Dialogue: 0,0:21:22.59,0:21:25.54,Default,,0,0,0,,Tính khí phiêu bạt đó quả là gánh nặng nhỉ.
Dialogue: 0,0:21:25.82,0:21:28.40,Default,,0,0,0,,Bản thân tôi cũng thấy khổ sở vì nó lắm chứ.
Dialogue: 0,0:21:28.95,0:21:31.17,Default,,0,0,0,,Nhân tiện đây, gửi lại ông này...
Dialogue: 0,0:21:31.39,0:21:33.91,Default,,0,0,0,,Đây là tiền rượu tôi nợ ông suốt thời gian qua.
Dialogue: 0,0:21:34.01,0:21:35.97,Default,,0,0,0,,Anh cứ giữ lấy đi.
Dialogue: 0,0:21:36.08,0:21:40.52,Default,,0,0,0,,Chân ướt chân ráo tới một vùng đất mới,\Nanh sẽ còn cần tiêu đến nhiều tiền đấy.
Dialogue: 0,0:21:40.64,0:21:43.09,Default,,0,0,0,,Xin ông hãy nhận cho tôi.
Dialogue: 0,0:21:43.20,0:21:46.91,Default,,0,0,0,,Tôi chỉ nghĩ rằng, chuyến đi lần này,\Ntôi sẽ đi rất lâu và rất xa đấy.
Dialogue: 0,0:21:47.33,0:21:49.12,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:21:56.52,0:21:58.24,Default,,0,0,0,,Vì vậy...
Dialogue: 0,0:22:04.38,0:22:08.61,Default,,0,0,0,,Tôi sẽ chịu trách nhiệm cho vết sẹo đó trên mặt ông.
Dialogue: 0,0:22:08.71,0:22:11.88,Default,,0,0,0,,Âu cũng là lẽ đời!
Dialogue: 0,0:22:12.49,0:22:18.43,Default,,0,0,0,,Cứ quanh quanh quẩn quẩn mãi khôn nguôi.
Dialogue: 0,0:22:20.97,0:22:24.26,Default,,0,0,0,,Đừng có coi thường cuộc đời này!
Dialogue: 0,0:23:11.12,0:23:13.96,Default,,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:23:14.55,0:23:17.31,Default,,0,0,0,,Dù không có trong thực đơn,
Dialogue: 0,0:23:18.46,0:23:21.34,Default,,0,0,0,,chỉ cần làm được là tôi đều sẽ nấu cho quý khách.
Dialogue: 0,0:23:24.17,0:23:32.14,Default,,0,0,0,,Phụ đề tiếng Việt thực hiện bởi:
Dialogue: 0,0:23:57.69,0:24:06.91,Default,,0,0,0,,Amtia(NOFACE)
