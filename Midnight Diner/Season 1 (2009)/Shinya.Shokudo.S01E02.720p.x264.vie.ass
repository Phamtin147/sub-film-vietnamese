Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:00:02.83,0:00:06.09,Default,,0,0,0,,Ca khúc mở đầu\NOmohide (Hoài Niệm) - Trình bày: Suzuki Tsunekichi
Dialogue: 0,0:00:06.57,0:00:10.11,Default,,0,0,0,,DIỄN VIÊN CHÍNH\N~ Kobayashi Kaoru ~
Dialogue: 0,0:00:12.51,0:00:16.16,Default,,0,0,0,,~ Tabata Tomoko ~
Dialogue: 0,0:00:18.52,0:00:22.07,Default,,0,0,0,,~ Taguchi Tomorowo ~
Dialogue: 0,0:00:24.55,0:00:28.03,Default,,0,0,0,,~ Odagiri Jo ~
Dialogue: 0,0:00:26.10,0:00:31.13,Default,,0,0,0,,kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra
Dialogue: 0,0:00:30.63,0:00:34.11,Default,,0,0,0,,Đạo diễn: Matsuoka Joji
Dialogue: 0,0:00:31.33,0:00:36.01,Default,,0,0,0,,ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió
Dialogue: 0,0:00:36.35,0:00:41.42,Default,,0,0,0,,sora ni ukabu kumo no naka ni\NRồi từng chút một tan biến dần
Dialogue: 0,0:00:41.58,0:00:46.55,Default,,0,0,0,,sukoshi zutsu kie te yuku\NVào tầng mây trôi bồng bềnh trên cao
Dialogue: 0,0:00:46.73,0:00:51.45,Default,,0,0,0,,tooku takai sora no naka de\NTừ giữa bầu trời cao vời vợi
Dialogue: 0,0:00:51.70,0:00:56.43,Default,,0,0,0,,te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em
Dialogue: 0,0:00:56.72,0:01:01.89,Default,,0,0,0,,kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra
Dialogue: 0,0:01:02.00,0:01:06.75,Default,,0,0,0,,pokkari to ukan de iru\NRồi lững lờ trôi giữa không trung
Dialogue: 0,0:01:07.66,0:01:17.44,Default,,0,0,0,,zutto mukashi no koto no you da ne\NNgỡ như một ký ức từ thuở xa xôi
Dialogue: 0,0:01:17.67,0:01:26.63,Default,,0,0,0,,kawamo no ue o kumo ga nagareru\NBóng mây lững lờ trôi trên mặt sông
Dialogue: 0,0:01:46.25,0:01:48.10,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày,{\i0}
Dialogue: 0,0:01:48.20,0:01:51.32,Default,,0,0,0,,{\i1}và vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:51.73,0:01:53.85,Default,,0,0,0,,{\i1}thì một ngày của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:54.51,0:01:56.53,Default,,0,0,0,,~ Súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly
Dialogue: 0,0:01:56.62,0:01:58.84,Default,,0,0,0,,{\i1}Thực đơn của tôi chỉ có vỏn vẹn chừng đó.{\i0}
Dialogue: 0,0:01:58.99,0:02:01.84,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì,{\i0}
Dialogue: 0,0:02:01.92,0:02:03.95,Default,,0,0,0,,{\i1}chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:02:04.04,0:02:06.57,Default,,0,0,0,,{\i1}Phương châm làm việc của tôi là vậy.{\i0}
Dialogue: 0,0:02:07.52,0:02:12.92,Default,,0,0,0,,{\i1}Quán mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:02:13.16,0:02:14.43,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:02:14.54,0:02:17.63,Default,,0,0,0,,{\i1}'Quán Ăn Đêm'.{\i0}
Dialogue: 0,0:02:17.73,0:02:19.79,Default,,0,0,0,,{\i1}Bạn hỏi liệu có khách khứa nào ghé không ư?{\i0}
Dialogue: 0,0:02:19.91,0:02:21.94,Default,,0,0,0,,{\i1}Thực ra là đông hơn bạn tưởng đấy.{\i0}
Dialogue: 0,0:02:24.33,0:02:27.32,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:02:27.50,0:02:32.76,Default,,0,0,0,,Tập 2\NCơm Mèo (Nekomanma)
Dialogue: 0,0:02:36.97,0:02:38.79,Default,,0,0,0,,{\i1}Lần đầu tiên cô bé ấy ghé quán...{\i0}
Dialogue: 0,0:02:38.88,0:02:42.28,Default,,0,0,0,,{\i1}là vào khoảng sáu giờ rưỡi sáng,{\i0}
Dialogue: 0,0:02:42.40,0:02:45.19,Default,,0,0,0,,{\i1}ngay lúc tôi vừa chuẩn bị dọn hàng đóng cửa.{\i0}
Dialogue: 0,0:02:56.55,0:02:59.28,Default,,0,0,0,,Quán mình có cá ngừ bào katsuobushi* không ạ?\N(*cá ngừ xông khói sấy khô bào mỏng)
Dialogue: 0,0:03:00.07,0:03:02.45,Default,,0,0,0,,Quán tôi có đấy, nhưng...
Dialogue: 0,0:03:03.38,0:03:07.64,Default,,0,0,0,,Cháu muốn xin một ít rắc lên bát cơm nóng,\Nrồi rưới thêm chút nước tương thôi ạ.
Dialogue: 0,0:03:09.90,0:03:11.91,Default,,0,0,0,,Ý cháu là món cơm mèo (nekomanma) ấy hả?
Dialogue: 0,0:03:12.42,0:03:14.54,Default,,0,0,0,,Ông chủ cũng thích món đó ạ?
Dialogue: 0,0:03:14.64,0:03:16.37,Default,,0,0,0,,Ừ.
Dialogue: 0,0:03:21.77,0:03:23.49,Default,,0,0,0,,Cháu có thể...
Dialogue: 0,0:03:23.60,0:03:25.51,Default,,0,0,0,,chờ tôi một lát được không?
Dialogue: 0,0:03:25.53,0:03:29.68,Default,,0,0,0,,Dạ được... Chỉ là trong người cháu\Nhiện không có nhiều tiền lắm.
Dialogue: 0,0:03:29.77,0:03:31.47,Default,,0,0,0,,Dù sao cũng tiện công,
Dialogue: 0,0:03:31.58,0:03:34.44,Default,,0,0,0,,hay là để tôi cắm\Nmột nồi cơm mới luôn nhé?
Dialogue: 0,0:03:34.89,0:03:38.11,Default,,0,0,0,,Tự dưng chính tôi cũng thấy\Nthèm ăn một bát cơm mèo quá.
Dialogue: 0,0:03:39.52,0:03:40.90,Default,,0,0,0,,Thật thế ạ?
Dialogue: 0,0:03:41.04,0:03:42.68,Default,,0,0,0,,Ừ...
Dialogue: 0,0:04:48.05,0:04:49.62,Default,,0,0,0,,Mời cháu dùng bữa.
Dialogue: 0,0:05:02.92,0:05:04.39,Default,,0,0,0,,Vị thế nào?
Dialogue: 0,0:05:21.01,0:05:23.01,Default,,0,0,0,,{\i1}Kể từ sau ngày hôm đó,{\i0}
Dialogue: 0,0:05:23.10,0:05:25.37,Default,,0,0,0,,{\i1}cứ vào đúng khoảng thời gian ấy...{\i0}
Dialogue: 0,0:05:32.77,0:05:34.83,Default,,0,0,0,,Chào Ông chủ!
Dialogue: 0,0:05:34.94,0:05:38.24,Default,,0,0,0,,Cháu lại ghé nữa đây ạ.
Dialogue: 0,0:05:47.56,0:05:51.18,Default,,0,0,0,,Cháu làm công việc gì mà thức đến\Ntận sáng sớm tinh mơ thế này?
Dialogue: 0,0:05:52.56,0:05:54.38,Default,,0,0,0,,Cháu đi làm thêm à?
Dialogue: 0,0:05:55.53,0:05:57.90,Default,,0,0,0,,Ở quán karaoke hộp ạ.
Dialogue: 0,0:06:00.27,0:06:02.46,Default,,0,0,0,,Ông chủ biết không...
Dialogue: 0,0:06:03.31,0:06:05.10,Default,,0,0,0,,Ông chủ hứa là đừng cười cháu nhé.
Dialogue: 0,0:06:05.17,0:06:06.54,Default,,0,0,0,,Ừ.
Dialogue: 0,0:06:06.72,0:06:09.95,Default,,0,0,0,,Cháu là ca sĩ hát nhạc enka.
Dialogue: 0,0:06:11.12,0:06:15.71,Default,,0,0,0,,Dù chắc phải gắn thêm hai chữ 'không tên tuổi'\Nở đằng trước thì mới đúng.
Dialogue: 0,0:06:15.87,0:06:18.60,Default,,0,0,0,,Chẳng có bầu sô nào mời đi hát,\Nnhưng vì cháu vẫn khao khát được ca hát,
Dialogue: 0,0:06:18.72,0:06:21.26,Default,,0,0,0,,nên đêm nào cháu cũng tới đó\Nhát suốt cả đêm đến sáng.
Dialogue: 0,0:06:21.34,0:06:23.39,Default,,0,0,0,,Dù đó đều không phải là bài hát của riêng cháu...
Dialogue: 0,0:06:23.78,0:06:26.42,Default,,0,0,0,,Thế cháu có bài hát nào\Ncủa riêng mình chưa?
Dialogue: 0,0:06:26.81,0:06:29.04,Default,,0,0,0,,Chỉ có đúng một bài thôi ạ.
Dialogue: 0,0:06:29.14,0:06:30.73,Default,,0,0,0,,Ở mấy quán karaoke bình thường chẳng tìm thấy đâu,
Dialogue: 0,0:06:30.82,0:06:33.29,Default,,0,0,0,,mà cũng chẳng mấy ai biết đến bài đó cả.
Dialogue: 0,0:06:33.49,0:06:35.73,Default,,0,0,0,,Trong số những vị khách quen của quán tôi...
Dialogue: 0,0:06:35.84,0:06:38.15,Default,,0,0,0,,có một vị là nhạc sĩ sáng tác đấy.
Dialogue: 0,0:06:38.38,0:06:40.02,Default,,0,0,0,,Thật thế ạ?
Dialogue: 0,0:06:40.14,0:06:43.07,Default,,0,0,0,,Lần tới ghé quán nhớ mang theo áp phích của cháu nhé.
Dialogue: 0,0:06:43.20,0:06:45.24,Default,,0,0,0,,Tôi sẽ dán nó lên góc tường kia.
Dialogue: 0,0:06:45.34,0:06:47.63,Default,,0,0,0,,Thật hả Ông chủ?
Dialogue: 0,0:06:54.29,0:06:55.85,Default,,0,0,0,,{\i1}Khi một ngày khép lại,{\i0}
Dialogue: 0,0:06:55.94,0:06:59.12,Default,,0,0,0,,{\i1}và dòng người đang\Nhối hả trở về nhà,{\i0}
Dialogue: 0,0:06:59.23,0:07:02.29,Default,,0,0,0,,{\i1}đôi khi trong lòng họ\Nchợt dâng lên một nỗi bồn chồn khó tả,{\i0}
Dialogue: 0,0:07:02.38,0:07:05.90,Default,,0,0,0,,{\i1}thôi thúc họ muốn tìm một chốn khác\Nđể qua đêm thay vì về nhà.{\i0}
Dialogue: 0,0:07:09.60,0:07:11.26,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn nhé.
Dialogue: 0,0:07:15.78,0:07:20.15,Default,,0,0,0,,~ Cuộc Đời, Mặc Dòng Đời Đưa Đẩy ~\NChidori Miyuki
Dialogue: 0,0:07:20.24,0:07:21.92,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:07:22.89,0:07:26.67,Default,,0,0,0,,Sống từng này tuổi đầu mới thấy cảnh này,\Nđúng là chuyện lạ có thật ở quán này đấy.
Dialogue: 0,0:07:28.43,0:07:29.71,Default,,0,0,0,,Mọi người có muốn mua một đĩa không?
Dialogue: 0,0:07:29.86,0:07:32.11,Default,,0,0,0,,Tôi có giữ cả đĩa CD của cổ đây.
Dialogue: 0,0:07:32.22,0:07:34.51,Default,,0,0,0,,Vậy là ông phải lòng con bé đứ đừ rồi hả?!
Dialogue: 0,0:07:37.32,0:07:40.75,Default,,0,0,0,,Đó là cô bé dạo này vẫn hay\Nghé quán để ăn món cơm mèo đấy.
Dialogue: 0,0:07:42.10,0:07:44.29,Default,,0,0,0,,Tôi cũng khoái món đó lắm.
Dialogue: 0,0:07:44.41,0:07:45.98,Default,,0,0,0,,Món cơm mèo nekomanma ấy.
Dialogue: 0,0:07:46.07,0:07:47.84,Default,,0,0,0,,Câu đó nghe chẳng giống\Nlời giải thích chút nào đâu nhé, Ông chủ.
Dialogue: 0,0:07:47.93,0:07:50.47,Default,,0,0,0,,Có đời thuở nhà ai lại đi hát bài\N'Mặc dòng đời đưa đẩy' bao giờ cơ chứ?!
Dialogue: 0,0:07:50.55,0:07:52.32,Default,,0,0,0,,Em là em chúa ghét cái thể loại đó.
Dialogue: 0,0:07:52.45,0:07:53.68,Default,,0,0,0,,Thể loại gì cơ?
Dialogue: 0,0:07:53.77,0:07:56.60,Default,,0,0,0,,Thì mấy cái bài hát não nề người ta hay\Nhát rong ở khu phố phía nam nhà ga ấy?
Dialogue: 0,0:07:56.68,0:07:57.49,Default,,0,0,0,,Hát rong ngoài phố á?
Dialogue: 0,0:07:57.65,0:08:00.37,Default,,0,0,0,,Ừa...\NMà có ma nào thèm nghe mấy bài đó chứ?
Dialogue: 0,0:08:00.47,0:08:02.87,Default,,0,0,0,,Nghe mấy giai điệu đó\Nchỉ tổ làm người ta thêm sầu não thôi.
Dialogue: 0,0:08:03.30,0:08:04.59,Default,,0,0,0,,Chắc cô bé này cũng cùng cảnh ngộ đó thôi.
Dialogue: 0,0:08:05.17,0:08:08.71,Default,,0,0,0,,Nhưng biết đâu ngôi sao ăn khách tiếp theo\Nlại bước ra từ chính những con hẻm đó thì sao.
Dialogue: 0,0:08:08.80,0:08:11.64,Default,,0,0,0,,Chẳng phải như thế lại càng tàn nhẫn và xót xa hơn ư?
Dialogue: 0,0:08:12.14,0:08:15.23,Default,,0,0,0,,'Biết đâu một ngày nào đó mình cũng sẽ\Ntrở thành ngôi sao sáng giống như họ!'
Dialogue: 0,0:08:16.32,0:08:18.74,Default,,0,0,0,,Thì đấy, kiểu gieo rắc mấy niềm hy vọng hão huyền ấy mà.
Dialogue: 0,0:08:19.74,0:08:20.92,Default,,0,0,0,,Bật lên nghe thử đi!
Dialogue: 0,0:08:21.00,0:08:22.92,Default,,0,0,0,,Nếu nghe êm tai,\Ntôi sẽ mua ủng hộ một đĩa.
Dialogue: 0,0:08:23.27,0:08:25.92,Default,,0,0,0,,Quán mình chỉ có mỗi chiếc đài radio cũ kỹ này thôi.
Dialogue: 0,0:08:26.56,0:08:27.99,Default,,0,0,0,,Thầy ơi...
Dialogue: 0,0:08:28.31,0:08:29.95,Default,,0,0,0,,Ý thầy thấy sao ạ?
Dialogue: 0,0:08:32.28,0:08:34.73,Default,,0,0,0,,Nghe bảo ông ấy là nhạc sĩ sáng tác đấy.
Dialogue: 0,0:08:35.38,0:08:37.41,Default,,0,0,0,,Cô bé đó có hay\Nghé quán này không Ông chủ?
Dialogue: 0,0:08:37.51,0:08:40.06,Default,,0,0,0,,Vậy sao anh không bảo cô bé\Nđến hát trực tiếp ngay tại quán luôn đi?
Dialogue: 0,0:08:40.63,0:08:41.98,Default,,0,0,0,,Ý kiến quá hay luôn!
Dialogue: 0,0:08:42.17,0:08:43.54,Default,,0,0,0,,Làm vậy đi, triển luôn đi Ông chủ!
Dialogue: 0,0:08:43.67,0:08:45.58,Default,,0,0,0,,Nếu con bé hát hay thật,\Nbác đây sẽ mua đĩa CD ủng hộ.
Dialogue: 0,0:08:46.79,0:08:48.90,Default,,0,0,0,,Biết đâu lại thành bài hit lớn đấy.
Dialogue: 0,0:08:50.44,0:08:51.56,Default,,0,0,0,,Thế gian này của chúng ta...
Dialogue: 0,0:08:51.64,0:08:54.43,Default,,0,0,0,,cũng như con nước thủy triều sông Nile vậy,\Ngieo nhân nào ắt gặt quả nấy, đời có vay có trả.
Dialogue: 0,0:08:54.55,0:08:56.88,Default,,0,0,0,,Đừng có coi thường cuộc đời.
Dialogue: 0,0:08:58.69,0:09:00.69,Default,,0,0,0,,Cơ mà...
Dialogue: 0,0:09:00.80,0:09:05.29,Default,,0,0,0,,Ông ấy tò mò muốn nghe thử\Nbài hát của cô bé thật hả?
Dialogue: 0,0:09:05.37,0:09:06.81,Default,,0,0,0,,Hay chỉ là kiếm cớ\Nđể được gặp mặt con bé thôi?!
Dialogue: 0,0:09:06.90,0:09:08.27,Default,,0,0,0,,Cứ thấy con gái trẻ đẹp còn thở\Nlà ông nào cũng sáng mắt lên cả thôi.
Dialogue: 0,0:09:08.35,0:09:11.14,Default,,0,0,0,,- Đàn ông đúng là đơn giản thật đấy nhỉ?\N- Chuẩn luôn!
Dialogue: 0,0:09:11.22,0:09:12.93,Default,,0,0,0,,Ông chủ ơi, cho tụi em thêm một chầu cơm chan trà ochazuke* nữa nhé.
Dialogue: 0,0:09:11.22,0:09:12.93,Default,,0,0,0,,{\i1}(*cơm chan nước trà xanh ăn kèm đồ mặn){\i0}
Dialogue: 0,0:09:13.03,0:09:14.56,Default,,0,0,0,,- Cho em vị trứng cá tuyết tarako.\N- Mận muối ume. - Cá hồi nhé.
Dialogue: 0,0:09:14.64,0:09:15.67,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:09:15.78,0:09:18.55,Default,,0,0,0,,Chẳng phải trước đây chính cậu cũng từng nói câu đó còn gì?
Dialogue: 0,0:09:18.85,0:09:20.73,Default,,0,0,0,,Thời gian vốn chẳng nương tay\Nvới bất kỳ ai đâu, cưng à.
Dialogue: 0,0:09:20.83,0:09:24.32,Default,,0,0,0,,- Làm như nó nương tay với bà lắm đấy.\N- Cuộc đời mặc dòng đời đưa đẩy ư?!
Dialogue: 0,0:09:24.98,0:09:27.03,Default,,0,0,0,,Chẳng phải thế sao?
Dialogue: 0,0:09:32.94,0:09:35.87,Default,,0,0,0,,~ Khu phố Shinjuku Golden Gai ~
Dialogue: 0,0:09:47.01,0:09:50.96,Default,,0,0,0,,~ Ngôi Sao Mới Làng Nhạc Enka ~\NChidori Miyuki\NĐÊM NHẠC MINI\N~ Vào cửa tự do ~
Dialogue: 0,0:09:48.76,0:09:53.79,Default,,0,0,0,,Mặc dòng đời đưa đẩy,
Dialogue: 0,0:09:54.25,0:09:59.62,Default,,0,0,0,,mặc số phận cuốn trôi đời tôi về đâu.
Dialogue: 0,0:09:59.87,0:10:02.05,Default,,0,0,0,,Từ những năm tháng ấu thơ...
Dialogue: 0,0:10:02.35,0:10:04.93,Default,,0,0,0,,cho đến khi khôn lớn trưởng thành,
Dialogue: 0,0:10:05.64,0:10:10.91,Default,,0,0,0,,cuộc đời cứ thế trôi đi\Nmặc cho số phận đẩy đưa.
Dialogue: 0,0:10:11.21,0:10:13.99,Default,,0,0,0,,Mặc dòng đời đưa đẩy,
Dialogue: 0,0:10:14.12,0:10:22.21,Default,,0,0,0,,mặc số phận cuốn trôi đời tôi về đâu.
Dialogue: 0,0:10:22.49,0:10:24.94,Default,,0,0,0,,Tìm một con hẻm nhỏ khuất sâu...
Dialogue: 0,0:10:25.16,0:10:28.03,Default,,0,0,0,,rồi cứ thế bước đi loanh quanh mãi...
Dialogue: 0,0:10:28.20,0:10:33.30,Default,,0,0,0,,đó là điều làm lòng tôi vui nhất.
Dialogue: 0,0:10:34.50,0:10:35.32,Default,,0,0,0,,Bác mua một đĩa!
Dialogue: 0,0:10:35.43,0:10:37.07,Default,,0,0,0,,Bán cho bác một đĩa CD nào!
Dialogue: 0,0:10:37.28,0:10:38.87,Default,,0,0,0,,Dạ của bác đây ạ.
Dialogue: 0,0:10:45.29,0:10:47.91,Default,,0,0,0,,Chẳng biết phải diễn tả thế nào,\Nnhưng bài hát nghe rất có cá tính đấy.
Dialogue: 0,0:10:48.01,0:10:50.58,Default,,0,0,0,,Hơn nữa, chất giọng của cháu\Ngây ấn tượng rất mạnh.
Dialogue: 0,0:10:50.65,0:10:56.02,Default,,0,0,0,,Còn về bản thân bài hát thì tôi cũng chẳng rõ\Nnên gọi nó là buồn thương hay là gì nữa.
Dialogue: 0,0:10:56.54,0:11:01.14,Default,,0,0,0,,Nhưng một cô gái trẻ trung như cháu mà lại thích ăn\Ncơm mèo nekomanma, chẳng phải hơi lạ lùng sao?!
Dialogue: 0,0:11:01.55,0:11:03.50,Default,,0,0,0,,Cháu là người vùng Đông Bắc (Tohoku) phải không?
Dialogue: 0,0:11:03.59,0:11:04.57,Default,,0,0,0,,Sao thầy đoán ra hay vậy ạ?
Dialogue: 0,0:11:04.67,0:11:08.07,Default,,0,0,0,,Ừ... Thứ mà người dân vùng phía Tây\Ngọi là cơm mèo nekomanma ấy...
Dialogue: 0,0:11:08.20,0:11:10.49,Default,,0,0,0,,thường là cơm chan canh tương miso.
Dialogue: 0,0:11:10.59,0:11:13.60,Default,,0,0,0,,Nhưng rưới nước tương vào cơm thì\Nkhông tốt cho sức khỏe của loài mèo đâu.
Dialogue: 0,0:11:13.69,0:11:15.37,Default,,0,0,0,,Bởi vì nước tương quá mặn.
Dialogue: 0,0:11:15.47,0:11:17.30,Default,,0,0,0,,Nhưng không rưới nước tương\Nthì ăn nhạt thếch làm sao nuốt nổi.
Dialogue: 0,0:11:17.39,0:11:18.58,Default,,0,0,0,,Không, tuyệt đối không được.
Dialogue: 0,0:11:18.67,0:11:21.20,Default,,0,0,0,,Bởi vì loài mèo có thận rất yếu\Nvà không thể bài tiết mồ hôi,
Dialogue: 0,0:11:21.31,0:11:23.09,Default,,0,0,0,,nên cơ thể chúng thực sự không\Ncần đến lượng muối nhiều như thế.
Dialogue: 0,0:11:22.73,0:11:24.66,Default,,0,0,0,,Nhưng tôi lại cứ khoái ăn đồ mặn chát đấy...
Dialogue: 0,0:11:26.39,0:11:29.49,Default,,0,0,0,,Này... Miyuki-chan.\NTôi có món quà tặng cháu đây.
Dialogue: 0,0:11:29.80,0:11:31.90,Default,,0,0,0,,Sao hai người cứ hễ mở miệng ra\Nlà lại cãi nhau chan chát thế hả?
Dialogue: 0,0:11:31.98,0:11:33.44,Default,,0,0,0,,Thế sao anh lại bênh lão ta?
Dialogue: 0,0:11:33.81,0:11:35.74,Default,,0,0,0,,Sao chúng ta lại thế nhỉ...
Dialogue: 0,0:11:35.86,0:11:38.37,Default,,0,0,0,,Ngẫm kỹ lại thì chẳng phải hai người\Nđang rất hợp tính nhau đấy sao?
Dialogue: 0,0:11:43.17,0:11:45.80,Default,,0,0,0,,'Mèo Hoang' (Mayoi Neko).
Dialogue: 0,0:11:46.46,0:11:48.83,Default,,0,0,0,,Khi lắng nghe giọng hát của cháu,
Dialogue: 0,0:11:48.92,0:11:51.54,Default,,0,0,0,,từng ca từ cứ thế tự nhiên tuôn trào trong tâm trí tôi.
Dialogue: 0,0:11:51.65,0:11:53.10,Default,,0,0,0,,Thầy ơi!
Dialogue: 0,0:11:53.84,0:11:55.06,Default,,0,0,0,,Miyuki-chan à.
Dialogue: 0,0:11:55.16,0:11:57.18,Default,,0,0,0,,Điều quan trọng nhất...
Dialogue: 0,0:11:57.35,0:12:00.36,Default,,0,0,0,,chính là khát khao được cất tiếng hát của cháu.
Dialogue: 0,0:12:00.47,0:12:03.53,Default,,0,0,0,,Đừng bao giờ đánh mất tâm niệm đó, nhớ chưa?
Dialogue: 0,0:12:04.31,0:12:06.50,Default,,0,0,0,,Cháu cảm ơn thầy nhiều lắm ạ.
Dialogue: 0,0:12:21.76,0:12:24.36,Default,,0,0,0,,Đàn ông một khi đã rơi lệ thì chẳng bao giờ quay đầu lại.
Dialogue: 0,0:12:24.45,0:12:26.71,Default,,0,0,0,,Kiếp sống phiêu bạt đã lấp đầy\Nnhững tháng ngày của nàng ngay từ thuở ban đầu.
Dialogue: 0,0:12:26.82,0:12:28.65,Default,,0,0,0,,Thêm một lần nữa, chú mèo hoang nhỏ bé...
Dialogue: 0,0:12:28.75,0:12:31.63,Default,,0,0,0,,lại lang thang khắp những con phố\Nkhông bao giờ ngủ của Shinjuku.
Dialogue: 0,0:12:31.75,0:12:33.93,Default,,0,0,0,,Từ một con hẻm khuất sâu\Ncách xa khu phố sầm uất,
Dialogue: 0,0:12:34.05,0:12:36.39,Default,,0,0,0,,một người phụ nữ vẫn mải miết dạo bước\Nqua từng con phố để kiếm tìm...
Dialogue: 0,0:12:36.51,0:12:39.12,Default,,0,0,0,,một đóa hoa tình yêu vừa chớm nở\Nđã bị người đàn ông nhẫn tâm bỏ mặc héo tàn trong gió.
Dialogue: 0,0:12:39.49,0:12:42.00,Default,,0,0,0,,Giờ đây bước chân tôi biết đi về đâu?
Dialogue: 0,0:12:42.13,0:12:44.75,Default,,0,0,0,,Xin giới thiệu gương mặt triển vọng Chidori Miyuki,
Dialogue: 0,0:12:44.85,0:12:48.20,Default,,0,0,0,,với ca khúc 'Mèo Hoang'.
Dialogue: 0,0:12:48.69,0:12:59.47,Default,,0,0,0,,Từ đôi môi của một nữ tiếp viên\Nđã chẳng còn biết đến tình yêu là gì,
Dialogue: 0,0:13:00.76,0:13:11.90,Default,,0,0,0,,{\i1}chú mèo lặng lẽ lắng nghe,\Ncuộn tròn trong vòng tay ấm áp trên đùi nàng.{\i0}
Dialogue: 0,0:13:12.60,0:13:23.93,Default,,0,0,0,,Nàng ngân nga những lời van nài xưa cũ\Ncủa những người đàn ông đi qua đời mình.
Dialogue: 0,0:13:24.93,0:13:30.51,Default,,0,0,0,,Lang thang giữa màn đêm Shinjuku,
Dialogue: 0,0:13:30.62,0:13:35.56,Default,,0,0,0,,chính là chú mèo hoang cô độc.
Dialogue: 0,0:13:35.68,0:13:39.51,Default,,0,0,0,,Hôm nay chương trình xin giới thiệu nữ ca sĩ đang gây sốt\Nvới bản hit 'Mèo Hoang', cô Chidori Miyuki.
Dialogue: 0,0:13:39.62,0:13:42.25,Default,,0,0,0,,- Chào mừng cô đến với chương trình.\N- Xin cảm ơn và rất hân hạnh được gặp quý vị.
Dialogue: 0,0:13:49.55,0:13:51.60,Default,,0,0,0,,~ Ca khúc 'Mèo Hoang' của Chidori Miyuki ~\NĐạt mốc 100.000 bản tiêu thụ
Dialogue: 0,0:13:51.66,0:14:02.91,Default,,0,0,0,,Giữa dòng đời thường nhật phù du,
Dialogue: 0,0:14:03.86,0:14:14.53,Default,,0,0,0,,{\i1}Những ký ức buồn thương cứ thế chất chồng.{\i0}
Dialogue: 0,0:14:04.76,0:14:12.53,Default,,0,0,0,,~ Chidori Miyuki - 5 tuần liên tiếp giữ ngôi Quán quân ~
Dialogue: 0,0:14:15.84,0:14:21.38,Default,,0,0,0,,{\i1}Trao trọn cả tấm thân và tâm hồn...{\i0}
Dialogue: 0,0:14:15.84,0:14:18.88,Default,,0,0,0,,À, anh đến rồi đấy à? Chờ tôi một lát nhé.
Dialogue: 0,0:14:18.99,0:14:21.95,Default,,0,0,0,,- Anh ấy đang đợi ở bãi đỗ xe.\N- Vâng.
Dialogue: 0,0:14:21.84,0:14:27.33,Default,,0,0,0,,{\i1}Cho một người đàn ông dối gian...{\i0}
Dialogue: 0,0:14:28.07,0:14:33.38,Default,,0,0,0,,{\i1}Lang thang khắp những con phố Shinjuku{\i0}
Dialogue: 0,0:14:28.47,0:14:33.78,Default,,0,0,0,,Em cũng chẳng biết phải nói sao,\Nchỉ biết nỗ lực hết mình trong hiện tại thôi ạ.
Dialogue: 0,0:14:33.73,0:14:39.73,Default,,0,0,0,,{\i1}Là chú mèo hoang cô độc...{\i0}
Dialogue: 0,0:14:39.84,0:14:45.53,Default,,0,0,0,,{\i1}Giờ đây tôi đã quen với nỗi đợi chờ{\i0}
Dialogue: 0,0:14:40.64,0:14:44.13,Default,,0,0,0,,Chidori Miyuki\NGóp mặt trong Đại nhạc hội Đỏ Trắng (Kohaku Uta Gassen)
Dialogue: 0,0:14:44.65,0:14:49.83,Default,,0,0,0,,- Là Đại nhạc hội Đỏ Trắng cuối năm đấy!\N- Con bé giỏi thật sự.
Dialogue: 0,0:14:45.65,0:14:50.93,Default,,0,0,0,,{\i1}Với một người phụ nữ...{\i0}
Dialogue: 0,0:14:51.64,0:15:02.88,Default,,0,0,0,,{\i1}Tình yêu là địa ngục trần gian dẫu có nhấn chìm trong men rượu{\i0}
Dialogue: 0,0:15:04.04,0:15:11.63,Default,,0,0,0,,{\i1}Ánh đèn neon ướt đẫm mưa đêm lập lòe trong bóng tối{\i0}
Dialogue: 0,0:17:02.29,0:17:05.77,Default,,0,0,0,,{\i1}Lần cuối cùng cô bé ấy\Nghé thăm quán ăn của tôi...{\i0}
Dialogue: 0,0:17:05.89,0:17:09.75,Default,,0,0,0,,{\i1}là vào khoảng một tháng trước khi cô ấy qua đời.{\i0}
Dialogue: 0,0:17:38.64,0:17:40.28,Default,,0,0,0,,Miyuki-chan...
Dialogue: 0,0:17:42.58,0:17:46.34,Default,,0,0,0,,Quán mình còn cá ngừ bào katsuobushi không Ông chủ?
Dialogue: 0,0:18:02.75,0:18:04.32,Default,,0,0,0,,Mời cháu dùng bữa.
Dialogue: 0,0:18:27.56,0:18:30.40,Default,,0,0,0,,Hương vị này đúng là...
Dialogue: 0,0:18:36.00,0:18:38.01,Default,,0,0,0,,Ông chủ ơi.
Dialogue: 0,0:18:39.04,0:18:41.14,Default,,0,0,0,,Cháu cảm ơn Ông chủ nhiều lắm.
Dialogue: 0,0:18:41.68,0:18:44.45,Default,,0,0,0,,Hử? Cảm ơn vì chuyện gì cơ?
Dialogue: 0,0:18:45.44,0:18:49.92,Default,,0,0,0,,Nếu ngày ấy cháu không tình cờ bước vào quán ăn này,
Dialogue: 0,0:18:50.75,0:18:55.48,Default,,0,0,0,,thì có lẽ cả đời này cháu đã chẳng bao giờ\Ncó cơ hội được nếm trải niềm hạnh phúc lớn lao đến nhường ấy.
Dialogue: 0,0:18:56.07,0:18:59.67,Default,,0,0,0,,Không lời nào có thể diễn tả hết\Nlòng biết ơn của cháu dành cho Ông chủ.
Dialogue: 0,0:19:09.60,0:19:13.02,Default,,0,0,0,,Hay là cháu cũng làm một điếu nhé?
Dialogue: 0,0:19:13.78,0:19:15.27,Default,,0,0,0,,Cháu hút thuốc được sao?
Dialogue: 0,0:19:15.39,0:19:17.15,Default,,0,0,0,,Dạ được.
Dialogue: 0,0:19:25.96,0:19:28.54,Default,,0,0,0,,Bia không được lạnh lắm.\NCháu uống tạm có sao không?
Dialogue: 0,0:19:28.95,0:19:30.51,Default,,0,0,0,,Dạ không sao đâu ạ.
Dialogue: 0,0:19:52.78,0:19:55.06,Default,,0,0,0,,Cháu còn nhớ bác Chu chứ?
Dialogue: 0,0:19:55.17,0:19:57.50,Default,,0,0,0,,Cái bác đội mũ mua đĩa CD đầu tiên của cháu ấy.
Dialogue: 0,0:19:57.80,0:20:01.90,Default,,0,0,0,,Bác ấy cứ nhắc mãi là lần tới gặp cháu\Nnhất định phải xin bằng được chữ ký của cháu,
Dialogue: 0,0:20:02.01,0:20:05.13,Default,,0,0,0,,nên ngại quá, phiền cháu ký tặng\Nbác ấy một tấm được không...
Dialogue: 0,0:20:22.87,0:20:27.27,Default,,0,0,0,,~ Hôm nay quán nghỉ ~
Dialogue: 0,0:20:32.73,0:20:35.44,Default,,0,0,0,,Tôi chẳng bao giờ ngờ được chuyện đau lòng ấy lại ập đến\Nvới một người đang trên đỉnh cao danh vọng như cô bé.
Dialogue: 0,0:20:35.58,0:20:39.85,Default,,0,0,0,,Miyuki-chan thực sự đã tỏa sáng rực rỡ.
Dialogue: 0,0:20:41.35,0:20:44.21,Default,,0,0,0,,Cô bé mãi mãi là Miyuki-chan của quán ăn nhỏ này.
Dialogue: 0,0:20:44.32,0:20:47.08,Default,,0,0,0,,Cô bé mà tất cả chúng ta từng yêu mến...
Dialogue: 0,0:20:48.71,0:20:50.73,Default,,0,0,0,,Mặc dòng đời đưa đẩy.
Dialogue: 0,0:20:50.75,0:20:54.10,Default,,0,0,0,,Mặc số phận cuốn trôi đời bạn về đâu.
Dialogue: 0,0:20:54.21,0:20:58.98,Default,,0,0,0,,Từ những năm tháng ấu thơ\Ncho đến khi khôn lớn trưởng thành...
Dialogue: 0,0:20:59.81,0:21:03.58,Default,,0,0,0,,cuộc đời quả thực cứ trôi theo\Ndòng chảy của số phận.
Dialogue: 0,0:21:05.42,0:21:07.44,Default,,0,0,0,,Đó là một bài hát có giai điệu thật kỳ lạ,
Dialogue: 0,0:21:07.54,0:21:10.63,Default,,0,0,0,,nhưng lại hợp với Miyuki-chan đến lạ kỳ.
Dialogue: 0,0:21:12.92,0:21:17.90,Default,,0,0,0,,Nghe nói sáng sớm nay ở quán\Ncó chuyện gì kỳ lạ lắm hả Ông chủ?
Dialogue: 0,0:21:20.08,0:21:24.05,Default,,0,0,0,,~ Ca sĩ Chidori Miyuki ~\NKiên Cường Chống Chọi Bệnh Tật Cho Đến Phút Lâm Chung
Dialogue: 0,0:22:03.75,0:22:05.47,Default,,0,0,0,,Miyuki-chan.
Dialogue: 0,0:22:12.23,0:22:15.20,Default,,0,0,0,,Mừng cháu đã về thăm quán.
Dialogue: 0,0:22:20.51,0:22:24.22,Default,,0,0,0,,~ Còn tiếp ~
Dialogue: 0,0:22:30.34,0:22:33.36,Default,,0,0,0,,Với món cá ngừ bào katsuobushi,\Nngon nhất vẫn là tự tay bào trực tiếp từ khúc cá khô.
Dialogue: 0,0:22:33.47,0:22:36.65,Default,,0,0,0,,Nhưng thời buổi bây giờ chắc chẳng mấy ai\Ncòn dịp tự tay bào cá nữa nhỉ?
Dialogue: 0,0:22:37.58,0:22:39.86,Default,,0,0,0,,Các bạn nhìn lớp cá bào bông tơi này xem!
Dialogue: 0,0:23:02.56,0:23:03.48,Default,,0,0,0,,Biết ngay mà!
Dialogue: 0,0:23:03.59,0:23:05.40,Default,,0,0,0,,Làm theo cách này đúng là ngon tuyệt đỉnh.
Dialogue: 0,0:23:05.49,0:23:07.38,Default,,0,0,0,,Chúc mọi người ngủ ngon nhé.
Dialogue: 0,0:23:07.79,0:23:12.38,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:23:07.79,0:23:12.38,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:23:16.52,0:23:20.31,Default,,0,0,0,,~ Diễn viên chính ~\NKOBAYASHI Kaoru\Nvai Ông chủ
Dialogue: 0,0:23:20.80,0:23:24.53,Default,,0,0,0,,TABATA Tomoko\Nvai Chidori Miyuki
Dialogue: 0,0:23:25.23,0:23:26.71,Default,,0,0,0,,SUDO Risa\Nvai Miki
Dialogue: 0,0:23:26.96,0:23:28.95,Default,,0,0,0,,KOBAYASHI Asako\Nvai Rumi
Dialogue: 0,0:23:29.33,0:23:31.28,Default,,0,0,0,,YOSHIMOTO Naoko\Nvai Kana
Dialogue: 0,0:23:36.68,0:23:40.41,Default,,0,0,0,,cùng sự góp mặt của ODAGIRI Jo
Dialogue: 0,0:23:40.71,0:24:00.41,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NBiên tập & Căn chỉnh: Amtia(NOFACE)
Dialogue: 0,0:24:26.52,0:24:33.79,Default,,0,0,0,,~ Trong tập tiếp theo của ~\NQUÁN ĂN ĐÊM (SHINYA SHOKUDO)
Dialogue: 0,0:24:35.00,0:24:36.45,Default,,0,0,0,,- Mận muối. - Cá hồi. - Trứng cá tuyết.
Dialogue: 0,0:24:36.80,0:24:38.17,Default,,0,0,0,,Chị em chúng ta chỉ theo đuổi tình yêu thuần khiết và trong sáng!
Dialogue: 0,0:24:38.28,0:24:40.45,Default,,0,0,0,,Đi xem mắt ư?\NChơi thế là ăn gian đấy nhé!
Dialogue: 0,0:24:40.64,0:24:43.66,Default,,0,0,0,,Nghe đồn nàng Cá Hồi\Nđang cặp kè với bồ cũ của nàng Mận Muối đấy.
Dialogue: 0,0:24:43.74,0:24:45.91,Default,,0,0,0,,Vậy ra trên đời này làm gì có tình bạn thực sự giữa phụ nữ với nhau?
Dialogue: 0,0:24:46.00,0:24:47.64,Default,,0,0,0,,Chắc chắn cậu sẽ tìm được người đàn ông\Ntrong mộng của mình mà!
Dialogue: 0,0:24:47.75,0:24:49.41,Default,,0,0,0,,Đúng không nào?!
Dialogue: 0,0:24:50.12,0:24:52.65,Default,,0,0,0,,~ Con mèo nhà tôi có vẻ duyệt món cơm mèo nekomanma này,\Nnên chắc chắn là phải ngon rồi ~
Dialogue: 0,0:24:52.86,0:24:55.20,Default,,0,0,0,,~ Mà nghĩ đi nghĩ lại, cái thằng mèo béo ú đó\Nthì cái giống gì nó chả tống vào mồm ~
Dialogue: 0,0:24:55.53,0:24:58.20,Default,,0,0,0,,~ Chuyện con mèo béo là thật 100% đấy.\NCòn bộ phim này mới là hư cấu nhé ~
