Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:00:00.00,0:00:02.21,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:00:02.31,0:00:05.42,Default,,0,0,0,,{\i1}Ca khúc mở đầu\NOmohide (Hoài Niệm) - Trình bày: Suzuki Tsunekichi{\i0}
Dialogue: 0,0:00:06.66,0:00:10.20,Default,,0,0,0,,{\i1}DIỄN VIÊN CHÍNH\NKobayashi Kaoru{\i0}
Dialogue: 0,0:00:12.67,0:00:16.28,Default,,0,0,0,,{\i1}Ayata Toshiki{\i0}
Dialogue: 0,0:00:18.75,0:00:22.11,Default,,0,0,0,,{\i1}Ando Tamae{\i0}
Dialogue: 0,0:00:24.71,0:00:28.24,Default,,0,0,0,,{\i1}Matsushige Yutaka{\i0}
Dialogue: 0,0:00:26.51,0:00:31.14,Default,,0,0,0,,{\i1}kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra{\i0}
Dialogue: 0,0:00:30.69,0:00:34.24,Default,,0,0,0,,{\i1}Đạo diễn: Matsuoka Joji{\i0}
Dialogue: 0,0:00:31.39,0:00:36.24,Default,,0,0,0,,{\i1}ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió{\i0}
Dialogue: 0,0:00:36.52,0:00:41.51,Default,,0,0,0,,{\i1}sora ni ukabu kumo no naka ni\NRồi từng chút một tan biến dần{\i0}
Dialogue: 0,0:00:41.69,0:00:46.78,Default,,0,0,0,,{\i1}sukoshi zutsu kie te yuku\NVào tầng mây trôi bồng bềnh trên cao{\i0}
Dialogue: 0,0:00:46.93,0:00:51.67,Default,,0,0,0,,{\i1}tooku takai sora no naka de\NTừ giữa bầu trời cao vời vợi{\i0}
Dialogue: 0,0:00:51.84,0:00:56.46,Default,,0,0,0,,{\i1}te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em{\i0}
Dialogue: 0,0:00:56.77,0:01:01.67,Default,,0,0,0,,{\i1}kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra{\i0}
Dialogue: 0,0:01:01.89,0:01:06.96,Default,,0,0,0,,{\i1}pokkari to ukan de iru\NRồi lững lờ trôi giữa không trung{\i0}
Dialogue: 0,0:01:07.74,0:01:17.45,Default,,0,0,0,,{\i1}zutto mukashi no koto no you da ne\NNgỡ như một ký ức từ thuở xa xôi{\i0}
Dialogue: 0,0:01:17.77,0:01:26.68,Default,,0,0,0,,{\i1}kawamo no ue o kumo ga nagareru\NBóng mây lững lờ trôi trên mặt sông{\i0}
Dialogue: 0,0:01:28.00,0:01:34.07,Default,,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)\NQuán Ăn Đêm - Shinya Shokudō
Dialogue: 0,0:01:46.24,0:01:48.17,Default,,0,0,0,,{\i1}Khi người ta kết thúc một ngày,{\i0}
Dialogue: 0,0:01:48.30,0:01:51.69,Default,,0,0,0,,{\i1}và vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:51.86,0:01:54.42,Default,,0,0,0,,{\i1}thì một ngày của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:54.67,0:01:56.40,Default,,0,0,0,,~ Súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly
Dialogue: 0,0:01:56.62,0:01:58.87,Default,,0,0,0,,{\i1}Thực đơn của tôi chỉ có vỏn vẹn chừng đó.{\i0}
Dialogue: 0,0:01:58.96,0:02:01.52,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì,{\i0}
Dialogue: 0,0:02:01.84,0:02:04.15,Default,,0,0,0,,{\i1}chỉ cần làm được là tôi đều sẽ nấu.{\i0}
Dialogue: 0,0:02:04.28,0:02:06.97,Default,,0,0,0,,{\i1}Phương châm làm việc của tôi là vậy.{\i0}
Dialogue: 0,0:02:07.59,0:02:12.96,Default,,0,0,0,,{\i1}Quán mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:02:13.24,0:02:14.32,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:02:14.42,0:02:17.25,Default,,0,0,0,,{\i1}'Quán Ăn Đêm'.{\i0}
Dialogue: 0,0:02:17.71,0:02:19.41,Default,,0,0,0,,{\i1}Bạn hỏi liệu có khách khứa nào ghé không ư?{\i0}
Dialogue: 0,0:02:19.83,0:02:22.78,Default,,0,0,0,,{\i1}Thực ra là đông hơn bạn tưởng đấy.{\i0}
Dialogue: 0,0:02:24.46,0:02:27.35,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:02:27.66,0:02:32.80,Default,,0,0,0,,Tập 1\NXúc xích đỏ & Trứng cuộn Tamagoyaki
Dialogue: 0,0:02:43.06,0:02:44.67,Default,,0,0,0,,Mà này...
Dialogue: 0,0:02:44.77,0:02:47.60,Default,,0,0,0,,Ông chủ có làm được món gì khác\Nngoài suất súp Tonjiru* truyền thống không?
Dialogue: 0,0:02:44.77,0:02:47.60,Default,,0,0,0,,{\i1}(*Súp miso nấu thịt heo và rau củ){\i0}
Dialogue: 0,0:02:47.88,0:02:49.91,Default,,0,0,0,,Kiểu như thịt heo xào gừng (shogayaki) chẳng hạn.
Dialogue: 0,0:02:50.28,0:02:52.21,Default,,0,0,0,,À... được chứ.
Dialogue: 0,0:02:52.31,0:02:53.84,Default,,0,0,0,,Vậy cho tôi gọi món đó nhé.
Dialogue: 0,0:02:54.29,0:02:55.56,Default,,0,0,0,,Có ngay đây.
Dialogue: 0,0:02:59.29,0:03:00.56,Default,,0,0,0,,Ông chủ ơi.
Dialogue: 0,0:03:00.68,0:03:01.82,Default,,0,0,0,,Em về rồi đây.
Dialogue: 0,0:03:03.24,0:03:05.46,Default,,0,0,0,,Ồ... Em về nước rồi đấy à?
Dialogue: 0,0:03:05.80,0:03:07.83,Default,,0,0,0,,Chuyến đi Ma Cao thế nào rồi?
Dialogue: 0,0:03:08.04,0:03:10.65,Default,,0,0,0,,Giám đốc bên đó cứ nằng nặc\Ngiữ em ở lại thêm ít hôm,
Dialogue: 0,0:03:12.14,0:03:15.00,Default,,0,0,0,,nhưng em đã tìm thấy\Nngười đàn ông của đời mình rồi!
Dialogue: 0,0:03:17.38,0:03:19.06,Default,,0,0,0,,Lại là người Nhật hả?
Dialogue: 0,0:03:19.86,0:03:21.61,Default,,0,0,0,,Anh ấy làm chia bài ở sòng bạc.
Dialogue: 0,0:03:21.75,0:03:24.67,Default,,0,0,0,,Mọi người biết đấy, tay anh ấy\Ntráo bài điêu luyện cực kỳ luôn.
Dialogue: 0,0:03:25.34,0:03:28.67,Default,,0,0,0,,Ngẫm lại thì bạn trai cũ của em\Nlà nghệ sĩ dương cầm nhỉ?
Dialogue: 0,0:03:28.75,0:03:29.95,Default,,0,0,0,,Đàn ông ấy mà,
Dialogue: 0,0:03:30.08,0:03:32.63,Default,,0,0,0,,quan trọng nhất là phải biết\Ndùng đôi bàn tay thật khéo léo.
Dialogue: 0,0:03:33.34,0:03:35.82,Default,,0,0,0,,{\i1}Cô bé này tên là Marilyn.{\i0}
Dialogue: 0,0:03:35.93,0:03:38.44,Default,,0,0,0,,{\i1}Bằng những vũ điệu mà cô nàng gọi là 'khiêu vũ',{\i0}
Dialogue: 0,0:03:38.58,0:03:42.18,Default,,0,0,0,,{\i1}cô ấy luôn làm mê đắm các khách quen của tôi\Nvới tư cách là vũ nữ thoát y hàng đầu{\i0}
Dialogue: 0,0:03:42.29,0:03:44.67,Default,,0,0,0,,{\i1}tại hộp đêm New Art ở Shinjuku.{\i0}
Dialogue: 0,0:03:45.41,0:03:48.35,Default,,0,0,0,,{\i1}(*trứng cá tuyết muối\N**rượu chưng cất Nhật Bản){\i0}
Dialogue: 0,0:03:45.41,0:03:48.35,Default,,0,0,0,,Ông chủ, cho em một phần trứng cá tuyết tarako*\Nvà thêm ly rượu shochu** nữa nhé.
Dialogue: 0,0:03:48.46,0:03:50.19,Default,,0,0,0,,Em có muốn nướng trứng cá tuyết lên không?
Dialogue: 0,0:03:50.29,0:03:52.12,Default,,0,0,0,,Dạ có... Nướng tái vừa (medium rare) thôi nhé.
Dialogue: 0,0:03:55.60,0:03:58.16,Default,,0,0,0,,{\i1}Vì nàng Marilyn của chúng ta rất dễ rơi vào lưới tình,{\i0}
Dialogue: 0,0:03:58.27,0:04:00.35,Default,,0,0,0,,{\i1}nên cô nàng có thói quen\Nbắt chước theo người tình mới...{\i0}
Dialogue: 0,0:04:00.41,0:04:02.77,Default,,0,0,0,,{\i1}từ thói quen cho đến khẩu vị ăn uống.{\i0}
Dialogue: 0,0:04:11.04,0:04:13.04,Default,,0,0,0,,Háo hức quá đi!
Dialogue: 0,0:04:45.03,0:04:46.42,Default,,0,0,0,,Marilyn-chan!
Dialogue: 0,0:04:47.03,0:04:48.79,Default,,0,0,0,,Màn trình diễn tuyệt lắm!
Dialogue: 0,0:04:48.91,0:04:50.53,Default,,0,0,0,,Xem chừng anh người yêu mới của cổ...
Dialogue: 0,0:04:50.63,0:04:54.07,Default,,0,0,0,,mê món trứng cá tuyết nướng tái lắm đây.
Dialogue: 0,0:04:56.17,0:04:57.37,Default,,0,0,0,,Của em đây.
Dialogue: 0,0:04:57.49,0:04:59.51,Default,,0,0,0,,Chín tái vừa đúng ý nhé.
Dialogue: 0,0:05:00.49,0:05:02.26,Default,,0,0,0,,Ngon tuyệt cú mèo!
Dialogue: 0,0:05:11.19,0:05:14.22,Default,,0,0,0,,Tuyệt thật...
Dialogue: 0,0:05:15.50,0:05:19.54,Default,,0,0,0,,Em đã bảo mà, trứng cá tuyết\Nnướng tái vừa là ngon nhất trần đời.
Dialogue: 0,0:05:24.05,0:05:25.86,Default,,0,0,0,,Cảm ơn Ông chủ vì bữa ăn...\NChúc cả nhà ngủ ngon nhé!
Dialogue: 0,0:05:38.84,0:05:40.14,Default,,0,0,0,,Chào Ông chủ.
Dialogue: 0,0:05:51.16,0:05:53.50,Default,,0,0,0,,Ồ... lâu lắm mới thấy anh ghé.
Dialogue: 0,0:05:53.94,0:05:55.47,Default,,0,0,0,,Cho như mọi khi.
Dialogue: 0,0:05:55.92,0:05:57.12,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:05:58.93,0:06:02.05,Default,,0,0,0,,{\i1}Cậu Ryu đây khá có tiếng\Nở khu vực quanh đây.{\i0}
Dialogue: 0,0:06:03.16,0:06:07.43,Default,,0,0,0,,{\i1}Dù ấn tượng đầu tiên về cậu ta\Nphải nói là tệ kinh khủng!{\i0}
Dialogue: 0,0:06:08.19,0:06:12.92,Default,,0,0,0,,{\i1}Chắc là vào khoảng...\Nkhông lâu sau khi tôi mới mở quán.{\i0}
Dialogue: 0,0:06:21.26,0:06:23.51,Default,,0,0,0,,Đáng nể thật đấy.
Dialogue: 0,0:06:24.62,0:06:26.51,Default,,0,0,0,,Nếu tôi không chốt được hợp đồng với khách,
Dialogue: 0,0:06:26.61,0:06:29.17,Default,,0,0,0,,thì chỉ còn nước đi cọ nhà vệ sinh thôi...
Dialogue: 0,0:06:29.26,0:06:31.07,Default,,0,0,0,,Làm mãi rồi cũng thành quen cả ấy mà.
Dialogue: 0,0:06:32.72,0:06:34.76,Default,,0,0,0,,Cậu có muốn ăn thử cá thu chiên không?
Dialogue: 0,0:06:34.89,0:06:36.60,Default,,0,0,0,,Ơ, nhưng tôi định...
Dialogue: 0,0:06:36.88,0:06:40.45,Default,,0,0,0,,Món làm thử vị thôi,\Ntôi mời cậu đấy, không tính tiền đâu.
Dialogue: 0,0:06:40.67,0:06:42.70,Default,,0,0,0,,Vậy tôi xin nhận nhé!
Dialogue: 0,0:06:55.27,0:06:58.18,Default,,0,0,0,,Cái quái gì thế...\NCứu tôi với Ông chủ ơi!
Dialogue: 0,0:07:00.61,0:07:02.04,Default,,0,0,0,,Chỗ này đấy hả?
Dialogue: 0,0:07:02.13,0:07:05.13,Default,,0,0,0,,Cái quán mà khách gọi món gì\Ncũng nấu được hết ấy?
Dialogue: 0,0:07:10.00,0:07:11.99,Default,,0,0,0,,- Mày...\N- Á...
Dialogue: 0,0:07:12.07,0:07:13.78,Default,,0,0,0,,Em cũng vừa tính\Nquay về quán làm việc đây ạ...
Dialogue: 0,0:07:17.46,0:07:19.58,Default,,0,0,0,,Này ông già* (Oyaji).\N(*cách gọi người đàn ông trung niên)
Dialogue: 0,0:07:24.86,0:07:26.57,Default,,0,0,0,,Ốc sên Pháp nướng bơ tỏi (Escargot).
Dialogue: 0,0:07:31.28,0:07:32.99,Default,,0,0,0,,Tôi chịu, không làm được.
Dialogue: 0,0:07:33.23,0:07:34.59,Default,,0,0,0,,Thế...
Dialogue: 0,0:07:34.71,0:07:36.74,Default,,0,0,0,,Súp tổ yến thì sao?
Dialogue: 0,0:07:37.31,0:07:40.09,Default,,0,0,0,,Quán tôi không có mấy thứ cao lương mỹ vị đắt đỏ đó đâu.
Dialogue: 0,0:07:40.18,0:07:43.82,Default,,0,0,0,,Cái quái gì thế hả?\NRốt cuộc ông nấu được cái giống gì?!
Dialogue: 0,0:07:50.09,0:07:53.18,Default,,0,0,0,,Thế quán có xúc xích không?
Dialogue: 0,0:07:54.28,0:07:57.00,Default,,0,0,0,,Loại xúc xích đỏ ấy.
Dialogue: 0,0:07:59.57,0:08:01.21,Default,,0,0,0,,Có chứ.
Dialogue: 0,0:08:01.67,0:08:04.77,Default,,0,0,0,,Anh có muốn tôi khía nó\Nthành hình con bạch tuộc luôn không?
Dialogue: 0,0:08:54.12,0:08:55.92,Default,,0,0,0,,Hết bao nhiêu tiền?
Dialogue: 0,0:08:58.43,0:09:01.16,Default,,0,0,0,,Nếu tính gộp cả hóa đơn\Ncủa cậu thanh niên vừa chạy mất lúc nãy...
Dialogue: 0,0:09:01.50,0:09:03.31,Default,,0,0,0,,Tổng cộng 2.000 yên.
Dialogue: 0,0:09:03.40,0:09:04.81,Default,,0,0,0,,Hả?!
Dialogue: 0,0:09:07.57,0:09:10.08,Default,,0,0,0,,Sao đại ca lại phải\Ntrả tiền cho cả thằng đó chứ?
Dialogue: 0,0:09:10.47,0:09:12.25,Default,,0,0,0,,Giá cả cái quán này kiểu quái gì thế?
Dialogue: 0,0:09:12.37,0:09:14.13,Default,,0,0,0,,Khỏi thối lại.
Dialogue: 0,0:09:18.77,0:09:20.75,Default,,0,0,0,,Bảo khỏi thối lại mà.
Dialogue: 0,0:09:25.61,0:09:27.18,Default,,0,0,0,,Kể từ sau ngày hôm đó,
Dialogue: 0,0:09:27.30,0:09:31.58,Default,,0,0,0,,cậu Ryu cứ ghé quán liên tục\Nvới tần suất đáng kinh ngạc.
Dialogue: 0,0:09:40.30,0:09:41.83,Default,,0,0,0,,Mời dùng bữa.
Dialogue: 0,0:09:50.65,0:09:52.93,Default,,0,0,0,,Trông ngon mắt ghê.
Dialogue: 0,0:09:57.96,0:09:59.88,Default,,0,0,0,,{\i1}Nhân vật kỳ lạ vừa mới\Nxông thẳng vào quán...{\i0}
Dialogue: 0,0:10:00.09,0:10:02.05,Default,,0,0,0,,{\i1}đã kiên định bước trên con đường đồng tính\Nsuốt 48 năm cuộc đời,{\i0}
Dialogue: 0,0:10:02.50,0:10:04.24,Default,,0,0,0,,{\i1}hiện đang làm chủ một quán gay bar ở cuối phố,{\i0}
Dialogue: 0,0:10:04.33,0:10:06.42,Default,,0,0,0,,{\i1}chị Kosuzu.{\i0}
Dialogue: 0,0:10:11.82,0:10:13.75,Default,,0,0,0,,Cho tôi xin một miếng nhé?!
Dialogue: 0,0:10:14.86,0:10:17.09,Default,,0,0,0,,Xin mời dùng tự nhiên!
Dialogue: 0,0:10:25.65,0:10:28.18,Default,,0,0,0,,Cái hương vị hoài cổ này đúng là...
Dialogue: 0,0:10:34.11,0:10:35.81,Default,,0,0,0,,Này chàng trai trẻ.
Dialogue: 0,0:10:37.01,0:10:39.43,Default,,0,0,0,,Ăn không của cậu thì tôi cũng ngại lắm,
Dialogue: 0,0:10:39.54,0:10:41.77,Default,,0,0,0,,hay là để tôi mời lại cậu món trứng cuộn tamagoyaki* nhé?\N(*trứng cuộn kiểu Nhật)
Dialogue: 0,0:10:41.87,0:10:44.22,Default,,0,0,0,,Mà tôi cũng lỡ nếm trước một miếng rồi.
Dialogue: 0,0:10:51.05,0:10:52.32,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:10:52.42,0:10:54.09,Default,,0,0,0,,Không có chi đâu mà.
Dialogue: 0,0:11:09.82,0:11:11.96,Default,,0,0,0,,Tôi ấy à...
Dialogue: 0,0:11:12.06,0:11:16.93,Default,,0,0,0,,vốn chúa ghét mấy gã Yakuza,
Dialogue: 0,0:11:20.47,0:11:23.47,Default,,0,0,0,,nhưng riêng cậu thì lại khác.
Dialogue: 0,0:11:23.97,0:11:26.32,Default,,0,0,0,,Bản thân tôi cũng chẳng ưa gì mấy người okama* đâu.
Dialogue: 0,0:11:23.97,0:11:26.32,Default,,0,0,0,,{\i1}(*nghĩa đen là cái nồi, tiếng lóng chỉ người đồng tính nam,\Nnguồn gốc từ thời Edo){\i0}
Dialogue: 0,0:11:26.48,0:11:30.67,Default,,0,0,0,,Ứ ừ... Cậu nói năng cái kiểu gì thế hả?\NĐúng là đồ chảnh chọe...
Dialogue: 0,0:11:31.80,0:11:34.19,Default,,0,0,0,,Thế rốt cuộc là có sao không hả?!
Dialogue: 0,0:11:39.32,0:11:41.45,Default,,0,0,0,,Cảnh này không phải ngày nào cũng được thấy đâu.
Dialogue: 0,0:11:41.56,0:11:44.98,Default,,0,0,0,,Không ngờ chị Kosuzu lại thành ra mê mệt như thế.
Dialogue: 0,0:11:49.81,0:11:53.94,Default,,0,0,0,,{\i1}~ Khu phố Shinjuku Golden Gai ~{\i0}
Dialogue: 0,0:12:22.86,0:12:23.83,Default,,0,0,0,,Của chị đây.
Dialogue: 0,0:12:23.92,0:12:25.48,Default,,0,0,0,,Trứng cuộn tamagoyaki của chị đây.
Dialogue: 0,0:12:25.94,0:12:27.59,Default,,0,0,0,,Ái chà... Có rồi, có rồi đây!
Dialogue: 0,0:12:28.04,0:12:30.79,Default,,0,0,0,,Ôi... cái hương vị ngọt ngào này...
Dialogue: 0,0:12:31.60,0:12:33.91,Default,,0,0,0,,Bác có muốn thử một miếng không?
Dialogue: 0,0:12:34.30,0:12:36.22,Default,,0,0,0,,Ngọt thế tôi ăn vào tiểu đường mất.
Dialogue: 0,0:12:36.32,0:12:39.07,Default,,0,0,0,,Nói cho chị biết, tôi chỉ ăn được\Ntrứng cuộn vị mặn đậm đà,
Dialogue: 0,0:12:39.35,0:12:41.89,Default,,0,0,0,,cho thật nhiều nước dùng tảo bẹ (dashi)\Nvào thôi nhé.
Dialogue: 0,0:12:42.00,0:12:43.22,Default,,0,0,0,,Ông đúng là chẳng biết gì...
Dialogue: 0,0:12:43.33,0:12:47.20,Default,,0,0,0,,Làm kiểu đó đâu gọi là tamagoyaki nữa,\Nđó là trứng cuộn nước dùng dashimaki rồi.
Dialogue: 0,0:12:52.10,0:12:53.97,Default,,0,0,0,,Ngọt dịu và ngon làm sao!
Dialogue: 0,0:12:54.08,0:12:55.56,Default,,0,0,0,,Hai món đó thì khác gì nhau chứ?
Dialogue: 0,0:12:55.68,0:12:58.05,Default,,0,0,0,,Ăn ở tiệm sushi,\Nngười ta gọi là tamagoyaki.
Dialogue: 0,0:12:58.18,0:13:00.63,Default,,0,0,0,,Còn vào quán mì soba,\Nngười ta lại gọi là dashimaki.
Dialogue: 0,0:13:00.74,0:13:02.73,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:13:03.28,0:13:06.27,Default,,0,0,0,,Mà công nhận chị Kosuzu\Nmê món trứng cuộn ngọt này thật đấy.
Dialogue: 0,0:13:06.67,0:13:08.67,Default,,0,0,0,,Chắc ăn cho đẹp da chứ gì?!
Dialogue: 0,0:13:08.80,0:13:10.53,Default,,0,0,0,,Đâu phải vì lý do đó chứ!
Dialogue: 0,0:13:10.66,0:13:14.06,Default,,0,0,0,,Hay đó là món khoái khẩu của\Nmột người tình cũ mà chị không thể nào quên?
Dialogue: 0,0:13:15.36,0:13:17.57,Default,,0,0,0,,Ai mà biết được chứ...
Dialogue: 0,0:13:39.98,0:13:41.63,Default,,0,0,0,,Chị Kosuzu này.
Dialogue: 0,0:13:41.74,0:13:43.94,Default,,0,0,0,,Chị có muốn tôi chiên thêm\Nít xúc xích đỏ không?
Dialogue: 0,0:13:44.06,0:13:45.75,Default,,0,0,0,,Thôi khỏi cần đâu.
Dialogue: 0,0:13:45.85,0:13:49.41,Default,,0,0,0,,Hôm trước bé Ryu đã cho tôi ăn thử rồi,\Nngon ra phết đấy.
Dialogue: 0,0:13:49.65,0:13:52.81,Default,,0,0,0,,Cậu Ryu cũng nói y hệt vậy\Nvề món trứng cuộn của chị đấy.
Dialogue: 0,0:13:53.63,0:13:55.72,Default,,0,0,0,,Thật hả?
Dialogue: 0,0:13:57.91,0:14:01.59,Default,,0,0,0,,Cứ tưởng tối nay cậu ấy sẽ ghé quán,
Dialogue: 0,0:14:01.98,0:14:04.30,Default,,0,0,0,,nhưng xem ra tôi lại bị cho leo cây nữa rồi.
Dialogue: 0,0:14:06.38,0:14:08.77,Default,,0,0,0,,À... Ông chủ ơi.
Dialogue: 0,0:14:08.92,0:14:10.28,Default,,0,0,0,,Phiền anh một chút,
Dialogue: 0,0:14:10.41,0:14:12.47,Default,,0,0,0,,gói giúp tôi phần trứng cuộn còn lại mang về được không?
Dialogue: 0,0:14:12.66,0:14:15.37,Default,,0,0,0,,Mấy đứa nhân viên ở quán bar\Nchắc giờ này cũng đang đói bụng.
Dialogue: 0,0:14:15.61,0:14:16.85,Default,,0,0,0,,Được thôi, có gì đâu.
Dialogue: 0,0:14:17.05,0:14:18.08,Default,,0,0,0,,Mỗi khi có đồ ăn thừa,
Dialogue: 0,0:14:18.19,0:14:20.41,Default,,0,0,0,,tôi vẫn hay mang cho con mèo hoang\Nthỉnh thoảng ghé qua đây ấy mà.
Dialogue: 0,0:14:38.44,0:14:39.82,Default,,0,0,0,,Của chị đây.
Dialogue: 0,0:14:40.05,0:14:42.51,Default,,0,0,0,,Bắt anh chuẩn bị nhiều nguyên liệu thế này...
Dialogue: 0,0:14:42.59,0:14:44.12,Default,,0,0,0,,Ngại quá đi mất.
Dialogue: 0,0:15:08.88,0:15:10.52,Default,,0,0,0,,Khi một ngày khép lại,
Dialogue: 0,0:15:10.71,0:15:13.61,Default,,0,0,0,,và dòng người hối hả trở về nhà,
Dialogue: 0,0:15:13.72,0:15:16.44,Default,,0,0,0,,đôi khi trong lòng họ\Nchợt dâng lên một nỗi bồn chồn khó tả,
Dialogue: 0,0:15:16.76,0:15:19.90,Default,,0,0,0,,thôi thúc họ muốn tìm một chốn khác\Nđể qua đêm thay vì về nhà.
Dialogue: 0,0:15:33.80,0:15:36.90,Default,,0,0,0,,Trứng cá tuyết của em nướng thế nào,\Nnướng tái vừa như mọi khi nhé?
Dialogue: 0,0:15:37.01,0:15:38.05,Default,,0,0,0,,Đừng nướng nữa Ông chủ.
Dialogue: 0,0:15:38.15,0:15:39.74,Default,,0,0,0,,Cứ để sống thế cho em ăn luôn đi.
Dialogue: 0,0:15:41.04,0:15:44.40,Default,,0,0,0,,Ơ, chẳng phải em bảo trứng cá tuyết\Nnướng tái vừa là ngon nhất sao?
Dialogue: 0,0:15:44.94,0:15:47.96,Default,,0,0,0,,Cái lão đàn ông đó\Nthì biết cái quái gì về ẩm thực chứ?
Dialogue: 0,0:15:48.45,0:15:50.46,Default,,0,0,0,,Em chia tay rồi hả?!
Dialogue: 0,0:15:50.56,0:15:52.58,Default,,0,0,0,,Với cái gã thích ăn chín tái đó ấy.
Dialogue: 0,0:15:52.69,0:15:55.72,Default,,0,0,0,,Cái tên bám váy mẹ đó hả?!\NQuên lão ta đi cho rảnh nợ.
Dialogue: 0,0:16:04.61,0:16:06.40,Default,,0,0,0,,- Cảm ơn vì bữa ăn nhé.\N- Cảm ơn nhiều.
Dialogue: 0,0:16:07.15,0:16:09.15,Default,,0,0,0,,Ồ... Cảm ơn anh nhé.
Dialogue: 0,0:16:11.51,0:16:13.61,Default,,0,0,0,,Người nào càng dễ phải lòng đàn ông gấp đôi người khác...
Dialogue: 0,0:16:13.62,0:16:15.70,Default,,0,0,0,,thì cũng sẽ mau chán họ\Nnhanh gấp đôi mà thôi.
Dialogue: 0,0:16:15.79,0:16:18.85,Default,,0,0,0,,Cứ cái đà này thì làm sao em\Ngặp được một người đàn ông tử tế đây?
Dialogue: 0,0:16:19.26,0:16:20.69,Default,,0,0,0,,Im đi, đồ bóng lộ.
Dialogue: 0,0:16:20.79,0:16:22.69,Default,,0,0,0,,Trật tự nào, con nhóc này.
Dialogue: 0,0:16:23.78,0:16:26.06,Default,,0,0,0,,Mà trứng cá tuyết để sống thế này ăn cũng ngon phết nhỉ?!
Dialogue: 0,0:16:27.62,0:16:29.15,Default,,0,0,0,,Giờ chị lại đi phải lòng cả một gã Yakuza...
Dialogue: 0,0:16:29.24,0:16:31.77,Default,,0,0,0,,Chị xuống phong độ quá đấy, bà chị ạ.
Dialogue: 0,0:16:31.92,0:16:33.48,Default,,0,0,0,,Không phải thế đâu.
Dialogue: 0,0:16:33.95,0:16:35.20,Default,,0,0,0,,Marilyn à.
Dialogue: 0,0:16:35.57,0:16:38.96,Default,,0,0,0,,Mấy chuyện yêu đương cuồng nhiệt,\Nsống chết vì tình hay đại loại thế...
Dialogue: 0,0:16:39.33,0:16:41.91,Default,,0,0,0,,Chị đây đã tốt nghiệp cái trường lớp đó\Ntừ tám đời nào rồi cưng ạ.
Dialogue: 0,0:16:43.34,0:16:45.59,Default,,0,0,0,,Chắc tại chị sống lâu\Nhơn mức cần thiết nhiều quá,
Dialogue: 0,0:16:45.68,0:16:47.86,Default,,0,0,0,,nên mới dư dả thời gian\Nđể trải sự đời thế chứ gì?!
Dialogue: 0,0:16:47.96,0:16:50.98,Default,,0,0,0,,Nhưng nếu vướng vào mấy gã Yakuza,\Ncoi chừng bị vắt kiệt cả tình lẫn tiền đấy?
Dialogue: 0,0:16:51.08,0:16:53.51,Default,,0,0,0,,Hôm nay cậu Ryu không đến nhỉ?
Dialogue: 0,0:16:53.89,0:16:56.61,Default,,0,0,0,,Chắc giờ này lại đang bận\Nđi tống tiền ai đó rồi chăng?
Dialogue: 0,0:16:56.98,0:17:00.15,Default,,0,0,0,,Cậu ấy là một người đàn ông trọng nghĩa khí đấy.
Dialogue: 0,0:17:00.28,0:17:02.37,Default,,0,0,0,,Trực giác của chị cảm nhận được điều đó.
Dialogue: 0,0:17:03.41,0:17:06.61,Default,,0,0,0,,{\i1}Người ta vẫn thường bảo,\Nđừng trông mặt mà bắt hình dong.{\i0}
Dialogue: 0,0:17:06.65,0:17:09.61,Default,,0,0,0,,Mà công nhận, chẳng phải cậu ấy hơi cao quá sao?
Dialogue: 0,0:17:14.91,0:17:17.34,Default,,0,0,0,,Vâng, thành thật xin lỗi đại ca.
Dialogue: 0,0:17:17.46,0:17:19.36,Default,,0,0,0,,Vâng... Về chuyện đó,
Dialogue: 0,0:17:19.43,0:17:22.06,Default,,0,0,0,,bọn em sẽ cố gắng thu xếp hết sức có thể...
Dialogue: 0,0:17:23.27,0:17:24.97,Default,,0,0,0,,Kenzaki!
Dialogue: 0,0:17:46.83,0:17:48.91,Default,,0,0,0,,Đau quá...
Dialogue: 0,0:17:48.98,0:17:50.07,Default,,0,0,0,,Gen.
Dialogue: 0,0:17:50.17,0:17:52.56,Default,,0,0,0,,- Mày có sao không?\N- Đau chết mất đại ca ơi!
Dialogue: 0,0:17:52.65,0:17:55.03,Default,,0,0,0,,Đau quá...
Dialogue: 0,0:18:06.37,0:18:07.76,Default,,0,0,0,,Đại ca (Aniki)!
Dialogue: 0,0:18:07.84,0:18:09.70,Default,,0,0,0,,Đại ca ơi!\NĐại ca!
Dialogue: 0,0:18:09.78,0:18:11.59,Default,,0,0,0,,Đại ca!
Dialogue: 0,0:18:13.59,0:18:15.12,Default,,0,0,0,,Thằng khốn kiếp!
Dialogue: 0,0:18:15.20,0:18:17.46,Default,,0,0,0,,Đứng lại đó!
Dialogue: 0,0:18:17.77,0:18:20.68,Default,,0,0,0,,~ Cán bộ cấp cao băng Imashiro bị đâm trọng thương ~
Dialogue: 0,0:18:21.37,0:18:22.54,Default,,0,0,0,,Phải chăng thanh trừng băng đảng lại bùng phát?
Dialogue: 0,0:18:22.61,0:18:24.84,Default,,0,0,0,,Nạn nhân - Kenzaki Ryu
Dialogue: 0,0:18:33.84,0:18:35.24,Default,,0,0,0,,Cũng may là,
Dialogue: 0,0:18:35.35,0:18:38.04,Default,,0,0,0,,vết thương không nguy hiểm đến tính mạng,
Dialogue: 0,0:18:38.15,0:18:41.86,Default,,0,0,0,,nhưng cậu Ryu sẽ phải nằm viện\Nđiều trị một thời gian.
Dialogue: 0,0:18:44.76,0:18:46.70,Default,,0,0,0,,Ông chủ à...
Dialogue: 0,0:18:46.81,0:18:49.63,Default,,0,0,0,,Tôi có chuyện này muốn nhờ anh giúp...
Dialogue: 0,0:18:57.57,0:19:00.32,Default,,0,0,0,,Ngăn thứ nhất này!
Dialogue: 0,0:19:04.70,0:19:07.09,Default,,0,0,0,,Ngăn thứ hai này!
Dialogue: 0,0:19:08.40,0:19:09.95,Default,,0,0,0,,Và...
Dialogue: 0,0:19:10.05,0:19:12.77,Default,,0,0,0,,ngăn... thứ ba!
Dialogue: 0,0:19:13.80,0:19:15.33,Default,,0,0,0,,Đúng là một bữa tiệc thịnh soạn thật đấy.
Dialogue: 0,0:19:15.42,0:19:18.18,Default,,0,0,0,,Tôi đã nhờ Ông chủ làm riêng cho cậu đấy.
Dialogue: 0,0:19:20.22,0:19:22.01,Default,,0,0,0,,Ăn tự nhiên đi nhé.
Dialogue: 0,0:19:31.90,0:19:34.14,Default,,0,0,0,,Hóa ra xúc xích đỏ\Nvà trứng cuộn tamagoyaki...
Dialogue: 0,0:19:34.24,0:19:38.09,Default,,0,0,0,,chính là hai ngôi sao sáng nhất\Ntrong mọi hộp cơm bento* nhỉ? (*cơm hộp mang đi)
Dialogue: 0,0:19:38.75,0:19:42.41,Default,,0,0,0,,Món xúc xích đỏ này có gợi lại\Ncho cậu kỷ niệm nào không?
Dialogue: 0,0:19:57.51,0:20:00.66,Default,,0,0,0,,Ai trong chúng ta cũng đều giữ\Nmột miền ký ức đặc biệt nào đó...
Dialogue: 0,0:20:00.85,0:20:03.45,Default,,0,0,0,,chôn giấu tận sâu trong tâm hồn.
Dialogue: 0,0:20:07.56,0:20:09.60,Default,,0,0,0,,Dẫu vậy,
Dialogue: 0,0:20:09.70,0:20:12.43,Default,,0,0,0,,có một ngày, tôi thực sự muốn\Nkể cho cậu nghe tất cả...
Dialogue: 0,0:20:12.53,0:20:15.95,Default,,0,0,0,,về những ký ức mà món trứng cuộn tamagoyaki\Nluôn gợi về trong tâm trí tôi.
Dialogue: 0,0:20:19.94,0:20:23.50,Default,,0,0,0,,Thật nhẹ nhõm biết bao\Nkhi cậu không mất mạng.
Dialogue: 0,0:20:23.92,0:20:26.51,Default,,0,0,0,,Nếu không có cậu trên đời này...
Dialogue: 0,0:20:27.41,0:20:29.30,Default,,0,0,0,,chắc tôi sẽ...
Dialogue: 0,0:20:32.70,0:20:34.69,Default,,0,0,0,,Tôi nghĩ ra rồi!
Dialogue: 0,0:21:11.81,0:21:14.52,Default,,0,0,0,,Chẳng phải đến giờ chị phải về rồi sao?
Dialogue: 0,0:21:14.98,0:21:17.64,Default,,0,0,0,,Tôi còn phải đi làm nữa.
Dialogue: 0,0:21:18.68,0:21:20.79,Default,,0,0,0,,Thế gian này của chúng ta...
Dialogue: 0,0:21:20.89,0:21:25.09,Default,,0,0,0,,cũng có lúc thịnh lúc suy, lúc vơi lúc đầy,\Nhệt như con nước sông Sumida vậy.
Dialogue: 0,0:21:26.36,0:21:28.76,Default,,0,0,0,,Đừng có coi thường mạng sống của mình.
Dialogue: 0,0:21:54.82,0:21:57.71,Default,,0,0,0,,Quán mình có cá ngừ bào katsuobushi* không ạ?\N(*cá ngừ xông khói sấy khô bào mỏng)
Dialogue: 0,0:21:58.34,0:22:00.62,Default,,0,0,0,,Quán tôi có đấy, nhưng...
Dialogue: 0,0:22:01.58,0:22:06.07,Default,,0,0,0,,Cháu chỉ muốn xin một ít rắc lên bát cơm nóng,\Nrồi rưới thêm chút nước tương thôi ạ.
Dialogue: 0,0:22:07.94,0:22:10.94,Default,,0,0,0,,Ý cô là món cơm mèo (nekomanma) ấy hả?
Dialogue: 0,0:22:11.76,0:22:13.17,Default,,0,0,0,,{\i1}Đó chính là...{\i0}
Dialogue: 0,0:22:13.28,0:22:16.75,Default,,0,0,0,,{\i1}lần đầu tiên cô bé ấy\Nđặt chân đến quán ăn của tôi.{\i0}
Dialogue: 0,0:22:18.51,0:22:21.83,Default,,0,0,0,,{\i1}~ Còn tiếp ~{\i0}
Dialogue: 0,0:22:25.02,0:22:26.94,Default,,0,0,0,,Mọi người ơi!
Dialogue: 0,0:22:27.39,0:22:29.80,Default,,0,0,0,,Trứng ốp la thì có vẻ\Nđơn giản dễ làm,
Dialogue: 0,0:22:29.89,0:22:32.99,Default,,0,0,0,,nhưng trứng cuộn tamagoyaki\Nlại khó hơn một chút, đúng không nào?
Dialogue: 0,0:22:33.30,0:22:35.91,Default,,0,0,0,,Dẫu vậy, các bạn đừng vội bỏ cuộc nhé.
Dialogue: 0,0:22:36.02,0:22:38.36,Default,,0,0,0,,Chúng ta cùng thử sức\Nvới thử thách này xem sao nhé?
Dialogue: 0,0:22:41.38,0:22:44.77,Default,,0,0,0,,Trải đều lớp trứng đánh tan\Nlên khắp mặt chảo,
Dialogue: 0,0:22:44.89,0:22:47.44,Default,,0,0,0,,để trứng chín vàng thật dịu.
Dialogue: 0,0:22:49.64,0:22:53.15,Default,,0,0,0,,Gấp cuộn trứng sang một bên như thế này,
Dialogue: 0,0:22:53.32,0:22:55.28,Default,,0,0,0,,đẩy phần trứng về phía trước,
Dialogue: 0,0:22:55.39,0:22:57.84,Default,,0,0,0,,rồi lại đổ thêm một lớp trứng mới vào.
Dialogue: 0,0:22:58.33,0:23:01.34,Default,,0,0,0,,Khi mặt trứng bắt đầu nổi\Nbong bóng khí thì lấy đũa chọc vỡ nhé.
Dialogue: 0,0:23:05.96,0:23:08.22,Default,,0,0,0,,Vậy nhé, hẹn gặp lại các bạn!
Dialogue: 0,0:23:08.36,0:23:10.08,Default,,0,0,0,,Chúc mọi người ngủ ngon!
Dialogue: 0,0:23:16.05,0:23:20.37,Default,,0,0,0,,Phụ đề Việt ngữ được thực hiện bởi\NAmtia(NOFACE)
Dialogue: 0,0:23:20.71,0:23:23.61,Default,,0,0,0,,Bản dịch Fansub miễn phí. Cấm sao chép thương mại!\NChúc các bạn xem phim vui vẻ.
Dialogue: 0,0:23:24.68,0:23:29.65,Default,,0,0,0,,KOBAYASHI Kaoru\N~ vai Ông chủ ~
Dialogue: 0,0:23:30.17,0:23:35.49,Default,,0,0,0,,MATSUSHIGE Yutaka\N~ vai Kenzaki Ryu ~
Dialogue: 0,0:23:35.97,0:23:40.10,Default,,0,0,0,,AYATA Toshiki\N~ vai Chị Kosuzu ~
Dialogue: 0,0:23:40.84,0:23:44.29,Default,,0,0,0,,YAMANAKA Takashi\N~ vai Gen ~
Dialogue: 0,0:23:44.82,0:23:48.07,Default,,0,0,0,,ANDO Tamae\N~ vai Marilyn ~
Dialogue: 0,0:23:49.17,0:23:53.63,Default,,0,0,0,,~ cùng sự góp mặt của ODAGIRI Jo ~
Dialogue: 0,0:23:57.69,0:24:06.91,Default,,0,0,0,,~ Phụ đề Việt ngữ: Amtia(NOFACE) ~\NBiên tập & Căn chỉnh: Amtia(NOFACE)
Dialogue: 0,0:24:27.53,0:24:33.55,Default,,0,0,0,,~ Trong tập tiếp theo của ~\NQUÁN ĂN ĐÊM (SHINYA SHOKUDO)
Dialogue: 0,0:24:34.66,0:24:37.58,Default,,0,0,0,,Cháu là ca sĩ hát nhạc enka.
Dialogue: 0,0:24:37.67,0:24:38.71,Default,,0,0,0,,Ông phải lòng con bé mất rồi.
Dialogue: 0,0:24:38.83,0:24:39.80,Default,,0,0,0,,Tôi có giữ một tấm đây.
Dialogue: 0,0:24:39.91,0:24:41.31,Default,,0,0,0,,Cuộc đời...
Dialogue: 0,0:24:41.40,0:24:43.15,Default,,0,0,0,,Mặc dòng đời đưa đẩy ư?!
Dialogue: 0,0:24:43.26,0:24:45.07,Default,,0,0,0,,Điều quan trọng nhất...
Dialogue: 0,0:24:45.16,0:24:47.12,Default,,0,0,0,,chính là khát khao được ca hát của cháu.
Dialogue: 0,0:24:47.23,0:24:48.14,Default,,0,0,0,,Chào Ông chủ...
Dialogue: 0,0:24:48.23,0:24:50.29,Default,,0,0,0,,Cháu lại ghé nữa đây ạ.
Dialogue: 0,0:24:51.04,0:24:53.31,Default,,0,0,0,,~ Không có động vật nào bị thương\Ntrong quá trình quay bộ phim này ~
Dialogue: 0,0:24:53.80,0:24:55.28,Default,,0,0,0,,~ Tôi... đoán thế ~
Dialogue: 0,0:24:55.92,0:24:58.94,Default,,0,0,0,,~ Và như dòng chữ trên màn hình,\N'câu chuyện trong phim hoàn toàn là hư cấu.' ~
Dialogue: 0,0:24:59.31,0:25:05.74,Default,,0,0,0,,Cảm ơn các bạn đã theo dõi bộ phim\NPhụ đề Việt ngữ bởi Amtia(NOFACE)
