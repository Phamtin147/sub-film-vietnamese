Dialogue: 0,0:00:00.83,0:00:02.97,Default,,0,0,0,,Bản dịch được thực hiện bởi Amtia(NOFACE)\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:00:00.83,0:00:02.97,Default,,0,0,0,,Phụ đề miễn phí phục vụ cộng đồng.\Nghiêm cấm mua bán dưới mọi hình thức!
Dialogue: 0,0:00:03.13,0:00:05.94,Default,,0,0,0,,Ca khúc mở đầu\NOmohide (Ký ức) - Trình bày: Suzuki Tsunekichi
Dialogue: 0,0:00:03.13,0:00:05.94,Default,,0,0,0,,~ KOBAYASHI Kaoru ~
Dialogue: 0,0:00:09.80,0:00:13.03,Default,,0,0,0,,~ YOU ~
Dialogue: 0,0:00:15.17,0:00:17.84,Default,,0,0,0,,~ Den Den ~
Dialogue: 0,0:00:22.97,0:00:27.65,Default,,0,0,0,,kimi ga hai ta shiroi iki ga\NLàn hơi trắng em khẽ thở ra
Dialogue: 0,0:00:22.97,0:00:27.65,Default,,0,0,0,,Đạo diễn: OIKAWA Takuro
Dialogue: 0,0:00:27.87,0:00:32.51,Default,,0,0,0,,ima, yukkuri kaze notte\NGiờ đây chầm chậm nương theo làn gió
Dialogue: 0,0:00:32.92,0:00:37.69,Default,,0,0,0,,sora ni ukabu kumo no naka ni\NRồi từng chút, từng chút một tan biến
Dialogue: 0,0:00:37.96,0:00:42.83,Default,,0,0,0,,sukoshi zutsu kie te yuku\NVào giữa những tầng mây trôi bồng bềnh trên cao
Dialogue: 0,0:00:43.13,0:00:47.98,Default,,0,0,0,,tooku takai sora no naka de\NTừ nơi bầu trời cao vời vợi xa xăm
Dialogue: 0,0:00:48.30,0:00:52.94,Default,,0,0,0,,te o nobasu shiroi kumo\NĐám mây trắng vươn tay về phía em
Dialogue: 0,0:00:53.23,0:00:57.51,Default,,0,0,0,,kimi ga hai ta iki o sutte\NHít lấy làn hơi trắng em vừa thở ra
Dialogue: 0,0:00:57.43,0:00:59.22,Default,,0,0,0,,{\i1}Khi một ngày khép lại,{\i0}
Dialogue: 0,0:00:59.34,0:01:02.38,Default,,0,0,0,,{\i1}và mọi người vội vã trở về nhà,{\i0}
Dialogue: 0,0:01:02.86,0:01:05.48,Default,,0,0,0,,{\i1}thì ngày mới của tôi mới bắt đầu.{\i0}
Dialogue: 0,0:01:05.59,0:01:08.79,Default,,0,0,0,,[~ Suất súp miso thịt heo (Tonjiru) ~ 600 yên\N~ Bia ~ 600 yên, ~ Rượu Sake ~ 500 yên\N~ Rượu Shochu ~ 400 yên\NMỗi khách tối đa ba ly]\NThực đơn của tôi chỉ có bấy nhiêu đó.
Dialogue: 0,0:01:08.90,0:01:11.76,Default,,0,0,0,,{\i1}Nhưng hễ khách gọi món gì khác...{\i0}
Dialogue: 0,0:01:11.88,0:01:14.05,Default,,0,0,0,,{\i1}chỉ cần có thể làm được là tôi đều phục vụ,{\i0}
Dialogue: 0,0:01:14.18,0:01:17.25,Default,,0,0,0,,{\i1}phương châm làm nghề của tôi là vậy.{\i0}
Dialogue: 0,0:01:17.38,0:01:22.97,Default,,0,0,0,,{\i1}Quán tôi mở cửa từ nửa đêm\Nđến bảy giờ sáng hôm sau.{\i0}
Dialogue: 0,0:01:23.08,0:01:24.15,Default,,0,0,0,,{\i1}Người ta thường gọi nơi này là...{\i0}
Dialogue: 0,0:01:24.29,0:01:27.07,Default,,0,0,0,,{\i1}Quán Ăn Đêm.{\i0}
Dialogue: 0,0:01:27.20,0:01:29.28,Default,,0,0,0,,{\i1}Bạn hỏi làm ăn thế này có khách không ư?!{\i0}
Dialogue: 0,0:01:29.38,0:01:32.07,Default,,0,0,0,,{\i1}Cũng khấm khá lắm đấy chứ.{\i0}
Dialogue: 0,0:01:32.46,0:01:35.34,Default,,0,0,0,,~ Bản dịch của Amtia(NOFACE) ~\NSHINYA SHOKUDO - Quán Ăn Đêm
Dialogue: 0,0:01:35.48,0:01:40.34,Default,,0,0,0,,Tập 8\NMì Xào Sốt (Yakisoba)
Dialogue: 0,0:01:44.46,0:01:47.61,Default,,0,0,0,,Đêm nay trời nổi gió lớn thật.
Dialogue: 0,0:01:47.74,0:01:51.16,Default,,0,0,0,,Cứ mỗi độ đợt gió rét tràn về,
Dialogue: 0,0:01:51.72,0:01:53.84,Default,,0,0,0,,tôi lại thấy nhớ hương vị món này da diết.
Dialogue: 0,0:01:53.94,0:01:55.29,Default,,0,0,0,,Khoan đã nào!
Dialogue: 0,0:01:55.42,0:01:56.96,Default,,0,0,0,,Chai này là của tôi mà.
Dialogue: 0,0:01:57.07,0:01:58.96,Default,,0,0,0,,Cho tôi xin một tẹo thôi\Ncũng được chứ sao?
Dialogue: 0,0:01:59.08,0:02:01.19,Default,,0,0,0,,- Một tẹo thôi đấy nhé.\N- Ừ.
Dialogue: 0,0:02:01.27,0:02:01.96,Default,,0,0,0,,Đúng 2 ml thôi.
Dialogue: 0,0:02:02.05,0:02:03.95,Default,,0,0,0,,2 ml á?!
Dialogue: 0,0:02:04.81,0:02:06.48,Default,,0,0,0,,Cảm ơn bác nhé.
Dialogue: 0,0:02:07.19,0:02:09.21,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:02:09.79,0:02:13.12,Default,,0,0,0,,Cô ấy lúc nào cũng\Nđến cùng với những cơn gió.
Dialogue: 0,0:02:13.69,0:02:18.54,Default,,0,0,0,,Làm ơn cho tôi một đĩa mì xào yakisoba\Ncó phủ trứng ốp la bên trên nhé.
Dialogue: 0,0:02:20.00,0:02:26.07,Default,,0,0,0,,Quán Ăn Đêm - Shinya Shokudō\NBản dịch tiếng Việt của Amtia(NOFACE)
Dialogue: 0,0:02:33.01,0:02:35.76,Default,,0,0,0,,Của cô đây, mì xào yakisoba đặc biệt.
Dialogue: 0,0:02:39.30,0:02:41.31,Default,,0,0,0,,Tôi xin phép ăn ạ.
Dialogue: 0,0:03:09.28,0:03:12.94,Default,,0,0,0,,Xem ra cô hợp khẩu vị\Nmón này quá nhỉ?!
Dialogue: 0,0:03:37.41,0:03:38.88,Default,,0,0,0,,Ông chủ ơi!
Dialogue: 0,0:03:39.00,0:03:40.27,Default,,0,0,0,,Vị khách vừa mới bước ra khỏi quán...
Dialogue: 0,0:03:40.37,0:03:41.55,Default,,0,0,0,,Có phải là Kazami Rinko không vậy?
Dialogue: 0,0:03:41.65,0:03:42.61,Default,,0,0,0,,Ai cơ?
Dialogue: 0,0:03:42.72,0:03:44.30,Default,,0,0,0,,Cô ấy từng là thần tượng âm nhạc một thời đấy Ông chủ!
Dialogue: 0,0:03:44.39,0:03:47.47,Default,,0,0,0,,Giờ thì cô ấy xuất hiện\Ndày đặc trên cả phim điện ảnh lẫn truyền hình.
Dialogue: 0,0:03:48.56,0:03:52.25,Default,,0,0,0,,Giờ cậu nhắc tôi mới để ý,\Ntrông cô ấy đúng là hơi quen mặt thật.
Dialogue: 0,0:03:52.41,0:03:53.75,Default,,0,0,0,,Thật hả Ông chủ?
Dialogue: 0,0:03:53.86,0:03:56.25,Default,,0,0,0,,Thế lúc nãy cô ấy ăn món gì?
Dialogue: 0,0:03:56.34,0:03:59.38,Default,,0,0,0,,Mì xào yakisoba phủ trứng ốp la.
Dialogue: 0,0:03:59.48,0:04:00.71,Default,,0,0,0,,Đúng là nàng Rin Rin không lẫn vào đâu được!
Dialogue: 0,0:04:00.80,0:04:01.88,Default,,0,0,0,,Chắc chắn trăm phần trăm là cô ấy rồi.
Dialogue: 0,0:04:01.97,0:04:03.60,Default,,0,0,0,,Kazami Rinko.\NTên khai sinh là Morinaka Rinko.
Dialogue: 0,0:04:03.70,0:04:06.32,Default,,0,0,0,,Sinh ngày 3 tháng 9 năm 1966\Ntại tỉnh Kochi.
Dialogue: 0,0:04:06.42,0:04:07.48,Default,,0,0,0,,Màu sắc yêu thích: màu xanh dương.
Dialogue: 0,0:04:07.56,0:04:08.31,Default,,0,0,0,,Còn món ăn yêu thích nhất?
Dialogue: 0,0:04:08.40,0:04:11.36,Default,,0,0,0,,Mì xào yakisoba phủ trứng ốp la!
Dialogue: 0,0:04:11.86,0:04:15.34,Default,,0,0,0,,Tự dưng thấy chướng mắt rồi đấy nhé...
Dialogue: 0,0:04:15.61,0:04:17.30,Default,,0,0,0,,Sao hai cậu thuộc làu làu lý lịch người ta thế?
Dialogue: 0,0:04:17.39,0:04:19.20,Default,,0,0,0,,Thời trẻ tụi tôi từng là thành viên\Ncâu lạc bộ người hâm mộ của cô ấy mà.
Dialogue: 0,0:04:19.30,0:04:21.34,Default,,0,0,0,,Chính xác là hội viên mang số hiệu 44 và 45.
Dialogue: 0,0:04:21.68,0:04:23.95,Default,,0,0,0,,Hết ngài Erect giờ lại đến nàng Rin Rin.
Dialogue: 0,0:04:24.05,0:04:25.73,Default,,0,0,0,,Làm người hâm mộ như hai cậu kể cũng vất vả gớm.
Dialogue: 0,0:04:25.84,0:04:27.12,Default,,0,0,0,,Ngài Erect là vị thánh sống của tụi tôi.
Dialogue: 0,0:04:27.23,0:04:29.02,Default,,0,0,0,,Còn nàng Rin Rin chính là nữ thần trong mộng.
Dialogue: 0,0:04:29.13,0:04:33.02,Default,,0,0,0,,Hả?! Bác chưa từng nghe danh cô ấy bao giờ á?
Dialogue: 0,0:04:33.11,0:04:35.83,Default,,0,0,0,,Đừng bảo là mấy người không biết bài\N"Tống Khứ Gã Trai Phiền Phức" đấy nhé?
Dialogue: 0,0:04:35.94,0:04:38.39,Default,,0,0,0,,Tên bài hát kiểu quái gì thế kia?
Dialogue: 0,0:04:38.49,0:04:40.49,Default,,0,0,0,,Chị Kosuzu này, chị chẳng biết\Nthưởng thức nghệ thuật gì cả, đúng không?
Dialogue: 0,0:04:40.59,0:04:42.18,Default,,0,0,0,,Ý hai chú mày là sao hả?
Dialogue: 0,0:04:42.29,0:04:44.42,Default,,0,0,0,,Tôi thấy cái tựa đề đó hay mà, sao đâu?
Dialogue: 0,0:04:44.51,0:04:45.59,Default,,0,0,0,,Bác thấy hay thật á?
Dialogue: 0,0:04:45.69,0:04:47.37,Default,,0,0,0,,Bác bị làm sao thế, lú lẫn rồi à?
Dialogue: 0,0:04:47.48,0:04:50.08,Default,,0,0,0,,Đừng có tốn công hùa theo nịnh bợ\Nhai cái gã nhà quê mùa này.
Dialogue: 0,0:04:50.16,0:04:52.60,Default,,0,0,0,,Chị đừng nói thế chứ.
Dialogue: 0,0:04:52.74,0:04:58.83,Default,,0,0,0,,"Nhìn mấy đứa nhóc cứ làm bộ làm tịch\Ndễ thương mà phát buồn nôn,"
Dialogue: 0,0:04:59.01,0:05:04.49,Default,,0,0,0,,"Tôi sẽ cứ sống theo cách của riêng mình."
Dialogue: 0,0:05:04.60,0:05:11.93,Default,,0,0,0,,"Phiền phức, gã trai phiền phức kia,\Nbiến khuất mắt tôi ngay đi."
Dialogue: 0,0:05:12.14,0:05:18.68,Default,,0,0,0,,"Tôi sẽ nhắm thẳng vào trái tim anh đấy."
Dialogue: 0,0:05:19.03,0:05:25.43,Default,,0,0,0,,"Đồ phiền phức, anh đúng là đồ phiền phức!"
Dialogue: 0,0:05:25.61,0:05:34.16,Default,,0,0,0,,"Phiền phức, gã trai\Nphiền phức!"
Dialogue: 0,0:05:36.01,0:05:42.79,Default,,0,0,0,,"Thuốc diệt côn trùng đây, Xịt!"
Dialogue: 0,0:05:43.15,0:05:49.74,Default,,0,0,0,,"Mấy kẻ dối trá trông chẳng ngầu chút nào"
Dialogue: 0,0:05:50.04,0:05:55.80,Default,,0,0,0,,"Tôi sẽ mãi sống thật với chính bản thân mình"
Dialogue: 0,0:05:56.00,0:06:03.20,Default,,0,0,0,,"Phiền phức, gã trai phiền phức kia,\Nbiến ngay khỏi đường tôi đi."
Dialogue: 0,0:06:03.38,0:06:09.93,Default,,0,0,0,,"Tôi sẽ nhắm thẳng vào\Nsổ hộ khẩu nhà anh đấy"
Dialogue: 0,0:06:10.15,0:06:16.38,Default,,0,0,0,,"Đồ phiền phức, anh đúng là đồ phiền phức!"
Dialogue: 0,0:06:16.48,0:06:20.26,Default,,0,0,0,,"Gã trai phiền phức!"
Dialogue: 0,0:06:20.52,0:06:26.87,Default,,0,0,0,,"Thuốc diệt côn trùng đây, Xịt!"
Dialogue: 0,0:06:39.71,0:06:43.03,Default,,0,0,0,,Hai thằng đàn ông đầu hai thứ tóc rồi mà ngồi khóc tu tu thế kia.
Dialogue: 0,0:06:43.14,0:06:48.99,Default,,0,0,0,,Nhưng tôi đoán đối với hai cậu ấy,\NKazami Rinko chính là cả bầu trời thanh xuân.
Dialogue: 0,0:06:49.11,0:06:52.20,Default,,0,0,0,,Nàng Rin Rin lúc nào cũng tràn đầy\Nnăng lượng tươi sáng như thế,
Dialogue: 0,0:06:52.30,0:06:55.61,Default,,0,0,0,,nhưng tuổi thơ của cô ấy\Nlại vô cùng cơ cực.
Dialogue: 0,0:06:55.74,0:06:57.81,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:06:58.04,0:07:02.58,Default,,0,0,0,,Bố ruột cô ấy bỏ trốn biệt tăm\Nđể lại một khoản nợ khổng lồ,
Dialogue: 0,0:07:02.88,0:07:06.54,Default,,0,0,0,,khiến cuộc đời cô ấy chìm trong sóng gió\Ncho tới tận lúc bước chân vào làng giải trí.
Dialogue: 0,0:07:06.64,0:07:08.79,Default,,0,0,0,,Hai cậu này...
Dialogue: 0,0:07:08.92,0:07:11.30,Default,,0,0,0,,Tôi cũng rất quý mến cô Rin Rin,
Dialogue: 0,0:07:11.43,0:07:14.51,Default,,0,0,0,,nhưng hai cậu gọi món gì đó ăn đi chứ nhỉ?
Dialogue: 0,0:07:14.90,0:07:17.43,Default,,0,0,0,,Cho tôi một đĩa mì xào yakisoba phủ trứng ốp la.
Dialogue: 0,0:07:18.05,0:07:19.60,Default,,0,0,0,,Cho tôi một phần y hệt luôn.
Dialogue: 0,0:07:20.86,0:07:22.81,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:07:30.32,0:07:34.00,Default,,0,0,0,,{\i1}Và rồi, khoảng chừng một tháng trôi qua?{\i0}
Dialogue: 0,0:07:34.26,0:07:36.18,Default,,0,0,0,,{\i1}Ngay cả vào cái đêm hôm ấy....{\i0}
Dialogue: 0,0:07:36.31,0:07:39.28,Default,,0,0,0,,{\i1}cô ấy cũng ghé đến cùng với những cơn gió.{\i0}
Dialogue: 0,0:07:42.74,0:07:46.39,Default,,0,0,0,,Cho tôi một đĩa mì xào yakisoba phủ trứng ốp la nhé.
Dialogue: 0,0:07:54.73,0:07:57.63,Default,,0,0,0,,Có vẻ cô rất thích món ăn này nhỉ.
Dialogue: 0,0:07:57.98,0:08:01.90,Default,,0,0,0,,Hồi còn nhỏ tôi thường xuyên được ăn món này.
Dialogue: 0,0:08:04.61,0:08:08.54,Default,,0,0,0,,{\i1}Nỗi buồn man mác in hằn trên gương mặt cô ấy\Nkhiến lòng tôi thấy xót xa lạ thường,{\i0}
Dialogue: 0,0:08:09.73,0:08:14.03,Default,,0,0,0,,{\i1}đến mức chính bản thân tôi cũng bất giác trở thành người hâm mộ của cô ấy từ lúc nào.{\i0}
Dialogue: 0,0:08:14.82,0:08:19.94,Default,,0,0,0,,{\i1}Sau đêm đó, thi thoảng cô ấy\Nvẫn đều đặn ghé qua quán.{\i0}
Dialogue: 0,0:08:20.06,0:08:22.46,Default,,0,0,0,,Ông chủ ơi, tin đồn minh tinh Kazami Rinko\Nhay ghé quán mình là thật hả?
Dialogue: 0,0:08:33.33,0:08:34.30,Default,,0,0,0,,Mận muối (Ume) nhé.
Dialogue: 0,0:08:34.51,0:08:35.63,Default,,0,0,0,,Cá hồi (Salmon) nhé.
Dialogue: 0,0:08:35.75,0:08:38.00,Default,,0,0,0,,Trứng cá tuyết (Tarako) nhé.
Dialogue: 0,0:08:39.35,0:08:41.93,Default,,0,0,0,,Cảm ơn Ông chủ nhiều.
Dialogue: 0,0:08:56.73,0:08:59.51,Default,,0,0,0,,Xem ra người nổi tiếng ngoài đời\Ncũng chẳng có gì đặc biệt lắm nhỉ.
Dialogue: 0,0:08:59.63,0:09:01.67,Default,,0,0,0,,Bộ dạng đó trông chẳng phải cũng hơi chướng mắt sao?
Dialogue: 0,0:09:01.77,0:09:03.84,Default,,0,0,0,,Cứ làm như mình đang mang\Ntâm sự nặng trĩu u uất lắm không bằng...
Dialogue: 0,0:09:03.95,0:09:06.80,Default,,0,0,0,,Xét về khoản nữ tính thì chị em mình ăn đứt cô ta.
Dialogue: 0,0:09:07.02,0:09:09.47,Default,,0,0,0,,Đúng không hai bà?!
Dialogue: 0,0:09:10.55,0:09:12.25,Default,,0,0,0,,Chuẩn luôn?!
Dialogue: 0,0:09:17.60,0:09:20.04,Default,,0,0,0,,Cẩn thận kìa... Cậu có sao không đấy?
Dialogue: 0,0:09:20.18,0:09:23.30,Default,,0,0,0,,Đi đứng kiểu gì mà vấp ngã túi bụi thế...
Dialogue: 0,0:09:29.76,0:09:31.28,Default,,0,0,0,,Nàng Rin Rin đâu rồi Ông chủ?
Dialogue: 0,0:09:31.68,0:09:33.98,Default,,0,0,0,,Cô ấy vừa mới ngồi ở đây cách đây một lúc thôi.
Dialogue: 0,0:09:34.10,0:09:36.87,Default,,0,0,0,,Cả Hội Ba Chị Em Cơm Trà Chan cũng vừa mới về xong.
Dialogue: 0,0:09:36.99,0:09:38.91,Default,,0,0,0,,Mặc xác mấy bà Cơm Trà Chan đó đi!
Dialogue: 0,0:09:39.02,0:09:40.40,Default,,0,0,0,,Có phải mấy bà cô đó lại làm ầm ĩ lên nên cô ấy mới bỏ về không?
Dialogue: 0,0:09:40.51,0:09:43.58,Default,,0,0,0,,Xem chừng hai cậu không có duyên gặp mặt thần tượng rồi.
Dialogue: 0,0:09:43.91,0:09:45.35,Default,,0,0,0,,Cho tụi tôi mì xào yakisoba...
Dialogue: 0,0:09:45.44,0:09:47.10,Default,,0,0,0,,Có phủ trứng ốp la bên trên nhé.
Dialogue: 0,0:09:47.31,0:09:48.92,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:09:54.49,0:09:56.32,Default,,0,0,0,,{\i1}Ông chủ ơi!{\i0}
Dialogue: 0,0:09:56.67,0:09:58.56,Default,,0,0,0,,{\i1}Cảm ơn Ông chủ vì bữa ăn nhé.{\i0}
Dialogue: 0,0:09:58.68,0:10:01.99,Default,,0,0,0,,Trong người tôi chỉ có mỗi tờ 10.000 yên chẵn,\Ncó sao không Ông chủ?
Dialogue: 0,0:10:02.10,0:10:05.44,Default,,0,0,0,,Xin lỗi cô nhé.\NHôm nay tôi vừa đánh rơi mất ví tiền,
Dialogue: 0,0:10:05.54,0:10:07.74,Default,,0,0,0,,nên trong quán không còn đủ tiền lẻ để thối lại cho cô rồi.
Dialogue: 0,0:10:07.84,0:10:08.33,Default,,0,0,0,,Cô cứ để lần sau trả tôi cũng được.
Dialogue: 0,0:10:08.42,0:10:09.51,Default,,0,0,0,,Trong ví Ông chủ có để nhiều tiền không?
Dialogue: 0,0:10:09.64,0:10:11.22,Default,,0,0,0,,Tiền mặt thì cũng chẳng đáng là bao,
Dialogue: 0,0:10:11.35,0:10:13.59,Default,,0,0,0,,nhưng toàn bộ bằng lái xe\Nvà thẻ ngân hàng của tôi đều nằm trong đó cả.
Dialogue: 0,0:10:13.69,0:10:15.56,Default,,0,0,0,,Đúng là xui xẻo thật đấy.
Dialogue: 0,0:10:16.03,0:10:18.54,Default,,0,0,0,,Vậy... hẹn Ông chủ lần tới tôi gửi tiền nhé.
Dialogue: 0,0:10:18.68,0:10:20.09,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:10:24.62,0:10:26.52,Default,,0,0,0,,Ông chủ ơi.... Cứu tôi với!
Dialogue: 0,0:10:26.61,0:10:28.87,Default,,0,0,0,,Cơ thể tôi không chịu đựng nổi cái điệu nhảy này nữa rồi.
Dialogue: 0,0:10:28.96,0:10:30.10,Default,,0,0,0,,Ông chủ!
Dialogue: 0,0:10:30.19,0:10:31.87,Default,,0,0,0,,Nào, nhảy tiếp đi!
Dialogue: 0,0:10:56.69,0:10:59.45,Default,,0,0,0,,Xin lỗi cho tôi hỏi một chút.
Dialogue: 0,0:11:00.05,0:11:03.07,Default,,0,0,0,,Chiếc ví này là của ông, đúng không?
Dialogue: 0,0:11:03.17,0:11:04.50,Default,,0,0,0,,Tôi nhặt được nó từ tối hôm qua,
Dialogue: 0,0:11:04.60,0:11:06.61,Default,,0,0,0,,nhưng thấy quán ông đang đông khách,\Ntôi sợ hạng người rách rưới như mình mà bước vào,
Dialogue: 0,0:11:06.71,0:11:07.62,Default,,0,0,0,,thì sẽ làm phiền đến chuyện buôn bán của ông.
Dialogue: 0,0:11:07.71,0:11:08.99,Default,,0,0,0,,Cảm ơn ông nhiều lắm.
Dialogue: 0,0:11:09.08,0:11:10.68,Default,,0,0,0,,Khoan đã...
Dialogue: 0,0:11:10.77,0:11:12.98,Default,,0,0,0,,Nếu ông không chê,\Nxin hãy nhận lấy chút tiền cảm tạ này...
Dialogue: 0,0:11:13.07,0:11:14.57,Default,,0,0,0,,Không, không đâu.\NTôi nhặt trả lại đâu phải vì mong tiền hậu tạ.
Dialogue: 0,0:11:14.67,0:11:16.12,Default,,0,0,0,,Không sao đâu mà, tôi thật lòng muốn biếu ông đấy.
Dialogue: 0,0:11:16.21,0:11:18.12,Default,,0,0,0,,Tôi không nhận đâu.
Dialogue: 0,0:11:21.96,0:11:24.16,Default,,0,0,0,,Vậy thì...
Dialogue: 0,0:11:24.26,0:11:26.17,Default,,0,0,0,,Hay là thế này đi.
Dialogue: 0,0:11:26.42,0:11:28.87,Default,,0,0,0,,Ông vẫn chưa ăn sáng, đúng không?
Dialogue: 0,0:11:29.01,0:11:31.52,Default,,0,0,0,,Vậy ông vào quán ăn một bữa sáng nhé.
Dialogue: 0,0:11:31.66,0:11:34.45,Default,,0,0,0,,Nhưng mà... Tôi cũng chưa thấy đói bụng lắm...
Dialogue: 0,0:11:42.77,0:11:45.33,Default,,0,0,0,,Mời ông dùng bữa.
Dialogue: 0,0:12:00.56,0:12:02.88,Default,,0,0,0,,Ấm cả lòng mề.
Dialogue: 0,0:12:06.18,0:12:09.94,Default,,0,0,0,,~ Hôm nay, buổi họp báo ra mắt\Nbộ phim điện ảnh "Khúc Ca Dòng Sông" đã chính thức diễn ra ~
Dialogue: 0,0:12:10.05,0:12:12.50,Default,,0,0,0,,~ Nữ diễn viên chính Kazami Rinko\Nđã chia sẻ đôi lời tâm huyết của mình ~
Dialogue: 0,0:12:13.53,0:12:19.11,Default,,0,0,0,,"Bởi vì nhân vật nữ chính trong phim đã trải qua\Nnhững biến cố giống hệt với tuổi thơ của chính tôi,"
Dialogue: 0,0:12:20.21,0:12:23.67,Default,,0,0,0,,"nên tôi đang cố gắng đưa chính những\Ntrải nghiệm xương máu đó vào vai diễn để tạo nên..."
Dialogue: 0,0:12:23.78,0:12:27.19,Default,,0,0,0,,"một hình tượng nhân vật chân thực\Nvà sống động nhất có thể."
Dialogue: 0,0:12:27.30,0:12:30.01,Default,,0,0,0,,Kazami Rinko...
Dialogue: 0,0:12:30.11,0:12:32.40,Default,,0,0,0,,Cô ấy quả là một nữ diễn viên tuyệt vời.
Dialogue: 0,0:12:32.75,0:12:36.70,Default,,0,0,0,,Thi thoảng cô ấy cũng ghé qua quán nhỏ của tôi đấy.
Dialogue: 0,0:12:36.80,0:12:38.92,Default,,0,0,0,,Đêm hôm qua cô ấy cũng vừa mới ghé xong.
Dialogue: 0,0:12:39.03,0:12:43.12,Default,,0,0,0,,Có điều lần nào tới cô ấy cũng chỉ gọi duy nhất một món.
Dialogue: 0,0:12:43.23,0:12:47.49,Default,,0,0,0,,Mì xào yakisoba phủ trứng ốp la.
Dialogue: 0,0:12:47.60,0:12:50.31,Default,,0,0,0,,Tôi đoán chắc cô ấy mê món đó lắm.
Dialogue: 0,0:12:54.17,0:12:56.61,Default,,0,0,0,,Ông chủ có biết chuyện này không?
Dialogue: 0,0:12:56.72,0:13:00.07,Default,,0,0,0,,Nếu rắc thêm một chút rong biển xanh (aonori) từ dòng sông Shimanto*,\Nmón mì xào yakisoba sẽ còn thơm ngon hơn gấp bội đấy.
Dialogue: 0,0:12:56.72,0:13:00.07,Default,,0,0,0,,{\i1}(*Dòng sông nổi tiếng ở tỉnh Kochi){\i0}
Dialogue: 0,0:13:00.35,0:13:04.25,Default,,0,0,0,,À... Vậy cơ à?
Dialogue: 0,0:13:04.35,0:13:07.79,Default,,0,0,0,,Hương vị của nó sẽ khác biệt hoàn toàn luôn đấy.
Dialogue: 0,0:13:09.83,0:13:11.34,Default,,0,0,0,,Hôm nào đó,
Dialogue: 0,0:13:11.46,0:13:14.64,Default,,0,0,0,,khi cô diễn viên kia có ghé lại quán,\NÔng chủ nhớ rắc thử cho cô ấy ăn nhé.
Dialogue: 0,0:13:14.73,0:13:15.68,Default,,0,0,0,,Nhất định tôi sẽ làm thế.
Dialogue: 0,0:13:15.80,0:13:18.98,Default,,0,0,0,,Đây chính là rong biển xanh gửi từ sông Shimanto lên đấy.
Dialogue: 0,0:13:19.09,0:13:20.85,Default,,0,0,0,,Vâng.
Dialogue: 0,0:13:32.96,0:13:35.13,Default,,0,0,0,,Ngon quá...
Dialogue: 0,0:13:35.95,0:13:37.67,Default,,0,0,0,,Ăn một miếng mà cảm giác như được sống lại vậy.
Dialogue: 0,0:13:40.83,0:13:42.55,Default,,0,0,0,,Bố à.
Dialogue: 0,0:13:42.98,0:13:45.33,Default,,0,0,0,,Năm xưa,
Dialogue: 0,0:13:45.45,0:13:48.16,Default,,0,0,0,,tại sao bố lại nhẫn tâm bỏ rơi con?
Dialogue: 0,0:13:48.97,0:13:51.57,Default,,0,0,0,,Chuyện đó...
Dialogue: 0,0:13:52.22,0:13:55.99,Default,,0,0,0,,Nhờ có bố mà con....
Dialogue: 0,0:13:56.37,0:13:57.10,Default,,0,0,0,,Cắt!
Dialogue: 0,0:13:57.21,0:13:58.63,Default,,0,0,0,,Cắt!
Dialogue: 0,0:13:58.74,0:13:59.79,Default,,0,0,0,,Đoàn phim nghỉ giải lao một lát nhé.
Dialogue: 0,0:13:59.89,0:14:00.56,Default,,0,0,0,,Vâng.
Dialogue: 0,0:14:00.67,0:14:01.98,Default,,0,0,0,,Chúng ta sẽ nghỉ giải lao ít phút.
Dialogue: 0,0:14:02.07,0:14:03.07,Default,,0,0,0,,Đoàn mình nghỉ giải lao nhé.
Dialogue: 0,0:14:03.20,0:14:06.24,Default,,0,0,0,,- Nghỉ giải lao.\N- Nghỉ ít phút nhé mọi người.
Dialogue: 0,0:14:22.01,0:14:23.17,Default,,0,0,0,,Xin lỗi cô Kazami.\NMời cô ra set quay ạ...
Dialogue: 0,0:14:23.27,0:14:23.32,Default,,0,0,0,,Vâng...
Dialogue: 0,0:14:30.11,0:14:32.86,Default,,0,0,0,,- Chính vì ông mà tôi...\N- Cắt!
Dialogue: 0,0:14:32.96,0:14:34.85,Default,,0,0,0,,Quay lại lần nữa.
Dialogue: 0,0:14:35.23,0:14:37.47,Default,,0,0,0,,Tôi xin lỗi đạo diễn.
Dialogue: 0,0:14:37.72,0:14:40.14,Default,,0,0,0,,Mày lượm đâu ra con búp bê đó thế?
Dialogue: 0,0:14:40.33,0:14:41.55,Default,,0,0,0,,Nó nằm lăn lóc ở đằng kia kìa.
Dialogue: 0,0:14:41.65,0:14:43.39,Default,,0,0,0,,Mày trúng mánh rồi đấy.
Dialogue: 0,0:14:56.08,0:14:58.60,Default,,0,0,0,,Rốt cuộc thì đạo diễn không hài lòng\Nở điểm nào trong cách diễn của tôi?
Dialogue: 0,0:14:59.94,0:15:02.63,Default,,0,0,0,,Nó quá hời hợt trên bề mặt sao?
Dialogue: 0,0:15:03.33,0:15:05.27,Default,,0,0,0,,Hay là vẫn chưa đủ cảm xúc?
Dialogue: 0,0:15:05.37,0:15:06.64,Default,,0,0,0,,Tất cả mọi thứ đều sai bét hết!
Dialogue: 0,0:15:06.76,0:15:08.82,Default,,0,0,0,,Từ cách nhả thoại, nét mặt biểu cảm,\Ncho đến cái thần thái của nhân vật!
Dialogue: 0,0:15:08.91,0:15:10.59,Default,,0,0,0,,Chẳng chạm tới được trái tim người xem lấy một chút nào.
Dialogue: 0,0:15:22.22,0:15:24.86,Default,,0,0,0,,Tôi đã nói với các người không dưới một lần\Nlà tôi cực kỳ ghét phải dùng diễn viên xuất thân từ thần tượng!
Dialogue: 0,0:15:25.01,0:15:26.67,Default,,0,0,0,,Này... Tôi tuyệt đối sẽ không\Nthỏa hiệp với cảnh quay này đâu đấy!
Dialogue: 0,0:15:26.76,0:15:28.59,Default,,0,0,0,,Đừng có mơ bảo tôi cho qua cảnh này!
Dialogue: 0,0:15:28.74,0:15:31.11,Default,,0,0,0,,Cả sự nghiệp của tôi đang\Nđặt cược vào bộ phim này đấy!
Dialogue: 0,0:15:51.33,0:15:53.09,Default,,0,0,0,,Xin mời vào.
Dialogue: 0,0:15:58.75,0:16:03.08,Default,,0,0,0,,Cho tôi một đĩa mì xào yakisoba phủ trứng ốp la.
Dialogue: 0,0:16:03.86,0:16:05.27,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:16:22.73,0:16:25.82,Default,,0,0,0,,Về bộ phim mà tôi đang bấm máy ấy...
Dialogue: 0,0:16:28.12,0:16:32.09,Default,,0,0,0,,Đó là câu chuyện xoay quanh hai cha con.
Dialogue: 0,0:16:33.40,0:16:36.10,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:16:38.37,0:16:42.95,Default,,0,0,0,,Sau khi bị người cha ruột thịt bỏ rơi từ thuở nhỏ,
Dialogue: 0,0:16:43.07,0:16:45.98,Default,,0,0,0,,vào cái ngày cô con gái tình cờ gặp lại ông ta,
Dialogue: 0,0:16:46.10,0:16:50.99,Default,,0,0,0,,cô ấy đã trút hết mọi nỗi lòng chất chứa bấy lâu.
Dialogue: 0,0:16:54.36,0:16:57.04,Default,,0,0,0,,Thì...
Dialogue: 0,0:16:57.19,0:17:00.51,Default,,0,0,0,,Đó là kiểu phim tâm lý bình lặng,\Nchẳng có cao trào kịch tính gì to tát cả.
Dialogue: 0,0:17:00.63,0:17:04.06,Default,,0,0,0,,Chỉ đơn thuần là câu chuyện giữa một người cha và đứa con gái thôi.
Dialogue: 0,0:17:13.65,0:17:18.58,Default,,0,0,0,,Cô gái ấy đã bị cha mình bỏ rơi đấy, Ông chủ biết không?
Dialogue: 0,0:17:21.55,0:17:25.71,Default,,0,0,0,,Thế nhưng trong kịch bản cô ấy lại nói rằng mình không hề oán hận ông ta.
Dialogue: 0,0:17:26.68,0:17:31.55,Default,,0,0,0,,Trái lại, cô ấy còn cảm thấy biết ơn ông ấy nữa.
Dialogue: 0,0:17:35.71,0:17:42.11,Default,,0,0,0,,Nếu một ngày nào đó tôi gặp lại bố mình...
Dialogue: 0,0:17:44.86,0:17:51.76,Default,,0,0,0,,Liệu tôi có thực sự thốt ra được\Nnhững lời vị tha như thế với ông ấy không?
Dialogue: 0,0:17:54.55,0:18:00.87,Default,,0,0,0,,Cô có oán hận bố của mình không?
Dialogue: 0,0:18:16.99,0:18:19.66,Default,,0,0,0,,Tôi cũng chẳng biết nữa...
Dialogue: 0,0:18:23.02,0:18:25.17,Default,,0,0,0,,Của cô đây.
Dialogue: 0,0:18:26.09,0:18:28.00,Default,,0,0,0,,Tôi xin phép ăn ạ.
Dialogue: 0,0:18:34.62,0:18:36.83,Default,,0,0,0,,{\i1}Mùi hương này...{\i0}
Dialogue: 0,0:18:39.45,0:18:42.47,Default,,0,0,0,,{\i1}Một người đàn ông đã chỉ cho tôi bí quyết đấy.{\i0}
Dialogue: 0,0:18:43.46,0:18:46.64,Default,,0,0,0,,{\i1}Ông ấy bảo nếu làm món mì xào yakisoba...{\i0}
Dialogue: 0,0:18:46.77,0:18:50.87,Default,,0,0,0,,{\i1}mà rắc thêm một chút rong biển xanh\Nlấy từ dòng sông Shimanto lên trên,{\i0}
Dialogue: 0,0:18:50.98,0:18:54.52,Default,,0,0,0,,{\i1}thì hương vị sẽ còn tuyệt vời hơn gấp bội.{\i0}
Dialogue: 0,0:19:04.33,0:19:06.29,Default,,0,0,0,,Con xin phép ăn ạ....
Dialogue: 0,0:19:42.27,0:19:44.71,Default,,0,0,0,,{\i1}Vị thế nào hả cô?{\i0}
Dialogue: 0,0:19:48.03,0:19:49.32,Default,,0,0,0,,Tuyệt lắm ạ.
Dialogue: 0,0:19:52.98,0:19:56.31,Default,,0,0,0,,{\i1}Ngay cả người đàn ông đã truyền lại bí quyết này cho tôi...{\i0}
Dialogue: 0,0:19:56.41,0:20:01.13,Default,,0,0,0,,{\i1}cũng nói ông ấy là một người hâm mộ cuồng nhiệt của cô đấy.{\i0}
Dialogue: 0,0:20:15.93,0:20:17.57,Default,,0,0,0,,Mì xào tới rồi đây!
Dialogue: 0,0:20:17.68,0:20:19.67,Default,,0,0,0,,Ngon quá đi mất!
Dialogue: 0,0:20:20.03,0:20:22.05,Default,,0,0,0,,Và đây là món khoái khẩu của bé Rinko nhà ta,
Dialogue: 0,0:20:22.18,0:20:24.56,Default,,0,0,0,,rong biển xanh từ dòng sông Shimanto!
Dialogue: 0,0:20:24.65,0:20:27.55,Default,,0,0,0,,Bố sẽ rắc thật đều lên khắp đĩa mì nhé.
Dialogue: 0,0:20:30.58,0:20:33.51,Default,,0,0,0,,{\i1}Xong... rồi đây!{\i0}
Dialogue: 0,0:20:34.62,0:20:38.29,Default,,0,0,0,,Con thích nhất là món mì xào yakisoba bố làm cho con.
Dialogue: 0,0:20:38.40,0:20:40.41,Default,,0,0,0,,Thế thì tuyệt quá!
Dialogue: 0,0:20:42.89,0:20:45.24,Default,,0,0,0,,Con...
Dialogue: 0,0:20:45.35,0:20:49.89,Default,,0,0,0,,không hề oán hận bố đâu, bố à.
Dialogue: 0,0:20:52.56,0:20:56.96,Default,,0,0,0,,Nhờ có bố, mà con....
Dialogue: 0,0:21:14.65,0:21:16.72,Default,,0,0,0,,Bố ơi.
Dialogue: 0,0:21:24.15,0:21:26.45,Default,,0,0,0,,Con cảm ơn bố.
Dialogue: 0,0:21:27.24,0:21:29.38,Default,,0,0,0,,Ông chú kia, đứng chắn hết cả màn hình rồi!
Dialogue: 0,0:21:29.92,0:21:32.77,Default,,0,0,0,,Này! Ông chú kia!
Dialogue: 0,0:21:57.74,0:22:00.23,Default,,0,0,0,,{\i1}Sau vai diễn xuất thần ấy,\NKazami Rinko...{\i0}
Dialogue: 0,0:22:00.37,0:22:04.76,Default,,0,0,0,,{\i1}được giới phê bình hết lời ca ngợi rằng\Ndiễn xuất của cô đã chín muồi vượt bậc.{\i0}
Dialogue: 0,0:22:04.89,0:22:08.47,Default,,0,0,0,,{\i1}Nghe đâu cô ấy còn nhận được cả lời mời\Ntham dự liên hoan phim quốc tế ở nước ngoài nữa.{\i0}
Dialogue: 0,0:22:08.58,0:22:10.17,Default,,0,0,0,,{\i1}Thế nhưng...{\i0}
Dialogue: 0,0:22:23.38,0:22:31.67,Default,,0,0,0,,~ Kazami Rinko Xuất Sắc Giành Giải Nữ Diễn Viên Chính Xuất Sắc Nhất\NTại Giải Thưởng Blue Arrow Với Bộ Phim "Khúc Ca Dòng Sông" ~
Dialogue: 0,0:22:36.60,0:22:39.40,Default,,0,0,0,,Thế chuyện của cậu đàn em (kohai)* chỗ anh dạo này sao rồi?
Dialogue: 0,0:22:36.60,0:22:39.40,Default,,0,0,0,,{\i1}(*Kohai: Đàn em khóa dưới hoặc đồng nghiệp trẻ tuổi hơn){\i0}
Dialogue: 0,0:22:39.63,0:22:42.48,Default,,0,0,0,,{\i1}Dù lịch trình có bận rộn đến đâu đi chăng nữa,{\i0}
Dialogue: 0,0:22:42.59,0:22:45.41,Default,,0,0,0,,{\i1}cô ấy vẫn luôn ghé đến cùng với những cơn gió,{\i0}
Dialogue: 0,0:22:45.71,0:22:47.88,Default,,0,0,0,,{\i1}thi thoảng lại ghé qua một lần.{\i0}
Dialogue: 0,0:22:50.03,0:22:54.72,Default,,0,0,0,,Cho tôi một đĩa mì xào yakisoba phủ trứng ốp la nhé.
Dialogue: 0,0:23:00.03,0:23:01.87,Default,,0,0,0,,Có ngay.
Dialogue: 0,0:23:03.95,0:23:07.57,Default,,0,0,0,,~ Còn tiếp ~
Dialogue: 0,0:23:08.00,0:23:12.22,Default,,0,0,0,,Và đây là một mẹo nhỏ\Nkhi chế biến món mì xào yakisoba.
Dialogue: 0,0:23:12.42,0:23:15.07,Default,,0,0,0,,Trước khi cho vắt mì vào chảo xào sơ,
Dialogue: 0,0:23:15.19,0:23:18.31,Default,,0,0,0,,các bạn nên chần sơ sợi mì\Nbằng một chút nước sôi.
Dialogue: 0,0:23:18.60,0:23:21.87,Default,,0,0,0,,{\i1}Làm như vậy sẽ giúp loại bỏ lớp dầu mỡ thừa bám bên ngoài sợi mì,{\i0}
Dialogue: 0,0:23:21.99,0:23:26.29,Default,,0,0,0,,{\i1}đồng thời giúp nước sốt thấm đẫm vào sợi mì ngon hơn rất nhiều.{\i0}
Dialogue: 0,0:23:27.33,0:23:28.40,Default,,0,0,0,,Vậy...
Dialogue: 0,0:23:28.53,0:23:31.23,Default,,0,0,0,,Chúc mọi người ngủ ngon nhé.
Dialogue: 0,0:23:31.36,0:23:34.47,Default,,0,0,0,,Bản dịch được thực hiện bởi Amtia(NOFACE)\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:23:31.36,0:23:34.47,Default,,0,0,0,,Phụ đề miễn phí phục vụ cộng đồng.\Nghiêm cấm mua bán dưới mọi hình thức!
Dialogue: 0,0:23:35.33,0:23:38.50,Default,,0,0,0,,~ KOBAYASHI Kaoru ~\NÔng chủ
Dialogue: 0,0:23:38.67,0:23:41.33,Default,,0,0,0,,~ YOU ~\NKazami Rinko
Dialogue: 0,0:23:51.70,0:23:54.47,Default,,0,0,0,,~ Den Den ~\NNgười đàn ông lang thang
Dialogue: 0,0:23:57.79,0:24:07.01,Default,,0,0,0,,~ Phụ đề tiếng Việt: Amtia(NOFACE) ~\NChúc các bạn xem phim vui vẻ
Dialogue: 0,0:24:26.58,0:24:34.14,Default,,0,0,0,,~ Trong Tập Tiếp Theo Của ~\NQUÁN ĂN ĐÊM (SHINYA SHOKUDO)
Dialogue: 0,0:24:35.35,0:24:37.08,Default,,0,0,0,,Bà có phải là vũ nữ Rose Michiyo không?
Dialogue: 0,0:24:37.19,0:24:39.91,Default,,0,0,0,,Em rất muốn được xem chị biểu diễn trên sân khấu.
Dialogue: 0,0:24:40.01,0:24:41.74,Default,,0,0,0,,Thứ cô biểu diễn người ta đâu có gọi\Nlà múa nghệ thuật đâu, đúng không?
Dialogue: 0,0:24:41.83,0:24:43.37,Default,,0,0,0,,Làm vũ nữ thoát y thì có gì là xấu hả?
Dialogue: 0,0:24:43.49,0:24:45.05,Default,,0,0,0,,Nếu cậu còn định tiếp tục lui tới quán này,
Dialogue: 0,0:24:45.14,0:24:46.38,Default,,0,0,0,,thì hãy bỏ ngay cái thái độ hách dịch đó ở ngoài cửa đi.
Dialogue: 0,0:24:46.50,0:24:48.14,Default,,0,0,0,,Vậy ra toàn bộ giá trị của một người phụ nữ...
Dialogue: 0,0:24:48.23,0:24:49.79,Default,,0,0,0,,Bác Yachiyo...
Dialogue: 0,0:24:49.88,0:24:52.52,Default,,0,0,0,,~ Trớ trêu thay, nữ diễn viên YOU từng đóng trong bộ phim\N"Nobody Knows" (Không Ai Biết) của đạo diễn Koreeda Hirokazu, ~
Dialogue: 0,0:24:52.66,0:24:54.83,Default,,0,0,0,,~ nơi cô vào vai một người mẹ\Nnhẫn tâm bỏ rơi những đứa con của mình. ~
Dialogue: 0,0:24:54.97,0:24:57.31,Default,,0,0,0,,~ Đúng là luật nhân quả trên màn ảnh.... ~
Dialogue: 0,0:24:58.31,0:25:04.18,Default,,0,0,0,,Quán Ăn Đêm - Shinya Shokudō\NPhụ đề tiếng Việt bởi Amtia(NOFACE)
