Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:06.71,0:01:11.00,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã ra về,{\i0}
Dialogue: 0,0:01:11.63,0:01:13.17,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:30.83,0:01:35.16,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:35.71,0:01:38.67,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:44.42,0:01:46.30,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:46.38,0:01:48.30,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:54.08,0:01:58.96,Default,,0,0,0,,‎CÁNH GÀ CHIÊN
Dialogue: 0,0:02:12.71,0:02:14.75,Default,,0,0,0,,{\i1}‎Cánh gà chiên,{\i0}
Dialogue: 0,0:02:14.83,0:02:16.54,Default,,0,0,0,,{\i1}‎gần đây chúng rất phổ biến à?{\i0}
Dialogue: 0,0:02:17.71,0:02:21.79,Default,,0,0,0,,{\i1}‎Thấy nhiều nhà hàng quanh thị trấn bán{\i0}\N{\i1}‎nên tôi cũng đã thử làm lần đầu tiên.{\i0}
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,‎- Như đang ăn cua vậy.\N‎- Hả?
Dialogue: 0,0:02:34.21,0:02:36.59,Default,,0,0,0,,‎Cánh gà ngon nhưng xương thì...
Dialogue: 0,0:02:36.67,0:02:38.75,Default,,0,0,0,,‎Ừ, chúng thật khó ăn.
Dialogue: 0,0:02:38.83,0:02:40.83,Default,,0,0,0,,‎Và tay thì bị dính dầu mỡ.
Dialogue: 0,0:02:40.92,0:02:42.13,Default,,0,0,0,,‎Cả son môi cũng trôi hết.
Dialogue: 0,0:02:42.71,0:02:44.54,Default,,0,0,0,,‎Nhưng khiến ta thấy như đang ăn thịt nhỉ?
Dialogue: 0,0:02:49.50,0:02:53.21,Default,,0,0,0,,‎Đã bảo rồi, chẳng có đàn ông tốt\N‎tại các bữa tiệc ở Nishi-Azabu đâu.
Dialogue: 0,0:02:54.21,0:02:55.84,Default,,0,0,0,,‎Hắn nói bọn tôi sẽ kết hôn
Dialogue: 0,0:02:56.54,0:02:59.67,Default,,0,0,0,,‎tại khách sạn Ritz-Carlton\N‎và mua nhẫn kim cương Harry Winston.
Dialogue: 0,0:02:59.75,0:03:01.46,Default,,0,0,0,,‎Ai lại nghĩ hắn lừa chứ.
Dialogue: 0,0:03:02.13,0:03:04.96,Default,,0,0,0,,‎Anh ta có tiền, đúng không?
Dialogue: 0,0:03:07.71,0:03:09.54,Default,,0,0,0,,‎Tôi là bạn gái thứ tư của hắn.
Dialogue: 0,0:03:13.04,0:03:15.25,Default,,0,0,0,,‎Chả có gã nào giàu mà thành thật đâu.
Dialogue: 0,0:03:15.79,0:03:18.87,Default,,0,0,0,,‎Hãy chấp nhận\N‎đó chỉ là ảo tưởng và bước tiếp đi.
Dialogue: 0,0:03:18.96,0:03:22.25,Default,,0,0,0,,‎Năm tới là tôi 26 tuổi.\N‎Tôi không còn nhiều thời gian.
Dialogue: 0,0:03:28.71,0:03:32.21,Default,,0,0,0,,‎Người phụ nữ đó,\N‎người ăn ngấu nghiến cánh gà ấy...
Dialogue: 0,0:03:33.08,0:03:34.37,Default,,0,0,0,,‎Ý cậu là Chizuru?
Dialogue: 0,0:03:34.92,0:03:37.13,Default,,0,0,0,,‎Cô ấy làm việc\N‎trong hộp đêm ở Kabukicho nhỉ?
Dialogue: 0,0:03:37.67,0:03:40.13,Default,,0,0,0,,‎Gần đây sau giờ làm cô ấy có đến đây.
Dialogue: 0,0:03:40.67,0:03:42.46,Default,,0,0,0,,‎- Đó là nghề phụ của cô ấy.\N‎- Hả?
Dialogue: 0,0:03:42.54,0:03:44.00,Default,,0,0,0,,‎Cô ấy là người mẫu nội y.
Dialogue: 0,0:03:44.08,0:03:46.75,Default,,0,0,0,,‎Tôi biết mà! Đó là Chizuru Morino!
Dialogue: 0,0:03:46.83,0:03:48.66,Default,,0,0,0,,‎Khoảng mười năm trước,
Dialogue: 0,0:03:48.75,0:03:51.71,Default,,0,0,0,,‎cô ấy thỉnh thoảng\N‎xuất hiện trên vài tạp chí.
Dialogue: 0,0:03:52.25,0:03:53.67,Default,,0,0,0,,‎Vậy là cô ấy vẫn làm việc đó.
Dialogue: 0,0:03:54.54,0:03:56.71,Default,,0,0,0,,‎Các anh không nên buôn chuyện.
Dialogue: 0,0:03:56.79,0:03:59.87,Default,,0,0,0,,‎Đặc biệt là khách quen.\N‎Sẽ không ai muốn đến đây đâu.
Dialogue: 0,0:03:59.96,0:04:01.79,Default,,0,0,0,,‎- Phải.\N‎- Cô cũng buôn chuyện mà.
Dialogue: 0,0:04:01.88,0:04:04.88,Default,,0,0,0,,‎Tôi cũng đang tự nhủ. Đúng không, ông chủ?
Dialogue: 0,0:04:04.96,0:04:08.29,Default,,0,0,0,,‎Ừ. Tôi sẽ rất biết ơn vì điều đó đấy.
Dialogue: 0,0:04:09.04,0:04:10.54,Default,,0,0,0,,‎Ông ấy không tin tôi kìa!
Dialogue: 0,0:04:46.00,0:04:46.92,Default,,0,0,0,,‎Alô?
Dialogue: 0,0:05:18.29,0:05:19.21,Default,,0,0,0,,‎Mời vào.
Dialogue: 0,0:05:20.75,0:05:23.25,Default,,0,0,0,,‎- Xin lỗi.\N‎- Xin chào.
Dialogue: 0,0:05:23.33,0:05:26.33,Default,,0,0,0,,‎Miyako, về việc chụp ảnh áp phích\N‎cho trò chơi pachinko...
Dialogue: 0,0:05:26.42,0:05:27.88,Default,,0,0,0,,‎- Vâng?\N‎- Cô được nhận.
Dialogue: 0,0:05:27.96,0:05:28.84,Default,,0,0,0,,‎Thật ư?
Dialogue: 0,0:05:28.92,0:05:32.34,Default,,0,0,0,,‎Vị CEO đó rất thích cô.
Dialogue: 0,0:05:32.42,0:05:34.42,Default,,0,0,0,,‎- Làm hết sức nhé.\N‎- Cảm ơn anh rất nhiều.
Dialogue: 0,0:05:35.21,0:05:37.13,Default,,0,0,0,,‎Có tin gì về buổi thử vai không?
Dialogue: 0,0:05:38.63,0:05:40.05,Default,,0,0,0,,‎Cô không được chọn.
Dialogue: 0,0:05:40.13,0:05:42.71,Default,,0,0,0,,‎Tôi có việc khác cho cô.
Dialogue: 0,0:05:42.79,0:05:44.75,Default,,0,0,0,,‎Có kế hoạch chụp một bộ sách ảnh.
Dialogue: 0,0:05:45.38,0:05:47.42,Default,,0,0,0,,‎Nhưng có điều kiện kèm theo.
Dialogue: 0,0:05:47.50,0:05:49.33,Default,,0,0,0,,‎Tôi không chụp ảnh khỏa thân đâu.
Dialogue: 0,0:05:53.75,0:05:56.04,Default,,0,0,0,,‎Chizuru, cô muốn gì nào?
Dialogue: 0,0:05:56.83,0:05:59.66,Default,,0,0,0,,‎Cô nói cô sẽ không làm\N‎cái này cái nọ, nhưng...
Dialogue: 0,0:05:59.75,0:06:01.08,Default,,0,0,0,,‎- Cô đã 35 nhỉ?\N‎- Tôi 34 tuổi.
Dialogue: 0,0:06:01.71,0:06:03.21,Default,,0,0,0,,‎Xin lỗi, em về nhà đây.
Dialogue: 0,0:06:03.29,0:06:05.04,Default,,0,0,0,,‎- Hẹn gặp lại.\N‎- Cảm ơn đã làm việc chăm chỉ.
Dialogue: 0,0:06:07.29,0:06:08.54,Default,,0,0,0,,‎Miyako.
Dialogue: 0,0:06:08.63,0:06:11.21,Default,,0,0,0,,‎Về lịch làm việc sắp tới của cô...
Dialogue: 0,0:06:16.25,0:06:18.17,Default,,0,0,0,,‎Tôi cũng chả còn nhiều thì giờ.
Dialogue: 0,0:06:20.42,0:06:23.88,Default,,0,0,0,,‎Mai có tiệc dành cho CEO giàu có\N‎ở Roppongi. Chị đi không?
Dialogue: 0,0:06:23.96,0:06:25.71,Default,,0,0,0,,‎Hai giờ là 12.000 yên.
Dialogue: 0,0:06:25.79,0:06:28.79,Default,,0,0,0,,‎Không đâu.\N‎Tôi không có đủ tiền và hơi mệt.
Dialogue: 0,0:06:29.58,0:06:32.25,Default,,0,0,0,,‎Chị không phải trả đâu,\N‎chị sẽ được nhận tiền.
Dialogue: 0,0:06:38.13,0:06:39.55,Default,,0,0,0,,‎Ngon quá!
Dialogue: 0,0:06:40.46,0:06:42.67,Default,,0,0,0,,‎Chị biết Miyako chứ?
Dialogue: 0,0:06:42.75,0:06:46.21,Default,,0,0,0,,‎Cô ta có được việc đó\N‎là nhờ CEO cô ta gặp được ở một bữa tiệc.
Dialogue: 0,0:06:46.29,0:06:49.83,Default,,0,0,0,,‎Cứ nói chuyện với họ\N‎và nó sẽ sớm kết thúc thôi.
Dialogue: 0,0:06:50.96,0:06:53.09,Default,,0,0,0,,‎Rất vui được gặp anh!
Dialogue: 0,0:07:08.08,0:07:09.75,Default,,0,0,0,,‎Cô Chizuru Morino đúng không?
Dialogue: 0,0:07:11.83,0:07:12.96,Default,,0,0,0,,‎Vâng?
Dialogue: 0,0:07:14.33,0:07:16.96,Default,,0,0,0,,‎Mọi tạp chí có cô tôi đều mua hết.
Dialogue: 0,0:07:17.50,0:07:19.46,Default,,0,0,0,,‎Ảnh của cô ở biển Shimoda...
Dialogue: 0,0:07:20.50,0:07:22.08,Default,,0,0,0,,‎Chúng rất tuyệt.
Dialogue: 0,0:07:23.54,0:07:24.87,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:07:26.25,0:07:29.42,Default,,0,0,0,,‎Đã lâu rồi tôi không nghĩ về Shimoda.
Dialogue: 0,0:07:30.00,0:07:33.25,Default,,0,0,0,,‎Thật ra, tôi đến từ Shizuoka.
Dialogue: 0,0:07:34.58,0:07:36.66,Default,,0,0,0,,‎Lúc đạp xe từ trường về ngang qua đó,
Dialogue: 0,0:07:37.54,0:07:41.08,Default,,0,0,0,,‎tôi đã nghĩ, "Chizuru Morino từng ở đây."
Dialogue: 0,0:07:42.58,0:07:43.83,Default,,0,0,0,,‎Chỉ nghĩ vậy thôi...
Dialogue: 0,0:07:44.88,0:07:46.63,Default,,0,0,0,,‎đã khiến tôi phấn khích rồi.
Dialogue: 0,0:07:49.88,0:07:51.13,Default,,0,0,0,,‎Xin thứ lỗi.
Dialogue: 0,0:07:58.63,0:08:03.01,Default,,0,0,0,,‎Chủ bữa tiệc là bạn đại học của tôi.\N‎Tôi buộc phải đến dự.
Dialogue: 0,0:08:04.50,0:08:05.58,Default,,0,0,0,,‎Vậy à?
Dialogue: 0,0:08:07.04,0:08:10.79,Default,,0,0,0,,‎Không thể tin tôi được gặp Chizuru Morino.
Dialogue: 0,0:08:12.50,0:08:13.88,Default,,0,0,0,,‎Xin lỗi, tôi thô lỗ quá.\N‎Ý tôi là cô Morino.
Dialogue: 0,0:08:23.63,0:08:26.84,Default,,0,0,0,,‎BA TUẦN SAU
Dialogue: 0,0:08:29.54,0:08:31.17,Default,,0,0,0,,‎Anh ta là người chúng ta nói đến?
Dialogue: 0,0:08:32.00,0:08:33.33,Default,,0,0,0,,‎Toru Kanzaki.
Dialogue: 0,0:08:34.00,0:08:37.42,Default,,0,0,0,,‎Chủ một công ty IT\N‎và nghe nói có tài sản hàng triệu đô.
Dialogue: 0,0:08:38.00,0:08:41.29,Default,,0,0,0,,‎Trên tivi nói anh ta là\N‎người nổi tiếng trong hội Internet.
Dialogue: 0,0:08:42.25,0:08:45.75,Default,,0,0,0,,‎Có nhiều người nói như thế\N‎về bản thân họ mà.
Dialogue: 0,0:08:45.83,0:08:47.54,Default,,0,0,0,,‎Của hai người đây.
Dialogue: 0,0:08:48.75,0:08:52.50,Default,,0,0,0,,‎Anh Kanzaki nói anh ấy tuyệt đối\N‎phải thử cánh gà ở đây.
Dialogue: 0,0:08:53.04,0:08:55.17,Default,,0,0,0,,‎Tôi hiểu rồi. Hy vọng anh thích.
Dialogue: 0,0:09:06.00,0:09:06.83,Default,,0,0,0,,‎Rất ngon.
Dialogue: 0,0:09:13.96,0:09:16.54,Default,,0,0,0,,‎- Cô ăn chứ?\N‎- Tôi sẽ ăn salad.
Dialogue: 0,0:09:16.63,0:09:18.09,Default,,0,0,0,,‎Tôi sắp có buổi chụp hình.
Dialogue: 0,0:09:20.46,0:09:21.84,Default,,0,0,0,,‎Cô thật chuyên nghiệp.
Dialogue: 0,0:09:22.67,0:09:24.17,Default,,0,0,0,,‎Tôi rất ấn tượng đấy.
Dialogue: 0,0:09:35.92,0:09:37.25,Default,,0,0,0,,‎Nó thật nổi bật nhỉ?
Dialogue: 0,0:09:37.96,0:09:40.00,Default,,0,0,0,,‎Từ nhỏ tôi đã không thích nó rồi.
Dialogue: 0,0:09:41.67,0:09:42.59,Default,,0,0,0,,‎Nhưng...
Dialogue: 0,0:09:43.67,0:09:44.75,Default,,0,0,0,,‎tôi vẫn giữ lại.
Dialogue: 0,0:09:45.42,0:09:47.21,Default,,0,0,0,,‎Tôi muốn được là chính mình.
Dialogue: 0,0:09:48.75,0:09:51.63,Default,,0,0,0,,‎Nốt ruồi này là bằng chứng của điều đó.
Dialogue: 0,0:09:54.96,0:09:57.04,Default,,0,0,0,,‎- "Chính mình"?\N‎- Vâng.
Dialogue: 0,0:10:01.42,0:10:05.05,Default,,0,0,0,,‎Vài năm trước,\N‎tôi không dám bắt chuyện với cô.
Dialogue: 0,0:10:06.38,0:10:07.63,Default,,0,0,0,,‎Nhưng giờ, nói thật,
Dialogue: 0,0:10:08.29,0:10:09.96,Default,,0,0,0,,‎tôi đã có được chút tự tin.
Dialogue: 0,0:10:12.38,0:10:13.46,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:10:20.79,0:10:22.21,Default,,0,0,0,,‎Cảm ơn cô.
Dialogue: 0,0:10:29.00,0:10:30.04,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:10:31.67,0:10:32.63,Default,,0,0,0,,‎Sao thế?
Dialogue: 0,0:10:33.46,0:10:34.50,Default,,0,0,0,,‎Tôi hiểu rồi...
Dialogue: 0,0:10:35.71,0:10:37.63,Default,,0,0,0,,‎Hiểu rồi. Tôi đến đây.
Dialogue: 0,0:10:39.46,0:10:42.04,Default,,0,0,0,,‎Xin lỗi, tôi có chút chuyện ở công ty.
Dialogue: 0,0:10:42.71,0:10:45.13,Default,,0,0,0,,‎- Mọi thứ ổn chứ?\N‎- Vâng, không phải chuyện nghiêm trọng.
Dialogue: 0,0:10:45.21,0:10:46.84,Default,,0,0,0,,‎Tính tiền, ông chủ ơi.
Dialogue: 0,0:10:50.33,0:10:54.00,Default,,0,0,0,,‎- Xin lỗi, chỉ nhận tiền mặt thôi.\N‎- Sao?
Dialogue: 0,0:10:56.96,0:10:59.17,Default,,0,0,0,,‎Vậy thì...
Dialogue: 0,0:11:01.08,0:11:02.33,Default,,0,0,0,,‎Lấy cái này thay vậy.
Dialogue: 0,0:11:03.21,0:11:05.84,Default,,0,0,0,,‎Không sao, anh Kanzaki.\N‎Tôi có tiền mặt. Xin cứ đi trước.
Dialogue: 0,0:11:07.21,0:11:08.34,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:11:17.08,0:11:19.37,Default,,0,0,0,,‎Ông chủ, thêm năm cánh gà nữa nhé.
Dialogue: 0,0:11:20.63,0:11:22.34,Default,,0,0,0,,‎Tưởng cô đang ăn kiêng chứ?
Dialogue: 0,0:11:23.08,0:11:25.83,Default,,0,0,0,,‎Ăn cánh gà trông không đẹp gì hết.
Dialogue: 0,0:11:26.71,0:11:27.71,Default,,0,0,0,,‎Được rồi.
Dialogue: 0,0:11:30.46,0:11:33.71,Default,,0,0,0,,‎Chàng CEO các công ty IT nổi tiếng đó\N‎hơi kỳ lạ nhỉ?
Dialogue: 0,0:11:33.79,0:11:37.37,Default,,0,0,0,,‎Chắc phải vậy mới sinh tồn được.
Dialogue: 0,0:11:39.13,0:11:42.05,Default,,0,0,0,,‎Chắc có đàn ông\N‎vừa giàu có vừa chân thành.
Dialogue: 0,0:11:42.79,0:11:44.96,Default,,0,0,0,,‎Chả phải cô nói không có à?
Dialogue: 0,0:11:46.00,0:11:47.83,Default,,0,0,0,,‎Tôi đã sai rồi.
Dialogue: 0,0:11:47.92,0:11:50.59,Default,,0,0,0,,‎Chắc trái tim tôi\N‎đã không chịu nổi đau khổ.
Dialogue: 0,0:11:59.58,0:12:02.21,Default,,0,0,0,,‎Anh ấy đang trên đường tới Sapporo.
Dialogue: 0,0:12:03.08,0:12:05.33,Default,,0,0,0,,‎Muộn thế này chắc chắn\N‎không có chuyến bay nào.
Dialogue: 0,0:12:05.88,0:12:08.88,Default,,0,0,0,,‎Anh ấy đi bằng máy bay riêng.
Dialogue: 0,0:12:12.67,0:12:15.30,Default,,0,0,0,,‎"Tôi sẽ xong việc vào buổi sáng.
Dialogue: 0,0:12:15.38,0:12:19.30,Default,,0,0,0,,‎Chiều mai cô bay đến gặp tôi nhé?
Dialogue: 0,0:12:19.38,0:12:21.38,Default,,0,0,0,,‎Tôi muốn cô đến dự sinh nhật tôi."
Dialogue: 0,0:12:21.46,0:12:23.29,Default,,0,0,0,,‎Sao? Tôi nên làm gì đây?
Dialogue: 0,0:12:24.00,0:12:25.46,Default,,0,0,0,,‎Không thể đi tay không được.
Dialogue: 0,0:12:25.54,0:12:26.83,Default,,0,0,0,,‎Tôi nên tặng quà gì?
Dialogue: 0,0:12:26.92,0:12:28.88,Default,,0,0,0,,‎- Không biết.\N‎- Không rõ.
Dialogue: 0,0:12:28.96,0:12:29.92,Default,,0,0,0,,‎Tôi cũng thế.
Dialogue: 0,0:12:31.58,0:12:33.58,Default,,0,0,0,,‎Thật sao, tôi nên làm gì đây?
Dialogue: 0,0:12:34.71,0:12:36.75,Default,,0,0,0,,‎Không phải cô nên là chính mình ư?
Dialogue: 0,0:12:41.58,0:12:42.41,Default,,0,0,0,,‎Vâng?
Dialogue: 0,0:12:43.17,0:12:46.67,Default,,0,0,0,,‎Anh Kanzaki, chúng tôi mang quà đến.
Dialogue: 0,0:12:46.75,0:12:47.83,Default,,0,0,0,,‎Chúng tôi vào được chứ?
Dialogue: 0,0:12:48.42,0:12:50.63,Default,,0,0,0,,‎Vâng. Cửa mở đấy.
Dialogue: 0,0:12:51.63,0:12:52.63,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:13:05.83,0:13:09.00,Default,,0,0,0,,‎- Thứ lỗi cho chúng tôi.\N‎- Cảm ơn.
Dialogue: 0,0:13:28.04,0:13:30.96,Default,,0,0,0,,‎Chúc mừng sinh nhật!
Dialogue: 0,0:13:40.21,0:13:43.21,Default,,0,0,0,,{\i1}‎...anh{\i0}
Dialogue: 0,0:13:43.29,0:13:49.21,Default,,0,0,0,,{\i1}‎Chúc mừng sinh nhật anh{\i0}
Dialogue: 0,0:13:59.79,0:14:01.17,Default,,0,0,0,,‎Tôi chỉ muốn chúc mừng thôi.
Dialogue: 0,0:14:01.25,0:14:02.54,Default,,0,0,0,,‎Có phải...
Dialogue: 0,0:14:03.83,0:14:05.29,Default,,0,0,0,,‎tôi làm hơi quá?
Dialogue: 0,0:14:21.46,0:14:23.75,Default,,0,0,0,,‎Tôi chưa từng có món quà nào như vậy.
Dialogue: 0,0:14:25.46,0:14:26.63,Default,,0,0,0,,‎Cô đến đây...
Dialogue: 0,0:14:28.75,0:14:30.38,Default,,0,0,0,,‎là chính con người cô.
Dialogue: 0,0:15:10.58,0:15:11.91,Default,,0,0,0,,‎Nói thật...
Dialogue: 0,0:15:13.63,0:15:15.42,Default,,0,0,0,,‎tôi của thời trung học...
Dialogue: 0,0:15:17.88,0:15:19.67,Default,,0,0,0,,‎giờ đang khóc trong vui sướng.
Dialogue: 0,0:15:36.63,0:15:37.84,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:15:45.54,0:15:46.46,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:15:50.88,0:15:52.67,Default,,0,0,0,,‎Cô chưa từng để lại miếng thịt nào.
Dialogue: 0,0:15:54.46,0:15:56.13,Default,,0,0,0,,‎Nhà có bốn anh chị em,
Dialogue: 0,0:15:56.67,0:15:59.00,Default,,0,0,0,,‎chúng tôi luôn tranh nhau ăn cánh gà.
Dialogue: 0,0:16:00.33,0:16:04.75,Default,,0,0,0,,‎Nếu không ăn hết thịt,\N‎mẹ sẽ mắng chúng tôi vì lãng phí thức ăn.
Dialogue: 0,0:16:05.38,0:16:06.34,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:16:08.04,0:16:10.37,Default,,0,0,0,,‎Nhưng tôi sẽ không ăn\N‎khi ở cùng anh Kanzaki.
Dialogue: 0,0:16:11.08,0:16:13.46,Default,,0,0,0,,‎Tôi nghĩ cô không cần giả vờ đâu.
Dialogue: 0,0:16:15.67,0:16:17.25,Default,,0,0,0,,‎Tôi không muốn anh ấy không ưa tôi.
Dialogue: 0,0:16:22.08,0:16:22.91,Default,,0,0,0,,‎Này...
Dialogue: 0,0:16:23.63,0:16:26.21,Default,,0,0,0,,‎Ông có thước đo không?
Dialogue: 0,0:16:26.83,0:16:27.87,Default,,0,0,0,,‎Thước đo?
Dialogue: 0,0:16:29.63,0:16:32.34,Default,,0,0,0,,‎Thước đo để biết\N‎ông hạnh phúc như thế nào.
Dialogue: 0,0:16:33.83,0:16:36.08,Default,,0,0,0,,‎Tôi chưa từng nghĩ đến điều này.
Dialogue: 0,0:16:39.17,0:16:40.80,Default,,0,0,0,,‎Tôi không có.
Dialogue: 0,0:16:42.17,0:16:44.67,Default,,0,0,0,,‎Tôi đã cố hết sức làm người mẫu,
Dialogue: 0,0:16:45.29,0:16:48.25,Default,,0,0,0,,‎nhưng lúc nào cũng là người khác\N‎quyết định giá trị của tôi.
Dialogue: 0,0:16:51.00,0:16:52.58,Default,,0,0,0,,‎Từ lúc gặp anh Kanzaki,
Dialogue: 0,0:16:53.42,0:16:56.42,Default,,0,0,0,,‎tôi cảm thấy tôi muốn\N‎trở thành người anh ấy có thể thích.
Dialogue: 0,0:16:57.13,0:16:58.30,Default,,0,0,0,,‎Cô thấy ổn với chuyện đó?
Dialogue: 0,0:17:00.00,0:17:01.13,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:17:01.21,0:17:04.17,Default,,0,0,0,,‎Nếu mà cô còn phán xét bản thân\N‎bằng cách dùng thước đo của người khác,
Dialogue: 0,0:17:04.79,0:17:07.00,Default,,0,0,0,,‎cô sẽ chẳng bao giờ là chính mình được,
Dialogue: 0,0:17:07.63,0:17:08.96,Default,,0,0,0,,‎bất kể cô có nhìn đâu đi.
Dialogue: 0,0:17:22.13,0:17:24.51,Default,,0,0,0,,{\i1}‎Ba tháng trôi qua sau chuyện đó.{\i0}
Dialogue: 0,0:17:25.17,0:17:28.09,Default,,0,0,0,,‎Vị CEO đó thật tuyệt vời.
Dialogue: 0,0:17:28.17,0:17:30.30,Default,,0,0,0,,‎Báo viết giá cổ phiếu lại tăng rất nhanh.
Dialogue: 0,0:17:31.50,0:17:35.17,Default,,0,0,0,,‎- Chizuru, cô sẽ từ bỏ nghề người mẫu à?\N‎- Sao?
Dialogue: 0,0:17:35.25,0:17:38.79,Default,,0,0,0,,‎Dạo gần đây không thấy ảnh của cô,\N‎tôi muốn thấy lại chúng.
Dialogue: 0,0:17:38.88,0:17:40.59,Default,,0,0,0,,‎Xin lỗi đã khiến ông thất vọng.
Dialogue: 0,0:17:40.67,0:17:44.05,Default,,0,0,0,,‎- Chị Chizuru sẽ sớm từ bỏ nghề người mẫu.\N‎- Sao hả?
Dialogue: 0,0:17:44.13,0:17:47.30,Default,,0,0,0,,‎- Cô sẽ kết hôn với anh CEO đó à?\N‎- Không, vẫn chưa.
Dialogue: 0,0:17:47.38,0:17:50.46,Default,,0,0,0,,‎Nhưng chúng ta đều nói\N‎chuyện đó chắc sớm xảy ra.
Dialogue: 0,0:17:52.29,0:17:55.25,Default,,0,0,0,,‎Anh ấy rất bận,\N‎hầu như không có thời gian trò chuyện.
Dialogue: 0,0:17:55.96,0:17:57.04,Default,,0,0,0,,‎Thật ra...
Dialogue: 0,0:17:57.71,0:17:58.96,Default,,0,0,0,,‎tôi hơi ho lắng.
Dialogue: 0,0:18:01.96,0:18:03.63,Default,,0,0,0,,‎Chào buổi tối. Chào.
Dialogue: 0,0:18:11.92,0:18:12.75,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:18:14.21,0:18:15.04,Default,,0,0,0,,‎Mời ngồi.
Dialogue: 0,0:18:15.63,0:18:19.26,Default,,0,0,0,,‎Cô Yukari Tendo đó,\N‎gần đây có rất nhiều quảng cáo đấy.
Dialogue: 0,0:18:21.96,0:18:23.34,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:18:24.33,0:18:27.00,Default,,0,0,0,,‎Cô ấy nói muốn ăn cánh gà ngon.
Dialogue: 0,0:18:27.83,0:18:29.91,Default,,0,0,0,,‎Có thể gọi năm cánh không?
Dialogue: 0,0:18:30.54,0:18:31.54,Default,,0,0,0,,‎Có ngay.
Dialogue: 0,0:18:33.92,0:18:37.50,Default,,0,0,0,,‎Thỉnh thoảng nơi như thế này rất tốt.\N‎Đúng không, cô Yukari?
Dialogue: 0,0:18:37.58,0:18:38.58,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:18:38.67,0:18:42.42,Default,,0,0,0,,‎Anh Kanzaki,\N‎chắc anh biết hết những nơi như thế này.
Dialogue: 0,0:18:44.21,0:18:45.71,Default,,0,0,0,,‎Chị Chizuru, đi thôi.
Dialogue: 0,0:18:48.21,0:18:49.13,Default,,0,0,0,,‎Nốt ruồi của anh...
Dialogue: 0,0:18:55.04,0:18:56.37,Default,,0,0,0,,‎Thật ra...
Dialogue: 0,0:18:57.00,0:18:59.17,Default,,0,0,0,,‎tôi đã lên tầm mới.
Dialogue: 0,0:19:00.71,0:19:01.92,Default,,0,0,0,,‎"Mới"?
Dialogue: 0,0:19:16.17,0:19:18.09,Default,,0,0,0,,‎Xin lỗi vì tôi rất khó coi.
Dialogue: 0,0:19:19.88,0:19:21.46,Default,,0,0,0,,‎Anh có phiền nếu tôi thế này không?
Dialogue: 0,0:19:23.29,0:19:26.08,Default,,0,0,0,,‎Tôi thích cô vì chính con người cô.
Dialogue: 0,0:19:28.17,0:19:29.09,Default,,0,0,0,,‎Nhưng...
Dialogue: 0,0:19:30.38,0:19:33.05,Default,,0,0,0,,‎hai năm trước, tôi quá rụt rè\N‎không dám bắt chuyện với cô.
Dialogue: 0,0:19:34.17,0:19:35.42,Default,,0,0,0,,‎Sự thật là...
Dialogue: 0,0:19:36.67,0:19:39.96,Default,,0,0,0,,‎giờ tôi có chút tự tin hơn trước.
Dialogue: 0,0:19:40.83,0:19:42.08,Default,,0,0,0,,‎Xin thứ lỗi.
Dialogue: 0,0:19:44.71,0:19:47.67,Default,,0,0,0,,‎Xem anh ta nói từ "sự thật" nhiều lần kìa.
Dialogue: 0,0:19:47.75,0:19:48.58,Default,,0,0,0,,‎Này anh kia!
Dialogue: 0,0:19:49.17,0:19:50.00,Default,,0,0,0,,‎Vâng?
Dialogue: 0,0:19:50.96,0:19:54.38,Default,,0,0,0,,‎Anh không nghĩ mình vô tình với Chizuru à?
Dialogue: 0,0:19:55.13,0:19:57.80,Default,,0,0,0,,‎Không nên đùa giỡn\N‎với cảm xúc của người khác!
Dialogue: 0,0:20:01.25,0:20:02.38,Default,,0,0,0,,‎Đùa giỡn?
Dialogue: 0,0:20:07.63,0:20:08.88,Default,,0,0,0,,‎Tôi không hiểu.
Dialogue: 0,0:20:10.29,0:20:12.67,Default,,0,0,0,,‎Nếu thấy thứ gì tốt hơn, phải nắm lấy.
Dialogue: 0,0:20:13.25,0:20:15.42,Default,,0,0,0,,‎Tôi nghĩ chuyện đó bình thường mà.
Dialogue: 0,0:20:16.50,0:20:19.08,Default,,0,0,0,,‎Cô đã làm như thế khi gặp tôi nhỉ?
Dialogue: 0,0:20:25.08,0:20:26.21,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:20:26.29,0:20:28.62,Default,,0,0,0,,‎- Đợi đã, Chizuru!\N‎- Không sao.
Dialogue: 0,0:20:29.21,0:20:32.88,Default,,0,0,0,,‎Tôi đã cho anh ta một món quà.
Dialogue: 0,0:20:35.42,0:20:37.59,Default,,0,0,0,,‎Chắc tôi không phải là chính mình.
Dialogue: 0,0:20:38.21,0:20:40.17,Default,,0,0,0,,‎Tôi chỉ giả bộ như vậy thôi.
Dialogue: 0,0:20:44.33,0:20:46.83,Default,,0,0,0,,‎Cảm ơn, anh Kanzaki.
Dialogue: 0,0:20:48.88,0:20:49.92,Default,,0,0,0,,‎Không, cảm ơn cô.
Dialogue: 0,0:20:50.58,0:20:52.83,Default,,0,0,0,,‎Dù cho đó chỉ là giấc mơ tạm thời.
Dialogue: 0,0:20:56.83,0:21:00.12,Default,,0,0,0,,‎Ông chủ, tôi đi đây.\N‎Tôi trả phần cô ấy luôn.
Dialogue: 0,0:21:09.33,0:21:10.33,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:21:18.13,0:21:20.63,Default,,0,0,0,,‎Tôi đã tìm thấy thước đo cho mình.
Dialogue: 0,0:21:21.46,0:21:22.46,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:21:24.08,0:21:24.91,Default,,0,0,0,,‎Đi thôi.
Dialogue: 0,0:21:37.25,0:21:38.50,Default,,0,0,0,,‎Trời ạ!
Dialogue: 0,0:21:39.46,0:21:40.79,Default,,0,0,0,,‎Xin lỗi cô nhé.
Dialogue: 0,0:21:41.67,0:21:43.30,Default,,0,0,0,,‎Đừng bận tâm về chuyện đó.
Dialogue: 0,0:21:57.63,0:21:58.88,Default,,0,0,0,,‎Tôi không thể tiếp tục được nữa.
Dialogue: 0,0:22:04.00,0:22:09.08,Default,,0,0,0,,{\i1}‎Ngay sau đó, Chizuru phát hành bộ sách ảnh{\i0}\N{\i1}‎khỏa thân phô bày vùng nhạy cảm của mình{\i0}
Dialogue: 0,0:22:09.63,0:22:14.21,Default,,0,0,0,,{\i1}‎và từ bỏ công việc người mẫu.{\i0}
Dialogue: 0,0:22:19.50,0:22:21.17,Default,,0,0,0,,‎LỚP GÓI QUÀ MORINO
Dialogue: 0,0:22:27.88,0:22:30.21,Default,,0,0,0,,‎Cô tự mình làm hết à, Chizuru?
Dialogue: 0,0:22:30.29,0:22:34.33,Default,,0,0,0,,‎Tôi có chứng chỉ gói quà\N‎và mở lớp dạy ở Minami-Aoyama.
Dialogue: 0,0:22:35.08,0:22:36.66,Default,,0,0,0,,‎Tôi có nhiều học sinh lắm.
Dialogue: 0,0:22:37.25,0:22:39.00,Default,,0,0,0,,‎Thay đổi môi trường tốt thật.
Dialogue: 0,0:22:39.08,0:22:41.71,Default,,0,0,0,,‎Nhưng không phải tiền thuê đắt làm sao?
Dialogue: 0,0:22:41.79,0:22:44.29,Default,,0,0,0,,‎Vâng, tôi phải dùng hết tiền\N‎từ bộ sách ảnh.
Dialogue: 0,0:22:44.88,0:22:46.42,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:22:46.50,0:22:49.50,Default,,0,0,0,,‎Đây rồi! Đây là thứ tôi muốn!
Dialogue: 0,0:22:49.58,0:22:51.04,Default,,0,0,0,,‎Đã lâu lắm rồi.
Dialogue: 0,0:22:55.38,0:22:59.59,Default,,0,0,0,,‎Là chính mình hợp với cô hơn hẳn, Chizuru.
Dialogue: 0,0:22:59.67,0:23:00.96,Default,,0,0,0,,‎Tôi đồng ý.
Dialogue: 0,0:23:01.04,0:23:02.00,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:23:03.33,0:23:04.46,Default,,0,0,0,,‎Tôi nhận ra...
Dialogue: 0,0:23:05.33,0:23:07.91,Default,,0,0,0,,‎có những thứ ta không bao giờ gói được.
Dialogue: 0,0:23:08.63,0:23:09.46,Default,,0,0,0,,‎Đó là gì?
Dialogue: 0,0:23:11.83,0:23:12.83,Default,,0,0,0,,‎Chính mình.
Dialogue: 0,0:23:13.46,0:23:15.09,Default,,0,0,0,,‎Không thể tặng ta cho người khác nhỉ?
Dialogue: 0,0:23:18.04,0:23:18.96,Default,,0,0,0,,‎Đúng vậy.
Dialogue: 0,0:23:30.46,0:23:34.13,Default,,0,0,0,,‎Dùng dao cắt phần trước và sau của cánh gà
Dialogue: 0,0:23:34.21,0:23:35.92,Default,,0,0,0,,‎giúp thịt thấm đều gia vị hơn.
Dialogue: 0,0:23:38.92,0:23:40.55,Default,,0,0,0,,‎Ông chủ, đang nhìn gì thế?
Dialogue: 0,0:23:42.25,0:23:43.88,Default,,0,0,0,,‎Ảnh của chị Chizuru à?
Dialogue: 0,0:23:46.29,0:23:47.79,Default,,0,0,0,,‎Ông đã mua nó à?
Dialogue: 0,0:23:51.42,0:23:52.92,Default,,0,0,0,,‎Mời mọi người dùng bữa!
Dialogue: 0,0:25:11.00,0:25:12.46,Default,,0,0,0,,‎ĐÂY LÀ CÂU CHUYỆN HƯ CẤU
