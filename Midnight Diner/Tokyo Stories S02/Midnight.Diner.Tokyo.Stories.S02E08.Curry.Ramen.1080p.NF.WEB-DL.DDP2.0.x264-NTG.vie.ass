Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:04.04,0:01:08.33,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:01:09.00,0:01:10.79,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:28.17,0:01:32.75,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:32.83,0:01:36.21,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:41.75,0:01:43.71,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:43.79,0:01:45.58,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:50.63,0:01:56.13,Default,,0,0,0,,‎MÌ RAMEN CÀ RI
Dialogue: 0,0:01:57.63,0:01:59.21,Default,,0,0,0,,‎- Thêm ly nữa.\N‎- Cảm ơn.
Dialogue: 0,0:02:08.21,0:02:12.46,Default,,0,0,0,,‎- Hoan nghênh quý khách.\N‎- Ông có mì ramen cà ri không?
Dialogue: 0,0:02:13.58,0:02:14.79,Default,,0,0,0,,‎Mì ramen cà ri à?
Dialogue: 0,0:02:16.67,0:02:18.96,Default,,0,0,0,,‎Vậy mì ramen ở trên cà ri hay sao?
Dialogue: 0,0:02:20.04,0:02:22.92,Default,,0,0,0,,‎Thật ra là cà ri ở trên mì ramen.
Dialogue: 0,0:02:24.46,0:02:25.38,Default,,0,0,0,,‎Được.
Dialogue: 0,0:02:42.79,0:02:46.33,Default,,0,0,0,,{\i1}‎Vì có sẵn mì ăn liền vị muối,{\i0}
Dialogue: 0,0:02:46.42,0:02:48.50,Default,,0,0,0,,{\i1}‎nên tôi làm nước lèo{\i0}
Dialogue: 0,0:02:48.58,0:02:51.66,Default,,0,0,0,,{\i1}‎và cho ít cà ri tôi nấu lên trên.{\i0}
Dialogue: 0,0:03:05.21,0:03:07.29,Default,,0,0,0,,‎- Thế nào?\N‎- Ngon lắm.
Dialogue: 0,0:03:07.38,0:03:08.34,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:03:09.13,0:03:12.09,Default,,0,0,0,,{\i1}‎Tên anh ta là Kabayama.{\i0}
Dialogue: 0,0:03:12.17,0:03:17.21,Default,,0,0,0,,{\i1}‎Anh ta ghé vì nghe nói tôi sẽ nấu{\i0}\N{\i1}‎món ăn theo yêu cầu của khách.{\i0}
Dialogue: 0,0:03:18.29,0:03:19.87,Default,,0,0,0,,‎Cà ri và mì ramen...
Dialogue: 0,0:03:20.46,0:03:23.13,Default,,0,0,0,,‎Đúng là xa xỉ khi kết hợp hai món đó!
Dialogue: 0,0:03:24.42,0:03:26.75,Default,,0,0,0,,‎Cho tôi gọi nửa bát cơm nữa nhé?
Dialogue: 0,0:03:27.58,0:03:28.46,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:03:40.17,0:03:42.25,Default,,0,0,0,,‎Quả là sự kết hợp tuyệt vời!
Dialogue: 0,0:03:42.33,0:03:44.33,Default,,0,0,0,,‎Mì ramen và cơm.
Dialogue: 0,0:03:47.13,0:03:50.38,Default,,0,0,0,,‎Ăn quá nhiều\N‎cacbon hydrat sẽ tăng cân đấy.
Dialogue: 0,0:03:50.46,0:03:51.96,Default,,0,0,0,,‎Đặc biệt là ăn ban đêm.
Dialogue: 0,0:03:52.54,0:03:53.96,Default,,0,0,0,,‎Tôi biết.
Dialogue: 0,0:03:54.04,0:03:55.87,Default,,0,0,0,,‎Thật khó lý giải,
Dialogue: 0,0:03:55.96,0:04:00.92,Default,,0,0,0,,‎nhưng phản đối ăn mì ramen và cơm\N‎vào ban đêm lại khiến nó ngon hơn.
Dialogue: 0,0:04:01.50,0:04:03.79,Default,,0,0,0,,‎Ông chủ, mì ramen\N‎và nửa bát cơm chiên nhé!
Dialogue: 0,0:04:06.13,0:04:09.59,Default,,0,0,0,,‎Không được!\N‎Anh sẽ lại vào bệnh viện mất thôi!
Dialogue: 0,0:04:09.67,0:04:11.63,Default,,0,0,0,,‎Một chút cũng không được à?
Dialogue: 0,0:04:13.21,0:04:15.96,Default,,0,0,0,,‎Kiềm chế đi.
Dialogue: 0,0:04:16.04,0:04:18.29,Default,,0,0,0,,‎Bệnh tiểu đường của anh\N‎đã được kiểm soát rồi nhỉ?
Dialogue: 0,0:04:18.88,0:04:20.88,Default,,0,0,0,,‎Nhờ vợ anh làm y tá đó.
Dialogue: 0,0:04:22.71,0:04:24.42,Default,,0,0,0,,‎Hủy món đó nhé ông chủ.
Dialogue: 0,0:04:25.25,0:04:26.29,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:26.88,0:04:27.92,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:04:57.92,0:04:58.96,Default,,0,0,0,,‎Xin thứ lỗi...
Dialogue: 0,0:05:00.75,0:05:02.75,Default,,0,0,0,,‎Cậu là Shuichi Tachibana?
Dialogue: 0,0:05:05.00,0:05:05.96,Default,,0,0,0,,‎Anh là ai?
Dialogue: 0,0:05:07.21,0:05:08.04,Default,,0,0,0,,‎Kabayama.
Dialogue: 0,0:05:08.67,0:05:09.67,Default,,0,0,0,,‎Kabayama?
Dialogue: 0,0:05:09.75,0:05:11.92,Default,,0,0,0,,‎Chắc cậu không nhớ ra tôi.
Dialogue: 0,0:05:13.83,0:05:14.87,Default,,0,0,0,,‎Kabayama?
Dialogue: 0,0:05:18.29,0:05:20.87,Default,,0,0,0,,‎- Từ trường cấp hai Higashi?\N‎- Phải.
Dialogue: 0,0:05:22.83,0:05:23.83,Default,,0,0,0,,‎Dorkayama...
Dialogue: 0,0:05:25.54,0:05:26.96,Default,,0,0,0,,‎Tsuyoshi Dorkayama!
Dialogue: 0,0:05:28.13,0:05:30.67,Default,,0,0,0,,‎Ta học cùng lớp bảy, đúng không?
Dialogue: 0,0:05:31.67,0:05:34.17,Default,,0,0,0,,‎- Cậu sao rồi?\N‎- Ừ.
Dialogue: 0,0:05:35.63,0:05:38.17,Default,,0,0,0,,‎Ông chủ, cho hai bát mì như mọi khi.
Dialogue: 0,0:05:38.25,0:05:39.13,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:05:40.17,0:05:44.05,Default,,0,0,0,,‎Thật trùng hợp\N‎khi tình cờ gặp bạn học cũ như thế.
Dialogue: 0,0:05:45.13,0:05:46.34,Default,,0,0,0,,‎Quả đúng vậy.
Dialogue: 0,0:05:47.58,0:05:49.62,Default,,0,0,0,,‎Thật ngạc nhiên khi cậu nhận ra tôi,
Dialogue: 0,0:05:49.71,0:05:51.79,Default,,0,0,0,,‎dù ta chưa gặp lại từ hồi tốt nghiệp.
Dialogue: 0,0:05:51.88,0:05:54.38,Default,,0,0,0,,‎Dĩ nhiên tôi nhận ra cậu.
Dialogue: 0,0:05:54.46,0:05:58.00,Default,,0,0,0,,‎Cậu ta từng là chủ tịch hội học sinh\N‎và đội trưởng đội bóng mà.
Dialogue: 0,0:05:58.08,0:06:00.25,Default,,0,0,0,,‎Đám con gái luôn vây quanh cậu ta.
Dialogue: 0,0:06:01.13,0:06:04.51,Default,,0,0,0,,‎Vậy anh giống diễn viên Yujiro Ishihara?
Dialogue: 0,0:06:05.29,0:06:07.92,Default,,0,0,0,,‎Ông đang sống ở thời nào vậy?\N‎Đừng thổi phồng chứ.
Dialogue: 0,0:06:09.00,0:06:13.92,Default,,0,0,0,,‎Cậu ta từng là người hùng của tôi. Không,\N‎không phải của mỗi tôi, của mọi người.
Dialogue: 0,0:06:14.00,0:06:15.92,Default,,0,0,0,,‎Thôi đi.
Dialogue: 0,0:06:16.00,0:06:17.38,Default,,0,0,0,,‎Họ đang nghe đấy.
Dialogue: 0,0:06:17.46,0:06:19.71,Default,,0,0,0,,‎Vậy chuyện gì xảy ra sau đó?
Dialogue: 0,0:06:20.29,0:06:22.21,Default,,0,0,0,,‎Cậu ta học trường tư,
Dialogue: 0,0:06:22.29,0:06:24.42,Default,,0,0,0,,‎và đội bóng của cậu ta\N‎là một trong các đội tốt nhất của quận.
Dialogue: 0,0:06:25.50,0:06:27.13,Default,,0,0,0,,‎Cậu biết nhiều về tôi đấy.
Dialogue: 0,0:06:27.21,0:06:29.79,Default,,0,0,0,,‎Khi nghe nói cậu vào được\N‎trường Đại học Hitotsubashi,
Dialogue: 0,0:06:29.88,0:06:32.42,Default,,0,0,0,,‎tôi đã đi uống mừng.
Dialogue: 0,0:06:32.50,0:06:34.92,Default,,0,0,0,,‎Sao? Thôi đi, anh bạn, kỳ quá đấy!
Dialogue: 0,0:06:35.92,0:06:37.34,Default,,0,0,0,,‎Giờ cậu đang làm gì?
Dialogue: 0,0:06:38.63,0:06:39.59,Default,,0,0,0,,‎Bây giờ?
Dialogue: 0,0:06:40.71,0:06:41.75,Default,,0,0,0,,‎Bây giờ...
Dialogue: 0,0:06:42.63,0:06:45.42,Default,,0,0,0,,‎tôi đang kiên nhẫn chờ đợi một cơ hội tốt.
Dialogue: 0,0:06:45.50,0:06:47.38,Default,,0,0,0,,‎Đợi thời điểm để tấn công.
Dialogue: 0,0:06:49.63,0:06:52.21,Default,,0,0,0,,‎Của hai anh đây, mì ramen cà ri.
Dialogue: 0,0:06:54.96,0:06:56.96,Default,,0,0,0,,‎Món này khiến tôi nhớ hồi xưa!
Dialogue: 0,0:06:57.04,0:06:59.46,Default,,0,0,0,,‎Đây là món tôi thích hồi cấp hai!
Dialogue: 0,0:06:59.54,0:07:01.29,Default,,0,0,0,,‎- Cậu cũng vậy chứ, Kabayama?\N‎- Ừ.
Dialogue: 0,0:07:02.92,0:07:04.21,Default,,0,0,0,,‎Xin cảm ơn.
Dialogue: 0,0:07:07.58,0:07:08.87,Default,,0,0,0,,‎Ngon quá.
Dialogue: 0,0:07:09.46,0:07:12.75,Default,,0,0,0,,‎Tôi nấu cà ri tối qua.
Dialogue: 0,0:07:12.83,0:07:14.87,Default,,0,0,0,,‎Đó là cách để nấu món này.
Dialogue: 0,0:07:21.29,0:07:23.54,Default,,0,0,0,,‎Sao tôi từng ăn món thế này suốt cơ chứ?
Dialogue: 0,0:07:26.63,0:07:30.30,Default,,0,0,0,,‎Kabayama, cho tôi mượn ít tiền nhé?
Dialogue: 0,0:07:32.54,0:07:33.71,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:07:37.25,0:07:40.00,Default,,0,0,0,,‎Trong túi tôi chỉ còn 20.000 yên.
Dialogue: 0,0:07:40.08,0:07:43.83,Default,,0,0,0,,‎Không sao. Tôi sẽ trả lại cậu\N‎gấp đôi sau khi thắng cá cược đua ngựa.
Dialogue: 0,0:07:52.33,0:07:53.79,Default,,0,0,0,,‎Tachibana rất tuyệt vời.
Dialogue: 0,0:07:53.88,0:07:57.51,Default,,0,0,0,,‎Lần trước trả lại tôi\N‎gấp ba số tiền cậu ta mượn.
Dialogue: 0,0:07:58.17,0:08:02.46,Default,,0,0,0,,‎Không phải anh nên cẩn thận\N‎khi lẫn lộn tình bạn và tiền bạc sao?
Dialogue: 0,0:08:03.33,0:08:06.66,Default,,0,0,0,,‎Có câu, "Khi tiền hết\N‎thì tình bạn cũng chẳng còn".
Dialogue: 0,0:08:12.63,0:08:15.67,Default,,0,0,0,,‎- Này!\N‎- Tachibana!
Dialogue: 0,0:08:16.46,0:08:18.67,Default,,0,0,0,,‎- Hoan nghênh.\N‎- Hai bát mì ramen cà ri nhé.
Dialogue: 0,0:08:18.75,0:08:19.92,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:08:22.46,0:08:24.25,Default,,0,0,0,,‎Hinano nói muốn ăn thử.
Dialogue: 0,0:08:32.58,0:08:33.54,Default,,0,0,0,,‎Thế nào?
Dialogue: 0,0:08:35.88,0:08:38.30,Default,,0,0,0,,‎Có thể ngon hơn với phô mai tan chảy.
Dialogue: 0,0:08:39.17,0:08:41.92,Default,,0,0,0,,‎Ông chủ, cho ít phô mai\N‎để ăn mì cà ri nhé?
Dialogue: 0,0:08:42.00,0:08:43.00,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:08:57.50,0:09:00.96,Default,,0,0,0,,‎Phụ nữ luôn muốn\N‎thêm phô mai vào mọi thứ, đúng không?
Dialogue: 0,0:09:02.29,0:09:04.04,Default,,0,0,0,,‎Cà ri với mì ramen với...
Dialogue: 0,0:09:04.79,0:09:06.08,Default,,0,0,0,,‎phô mai sao?
Dialogue: 0,0:09:08.54,0:09:11.00,Default,,0,0,0,,‎Hinano, đưa danh thiếp cho cậu ta đi.
Dialogue: 0,0:09:16.83,0:09:18.33,Default,,0,0,0,,‎Hân hạnh được gặp anh.
Dialogue: 0,0:09:18.42,0:09:20.09,Default,,0,0,0,,‎Thỉnh thoảng hãy ghé chỗ cô ấy.
Dialogue: 0,0:09:20.88,0:09:23.26,Default,,0,0,0,,‎- Tôi là Kabayama.\N‎- Rất vui được gặp anh.
Dialogue: 0,0:09:23.33,0:09:24.25,Default,,0,0,0,,‎Kaba{\i1}‎-chan!{\i0}
Dialogue: 0,0:09:25.00,0:09:26.71,Default,,0,0,0,,‎- Kaba{\i1}‎-chan?{\i0}\N‎- Kaba{\i1}‎-chan.{\i0}
Dialogue: 0,0:09:48.63,0:09:49.63,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:09:52.46,0:09:55.67,Default,,0,0,0,,{\i1}‎Chẳng mấy chốc, Kabayama và Tachibana{\i0}
Dialogue: 0,0:09:55.75,0:09:59.08,Default,,0,0,0,,{\i1}‎trở thành bạn tốt lần nữa,{\i0}\N{\i1}‎giống như thời học sinh.{\i0}
Dialogue: 0,0:10:05.17,0:10:06.13,Default,,0,0,0,,‎Đây.
Dialogue: 0,0:10:07.67,0:10:08.59,Default,,0,0,0,,‎Cảm ơn nhé.
Dialogue: 0,0:10:11.54,0:10:12.75,Default,,0,0,0,,‎Hôm qua thế nào rồi?
Dialogue: 0,0:10:13.88,0:10:14.84,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:10:14.92,0:10:17.59,Default,,0,0,0,,‎Phỏng vấn làm thêm ở cửa hàng tiện lợi.
Dialogue: 0,0:10:19.33,0:10:20.16,Default,,0,0,0,,‎Anh không đi.
Dialogue: 0,0:10:20.75,0:10:21.58,Default,,0,0,0,,‎Tại sao?
Dialogue: 0,0:10:26.08,0:10:28.46,Default,,0,0,0,,‎Công việc đó không dành cho anh,\N‎em biết mà?
Dialogue: 0,0:10:29.96,0:10:32.88,Default,,0,0,0,,‎Vậy công việc nào?\N‎Nếu công việc này không đủ tốt cho anh,
Dialogue: 0,0:10:32.96,0:10:34.29,Default,,0,0,0,,‎vậy công việc nào hả?
Dialogue: 0,0:11:02.13,0:11:04.09,Default,,0,0,0,,‎Kaba{\i1}‎-chan{\i0}‎, anh đến rồi!
Dialogue: 0,0:11:04.17,0:11:05.25,Default,,0,0,0,,‎Tôi rất vui.
Dialogue: 0,0:11:05.33,0:11:07.16,Default,,0,0,0,,‎Vì tôi đã hứa với Tachibana.
Dialogue: 0,0:11:07.92,0:11:08.88,Default,,0,0,0,,‎Mời anh ngồi.
Dialogue: 0,0:11:12.13,0:11:15.42,Default,,0,0,0,,‎Sau đó trưởng phòng chi nhánh\N‎tại cửa hàng Kameido nghỉ việc
Dialogue: 0,0:11:15.50,0:11:17.58,Default,,0,0,0,,‎nên sếp giới thiệu vị trí đó cho tôi.
Dialogue: 0,0:11:18.25,0:11:19.46,Default,,0,0,0,,‎Thật tuyệt!
Dialogue: 0,0:11:19.54,0:11:20.87,Default,,0,0,0,,‎Anh sẽ được thăng chức thành trưởng phòng.
Dialogue: 0,0:11:25.42,0:11:28.67,Default,,0,0,0,,‎Kaba{\i1}‎-chan{\i0}‎, sao anh lại ngưỡng mộ Shu{\i1}‎-chan?{\i0}
Dialogue: 0,0:11:34.08,0:11:37.46,Default,,0,0,0,,‎Anh có công việc ổn định.\N‎Anh đang làm tốt hơn anh ấy nhiều.
Dialogue: 0,0:11:44.17,0:11:45.63,Default,,0,0,0,,‎Tôi thấy khó chịu...
Dialogue: 0,0:11:46.21,0:11:48.67,Default,,0,0,0,,‎khi anh cứ bám lấy anh ấy như thế.
Dialogue: 0,0:11:48.75,0:11:50.04,Default,,0,0,0,,‎Việc này khiến tôi nhớ về chính tôi.
Dialogue: 0,0:11:53.17,0:11:54.00,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:11:58.71,0:11:59.96,Default,,0,0,0,,‎Chắc...
Dialogue: 0,0:12:01.79,0:12:03.04,Default,,0,0,0,,‎cả hai ta đều muốn tin tưởng.
Dialogue: 0,0:12:13.17,0:12:16.17,Default,,0,0,0,,‎Cuối cùng tôi cũng thắng,\N‎nên làm ơn, chỉ một tiếng nữa thôi...
Dialogue: 0,0:12:16.75,0:12:18.13,Default,,0,0,0,,‎Đừng có ồn ào.
Dialogue: 0,0:12:18.71,0:12:20.34,Default,,0,0,0,,‎Tôi xin các anh!
Dialogue: 0,0:12:22.04,0:12:23.71,Default,,0,0,0,,‎- Làm ơn...\N‎- Đi thôi.
Dialogue: 0,0:12:28.46,0:12:29.75,Default,,0,0,0,,‎Mày...
Dialogue: 0,0:12:29.83,0:12:31.08,Default,,0,0,0,,‎có ba quả thận nhỉ?
Dialogue: 0,0:12:32.83,0:12:34.21,Default,,0,0,0,,‎Tôi có hai thôi.
Dialogue: 0,0:12:34.79,0:12:36.17,Default,,0,0,0,,‎Bọn tao sẽ lấy đi một quả.
Dialogue: 0,0:12:36.25,0:12:37.17,Default,,0,0,0,,‎Bình tĩnh.
Dialogue: 0,0:12:37.83,0:12:40.21,Default,,0,0,0,,‎Mày mang ví chứ? Có bao nhiêu?
Dialogue: 0,0:12:45.13,0:12:47.09,Default,,0,0,0,,‎Phải cho mày vay thêm thôi.
Dialogue: 0,0:12:48.08,0:12:48.91,Default,,0,0,0,,‎Đứng dậy.
Dialogue: 0,0:12:49.54,0:12:50.46,Default,,0,0,0,,‎Đứng dậy thôi.
Dialogue: 0,0:12:51.46,0:12:52.67,Default,,0,0,0,,‎Khoan đã!
Dialogue: 0,0:12:53.58,0:12:55.12,Default,,0,0,0,,‎Xin đợi chút.
Dialogue: 0,0:12:55.21,0:12:57.29,Default,,0,0,0,,‎Cầm cái này đi.
Dialogue: 0,0:12:58.50,0:13:00.42,Default,,0,0,0,,‎- Cậu định...\N‎- Không sao.
Dialogue: 0,0:13:00.50,0:13:02.75,Default,,0,0,0,,‎Cậu có thể trả dần cho tôi.
Dialogue: 0,0:13:03.79,0:13:05.54,Default,,0,0,0,,‎Được. Nếu mày muốn vậy.
Dialogue: 0,0:13:06.54,0:13:08.17,Default,,0,0,0,,‎Hôm nay chỉ vậy thôi, nhóc à.
Dialogue: 0,0:13:08.25,0:13:10.13,Default,,0,0,0,,‎Tình bạn đẹp thật đấy!
Dialogue: 0,0:13:19.13,0:13:20.13,Default,,0,0,0,,‎Tôi...
Dialogue: 0,0:13:23.33,0:13:26.16,Default,,0,0,0,,‎không thực sự nhớ ra cậu.
Dialogue: 0,0:13:26.88,0:13:28.96,Default,,0,0,0,,‎Quyển kỷ yếu tôi cũng làm mất rồi.
Dialogue: 0,0:13:57.42,0:13:58.50,Default,,0,0,0,,‎Còn mở cửa chứ ạ?
Dialogue: 0,0:14:07.42,0:14:09.38,Default,,0,0,0,,‎Số tiền đó chẳng là gì...
Dialogue: 0,0:14:11.29,0:14:14.54,Default,,0,0,0,,‎Tôi không cần cậu ta.\N‎Nếu tôi thực sự muốn...
Dialogue: 0,0:14:14.63,0:14:16.71,Default,,0,0,0,,‎Tôi có thể trả lại ngay!
Dialogue: 0,0:14:20.04,0:14:23.50,Default,,0,0,0,,‎Ông nghĩ tôi đang nói dối, đúng không?
Dialogue: 0,0:14:24.54,0:14:27.33,Default,,0,0,0,,‎Tôi sẽ làm được! Có thể làm được!
Dialogue: 0,0:14:28.13,0:14:31.09,Default,,0,0,0,,‎Mọi người tin vào tôi,\N‎và tôi chưa từng khiến họ thất vọng!
Dialogue: 0,0:14:33.88,0:14:35.13,Default,,0,0,0,,‎Ông chủ, thêm chai nữa.
Dialogue: 0,0:14:36.00,0:14:37.00,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:14:37.54,0:14:40.54,Default,,0,0,0,,‎Tối đa ba chai một người thôi.
Dialogue: 0,0:14:47.00,0:14:49.63,Default,,0,0,0,,‎Tôi sẽ gọi Dorkayama rồi đi nơi khác.
Dialogue: 0,0:14:50.21,0:14:51.38,Default,,0,0,0,,‎Kabayama...
Dialogue: 0,0:14:52.04,0:14:53.71,Default,,0,0,0,,‎Cậu chỉ đang lợi dụng anh ta.
Dialogue: 0,0:14:55.92,0:14:58.50,Default,,0,0,0,,‎Vì cậu ấy muốn tôi lợi dụng.
Dialogue: 0,0:15:00.58,0:15:02.08,Default,,0,0,0,,‎Cậu là tuýp người...
Dialogue: 0,0:15:03.54,0:15:06.00,Default,,0,0,0,,‎thiếu lòng tin, chỉ có tự phụ thôi.
Dialogue: 0,0:15:09.92,0:15:12.17,Default,,0,0,0,,‎Ông đâu biết gì về tôi.
Dialogue: 0,0:15:15.75,0:15:17.29,Default,,0,0,0,,‎Không dễ dàng gì nhỉ?
Dialogue: 0,0:15:18.58,0:15:20.16,Default,,0,0,0,,‎Thừa nhận điểm yếu của mình.
Dialogue: 0,0:15:21.54,0:15:22.37,Default,,0,0,0,,‎Nhưng...
Dialogue: 0,0:15:24.33,0:15:26.29,Default,,0,0,0,,‎dù cậu có giả vờ bao lâu đi nữa,
Dialogue: 0,0:15:26.38,0:15:27.80,Default,,0,0,0,,‎sẽ chẳng có gì thay đổi.
Dialogue: 0,0:15:29.00,0:15:30.54,Default,,0,0,0,,‎Vấp ngã chẳng sao cả.
Dialogue: 0,0:15:32.08,0:15:34.50,Default,,0,0,0,,‎Miễn là cậu cư xử thành thật...
Dialogue: 0,0:15:35.67,0:15:38.42,Default,,0,0,0,,‎ngày nào đó cậu sẽ nhận ra\N‎con người thật của mình.
Dialogue: 0,0:15:39.67,0:15:40.71,Default,,0,0,0,,‎Cậu biết chứ?
Dialogue: 0,0:15:56.13,0:16:01.05,Default,,0,0,0,,{\i1}‎Sau đêm đó, Tachibana hoàn toàn biến mất.{\i0}
Dialogue: 0,0:16:27.42,0:16:28.96,Default,,0,0,0,,‎Họ lại đến.
Dialogue: 0,0:16:30.13,0:16:32.46,Default,,0,0,0,,‎- Hoan nghênh.\N‎- Rượu shochu với nước cốt chanh nhé.
Dialogue: 0,0:16:32.54,0:16:33.37,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:16:34.46,0:16:36.34,Default,,0,0,0,,‎Ngày nào họ cũng ở đây.
Dialogue: 0,0:16:36.42,0:16:39.34,Default,,0,0,0,,‎Dù anh ta đã đi được hai tháng rồi,
Dialogue: 0,0:16:39.42,0:16:40.84,Default,,0,0,0,,‎họ vẫn đợi.
Dialogue: 0,0:16:43.50,0:16:45.63,Default,,0,0,0,,‎Họ tin vào anh ta nhỉ?
Dialogue: 0,0:16:46.67,0:16:48.38,Default,,0,0,0,,‎Hiếm thật. Tôi nghĩ điều đó thật tuyệt.
Dialogue: 0,0:16:52.04,0:16:52.87,Default,,0,0,0,,‎Này...
Dialogue: 0,0:16:54.67,0:16:56.05,Default,,0,0,0,,‎Từ bỏ thôi.
Dialogue: 0,0:16:57.46,0:17:00.38,Default,,0,0,0,,‎Shu{\i1}‎-chan{\i0}‎ hẳn đã tìm thấy\N‎người phụ nữ khác và sống cùng rồi.
Dialogue: 0,0:17:06.13,0:17:08.42,Default,,0,0,0,,‎Anh không giận chuyện anh ấy đã làm ư?
Dialogue: 0,0:17:13.92,0:17:15.25,Default,,0,0,0,,‎Tôi về nhà đây.
Dialogue: 0,0:17:18.58,0:17:19.79,Default,,0,0,0,,‎Cậu ở đây.
Dialogue: 0,0:17:26.92,0:17:27.84,Default,,0,0,0,,‎Đây...
Dialogue: 0,0:17:29.42,0:17:30.63,Default,,0,0,0,,‎Tôi trả lại cậu.
Dialogue: 0,0:17:33.17,0:17:34.50,Default,,0,0,0,,‎Xin lỗi vì giờ mới trả cậu.
Dialogue: 0,0:17:35.83,0:17:37.00,Default,,0,0,0,,‎Sao anh có được số tiền đó?
Dialogue: 0,0:17:40.13,0:17:42.26,Default,,0,0,0,,‎Anh tìm được việc và sống ở chỗ làm.
Dialogue: 0,0:17:44.54,0:17:46.04,Default,,0,0,0,,‎Anh đi làm đấy!
Dialogue: 0,0:17:50.63,0:17:51.88,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:17:52.50,0:17:54.21,Default,,0,0,0,,‎- Hoan nghênh.\N‎- Xin chào.
Dialogue: 0,0:17:54.29,0:17:56.12,Default,,0,0,0,,‎- Bia nhé.\N‎- Vâng.
Dialogue: 0,0:17:56.21,0:17:57.25,Default,,0,0,0,,‎Và...
Dialogue: 0,0:17:58.79,0:18:00.50,Default,,0,0,0,,‎ba mì ramen cà ri.
Dialogue: 0,0:18:01.67,0:18:02.55,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:18:04.42,0:18:05.30,Default,,0,0,0,,‎Ngồi đi.
Dialogue: 0,0:18:08.46,0:18:12.59,Default,,0,0,0,,‎Tôi cũng làm bảo vệ\N‎vào ban đêm khi sung sức.
Dialogue: 0,0:18:17.21,0:18:20.25,Default,,0,0,0,,‎Này, đừng dễ xúc động như thế!
Dialogue: 0,0:18:21.83,0:18:23.91,Default,,0,0,0,,‎Mọi người đang nghe đấy!
Dialogue: 0,0:18:25.42,0:18:26.25,Default,,0,0,0,,‎Được chứ?
Dialogue: 0,0:18:39.33,0:18:40.25,Default,,0,0,0,,‎Tôi...
Dialogue: 0,0:18:41.33,0:18:43.79,Default,,0,0,0,,‎miệt mài làm việc ngày đêm,
Dialogue: 0,0:18:44.38,0:18:45.71,Default,,0,0,0,,‎và cuối cùng đã hiểu.
Dialogue: 0,0:18:47.21,0:18:51.29,Default,,0,0,0,,‎Tôi sống cả đời với suy nghĩ\N‎tôi cần đáp ứng mong đợi của mọi người.
Dialogue: 0,0:18:52.00,0:18:53.29,Default,,0,0,0,,‎Tôi đã đòi hỏi quá nhiều ở bản thân.
Dialogue: 0,0:18:55.75,0:18:57.83,Default,,0,0,0,,‎Nhưng tôi chưa trưởng thành.
Dialogue: 0,0:19:00.29,0:19:02.67,Default,,0,0,0,,‎Em biết anh rõ nhất nhỉ?
Dialogue: 0,0:19:06.29,0:19:07.21,Default,,0,0,0,,‎Vậy nên...
Dialogue: 0,0:19:08.96,0:19:10.00,Default,,0,0,0,,‎Kabayama.
Dialogue: 0,0:19:10.96,0:19:11.84,Default,,0,0,0,,‎Xin cậu...
Dialogue: 0,0:19:12.83,0:19:14.91,Default,,0,0,0,,‎đừng ngưỡng mộ tôi nữa.
Dialogue: 0,0:19:15.92,0:19:19.38,Default,,0,0,0,,‎Hãy xem tôi là kẻ ngốc thôi.
Dialogue: 0,0:19:20.54,0:19:21.37,Default,,0,0,0,,‎Được chứ?
Dialogue: 0,0:19:30.58,0:19:31.79,Default,,0,0,0,,‎Tachibana...
Dialogue: 0,0:19:33.75,0:19:34.79,Default,,0,0,0,,‎Tôi...
Dialogue: 0,0:19:35.50,0:19:36.63,Default,,0,0,0,,‎không phải Kabayama.
Dialogue: 0,0:19:39.46,0:19:42.29,Default,,0,0,0,,‎Ý tôi là, họ của tôi\N‎đúng là Kabayama, nhưng...
Dialogue: 0,0:19:43.54,0:19:44.54,Default,,0,0,0,,‎tôi là em trai.
Dialogue: 0,0:19:45.50,0:19:48.46,Default,,0,0,0,,‎Tôi là Takeharu,\N‎em trai bạn học cùng lớp của anh.
Dialogue: 0,0:19:50.33,0:19:52.16,Default,,0,0,0,,‎Em trai? Hả?
Dialogue: 0,0:19:52.25,0:19:53.75,Default,,0,0,0,,‎Dĩ nhiên, anh không nhớ ra.
Dialogue: 0,0:19:55.33,0:19:57.33,Default,,0,0,0,,‎Vậy chuyện gì xảy ra với cậu ấy?
Dialogue: 0,0:19:59.67,0:20:00.96,Default,,0,0,0,,‎Anh trai tôi...
Dialogue: 0,0:20:02.13,0:20:03.30,Default,,0,0,0,,‎qua đời rồi.
Dialogue: 0,0:20:04.38,0:20:05.55,Default,,0,0,0,,‎Sáu năm trước.
Dialogue: 0,0:20:11.54,0:20:13.50,Default,,0,0,0,,‎Trên đường đi họp lớp
Dialogue: 0,0:20:14.08,0:20:15.41,Default,,0,0,0,,‎thì bị xe tông.
Dialogue: 0,0:20:17.13,0:20:18.05,Default,,0,0,0,,‎Tôi...
Dialogue: 0,0:20:19.25,0:20:21.63,Default,,0,0,0,,‎ghét anh trai mình làm đầy tớ của anh.
Dialogue: 0,0:20:22.88,0:20:24.05,Default,,0,0,0,,‎Tôi đã cười nhạo anh ấy.
Dialogue: 0,0:20:26.13,0:20:27.17,Default,,0,0,0,,‎Và sau đó...
Dialogue: 0,0:20:28.79,0:20:29.87,Default,,0,0,0,,‎anh ấy chết.
Dialogue: 0,0:20:32.88,0:20:35.17,Default,,0,0,0,,‎Tôi ghét bản thân mình\N‎vì đã coi thường anh ấy,
Dialogue: 0,0:20:36.25,0:20:38.63,Default,,0,0,0,,‎nên tôi đã cố gắng không nghĩ về anh ấy.
Dialogue: 0,0:20:41.13,0:20:43.21,Default,,0,0,0,,‎Sao anh lại giả vờ là anh ấy?
Dialogue: 0,0:20:43.96,0:20:45.00,Default,,0,0,0,,‎Chà...
Dialogue: 0,0:20:45.58,0:20:48.62,Default,,0,0,0,,‎Là do Tachibana hiểu lầm.
Dialogue: 0,0:20:52.29,0:20:53.50,Default,,0,0,0,,‎Nhưng tôi nghĩ...
Dialogue: 0,0:20:55.08,0:20:56.66,Default,,0,0,0,,‎nếu giả vờ làm anh trai
Dialogue: 0,0:20:57.25,0:20:59.04,Default,,0,0,0,,‎và ở cùng Tachibana...
Dialogue: 0,0:21:00.75,0:21:01.79,Default,,0,0,0,,‎chắc...
Dialogue: 0,0:21:02.96,0:21:04.92,Default,,0,0,0,,‎tôi có thể hiểu anh trai mình một chút.
Dialogue: 0,0:21:10.21,0:21:11.38,Default,,0,0,0,,‎Anh Tachibana...
Dialogue: 0,0:21:12.79,0:21:14.00,Default,,0,0,0,,‎Hinano...
Dialogue: 0,0:21:17.04,0:21:18.33,Default,,0,0,0,,‎tôi xin lỗi...
Dialogue: 0,0:21:19.58,0:21:20.58,Default,,0,0,0,,‎vì đã nói dối.
Dialogue: 0,0:21:22.46,0:21:23.34,Default,,0,0,0,,‎Không...
Dialogue: 0,0:21:26.21,0:21:27.29,Default,,0,0,0,,‎Vào ngày anh ấy chết...
Dialogue: 0,0:21:28.75,0:21:33.04,Default,,0,0,0,,‎tôi có nói, "Đừng đi họp lớp\N‎chỉ vì muốn gặp Tachibana.
Dialogue: 0,0:21:34.96,0:21:36.21,Default,,0,0,0,,‎Anh đã lớn rồi,
Dialogue: 0,0:21:36.88,0:21:39.34,Default,,0,0,0,,‎nhưng vẫn dựa vào anh ta mọi thứ".
Dialogue: 0,0:21:41.92,0:21:42.92,Default,,0,0,0,,‎Và anh ấy nói...
Dialogue: 0,0:21:44.63,0:21:45.88,Default,,0,0,0,,‎"Em không hiểu đâu,
Dialogue: 0,0:21:46.88,0:21:49.01,Default,,0,0,0,,‎nhưng Tachibana là người tốt".
Dialogue: 0,0:21:50.08,0:21:51.25,Default,,0,0,0,,‎Và anh ấy mỉm cười.
Dialogue: 0,0:21:59.71,0:22:01.38,Default,,0,0,0,,‎Tôi đưa anh số tiền đó...
Dialogue: 0,0:22:02.79,0:22:05.58,Default,,0,0,0,,‎vì đó là điều anh trai tôi hẳn sẽ làm.
Dialogue: 0,0:22:13.75,0:22:16.54,Default,,0,0,0,,‎Anh trai tôi đã không nhìn lầm.
Dialogue: 0,0:22:20.50,0:22:22.63,Default,,0,0,0,,‎Đúng không, Hinano?
Dialogue: 0,0:22:32.08,0:22:32.91,Default,,0,0,0,,‎Của ba người đây.
Dialogue: 0,0:22:37.63,0:22:38.67,Default,,0,0,0,,‎Tôi nhớ rồi!
Dialogue: 0,0:22:40.75,0:22:43.08,Default,,0,0,0,,‎Lần đầu tiên ăn món này là ở nhà cậu.
Dialogue: 0,0:22:43.71,0:22:45.17,Default,,0,0,0,,‎Cậu ấy nấu nó cho tôi.
Dialogue: 0,0:22:52.71,0:22:53.67,Default,,0,0,0,,‎Takeharu.
Dialogue: 0,0:22:56.08,0:22:57.16,Default,,0,0,0,,‎Cậu đưa tôi...
Dialogue: 0,0:22:57.88,0:22:59.59,Default,,0,0,0,,‎đi thăm mộ anh trai cậu nhé?
Dialogue: 0,0:23:00.96,0:23:02.38,Default,,0,0,0,,‎Tôi đi nữa nhé?
Dialogue: 0,0:23:03.33,0:23:06.04,Default,,0,0,0,,‎Tôi nghĩ anh trai tôi sẽ thích thế.
Dialogue: 0,0:23:10.92,0:23:12.92,Default,,0,0,0,,‎- Cảm ơn.\N‎- Cảm ơn.
Dialogue: 0,0:23:13.00,0:23:14.17,Default,,0,0,0,,‎Xin cảm ơn.
Dialogue: 0,0:23:23.92,0:23:26.84,Default,,0,0,0,,‎Giờ tôi cũng muốn ăn mì ramen cà ri.
Dialogue: 0,0:23:26.92,0:23:27.75,Default,,0,0,0,,‎Đúng nhỉ?
Dialogue: 0,0:23:28.42,0:23:31.00,Default,,0,0,0,,‎Ông chủ, ba mì ramen cà ri.
Dialogue: 0,0:23:34.92,0:23:36.30,Default,,0,0,0,,‎Thật ra là bốn.
Dialogue: 0,0:23:37.21,0:23:38.04,Default,,0,0,0,,‎Anh cũng được ăn à?
Dialogue: 0,0:23:38.63,0:23:40.88,Default,,0,0,0,,‎Chỉ hôm nay thôi.
Dialogue: 0,0:23:42.42,0:23:45.05,Default,,0,0,0,,‎Ông chủ, bát của tôi cho nhiều vào nhé!
Dialogue: 0,0:23:45.13,0:23:46.21,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:23:51.58,0:23:52.71,Default,,0,0,0,,‎Của mọi người đây.
Dialogue: 0,0:23:53.75,0:23:54.75,Default,,0,0,0,,‎Và của cô.
Dialogue: 0,0:24:08.33,0:24:12.37,Default,,0,0,0,,‎Dùng ít nước lèo\N‎giúp cân bằng mì và cà ri.
Dialogue: 0,0:24:12.46,0:24:13.46,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:24:14.75,0:24:16.83,Default,,0,0,0,,‎Tôi cũng khuyên\N‎nên ăn kèm với phô mai bào sợi.
Dialogue: 0,0:24:29.71,0:24:31.00,Default,,0,0,0,,‎Sau đó...
Dialogue: 0,0:24:31.08,0:24:32.50,Default,,0,0,0,,‎- Ngủ ngon.\N‎- Ngủ ngon.
