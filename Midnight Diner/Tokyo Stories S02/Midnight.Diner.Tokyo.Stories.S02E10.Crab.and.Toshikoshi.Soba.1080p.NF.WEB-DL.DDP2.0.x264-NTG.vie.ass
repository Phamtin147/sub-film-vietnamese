Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:04.50,0:01:08.92,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:01:09.54,0:01:11.17,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:28.67,0:01:32.88,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:33.46,0:01:36.88,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:42.33,0:01:44.16,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:44.25,0:01:46.58,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:50.75,0:01:56.79,Default,,0,0,0,,‎CUA VÀ MÌ SOBA TRƯỜNG THỌ
Dialogue: 0,0:01:58.00,0:02:00.42,Default,,0,0,0,,‎Tuyệt, vậy ta nên đi uống tiếp ở đâu?
Dialogue: 0,0:02:01.96,0:02:03.09,Default,,0,0,0,,‎Một chú thỏ khổng lồ!
Dialogue: 0,0:02:03.92,0:02:04.92,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:02:14.29,0:02:15.71,Default,,0,0,0,,‎Đùa thôi!
Dialogue: 0,0:02:16.96,0:02:20.21,Default,,0,0,0,,‎Nhìn này! Là chó đưa thư đấy!
Dialogue: 0,0:02:30.67,0:02:31.67,Default,,0,0,0,,‎Buông ra!
Dialogue: 0,0:02:32.33,0:02:33.83,Default,,0,0,0,,‎- Buông ra!\N‎- Ui!
Dialogue: 0,0:03:06.63,0:03:08.30,Default,,0,0,0,,‎Đúng thứ tôi cần!
Dialogue: 0,0:03:09.92,0:03:13.17,Default,,0,0,0,,‎Cảm ơn đã ngăn tôi lại.\N‎Suýt nữa là mất rất nhiều tiền.
Dialogue: 0,0:03:13.71,0:03:17.29,Default,,0,0,0,,‎Anh sẽ sớm mất việc\N‎nếu cứ nổi điên mấy chuyện như thế.
Dialogue: 0,0:03:19.00,0:03:23.04,Default,,0,0,0,,‎Tôi thích mặc đồ linh vật hơn nhiều.\N‎Tốt hơn mấy bộ đồ cosplay kỳ quặc.
Dialogue: 0,0:03:23.13,0:03:24.46,Default,,0,0,0,,‎Tiền lương khác chứ?
Dialogue: 0,0:03:25.67,0:03:27.92,Default,,0,0,0,,‎Cosplay nhiều hơn 100 yên.
Dialogue: 0,0:03:28.54,0:03:29.58,Default,,0,0,0,,‎Trước đây,
Dialogue: 0,0:03:30.21,0:03:33.29,Default,,0,0,0,,‎tôi phải mặc đồ hoạt náo viên\N‎tại một cửa hàng ở Ibaraki.
Dialogue: 0,0:03:33.38,0:03:35.17,Default,,0,0,0,,‎- Thật ư?\N‎- Tiền được trả bí mật.
Dialogue: 0,0:03:35.75,0:03:38.58,Default,,0,0,0,,‎Chỉ tính phí đi tàu đã là 2.000 yên.
Dialogue: 0,0:03:38.67,0:03:39.88,Default,,0,0,0,,‎Như đi du lịch trong ngày vậy!
Dialogue: 0,0:03:42.04,0:03:44.33,Default,,0,0,0,,‎Mà ramen này bao nhiêu nhỉ? Mười yên?
Dialogue: 0,0:03:44.42,0:03:47.38,Default,,0,0,0,,‎Không, 750 yên. Bao gồm thuế.
Dialogue: 0,0:03:47.46,0:03:48.71,Default,,0,0,0,,‎Thật ư?
Dialogue: 0,0:03:51.13,0:03:52.46,Default,,0,0,0,,‎Tên cô là gì?
Dialogue: 0,0:03:53.00,0:03:55.42,Default,,0,0,0,,‎- Noriko.\N‎- Nori{\i1}‎-chan.{\i0}
Dialogue: 0,0:03:56.17,0:03:57.17,Default,,0,0,0,,‎Tôi là Gen.
Dialogue: 0,0:03:58.17,0:03:59.63,Default,,0,0,0,,‎Tối nay tôi mời.
Dialogue: 0,0:04:01.17,0:04:02.92,Default,,0,0,0,,‎- Chắc chứ?\N‎- Dĩ nhiên.
Dialogue: 0,0:04:03.79,0:04:04.71,Default,,0,0,0,,‎- Thật?\N‎- Ừ.
Dialogue: 0,0:04:46.83,0:04:50.00,Default,,0,0,0,,‎Nhiều năm rồi không thấy\N‎ống heo hình đầu lâu này.
Dialogue: 0,0:04:50.50,0:04:52.50,Default,,0,0,0,,‎Dùng để giữ tiền thắng cược đua ngựa.
Dialogue: 0,0:04:53.50,0:04:55.58,Default,,0,0,0,,‎Chắc chắn tiết kiệm tiền chả dễ gì.
Dialogue: 0,0:04:56.33,0:04:58.54,Default,,0,0,0,,‎Công việc làm thêm gặp khó khăn à?
Dialogue: 0,0:04:59.38,0:05:03.09,Default,,0,0,0,,‎Công việc mà cậu chẳng cần lộ mặt nhỉ?
Dialogue: 0,0:05:04.13,0:05:06.26,Default,,0,0,0,,‎Chắc cậu làm chung với bọn người hung dữ.
Dialogue: 0,0:05:06.96,0:05:09.13,Default,,0,0,0,,‎Nhưng không phải\N‎là cô gái cậu nói đến chứ?
Dialogue: 0,0:05:09.21,0:05:12.00,Default,,0,0,0,,‎Vâng...cô ấy làm việc rất chăm chỉ,
Dialogue: 0,0:05:12.54,0:05:15.29,Default,,0,0,0,,‎như thể công việc này\N‎là thứ duy nhất cô ấy có.
Dialogue: 0,0:05:21.75,0:05:23.79,Default,,0,0,0,,‎Thật hiếm khi ông làm nui bỏ lò!
Dialogue: 0,0:05:24.38,0:05:27.51,Default,,0,0,0,,‎Hôm nay có khuyến mãi nui.
Dialogue: 0,0:05:28.08,0:05:29.08,Default,,0,0,0,,‎Thử đi.
Dialogue: 0,0:05:33.67,0:05:34.75,Default,,0,0,0,,‎Ngon quá!
Dialogue: 0,0:05:35.83,0:05:39.04,Default,,0,0,0,,‎- Khiến tôi nóng cả người!\N‎- Nóng quá!
Dialogue: 0,0:05:41.17,0:05:42.17,Default,,0,0,0,,‎Nhân tiện, ông chủ,
Dialogue: 0,0:05:42.71,0:05:43.84,Default,,0,0,0,,‎cua năm nay sao rồi?
Dialogue: 0,0:05:45.25,0:05:46.50,Default,,0,0,0,,‎Sẽ sớm có thôi.
Dialogue: 0,0:05:47.25,0:05:50.25,Default,,0,0,0,,‎Bạn tôi...sẽ đem cho tôi\N‎vài con loại ngon.
Dialogue: 0,0:05:51.04,0:05:52.83,Default,,0,0,0,,‎Háo hức quá!
Dialogue: 0,0:05:53.67,0:05:54.96,Default,,0,0,0,,‎Tôi có ý này, Gen.
Dialogue: 0,0:05:55.50,0:05:56.92,Default,,0,0,0,,‎Sao cậu không đưa cô ấy đến đây?
Dialogue: 0,0:05:57.46,0:06:00.00,Default,,0,0,0,,‎Chắc cô ấy sẽ muốn thử\N‎thức ăn của ông chủ.
Dialogue: 0,0:06:01.88,0:06:02.88,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:06:08.08,0:06:09.12,Default,,0,0,0,,‎Vâng!
Dialogue: 0,0:06:09.21,0:06:12.88,Default,,0,0,0,,‎Tempura này ngon hơn\N‎các loại bán bên ngoài nhiều.
Dialogue: 0,0:06:13.79,0:06:17.17,Default,,0,0,0,,‎Anh còn nữa không?
Dialogue: 0,0:06:17.25,0:06:19.63,Default,,0,0,0,,‎Tôi cho hết rồi. Lần sau sẽ mang tới.
Dialogue: 0,0:06:19.71,0:06:22.38,Default,,0,0,0,,‎Của cậu đây, mì udon chiên.
Dialogue: 0,0:06:29.33,0:06:31.96,Default,,0,0,0,,‎Sao mình lại biến thành con rể vậy chứ?
Dialogue: 0,0:06:33.50,0:06:34.58,Default,,0,0,0,,‎Ý cậu là gì hả?
Dialogue: 0,0:06:35.67,0:06:40.30,Default,,0,0,0,,‎Tôi chỉ Saori cách làm mì soba,\N‎mẹ tôi bảo mì cô ấy làm ngon hơn tôi.
Dialogue: 0,0:06:41.96,0:06:43.13,Default,,0,0,0,,‎Khác nhau nhiều à?
Dialogue: 0,0:06:43.21,0:06:46.50,Default,,0,0,0,,‎Không, tôi nghĩ do sở thích thôi.
Dialogue: 0,0:06:47.63,0:06:52.42,Default,,0,0,0,,‎Nhưng thực ra, vài khách hàng đã hỏi\N‎mì của Saori thay vì của tôi.
Dialogue: 0,0:06:54.33,0:06:56.87,Default,,0,0,0,,‎Doanh thu giao hàng còn tăng lên nữa.
Dialogue: 0,0:06:56.96,0:06:58.29,Default,,0,0,0,,‎Sao cô ấy nổi tiếng vậy chứ?
Dialogue: 0,0:06:59.54,0:07:01.71,Default,,0,0,0,,‎Mẹ cậu rất vui nhỉ?
Dialogue: 0,0:07:01.79,0:07:04.37,Default,,0,0,0,,‎Bà gọi Saori là "người kế nghiệp".
Dialogue: 0,0:07:07.13,0:07:08.71,Default,,0,0,0,,‎Cậu đã bị thay thế!
Dialogue: 0,0:07:09.33,0:07:13.12,Default,,0,0,0,,‎Tôi được cho là tiếp quản việc làm ăn,\N‎nhưng giờ mất hết động lực rồi.
Dialogue: 0,0:07:14.71,0:07:16.04,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:07:33.63,0:07:35.17,Default,,0,0,0,,‎Hôm nay cảm ơn anh nhé.
Dialogue: 0,0:07:35.96,0:07:38.84,Default,,0,0,0,,‎Hãy đi ăn gì đó đi. Chỗ đằng kia rất ngon.
Dialogue: 0,0:07:40.50,0:07:42.83,Default,,0,0,0,,‎Hả... Chỗ kia?
Dialogue: 0,0:07:43.71,0:07:45.13,Default,,0,0,0,,‎- Cô biết nó?\N‎- Không...
Dialogue: 0,0:07:45.71,0:07:46.67,Default,,0,0,0,,‎Tôi không...
Dialogue: 0,0:07:47.50,0:07:49.25,Default,,0,0,0,,‎Vậy thì đi. Tôi mời.
Dialogue: 0,0:07:52.88,0:07:54.63,Default,,0,0,0,,‎- Cô không đói à?\N‎- Có.
Dialogue: 0,0:07:54.71,0:07:56.88,Default,,0,0,0,,‎Thật chứ? Vậy thì đi thôi.
Dialogue: 0,0:08:06.54,0:08:07.37,Default,,0,0,0,,‎Thấy lạnh sao?
Dialogue: 0,0:08:08.29,0:08:10.79,Default,,0,0,0,,‎Không, tôi nghĩ mình bị cảm rồi.
Dialogue: 0,0:08:11.50,0:08:13.13,Default,,0,0,0,,‎Của quý khách đây.
Dialogue: 0,0:08:17.50,0:08:21.38,Default,,0,0,0,,‎Ông chủ, đây là cô gái tôi đã kể với ông.
Dialogue: 0,0:08:21.46,0:08:22.50,Default,,0,0,0,,‎Nori{\i1}‎-chan.{\i0}
Dialogue: 0,0:08:25.58,0:08:26.75,Default,,0,0,0,,‎Cụng ly.
Dialogue: 0,0:08:27.33,0:08:28.16,Default,,0,0,0,,‎Cụng ly.
Dialogue: 0,0:08:31.13,0:08:33.05,Default,,0,0,0,,‎Tôi tăng nhiệt độ lò sưởi nhé?
Dialogue: 0,0:08:34.00,0:08:35.50,Default,,0,0,0,,‎Không, tôi ổn mà.
Dialogue: 0,0:08:36.25,0:08:39.13,Default,,0,0,0,,‎Gọi món cô thích đi.\N‎Ông chủ nấu được gần như mọi món.
Dialogue: 0,0:08:40.58,0:08:41.75,Default,,0,0,0,,‎Cô muốn gì?
Dialogue: 0,0:08:43.17,0:08:45.63,Default,,0,0,0,,‎- Tôi sẽ...\N‎- Khoai tây và thịt hầm nhỉ?
Dialogue: 0,0:08:55.08,0:08:56.37,Default,,0,0,0,,‎Đã lâu không gặp.
Dialogue: 0,0:09:01.08,0:09:01.96,Default,,0,0,0,,‎Sao thế?
Dialogue: 0,0:09:02.63,0:09:04.09,Default,,0,0,0,,‎- Gì thế?\N{\i1}‎- Vài năm trước,{\i0}
Dialogue: 0,0:09:04.63,0:09:09.30,Default,,0,0,0,,{\i1}‎cô gái này cùng chị gái liên quan đến{\i0}\N{\i1}‎một vụ lừa đảo hôn nhân.{\i0}
Dialogue: 0,0:09:09.83,0:09:13.08,Default,,0,0,0,,{\i1}‎Một trong các khách hàng của tôi{\i0}\N{\i1}‎là nạn nhân của họ.{\i0}
Dialogue: 0,0:09:17.83,0:09:19.75,Default,,0,0,0,,‎Tôi đã thụ án xong ba năm tù.
Dialogue: 0,0:09:21.00,0:09:23.17,Default,,0,0,0,,‎Tôi định đến sớm hơn, nhưng...
Dialogue: 0,0:09:25.42,0:09:26.59,Default,,0,0,0,,‎Còn chị cô?
Dialogue: 0,0:09:27.25,0:09:30.21,Default,,0,0,0,,‎Sau khi ra tù, chị ấy quay về Hokkaido.
Dialogue: 0,0:09:32.33,0:09:35.41,Default,,0,0,0,,‎Tôi không bao giờ nghĩ\N‎người Gen nói là cô cả.
Dialogue: 0,0:09:36.25,0:09:40.21,Default,,0,0,0,,‎Ăn món thịt và khoai tây hầm đi.\N‎Lâu rồi cô chưa ăn lại nó mà.
Dialogue: 0,0:09:42.54,0:09:43.71,Default,,0,0,0,,‎Cảm ơn ông.
Dialogue: 0,0:09:54.54,0:09:55.58,Default,,0,0,0,,‎Chà...
Dialogue: 0,0:09:56.83,0:09:58.41,Default,,0,0,0,,‎Vẫn y như cũ.
Dialogue: 0,0:10:00.29,0:10:01.50,Default,,0,0,0,,‎Chính là nó rồi!
Dialogue: 0,0:10:04.75,0:10:08.46,Default,,0,0,0,,‎Cô đã thụ án rồi,\N‎nên chẳng cần xấu hổ gì cả.
Dialogue: 0,0:10:10.79,0:10:12.21,Default,,0,0,0,,‎Cô có công việc khác chứ?
Dialogue: 0,0:10:18.33,0:10:19.71,Default,,0,0,0,,‎Tôi đã thử khắp nơi,
Dialogue: 0,0:10:20.71,0:10:24.17,Default,,0,0,0,,‎nhưng khoảng thời gian trống ba năm\N‎trong lý lịch thật khó giải thích.
Dialogue: 0,0:10:24.25,0:10:25.96,Default,,0,0,0,,‎Cứ viết gì cũng được.
Dialogue: 0,0:10:26.88,0:10:28.34,Default,,0,0,0,,‎Tôi không muốn nói dối nữa.
Dialogue: 0,0:10:29.58,0:10:32.96,Default,,0,0,0,,‎Tôi đã tổn thương nhiều người rồi.
Dialogue: 0,0:10:39.17,0:10:41.71,Default,,0,0,0,,‎Ông chủ, rượu shochu và trà ô long nhé.
Dialogue: 0,0:10:42.33,0:10:43.25,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:10:51.71,0:10:52.84,Default,,0,0,0,,‎Sẵn sàng chưa?
Dialogue: 0,0:11:05.04,0:11:08.17,Default,,0,0,0,,‎Mấu chốt là dồn lực vào cổ tay.
Dialogue: 0,0:11:12.96,0:11:14.42,Default,,0,0,0,,‎Ta thử ném xa hơn nhé?
Dialogue: 0,0:11:16.17,0:11:19.21,Default,,0,0,0,,‎Xin lỗi nhé.
Dialogue: 0,0:11:22.04,0:11:23.04,Default,,0,0,0,,‎Sẵn sàng chưa?
Dialogue: 0,0:11:35.83,0:11:39.37,Default,,0,0,0,,‎Tôi không tin đâu.\N‎Cậu nghỉ việc để làm gì hả?
Dialogue: 0,0:11:39.46,0:11:41.34,Default,,0,0,0,,‎Tôi muốn ăn chút mì udon chiên.
Dialogue: 0,0:11:41.96,0:11:44.79,Default,,0,0,0,,‎- Cậu bận à?\N‎- Không phải quá rõ sao?
Dialogue: 0,0:11:46.79,0:11:50.75,Default,,0,0,0,,‎Không có tôi thì cậu với mẹ\N‎vẫn sẽ ổn thôi mà.
Dialogue: 0,0:11:50.83,0:11:53.21,Default,,0,0,0,,‎Sao? Cậu đang dỗi à?
Dialogue: 0,0:11:55.71,0:11:59.13,Default,,0,0,0,,‎Có lẽ mọi chuyện sẽ tốt hơn\N‎nếu ta không hợp tác với nhau.
Dialogue: 0,0:12:00.29,0:12:01.79,Default,,0,0,0,,‎Tôi đi trước đây.
Dialogue: 0,0:12:06.42,0:12:08.25,Default,,0,0,0,,‎Đúng là trẻ con mà!
Dialogue: 0,0:12:18.38,0:12:22.71,Default,,0,0,0,,‎Đêm Giáng Sinh rồi, mọi khách hàng\N‎mua bánh trị giá trên 2.000 yên
Dialogue: 0,0:12:22.79,0:12:25.25,Default,,0,0,0,,‎sẽ được tặng một bánh macaron tùy chọn!
Dialogue: 0,0:12:26.88,0:12:28.30,Default,,0,0,0,,‎Anh đã mua bánh chưa ạ?
Dialogue: 0,0:12:28.38,0:12:29.71,Default,,0,0,0,,‎Cảm ơn rất nhiều!
Dialogue: 0,0:12:40.83,0:12:42.12,Default,,0,0,0,,‎Ta nên đi thôi.
Dialogue: 0,0:12:43.08,0:12:44.75,Default,,0,0,0,,‎- Ngủ ngon.\N‎- Ngủ ngon.
Dialogue: 0,0:12:48.67,0:12:49.84,Default,,0,0,0,,‎Cô gì ơi!
Dialogue: 0,0:12:50.54,0:12:51.54,Default,,0,0,0,,‎Vâng?
Dialogue: 0,0:12:52.29,0:12:53.79,Default,,0,0,0,,‎Rất vui được gặp cô.
Dialogue: 0,0:12:54.63,0:12:58.59,Default,,0,0,0,,‎Tôi có tin tốt và tin xấu.\N‎Cô muốn nghe cái nào trước?
Dialogue: 0,0:12:58.67,0:12:59.88,Default,,0,0,0,,‎Chả muốn cái nào.
Dialogue: 0,0:13:00.46,0:13:02.79,Default,,0,0,0,,‎Tin xấu là tôi bị cô thu hút.
Dialogue: 0,0:13:03.33,0:13:04.50,Default,,0,0,0,,‎Thật không may mà.
Dialogue: 0,0:13:04.58,0:13:08.87,Default,,0,0,0,,‎Nhưng tin tốt\N‎sẽ khiến cô quên hết điều đó.
Dialogue: 0,0:13:09.50,0:13:12.33,Default,,0,0,0,,‎Tôi thấy cách cô làm việc.
Dialogue: 0,0:13:13.75,0:13:17.33,Default,,0,0,0,,‎Trong thế giới mà hầu hết mọi người\N‎đều độc ác và vô tâm,
Dialogue: 0,0:13:17.42,0:13:19.96,Default,,0,0,0,,‎tôi lại nhìn thấy vầng hào quang vàng...
Dialogue: 0,0:13:21.08,0:13:23.29,Default,,0,0,0,,‎đang phát sáng trên đầu cô.
Dialogue: 0,0:13:24.29,0:13:25.79,Default,,0,0,0,,‎Cô muốn làm người mẫu không?
Dialogue: 0,0:13:26.96,0:13:30.13,Default,,0,0,0,,‎Tôi tin chắc cô sẽ thành công.
Dialogue: 0,0:13:30.75,0:13:34.63,Default,,0,0,0,,‎Anh thực sự nghĩ\N‎tôi sẽ tin những thứ như...
Dialogue: 0,0:13:34.71,0:13:36.13,Default,,0,0,0,,‎Để tôi cho cô...
Dialogue: 0,0:13:38.38,0:13:39.42,Default,,0,0,0,,‎phí hợp đồng.
Dialogue: 0,0:13:58.79,0:14:00.12,Default,,0,0,0,,‎- Đang làm gì đấy?\N‎- Vâng?
Dialogue: 0,0:14:04.63,0:14:05.96,Default,,0,0,0,,‎- Mày là ai?\N‎- Tôi...
Dialogue: 0,0:14:07.25,0:14:08.38,Default,,0,0,0,,‎Đây là gì?
Dialogue: 0,0:14:10.96,0:14:13.88,Default,,0,0,0,,‎Ui!
Dialogue: 0,0:14:13.96,0:14:15.71,Default,,0,0,0,,‎Dừng lại đi!
Dialogue: 0,0:14:15.79,0:14:17.33,Default,,0,0,0,,‎Anh đang làm gì hả?
Dialogue: 0,0:14:18.04,0:14:19.46,Default,,0,0,0,,‎Đi thôi, Nori{\i1}‎-chan.{\i0}
Dialogue: 0,0:14:20.13,0:14:21.05,Default,,0,0,0,,‎Này!
Dialogue: 0,0:14:25.83,0:14:28.79,Default,,0,0,0,,‎Đừng đụng vào! Đi đi!
Dialogue: 0,0:14:31.08,0:14:33.33,Default,,0,0,0,,‎Tôi biết đó là trò lừa đảo, nhưng...
Dialogue: 0,0:14:35.42,0:14:38.17,Default,,0,0,0,,‎khi thấy tiền,\N‎tôi không làm chủ được bản thân.
Dialogue: 0,0:14:41.54,0:14:42.75,Default,,0,0,0,,‎Tôi rất xấu hổ.
Dialogue: 0,0:14:50.54,0:14:52.29,Default,,0,0,0,,‎Tôi cũng từng phạm tội.
Dialogue: 0,0:14:57.33,0:14:58.66,Default,,0,0,0,,‎Từng đi tù.
Dialogue: 0,0:15:04.54,0:15:07.79,Default,,0,0,0,,‎Ta cần chăm sóc bản thân tốt vào, nhé?
Dialogue: 0,0:15:11.79,0:15:12.87,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:15:19.75,0:15:21.29,Default,,0,0,0,,‎Có hơi sớm, nhưng...
Dialogue: 0,0:15:21.96,0:15:23.67,Default,,0,0,0,,‎đây là quà Giáng Sinh.
Dialogue: 0,0:15:23.75,0:15:24.67,Default,,0,0,0,,‎Cho hai người.
Dialogue: 0,0:15:28.04,0:15:29.25,Default,,0,0,0,,‎Ông chắc chứ?
Dialogue: 0,0:15:31.42,0:15:33.88,Default,,0,0,0,,‎"Quà" nghĩa là miễn phí, phải không?
Dialogue: 0,0:15:36.13,0:15:38.38,Default,,0,0,0,,‎Nếu muốn thêm thì nói nhé. Còn nhiều lắm.
Dialogue: 0,0:15:38.46,0:15:40.29,Default,,0,0,0,,‎Ăn thôi nào!
Dialogue: 0,0:15:40.38,0:15:41.59,Default,,0,0,0,,‎Cảm ơn ông chủ!
Dialogue: 0,0:15:45.88,0:15:46.71,Default,,0,0,0,,‎Ngon thật.
Dialogue: 0,0:15:48.08,0:15:49.46,Default,,0,0,0,,‎Gì thế này?
Dialogue: 0,0:15:50.54,0:15:52.00,Default,,0,0,0,,‎Đây mới đúng là cua!
Dialogue: 0,0:15:53.21,0:15:54.54,Default,,0,0,0,,‎Ông chủ, ngon lắm!
Dialogue: 0,0:15:56.08,0:15:57.66,Default,,0,0,0,,‎Miễn phí, đúng chứ?
Dialogue: 0,0:15:57.75,0:16:00.04,Default,,0,0,0,,‎Hoan nghênh!
Dialogue: 0,0:16:00.13,0:16:04.42,Default,,0,0,0,,‎Hàng Nhật!\N‎Hàng hoá truyền thống. Rất may mắn.
Dialogue: 0,0:16:05.33,0:16:07.66,Default,,0,0,0,,‎Cứ thoải mái chọn lựa.
Dialogue: 0,0:16:07.75,0:16:09.96,Default,,0,0,0,,‎Làm quà lưu niệm thì khỏi chê!
Dialogue: 0,0:16:10.92,0:16:14.05,Default,,0,0,0,,‎- Nên mua.\N‎- Nên mua đi.
Dialogue: 0,0:16:14.13,0:16:16.01,Default,,0,0,0,,‎Cảm ơn rất nhiều!
Dialogue: 0,0:16:16.08,0:16:18.29,Default,,0,0,0,,‎- Chúc mừng năm mới!\N‎- Bao nhiêu?
Dialogue: 0,0:16:25.88,0:16:27.38,Default,,0,0,0,,‎Mà nó gọi là gì ấy nhỉ?
Dialogue: 0,0:16:27.46,0:16:30.34,Default,,0,0,0,,‎Trò lừa đảo mà mấy gã đàn ông\N‎giơ ra một đống tiền
Dialogue: 0,0:16:30.42,0:16:32.67,Default,,0,0,0,,‎để lừa phụ nữ bán mình đó?
Dialogue: 0,0:16:33.38,0:16:35.21,Default,,0,0,0,,‎- Lừa đảo cướp linh hồn. Lừa đảo linh hồn.\N‎- Đúng rồi.
Dialogue: 0,0:16:35.29,0:16:36.87,Default,,0,0,0,,‎LỪA ĐẢO CƯỚP LINH HỒN = LỪA ĐẢO LINH HỒN
Dialogue: 0,0:16:36.96,0:16:41.13,Default,,0,0,0,,‎Đó là nơi vụ lừa đảo khác\N‎bị tóm hai năm trước.
Dialogue: 0,0:16:41.88,0:16:44.88,Default,,0,0,0,,‎Anh nghĩ mấy tên lừa đảo\N‎luôn dùng cùng địa điểm à?
Dialogue: 0,0:16:45.83,0:16:49.71,Default,,0,0,0,,‎Người như thế luôn nghĩ\N‎chúng thông minh hơn ta.
Dialogue: 0,0:16:50.83,0:16:52.37,Default,,0,0,0,,‎Đó là kinh nghiệm của tôi.
Dialogue: 0,0:17:18.08,0:17:19.12,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:17:21.17,0:17:23.67,Default,,0,0,0,,‎Xin lỗi đã gọi cô lúc bận rộn thế này.
Dialogue: 0,0:17:24.92,0:17:28.59,Default,,0,0,0,,‎Ông sẽ cần giúp nếu muốn\N‎làm nhiều mì soba hơn năm ngoái.
Dialogue: 0,0:17:29.42,0:17:33.34,Default,,0,0,0,,‎Thường tôi được cho một ít,\N‎nhưng năm này không có.
Dialogue: 0,0:17:34.42,0:17:36.55,Default,,0,0,0,,‎Tôi muốn chắc mình có đủ.
Dialogue: 0,0:17:46.50,0:17:48.13,Default,,0,0,0,,‎Đói quá...
Dialogue: 0,0:17:49.67,0:17:53.75,Default,,0,0,0,,‎Hôm nay Saori đã làm mì soba.
Dialogue: 0,0:17:55.46,0:17:56.96,Default,,0,0,0,,‎"Sắp thành bà chủ của quán Sobasei".
Dialogue: 0,0:17:57.04,0:17:58.54,Default,,0,0,0,,‎Tôi rất vui.
Dialogue: 0,0:17:59.21,0:18:01.88,Default,,0,0,0,,‎Mì soba có vị khác nhau\N‎tuỳ vào cách chế biến.
Dialogue: 0,0:18:02.71,0:18:06.63,Default,,0,0,0,,‎Ông chủ, ông có thể làm\N‎mì soba Năm Mới với tempura năm nay không?
Dialogue: 0,0:18:07.42,0:18:09.92,Default,,0,0,0,,‎Tempura mua ngoài tiệm\N‎nếu cô thấy không sao.
Dialogue: 0,0:18:11.21,0:18:13.67,Default,,0,0,0,,‎Không phải cô tránh thức ăn chiên à?
Dialogue: 0,0:18:14.42,0:18:17.46,Default,,0,0,0,,‎Tôi ít nhất sẽ\N‎thưởng bản thân vào cuối năm.
Dialogue: 0,0:18:17.54,0:18:19.29,Default,,0,0,0,,‎Ăn chung hai món đó rất ngon!
Dialogue: 0,0:18:21.13,0:18:23.21,Default,,0,0,0,,‎Sắp đến lúc luộc mì rồi...
Dialogue: 0,0:18:35.33,0:18:37.75,Default,,0,0,0,,‎- Ông chủ!\N‎- Sao?
Dialogue: 0,0:18:38.46,0:18:41.63,Default,,0,0,0,,‎Chúng tôi có thừa tôm,\N‎nên có đem chúng đến để làm tempura.
Dialogue: 0,0:18:43.00,0:18:46.00,Default,,0,0,0,,‎Cảm ơn, nhưng làm ở đây hơi khó đấy.
Dialogue: 0,0:18:46.08,0:18:48.25,Default,,0,0,0,,‎Ông chủ, hai rượu sake nóng nhé.
Dialogue: 0,0:18:49.00,0:18:50.00,Default,,0,0,0,,‎Vâng!
Dialogue: 0,0:19:10.71,0:19:12.75,Default,,0,0,0,,‎Hương vị mì soba rất tuyệt vời.
Dialogue: 0,0:19:13.54,0:19:15.37,Default,,0,0,0,,‎Tempura cũng rất ngon!
Dialogue: 0,0:19:16.04,0:19:19.04,Default,,0,0,0,,‎Ông chủ tự nấu nó đấy.
Dialogue: 0,0:19:19.13,0:19:21.26,Default,,0,0,0,,‎- Ông ấy quá giỏi mà.\N‎- Phải.
Dialogue: 0,0:19:29.13,0:19:30.63,Default,,0,0,0,,‎Tempura ở tiệm mì soba
Dialogue: 0,0:19:31.17,0:19:32.84,Default,,0,0,0,,‎là ngon nhất.
Dialogue: 0,0:19:34.00,0:19:35.46,Default,,0,0,0,,‎Cái này của tiệm mì soba đúng không?
Dialogue: 0,0:19:41.96,0:19:43.88,Default,,0,0,0,,‎Món này ngon quá!
Dialogue: 0,0:19:45.08,0:19:47.62,Default,,0,0,0,,‎Ta cần thêm hai phần nữa.
Dialogue: 0,0:19:47.71,0:19:48.75,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:20:11.50,0:20:14.63,Default,,0,0,0,,‎Ông chủ nói hai phần đó dành cho ta.
Dialogue: 0,0:20:24.92,0:20:26.13,Default,,0,0,0,,‎Làm tốt lắm.
Dialogue: 0,0:20:27.33,0:20:29.58,Default,,0,0,0,,‎Cảm ơn. Cậu cũng vậy.
Dialogue: 0,0:20:31.21,0:20:33.88,Default,,0,0,0,,‎Không có vị đúng như Sobasei\N‎nếu thiếu một trong hai ta.
Dialogue: 0,0:20:56.46,0:20:57.67,Default,,0,0,0,,‎Cảm ơn cậu.
Dialogue: 0,0:21:11.75,0:21:13.29,Default,,0,0,0,,‎Xin tránh ra nào.
Dialogue: 0,0:21:13.38,0:21:14.84,Default,,0,0,0,,‎Đừng dừng lại. Đi tiếp đi.
Dialogue: 0,0:21:14.92,0:21:15.88,Default,,0,0,0,,‎Xin cẩn thận.
Dialogue: 0,0:21:15.96,0:21:18.63,Default,,0,0,0,,‎Nếu ở yên một chỗ,\N‎bạn có thể đánh mất nhiều thứ trong đời.
Dialogue: 0,0:21:18.71,0:21:20.67,Default,,0,0,0,,‎Có chuyện gì thế, Kogure?
Dialogue: 0,0:21:21.25,0:21:22.58,Default,,0,0,0,,‎Xin lỗi đã làm phiền.
Dialogue: 0,0:21:22.67,0:21:25.55,Default,,0,0,0,,‎Tôi sẽ kể cho mọi người sau\N‎khi ghé quán ăn chút mì soba.
Dialogue: 0,0:21:26.50,0:21:29.29,Default,,0,0,0,,‎Xin hãy lùi lại. Đừng tụ tập.
Dialogue: 0,0:21:29.38,0:21:32.88,Default,,0,0,0,,‎Xin hãy tụ tập khi mọi người\N‎đến cúng chùa vào ngày mai.
Dialogue: 0,0:21:33.46,0:21:35.25,Default,,0,0,0,,‎Hình như là cảnh sát.
Dialogue: 0,0:21:36.79,0:21:38.37,Default,,0,0,0,,‎Lạnh quá. Vào trong thôi.
Dialogue: 0,0:21:40.88,0:21:42.55,Default,,0,0,0,,‎Đó là nơi không may mắn.
Dialogue: 0,0:21:43.75,0:21:46.67,Default,,0,0,0,,‎Năm mới đến rồi, mọi người nên về nhà đi.
Dialogue: 0,0:21:48.38,0:21:49.46,Default,,0,0,0,,‎Không có gì để xem ở đây cả.
Dialogue: 0,0:21:55.50,0:21:56.88,Default,,0,0,0,,‎Cái gã với một mớ tiền kìa!
Dialogue: 0,0:21:58.58,0:22:00.75,Default,,0,0,0,,‎Tôi mừng vì hắn bị tóm trước Năm mới.
Dialogue: 0,0:22:02.04,0:22:04.04,Default,,0,0,0,,‎Hãy quên hết tội lỗi năm nay đi.
Dialogue: 0,0:22:09.00,0:22:12.38,Default,,0,0,0,,‎ĐỒN CẢNH SÁT YOMOGIMACHI
Dialogue: 0,0:22:16.58,0:22:18.33,Default,,0,0,0,,‎Năm mới rồi.
Dialogue: 0,0:22:19.42,0:22:20.42,Default,,0,0,0,,‎Nhưng...
Dialogue: 0,0:22:20.50,0:22:24.88,Default,,0,0,0,,‎họ nói trộn điều rủi năm này\N‎vào bát mì soba rồi ăn để rũ bỏ nó đi.
Dialogue: 0,0:22:25.42,0:22:28.17,Default,,0,0,0,,‎Không phải sẽ tệ\N‎nếu ta không ăn xong kịp giờ sao?
Dialogue: 0,0:22:28.25,0:22:30.83,Default,,0,0,0,,‎Tôi không nghĩ đấy là vấn đề.
Dialogue: 0,0:22:31.58,0:22:35.75,Default,,0,0,0,,‎Hãy nghĩ thế này, "Điều rủi năm ngoái\N‎đã kết thúc và năm nay ta sẽ làm tốt hơn".
Dialogue: 0,0:22:41.63,0:22:44.46,Default,,0,0,0,,‎Tôi rất ấn tượng với công việc của sếp.
Dialogue: 0,0:22:46.21,0:22:49.00,Default,,0,0,0,,‎Cảm ơn đã lãnh đạo chúng tôi.
Dialogue: 0,0:22:49.92,0:22:51.38,Default,,0,0,0,,‎May mắn thôi.
Dialogue: 0,0:22:52.50,0:22:54.42,Default,,0,0,0,,‎Trực giác của cảnh sát...
Dialogue: 0,0:22:55.21,0:22:58.13,Default,,0,0,0,,‎như cảm xúc của con người,\N‎không thể dựa vào chúng.
Dialogue: 0,0:23:01.92,0:23:03.09,Default,,0,0,0,,‎Mọi người biết đấy...
Dialogue: 0,0:23:03.92,0:23:06.42,Default,,0,0,0,,‎tôi có cảm giác...
Dialogue: 0,0:23:07.00,0:23:08.63,Default,,0,0,0,,‎đây là vụ án cuối của mình.
Dialogue: 0,0:23:17.42,0:23:18.71,Default,,0,0,0,,‎Tuyết rơi rồi!
Dialogue: 0,0:23:28.00,0:23:29.58,Default,,0,0,0,,‎Vừa ra lò đây!
Dialogue: 0,0:23:29.67,0:23:32.00,Default,,0,0,0,,‎Thật khó để làm nó đấy.
Dialogue: 0,0:23:32.08,0:23:33.79,Default,,0,0,0,,‎Ai muốn lăn nào?
Dialogue: 0,0:23:33.88,0:23:35.34,Default,,0,0,0,,‎Tôi nhé?
Dialogue: 0,0:23:36.38,0:23:38.17,Default,,0,0,0,,‎- Như thế này à?\N‎- Ừ, nhẹ thôi.
Dialogue: 0,0:23:43.50,0:23:44.67,Default,,0,0,0,,‎Ông nên cắt đi.
Dialogue: 0,0:23:45.58,0:23:46.41,Default,,0,0,0,,‎Hả?
Dialogue: 0,0:23:46.50,0:23:49.13,Default,,0,0,0,,‎Đó là việc của ông.
Dialogue: 0,0:23:49.21,0:23:51.96,Default,,0,0,0,,‎Tôi đến để nướng, không phải để cắt nó.
Dialogue: 0,0:23:58.71,0:23:59.54,Default,,0,0,0,,‎Gì thế?
Dialogue: 0,0:24:08.33,0:24:09.46,Default,,0,0,0,,‎Ngon lắm.
Dialogue: 0,0:24:25.79,0:24:27.00,Default,,0,0,0,,‎Ngon thật đấy!
Dialogue: 0,0:24:28.08,0:24:29.71,Default,,0,0,0,,‎- Ngon quá.\N‎- Của quý khách đây.
Dialogue: 0,0:24:32.29,0:24:36.87,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:24:36.96,0:24:38.79,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:24:42.63,0:24:46.67,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:24:47.38,0:24:50.38,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:24:53.29,0:24:54.83,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:24:54.92,0:24:57.34,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
