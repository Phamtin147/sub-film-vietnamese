Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:05.92,0:01:10.17,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã ra về,{\i0}
Dialogue: 0,0:01:10.92,0:01:12.67,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:30.00,0:01:34.58,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:34.67,0:01:37.96,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:43.46,0:01:44.84,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:45.46,0:01:47.50,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:52.71,0:01:57.96,Default,,0,0,0,,‎BÁNH KẸP MÌ XÀO
Dialogue: 0,0:02:02.00,0:02:04.96,Default,,0,0,0,,{\i1}‎Chúng tôi không có bánh mì{\i0}\N{\i1}‎vì chủ yếu phục vụ cơm.{\i0}
Dialogue: 0,0:02:06.96,0:02:10.29,Default,,0,0,0,,{\i1}‎Nếu khách hàng thực sự muốn ăn bánh kẹp,{\i0}
Dialogue: 0,0:02:10.38,0:02:12.59,Default,,0,0,0,,{\i1}‎họ sẽ tự mang bánh mì đến.{\i0}
Dialogue: 0,0:02:13.13,0:02:14.21,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:02:16.75,0:02:17.75,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:02:17.83,0:02:20.04,Default,,0,0,0,,‎Ông chủ, món như mọi khi với cái này.
Dialogue: 0,0:02:20.96,0:02:22.59,Default,,0,0,0,,‎Hôm nay anh lại mang nhiều rồi.
Dialogue: 0,0:02:23.42,0:02:25.21,Default,,0,0,0,,‎Cứ dùng phục vụ khách nào muốn ăn.
Dialogue: 0,0:02:25.29,0:02:26.12,Default,,0,0,0,,‎Được.
Dialogue: 0,0:02:49.67,0:02:50.67,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:02:53.08,0:02:54.41,Default,,0,0,0,,‎Chính là món này!
Dialogue: 0,0:02:55.46,0:03:02.04,Default,,0,0,0,,{\i1}‎Anh Kotani là doanh nhân thành đạt{\i0}\N{\i1}‎điều hành các quán cà phê cho chó và mèo{\i0}
Dialogue: 0,0:03:02.63,0:03:07.13,Default,,0,0,0,,{\i1}‎nhưng không hiểu sao anh ta luôn gọi{\i0}\N{\i1}‎món bánh kẹp mì xào ở đây.{\i0}
Dialogue: 0,0:03:08.54,0:03:11.58,Default,,0,0,0,,‎Kẹp mì xào vào bánh mì để làm gì?
Dialogue: 0,0:03:11.67,0:03:13.75,Default,,0,0,0,,‎Cả hai đều có cacbon hydrat nhỉ?
Dialogue: 0,0:03:13.83,0:03:16.75,Default,,0,0,0,,‎Tôi đồng ý. Chỉ nhìn thôi cũng làm tôi no.
Dialogue: 0,0:03:16.83,0:03:18.46,Default,,0,0,0,,‎Thế nên nó mới tuyệt.
Dialogue: 0,0:03:18.54,0:03:21.42,Default,,0,0,0,,‎Thịt và cacbon hydrat rất cần thiết\N‎cho người trẻ tuổi nhỉ?
Dialogue: 0,0:03:21.96,0:03:23.21,Default,,0,0,0,,‎Người trẻ tuổi.
Dialogue: 0,0:03:23.88,0:03:26.26,Default,,0,0,0,,‎Anh Kotani, hôm nay anh trông rất vui.
Dialogue: 0,0:03:26.79,0:03:28.50,Default,,0,0,0,,‎Anh có chuyện vui à?
Dialogue: 0,0:03:29.75,0:03:30.96,Default,,0,0,0,,‎Cảm ơn đã hỏi!
Dialogue: 0,0:03:31.50,0:03:32.58,Default,,0,0,0,,‎Trường cấp ba của tôi sẽ tham gia
Dialogue: 0,0:03:32.67,0:03:35.09,Default,,0,0,0,,‎Giải đấu Bóng chày Trung học\N‎cấp Quốc gia Khách mời Mùa xuân này.
Dialogue: 0,0:03:35.17,0:03:36.38,Default,,0,0,0,,‎Lần đầu tiên trong 40 năm qua!
Dialogue: 0,0:03:37.33,0:03:38.54,Default,,0,0,0,,‎Xin chúc mừng.
Dialogue: 0,0:03:38.63,0:03:39.92,Default,,0,0,0,,‎Làm tốt lắm!
Dialogue: 0,0:03:40.00,0:03:42.25,Default,,0,0,0,,‎Họ đã cố hết sức.
Dialogue: 0,0:03:42.33,0:03:44.12,Default,,0,0,0,,‎Anh từng trong đội bóng chày?
Dialogue: 0,0:03:44.21,0:03:46.46,Default,,0,0,0,,‎Phải, dù chỉ là cầu thủ dự bị.
Dialogue: 0,0:03:46.54,0:03:49.33,Default,,0,0,0,,‎Bạn cùng lớp trước đây của tôi\N‎giờ là huấn luyện viên.
Dialogue: 0,0:03:51.71,0:03:53.00,Default,,0,0,0,,‎Làm ơn đưa ly cho anh ta.
Dialogue: 0,0:03:55.21,0:03:57.21,Default,,0,0,0,,‎Chúc mừng. Anh uống một chút chứ?
Dialogue: 0,0:03:57.79,0:03:59.33,Default,,0,0,0,,‎Vâng, xin phép.
Dialogue: 0,0:04:01.17,0:04:05.34,Default,,0,0,0,,{\i1}‎Ryu không có vẻ gì là chơi bóng chày{\i0}\N{\i1}‎nhưng anh ta từng chơi hồi cấp ba.{\i0}
Dialogue: 0,0:04:05.42,0:04:07.84,Default,,0,0,0,,{\i1}‎Nên chắc anh ta hiểu rõ{\i0}\N{\i1}‎cảm giác của Kotani.{\i0}
Dialogue: 0,0:04:14.88,0:04:17.96,Default,,0,0,0,,‎Huấn luyện viên từng hứa với tôi
Dialogue: 0,0:04:19.13,0:04:22.84,Default,,0,0,0,,‎ngày nào đó cậu ta sẽ đưa học trò\N‎đến Sân vận động Koshien.
Dialogue: 0,0:04:24.00,0:04:26.79,Default,,0,0,0,,‎Anh ta đã giữ lời hứa.
Dialogue: 0,0:04:29.88,0:04:30.71,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:04:34.04,0:04:35.79,Default,,0,0,0,,‎Không cần phải khóc.
Dialogue: 0,0:04:41.00,0:04:42.58,Default,,0,0,0,,‎Hãy ăn mừng thôi!
Dialogue: 0,0:04:42.67,0:04:45.21,Default,,0,0,0,,‎Ông chủ, lấy bia cho mọi người. Tôi mời!
Dialogue: 0,0:04:45.29,0:04:46.12,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:52.04,0:04:53.08,Default,,0,0,0,,‎Anh Kotani!
Dialogue: 0,0:04:54.17,0:04:56.42,Default,,0,0,0,,‎Lâu rồi không gặp!
Dialogue: 0,0:04:56.50,0:04:58.54,Default,,0,0,0,,‎Hãy đi uống nào!
Dialogue: 0,0:04:58.63,0:05:05.21,Default,,0,0,0,,{\i1}‎Anh ta hẳn rất vui{\i0}\N{\i1}‎nên kể từ đó ngày nào anh ta cũng uống.{\i0}
Dialogue: 0,0:05:07.17,0:05:09.05,Default,,0,0,0,,‎Anh ta xỉn quá.
Dialogue: 0,0:05:09.58,0:05:13.54,Default,,0,0,0,,‎Đứng dậy và bắt đầu hát\N‎bài hát thời trung học của mình.
Dialogue: 0,0:05:13.63,0:05:16.09,Default,,0,0,0,,‎Anh ta cũng quậy ở quán bar của tôi.
Dialogue: 0,0:05:17.33,0:05:18.79,Default,,0,0,0,,‎Ở chỗ của ông nữa à?
Dialogue: 0,0:05:18.88,0:05:20.42,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:05:20.50,0:05:24.25,Default,,0,0,0,,‎Anh ta cứ không ngừng\N‎nói chuyện với khách khác
Dialogue: 0,0:05:24.33,0:05:26.79,Default,,0,0,0,,‎nên tôi quát anh ta, "Thôi đi!"
Dialogue: 0,0:05:28.21,0:05:30.25,Default,,0,0,0,,‎Ông chủ cũng nên quát anh ta.
Dialogue: 0,0:05:31.63,0:05:33.09,Default,,0,0,0,,‎Lần tới anh ta đến.
Dialogue: 0,0:05:34.21,0:05:35.84,Default,,0,0,0,,‎Tha cho anh ta đi.
Dialogue: 0,0:05:35.92,0:05:39.96,Default,,0,0,0,,‎Anh ta cật lực làm việc\N‎với vị trí chủ công ty.
Dialogue: 0,0:05:40.04,0:05:42.54,Default,,0,0,0,,‎Hẳn cảm thấy rất hài lòng và hoài cổ.
Dialogue: 0,0:05:43.17,0:05:45.46,Default,,0,0,0,,‎Tôi thích các trận bóng chày cấp ba.
Dialogue: 0,0:05:45.54,0:05:48.42,Default,,0,0,0,,‎Các cầu thủ trẻ\N‎kích thích bản năng làm mẹ của tôi.
Dialogue: 0,0:05:48.50,0:05:51.08,Default,,0,0,0,,‎Tôi muốn mua nhiều đồ ăn cho chúng.
Dialogue: 0,0:05:51.17,0:05:54.55,Default,,0,0,0,,‎Nhưng chúng là những người\N‎đạt được thành quả đó nhỉ?
Dialogue: 0,0:05:55.29,0:05:59.33,Default,,0,0,0,,‎Các trận bóng chày cấp ba\N‎khiến người lớn phấn khích đến vậy ư?
Dialogue: 0,0:05:59.88,0:06:01.17,Default,,0,0,0,,‎Vào mùa xuân và mùa hè.
Dialogue: 0,0:06:01.25,0:06:03.04,Default,,0,0,0,,‎Không phải một trong\N‎các truyền thống của Nhật sao?
Dialogue: 0,0:06:03.13,0:06:06.01,Default,,0,0,0,,‎Phấn khích hai lần một năm thì có gì sai?
Dialogue: 0,0:06:06.58,0:06:08.96,Default,,0,0,0,,‎Các ông cả năm lúc nào chả phấn khích.
Dialogue: 0,0:06:09.50,0:06:10.46,Default,,0,0,0,,‎Đúng thế không?
Dialogue: 0,0:06:12.92,0:06:15.38,Default,,0,0,0,,‎Anh Kotani bị sao thế nhỉ?
Dialogue: 0,0:06:16.46,0:06:19.21,Default,,0,0,0,,‎Trước đây chưa từng say xỉn như thế.
Dialogue: 0,0:06:27.08,0:06:28.37,Default,,0,0,0,,‎Khỉ thật.
Dialogue: 0,0:06:37.71,0:06:38.84,Default,,0,0,0,,‎Cảm ơn anh vì đêm hôm nọ.
Dialogue: 0,0:06:41.79,0:06:44.08,Default,,0,0,0,,‎Anh giỏi thật đấy!
Dialogue: 0,0:06:44.75,0:06:46.50,Default,,0,0,0,,‎Anh từng chơi bóng chày à?
Dialogue: 0,0:06:47.08,0:06:49.29,Default,,0,0,0,,‎Anh chơi tệ quá.\N‎Có thật là anh ở trong đội bóng không?
Dialogue: 0,0:06:51.17,0:06:52.46,Default,,0,0,0,,‎Anh quan sát tôi à?
Dialogue: 0,0:06:53.50,0:06:56.83,Default,,0,0,0,,‎Tôi chưa chơi lại từ hồi cấp ba đến giờ.
Dialogue: 0,0:06:56.92,0:06:58.63,Default,,0,0,0,,‎Tay tôi bị rộp vài chỗ rồi.
Dialogue: 0,0:07:03.08,0:07:06.12,Default,,0,0,0,,‎Nhưng thỉnh thoảng chơi\N‎cũng rất tuyệt nhỉ?
Dialogue: 0,0:07:07.46,0:07:09.17,Default,,0,0,0,,‎Nó khiến tôi nhớ đến thời trung học.
Dialogue: 0,0:07:12.79,0:07:14.33,Default,,0,0,0,,‎Đánh hay lắm!
Dialogue: 0,0:07:26.92,0:07:28.80,Default,,0,0,0,,‎Dáng đánh của anh không đúng.
Dialogue: 0,0:07:28.88,0:07:29.80,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:07:30.54,0:07:33.37,Default,,0,0,0,,‎Nếu tiếp tục đánh,\N‎sẽ có lại cảm giác chơi bóng.
Dialogue: 0,0:07:33.46,0:07:36.59,Default,,0,0,0,,‎Không dễ gì quên được những gì\N‎anh đã học bằng phương thức vận động.
Dialogue: 0,0:07:44.71,0:07:45.71,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:07:47.00,0:07:49.67,Default,,0,0,0,,‎Xin lỗi vì hôm trước tôi xỉn quá.
Dialogue: 0,0:07:51.46,0:07:53.67,Default,,0,0,0,,‎Tôi biết anh vui như thế nào
Dialogue: 0,0:07:53.75,0:07:56.04,Default,,0,0,0,,‎nhưng anh không thấy\N‎gần đây mình uống quá nhiều sao?
Dialogue: 0,0:08:01.54,0:08:02.79,Default,,0,0,0,,‎Xem này.
Dialogue: 0,0:08:06.63,0:08:07.51,Default,,0,0,0,,‎HLV YOKOKAWA
Dialogue: 0,0:08:07.58,0:08:09.37,Default,,0,0,0,,‎"Tiếp tục tạo ra nỗ lực nhỏ.
Dialogue: 0,0:08:09.46,0:08:11.71,Default,,0,0,0,,‎Tôi muốn học trò tin tưởng vào bản thân
Dialogue: 0,0:08:11.79,0:08:14.12,Default,,0,0,0,,‎và chơi hết mình."
Dialogue: 0,0:08:14.21,0:08:16.38,Default,,0,0,0,,‎Anh Yokokawa là huấn luyện viên giỏi.
Dialogue: 0,0:08:16.46,0:08:17.54,Default,,0,0,0,,‎Đúng nhỉ?
Dialogue: 0,0:08:19.42,0:08:23.17,Default,,0,0,0,,‎Hai bọn tôi đến đây học đại học\N‎sau khi tốt nghiệp cấp ba.
Dialogue: 0,0:08:23.75,0:08:25.79,Default,,0,0,0,,‎Suốt kỳ nghỉ hè, khi đó bọn tôi 20 tuổi
Dialogue: 0,0:08:25.88,0:08:30.09,Default,,0,0,0,,‎cậu ta bảo tôi cùng đi bộ về quê bọn tôi\N‎ở quận Kōchi. Nên tôi đi cùng.
Dialogue: 0,0:08:30.17,0:08:32.21,Default,,0,0,0,,‎Đi bộ à? Tại sao?
Dialogue: 0,0:08:32.88,0:08:35.46,Default,,0,0,0,,‎Ở đại học, cậu ta chơi bóng chày
Dialogue: 0,0:08:36.13,0:08:38.17,Default,,0,0,0,,‎nhưng dính chấn thương ở vai.
Dialogue: 0,0:08:38.25,0:08:40.83,Default,,0,0,0,,‎Tôi nghĩ cậu ta đang suy tính\N‎các lựa chọn sau này.
Dialogue: 0,0:08:43.54,0:08:47.21,Default,,0,0,0,,‎Đó là lúc bọn tôi đi bộ\N‎thẳng một đường dọc theo Vịnh Suruga,
Dialogue: 0,0:08:47.29,0:08:48.92,Default,,0,0,0,,‎nếu tôi nhớ không lầm.
Dialogue: 0,0:08:50.38,0:08:55.76,Default,,0,0,0,,{\i1}‎Bọn tôi mua bánh kẹp mì xào,{\i0}\N{\i1}‎cái cuối cùng ở cửa hàng và chia nhau ăn.{\i0}
Dialogue: 0,0:08:59.21,0:09:00.92,Default,,0,0,0,,‎Yokokawa!
Dialogue: 0,0:09:02.83,0:09:03.96,Default,,0,0,0,,‎Nghỉ chút đã nào!
Dialogue: 0,0:09:09.21,0:09:10.34,Default,,0,0,0,,‎Này!
Dialogue: 0,0:09:12.46,0:09:14.09,Default,,0,0,0,,‎Im lặng và đi tiếp đi!
Dialogue: 0,0:09:20.00,0:09:22.25,Default,,0,0,0,,{\i1}‎Sau đó cậu ta nói với tôi...{\i0}
Dialogue: 0,0:09:23.92,0:09:28.00,Default,,0,0,0,,‎"Nếu tớ có thể về được nhà,\N‎tớ sẽ tiếp tục chơi bóng chày.
Dialogue: 0,0:09:29.17,0:09:31.59,Default,,0,0,0,,‎Vì không làm cầu thủ\N‎bóng chày chuyên nghiệp được nữa,
Dialogue: 0,0:09:31.67,0:09:35.55,Default,,0,0,0,,‎nên tớ sẽ làm giáo viên cấp ba\N‎và đưa học trò đến Sân vận động Koshien."
Dialogue: 0,0:09:37.50,0:09:39.21,Default,,0,0,0,,‎Hôm trước anh có kể điều này.
Dialogue: 0,0:09:41.96,0:09:45.00,Default,,0,0,0,,‎Cậu ta đã đi bộ về đến nhà,\N‎còn tôi thì không.
Dialogue: 0,0:09:45.08,0:09:48.79,Default,,0,0,0,,‎Tôi bị tiêu chảy trên đường đi\N‎nên một mình quay lại Tokyo.
Dialogue: 0,0:09:48.88,0:09:49.96,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:09:51.75,0:09:55.04,Default,,0,0,0,,‎Nhưng vào lúc đó\N‎tôi cảm thấy chắc chắn rằng
Dialogue: 0,0:09:55.96,0:09:57.46,Default,,0,0,0,,‎tôi nên làm gì đó.
Dialogue: 0,0:09:58.50,0:10:01.13,Default,,0,0,0,,‎Vì tôi không thể sống như Yokokawa.
Dialogue: 0,0:10:02.21,0:10:04.38,Default,,0,0,0,,‎Anh vẫn gặp anh ta chứ?
Dialogue: 0,0:10:05.54,0:10:09.29,Default,,0,0,0,,‎Chưa gặp lại từ hồi\N‎cậu ta tốt nghiệp đại học và quay về quê.
Dialogue: 0,0:10:10.08,0:10:13.50,Default,,0,0,0,,‎Tôi vẫn chưa trả lại
Dialogue: 0,0:10:14.38,0:10:15.80,Default,,0,0,0,,‎số tiền tôi nợ cậu ta.
Dialogue: 0,0:10:17.17,0:10:18.46,Default,,0,0,0,,‎Hiểu rồi.
Dialogue: 0,0:10:20.79,0:10:23.50,Default,,0,0,0,,‎Vậy sao anh không quyên góp tiền\N‎cho trường của anh ta?
Dialogue: 0,0:10:24.13,0:10:27.34,Default,,0,0,0,,‎Tham gia giải đấu quốc gia\N‎sẽ tốn nhiều tiền nhỉ?
Dialogue: 0,0:10:28.33,0:10:29.33,Default,,0,0,0,,‎Quyên góp.
Dialogue: 0,0:10:32.00,0:10:33.58,Default,,0,0,0,,‎Ý kiến không tồi.
Dialogue: 0,0:11:20.42,0:11:21.50,Default,,0,0,0,,‎Alô?
Dialogue: 0,0:11:22.50,0:11:24.42,Default,,0,0,0,,{\i1}‎Cậu là Kotani phải không?{\i0}
Dialogue: 0,0:11:25.21,0:11:26.38,Default,,0,0,0,,{\i1}‎Là tớ đây.{\i0}
Dialogue: 0,0:11:33.00,0:11:35.92,Default,,0,0,0,,‎Lần đầu tiên trong 30 năm\N‎tôi nói chuyện với Yokokawa.
Dialogue: 0,0:11:36.92,0:11:40.96,Default,,0,0,0,,‎Cậu ấy gọi vì biết tôi quyên góp tiền.
Dialogue: 0,0:11:43.13,0:11:44.21,Default,,0,0,0,,‎Tốt thật đấy.
Dialogue: 0,0:11:45.25,0:11:46.58,Default,,0,0,0,,‎Nhờ ông đấy, ông chủ.
Dialogue: 0,0:11:48.00,0:11:50.58,Default,,0,0,0,,‎Tôi có làm gì đâu.\N‎Tôi chỉ nảy ra ý đó thôi.
Dialogue: 0,0:11:51.13,0:11:52.63,Default,,0,0,0,,‎Cậu ta cũng nhớ.
Dialogue: 0,0:11:53.71,0:11:55.42,Default,,0,0,0,,‎Cậu ta nói trên điện thoại...
Dialogue: 0,0:11:56.42,0:11:58.50,Default,,0,0,0,,‎Cuối cùng tôi đã giữ lời hứa.
Dialogue: 0,0:12:02.50,0:12:03.38,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:12:05.08,0:12:08.75,Default,,0,0,0,,‎Đã gói hết lại như anh yêu cầu.\N‎Anh muốn ăn gì không?
Dialogue: 0,0:12:08.83,0:12:11.71,Default,,0,0,0,,‎Không, cảm ơn. Tôi sẽ đi đâu đó thật xa.
Dialogue: 0,0:12:13.33,0:12:17.37,Default,,0,0,0,,‎Đây. Không cần thối. Xin hãy giữ lấy.
Dialogue: 0,0:12:17.46,0:12:19.21,Default,,0,0,0,,‎Được. Cảm ơn anh.
Dialogue: 0,0:12:25.29,0:12:27.83,Default,,0,0,0,,‎Ông chủ, xin cảm ơn.
Dialogue: 0,0:12:45.58,0:12:47.04,Default,,0,0,0,,‎À phải rồi,
Dialogue: 0,0:12:47.71,0:12:52.09,Default,,0,0,0,,‎khi đi ngang qua quán cà phê mèo\N‎của anh Kotani, tôi thấy đóng cửa.
Dialogue: 0,0:12:52.79,0:12:53.71,Default,,0,0,0,,‎Thật ư?
Dialogue: 0,0:12:54.50,0:12:56.83,Default,,0,0,0,,‎Tôi tưởng nó nổi tiếng chứ?
Dialogue: 0,0:12:56.92,0:12:58.71,Default,,0,0,0,,‎Tôi cũng nghe thế
Dialogue: 0,0:12:59.29,0:13:03.25,Default,,0,0,0,,‎nhưng nghe nói cửa hàng trân châu\N‎Đài Loan mới tháng tới sẽ khai trương.
Dialogue: 0,0:13:03.79,0:13:06.00,Default,,0,0,0,,‎Trân châu? Là gì thế?
Dialogue: 0,0:13:07.21,0:13:09.96,Default,,0,0,0,,‎Ông không biết à? Trân châu.
Dialogue: 0,0:13:10.54,0:13:11.58,Default,,0,0,0,,‎Trân châu?
Dialogue: 0,0:13:12.33,0:13:13.62,Default,,0,0,0,,‎Trân châu.
Dialogue: 0,0:13:13.71,0:13:14.84,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:13:16.13,0:13:18.09,Default,,0,0,0,,‎Gã tên Kotani có đến đây không?
Dialogue: 0,0:13:19.08,0:13:20.12,Default,,0,0,0,,‎Anh Kotani?
Dialogue: 0,0:13:21.00,0:13:22.88,Default,,0,0,0,,‎Gần đây không thấy.
Dialogue: 0,0:13:27.67,0:13:29.00,Default,,0,0,0,,‎Hiểu rồi. Không sao.
Dialogue: 0,0:13:34.08,0:13:35.29,Default,,0,0,0,,‎Thế là sao chứ?
Dialogue: 0,0:13:36.75,0:13:38.25,Default,,0,0,0,,‎Bọn cho vay nặng lãi.
Dialogue: 0,0:13:41.46,0:13:43.09,Default,,0,0,0,,‎Chúng không tử tế đâu.
Dialogue: 0,0:13:47.25,0:13:49.29,Default,,0,0,0,,‎Kotani, ra đây mau!
Dialogue: 0,0:13:49.38,0:13:50.76,Default,,0,0,0,,‎Mày có trong đó nhỉ?
Dialogue: 0,0:13:50.83,0:13:52.66,Default,,0,0,0,,{\i1}‎Theo Ryu, việc kinh doanh...{\i0}
Dialogue: 0,0:13:52.75,0:13:54.33,Default,,0,0,0,,‎THƯ NHẮC NHỞ QUÁ HẠN THANH TOÁN
Dialogue: 0,0:13:54.42,0:13:56.84,Default,,0,0,0,,{\i1}‎...của anh Kotani không tốt{\i0}
Dialogue: 0,0:13:56.92,0:14:00.38,Default,,0,0,0,,{\i1}‎và anh ta có mượn{\i0}\N{\i1}‎một triệu yên từ công ty đó{\i0}
Dialogue: 0,0:14:00.46,0:14:02.25,Default,,0,0,0,,{\i1}‎rồi biến mất.{\i0}
Dialogue: 0,0:14:02.33,0:14:04.58,Default,,0,0,0,,‎Ra đây, tên kia! Này!
Dialogue: 0,0:14:04.67,0:14:10.09,Default,,0,0,0,,‎Nghĩ lại lúc anh ta say xỉn như thế,\N‎chắc hẳn rất tuyệt vọng.
Dialogue: 0,0:14:12.21,0:14:15.71,Default,,0,0,0,,‎Anh ta trông rất vui khi nói đến\N‎việc quyên góp tiền cho trường học.
Dialogue: 0,0:14:16.46,0:14:18.29,Default,,0,0,0,,‎Chắc số tiền đó từ...
Dialogue: 0,0:14:19.17,0:14:20.34,Default,,0,0,0,,‎Chắc thế.
Dialogue: 0,0:14:21.29,0:14:23.83,Default,,0,0,0,,‎Anh ta không thể\N‎quay lại thị trấn này rồi.
Dialogue: 0,0:14:44.33,0:14:47.71,Default,,0,0,0,,‎Hẳn gần đến cuối mùa\N‎của bệnh sốt mùa hè rồi nhỉ?
Dialogue: 0,0:14:47.79,0:14:51.04,Default,,0,0,0,,‎Tôi dị ứng với cây bách Nhật Bản,\N‎không phải tuyết tùng Nhật Bản.
Dialogue: 0,0:14:51.63,0:14:53.05,Default,,0,0,0,,‎Tôi chán bị vậy lắm rồi.
Dialogue: 0,0:14:56.58,0:14:57.54,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:14:57.63,0:14:58.76,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:15:02.13,0:15:03.63,Default,,0,0,0,,‎Anh là...
Dialogue: 0,0:15:04.50,0:15:06.13,Default,,0,0,0,,‎Tôi là Yokokawa. Hân hạnh.
Dialogue: 0,0:15:07.29,0:15:10.83,Default,,0,0,0,,‎Đây là bạn học của anh Kotani\N‎và là huấn luyện viên anh ta nhắc đến.
Dialogue: 0,0:15:12.08,0:15:13.37,Default,,0,0,0,,‎Thế à?
Dialogue: 0,0:15:13.92,0:15:16.25,Default,,0,0,0,,‎Tôi đã biết chuyện Kotani quyên tiền.
Dialogue: 0,0:15:16.83,0:15:19.71,Default,,0,0,0,,‎Cậu ấy bảo ông chủ quán ăn này\N‎đã đề nghị cậu ta làm vậy.
Dialogue: 0,0:15:20.38,0:15:21.21,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:15:22.58,0:15:23.71,Default,,0,0,0,,‎Cảm ơn rất nhiều.
Dialogue: 0,0:15:24.79,0:15:26.21,Default,,0,0,0,,‎Anh uống bia chứ?
Dialogue: 0,0:15:26.29,0:15:27.21,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:15:27.29,0:15:28.71,Default,,0,0,0,,‎Tôi mời.
Dialogue: 0,0:15:28.79,0:15:30.92,Default,,0,0,0,,‎Để chúc mừng được tham gia giải đấu.
Dialogue: 0,0:15:31.00,0:15:33.21,Default,,0,0,0,,‎Cảm ơn, nhưng...
Dialogue: 0,0:15:34.58,0:15:35.83,Default,,0,0,0,,‎Xin thứ lỗi.
Dialogue: 0,0:15:41.67,0:15:44.84,Default,,0,0,0,,‎Trận đó suýt hòa nhỉ?
Dialogue: 0,0:15:45.67,0:15:47.09,Default,,0,0,0,,‎Bọn tôi đã thua đậm.
Dialogue: 0,0:15:48.29,0:15:51.62,Default,,0,0,0,,‎Ít nhất bọn tôi đã cố\N‎tấn công lại và ghi bàn ở hiệp cuối
Dialogue: 0,0:15:52.54,0:15:54.83,Default,,0,0,0,,‎và tránh được trận đấu không ghi bàn.
Dialogue: 0,0:15:54.92,0:15:59.63,Default,,0,0,0,,‎Thật tuyệt vời khi được tham gia giải đấu.
Dialogue: 0,0:15:59.71,0:16:00.88,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:16:00.96,0:16:02.09,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:16:08.46,0:16:14.04,Default,,0,0,0,,‎Ước gì anh Kotani thành thật\N‎được như anh, 10% như anh cũng được.
Dialogue: 0,0:16:16.67,0:16:17.96,Default,,0,0,0,,‎Mọi người biết...
Dialogue: 0,0:16:18.83,0:16:20.33,Default,,0,0,0,,‎cậu ấy nợ nần, đúng chứ?
Dialogue: 0,0:16:22.83,0:16:25.96,Default,,0,0,0,,‎Cậu ấy còn đến tận sân vận động.
Dialogue: 0,0:16:26.96,0:16:28.63,Default,,0,0,0,,‎Anh có gặp anh ta?
Dialogue: 0,0:16:29.17,0:16:33.59,Default,,0,0,0,,‎Có. Lúc đó cậu ấy kể cho tôi về món nợ.
Dialogue: 0,0:16:35.50,0:16:37.13,Default,,0,0,0,,‎Cho tới giờ chưa gặp lại.
Dialogue: 0,0:16:39.00,0:16:40.54,Default,,0,0,0,,‎Bọn tôi hứa sẽ gặp nhau ở đây.
Dialogue: 0,0:16:41.38,0:16:43.38,Default,,0,0,0,,‎Gặp anh ta? Ở đây à?
Dialogue: 0,0:16:44.17,0:16:45.30,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:16:49.67,0:16:50.67,Default,,0,0,0,,‎Ryu!
Dialogue: 0,0:16:52.29,0:16:54.50,Default,,0,0,0,,‎Ông chủ, món như mọi khi với cái này nhé.
Dialogue: 0,0:16:56.13,0:16:57.13,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:17:09.88,0:17:11.46,Default,,0,0,0,,‎Đây là anh Kenzaki.
Dialogue: 0,0:17:12.17,0:17:14.25,Default,,0,0,0,,‎Chuyện gần đây của tôi\N‎được anh ấy giúp đỡ nhiều.
Dialogue: 0,0:17:15.08,0:17:16.08,Default,,0,0,0,,‎Đây là Yokokawa.
Dialogue: 0,0:17:16.17,0:17:19.30,Default,,0,0,0,,‎Huấn luyện viên của đội bóng trung học\N‎tôi có kể với anh hôm trước.
Dialogue: 0,0:17:19.83,0:17:22.00,Default,,0,0,0,,‎Chúc đội bóng của anh\N‎may mắn với giải đấu mùa hè.
Dialogue: 0,0:17:23.13,0:17:24.05,Default,,0,0,0,,‎Cảm ơn anh.
Dialogue: 0,0:17:25.58,0:17:31.71,Default,,0,0,0,,‎Tôi nghĩ đến chuyện tự sát bằng cách\N‎nhảy xuống vách núi sau khi xem trận bóng.
Dialogue: 0,0:17:32.71,0:17:38.42,Default,,0,0,0,,‎Anh ta quát tôi,\N‎"Thật ngốc khi chết vì tiền."
Dialogue: 0,0:17:39.13,0:17:41.84,Default,,0,0,0,,‎Thế nên tôi quay lại đây.
Dialogue: 0,0:17:43.00,0:17:46.58,Default,,0,0,0,,‎Rồi gặp phải anh ta ở khu tập đánh bóng.
Dialogue: 0,0:17:46.67,0:17:50.00,Default,,0,0,0,,‎Vậy là anh ta giúp anh\N‎giải quyết mọi chuyện?
Dialogue: 0,0:17:50.08,0:17:50.91,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:17:51.67,0:17:53.46,Default,,0,0,0,,‎Sau khi anh Kenzaki nói chuyện với họ,
Dialogue: 0,0:17:54.17,0:17:55.88,Default,,0,0,0,,‎họ đã trì hoãn hạn thanh toán
Dialogue: 0,0:17:55.96,0:17:58.13,Default,,0,0,0,,‎và còn giảm cả lãi suất.
Dialogue: 0,0:17:59.21,0:18:03.25,Default,,0,0,0,,‎Cảm ơn rất nhiều vì đã cứu mạng tôi.
Dialogue: 0,0:18:06.46,0:18:08.46,Default,,0,0,0,,‎Anh nên chọn bạn mà chơi.
Dialogue: 0,0:18:08.54,0:18:10.08,Default,,0,0,0,,‎Vì học trò của anh nữa.
Dialogue: 0,0:18:19.46,0:18:23.17,Default,,0,0,0,,‎Tôi sẽ đảm bảo cậu ấy giữ lời hứa với anh.
Dialogue: 0,0:18:31.54,0:18:33.04,Default,,0,0,0,,‎Này...
Dialogue: 0,0:18:33.13,0:18:35.92,Default,,0,0,0,,‎Yokokawa, cậu nói thế là sao?
Dialogue: 0,0:18:36.96,0:18:38.25,Default,,0,0,0,,‎Anh Kotani...
Dialogue: 0,0:18:38.88,0:18:41.88,Default,,0,0,0,,‎anh thật quá ngây thơ.
Dialogue: 0,0:18:43.13,0:18:45.67,Default,,0,0,0,,‎Nếu anh không trả số nợ của mình,
Dialogue: 0,0:18:45.75,0:18:50.75,Default,,0,0,0,,‎Ryu cũng gánh trách nhiệm\N‎vì đã đứng ra bảo vệ anh.
Dialogue: 0,0:18:54.46,0:18:57.46,Default,,0,0,0,,‎Ryu quá tử tế.
Dialogue: 0,0:19:04.33,0:19:07.08,Default,,0,0,0,,‎Tôi rất vui vì cậu đã quyên tiền.
Dialogue: 0,0:19:08.63,0:19:12.76,Default,,0,0,0,,‎Tôi sẽ vui hơn nếu số tiền đó\N‎không phải của công ty cho vay.
Dialogue: 0,0:19:17.08,0:19:18.21,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:19:20.67,0:19:23.96,Default,,0,0,0,,‎Anh Kotani lúc nào cũng gọi món này.
Dialogue: 0,0:19:27.33,0:19:31.41,Default,,0,0,0,,‎Hồi học đại học, bọn tôi thử đi bộ về quê.
Dialogue: 0,0:19:32.29,0:19:34.17,Default,,0,0,0,,‎Trên đường đã chia nhau món này.
Dialogue: 0,0:19:34.25,0:19:37.08,Default,,0,0,0,,‎Vâng, anh ta có kể.
Dialogue: 0,0:19:38.83,0:19:41.54,Default,,0,0,0,,‎Lúc đầu, cậu ấy bảo, "Tớ không ăn đâu.
Dialogue: 0,0:19:43.00,0:19:47.46,Default,,0,0,0,,‎Tớ không đói vì tớ không chơi\N‎thể thao nhiều như cậu."
Dialogue: 0,0:19:47.54,0:19:49.12,Default,,0,0,0,,‎Một lý do kỳ lạ.
Dialogue: 0,0:19:50.25,0:19:52.00,Default,,0,0,0,,‎Nhưng dạ dày cậu ấy réo lên.
Dialogue: 0,0:19:53.50,0:19:56.75,Default,,0,0,0,,‎Nên tôi bảo cậu ấy\N‎chia làm hai và cậu ấy làm...
Dialogue: 0,0:20:02.79,0:20:03.79,Default,,0,0,0,,‎Như thế này.
Dialogue: 0,0:20:05.13,0:20:07.42,Default,,0,0,0,,‎Chẳng bằng nhau gì cả.
Dialogue: 0,0:20:09.17,0:20:13.09,Default,,0,0,0,,‎Cậu ấy nhìn tôi như chú cún con.
Dialogue: 0,0:20:14.92,0:20:16.25,Default,,0,0,0,,‎Rồi đưa tôi...
Dialogue: 0,0:20:17.71,0:20:19.34,Default,,0,0,0,,‎phần bự hơn.
Dialogue: 0,0:20:23.17,0:20:24.59,Default,,0,0,0,,‎Cậu chuyện rất hay.
Dialogue: 0,0:20:27.33,0:20:30.87,Default,,0,0,0,,‎Đó là lúc cậu thấy tuyệt vọng...
Dialogue: 0,0:20:31.75,0:20:34.17,Default,,0,0,0,,‎vì không thể chơi bóng chày được nữa.
Dialogue: 0,0:20:38.63,0:20:40.09,Default,,0,0,0,,‎Lúc đó...
Dialogue: 0,0:20:41.46,0:20:45.13,Default,,0,0,0,,‎khi nhìn thấy ánh mắt đăm chiêu của cậu,
Dialogue: 0,0:20:45.83,0:20:48.91,Default,,0,0,0,,‎tôi thấy đỡ hơn nhiều.
Dialogue: 0,0:20:50.42,0:20:54.88,Default,,0,0,0,,‎Tôi lại nghĩ đến\N‎tương lai của mình một chút,
Dialogue: 0,0:20:57.13,0:20:58.59,Default,,0,0,0,,‎"Kể cả không chơi bóng,
Dialogue: 0,0:20:59.83,0:21:02.50,Default,,0,0,0,,‎mình vẫn có thể\N‎liên quan đến bóng chày theo nhiều cách."
Dialogue: 0,0:21:08.00,0:21:11.42,Default,,0,0,0,,‎Cậu đã giúp chúng tôi đến được\N‎Sân vận động Koshien.
Dialogue: 0,0:21:15.79,0:21:19.37,Default,,0,0,0,,‎Tôi chắc cậu có thể vượt qua chuyện này.
Dialogue: 0,0:21:21.17,0:21:22.96,Default,,0,0,0,,‎Đến lượt tôi hỗ trợ cậu rồi.
Dialogue: 0,0:22:06.21,0:22:07.29,Default,,0,0,0,,‎Ăn đi.
Dialogue: 0,0:23:50.00,0:23:52.83,Default,,0,0,0,,‎ĐÂY LÀ CÂU CHUYỆN HƯ CẤU
Dialogue: 0,0:23:52.92,0:23:54.92,Default,,0,0,0,,‎Biên dịch: Hiền Phạm
