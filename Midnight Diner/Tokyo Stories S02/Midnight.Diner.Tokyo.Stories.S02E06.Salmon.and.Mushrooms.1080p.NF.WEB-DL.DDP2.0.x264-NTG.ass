Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:10.29,0:01:14.50,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:01:15.21,0:01:17.13,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:34.46,0:01:38.21,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:39.04,0:01:42.42,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:44.92,0:01:46.55,Default,,0,0,0,,‎COMBO CANH MISO THỊT HEO,\N‎BIA, RƯỢU SAKE, RƯỢU SHOCHU
Dialogue: 0,0:01:46.63,0:01:48.51,Default,,0,0,0,,{\i1}‎Chỉ có vậy trong thực đơn.{\i0}
Dialogue: 0,0:01:48.58,0:01:54.46,Default,,0,0,0,,{\i1}‎Nhưng tôi chế biến theo yêu cầu của khách,{\i0}\N{\i1}‎miễn là tôi có đủ nguyên liệu.{\i0}
Dialogue: 0,0:01:54.54,0:01:56.58,Default,,0,0,0,,{\i1}‎Đó là chính sách của tôi.{\i0}
Dialogue: 0,0:02:00.67,0:02:02.63,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:02:02.71,0:02:04.59,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:02:10.63,0:02:15.01,Default,,0,0,0,,‎CÁ HỒI VÀ NẤM
Dialogue: 0,0:02:16.67,0:02:18.13,Default,,0,0,0,,‎Của quý khách đây.
Dialogue: 0,0:02:19.25,0:02:20.42,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:02:22.08,0:02:24.33,Default,,0,0,0,,‎Của ông đây.
Dialogue: 0,0:02:30.71,0:02:32.13,Default,,0,0,0,,‎Yên lặng thật đấy.
Dialogue: 0,0:02:32.71,0:02:35.17,Default,,0,0,0,,‎Mùa thu là thích hợp nhất để ăn ngon.
Dialogue: 0,0:03:11.83,0:03:12.96,Default,,0,0,0,,‎Của hai người đây.
Dialogue: 0,0:03:13.04,0:03:16.54,Default,,0,0,0,,‎Cá hồi nướng muối và nấm xào bơ.
Dialogue: 0,0:03:16.63,0:03:17.88,Default,,0,0,0,,‎Tôi đã đợi món này đấy.
Dialogue: 0,0:03:20.38,0:03:21.51,Default,,0,0,0,,‎Mùi thơm này...
Dialogue: 0,0:03:22.00,0:03:23.46,Default,,0,0,0,,‎- Cảm ơn.\N‎- Cảm ơn.
Dialogue: 0,0:03:24.00,0:03:26.38,Default,,0,0,0,,‎Ông chủ, một ly whiskey sour nữa nhé.
Dialogue: 0,0:03:26.46,0:03:27.29,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:03:27.38,0:03:30.84,Default,,0,0,0,,{\i1}‎Anh Uehara và Kimie là cặp vợ chồng{\i0}
Dialogue: 0,0:03:30.92,0:03:33.92,Default,,0,0,0,,{\i1}‎kinh doanh một tiệm hớt tóc{\i0}\N{\i1}‎có tên Barber Uehara.{\i0}
Dialogue: 0,0:03:34.00,0:03:36.17,Default,,0,0,0,,{\i1}‎Thỉnh thoảng họ đến đây cùng nhau.{\i0}
Dialogue: 0,0:03:36.25,0:03:37.75,Default,,0,0,0,,‎Nấm này ngon thật.
Dialogue: 0,0:03:38.88,0:03:40.26,Default,,0,0,0,,‎Cá hồi cũng ngon nữa.
Dialogue: 0,0:03:41.71,0:03:43.71,Default,,0,0,0,,‎Hai người quê ở đâu?
Dialogue: 0,0:03:44.25,0:03:46.29,Default,,0,0,0,,‎Tôi quê ở Nemuro, Hokkaido.
Dialogue: 0,0:03:46.38,0:03:47.71,Default,,0,0,0,,‎Còn tôi đến từ Nagano.
Dialogue: 0,0:03:47.79,0:03:49.29,Default,,0,0,0,,‎Sâu trong núi Kiso.
Dialogue: 0,0:03:50.58,0:03:52.08,Default,,0,0,0,,‎Điều đó giải thích khẩu vị của hai người.
Dialogue: 0,0:03:52.67,0:03:56.38,Default,,0,0,0,,‎Bố tôi thường sai tôi\N‎đi tìm nấm vào mùa thu.
Dialogue: 0,0:03:56.46,0:03:58.63,Default,,0,0,0,,‎Lúc nhỏ, có một ngư dân nhà tôi quen biết
Dialogue: 0,0:03:58.71,0:04:00.84,Default,,0,0,0,,‎năm nào cũng biếu chúng tôi cá hồi tươi.
Dialogue: 0,0:04:01.92,0:04:03.34,Default,,0,0,0,,‎Nhân tiện, Kimie,
Dialogue: 0,0:04:03.42,0:04:06.46,Default,,0,0,0,,‎cô nói có thể\N‎sẽ đi du lịch Thượng Hải cùng bạn.
Dialogue: 0,0:04:06.54,0:04:07.50,Default,,0,0,0,,‎Cô sẽ đi chứ?
Dialogue: 0,0:04:07.58,0:04:09.62,Default,,0,0,0,,‎Vâng, tôi quyết định sẽ đi.
Dialogue: 0,0:04:10.50,0:04:11.33,Default,,0,0,0,,‎Khi nào thế?
Dialogue: 0,0:04:11.42,0:04:12.63,Default,,0,0,0,,‎Ngày mốt.
Dialogue: 0,0:04:12.71,0:04:15.38,Default,,0,0,0,,‎Đó là tour ăn cua\N‎năm đêm ăn không giới hạn.
Dialogue: 0,0:04:16.29,0:04:19.21,Default,,0,0,0,,‎Thật ghen tị!\N‎Tôi thích cua Thượng Hải lắm.
Dialogue: 0,0:04:19.29,0:04:21.04,Default,,0,0,0,,‎Cua mùa này là ngon nhất.
Dialogue: 0,0:04:21.13,0:04:22.09,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:04:22.79,0:04:25.42,Default,,0,0,0,,‎- Anh ở nhà sao, anh Uehara?\N‎- Vâng.
Dialogue: 0,0:04:26.13,0:04:28.76,Default,,0,0,0,,‎Kimie luôn muốn đi Thượng Hải,
Dialogue: 0,0:04:28.83,0:04:31.87,Default,,0,0,0,,‎nhưng chúng tôi phải ưu tiên công việc.
Dialogue: 0,0:04:31.96,0:04:33.71,Default,,0,0,0,,‎- Nghỉ ngơi thật tốt nhé.\N‎- Vâng.
Dialogue: 0,0:04:34.63,0:04:35.71,Default,,0,0,0,,‎Chà,
Dialogue: 0,0:04:36.33,0:04:37.96,Default,,0,0,0,,‎đúng là anh chồng chu đáo!
Dialogue: 0,0:04:39.75,0:04:41.71,Default,,0,0,0,,‎Chỉ một tuần, nên một mình tôi...
Dialogue: 0,0:04:42.38,0:04:43.55,Default,,0,0,0,,‎sẽ ổn thôi.
Dialogue: 0,0:04:46.75,0:04:49.38,Default,,0,0,0,,{\i1}‎Đó là anh Uehara nói vậy,{\i0}
Dialogue: 0,0:04:49.46,0:04:52.25,Default,,0,0,0,,{\i1}‎nhưng một ngày{\i0}\N{\i1}‎sau khi Kimie đi Thượng Hải,{\i0}
Dialogue: 0,0:04:52.33,0:04:56.21,Default,,0,0,0,,{\i1}‎hầu như đêm nào anh ta cũng đến chỗ tôi.{\i0}
Dialogue: 0,0:05:10.21,0:05:12.84,Default,,0,0,0,,‎Ở cửa tiệm tôi thấy không sao,
Dialogue: 0,0:05:12.92,0:05:14.88,Default,,0,0,0,,‎nhưng khi ở nhà một mình,
Dialogue: 0,0:05:14.96,0:05:17.92,Default,,0,0,0,,‎tôi thao thức và thấy lo lắng.
Dialogue: 0,0:05:18.00,0:05:20.88,Default,,0,0,0,,‎Khiến tôi muốn đi đâu đó với mọi người.
Dialogue: 0,0:05:23.08,0:05:25.00,Default,,0,0,0,,‎Thêm bia nữa nhé.
Dialogue: 0,0:05:25.08,0:05:25.91,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:05:26.50,0:05:29.63,Default,,0,0,0,,‎Kimie đang trải nghiệm\N‎những điều mới mẻ ở Thượng Hải,
Dialogue: 0,0:05:29.71,0:05:33.84,Default,,0,0,0,,‎nên tôi nghĩ chả sao\N‎nếu anh cũng thư giãn đôi chút. Nhỉ?
Dialogue: 0,0:05:33.92,0:05:35.38,Default,,0,0,0,,‎Đừng lo lắng.
Dialogue: 0,0:05:36.00,0:05:39.58,Default,,0,0,0,,‎Thật ra, tôi vừa chơi pachinko\N‎lần đầu tiên sau một thời gian dài.
Dialogue: 0,0:05:39.67,0:05:41.42,Default,,0,0,0,,‎Tôi thua 30.000 yên.
Dialogue: 0,0:05:42.17,0:05:43.88,Default,,0,0,0,,‎Thư giãn vậy là quá nhiều đấy.
Dialogue: 0,0:05:43.96,0:05:46.21,Default,,0,0,0,,‎Tôi có hơi lún sâu vào trò đó.
Dialogue: 0,0:05:51.42,0:05:52.38,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:05:57.38,0:06:00.88,Default,,0,0,0,,‎Anh Uehara như thế sẽ không sao chứ?
Dialogue: 0,0:06:00.96,0:06:04.92,Default,,0,0,0,,‎Đừng lo. Vài ngày nữa Kimie sẽ về mà.
Dialogue: 0,0:06:08.17,0:06:10.75,Default,,0,0,0,,‎- Hoan nghênh.\N‎- Chào buổi tối.
Dialogue: 0,0:06:16.13,0:06:17.09,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:06:19.79,0:06:20.87,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:06:22.92,0:06:26.67,Default,,0,0,0,,‎Vậy hai người là bạn thời thơ ấu?
Dialogue: 0,0:06:27.25,0:06:29.58,Default,,0,0,0,,‎Bọn tôi từng là hàng xóm.
Dialogue: 0,0:06:29.67,0:06:31.67,Default,,0,0,0,,‎Khi đang tìm người
Dialogue: 0,0:06:31.75,0:06:34.96,Default,,0,0,0,,‎để dạy nhân viên mới\N‎cách mặc kimono, bọn tôi tình cờ gặp lại.
Dialogue: 0,0:06:35.75,0:06:39.08,Default,,0,0,0,,‎Rất ngạc nhiên.\N‎Hàng chục năm rồi mới gặp lại.
Dialogue: 0,0:06:40.33,0:06:42.29,Default,,0,0,0,,‎- Cô dạy cách mặc kimono à?\N‎- Vâng.
Dialogue: 0,0:06:43.17,0:06:46.17,Default,,0,0,0,,‎Tôi sống ở Kansai một thời gian\N‎sau khi kết hôn,
Dialogue: 0,0:06:47.04,0:06:50.46,Default,,0,0,0,,‎nhưng năm ngoái\N‎chồng tôi qua đời, nên tôi đến đây.
Dialogue: 0,0:06:52.58,0:06:53.50,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:07:00.58,0:07:01.75,Default,,0,0,0,,‎Ông giỏi thật.
Dialogue: 0,0:07:03.83,0:07:06.00,Default,,0,0,0,,‎Ông chủ, thêm dưa muối nhé.
Dialogue: 0,0:07:07.33,0:07:08.16,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:07:10.83,0:07:12.29,Default,,0,0,0,,‎Tôi là Sayoko Kagami.
Dialogue: 0,0:07:12.83,0:07:14.79,Default,,0,0,0,,‎Hân hạnh được gặp mọi người.
Dialogue: 0,0:07:23.13,0:07:25.17,Default,,0,0,0,,‎Có phải mỗi tôi\N‎nghĩ điều này không, nhưng...
Dialogue: 0,0:07:25.79,0:07:28.17,Default,,0,0,0,,‎cô trông trẻ ra đấy.
Dialogue: 0,0:07:29.96,0:07:31.79,Default,,0,0,0,,‎Tuyệt thật!
Dialogue: 0,0:07:32.33,0:07:33.50,Default,,0,0,0,,‎Cô nói xem?
Dialogue: 0,0:07:35.42,0:07:37.75,Default,,0,0,0,,‎Là do yêu đương chăng?
Dialogue: 0,0:07:38.79,0:07:40.12,Default,,0,0,0,,‎Không!
Dialogue: 0,0:07:40.67,0:07:42.21,Default,,0,0,0,,‎Tôi được cạo mặt đấy.
Dialogue: 0,0:07:42.29,0:07:43.25,Default,,0,0,0,,‎Cạo mặt?
Dialogue: 0,0:07:44.21,0:07:47.21,Default,,0,0,0,,‎Các người biết anh Uehara vừa ở đây chứ?
Dialogue: 0,0:07:47.29,0:07:48.37,Default,,0,0,0,,‎Anh ta là thợ cắt tóc.
Dialogue: 0,0:07:48.46,0:07:51.50,Default,,0,0,0,,‎Thực sự rất giỏi.
Dialogue: 0,0:07:51.58,0:07:54.41,Default,,0,0,0,,‎Khi anh ta chạm vào da mặt tôi,
Dialogue: 0,0:07:54.50,0:07:58.79,Default,,0,0,0,,‎quả thực đôi bàn tay ấy\N‎mềm mại hơn đàn ông khác.
Dialogue: 0,0:07:58.88,0:08:02.34,Default,,0,0,0,,‎Đặc biệt khi đầu ngón tay anh ta...
Dialogue: 0,0:08:08.75,0:08:09.83,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:08:10.58,0:08:11.91,Default,,0,0,0,,‎Đã đóng cửa rồi à?
Dialogue: 0,0:08:12.75,0:08:13.71,Default,,0,0,0,,‎Chưa.
Dialogue: 0,0:08:14.79,0:08:16.29,Default,,0,0,0,,‎Tôi không đặt lịch trước.
Dialogue: 0,0:08:17.63,0:08:20.55,Default,,0,0,0,,‎Có thể cạo mặt cho tôi được không?
Dialogue: 0,0:08:22.33,0:08:23.25,Default,,0,0,0,,‎Dĩ nhiên rồi.
Dialogue: 0,0:09:02.96,0:09:03.88,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:09:05.17,0:09:06.88,Default,,0,0,0,,‎Dái tai tôi hơi nhạy cảm.
Dialogue: 0,0:09:09.17,0:09:10.17,Default,,0,0,0,,‎Tôi có nên dừng?
Dialogue: 0,0:09:10.25,0:09:11.29,Default,,0,0,0,,‎Không.
Dialogue: 0,0:09:12.08,0:09:13.16,Default,,0,0,0,,‎Cứ tiếp tục.
Dialogue: 0,0:09:14.00,0:09:14.83,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:09:33.38,0:09:34.42,Default,,0,0,0,,‎Tiền thừa của cô.
Dialogue: 0,0:09:36.50,0:09:37.67,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:09:38.29,0:09:40.12,Default,,0,0,0,,‎Đã khiến anh đóng cửa muộn.
Dialogue: 0,0:09:40.21,0:09:41.71,Default,,0,0,0,,‎Không, đừng bận tâm.
Dialogue: 0,0:09:42.33,0:09:44.62,Default,,0,0,0,,‎Tôi nghe kể về anh ở một quán ăn.
Dialogue: 0,0:09:45.38,0:09:47.01,Default,,0,0,0,,‎Vậy sao?
Dialogue: 0,0:09:47.08,0:09:48.91,Default,,0,0,0,,‎Tốt hơn tôi nghĩ.
Dialogue: 0,0:09:49.00,0:09:50.54,Default,,0,0,0,,‎Cảm ơn rất nhiều.
Dialogue: 0,0:09:51.63,0:09:56.38,Default,,0,0,0,,‎Ăn tối với tôi nhé? Nếu anh không phiền.
Dialogue: 0,0:09:56.46,0:09:59.38,Default,,0,0,0,,‎Tôi mời. Xem như cảm ơn\N‎vì đã mở cửa muộn thế này.
Dialogue: 0,0:10:00.67,0:10:02.88,Default,,0,0,0,,‎Không có gì...
Dialogue: 0,0:10:03.83,0:10:04.66,Default,,0,0,0,,‎Thật ra...
Dialogue: 0,0:10:05.67,0:10:07.05,Default,,0,0,0,,‎tối nay tôi chỉ có một mình.
Dialogue: 0,0:10:08.79,0:10:09.79,Default,,0,0,0,,‎Nhé?
Dialogue: 0,0:10:13.21,0:10:15.46,Default,,0,0,0,,‎QUÁN ĂN
Dialogue: 0,0:10:15.54,0:10:17.79,Default,,0,0,0,,‎Cua Thượng Hải ngon chứ?
Dialogue: 0,0:10:18.38,0:10:21.09,Default,,0,0,0,,‎Vâng, tôi đã ăn nhiều hết mức có thể.
Dialogue: 0,0:10:22.17,0:10:24.13,Default,,0,0,0,,‎Bánh trung thu này rất ngon.
Dialogue: 0,0:10:25.50,0:10:28.46,Default,,0,0,0,,‎Ở Nhật, ta ăn bánh trôi dango\N‎trong lúc ngắm trăng,
Dialogue: 0,0:10:28.54,0:10:31.54,Default,,0,0,0,,‎nhưng ở Trung Quốc,\N‎họ ăn bánh trung thu này.
Dialogue: 0,0:10:34.42,0:10:38.00,Default,,0,0,0,,‎Anh Uehara cư xử rất lạ lúc cô đi vắng.
Dialogue: 0,0:10:38.79,0:10:40.21,Default,,0,0,0,,‎Vậy ư?
Dialogue: 0,0:10:40.83,0:10:44.33,Default,,0,0,0,,‎Anh ấy không ổn khi không có vợ bên cạnh.
Dialogue: 0,0:10:44.42,0:10:45.88,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:10:45.96,0:10:49.00,Default,,0,0,0,,‎Cua Thượng Hải ngon\N‎nhưng tôi vẫn thích món cá hồi.
Dialogue: 0,0:10:49.08,0:10:52.08,Default,,0,0,0,,‎Cá hồi này được bắt từ vùng biển Okhotsk.
Dialogue: 0,0:10:52.17,0:10:53.63,Default,,0,0,0,,‎Vui quá đi!
Dialogue: 0,0:10:54.58,0:10:56.96,Default,,0,0,0,,‎Nhân tiện, người phụ nữ đến đây...
Dialogue: 0,0:10:57.71,0:10:58.75,Default,,0,0,0,,‎Tên cô ta là gì nhỉ?
Dialogue: 0,0:10:59.46,0:11:01.34,Default,,0,0,0,,‎Bạn thời thơ ấu của cô tiếp viên đó.
Dialogue: 0,0:11:02.38,0:11:04.21,Default,,0,0,0,,‎Là Sayoko dạy cách mặc kimono.
Dialogue: 0,0:11:04.29,0:11:05.12,Default,,0,0,0,,‎Là cô ta.
Dialogue: 0,0:11:05.67,0:11:06.88,Default,,0,0,0,,‎Cô ta có đến quán anh không?
Dialogue: 0,0:11:08.67,0:11:09.50,Default,,0,0,0,,‎Không.
Dialogue: 0,0:11:10.33,0:11:13.08,Default,,0,0,0,,‎Cô ta có vẻ đẹp mặn mà nhỉ?
Dialogue: 0,0:11:13.17,0:11:14.92,Default,,0,0,0,,‎Kimono rất hợp với cô ta.
Dialogue: 0,0:11:15.58,0:11:18.00,Default,,0,0,0,,‎Ông chủ, cho tôi ít cơm nữa nhé?
Dialogue: 0,0:11:18.08,0:11:19.04,Default,,0,0,0,,‎Chắc rồi.
Dialogue: 0,0:11:19.88,0:11:22.96,Default,,0,0,0,,‎Dù sao cũng rất vui\N‎khi biết cô đã được thư giãn.
Dialogue: 0,0:11:23.58,0:11:24.46,Default,,0,0,0,,‎Thực vậy.
Dialogue: 0,0:11:27.08,0:11:30.29,Default,,0,0,0,,‎Em xin lỗi vì để anh\N‎xoay xở mọi chuyện ở cửa tiệm.
Dialogue: 0,0:11:30.38,0:11:32.09,Default,,0,0,0,,‎Không sao.
Dialogue: 0,0:11:35.58,0:11:37.25,Default,,0,0,0,,‎Chắc tuyệt vời lắm...
Dialogue: 0,0:11:52.04,0:11:53.25,Default,,0,0,0,,‎Xin chờ một chút.
Dialogue: 0,0:11:57.54,0:11:59.17,Default,,0,0,0,,‎Tiệm cắt tóc Barber Uehara.
Dialogue: 0,0:12:00.63,0:12:02.63,Default,,0,0,0,,‎Tôi hiểu rồi. Cạo mặt thôi nhỉ?
Dialogue: 0,0:12:04.17,0:12:05.34,Default,,0,0,0,,‎Ngày mai lúc 3:00.
Dialogue: 0,0:12:06.50,0:12:07.67,Default,,0,0,0,,‎Tên cô là?
Dialogue: 0,0:12:09.08,0:12:11.16,Default,,0,0,0,,‎Cô Sayoko Kagami.
Dialogue: 0,0:12:15.58,0:12:16.71,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:12:18.92,0:12:22.17,Default,,0,0,0,,‎Rất mong được gặp cô. Cảm ơn.
Dialogue: 0,0:12:28.92,0:12:30.38,Default,,0,0,0,,‎Cảm ơn quý khách nhiều.
Dialogue: 0,0:12:40.92,0:12:42.17,Default,,0,0,0,,‎Anh ổn chứ?
Dialogue: 0,0:12:43.17,0:12:44.63,Default,,0,0,0,,‎Em thấy anh làm rơi dao cạo.
Dialogue: 0,0:12:47.46,0:12:48.71,Default,,0,0,0,,‎Chắc do anh mệt quá.
Dialogue: 0,0:12:51.46,0:12:55.13,Default,,0,0,0,,‎Đã có chuyện gì lúc em đi vắng à?
Dialogue: 0,0:12:57.25,0:12:58.38,Default,,0,0,0,,‎Ý em là sao chứ?
Dialogue: 0,0:13:04.79,0:13:08.58,Default,,0,0,0,,‎Em không giận đâu,\N‎nên xin đừng nói dối em.
Dialogue: 0,0:13:25.29,0:13:26.37,Default,,0,0,0,,‎Anh xin lỗi!
Dialogue: 0,0:13:27.54,0:13:28.46,Default,,0,0,0,,‎Kimie...
Dialogue: 0,0:13:29.21,0:13:30.13,Default,,0,0,0,,‎Anh...
Dialogue: 0,0:13:34.54,0:13:35.67,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:13:36.58,0:13:38.75,Default,,0,0,0,,‎Đây là lần đầu tôi...
Dialogue: 0,0:13:40.63,0:13:42.09,Default,,0,0,0,,‎Là tại anh.
Dialogue: 0,0:13:44.88,0:13:48.05,Default,,0,0,0,,‎Chạm vào mặt tôi như thế...
Dialogue: 0,0:13:48.13,0:13:50.55,Default,,0,0,0,,‎Khiến tôi hoàn toàn phát điên.
Dialogue: 0,0:13:52.67,0:13:55.50,Default,,0,0,0,,‎Có những chuyện ta phải làm...
Dialogue: 0,0:13:56.50,0:13:59.58,Default,,0,0,0,,‎cho dù biết là không đúng.
Dialogue: 0,0:14:01.54,0:14:02.58,Default,,0,0,0,,‎Vâng...
Dialogue: 0,0:14:04.46,0:14:05.46,Default,,0,0,0,,‎Tôi sẽ đi...
Dialogue: 0,0:14:06.33,0:14:08.04,Default,,0,0,0,,‎tắm trước.
Dialogue: 0,0:14:08.13,0:14:08.96,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:14:18.83,0:14:19.83,Default,,0,0,0,,‎Anh biết cách...
Dialogue: 0,0:14:23.75,0:14:25.42,Default,,0,0,0,,‎mặc kimono chứ?
Dialogue: 0,0:14:27.79,0:14:28.75,Default,,0,0,0,,‎Không...
Dialogue: 0,0:14:31.00,0:14:33.79,Default,,0,0,0,,‎Đàn ông từng biết cách làm thế.
Dialogue: 0,0:14:35.04,0:14:39.37,Default,,0,0,0,,‎Họ luôn đảm bảo phụ nữ trần truồng\N‎về nhà như một quý cô.
Dialogue: 0,0:14:48.63,0:14:51.46,Default,,0,0,0,,‎Vậy là, anh ấy vô cùng khiếp sợ.
Dialogue: 0,0:14:52.25,0:14:55.50,Default,,0,0,0,,‎Tay run bần bật không cầm nổi dao cạo.
Dialogue: 0,0:14:56.33,0:14:59.16,Default,,0,0,0,,‎Đúng là ngốc mà. Thật đáng thương.
Dialogue: 0,0:15:00.63,0:15:02.71,Default,,0,0,0,,{\i1}‎Vợ của một tên xã hội đen trước đây...{\i0}
Dialogue: 0,0:15:07.38,0:15:10.63,Default,,0,0,0,,‎Hẳn là cô ta đã không bật đèn trong phòng.
Dialogue: 0,0:15:12.21,0:15:16.13,Default,,0,0,0,,‎Nhưng cô sẽ nghĩ anh ta\N‎vẫn sẽ nhìn thấy lưng cô ta, dù...
Dialogue: 0,0:15:17.04,0:15:21.08,Default,,0,0,0,,‎Không, thông thường,\N‎cô chắc chắn sẽ thấy nó...
Dialogue: 0,0:15:28.96,0:15:31.04,Default,,0,0,0,,‎Anh ta đang làm gì thế?
Dialogue: 0,0:15:31.92,0:15:33.05,Default,,0,0,0,,‎Bỏ đi rồi.
Dialogue: 0,0:15:33.67,0:15:36.46,Default,,0,0,0,,‎Chắc đang ở khách sạn con nhộng\N‎hay gì đấy.
Dialogue: 0,0:15:43.42,0:15:45.63,Default,,0,0,0,,‎- Ông chủ, thêm bia nhé.\N‎- Vâng.
Dialogue: 0,0:15:49.88,0:15:52.63,Default,,0,0,0,,‎Mọi thứ đã diễn ra quá êm ả.
Dialogue: 0,0:15:53.83,0:15:57.12,Default,,0,0,0,,‎Bọn tôi không có con cái\N‎nên chỉ có hai bọn tôi
Dialogue: 0,0:15:57.21,0:15:59.88,Default,,0,0,0,,‎mỗi ngày đều lặp đi lặp lại\N‎những chuyện giống nhau.
Dialogue: 0,0:16:01.33,0:16:03.12,Default,,0,0,0,,‎- Nói xem nào, ông chủ.\N‎- Sao?
Dialogue: 0,0:16:04.00,0:16:06.63,Default,,0,0,0,,‎Người phụ nữ tên Sayoko là người thế nào?
Dialogue: 0,0:16:07.25,0:16:08.67,Default,,0,0,0,,‎Ông gặp rồi nhỉ?
Dialogue: 0,0:16:09.92,0:16:10.75,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:16:12.79,0:16:16.58,Default,,0,0,0,,‎Có xinh đẹp đến nỗi đàn ông nào\N‎cũng muốn cô ta không?
Dialogue: 0,0:16:18.88,0:16:20.34,Default,,0,0,0,,‎Không rõ nữa.
Dialogue: 0,0:16:23.71,0:16:25.00,Default,,0,0,0,,‎Mai cô ta sẽ đến.
Dialogue: 0,0:16:25.79,0:16:26.62,Default,,0,0,0,,‎Cửa tiệm.
Dialogue: 0,0:16:27.38,0:16:28.21,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:16:31.17,0:16:32.88,Default,,0,0,0,,‎Tôi không biết sẽ thấy sao nữa.
Dialogue: 0,0:16:52.92,0:16:53.88,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:16:54.79,0:16:57.21,Default,,0,0,0,,‎Hôm qua tôi có gọi đặt lịch.
Dialogue: 0,0:16:58.42,0:17:00.09,Default,,0,0,0,,‎Tôi xin lỗi,
Dialogue: 0,0:17:00.17,0:17:02.55,Default,,0,0,0,,‎chồng tôi ra ngoài có việc gấp.
Dialogue: 0,0:17:05.13,0:17:06.05,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:17:07.92,0:17:08.75,Default,,0,0,0,,‎Vậy...
Dialogue: 0,0:17:09.42,0:17:10.92,Default,,0,0,0,,‎cô làm thay được không?
Dialogue: 0,0:17:12.46,0:17:13.88,Default,,0,0,0,,‎Tôi á? Cô chắc chứ?
Dialogue: 0,0:17:15.04,0:17:17.54,Default,,0,0,0,,‎Vâng. Cô cạo được chứ nhỉ?
Dialogue: 0,0:17:20.96,0:17:21.79,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:18:24.08,0:18:25.62,Default,,0,0,0,,‎Cô làm cũng rất tốt.
Dialogue: 0,0:18:26.46,0:18:30.17,Default,,0,0,0,,‎- Cảm ơn.\N‎- Tôi sẽ lại đến.
Dialogue: 0,0:18:31.79,0:18:32.83,Default,,0,0,0,,‎Bọn tôi mở...
Dialogue: 0,0:18:34.00,0:18:36.25,Default,,0,0,0,,‎cửa tiệm này mười năm rồi.
Dialogue: 0,0:18:37.58,0:18:38.83,Default,,0,0,0,,‎Đó là giấc mơ của bọn tôi...
Dialogue: 0,0:18:39.46,0:18:42.79,Default,,0,0,0,,‎được mở tiệm của riêng mình dù nó hơi nhỏ.
Dialogue: 0,0:18:43.88,0:18:46.21,Default,,0,0,0,,‎- Vậy sao?\N‎- Vì vậy...
Dialogue: 0,0:18:49.46,0:18:51.09,Default,,0,0,0,,‎xin cô đừng tới đây nữa.
Dialogue: 0,0:18:53.21,0:18:54.17,Default,,0,0,0,,‎Xin cô.
Dialogue: 0,0:18:55.58,0:18:57.41,Default,,0,0,0,,‎Chồng tôi cũng gửi lời xin lỗi.
Dialogue: 0,0:19:08.46,0:19:09.46,Default,,0,0,0,,‎Được rồi.
Dialogue: 0,0:19:10.38,0:19:11.96,Default,,0,0,0,,‎Gửi lời chào của tôi đến anh ta.
Dialogue: 0,0:19:32.00,0:19:32.88,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:19:37.42,0:19:38.46,Default,,0,0,0,,‎Người phụ nữ đó...
Dialogue: 0,0:19:39.75,0:19:42.92,Default,,0,0,0,,‎biết tôi đã biết mọi chuyện.
Dialogue: 0,0:19:45.29,0:19:47.92,Default,,0,0,0,,‎Nhưng cô ta ngủ gật trên ghế.
Dialogue: 0,0:19:50.67,0:19:54.00,Default,,0,0,0,,‎Tôi sợ tay mình sẽ chuyển động theo ý nó.
Dialogue: 0,0:19:55.50,0:19:59.21,Default,,0,0,0,,‎Tôi rất vui vì cô có thể nói ra.
Dialogue: 0,0:20:02.17,0:20:03.30,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:20:11.92,0:20:15.00,Default,,0,0,0,,‎Anh lên tàu để quay về Nagano...
Dialogue: 0,0:20:17.00,0:20:18.96,Default,,0,0,0,,‎nhưng nửa đường thì quay lại.
Dialogue: 0,0:20:23.04,0:20:24.21,Default,,0,0,0,,‎Anh thật ích kỷ.
Dialogue: 0,0:20:26.25,0:20:27.13,Default,,0,0,0,,‎Anh xin lỗi.
Dialogue: 0,0:20:33.42,0:20:35.46,Default,,0,0,0,,‎Thử ăn nếu cô muốn.
Dialogue: 0,0:20:49.46,0:20:52.96,Default,,0,0,0,,‎Cá hồi và nấm\N‎là hai món rất ngon, nhưng...
Dialogue: 0,0:20:53.83,0:20:54.91,Default,,0,0,0,,‎tôi nghĩ...
Dialogue: 0,0:20:56.08,0:20:58.46,Default,,0,0,0,,‎chúng ngon nhất khi nấu chung với nhau.
Dialogue: 0,0:21:10.04,0:21:10.87,Default,,0,0,0,,‎Thôi nào.
Dialogue: 0,0:21:15.21,0:21:16.84,Default,,0,0,0,,‎Ăn thôi kẻo nguội.
Dialogue: 0,0:21:27.17,0:21:28.38,Default,,0,0,0,,‎Lần sau không lừa dối nữa nhé.
Dialogue: 0,0:21:36.88,0:21:37.92,Default,,0,0,0,,‎Ăn thôi nào.
Dialogue: 0,0:22:05.54,0:22:09.04,Default,,0,0,0,,‎Cắt một miếng lớn giấy bạc\N‎và quấn chặt các nguyên liệu.
Dialogue: 0,0:22:09.13,0:22:11.34,Default,,0,0,0,,‎Mùi thơm của bơ sẽ ngấm vào món ăn
Dialogue: 0,0:22:11.92,0:22:14.55,Default,,0,0,0,,‎mà không làm mất đi\N‎hương vị của nấm và cá hồi.
Dialogue: 0,0:22:24.71,0:22:26.13,Default,,0,0,0,,‎Ông chủ...
Dialogue: 0,0:22:26.21,0:22:29.79,Default,,0,0,0,,‎Ông biết tiệm hớt tóc nào được không?
Dialogue: 0,0:22:30.67,0:22:34.50,Default,,0,0,0,,‎Đừng nói vì tiệm gần đây nhất\N‎đã ngăn không cho cô ấy quay lại.
Dialogue: 0,0:22:35.33,0:22:37.54,Default,,0,0,0,,‎Tôi nghĩ chắc anh ta\N‎cũng giỏi chuyện giường chiếu.
Dialogue: 0,0:22:40.17,0:22:41.63,Default,,0,0,0,,‎Suy cho cùng,\N‎anh ta phải làm việc bằng tay mà.
Dialogue: 0,0:22:42.79,0:22:44.17,Default,,0,0,0,,‎Chuyện gì vui thế chứ?
Dialogue: 0,0:22:45.96,0:22:46.96,Default,,0,0,0,,‎Tôi nói chuyện với anh một chút nhé?
Dialogue: 0,0:22:52.50,0:22:53.50,Default,,0,0,0,,‎Gì thế?
Dialogue: 0,0:23:01.50,0:23:04.38,Default,,0,0,0,,‎Hôm nay đừng vào đó.\N‎Hãy đến chỗ khác thôi.
Dialogue: 0,0:24:22.00,0:24:24.83,Default,,0,0,0,,‎ĐÂY LÀ CÂU CHUYỆN HƯ CẤU
Dialogue: 0,0:24:24.92,0:24:26.92,Default,,0,0,0,,‎Biên dịch: Hiền Phạm
