Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:04.54,0:01:08.79,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã ra về,{\i0}
Dialogue: 0,0:01:09.46,0:01:11.13,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:28.67,0:01:32.84,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:33.54,0:01:36.58,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:42.17,0:01:44.13,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:44.21,0:01:46.09,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:50.63,0:01:56.71,Default,,0,0,0,,‎CƠM CHIÊN THỊT GÀ
Dialogue: 0,0:01:57.58,0:02:00.83,Default,,0,0,0,,‎ĐANG ĐI TUẦN
Dialogue: 0,0:02:07.71,0:02:10.17,Default,,0,0,0,,‎Vẫn còn đây, chưa bán à?
Dialogue: 0,0:02:11.13,0:02:15.71,Default,,0,0,0,,‎Tôi không quan tâm có bán hay không.\N‎Giờ tôi muốn nó ở đó.
Dialogue: 0,0:02:16.50,0:02:17.75,Default,,0,0,0,,‎Ông thấy gắn bó với nó.
Dialogue: 0,0:02:18.58,0:02:20.66,Default,,0,0,0,,‎Phải, tôi biết nó chỉ là đồ bỏ đi.
Dialogue: 0,0:02:22.25,0:02:23.42,Default,,0,0,0,,‎Sắp đến giờ rồi.
Dialogue: 0,0:02:23.50,0:02:25.33,Default,,0,0,0,,‎- Cảm ơn ông chủ.\N‎- Vâng.
Dialogue: 0,0:02:31.92,0:02:32.75,Default,,0,0,0,,‎Của ông đây.
Dialogue: 0,0:02:32.83,0:02:34.00,Default,,0,0,0,,‎Đủ tiền rồi.
Dialogue: 0,0:02:34.08,0:02:35.04,Default,,0,0,0,,‎Đây là gì thế?
Dialogue: 0,0:02:35.58,0:02:36.41,Default,,0,0,0,,‎Cái này à?
Dialogue: 0,0:02:41.17,0:02:43.46,Default,,0,0,0,,‎Giống vòng quay ngựa gỗ.
Dialogue: 0,0:02:44.21,0:02:46.13,Default,,0,0,0,,‎Nhưng nó cô độc một mình.
Dialogue: 0,0:02:46.21,0:02:47.84,Default,,0,0,0,,‎Cái này cũng không bán.
Dialogue: 0,0:02:47.92,0:02:50.59,Default,,0,0,0,,‎Nó cứ đi tới đi lui cùng một vị trí.
Dialogue: 0,0:02:50.67,0:02:52.30,Default,,0,0,0,,‎Như cuộc sống của ta vậy.
Dialogue: 0,0:02:53.08,0:02:56.46,Default,,0,0,0,,‎Hãy nghĩ đến chuyện đó sau.\N‎Giờ quay lại làm việc thôi.
Dialogue: 0,0:02:56.54,0:02:58.33,Default,,0,0,0,,‎Cô nói đúng. Tạm biệt ông chủ.
Dialogue: 0,0:02:58.42,0:02:59.59,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:03:02.38,0:03:05.51,Default,,0,0,0,,‎Tôi xác nhận chiếc ví bị trộm ở trong túi.
Dialogue: 0,0:03:06.38,0:03:09.46,Default,,0,0,0,,‎Vâng, tôi sẽ đưa anh ta về trụ sở.
Dialogue: 0,0:03:10.83,0:03:13.04,Default,,0,0,0,,‎Rất xin lỗi đã làm phiền mọi người.
Dialogue: 0,0:03:14.50,0:03:17.17,Default,,0,0,0,,‎Ăn trộm à? Người đàn ông này trộm gì thế?
Dialogue: 0,0:03:18.25,0:03:21.63,Default,,0,0,0,,‎Anh ta nhiều lần trộm túi xách\N‎ở rạp phim lúc nửa đêm.
Dialogue: 0,0:03:21.71,0:03:23.09,Default,,0,0,0,,‎Kẻ thường xuyên phạm tội.
Dialogue: 0,0:03:23.17,0:03:24.46,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:03:24.54,0:03:26.83,Default,,0,0,0,,‎Vì rạp phim rất tối.
Dialogue: 0,0:03:27.42,0:03:31.05,Default,,0,0,0,,‎Thỉnh thoảng vì quá chú tâm\N‎vào phim nên tôi quên trộm túi.
Dialogue: 0,0:03:31.13,0:03:32.46,Default,,0,0,0,,‎Chẳng hạn, gần đây...
Dialogue: 0,0:03:32.54,0:03:34.87,Default,,0,0,0,,‎Tôi sẽ nghe anh bình luận về phim ở đồn.
Dialogue: 0,0:03:34.96,0:03:35.79,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:03:36.79,0:03:41.50,Default,,0,0,0,,‎Cảm ơn bà. Sau này,\N‎có thể cần hỏi bà thêm vài câu.
Dialogue: 0,0:03:41.58,0:03:42.71,Default,,0,0,0,,‎Được.
Dialogue: 0,0:03:49.25,0:03:51.63,Default,,0,0,0,,‎Tôi có thể gọi bất kỳ món nào ở đây à?
Dialogue: 0,0:03:52.88,0:03:54.38,Default,,0,0,0,,‎Nếu có đủ nguyên liệu.
Dialogue: 0,0:03:55.33,0:03:56.54,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:03:57.50,0:04:00.63,Default,,0,0,0,,‎Có vẻ như khách hàng có nhiều lựa chọn,
Dialogue: 0,0:04:00.71,0:04:03.09,Default,,0,0,0,,‎nhưng quán ăn là người quyết định món.
Dialogue: 0,0:04:04.00,0:04:05.63,Default,,0,0,0,,‎Quả là một chiến lược thú vị!
Dialogue: 0,0:04:05.71,0:04:06.84,Default,,0,0,0,,‎Chiến lược gì vậy?
Dialogue: 0,0:04:06.92,0:04:08.42,Default,,0,0,0,,‎Không biết.
Dialogue: 0,0:04:09.42,0:04:11.21,Default,,0,0,0,,‎Ông làm cơm gà được không?
Dialogue: 0,0:04:11.29,0:04:12.29,Default,,0,0,0,,‎Được.
Dialogue: 0,0:04:13.04,0:04:13.96,Default,,0,0,0,,‎Tất nhiên rồi.
Dialogue: 0,0:04:14.04,0:04:15.21,Default,,0,0,0,,‎Một chai bia nữa.
Dialogue: 0,0:04:15.29,0:04:16.29,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:39.58,0:04:40.83,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:04:43.33,0:04:44.41,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:04:49.67,0:04:50.67,Default,,0,0,0,,‎Thế nào?
Dialogue: 0,0:04:54.00,0:04:55.13,Default,,0,0,0,,‎Ngon lắm!
Dialogue: 0,0:04:55.79,0:04:57.96,Default,,0,0,0,,‎Tên tôi là Akai.
Dialogue: 0,0:04:58.63,0:05:00.88,Default,,0,0,0,,‎Thế nên anh mới mặc màu đỏ à?
Dialogue: 0,0:05:01.50,0:05:05.33,Default,,0,0,0,,‎Thật buồn cười.\N‎Anh còn gọi cả món có màu đỏ nữa.
Dialogue: 0,0:05:06.21,0:05:10.09,Default,,0,0,0,,‎Màu đỏ tiếp thêm sức mạnh.\N‎Có người mặc đồ lót màu đỏ đấy.
Dialogue: 0,0:05:16.88,0:05:19.51,Default,,0,0,0,,‎Anh không thích đậu à?
Dialogue: 0,0:05:20.54,0:05:21.71,Default,,0,0,0,,‎Lúc còn nhỏ tôi không thích.
Dialogue: 0,0:05:22.29,0:05:23.62,Default,,0,0,0,,‎Nhưng giờ...
Dialogue: 0,0:05:27.63,0:05:31.30,Default,,0,0,0,,‎Thời buổi này đâu có nhà hàng nào\N‎phục vụ món cơm gà kiểu xưa này.
Dialogue: 0,0:05:35.04,0:05:36.71,Default,,0,0,0,,{\i1}‎Kể từ đó,{\i0}
Dialogue: 0,0:05:36.79,0:05:39.04,Default,,0,0,0,,{\i1}‎dường như anh ta thích cơm gà tôi nấu,{\i0}
Dialogue: 0,0:05:39.13,0:05:41.17,Default,,0,0,0,,{\i1}‎nên thỉnh thoảng có ghé đến.{\i0}
Dialogue: 0,0:05:46.50,0:05:48.92,Default,,0,0,0,,‎Ông Momi, đây là...
Dialogue: 0,0:05:50.21,0:05:52.29,Default,,0,0,0,,‎Chính là Shinichiro Akai.
Dialogue: 0,0:05:52.38,0:05:53.96,Default,,0,0,0,,‎Anh ta nổi tiếng vậy à?
Dialogue: 0,0:05:54.04,0:05:56.46,Default,,0,0,0,,‎Nhà thiết kế game rất nổi tiếng đấy.
Dialogue: 0,0:05:57.17,0:05:59.00,Default,,0,0,0,,‎Chỉ là video game, nhỉ?
Dialogue: 0,0:06:01.79,0:06:04.54,Default,,0,0,0,,‎Game anh ta thiết kế có tên {\i1}‎Door to Door,{\i0}
Dialogue: 0,0:06:05.25,0:06:09.21,Default,,0,0,0,,‎hay còn gọi là loạt game {\i1}‎D to D,{\i0}
Dialogue: 0,0:06:09.88,0:06:14.88,Default,,0,0,0,,‎rất phổ biến và nổi danh khắp thế giới.
Dialogue: 0,0:06:16.04,0:06:17.50,Default,,0,0,0,,‎Ông là ai?
Dialogue: 0,0:06:17.58,0:06:21.25,Default,,0,0,0,,‎Ông Momi là sư phụ chơi game của tôi.
Dialogue: 0,0:06:21.33,0:06:24.37,Default,,0,0,0,,‎Sư phụ là người chỉ dạy\N‎không phải chủ quán ăn đâu!
Dialogue: 0,0:06:25.38,0:06:26.96,Default,,0,0,0,,‎Chai nữa của ông đây.
Dialogue: 0,0:06:27.04,0:06:28.33,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:06:28.88,0:06:31.01,Default,,0,0,0,,‎Sao anh ta để lại danh thiếp thế?
Dialogue: 0,0:06:32.08,0:06:34.83,Default,,0,0,0,,‎Anh ta bảo anh ta được mời lên tivi.
Dialogue: 0,0:06:35.58,0:06:39.08,Default,,0,0,0,,‎Họ sẽ làm phim tài liệu về anh ta.
Dialogue: 0,0:06:39.17,0:06:43.17,Default,,0,0,0,,‎Nên xin tôi quay ở đây.
Dialogue: 0,0:06:43.25,0:06:46.88,Default,,0,0,0,,‎Sao? Thật tuyệt! Nhớ đồng ý nhé!
Dialogue: 0,0:06:49.79,0:06:53.92,Default,,0,0,0,,‎Dù sao thì, tôi nghĩ tốt hơn\N‎anh ta đừng mặc com-lê đỏ kia nữa.
Dialogue: 0,0:06:54.00,0:06:55.83,Default,,0,0,0,,‎Cho dù tên anh ta là Akai.
Dialogue: 0,0:06:57.33,0:07:03.21,Default,,0,0,0,,‎Sư phụ, theo tôi, người nghĩ ra\N‎những trò đùa ngớ ngẩn như thế
Dialogue: 0,0:07:03.29,0:07:05.50,Default,,0,0,0,,‎cần một quyển sách hướng dẫn cách sống.
Dialogue: 0,0:07:07.29,0:07:11.12,Default,,0,0,0,,‎Cuộc sống đâu phải trò chơi.\N‎Không làm lại được.
Dialogue: 0,0:07:12.88,0:07:16.92,Default,,0,0,0,,‎Ông Momi, ông thật sâu sắc.
Dialogue: 0,0:07:19.29,0:07:21.50,Default,,0,0,0,,‎Ta sẽ bố trí lồng đèn giấy và...
Dialogue: 0,0:07:21.58,0:07:26.08,Default,,0,0,0,,{\i1}‎Họ bắt đầu quay{\i0}\N{\i1}‎phim tài liệu ở đây như vậy đấy.{\i0}
Dialogue: 0,0:07:27.33,0:07:28.50,Default,,0,0,0,,‎Ông chủ.
Dialogue: 0,0:07:29.04,0:07:30.58,Default,,0,0,0,,‎Xin chuẩn bị nấu ăn.
Dialogue: 0,0:07:31.38,0:07:32.46,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:07:32.54,0:07:33.42,Default,,0,0,0,,‎Như thế này?
Dialogue: 0,0:07:33.50,0:07:34.67,Default,,0,0,0,,‎Được rồi.
Dialogue: 0,0:07:35.33,0:07:37.46,Default,,0,0,0,,‎Anh Akai, hãy bắt đầu thôi.
Dialogue: 0,0:07:38.04,0:07:39.04,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:07:40.21,0:07:41.67,Default,,0,0,0,,‎Chuẩn bị...
Dialogue: 0,0:07:41.75,0:07:43.46,Default,,0,0,0,,‎Ba, hai...
Dialogue: 0,0:07:47.33,0:07:48.75,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:07:48.83,0:07:52.50,Default,,0,0,0,,‎Tôi làm xong phần điều chỉnh\N‎mà anh bảo hôm qua rồi.
Dialogue: 0,0:07:52.58,0:07:54.62,Default,,0,0,0,,‎Nhanh thật. Giờ tôi xem được chứ?
Dialogue: 0,0:07:54.71,0:07:55.71,Default,,0,0,0,,‎Dĩ nhiên rồi.
Dialogue: 0,0:07:56.25,0:07:58.96,Default,,0,0,0,,‎Tôi hài lòng với chuyển động\N‎ngón tay nhưng phần cổ thì không.
Dialogue: 0,0:07:59.04,0:08:00.50,Default,,0,0,0,,‎Phần cổ rất quan trọng.
Dialogue: 0,0:08:00.58,0:08:03.08,Default,,0,0,0,,‎Sẽ không đủ mạnh\N‎nếu không di chuyển như vậy.
Dialogue: 0,0:08:03.17,0:08:05.80,Default,,0,0,0,,{\i1}‎Sẽ không đủ mạnh{\i0}\N{\i1}‎nếu không di chuyển như vậy.{\i0}
Dialogue: 0,0:08:05.88,0:08:10.05,Default,,0,0,0,,{\i1}‎Lúc học trung học,{\i0}\N{\i1}‎Akai bắt đầu mày mò video game.{\i0}
Dialogue: 0,0:08:10.13,0:08:12.55,Default,,0,0,0,,{\i1}‎Anh ta nói đó là biện pháp{\i0}\N{\i1}‎giúp trốn chạy thực tế.{\i0}
Dialogue: 0,0:08:12.63,0:08:15.21,Default,,0,0,0,,{\i1}‎Chồng tôi từng là chủ quán bar.{\i0}
Dialogue: 0,0:08:15.29,0:08:17.75,Default,,0,0,0,,‎Nhưng đã qua đời năm năm trước.
Dialogue: 0,0:08:17.83,0:08:21.00,Default,,0,0,0,,‎Tôi không có con\N‎và miễn là không thuê người,
Dialogue: 0,0:08:21.08,0:08:23.12,Default,,0,0,0,,‎tôi khá thích làm việc tại đây.
Dialogue: 0,0:08:23.21,0:08:24.25,Default,,0,0,0,,‎Tôi hiểu.
Dialogue: 0,0:08:24.79,0:08:27.08,Default,,0,0,0,,‎Tôi mở quán\N‎ngay trước khi thời kỳ Showa chấm dứt.
Dialogue: 0,0:08:27.63,0:08:29.51,Default,,0,0,0,,‎- Vậy là hơn 30 năm rồi?\N‎- Vâng.
Dialogue: 0,0:08:29.58,0:08:30.91,Default,,0,0,0,,‎Chúc mừng bà!
Dialogue: 0,0:08:31.00,0:08:32.04,Default,,0,0,0,,‎Cảm ơn nhé!
Dialogue: 0,0:08:32.13,0:08:33.34,Default,,0,0,0,,‎Đây, tôi mời bà.
Dialogue: 0,0:08:45.71,0:08:46.71,Default,,0,0,0,,{\i1}‎Cảm ơn.{\i0}
Dialogue: 0,0:08:51.71,0:08:54.59,Default,,0,0,0,,{\i1}‎Nghe nói anh có{\i0}\N{\i1}‎ký ức tốt đẹp về món cơm gà.{\i0}
Dialogue: 0,0:08:55.63,0:09:00.05,Default,,0,0,0,,{\i1}‎Khi còn nhỏ, đây là món ăn chính{\i0}\N{\i1}‎khi có dịp, sinh nhật tôi chẳng hạn.{\i0}
Dialogue: 0,0:09:01.17,0:09:03.71,Default,,0,0,0,,{\i1}‎Akai lớn lên trong trại mồ côi.{\i0}
Dialogue: 0,0:09:04.25,0:09:07.04,Default,,0,0,0,,{\i1}‎Shinichiro Akai không phải{\i0}\N{\i1}‎tên thật của anh ấy.{\i0}
Dialogue: 0,0:09:07.13,0:09:10.01,Default,,0,0,0,,{\i1}‎Giám đốc trại mồ côi{\i0}\N{\i1}‎đã đặt tên này cho anh.{\i0}
Dialogue: 0,0:09:10.58,0:09:13.12,Default,,0,0,0,,{\i1}‎Bức ảnh này được chụp{\i0}\N{\i1}‎sau khi anh được mang đến...{\i0}
Dialogue: 0,0:09:13.21,0:09:15.63,Default,,0,0,0,,‎- Câu chuyện hôm nay khá buồn nhỉ?\N‎- Phải.
Dialogue: 0,0:09:17.21,0:09:20.34,Default,,0,0,0,,‎Mấy chuyện thế này ở đâu chẳng có.
Dialogue: 0,0:09:22.00,0:09:24.46,Default,,0,0,0,,{\i1}‎Tôi thấy thật khó{\i0}\N{\i1}‎vì không thay đổi được quá khứ.{\i0}
Dialogue: 0,0:09:25.50,0:09:29.58,Default,,0,0,0,,{\i1}‎Thế nên tôi quyết định{\i0}\N{\i1}‎viết đè lên cuộc sống này{\i0}
Dialogue: 0,0:09:31.04,0:09:35.17,Default,,0,0,0,,{\i1}‎- và ngừng bận tâm tôi là ai.{\i0}\N‎- Bà chủ.
Dialogue: 0,0:09:35.71,0:09:36.84,Default,,0,0,0,,‎- Bà chủ.\N‎- Sao?
Dialogue: 0,0:09:37.67,0:09:39.50,Default,,0,0,0,,‎Cho tôi whiskey pha nước nhé?
Dialogue: 0,0:09:39.58,0:09:40.50,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:09:44.58,0:09:45.75,Default,,0,0,0,,‎Ta là mẹ con...
Dialogue: 0,0:09:47.25,0:09:49.25,Default,,0,0,0,,‎Ta đã rất muốn gặp con, Shin.
Dialogue: 0,0:09:50.79,0:09:53.96,Default,,0,0,0,,‎Trong chương trình, tôi có nói
Dialogue: 0,0:09:55.04,0:09:57.83,Default,,0,0,0,,‎tôi nhớ mẹ tôi gọi tôi như thế.
Dialogue: 0,0:09:58.46,0:10:00.25,Default,,0,0,0,,‎Nên bà mới gọi tôi như thế?
Dialogue: 0,0:10:00.33,0:10:02.08,Default,,0,0,0,,‎Đừng ngốc nghếch.
Dialogue: 0,0:10:02.63,0:10:04.96,Default,,0,0,0,,‎Con là Shin của ta.
Dialogue: 0,0:10:06.13,0:10:07.80,Default,,0,0,0,,‎Hãy kiểm tra ADN nhé?
Dialogue: 0,0:10:09.50,0:10:12.42,Default,,0,0,0,,‎Con là con trai của bà vợ trước,
Dialogue: 0,0:10:13.04,0:10:15.71,Default,,0,0,0,,‎nên ta không phải mẹ ruột.
Dialogue: 0,0:10:19.04,0:10:21.83,Default,,0,0,0,,‎Nhiều người đến và tuyên bố\N‎họ là mẹ của anh ta?
Dialogue: 0,0:10:21.92,0:10:24.05,Default,,0,0,0,,‎Sau khi xem bộ phim tài liệu về Akai?
Dialogue: 0,0:10:24.88,0:10:27.71,Default,,0,0,0,,‎Anh ta có nói về chuyện đó, vẫn cười,
Dialogue: 0,0:10:27.79,0:10:30.58,Default,,0,0,0,,‎nhưng đã lâu chưa đến đây.
Dialogue: 0,0:10:31.83,0:10:33.71,Default,,0,0,0,,‎Hẳn anh ta rất thất vọng
Dialogue: 0,0:10:33.79,0:10:36.96,Default,,0,0,0,,‎vì anh ta biết\N‎họ chỉ muốn tiền của anh ta thôi.
Dialogue: 0,0:10:37.50,0:10:39.63,Default,,0,0,0,,‎Ông chủ cũng có vẻ thất vọng.
Dialogue: 0,0:10:40.29,0:10:41.54,Default,,0,0,0,,‎Tại sao?
Dialogue: 0,0:10:41.63,0:10:43.71,Default,,0,0,0,,‎Gì? Chà...
Dialogue: 0,0:10:44.33,0:10:46.54,Default,,0,0,0,,‎Ông ấy lo lắng chuyện hết nguyên liệu,
Dialogue: 0,0:10:46.63,0:10:49.88,Default,,0,0,0,,‎nghĩ nhiều người sẽ chạy đến đây\N‎sau khi xem chương trình đó.
Dialogue: 0,0:10:50.75,0:10:52.08,Default,,0,0,0,,‎Nhưng thực tế thì không.
Dialogue: 0,0:10:53.25,0:10:57.13,Default,,0,0,0,,‎Ông chủ! Chúng tôi luôn ủng hộ ông mà!
Dialogue: 0,0:10:58.00,0:10:59.67,Default,,0,0,0,,‎Hóa ra chẳng có gì phải lo.
Dialogue: 0,0:11:00.25,0:11:02.25,Default,,0,0,0,,‎Cuối cùng lại là chuyện tốt nhỉ?
Dialogue: 0,0:11:05.13,0:11:07.17,Default,,0,0,0,,‎- Ông ấy nghĩ có nhiều khách đến?\N‎- Dĩ nhiên.
Dialogue: 0,0:11:07.25,0:11:09.58,Default,,0,0,0,,‎Nếu không sẽ không nói "cuối cùng".
Dialogue: 0,0:11:15.29,0:11:16.46,Default,,0,0,0,,‎Chào quý khách.
Dialogue: 0,0:11:23.08,0:11:26.66,Default,,0,0,0,,‎Hôm kia tôi có xem chương trình...
Dialogue: 0,0:11:26.75,0:11:27.58,Default,,0,0,0,,‎Tuyệt!
Dialogue: 0,0:11:28.13,0:11:30.71,Default,,0,0,0,,‎Ông chủ, thấy chưa? Nó hút khách đến đấy!
Dialogue: 0,0:11:31.83,0:11:32.66,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:11:35.29,0:11:37.37,Default,,0,0,0,,‎Bà có chơi video game không?
Dialogue: 0,0:11:38.25,0:11:41.21,Default,,0,0,0,,‎Không hề. Tôi đến vì món cơm gà.
Dialogue: 0,0:11:43.29,0:11:45.67,Default,,0,0,0,,‎Cho tôi gọi cơm gà nhé?
Dialogue: 0,0:11:45.75,0:11:47.83,Default,,0,0,0,,‎Trên tivi trông nó rất ngon.
Dialogue: 0,0:11:47.92,0:11:49.17,Default,,0,0,0,,‎Dĩ nhiên rồi.
Dialogue: 0,0:12:00.83,0:12:02.58,Default,,0,0,0,,‎Vậy đây là trò chơi đó?
Dialogue: 0,0:12:03.17,0:12:05.63,Default,,0,0,0,,‎Phải. Cuối cùng đã được bày bán rồi.
Dialogue: 0,0:12:08.79,0:12:09.62,Default,,0,0,0,,‎Trước đây rất lâu,
Dialogue: 0,0:12:10.92,0:12:13.96,Default,,0,0,0,,‎tôi từng hay làm món này.
Dialogue: 0,0:12:15.04,0:12:16.92,Default,,0,0,0,,‎Cho con bà?
Dialogue: 0,0:12:18.00,0:12:18.83,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:12:19.58,0:12:20.41,Default,,0,0,0,,‎Xin lỗi...
Dialogue: 0,0:12:21.54,0:12:24.92,Default,,0,0,0,,‎Người đàn ông được phỏng vấn...\N‎Anh ta có đến chứ?
Dialogue: 0,0:12:26.33,0:12:28.21,Default,,0,0,0,,‎Chắc dạo này anh ta rất bận.
Dialogue: 0,0:12:28.92,0:12:30.80,Default,,0,0,0,,‎Gần đây không thấy đến.
Dialogue: 0,0:12:32.46,0:12:33.63,Default,,0,0,0,,‎Tôi hiểu.
Dialogue: 0,0:13:10.38,0:13:12.71,Default,,0,0,0,,‎Giờ tôi sẽ kiểm tra lịch làm việc.
Dialogue: 0,0:13:15.25,0:13:17.38,Default,,0,0,0,,‎Ta không có thì giờ cho chuyện này.
Dialogue: 0,0:13:27.79,0:13:30.75,Default,,0,0,0,,‎Trông anh rất mệt mỏi.
Dialogue: 0,0:13:32.25,0:13:34.13,Default,,0,0,0,,‎Chắc do tuổi tác.
Dialogue: 0,0:13:34.21,0:13:37.00,Default,,0,0,0,,‎Sau khi làm việc xuyên đêm,\N‎tôi thấy mỏi mệt.
Dialogue: 0,0:13:47.92,0:13:49.71,Default,,0,0,0,,‎Bà ấy đến đây sau khi xem chương trình đó
Dialogue: 0,0:13:50.63,0:13:52.71,Default,,0,0,0,,‎vì món gà trông rất ngon.
Dialogue: 0,0:13:53.50,0:13:56.21,Default,,0,0,0,,‎Thế à? Tôi cũng rất thích nó.
Dialogue: 0,0:14:03.96,0:14:05.09,Default,,0,0,0,,‎Ta rất xin lỗi...
Dialogue: 0,0:14:06.63,0:14:07.51,Default,,0,0,0,,‎Shin.
Dialogue: 0,0:14:23.54,0:14:26.08,Default,,0,0,0,,‎Bố con đã có...
Dialogue: 0,0:14:26.88,0:14:28.09,Default,,0,0,0,,‎vợ...
Dialogue: 0,0:14:29.17,0:14:30.75,Default,,0,0,0,,‎và một đứa con.
Dialogue: 0,0:14:32.33,0:14:34.91,Default,,0,0,0,,‎Ông ấy bảo ta có thể sinh
Dialogue: 0,0:14:35.79,0:14:37.79,Default,,0,0,0,,‎nhưng không thể thừa nhận con.
Dialogue: 0,0:14:39.42,0:14:41.92,Default,,0,0,0,,‎Cuối cùng ông ấy rời bỏ ta.
Dialogue: 0,0:14:43.42,0:14:46.34,Default,,0,0,0,,‎Ta đã cố hết sức để nuôi con một mình...
Dialogue: 0,0:14:48.54,0:14:50.71,Default,,0,0,0,,‎Nhưng kiếm việc thật không dễ dàng,
Dialogue: 0,0:14:50.79,0:14:53.83,Default,,0,0,0,,‎và với một cô gái 20 tuổi\N‎thế là quá sức chịu đựng.
Dialogue: 0,0:14:57.04,0:14:58.96,Default,,0,0,0,,‎Ông bà con từ mặt ta.
Dialogue: 0,0:15:00.88,0:15:03.76,Default,,0,0,0,,‎Chẳng có người nào ở bên để nói chuyện.
Dialogue: 0,0:15:05.50,0:15:07.79,Default,,0,0,0,,‎Ta nghĩ đến việc tự sát cùng con.
Dialogue: 0,0:15:07.88,0:15:09.67,Default,,0,0,0,,‎Thật ích kỷ.
Dialogue: 0,0:15:12.96,0:15:14.42,Default,,0,0,0,,‎Xin bà đừng hiểu lầm.
Dialogue: 0,0:15:15.67,0:15:19.50,Default,,0,0,0,,‎Tôi không nói vậy\N‎vì nghĩ rằng bà là mẹ tôi.
Dialogue: 0,0:15:22.58,0:15:23.83,Default,,0,0,0,,‎Sau đó...
Dialogue: 0,0:15:25.75,0:15:28.46,Default,,0,0,0,,‎ta nghĩ nên vui vẻ trước khi chết...
Dialogue: 0,0:15:31.71,0:15:33.59,Default,,0,0,0,,‎nên đã đến công viên vui chơi.
Dialogue: 0,0:15:36.04,0:15:38.12,Default,,0,0,0,,‎Khi nhìn khuôn mặt vui vẻ của con...
Dialogue: 0,0:15:40.00,0:15:42.25,Default,,0,0,0,,‎ta thấy sợ hãi\N‎khi tước đi mạng sống của con.
Dialogue: 0,0:15:44.54,0:15:46.67,Default,,0,0,0,,‎Con nói, "Con muốn chơi trò đó."
Dialogue: 0,0:15:51.25,0:15:53.04,Default,,0,0,0,,‎Ta để con lại đó rồi bỏ chạy.
Dialogue: 0,0:15:56.96,0:16:00.75,Default,,0,0,0,,‎Con ngồi trên con ngựa\N‎của vòng quay ngựa gỗ.
Dialogue: 0,0:16:03.54,0:16:04.96,Default,,0,0,0,,‎Cuối cùng,
Dialogue: 0,0:16:05.88,0:16:07.67,Default,,0,0,0,,‎bà không thể tự sát được.
Dialogue: 0,0:16:10.08,0:16:11.37,Default,,0,0,0,,‎Thật kinh tởm.
Dialogue: 0,0:16:14.67,0:16:17.71,Default,,0,0,0,,‎Tôi không có mẹ.
Dialogue: 0,0:16:18.92,0:16:22.38,Default,,0,0,0,,‎Cũng không thể gọi\N‎bà ta là mẹ vì bà ta đã bỏ rơi tôi.
Dialogue: 0,0:16:23.33,0:16:24.33,Default,,0,0,0,,‎Con nói đúng.
Dialogue: 0,0:16:25.96,0:16:31.04,Default,,0,0,0,,‎Ta không có quyền\N‎làm mẹ con sau ngần ấy năm.
Dialogue: 0,0:16:55.25,0:16:58.88,Default,,0,0,0,,‎Màu đỏ rất hợp với con,
Dialogue: 0,0:17:00.67,0:17:01.96,Default,,0,0,0,,‎Shinichi.
Dialogue: 0,0:17:18.75,0:17:22.42,Default,,0,0,0,,‎Tôi có thể sống mà đâu cần bố mẹ...
Dialogue: 0,0:17:23.79,0:17:25.67,Default,,0,0,0,,‎Tôi đã tin vào điều đó.
Dialogue: 0,0:17:30.63,0:17:32.34,Default,,0,0,0,,‎Sao giờ phải thay đổi chứ?
Dialogue: 0,0:17:43.58,0:17:45.12,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:17:46.92,0:17:47.96,Default,,0,0,0,,‎Đây là...
Dialogue: 0,0:17:49.58,0:17:52.71,Default,,0,0,0,,‎"Nó không thích ăn đậu,
Dialogue: 0,0:17:53.92,0:17:57.09,Default,,0,0,0,,‎nhưng nó đã bắt đầu ăn\N‎khi tôi xếp đậu như vậy."
Dialogue: 0,0:17:58.17,0:17:59.71,Default,,0,0,0,,‎Mẹ anh đã nói như thế.
Dialogue: 0,0:18:03.17,0:18:04.34,Default,,0,0,0,,‎Người phụ nữ đó...
Dialogue: 0,0:18:06.17,0:18:08.42,Default,,0,0,0,,‎Bà ta gọi tôi là Shinichi.
Dialogue: 0,0:18:08.96,0:18:10.38,Default,,0,0,0,,‎Tên thật của anh à?
Dialogue: 0,0:18:12.00,0:18:12.92,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:18:16.13,0:18:17.34,Default,,0,0,0,,‎Tôi nghe nói...
Dialogue: 0,0:18:20.04,0:18:22.04,Default,,0,0,0,,‎chỉ có một mảnh giấy ghi tên thật của tôi
Dialogue: 0,0:18:23.63,0:18:26.55,Default,,0,0,0,,‎được đặt trong túi áo khi họ tìm thấy tôi.
Dialogue: 0,0:18:28.79,0:18:29.62,Default,,0,0,0,,‎Hơn nữa...
Dialogue: 0,0:18:32.04,0:18:34.87,Default,,0,0,0,,‎đúng là tôi được tìm thấy\N‎tại vòng quay ngựa gỗ...
Dialogue: 0,0:18:37.00,0:18:38.63,Default,,0,0,0,,‎Có ít người biết việc đó.
Dialogue: 0,0:18:43.13,0:18:45.55,Default,,0,0,0,,‎Bà ấy biết mình không có quyền đi gặp anh,
Dialogue: 0,0:18:47.29,0:18:49.17,Default,,0,0,0,,‎nhưng vẫn đến đây gặp anh.
Dialogue: 0,0:18:53.17,0:18:54.59,Default,,0,0,0,,‎Trong hai tuần qua...
Dialogue: 0,0:18:56.25,0:18:57.83,Default,,0,0,0,,‎ngày nào bà ấy cũng đến,
Dialogue: 0,0:19:00.08,0:19:02.37,Default,,0,0,0,,‎nghĩ rằng anh sẽ sớm xuất hiện.
Dialogue: 0,0:19:03.17,0:19:06.96,Default,,0,0,0,,‎Bà ấy đợi chờ anh và cảm thấy sợ hãi.
Dialogue: 0,0:19:48.92,0:19:50.25,Default,,0,0,0,,‎Lúc được người ta cứu,
Dialogue: 0,0:19:51.13,0:19:53.05,Default,,0,0,0,,‎tôi mặc một cái áo khoác đỏ.
Dialogue: 0,0:19:55.00,0:19:56.04,Default,,0,0,0,,‎Tôi cứ mặc
Dialogue: 0,0:19:57.17,0:19:58.55,Default,,0,0,0,,‎cái áo khoác đỏ đó...
Dialogue: 0,0:20:00.88,0:20:02.30,Default,,0,0,0,,‎cho đến khi nó xác xơ.
Dialogue: 0,0:20:07.46,0:20:09.17,Default,,0,0,0,,‎Vì tôi muốn bà ấy tìm ra tôi.
Dialogue: 0,0:20:15.33,0:20:19.21,Default,,0,0,0,,‎Tôi đã muốn mẹ tìm ra tôi...
Dialogue: 0,0:20:20.79,0:20:22.87,Default,,0,0,0,,‎trong khoảng thời gian rất lâu.
Dialogue: 0,0:20:36.58,0:20:38.54,Default,,0,0,0,,{\i1}‎Một thời gian sau,{\i0}
Dialogue: 0,0:20:38.63,0:20:41.76,Default,,0,0,0,,{\i1}‎trò chơi mới của Akai được phát hành.{\i0}
Dialogue: 0,0:20:47.88,0:20:48.92,Default,,0,0,0,,‎Hẹn gặp lại.
Dialogue: 0,0:20:53.46,0:20:54.67,Default,,0,0,0,,‎Ngon thật đấy.
Dialogue: 0,0:20:58.21,0:20:59.42,Default,,0,0,0,,‎Ông Momi,
Dialogue: 0,0:21:00.54,0:21:02.25,Default,,0,0,0,,‎trông ông rất mệt mỏi.
Dialogue: 0,0:21:03.04,0:21:05.71,Default,,0,0,0,,‎Cậu cũng vậy. Không ngủ đủ giấc nhỉ?
Dialogue: 0,0:21:06.83,0:21:12.29,Default,,0,0,0,,{\i1}‎Họ quá mê game nên đêm nào cũng thiếu ngủ.{\i0}
Dialogue: 0,0:21:14.92,0:21:16.84,Default,,0,0,0,,‎Nó chiếm hết thời gian của tôi.
Dialogue: 0,0:21:18.46,0:21:21.17,Default,,0,0,0,,‎Thay vì giận dữ vì bị ngốn hết thời gian,
Dialogue: 0,0:21:21.25,0:21:23.00,Default,,0,0,0,,‎tôi muốn cảm ơn nó.
Dialogue: 0,0:21:23.83,0:21:27.04,Default,,0,0,0,,‎Nói đến sự mâu thuẫn điên rồ.
Dialogue: 0,0:21:28.38,0:21:30.42,Default,,0,0,0,,‎Tôi muốn kể với anh ta cảm giác này.
Dialogue: 0,0:21:32.79,0:21:34.00,Default,,0,0,0,,‎Ông nghĩ anh Akai sẽ đến đây chứ?
Dialogue: 0,0:21:35.04,0:21:36.17,Default,,0,0,0,,‎Biết đâu đấy.
Dialogue: 0,0:21:36.88,0:21:41.26,Default,,0,0,0,,‎Có vẻ anh ta đã tìm được\N‎nơi khác phục vụ món cơm gà ngon hơn rồi.
Dialogue: 0,0:21:54.92,0:21:56.00,Default,,0,0,0,,‎Chào quý khách.
Dialogue: 0,0:22:12.63,0:22:13.80,Default,,0,0,0,,‎Thực đơn đây.
Dialogue: 0,0:22:16.42,0:22:19.75,Default,,0,0,0,,‎Cho tôi gọi bia và cơm gà.
Dialogue: 0,0:22:20.46,0:22:21.54,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:22:28.04,0:22:30.46,Default,,0,0,0,,‎Không sao đâu. Để tôi tự mở.
Dialogue: 0,0:22:32.00,0:22:34.04,Default,,0,0,0,,‎Tôi đói lắm rồi.
Dialogue: 0,0:22:35.75,0:22:36.71,Default,,0,0,0,,‎Được.
Dialogue: 0,0:22:37.46,0:22:39.04,Default,,0,0,0,,‎Xin chờ một lát.
Dialogue: 0,0:23:12.25,0:23:16.17,Default,,0,0,0,,‎TIỆM MỲ
Dialogue: 0,0:23:19.58,0:23:22.16,Default,,0,0,0,,‎Hai mẹ con, sau vài thập kỷ sống xa nhau,
Dialogue: 0,0:23:22.96,0:23:26.34,Default,,0,0,0,,‎cuối cùng gặp lại nhau tại Quán Ăn Đêm.\N‎Ban đầu có chút khúc mắc
Dialogue: 0,0:23:26.88,0:23:28.42,Default,,0,0,0,,‎nhưng nghe nói đã sửa chữa được rồi.
Dialogue: 0,0:23:31.54,0:23:33.92,Default,,0,0,0,,‎Chuyện như thế lại xảy ra ở quán ông ấy.
Dialogue: 0,0:23:36.83,0:23:40.08,Default,,0,0,0,,‎Con người ta có thể đoàn tụ mà.
Dialogue: 0,0:23:42.83,0:23:44.83,Default,,0,0,0,,‎Chuyện đó thỉnh thoảng cũng tốt nhỉ?
Dialogue: 0,0:23:46.88,0:23:47.96,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:25:09.00,0:25:10.83,Default,,0,0,0,,‎ĐÂY LÀ CHUYỆN HƯ CẤU
