Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:05.50,0:01:09.79,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:01:10.38,0:01:12.13,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:29.67,0:01:34.38,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:34.46,0:01:37.75,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:43.00,0:01:44.88,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:44.96,0:01:46.96,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:51.67,0:01:57.71,Default,,0,0,0,,‎TRỨNG CUỘN NGỌT
Dialogue: 0,0:02:06.38,0:02:09.76,Default,,0,0,0,,‎Quả cà tím to như thế\N‎chỉ có thể gọi là "cà tím khổng lồ".
Dialogue: 0,0:02:09.83,0:02:13.25,Default,,0,0,0,,‎Bạn tôi gửi chúng\N‎sau khi cô ấy nghỉ việc và về quê.
Dialogue: 0,0:02:13.33,0:02:14.75,Default,,0,0,0,,‎Ăn chúng thế nào?
Dialogue: 0,0:02:14.83,0:02:18.62,Default,,0,0,0,,‎Ở Takayama, chúng tôi nướng lên\N‎với tương miso ở giữa.
Dialogue: 0,0:02:19.17,0:02:22.05,Default,,0,0,0,,‎Của anh đây. Cá chiên, ít cơm.
Dialogue: 0,0:02:22.58,0:02:25.83,Default,,0,0,0,,‎Ông chủ, nếu có thời gian,\N‎ông nấu chúng được không?
Dialogue: 0,0:02:26.38,0:02:27.38,Default,,0,0,0,,‎Được chứ.
Dialogue: 0,0:02:36.50,0:02:37.67,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:02:39.63,0:02:40.59,Default,,0,0,0,,‎Bia?
Dialogue: 0,0:02:40.67,0:02:41.59,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:02:42.13,0:02:42.96,Default,,0,0,0,,‎Có đúng nơi này không?
Dialogue: 0,0:02:43.04,0:02:44.04,Default,,0,0,0,,‎Tôi nghĩ vậy.
Dialogue: 0,0:02:45.33,0:02:46.96,Default,,0,0,0,,‎Có thấy người đàn ông này ở đây không?
Dialogue: 0,0:02:47.04,0:02:48.92,Default,,0,0,0,,‎Tôi có nên giúp họ không?
Dialogue: 0,0:02:51.17,0:02:53.88,Default,,0,0,0,,{\i1}‎Thấy người đàn ông này ở đây không?{\i0}
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:02:59.04,0:03:01.62,Default,,0,0,0,,{\i1}‎Thấy người đàn ông này ở đây không?{\i0}
Dialogue: 0,0:03:01.71,0:03:02.54,Default,,0,0,0,,‎Này...
Dialogue: 0,0:03:03.38,0:03:04.46,Default,,0,0,0,,‎Thôi bỏ đi. Không sao.
Dialogue: 0,0:03:05.33,0:03:07.04,Default,,0,0,0,,‎Tôi quẹt điện thoại của ông,\N‎ông quẹt của tôi.
Dialogue: 0,0:03:07.13,0:03:08.92,Default,,0,0,0,,‎Thanh toán bằng tiền điện tử, được chứ?
Dialogue: 0,0:03:09.83,0:03:11.75,Default,,0,0,0,,‎Đây là...
Dialogue: 0,0:03:11.83,0:03:13.62,Default,,0,0,0,,‎Chỉ nhận tiền mặt.
Dialogue: 0,0:03:18.25,0:03:19.67,Default,,0,0,0,,‎Xin lỗi đã làm phiền. Tạm biệt.
Dialogue: 0,0:03:21.50,0:03:22.42,Default,,0,0,0,,‎Này...
Dialogue: 0,0:03:27.08,0:03:30.25,Default,,0,0,0,,‎Anh ta nói, "Xin lỗi đã làm phiền.\N‎Giữ tiền thừa".
Dialogue: 0,0:03:30.79,0:03:32.58,Default,,0,0,0,,‎Anh ta đã nói thế. Có lẽ.
Dialogue: 0,0:03:34.29,0:03:37.67,Default,,0,0,0,,‎Có khi nào họ là người sống sót\N‎của mafia Hồng Kông,
Dialogue: 0,0:03:37.75,0:03:40.17,Default,,0,0,0,,‎từng hỗn chiến với băng yakuza địa phương?
Dialogue: 0,0:03:41.04,0:03:43.71,Default,,0,0,0,,‎Có thể. Trông giống lắm.
Dialogue: 0,0:03:46.79,0:03:47.92,Default,,0,0,0,,‎Có mùi nguy hiểm.
Dialogue: 0,0:03:50.08,0:03:51.08,Default,,0,0,0,,‎Chắc chắn rồi.
Dialogue: 0,0:03:52.67,0:03:56.46,Default,,0,0,0,,‎Ném nó với sự hỗ trợ của eo.
Dialogue: 0,0:04:01.75,0:04:03.08,Default,,0,0,0,,‎Có chuyện gì sao?
Dialogue: 0,0:04:05.00,0:04:06.50,Default,,0,0,0,,‎Hả?
Dialogue: 0,0:04:18.92,0:04:20.71,Default,,0,0,0,,‎Kỹ thuật bậc thầy.
Dialogue: 0,0:04:20.79,0:04:21.79,Default,,0,0,0,,‎Anh là thầy của cô ấy?
Dialogue: 0,0:04:22.38,0:04:23.76,Default,,0,0,0,,‎Chỉ là người qua đường.
Dialogue: 0,0:04:24.29,0:04:25.83,Default,,0,0,0,,‎Người qua đường...
Dialogue: 0,0:04:29.50,0:04:30.96,Default,,0,0,0,,‎Chào ông chủ.
Dialogue: 0,0:04:32.29,0:04:36.58,Default,,0,0,0,,‎Người này muốn ăn trứng cuộn.
Dialogue: 0,0:04:41.21,0:04:42.50,Default,,0,0,0,,‎Xin ông đấy.
Dialogue: 0,0:04:44.63,0:04:45.46,Default,,0,0,0,,‎Được thôi.
Dialogue: 0,0:05:03.88,0:05:05.09,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:05:19.38,0:05:21.13,Default,,0,0,0,,‎Chỗ chúng tôi làm hơi ngọt.
Dialogue: 0,0:05:28.83,0:05:33.66,Default,,0,0,0,,‎Gần giống vị bố tôi thường nấu\N‎khi tôi còn nhỏ.
Dialogue: 0,0:05:34.58,0:05:37.58,Default,,0,0,0,,‎Của ông ấy ngọt hơn.
Dialogue: 0,0:05:38.96,0:05:40.04,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:05:40.79,0:05:43.54,Default,,0,0,0,,‎Lần sau tôi sẽ thêm đường.
Dialogue: 0,0:05:52.71,0:05:54.75,Default,,0,0,0,,‎Cảm ơn. Xin tính tiền.
Dialogue: 0,0:05:55.92,0:05:57.25,Default,,0,0,0,,‎Là 400 yên.
Dialogue: 0,0:06:02.54,0:06:04.12,Default,,0,0,0,,‎Tiếng Nhật của anh rất tốt.
Dialogue: 0,0:06:05.25,0:06:07.33,Default,,0,0,0,,‎Trước đây tôi từng học qua.
Dialogue: 0,0:06:07.92,0:06:09.63,Default,,0,0,0,,‎Không phải chuyện của tôi...
Dialogue: 0,0:06:10.38,0:06:12.80,Default,,0,0,0,,‎nhưng có người đến đây tìm anh.
Dialogue: 0,0:06:15.21,0:06:16.67,Default,,0,0,0,,‎Tôi là Lee.
Dialogue: 0,0:06:18.71,0:06:20.88,Default,,0,0,0,,‎Món trứng ông làm rất ngon.
Dialogue: 0,0:06:28.67,0:06:32.09,Default,,0,0,0,,{\i1}‎Sau ngày đó, Lee thường lui tới đây{\i0}
Dialogue: 0,0:06:32.17,0:06:34.63,Default,,0,0,0,,{\i1}‎và gọi món trứng cuộn ngọt.{\i0}
Dialogue: 0,0:06:44.58,0:06:47.12,Default,,0,0,0,,‎Anh rất thích trứng cuộn.
Dialogue: 0,0:06:48.17,0:06:49.25,Default,,0,0,0,,‎Anh thích nó chứ?
Dialogue: 0,0:06:50.67,0:06:51.59,Default,,0,0,0,,‎Vâng, rất ngon.
Dialogue: 0,0:06:53.21,0:06:55.21,Default,,0,0,0,,‎Anh học tiếng Trung ở đâu thế?
Dialogue: 0,0:06:55.92,0:06:58.38,Default,,0,0,0,,‎Năm ngoái tôi bắt đầu\N‎làm tình nguyện viên dạy tiếng Nhật
Dialogue: 0,0:06:58.46,0:07:00.96,Default,,0,0,0,,‎và đổi lại, học tiếng Trung\N‎từ sinh viên của tôi.
Dialogue: 0,0:07:01.04,0:07:03.96,Default,,0,0,0,,‎Tôi thích xem phim lịch sử của họ.
Dialogue: 0,0:07:05.46,0:07:07.63,Default,,0,0,0,,‎Còn ông? Sao ông biết anh ta?
Dialogue: 0,0:07:08.33,0:07:13.71,Default,,0,0,0,,‎Tôi từng gặp anh ta rồi,\N‎nhưng lại không biết anh ta.
Dialogue: 0,0:07:21.92,0:07:22.84,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:07:23.42,0:07:24.30,Default,,0,0,0,,‎Này.
Dialogue: 0,0:07:24.92,0:07:28.05,Default,,0,0,0,,‎Có hai tên mafia đang đi về hướng này.
Dialogue: 0,0:07:28.13,0:07:29.09,Default,,0,0,0,,‎Mafia?
Dialogue: 0,0:07:29.17,0:07:30.50,Default,,0,0,0,,‎Mafia đang đến đây?
Dialogue: 0,0:07:30.58,0:07:32.04,Default,,0,0,0,,‎Im đi, anh kia!
Dialogue: 0,0:07:32.13,0:07:33.96,Default,,0,0,0,,‎Tôi nghĩ chúng làm\N‎công việc bất lương như tôi.
Dialogue: 0,0:07:34.04,0:07:35.87,Default,,0,0,0,,‎Anh nói vậy, nhưng...
Dialogue: 0,0:07:35.96,0:07:38.04,Default,,0,0,0,,‎Anh lên lầu ngay đi.
Dialogue: 0,0:07:38.58,0:07:40.21,Default,,0,0,0,,‎Tôi không liên quan đến mafia.
Dialogue: 0,0:07:40.29,0:07:41.21,Default,,0,0,0,,‎Đừng lo.
Dialogue: 0,0:07:41.29,0:07:44.08,Default,,0,0,0,,‎Bọn tôi không làm ngơ trước người\N‎gặp khó khăn đang ở nước ngoài đâu.
Dialogue: 0,0:07:45.04,0:07:46.21,Default,,0,0,0,,‎Lối này.
Dialogue: 0,0:07:46.79,0:07:47.92,Default,,0,0,0,,‎Đi lối này.
Dialogue: 0,0:07:48.75,0:07:50.83,Default,,0,0,0,,‎Lối này.
Dialogue: 0,0:08:04.92,0:08:09.17,Default,,0,0,0,,{\i1}‎Tập đoàn chúng tôi cần Lee, đại sư huynh.{\i0}
Dialogue: 0,0:08:09.25,0:08:12.13,Default,,0,0,0,,‎"Tập đoàn?"\N‎Vậy hai anh là thành viên của mafia!
Dialogue: 0,0:08:14.67,0:08:16.46,Default,,0,0,0,,{\i1}‎Chúng tôi không phải mafia.{\i0}
Dialogue: 0,0:08:16.54,0:08:19.29,Default,,0,0,0,,{\i1}‎Chúng tôi là người{\i0}\N{\i1}‎làm việc dưới trướng anh ấy.{\i0}
Dialogue: 0,0:08:19.38,0:08:21.38,Default,,0,0,0,,‎"Người làm việc dưới trướng". Phải rồi!
Dialogue: 0,0:08:21.46,0:08:24.59,Default,,0,0,0,,‎Hả? Họ đang đi săn\N‎chính đại sư huynh của mình,
Dialogue: 0,0:08:24.67,0:08:26.80,Default,,0,0,0,,‎đúng là suy đồi đạo đức\N‎về tinh thần nghĩa hiệp mà.
Dialogue: 0,0:08:26.88,0:08:29.01,Default,,0,0,0,,‎Này, tôi không muốn rắc rối ở đây.
Dialogue: 0,0:08:29.08,0:08:32.00,Default,,0,0,0,,‎- Bọn tôi cần đại sư huynh, Lee.\N‎- Bọn tôi biết anh ấy ở đây.
Dialogue: 0,0:08:35.46,0:08:39.46,Default,,0,0,0,,‎Họ không phải mafia đâu.
Dialogue: 0,0:08:40.04,0:08:41.71,Default,,0,0,0,,‎Là nhân viên sản xuất phim của tôi.
Dialogue: 0,0:08:49.63,0:08:52.71,Default,,0,0,0,,‎Xin lỗi đã gây ầm ĩ. Anh ăn chút đi.
Dialogue: 0,0:08:56.71,0:09:00.46,Default,,0,0,0,,{\i1}‎Lee Punfa là đạo diễn phim.{\i0}
Dialogue: 0,0:09:01.04,0:09:06.37,Default,,0,0,0,,{\i1}‎Họ là nhà sản xuất{\i0}\N{\i1}‎cùng nhau thành lập công ty sản xuất phim.{\i0}
Dialogue: 0,0:09:06.92,0:09:11.05,Default,,0,0,0,,‎Chắc tiếng Trung họ gọi nó là "tập đoàn".\N‎Giống với từ ta gọi tập đoàn yakuza.
Dialogue: 0,0:09:11.79,0:09:14.21,Default,,0,0,0,,‎Vì anh ấy là Lee,\N‎nên họ gọi nó là tập đoàn Lee.
Dialogue: 0,0:09:15.00,0:09:16.88,Default,,0,0,0,,‎Thật sự khiến ta bối rối mà.
Dialogue: 0,0:09:17.75,0:09:19.25,Default,,0,0,0,,‎Bọn tôi đã tìm được nam diễn viên mới.
Dialogue: 0,0:09:19.83,0:09:21.83,Default,,0,0,0,,‎Cậu ta muốn sớm nói chuyện với anh.
Dialogue: 0,0:09:21.92,0:09:24.25,Default,,0,0,0,,‎Được. Tuần sau tôi sẽ về.
Dialogue: 0,0:09:28.50,0:09:32.25,Default,,0,0,0,,{\i1}‎Nam diễn viên chính trong bộ phim mới{\i0}\N{\i1}‎đã bỏ vai vì tiền lương{\i0}
Dialogue: 0,0:09:32.33,0:09:34.04,Default,,0,0,0,,{\i1}‎và việc sản xuất phim bị dừng lại.{\i0}
Dialogue: 0,0:09:34.13,0:09:39.96,Default,,0,0,0,,{\i1}‎Lee rất chán mọi chuyện{\i0}\N{\i1}‎nên rời Trung Quốc. Câu chuyện là thế.{\i0}
Dialogue: 0,0:09:48.71,0:09:49.54,Default,,0,0,0,,‎Tôi nghĩ mình có thể...
Dialogue: 0,0:10:02.83,0:10:05.58,Default,,0,0,0,,‎Anh uống được rượu kìa!
Dialogue: 0,0:10:06.29,0:10:09.83,Default,,0,0,0,,‎Ông Lee Guanrai,\N‎người bố quá cố của anh ấy,
Dialogue: 0,0:10:09.92,0:10:11.84,Default,,0,0,0,,‎từng là đạo diễn nổi tiếng\N‎trong mảng phim hiệp sĩ.
Dialogue: 0,0:10:11.92,0:10:13.63,Default,,0,0,0,,‎Phim hiệp sĩ là gì?
Dialogue: 0,0:10:13.71,0:10:18.59,Default,,0,0,0,,{\i1}‎Là những bộ phim kiếm hiệp hành động,{\i0}
Dialogue: 0,0:10:18.67,0:10:20.63,Default,,0,0,0,,{\i1}‎dựa trên tiểu thuyết Trung Quốc{\i0}\N{\i1}‎những năm 1920.{\i0}
Dialogue: 0,0:10:23.08,0:10:25.12,Default,,0,0,0,,‎Cả anh và bố anh đều là đạo diễn phim.
Dialogue: 0,0:10:25.71,0:10:31.25,Default,,0,0,0,,‎Tôi có cảm hứng muốn làm\N‎đạo diễn phim như bố tôi.
Dialogue: 0,0:10:32.29,0:10:34.71,Default,,0,0,0,,‎Rất mừng là việc sản xuất\N‎bộ phim mới của anh không bị huỷ.
Dialogue: 0,0:10:40.00,0:10:44.33,Default,,0,0,0,,‎Chúng tôi đã dự định làm lại\N‎bộ phim mà bố tôi không thể hoàn thành.
Dialogue: 0,0:10:47.00,0:10:50.67,Default,,0,0,0,,‎Khi nam diễn viên chính\N‎từ chối đề nghị, tôi thấy rất nhẹ nhõm.
Dialogue: 0,0:10:53.21,0:10:56.25,Default,,0,0,0,,‎Tôi không có tự tin\N‎để làm lại phim đó, và tôi vẫn sợ.
Dialogue: 0,0:10:57.00,0:10:59.58,Default,,0,0,0,,‎Lúc nào tôi cũng sợ bị so sánh với ông ấy.
Dialogue: 0,0:11:01.46,0:11:03.38,Default,,0,0,0,,‎Anh không giống bố mình!
Dialogue: 0,0:11:03.46,0:11:06.04,Default,,0,0,0,,‎Hãy làm phim của mình đi!
Dialogue: 0,0:11:06.13,0:11:08.55,Default,,0,0,0,,‎Phải. Hãy làm phim đi!
Dialogue: 0,0:11:08.63,0:11:13.01,Default,,0,0,0,,‎Có quá nhiều đạo diễn phim\N‎thực sự không thể làm nổi một bộ phim.
Dialogue: 0,0:11:15.04,0:11:21.37,Default,,0,0,0,,‎Thật ra, nam diễn viên chính\N‎trong phim của ông ấy là người Nhật.
Dialogue: 0,0:11:23.17,0:11:27.46,Default,,0,0,0,,‎Bố tôi từng muốn gặp lại người này\N‎sau khi ông ta rời Trung Quốc.
Dialogue: 0,0:11:28.33,0:11:31.21,Default,,0,0,0,,‎Tôi điều tra chỗ ở của ông ấy,\N‎nhưng không tìm thấy.
Dialogue: 0,0:11:32.38,0:11:35.30,Default,,0,0,0,,‎Cách đây hơn 40 năm rồi nhỉ?
Dialogue: 0,0:11:35.38,0:11:38.17,Default,,0,0,0,,‎Không dễ gì tìm được ông ấy.
Dialogue: 0,0:11:39.33,0:11:43.29,Default,,0,0,0,,‎Bộ phim anh định làm lại\N‎có nội dung như thế nào?
Dialogue: 0,0:11:46.08,0:11:47.16,Default,,0,0,0,,‎Bộ phim này rất dài.
Dialogue: 0,0:11:47.25,0:11:49.04,Default,,0,0,0,,‎Tôi giải thích sơ qua được không?
Dialogue: 0,0:11:49.79,0:11:51.21,Default,,0,0,0,,‎Không sao.
Dialogue: 0,0:11:52.29,0:11:53.67,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:11:53.75,0:11:56.00,Default,,0,0,0,,‎- Mọi người đều ở đây.\N‎- Hoan nghênh.
Dialogue: 0,0:11:56.75,0:11:59.38,Default,,0,0,0,,‎Ông chủ, một chai bia\N‎và trứng cuộn ngọt nhé.
Dialogue: 0,0:11:59.46,0:12:01.59,Default,,0,0,0,,‎Canh miso với thịt heo và rau.\N‎Suất lớn nhé.
Dialogue: 0,0:12:01.67,0:12:02.71,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:12:03.29,0:12:07.96,Default,,0,0,0,,‎Cô Kosuzu, đây là Lee Punfa.
Dialogue: 0,0:12:08.04,0:12:10.67,Default,,0,0,0,,‎Anh ấy là đạo diễn phim. Đẹp trai nhỉ?
Dialogue: 0,0:12:11.75,0:12:14.00,Default,,0,0,0,,‎Tôi cũng thích trứng cuộn ngọt.
Dialogue: 0,0:12:14.08,0:12:16.08,Default,,0,0,0,,‎Thật trùng hợp!
Dialogue: 0,0:12:16.83,0:12:18.33,Default,,0,0,0,,‎Trứng cuộn của ông ấy tuyệt nhỉ?
Dialogue: 0,0:12:23.63,0:12:25.01,Default,,0,0,0,,‎Ý tôi là "ngon".
Dialogue: 0,0:12:29.58,0:12:31.71,Default,,0,0,0,,‎Rất... Tuyệt.
Dialogue: 0,0:12:32.83,0:12:35.54,Default,,0,0,0,,‎Lee và anh Kanemoto, xin tiếp tục.
Dialogue: 0,0:12:36.17,0:12:37.00,Default,,0,0,0,,‎Được chứ?
Dialogue: 0,0:12:42.54,0:12:45.04,Default,,0,0,0,,‎Đó là vào thế kỷ 15,\N‎suốt triều đại nhà Minh ở Trung Quốc,
Dialogue: 0,0:12:45.13,0:12:51.67,Default,,0,0,0,,‎một nhóm thái giám độc ác\N‎muốn lên nắm quyền một khu vực.
Dialogue: 0,0:12:51.75,0:12:55.96,Default,,0,0,0,,{\i1}‎Chúng biến tể tướng chống đối{\i0}\N{\i1}‎thành kẻ giơ đầu chịu trận và giết ông ta.{\i0}
Dialogue: 0,0:12:56.04,0:12:59.96,Default,,0,0,0,,{\i1}‎Sau đó chúng cũng bắt đầu{\i0}\N{\i1}‎săn lùng gia đình ông ấy.{\i0}
Dialogue: 0,0:13:00.67,0:13:05.09,Default,,0,0,0,,‎Chúng phát hiện ra\N‎chỗ ở của họ và cố giết sạch.
Dialogue: 0,0:13:05.71,0:13:08.25,Default,,0,0,0,,‎Giờ nguy hiểm đang rình rập quanh họ!
Dialogue: 0,0:13:09.17,0:13:13.13,Default,,0,0,0,,‎Họ bị dồn vào chân tường.\N‎Mạng sống như ngọn đèn trước gió.
Dialogue: 0,0:13:13.21,0:13:14.75,Default,,0,0,0,,‎Sau đó,
Dialogue: 0,0:13:14.83,0:13:17.75,Default,,0,0,0,,‎một cao thủ và là thái giám\N‎tầng cấp thấp trong nhóm độc ác đó,
Dialogue: 0,0:13:17.83,0:13:20.79,Default,,0,0,0,,‎một kẻ đẹp trai được gọi là\N‎Tiểu Ninh xuất hiện trước gia đình này.
Dialogue: 0,0:13:20.88,0:13:25.51,Default,,0,0,0,,{\i1}‎Tiểu Ninh từng là thuộc hạ của tể tướng.{\i0}
Dialogue: 0,0:13:27.67,0:13:29.75,Default,,0,0,0,,‎Tiểu Ninh là thành viên\N‎của nhóm độc ác này
Dialogue: 0,0:13:29.83,0:13:34.75,Default,,0,0,0,,‎nhưng chưa từng quên đi\N‎sự tử tế của vị tể tướng kia.
Dialogue: 0,0:13:36.25,0:13:39.54,Default,,0,0,0,,‎Tiểu Ninh quyết định\N‎chịu chung số phận với gia đình tể tướng,
Dialogue: 0,0:13:40.13,0:13:44.17,Default,,0,0,0,,‎ra tay chém chết kẻ thù.
Dialogue: 0,0:13:48.75,0:13:50.92,Default,,0,0,0,,‎"Giờ ta mới là chính ta.
Dialogue: 0,0:13:54.63,0:13:55.88,Default,,0,0,0,,‎Mọi người"...
Dialogue: 0,0:13:57.54,0:14:00.87,Default,,0,0,0,,‎Xin lỗi đã phản bội!
Dialogue: 0,0:14:00.96,0:14:05.29,Default,,0,0,0,,‎Anh ta nói, "Xin lỗi đã phản bội!"\N‎Sao? Kosuzu, sao cô...
Dialogue: 0,0:14:25.92,0:14:26.92,Default,,0,0,0,,‎Tiểu Ninh!
Dialogue: 0,0:14:45.00,0:14:47.00,Default,,0,0,0,,‎Lẽ nào...
Dialogue: 0,0:14:50.46,0:14:52.21,Default,,0,0,0,,‎Bố tôi không hay nấu ăn.
Dialogue: 0,0:14:55.08,0:14:56.29,Default,,0,0,0,,‎Tôi biết.
Dialogue: 0,0:14:59.42,0:15:03.67,Default,,0,0,0,,‎Cô là người đã dạy bố tôi\N‎cách làm trứng cuộn ngọt nhỉ?
Dialogue: 0,0:15:08.21,0:15:09.67,Default,,0,0,0,,‎Quả nhiên như thế.
Dialogue: 0,0:15:13.04,0:15:14.00,Default,,0,0,0,,‎Đừng nhìn tôi.
Dialogue: 0,0:15:32.38,0:15:35.17,Default,,0,0,0,,‎Anh bị sao thế?
Dialogue: 0,0:15:36.63,0:15:39.84,Default,,0,0,0,,‎Người đó là đàn ông hay đàn bà?
Dialogue: 0,0:15:43.67,0:15:45.67,Default,,0,0,0,,‎Tôi nghĩ là cả hai.
Dialogue: 0,0:15:49.54,0:15:51.46,Default,,0,0,0,,‎Vào trong uống tách trà nhé?
Dialogue: 0,0:15:51.54,0:15:53.29,Default,,0,0,0,,‎Tôi đang pha trà đây.
Dialogue: 0,0:15:54.13,0:15:55.34,Default,,0,0,0,,‎Xin mời.
Dialogue: 0,0:15:55.42,0:15:56.80,Default,,0,0,0,,‎Tôi có thể nói gì...
Dialogue: 0,0:15:57.50,0:15:59.33,Default,,0,0,0,,‎Thời gian thật khắc nghiệt!
Dialogue: 0,0:16:20.04,0:16:21.08,Default,,0,0,0,,‎Ông chủ.
Dialogue: 0,0:16:24.54,0:16:26.96,Default,,0,0,0,,‎Tôi vào được không?
Dialogue: 0,0:16:28.04,0:16:28.87,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:16:41.29,0:16:42.83,Default,,0,0,0,,‎Tôi gặp ông ấy...
Dialogue: 0,0:16:44.46,0:16:46.84,Default,,0,0,0,,‎ở một quán bar tôi từng làm việc.
Dialogue: 0,0:16:49.71,0:16:53.46,Default,,0,0,0,,‎Bố Lee tình cờ có đến Nhật Bản.
Dialogue: 0,0:16:54.17,0:16:59.84,Default,,0,0,0,,‎Ông ấy thuyết phục tôi làm\N‎diễn viên chính cho phim mới của ông ấy.
Dialogue: 0,0:17:01.75,0:17:03.83,Default,,0,0,0,,‎Ông ấy rất quyến rũ,
Dialogue: 0,0:17:04.46,0:17:06.88,Default,,0,0,0,,‎nên tôi đã phải lòng ông ấy.
Dialogue: 0,0:17:09.33,0:17:11.16,Default,,0,0,0,,‎Ông ấy nói đã ly dị
Dialogue: 0,0:17:12.17,0:17:17.05,Default,,0,0,0,,‎và đang sống cùng con trai mới sinh.
Dialogue: 0,0:17:19.08,0:17:20.79,Default,,0,0,0,,‎Nên tôi không chần chừ...
Dialogue: 0,0:17:21.38,0:17:23.59,Default,,0,0,0,,‎theo ông ấy sang Trung Quốc.
Dialogue: 0,0:17:27.67,0:17:29.84,Default,,0,0,0,,‎Trông ngon thật.
Dialogue: 0,0:17:30.92,0:17:33.30,Default,,0,0,0,,‎Lee có giống bố cậu ta không?
Dialogue: 0,0:17:34.04,0:17:35.50,Default,,0,0,0,,‎Có đấy.
Dialogue: 0,0:17:36.71,0:17:40.21,Default,,0,0,0,,‎Ngay lúc cậu ta nói "ngon"\N‎bằng tiếng Trung là tôi nhận ra ngay.
Dialogue: 0,0:17:41.21,0:17:43.29,Default,,0,0,0,,‎Tôi uống với nhé?
Dialogue: 0,0:17:43.38,0:17:44.76,Default,,0,0,0,,‎Dĩ nhiên rồi.
Dialogue: 0,0:17:45.50,0:17:46.63,Default,,0,0,0,,‎Xin mời.
Dialogue: 0,0:18:12.63,0:18:13.92,Default,,0,0,0,,‎Bộ phim mới đó...
Dialogue: 0,0:18:14.75,0:18:17.46,Default,,0,0,0,,‎Việc sản xuất phim dừng lại do thiếu tiền.
Dialogue: 0,0:18:21.25,0:18:22.92,Default,,0,0,0,,‎Sau đó,
Dialogue: 0,0:18:23.92,0:18:27.38,Default,,0,0,0,,‎ông ấy đột nhiên\N‎không còn hứng thú với tôi.
Dialogue: 0,0:18:28.67,0:18:31.63,Default,,0,0,0,,‎Tôi đoán đó không phải\N‎là cái kết hạnh phúc dành cho tôi.
Dialogue: 0,0:18:34.21,0:18:38.13,Default,,0,0,0,,‎Lee nói cậu ta lúc nào cũng sợ
Dialogue: 0,0:18:39.58,0:18:42.83,Default,,0,0,0,,‎bị so sánh với bố mình.
Dialogue: 0,0:18:44.67,0:18:46.34,Default,,0,0,0,,‎Cậu ta đâu thể tránh được.
Dialogue: 0,0:18:47.29,0:18:50.58,Default,,0,0,0,,‎Điều duy nhất cậu ta có thể làm\N‎là làm phim. Thằng bé ngớ ngẩn mà.
Dialogue: 0,0:18:53.38,0:18:58.46,Default,,0,0,0,,‎Tôi tin cô có thể nói gì đó với cậu ta.
Dialogue: 0,0:19:04.13,0:19:07.05,Default,,0,0,0,,‎ĐƯỢC ĐẶT RIÊNG HÔM NAY
Dialogue: 0,0:19:07.13,0:19:09.92,Default,,0,0,0,,{\i1}‎Đêm trước khi Lee rời Nhật Bản,{\i0}
Dialogue: 0,0:19:10.46,0:19:14.00,Default,,0,0,0,,{\i1}‎tất cả khách quen{\i0}\N{\i1}‎đều có mặt để tạm biệt cậu ta.{\i0}
Dialogue: 0,0:19:15.50,0:19:16.42,Default,,0,0,0,,‎Mọi người.
Dialogue: 0,0:19:17.13,0:19:18.46,Default,,0,0,0,,‎Cạn ly nào!
Dialogue: 0,0:19:19.04,0:19:21.42,Default,,0,0,0,,‎Cạn ly!
Dialogue: 0,0:19:26.96,0:19:30.29,Default,,0,0,0,,‎Thật vui được gặp mọi người.
Dialogue: 0,0:19:31.54,0:19:34.62,Default,,0,0,0,,‎Ông chủ, đêm nay rất cảm ơn ông.
Dialogue: 0,0:19:34.71,0:19:36.17,Default,,0,0,0,,‎Được. Của anh đây.
Dialogue: 0,0:19:39.17,0:19:43.71,Default,,0,0,0,,‎Cô Kosuzu, cô không nấu trứng cuộn nữa à?
Dialogue: 0,0:19:44.75,0:19:47.04,Default,,0,0,0,,‎Vì ông chủ nấu ngon quá rồi.
Dialogue: 0,0:19:48.38,0:19:52.55,Default,,0,0,0,,‎Này, tôi có thứ này cho cậu.
Dialogue: 0,0:19:55.75,0:19:57.17,Default,,0,0,0,,‎Đẹp quá!
Dialogue: 0,0:19:57.71,0:19:59.00,Default,,0,0,0,,‎Không thể tin được!
Dialogue: 0,0:19:59.08,0:20:00.12,Default,,0,0,0,,‎Không thể nào là thật được!
Dialogue: 0,0:20:00.21,0:20:01.75,Default,,0,0,0,,‎Thật sự là cô à?
Dialogue: 0,0:20:17.21,0:20:21.54,Default,,0,0,0,,‎Bố cậu chỉ yêu mỗi cậu và phim.
Dialogue: 0,0:20:22.46,0:20:23.67,Default,,0,0,0,,‎Hãy tiếp tục làm tốt nhé.
Dialogue: 0,0:20:28.04,0:20:28.87,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:20:30.17,0:20:32.96,Default,,0,0,0,,‎Hôm nay ta có nên gọi\N‎trứng cuộn không nhỉ?
Dialogue: 0,0:20:34.88,0:20:37.55,Default,,0,0,0,,‎Để chúc mừng khởi đầu mới của cậu Lee,\N‎tôi sẽ mời tất cả.
Dialogue: 0,0:20:38.67,0:20:40.75,Default,,0,0,0,,‎Tuyệt vời!
Dialogue: 0,0:20:41.63,0:20:44.13,Default,,0,0,0,,‎- Ông chủ mời thật ư?\N‎- Lạ thật đấy.
Dialogue: 0,0:20:47.75,0:20:50.21,Default,,0,0,0,,{\i1}‎Ba tháng trôi qua sau ngày hôm đó.{\i0}
Dialogue: 0,0:21:14.67,0:21:15.55,Default,,0,0,0,,‎Đầu hàng đi!
Dialogue: 0,0:21:28.88,0:21:29.96,Default,,0,0,0,,‎Ngươi...
Dialogue: 0,0:21:49.38,0:21:52.51,Default,,0,0,0,,‎Xin lỗi đã phản bội!
Dialogue: 0,0:21:52.58,0:21:53.41,Default,,0,0,0,,‎Cắt!
Dialogue: 0,0:21:53.50,0:21:54.54,Default,,0,0,0,,‎Cắt!
Dialogue: 0,0:21:55.83,0:21:56.71,Default,,0,0,0,,‎Tốt hơn rồi.
Dialogue: 0,0:21:56.79,0:22:00.12,Default,,0,0,0,,‎Nhưng hãy thể hiện\N‎khuôn mặt ngầu hơn chút.
Dialogue: 0,0:22:00.21,0:22:01.42,Default,,0,0,0,,‎Vẻ mặt anh hơi cứng.
Dialogue: 0,0:22:01.96,0:22:04.04,Default,,0,0,0,,‎Cố gắng thoải mái nhé.
Dialogue: 0,0:22:04.13,0:22:05.38,Default,,0,0,0,,‎Nghỉ ngơi chút nào.
Dialogue: 0,0:22:16.79,0:22:18.58,Default,,0,0,0,,‎Thái giám...
Dialogue: 0,0:22:19.50,0:22:21.67,Default,,0,0,0,,‎Để đổi lấy sự nghiệp,
Dialogue: 0,0:22:22.79,0:22:25.71,Default,,0,0,0,,‎họ phải từ bỏ chức năng đàn ông của mình.
Dialogue: 0,0:22:27.46,0:22:30.04,Default,,0,0,0,,‎Họ là những sinh vật\N‎không may mắn và u sầu.
Dialogue: 0,0:22:34.83,0:22:39.75,Default,,0,0,0,,‎Nếu cậu không hiểu rõ điều đó,
Dialogue: 0,0:22:40.79,0:22:43.00,Default,,0,0,0,,‎cậu sẽ diễn rất hời hợt.
Dialogue: 0,0:22:43.08,0:22:44.33,Default,,0,0,0,,‎Này anh kia!
Dialogue: 0,0:22:44.42,0:22:45.84,Default,,0,0,0,,‎Trang phục sai rồi.
Dialogue: 0,0:22:45.92,0:22:48.09,Default,,0,0,0,,‎Thay mau đi.
Dialogue: 0,0:22:48.17,0:22:49.71,Default,,0,0,0,,‎Mau lên nếu không sẽ bị sa thải.
Dialogue: 0,0:22:50.38,0:22:52.67,Default,,0,0,0,,‎Làm ngay đây. Ngay lập tức.
Dialogue: 0,0:22:56.42,0:22:57.50,Default,,0,0,0,,‎Đạo diễn.
Dialogue: 0,0:23:00.13,0:23:00.96,Default,,0,0,0,,‎Quay thôi.
Dialogue: 0,0:23:01.04,0:23:01.87,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:23:06.00,0:23:07.13,Default,,0,0,0,,‎Máy quay chuẩn bị.
Dialogue: 0,0:23:08.17,0:23:09.55,Default,,0,0,0,,‎ĐẠO DIỄN: LEE
Dialogue: 0,0:23:09.63,0:23:10.46,Default,,0,0,0,,‎Diễn!
Dialogue: 0,0:23:11.29,0:23:14.54,Default,,0,0,0,,‎HẾT PHIM
