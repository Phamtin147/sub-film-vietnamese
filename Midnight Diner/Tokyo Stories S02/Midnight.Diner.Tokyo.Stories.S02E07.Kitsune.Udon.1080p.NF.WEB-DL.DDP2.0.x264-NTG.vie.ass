Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:04.00,0:01:08.17,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc{\i0}\N{\i1}‎ngày làm việc và vội vã ra về,{\i0}
Dialogue: 0,0:01:08.88,0:01:10.42,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:28.00,0:01:32.04,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm tới 7:00 sáng.{\i0}
Dialogue: 0,0:01:32.75,0:01:36.08,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:41.54,0:01:43.50,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:43.58,0:01:45.46,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:50.33,0:01:55.91,Default,,0,0,0,,‎MÌ UDON VỚI ĐẬU PHỤ
Dialogue: 0,0:01:58.21,0:02:01.71,Default,,0,0,0,,‎Là đường này nhỉ? Hoặc có thể không đúng?
Dialogue: 0,0:02:03.00,0:02:05.58,Default,,0,0,0,,‎- Chắc đúng đường này rồi.\N‎- Đường này nhỉ?
Dialogue: 0,0:02:06.88,0:02:07.96,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:02:11.79,0:02:13.04,Default,,0,0,0,,‎Được rồi, nơi này...
Dialogue: 0,0:02:24.42,0:02:25.34,Default,,0,0,0,,‎Là nơi này?
Dialogue: 0,0:02:26.46,0:02:27.38,Default,,0,0,0,,‎QUÁN ĂN
Dialogue: 0,0:02:28.58,0:02:29.71,Default,,0,0,0,,‎Nhìn này.
Dialogue: 0,0:02:31.33,0:02:32.58,Default,,0,0,0,,‎Ừ, là nơi này.
Dialogue: 0,0:02:40.38,0:02:42.42,Default,,0,0,0,,‎Nhưng trong đó toàn người già.
Dialogue: 0,0:02:44.63,0:02:46.55,Default,,0,0,0,,‎Haruna, cậu vào trước đi.
Dialogue: 0,0:02:46.63,0:02:49.05,Default,,0,0,0,,‎Akina, cậu mới là người muốn đến đây.
Dialogue: 0,0:02:49.13,0:02:50.96,Default,,0,0,0,,‎Phải, nhưng quan trọng gì chứ.
Dialogue: 0,0:02:51.04,0:02:52.08,Default,,0,0,0,,‎Cậu vào trước đi.
Dialogue: 0,0:02:52.17,0:02:53.25,Default,,0,0,0,,‎Không được.
Dialogue: 0,0:02:53.33,0:02:54.71,Default,,0,0,0,,‎Này, hai cô kia!
Dialogue: 0,0:02:56.21,0:02:57.29,Default,,0,0,0,,‎Tôi vào được không?
Dialogue: 0,0:02:59.96,0:03:01.13,Default,,0,0,0,,‎Xin mời ạ!
Dialogue: 0,0:03:03.13,0:03:04.55,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:03:04.63,0:03:05.88,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:03:08.46,0:03:12.09,Default,,0,0,0,,‎Thật lạ khi Marilyn\N‎mang hai cô gái trẻ đến đây.
Dialogue: 0,0:03:12.17,0:03:13.34,Default,,0,0,0,,‎Vũ công mới hả?
Dialogue: 0,0:03:13.42,0:03:14.59,Default,,0,0,0,,‎Không phải.
Dialogue: 0,0:03:14.67,0:03:15.84,Default,,0,0,0,,‎Họ đứng bên ngoài.
Dialogue: 0,0:03:16.46,0:03:18.96,Default,,0,0,0,,‎Ông chủ, món mọi khi\N‎và rượu shochu với đá.
Dialogue: 0,0:03:19.04,0:03:19.87,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:03:20.63,0:03:21.88,Default,,0,0,0,,‎Thế còn hai cô?
Dialogue: 0,0:03:25.54,0:03:27.62,Default,,0,0,0,,‎Ông có mì udon đậu phụ rán chứ?
Dialogue: 0,0:03:29.13,0:03:30.84,Default,,0,0,0,,‎Có.
Dialogue: 0,0:03:30.92,0:03:32.80,Default,,0,0,0,,‎Vậy cho hai tô ạ.
Dialogue: 0,0:03:33.58,0:03:34.46,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:05.08,0:04:06.29,Default,,0,0,0,,‎Của hai cô đây.
Dialogue: 0,0:04:16.50,0:04:18.96,Default,,0,0,0,,‎Cho tôi xin một vai\N‎trong buổi thử giọng sắp tới.
Dialogue: 0,0:04:19.75,0:04:21.71,Default,,0,0,0,,‎Vai nhỏ cũng được.
Dialogue: 0,0:04:21.79,0:04:22.96,Default,,0,0,0,,‎Làm ơn.
Dialogue: 0,0:04:26.08,0:04:28.29,Default,,0,0,0,,‎Hai cô làm nghề gì thế?
Dialogue: 0,0:04:29.13,0:04:32.09,Default,,0,0,0,,‎Chúng cháu đang cố trở thành\N‎diễn viên lồng tiếng phim hoạt hình.
Dialogue: 0,0:04:32.71,0:04:37.63,Default,,0,0,0,,‎Mai có buổi diễn thử. Chúng cháu\N‎đang ước gặp may mắn bằng tô mì này.
Dialogue: 0,0:04:37.71,0:04:38.96,Default,,0,0,0,,‎- Đúng không?\N‎- Ừ.
Dialogue: 0,0:04:39.67,0:04:41.13,Default,,0,0,0,,‎Ước gặp may mắn?
Dialogue: 0,0:04:42.92,0:04:46.00,Default,,0,0,0,,‎Nghe nói mì udon đậu phụ rán\N‎của ông ấy mang lại may mắn ạ?
Dialogue: 0,0:04:46.79,0:04:48.79,Default,,0,0,0,,‎Tôi chưa từng nghe đến.
Dialogue: 0,0:04:48.88,0:04:52.46,Default,,0,0,0,,‎Một người bạn ăn món mì này\N‎đã có được vai sau buổi thử giọng.
Dialogue: 0,0:04:52.54,0:04:53.75,Default,,0,0,0,,‎Em thấy trên Instagram.
Dialogue: 0,0:04:53.83,0:04:58.46,Default,,0,0,0,,‎Tình cờ thôi. Nó chỉ là\N‎món mì udon đậu phụ rán thông thường.
Dialogue: 0,0:05:00.75,0:05:02.17,Default,,0,0,0,,‎Thật vậy à?
Dialogue: 0,0:05:02.25,0:05:04.75,Default,,0,0,0,,‎Nhưng có thể họ đúng.
Dialogue: 0,0:05:04.83,0:05:08.83,Default,,0,0,0,,‎Vì ngày nào ông ấy cũng cúng\N‎đậu phụ rán cho miếu thờ.
Dialogue: 0,0:05:08.92,0:05:10.75,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:05:11.92,0:05:13.42,Default,,0,0,0,,‎Mọi thứ đều có thể xảy ra.
Dialogue: 0,0:05:21.46,0:05:22.88,Default,,0,0,0,,‎- Ăn thôi.\N‎- Ăn thôi.
Dialogue: 0,0:05:36.88,0:05:38.01,Default,,0,0,0,,‎Ngon thật.
Dialogue: 0,0:05:40.46,0:05:41.84,Default,,0,0,0,,‎Ngon đúng không?
Dialogue: 0,0:05:44.13,0:05:44.96,Default,,0,0,0,,‎Này.
Dialogue: 0,0:05:45.79,0:05:48.96,Default,,0,0,0,,‎Cậu có thể phát hiện ra\N‎giọng địa phương của tớ ở dòng cuối nhỉ?
Dialogue: 0,0:05:49.79,0:05:52.71,Default,,0,0,0,,‎Cậu sẽ không sao\N‎nếu cậu chú ý về ngữ điệu.
Dialogue: 0,0:05:55.54,0:05:58.04,Default,,0,0,0,,‎"Đêm đó, trên cầu"...
Dialogue: 0,0:05:59.58,0:06:00.87,Default,,0,0,0,,‎"Trên cầu"...
Dialogue: 0,0:06:00.96,0:06:02.04,Default,,0,0,0,,‎"Trên cầu"...
Dialogue: 0,0:06:02.13,0:06:03.63,Default,,0,0,0,,‎"Trên cầu".
Dialogue: 0,0:06:03.71,0:06:06.04,Default,,0,0,0,,‎Tớ không chắc nữa.
Dialogue: 0,0:06:06.13,0:06:07.46,Default,,0,0,0,,‎Đừng lo. Sẽ ổn thôi.
Dialogue: 0,0:06:07.54,0:06:09.25,Default,,0,0,0,,‎- Thật ư?\N‎- Nói lại nào.
Dialogue: 0,0:06:10.71,0:06:13.96,Default,,0,0,0,,‎"Đêm đó, trên cầu,\N‎tôi thấy một người đàn ông đang chạy"...
Dialogue: 0,0:06:14.04,0:06:15.54,Default,,0,0,0,,‎"Trên cầu".
Dialogue: 0,0:06:15.63,0:06:16.59,Default,,0,0,0,,‎"Trên cầu".
Dialogue: 0,0:06:16.67,0:06:17.96,Default,,0,0,0,,‎"Trên cầu".
Dialogue: 0,0:06:19.42,0:06:21.46,Default,,0,0,0,,‎- "Trên cầu".\N‎- Đúng thế.
Dialogue: 0,0:06:24.71,0:06:26.71,Default,,0,0,0,,‎Nghe hay lắm.
Dialogue: 0,0:06:26.79,0:06:29.58,Default,,0,0,0,,‎Tối nay tôi sẽ mời hai cô\N‎vì tôi là người tốt.
Dialogue: 0,0:06:29.67,0:06:33.25,Default,,0,0,0,,‎- Thật ư?\N‎- Không có chuyện ăn miễn phí đâu.
Dialogue: 0,0:06:35.54,0:06:38.17,Default,,0,0,0,,‎Tôi nghĩ hai cô nên cảm ơn cô ấy.
Dialogue: 0,0:06:50.79,0:06:52.21,Default,,0,0,0,,‎Cả hai bọn cháu đều không thành công.
Dialogue: 0,0:06:53.58,0:06:55.00,Default,,0,0,0,,‎Tôi hiểu...
Dialogue: 0,0:06:55.08,0:06:56.71,Default,,0,0,0,,‎Nó không mang lại may mắn cho các cô.
Dialogue: 0,0:06:57.58,0:07:01.54,Default,,0,0,0,,‎Nghe nói nghề diễn viên lồng tiếng\N‎rất khó kiếm việc.
Dialogue: 0,0:07:02.38,0:07:05.67,Default,,0,0,0,,‎Nhưng Haruna\N‎là một trong bốn thí sinh vòng cuối cùng.
Dialogue: 0,0:07:06.46,0:07:11.42,Default,,0,0,0,,‎Dù vậy, công ty quản lý giải trí\N‎đã nói chuyện riêng với Akina.
Dialogue: 0,0:07:12.04,0:07:13.17,Default,,0,0,0,,‎Tuyệt thật!
Dialogue: 0,0:07:13.25,0:07:16.71,Default,,0,0,0,,‎Cả hai đều đã nhích dần\N‎tới mơ ước của mình.
Dialogue: 0,0:07:16.79,0:07:18.50,Default,,0,0,0,,‎Nó đã mang lại may mắn.
Dialogue: 0,0:07:19.29,0:07:20.50,Default,,0,0,0,,‎Của hai cô đây.
Dialogue: 0,0:07:24.17,0:07:25.92,Default,,0,0,0,,‎Hôm nay có hai miếng đậu phụ rán sao?
Dialogue: 0,0:07:26.79,0:07:29.87,Default,,0,0,0,,‎Là tôi mời đấy.
Dialogue: 0,0:07:30.50,0:07:31.63,Default,,0,0,0,,‎Tuyệt vời!
Dialogue: 0,0:07:32.58,0:07:35.71,Default,,0,0,0,,‎Hãy hứa lần tới\N‎ta mang tin tốt hơn đến cho ông chủ.
Dialogue: 0,0:07:37.88,0:07:41.42,Default,,0,0,0,,‎- Còn trẻ thật thích. Ghen tị quá.\N‎- Ăn thôi.
Dialogue: 0,0:07:41.50,0:07:44.54,Default,,0,0,0,,‎Đừng ngớ ngẩn. Cô vẫn còn trẻ mà, Marilyn.
Dialogue: 0,0:07:45.58,0:07:46.54,Default,,0,0,0,,‎Đừng bận tâm.
Dialogue: 0,0:07:51.00,0:07:54.25,Default,,0,0,0,,{\i1}‎Khoảng sáu tháng sau...{\i0}
Dialogue: 0,0:07:56.79,0:07:57.79,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:07:59.67,0:08:00.67,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:08:01.25,0:08:02.38,Default,,0,0,0,,‎Lâu rồi không gặp.
Dialogue: 0,0:08:06.63,0:08:08.21,Default,,0,0,0,,‎Cho cháu mì udon đậu phụ rán nhé?
Dialogue: 0,0:08:08.88,0:08:09.96,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:08:17.79,0:08:21.58,Default,,0,0,0,,‎Nghe nói cô đã\N‎được làm diễn viên lồng tiếng.
Dialogue: 0,0:08:22.50,0:08:25.00,Default,,0,0,0,,‎Hôm trước, Haruna có kể với tôi.
Dialogue: 0,0:08:25.67,0:08:26.50,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:08:27.63,0:08:31.92,Default,,0,0,0,,‎Không hẳn vậy. Cháu gia nhập\N‎nhóm diễn viên lồng tiếng thần tượng.
Dialogue: 0,0:08:33.25,0:08:37.04,Default,,0,0,0,,‎Nên chỉ có các buổi trình diễn\N‎và gặp mặt fan thôi.
Dialogue: 0,0:08:37.92,0:08:39.71,Default,,0,0,0,,‎Không phải công việc lí tưởng của cháu.
Dialogue: 0,0:08:40.33,0:08:43.04,Default,,0,0,0,,‎Nhưng nó có thể dẫn đến điều gì đấy.
Dialogue: 0,0:08:44.63,0:08:45.55,Default,,0,0,0,,‎Đó là thái độ đúng đắn!
Dialogue: 0,0:08:48.17,0:08:50.92,Default,,0,0,0,,‎Haruna gần đây có đến sao?
Dialogue: 0,0:08:51.71,0:08:55.04,Default,,0,0,0,,‎Ừ, thỉnh thoảng sau giờ làm thêm.
Dialogue: 0,0:08:57.04,0:08:58.00,Default,,0,0,0,,‎Cô chưa gặp cô ấy à?
Dialogue: 0,0:08:59.08,0:09:00.16,Default,,0,0,0,,‎Rất ít gặp.
Dialogue: 0,0:09:00.96,0:09:03.75,Default,,0,0,0,,‎Có vẻ việc thử giọng của cậu ấy\N‎không được suôn sẻ.
Dialogue: 0,0:09:05.21,0:09:07.00,Default,,0,0,0,,‎Sao cô không gọi cho cô ấy?
Dialogue: 0,0:09:10.04,0:09:11.50,Default,,0,0,0,,‎Không phải bây giờ.
Dialogue: 0,0:09:12.71,0:09:17.67,Default,,0,0,0,,‎Vì cháu càng cố động viên,\N‎cậu ấy sẽ càng thấy tệ hơn thôi.
Dialogue: 0,0:09:32.21,0:09:33.54,Default,,0,0,0,,‎Chúng tôi rất xin lỗi.
Dialogue: 0,0:09:34.71,0:09:35.63,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:09:37.33,0:09:41.16,Default,,0,0,0,,‎Vâng. Chúng tôi sẽ cẩn thận hơn.
Dialogue: 0,0:09:41.79,0:09:42.75,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:09:43.92,0:09:45.63,Default,,0,0,0,,‎Chúng tôi vô cùng xin lỗi.
Dialogue: 0,0:09:45.71,0:09:46.67,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:10:22.46,0:10:23.84,Default,,0,0,0,,‎Mì udon đậu phụ rán?
Dialogue: 0,0:10:24.96,0:10:26.00,Default,,0,0,0,,‎Không ạ.
Dialogue: 0,0:10:27.25,0:10:29.21,Default,,0,0,0,,‎Cháu ước cũng chẳng có kết quả.
Dialogue: 0,0:10:30.38,0:10:31.76,Default,,0,0,0,,‎Sao thế?
Dialogue: 0,0:10:36.29,0:10:37.12,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:10:37.21,0:10:38.46,Default,,0,0,0,,‎Rượu sake ấm nhé.
Dialogue: 0,0:10:40.04,0:10:41.83,Default,,0,0,0,,‎- Cậu ổn chứ?\N‎- Vâng.
Dialogue: 0,0:10:41.92,0:10:43.67,Default,,0,0,0,,‎Tôi uống một ly rồi về.
Dialogue: 0,0:10:44.50,0:10:47.38,Default,,0,0,0,,{\i1}‎Anh ta là Nobuta.{\i0}
Dialogue: 0,0:10:47.46,0:10:52.09,Default,,0,0,0,,{\i1}‎Một tác giả truyện tranh{\i0}\N{\i1}‎rất nổi tiếng vài năm trước đây.{\i0}
Dialogue: 0,0:10:52.88,0:10:56.38,Default,,0,0,0,,{\i1}‎Gần đây công việc anh ta không tốt lắm.{\i0}
Dialogue: 0,0:10:58.71,0:11:00.79,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:11:04.29,0:11:06.33,Default,,0,0,0,,‎Tiền không khiến ta hạnh phúc được.
Dialogue: 0,0:11:07.29,0:11:08.29,Default,,0,0,0,,‎Lại nữa à?
Dialogue: 0,0:11:09.04,0:11:12.58,Default,,0,0,0,,‎Tôi không thể lấy lại tiền\N‎đã chi cho cô ta, hay tình yêu của cô ta.
Dialogue: 0,0:11:13.38,0:11:16.76,Default,,0,0,0,,‎Ông chủ, giờ tôi có gì chứ?
Dialogue: 0,0:11:16.83,0:11:18.29,Default,,0,0,0,,‎Công việc.
Dialogue: 0,0:11:18.38,0:11:20.38,Default,,0,0,0,,‎Về nhà và làm việc đi.
Dialogue: 0,0:11:20.96,0:11:22.46,Default,,0,0,0,,‎Thật lỗ mãng.
Dialogue: 0,0:11:28.83,0:11:29.75,Default,,0,0,0,,‎Sao nào?
Dialogue: 0,0:11:31.96,0:11:34.96,Default,,0,0,0,,‎Anh là anh Yukio Nobuta, đúng không?
Dialogue: 0,0:11:36.50,0:11:38.08,Default,,0,0,0,,‎Tôi rất hâm mộ anh.
Dialogue: 0,0:11:39.50,0:11:41.67,Default,,0,0,0,,‎- Thật sao?\N‎- Vâng.
Dialogue: 0,0:11:41.75,0:11:44.33,Default,,0,0,0,,‎- Phụ nữ luôn nói điều đó.\N‎- Sao?
Dialogue: 0,0:11:44.42,0:11:47.13,Default,,0,0,0,,‎Nhưng thường thì,\N‎họ chỉ tình cờ biết tên tôi.
Dialogue: 0,0:11:47.21,0:11:48.79,Default,,0,0,0,,‎Cô là sinh viên à?
Dialogue: 0,0:11:49.58,0:11:53.29,Default,,0,0,0,,‎Không. Tôi không nghĩ anh sẽ tin tôi,
Dialogue: 0,0:11:53.38,0:11:56.84,Default,,0,0,0,,‎nhưng tôi xem hoạt hình trên tivi\N‎từ lúc còn là học sinh trung học.
Dialogue: 0,0:11:57.50,0:12:00.13,Default,,0,0,0,,‎Tôi đang cố trở thành\N‎diễn viên lồng tiếng.
Dialogue: 0,0:12:00.21,0:12:02.59,Default,,0,0,0,,‎Cô đúng là kiểu người điển hình.
Dialogue: 0,0:12:02.67,0:12:06.34,Default,,0,0,0,,‎Những người nghĩ họ hiểu mọi thứ\N‎chỉ bằng việc đọc đôi ba quyển sách.
Dialogue: 0,0:12:06.42,0:12:09.34,Default,,0,0,0,,‎Nếu hiểu nhiều thế,\N‎sao cô không viết luôn đi!
Dialogue: 0,0:12:11.08,0:12:12.46,Default,,0,0,0,,‎Anh Nobuta.
Dialogue: 0,0:12:12.54,0:12:14.17,Default,,0,0,0,,‎Thôi đi.
Dialogue: 0,0:12:14.25,0:12:17.50,Default,,0,0,0,,‎Nhưng đó là sự thật.
Dialogue: 0,0:12:17.58,0:12:20.16,Default,,0,0,0,,‎CHO ĐẾN KHI TRỜI SÁNG\N‎YUKIO NOBUTA
Dialogue: 0,0:12:23.25,0:12:24.79,Default,,0,0,0,,‎Sao cô có nó?
Dialogue: 0,0:12:26.63,0:12:29.55,Default,,0,0,0,,‎Từ buổi đấu giá trên mạng\N‎với giá 30.000 yên.
Dialogue: 0,0:12:30.46,0:12:32.79,Default,,0,0,0,,‎Tôi tiết kiệm tiền\N‎và cuối cùng đã có được nó.
Dialogue: 0,0:12:33.50,0:12:35.33,Default,,0,0,0,,‎Tất cả sách của anh tôi đều đọc hết.
Dialogue: 0,0:12:36.58,0:12:38.12,Default,,0,0,0,,{\i1}‎Cho Đến Khi Trời Sáng.{\i0}
Dialogue: 0,0:12:42.17,0:12:44.88,Default,,0,0,0,,‎Nghe nói không thể tìm được\N‎kể cả trong cửa hàng sách cũ mà.
Dialogue: 0,0:12:45.96,0:12:47.38,Default,,0,0,0,,‎Đây là cuốn sách đầu tay của tôi.
Dialogue: 0,0:12:48.46,0:12:52.04,Default,,0,0,0,,‎Bán không chạy\N‎nên sau đó không còn xuất bản nữa.
Dialogue: 0,0:12:53.92,0:12:54.92,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:12:57.54,0:13:00.25,Default,,0,0,0,,‎Tuần nào tôi cũng xem\N{\i1}‎Canh Miso của Chúa{\i0}‎ trên tivi.
Dialogue: 0,0:13:00.33,0:13:02.46,Default,,0,0,0,,‎Tuần nào tôi cũng đọc một tập\N‎trên tạp chí {\i1}‎STEP.{\i0}
Dialogue: 0,0:13:03.79,0:13:06.42,Default,,0,0,0,,‎Gần đây tôi chưa xuất bản tập nào trên đó.
Dialogue: 0,0:13:07.33,0:13:11.46,Default,,0,0,0,,‎Nhà xuất bản nói phim hoạt hình\N‎sẽ thay thế truyện tranh.
Dialogue: 0,0:13:14.96,0:13:17.09,Default,,0,0,0,,‎Sao anh không viết nữa?
Dialogue: 0,0:13:20.67,0:13:21.71,Default,,0,0,0,,‎Vì tôi không thể.
Dialogue: 0,0:13:24.00,0:13:25.67,Default,,0,0,0,,‎Chắc họ sẽ sớm chấm dứt hợp đồng với tôi.
Dialogue: 0,0:13:27.00,0:13:29.83,Default,,0,0,0,,‎Nhưng chắc thế tốt hơn\N‎là viết mấy truyện dở tệ.
Dialogue: 0,0:13:32.96,0:13:36.63,Default,,0,0,0,,‎Không thể nói nó dở\N‎nếu anh không thử viết.
Dialogue: 0,0:13:38.96,0:13:43.04,Default,,0,0,0,,‎Tôi luôn thất bại ở các buổi thử giọng...
Dialogue: 0,0:13:43.96,0:13:46.42,Default,,0,0,0,,‎và không biết liệu\N‎tôi có thích hợp lồng tiếng phim không.
Dialogue: 0,0:13:47.33,0:13:49.41,Default,,0,0,0,,‎Nhưng ta chẳng thể nào biết nếu không thử!
Dialogue: 0,0:13:52.79,0:13:54.25,Default,,0,0,0,,‎Tôi xin lỗi.
Dialogue: 0,0:13:54.33,0:13:55.58,Default,,0,0,0,,‎Không.
Dialogue: 0,0:13:56.71,0:13:58.09,Default,,0,0,0,,‎Cô nói đúng.
Dialogue: 0,0:13:59.54,0:14:02.96,Default,,0,0,0,,‎Nhưng lúc này sự thật đó\N‎khiến tôi đau lòng.
Dialogue: 0,0:14:04.71,0:14:06.38,Default,,0,0,0,,‎Tôi rất xin lỗi.
Dialogue: 0,0:14:06.46,0:14:09.21,Default,,0,0,0,,‎Không thể đem vấn đề của tôi\N‎so với của anh được...
Dialogue: 0,0:14:09.29,0:14:11.54,Default,,0,0,0,,‎Ông chủ, tôi trả luôn cho cô ấy.
Dialogue: 0,0:14:12.21,0:14:13.50,Default,,0,0,0,,‎Tiền thừa lần sau tôi lấy.
Dialogue: 0,0:14:14.50,0:14:15.71,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:14:25.63,0:14:27.88,Default,,0,0,0,,‎Việc lắp đặt giờ đã xong.
Dialogue: 0,0:14:27.96,0:14:29.75,Default,,0,0,0,,‎Quý khách có câu hỏi nào nữa không ạ?
Dialogue: 0,0:14:31.08,0:14:31.91,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:14:32.58,0:14:34.21,Default,,0,0,0,,‎Vâng. Cảm ơn rất nhiều.
Dialogue: 0,0:14:52.33,0:14:53.66,Default,,0,0,0,,{\i1}‎Chúng tôi sẽ bật tin nhắn.{\i0}
Dialogue: 0,0:14:54.67,0:14:55.96,Default,,0,0,0,,{\i1}‎Chào, Haruna?{\i0}
Dialogue: 0,0:14:56.83,0:15:00.16,Default,,0,0,0,,{\i1}‎Không biết cậu thế nào rồi.{\i0}\N{\i1}‎Gần đây không thấy cậu đi thử giọng...{\i0}
Dialogue: 0,0:15:18.13,0:15:20.55,Default,,0,0,0,,‎Mấy ngày nay công việc sao rồi?
Dialogue: 0,0:15:23.25,0:15:24.75,Default,,0,0,0,,‎Cháu nghĩ mình sẽ bỏ việc.
Dialogue: 0,0:15:26.46,0:15:27.92,Default,,0,0,0,,‎Công ty sản xuất bảo cháu
Dialogue: 0,0:15:28.00,0:15:30.63,Default,,0,0,0,,‎họ sẽ kết thúc hợp đồng\N‎nếu cháu không làm tốt.
Dialogue: 0,0:15:32.83,0:15:34.04,Default,,0,0,0,,‎Giờ cháu hiểu ra rồi.
Dialogue: 0,0:15:35.46,0:15:38.50,Default,,0,0,0,,‎Xem hoạt hình cũng khiến cháu vui lắm rồi.
Dialogue: 0,0:15:39.67,0:15:42.84,Default,,0,0,0,,‎Cháu không muốn cuối cùng lại ghét nó,\N‎khi cố kiếm việc trong ngành này.
Dialogue: 0,0:15:45.17,0:15:46.88,Default,,0,0,0,,‎Cô đọc quyển này chưa?
Dialogue: 0,0:15:46.96,0:15:47.96,Default,,0,0,0,,‎CANH MISO CỦA CHÚA BẮT ĐẦU LẠI
Dialogue: 0,0:15:48.75,0:15:50.83,Default,,0,0,0,,‎Vâng, dĩ nhiên rồi.
Dialogue: 0,0:15:51.50,0:15:54.38,Default,,0,0,0,,‎Hôm kia anh Nobuta có nói,
Dialogue: 0,0:15:55.63,0:15:57.38,Default,,0,0,0,,‎"Tôi có thể viết lại được là nhờ Haruna.
Dialogue: 0,0:16:01.46,0:16:05.75,Default,,0,0,0,,‎Tôi học được từ cô ấy rằng\N‎ta chẳng thể nào biết được nếu không thử".
Dialogue: 0,0:16:08.46,0:16:11.59,Default,,0,0,0,,‎Anh ta đưa tôi cái này.
Dialogue: 0,0:16:12.58,0:16:14.62,Default,,0,0,0,,‎Bảo đưa nó cho cô.
Dialogue: 0,0:16:21.08,0:16:22.08,Default,,0,0,0,,‎CANH MISO CỦA CHÚA
Dialogue: 0,0:16:22.17,0:16:24.34,Default,,0,0,0,,‎BUỔI THỬ GIỌNG TUYỂN DIỄN VIÊN\N‎LỒNG TIẾNG CHO NHÂN VẬT MỚI
Dialogue: 0,0:16:39.04,0:16:40.29,Default,,0,0,0,,‎Vâng. Cảm ơn.
Dialogue: 0,0:16:40.38,0:16:42.26,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:16:47.33,0:16:50.62,Default,,0,0,0,,‎Cô có buổi biểu diễn và buổi họp fan\N‎ngay sau buổi thử giọng này.
Dialogue: 0,0:16:50.71,0:16:51.71,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:16:51.79,0:16:54.33,Default,,0,0,0,,‎Tôi sẽ đến đó\N‎sau khi kết thúc cuộc hẹn khác.
Dialogue: 0,0:16:54.42,0:16:55.25,Default,,0,0,0,,‎Cảm ơn anh.
Dialogue: 0,0:16:55.33,0:16:56.83,Default,,0,0,0,,‎- Đừng đến muộn.\N‎- Dĩ nhiên là không.
Dialogue: 0,0:17:04.29,0:17:06.04,Default,,0,0,0,,‎- Xin mời ngồi.\N‎- Vâng.
Dialogue: 0,0:17:28.08,0:17:29.04,Default,,0,0,0,,‎Xin thứ lỗi...
Dialogue: 0,0:17:29.13,0:17:30.21,Default,,0,0,0,,‎Xin lỗi nhé.
Dialogue: 0,0:17:32.71,0:17:33.79,Default,,0,0,0,,‎Lâu rồi không gặp.
Dialogue: 0,0:17:50.92,0:17:51.96,Default,,0,0,0,,{\i1}‎Tớ xin lỗi...{\i0}
Dialogue: 0,0:17:52.04,0:17:53.79,Default,,0,0,0,,‎SHOTA
Dialogue: 0,0:17:53.88,0:17:56.51,Default,,0,0,0,,{\i1}‎...nhưng tớ không thể làm được.{\i0}
Dialogue: 0,0:17:58.29,0:18:02.08,Default,,0,0,0,,{\i1}‎Trong thế giới này, có người làm được{\i0}\N{\i1}‎và có người không làm được.{\i0}
Dialogue: 0,0:18:03.88,0:18:05.67,Default,,0,0,0,,{\i1}‎Tớ là người không làm được.{\i0}
Dialogue: 0,0:18:07.04,0:18:08.62,Default,,0,0,0,,‎"Đừng quyết định nếu cậu không làm được!
Dialogue: 0,0:18:10.29,0:18:11.67,Default,,0,0,0,,‎Cậu biết rõ...
Dialogue: 0,0:18:13.42,0:18:15.09,Default,,0,0,0,,‎Cậu chỉ không muốn thất bại".
Dialogue: 0,0:18:15.17,0:18:16.50,Default,,0,0,0,,‎SHINO
Dialogue: 0,0:18:17.38,0:18:18.26,Default,,0,0,0,,‎"Nhưng...
Dialogue: 0,0:18:19.67,0:18:23.46,Default,,0,0,0,,‎Cậu không thể nào\N‎biết được kết quả nếu không thử".
Dialogue: 0,0:18:27.46,0:18:29.50,Default,,0,0,0,,‎Cảm ơn cô rất nhiều.
Dialogue: 0,0:18:29.58,0:18:30.87,Default,,0,0,0,,‎Cảm ơn rất nhiều.
Dialogue: 0,0:18:33.13,0:18:34.38,Default,,0,0,0,,‎Cô ấy giỏi đấy.
Dialogue: 0,0:18:35.42,0:18:37.88,Default,,0,0,0,,‎Tiếp theo, cô Haruna Honma.
Dialogue: 0,0:18:38.58,0:18:39.41,Default,,0,0,0,,‎Vâng ạ.
Dialogue: 0,0:18:52.58,0:18:54.66,Default,,0,0,0,,{\i1}‎Tớ là người không làm được.{\i0}
Dialogue: 0,0:18:56.00,0:18:57.75,Default,,0,0,0,,‎"Đừng quyết định nếu cậu không làm được.
Dialogue: 0,0:18:58.83,0:19:00.62,Default,,0,0,0,,‎Cậu biết rõ...
Dialogue: 0,0:19:01.88,0:19:04.13,Default,,0,0,0,,‎Cậu chỉ không muốn thất bại.
Dialogue: 0,0:19:05.58,0:19:06.66,Default,,0,0,0,,‎Nhưng...
Dialogue: 0,0:19:07.46,0:19:11.54,Default,,0,0,0,,‎cậu không thể nào\N‎biết được kết quả nếu không thử".
Dialogue: 0,0:19:32.42,0:19:33.92,Default,,0,0,0,,‎Cảm ơn rất nhiều.
Dialogue: 0,0:19:35.71,0:19:37.04,Default,,0,0,0,,‎Đợi đã. Một lần nữa.
Dialogue: 0,0:19:39.00,0:19:42.88,Default,,0,0,0,,‎Xin hãy bắt đầu lại từ trang hai.\N‎Lần này hạ giọng xuống một chút.
Dialogue: 0,0:19:42.96,0:19:43.84,Default,,0,0,0,,‎Cô làm được chứ?
Dialogue: 0,0:19:45.42,0:19:47.92,Default,,0,0,0,,‎Vâng. Tôi sẽ cố gắng.
Dialogue: 0,0:19:48.00,0:19:50.50,Default,,0,0,0,,‎- Xin bắt đầu từ đầu.\N‎- Vâng.
Dialogue: 0,0:19:56.42,0:19:57.96,Default,,0,0,0,,‎Cảm ơn rất nhiều.
Dialogue: 0,0:19:58.79,0:20:00.17,Default,,0,0,0,,‎Tôi rất hy vọng ở cô.
Dialogue: 0,0:20:00.25,0:20:01.25,Default,,0,0,0,,‎Tôi sẽ cố hết sức.
Dialogue: 0,0:20:02.00,0:20:03.42,Default,,0,0,0,,‎Cảm ơn nhiều!
Dialogue: 0,0:20:03.50,0:20:04.88,Default,,0,0,0,,‎Tiếp tục làm tốt nhé.
Dialogue: 0,0:20:04.96,0:20:06.25,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:20:30.25,0:20:31.75,Default,,0,0,0,,‎Chúc mừng cậu, Haruna.
Dialogue: 0,0:20:33.17,0:20:34.30,Default,,0,0,0,,‎Cậu rất tuyệt.
Dialogue: 0,0:20:36.08,0:20:37.75,Default,,0,0,0,,‎Tớ chỉ muốn nói thế.
Dialogue: 0,0:20:42.00,0:20:43.13,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:20:44.75,0:20:46.00,Default,,0,0,0,,‎Nhưng tớ không giỏi đến thế.
Dialogue: 0,0:20:46.92,0:20:50.13,Default,,0,0,0,,‎Tớ lồng tiếng bằng cảm xúc của mình,\N‎chứ không phải của nhân vật.
Dialogue: 0,0:20:50.79,0:20:52.50,Default,,0,0,0,,‎Cậu cần thể hiện điều đó\N‎thật chuyên nghiệp.
Dialogue: 0,0:20:54.67,0:20:58.75,Default,,0,0,0,,‎Nhưng tớ rất vui vì cậu được nhận vai.
Dialogue: 0,0:21:04.63,0:21:05.51,Default,,0,0,0,,‎Không đúng.
Dialogue: 0,0:21:07.29,0:21:10.04,Default,,0,0,0,,‎Tớ rất thất vọng!
Dialogue: 0,0:21:14.25,0:21:18.38,Default,,0,0,0,,‎Tớ sẽ cố gắng nhiều hơn để đuổi kịp cậu.
Dialogue: 0,0:21:24.04,0:21:25.12,Default,,0,0,0,,‎Tớ xin lỗi.
Dialogue: 0,0:21:28.33,0:21:29.33,Default,,0,0,0,,‎Chuyện gì?
Dialogue: 0,0:21:33.50,0:21:35.29,Default,,0,0,0,,‎Tớ từng rất ghen tị với cậu, Akina.
Dialogue: 0,0:21:38.04,0:21:40.04,Default,,0,0,0,,‎Ta từng là bạn tốt của nhau\N‎trong thời gian dài.
Dialogue: 0,0:21:41.25,0:21:43.88,Default,,0,0,0,,‎Lẽ ra tớ nên vui mừng mới phải.
Dialogue: 0,0:21:49.42,0:21:53.67,Default,,0,0,0,,‎Ta đều có tương lai phía trước mà.
Dialogue: 0,0:22:05.08,0:22:06.37,Default,,0,0,0,,‎Cảm ơn cậu.
Dialogue: 0,0:22:13.79,0:22:16.54,Default,,0,0,0,,‎Giờ tớ phải đi rồi.
Dialogue: 0,0:22:18.58,0:22:19.41,Default,,0,0,0,,‎Được.
Dialogue: 0,0:22:21.63,0:22:23.42,Default,,0,0,0,,‎Gặp cậu sau. Tạm biệt.
Dialogue: 0,0:22:23.50,0:22:24.88,Default,,0,0,0,,‎Tạm biệt.
Dialogue: 0,0:22:36.04,0:22:38.08,Default,,0,0,0,,{\i1}‎Cậu chỉ không muốn thất bại.{\i0}
Dialogue: 0,0:22:38.71,0:22:43.71,Default,,0,0,0,,{\i1}‎Nhưng cậu chẳng thể nào biết được{\i0}\N{\i1}‎kết quả nếu không thử.{\i0}
Dialogue: 0,0:22:47.00,0:22:47.88,Default,,0,0,0,,{\i1}‎Vâng.{\i0}
Dialogue: 0,0:22:49.00,0:22:52.33,Default,,0,0,0,,{\i1}‎Thần chú Phật Dược Sư.{\i0}
Dialogue: 0,0:23:02.71,0:23:04.79,Default,,0,0,0,,‎Làm tốt lắm!
Dialogue: 0,0:23:04.88,0:23:07.92,Default,,0,0,0,,‎Tôi thường không xem hoạt hình,\N‎nhưng phim này hay lắm.
Dialogue: 0,0:23:08.50,0:23:09.88,Default,,0,0,0,,‎Nhưng màn hình nhỏ thật.
Dialogue: 0,0:23:13.00,0:23:14.38,Default,,0,0,0,,‎Của hai cô đây.
Dialogue: 0,0:23:17.50,0:23:19.50,Default,,0,0,0,,‎Mì udon đậu phụ rán của ông chủ...
Dialogue: 0,0:23:19.58,0:23:22.37,Default,,0,0,0,,‎- Đã mang lại may mắn cho chúng ta.\N‎- Ừ.
Dialogue: 0,0:23:23.08,0:23:25.12,Default,,0,0,0,,‎Ông chủ, cảm ơn ông rất nhiều vì điều đó.
Dialogue: 0,0:23:26.08,0:23:26.91,Default,,0,0,0,,‎Không phải tôi.
Dialogue: 0,0:23:27.63,0:23:29.09,Default,,0,0,0,,‎Cả hai cô đã rất nỗ lực.
Dialogue: 0,0:23:30.38,0:23:32.71,Default,,0,0,0,,‎Tôi là người đầu tiên mời hai cô món này.
Dialogue: 0,0:23:32.79,0:23:35.92,Default,,0,0,0,,‎Nếu trong phỏng vấn có hỏi\N‎chuyện này, nhớ nhắc đến tôi.
Dialogue: 0,0:23:36.00,0:23:37.04,Default,,0,0,0,,‎- Vâng.\N‎- Vâng.
Dialogue: 0,0:23:37.13,0:23:40.63,Default,,0,0,0,,‎Thấy chưa. Đã bảo,\N‎"Không có chuyện ăn miễn phí đâu".
Dialogue: 0,0:23:42.29,0:23:45.12,Default,,0,0,0,,‎Anh nghiêm túc thật.\N‎Tôi chỉ đang đùa thôi.
Dialogue: 0,0:23:45.21,0:23:47.34,Default,,0,0,0,,‎Ăn thôi kẻo mì trương lên.
Dialogue: 0,0:23:49.00,0:23:50.46,Default,,0,0,0,,‎- Cảm ơn!\N‎- Cảm ơn!
Dialogue: 0,0:23:51.75,0:23:52.88,Default,,0,0,0,,‎Của hai cô đây.
Dialogue: 0,0:23:52.96,0:23:54.13,Default,,0,0,0,,‎- Cảm ơn nhiều ạ.\N‎- Cảm ơn nhiều ạ.
Dialogue: 0,0:23:54.75,0:23:56.13,Default,,0,0,0,,{\i1}‎Với đậu phụ rán,{\i0}
Dialogue: 0,0:23:56.21,0:23:59.67,Default,,0,0,0,,{\i1}‎bạn cần loại bỏ dầu thừa{\i0}\N{\i1}‎bằng cách ép chặt vào một tờ giấy.{\i0}
Dialogue: 0,0:23:59.75,0:24:01.42,Default,,0,0,0,,{\i1}‎Nếu nấu nó với đủ gia vị,{\i0}
Dialogue: 0,0:24:01.50,0:24:04.33,Default,,0,0,0,,{\i1}‎nước đậu hòa vào canh{\i0}\N{\i1}‎khiến món mì thơm ngon.{\i0}
Dialogue: 0,0:24:05.00,0:24:06.00,Default,,0,0,0,,‎Của hai cô đây.
Dialogue: 0,0:24:10.08,0:24:11.62,Default,,0,0,0,,‎Ôi trời...
Dialogue: 0,0:24:11.71,0:24:14.13,Default,,0,0,0,,‎Ông chủ, ông có ý tưởng gì hay không?
Dialogue: 0,0:24:14.21,0:24:15.46,Default,,0,0,0,,‎Lại gặp khủng hoảng khác à?
Dialogue: 0,0:24:15.54,0:24:19.00,Default,,0,0,0,,‎Đừng nói thế.\N‎Phải đau khổ mới viết được truyện hay.
Dialogue: 0,0:24:19.08,0:24:20.16,Default,,0,0,0,,‎Đúng không?
Dialogue: 0,0:24:24.04,0:24:25.17,Default,,0,0,0,,‎Hai cô đang làm gì thế?
Dialogue: 0,0:24:25.71,0:24:28.50,Default,,0,0,0,,‎Bọn tôi đang ước để anh có truyện hay.
Dialogue: 0,0:24:34.75,0:24:36.25,Default,,0,0,0,,‎- Ngủ ngon!\N‎- Ngủ ngon!
