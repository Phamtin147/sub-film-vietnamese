Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:13.00,0:01:17.42,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã ra về,{\i0}
Dialogue: 0,0:01:18.00,0:01:19.83,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:37.33,0:01:42.00,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:42.08,0:01:45.29,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:47.83,0:01:49.46,Default,,0,0,0,,‎COMBO CANH MISO THỊT HEO,\N‎BIA, RƯỢU SAKE, RƯỢU SHOCHU
Dialogue: 0,0:01:49.58,0:01:51.41,Default,,0,0,0,,{\i1}‎Chỉ có vậy trong thực đơn.{\i0}
Dialogue: 0,0:01:51.50,0:01:57.50,Default,,0,0,0,,{\i1}‎Nhưng tôi chế biến theo yêu cầu của khách,{\i0}\N{\i1}‎miễn là tôi có đủ nguyên liệu.{\i0}
Dialogue: 0,0:01:57.58,0:01:59.66,Default,,0,0,0,,{\i1}‎Đó là chính sách của tôi.{\i0}
Dialogue: 0,0:02:03.67,0:02:05.46,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:02:05.54,0:02:07.83,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:02:13.33,0:02:18.08,Default,,0,0,0,,‎ỨC GÀ CHIÊN PHÔ MAI
Dialogue: 0,0:03:00.46,0:03:02.88,Default,,0,0,0,,‎Xem cái này đi.
Dialogue: 0,0:03:02.96,0:03:05.17,Default,,0,0,0,,‎Không chắc nữa...
Dialogue: 0,0:03:05.25,0:03:07.75,Default,,0,0,0,,‎Lên kế hoạch cho cuối tuần này à?
Dialogue: 0,0:03:08.42,0:03:12.42,Default,,0,0,0,,‎Nghe nói có thầy bói rất được\N‎ở lối ra phía Đông.
Dialogue: 0,0:03:12.50,0:03:14.08,Default,,0,0,0,,‎Người ở trong con hẻm?
Dialogue: 0,0:03:14.17,0:03:15.75,Default,,0,0,0,,‎Chính là người đó!
Dialogue: 0,0:03:16.75,0:03:19.58,Default,,0,0,0,,‎- Anh biết sao?\N‎- Phải, tôi thấy họ xếp hàng dài.
Dialogue: 0,0:03:21.92,0:03:24.59,Default,,0,0,0,,‎Hai cô định hỏi về hôn nhân à?
Dialogue: 0,0:03:25.38,0:03:27.42,Default,,0,0,0,,‎Còn chuyện gì nữa chứ?
Dialogue: 0,0:03:27.50,0:03:29.04,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:03:29.13,0:03:31.21,Default,,0,0,0,,‎- Gà phô mai chiên xù.\N‎- Cảm ơn.
Dialogue: 0,0:03:32.63,0:03:35.80,Default,,0,0,0,,‎Anh có tin vào bói toán không?
Dialogue: 0,0:03:35.88,0:03:38.46,Default,,0,0,0,,‎Tôi á? Dù tôi có tin hay không,
Dialogue: 0,0:03:38.54,0:03:41.42,Default,,0,0,0,,‎thì cuộc sống\N‎vẫn cứ diễn ra như nó vốn vậy.
Dialogue: 0,0:03:41.50,0:03:43.04,Default,,0,0,0,,‎Đồng ý.
Dialogue: 0,0:03:43.13,0:03:45.09,Default,,0,0,0,,‎Dù sao cũng chưa từng đúng với tôi.
Dialogue: 0,0:03:45.17,0:03:49.30,Default,,0,0,0,,‎Tôi đoán ông Chu sẽ chỉ tin\N‎khi nó liên quan đến đua ngựa.
Dialogue: 0,0:03:49.38,0:03:51.80,Default,,0,0,0,,‎Tôi chỉ tham khảo nó thôi.
Dialogue: 0,0:03:51.88,0:03:54.88,Default,,0,0,0,,‎Nhiều phụ nữ thích bói toán, đúng không?
Dialogue: 0,0:03:54.96,0:03:58.67,Default,,0,0,0,,‎Tôi không tin đâu,\N‎nhưng có quan tâm chút ít.
Dialogue: 0,0:03:59.46,0:04:01.54,Default,,0,0,0,,‎Chẳng hạn mấy tín vật may mắn.
Dialogue: 0,0:04:01.63,0:04:04.92,Default,,0,0,0,,‎Để phòng hờ, tôi kiểm tra lá số tử vi\N‎của mình trên tivi và trong tạp chí.
Dialogue: 0,0:04:06.92,0:04:08.67,Default,,0,0,0,,‎- Còn anh, Yada?\N‎- Sao?
Dialogue: 0,0:04:09.83,0:04:11.46,Default,,0,0,0,,‎Tôi cho là...
Dialogue: 0,0:04:12.00,0:04:13.46,Default,,0,0,0,,‎tôi có tin vào nó.
Dialogue: 0,0:04:15.38,0:04:19.84,Default,,0,0,0,,{\i1}‎Anh Yada thường gọi{\i0}\N{\i1}‎món gà phô mai chiên xù.{\i0}
Dialogue: 0,0:04:20.67,0:04:25.96,Default,,0,0,0,,{\i1}‎Anh ta làm cho một công ty biên tập,{\i0}\N{\i1}‎và còn là nhà văn nữa.{\i0}
Dialogue: 0,0:04:32.42,0:04:34.05,Default,,0,0,0,,‎Hoan nghênh quý khách.
Dialogue: 0,0:04:34.13,0:04:36.21,Default,,0,0,0,,‎Anh có món gà phô mai chiên xù chứ?
Dialogue: 0,0:04:36.88,0:04:40.05,Default,,0,0,0,,‎Dĩ nhiên rồi. Thật ra, tôi vừa làm một ít.
Dialogue: 0,0:04:40.13,0:04:42.76,Default,,0,0,0,,‎Thật tốt quá. Cho tôi gọi món này.
Dialogue: 0,0:04:42.83,0:04:43.66,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:45.92,0:04:46.80,Default,,0,0,0,,‎Hikaru!
Dialogue: 0,0:04:46.88,0:04:48.96,Default,,0,0,0,,‎Cô thuộc cung Bảo Bình, đúng chứ?
Dialogue: 0,0:04:49.04,0:04:49.96,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:04:54.21,0:04:57.21,Default,,0,0,0,,‎Nhìn này, tín vật may mắn\N‎của cung Bảo Bình!
Dialogue: 0,0:04:59.08,0:05:01.25,Default,,0,0,0,,‎Gà phô mai chiên xù.
Dialogue: 0,0:05:04.96,0:05:08.88,Default,,0,0,0,,‎Điều đó nghĩa là...\N‎Anh cũng thế sao, Yada?
Dialogue: 0,0:05:10.08,0:05:11.50,Default,,0,0,0,,‎Không, đây chỉ là...
Dialogue: 0,0:05:13.63,0:05:15.05,Default,,0,0,0,,‎Bị các cô phát hiện rồi.
Dialogue: 0,0:05:18.63,0:05:21.26,Default,,0,0,0,,‎CUNG BẢO BÌNH
Dialogue: 0,0:05:22.75,0:05:25.83,Default,,0,0,0,,‎Đàn ông đâu đọc mấy thứ như vậy.
Dialogue: 0,0:05:26.50,0:05:28.54,Default,,0,0,0,,‎Công ty tôi có đặt mua dài hạn.
Dialogue: 0,0:05:29.33,0:05:32.50,Default,,0,0,0,,‎Tôi đã đọc tạp chí đó từ thời trung học.
Dialogue: 0,0:05:32.58,0:05:35.96,Default,,0,0,0,,‎Thầy Osanai rất tuyệt vời.\N‎Ông ấy luôn nói đúng.
Dialogue: 0,0:05:36.04,0:05:37.54,Default,,0,0,0,,‎Đặc biệt là về tình yêu.
Dialogue: 0,0:05:38.25,0:05:39.42,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:05:42.13,0:05:46.01,Default,,0,0,0,,‎Hai người chúng ta cung Bảo Bình\N‎gặp nhau hẳn là có duyên.
Dialogue: 0,0:05:46.08,0:05:47.16,Default,,0,0,0,,‎Rất vui được gặp cô.
Dialogue: 0,0:05:48.08,0:05:49.62,Default,,0,0,0,,‎Tôi cũng vậy.
Dialogue: 0,0:05:49.71,0:05:52.46,Default,,0,0,0,,‎Hãy ghé quán bar của tôi nếu anh muốn.
Dialogue: 0,0:05:54.00,0:05:54.96,Default,,0,0,0,,‎Đây.
Dialogue: 0,0:05:58.29,0:05:59.12,Default,,0,0,0,,‎Hikaru.
Dialogue: 0,0:06:16.46,0:06:20.00,Default,,0,0,0,,‎Anh Yada! Anh đến thật rồi!
Dialogue: 0,0:06:25.04,0:06:27.17,Default,,0,0,0,,‎- Gì thế?\N‎- Không có gì.
Dialogue: 0,0:06:29.42,0:06:31.71,Default,,0,0,0,,‎- Đây.\N‎- Anh mang theo nó à?
Dialogue: 0,0:06:32.71,0:06:34.96,Default,,0,0,0,,‎- Cô đọc rồi à?\N‎- Dĩ nhiên.
Dialogue: 0,0:06:35.04,0:06:38.17,Default,,0,0,0,,‎Nó nói cung Bảo Bình\N‎có thể gặp nhiều người mới.
Dialogue: 0,0:06:39.50,0:06:41.21,Default,,0,0,0,,‎- Whiskey pha nước nhé?\N‎- Vâng.
Dialogue: 0,0:06:46.96,0:06:51.34,Default,,0,0,0,,‎Anh là kiểu người rất hiếm đấy,\N‎đàn ông nhưng lại thích thuật tử vi.
Dialogue: 0,0:06:52.17,0:06:53.92,Default,,0,0,0,,‎Không phải tôi thích nhưng...
Dialogue: 0,0:06:54.79,0:06:58.96,Default,,0,0,0,,‎Có nhiều lúc ta chẳng thể\N‎kiểm soát được mọi việc, đúng không?
Dialogue: 0,0:06:59.96,0:07:01.71,Default,,0,0,0,,‎Tôi thích đọc những điều tích cực.
Dialogue: 0,0:07:02.54,0:07:04.62,Default,,0,0,0,,‎Tôi hiểu ý anh. Tôi cũng thế.
Dialogue: 0,0:07:09.38,0:07:11.09,Default,,0,0,0,,‎- Của anh đây.\N‎- Cảm ơn.
Dialogue: 0,0:07:15.38,0:07:21.05,Default,,0,0,0,,‎Tôi biết thầy Osanai lúc tôi 17 tuổi,
Dialogue: 0,0:07:21.13,0:07:26.38,Default,,0,0,0,,‎kể từ đó tôi đã luôn tin vào ông ấy,\N‎dù là về công việc hay tình yêu,
Dialogue: 0,0:07:26.46,0:07:28.46,Default,,0,0,0,,‎bất cứ khi nào tôi thấy lạc lõng.
Dialogue: 0,0:07:29.25,0:07:30.58,Default,,0,0,0,,‎Tôi hiểu.
Dialogue: 0,0:07:31.46,0:07:33.79,Default,,0,0,0,,‎"Gặp gỡ người mới."
Dialogue: 0,0:07:34.83,0:07:35.83,Default,,0,0,0,,‎Mong là ông ấy đúng.
Dialogue: 0,0:07:38.88,0:07:41.21,Default,,0,0,0,,‎Nhìn này.
Dialogue: 0,0:07:41.29,0:07:43.54,Default,,0,0,0,,‎Tín vật may mắn của ta là bánh táo.
Dialogue: 0,0:07:44.92,0:07:48.05,Default,,0,0,0,,‎- Anh biết chỗ nào ngon không?\N‎- Lẽ ra tôi nên đem theo.
Dialogue: 0,0:07:48.13,0:07:49.84,Default,,0,0,0,,‎Anh biết chỗ ngon à?
Dialogue: 0,0:07:49.92,0:07:53.13,Default,,0,0,0,,{\i1}‎Bạn có thể gọi đấy là số phận{\i0}\N{\i1}‎được bói toán đưa đẩy.{\i0}
Dialogue: 0,0:07:53.21,0:07:58.00,Default,,0,0,0,,{\i1}‎Anh Yada bắt đầu{\i0}\N{\i1}‎đến hộp đêm để gặp Hikaru.{\i0}
Dialogue: 0,0:08:04.33,0:08:07.79,Default,,0,0,0,,‎Thở dài chuyện gì thế?
Dialogue: 0,0:08:07.88,0:08:10.30,Default,,0,0,0,,‎Quanh chỗ này của tôi bị đau.
Dialogue: 0,0:08:11.17,0:08:13.84,Default,,0,0,0,,‎- Bị ợ nóng à?\N‎- Không, là chuyện yêu đương.
Dialogue: 0,0:08:15.08,0:08:17.46,Default,,0,0,0,,‎Nhiều năm rồi mới có lại cảm giác này.
Dialogue: 0,0:08:18.21,0:08:20.04,Default,,0,0,0,,‎Không sao vì tôi độc thân nhỉ?
Dialogue: 0,0:08:21.08,0:08:23.08,Default,,0,0,0,,‎Quý cô may mắn đó...
Dialogue: 0,0:08:24.04,0:08:26.17,Default,,0,0,0,,‎lẽ nào là cô Hikaru?
Dialogue: 0,0:08:29.17,0:08:32.71,Default,,0,0,0,,‎Ban ngày, cô ấy làm cho công ty thiết kế.
Dialogue: 0,0:08:32.79,0:08:36.21,Default,,0,0,0,,‎Ban đêm làm tiếp viên quán bar\N‎để trả nợ vay sinh viên.
Dialogue: 0,0:08:37.33,0:08:40.12,Default,,0,0,0,,‎Chắc cô ấy không xem tôi\N‎là đối tượng yêu đương.
Dialogue: 0,0:08:40.96,0:08:44.34,Default,,0,0,0,,‎Lá số tử vi nói thế nào?
Dialogue: 0,0:08:44.42,0:08:47.05,Default,,0,0,0,,‎Vị trí của ngôi sao giờ không tốt lắm.
Dialogue: 0,0:08:47.13,0:08:52.63,Default,,0,0,0,,‎Sao Hoả và sao Kim rất gần nhau,\N‎nên đàn ông Bảo Bình cần cực kỳ cẩn thận.
Dialogue: 0,0:08:52.71,0:08:54.54,Default,,0,0,0,,‎Thật đáng tiếc.
Dialogue: 0,0:08:55.88,0:08:58.71,Default,,0,0,0,,‎Hơn nữa, tôi không giỏi\N‎dự đoán cho bản thân.
Dialogue: 0,0:08:59.33,0:09:00.16,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:09:01.67,0:09:04.34,Default,,0,0,0,,‎Nói thật với anh,\N‎lá số tử vi là do tôi viết.
Dialogue: 0,0:09:05.88,0:09:06.76,Default,,0,0,0,,‎Sao hả?
Dialogue: 0,0:09:08.58,0:09:11.29,Default,,0,0,0,,‎Tôi biết cách\N‎khi viết bài cho tạp chí kinh tế.
Dialogue: 0,0:09:12.42,0:09:16.25,Default,,0,0,0,,‎Nhiều người làm cho các công ty lớn\N‎tin vào lá số tử vi,
Dialogue: 0,0:09:16.33,0:09:18.46,Default,,0,0,0,,‎nên tôi nghĩ chúng có thể\N‎giúp mở đầu câu chuyện.
Dialogue: 0,0:09:19.46,0:09:22.25,Default,,0,0,0,,‎Không biết là khi nào,\N‎tôi bắt đầu viết cho các tạp chí
Dialogue: 0,0:09:22.33,0:09:24.21,Default,,0,0,0,,‎dưới tên Kyoichiro Osanai.
Dialogue: 0,0:09:25.29,0:09:26.92,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:09:27.71,0:09:32.25,Default,,0,0,0,,‎Tôi chưa tiết lộ danh tính\N‎nên không ai biết đó là tôi cả.
Dialogue: 0,0:09:33.42,0:09:36.30,Default,,0,0,0,,‎Anh có nói cho Hikaru không?
Dialogue: 0,0:09:37.00,0:09:39.08,Default,,0,0,0,,‎Dĩ nhiên là không.
Dialogue: 0,0:09:39.17,0:09:43.63,Default,,0,0,0,,‎Cô ấy sẽ rất thất vọng nếu biết Osanai\N‎là người đàn ông trung niên tẻ nhạt.
Dialogue: 0,0:09:43.71,0:09:44.96,Default,,0,0,0,,‎Nên đừng nói cho cô ấy nhé?
Dialogue: 0,0:09:45.96,0:09:46.88,Default,,0,0,0,,‎Được.
Dialogue: 0,0:09:50.13,0:09:52.01,Default,,0,0,0,,‎Chào buổi tối.
Dialogue: 0,0:09:52.08,0:09:54.25,Default,,0,0,0,,‎- Hikaru!\N‎- Anh Yada.
Dialogue: 0,0:09:54.33,0:09:55.33,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:09:56.33,0:09:59.33,Default,,0,0,0,,‎Đây là Kikuchi,\N‎nhà thiết kế mà tôi đang làm cùng.
Dialogue: 0,0:10:00.04,0:10:01.87,Default,,0,0,0,,‎- Bia chứ?\N‎- Vâng.
Dialogue: 0,0:10:01.96,0:10:04.67,Default,,0,0,0,,‎Bia và gà phô mai chiên xù nhé.
Dialogue: 0,0:10:04.75,0:10:08.58,Default,,0,0,0,,‎Xin lỗi. Có thể cho thêm\N‎vài lá tía tô xanh được không?
Dialogue: 0,0:10:09.29,0:10:11.25,Default,,0,0,0,,‎- Có thể.\N‎- Làm ơn nhé.
Dialogue: 0,0:10:11.33,0:10:12.16,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:10:12.92,0:10:15.30,Default,,0,0,0,,‎Anh Kikuchi, sao anh biết thế?
Dialogue: 0,0:10:15.38,0:10:18.09,Default,,0,0,0,,‎Màu may mắn tháng này của tôi là màu xanh!
Dialogue: 0,0:10:18.17,0:10:20.80,Default,,0,0,0,,‎Thế ư? Tôi vừa nghĩ tới thôi.
Dialogue: 0,0:10:20.88,0:10:22.55,Default,,0,0,0,,‎Thật tuyệt!
Dialogue: 0,0:10:25.92,0:10:26.88,Default,,0,0,0,,‎Anh Yada.
Dialogue: 0,0:10:27.67,0:10:30.50,Default,,0,0,0,,‎Tử vi có nói\N‎người cung Bảo Bình sẽ yêu đương.
Dialogue: 0,0:10:31.17,0:10:32.30,Default,,0,0,0,,‎Đúng là thế thật!
Dialogue: 0,0:10:33.38,0:10:34.76,Default,,0,0,0,,‎Nhỉ?
Dialogue: 0,0:10:56.33,0:10:59.16,Default,,0,0,0,,{\i1}‎Hai tuần đã trôi qua.{\i0}
Dialogue: 0,0:11:02.00,0:11:04.38,Default,,0,0,0,,‎Cô thuộc cung Bảo Bình nhỉ? Xem này.
Dialogue: 0,0:11:05.21,0:11:08.54,Default,,0,0,0,,‎"Kết thúc mối tình tháng trước.\N‎Tử vi nói rằng nó sẽ sớm kết thúc."
Dialogue: 0,0:11:08.63,0:11:10.46,Default,,0,0,0,,‎Không linh cảm, không dự đoán.
Dialogue: 0,0:11:11.96,0:11:15.25,Default,,0,0,0,,‎"Cẩn thận lời nói dối của đàn ông.\N‎Anh ta có thể có vợ con rồi."
Dialogue: 0,0:11:15.33,0:11:16.46,Default,,0,0,0,,‎Không quan tâm.
Dialogue: 0,0:11:22.63,0:11:23.76,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:11:24.88,0:11:27.76,Default,,0,0,0,,‎Hikaru! Lâu rồi không gặp cô.
Dialogue: 0,0:11:32.25,0:11:33.42,Default,,0,0,0,,‎Sao thế?
Dialogue: 0,0:11:34.29,0:11:35.54,Default,,0,0,0,,‎Tôi bị lừa.
Dialogue: 0,0:11:38.04,0:11:39.12,Default,,0,0,0,,‎Anh ta...
Dialogue: 0,0:11:39.21,0:11:41.00,Default,,0,0,0,,‎có vợ và một con.
Dialogue: 0,0:11:41.08,0:11:42.87,Default,,0,0,0,,‎- Sao?\N‎- Gì hả?
Dialogue: 0,0:11:42.96,0:11:44.04,Default,,0,0,0,,‎Quá đúng luôn!
Dialogue: 0,0:11:50.58,0:11:53.87,Default,,0,0,0,,{\i1}‎Dĩ nhiên là thế rồi. Vì anh Yada...{\i0}
Dialogue: 0,0:11:54.63,0:11:55.46,Default,,0,0,0,,‎Của anh đây.
Dialogue: 0,0:11:58.17,0:12:00.80,Default,,0,0,0,,‎Tên Kikuchi đó không phải người tốt.
Dialogue: 0,0:12:01.54,0:12:05.71,Default,,0,0,0,,‎Không những đã kết hôn, có một con\N‎mà còn quen nhiều người khác ngoài Hikaru!
Dialogue: 0,0:12:06.29,0:12:07.67,Default,,0,0,0,,‎Tôi hiểu.
Dialogue: 0,0:12:07.75,0:12:09.83,Default,,0,0,0,,‎Anh biết hết vì xem lá số tử vi à?
Dialogue: 0,0:12:09.92,0:12:11.34,Default,,0,0,0,,‎Dĩ nhiên không phải.
Dialogue: 0,0:12:11.42,0:12:16.42,Default,,0,0,0,,‎Sau khi gặp anh ta ngày đó,\N‎tôi đã theo anh ta về nhà.
Dialogue: 0,0:12:17.17,0:12:19.55,Default,,0,0,0,,‎Vì tôi không thích vẻ ngoài của anh ta.
Dialogue: 0,0:12:20.46,0:12:23.25,Default,,0,0,0,,‎Anh Yada, anh còn xem được tướng mạo à?
Dialogue: 0,0:12:23.33,0:12:25.12,Default,,0,0,0,,‎Anh có thể nói vậy.
Dialogue: 0,0:12:25.21,0:12:30.50,Default,,0,0,0,,‎Vì tôi là nhà văn, nghiên cứu anh ta\N‎cũng đủ để viết thành sách.
Dialogue: 0,0:12:35.58,0:12:37.79,Default,,0,0,0,,‎Tôi hỏi anh ta sau khi đọc lá số tử vi.
Dialogue: 0,0:12:38.46,0:12:42.67,Default,,0,0,0,,‎Anh ta bảo, "Tôi không lừa em.\N‎Tôi chỉ không nói với em sự thật thôi."
Dialogue: 0,0:12:44.29,0:12:47.46,Default,,0,0,0,,‎Đúng là đồ khốn. Thật kinh khủng.
Dialogue: 0,0:12:47.54,0:12:52.33,Default,,0,0,0,,‎Nhưng biết được sự thật trước khi mọi\N‎chuyện tiến xa hơn không phải tốt hơn sao?
Dialogue: 0,0:12:53.42,0:12:54.25,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:12:55.96,0:12:59.46,Default,,0,0,0,,‎Dù sao thì,\N‎ông Kyoichiro Osanai quá giỏi đi.
Dialogue: 0,0:13:01.96,0:13:04.75,Default,,0,0,0,,‎Tôi không nghĩ\N‎mình có thể tin điều gì thêm nữa.
Dialogue: 0,0:13:07.04,0:13:09.96,Default,,0,0,0,,‎Tôi chắc không sống nổi\N‎nếu không có lá số tử vi.
Dialogue: 0,0:13:10.92,0:13:14.88,Default,,0,0,0,,{\i1}‎Kể cả sau đó,{\i0}\N{\i1}‎anh Yada tiếp tục dùng lá số tử vi{\i0}
Dialogue: 0,0:13:14.96,0:13:19.17,Default,,0,0,0,,{\i1}‎để gửi tin cho Hikaru{\i0}\N{\i1}‎mà không hề tiết lộ danh tính thật.{\i0}
Dialogue: 0,0:13:26.54,0:13:30.25,Default,,0,0,0,,{\i1}‎Mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã về nhà.{\i0}
Dialogue: 0,0:13:30.79,0:13:34.67,Default,,0,0,0,,{\i1}‎Nhưng đôi khi họ không muốn về nhà ngay,{\i0}
Dialogue: 0,0:13:34.75,0:13:37.29,Default,,0,0,0,,{\i1}‎nên ghé đâu đó trên đường về.{\i0}
Dialogue: 0,0:13:38.17,0:13:39.05,Default,,0,0,0,,‎ĐỒN CẢNH SÁT
Dialogue: 0,0:13:39.13,0:13:40.55,Default,,0,0,0,,‎"Người thuộc cung Bảo Bình,
Dialogue: 0,0:13:40.63,0:13:45.46,Default,,0,0,0,,‎bạn rất chín chắn\N‎và suy nghĩ lô-gíc về mọi chuyện.
Dialogue: 0,0:13:46.33,0:13:51.00,Default,,0,0,0,,‎Nhưng với người ở quanh bạn,\N‎chuyện này có vẻ là sự do dự."
Dialogue: 0,0:13:51.54,0:13:54.46,Default,,0,0,0,,‎Chắc nó đúng với tôi.
Dialogue: 0,0:13:54.54,0:13:58.17,Default,,0,0,0,,‎Phải đấy.\N‎Anh đôi lúc trông thiếu chín chắn.
Dialogue: 0,0:13:58.25,0:13:59.96,Default,,0,0,0,,‎- Thật ư?\N‎- Đúng thế.
Dialogue: 0,0:14:00.63,0:14:01.80,Default,,0,0,0,,‎Kế đến là tình yêu.
Dialogue: 0,0:14:02.58,0:14:07.62,Default,,0,0,0,,‎"Bạn có thể nhận thấy\N‎có người quanh bạn yêu thương bạn."
Dialogue: 0,0:14:23.46,0:14:26.42,Default,,0,0,0,,‎Cô thuộc cung gì, cô Izumi?
Dialogue: 0,0:14:26.50,0:14:30.13,Default,,0,0,0,,‎- Cung Xử Nữ.\N‎- Không đời nào. Chắc cô là cung Cự Giải.
Dialogue: 0,0:14:31.29,0:14:32.12,Default,,0,0,0,,‎Tại sao?
Dialogue: 0,0:14:32.21,0:14:34.29,Default,,0,0,0,,‎Vì lúc nào cô cũng gắt gỏng.
Dialogue: 0,0:14:35.79,0:14:37.67,Default,,0,0,0,,‎Ông chắc thuộc cung Thiên Bình nhỉ?
Dialogue: 0,0:14:38.92,0:14:39.92,Default,,0,0,0,,‎Tại sao thế?
Dialogue: 0,0:14:40.83,0:14:44.08,Default,,0,0,0,,‎- Vì lúc nào ông cũng lắc lư.\N‎- Lắc lư...
Dialogue: 0,0:14:45.54,0:14:47.96,Default,,0,0,0,,‎- Chào.\N‎- Ông Momi!
Dialogue: 0,0:14:49.42,0:14:51.21,Default,,0,0,0,,‎- Chào.\N‎- Chào.
Dialogue: 0,0:14:51.29,0:14:54.17,Default,,0,0,0,,‎- Ông muốn uống trà không?\N‎- Không, cảm ơn.
Dialogue: 0,0:14:54.25,0:14:57.17,Default,,0,0,0,,‎Nhận được tin mật nên tôi đến kiểm tra.
Dialogue: 0,0:14:59.71,0:15:02.34,Default,,0,0,0,,‎- Lá số tử vi?\N‎- Không, đó là...
Dialogue: 0,0:15:04.04,0:15:06.12,Default,,0,0,0,,‎Vũ trụ này rộng vô tận nhỉ?
Dialogue: 0,0:15:07.13,0:15:09.51,Default,,0,0,0,,‎Vậy sao chỉ có 12 cung hoàng đạo?
Dialogue: 0,0:15:10.88,0:15:12.26,Default,,0,0,0,,‎Một câu hỏi hay.
Dialogue: 0,0:15:13.25,0:15:16.29,Default,,0,0,0,,‎Quá hay! Nhiều điều tuyệt vời\N‎đang chờ đón bạn!
Dialogue: 0,0:15:21.75,0:15:22.92,Default,,0,0,0,,‎Tôi xin phép.
Dialogue: 0,0:15:26.46,0:15:28.54,Default,,0,0,0,,‎Xem cho tôi nữa nhé?
Dialogue: 0,0:15:29.58,0:15:31.79,Default,,0,0,0,,‎Mọi người đều làm thế.
Dialogue: 0,0:15:33.71,0:15:38.25,Default,,0,0,0,,‎Thầy bói có khi nào chịu trách nhiệm\N‎nếu họ tiên đoán sai không?
Dialogue: 0,0:15:40.96,0:15:42.42,Default,,0,0,0,,‎- Tôi...\N‎- Anh nghĩ sao?
Dialogue: 0,0:15:42.50,0:15:46.42,Default,,0,0,0,,‎- Tôi không rõ...\N‎- Hãy đợi xem.
Dialogue: 0,0:15:48.42,0:15:52.80,Default,,0,0,0,,‎QUÁN ĂN
Dialogue: 0,0:15:55.96,0:15:59.17,Default,,0,0,0,,‎Ba cô ăn vận như đèn giao thông à?
Dialogue: 0,0:16:01.54,0:16:05.33,Default,,0,0,0,,‎Thật khiếm nhã!\N‎Đây là màu tình yêu may mắn của chúng tôi.
Dialogue: 0,0:16:05.42,0:16:07.05,Default,,0,0,0,,‎Đúng không?
Dialogue: 0,0:16:08.54,0:16:11.21,Default,,0,0,0,,‎Là chuyện tốt\N‎nếu có đàn ông tiếp cận các cô.
Dialogue: 0,0:16:13.08,0:16:15.50,Default,,0,0,0,,‎À, mấy ngày nay tôi không thấy Hikaru.
Dialogue: 0,0:16:16.25,0:16:18.54,Default,,0,0,0,,‎Cô ấy cũng lâu rồi chưa đến đây.
Dialogue: 0,0:16:19.88,0:16:22.01,Default,,0,0,0,,‎Có vẻ cô ấy nghỉ việc tiếp viên rồi.
Dialogue: 0,0:16:22.75,0:16:25.25,Default,,0,0,0,,‎Anh có nghe gì về cô ấy không, Yada?
Dialogue: 0,0:16:25.83,0:16:26.79,Default,,0,0,0,,‎Không.
Dialogue: 0,0:16:28.63,0:16:32.01,Default,,0,0,0,,‎Chả biết cô ấy có còn đau lòng\N‎vì gã đó không nữa.
Dialogue: 0,0:16:32.08,0:16:34.04,Default,,0,0,0,,‎Cô ấy rất buồn bã vì chuyện đó.
Dialogue: 0,0:16:34.13,0:16:37.67,Default,,0,0,0,,‎Ừ, cô ấy có nói\N‎không thể sống nếu thiếu lá số tử vi.
Dialogue: 0,0:16:37.75,0:16:40.04,Default,,0,0,0,,‎Hẳn cô ấy đã mất niềm tin ở bản thân.
Dialogue: 0,0:16:40.75,0:16:44.83,Default,,0,0,0,,‎Người ta nói, "Hạnh phúc chỉ đến\N‎với những ai sẵn sàng chấp nhận nó."
Dialogue: 0,0:16:44.92,0:16:45.92,Default,,0,0,0,,‎Chắc...
Dialogue: 0,0:16:46.63,0:16:50.09,Default,,0,0,0,,‎Chẳng tốt đẹp gì\N‎nếu thầy bói của bạn nói quá đúng.
Dialogue: 0,0:16:52.54,0:16:55.08,Default,,0,0,0,,‎Bói toán là chuyện không thể nói trước.
Dialogue: 0,0:16:55.96,0:16:57.63,Default,,0,0,0,,‎Liên quan đến bói toán,
Dialogue: 0,0:16:57.71,0:17:00.42,Default,,0,0,0,,‎tốt nhất hãy chấp nhận\N‎câu chuyện có thể không đúng nhỉ?
Dialogue: 0,0:17:09.42,0:17:10.71,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:17:16.08,0:17:17.87,Default,,0,0,0,,‎- Đi đâu thế?\N‎- Sao?
Dialogue: 0,0:17:31.50,0:17:32.92,Default,,0,0,0,,‎Tôi nên làm gì đây?
Dialogue: 0,0:17:35.58,0:17:36.54,Default,,0,0,0,,‎Về chuyện gì?
Dialogue: 0,0:17:37.33,0:17:38.62,Default,,0,0,0,,‎Hikaru.
Dialogue: 0,0:17:39.92,0:17:42.05,Default,,0,0,0,,‎Tôi đã làm sai gì à?
Dialogue: 0,0:17:43.33,0:17:44.46,Default,,0,0,0,,‎Anh Yada...
Dialogue: 0,0:17:45.25,0:17:48.04,Default,,0,0,0,,‎Anh thường gọi gà phô mai chiên xù nhỉ?
Dialogue: 0,0:17:48.67,0:17:49.50,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:17:50.17,0:17:52.50,Default,,0,0,0,,‎- Tại sao?\N‎- "Tại sao"?
Dialogue: 0,0:17:53.50,0:17:55.04,Default,,0,0,0,,‎Vì tôi thích.
Dialogue: 0,0:17:55.75,0:17:59.33,Default,,0,0,0,,‎Anh ăn nó vì anh thích.\N‎Mọi chuyện diễn ra như thế nhỉ?
Dialogue: 0,0:18:00.42,0:18:04.50,Default,,0,0,0,,‎Sao anh không thử sống thật\N‎với cảm xúc của mình dù chỉ một lần?
Dialogue: 0,0:18:05.67,0:18:07.30,Default,,0,0,0,,‎Thật vô lý.
Dialogue: 0,0:18:17.54,0:18:20.75,Default,,0,0,0,,{\i1}‎Hai tuần nữa trôi qua sau ngày đó.{\i0}
Dialogue: 0,0:18:21.83,0:18:23.62,Default,,0,0,0,,‎"Với người cung Bảo Bình.
Dialogue: 0,0:18:24.33,0:18:28.04,Default,,0,0,0,,‎Một người quan trọng khác giới\N‎sẽ xuất hiện trước mặt bạn
Dialogue: 0,0:18:28.13,0:18:29.71,Default,,0,0,0,,‎mặc áo thun sọc ngang.
Dialogue: 0,0:18:29.79,0:18:32.79,Default,,0,0,0,,‎Người này có thể là\N‎tình yêu chân chính của bạn."
Dialogue: 0,0:18:32.88,0:18:34.46,Default,,0,0,0,,‎Áo thun sọc ngang...
Dialogue: 0,0:18:34.54,0:18:38.08,Default,,0,0,0,,‎Áo sọc xanh nền trắng à?\N‎Hay sọc đỏ? Còn chiều rộng thì sao?
Dialogue: 0,0:18:43.92,0:18:45.75,Default,,0,0,0,,‎Hikaru! Lâu rồi không gặp!
Dialogue: 0,0:18:46.50,0:18:48.00,Default,,0,0,0,,‎- Chào.\N‎- Hoan nghênh.
Dialogue: 0,0:18:48.63,0:18:50.67,Default,,0,0,0,,‎Xin lỗi đột ngột hẹn cô ra ngoài.
Dialogue: 0,0:18:50.75,0:18:52.13,Default,,0,0,0,,‎Không sao.
Dialogue: 0,0:18:52.79,0:18:55.29,Default,,0,0,0,,‎Gà phô mai chiên xù luôn nhé.
Dialogue: 0,0:18:55.38,0:18:56.21,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:18:59.79,0:19:02.08,Default,,0,0,0,,‎- Anh muốn nói về chuyện gì?\N‎- À thì...
Dialogue: 0,0:19:02.92,0:19:04.96,Default,,0,0,0,,‎Mời cô uống trước đã.
Dialogue: 0,0:19:05.04,0:19:08.17,Default,,0,0,0,,‎Ông Kyoichiro Osanai này là ai thế nhỉ?
Dialogue: 0,0:19:08.75,0:19:10.33,Default,,0,0,0,,‎Có phải mỗi tôi thấy
Dialogue: 0,0:19:10.42,0:19:13.34,Default,,0,0,0,,‎ông ta gần đây\N‎đặc biệt quan tâm đến cung Bảo Bình không?
Dialogue: 0,0:19:13.42,0:19:17.25,Default,,0,0,0,,‎- Đúng thế.\N‎- Nhưng chẳng có gì đúng với tôi cả.
Dialogue: 0,0:19:17.33,0:19:19.41,Default,,0,0,0,,‎Nhưng đúng với cô chứ, Hikaru?
Dialogue: 0,0:19:21.67,0:19:25.21,Default,,0,0,0,,‎Tôi ổn. Không phải\N‎lỗi của lá số tử vi đâu.
Dialogue: 0,0:19:26.21,0:19:27.50,Default,,0,0,0,,‎Xin lỗi.
Dialogue: 0,0:19:27.58,0:19:29.46,Default,,0,0,0,,‎Không sao, thật đấy.
Dialogue: 0,0:19:29.54,0:19:30.87,Default,,0,0,0,,‎Đừng bận tâm tới tôi.
Dialogue: 0,0:19:37.71,0:19:38.79,Default,,0,0,0,,‎Hikaru...
Dialogue: 0,0:19:39.83,0:19:41.71,Default,,0,0,0,,‎con người cô hoàn hảo rồi.
Dialogue: 0,0:19:42.67,0:19:46.38,Default,,0,0,0,,‎Người cung Bảo Bình có xu hướng\N‎quá lô-gíc nên cô phải cẩn thận,
Dialogue: 0,0:19:47.38,0:19:49.55,Default,,0,0,0,,‎nhưng nếu sống thật với cảm xúc của mình,
Dialogue: 0,0:19:49.63,0:19:52.80,Default,,0,0,0,,‎chắc chắn cô sẽ gặp được\N‎người yêu cô chân thành.
Dialogue: 0,0:19:53.50,0:19:54.42,Default,,0,0,0,,‎Không...
Dialogue: 0,0:19:55.00,0:19:58.17,Default,,0,0,0,,‎Có thể cô đã gặp rồi, nhưng không biết.
Dialogue: 0,0:19:59.33,0:20:00.37,Default,,0,0,0,,‎Anh Yada...
Dialogue: 0,0:20:04.33,0:20:05.46,Default,,0,0,0,,‎Áo sọc ngang!
Dialogue: 0,0:20:06.08,0:20:07.33,Default,,0,0,0,,‎Vậy, Hikaru, tôi...
Dialogue: 0,0:20:07.96,0:20:09.04,Default,,0,0,0,,‎Nếu cô thích, tôi muốn cô...
Dialogue: 0,0:20:10.42,0:20:11.34,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:20:12.17,0:20:13.09,Default,,0,0,0,,‎Áo sọc ngang!
Dialogue: 0,0:20:20.46,0:20:23.50,Default,,0,0,0,,‎Xem nào... Cho tôi phần canh thịt heo.
Dialogue: 0,0:20:23.58,0:20:25.16,Default,,0,0,0,,‎Thêm một chai bia nữa.
Dialogue: 0,0:20:25.25,0:20:26.33,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:20:26.42,0:20:27.34,Default,,0,0,0,,‎Hikaru?
Dialogue: 0,0:20:28.29,0:20:29.25,Default,,0,0,0,,‎Hikaru!
Dialogue: 0,0:20:30.29,0:20:32.71,Default,,0,0,0,,‎Anh có đọc lá số tử vi à?
Dialogue: 0,0:20:33.79,0:20:34.62,Default,,0,0,0,,‎Sao?
Dialogue: 0,0:20:35.25,0:20:37.04,Default,,0,0,0,,‎Sao anh lại mặc áo sọc ngang?
Dialogue: 0,0:20:38.17,0:20:42.55,Default,,0,0,0,,‎Đồ tôi giặt chưa khô,\N‎và chỉ còn mỗi áo này để mặc.
Dialogue: 0,0:20:49.54,0:20:51.25,Default,,0,0,0,,‎Đúng là số phận!
Dialogue: 0,0:20:52.00,0:20:55.46,Default,,0,0,0,,‎Dự đoán của Kyoichiro Osanai\N‎quả đúng là đặc biệt!
Dialogue: 0,0:21:03.04,0:21:04.08,Default,,0,0,0,,‎Anh Yada!
Dialogue: 0,0:21:06.71,0:21:08.92,Default,,0,0,0,,‎Anh không nên dựa vào lá số tử vi.
Dialogue: 0,0:21:09.00,0:21:12.29,Default,,0,0,0,,‎Tín vật may mắn của tôi\N‎chưa từng đem lại may mắn dù chỉ một lần.
Dialogue: 0,0:21:12.96,0:21:14.75,Default,,0,0,0,,‎Hãy đi uống thêm nào.
Dialogue: 0,0:21:42.63,0:21:44.71,Default,,0,0,0,,{\i1}‎Quấn phô mai trong ức gà,{\i0}
Dialogue: 0,0:21:44.79,0:21:47.17,Default,,0,0,0,,{\i1}‎và rắc đều bột chiên xù lên.{\i0}
Dialogue: 0,0:21:47.25,0:21:52.00,Default,,0,0,0,,{\i1}‎Hãy cẩn thận để phô mai{\i0}\N{\i1}‎không tan và chảy ra ngoài khi chiên.{\i0}
Dialogue: 0,0:21:52.96,0:21:57.17,Default,,0,0,0,,‎Thử thêm mận, trứng cá tuyết,\N‎lá rong biển khô nếu muốn.
Dialogue: 0,0:21:57.25,0:21:58.71,Default,,0,0,0,,‎- Của anh đây.\N‎- Cảm ơn.
Dialogue: 0,0:22:01.04,0:22:02.12,Default,,0,0,0,,‎Hikaru.
Dialogue: 0,0:22:02.92,0:22:05.84,Default,,0,0,0,,‎Thật ra, tôi là người\N‎viết bài về lá số tử vi.
Dialogue: 0,0:22:08.17,0:22:10.21,Default,,0,0,0,,‎Tôi không thích người nói dối.
Dialogue: 0,0:22:15.46,0:22:16.75,Default,,0,0,0,,‎Chúc ngủ ngon.
Dialogue: 0,0:23:50.00,0:23:52.83,Default,,0,0,0,,‎ĐÂY LÀ CÂU CHUYỆN HƯ CẤU
Dialogue: 0,0:23:52.92,0:23:54.92,Default,,0,0,0,,‎Biên dịch: Hiền Phạm
