Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,‎LOẠT PHIM CỦA NETFLIX
Dialogue: 0,0:01:04.46,0:01:08.75,Default,,0,0,0,,{\i1}‎Khi mọi người kết thúc ngày làm việc{\i0}\N{\i1}‎và vội vã ra về,{\i0}
Dialogue: 0,0:01:09.46,0:01:11.13,Default,,0,0,0,,{\i1}‎là lúc ngày của tôi bắt đầu.{\i0}
Dialogue: 0,0:01:28.67,0:01:32.80,Default,,0,0,0,,{\i1}‎Quán ăn của tôi mở cửa{\i0}\N{\i1}‎từ nửa đêm đến 7:00 sáng.{\i0}
Dialogue: 0,0:01:33.33,0:01:36.37,Default,,0,0,0,,{\i1}‎Khách hàng gọi nó là "Quán Ăn Đêm".{\i0}
Dialogue: 0,0:01:42.13,0:01:43.55,Default,,0,0,0,,{\i1}‎Tôi có khách hàng không á?{\i0}
Dialogue: 0,0:01:44.21,0:01:46.04,Default,,0,0,0,,{\i1}‎Nhiều hơn bạn nghĩ đấy.{\i0}
Dialogue: 0,0:01:52.04,0:01:56.87,Default,,0,0,0,,‎CƠM NẮM MẬN MUỐI
Dialogue: 0,0:01:58.79,0:02:01.25,Default,,0,0,0,,‎Người đàn ông đó 60 tuổi\N‎và chuyển nghề làm nhân viên chăm sóc à?
Dialogue: 0,0:02:01.33,0:02:02.16,Default,,0,0,0,,‎Đúng thế.
Dialogue: 0,0:02:02.71,0:02:04.38,Default,,0,0,0,,‎Ông ấy từng viết bài cho tạp chí,
Dialogue: 0,0:02:04.96,0:02:06.92,Default,,0,0,0,,‎nhưng không có việc để làm nữa.
Dialogue: 0,0:02:07.58,0:02:09.91,Default,,0,0,0,,‎Ông ta thân với anh chứ?
Dialogue: 0,0:02:10.00,0:02:11.08,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:02:11.17,0:02:13.13,Default,,0,0,0,,‎Ông ấy từng mời tôi làm nhiều việc.
Dialogue: 0,0:02:15.75,0:02:19.46,Default,,0,0,0,,‎Dù sao thì công việc đó không dễ dàng gì.
Dialogue: 0,0:02:20.00,0:02:21.63,Default,,0,0,0,,‎Ông ta đủ sức khoẻ chứ?
Dialogue: 0,0:02:22.38,0:02:26.21,Default,,0,0,0,,‎Khách của ông ta thường trêu,\N‎"Một lão già chăm sóc một lão già."
Dialogue: 0,0:02:26.96,0:02:30.21,Default,,0,0,0,,‎Thức ăn đây. Mực đom đóm\N‎trộn với giấm và tương miso,
Dialogue: 0,0:02:30.29,0:02:31.58,Default,,0,0,0,,‎và mực ngâm giấm.
Dialogue: 0,0:02:34.00,0:02:39.63,Default,,0,0,0,,‎Mùa xuân đến rồi.\N‎Tôi chỉ muốn thấy yên ổn khi còn sống.
Dialogue: 0,0:02:41.42,0:02:42.80,Default,,0,0,0,,‎Một ly sake lạnh nữa.
Dialogue: 0,0:02:42.88,0:02:43.84,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:02:46.83,0:02:50.66,Default,,0,0,0,,‎Loài nào phát sáng hơn,\N‎đom đóm hay mực đom đóm?
Dialogue: 0,0:02:51.29,0:02:54.37,Default,,0,0,0,,‎Mực đom đóm.\N‎Đom đóm chỉ phát sáng ở mông thôi.
Dialogue: 0,0:02:55.63,0:03:00.84,Default,,0,0,0,,‎Dù là loài nào, chúng cũng không\N‎làm sáng tỏ quá khứ của ta.
Dialogue: 0,0:03:04.13,0:03:05.67,Default,,0,0,0,,‎Ngon đúng không?
Dialogue: 0,0:03:06.96,0:03:10.46,Default,,0,0,0,,‎Thật ra, tôi thấy chán nản\N‎khi nghĩ về những ngày sau nghỉ hưu.
Dialogue: 0,0:03:11.58,0:03:13.71,Default,,0,0,0,,‎Ông nghỉ hưu rồi mà, đúng không?
Dialogue: 0,0:03:17.42,0:03:18.71,Default,,0,0,0,,‎Này, của tôi mà!
Dialogue: 0,0:03:22.38,0:03:25.92,Default,,0,0,0,,‎Không phải sẽ tốt hơn nếu anh\N‎cạo đầu và có mái đầu bóng loáng à?
Dialogue: 0,0:03:26.00,0:03:28.71,Default,,0,0,0,,‎Ông cũng thế!\N‎Đội mũ để giấu cái đầu hói thôi!
Dialogue: 0,0:03:28.79,0:03:30.37,Default,,0,0,0,,‎Thế này gọi là thời trang!
Dialogue: 0,0:03:30.92,0:03:31.96,Default,,0,0,0,,‎Hợp thời trang.
Dialogue: 0,0:03:32.71,0:03:35.50,Default,,0,0,0,,‎- Ôi trời.\N‎- Chuyện gì...
Dialogue: 0,0:03:35.58,0:03:36.79,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:03:37.79,0:03:41.17,Default,,0,0,0,,‎Xin lỗi, tôi có câu này muốn hỏi.
Dialogue: 0,0:03:41.96,0:03:47.04,Default,,0,0,0,,‎Shinjuku New Art ở quanh đây phải không?
Dialogue: 0,0:03:47.13,0:03:49.55,Default,,0,0,0,,‎Nó ở ngay kia, nhưng giờ đã đóng cửa rồi.
Dialogue: 0,0:03:50.13,0:03:51.63,Default,,0,0,0,,‎Nó đóng cửa vào nửa đêm.
Dialogue: 0,0:03:52.21,0:03:55.59,Default,,0,0,0,,‎Nếu ông muốn xem "chỗ ấy" của phụ nữ\N‎thì có thể đến chỗ khác ở đằng kia.
Dialogue: 0,0:03:55.67,0:03:57.34,Default,,0,0,0,,‎Không sao chứ?
Dialogue: 0,0:03:57.42,0:03:58.67,Default,,0,0,0,,‎Ông ổn cả chứ?
Dialogue: 0,0:04:18.71,0:04:21.34,Default,,0,0,0,,{\i1}‎Chúng tôi có mận muối cỡ thường và cỡ nhỏ,{\i0}
Dialogue: 0,0:04:21.42,0:04:24.96,Default,,0,0,0,,{\i1}‎nhưng ông ấy muốn mận cỡ nhỏ.{\i0}
Dialogue: 0,0:04:26.58,0:04:30.62,Default,,0,0,0,,‎Nếu đến New Art trước buổi trưa,\N‎ông có thể được giảm giá.
Dialogue: 0,0:04:31.96,0:04:33.17,Default,,0,0,0,,‎Vậy ư?
Dialogue: 0,0:04:35.67,0:04:36.88,Default,,0,0,0,,‎Cho tôi thêm nhé?
Dialogue: 0,0:04:37.88,0:04:38.88,Default,,0,0,0,,‎Dĩ nhiên rồi.
Dialogue: 0,0:04:52.50,0:04:55.25,Default,,0,0,0,,{\i1}‎Tôi từng nghe về mụ phù thủy{\i0}\N{\i1}‎có nhiều nếp nhăn như mận muối,{\i0}
Dialogue: 0,0:04:55.92,0:04:58.71,Default,,0,0,0,,{\i1}‎nhưng ông già với nhiều nếp nhăn thì chưa.{\i0}
Dialogue: 0,0:05:01.08,0:05:07.00,Default,,0,0,0,,‎Các cháu tìm thấy thứ này\N‎ở công viên thị trấn Yomogi à?
Dialogue: 0,0:05:07.75,0:05:09.54,Default,,0,0,0,,‎Ai tìm thấy vậy?
Dialogue: 0,0:05:09.63,0:05:10.67,Default,,0,0,0,,‎- Là cậu ấy.\N‎- Gì?
Dialogue: 0,0:05:10.75,0:05:11.63,Default,,0,0,0,,‎Là cậu ta nhỉ?
Dialogue: 0,0:05:11.71,0:05:13.29,Default,,0,0,0,,‎Không, là cậu mà!
Dialogue: 0,0:05:13.38,0:05:15.51,Default,,0,0,0,,‎- Không!\N‎- Đợi đã.
Dialogue: 0,0:05:15.58,0:05:18.33,Default,,0,0,0,,‎Chú cần nói chuyện với bố mẹ các cháu,
Dialogue: 0,0:05:18.42,0:05:21.59,Default,,0,0,0,,‎vì người tìm thấy thứ này\N‎có quyền nhận phần thưởng.
Dialogue: 0,0:05:21.67,0:05:22.50,Default,,0,0,0,,‎- Tuyệt!\N‎- Là cháu!
Dialogue: 0,0:05:22.58,0:05:23.58,Default,,0,0,0,,‎Gần quá rồi.
Dialogue: 0,0:05:23.67,0:05:26.00,Default,,0,0,0,,‎Bọn cháu có thể nhận tiền chứ?
Dialogue: 0,0:05:26.08,0:05:28.37,Default,,0,0,0,,‎Còn tùy.
Dialogue: 0,0:05:28.92,0:05:31.55,Default,,0,0,0,,‎Chú không chắc có phải tiền mặt không nữa.
Dialogue: 0,0:05:32.67,0:05:33.84,Default,,0,0,0,,‎Tớ phải đi đây.
Dialogue: 0,0:05:34.67,0:05:36.84,Default,,0,0,0,,‎- Cháu cũng thế.\N‎- Này.
Dialogue: 0,0:05:38.92,0:05:41.30,Default,,0,0,0,,‎Này, đợi đã.
Dialogue: 0,0:05:41.38,0:05:43.84,Default,,0,0,0,,‎Ôi trời...
Dialogue: 0,0:05:50.58,0:05:54.00,Default,,0,0,0,,‎Răng cô có dính gì kìa.
Dialogue: 0,0:05:54.75,0:05:56.58,Default,,0,0,0,,‎Ở giữa răng ấy.
Dialogue: 0,0:05:57.17,0:05:58.84,Default,,0,0,0,,‎Là thứ cô đã ăn đấy.
Dialogue: 0,0:06:00.04,0:06:03.04,Default,,0,0,0,,‎Không. Sao cô ấy lại không hiểu chứ?
Dialogue: 0,0:06:13.04,0:06:14.04,Default,,0,0,0,,‎Của ông đây.
Dialogue: 0,0:06:14.92,0:06:19.05,Default,,0,0,0,,‎Ông Umemiya dạy Marilyn\N‎môn kế toán thời trung học.
Dialogue: 0,0:06:19.13,0:06:22.63,Default,,0,0,0,,‎Hiểu rồi. Ông ấy dạy cô ấy\N‎khi cô ấy còn là học sinh.
Dialogue: 0,0:06:24.33,0:06:25.21,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:06:25.75,0:06:28.71,Default,,0,0,0,,‎- Xin lỗi đã khiến thầy phải đợi.\N‎- Marilyn. Lại đây ngồi.
Dialogue: 0,0:06:29.42,0:06:30.75,Default,,0,0,0,,‎Cảm ơn ông.
Dialogue: 0,0:06:31.58,0:06:33.87,Default,,0,0,0,,‎Thưa thầy, xin lỗi đã khiến thầy phải đợi.
Dialogue: 0,0:06:33.96,0:06:36.34,Default,,0,0,0,,‎Không sao. Ta không để ý đâu.
Dialogue: 0,0:06:38.88,0:06:41.92,Default,,0,0,0,,‎- Ông chủ, chai này nữa và món như cũ.\N‎- Được.
Dialogue: 0,0:06:42.83,0:06:45.87,Default,,0,0,0,,‎Tôi đã xem chương trình thoát y lâu rồi,
Dialogue: 0,0:06:46.42,0:06:49.55,Default,,0,0,0,,‎nhưng hôm nay thật đặc biệt. Tôi sẽ\N‎không bao giờ thấy lại thứ gì như thế.
Dialogue: 0,0:07:14.00,0:07:16.29,Default,,0,0,0,,‎Một thiếu nữ đẹp tuyệt trần!
Dialogue: 0,0:07:18.08,0:07:19.08,Default,,0,0,0,,‎Marilyn!
Dialogue: 0,0:07:49.71,0:07:51.63,Default,,0,0,0,,‎Phơi bày ra rồi!
Dialogue: 0,0:07:52.79,0:07:55.04,Default,,0,0,0,,‎Học sinh số chín!
Dialogue: 0,0:07:56.79,0:07:58.67,Default,,0,0,0,,‎Mariko Kanno!
Dialogue: 0,0:08:02.42,0:08:03.63,Default,,0,0,0,,‎Umejii?
Dialogue: 0,0:08:05.13,0:08:07.46,Default,,0,0,0,,‎Em đã rất ngạc nhiên ạ!
Dialogue: 0,0:08:07.54,0:08:10.04,Default,,0,0,0,,‎Có người gọi tên tôi\N‎theo số thời học sinh.
Dialogue: 0,0:08:10.13,0:08:12.46,Default,,0,0,0,,‎Giống như đô vật sumo bước lên vũ đài.
Dialogue: 0,0:08:13.88,0:08:16.55,Default,,0,0,0,,‎Tôi nghỉ hưu lâu lắm rồi,
Dialogue: 0,0:08:16.63,0:08:19.09,Default,,0,0,0,,‎nhưng không ngăn được bản thân. Xin lỗi.
Dialogue: 0,0:08:19.75,0:08:21.96,Default,,0,0,0,,‎Lần tới, tôi cũng sẽ gọi cô như thế.
Dialogue: 0,0:08:22.04,0:08:23.33,Default,,0,0,0,,‎Thôi đi!
Dialogue: 0,0:08:24.04,0:08:25.33,Default,,0,0,0,,‎Học sinh số chín!
Dialogue: 0,0:08:37.38,0:08:38.38,Default,,0,0,0,,‎Của cô đây.
Dialogue: 0,0:08:40.08,0:08:42.83,Default,,0,0,0,,‎Tôi bắt đầu gọi thầy ấy là Umejii.
Dialogue: 0,0:08:44.96,0:08:48.96,Default,,0,0,0,,‎Từ lúc tôi làm đĩ giống mẹ mình,
Dialogue: 0,0:08:49.04,0:08:52.50,Default,,0,0,0,,‎tất cả bạn học nữ\N‎không thích và phớt lờ tôi.
Dialogue: 0,0:08:52.58,0:08:54.87,Default,,0,0,0,,‎- Họ ghen tị.\N‎- Chắc thế.
Dialogue: 0,0:08:55.50,0:08:57.71,Default,,0,0,0,,‎Nhưng thầy ấy\N‎là người duy nhất không như họ.
Dialogue: 0,0:08:58.25,0:08:59.92,Default,,0,0,0,,‎Tôi gọi thầy ấy bằng biệt danh,\N‎cảm thấy thật gần gũi.
Dialogue: 0,0:09:01.29,0:09:05.08,Default,,0,0,0,,‎Vào giờ ăn trưa, khi em hút thuốc\N‎trên tầng thượng một mình,
Dialogue: 0,0:09:05.17,0:09:07.71,Default,,0,0,0,,‎thầy luôn cho em cơm nắm trộn mận.
Dialogue: 0,0:09:09.04,0:09:12.62,Default,,0,0,0,,‎Em phàn nàn rồi nói\N‎em thích cơm nắm trộn trứng cá tuyết.
Dialogue: 0,0:09:12.71,0:09:14.63,Default,,0,0,0,,‎Em đâu có nói thế!
Dialogue: 0,0:09:15.17,0:09:18.84,Default,,0,0,0,,‎Thầy cắt nhỏ mận muối\N‎rồi trộn chúng với cơm.
Dialogue: 0,0:09:19.54,0:09:21.54,Default,,0,0,0,,‎Rất ngon đấy ạ.
Dialogue: 0,0:09:23.75,0:09:25.42,Default,,0,0,0,,‎Vợ thầy sao rồi ạ? Bà ấy khoẻ chứ?
Dialogue: 0,0:09:25.96,0:09:26.79,Default,,0,0,0,,‎Ừ.
Dialogue: 0,0:09:27.71,0:09:30.50,Default,,0,0,0,,‎Bà ấy vẫn làm cơm nắm với thứ này.
Dialogue: 0,0:09:32.08,0:09:34.54,Default,,0,0,0,,‎Umejii, tối nay thầy sẽ ở đâu?
Dialogue: 0,0:09:38.79,0:09:40.04,Default,,0,0,0,,‎Tối nay...
Dialogue: 0,0:09:40.71,0:09:42.59,Default,,0,0,0,,‎Thật tuyệt khi được gặp em,
Dialogue: 0,0:09:43.25,0:09:46.38,Default,,0,0,0,,‎và tôi còn được xem\N‎"chỗ ấy" nữa. Thật tuyệt vời.
Dialogue: 0,0:09:47.58,0:09:49.00,Default,,0,0,0,,‎Đừng ngớ ngẩn thế ạ.
Dialogue: 0,0:09:50.04,0:09:53.00,Default,,0,0,0,,‎Sao thầy không ở cùng em?\N‎Dù sao em cũng đang sống cùng bạn trai.
Dialogue: 0,0:09:53.54,0:09:56.33,Default,,0,0,0,,‎Mừng cho ông, ông Umemiya.\N‎Tôi ghen tị đấy.
Dialogue: 0,0:09:57.88,0:09:59.34,Default,,0,0,0,,‎Sao lại không nào?
Dialogue: 0,0:10:00.42,0:10:01.50,Default,,0,0,0,,‎Vậy nhé!
Dialogue: 0,0:10:06.17,0:10:09.17,Default,,0,0,0,,{\i1}‎Trôi theo dòng nước{\i0}
Dialogue: 0,0:10:10.50,0:10:14.17,Default,,0,0,0,,{\i1}‎Đêm đó, ông ấy ở lại nhà Marilyn.{\i0}
Dialogue: 0,0:10:14.71,0:10:20.21,Default,,0,0,0,,{\i1}‎Hôm sau, họ đến tòa tháp Tokyo Skytree{\i0}\N{\i1}‎vì Marilyn có một ngày nghỉ.{\i0}
Dialogue: 0,0:10:20.92,0:10:24.38,Default,,0,0,0,,{\i1}‎Những người bạn của chúng ta{\i0}
Dialogue: 0,0:10:27.21,0:10:28.92,Default,,0,0,0,,{\i1}‎Mãi mãi{\i0}
Dialogue: 0,0:10:29.00,0:10:31.92,Default,,0,0,0,,{\i1}‎Mãi mãi giúp đỡ lẫn nhau{\i0}
Dialogue: 0,0:10:32.00,0:10:34.25,Default,,0,0,0,,{\i1}‎Mãi mãi{\i0}
Dialogue: 0,0:10:43.08,0:10:44.46,Default,,0,0,0,,‎Vâng, ở đó.
Dialogue: 0,0:10:45.50,0:10:46.54,Default,,0,0,0,,‎Kibi...
Dialogue: 0,0:10:55.33,0:11:00.50,Default,,0,0,0,,‎Sau đó, Umejii muốn mua\N‎khăn choàng cổ cho vợ,
Dialogue: 0,0:11:00.58,0:11:04.08,Default,,0,0,0,,‎nên đến bách hóa ở Ueno để mua,\N‎và tôi đưa ông ấy đến nhà ga.
Dialogue: 0,0:11:04.17,0:11:05.25,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:11:06.58,0:11:07.87,Default,,0,0,0,,‎Hoan nghênh.
Dialogue: 0,0:11:12.25,0:11:14.58,Default,,0,0,0,,‎Umejii! Thầy làm gì ở đây thế?
Dialogue: 0,0:11:17.71,0:11:19.96,Default,,0,0,0,,‎Học sinh số chín!
Dialogue: 0,0:11:21.42,0:11:22.96,Default,,0,0,0,,‎Mariko Kanno!
Dialogue: 0,0:11:23.50,0:11:25.46,Default,,0,0,0,,‎Lâu rồi không gặp!
Dialogue: 0,0:11:27.38,0:11:28.63,Default,,0,0,0,,‎Mời thầy ngồi.
Dialogue: 0,0:11:29.42,0:11:33.84,Default,,0,0,0,,‎Ông ấy đứng trước nhà hát,\N‎nhìn chằm chằm tấm áp phích của cô ấy.
Dialogue: 0,0:11:34.54,0:11:36.25,Default,,0,0,0,,‎Ông ấy cũng không nhớ ra tôi.
Dialogue: 0,0:11:37.25,0:11:40.04,Default,,0,0,0,,‎- Nếu vậy thì...\N‎- Đành vậy thôi.
Dialogue: 0,0:11:40.13,0:11:42.67,Default,,0,0,0,,‎Ông ấy già rồi nên mới bị vậy.
Dialogue: 0,0:11:44.08,0:11:48.79,Default,,0,0,0,,‎Bức tranh lớn của em được treo trên tường.
Dialogue: 0,0:11:49.79,0:11:55.12,Default,,0,0,0,,‎Ta rất vui khi thấy em\N‎làm việc chăm chỉ ở Tokyo.
Dialogue: 0,0:11:56.46,0:11:59.04,Default,,0,0,0,,‎Umejii, thầy có đói không?
Dialogue: 0,0:12:00.17,0:12:01.17,Default,,0,0,0,,‎Có.
Dialogue: 0,0:12:01.96,0:12:03.71,Default,,0,0,0,,‎Ta đói lắm.
Dialogue: 0,0:12:04.58,0:12:10.21,Default,,0,0,0,,‎Ta từ Fukushima đến đây hôm nay,\N‎và chưa ăn gì cả.
Dialogue: 0,0:12:10.75,0:12:14.29,Default,,0,0,0,,‎Ông chủ, cho tôi gọi\N‎cơm nắm trộn mận muối cắt nhỏ nhé?
Dialogue: 0,0:12:14.38,0:12:17.67,Default,,0,0,0,,‎Và thêm một phần trộn trứng cá tuyết.
Dialogue: 0,0:12:17.75,0:12:18.96,Default,,0,0,0,,‎Trò ấy thích món đó.
Dialogue: 0,0:12:19.71,0:12:20.71,Default,,0,0,0,,‎Vâng.
Dialogue: 0,0:12:24.75,0:12:28.21,Default,,0,0,0,,‎Em lúc nào cũng phàn nàn.
Dialogue: 0,0:12:30.00,0:12:31.88,Default,,0,0,0,,‎Em từng vậy, đúng không?
Dialogue: 0,0:12:34.79,0:12:37.37,Default,,0,0,0,,‎Sao thế? Trông em thật buồn.
Dialogue: 0,0:12:39.96,0:12:45.00,Default,,0,0,0,,‎Khi em ấy bảo với ta\N‎sẽ nghỉ học để trở thành vũ công,
Dialogue: 0,0:12:45.63,0:12:49.30,Default,,0,0,0,,‎ta đã cố hết sức ngăn cản,\N‎nhưng em ấy không chịu nghe gì cả.
Dialogue: 0,0:12:49.83,0:12:52.58,Default,,0,0,0,,‎Rất ương bướng. Đúng thế không?
Dialogue: 0,0:13:26.96,0:13:28.59,Default,,0,0,0,,‎Của hai người đây.
Dialogue: 0,0:13:30.71,0:13:34.09,Default,,0,0,0,,‎Anh cũng nấu ăn ở nhà chứ?
Dialogue: 0,0:13:34.96,0:13:38.29,Default,,0,0,0,,‎Tôi về nhà rồi đi ngủ thôi.
Dialogue: 0,0:13:39.08,0:13:42.16,Default,,0,0,0,,‎Thỉnh thoảng anh nên nấu ăn cho vợ.
Dialogue: 0,0:13:42.71,0:13:44.13,Default,,0,0,0,,‎Ta cá cô ấy sẽ vui lắm.
Dialogue: 0,0:13:44.21,0:13:45.71,Default,,0,0,0,,‎Umejii, ông chủ...
Dialogue: 0,0:13:45.79,0:13:49.37,Default,,0,0,0,,‎Ông nói đúng.\N‎Thỉnh thoảng tôi nên đối xử tốt với cô ấy.
Dialogue: 0,0:13:50.42,0:13:54.42,Default,,0,0,0,,‎Nếu ở nhà mà không tử tế,\N‎cô ấy sẽ bỏ anh thôi.
Dialogue: 0,0:13:55.17,0:13:56.30,Default,,0,0,0,,‎Tôi sẽ cố hết sức.
Dialogue: 0,0:13:57.79,0:14:02.75,Default,,0,0,0,,{\i1}‎Đêm đó, Marilyn lại đưa{\i0}\N{\i1}‎ông Umemiya về nhà cô ấy.{\i0}
Dialogue: 0,0:14:03.63,0:14:09.71,Default,,0,0,0,,{\i1}‎Hôm sau, dù cô ấy đã hỏi{\i0}\N{\i1}‎địa chỉ nhà và số điện thoại,{\i0}
Dialogue: 0,0:14:09.79,0:14:13.25,Default,,0,0,0,,{\i1}‎ông ấy vẫn không nói, lảng sang{\i0}\N{\i1}‎chuyện khác và nói về chuyện ngày xưa.{\i0}
Dialogue: 0,0:14:30.63,0:14:34.13,Default,,0,0,0,,‎Tôi thấy thương mấy quả mận muối lắm.
Dialogue: 0,0:14:34.96,0:14:38.34,Default,,0,0,0,,‎Nhưng nếu không nghiền nó,\N‎tôi không thể có nước mận.
Dialogue: 0,0:14:39.75,0:14:41.75,Default,,0,0,0,,‎Tôi thích thế này hơn.
Dialogue: 0,0:14:45.38,0:14:48.55,Default,,0,0,0,,‎Chúng thật ngon khi có nhiều muối nhỉ?
Dialogue: 0,0:14:49.21,0:14:50.21,Default,,0,0,0,,‎Phải.
Dialogue: 0,0:14:50.79,0:14:56.04,Default,,0,0,0,,‎Dưa muối vợ tôi làm dạo này không mặn lắm.
Dialogue: 0,0:14:56.75,0:14:58.88,Default,,0,0,0,,‎Bà ấy chắc lo cho sức khỏe của ông.
Dialogue: 0,0:14:59.46,0:15:01.34,Default,,0,0,0,,‎Nếu ăn quá nhiều muối...
Dialogue: 0,0:15:01.88,0:15:03.63,Default,,0,0,0,,‎Tôi xem tay ông được không?
Dialogue: 0,0:15:04.67,0:15:06.50,Default,,0,0,0,,‎Chỗ này là điểm huyệt của thận.
Dialogue: 0,0:15:06.58,0:15:10.04,Default,,0,0,0,,‎Còn đây là của tuyến thượng thận.\N‎Tôi sẽ ấn ở đây.
Dialogue: 0,0:15:11.08,0:15:12.12,Default,,0,0,0,,‎Ông thấy gì không?
Dialogue: 0,0:15:12.71,0:15:13.92,Default,,0,0,0,,‎Này, anh ơi!
Dialogue: 0,0:15:14.71,0:15:18.29,Default,,0,0,0,,‎Anh sẽ mở phòng khám\N‎chuyên nắn khớp xương, phải không?
Dialogue: 0,0:15:18.38,0:15:22.01,Default,,0,0,0,,‎Nếu tiết lộ thủ thuật dễ dàng vậy,\N‎công việc của anh sẽ thất bại ngay thôi.
Dialogue: 0,0:15:22.88,0:15:25.21,Default,,0,0,0,,‎- Vâng.\N‎- Xin lỗi đã làm phiền.
Dialogue: 0,0:15:25.29,0:15:26.83,Default,,0,0,0,,‎Dù sao cũng rất tuyệt đấy.
Dialogue: 0,0:15:29.92,0:15:31.17,Default,,0,0,0,,‎Xin lỗi, Kibi.
Dialogue: 0,0:15:32.38,0:15:34.76,Default,,0,0,0,,‎Khăn choàng cổ đây!
Dialogue: 0,0:15:35.46,0:15:37.42,Default,,0,0,0,,‎Đừng quên nó ạ.
Dialogue: 0,0:15:37.50,0:15:39.46,Default,,0,0,0,,‎Thầy sẽ tặng cho vợ, đúng chứ?
Dialogue: 0,0:15:40.54,0:15:43.54,Default,,0,0,0,,‎Em đâu cần làm thế.
Dialogue: 0,0:15:43.63,0:15:44.84,Default,,0,0,0,,‎Giữ lấy đi, Mariko.
Dialogue: 0,0:15:45.42,0:15:47.34,Default,,0,0,0,,‎Đừng ngớ ngẩn thế ạ.
Dialogue: 0,0:15:47.42,0:15:52.80,Default,,0,0,0,,‎Thầy bảo em chọn cái thật đẹp.\N‎Ta đã mua nó tại Ueno mà!
Dialogue: 0,0:15:52.88,0:15:53.96,Default,,0,0,0,,‎Đây ạ.
Dialogue: 0,0:15:55.08,0:15:56.21,Default,,0,0,0,,‎Thật ư?
Dialogue: 0,0:15:58.67,0:16:01.38,Default,,0,0,0,,‎Dạo này ta đã già và đãng trí lắm rồi.
Dialogue: 0,0:16:02.08,0:16:04.00,Default,,0,0,0,,‎Cảm ơn. Ta sẽ tặng cho bà ấy.
Dialogue: 0,0:16:04.08,0:16:05.16,Default,,0,0,0,,‎Marilyn.
Dialogue: 0,0:16:06.67,0:16:09.05,Default,,0,0,0,,‎Cô thử nói chuyện\N‎với gia đình ông ấy chưa?
Dialogue: 0,0:16:09.13,0:16:12.26,Default,,0,0,0,,‎Tôi đã gọi đến trường trung học,\N‎nhưng họ không biết địa chỉ của ông ấy.
Dialogue: 0,0:16:12.96,0:16:16.17,Default,,0,0,0,,‎Và tôi đã cắt đứt quan hệ\N‎với bọn người ở đó rồi.
Dialogue: 0,0:16:17.08,0:16:18.29,Default,,0,0,0,,‎Tôi hiểu rồi.
Dialogue: 0,0:16:20.54,0:16:24.25,Default,,0,0,0,,‎Chào buổi tối. Ông Umemiya có đây không?
Dialogue: 0,0:16:26.00,0:16:27.42,Default,,0,0,0,,‎Bố!
Dialogue: 0,0:16:28.58,0:16:30.41,Default,,0,0,0,,‎Bọn con tìm bố khắp nơi!
Dialogue: 0,0:16:31.17,0:16:34.46,Default,,0,0,0,,‎Ông Umemiya làm mất\N‎chiếc điện thoại di động này.
Dialogue: 0,0:16:34.54,0:16:39.42,Default,,0,0,0,,‎Các con gái của ông ấy cố định vị nó\N‎bằng GPS, nhưng nó lại hết pin.
Dialogue: 0,0:16:40.21,0:16:44.59,Default,,0,0,0,,‎Em gái và tôi thay nhau chăm sóc bố,
Dialogue: 0,0:16:45.46,0:16:49.00,Default,,0,0,0,,‎nhưng vài ngày trước tôi quá bận.
Dialogue: 0,0:16:49.08,0:16:52.75,Default,,0,0,0,,‎Chúng tôi đều tưởng\N‎bố đang ở với người kia.
Dialogue: 0,0:16:54.33,0:16:58.46,Default,,0,0,0,,‎Chúng tôi rất xin lỗi\N‎đã làm phiền mọi người.
Dialogue: 0,0:17:00.08,0:17:03.50,Default,,0,0,0,,‎Từ khi mẹ chúng tôi\N‎qua đời hai tháng trước...
Dialogue: 0,0:17:05.38,0:17:07.88,Default,,0,0,0,,‎ông ấy đột nhiên cư xử rất lạ.
Dialogue: 0,0:17:09.92,0:17:11.80,Default,,0,0,0,,‎Sao con lại khóc?
Dialogue: 0,0:17:11.88,0:17:13.59,Default,,0,0,0,,‎Bố!
Dialogue: 0,0:17:19.46,0:17:20.84,Default,,0,0,0,,‎Cô, Midori!
Dialogue: 0,0:17:22.71,0:17:24.04,Default,,0,0,0,,‎Lâu rồi không gặp...
Dialogue: 0,0:17:24.13,0:17:25.67,Default,,0,0,0,,‎Con đĩ Mariko.
Dialogue: 0,0:17:26.42,0:17:33.21,Default,,0,0,0,,{\i1}‎Người phụ nữ này, Midori, làm việc{\i0}\N{\i1}‎tại cơ sở chăm sóc mà ông Umemiya lui tới.{\i0}
Dialogue: 0,0:17:33.79,0:17:39.67,Default,,0,0,0,,{\i1}‎Thời trung học, cô ta là người đứng đầu{\i0}\N{\i1}‎nhóm nữ sinh đã phớt lờ Marilyn.{\i0}
Dialogue: 0,0:17:39.75,0:17:40.88,Default,,0,0,0,,‎Cảm ơn.
Dialogue: 0,0:17:42.33,0:17:45.46,Default,,0,0,0,,‎Xin hãy đến đồn cảnh sát cùng tôi\N‎để điền vài thông tin.
Dialogue: 0,0:17:45.54,0:17:47.75,Default,,0,0,0,,‎Được. Cảm ơn.
Dialogue: 0,0:17:47.83,0:17:51.46,Default,,0,0,0,,‎Bố, hãy đi cẩn thận nào.
Dialogue: 0,0:17:52.17,0:17:55.21,Default,,0,0,0,,‎- Thật nhẹ nhõm khi tìm thấy bố!\N‎- Đúng là nhẹ nhõm.
Dialogue: 0,0:18:18.75,0:18:20.25,Default,,0,0,0,,‎Thầy Umemiya...
Dialogue: 0,0:18:21.25,0:18:27.13,Default,,0,0,0,,‎Có những lúc thì thầy ấy ổn,\N‎nhưng thỉnh thoảng lại mất trí nhớ.
Dialogue: 0,0:18:32.92,0:18:36.63,Default,,0,0,0,,‎Nghe nói di động của thầy ấy hết pin.
Dialogue: 0,0:18:38.13,0:18:40.76,Default,,0,0,0,,‎Sao cô biết thầy ấy ở Tokyo hả?
Dialogue: 0,0:18:43.92,0:18:47.21,Default,,0,0,0,,‎Thầy đến cơ sở chúng tôi mỗi tuần một lần.
Dialogue: 0,0:18:49.25,0:18:51.00,Default,,0,0,0,,‎Vào ngày thầy mất tích...
Dialogue: 0,0:18:53.96,0:18:56.46,Default,,0,0,0,,‎thầy có để lại thứ này.
Dialogue: 0,0:18:56.54,0:18:58.71,Default,,0,0,0,,‎MARILYN - TÔI ĐÃ TÌM THẤY NƠI MÌNH CẦN\N‎ĐÂY LÀ CÔNG VIỆC LÝ TƯỞNG
Dialogue: 0,0:19:01.00,0:19:02.00,Default,,0,0,0,,‎Trời...
Dialogue: 0,0:19:02.83,0:19:06.50,Default,,0,0,0,,‎Là bài báo khi tôi\N‎biểu diễn ở New Art lần đầu.
Dialogue: 0,0:19:06.58,0:19:09.33,Default,,0,0,0,,‎Mỗi lần đến, thầy luôn bảo là,
Dialogue: 0,0:19:10.25,0:19:13.63,Default,,0,0,0,,‎"Ta đã nghĩ lẽ ra nên đưa Mariko\N‎về quê tránh xa Tokyo,
Dialogue: 0,0:19:14.50,0:19:17.67,Default,,0,0,0,,‎nhưng Mariko cuối cùng\N‎đã tìm thấy nơi của em ấy rồi.
Dialogue: 0,0:19:18.58,0:19:22.71,Default,,0,0,0,,‎Ta sẽ không cố cản nữa, vì trong bài phỏng\N‎vấn, em ấy nói đó là công việc lý tưởng."
Dialogue: 0,0:19:24.88,0:19:26.09,Default,,0,0,0,,‎Umejii...
Dialogue: 0,0:19:28.83,0:19:31.25,Default,,0,0,0,,‎Tôi ghét biệt danh đó.
Dialogue: 0,0:19:33.88,0:19:37.26,Default,,0,0,0,,‎Tôi ghét cả cô, cách cô cư xử như thể\N‎mình là học sinh đặc biệt duy nhất.
Dialogue: 0,0:19:38.38,0:19:42.59,Default,,0,0,0,,‎Tôi cũng ghét cô,\N‎lúc nào cũng ở cùng đám con gái đó.
Dialogue: 0,0:19:44.79,0:19:49.04,Default,,0,0,0,,‎Tôi ở bên thầy nhiều hơn cô,
Dialogue: 0,0:19:49.79,0:19:53.42,Default,,0,0,0,,‎nhưng lúc nào\N‎thầy cũng quan tâm đến cô nhất.
Dialogue: 0,0:19:54.17,0:19:56.13,Default,,0,0,0,,‎Thầy ấy luôn giữ nó bên mình.
Dialogue: 0,0:19:58.42,0:20:02.38,Default,,0,0,0,,‎Thầy chưa từng cho tôi\N‎cơm nắm trộn mận muối cắt nhỏ,
Dialogue: 0,0:20:03.08,0:20:05.25,Default,,0,0,0,,‎hồi trung học hay bây giờ.
Dialogue: 0,0:20:11.96,0:20:13.17,Default,,0,0,0,,‎Đợi đã.
Dialogue: 0,0:20:14.58,0:20:18.25,Default,,0,0,0,,‎Cô định đi mà không ăn gì à?
Dialogue: 0,0:20:21.13,0:20:23.80,Default,,0,0,0,,‎Ông chủ, cho tôi\N‎phần cơm nắm trộn mận muối cắt nhỏ.
Dialogue: 0,0:20:24.92,0:20:26.96,Default,,0,0,0,,‎- Của hai người đây.\N‎- Sao?
Dialogue: 0,0:20:29.21,0:20:30.67,Default,,0,0,0,,‎Phần kia tôi mời.
Dialogue: 0,0:20:31.58,0:20:32.54,Default,,0,0,0,,‎Ông chắc chứ?
Dialogue: 0,0:20:44.71,0:20:47.84,Default,,0,0,0,,‎Nếu cô không ăn, tôi sẽ ăn luôn đó.
Dialogue: 0,0:21:36.25,0:21:41.67,Default,,0,0,0,,{\i1}‎Kể từ đó, Marilyn thỉnh thoảng đem{\i0}\N{\i1}‎cơm nắm trộn mận muối cắt nhỏ tôi làm{\i0}
Dialogue: 0,0:21:42.38,0:21:45.13,Default,,0,0,0,,{\i1}‎cho ông Umemiya.{\i0}
Dialogue: 0,0:21:45.92,0:21:49.38,Default,,0,0,0,,‎Hana. Bà làm cái gì đấy?
Dialogue: 0,0:21:49.46,0:21:50.59,Default,,0,0,0,,‎Một cây tú cầu.
Dialogue: 0,0:21:50.67,0:21:52.50,Default,,0,0,0,,‎Cây tú cầu!
Dialogue: 0,0:21:52.58,0:21:54.00,Default,,0,0,0,,‎Của ông là gì?
Dialogue: 0,0:21:54.63,0:21:56.59,Default,,0,0,0,,‎Một bức ảnh về...
Dialogue: 0,0:22:10.54,0:22:13.21,Default,,0,0,0,,{\i1}‎Mận muối bỏ hạt, cắt nhỏ,{\i0}
Dialogue: 0,0:22:13.29,0:22:15.62,Default,,0,0,0,,{\i1}‎và trộn chúng với cơm và hạt mè.{\i0}
Dialogue: 0,0:22:16.29,0:22:18.00,Default,,0,0,0,,{\i1}‎Lá rong biển có hai mặt.{\i0}
Dialogue: 0,0:22:18.08,0:22:20.12,Default,,0,0,0,,‎Mặt sáng bóng là phần đầu.
Dialogue: 0,0:22:20.21,0:22:24.42,Default,,0,0,0,,‎Để phần đầu đối diện sẽ cảm thấy\N‎tuyệt hơn trên môi và vị cũng ngon hơn.
Dialogue: 0,0:22:25.33,0:22:26.71,Default,,0,0,0,,‎Của ông đây.
Dialogue: 0,0:22:34.13,0:22:35.51,Default,,0,0,0,,‎Thật tuyệt vời.
Dialogue: 0,0:22:37.04,0:22:38.62,Default,,0,0,0,,‎Chúc ngủ ngon!
Dialogue: 0,0:22:38.71,0:22:39.71,Default,,0,0,0,,‎Chúc ngủ ngon.
Dialogue: 0,0:23:50.00,0:23:52.83,Default,,0,0,0,,‎ĐÂY LÀ CÂU CHUYỆN HƯ CẤU
Dialogue: 0,0:23:52.92,0:23:54.92,Default,,0,0,0,,‎Biên dịch: Hiền Phạm
