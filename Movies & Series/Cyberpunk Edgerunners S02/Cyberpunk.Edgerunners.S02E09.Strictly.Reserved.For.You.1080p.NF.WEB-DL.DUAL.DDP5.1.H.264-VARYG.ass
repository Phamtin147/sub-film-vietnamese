Dialogue: 0,0:00:23.94,0:00:26.74,Default,,0,0,0,,- Đã lấy được vi mạch.\N- Làm gì với gã này đây?
Dialogue: 0,0:00:27.24,0:00:29.66,Default,,0,0,0,,Hết dùng được rồi. Tống khứ đi.
Dialogue: 0,0:01:10.65,0:01:11.61,Default,,0,0,0,,Capri….
Dialogue: 0,0:01:20.25,0:01:23.42,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:01:23.50,0:01:26.54,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:02:50.80,0:02:53.47,Default,,0,0,0,,Sal. Tôi mang phim đến đây.
Dialogue: 0,0:02:53.97,0:02:55.22,Default,,0,0,0,,Roman?
Dialogue: 0,0:02:55.30,0:02:58.43,Default,,0,0,0,,Đây có lẽ là thước phim cuối cùng của D.
Dialogue: 0,0:02:58.93,0:03:01.39,Default,,0,0,0,,Cậu không đi à?
Dialogue: 0,0:03:01.47,0:03:02.31,Default,,0,0,0,,Đi đâu?
Dialogue: 0,0:03:02.39,0:03:03.77,Default,,0,0,0,,Cậu không biết sao?
Dialogue: 0,0:03:06.77,0:03:10.48,Default,,0,0,0,,{\i1}Những kẻ bạo động ở Heywood\Nđã bị khống chế.{\i0}
Dialogue: 0,0:03:10.98,0:03:13.40,Default,,0,0,0,,{\i1}Hiện chưa rõ tung tích của tên cầm đầu,{\i0}
Dialogue: 0,0:03:13.48,0:03:15.73,Default,,0,0,0,,{\i1}nhưng số còn lại đã bị vô hiệu hóa.{\i0}
Dialogue: 0,0:03:15.82,0:03:19.74,Default,,0,0,0,,{\i1}Thành phố Đêm\Ndự kiến sẽ hoạt động lại bình thường.{\i0}
Dialogue: 0,0:03:24.33,0:03:25.33,Default,,0,0,0,,Ai đó?
Dialogue: 0,0:03:27.83,0:03:29.00,Default,,0,0,0,,Talia đấy à?
Dialogue: 0,0:03:30.25,0:03:31.50,Default,,0,0,0,,Cháu đi đâu vậy?
Dialogue: 0,0:03:33.55,0:03:34.68,Default,,0,0,0,,Weak?
Dialogue: 0,0:03:36.42,0:03:37.67,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:04:07.33,0:04:08.29,Default,,0,0,0,,Weak?
Dialogue: 0,0:04:10.54,0:04:14.71,Default,,0,0,0,,Cô Yang? Tìm thấy con gái bà Yang rồi.\NCô ấy đang ở nhà xác.
Dialogue: 0,0:04:16.38,0:04:18.47,Default,,0,0,0,,Không, tôi chưa hỏi cô ấy.
Dialogue: 0,0:04:38.40,0:04:40.24,Default,,0,0,0,,Đợi đã, cơ thể đâu?
Dialogue: 0,0:04:40.32,0:04:41.53,Default,,0,0,0,,Đã giải quyết rồi.
Dialogue: 0,0:04:41.61,0:04:42.49,Default,,0,0,0,,"Giải quyết"?
Dialogue: 0,0:04:42.57,0:04:45.24,Default,,0,0,0,,Chúng tôi được lệnh lấy con chip.
Dialogue: 0,0:04:45.91,0:04:47.33,Default,,0,0,0,,Các người giết hắn ư?
Dialogue: 0,0:04:48.50,0:04:49.75,Default,,0,0,0,,Bọn ngốc này!
Dialogue: 0,0:04:49.83,0:04:51.50,Default,,0,0,0,,Đồ ngu! Lũ vô dụng!
Dialogue: 0,0:04:52.08,0:04:56.00,Default,,0,0,0,,Có biết cơ thể của hắn\Nđáng giá bao nhiêu không?
Dialogue: 0,0:05:01.38,0:05:03.26,Default,,0,0,0,,- Chết đi!\N- Thôi đi, Kyoko!
Dialogue: 0,0:05:03.34,0:05:05.05,Default,,0,0,0,,Gã khốn nào ra sai lệnh?
Dialogue: 0,0:05:05.14,0:05:06.89,Default,,0,0,0,,Gã khốn đó là anh!
Dialogue: 0,0:05:08.14,0:05:09.31,Default,,0,0,0,,Chỉ con chip thôi à?
Dialogue: 0,0:05:09.39,0:05:10.56,Default,,0,0,0,,Còn cơ thể đâu?
Dialogue: 0,0:05:10.64,0:05:12.31,Default,,0,0,0,,Chúng vứt đi rồi!
Dialogue: 0,0:05:12.90,0:05:15.45,Default,,0,0,0,,Thế nên Kang Tao mới tầm tầm bậc trung.
Dialogue: 0,0:05:15.52,0:05:16.86,Default,,0,0,0,,Nếu là Militech thì…
Dialogue: 0,0:05:18.99,0:05:22.95,Default,,0,0,0,,Cô tha thứ được rồi chứ?\NKiểm tra con chip đi.
Dialogue: 0,0:05:38.84,0:05:39.67,Default,,0,0,0,,Xong xuôi.
Dialogue: 0,0:05:40.30,0:05:41.76,Default,,0,0,0,,Rời khỏi đây thôi.
Dialogue: 0,0:05:49.18,0:05:50.22,Default,,0,0,0,,Đừng thiêu bà ấy.
Dialogue: 0,0:05:51.10,0:05:52.23,Default,,0,0,0,,Đừng hòng.
Dialogue: 0,0:05:52.31,0:05:55.90,Default,,0,0,0,,- Xin cô hãy lý trí.\N- Tôi đã bảo đừng mà.
Dialogue: 0,0:05:55.98,0:06:00.23,Default,,0,0,0,,- Bố tôi còn chưa đến mà.\N- Chúng tôi đã có chữ ký của ông ấy.
Dialogue: 0,0:06:00.32,0:06:04.37,Default,,0,0,0,,- Vậy sao ông ấy không xuất hiện?\N- Tôi rất tiếc.
Dialogue: 0,0:06:04.45,0:06:06.20,Default,,0,0,0,,Cái quái gì vậy?
Dialogue: 0,0:06:06.28,0:06:08.78,Default,,0,0,0,,Dừng lại! Không được thiêu mẹ tôi!
Dialogue: 0,0:06:08.87,0:06:10.12,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:06:10.20,0:06:12.37,Default,,0,0,0,,{\an8}Xin lỗi. Đến nước này tôi đành chịu.
Dialogue: 0,0:06:15.46,0:06:16.92,Default,,0,0,0,,Mẹ!
Dialogue: 0,0:06:34.85,0:06:38.52,Default,,0,0,0,,KHÁCH SẠN\NCÓ PHÒNG CON NHỘNG
Dialogue: 0,0:06:41.19,0:06:43.94,Default,,0,0,0,,Sao lại ra thế này?
Dialogue: 0,0:06:57.21,0:06:59.96,Default,,0,0,0,,Vậy giờ cậu định làm gì?
Dialogue: 0,0:07:02.96,0:07:07.63,Default,,0,0,0,,Cậu đã tấn công Arasaka\Nchỉ với vài người. Cậu bị ngốc à?
Dialogue: 0,0:07:09.64,0:07:12.73,Default,,0,0,0,,Cậu có thể ở đây một đêm, tối đa.
Dialogue: 0,0:07:12.81,0:07:14.02,Default,,0,0,0,,Hiểu rồi chứ?
Dialogue: 0,0:07:14.52,0:07:18.27,Default,,0,0,0,,Tôi đã lót tay cho lễ tân,\Nnhưng không được lâu đâu.
Dialogue: 0,0:07:31.66,0:07:36.12,Default,,0,0,0,,Cậu đang làm gì vậy? Trả thù à?
Dialogue: 0,0:07:36.62,0:07:40.17,Default,,0,0,0,,Cứ thế này, cậu sẽ chết đấy.\NCậu muốn thế à?
Dialogue: 0,0:07:42.75,0:07:46.38,Default,,0,0,0,,ĐANG GỌI\NMESHUGA
Dialogue: 0,0:07:49.01,0:07:50.89,Default,,0,0,0,,CUỘC GỌI KHÔNG XÁC ĐỊNH
Dialogue: 0,0:07:50.97,0:07:54.39,Default,,0,0,0,,{\i1}Xin lỗi đã làm phiền.\NTôi gọi về cô Talia Yang…{\i0}
Dialogue: 0,0:07:55.68,0:07:56.93,Default,,0,0,0,,"Vô dụng"?
Dialogue: 0,0:07:57.02,0:07:58.48,Default,,0,0,0,,Cô nói "vô dụng" là sao?
Dialogue: 0,0:07:58.56,0:07:59.69,Default,,0,0,0,,Im đi!
Dialogue: 0,0:07:59.77,0:08:03.02,Default,,0,0,0,,Linh hồn cô ấy đã biến mất.\NCon chip không còn gì cả.
Dialogue: 0,0:08:03.11,0:08:03.94,Default,,0,0,0,,Khốn kiếp!
Dialogue: 0,0:08:04.03,0:08:05.70,Default,,0,0,0,,Nó chỉ là một mảnh rác!
Dialogue: 0,0:08:06.28,0:08:08.20,Default,,0,0,0,,{\an8}Nó còn sức mạnh đúng không? Vậy…
Dialogue: 0,0:08:08.28,0:08:09.70,Default,,0,0,0,,{\an8}Động não chút đi!
Dialogue: 0,0:08:09.78,0:08:13.08,Default,,0,0,0,,{\an8}Nó như một chiếc xe không phanh\Nđang lao trên cao tốc.
Dialogue: 0,0:08:13.16,0:08:15.20,Default,,0,0,0,,{\an8}Và ta không có cơ thể tương thích!
Dialogue: 0,0:08:15.29,0:08:17.71,Default,,0,0,0,,{\an8}Chết tiệt! Sao hắn…
Dialogue: 0,0:08:19.04,0:08:24.38,Default,,0,0,0,,{\i1}Nghĩ đi nào. Trông hắn tả tơi thật,\Nnhưng vẫn giữ được ý thức.{\i0}
Dialogue: 0,0:08:24.46,0:08:28.63,Default,,0,0,0,,{\i1}Không giống như đang thấy\Nmột cấu trúc được tải sẵn.{\i0}
Dialogue: 0,0:08:29.13,0:08:32.72,Default,,0,0,0,,{\i1}Không. Việc cài đặt\Ndù sao cũng không lâu đến vậy.{\i0}
Dialogue: 0,0:08:33.22,0:08:34.68,Default,,0,0,0,,{\i1}Vậy nghĩa là…{\i0}
Dialogue: 0,0:08:36.93,0:08:38.72,Default,,0,0,0,,Cô ấy đã tách ra vào lúc đó ư?
Dialogue: 0,0:08:43.06,0:08:44.06,Default,,0,0,0,,ĐANG GỌI\NKYOKO
Dialogue: 0,0:08:44.90,0:08:45.78,Default,,0,0,0,,Kyoko?
Dialogue: 0,0:08:45.86,0:08:47.49,Default,,0,0,0,,{\i1}Phải phải, Kyoko đây.{\i0}
Dialogue: 0,0:08:48.11,0:08:49.90,Default,,0,0,0,,{\i1}Cô ổn chứ? Trông có vẻ khá tệ…{\i0}
Dialogue: 0,0:08:50.99,0:08:53.45,Default,,0,0,0,,{\i1}À, không có gì…{\i0}
Dialogue: 0,0:08:53.53,0:08:57.37,Default,,0,0,0,,{\i1}Dĩ nhiên là có hơi hoảng.\NCậu thật tử tế khi lo lắng cho tôi.{\i0}
Dialogue: 0,0:08:57.45,0:08:58.91,Default,,0,0,0,,{\i1}Vậy tốt rồi.{\i0}
Dialogue: 0,0:08:59.54,0:09:02.25,Default,,0,0,0,,{\i1}D hành động kỳ lạ, rất kỳ lạ, nhưng…{\i0}
Dialogue: 0,0:09:02.92,0:09:04.71,Default,,0,0,0,,{\i1}cô cũng vậy.{\i0}
Dialogue: 0,0:09:05.25,0:09:08.88,Default,,0,0,0,,{\i1}- Cô có vẻ lạ lắm.\N- Tôi xin lỗi. Đã nói tôi hơi hoảng mà.{\i0}
Dialogue: 0,0:09:08.97,0:09:11.26,Default,,0,0,0,,{\i1}Giờ tôi muốn nói về cậu ấy, về D.{\i0}
Dialogue: 0,0:09:11.34,0:09:12.17,Default,,0,0,0,,{\i1}Ừm.{\i0}
Dialogue: 0,0:09:12.26,0:09:17.31,Default,,0,0,0,,{\i1}Có thể cậu ấy hơi khác ngày thường,\Nnhưng không có vẻ đã hóa siêu cuồng nhân.{\i0}
Dialogue: 0,0:09:17.39,0:09:18.81,Default,,0,0,0,,{\i1}Ý kiến chuyên gia đấy.{\i0}
Dialogue: 0,0:09:18.89,0:09:19.89,Default,,0,0,0,,{\i1}Thật sao?{\i0}
Dialogue: 0,0:09:19.98,0:09:24.65,Default,,0,0,0,,{\i1}Vi mạch ở cổ cậu ấy…\Nkhông phải con chip bình thường. Không hề.{\i0}
Dialogue: 0,0:09:25.15,0:09:28.15,Default,,0,0,0,,{\i1}Hẳn nó là một nguyên mẫu\Nhay thứ gì đó tương tự.{\i0}
Dialogue: 0,0:09:28.82,0:09:32.03,Default,,0,0,0,,{\i1}Rắc rối bắt đầu\Ntừ lần đầu cậu ấy cắm nó à?{\i0}
Dialogue: 0,0:09:32.66,0:09:33.79,Default,,0,0,0,,{\i1}Chắc vậy.{\i0}
Dialogue: 0,0:09:33.86,0:09:39.37,Default,,0,0,0,,{\an8}{\i1}Cậu biết gì về vi mạch đó, kể tôi nghe đi.\NCó thể cậu là mấu chốt giúp D đấy.{\i0}
Dialogue: 0,0:09:40.45,0:09:44.75,Default,,0,0,0,,{\an8}{\i1}Có lần… anh ấy cắm vi mạch\Nvào một cô gái, một người bạn của tôi.{\i0}
Dialogue: 0,0:09:44.83,0:09:47.92,Default,,0,0,0,,{\an8}{\i1}Hắn cắm con chip vào người khác ư?{\i0}
Dialogue: 0,0:09:48.46,0:09:52.01,Default,,0,0,0,,{\an8}{\i1}Hắn tháo con chip ra\Nvà cắm nó vào một người bạn?{\i0}
Dialogue: 0,0:09:52.09,0:09:54.26,Default,,0,0,0,,{\i1}Rồi cắm lại vào mình sao?{\i0}
Dialogue: 0,0:09:54.34,0:09:56.01,Default,,0,0,0,,{\an8}{\i1}Cô ấy thế nào?{\i0}
Dialogue: 0,0:09:56.51,0:10:01.47,Default,,0,0,0,,{\an8}{\i1}Được đưa vào viện.\NCô ấy không thể cử động một lúc.{\i0}
Dialogue: 0,0:10:01.56,0:10:05.77,Default,,0,0,0,,{\an8}{\i1}Giờ cô ấy ổn, tôi nghĩ vậy.\NCó vẻ rất tệ, nhưng đã hồi phục.{\i0}
Dialogue: 0,0:10:06.27,0:10:07.40,Default,,0,0,0,,{\an8}{\i1}Cô ấy hồi phục sao?{\i0}
Dialogue: 0,0:10:09.40,0:10:11.65,Default,,0,0,0,,{\an8}{\i1}Này Kyoko? Cô biết gì à?{\i0}
Dialogue: 0,0:10:11.74,0:10:13.58,Default,,0,0,0,,{\an8}{\i1}Cậu nói cô ấy khỏe mạnh ư?{\i0}
Dialogue: 0,0:10:13.65,0:10:15.86,Default,,0,0,0,,{\an8}{\i1}Ừ, đại loại thế. Ít nhất là ổn định.{\i0}
Dialogue: 0,0:10:15.95,0:10:17.66,Default,,0,0,0,,{\an8}{\i1}Vẫn phải nằm viện.{\i0}
Dialogue: 0,0:10:17.74,0:10:18.74,Default,,0,0,0,,{\an8}{\i1}Bệnh viện nào?{\i0}
Dialogue: 0,0:10:19.24,0:10:21.83,Default,,0,0,0,,{\an8}Kyoko, sao tự dưng cô quan tâm vậy?
Dialogue: 0,0:10:21.91,0:10:23.62,Default,,0,0,0,,{\an8}Cô định làm gì?
Dialogue: 0,0:10:23.71,0:10:26.38,Default,,0,0,0,,{\an8}Cô xem tin tức rồi chứ?\ND hiện không có ở đây.
Dialogue: 0,0:10:26.46,0:10:29.34,Default,,0,0,0,,{\an8}- Vi mạch này…\N- {\i1}Xin lỗi. Tôi gọi lại sau nhé.{\i0}
Dialogue: 0,0:10:31.76,0:10:33.43,Default,,0,0,0,,ĐANG GỌI: ROMAN\NCUỘC GỌI BỊ CHẶN
Dialogue: 0,0:10:33.51,0:10:37.72,Default,,0,0,0,,Không nghi ngờ gì nữa. Nhân cách của Capri\Nbị bóc tách ngay lúc đó!
Dialogue: 0,0:10:38.22,0:10:40.81,Default,,0,0,0,,- Không thể nào…\N- Chuyện gì? Sao vậy?
Dialogue: 0,0:10:45.65,0:10:47.57,Default,,0,0,0,,{\an8}TÊN AVIDA YANG\NVUI LÒNG NHẸ TAY
Dialogue: 0,0:11:00.49,0:11:01.32,Default,,0,0,0,,{\an8}Talia.
Dialogue: 0,0:11:02.45,0:11:04.91,Default,,0,0,0,,{\an8}Sao mẹ lại chết?
Dialogue: 0,0:11:05.87,0:11:07.00,Default,,0,0,0,,{\an8}Tôi xin lỗi.
Dialogue: 0,0:11:07.50,0:11:10.00,Default,,0,0,0,,{\an8}Không phải ông đến để nói chuyện đó ư?
Dialogue: 0,0:11:10.50,0:11:13.34,Default,,0,0,0,,{\an8}Ông đâu đến vì lo lắng, đúng không?
Dialogue: 0,0:11:14.17,0:11:15.00,Default,,0,0,0,,{\an8}Ừ.
Dialogue: 0,0:11:19.64,0:11:23.31,Default,,0,0,0,,{\an8}Avida và tôi đã đột nhập\Nvào cơ sở nghiên cứu của Kang Tao.
Dialogue: 0,0:11:23.89,0:11:27.48,Default,,0,0,0,,{\an8}Đến cuối, bọn tôi bị phát hiện.\NAvida bị bắn khi chạy trốn.
Dialogue: 0,0:11:28.31,0:11:30.85,Default,,0,0,0,,{\an8}Tới lúc bọn tôi đến bệnh viện, cô ấy đã…
Dialogue: 0,0:11:31.90,0:11:33.61,Default,,0,0,0,,{\an8}Sao mẹ lại làm thế?
Dialogue: 0,0:11:34.11,0:11:37.15,Default,,0,0,0,,{\an8}Bọn tôi định kiếm cho cháu một cơ thể mới.
Dialogue: 0,0:11:37.86,0:11:40.11,Default,,0,0,0,,{\an8}Cơ thể? Cho tôi sao?
Dialogue: 0,0:11:40.62,0:11:44.04,Default,,0,0,0,,{\an8}Nếu chuyển linh hồn của cháu\Nvào một cơ thể mới,
Dialogue: 0,0:11:44.54,0:11:46.42,Default,,0,0,0,,{\an8}cháu có thể tiếp tục sống.
Dialogue: 0,0:11:46.91,0:11:50.96,Default,,0,0,0,,- Linh hồn của tôi ư?\N- Chương trình đó có tên là Soulkiller.
Dialogue: 0,0:11:51.46,0:11:55.59,Default,,0,0,0,,Arasaka phát triển nó\Nvà Kang Tao có một bản sao.
Dialogue: 0,0:11:56.09,0:12:00.43,Default,,0,0,0,,Bọn tôi đột nhập\Nđể trộm một trong những cơ thể đó.
Dialogue: 0,0:12:01.43,0:12:05.10,Default,,0,0,0,,Hai người định làm vậy thật ư?\NCả mẹ tôi nữa?
Dialogue: 0,0:12:05.93,0:12:08.35,Default,,0,0,0,,Bọn tôi muốn cứu cháu.
Dialogue: 0,0:12:09.48,0:12:12.19,Default,,0,0,0,,Ai mượn các người?
Dialogue: 0,0:12:13.32,0:12:16.07,Default,,0,0,0,,Các người nghĩ tôi muốn vậy ư?
Dialogue: 0,0:12:17.99,0:12:21.03,Default,,0,0,0,,Avida… đã do dự. Đến tận phút cuối.
Dialogue: 0,0:12:22.95,0:12:24.41,Default,,0,0,0,,Cái quái gì vậy?
Dialogue: 0,0:12:25.20,0:12:27.08,Default,,0,0,0,,Nó có nghĩa là sao?
Dialogue: 0,0:12:43.60,0:12:46.27,Default,,0,0,0,,Talia. Trông con khỏe nhỉ?
Dialogue: 0,0:12:46.85,0:12:47.93,Default,,0,0,0,,Bố?
Dialogue: 0,0:12:48.56,0:12:51.98,Default,,0,0,0,,Bố đến muộn rồi. Mẹ đã hóa thành tro bụi.
Dialogue: 0,0:12:52.77,0:12:54.52,Default,,0,0,0,,Để cứu con!
Dialogue: 0,0:12:55.36,0:12:56.99,Default,,0,0,0,,Này, thằng khốn!
Dialogue: 0,0:12:57.57,0:12:59.49,Default,,0,0,0,,Talia! Hắn ta có mặt ở đó!
Dialogue: 0,0:12:59.57,0:13:02.36,Default,,0,0,0,,Ở cơ sở bọn tôi đột nhập,\Nhắn là chỉ huy đơn vị!
Dialogue: 0,0:13:03.70,0:13:07.12,Default,,0,0,0,,Hắn biết Avida ở đó và vẫn nổ súng!
Dialogue: 0,0:13:07.79,0:13:09.37,Default,,0,0,0,,Bịt mồm hắn lại.
Dialogue: 0,0:13:13.58,0:13:14.92,Default,,0,0,0,,Chết tiệt, thôi đi!
Dialogue: 0,0:13:19.88,0:13:21.34,Default,,0,0,0,,Đi với bố nào.
Dialogue: 0,0:13:21.84,0:13:23.76,Default,,0,0,0,,Bố đã bắn mẹ à?
Dialogue: 0,0:13:24.35,0:13:25.27,Default,,0,0,0,,Vớ vẩn.
Dialogue: 0,0:13:25.35,0:13:28.85,Default,,0,0,0,,Chính mắt tôi thấy! Anh đã giết Avida!
Dialogue: 0,0:13:28.93,0:13:30.68,Default,,0,0,0,,Tôi bảo bịt mồm hắn lại.
Dialogue: 0,0:13:32.65,0:13:34.74,Default,,0,0,0,,- Đủ rồi.\N- Trả lời đi!
Dialogue: 0,0:13:34.81,0:13:37.56,Default,,0,0,0,,Đừng chạm vào tôi. Buông ra!
Dialogue: 0,0:13:37.65,0:13:40.07,Default,,0,0,0,,Capri! Làm gì đi!
Dialogue: 0,0:13:41.20,0:13:42.41,Default,,0,0,0,,Đừng…
Dialogue: 0,0:13:43.66,0:13:46.04,Default,,0,0,0,,Đừng động vào con gái tôi.
Dialogue: 0,0:13:46.12,0:13:48.75,Default,,0,0,0,,Hả? Anh đang lảm nhảm gì vậy?
Dialogue: 0,0:13:48.83,0:13:51.83,Default,,0,0,0,,- Anh mất trí rồi à?\N- Avida đã nói với tôi.
Dialogue: 0,0:13:51.91,0:13:54.04,Default,,0,0,0,,Talia là con gái tôi.
Dialogue: 0,0:13:56.04,0:14:02.26,Default,,0,0,0,,Ra vậy. Avida đã nói thế à?\NMọi chuyện đã rõ.
Dialogue: 0,0:14:10.64,0:14:13.06,Default,,0,0,0,,Thật tiếc cho anh. Nhìn đi.
Dialogue: 0,0:14:14.65,0:14:18.78,Default,,0,0,0,,Bằng chứng đây. Talia là con tôi.
Dialogue: 0,0:14:27.49,0:14:28.49,Default,,0,0,0,,Gen di truyền!
Dialogue: 0,0:14:28.99,0:14:29.91,Default,,0,0,0,,Dòng máu!
Dialogue: 0,0:14:30.41,0:14:31.37,Default,,0,0,0,,Cấu trúc xương!
Dialogue: 0,0:14:31.87,0:14:32.83,Default,,0,0,0,,Mọi thứ!
Dialogue: 0,0:14:33.33,0:14:35.04,Default,,0,0,0,,Tất cả đều nói nó là con tôi!
Dialogue: 0,0:14:35.62,0:14:37.96,Default,,0,0,0,,Talia là con gái tôi!
Dialogue: 0,0:14:51.02,0:14:53.06,Default,,0,0,0,,Sao anh không kiểm tra?
Dialogue: 0,0:14:53.14,0:14:56.31,Default,,0,0,0,,Anh có thể tự mình xác minh mà.
Dialogue: 0,0:14:58.69,0:15:00.69,Default,,0,0,0,,Anh đã chọn không làm thế nhỉ?
Dialogue: 0,0:15:01.82,0:15:04.70,Default,,0,0,0,,Vì anh sợ sự thật.
Dialogue: 0,0:15:05.45,0:15:07.58,Default,,0,0,0,,Talia là con gái tôi.
Dialogue: 0,0:15:17.33,0:15:20.83,Default,,0,0,0,,Talia là con gái tôi!
Dialogue: 0,0:15:27.26,0:15:28.35,Default,,0,0,0,,Bố?
Dialogue: 0,0:15:28.97,0:15:31.56,Default,,0,0,0,,Bố đã giết mẹ à?
Dialogue: 0,0:15:32.31,0:15:33.85,Default,,0,0,0,,Con biết thì có ích gì?
Dialogue: 0,0:16:06.17,0:16:07.17,Default,,0,0,0,,Avida…
Dialogue: 0,0:16:19.77,0:16:22.56,Default,,0,0,0,,Lúc trước cậu không phải thế này.
Dialogue: 0,0:16:25.78,0:16:31.66,Default,,0,0,0,,Cậu nhớ không?\NCậu từng cứu tôi một lần. Hồi ta…
Dialogue: 0,0:16:34.83,0:16:38.58,Default,,0,0,0,,Họ đi rồi.
Dialogue: 0,0:16:40.54,0:16:44.96,Default,,0,0,0,,Những kẻ tấn công tộc của chúng ta,\Nkẻ ra lệnh lúc đó…
Dialogue: 0,0:16:45.46,0:16:47.00,Default,,0,0,0,,Tất cả đều đã chết.
Dialogue: 0,0:16:48.67,0:16:51.38,Default,,0,0,0,,Cuối cùng, tôi chẳng làm được gì.
Dialogue: 0,0:16:52.18,0:16:53.02,Default,,0,0,0,,Ừ.
Dialogue: 0,0:16:54.81,0:16:56.48,Default,,0,0,0,,Tôi phải làm gì đây?
Dialogue: 0,0:17:07.11,0:17:09.11,Default,,0,0,0,,Ra vậy. Thảo nào.
Dialogue: 0,0:17:09.19,0:17:10.65,Default,,0,0,0,,Ra vậy…
Dialogue: 0,0:17:10.74,0:17:14.91,Default,,0,0,0,,Ừm, hiểu rồi. Đợi đã.
Dialogue: 0,0:17:14.99,0:17:17.08,Default,,0,0,0,,Tay chân cô ấy có nam châm điện à?
Dialogue: 0,0:17:17.58,0:17:18.62,Default,,0,0,0,,Nó hiệu quả chứ?
Dialogue: 0,0:17:18.70,0:17:22.16,Default,,0,0,0,,Dùng để hỗ trợ chuyển động nhỉ?\NBộ cô ấy trong đoàn xiếc à?
Dialogue: 0,0:17:23.75,0:17:26.59,Default,,0,0,0,,Này, bình tĩnh đi. Tôi chỉ hỏi thôi.
Dialogue: 0,0:17:28.84,0:17:30.51,Default,,0,0,0,,Cô ấy ốm nặng nhỉ?
Dialogue: 0,0:17:31.55,0:17:35.30,Default,,0,0,0,,Chúng tôi thay phần ốm nặng\Nbằng siêu thiết bị để khắc phục.
Dialogue: 0,0:17:35.97,0:17:38.43,Default,,0,0,0,,Và nghĩ con bé có sức chịu đựng đặc biệt.
Dialogue: 0,0:17:38.93,0:17:43.39,Default,,0,0,0,,Có đấy. Tôi thấy cô ấy\Ntrong danh sách của Arasaka.
Dialogue: 0,0:17:43.90,0:17:47.57,Default,,0,0,0,,- Có tiềm năng làm vật chủ cho Capricorn.\N- Thật ư?
Dialogue: 0,0:17:47.65,0:17:52.78,Default,,0,0,0,,{\an8}Nhưng họ chưa bạo đến mức\Nnhắm vào con gái giám đốc công ty đối thủ.
Dialogue: 0,0:17:53.28,0:17:55.41,Default,,0,0,0,,{\an8}Nhưng như vậy vẫn ổn chứ?
Dialogue: 0,0:17:55.49,0:17:56.32,Default,,0,0,0,,{\an8}Ý anh là sao?
Dialogue: 0,0:17:56.95,0:18:02.62,Default,,0,0,0,,Con bé đã ở ngưỡng siêu cuồng nhân.\NSức chịu đựng của nó đã đạt tới giới hạn.
Dialogue: 0,0:18:03.12,0:18:05.29,Default,,0,0,0,,Tổn thương đã lan đến não.
Dialogue: 0,0:18:05.38,0:18:08.05,Default,,0,0,0,,Bác sĩ nói thời gian không còn nhiều.
Dialogue: 0,0:18:08.71,0:18:10.09,Default,,0,0,0,,Dù cài đặt thành công,
Dialogue: 0,0:18:10.17,0:18:14.09,Default,,0,0,0,,nếu Talia chết, Capricorn sẽ ra sao?
Dialogue: 0,0:18:15.76,0:18:16.59,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:18:17.22,0:18:19.85,Default,,0,0,0,,Anh lo cho ai vậy?
Dialogue: 0,0:18:21.43,0:18:24.93,Default,,0,0,0,,Không sao đâu. Có tổn thương não,
Dialogue: 0,0:18:25.02,0:18:27.23,Default,,0,0,0,,nhưng trong quá trình cài đặt,
Dialogue: 0,0:18:27.31,0:18:30.73,Default,,0,0,0,,quy trình sửa chữa của Capricorn\Nđã khắc phục một phần.
Dialogue: 0,0:18:31.69,0:18:34.32,Default,,0,0,0,,Khi lắp đặt xong, nó sẽ chữa tiếp.
Dialogue: 0,0:18:34.82,0:18:40.16,Default,,0,0,0,,Nhưng như vậy, nhân cách ban đầu của cô ấy\Nsẽ bị ghi đè và huỷ hoại.
Dialogue: 0,0:18:40.95,0:18:41.99,Default,,0,0,0,,Thế à?
Dialogue: 0,0:18:42.58,0:18:44.17,Default,,0,0,0,,Vậy là có thể cài đặt nhỉ?
Dialogue: 0,0:18:44.92,0:18:48.88,Default,,0,0,0,,Làm thế đi. Dù sao con bé\Ncũng không còn nhiều thời gian.
Dialogue: 0,0:18:48.96,0:18:52.42,Default,,0,0,0,,Tốt. Đúng là giọng lưỡi\Nngười của tập đoàn.
Dialogue: 0,0:19:04.64,0:19:05.47,Default,,0,0,0,,{\an8}Này.
Dialogue: 0,0:19:06.98,0:19:07.86,Default,,0,0,0,,Capri.
Dialogue: 0,0:19:08.98,0:19:11.98,Default,,0,0,0,,Xin lỗi, nhưng giờ cô sẽ biến mất.
Dialogue: 0,0:19:12.61,0:19:15.41,Default,,0,0,0,,Về mặt kỹ thuật, cô sẽ hòa vào tôi.
Dialogue: 0,0:19:16.24,0:19:17.16,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:19:18.03,0:19:19.32,Default,,0,0,0,,Thế thôi à?
Dialogue: 0,0:19:19.83,0:19:21.71,Default,,0,0,0,,Cô đúng là một người kỳ lạ.
Dialogue: 0,0:19:23.25,0:19:24.71,Default,,0,0,0,,Không có gì hối tiếc à?
Dialogue: 0,0:19:25.96,0:19:27.80,Default,,0,0,0,,Có, nhưng…
Dialogue: 0,0:19:35.88,0:19:37.92,Default,,0,0,0,,Thật ra…
Dialogue: 0,0:19:38.51,0:19:40.72,Default,,0,0,0,,Cô giết ông ta giúp tôi nhé?
Dialogue: 0,0:19:41.26,0:19:42.89,Default,,0,0,0,,Càng ghê rợn càng tốt.
Dialogue: 0,0:19:43.93,0:19:45.56,Default,,0,0,0,,Vì mẹ tôi.
Dialogue: 0,0:19:47.64,0:19:48.68,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:19:55.28,0:19:56.66,Default,,0,0,0,,Kyoko.
Dialogue: 0,0:20:08.08,0:20:10.12,Default,,0,0,0,,Ừm. Tuyệt.
Dialogue: 0,0:20:10.75,0:20:12.88,Default,,0,0,0,,Mở khóa cho cô ta có an toàn không?
Dialogue: 0,0:20:12.96,0:20:14.30,Default,,0,0,0,,Tôi đâu có mở.
Dialogue: 0,0:20:14.38,0:20:15.38,Default,,0,0,0,,Sao?
Dialogue: 0,0:20:15.88,0:20:17.88,Default,,0,0,0,,Cảm ơn Kyoko.
Dialogue: 0,0:20:21.43,0:20:24.18,Default,,0,0,0,,Cuối cùng tôi\Ncũng có thể làm gì tùy thích.
Dialogue: 0,0:20:24.26,0:20:26.93,Default,,0,0,0,,Đừng đi tới đi lui nữa. Ngồi xuống đi.
Dialogue: 0,0:20:32.98,0:20:34.27,Default,,0,0,0,,Khống chế cô ta!
Dialogue: 0,0:20:43.62,0:20:47.17,Default,,0,0,0,,Tôi được yêu cầu\Nlàm cho nó càng ghê rợn càng tốt.
Dialogue: 0,0:20:47.25,0:20:50.25,Default,,0,0,0,,Giết ông ngay lập tức thì chán lắm.
Dialogue: 0,0:20:50.33,0:20:52.54,Default,,0,0,0,,Tôi sẽ cho ông ba phút. Chạy đi,
Dialogue: 0,0:20:52.63,0:20:54.26,Default,,0,0,0,,thưa bố.
Dialogue: 0,0:20:56.34,0:20:57.55,Default,,0,0,0,,Đừng có giỡn mặt!
Dialogue: 0,0:21:06.14,0:21:09.39,Default,,0,0,0,,Ông nghĩ đó là biện pháp đối phó à?
Dialogue: 0,0:21:11.94,0:21:13.07,Default,,0,0,0,,Đó là chấp đấy!
Dialogue: 0,0:21:13.15,0:21:17.49,Default,,0,0,0,,- Chết tiệt! Chấp cái…\N- Ồ, đúng nhỉ? Ngược hết rồi.
Dialogue: 0,0:21:17.57,0:21:20.57,Default,,0,0,0,,Tôi phải chấp ông mới đúng. Xin lỗi !
Dialogue: 0,0:21:20.65,0:21:21.90,Default,,0,0,0,,Cái quái…
Dialogue: 0,0:21:25.53,0:21:27.82,Default,,0,0,0,,Tôi đếm ngược đây.
Dialogue: 0,0:21:28.45,0:21:30.58,Default,,0,0,0,,Mười, chín,
Dialogue: 0,0:21:30.66,0:21:32.33,Default,,0,0,0,,tám!
Dialogue: 0,0:21:34.42,0:21:35.59,Default,,0,0,0,,Capri!
Dialogue: 0,0:21:37.75,0:21:38.67,Default,,0,0,0,,Cô còn sống…
Dialogue: 0,0:21:39.72,0:21:40.85,Default,,0,0,0,,Cô…
Dialogue: 0,0:21:40.92,0:21:42.51,Default,,0,0,0,,{\an8}xong chưa?
Dialogue: 0,0:21:43.22,0:21:44.56,Default,,0,0,0,,{\an8}Cô là Capri thật à?
Dialogue: 0,0:21:46.22,0:21:50.47,Default,,0,0,0,,Sao cuối cùng,\Nai cũng bị việc trả thù ám ảnh thế nhỉ?
Dialogue: 0,0:21:51.81,0:21:55.23,Default,,0,0,0,,Trả thù vui đến thế à?
Dialogue: 0,0:21:55.31,0:21:56.73,Default,,0,0,0,,Cô đang…
Dialogue: 0,0:21:57.86,0:21:59.95,Default,,0,0,0,,Này, Capri!
Dialogue: 0,0:22:23.59,0:22:25.88,Default,,0,0,0,,{\i1}Đối tượng đã trốn thóat.{\i0}
Dialogue: 0,0:22:25.97,0:22:29.02,Default,,0,0,0,,{\i1}Ta cần triển khai an ninh để bắt cô ta.{\i0}
Dialogue: 0,0:22:29.10,0:22:31.56,Default,,0,0,0,,{\i1}Trốn thoát? Anh nói gì vậy?{\i0}
Dialogue: 0,0:22:31.64,0:22:35.85,Default,,0,0,0,,{\i1}Tôi sẽ báo cáo đầy đủ sau.\NCứ điều quân đi!{\i0}
Dialogue: 0,0:22:36.36,0:22:39.91,Default,,0,0,0,,{\i1}Điều quân đến đâu? Đợi đã.{\i0}
Dialogue: 0,0:22:40.40,0:22:43.82,Default,,0,0,0,,{\i1}- Gì vậy?\N- Tôi thấy anh rồi.{\i0}
Dialogue: 0,0:22:59.00,0:23:00.13,Default,,0,0,0,,Cái gì đây?
Dialogue: 0,0:23:01.13,0:23:03.22,Default,,0,0,0,,{\i1}- Mau lên…\N- Mau lên.{\i0}
Dialogue: 0,0:23:03.72,0:23:05.14,Default,,0,0,0,,- Chết tiệt!\N{\i1}- Chết tiệt!{\i0}
Dialogue: 0,0:23:07.14,0:23:11.06,Default,,0,0,0,,Nào, nhanh chân lên!
Dialogue: 0,0:23:11.14,0:23:12.18,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:23:12.27,0:23:14.94,Default,,0,0,0,,Đúng rồi! Tăng tốc lên!
Dialogue: 0,0:23:22.40,0:23:23.65,Default,,0,0,0,,Talia?
Dialogue: 0,0:23:26.66,0:23:27.49,Default,,0,0,0,,Này.
Dialogue: 0,0:23:28.12,0:23:31.46,Default,,0,0,0,,Hôm qua cậu hỏi cậu nên làm gì.
Dialogue: 0,0:23:33.29,0:23:38.46,Default,,0,0,0,,Cậu có thể làm bất cứ điều gì.\NQuá khứ và hiện tại không quan trọng.
Dialogue: 0,0:23:39.13,0:23:41.30,Default,,0,0,0,,Cậu nên làm điều cậu muốn,
Dialogue: 0,0:23:41.92,0:23:42.84,Default,,0,0,0,,David.
Dialogue: 0,0:23:57.02,0:23:57.98,Default,,0,0,0,,Capri.
Dialogue: 0,0:24:06.36,0:24:09.95,Default,,0,0,0,,{\i1}- Ai đấy?\N- Nhận chỉ thị bắt Capricorn.{\i0}
Dialogue: 0,0:24:10.45,0:24:11.91,Default,,0,0,0,,{\i1}Đội quân sẽ đến ngay.{\i0}
Dialogue: 0,0:24:11.99,0:24:13.99,Default,,0,0,0,,{\i1}Thẳng đến đại lộ đi.{\i0}
Dialogue: 0,0:24:14.08,0:24:15.21,Default,,0,0,0,,{\i1}Hiểu rồi.{\i0}
Dialogue: 0,0:24:25.05,0:24:27.64,Default,,0,0,0,,Ồ, xong rồi à?
Dialogue: 0,0:24:51.74,0:24:54.03,Default,,0,0,0,,Này! Cậu nghĩ mình đi đâu đấy?
Dialogue: 0,0:24:55.29,0:24:59.25,Default,,0,0,0,,- Đi tìm Capri.\N- Capri? Capri là gì?
Dialogue: 0,0:25:02.50,0:25:03.96,Default,,0,0,0,,Đây là điều cuối cùng.
Dialogue: 0,0:25:05.75,0:25:08.17,Default,,0,0,0,,Đây là điểm cuối, Omi.
Dialogue: 0,0:25:10.93,0:25:14.85,Default,,0,0,0,,{\an8}Hãy giúp tôi một tay.\NTôi không thể làm chuyện này một mình.
Dialogue: 0,0:25:22.10,0:25:24.65,Default,,0,0,0,,{\an8}- Cậu nói gì vậy?\N- Đau!
Dialogue: 0,0:25:25.15,0:25:28.32,Default,,0,0,0,,- Sao lại đánh tôi?\N- Tôi chẳng hiểu gì cả.
Dialogue: 0,0:25:28.82,0:25:31.45,Default,,0,0,0,,Nhưng được rồi. Tôi sẽ giúp cậu.
Dialogue: 0,0:25:31.53,0:25:33.99,Default,,0,0,0,,Ít nhất cũng để tôi thay đồ đã.
Dialogue: 0,0:25:40.04,0:25:43.96,Default,,0,0,0,,Ôi. Chuyện này thật tẻ nhạt.
