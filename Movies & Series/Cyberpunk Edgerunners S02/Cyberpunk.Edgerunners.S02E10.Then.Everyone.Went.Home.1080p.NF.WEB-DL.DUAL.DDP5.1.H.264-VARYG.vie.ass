Dialogue: 0,0:00:11.26,0:00:14.22,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:00:14.31,0:00:17.56,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:01:43.10,0:01:46.65,Default,,0,0,0,,Chết tiệt! Dừng lại. Dừng lại đi, Talia!
Dialogue: 0,0:01:47.15,0:01:48.28,Default,,0,0,0,,Viện binh đâu rồi?
Dialogue: 0,0:01:48.36,0:01:49.28,Default,,0,0,0,,Talia!
Dialogue: 0,0:01:50.69,0:01:54.78,Default,,0,0,0,,Cô đang làm gì vậy, Talia? Đó là bố cô mà!
Dialogue: 0,0:01:55.91,0:01:58.87,Default,,0,0,0,,Hử? Hôm nay không có camera à, Roman?
Dialogue: 0,0:01:59.87,0:02:02.37,Default,,0,0,0,,- Talia?\N- Tha cho tôi đi.
Dialogue: 0,0:02:02.87,0:02:05.58,Default,,0,0,0,,- Đó không phải bố tôi.\N- Talia, làm ơn.
Dialogue: 0,0:02:05.67,0:02:07.17,Default,,0,0,0,,- Bố là…\N- Im đi!
Dialogue: 0,0:02:10.51,0:02:14.39,Default,,0,0,0,,Ông ta đã giết mẹ tôi!\NMột kẻ như thế không phải là bố tôi.
Dialogue: 0,0:02:18.56,0:02:21.60,Default,,0,0,0,,Tôi đã hứa giết ông ta cho cô mà.
Dialogue: 0,0:02:36.87,0:02:38.00,Default,,0,0,0,,Talia!
Dialogue: 0,0:02:38.07,0:02:39.20,Default,,0,0,0,,Tránh ra, nhóc!
Dialogue: 0,0:02:39.28,0:02:41.07,Default,,0,0,0,,Đã xác nhận mục tiêu.
Dialogue: 0,0:02:41.16,0:02:44.50,Default,,0,0,0,,Rõ. Nhắm vào tay và chân. Đừng giết cô ta.
Dialogue: 0,0:02:54.38,0:02:56.13,Default,,0,0,0,,Bắt lấy trong lúc cô ta ngã…
Dialogue: 0,0:03:06.85,0:03:07.89,Default,,0,0,0,,Này!
Dialogue: 0,0:03:18.24,0:03:20.41,Default,,0,0,0,,Này! Lấy xe đi! Mau lên!
Dialogue: 0,0:03:20.49,0:03:21.87,Default,,0,0,0,,Hả? Nhưng…
Dialogue: 0,0:03:21.95,0:03:23.91,Default,,0,0,0,,Nó đang đuổi theo tôi!
Dialogue: 0,0:03:32.25,0:03:33.17,Default,,0,0,0,,{\i1}Yêu cầu tiếp viện!{\i0}
Dialogue: 0,0:03:33.25,0:03:34.59,Default,,0,0,0,,{\i1}- Báo cáo đi!\N- Rút lui!{\i0}
Dialogue: 0,0:03:35.26,0:03:38.43,Default,,0,0,0,,{\i1}Đưa chúng tôi rời đi đi, mau lên!\NĐi đâu cũng được!{\i0}
Dialogue: 0,0:03:44.39,0:03:45.60,Default,,0,0,0,,Cô là….
Dialogue: 0,0:03:47.35,0:03:48.43,Default,,0,0,0,,Capri à?
Dialogue: 0,0:03:48.94,0:03:50.07,Default,,0,0,0,,D?
Dialogue: 0,0:03:51.19,0:03:52.15,Default,,0,0,0,,Hả?
Dialogue: 0,0:03:55.15,0:03:57.36,Default,,0,0,0,,Hắn còn sống à?
Dialogue: 0,0:04:00.91,0:04:02.20,Default,,0,0,0,,Im đi!
Dialogue: 0,0:04:07.16,0:04:10.00,Default,,0,0,0,,Im đi! Chết tiệt!
Dialogue: 0,0:04:17.84,0:04:20.01,Default,,0,0,0,,{\i1}D! D, đợi đã!{\i0}
Dialogue: 0,0:04:38.70,0:04:41.08,Default,,0,0,0,,- Ui da!\N- Cậu đang làm cái quái gì vậy?
Dialogue: 0,0:04:41.99,0:04:44.58,Default,,0,0,0,,Đau quá! Dừng lại đi, Omi!
Dialogue: 0,0:04:45.79,0:04:48.25,Default,,0,0,0,,Hả? Gì đây? Roman?
Dialogue: 0,0:04:48.96,0:04:51.00,Default,,0,0,0,,Sao cậu lại ở đây?
Dialogue: 0,0:04:56.84,0:05:00.64,Default,,0,0,0,,Phải rồi. Tôi nhớ ra rồi.\NLà cô ta nhỉ? Bạn gái cậu?
Dialogue: 0,0:05:01.13,0:05:02.51,Default,,0,0,0,,Không phải bạn gái.
Dialogue: 0,0:05:03.43,0:05:06.27,Default,,0,0,0,,Capri lại làm gì trong người cô ta vậy?
Dialogue: 0,0:05:06.35,0:05:07.94,Default,,0,0,0,,{\i1}- Tôi làm đấy.{\i0}\N- Là D à?
Dialogue: 0,0:05:08.02,0:05:09.90,Default,,0,0,0,,- Sao tôi lại làm thế?\N{\i1}- Là tôi!{\i0}
Dialogue: 0,0:05:09.98,0:05:13.57,Default,,0,0,0,,- Thế sao Capri lại ở trong Talia?\N{\i1}- Đã nói là tôi mà!{\i0}
Dialogue: 0,0:05:13.65,0:05:15.19,Default,,0,0,0,,Cái loa này bị sao vậy?
Dialogue: 0,0:05:15.27,0:05:16.10,Default,,0,0,0,,Đợi đã.
Dialogue: 0,0:05:16.19,0:05:17.28,Default,,0,0,0,,{\i1}Câm mồm!{\i0}
Dialogue: 0,0:05:17.94,0:05:21.49,Default,,0,0,0,,{\i1}Tôi đã cắm vi mạch vào Talia!\NMừng là cậu không chết.{\i0}
Dialogue: 0,0:05:21.99,0:05:25.54,Default,,0,0,0,,{\i1}- Sai lầm của Kang Tao lại có lợi cho ta.{\i0}\N- Kyoko?
Dialogue: 0,0:05:26.91,0:05:29.58,Default,,0,0,0,,Roman, quả nhiên cậu ở đó.
Dialogue: 0,0:05:29.66,0:05:31.33,Default,,0,0,0,,{\i1}Kyoko, cô là người… Này!{\i0}
Dialogue: 0,0:05:31.41,0:05:33.79,Default,,0,0,0,,{\i1}Cô là người phụ nữ nhỏ con lúc trước à?{\i0}
Dialogue: 0,0:05:34.50,0:05:35.75,Default,,0,0,0,,Cô muốn gì?
Dialogue: 0,0:05:36.25,0:05:38.84,Default,,0,0,0,,{\i1}Cô ấy còn ở đó đúng không? Bên trong cậu.{\i0}
Dialogue: 0,0:05:38.92,0:05:41.17,Default,,0,0,0,,- Gì chứ?\N{\i1}- Tất cả phụ thuộc vào nó.{\i0}
Dialogue: 0,0:05:42.18,0:05:44.64,Default,,0,0,0,,{\i1}Cô ấy vẫn còn trong đầu cậu chứ?{\i0}
Dialogue: 0,0:05:45.30,0:05:46.18,Default,,0,0,0,,{\i1}Capri ấy.{\i0}
Dialogue: 0,0:05:48.10,0:05:51.77,Default,,0,0,0,,{\an8}Còn. Một chút. Nhưng chỉ một chút thôi.
Dialogue: 0,0:05:52.27,0:05:53.10,Default,,0,0,0,,{\an8}{\i1}Thế thì sao?{\i0}
Dialogue: 0,0:05:53.19,0:05:56.40,Default,,0,0,0,,{\an8}{\i1}- Cậu định dùng Capricorn nữa à?{\i0}\N- Dùng sao?
Dialogue: 0,0:05:56.48,0:05:58.40,Default,,0,0,0,,{\an8}{\i1}Phải. Một khi cậu có vi mạch…{\i0}
Dialogue: 0,0:05:58.48,0:06:01.78,Default,,0,0,0,,{\an8}Không đời nào. Tôi chỉ muốn gặp Capri.
Dialogue: 0,0:06:01.86,0:06:02.69,Default,,0,0,0,,{\an8}{\i1}Hả?{\i0}
Dialogue: 0,0:06:03.95,0:06:05.45,Default,,0,0,0,,Còn sau đó, tôi mặc kệ.
Dialogue: 0,0:06:10.20,0:06:12.33,Default,,0,0,0,,{\i1}Khá ấn tượng đấy.{\i0}
Dialogue: 0,0:06:12.41,0:06:14.83,Default,,0,0,0,,Ước gì ta có thể nói chuyện\Nvà mặc kệ sự tình.
Dialogue: 0,0:06:16.75,0:06:17.58,Default,,0,0,0,,{\i1}Được rồi.{\i0}
Dialogue: 0,0:06:17.67,0:06:19.59,Default,,0,0,0,,{\an8}{\i1}Tôi sẽ giúp cậu.{\i0}
Dialogue: 0,0:06:19.67,0:06:21.84,Default,,0,0,0,,{\an8}{\i1}Ai biết có lần sau không.{\i0}
Dialogue: 0,0:06:23.93,0:06:25.93,Default,,0,0,0,,{\an8}Cô quá tự mãn. Tôi không ưa nổi.
Dialogue: 0,0:06:26.47,0:06:29.01,Default,,0,0,0,,{\an8}Nhưng đúng là tôi không thể làm một mình.
Dialogue: 0,0:06:29.51,0:06:32.60,Default,,0,0,0,,{\an8}{\i1}Hả? Chuyện này suôn sẻ hơn tôi tưởng đấy.{\i0}
Dialogue: 0,0:06:36.19,0:06:37.94,Default,,0,0,0,,{\an8}Cậu cười gì thế?
Dialogue: 0,0:06:38.02,0:06:42.82,Default,,0,0,0,,{\an8}Không biết. Nhưng tôi biết\Ncậu nghiêm túc về chuyện này.
Dialogue: 0,0:06:42.90,0:06:44.24,Default,,0,0,0,,{\an8}Ý cậu là sao?
Dialogue: 0,0:06:44.32,0:06:45.15,Default,,0,0,0,,Này.
Dialogue: 0,0:06:46.95,0:06:47.83,Default,,0,0,0,,Cậu…
Dialogue: 0,0:06:47.91,0:06:50.25,Default,,0,0,0,,Ồ, xin lỗi, thật sự xin lỗi.
Dialogue: 0,0:06:52.41,0:06:53.24,Default,,0,0,0,,Này, D.
Dialogue: 0,0:06:53.33,0:06:55.75,Default,,0,0,0,,Anh không muốn trả thù nữa à?
Dialogue: 0,0:06:57.17,0:06:58.21,Default,,0,0,0,,{\an8}Không.
Dialogue: 0,0:07:14.56,0:07:17.02,Default,,0,0,0,,{\i1}Không bắt được. Yêu cầu sơ tán.{\i0}
Dialogue: 0,0:07:17.10,0:07:19.23,Default,,0,0,0,,{\i1}Hết thời gian rồi. Mau lên!{\i0}
Dialogue: 0,0:07:20.73,0:07:23.28,Default,,0,0,0,,{\i1}Chết tiệt! Dừng lại! Đừng lại gần ta!{\i0}
Dialogue: 0,0:07:30.49,0:07:33.08,Default,,0,0,0,,Dừng lại đi! Talia!
Dialogue: 0,0:07:39.67,0:07:40.80,Default,,0,0,0,,Dừng lại!
Dialogue: 0,0:07:46.34,0:07:47.80,Default,,0,0,0,,Đừng làm thế!
Dialogue: 0,0:07:50.30,0:07:51.68,Default,,0,0,0,,Gã này là của tôi!
Dialogue: 0,0:07:51.76,0:07:53.89,Default,,0,0,0,,Vì Avida!
Dialogue: 0,0:07:57.02,0:07:58.56,Default,,0,0,0,,Chết tiệt. Sao lại thế?
Dialogue: 0,0:08:02.02,0:08:03.61,Default,,0,0,0,,Đừng cản đường tôi!
Dialogue: 0,0:08:12.78,0:08:14.28,Default,,0,0,0,,Giết nó đi!
Dialogue: 0,0:08:14.87,0:08:17.46,Default,,0,0,0,,Nhưng chúng tôi được lệnh bắt sống…
Dialogue: 0,0:08:17.54,0:08:20.46,Default,,0,0,0,,- Kích thước quái gì thế?\N- Không nghe ai nói cả!
Dialogue: 0,0:08:20.54,0:08:22.21,Default,,0,0,0,,Cứ giết nó đi!
Dialogue: 0,0:08:28.55,0:08:29.68,Default,,0,0,0,,{\i1}Talia.{\i0}
Dialogue: 0,0:08:33.35,0:08:34.39,Default,,0,0,0,,{\i1}Chưa đâu.{\i0}
Dialogue: 0,0:08:36.06,0:08:38.06,Default,,0,0,0,,{\i1}Chưa đâu. Cháu vẫn ổn.{\i0}
Dialogue: 0,0:08:42.10,0:08:43.31,Default,,0,0,0,,{\i1}Tôi nói rồi.{\i0}
Dialogue: 0,0:08:44.02,0:08:45.86,Default,,0,0,0,,{\i1}Tôi sẽ ngăn cháu lại.{\i0}
Dialogue: 0,0:08:47.11,0:08:48.11,Default,,0,0,0,,{\i1}Chưa hết đâu.{\i0}
Dialogue: 0,0:08:48.61,0:08:50.28,Default,,0,0,0,,{\i1}Vẫn chưa quá muộn.{\i0}
Dialogue: 0,0:09:02.58,0:09:03.96,Default,,0,0,0,,{\i1}Talia.{\i0}
Dialogue: 0,0:09:43.17,0:09:44.76,Default,,0,0,0,,Cô làm cái quái gì vậy?
Dialogue: 0,0:09:45.63,0:09:49.05,Default,,0,0,0,,- Omi, rẽ phải ở đây đi.\N- Cậu biết cô ấy ở đâu à?
Dialogue: 0,0:09:49.71,0:09:50.63,Default,,0,0,0,,{\an8}Đại loại thế.
Dialogue: 0,0:09:52.63,0:09:54.80,Default,,0,0,0,,Không. Chuyện này sai rồi.
Dialogue: 0,0:09:55.30,0:09:58.34,Default,,0,0,0,,Ta không… Sao lại nhắm vào ta, Talia?
Dialogue: 0,0:09:58.85,0:10:03.06,Default,,0,0,0,,{\an8}- Bắt nó có thể sẽ khó đấy.\N- Đúng vậy.
Dialogue: 0,0:10:03.14,0:10:05.77,Default,,0,0,0,,{\an8}Hãy xử nó\Ntrước khi các tập đoàn khác chú ý.
Dialogue: 0,0:10:06.27,0:10:07.61,Default,,0,0,0,,{\an8}Sau đó ta sẽ phục hồi.
Dialogue: 0,0:10:07.69,0:10:08.94,Default,,0,0,0,,{\an8}Nhưng bằng cách nào?
Dialogue: 0,0:10:09.44,0:10:13.36,Default,,0,0,0,,{\an8}- Cách nhanh nhất là không kích.\N- Ở Thành phố Đêm ư?
Dialogue: 0,0:10:17.87,0:10:20.66,Default,,0,0,0,,Rõ. Chúng tôi sẽ dẫn nó về phía Nam.
Dialogue: 0,0:10:21.83,0:10:24.58,Default,,0,0,0,,Chết tiệt, tệ thật. Không kích ư?
Dialogue: 0,0:10:24.67,0:10:27.26,Default,,0,0,0,,Này! Anh đi đâu vậy?
Dialogue: 0,0:10:27.92,0:10:30.01,Default,,0,0,0,,{\i1}Phía Nam? Vùng Đất Hoang?{\i0}
Dialogue: 0,0:10:31.76,0:10:33.09,Default,,0,0,0,,{\an8}Không kích!
Dialogue: 0,0:10:46.98,0:10:48.07,Default,,0,0,0,,Avida.
Dialogue: 0,0:10:59.53,0:11:00.37,Default,,0,0,0,,Talia.
Dialogue: 0,0:11:00.95,0:11:01.79,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:11:02.45,0:11:03.49,Default,,0,0,0,,Khốn nạn!
Dialogue: 0,0:11:25.27,0:11:26.11,Default,,0,0,0,,{\an8}ĐANG GỌI\NROMAN
Dialogue: 0,0:11:26.19,0:11:27.27,Default,,0,0,0,,{\an8}{\i1}Kyoko?{\i0}
Dialogue: 0,0:11:27.35,0:11:28.39,Default,,0,0,0,,{\i1}Cậu ta đâu rồi?{\i0}
Dialogue: 0,0:11:28.48,0:11:29.90,Default,,0,0,0,,{\i1}Chuyện quái gì vậy?{\i0}
Dialogue: 0,0:11:29.98,0:11:32.90,Default,,0,0,0,,{\i1}Bọn Kang Tao.\NChúng sẽ không kích nhằm vào Capri.{\i0}
Dialogue: 0,0:11:32.98,0:11:35.48,Default,,0,0,0,,{\i1}Cái gì? Talia sẽ ra sao?{\i0}
Dialogue: 0,0:11:35.57,0:11:37.91,Default,,0,0,0,,{\i1}Bình tĩnh đi nhóc. Vẫn còn thời gian.{\i0}
Dialogue: 0,0:11:37.99,0:11:39.58,Default,,0,0,0,,{\i1}- Cậu ta đâu?\N- Ai cơ?{\i0}
Dialogue: 0,0:11:39.66,0:11:40.54,Default,,0,0,0,,{\i1}D, mau lên!{\i0}
Dialogue: 0,0:11:40.62,0:11:42.91,Default,,0,0,0,,{\an8}Quá muộn rồi! Anh ấy đi rồi!
Dialogue: 0,0:11:42.99,0:11:43.91,Default,,0,0,0,,Sao?
Dialogue: 0,0:11:43.99,0:11:46.83,Default,,0,0,0,,{\i1}Anh ấy không định chờ đâu!{\i0}
Dialogue: 0,0:11:47.75,0:11:51.55,Default,,0,0,0,,{\i1}Roman, nghe này!\NHãy đưa D về trước khi tôi đến đó!{\i0}
Dialogue: 0,0:11:51.63,0:11:53.17,Default,,0,0,0,,{\i1}Đợi chút!{\i0}
Dialogue: 0,0:11:53.25,0:11:56.88,Default,,0,0,0,,{\an8}Tôi sẽ mang theo CPRN-XW-1.
Dialogue: 0,0:11:56.97,0:11:57.97,Default,,0,0,0,,{\an8}{\i1}Cái gì cơ?{\i0}
Dialogue: 0,0:11:58.05,0:12:00.85,Default,,0,0,0,,{\an8}Cứ xem nó như một xung điện từ khổng lồ.
Dialogue: 0,0:12:00.93,0:12:02.31,Default,,0,0,0,,{\an8}Nếu tôi kích hoạt nó,
Dialogue: 0,0:12:02.39,0:12:05.52,Default,,0,0,0,,{\an8}mọi thiết bị điện tử\Ntrong bán kính 2km sẽ bị vô hiệu.
Dialogue: 0,0:12:05.60,0:12:08.94,Default,,0,0,0,,{\an8}Nó sẽ xuyên qua Capri. Ta sẽ dùng nó.
Dialogue: 0,0:12:09.02,0:12:12.44,Default,,0,0,0,,{\i1}Trong lúc nó hoạt động,\Nmọi người phải tránh xa Capri.{\i0}
Dialogue: 0,0:12:12.94,0:12:17.70,Default,,0,0,0,,{\i1}Nên đến khi tôi đến, hãy thuyết phục D\Nvà đưa cậu ta tránh xa Capri. Rõ chứ?{\i0}
Dialogue: 0,0:12:24.03,0:12:28.03,Default,,0,0,0,,Cố lên, Capri.\NCô vẫn còn trong đó, đúng không?
Dialogue: 0,0:12:38.67,0:12:39.84,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:12:39.93,0:12:41.43,Default,,0,0,0,,Đừng cản đường tôi!
Dialogue: 0,0:12:41.93,0:12:43.68,Default,,0,0,0,,Chuyện quái gì vậy?
Dialogue: 0,0:12:43.76,0:12:46.85,Default,,0,0,0,,Định tiếp tục đến bao giờ?\NTa đang bị tổn thất đây.
Dialogue: 0,0:12:47.43,0:12:51.60,Default,,0,0,0,,{\i1}Mọi đường truyền đều bị ngắt.\NCó lẽ Capricorn đang phá sóng.{\i0}
Dialogue: 0,0:12:54.27,0:12:57.36,Default,,0,0,0,,{\i1}Tại sao? Tại sao, Talia?{\i0}
Dialogue: 0,0:12:58.03,0:12:59.99,Default,,0,0,0,,Con là cô bé ngoan biết bao.
Dialogue: 0,0:13:00.49,0:13:04.08,Default,,0,0,0,,{\i1}Lẽ ra con sẽ trở thành một điều tuyệt vời.{\i0}
Dialogue: 0,0:13:04.58,0:13:06.71,Default,,0,0,0,,{\i1}Một điều có thể giúp ích cho ta.{\i0}
Dialogue: 0,0:13:07.20,0:13:08.45,Default,,0,0,0,,{\an8}{\i1}Talia!{\i0}
Dialogue: 0,0:13:08.95,0:13:11.12,Default,,0,0,0,,{\i1}Cô bé ngoan, Talia.{\i0}
Dialogue: 0,0:13:14.75,0:13:16.75,Default,,0,0,0,,{\i1}- Ngoan lắm.{\i0}\N- Im đi!
Dialogue: 0,0:13:22.22,0:13:23.89,Default,,0,0,0,,ĐANG GỌI\NROMAN
Dialogue: 0,0:13:23.97,0:13:24.97,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:13:29.39,0:13:30.35,Default,,0,0,0,,ĐANG GỌI\ND
Dialogue: 0,0:13:31.69,0:13:33.19,Default,,0,0,0,,Khỉ thật! Không gọi được!
Dialogue: 0,0:13:33.27,0:13:34.94,Default,,0,0,0,,Không thể lại gần hơn à?
Dialogue: 0,0:13:35.02,0:13:37.44,Default,,0,0,0,,Không, quá nguy hiểm!
Dialogue: 0,0:13:41.03,0:13:43.07,Default,,0,0,0,,- Kyoko?\N- Không có cậu ta ở đây à?
Dialogue: 0,0:13:43.16,0:13:44.95,Default,,0,0,0,,Không thể nào! Nhìn kìa!
Dialogue: 0,0:13:46.37,0:13:48.08,Default,,0,0,0,,Nói là cậu ta còn sống đi!
Dialogue: 0,0:13:49.75,0:13:51.34,Default,,0,0,0,,Sao tôi biết được?
Dialogue: 0,0:13:56.79,0:13:58.46,Default,,0,0,0,,Thế này không giống cô,
Dialogue: 0,0:13:59.34,0:14:00.30,Default,,0,0,0,,Capri.
Dialogue: 0,0:14:05.30,0:14:08.72,Default,,0,0,0,,Giờ phải làm gì đây?\NKhông thể che đậy vụ này được nữa.
Dialogue: 0,0:14:08.81,0:14:09.89,Default,,0,0,0,,Rõ ràng rồi.
Dialogue: 0,0:14:09.97,0:14:12.72,Default,,0,0,0,,Militech và Arasaka sẽ sớm biết thôi.
Dialogue: 0,0:14:13.23,0:14:14.61,Default,,0,0,0,,Không tránh được rồi.
Dialogue: 0,0:14:16.98,0:14:18.61,Default,,0,0,0,,{\an8}{\i1}Kyoko? Chuyện gì vậy?{\i0}
Dialogue: 0,0:14:19.11,0:14:22.36,Default,,0,0,0,,{\an8}{\i1}Tên lửa đã được phóng.\NVa chạm trong ba phút.{\i0}
Dialogue: 0,0:14:24.95,0:14:27.41,Default,,0,0,0,,Chết tiệt. Họ thật sự đã làm thế.
Dialogue: 0,0:14:27.91,0:14:29.58,Default,,0,0,0,,Bom sắp dội xuống rồi.
Dialogue: 0,0:14:30.08,0:14:32.79,Default,,0,0,0,,{\an8}Nghe kỹ đây.\NKhi tôi ra hiệu, hãy đạp phanh.
Dialogue: 0,0:14:32.87,0:14:35.91,Default,,0,0,0,,{\an8}Tôi sẽ kích hoạt thứ này muộn nhất có thể!
Dialogue: 0,0:14:36.00,0:14:36.88,Default,,0,0,0,,{\i1}Nhưng…{\i0}
Dialogue: 0,0:14:36.96,0:14:39.21,Default,,0,0,0,,D chắc chắn ở đâu đó trong thứ đó!
Dialogue: 0,0:14:39.30,0:14:42.93,Default,,0,0,0,,Khi nó ngã xuống,\Nhãy quay lại đánh thức cậu ta!
Dialogue: 0,0:14:43.01,0:14:44.34,Default,,0,0,0,,{\i1}Như vậy thật điên rồ!{\i0}
Dialogue: 0,0:14:44.43,0:14:45.76,Default,,0,0,0,,Chỉ còn cách đó thôi!
Dialogue: 0,0:14:45.84,0:14:46.97,Default,,0,0,0,,Phanh!
Dialogue: 0,0:14:47.05,0:14:49.18,Default,,0,0,0,,Cô thì sao, Kyoko?
Dialogue: 0,0:14:54.77,0:14:58.32,Default,,0,0,0,,{\an8}Chết tiệt. Đúng là được ăn cả,\Nngã về không.
Dialogue: 0,0:14:58.81,0:15:01.44,Default,,0,0,0,,{\an8}Chuyện lẽ ra đâu phải thế này.
Dialogue: 0,0:16:08.34,0:16:10.01,Default,,0,0,0,,ĐANG GỌI\ND
Dialogue: 0,0:16:26.40,0:16:28.53,Default,,0,0,0,,{\i1}Này, D. Tỉnh lại đi.{\i0}
Dialogue: 0,0:16:33.87,0:16:35.08,Default,,0,0,0,,{\an8}{\i1}Tỉnh dậy đi. D!{\i0}
Dialogue: 0,0:16:35.16,0:16:36.12,Default,,0,0,0,,{\an8}ĐANG GỌI\NROMAN
Dialogue: 0,0:16:36.20,0:16:37.03,Default,,0,0,0,,{\an8}Roman?
Dialogue: 0,0:16:42.13,0:16:45.59,Default,,0,0,0,,{\i1}Ngoan lắm, Talia.\NCon lại đứng lên được rồi.{\i0}
Dialogue: 0,0:16:45.67,0:16:50.68,Default,,0,0,0,,{\i1}Ấn tượng lắm. Nào, thử cái này đi.\NĐây là sản phẩm của công ty chúng ta.{\i0}
Dialogue: 0,0:16:51.89,0:16:53.27,Default,,0,0,0,,{\i1}Nó là vì con đấy,{\i0}
Dialogue: 0,0:16:53.97,0:16:54.93,Default,,0,0,0,,{\i1}Talia.{\i0}
Dialogue: 0,0:16:55.68,0:16:56.68,Default,,0,0,0,,{\i1}Vì con…{\i0}
Dialogue: 0,0:16:59.56,0:17:02.19,Default,,0,0,0,,Cô đâu có như vậy, Capri.
Dialogue: 0,0:17:03.90,0:17:05.28,Default,,0,0,0,,Cô đang xử sự như tôi đấy.
Dialogue: 0,0:17:06.78,0:17:08.45,Default,,0,0,0,,{\an8}Anh là ai?
Dialogue: 0,0:17:09.57,0:17:13.45,Default,,0,0,0,,- Tôi không nói chuyện với cô.\N- Tôi thì có!
Dialogue: 0,0:17:16.49,0:17:18.78,Default,,0,0,0,,Được thôi!
Dialogue: 0,0:17:26.88,0:17:27.71,Default,,0,0,0,,Ăn gian quá.
Dialogue: 0,0:17:33.80,0:17:34.97,Default,,0,0,0,,Này, bình tĩnh đi.
Dialogue: 0,0:17:44.90,0:17:45.73,Default,,0,0,0,,Cô biết không,
Dialogue: 0,0:17:46.23,0:17:49.15,Default,,0,0,0,,tôi đã đến tận đây để gặp cô. Capri.
Dialogue: 0,0:17:57.49,0:17:58.57,Default,,0,0,0,,D!
Dialogue: 0,0:17:59.75,0:18:02.63,Default,,0,0,0,,{\i1}Này, Capri.{\i0}
Dialogue: 0,0:18:03.67,0:18:05.09,Default,,0,0,0,,{\i1}Thôi nào, Capri!{\i0}
Dialogue: 0,0:18:10.84,0:18:12.59,Default,,0,0,0,,Ngốc thật đấy.
Dialogue: 0,0:18:13.34,0:18:15.47,Default,,0,0,0,,{\an8}Bị cảm xúc của cô ta nuốt chửng.
Dialogue: 0,0:18:17.93,0:18:21.85,Default,,0,0,0,,{\an8}- Ồ, là anh. Lâu rồi không gặp.\N- Lâu rồi không gặp.
Dialogue: 0,0:18:27.23,0:18:28.23,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:18:28.98,0:18:30.32,Default,,0,0,0,,Đến lượt anh à?
Dialogue: 0,0:18:30.40,0:18:31.36,Default,,0,0,0,,Lần này,
Dialogue: 0,0:18:32.07,0:18:33.99,Default,,0,0,0,,{\an8}sẽ không kết thúc như thế.
Dialogue: 0,0:18:34.74,0:18:37.37,Default,,0,0,0,,{\an8}Hãy chơi thật vui nào, Capri. Tôi và…
Dialogue: 0,0:18:38.24,0:18:39.07,Default,,0,0,0,,Capri.
Dialogue: 0,0:18:46.33,0:18:47.54,Default,,0,0,0,,D!
Dialogue: 0,0:18:48.34,0:18:50.09,Default,,0,0,0,,Roman.
Dialogue: 0,0:18:50.96,0:18:52.00,Default,,0,0,0,,Đây. Đỡ cô ấy đi.
Dialogue: 0,0:18:52.09,0:18:54.22,Default,,0,0,0,,- Talia!\N- Chà!
Dialogue: 0,0:18:54.72,0:18:58.10,Default,,0,0,0,,- Cậu ổn chứ?\N- Tôi ổn.
Dialogue: 0,0:19:00.60,0:19:01.94,Default,,0,0,0,,Ối.
Dialogue: 0,0:19:05.60,0:19:07.52,Default,,0,0,0,,Đau quá! Ối!
Dialogue: 0,0:19:07.60,0:19:09.02,Default,,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:19:09.11,0:19:11.74,Default,,0,0,0,,Anh tả tơi rồi này.
Dialogue: 0,0:19:11.82,0:19:13.28,Default,,0,0,0,,Phải gia cố một chút.
Dialogue: 0,0:19:13.90,0:19:15.07,Default,,0,0,0,,Trông ngốc thật.
Dialogue: 0,0:19:15.15,0:19:16.28,Default,,0,0,0,,Hết lựa chọn rồi.
Dialogue: 0,0:19:16.91,0:19:18.79,Default,,0,0,0,,Không có thứ gì tốt hơn ư?
Dialogue: 0,0:19:18.87,0:19:21.21,Default,,0,0,0,,Đây là tay cô ấy à? Tôi dùng được chứ?
Dialogue: 0,0:19:39.76,0:19:41.93,Default,,0,0,0,,Không có thời gian lãng phí đâu.
Dialogue: 0,0:19:42.68,0:19:45.89,Default,,0,0,0,,Bọn tập đoàn lại đến nữa rồi.
Dialogue: 0,0:19:47.77,0:19:49.31,Default,,0,0,0,,Cô vẫn còn ở đây à?
Dialogue: 0,0:19:49.98,0:19:53.07,Default,,0,0,0,,Đợt tiếp theo\Nsẽ không phải là lính bình thường.
Dialogue: 0,0:19:53.57,0:19:57.74,Default,,0,0,0,,Arasaka và Militech sẽ tranh giành cậu.
Dialogue: 0,0:19:58.78,0:20:00.03,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:20:01.07,0:20:01.99,Default,,0,0,0,,Muốn xem không?
Dialogue: 0,0:20:08.71,0:20:09.96,Default,,0,0,0,,Cô ta chết rồi à?
Dialogue: 0,0:20:11.00,0:20:11.92,Default,,0,0,0,,Không biết.
Dialogue: 0,0:20:18.38,0:20:19.42,Default,,0,0,0,,{\an8}Này, D!
Dialogue: 0,0:20:19.93,0:20:21.56,Default,,0,0,0,,{\an8}Tìm thấy Capri chưa?
Dialogue: 0,0:20:22.22,0:20:23.22,Default,,0,0,0,,{\an8}Rồi.
Dialogue: 0,0:20:25.47,0:20:30.23,Default,,0,0,0,,Vậy… đây là cao trào của chuyện nhỉ?\NCâu chuyện của anh.
Dialogue: 0,0:20:32.06,0:20:33.52,Default,,0,0,0,,Tôi sẽ đi với anh.
Dialogue: 0,0:20:34.19,0:20:38.07,Default,,0,0,0,,{\an8}- Tôi không thể bỏ lỡ câu chuyện của anh…\N- Thôi nào, Roman…
Dialogue: 0,0:20:38.15,0:20:40.40,Default,,0,0,0,,{\an8}Nếu tôi không quay, ai sẽ quay đây?
Dialogue: 0,0:20:40.91,0:20:44.62,Default,,0,0,0,,{\an8}Tôi sẽ quay giúp cậu.\NTôi biết cậu muốn quay gì mà.
Dialogue: 0,0:20:45.33,0:20:47.25,Default,,0,0,0,,{\an8}Đây. Như thế này, đúng không?
Dialogue: 0,0:20:52.83,0:20:53.96,Default,,0,0,0,,{\an8}Không đâu.
Dialogue: 0,0:21:05.64,0:21:07.27,Default,,0,0,0,,Anh định hy sinh, đúng chứ?
Dialogue: 0,0:21:07.35,0:21:09.06,Default,,0,0,0,,{\an8}Phải vậy không?
Dialogue: 0,0:21:09.69,0:21:12.65,Default,,0,0,0,,{\an8}Roman, sẽ có một cao trào khác.
Dialogue: 0,0:21:13.23,0:21:14.52,Default,,0,0,0,,{\an8}Tôi mặc kệ.
Dialogue: 0,0:21:15.32,0:21:16.99,Default,,0,0,0,,{\an8}Đây là cao trào của tôi.
Dialogue: 0,0:21:17.48,0:21:20.28,Default,,0,0,0,,{\an8}- Không phải của cậu.\N- Tôi không quan tâm!
Dialogue: 0,0:21:20.90,0:21:23.53,Default,,0,0,0,,{\an8}Câu chuyện của cậu không đạt đỉnh ở đây.
Dialogue: 0,0:21:25.62,0:21:27.50,Default,,0,0,0,,{\an8}Tôi không quan tâm! Tôi…
Dialogue: 0,0:21:27.58,0:21:28.62,Default,,0,0,0,,{\an8}Roman.
Dialogue: 0,0:21:33.71,0:21:34.63,Default,,0,0,0,,{\an8}Xin lỗi cậu.
Dialogue: 0,0:21:45.76,0:21:47.01,Default,,0,0,0,,Chăm sóc Roman nhé.
Dialogue: 0,0:21:47.64,0:21:48.52,Default,,0,0,0,,Cả cô ấy nữa.
Dialogue: 0,0:21:50.93,0:21:51.89,Default,,0,0,0,,Cậu đi à?
Dialogue: 0,0:21:52.60,0:21:53.44,Default,,0,0,0,,Ừ.
Dialogue: 0,0:21:55.27,0:21:56.27,Default,,0,0,0,,David.
Dialogue: 0,0:21:57.48,0:21:58.73,Default,,0,0,0,,Cậu…
Dialogue: 0,0:21:59.23,0:22:01.07,Default,,0,0,0,,là đồ ngốc.
Dialogue: 0,0:22:09.33,0:22:10.16,Default,,0,0,0,,Này, Capri.
Dialogue: 0,0:22:10.25,0:22:11.67,Default,,0,0,0,,Hử?
Dialogue: 0,0:22:12.25,0:22:15.63,Default,,0,0,0,,{\an8}Hồi trước có một gã cùng tên với tôi.
Dialogue: 0,0:22:16.17,0:22:19.13,Default,,0,0,0,,{\an8}- Ồ?\N- Anh ta có bạn bè.
Dialogue: 0,0:22:19.63,0:22:22.97,Default,,0,0,0,,{\an8}Rồi anh ta hy sinh mạng sống vì họ.
Dialogue: 0,0:22:23.68,0:22:25.39,Default,,0,0,0,,{\an8}Hay ít nhất là có vẻ thế.
Dialogue: 0,0:22:27.14,0:22:29.02,Default,,0,0,0,,{\an8}Tôi không làm được như vậy.
Dialogue: 0,0:22:30.02,0:22:33.40,Default,,0,0,0,,{\an8}Cô nghĩ cuối cùng anh ta cảm thấy thế nào?
Dialogue: 0,0:22:34.35,0:22:36.85,Default,,0,0,0,,{\an8}Không biết. Sao vậy?
Dialogue: 0,0:22:37.94,0:22:40.44,Default,,0,0,0,,{\an8}Sao bây giờ lại nhắc chuyện đó?
Dialogue: 0,0:22:41.19,0:22:44.78,Default,,0,0,0,,{\an8}Không biết. Nói chuyện với Omi\Nlàm tôi nghĩ đến anh ta.
Dialogue: 0,0:22:45.66,0:22:46.54,Default,,0,0,0,,{\an8}Họ đến rồi.
Dialogue: 0,0:22:57.58,0:22:58.96,Default,,0,0,0,,Nào, Capri.
Dialogue: 0,0:22:59.75,0:23:00.83,Default,,0,0,0,,Chơi thật vui nào.
Dialogue: 0,0:23:13.56,0:23:14.48,Default,,0,0,0,,{\i1}Sao?{\i0}
Dialogue: 0,0:23:16.06,0:23:16.89,Default,,0,0,0,,{\i1}Kết thúc…{\i0}
Dialogue: 0,0:23:17.60,0:23:18.68,Default,,0,0,0,,{\i1}rồi ư?{\i0}
Dialogue: 0,0:23:29.24,0:23:31.87,Default,,0,0,0,,Này! Đằng kia! Anh nghĩ ta đến được không?
Dialogue: 0,0:23:35.58,0:23:36.71,Default,,0,0,0,,Chắc chắn rồi.
Dialogue: 0,0:23:38.83,0:23:40.62,Default,,0,0,0,,Bảo trọng nhé, Roman!
Dialogue: 0,0:23:41.96,0:23:43.88,Default,,0,0,0,,{\i1}Đoạn phim kết thúc ở đó.{\i0}
Dialogue: 0,0:23:46.97,0:23:48.35,Default,,0,0,0,,{\i1}D là tên ngốc.{\i0}
Dialogue: 0,0:23:50.85,0:23:54.77,Default,,0,0,0,,{\i1}Nguyên nhân của vụ mất điện diện rộng\Nvẫn chưa sáng tỏ.{\i0}
Dialogue: 0,0:23:54.85,0:23:57.60,Default,,0,0,0,,{\i1}Còn về vụ đánh bom sau đó,{\i0}
Dialogue: 0,0:23:57.69,0:24:00.53,Default,,0,0,0,,{\i1}vài người nói\Nđã thấy một khối máy móc bí ẩn,{\i0}
Dialogue: 0,0:24:00.61,0:24:03.28,Default,,0,0,0,,{\i1}nhưng các cảnh quay ghi lại nó\Nđều bị hỏng.{\i0}
Dialogue: 0,0:24:04.11,0:24:05.99,Default,,0,0,0,,Cô nghĩ D bị gì?
Dialogue: 0,0:24:06.07,0:24:08.03,Default,,0,0,0,,Không đời nào cậu ấy sống sót.
Dialogue: 0,0:24:08.78,0:24:11.53,Default,,0,0,0,,Cậu ấy là kiểu người như vậy đấy.
Dialogue: 0,0:24:12.12,0:24:13.79,Default,,0,0,0,,Gì? Cậu đang quay phim à?
Dialogue: 0,0:24:14.29,0:24:18.96,Default,,0,0,0,,À, việc tôi bắt được Talia…\Nlà một phép màu.
Dialogue: 0,0:24:19.67,0:24:21.42,Default,,0,0,0,,Avida đã cứu chúng tôi.
Dialogue: 0,0:24:21.50,0:24:22.50,Default,,0,0,0,,Tôi chắc chắn…
Dialogue: 0,0:24:23.92,0:24:26.05,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:24:26.13,0:24:28.38,Default,,0,0,0,,- Miguel.\N- Ông biết anh ta à?
Dialogue: 0,0:24:30.68,0:24:32.89,Default,,0,0,0,,{\an8}Người quen cũ thôi.
Dialogue: 0,0:24:33.39,0:24:36.19,Default,,0,0,0,,{\i1}Đáng tiếc là cô ấy chỉ tạm thời cải thiện.{\i0}
Dialogue: 0,0:24:36.27,0:24:37.73,Default,,0,0,0,,{\i1}Không còn cách nào sao?{\i0}
Dialogue: 0,0:24:37.81,0:24:39.81,Default,,0,0,0,,{\i1}Cần kìm hãm siêu thiết bị trước.{\i0}
Dialogue: 0,0:24:40.40,0:24:44.95,Default,,0,0,0,,{\an8}- Ở đó đẹp lắm đúng không?\N- Weak nói thế nhỉ?
Dialogue: 0,0:24:45.03,0:24:46.91,Default,,0,0,0,,{\an8}Tôi chưa từng đến đó.
Dialogue: 0,0:24:48.24,0:24:49.16,Default,,0,0,0,,Gì vậy?
Dialogue: 0,0:24:51.82,0:24:54.57,Default,,0,0,0,,Cậu buồn vì tôi sắp đi xa à?
Dialogue: 0,0:24:55.24,0:24:57.45,Default,,0,0,0,,- Cần giúp không?\N- Không. Tôi ổn.
Dialogue: 0,0:24:58.37,0:25:02.37,Default,,0,0,0,,- Bảo trọng nhé, Roman.\N- Talia cũng vậy.
Dialogue: 0,0:25:04.29,0:25:08.54,Default,,0,0,0,,Đến nơi nhớ nhắn tin nhé!\NTôi nhất định sẽ ghé thăm. Và quay cho cô.
Dialogue: 0,0:25:09.05,0:25:11.72,Default,,0,0,0,,Ừ. Tôi mong lắm đấy.
Dialogue: 0,0:25:18.85,0:25:20.56,Default,,0,0,0,,Vậy tôi đi nhé.
Dialogue: 0,0:25:21.06,0:25:23.48,Default,,0,0,0,,- Này, cháu chắc chứ?\N- Chắc.
Dialogue: 0,0:25:24.19,0:25:26.23,Default,,0,0,0,,Tôi sẽ gặp lại cậu ấy.
Dialogue: 0,0:25:27.98,0:25:29.15,Default,,0,0,0,,Đợi đã!
Dialogue: 0,0:25:29.74,0:25:31.45,Default,,0,0,0,,Talia! Tôi…
Dialogue: 0,0:25:31.95,0:25:34.62,Default,,0,0,0,,Tôi không muốn cô đi!
Dialogue: 0,0:25:36.12,0:25:37.16,Default,,0,0,0,,Dù là bất cứ đâu!
Dialogue: 0,0:25:38.25,0:25:39.67,Default,,0,0,0,,Đừng đi mà!
Dialogue: 0,0:25:40.25,0:25:41.17,Default,,0,0,0,,Bất cứ đâu…
Dialogue: 0,0:25:41.25,0:25:42.50,Default,,0,0,0,,Talia!
Dialogue: 0,0:25:45.54,0:25:49.42,Default,,0,0,0,,Roman, chúng ta sẽ gặp lại nhau.
Dialogue: 0,0:25:51.13,0:25:52.09,Default,,0,0,0,,Ừ.
Dialogue: 0,0:25:52.18,0:25:56.39,Default,,0,0,0,,Cho đến lúc đó,\Nhãy tiếp tục quay phim nhé?
Dialogue: 0,0:25:57.22,0:25:58.05,Default,,0,0,0,,Được.
Dialogue: 0,0:25:58.14,0:26:00.81,Default,,0,0,0,,Và cho tôi xem những thước phim của cậu.
Dialogue: 0,0:26:01.69,0:26:06.03,Default,,0,0,0,,Hãy quay đẹp đến mức\Nmọi thứ tồi tệ này đều trở nên nhỏ bé.
Dialogue: 0,0:26:06.11,0:26:07.95,Default,,0,0,0,,Cô nghĩ tôi có làm được không?
Dialogue: 0,0:26:08.02,0:26:09.31,Default,,0,0,0,,Dĩ nhiên là được.
Dialogue: 0,0:26:09.86,0:26:12.78,Default,,0,0,0,,Ngày trước cậu cũng quay tôi rất đẹp mà.
Dialogue: 0,0:26:13.28,0:26:14.41,Default,,0,0,0,,Dễ ợt mà.
Dialogue: 0,0:26:17.58,0:26:18.83,Default,,0,0,0,,Cô đã thế rồi.
Dialogue: 0,0:26:19.45,0:26:22.16,Default,,0,0,0,,Lúc đó cô cũng rất đẹp rồi.
Dialogue: 0,0:26:23.04,0:26:24.88,Default,,0,0,0,,Cậu nói làm tôi vui quá.
Dialogue: 0,0:26:30.42,0:26:31.92,Default,,0,0,0,,Đừng có khóc đấy.
Dialogue: 0,0:26:32.42,0:26:34.34,Default,,0,0,0,,Tôi sẽ vẫn sống mà.
Dialogue: 0,0:26:34.43,0:26:36.56,Default,,0,0,0,,Ừ. Tôi xin lỗi.
Dialogue: 0,0:26:38.35,0:26:39.56,Default,,0,0,0,,Đúng rồi!
Dialogue: 0,0:26:40.35,0:26:41.35,Default,,0,0,0,,Chúng ta sẽ sống,
Dialogue: 0,0:26:41.43,0:26:42.60,Default,,0,0,0,,Talia!
Dialogue: 0,0:28:27.04,0:28:30.04,Default,,0,0,0,,{\an8}Biên dịch: Khanh Tran
