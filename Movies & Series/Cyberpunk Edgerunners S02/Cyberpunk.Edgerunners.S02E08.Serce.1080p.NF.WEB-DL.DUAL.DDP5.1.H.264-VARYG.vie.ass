Dialogue: 0,0:00:35.54,0:00:37.71,Default,,0,0,0,,{\an8}Tôi sẽ tấn công hệ thống an ninh.
Dialogue: 0,0:00:38.20,0:00:40.79,Default,,0,0,0,,{\an8}Anh lo phần cảnh vệ nhé.
Dialogue: 0,0:00:41.54,0:00:42.37,Default,,0,0,0,,{\an8}Ừ.
Dialogue: 0,0:00:44.84,0:00:47.80,Default,,0,0,0,,{\an8}Cảm ơn anh đã đảm nhận việc này, Meshuga.
Dialogue: 0,0:00:48.30,0:00:51.47,Default,,0,0,0,,Đa số người tuổi ta\Nđều đã rửa tay gác kiếm.
Dialogue: 0,0:00:51.55,0:00:54.60,Default,,0,0,0,,{\an8}Thật tốt khi thấy anh trở lại.
Dialogue: 0,0:00:57.31,0:01:00.48,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:01:00.56,0:01:03.61,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:02:33.49,0:02:34.53,Default,,0,0,0,,Này D.
Dialogue: 0,0:02:39.62,0:02:41.16,Default,,0,0,0,,Hôm nay anh muốn làm gì?
Dialogue: 0,0:02:48.29,0:02:49.42,Default,,0,0,0,,Roman?
Dialogue: 0,0:02:50.92,0:02:52.59,Default,,0,0,0,,À vâng.
Dialogue: 0,0:02:53.26,0:02:54.60,Default,,0,0,0,,Cô là Kyoko à?
Dialogue: 0,0:02:55.22,0:02:59.56,Default,,0,0,0,,Phải, tôi là Kyoko. Vậy ta đi thôi.
Dialogue: 0,0:02:59.64,0:03:01.10,Default,,0,0,0,,Kẻo lại muộn quá.
Dialogue: 0,0:03:08.81,0:03:09.73,Default,,0,0,0,,{\i1}D.{\i0}
Dialogue: 0,0:03:10.82,0:03:11.86,Default,,0,0,0,,{\i1}Tỉnh dậy đi. D!{\i0}
Dialogue: 0,0:03:12.57,0:03:13.49,Default,,0,0,0,,{\i1}D.{\i0}
Dialogue: 0,0:03:13.57,0:03:14.74,Default,,0,0,0,,D!
Dialogue: 0,0:03:16.45,0:03:17.66,Default,,0,0,0,,Là cậu à?
Dialogue: 0,0:03:19.32,0:03:22.41,Default,,0,0,0,,Tôi là Kyoko.\NTôi rất hâm mộ video của cậu.
Dialogue: 0,0:03:26.08,0:03:29.42,Default,,0,0,0,,Nghe nói cậu thường gặp ác mộng\Nvà không thể ngủ ngon.
Dialogue: 0,0:03:29.50,0:03:32.00,Default,,0,0,0,,Roman đã kể với tôi về cậu.
Dialogue: 0,0:03:32.09,0:03:35.47,Default,,0,0,0,,Biết đâu tôi có thể giúp được gì cho cậu.
Dialogue: 0,0:03:36.13,0:03:39.43,Default,,0,0,0,,- Hả?\N- Có vẻ như cô ấy khá am hiểu chuyện đó.
Dialogue: 0,0:03:39.51,0:03:40.64,Default,,0,0,0,,Thử nói chuyện đi.
Dialogue: 0,0:03:41.72,0:03:42.64,Default,,0,0,0,,{\an8}Tôi không cần.
Dialogue: 0,0:03:43.72,0:03:45.01,Default,,0,0,0,,Không cần đâu. Về đi.
Dialogue: 0,0:03:45.10,0:03:48.77,Default,,0,0,0,,Không mất nhiều thời gian đâu.\NNói chuyện với tôi một lát thôi.
Dialogue: 0,0:03:49.60,0:03:53.10,Default,,0,0,0,,Yupi! Này Yupi!\NĐừng cho mấy kẻ kỳ lạ vào nữa!
Dialogue: 0,0:03:53.19,0:03:56.36,Default,,0,0,0,,Yupi ra ngoài rồi. Tôi gặp cô ấy ở cửa.
Dialogue: 0,0:03:56.44,0:04:00.28,Default,,0,0,0,,Chết tiệt. Tôi không cần, Roman. Về đi.
Dialogue: 0,0:04:00.37,0:04:01.29,Default,,0,0,0,,Nhưng…
Dialogue: 0,0:04:01.37,0:04:02.66,Default,,0,0,0,,Đi đi!
Dialogue: 0,0:04:05.45,0:04:06.28,Default,,0,0,0,,Nghe này!
Dialogue: 0,0:04:06.37,0:04:08.91,Default,,0,0,0,,{\an8}Cậu có bao giờ thấy ai\Nkhông nên ở đó không?
Dialogue: 0,0:04:09.00,0:04:12.30,Default,,0,0,0,,Hay nghe giọng một cô gái?\NCứ như nó vang vọng trong đầu cậu…
Dialogue: 0,0:04:12.38,0:04:13.30,Default,,0,0,0,,Kyoko, đợi…
Dialogue: 0,0:04:13.38,0:04:15.34,Default,,0,0,0,,Cô ấy vẫn còn ở bên cậu chứ?
Dialogue: 0,0:04:17.13,0:04:18.30,Default,,0,0,0,,Cô bị điên à?
Dialogue: 0,0:04:19.47,0:04:21.56,Default,,0,0,0,,Tôi đã thấy mặt cậu ở đâu đó…
Dialogue: 0,0:04:22.97,0:04:25.68,Default,,0,0,0,,Danh sách! Thế nên cậu mới tương thích…
Dialogue: 0,0:04:26.43,0:04:27.72,Default,,0,0,0,,"Danh sách"?
Dialogue: 0,0:04:29.39,0:04:30.93,Default,,0,0,0,,Cô là cái quái gì vậy?
Dialogue: 0,0:04:31.44,0:04:32.98,Default,,0,0,0,,À, không có gì.
Dialogue: 0,0:04:59.92,0:05:00.75,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:05:11.98,0:05:12.81,Default,,0,0,0,,D!
Dialogue: 0,0:05:23.36,0:05:26.49,Default,,0,0,0,,- Này, có thấy một phụ nữ nhỏ con không?\N- Hả?
Dialogue: 0,0:05:26.58,0:05:28.83,Default,,0,0,0,,Một phụ nữ nhỏ con! Chạy hướng này!
Dialogue: 0,0:05:28.91,0:05:32.33,Default,,0,0,0,,Tôi chỉ đi ngang đây thôi.\NNày, cô có thấy cô ấy không?
Dialogue: 0,0:05:32.42,0:05:33.46,Default,,0,0,0,,Đừng giấu cô ta.
Dialogue: 0,0:05:39.42,0:05:40.25,Default,,0,0,0,,D!
Dialogue: 0,0:05:45.05,0:05:47.72,Default,,0,0,0,,Chết tiệt. Anh ta không thấy nhỉ?
Dialogue: 0,0:05:47.81,0:05:49.23,Default,,0,0,0,,Cô thì sao?
Dialogue: 0,0:05:49.31,0:05:51.85,Default,,0,0,0,,Dừng lại! Mau chạy đi!
Dialogue: 0,0:05:59.07,0:06:00.61,Default,,0,0,0,,{\an8}Cái quái gì vậy?
Dialogue: 0,0:06:00.69,0:06:03.99,Default,,0,0,0,,{\an8}Tôi không biết rõ cô ấy!\NTôi chỉ mới gặp cô ấy gần đây.
Dialogue: 0,0:06:04.07,0:06:07.07,Default,,0,0,0,,{\an8}Cô ấy xem video của anh\Nvà nói mình biết về siêu thiết bị.
Dialogue: 0,0:06:07.16,0:06:10.12,Default,,0,0,0,,{\an8}- Tại sao cậu đưa cô ta đến?\N- Vì anh như thế đấy!
Dialogue: 0,0:06:12.37,0:06:14.54,Default,,0,0,0,,Tôi thấy lo cho anh, D!
Dialogue: 0,0:06:14.62,0:06:17.04,Default,,0,0,0,,Anh hành động rất kỳ lạ.
Dialogue: 0,0:06:17.79,0:06:20.29,Default,,0,0,0,,Anh vừa tấn công\Nmột người hoàn toàn xa lạ.
Dialogue: 0,0:06:20.38,0:06:22.05,Default,,0,0,0,,Cả Kyoko nữa.
Dialogue: 0,0:06:22.13,0:06:26.22,Default,,0,0,0,,Cô ấy nói có thể anh\Nsắp hóa siêu cuồng nhân, nên tôi…
Dialogue: 0,0:06:27.18,0:06:28.14,Default,,0,0,0,,Siêu cuồng nhân?
Dialogue: 0,0:06:29.14,0:06:31.14,Default,,0,0,0,,Nên cậu đưa cô ta đến à?
Dialogue: 0,0:06:32.14,0:06:33.43,Default,,0,0,0,,Đợi đã!
Dialogue: 0,0:06:33.52,0:06:38.82,Default,,0,0,0,,Cô ta biết về vụ tấn công.\NVà danh sách có mặt tôi của Arasaka.
Dialogue: 0,0:06:39.40,0:06:42.07,Default,,0,0,0,,- Cô ta biết gì đó.\N- Thật à?
Dialogue: 0,0:06:42.15,0:06:44.03,Default,,0,0,0,,Capri nói với tôi.
Dialogue: 0,0:06:44.11,0:06:45.19,Default,,0,0,0,,Capri?
Dialogue: 0,0:06:45.28,0:06:47.32,Default,,0,0,0,,Dù vậy, anh không thể giết người!
Dialogue: 0,0:06:47.41,0:06:52.00,Default,,0,0,0,,Im đi. Cậu đưa cô ta đến\Nmà chẳng biết cái quái gì về cô ta!
Dialogue: 0,0:06:53.75,0:06:55.38,Default,,0,0,0,,Cô ta nhắm vào Capri.
Dialogue: 0,0:06:55.92,0:06:57.17,Default,,0,0,0,,Tôi biết mà.
Dialogue: 0,0:06:59.67,0:07:03.09,Default,,0,0,0,,- Cô ấy quan trọng đến vậy ư?\N- Mất Capri tôi biết làm sao?
Dialogue: 0,0:07:05.68,0:07:08.10,Default,,0,0,0,,Anh đang làm gì với sức mạnh đó vậy?
Dialogue: 0,0:07:08.18,0:07:09.22,Default,,0,0,0,,Trả thù!
Dialogue: 0,0:07:09.30,0:07:11.47,Default,,0,0,0,,Không! Anh đã giết người!
Dialogue: 0,0:07:12.18,0:07:16.73,Default,,0,0,0,,- Giết người là giết người!\N- Cái đó là trả thù cho đồng đội.
Dialogue: 0,0:07:16.81,0:07:18.52,Default,,0,0,0,,Cậu không hiểu đâu.
Dialogue: 0,0:07:18.60,0:07:22.98,Default,,0,0,0,,{\an8}Anh trả thù cho anh!\NKhông phải cho người quá cố. Anh nói dối!
Dialogue: 0,0:07:25.24,0:07:26.07,Default,,0,0,0,,{\an8}Nói dối ư?
Dialogue: 0,0:07:30.12,0:07:32.50,Default,,0,0,0,,Cậu không hiểu.
Dialogue: 0,0:07:33.70,0:07:35.37,Default,,0,0,0,,Cậu không như tôi.
Dialogue: 0,0:07:36.00,0:07:38.88,Default,,0,0,0,,- Không như anh sao?\N- Họ ở đây, Roman.
Dialogue: 0,0:07:39.54,0:07:43.38,Default,,0,0,0,,Họ luôn ở đây. Với tôi.\NChuyện đó không thể là nói dối.
Dialogue: 0,0:07:44.17,0:07:45.13,Default,,0,0,0,,D?
Dialogue: 0,0:07:45.92,0:07:48.26,Default,,0,0,0,,Tôi không thể trả thù mới là nói dối.
Dialogue: 0,0:07:55.35,0:07:56.52,Default,,0,0,0,,Biến đi.
Dialogue: 0,0:07:57.31,0:07:58.64,Default,,0,0,0,,{\an8}Đừng vác mặt đến nữa.
Dialogue: 0,0:08:10.16,0:08:11.45,Default,,0,0,0,,ĐANG GỌI\NYUPI
Dialogue: 0,0:08:13.20,0:08:14.03,Default,,0,0,0,,{\i1}D.{\i0}
Dialogue: 0,0:08:15.12,0:08:16.71,Default,,0,0,0,,Chúng đến đây rồi.
Dialogue: 0,0:08:27.01,0:08:28.30,Default,,0,0,0,,Anh nói ai?
Dialogue: 0,0:08:28.38,0:08:30.93,Default,,0,0,0,,{\an8}Cô ta xưng là nhà nghiên cứu của Arasaka
Dialogue: 0,0:08:31.01,0:08:34.22,Default,,0,0,0,,{\an8}và hỏi ta có hứng thú\Nvới chương trình Capricorn không.
Dialogue: 0,0:08:34.89,0:08:36.06,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:08:48.49,0:08:49.32,Default,,0,0,0,,Mẹ…
Dialogue: 0,0:08:50.53,0:08:51.95,Default,,0,0,0,,Mẹ ở đây bao lâu rồi?
Dialogue: 0,0:08:52.03,0:08:54.57,Default,,0,0,0,,- Mẹ vừa đến thôi.\N- Thật sao?
Dialogue: 0,0:08:54.66,0:08:56.33,Default,,0,0,0,,Mẹ nên đánh thức con chứ.
Dialogue: 0,0:08:58.66,0:08:59.54,Default,,0,0,0,,{\an8}Gì thế?
Dialogue: 0,0:09:04.29,0:09:07.09,Default,,0,0,0,,- Cái…\N- Đừng nhúc nhích.
Dialogue: 0,0:09:13.68,0:09:14.72,Default,,0,0,0,,{\an8}Sao vậy mẹ?
Dialogue: 0,0:09:15.81,0:09:18.10,Default,,0,0,0,,{\an8}Dù có chuyện gì xảy ra…
Dialogue: 0,0:09:19.52,0:09:21.81,Default,,0,0,0,,{\an8}mẹ sẽ luôn yêu con.
Dialogue: 0,0:09:25.77,0:09:27.11,Default,,0,0,0,,{\an8}Mẹ này.
Dialogue: 0,0:09:28.11,0:09:29.61,Default,,0,0,0,,{\an8}- Sao?\N- Con…
Dialogue: 0,0:09:30.44,0:09:31.82,Default,,0,0,0,,chưa từ bỏ đâu.
Dialogue: 0,0:09:33.20,0:09:34.03,Default,,0,0,0,,Mẹ biết.
Dialogue: 0,0:09:46.34,0:09:48.01,Default,,0,0,0,,CHUYÊN GIA AN NINH\NTẬP ĐOÀN ARASAKA
Dialogue: 0,0:09:57.85,0:10:02.02,Default,,0,0,0,,Tôi muốn xác nhận trước.\NTôi sẽ nói hết những gì tôi biết.
Dialogue: 0,0:10:02.10,0:10:03.35,Default,,0,0,0,,{\an8}Nhưng cậu phải hứa
Dialogue: 0,0:10:03.44,0:10:06.03,Default,,0,0,0,,{\an8}sẽ không động tay động chân với tôi.
Dialogue: 0,0:10:06.52,0:10:08.48,Default,,0,0,0,,{\an8}- Vậy được chứ?\N- Ừ.
Dialogue: 0,0:10:09.82,0:10:12.66,Default,,0,0,0,,Chuyến đi đến tộc của cậu\Nlẽ ra là để nghiên cứu.
Dialogue: 0,0:10:12.74,0:10:15.74,Default,,0,0,0,,Khi đó, Phản gián Arasaka\Nđang tìm kiếm những người
Dialogue: 0,0:10:15.82,0:10:20.49,Default,,0,0,0,,đáp ứng các điều kiện nhất định\Ncho nhiều dự án.
Dialogue: 0,0:10:21.91,0:10:23.00,Default,,0,0,0,,Dự án?
Dialogue: 0,0:10:23.08,0:10:28.29,Default,,0,0,0,,Sức đồng cảm cao,\Nchịu được siêu thiết bị, vài tiêu chí nữa.
Dialogue: 0,0:10:28.38,0:10:29.88,Default,,0,0,0,,Nghiên cứu ư?
Dialogue: 0,0:10:29.96,0:10:32.05,Default,,0,0,0,,Phát triển vũ khí.
Dialogue: 0,0:10:33.01,0:10:37.06,Default,,0,0,0,,Tùy vào dự án, điều kiện\Nvà năng khiếu lý tưởng sẽ khác nhau.
Dialogue: 0,0:10:37.14,0:10:41.27,Default,,0,0,0,,Các phòng thí nghiệm\Nkhông thể tự tìm ứng viên lý tưởng.
Dialogue: 0,0:10:41.77,0:10:44.56,Default,,0,0,0,,Thế nên Phản gián tham gia rất sâu.
Dialogue: 0,0:10:44.64,0:10:47.14,Default,,0,0,0,,Vậy là tộc của D có ai đó đáp ứng yêu cầu?
Dialogue: 0,0:10:47.65,0:10:48.82,Default,,0,0,0,,Người đó là cậu.
Dialogue: 0,0:10:49.77,0:10:50.60,Default,,0,0,0,,Tôi sao?
Dialogue: 0,0:10:51.23,0:10:55.07,Default,,0,0,0,,Nói là "nghiên cứu",\Nnhưng mục đích thật sự là bắt giữ cậu.
Dialogue: 0,0:10:55.78,0:10:58.74,Default,,0,0,0,,{\an8}Để ném đá giấu tay,\Nchúng tôi đã thuê kẻ dàn xếp.
Dialogue: 0,0:10:59.24,0:11:00.62,Default,,0,0,0,,{\an8}Nhưng đó là sai lầm.
Dialogue: 0,0:11:01.16,0:11:04.25,Default,,0,0,0,,{\an8}Có bao lính đánh thuê,\Nnhưng Maelstrom lại được chọn.
Dialogue: 0,0:11:04.75,0:11:09.05,Default,,0,0,0,,{\an8}Chúng làm hỏng\Ncả những việc đơn giản nhất.
Dialogue: 0,0:11:09.54,0:11:12.38,Default,,0,0,0,,{\an8}Một trận cãi vã nhỏ nhặt\Nbiến thành vụ xả súng.
Dialogue: 0,0:11:13.05,0:11:16.68,Default,,0,0,0,,{\an8}- Sau này chúng tôi mới biết cậu đi vắng.\N- Khoan đã.
Dialogue: 0,0:11:17.18,0:11:21.35,Default,,0,0,0,,Anh nói mọi người bị giết\Nvì các anh đang tìm tôi à?
Dialogue: 0,0:11:21.43,0:11:25.69,Default,,0,0,0,,{\an8}Không phải chúng tôi.\NLà công ty. Đừng hiểu nhầm.
Dialogue: 0,0:11:26.19,0:11:29.86,Default,,0,0,0,,{\an8}- Ai đã ra lệnh?\N- Một giám đốc tên Tanaka.
Dialogue: 0,0:11:29.94,0:11:31.11,Default,,0,0,0,,{\an8}Vậy bắt hắn thôi!
Dialogue: 0,0:11:31.19,0:11:34.28,Default,,0,0,0,,{\an8}Thật vậy ư? Kenzo, Renée…
Dialogue: 0,0:11:34.36,0:11:35.24,Default,,0,0,0,,D?
Dialogue: 0,0:11:35.32,0:11:37.16,Default,,0,0,0,,- Tất cả chết…\N- Không thể nào.
Dialogue: 0,0:11:37.24,0:11:38.37,Default,,0,0,0,,Hả? Tại sao không?
Dialogue: 0,0:11:38.45,0:11:41.66,Default,,0,0,0,,Tanaka chết rồi. Ông ta bị giết.
Dialogue: 0,0:11:41.74,0:11:43.08,Default,,0,0,0,,Bị giết?
Dialogue: 0,0:11:43.16,0:11:46.75,Default,,0,0,0,,Bị lính đánh thuê bắt cóc và tra tấn.\NHủy hoại não bộ.
Dialogue: 0,0:11:47.67,0:11:51.01,Default,,0,0,0,,Maine, kẻ cầm đầu, cũng đã chết.
Dialogue: 0,0:11:52.55,0:11:55.18,Default,,0,0,0,,Cái gì? Tất cả đã chết?
Dialogue: 0,0:11:55.26,0:11:57.22,Default,,0,0,0,,Tiện cho các người quá nhỉ?
Dialogue: 0,0:11:57.30,0:11:58.43,Default,,0,0,0,,Tôi nói thật mà.
Dialogue: 0,0:11:59.14,0:12:03.10,Default,,0,0,0,,{\an8}- Hai người biết David Martinez chứ?\N- Tất nhiên là biết.
Dialogue: 0,0:12:03.85,0:12:06.14,Default,,0,0,0,,Đợi đã, chẳng phải Maine là người…
Dialogue: 0,0:12:06.64,0:12:10.73,Default,,0,0,0,,Đúng vậy. David đã ở cùng Maine.\NCậu ta có mặt khi Tanaka chết.
Dialogue: 0,0:12:11.23,0:12:14.65,Default,,0,0,0,,- Có thể đó không phải là trùng hợp.\N- Ý anh là gì?
Dialogue: 0,0:12:14.73,0:12:16.90,Default,,0,0,0,,{\an8}Martinez cũng nằm trong danh sách.
Dialogue: 0,0:12:17.40,0:12:20.49,Default,,0,0,0,,{\an8}Sự cố cậu ta gây ra sau đó\Ncó thể có liên quan.
Dialogue: 0,0:12:20.99,0:12:24.99,Default,,0,0,0,,Tôi đã suýt chết vì cậu ta.\NTôi cứ tưởng chuyện đã kết thúc.
Dialogue: 0,0:12:25.49,0:12:28.54,Default,,0,0,0,,{\an8}Lúc tôi bắt đầu quên\Nthì cậu lại bắt đầu giết người.
Dialogue: 0,0:12:28.62,0:12:31.67,Default,,0,0,0,,{\an8}Tôi đã không ngừng lo lắng.\NVà giờ, cả Jake cũng…
Dialogue: 0,0:12:32.46,0:12:34.21,Default,,0,0,0,,{\an8}Tôi không muốn dính líu nữa.
Dialogue: 0,0:12:34.92,0:12:36.67,Default,,0,0,0,,{\an8}- Tôi thì sao?\N- Hả?
Dialogue: 0,0:12:37.80,0:12:41.01,Default,,0,0,0,,- Tôi phải làm sao đây?\N- Làm sao là…
Dialogue: 0,0:12:41.51,0:12:44.60,Default,,0,0,0,,Họ đều chết vì tôi.
Dialogue: 0,0:12:45.18,0:12:47.31,Default,,0,0,0,,Những kẻ chịu trách nhiệm đã chết.
Dialogue: 0,0:12:48.10,0:12:49.31,Default,,0,0,0,,Vậy tôi phải làm gì?
Dialogue: 0,0:12:49.89,0:12:52.43,Default,,0,0,0,,{\an8}Tôi không biết. Nhưng nếu họ chết,
Dialogue: 0,0:12:52.94,0:12:55.28,Default,,0,0,0,,{\an8}nghĩa là cậu trả được thù rồi.
Dialogue: 0,0:12:56.07,0:13:00.07,Default,,0,0,0,,{\an8}Tôi đã nói hết những gì tôi biết.\NCậu sẽ giữ lời chứ?
Dialogue: 0,0:13:03.16,0:13:04.58,Default,,0,0,0,,{\an8}Chưa xong đâu.
Dialogue: 0,0:13:05.62,0:13:07.21,Default,,0,0,0,,{\an8}Không thể nào xong được.
Dialogue: 0,0:13:10.16,0:13:11.08,Default,,0,0,0,,Cậu làm gì…
Dialogue: 0,0:13:22.93,0:13:27.35,Default,,0,0,0,,Đúng rồi, D! Ai ra lệnh có gì quan trọng?\NTất cả chúng đều như nhau.
Dialogue: 0,0:13:28.06,0:13:31.86,Default,,0,0,0,,{\an8}Chúng là Arasaka!\NHãy thiêu rụi tất cả nào!
Dialogue: 0,0:13:44.95,0:13:45.83,Default,,0,0,0,,Làm đi!
Dialogue: 0,0:13:45.91,0:13:46.95,Default,,0,0,0,,Kết liễu chúng!
Dialogue: 0,0:14:01.92,0:14:04.13,Default,,0,0,0,,Chết đi, Thành phố Đêm!
Dialogue: 0,0:14:06.72,0:14:08.68,Default,,0,0,0,,Đồ ngu!
Dialogue: 0,0:14:08.76,0:14:10.14,Default,,0,0,0,,Nghĩ cái quái gì vậy?
Dialogue: 0,0:14:13.39,0:14:14.39,Default,,0,0,0,,Tuyệt!
Dialogue: 0,0:14:14.98,0:14:16.57,Default,,0,0,0,,Xuống địa ngục đi, lũ chó!
Dialogue: 0,0:14:22.86,0:14:24.32,Default,,0,0,0,,Tăng nhiệt lên nào!
Dialogue: 0,0:14:24.41,0:14:26.70,Default,,0,0,0,,Chết tiệt, lũ điên.
Dialogue: 0,0:14:37.00,0:14:41.34,Default,,0,0,0,,Anh thật sự tin rằng\Nnhà nghiên cứu nổi loạn này sẽ có ích à?
Dialogue: 0,0:14:41.42,0:14:46.43,Default,,0,0,0,,{\i1}Vâng. Mọi thứ đang diễn ra theo kế hoạch.\NTôi chắc chắn cô ta sẽ sớm hành động.{\i0}
Dialogue: 0,0:14:47.05,0:14:51.51,Default,,0,0,0,,{\i1}Tôi không hoàn toàn tin cô ta,\Nnhưng Capricorn thì khó mà nghi ngờ.{\i0}
Dialogue: 0,0:14:52.02,0:14:54.11,Default,,0,0,0,,{\i1}Dù ra sao, đội của ta cũng sẵn sàng.{\i0}
Dialogue: 0,0:14:54.60,0:14:56.31,Default,,0,0,0,,Vậy tôi chúc anh may mắn.
Dialogue: 0,0:14:56.90,0:15:01.03,Default,,0,0,0,,Kiril, tôi vẫn tin\Nanh là tài sản quý giá của công ty.
Dialogue: 0,0:15:01.53,0:15:03.45,Default,,0,0,0,,{\i1}Vâng. Xin hãy để tôi lo liệu.{\i0}
Dialogue: 0,0:15:03.53,0:15:07.16,Default,,0,0,0,,{\i1}Nếu không còn gì nữa,\Ntôi còn việc cần giải quyết.{\i0}
Dialogue: 0,0:15:15.04,0:15:16.96,Default,,0,0,0,,{\i1}Meshuga. Bọn tôi đến nơi rồi.{\i0}
Dialogue: 0,0:15:17.50,0:15:20.59,Default,,0,0,0,,{\i1}Ừ, xác nhận từ đầu này. Mọi thứ sẵn sàng.{\i0}
Dialogue: 0,0:15:20.67,0:15:23.72,Default,,0,0,0,,{\i1}Tôi sẽ mở khoá ngay khi anh gõ cửa sau.{\i0}
Dialogue: 0,0:15:23.80,0:15:25.09,Default,,0,0,0,,{\i1}Đợi tôi chút.{\i0}
Dialogue: 0,0:15:25.59,0:15:28.59,Default,,0,0,0,,Avida, tôi muốn cô ở đây.
Dialogue: 0,0:15:28.68,0:15:31.02,Default,,0,0,0,,Tại sao? Tôi cũng đi nữa.
Dialogue: 0,0:15:31.10,0:15:33.77,Default,,0,0,0,,Tôi không muốn liều lĩnh\Nđặt cô vào nguy hiểm.
Dialogue: 0,0:15:33.85,0:15:37.35,Default,,0,0,0,,Đây là cơ thể mới của Talia.\NTôi phải xem và quyết định.
Dialogue: 0,0:15:38.73,0:15:41.73,Default,,0,0,0,,{\i1}King, có thứ anh muốn nghe đây.{\i0}
Dialogue: 0,0:15:41.82,0:15:43.11,Default,,0,0,0,,{\i1}Tin xấu à?{\i0}
Dialogue: 0,0:15:43.19,0:15:44.73,Default,,0,0,0,,{\i1}Thật ra là tin tốt.{\i0}
Dialogue: 0,0:15:44.82,0:15:47.62,Default,,0,0,0,,{\i1}Một cuộc bạo loạn\Nđang tiến về khu trung tâm.{\i0}
Dialogue: 0,0:15:47.70,0:15:50.91,Default,,0,0,0,,{\i1}Cảnh sát đang gọi an ninh của tập đoàn\Nđến hỗ trợ.{\i0}
Dialogue: 0,0:15:50.99,0:15:54.74,Default,,0,0,0,,{\i1}- Có lẽ phòng thí nghiệm sẽ thiếu người.\N- Anh chắc chứ?{\i0}
Dialogue: 0,0:15:54.83,0:15:55.79,Default,,0,0,0,,{\an8}{\i1}Chắc.{\i0}
Dialogue: 0,0:15:55.87,0:15:57.71,Default,,0,0,0,,{\an8}{\i1}Tin tức có nói.{\i0}
Dialogue: 0,0:15:57.79,0:16:00.00,Default,,0,0,0,,{\an8}{\i1}Trời cũng sắp mưa rồi.{\i0}
Dialogue: 0,0:16:00.67,0:16:01.50,Default,,0,0,0,,{\an8}Sao vậy?
Dialogue: 0,0:16:04.59,0:16:07.39,Default,,0,0,0,,{\an8}Được rồi. Ta sẽ đi cùng nhau.
Dialogue: 0,0:16:07.47,0:16:11.10,Default,,0,0,0,,Hank, lúc bọn tôi ra,\Nhãy đưa xe đến ngay cửa sau.
Dialogue: 0,0:16:11.18,0:16:12.01,Default,,0,0,0,,Rõ.
Dialogue: 0,0:16:23.48,0:16:26.02,Default,,0,0,0,,Anh ấy đấy. Đây có thể là cơ hội của ta.
Dialogue: 0,0:16:34.28,0:16:37.12,Default,,0,0,0,,{\i1}Tin tức tối nay.\NWellsprings nổ ra bạo loạn.{\i0}
Dialogue: 0,0:16:37.20,0:16:40.25,Default,,0,0,0,,{\i1}Đụng độ trở nên tàn bạo\Nkhi cảnh sát cũng nổ súng…{\i0}
Dialogue: 0,0:16:47.72,0:16:48.89,Default,,0,0,0,,David!
Dialogue: 0,0:16:49.72,0:16:50.80,Default,,0,0,0,,David!
Dialogue: 0,0:16:53.89,0:16:55.93,Default,,0,0,0,,David! Này!
Dialogue: 0,0:16:56.02,0:16:58.19,Default,,0,0,0,,Lại là cô à? Cút đi.
Dialogue: 0,0:16:58.27,0:17:00.44,Default,,0,0,0,,Cô cút đi!
Dialogue: 0,0:17:07.40,0:17:11.45,Default,,0,0,0,,Cậu đang làm cái quái gì vậy?\NCậu định đối đầu với Arasaka thật ư?
Dialogue: 0,0:17:11.53,0:17:14.28,Default,,0,0,0,,Cậu sẽ bị giết đấy!
Dialogue: 0,0:17:19.04,0:17:20.83,Default,,0,0,0,,David!
Dialogue: 0,0:17:29.42,0:17:30.96,Default,,0,0,0,,Tuyệt quá, D!
Dialogue: 0,0:17:31.93,0:17:33.85,Default,,0,0,0,,Tuyệt quá!
Dialogue: 0,0:17:35.93,0:17:39.48,Default,,0,0,0,,Chẳng rút kinh nghiệm gì cả.\NĐến đây chỉ để bị bắn thôi à?
Dialogue: 0,0:17:41.85,0:17:43.56,Default,,0,0,0,,Không quan trọng.
Dialogue: 0,0:17:55.12,0:17:56.04,Default,,0,0,0,,Hả?
Dialogue: 0,0:17:56.12,0:17:57.33,Default,,0,0,0,,D?
Dialogue: 0,0:18:01.96,0:18:03.05,Default,,0,0,0,,D!
Dialogue: 0,0:18:04.25,0:18:06.34,Default,,0,0,0,,Tránh xa cậu ấy ra!
Dialogue: 0,0:18:06.96,0:18:08.17,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:18:10.88,0:18:12.84,Default,,0,0,0,,{\an8}Tỉnh lại đi, D!
Dialogue: 0,0:18:13.63,0:18:16.05,Default,,0,0,0,,{\an8}Này! D!
Dialogue: 0,0:18:30.57,0:18:32.28,Default,,0,0,0,,Có gì đó không ổn.
Dialogue: 0,0:18:55.88,0:18:56.92,Default,,0,0,0,,Bố…
Dialogue: 0,0:19:09.94,0:19:13.03,Default,,0,0,0,,Cô nghĩ ai làm ra con chip đó?
Dialogue: 0,0:19:13.53,0:19:16.16,Default,,0,0,0,,Dĩ nhiên ta đã thiết kế\Nmột cơ chế an toàn.
Dialogue: 0,0:19:36.01,0:19:39.22,Default,,0,0,0,,{\i1}Đã lấy được mục tiêu.\NĐã nói là đơn giản mà.{\i0}
Dialogue: 0,0:19:39.30,0:19:41.18,Default,,0,0,0,,{\i1}May mà anh tin tôi.{\i0}
Dialogue: 0,0:19:41.26,0:19:42.80,Default,,0,0,0,,{\i1}Bên anh sao rồi?{\i0}
Dialogue: 0,0:19:42.89,0:19:46.19,Default,,0,0,0,,{\i1}Tốt lắm. Chúng tôi sắp xong rồi.{\i0}
Dialogue: 0,0:19:46.27,0:19:51.23,Default,,0,0,0,,{\an8}{\i1}Đây là khen đấy nhé,\Nnhưng người của tập đoàn đúng là rác rưởi.{\i0}
Dialogue: 0,0:19:57.99,0:20:00.95,Default,,0,0,0,,{\i1}Sau cánh cửa đó\Nlà điểm truy cập vào Soulkiller.{\i0}
Dialogue: 0,0:20:01.03,0:20:02.20,Default,,0,0,0,,{\i1}An ninh thì sao?{\i0}
Dialogue: 0,0:20:02.28,0:20:06.95,Default,,0,0,0,,{\i1}Mất nhiều thời gian hơn dự kiến.\NHãy tìm một cơ thể trong lúc đó đi.{\i0}
Dialogue: 0,0:20:07.04,0:20:08.71,Default,,0,0,0,,Vậy chọn cái nào đây?
Dialogue: 0,0:20:09.42,0:20:11.63,Default,,0,0,0,,Không có thời gian lựa chọn đâu.
Dialogue: 0,0:20:11.71,0:20:12.71,Default,,0,0,0,,Tôi biết.
Dialogue: 0,0:20:20.39,0:20:22.23,Default,,0,0,0,,Không có cái nào là Talia.
Dialogue: 0,0:20:22.97,0:20:24.81,Default,,0,0,0,,Cô vẫn phải chọn.
Dialogue: 0,0:20:25.81,0:20:30.98,Default,,0,0,0,,Tôi đã ghét cảnh con bé\Ncắt bỏ tay chân, ghép lại cơ thể.
Dialogue: 0,0:20:31.06,0:20:33.23,Default,,0,0,0,,Giờ ta còn phải thay thế mọi thứ ư?
Dialogue: 0,0:20:33.32,0:20:35.74,Default,,0,0,0,,Con bé sẽ không còn là Talia nữa.
Dialogue: 0,0:20:35.82,0:20:37.95,Default,,0,0,0,,Lúc này mà cô nói chuyện gì vậy?
Dialogue: 0,0:20:38.03,0:20:40.87,Default,,0,0,0,,Đây là cách duy nhất để con bé sống!
Dialogue: 0,0:20:40.95,0:20:42.37,Default,,0,0,0,,Tôi biết chứ.
Dialogue: 0,0:20:42.95,0:20:45.58,Default,,0,0,0,,Bên trong con bé vẫn là Talia.
Dialogue: 0,0:20:45.66,0:20:47.79,Default,,0,0,0,,Quan trọng là nó còn sống.
Dialogue: 0,0:20:47.87,0:20:49.25,Default,,0,0,0,,Tôi biết. Nhưng…
Dialogue: 0,0:20:50.37,0:20:51.37,Default,,0,0,0,,{\i1}Này King!{\i0}
Dialogue: 0,0:20:51.46,0:20:53.63,Default,,0,0,0,,{\i1}- Sao rồi?\N- Tình hình đã thay đổi.{\i0}
Dialogue: 0,0:20:54.29,0:20:58.13,Default,,0,0,0,,Bạo loạn kết thúc rồi.\NMau lên, kẻo gặp rắc rối đấy.
Dialogue: 0,0:20:58.72,0:21:01.39,Default,,0,0,0,,{\i1}Hiểu rồi.{\i0} Hết thời gian rồi, Avida.
Dialogue: 0,0:21:01.47,0:21:04.35,Default,,0,0,0,,Nếu cô không chọn, tôi sẽ chọn.
Dialogue: 0,0:21:07.52,0:21:08.65,Default,,0,0,0,,Tôi sẽ chọn.
Dialogue: 0,0:21:13.98,0:21:15.65,Default,,0,0,0,,{\i1}Cái quái gì thế này?{\i0}
Dialogue: 0,0:21:15.73,0:21:19.23,Default,,0,0,0,,{\i1}- Chuyện gì vậy?\N- Không thể nào. Tệ quá…{\i0}
Dialogue: 0,0:21:19.74,0:21:22.12,Default,,0,0,0,,Meshuga? Meshuga!
Dialogue: 0,0:21:22.61,0:21:23.53,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:21:23.62,0:21:25.54,Default,,0,0,0,,Soulkiller…
Dialogue: 0,0:21:25.62,0:21:27.04,Default,,0,0,0,,KHÓA\NNHẬP MÃ
Dialogue: 0,0:21:27.70,0:21:28.66,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:21:29.62,0:21:31.37,Default,,0,0,0,,Lấy cơ thể rồi chuồn thôi.
Dialogue: 0,0:21:44.97,0:21:46.39,Default,,0,0,0,,Chết tiệt, Meshuga…
Dialogue: 0,0:21:47.31,0:21:48.27,Default,,0,0,0,,Sẽ ổn thôi.
Dialogue: 0,0:21:48.35,0:21:50.27,Default,,0,0,0,,Không ổn đâu.
Dialogue: 0,0:21:52.39,0:21:53.64,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:21:54.15,0:21:54.98,Default,,0,0,0,,Đồ ngốc!
Dialogue: 0,0:21:58.32,0:21:59.57,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:22:01.57,0:22:03.45,Default,,0,0,0,,Sao họ đến đây nhanh thế?
Dialogue: 0,0:22:05.70,0:22:06.99,Default,,0,0,0,,Là hắn…
Dialogue: 0,0:22:07.08,0:22:09.08,Default,,0,0,0,,Cứ tưởng Avida xử lý rồi chứ!
Dialogue: 0,0:22:24.30,0:22:25.13,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:22:25.84,0:22:27.88,Default,,0,0,0,,Đi thôi. Avida!
Dialogue: 0,0:22:48.24,0:22:50.20,Default,,0,0,0,,- Có đuổi theo không?\N- Không cần.
Dialogue: 0,0:22:50.70,0:22:54.41,Default,,0,0,0,,Tôi xử lý hắn rồi.\NHắn không phải kiểu có thể làm gì được.
Dialogue: 0,0:22:55.71,0:22:56.54,Default,,0,0,0,,{\i1}Vâng.{\i0}
Dialogue: 0,0:22:57.79,0:22:58.67,Default,,0,0,0,,{\i1}Xin lỗi.{\i0}
Dialogue: 0,0:22:58.75,0:23:02.50,Default,,0,0,0,,{\i1}Mất nhiều thời gian hơn dự kiến.\NTôi quay lại ngay đây.{\i0}
Dialogue: 0,0:23:11.68,0:23:14.02,Default,,0,0,0,,Ổn rồi. Có vẻ ta cắt đuôi được họ rồi!
Dialogue: 0,0:23:17.19,0:23:18.15,Default,,0,0,0,,Cô bị bắn à?
Dialogue: 0,0:23:23.65,0:23:25.82,Default,,0,0,0,,Không, chết tiệt. Ở đâu?
Dialogue: 0,0:23:25.90,0:23:27.15,Default,,0,0,0,,Cô trúng đạn ở đâu?
Dialogue: 0,0:23:28.49,0:23:29.32,Default,,0,0,0,,{\an8}Tôi xin lỗi.
Dialogue: 0,0:23:33.37,0:23:36.54,Default,,0,0,0,,Đội Chấn thương sẽ đến ngay thôi.\NCô sẽ ổn thôi!
Dialogue: 0,0:23:38.17,0:23:39.84,Default,,0,0,0,,Weak…
Dialogue: 0,0:23:45.34,0:23:46.51,Default,,0,0,0,,{\an8}Talia…
Dialogue: 0,0:23:48.39,0:23:49.56,Default,,0,0,0,,Tôi biết rồi.
Dialogue: 0,0:25:50.92,0:25:53.92,Default,,0,0,0,,Biên dịch: Khanh Tran
