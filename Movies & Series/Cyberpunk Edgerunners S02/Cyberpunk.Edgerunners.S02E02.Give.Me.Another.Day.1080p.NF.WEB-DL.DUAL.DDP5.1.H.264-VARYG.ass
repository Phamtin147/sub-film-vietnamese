Dialogue: 0,0:00:11.26,0:00:14.43,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:00:14.51,0:00:17.56,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:01:48.98,0:01:50.82,Default,,0,0,0,,{\an8}Anh chẳng thay đổi gì nhỉ?
Dialogue: 0,0:01:52.49,0:01:53.41,Default,,0,0,0,,{\an8}Cô cũng vậy.
Dialogue: 0,0:01:54.45,0:01:56.04,Default,,0,0,0,,Không, tôi đã thay đổi.
Dialogue: 0,0:01:56.53,0:01:59.16,Default,,0,0,0,,Anh thấy được mà, đúng không?
Dialogue: 0,0:01:59.91,0:02:00.79,Default,,0,0,0,,Tôi cũng đã già.
Dialogue: 0,0:02:01.91,0:02:02.99,Default,,0,0,0,,Cả anh nữa nhỉ?
Dialogue: 0,0:02:04.00,0:02:06.55,Default,,0,0,0,,Nhưng anh chẳng thay đổi chút nào.
Dialogue: 0,0:02:08.00,0:02:12.30,Default,,0,0,0,,Cô liên lạc với tôi\Nthì hẳn là to chuyện rồi.
Dialogue: 0,0:02:12.92,0:02:15.97,Default,,0,0,0,,Ừ, đúng là vậy.
Dialogue: 0,0:02:16.05,0:02:17.43,Default,,0,0,0,,Nói tôi nghe đi.
Dialogue: 0,0:02:18.30,0:02:20.30,Default,,0,0,0,,Là chuyện con gái tôi.
Dialogue: 0,0:02:21.52,0:02:24.94,Default,,0,0,0,,Dạo này nó hay giao du\Nvới một đám kỳ quái.
Dialogue: 0,0:02:25.02,0:02:26.94,Default,,0,0,0,,Tự xưng là Maelstrom.
Dialogue: 0,0:02:27.44,0:02:29.86,Default,,0,0,0,,Không đời nào. Bọn chúng ư?
Dialogue: 0,0:02:29.94,0:02:34.57,Default,,0,0,0,,Chưa hết. Nó còn tự ý cài siêu thiết bị.
Dialogue: 0,0:02:35.86,0:02:37.49,Default,,0,0,0,,Bọn sùng bái cơ giới hóa à?
Dialogue: 0,0:02:37.57,0:02:43.28,Default,,0,0,0,,{\an8}Tôi đã cố cản, nhưng nó không chịu nghe!\NTôi làm dữ thì nó chạy tới chỗ chúng.
Dialogue: 0,0:02:43.37,0:02:47.58,Default,,0,0,0,,Gần đây tâm trạng nó bất ổn\Nvà nó cư xử rất lạ.
Dialogue: 0,0:02:47.67,0:02:50.59,Default,,0,0,0,,Tôi nghĩ đó là dấu hiệu\Ncủa siêu cuồng nhân.
Dialogue: 0,0:02:51.59,0:02:53.43,Default,,0,0,0,,- Ồ…\N- Không nghi ngờ gì nữa.
Dialogue: 0,0:02:55.72,0:02:57.56,Default,,0,0,0,,Lần trước là cả hàm.
Dialogue: 0,0:02:57.64,0:03:00.73,Default,,0,0,0,,Nếu bây giờ không ngăn nó sẽ quá muộn.
Dialogue: 0,0:03:06.73,0:03:07.98,Default,,0,0,0,,Ấy, đợi đã!
Dialogue: 0,0:03:08.06,0:03:10.73,Default,,0,0,0,,Cô muốn tôi lo vụ này ư? Vô lý quá!
Dialogue: 0,0:03:11.73,0:03:14.40,Default,,0,0,0,,Anh quen đối phó với băng đảng mà.
Dialogue: 0,0:03:14.49,0:03:16.78,Default,,0,0,0,,{\an8}Nó là con gái cô, đâu phải băng đảng!
Dialogue: 0,0:03:16.86,0:03:18.03,Default,,0,0,0,,{\an8}Hơn nữa…
Dialogue: 0,0:03:19.16,0:03:21.16,Default,,0,0,0,,{\an8}tôi không giỏi dạy dỗ trẻ con.
Dialogue: 0,0:03:21.24,0:03:23.66,Default,,0,0,0,,Vấn đề không chỉ là con bé.
Dialogue: 0,0:03:24.25,0:03:26.17,Default,,0,0,0,,Nó còn liên quan đến Maelstrom!
Dialogue: 0,0:03:26.25,0:03:28.17,Default,,0,0,0,,Dĩ nhiên, anh sẽ có thù lao.
Dialogue: 0,0:03:28.25,0:03:29.71,Default,,0,0,0,,Đó không phải là vấn đề.
Dialogue: 0,0:03:30.21,0:03:34.17,Default,,0,0,0,,Có. Nên tôi mới hỏi dân chuyên như anh.\NKhông phải ỷ quen mà nhờ vả.
Dialogue: 0,0:03:34.26,0:03:36.55,Default,,0,0,0,,Năm mươi nghìn thì sao? Trả trước.
Dialogue: 0,0:03:36.63,0:03:37.96,Default,,0,0,0,,Bình tĩnh đi.
Dialogue: 0,0:03:38.84,0:03:39.80,Default,,0,0,0,,Chưa đủ à?
Dialogue: 0,0:03:40.39,0:03:42.60,Default,,0,0,0,,Tôi tưởng cao hơn thị trường rồi chứ.
Dialogue: 0,0:03:42.68,0:03:45.81,Default,,0,0,0,,Đủ rồi. Hơn cả đủ.
Dialogue: 0,0:03:45.89,0:03:47.27,Default,,0,0,0,,{\an8}Vậy…
Dialogue: 0,0:03:47.35,0:03:49.64,Default,,0,0,0,,{\an8}Không, tôi không thể nhận vụ này.
Dialogue: 0,0:03:50.94,0:03:52.23,Default,,0,0,0,,{\an8}Tôi của bây giờ…
Dialogue: 0,0:03:54.40,0:03:55.74,Default,,0,0,0,,{\an8}Quả nhiên nhỉ?
Dialogue: 0,0:03:57.65,0:03:58.53,Default,,0,0,0,,{\an8}Sao chứ?
Dialogue: 0,0:03:59.03,0:04:00.07,Default,,0,0,0,,{\an8}Nhìn bức ảnh đi.
Dialogue: 0,0:04:01.91,0:04:03.08,Default,,0,0,0,,{\an8}Talia.
Dialogue: 0,0:04:03.79,0:04:05.58,Default,,0,0,0,,Nó là con gái của tôi và anh.
Dialogue: 0,0:04:07.04,0:04:09.38,Default,,0,0,0,,Con gái tôi?
Dialogue: 0,0:05:05.68,0:05:08.98,Default,,0,0,0,,Thảo nào hôm qua tôi thấy cậu bị bắt.
Dialogue: 0,0:05:10.06,0:05:14.23,Default,,0,0,0,,{\an8}Cậu muốn quay bọn Maelstrom à?\NKhông ngờ cậu có sở thích nặng đô vậy.
Dialogue: 0,0:05:14.31,0:05:16.48,Default,,0,0,0,,{\an8}Không phải sở thích! Là công việc.
Dialogue: 0,0:05:17.61,0:05:18.95,Default,,0,0,0,,{\an8}Công việc nhỉ?
Dialogue: 0,0:05:21.86,0:05:23.28,Default,,0,0,0,,{\an8}Vậy là giống tôi rồi.
Dialogue: 0,0:05:24.03,0:05:25.03,Default,,0,0,0,,{\an8}Giống sao?
Dialogue: 0,0:05:25.12,0:05:26.04,Default,,0,0,0,,Giúp tôi đi.
Dialogue: 0,0:05:27.20,0:05:29.70,Default,,0,0,0,,Cậu muốn quay đúng không? Cảnh phim ấy.
Dialogue: 0,0:05:31.87,0:05:32.70,Default,,0,0,0,,{\i1}Đi.{\i0}
Dialogue: 0,0:05:33.29,0:05:35.50,Default,,0,0,0,,Nhân tiện, anh tên gì?
Dialogue: 0,0:05:36.42,0:05:38.05,Default,,0,0,0,,Tôi chưa nghe anh nói.
Dialogue: 0,0:05:39.71,0:05:42.00,Default,,0,0,0,,Tôi là Roman. Còn anh?
Dialogue: 0,0:05:42.72,0:05:45.72,Default,,0,0,0,,- Có cần thiết không?\N- Nói chuyện sẽ dễ hơn mà.
Dialogue: 0,0:05:47.89,0:05:48.72,Default,,0,0,0,,D.
Dialogue: 0,0:05:49.47,0:05:51.22,Default,,0,0,0,,D? Có thế thôi à?
Dialogue: 0,0:05:51.31,0:05:52.69,Default,,0,0,0,,Có thế thôi.
Dialogue: 0,0:05:53.31,0:05:54.69,Default,,0,0,0,,Đến rồi.
Dialogue: 0,0:06:09.87,0:06:12.29,Default,,0,0,0,,TÔI RA HIỆU THÌ CẬU HÉT LÊN HELIO.
Dialogue: 0,0:06:12.37,0:06:14.54,Default,,0,0,0,,TÔI SẼ VÒNG RA SAU ĐỘT KÍCH HẮN.
Dialogue: 0,0:06:14.62,0:06:16.04,Default,,0,0,0,,VẬY TÔI LÀ MỒI NHỬ À?
Dialogue: 0,0:06:16.13,0:06:17.51,Default,,0,0,0,,LÀ GIƯƠNG ĐÔNG KÍCH TÂY
Dialogue: 0,0:06:37.73,0:06:39.32,Default,,0,0,0,,Helio! Heli…
Dialogue: 0,0:06:42.19,0:06:43.69,Default,,0,0,0,,Này, mày là ai?
Dialogue: 0,0:06:47.82,0:06:49.11,Default,,0,0,0,,- Trẻ con ư?\N- Này!
Dialogue: 0,0:06:58.54,0:07:01.04,Default,,0,0,0,,Đau quá!
Dialogue: 0,0:07:05.38,0:07:08.30,Default,,0,0,0,,Khốn kiếp! Thứ {\i1}runner{\i0} chết tiệt!
Dialogue: 0,0:07:20.11,0:07:21.86,Default,,0,0,0,,Này. Mày là Helio đúng không?
Dialogue: 0,0:07:21.94,0:07:24.03,Default,,0,0,0,,- Thằng nào đấy?\N- Helio phải không?
Dialogue: 0,0:07:24.11,0:07:26.53,Default,,0,0,0,,Dừng lại! Phải! Tôi là Helio!
Dialogue: 0,0:07:26.61,0:07:28.03,Default,,0,0,0,,Nghe hỏi rồi trả lời đi.
Dialogue: 0,0:07:28.11,0:07:30.49,Default,,0,0,0,,Nếu là về con chip thì anh đang phí…
Dialogue: 0,0:07:31.95,0:07:34.70,Default,,0,0,0,,Anh muốn biết thông tin gì,\Ntôi sẽ khai tất.
Dialogue: 0,0:07:34.79,0:07:36.33,Default,,0,0,0,,Nói cho rõ ràng đi.
Dialogue: 0,0:07:36.41,0:07:38.87,Default,,0,0,0,,Anh muốn vi mạch dữ liệu của Arasaka mà?
Dialogue: 0,0:07:39.38,0:07:41.67,Default,,0,0,0,,Mày đã tấn công trại của Nước Rắn.
Dialogue: 0,0:07:43.00,0:07:44.46,Default,,0,0,0,,"Khoan đã!"
Dialogue: 0,0:07:44.96,0:07:47.21,Default,,0,0,0,,Anh ta đang cố nói thế.
Dialogue: 0,0:07:50.89,0:07:53.31,Default,,0,0,0,,Thật là… Chuyện đã lâu lắm rồi.
Dialogue: 0,0:07:53.39,0:07:54.56,Default,,0,0,0,,"Lâu lắm rồi"?
Dialogue: 0,0:07:58.14,0:08:01.64,Default,,0,0,0,,{\an8}Gì mà "lâu lắm rồi"?\NTao đã theo vụ này suốt thời gian qua.
Dialogue: 0,0:08:01.73,0:08:03.06,Default,,0,0,0,,{\an8}Tôi biết. Tôi biết mà.
Dialogue: 0,0:08:03.15,0:08:05.32,Default,,0,0,0,,{\an8}Biết thì mau trả lời đi!
Dialogue: 0,0:08:09.61,0:08:13.24,Default,,0,0,0,,{\an8}Tôi không làm. Không nhận vụ đó.
Dialogue: 0,0:08:13.33,0:08:16.08,Default,,0,0,0,,{\an8}Chưa từng đến trại du mục.
Dialogue: 0,0:08:19.00,0:08:19.96,Default,,0,0,0,,{\an8}Thật không?
Dialogue: 0,0:08:20.04,0:08:22.83,Default,,0,0,0,,{\an8}Thật mà. Anh phải tin tôi.
Dialogue: 0,0:08:23.63,0:08:24.46,Default,,0,0,0,,{\an8}Tại sao…
Dialogue: 0,0:08:25.46,0:08:27.05,Default,,0,0,0,,Tại sao anh không đi?
Dialogue: 0,0:08:28.26,0:08:31.35,Default,,0,0,0,,Lẽ ra nó không phải một cuộc tấn công.
Dialogue: 0,0:08:31.43,0:08:34.31,Default,,0,0,0,,Công việc có vẻ đơn giản, tìm một người.
Dialogue: 0,0:08:34.39,0:08:36.73,Default,,0,0,0,,Nhưng thù lao lại cao đến mức kỳ lạ.
Dialogue: 0,0:08:36.81,0:08:40.15,Default,,0,0,0,,Những người khác thấy dễ ăn thì hí hửng.
Dialogue: 0,0:08:40.23,0:08:42.82,Default,,0,0,0,,Nhưng tôi thấy ám muội nên đã rút lui.
Dialogue: 0,0:08:43.31,0:08:46.77,Default,,0,0,0,,Quả nhiên, chuyện đi chệch hướng\Nvà đấu súng nổ ra.
Dialogue: 0,0:08:46.86,0:08:48.45,Default,,0,0,0,,Vậy là có người thuê anh?
Dialogue: 0,0:08:48.53,0:08:49.36,Default,,0,0,0,,Ừ.
Dialogue: 0,0:08:50.32,0:08:52.86,Default,,0,0,0,,- Là ai?\N- Tôi không biết.
Dialogue: 0,0:08:52.95,0:08:57.50,Default,,0,0,0,,Khách hàng giấu tên. Giờ nghĩ lại,\Nchắc chắn là một gã văn phòng.
Dialogue: 0,0:08:57.58,0:08:58.62,Default,,0,0,0,,Tập đoàn nào?
Dialogue: 0,0:08:58.70,0:09:00.62,Default,,0,0,0,,Tôi linh cảm là Arasaka.
Dialogue: 0,0:09:00.71,0:09:02.38,Default,,0,0,0,,Arasaka muốn gì ở bọn tao?
Dialogue: 0,0:09:02.46,0:09:03.88,Default,,0,0,0,,{\an8}Biết chết liền.
Dialogue: 0,0:09:03.96,0:09:07.00,Default,,0,0,0,,{\an8}Nhưng xem lộ trình yêu cầu\Nvà cách thực hiện thì rõ.
Dialogue: 0,0:09:07.51,0:09:09.35,Default,,0,0,0,,Không làm vụ đó là chính xác.
Dialogue: 0,0:09:09.42,0:09:12.51,Default,,0,0,0,,Trong các tập đoàn,\Ntôi không chịu nổi Arasaka.
Dialogue: 0,0:09:12.59,0:09:16.05,Default,,0,0,0,,Lúc nãy anh có nhắc đến\Ncon chip của Arasaka.
Dialogue: 0,0:09:16.14,0:09:17.39,Default,,0,0,0,,Có liên quan không?
Dialogue: 0,0:09:17.97,0:09:19.76,Default,,0,0,0,,Chuyện đó hoàn toàn khác.
Dialogue: 0,0:09:19.85,0:09:22.44,Default,,0,0,0,,Những kẻ liên quan cứ lần lượt biến mất.
Dialogue: 0,0:09:22.94,0:09:23.90,Default,,0,0,0,,"Biến mất"?
Dialogue: 0,0:09:23.98,0:09:25.77,Default,,0,0,0,,Có lẽ đã chết ở đâu đó.
Dialogue: 0,0:09:26.27,0:09:29.69,Default,,0,0,0,,Arasaka đang suy tàn,\Nnhưng dính vào nó chẳng tốt đẹp gì.
Dialogue: 0,0:09:29.78,0:09:31.99,Default,,0,0,0,,Tập đoàn đó bị nguyền rủa mà.
Dialogue: 0,0:09:34.07,0:09:36.99,Default,,0,0,0,,Anh là người sống sót ở trại à?
Dialogue: 0,0:09:37.49,0:09:40.91,Default,,0,0,0,,Anh làm việc này suốt thời gian qua ư?\NTừ đó đến nay?
Dialogue: 0,0:09:41.75,0:09:42.75,Default,,0,0,0,,Suốt như vậy ư?
Dialogue: 0,0:10:05.94,0:10:08.11,Default,,0,0,0,,D, có lẽ nào anh vừa giết…
Dialogue: 0,0:10:08.19,0:10:09.57,Default,,0,0,0,,Hắn chưa chết.
Dialogue: 0,0:10:10.19,0:10:13.86,Default,,0,0,0,,Tôi không giết người.\NHắn không tấn công trại.
Dialogue: 0,0:10:21.04,0:10:22.42,Default,,0,0,0,,Ừm…
Dialogue: 0,0:10:22.50,0:10:25.50,Default,,0,0,0,,{\an8}- Tôi về nhà được không?\N- Sao?
Dialogue: 0,0:10:38.43,0:10:44.31,Default,,0,0,0,,Siêu thiết bị được cài vào lần này\Nđang thích nghi rất tốt với con gái bà.
Dialogue: 0,0:10:44.94,0:10:47.94,Default,,0,0,0,,Trên thực tế,\Nloại bỏ nó có khi còn rủi ro hơn.
Dialogue: 0,0:10:48.02,0:10:50.44,Default,,0,0,0,,Nhưng nó có thật sự an toàn không?
Dialogue: 0,0:10:50.52,0:10:54.32,Default,,0,0,0,,Toàn thân con bé chỉ toàn siêu thiết bị.\NTôi lo nó sẽ phát điên.
Dialogue: 0,0:10:54.90,0:10:57.28,Default,,0,0,0,,Ý bà là hóa siêu cuồng nhân à?
Dialogue: 0,0:10:57.37,0:10:58.33,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:58.41,0:11:03.54,Default,,0,0,0,,Với lượng siêu thiết bị trên người cô ấy,\Nxuất hiện triệu chứng cũng không có gì lạ.
Dialogue: 0,0:11:03.62,0:11:06.50,Default,,0,0,0,,Nhưng đến giờ,\Nchúng tôi chưa thấy dấu hiệu nào.
Dialogue: 0,0:11:07.00,0:11:10.75,Default,,0,0,0,,Dù ca này khá hiếm gặp,\Ncô ấy vẫn đang ổn định.
Dialogue: 0,0:11:11.55,0:11:13.09,Default,,0,0,0,,Bà có thể yên tâm
Dialogue: 0,0:11:14.55,0:11:16.93,Default,,0,0,0,,Vậy phương châm sau này là…
Dialogue: 0,0:11:18.55,0:11:20.84,Default,,0,0,0,,Anh phải quay lại văn phòng rồi.
Dialogue: 0,0:11:21.81,0:11:22.64,Default,,0,0,0,,Vâng.
Dialogue: 0,0:11:23.18,0:11:26.18,Default,,0,0,0,,Con bé sẽ ổn thôi. Bác sĩ cũng nói vậy mà.
Dialogue: 0,0:11:26.27,0:11:29.02,Default,,0,0,0,,Nhưng nếu nó cài thêm siêu thiết bị…
Dialogue: 0,0:11:29.11,0:11:32.74,Default,,0,0,0,,Anh hiểu. Nên lần này\Nta mới dùng biện pháp cứng rắn.
Dialogue: 0,0:11:32.82,0:11:33.95,Default,,0,0,0,,Tạm thời sẽ ổn thôi.
Dialogue: 0,0:11:34.03,0:11:37.33,Default,,0,0,0,,"Tạm thời"? Ta phải bắt nó\Ntừ bỏ hoàn toàn!
Dialogue: 0,0:11:37.41,0:11:38.66,Default,,0,0,0,,Bằng cách nào?
Dialogue: 0,0:11:39.16,0:11:44.42,Default,,0,0,0,,Em hiểu tại sao con bé\Nmuốn dựa dẫm vào siêu thiết bị mà.
Dialogue: 0,0:11:45.12,0:11:46.75,Default,,0,0,0,,Anh nghĩ là lỗi của em ư?
Dialogue: 0,0:11:47.25,0:11:51.59,Default,,0,0,0,,Không hề. Có trách\Nthì phải trách cả hai chúng ta.
Dialogue: 0,0:11:52.09,0:11:56.09,Default,,0,0,0,,{\an8}Nhưng không ai đáng trách cả.\NDù là em hay Talia.
Dialogue: 0,0:11:57.84,0:12:02.93,Default,,0,0,0,,Em nghĩ kỹ đi.\NĐâu mới là lựa chọn tốt nhất.
Dialogue: 0,0:12:03.81,0:12:05.52,Default,,0,0,0,,Anh nói phải. Em xin lỗi.
Dialogue: 0,0:12:05.60,0:12:09.81,Default,,0,0,0,,Không sao. Anh muốn nói chuyện với Talia,\Nnhưng anh phải đi rồi.
Dialogue: 0,0:12:10.35,0:12:12.56,Default,,0,0,0,,Cấp dưới gọi inh cả tai này.
Dialogue: 0,0:12:13.44,0:12:14.36,Default,,0,0,0,,Tôi đây.
Dialogue: 0,0:12:15.44,0:12:18.07,Default,,0,0,0,,Ừ. Không có vấn đề gì. Đó là chuyện khác.
Dialogue: 0,0:12:18.86,0:12:19.82,Default,,0,0,0,,Về chuyện đó…
Dialogue: 0,0:12:22.62,0:12:25.54,Default,,0,0,0,,Avida, sao thế? Chồng cô đâu?
Dialogue: 0,0:12:25.62,0:12:27.16,Default,,0,0,0,,Anh ấy đi rồi.
Dialogue: 0,0:12:27.66,0:12:29.04,Default,,0,0,0,,Có chuyện gì à?
Dialogue: 0,0:12:29.87,0:12:31.08,Default,,0,0,0,,Không có gì.
Dialogue: 0,0:12:32.33,0:12:33.79,Default,,0,0,0,,Talia dậy chưa nhỉ?
Dialogue: 0,0:12:37.17,0:12:40.26,Default,,0,0,0,,Có lẽ còn ngủ,\Nnhưng ít ra anh có thể thấy mặt nó.
Dialogue: 0,0:12:42.18,0:12:44.60,Default,,0,0,0,,Talia! Con làm gì thế?
Dialogue: 0,0:12:44.68,0:12:47.64,Default,,0,0,0,,Đồ mặc đâu rồi?\NXem con làm gì với áo choàng này.
Dialogue: 0,0:12:47.73,0:12:48.90,Default,,0,0,0,,Talia!
Dialogue: 0,0:12:49.69,0:12:51.36,Default,,0,0,0,,Sao con lúc nào cũng…
Dialogue: 0,0:12:51.44,0:12:52.32,Default,,0,0,0,,Ai vậy?
Dialogue: 0,0:12:55.11,0:12:58.11,Default,,0,0,0,,{\an8}Hiếm thấy thiết bị thế này lắm à?
Dialogue: 0,0:12:58.61,0:12:59.44,Default,,0,0,0,,Không, chỉ là…
Dialogue: 0,0:13:00.78,0:13:01.70,Default,,0,0,0,,Chắc vậy nhỉ?
Dialogue: 0,0:13:03.87,0:13:06.66,Default,,0,0,0,,{\an8}Mẹ gọi họ đến đúng không?
Dialogue: 0,0:13:06.74,0:13:07.78,Default,,0,0,0,,"Họ"?
Dialogue: 0,0:13:08.29,0:13:10.13,Default,,0,0,0,,Quân của Kang Tao.
Dialogue: 0,0:13:10.96,0:13:12.13,Default,,0,0,0,,Không thể tin nổi.
Dialogue: 0,0:13:12.21,0:13:14.59,Default,,0,0,0,,Đó là vì con…
Dialogue: 0,0:13:15.09,0:13:17.51,Default,,0,0,0,,- Bác sĩ nói gì?\N- Sao?
Dialogue: 0,0:13:17.59,0:13:22.14,Default,,0,0,0,,- Con sắp thành siêu cuồng nhân à?\N- Tạm thời thì con ổn định.
Dialogue: 0,0:13:23.22,0:13:24.39,Default,,0,0,0,,Vậy con về đây.
Dialogue: 0,0:13:24.47,0:13:26.89,Default,,0,0,0,,Về sao? Để mẹ đi cùng…
Dialogue: 0,0:13:27.60,0:13:29.14,Default,,0,0,0,,Con không về nhà.
Dialogue: 0,0:13:29.23,0:13:30.36,Default,,0,0,0,,Avida!
Dialogue: 0,0:13:31.98,0:13:33.86,Default,,0,0,0,,- Đau quá.\N- Chết tiệt!
Dialogue: 0,0:13:37.73,0:13:39.11,Default,,0,0,0,,Gặp sau nhé.
Dialogue: 0,0:13:40.28,0:13:41.45,Default,,0,0,0,,Talia!
Dialogue: 0,0:13:51.16,0:13:51.99,Default,,0,0,0,,Talia!
Dialogue: 0,0:13:55.63,0:13:57.67,Default,,0,0,0,,Avida, cô ở đây nhé.
Dialogue: 0,0:14:07.05,0:14:08.05,Default,,0,0,0,,Này.
Dialogue: 0,0:14:09.01,0:14:13.06,Default,,0,0,0,,- Xin lỗi, nhưng tôi rất rành khu này.\N- Ông là ai?
Dialogue: 0,0:14:13.73,0:14:16.48,Default,,0,0,0,,Tôi là bạn cũ của mẹ cháu.
Dialogue: 0,0:14:16.56,0:14:17.89,Default,,0,0,0,,Vậy là người dưng.
Dialogue: 0,0:14:18.48,0:14:20.32,Default,,0,0,0,,Ta nói chuyện chút được không?
Dialogue: 0,0:14:23.57,0:14:24.82,Default,,0,0,0,,Đợi đã.
Dialogue: 0,0:14:26.24,0:14:28.58,Default,,0,0,0,,Tôi sẽ chỉ cháu cách vô hiệu hóa GPS.
Dialogue: 0,0:14:29.20,0:14:32.00,Default,,0,0,0,,{\i1}Lúc nãy cháu đang tìm nó phải không?{\i0}
Dialogue: 0,0:14:32.83,0:14:35.00,Default,,0,0,0,,Để họ không mò ra cháu đang ở đâu.
Dialogue: 0,0:14:35.54,0:14:37.38,Default,,0,0,0,,- Đúng chứ?\N- Ông làm được à?
Dialogue: 0,0:14:38.04,0:14:41.25,Default,,0,0,0,,Kang Tao hẳn sẽ gắn chip\Ndọc theo đùi trong.
Dialogue: 0,0:14:41.76,0:14:44.43,Default,,0,0,0,,Nếu tôi vô hiệu hóa nó,\Ncháu sẽ nghe tôi chứ?
Dialogue: 0,0:14:45.47,0:14:47.35,Default,,0,0,0,,Động vào tôi, tôi xử ông ngay.
Dialogue: 0,0:14:47.43,0:14:49.97,Default,,0,0,0,,Được rồi. Không cần động vào đâu.
Dialogue: 0,0:14:53.77,0:14:55.40,Default,,0,0,0,,Ông là dân {\i1}cyberpunk{\i0} à?
Dialogue: 0,0:14:56.31,0:14:57.14,Default,,0,0,0,,Lẽ ra là thế.
Dialogue: 0,0:14:58.23,0:14:59.90,Default,,0,0,0,,Được rồi. Xong xuôi.
Dialogue: 0,0:15:00.98,0:15:04.28,Default,,0,0,0,,Đã ghi đè lên ID.\NHọ không thể truy vết cháu nữa.
Dialogue: 0,0:15:06.16,0:15:08.83,Default,,0,0,0,,Chuyện tôi muốn nói là…
Dialogue: 0,0:15:12.66,0:15:14.58,Default,,0,0,0,,Chúng ta gần bằng nhau.
Dialogue: 0,0:15:15.50,0:15:16.59,Default,,0,0,0,,Cái gì cơ?
Dialogue: 0,0:15:16.67,0:15:17.84,Default,,0,0,0,,Chiều cao của chúng ta.
Dialogue: 0,0:15:23.84,0:15:25.59,Default,,0,0,0,,Này! Talia!
Dialogue: 0,0:15:51.41,0:15:53.00,Default,,0,0,0,,{\an8}Camera của mình…
Dialogue: 0,0:15:53.54,0:15:54.75,Default,,0,0,0,,{\an8}- Cái gì kia?\N- Hả?
Dialogue: 0,0:15:55.25,0:15:58.17,Default,,0,0,0,,{\an8}- Đó là camera nhỉ?\N- Đây là camera dự phòng.
Dialogue: 0,0:15:58.25,0:15:59.75,Default,,0,0,0,,Chúng khác gì nhau?
Dialogue: 0,0:15:59.83,0:16:03.13,Default,,0,0,0,,Ồ, anh muốn nghe à? Anh có hứng thú ư?
Dialogue: 0,0:16:03.21,0:16:04.04,Default,,0,0,0,,Không.
Dialogue: 0,0:16:05.71,0:16:07.71,Default,,0,0,0,,{\an8}Chẳng lẽ đành phải bỏ cuộc ư?
Dialogue: 0,0:16:07.80,0:16:11.72,Default,,0,0,0,,{\an8}- Nói thì dễ lắm.\N- Anh hết manh mối rồi, đúng không?
Dialogue: 0,0:16:11.80,0:16:13.30,Default,,0,0,0,,{\an8}Nên tôi mới suy nghĩ đây.
Dialogue: 0,0:16:13.39,0:16:15.60,Default,,0,0,0,,{\an8}Nghĩ ra gì thì cho tôi biết nhé.
Dialogue: 0,0:16:15.68,0:16:17.10,Default,,0,0,0,,Cậu cũng nghĩ đi!
Dialogue: 0,0:16:17.18,0:16:18.31,Default,,0,0,0,,Tôi á?
Dialogue: 0,0:16:18.39,0:16:21.31,Default,,0,0,0,,Dĩ nhiên. Nghĩ ra mới được về.
Dialogue: 0,0:16:23.11,0:16:26.11,Default,,0,0,0,,Hay ta thử hack vào Arasaka tìm thông tin?
Dialogue: 0,0:16:26.19,0:16:28.78,Default,,0,0,0,,Bị ngu à?\NTập đoàn thối nát vẫn là tập đoàn.
Dialogue: 0,0:16:28.86,0:16:32.99,Default,,0,0,0,,Nên ta không trực tiếp nhắm vào Arasaka,\Nmà vào đối tác nhỏ hơn của họ.
Dialogue: 0,0:16:33.08,0:16:35.37,Default,,0,0,0,,Tấn công Arasaka thông qua họ thì sao?
Dialogue: 0,0:16:39.25,0:16:42.63,Default,,0,0,0,,Chết tiệt. Cái quái gì thế này?\NKhông ổn rồi.
Dialogue: 0,0:16:43.29,0:16:46.92,Default,,0,0,0,,Ngay từ đầu đã không có liên kết!\NNày, giờ sao đây?
Dialogue: 0,0:16:47.01,0:16:48.89,Default,,0,0,0,,- Hả? Tôi?\N- Ý tưởng của cậu mà.
Dialogue: 0,0:16:48.97,0:16:51.01,Default,,0,0,0,,Vậy là lỗi của tôi à?
Dialogue: 0,0:16:54.05,0:16:58.60,Default,,0,0,0,,Này, gã Helio đó. Anh ta có nói gì đó\Nvề con chip của Arasaka mà.
Dialogue: 0,0:16:59.10,0:17:00.77,Default,,0,0,0,,Anh có thông tin gì không?
Dialogue: 0,0:17:00.85,0:17:04.60,Default,,0,0,0,,Có. Tôi đã lấy chút ít,\Nđể đề phòng. Đây à?
Dialogue: 0,0:17:05.11,0:17:08.49,Default,,0,0,0,,Nếu ta lấy được con chip,\NArasaka có thể sẽ muốn đàm phán.
Dialogue: 0,0:17:09.95,0:17:11.12,Default,,0,0,0,,Cậu nghĩ vậy à?
Dialogue: 0,0:17:11.20,0:17:14.79,Default,,0,0,0,,Tôi không biết.\NAnh còn lựa chọn nào không?
Dialogue: 0,0:17:15.53,0:17:16.41,Default,,0,0,0,,Không.
Dialogue: 0,0:17:16.49,0:17:19.95,Default,,0,0,0,,{\an8}Có triển vọng mà. Ta thử đi.
Dialogue: 0,0:17:21.33,0:17:23.21,Default,,0,0,0,,Thông tin nói nó ở quanh đây à?
Dialogue: 0,0:17:25.25,0:17:26.13,Default,,0,0,0,,Tòa nhà đó ư?
Dialogue: 0,0:17:27.05,0:17:29.14,Default,,0,0,0,,- Ừ.\N- Sao vậy?
Dialogue: 0,0:17:29.21,0:17:33.63,Default,,0,0,0,,- Tòa nhà đó không khiến cậu rợn người à?\N- "Rợn người"?
Dialogue: 0,0:17:34.76,0:17:36.55,Default,,0,0,0,,Tôi không cảm nhận được.
Dialogue: 0,0:17:37.72,0:17:39.06,Default,,0,0,0,,Kệ đi.
Dialogue: 0,0:17:47.73,0:17:48.65,Default,,0,0,0,,D!
Dialogue: 0,0:17:48.73,0:17:51.15,Default,,0,0,0,,Bên đó sao rồi?
Dialogue: 0,0:17:53.95,0:17:55.29,Default,,0,0,0,,D.
Dialogue: 0,0:17:55.37,0:17:58.29,Default,,0,0,0,,Không thấy cửa nào có vẻ sẽ mở hết.
Dialogue: 0,0:17:59.54,0:18:00.37,Default,,0,0,0,,D?
Dialogue: 0,0:18:01.58,0:18:02.50,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:18:02.58,0:18:04.54,Default,,0,0,0,,Camera giám sát có ở khắp nơi.
Dialogue: 0,0:18:04.63,0:18:06.92,Default,,0,0,0,,- Gì cơ?\N- Đừng tìm nữa.
Dialogue: 0,0:18:07.00,0:18:09.00,Default,,0,0,0,,Chúng được lắp rất khéo.
Dialogue: 0,0:18:09.09,0:18:10.38,Default,,0,0,0,,Thật à?
Dialogue: 0,0:18:11.59,0:18:13.80,Default,,0,0,0,,{\an8}Các cửa khác đều là bẫy.
Dialogue: 0,0:18:13.88,0:18:16.34,Default,,0,0,0,,{\an8}Cửa này có vẻ sẽ mở được, nhưng…
Dialogue: 0,0:18:16.43,0:18:17.26,Default,,0,0,0,,{\an8}Nhưng sao?
Dialogue: 0,0:18:17.85,0:18:21.23,Default,,0,0,0,,Tòa nhà này chống xâm nhập\Nkiên cố hơn đa số các tập đoàn.
Dialogue: 0,0:18:21.31,0:18:23.81,Default,,0,0,0,,Nhưng chỉ cửa này là có tí khe hở.
Dialogue: 0,0:18:23.89,0:18:25.98,Default,,0,0,0,,Họ làm thế để dễ ra vào hơn chăng?
Dialogue: 0,0:18:26.06,0:18:27.39,Default,,0,0,0,,Thường thì ngược lại.
Dialogue: 0,0:18:28.02,0:18:30.73,Default,,0,0,0,,Có nghĩa đây có thể là một cái bẫy.
Dialogue: 0,0:18:30.82,0:18:31.65,Default,,0,0,0,,Bẫy sao?
Dialogue: 0,0:18:33.95,0:18:35.03,Default,,0,0,0,,{\an8}Làm sao đây?
Dialogue: 0,0:18:35.78,0:18:37.28,Default,,0,0,0,,{\an8}- Vào thôi.\N- Gì cơ?
Dialogue: 0,0:18:37.37,0:18:39.16,Default,,0,0,0,,{\an8}Nhưng nó là bẫy mà!
Dialogue: 0,0:18:39.24,0:18:41.66,Default,,0,0,0,,Họ đang cố khiêu khích tôi.
Dialogue: 0,0:18:41.75,0:18:44.17,Default,,0,0,0,,Chết tiệt. Tôi sẽ làm thế.
Dialogue: 0,0:18:48.54,0:18:50.13,Default,,0,0,0,,- Cẩn thận đấy!\N- Xem nhé.
Dialogue: 0,0:19:10.86,0:19:12.65,Default,,0,0,0,,Tôi không làm.
Dialogue: 0,0:19:31.71,0:19:33.13,Default,,0,0,0,,Ồ, anh tỉnh rồi.
Dialogue: 0,0:19:35.13,0:19:36.09,Default,,0,0,0,,Đây là đâu?
Dialogue: 0,0:19:36.18,0:19:37.35,Default,,0,0,0,,Nhà tôi.
Dialogue: 0,0:19:37.43,0:19:41.14,Default,,0,0,0,,Anh chợt bất tỉnh, phiền thật.\NKhông thể bỏ mặc anh, nên tôi gọi taxi…
Dialogue: 0,0:19:41.22,0:19:42.05,Default,,0,0,0,,Cô ta đâu?
Dialogue: 0,0:19:42.14,0:19:45.73,Default,,0,0,0,,Ý anh là sao?\N"Cô ta" nào? Anh trả tiền taxi…
Dialogue: 0,0:19:45.81,0:19:48.52,Default,,0,0,0,,Chết tiệt! Con khốn đó.
Dialogue: 0,0:19:53.28,0:19:54.53,Default,,0,0,0,,Bỗng dưng bật dậy…
Dialogue: 0,0:19:54.61,0:19:56.61,Default,,0,0,0,,Phút chốc đã đo đất.
Dialogue: 0,0:19:56.70,0:19:59.12,Default,,0,0,0,,Còn không biết chuyện gì xảy ra.
Dialogue: 0,0:20:02.78,0:20:03.95,Default,,0,0,0,,Anh định thế nào?
Dialogue: 0,0:20:04.04,0:20:07.38,Default,,0,0,0,,Trả… thù.
Dialogue: 0,0:20:07.96,0:20:09.71,Default,,0,0,0,,Không được đâu.
Dialogue: 0,0:20:11.84,0:20:12.88,Default,,0,0,0,,Sáng rồi à?
Dialogue: 0,0:20:13.38,0:20:15.01,Default,,0,0,0,,- Không, sắp tối rồi.\N- Sao?
Dialogue: 0,0:20:15.09,0:20:16.97,Default,,0,0,0,,- Anh đã ngủ nửa ngày.\N- Không thể nào.
Dialogue: 0,0:20:17.05,0:20:20.26,Default,,0,0,0,,- Roman! Bạn con tỉnh chưa?\N- Rồi ạ.
Dialogue: 0,0:20:20.34,0:20:22.68,Default,,0,0,0,,- Đi mua đồ giúp bố nhé?\N- Vâng.
Dialogue: 0,0:20:22.76,0:20:26.18,Default,,0,0,0,,Tôi ra ngoài đây, D.\NChuyện trả thù để mai nhé.
Dialogue: 0,0:20:26.27,0:20:29.44,Default,,0,0,0,,À, đừng quên trả tiền taxi cho tôi đấy!
Dialogue: 0,0:20:42.78,0:20:47.79,Default,,0,0,0,,Này! Gì ấy nhỉ? Cậu bé hữu cơ!\NKhông, đợi đã, ai nhỉ?
Dialogue: 0,0:20:50.04,0:20:51.83,Default,,0,0,0,,Này! Nhớ tôi không?
Dialogue: 0,0:20:51.92,0:20:52.75,Default,,0,0,0,,Hả?
Dialogue: 0,0:20:54.29,0:20:55.21,Default,,0,0,0,,{\an8}Chết!
Dialogue: 0,0:20:55.30,0:20:57.09,Default,,0,0,0,,{\an8}"Chết"? Vụ quay phim ấy…
Dialogue: 0,0:20:57.17,0:20:59.59,Default,,0,0,0,,Tôi đang bận mua sắm. Xin lỗi nhé!
Dialogue: 0,0:20:59.68,0:21:01.39,Default,,0,0,0,,Sao vội thế?
Dialogue: 0,0:21:01.47,0:21:03.64,Default,,0,0,0,,Ừm, tôi đang bận mua đồ…
Dialogue: 0,0:21:03.72,0:21:05.01,Default,,0,0,0,,Xong rồi mà nhỉ?
Dialogue: 0,0:21:05.64,0:21:06.89,Default,,0,0,0,,Tôi xin lỗi.
Dialogue: 0,0:21:06.97,0:21:11.18,Default,,0,0,0,,- Sao lại xin lỗi?\N- Cô không giận tôi à?
Dialogue: 0,0:21:11.27,0:21:13.31,Default,,0,0,0,,Hả? Có lẽ tôi sắp giận đấy.
Dialogue: 0,0:21:13.86,0:21:15.57,Default,,0,0,0,,Đùa thôi. Của cậu đây.
Dialogue: 0,0:21:15.65,0:21:17.15,Default,,0,0,0,,- Camera…\N- Trả cậu đấy.
Dialogue: 0,0:21:17.23,0:21:19.69,Default,,0,0,0,,Ối! Không!
Dialogue: 0,0:21:20.20,0:21:22.12,Default,,0,0,0,,Này, video đó hay lắm.
Dialogue: 0,0:21:22.70,0:21:24.91,Default,,0,0,0,,- Hả?\N- Video quay tôi!
Dialogue: 0,0:21:25.41,0:21:26.87,Default,,0,0,0,,Tôi xem nó vài lần rồi.
Dialogue: 0,0:21:27.49,0:21:29.74,Default,,0,0,0,,Không đâu, nhờ camera này tốt thôi.
Dialogue: 0,0:21:32.21,0:21:34.17,Default,,0,0,0,,Ơ, cái gì…
Dialogue: 0,0:21:34.25,0:21:37.88,Default,,0,0,0,,Máy tốt hay không,\Nngười thường không quay video đó được đâu.
Dialogue: 0,0:21:37.96,0:21:40.13,Default,,0,0,0,,{\an8}Cô nghĩ vậy à?
Dialogue: 0,0:21:40.22,0:21:41.39,Default,,0,0,0,,{\an8}Cậu rất có tài.
Dialogue: 0,0:21:43.14,0:21:44.89,Default,,0,0,0,,{\an8}Ừm, thì…
Dialogue: 0,0:21:44.97,0:21:47.64,Default,,0,0,0,,{\an8}Cảm ơn cô.
Dialogue: 0,0:21:47.72,0:21:49.89,Default,,0,0,0,,{\an8}Hay cậu quay tôi nữa nhé?
Dialogue: 0,0:21:50.39,0:21:52.56,Default,,0,0,0,,{\an8}- Sao?\N- Không được à?
Dialogue: 0,0:21:53.06,0:21:53.89,Default,,0,0,0,,{\an8}Được…
Dialogue: 0,0:21:54.60,0:21:55.44,Default,,0,0,0,,{\an8}Được chứ.
Dialogue: 0,0:21:55.52,0:21:57.69,Default,,0,0,0,,Tuyệt! Hứa rồi nhé!
Dialogue: 0,0:21:57.77,0:22:00.73,Default,,0,0,0,,- Cho tôi thông tin liên lạc đi.\N- À, được thôi.
Dialogue: 0,0:22:01.74,0:22:04.49,Default,,0,0,0,,Xem nào. Roman?
Dialogue: 0,0:22:04.99,0:22:08.16,Default,,0,0,0,,- Tôi là Talia. Rất vui được gặp cậu.\N- Tôi cũng vậy.
Dialogue: 0,0:22:08.24,0:22:10.78,Default,,0,0,0,,Mai đến quay ca phẫu thuật của tôi nhé.
Dialogue: 0,0:22:12.04,0:22:13.17,Default,,0,0,0,,Phẫu thuật?
Dialogue: 0,0:22:15.29,0:22:17.88,Default,,0,0,0,,Xin lỗi, tôi phải đi đây. Tôi sẽ nhắn sau.
Dialogue: 0,0:22:17.96,0:22:20.55,Default,,0,0,0,,- Này, đợi…\N- Tạm biệt. Hẹn mai gặp.
Dialogue: 0,0:22:20.63,0:22:21.92,Default,,0,0,0,,Này! Ngày mai sao?
Dialogue: 0,0:22:24.51,0:22:26.51,Default,,0,0,0,,Chà. Ngầu quá.
Dialogue: 0,0:22:29.77,0:22:31.15,Default,,0,0,0,,Hết pin rồi.
Dialogue: 0,0:22:39.15,0:22:40.11,Default,,0,0,0,,{\i1}Weak!{\i0}
Dialogue: 0,0:22:40.19,0:22:41.57,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:22:41.65,0:22:43.94,Default,,0,0,0,,{\i1}Talia chưa về nhà.{\i0}
Dialogue: 0,0:22:44.03,0:22:45.99,Default,,0,0,0,,{\i1}Anh nói nó sẽ ổn mà.{\i0}
Dialogue: 0,0:22:46.07,0:22:48.03,Default,,0,0,0,,{\i1}Thiết bị theo dõi cũng tắt rồi.{\i0}
Dialogue: 0,0:22:48.12,0:22:49.08,Default,,0,0,0,,Vậy à?
Dialogue: 0,0:22:49.16,0:22:52.79,Default,,0,0,0,,{\i1}Đó là công nghệ tùy chỉnh.\NCon bé không thể tự vô hiệu hóa nó.{\i0}
Dialogue: 0,0:22:52.87,0:22:55.71,Default,,0,0,0,,Này, bình tĩnh đi. Tôi cũng sẽ tìm con bé.
Dialogue: 0,0:22:55.79,0:22:56.79,Default,,0,0,0,,{\i1}Làm sao tìm đây?{\i0}
Dialogue: 0,0:22:56.88,0:23:00.72,Default,,0,0,0,,Vẫn có cách. Tôi sẽ báo ngay khi có tin.
Dialogue: 0,0:23:01.59,0:23:03.88,Default,,0,0,0,,{\i1}Được rồi. Tốt nhất là vậy.{\i0}
Dialogue: 0,0:23:07.93,0:23:09.26,Default,,0,0,0,,Anh làm gì thế?
Dialogue: 0,0:23:09.35,0:23:11.98,Default,,0,0,0,,Tăng cường ICE của tôi, để đề phòng thôi.
Dialogue: 0,0:23:12.47,0:23:13.85,Default,,0,0,0,,Hôm nay vẫn đi à?
Dialogue: 0,0:23:13.93,0:23:17.93,Default,,0,0,0,,- Ừ. Tôi làm xong rồi đi.\N- Ừm, tôi…
Dialogue: 0,0:23:18.02,0:23:20.27,Default,,0,0,0,,- Cậu cũng đi nữa.\N- Phải rồi.
Dialogue: 0,0:23:23.15,0:23:26.32,Default,,0,0,0,,Talia. Cũng may là cô gọi.
Dialogue: 0,0:23:26.41,0:23:29.00,Default,,0,0,0,,{\i1}Thế à? Đem camera đến ngay đi.{\i0}
Dialogue: 0,0:23:29.07,0:23:31.82,Default,,0,0,0,,Chuyện đó… Hôm nay tôi không đến được.
Dialogue: 0,0:23:31.91,0:23:32.83,Default,,0,0,0,,Sao?
Dialogue: 0,0:23:32.91,0:23:34.33,Default,,0,0,0,,{\i1}Mai thì sao?{\i0}
Dialogue: 0,0:23:35.83,0:23:38.12,Default,,0,0,0,,{\an8}Chỉ là hôm nay tôi bận quá.
Dialogue: 0,0:23:38.88,0:23:41.84,Default,,0,0,0,,{\an8}Vụ hứa hẹn, tôi còn chưa đồng ý…
Dialogue: 0,0:23:41.92,0:23:42.88,Default,,0,0,0,,{\an8}{\i1}Đi chết đi.{\i0}
Dialogue: 0,0:23:45.47,0:23:49.14,Default,,0,0,0,,- Talia, sẵn sàng bắt đầu chưa?\N- Rồi.
Dialogue: 0,0:24:03.44,0:24:05.69,Default,,0,0,0,,Này! Tránh ra!
Dialogue: 0,0:24:05.78,0:24:07.24,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:24:07.32,0:24:09.49,Default,,0,0,0,,Thấy gã này lén lút bên ngoài.
Dialogue: 0,0:24:10.45,0:24:11.62,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:24:15.12,0:24:16.46,Default,,0,0,0,,Ai vậy?
Dialogue: 0,0:24:16.54,0:24:17.83,Default,,0,0,0,,Biết chết liền.
Dialogue: 0,0:25:47.42,0:25:50.42,Default,,0,0,0,,Biên dịch: Khanh Tran
