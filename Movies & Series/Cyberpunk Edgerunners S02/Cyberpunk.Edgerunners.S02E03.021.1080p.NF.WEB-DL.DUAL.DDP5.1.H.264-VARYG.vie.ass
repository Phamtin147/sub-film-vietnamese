Dialogue: 0,0:00:10.51,0:00:12.93,Default,,0,0,0,,- D uống rượu à?\N- Khoan! Dính bố rồi này!
Dialogue: 0,0:00:13.01,0:00:14.18,Default,,0,0,0,,Ôi.
Dialogue: 0,0:00:14.81,0:00:16.85,Default,,0,0,0,,Kể tôi nghe về tộc của anh đi.
Dialogue: 0,0:00:17.43,0:00:20.31,Default,,0,0,0,,Của tôi à?\NChúng tôi là một phần của Nước Rắn.
Dialogue: 0,0:00:20.40,0:00:21.32,Default,,0,0,0,,Rắn ư?
Dialogue: 0,0:00:21.40,0:00:24.90,Default,,0,0,0,,Nước Rắn là một nơi tốt đẹp.
Dialogue: 0,0:00:24.98,0:00:29.07,Default,,0,0,0,,Không phải ai cũng thích tôi,\Nnhưng tôi có trưởng tộc chống lưng.
Dialogue: 0,0:00:29.15,0:00:30.86,Default,,0,0,0,,Anh có bạn không?
Dialogue: 0,0:00:30.95,0:00:32.37,Default,,0,0,0,,Dĩ nhiên là có.
Dialogue: 0,0:00:32.45,0:00:37.37,Default,,0,0,0,,Kenzo, José, Renée, Omi, Marvette.
Dialogue: 0,0:00:38.04,0:00:40.04,Default,,0,0,0,,À, còn Renji nữa.
Dialogue: 0,0:00:40.62,0:00:43.92,Default,,0,0,0,,Renji tầm tuổi cậu, Roman.
Dialogue: 0,0:00:50.47,0:00:51.89,Default,,0,0,0,,Tôi vẫn mơ thấy họ.
Dialogue: 0,0:00:51.97,0:00:54.85,Default,,0,0,0,,- Mơ sao?\N- Lúc nào cũng thấy họ.
Dialogue: 0,0:00:55.64,0:00:56.48,Default,,0,0,0,,Trong mơ.
Dialogue: 0,0:01:02.31,0:01:05.48,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:01:05.57,0:01:08.66,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:02:31.03,0:02:32.78,Default,,0,0,0,,Ta có khách.
Dialogue: 0,0:02:33.28,0:02:35.20,Default,,0,0,0,,Ai vậy?
Dialogue: 0,0:02:35.28,0:02:36.57,Default,,0,0,0,,Biết chết liền.
Dialogue: 0,0:02:36.66,0:02:37.74,Default,,0,0,0,,Mày biết không?
Dialogue: 0,0:02:37.82,0:02:38.90,Default,,0,0,0,,Méo biết.
Dialogue: 0,0:02:38.99,0:02:42.08,Default,,0,0,0,,Này, đống sắt vụn. Lão làm quái gì ở đây?
Dialogue: 0,0:02:42.16,0:02:43.83,Default,,0,0,0,,Không nói làm sao biết được.
Dialogue: 0,0:02:43.91,0:02:45.70,Default,,0,0,0,,Talia, cô biết gã này không?
Dialogue: 0,0:02:45.79,0:02:48.00,Default,,0,0,0,,- Có nghe không đấy?\N- Gã này là sao?
Dialogue: 0,0:02:48.92,0:02:53.47,Default,,0,0,0,,Đã nói lần này\Nkhông bị trở ngại nữa mà. Đúng chứ?
Dialogue: 0,0:02:53.55,0:02:55.47,Default,,0,0,0,,Tôi không biết hắn.
Dialogue: 0,0:02:55.55,0:02:56.47,Default,,0,0,0,,Talia!
Dialogue: 0,0:02:56.55,0:02:57.84,Default,,0,0,0,,Đợi đã, lão già!
Dialogue: 0,0:03:01.51,0:03:02.72,Default,,0,0,0,,Này.
Dialogue: 0,0:03:03.35,0:03:04.19,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:03:08.06,0:03:09.06,Default,,0,0,0,,Không.
Dialogue: 0,0:03:09.56,0:03:11.06,Default,,0,0,0,,Chưa xong đâu!
Dialogue: 0,0:03:11.57,0:03:13.95,Default,,0,0,0,,Cố lên nào, lão già.
Dialogue: 0,0:03:14.03,0:03:17.87,Default,,0,0,0,,Lão nghĩ mình sẽ làm được gì\Nvới đống siêu thiết bị rẻ tiền đó…
Dialogue: 0,0:03:17.95,0:03:18.95,Default,,0,0,0,,Này, vũ khí kìa!
Dialogue: 0,0:03:22.95,0:03:23.87,Default,,0,0,0,,Nguy hiểm quá…
Dialogue: 0,0:03:23.95,0:03:26.66,Default,,0,0,0,,Thứ nguy hiểm duy nhất ở đây\Nlà mày, đồ ngu!
Dialogue: 0,0:03:30.50,0:03:32.54,Default,,0,0,0,,- Này, quét hắn đi.\N- Rõ.
Dialogue: 0,0:03:32.63,0:03:35.17,Default,,0,0,0,,Lần trước mày cũng giở trò này!
Dialogue: 0,0:03:35.26,0:03:36.93,Default,,0,0,0,,Thằng ngu này yếu xìu.
Dialogue: 0,0:03:37.01,0:03:39.14,Default,,0,0,0,,Không thành vấn đề, nó có hàng!
Dialogue: 0,0:03:39.22,0:03:41.47,Default,,0,0,0,,Chết tiệt. Talia.
Dialogue: 0,0:03:42.39,0:03:44.02,Default,,0,0,0,,Mày nữa! Cái quái gì vậy?
Dialogue: 0,0:03:44.10,0:03:47.19,Default,,0,0,0,,Đứa yếu nhớt như mày\Nsao lại có khẩu súng đó? Talia!
Dialogue: 0,0:03:47.27,0:03:50.65,Default,,0,0,0,,Hắn đến đây vì cô, đúng không?
Dialogue: 0,0:03:52.44,0:03:55.65,Default,,0,0,0,,Có lẽ tên này\Nlà siêu cuồng nhân bị lỗi rồi.
Dialogue: 0,0:03:55.74,0:03:57.33,Default,,0,0,0,,- Gì chứ?\N- Mày đùa à?
Dialogue: 0,0:03:57.40,0:04:00.99,Default,,0,0,0,,Vậy, lão từng là {\i1}cyberpunk{\i0} à?
Dialogue: 0,0:04:01.07,0:04:01.90,Default,,0,0,0,,Thú vị đấy.
Dialogue: 0,0:04:02.41,0:04:04.45,Default,,0,0,0,,Này. Đè hắn xuống.
Dialogue: 0,0:04:04.95,0:04:08.08,Default,,0,0,0,,Này! Các người định làm gì? Thả tôi ra!
Dialogue: 0,0:04:08.16,0:04:10.58,Default,,0,0,0,,Thư giãn đi. Đâu có gì to tát.
Dialogue: 0,0:04:11.25,0:04:14.59,Default,,0,0,0,,Chỉ khởi động lại\Nđống thiết bị của lão thôi.
Dialogue: 0,0:04:15.17,0:04:18.88,Default,,0,0,0,,Được chứng kiến khoảnh khắc\Nmột siêu cuồng nhân ra đời…
Dialogue: 0,0:04:18.97,0:04:21.47,Default,,0,0,0,,Cả bọn tao cũng không được thấy hằng ngày.
Dialogue: 0,0:04:25.01,0:04:27.47,Default,,0,0,0,,Này, còn tôi thì sao?
Dialogue: 0,0:04:27.56,0:04:30.40,Default,,0,0,0,,Cô thì sao? Này, đè mạnh nữa lên!
Dialogue: 0,0:04:30.48,0:04:33.69,Default,,0,0,0,,Lẽ ra hôm nay là ca mổ của tôi mà.
Dialogue: 0,0:04:34.23,0:04:35.44,Default,,0,0,0,,Này!
Dialogue: 0,0:04:39.70,0:04:41.16,Default,,0,0,0,,Con khốn hợm hĩnh.
Dialogue: 0,0:04:42.28,0:04:44.82,Default,,0,0,0,,Đã nói bọn này\Nchán mấy trò mèo của mày rồi.
Dialogue: 0,0:04:44.91,0:04:47.29,Default,,0,0,0,,Đầu tiên là quân đội, giờ đến gã hề này!
Dialogue: 0,0:04:47.37,0:04:50.46,Default,,0,0,0,,Lúc nào cũng là người của mày giật dây!
Dialogue: 0,0:04:51.12,0:04:52.29,Default,,0,0,0,,Bọn mày đã bỏ chạy.
Dialogue: 0,0:04:53.08,0:04:53.91,Default,,0,0,0,,Sao?
Dialogue: 0,0:04:54.00,0:04:56.09,Default,,0,0,0,,Bọn mày đã chạy khỏi Kang Tao.
Dialogue: 0,0:04:56.17,0:04:57.80,Default,,0,0,0,,Mày nói cái quái gì hả?
Dialogue: 0,0:04:57.88,0:05:00.30,Default,,0,0,0,,Tao thì không!
Dialogue: 0,0:05:03.47,0:05:07.81,Default,,0,0,0,,Tao không để một con tiểu thư\Nlàm nhục đâu!
Dialogue: 0,0:05:14.81,0:05:16.10,Default,,0,0,0,,Mau bắn nó đi!
Dialogue: 0,0:05:16.19,0:05:18.48,Default,,0,0,0,,Không được. Gần quá. Ta dính đạn mất.
Dialogue: 0,0:05:18.57,0:05:20.95,Default,,0,0,0,,Này, làm gì với hắn đây?
Dialogue: 0,0:05:34.46,0:05:38.01,Default,,0,0,0,,Con khốn ngu si! Chết đi!
Dialogue: 0,0:05:40.38,0:05:41.34,Default,,0,0,0,,Đứng yên!
Dialogue: 0,0:05:42.30,0:05:45.85,Default,,0,0,0,,{\an8}Thấy rồi chứ?\NTôi nhắm bắn chưa lụt nghề đâu.
Dialogue: 0,0:05:46.60,0:05:49.48,Default,,0,0,0,,Muốn sống thì tránh xa Talia ra!
Dialogue: 0,0:05:51.73,0:05:52.77,Default,,0,0,0,,{\an8}Mau lên!
Dialogue: 0,0:05:57.11,0:05:59.61,Default,,0,0,0,,{\an8}Dừng lại đi, Talia. Cháu làm gì vậy?
Dialogue: 0,0:05:59.69,0:06:01.36,Default,,0,0,0,,{\an8}Mẹ kiếp, con điên!
Dialogue: 0,0:06:02.07,0:06:06.41,Default,,0,0,0,,{\an8}- Bọn mày đi chết đi! Đồ phản bội!\N- Cháu được cứu rồi. An tâm đi!
Dialogue: 0,0:06:07.12,0:06:08.00,Default,,0,0,0,,Talia!
Dialogue: 0,0:06:09.70,0:06:14.25,Default,,0,0,0,,"Được cứu"? Ông nghĩ ông đã cứu tôi ư?
Dialogue: 0,0:06:14.33,0:06:15.87,Default,,0,0,0,,Đây là lỗi của ông!
Dialogue: 0,0:06:15.96,0:06:17.21,Default,,0,0,0,,Thật đáng tiếc.
Dialogue: 0,0:06:17.71,0:06:19.88,Default,,0,0,0,,Chấp nhận đi, Talia.
Dialogue: 0,0:06:19.96,0:06:21.88,Default,,0,0,0,,Ta đưa cháu về với Avida thôi.
Dialogue: 0,0:06:21.96,0:06:25.34,Default,,0,0,0,,Cái quái gì vậy?
Dialogue: 0,0:06:25.89,0:06:26.72,Default,,0,0,0,,Talia?
Dialogue: 0,0:06:30.72,0:06:34.14,Default,,0,0,0,,Lúc nào cũng vậy. Các người luôn làm thế.
Dialogue: 0,0:06:34.23,0:06:36.57,Default,,0,0,0,,Các người lấy đi mọi thứ của tôi.
Dialogue: 0,0:06:36.65,0:06:40.40,Default,,0,0,0,,Vui lắm à? Tôi chẳng còn gì cả.
Dialogue: 0,0:06:40.48,0:06:41.61,Default,,0,0,0,,Chẳng còn gì!
Dialogue: 0,0:06:42.11,0:06:45.11,Default,,0,0,0,,{\an8}- Này, cháu ổn chứ?\N- Tránh xa tôi ra!
Dialogue: 0,0:06:49.37,0:06:50.54,Default,,0,0,0,,Talia? Talia!
Dialogue: 0,0:06:54.96,0:06:55.92,Default,,0,0,0,,Con chip đâu?
Dialogue: 0,0:06:56.42,0:06:57.84,Default,,0,0,0,,Tôi rất xin lỗi.
Dialogue: 0,0:06:58.96,0:07:02.76,Default,,0,0,0,,Phe đối địch\Nđang truy cứu trách nhiệm của tôi.
Dialogue: 0,0:07:03.26,0:07:07.18,Default,,0,0,0,,{\an8}Định lấy con chip để họ im mồm,\Nnhưng lại hoàn toàn phản tác dụng.
Dialogue: 0,0:07:07.68,0:07:09.85,Default,,0,0,0,,{\an8}Lẽ ra ta nên có phương án dự phòng.
Dialogue: 0,0:07:10.35,0:07:14.02,Default,,0,0,0,,{\an8}Tôi còn giao cả thông tin bảo mật.\NKhông ngờ họ lại thất bại.
Dialogue: 0,0:07:15.18,0:07:17.39,Default,,0,0,0,,{\an8}Lính đánh thuê là thế đấy.
Dialogue: 0,0:07:18.44,0:07:22.57,Default,,0,0,0,,{\an8}Kết quả của việc đôi lúc nghe lời vợ đấy.\NBuồn cười nhỉ?
Dialogue: 0,0:07:23.65,0:07:24.65,Default,,0,0,0,,Không đâu.
Dialogue: 0,0:07:25.19,0:07:27.19,Default,,0,0,0,,Buồn cười mà, anh cứ cười đi.
Dialogue: 0,0:07:27.70,0:07:31.20,Default,,0,0,0,,Hình như thủ lĩnh nhóm đó\Nlà người yêu cũ của cô ấy.
Dialogue: 0,0:07:31.83,0:07:34.25,Default,,0,0,0,,Nghe như anh ta xuất viện rồi nhỉ?
Dialogue: 0,0:07:35.16,0:07:38.83,Default,,0,0,0,,Quan trọng hơn là con chip.\NAnh biết được gì rồi?
Dialogue: 0,0:07:38.92,0:07:43.09,Default,,0,0,0,,Chúng tôi không tin MaxTac\Nhay cảnh sát nói chung đã có được nó.
Dialogue: 0,0:07:43.17,0:07:46.34,Default,,0,0,0,,Cũng không có dấu vết chiếm đoạt nội bộ.
Dialogue: 0,0:07:46.42,0:07:50.42,Default,,0,0,0,,- Arasaka cũng không thu hồi nó à?\N- Đã xác nhận là thế.
Dialogue: 0,0:07:50.93,0:07:54.35,Default,,0,0,0,,Có lý do để cho rằng\Nmột bên thứ ba đã lấy nó.
Dialogue: 0,0:07:55.48,0:07:59.11,Default,,0,0,0,,Nghĩa là họ đã đến trước cảnh sát.
Dialogue: 0,0:08:03.94,0:08:08.36,Default,,0,0,0,,{\an8}Rất ít người có thể làm thế vào lúc đó.
Dialogue: 0,0:08:08.95,0:08:10.29,Default,,0,0,0,,Là ai đây?
Dialogue: 0,0:08:10.82,0:08:12.49,Default,,0,0,0,,{\i1}Khốn nạn! Hộp nào y hộp nấy!{\i0}
Dialogue: 0,0:08:12.58,0:08:14.21,Default,,0,0,0,,{\i1}- Có người đến.\N- Đừng nóng, Miguel.{\i0}
Dialogue: 0,0:08:14.29,0:08:17.63,Default,,0,0,0,,{\i1}Kyoko… Chúng đang… cố trộm…{\i0}
Dialogue: 0,0:08:18.29,0:08:19.12,Default,,0,0,0,,{\i1}Kyoko!{\i0}
Dialogue: 0,0:08:21.17,0:08:22.25,Default,,0,0,0,,Capri?
Dialogue: 0,0:08:25.34,0:08:26.84,Default,,0,0,0,,Không đời nào.
Dialogue: 0,0:08:28.80,0:08:31.76,Default,,0,0,0,,Hả? Sao camera ngỏm rồi?
Dialogue: 0,0:08:31.84,0:08:33.26,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:08:36.89,0:08:38.60,Default,,0,0,0,,Chúng nhắm vào Capri ư?
Dialogue: 0,0:08:38.68,0:08:42.23,Default,,0,0,0,,Chết tiệt! Đã bảo cập nhật bảo mật rồi mà.
Dialogue: 0,0:08:43.27,0:08:45.65,Default,,0,0,0,,Tóm được rồi! Ta là thiên tài!
Dialogue: 0,0:08:46.32,0:08:48.66,Default,,0,0,0,,Đồ ngốc! Bảo vệ ngốc nghếch!
Dialogue: 0,0:08:48.74,0:08:51.58,Default,,0,0,0,,{\i1}Vậy sẽ có phụ phí! Mọi người tự lo đi…{\i0}
Dialogue: 0,0:08:52.07,0:08:53.07,Default,,0,0,0,,{\i1}Đợi đã.{\i0}
Dialogue: 0,0:08:53.78,0:08:55.49,Default,,0,0,0,,- Chết đi!\N{\i1}- Khỉ gió, rút…{\i0}
Dialogue: 0,0:08:55.58,0:08:57.25,Default,,0,0,0,,{\i1}King! Quét đi!{\i0}
Dialogue: 0,0:08:58.00,0:08:58.96,Default,,0,0,0,,{\i1}Miguel!{\i0}
Dialogue: 0,0:09:10.05,0:09:12.01,Default,,0,0,0,,Chết tiệt! Chúng thoát mất!
Dialogue: 0,0:09:13.14,0:09:14.35,Default,,0,0,0,,Thế này thì sao?
Dialogue: 0,0:09:14.85,0:09:16.06,Default,,0,0,0,,{\an8}Lên đi!
Dialogue: 0,0:09:17.06,0:09:18.10,Default,,0,0,0,,Tuyệt!
Dialogue: 0,0:09:18.18,0:09:20.56,Default,,0,0,0,,Số mình đỏ quá. Đỏ quá!
Dialogue: 0,0:09:22.35,0:09:24.19,Default,,0,0,0,,{\i1}Miguel, vali…{\i0}
Dialogue: 0,0:09:24.27,0:09:26.23,Default,,0,0,0,,{\i1}Kệ nó đi! Vụ này thua rồi.{\i0}
Dialogue: 0,0:09:30.32,0:09:32.66,Default,,0,0,0,,{\i1}Ngẩn ngơ gì đấy! Từ phòng thí nghiệm à?{\i0}
Dialogue: 0,0:09:33.32,0:09:34.91,Default,,0,0,0,,{\i1}Mau chạy đi!{\i0}
Dialogue: 0,0:09:35.41,0:09:36.24,Default,,0,0,0,,{\i1}Mau lên!{\i0}
Dialogue: 0,0:09:44.67,0:09:47.84,Default,,0,0,0,,Làm được rồi! May thật đấy.
Dialogue: 0,0:09:48.38,0:09:49.51,Default,,0,0,0,,Capri!
Dialogue: 0,0:09:49.59,0:09:53.14,Default,,0,0,0,,{\an8}Cô không thuộc về Arasaka nữa.\NCô không phải biến mất.
Dialogue: 0,0:09:53.72,0:09:57.39,Default,,0,0,0,,{\an8}Và cô… là của ta!
Dialogue: 0,0:10:05.86,0:10:08.28,Default,,0,0,0,,Khốn kiếp! Dám xỏ xiên ta à?
Dialogue: 0,0:10:08.36,0:10:10.40,Default,,0,0,0,,Capri không có giá trị ư? Chết đi!
Dialogue: 0,0:10:10.48,0:10:12.90,Default,,0,0,0,,{\i1}Tất cả các ngươi, chết đi! Từng tên một!{\i0}
Dialogue: 0,0:10:12.99,0:10:15.03,Default,,0,0,0,,{\an8}Đáng đời! Cô ấy thuộc về ta!
Dialogue: 0,0:10:15.11,0:10:17.78,Default,,0,0,0,,{\i1}Capri là của ta!{\i0}
Dialogue: 0,0:10:18.87,0:10:21.41,Default,,0,0,0,,Ồ, tốt lắm. Cậu quay lại rồi.
Dialogue: 0,0:10:21.91,0:10:24.54,Default,,0,0,0,,Nhưng lại có một cái đuôi… Ái chà.
Dialogue: 0,0:10:25.04,0:10:29.04,Default,,0,0,0,,Cậu có phải giải độc đắc của bọn ta không?\NTa hy vọng là thế.
Dialogue: 0,0:10:30.67,0:10:32.09,Default,,0,0,0,,Ta vào từ đâu đây?
Dialogue: 0,0:10:34.34,0:10:35.34,Default,,0,0,0,,Này, D?
Dialogue: 0,0:10:36.05,0:10:37.55,Default,,0,0,0,,Tôi sẽ vào bằng cửa đó.
Dialogue: 0,0:10:38.14,0:10:39.31,Default,,0,0,0,,Để trả một món nợ.
Dialogue: 0,0:11:14.42,0:11:16.05,Default,,0,0,0,,{\an8}Tại anh hết đấy, D!
Dialogue: 0,0:11:16.13,0:11:20.34,Default,,0,0,0,,{\an8}Ta cứ đi loanh quanh trong tòa nhà này\Nrồi quay về chỗ cũ.
Dialogue: 0,0:11:21.01,0:11:23.39,Default,,0,0,0,,{\an8}Ta nhất định sẽ chết ở đây thôi.
Dialogue: 0,0:11:23.47,0:11:24.47,Default,,0,0,0,,{\an8}D, đồ ngốc!
Dialogue: 0,0:11:25.35,0:11:26.27,Default,,0,0,0,,D, anh…
Dialogue: 0,0:11:30.15,0:11:31.24,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:31.32,0:11:33.32,Default,,0,0,0,,{\i1}Đợi đã, D!{\i0}
Dialogue: 0,0:11:33.82,0:11:35.49,Default,,0,0,0,,{\i1}Hắn biết đường ư?{\i0}
Dialogue: 0,0:11:35.57,0:11:37.61,Default,,0,0,0,,Nhưng sao tự dưng lại thế?
Dialogue: 0,0:11:42.20,0:11:43.62,Default,,0,0,0,,{\i1}Đã bảo đợi tôi với!{\i0}
Dialogue: 0,0:11:56.63,0:11:58.51,Default,,0,0,0,,Ọe! Mùi gì thế?
Dialogue: 0,0:11:58.59,0:11:59.97,Default,,0,0,0,,Mùi thối rữa.
Dialogue: 0,0:12:00.05,0:12:01.26,Default,,0,0,0,,"Thối rữa"?
Dialogue: 0,0:12:01.85,0:12:03.52,Default,,0,0,0,,Mùi xác người thối rữa.
Dialogue: 0,0:12:09.60,0:12:12.85,Default,,0,0,0,,Sao? Lần đầu thấy xác chết à?
Dialogue: 0,0:12:13.36,0:12:15.03,Default,,0,0,0,,Không phải thế, chỉ là…
Dialogue: 0,0:12:19.36,0:12:21.24,Default,,0,0,0,,{\an8}Ông ấy cũng chết rồi à?
Dialogue: 0,0:12:21.32,0:12:23.41,Default,,0,0,0,,{\an8}Tên này còn sống.
Dialogue: 0,0:12:26.41,0:12:28.66,Default,,0,0,0,,Đó là con chip à?
Dialogue: 0,0:12:35.67,0:12:36.67,Default,,0,0,0,,Là mi sao?
Dialogue: 0,0:12:37.67,0:12:38.55,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:13:18.46,0:13:20.13,Default,,0,0,0,,D?
Dialogue: 0,0:13:22.89,0:13:23.93,Default,,0,0,0,,Một đứa trẻ.
Dialogue: 0,0:13:26.06,0:13:27.98,Default,,0,0,0,,Thành công!
Dialogue: 0,0:13:30.85,0:13:33.48,Default,,0,0,0,,Hắn còn sống!
Dialogue: 0,0:13:35.90,0:13:36.73,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:46.74,0:13:47.70,Default,,0,0,0,,D?
Dialogue: 0,0:13:51.08,0:13:53.50,Default,,0,0,0,,Hả? Sao cửa lại mở?
Dialogue: 0,0:13:55.50,0:13:56.84,Default,,0,0,0,,Đợi đã, D!
Dialogue: 0,0:13:57.34,0:13:58.42,Default,,0,0,0,,Khốn kiếp!
Dialogue: 0,0:13:58.50,0:14:01.04,Default,,0,0,0,,Khốn kiếp!
Dialogue: 0,0:14:01.55,0:14:05.18,Default,,0,0,0,,Capri! Cô cũng chạy trốn ta sao?
Dialogue: 0,0:14:05.26,0:14:07.05,Default,,0,0,0,,Ta không cho phép!
Dialogue: 0,0:14:11.06,0:14:11.98,Default,,0,0,0,,Anh đây rồi!
Dialogue: 0,0:14:12.48,0:14:13.31,Default,,0,0,0,,Đợi tôi với!
Dialogue: 0,0:14:16.48,0:14:17.31,Default,,0,0,0,,Phiền quá đấy.
Dialogue: 0,0:14:18.36,0:14:19.40,Default,,0,0,0,,{\i1}D!{\i0}
Dialogue: 0,0:14:20.28,0:14:21.28,Default,,0,0,0,,{\i1}Chết tiệt!{\i0}
Dialogue: 0,0:14:38.84,0:14:39.76,Default,,0,0,0,,Này.
Dialogue: 0,0:14:40.63,0:14:42.55,Default,,0,0,0,,Trả cơ thể lại cho tôi.
Dialogue: 0,0:14:43.30,0:14:44.26,Default,,0,0,0,,Chà.
Dialogue: 0,0:14:44.76,0:14:45.60,Default,,0,0,0,,Ồn ào quá.
Dialogue: 0,0:14:47.68,0:14:49.47,Default,,0,0,0,,Không ngờ anh còn ở đây đấy.
Dialogue: 0,0:14:49.56,0:14:50.98,Default,,0,0,0,,{\an8}Trả lại đây!
Dialogue: 0,0:14:59.32,0:15:00.49,Default,,0,0,0,,Lại đây!
Dialogue: 0,0:15:01.98,0:15:03.77,Default,,0,0,0,,Tạm biệt anh bạn.
Dialogue: 0,0:15:08.99,0:15:10.24,Default,,0,0,0,,D?
Dialogue: 0,0:15:12.54,0:15:14.67,Default,,0,0,0,,Chà! Lâu lắm rồi!
Dialogue: 0,0:15:23.30,0:15:24.34,Default,,0,0,0,,Gớm quá.
Dialogue: 0,0:15:25.01,0:15:26.89,Default,,0,0,0,,{\an8}Thôi làm mấy việc tùy tiện đi!
Dialogue: 0,0:15:26.97,0:15:29.39,Default,,0,0,0,,Hả? Anh làm thật này.
Dialogue: 0,0:15:29.47,0:15:33.27,Default,,0,0,0,,Sao chứ? Lạ thật. Sao anh chưa biến mất?
Dialogue: 0,0:15:33.35,0:15:35.39,Default,,0,0,0,,Đừng có giỡn mặt, đồ khốn.
Dialogue: 0,0:15:36.27,0:15:37.90,Default,,0,0,0,,Sao? Khoan, anh làm gì vậy?
Dialogue: 0,0:15:45.57,0:15:46.86,Default,,0,0,0,,Không thể nào!
Dialogue: 0,0:15:46.95,0:15:50.79,Default,,0,0,0,,Hả? Gì chứ? Anh là thứ gì vậy? Tuyệt quá!
Dialogue: 0,0:15:50.87,0:15:53.50,Default,,0,0,0,,Không lẽ anh cũng làm được chuyện này?
Dialogue: 0,0:15:56.79,0:15:57.92,Default,,0,0,0,,Hyah!
Dialogue: 0,0:16:10.59,0:16:12.09,Default,,0,0,0,,Là cô làm sao?
Dialogue: 0,0:16:12.18,0:16:14.27,Default,,0,0,0,,Phải! Giờ đến lượt anh.
Dialogue: 0,0:16:14.35,0:16:15.43,Default,,0,0,0,,Sao?
Dialogue: 0,0:16:19.06,0:16:19.98,Default,,0,0,0,,Ối!
Dialogue: 0,0:16:26.49,0:16:28.83,Default,,0,0,0,,Đồ ngu, đã bảo anh nhìn đường cơ mà!
Dialogue: 0,0:16:28.90,0:16:30.03,Default,,0,0,0,,Không phải tại tôi.
Dialogue: 0,0:16:30.11,0:16:33.61,Default,,0,0,0,,Gã lập dị đó chiếu chiếu gì đó,\Nrồi vô lăng đơ luôn!
Dialogue: 0,0:16:33.70,0:16:34.74,Default,,0,0,0,,Là hắn!
Dialogue: 0,0:16:34.83,0:16:36.79,Default,,0,0,0,,Chắc chắn hắn đã hack xe của tôi!
Dialogue: 0,0:16:36.87,0:16:38.71,Default,,0,0,0,,Chuyện đó thì liên quan gì?
Dialogue: 0,0:16:38.79,0:16:40.75,Default,,0,0,0,,Dĩ nhiên là có!
Dialogue: 0,0:16:40.83,0:16:42.29,Default,,0,0,0,,- Không có.\N- Có!
Dialogue: 0,0:16:42.38,0:16:46.26,Default,,0,0,0,,Này anh trai. Ngưng cãi nhau\Nvà giúp bọn tôi ra ngoài đi.
Dialogue: 0,0:16:46.34,0:16:47.17,Default,,0,0,0,,Im đi!
Dialogue: 0,0:16:48.09,0:16:50.13,Default,,0,0,0,,Sao anh thích bóp cò thế?
Dialogue: 0,0:16:50.22,0:16:52.89,Default,,0,0,0,,Dù sao thì, chính hắn.\NBiến tôi thành đồ ngu.
Dialogue: 0,0:16:53.89,0:16:55.89,Default,,0,0,0,,Tôi biết là anh làm được mà.
Dialogue: 0,0:16:55.97,0:16:59.39,Default,,0,0,0,,"Làm được" cái con khỉ!\NCô điều khiển cơ thể tôi.
Dialogue: 0,0:16:59.48,0:17:01.44,Default,,0,0,0,,Hả? Không có, đó là…
Dialogue: 0,0:17:01.52,0:17:03.65,Default,,0,0,0,,Xuống đây! Ta giải quyết chuyện này!
Dialogue: 0,0:17:04.15,0:17:06.65,Default,,0,0,0,,Xin lỗi, nhưng tôi mượn anh một lát nhé.
Dialogue: 0,0:17:07.53,0:17:08.36,Default,,0,0,0,,Hả?
Dialogue: 0,0:17:09.28,0:17:11.57,Default,,0,0,0,,- D!\N- Roman?
Dialogue: 0,0:17:14.24,0:17:16.12,Default,,0,0,0,,- Đau!\N- Anh bị cái quái gì vậy?
Dialogue: 0,0:17:16.20,0:17:19.54,Default,,0,0,0,,Thêm một người nữa! Anh lo vụ này đi.
Dialogue: 0,0:17:19.62,0:17:21.75,Default,,0,0,0,,- Sao?\N- Ổn mà.
Dialogue: 0,0:17:21.83,0:17:24.79,Default,,0,0,0,,Dù sao thì, người khiến họ bị tông xe…
Dialogue: 0,0:17:24.88,0:17:27.88,Default,,0,0,0,,không phải tôi, mà là anh.
Dialogue: 0,0:17:27.96,0:17:29.46,Default,,0,0,0,,- Đau quá!\N- Đủ rồi đấy!
Dialogue: 0,0:17:34.05,0:17:34.88,Default,,0,0,0,,Đau quá.
Dialogue: 0,0:17:40.27,0:17:43.07,Default,,0,0,0,,Này! Chết đi, thằng khốn!
Dialogue: 0,0:17:47.86,0:17:50.07,Default,,0,0,0,,Hoan hô, anh làm được rồi!
Dialogue: 0,0:17:50.15,0:17:53.57,Default,,0,0,0,,Anh giỏi thật đấy! Ta chơi tiếp nào!
Dialogue: 0,0:17:54.24,0:17:55.33,Default,,0,0,0,,Chơi à?
Dialogue: 0,0:17:55.41,0:17:57.20,Default,,0,0,0,,Thế này thì sao?
Dialogue: 0,0:18:33.74,0:18:34.87,Default,,0,0,0,,Chuyện này…
Dialogue: 0,0:18:35.61,0:18:36.95,Default,,0,0,0,,Là anh làm sao, D?
Dialogue: 0,0:18:38.70,0:18:40.12,Default,,0,0,0,,Anh ấy đang cười ư?
Dialogue: 0,0:18:46.46,0:18:49.96,Default,,0,0,0,,- Gì vậy?\N- Mấy tên lúc nãy quay lại rồi.
Dialogue: 0,0:18:50.05,0:18:52.97,Default,,0,0,0,,Hắn kìa! Thằng ngu vẫn ở đó!
Dialogue: 0,0:18:56.14,0:18:56.97,Default,,0,0,0,,D!
Dialogue: 0,0:18:57.55,0:18:59.22,Default,,0,0,0,,Tôi bắt đầu thấy vui rồi.
Dialogue: 0,0:18:59.30,0:19:00.47,Default,,0,0,0,,Tông xe nữa nhé?
Dialogue: 0,0:19:00.56,0:19:02.73,Default,,0,0,0,,"Tông xe"? Sao cơ?
Dialogue: 0,0:19:03.31,0:19:05.69,Default,,0,0,0,,Anh mà chết thì tôi sẽ gặp rắc rối.
Dialogue: 0,0:19:05.77,0:19:08.02,Default,,0,0,0,,Chết ư? Cô nói gì vậy?
Dialogue: 0,0:19:08.11,0:19:12.49,Default,,0,0,0,,- Cho họ tông xe rồi chạy thì chán lắm.\N- Chán ư?
Dialogue: 0,0:19:12.57,0:19:15.11,Default,,0,0,0,,Đúng vậy. Chán lắm.
Dialogue: 0,0:19:15.20,0:19:20.50,Default,,0,0,0,,Họ đã mất công quay lại vì ta.\NVậy thì cho họ vui vẻ đi.
Dialogue: 0,0:19:25.87,0:19:26.87,Default,,0,0,0,,Tỉnh rồi à?
Dialogue: 0,0:19:28.33,0:19:31.54,Default,,0,0,0,,Tôi đã liên lạc với Avida.\NCô ấy sắp đến rồi.
Dialogue: 0,0:19:32.17,0:19:33.21,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:19:33.30,0:19:34.63,Default,,0,0,0,,Cháu bất tỉnh.
Dialogue: 0,0:19:34.72,0:19:36.89,Default,,0,0,0,,Tôi đã đưa cháu đến đây.
Dialogue: 0,0:19:37.47,0:19:38.89,Default,,0,0,0,,Này, đừng cố quá.
Dialogue: 0,0:19:42.97,0:19:47.39,Default,,0,0,0,,- Tôi… đang ở đâu?\N- Phòng khám Ripperdoc. Của một người bạn.
Dialogue: 0,0:19:47.48,0:19:49.40,Default,,0,0,0,,Chỗ này gần hơn.
Dialogue: 0,0:19:50.02,0:19:52.94,Default,,0,0,0,,Anh ta đi vắng rồi,\Nnhưng tay nghề chắc chắn giỏi.
Dialogue: 0,0:19:53.44,0:19:54.65,Default,,0,0,0,,Cháu có thể yên tâm.
Dialogue: 0,0:19:56.74,0:19:57.78,Default,,0,0,0,,{\i1}Tôi về đây.{\i0}
Dialogue: 0,0:19:58.28,0:20:00.53,Default,,0,0,0,,{\i1}Về ư? Nhưng Avida sắp đến rồi…{\i0}
Dialogue: 0,0:20:00.62,0:20:03.62,Default,,0,0,0,,Tôi không muốn quay lại đó.
Dialogue: 0,0:20:04.91,0:20:07.29,Default,,0,0,0,,{\i1}Đã bảo mà. Cháu đứng dậy được không?{\i0}
Dialogue: 0,0:20:19.38,0:20:20.97,Default,,0,0,0,,Đồ ngốc!
Dialogue: 0,0:20:26.89,0:20:27.85,Default,,0,0,0,,Đừng động vào tôi!
Dialogue: 0,0:20:43.83,0:20:45.62,Default,,0,0,0,,{\i1}Đừng làm như đã cứu tôi!{\i0}
Dialogue: 0,0:20:46.12,0:20:48.04,Default,,0,0,0,,{\i1}Ông nghĩ ông…{\i0}
Dialogue: 0,0:20:48.12,0:20:52.79,Default,,0,0,0,,{\an8}Dù đã hóa siêu cuồng nhân…\Nsao ông có thể sống tiếp trong cơ thể đó?
Dialogue: 0,0:20:53.29,0:20:54.29,Default,,0,0,0,,{\an8}Tôi chịu thua!
Dialogue: 0,0:20:55.88,0:20:56.92,Default,,0,0,0,,{\an8}{\i1}Talia.{\i0}
Dialogue: 0,0:20:57.01,0:20:59.30,Default,,0,0,0,,{\i1}Đừng gọi tên tôi thân thiết thế!{\i0}
Dialogue: 0,0:20:59.80,0:21:02.76,Default,,0,0,0,,Tôi khác ông!
Dialogue: 0,0:21:02.84,0:21:03.68,Default,,0,0,0,,Tôi không…
Dialogue: 0,0:21:12.02,0:21:12.90,Default,,0,0,0,,Gì vậy?
Dialogue: 0,0:21:20.07,0:21:21.53,Default,,0,0,0,,Này Talia. Đợi đã.
Dialogue: 0,0:21:36.75,0:21:37.58,Default,,0,0,0,,Talia!
Dialogue: 0,0:21:37.67,0:21:40.55,Default,,0,0,0,,Con ổn chứ? Có bị thương không?
Dialogue: 0,0:21:40.63,0:21:43.26,Default,,0,0,0,,Ở đây ổn rồi. Kiểm tra phía sau đi.
Dialogue: 0,0:21:43.34,0:21:45.09,Default,,0,0,0,,Này Avida. Ở khu này…
Dialogue: 0,0:21:45.18,0:21:48.23,Default,,0,0,0,,Anh trông chừng con bé\Nmà lại có chuyện này à?
Dialogue: 0,0:21:49.73,0:21:50.94,Default,,0,0,0,,Mẹ xin lỗi, Talia.
Dialogue: 0,0:21:52.19,0:21:54.28,Default,,0,0,0,,Avida. Ta nên nói chuyện.
Dialogue: 0,0:21:55.52,0:21:56.73,Default,,0,0,0,,Nói chuyện?
Dialogue: 0,0:21:58.98,0:22:00.32,Default,,0,0,0,,Cô chưa nói với Talia…
Dialogue: 0,0:22:01.78,0:22:02.74,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:22:03.24,0:22:05.87,Default,,0,0,0,,Con bé lên cơn co giật và bất tỉnh.
Dialogue: 0,0:22:06.45,0:22:09.45,Default,,0,0,0,,{\an8}Tôi đã cho con bé kiểm tra khi đến đây.
Dialogue: 0,0:22:10.00,0:22:12.63,Default,,0,0,0,,{\an8}Có vẻ như nó có dấu hiệu\Ncủa siêu cuồng nhân.
Dialogue: 0,0:22:12.71,0:22:15.80,Default,,0,0,0,,{\an8}- Nhưng mới là dấu hiệu thôi.\N- Nên tôi mới nói đấy!
Dialogue: 0,0:22:15.88,0:22:20.18,Default,,0,0,0,,{\an8}Nếu có thể tiết chế siêu thiết bị\Nvà ổn định tinh thần, con bé sẽ ổn.
Dialogue: 0,0:22:20.71,0:22:21.67,Default,,0,0,0,,{\an8}Anh chắc chứ?
Dialogue: 0,0:22:21.76,0:22:24.68,Default,,0,0,0,,{\an8}Ừ. Nếu Talia chịu hợp tác…
Dialogue: 0,0:22:26.22,0:22:28.56,Default,,0,0,0,,{\an8}Nhưng tôi muốn xác nhận một điều.
Dialogue: 0,0:22:29.18,0:22:30.14,Default,,0,0,0,,{\an8}Gì vậy?
Dialogue: 0,0:22:31.06,0:22:33.02,Default,,0,0,0,,Đây là cảm nhận của tôi thôi.
Dialogue: 0,0:22:33.52,0:22:34.56,Default,,0,0,0,,Có vẻ như Talia…
Dialogue: 0,0:22:35.27,0:22:38.27,Default,,0,0,0,,không bị giáo lý của Maelstrom thu hút.
Dialogue: 0,0:22:38.82,0:22:39.99,Default,,0,0,0,,Tôi thấy không phải thế.
Dialogue: 0,0:22:40.65,0:22:43.15,Default,,0,0,0,,Chuyện con bé cố chấp về việc cơ giới hóa
Dialogue: 0,0:22:43.74,0:22:46.37,Default,,0,0,0,,chẳng lẽ có lý do nào khác?
Dialogue: 0,0:22:48.28,0:22:49.49,Default,,0,0,0,,Vậy là có nhỉ?
Dialogue: 0,0:22:55.75,0:22:57.96,Default,,0,0,0,,{\i1}Talia! Mừng là cô nghe máy.{\i0}
Dialogue: 0,0:22:58.46,0:23:01.71,Default,,0,0,0,,{\i1}Hôm nay thật xin lỗi cô.\NTôi có chuyện quan trọng.{\i0}
Dialogue: 0,0:23:02.21,0:23:03.50,Default,,0,0,0,,{\i1}Cô còn giận à?{\i0}
Dialogue: 0,0:23:03.59,0:23:05.09,Default,,0,0,0,,Hiển nhiên.
Dialogue: 0,0:23:05.59,0:23:08.55,Default,,0,0,0,,{\i1}Tôi xin lỗi.\NNhưng ca phẫu thuật đã thành công nhỉ?{\i0}
Dialogue: 0,0:23:10.22,0:23:11.68,Default,,0,0,0,,{\i1}Sao? Không à?{\i0}
Dialogue: 0,0:23:11.77,0:23:15.27,Default,,0,0,0,,Không. Vì ai đó không đến.
Dialogue: 0,0:23:15.35,0:23:16.43,Default,,0,0,0,,{\i1}Tại tôi ư?{\i0}
Dialogue: 0,0:23:16.52,0:23:17.60,Default,,0,0,0,,Còn ai nữa?
Dialogue: 0,0:23:17.69,0:23:20.19,Default,,0,0,0,,{\i1}- Ừm…{\i0}\N- Ừ. Thấy tội lỗi đi, đồ tồi.
Dialogue: 0,0:23:21.07,0:23:21.90,Default,,0,0,0,,{\i1}Nhưng mà…{\i0}
Dialogue: 0,0:23:22.57,0:23:24.03,Default,,0,0,0,,{\i1}tôi xem video rồi.{\i0}
Dialogue: 0,0:23:24.11,0:23:26.20,Default,,0,0,0,,- Hả?\N{\i1}- Cũng đỉnh đấy.{\i0}
Dialogue: 0,0:23:27.07,0:23:28.24,Default,,0,0,0,,{\i1}Ồ… Cảm ơn cô.{\i0}
Dialogue: 0,0:23:28.91,0:23:31.20,Default,,0,0,0,,{\i1}Nghe này, tôi hứa sẽ bù đắp cho cô!{\i0}
Dialogue: 0,0:23:32.04,0:23:34.38,Default,,0,0,0,,- Được rồi. Còn gì nữa không?\N{\i1}- Ừm…{\i0}
Dialogue: 0,0:23:34.87,0:23:37.42,Default,,0,0,0,,- Vậy… tạm biệt.\N{\i1}- Ừ, tạm biệt.{\i0}
Dialogue: 0,0:23:40.25,0:23:42.04,Default,,0,0,0,,Eo ơi, xem trán nhóc đó kìa.
Dialogue: 0,0:23:49.18,0:23:50.18,Default,,0,0,0,,Chảy máu này.
Dialogue: 0,0:24:07.20,0:24:09.08,Default,,0,0,0,,{\an8}Anh thấy vui chứ?
Dialogue: 0,0:24:09.16,0:24:09.99,Default,,0,0,0,,Ừ.
Dialogue: 0,0:24:10.99,0:24:12.28,Default,,0,0,0,,Tạm biệt anh nhé.
Dialogue: 0,0:24:20.21,0:24:21.04,Default,,0,0,0,,Hả?
Dialogue: 0,0:24:24.17,0:24:25.34,Default,,0,0,0,,Chuyện gì vậy?
Dialogue: 0,0:24:26.01,0:24:27.47,Default,,0,0,0,,Cái gì đây?
Dialogue: 0,0:24:29.38,0:24:30.51,Default,,0,0,0,,Ôi không.
Dialogue: 0,0:24:31.01,0:24:32.85,Default,,0,0,0,,Không ổn rồi.
Dialogue: 0,0:26:20.95,0:26:23.95,Default,,0,0,0,,Biên dịch: Khanh Tran
