Dialogue: 0,0:00:11.26,0:00:14.43,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:00:14.51,0:00:17.56,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:01:50.78,0:01:52.24,Default,,0,0,0,,Cái quái gì…
Dialogue: 0,0:01:54.53,0:01:56.82,Default,,0,0,0,,- D!\N- Này, cái quái gì vậy?
Dialogue: 0,0:01:56.91,0:01:58.33,Default,,0,0,0,,Cậu đã làm gì hả?
Dialogue: 0,0:01:58.41,0:01:59.58,Default,,0,0,0,,Talia!
Dialogue: 0,0:02:02.66,0:02:03.79,Default,,0,0,0,,Talia.
Dialogue: 0,0:02:08.46,0:02:10.25,Default,,0,0,0,,Không sao đâu. Bình tĩnh đi.
Dialogue: 0,0:02:11.38,0:02:12.34,Default,,0,0,0,,Hít thở đi.
Dialogue: 0,0:02:34.95,0:02:38.91,Default,,0,0,0,,Dĩ nhiên là kỹ thuật số,\Nnhưng tôi muốn có sự thô ráp của analog….
Dialogue: 0,0:02:39.45,0:02:40.95,Default,,0,0,0,,Cái quái gì…? Ối!
Dialogue: 0,0:02:42.41,0:02:43.95,Default,,0,0,0,,Này!
Dialogue: 0,0:02:53.13,0:02:54.01,Default,,0,0,0,,Talia.
Dialogue: 0,0:03:07.35,0:03:10.81,Default,,0,0,0,,{\an8}{\i1}Không khóc tí nào.\NCon mạnh mẽ lắm. Ngoan lắm, Talia.{\i0}
Dialogue: 0,0:03:13.11,0:03:16.36,Default,,0,0,0,,- Con nhìn gì thế?\N- Côn trùng.
Dialogue: 0,0:03:21.66,0:03:22.79,Default,,0,0,0,,Dừng lại.
Dialogue: 0,0:03:22.87,0:03:27.00,Default,,0,0,0,,{\i1}Tình trạng của con bé càng ngày càng xấu.\NTa phải quyết định ngay.{\i0}
Dialogue: 0,0:03:27.08,0:03:28.54,Default,,0,0,0,,Em biết chứ!
Dialogue: 0,0:03:28.63,0:03:30.05,Default,,0,0,0,,{\i1}- Em biết, nhưng…{\i0}\N- Thôi đi.
Dialogue: 0,0:03:31.13,0:03:34.30,Default,,0,0,0,,{\i1}Giỏi lắm. Con gái bố.{\i0}
Dialogue: 0,0:03:47.64,0:03:48.81,Default,,0,0,0,,Im đi!
Dialogue: 0,0:03:53.07,0:03:54.32,Default,,0,0,0,,Siêu cuồng nhân kìa!
Dialogue: 0,0:03:54.40,0:03:55.44,Default,,0,0,0,,Chạy đi!
Dialogue: 0,0:04:10.75,0:04:12.71,Default,,0,0,0,,Chết tiệt. Talia.
Dialogue: 0,0:04:22.60,0:04:24.14,Default,,0,0,0,,{\i1}Vẫn không được.{\i0}
Dialogue: 0,0:04:31.85,0:04:32.94,Default,,0,0,0,,Talia!
Dialogue: 0,0:04:33.77,0:04:35.69,Default,,0,0,0,,{\an8}Con chip đó…
Dialogue: 0,0:04:36.32,0:04:37.78,Default,,0,0,0,,{\an8}{\i1}Sức chịu đựng siêu thiết bị…{\i0}
Dialogue: 0,0:04:38.78,0:04:40.99,Default,,0,0,0,,{\an8}{\i1}Đúng là con gái bố.{\i0}
Dialogue: 0,0:04:41.53,0:04:46.45,Default,,0,0,0,,{\an8}{\i1}Con ổn chứ, Talia?{\i0}
Dialogue: 0,0:04:46.54,0:04:48.04,Default,,0,0,0,,{\an8}{\i1}Ngoan lắm, Talia.{\i0}
Dialogue: 0,0:04:48.12,0:04:49.87,Default,,0,0,0,,Câm đi!
Dialogue: 0,0:05:04.43,0:05:05.64,Default,,0,0,0,,Dừng lại đi, Talia!
Dialogue: 0,0:05:06.14,0:05:08.56,Default,,0,0,0,,{\an8}Đừng giết anh ta! Tập trung vào tôi này!
Dialogue: 0,0:05:08.64,0:05:10.52,Default,,0,0,0,,Mạnh mẽ lên!
Dialogue: 0,0:06:00.94,0:06:01.94,Default,,0,0,0,,ĐỘI CHẤN THƯƠNG
Dialogue: 0,0:06:02.03,0:06:03.07,Default,,0,0,0,,{\i1}Tránh ra!{\i0}
Dialogue: 0,0:06:05.32,0:06:06.82,Default,,0,0,0,,Tránh xa bệnh nhân ra!
Dialogue: 0,0:06:07.83,0:06:09.92,Default,,0,0,0,,- Lùi lại!\N- Lùi lại. Mau tránh ra!
Dialogue: 0,0:06:10.79,0:06:11.75,Default,,0,0,0,,Tôi là…
Dialogue: 0,0:06:11.83,0:06:12.83,Default,,0,0,0,,Capri.
Dialogue: 0,0:06:19.71,0:06:20.88,Default,,0,0,0,,Talia.
Dialogue: 0,0:06:22.09,0:06:26.14,Default,,0,0,0,,- Này! Đó là loại vi mạch gì vậy?\N- Cái đó của tôi!
Dialogue: 0,0:06:27.97,0:06:29.47,Default,,0,0,0,,Đợi đã! Cậu…
Dialogue: 0,0:06:43.11,0:06:44.78,Default,,0,0,0,,Chết tiệt! Tên đó…
Dialogue: 0,0:06:44.86,0:06:48.61,Default,,0,0,0,,Này, con chip đó là sao?\NSao cậu ta lại cắm nó vào Talia?
Dialogue: 0,0:06:48.70,0:06:51.29,Default,,0,0,0,,Có phải nó khiến con bé phát điên không?
Dialogue: 0,0:06:51.37,0:06:52.58,Default,,0,0,0,,Chuyện đó…
Dialogue: 0,0:06:52.66,0:06:54.33,Default,,0,0,0,,Đùa kiểu gì tai hại vậy?
Dialogue: 0,0:06:54.41,0:06:58.54,Default,,0,0,0,,- Talia có chuyện thì cậu tính sao?\N- Tôi xin lỗi.
Dialogue: 0,0:06:58.63,0:07:00.76,Default,,0,0,0,,Tôi cũng không hiểu rõ cho lắm…
Dialogue: 0,0:07:02.13,0:07:05.22,Default,,0,0,0,,Tôi sẽ đi theo Đội Chấn thương. Cậu về đi.
Dialogue: 0,0:07:06.18,0:07:08.98,Default,,0,0,0,,- Tôi sẽ đi cùng ông.\N- Không cần đâu.
Dialogue: 0,0:07:09.64,0:07:10.47,Default,,0,0,0,,Nhưng tôi…
Dialogue: 0,0:07:10.56,0:07:12.44,Default,,0,0,0,,Tôi đã bảo biến về nhà đi!
Dialogue: 0,0:07:42.04,0:07:43.75,Default,,0,0,0,,Capri!
Dialogue: 0,0:07:49.05,0:07:51.72,Default,,0,0,0,,Chuyện gì vừa xảy ra vậy?
Dialogue: 0,0:07:51.80,0:07:52.97,Default,,0,0,0,,Này!
Dialogue: 0,0:07:53.06,0:07:54.90,Default,,0,0,0,,Nói gì đi chứ!
Dialogue: 0,0:07:58.44,0:07:59.36,Default,,0,0,0,,Capri?
Dialogue: 0,0:08:04.82,0:08:05.65,Default,,0,0,0,,Hả?
Dialogue: 0,0:08:06.69,0:08:10.69,Default,,0,0,0,,Các mô thần kinh sống còn lại\Nđang bắt đầu bị phá vỡ.
Dialogue: 0,0:08:10.78,0:08:14.83,Default,,0,0,0,,Không chỉ thế, não của cô ấy\Ncũng bị ảnh hưởng, dù trước đó vẫn ổn.
Dialogue: 0,0:08:14.91,0:08:16.45,Default,,0,0,0,,Cứ thế này…
Dialogue: 0,0:08:17.96,0:08:21.92,Default,,0,0,0,,Còn nữa, nếu giảm lượng siêu thiết bị\Nxuống mức tối thiểu,
Dialogue: 0,0:08:22.42,0:08:26.51,Default,,0,0,0,,ta có thể giảm bớt cơn đau dữ dội\Ntrong tương lai.
Dialogue: 0,0:08:26.59,0:08:29.22,Default,,0,0,0,,Như thế có đủ không?
Dialogue: 0,0:08:29.30,0:08:30.13,Default,,0,0,0,,Không.
Dialogue: 0,0:08:30.72,0:08:36.10,Default,,0,0,0,,Thật không may, đề xuất của tôi\Nchỉ có thể giảm bớt đau khổ cho cô ấy.
Dialogue: 0,0:08:36.60,0:08:39.94,Default,,0,0,0,,Tôi nghĩ thời gian còn lại không dài…
Dialogue: 0,0:08:52.99,0:08:57.37,Default,,0,0,0,,{\i1}Các mô thần kinh còn lại của cô ấy\Nđang bị phá hủy, kể cả não.{\i0}
Dialogue: 0,0:08:57.45,0:08:58.37,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:08:58.45,0:08:59.74,Default,,0,0,0,,{\i1}Cứ thế này…{\i0}
Dialogue: 0,0:09:19.81,0:09:20.98,Default,,0,0,0,,Mẹ tôi đâu?
Dialogue: 0,0:09:29.74,0:09:31.91,Default,,0,0,0,,Tôi xong đời rồi.
Dialogue: 0,0:09:36.74,0:09:38.99,Default,,0,0,0,,Đừng cố quá, Talia.
Dialogue: 0,0:09:39.50,0:09:43.00,Default,,0,0,0,,Tôi đã hóa siêu cuồng nhân, đúng không?
Dialogue: 0,0:09:43.08,0:09:43.91,Default,,0,0,0,,Không…
Dialogue: 0,0:09:44.54,0:09:46.92,Default,,0,0,0,,Cảm giác như tôi không còn là tôi nữa.
Dialogue: 0,0:09:47.55,0:09:49.43,Default,,0,0,0,,Đúng như ông nói.
Dialogue: 0,0:09:49.51,0:09:51.72,Default,,0,0,0,,Chưa có gì chắc chắn cả.
Dialogue: 0,0:09:52.22,0:09:54.60,Default,,0,0,0,,Với cơ thể này, tôi vẫn ngăn được cháu.
Dialogue: 0,0:09:55.09,0:09:58.18,Default,,0,0,0,,Nếu cháu hóa siêu cuồng nhân,\Ntôi đã không thể làm thế.
Dialogue: 0,0:09:59.22,0:10:02.93,Default,,0,0,0,,Tôi thấy những người không có ở đó.\NNhư bóng ma vậy.
Dialogue: 0,0:10:04.35,0:10:05.18,Default,,0,0,0,,Người ư?
Dialogue: 0,0:10:05.81,0:10:07.44,Default,,0,0,0,,Ông cũng thấy họ mà?
Dialogue: 0,0:10:08.98,0:10:10.23,Default,,0,0,0,,Dĩ nhiên là có rồi…
Dialogue: 0,0:10:10.74,0:10:11.95,Default,,0,0,0,,Cháu sẽ ổn thôi.
Dialogue: 0,0:10:12.03,0:10:14.70,Default,,0,0,0,,Hai ta đều ở đây,\Nnói chuyện như bình thường.
Dialogue: 0,0:10:14.78,0:10:17.07,Default,,0,0,0,,- Nên là…\N- Kết thúc rồi.
Dialogue: 0,0:10:17.87,0:10:20.71,Default,,0,0,0,,Tôi sẽ không bao giờ già đi.
Dialogue: 0,0:10:20.79,0:10:22.96,Default,,0,0,0,,Sẽ chết khi còn là thiếu niên.
Dialogue: 0,0:10:23.04,0:10:24.46,Default,,0,0,0,,Chuyện đó…
Dialogue: 0,0:10:24.54,0:10:28.63,Default,,0,0,0,,Tôi muốn chết một cách duyên dáng.\NVậy mà không làm được!
Dialogue: 0,0:10:31.30,0:10:32.64,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:10:32.72,0:10:35.10,Default,,0,0,0,,Dừng lại! Bình tĩnh đi, Talia!
Dialogue: 0,0:10:35.18,0:10:37.60,Default,,0,0,0,,Ông cũng đã hóa siêu cuồng nhân!
Dialogue: 0,0:10:37.68,0:10:40.35,Default,,0,0,0,,Giết đồng đội\Nvà kết thúc với cơ thể như thế!
Dialogue: 0,0:10:40.93,0:10:43.02,Default,,0,0,0,,Sống như thế có ý nghĩa gì?
Dialogue: 0,0:10:43.10,0:10:44.19,Default,,0,0,0,,Có đấy!
Dialogue: 0,0:10:44.69,0:10:47.36,Default,,0,0,0,,Talia, tôi đã gặp cháu.
Dialogue: 0,0:10:48.73,0:10:49.61,Default,,0,0,0,,Sao?
Dialogue: 0,0:10:49.69,0:10:51.82,Default,,0,0,0,,Tôi đã nghĩ sẽ kết thúc tất cả.
Dialogue: 0,0:10:51.90,0:10:53.40,Default,,0,0,0,,Nhưng tôi đã gặp cháu.
Dialogue: 0,0:10:53.49,0:10:54.74,Default,,0,0,0,,Thì sao?
Dialogue: 0,0:10:54.82,0:10:56.78,Default,,0,0,0,,Mục đích của tôi là giúp đỡ cháu!
Dialogue: 0,0:10:57.28,0:10:58.62,Default,,0,0,0,,Đồ biến thái.
Dialogue: 0,0:10:59.49,0:11:00.37,Default,,0,0,0,,Đau…
Dialogue: 0,0:11:01.04,0:11:02.00,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:11:07.00,0:11:10.13,Default,,0,0,0,,{\an8}Tại sao lúc nào cũng là ông?
Dialogue: 0,0:11:12.30,0:11:13.18,Default,,0,0,0,,Nếu…
Dialogue: 0,0:11:14.22,0:11:18.35,Default,,0,0,0,,Nếu lại có chuyện gì xảy ra,\Ntôi nhất định sẽ ngăn chặn nó.
Dialogue: 0,0:11:18.84,0:11:21.13,Default,,0,0,0,,Nhất định thế. Tôi hứa đấy.
Dialogue: 0,0:11:21.72,0:11:24.72,Default,,0,0,0,,Nhưng nếu vô phương cứu chữa, thì Talia…
Dialogue: 0,0:11:25.98,0:11:27.15,Default,,0,0,0,,Thì sao?
Dialogue: 0,0:11:27.23,0:11:29.11,Default,,0,0,0,,Ta sẽ chết cùng nhau.
Dialogue: 0,0:11:30.98,0:11:33.15,Default,,0,0,0,,Tôi chẳng thấy vui chút nào.
Dialogue: 0,0:11:36.78,0:11:37.66,Default,,0,0,0,,Làm ơn.
Dialogue: 0,0:11:37.74,0:11:39.95,Default,,0,0,0,,Con bé có chuyện gì thì gọi cho tôi.
Dialogue: 0,0:11:40.45,0:11:43.54,Default,,0,0,0,,- Tôi không thể…\N- Tôi sẽ trả công xứng đáng.
Dialogue: 0,0:11:43.62,0:11:44.91,Default,,0,0,0,,ĐÃ GỬI €＄537
Dialogue: 0,0:11:45.00,0:11:46.29,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:11:52.42,0:11:57.17,Default,,0,0,0,,- Sao cậu biết bọn tôi sẽ ở đây?\N- Sau khi thấy chuyện xảy ra với Talia…
Dialogue: 0,0:11:58.13,0:11:59.30,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:11:59.84,0:12:02.63,Default,,0,0,0,,Ừm, xin lỗi vì chuyện đã xảy ra.
Dialogue: 0,0:12:03.14,0:12:05.56,Default,,0,0,0,,Tôi không nghĩ mọi chuyện sẽ tệ đến vậy.
Dialogue: 0,0:12:08.19,0:12:11.15,Default,,0,0,0,,Đừng lo. Không phải lỗi của cậu.
Dialogue: 0,0:12:12.52,0:12:16.19,Default,,0,0,0,,Lẽ ra không nên nặng lời\Nvới cậu như thế. Xin lỗi nhé.
Dialogue: 0,0:12:16.28,0:12:21.58,Default,,0,0,0,,Hả? Không. Vậy Talia thế nào rồi?
Dialogue: 0,0:12:23.58,0:12:27.17,Default,,0,0,0,,Con bé đã tạm ổn,\Nnhưng chưa thể lạc quan hoàn toàn.
Dialogue: 0,0:12:27.66,0:12:31.71,Default,,0,0,0,,- Đến mức đó sao?\N- Không nói nhiều được.
Dialogue: 0,0:12:31.79,0:12:33.58,Default,,0,0,0,,{\an8}Có phải vì…
Dialogue: 0,0:12:33.67,0:12:36.38,Default,,0,0,0,,{\an8}Không. Có thể không phải do vi mạch.
Dialogue: 0,0:12:36.88,0:12:38.38,Default,,0,0,0,,{\an8}Trước giờ Talia…
Dialogue: 0,0:12:38.47,0:12:41.22,Default,,0,0,0,,{\an8}Này, có rảnh nói chuyện chút không?
Dialogue: 0,0:12:43.18,0:12:44.72,Default,,0,0,0,,Cậu bao nhiêu tuổi?
Dialogue: 0,0:12:44.81,0:12:45.73,Default,,0,0,0,,Sao?
Dialogue: 0,0:12:46.27,0:12:48.44,Default,,0,0,0,,- Mười hai.\N- Ra vậy.
Dialogue: 0,0:12:49.85,0:12:52.02,Default,,0,0,0,,Cậu và Talia là sao?
Dialogue: 0,0:12:52.77,0:12:54.31,Default,,0,0,0,,Bọn tôi không hẹn hò.
Dialogue: 0,0:12:54.40,0:12:56.99,Default,,0,0,0,,Thật ra, bọn tôi chỉ mới gặp nhau.
Dialogue: 0,0:12:57.53,0:12:59.53,Default,,0,0,0,,Nhưng con bé lại gọi cho cậu à?
Dialogue: 0,0:13:00.86,0:13:03.70,Default,,0,0,0,,Chuyện bạn trai đó là sao?
Dialogue: 0,0:13:04.24,0:13:08.95,Default,,0,0,0,,Không, xin lỗi. Là lỗi của tôi. Thật đấy.
Dialogue: 0,0:13:09.46,0:13:11.71,Default,,0,0,0,,Quên chuyện đó đi nhé. Làm ơn.
Dialogue: 0,0:13:12.21,0:13:13.42,Default,,0,0,0,,Vậy…
Dialogue: 0,0:13:13.50,0:13:15.25,Default,,0,0,0,,Đừng truy cứu nữa.
Dialogue: 0,0:13:15.75,0:13:18.71,Default,,0,0,0,,Ông là bố của Talia à?
Dialogue: 0,0:13:20.22,0:13:22.06,Default,,0,0,0,,Ồ! Đúng vậy.
Dialogue: 0,0:13:25.97,0:13:29.72,Default,,0,0,0,,- Tôi giống chú của con bé hơn.\N- Thật ư?
Dialogue: 0,0:13:30.23,0:13:33.40,Default,,0,0,0,,{\i1}- Dù sao thì, về con chip đó.\N- Vâng?{\i0}
Dialogue: 0,0:13:33.48,0:13:36.90,Default,,0,0,0,,{\i1}Tôi muốn tìm hiểu cho chắc.\NCậu lấy nó cho tôi được không?{\i0}
Dialogue: 0,0:13:37.73,0:13:38.90,Default,,0,0,0,,{\an8}Chuyện đó…
Dialogue: 0,0:13:38.98,0:13:43.40,Default,,0,0,0,,{\i1}Tôi cũng chỉ mới quen D,\Ncòn chưa có thông tin liên lạc của anh ấy.{\i0}
Dialogue: 0,0:13:44.07,0:13:46.41,Default,,0,0,0,,{\i1}Nhưng tôi sẽ tìm cách.{\i0}
Dialogue: 0,0:13:46.49,0:13:47.32,Default,,0,0,0,,{\i1}Nhờ cậu nhé.{\i0}
Dialogue: 0,0:13:47.83,0:13:50.83,Default,,0,0,0,,{\i1}Hiểu rõ vi mạch đó\Ncó thể có ích cho việc điều trị.{\i0}
Dialogue: 0,0:13:51.33,0:13:52.41,Default,,0,0,0,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:13:53.54,0:13:55.17,Default,,0,0,0,,{\an8}Weak Kingsley đúng không?
Dialogue: 0,0:13:58.00,0:13:59.42,Default,,0,0,0,,{\i1}Weak?{\i0}
Dialogue: 0,0:13:59.51,0:14:02.43,Default,,0,0,0,,Kiril Yang. Tôi là bố của Talia.
Dialogue: 0,0:14:02.93,0:14:03.93,Default,,0,0,0,,Ồ.
Dialogue: 0,0:14:05.22,0:14:06.39,Default,,0,0,0,,Rất hân hạnh.
Dialogue: 0,0:14:08.72,0:14:10.01,Default,,0,0,0,,Tôi cũng vậy.
Dialogue: 0,0:14:10.52,0:14:12.81,Default,,0,0,0,,Nghe nói anh đã tìm thấy con gái tôi.
Dialogue: 0,0:14:13.31,0:14:17.15,Default,,0,0,0,,- À, chắc vậy.\N- {\i1}Cyberpunk{\i0} dày dạn có khác.
Dialogue: 0,0:14:17.65,0:14:20.95,Default,,0,0,0,,Không, là cựu {\i1}cyberpunk{\i0} chứ.
Dialogue: 0,0:14:21.03,0:14:23.03,Default,,0,0,0,,Dù sao, trông anh vẫn khỏe nhỉ?
Dialogue: 0,0:14:23.53,0:14:26.95,Default,,0,0,0,,Nghe nói anh gần như\Nđã hóa siêu cuồng nhân.
Dialogue: 0,0:14:31.83,0:14:32.96,Default,,0,0,0,,Sao anh biết?
Dialogue: 0,0:14:33.04,0:14:34.67,Default,,0,0,0,,Từ Avida thôi.
Dialogue: 0,0:14:35.33,0:14:37.96,Default,,0,0,0,,Tôi đã nghe chút ít\Nvề quá khứ của hai người.
Dialogue: 0,0:14:38.04,0:14:41.67,Default,,0,0,0,,{\an8}À, ra vậy. Nên nói sao nhỉ?
Dialogue: 0,0:14:42.21,0:14:45.21,Default,,0,0,0,,{\an8}Đa số siêu thiết bị của anh\Nnghe nói đã bị tạm dừng.
Dialogue: 0,0:14:45.30,0:14:48.72,Default,,0,0,0,,- À, anh thấy rồi đấy.\N- Ừm…
Dialogue: 0,0:14:48.80,0:14:50.64,Default,,0,0,0,,Tôi đi đây.
Dialogue: 0,0:14:51.14,0:14:53.93,Default,,0,0,0,,Ừ, đi đi. Chuyện con chip…
Dialogue: 0,0:14:54.02,0:14:54.85,Default,,0,0,0,,Tôi biết rồi.
Dialogue: 0,0:14:56.31,0:14:59.81,Default,,0,0,0,,{\i1}Weak Kingsley. Siêu cuồng nhân.{\i0}
Dialogue: 0,0:15:00.65,0:15:01.78,Default,,0,0,0,,{\an8}{\i1}Talia.{\i0}
Dialogue: 0,0:15:02.57,0:15:04.82,Default,,0,0,0,,{\an8}{\i1}Dù thế nào cũng phải tìm ra D.{\i0}
Dialogue: 0,0:15:11.58,0:15:14.25,Default,,0,0,0,,Chết tiệt! Thôi nào, Capri!
Dialogue: 0,0:16:16.35,0:16:17.35,Default,,0,0,0,,Cái…
Dialogue: 0,0:16:18.02,0:16:19.27,Default,,0,0,0,,Cái quái gì vậy?
Dialogue: 0,0:16:54.89,0:16:55.89,Default,,0,0,0,,D!
Dialogue: 0,0:16:57.89,0:17:01.52,Default,,0,0,0,,Alam. Mau tập hợp bạn bè đến đây.
Dialogue: 0,0:17:02.02,0:17:03.44,Default,,0,0,0,,Capri!
Dialogue: 0,0:17:04.11,0:17:05.78,Default,,0,0,0,,Cô bị cái quái gì vậy?
Dialogue: 0,0:17:05.86,0:17:07.70,Default,,0,0,0,,Để tôi mượn sức mạnh của cô đi!
Dialogue: 0,0:17:10.28,0:17:15.45,Default,,0,0,0,,Được thôi. Nếu cô thất hứa,\Ntôi cũng sẽ không giữ lời!
Dialogue: 0,0:17:20.00,0:17:22.38,Default,,0,0,0,,Cô là Capri đúng không?
Dialogue: 0,0:17:22.46,0:17:23.29,Default,,0,0,0,,D!
Dialogue: 0,0:17:26.09,0:17:27.68,Default,,0,0,0,,Anh đang làm gì vậy?
Dialogue: 0,0:17:30.63,0:17:32.55,Default,,0,0,0,,{\an8}Anh lại cắm vi mạch à?
Dialogue: 0,0:17:32.63,0:17:33.59,Default,,0,0,0,,{\an8}Nó là của tôi!
Dialogue: 0,0:17:34.68,0:17:38.93,Default,,0,0,0,,{\an8}Anh thấy chuyện xảy ra với Talia rồi mà?\NCon chip đó rất nguy hiểm.
Dialogue: 0,0:17:39.89,0:17:44.94,Default,,0,0,0,,{\an8}Cho tôi mượn một lúc đi.\NCó lẽ ta có thể tìm thấy gì đó hữu ích.
Dialogue: 0,0:17:45.02,0:17:47.19,Default,,0,0,0,,{\an8}Không được. Nó là của tôi!
Dialogue: 0,0:17:47.27,0:17:50.19,Default,,0,0,0,,{\an8}Nó có thể giúp ta cứu Talia.
Dialogue: 0,0:17:51.20,0:17:53.24,Default,,0,0,0,,{\an8}Cô ấy không ổn cho lắm.
Dialogue: 0,0:17:53.74,0:17:55.33,Default,,0,0,0,,{\an8}Liên quan gì đến tôi?
Dialogue: 0,0:17:56.03,0:17:58.49,Default,,0,0,0,,{\an8}Anh đã cắm nó vào người Talia, D!
Dialogue: 0,0:17:58.58,0:18:00.54,Default,,0,0,0,,{\an8}Không phải tôi. Là Capri!
Dialogue: 0,0:18:00.62,0:18:01.54,Default,,0,0,0,,{\an8}Capri?
Dialogue: 0,0:18:02.04,0:18:05.17,Default,,0,0,0,,{\an8}Capri làm thế ư? Vậy cô ấy nói gì?
Dialogue: 0,0:18:06.54,0:18:09.63,Default,,0,0,0,,Nói đi! Cô ấy nói gì?
Dialogue: 0,0:18:13.93,0:18:16.60,Default,,0,0,0,,Anh muốn trả thù đến thế sao?
Dialogue: 0,0:18:20.39,0:18:21.27,Default,,0,0,0,,D.
Dialogue: 0,0:18:24.52,0:18:25.35,Default,,0,0,0,,Roman!
Dialogue: 0,0:18:33.36,0:18:36.99,Default,,0,0,0,,Bắt thằng nhóc nữa.\NPhải giữ chúng còn sống!
Dialogue: 0,0:18:37.07,0:18:38.40,Default,,0,0,0,,Không phải hắn…
Dialogue: 0,0:18:38.49,0:18:39.74,Default,,0,0,0,,Đứng sát vào tôi.
Dialogue: 0,0:18:40.41,0:18:41.50,Default,,0,0,0,,Ông muốn gì?
Dialogue: 0,0:18:41.58,0:18:46.63,Default,,0,0,0,,Câm mồm! Tại mày mà tao bị giáng chức.
Dialogue: 0,0:18:46.71,0:18:49.88,Default,,0,0,0,,Nhưng nếu bắt được\Nvà giao nộp hai con chuột cống,
Dialogue: 0,0:18:49.96,0:18:51.84,Default,,0,0,0,,tao vẫn còn cơ hội.
Dialogue: 0,0:18:51.92,0:18:52.88,Default,,0,0,0,,Đồ trẻ con!
Dialogue: 0,0:18:52.97,0:18:55.26,Default,,0,0,0,,Hình phạt vì tội vô lễ với người lớn.
Dialogue: 0,0:18:55.34,0:18:57.51,Default,,0,0,0,,Người lớn cái con khỉ!
Dialogue: 0,0:18:57.59,0:18:59.88,Default,,0,0,0,,Capri! Thật đấy, giúp tôi đi!
Dialogue: 0,0:19:04.23,0:19:05.69,Default,,0,0,0,,Lại nữa à?
Dialogue: 0,0:19:12.94,0:19:13.77,Default,,0,0,0,,Ôi!
Dialogue: 0,0:19:20.49,0:19:21.58,Default,,0,0,0,,D!
Dialogue: 0,0:19:21.66,0:19:23.04,Default,,0,0,0,,Rời khỏi đây đi!
Dialogue: 0,0:19:23.62,0:19:26.54,Default,,0,0,0,,{\an8}Nó là {\i1}netrunner!{\i0}\NCắm thiết bị gây nhiễu đi!
Dialogue: 0,0:19:26.62,0:19:28.33,Default,,0,0,0,,{\an8}Hắn cắm một vi mạch lạ lắm.
Dialogue: 0,0:19:28.42,0:19:30.30,Default,,0,0,0,,Vậy thì rút ra đi!
Dialogue: 0,0:19:31.63,0:19:33.05,Default,,0,0,0,,{\an8}Này! Dừng lại!
Dialogue: 0,0:19:40.01,0:19:41.18,Default,,0,0,0,,Capri!
Dialogue: 0,0:19:46.02,0:19:47.35,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:19:50.90,0:19:53.07,Default,,0,0,0,,Này, tên khốn.
Dialogue: 0,0:19:53.15,0:19:54.57,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:19:55.65,0:19:57.90,Default,,0,0,0,,Này! Mày làm gì vậy?
Dialogue: 0,0:20:25.35,0:20:28.27,Default,,0,0,0,,Ngăn nó lại! Nếu cần thì giết nó đi!
Dialogue: 0,0:20:29.02,0:20:30.52,Default,,0,0,0,,Chết đi!
Dialogue: 0,0:20:33.15,0:20:34.28,Default,,0,0,0,,{\an8}Đừng cản đường tôi!
Dialogue: 0,0:20:39.99,0:20:45.08,Default,,0,0,0,,{\an8}Tại sao? Sao không bắn được mày? Khỉ thật!
Dialogue: 0,0:20:51.00,0:20:53.09,Default,,0,0,0,,{\an8}Lần này sẵn sàng nói chưa?
Dialogue: 0,0:20:56.51,0:20:57.43,Default,,0,0,0,,{\an8}Gì hả?
Dialogue: 0,0:20:57.51,0:20:59.30,Default,,0,0,0,,Đồ tép riu.
Dialogue: 0,0:21:15.57,0:21:16.57,Default,,0,0,0,,D.
Dialogue: 0,0:21:20.20,0:21:22.45,Default,,0,0,0,,Biết gì thì phun ra hết đi.
Dialogue: 0,0:21:24.45,0:21:25.45,Default,,0,0,0,,Nói đi!
Dialogue: 0,0:21:25.53,0:21:30.24,Default,,0,0,0,,Mày muốn trả thù à? Thật nực cười.
Dialogue: 0,0:21:30.33,0:21:34.00,Default,,0,0,0,,Mày nghĩ ai gây ra cuộc đột kích\Nvào trại của mày?
Dialogue: 0,0:21:34.50,0:21:35.46,Default,,0,0,0,,Ông nói gì?
Dialogue: 0,0:21:35.54,0:21:39.96,Default,,0,0,0,,Là mày. Nếu mày không ở đó,\Nchuyện đó đã không xảy ra.
Dialogue: 0,0:21:41.01,0:21:42.22,Default,,0,0,0,,Ý ông là sao?
Dialogue: 0,0:21:42.30,0:21:44.55,Default,,0,0,0,,Trả thù gì chứ?
Dialogue: 0,0:21:44.64,0:21:46.98,Default,,0,0,0,,Chúng chết là tại mày.
Dialogue: 0,0:21:47.56,0:21:49.23,Default,,0,0,0,,Đừng nói nhảm!
Dialogue: 0,0:21:49.31,0:21:51.73,Default,,0,0,0,,Mày đã giết chúng.
Dialogue: 0,0:21:53.98,0:21:55.19,Default,,0,0,0,,Im đi.
Dialogue: 0,0:21:55.81,0:21:57.31,Default,,0,0,0,,{\an8}Im đi!
Dialogue: 0,0:22:01.32,0:22:03.99,Default,,0,0,0,,Đủ rồi! D!
Dialogue: 0,0:22:43.36,0:22:45.20,Default,,0,0,0,,Hết cách rồi.
Dialogue: 0,0:24:35.89,0:24:38.89,Default,,0,0,0,,Biên dịch: Khanh Tran
