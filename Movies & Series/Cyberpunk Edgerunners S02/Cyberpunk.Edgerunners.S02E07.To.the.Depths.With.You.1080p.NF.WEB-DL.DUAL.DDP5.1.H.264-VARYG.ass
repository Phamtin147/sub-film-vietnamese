Dialogue: 0,0:00:11.26,0:00:14.43,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:00:14.51,0:00:17.56,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:01:42.52,0:01:44.06,Default,,0,0,0,,{\an8}{\i1}Theo những gì cậu nói,{\i0}
Dialogue: 0,0:01:44.15,0:01:47.40,Default,,0,0,0,,{\an8}{\i1}tôi không thể phủ nhận\Nnguy cơ hóa siêu cuồng nhân.{\i0}
Dialogue: 0,0:01:47.48,0:01:49.57,Default,,0,0,0,,{\an8}{\i1}Vâng, tôi cần thêm thông tin.{\i0}
Dialogue: 0,0:01:49.65,0:01:51.49,Default,,0,0,0,,{\an8}{\i1}Cậu nói kỹ hơn được không?{\i0}
Dialogue: 0,0:01:51.57,0:01:55.12,Default,,0,0,0,,{\an8}{\i1}Có dấu hiệu nào khác\Ncủa siêu cuồng nhân không?{\i0}
Dialogue: 0,0:01:55.20,0:01:59.25,Default,,0,0,0,,{\an8}{\i1}Cậu ấy có từng bất chợt xử sự như ai khác,\Ndù chỉ tạm thời không?{\i0}
Dialogue: 0,0:02:00.79,0:02:04.00,Default,,0,0,0,,{\an8}{\i1}Đôi lúc cũng có vẻ thế, nhưng…{\i0}
Dialogue: 0,0:02:04.08,0:02:07.00,Default,,0,0,0,,{\an8}{\i1}Tôi biết mà!\NCó bao giờ xử sự như con gái không?{\i0}
Dialogue: 0,0:02:07.09,0:02:07.97,Default,,0,0,0,,{\an8}{\i1}Con gái ư?{\i0}
Dialogue: 0,0:02:09.46,0:02:12.92,Default,,0,0,0,,{\an8}{\i1}Tôi không biết. Nhưng anh ấy\Ncó vẻ như một người khác thật.{\i0}
Dialogue: 0,0:02:13.01,0:02:16.06,Default,,0,0,0,,{\an8}{\i1}Ừm. Chỉ một lần thôi ư?{\i0}
Dialogue: 0,0:02:16.14,0:02:16.97,Default,,0,0,0,,{\an8}{\i1}Có lẽ thế.{\i0}
Dialogue: 0,0:02:17.55,0:02:20.89,Default,,0,0,0,,{\i1}Hóa siêu cuồng nhân\Nlàm thay đổi tính cách à?{\i0}
Dialogue: 0,0:02:20.97,0:02:23.14,Default,,0,0,0,,{\i1}Không nhất thiết, nhưng…{\i0}
Dialogue: 0,0:02:23.23,0:02:25.65,Default,,0,0,0,,{\i1}Còn nói chuyện với người không thấy được?{\i0}
Dialogue: 0,0:02:25.73,0:02:29.23,Default,,0,0,0,,{\i1}Sao? Kiểu bạn tưởng tượng ấy à?{\i0}
Dialogue: 0,0:02:29.32,0:02:31.28,Default,,0,0,0,,{\i1}Không, tôi chợt nghĩ đến thôi.{\i0}
Dialogue: 0,0:02:31.36,0:02:32.49,Default,,0,0,0,,{\i1}Thật chứ?{\i0}
Dialogue: 0,0:02:32.57,0:02:35.07,Default,,0,0,0,,{\i1}Thật mà. Nhưng cảm ơn vì mọi thứ.{\i0}
Dialogue: 0,0:02:35.57,0:02:37.91,Default,,0,0,0,,{\i1}Nếu còn câu hỏi, tôi tìm cô được không?{\i0}
Dialogue: 0,0:02:37.99,0:02:39.24,Default,,0,0,0,,{\i1}Dĩ nhiên là được.{\i0}
Dialogue: 0,0:02:39.33,0:02:41.33,Default,,0,0,0,,{\i1}Vậy hôm nay đến đây thôi.{\i0}
Dialogue: 0,0:02:44.04,0:02:48.46,Default,,0,0,0,,Vậy là nhân cách của D chưa bị ghi đè.\NCapri ở trong đầu nói chuyện với D ư?
Dialogue: 0,0:02:48.54,0:02:51.08,Default,,0,0,0,,Nghĩa là việc ghi đè vẫn đang diễn ra sao?
Dialogue: 0,0:02:51.59,0:02:55.51,Default,,0,0,0,,Vậy thì… Không đâu.
Dialogue: 0,0:02:57.22,0:02:59.64,Default,,0,0,0,,Có quá nhiều thứ mình chưa hiểu.
Dialogue: 0,0:03:00.22,0:03:02.97,Default,,0,0,0,,Sao cô lại chạy trốn ta, Capri?
Dialogue: 0,0:03:04.10,0:03:05.14,Default,,0,0,0,,Bắt đầu đi.
Dialogue: 0,0:03:21.12,0:03:23.62,Default,,0,0,0,,Này Capri. Đừng đùa nữa.
Dialogue: 0,0:03:24.25,0:03:27.17,Default,,0,0,0,,- Thật là.\N- Sức mạnh thật phi thường.
Dialogue: 0,0:03:28.00,0:03:32.67,Default,,0,0,0,,Trong tích tắc, nó có thể điều khiển\Nhoặc phá hủy một thiết bị điện tử bất kỳ.
Dialogue: 0,0:03:32.75,0:03:36.42,Default,,0,0,0,,Với thứ này, cục diện chiến tranh\Nsẽ thay đổi đáng kể.
Dialogue: 0,0:03:36.51,0:03:39.43,Default,,0,0,0,,Nhưng có một vấn đề chưa được giải quyết.
Dialogue: 0,0:03:41.26,0:03:43.97,Default,,0,0,0,,Khỉ thật. Mau rút con chip ra đi.
Dialogue: 0,0:03:44.06,0:03:45.77,Default,,0,0,0,,- Vâng.\N- Chuyện gì vậy?
Dialogue: 0,0:03:46.31,0:03:47.14,Default,,0,0,0,,Tính đến nay,
Dialogue: 0,0:03:47.23,0:03:51.44,Default,,0,0,0,,khoảng 7% đối tượng thử nghiệm\Nchịu được việc cài đặt Capricorn.
Dialogue: 0,0:03:51.52,0:03:53.98,Default,,0,0,0,,Trong vòng 12 giờ, con số đó giảm một nửa
Dialogue: 0,0:03:54.07,0:03:56.99,Default,,0,0,0,,và số còn lại chết hết trong vòng 48 giờ.
Dialogue: 0,0:03:57.07,0:03:59.95,Default,,0,0,0,,Vậy làm sao dùng được?
Dialogue: 0,0:04:00.03,0:04:01.87,Default,,0,0,0,,Vấn đề là khả năng tương thích.
Dialogue: 0,0:04:01.95,0:04:06.12,Default,,0,0,0,,Khi tìm được mảnh ghép hoàn hảo,\Nta sẽ tìm ra giải pháp.
Dialogue: 0,0:04:06.20,0:04:09.41,Default,,0,0,0,,Một thực thể tích hợp nhiều cấu trúc sao?
Dialogue: 0,0:04:09.50,0:04:11.67,Default,,0,0,0,,Nếu nó trốn vào mạng thì sao?
Dialogue: 0,0:04:11.75,0:04:14.96,Default,,0,0,0,,Mấu chốt là nó cần được cài đặt\Nvào cơ thể con người.
Dialogue: 0,0:04:15.05,0:04:19.30,Default,,0,0,0,,{\an8}Điểm dễ bị tổn thương đó\Nlại trở thành sự bảo hộ lớn nhất.
Dialogue: 0,0:04:19.38,0:04:22.55,Default,,0,0,0,,{\an8}Cùng lắm thì đưa thuốc nổ\Nhay chất độc vào người thôi.
Dialogue: 0,0:04:22.64,0:04:24.98,Default,,0,0,0,,{\an8}Chỉ bật công tắc là có thể phá hủy nó.
Dialogue: 0,0:04:25.56,0:04:27.56,Default,,0,0,0,,Nó bị giam vào một cơ thể vật lý,
Dialogue: 0,0:04:27.64,0:04:32.14,Default,,0,0,0,,nên không lo AI sẽ nổi loạn\Nhay phá vỡ Bức tường Đen.
Dialogue: 0,0:04:32.65,0:04:33.48,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:04:33.56,0:04:36.65,Default,,0,0,0,,{\an8}Vậy chính cơ thể là nhà tù của nó rồi .
Dialogue: 0,0:04:41.28,0:04:43.32,Default,,0,0,0,,- Vật mẫu tiếp theo.\N- Vâng.
Dialogue: 0,0:04:44.83,0:04:48.33,Default,,0,0,0,,{\i1}Cái chết của Tanaka\Ncó vẻ đã dừng các hoạt động Phản gián.{\i0}
Dialogue: 0,0:04:48.83,0:04:50.62,Default,,0,0,0,,{\i1}Có vẻ sẽ mất một thời gian.{\i0}
Dialogue: 0,0:04:51.42,0:04:55.88,Default,,0,0,0,,{\i1}Ta dùng bao nhiêu thân xác rồi?\NCó chắc sẽ tìm thấy hàng thật không?{\i0}
Dialogue: 0,0:04:55.96,0:04:58.13,Default,,0,0,0,,{\i1}Đừng mong có thêm tiền nữa đấy.{\i0}
Dialogue: 0,0:05:01.05,0:05:03.09,Default,,0,0,0,,{\i1}Đừng lo, Capri.{\i0}
Dialogue: 0,0:05:04.26,0:05:06.01,Default,,0,0,0,,Cô Kyoko, nguy rồi!
Dialogue: 0,0:05:06.10,0:05:08.23,Default,,0,0,0,,{\i1}Ta không để họ xóa cô đâu.{\i0}
Dialogue: 0,0:05:12.06,0:05:13.40,Default,,0,0,0,,Bảo nó dừng lại đi!
Dialogue: 0,0:05:21.03,0:05:23.16,Default,,0,0,0,,Ứng chiến đi! Dùng vũ khí thường ấy!
Dialogue: 0,0:05:23.24,0:05:25.53,Default,,0,0,0,,Đừng có giỡn mặt! Mặt tôi…
Dialogue: 0,0:05:25.62,0:05:28.83,Default,,0,0,0,,Chúng tôi hết hứng thú rồi.\NThật đáng thất vọng.
Dialogue: 0,0:05:29.33,0:05:33.96,Default,,0,0,0,,Chúng tôi sắp hoàn thành Capri rồi.\NTa chỉ cần một cơ thể, một vật chủ thôi.
Dialogue: 0,0:05:34.58,0:05:35.79,Default,,0,0,0,,Kết thúc rồi.
Dialogue: 0,0:05:36.38,0:05:39.18,Default,,0,0,0,,Ta sẽ tạm dừng Dự án Capricorn\Nvô thời hạn.
Dialogue: 0,0:05:39.26,0:05:41.89,Default,,0,0,0,,{\an8}Capri! Thả Capri ra!
Dialogue: 0,0:05:41.97,0:05:43.39,Default,,0,0,0,,{\an8}Capri!
Dialogue: 0,0:05:49.35,0:05:50.77,Default,,0,0,0,,Trời sáng rồi.
Dialogue: 0,0:05:50.85,0:05:53.44,Default,,0,0,0,,Chẳng phải đến lúc cô phải về rồi ư?
Dialogue: 0,0:05:58.32,0:06:00.45,Default,,0,0,0,,Đúng là chỉ mỗi mình tôi thấy cô.
Dialogue: 0,0:06:00.53,0:06:02.99,Default,,0,0,0,,Sao, lại nghĩ tôi là ảo giác à?
Dialogue: 0,0:06:03.07,0:06:04.99,Default,,0,0,0,,- Phải nói bao nhiêu lần…\N- Rồi.
Dialogue: 0,0:06:05.07,0:06:06.99,Default,,0,0,0,,Cô là một cấu trúc nhân tạo.
Dialogue: 0,0:06:07.49,0:06:09.70,Default,,0,0,0,,Thôi đọc suy nghĩ của tôi được không?
Dialogue: 0,0:06:09.79,0:06:12.71,Default,,0,0,0,,Tôi ở trong não cô mà.\NTôi còn biết làm gì đây?
Dialogue: 0,0:06:12.79,0:06:14.33,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:06:14.42,0:06:19.51,Default,,0,0,0,,Chính tôi đã chỉnh sửa não cho cô\Nvà giúp cô đi lại thế này.
Dialogue: 0,0:06:19.59,0:06:21.30,Default,,0,0,0,,Cô hiểu chứ?
Dialogue: 0,0:06:21.38,0:06:24.47,Default,,0,0,0,,Nhưng không có tôi,\Ncô sẽ không tồn tại, đúng không?
Dialogue: 0,0:06:24.55,0:06:27.76,Default,,0,0,0,,Thấy không, đây là lúc bánh ít đi,\Nbánh quy lại.
Dialogue: 0,0:06:27.85,0:06:30.48,Default,,0,0,0,,Chà, đúng là tôi có thể đi lại thế này.
Dialogue: 0,0:06:30.56,0:06:33.48,Default,,0,0,0,,{\i1}Và cô đã hack vào hệ thống bệnh viện.{\i0}
Dialogue: 0,0:06:33.56,0:06:36.40,Default,,0,0,0,,Tôi tin cô, chắc vậy.
Dialogue: 0,0:06:37.86,0:06:39.24,Default,,0,0,0,,Cô kỳ lạ thật đấy.
Dialogue: 0,0:06:39.90,0:06:40.73,Default,,0,0,0,,Kỳ lạ ư?
Dialogue: 0,0:06:40.82,0:06:43.28,Default,,0,0,0,,Có vẻ như cô cũng mắc bệnh nan y.
Dialogue: 0,0:06:43.36,0:06:47.70,Default,,0,0,0,,Chẳng phải lúc này cô nên vui sao?\NVì đã khỏe mạnh trở lại?
Dialogue: 0,0:06:48.20,0:06:49.24,Default,,0,0,0,,Tôi vui mà.
Dialogue: 0,0:06:50.37,0:06:52.50,Default,,0,0,0,,Nhưng thế này vẫn chưa đủ.
Dialogue: 0,0:06:52.58,0:06:54.75,Default,,0,0,0,,Không thể nhào lộn hay gì đó đâu.
Dialogue: 0,0:06:54.83,0:06:57.25,Default,,0,0,0,,Cứ hài lòng với những gì cô đang có đi.
Dialogue: 0,0:06:58.33,0:07:00.54,Default,,0,0,0,,Chỉ cần lấy con chip thôi đúng không?
Dialogue: 0,0:07:00.63,0:07:04.59,Default,,0,0,0,,Đúng vậy. Hơn một nửa của tôi\Nvẫn còn ở trong đó.
Dialogue: 0,0:07:04.67,0:07:08.26,Default,,0,0,0,,Khi nguyên vẹn trở lại,\Ncô sẽ chữa khỏi cho tôi chứ?
Dialogue: 0,0:07:08.34,0:07:10.43,Default,,0,0,0,,Như tôi đã nói, còn hơn thế nữa.
Dialogue: 0,0:07:10.51,0:07:13.39,Default,,0,0,0,,Hơn nữa sao?\NTôi không tưởng tượng nổi đấy.
Dialogue: 0,0:07:13.47,0:07:14.51,Default,,0,0,0,,Thật à?
Dialogue: 0,0:07:14.60,0:07:17.27,Default,,0,0,0,,Vì ngay cả khi khoẻ nhất…
Dialogue: 0,0:07:17.35,0:07:19.73,Default,,0,0,0,,tôi cũng chỉ đến thế thôi.
Dialogue: 0,0:07:21.40,0:07:24.65,Default,,0,0,0,,{\an8}Tôi hứa, ít nhất cô sẽ trở lại như thế.
Dialogue: 0,0:07:38.83,0:07:41.25,Default,,0,0,0,,Này. Cô là Capri đúng không?
Dialogue: 0,0:07:42.63,0:07:43.47,Default,,0,0,0,,{\an8}Này!
Dialogue: 0,0:07:45.59,0:07:46.55,Default,,0,0,0,,Capri.
Dialogue: 0,0:07:52.97,0:07:54.31,Default,,0,0,0,,{\i1}Hmm.{\i0}
Dialogue: 0,0:07:55.64,0:07:57.48,Default,,0,0,0,,{\i1}Ồ, cái này đang ghi hình à?{\i0}
Dialogue: 0,0:07:57.56,0:08:00.27,Default,,0,0,0,,{\i1}Chào mọi người.\NHôm nay bọn tôi sẽ phát live!{\i0}
Dialogue: 0,0:08:00.35,0:08:02.77,Default,,0,0,0,,{\i1}Được rồi, D. Bắt đầu đi.{\i0}
Dialogue: 0,0:08:03.44,0:08:08.32,Default,,0,0,0,,{\i1}Tôi đã kêu gọi\Nkẻ tấn công tộc của tôi ra mặt.{\i0}
Dialogue: 0,0:08:08.40,0:08:10.28,Default,,0,0,0,,{\i1}Nhưng không có phản hồi.{\i0}
Dialogue: 0,0:08:10.36,0:08:12.86,Default,,0,0,0,,{\i1}Tôi sẽ chứng minh tôi nghiêm túc ra sao.{\i0}
Dialogue: 0,0:08:13.37,0:08:14.79,Default,,0,0,0,,{\i1}Jake Collins.{\i0}
Dialogue: 0,0:08:14.87,0:08:19.29,Default,,0,0,0,,{\an8}{\i1}Phó Cục trưởng Phản gián Arasaka.\NChúng tôi sẽ tấn công hắn ngay bây giờ.{\i0}
Dialogue: 0,0:08:24.55,0:08:25.89,Default,,0,0,0,,{\i1}Này, hắn đi lối đó!{\i0}
Dialogue: 0,0:08:26.46,0:08:28.92,Default,,0,0,0,,{\i1}Ông ở đâu hả? Ra đây đi!{\i0}
Dialogue: 0,0:08:29.55,0:08:30.64,Default,,0,0,0,,{\i1}Ồ, hắn kìa.{\i0}
Dialogue: 0,0:08:32.76,0:08:35.93,Default,,0,0,0,,Roman, góc quay đó tuyệt lắm.\NĐầy ắp hành động.
Dialogue: 0,0:08:42.23,0:08:43.27,Default,,0,0,0,,Tay tôi…
Dialogue: 0,0:08:44.52,0:08:46.44,Default,,0,0,0,,Giúp tôi tìm tay tôi với.
Dialogue: 0,0:08:46.53,0:08:47.45,Default,,0,0,0,,Này.
Dialogue: 0,0:08:47.53,0:08:50.07,Default,,0,0,0,,Tôi không biết. Tôi không biết gì cả.
Dialogue: 0,0:08:50.15,0:08:53.45,Default,,0,0,0,,Đừng nói dối.\NLàm sao Phản gián không biết chứ?
Dialogue: 0,0:08:53.53,0:08:57.24,Default,,0,0,0,,Tôi không nói dối.\NTôi không biết gì về vụ tấn công tộc…
Dialogue: 0,0:08:57.75,0:08:59.63,Default,,0,0,0,,Vậy ai biết?
Dialogue: 0,0:08:59.71,0:09:01.67,Default,,0,0,0,,Ai ra lệnh tấn công? Ai?
Dialogue: 0,0:09:01.75,0:09:03.54,Default,,0,0,0,,Tôi thật sự không biết!
Dialogue: 0,0:09:03.63,0:09:08.68,Default,,0,0,0,,Tôi mới chuyển đến. Tôi không liên quan.\NLàm ơn, tôi cần được điều trị.
Dialogue: 0,0:09:09.63,0:09:10.46,Default,,0,0,0,,Làm ơn.
Dialogue: 0,0:09:10.55,0:09:13.26,Default,,0,0,0,,Hết thời gian. D, đến lúc rút lui rồi!
Dialogue: 0,0:09:13.34,0:09:14.17,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:09:20.02,0:09:20.85,Default,,0,0,0,,Tay tôi…
Dialogue: 0,0:09:20.94,0:09:22.15,Default,,0,0,0,,Đến lúc chuồn rồi.
Dialogue: 0,0:09:22.23,0:09:24.44,Default,,0,0,0,,Cái gì, sao nhanh vậy?
Dialogue: 0,0:09:25.02,0:09:25.94,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:09:27.36,0:09:28.19,Default,,0,0,0,,Hả?
Dialogue: 0,0:09:33.49,0:09:36.66,Default,,0,0,0,,Nếu là D bây giờ,\Nbao nhiêu tiếp viện cũng xử đẹp.
Dialogue: 0,0:09:36.74,0:09:41.04,Default,,0,0,0,,Đúng chứ? Này D,\Nnghiền nát cả tập đoàn đi…
Dialogue: 0,0:09:45.88,0:09:48.72,Default,,0,0,0,,{\an8}Đừng ném đồ chứ! Làm tôi sợ đấy.
Dialogue: 0,0:09:48.80,0:09:51.60,Default,,0,0,0,,Sao ta chẳng thu được gì\Nsau toàn bộ chuyện này?
Dialogue: 0,0:09:51.67,0:09:52.50,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:10:18.83,0:10:21.04,Default,,0,0,0,,Hả? Cô ta là ai vậy?
Dialogue: 0,0:10:21.12,0:10:22.00,Default,,0,0,0,,Làm sao đây?
Dialogue: 0,0:10:22.91,0:10:23.91,Default,,0,0,0,,Cứ tông cô ta đi.
Dialogue: 0,0:10:24.00,0:10:25.88,Default,,0,0,0,,Khoan. Cô ấy là người của tôi.
Dialogue: 0,0:10:26.38,0:10:29.09,Default,,0,0,0,,- Hả?\N- Sao cô ta biết ta đi đường này?
Dialogue: 0,0:10:29.17,0:10:30.09,Default,,0,0,0,,Tôi nói đấy.
Dialogue: 0,0:10:32.84,0:10:33.76,Default,,0,0,0,,Cậu xem rồi à?
Dialogue: 0,0:10:34.34,0:10:35.26,Default,,0,0,0,,Tôi có xem.
Dialogue: 0,0:10:35.34,0:10:39.51,Default,,0,0,0,,Cậu sẽ tham gia cùng bọn tôi, đúng không?\NNên cậu mới đến đây nhỉ?
Dialogue: 0,0:10:40.18,0:10:43.02,Default,,0,0,0,,Mấy việc làm kinh khủng đó…\NNó không bình thường.
Dialogue: 0,0:10:43.10,0:10:44.39,Default,,0,0,0,,Nó không tuyệt ư?
Dialogue: 0,0:10:44.48,0:10:46.19,Default,,0,0,0,,Vấn đề không phải thế.
Dialogue: 0,0:10:46.81,0:10:47.81,Default,,0,0,0,,Tôi thấy sợ hãi.
Dialogue: 0,0:10:47.90,0:10:50.90,Default,,0,0,0,,Sao cậu có thể tỉnh táo\Nsau những gì cậu đã làm?
Dialogue: 0,0:10:50.98,0:10:53.32,Default,,0,0,0,,Tôi hoàn toàn ổn.
Dialogue: 0,0:10:53.40,0:10:57.40,Default,,0,0,0,,Việc cậu đang làm\Nchẳng khác gì thứ họ đã làm với chúng ta.
Dialogue: 0,0:10:58.24,0:10:59.16,Default,,0,0,0,,Chẳng khác gì?
Dialogue: 0,0:10:59.66,0:11:03.04,Default,,0,0,0,,Cậu không phải người\Nsẽ làm những việc kinh khủng như vậy.
Dialogue: 0,0:11:03.12,0:11:04.46,Default,,0,0,0,,Cậu của trước đây…
Dialogue: 0,0:11:05.00,0:11:07.59,Default,,0,0,0,,Cậu làm tất cả những việc này vì cái gì?
Dialogue: 0,0:11:07.67,0:11:09.17,Default,,0,0,0,,Có lý do đấy.
Dialogue: 0,0:11:09.71,0:11:11.38,Default,,0,0,0,,- Để trả thù ư?\N- Đúng vậy.
Dialogue: 0,0:11:11.88,0:11:15.84,Default,,0,0,0,,Cậu không còn là cậu. Cậu đi quá xa rồi.\NSao lại nhắm vào người vô tội?
Dialogue: 0,0:11:15.93,0:11:19.85,Default,,0,0,0,,Chúng là người của Arasaka.\NTôi phải lôi kẻ đang trốn ra ngoài.
Dialogue: 0,0:11:19.93,0:11:23.35,Default,,0,0,0,,Cậu sẽ giết hết người của Arasaka ư?\NChỉ vì họ là Arasaka?
Dialogue: 0,0:11:23.43,0:11:25.52,Default,,0,0,0,,Cậu đến đây làm gì?
Dialogue: 0,0:11:25.60,0:11:27.85,Default,,0,0,0,,Để phàn nàn à? Vậy thì về đi.
Dialogue: 0,0:11:27.94,0:11:30.23,Default,,0,0,0,,{\an8}Không! Tôi đến để ngăn cậu lại.
Dialogue: 0,0:11:30.90,0:11:31.73,Default,,0,0,0,,Sao?
Dialogue: 0,0:11:33.23,0:11:36.27,Default,,0,0,0,,Chết tiệt! Cậu thật vô lý!
Dialogue: 0,0:11:36.36,0:11:39.41,Default,,0,0,0,,Cậu cũng đang làm mấy trò vớ vẩn đó thôi!
Dialogue: 0,0:11:54.76,0:11:58.26,Default,,0,0,0,,Được rồi, Omi. Nhưng cậu biết gì không?
Dialogue: 0,0:11:59.18,0:12:01.77,Default,,0,0,0,,Vậy tôi phải làm gì đây?
Dialogue: 0,0:12:03.89,0:12:07.52,Default,,0,0,0,,Tôi phải làm gì đây? Cậu nói đi.
Dialogue: 0,0:12:07.60,0:12:09.85,Default,,0,0,0,,Khoan đã, D! Bình tĩnh đi.
Dialogue: 0,0:12:09.94,0:12:11.78,Default,,0,0,0,,- Tránh ra, Roman.\N- Không!
Dialogue: 0,0:12:11.86,0:12:13.78,Default,,0,0,0,,- Nhóc con…\N- Dừng lại đi, D.
Dialogue: 0,0:12:13.86,0:12:15.40,Default,,0,0,0,,Quên chuyện trả thù đi…
Dialogue: 0,0:12:15.48,0:12:17.07,Default,,0,0,0,,Cậu bị sao vậy?
Dialogue: 0,0:12:17.15,0:12:21.28,Default,,0,0,0,,Cô ấy nói đúng. Anh không phải là anh.\NCon người thật của anh…
Dialogue: 0,0:12:21.37,0:12:22.54,Default,,0,0,0,,{\an8}Im đi!
Dialogue: 0,0:12:22.62,0:12:26.88,Default,,0,0,0,,{\an8}Con người thật của tôi ư?\NTôi từng là ai chứ? Cậu bị sao vậy?
Dialogue: 0,0:12:35.50,0:12:36.54,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:12:46.68,0:12:51.14,Default,,0,0,0,,Ừm, cô ở cùng tộc với D nhỉ?
Dialogue: 0,0:12:54.52,0:12:56.02,Default,,0,0,0,,Còn cậu?
Dialogue: 0,0:12:57.99,0:12:59.95,Default,,0,0,0,,Tôi không thấy ấn tượng đâu.
Dialogue: 0,0:13:00.03,0:13:00.95,Default,,0,0,0,,Sao?
Dialogue: 0,0:13:01.03,0:13:01.91,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:13:01.99,0:13:06.83,Default,,0,0,0,,Cảm giác thật sai trái.\NMột đứa trẻ ở tuổi cậu góp mặt vào vụ này.
Dialogue: 0,0:13:08.04,0:13:09.29,Default,,0,0,0,,Sao cậu không rời đi?
Dialogue: 0,0:13:09.37,0:13:12.46,Default,,0,0,0,,Cậu có vẻ chán ngấy\Ncách làm của cậu ấy mà.
Dialogue: 0,0:13:13.83,0:13:16.79,Default,,0,0,0,,Cách đây không lâu, tôi đã thấy D cười.
Dialogue: 0,0:13:16.88,0:13:17.96,Default,,0,0,0,,Cười sao?
Dialogue: 0,0:13:18.05,0:13:20.89,Default,,0,0,0,,Lần đầu dùng sức mạnh đó,
Dialogue: 0,0:13:20.97,0:13:24.64,Default,,0,0,0,,anh ấy đã cười\Nnhư đang có khoảng thời gian rất tuyệt.
Dialogue: 0,0:13:25.39,0:13:27.98,Default,,0,0,0,,Cách anh ấy sử dụng sức mạnh\Nhoàn toàn khác.
Dialogue: 0,0:13:28.72,0:13:30.76,Default,,0,0,0,,Lúc đó tôi đã nghĩ…
Dialogue: 0,0:13:30.85,0:13:33.69,Default,,0,0,0,,tôi chưa từng thấy biểu cảm đó\Ntrên mặt anh ấy.
Dialogue: 0,0:13:34.19,0:13:36.53,Default,,0,0,0,,Có lẽ đây mới là D thật sự.
Dialogue: 0,0:13:37.02,0:13:37.98,Default,,0,0,0,,Tôi…
Dialogue: 0,0:13:38.07,0:13:41.70,Default,,0,0,0,,Tôi muốn ghi lại\Nhình ảnh D của hôm đó lần nữa.
Dialogue: 0,0:13:42.95,0:13:45.24,Default,,0,0,0,,{\an8}Tôi hiểu rồi.
Dialogue: 0,0:13:45.87,0:13:50.25,Default,,0,0,0,,{\an8}- Cậu ấy cười rất sảng khoái nhỉ?\N- Cảm ơn quý khách đã đợi.
Dialogue: 0,0:13:51.62,0:13:54.25,Default,,0,0,0,,Từ đó đến giờ, cô chưa gặp lại D à?
Dialogue: 0,0:13:54.33,0:13:56.50,Default,,0,0,0,,Ừ. Từ ngày đó thì chưa.
Dialogue: 0,0:13:57.21,0:14:01.01,Default,,0,0,0,,Có thể cho tôi hỏi\Nchuyện gì đã xảy ra không?
Dialogue: 0,0:14:02.17,0:14:06.38,Default,,0,0,0,,Cậu dừng quay được không?\NTôi không thích lên hình.
Dialogue: 0,0:14:06.47,0:14:08.26,Default,,0,0,0,,Xin lỗi. Thành thói quen rồi.
Dialogue: 0,0:14:09.10,0:14:10.69,Default,,0,0,0,,Cậu ấy chưa kể à?
Dialogue: 0,0:14:10.77,0:14:12.15,Default,,0,0,0,,Vài điều mơ hồ thôi.
Dialogue: 0,0:14:12.64,0:14:15.77,Default,,0,0,0,,- Không có gì chi tiết.\N- Ra vậy.
Dialogue: 0,0:14:18.02,0:14:20.57,Default,,0,0,0,,Hôm đó cậu ấy cũng cười.
Dialogue: 0,0:14:21.07,0:14:24.28,Default,,0,0,0,,Cậu ấy và tôi đã trộm xe từ một nhà nghỉ.
Dialogue: 0,0:14:25.20,0:14:27.95,Default,,0,0,0,,{\an8}Cậu ấy cười như tên ngốc ấy.
Dialogue: 0,0:14:28.45,0:14:30.83,Default,,0,0,0,,{\an8}Trên đường về cậu ấy cũng vậy.
Dialogue: 0,0:14:31.79,0:14:35.88,Default,,0,0,0,,{\i1}Cậu ấy vẫn cười\Nkhi khói bắt đầu xuất hiện trong tầm mắt.{\i0}
Dialogue: 0,0:14:36.38,0:14:40.18,Default,,0,0,0,,{\i1}Ở sa mạc, ta có thể thấy khói\Ntừ cách xa hàng dặm.{\i0}
Dialogue: 0,0:14:41.21,0:14:44.01,Default,,0,0,0,,Rồi không nghi ngờ gì nữa,\Nnó đến từ phía trại.
Dialogue: 0,0:14:44.51,0:14:46.39,Default,,0,0,0,,Bọn tôi không cười nữa.
Dialogue: 0,0:14:46.47,0:14:48.06,Default,,0,0,0,,Cả hai đều im lặng.
Dialogue: 0,0:14:50.14,0:14:53.56,Default,,0,0,0,,{\i1}Tôi chợt nhận ra cậu ấy đã biến mất.{\i0}
Dialogue: 0,0:14:54.56,0:14:56.77,Default,,0,0,0,,{\an8}Rồi tôi không liên lạc được với cậu ấy.
Dialogue: 0,0:14:56.85,0:15:02.06,Default,,0,0,0,,{\an8}Tôi không biết cậu ấy còn sống không.\NTôi quá bận rộn chăm sóc bản thân.
Dialogue: 0,0:15:02.15,0:15:03.90,Default,,0,0,0,,{\an8}Tôi hỏi một câu được không?
Dialogue: 0,0:15:03.99,0:15:04.82,Default,,0,0,0,,{\an8}Gì vậy?
Dialogue: 0,0:15:05.53,0:15:07.37,Default,,0,0,0,,{\an8}Hai người là người yêu à?
Dialogue: 0,0:15:11.16,0:15:13.95,Default,,0,0,0,,{\an8}Đợi chút, bọn tôi trông giống tình nhân ư?
Dialogue: 0,0:15:14.04,0:15:15.58,Default,,0,0,0,,{\an8}Sau cảnh lúc nãy à?
Dialogue: 0,0:15:16.58,0:15:19.79,Default,,0,0,0,,{\an8}Không, cũng có người như vậy mà…
Dialogue: 0,0:15:21.30,0:15:25.43,Default,,0,0,0,,{\an8}Buồn cười thật.\NBảo sao cậu có thể ở bên David.
Dialogue: 0,0:15:25.51,0:15:27.14,Default,,0,0,0,,{\an8}Hả? David?
Dialogue: 0,0:15:27.22,0:15:29.60,Default,,0,0,0,,{\an8}Ừ, đó là tên cậu ấy.
Dialogue: 0,0:15:30.10,0:15:33.06,Default,,0,0,0,,{\an8}Đúng rồi, giờ cậu ấy tên là D nhỉ?
Dialogue: 0,0:15:33.72,0:15:38.39,Default,,0,0,0,,{\an8}- Vậy cậu sẽ gọi cậu ấy là David chứ?\N- Ý cô là D à?
Dialogue: 0,0:15:39.40,0:15:43.15,Default,,0,0,0,,{\an8}Với tôi, anh ấy là D,\Nnên tôi sẽ không gọi anh ấy như vậy.
Dialogue: 0,0:15:43.78,0:15:44.82,Default,,0,0,0,,{\an8}Ra vậy.
Dialogue: 0,0:16:07.05,0:16:11.18,Default,,0,0,0,,Avida? Kiril ra ngoài rồi.
Dialogue: 0,0:16:11.26,0:16:14.31,Default,,0,0,0,,Tôi đến đưa thứ chồng tôi bỏ quên thôi.
Dialogue: 0,0:16:19.52,0:16:23.02,Default,,0,0,0,,Cắm cái này vào,\Ncô có thể trích xuất dữ liệu ta cần.
Dialogue: 0,0:16:23.52,0:16:27.07,Default,,0,0,0,,Một đồng đội cũ đưa nó cho tôi,\Nnhưng nó vẫn còn hoạt động.
Dialogue: 0,0:16:28.57,0:16:30.24,Default,,0,0,0,,ĐANG TẢI XUỐNG
Dialogue: 0,0:16:30.32,0:16:31.53,Default,,0,0,0,,TẢI XUỐNG HOÀN TẤT
Dialogue: 0,0:16:31.62,0:16:32.62,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:16:35.12,0:16:35.95,Default,,0,0,0,,Avida?
Dialogue: 0,0:16:37.16,0:16:38.45,Default,,0,0,0,,Sao em lại đến đây?
Dialogue: 0,0:16:39.12,0:16:40.96,Default,,0,0,0,,{\an8}Em cần nói chuyện với anh.
Dialogue: 0,0:16:41.04,0:16:43.46,Default,,0,0,0,,{\an8}Họ bảo em có thể đợi bên trong.
Dialogue: 0,0:16:43.54,0:16:45.75,Default,,0,0,0,,{\an8}Lẽ ra em nên báo trước với anh.
Dialogue: 0,0:16:46.26,0:16:47.97,Default,,0,0,0,,{\an8}Có chuyện gì gấp à?
Dialogue: 0,0:16:48.67,0:16:53.01,Default,,0,0,0,,{\an8}- Anh nghe về Soulkiller rồi nhỉ?\N- Soulkiller?
Dialogue: 0,0:16:53.10,0:16:56.19,Default,,0,0,0,,{\an8}Dĩ nhiên là rồi,\Nnhưng sao tự dưng lại hỏi chuyện đó?
Dialogue: 0,0:16:56.27,0:16:59.48,Default,,0,0,0,,{\an8}Em nghĩ ta có thể cứu được Talia\Nbằng công nghệ đó.
Dialogue: 0,0:17:00.06,0:17:02.69,Default,,0,0,0,,{\an8}Ta có thể đưa linh hồn nó\Nsang một cơ thể khác.
Dialogue: 0,0:17:02.77,0:17:06.40,Default,,0,0,0,,{\an8}Không thể nào.\NTa có thể trích xuất cấu trúc của Talia,
Dialogue: 0,0:17:06.48,0:17:08.86,Default,,0,0,0,,{\an8}nhưng ta thiếu công nghệ\Nđưa nó vào trong cơ thể.
Dialogue: 0,0:17:08.94,0:17:11.99,Default,,0,0,0,,- Nhưng vẫn có khả năng mà?\N- Anh đã nói là không.
Dialogue: 0,0:17:12.07,0:17:16.70,Default,,0,0,0,,Bản thân Soulkiller\Nlà công nghệ độc quyền của Arasaka.
Dialogue: 0,0:17:16.79,0:17:18.50,Default,,0,0,0,,Không phải ai cũng dùng được.
Dialogue: 0,0:17:19.29,0:17:21.88,Default,,0,0,0,,{\an8}Kang Tao không có bản sao Soulkiller ư?
Dialogue: 0,0:17:22.67,0:17:23.88,Default,,0,0,0,,{\an8}Em nghe ở đâu vậy?
Dialogue: 0,0:17:23.96,0:17:27.38,Default,,0,0,0,,{\an8}Em chỉ nghĩ thôi.\NNhưng các anh có bản sao mà nhỉ?
Dialogue: 0,0:17:27.46,0:17:29.59,Default,,0,0,0,,{\an8}- Không, không có.\N- Thật chứ?
Dialogue: 0,0:17:30.09,0:17:34.34,Default,,0,0,0,,{\an8}Sao bọn anh có thể? Cả Arasaka\Ncũng đã từ bỏ việc dùng công nghệ này.
Dialogue: 0,0:17:34.85,0:17:35.77,Default,,0,0,0,,{\an8}Vậy à?
Dialogue: 0,0:17:35.85,0:17:37.39,Default,,0,0,0,,{\an8}Đúng vậy.
Dialogue: 0,0:17:38.14,0:17:41.31,Default,,0,0,0,,{\an8}- Em đến đây chỉ để hỏi thế thôi à?\N- "Chỉ"?
Dialogue: 0,0:17:41.39,0:17:44.06,Default,,0,0,0,,{\an8}Em nghĩ nó có thể cứu được Talia.
Dialogue: 0,0:17:44.15,0:17:45.44,Default,,0,0,0,,{\an8}Bình tĩnh nào.
Dialogue: 0,0:17:45.94,0:17:49.53,Default,,0,0,0,,{\an8}Không thì em chẳng khác gì\Nlúc Talia bị siêu thiết bị ám ảnh.
Dialogue: 0,0:17:50.11,0:17:53.20,Default,,0,0,0,,{\an8}Ta không thể cứu Talia\Nbằng ảo tưởng hay phép thuật.
Dialogue: 0,0:17:53.70,0:17:55.83,Default,,0,0,0,,{\an8}Trước hết, ta phải bình tĩnh.
Dialogue: 0,0:17:56.33,0:17:57.54,Default,,0,0,0,,{\an8}Ý anh là như anh ư?
Dialogue: 0,0:17:57.62,0:17:59.08,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:17:59.58,0:18:01.58,Default,,0,0,0,,Vâng, anh nói đúng.
Dialogue: 0,0:18:02.08,0:18:07.59,Default,,0,0,0,,- Em xin lỗi vì đã tự dưng đến đây.\N- Căng thẳng khiến em lu mờ lý trí rồi.
Dialogue: 0,0:18:07.67,0:18:10.13,Default,,0,0,0,,Về nhà nghỉ ngơi đi.
Dialogue: 0,0:18:10.21,0:18:11.04,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:18:15.72,0:18:16.55,Default,,0,0,0,,Avida.
Dialogue: 0,0:18:18.39,0:18:21.27,Default,,0,0,0,,Anh cũng hy vọng sẽ cứu được Talia.
Dialogue: 0,0:18:22.31,0:18:23.81,Default,,0,0,0,,Em hiểu mà nhỉ?
Dialogue: 0,0:18:25.69,0:18:26.53,Default,,0,0,0,,Vâng.
Dialogue: 0,0:18:39.49,0:18:43.08,Default,,0,0,0,,KHÔNG TÌM THẤY MỐI ĐE DỌA
Dialogue: 0,0:18:59.18,0:19:02.35,Default,,0,0,0,,ĐANG GỌI\NTALIA
Dialogue: 0,0:19:02.98,0:19:03.86,Default,,0,0,0,,Talia?
Dialogue: 0,0:19:03.93,0:19:05.18,Default,,0,0,0,,{\i1}Lâu rồi nhỉ?{\i0}
Dialogue: 0,0:19:05.27,0:19:09.52,Default,,0,0,0,,{\i1}- Chuyện gì vậy? Cô ổn chứ? Vẫn khoẻ chứ?\N- Rất khoẻ.{\i0}
Dialogue: 0,0:19:09.61,0:19:11.86,Default,,0,0,0,,{\i1}- Cậu ra ngoài một tí được không?\N- Hả?{\i0}
Dialogue: 0,0:19:11.94,0:19:14.44,Default,,0,0,0,,{\i1}Ta gặp nhau đi. Nhớ mang camera theo nhé.{\i0}
Dialogue: 0,0:19:20.70,0:19:22.12,Default,,0,0,0,,Tuyệt quá!
Dialogue: 0,0:19:35.13,0:19:36.42,Default,,0,0,0,,Đỉnh thật!
Dialogue: 0,0:19:36.51,0:19:39.14,Default,,0,0,0,,Không ngờ máy chiếu này vẫn còn hoạt động.
Dialogue: 0,0:19:39.22,0:19:40.22,Default,,0,0,0,,Cậu thích chứ?
Dialogue: 0,0:19:40.30,0:19:43.60,Default,,0,0,0,,Dĩ nhiên rồi!\NXem phim ở đây là mơ ước của tôi mà.
Dialogue: 0,0:19:43.68,0:19:44.72,Default,,0,0,0,,Vậy tốt quá.
Dialogue: 0,0:19:44.81,0:19:49.23,Default,,0,0,0,,- Nhưng phim này không hay cho lắm nhỉ?\N- Còn có {\i1}Bushido X{\i0} nữa.
Dialogue: 0,0:19:49.31,0:19:50.85,Default,,0,0,0,,Ồ, phim này hay này.
Dialogue: 0,0:19:52.40,0:19:53.36,Default,,0,0,0,,Đúng rồi.
Dialogue: 0,0:19:53.94,0:19:55.40,Default,,0,0,0,,Cô muốn cái nào?
Dialogue: 0,0:19:55.49,0:19:57.24,Default,,0,0,0,,Hả? Cậu có đủ cho cả hai kìa.
Dialogue: 0,0:19:57.32,0:19:59.57,Default,,0,0,0,,Vậy tôi sẽ lấy cái nhỏ.
Dialogue: 0,0:20:00.62,0:20:02.91,Default,,0,0,0,,Ồ, nó đang quay này.
Dialogue: 0,0:20:02.99,0:20:06.24,Default,,0,0,0,,- Này, nghe này…\N- Gì thế? À, bệnh viện à?
Dialogue: 0,0:20:06.33,0:20:08.50,Default,,0,0,0,,Tôi lẻn ra đấy.
Dialogue: 0,0:20:11.08,0:20:12.75,Default,,0,0,0,,Ôi trời.
Dialogue: 0,0:20:13.88,0:20:15.92,Default,,0,0,0,,{\an8}Sao? Cậu lo cho tôi đến thế à?
Dialogue: 0,0:20:16.01,0:20:17.72,Default,,0,0,0,,{\an8}Dĩ nhiên rồi.
Dialogue: 0,0:20:17.80,0:20:21.64,Default,,0,0,0,,{\an8}Ý tôi là, tôi mừng là cô vẫn khoẻ,\Nnhưng thật tình ấy.
Dialogue: 0,0:20:22.80,0:20:27.18,Default,,0,0,0,,{\an8}Nhưng cho đến gần đây,\Ntôi hoàn toàn không đi lại được.
Dialogue: 0,0:20:27.27,0:20:29.65,Default,,0,0,0,,{\an8}- Sao?\N- Này, cậu tin nổi không?
Dialogue: 0,0:20:32.77,0:20:36.65,Default,,0,0,0,,Chị ơi, chỉ số sinh tồn của chị\Nkhông phải dạng vừa đâu.
Dialogue: 0,0:20:37.53,0:20:42.29,Default,,0,0,0,,Chị chỉ em nhé.\NEm muốn là người phụ nữ mạnh mẽ như chị.
Dialogue: 0,0:20:42.78,0:20:45.03,Default,,0,0,0,,Gì vậy, đồ kỳ quặc này?
Dialogue: 0,0:20:45.74,0:20:46.78,Default,,0,0,0,,Ôi!
Dialogue: 0,0:20:49.41,0:20:52.62,Default,,0,0,0,,Nghe này. Tôi muốn xin lỗi cô, Talia.
Dialogue: 0,0:20:52.71,0:20:53.67,Default,,0,0,0,,Xin lỗi tôi?
Dialogue: 0,0:20:54.59,0:20:58.18,Default,,0,0,0,,Cô phải nhập viện\Nvì con chip D cắm vào mà.
Dialogue: 0,0:20:58.26,0:21:00.89,Default,,0,0,0,,- À…\N- Tôi xin lỗi. Thật đấy.
Dialogue: 0,0:21:00.97,0:21:04.43,Default,,0,0,0,,{\an8}Sao cậu lại xin lỗi? Có phải cậu làm đâu.
Dialogue: 0,0:21:05.18,0:21:06.93,Default,,0,0,0,,Không phải, nhưng…
Dialogue: 0,0:21:07.02,0:21:10.44,Default,,0,0,0,,{\an8}Tôi cũng không thành ra thế này\Nchỉ vì con chip.
Dialogue: 0,0:21:10.52,0:21:13.48,Default,,0,0,0,,{\an8}Cuối cùng, tôi…
Dialogue: 0,0:21:13.56,0:21:14.69,Default,,0,0,0,,{\an8}Sao chứ?
Dialogue: 0,0:21:16.73,0:21:20.53,Default,,0,0,0,,Nếu phải xin lỗi,\Ntôi mới là người nợ cậu lời xin lỗi.
Dialogue: 0,0:21:20.61,0:21:21.44,Default,,0,0,0,,Nợ tôi sao?
Dialogue: 0,0:21:21.53,0:21:23.45,Default,,0,0,0,,Chắc cậu khó chịu lắm nhỉ?
Dialogue: 0,0:21:23.53,0:21:25.53,Default,,0,0,0,,Khi bị giới thiệu với ông già đó.
Dialogue: 0,0:21:25.62,0:21:28.21,Default,,0,0,0,,Giờ nói cũng muộn rồi. Ngay cả hôm nay…
Dialogue: 0,0:21:30.33,0:21:32.46,Default,,0,0,0,,Cậu hiền thật đấy, Roman.
Dialogue: 0,0:21:33.29,0:21:34.96,Default,,0,0,0,,Không hẳn đâu.
Dialogue: 0,0:21:36.30,0:21:40.22,Default,,0,0,0,,Ông già đó nói:\N"Tôi dám cá cháu còn chẳng có bạn trai".
Dialogue: 0,0:21:40.30,0:21:43.72,Default,,0,0,0,,{\an8}Chẳng phải rất tệ ư?\NTôi đau ốm suốt. Làm gì có thời gian.
Dialogue: 0,0:21:44.22,0:21:46.26,Default,,0,0,0,,{\an8}Nghĩ một chút là đoán ra được.
Dialogue: 0,0:21:46.35,0:21:49.15,Default,,0,0,0,,{\an8}Nhưng không phải hơi quá sao?
Dialogue: 0,0:21:49.22,0:21:50.10,Default,,0,0,0,,{\an8}Hơi quá à?
Dialogue: 0,0:21:50.18,0:21:54.48,Default,,0,0,0,,{\an8}Tôi là bạn trai cô? Ông ấy cũng cười mà.
Dialogue: 0,0:21:54.56,0:21:55.64,Default,,0,0,0,,{\an8}Không quá đâu.
Dialogue: 0,0:21:55.73,0:21:57.86,Default,,0,0,0,,{\an8}- Hơn nữa, tôi thích mà.\N- Gì cơ?
Dialogue: 0,0:21:58.57,0:22:00.70,Default,,0,0,0,,{\an8}Video của cậu, Roman.
Dialogue: 0,0:22:00.78,0:22:01.61,Default,,0,0,0,,{\an8}Ồ.
Dialogue: 0,0:22:02.53,0:22:05.37,Default,,0,0,0,,{\an8}Nhưng cậu thích tôi đúng không, Roman?
Dialogue: 0,0:22:05.45,0:22:07.49,Default,,0,0,0,,Hả? Chuyện đó…
Dialogue: 0,0:22:09.66,0:22:11.20,Default,,0,0,0,,{\an8}Cậu không thích tôi à?
Dialogue: 0,0:22:11.87,0:22:15.75,Default,,0,0,0,,{\an8}Dù không thích tôi,\Ncậu vẫn muốn giúp tôi, đúng không?
Dialogue: 0,0:22:15.83,0:22:17.21,Default,,0,0,0,,{\an8}Hả? Chuyện đó…
Dialogue: 0,0:22:19.59,0:22:22.72,Default,,0,0,0,,{\an8}- Vậy đưa tôi đến chỗ D đi.\N- Sao tự dưng vậy?
Dialogue: 0,0:22:22.80,0:22:23.84,Default,,0,0,0,,Không được à?
Dialogue: 0,0:22:23.93,0:22:26.60,Default,,0,0,0,,- Không phải không được, nhưng…\N- Nhưng?
Dialogue: 0,0:22:27.10,0:22:30.85,Default,,0,0,0,,Các video đang lan truyền…\Nlà anh ta đúng không?
Dialogue: 0,0:22:30.93,0:22:33.85,Default,,0,0,0,,{\an8}Và cậu là người quay phim. Tôi nói sai à?
Dialogue: 0,0:22:33.94,0:22:35.48,Default,,0,0,0,,{\an8}Đúng vậy, nhưng…
Dialogue: 0,0:22:35.56,0:22:39.73,Default,,0,0,0,,- Có lý do để cậu không muốn tôi gặp D à?\N- Sao cô muốn gặp anh ấy?
Dialogue: 0,0:22:40.23,0:22:42.98,Default,,0,0,0,,Anh ấy khiến cô ốm nặng vậy mà.
Dialogue: 0,0:22:43.90,0:22:45.11,Default,,0,0,0,,Chuyện đó…
Dialogue: 0,0:22:47.66,0:22:48.75,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:22:49.33,0:22:50.16,Default,,0,0,0,,Talia?
Dialogue: 0,0:22:50.24,0:22:52.62,Default,,0,0,0,,Xin lỗi, tôi phải đi đây.
Dialogue: 0,0:22:52.70,0:22:54.66,Default,,0,0,0,,Có chuyện gì thế? Còn D thì sao?
Dialogue: 0,0:22:55.17,0:22:58.26,Default,,0,0,0,,Tạm quên anh ta đi. Tôi sẽ gọi sau.
Dialogue: 0,0:22:58.34,0:23:00.13,Default,,0,0,0,,Tôi phải đi gặp một người bạn.
Dialogue: 0,0:23:01.80,0:23:04.01,Default,,0,0,0,,Cho tôi mượn camera của cậu nhé?
Dialogue: 0,0:23:04.09,0:23:05.38,Default,,0,0,0,,Hả? Ừ, nhưng…
Dialogue: 0,0:23:06.26,0:23:07.22,Default,,0,0,0,,Gặp sau nhé.
Dialogue: 0,0:23:13.23,0:23:15.69,Default,,0,0,0,,Sao tự dưng lại thế? Con chip thì sao?
Dialogue: 0,0:23:15.77,0:23:19.15,Default,,0,0,0,,{\an8}Cậu ấy có lẽ sẽ làm rất nhiều thứ vì cô.
Dialogue: 0,0:23:19.23,0:23:22.19,Default,,0,0,0,,Thậm chí có thể sẽ rút con chip ra cho cô.
Dialogue: 0,0:23:22.28,0:23:24.57,Default,,0,0,0,,Tuyệt, tôi nên giải thích với cậu ấy…
Dialogue: 0,0:23:24.65,0:23:26.78,Default,,0,0,0,,Cô nghĩ cậu ấy sẽ bình an vô sự à?
Dialogue: 0,0:23:28.62,0:23:29.91,Default,,0,0,0,,{\an8}Cả con chip nữa.
Dialogue: 0,0:23:29.99,0:23:32.87,Default,,0,0,0,,{\an8}Nếu nó bị mất hoặc rơi vào tay kẻ xấu,
Dialogue: 0,0:23:32.95,0:23:35.16,Default,,0,0,0,,{\an8}mọi thứ sẽ kết thúc.
Dialogue: 0,0:23:35.25,0:23:38.42,Default,,0,0,0,,{\an8}Kiểu rơi vào tay một tập đoàn\Nvà bị phân tích ấy à?
Dialogue: 0,0:23:38.50,0:23:43.92,Default,,0,0,0,,{\an8}Ừ, và tùy thuộc vào phân tích,\Nai biết chuyện gì sẽ xảy ra với chúng ta?
Dialogue: 0,0:23:44.01,0:23:46.72,Default,,0,0,0,,Tình hình rất bất ổn, nhưng…
Dialogue: 0,0:23:46.80,0:23:51.43,Default,,0,0,0,,Việc nó đang nằm trong người cậu ấy\Nlà thời cơ tốt cho chúng ta.
Dialogue: 0,0:23:51.51,0:23:53.97,Default,,0,0,0,,Ta phải thận trọng.
Dialogue: 0,0:23:54.06,0:23:56.44,Default,,0,0,0,,Anh ta rất liều lĩnh.
Dialogue: 0,0:23:57.69,0:24:01.69,Default,,0,0,0,,Vậy là Kang Tao\Nthật sự sở hữu bản sao của Soulkiller.
Dialogue: 0,0:24:01.77,0:24:06.11,Default,,0,0,0,,Dường như họ đã bí mật có được nó\Nnhờ thông đồng với ai đó trong Arasaka.
Dialogue: 0,0:24:06.61,0:24:08.90,Default,,0,0,0,,Dĩ nhiên, không có gì là chính thức.
Dialogue: 0,0:24:09.57,0:24:11.66,Default,,0,0,0,,Anh xem cái này đi.
Dialogue: 0,0:24:14.95,0:24:15.95,Default,,0,0,0,,Đây là…
Dialogue: 0,0:24:16.04,0:24:18.17,Default,,0,0,0,,Các cơ thể bị đóng băng.
Dialogue: 0,0:24:18.71,0:24:22.34,Default,,0,0,0,,Được bảo quản để làm vật chủ mới\Ncho các linh hồn bị Soulkiller trích xuất.
Dialogue: 0,0:24:22.42,0:24:23.38,Default,,0,0,0,,Vậy…
Dialogue: 0,0:24:23.46,0:24:26.34,Default,,0,0,0,,Phải, Kang Tao sở hữu cả hai công nghệ.
Dialogue: 0,0:24:26.42,0:24:31.09,Default,,0,0,0,,{\an8}Nhưng có vẻ họ vẫn đang thử nghiệm\Nviệc đưa cấu trúc vào lại cơ thể.
Dialogue: 0,0:24:31.18,0:24:33.27,Default,,0,0,0,,{\an8}Avida, cô chắc chắn chứ?
Dialogue: 0,0:24:33.76,0:24:36.10,Default,,0,0,0,,{\an8}Cô sẽ chống lại công ty của chồng mình.
Dialogue: 0,0:24:36.18,0:24:39.10,Default,,0,0,0,,Tôi biết, nhưng tôi quyết định rồi.
Dialogue: 0,0:24:39.19,0:24:43.28,Default,,0,0,0,,{\an8}Nếu làm thế này, cô và Talia\Nsẽ không còn chỗ đứng ở Thành phố Đêm.
Dialogue: 0,0:24:43.77,0:24:45.61,Default,,0,0,0,,{\an8}Sao giờ lại nói chuyện này?
Dialogue: 0,0:24:46.53,0:24:50.99,Default,,0,0,0,,Hơn nữa, có vẻ như Soulkiller\Nsẽ sớm được chuyển đến một địa điểm khác.
Dialogue: 0,0:24:51.07,0:24:52.32,Default,,0,0,0,,Hết thời gian rồi.
Dialogue: 0,0:24:53.87,0:24:56.33,Default,,0,0,0,,Ta không thể đưa Talia đến đây.
Dialogue: 0,0:24:56.41,0:24:58.37,Default,,0,0,0,,Nên ta phải tự làm việc này.
Dialogue: 0,0:24:59.00,0:25:03.09,Default,,0,0,0,,Ta sẽ sao chép Soulkiller\Nvà lấy cơ thể mới cho Talia.
Dialogue: 0,0:25:04.96,0:25:06.38,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:25:08.88,0:25:09.71,Default,,0,0,0,,{\an8}Làm thế thôi.
Dialogue: 0,0:25:12.72,0:25:18.68,Default,,0,0,0,,CẢNH BÁO BẢO MẬT\NPHÁT HIỆN TẢI XUỐNG TRÁI PHÉP
Dialogue: 0,0:26:50.90,0:26:53.90,Default,,0,0,0,,Biên dịch: Khanh Tran
