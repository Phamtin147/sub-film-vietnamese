Dialogue: 0,0:00:11.26,0:00:14.43,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:00:14.51,0:00:17.56,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:01:41.52,0:01:42.35,Default,,0,0,0,,{\an8}D?
Dialogue: 0,0:01:42.89,0:01:44.93,Default,,0,0,0,,{\an8}Anh về lúc nào vậy?
Dialogue: 0,0:01:45.44,0:01:46.44,Default,,0,0,0,,{\an8}A lô?
Dialogue: 0,0:01:48.82,0:01:49.82,Default,,0,0,0,,{\an8}Đừng chết…
Dialogue: 0,0:01:52.45,0:01:53.49,Default,,0,0,0,,{\an8}Sáng rồi à?
Dialogue: 0,0:01:56.53,0:01:58.82,Default,,0,0,0,,{\an8}Tôi… không nằm mơ.
Dialogue: 0,0:01:59.41,0:02:01.45,Default,,0,0,0,,{\an8}Tôi không nằm mơ! Roman!
Dialogue: 0,0:02:01.54,0:02:03.25,Default,,0,0,0,,{\an8}D! Anh ổn chứ?
Dialogue: 0,0:02:05.67,0:02:06.63,Default,,0,0,0,,{\an8}Hôi quá.
Dialogue: 0,0:02:10.71,0:02:12.96,Default,,0,0,0,,Roman, cao hơn tí đi. Ngay đầu tôi ấy.
Dialogue: 0,0:02:13.84,0:02:15.55,Default,,0,0,0,,Lần cuối anh tắm là lúc nào?
Dialogue: 0,0:02:15.64,0:02:17.98,Default,,0,0,0,,Hả? Để tôi nghĩ xem.
Dialogue: 0,0:02:19.47,0:02:20.30,Default,,0,0,0,,Thôi bỏ đi.
Dialogue: 0,0:02:23.31,0:02:26.23,Default,,0,0,0,,Lâu rồi mới có buổi sáng tuyệt thế này.
Dialogue: 0,0:02:26.98,0:02:30.11,Default,,0,0,0,,Chuyện hôm qua hẳn là do vi mạch đó nhỉ?
Dialogue: 0,0:02:30.61,0:02:33.24,Default,,0,0,0,,- Chắc vậy.\N- Anh còn làm được thế không?
Dialogue: 0,0:02:34.11,0:02:34.99,Default,,0,0,0,,Không chắc.
Dialogue: 0,0:02:40.03,0:02:43.58,Default,,0,0,0,,{\i1}Đi.{\i0}
Dialogue: 0,0:02:45.21,0:02:46.75,Default,,0,0,0,,Cậu có quay đúng không?
Dialogue: 0,0:02:50.25,0:02:52.67,Default,,0,0,0,,Tôi đã làm thế thật à?
Dialogue: 0,0:02:52.76,0:02:54.51,Default,,0,0,0,,Không phải anh thì ai?
Dialogue: 0,0:02:55.68,0:02:56.81,Default,,0,0,0,,Cô gái đó…
Dialogue: 0,0:02:57.76,0:02:58.60,Default,,0,0,0,,Cô gái nào?
Dialogue: 0,0:02:58.68,0:03:01.31,Default,,0,0,0,,Thì cô gái đi suốt với tôi, màu đỏ rực…
Dialogue: 0,0:03:01.39,0:03:03.81,Default,,0,0,0,,"Đỏ rực"? Và là một cô gái nhỉ?
Dialogue: 0,0:03:03.89,0:03:05.60,Default,,0,0,0,,Ừ. Một cô gái màu đỏ rực.
Dialogue: 0,0:03:05.69,0:03:07.90,Default,,0,0,0,,Đỏ thế nào? Quần áo? Nước da?
Dialogue: 0,0:03:08.61,0:03:09.65,Default,,0,0,0,,Toàn bộ!
Dialogue: 0,0:03:09.73,0:03:11.15,Default,,0,0,0,,Toàn bộ sao?
Dialogue: 0,0:03:11.23,0:03:13.77,Default,,0,0,0,,{\an8}Còn có thứ gì đó như tia lửa nữa.
Dialogue: 0,0:03:14.28,0:03:17.45,Default,,0,0,0,,{\an8}Một cô gái đỏ toàn thân\Nvà có thứ gì đó như tia lửa ư?
Dialogue: 0,0:03:18.32,0:03:19.49,Default,,0,0,0,,{\an8}Ừ.
Dialogue: 0,0:03:19.99,0:03:22.91,Default,,0,0,0,,{\an8}Tôi không thấy.\NNhưng camera bắt được vài tia lửa.
Dialogue: 0,0:03:24.00,0:03:25.21,Default,,0,0,0,,{\an8}Anh bị ảo giác à?
Dialogue: 0,0:03:25.29,0:03:28.38,Default,,0,0,0,,{\an8}Không! Cô ta cố chiếm lấy cơ thể tôi!
Dialogue: 0,0:03:28.88,0:03:31.88,Default,,0,0,0,,Vi mạch đó\Nkhông mang virus thần kinh đấy chứ?
Dialogue: 0,0:03:33.00,0:03:34.21,Default,,0,0,0,,Có lẽ nên rút ra đi.
Dialogue: 0,0:03:34.30,0:03:37.30,Default,,0,0,0,,Virus nào lại khiến tôi\Nlàm được mấy trò này?
Dialogue: 0,0:03:37.38,0:03:38.88,Default,,0,0,0,,Thường là ngược lại kìa!
Dialogue: 0,0:03:38.97,0:03:43.31,Default,,0,0,0,,{\an8}- Chắc vậy.\N- Đó là một thứ khác, một thứ tốt đẹp.
Dialogue: 0,0:03:43.85,0:03:46.90,Default,,0,0,0,,{\an8}- Cảm giác như quay lại thời bé vậy.\N- Thời bé ư?
Dialogue: 0,0:03:48.27,0:03:50.65,Default,,0,0,0,,- Ồ, đây này!\N- Ở đâu?
Dialogue: 0,0:03:50.73,0:03:54.86,Default,,0,0,0,,Tôi quay không được rõ cho lắm.\NNhìn mặt anh rất vui.
Dialogue: 0,0:03:55.65,0:03:56.53,Default,,0,0,0,,Mặt tôi sao?
Dialogue: 0,0:03:56.61,0:03:58.49,Default,,0,0,0,,Ừ. Anh đấy, D.
Dialogue: 0,0:04:01.74,0:04:03.41,Default,,0,0,0,,- D.\N- Sao?
Dialogue: 0,0:04:03.91,0:04:06.54,Default,,0,0,0,,- Rút vi mạch ra đi.\N- Không! Sao phải thế?
Dialogue: 0,0:04:06.62,0:04:08.04,Default,,0,0,0,,{\an8}Nó thật tệ hại!
Dialogue: 0,0:04:08.12,0:04:11.79,Default,,0,0,0,,{\an8}Anh nói nó đã cố chiếm đoạt anh mà.\NChắc chắn chẳng có gì tốt.
Dialogue: 0,0:04:11.88,0:04:16.26,Default,,0,0,0,,{\an8}- Cậu nói nhìn tôi rất vui mà.\N- Chuyện đó khác, chuyện này khác.
Dialogue: 0,0:04:19.55,0:04:23.30,Default,,0,0,0,,- Cô!\N- Đừng gọi tôi là "cô"!
Dialogue: 0,0:04:23.39,0:04:25.98,Default,,0,0,0,,Hãy gọi tôi là Capri!
Dialogue: 0,0:04:26.06,0:04:27.60,Default,,0,0,0,,Không, hay là "em" nhỉ?
Dialogue: 0,0:04:27.68,0:04:30.02,Default,,0,0,0,,Chúng tôi? Anh ấy, cô ấy, họ, chúng ta…
Dialogue: 0,0:04:30.10,0:04:31.23,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:04:31.81,0:04:35.19,Default,,0,0,0,,- Sao cũng được!\N- Cô ấy ở đây à?
Dialogue: 0,0:04:35.78,0:04:39.12,Default,,0,0,0,,Ồ! Là cậu bé hôm qua nhỉ? Chào cậu!
Dialogue: 0,0:04:39.20,0:04:40.49,Default,,0,0,0,,Cô ấy chào cậu đấy.
Dialogue: 0,0:04:40.99,0:04:42.49,Default,,0,0,0,,Ồ, chào cô.
Dialogue: 0,0:04:42.57,0:04:43.70,Default,,0,0,0,,Đừng khách sáo.
Dialogue: 0,0:04:43.78,0:04:45.57,Default,,0,0,0,,- Cậu nghe thấy chứ?\N- Không.
Dialogue: 0,0:04:45.66,0:04:47.62,Default,,0,0,0,,- Có nhìn thấy không?\N- Không.
Dialogue: 0,0:04:48.58,0:04:52.50,Default,,0,0,0,,Không ai nghe thấy\Nhay nhìn thấy tôi ngoài anh.
Dialogue: 0,0:04:52.58,0:04:54.58,Default,,0,0,0,,Cô là cái quái gì vậy?
Dialogue: 0,0:04:54.67,0:04:56.34,Default,,0,0,0,,Quan trọng gì chứ?
Dialogue: 0,0:04:56.42,0:04:58.80,Default,,0,0,0,,Thôi nào, ta làm bạn đi.
Dialogue: 0,0:04:59.30,0:05:00.68,Default,,0,0,0,,Đừng lại gần tôi!
Dialogue: 0,0:05:01.72,0:05:03.72,Default,,0,0,0,,Cô đã cố chiếm đoạt cơ thể tôi!
Dialogue: 0,0:05:03.80,0:05:06.47,Default,,0,0,0,,- Có gì không ổn à?\N- Đừng mặt dày thế chứ!
Dialogue: 0,0:05:06.56,0:05:10.23,Default,,0,0,0,,Tôi đã thử,\Nkhông có nghĩa là tôi làm thật.
Dialogue: 0,0:05:10.81,0:05:13.23,Default,,0,0,0,,- Tạm thời là thế.\N- Tạm thời ư?
Dialogue: 0,0:05:13.31,0:05:18.19,Default,,0,0,0,,Thôi nào, hôm qua tôi rất vui!\NAnh cũng vui mà, đúng không?
Dialogue: 0,0:05:18.28,0:05:19.24,Default,,0,0,0,,Còn lâu.
Dialogue: 0,0:05:19.32,0:05:21.61,Default,,0,0,0,,Không phải nói dối đâu.
Dialogue: 0,0:05:21.70,0:05:24.66,Default,,0,0,0,,Chúng ta đang tuy hai mà một.
Dialogue: 0,0:05:25.16,0:05:29.62,Default,,0,0,0,,Tôi thấy vui có nghĩa là anh cũng vui.
Dialogue: 0,0:05:29.70,0:05:31.74,Default,,0,0,0,,Cô là cái quái gì vậy?
Dialogue: 0,0:05:31.83,0:05:33.42,Default,,0,0,0,,Tôi á? Tôi là Capri.
Dialogue: 0,0:05:33.50,0:05:35.00,Default,,0,0,0,,Cô đã nói tên rồi.
Dialogue: 0,0:05:35.08,0:05:37.75,Default,,0,0,0,,Ồ, ý anh là tôi là cái quái gì à?
Dialogue: 0,0:05:37.84,0:05:40.93,Default,,0,0,0,,Đúng vậy. Cô là cái quái gì…
Dialogue: 0,0:05:41.01,0:05:43.80,Default,,0,0,0,,- Khoan! Đợi đã!\N- Hả?
Dialogue: 0,0:05:43.89,0:05:48.77,Default,,0,0,0,,Dù tôi không thấy cô ấy,\Nta có thể kết nối giọng của cô ấy không?
Dialogue: 0,0:06:00.99,0:06:04.33,Default,,0,0,0,,{\i1}Tôi là một cấu trúc nhân cách.{\i0}
Dialogue: 0,0:06:04.91,0:06:05.79,Default,,0,0,0,,"Cấu trúc"?
Dialogue: 0,0:06:06.28,0:06:08.95,Default,,0,0,0,,Linh hồn con người được số hóa.
Dialogue: 0,0:06:09.04,0:06:12.84,Default,,0,0,0,,{\an8}Rất nhiều linh hồn được tập hợp\Nđể tạo ra một thể là tôi.
Dialogue: 0,0:06:12.91,0:06:14.66,Default,,0,0,0,,{\an8}Vậy cô là AI à?
Dialogue: 0,0:06:15.17,0:06:16.13,Default,,0,0,0,,{\an8}Không hẳn.
Dialogue: 0,0:06:16.63,0:06:20.43,Default,,0,0,0,,{\an8}AI đã trở nên quá mạnh\Nvà vượt khỏi tầm kiểm soát của con người.
Dialogue: 0,0:06:20.51,0:06:22.47,Default,,0,0,0,,{\an8}Nhưng họ vẫn muốn có sức mạnh đó.
Dialogue: 0,0:06:22.55,0:06:26.97,Default,,0,0,0,,{\an8}Tôi không phải AI, nhưng được tạo ra\Nđể có sức mạnh gần như vậy.
Dialogue: 0,0:06:27.05,0:06:28.93,Default,,0,0,0,,{\an8}Tôi từng là con người.
Dialogue: 0,0:06:29.43,0:06:32.60,Default,,0,0,0,,{\an8}Cô là vũ khí? Được tạo ra từ con người ư?
Dialogue: 0,0:06:33.18,0:06:34.93,Default,,0,0,0,,{\i1}Gần như vậy.{\i0}
Dialogue: 0,0:06:35.44,0:06:38.61,Default,,0,0,0,,{\i1}Ít nhất họ đã thành công tạo ra\Nmột thứ hùng mạnh.{\i0}
Dialogue: 0,0:06:38.69,0:06:42.36,Default,,0,0,0,,Nhưng lần này,\Ntôi không tìm được vật chứa cho mình.
Dialogue: 0,0:06:42.44,0:06:44.53,Default,,0,0,0,,Cô cần cơ thể con người ư?
Dialogue: 0,0:06:44.61,0:06:49.12,Default,,0,0,0,,{\i1}Ừ! Tôi chỉ có thể sử dụng sức mạnh\Nkhi được cài đặt vào cơ thể con người.{\i0}
Dialogue: 0,0:06:49.83,0:06:52.17,Default,,0,0,0,,Và tôi tương thích với nó.
Dialogue: 0,0:06:52.25,0:06:53.46,Default,,0,0,0,,Hình như vậy.
Dialogue: 0,0:06:53.54,0:06:59.96,Default,,0,0,0,,Cô đã cố chiếm đoạt cơ thể tôi.\NNếu được, cô đã ghi đè lên tâm trí tôi.
Dialogue: 0,0:07:00.04,0:07:01.88,Default,,0,0,0,,Nhưng cài đặt đã thất bại.
Dialogue: 0,0:07:01.96,0:07:05.38,Default,,0,0,0,,Tôi không hiểu logic của nó,\Nnhưng cô còn ở trong vi mạch.
Dialogue: 0,0:07:05.47,0:07:08.77,Default,,0,0,0,,Nếu tôi rút nó ra,\Ncô sẽ bị hút lại vào lồng à?
Dialogue: 0,0:07:10.64,0:07:11.52,Default,,0,0,0,,- Thử đi.\N- Hả?
Dialogue: 0,0:07:11.60,0:07:14.02,Default,,0,0,0,,Tôi sẽ để cô cùng sống trong cơ thể tôi.
Dialogue: 0,0:07:14.10,0:07:17.52,Default,,0,0,0,,Đổi lại, tôi cũng được dùng\Nsức mạnh của cô.
Dialogue: 0,0:07:17.60,0:07:19.60,Default,,0,0,0,,Cô làm được rất nhiều thứ mà.
Dialogue: 0,0:07:24.65,0:07:26.03,Default,,0,0,0,,{\an8}{\i1}Không nhầm đâu.{\i0}
Dialogue: 0,0:07:26.11,0:07:28.57,Default,,0,0,0,,{\an8}Việc tiếp tục sử dụng siêu thiết bị
Dialogue: 0,0:07:28.66,0:07:32.25,Default,,0,0,0,,{\an8}rất có thể sẽ biến con gái ông\Nthành siêu cuồng nhân.
Dialogue: 0,0:07:32.74,0:07:36.74,Default,,0,0,0,,{\an8}Chúng tôi có cơ sở tin rằng\NTalia có sức chịu đựng đặc biệt.
Dialogue: 0,0:07:36.83,0:07:40.75,Default,,0,0,0,,{\an8}Việc cho đến giờ cô ấy vẫn ổn định\Nđã là một điều đặc biệt.
Dialogue: 0,0:07:40.84,0:07:43.47,Default,,0,0,0,,{\an8}Mới vài hôm trước\Ncòn không thấy dấu hiệu mà.
Dialogue: 0,0:07:43.96,0:07:49.26,Default,,0,0,0,,{\an8}Thật ra, chứng siêu cuồng nhân\Nrất khó phát hiện ở giai đoạn đầu.
Dialogue: 0,0:07:49.34,0:07:52.43,Default,,0,0,0,,{\an8}Dữ liệu về vấn đề này\Nkhan hiếm đến tuyệt vọng.
Dialogue: 0,0:07:52.51,0:07:56.51,Default,,0,0,0,,Nhưng do gần đây\Ntriệu chứng của cô ấy rất nghiêm trọng,
Dialogue: 0,0:07:56.60,0:07:59.19,Default,,0,0,0,,nên chúng tôi đã thấy các dấu hiệu của nó.
Dialogue: 0,0:07:59.27,0:08:02.11,Default,,0,0,0,,Cô ấy là một mẫu vật quý giá đấy.
Dialogue: 0,0:08:02.61,0:08:04.24,Default,,0,0,0,,"Mẫu vật"?
Dialogue: 0,0:08:04.32,0:08:05.70,Default,,0,0,0,,- Sao?\N- Không có gì.
Dialogue: 0,0:08:06.32,0:08:08.78,Default,,0,0,0,,Xin hãy gửi cho tôi báo cáo đầy đủ.
Dialogue: 0,0:08:09.78,0:08:12.24,Default,,0,0,0,,Tôi muốn nghe ý kiến của các bác sĩ khác.
Dialogue: 0,0:08:12.33,0:08:14.00,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:08:15.08,0:08:18.21,Default,,0,0,0,,À này, sao cậu còn ở đây?
Dialogue: 0,0:08:18.75,0:08:20.59,Default,,0,0,0,,Hả? Giờ mới hỏi à?
Dialogue: 0,0:08:20.67,0:08:22.21,Default,,0,0,0,,Cậu không cần đi theo nữa.
Dialogue: 0,0:08:22.29,0:08:23.33,Default,,0,0,0,,Sao?
Dialogue: 0,0:08:23.42,0:08:28.22,Default,,0,0,0,,Anh lôi tôi đi khắp nơi\Nrồi bỏ tôi ngay khi tìm được bạn mới à?
Dialogue: 0,0:08:28.72,0:08:31.72,Default,,0,0,0,,Cậu muốn quay Maelstrom, đúng không?
Dialogue: 0,0:08:31.80,0:08:32.93,Default,,0,0,0,,Đó là công việc.
Dialogue: 0,0:08:33.68,0:08:35.93,Default,,0,0,0,,Giờ tôi muốn quay anh, D.
Dialogue: 0,0:08:36.02,0:08:37.65,Default,,0,0,0,,Tôi ư? Tại sao?
Dialogue: 0,0:08:38.14,0:08:40.31,Default,,0,0,0,,Tôi nghĩ sẽ quay được cảnh rất đẹp.
Dialogue: 0,0:08:40.39,0:08:42.06,Default,,0,0,0,,Sao cậu nghĩ vậy?
Dialogue: 0,0:08:42.81,0:08:45.94,Default,,0,0,0,,Tôi cũng không thể vào Arasaka\Nvới một đứa nhóc mà.
Dialogue: 0,0:08:46.03,0:08:48.28,Default,,0,0,0,,Anh còn không dám vào Tháp kìa.
Dialogue: 0,0:08:48.78,0:08:51.07,Default,,0,0,0,,Đồ láu cá. Trời ạ.
Dialogue: 0,0:08:51.78,0:08:54.57,Default,,0,0,0,,Nếu anh vào được, tôi cũng vào được.
Dialogue: 0,0:09:15.18,0:09:16.06,Default,,0,0,0,,{\i1}Lối nào?{\i0}
Dialogue: 0,0:09:17.14,0:09:18.02,Default,,0,0,0,,{\i1}Lối này.{\i0}
Dialogue: 0,0:09:23.48,0:09:25.94,Default,,0,0,0,,Cảm giác tàng hình là thế này à?
Dialogue: 0,0:09:26.86,0:09:29.07,Default,,0,0,0,,Cô khác biệt thật đấy.
Dialogue: 0,0:09:31.61,0:09:32.74,Default,,0,0,0,,Tuyệt lắm.
Dialogue: 0,0:09:35.32,0:09:38.74,Default,,0,0,0,,Cô ấy nói lúc này chỉ có một người\Nở Kho Lưu trữ Dữ liệu B.
Dialogue: 0,0:09:47.13,0:09:50.01,Default,,0,0,0,,Dừng lại! Đây là khu vực cấm.
Dialogue: 0,0:09:50.09,0:09:52.13,Default,,0,0,0,,Tôi có vài chuyện muốn hỏi.
Dialogue: 0,0:09:52.22,0:09:53.35,Default,,0,0,0,,Đừng có lố bịch.
Dialogue: 0,0:09:53.43,0:09:56.89,Default,,0,0,0,,Đây không phải nơi\Ncho người như bọn mày tùy tiện bước vào.
Dialogue: 0,0:09:56.97,0:09:58.60,Default,,0,0,0,,Mày đang làm gì vậy?
Dialogue: 0,0:09:58.68,0:09:59.81,Default,,0,0,0,,Quay phim.
Dialogue: 0,0:09:59.89,0:10:02.23,Default,,0,0,0,,Mày nghĩ đây là trò đùa à? Chẳng vui…
Dialogue: 0,0:10:02.31,0:10:03.39,Default,,0,0,0,,{\an8}Hai năm trước.
Dialogue: 0,0:10:03.48,0:10:08.40,Default,,0,0,0,,{\an8}Arasaka đã thuê Maelstrom\Ntấn công một băng của Nước Rắn.
Dialogue: 0,0:10:09.23,0:10:10.73,Default,,0,0,0,,{\an8}Ai là người giật dây?
Dialogue: 0,0:10:11.24,0:10:12.70,Default,,0,0,0,,Mày…
Dialogue: 0,0:10:13.20,0:10:14.66,Default,,0,0,0,,Ông biết tôi sao?
Dialogue: 0,0:10:14.74,0:10:16.83,Default,,0,0,0,,Tao không nói thế.
Dialogue: 0,0:10:18.03,0:10:20.45,Default,,0,0,0,,Tùy. Cho tôi xem hết các tập tin đi.
Dialogue: 0,0:10:20.54,0:10:21.71,Default,,0,0,0,,Tao từ chối.
Dialogue: 0,0:10:21.79,0:10:23.33,Default,,0,0,0,,Ông muốn bị bắn nát đầu à?
Dialogue: 0,0:10:23.41,0:10:26.46,Default,,0,0,0,,Làm đi. Nếu mày có gan.
Dialogue: 0,0:10:31.05,0:10:32.97,Default,,0,0,0,,Giao mớ tập tin đó ra đây!
Dialogue: 0,0:10:34.63,0:10:35.96,Default,,0,0,0,,Đúng như tao nghĩ.
Dialogue: 0,0:10:36.05,0:10:37.22,Default,,0,0,0,,Ông cười cái gì?
Dialogue: 0,0:10:37.30,0:10:42.47,Default,,0,0,0,,Tên trộm {\i1}netrunner{\i0} vặt vãnh.\NCòn không đủ can đảm để bóp cò.
Dialogue: 0,0:10:45.90,0:10:49.86,Default,,0,0,0,,- Giao ra đây!\N- Tao từ chối.
Dialogue: 0,0:10:50.98,0:10:52.57,Default,,0,0,0,,{\an8}Đến lượt tôi à?
Dialogue: 0,0:10:56.74,0:10:57.95,Default,,0,0,0,,Cô nói sớm chút đi.
Dialogue: 0,0:10:58.03,0:11:00.53,Default,,0,0,0,,Không thể nào. Mày…
Dialogue: 0,0:11:04.29,0:11:05.29,Default,,0,0,0,,Ngủ một giấc đi.
Dialogue: 0,0:11:05.83,0:11:09.29,Default,,0,0,0,,Nhẹ tay thôi!\NBiết đâu lại là khách của Đội Chấn thương.
Dialogue: 0,0:11:09.79,0:11:12.42,Default,,0,0,0,,Tôi nhẹ tay rồi. Hắn sẽ tỉnh…
Dialogue: 0,0:11:16.34,0:11:19.26,Default,,0,0,0,,- Đóng ngay đi.\N- Hả? Được thôi.
Dialogue: 0,0:11:21.18,0:11:23.18,Default,,0,0,0,,{\an8}Danh sách mấy kẻ có liên quan đâu?
Dialogue: 0,0:11:23.27,0:11:24.73,Default,,0,0,0,,{\an8}- Không có.\N- Không sao?
Dialogue: 0,0:11:25.23,0:11:27.98,Default,,0,0,0,,{\an8}- Vì nó chưa từng tồn tại.\N- Vậy có gì không?
Dialogue: 0,0:11:28.48,0:11:33.07,Default,,0,0,0,,{\an8}- Có tập tin nào có vẻ liên quan không?\N- Những thứ có vẻ hấp dẫn đều bị xóa.
Dialogue: 0,0:11:33.15,0:11:36.11,Default,,0,0,0,,{\an8}- Họ sắp chuyển đi à?\N- Phải có gì đó chứ.
Dialogue: 0,0:11:36.20,0:11:40.29,Default,,0,0,0,,{\an8}Biết đâu còn vài thứ chỉ bị xóa đại khái\Nmà tôi có thể khôi phục…
Dialogue: 0,0:11:40.78,0:11:41.78,Default,,0,0,0,,{\an8}Làm vậy đi.
Dialogue: 0,0:11:41.87,0:11:43.04,Default,,0,0,0,,Rõ!
Dialogue: 0,0:11:47.50,0:11:49.63,Default,,0,0,0,,David Martinez.
Dialogue: 0,0:11:50.63,0:11:52.38,Default,,0,0,0,,Là anh ấy đúng không?
Dialogue: 0,0:11:53.92,0:11:55.26,Default,,0,0,0,,Chuyện này là sao?
Dialogue: 0,0:11:55.84,0:11:58.30,Default,,0,0,0,,David Martinez.
Dialogue: 0,0:11:58.38,0:12:00.88,Default,,0,0,0,,{\an8}Đồ rác rưởi {\i1}edgerunner{\i0}.
Dialogue: 0,0:12:01.39,0:12:06.60,Default,,0,0,0,,{\an8}Không ngờ Arasaka\Nlại bị lũ chuột đó chơi một vố.
Dialogue: 0,0:12:07.10,0:12:13.40,Default,,0,0,0,,{\an8}Giờ thì hạng như mày lại vào được\Ncùng một thằng nhóc. Cửa nẻo tơ hơ.
Dialogue: 0,0:12:13.90,0:12:16.57,Default,,0,0,0,,Ông biết tên kẻ cầm đầu, đúng không?
Dialogue: 0,0:12:16.65,0:12:17.69,Default,,0,0,0,,Chịu thôi.
Dialogue: 0,0:12:17.78,0:12:18.70,Default,,0,0,0,,Nhảm nhí!
Dialogue: 0,0:12:21.07,0:12:23.20,Default,,0,0,0,,Ông nhận ra tôi đúng không?
Dialogue: 0,0:12:23.78,0:12:26.37,Default,,0,0,0,,Làm ơn đi. Mày chẳng là ai cả.
Dialogue: 0,0:12:26.91,0:12:28.29,Default,,0,0,0,,"Chẳng là ai" sao?
Dialogue: 0,0:12:28.37,0:12:30.08,Default,,0,0,0,,Vậy sao ông có ảnh tôi?
Dialogue: 0,0:12:31.17,0:12:33.88,Default,,0,0,0,,{\an8}Giờ không quan trọng nữa.
Dialogue: 0,0:12:33.96,0:12:35.59,Default,,0,0,0,,{\an8}Dự án bị đóng rồi.
Dialogue: 0,0:12:35.67,0:12:38.09,Default,,0,0,0,,{\an8}"Dự án"? Dự án gì?
Dialogue: 0,0:12:38.59,0:12:40.30,Default,,0,0,0,,{\an8}Bỏ cuộc đi.
Dialogue: 0,0:12:40.38,0:12:42.42,Default,,0,0,0,,{\an8}Mày sẽ không bao giờ biết sự thật.
Dialogue: 0,0:12:42.51,0:12:43.68,Default,,0,0,0,,{\an8}Ông nói gì?
Dialogue: 0,0:12:44.18,0:12:46.85,Default,,0,0,0,,{\an8}Mày đến để trả thù, đúng chứ?
Dialogue: 0,0:12:50.31,0:12:51.35,Default,,0,0,0,,{\an8}Sao ông lại cười?
Dialogue: 0,0:12:51.44,0:12:53.03,Default,,0,0,0,,{\an8}Dĩ nhiên phải cười rồi.
Dialogue: 0,0:12:53.52,0:12:57.48,Default,,0,0,0,,{\an8}Mày sẽ không bao giờ trả thù được.
Dialogue: 0,0:12:57.57,0:12:58.78,Default,,0,0,0,,{\an8}Đừng có giỡn mặt!
Dialogue: 0,0:12:58.86,0:13:00.11,Default,,0,0,0,,{\an8}Đồ tép riu.
Dialogue: 0,0:13:00.20,0:13:04.75,Default,,0,0,0,,{\an8}Mày nghĩ mày có thể lật đổ Arasaka thật à?
Dialogue: 0,0:13:04.83,0:13:08.71,Default,,0,0,0,,{\an8}Ngay cả Martinez\Ncuối cùng cũng chỉ còn một đống thịt.
Dialogue: 0,0:13:08.79,0:13:10.75,Default,,0,0,0,,{\an8}Mày cũng vậy thôi.
Dialogue: 0,0:13:10.83,0:13:13.08,Default,,0,0,0,,{\an8}Hạng tép riu lúc chết cũng là tép riu.
Dialogue: 0,0:13:13.17,0:13:15.38,Default,,0,0,0,,Có lẽ thế. Nhưng tôi sẽ kéo ông theo.
Dialogue: 0,0:13:16.46,0:13:18.30,Default,,0,0,0,,{\an8}Thử làm thế đi.
Dialogue: 0,0:13:18.38,0:13:20.88,Default,,0,0,0,,{\an8}Dù sao sự nghiệp của tao cũng tiêu rồi…
Dialogue: 0,0:13:21.93,0:13:22.76,Default,,0,0,0,,D!
Dialogue: 0,0:13:22.84,0:13:24.30,Default,,0,0,0,,Đội Chấn Thương đến đấy!
Dialogue: 0,0:13:30.94,0:13:31.77,Default,,0,0,0,,{\an8}Hắn còn sống.
Dialogue: 0,0:13:32.60,0:13:35.60,Default,,0,0,0,,{\an8}Nhưng hẳn báo động đã được kích hoạt.\NTa chạy thôi.
Dialogue: 0,0:13:35.69,0:13:36.53,Default,,0,0,0,,{\an8}Chạy ư?
Dialogue: 0,0:13:36.61,0:13:40.41,Default,,0,0,0,,Anh muốn đánh với Đội Chấn thương\Nở lãnh địa của Arasaka thật à?
Dialogue: 0,0:13:40.49,0:13:41.57,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:13:46.12,0:13:47.12,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:49.62,0:13:50.50,Default,,0,0,0,,Talia?
Dialogue: 0,0:13:51.50,0:13:52.50,Default,,0,0,0,,Mau lên!
Dialogue: 0,0:14:01.51,0:14:02.55,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:14:02.63,0:14:04.55,Default,,0,0,0,,Talia thế nào?
Dialogue: 0,0:14:04.64,0:14:08.56,Default,,0,0,0,,Chà, con bé bắt đầu\Nkhông nghe lời chúng tôi nữa.
Dialogue: 0,0:14:08.64,0:14:10.93,Default,,0,0,0,,Con bé đang ở tuổi đó nhỉ?
Dialogue: 0,0:14:11.02,0:14:12.19,Default,,0,0,0,,Vâng.
Dialogue: 0,0:14:12.27,0:14:14.98,Default,,0,0,0,,Nó cũng cài thêm nhiều siêu thiết bị.
Dialogue: 0,0:14:15.06,0:14:17.23,Default,,0,0,0,,Vâng, và không gặp vấn đề gì.
Dialogue: 0,0:14:17.82,0:14:21.20,Default,,0,0,0,,Vậy à? Tôi lại nghe khác.
Dialogue: 0,0:14:21.28,0:14:24.62,Default,,0,0,0,,Nghe nói con bé sắp hóa siêu cuồng nhân.
Dialogue: 0,0:14:24.70,0:14:26.87,Default,,0,0,0,,À, ngài nghe tin đó rồi.
Dialogue: 0,0:14:26.95,0:14:29.45,Default,,0,0,0,,Không, tôi nghi là có sự nhầm lẫn ở đây.
Dialogue: 0,0:14:29.54,0:14:31.71,Default,,0,0,0,,{\an8}Tôi cũng vừa biết thôi.
Dialogue: 0,0:14:32.29,0:14:34.79,Default,,0,0,0,,Không báo cáo là việc làm rất dở.
Dialogue: 0,0:14:35.29,0:14:39.79,Default,,0,0,0,,Nhất là khi anh không lấy được vi mạch\Nvà chưa thu hồi được nó.
Dialogue: 0,0:14:40.34,0:14:41.88,Default,,0,0,0,,Tôi xin lỗi.
Dialogue: 0,0:14:41.96,0:14:45.92,Default,,0,0,0,,Nhóm lính đánh thuê tôi thuê\Nđược đánh giá rất cao, nhưng…
Dialogue: 0,0:14:46.43,0:14:48.56,Default,,0,0,0,,Dù sao cũng chỉ là vài tên côn đồ.
Dialogue: 0,0:14:48.64,0:14:51.44,Default,,0,0,0,,Dù sao thì, Arasaka mới khiến tôi bối rối.
Dialogue: 0,0:14:51.52,0:14:55.07,Default,,0,0,0,,Họ không dụng công lấy lại vi mạch đó.
Dialogue: 0,0:14:55.14,0:15:00.40,Default,,0,0,0,,Thực tế, có tin đồn toàn bộ dự án\Nđã đi vào ngõ cụt và đang bị bỏ rơi.
Dialogue: 0,0:15:00.48,0:15:03.94,Default,,0,0,0,,Tôi nghi ngờ đó là trò bịp của Arasaka.
Dialogue: 0,0:15:04.03,0:15:09.83,Default,,0,0,0,,Có lẽ thế. Nhưng Arasaka\Nkhông còn đủ khả năng làm thế.
Dialogue: 0,0:15:09.91,0:15:12.37,Default,,0,0,0,,Họ bị tấn công quá nhiều. Nền tảng sụp đổ.
Dialogue: 0,0:15:12.45,0:15:16.58,Default,,0,0,0,,Tôi nghi họ sẽ không bao giờ\Nkhôi phục được sức mạnh trước đây.
Dialogue: 0,0:15:16.67,0:15:17.63,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:15:17.71,0:15:20.09,Default,,0,0,0,,Vì ảnh hưởng của Arasaka đã suy yếu,
Dialogue: 0,0:15:20.17,0:15:23.97,Default,,0,0,0,,lãnh đạo đang mất hứng thú\Nvới việc chiếm lấy dự án.
Dialogue: 0,0:15:24.05,0:15:27.39,Default,,0,0,0,,Nếu vi mạch rơi vào tay ta, tuyệt.
Dialogue: 0,0:15:27.47,0:15:32.35,Default,,0,0,0,,Nếu dự án bị chôn vùi dưới tay Arasaka,\Ncũng có thể chấp nhận.
Dialogue: 0,0:15:32.43,0:15:36.52,Default,,0,0,0,,Dù thế nào đi nữa,\Ncũng không mấy khác biệt với Kang Tao.
Dialogue: 0,0:15:36.60,0:15:37.60,Default,,0,0,0,,Tôi hiểu.
Dialogue: 0,0:15:37.69,0:15:42.11,Default,,0,0,0,,Dù vậy, anh có được vị trí trong công ty\Nlà nhờ sáng kiến này.
Dialogue: 0,0:15:42.65,0:15:43.61,Default,,0,0,0,,Vâng.
Dialogue: 0,0:15:43.69,0:15:47.07,Default,,0,0,0,,Tôi đã ủng hộ anh\Nvì tôi đánh giá anh có năng lực.
Dialogue: 0,0:15:47.61,0:15:51.74,Default,,0,0,0,,Nếu anh tạo ra kết quả,\Ntôi cũng có chút mặt mũi.
Dialogue: 0,0:15:51.83,0:15:53.17,Default,,0,0,0,,Tôi hiểu.
Dialogue: 0,0:15:54.24,0:15:58.20,Default,,0,0,0,,Tôi mong đợi được nghe tin tốt\Nkhi chuyện này kết thúc.
Dialogue: 0,0:15:58.75,0:16:00.21,Default,,0,0,0,,Tôi xin hứa.
Dialogue: 0,0:16:06.76,0:16:07.64,Default,,0,0,0,,{\i1}Weak!{\i0}
Dialogue: 0,0:16:08.47,0:16:09.76,Default,,0,0,0,,{\i1}Nó ổn chứ? Talia ấy?{\i0}
Dialogue: 0,0:16:09.84,0:16:13.76,Default,,0,0,0,,{\i1}Tôi đã bảo bệnh viện\Ntheo dõi nó sát sao, tôi đã nói rất rõ.{\i0}
Dialogue: 0,0:16:14.35,0:16:17.35,Default,,0,0,0,,{\i1}Cô đã nói với Talia\Nvụ siêu cuồng nhân chưa?{\i0}
Dialogue: 0,0:16:19.31,0:16:20.52,Default,,0,0,0,,{\i1}Cô chưa nói à?{\i0}
Dialogue: 0,0:16:21.23,0:16:24.40,Default,,0,0,0,,{\i1}- Nếu cô cần, tôi sẽ nói với Talia.\N- Đừng! Chưa được.{\i0}
Dialogue: 0,0:16:24.48,0:16:28.32,Default,,0,0,0,,{\i1}Nó bị sốc đến mức\Nhóa siêu cuồng nhân thì sao?{\i0}
Dialogue: 0,0:16:28.40,0:16:30.19,Default,,0,0,0,,{\i1}Lo lắng chuyện đó cũng vô ích.{\i0}
Dialogue: 0,0:16:30.28,0:16:31.82,Default,,0,0,0,,{\i1}Dĩ nhiên tôi phải lo rồi!{\i0}
Dialogue: 0,0:16:31.91,0:16:34.29,Default,,0,0,0,,{\i1}Ai biết điều gì sẽ kích hoạt nó!{\i0}
Dialogue: 0,0:16:34.37,0:16:36.79,Default,,0,0,0,,{\i1}Anh không biết con bé đang thế nào à?{\i0}
Dialogue: 0,0:16:36.87,0:16:38.50,Default,,0,0,0,,{\i1}Sao? Tôi biết, nhưng…{\i0}
Dialogue: 0,0:16:38.58,0:16:39.96,Default,,0,0,0,,{\i1}Vậy sao lại nói…{\i0}
Dialogue: 0,0:16:40.04,0:16:41.83,Default,,0,0,0,,{\i1}Được rồi, tôi sẽ không nói.{\i0}
Dialogue: 0,0:16:42.33,0:16:45.04,Default,,0,0,0,,{\i1}Dù sao, tôi đi bảo vệ Talia ngay đây.{\i0}
Dialogue: 0,0:16:45.13,0:16:48.55,Default,,0,0,0,,{\i1}Mau đi đi. Có thể con bé\Nđã đi với bọn kia rồi.{\i0}
Dialogue: 0,0:16:49.38,0:16:52.51,Default,,0,0,0,,{\i1}Chắc không đâu. Nhưng để tôi xem.{\i0}
Dialogue: 0,0:16:56.64,0:16:58.10,Default,,0,0,0,,ĐANG GỌI
Dialogue: 0,0:17:02.86,0:17:04.24,Default,,0,0,0,,Tôi nghĩ cháu sẽ ở đây.
Dialogue: 0,0:17:04.73,0:17:06.69,Default,,0,0,0,,Có vẻ chúng bỏ rơi cháu rồi.
Dialogue: 0,0:17:08.07,0:17:09.74,Default,,0,0,0,,Cháu nghĩ là tại tôi à?
Dialogue: 0,0:17:10.45,0:17:12.24,Default,,0,0,0,,Họ đang đùa với tôi thôi.
Dialogue: 0,0:17:12.32,0:17:16.70,Default,,0,0,0,,Thôi nào. Cháu đâu có đồng cảm\Nvới giáo lý của chúng.
Dialogue: 0,0:17:17.20,0:17:18.83,Default,,0,0,0,,Cứ như ông hiểu tôi lắm ấy.
Dialogue: 0,0:17:19.33,0:17:22.96,Default,,0,0,0,,Chúng rất nhạy cảm với người ngoài.\NChúng nhìn thấu cháu rồi.
Dialogue: 0,0:17:23.04,0:17:24.04,Default,,0,0,0,,Ông thì biết gì…
Dialogue: 0,0:17:24.13,0:17:27.47,Default,,0,0,0,,Tôi biết cháu cài lắm siêu thiết bị\Nkhông phải vì thích.
Dialogue: 0,0:17:27.55,0:17:29.76,Default,,0,0,0,,Đây là vấn đề sống còn đối với cháu.
Dialogue: 0,0:17:31.18,0:17:32.10,Default,,0,0,0,,Tôi rất tiếc.
Dialogue: 0,0:17:32.18,0:17:34.81,Default,,0,0,0,,Avida đã kể tôi nghe tình trạng của cháu.
Dialogue: 0,0:17:34.89,0:17:36.18,Default,,0,0,0,,Được rồi. Thì sao?
Dialogue: 0,0:17:37.01,0:17:38.43,Default,,0,0,0,,Cháu có đói không?
Dialogue: 0,0:17:38.52,0:17:39.69,Default,,0,0,0,,Sao?
Dialogue: 0,0:17:39.77,0:17:41.81,Default,,0,0,0,,Nào. Ta đi ăn, nói chuyện chút đi.
Dialogue: 0,0:17:41.89,0:17:43.81,Default,,0,0,0,,Sao tôi phải làm thế?
Dialogue: 0,0:17:43.90,0:17:46.94,Default,,0,0,0,,{\an8}Nếu không tôi sẽ lôi cháu về bệnh viện.
Dialogue: 0,0:17:47.44,0:17:49.32,Default,,0,0,0,,{\an8}Cháu chọn đi.
Dialogue: 0,0:17:52.40,0:17:56.28,Default,,0,0,0,,Này. Nghe nói\Nông đã hóa siêu cuồng nhân. Có thật không?
Dialogue: 0,0:17:57.20,0:17:58.08,Default,,0,0,0,,Thật.
Dialogue: 0,0:17:58.66,0:18:02.58,Default,,0,0,0,,Nhưng ông lại cố ngăn tôi\Ncài siêu thiết bị à?
Dialogue: 0,0:18:02.66,0:18:05.33,Default,,0,0,0,,Không ai đủ tư cách hơn tôi.
Dialogue: 0,0:18:06.67,0:18:07.59,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:18:08.17,0:18:10.13,Default,,0,0,0,,Chúng ta có điểm chung.
Dialogue: 0,0:18:10.63,0:18:13.09,Default,,0,0,0,,Tôi có thể hiểu cảm giác của cháu.
Dialogue: 0,0:18:13.93,0:18:15.64,Default,,0,0,0,,Ông đùa chắc.
Dialogue: 0,0:18:15.72,0:18:17.35,Default,,0,0,0,,Ta chẳng có gì chung cả.
Dialogue: 0,0:18:17.97,0:18:20.89,Default,,0,0,0,,Tôi đoán nhé,\Ncháu nghĩ mình đặc biệt đúng không?
Dialogue: 0,0:18:21.39,0:18:24.56,Default,,0,0,0,,Và cháu chịu được nhiều siêu thiết bị\Nhơn đa số người?
Dialogue: 0,0:18:25.27,0:18:29.57,Default,,0,0,0,,- Tôi cũng từng nghĩ thế.\N- Nhưng ông không như thế.
Dialogue: 0,0:18:29.65,0:18:32.90,Default,,0,0,0,,Cháu cũng vậy. Không ai đặc biệt cả.
Dialogue: 0,0:18:33.40,0:18:34.86,Default,,0,0,0,,Tôi thì khác.
Dialogue: 0,0:18:35.45,0:18:37.04,Default,,0,0,0,,Rất nhiều người nghĩ thế.
Dialogue: 0,0:18:37.12,0:18:38.96,Default,,0,0,0,,Họ tin rằng mình khác biệt.
Dialogue: 0,0:18:39.03,0:18:42.20,Default,,0,0,0,,Nhưng ai cũng rơi vào vực thẳm.
Dialogue: 0,0:18:42.70,0:18:44.49,Default,,0,0,0,,Hoặc chết trước khi có dịp.
Dialogue: 0,0:18:45.00,0:18:47.96,Default,,0,0,0,,Sớm muộn gì cũng thế.\NVấn đề chỉ là thời gian.
Dialogue: 0,0:18:48.46,0:18:50.25,Default,,0,0,0,,Tôi phải làm gì đây?
Dialogue: 0,0:18:50.34,0:18:54.55,Default,,0,0,0,,Giữ lấy tấm thân yếu đuối này ư?\NKhông đời nào.
Dialogue: 0,0:18:54.63,0:18:56.76,Default,,0,0,0,,Chỉ còn hy vọng vào siêu thiết bị.
Dialogue: 0,0:18:56.84,0:19:02.10,Default,,0,0,0,,Mặc kệ tôi có hóa siêu cuồng nhân không.\NNếu giờ dừng lại, tôi sẽ chết chắc!
Dialogue: 0,0:19:02.18,0:19:04.77,Default,,0,0,0,,Ông mong tôi ngoan ngoãn chịu chết ư?
Dialogue: 0,0:19:10.57,0:19:14.66,Default,,0,0,0,,Nếu tôi sắp chết,\Ntôi sẽ làm điều mình muốn với cơ thể này.
Dialogue: 0,0:19:14.74,0:19:16.28,Default,,0,0,0,,Dù tôi có phát cuồng…
Dialogue: 0,0:19:16.36,0:19:17.74,Default,,0,0,0,,Cháu sai rồi!
Dialogue: 0,0:19:17.82,0:19:23.03,Default,,0,0,0,,{\an8}Hóa siêu cuồng nhân…\Nnghĩa là cháu không còn là cháu nữa.
Dialogue: 0,0:19:23.54,0:19:25.50,Default,,0,0,0,,{\an8}Cháu không chỉ phát điên.
Dialogue: 0,0:19:26.21,0:19:27.50,Default,,0,0,0,,Đánh mất bản thân…
Dialogue: 0,0:19:27.58,0:19:29.62,Default,,0,0,0,,còn tệ hơn cái chết.
Dialogue: 0,0:19:31.92,0:19:35.76,Default,,0,0,0,,Thế thì sao? Tôi nên chết\Ntrước khi thành siêu cuồng nhân à?
Dialogue: 0,0:19:35.84,0:19:37.51,Default,,0,0,0,,Tôi không nói thế.
Dialogue: 0,0:19:37.59,0:19:39.51,Default,,0,0,0,,Nhưng trải qua chuyện đó…
Dialogue: 0,0:19:40.60,0:19:45.02,Default,,0,0,0,,Bạn bè, cha mẹ, người yêu.\NBất cứ ai thân thiết.
Dialogue: 0,0:19:45.10,0:19:47.48,Default,,0,0,0,,Ta có thể giết họ và không nhớ gì cả.
Dialogue: 0,0:19:49.90,0:19:51.99,Default,,0,0,0,,- Ông đã làm thế à?\N- Tôi không biết.
Dialogue: 0,0:19:52.48,0:19:53.73,Default,,0,0,0,,Không biết sao?
Dialogue: 0,0:19:53.82,0:19:57.66,Default,,0,0,0,,Tôi không nhớ chuyện xảy ra lúc đó.\NChỉ mang máng thôi.
Dialogue: 0,0:19:58.16,0:20:01.29,Default,,0,0,0,,Ta không biết ta ở đâu, vào lúc nào nữa.
Dialogue: 0,0:20:01.37,0:20:03.25,Default,,0,0,0,,Ta không biết ta là ai.
Dialogue: 0,0:20:03.33,0:20:04.29,Default,,0,0,0,,Vào lúc nào ư?
Dialogue: 0,0:20:04.37,0:20:08.04,Default,,0,0,0,,Ông nhìn thấy ký ức à?\NTôi không muốn thế đâu.
Dialogue: 0,0:20:10.63,0:20:14.13,Default,,0,0,0,,Nếu tôi có khả năng sẽ làm hại ai đó,
Dialogue: 0,0:20:14.21,0:20:16.42,Default,,0,0,0,,không phải tôi nên tránh xa bố mẹ ư?
Dialogue: 0,0:20:16.51,0:20:18.93,Default,,0,0,0,,Cháu nghĩ cháu có thể sống một mình à?
Dialogue: 0,0:20:19.01,0:20:21.22,Default,,0,0,0,,Ý tưởng trẻ con thật.
Dialogue: 0,0:20:21.30,0:20:23.43,Default,,0,0,0,,Làm như ông có ai ấy.
Dialogue: 0,0:20:24.01,0:20:24.97,Default,,0,0,0,,Chuyện đó khác.
Dialogue: 0,0:20:25.06,0:20:27.81,Default,,0,0,0,,Sao ông thích can dự vào chuyện này thế?
Dialogue: 0,0:20:27.89,0:20:30.81,Default,,0,0,0,,Sao lại nhọc công thế\Nchỉ vì người yêu cũ nhờ vả?
Dialogue: 0,0:20:31.31,0:20:35.73,Default,,0,0,0,,- Ông đang ngoại tình à?\N- Đừng nói về mẹ cháu kiểu đó!
Dialogue: 0,0:20:35.82,0:20:37.57,Default,,0,0,0,,Tôi và Avida không phải thế.
Dialogue: 0,0:20:38.07,0:20:41.53,Default,,0,0,0,,Nhưng đúng là cô ấy rất đặc biệt với tôi.
Dialogue: 0,0:20:41.62,0:20:44.12,Default,,0,0,0,,Kiểu tình cảm lãng mạn ấy à?
Dialogue: 0,0:20:44.20,0:20:46.70,Default,,0,0,0,,Không đơn giản như thế!
Dialogue: 0,0:20:46.79,0:20:48.63,Default,,0,0,0,,Mối quan hệ của bọn tôi…
Dialogue: 0,0:20:50.33,0:20:52.71,Default,,0,0,0,,Khó giải thích cho trẻ con lắm.
Dialogue: 0,0:20:53.92,0:20:58.38,Default,,0,0,0,,Talia, có những điều lớn lên cháu sẽ hiểu.
Dialogue: 0,0:20:58.88,0:21:00.84,Default,,0,0,0,,Lớn lên nhỉ?
Dialogue: 0,0:21:00.93,0:21:06.73,Default,,0,0,0,,Bị một người phụ nữ ám ảnh cả chục năm?\NVà không bước tiếp được à?
Dialogue: 0,0:21:07.22,0:21:08.26,Default,,0,0,0,,Thật thảm hại.
Dialogue: 0,0:21:13.94,0:21:17.86,Default,,0,0,0,,- Cháu nghĩ tôi không có tình yêu à?\N- Rõ rành rành ra.
Dialogue: 0,0:21:18.36,0:21:19.82,Default,,0,0,0,,Thảo nào.
Dialogue: 0,0:21:19.90,0:21:22.11,Default,,0,0,0,,- Cháu đánh giá đàn ông tệ quá.\N- Sao?
Dialogue: 0,0:21:22.20,0:21:26.62,Default,,0,0,0,,Ừ, cháu nói thì hay lắm,\Nbản thân còn chưa qua nổi màn nắm tay.
Dialogue: 0,0:21:26.70,0:21:27.74,Default,,0,0,0,,Ông muốn chết à?
Dialogue: 0,0:21:27.83,0:21:28.79,Default,,0,0,0,,Bình tĩnh đi…
Dialogue: 0,0:21:33.50,0:21:35.13,Default,,0,0,0,,- Tôi sẽ gọi anh ấy.\N- Hả?
Dialogue: 0,0:21:35.21,0:21:36.25,Default,,0,0,0,,Bạn trai tôi.
Dialogue: 0,0:21:36.84,0:21:39.26,Default,,0,0,0,,Muốn gặp không? Tôi gọi anh ấy liền đây.
Dialogue: 0,0:21:39.34,0:21:40.84,Default,,0,0,0,,Đợi đã.
Dialogue: 0,0:21:47.85,0:21:49.31,Default,,0,0,0,,Cô đang nhìn gì thế?
Dialogue: 0,0:21:50.23,0:21:52.40,Default,,0,0,0,,Trên trời có gì thú vị à?
Dialogue: 0,0:21:56.52,0:21:57.48,Default,,0,0,0,,Vệ tinh ư?
Dialogue: 0,0:21:58.73,0:22:00.27,Default,,0,0,0,,Sao lại là vệ tinh?
Dialogue: 0,0:22:03.36,0:22:04.95,Default,,0,0,0,,{\i1}Ông cười cái gì?{\i0}
Dialogue: 0,0:22:06.41,0:22:09.08,Default,,0,0,0,,Lẽ ra anh nên bình tĩnh hơn, D.
Dialogue: 0,0:22:10.41,0:22:14.04,Default,,0,0,0,,{\an8}- Tôi hiểu cảm giác của anh, nhưng…\N- Bị con nít lên lớp kìa.
Dialogue: 0,0:22:14.12,0:22:15.16,Default,,0,0,0,,Im đi.
Dialogue: 0,0:22:15.88,0:22:17.30,Default,,0,0,0,,Anh nói tôi hay…
Dialogue: 0,0:22:17.38,0:22:20.05,Default,,0,0,0,,- Capri.\N- Capri?
Dialogue: 0,0:22:20.13,0:22:25.34,Default,,0,0,0,,- Cô ấy nói đó là tên cô ấy.\N- Ồ, tên cô ấy à? Rất vui được gặp, Capri.
Dialogue: 0,0:22:25.43,0:22:26.77,Default,,0,0,0,,Sang phải một chút.
Dialogue: 0,0:22:28.39,0:22:30.64,Default,,0,0,0,,Không có cách nào để tôi thấy cô ấy à?
Dialogue: 0,0:22:31.27,0:22:32.94,Default,,0,0,0,,Chỉ một tia sáng thôi.
Dialogue: 0,0:22:34.77,0:22:36.06,Default,,0,0,0,,Là nó à?
Dialogue: 0,0:22:36.15,0:22:37.69,Default,,0,0,0,,Ừ? Chắc vậy.
Dialogue: 0,0:22:41.82,0:22:43.28,Default,,0,0,0,,Ừ, cô ấy đấy!
Dialogue: 0,0:22:43.78,0:22:46.41,Default,,0,0,0,,Giống video siêu nhiên nhỉ?
Dialogue: 0,0:22:46.49,0:22:48.49,Default,,0,0,0,,Có ma nào lại ngốc thế này?
Dialogue: 0,0:22:48.58,0:22:50.67,Default,,0,0,0,,Có ma này. Ở ngay đây.
Dialogue: 0,0:22:51.29,0:22:52.63,Default,,0,0,0,,Hả? Talia?
Dialogue: 0,0:22:53.12,0:22:55.54,Default,,0,0,0,,{\i1}Này, cậu rảnh không? Phải rảnh chứ nhỉ?{\i0}
Dialogue: 0,0:22:55.62,0:22:58.71,Default,,0,0,0,,{\i1}- Vậy đến đây đi. Tôi gửi tọa độ nhé.\N- Hả…{\i0}
Dialogue: 0,0:22:58.79,0:23:00.29,Default,,0,0,0,,{\i1}Làm ơn đi, cảm ơn cậu.{\i0}
Dialogue: 0,0:23:02.46,0:23:04.71,Default,,0,0,0,,Cậu có mối quan hệ ghê gớm nhỉ?
Dialogue: 0,0:23:04.80,0:23:06.39,Default,,0,0,0,,Anh cũng biết nói sao?
Dialogue: 0,0:23:08.68,0:23:10.22,Default,,0,0,0,,Này! Anh đã lén xem nó!
Dialogue: 0,0:23:10.31,0:23:12.65,Default,,0,0,0,,Tồi tệ.
Dialogue: 0,0:23:14.60,0:23:15.77,Default,,0,0,0,,Muốn đi cùng không?
Dialogue: 0,0:23:15.85,0:23:18.19,Default,,0,0,0,,Cho tôi xin đi. Cô ta nghe đáng sợ quá.
Dialogue: 0,0:23:19.06,0:23:23.36,Default,,0,0,0,,Cô ấy ở trong cùng danh sách với anh\Nvà David Martinez đấy.
Dialogue: 0,0:23:23.44,0:23:24.48,Default,,0,0,0,,{\an8}Sao?
Dialogue: 0,0:23:24.57,0:23:29.08,Default,,0,0,0,,{\an8}Tôi không biết danh sách đó để làm gì,\Nnhưng các anh đều có liên quan.
Dialogue: 0,0:23:29.16,0:23:30.91,Default,,0,0,0,,{\an8}Có lẽ đó là manh mối.
Dialogue: 0,0:23:31.41,0:23:34.20,Default,,0,0,0,,{\an8}Tôi và Martinez làm méo gì có điểm chung.
Dialogue: 0,0:23:34.29,0:23:38.50,Default,,0,0,0,,{\an8}Vậy sao cả hai lại cùng trong danh sách?\NPhải có lý do chứ.
Dialogue: 0,0:23:40.34,0:23:42.18,Default,,0,0,0,,Không đi thì tôi đi một mình.
Dialogue: 0,0:23:43.17,0:23:47.09,Default,,0,0,0,,{\an8}Dù sao anh cũng hết manh mối rồi.\NSao không đi đi?
Dialogue: 0,0:23:48.47,0:23:49.30,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:23:50.01,0:23:50.97,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:23:52.14,0:23:53.64,Default,,0,0,0,,{\i1}Anh ta là ai?{\i0}
Dialogue: 0,0:23:54.98,0:23:56.15,Default,,0,0,0,,Bạn tôi, D.
Dialogue: 0,0:23:56.64,0:23:58.64,Default,,0,0,0,,D, đây là Talia.
Dialogue: 0,0:23:59.23,0:24:00.06,Default,,0,0,0,,Hân hạnh.
Dialogue: 0,0:24:00.56,0:24:04.98,Default,,0,0,0,,Đây là Weak. Bạn của mẹ tôi?\NTôi không biết rõ ông ta.
Dialogue: 0,0:24:08.36,0:24:11.11,Default,,0,0,0,,- Đùa tôi à? Thằng này sao?\N- Ừ.
Dialogue: 0,0:24:11.20,0:24:15.79,Default,,0,0,0,,- Nhưng nó chỉ là một đứa trẻ.\N- Ông biết gì không? Cút đi.
Dialogue: 0,0:24:15.87,0:24:19.29,Default,,0,0,0,,Anh ấy là bạn trai tôi. Tôn trọng chút đi.
Dialogue: 0,0:24:19.92,0:24:21.88,Default,,0,0,0,,Thô lỗ quá, ông già.
Dialogue: 0,0:24:22.38,0:24:24.55,Default,,0,0,0,,Anh bạn này hiểu chuyện đấy.
Dialogue: 0,0:24:27.97,0:24:28.80,Default,,0,0,0,,D?
Dialogue: 0,0:24:35.35,0:24:39.27,Default,,0,0,0,,Thấy tôi rồi đúng không?\NTôi biết là cô thấy được tôi mà.
Dialogue: 0,0:24:44.02,0:24:45.27,Default,,0,0,0,,Cuối cùng!
Dialogue: 0,0:24:46.40,0:24:48.69,Default,,0,0,0,,{\i1}Tìm ra cô rồi.{\i0}
Dialogue: 0,0:26:20.95,0:26:23.95,Default,,0,0,0,,Biên dịch: Khanh Tran
