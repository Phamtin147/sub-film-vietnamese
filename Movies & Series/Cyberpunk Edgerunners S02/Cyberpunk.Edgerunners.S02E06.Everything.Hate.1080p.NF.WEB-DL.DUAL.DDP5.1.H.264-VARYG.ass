Dialogue: 0,0:00:15.93,0:00:16.93,Default,,0,0,0,,Ồ.
Dialogue: 0,0:00:17.02,0:00:18.06,Default,,0,0,0,,Mẹ.
Dialogue: 0,0:00:20.31,0:00:22.56,Default,,0,0,0,,{\an8}Suỵt. Đừng dọa mẹ như thế.
Dialogue: 0,0:00:23.23,0:00:26.19,Default,,0,0,0,,Sao vậy? Mẹ tưởng con bỏ trốn à?
Dialogue: 0,0:00:28.03,0:00:29.45,Default,,0,0,0,,{\i1}Bà chắc chứ?{\i0}
Dialogue: 0,0:00:29.95,0:00:32.66,Default,,0,0,0,,Tình trạng của cô ấy khó lòng vận động mà.
Dialogue: 0,0:00:33.49,0:00:36.24,Default,,0,0,0,,Nhưng con bé\Ncó vẻ không phải gắng sức đến thế,
Dialogue: 0,0:00:36.33,0:00:40.96,Default,,0,0,0,,nhất là so với lúc mới nhập viện.
Dialogue: 0,0:00:41.50,0:00:44.21,Default,,0,0,0,,Vậy à? Tôi sẽ ghé xem sao.
Dialogue: 0,0:00:44.29,0:00:46.08,Default,,0,0,0,,Là thật đấy!
Dialogue: 0,0:00:46.17,0:00:49.09,Default,,0,0,0,,Hôm nay nó có vẻ rất bình thường.
Dialogue: 0,0:00:49.72,0:00:52.72,Default,,0,0,0,,Có khi nào con bé có thể khỏe lại không?
Dialogue: 0,0:00:53.85,0:00:56.39,Default,,0,0,0,,Tôi hiểu tại sao bà muốn nghĩ thế.
Dialogue: 0,0:00:56.47,0:01:00.10,Default,,0,0,0,,Thế nhưng, chuyện này thật khó mở lời…
Dialogue: 0,0:01:00.19,0:01:04.82,Default,,0,0,0,,{\i1}Đôi lúc bệnh nhân ở giai đoạn cuối\Ntạm thời trông rất khỏe khoắn.{\i0}
Dialogue: 0,0:01:05.32,0:01:08.53,Default,,0,0,0,,Khi nó xảy ra,\Nngười thân của họ không khỏi hy vọng,
Dialogue: 0,0:01:08.61,0:01:11.49,Default,,0,0,0,,nhưng trong đa số trường hợp,\Nkhông lâu sau đó…
Dialogue: 0,0:01:11.99,0:01:14.24,Default,,0,0,0,,Tôi… hiểu rồi.
Dialogue: 0,0:01:22.25,0:01:25.42,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:01:25.50,0:01:28.59,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:03:17.28,0:03:18.32,Default,,0,0,0,,Roman.
Dialogue: 0,0:03:19.20,0:03:20.70,Default,,0,0,0,,Cho tôi mượn máy tính đi.
Dialogue: 0,0:03:29.13,0:03:30.51,Default,,0,0,0,,{\an8}Anh ích kỷ quá.
Dialogue: 0,0:03:32.05,0:03:34.68,Default,,0,0,0,,{\an8}Máy của tôi không xử lý nổi.
Dialogue: 0,0:03:35.38,0:03:38.51,Default,,0,0,0,,{\an8}- Anh đang làm gì vậy?\N- Thứ tôi cần.
Dialogue: 0,0:03:39.34,0:03:41.63,Default,,0,0,0,,{\an8}Tôi không nghĩ anh sẽ quay lại.
Dialogue: 0,0:03:42.35,0:03:46.35,Default,,0,0,0,,{\an8}Tôi đã thử tìm anh, nhưng…\NLúc đó anh đi đâu vậy?
Dialogue: 0,0:03:47.14,0:03:49.64,Default,,0,0,0,,{\an8}Muốn có con chip à?\NXin lỗi, không được đâu.
Dialogue: 0,0:03:51.44,0:03:55.03,Default,,0,0,0,,{\an8}Hiện tại thì chưa. Xong rồi. Này.
Dialogue: 0,0:03:55.65,0:03:59.53,Default,,0,0,0,,Cậu đã quay lại\Nlúc tôi xử bọn Arasaka đúng không?
Dialogue: 0,0:03:59.61,0:04:01.28,Default,,0,0,0,,Cho tôi xem phim đi.
Dialogue: 0,0:04:10.79,0:04:13.04,Default,,0,0,0,,- Hết rồi sao?\N- Ừ.
Dialogue: 0,0:04:13.92,0:04:17.34,Default,,0,0,0,,{\an8}- Cậu không quay đến cuối à?\N- Không quay được.
Dialogue: 0,0:04:19.72,0:04:22.22,Default,,0,0,0,,{\an8}Ừm, thế này chắc được rồi.
Dialogue: 0,0:04:22.76,0:04:23.76,Default,,0,0,0,,Ý anh là sao?
Dialogue: 0,0:04:23.85,0:04:25.69,Default,,0,0,0,,Tôi muốn cậu biên tập nó.
Dialogue: 0,0:04:25.77,0:04:28.44,Default,,0,0,0,,Làm như thể tôi đã đánh Arasaka tơi bời.
Dialogue: 0,0:04:28.52,0:04:32.07,Default,,0,0,0,,- Cho nó đẫm máu vào.\N- Khoan, anh cần video như thế làm gì?
Dialogue: 0,0:04:32.69,0:04:35.44,Default,,0,0,0,,Con chip. Cậu muốn mượn nó đúng không?
Dialogue: 0,0:04:36.11,0:04:40.16,Default,,0,0,0,,{\an8}Vậy thì giúp tôi đi.\NTrả thù xong, tôi sẽ cho cậu mượn.
Dialogue: 0,0:04:41.70,0:04:43.70,Default,,0,0,0,,Anh định làm gì?
Dialogue: 0,0:04:47.20,0:04:48.83,Default,,0,0,0,,Lấy thêm một ít tư liệu.
Dialogue: 0,0:04:50.00,0:04:52.54,Default,,0,0,0,,- Sao lại đeo mặt nạ?\N- Liên quan gì cậu?
Dialogue: 0,0:04:53.71,0:04:55.38,Default,,0,0,0,,{\an8}Mà sao cậu lại nằm dưới đất?
Dialogue: 0,0:04:55.88,0:04:57.01,Default,,0,0,0,,{\an8}Liên quan gì anh?
Dialogue: 0,0:04:58.84,0:04:59.92,Default,,0,0,0,,{\an8}Máy chạy.
Dialogue: 0,0:05:01.63,0:05:04.88,Default,,0,0,0,,{\an8}Bọn cặn bã Arasaka\Nđã giết bằng hữu của ta, ra mặt đi!
Dialogue: 0,0:05:04.97,0:05:07.89,Default,,0,0,0,,{\an8}Nếu không, ta sẽ giết\Ntừng tên Arasaka một!
Dialogue: 0,0:05:07.97,0:05:08.97,Default,,0,0,0,,{\an8}Đợi chút.
Dialogue: 0,0:05:09.73,0:05:12.23,Default,,0,0,0,,{\an8}Anh gây sự với Arasaka ư?\NNghiêm túc đấy à?
Dialogue: 0,0:05:12.31,0:05:14.23,Default,,0,0,0,,{\an8}- Sao giờ cậu mới hỏi?\N- Anh…
Dialogue: 0,0:05:14.86,0:05:17.53,Default,,0,0,0,,Anh định công bố chuyện này?\NMượn sức Capri ư?
Dialogue: 0,0:05:17.61,0:05:18.57,Default,,0,0,0,,Dĩ nhiên rồi.
Dialogue: 0,0:05:18.65,0:05:19.78,Default,,0,0,0,,Không ổn chút nào.
Dialogue: 0,0:05:19.86,0:05:22.74,Default,,0,0,0,,Cậu sợ thì rút lui đi.\NTôi sẽ làm một mình.
Dialogue: 0,0:05:22.82,0:05:25.24,Default,,0,0,0,,Tôi chỉ việc quay và chỉnh sửa thôi mà.
Dialogue: 0,0:05:25.78,0:05:27.20,Default,,0,0,0,,Không nhất thiết là cậu.
Dialogue: 0,0:05:30.50,0:05:33.63,Default,,0,0,0,,{\an8}Chết tiệt! Được, tôi sẽ làm!\NAnh muốn thế đúng không?
Dialogue: 0,0:06:15.21,0:06:17.21,Default,,0,0,0,,{\an8}Lâu rồi tôi mới đến đây.
Dialogue: 0,0:06:17.84,0:06:20.22,Default,,0,0,0,,{\an8}Làm nhớ cái dạo mới vào nghề nhỉ?
Dialogue: 0,0:06:20.88,0:06:22.09,Default,,0,0,0,,{\an8}Đừng ngốc thế.
Dialogue: 0,0:06:24.43,0:06:25.89,Default,,0,0,0,,Tôi tìm hiểu rồi.
Dialogue: 0,0:06:25.97,0:06:28.81,Default,,0,0,0,,Một kẻ bị bệnh nan y,\Nkhông còn nhiều thời gian,
Dialogue: 0,0:06:28.89,0:06:34.60,Default,,0,0,0,,lại sắp hóa siêu cuồng nhân,\Nmuốn kéo dài sự sống cũng hết cách.
Dialogue: 0,0:06:35.10,0:06:35.93,Default,,0,0,0,,Vậy à?
Dialogue: 0,0:06:36.65,0:06:38.65,Default,,0,0,0,,Nhưng đó là cách thông thường.
Dialogue: 0,0:06:39.15,0:06:40.57,Default,,0,0,0,,Có nghe Soulkiller chưa?
Dialogue: 0,0:06:40.65,0:06:41.65,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:41.73,0:06:45.65,Default,,0,0,0,,Đó là công nghệ số hóa,\Nsao chép và lưu trữ ký ức con người.
Dialogue: 0,0:06:45.74,0:06:46.62,Default,,0,0,0,,À…
Dialogue: 0,0:06:46.70,0:06:49.08,Default,,0,0,0,,Arasaka phát triển nó đúng không?
Dialogue: 0,0:06:49.16,0:06:53.33,Default,,0,0,0,,{\an8}Nhưng nghe nói\Ndự án có thiếu sót và đã bị hủy.
Dialogue: 0,0:06:53.83,0:06:57.17,Default,,0,0,0,,{\an8}Ừ. Trong lúc họ số hóa ký ức\Nđể thử nghiệm lâm sàng,
Dialogue: 0,0:06:57.25,0:06:59.92,Default,,0,0,0,,{\an8}bản gốc đã bị chết não.
Dialogue: 0,0:07:00.46,0:07:04.05,Default,,0,0,0,,{\an8}Linh hồn không thể bị sao chép,\Nmà chỉ có thể xé toạc ra.
Dialogue: 0,0:07:04.67,0:07:07.09,Default,,0,0,0,,Nên nó mới tên là Soulkiller, Đoạt hồn.
Dialogue: 0,0:07:08.01,0:07:11.10,Default,,0,0,0,,Bề ngoài, chương trình đã bị chấm dứt.
Dialogue: 0,0:07:11.60,0:07:13.06,Default,,0,0,0,,Vụ này thì liên quan gì?
Dialogue: 0,0:07:13.56,0:07:17.48,Default,,0,0,0,,Có vẻ như Arasaka\Nđã bí mật tiếp tục nghiên cứu.
Dialogue: 0,0:07:18.31,0:07:21.61,Default,,0,0,0,,{\i1}Họ không sao chép được,\Nnhưng đã có thể số hóa nó.{\i0}
Dialogue: 0,0:07:21.69,0:07:26.49,Default,,0,0,0,,{\i1}Có vẻ như linh hồn đã số hóa\Nđược gọi là "cấu trúc".{\i0}
Dialogue: 0,0:07:27.24,0:07:30.24,Default,,0,0,0,,Họ đang chuẩn bị cấy nó vào một con người.
Dialogue: 0,0:07:30.95,0:07:32.24,Default,,0,0,0,,Dù sao đi nữa,
Dialogue: 0,0:07:32.33,0:07:34.50,Default,,0,0,0,,nếu có được công nghệ đó,
Dialogue: 0,0:07:34.58,0:07:38.13,Default,,0,0,0,,ta có thể chuyển linh hồn\Nvào một cơ thể khác.
Dialogue: 0,0:07:38.62,0:07:41.50,Default,,0,0,0,,Bệnh có thể vô phương,\Nnhưng linh hồn thì khác.
Dialogue: 0,0:07:41.59,0:07:43.34,Default,,0,0,0,,Sao có thể…
Dialogue: 0,0:07:44.84,0:07:47.72,Default,,0,0,0,,Đợi đã. "Đang chuẩn bị cấy"?
Dialogue: 0,0:07:47.80,0:07:49.76,Default,,0,0,0,,Vậy là họ chưa thành công à?
Dialogue: 0,0:07:49.84,0:07:51.80,Default,,0,0,0,,Đó chính là vấn đề.
Dialogue: 0,0:07:51.89,0:07:55.31,Default,,0,0,0,,Có rất nhiều phỏng đoán,\Nnhưng chưa điều gì được xác thực.
Dialogue: 0,0:07:55.39,0:08:00.85,Default,,0,0,0,,Có người nói nhà phát triển đã chết\Nhoặc họ đã bán nó cho Kang Tao.
Dialogue: 0,0:08:00.94,0:08:02.53,Default,,0,0,0,,Nhưng không ai biết sự thật.
Dialogue: 0,0:08:03.32,0:08:05.99,Default,,0,0,0,,Đây là thông tin tối mật của một tập đoàn.
Dialogue: 0,0:08:06.07,0:08:08.99,Default,,0,0,0,,Không có thông tin nào\Nmang tính quyết định.
Dialogue: 0,0:08:09.86,0:08:11.61,Default,,0,0,0,,Bán cho Kang Tao ư?
Dialogue: 0,0:08:12.16,0:08:13.70,Default,,0,0,0,,Kang Tao thì sao?
Dialogue: 0,0:08:14.20,0:08:17.29,Default,,0,0,0,,Nếu vậy, có thể tôi sẽ có cách\Ntiếp tục điều tra.
Dialogue: 0,0:08:38.39,0:08:40.73,Default,,0,0,0,,{\i1}Talia.{\i0}
Dialogue: 0,0:08:40.81,0:08:41.90,Default,,0,0,0,,Talia!
Dialogue: 0,0:08:41.98,0:08:45.94,Default,,0,0,0,,Này, cô ổn chứ? Cô làm gì ở đây?
Dialogue: 0,0:08:46.03,0:08:48.03,Default,,0,0,0,,Sao cô đến được đây?
Dialogue: 0,0:08:48.53,0:08:52.20,Default,,0,0,0,,{\i1}Nếu không, ta sẽ giết\Ntừng tên Arasaka một!{\i0}
Dialogue: 0,0:08:52.82,0:08:54.45,Default,,0,0,0,,{\an8}Thành phẩm đấy.
Dialogue: 0,0:08:54.95,0:09:01.04,Default,,0,0,0,,{\an8}Tốt. Ừ, tốt hơn tôi mong đợi.\NCậu thêm địa chỉ này vào cuối nhé?
Dialogue: 0,0:09:01.54,0:09:02.50,Default,,0,0,0,,{\an8}Gì vậy?
Dialogue: 0,0:09:02.58,0:09:06.96,Default,,0,0,0,,{\an8}Nền tảng do tôi tự chế,\Nchỉ để chỉ điểm và không sợ bị định vị.
Dialogue: 0,0:09:08.46,0:09:09.55,Default,,0,0,0,,{\an8}Anh làm à, D?
Dialogue: 0,0:09:09.63,0:09:10.63,Default,,0,0,0,,{\an8}Ừ.
Dialogue: 0,0:09:11.38,0:09:13.13,Default,,0,0,0,,{\an8}Capri đã giúp tôi.
Dialogue: 0,0:09:18.85,0:09:20.39,Default,,0,0,0,,{\an8}Anh làm thế thật sao?
Dialogue: 0,0:09:21.85,0:09:22.94,Default,,0,0,0,,{\an8}Dĩ nhiên rồi.
Dialogue: 0,0:09:36.37,0:09:39.16,Default,,0,0,0,,{\i1}Sao không bắn được mày?{\i0}
Dialogue: 0,0:09:39.66,0:09:40.95,Default,,0,0,0,,{\i1}- Khỉ thật!{\i0}\N- Gì vậy?
Dialogue: 0,0:09:46.54,0:09:48.71,Default,,0,0,0,,{\i1}Biết gì thì phun ra hết đi.{\i0}
Dialogue: 0,0:09:52.38,0:09:53.21,Default,,0,0,0,,{\i1}Gì hả?{\i0}
Dialogue: 0,0:09:53.30,0:09:55.26,Default,,0,0,0,,{\i1}Đồ tép riu.{\i0}
Dialogue: 0,0:10:04.23,0:10:07.40,Default,,0,0,0,,{\i1}Bọn cặn bã Arasaka\Nđã giết bằng hữu của ta, ra mặt đi!{\i0}
Dialogue: 0,0:10:07.48,0:10:11.82,Default,,0,0,0,,{\an8}{\i1}Nếu không, ta sẽ giết\Ntừng tên Arasaka một!{\i0}
Dialogue: 0,0:10:21.58,0:10:23.75,Default,,0,0,0,,{\an8}Ừm, khởi đầu không tệ.
Dialogue: 0,0:10:25.88,0:10:28.42,Default,,0,0,0,,Sao cậu lo lắng thế?
Dialogue: 0,0:10:30.67,0:10:31.67,Default,,0,0,0,,Không biết nữa.
Dialogue: 0,0:10:33.30,0:10:35.59,Default,,0,0,0,,- Giờ đến giai đoạn kế tiếp.\N- Ừ.
Dialogue: 0,0:10:38.64,0:10:39.47,Default,,0,0,0,,Kế tiếp?
Dialogue: 0,0:10:40.97,0:10:43.47,Default,,0,0,0,,{\an8}Bọn cặn bã Arasaka\Nđã giết bằng hữu của ta…
Dialogue: 0,0:11:15.84,0:11:18.34,Default,,0,0,0,,Khoan đã! Không cần bạo lực đâu!
Dialogue: 0,0:11:18.97,0:11:20.85,Default,,0,0,0,,Anh biết biểu tượng này chứ?
Dialogue: 0,0:11:20.93,0:11:24.43,Default,,0,0,0,,Tôi không biết gì cả!\NĐừng tiến thêm bước nào về phía tôi!
Dialogue: 0,0:11:24.52,0:11:25.35,Default,,0,0,0,,Thật à?
Dialogue: 0,0:11:25.43,0:11:26.68,Default,,0,0,0,,Đừng lại gần tôi!
Dialogue: 0,0:11:32.44,0:11:33.65,Default,,0,0,0,,Dừng…
Dialogue: 0,0:12:03.76,0:12:06.93,Default,,0,0,0,,Hơi khác với kế hoạch,\Nnhưng kết quả cũng ổn đấy.
Dialogue: 0,0:12:07.02,0:12:08.15,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:12:08.81,0:12:12.77,Default,,0,0,0,,{\an8}Anh là người\Ntrong video giết đám Arasaka à?
Dialogue: 0,0:12:13.61,0:12:14.74,Default,,0,0,0,,Cô là ai?
Dialogue: 0,0:12:15.23,0:12:18.90,Default,,0,0,0,,Tôi biết mà! Chắc chắn là anh. Đợi đã!
Dialogue: 0,0:12:22.20,0:12:23.41,Default,,0,0,0,,Tôi là Yupi!
Dialogue: 0,0:12:23.49,0:12:26.45,Default,,0,0,0,,Người hâm mộ anh. Tôi là fan cứng của anh!
Dialogue: 0,0:12:26.54,0:12:28.92,Default,,0,0,0,,- Người hâm mộ?\N- Video của anh đỉnh lắm!
Dialogue: 0,0:12:29.00,0:12:32.75,Default,,0,0,0,,Cách anh tự mình\Nchống lại bọn Arasaka thật…
Dialogue: 0,0:12:33.25,0:12:35.71,Default,,0,0,0,,Chết tiệt! Quá sức tôi rồi.
Dialogue: 0,0:12:35.80,0:12:36.68,Default,,0,0,0,,Thật điên rồ.
Dialogue: 0,0:12:36.76,0:12:38.18,Default,,0,0,0,,Tôi không thể!
Dialogue: 0,0:12:38.26,0:12:40.22,Default,,0,0,0,,Không, đợi đã! Tôi chết mất!
Dialogue: 0,0:12:40.30,0:12:42.01,Default,,0,0,0,,Trời ơi, đợi đã.
Dialogue: 0,0:12:42.51,0:12:45.47,Default,,0,0,0,,Tôi chưa từng nghĩ mình sẽ gặp được anh!
Dialogue: 0,0:12:45.56,0:12:46.44,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:46.52,0:12:48.44,Default,,0,0,0,,Ồ, đợi đã!
Dialogue: 0,0:12:48.52,0:12:49.90,Default,,0,0,0,,Này, tôi bảo đợi đã!
Dialogue: 0,0:12:49.98,0:12:53.23,Default,,0,0,0,,Thật là! Đợi tôi với! Làm ơn!
Dialogue: 0,0:12:53.31,0:12:55.31,Default,,0,0,0,,- Sao?\N- Tôi muốn ủng hộ lý tưởng của anh.
Dialogue: 0,0:12:55.40,0:12:57.53,Default,,0,0,0,,Hãy để tôi giúp anh.
Dialogue: 0,0:12:57.61,0:12:58.44,Default,,0,0,0,,Giúp tôi?
Dialogue: 0,0:12:59.65,0:13:02.78,Default,,0,0,0,,Đây không phải nơi tốt nhất\Nđể trò chuyện nhỉ?
Dialogue: 0,0:13:02.87,0:13:05.87,Default,,0,0,0,,Hay ta đến chỗ tôi nhé? Nó ở rất gần đây.
Dialogue: 0,0:13:05.95,0:13:07.08,Default,,0,0,0,,D, đi thôi.
Dialogue: 0,0:13:07.16,0:13:11.25,Default,,0,0,0,,{\an8}Cậu nghĩ tôi đáng ngờ lắm đúng không?\NTôi không trách cậu.
Dialogue: 0,0:13:11.33,0:13:14.21,Default,,0,0,0,,{\an8}Nhưng tôi thật sự rất đồng cảm với cậu.
Dialogue: 0,0:13:14.29,0:13:18.09,Default,,0,0,0,,{\an8}Ta nói chuyện lâu hơn chút đi! Làm ơn!
Dialogue: 0,0:13:23.84,0:13:26.34,Default,,0,0,0,,Đây, cứ tự nhiên như ở nhà nhé.
Dialogue: 0,0:13:26.43,0:13:29.14,Default,,0,0,0,,- Uống gì không?\N- Có bia không?
Dialogue: 0,0:13:29.23,0:13:30.86,Default,,0,0,0,,Có chứ.
Dialogue: 0,0:13:33.60,0:13:34.89,Default,,0,0,0,,Ồ! Này.
Dialogue: 0,0:13:34.98,0:13:36.90,Default,,0,0,0,,Hả? Ừm, có hại gì đâu?
Dialogue: 0,0:13:36.98,0:13:37.94,Default,,0,0,0,,Không đời nào!
Dialogue: 0,0:13:40.24,0:13:41.57,Default,,0,0,0,,Đợi chút.
Dialogue: 0,0:13:41.65,0:13:44.07,Default,,0,0,0,,Mặt anh kìa! Ôi trời ơi, trai đẹp!
Dialogue: 0,0:13:44.16,0:13:46.58,Default,,0,0,0,,Thật khó tin! Thật đấy, anh đẹp trai quá!
Dialogue: 0,0:13:46.66,0:13:50.00,Default,,0,0,0,,Nhưng vết bỏng đó có hơi đáng tiếc.
Dialogue: 0,0:13:50.08,0:13:52.21,Default,,0,0,0,,Chỉ một chút thôi.
Dialogue: 0,0:13:57.96,0:13:59.13,Default,,0,0,0,,Cô lấy đâu ra vậy?
Dialogue: 0,0:13:59.21,0:14:02.21,Default,,0,0,0,,Có người quay lại\Nvà lan truyền nó trên mạng.
Dialogue: 0,0:14:02.30,0:14:05.55,Default,,0,0,0,,Tôi có bốn video rồi,\Nmà không tìm ra mấy cái đầu tiên.
Dialogue: 0,0:14:05.64,0:14:07.14,Default,,0,0,0,,Roman có đấy.
Dialogue: 0,0:14:07.22,0:14:09.93,Default,,0,0,0,,- Đợi đã, thật à?\N- Cậu ấy dựng đấy.
Dialogue: 0,0:14:10.02,0:14:12.82,Default,,0,0,0,,Gì cơ? Không thể nào! Cậu dựng hết sao?
Dialogue: 0,0:14:12.89,0:14:15.73,Default,,0,0,0,,Thật à? Là cậu dựng ư? Cậu là thiên tài à?
Dialogue: 0,0:14:15.81,0:14:17.48,Default,,0,0,0,,Xin lỗi. Tôi có điện thoại.
Dialogue: 0,0:14:18.77,0:14:21.77,Default,,0,0,0,,Chào Roman. Lâu rồi không gặp.
Dialogue: 0,0:14:21.86,0:14:23.74,Default,,0,0,0,,{\i1}Xin lỗi. Nhiều việc quá.{\i0}
Dialogue: 0,0:14:23.82,0:14:26.24,Default,,0,0,0,,Ừ, đừng bận tâm.
Dialogue: 0,0:14:26.32,0:14:30.83,Default,,0,0,0,,Này, cậu biết mấy video chống đối Arasaka\Nđang lan truyền chứ?
Dialogue: 0,0:14:30.91,0:14:33.87,Default,,0,0,0,,Ừ… có lẽ thế, nghe quen đấy.
Dialogue: 0,0:14:33.96,0:14:37.21,Default,,0,0,0,,{\i1}Đừng vờ vịt nữa.\NTôi biết cậu là người dựng chúng mà.{\i0}
Dialogue: 0,0:14:37.29,0:14:38.58,Default,,0,0,0,,Hả?
Dialogue: 0,0:14:38.67,0:14:40.42,Default,,0,0,0,,{\i1}Thôi nào.{\i0}
Dialogue: 0,0:14:40.50,0:14:43.00,Default,,0,0,0,,Tôi xem nhiều tác phẩm của Roman rồi.
Dialogue: 0,0:14:43.51,0:14:44.72,Default,,0,0,0,,{\i1}Rõ ràng đến thế à?{\i0}
Dialogue: 0,0:14:46.18,0:14:50.27,Default,,0,0,0,,Thỏa thuận thế này nhé, ngài Paparazzo.\NTôi muốn có quyền phân phối.
Dialogue: 0,0:14:51.64,0:14:53.27,Default,,0,0,0,,Hả? Ông muốn bán chúng ư?
Dialogue: 0,0:14:54.69,0:14:57.19,Default,,0,0,0,,Làm đi. Nghe có lợi cho ta đấy.
Dialogue: 0,0:14:57.81,0:14:59.44,Default,,0,0,0,,- Được thôi.\N- Này!
Dialogue: 0,0:14:59.52,0:15:01.86,Default,,0,0,0,,Ta có thể dựng một studio ở đây.
Dialogue: 0,0:15:01.94,0:15:04.40,Default,,0,0,0,,Tôi có phòng trống. Tôi sẽ mua thiết bị.
Dialogue: 0,0:15:04.49,0:15:05.33,Default,,0,0,0,,Cô làm thế à?
Dialogue: 0,0:15:05.40,0:15:11.07,Default,,0,0,0,,Tôi đã nói sẽ giúp anh mà, đúng không?\NTôi ghét cay ghét đắng Arasaka!
Dialogue: 0,0:15:11.66,0:15:13.62,Default,,0,0,0,,Nên tôi nghiêm túc muốn giúp anh.
Dialogue: 0,0:15:13.70,0:15:15.66,Default,,0,0,0,,Sao cô ghét họ thế?
Dialogue: 0,0:15:16.96,0:15:21.67,Default,,0,0,0,,Bố tôi từng điều hành một công ty PR\Nlàm việc với rất nhiều tập đoàn.
Dialogue: 0,0:15:21.75,0:15:24.84,Default,,0,0,0,,Ông che đậy rất nhiều vết nhơ của Arasaka.
Dialogue: 0,0:15:25.47,0:15:26.85,Default,,0,0,0,,{\an8}Nhưng cuối cùng…
Dialogue: 0,0:15:27.34,0:15:28.34,Default,,0,0,0,,{\an8}chúng lại…
Dialogue: 0,0:15:30.18,0:15:32.60,Default,,0,0,0,,Đủ rồi. Đừng nói chuyện này nữa!
Dialogue: 0,0:15:32.68,0:15:34.93,Default,,0,0,0,,Dù sao, chúng rác rưởi! Rác rưởi!
Dialogue: 0,0:15:35.02,0:15:37.94,Default,,0,0,0,,Chúng cũng giết bạn anh, đúng không?
Dialogue: 0,0:15:38.02,0:15:40.86,Default,,0,0,0,,- Ừ.\N- Thật không thể tha thứ.
Dialogue: 0,0:15:41.44,0:15:44.36,Default,,0,0,0,,Hãy thiêu rụi\Nvà nghiền nát tập đoàn đó nào!
Dialogue: 0,0:15:45.36,0:15:46.36,Default,,0,0,0,,Được đấy.
Dialogue: 0,0:15:46.45,0:15:49.66,Default,,0,0,0,,Cần thiết bị gì cứ nói nhé, Đạo diễn.
Dialogue: 0,0:15:49.74,0:15:54.29,Default,,0,0,0,,- Cậu có cần phòng dựng không?\N- Không cần làm vậy đâu.
Dialogue: 0,0:15:54.37,0:15:56.62,Default,,0,0,0,,Đừng ngại mà.
Dialogue: 0,0:15:57.50,0:16:00.29,Default,,0,0,0,,Hãy biến nơi này\Nthành sào huyệt của Đội D nào!
Dialogue: 0,0:16:00.38,0:16:02.63,Default,,0,0,0,,- Được đấy.\N- Quyết định thế nhé!
Dialogue: 0,0:16:02.71,0:16:04.38,Default,,0,0,0,,Cạn lon!
Dialogue: 0,0:16:08.84,0:16:12.80,Default,,0,0,0,,{\i1}Vẫn không chịu lộ diện à?\NTa sẽ tiếp tục cho đến khi mi ra mặt!{\i0}
Dialogue: 0,0:16:14.14,0:16:16.27,Default,,0,0,0,,Địa chỉ đang lan truyền
Dialogue: 0,0:16:16.35,0:16:18.89,Default,,0,0,0,,mà vẫn không lần ra được chúng sao?
Dialogue: 0,0:16:19.52,0:16:21.77,Default,,0,0,0,,Đây là vị trí của tên miền à?
Dialogue: 0,0:16:21.86,0:16:25.53,Default,,0,0,0,,Chúng đang chạy giả lập?\NCùng một lúc? Nhiều thế này ư?
Dialogue: 0,0:16:27.28,0:16:30.91,Default,,0,0,0,,Tín hiệu gây nhiễu trong video\Ncũng không bình thường.
Dialogue: 0,0:16:33.99,0:16:38.37,Default,,0,0,0,,Con người có thể làm được chuyện này sao?
Dialogue: 0,0:16:43.42,0:16:44.46,Default,,0,0,0,,Ôi!
Dialogue: 0,0:16:45.88,0:16:49.72,Default,,0,0,0,,{\i1}Nếu không, ta sẽ giết\Ntừng tên Arasaka một!{\i0}
Dialogue: 0,0:16:51.89,0:16:55.81,Default,,0,0,0,,- Chuyện này nghiêm trọng rồi đây.\N- Hả? Ừ.
Dialogue: 0,0:16:56.68,0:16:57.60,Default,,0,0,0,,Này D.
Dialogue: 0,0:16:57.68,0:16:58.51,Default,,0,0,0,,Sao?
Dialogue: 0,0:16:58.60,0:17:00.73,Default,,0,0,0,,Capri còn ở bên anh nhỉ?
Dialogue: 0,0:17:01.35,0:17:04.73,Default,,0,0,0,,- Sao lại hỏi thế?\N- Gần đây anh không nhắc đến Capri.
Dialogue: 0,0:17:05.23,0:17:07.36,Default,,0,0,0,,Thế à? Cô ấy vẫn ở quanh đây thôi.
Dialogue: 0,0:17:07.44,0:17:09.82,Default,,0,0,0,,- Ồ. Vậy thì tốt.\N- Đúng chứ?
Dialogue: 0,0:17:18.62,0:17:21.75,Default,,0,0,0,,THỨC TỈNH ĐI
Dialogue: 0,0:17:46.07,0:17:47.61,Default,,0,0,0,,Đây là…
Dialogue: 0,0:17:49.03,0:17:50.66,Default,,0,0,0,,Nước Rắn ư…
Dialogue: 0,0:17:58.08,0:18:00.79,Default,,0,0,0,,{\an8}Xử chúng đi! Arasaka khốn kiếp!
Dialogue: 0,0:18:00.87,0:18:01.75,Default,,0,0,0,,Làm ơn.
Dialogue: 0,0:18:03.21,0:18:04.75,Default,,0,0,0,,Làm ơn, tha cho tôi…
Dialogue: 0,0:18:22.60,0:18:25.19,Default,,0,0,0,,Cô tiết lộ thông tin về cuộc tấn công à?
Dialogue: 0,0:18:25.27,0:18:27.82,Default,,0,0,0,,Ừ. Đại thành công nhỉ?
Dialogue: 0,0:18:28.32,0:18:33.66,Default,,0,0,0,,Nhân tiện, ước gì cậu dùng cái camera mới\Ntôi mua cho dịp này
Dialogue: 0,0:18:33.74,0:18:36.37,Default,,0,0,0,,thay vì cái cũ của cậu.
Dialogue: 0,0:18:36.45,0:18:37.70,Default,,0,0,0,,Hôm nay tôi về đây.
Dialogue: 0,0:18:38.49,0:18:41.20,Default,,0,0,0,,Hả? Còn việc biên tập video?
Dialogue: 0,0:18:42.08,0:18:42.91,Default,,0,0,0,,Để mai tính.
Dialogue: 0,0:18:43.50,0:18:46.84,Default,,0,0,0,,Tùy cậu. Tôi muốn có nó trong hôm nay.
Dialogue: 0,0:18:47.33,0:18:50.38,Default,,0,0,0,,Mọi người, đến lúc chuẩn bị rút lui rồi.
Dialogue: 0,0:19:02.14,0:19:05.81,Default,,0,0,0,,D…
Dialogue: 0,0:19:18.41,0:19:19.41,Default,,0,0,0,,Omi đấy à?
Dialogue: 0,0:19:22.45,0:19:24.49,Default,,0,0,0,,Đợi đã. Cậu là Omi đúng không?
Dialogue: 0,0:19:27.33,0:19:29.96,Default,,0,0,0,,Cậu đã xem video nhỉ? Cậu sao rồi?
Dialogue: 0,0:19:30.84,0:19:32.72,Default,,0,0,0,,- Tàm tạm.\N- Thế à?
Dialogue: 0,0:19:33.51,0:19:34.47,Default,,0,0,0,,Tốt quá rồi.
Dialogue: 0,0:19:36.30,0:19:38.22,Default,,0,0,0,,Cậu làm việc này suốt à?
Dialogue: 0,0:19:39.01,0:19:39.84,Default,,0,0,0,,Việc này?
Dialogue: 0,0:19:40.85,0:19:41.77,Default,,0,0,0,,Việc…
Dialogue: 0,0:19:43.18,0:19:44.93,Default,,0,0,0,,trả thù như thế này.
Dialogue: 0,0:19:45.93,0:19:48.31,Default,,0,0,0,,- Đúng vậy.\N- Suốt thời gian qua?
Dialogue: 0,0:19:48.40,0:19:51.57,Default,,0,0,0,,- Từ đó đến nay?\N- Cuối cùng tôi cũng có manh mối.
Dialogue: 0,0:19:51.65,0:19:53.82,Default,,0,0,0,,- Và đó là Arasaka?\N- Ừ.
Dialogue: 0,0:19:53.90,0:19:55.90,Default,,0,0,0,,Cậu định chống lại một tập đoàn ư?
Dialogue: 0,0:19:55.99,0:19:58.33,Default,,0,0,0,,Cậu không phải đối thủ của họ đâu.
Dialogue: 0,0:19:58.82,0:20:02.03,Default,,0,0,0,,Ý cậu là tôi nên từ bỏ?\NQuên hết mọi chuyện sao?
Dialogue: 0,0:20:02.66,0:20:04.37,Default,,0,0,0,,Cậu quên được chưa?
Dialogue: 0,0:20:04.45,0:20:06.91,Default,,0,0,0,,Tôi sẽ không quên được. Nhưng trả thù…
Dialogue: 0,0:20:07.00,0:20:08.54,Default,,0,0,0,,Cậu như vậy là tốt rồi.
Dialogue: 0,0:20:08.62,0:20:11.41,Default,,0,0,0,,Cậu cũng vậy. Trả thù thì được gì chứ?
Dialogue: 0,0:20:11.50,0:20:12.79,Default,,0,0,0,,Nó chẳng đưa ai trở…
Dialogue: 0,0:20:12.88,0:20:14.26,Default,,0,0,0,,Ngược lại đấy, Omi.
Dialogue: 0,0:20:15.05,0:20:16.30,Default,,0,0,0,,Họ vẫn ở đây.
Dialogue: 0,0:20:18.38,0:20:19.80,Default,,0,0,0,,Mọi người vẫn ở đây.
Dialogue: 0,0:20:19.89,0:20:23.06,Default,,0,0,0,,Tôi thấy họ mỗi đêm. Tất cả mọi người.
Dialogue: 0,0:20:23.72,0:20:24.55,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:20:24.64,0:20:29.60,Default,,0,0,0,,Tôi thấy họ mỗi ngày trong mơ.\NTrong mơ, tôi không thể cứu được họ.
Dialogue: 0,0:20:33.23,0:20:35.15,Default,,0,0,0,,Cậu trả thù thì nó kết thúc à?
Dialogue: 0,0:20:35.65,0:20:39.32,Default,,0,0,0,,Mọi người sẽ cười nói:\N"Làm tốt lắm"? Họ sẽ thế sao?
Dialogue: 0,0:20:39.99,0:20:41.33,Default,,0,0,0,,Có mà nằm mơ.
Dialogue: 0,0:20:42.28,0:20:45.33,Default,,0,0,0,,Tôi không biết. Nhưng họ luôn ở đó.
Dialogue: 0,0:20:46.08,0:20:47.75,Default,,0,0,0,,Tôi còn biết làm gì nữa?
Dialogue: 0,0:20:50.00,0:20:53.59,Default,,0,0,0,,Xin lỗi. Tôi không định nói những lời này.
Dialogue: 0,0:20:53.67,0:20:56.34,Default,,0,0,0,,Xin lỗi. Đừng để bị ốm nhé, Omi.
Dialogue: 0,0:21:05.06,0:21:06.98,Default,,0,0,0,,ĐANG GỌI\NTALIA
Dialogue: 0,0:21:13.81,0:21:14.73,Default,,0,0,0,,ĐANG GỌI\NFAN
Dialogue: 0,0:21:14.82,0:21:15.65,Default,,0,0,0,,Ai vậy?
Dialogue: 0,0:21:17.15,0:21:19.99,Default,,0,0,0,,{\i1}Rất vui được gặp cậu! Tôi là fan cứng đấy.{\i0}
Dialogue: 0,0:21:20.07,0:21:22.74,Default,,0,0,0,,{\i1}Fan ư? Sao cô có số của tôi?{\i0}
Dialogue: 0,0:21:22.82,0:21:25.86,Default,,0,0,0,,{\i1}Ồ, tôi có năng khiếu\Ncho mấy chuyện đó lắm.{\i0}
Dialogue: 0,0:21:25.95,0:21:28.95,Default,,0,0,0,,{\i1}- Hả?\N- Đừng sợ hãi vậy chứ.{\i0}
Dialogue: 0,0:21:29.04,0:21:33.00,Default,,0,0,0,,{\i1}Cậu chàng đó… D phải không?\NCậu ấy đúng là một{\i0} netrunner {\i1}xuất sắc.{\i0}
Dialogue: 0,0:21:33.08,0:21:35.83,Default,,0,0,0,,{\i1}Công nghệ cậu ấy dùng có vẻ rất đặc biệt.{\i0}
Dialogue: 0,0:21:36.34,0:21:38.84,Default,,0,0,0,,{\i1}Cô quan tâm đến D\Nthì xem trên nền tảng đi.{\i0}
Dialogue: 0,0:21:38.92,0:21:44.09,Default,,0,0,0,,{\i1}Không. Tôi đã nói tôi là fan của cậu mà.{\i0}
Dialogue: 0,0:21:44.59,0:21:48.51,Default,,0,0,0,,- Được rồi.\N{\i1}- Tôi muốn gặp thiên tài ở hậu trường.{\i0}
Dialogue: 0,0:21:49.10,0:21:52.60,Default,,0,0,0,,{\i1}Tôi cứ xem miết các video.\NQuay rất đẹp, nhưng còn biên tập?{\i0}
Dialogue: 0,0:21:52.69,0:21:55.48,Default,,0,0,0,,{\i1}- Đỉnh nóc kịch trần!{\i0}\N- Cảm ơn cô.
Dialogue: 0,0:21:55.56,0:21:59.61,Default,,0,0,0,,{\i1}Nếu chuyên môn của tôi\Ncó thể giúp ích được, tôi sẽ nghe ý cậu.{\i0}
Dialogue: 0,0:21:59.69,0:22:00.52,Default,,0,0,0,,Chuyên môn ư?
Dialogue: 0,0:22:00.61,0:22:02.78,Default,,0,0,0,,{\an8}Siêu thiết bị, hack.
Dialogue: 0,0:22:02.86,0:22:07.66,Default,,0,0,0,,{\an8}Nói không phải khoe, tôi có thể lo liệu\Nnếu cậu gặp vấn đề với chúng.
Dialogue: 0,0:22:08.45,0:22:10.79,Default,,0,0,0,,{\i1}Trang web của cậu chắc tốn kém lắm nhỉ?{\i0}
Dialogue: 0,0:22:10.87,0:22:14.79,Default,,0,0,0,,{\i1}Công nghệ của bạn cậu cũng vậy.\NNó thật mạnh mẽ, thật kỳ lạ.{\i0}
Dialogue: 0,0:22:14.88,0:22:18.55,Default,,0,0,0,,{\i1}Nhắc mới nhớ,\Ncậu có thấy D hơi khác không?{\i0}
Dialogue: 0,0:22:18.63,0:22:21.59,Default,,0,0,0,,- Khác sao?\N{\i1}- Tôi sẽ không tò mò, có thể D vẫn ổn.{\i0}
Dialogue: 0,0:22:21.67,0:22:25.80,Default,,0,0,0,,{\i1}Nhưng siêu thiết bị phi pháp\Nrất nguy hiểm cho não.{\i0}
Dialogue: 0,0:22:26.39,0:22:29.14,Default,,0,0,0,,{\an8}Cô đang nói siêu cuồng nhân à?
Dialogue: 0,0:22:29.22,0:22:31.10,Default,,0,0,0,,{\an8}{\i1}Đó là một trong nhiều rủi ro.{\i0}
Dialogue: 0,0:22:31.18,0:22:35.98,Default,,0,0,0,,{\an8}{\i1}Công nghệ cực đoan có thể có\Ntác dụng phụ nặng nề, như mất trí nhớ.{\i0}
Dialogue: 0,0:22:36.06,0:22:37.64,Default,,0,0,0,,{\an8}Anh ấy không quên gì cả.
Dialogue: 0,0:22:37.73,0:22:40.65,Default,,0,0,0,,{\an8}Nhưng có vẻ như anh ấy nóng tính hơn.
Dialogue: 0,0:22:41.23,0:22:42.57,Default,,0,0,0,,{\an8}Ừm.
Dialogue: 0,0:22:43.36,0:22:45.57,Default,,0,0,0,,{\i1}Vì bản thân cậu, hãy để ý nhé.{\i0}
Dialogue: 0,0:22:45.66,0:22:50.50,Default,,0,0,0,,{\i1}Nếu có gì bất thường,\Nhãy gọi cho tôi. Có thể tôi sẽ giúp được.{\i0}
Dialogue: 0,0:22:50.58,0:22:52.12,Default,,0,0,0,,Đây là quảng cáo à?
Dialogue: 0,0:22:52.20,0:22:56.62,Default,,0,0,0,,{\i1}Dĩ nhiên là không. Tôi không cần tiền,\Nmà cần cậu làm video hoài hoài.{\i0}
Dialogue: 0,0:22:57.13,0:23:02.80,Default,,0,0,0,,{\an8}- Cô chắc cô không phải fan của D chứ?\N- Cậu không tin tôi là fan của cậu à?
Dialogue: 0,0:23:05.59,0:23:06.88,Default,,0,0,0,,Tôi tin cô.
Dialogue: 0,0:23:09.26,0:23:13.47,Default,,0,0,0,,Soulkiller có thể cứu Talia ư?
Dialogue: 0,0:23:13.56,0:23:16.48,Default,,0,0,0,,Có thể. Hoặc nó chỉ là\Ntruyền thuyết đô thị.
Dialogue: 0,0:23:16.98,0:23:18.23,Default,,0,0,0,,Nhưng tôi chỉ nghĩ
Dialogue: 0,0:23:18.31,0:23:20.27,Default,,0,0,0,,đây là cơ hội tốt nhất của ta.
Dialogue: 0,0:23:21.61,0:23:24.66,Default,,0,0,0,,{\an8}Số hóa linh hồn và hoán đổi cơ thể sao?
Dialogue: 0,0:23:25.32,0:23:26.74,Default,,0,0,0,,{\an8}Chuyện đó…
Dialogue: 0,0:23:26.82,0:23:28.82,Default,,0,0,0,,Tôi cũng đã tự nghiên cứu.
Dialogue: 0,0:23:29.32,0:23:31.70,Default,,0,0,0,,Có vẻ nó không hoàn toàn là bịa đặt.
Dialogue: 0,0:23:32.45,0:23:37.00,Default,,0,0,0,,Không chỉ vậy, có thể chúng ta\Ncòn liên quan đến nó nhiều hơn ta nghĩ.
Dialogue: 0,0:23:37.50,0:23:38.50,Default,,0,0,0,,Ý anh là sao?
Dialogue: 0,0:23:40.67,0:23:42.26,Default,,0,0,0,,Chồng cô.
Dialogue: 0,0:23:47.68,0:23:48.51,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:23:49.76,0:23:51.26,Default,,0,0,0,,Capricorn?
Dialogue: 0,0:24:36.89,0:24:39.64,Default,,0,0,0,,Giờ tôi chỉ làm được đến thế thôi.
Dialogue: 0,0:24:41.10,0:24:41.93,Default,,0,0,0,,Cô là ai?
Dialogue: 0,0:24:44.07,0:24:48.37,Default,,0,0,0,,{\an8}Này, cô không muốn làm gì đó\Ntuyệt vời hơn sao?
Dialogue: 0,0:26:20.95,0:26:23.95,Default,,0,0,0,,Biên dịch: Khanh Tran
