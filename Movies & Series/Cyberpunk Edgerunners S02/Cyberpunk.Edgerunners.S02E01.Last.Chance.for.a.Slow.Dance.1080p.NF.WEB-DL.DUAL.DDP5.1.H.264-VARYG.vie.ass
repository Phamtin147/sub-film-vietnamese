Dialogue: 0,0:00:13.22,0:00:15.43,Default,,0,0,0,,{\i1}Này, Roman! Này!{\i0}
Dialogue: 0,0:00:15.52,0:00:18.94,Default,,0,0,0,,{\i1}Hả? Cậu ấy đi rồi.\NChắc cậu ấy không nghe thấy mình.{\i0}
Dialogue: 0,0:00:19.02,0:00:21.27,Default,,0,0,0,,{\i1}Roman cầm camera thì gọi cũng vô ích.{\i0}
Dialogue: 0,0:00:21.35,0:00:24.19,Default,,0,0,0,,{\i1}- Vô ích?\N- Cậu ấy không nghe đâu. Mê đắm rồi.{\i0}
Dialogue: 0,0:00:24.27,0:00:25.60,Default,,0,0,0,,{\i1}Mê đắm cái gì?{\i0}
Dialogue: 0,0:00:25.69,0:00:26.65,Default,,0,0,0,,{\i1}Camera.{\i0}
Dialogue: 0,0:00:26.74,0:00:27.95,Default,,0,0,0,,{\i1}Sao lại mê thứ đó{\i0}…
Dialogue: 0,0:00:28.53,0:00:31.95,Default,,0,0,0,,{\i1}- Roman nói là thích nó.\N- Cậu ấy dùng nó quay BD à?{\i0}
Dialogue: 0,0:00:32.03,0:00:34.45,Default,,0,0,0,,{\i1}Không, cậu ấy thích phim.{\i0}
Dialogue: 0,0:00:35.04,0:00:37.71,Default,,0,0,0,,{\i1}"Phim"? Phim là gì?{\i0}
Dialogue: 0,0:00:39.21,0:00:43.47,Default,,0,0,0,,{\i1}Đúng là đồ ngốc.\NPhim xem trên màn hình trong phòng tối ấy.{\i0}
Dialogue: 0,0:00:44.54,0:00:50.09,Default,,0,0,0,,{\i1}- Này Biết Tuốt! Cậu từng xem chưa?\N- À thì… chưa.{\i0}
Dialogue: 0,0:01:19.25,0:01:22.42,Default,,0,0,0,,DỰA TRÊN\NCYBERPUNK 2077
Dialogue: 0,0:01:22.50,0:01:25.63,Default,,0,0,0,,MỘT VŨ TRỤ DO MIKE PONDSMITH SÁNG TẠO
Dialogue: 0,0:02:49.17,0:02:52.01,Default,,0,0,0,,Mày không làm ở đây đúng không?
Dialogue: 0,0:03:04.39,0:03:06.89,Default,,0,0,0,,{\an8}Mất 30 giây không lấy lại được, Miguel.
Dialogue: 0,0:03:06.98,0:03:08.61,Default,,0,0,0,,{\an8}Vừa vừa phải phải thôi.
Dialogue: 0,0:03:09.27,0:03:10.65,Default,,0,0,0,,{\an8}Xin lỗi, King.
Dialogue: 0,0:03:11.65,0:03:13.65,Default,,0,0,0,,Cứ để cái xác ở đó đi!
Dialogue: 0,0:03:14.19,0:03:16.78,Default,,0,0,0,,Miguel. Cậu quá cẩu thả.
Dialogue: 0,0:03:17.82,0:03:20.36,Default,,0,0,0,,Này, đừng nói chuyện này với Emily nhé.
Dialogue: 0,0:03:24.04,0:03:26.79,Default,,0,0,0,,{\i1}Khốn nạn! Hộp nào y hộp nấy!{\i0}
Dialogue: 0,0:03:26.87,0:03:29.16,Default,,0,0,0,,{\i1}Đừng nóng, Miguel. Biết trước rồi mà.{\i0}
Dialogue: 0,0:03:29.25,0:03:30.34,Default,,0,0,0,,{\i1}Cái nào đây?{\i0}
Dialogue: 0,0:03:30.42,0:03:32.13,Default,,0,0,0,,{\i1}Bên trái. Hàng đó.{\i0}
Dialogue: 0,0:03:32.21,0:03:34.46,Default,,0,0,0,,{\i1}Nhảy hai cái sang phải. Chính xác.{\i0}
Dialogue: 0,0:03:38.97,0:03:40.06,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:03:40.14,0:03:41.48,Default,,0,0,0,,{\i1}Chắc là cái này chứ?{\i0}
Dialogue: 0,0:03:41.55,0:03:42.89,Default,,0,0,0,,{\i1}Giơ lên xem nào.{\i0}
Dialogue: 0,0:03:42.97,0:03:47.81,Default,,0,0,0,,{\i1}AR-CPRN-XR-05.\NKhông nghi ngờ gì nữa, cái này đấy.{\i0}
Dialogue: 0,0:03:47.89,0:03:49.18,Default,,0,0,0,,Được rồi! Ối!
Dialogue: 0,0:03:49.27,0:03:50.98,Default,,0,0,0,,Anh đang làm cái quái gì vậy?
Dialogue: 0,0:03:51.06,0:03:54.86,Default,,0,0,0,,{\i1}Này! Chú ý thao tác đi!\NTrong vali có con chip sinh học đấy!{\i0}
Dialogue: 0,0:03:54.94,0:03:55.90,Default,,0,0,0,,Avida?
Dialogue: 0,0:03:55.99,0:03:59.91,Default,,0,0,0,,Ồn ào quá, tôi biết mà! Lạnh quá!
Dialogue: 0,0:04:00.82,0:04:04.66,Default,,0,0,0,,{\i1}Đã lấy được mục tiêu.\NNày! Tôi nói đã lấy được vali.{\i0}
Dialogue: 0,0:04:05.79,0:04:07.88,Default,,0,0,0,,King! Anh có nghe không đấy?
Dialogue: 0,0:04:13.21,0:04:15.17,Default,,0,0,0,,Sao? Miguel, lấy được vali rồi à?
Dialogue: 0,0:04:15.26,0:04:17.22,Default,,0,0,0,,Thôi nào. Này.
Dialogue: 0,0:04:17.30,0:04:19.05,Default,,0,0,0,,Ta có nó rồi! Phắn thôi!
Dialogue: 0,0:04:19.13,0:04:21.80,Default,,0,0,0,,{\i1}Thật là, người nào người nấy…{\i0}
Dialogue: 0,0:04:22.30,0:04:23.30,Default,,0,0,0,,{\i1}Xe thì sao?{\i0}
Dialogue: 0,0:04:23.39,0:04:25.23,Default,,0,0,0,,{\i1}Đã hack chiếc đỗ trước mặt.{\i0}
Dialogue: 0,0:04:25.31,0:04:26.48,Default,,0,0,0,,{\i1}Còn tài xế?{\i0}
Dialogue: 0,0:04:26.56,0:04:29.81,Default,,0,0,0,,{\i1}Vậy sẽ có phụ phí! Mọi người tự lo đi…{\i0}
Dialogue: 0,0:04:30.44,0:04:31.48,Default,,0,0,0,,{\i1}Đợi đã.{\i0}
Dialogue: 0,0:04:33.15,0:04:33.99,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:04:34.86,0:04:36.57,Default,,0,0,0,,- Meshuga?\N{\i1}- Khỉ gió, rút…{\i0}
Dialogue: 0,0:04:38.65,0:04:39.61,Default,,0,0,0,,Cửa ra!
Dialogue: 0,0:04:41.86,0:04:43.70,Default,,0,0,0,,King! Quét đi!
Dialogue: 0,0:05:05.93,0:05:07.06,Default,,0,0,0,,Miguel!
Dialogue: 0,0:05:25.28,0:05:26.53,Default,,0,0,0,,Này! Đứng lại…
Dialogue: 0,0:05:30.83,0:05:31.96,Default,,0,0,0,,Miguel, xe kìa!
Dialogue: 0,0:05:32.04,0:05:33.67,Default,,0,0,0,,Biết rồi mà!
Dialogue: 0,0:05:35.04,0:05:37.08,Default,,0,0,0,,{\i1}Này, đằng kia có gì cháy kìa.{\i0}
Dialogue: 0,0:05:37.17,0:05:39.42,Default,,0,0,0,,{\i1}Bên đó là đất của Arasaka mà?{\i0}
Dialogue: 0,0:05:39.92,0:05:41.05,Default,,0,0,0,,{\i1}Vụ gì đây?{\i0}
Dialogue: 0,0:05:41.13,0:05:43.26,Default,,0,0,0,,{\i1}Có khi nào là tin nóng không?{\i0}
Dialogue: 0,0:05:43.89,0:05:45.48,Default,,0,0,0,,{\i1}Dĩ nhiên là không rồi.{\i0}
Dialogue: 0,0:05:50.56,0:05:51.81,Default,,0,0,0,,Nhưng ta cứ dán mắt…
Dialogue: 0,0:05:52.69,0:05:54.28,Default,,0,0,0,,Này! Nhìn đường đi…
Dialogue: 0,0:05:54.35,0:05:56.77,Default,,0,0,0,,- Này, đứng lại đó! Ối!\N- Nói gì hả, nhóc?
Dialogue: 0,0:05:56.86,0:05:58.28,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:06:10.20,0:06:11.08,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:06:11.16,0:06:12.70,Default,,0,0,0,,Hôm nay là ngày gì vậy?
Dialogue: 0,0:06:13.92,0:06:16.46,Default,,0,0,0,,Emily, cô ổn chứ? Này!
Dialogue: 0,0:06:16.54,0:06:18.00,Default,,0,0,0,,Tàm tạm…
Dialogue: 0,0:06:18.09,0:06:20.72,Default,,0,0,0,,King! Anh bị cái quái gì vậy, ông già?
Dialogue: 0,0:06:20.80,0:06:23.05,Default,,0,0,0,,Miguel, vali…
Dialogue: 0,0:06:23.13,0:06:25.47,Default,,0,0,0,,Kệ nó đi! Vụ này thua rồi.
Dialogue: 0,0:06:26.09,0:06:27.47,Default,,0,0,0,,Này! Đứng lại đó!
Dialogue: 0,0:06:37.02,0:06:37.85,Default,,0,0,0,,Avida…
Dialogue: 0,0:06:41.32,0:06:44.16,Default,,0,0,0,,Avida!
Dialogue: 0,0:06:57.17,0:06:58.84,Default,,0,0,0,,Avida!
Dialogue: 0,0:07:18.44,0:07:20.73,Default,,0,0,0,,Nào, Emily. Cố lên.
Dialogue: 0,0:07:21.73,0:07:24.65,Default,,0,0,0,,Ta phải mau đưa cô đến phòng khám.
Dialogue: 0,0:07:26.36,0:07:30.11,Default,,0,0,0,,Được rồi. Tự anh thoát thân đi, Miguel.
Dialogue: 0,0:07:30.20,0:07:33.91,Default,,0,0,0,,Đừng có vớ vẩn! Khốn kiếp. King bị gì vậy?
Dialogue: 0,0:07:34.50,0:07:36.00,Default,,0,0,0,,{\i1}Siêu cuồng nhân.{\i0}
Dialogue: 0,0:07:36.96,0:07:38.92,Default,,0,0,0,,Trong phút chốc bọn tôi chạm mắt.
Dialogue: 0,0:07:39.75,0:07:40.67,Default,,0,0,0,,{\i1}Ánh mắt đó…{\i0}
Dialogue: 0,0:07:41.71,0:07:42.75,Default,,0,0,0,,{\i1}Là siêu cuồng nhân.{\i0}
Dialogue: 0,0:07:49.84,0:07:53.68,Default,,0,0,0,,{\i1}Tiếp nhận yêu cầu. Tiến hành vô hiệu hóa\Nmục tiêu siêu cuồng nhân.{\i0}
Dialogue: 0,0:07:54.18,0:07:59.10,Default,,0,0,0,,{\i1}Đồng thời xác minh tình trạng hợp đồng\Nvới Đội Chấn thương. Đang gửi yêu cầu…{\i0}
Dialogue: 0,0:08:07.57,0:08:08.82,Default,,0,0,0,,Lộn xộn ghê nơi.
Dialogue: 0,0:08:09.53,0:08:12.62,Default,,0,0,0,,Chào. Vất vả rồi.
Dialogue: 0,0:08:12.70,0:08:14.91,Default,,0,0,0,,Hử? Hai người xem gì đấy?
Dialogue: 0,0:08:14.99,0:08:16.37,Default,,0,0,0,,Video quay tự do.
Dialogue: 0,0:08:16.45,0:08:19.75,Default,,0,0,0,,Video? Ta là tiệm BD mà nhỉ?
Dialogue: 0,0:08:19.83,0:08:22.92,Default,,0,0,0,,Loại video này ít nhiều vẫn có nhu cầu.
Dialogue: 0,0:08:23.00,0:08:26.05,Default,,0,0,0,,Ồ! Đây là vụ Arasaka\Ntrên bản tin hôm qua à?
Dialogue: 0,0:08:26.13,0:08:29.97,Default,,0,0,0,,Ừ. MaxTac đã cố tóm một siêu cuồng nhân.
Dialogue: 0,0:08:30.76,0:08:33.55,Default,,0,0,0,,Nhưng tên đó có đặc quyền VIP bạch kim.
Dialogue: 0,0:08:33.64,0:08:36.23,Default,,0,0,0,,Đội Chấn thương tái cả mặt cứu hắn.
Dialogue: 0,0:08:36.31,0:08:39.27,Default,,0,0,0,,Chỉ có Arasaka là lãnh đủ.
Dialogue: 0,0:08:39.35,0:08:41.64,Default,,0,0,0,,Arasaka cũng sa sút sao ấy nhỉ?
Dialogue: 0,0:08:41.73,0:08:46.19,Default,,0,0,0,,Họ toàn bị tập kích ấy.\NNày, cậu quay vụ này à?
Dialogue: 0,0:08:46.28,0:08:49.08,Default,,0,0,0,,- Ừ.\N- Hử? Không tệ nhỉ?
Dialogue: 0,0:08:53.12,0:08:54.25,Default,,0,0,0,,Đội Chấn thương kìa.
Dialogue: 0,0:08:55.33,0:08:59.13,Default,,0,0,0,,Ông già đó đã cố hết sức so với tuổi,\Nnhưng cuối cùng cũng hết.
Dialogue: 0,0:08:59.21,0:09:00.34,Default,,0,0,0,,Ông ta nổi tiếng à?
Dialogue: 0,0:09:00.41,0:09:01.75,Default,,0,0,0,,Được gọi là "King".
Dialogue: 0,0:09:01.83,0:09:03.21,Default,,0,0,0,,"King"?
Dialogue: 0,0:09:03.71,0:09:04.67,Default,,0,0,0,,Nhà quê!
Dialogue: 0,0:09:04.75,0:09:08.50,Default,,0,0,0,,- Buồn cười nhỉ? Tên thật còn hài hơn…\N- Vậy ông trả bao nhiêu?
Dialogue: 0,0:09:08.59,0:09:09.59,Default,,0,0,0,,Hả?
Dialogue: 0,0:09:11.43,0:09:12.27,Default,,0,0,0,,Hai trăm.
Dialogue: 0,0:09:12.34,0:09:14.59,Default,,0,0,0,,Rẻ quá. Rẻ đến ngu ngốc.
Dialogue: 0,0:09:14.68,0:09:17.02,Default,,0,0,0,,{\an8}Quên đi! Bản tin sẽ trả nhiều hơn!
Dialogue: 0,0:09:17.10,0:09:21.02,Default,,0,0,0,,Có thể N54 sẽ trả tối đa một trăm.
Dialogue: 0,0:09:22.40,0:09:24.53,Default,,0,0,0,,Được rồi. Hai trăm.
Dialogue: 0,0:09:26.27,0:09:28.06,Default,,0,0,0,,Có hơi trẻ con đấy.
Dialogue: 0,0:09:29.49,0:09:33.62,Default,,0,0,0,,Mau bắt tay vào việc đi!\NMớ BD thô đó không tự biên tập chúng đâu!
Dialogue: 0,0:09:34.16,0:09:35.75,Default,,0,0,0,,Rồi rồi.
Dialogue: 0,0:09:36.62,0:09:40.87,Default,,0,0,0,,{\an8}Vậy bai nhé. Thật là, lại làm việc.
Dialogue: 0,0:09:48.67,0:09:49.92,Default,,0,0,0,,{\an8}Nghe này, Roman.
Dialogue: 0,0:09:50.01,0:09:53.60,Default,,0,0,0,,{\an8}Cậu muốn kiếm tiền\Nthì chỉ có BD thôi. Trải nghiệm.
Dialogue: 0,0:09:54.22,0:09:58.14,Default,,0,0,0,,{\an8}Có biết dạo này Jessie kiếm được bao nhiêu\Nnhờ biên tập BD không?
Dialogue: 0,0:09:58.22,0:10:01.10,Default,,0,0,0,,{\an8}Với BD, "biên tập"\Nchẳng phải là tối ưu hóa sao?
Dialogue: 0,0:10:01.64,0:10:03.77,Default,,0,0,0,,{\an8}Biên tập video thì khác.
Dialogue: 0,0:10:03.85,0:10:06.60,Default,,0,0,0,,{\an8}BD chỉ là trải nghiệm gián tiếp.\NCó gì vui chứ?
Dialogue: 0,0:10:06.69,0:10:09.32,Default,,0,0,0,,{\an8}Cậu còn trẻ mà suy nghĩ cổ hủ quá đa.
Dialogue: 0,0:10:09.40,0:10:13.57,Default,,0,0,0,,{\an8}Cái đang bán được là BD.\NKhông phải thứ phim ảnh cậu thích.
Dialogue: 0,0:10:14.36,0:10:16.74,Default,,0,0,0,,Điện ảnh hết thời rồi.
Dialogue: 0,0:10:18.20,0:10:20.08,Default,,0,0,0,,Ta không thể kể chuyện bằng BD.
Dialogue: 0,0:10:20.58,0:10:23.33,Default,,0,0,0,,Chuyện kể? Ai cần chứ?
Dialogue: 0,0:10:23.91,0:10:27.91,Default,,0,0,0,,BD không có rào cản. Không có gì ngăn cách\Nkhán giả và câu chuyện.
Dialogue: 0,0:10:28.42,0:10:31.72,Default,,0,0,0,,Những bộ phim hay sẽ vượt qua rào cản đó.
Dialogue: 0,0:10:32.21,0:10:35.30,Default,,0,0,0,,Nó có nhưng sẽ bị vượt qua,\Ncó nhưng sẽ biến mất.
Dialogue: 0,0:10:35.80,0:10:40.22,Default,,0,0,0,,{\an8}Không thể cứ nói "không cần" là xong.\NVậy nên mới có câu chuyện.
Dialogue: 0,0:10:40.31,0:10:42.81,Default,,0,0,0,,Triết lý kinh thật.
Dialogue: 0,0:10:44.52,0:10:47.65,Default,,0,0,0,,Không thích BD thì thử Maelstrom đi.
Dialogue: 0,0:10:47.73,0:10:49.48,Default,,0,0,0,,Maelstrom?
Dialogue: 0,0:10:49.57,0:10:50.86,Default,,0,0,0,,Đám đó nguy hiểm lắm.
Dialogue: 0,0:10:50.94,0:10:52.86,Default,,0,0,0,,Tưởng cậu cần tiền?
Dialogue: 0,0:10:52.94,0:10:57.65,Default,,0,0,0,,Video quay chúng cài siêu thiết bị\Nkhó kiếm nhưng bán chạy lắm.
Dialogue: 0,0:10:57.74,0:11:00.74,Default,,0,0,0,,Nó là cảnh giết người thật,\Nnó đi ngược với mỹ học.
Dialogue: 0,0:11:00.83,0:11:03.58,Default,,0,0,0,,- Với lại, phải quay thế nào đây?\N- Tự nghĩ đi!
Dialogue: 0,0:11:03.66,0:11:06.70,Default,,0,0,0,,Đơn giản thì làm gì có giá?
Dialogue: 0,0:11:06.79,0:11:10.21,Default,,0,0,0,,Có cuộn phim đó đi,\Ntôi sẽ trả đủ cho cậu mua camera xịn.
Dialogue: 0,0:11:10.29,0:11:13.46,Default,,0,0,0,,Vốn dĩ camera tốt\Ncòn không được bán đại trà mà.
Dialogue: 0,0:11:15.59,0:11:19.22,Default,,0,0,0,,Máy 35mm. Tôi có một cái 35mm.
Dialogue: 0,0:11:21.10,0:11:25.35,Default,,0,0,0,,{\an8}Có phim nữa. Chà,\Nnhưng không biết còn xài được không…
Dialogue: 0,0:11:26.02,0:11:30.19,Default,,0,0,0,,Quay được cảnh đó, nó là của cậu.\NKhông thì cứ BD mà làm.
Dialogue: 0,0:11:31.27,0:11:33.23,Default,,0,0,0,,{\an8}Maelstrom sao?
Dialogue: 0,0:11:41.95,0:11:43.12,Default,,0,0,0,,{\an8}Lại là cô Yang à?
Dialogue: 0,0:11:43.20,0:11:44.87,Default,,0,0,0,,{\an8}Đây là lần thứ mấy rồi?
Dialogue: 0,0:11:44.95,0:11:47.24,Default,,0,0,0,,{\an8}Bệnh nhân tỉnh rồi.
Dialogue: 0,0:11:48.12,0:11:51.50,Default,,0,0,0,,Năm mươi ngày? Tôi ngủ lâu đến thế ư ?
Dialogue: 0,0:11:51.59,0:11:55.43,Default,,0,0,0,,Thật đáng ngạc nhiên nhỉ?\NNhưng ít nhất anh còn sống.
Dialogue: 0,0:11:55.51,0:11:58.97,Default,,0,0,0,,Nếu không phải hạng bạch kim,\Nanh đã bị MaxTac xử đẹp rồi.
Dialogue: 0,0:11:59.05,0:12:00.76,Default,,0,0,0,,May mà trả ối tiền nhỉ?
Dialogue: 0,0:12:00.85,0:12:03.35,Default,,0,0,0,,"Xử đẹp"? "MaxTac"?
Dialogue: 0,0:12:03.43,0:12:07.02,Default,,0,0,0,,Ừ. Anh đã bước một chân\Nthành siêu cuồng nhân rồi.
Dialogue: 0,0:12:07.52,0:12:10.19,Default,,0,0,0,,Siêu cuồng nhân? Tôi sao?
Dialogue: 0,0:12:10.27,0:12:12.56,Default,,0,0,0,,Rất tiếc phải nói,\Nanh đã lạm dụng siêu thiết bị.
Dialogue: 0,0:12:12.65,0:12:15.45,Default,,0,0,0,,Cơ thể con người\Nchỉ chịu được mức nào đó thôi.
Dialogue: 0,0:12:15.53,0:12:18.78,Default,,0,0,0,,Cộng thêm căng thẳng\Nvà những thứ khác, và…
Dialogue: 0,0:12:18.86,0:12:21.32,Default,,0,0,0,,Không, tôi khỏe như vâm.
Dialogue: 0,0:12:21.82,0:12:23.86,Default,,0,0,0,,Chưa từng thấy căng thẳng.
Dialogue: 0,0:12:23.95,0:12:27.16,Default,,0,0,0,,Cũng có lúc phát bệnh\Nmà không có dấu hiệu lâm sàng.
Dialogue: 0,0:12:27.25,0:12:31.17,Default,,0,0,0,,Vẫn còn nhiều điều chưa sáng tỏ\Nvề các yếu tố kích hoạt nó.
Dialogue: 0,0:12:31.25,0:12:33.63,Default,,0,0,0,,Nhưng trường hợp của anh rất dễ hiểu.
Dialogue: 0,0:12:33.71,0:12:36.46,Default,,0,0,0,,Anh đã vượt quá giới hạn. Đó là sự thật.
Dialogue: 0,0:12:36.96,0:12:41.47,Default,,0,0,0,,Chúng tôi đã bỏ các phần cứng dư thừa\Nvà thế vào những bộ phận nhẹ tải hơn.
Dialogue: 0,0:12:41.55,0:12:46.56,Default,,0,0,0,,Tạm thời, đừng lo về việc đầu anh\Nmuốn nổ tung. Tôi bảo đảm đấy.
Dialogue: 0,0:12:47.31,0:12:48.35,Default,,0,0,0,,Phải mất bao lâu?
Dialogue: 0,0:12:49.27,0:12:51.40,Default,,0,0,0,,Mất bao lâu tôi mới có thể dùng…
Dialogue: 0,0:12:51.48,0:12:53.69,Default,,0,0,0,,Đừng có dại, anh bạn. Muốn chết à?
Dialogue: 0,0:12:53.77,0:12:56.31,Default,,0,0,0,,Tuyệt đối không được cài siêu thiết bị.
Dialogue: 0,0:12:56.40,0:12:57.61,Default,,0,0,0,,Đùa à?
Dialogue: 0,0:12:57.69,0:12:59.82,Default,,0,0,0,,Ngay khi anh khởi động lại…
Dialogue: 0,0:12:59.90,0:13:00.94,Default,,0,0,0,,Bùm!
Dialogue: 0,0:13:01.03,0:13:03.70,Default,,0,0,0,,Và anh không có bảo hiểm bảo vệ mình nữa.
Dialogue: 0,0:13:03.78,0:13:06.57,Default,,0,0,0,,Nếu lần tới MaxTac đến, anh sẽ hết đời.
Dialogue: 0,0:13:07.66,0:13:08.70,Default,,0,0,0,,{\an8}Chà, là thế đấy.
Dialogue: 0,0:13:09.41,0:13:12.50,Default,,0,0,0,,Giờ hãy nói về hóa đơn của anh nhé.
Dialogue: 0,0:13:12.58,0:13:14.12,Default,,0,0,0,,May mà anh kiếm cũng khá!
Dialogue: 0,0:13:14.21,0:13:16.63,Default,,0,0,0,,Mấy ai kham nổi khoản phí y tế này chứ!
Dialogue: 0,0:13:16.71,0:13:20.34,Default,,0,0,0,,May cho anh là chúng tôi siết được vài thứ\Nbù vào phần thiếu!
Dialogue: 0,0:13:20.42,0:13:21.59,Default,,0,0,0,,Chúa phù hộ anh!
Dialogue: 0,0:13:23.26,0:13:24.09,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:13:25.68,0:13:27.10,Default,,0,0,0,,TÀI SẢN BỊ TỊCH THU
Dialogue: 0,0:13:33.31,0:13:36.48,Default,,0,0,0,,{\i1}- King! Anh còn sống à?\N- Đại loại thế.{\i0}
Dialogue: 0,0:13:36.57,0:13:38.95,Default,,0,0,0,,{\i1}Ra vậy. Tốt quá.{\i0}
Dialogue: 0,0:13:39.03,0:13:40.99,Default,,0,0,0,,{\i1}Này, anh nói "King" à?{\i0}
Dialogue: 0,0:13:41.07,0:13:43.99,Default,,0,0,0,,{\i1}Miguel đấy à? Các cậu ở Kiếp Sau à?{\i0}
Dialogue: 0,0:13:44.07,0:13:45.57,Default,,0,0,0,,{\i1}Này, là anh ấy sao?{\i0}
Dialogue: 0,0:13:45.66,0:13:47.41,Default,,0,0,0,,{\i1}Xin lỗi, tôi sẽ gọi lại sau.{\i0}
Dialogue: 0,0:13:51.33,0:13:53.12,Default,,0,0,0,,Miguel, dừng lại đi!
Dialogue: 0,0:13:54.04,0:13:56.71,Default,,0,0,0,,Này, thôi đi! Tôi bảo dừng lại, Miguel!
Dialogue: 0,0:14:01.59,0:14:04.13,Default,,0,0,0,,Xin lỗi mọi người. Đừng để ý nhé.
Dialogue: 0,0:14:05.34,0:14:06.97,Default,,0,0,0,,King, anh ổn chứ?
Dialogue: 0,0:14:08.18,0:14:09.10,Default,,0,0,0,,Ừ.
Dialogue: 0,0:14:12.64,0:14:14.23,Default,,0,0,0,,Anh mềm yếu rồi à?
Dialogue: 0,0:14:14.31,0:14:16.52,Default,,0,0,0,,Sao lại đâm đầu chịu đấm của Miguel…
Dialogue: 0,0:14:17.31,0:14:19.48,Default,,0,0,0,,Chắc tôi cần phục hồi chức năng.
Dialogue: 0,0:14:22.07,0:14:26.03,Default,,0,0,0,,Anh ổn rồi chứ?\NRất tiếc phải nói điều này, nhưng…
Dialogue: 0,0:14:26.12,0:14:27.91,Default,,0,0,0,,Siêu cuồng nhân?
Dialogue: 0,0:14:27.99,0:14:29.99,Default,,0,0,0,,- Ừ.\N- Giờ thì không việc gì.
Dialogue: 0,0:14:30.74,0:14:34.74,Default,,0,0,0,,Nhưng siêu thiết bị của tôi bị tắt cả rồi.\NKích hoạt lại là đi đời.
Dialogue: 0,0:14:35.37,0:14:37.83,Default,,0,0,0,,{\an8}- Đùa à?\N- Nói tôi nghe, Meshuga.
Dialogue: 0,0:14:38.34,0:14:39.22,Default,,0,0,0,,Chuyện gì đã…
Dialogue: 0,0:14:39.30,0:14:40.89,Default,,0,0,0,,Anh mà chết thì tốt rồi.
Dialogue: 0,0:14:41.59,0:14:42.51,Default,,0,0,0,,Này.
Dialogue: 0,0:14:42.59,0:14:45.38,Default,,0,0,0,,Lúc đó anh hoàn toàn phát điên.
Dialogue: 0,0:14:45.47,0:14:48.47,Default,,0,0,0,,Nếu anh không mất trí, Emily vẫn sẽ…
Dialogue: 0,0:14:49.47,0:14:51.26,Default,,0,0,0,,- Miguel…\N- Đừng động vào tôi.
Dialogue: 0,0:14:52.73,0:14:54.61,Default,,0,0,0,,Miguel, cậu…
Dialogue: 0,0:14:55.10,0:14:57.35,Default,,0,0,0,,Đã nói là đừng động vào tôi.
Dialogue: 0,0:14:59.61,0:15:01.90,Default,,0,0,0,,Đợi đã, Miguel! Không phải tại King…
Dialogue: 0,0:15:01.98,0:15:03.36,Default,,0,0,0,,- Buông ra!\N- Miguel!
Dialogue: 0,0:15:03.44,0:15:06.90,Default,,0,0,0,,Kể tôi nghe đi! Tôi không nhớ gì cả.
Dialogue: 0,0:15:07.53,0:15:10.07,Default,,0,0,0,,Tôi đã làm gì? Emily…
Dialogue: 0,0:15:10.16,0:15:11.75,Default,,0,0,0,,Anh đã giết cô ấy!
Dialogue: 0,0:15:12.66,0:15:14.79,Default,,0,0,0,,- Tôi đã làm thế ư?\N- Tại sao…
Dialogue: 0,0:15:15.37,0:15:19.29,Default,,0,0,0,,Tại sao Emily chết,\Ncòn thằng ngu như anh lại sống?
Dialogue: 0,0:15:19.38,0:15:21.13,Default,,0,0,0,,Lẽ ra anh nên chết với cô ấy!
Dialogue: 0,0:15:21.21,0:15:23.63,Default,,0,0,0,,Vậy mà là {\i1}cyberpunk{\i0} đấy!
Dialogue: 0,0:15:27.59,0:15:30.89,Default,,0,0,0,,- Meshuga…\N- Hôm nay anh nên về đi.
Dialogue: 0,0:15:30.97,0:15:32.72,Default,,0,0,0,,Nói chuyện sau nhé.
Dialogue: 0,0:15:38.73,0:15:40.48,Default,,0,0,0,,Này!
Dialogue: 0,0:15:40.98,0:15:41.98,Default,,0,0,0,,Anh King!
Dialogue: 0,0:15:47.70,0:15:50.75,Default,,0,0,0,,Này, nhớ bọn này không?
Dialogue: 0,0:15:52.33,0:15:56.67,Default,,0,0,0,,Dĩ nhiên là không rồi. "Vua" to lắm mà!
Dialogue: 0,0:15:58.08,0:15:59.29,Default,,0,0,0,,Ánh mắt đó là sao?
Dialogue: 0,0:16:02.29,0:16:06.54,Default,,0,0,0,,Biết tên thật của hắn là gì không?\NWeak Kingsley. Kingsley yếu đuối.
Dialogue: 0,0:16:07.05,0:16:11.22,Default,,0,0,0,,"Yếu đuối" giờ hợp với hắn hơn.\NThằng khốn giết đồng đội!
Dialogue: 0,0:16:11.30,0:16:14.18,Default,,0,0,0,,Đừng bao giờ ló mặt ở đây nữa!
Dialogue: 0,0:16:27.32,0:16:30.45,Default,,0,0,0,,{\i1}Tôi đã đến tòa nhà ông nói.\NNó bị niêm phong rồi.{\i0}
Dialogue: 0,0:16:30.53,0:16:32.62,Default,,0,0,0,,{\an8}{\i1}Ông chắc là ở đây chứ?{\i0}
Dialogue: 0,0:16:32.70,0:16:35.29,Default,,0,0,0,,{\an8}{\i1}Chắc loanh quanh đó thôi.{\i0}
Dialogue: 0,0:16:35.37,0:16:36.62,Default,,0,0,0,,{\an8}"Loanh quanh"?
Dialogue: 0,0:16:36.70,0:16:38.74,Default,,0,0,0,,{\an8}{\i1}Thử sục sạo quanh đó đi.{\i0}
Dialogue: 0,0:16:39.54,0:16:43.42,Default,,0,0,0,,Hời hợt quá mà…
Dialogue: 0,0:17:42.31,0:17:44.44,Default,,0,0,0,,Ai đây?
Dialogue: 0,0:17:49.53,0:17:50.45,Default,,0,0,0,,Trẻ con ư?
Dialogue: 0,0:17:51.03,0:17:54.03,Default,,0,0,0,,{\an8}Xin lỗi. Tôi đã tự tiện quay…
Dialogue: 0,0:17:54.53,0:17:56.07,Default,,0,0,0,,{\an8}Ối! Đau!
Dialogue: 0,0:17:57.53,0:18:01.95,Default,,0,0,0,,Xin lỗi, nhưng tôi nghĩ\Nlên tiếng sẽ nguy hiểm. Nên là…
Dialogue: 0,0:18:02.79,0:18:06.96,Default,,0,0,0,,Thật ra, tôi đang tìm Maelstrom…
Dialogue: 0,0:18:10.13,0:18:12.63,Default,,0,0,0,,Cơ thể nhóc chủ yếu vẫn là hữu cơ à?
Dialogue: 0,0:18:12.72,0:18:13.85,Default,,0,0,0,,- Hử?\N- Tại sao?
Dialogue: 0,0:18:14.47,0:18:15.68,Default,,0,0,0,,Tôi không biết.
Dialogue: 0,0:18:16.18,0:18:19.60,Default,,0,0,0,,Tôi không hứng thú lắm… Ui da!
Dialogue: 0,0:18:20.68,0:18:23.68,Default,,0,0,0,,Sao có thể ở nguyên trong cơ thể đó vậy?
Dialogue: 0,0:18:25.15,0:18:26.61,Default,,0,0,0,,Ối! Gì chứ?
Dialogue: 0,0:18:26.69,0:18:27.98,Default,,0,0,0,,Thử băng qua đi.
Dialogue: 0,0:18:32.19,0:18:35.61,Default,,0,0,0,,Ừm… Thật sự xin lỗi\Nvì đã quay phim. Tôi xin lỗi…
Dialogue: 0,0:18:35.70,0:18:37.87,Default,,0,0,0,,Đó không phải thứ chúng ta đang nói.
Dialogue: 0,0:18:37.95,0:18:40.12,Default,,0,0,0,,Cậu thấy tôi làm rồi.
Dialogue: 0,0:18:40.20,0:18:42.04,Default,,0,0,0,,Cho tôi xem cậu băng qua nó đi.
Dialogue: 0,0:18:42.12,0:18:43.33,Default,,0,0,0,,Tôi không thể!
Dialogue: 0,0:18:44.04,0:18:46.79,Default,,0,0,0,,{\an8}- Tại sao?\N- Không có siêu thiết bị không được!
Dialogue: 0,0:18:47.29,0:18:50.75,Default,,0,0,0,,{\an8}Cậu nghĩ có thể sống\Nmà không cần siêu thiết bị đúng không?
Dialogue: 0,0:18:51.30,0:18:52.80,Default,,0,0,0,,{\an8}Vậy chứng minh đi.
Dialogue: 0,0:18:59.89,0:19:04.69,Default,,0,0,0,,{\an8}A, cô ấy đây rồi.\NTalia! Bộ ổn định chạy thế nào?
Dialogue: 0,0:19:04.77,0:19:06.36,Default,,0,0,0,,{\an8}Tuyệt. Không vấn đề gì.
Dialogue: 0,0:19:06.44,0:19:09.40,Default,,0,0,0,,{\an8}- Maelstrom.\N- Thằng nhãi nào thế?
Dialogue: 0,0:19:09.90,0:19:12.32,Default,,0,0,0,,{\an8}Ồ, nó hữu cơ hết này.
Dialogue: 0,0:19:12.40,0:19:14.19,Default,,0,0,0,,{\an8}Thật luôn. Nó không sửa gì cả.
Dialogue: 0,0:19:14.28,0:19:16.91,Default,,0,0,0,,Có vẻ như rất quan tâm đến các anh.
Dialogue: 0,0:19:18.57,0:19:20.20,Default,,0,0,0,,Không, không phải ý đó…
Dialogue: 0,0:19:20.28,0:19:24.95,Default,,0,0,0,,{\an8}- Tao rất hiểu cảm giác của mày.\N- Chào mừng đến câu lạc bộ.
Dialogue: 0,0:19:25.46,0:19:26.75,Default,,0,0,0,,{\an8}Chào mừng…
Dialogue: 0,0:19:27.75,0:19:29.34,Default,,0,0,0,,Này, đừng làm loạn nữa.
Dialogue: 0,0:19:29.42,0:19:32.26,Default,,0,0,0,,Yên tâm đi, trông mày sẽ ngầu lắm.
Dialogue: 0,0:19:37.89,0:19:39.64,Default,,0,0,0,,Gặp sau nhé, Talia!
Dialogue: 0,0:19:41.72,0:19:43.39,Default,,0,0,0,,Thằng này ồn thật đấy.
Dialogue: 0,0:20:01.58,0:20:03.92,Default,,0,0,0,,Cơ mà, còn trẻ mà có mắt nhìn phết.
Dialogue: 0,0:20:03.99,0:20:06.62,Default,,0,0,0,,Là người trần mắt thịt ngượng thật ấy chứ.
Dialogue: 0,0:20:07.41,0:20:10.16,Default,,0,0,0,,Cơ mà, tao muốn thử em này lâu rồi.
Dialogue: 0,0:20:10.25,0:20:11.84,Default,,0,0,0,,Ô, có đồ chơi mới à?
Dialogue: 0,0:20:12.84,0:20:14.59,Default,,0,0,0,,Đã bảo đừng la mà.
Dialogue: 0,0:20:16.42,0:20:17.59,Default,,0,0,0,,Ồ, đúng rồi.
Dialogue: 0,0:20:17.67,0:20:19.59,Default,,0,0,0,,Muốn gây mê không?
Dialogue: 0,0:20:20.72,0:20:21.64,Default,,0,0,0,,{\an8}Là "không" à?
Dialogue: 0,0:20:21.72,0:20:23.01,Default,,0,0,0,,{\an8}Dũng cảm quá!
Dialogue: 0,0:20:23.68,0:20:25.64,Default,,0,0,0,,{\an8}- Trẻ con à?\N- Tùy mày.
Dialogue: 0,0:20:26.18,0:20:27.35,Default,,0,0,0,,{\an8}Bắt đầu thôi.
Dialogue: 0,0:20:35.90,0:20:37.82,Default,,0,0,0,,Chết tiệt. Kế hoạch tiêu rồi.
Dialogue: 0,0:20:39.20,0:20:40.53,Default,,0,0,0,,Hắn không có ở đây.
Dialogue: 0,0:20:41.32,0:20:42.57,Default,,0,0,0,,Này, cậu ổn chứ?
Dialogue: 0,0:20:51.12,0:20:52.50,Default,,0,0,0,,{\an8}Là đồng nghiệp!
Dialogue: 0,0:20:57.13,0:21:00.59,Default,,0,0,0,,Này, cậu tự ra được không?\NTôi không cứu cậu hai lần đâu!
Dialogue: 0,0:21:07.93,0:21:08.76,Default,,0,0,0,,Này.
Dialogue: 0,0:21:09.73,0:21:12.65,Default,,0,0,0,,Mày biết hắn mà hả? Tên hắn là Helio.
Dialogue: 0,0:21:12.73,0:21:14.32,Default,,0,0,0,,Nói tao biết hắn ở đâu đi.
Dialogue: 0,0:21:15.61,0:21:19.16,Default,,0,0,0,,- Hiểu tình thế của mày chứ?\N- Helio rời băng rồi!
Dialogue: 0,0:21:20.90,0:21:22.53,Default,,0,0,0,,Tao hỏi hắn đang ở đâu.
Dialogue: 0,0:21:25.58,0:21:28.00,Default,,0,0,0,,{\an8}Hiểu rồi, hắn ẩn náu ở đây!
Dialogue: 0,0:21:29.96,0:21:30.88,Default,,0,0,0,,{\an8}Tuyệt.
Dialogue: 0,0:21:41.43,0:21:42.60,Default,,0,0,0,,{\an8}Camera của mình!
Dialogue: 0,0:21:45.30,0:21:46.93,Default,,0,0,0,,{\an8}Ít ra còn có máy dự phòng.
Dialogue: 0,0:21:48.31,0:21:49.98,Default,,0,0,0,,{\an8}Ồ, anh trai!
Dialogue: 0,0:21:52.27,0:21:55.36,Default,,0,0,0,,{\an8}- Tốt quá, cứ lo anh ra cửa trước…\N- Đồ ngốc này!
Dialogue: 0,0:21:55.44,0:21:56.94,Default,,0,0,0,,{\an8}Có biết nếu không có tôi,
Dialogue: 0,0:21:57.02,0:22:00.65,Default,,0,0,0,,{\an8}có thể cậu đã bị giết,\Nbị băm nhỏ hoặc xâm hại không?
Dialogue: 0,0:22:01.78,0:22:03.49,Default,,0,0,0,,{\an8}Cảm ơn anh đã cứu tôi.
Dialogue: 0,0:22:04.11,0:22:06.61,Default,,0,0,0,,{\an8}À, tôi cũng muốn bày tỏ chút lòng thành.
Dialogue: 0,0:22:07.33,0:22:10.79,Default,,0,0,0,,{\an8}- Bày tỏ sao?\N- Tôi sống ở gần đây.
Dialogue: 0,0:22:13.00,0:22:14.08,Default,,0,0,0,,{\an8}Thêm nữa.
Dialogue: 0,0:22:14.88,0:22:16.63,Default,,0,0,0,,{\an8}Hết rồi.
Dialogue: 0,0:22:17.50,0:22:20.59,Default,,0,0,0,,{\an8}Anh uống hết rồi.\NTrong nhà chỉ có bấy nhiêu thôi.
Dialogue: 0,0:22:22.09,0:22:24.26,Default,,0,0,0,,- Không cảm ơn nữa à?\N- Ừm…
Dialogue: 0,0:22:25.26,0:22:26.35,Default,,0,0,0,,Để tôi mua thêm.
Dialogue: 0,0:22:40.86,0:22:42.95,Default,,0,0,0,,Trời sắp tối rồi…
Dialogue: 0,0:22:44.49,0:22:46.91,Default,,0,0,0,,Biết nói sao với bố đây?
Dialogue: 0,0:22:49.20,0:22:51.66,Default,,0,0,0,,Quay cái này cũng vô ích.
Dialogue: 0,0:22:58.59,0:23:00.51,Default,,0,0,0,,{\i1}Lũ ngu đó là ai nhỉ?{\i0}
Dialogue: 0,0:23:01.00,0:23:04.71,Default,,0,0,0,,{\i1}Này, cứ ngồi yên\Nđể bị coi thường thế à? Đi thôi!{\i0}
Dialogue: 0,0:23:04.80,0:23:06.72,Default,,0,0,0,,{\i1}Lũ cớm nghĩ có thể giẫm lên ta ư?{\i0}
Dialogue: 0,0:23:06.80,0:23:08.93,Default,,0,0,0,,{\i1}- Khỉ gió, xe tôi!{\i0}\N- Cậu xem gì thế?
Dialogue: 0,0:23:11.47,0:23:14.22,Default,,0,0,0,,{\i1}Burst Panic: Đụng độ kinh hoàng.{\i0}
Dialogue: 0,0:23:15.98,0:23:17.19,Default,,0,0,0,,Chưa nghe bao giờ.
Dialogue: 0,0:23:18.19,0:23:19.48,Default,,0,0,0,,{\i1}Là bọn chúng! Tóm được rồi!{\i0}
Dialogue: 0,0:23:19.56,0:23:20.94,Default,,0,0,0,,Chắc vậy nhỉ?
Dialogue: 0,0:23:26.07,0:23:28.78,Default,,0,0,0,,{\i1}Đồ du côn! Lên đi! Nhào vô!{\i0}
Dialogue: 0,0:23:28.87,0:23:31.96,Default,,0,0,0,,Bối cảnh là Vùng Đất Hoang à?
Dialogue: 0,0:23:32.04,0:23:34.46,Default,,0,0,0,,Ừ. Phim du mục mà.
Dialogue: 0,0:23:36.54,0:23:37.54,Default,,0,0,0,,{\i1}Im đi!{\i0}
Dialogue: 0,0:23:38.42,0:23:40.42,Default,,0,0,0,,{\i1}Có chút dũng khí đi!{\i0}
Dialogue: 0,0:23:40.50,0:23:42.00,Default,,0,0,0,,{\i1}Thằng khốn nào vậy?{\i0}
Dialogue: 0,0:23:42.09,0:23:42.97,Default,,0,0,0,,{\i1}Nghe đây!{\i0}
Dialogue: 0,0:23:44.09,0:23:47.05,Default,,0,0,0,,{\i1}Ta là cảnh sát trưởng của vùng đất này!{\i0}
Dialogue: 0,0:23:48.09,0:23:49.38,Default,,0,0,0,,{\i1}Đồ cặn bã!{\i0}
Dialogue: 0,0:23:50.51,0:23:51.97,Default,,0,0,0,,{\i1}Đưa khẩu Lexington đây.{\i0}
Dialogue: 0,0:23:53.85,0:23:56.48,Default,,0,0,0,,{\i1}Không ngờ mình lại dùng Lexington.{\i0}
Dialogue: 0,0:23:57.06,0:23:59.69,Default,,0,0,0,,{\i1}Thật nhớ những ngày mới vào nghề.{\i0}
Dialogue: 0,0:24:07.45,0:24:08.41,Default,,0,0,0,,{\i1}Avida…{\i0}
Dialogue: 0,0:24:11.87,0:24:14.04,Default,,0,0,0,,{\i1}Giá mà tôi được gặp cô lần cuối…{\i0}
Dialogue: 0,0:24:16.29,0:24:17.12,Default,,0,0,0,,Avida?
Dialogue: 0,0:24:17.21,0:24:19.13,Default,,0,0,0,,ĐANG GỌI\NAVIDA
Dialogue: 0,0:24:31.22,0:24:32.14,Default,,0,0,0,,{\an8}Avida!
Dialogue: 0,0:26:39.89,0:26:42.89,Default,,0,0,0,,Biên dịch: Khanh Tran
