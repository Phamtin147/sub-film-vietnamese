Dialogue: 0,0:01:37.10,0:01:38.68,Default,,0,0,0,,CYBERPUNK EDGERUNNERS
Dialogue: 0,0:01:38.77,0:01:40.81,Default,,0,0,0,,Tên khốn đó đã bắn hạ Basilisk rồi!
Dialogue: 0,0:01:40.90,0:01:42.49,Default,,0,0,0,,Tên môi giới đã đưa\Nmình thông tin giả rồi.
Dialogue: 0,0:01:42.57,0:01:43.99,Default,,0,0,0,,Toàn quân gần như bị xóa sổ.
Dialogue: 0,0:01:44.07,0:01:44.99,Default,,0,0,0,,Lập tức gọi viện trợ!
Dialogue: 0,0:01:45.07,0:01:46.11,Default,,0,0,0,,Khốn kiếp! Đuổi theo!
Dialogue: 0,0:01:46.20,0:01:47.83,Default,,0,0,0,,Hình như hắn muốn chạy\Nđến Thành phố Night đó.
Dialogue: 0,0:01:47.91,0:01:51.16,Default,,0,0,0,,Dù chuyện gì xảy ra cũng không\Nđược để Arasaka lấy siêu khung xương!
Dialogue: 0,0:01:52.95,0:01:54.45,Default,,0,0,0,,Sao? Giờ đi đâu đây?
Dialogue: 0,0:01:54.54,0:01:55.62,Default,,0,0,0,,Tới chỗ Arasaka!
Dialogue: 0,0:01:55.71,0:01:57.67,Default,,0,0,0,,{\an8}Arasaka? Trung tâm thành phố à?
Dialogue: 0,0:01:57.75,0:01:58.79,Default,,0,0,0,,Chính xác.
Dialogue: 0,0:01:58.88,0:02:00.34,Default,,0,0,0,,Sao lần nào cũng là Arasaka vậy?
Dialogue: 0,0:02:00.42,0:02:02.09,Default,,0,0,0,,Chúng ta phải cứu Lucy ra trước đã!
Dialogue: 0,0:02:02.17,0:02:04.34,Default,,0,0,0,,Nhưng sao cô ấy lại ở chỗ đám Arasaka chứ?
Dialogue: 0,0:02:04.42,0:02:08.34,Default,,0,0,0,,Faraday nói là trong thỏa thuận của\Nhắn với chúng bao gồm cả Lucy nữa.
Dialogue: 0,0:02:10.47,0:02:12.22,Default,,0,0,0,,Bây giờ tôi phải chợp mắt năm phút.
Dialogue: 0,0:02:12.31,0:02:14.44,Default,,0,0,0,,Lại nữa hả? Đáng ghét thiệt! Hình như
Dialogue: 0,0:02:14.52,0:02:16.65,Default,,0,0,0,,càng ngày thuốc càng\Nhết tác dụng nhanh hơn.
Dialogue: 0,0:02:18.19,0:02:20.40,Default,,0,0,0,,Nè! Lính của Militech đuổi tới rồi kìa!
Dialogue: 0,0:02:20.48,0:02:22.94,Default,,0,0,0,,Ráng cắt đuôi đi! David\Ncần được nghỉ ngơi năm phút.
Dialogue: 0,0:02:23.02,0:02:24.73,Default,,0,0,0,,Hả? Lúc này sao?
Dialogue: 0,0:02:24.82,0:02:25.82,Default,,0,0,0,,Ờm.
Dialogue: 0,0:02:25.90,0:02:29.24,Default,,0,0,0,,Năm phút thôi hả? Cứ để tôi câu\Ngiờ cho cậu ấy ngủ một giấc luôn.
Dialogue: 0,0:02:33.49,0:02:34.78,Default,,0,0,0,,Vậy tôi giao phía trước cho ông.
Dialogue: 0,0:02:34.87,0:02:37.54,Default,,0,0,0,,Được thôi, đã đến lúc xử chúng rồi!
Dialogue: 0,0:02:55.93,0:03:00.81,Default,,0,0,0,,Ya ya ya ya, ông làm tốt\Nlắm ông già! Yahoo… Yeah!
Dialogue: 0,0:03:02.27,0:03:04.27,Default,,0,0,0,,Quá đã!
Dialogue: 0,0:03:05.65,0:03:08.61,Default,,0,0,0,,Ủa, cái gì ở đằng trước vậy?\NLần này là lính của Arasaka!
Dialogue: 0,0:03:08.70,0:03:11.37,Default,,0,0,0,,{\an8}Sợ gì? Cứ việc đâm xuyên\Nqua chúng, rồi đi tiếp!
Dialogue: 0,0:03:11.45,0:03:14.29,Default,,0,0,0,,Chống lại một tiểu đội không\Nnổi đâu. Chúng ta xuống đây thôi.
Dialogue: 0,0:03:14.37,0:03:15.83,Default,,0,0,0,,Cái gì? Nè! Ria mép!
Dialogue: 0,0:03:16.58,0:03:18.79,Default,,0,0,0,,{\an8}Quân Militech gần như bị xóa sổ hoàn
Dialogue: 0,0:03:18.87,0:03:21.08,Default,,0,0,0,,toàn. Hiện giờ mục tiêu đã tiến vào Thành\Nphố Night, đội thu hồi của chúng ta đang
Dialogue: 0,0:03:21.17,0:03:23.38,Default,,0,0,0,,bám
Dialogue: 0,0:03:23.46,0:03:25.67,Default,,0,0,0,,theo hắn. Muốn che đậy vụ\Nnày chắc không dễ dàng đâu.
Dialogue: 0,0:03:26.34,0:03:30.18,Default,,0,0,0,,Đây là hậu quả của việc đặt cược mọi\Nthứ vào một tên môi giới như Faraday đó.
Dialogue: 0,0:03:30.84,0:03:33.47,Default,,0,0,0,,Dựa theo lộ trình của hắn thì có xác suất
Dialogue: 0,0:03:33.55,0:03:36.43,Default,,0,0,0,,74% là đang tiến đến\Ncao ốc tập đoàn chúng ta.
Dialogue: 0,0:03:36.51,0:03:38.72,Default,,0,0,0,,Ý ông là tới đây hả? Tại sao vậy?
Dialogue: 0,0:03:38.81,0:03:41.06,Default,,0,0,0,,Tôi cũng không rõ lắm. Hắn không thể nào
Dialogue: 0,0:03:41.14,0:03:43.64,Default,,0,0,0,,biết được là chúng ta có\Nliên quan tới chuyện này.
Dialogue: 0,0:03:43.73,0:03:46.40,Default,,0,0,0,,Chết tiệt. Liên lạc với\Nđội an ninh nội bộ đi.
Dialogue: 0,0:03:46.48,0:03:49.32,Default,,0,0,0,,Cô chắc chưa đó? Làm\Nvậy sẽ tới tai cấp trên.
Dialogue: 0,0:03:49.95,0:03:52.87,Default,,0,0,0,,Phải gây náo động thì mới dễ dàng bỏ trốn
Dialogue: 0,0:03:52.95,0:03:55.91,Default,,0,0,0,,được. Tên Faraday chết tiệt! Không\Ncó việc gì theo đúng kế hoạch hết.
Dialogue: 0,0:03:56.87,0:03:59.83,Default,,0,0,0,,{\an8}Cứ thử tưởng tượng một chút coi. Kẻ môi
Dialogue: 0,0:03:59.91,0:04:02.87,Default,,0,0,0,,giới đường phố như tao gặp gián điệp của\NArasaka trong tòa tháp của họ. Tao được
Dialogue: 0,0:04:02.96,0:04:05.92,Default,,0,0,0,,vậy coi như thăng chức nhanh rồi đúng\Nkhông? Bất cứ ai
Dialogue: 0,0:04:06.00,0:04:08.96,Default,,0,0,0,,sống ở thành phố này cũng cần
Dialogue: 0,0:04:09.05,0:04:12.01,Default,,0,0,0,,phấn đấu vươn lên càng cao càng\Ntốt. Đây chỉ là một bước đệm trên
Dialogue: 0,0:04:12.09,0:04:14.88,Default,,0,0,0,,đường đi lên của tao.
Dialogue: 0,0:04:17.06,0:04:18.40,Default,,0,0,0,,Faraday.
Dialogue: 0,0:04:18.47,0:04:20.47,Default,,0,0,0,,Kiwi hả? Làm gì mà lâu vậy?
Dialogue: 0,0:04:21.06,0:04:23.81,Default,,0,0,0,,Mặc dù David đã lắp siêu khung xương đúng
Dialogue: 0,0:04:23.90,0:04:26.70,Default,,0,0,0,,như kế hoạch của chúng ta rồi, nhưng mà\Nvẫn không thể xóa sổ đám Militech đó.
Dialogue: 0,0:04:27.32,0:04:28.24,Default,,0,0,0,,Nói tiếp đi.
Dialogue: 0,0:04:28.32,0:04:30.32,Default,,0,0,0,,Tôi không ngờ cậu ta cứ liên tục chuyển
Dialogue: 0,0:04:30.40,0:04:32.40,Default,,0,0,0,,đổi, mặc dù có thể trở thành siêu cuồng\Nnhân nhưng không bao lâu sẽ tỉnh lại. Nếu
Dialogue: 0,0:04:32.49,0:04:34.49,Default,,0,0,0,,David
Dialogue: 0,0:04:34.57,0:04:36.57,Default,,0,0,0,,tới đó mà vẫn chưa phát điên thì\Ntôi chắc chắn là cậu ta sẽ nhắm
Dialogue: 0,0:04:36.66,0:04:38.79,Default,,0,0,0,,vào chúng ta cho coi.
Dialogue: 0,0:04:38.87,0:04:42.37,Default,,0,0,0,,Không ngờ một tên nghiện lắp thiết bị lại
Dialogue: 0,0:04:42.46,0:04:46.26,Default,,0,0,0,,kiên cường như vậy. Không sao, đội thu hồi\Ncủa Arasaka có thể giải quyết gọn cậu ta.
Dialogue: 0,0:04:46.33,0:04:48.75,Default,,0,0,0,,Có thể, nhưng tôi sẽ không mạo hiểm. Dù
Dialogue: 0,0:04:48.84,0:04:51.26,Default,,0,0,0,,sao tôi cũng làm xong phần mình rồi. Tôi\Nđi đây, việc còn lại ông tự lo đi. Gửi
Dialogue: 0,0:04:51.34,0:04:54.09,Default,,0,0,0,,tiền cho tôi là xong, chấm dứt hợp đồng.
Dialogue: 0,0:04:54.18,0:04:58.06,Default,,0,0,0,,Tôi đang trên đường đưa con bé netrunner
Dialogue: 0,0:04:58.14,0:05:02.02,Default,,0,0,0,,đến Arasaka, nên cần cô hỗ trợ tôi chút\Nnữa. Tới điểm hẹn tôi trả tiền luôn. Hơn
Dialogue: 0,0:05:02.10,0:05:06.19,Default,,0,0,0,,nữa tôi cũng muốn gặp mặt cô lần\Ncuối. Nợ nần gì giải quyết luôn cho xong.
Dialogue: 0,0:05:06.27,0:05:07.60,Default,,0,0,0,,Ông tử tế quá ha!
Dialogue: 0,0:05:09.90,0:05:11.61,Default,,0,0,0,,Mình đang làm cái gì vậy nè?
Dialogue: 0,0:05:34.84,0:05:41.64,Default,,0,0,0,,{\an8}Đi. Đi. Đi. Đi. Đi. Dừng lại. Dừng lại.
Dialogue: 0,0:05:42.27,0:05:49.07,Default,,0,0,0,,Dừng lại. Dừng lại. Dừng lại. Dừng\Nlại. Dừng lại. Dừng lại. Dừng lại.
Dialogue: 0,0:05:56.78,0:05:59.66,Default,,0,0,0,,- Ta hết đường chạy rồi!\N- Mau dậy đi, David nghe không!
Dialogue: 0,0:05:59.74,0:06:03.49,Default,,0,0,0,,Đây là thuốc ức chế miễn dịch do quân
Dialogue: 0,0:06:03.58,0:06:07.33,Default,,0,0,0,,đội cấp với liều lượng gấp chín lần so\Nvới bình thường. Thứ
Dialogue: 0,0:06:07.42,0:06:11.17,Default,,0,0,0,,này sẽ buộc cậu luôn ở
Dialogue: 0,0:06:11.25,0:06:15.00,Default,,0,0,0,,trong trạng thái tỉnh táo, nhưng tác\Ndụng phụ của nó càng lúc càng tăng lên và
Dialogue: 0,0:06:15.09,0:06:18.84,Default,,0,0,0,,{\an8}được cộng dồn. Cho đến khi nào cậu dùng\Ntới bình thuốc cuối cùng thì cậu sẽ phải
Dialogue: 0,0:06:18.93,0:06:22.68,Default,,0,0,0,,lãnh
Dialogue: 0,0:06:22.76,0:06:26.43,Default,,0,0,0,,{\an8}hậu quả. Chút nhân tính còn sót lại sẽ\Nmất hết, và cậu sẽ trở nên điên loạn.
Dialogue: 0,0:06:52.88,0:06:55.63,Default,,0,0,0,,Cho chết nè!
Dialogue: 0,0:06:55.71,0:07:01.09,Default,,0,0,0,,Cái quỷ gì vậy? Sao hết\Ntốp này đến tốp khác! Hả?
Dialogue: 0,0:07:04.93,0:07:11.85,Default,,0,0,0,,Ha ha ha! Ha ha ha… Ha ha…\NỤn ụn ụn… đúng là điên thiệt!
Dialogue: 0,0:07:13.27,0:07:14.19,Default,,0,0,0,,Hả?
Dialogue: 0,0:07:30.50,0:07:33.46,Default,,0,0,0,,Con phải làm việc thật chăm chỉ rồi thăng
Dialogue: 0,0:07:33.54,0:07:36.50,Default,,0,0,0,,cấp. Con trai mẹ phải là nhân viên xuất\Nsắc được làm việc ở tầng cao nhất của
Dialogue: 0,0:07:36.59,0:07:39.55,Default,,0,0,0,,Tháp Arasaka! Con là người thông minh\Nnhất trong số những người mẹ từng gặp.
Dialogue: 0,0:07:44.72,0:07:48.56,Default,,0,0,0,,Mẹ ơi mẹ… Con cảm ơn mẹ, mẹ của con à.
Dialogue: 0,0:07:48.64,0:07:52.48,Default,,0,0,0,,Con sẽ cố gắng để làm việc ở\Ntầng cao nhất của Arasaka…
Dialogue: 0,0:07:54.61,0:07:58.20,Default,,0,0,0,,Vậy thì đi thôi! Tôi đi với\Ncậu. Mình lên tầng thượng nào.
Dialogue: 0,0:07:58.90,0:08:01.99,Default,,0,0,0,,Đây là thuốc ức chế miễn dịch tôi đã lấy
Dialogue: 0,0:08:02.07,0:08:05.16,Default,,0,0,0,,từ Ripperdoc, tác dụng gấp chín lần bình\Nthường. Nếu tôi có biểu hiện mất trí, tôi
Dialogue: 0,0:08:05.24,0:08:08.33,Default,,0,0,0,,cần cô tiêm thuốc cho tôi\Nđể tôi có thể tỉnh táo…
Dialogue: 0,0:08:10.66,0:08:13.87,Default,,0,0,0,,Chắc là giờ thuốc cũng đã\Nhết tác dụng với David rồi.
Dialogue: 0,0:08:13.96,0:08:15.71,Default,,0,0,0,,Hả? Vậy giờ sao đây?
Dialogue: 0,0:08:15.79,0:08:18.34,Default,,0,0,0,,{\an8}Còn sao trăng gì nữa\Nchứ. Tới chỗ Arasaka thôi!
Dialogue: 0,0:08:19.63,0:08:21.13,Default,,0,0,0,,David đang trong tình\Ntrạng đó mà vẫn đi hả?
Dialogue: 0,0:08:21.22,0:08:22.76,Default,,0,0,0,,Chúng ta cần đến chỗ của Lucy!
Dialogue: 0,0:08:23.30,0:08:24.55,Default,,0,0,0,,Hả?
Dialogue: 0,0:08:24.64,0:08:27.89,Default,,0,0,0,,Bây giờ Lucy là người duy nhất có thể mang
Dialogue: 0,0:08:27.97,0:08:31.27,Default,,0,0,0,,cậu ấy quay lại. Ngoài cô ấy ra\Nkhông ai làm được chuyện đó hết.
Dialogue: 0,0:08:37.86,0:08:40.03,Default,,0,0,0,,Từ giờ trở đi tôi không\Nlàm việc cho ông nữa.
Dialogue: 0,0:08:40.11,0:08:42.86,Default,,0,0,0,,Tôi hiểu rồi. Đáng tiếc thật.
Dialogue: 0,0:08:46.03,0:08:49.49,Default,,0,0,0,,Cô cũng biết trong hợp đồng có điều khoản
Dialogue: 0,0:08:49.58,0:08:53.04,Default,,0,0,0,,phải loại bỏ bất cứ ai biết về sự tồn\Ntại của siêu khung xương. Sẽ không có
Dialogue: 0,0:08:53.12,0:08:56.92,Default,,0,0,0,,ai được ngoại lệ dù đó là cô… A!
Dialogue: 0,0:08:57.00,0:08:59.13,Default,,0,0,0,,{\an8}Đuổi theo cô ta! Nhanh lên!
Dialogue: 0,0:09:00.63,0:09:03.59,Default,,0,0,0,,Chúng ta đang đến gần Tháp rồi. Kế\Nhoạch tiếp theo là gì cô biết không?
Dialogue: 0,0:09:03.68,0:09:05.43,Default,,0,0,0,,Có bao giờ lên kế hoạch đâu mà biết.
Dialogue: 0,0:09:07.43,0:09:13.90,Default,,0,0,0,,David à! Làm lại như lúc nãy đi! Wi yu.
Dialogue: 0,0:09:13.98,0:09:20.44,Default,,0,0,0,,Chết đi! Chết đi! Chết đi! Lũ khốn lì\Nlợm! Để tụi tao yên! Hahahaha. Phiền
Dialogue: 0,0:09:20.53,0:09:26.95,Default,,0,0,0,,quá, cái lũ này dai như đỉa đói vậy.
Dialogue: 0,0:09:32.12,0:09:33.20,Default,,0,0,0,,Cắt đuôi chưa?
Dialogue: 0,0:09:33.29,0:09:34.50,Default,,0,0,0,,Sắp cắt được rồi.
Dialogue: 0,0:09:34.58,0:09:37.00,Default,,0,0,0,,- Á! Đội MaxTac hả?\N- Á! Đội MaxTac hả?
Dialogue: 0,0:09:39.71,0:09:41.25,Default,,0,0,0,,Cử đến ba xe bay luôn.
Dialogue: 0,0:09:41.34,0:09:43.84,Default,,0,0,0,,Họ đánh dấu cậu ấy là\Nsiêu cuồng nhân rồi hả ta?
Dialogue: 0,0:09:43.92,0:09:45.84,Default,,0,0,0,,Đúng là oan gia ngõ hẹp. Bây giờ mà David
Dialogue: 0,0:09:45.93,0:09:47.89,Default,,0,0,0,,không tỉnh táo lại thì\Nchúng ta tiêu đời chắc luôn!
Dialogue: 0,0:09:48.55,0:09:49.80,Default,,0,0,0,,Tưởng tôi không biết chắc!
Dialogue: 0,0:09:50.72,0:09:53.14,Default,,0,0,0,,Hiện tại đội MaxTac đang được cử đi để
Dialogue: 0,0:09:53.22,0:09:55.64,Default,,0,0,0,,loại bỏ hắn. Hắn sẽ được xử lý như một\Ntên siêu cuồng nhân.
Dialogue: 0,0:09:55.73,0:09:58.44,Default,,0,0,0,,Càng lúc càng rắc rối.
Dialogue: 0,0:09:58.52,0:10:00.90,Default,,0,0,0,,Giờ đã vượt quá mục đích ban đầu là thu
Dialogue: 0,0:10:00.98,0:10:03.36,Default,,0,0,0,,thập dữ liệu. Tên nhóc David này, ta\Ncần phải ngăn hắn lại trước khi hắn
Dialogue: 0,0:10:03.44,0:10:05.86,Default,,0,0,0,,khiến mọi chuyện trở nên tồi tệ hơn.
Dialogue: 0,0:10:06.45,0:10:08.91,Default,,0,0,0,,Không một ai có thể ngăn hắn lại được
Dialogue: 0,0:10:08.99,0:10:11.49,Default,,0,0,0,,đâu. Ta chỉ có thể đợi đến khi\Nthiết bị cấy làm hắn kiệt sức.
Dialogue: 0,0:10:12.33,0:10:14.08,Default,,0,0,0,,Tôi biết một người có\Nthể ngăn hắn lại được.
Dialogue: 0,0:10:14.62,0:10:15.66,Default,,0,0,0,,Người đó là ai?
Dialogue: 0,0:10:15.75,0:10:17.38,Default,,0,0,0,,Đó chính là Adam Smasher.
Dialogue: 0,0:10:17.46,0:10:19.55,Default,,0,0,0,,Cô… Cô đang nói giỡn đó hả?
Dialogue: 0,0:10:19.63,0:10:23.01,Default,,0,0,0,,Bộ tôi có cười sao? Trường hợp\Nđặc biệt cần có biện pháp đặc biệt.
Dialogue: 0,0:10:23.09,0:10:25.80,Default,,0,0,0,,Nhưng bây giờ dù cho cô có\Ntriệu tập anh ta thì cũng…
Dialogue: 0,0:10:25.88,0:10:27.21,Default,,0,0,0,,Không thành vấn đề.
Dialogue: 0,0:10:27.30,0:10:28.64,Default,,0,0,0,,Hả?
Dialogue: 0,0:10:28.72,0:10:31.26,Default,,0,0,0,,Tôi đã triệu tập anh ta rồi. Đâu phải là
Dialogue: 0,0:10:31.35,0:10:34.56,Default,,0,0,0,,anh không biết. Lúc đầu, sỡ dĩ Siêu khung\Nxương được thiết kế là để lắp cho anh ta
Dialogue: 0,0:10:34.64,0:10:37.89,Default,,0,0,0,,mà. Để anh ta kết thúc\Nchuyện này cũng hợp lý thôi.
Dialogue: 0,0:10:38.65,0:10:41.19,Default,,0,0,0,,Nộp đơn thôi học, rồi\Nbiến cho khuất mắt tao.
Dialogue: 0,0:10:41.94,0:10:45.53,Default,,0,0,0,,Mày sợ bị bắt lắm chứ gì? Còn\Ntao thì không có gì phải sợ hết!
Dialogue: 0,0:10:51.74,0:10:55.16,Default,,0,0,0,,Lũ khốn Maxtac có ngon thì\Ntới đây đi. Tới bắt tụi tao nè!
Dialogue: 0,0:10:58.21,0:11:04.68,Default,,0,0,0,,Cái quái gì vậy trời? Nè đợi đã! Cứ mặc kệ\Nchúng tôi nằm ở đây hả? Mẹ ơi! Mẹ ơi mẹ!
Dialogue: 0,0:11:14.47,0:11:15.68,Default,,0,0,0,,Hắn có phải là con người hay không vậy?
Dialogue: 0,0:11:15.77,0:11:17.02,Default,,0,0,0,,Hỏi nhiều làm cái gì? Bắn tiếp đi!
Dialogue: 0,0:11:17.10,0:11:21.35,Default,,0,0,0,,Ngừng bắn! Lệnh mới từ đội an ninh\NArasaka. Mã AS. Chúng ta rút lui.
Dialogue: 0,0:11:21.44,0:11:22.36,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:11:26.36,0:11:29.11,Default,,0,0,0,,A! Rebecca, còn lại\Nbao nhiêu thuốc nữa hả?
Dialogue: 0,0:11:29.20,0:11:30.45,Default,,0,0,0,,Chỉ còn một lọ nữa thôi.
Dialogue: 0,0:11:30.53,0:11:33.53,Default,,0,0,0,,Hehehe… Cuối cùng cũng\Nđến lúc kết thúc rồi.
Dialogue: 0,0:11:34.33,0:11:35.37,Default,,0,0,0,,Falco.
Dialogue: 0,0:11:36.12,0:11:37.20,Default,,0,0,0,,Kiwi đó hả?
Dialogue: 0,0:11:37.29,0:11:40.25,Default,,0,0,0,,Ai chứ? Cái con khốn hai\Nmặt đó, để tôi giết chết nó!
Dialogue: 0,0:11:40.33,0:11:42.33,Default,,0,0,0,,Hả? Cô đang cho tôi xem cái gì đây?
Dialogue: 0,0:11:42.88,0:11:48.30,Default,,0,0,0,,Falco nghe đây… Tên Faraday đó,\Nhắn đã… Tôi sắp hết thời gian rồi.
Dialogue: 0,0:11:48.38,0:11:51.17,Default,,0,0,0,,Tức là giờ cô cũng bị\Nhắn lừa luôn rồi chứ gì?
Dialogue: 0,0:11:51.26,0:11:55.43,Default,,0,0,0,,Ừ… Nhưng tôi đã kịp đánh dấu xe bay của
Dialogue: 0,0:11:55.51,0:11:59.97,Default,,0,0,0,,hắn rồi. Giờ tôi đang gửi tọa độ cho\Nanh. Đi theo tọa độ là tìm được hắn.
Dialogue: 0,0:12:00.06,0:12:02.27,Default,,0,0,0,,Cô thật sự nghĩ là\Nchúng tôi sẽ tin cô sao?
Dialogue: 0,0:12:02.35,0:12:03.56,Default,,0,0,0,,Chắc không rồi.
Dialogue: 0,0:12:04.98,0:12:09.82,Default,,0,0,0,,Hôm nay đúng là không phải\Nngày dành cho tôi rồi.
Dialogue: 0,0:12:10.53,0:12:13.53,Default,,0,0,0,,Còn Lucy thì sao? Hiện giờ cô\Nấy vẫn đang ở cùng Faraday hả?
Dialogue: 0,0:12:16.20,0:12:18.20,Default,,0,0,0,,Cô muốn chúng tôi thay cô\Ntrả thù hắn đúng không?
Dialogue: 0,0:12:18.83,0:12:22.83,Default,,0,0,0,,Không phải như vậy đâu. Lúc trước tôi đã
Dialogue: 0,0:12:22.92,0:12:26.92,Default,,0,0,0,,dạy Lucy là muốn tồn tại ở cái thành phố\Nnày thì phải nhớ kỹ đừng tin tưởng bất cứ
Dialogue: 0,0:12:27.00,0:12:31.00,Default,,0,0,0,,ai, sớm muộn gì họ cũng phản bội.\NChỉ là đã đến lúc tôi phải dạy cho tên
Dialogue: 0,0:12:31.09,0:12:35.05,Default,,0,0,0,,khốn Faraday đó một bài học nhớ đời.
Dialogue: 0,0:12:37.10,0:12:38.73,Default,,0,0,0,,Xin hãy cứu Lucy giúp tôi.
Dialogue: 0,0:12:46.81,0:12:48.44,Default,,0,0,0,,Kiwi đã bị trừ khử rồi.
Dialogue: 0,0:12:49.07,0:12:50.41,Default,,0,0,0,,Đúng là phiền phức mà.
Dialogue: 0,0:12:57.16,0:12:58.08,Default,,0,0,0,,Hửm? Nè!
Dialogue: 0,0:12:59.91,0:13:00.83,Default,,0,0,0,,Nè!
Dialogue: 0,0:13:05.50,0:13:06.71,Default,,0,0,0,,Không thể nào. Là David sao?
Dialogue: 0,0:13:16.97,0:13:18.51,Default,,0,0,0,,Cứ tiếp tục bay thẳng về bãi đậu xe đi!
Dialogue: 0,0:13:19.18,0:13:23.35,Default,,0,0,0,,Đã nhận được tin từ Faraday. Hắn\Nsẽ sớm đến đây cùng netrunner kia.
Dialogue: 0,0:13:23.43,0:13:26.18,Default,,0,0,0,,Biết mà. David đang tìm hắn\Nchứ không phải là chúng ta.
Dialogue: 0,0:13:26.73,0:13:28.77,Default,,0,0,0,,Giờ tôi sẽ ra lệnh cho xe bay quay lại.
Dialogue: 0,0:13:28.86,0:13:31.28,Default,,0,0,0,,Không. Cứ để hắn bay đến chỗ bãi đậu xe
Dialogue: 0,0:13:31.36,0:13:33.78,Default,,0,0,0,,đi. Bây giờ anh hãy\Nchuẩn bị đến gặp chúng ở đó.
Dialogue: 0,0:13:34.61,0:13:35.90,Default,,0,0,0,,Tôi phải đi gặp chúng sao?
Dialogue: 0,0:13:37.11,0:13:39.24,Default,,0,0,0,,Dù sao thì vụ lộn xộn này cũng gây náo
Dialogue: 0,0:13:39.33,0:13:41.46,Default,,0,0,0,,động không nhỏ, phải có ai đó đứng ra\Nchịu trách nhiệm chứ
Dialogue: 0,0:13:41.54,0:13:43.67,Default,,0,0,0,,đúng không? Anh biết rõ là
Dialogue: 0,0:13:43.75,0:13:45.88,Default,,0,0,0,,tôi sẽ không làm việc\Nđó mà. Vậy thì anh làm.
Dialogue: 0,0:13:46.83,0:13:49.29,Default,,0,0,0,,Nói với thằng môi giới khốn kiếp đó là
Dialogue: 0,0:13:49.38,0:13:51.84,Default,,0,0,0,,hắn chỉ được dừng ở cổng bãi\Nđậu xe, không được đi xa hơn nữa.
Dialogue: 0,0:13:55.34,0:13:57.88,Default,,0,0,0,,Anh sắp đấu với siêu khung xương rồi đó,
Dialogue: 0,0:13:57.97,0:14:00.56,Default,,0,0,0,,chắc thấy hào hứng lắm\Nđúng không, Adam Smasher?
Dialogue: 0,0:14:01.22,0:14:03.43,Default,,0,0,0,,Món đồ chơi không thể đứng vững nếu không
Dialogue: 0,0:14:03.52,0:14:05.73,Default,,0,0,0,,có cái công nghệ chống trọng lực\Nchưa hoàn thiện đó sao? Nghe không
Dialogue: 0,0:14:05.81,0:14:07.98,Default,,0,0,0,,thấy hào hứng chút nào.
Dialogue: 0,0:14:14.07,0:14:16.07,Default,,0,0,0,,{\an8}Giết hết bọn chúng đi! Nhắm cho chuẩn.
Dialogue: 0,0:14:16.99,0:14:17.87,Default,,0,0,0,,Đâu rồi?
Dialogue: 0,0:14:17.95,0:14:18.83,Default,,0,0,0,,Không có ai hết!
Dialogue: 0,0:14:23.54,0:14:28.50,Default,,0,0,0,,Mẹ ơi… Mẹ thấy không, con lên\Nđược đỉnh Tháp Arasaka rồi nè.
Dialogue: 0,0:14:30.67,0:14:34.42,Default,,0,0,0,,Giờ xử luôn lọ cuối cùng thôi, Bác sĩ à.
Dialogue: 0,0:14:35.09,0:14:40.10,Default,,0,0,0,,Một khi cậu đã hoàn toàn mất hết tất cả\Nký ức, cậu sẽ không còn đường để quay trở
Dialogue: 0,0:14:40.18,0:14:45.19,Default,,0,0,0,,{\an8}lại, cho dù cậu có đặc biệt tới cỡ nào.
Dialogue: 0,0:14:45.27,0:14:50.28,Default,,0,0,0,,{\an8}Hahaha. Bây giờ tôi chỉ có thể đến đó,\Nbởi vì tôi không còn gì hết. Đúng vậy.
Dialogue: 0,0:14:56.36,0:15:00.24,Default,,0,0,0,,Hình như có ai đó không làm\Nđúng theo kế hoạch, Faraday.
Dialogue: 0,0:15:00.82,0:15:03.03,Default,,0,0,0,,Tôi đã đưa cô gái đó còn sống trở về. Giá
Dialogue: 0,0:15:03.12,0:15:05.66,Default,,0,0,0,,chúng ta đã thỏa thuận\Nlà một triệu phải không?
Dialogue: 0,0:15:05.75,0:15:07.92,Default,,0,0,0,,Chúng tôi không bao giờ giao dịch với đám
Dialogue: 0,0:15:08.00,0:15:10.17,Default,,0,0,0,,chó cãi lời chủ. Ông có biết một\Nkhi lũ chó rời khỏi chuồng thì
Dialogue: 0,0:15:10.25,0:15:12.46,Default,,0,0,0,,chúng sẽ gặp chuyện gì không?
Dialogue: 0,0:15:13.04,0:15:15.46,Default,,0,0,0,,Anh đe dọa tôi trong khi anh cần dữ liệu
Dialogue: 0,0:15:15.55,0:15:18.09,Default,,0,0,0,,trong cái hộp sọ này\Nsao? Để tôi vào trong đi.
Dialogue: 0,0:15:18.17,0:15:20.26,Default,,0,0,0,,Tôi chỉ có thể cho ông đứng ở bãi đậu xe
Dialogue: 0,0:15:20.34,0:15:22.59,Default,,0,0,0,,này thôi. Không được\Nbước chân vào tòa nhà.
Dialogue: 0,0:15:22.68,0:15:25.39,Default,,0,0,0,,Các người làm như vậy là không khôn ngoan
Dialogue: 0,0:15:25.47,0:15:28.18,Default,,0,0,0,,lắm đâu. Với tất cả thông tin mà tôi đang\Ncó ở trong tay, nếu không giữ tôi lại thì
Dialogue: 0,0:15:28.27,0:15:31.23,Default,,0,0,0,,các người sẽ phải chịu tổn thất lớn đó.
Dialogue: 0,0:15:31.31,0:15:33.40,Default,,0,0,0,,Tốt nhất hãy bỏ cô gái đó lại rồi ra
Dialogue: 0,0:15:33.48,0:15:35.57,Default,,0,0,0,,ngoài. Chúng tôi sẽ gửi tiền như thỏa\Nthuận. Ông không còn
Dialogue: 0,0:15:35.65,0:15:37.74,Default,,0,0,0,,giá trị sử dụng nếu không
Dialogue: 0,0:15:37.82,0:15:39.91,Default,,0,0,0,,thể cung cấp cho chúng tôi những dữ\Nliệu chi tiết về siêu khung xương như
Dialogue: 0,0:15:39.99,0:15:41.99,Default,,0,0,0,,đã thỏa thuận trong hợp đồng…
Dialogue: 0,0:15:49.79,0:15:51.21,Default,,0,0,0,,Lucy.
Dialogue: 0,0:15:51.29,0:15:52.21,Default,,0,0,0,,Anh David.
Dialogue: 0,0:16:16.32,0:16:22.33,Default,,0,0,0,,Thấy chưa! Ai nói là tao sẽ không\Ngiao ra được siêu khung xương chứ… Á!
Dialogue: 0,0:16:26.41,0:16:29.62,Default,,0,0,0,,Ai cho phép mày chết một\Ncách dễ dàng như vậy chứ?
Dialogue: 0,0:16:32.58,0:16:35.67,Default,,0,0,0,,Mày là Adam Smasher? Mau\Ntiến lên giết chết hắn đi!
Dialogue: 0,0:16:35.75,0:16:37.34,Default,,0,0,0,,Mày là thằng quái nào?
Dialogue: 0,0:16:37.42,0:16:39.42,Default,,0,0,0,,Mày chỉ là lính đánh thuê! Làm việc đi!
Dialogue: 0,0:16:39.96,0:16:43.05,Default,,0,0,0,,Tao chỉ quan tâm đến thằng\Nnhóc có siêu khung xương thôi.
Dialogue: 0,0:16:43.13,0:16:46.30,Default,,0,0,0,,Adam Smasher hả? Thì ra mày là Adam
Dialogue: 0,0:16:46.39,0:16:49.56,Default,,0,0,0,,Smasher hả? Tao cứ tưởng\Nmày là huyền thoại tập đoàn.
Dialogue: 0,0:16:50.22,0:16:52.76,Default,,0,0,0,,Không ngờ một thằng nhóc nhỏ xíu như mày
Dialogue: 0,0:16:52.85,0:16:55.39,Default,,0,0,0,,mà vũ khí hoành tráng ghê, dám lắp\Nsiêu khung xương. Vẫn còn nói được hai
Dialogue: 0,0:16:55.48,0:16:58.07,Default,,0,0,0,,câu liền mạch đúng là ấn tượng đó.
Dialogue: 0,0:16:58.69,0:17:00.86,Default,,0,0,0,,Thì mày cũng vậy thôi. Nghe nói mày gần
Dialogue: 0,0:17:00.94,0:17:03.11,Default,,0,0,0,,như đã hoàn toàn trở thành một\Nngười máy rồi. Vẫn còn não trong
Dialogue: 0,0:17:03.20,0:17:05.45,Default,,0,0,0,,cái đầu kim loại đó hả?
Dialogue: 0,0:17:05.53,0:17:07.32,Default,,0,0,0,,Chỉ có thể nói là do tao đặc biệt.
Dialogue: 0,0:17:07.41,0:17:09.75,Default,,0,0,0,,Tao cũng đặc biệt không thua gì mày đâu.
Dialogue: 0,0:17:09.83,0:17:10.83,Default,,0,0,0,,Thằng này hài hước thiệt.
Dialogue: 0,0:17:11.70,0:17:13.79,Default,,0,0,0,,Hả?
Dialogue: 0,0:17:13.87,0:17:17.21,Default,,0,0,0,,Là đội Chấn thương!\NChuyển bệnh nhân từ 110812 đến Trụ
Dialogue: 0,0:17:17.29,0:17:19.38,Default,,0,0,0,,- sở. Đang di chuyển bệnh nhân NC421-1138.\N- Mình được cứu rồi…
Dialogue: 0,0:17:19.46,0:17:21.59,Default,,0,0,0,,Ha!
Dialogue: 0,0:17:22.67,0:17:25.13,Default,,0,0,0,,Giờ này mà mày còn\Nthời gian để phân tâm à?
Dialogue: 0,0:17:57.17,0:18:01.59,Default,,0,0,0,,Anh David! Anh David, nghe em không? Em
Dialogue: 0,0:18:01.67,0:18:06.09,Default,,0,0,0,,là Lucy, Lucy của anh đây! Anh\NDavid, quay lại với em đi! Quay lại đi!
Dialogue: 0,0:18:19.31,0:18:20.31,Default,,0,0,0,,Lucy.
Dialogue: 0,0:18:22.23,0:18:26.15,Default,,0,0,0,,Anh David à, Anh đã lắp đặt nó.
Dialogue: 0,0:18:26.90,0:18:27.90,Default,,0,0,0,,Ừm.
Dialogue: 0,0:18:27.99,0:18:31.74,Default,,0,0,0,,Ha, em biết sớm muộn gì anh cũng sẽ làm
Dialogue: 0,0:18:31.83,0:18:35.58,Default,,0,0,0,,như vậy mà. Em biết rất rõ là nếu lắp đặt\Nthì anh sẽ chết. Em không muốn… Em không
Dialogue: 0,0:18:35.66,0:18:39.41,Default,,0,0,0,,muốn anh lắp đặt nó! Em\Nkhông muốn anh chết đâu David!
Dialogue: 0,0:18:40.46,0:18:43.21,Default,,0,0,0,,Đây là cách duy nhất để anh bảo vệ em
Dialogue: 0,0:18:43.30,0:18:46.05,Default,,0,0,0,,khỏi thành phố này. Trước đây có quá\Nnhiều người anh
Dialogue: 0,0:18:46.13,0:18:48.88,Default,,0,0,0,,không thể cứu được. Mẹ anh và
Dialogue: 0,0:18:48.97,0:18:51.72,Default,,0,0,0,,Maine đã chết trước mặt anh, nhưng\Nmà bằng mọi giá anh phải cứu được em.
Dialogue: 0,0:18:54.72,0:18:58.06,Default,,0,0,0,,Anh cứu em làm gì, em không cần anh cứu.
Dialogue: 0,0:18:58.14,0:19:01.48,Default,,0,0,0,,Em chỉ muốn anh có thể tự cứu lấy bản\Nthân mình. Em muốn anh được tiếp tục sống.
Dialogue: 0,0:19:02.11,0:19:04.90,Default,,0,0,0,,Anh sống hay không cũng đâu quan trọng.
Dialogue: 0,0:19:04.98,0:19:07.77,Default,,0,0,0,,Dù sao thì giờ anh cũng không còn gì hết.\NNhưng em thì khác Lucy, em còn có một ước
Dialogue: 0,0:19:07.86,0:19:10.65,Default,,0,0,0,,mơ phải thực hiện. Anh muốn em hoàn\Nthành ước mơ đó.
Dialogue: 0,0:19:10.74,0:19:13.54,Default,,0,0,0,,Cũng là ước mơ của anh. Còn
Dialogue: 0,0:19:13.62,0:19:16.29,Default,,0,0,0,,tất cả những thứ khác đều\Nkhông có gì quan trọng hết.
Dialogue: 0,0:19:40.69,0:19:43.36,Default,,0,0,0,,Không biết khi nào lũ khốn\NArasaka này mới chịu bỏ cuộc?
Dialogue: 0,0:19:43.90,0:19:47.57,Default,,0,0,0,,Bây giờ Cảnh sát NC đang ở ngoài kia\Nvới chúng. Tôi nghĩ chắc là còn lâu lắm.
Dialogue: 0,0:19:47.65,0:19:48.99,Default,,0,0,0,,Tôi sắp hết đạn rồi mới chết chứ.
Dialogue: 0,0:19:55.24,0:19:56.37,Default,,0,0,0,,Tôi đã về rồi đây.
Dialogue: 0,0:19:56.91,0:19:58.91,Default,,0,0,0,,Có biết tôi chờ bao nhiêu\Nlâu rồi không? Đồ ngốc!
Dialogue: 0,0:20:01.00,0:20:03.29,Default,,0,0,0,,Chết hết đi! Falco nè.
Dialogue: 0,0:20:03.38,0:20:04.38,Default,,0,0,0,,Hả?
Dialogue: 0,0:20:04.46,0:20:05.42,Default,,0,0,0,,Tôi có việc muốn nhờ anh.
Dialogue: 0,0:20:05.50,0:20:07.46,Default,,0,0,0,,Được rồi. Chuẩn bị rút lui thôi!
Dialogue: 0,0:20:08.55,0:20:09.80,Default,,0,0,0,,Mừng cô trở về an toàn.
Dialogue: 0,0:20:11.47,0:20:13.14,Default,,0,0,0,,Vậy là cuối cùng David cũng yên lòng rồi.
Dialogue: 0,0:20:16.64,0:20:21.44,Default,,0,0,0,,Người ta đang tâm sự mà\Nmày dám… Mày dám… Mày dám…
Dialogue: 0,0:20:34.45,0:20:35.37,Default,,0,0,0,,Rebecca!
Dialogue: 0,0:20:38.49,0:20:40.37,Default,,0,0,0,,Mày dám hả? A!
Dialogue: 0,0:20:47.63,0:20:49.26,Default,,0,0,0,,Mày cũng có Sandevistan sao?
Dialogue: 0,0:20:49.88,0:20:52.26,Default,,0,0,0,,Chỉ là thiết bị cấy sơ đẳng thôi.
Dialogue: 0,0:20:52.34,0:20:54.43,Default,,0,0,0,,Đừng quên tao mới là mục tiêu của mày!
Dialogue: 0,0:20:54.51,0:20:58.72,Default,,0,0,0,,Đừng lo lắng. Tao không thiên vị\Nđâu. Tao sẽ tiễn tụi bây đi một lượt
Dialogue: 0,0:20:58.81,0:21:00.90,Default,,0,0,0,,- Vậy thì để tao tiễn mày trước đã! A!\N- Ha!
Dialogue: 0,0:21:05.23,0:21:07.02,Default,,0,0,0,,{\an8}Hết thuốc ức chế miễn dịch rồi à?
Dialogue: 0,0:21:09.73,0:21:11.98,Default,,0,0,0,,Tao thấy là cũng vừa đúng lúc đó.
Dialogue: 0,0:21:12.65,0:21:13.57,Default,,0,0,0,,David chờ em!
Dialogue: 0,0:21:14.86,0:21:15.78,Default,,0,0,0,,Hửm?
Dialogue: 0,0:21:21.75,0:21:28.67,Default,,0,0,0,,Không thể nào… Hự. Falco à, mau\Nlên đi, David vẫn còn ở đó! Falco!
Dialogue: 0,0:21:30.84,0:21:33.68,Default,,0,0,0,,Không ai được sống sót\Nrời khỏi đây. Chết hết đi!
Dialogue: 0,0:21:35.22,0:21:37.39,Default,,0,0,0,,Giờ thì ai đang phân tâm vậy ta?
Dialogue: 0,0:21:37.47,0:21:42.56,Default,,0,0,0,,Nhóc con, chết đi! Mày là ai mà dám bước
Dialogue: 0,0:21:42.64,0:21:47.73,Default,,0,0,0,,tới chỗ tao, trong khi mày còn không\Nthể đứng thẳng nếu không có thiết bị cấy
Dialogue: 0,0:21:47.81,0:21:52.94,Default,,0,0,0,,chống trọng lực đó. Mày nghĩ mày đặc\Nbiệt vì mày lì lợm có phải không hả?
Dialogue: 0,0:21:55.24,0:21:56.91,Default,,0,0,0,,Mày không hài hước tới mức đó đâu.
Dialogue: 0,0:21:59.87,0:22:02.83,Default,,0,0,0,,Hả? Falco! Quay lại đi mà.
Dialogue: 0,0:22:03.37,0:22:06.54,Default,,0,0,0,,{\an8}Không được! David đã giao phó cho tôi rồi.
Dialogue: 0,0:22:06.62,0:22:07.54,Default,,0,0,0,,Hơ?
Dialogue: 0,0:22:07.62,0:22:10.00,Default,,0,0,0,,Nếu giờ tôi quay lại, cậu ấy sẽ chết một
Dialogue: 0,0:22:10.09,0:22:12.80,Default,,0,0,0,,cách vô ích. Tôi đang giữ toàn bộ số\Ntiền thù lao của vụ này. Cậu ấy muốn chúng
Dialogue: 0,0:22:12.88,0:22:15.63,Default,,0,0,0,,ta chia đều sau khi thoát khỏi đây.
Dialogue: 0,0:22:17.18,0:22:18.43,Default,,0,0,0,,Cậu ấy nhờ tôi nhắn với cô.
Dialogue: 0,0:22:20.64,0:22:23.60,Default,,0,0,0,,Anh xin lỗi, vì anh không\Nthể lên mặt trăng cùng em.
Dialogue: 0,0:22:59.26,0:23:06.18,Default,,0,0,0,,{\an8}- A… Ô…Ọc… Ọc… Hehehe.\N- Tao chơi đã tay rồi.
Dialogue: 0,0:23:09.31,0:23:13.02,Default,,0,0,0,,Thật sự đáng tiếc vì mày có\Nthể là một bộ phận cơ thể tốt.
Dialogue: 0,0:23:14.53,0:23:18.03,Default,,0,0,0,,Làm như tao thèm quan tâm\Nvậy. Mày cứ tiếc cả đời đi!
Dialogue: 0,0:23:19.36,0:23:22.07,Default,,0,0,0,,Vậy thì vĩnh biệt.
Dialogue: 0,0:23:51.94,0:23:54.69,Default,,0,0,0,,Chào mừng bạn đến với chuyến du hành mặt
Dialogue: 0,0:23:54.77,0:23:57.52,Default,,0,0,0,,trăng! Trải nghiệm trọng lực mặt\Ntrăng bằng cơ thể, khác biệt hoàn toàn so
Dialogue: 0,0:23:57.61,0:24:00.41,Default,,0,0,0,,với việc trải nghiệm thông qua BD…
Dialogue: 0,0:24:00.49,0:24:05.37,Default,,0,0,0,,DU HÀNH MẶT TRĂNG
Dialogue: 0,0:24:21.43,0:24:28.35,Default,,0,0,0,,Whoa! Độ phân giải này quá đã! Tôi cảm\Nnhận được mặt trời, hehehe. Hở? Hì… Hơ…
