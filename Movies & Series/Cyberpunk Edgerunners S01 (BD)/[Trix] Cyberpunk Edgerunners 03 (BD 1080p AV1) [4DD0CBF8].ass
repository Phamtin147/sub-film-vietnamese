Dialogue: 0,0:01:38.61,0:01:40.11,Default,,0,0,0,,Vậy giờ làm gì đây?
Dialogue: 0,0:01:40.19,0:01:43.90,Default,,0,0,0,,Rõ ràng Sandy là của tôi mà tại sao cái\Nthằng nhãi ranh này lại gắn nó vào người?
Dialogue: 0,0:01:44.99,0:01:47.12,Default,,0,0,0,,Gỡ nó ra là sẽ tốn bộn tiền đó nha.
Dialogue: 0,0:01:47.20,0:01:49.99,Default,,0,0,0,,Xớ, thằng khỉ tóc dựng\Nđứng này phiền phức quá đi.
Dialogue: 0,0:01:51.58,0:01:53.96,Default,,0,0,0,,Chúng ta thủ tiêu nó luôn được không?
Dialogue: 0,0:01:54.04,0:01:56.63,Default,,0,0,0,,Lúc chỉ còn cái xác khô thì cứ vậy\Nmà lấy thiết bị ra khỏi người nó.
Dialogue: 0,0:01:56.71,0:01:59.80,Default,,0,0,0,,- Cũng phải nhờ tới Ripperdoc chứ.\N- Tự làm cho khỏi tốn tiền.
Dialogue: 0,0:01:59.88,0:02:01.17,Default,,0,0,0,,Ờ chắc cũng được á.
Dialogue: 0,0:02:01.84,0:02:04.26,Default,,0,0,0,,Nghe thấy chưa? Giờ tao phải tự tay xé xác
Dialogue: 0,0:02:04.34,0:02:06.76,Default,,0,0,0,,mày ra, rồi sau đó tao sẽ bứng\Nnó ra khỏi người mày, cho mày
Dialogue: 0,0:02:06.84,0:02:09.26,Default,,0,0,0,,chừa cái tật trộm cắp đi.
Dialogue: 0,0:02:09.85,0:02:11.98,Default,,0,0,0,,Cấm mấy vụ giết người máu\Nme ở nhà tôi nha Maine.
Dialogue: 0,0:02:12.06,0:02:13.15,Default,,0,0,0,,Đừng xen vô!
Dialogue: 0,0:02:13.22,0:02:15.35,Default,,0,0,0,,Thái độ gì đây? Đừng quên\Ntôi là người tìm thấy cậu ta.
Dialogue: 0,0:02:18.19,0:02:20.99,Default,,0,0,0,,Cô đã lừa tôi sao… Ah!\NIm đi! Khai mau. Mày đang làm cái
Dialogue: 0,0:02:21.06,0:02:24.19,Default,,0,0,0,,chó gì với Sandevistan của tao hả?
Dialogue: 0,0:02:24.28,0:02:25.24,Default,,0,0,0,,Của anh sao?
Dialogue: 0,0:02:25.32,0:02:27.99,Default,,0,0,0,,Chắc chắn là vậy rồi không cần phải hỏi!
Dialogue: 0,0:02:28.07,0:02:30.95,Default,,0,0,0,,Tao mua và trả tiền đàng hoàng, nhưng\Nngười bán biến mất ngay khi tao gửi cọc.
Dialogue: 0,0:02:31.03,0:02:32.78,Default,,0,0,0,,Ai kêu lúc đó anh trả tiền trước làm chi.
Dialogue: 0,0:02:32.87,0:02:35.62,Default,,0,0,0,,- Ngu quá má ơi.\N- Im đi! Cô ấy luôn là bạn tốt của chúng
Dialogue: 0,0:02:35.70,0:02:38.45,Default,,0,0,0,,ta! Hơn nữa lúc nào\Ncô ấy cũng cần tiền nóng
Dialogue: 0,0:02:38.54,0:02:41.42,Default,,0,0,0,,hết. Từ trước cho tới\Ngiờ mọi chuyện vẫn ổn mà.
Dialogue: 0,0:02:41.50,0:02:43.59,Default,,0,0,0,,- Khoan đã.\N- Hả?
Dialogue: 0,0:02:43.67,0:02:44.59,Default,,0,0,0,,Người bán đồ cho anh là…
Dialogue: 0,0:02:45.17,0:02:47.76,Default,,0,0,0,,Gloria Martinez. Nghe có quen không?
Dialogue: 0,0:02:48.63,0:02:50.47,Default,,0,0,0,,Đó chính là mẹ của tôi.
Dialogue: 0,0:02:50.55,0:02:51.68,Default,,0,0,0,,- Hử?\N- Hả?
Dialogue: 0,0:02:51.76,0:02:55.35,Default,,0,0,0,,Mày là con của Gloria sao? Cô ta\Nnghĩ gì mà lại đưa đồ cho mày chứ?
Dialogue: 0,0:02:55.43,0:02:56.89,Default,,0,0,0,,Mẹ tôi đã qua đời rồi.
Dialogue: 0,0:02:58.31,0:02:59.31,Default,,0,0,0,,Mới hôm qua.
Dialogue: 0,0:02:59.39,0:03:02.19,Default,,0,0,0,,Chuyện quái gì nữa đây? Bọn tao vừa mới\Nnói chuyện với nhau hai ngày trước. Chuyện
Dialogue: 0,0:03:02.27,0:03:05.06,Default,,0,0,0,,gì đã xảy ra? Bộ tụi\Ncớm… Bắt được cô ta hay là…
Dialogue: 0,0:03:05.15,0:03:07.94,Default,,0,0,0,,Mẹ tôi mất vì tai nạn giao thông. Có hai\Nbăng đảng đấu với nhau trên đường đi. Xe
Dialogue: 0,0:03:08.03,0:03:10.82,Default,,0,0,0,,chúng tôi kẹt giữa 2 làn đạn.\NSandevistan không
Dialogue: 0,0:03:10.91,0:03:13.66,Default,,0,0,0,,liên quan gì ở đây. Ai da.
Dialogue: 0,0:03:19.00,0:03:20.84,Default,,0,0,0,,Hèn chi cô ấy không liên lạc với anh.
Dialogue: 0,0:03:21.88,0:03:25.09,Default,,0,0,0,,Xin thành thật chia buồn nha nhóc con, sốc
Dialogue: 0,0:03:25.17,0:03:28.63,Default,,0,0,0,,thiệt chứ. Nhưng chuyện nào ra chuyện đó,\Nđừng nghĩ là tao dễ dàng bỏ qua vụ này.
Dialogue: 0,0:03:28.72,0:03:31.18,Default,,0,0,0,,Đã nói tôi không biết\Nnó là của anh rồi mà.
Dialogue: 0,0:03:31.26,0:03:33.80,Default,,0,0,0,,Nó làm tôi nhớ cái hồi… Há há chôm đồ cấp
Dialogue: 0,0:03:33.89,0:03:36.43,Default,,0,0,0,,quân sự của mẹ tôi rồi lắp vô người,\Ntrời ơi ta nói nó đã! Hứ, thằng nhóc
Dialogue: 0,0:03:36.51,0:03:39.26,Default,,0,0,0,,này coi bộ cũng chạm mạch dữ hen!
Dialogue: 0,0:03:39.35,0:03:41.35,Default,,0,0,0,,Chẳng qua là nó không biết\Nmình đang làm gì mà thôi.
Dialogue: 0,0:03:42.73,0:03:45.40,Default,,0,0,0,,Thì ra mấy người chính là\Ntội phạm công nghệ cao sao?
Dialogue: 0,0:03:51.15,0:03:52.49,Default,,0,0,0,,Liên quan gì tới mày chớ?
Dialogue: 0,0:03:53.07,0:03:55.24,Default,,0,0,0,,Hãy cho phép tôi được giữ lại
Dialogue: 0,0:03:55.33,0:03:57.50,Default,,0,0,0,,Sandevistan. Tôi sẽ trả tiền. Dù tôi đang\Ntúng thiếu nhưng tôi sẽ làm cho anh để trừ
Dialogue: 0,0:03:57.58,0:03:59.79,Default,,0,0,0,,nợ.
Dialogue: 0,0:03:59.87,0:04:02.21,Default,,0,0,0,,Vấn đề không phải là tiền. Nó là hàng cấp
Dialogue: 0,0:04:02.29,0:04:04.67,Default,,0,0,0,,quân sự, có muốn cũng\Nkhông mua được ở chỗ khác.
Dialogue: 0,0:04:05.71,0:04:07.92,Default,,0,0,0,,Anh trả bao nhiêu cho\Nmẹ tôi, tôi sẽ trả lại.
Dialogue: 0,0:04:08.00,0:04:09.21,Default,,0,0,0,,Không được mà đừng có nói nhiều.
Dialogue: 0,0:04:09.30,0:04:10.89,Default,,0,0,0,,Tôi nói không được giết người rồi đó.
Dialogue: 0,0:04:10.97,0:04:12.55,Default,,0,0,0,,Hãy cho tôi cơ hội được làm việc cho anh.
Dialogue: 0,0:04:13.43,0:04:16.48,Default,,0,0,0,,Hứ. mày thì làm được cái gì? Bộ tao\Nlà hiệu trưởng trường mầm non hả?
Dialogue: 0,0:04:16.55,0:04:18.30,Default,,0,0,0,,Tôi có thể kích hoạt được Sandevistan.
Dialogue: 0,0:04:18.39,0:04:21.31,Default,,0,0,0,,Tào lao quá đi, con nít như mày\Nkích hoạt cái là sấp mặt liền chứ giỡn.
Dialogue: 0,0:04:21.39,0:04:24.64,Default,,0,0,0,,Con nít này có thể\Nlàm cho anh bất ngờ đó.
Dialogue: 0,0:04:24.73,0:04:25.73,Default,,0,0,0,,- Hửm?\N- Hả?
Dialogue: 0,0:04:25.81,0:04:28.19,Default,,0,0,0,,Làm chừng hai lần là người\Nnó cháy xèo xèo liền chứ gì.
Dialogue: 0,0:04:28.28,0:04:29.61,Default,,0,0,0,,Tôi đã kích hoạt tám lần.
Dialogue: 0,0:04:31.11,0:04:33.99,Default,,0,0,0,,Bậy ghê, đừng có xạo nữa ai mà thèm tin.
Dialogue: 0,0:04:34.07,0:04:37.49,Default,,0,0,0,,Vậy thì bây giờ để tôi\Nlàm cho mấy người tin.
Dialogue: 0,0:04:37.58,0:04:38.79,Default,,0,0,0,,Hừm!
Dialogue: 0,0:04:38.87,0:04:40.25,Default,,0,0,0,,Thôi thôi. Hãy mau ngồi xuống đi nhóc.
Dialogue: 0,0:04:40.83,0:04:43.12,Default,,0,0,0,,Cứ bình tĩnh. Tôi chỉ lấy điếu thuốc của
Dialogue: 0,0:04:43.21,0:04:45.71,Default,,0,0,0,,anh ta thôi. Không có gì\Nghê gớm hết. Xong rồi.
Dialogue: 0,0:04:45.79,0:04:49.13,Default,,0,0,0,,Ơ… Cái gì? Hả?
Dialogue: 0,0:04:49.21,0:04:52.84,Default,,0,0,0,,Vậy là chín lần trong hôm\Nnay. À không, thật ra là mười.
Dialogue: 0,0:04:52.92,0:04:54.92,Default,,0,0,0,,Cái quái gì vậy? Giống như\Nbăng tua nhanh vậy đó hả trời.
Dialogue: 0,0:04:55.01,0:04:57.47,Default,,0,0,0,,Cho tôi một cơ hội đi.
Dialogue: 0,0:04:57.55,0:04:59.89,Default,,0,0,0,,Cơ hội hả? Cơ hội gì ở đây?
Dialogue: 0,0:05:00.56,0:05:04.15,Default,,0,0,0,,Chỉ cần anh mang tôi theo làm việc là\Nđược rồi. Tôi sẽ không làm hư chuyện đâu.
Dialogue: 0,0:05:16.87,0:05:20.92,Default,,0,0,0,,Ít ra thì mày cũng là một đứa can\Nđảm. Thôi được rồi, chỉ một cơ hội thôi.
Dialogue: 0,0:05:20.99,0:05:22.58,Default,,0,0,0,,Trời ơi lại vậy nữa rồi.
Dialogue: 0,0:05:22.66,0:05:26.25,Default,,0,0,0,,Gloria đã giúp anh nhiều, biết đâu\Ntên nhóc này cũng được việc. Hửm.
Dialogue: 0,0:05:26.83,0:05:29.54,Default,,0,0,0,,Tôi cám ơn anh. Hơ, gì vậy chứ?
Dialogue: 0,0:05:29.63,0:05:34.30,Default,,0,0,0,,Thư giãn đi nhóc, chỉ là gắn máy theo dõi\Nthôi. Tao không muốn mày trốn khỏi tao.
Dialogue: 0,0:05:34.38,0:05:35.38,Default,,0,0,0,,Tôi không bỏ chạy đâu.
Dialogue: 0,0:05:35.47,0:05:38.31,Default,,0,0,0,,Mấy đứa trước khi bỏ trốn thường hay nói
Dialogue: 0,0:05:38.39,0:05:41.27,Default,,0,0,0,,câu đó lắm. Tao sẽ liên\Nlạc với mày vào sáng mai.
Dialogue: 0,0:05:46.85,0:05:50.10,Default,,0,0,0,,Thì ra đám người đó… bọn\Nhọ cùng một băng với cô.
Dialogue: 0,0:05:52.61,0:05:53.53,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:05:54.99,0:05:58.12,Default,,0,0,0,,Sao cô không nói ngay từ đầu…\NNói cái gì mà nói chứ? Maine cứ liên tục
Dialogue: 0,0:05:58.20,0:06:01.33,Default,,0,0,0,,lải nhải về vụ Sandevistan quý giá của anh\Nta mất tích không dấu vết. Tôi thấy cậu
Dialogue: 0,0:06:01.41,0:06:04.54,Default,,0,0,0,,dùng nó ở trên tàu\Nnên mới kiểm tra một chút
Dialogue: 0,0:06:04.62,0:06:07.79,Default,,0,0,0,,coi sao, quả nhiên đúng là đồ của Maine.
Dialogue: 0,0:06:08.54,0:06:13.80,Default,,0,0,0,,{\an8}Vậy nên cô liếc mắt đưa tình với tôi chờ\Nhọ xuất hiện. Tất cả chỉ toàn là dối trá.
Dialogue: 0,0:06:13.88,0:06:15.13,Default,,0,0,0,,{\an8}Sao cậu còn chưa chịu về đi?
Dialogue: 0,0:06:16.13,0:06:17.05,Default,,0,0,0,,{\an8}Ờ.
Dialogue: 0,0:06:22.60,0:06:25.02,Default,,0,0,0,,{\an8}Chuyện của mẹ cậu, tôi\Nxin thành thật chia buồn.
Dialogue: 0,0:06:53.25,0:06:54.71,Default,,0,0,0,,GỌI\NHIỆU TRƯỞNG
Dialogue: 0,0:06:55.26,0:06:59.22,Default,,0,0,0,,Cậu Martinez à, ngày hôm nay tôi có một
Dialogue: 0,0:06:59.30,0:07:03.26,Default,,0,0,0,,tin tốt dành cho cậu đây. Dựa trên thành\Ntích học tập xuất sắc của cậu, Tập đoàn
Dialogue: 0,0:07:03.35,0:07:07.31,Default,,0,0,0,,Arasaka đã trao cho cậu học bổng. Họ rất\Nmong cậu có thể quay lại và tiếp tục việc
Dialogue: 0,0:07:07.39,0:07:11.27,Default,,0,0,0,,học. Xin chúc mừng cậu. Kể từ bây\Ngiờ cậu có thể đi học trở lại rồi.
Dialogue: 0,0:07:11.81,0:07:15.27,Default,,0,0,0,,Đây là một cơ hội hiếm có và đầy vinh dự.
Dialogue: 0,0:07:15.36,0:07:18.82,Default,,0,0,0,,Nhưng vẫn còn một chuyện. Đó là hành vi\Nbạo lực của cậu ở Học viện ngày hôm qua.
Dialogue: 0,0:07:18.90,0:07:22.36,Default,,0,0,0,,Đáng tiếc là chúng tôi thật sự không thể\Nnào bỏ qua được. Tôi đã nói chuyện với
Dialogue: 0,0:07:22.45,0:07:25.91,Default,,0,0,0,,cậu Tanaka rồi. Cậu ấy đã vô cùng tử tế và\Ncũng đã chấp thuận… Bỏ qua lỗi trong học
Dialogue: 0,0:07:25.99,0:07:29.45,Default,,0,0,0,,bạ của cậu. Cậu ấy chỉ cần cậu thay\Nđổi thái độ và xin lỗi một cách chân
Dialogue: 0,0:07:29.54,0:07:32.92,Default,,0,0,0,,thành. Để biết thêm chi tiết thì cậu…
Dialogue: 0,0:07:36.75,0:07:38.04,Default,,0,0,0,,Hửm?
Dialogue: 0,0:07:38.13,0:07:39.55,Default,,0,0,0,,Nè nhóc, có việc cho mày.
Dialogue: 0,0:07:50.02,0:07:51.56,Default,,0,0,0,,Ở bên này, nhóc con.
Dialogue: 0,0:07:55.69,0:07:57.23,Default,,0,0,0,,Nhóc con, chào buổi sáng.
Dialogue: 0,0:07:57.32,0:08:00.82,Default,,0,0,0,,Dữ liệu không sai, nó chỉ là một\Nthằng nhóc. Theo kịp không đây?
Dialogue: 0,0:08:00.90,0:08:02.15,Default,,0,0,0,,Cứ để xem.
Dialogue: 0,0:08:02.24,0:08:04.41,Default,,0,0,0,,Hehe. Tôi biết là cô thấy nó rất ngon
Dialogue: 0,0:08:04.49,0:08:06.70,Default,,0,0,0,,trai, nhưng cô đừng hòng\Nxơ múi gì hết nghe chưa.
Dialogue: 0,0:08:06.78,0:08:08.32,Default,,0,0,0,,Sao chúng ta phải chịu đựng thằng cha này?
Dialogue: 0,0:08:10.33,0:08:15.29,Default,,0,0,0,,Người này là Kiwi. Dorio và Pilar thì\Nmày gặp rồi. Hãy mau ngồi xuống đi.
Dialogue: 0,0:08:16.84,0:08:19.68,Default,,0,0,0,,Tên của tôi là David…\NAi hỏi? Nhanh chóng vào việc
Dialogue: 0,0:08:19.76,0:08:22.64,Default,,0,0,0,,luôn đi nhóc. Gắn thẻ nhớ vô.
Dialogue: 0,0:08:28.39,0:08:31.02,Default,,0,0,0,,Đó là tài xế kiêm vệ sĩ của Tập đoàn
Dialogue: 0,0:08:31.10,0:08:33.73,Default,,0,0,0,,Arasaka, tên là Maxim. Nhiệm vụ\Nchúng ta là lấy dữ liệu định vị của
Dialogue: 0,0:08:33.81,0:08:36.73,Default,,0,0,0,,chiếc limo mà hắn lái.
Dialogue: 0,0:08:36.81,0:08:39.10,Default,,0,0,0,,{\an8}Chỉ dữ liệu thôi hả?\NKhông trộm cái xe sao?
Dialogue: 0,0:08:39.19,0:08:41.98,Default,,0,0,0,,{\an8}Ta mà trộm xe thì đám lao nhao của Arasaka
Dialogue: 0,0:08:42.07,0:08:44.86,Default,,0,0,0,,sẽ bu lại như ruồi bu phân. Nên\Nchỉ cần… Lấy dữ liệu là xong.
Dialogue: 0,0:08:45.62,0:08:46.54,Default,,0,0,0,,Lấy kiểu gì?
Dialogue: 0,0:08:47.28,0:08:49.57,Default,,0,0,0,,Cá cược đấm bốc là niềm vui duy nhất của
Dialogue: 0,0:08:49.66,0:08:51.95,Default,,0,0,0,,tên đầu đất này. Cuối tuần nào hắn cũng\Nvác cái mông heo của mình tới trường đấu.
Dialogue: 0,0:08:52.04,0:08:54.33,Default,,0,0,0,,Luôn
Dialogue: 0,0:08:54.42,0:08:56.71,Default,,0,0,0,,dồn tiền để đặt cược vào một\Nngười có tên là Butcher, nhờ cú đấm
Dialogue: 0,0:08:56.79,0:08:58.96,Default,,0,0,0,,móc nứt sọ của cô ta.
Dialogue: 0,0:09:01.42,0:09:05.34,Default,,0,0,0,,Mà… Không chỉ mình hắn như vậy. Hầu hết
Dialogue: 0,0:09:05.43,0:09:09.73,Default,,0,0,0,,mọi người tới chỉ để coi cô ta sơn đỏ cái\Nlồng bằng máu của mấy đứa đần. Có điều…
Dialogue: 0,0:09:09.81,0:09:11.35,Default,,0,0,0,,Hừm.
Dialogue: 0,0:09:15.19,0:09:18.07,Default,,0,0,0,,Cuối tuần này con khốn đó… Sẽ bị đánh gục
Dialogue: 0,0:09:18.15,0:09:21.03,Default,,0,0,0,,ở ngay vòng đầu tiên,\Nnhư một đống thịt thiu.
Dialogue: 0,0:09:29.45,0:09:30.33,Default,,0,0,0,,Sao nói nghe chắc ăn vậy?
Dialogue: 0,0:09:31.12,0:09:32.08,Default,,0,0,0,,Chắc chứ sao không.
Dialogue: 0,0:09:36.87,0:09:38.29,Default,,0,0,0,,Mà nói gì thì nói, hắn có thói quen uống
Dialogue: 0,0:09:38.38,0:09:39.80,Default,,0,0,0,,cho quên sầu ở một quán rượu rách\Nnát. Lúc hắn ta uống tới say khướt rồi
Dialogue: 0,0:09:39.88,0:09:41.30,Default,,0,0,0,,thì… Chính là lúc mày hành động.
Dialogue: 0,0:09:52.06,0:09:55.65,Default,,0,0,0,,Mày phải nhanh chóng lấy chìa khóa rồi
Dialogue: 0,0:09:55.73,0:09:59.32,Default,,0,0,0,,lập tức đưa nó cho Dorio. Cô ấy sẽ làm giả\Nmột bản sao, mở khóa lấy cắp dữ liệu định
Dialogue: 0,0:09:59.40,0:10:03.03,Default,,0,0,0,,vị, trong khi tên tay sai Maxim\Nkia vẫn còn đang bất tỉnh vì say.
Dialogue: 0,0:10:03.57,0:10:05.82,Default,,0,0,0,,Nhưng việc đó cứ để bọn tao. Trước khi hắn
Dialogue: 0,0:10:05.90,0:10:08.15,Default,,0,0,0,,ta kịp phát hiện ra, chỉ cần mày\Ntrả chìa khóa về chỗ cũ là được. Đơn
Dialogue: 0,0:10:08.24,0:10:10.53,Default,,0,0,0,,giản như đang giỡn vậy đó.
Dialogue: 0,0:10:12.08,0:10:14.67,Default,,0,0,0,,Đợi đã. Hắn đang có một cuộc gọi từ sếp.
Dialogue: 0,0:10:14.75,0:10:17.04,Default,,0,0,0,,Thằng chó này ngày nghỉ mà cũng không
Dialogue: 0,0:10:17.12,0:10:19.83,Default,,0,0,0,,được yên nữa. Gặp tôi là\Nkệ luôn khỏi nghe máy.
Dialogue: 0,0:10:19.92,0:10:21.92,Default,,0,0,0,,Không hay rồi. Sếp hắn kêu hắn tới liền.
Dialogue: 0,0:10:22.00,0:10:23.38,Default,,0,0,0,,Má ơi, vào ngày nghỉ sao?
Dialogue: 0,0:10:23.46,0:10:24.50,Default,,0,0,0,,Dữ liệu vẫn chưa sao chép xong!
Dialogue: 0,0:10:25.05,0:10:28.22,Default,,0,0,0,,Mẹ nó, phải đổi kế hoạch liền. David nghe
Dialogue: 0,0:10:28.30,0:10:31.47,Default,,0,0,0,,đây, lấy chìa khóa ra xe\Nliền. Rebecca, mau giữ chân hắn.
Dialogue: 0,0:10:32.60,0:10:33.68,Default,,0,0,0,,Hả
Dialogue: 0,0:10:33.77,0:10:34.69,Default,,0,0,0,,Hành động nhanh lên!
Dialogue: 0,0:10:37.52,0:10:39.23,Default,,0,0,0,,- Á…\N- Hả? Trời ơi!
Dialogue: 0,0:10:39.31,0:10:42.94,Default,,0,0,0,,- Cho tôi xin lỗi nha… Nha nha.\N- Mắt mũi để đâu vậy hả… Ô ô ô hô hô!
Dialogue: 0,0:10:44.19,0:10:46.69,Default,,0,0,0,,Lên xe đi. Phải lấy bằng được\Ndữ liệu trước khi hắn ra tới.
Dialogue: 0,0:10:47.95,0:10:48.87,Default,,0,0,0,,Phải làm sao mới được?
Dialogue: 0,0:10:48.95,0:10:50.45,Default,,0,0,0,,Cứ để đó tôi xử lý cho.
Dialogue: 0,0:10:50.53,0:10:52.32,Default,,0,0,0,,- Ơ.\N- Qua ngồi ghế lái đi.
Dialogue: 0,0:10:54.49,0:10:55.91,Default,,0,0,0,,Whoa…
Dialogue: 0,0:11:00.50,0:11:01.54,Default,,0,0,0,,Trời ôi.
Dialogue: 0,0:11:03.67,0:11:04.63,Default,,0,0,0,,Làm được không?
Dialogue: 0,0:11:04.71,0:11:09.17,Default,,0,0,0,,Tôi đang tập trung, đừng có ồn. Tường TCX\Ncủa Arasaka đúng là phiền phức thiệt mà.
Dialogue: 0,0:11:10.59,0:11:14.51,Default,,0,0,0,,- Xin lỗi anh lần nữa nha trai đẹp!\N- Ờ. Chỉ là chuyện nhỏ thôi mà cưng.
Dialogue: 0,0:11:14.60,0:11:17.06,Default,,0,0,0,,Lần sau tôi nhất định sẽ bù cho anh nha.
Dialogue: 0,0:11:17.14,0:11:20.23,Default,,0,0,0,,{\an8}Hử? Hả? Con khốn kia!
Dialogue: 0,0:11:20.31,0:11:24.02,Default,,0,0,0,,Ủa? Sao anh chửi tôi? Anh\Ndữ quá hà, sợ ghê luôn!
Dialogue: 0,0:11:24.11,0:11:25.99,Default,,0,0,0,,Chúng ta đã bị lộ rồi. Mục tiêu tới.
Dialogue: 0,0:11:26.07,0:11:27.15,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:11:27.24,0:11:28.45,Default,,0,0,0,,Một chút nữa thôi.
Dialogue: 0,0:11:28.53,0:11:29.57,Default,,0,0,0,,Đã hết thời gian. Hãy dọt lẹ đi!
Dialogue: 0,0:11:29.65,0:11:31.90,Default,,0,0,0,,Chờ thêm một chút. Xong rồi.
Dialogue: 0,0:11:33.49,0:11:34.53,Default,,0,0,0,,Sao không mở được?
Dialogue: 0,0:11:34.62,0:11:36.00,Default,,0,0,0,,Hệ thống an ninh hoạt động lại hả?
Dialogue: 0,0:11:36.08,0:11:41.50,Default,,0,0,0,,{\an8}- Như tôi đã nói. Hết thời gian.\N- A!
Dialogue: 0,0:11:41.58,0:11:47.00,Default,,0,0,0,,Chết tiệt, không còn đường\Nlui rồi. Hãy nổ máy xe đi.
Dialogue: 0,0:11:47.09,0:11:52.51,Default,,0,0,0,,- Hả?\N- Mau lái đi nhóc.
Dialogue: 0,0:11:52.59,0:11:55.80,Default,,0,0,0,,- Nhưng mà nào giờ tôi có biết lái xe đâu!\N- Thì tới lúc học rồi đó.
Dialogue: 0,0:11:55.89,0:11:59.27,Default,,0,0,0,,Cho tao thấy… Khả năng của mày đi.
Dialogue: 0,0:11:59.35,0:12:05.65,Default,,0,0,0,,Nghe tao nói không hả? Bước ra đây tao
Dialogue: 0,0:12:05.73,0:12:12.03,Default,,0,0,0,,cho mày biết đá biết vàng. Mở ra! Cái\Ngì? Không được làm vậy, đây là xe của tao,
Dialogue: 0,0:12:12.11,0:12:18.45,Default,,0,0,0,,dừng lại… Dừng lại đi trời ơi! Dừng\Nxe lại. Khốn kiếp, dừng lại cho tao!
Dialogue: 0,0:12:20.87,0:12:23.58,Default,,0,0,0,,{\an8}Hahahaha. Cũng may đó không phải là xe
Dialogue: 0,0:12:23.67,0:12:26.76,Default,,0,0,0,,{\an8}của tao đó nha. Giờ chạy thẳng tới chỗ\NAldo luôn đi. Cô tắt định vị chưa Lucy?
Dialogue: 0,0:12:26.84,0:12:29.26,Default,,0,0,0,,{\an8}Không tắt được từ bên trong. Có thiết bị
Dialogue: 0,0:12:29.34,0:12:31.76,Default,,0,0,0,,{\an8}gây nhiễu nhưng mà trình mã hóa cứ liên\Ntục thay đổi nên vị trí của ta sẽ sớm bị
Dialogue: 0,0:12:31.84,0:12:34.47,Default,,0,0,0,,{\an8}lộ. Trừ khi tìm được chỗ ẩn náu tốt.
Dialogue: 0,0:12:34.55,0:12:37.22,Default,,0,0,0,,{\an8}Vậy thì tới chỗ Aldo là đúng rồi đó. Chúng
Dialogue: 0,0:12:37.31,0:12:40.15,Default,,0,0,0,,{\an8}tôi cũng sẽ tới đó luôn. Tín\Nhiệu lại bị nhiễu nữa rồi.
Dialogue: 0,0:12:40.22,0:12:41.26,Default,,0,0,0,,{\an8}Tấp vô lề nha?
Dialogue: 0,0:12:41.35,0:12:42.85,Default,,0,0,0,,{\an8}Không thể được! Vị trí của hai người mà
Dialogue: 0,0:12:42.94,0:12:44.78,Default,,0,0,0,,{\an8}bị lộ là có người theo sát liền.\NNhất định không được dừng, bằng mọi
Dialogue: 0,0:12:44.85,0:12:46.73,Default,,0,0,0,,{\an8}giá phải tiếp tục chạy.
Dialogue: 0,0:12:47.90,0:12:48.94,Default,,0,0,0,,Nhập đường đi rồi đó.
Dialogue: 0,0:12:49.03,0:12:49.95,Default,,0,0,0,,Cảm ơn cô nha.
Dialogue: 0,0:12:51.36,0:12:52.24,Default,,0,0,0,,Cô nghĩ ta thoát được chứ?
Dialogue: 0,0:12:52.78,0:12:53.61,Default,,0,0,0,,Trông cậy hết vào cậu.
Dialogue: 0,0:12:56.87,0:12:58.87,Default,,0,0,0,,Nhìn cậu kìa, coi bộ cũng thuần thục lắm.
Dialogue: 0,0:12:58.95,0:13:00.83,Default,,0,0,0,,Cô nghĩ vậy sao?
Dialogue: 0,0:13:00.91,0:13:02.91,Default,,0,0,0,,Có lẽ vậy, nếu cậu không\Nbật chế độ lái tự động.
Dialogue: 0,0:13:03.79,0:13:05.17,Default,,0,0,0,,- Sao cũng được hết.\N- Tới rồi.
Dialogue: 0,0:13:05.71,0:13:06.63,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:08.80,0:13:09.88,Default,,0,0,0,,Là anh em Móng Hổ sao?
Dialogue: 0,0:13:12.72,0:13:14.56,Default,,0,0,0,,- Gầm rú lên, chúng mày!\N- Chắc Maxim treo thưởng để tìm chúng ta.
Dialogue: 0,0:13:14.63,0:13:17.59,Default,,0,0,0,,Nhanh dữ dạ?\NBởi vậy không nên dính tới bọn tập đoàn.
Dialogue: 0,0:13:17.68,0:13:21.06,Default,,0,0,0,,Mà cũng sắp tới chỗ quẹo rồi đó, cậu nhớ\Nđể ý nha. Vào đường cao tốc thôi.
Dialogue: 0,0:13:21.14,0:13:24.64,Default,,0,0,0,,- Này, này, này, này!\N- Ngõ cụt rồi, thằng đần!
Dialogue: 0,0:13:24.73,0:13:27.23,Default,,0,0,0,,Lũ hèn! Dừng lại và chiến đấu đi!\NCứ đợi đấy! Bọn tao bắt
Dialogue: 0,0:13:27.31,0:13:29.98,Default,,0,0,0,,được sẽ xé xác chúng mày!
Dialogue: 0,0:13:30.07,0:13:33.70,Default,,0,0,0,,Phải tìm cách cắt đuôi\Nchúng thôi. Tiêu rồi, kẹt xe?
Dialogue: 0,0:13:33.78,0:13:34.78,Default,,0,0,0,,Ái chà chà chà chà.
Dialogue: 0,0:13:35.82,0:13:36.99,Default,,0,0,0,,Không hay rồi.
Dialogue: 0,0:13:52.38,0:13:54.05,Default,,0,0,0,,À… Chúng tới gần rồi kìa.
Dialogue: 0,0:13:54.13,0:13:55.76,Default,,0,0,0,,Đồ chậm như rùa!
Dialogue: 0,0:13:58.43,0:13:59.72,Default,,0,0,0,,Thắt chặt dây an toàn nha!
Dialogue: 0,0:13:59.80,0:14:00.80,Default,,0,0,0,,Hả?
Dialogue: 0,0:14:00.89,0:14:02.68,Default,,0,0,0,,Bọn tao sẽ lóc xương mày!
Dialogue: 0,0:14:03.22,0:14:04.14,Default,,0,0,0,,Chờ…
Dialogue: 0,0:14:11.65,0:14:14.53,Default,,0,0,0,,Quay lại đây, thằng sát nhân khốn kiếp!
Dialogue: 0,0:14:28.17,0:14:30.17,Default,,0,0,0,,Mày chết chắc rồi!
Dialogue: 0,0:14:59.74,0:15:01.03,Default,,0,0,0,,Sao ra ngoài đây?
Dialogue: 0,0:15:01.12,0:15:05.25,Default,,0,0,0,,Lẽ ra họ phải tới rồi chứ. Mà… Ít ra\Nthì thiết bị gây nhiễu vẫn còn trụ được.
Dialogue: 0,0:15:07.46,0:15:08.54,Default,,0,0,0,,Í trời, mở được hả?
Dialogue: 0,0:15:08.62,0:15:10.08,Default,,0,0,0,,Tôi đã mở khóa nãy giờ rồi.
Dialogue: 0,0:15:11.46,0:15:13.00,Default,,0,0,0,,Ở yên đó nha. Tôi đi coi thử.
Dialogue: 0,0:15:18.47,0:15:20.47,Default,,0,0,0,,Hây a!
Dialogue: 0,0:15:25.22,0:15:30.52,Default,,0,0,0,,Chắc mày nghĩ mày hay ho\Nlắm khi bày ra trò đó.
Dialogue: 0,0:15:52.71,0:15:53.59,Default,,0,0,0,,CHẾT ĐI!
Dialogue: 0,0:15:56.71,0:15:59.17,Default,,0,0,0,,- Nôn máu mày ra đây cho tao!\N- Hả?
Dialogue: 0,0:16:00.34,0:16:01.26,Default,,0,0,0,,A!
Dialogue: 0,0:16:03.09,0:16:06.05,Default,,0,0,0,,Í…
Dialogue: 0,0:16:19.49,0:16:20.74,Default,,0,0,0,,Á!
Dialogue: 0,0:16:34.29,0:16:35.21,Default,,0,0,0,,Ui trời.
Dialogue: 0,0:16:41.38,0:16:42.59,Default,,0,0,0,,Xin lỗi tôi tới trễ.
Dialogue: 0,0:16:57.40,0:17:00.49,Default,,0,0,0,,Nè, lần đầu như vậy là\Nkhông tệ chút nào đâu Lính Mới.
Dialogue: 0,0:17:00.57,0:17:01.49,Default,,0,0,0,,Cũng ổn phải không?
Dialogue: 0,0:17:02.15,0:17:03.53,Default,,0,0,0,,Chào mừng cậu nhập hội bọn tôi.
Dialogue: 0,0:17:06.16,0:17:08.83,Default,,0,0,0,,Nhưng có điều này nhóc đừng quên. Người
Dialogue: 0,0:17:08.91,0:17:11.58,Default,,0,0,0,,duy nhất cậu có thể tin tưởng trong\Nthế giới này, không ai khác ngoài cậu.
Dialogue: 0,0:17:15.08,0:17:17.96,Default,,0,0,0,,Nếu cứ dựa vào bọn này thì\Ncoi như cậu chết chắc rồi đó.
Dialogue: 0,0:17:18.79,0:17:19.71,Default,,0,0,0,,Tôi đã biết rồi.
Dialogue: 0,0:17:24.55,0:17:27.47,Default,,0,0,0,,- Nè! Nè!\N- Dính luôn, dính nữa!
Dialogue: 0,0:17:28.22,0:17:30.89,Default,,0,0,0,,Coi mấy ngón tay điêu luyện này đi\Nlũ ngốc! Ngón tay nhanh nhất khu này!
Dialogue: 0,0:17:30.97,0:17:33.85,Default,,0,0,0,,Nghe đồn "chân" anh cũng nhanh\Nđâu thua gì tay đúng hôn? Hả hả hả?
Dialogue: 0,0:17:33.93,0:17:40.85,Default,,0,0,0,,Hả? Nói tầm xàm ba láp. Có muốn thử\Nkhông nè? Thử coi nhanh cỡ nào há há.
Dialogue: 0,0:17:46.16,0:17:50.96,Default,,0,0,0,,Cảm ơn. Thuốc ức chế miễn dịch. Bao nhiêu
Dialogue: 0,0:17:51.04,0:17:55.88,Default,,0,0,0,,đây chắc cũng đủ cho một tháng. Còn\Ncái này chính là phần dành cho cậu.
Dialogue: 0,0:17:56.92,0:17:58.05,Default,,0,0,0,,Nhiều dữ vậy!
Dialogue: 0,0:17:58.13,0:18:00.72,Default,,0,0,0,,Mọi người ai cũng được chia phần. Đó là
Dialogue: 0,0:18:00.80,0:18:03.84,Default,,0,0,0,,cách làm việc của tôi.\NCậu chưa lắp gì nhiều ha?
Dialogue: 0,0:18:04.51,0:18:05.47,Default,,0,0,0,,Ơ?
Dialogue: 0,0:18:05.55,0:18:07.30,Default,,0,0,0,,Lo để dành tiền đi, rồi nâng cấp phần
Dialogue: 0,0:18:07.38,0:18:09.13,Default,,0,0,0,,mềm của cậu. Cơ thể sinh học không thể\Nnào chịu nổi việc
Dialogue: 0,0:18:09.22,0:18:10.97,Default,,0,0,0,,dùng Sandevistan lâu đâu.
Dialogue: 0,0:18:11.97,0:18:12.81,Default,,0,0,0,,Anh nói cũng đúng.
Dialogue: 0,0:18:13.43,0:18:16.27,Default,,0,0,0,,Đáng lý ra cậu có thể giết tên Móng Hổ
Dialogue: 0,0:18:16.35,0:18:19.23,Default,,0,0,0,,đó, hoặc bất cứ tên côn đồ nào\Nmà không hề gặp trở ngại gì.
Dialogue: 0,0:18:22.82,0:18:26.28,Default,,0,0,0,,A… Xài tiền để giúp cậu mạnh hơn không phí
Dialogue: 0,0:18:26.36,0:18:29.86,Default,,0,0,0,,chút nào. Cậu phải luôn luôn nhớ chân lý\Nđó áp dụng cho đồ, và cho cả đồng đội.
Dialogue: 0,0:18:32.83,0:18:33.75,Default,,0,0,0,,Ờ hehe. Ơ?
Dialogue: 0,0:18:44.92,0:18:45.84,Default,,0,0,0,,Chết tiệt.
Dialogue: 0,0:18:52.76,0:18:55.85,Default,,0,0,0,,Rõ ràng tôi đã yêu cầu lấy dữ liệu định vị
Dialogue: 0,0:18:55.93,0:18:59.43,Default,,0,0,0,,chứ không phải là chiếc limousine.\NNó là tài sản của Tập đoàn Arasaka.
Dialogue: 0,0:18:59.52,0:19:01.73,Default,,0,0,0,,Chúng tôi đã lấy được thứ ông yêu cầu.
Dialogue: 0,0:19:01.81,0:19:05.15,Default,,0,0,0,,Thứ tôi yêu cầu là sự kín đáo kia\Nmà, các anh còn không biết hay sao.
Dialogue: 0,0:19:05.23,0:19:07.27,Default,,0,0,0,,Chúng tôi đã cố hết sức nhưng mọi thứ
Dialogue: 0,0:19:07.36,0:19:09.49,Default,,0,0,0,,không như dự tính, nên\Nđành tùy cơ ứng biến thôi.
Dialogue: 0,0:19:09.57,0:19:13.12,Default,,0,0,0,,Tôi phải nắm được thói quen và lộ\Ntrình của Tanaka bằng bất cứ giá nào.
Dialogue: 0,0:19:13.20,0:19:16.25,Default,,0,0,0,,Vậy mới nói. Ông kiểm tra dữ\Nliệu định vị đi. Ở trỏng hết mà.
Dialogue: 0,0:19:16.87,0:19:19.79,Default,,0,0,0,,Lần này các anh làm ăn rầm rộ như vậy
Dialogue: 0,0:19:19.87,0:19:23.08,Default,,0,0,0,,nên chắc chắn đã bứt dây động rừng. Hắn\Nta cảnh giác và thay đổi địa điểm rồi.
Dialogue: 0,0:19:23.17,0:19:24.84,Default,,0,0,0,,Đổi địa điểm để làm gì kia chứ?
Dialogue: 0,0:19:24.92,0:19:26.67,Default,,0,0,0,,Anh không cần biết chuyện đó.
Dialogue: 0,0:19:26.76,0:19:28.72,Default,,0,0,0,,Khốn kiếp mà. Sao chúng tôi có thể làm
Dialogue: 0,0:19:28.80,0:19:30.84,Default,,0,0,0,,việc khi ông không cho\Nchúng tôi biết gì hết?
Dialogue: 0,0:19:30.93,0:19:34.60,Default,,0,0,0,,Vì đơn giản là nếu như anh càng biết ít
Dialogue: 0,0:19:34.68,0:19:38.35,Default,,0,0,0,,thông tin thì tôi càng ít gặp rủi ro. Anh\Ncần phải nhớ cho kỹ, tôi không trả tiền để
Dialogue: 0,0:19:38.43,0:19:42.10,Default,,0,0,0,,anh ở đó suy nghĩ lung tung. Tôi trả tiền\Nđể anh hoàn thành danh sách công việc của
Dialogue: 0,0:19:42.19,0:19:45.86,Default,,0,0,0,,tôi. Tôi là người ra lệnh còn anh là\Nngười tuân theo lệnh của tôi. Đó là
Dialogue: 0,0:19:45.94,0:19:49.49,Default,,0,0,0,,luật giữa chúng ta. Anh có rõ chưa?
Dialogue: 0,0:19:52.20,0:19:55.75,Default,,0,0,0,,Xớ. Ờ. Tôi rõ rồi ông bạn.
Dialogue: 0,0:19:55.83,0:19:58.58,Default,,0,0,0,,Vậy thì tốt. Giờ ta lại tiếp tục chờ cho
Dialogue: 0,0:19:58.66,0:20:01.87,Default,,0,0,0,,tới khi hắn mất cảnh giác.\NTôi liên lạc với anh sau.
Dialogue: 0,0:20:01.96,0:20:03.92,Default,,0,0,0,,Được. Hẹn gặp lại sau.
Dialogue: 0,0:20:08.26,0:20:09.18,Default,,0,0,0,,Người đó là ai vậy?
Dialogue: 0,0:20:10.17,0:20:13.13,Default,,0,0,0,,Là Faraday, người đã giao việc cho chúng
Dialogue: 0,0:20:13.22,0:20:16.18,Default,,0,0,0,,ta làm. Ông ta cũng là\Nngười môi giới hàng đầu ở đây.
Dialogue: 0,0:20:17.68,0:20:19.68,Default,,0,0,0,,Tôi cứ tưởng đâu anh là\Nsếp lớn nhất rồi chứ.
Dialogue: 0,0:20:20.31,0:20:24.06,Default,,0,0,0,,Tôi là người phụ trách tất cả mọi việc.
Dialogue: 0,0:20:24.15,0:20:27.90,Default,,0,0,0,,Ông ta trả tiền để tôi làm việc đó. Trong\Ncái giới này thì cậu sẽ chẳng là gì nếu
Dialogue: 0,0:20:27.98,0:20:31.73,Default,,0,0,0,,không có ông ta. Chỉ đơn giản như vậy\Nthôi. Không cần phải suy nghĩ nhiều quá
Dialogue: 0,0:20:31.82,0:20:35.57,Default,,0,0,0,,đâu. Tối nay chúng ta ăn mừng nha.
Dialogue: 0,0:21:00.93,0:21:02.10,Default,,0,0,0,,Nè.
Dialogue: 0,0:21:02.18,0:21:05.14,Default,,0,0,0,,Ừm. Hửm? Cô là ai? Tôi có quen cô hông?
Dialogue: 0,0:21:05.23,0:21:08.57,Default,,0,0,0,,Gì vậy trời, không nhớ tôi\Nsau những gì ta trải qua sao?
Dialogue: 0,0:21:12.03,0:21:13.20,Default,,0,0,0,,Haiz, hừm.
Dialogue: 0,0:21:13.28,0:21:17.03,Default,,0,0,0,,- À, cô là người ở quán bar đây mà.\N- Có thích màn kịch đó của tôi không?
Dialogue: 0,0:21:17.12,0:21:18.33,Default,,0,0,0,,Thì cũng có.
Dialogue: 0,0:21:18.41,0:21:23.21,Default,,0,0,0,,Ưm. Tôi là Rebecca. Nghe nói là cậu\Nmới gia nhập đội của Maine phải hông?
Dialogue: 0,0:21:23.75,0:21:26.46,Default,,0,0,0,,Chắc vậy á. Cái này có ga hả?
Dialogue: 0,0:21:26.54,0:21:31.13,Default,,0,0,0,,Cạn! Hẹn gặp lại sau\Nnha. Thiệt là hân hạnh.
Dialogue: 0,0:21:31.21,0:21:32.13,Default,,0,0,0,,Tôi cũng hân hạnh…
Dialogue: 0,0:21:38.85,0:21:40.06,Default,,0,0,0,,GỌI\NHIỆU TRƯỞNG
Dialogue: 0,0:21:40.64,0:21:43.60,Default,,0,0,0,,Chào cậu Martinez. Mà bên chỗ của cậu sao
Dialogue: 0,0:21:43.68,0:21:46.68,Default,,0,0,0,,nghe có vẻ ồn ào quá vậy? Bây\Ngiờ cậu nghe máy có tiện không?
Dialogue: 0,0:21:47.65,0:21:49.49,Default,,0,0,0,,Không sao. Ông cứ nói đi.
Dialogue: 0,0:21:49.57,0:21:52.45,Default,,0,0,0,,Chắc là cậu đã nhận được lời\Nnhắn của tôi rồi có phải không?
Dialogue: 0,0:21:52.53,0:21:54.24,Default,,0,0,0,,Phải đó, tôi nhận được rồi.
Dialogue: 0,0:21:54.32,0:21:56.66,Default,,0,0,0,,{\an8}Ờ tốt quá, vậy giờ cậu tính\Nxin lỗi cậu Tanaka như thế nào…
Dialogue: 0,0:21:56.74,0:21:59.33,Default,,0,0,0,,Nhờ ông chuyển lời cho\Ntên Katsuo đó dùm tôi.
Dialogue: 0,0:21:59.41,0:22:02.04,Default,,0,0,0,,- Chuyện này có lẽ tốt nhất là cậu nên…\N- Nếu như hắn muốn trả thù thì tôi nhất
Dialogue: 0,0:22:02.12,0:22:04.75,Default,,0,0,0,,định sẽ đợi. Nhưng\Ntôi sẽ không nương tay với
Dialogue: 0,0:22:04.83,0:22:07.42,Default,,0,0,0,,hắn thêm bất cứ lần nào đâu.\NCác người mau biến đi cho tôi!
Dialogue: 0,0:22:18.22,0:22:19.64,Default,,0,0,0,,{\an8}Hửm?
