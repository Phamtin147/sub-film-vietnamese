Dialogue: 0,0:02:06.30,0:02:07.97,Default,,0,0,0,,KIẾP SAU
Dialogue: 0,0:02:10.47,0:02:11.39,Default,,0,0,0,,Có gì không?
Dialogue: 0,0:02:11.47,0:02:13.18,Default,,0,0,0,,Không thấy ai hết, yên tĩnh lắm!
Dialogue: 0,0:02:13.27,0:02:14.35,Default,,0,0,0,,Khốn kiếp.
Dialogue: 0,0:02:14.43,0:02:17.43,Default,,0,0,0,,Faraday suy đoán rất đúng. Tên\Nđó đã thay đổi địa điểm rồi.
Dialogue: 0,0:02:17.52,0:02:21.19,Default,,0,0,0,,Chúng ta lại thất bại thêm một lần\Nnữa. Giờ thì đúng là hết cách rồi.
Dialogue: 0,0:02:21.27,0:02:24.65,Default,,0,0,0,,Chỉ vì chiếc xe mà đám Arasaka dọn\Nđi sao? Chắc có chuyện gì đó lớn hơn.
Dialogue: 0,0:02:24.73,0:02:27.61,Default,,0,0,0,,Nhưng vụ này lại rất rủi ro ở chỗ tên đó
Dialogue: 0,0:02:27.70,0:02:30.79,Default,,0,0,0,,không chịu nói câu nào. Giá mà Faraday\Ncho ta biết hắn đang theo đuổi cái gì.
Dialogue: 0,0:02:30.87,0:02:33.41,Default,,0,0,0,,Có câu "Con cá sổng là con cá to" mà. Em
Dialogue: 0,0:02:33.49,0:02:36.45,Default,,0,0,0,,có nên đào sâu hơn nữa về\Nchuyện của Tanaka không?
Dialogue: 0,0:02:36.54,0:02:39.84,Default,,0,0,0,,Anh không muốn tìm hiểu thêm điều gì trong
Dialogue: 0,0:02:39.92,0:02:43.22,Default,,0,0,0,,chuyện kinh doanh của đám Arasaka. Đó là\Ncông việc mà lũ môi giới phải làm. Lão
Dialogue: 0,0:02:43.30,0:02:46.89,Default,,0,0,0,,khốn đó đã nói "Tôi trả tiền để anh\Nhoàn thành danh sách công việc của tôi".
Dialogue: 0,0:02:46.97,0:02:50.06,Default,,0,0,0,,À biết rồi. Nhưng mà nè, em tò mò sắp
Dialogue: 0,0:02:50.14,0:02:53.23,Default,,0,0,0,,chết rồi. Để em kêu Kiwi theo dõi\Nhắn coi cô ấy có tìm được gì không.
Dialogue: 0,0:02:53.89,0:02:57.31,Default,,0,0,0,,Anh sẽ không ngăn cản em đâu, bé cưng.
Dialogue: 0,0:02:57.39,0:03:00.85,Default,,0,0,0,,Trong lúc chờ đợi, anh,\Nem, cùng chơi tới bến… A.
Dialogue: 0,0:03:11.70,0:03:12.99,Default,,0,0,0,,Hừm?
Dialogue: 0,0:03:13.07,0:03:15.66,Default,,0,0,0,,Thằng nhóc trời đánh, gọi\Nkhông đúng lúc chút nào.
Dialogue: 0,0:03:16.33,0:03:19.08,Default,,0,0,0,,Ờ thì… Dạo này không\Nnghe tin gì từ ông hết nên…
Dialogue: 0,0:03:19.16,0:03:21.66,Default,,0,0,0,,Tôi đã nói là tôi sẽ\Nliên hệ lại nếu có việc.
Dialogue: 0,0:03:22.67,0:03:24.96,Default,,0,0,0,,Giờ vẫn chưa có hả? Giao\Ntôi việc gì cũng được.
Dialogue: 0,0:03:25.05,0:03:29.47,Default,,0,0,0,,Sao nghe tuyệt vọng vậy? Hết tiền rồi\Nhả lính mới? Cạn túi rồi đúng không?
Dialogue: 0,0:03:30.43,0:03:32.22,Default,,0,0,0,,Không phải vì chuyện tiền bạc đâu.
Dialogue: 0,0:03:32.30,0:03:33.30,Default,,0,0,0,,Hửm?
Dialogue: 0,0:03:33.39,0:03:36.23,Default,,0,0,0,,{\an8}Tại tôi muốn có thêm kinh nghiệm. Dù sao
Dialogue: 0,0:03:36.31,0:03:39.19,Default,,0,0,0,,cũng không thể dựa dẫm vào người\Nkhác suốt đời được. Anh nói vậy mà.
Dialogue: 0,0:03:40.64,0:03:42.02,Default,,0,0,0,,Ừm, vậy cũng được.
Dialogue: 0,0:03:43.40,0:03:44.53,Default,,0,0,0,,Tôi đang tìm người tên Aldo.
Dialogue: 0,0:03:45.23,0:03:47.69,Default,,0,0,0,,Hả? Ai tìm Aldo vậy?
Dialogue: 0,0:03:47.78,0:03:49.57,Default,,0,0,0,,Maine là người đã cử tôi đến đây.
Dialogue: 0,0:03:49.65,0:03:52.44,Default,,0,0,0,,Hả? Cậu tên là Davis phải không?
Dialogue: 0,0:03:52.53,0:03:53.91,Default,,0,0,0,,À… Phải, đúng vậy.
Dialogue: 0,0:03:53.99,0:03:54.91,Default,,0,0,0,,Hả?
Dialogue: 0,0:03:54.99,0:03:56.20,Default,,0,0,0,,Tôi là David.
Dialogue: 0,0:03:56.28,0:04:00.45,Default,,0,0,0,,- Davis hả?\N- Là David. Không phải Davis. Mà là David.
Dialogue: 0,0:04:00.54,0:04:04.29,Default,,0,0,0,,Sao cậu hét vô mặt tôi? Thô lỗ quá trời!
Dialogue: 0,0:04:04.38,0:04:08.22,Default,,0,0,0,,À… Nghe thấy rồi cậu tên là\N"David", là bồ câu đưa thư của Pilar.
Dialogue: 0,0:04:08.80,0:04:09.72,Default,,0,0,0,,Của Pilar sao?
Dialogue: 0,0:04:10.63,0:04:13.38,Default,,0,0,0,,Là cậu đúng không? Thằng nhóc mới tí
Dialogue: 0,0:04:13.47,0:04:16.64,Default,,0,0,0,,tuổi đầu mà đã ăn cắp rồi phá\Nhoại chiếc limousine của Arasaka?
Dialogue: 0,0:04:16.72,0:04:19.22,Default,,0,0,0,,Phải… Phi vụ đầu tiên của tôi.
Dialogue: 0,0:04:19.31,0:04:22.40,Default,,0,0,0,,Xém chút tôi đã có ít nhất 5.000 nếu cậu
Dialogue: 0,0:04:22.48,0:04:25.69,Default,,0,0,0,,không phá hư chiếc xe đó.\NHaiz… Tiếc muốn chết luôn á.
Dialogue: 0,0:04:25.77,0:04:27.06,Default,,0,0,0,,Lần sau tôi sẽ làm tốt hơn.
Dialogue: 0,0:04:27.15,0:04:28.15,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:28.23,0:04:29.15,Default,,0,0,0,,Chắc chắn lần sau tôi sẽ làm tốt hơn.
Dialogue: 0,0:04:30.82,0:04:36.83,Default,,0,0,0,,Lần sau á hả? Vậy thì phải coi lần trước\Ncó phải do cậu ăn may không cái đã nghe.
Dialogue: 0,0:04:36.91,0:04:38.20,Default,,0,0,0,,Ý ông là sao?
Dialogue: 0,0:04:38.29,0:04:41.08,Default,,0,0,0,,Sao trăng gì đâu, tôi chỉ muốn coi cậu
Dialogue: 0,0:04:41.16,0:04:44.00,Default,,0,0,0,,thiệt sự có tài hay chỉ\Nlà thằng nhóc khoe khoang.
Dialogue: 0,0:04:45.38,0:04:47.26,Default,,0,0,0,,Anh nghe tin về gã siêu cuồng nhân ở
Dialogue: 0,0:04:47.34,0:04:49.34,Default,,0,0,0,,Watson chưa? Dạo này\Nchúng xuất hiện nhiều lắm.
Dialogue: 0,0:04:49.42,0:04:52.67,Default,,0,0,0,,Ừ, một xe tuần tra với hai cảnh sát vì vậy
Dialogue: 0,0:04:52.76,0:04:56.01,Default,,0,0,0,,{\an8}mà đi đời. Xác của chúng nằm đó nhìn ghê\Nlắm. Chỉ bắn một phát súng thôi cũng đủ
Dialogue: 0,0:04:56.09,0:04:59.30,Default,,0,0,0,,biến chúng thành loại thịt bò\NEEZZYBEEF đóng hộp thường hay bán…
Dialogue: 0,0:05:06.35,0:05:09.27,Default,,0,0,0,,À… David à, là cậu đó hả! Cậu có ổn không?
Dialogue: 0,0:05:09.36,0:05:10.40,Default,,0,0,0,,Hả? Ờ tôi…
Dialogue: 0,0:05:10.48,0:05:12.36,Default,,0,0,0,,Cậu sao vậy? Cậu cần gì?
Dialogue: 0,0:05:12.94,0:05:16.99,Default,,0,0,0,,À… À thì… Maine kêu tôi gửi\Ngói hàng này cho Pilar đó mà.
Dialogue: 0,0:05:17.07,0:05:19.07,Default,,0,0,0,,À… Nè anh hai ra đây coi!
Dialogue: 0,0:05:19.62,0:05:20.96,Default,,0,0,0,,- Anh hai sao?\N- Hửm?
Dialogue: 0,0:05:21.04,0:05:22.79,Default,,0,0,0,,Ra coi Maine gửi cái gì cho anh kia kìa!
Dialogue: 0,0:05:22.87,0:05:29.79,Default,,0,0,0,,- Hơ.\N- Bộ chờ tôi tiễn hay gì?
Dialogue: 0,0:05:30.71,0:05:37.63,Default,,0,0,0,,Không biết cô còn việc\Ngì khác cho tôi làm không?
Dialogue: 0,0:05:39.01,0:05:40.68,Default,,0,0,0,,Haiz. Còn gì không anh?
Dialogue: 0,0:05:40.76,0:05:45.01,Default,,0,0,0,,Hả? Hết rồi, biến đi nhóc.\NRebecca, trả tiền nhớ boa đó nha!
Dialogue: 0,0:05:46.02,0:05:48.44,Default,,0,0,0,,Cậu ấy chạy việc cho anh mà!\NTự trả đi chứ, đồ keo kiệt.
Dialogue: 0,0:05:48.52,0:05:50.48,Default,,0,0,0,,Tay này chống đạn được luôn!\NQuá đỉnh quá đỉnh quá đỉnh!
Dialogue: 0,0:05:50.57,0:05:52.82,Default,,0,0,0,,Vậy tức là tôi đã xong\Nviệc rồi, có phải vậy hông?
Dialogue: 0,0:05:52.90,0:05:54.94,Default,,0,0,0,,À… Chắc là không còn gì nữa đâu.
Dialogue: 0,0:05:55.03,0:05:56.16,Default,,0,0,0,,Vậy thì tôi về đây.
Dialogue: 0,0:05:56.24,0:05:57.33,Default,,0,0,0,,Hừm.
Dialogue: 0,0:05:57.41,0:05:59.50,Default,,0,0,0,,Trời đất! Sao bo nhiều tiền vậy?
Dialogue: 0,0:06:00.87,0:06:02.75,Default,,0,0,0,,Cậu đáng yêu thật đó David à.
Dialogue: 0,0:06:02.83,0:06:03.75,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:03.83,0:06:05.25,Default,,0,0,0,,Hẹn gặp lại sau nha má lúm.
Dialogue: 0,0:06:08.63,0:06:10.05,Default,,0,0,0,,David, tối nay cậu rảnh không?
Dialogue: 0,0:06:19.43,0:06:20.35,Default,,0,0,0,,Đến rồi đó hả?
Dialogue: 0,0:06:20.93,0:06:22.93,Default,,0,0,0,,Cô đã kêu tôi đến thì tôi đến thôi.
Dialogue: 0,0:06:23.68,0:06:25.52,Default,,0,0,0,,Maine ép tôi phải làm đó.
Dialogue: 0,0:06:25.60,0:06:26.98,Default,,0,0,0,,Cái gì? Là Maine hả?
Dialogue: 0,0:06:28.56,0:06:30.02,Default,,0,0,0,,Nhưng tại sao lại là tôi chứ?
Dialogue: 0,0:06:30.11,0:06:32.28,Default,,0,0,0,,Thằng nhóc chính là một con chó hoang.
Dialogue: 0,0:06:32.36,0:06:34.57,Default,,0,0,0,,Cô là người đã đem nó về mà, nên\Ncó trách nhiệm với nó chút đi.
Dialogue: 0,0:06:35.19,0:06:37.40,Default,,0,0,0,,Anh là người giữ cậu ta lại mà.
Dialogue: 0,0:06:37.49,0:06:39.41,Default,,0,0,0,,Đừng cằn nhằn nữa. Tại nhóc đó cứ kêu ca
Dialogue: 0,0:06:39.49,0:06:41.41,Default,,0,0,0,,muốn làm việc lấy kinh nghiệm. Cô\Ncứ dắt nó đi dạo đâu đó cho tiêu
Dialogue: 0,0:06:41.49,0:06:43.41,Default,,0,0,0,,bớt sức là được rồi.
Dialogue: 0,0:06:45.37,0:06:46.25,Default,,0,0,0,,Tên khốn này.
Dialogue: 0,0:06:47.00,0:06:48.25,Default,,0,0,0,,Đúng là khốn thiệt.
Dialogue: 0,0:06:48.33,0:06:50.54,Default,,0,0,0,,Anh ta còn kêu đúng ngay vào\Nngày nghỉ của tôi nữa chứ.
Dialogue: 0,0:06:51.08,0:06:52.71,Default,,0,0,0,,Tôi rất tiếc khi nghe chuyện đó.
Dialogue: 0,0:06:53.59,0:06:56.30,Default,,0,0,0,,Không có ý gì nhưng người cậu tong teo như
Dialogue: 0,0:06:56.38,0:06:59.09,Default,,0,0,0,,vậy không hợp làm tội phạm công nghệ cao.\NTôi nghĩ đã đến lúc cậu cần phải cấy thêm
Dialogue: 0,0:06:59.18,0:07:01.93,Default,,0,0,0,,một số thiết bị cải\Nthiện cơ thể vào người rồi.
Dialogue: 0,0:07:02.47,0:07:04.47,Default,,0,0,0,,Nhìn vậy thôi chứ tôi không\Nyếu đuối như cô nghĩ đâu.
Dialogue: 0,0:07:05.27,0:07:06.19,Default,,0,0,0,,Theo sát tôi nha.
Dialogue: 0,0:07:11.19,0:07:12.32,Default,,0,0,0,,Từng dùng thử chưa?
Dialogue: 0,0:07:13.15,0:07:14.48,Default,,0,0,0,,Chưa từng.
Dialogue: 0,0:07:14.57,0:07:17.70,Default,,0,0,0,,Gloria không cho cậu mang theo súng hả?
Dialogue: 0,0:07:17.78,0:07:20.91,Default,,0,0,0,,Cậu nên bắt đầu học đi. Nếu cậu\Nmuốn, tôi sẽ dạy cho cậu vài chiêu.
Dialogue: 0,0:07:21.78,0:07:24.87,Default,,0,0,0,,Chắc là tôi chỉ dùng\NSandevistan thôi là đủ rồi.
Dialogue: 0,0:07:48.14,0:07:49.98,Default,,0,0,0,,- Nè!\N- Sao hả?
Dialogue: 0,0:07:50.52,0:07:53.27,Default,,0,0,0,,Cô chính là một\Nnetrunner thật thụ có đúng hông?
Dialogue: 0,0:07:53.35,0:07:54.60,Default,,0,0,0,,Nếu đúng như vậy thì sao?
Dialogue: 0,0:07:54.69,0:07:57.90,Default,,0,0,0,,Không có gì. Chỉ có điều là các\Nnetrunner cũng cần phải chạy hả?
Dialogue: 0,0:07:57.98,0:07:59.98,Default,,0,0,0,,Netrunner hay edgerunner cũng vậy thôi.
Dialogue: 0,0:08:00.07,0:08:02.11,Default,,0,0,0,,Rèn luyện thể lực có\Nthể giúp cậu tiến xa hơn.
Dialogue: 0,0:08:02.66,0:08:05.00,Default,,0,0,0,,KIẾP SAU
Dialogue: 0,0:08:31.64,0:08:34.56,Default,,0,0,0,,Từ bây giờ trở về sau cậu luôn phải mang
Dialogue: 0,0:08:34.65,0:08:37.57,Default,,0,0,0,,theo cây súng này bên người nhớ chưa?\NNgày nào ra đường
Dialogue: 0,0:08:37.65,0:08:40.57,Default,,0,0,0,,cậu cũng phải mang theo ví
Dialogue: 0,0:08:40.65,0:08:43.57,Default,,0,0,0,,tiền và súng của mình giống như mang bao\Nvậy. Ờ thì có một số tên khốn lắp đủ các
Dialogue: 0,0:08:43.66,0:08:46.58,Default,,0,0,0,,thứ thiết bị vào người từ đầu đến chân,\Nnhưng đối với cậu thì phải đợi một khoảng
Dialogue: 0,0:08:46.66,0:08:49.83,Default,,0,0,0,,thời gian dài nữa cậu mới có thể lắp\Nthêm những thứ đồ giống như vậy được.
Dialogue: 0,0:08:49.91,0:08:51.79,Default,,0,0,0,,Nên từ giờ đến lúc đó, cây súng này chính
Dialogue: 0,0:08:51.87,0:08:53.75,Default,,0,0,0,,là kế hoạch dự phòng rất\Nquan trọng đối với cậu.
Dialogue: 0,0:09:00.71,0:09:01.92,Default,,0,0,0,,Mà nè!
Dialogue: 0,0:09:02.01,0:09:03.01,Default,,0,0,0,,Lại gì nữa?
Dialogue: 0,0:09:03.09,0:09:04.59,Default,,0,0,0,,Bây giờ cô bao nhiêu tuổi rồi?
Dialogue: 0,0:09:30.49,0:09:31.78,Default,,0,0,0,,Chuyện với Lucy ổn không?
Dialogue: 0,0:09:32.45,0:09:33.74,Default,,0,0,0,,Ơ?
Dialogue: 0,0:09:33.83,0:09:34.75,Default,,0,0,0,,Đối xử tốt với cô ấy chứ?
Dialogue: 0,0:09:35.33,0:09:38.04,Default,,0,0,0,,À không, thực ra thì… Ý tôi là ở tuổi của
Dialogue: 0,0:09:38.13,0:09:41.05,Default,,0,0,0,,cô mà có kỹ năng cao như\Nvậy thì đúng là lạ thiệt.
Dialogue: 0,0:09:41.13,0:09:43.67,Default,,0,0,0,,Kỹ năng không liên quan gì tới tuổi tác
Dialogue: 0,0:09:43.76,0:09:46.31,Default,,0,0,0,,hết. Có năng khiếu và chăm chỉ là\Nđược. Mà chỉ có lũ ngốc mới tỏ thái độ xem
Dialogue: 0,0:09:46.38,0:09:48.97,Default,,0,0,0,,thường người khác vì tuổi tác thôi.
Dialogue: 0,0:09:49.72,0:09:50.93,Default,,0,0,0,,Lũ ngốc kiểu như…
Dialogue: 0,0:09:51.01,0:09:52.34,Default,,0,0,0,,Cái gã tai chân dài thoòng kìa.
Dialogue: 0,0:10:02.36,0:10:03.90,Default,,0,0,0,,XÂM NHẬP HOÀN TẤT
Dialogue: 0,0:10:16.83,0:10:18.79,Default,,0,0,0,,Mà ý của anh… "đối xử tốt" là sao?
Dialogue: 0,0:10:19.46,0:10:21.42,Default,,0,0,0,,Khoan đã, ý cậu là hai\Nngười chưa làm gì à?
Dialogue: 0,0:10:21.50,0:10:24.09,Default,,0,0,0,,Mà chờ chút nha, mình\Nđang nói về chuyện gì dạ?
Dialogue: 0,0:10:24.17,0:10:26.42,Default,,0,0,0,,Nhóc David, phải can đảm lên đi chứ anh
Dialogue: 0,0:10:26.51,0:10:28.76,Default,,0,0,0,,bạn khờ, không phải chỉ trong\Nviệc làm edgerunner thôi đâu,
Dialogue: 0,0:10:28.84,0:10:31.13,Default,,0,0,0,,trong cả chuyện kia nữa.
Dialogue: 0,0:10:34.56,0:10:37.65,Default,,0,0,0,,Chuyện đó là thật sao? Hôm bữa tôi thấy
Dialogue: 0,0:10:37.73,0:10:40.86,Default,,0,0,0,,hai người tán tỉnh nhau ở bữa tiệc\Nsau khi xảy ra vụ trộm xe limousine đó.
Dialogue: 0,0:10:41.40,0:10:43.78,Default,,0,0,0,,Anh ta tỏ vẻ quan tâm chăm sóc tôi rồi
Dialogue: 0,0:10:43.86,0:10:46.24,Default,,0,0,0,,sau đó giở trò sờ mó. Tôi chịu hết\Nnổi nên sốc điện cho anh ta biết mặt.
Dialogue: 0,0:10:46.32,0:10:48.70,Default,,0,0,0,,Sau vụ đó anh ta lủi nhanh lắm.
Dialogue: 0,0:10:51.49,0:10:52.37,Default,,0,0,0,,Còn cậu thì sao?
Dialogue: 0,0:10:52.45,0:10:53.33,Default,,0,0,0,,Tôi?
Dialogue: 0,0:10:53.41,0:10:55.41,Default,,0,0,0,,Cậu có nghiêm túc về\Nviệc làm edgerunner không?
Dialogue: 0,0:11:04.05,0:11:05.34,Default,,0,0,0,,Tôi không thích cô ấy theo kiểu đó.
Dialogue: 0,0:11:06.17,0:11:07.88,Default,,0,0,0,,Khỏi chối đi nhóc, ai cũng thấy hết mà.
Dialogue: 0,0:11:09.43,0:11:13.02,Default,,0,0,0,,Hoặc là… Đó không phải là điều\Nkhiến cô ấy thích ở tôi đâu.
Dialogue: 0,0:11:13.10,0:11:13.98,Default,,0,0,0,,Ừ, chắc vậy quá.
Dialogue: 0,0:11:24.52,0:11:25.65,Default,,0,0,0,,Sao hỏi vậy?
Dialogue: 0,0:11:25.73,0:11:28.82,Default,,0,0,0,,Tại vì tôi thấy cậu không\Nhợp làm edgerunner cho lắm.
Dialogue: 0,0:11:28.90,0:11:29.82,Default,,0,0,0,,Tại sao không hợp?
Dialogue: 0,0:11:30.66,0:11:31.58,Default,,0,0,0,,Nói đi!
Dialogue: 0,0:11:34.99,0:11:37.03,Default,,0,0,0,,QUÁN BAR CỦA LIZZIE
Dialogue: 0,0:11:42.67,0:11:46.13,Default,,0,0,0,,Nói thiệt là việc suốt ngày phải đoán\Ný của cô ấy khiến tôi phát ngán rồi.
Dialogue: 0,0:11:47.17,0:11:48.09,Default,,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:11:48.67,0:11:50.80,Default,,0,0,0,,Cô ấy nói là muốn lên Mặt Trăng.
Dialogue: 0,0:11:50.88,0:11:52.22,Default,,0,0,0,,Mặt Trăng hả?
Dialogue: 0,0:11:52.30,0:11:54.05,Default,,0,0,0,,Là giấc mơ hay định mệnh gì đó của cổ.
Dialogue: 0,0:12:22.08,0:12:23.67,Default,,0,0,0,,Với cái thân đó thì cậu\Nchạy nhanh hơn tôi nghĩ.
Dialogue: 0,0:12:23.75,0:12:25.67,Default,,0,0,0,,Đang mỉa mai tôi hả?
Dialogue: 0,0:12:25.75,0:12:28.21,Default,,0,0,0,,Tôi nói thiệt đó. Tôi cứ\Nnghĩ là cậu không theo kịp.
Dialogue: 0,0:12:29.09,0:12:32.47,Default,,0,0,0,,Cho nên ngay từ đầu cô đã muốn đá\Ntôi đi chứ gì. Đâu có dễ vậy được.
Dialogue: 0,0:13:11.30,0:13:13.30,Default,,0,0,0,,Trước giờ cô ấy chưa\Ntừng nhắc đến chuyện đó.
Dialogue: 0,0:13:14.22,0:13:15.55,Default,,0,0,0,,Vậy cô ấy nói dối hả ta?
Dialogue: 0,0:13:15.64,0:13:17.52,Default,,0,0,0,,Ai biết? Cứ trực tiếp hỏi cô ấy đi.
Dialogue: 0,0:13:18.14,0:13:21.06,Default,,0,0,0,,Có thể là vì lúc đó cô ấy muốn giữ chân
Dialogue: 0,0:13:21.14,0:13:24.06,Default,,0,0,0,,tôi lại, nên mới nói dối không\Nchừng. Nhưng mà trong một trải nghiệm đặc
Dialogue: 0,0:13:24.14,0:13:27.19,Default,,0,0,0,,biệt, cô ấy đã đưa tôi lên Mặt Trăng.
Dialogue: 0,0:13:27.27,0:13:30.15,Default,,0,0,0,,Hai người hẹn hò trên Mặt Trăng à? Ôi trời
Dialogue: 0,0:13:30.23,0:13:33.11,Default,,0,0,0,,ơi, ở cái thành phố này còn cái gì\Ncó thể lãng mạn hơn vậy nữa đâu.
Dialogue: 0,0:13:42.70,0:13:46.33,Default,,0,0,0,,Đây là chế độ huấn luyện cơ bản. Sau hôm
Dialogue: 0,0:13:46.42,0:13:50.05,Default,,0,0,0,,nay thì không còn ai cầm tay chỉ việc đâu.\NNếu cậu nghiêm túc muốn làm việc này, thì
Dialogue: 0,0:13:50.13,0:13:53.72,Default,,0,0,0,,cậu nhất định phải làm hết sức có thể\Nđể theo kịp bằng mọi giá. Rồi sau đó…
Dialogue: 0,0:13:54.67,0:13:55.59,Default,,0,0,0,,Sau đó thì sao?
Dialogue: 0,0:14:01.18,0:14:02.47,Default,,0,0,0,,HÀNG QUÂN ĐỘI THANH LÝ
Dialogue: 0,0:14:16.95,0:14:18.70,Default,,0,0,0,,Mà Lucy vào đội của anh bao lâu rồi?
Dialogue: 0,0:14:20.12,0:14:23.33,Default,,0,0,0,,Hình như được một năm rồi thì phải. Chính
Dialogue: 0,0:14:23.41,0:14:26.91,Default,,0,0,0,,Kiwi đã đưa cô ấy đến. Nói là mình\Nđã tìm được một thiên tài bẩm sinh.
Dialogue: 0,0:14:27.00,0:14:28.04,Default,,0,0,0,,Trước đó thì sao?
Dialogue: 0,0:14:28.12,0:14:31.08,Default,,0,0,0,,Như tôi đã nói, nếu cậu quan tâm, thì cứ
Dialogue: 0,0:14:31.17,0:14:34.13,Default,,0,0,0,,trực tiếp hỏi cô ấy đi nhóc. Cá nhân tôi\Nkhông quan tâm quá khứ của người ta, miễn
Dialogue: 0,0:14:34.21,0:14:37.13,Default,,0,0,0,,họ có thể làm tròn bổn\Nphận của mình là được.
Dialogue: 0,0:14:37.80,0:14:39.22,Default,,0,0,0,,Tôi thấy vậy cũng hay lắm.
Dialogue: 0,0:15:03.12,0:15:07.04,Default,,0,0,0,,Nè, ồn quá đi! Chết tiệt!
Dialogue: 0,0:15:10.12,0:15:11.16,Default,,0,0,0,,Hắn tè đó hả?
Dialogue: 0,0:15:12.17,0:15:13.17,Default,,0,0,0,,Ghê thiệt!
Dialogue: 0,0:15:13.25,0:15:14.25,Default,,0,0,0,,Thấy gớm!
Dialogue: 0,0:15:14.34,0:15:21.26,Default,,0,0,0,,- Kệ hắn đi, Pilar à.\N- Đúng là ông anh ngốc mà!
Dialogue: 0,0:15:25.93,0:15:28.56,Default,,0,0,0,,Tao đang nói chuyện với mày đó, bộ mày
Dialogue: 0,0:15:28.64,0:15:31.27,Default,,0,0,0,,điếc rồi hả? Nghe đây, con hẻm này là địa\Nbàn của tụi tao đó nha cái thằng khốn kia.
Dialogue: 0,0:15:31.35,0:15:33.98,Default,,0,0,0,,Tụi tao không thích giẫm phải nước tiểu\Ncủa mày đâu. Nghe rõ
Dialogue: 0,0:15:34.07,0:15:36.70,Default,,0,0,0,,chưa hả? Giờ hãy ngoan
Dialogue: 0,0:15:36.78,0:15:39.41,Default,,0,0,0,,ngoãn cút ra chỗ khác mà giải quyết nỗi\Nbuồn của mày đi. Ô
Dialogue: 0,0:15:39.49,0:15:42.12,Default,,0,0,0,,hô chết tiệt! Thứ này ghê
Dialogue: 0,0:15:42.20,0:15:44.74,Default,,0,0,0,,tởm quá! Đồ như vầy mà lắp\Nvào người chắc đau lắm hen!
Dialogue: 0,0:15:45.70,0:15:52.62,Default,,0,0,0,,Bởi vậy ta mới có câu "cứng như"… "cứng\Nnhư"… "cứng như"… "cứng như"… "cứng như"…
Dialogue: 0,0:16:06.89,0:16:13.81,Default,,0,0,0,,Đã… nói… tránh…
Dialogue: 0,0:16:19.61,0:16:21.61,Default,,0,0,0,,Xa…
Dialogue: 0,0:16:22.99,0:16:29.91,Default,,0,0,0,,Ra… thằng… chó…này…
Dialogue: 0,0:16:44.68,0:16:46.47,Default,,0,0,0,,Đừng có đứng đực ra đó nữa!
Dialogue: 0,0:16:46.55,0:16:47.55,Default,,0,0,0,,Hắn bắn nát đầu anh ta rồi!
Dialogue: 0,0:16:47.64,0:16:52.02,Default,,0,0,0,,Có mấy mẩu thịt Pilar còn dính trên…\NĐưa đây! Đồ khốn nạn! Mày không có cái
Dialogue: 0,0:16:52.10,0:16:56.52,Default,,0,0,0,,quyền đó! Cái thứ rác rưởi loạn thần chết\Ntiệt kia!
Dialogue: 0,0:16:59.36,0:17:01.86,Default,,0,0,0,,Đừng điên nữa! Trước khi cô bắn trúng\Nhắn thì hắn đã giết
Dialogue: 0,0:17:01.94,0:17:04.44,Default,,0,0,0,,chết cô rồi! Chết tiệt! -Mau thả tôi ra!
Dialogue: 0,0:17:06.12,0:17:07.46,Default,,0,0,0,,Chết đi!
Dialogue: 0,0:17:13.21,0:17:15.55,Default,,0,0,0,,Chết tiệt, đúng lúc này lại…\NKiwi, lập tức đánh ngất Rebecca đi!
Dialogue: 0,0:17:15.62,0:17:17.96,Default,,0,0,0,,Làm liền!
Dialogue: 0,0:17:22.17,0:17:23.09,Default,,0,0,0,,Lucy đâu?
Dialogue: 0,0:17:26.72,0:17:31.39,Default,,0,0,0,,Hở?
Dialogue: 0,0:17:34.89,0:17:36.35,Default,,0,0,0,,Tên khốn kia!
Dialogue: 0,0:17:38.77,0:17:39.69,Default,,0,0,0,,David à!
Dialogue: 0,0:17:57.00,0:17:57.92,Default,,0,0,0,,Lucy à!
Dialogue: 0,0:17:59.75,0:18:00.83,Default,,0,0,0,,Tôi không sao.
Dialogue: 0,0:18:01.75,0:18:06.05,Default,,0,0,0,,Vậy thì tốt quá rồi. Cô chảy máu…
Dialogue: 0,0:18:13.56,0:18:15.85,Default,,0,0,0,,Chỉ có tao, tao mới được quyền giết hắn,
Dialogue: 0,0:18:15.94,0:18:18.23,Default,,0,0,0,,chỉ có tao mới được làm\Nđiều đó thôi nghe chưa.
Dialogue: 0,0:18:22.90,0:18:23.73,Default,,0,0,0,,Đừng có đụng vào tôi.
Dialogue: 0,0:18:24.28,0:18:25.45,Default,,0,0,0,,Giờ cần thuốc hay chất kích thích?
Dialogue: 0,0:18:26.07,0:18:26.99,Default,,0,0,0,,Không cần gì hết.
Dialogue: 0,0:18:27.07,0:18:29.78,Default,,0,0,0,,Dorio, Lucy cần Ripperdoc, đưa cô ấy đến
Dialogue: 0,0:18:29.87,0:18:32.58,Default,,0,0,0,,chỗ bạn chúng ta đi. Kiwi và anh sẽ ở lại\Nđây, chờ cho đến khi cái lũ vô dụng kia
Dialogue: 0,0:18:32.66,0:18:35.37,Default,,0,0,0,,đến dọn dẹp. Dù gì thì cái mớ\Nhỗn độn này cũng cần phải có
Dialogue: 0,0:18:35.45,0:18:38.45,Default,,0,0,0,,người đứng ra giải thích.
Dialogue: 0,0:18:38.54,0:18:39.50,Default,,0,0,0,,Sếp lớn lên tiếng rồi.
Dialogue: 0,0:18:41.63,0:18:44.26,Default,,0,0,0,,David à, cậu cũng đi với họ luôn đi.
Dialogue: 0,0:18:44.34,0:18:45.30,Default,,0,0,0,,Ơ?
Dialogue: 0,0:18:45.38,0:18:47.09,Default,,0,0,0,,Mình sẽ nói đã hạ hắn sau khi hắn giết
Dialogue: 0,0:18:47.17,0:18:49.17,Default,,0,0,0,,Pilar. Dù sao thì tên khốn đó cũng được\Ntrang bị đến tận
Dialogue: 0,0:18:49.26,0:18:51.26,Default,,0,0,0,,răng. Họ sẽ lập hồ sơ là sự cố
Dialogue: 0,0:18:51.35,0:18:53.64,Default,,0,0,0,,siêu cuồng nhân, cũng\Nkhông hỏi gì nhiều đâu.
Dialogue: 0,0:18:53.72,0:18:54.93,Default,,0,0,0,,Nhưng mà…
Dialogue: 0,0:18:55.02,0:18:58.61,Default,,0,0,0,,Tôi đã thấy những gì cậu làm rồi. Đã đến\Nlúc cậu thôi suy nghĩ như lính mới đi.
Dialogue: 0,0:19:01.27,0:19:05.36,Default,,0,0,0,,Lại là mấy người hả? Biết tôi hành\Nnghề không có giấy phép mà tới hoài.
Dialogue: 0,0:19:05.44,0:19:08.40,Default,,0,0,0,,Bởi vậy mới nói. Tôi cũng không\Ntình nguyện đến đây một chút nào đâu.
Dialogue: 0,0:19:08.49,0:19:10.49,Default,,0,0,0,,Tôi biết rồi, tôi biết rồi.
Dialogue: 0,0:19:10.57,0:19:11.40,Default,,0,0,0,,Cứ để tôi một mình.
Dialogue: 0,0:19:12.66,0:19:15.16,Default,,0,0,0,,Vậy thì cậu chờ đi, khi\Nnào xong thì đưa cô ấy về.
Dialogue: 0,0:19:15.24,0:19:17.99,Default,,0,0,0,,- Ơ, cô đi hả?\N- Maine nói cậu có thể dùng xe của anh ấy.
Dialogue: 0,0:19:25.09,0:19:26.76,Default,,0,0,0,,Ồ, Lucy à.
Dialogue: 0,0:19:37.43,0:19:38.68,Default,,0,0,0,,Đến đây được rồi.
Dialogue: 0,0:19:38.77,0:19:40.61,Default,,0,0,0,,- Ờ.\N- Ngủ ngon.
Dialogue: 0,0:19:40.69,0:19:45.24,Default,,0,0,0,,À… Nè, mình nói chuyện chút được không dạ?
Dialogue: 0,0:19:50.11,0:19:51.03,Default,,0,0,0,,Lối này.
Dialogue: 0,0:19:55.58,0:19:57.92,Default,,0,0,0,,A… Hôm nay nhiều mây quá.
Dialogue: 0,0:19:58.00,0:20:01.71,Default,,0,0,0,,Trải nghiệm Mặt Trăng ta từng thử\Nvới nhau lần trước á, khá là vui ha.
Dialogue: 0,0:20:07.76,0:20:09.76,Default,,0,0,0,,Thật ra tôi cũng có\Nchuyện muốn nói với cậu.
Dialogue: 0,0:20:10.51,0:20:11.47,Default,,0,0,0,,Hả?
Dialogue: 0,0:20:11.55,0:20:13.89,Default,,0,0,0,,Tôi biết là cậu nghĩ tôi lừa cậu, nhưng
Dialogue: 0,0:20:13.97,0:20:16.31,Default,,0,0,0,,hôm đó tôi không có nói dối. Đó cũng là\Nlần đầu tiên tôi kể chuyện đó cho người
Dialogue: 0,0:20:16.39,0:20:18.68,Default,,0,0,0,,khác.
Dialogue: 0,0:20:19.77,0:20:22.11,Default,,0,0,0,,Tốt quá rồi. So với việc phải nghĩ là cô
Dialogue: 0,0:20:22.19,0:20:24.57,Default,,0,0,0,,lừa tôi, tôi thích việc\Ncô không nói dối tôi hơn.
Dialogue: 0,0:20:25.48,0:20:27.11,Default,,0,0,0,,Vậy nếu giờ tôi đang nói dối thì sao?
Dialogue: 0,0:20:27.19,0:20:28.69,Default,,0,0,0,,Tôi thật sự không nghĩ như vậy.
Dialogue: 0,0:20:28.78,0:20:30.03,Default,,0,0,0,,Sao lại không?
Dialogue: 0,0:20:30.11,0:20:31.07,Default,,0,0,0,,Vì không thích nghĩ vậy thôi.
Dialogue: 0,0:20:31.15,0:20:32.19,Default,,0,0,0,,Đúng là điên thiệt.
Dialogue: 0,0:20:32.28,0:20:34.99,Default,,0,0,0,,Lẽ ra ngay từ lúc đó, cô\Nnên nói cho tôi biết luôn.
Dialogue: 0,0:20:35.07,0:20:35.99,Default,,0,0,0,,Sao mà nói được?
Dialogue: 0,0:20:36.58,0:20:37.79,Default,,0,0,0,,Tại sao lại không?
Dialogue: 0,0:20:37.87,0:20:40.12,Default,,0,0,0,,Bởi vì lúc đó cậu đã rất giận tôi mà.
Dialogue: 0,0:20:40.20,0:20:41.28,Default,,0,0,0,,Tôi đâu có giận cô.
Dialogue: 0,0:20:41.37,0:20:42.96,Default,,0,0,0,,Rõ ràng là cậu giận.
Dialogue: 0,0:20:43.04,0:20:47.46,Default,,0,0,0,,Tôi đã cố không tức giận chỉ là… Mà\Nđúng là tôi cũng có hơi giận thiệt.
Dialogue: 0,0:20:47.54,0:20:48.58,Default,,0,0,0,,Thừa nhận rồi thấy chưa?
Dialogue: 0,0:20:48.67,0:20:52.63,Default,,0,0,0,,Đúng là tôi cũng có hơi giận cô một chút,
Dialogue: 0,0:20:52.72,0:20:56.93,Default,,0,0,0,,nhưng mà tôi không có ghét cô đâu. Nên\Ntôi mới xông tới chỗ tên cuồng nhân đó.
Dialogue: 0,0:20:57.01,0:20:57.89,Default,,0,0,0,,Nói dối.
Dialogue: 0,0:20:57.97,0:20:58.97,Default,,0,0,0,,Tôi nói thiệt mà.
Dialogue: 0,0:20:59.06,0:21:01.90,Default,,0,0,0,,Cậu nói dối! Người như cậu sẽ bất chấp tất
Dialogue: 0,0:21:01.98,0:21:05.11,Default,,0,0,0,,cả, nhảy vào lửa để cứu một ai\Nđó dù bản thân sẽ mất mạng. Là
Dialogue: 0,0:21:05.19,0:21:08.28,Default,,0,0,0,,kiểu người như vậy đó.
Dialogue: 0,0:21:09.82,0:21:13.95,Default,,0,0,0,,Nên cô nói tôi không hợp làm lính đánh\Nthuê chứ gì? Maine cũng nghĩ là tôi có tư
Dialogue: 0,0:21:14.03,0:21:18.16,Default,,0,0,0,,chất. Tại sao cô lại không?
Dialogue: 0,0:21:18.24,0:21:22.79,Default,,0,0,0,,Không phải vậy. Chắc chắn cậu sẽ là một\Nedgerunner giỏi mà. Thực sự là vậy rồi.
Dialogue: 0,0:21:22.87,0:21:24.08,Default,,0,0,0,,Vậy vấn đề là gì?
Dialogue: 0,0:21:24.16,0:21:27.16,Default,,0,0,0,,Một tội phạm công nghệ cao không thể tạo
Dialogue: 0,0:21:27.25,0:21:30.25,Default,,0,0,0,,dựng tên tuổi bằng cách họ\Nsống, mà là bằng cách họ chết.
Dialogue: 0,0:21:32.97,0:21:34.64,Default,,0,0,0,,Cậu không đáng phải chịu như vậy.
Dialogue: 0,0:21:35.18,0:21:38.35,Default,,0,0,0,,Cô thì sao? Rốt cuộc\Nthì tôi khác gì cô chứ?
Dialogue: 0,0:21:38.43,0:21:41.02,Default,,0,0,0,,Chúng ta khác nhau. Tôi\Nkhông còn nơi nào để đi nữa.
Dialogue: 0,0:21:41.10,0:21:42.64,Default,,0,0,0,,Làm như là tôi có vậy đó.
Dialogue: 0,0:21:42.73,0:21:44.27,Default,,0,0,0,,Cậu và tôi là hai thế giới khác nhau.
Dialogue: 0,0:21:44.35,0:21:45.27,Default,,0,0,0,,Khác chỗ nào chứ?
Dialogue: 0,0:21:49.27,0:21:54.28,Default,,0,0,0,,Một ngày nào đó, tôi nhất định sẽ đưa\Ncô lên Mặt Trăng! Tôi hứa với cô đó!
Dialogue: 0,0:22:04.66,0:22:06.00,Default,,0,0,0,,Tôi chỉ không muốn cậu chết.
Dialogue: 0,0:22:24.93,0:22:25.93,Default,,0,0,0,,Tôi không chết đâu.
