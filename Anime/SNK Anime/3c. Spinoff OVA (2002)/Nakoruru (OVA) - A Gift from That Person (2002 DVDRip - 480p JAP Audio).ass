Dialogue: 0,0:02:00.00,0:02:02.00,Italic,Nakoruru,0,0,0,,{\i1}Ngươi là ai...{\i0}
Dialogue: 0,0:02:30.00,0:02:32.00,Default,Manari,0,0,0,,Nakoruru!
Dialogue: 0,0:02:32.00,0:02:34.00,Default,Manari,0,0,0,,Nakoruru! Tỉnh lại đi!
Dialogue: 0,0:02:34.00,0:02:35.00,Default,Nakoruru,0,0,0,,Manari...
Dialogue: 0,0:02:36.00,0:02:37.00,Default,Nakoruru,0,0,0,,Yantamu...
Dialogue: 0,0:02:38.00,0:02:39.00,Default,Yantamu,0,0,0,,Nakoruru!
Dialogue: 0,0:02:40.00,0:02:41.00,Default,Yantamu,0,0,0,,Sao thế hả, Nakoruru!
Dialogue: 0,0:02:42.00,0:02:43.00,Default,Yantamu,0,0,0,,Mau tỉnh lại đi chứ!
Dialogue: 0,0:02:43.00,0:02:44.00,Default,Yantamu,0,0,0,,Nakoruru!
Dialogue: 0,0:02:44.00,0:02:45.00,Default,Manari,0,0,0,,Nakoruru, nghe mình nói không!
Dialogue: 0,0:02:49.00,0:02:51.00,Default,Manari,0,0,0,,Cậu đã tỉnh rồi sao! Nakoruru!
Dialogue: 0,0:02:52.00,0:02:53.00,Default,Nakoruru,0,0,0,,Manari...
Dialogue: 0,0:02:54.00,0:02:55.00,Default,Manari,0,0,0,,May quá rồi...
Dialogue: 0,0:02:56.00,0:02:57.00,Default,Yantamu,0,0,0,,Nakoruru!
Dialogue: 0,0:02:58.00,0:02:59.00,Default,Yantamu,0,0,0,,Cậu tỉnh là mừng rồi.
Dialogue: 0,0:02:59.70,0:03:00.70,Default,Yantamu,0,0,0,,Nakoruru này...
Dialogue: 0,0:03:02.34,0:03:03.34,Default,Yantamu,0,0,0,,Chào mừng cậu trở về nhé.
Dialogue: 0,0:03:04.70,0:03:05.70,Default,Nakoruru,0,0,0,,Yantamu...
Dialogue: 0,0:03:10.34,0:03:11.34,Default,Nakoruru,0,0,0,,Mình đã về rồi đây.
Dialogue: 0,0:03:58.00,0:04:05.00,Default,Bà lão,0,0,0,,Ác ma đó ban đầu xuất hiện tại ngọn núi Osorezan u linh.
Dialogue: 0,0:04:05.00,0:04:14.00,Default,Bà lão,0,0,0,,Hơn một ngàn năm trước, người ta đồn rằng nó là hóa thân\Ntừ oán hận của một hài nhi bị vứt bỏ, dẫu chẳng ai biết chắc thực hư.
Dialogue: 0,0:04:14.00,0:04:17.00,Default,Bà lão,0,0,0,,Chính tại nơi ngọn núi Osorezan u ám ấy...
Dialogue: 0,0:04:17.00,0:04:19.00,Default,Bà lão,0,0,0,,Từ hơn một ngàn năm về trước...
Dialogue: 0,0:04:19.00,0:04:21.00,Default,Bà lão,0,0,0,,Oán niệm của một đứa trẻ sơ sinh bị ruồng bỏ...
Dialogue: 0,0:04:21.00,0:04:24.00,Default,Bà lão,0,0,0,,Được xem như hóa thân của sự căm thù ngút trời...
Dialogue: 0,0:04:24.00,0:04:26.00,Default,Bà lão,0,0,0,,Tuy không một ai có thể chứng thực.
Dialogue: 0,0:04:26.00,0:04:29.00,Default,Bà lão,0,0,0,,Thoạt đầu, nó chỉ là một đốm tà khí nhỏ nhoi...
Dialogue: 0,0:04:29.00,0:04:33.00,Default,Bà lão,0,0,0,,Thế nhưng khi đã mượn được thân xác của một nữ đồng cốt...
Dialogue: 0,0:04:33.00,0:04:36.00,Default,Bà lão,0,0,0,,Nó liền liên tục nuốt chửng các loài ma vật...
Dialogue: 0,0:04:36.00,0:04:39.00,Default,Bà lão,0,0,0,,Để không ngừng tích tụ tà lực hùng mạnh.
Dialogue: 0,0:04:39.00,0:04:43.00,Default,Bà lão,0,0,0,,Và rồi cuối cùng, nó bắt đầu...
Dialogue: 0,0:04:44.00,0:04:48.00,Default,Bà lão,0,0,0,,Gặm nhấm và nuốt chửng cả thế giới này!
Dialogue: 0,0:04:55.00,0:04:58.00,Default,Yantamu,0,0,0,,Này này các bà ơi, lại kể câu chuyện đó nữa à?
Dialogue: 0,0:04:58.00,0:05:00.00,Default,Bọn trẻ,0,0,0,,A, anh Yantamu kìa!
Dialogue: 0,0:05:00.00,0:05:04.00,Default,Yantamu,0,0,0,,Mấy bà cứ đem chuyện cổ tích xưa như trái đất ra làm quá lên thế...
Dialogue: 0,0:05:04.00,0:05:07.00,Default,Yantamu,0,0,0,,Bọn trẻ con sợ phát khóc tội nghiệp ra kia kìa!
Dialogue: 0,0:05:07.00,0:05:09.00,Default,Yantamu,0,0,0,,Đừng có dọa dẫm con nít như thế chứ!
Dialogue: 0,0:05:09.00,0:05:10.00,Default,Bà lão,0,0,0,,Đồ hỗn xược!
Dialogue: 0,0:05:10.00,0:05:16.00,Default,Bà lão,0,0,0,,Đây là truyền thuyết vô cùng linh thiêng\Nđược lưu truyền ngàn đời ở Kamui Kotan này đấy!
Dialogue: 0,0:05:16.00,0:05:19.00,Default,Bà lão,0,0,0,,Mày lúc nào cũng thích trêu chọc người lớn cả!
Dialogue: 0,0:05:20.00,0:05:24.00,Default,Yantamu,0,0,0,,Với cháu thì chuyện trước mắt quan trọng hơn mấy truyền thuyết cổ xưa nhiều.
Dialogue: 0,0:05:24.00,0:05:26.00,Default,Bọn trẻ,0,0,0,,Anh Yantamu đi thăm chị Nakoruru phải không?
Dialogue: 0,0:05:26.00,0:05:28.00,Default,Bọn trẻ,0,0,0,,Em đi với!
Dialogue: 0,0:05:28.00,0:05:29.00,Default,Bọn trẻ,0,0,0,,Em cũng muốn đi!
Dialogue: 0,0:05:29.00,0:05:31.00,Default,Bọn trẻ,0,0,0,,Cho cả em đi nữa nha!
Dialogue: 0,0:05:32.00,0:05:35.00,Default,Yantamu,0,0,0,,Thế nên cháu đi trước đây, chào các bà nhé!
Dialogue: 0,0:05:37.00,0:05:43.00,Default,Bà lão,0,0,0,,Thiệt tình, cái thằng nhãi nghịch ngợm...\NGiá như ta trẻ lại vài chục tuổi thì khéo...
Dialogue: 0,0:05:43.00,0:05:44.00,Default,Bọn trẻ,0,0,0,,Thì sao cơ ạ bà?
Dialogue: 0,0:05:45.00,0:05:48.00,Default,Rimururu,0,0,0,,Nào, cởi áo ruunpe ra đi tỉ, Nakoruru.
Dialogue: 0,0:06:05.00,0:06:06.00,Default,Rimururu,0,0,0,,Khủng khiếp quá...
Dialogue: 0,0:06:06.60,0:06:07.60,Default,Rimururu,0,0,0,,Tỉ tỉ...
Dialogue: 0,0:06:17.80,0:06:21.30,Default,Bọn trẻ,0,0,0,,Này, không biết vết thương của chị Nakoruru thế nào rồi nhỉ?
Dialogue: 0,0:06:21.30,0:06:23.40,Default,Yantamu,0,0,0,,Đã hồi phục được nhiều rồi...
Dialogue: 0,0:06:23.40,0:06:25.60,Default,Yantamu,0,0,0,,Chắc khoảng hôm nay là có thể ra ngoài được rồi đấy.
Dialogue: 0,0:06:32.90,0:06:34.70,Default,Rimururu,0,0,0,,Em xin lỗi, làm tỉ đau lắm phải không?
Dialogue: 0,0:06:35.00,0:06:38.00,Default,Rimururu,0,0,0,,Cứ để em băng bó lại cho tỉ nhé.
Dialogue: 0,0:06:40.00,0:06:42.00,Default,Yantamu,0,0,0,,Nakoruru, cậu thấy sao rồi?
Dialogue: 0,0:06:46.00,0:06:48.00,Default,Yantamu,0,0,0,,Bọn trẻ trong làng muốn vào thăm cậu đấy.
Dialogue: 0,0:06:50.00,0:06:52.00,Default,Yantamu,0,0,0,,Nào nào, đứng lại coi!
Dialogue: 0,0:06:52.00,0:06:53.00,Default,Rimururu,0,0,0,,Mika, không được!
Dialogue: 0,0:06:53.00,0:06:56.00,Default,Yantamu,0,0,0,,Kìa, giữ con Mika lại mau lên!
Dialogue: 0,0:06:58.00,0:07:00.00,Default,Rimururu,0,0,0,,Yantamu!
Dialogue: 0,0:07:00.00,0:07:01.00,Default,Yantamu,0,0,0,,Rimururu!
Dialogue: 0,0:07:04.00,0:07:05.00,Default,Rimururu,0,0,0,,Khoan đã nào!
Dialogue: 0,0:07:05.00,0:07:06.00,Default,Yantamu,0,0,0,,Có chuyện gì thế!
Dialogue: 0,0:07:07.00,0:07:08.00,Default,Bọn trẻ,0,0,0,,Sao vậy anh!
Dialogue: 0,0:07:08.00,0:07:09.00,Default,Bọn trẻ,0,0,0,,Cái gì thế!
Dialogue: 0,0:07:13.00,0:07:15.00,Default,Rimururu,0,0,0,,Anh không sao chứ, Yantamu?
Dialogue: 0,0:07:17.00,0:07:19.00,Default,Yantamu,0,0,0,,Bị nó quần cho một phen tơi tả thật đấy.
Dialogue: 0,0:07:20.00,0:07:22.00,Default,Manari,0,0,0,,Nhưng mà may quá rồi nhỉ!
Dialogue: 0,0:07:22.00,0:07:24.00,Default,Manari,0,0,0,,Vết thương của Nakoruru sắp lành hẳn rồi này.
Dialogue: 0,0:07:24.00,0:07:26.00,Default,Rimururu,0,0,0,,Vẫn còn cần thêm chút thời gian nữa đấy ạ.
Dialogue: 0,0:07:26.00,0:07:29.00,Default,Rimururu,0,0,0,,Lúc mới đầu thấy vết thương, em cứ hoảng chẳng biết phải làm sao...
Dialogue: 0,0:07:29.00,0:07:32.00,Default,Rimururu,0,0,0,,Nhưng lành được tới mức này là an tâm rồi.
Dialogue: 0,0:07:34.00,0:07:36.00,Default,Bọn trẻ,0,0,0,,Ái da, đau quá!
Dialogue: 0,0:07:36.00,0:07:38.00,Default,Manari,0,0,0,,Không sao chứ em? Bị làm sao thế?
Dialogue: 0,0:07:43.00,0:07:46.00,Default,Manari,0,0,0,,Không được đâu, phải bôi thuốc cẩn thận vào chứ.
Dialogue: 0,0:07:46.00,0:07:47.00,Default,Bọn trẻ,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:07:49.00,0:07:52.00,Default,Rimururu,0,0,0,,Trước đây tỉ ấy đâu bao giờ bị thương nặng đến mức này...
Dialogue: 0,0:08:04.00,0:08:06.00,Italic,Rera,0,0,0,,{\i1}Nào...{\i0}
Dialogue: 0,0:08:14.00,0:08:16.00,Italic,Rera,0,0,0,,{\i1}Lại đây...{\i0}
Dialogue: 0,0:08:24.00,0:08:26.00,Italic,Rera,0,0,0,,{\i1}Nếu ngươi muốn được sống sót...{\i0}
Dialogue: 0,0:08:27.00,0:08:29.00,Italic,Rera,0,0,0,,{\i1}Thì hãy giết chết đứa bé đó đi.{\i0}
Dialogue: 0,0:08:34.00,0:08:36.00,Italic,Rera,0,0,0,,{\i1}Nhanh lên...{\i0}
Dialogue: 0,0:08:38.00,0:08:40.00,Italic,Rera,0,0,0,,{\i1}Nếu ngươi không ra tay giết nó...{\i0}
Dialogue: 0,0:08:40.00,0:08:43.00,Italic,Rera,0,0,0,,{\i1}Thì chính ngươi sẽ là kẻ bị giết chết đấy!{\i0}
Dialogue: 0,0:08:46.00,0:08:48.00,Italic,Rera,0,0,0,,{\i1}Xuống tay đi!{\i0}
Dialogue: 0,0:08:59.00,0:09:01.00,Default,Nakoruru,0,0,0,,Đừng... Đừng đến gần ta!
Dialogue: 0,0:09:01.00,0:09:02.00,Default,Rimururu,0,0,0,,Tỉ tỉ!
Dialogue: 0,0:09:03.00,0:09:05.00,Default,Nakoruru,0,0,0,,Dừng lại đi!
Dialogue: 0,0:09:08.36,0:09:09.36,Default,Nakoruru,0,0,0,,Áaaaa!
Dialogue: 0,0:09:30.24,0:09:32.24,Default,Rimururu,0,0,0,,Tỉ tỉ đã hoàn toàn thay đổi rồi...
Dialogue: 0,0:09:33.00,0:09:37.00,Default,Rimururu,0,0,0,,Rốt cuộc đã có chuyện gì xảy ra trong suốt chuyến hành trình đó vậy?
Dialogue: 0,0:09:55.00,0:09:59.00,Italic,Rera,0,0,0,,{\i1}Nakoruru, tại sao ngươi lại từ chối chiến đấu?{\i0}
Dialogue: 0,0:10:03.00,0:10:05.00,Default,Nakoruru,0,0,0,,Chào buổi sáng mọi người.
Dialogue: 0,0:10:33.00,0:10:35.50,Default,Bọn trẻ,0,0,0,,Chị Nakoruru ơi, ngoài kia có nhiều điều mới lạ lắm hả chị?
Dialogue: 0,0:10:35.90,0:10:38.60,Default,Nakoruru,0,0,0,,Xin lỗi các em nhé, lúc này chị không muốn nói về chuyện đó...
Dialogue: 0,0:10:38.80,0:10:39.90,Default,Hokute,0,0,0,,Gì chứ, đồ keo kiệt!
Dialogue: 0,0:10:41.00,0:10:43.30,Default,Hokute,0,0,0,,Chị Nakoruru đáng lẽ đừng thèm quay về thì hơn!
Dialogue: 0,0:10:44.60,0:10:45.60,Default,Nakoruru,0,0,0,,Sao em lại...
Dialogue: 0,0:10:45.70,0:10:48.20,Default,Bọn trẻ,0,0,0,,Này Hokute! Mày vừa ăn nói kiểu gì đấy hả!
Dialogue: 0,0:10:49.00,0:10:49.80,Default,Hokute,0,0,0,,Hả?
Dialogue: 0,0:10:50.30,0:10:52.30,Default,Hokute,0,0,0,,Mình vừa nói cái quái gì thế này?
Dialogue: 0,0:10:52.40,0:10:53.80,Default,Bọn trẻ,0,0,0,,Mau xin lỗi chị ấy đi Hokute!
Dialogue: 0,0:10:53.90,0:10:55.30,Default,Nakoruru,0,0,0,,Mọi người, xin đừng cãi nhau mà!
Dialogue: 0,0:10:56.10,0:10:56.80,Default,Bọn trẻ,0,0,0,,Chị Nakoruru!
Dialogue: 0,0:10:57.70,0:10:58.90,Default,Dân làng,0,0,0,,Trưởng lão đang cho gọi cháu đấy!
Dialogue: 0,0:11:01.80,0:11:05.04,Default,Yantamu,0,0,0,,Chắc chắn lại định bắt cậu bói thời tiết nữa chứ gì.
Dialogue: 0,0:11:06.68,0:11:07.50,Default,Manari,0,0,0,,Nakoruru?
Dialogue: 0,0:11:08.50,0:11:09.38,Default,Manari,0,0,0,,Cậu sao thế?
Dialogue: 0,0:11:09.60,0:11:11.10,Default,Manari,0,0,0,,Trông cậu chẳng có chút sức sống nào cả.
Dialogue: 0,0:11:11.80,0:11:13.10,Default,Manari,0,0,0,,Vết thương vẫn còn đau lắm sao?
Dialogue: 0,0:11:13.30,0:11:14.50,Default,Nakoruru,0,0,0,,Cảm ơn cậu nhé, Manari.
Dialogue: 0,0:11:14.90,0:11:16.40,Default,Nakoruru,0,0,0,,Nhưng mình không sao đâu.
Dialogue: 0,0:11:17.10,0:11:19.30,Default,Yantamu,0,0,0,,Sắc mặt cậu thế kia mà bảo không sao à, Nakoruru!
Dialogue: 0,0:11:20.90,0:11:22.00,Default,Yantamu,0,0,0,,Nếu cảm thấy không khỏe trong người...
Dialogue: 0,0:11:22.20,0:11:24.60,Default,Yantamu,0,0,0,,Cậu không việc gì phải gượng ép đến chỗ lão trưởng làng cả!
Dialogue: 0,0:11:25.80,0:11:26.40,Default,Nakoruru,0,0,0,,Nhưng mà...
Dialogue: 0,0:11:27.10,0:11:28.00,Default,Nakoruru,0,0,0,,Mình ổn thật mà.
Dialogue: 0,0:11:31.80,0:11:35.80,Default,Rimururu,0,0,0,,Haizz...
Dialogue: 0,0:11:35.80,0:11:37.80,Default,Rimururu,0,0,0,,Tỉ tỉ rốt cuộc bị làm sao vậy chứ...
Dialogue: 0,0:11:37.80,0:11:39.80,Default,Rimururu,0,0,0,,Rốt cuộc điều gì đã thay đổi ở tỉ ấy?
Dialogue: 0,0:11:39.80,0:11:41.80,Default,Rimururu,0,0,0,,Trước đây tỉ tỉ lúc nào cũng vui tươi, rạng rỡ...
Dialogue: 0,0:11:41.80,0:11:43.80,Default,Rimururu,0,0,0,,Vậy mà từ ngày trở về sau cuộc chiến tàn khốc đó...
Dialogue: 0,0:11:43.80,0:11:45.80,Default,Rimururu,0,0,0,,Tỉ ấy thậm chí chẳng hề chạm vào thanh bảo đao Chichiushi...
Dialogue: 0,0:11:45.80,0:11:47.80,Default,Rimururu,0,0,0,,Ơ kìa?
Dialogue: 0,0:11:47.80,0:11:49.80,Default,Rimururu,0,0,0,,Tỉ tỉ đã về phòng rồi sao?
Dialogue: 0,0:11:49.80,0:11:51.80,Default,Rimururu,0,0,0,,Tỉ tỉ...
Dialogue: 0,0:11:51.80,0:11:54.80,Default,Rimururu,0,0,0,,Rõ ràng từ lúc trở về chưa từng đụng tới thanh Chichiushi...
Dialogue: 0,0:11:58.80,0:12:00.80,Default,Rimururu,0,0,0,,Ủa? Tỉ tỉ quay lại đây lúc nào thế?
Dialogue: 0,0:12:00.80,0:12:02.80,Default,Rimururu,0,0,0,,Tỉ tỉ?
Dialogue: 0,0:12:03.80,0:12:04.80,Default,Rimururu,0,0,0,,Á!
Dialogue: 0,0:12:05.80,0:12:07.80,Default,Rimururu,0,0,0,,Không xong rồi! Lẽ nào...!
Dialogue: 0,0:12:10.80,0:12:12.80,Default,Trưởng làng,0,0,0,,Nakoruru vẫn chưa chịu đến sao?
Dialogue: 0,0:12:15.80,0:12:17.80,Default,Thợ săn,0,0,0,,Kìa, Yantamu!
Dialogue: 0,0:12:17.80,0:12:20.80,Default,Trưởng làng,0,0,0,,Nakoruru không cùng đến với cậu à?
Dialogue: 0,0:12:21.80,0:12:25.24,Default,Yantamu,0,0,0,,Vết thương của cô ấy vẫn còn đau.\NTốt nhất các người hãy để cô ấy nghỉ ngơi!
Dialogue: 0,0:12:27.68,0:12:30.08,Default,Thợ săn,0,0,0,,Thế thì biết khi nào mới có thể bắt đầu chuyến đi săn được đây?
Dialogue: 0,0:12:31.58,0:12:33.88,Default,Thợ săn,0,0,0,,Không có người bói thời tiết thì làm sao mà săn bắn!
Dialogue: 0,0:12:36.58,0:12:40.38,Default,Yantamu,0,0,0,,Đường đường là cả một đám đàn ông to xác mà lúc nào\Ncũng chỉ biết dựa dẫm vào một cô gái đang bị thương...
Dialogue: 0,0:12:40.38,0:12:41.38,Default,Yantamu,0,0,0,,Thật chẳng biết xấu hổ là gì!
Dialogue: 0,0:12:41.98,0:12:42.98,Default,Trưởng làng,0,0,0,,Yantamu!
Dialogue: 0,0:12:44.82,0:12:47.20,Default,Dân làng,0,0,0,,Dạo này chuyện giữa cậu và Manari thế nào rồi?
Dialogue: 0,0:12:48.62,0:12:51.20,Default,Yantamu,0,0,0,,À, cô ấy là bạn thuở nhỏ vô cùng quan trọng của tôi.
Dialogue: 0,0:12:51.70,0:12:58.70,Default,Dân làng,0,0,0,,Cái thằng nhóc này thật là... Lúc nào nó cũng thế cả.
Dialogue: 0,0:13:02.70,0:13:09.70,Default,Bà lão,0,0,0,,Lại làm loạn lên rồi hả Yantamu? Dám chống đối\Ntrưởng lão trong cái làng này thì chỉ có chịu thiệt thôi đấy.
Dialogue: 0,0:13:09.70,0:13:14.70,Default,Yantamu,0,0,0,,Cháu tuyệt đối không tin tưởng cái lũ người lớn\Nsuốt ngày chỉ biết phụ thuộc vào phụ nữ đâu!
Dialogue: 0,0:13:14.70,0:13:20.70,Default,Bà lão,0,0,0,,Đúng là tính khí ngang bướng của Yantamu.\NNhưng mà dạo này trưởng lão cũng cứng nhắc, khắt khe thật đấy nhỉ.
Dialogue: 0,0:13:20.70,0:13:27.70,Default,Bà lão,0,0,0,,Phải đấy, hồi còn trẻ ông ấy là một trang nam tử rất dịu dàng,\Nluôn yêu thương, ân cần với phụ nữ và trẻ con...
Dialogue: 0,0:13:36.70,0:13:38.70,Default,Manari,0,0,0,,Gió thổi mát rượi thật đấy...
Dialogue: 0,0:13:38.70,0:13:42.70,Default,Manari,0,0,0,,Ngày xưa ba đứa mình và Yantamu thường hay cùng nhau lên đây chơi nhỉ.
Dialogue: 0,0:13:44.70,0:13:46.70,Default,Yantamu (Hồi tưởng),0,0,0,,Chậm chạp quá đấy, Manari ơi!
Dialogue: 0,0:13:47.70,0:13:49.70,Default,Manari (Hồi tưởng),0,0,0,,Đ... Đợi tớ với nào!
Dialogue: 0,0:13:50.70,0:13:54.30,Default,Nakoruru (Hồi tưởng),0,0,0,,Thích quá đi mất!
Dialogue: 0,0:13:54.30,0:13:57.00,Default,Yantamu (Hồi tưởng),0,0,0,,Chỗ tớ đứng còn lộng gió và tuyệt hơn nhiều!
Dialogue: 0,0:13:57.00,0:14:00.70,Default,Nakoruru,0,0,0,,Hi hi hi...
Dialogue: 0,0:14:08.70,0:14:10.70,Default,Nakoruru,0,0,0,,Nhìn cậu có vẻ lâu lắm rồi mới quay lại ngọn đồi này...
Dialogue: 0,0:14:10.70,0:14:12.70,Default,Nakoruru,0,0,0,,Hai người chưa từng cùng nhau lên đây sao?
Dialogue: 0,0:14:12.70,0:14:13.70,Default,Manari,0,0,0,,Ừm...
Dialogue: 0,0:14:13.70,0:14:15.70,Default,Manari,0,0,0,,Kể từ ngày Nakoruru lên đường đi xa...
Dialogue: 0,0:14:15.70,0:14:19.70,Default,Manari,0,0,0,,Yantamu chẳng còn mấy khi rủ tớ đi chơi riêng nữa.
Dialogue: 0,0:14:19.70,0:14:20.70,Default,Nakoruru,0,0,0,,Vậy sao...
Dialogue: 0,0:14:26.70,0:14:28.70,Default,Nakoruru,0,0,0,,Này Manari, hát cho mình nghe một bài đi.
Dialogue: 0,0:14:28.70,0:14:30.70,Default,Manari,0,0,0,,Hả? Nhưng mà tớ...
Dialogue: 0,0:14:30.70,0:14:33.70,Default,Nakoruru,0,0,0,,Hồi còn nhỏ cậu thường hay hát cho mình nghe mà.
Dialogue: 0,0:14:33.70,0:14:36.70,Default,Nakoruru,0,0,0,,Đi mà, ngày trước mình thích nghe cậu hát lắm đấy.
Dialogue: 0,0:14:36.70,0:14:38.70,Default,Manari,0,0,0,,Thiệt tình... Nakoruru này...
Dialogue: 0,0:14:42.70,0:14:44.70,Default,Manari,0,0,0,,Ngại lắm đấy, cấm cậu nhìn chằm chằm vào mặt tớ đấy nhé!
Dialogue: 0,0:14:49.70,0:15:10.70,Song,Manari (Hát),0,0,0,,{\i1}Giữa rừng tuyết trắng mờ sương, mối tình định mệnh khẽ buông rơi...{\i0}
Dialogue: 0,0:15:10.70,0:15:27.70,Song,Manari (Hát),0,0,0,,{\i1}Dẫu thế gian này có chìm trong cuồng loạn chia lìa...{\i0}
Dialogue: 0,0:15:27.70,0:15:48.70,Song,Manari (Hát),0,0,0,,{\i1}Chỉ cần cùng người, ta sẽ vút bay, trao gửi trọn niềm thương nhớ...{\i0}
Dialogue: 0,0:15:48.70,0:16:04.70,Song,Manari (Hát),0,0,0,,{\i1}Phép màu đầu tiên ngày đôi ta tương phùng, vẫn thì thầm nơi sâu thẳm con tim...{\i0}
Dialogue: 0,0:16:05.70,0:16:16.70,Song,Manari (Hát),0,0,0,,{\i1}Dẫu người mãi mãi chỉ xem ta là tri kỷ... lòng này vẫn trọn một tình yêu...{\i0}
Dialogue: 0,0:16:30.38,0:16:35.22,Default,Manari / Nakoruru,0,0,0,,Cậu thấy thế nào hả Nakoruru? / Tuyệt vời lắm Manari ơi!
Dialogue: 0,0:16:35.22,0:16:41.82,Default,Nakoruru,0,0,0,,Nhưng Manari hát hay đến nhường này, sao cậu không hát trước mặt mọi người?\N- Chuyện đó...
Dialogue: 0,0:16:41.82,0:16:44.32,Default,Manari,0,0,0,,À thì...
Dialogue: 0,0:16:48.70,0:16:52.70,Default,Nakoruru,0,0,0,,Mưa rồi kìa! Chúng mình mau chạy vào rừng trú thôi!
Dialogue: 0,0:17:03.70,0:17:08.70,Default,Nakoruru,0,0,0,,Sao thế này? Âm thanh này... tại sao thiên nhiên lại phẫn nộ đến vậy?
Dialogue: 0,0:17:18.70,0:17:20.70,Default,Nakoruru,0,0,0,,Nakoruru!
Dialogue: 0,0:17:20.70,0:17:22.70,Default,Nakoruru,0,0,0,,Manari! Mau lùi lại!
Dialogue: 0,0:17:22.70,0:17:24.70,Default,Nakoruru,0,0,0,,Xin các ngài hãy dừng cơn cuồng nộ lại đi!
Dialogue: 0,0:17:26.70,0:17:28.70,Default,Manari,0,0,0,,Kìa...!
Dialogue: 0,0:17:28.70,0:17:30.70,Default,Nakoruru,0,0,0,,Tại sao lại ra nông nỗi này chứ...
Dialogue: 0,0:17:48.70,0:17:52.70,Italic,Rera,0,0,0,,{\i1}Tại sao...{\i0}
Dialogue: 0,0:17:52.70,0:17:56.70,Italic,Rera,0,0,0,,{\i1}Tại sao ngươi lại hèn nhát chạy trốn chiến đấu hả Nakoruru?!{\i0}
Dialogue: 0,0:17:56.70,0:17:58.70,Default,Nakoruru,0,0,0,,Chuyện đó...
Dialogue: 0,0:17:58.70,0:18:01.70,Default,Yantamu,0,0,0,,Kìa, Nakoruru!
Dialogue: 0,0:18:01.70,0:18:03.70,Default,Rimururu,0,0,0,,Tỉ tỉ ơi!
Dialogue: 0,0:18:03.70,0:18:04.70,Default,Rimururu,0,0,0,,Nguy to rồi tỉ ơi!
Dialogue: 0,0:18:04.70,0:18:06.70,Default,Rimururu,0,0,0,,Thanh bảo đao Chichiushi biến mất rồi!
Dialogue: 0,0:18:11.70,0:18:13.70,Default,Nakoruru,0,0,0,,Mình...
Dialogue: 0,0:18:13.70,0:18:15.70,Default,Nakoruru,0,0,0,,Manari! Cậu không sao chứ?
Dialogue: 0,0:18:18.70,0:18:20.96,Default,Manari,0,0,0,,Tớ... tớ vẫn còn sống...
Dialogue: 0,0:18:20.96,0:18:22.32,Default,Rimururu,0,0,0,,Mọi người nhìn kìa!
Dialogue: 0,0:18:22.32,0:18:23.86,Default,Rimururu,0,0,0,,Chính tỉ tỉ đã vung kiếm bảo vệ Manari đấy!
Dialogue: 0,0:18:23.86,0:18:26.66,Default,Rimururu,0,0,0,,Thấy thanh Chichiushi biến mất làm em cứ hoảng hồn...
Dialogue: 0,0:18:26.66,0:18:28.66,Default,Rimururu,0,0,0,,Hóa ra là do chính tay tỉ tỉ mang theo bên mình!
Dialogue: 0,0:18:30.70,0:18:31.70,Default,Nakoruru,0,0,0,,Yantamu?
Dialogue: 0,0:18:35.22,0:18:36.10,Default,Yantamu,0,0,0,,Nakoruru.
Dialogue: 0,0:18:38.14,0:18:39.98,Default,Yantamu,0,0,0,,Đừng bao giờ rút thanh Chichiushi ra nữa.
Dialogue: 0,0:18:39.98,0:18:40.62,Default,Nakoruru,0,0,0,,Hả?
Dialogue: 0,0:18:41.90,0:18:44.80,Default,Yantamu,0,0,0,,Nếu mai này lại có biến cố hay chiến trận hiểm nghèo...
Dialogue: 0,0:18:44.80,0:18:46.00,Default,Yantamu,0,0,0,,Thì lần này, cứ để tôi ra trận!
Dialogue: 0,0:18:46.66,0:18:47.66,Default,Nakoruru,0,0,0,,Yantamu...
Dialogue: 0,0:18:48.70,0:18:49.70,Default,Nakoruru,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:19:18.70,0:19:20.70,Default,Yantamu (Hồi tưởng),0,0,0,,Tuyệt quá đi!
Dialogue: 0,0:19:20.70,0:19:22.70,Default,Manari (Hồi tưởng),0,0,0,,Thích quá chừng luôn!
Dialogue: 0,0:19:26.70,0:19:28.70,Default,Manari (Hồi tưởng),0,0,0,,Nước mát rượi luôn này!
Dialogue: 0,0:19:34.70,0:19:37.70,Default,Manari (Hồi tưởng),0,0,0,,Được rồi, nhìn tớ nhảy xuống này Yantamu!
Dialogue: 0,0:19:37.70,0:19:40.70,Default,Yantamu (Hồi tưởng),0,0,0,,Đừng có liều! Chỗ đứng tới chân mà cậu còn suýt chết đuối cơ mà!
Dialogue: 0,0:19:40.70,0:19:42.70,Default,Manari (Hồi tưởng),0,0,0,,Hứ! Dám xem thường người ta à!
Dialogue: 0,0:19:42.70,0:19:44.70,Default,Manari (Hồi tưởng),0,0,0,,Nhìn cho kỹ đây này!
Dialogue: 0,0:19:48.70,0:19:50.70,Default,Manari (Hồi tưởng),0,0,0,,Ái chao!
Dialogue: 0,0:19:55.70,0:19:57.70,Default,Yantamu (Hồi tưởng),0,0,0,,Đấy, đã bảo rồi mà không chịu nghe cơ!
Dialogue: 0,0:19:58.70,0:20:01.70,Default,Manari (Hồi tưởng),0,0,0,,Yantamu... Đừng có buông tay tớ ra nhé!
Dialogue: 0,0:20:01.70,0:20:03.70,Default,Yantamu (Hồi tưởng),0,0,0,,Biết sợ thì đừng có bơi ra chỗ nước sâu chứ!
Dialogue: 0,0:20:04.70,0:20:05.70,Default,Manari (Hồi tưởng),0,0,0,,T... Tớ xin lỗi mà...
Dialogue: 0,0:20:06.70,0:20:08.70,Default,Yantamu (Hồi tưởng),0,0,0,,Hết cách với cậu, bám chắc để tớ kéo vào bờ cho.
Dialogue: 0,0:20:09.70,0:20:10.70,Default,Manari (Hồi tưởng),0,0,0,,Ừm!
Dialogue: 0,0:20:10.70,0:20:13.70,Default,Rimururu,0,0,0,,Phải chi tỉ tỉ cũng cùng xuống tắm thì vui biết mấy.
Dialogue: 0,0:20:48.70,0:20:50.70,Default,Nakoruru,0,0,0,,Nơi này là...
Dialogue: 0,0:21:12.70,0:21:14.70,Italic,Rera,0,0,0,,{\i1}Tất cả là do ngươi đấy!{\i0}
Dialogue: 0,0:21:14.70,0:21:18.70,Italic,Rera,0,0,0,,{\i1}Trong khi ngươi còn đang chần chừ trốn tránh việc chiến đấu...{\i0}
Dialogue: 0,0:21:18.70,0:21:20.70,Italic,Rera,0,0,0,,{\i1}Thì thế giới này đã rơi vào thảm cảnh tan hoang thế này đây!{\i0}
Dialogue: 0,0:21:20.70,0:21:23.70,Italic,Rera,0,0,0,,{\i1}Ngươi càng muốn mưu cầu hạnh phúc bình yên cho riêng mình...{\i0}
Dialogue: 0,0:21:23.70,0:21:26.70,Italic,Rera,0,0,0,,{\i1}Thì lại càng có thêm biết bao nhiêu sinh linh phải bỏ mạng!{\i0}
Dialogue: 0,0:21:26.70,0:21:28.70,Italic,Rera,0,0,0,,{\i1}Ngay cả những đứa trẻ ngây thơ vô tội này...{\i0}
Dialogue: 0,0:21:28.70,0:21:30.70,Italic,Rera,0,0,0,,{\i1}Chúng cũng từng khao khát được sống tiếp biết bao nhiêu!{\i0}
Dialogue: 0,0:21:42.70,0:21:44.70,Default,Nakoruru,0,0,0,,Mình... Mình thực sự...
Dialogue: 0,0:21:44.70,0:21:46.70,Default,Bọn trẻ,0,0,0,,Nakoruru ơi!
Dialogue: 0,0:21:46.70,0:21:48.70,Default,Rimururu,0,0,0,,Tỉ tỉ ơi!
Dialogue: 0,0:21:48.70,0:21:50.70,Default,Bọn trẻ,0,0,0,,Chị Nakoruru ơi!
Dialogue: 0,0:21:50.70,0:21:52.70,Default,Bọn trẻ,0,0,0,,Chị Nakoruru!
Dialogue: 0,0:21:52.70,0:21:54.70,Default,Bọn trẻ,0,0,0,,Ngôi làng bên cạnh gặp chuyện chẳng lành rồi!
Dialogue: 0,0:21:54.70,0:21:56.70,Default,Bọn trẻ,0,0,0,,Chị Nakoruru mau đến xem đi!
Dialogue: 0,0:21:56.70,0:21:58.70,Default,Bọn trẻ,0,0,0,,Chị Nakoruru!
Dialogue: 0,0:21:58.70,0:22:00.70,Default,Bọn trẻ,0,0,0,,Ngôi làng bên cạnh...
Dialogue: 0,0:22:00.70,0:22:02.70,Default,Bọn trẻ,0,0,0,,Đã bị dịch bệnh quái ác tiêu diệt sạch cả làng rồi!
Dialogue: 0,0:22:02.70,0:22:04.70,Default,Bọn trẻ,0,0,0,,Trưởng lão trong làng bảo...
Dialogue: 0,0:22:04.70,0:22:06.70,Default,Bọn trẻ,0,0,0,,Muốn chị Nakoruru mau đến đó ngay lập tức!
Dialogue: 0,0:22:06.70,0:22:08.70,Default,Bọn trẻ,0,0,0,,Chị Nakoruru ơi!
Dialogue: 0,0:22:08.70,0:22:10.70,Default,Bọn trẻ,0,0,0,,Mau lên chị ơi!
Dialogue: 0,0:22:10.70,0:22:14.70,Default,Trưởng lão,0,0,0,,Đây là người duy nhất còn sống sót trong cả ngôi làng bị diệt vong...
Dialogue: 0,0:22:14.70,0:22:17.70,Default,Bà lão,0,0,0,,Thật may là con bé không bị lây nhiễm dịch bệnh quái ác.
Dialogue: 0,0:22:17.70,0:22:21.70,Default,Bà lão,0,0,0,,Chỉ là sau cú sốc quá lớn, ký ức của nó có phần hỗn loạn...
Dialogue: 0,0:22:21.70,0:22:22.70,Default,Bà lão,0,0,0,,Đúng thế thật...
Dialogue: 0,0:22:24.70,0:22:25.70,Default,Dân làng,0,0,0,,Cô gái xinh đẹp đó...
Dialogue: 0,0:22:25.70,0:22:27.70,Default,Dân làng,0,0,0,,Sẽ dọn về ở tại nhà của trưởng lão à?
Dialogue: 0,0:22:27.70,0:22:28.70,Default,Dân làng,0,0,0,,Chắc là vậy rồi...
Dialogue: 0,0:22:28.70,0:22:31.70,Default,Dân làng,0,0,0,,Trưởng lão trông thế mà cũng biết tính toán ghê nhỉ.
Dialogue: 0,0:22:31.70,0:22:32.70,Default,Dân làng,0,0,0,,Hai người họ...
Dialogue: 0,0:22:32.70,0:22:34.70,Default,Dân làng,0,0,0,,Liệu có nên duyên vợ chồng không ta?
Dialogue: 0,0:22:34.70,0:22:35.70,Default,Yantamu,0,0,0,,Này Manari...
Dialogue: 0,0:22:35.70,0:22:36.70,Default,Yantamu,0,0,0,,Này Manari?
Dialogue: 0,0:22:36.70,0:22:37.70,Default,Manari,0,0,0,,Hửm?
Dialogue: 0,0:22:37.70,0:22:38.70,Default,Yantamu,0,0,0,,Này Manari ơi?
Dialogue: 0,0:22:38.70,0:22:39.70,Default,Yantamu,0,0,0,,Cậu có nghe tôi nói không thế?
Dialogue: 0,0:22:39.70,0:22:40.70,Default,Manari,0,0,0,,Hả?
Dialogue: 0,0:22:40.70,0:22:41.70,Default,Yantamu,0,0,0,,Ai mà biết được...
Dialogue: 0,0:22:41.70,0:22:43.70,Default,Yantamu,0,0,0,,Nhưng nếu lấy được một người phụ nữ xinh đẹp nhường ấy...
Dialogue: 0,0:22:43.70,0:22:45.70,Default,Yantamu,0,0,0,,Thì đàn ông ai mà chẳng muốn kết hôn chứ!
Dialogue: 0,0:22:45.70,0:22:46.70,Default,Manari,0,0,0,,Hừ...
Dialogue: 0,0:22:46.70,0:22:47.70,Default,Manari,0,0,0,,Đồ đáng ghét!
Dialogue: 0,0:22:47.70,0:22:48.70,Default,Yantamu,0,0,0,,Ái da da da!
Dialogue: 0,0:22:48.70,0:22:50.70,Default,Yantamu,0,0,0,,Sao tự dưng cậu lại đánh tôi hả?!
Dialogue: 0,0:22:50.70,0:22:51.70,Default,Manari,0,0,0,,Hứ!
Dialogue: 0,0:23:04.70,0:23:08.70,Default,Nakoruru,0,0,0,,Mình chỉ muốn được sống những tháng ngày bình yên ở Kamui Kotan thôi mà...
Dialogue: 0,0:23:08.70,0:23:09.70,Default,Nakoruru,0,0,0,,Nhưng tại sao...
Dialogue: 0,0:23:10.70,0:23:13.70,Default,Nakoruru (Bé),0,0,0,,Mẹ ơi? Người ấy đang gọi mẹ kìa.
Dialogue: 0,0:23:14.70,0:23:17.70,Default,Mẹ Nakoruru,0,0,0,,Người ấy ư? Nakoruru...
Dialogue: 0,0:23:18.70,0:23:21.70,Default,Mẹ Nakoruru,0,0,0,,Con không được gọi người đó như vậy đâu.
Dialogue: 0,0:23:21.70,0:23:24.70,Default,Nakoruru (Bé),0,0,0,,Nhưng mà ngài ấy đối xử tốt với chúng ta hệt như một người cha thật sự vậy...
Dialogue: 0,0:23:24.70,0:23:27.70,Default,Nakoruru (Bé),0,0,0,,Giá như mẹ kết hôn với người ấy thì tốt biết bao!
Dialogue: 0,0:23:28.70,0:23:31.70,Default,Mẹ Nakoruru,0,0,0,,Thật ngây thơ... Một vu nữ phụng sự thần linh suốt đời không được phép kết hôn.
Dialogue: 0,0:23:34.70,0:23:44.70,Default,Mẹ Nakoruru,0,0,0,,Mẹ đã từng thật lòng yêu thương người ấy...
Dialogue: 0,0:24:04.70,0:24:07.70,Default,Mẹ Nakoruru,0,0,0,,Thế nhưng vì giới luật thiêng liêng của một vu nữ...
Dialogue: 0,0:24:07.70,0:24:10.70,Default,Nakoruru (Bé),0,0,0,,Mẹ đang khóc đấy ạ?
Dialogue: 0,0:24:10.70,0:24:12.70,Default,Mẹ Nakoruru,0,0,0,,Sao tự dưng con lại hỏi vậy?
Dialogue: 0,0:24:12.70,0:24:15.70,Default,Nakoruru (Bé),0,0,0,,Vì vừa rồi con thấy khóe mắt mẹ như sắp khóc...
Dialogue: 0,0:24:15.70,0:24:17.70,Default,Mẹ Nakoruru,0,0,0,,Mẹ không khóc đâu con yêu.
Dialogue: 0,0:24:17.70,0:24:19.70,Default,Mẹ Nakoruru,0,0,0,,Đúng vậy, mẹ sẽ không khóc...
Dialogue: 0,0:24:19.70,0:24:21.70,Default,Mẹ Nakoruru,0,0,0,,Mẹ hoàn toàn ổn mà.
Dialogue: 0,0:24:25.70,0:24:27.70,Default,Nakoruru,0,0,0,,Mẹ ơi...
Dialogue: 0,0:24:30.70,0:24:31.70,Italic,Rera,0,0,0,,{\i1}Ngươi thật là ngu muội!{\i0}
Dialogue: 0,0:24:31.70,0:24:37.10,Italic,Rera,0,0,0,,{\i1}Hãy nhớ lại sứ mệnh thiêng liêng của một vu nữ đi!\NĐừng có hòng trốn chạy thực tại nữa!{\i0}
Dialogue: 0,0:24:37.10,0:24:40.70,Default,Nakoruru,0,0,0,,Tôi không hề trốn chạy!
Dialogue: 0,0:24:40.70,0:24:47.02,Italic,Rera,0,0,0,,{\i1}Hãy dẹp bỏ thứ tình cảm yếu đuối và quên người đàn ông đó đi!\NNgươi thừa biết số phận nghiệt ngã của mình mà!{\i0}
Dialogue: 0,0:24:47.02,0:24:49.70,Italic,Rera,0,0,0,,{\i1}Nakoruru!{\i0}
Dialogue: 0,0:25:01.70,0:25:05.70,Default,Nakoruru,0,0,0,,Sao thế này em nhỏ? Em cũng chỉ cô độc một mình thôi sao?
Dialogue: 0,0:25:19.70,0:25:22.70,Default,Nakoruru,0,0,0,,Ngọn núi thiêng... Ngọn núi đang gào thét trong đau đớn!
Dialogue: 0,0:25:31.70,0:25:33.70,Default,Nakoruru,0,0,0,,Áaaaaa!
Dialogue: 0,0:26:31.70,0:27:00.70,Song,Ending Song,0,0,0,,{\i1}Dòng nước trở về cùng biển nước, vầng trăng quay về với ánh trăng...{\i0}
Dialogue: 0,0:27:01.70,0:27:07.70,Song,Ending Song,0,0,0,,{\i1}Ngàn tinh tú trở về với bầu trời đêm sao...{\i0}
Dialogue: 0,0:27:07.70,0:27:13.70,Song,Ending Song,0,0,0,,{\i1}Con người đón nhận tất cả từ đất trời linh thiêng...{\i0}
Dialogue: 0,0:27:13.70,0:27:19.70,Song,Ending Song,0,0,0,,{\i1}Để rồi cuối cùng cũng bị tước đoạt lại tất cả...{\i0}
Dialogue: 0,0:27:21.70,0:27:25.70,Song,Ending Song,0,0,0,,{\i1}Sấm sét rền vang nơi thăm thẳm u tịch...{\i0}
Dialogue: 0,0:27:25.70,0:27:33.70,Song,Ending Song,0,0,0,,{\i1}Màn đêm rung chuyển đất trời trong cơn bão tố...{\i0}
Dialogue: 0,0:27:33.70,0:27:39.70,Song,Ending Song,0,0,0,,{\i1}Giọt lệ tuôn rơi ngút ngàn trời cao...{\i0}
Dialogue: 0,0:27:39.70,0:27:46.70,Song,Ending Song,0,0,0,,{\i1}Giọt lệ thấm sâu vào lòng đất mẹ bao la...{\i0}
Dialogue: 0,0:27:46.70,0:27:53.70,Song,Ending Song,0,0,0,,{\i1}Để ngọn lửa sinh mệnh mãi không bao giờ lụi tàn...{\i0}
Dialogue: 0,0:27:53.70,0:28:05.70,Song,Ending Song,0,0,0,,{\i1}Mãi trường tồn qua muôn ngàn thời đại... Sinh mệnh luân hồi...{\i0}
Dialogue: 0,0:28:06.70,0:28:12.70,Song,Ending Song,0,0,0,,{\i1}Để bước tiếp sang một kỷ nguyên mới...{\i0}
Dialogue: 0,0:28:13.00,0:28:20.00,Credit,Credit,0,0,0,,{\an8\b1\fs20}Phụ đề Việt ngữ: Amtia(NOFACE)
