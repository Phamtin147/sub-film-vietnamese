Dialogue: 0,0:03:00.72,0:03:03.72,Default,,0,0,0,,(Mr. Big) Chào Mai.
Dialogue: 0,0:03:03.80,0:03:06.18,Default,,0,0,0,,(Mai) Sao ông lại chọn cái xó lạnh ngắt này hả?
Dialogue: 0,0:03:06.26,0:03:07.56,Default,,0,0,0,,(Mr. Big) Trả đũa thôi.
Dialogue: 0,0:03:07.64,0:03:10.52,Default,,0,0,0,,Còn nhớ phòng xông hơi cô chọn lần trước không?
Dialogue: 0,0:03:18.07,0:03:22.70,Default,,0,0,0,,(Mr. Big) Cô định trốn sau đó cả ngày đấy à?
Dialogue: 0,0:03:22.78,0:03:24.95,Default,,0,0,0,,(Mai) Ông mơ đi.
Dialogue: 0,0:03:49.47,0:03:53.48,Default,,0,0,0,,(Mai) Chà, ông thù dai thật đấy.
Dialogue: 0,0:04:28.43,0:04:30.60,Default,,0,0,0,,(Mr. Big) Cái quái gì thế kia?
Dialogue: 0,0:04:30.68,0:04:36.90,Default,,0,0,0,,(Mai) Đó sẽ là chiến thắng của tôi.
Dialogue: 0,0:04:36.98,0:04:39.48,Default,,0,0,0,,(Mai) Suýt soát thật đấy.
Dialogue: 0,0:04:39.57,0:04:41.98,Default,,0,0,0,,Này, mẹ ông có biết ông lấy áo khoác của bà ấy mặc không?
Dialogue: 0,0:04:42.07,0:04:44.86,Default,,0,0,0,,(Mr. Big) Quà tặng đấy nhé.
Dialogue: 0,0:05:04.05,0:05:08.14,Default,,0,0,0,,Ôi... đau điếng.
Dialogue: 0,0:05:50.55,0:05:53.68,Default,,0,0,0,,(Mr. Big) Tôi nằm nghỉ ở đây một lát đã.
Dialogue: 0,0:05:53.77,0:06:01.77,Default,,0,0,0,,Cứ tự nhiên.
Dialogue: 0,0:06:06.61,0:06:12.87,Default,,0,0,0,,Ôi... trời đất ơi... khốn kiếp...
Dialogue: 0,0:06:12.95,0:06:16.54,Default,,0,0,0,,Đùa nhau chắc.
Dialogue: 0,0:07:56.60,0:07:57.72,Default,,0,0,0,,(Iori) Xin lỗi, à...
Dialogue: 0,0:07:57.81,0:07:59.81,Default,,0,0,0,,Cô có tình cờ nhìn thấy...
Dialogue: 0,0:07:59.89,0:08:01.56,Default,,0,0,0,,người tôi hẹn không?
Dialogue: 0,0:08:01.64,0:08:03.27,Default,,0,0,0,,(Mai) Không, nhưng tôi có thể giúp anh tìm cô ấy.
Dialogue: 0,0:08:03.35,0:08:04.48,Default,,0,0,0,,Tìm cô ấy nếu anh muốn.
Dialogue: 0,0:08:04.56,0:08:06.02,Default,,0,0,0,,Anh đến muộn đấy nhé.
Dialogue: 0,0:08:06.11,0:08:08.52,Default,,0,0,0,,Anh xin lỗi.
Dialogue: 0,0:08:08.61,0:08:10.15,Default,,0,0,0,,Em vừa vào đấu à?
Dialogue: 0,0:08:10.23,0:08:12.03,Default,,0,0,0,,10 phút trước.
Dialogue: 0,0:08:12.11,0:08:13.45,Default,,0,0,0,,Và?
Dialogue: 0,0:08:13.53,0:08:17.28,Default,,0,0,0,,Em đã bước tiếp vào vòng trong.
Dialogue: 0,0:08:17.37,0:08:21.43,Default,,0,0,0,,Mai, anh tự hào về em lắm.
Dialogue: 0,0:08:21.45,0:08:23.37,Default,,0,0,0,,Bỏ qua bữa tiệc này đi em.
Dialogue: 0,0:08:23.46,0:08:24.58,Default,,0,0,0,,Không, không được đâu.
Dialogue: 0,0:08:24.67,0:08:30.42,Default,,0,0,0,,Chính anh bảo chúng ta trễ giờ mà.
Dialogue: 0,0:08:37.76,0:08:40.22,Default,,0,0,0,,(Bảo vệ) Xin vui lòng xuất trình thiệp mời.
Dialogue: 0,0:08:40.31,0:08:42.18,Default,,0,0,0,,(Iori) Sao cơ?
Dialogue: 0,0:08:42.27,0:08:43.56,Default,,0,0,0,,(Mr. Big) Ồ, xin lỗi cậu Yagami.
Dialogue: 0,0:08:43.64,0:08:47.40,Default,,0,0,0,,Cậu thì không cần thiệp mời đâu.
Dialogue: 0,0:09:04.79,0:09:09.54,Default,,0,0,0,,(Đặc vụ) Ờ, tôi nghĩ... chúng ta vừa mất tín hiệu camera số 7.
Dialogue: 0,0:09:09.63,0:09:10.73,Default,,0,0,0,,(Terry) Cậu có biết trước đây...
Dialogue: 0,0:09:10.75,0:09:11.96,Default,,0,0,0,,tôi từng đóng quân ở đâu không?
Dialogue: 0,0:09:12.05,0:09:14.30,Default,,0,0,0,,(Đặc vụ) Afghanistan ạ.
Dialogue: 0,0:09:14.38,0:09:16.34,Default,,0,0,0,,(Terry) Đúng thế, Afghanistan.
Dialogue: 0,0:09:16.43,0:09:17.78,Default,,0,0,0,,Thiết bị giám sát triệu đô
Dialogue: 0,0:09:17.80,0:09:19.76,Default,,0,0,0,,được gửi tới rặng đồi Tora Bora, cách nền văn minh
Dialogue: 0,0:09:19.85,0:09:21.05,Default,,0,0,0,,hàng nghìn dặm.
Dialogue: 0,0:09:21.14,0:09:22.93,Default,,0,0,0,,Bất cứ thứ gì tôi muốn chỉ cần một cú điện thoại.
Dialogue: 0,0:09:23.02,0:09:25.77,Default,,0,0,0,,Vậy ai giải thích giùm tôi, tại sao tôi lại ở
Dialogue: 0,0:09:25.85,0:09:27.45,Default,,0,0,0,,một trong những quốc gia tiên tiến nhất thế giới
Dialogue: 0,0:09:27.48,0:09:30.37,Default,,0,0,0,,về công nghệ, mà lại không kiếm nổi
Dialogue: 0,0:09:30.40,0:09:33.11,Default,,0,0,0,,một cái camera giám sát cho ra hồn không?
Dialogue: 0,0:09:33.19,0:09:36.03,Default,,0,0,0,,(Đặc vụ) Tôi không...
Dialogue: 0,0:09:40.78,0:09:42.83,Default,,0,0,0,,(Chizuru) Iori...
Dialogue: 0,0:09:42.91,0:09:44.91,Default,,0,0,0,,Rất mừng vì cuối cùng cậu cũng tới.
Dialogue: 0,0:09:45.00,0:09:46.83,Default,,0,0,0,,(Iori) Tôi rất xin lỗi vì bọn tôi đến muộn.
Dialogue: 0,0:09:46.91,0:09:49.04,Default,,0,0,0,,Chizuru, đây là Mai Shiranui.
Dialogue: 0,0:09:49.13,0:09:51.50,Default,,0,0,0,,(Mai) Thật vinh hạnh khi cuối cùng cũng được gặp chị.
Dialogue: 0,0:09:51.59,0:09:52.60,Default,,0,0,0,,Ồ, tôi nghe nói cần phải chúc mừng cô rồi đấy.
Dialogue: 0,0:09:52.63,0:09:56.01,Default,,0,0,0,,Chúc mừng chiến thắng nhé.
Dialogue: 0,0:09:56.09,0:09:58.17,Default,,0,0,0,,Dạ, cảm ơn chị rất nhiều.
Dialogue: 0,0:09:58.26,0:10:01.01,Default,,0,0,0,,Năm qua cô đã tiến bộ rất nhiều.
Dialogue: 0,0:10:01.10,0:10:02.24,Default,,0,0,0,,Tôi không nhớ nổi từ bao giờ chúng ta mới có
Dialogue: 0,0:10:02.26,0:10:05.31,Default,,0,0,0,,một đấu sĩ kiên định đầy nhiệt huyết như vậy.
Dialogue: 0,0:10:05.39,0:10:08.27,Default,,0,0,0,,Được rồi, cậu đã ở đây, chúng ta có thể bắt đầu.
Dialogue: 0,0:10:09.98,0:10:13.48,Default,,0,0,0,,Thú thật, tôi thấy hơi bồn chồn.
Dialogue: 0,0:10:13.57,0:10:15.23,Default,,0,0,0,,(Iori) Có chuyện gì vậy?
Dialogue: 0,0:10:15.32,0:10:16.46,Default,,0,0,0,,Những cổ vật này chưa từng được
Dialogue: 0,0:10:16.49,0:10:18.45,Default,,0,0,0,,trưng bày công khai như thế này bao giờ.
Dialogue: 0,0:10:18.53,0:10:19.95,Default,,0,0,0,,Vậy tại sao lại mạo hiểm?
Dialogue: 0,0:10:20.03,0:10:21.36,Default,,0,0,0,,Nếu lỡ xảy ra chuyện gì...
Dialogue: 0,0:10:21.45,0:10:23.16,Default,,0,0,0,,Takao Iwata cứ khăng khăng đòi làm vậy.
Dialogue: 0,0:10:23.24,0:10:25.45,Default,,0,0,0,,Ông ta nắm quyền tài chính của giải đấu, và
Dialogue: 0,0:10:25.54,0:10:28.39,Default,,0,0,0,,ai cũng biết tính ông ta thích phô trương.
Dialogue: 0,0:10:28.41,0:10:30.43,Default,,0,0,0,,Tôi chỉ cần đảm bảo an ninh được bố trí
Dialogue: 0,0:10:30.46,0:10:34.13,Default,,0,0,0,,thật nghiêm ngặt là được.
Dialogue: 0,0:10:41.76,0:10:43.80,Default,,0,0,0,,(Terry) Cô ta có biết về các camera của chúng ta không?
Dialogue: 0,0:10:43.89,0:10:51.56,Default,,0,0,0,,(Đặc vụ) Tôi... tôi nghĩ là không đâu sếp.
Dialogue: 0,0:11:00.49,0:11:04.28,Default,,0,0,0,,(Iori) Cảm ơn.
Dialogue: 0,0:11:04.37,0:11:07.41,Default,,0,0,0,,(Mai) Chà... nhìn anh kìa.
Dialogue: 0,0:11:07.50,0:11:08.51,Default,,0,0,0,,Nhìn cách họ đối xử với anh, cứ ngỡ
Dialogue: 0,0:11:08.54,0:11:09.91,Default,,0,0,0,,anh là King of Fighters thật ấy chứ.
Dialogue: 0,0:11:10.00,0:11:13.42,Default,,0,0,0,,Anh đã giải nghệ quá lâu rồi.
Dialogue: 0,0:11:13.50,0:11:15.40,Default,,0,0,0,,Không, họ mời anh chỉ vì anh là hậu duệ cuối cùng
Dialogue: 0,0:11:15.42,0:11:17.50,Default,,0,0,0,,của gia tộc Yagami thôi.
Dialogue: 0,0:11:17.59,0:11:20.17,Default,,0,0,0,,Anh chưa bao giờ kể sao anh lại giải nghệ sớm thế.
Dialogue: 0,0:11:20.26,0:11:21.59,Default,,0,0,0,,Phức tạp lắm em.
Dialogue: 0,0:11:21.68,0:11:23.47,Default,,0,0,0,,Chà, anh vốn là người phức tạp mà, Iori.
Dialogue: 0,0:11:23.55,0:11:26.55,Default,,0,0,0,,Em đâu dám mong nó đơn giản.
Dialogue: 0,0:11:26.64,0:11:26.85,Default,,0,0,0,,Để dịp khác nhé.
Dialogue: 0,0:11:26.93,0:11:28.41,Default,,0,0,0,,Hứa đấy nhé?
Dialogue: 0,0:11:28.43,0:11:29.43,Default,,0,0,0,,Anh hứa mà.
Dialogue: 0,0:11:29.52,0:11:32.94,Default,,0,0,0,,Này, nói thế không tính là lời hứa đâu.
Dialogue: 0,0:11:33.02,0:11:34.10,Default,,0,0,0,,Anh hứa thật mà.
Dialogue: 0,0:11:34.19,0:11:35.86,Default,,0,0,0,,Đi thôi em.
Dialogue: 0,0:11:40.82,0:11:43.53,Default,,0,0,0,,(Chizuru) Xin lỗi vì đã để ông phải đợi, ngài Iwata.
Dialogue: 0,0:11:43.61,0:11:49.66,Default,,0,0,0,,Xin mời đi theo tôi.
Dialogue: 0,0:12:01.01,0:12:02.80,Default,,0,0,0,,(Iori) Đi cùng anh. Nhanh nào.
Dialogue: 0,0:12:02.88,0:12:05.47,Default,,0,0,0,,Chỗ này ngồi xem rõ nhất đấy.
Dialogue: 0,0:12:14.10,0:12:16.52,Default,,0,0,0,,(Iori) Chúng ở đằng kia,
Dialogue: 0,0:12:16.61,0:12:18.36,Default,,0,0,0,,tam đại bảo vật của các đại gia tộc.
Dialogue: 0,0:12:18.44,0:12:19.02,Default,,0,0,0,,Chính chúng đã giúp
Dialogue: 0,0:12:19.11,0:12:24.78,Default,,0,0,0,,giải đấu King of Fighters tồn tại được.
Dialogue: 0,0:12:24.86,0:12:26.43,Default,,0,0,0,,(Iori) Em có cần nghe máy không?
Dialogue: 0,0:12:26.45,0:12:28.58,Default,,0,0,0,,Không, không cần đâu.
Dialogue: 0,0:12:28.66,0:12:30.49,Default,,0,0,0,,Tối nay em toàn tâm toàn ý bên anh, em xin lỗi.
Dialogue: 0,0:12:30.58,0:12:34.50,Default,,0,0,0,,Ngồi xuống đi. À, bí mật...
Dialogue: 0,0:12:34.58,0:12:36.04,Default,,0,0,0,,về các bảo vật vốn chỉ được lưu truyền
Dialogue: 0,0:12:36.13,0:12:37.44,Default,,0,0,0,,nội bộ trong các gia tộc thôi.
Dialogue: 0,0:12:37.46,0:12:39.04,Default,,0,0,0,,(Mai) Ồ.
Dialogue: 0,0:12:39.13,0:12:41.40,Default,,0,0,0,,Nhưng anh có thể tiết lộ cho em một chút.
Dialogue: 0,0:12:41.42,0:12:43.21,Default,,0,0,0,,Vâng.
Dialogue: 0,0:12:43.30,0:12:45.09,Default,,0,0,0,,Bát Quỳnh Quỳnh Khúc Ngọc (Yasakani no Magatama) được tạo ra
Dialogue: 0,0:12:45.18,0:12:48.55,Default,,0,0,0,,bởi tổ tiên anh từ gần 2.000 năm trước.
Dialogue: 0,0:12:48.64,0:12:50.43,Default,,0,0,0,,Vào thời điểm đó, chuỗi ngọc nắm giữ...
Dialogue: 0,0:12:50.51,0:12:54.14,Default,,0,0,0,,năng lượng để mở ra cánh cổng. Nó chính là chiếc chìa khóa.
Dialogue: 0,0:12:54.23,0:12:56.41,Default,,0,0,0,,Gương Bát Chỉ (Yata no Kagami) chính là cánh cổng...
Dialogue: 0,0:12:56.44,0:12:59.52,Default,,0,0,0,,và gia tộc Yata là những người đầu tiên tạo ra chiếc gương.
Dialogue: 0,0:12:59.61,0:13:03.78,Default,,0,0,0,,Chizuru chính là hậu duệ cuối cùng của gia tộc đó.
Dialogue: 0,0:13:03.86,0:13:06.40,Default,,0,0,0,,Và em có nhớ điều gì sẽ xảy ra khi ta
Dialogue: 0,0:13:06.49,0:13:09.47,Default,,0,0,0,,dẫn truyền năng lượng từ chuỗi ngọc vào chiếc gương không?
Dialogue: 0,0:13:09.49,0:13:11.91,Default,,0,0,0,,Cánh cổng bước sang chiều không gian khác sẽ mở ra.
Dialogue: 0,0:13:11.99,0:13:13.62,Default,,0,0,0,,Chính xác.
Dialogue: 0,0:13:13.70,0:13:15.96,Default,,0,0,0,,Nhưng em vẫn chưa hiểu. Ý em là...
Dialogue: 0,0:13:16.04,0:13:20.34,Default,,0,0,0,,Chỉ với một chuỗi ngọc và một tấm gương...
Dialogue: 0,0:13:20.42,0:13:22.71,Default,,0,0,0,,Nghe chẳng logic chút nào. Làm sao có thể chứ?
Dialogue: 0,0:13:22.80,0:13:25.34,Default,,0,0,0,,À, quý cô duy lý, anh quên mất đấy.
Dialogue: 0,0:13:25.42,0:13:27.34,Default,,0,0,0,,Iori, chúng ta đang dùng tai nghe truyền dẫn cơ mà.
Dialogue: 0,0:13:27.43,0:13:29.05,Default,,0,0,0,,Ý em là, làm sao chuyện đó diễn ra được?
Dialogue: 0,0:13:29.14,0:13:31.10,Default,,0,0,0,,Nghe này, anh biết trông nó chẳng có gì đặc biệt,
Dialogue: 0,0:13:31.18,0:13:32.47,Default,,0,0,0,,nhưng mấu chốt nằm ở đó đấy.
Dialogue: 0,0:13:32.56,0:13:35.48,Default,,0,0,0,,Cha của Chizuru là một thiên tài, ông đã tìm cách
Dialogue: 0,0:13:35.56,0:13:37.73,Default,,0,0,0,,gom các làn sóng năng lượng tồn tại từ những
Dialogue: 0,0:13:37.81,0:13:40.44,Default,,0,0,0,,cổ vật này và cô đọng chúng vào trong
Dialogue: 0,0:13:40.52,0:13:43.44,Default,,0,0,0,,những chiếc tai nghe mà chúng ta đang dùng hôm nay.
Dialogue: 0,0:13:43.53,0:13:46.78,Default,,0,0,0,,Giờ đây, chỉ cần nhấn một nút, ta có thể...
Dialogue: 0,0:13:46.86,0:13:49.57,Default,,0,0,0,,bước vào một chiều không gian khác.
Dialogue: 0,0:13:49.66,0:13:51.12,Default,,0,0,0,,Tuyệt thật đấy.
Dialogue: 0,0:13:51.20,0:13:53.91,Default,,0,0,0,,Anh biết, nghe điên rồ lắm đúng không.
Dialogue: 0,0:13:53.99,0:13:56.87,Default,,0,0,0,,Thế còn món bảo vật thứ ba?
Dialogue: 0,0:13:56.96,0:13:58.62,Default,,0,0,0,,Đó là Thảo Thế Kiếm (Kusanagi no Tsurugi)...
Dialogue: 0,0:13:58.71,0:14:01.44,Default,,0,0,0,,món bảo vật quan trọng nhất trong ba bảo vật.
Dialogue: 0,0:14:01.46,0:14:08.22,Default,,0,0,0,,Chỉ có thanh kiếm đó... mới tiêu diệt được Orochi.
Dialogue: 0,0:14:08.30,0:14:09.84,Default,,0,0,0,,Đó là thứ gì vậy anh?
Dialogue: 0,0:14:09.93,0:14:13.39,Default,,0,0,0,,(Iori) Orochi là một tà linh, một con quái vật,
Dialogue: 0,0:14:13.47,0:14:16.56,Default,,0,0,0,,đã bị phong ấn vào không gian dị giới từ 1800 năm trước.
Dialogue: 0,0:14:16.64,0:14:18.43,Default,,0,0,0,,Truyền thuyết kể rằng nó hứa hẹn ban sức mạnh vô biên cho
Dialogue: 0,0:14:18.52,0:14:21.48,Default,,0,0,0,,bất kỳ ai giải thoát nó, nhưng kẻ đó phải nắm giữ
Dialogue: 0,0:14:21.56,0:14:23.98,Default,,0,0,0,,đủ cả ba món bảo vật mới làm được.
Dialogue: 0,0:14:24.07,0:14:27.53,Default,,0,0,0,,(Mai) Chuyện gì sẽ xảy ra nếu nó được giải thoát?
Dialogue: 0,0:14:27.61,0:14:34.49,Default,,0,0,0,,Đó là bài học cho ngày khác, khi em sẵn sàng...
Dialogue: 0,0:14:34.58,0:14:37.91,Default,,0,0,0,,Hy vọng là sớm thôi.
Dialogue: 0,0:14:54.72,0:15:02.72,Default,,0,0,0,,(Bảo vệ) Tôi muốn làm được nhiều hơn, tôi nghĩ mình cần...
Dialogue: 0,0:15:04.06,0:15:06.65,Default,,0,0,0,,(Terry) Đi! Đi mau, đi, đi, đi!
Dialogue: 0,0:15:15.16,0:15:22.43,Default,,0,0,0,,Lại gần xem cho rõ nào, được chứ?
Dialogue: 0,0:15:22.46,0:15:23.63,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:15:23.71,0:15:24.83,Default,,0,0,0,,Ai thế kia?
Dialogue: 0,0:15:24.92,0:15:27.46,Default,,0,0,0,,Nhanh lên.
Dialogue: 0,0:15:57.03,0:16:01.04,Default,,0,0,0,,(Rugal) Chizuru... Dạo này thế nào hả Rugal?
Dialogue: 0,0:16:01.12,0:16:02.29,Default,,0,0,0,,(Bảo vệ) Xin lỗi ngài.
Dialogue: 0,0:16:02.37,0:16:06.58,Default,,0,0,0,,(Rugal) Ú òa.
Dialogue: 0,0:16:06.67,0:16:10.88,Default,,0,0,0,,(Terry) Xông lên!
Dialogue: 0,0:16:49.09,0:16:52.55,Default,,0,0,0,,(Iori) Chizuru... Cô ấy bị thương nặng rồi.
Dialogue: 0,0:16:52.63,0:16:55.59,Default,,0,0,0,,(Mai) Chizuru, nhìn tôi này, nhìn tôi đi.
Dialogue: 0,0:16:55.68,0:16:56.72,Default,,0,0,0,,(Chizuru) Rugal đâu rồi?
Dialogue: 0,0:16:56.80,0:16:59.30,Default,,0,0,0,,(Mai) Hắn ngã rồi. Đừng lo, bình tĩnh đi.
Dialogue: 0,0:16:59.39,0:17:00.93,Default,,0,0,0,,(Chizuru) Các cổ vật...
Dialogue: 0,0:17:01.02,0:17:02.52,Default,,0,0,0,,(Chizuru) Hắn muốn... quay lại đó.
Dialogue: 0,0:17:02.60,0:17:05.02,Default,,0,0,0,,(Iori) Các cổ vật đã...
Dialogue: 0,0:17:05.10,0:17:06.14,Default,,0,0,0,,(Iori) Mau gọi cấp cứu đi.
Dialogue: 0,0:17:06.23,0:17:07.60,Default,,0,0,0,,(Mai) Chúng tôi cần một xe cấp cứu!
Dialogue: 0,0:17:07.69,0:17:09.23,Default,,0,0,0,,(Mai) Gọi 911 mau!
Dialogue: 0,0:17:22.70,0:17:24.91,Default,,0,0,0,,(Rugal) Iori!
Dialogue: 0,0:17:25.00,0:17:26.43,Default,,0,0,0,,(Rugal) Đi cùng ta đi.
Dialogue: 0,0:17:26.46,0:17:29.04,Default,,0,0,0,,Hãy nhớ những gì đang chờ đợi chúng ta ở bờ bên kia.
Dialogue: 0,0:17:29.13,0:17:32.55,Default,,0,0,0,,Tôi không đi, và cũng không để ông đi đâu.
Dialogue: 0,0:17:32.63,0:17:34.26,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:17:34.34,0:17:37.80,Default,,0,0,0,,Càng nhiều phần cho ta.
Dialogue: 0,0:17:53.98,0:17:56.40,Default,,0,0,0,,(Rugal) Chẳng phải sẽ rất mỉa mai nếu ta giết ngươi
Dialogue: 0,0:17:56.49,0:17:57.51,Default,,0,0,0,,ngay lúc này bằng chính thanh kiếm này sao?
Dialogue: 0,0:17:57.53,0:18:01.62,Default,,0,0,0,,(Terry) Giơ hai tay lên và bước ra ngoài mau!
Dialogue: 0,0:18:01.70,0:18:04.54,Default,,0,0,0,,(Rugal) Trời ạ...
Dialogue: 0,0:18:04.62,0:18:05.97,Default,,0,0,0,,(Đặc vụ 1) Nằm yên! Đặt hai tay lên đầu!
Dialogue: 0,0:18:06.00,0:18:07.21,Default,,0,0,0,,(Terry) Không, đuổi theo mau, đuổi theo!
Dialogue: 0,0:18:07.29,0:18:12.46,Default,,0,0,0,,Là tên kia kìa, là tên kia!
Dialogue: 0,0:18:30.48,0:18:36.78,Default,,0,0,0,,(Rugal) Cảm ơn bài học nhé, Chizuru.
Dialogue: 0,0:18:36.86,0:18:38.61,Default,,0,0,0,,(Đặc vụ 1) Không còn đường thoát đâu. Hắn bị dồn vào chân tường rồi.
Dialogue: 0,0:18:38.70,0:18:40.66,Default,,0,0,0,,(Terry) Được rồi, ở đó có cửa sổ nào không?
Dialogue: 0,0:18:40.74,0:18:42.87,Default,,0,0,0,,(Terry) Chờ đã! Lùi lại! Lùi lại ngay!
Dialogue: 0,0:18:42.95,0:18:44.58,Default,,0,0,0,,(Iori) Các người đang để hắn tẩu thoát đấy!
Dialogue: 0,0:18:44.66,0:18:45.89,Default,,0,0,0,,Để tôi vào trong đó trước khi quá muộn.
Dialogue: 0,0:18:45.91,0:18:51.62,Default,,0,0,0,,(Terry) Lùi lại!
Dialogue: 0,0:18:51.71,0:18:53.63,Default,,0,0,0,,(Iori) Rugal... dừng lại!
Dialogue: 0,0:18:53.71,0:18:58.42,Default,,0,0,0,,(Terry) Nằm sấp xuống sàn!
Dialogue: 0,0:18:58.51,0:19:06.51,Default,,0,0,0,,(Terry) Cái quái gì vừa xảy ra thế?
Dialogue: 0,0:19:08.10,0:19:15.57,Default,,0,0,0,,(Iori) Hắn không lấy thanh kiếm.
Dialogue: 0,0:19:15.65,0:19:17.28,Default,,0,0,0,,(Chizuru) Thanh kiếm đó là đồ giả.
Dialogue: 0,0:19:17.36,0:19:18.19,Default,,0,0,0,,(Mai) Sao cơ?
Dialogue: 0,0:19:18.28,0:19:20.53,Default,,0,0,0,,Rugal đang quay trở lại trong đó.
Dialogue: 0,0:19:20.61,0:19:23.70,Default,,0,0,0,,Mọi người sẽ mất mạng nếu không tìm ra thanh kiếm thật.
Dialogue: 0,0:19:23.78,0:19:25.78,Default,,0,0,0,,Chizuru, đó chỉ là một trò chơi thôi mà.
Dialogue: 0,0:19:25.87,0:19:29.62,Default,,0,0,0,,Không hề, nếu có kẻ quy phục Orochi.
Dialogue: 0,0:19:29.71,0:19:33.54,Default,,0,0,0,,Nó sẽ... biến thành một trận quyết đấu sinh tử.
Dialogue: 0,0:19:33.63,0:19:35.52,Default,,0,0,0,,Hãy tìm Saisyu Kusanagi.
Dialogue: 0,0:19:35.54,0:19:38.48,Default,,0,0,0,,Khi tìm được ông ấy, cô sẽ tìm thấy thanh kiếm thật.
Dialogue: 0,0:19:38.51,0:19:41.84,Default,,0,0,0,,(Chizuru) Không có Thảo Thế Kiếm thật, Rugal không thể
Dialogue: 0,0:19:41.93,0:19:45.30,Default,,0,0,0,,giải phóng Orochi, và nếu hắn làm được, không ai cản nổi hắn đâu.
Dialogue: 0,0:19:45.39,0:19:46.39,Default,,0,0,0,,(Mai) Tôi sẽ báo cho Iori biết.
Dialogue: 0,0:19:46.43,0:19:48.93,Default,,0,0,0,,(Chizuru) Không, không được. Nguy hiểm lắm.
Dialogue: 0,0:19:49.02,0:19:50.68,Default,,0,0,0,,Iori không được can dự vào chuyện này.
Dialogue: 0,0:19:50.77,0:19:52.50,Default,,0,0,0,,Cô phải đi một mình.
Dialogue: 0,0:19:52.52,0:19:54.52,Default,,0,0,0,,Tôi ư? Chizuru, tôi không...
Dialogue: 0,0:19:54.61,0:19:58.57,Default,,0,0,0,,Tôi biết cô là ai. Iori tuyệt đối không được dính líu vào.
Dialogue: 0,0:19:58.65,0:20:00.48,Default,,0,0,0,,Cô phải tin tôi.
Dialogue: 0,0:20:00.57,0:20:03.53,Default,,0,0,0,,Làm ơn.
Dialogue: 0,0:20:16.46,0:20:18.09,Default,,0,0,0,,Xin lỗi. Xin chào.
Dialogue: 0,0:20:18.17,0:20:19.61,Default,,0,0,0,,Tôi nghe nói ở đây có một bệnh nhân
Dialogue: 0,0:20:19.67,0:20:23.34,Default,,0,0,0,,tên là Saisyu Kusanagi. Tôi muốn nói chuyện với ông ấy.
Dialogue: 0,0:20:23.43,0:20:25.22,Default,,0,0,0,,(Berta) Cô muốn nói chuyện với Saisyu Kusanagi ư?
Dialogue: 0,0:20:25.30,0:20:27.05,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:20:27.14,0:20:33.43,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:20:39.86,0:20:42.19,Default,,0,0,0,,(Berta) Ông Kusanagi... không hề phản ứng với ai
Dialogue: 0,0:20:42.28,0:20:44.24,Default,,0,0,0,,suốt gần 10 năm nay rồi.
Dialogue: 0,0:20:44.32,0:20:47.57,Default,,0,0,0,,Ông ấy ăn, đi dạo, đi ngủ,
Dialogue: 0,0:20:47.66,0:20:49.83,Default,,0,0,0,,nhưng điều cuối cùng ông ấy làm là nói chuyện.
Dialogue: 0,0:20:49.91,0:20:53.58,Default,,0,0,0,,Ông ấy sống trong thế giới cô độc của riêng mình.
Dialogue: 0,0:21:06.68,0:21:09.35,Default,,0,0,0,,Chúc cô nói chuyện vui vẻ.
Dialogue: 0,0:21:09.43,0:21:17.43,Default,,0,0,0,,(Mai) Cảm ơn cô.
Dialogue: 0,0:21:19.11,0:21:23.28,Default,,0,0,0,,Ông Kusanagi?
Dialogue: 0,0:21:44.76,0:21:51.60,Default,,0,0,0,,(Mai) Ông Kusanagi? (Thở dài)
Dialogue: 0,0:21:51.68,0:21:58.52,Default,,0,0,0,,Trời ạ... giờ phải làm sao đây?
Dialogue: 0,0:22:11.95,0:22:14.37,Default,,0,0,0,,(Kyo) Tôi có thể giúp gì cho cô?
Dialogue: 0,0:22:14.45,0:22:18.87,Default,,0,0,0,,Tôi là Mai... Mai Shiranui.
Dialogue: 0,0:22:18.96,0:22:21.25,Default,,0,0,0,,Tôi đến đây để tìm ông Kusanagi, nhưng tôi
Dialogue: 0,0:22:21.34,0:22:23.96,Default,,0,0,0,,không biết tình trạng của ông ấy lại như thế này.
Dialogue: 0,0:22:24.05,0:22:27.38,Default,,0,0,0,,Tôi là con trai ông ấy, Kyo Kusanagi.
Dialogue: 0,0:22:27.47,0:22:31.09,Default,,0,0,0,,Con trai ông ấy ư?
Dialogue: 0,0:22:31.18,0:22:34.43,Default,,0,0,0,,Tôi không... không ngờ tới. À...
Dialogue: 0,0:22:34.51,0:22:36.85,Default,,0,0,0,,Chizuru phái tôi đến, và...
Dialogue: 0,0:22:36.93,0:22:40.44,Default,,0,0,0,,chị ấy bị thương trong một trận đấu, nên tôi đến thay,
Dialogue: 0,0:22:40.52,0:22:42.25,Default,,0,0,0,,hai món cổ vật đã bị đánh cắp, và...
Dialogue: 0,0:22:42.27,0:22:43.19,Default,,0,0,0,,Khoan, khoan đã, dừng lại chút.
Dialogue: 0,0:22:43.27,0:22:45.02,Default,,0,0,0,,Ai phái cô tới?
Dialogue: 0,0:22:45.11,0:22:48.44,Default,,0,0,0,,Chizuru.
Dialogue: 0,0:22:48.53,0:22:51.24,Default,,0,0,0,,Kagura ư?
Dialogue: 0,0:22:51.32,0:22:53.12,Default,,0,0,0,,Chắc anh phải biết chị ấy chứ.
Dialogue: 0,0:22:53.20,0:22:55.24,Default,,0,0,0,,Không, tôi... tôi không biết.
Dialogue: 0,0:22:55.33,0:22:56.79,Default,,0,0,0,,Tôi rất tiếc vì cô ấy bị thương
Dialogue: 0,0:22:56.87,0:22:59.12,Default,,0,0,0,,và các cổ vật của cô bị đánh cắp,
Dialogue: 0,0:22:59.21,0:23:04.59,Default,,0,0,0,,nhưng tôi chẳng hiểu cô đang nói về chuyện gì cả.
Dialogue: 0,0:23:04.67,0:23:06.09,Default,,0,0,0,,Nhưng anh là con trai của Saisyu mà.
Dialogue: 0,0:23:06.17,0:23:10.09,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:23:10.18,0:23:18.18,Default,,0,0,0,,Nếu cô không phiền, đã đến lúc cha tôi cần nghỉ ngơi rồi.
Dialogue: 0,0:23:18.64,0:23:26.07,Default,,0,0,0,,(Mai) Tất nhiên rồi.
Dialogue: 0,0:23:26.15,0:23:33.24,Default,,0,0,0,,Nào cha, đến giờ nằm nghỉ rồi.
Dialogue: 0,0:24:21.54,0:24:24.21,Default,,0,0,0,,(Kyo) Cái thiện cao nhất giống như nước.
Dialogue: 0,0:24:24.29,0:24:25.96,Default,,0,0,0,,Nước khéo làm lợi cho vạn vật
Dialogue: 0,0:24:26.04,0:24:28.04,Default,,0,0,0,,mà không tranh giành cùng ai.
Dialogue: 0,0:24:28.13,0:24:30.80,Default,,0,0,0,,Nó ở những nơi mọi người đều ghét bỏ.
Dialogue: 0,0:24:30.88,0:24:34.76,Default,,0,0,0,,Bởi vậy, nó ở gần với Đạo.
Dialogue: 0,0:24:34.84,0:24:36.43,Default,,0,0,0,,Khi chọn chỗ ở,
Dialogue: 0,0:24:36.51,0:24:38.35,Default,,0,0,0,,khéo giữ cho sát đất.
Dialogue: 0,0:24:38.43,0:24:39.97,Default,,0,0,0,,Khi tu dưỡng tâm hồn,
Dialogue: 0,0:24:40.06,0:24:45.02,Default,,0,0,0,,khéo lặn sâu vào cõi tĩnh mịch u huyền.
Dialogue: 0,0:24:53.36,0:24:56.45,Default,,0,0,0,,(Saisyu) Tốt lắm.
Dialogue: 0,0:24:56.53,0:25:02.45,Default,,0,0,0,,(Kyo) Nhào nặn đất sét để làm đồ gốm.
Dialogue: 0,0:25:02.54,0:25:03.97,Default,,0,0,0,,Nhờ khoảng trống không bên trong đồ vật
Dialogue: 0,0:25:04.00,0:25:06.37,Default,,0,0,0,,mà nó mới trở nên hữu dụng.
Dialogue: 0,0:25:06.46,0:25:08.54,Default,,0,0,0,,Đục trổ cửa cái cùng cửa sổ để làm nên gian phòng,
Dialogue: 0,0:25:08.63,0:25:11.96,Default,,0,0,0,,nhưng chính khoảng trống không đó mới làm gian phòng thành chỗ ở được.
Dialogue: 0,0:25:12.05,0:25:14.72,Default,,0,0,0,,Bởi vậy, cái Hữu (hiện hữu) lấy đó làm lợi ích,
Dialogue: 0,0:25:14.80,0:25:18.51,Default,,0,0,0,,nhưng cái Vô (trống rỗng) mới làm nên công dụng.
Dialogue: 0,0:25:18.60,0:25:23.68,Default,,0,0,0,,(Tiếng chim hót)
Dialogue: 0,0:25:53.34,0:25:55.57,Default,,0,0,0,,Mai.
Dialogue: 0,0:25:55.59,0:25:56.88,Default,,0,0,0,,Iori!
Dialogue: 0,0:25:56.97,0:25:58.09,Default,,0,0,0,,Anh làm em giật cả mình.
Dialogue: 0,0:25:58.18,0:25:59.26,Default,,0,0,0,,Em đã ở đâu vậy?
Dialogue: 0,0:25:59.34,0:26:00.59,Default,,0,0,0,,Anh đã lo lắng cho em biết bao.
Dialogue: 0,0:26:00.68,0:26:02.14,Default,,0,0,0,,Em không cố ý làm anh lo đâu.
Dialogue: 0,0:26:02.22,0:26:03.95,Default,,0,0,0,,(Iori) Sao em không nói với anh là em đi đâu?
Dialogue: 0,0:26:03.97,0:26:06.27,Default,,0,0,0,,Ý anh là, em cứ thế biến mất tăm.
Dialogue: 0,0:26:06.35,0:26:07.62,Default,,0,0,0,,Ơ, anh không nói chuyện với Chizuru sao?
Dialogue: 0,0:26:07.64,0:26:09.69,Default,,0,0,0,,(Iori) Anh không nói chuyện với Chizuru.
Dialogue: 0,0:26:09.77,0:26:12.48,Default,,0,0,0,,Em xin lỗi, em cứ tưởng anh đã biết rồi.
Dialogue: 0,0:26:12.57,0:26:15.99,Default,,0,0,0,,Chị ấy phái em đi. Chị ấy nói... đại loại là...
Dialogue: 0,0:26:16.07,0:26:18.24,Default,,0,0,0,,một cổ vật đã bị mất tích, và...
Dialogue: 0,0:26:18.32,0:26:21.87,Default,,0,0,0,,và em phải đến đây tìm... tìm một người tên là Kusanagi,
Dialogue: 0,0:26:21.95,0:26:23.62,Default,,0,0,0,,rằng em sẽ giúp được cho anh, và...
Dialogue: 0,0:26:23.70,0:26:27.71,Default,,0,0,0,,Ôi, em mừng quá vì được gặp lại anh.
Dialogue: 0,0:26:27.79,0:26:30.25,Default,,0,0,0,,Nghe anh này, em chẳng biết mình đang
Dialogue: 0,0:26:30.33,0:26:32.59,Default,,0,0,0,,dính líu vào chuyện gì đâu.
Dialogue: 0,0:26:32.67,0:26:35.96,Default,,0,0,0,,Được rồi, chẳng có ích gì khi ở lại đây cả.
Dialogue: 0,0:26:36.05,0:26:38.67,Default,,0,0,0,,Đi thôi em.
Dialogue: 0,0:26:38.76,0:26:40.55,Default,,0,0,0,,Ông ấy có một người con trai.
Dialogue: 0,0:26:48.23,0:26:56.23,Default,,0,0,0,,Kyo, anh có khách này.
Dialogue: 0,0:26:56.53,0:26:58.86,Default,,0,0,0,,(Kyo) Lại chuyện gì nữa đây?
Dialogue: 0,0:26:58.95,0:27:00.51,Default,,0,0,0,,(Mai) Tôi hy vọng có thể nói chuyện với anh.
Dialogue: 0,0:27:00.53,0:27:02.62,Default,,0,0,0,,(Kyo) Tôi chẳng biết gì hết.
Dialogue: 0,0:27:02.70,0:27:10.04,Default,,0,0,0,,Tôi biết, nhưng chuyện này hệ trọng lắm.
Dialogue: 0,0:27:10.12,0:27:15.67,Default,,0,0,0,,Bạn cô là ai thế?
Dialogue: 0,0:27:15.75,0:27:18.26,Default,,0,0,0,,Iori Yagami.
Dialogue: 0,0:27:18.34,0:27:19.57,Default,,0,0,0,,Như tôi đã nói lúc nãy...
Dialogue: 0,0:27:19.59,0:27:21.30,Default,,0,0,0,,nếu cô muốn nói chuyện, cứ để lại số điện thoại,
Dialogue: 0,0:27:21.38,0:27:23.05,Default,,0,0,0,,rồi tôi sẽ gọi lại sau.
Dialogue: 0,0:27:23.14,0:27:26.01,Default,,0,0,0,,(Saisyu) Là ngươi ư?
Dialogue: 0,0:27:26.10,0:27:27.60,Default,,0,0,0,,Saisyu.
Dialogue: 0,0:27:27.68,0:27:32.06,Default,,0,0,0,,Ngươi... (Iori) Saisyu, xin hãy tha thứ cho tôi.
Dialogue: 0,0:27:32.15,0:27:34.23,Default,,0,0,0,,(Saisyu) Ta sẽ giết ngươi!
Dialogue: 0,0:27:34.31,0:27:36.44,Default,,0,0,0,,(Iori) Tôi xin lỗi! Xin hãy tha thứ cho tôi!
Dialogue: 0,0:27:36.52,0:27:37.84,Default,,0,0,0,,(Saisyu) Ngươi có nghe thấy không? Ta sẽ giết ngươi!
Dialogue: 0,0:27:37.86,0:27:39.74,Default,,0,0,0,,(Iori) Saisyu!
Dialogue: 0,0:27:39.82,0:27:43.41,Default,,0,0,0,,(Kyo) Không sao đâu mà. Bình tĩnh lại đi cha. Cha ơi!
Dialogue: 0,0:27:43.49,0:27:51.49,Default,,0,0,0,,(Kyo) Cha... (Saisyu) Kyo...
Dialogue: 0,0:27:52.46,0:27:57.21,Default,,0,0,0,,(Saisyu)... con trai của ta... (Kyo) Cha?
Dialogue: 0,0:27:57.30,0:27:59.63,Default,,0,0,0,,(Tiếng máy đo điện tử kêu vang)
Dialogue: 0,0:27:59.71,0:28:06.26,Default,,0,0,0,,(Berta) Báo động khẩn! Cấp cứu khẩn cấp! Đưa xe trợ tim lại đây ngay, khẩn trương!
Dialogue: 0,0:28:06.35,0:28:08.41,Default,,0,0,0,,(Scott) Tôi đã đình chỉ giải đấu theo đúng chỉ thị của cô.
Dialogue: 0,0:28:08.43,0:28:10.16,Default,,0,0,0,,Và anh đã gửi cảnh báo đến toàn bộ các đấu sĩ chưa?
Dialogue: 0,0:28:10.18,0:28:11.39,Default,,0,0,0,,Rồi.
Dialogue: 0,0:28:11.48,0:28:12.14,Default,,0,0,0,,Rất tốt.
Dialogue: 0,0:28:12.23,0:28:14.98,Default,,0,0,0,,(Scott) Ngoại trừ... có một quyền can thiệp hệ thống.
Dialogue: 0,0:28:15.06,0:28:16.31,Default,,0,0,0,,Từ ai?
Dialogue: 0,0:28:16.40,0:28:17.56,Default,,0,0,0,,(Scott) Rugal.
Dialogue: 0,0:28:17.65,0:28:18.90,Default,,0,0,0,,Khốn kiếp.
Dialogue: 0,0:28:18.98,0:28:20.78,Default,,0,0,0,,Hắn đang cố giành quyền kiểm soát giải đấu,
Dialogue: 0,0:28:20.82,0:28:22.15,Default,,0,0,0,,nhưng bằng cách nào chứ?
Dialogue: 0,0:28:22.20,0:28:24.74,Default,,0,0,0,,Thực ra chuyện này cực kỳ đáng kinh ngạc.
Dialogue: 0,0:28:24.82,0:28:27.12,Default,,0,0,0,,Bằng cách nào đó, Rugal có thể chiếm quyền điều khiển danh sách thi đấu
Dialogue: 0,0:28:27.20,0:28:29.41,Default,,0,0,0,,ngay từ bên trong chiều không gian khác.
Dialogue: 0,0:28:29.49,0:28:32.00,Default,,0,0,0,,Hắn đang thách đấu tất cả mọi người.
Dialogue: 0,0:28:32.08,0:28:32.54,Default,,0,0,0,,(Chizuru) Họ không hề biết mình đang chơi đùa
Dialogue: 0,0:28:32.62,0:28:34.71,Default,,0,0,0,,với chính sinh mạng của mình.
Dialogue: 0,0:29:02.74,0:29:06.74,Default,,0,0,0,,(Mature) Vậy là giờ chỉ còn hai ta.
Dialogue: 0,0:29:36.31,0:29:37.52,Default,,0,0,0,,(Vice) Đến lượt tôi rồi.
Dialogue: 0,0:29:37.60,0:29:39.27,Default,,0,0,0,,(Mature) Nhưng cô còn nhớ tin nhắn chúng ta nhận được không?
Dialogue: 0,0:29:39.36,0:29:40.75,Default,,0,0,0,,Không ai được chấp nhận lời thách đấu trừ khi
Dialogue: 0,0:29:40.77,0:29:46.78,Default,,0,0,0,,đích thân Chizuru cho phép.
Dialogue: 0,0:29:46.86,0:29:48.32,Default,,0,0,0,,Cả hai chúng ta cùng vào ư?
Dialogue: 0,0:29:48.41,0:29:49.47,Default,,0,0,0,,Tôi chưa từng nghe thấy hai đấu sĩ
Dialogue: 0,0:29:49.49,0:29:51.16,Default,,0,0,0,,cùng bước vào một lúc bao giờ.
Dialogue: 0,0:29:51.24,0:29:53.20,Default,,0,0,0,,Chà, đây có thể là cơ hội của chúng ta, hai chọi một.
Dialogue: 0,0:29:53.29,0:29:55.58,Default,,0,0,0,,Liệu có thể có hai King of Fighters không nhỉ?
Dialogue: 0,0:29:55.62,0:30:02.13,Default,,0,0,0,,Chuyện gì cũng có lần đầu tiên mà.
Dialogue: 0,0:30:02.21,0:30:04.76,Default,,0,0,0,,(Vice) Khoan đã, chuyện gì xảy ra thế này?
Dialogue: 0,0:30:04.84,0:30:11.43,Default,,0,0,0,,(Mature) Tôi không biết. Có gì đó không ổn rồi.
Dialogue: 0,0:30:19.94,0:30:21.94,Default,,0,0,0,,Vice và Mature.
Dialogue: 0,0:30:22.02,0:30:23.14,Default,,0,0,0,,Ta biết hai cô em sẽ có...
Dialogue: 0,0:30:23.19,0:30:25.32,Default,,0,0,0,,đủ dũng khí để chấp nhận lời thách đấu của ta.
Dialogue: 0,0:30:25.40,0:30:26.61,Default,,0,0,0,,(Vice) Ngươi là ai?
Dialogue: 0,0:30:26.69,0:30:30.78,Default,,0,0,0,,(Rugal) Ta là ai ư? Ồ, ha ha...
Dialogue: 0,0:30:30.87,0:30:38.87,Default,,0,0,0,,Ta chính là King of Fighters! Rugal!
Dialogue: 0,0:30:39.58,0:30:41.71,Default,,0,0,0,,Coi chừng đấy, ta tới đây, các quý cô.
Dialogue: 0,0:30:41.79,0:30:44.34,Default,,0,0,0,,Chào mừng đến với phiên bản giải đấu của Rugal.
Dialogue: 0,0:30:44.46,0:30:46.26,Default,,0,0,0,,Tại đấu trường này, ta đặt ra mọi luật lệ.
Dialogue: 0,0:30:46.34,0:30:47.73,Default,,0,0,0,,(Mature) Ngươi không có quyền thay đổi luật.
Dialogue: 0,0:30:47.76,0:30:51.18,Default,,0,0,0,,Ta có thể đổi luật, ta có thể đổi cả bối cảnh đấu trường.
Dialogue: 0,0:30:51.26,0:30:51.72,Default,,0,0,0,,Ta có thể làm bất cứ điều gì ta muốn.
Dialogue: 0,0:30:51.80,0:30:55.56,Default,,0,0,0,,Thử nếm mùi một chút nhé, các quý cô?
Dialogue: 0,0:30:55.64,0:30:58.64,Default,,0,0,0,,(Người dẫn) Chào mừng đến với Đấu trường Rugal Bernstein!
Dialogue: 0,0:30:58.73,0:31:00.98,Default,,0,0,0,,Hôm nay, chúng ta có một màn so tài đặc biệt,
Dialogue: 0,0:31:01.06,0:31:02.52,Default,,0,0,0,,một trận hai chọi một.
Dialogue: 0,0:31:02.61,0:31:07.40,Default,,0,0,0,,Rugal Bernstein đối đầu Vice và Mature!
Dialogue: 0,0:31:07.49,0:31:10.95,Default,,0,0,0,,(Người dẫn) Ồ, Rugal đã hất cô ta vào vách tường.
Dialogue: 0,0:31:11.03,0:31:15.24,Default,,0,0,0,,Vice đã tháo găng tay, cô ấy sẵn sàng tử chiến.
Dialogue: 0,0:31:15.33,0:31:17.66,Default,,0,0,0,,Rugal dũng mãnh tung đòn gậy bóng chày tầm cao vào Vice.
Dialogue: 0,0:31:17.75,0:31:22.29,Default,,0,0,0,,Ồ, cú đó chắc chắn để lại vết thương nặng!
Dialogue: 0,0:31:22.38,0:31:25.79,Default,,0,0,0,,Vice và Mature đang liên tục chịu đòn dồn dập.
Dialogue: 0,0:31:25.88,0:31:32.53,Default,,0,0,0,,Ôi!
Dialogue: 0,0:31:32.55,0:31:37.93,Default,,0,0,0,,(Rugal) Đủ rồi đấy!
Dialogue: 0,0:31:38.02,0:31:42.14,Default,,0,0,0,,(Rugal) Hú!
Dialogue: 0,0:31:42.23,0:31:44.65,Default,,0,0,0,,Không ăn thua rồi.
Dialogue: 0,0:31:44.73,0:31:46.36,Default,,0,0,0,,Chúng ta đang đến đâu rồi nhỉ?
Dialogue: 0,0:31:46.44,0:31:48.57,Default,,0,0,0,,À, phải rồi. Đấu tiếp nào.
Dialogue: 0,0:32:10.59,0:32:15.84,Default,,0,0,0,,(Rugal) A... Cú đó ra trò đấy.
Dialogue: 0,0:32:15.93,0:32:23.93,Default,,0,0,0,,(Rugal) Lại đây nào.
Dialogue: 0,0:32:31.65,0:32:33.49,Default,,0,0,0,,(Rugal) Nào, nhảy múa cùng ta.
Dialogue: 0,0:32:33.57,0:32:35.91,Default,,0,0,0,,(Vice) Dừng lại, đừng! Ngươi thắng rồi!
Dialogue: 0,0:32:35.99,0:32:37.57,Default,,0,0,0,,(Rugal) Hai cô em chẳng biết đùa gì cả.
Dialogue: 0,0:32:37.66,0:32:39.16,Default,,0,0,0,,Hai cô gái, một người đàn ông ư?
Dialogue: 0,0:32:39.24,0:32:41.54,Default,,0,0,0,,Đó phải là giấc mơ của mọi gã đàn ông chứ.
Dialogue: 0,0:32:41.62,0:32:42.96,Default,,0,0,0,,Sao ngươi không lấy huy hiệu đi?
Dialogue: 0,0:32:43.04,0:32:44.58,Default,,0,0,0,,Các cô nghĩ đây là trò chơi con nít à?
Dialogue: 0,0:32:44.67,0:32:45.83,Default,,0,0,0,,Ta có thể giết chết các cô!
Dialogue: 0,0:32:45.92,0:32:48.00,Default,,0,0,0,,Các cô có muốn ta giết không?
Dialogue: 0,0:32:52.67,0:32:53.84,Default,,0,0,0,,Không... xin đừng!
Dialogue: 0,0:32:53.93,0:32:56.18,Default,,0,0,0,,Tôi sẽ làm bất cứ điều gì!
Dialogue: 0,0:32:56.26,0:32:57.72,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:32:57.80,0:32:59.47,Default,,0,0,0,,Cô sẵn sàng làm gì cho ta?
Dialogue: 0,0:32:59.56,0:33:04.39,Default,,0,0,0,,(Vice) Bất cứ điều gì cũng được.
Dialogue: 0,0:33:04.48,0:33:06.48,Default,,0,0,0,,(Mature) Không...
Dialogue: 0,0:33:17.57,0:33:20.62,Default,,0,0,0,,Ngươi đã làm gì cô ấy?
Dialogue: 0,0:33:20.70,0:33:22.66,Default,,0,0,0,,Cứ coi như cô ta đã bị trói buộc linh hồn,
Dialogue: 0,0:33:22.75,0:33:25.21,Default,,0,0,0,,còn cô thì đang chịu sự chi phối của hợp đồng.
Dialogue: 0,0:33:25.29,0:33:27.62,Default,,0,0,0,,Giờ thì các cô có việc phải làm rồi đấy.
Dialogue: 0,0:33:27.71,0:33:31.80,Default,,0,0,0,,Chào mừng đến với Tập đoàn Rugal.
Dialogue: 0,0:33:35.80,0:33:38.14,Default,,0,0,0,,Ramon ư? Vice đây.
Dialogue: 0,0:33:38.22,0:33:40.61,Default,,0,0,0,,Ừ, tôi vừa rời khỏi giải đấu.
Dialogue: 0,0:33:40.64,0:33:42.57,Default,,0,0,0,,Tôi biết, nhưng mọi chuyện vẫn ổn mà.
Dialogue: 0,0:33:42.60,0:33:44.89,Default,,0,0,0,,Rugal đã nâng cấp lối chơi rồi.
Dialogue: 0,0:33:44.98,0:33:46.31,Default,,0,0,0,,Hắn sắp sửa gọi cho anh tiếp theo đấy.
Dialogue: 0,0:33:46.39,0:33:47.64,Default,,0,0,0,,Anh nhất định phải tham gia nhé...
Dialogue: 0,0:33:47.73,0:33:49.37,Default,,0,0,0,,Này Shermie, chỉ báo cho cô biết là cô hoàn toàn có thể
Dialogue: 0,0:33:49.40,0:33:50.69,Default,,0,0,0,,nhận các lời thách đấu đó.
Dialogue: 0,0:33:50.77,0:33:52.40,Default,,0,0,0,,Ý tôi là, tôi có thua thật, nhưng vui lắm.
Dialogue: 0,0:33:52.53,0:33:55.82,Default,,0,0,0,,Tin tôi đi, Duo Lon, an toàn lắm mà.
Dialogue: 0,0:34:43.41,0:34:43.87,Default,,0,0,0,,(Vice) Không!
Dialogue: 0,0:34:43.95,0:34:44.95,Default,,0,0,0,,Không!
Dialogue: 0,0:34:44.99,0:34:49.71,Default,,0,0,0,,Tránh xa tôi ra!
Dialogue: 0,0:34:54.17,0:34:56.13,Default,,0,0,0,,(Terry) Terry Bogard... CIA đây.
Dialogue: 0,0:34:56.21,0:34:58.84,Default,,0,0,0,,(Scott) Cảm ơn anh đã xem qua...
Dialogue: 0,0:34:58.93,0:35:00.84,Default,,0,0,0,,trang blog của tôi, nhưng tôi phải đi rồi.
Dialogue: 0,0:35:00.93,0:35:02.47,Default,,0,0,0,,Không vội thế được đâu, siêu mọt sách.
Dialogue: 0,0:35:02.55,0:35:04.14,Default,,0,0,0,,Tôi cần vài câu trả lời.
Dialogue: 0,0:35:04.22,0:35:07.58,Default,,0,0,0,,(Terry) Đưa cái này cho tôi.
Dialogue: 0,0:35:07.60,0:35:09.32,Default,,0,0,0,,(Chizuru) Scott, đưa máy tính cho anh Bogard đi.
Dialogue: 0,0:35:09.35,0:35:17.07,Default,,0,0,0,,(Terry) Đúng đấy, Scott.
Dialogue: 0,0:35:17.15,0:35:18.15,Default,,0,0,0,,Gõ mật khẩu vào đi.
Dialogue: 0,0:35:18.19,0:35:19.19,Default,,0,0,0,,Không.
Dialogue: 0,0:35:19.24,0:35:21.01,Default,,0,0,0,,Scott... có một buồng giam ở Guantanamo đang ghi sẵn tên cậu đấy.
Dialogue: 0,0:35:21.03,0:35:22.03,Default,,0,0,0,,Gõ mật khẩu vào mau.
Dialogue: 0,0:35:22.07,0:35:25.28,Default,,0,0,0,,Giờ CIA đâu còn được phép làm trò đó nữa.
Dialogue: 0,0:35:25.37,0:35:31.29,Default,,0,0,0,,Ừ, tôi biết. Tệ thật đấy.
Dialogue: 0,0:35:40.72,0:35:41.57,Default,,0,0,0,,Cô muốn giải thích cho tôi về chuyện này không?
Dialogue: 0,0:35:41.59,0:35:42.82,Default,,0,0,0,,Chờ chút, làm sao anh làm được thế?
Dialogue: 0,0:35:42.84,0:35:44.76,Default,,0,0,0,,Tôi là CIA mà.
Dialogue: 0,0:35:44.85,0:35:47.51,Default,,0,0,0,,Chính anh là người đã cho người giám sát tôi.
Dialogue: 0,0:35:47.60,0:35:48.62,Default,,0,0,0,,Đó là tài liệu mật.
Dialogue: 0,0:35:48.64,0:35:50.73,Default,,0,0,0,,Và là kẻ đã thất bại trong việc ngăn chặn Rugal?
Dialogue: 0,0:35:50.81,0:35:52.04,Default,,0,0,0,,Thực ra, bọn tôi đã ngăn hắn cướp mất
Dialogue: 0,0:35:52.06,0:35:54.48,Default,,0,0,0,,Thảo Thế Kiếm của cô đấy, cảm ơn nhiều nhé.
Dialogue: 0,0:35:54.56,0:35:57.44,Default,,0,0,0,,Tiếc là thanh kiếm đó chỉ là đồ giả. Cố gắng tốt đấy.
Dialogue: 0,0:35:57.53,0:36:00.61,Default,,0,0,0,,Nghe này, tên đó là một kẻ giết người, hắn đang nhởn nhơ ngoài kia.
Dialogue: 0,0:36:00.70,0:36:02.24,Default,,0,0,0,,Tôi chỉ muốn biết hắn đang ở đâu.
Dialogue: 0,0:36:02.32,0:36:04.70,Default,,0,0,0,,Phức tạp lắm.
Dialogue: 0,0:36:04.78,0:36:06.49,Default,,0,0,0,,Để tôi đoán nhé, hắn đang trốn trong
Dialogue: 0,0:36:06.58,0:36:08.70,Default,,0,0,0,,cái giải đấu ngầm bí mật tí hon của cô chứ gì.
Dialogue: 0,0:36:08.79,0:36:11.71,Default,,0,0,0,,Thấy chưa, đúng rồi nhé. Tôi biết tỏng rồi.
Dialogue: 0,0:36:11.79,0:36:15.29,Default,,0,0,0,,Vậy sao? Thế thì tại sao anh lại cần đến tôi?
Dialogue: 0,0:36:15.38,0:36:19.59,Default,,0,0,0,,Bởi vì tôi không biết nó diễn ra ở đâu.
Dialogue: 0,0:36:19.67,0:36:23.01,Default,,0,0,0,,Vậy rốt cuộc nó ở đâu?
Dialogue: 0,0:36:23.09,0:36:25.47,Default,,0,0,0,,Giải đấu diễn ra ở một chiều không gian khác.
Dialogue: 0,0:36:25.55,0:36:27.60,Default,,0,0,0,,Đừng có lừa tôi bằng ba cái trò nhảm nhí về chiều không gian khác.
Dialogue: 0,0:36:27.68,0:36:29.81,Default,,0,0,0,,Thực ra... lý thuyết dây ủng hộ giả thuyết
Dialogue: 0,0:36:29.89,0:36:30.91,Default,,0,0,0,,về việc có tới hơn 10 hoặc 11 chiều không gian khác nhau...
Dialogue: 0,0:36:30.93,0:36:32.68,Default,,0,0,0,,cùng tồn tại trong cùng một không-thời gian...
Dialogue: 0,0:36:32.77,0:36:34.94,Default,,0,0,0,,với thế giới này.
Dialogue: 0,0:36:35.02,0:36:37.02,Default,,0,0,0,,Hồi bé cậu hay bị ăn đòn lắm đúng không?
Dialogue: 0,0:36:37.11,0:36:38.11,Default,,0,0,0,,Không hề.
Dialogue: 0,0:36:38.19,0:36:40.94,Default,,0,0,0,,Anh Bogard... tôi có thể kể cho anh tất cả những gì anh muốn biết...
Dialogue: 0,0:36:41.03,0:36:44.61,Default,,0,0,0,,nhưng điều đó không có nghĩa là anh sẽ tin tôi.
Dialogue: 0,0:36:44.70,0:36:50.24,Default,,0,0,0,,Đến nước này rồi thì cô cứ thử nói xem nào.
Dialogue: 0,0:36:50.33,0:36:53.41,Default,,0,0,0,,Rugal đang ẩn náu trong không gian giải đấu.
Dialogue: 0,0:36:53.50,0:36:55.75,Default,,0,0,0,,Hắn đã bị Orochi nuốt chửng linh hồn, và hắn đang cố
Dialogue: 0,0:36:55.83,0:36:58.67,Default,,0,0,0,,dụ dỗ các đấu sĩ vào đó để sát hại họ.
Dialogue: 0,0:36:58.75,0:37:00.84,Default,,0,0,0,,Được rồi... tại sao lại thế?
Dialogue: 0,0:37:00.96,0:37:02.67,Default,,0,0,0,,Để hắn có thể trở thành King of Fighters.
Dialogue: 0,0:37:02.76,0:37:05.47,Default,,0,0,0,,Chiều không gian khác, vua của những nàng tiên răng.
Dialogue: 0,0:37:05.55,0:37:07.34,Default,,0,0,0,,Nghe này, tôi được huấn luyện để tin vào những thứ hữu hình,
Dialogue: 0,0:37:07.43,0:37:09.60,Default,,0,0,0,,chứ không phải câu chuyện hoang đường cô đang bịa ra.
Dialogue: 0,0:37:09.68,0:37:10.93,Default,,0,0,0,,Người ta đang lần lượt bỏ mạng...
Dialogue: 0,0:37:11.02,0:37:13.48,Default,,0,0,0,,mà cô muốn tôi tin cô và những câu chuyện điên rồ này sao?
Dialogue: 0,0:37:13.56,0:37:17.06,Default,,0,0,0,,Không. Nhưng anh sẽ tin Mai chứ.
Dialogue: 0,0:37:17.15,0:37:18.36,Default,,0,0,0,,Mai là ai?
Dialogue: 0,0:37:18.44,0:37:20.52,Default,,0,0,0,,Điệp viên ngầm mà anh đã phái thâm nhập
Dialogue: 0,0:37:20.61,0:37:23.11,Default,,0,0,0,,vào tổ chức của chúng tôi một năm trước đấy.
Dialogue: 0,0:37:23.19,0:37:25.40,Default,,0,0,0,,Ồ, Mai đó à.
Dialogue: 0,0:37:25.49,0:37:27.36,Default,,0,0,0,,Cô ấy đang ở Seattle.
Dialogue: 0,0:37:27.45,0:37:29.01,Default,,0,0,0,,Nếu anh không tin tôi, hãy tới nói chuyện với cô ấy.
Dialogue: 0,0:37:29.03,0:37:31.79,Default,,0,0,0,,Cô ấy sẽ xác nhận tất cả những gì tôi vừa nói.
Dialogue: 0,0:37:43.97,0:37:46.26,Default,,0,0,0,,Em biết chúng ta đang lãng phí thời gian ở đây mà.
Dialogue: 0,0:37:46.34,0:37:47.88,Default,,0,0,0,,Chizuru phái em tới đây là có lý do.
Dialogue: 0,0:37:47.97,0:37:49.34,Default,,0,0,0,,Phải, là để tìm Saisyu.
Dialogue: 0,0:37:49.43,0:37:50.83,Default,,0,0,0,,Ông ấy chết rồi, đến lúc phải bước tiếp thôi.
Dialogue: 0,0:37:50.89,0:37:52.72,Default,,0,0,0,,Thế còn Kyo thì sao?
Dialogue: 0,0:37:52.81,0:37:54.64,Default,,0,0,0,,Kyo chỉ là đứa con lai.
Dialogue: 0,0:37:54.73,0:37:58.98,Default,,0,0,0,,Cậu ta không phải một Kusanagi thuần khiết.
Dialogue: 0,0:37:59.06,0:38:01.69,Default,,0,0,0,,Iori, rốt cuộc Orochi là thứ gì?
Dialogue: 0,0:38:01.77,0:38:04.63,Default,,0,0,0,,Thật đấy? Nó là thứ gì vậy?
Dialogue: 0,0:38:04.65,0:38:07.70,Default,,0,0,0,,Em không hiểu được đâu. Nó là tà niệm thuần túy.
Dialogue: 0,0:38:07.78,0:38:15.78,Default,,0,0,0,,Iori, anh phải học cách tin tưởng em đi chứ.
Dialogue: 0,0:38:15.96,0:38:19.29,Default,,0,0,0,,Nói thêm cho em biết đi.
Dialogue: 0,0:38:19.38,0:38:22.59,Default,,0,0,0,,Nó có thể ban cho ta sức mạnh to lớn phi thường,
Dialogue: 0,0:38:22.67,0:38:25.88,Default,,0,0,0,,thứ sức mạnh gây nghiện và mang tính hủy diệt tột cùng.
Dialogue: 0,0:38:25.97,0:38:31.68,Default,,0,0,0,,Dần dần, nó sẽ nuốt chửng tâm trí ta, và ta không bao giờ dứt ra được.
Dialogue: 0,0:38:31.76,0:38:39.62,Default,,0,0,0,,Đó là lý do anh bỏ đi sao?
Dialogue: 0,0:38:39.65,0:38:42.23,Default,,0,0,0,,Anh ấy đi đâu rồi?
Dialogue: 0,0:38:42.32,0:38:44.02,Default,,0,0,0,,(Kyo) Anh đã làm gì cha tôi?
Dialogue: 0,0:38:44.11,0:38:46.69,Default,,0,0,0,,(Mai) Kyo, anh ấy không làm gì cả.
Dialogue: 0,0:38:46.78,0:38:50.70,Default,,0,0,0,,Cha tôi nằm bất động không hề phản ứng suốt 10 năm qua,
Dialogue: 0,0:38:50.78,0:38:54.37,Default,,0,0,0,,vậy mà anh vừa bước vào, ông ấy liền tỉnh dậy và đòi giết anh.
Dialogue: 0,0:38:54.45,0:38:55.37,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:38:55.45,0:38:57.12,Default,,0,0,0,,Chuyện này bắt nguồn từ hai gia tộc chúng tôi.
Dialogue: 0,0:38:57.20,0:38:59.75,Default,,0,0,0,,Ông ấy là người nhà Kusanagi... còn tôi là người nhà Yagami.
Dialogue: 0,0:38:59.83,0:39:01.75,Default,,0,0,0,,Vậy thì cậu hiểu rồi đấy.
Dialogue: 0,0:39:01.83,0:39:04.59,Default,,0,0,0,,Chúng ta sinh ra đã định sẵn là kẻ thù của nhau.
Dialogue: 0,0:39:09.68,0:39:10.61,Default,,0,0,0,,Chuyện đó rốt cuộc là sao thế anh?
Dialogue: 0,0:39:10.63,0:39:12.84,Default,,0,0,0,,Cậu ta không giúp được gì cho chúng ta đâu, Mai.
Dialogue: 0,0:39:12.93,0:39:18.18,Default,,0,0,0,,Còn anh thì không chịu giúp. Em chẳng biết điều nào tệ hơn nữa.
Dialogue: 0,0:39:18.27,0:39:22.60,Default,,0,0,0,,Mai... Nghe này, để em nói chuyện với cậu ấy đã.
Dialogue: 0,0:39:22.69,0:39:29.61,Default,,0,0,0,,Cậu ấy chắc chắn phải biết điều gì đó. Em phải thử.
Dialogue: 0,0:39:41.04,0:39:43.63,Default,,0,0,0,,(Mai) Xe anh còn chỗ cho một người nữa không?
Dialogue: 0,0:39:43.71,0:39:48.00,Default,,0,0,0,,Tôi nghĩ tôi không đi cùng đường với cô đâu.
Dialogue: 0,0:39:48.09,0:39:50.01,Default,,0,0,0,,Nếu anh đang tìm kiếm câu trả lời,
Dialogue: 0,0:39:50.09,0:39:52.61,Default,,0,0,0,,tôi sẽ kể cho anh nghe tất cả những gì tôi biết, và
Dialogue: 0,0:39:52.64,0:39:59.43,Default,,0,0,0,,sau đó tôi sẽ để anh tự quyết định bước tiếp theo. Công bằng chứ?
Dialogue: 0,0:40:30.55,0:40:32.59,Default,,0,0,0,,(Kyo) Sao, cậu làm hỏng nó à?
Dialogue: 0,0:40:32.68,0:40:34.76,Default,,0,0,0,,(Mick) Tôi đâu có làm hỏng.
Dialogue: 0,0:40:34.84,0:40:36.51,Default,,0,0,0,,(Kyo) Thế thì nó bị làm sao?
Dialogue: 0,0:40:36.60,0:40:40.60,Default,,0,0,0,,(Mick) Nó hỏng thật, nhưng không phải do tôi làm.
Dialogue: 0,0:40:40.68,0:40:42.66,Default,,0,0,0,,(Mick) Ồ.
Dialogue: 0,0:40:42.69,0:40:44.81,Default,,0,0,0,,Chà.
Dialogue: 0,0:40:44.90,0:40:46.33,Default,,0,0,0,,Cô chắc hẳn là cô gái xinh đẹp nhất
Dialogue: 0,0:40:46.36,0:40:48.94,Default,,0,0,0,,mà Kyo từng dẫn về đây đấy.
Dialogue: 0,0:40:49.02,0:40:50.73,Default,,0,0,0,,Được rồi, lại đây nào, giúp tôi tìm xem
Dialogue: 0,0:40:50.82,0:40:52.11,Default,,0,0,0,,cậu đã làm sai cái gì với cỗ máy này.
Dialogue: 0,0:40:52.19,0:40:54.49,Default,,0,0,0,,(Mick) Tôi làm sai cái gì cơ?
Dialogue: 0,0:40:54.57,0:40:57.57,Default,,0,0,0,,(Kyo) Lúc tôi rời đi nó vẫn chạy ngon lành mà.
Dialogue: 0,0:40:57.66,0:41:00.08,Default,,0,0,0,,Được rồi, để xem nào.
Dialogue: 0,0:41:00.16,0:41:05.83,Default,,0,0,0,,Chỗ này bị lắp sai rồi...
Dialogue: 0,0:41:20.72,0:41:25.73,Default,,0,0,0,,(Kyo) Được rồi, nổ máy xem nào.
Dialogue: 0,0:41:46.42,0:41:47.42,Default,,0,0,0,,(Mick) Nghe êm đấy chứ.
Dialogue: 0,0:41:47.46,0:41:50.60,Default,,0,0,0,,(Kyo) Không, tiếng máy tệ lắm.
Dialogue: 0,0:41:50.63,0:41:54.76,Default,,0,0,0,,Cứ mang nó đi chạy thử xem sao đã.
Dialogue: 0,0:42:00.89,0:42:03.06,Default,,0,0,0,,Tôi rất tiếc về chuyện của cha anh.
Dialogue: 0,0:42:03.14,0:42:05.62,Default,,0,0,0,,Sao cô lại đến đây?
Dialogue: 0,0:42:05.64,0:42:07.89,Default,,0,0,0,,Anh không muốn biết thêm về ông ấy sao?
Dialogue: 0,0:42:07.98,0:42:09.54,Default,,0,0,0,,Cô có thể nói cho tôi biết điều gì về cha tôi mà tôi
Dialogue: 0,0:42:09.56,0:42:10.65,Default,,0,0,0,,chưa từng biết cơ chứ?
Dialogue: 0,0:42:10.73,0:42:11.96,Default,,0,0,0,,Anh có biết chuyện gì đã xảy ra với ông ấy không?
Dialogue: 0,0:42:11.98,0:42:17.74,Default,,0,0,0,,Có chứ, các giải đấu, chính chúng đã làm ông ra nông nỗi này.
Dialogue: 0,0:42:17.82,0:42:20.11,Default,,0,0,0,,Anh biết được bao nhiêu về những giải đấu đó?
Dialogue: 0,0:42:20.20,0:42:25.37,Default,,0,0,0,,Cô cũng là đấu sĩ phải không?
Dialogue: 0,0:42:25.45,0:42:28.79,Default,,0,0,0,,Tôi vừa hỏi cô một câu đấy. Cô có trả lời tôi không...
Dialogue: 0,0:42:28.87,0:42:33.29,Default,,0,0,0,,(Mai) Ôi!
Dialogue: 0,0:42:33.38,0:42:34.92,Default,,0,0,0,,Khốn thật.
Dialogue: 0,0:42:35.01,0:42:37.34,Default,,0,0,0,,Kyo, tôi xin lỗi!
Dialogue: 0,0:42:37.42,0:42:44.64,Default,,0,0,0,,(Kyo) Không sao đâu. Tôi ổn mà.
Dialogue: 0,0:42:44.72,0:42:45.64,Default,,0,0,0,,(Kyo) Tôi nghĩ nó bị trật khớp rồi.
Dialogue: 0,0:42:45.72,0:42:48.02,Default,,0,0,0,,(Mai) Kyo, tôi xin lỗi.
Dialogue: 0,0:42:48.10,0:42:55.61,Default,,0,0,0,,Nằm xuống, nằm xuống đi.
Dialogue: 0,0:42:55.69,0:42:58.19,Default,,0,0,0,,Hít thở đều. Thả lỏng ra.
Dialogue: 0,0:42:58.28,0:42:59.60,Default,,0,0,0,,(Kyo) Đừng chạm vào tôi. (Mai) Thả lỏng nào.
Dialogue: 0,0:42:59.66,0:43:00.63,Default,,0,0,0,,(Kyo) Đừng... đừng... làm ơn đừng chạm vào tôi.
Dialogue: 0,0:43:00.66,0:43:08.66,Default,,0,0,0,,(Mai) Thả lỏng, thở đều đi. Tôi biết mình đang làm gì mà. Nhìn tôi này.
Dialogue: 0,0:43:17.67,0:43:19.65,Default,,0,0,0,,(Mai) Đỡ hơn chưa?
Dialogue: 0,0:43:19.68,0:43:22.72,Default,,0,0,0,,(Kyo) Rồi.
Dialogue: 0,0:43:30.10,0:43:36.07,Default,,0,0,0,,(Mai) Thử cử động cánh tay xem.
Dialogue: 0,0:43:36.15,0:43:38.36,Default,,0,0,0,,(Kyo) Chà.
Dialogue: 0,0:43:38.44,0:43:42.03,Default,,0,0,0,,Ừ, đỡ... đỡ hơn nhiều rồi.
Dialogue: 0,0:43:42.11,0:43:46.70,Default,,0,0,0,,(Mai) Tốt lắm.
Dialogue: 0,0:43:46.79,0:43:53.79,Default,,0,0,0,,Cô vẫn chưa nói cho tôi biết cô đến đây để làm gì.
Dialogue: 0,0:43:53.88,0:43:56.71,Default,,0,0,0,,Tôi đang tìm một thanh kiếm.
Dialogue: 0,0:43:56.80,0:44:00.84,Default,,0,0,0,,Thanh kiếm nào?
Dialogue: 0,0:44:00.92,0:44:03.76,Default,,0,0,0,,Nó vốn thuộc về anh, nhưng có vẻ anh
Dialogue: 0,0:44:03.84,0:44:07.01,Default,,0,0,0,,chẳng biết nhiều... về lịch sử gia tộc mình.
Dialogue: 0,0:44:07.10,0:44:11.10,Default,,0,0,0,,Lịch sử gia tộc Kusanagi ư?
Dialogue: 0,0:44:11.19,0:44:12.39,Default,,0,0,0,,Chỉ là một mớ thần thoại
Dialogue: 0,0:44:12.48,0:44:16.44,Default,,0,0,0,,và chuyện cổ tích để mua vui cho trẻ con thôi.
Dialogue: 0,0:44:16.52,0:44:18.82,Default,,0,0,0,,Thế còn những gì Iori đã nói thì sao?
Dialogue: 0,0:44:18.90,0:44:25.41,Default,,0,0,0,,Rằng anh và anh ấy sinh ra định sẵn là kẻ thù của nhau.
Dialogue: 0,0:44:25.49,0:44:26.68,Default,,0,0,0,,Bạn trai cô không kể với cô sao?
Dialogue: 0,0:44:26.70,0:44:34.67,Default,,0,0,0,,Anh ấy không phải... Thôi được rồi.
Dialogue: 0,0:44:34.75,0:44:37.96,Default,,0,0,0,,Theo câu chuyện được lưu truyền, theo những gì tôi biết,
Dialogue: 0,0:44:38.05,0:44:41.51,Default,,0,0,0,,thì một trong những tổ tiên của anh ta
Dialogue: 0,0:44:41.59,0:44:48.72,Default,,0,0,0,,thuộc gia tộc Yagami chính là kẻ đầu tiên cố giải thoát Orochi.
Dialogue: 0,0:44:48.81,0:44:55.73,Default,,0,0,0,,Hắn muốn trở thành King of Fighters và thâu tóm sức mạnh của nó.
Dialogue: 0,0:44:55.81,0:44:59.48,Default,,0,0,0,,Nhưng thay vào đó, nó lại nuốt chửng hắn trong cơn cuồng nộ khát máu.
Dialogue: 0,0:44:59.57,0:45:04.53,Default,,0,0,0,,Nên các gia tộc đã liên minh lại, và một tổ tiên của tôi đã hạ sát
Dialogue: 0,0:45:04.61,0:45:11.79,Default,,0,0,0,,hắn rồi phong ấn Orochi trở lại thế giới của nó.
Dialogue: 0,0:45:11.87,0:45:15.58,Default,,0,0,0,,Họ kể lại như thế đấy.
Dialogue: 0,0:45:15.67,0:45:18.75,Default,,0,0,0,,Chuyện đó đang lặp lại lần nữa. Đó là lý do tôi ở đây.
Dialogue: 0,0:45:18.84,0:45:21.69,Default,,0,0,0,,Cô thực sự tin vào những chuyện hoang đường đó à?
Dialogue: 0,0:45:21.71,0:45:25.09,Default,,0,0,0,,Nghe này Kyo, có kẻ đang mưu toan thâu tóm sức mạnh của Orochi,
Dialogue: 0,0:45:25.18,0:45:31.43,Default,,0,0,0,,và nếu Rugal thành công, chúng ta có thể sẽ không bao giờ ngăn được hắn.
Dialogue: 0,0:45:31.52,0:45:35.35,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:45:35.44,0:45:38.77,Default,,0,0,0,,Cô có biết tôi có thể tìm Rugal ở đâu không?
Dialogue: 0,0:45:38.86,0:45:41.15,Default,,0,0,0,,(Mai) Để làm gì?
Dialogue: 0,0:45:41.23,0:45:45.28,Default,,0,0,0,,Bởi vì chính hắn là kẻ đã phá hủy tâm trí cha tôi.
Dialogue: 0,0:45:45.36,0:45:46.82,Default,,0,0,0,,(Mai) Anh có chắc không?
Dialogue: 0,0:45:46.91,0:45:53.75,Default,,0,0,0,,(Kyo) Tôi chắc chắn, và tôi sẽ bắt hắn phải trả giá cho những gì hắn đã làm.
Dialogue: 0,0:46:14.81,0:46:16.16,Default,,0,0,0,,(Iori) Em đã có thứ mình cần chưa? Đi thôi...
Dialogue: 0,0:46:16.19,0:46:19.98,Default,,0,0,0,,(Mai) Iori... chúng ta cần sự giúp đỡ của anh, được chứ?
Dialogue: 0,0:46:20.06,0:46:24.73,Default,,0,0,0,,Em không biết đủ nhiều. Anh phải nói chuyện với cậu ấy. Làm ơn đi.
Dialogue: 0,0:46:24.82,0:46:26.69,Default,,0,0,0,,(Kyo) Anh có thể nói cho tôi biết gì về Rugal?
Dialogue: 0,0:46:26.82,0:46:28.49,Default,,0,0,0,,Thanh kiếm đâu?
Dialogue: 0,0:46:28.57,0:46:29.70,Default,,0,0,0,,(Kyo) Tôi không biết.
Dialogue: 0,0:46:29.78,0:46:30.70,Default,,0,0,0,,Đi thôi em.
Dialogue: 0,0:46:30.78,0:46:32.83,Default,,0,0,0,,(Mai) Iori... (Terry) Chào người anh em.
Dialogue: 0,0:46:32.91,0:46:34.79,Default,,0,0,0,,Chà, có vẻ ở đây đang có một bữa tiệc nhỏ nhỉ.
Dialogue: 0,0:46:34.87,0:46:37.08,Default,,0,0,0,,Sao tôi lại không được mời thế?
Dialogue: 0,0:46:37.16,0:46:38.66,Default,,0,0,0,,Chúng tôi đang định rời đi đây.
Dialogue: 0,0:46:38.75,0:46:40.67,Default,,0,0,0,,Khoan, khoan, khoan đã, đi đâu vội thế?
Dialogue: 0,0:46:40.75,0:46:42.02,Default,,0,0,0,,Không định giới thiệu tôi với bạn bè của cô à?
Dialogue: 0,0:46:42.04,0:46:43.81,Default,,0,0,0,,Tôi nghĩ họ cũng muốn biết việc Rugal đang
Dialogue: 0,0:46:43.84,0:46:49.22,Default,,0,0,0,,sát hại người khác trong giải đấu đấy.
Dialogue: 0,0:46:49.30,0:46:50.80,Default,,0,0,0,,Một loạt thi thể...
Dialogue: 0,0:46:50.89,0:46:53.18,Default,,0,0,0,,tất cả đều là đấu sĩ của giải đấu này.
Dialogue: 0,0:46:53.26,0:46:55.70,Default,,0,0,0,,Giờ tôi biết tên Rugal này có dính líu vào chuyện đó.
Dialogue: 0,0:46:55.72,0:46:57.43,Default,,0,0,0,,Khoan đã, Rugal ư?
Dialogue: 0,0:46:57.52,0:47:00.14,Default,,0,0,0,,Hắn chính là kẻ đã mưu sát cha tôi.
Dialogue: 0,0:47:00.23,0:47:02.61,Default,,0,0,0,,Chúng ta phải ngăn hắn lại.
Dialogue: 0,0:47:02.69,0:47:06.88,Default,,0,0,0,,Tôi cần sự giúp đỡ của các người.
Dialogue: 0,0:47:06.90,0:47:09.11,Default,,0,0,0,,Theo những gì tôi được biết, cách duy nhất là phải
Dialogue: 0,0:47:09.20,0:47:10.57,Default,,0,0,0,,tìm ra thanh kiếm.
Dialogue: 0,0:47:10.66,0:47:13.03,Default,,0,0,0,,(Terry) Thanh kiếm... (Kyo) Một thanh kiếm ư? Thật đấy à?
Dialogue: 0,0:47:13.08,0:47:17.04,Default,,0,0,0,,Chà, nghe tuyệt vời thật đấy.
Dialogue: 0,0:47:17.12,0:47:19.25,Default,,0,0,0,,Đó là Thảo Thế Kiếm.
Dialogue: 0,0:47:19.33,0:47:21.04,Default,,0,0,0,,Được rồi, nó chỉ là thần thoại hoang đường thôi, hiểu chứ?
Dialogue: 0,0:47:21.12,0:47:23.58,Default,,0,0,0,,Các người... các người cho rằng khi kết hợp nó với...
Dialogue: 0,0:47:23.67,0:47:25.92,Default,,0,0,0,,Cậu đúng là nỗi nhục của gia tộc Kusanagi.
Dialogue: 0,0:47:26.00,0:47:27.21,Default,,0,0,0,,Anh nói cái gì cơ?
Dialogue: 0,0:47:27.30,0:47:28.65,Default,,0,0,0,,Mọi thứ đối với cậu chỉ là trò đùa.
Dialogue: 0,0:47:28.67,0:47:31.09,Default,,0,0,0,,Anh nghĩ mình là cái thớ gì hả?
Dialogue: 0,0:47:31.18,0:47:32.64,Default,,0,0,0,,Anh chẳng biết gì về tôi cả.
Dialogue: 0,0:47:32.72,0:47:36.10,Default,,0,0,0,,Cái... cái gì thế này? Hả?
Dialogue: 0,0:47:36.18,0:47:39.18,Default,,0,0,0,,Cô hứa sẽ cho tôi câu trả lời, mà tôi phải đôi co với tên này à?
Dialogue: 0,0:47:39.27,0:47:41.73,Default,,0,0,0,,Nghe này, hãy... hãy làm cho chuyện này đơn giản đi.
Dialogue: 0,0:47:41.81,0:47:44.69,Default,,0,0,0,,Chỉ cần nói cho tôi biết tôi có thể tìm Rugal ở đâu.
Dialogue: 0,0:47:44.77,0:47:50.90,Default,,0,0,0,,Nó không đơn giản đâu. Hắn đang ở một chiều không gian khác.
Dialogue: 0,0:47:50.99,0:47:52.95,Default,,0,0,0,,Ồ! Lại bắt đầu với trò nhảm nhí về chiều không gian khác rồi.
Dialogue: 0,0:47:53.03,0:47:55.16,Default,,0,0,0,,Không gian gì chứ. Chỉ có duy nhất một thế giới này thôi.
Dialogue: 0,0:47:55.24,0:47:56.49,Default,,0,0,0,,Không gian nọ không gian kia.
Dialogue: 0,0:47:56.58,0:47:58.70,Default,,0,0,0,,Chẳng có ai du hành sang chiều không gian khác
Dialogue: 0,0:47:58.79,0:48:00.06,Default,,0,0,0,,để tỉ võ trong các giải đấu ngầm cả.
Dialogue: 0,0:48:00.08,0:48:00.91,Default,,0,0,0,,Chuyện đó không hề có thật.
Dialogue: 0,0:48:00.96,0:48:02.62,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:48:02.71,0:48:03.71,Default,,0,0,0,,Tôi đã từng đi rồi.
Dialogue: 0,0:48:03.75,0:48:04.75,Default,,0,0,0,,Ồ, dĩ nhiên là cô đi rồi.
Dialogue: 0,0:48:04.84,0:48:09.67,Default,,0,0,0,,Các người mất trí hết rồi à?
Dialogue: 0,0:48:09.76,0:48:10.78,Default,,0,0,0,,C-Cô thực sự tin là cô đã từng đi sang
Dialogue: 0,0:48:10.80,0:48:15.05,Default,,0,0,0,,một chiều không gian khác sao?
Dialogue: 0,0:48:15.14,0:48:17.14,Default,,0,0,0,,Đủ rồi đấy. Thế là quá đủ rồi.
Dialogue: 0,0:48:17.22,0:48:19.77,Default,,0,0,0,,Terry... Không, tôi rút cô khỏi vụ án này.
Dialogue: 0,0:48:19.85,0:48:23.56,Default,,0,0,0,,(Iori) Chờ đã, cái gì? Anh vừa nói gì cơ?
Dialogue: 0,0:48:23.65,0:48:26.81,Default,,0,0,0,,Anh ta rút em khỏi vụ án này ư?
Dialogue: 0,0:48:26.90,0:48:30.61,Default,,0,0,0,,Chà, chuyện này càng lúc càng thú vị rồi đấy.
Dialogue: 0,0:48:30.69,0:48:35.41,Default,,0,0,0,,Nói cho anh biết đi Mai, trong căn phòng này có ai
Dialogue: 0,0:48:35.49,0:48:40.83,Default,,0,0,0,,mà em chưa từng nói dối không?
Dialogue: 0,0:48:40.91,0:48:43.79,Default,,0,0,0,,(Mai) Iori... Chuyện này quá nguy hiểm, anh biết mà.
Dialogue: 0,0:48:43.87,0:48:47.00,Default,,0,0,0,,Buông ra. Buông tôi ra.
Dialogue: 0,0:48:53.80,0:48:57.89,Default,,0,0,0,,Màn kịch diễn đạt lắm, hả? Đặc vụ Shiranui?
Dialogue: 0,0:48:57.97,0:49:01.18,Default,,0,0,0,,Khá lắm đấy.
Dialogue: 0,0:49:24.16,0:49:26.73,Default,,0,0,0,,(Rugal) A, Iori...
Dialogue: 0,0:49:26.75,0:49:29.21,Default,,0,0,0,,(Iori) Rugal, tôi phải công nhận,
Dialogue: 0,0:49:29.29,0:49:30.77,Default,,0,0,0,,tôi rất thích những gì ông đã làm với nơi này đấy.
Dialogue: 0,0:49:30.80,0:49:37.93,Default,,0,0,0,,(Rugal) Ôi... đáng yêu ghê. Nhìn kìa các em. Iori đến chơi rồi.
Dialogue: 0,0:49:38.01,0:49:39.80,Default,,0,0,0,,Thất vọng lắm sao, Rugal?
Dialogue: 0,0:49:39.89,0:49:42.22,Default,,0,0,0,,Thực ra, ta không nghĩ có ai khác
Dialogue: 0,0:49:42.31,0:49:44.56,Default,,0,0,0,,biết trân trọng những gì ta đang làm hơn ngươi đâu.
Dialogue: 0,0:49:44.64,0:49:46.85,Default,,0,0,0,,Tôi đến đây là để ngăn chặn ông.
Dialogue: 0,0:49:46.94,0:49:50.06,Default,,0,0,0,,Ta không nghĩ vậy đâu. Ngươi...
Dialogue: 0,0:49:50.15,0:49:54.78,Default,,0,0,0,,Nào, thành thật với nhau đi, ngươi có vấn đề tâm lý mà.
Dialogue: 0,0:49:54.86,0:49:56.82,Default,,0,0,0,,Tôi có vấn đề ư. Chà.
Dialogue: 0,0:49:56.91,0:49:59.49,Default,,0,0,0,,Tôi kiểm soát được vấn đề của mình, còn ông thì...
Dialogue: 0,0:49:59.57,0:50:02.24,Default,,0,0,0,,Đủ rồi đấy.
Dialogue: 0,0:50:02.33,0:50:03.70,Default,,0,0,0,,Ngươi định cứ đứng đó nói nhảm mãi,
Dialogue: 0,0:50:03.79,0:50:06.21,Default,,0,0,0,,hay là bước xuống đây tử chiến?
Dialogue: 0,0:50:06.29,0:50:10.46,Default,,0,0,0,,Ai bảo là ta sẽ tự mình ra tay đấu với ngươi?
Dialogue: 0,0:50:16.84,0:50:23.81,Default,,0,0,0,,Và trò chơi bắt đầu.
Dialogue: 0,0:51:19.86,0:51:24.20,Default,,0,0,0,,Nào. Đâu rồi một Iori xưa cũ mà ta từng biết và yêu quý hả?
Dialogue: 0,0:51:29.62,0:51:37.34,Default,,0,0,0,,A A A A A!!
Dialogue: 0,0:51:47.89,0:51:52.81,Default,,0,0,0,,Hắn lộ diện rồi đấy.
Dialogue: 0,0:52:35.77,0:52:37.77,Default,,0,0,0,,Hoan hô!
Dialogue: 0,0:52:37.86,0:52:39.40,Default,,0,0,0,,Tinh thần đó mới đúng chứ.
Dialogue: 0,0:52:39.48,0:52:40.86,Default,,0,0,0,,Hãy đón nhận nó đi.
Dialogue: 0,0:52:40.94,0:52:46.20,Default,,0,0,0,,Ngươi biết sức mạnh của nó mà, cảm giác nó mang lại thế nào.
Dialogue: 0,0:52:46.28,0:52:49.54,Default,,0,0,0,,Làm đi... làm tới luôn đi!
Dialogue: 0,0:52:49.62,0:52:51.95,Default,,0,0,0,,Hợp sức lại, chúng ta sẽ là bất khả chiến bại.
Dialogue: 0,0:52:52.04,0:52:55.79,Default,,0,0,0,,Không một ai có thể cản nổi chúng ta!
Dialogue: 0,0:52:55.88,0:52:58.09,Default,,0,0,0,,(Mai) Iori? Iori?
Dialogue: 0,0:52:58.17,0:53:04.68,Default,,0,0,0,,(Mai) Iori?
Dialogue: 0,0:53:04.76,0:53:12.76,Default,,0,0,0,,Iori... mắt anh... Tránh xa tôi ra!
Dialogue: 0,0:53:17.86,0:53:19.71,Default,,0,0,0,,Mau tìm thanh kiếm đi.
Dialogue: 0,0:53:19.73,0:53:21.78,Default,,0,0,0,,Trời ạ, chuyện này điên rồ thật.
Dialogue: 0,0:53:21.86,0:53:25.86,Default,,0,0,0,,Khi nào định vị được Rugal, cô biết tìm tôi ở đâu rồi đấy.
Dialogue: 0,0:53:36.25,0:53:39.84,Default,,0,0,0,,(Terry) Mai, thật lòng đấy, đừng tự dằn vặt mình nữa.
Dialogue: 0,0:53:39.92,0:53:43.01,Default,,0,0,0,,(Mai) Tôi không dằn vặt. Nhưng anh thì nên đấy.
Dialogue: 0,0:53:43.09,0:53:43.96,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:53:44.05,0:53:45.17,Default,,0,0,0,,Phải.
Dialogue: 0,0:53:45.26,0:53:46.69,Default,,0,0,0,,Này, tôi đâu phải người đẩy hai nghi phạm của chúng ta
Dialogue: 0,0:53:46.72,0:53:48.40,Default,,0,0,0,,vào một mối tình tay ba nghiệt ngã có nguy cơ giải phóng
Dialogue: 0,0:53:48.43,0:53:50.80,Default,,0,0,0,,một thế lực tà ác vào thế giới của chúng ta,
Dialogue: 0,0:53:50.89,0:53:54.77,Default,,0,0,0,,đe dọa xé toạc trật tự của toàn bộ vũ trụ đâu.
Dialogue: 0,0:53:54.85,0:53:56.16,Default,,0,0,0,,Ý tôi là, nếu tôi là cô và chuyện đó là thật,
Dialogue: 0,0:53:56.19,0:53:59.90,Default,,0,0,0,,thì có lẽ tôi cũng sẽ thấy hơi cắn rứt lương tâm đấy.
Dialogue: 0,0:53:59.98,0:54:02.78,Default,,0,0,0,,Lẽ ra tôi nên nói cho anh ấy biết sớm hơn.
Dialogue: 0,0:54:02.86,0:54:07.82,Default,,0,0,0,,Giờ thì anh ấy sẽ không bao giờ tha thứ cho tôi nữa.
Dialogue: 0,0:54:07.91,0:54:10.74,Default,,0,0,0,,Có chứ, cậu ta sẽ tha thứ mà.
Dialogue: 0,0:54:10.83,0:54:11.95,Default,,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:54:12.04,0:54:13.87,Default,,0,0,0,,Mà chúng ta đang nói về anh chàng nào thế?
Dialogue: 0,0:54:13.95,0:54:14.83,Default,,0,0,0,,Anh đúng là đồ đáng ghét.
Dialogue: 0,0:54:14.91,0:54:16.27,Default,,0,0,0,,Cô chỉ đang làm những gì cô được giao phó thôi mà.
Dialogue: 0,0:54:16.29,0:54:17.41,Default,,0,0,0,,Cô chỉ đang làm tròn phận sự của mình thôi.
Dialogue: 0,0:54:17.50,0:54:19.92,Default,,0,0,0,,Phải, một công việc tuyệt vời, làm cho mọi người căm ghét tôi.
Dialogue: 0,0:54:20.00,0:54:21.73,Default,,0,0,0,,Không đâu, đó không phải lý do họ ghét cô đâu.
Dialogue: 0,0:54:21.75,0:54:22.69,Default,,0,0,0,,Có lẽ cậu ta ghét cô vì cô đã tự ý đào ngũ,
Dialogue: 0,0:54:22.71,0:54:24.15,Default,,0,0,0,,và không chịu tiết lộ việc cô dính líu
Dialogue: 0,0:54:24.17,0:54:25.55,Default,,0,0,0,,vào một giải đấu võ thuật ngầm bí mật
Dialogue: 0,0:54:25.63,0:54:26.92,Default,,0,0,0,,xuyên không gian thôi.
Dialogue: 0,0:54:27.01,0:54:29.70,Default,,0,0,0,,Ủa khoan đã, đó chính là lý do tôi ghét cô mà!
Dialogue: 0,0:54:29.72,0:54:31.80,Default,,0,0,0,,Tôi ghét anh.
Dialogue: 0,0:54:31.89,0:54:33.81,Default,,0,0,0,,Xin lỗi nhé, nhưng không đùa đâu, cô sẽ phải
Dialogue: 0,0:54:33.89,0:54:36.43,Default,,0,0,0,,đứng ra làm người dẫn đường vụ này đấy, bởi vì thật lòng mà nói,
Dialogue: 0,0:54:36.52,0:54:40.98,Default,,0,0,0,,tôi chẳng có một manh mối nào cả.
Dialogue: 0,0:54:41.06,0:54:44.69,Default,,0,0,0,,Phải. Nghe này, tôi nghĩ chúng ta nên bắt đầu từ Kyo.
Dialogue: 0,0:54:44.78,0:54:46.44,Default,,0,0,0,,Ngày mai chúng ta sẽ tới gặp cậu ấy.
Dialogue: 0,0:54:46.53,0:54:48.86,Default,,0,0,0,,Chúng ta cần cậu ấy đứng về phía mình.
Dialogue: 0,0:54:48.95,0:54:53.20,Default,,0,0,0,,Tôi sẽ giải quyết chuyện của Iori sau. Sao chỗ này lại có mùi thế?
Dialogue: 0,0:54:53.29,0:54:54.79,Default,,0,0,0,,Kinh phí eo hẹp mà.
Dialogue: 0,0:54:54.87,0:54:57.12,Default,,0,0,0,,Đây là một xưởng đóng hộp cá cũ bị bỏ hoang.
Dialogue: 0,0:54:57.21,0:54:58.96,Default,,0,0,0,,(Mai) Một văn phòng thực địa đặt trong xưởng cá hộp ư?
Dialogue: 0,0:54:59.04,0:55:02.84,Default,,0,0,0,,(Terry) Này, CIA luôn dành những thứ tốt nhất cho chúng ta mà.
Dialogue: 0,0:55:39.91,0:55:43.17,Default,,0,0,0,,Anh chẳng hiểu làm một Kusanagi có ý nghĩa thế nào đâu.
Dialogue: 0,0:55:43.25,0:55:45.84,Default,,0,0,0,,Sao anh lại nói thế?
Dialogue: 0,0:55:45.92,0:55:48.84,Default,,0,0,0,,Dòng máu Kusanagi đang cuộn chảy trong huyết quản của anh.
Dialogue: 0,0:55:48.92,0:55:51.69,Default,,0,0,0,,Trách nhiệm của anh, số mệnh của anh là phải... phải
Dialogue: 0,0:55:51.72,0:55:55.70,Default,,0,0,0,,đối đầu với Orochi, nhưng anh lại không chịu chấp nhận nó.
Dialogue: 0,0:55:55.72,0:55:58.18,Default,,0,0,0,,Anh đang sợ hãi.
Dialogue: 0,0:55:58.27,0:56:03.56,Default,,0,0,0,,Không, chỉ là tôi không tin vào những câu chuyện hoang đường của cô thôi.
Dialogue: 0,0:56:03.65,0:56:07.78,Default,,0,0,0,,Chạy thử một vòng đi.
Dialogue: 0,0:56:16.66,0:56:18.87,Default,,0,0,0,,Cô không phải Mai.
Dialogue: 0,0:56:18.95,0:56:21.08,Default,,0,0,0,,Chắc tôi nhầm số rồi.
Dialogue: 0,0:56:21.16,0:56:22.83,Default,,0,0,0,,Đây là giải đấu phải không?
Dialogue: 0,0:56:22.92,0:56:25.38,Default,,0,0,0,,Cậu mới tham gia trò này hả.
Dialogue: 0,0:56:35.55,0:56:37.76,Default,,0,0,0,,Đây là những gì chúng ta làm ở đây phải không?
Dialogue: 0,0:56:37.85,0:56:39.68,Default,,0,0,0,,Chúng ta giao chiến?
Dialogue: 0,0:56:45.02,0:56:46.06,Default,,0,0,0,,Đó đâu phải là chiến đấu.
Dialogue: 0,0:56:46.15,0:56:49.32,Default,,0,0,0,,Về mặt kỹ thuật mà nói, đó là cậu đang bị ăn đòn thì đúng hơn.
Dialogue: 0,0:57:29.44,0:57:30.36,Default,,0,0,0,,Để ta nói cho cậu biết ta sẽ làm gì nhé,
Dialogue: 0,0:57:30.44,0:57:32.48,Default,,0,0,0,,ta sẽ tha mạng cho cậu.
Dialogue: 0,0:57:32.57,0:57:33.82,Default,,0,0,0,,Hãy về bảo với bạn bè của cậu...
Dialogue: 0,0:57:33.90,0:57:36.36,Default,,0,0,0,,rằng ta hứa sẽ dừng mọi vụ giết chóc lại.
Dialogue: 0,0:57:36.45,0:57:38.74,Default,,0,0,0,,Chỉ cần quay lại đây và tiếp tục chiến đấu.
Dialogue: 0,0:57:38.83,0:57:42.16,Default,,0,0,0,,Cùng vui vẻ một chút nào.
Dialogue: 0,0:57:54.88,0:57:56.38,Default,,0,0,0,,(Mai) Iori!
Dialogue: 0,0:57:56.47,0:57:59.55,Default,,0,0,0,,Anh suýt nữa đã giết chết cậu ấy rồi đấy.
Dialogue: 0,0:58:05.56,0:58:09.98,Default,,0,0,0,,Tôi thực sự không hiểu nổi.
Dialogue: 0,0:58:10.06,0:58:12.73,Default,,0,0,0,,Tôi phải làm gì đây?
Dialogue: 0,0:58:12.82,0:58:15.53,Default,,0,0,0,,Những người này...
Dialogue: 0,0:58:15.61,0:58:23.61,Default,,0,0,0,,họ nghĩ tôi là một ai đó không phải chính tôi.
Dialogue: 0,0:58:25.75,0:58:28.12,Default,,0,0,0,,Là thế đấy, hả?
Dialogue: 0,0:58:28.21,0:58:31.17,Default,,0,0,0,,Tốt nhất là hãy như nước, làm lợi cho
Dialogue: 0,0:58:31.25,0:58:38.26,Default,,0,0,0,,vạn vật muôn loài.
Dialogue: 0,0:58:38.34,0:58:41.68,Default,,0,0,0,,Đó là điều mình sẽ làm.
Dialogue: 0,0:58:54.78,0:58:57.61,Default,,0,0,0,,Sao cô tìm được tôi ở đây?
Dialogue: 0,0:58:57.70,0:59:01.32,Default,,0,0,0,,Tôi biết anh đang đi tìm câu trả lời mà.
Dialogue: 0,0:59:01.41,0:59:04.76,Default,,0,0,0,,Anh ổn chứ?
Dialogue: 0,0:59:04.79,0:59:10.29,Default,,0,0,0,,Tôi chỉ không hiểu cha tôi thấy được gì ở nơi đó.
Dialogue: 0,0:59:10.38,0:59:12.88,Default,,0,0,0,,Cha tôi là một người yêu chuộng hòa bình.
Dialogue: 0,0:59:12.96,0:59:16.26,Default,,0,0,0,,Còn tất cả những gì tôi thấy ở đó chỉ toàn là cái ác.
Dialogue: 0,0:59:16.34,0:59:19.59,Default,,0,0,0,,Nơi đó vốn không phải lúc nào cũng như vậy.
Dialogue: 0,0:59:19.68,0:59:24.14,Default,,0,0,0,,Cô thấy được gì trong đó?
Dialogue: 0,0:59:24.22,0:59:27.02,Default,,0,0,0,,Tôi không biết nữa, một nơi tôi có thể là chính mình.
Dialogue: 0,0:59:27.10,0:59:28.68,Default,,0,0,0,,Ở thế giới này cô không thể là chính mình sao?
Dialogue: 0,0:59:28.77,0:59:33.81,Default,,0,0,0,,Còn anh thì sao?
Dialogue: 0,0:59:33.90,0:59:37.99,Default,,0,0,0,,Anh biết đấy, một linh hồn lạc lối luôn nhận ra một kẻ lạc lối khác.
Dialogue: 0,0:59:39.78,0:59:42.28,Default,,0,0,0,,Tôi cứ ngỡ cô chỉ muốn săn lùng thanh kiếm thôi chứ.
Dialogue: 0,0:59:42.37,0:59:46.37,Default,,0,0,0,,Tôi đang tìm kiếm rất nhiều điều.
Dialogue: 0,0:59:46.41,0:59:47.79,Default,,0,0,0,,Cô muốn gì ở tôi?
Dialogue: 0,0:59:47.87,0:59:48.91,Default,,0,0,0,,Tôi cần anh giúp đỡ.
Dialogue: 0,0:59:49.00,0:59:50.77,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:59:50.79,0:59:52.58,Default,,0,0,0,,Vì họ của tôi là Kusanagi à?
Dialogue: 0,0:59:52.67,0:59:57.46,Default,,0,0,0,,Không, vì anh là người nhà Kusanagi cuối cùng.
Dialogue: 0,0:59:57.55,1:00:00.78,Default,,0,0,0,,Tôi không phải người mà cô mong muốn đâu.
Dialogue: 0,1:00:00.80,1:00:03.39,Default,,0,0,0,,Cha tôi mới là hậu duệ cuối cùng của gia tộc,
Dialogue: 0,1:00:03.47,1:00:06.35,Default,,0,0,0,,và Rugal đã hủy hoại tất cả những điều đó rồi.
Dialogue: 0,1:00:06.43,1:00:09.52,Default,,0,0,0,,Gia tộc Kusanagi đã chấm dứt rồi.
Dialogue: 0,1:00:09.60,1:00:12.31,Default,,0,0,0,,Tôi không nghĩ cha anh sẽ đồng tình với điều đó đâu.
Dialogue: 0,1:00:12.40,1:00:13.90,Default,,0,0,0,,Ông ấy đã đặt cho anh cái tên đó mà.
Dialogue: 0,1:00:13.98,1:00:15.42,Default,,0,0,0,,Điều gì khiến cô nghĩ tôi có thể thành công
Dialogue: 0,1:00:15.44,1:00:19.15,Default,,0,0,0,,ở nơi mà Saisyu đã thất bại chứ?
Dialogue: 0,1:00:19.24,1:00:24.07,Default,,0,0,0,,Tôi chỉ là một thợ sửa môtô thôi, tôi không phải anh hùng.
Dialogue: 0,1:00:24.16,1:00:26.33,Default,,0,0,0,,Kyo, tôi không biết anh là ai.
Dialogue: 0,1:00:26.41,1:00:27.99,Default,,0,0,0,,Chính anh còn chưa biết mình là ai cơ mà.
Dialogue: 0,1:00:28.08,1:00:30.29,Default,,0,0,0,,Đó là điều anh sẽ phải tự mình khám phá ra,
Dialogue: 0,1:00:30.37,1:00:34.37,Default,,0,0,0,,nhưng ngay lúc này, chúng ta phải ngăn Rugal lại,
Dialogue: 0,1:00:34.42,1:00:37.96,Default,,0,0,0,,và chúng tôi sẽ làm điều đó, dù có anh hay không.
Dialogue: 0,1:01:11.00,1:01:12.29,Default,,0,0,0,,Cậu vừa làm cái gì cơ?
Dialogue: 0,1:01:12.37,1:01:15.00,Default,,0,0,0,,Nghe này, tôi chẳng biết chuyện gì đang xảy ra với mấy thứ này,
Dialogue: 0,1:01:15.08,1:01:16.92,Default,,0,0,0,,sau khi tận mắt thấy những gì nó gây ra cho thằng nhóc Kusanagi,
Dialogue: 0,1:01:17.00,1:01:17.88,Default,,0,0,0,,tôi buộc phải hành động.
Dialogue: 0,1:01:17.96,1:01:19.36,Default,,0,0,0,,(Mai) Vậy là anh đã dùng danh sách của Chizuru để ăn trộm.
Dialogue: 0,1:01:19.38,1:01:20.63,Default,,0,0,0,,chúng từ các đấu sĩ à?
Dialogue: 0,1:01:20.71,1:01:22.71,Default,,0,0,0,,Thôi nào, chúng ta là CIA, cái đó gọi là 'tịch thu'.
Dialogue: 0,1:01:22.84,1:01:23.73,Default,,0,0,0,,Tịch thu á?
Dialogue: 0,1:01:23.76,1:01:26.80,Default,,0,0,0,,Tôi đã tin tưởng giao nó cho anh. Chị ấy đã tin tưởng tôi.
Dialogue: 0,1:01:26.89,1:01:28.07,Default,,0,0,0,,Trong khi cô ở ngoài kia lãng mạn lăng nhăng với
Dialogue: 0,1:01:28.10,1:01:30.93,Default,,0,0,0,,mấy gã đó, thì tôi ở đây cố gắng điều tra vụ này đấy.
Dialogue: 0,1:01:31.02,1:01:34.02,Default,,0,0,0,,Nên nếu có một chiều không gian khác như cô nói,
Dialogue: 0,1:01:34.10,1:01:36.27,Default,,0,0,0,,thì có lẽ tôi vừa chặn đứng con đường duy nhất vào trong đó rồi, đúng không?
Dialogue: 0,1:01:36.35,1:01:39.77,Default,,0,0,0,,(Chizuru) Không, anh chưa chặn được đâu.
Dialogue: 0,1:01:39.86,1:01:43.82,Default,,0,0,0,,Chizuru... Cảm ơn chị đã tới.
Dialogue: 0,1:01:43.90,1:01:45.86,Default,,0,0,0,,Cô ta làm gì ở đây thế này?
Dialogue: 0,1:01:45.95,1:01:50.83,Default,,0,0,0,,Chị ấy tin tưởng tôi.
Dialogue: 0,1:01:50.91,1:01:52.05,Default,,0,0,0,,(Chizuru) Chúng ta không còn nhiều thời gian nữa đâu.
Dialogue: 0,1:01:52.08,1:01:53.79,Default,,0,0,0,,Rugal đang ngày càng trở nên hùng mạnh hơn,
Dialogue: 0,1:01:53.87,1:01:55.87,Default,,0,0,0,,và tôi e rằng kế hoạch ngăn chặn hắn của anh sẽ không hiệu quả.
Dialogue: 0,1:01:55.96,1:01:57.98,Default,,0,0,0,,À, đó là vì làm gì có chiều không gian nào khác, đúng chứ?
Dialogue: 0,1:01:58.00,1:01:59.67,Default,,0,0,0,,Không, mà là vì Rugal sắp sửa
Dialogue: 0,1:01:59.75,1:02:02.84,Default,,0,0,0,,sáp nhập hai thế giới của chúng ta lại với nhau.
Dialogue: 0,1:02:02.92,1:02:03.92,Default,,0,0,0,,Ý cô là sao?
Dialogue: 0,1:02:04.01,1:02:04.92,Default,,0,0,0,,À... thực ra chuyện này cũng ngầu phết đấy...
Dialogue: 0,1:02:05.01,1:02:06.68,Default,,0,0,0,,Đấy, lại bắt đầu rồi đấy.
Dialogue: 0,1:02:06.76,1:02:08.34,Default,,0,0,0,,Không, anh thấy đấy... những chiều không gian này...
Dialogue: 0,1:02:08.43,1:02:10.80,Default,,0,0,0,,Không gian, thấy chưa? Tôi đã bảo là có nhiều hơn một mà.
Dialogue: 0,1:02:10.89,1:02:13.18,Default,,0,0,0,,(Scott) Những chiều không gian này tồn tại trong thứ được mô tả chính xác hơn là
Dialogue: 0,1:02:13.27,1:02:16.02,Default,,0,0,0,,đa vũ trụ... hay vũ trụ song song.
Dialogue: 0,1:02:16.10,1:02:17.60,Default,,0,0,0,,Anh thấy đấy, Rugal đã có thể tiếp cận
Dialogue: 0,1:02:17.69,1:02:19.90,Default,,0,0,0,,vào một bản sao y hệt của thế giới hiện thực chúng ta.
Dialogue: 0,1:02:19.98,1:02:23.79,Default,,0,0,0,,Điều này có nghĩa là hắn có thể mở một cánh cổng để ép
Dialogue: 0,1:02:23.82,1:02:26.28,Default,,0,0,0,,các đấu sĩ phải bước vào giải đấu.
Dialogue: 0,1:02:26.36,1:02:27.70,Default,,0,0,0,,(Rugal) Này... chúng ta có hẹn đấy nhé.
Dialogue: 0,1:02:27.78,1:02:30.99,Default,,0,0,0,,(Scott) Cô ấy đã ở trong đó rồi.
Dialogue: 0,1:02:46.97,1:02:48.26,Default,,0,0,0,,Tất cả chuyện này đang diễn ra theo thời gian thực. Đáng kinh ngạc thật.
Dialogue: 0,1:02:48.34,1:02:52.85,Default,,0,0,0,,Cậu nắm giữ thanh kiếm suốt bấy lâu nay ư?
Dialogue: 0,1:02:52.93,1:02:54.16,Default,,0,0,0,,Iori, đừng nói chuyện đó lúc này.
Dialogue: 0,1:02:54.18,1:02:56.02,Default,,0,0,0,,Nghe này... các người xông vào cuộc đời tôi
Dialogue: 0,1:02:56.14,1:02:58.02,Default,,0,0,0,,rồi đòi lấy đi mối liên hệ duy nhất tôi còn giữ về cha mình.
Dialogue: 0,1:02:58.10,1:03:00.60,Default,,0,0,0,,Các người thực sự nghĩ tôi sẽ dễ dàng giao nó ra sao?
Dialogue: 0,1:03:00.69,1:03:03.86,Default,,0,0,0,,Giờ nó ở đây rồi, và tôi đã sẵn sàng bước vào.
Dialogue: 0,1:03:03.94,1:03:08.70,Default,,0,0,0,,Kyo, tôi rất tiếc về những gì đã xảy ra với cha cậu,
Dialogue: 0,1:03:08.78,1:03:10.45,Default,,0,0,0,,nhưng cậu phải cẩn thận, đừng để cơn thịnh nộ
Dialogue: 0,1:03:10.53,1:03:13.16,Default,,0,0,0,,chi phối bản thân mình.
Dialogue: 0,1:03:13.24,1:03:15.04,Default,,0,0,0,,Tôi biết rồi.
Dialogue: 0,1:03:15.12,1:03:16.33,Default,,0,0,0,,Hãy tin vào chính mình.
Dialogue: 0,1:03:16.41,1:03:18.54,Default,,0,0,0,,Tôi sẽ làm vậy.
Dialogue: 0,1:03:18.62,1:03:23.34,Default,,0,0,0,,Tôi xin lỗi, Iori, chuyện này quá nguy hiểm.
Dialogue: 0,1:03:23.42,1:03:25.71,Default,,0,0,0,,Mọi người cần tôi.
Dialogue: 0,1:03:25.80,1:03:26.82,Default,,0,0,0,,Chiến đấu với Rugal đã đủ khó khăn rồi.
Dialogue: 0,1:03:26.84,1:03:28.15,Default,,0,0,0,,Nếu... nếu anh lại bị Orochi khuất phục...
Dialogue: 0,1:03:28.17,1:03:29.88,Default,,0,0,0,,Lần này chuyện đó sẽ không xảy ra đâu.
Dialogue: 0,1:03:29.97,1:03:31.36,Default,,0,0,0,,Tôi đủ mạnh mẽ để kiềm chế nó.
Dialogue: 0,1:03:31.39,1:03:32.59,Default,,0,0,0,,Vậy thì hãy dùng sức mạnh đó để làm điều đúng đắn.
Dialogue: 0,1:03:32.68,1:03:35.85,Default,,0,0,0,,Làm ơn đi.
Dialogue: 0,1:03:35.93,1:03:42.02,Default,,0,0,0,,Tôi cũng sẽ vào trong đó.
Dialogue: 0,1:03:42.10,1:03:42.85,Default,,0,0,0,,Anh còn chẳng thèm tin vào những mệnh lệnh cơ mà.
Dialogue: 0,1:03:42.98,1:03:44.36,Default,,0,0,0,,Đến lúc tôi phải bắt đầu tin rồi đấy.
Dialogue: 0,1:03:44.44,1:03:46.65,Default,,0,0,0,,Chỉ cho bọn tôi cách dùng mấy thứ này đi, Scotty.
Dialogue: 0,1:03:46.73,1:03:52.16,Default,,0,0,0,,Iori, nếu bọn tôi không quay lại... hãy phá hủy tất cả mọi thứ.
Dialogue: 0,1:03:52.24,1:03:56.66,Default,,0,0,0,,(Mai) Terry!
Dialogue: 0,1:04:56.43,1:04:57.51,Default,,0,0,0,,Anh làm gì ở đây thế?
Dialogue: 0,1:04:57.60,1:04:58.60,Default,,0,0,0,,Tôi là cộng sự của cô mà.
Dialogue: 0,1:04:58.64,1:04:59.51,Default,,0,0,0,,Cô nghĩ sao, tôi sẽ bỏ mặc cô một mình chắc?
Dialogue: 0,1:04:59.60,1:05:03.02,Default,,0,0,0,,(Rugal) Chào mừng đến với... tư gia khiêm tốn của ta.
Dialogue: 0,1:05:10.11,1:05:13.90,Default,,0,0,0,,Chizuru?
Dialogue: 0,1:05:13.99,1:05:19.12,Default,,0,0,0,,Rất vui được gặp lại cô.
Dialogue: 0,1:05:19.20,1:05:20.76,Default,,0,0,0,,Lúc nãy ta cứ tưởng cô không qua khỏi cơ đấy.
Dialogue: 0,1:05:20.79,1:05:22.91,Default,,0,0,0,,Tất cả những chuyện này chỉ vì ngươi muốn làm King of Fighters thôi sao?
Dialogue: 0,1:05:23.00,1:05:25.25,Default,,0,0,0,,Ta chính là King of Fighters.
Dialogue: 0,1:05:25.33,1:05:27.08,Default,,0,0,0,,Vậy tại sao ngươi không dừng mọi chuyện lại và
Dialogue: 0,1:05:27.17,1:05:28.35,Default,,0,0,0,,quay trở về thế giới thực đi?
Dialogue: 0,1:05:28.38,1:05:30.55,Default,,0,0,0,,Thế giới này là tất cả những gì ta cần.
Dialogue: 0,1:05:30.63,1:05:33.26,Default,,0,0,0,,Ở đây, ta là kẻ bất tử.
Dialogue: 0,1:05:33.34,1:05:36.09,Default,,0,0,0,,Đây không phải là sự sống.
Dialogue: 0,1:05:36.18,1:05:37.26,Default,,0,0,0,,Đây là nơi chúng ta đến để thử thách bản thân
Dialogue: 0,1:05:37.35,1:05:38.78,Default,,0,0,0,,và tôi luyện, để trở nên tốt đẹp hơn ở thế giới thực.
Dialogue: 0,1:05:38.80,1:05:41.85,Default,,0,0,0,,Khi thế giới của ta bành trướng và hòa nhập vào
Dialogue: 0,1:05:41.93,1:05:43.48,Default,,0,0,0,,thế giới của các ngươi, đây sẽ chính là thế giới thực.
Dialogue: 0,1:05:43.56,1:05:46.90,Default,,0,0,0,,Ta sẽ là vua của tất cả mọi thứ.
Dialogue: 0,1:05:46.98,1:05:50.65,Default,,0,0,0,,Ta là bất khả chiến bại.
Dialogue: 0,1:05:50.73,1:05:51.86,Default,,0,0,0,,Ngươi không hề bất khả chiến bại...
Dialogue: 0,1:05:51.94,1:05:53.19,Default,,0,0,0,,chừng nào chúng ta còn nắm giữ thanh kiếm.
Dialogue: 0,1:05:53.28,1:05:55.61,Default,,0,0,0,,Thảo Thế Kiếm ư?
Dialogue: 0,1:05:55.70,1:05:57.11,Default,,0,0,0,,Saisyu chính là cha của tôi.
Dialogue: 0,1:05:57.20,1:06:00.91,Default,,0,0,0,,Kusanagi... Chà, chà.
Dialogue: 0,1:06:00.99,1:06:04.87,Default,,0,0,0,,Chuyện này đúng là quá tuyệt vời.
Dialogue: 0,1:06:05.00,1:06:06.96,Default,,0,0,0,,Mọi chuyện kết thúc rồi, Rugal.
Dialogue: 0,1:06:07.04,1:06:08.54,Default,,0,0,0,,Ồ, không đâu.
Dialogue: 0,1:06:08.63,1:06:09.83,Default,,0,0,0,,Không hề.
Dialogue: 0,1:06:09.92,1:06:11.42,Default,,0,0,0,,Cuộc vui giờ mới bắt đầu thôi.
Dialogue: 0,1:06:11.50,1:06:16.88,Default,,0,0,0,,(Chizuru) Kyo! Cậu làm được mà.
Dialogue: 0,1:06:20.01,1:06:26.31,Default,,0,0,0,,(Scott) Họ đã bị chia tách rồi.
Dialogue: 0,1:06:31.82,1:06:33.27,Default,,0,0,0,,Kyo đang phải một mình đối đầu với Rugal.
Dialogue: 0,1:06:33.36,1:06:41.36,Default,,0,0,0,,(Mai) Trời ơi...
Dialogue: 0,1:06:42.58,1:06:47.50,Default,,0,0,0,,Ngươi ở đâu?
Dialogue: 0,1:06:54.84,1:06:58.47,Default,,0,0,0,,(Chizuru) Nhanh lên, hãy tìm những mảnh bảo vật còn lại.
Dialogue: 0,1:06:58.55,1:07:03.22,Default,,0,0,0,,Cậu có biết nơi này là gì không?
Dialogue: 0,1:07:03.31,1:07:04.85,Default,,0,0,0,,Đây từng là sàn đấu yêu thích nhất của cha cậu đấy.
Dialogue: 0,1:07:04.93,1:07:12.93,Default,,0,0,0,,(Rugal) Đó từng là bối cảnh yêu thích nhất của cha cậu.
Dialogue: 0,1:07:18.32,1:07:20.41,Default,,0,0,0,,Ông ấy đã từng cố giết cậu, đúng không nào?
Dialogue: 0,1:07:20.49,1:07:23.07,Default,,0,0,0,,(Kyo) Không, đó là do Orochi.
Dialogue: 0,1:07:23.16,1:07:24.91,Default,,0,0,0,,Nó đã thao túng ông ấy. Nó ép ông ấy phải làm vậy.
Dialogue: 0,1:07:24.99,1:07:27.83,Default,,0,0,0,,Cha tôi không bao giờ làm tổn thương tôi cả.
Dialogue: 0,1:07:27.91,1:07:29.66,Default,,0,0,0,,Cha tôi yêu thương tôi!
Dialogue: 0,1:07:29.75,1:07:32.50,Default,,0,0,0,,(Rugal) Nào nào, chán ngắt thế này.
Dialogue: 0,1:07:45.81,1:07:47.97,Default,,0,0,0,,Đổi không khí một chút nhé.
Dialogue: 0,1:07:48.06,1:07:52.48,Default,,0,0,0,,Ta thấy... thế này bạo lực quá.
Dialogue: 0,1:07:52.56,1:07:57.98,Default,,0,0,0,,Ồ, thế này hơi mọi rợ quá nhỉ?
Dialogue: 0,1:07:58.07,1:08:01.80,Default,,0,0,0,,Đấy, thế này mới đúng điệu chứ.
Dialogue: 0,1:08:01.82,1:08:06.08,Default,,0,0,0,,Vào vị trí đập bóng nào.
Dialogue: 0,1:08:06.16,1:08:08.81,Default,,0,0,0,,Terry?
Dialogue: 0,1:08:08.83,1:08:11.71,Default,,0,0,0,,Terry...
Dialogue: 0,1:08:49.33,1:08:50.81,Default,,0,0,0,,Trời đất ơi. Có lẽ cô đã thực sự du hành sang một chiều không gian khác thật rồi.
Dialogue: 0,1:08:50.83,1:08:53.50,Default,,0,0,0,,Rất vui vì anh đã chịu tin.
Dialogue: 0,1:08:53.58,1:08:56.54,Default,,0,0,0,,Đây hẳn là điều Chizuru đã nói tới.
Dialogue: 0,1:08:56.63,1:08:59.46,Default,,0,0,0,,Hai thế giới đang sáp nhập vào nhau.
Dialogue: 0,1:08:59.55,1:09:06.05,Default,,0,0,0,,Tìm một cánh cửa mau!
Dialogue: 0,1:09:06.14,1:09:10.85,Default,,0,0,0,,(Người dẫn) Đang thi đấu, số 36, Rugal!
Dialogue: 0,1:09:22.90,1:09:25.32,Default,,0,0,0,,(Rugal) Kiếm đẹp đấy chàng trai.
Dialogue: 0,1:09:44.97,1:09:46.84,Default,,0,0,0,,Ta cũng phải kiếm một thanh như thế mới được!
Dialogue: 0,1:09:46.93,1:09:50.35,Default,,0,0,0,,(Rugal) Đủ trò chơi rồi đấy.
Dialogue: 0,1:10:16.12,1:10:18.67,Default,,0,0,0,,(Rugal) Ô kìa, Iori, ngươi đã quay lại rồi à!
Dialogue: 0,1:10:39.06,1:10:41.86,Default,,0,0,0,,Giờ thì trò chơi thực sự mới bắt đầu.
Dialogue: 0,1:10:41.94,1:10:49.20,Default,,0,0,0,,(Terry) Mai! Tôi nghĩ chúng ta vào nhầm cửa rồi!
Dialogue: 0,1:11:32.41,1:11:34.80,Default,,0,0,0,,(Mai) Anh nghĩ thế à?
Dialogue: 0,1:11:34.83,1:11:37.85,Default,,0,0,0,,(Người dẫn) Hiệp một! Rugal đối đầu Iori!
Dialogue: 0,1:11:37.87,1:11:42.96,Default,,0,0,0,,(Người dẫn) Chuẩn bị, bắt đầu!
Dialogue: 0,1:11:43.04,1:11:49.17,Default,,0,0,0,,(Terry) Mai!
Dialogue: 0,1:12:15.45,1:12:16.24,Default,,0,0,0,,(Mai) Tôi đang bận tay chút đây.
Dialogue: 0,1:12:16.33,1:12:17.99,Default,,0,0,0,,(Terry) Được rồi, ra đòn ngay!
Dialogue: 0,1:12:43.94,1:12:47.94,Default,,0,0,0,,(Terry) Mai, coi chừng!
Dialogue: 0,1:13:00.00,1:13:07.92,Default,,0,0,0,,(Mai) Phù.
Dialogue: 0,1:13:08.05,1:13:09.21,Default,,0,0,0,,Terry?
Dialogue: 0,1:13:09.30,1:13:13.76,Default,,0,0,0,,(Terry) Toàn mấy cánh cửa chết tiệt.
Dialogue: 0,1:13:37.57,1:13:38.91,Default,,0,0,0,,Tại sao chúng ta lại đuổi theo chúng chứ?
Dialogue: 0,1:13:38.99,1:13:41.08,Default,,0,0,0,,(Mai) Chúng sẽ dẫn chúng ta quay lại chỗ hắn.
Dialogue: 0,1:13:41.16,1:13:45.21,Default,,0,0,0,,Cứ bám sát tôi đi!
Dialogue: 0,1:13:45.29,1:13:47.58,Default,,0,0,0,,(Terry) Mai, chờ đã!
Dialogue: 0,1:13:57.76,1:14:05.76,Default,,0,0,0,,(Terry) Mai!
Dialogue: 0,1:14:14.53,1:14:18.45,Default,,0,0,0,,Cô đang bảo vệ cho hắn sao?
Dialogue: 0,1:14:49.44,1:14:53.36,Default,,0,0,0,,Cô có biết hắn là ai... hay hắn đã làm những gì không?
Dialogue: 0,1:14:53.44,1:14:57.45,Default,,0,0,0,,Lịch sử của các gia tộc giờ không còn quan trọng nữa.
Dialogue: 0,1:14:57.53,1:15:03.95,Default,,0,0,0,,Không phải lịch sử gia tộc, mà là ân oán giữa hắn và cha cậu kìa!
Dialogue: 0,1:15:04.04,1:15:12.04,Default,,0,0,0,,Chizuru cao quý đã triệu tập một cuộc họp đặc biệt giữa các gia tộc.
Dialogue: 0,1:15:18.97,1:15:20.43,Default,,0,0,0,,Iori, khi ấy hắn chỉ là một kẻ mới nhập môn, nhưng mang dòng máu Yagami,
Dialogue: 0,1:15:20.51,1:15:27.23,Default,,0,0,0,,và là người bảo hộ kề vai sát cánh bên cha cậu, Saisyu.
Dialogue: 0,1:15:27.31,1:15:32.27,Default,,0,0,0,,Hãy nhớ lấy điều này...
Dialogue: 0,1:15:32.36,1:15:38.07,Default,,0,0,0,,Ta đã đánh bại những kẻ mạnh nhất, và sẵn sàng
Dialogue: 0,1:15:38.15,1:15:40.82,Default,,0,0,0,,chiếm lấy những gì xứng đáng thuộc về ta, nhưng Saisyu không
Dialogue: 0,1:15:40.91,1:15:43.12,Default,,0,0,0,,chấp nhận điều đó, bởi vì ta đã dám làm điều mà không một ai khác
Dialogue: 0,1:15:43.20,1:15:47.16,Default,,0,0,0,,dám làm, đó là thâu tóm sức mạnh của Orochi...
Dialogue: 0,1:15:47.25,1:15:51.89,Default,,0,0,0,,Và nếu cha cậu không chịu dâng ngai vàng cho ta,
Dialogue: 0,1:15:51.92,1:15:58.63,Default,,0,0,0,,thì ta sẽ tự tay đoạt lấy nó!
Dialogue: 0,1:15:58.72,1:15:59.82,Default,,0,0,0,,Tất cả mọi người đều khiếp sợ Orochi,
Dialogue: 0,1:15:59.84,1:16:03.93,Default,,0,0,0,,khiếp sợ sức mạnh của nó, ngoại trừ Rugal này.
Dialogue: 0,1:16:14.90,1:16:16.90,Default,,0,0,0,,Các đại gia tộc hoàn toàn không phải đối thủ của ta.
Dialogue: 0,1:16:16.94,1:16:24.94,Default,,0,0,0,,Còn Iori, à...
Dialogue: 0,1:16:25.87,1:16:28.58,Default,,0,0,0,,hắn chỉ là không thể chấp nhận nổi thất bại.
Dialogue: 0,1:16:28.66,1:16:33.08,Default,,0,0,0,,Nên hắn đã dùng tới sức mạnh Orochi.
Dialogue: 0,1:16:33.17,1:16:41.17,Default,,0,0,0,,Nhưng hắn không tài nào kiểm soát nổi nó. Tội nghiệp gã trai.
Dialogue: 0,1:16:42.88,1:16:45.64,Default,,0,0,0,,Và trong cơn cuồng nộ mất trí, hắn đã hạ sát
Dialogue: 0,1:16:56.44,1:17:04.44,Default,,0,0,0,,vị Saisyu Kusanagi dũng mãnh vô địch.
Dialogue: 0,1:17:29.89,1:17:34.48,Default,,0,0,0,,Anh đã làm gì cơ chứ?
Dialogue: 0,1:17:34.56,1:17:40.11,Default,,0,0,0,,Iori, đừng!
Dialogue: 0,1:17:52.83,1:17:56.92,Default,,0,0,0,,Đừng trốn tránh nữa, Iori.
Dialogue: 0,1:18:18.61,1:18:22.53,Default,,0,0,0,,Giờ ngươi đã được tự do rồi.
Dialogue: 0,1:18:32.95,1:18:34.29,Default,,0,0,0,,Tại sao anh lại lừa dối tôi?
Dialogue: 0,1:18:34.37,1:18:38.37,Default,,0,0,0,,Hả?
Dialogue: 0,1:18:40.29,1:18:41.88,Default,,0,0,0,,Tôi không kiểm soát nổi nó!
Dialogue: 0,1:18:41.96,1:18:44.71,Default,,0,0,0,,Buông ra!
Dialogue: 0,1:18:44.80,1:18:46.92,Default,,0,0,0,,(Mai) Kyo!
Dialogue: 0,1:18:47.01,1:18:48.97,Default,,0,0,0,,A A A A!
Dialogue: 0,1:18:49.05,1:18:53.39,Default,,0,0,0,,Chẳng còn gì vui nữa rồi.
Dialogue: 0,1:18:58.77,1:19:06.77,Default,,0,0,0,,(Kyo) Cô có sao không?
Dialogue: 0,1:19:21.25,1:19:26.84,Default,,0,0,0,,(Mai) Tôi ổn. Iori... anh thế nào rồi?
Dialogue: 0,1:19:39.10,1:19:41.31,Default,,0,0,0,,(Rugal) Cảm động quá cơ.
Dialogue: 0,1:19:41.40,1:19:43.61,Default,,0,0,0,,Thật mừng khi thấy đội hình tụ họp lại đông đủ thế này.
Dialogue: 0,1:19:43.69,1:19:45.69,Default,,0,0,0,,(Chizuru) Không dễ thế đâu, Rugal.
Dialogue: 0,1:19:45.78,1:19:53.78,Default,,0,0,0,,(Rugal) Chizuru. Cô bận rộn gớm nhỉ.
Dialogue: 0,1:20:26.65,1:20:29.49,Default,,0,0,0,,Và ta thấy cô còn mang theo cả đồ chơi nữa.
Dialogue: 0,1:20:29.57,1:20:31.32,Default,,0,0,0,,(Chizuru) Phải mất một khoảng thời gian,
Dialogue: 0,1:20:31.40,1:20:32.91,Default,,0,0,0,,nhưng chúng tôi đã tìm thấy những mảnh ghép còn lại.
Dialogue: 0,1:20:32.99,1:20:33.86,Default,,0,0,0,,Ngươi tưởng mình biết tất cả về các bảo vật này sao?
Dialogue: 0,1:20:33.95,1:20:35.87,Default,,0,0,0,,Ngươi nhầm rồi. Đây là cơ hội cuối cùng cho ngươi đấy, Rugal.
Dialogue: 0,1:20:35.95,1:20:37.91,Default,,0,0,0,,(Rugal) Trước khi làm sao cơ?
Dialogue: 0,1:20:37.99,1:20:42.08,Default,,0,0,0,,(Chizuru) Kyo, hãy giương cao thanh kiếm của cậu lên.
Dialogue: 0,1:20:42.17,1:20:47.04,Default,,0,0,0,,(Chizuru) Iori!
Dialogue: 0,1:20:47.13,1:20:49.17,Default,,0,0,0,,(Rugal) Giờ ta đã quá hùng mạnh rồi.
Dialogue: 0,1:20:49.26,1:20:57.26,Default,,0,0,0,,Mấy món bảo vật quý giá của các ngươi chẳng có tác dụng gì với ta đâu!
Dialogue: 0,1:21:00.56,1:21:02.06,Default,,0,0,0,,(Mai) Rugal!
Dialogue: 0,1:21:02.14,1:21:04.65,Default,,0,0,0,,(Rugal) Chẳng lẽ không có ai ở đây...
Dialogue: 0,1:21:04.73,1:21:08.02,Default,,0,0,0,,đủ sức thách đấu với ta sao!
Dialogue: 0,1:21:13.20,1:21:14.22,Default,,0,0,0,,Anh đã ở đâu suốt thế hả?
Dialogue: 0,1:21:14.24,1:21:16.82,Default,,0,0,0,,Toàn mấy cánh cửa chết tiệt.
Dialogue: 0,1:21:53.32,1:21:54.19,Default,,0,0,0,,Khốn thật.
Dialogue: 0,1:21:54.28,1:21:56.16,Default,,0,0,0,,(Terry) Ồ, cứ để tôi lo vụ này.
Dialogue: 0,1:21:56.24,1:21:59.37,Default,,0,0,0,,Mai? M... Mai!
Dialogue: 0,1:21:59.45,1:22:04.12,Default,,0,0,0,,(Rugal) Lại đây, Iori, lại đây quyết đấu với ta.
Dialogue: 0,1:22:04.21,1:22:09.79,Default,,0,0,0,,(Iori) Dừng lại đi, Rugal. Ta biết ngươi đang mưu tính điều gì,
Dialogue: 0,1:22:50.63,1:22:52.92,Default,,0,0,0,,và lần này trò đó sẽ không hiệu nghiệm đâu.
Dialogue: 0,1:22:59.68,1:23:01.91,Default,,0,0,0,,(Kyo) Tôi không đủ mạnh mẽ.
Dialogue: 0,1:23:01.93,1:23:06.10,Default,,0,0,0,,(Iori) Cậu buộc phải làm được.
Dialogue: 0,1:23:29.62,1:23:31.04,Default,,0,0,0,,Chúng ta không còn lựa chọn nào khác.
Dialogue: 0,1:23:31.13,1:23:32.17,Default,,0,0,0,,(Kyo) Nhỡ tôi không làm được thì sao?
Dialogue: 0,1:23:32.25,1:23:33.46,Default,,0,0,0,,Thế thì tất cả chúng ta đều sẽ chết.
Dialogue: 0,1:23:33.55,1:23:34.63,Default,,0,0,0,,Ồ, lời động viên tuyệt vời đấy.
Dialogue: 0,1:23:34.71,1:23:38.38,Default,,0,0,0,,(Chizuru) Không. Mai.
Dialogue: 0,1:23:38.47,1:23:42.85,Default,,0,0,0,,Được rồi. Cô sẽ ổn thôi mà.
Dialogue: 0,1:23:42.93,1:23:44.43,Default,,0,0,0,,Không còn đường lui nữa rồi. Khốn khiếp thật.
Dialogue: 0,1:23:44.51,1:23:46.06,Default,,0,0,0,,(Chizuru) Chúng ta đã quá muộn.
Dialogue: 0,1:23:46.14,1:23:47.91,Default,,0,0,0,,Không, tôi có thể làm được, được chứ? Chỉ cần chỉ cho tôi cách.
Dialogue: 0,1:23:47.93,1:23:49.77,Default,,0,0,0,,Tôi không thể làm được nếu không có cô. Nghe tôi nói này.
Dialogue: 0,1:23:49.85,1:23:51.46,Default,,0,0,0,,Tôi không còn đường quay lại nữa đâu.
Dialogue: 0,1:23:51.48,1:23:53.44,Default,,0,0,0,,Cô biết điều đó mà.
Dialogue: 0,1:23:53.52,1:23:55.48,Default,,0,0,0,,Tôi cần cô hãy thay thế vị trí của tôi.
Dialogue: 0,1:23:55.57,1:23:59.96,Default,,0,0,0,,Chị nghĩ tôi là ai chứ?
Dialogue: 0,1:23:59.99,1:24:02.99,Default,,0,0,0,,Tôi không phải là chị, hiểu chứ? Tôi không thể. Và sẽ không bao giờ là chị được.
Dialogue: 0,1:24:03.07,1:24:06.37,Default,,0,0,0,,Tôi không cần cô phải trở thành tôi.
Dialogue: 0,1:24:06.45,1:24:09.87,Default,,0,0,0,,Tôi cần cô hãy là chính bản thân mình.
Dialogue: 0,1:24:09.96,1:24:13.54,Default,,0,0,0,,(Rugal) Ngươi cần ta!
Dialogue: 0,1:24:13.63,1:24:17.96,Default,,0,0,0,,A A A A!
Dialogue: 0,1:25:01.55,1:25:09.14,Default,,0,0,0,,(Rugal) Tới luôn đi, cưng.
Dialogue: 0,1:25:09.22,1:25:14.85,Default,,0,0,0,,Ta sẽ vui vẻ đùa giỡn với ngươi thật thỏa thích.
Dialogue: 0,1:25:40.55,1:25:43.47,Default,,0,0,0,,(Kyo) Đùa với cái này này.
Dialogue: 0,1:25:43.51,1:25:50.68,Default,,0,0,0,,(Rugal) Ta vẫn chưa xong với ngươi đâu, Kusanagi!
Dialogue: 0,1:25:50.77,1:25:57.94,Default,,0,0,0,,(Rugal) Ông ấy đã từng cố giết cậu, đúng không nào?
Dialogue: 0,1:26:02.44,1:26:10.44,Default,,0,0,0,,(Rugal) Giờ ta đã quá hùng mạnh rồi.
Dialogue: 0,1:26:12.12,1:26:20.12,Default,,0,0,0,,(Rugal) Không phải lịch sử gia tộc, mà là ân oán giữa hắn và cha cậu kìa!
Dialogue: 0,1:26:21.63,1:26:29.63,Default,,0,0,0,,(Rugal) Đứng dậy mau.
Dialogue: 0,1:26:33.02,1:26:39.90,Default,,0,0,0,,(Terry) Vậy giờ cậu định tính sao?
Dialogue: 0,1:26:39.98,1:26:43.23,Default,,0,0,0,,(Kyo) Chà, tôi đoán chúng ta nên tiếp tục gìn giữ truyền thống.
Dialogue: 0,1:28:25.46,1:28:30.07,Default,,0,0,0,,Tiếp tục duy trì giải đấu.
Dialogue: 0,1:28:30.09,1:28:33.30,Default,,0,0,0,,Thật sao?
Dialogue: 0,1:28:33.39,1:28:35.60,Default,,0,0,0,,Chà, Chizuru ở nơi chín suối hẳn sẽ rất vui lòng.
Dialogue: 0,1:28:35.68,1:28:37.81,Default,,0,0,0,,Thực ra về mặt kỹ thuật, chúng ta có thể bắt đầu ngay hôm nay.
Dialogue: 0,1:28:37.89,1:28:41.02,Default,,0,0,0,,Ý tôi là, tất cả những gì tôi cần làm chỉ là tái cấu hình lại dữ liệu...
Dialogue: 0,1:28:41.10,1:28:43.02,Default,,0,0,0,,và nếu các anh vẫn còn giữ tai nghe truyền dẫn, chúng ta có thể...
Dialogue: 0,1:28:43.10,1:28:44.33,Default,,0,0,0,,Này mọi người, các người đi đâu thế? C... Chờ tôi với!
Dialogue: 0,1:28:44.36,1:28:45.86,Default,,0,0,0,,(Saisyu) Con trai của ta...
Dialogue: 0,1:28:45.94,1:28:48.00,Default,,0,0,0,,Đã đến lúc con đối mặt với vận mệnh của chính mình.
Dialogue: 0,1:28:48.03,1:28:56.03,Default,,0,0,0,,Hành trình này đã mang lại cho con những người bạn đích thực.
Dialogue: 0,1:29:03.12,1:29:05.96,Default,,0,0,0,,Hãy tin tưởng họ.
Dialogue: 0,1:29:06.04,1:29:09.96,Default,,0,0,0,,Nước khéo làm lợi cho vạn vật muôn loài,
Dialogue: 0,1:29:10.05,1:29:12.99,Default,,0,0,0,,mà không hề tranh giành cùng ai.
Dialogue: 0,1:29:13.01,1:29:18.10,Default,,0,0,0,,Nó ở những nơi người đời đều ghét bỏ.
Dialogue: 0,1:29:18.18,1:29:20.81,Default,,0,0,0,,Bởi vậy, nó ở gần với Đạo...
Dialogue: 0,1:29:20.89,1:29:23.64,Default,,0,0,0,,(Bảo tồn nguyên vẹn 100% dòng thoại)
Dialogue: 0,1:29:23.73,1:29:28.07,Default,,0,0,0,,(Phụ đề Việt ngữ chuẩn Fansub)
Dialogue: 0,1:29:28.15,1:29:33.61,Default,,0,0,0,,(King of Fighters 2010)
