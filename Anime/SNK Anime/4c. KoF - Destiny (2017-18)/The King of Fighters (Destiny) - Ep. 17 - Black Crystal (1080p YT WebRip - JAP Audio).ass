Dialogue: 0,0:00:01.96,0:00:06.90,Default,,0,0,0,,Đừng hòng đánh bại tao! Đừng lo, Angelina!
Dialogue: 0,0:00:09.60,0:00:10.60,Default,,0,0,0,,Không, dừng lại đi!
Dialogue: 0,0:00:11.82,0:00:17.28,Default,,0,0,0,,Thật tàn nhẫn! Tao tuyệt đối không tha thứ cho mày! Tao sẽ cho mày nếm mùi tuyệt kỹ tối thượng!
Dialogue: 0,0:00:17.28,0:00:20.46,Default,,0,0,0,,Chết đi, Geese Howard! Power Geyser!
Dialogue: 0,0:00:50.06,0:00:58.06,Default,,0,0,0,,Theo truyền thuyết 1.800 năm trước, Ma Thần Orochi cùng bè lũ Bát Kiệt Tập đã âm mưu hủy diệt nhân loại, biến tất cả về cõi hư vô.
Dialogue: 0,0:00:58.78,0:01:05.28,Default,,0,0,0,,Hắn đã bị phong ấn bởi tam đại thần khí của ba gia tộc Kusanagi, Yagami và Yata.
Dialogue: 0,0:01:06.28,0:01:11.70,Default,,0,0,0,,Tam đại thần khí được chia cho hậu duệ của ba gia tộc và vẫn được canh giữ cẩn mật cho tới tận ngày nay.
Dialogue: 0,0:02:25.84,0:02:33.84,Default,,0,0,0,,Giờ đây, ký ức trước mắt dẫu cho thế giới có đổi thay và quay lưng, ta vẫn sẽ kiên định chỉ vì người. Ta nguyện bảo vệ trọn vẹn thế giới này, dốc hết con tim cho những mảnh linh hồn thất lạc...
Dialogue: 0,0:02:41.19,0:02:49.19,Default,,0,0,0,,Mấy cô gái chúng mình!
Dialogue: 0,0:03:05.50,0:03:06.79,Default,,0,0,0,,Đã đến giờ bắt đầu bữa tiệc rồi.
Dialogue: 0,0:03:14.27,0:03:17.15,Default,,0,0,0,,Tên ngốc đó lại chạy đi đâu mất rồi nhỉ?
Dialogue: 0,0:03:18.66,0:03:20.27,Default,,0,0,0,,Tìm thấy là em không tha cho đâu đấy!
Dialogue: 0,0:03:36.07,0:03:38.69,Default,,0,0,0,,Kìa, ai lại làm đổ vỡ ly rượu thế kia?
Dialogue: 0,0:03:41.07,0:03:42.95,Default,,0,0,0,,Anh hai, bố đâu rồi ạ?
Dialogue: 0,0:03:44.18,0:03:46.71,Default,,0,0,0,,Ông già á, chắc lại ăn uống linh tinh trúng thực nên đang nằm ngủ ở nhà rồi.
Dialogue: 0,0:03:48.13,0:03:53.15,Default,,0,0,0,,Nói dối. Chắc bố thấy xấu hổ vì để thua chúng ta nên trốn biệt tăm thì có.
Dialogue: 0,0:03:54.71,0:03:55.97,Default,,0,0,0,,Không được nói xấu bố như thế!
Dialogue: 0,0:03:56.17,0:03:57.75,Default,,0,0,0,,Nói xấu đấy, nói xấu đấy, nói xấu đấy!
Dialogue: 0,0:03:58.83,0:04:00.15,Default,,0,0,0,,Thôi được rồi, anh chịu thua em luôn.
Dialogue: 0,0:04:03.61,0:04:07.51,Default,,0,0,0,,Này, hay là hai cậu chuyển sang học làm đầu bếp đi? Hãy rửa tay gác kiếm về với chính đạo.
Dialogue: 0,0:04:07.93,0:04:10.11,Default,,0,0,0,,Hả, bọn em mà cũng mặc vừa áo đầu bếp sao đại ca?
Dialogue: 0,0:04:10.55,0:04:14.03,Default,,0,0,0,,Có công mài sắt có ngày nên kim. Bất kể trong quá khứ các cậu đã từng phạm phải lỗi lầm gì.
Dialogue: 0,0:04:15.35,0:04:23.35,Default,,0,0,0,,Chỉ cần thành tâm khổ luyện để tu tâm dưỡng tính. Đúng thế, từ nay về sau hãy cống hiến trọn đời cho tu luyện. Nào, trước tiên đứng co một chân lên để luyện tấn!
Dialogue: 0,0:04:23.57,0:04:24.71,Default,,0,0,0,,Hả? Bắt đầu ngay bây giờ luôn á?!
Dialogue: 0,0:05:04.20,0:05:09.46,Default,,0,0,0,,Lão sư, Heidern và đội của ông ấy sắp đến nơi rồi. Nhưng con có linh cảm rất xấu.
Dialogue: 0,0:05:10.79,0:05:13.80,Default,,0,0,0,,Để xem Athena có thể dùng năng lực ngoại cảm cảm nhận được điều gì không.
Dialogue: 0,0:05:25.97,0:05:26.98,Default,,0,0,0,,Đồ phàm ăn tục uống này!
Dialogue: 0,0:05:29.00,0:05:30.00,Default,,0,0,0,,Á?
Dialogue: 0,0:05:45.48,0:05:47.68,Default,,0,0,0,,Athena, con cảm nhận được gì rồi?
Dialogue: 0,0:05:48.56,0:05:51.92,Default,,0,0,0,,Năng lực siêu nhiên của con đang bị một luồng tà khí hắc ám áp chế hoàn toàn.
Dialogue: 0,0:05:52.90,0:05:53.90,Default,,0,0,0,,Đó chính là sức mạnh của Orochi.
Dialogue: 0,0:06:00.96,0:06:05.30,Default,,0,0,0,,Cậu làm cái trò gì thế hả? Xin lỗi quý khách. Coi chừng!
Dialogue: 0,0:06:08.00,0:06:12.10,Default,,0,0,0,,Làm cái trò gì thế hả! Đợi đã! Hỏng hết kiểu tóc vuốt keo của ta rồi!
Dialogue: 0,0:06:13.14,0:06:19.10,Default,,0,0,0,,Mọi người coi chừng!
Dialogue: 0,0:06:25.69,0:06:26.69,Default,,0,0,0,,Ồ?
Dialogue: 0,0:06:34.25,0:06:35.77,Default,,0,0,0,,Chuyện gì thế?
Dialogue: 0,0:06:36.77,0:06:38.25,Default,,0,0,0,,Luồng khí này...
Dialogue: 0,0:06:38.77,0:06:39.77,Default,,0,0,0,,Hử?
Dialogue: 0,0:06:42.31,0:06:43.31,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:47.40,0:06:48.40,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:06:48.50,0:06:50.60,Default,,0,0,0,,Nguy hiểm! Tất cả mau tập hợp lại!
Dialogue: 0,0:06:51.98,0:06:52.10,Default,,0,0,0,,Hử?
Dialogue: 0,0:06:52.72,0:06:53.72,Default,,0,0,0,,Ôi!
Dialogue: 0,0:06:53.96,0:06:54.96,Default,,0,0,0,,A!
Dialogue: 0,0:07:05.70,0:07:07.38,Default,,0,0,0,,Chết rồi!
Dialogue: 0,0:07:52.38,0:07:56.06,Default,,0,0,0,,Các người... các người là ai...?!
Dialogue: 0,0:08:15.58,0:08:18.16,Default,,0,0,0,,Thưa ngài Rugal, mọi thứ đã sẵn sàng.
Dialogue: 0,0:08:18.76,0:08:20.56,Default,,0,0,0,,Mở cửa đại sảnh ra.
Dialogue: 0,0:08:21.68,0:08:23.28,Default,,0,0,0,,Cậu thấy thế nào?
Dialogue: 0,0:08:23.94,0:08:31.94,Default,,0,0,0,,Chà, đây chính là sào huyệt của chúng. Cách duy nhất để biết tại sao chúng lại gom tất cả võ sĩ chúng ta về một chỗ là cứ vào trong xem sao.
Dialogue: 0,0:08:32.48,0:08:33.62,Default,,0,0,0,,Khoan đã, mùi gì kỳ lạ thế này?
Dialogue: 0,0:08:34.26,0:08:35.26,Default,,0,0,0,,Không xong rồi!
Dialogue: 0,0:08:43.02,0:08:45.38,Default,,0,0,0,,Hả? Mọi người chạy đi đâu loạn xạ thế?
Dialogue: 0,0:08:49.12,0:08:50.66,Default,,0,0,0,,Có vẻ kẻ địch đã bắt đầu hành động.
Dialogue: 0,0:08:52.35,0:08:57.66,Default,,0,0,0,,Mau xem xét tình hình. Tất cả nín thở! Vẫn còn khí độc trong không khí!
Dialogue: 0,0:09:08.23,0:09:09.26,Default,,0,0,0,,Chúng ta chia nhau ra tìm kiếm.
Dialogue: 0,0:09:09.54,0:09:11.28,Default,,0,0,0,,Hừm. Cậu cũng phải cẩn thận đấy.
Dialogue: 0,0:09:12.12,0:09:14.20,Default,,0,0,0,,Xem ra chúng ta như chuột sa vào bẫy rồi.
Dialogue: 0,0:10:01.64,0:10:02.64,Default,,0,0,0,,Benimaru!
Dialogue: 0,0:10:10.84,0:10:12.14,Default,,0,0,0,,Hai người bị mắc kẹt ở đây sao?
Dialogue: 0,0:10:29.04,0:10:30.58,Default,,0,0,0,,Daimon, Benimaru, là tôi đây mà!
Dialogue: 0,0:11:09.21,0:11:17.21,Default,,0,0,0,,Rốt cuộc hai người bị làm sao thế này?! Tỉnh lại đi! Tình trạng này y hệt như Đội Thể Thao Mỹ lúc trước. Chẳng lẽ do khí độc kích phát sao?
Dialogue: 0,0:11:32.25,0:11:37.23,Default,,0,0,0,,Viên tinh thể đen rốt cuộc ở đâu? Đáng lẽ nó phải ở trong căn phòng này chứ.
Dialogue: 0,0:14:12.69,0:14:14.09,Default,,0,0,0,,Cảm ơn quý vị đã theo dõi.
Dialogue: 0,0:16:45.32,0:16:53.32,Default,,0,0,0,,Một bóng đen bí ẩn xuất hiện, mang theo luồng tà khí ngút trời.
