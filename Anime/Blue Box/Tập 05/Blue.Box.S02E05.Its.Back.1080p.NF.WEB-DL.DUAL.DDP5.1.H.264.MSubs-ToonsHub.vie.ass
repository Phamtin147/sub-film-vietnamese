Dialogue: 0,0:00:27.99,0:00:29.78,Default,,0,0,0,,Xin lỗi vì đã làm phiền cậu.
Dialogue: 0,0:00:33.37,0:00:36.29,Default,,0,0,0,,{\i1}Nếu mình tiếp tục ở bên cạnh Natsu...{\i0}
Dialogue: 0,0:00:36.29,0:00:40.75,Default,,0,0,0,,{\i1}liệu mình có lại yêu bóng rổ thêm một lần nữa không?{\i0}
Dialogue: 0,0:00:45.50,0:00:46.46,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:00:46.46,0:00:50.71,Default,,0,0,0,,Đây là vé xem trận đấu Cúp Mùa Đông\Ncủa chị Chinatsu.
Dialogue: 0,0:00:52.01,0:00:53.93,Default,,0,0,0,,Tớ tặng nó cho cậu.
Dialogue: 0,0:00:59.14,0:01:00.73,Default,,0,0,0,,Người đi không thể là tớ được.
Dialogue: 0,0:01:01.39,0:01:03.35,Default,,0,0,0,,Nếu là về bóng rổ...\Nngười đó nhất định phải là cậu.
Dialogue: 0,0:01:07.07,0:01:10.41,Default,,0,0,0,,Tớ tin chắc cậu sẽ nhận ra\Nmình vẫn còn yêu bóng rổ nhiều đến nhường nào.
Dialogue: 0,0:01:50.65,0:01:52.90,Default,,0,0,0,,Eimei! Eimei!
Dialogue: 0,0:02:04.58,0:02:05.54,Default,,0,0,0,,{\i1}Cậu ấy giỏi thật.{\i0}
Dialogue: 0,0:02:06.67,0:02:09.42,Default,,0,0,0,,{\i1}Cậu ấy nhìn ra hướng di chuyển cắt vào rổ của Natsu.{\i0}
Dialogue: 0,0:02:21.14,0:02:25.35,Default,,0,0,0,,{\i1}Khả năng phòng ngự chặt chẽ\Nđang giúp họ thi đấu đầy lấn lướt.{\i0}
Dialogue: 0,0:02:25.35,0:02:28.77,Default,,0,0,0,,Eimei! Eimei! Eimei!
Dialogue: 0,0:02:39.28,0:02:43.53,Default,,0,0,0,,{\i1}Thời gian lúc nào cũng trôi nhanh thế này sao?{\i0}
Dialogue: 0,0:02:44.66,0:02:49.17,Default,,0,0,0,,{\i1}Mình vẫn nhớ mỗi một giây trong trận đấu\Nđều trôi qua nghẹt thở và dồn dập đến mức nào.{\i0}
Dialogue: 0,0:02:49.75,0:02:52.50,Default,,0,0,0,,{\i1}Và khi tiếng còi mãn cuộc vang lên,\Ncảm giác như mọi thứ chỉ vừa thoáng qua trong chớp mắt.{\i0}
Dialogue: 0,0:03:18.20,0:03:19.79,Default,,0,0,0,,{\i1}Đã hai năm rồi...{\i0}
Dialogue: 0,0:03:22.12,0:03:25.37,Default,,0,0,0,,{\i1}Mới chỉ có hai năm thôi sao...{\i0}
Dialogue: 0,0:03:29.46,0:03:33.63,Default,,0,0,0,,BLUE BOX - MÙA 2
Dialogue: 0,0:04:56.63,0:04:59.30,Default,,0,0,0,,TẬP 30\NNGỌN LỬA TRỞ LẠI
Dialogue: 0,0:04:59.30,0:05:00.97,Default,,0,0,0,,TRƯỜNG TRUNG HỌC TƯ THỤC EIMEI
Dialogue: 0,0:05:08.02,0:05:11.23,Default,,0,0,0,,{\i1}Mong là Yumeka đã đến đó.{\i0}
Dialogue: 0,0:05:17.69,0:05:21.65,Default,,0,0,0,,{\i1}Lẽ ra mình có nên nói trước với chị Chinatsu không nhỉ?{\i0}
Dialogue: 0,0:05:21.65,0:05:24.28,Default,,0,0,0,,{\i1}Nhưng ngộ nhỡ rốt cuộc cậu ấy lại không đi thì...{\i0}
Dialogue: 0,0:05:36.59,0:05:38.76,Default,,0,0,0,,{\i1}Một chú tuần lộc đang gặp khó khăn sao?{\i0}
Dialogue: 0,0:05:39.84,0:05:43.34,Default,,0,0,0,,Cần tớ giúp một tay không?
Dialogue: 0,0:05:54.81,0:05:56.52,Default,,0,0,0,,Bộ trang phục đó là sao thế kia?
Dialogue: 0,0:05:57.11,0:06:00.07,Default,,0,0,0,,Bọn tớ muốn khuấy động không khí Giáng sinh một chút ấy mà.
Dialogue: 0,0:06:00.07,0:06:03.28,Default,,0,0,0,,Nên cả đội thể dục dụng cụ nghệ thuật\Nđều mặc đồ hóa trang hết.
Dialogue: 0,0:06:03.28,0:06:05.20,Default,,0,0,0,,Mặc thế này di chuyển không thấy vướng víu à?
Dialogue: 0,0:06:05.20,0:06:06.53,Default,,0,0,0,,Ấm áp và dễ chịu lắm luôn đấy.
Dialogue: 0,0:06:07.62,0:06:10.04,Default,,0,0,0,,Ừm, công nhận là đậm chất không khí Giáng sinh thật.
Dialogue: 0,0:06:11.12,0:06:14.04,Default,,0,0,0,,Tận hưởng những dịp thế này cũng quan trọng lắm chứ.
Dialogue: 0,0:06:15.12,0:06:18.66,Default,,0,0,0,,{\i1}Bọn tớ sẽ đi hát liên khúc Giáng sinh ở quán karaoke,{\i0}
Dialogue: 0,0:06:18.67,0:06:22.13,Default,,0,0,0,,{\i1}và trước đó sẽ ghé buồng chụp ảnh lấy liền nữa.{\i0}
Dialogue: 0,0:06:22.13,0:06:26.30,Default,,0,0,0,,{\i1}Hôm nay tớ còn tự thưởng cho bản thân\Nđược ăn bánh kem thỏa thích luôn đấy.{\i0}
Dialogue: 0,0:06:27.85,0:06:30.81,Default,,0,0,0,,Đâu cần phải có bạn trai\Nmới vui được chứ, đúng không?
Dialogue: 0,0:06:33.31,0:06:35.31,Default,,0,0,0,,{\an8}Tớ chẳng biết phải đáp lại câu đó thế nào nữa.
Dialogue: 0,0:06:38.06,0:06:40.44,Default,,0,0,0,,Cứ ôm nỗi tiếc nuối đó mà sống tiếp đi nhá.
Dialogue: 0,0:06:42.78,0:06:44.16,Default,,0,0,0,,Để đây là được rồi.
Dialogue: 0,0:06:48.62,0:06:50.08,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:06:50.95,0:06:51.91,Default,,0,0,0,,Hina này.
Dialogue: 0,0:07:03.51,0:07:06.30,Default,,0,0,0,,Nhớ hát bài của Mariah cho Moriya nghe đấy nhé.
Dialogue: 0,0:07:06.30,0:07:08.64,Default,,0,0,0,,Đương nhiên rồi, bài tủ trong danh sách của tớ mà lại.
Dialogue: 0,0:07:08.64,0:07:11.35,Default,,0,0,0,,Hôm nay tớ sẽ hát cho tới khi khản cả giọng luôn!
Dialogue: 0,0:07:11.35,0:07:13.73,Default,,0,0,0,,Nhớ mua sẵn vài viên kẹo ngậm ho đấy!
Dialogue: 0,0:07:37.58,0:07:40.25,Default,,0,0,0,,Đêm Giáng sinh rồi sao?
Dialogue: 0,0:07:41.09,0:07:43.09,Default,,0,0,0,,Khi người ta hỏi cậu làm gì vào dịp Giáng sinh,
Dialogue: 0,0:07:43.09,0:07:46.93,Default,,0,0,0,,cảm giác như họ đang hỏi xem\Nđiều gì là quan trọng nhất đối với cậu vậy, đúng chứ?
Dialogue: 0,0:07:46.92,0:07:47.88,Default,,0,0,0,,Chẳng hẳn là thế.
Dialogue: 0,0:07:48.55,0:07:53.47,Default,,0,0,0,,{\an8}Mọi người thường dành ngày này bên những người thân yêu,\Nnhư bạn bè và gia đình thôi.
Dialogue: 0,0:07:53.47,0:07:57.47,Default,,0,0,0,,Nói cách khác...\Ntớ chỉ có mỗi câu lạc bộ cầu lông này thôi!
Dialogue: 0,0:07:57.48,0:07:59.69,Default,,0,0,0,,Cầu lông chính là điều quan trọng nhất đối với tớ!
Dialogue: 0,0:07:59.69,0:08:01.11,Default,,0,0,0,,Thế thì có gì sai chứ?!
Dialogue: 0,0:08:01.11,0:08:03.61,Default,,0,0,0,,Thực ra tớ cũng muốn được đi hẹn hò lắm chứ bộ!
Dialogue: 0,0:08:03.61,0:08:04.74,Default,,0,0,0,,Lòi cái đuôi thật lòng ra rồi nhé.
Dialogue: 0,0:08:04.73,0:08:07.44,Default,,0,0,0,,Tao ghét cay ghét đắng mấy đứa có người yêu ghê!
Dialogue: 0,0:08:07.45,0:08:09.58,Default,,0,0,0,,Yêu đương cũng chẳng phải chuyện dễ dàng đâu.
Dialogue: 0,0:08:11.24,0:08:14.37,Default,,0,0,0,,Tao chẳng bao giờ biết nên tặng quà gì cho cô ấy,
Dialogue: 0,0:08:14.37,0:08:17.92,Default,,0,0,0,,chưa kể Giáng sinh mà muốn đi đâu cũng phải đặt bàn trước nữa.
Dialogue: 0,0:08:17.91,0:08:20.83,Default,,0,0,0,,Đó chính xác là những gì tao hằng ao ước được trải nghiệm đấy!
Dialogue: 0,0:08:21.79,0:08:23.79,Default,,0,0,0,,Số nhọ thật đấy, Taiki.
Dialogue: 0,0:08:23.79,0:08:27.34,Default,,0,0,0,,Chắc chú mày cũng đã mong mỏi\Nđược ở bên chị ấy lắm đúng không?
Dialogue: 0,0:08:29.26,0:08:33.85,Default,,0,0,0,,Em đâu phải bạn trai của chị ấy đâu,\Nnên Giáng sinh vốn chẳng nằm trong kế hoạch của em rồi.
Dialogue: 0,0:08:34.64,0:08:35.85,Default,,0,0,0,,Hơn nữa...
Dialogue: 0,0:08:37.02,0:08:40.19,Default,,0,0,0,,{\an8}{\i1}Chị Chinatsu còn có việc quan trọng hơn nhiều cần phải làm.{\i0}
Dialogue: 0,0:08:43.90,0:08:46.36,Default,,0,0,0,,Nếu Giáng sinh là để dành cho những điều quan trọng nhất,
Dialogue: 0,0:08:46.36,0:08:49.24,Default,,0,0,0,,thì còn cách nào tuyệt vời hơn là đắm mình vào đam mê của bản thân chứ?
Dialogue: 0,0:08:52.45,0:08:53.33,Default,,0,0,0,,{\i1}Dù thế nào đi nữa...{\i0}
Dialogue: 0,0:08:54.78,0:08:57.82,Default,,0,0,0,,{\i1}mong rằng đây sẽ là một Đêm Giáng sinh thật đẹp.{\i0}
Dialogue: 0,0:08:59.29,0:09:01.17,Default,,0,0,0,,{\i1}Cả đối với Yumeka nữa.{\i0}
Dialogue: 0,0:09:07.17,0:09:08.67,Default,,0,0,0,,EIMEI 59 - KIRIGASAKI 55
Dialogue: 0,0:09:08.67,0:09:09.59,Default,,0,0,0,,Eimei!
Dialogue: 0,0:09:13.26,0:09:14.18,Default,,0,0,0,,Suýt chút nữa thôi!
Dialogue: 0,0:09:24.27,0:09:26.02,Default,,0,0,0,,Được lắm!
Dialogue: 0,0:09:26.02,0:09:27.44,Default,,0,0,0,,Cố lên các cậu!
Dialogue: 0,0:10:15.62,0:10:17.04,Default,,0,0,0,,{\i1}Vẫn chưa kết thúc đâu!{\i0}
Dialogue: 0,0:10:18.03,0:10:21.95,Default,,0,0,0,,Eimei! Eimei! Eimei!
Dialogue: 0,0:10:40.64,0:10:42.22,Default,,0,0,0,,Cố lên, Natsu!
Dialogue: 0,0:11:14.17,0:11:15.46,Default,,0,0,0,,Vào rồi!
Dialogue: 0,0:11:20.10,0:11:22.52,Default,,0,0,0,,TRƯỜNG THPT TƯ THỤC EIMEI\NHỌC VIỆN KIRIGASAKI
Dialogue: 0,0:11:39.12,0:11:43.29,Default,,0,0,0,,Yumeka, sao cậu lại ở đây?
Dialogue: 0,0:11:44.45,0:11:47.54,Default,,0,0,0,,Cậu nhóc năm nhất bên CLB cầu lông đã đưa vé cho tớ.
Dialogue: 0,0:11:49.38,0:11:51.76,Default,,0,0,0,,Chúc mừng cậu đã vượt qua vòng đầu tiên nhé.
Dialogue: 0,0:11:51.75,0:11:53.79,Default,,0,0,0,,Đó là một trận đấu tuyệt vời.
Dialogue: 0,0:11:57.68,0:11:59.01,Default,,0,0,0,,Xin lỗi cậu về chuyện trước đây nhé.
Dialogue: 0,0:11:59.01,0:12:02.56,Default,,0,0,0,,Vì đã nói những lời khiến cậu cảm thấy\Nnhư thể bản thân đang lơ là chểnh mảng.
Dialogue: 0,0:12:04.01,0:12:06.93,Default,,0,0,0,,Hóa ra chỉ là do tớ quá hẹp hòi mà thôi.
Dialogue: 0,0:12:08.56,0:12:11.15,Default,,0,0,0,,Tớ cũng xin lỗi cậu nữa.
Dialogue: 0,0:12:12.27,0:12:13.98,Default,,0,0,0,,Tớ cũng chẳng hơn gì cậu,
Dialogue: 0,0:12:13.98,0:12:18.07,Default,,0,0,0,,bởi vì tớ cũng đâu có nói ra\Nnhững tâm tư thật lòng trong lòng mình.
Dialogue: 0,0:12:21.16,0:12:22.16,Default,,0,0,0,,Tớ...
Dialogue: 0,0:12:22.78,0:12:26.58,Default,,0,0,0,,thực sự muốn được chơi bóng rổ cùng cậu nhiều hơn nữa.
Dialogue: 0,0:12:28.41,0:12:31.71,Default,,0,0,0,,Tớ không hề muốn cậu từ bỏ bóng rổ chút nào.
Dialogue: 0,0:12:35.38,0:12:38.63,Default,,0,0,0,,Giá như ngày đó cậu tâm sự với tớ trước khi bỏ cuộc...
Dialogue: 0,0:12:39.30,0:12:42.14,Default,,0,0,0,,thì khi ấy, tớ đã có thể...
Dialogue: 0,0:12:43.43,0:12:46.35,Default,,0,0,0,,Sao cậu lại khóc thế?
Dialogue: 0,0:12:47.10,0:12:48.31,Default,,0,0,0,,Cậu cũng đang khóc đấy thôi.
Dialogue: 0,0:12:48.31,0:12:49.73,Default,,0,0,0,,Tớ đâu có...
Dialogue: 0,0:12:52.02,0:12:56.02,Default,,0,0,0,,Tớ cũng muốn được chơi bóng rổ cùng cậu nhiều hơn mà.
Dialogue: 0,0:12:56.69,0:12:59.61,Default,,0,0,0,,Vậy tại sao cậu lại bỏ cuộc chứ?
Dialogue: 0,0:13:00.20,0:13:01.49,Default,,0,0,0,,Xin lỗi cậu nhé.
Dialogue: 0,0:13:01.49,0:13:03.20,Default,,0,0,0,,Tớ nhớ cậu nhiều lắm.
Dialogue: 0,0:13:04.24,0:13:06.62,Default,,0,0,0,,Ừm, tớ xin lỗi.
Dialogue: 0,0:13:07.20,0:13:08.12,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:13:08.75,0:13:10.96,Default,,0,0,0,,Sao hai đứa lại ôm nhau khóc nức nở thế kia?
Dialogue: 0,0:13:11.96,0:13:13.54,Default,,0,0,0,,Tại Yumeka hết đấy.
Dialogue: 0,0:13:13.54,0:13:14.71,Default,,0,0,0,,Tại Natsu đấy chứ.
Dialogue: 0,0:13:14.71,0:13:18.34,Default,,0,0,0,,Hai đứa tưởng mình còn là con nít chắc?
Dialogue: 0,0:13:29.31,0:13:31.31,Default,,0,0,0,,Phải như thế này nè!
Dialogue: 0,0:13:32.39,0:13:33.23,Default,,0,0,0,,Hiểu chưa hả?
Dialogue: 0,0:13:45.03,0:13:46.99,Default,,0,0,0,,{\an8}{\i1}Không có gì mạnh mẽ hơn tình yêu thương.{\i0}
Dialogue: 0,0:13:47.91,0:13:51.33,Default,,0,0,0,,{\i1}Không chỉ đơn thuần là ta sẽ giỏi giang ở những thứ mình yêu thích,{\i0}
Dialogue: 0,0:13:51.33,0:13:56.71,Default,,0,0,0,,{\i1}mà việc có được một điều quan trọng đối với bản thân sẽ tiếp thêm sức mạnh cho ta.{\i0}
Dialogue: 0,0:13:56.71,0:13:58.30,Default,,0,0,0,,{\i1}Đó chính là sự khẳng định bản thân tuyệt đối nhất.{\i0}
Dialogue: 0,0:13:59.63,0:14:00.59,Default,,0,0,0,,Natsu này.
Dialogue: 0,0:14:03.30,0:14:05.51,Default,,0,0,0,,Chúng ta hãy lại cùng nhau chơi bóng rổ nhé.
Dialogue: 0,0:14:16.23,0:14:17.31,Default,,0,0,0,,Ừm!
Dialogue: 0,0:14:25.41,0:14:26.54,Default,,0,0,0,,{\i1}Bố ơi.{\i0}
Dialogue: 0,0:14:27.53,0:14:28.78,Default,,0,0,0,,{\i1}Bố biết gì không?{\i0}
Dialogue: 0,0:14:29.83,0:14:31.83,Default,,0,0,0,,{\i1}Sức mạnh của con đã trở lại rồi.{\i0}
Dialogue: 0,0:14:46.34,0:14:47.26,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:14:47.26,0:14:51.68,Default,,0,0,0,,Đêm Giáng sinh đã tới rồi!
Dialogue: 0,0:14:52.68,0:14:56.73,Default,,0,0,0,,Ngày Chúa sinh ra đời! Nói cách khác,\Nđây chính là ngày tôn vinh sự sống!
Dialogue: 0,0:14:56.73,0:14:58.94,Default,,0,0,0,,Và điều đó biến hôm nay trở thành\Nngày hoàn hảo nhất để tập thể lực!
Dialogue: 0,0:14:58.94,0:15:00.77,Default,,0,0,0,,Rõ!
Dialogue: 0,0:15:00.77,0:15:03.94,Default,,0,0,0,,Xem ra mấy cậu không cần đồ ngọt rồi nhỉ.
Dialogue: 0,0:15:05.40,0:15:08.45,Default,,0,0,0,,Tiếc ghê. Ông già Noel Ayame\Nvừa mang bánh quy đến cho mọi người nè.
Dialogue: 0,0:15:10.78,0:15:12.03,Default,,0,0,0,,Ông già Noel muôn năm!
Dialogue: 0,0:15:12.04,0:15:13.54,Default,,0,0,0,,Bọn em ăn được không ạ?
Dialogue: 0,0:15:13.54,0:15:14.54,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:15:14.54,0:15:15.75,Default,,0,0,0,,Của các em đây.
Dialogue: 0,0:15:15.75,0:15:18.63,Default,,0,0,0,,Vui quá đi mất!
Dialogue: 0,0:15:20.88,0:15:22.38,Default,,0,0,0,,Của cậu đây.
Dialogue: 0,0:15:23.17,0:15:24.67,Default,,0,0,0,,Nhiều thế này luôn á?
Dialogue: 0,0:15:24.67,0:15:29.09,Default,,0,0,0,,Tớ làm thêm cho cả các em của cậu nữa đấy,\Ntại còn thừa nguyên liệu mà.
Dialogue: 0,0:15:29.09,0:15:31.38,Default,,0,0,0,,Cậu đâu cần phải cất công phiền phức thế.
Dialogue: 0,0:15:32.35,0:15:34.39,Default,,0,0,0,,Có gì phiền đâu chứ.
Dialogue: 0,0:15:34.39,0:15:36.60,Default,,0,0,0,,Cứ ngoan ngoãn nói lời cảm ơn đi xem nào?
Dialogue: 0,0:15:36.60,0:15:39.02,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:15:40.19,0:15:41.44,Default,,0,0,0,,Tốt lắm!
Dialogue: 0,0:15:42.11,0:15:44.61,Default,,0,0,0,,Quản lý ơi, cho em xin một cái với được không ạ?
Dialogue: 0,0:15:44.61,0:15:45.53,Default,,0,0,0,,Tới liền đây!
Dialogue: 0,0:15:55.79,0:15:57.67,Default,,0,0,0,,Kyo, hôm nay vất vả rồi nhé!
Dialogue: 0,0:15:57.67,0:15:58.92,Default,,0,0,0,,Cậu cũng vậy.
Dialogue: 0,0:16:13.89,0:16:15.77,Default,,0,0,0,,Gặp lại sau nhé.
Dialogue: 0,0:16:15.77,0:16:19.65,Default,,0,0,0,,Này Kyo, Giáng sinh vui vẻ nhé.
Dialogue: 0,0:16:19.65,0:16:20.82,Default,,0,0,0,,Cảm ơn nhé, cậu cũng vậy.
Dialogue: 0,0:16:22.56,0:16:24.31,Default,,0,0,0,,Hinacchi, Niina ơi!
Dialogue: 0,0:16:24.32,0:16:26.78,Default,,0,0,0,,Một đàn chị trong đội\Ncó phiếu giảm giá đi hát karaoke này!
Dialogue: 0,0:16:26.78,0:16:27.70,Default,,0,0,0,,Thật á?
Dialogue: 0,0:16:27.70,0:16:28.66,Default,,0,0,0,,Tuyệt quá đi!
Dialogue: 0,0:16:28.65,0:16:30.03,Default,,0,0,0,,Đi thôi nào!
Dialogue: 0,0:16:30.03,0:16:32.24,Default,,0,0,0,,- Đi thôi!\N- Hôm nay tớ sẽ hát cho đã đời luôn!
Dialogue: 0,0:16:32.24,0:16:33.95,Default,,0,0,0,,Cảm ơn anh nhé.
Dialogue: 0,0:16:35.24,0:16:38.03,Default,,0,0,0,,{\i1}Giờ này chắc trận đấu đã kết thúc rồi nhỉ?{\i0}
Dialogue: 0,0:16:38.04,0:16:39.50,Default,,0,0,0,,{\i1}Ước gì mình ít nhất cũng biết được chị ấy có thắng hay không.{\i0}
Dialogue: 0,0:16:39.50,0:16:41.96,Default,,0,0,0,,Nào nào, mau đi tập thể lực thôi!
Dialogue: 0,0:16:42.54,0:16:45.08,Default,,0,0,0,,Hôm nay chúng ta sẽ ăn ức gà\Nthay vì gà rán KFC!
Dialogue: 0,0:16:45.09,0:16:48.05,Default,,0,0,0,,Và uống sữa bột whey protein\Nthay cho bánh kem Giáng sinh!
Dialogue: 0,0:16:48.05,0:16:50.09,Default,,0,0,0,,Em chỉ muốn tận hưởng Đêm Giáng sinh thôi mà...
Dialogue: 0,0:16:50.09,0:16:53.09,Default,,0,0,0,,Protein mới là tình yêu đích thực của chúng ta, nhớ chưa hả?!
Dialogue: 0,0:16:57.18,0:16:59.52,Default,,0,0,0,,Được rồi, thế thì đi thôi!
Dialogue: 0,0:16:59.52,0:17:01.11,Default,,0,0,0,,Tinh thần phải như thế chứ!
Dialogue: 0,0:17:01.69,0:17:03.86,Default,,0,0,0,,{\i1}Mình rất muốn biết chuyện giữa hai người họ ra sao,{\i0}
Dialogue: 0,0:17:03.86,0:17:06.11,Default,,0,0,0,,{\i1}nhưng mình không muốn xen vào làm phiền.{\i0}
Dialogue: 0,0:17:07.40,0:17:09.90,Default,,0,0,0,,{\i1}Hơn nữa, Đêm Giáng sinh một năm chỉ có một lần thôi mà.{\i0}
Dialogue: 0,0:17:15.74,0:17:16.66,Default,,0,0,0,,KHÔNG PHẢI TẤT CAO QUA GỐI ĐÂU...
Dialogue: 0,0:17:32.18,0:17:33.64,Default,,0,0,0,,{\i1}Mình cũng nên cố gắng tận hưởng nó mới phải!{\i0}
Dialogue: 0,0:17:41.60,0:17:44.14,Default,,0,0,0,,Nhớ gửi lời cảm ơn cậu ấy vì chiếc vé giúp tớ nhé.
Dialogue: 0,0:17:44.15,0:17:46.78,Default,,0,0,0,,Có vẻ cậu ấy đã phải tốn rất nhiều công sức mới lấy được nó đấy.
Dialogue: 0,0:17:48.23,0:17:49.77,Default,,0,0,0,,Chinatsu ơi.
Dialogue: 0,0:17:50.82,0:17:52.99,Default,,0,0,0,,Mọi người chuẩn bị đi ăn tối cùng nhau rồi này.
Dialogue: 0,0:17:52.99,0:17:54.33,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:17:55.49,0:17:57.08,Default,,0,0,0,,Xin lỗi chị nhé, Nagisa-senpai.
Dialogue: 0,0:17:58.83,0:18:01.00,Default,,0,0,0,,Em vừa nhớ ra mình có việc phải đi làm ngay bây giờ.
Dialogue: 0,0:18:01.00,0:18:03.42,Default,,0,0,0,,Ừ, chị hiểu rồi.
Dialogue: 0,0:18:11.34,0:18:13.43,Default,,0,0,0,,Con về rồi đây ạ.
Dialogue: 0,0:18:15.39,0:18:17.43,Default,,0,0,0,,{\i1}Cậu ấy vẫn chưa về nhà.{\i0}
Dialogue: 0,0:18:21.73,0:18:23.02,Default,,0,0,0,,Mừng em về nhà!
Dialogue: 0,0:18:23.02,0:18:24.44,Default,,0,0,0,,Trước hết, chúc mừng chị đã...
Dialogue: 0,0:18:25.65,0:18:26.69,Default,,0,0,0,,Ơ kìa?
Dialogue: 0,0:18:27.48,0:18:29.77,Default,,0,0,0,,{\i1}Có lẽ chị ấy vừa chạy ra cửa hàng tiện lợi rồi.{\i0}
Dialogue: 0,0:18:41.91,0:18:44.08,Default,,0,0,0,,ĐỀN OYASU
Dialogue: 0,0:18:53.67,0:18:55.46,Default,,0,0,0,,ELEVEN SEVEN\NATM - RƯỢU - THUỐC LÁ
Dialogue: 0,0:19:23.83,0:19:26.92,Default,,0,0,0,,TRƯỜNG THPT TƯ THỤC EIMEI
Dialogue: 0,0:20:01.53,0:20:05.53,Default,,0,0,0,,{\i1}Chuông ngân vang, chuông reo vui vang lừng\NNgân nga khắp muôn nơi rộn rã{\i0}
Dialogue: 0,0:20:05.54,0:20:07.54,Default,,0,0,0,,{\i1}Ôi thật vui sướng biết bao khi được lướt đi{\i0}
Dialogue: 0,0:20:07.54,0:20:09.54,Default,,0,0,0,,{\i1}Trên cỗ xe trượt tuyết một ngựa kéo thênh thang{\i0}
Dialogue: 0,0:20:09.54,0:20:13.38,Default,,0,0,0,,{\i1}Chuông ngân vang, chuông reo vui vang lừng\NNgân nga khắp muôn nơi rộn rã{\i0}
Dialogue: 0,0:20:13.38,0:20:17.55,Default,,0,0,0,,{\i1}Ôi thật vui sướng biết bao khi được lướt đi\NTrên cỗ xe trượt tuyết một ngựa kéo thênh thang{\i0}
Dialogue: 0,0:20:17.55,0:20:19.47,Default,,0,0,0,,Tuyệt vời quá!
Dialogue: 0,0:20:20.97,0:20:23.18,Default,,0,0,0,,Kìa, là Kano kìa.
Dialogue: 0,0:20:23.18,0:20:24.72,Default,,0,0,0,,Hôm nay em có trận thi đấu cơ mà đúng không?
Dialogue: 0,0:20:24.72,0:20:27.97,Default,,0,0,0,,Em ghé qua để lấy đồ để quên thôi ạ.
Dialogue: 0,0:20:27.98,0:20:31.23,Default,,0,0,0,,Sao em không vào tham gia tiệc Giáng sinh cùng bọn anh luôn đi?
Dialogue: 0,0:20:31.23,0:20:34.48,Default,,0,0,0,,Ban nhạc rock của trường\Nđang tổ chức biểu diễn Giáng sinh đấy.
Dialogue: 0,0:20:34.48,0:20:38.78,Default,,0,0,0,,Thằng Nishida vừa đùn hết việc dọn dẹp cho một đứa đàn em\Nđể chạy sang đây hóng hớt đấy.
Dialogue: 0,0:20:38.78,0:20:40.11,Default,,0,0,0,,Thằng nhóc Taiki bảo nó không phiền mà lại!
Dialogue: 0,0:20:40.11,0:20:44.49,Default,,0,0,0,,Nhắc mới nhớ, bạn của Taiki\Ncó đến xem trận đấu của em không thế?
Dialogue: 0,0:20:44.49,0:20:45.57,Default,,0,0,0,,Dạ?
Dialogue: 0,0:20:45.58,0:20:47.62,Default,,0,0,0,,Thằng nhóc bảo là nó nhường lại vé cho cô bạn ấy mà.
Dialogue: 0,0:20:47.62,0:20:51.00,Default,,0,0,0,,Em có tin được là nó đã phải đấu chạy con thoi\Nvới thằng Matsuoka chỉ để giành chiếc vé đó không?
Dialogue: 0,0:20:51.00,0:20:52.67,Default,,0,0,0,,Là chạy con thoi vượt giới hạn đúng không ạ?
Dialogue: 0,0:20:52.67,0:20:55.13,Default,,0,0,0,,Nó chạy thục mạng tới mức suýt thì không đứng vững nổi luôn.
Dialogue: 0,0:20:55.13,0:20:57.51,Default,,0,0,0,,Anh cứ thắc mắc mãi...
Dialogue: 0,0:20:57.51,0:21:01.10,Default,,0,0,0,,không biết người bạn nào quan trọng đến mức khiến nó\Nphải liều mạng nhường vé đến như thế.
Dialogue: 0,0:21:01.09,0:21:04.43,Default,,0,0,0,,Khoan đã, đừng nói cô bạn đó là bạn gái nó nhé?
Dialogue: 0,0:21:05.68,0:21:06.60,Default,,0,0,0,,Hở?
Dialogue: 0,0:21:06.60,0:21:08.94,Default,,0,0,0,,Em ấy bảo là mình có việc\Nquan trọng cần phải giải quyết rồi.
Dialogue: 0,0:21:09.56,0:21:10.81,Default,,0,0,0,,Được rồi, đến bài hát tiếp theo nào!
Dialogue: 0,0:23:48.97,0:23:53.98,Default,,0,0,0,,{\an8}Phụ đề Việt ngữ bởi: Amtia(NOFACE)
