Dialogue: 0,0:00:15.39,0:00:17.06,Default,,0,0,0,,Xin lỗi Nagisa.
Dialogue: 0,0:00:17.64,0:00:19.89,Default,,0,0,0,,Tớ chợt nhớ là có việc cần làm.
Dialogue: 0,0:00:19.89,0:00:22.31,Default,,0,0,0,,Được rồi, đã hiểu.
Dialogue: 0,0:00:27.03,0:00:30.33,Default,,0,0,0,,{\an8}TRUNG HỌC TƯ THỤC EIMEI
Dialogue: 0,0:00:53.18,0:00:55.10,Default,,0,0,0,,ĐỒ TRANG TRÍ
Dialogue: 0,0:01:26.71,0:01:28.71,Default,,0,0,0,,Chị làm em sợ hú hồn!
Dialogue: 0,0:01:28.71,0:01:30.59,Default,,0,0,0,,Đừng dọa em thế chứ!
Dialogue: 0,0:01:30.59,0:01:34.18,Default,,0,0,0,,- Xin lỗi.\N- Tưởng chị là ma đó.
Dialogue: 0,0:01:34.18,0:01:36.02,Default,,0,0,0,,Không phải Ông già Noel à?
Dialogue: 0,0:01:36.64,0:01:37.52,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:01:47.11,0:01:50.20,Default,,0,0,0,,Khoan, chị làm gì ở đây?
Dialogue: 0,0:01:50.19,0:01:51.53,Default,,0,0,0,,Trận đấu thế nào rồi?
Dialogue: 0,0:01:53.61,0:01:55.28,Default,,0,0,0,,Bọn chị qua vòng một rồi.
Dialogue: 0,0:01:56.87,0:01:58.29,Default,,0,0,0,,Chúc mừng.
Dialogue: 0,0:01:59.08,0:02:00.29,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:02:00.91,0:02:03.29,Default,,0,0,0,,Với cả, cảm ơn vì tấm vé.
Dialogue: 0,0:02:05.96,0:02:09.34,Default,,0,0,0,,Nhờ em mà chị làm hòa được với Yumeka.
Dialogue: 0,0:02:13.93,0:02:17.81,Default,,0,0,0,,Nghe nói em đã chạy rất nhiều vì tấm vé.
Dialogue: 0,0:02:18.30,0:02:19.38,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:02:19.39,0:02:21.31,Default,,0,0,0,,Có gì đâu!
Dialogue: 0,0:02:21.89,0:02:23.68,Default,,0,0,0,,Chạy nhẹ nhàng chút ấy mà.
Dialogue: 0,0:02:26.48,0:02:29.48,Default,,0,0,0,,Thực ra chị vốn biết từ bấy lâu.
Dialogue: 0,0:02:30.78,0:02:33.53,Default,,0,0,0,,{\i1}Rằng Yumeka đang vật lộn với vấn đề gì đó.{\i0}
Dialogue: 0,0:02:34.95,0:02:40.41,Default,,0,0,0,,Nhưng chị chẳng nói gì\Nvì cậu ấy chưa từng nhắc tới.
Dialogue: 0,0:02:56.51,0:02:58.55,Default,,0,0,0,,Chị thực sự hối hận.
Dialogue: 0,0:02:59.05,0:03:04.10,Default,,0,0,0,,Nhưng hôm nay chị đã có thể\Ngiải tỏa phần nào sự hối hận đó.
Dialogue: 0,0:03:05.27,0:03:09.44,Default,,0,0,0,,Thế nên chị rất biết ơn Taiki đấy.
Dialogue: 0,0:03:14.11,0:03:16.82,Default,,0,0,0,,Từ tận đáy lòng.
Dialogue: 0,0:03:20.45,0:03:23.95,Default,,0,0,0,,Chị không cần... cảm ơn em.
Dialogue: 0,0:03:29.88,0:03:34.30,Default,,0,0,0,,Cũng như chị Yumeka thúc đẩy chị,
Dialogue: 0,0:03:35.42,0:03:38.67,Default,,0,0,0,,chị cũng thúc đẩy em mà.
Dialogue: 0,0:03:40.39,0:03:42.43,Default,,0,0,0,,Em chỉ hồi đáp ơn nghĩa thôi!
Dialogue: 0,0:04:36.03,0:04:37.16,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:05:07.52,0:05:08.44,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:05:14.77,0:05:15.94,Default,,0,0,0,,Hãy để chị...
Dialogue: 0,0:05:17.36,0:05:18.86,Default,,0,0,0,,được ôm em một chút.
Dialogue: 0,0:05:57.48,0:06:01.65,Default,,0,0,0,,BLUE BOX - MÙA 2
Dialogue: 0,0:07:24.57,0:07:28.66,Default,,0,0,0,,TẬP 31\NĐÊM GIÁNG SINH
Dialogue: 0,0:08:23.46,0:08:24.46,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:08:29.18,0:08:30.18,Default,,0,0,0,,Có gì đâu.
Dialogue: 0,0:08:44.36,0:08:45.36,Default,,0,0,0,,Này...
Dialogue: 0,0:08:46.32,0:08:47.49,Default,,0,0,0,,Chị Chinatsu...
Dialogue: 0,0:08:53.41,0:08:55.00,Default,,0,0,0,,Ta nên mau đi thôi.
Dialogue: 0,0:08:56.91,0:08:57.99,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:09:03.33,0:09:04.67,Default,,0,0,0,,Ồ, Chinatsu?
Dialogue: 0,0:09:13.05,0:09:15.64,Default,,0,0,0,,{\i1}Vừa rồi là gì vậy?{\i0}
Dialogue: 0,0:09:17.52,0:09:19.73,Default,,0,0,0,,{\i1}Chị ấy... đã ôm mình!{\i0}
Dialogue: 0,0:09:21.48,0:09:24.07,Default,,0,0,0,,{\i1}Vai mình vẫn còn hơi ấm của chị ấy.{\i0}
Dialogue: 0,0:09:30.49,0:09:32.74,Default,,0,0,0,,{\i1}Chắc do căng thẳng vì trận ngày mai{\i0}
Dialogue: 0,0:09:32.74,0:09:34.99,Default,,0,0,0,,{\i1}và chị ấy muốn được trấn an.{\i0}
Dialogue: 0,0:09:35.99,0:09:39.41,Default,,0,0,0,,{\i1}Hay là chị ấy thấy xúc động{\i0}
Dialogue: 0,0:09:40.00,0:09:41.79,Default,,0,0,0,,{\i1}vì đã làm lành với Yumeka?{\i0}
Dialogue: 0,0:09:43.12,0:09:44.16,Default,,0,0,0,,{\i1}Hay có lẽ...{\i0}
Dialogue: 0,0:09:47.04,0:09:48.37,Default,,0,0,0,,Này Taiki!
Dialogue: 0,0:09:48.38,0:09:50.30,Default,,0,0,0,,Cậu qua đây đi!
Dialogue: 0,0:09:56.97,0:09:58.39,Default,,0,0,0,,{\i1}Có lẽ nào?{\i0}
Dialogue: 0,0:10:35.68,0:10:37.68,Default,,0,0,0,,Mẹ ơi! Chị Chinatsu đâu?
Dialogue: 0,0:10:38.39,0:10:40.10,Default,,0,0,0,,Con bé đi từ lâu rồi.
Dialogue: 0,0:10:40.89,0:10:43.02,Default,,0,0,0,,Trận vòng hai sẽ vào lúc 1:00 chiều.
Dialogue: 0,0:10:43.85,0:10:45.18,Default,,0,0,0,,Ra thế.
Dialogue: 0,0:10:45.19,0:10:47.69,Default,,0,0,0,,Chiều nay con có buổi tập cầu lông nhỉ?
Dialogue: 0,0:10:47.69,0:10:49.61,Default,,0,0,0,,Mau chuẩn bị đi.
Dialogue: 0,0:10:49.61,0:10:50.86,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:11:04.21,0:11:07.46,Default,,0,0,0,,- Sao thẫn thờ thế?\N- Có gì đâu.
Dialogue: 0,0:11:08.58,0:11:10.21,Default,,0,0,0,,Tớ cần ghé qua lớp học đã!
Dialogue: 0,0:11:18.14,0:11:21.27,Default,,0,0,0,,{\i1}Mình cứ nghĩ về ngày hôm qua.{\i0}
Dialogue: 0,0:11:25.35,0:11:29.90,Default,,0,0,0,,{\i1}Mình muốn hỏi chị ấy thêm về Yumeka.{\i0}
Dialogue: 0,0:11:30.69,0:11:34.53,Default,,0,0,0,,{\i1}Giờ họ đã làm lành rồi,\Nchị Yumeka có chơi bóng rổ nữa không?{\i0}
Dialogue: 0,0:11:35.49,0:11:39.16,Default,,0,0,0,,{\i1}Chắc hẳn như thế\Nthì chị Chinatsu sẽ rất vui.{\i0}
Dialogue: 0,0:11:40.99,0:11:42.37,Default,,0,0,0,,{\i1}Vui đến mức chị ấy...{\i0}
Dialogue: 0,0:11:45.12,0:11:48.29,Default,,0,0,0,,{\i1}Mình cứ nghĩ về chuyện đó!{\i0}
Dialogue: 0,0:11:49.13,0:11:51.55,Default,,0,0,0,,Ngoài răng ra cậu còn đau chỗ nào nữa à?
Dialogue: 0,0:12:02.97,0:12:05.18,Default,,0,0,0,,Chị Yumeka, tóc chị...
Dialogue: 0,0:12:07.39,0:12:10.18,Default,,0,0,0,,Lúc này trong năm\Nmà để tóc ngắn thì lạnh lắm.
Dialogue: 0,0:12:12.27,0:12:14.19,Default,,0,0,0,,Chơi bóng thì tóc dài vướng lắm.
Dialogue: 0,0:12:18.28,0:12:19.49,Default,,0,0,0,,Có lẽ đã kém đi,
Dialogue: 0,0:12:20.07,0:12:23.07,Default,,0,0,0,,nhưng tôi tính gia nhập\Nđội bóng rổ trường tôi.
Dialogue: 0,0:12:24.29,0:12:25.83,Default,,0,0,0,,Ra thế.
Dialogue: 0,0:12:25.83,0:12:30.50,Default,,0,0,0,,Tôi sẽ phải tập điên cuồng\Nnếu muốn bắt kịp với Natsu.
Dialogue: 0,0:12:32.92,0:12:36.17,Default,,0,0,0,,{\i1}Mình vừa đem lại một đối thủ đáng gờm...?{\i0}
Dialogue: 0,0:12:36.84,0:12:41.05,Default,,0,0,0,,Thế nên để giúp\NNatsu không phí thời gian như tôi,
Dialogue: 0,0:12:41.05,0:12:42.76,Default,,0,0,0,,ủng hộ cậu ấy nhiệt thành đi.
Dialogue: 0,0:12:43.64,0:12:45.27,Default,,0,0,0,,Cậu là bạn trai cậu ấy mà.
Dialogue: 0,0:12:49.85,0:12:52.27,Default,,0,0,0,,- Không phải đâu!\N- Gì chứ?
Dialogue: 0,0:12:53.06,0:12:55.77,Default,,0,0,0,,Chị hiểu nhầm rồi!
Dialogue: 0,0:12:56.48,0:12:58.77,Default,,0,0,0,,Cậu cũng có bạn trai à?
Dialogue: 0,0:12:59.61,0:13:01.99,Default,,0,0,0,,{\i1}Khoan, mình đã bảo chị ấy hiểu sai đâu?{\i0}
Dialogue: 0,0:13:02.66,0:13:04.16,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:13:05.08,0:13:08.21,Default,,0,0,0,,Ra cậu còn chẳng phải bạn trai Natsu,
Dialogue: 0,0:13:08.20,0:13:12.12,Default,,0,0,0,,vậy mà chịu vất vả như thế\Nchỉ để lấy vé giúp cậu ấy à?
Dialogue: 0,0:13:12.67,0:13:14.51,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:13:15.17,0:13:17.34,Default,,0,0,0,,Cậu có tình cảm với Natsu nhỉ?
Dialogue: 0,0:13:18.92,0:13:19.92,Default,,0,0,0,,Ờm...
Dialogue: 0,0:13:20.84,0:13:23.01,Default,,0,0,0,,Cậu ấy từ chối cậu hay gì hả?
Dialogue: 0,0:13:23.01,0:13:26.01,Default,,0,0,0,,Em chưa thổ lộ với chị ấy.
Dialogue: 0,0:13:26.72,0:13:28.85,Default,,0,0,0,,Cái đồ bánh kẹp thịt gà hèn nhát.
Dialogue: 0,0:13:28.85,0:13:30.81,Default,,0,0,0,,GÀ
Dialogue: 0,0:13:30.81,0:13:32.27,Default,,0,0,0,,Sao lại là bánh kẹp?
Dialogue: 0,0:13:32.90,0:13:36.15,Default,,0,0,0,,Nhưng có lẽ cũng khó đọc tâm ý Natsu.
Dialogue: 0,0:13:37.07,0:13:39.66,Default,,0,0,0,,Cậu ấy chưa từng\Ntỏ vẻ quan tâm đến hẹn hò.
Dialogue: 0,0:13:40.36,0:13:41.95,Default,,0,0,0,,Chính là thế đấy.
Dialogue: 0,0:13:43.45,0:13:45.24,Default,,0,0,0,,Đừng lấy cớ nữa.
Dialogue: 0,0:13:53.67,0:13:56.26,Default,,0,0,0,,{\i1}Yêu là cảm xúc mạnh mẽ nhất đấy nhé.{\i0}
Dialogue: 0,0:13:59.09,0:14:01.51,Default,,0,0,0,,{\an8}{\i1}Hôm sau, chị Chinatsu và đội bóng rổ nữ{\i0}
Dialogue: 0,0:14:02.47,0:14:05.26,Default,,0,0,0,,{\an8}{\i1}đã thua ở vòng thứ ba.{\i0}
Dialogue: 0,0:14:05.26,0:14:08.35,Default,,0,0,0,,{\an8}{\i1}Rồi đối thủ đó của họ thắng cả giải đấu.{\i0}
Dialogue: 0,0:14:08.35,0:14:09.27,Default,,0,0,0,,{\an8}NHÀ VÔ ĐỊCH
Dialogue: 0,0:14:09.27,0:14:11.69,Default,,0,0,0,,{\i1}Mặc dù vậy, bất chấp thất bại cay đắng,{\i0}
Dialogue: 0,0:14:12.31,0:14:16.40,Default,,0,0,0,,{\i1}giải đấu vẫn cho họ cảm giác\Nrằng họ đã tiến xa hơn lần trước.{\i0}
Dialogue: 0,0:14:17.77,0:14:21.32,Default,,0,0,0,,{\i1}Giữa bộn bề mọi việc,\Nmình không có thì giờ hỏi chị ấy...{\i0}
Dialogue: 0,0:14:22.78,0:14:25.78,Default,,0,0,0,,{\i1}ý nghĩa của cái ôm đó.{\i0}
Dialogue: 0,0:14:40.84,0:14:44.63,Default,,0,0,0,,Bố mẹ cháu sẽ tới Nhật vào 8:00 tối nhỉ?
Dialogue: 0,0:14:44.63,0:14:48.13,Default,,0,0,0,,Vâng. Nên cháu tính\Nsẽ rời nhà lúc 6:00 để gặp họ.
Dialogue: 0,0:14:48.14,0:14:51.44,Default,,0,0,0,,Sau đó thì đi thăm ông ở Nagano,
Dialogue: 0,0:14:52.06,0:14:53.94,Default,,0,0,0,,rồi ở đó cho tới năm mới nhỉ?
Dialogue: 0,0:14:54.60,0:14:56.98,Default,,0,0,0,,Nhà cô sẽ nhớ cháu lắm!
Dialogue: 0,0:14:57.52,0:14:58.77,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:14:58.77,0:15:03.03,Default,,0,0,0,,Đầu tóc gì mà bù xù thế?\NChải chuốt lại đi chứ!
Dialogue: 0,0:15:12.37,0:15:13.87,Default,,0,0,0,,Con đi gội đầu đây!
Dialogue: 0,0:15:14.54,0:15:16.58,Default,,0,0,0,,Gội đầu nhiều quá sẽ hói đấy.
Dialogue: 0,0:15:24.34,0:15:26.59,Default,,0,0,0,,{\i1}Mình nên cư xử bên chị ấy ra sao?{\i0}
Dialogue: 0,0:15:27.18,0:15:30.06,Default,,0,0,0,,{\i1}Mẹ ở nhà suốt\Nnên mình đâu thể nói gì với chị ấy.{\i0}
Dialogue: 0,0:15:36.27,0:15:37.56,Default,,0,0,0,,{\i1}Cứ cái đà này...{\i0}
Dialogue: 0,0:15:42.94,0:15:44.78,Default,,0,0,0,,Đến lúc tổng vệ sinh cuối năm.
Dialogue: 0,0:15:45.28,0:15:47.66,Default,,0,0,0,,Nơi này phải sạch không một vết bẩn!
Dialogue: 0,0:15:47.66,0:15:49.45,Default,,0,0,0,,- Vâng ạ!\N- Vâng ạ!
Dialogue: 0,0:15:51.41,0:15:55.46,Default,,0,0,0,,Taiki, chỗ đó sạch rồi,\Ngiúp dọn chỗ khác đi nhé?
Dialogue: 0,0:15:56.04,0:15:56.96,Default,,0,0,0,,Vâng ạ!
Dialogue: 0,0:16:04.55,0:16:07.97,Default,,0,0,0,,{\i1}Nhìn bên ngoài,\Nchị ấy hành xử như chẳng có gì.{\i0}
Dialogue: 0,0:16:08.80,0:16:10.80,Default,,0,0,0,,{\i1}Mình đã mơ ra chuyện đó à?{\i0}
Dialogue: 0,0:16:16.10,0:16:19.02,Default,,0,0,0,,Hay ta cứ giữ cái cây như thế cả năm?
Dialogue: 0,0:16:19.02,0:16:21.23,Default,,0,0,0,,- Gì cơ?\N- Này cậu!
Dialogue: 0,0:16:22.27,0:16:23.98,Default,,0,0,0,,Đừng lau kiểu xoa xoa thế!
Dialogue: 0,0:16:24.57,0:16:27.20,Default,,0,0,0,,Phải đưa tay lên xuống theo đường thẳng!
Dialogue: 0,0:16:27.19,0:16:29.23,Default,,0,0,0,,Và đừng bỏ sót bụi ở góc phòng!
Dialogue: 0,0:16:29.91,0:16:32.75,Default,,0,0,0,,{\an8}Mấy vết bẩn quái ác mau hiện ra đi!
Dialogue: 0,0:16:32.74,0:16:35.20,Default,,0,0,0,,{\an8}Đâu ngờ quản lý soi mói về vụ dọn dẹp.
Dialogue: 0,0:16:35.20,0:16:37.58,Default,,0,0,0,,{\an8}Hồi đầu đã mừng vì quản lý dễ thương,
Dialogue: 0,0:16:37.58,0:16:39.00,Default,,0,0,0,,{\an8}mà cậu ấy khó hơn mẹ tớ!
Dialogue: 0,0:16:39.58,0:16:42.33,Default,,0,0,0,,- Đừng lảng vảng ở đây nữa, Inota.\N- Tớ chỉ...
Dialogue: 0,0:16:42.33,0:16:46.25,Default,,0,0,0,,Nếu đã làm xong việc của cậu,\Nhãy đi kiểm tra lại các thiết bị đi!
Dialogue: 0,0:16:51.84,0:16:55.26,Default,,0,0,0,,{\i1}Thật khó tin đây là nơi\Ncả hai trải qua đêm Giáng sinh đó.{\i0}
Dialogue: 0,0:16:56.47,0:16:58.35,Default,,0,0,0,,{\i1}Chắc hẳn là do mình mơ thấy.{\i0}
Dialogue: 0,0:17:01.94,0:17:03.03,Default,,0,0,0,,Chào nhóc.
Dialogue: 0,0:17:03.81,0:17:04.98,Default,,0,0,0,,Cậu vất vả rồi.
Dialogue: 0,0:17:04.98,0:17:06.73,Default,,0,0,0,,Ờm, mọi người cũng vậy.
Dialogue: 0,0:17:08.11,0:17:10.78,Default,,0,0,0,,Xem ra ta có hết đồ ở đây rồi.
Dialogue: 0,0:17:10.78,0:17:12.49,Default,,0,0,0,,Có vẻ là thế.
Dialogue: 0,0:17:12.49,0:17:13.49,Default,,0,0,0,,Phải.
Dialogue: 0,0:17:14.53,0:17:15.53,Default,,0,0,0,,{\i1}Thấy đó?{\i0}
Dialogue: 0,0:17:16.04,0:17:18.46,Default,,0,0,0,,{\i1}Chị Chinatsu cư xử như bình thường.{\i0}
Dialogue: 0,0:17:19.16,0:17:21.45,Default,,0,0,0,,{\i1}Như cái ôm đó không hề xảy ra.{\i0}
Dialogue: 0,0:17:21.46,0:17:23.05,Default,,0,0,0,,Xin phép cho đi qua nhé.
Dialogue: 0,0:17:35.35,0:17:36.48,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:17:38.06,0:17:39.85,Default,,0,0,0,,Có gì đâu, không phiền.
Dialogue: 0,0:17:40.77,0:17:41.94,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:17:44.56,0:17:47.40,Default,,0,0,0,,Tớ đi nộp cái này.\NCậu lo mọi việc ở đây nhé?
Dialogue: 0,0:17:47.40,0:17:48.40,Default,,0,0,0,,Được.
Dialogue: 0,0:18:00.54,0:18:03.00,Default,,0,0,0,,Chuyện lần trước ấy có khiến em thấy...
Dialogue: 0,0:18:06.29,0:18:07.29,Default,,0,0,0,,khó chịu không?
Dialogue: 0,0:18:14.34,0:18:18.18,Default,,0,0,0,,{\i1}Không, không hề...{\i0}
Dialogue: 0,0:18:20.27,0:18:22.86,Default,,0,0,0,,- Mà...\N- Này!
Dialogue: 0,0:18:22.85,0:18:25.60,Default,,0,0,0,,Họ mang nước hoa quả cho ta này!
Dialogue: 0,0:18:34.07,0:18:35.78,Default,,0,0,0,,{\i1}Dĩ nhiên mình không khó chịu!{\i0}
Dialogue: 0,0:18:37.28,0:18:38.41,Default,,0,0,0,,{\i1}Không mà.{\i0}
Dialogue: 0,0:18:40.37,0:18:41.45,Default,,0,0,0,,{\i1}Chị hiểu sai rồi!{\i0}
Dialogue: 0,0:18:51.00,0:18:53.92,Default,,0,0,0,,Chono giúp tớ mang đống này nhé?
Dialogue: 0,0:18:54.55,0:18:55.80,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:18:55.80,0:18:57.05,Default,,0,0,0,,Đến phòng giáo viên.
Dialogue: 0,0:18:58.26,0:19:00.05,Default,,0,0,0,,Nặng phết đấy.
Dialogue: 0,0:19:01.64,0:19:04.43,Default,,0,0,0,,Được thôi. Không ngờ cậu yếu thế.
Dialogue: 0,0:19:04.43,0:19:07.14,Default,,0,0,0,,- Cậu tập luyện mà.\N- Cậu thì không à?
Dialogue: 0,0:19:20.16,0:19:23.16,Default,,0,0,0,,Dọn dẹp chỗ đó xong thấy dễ chịu quá!
Dialogue: 0,0:19:23.16,0:19:25.08,Default,,0,0,0,,- Có muốn đi ăn gì...\N- Gặp lại sau nhé!
Dialogue: 0,0:19:25.08,0:19:26.08,Default,,0,0,0,,Này!
Dialogue: 0,0:19:30.63,0:19:32.17,Default,,0,0,0,,{\i1}Mình phải nói với chị ấy!{\i0}
Dialogue: 0,0:19:35.22,0:19:36.60,Default,,0,0,0,,{\i1}Mình không thấy phiền.{\i0}
Dialogue: 0,0:19:38.30,0:19:39.43,Default,,0,0,0,,{\i1}Mà mình thấy vui.{\i0}
Dialogue: 0,0:19:40.43,0:19:44.35,Default,,0,0,0,,{\i1}Lần đầu có người mình thích ôm mình mà!{\i0}
Dialogue: 0,0:20:22.76,0:20:25.22,Default,,0,0,0,,Ồ, cảm ơn.
Dialogue: 0,0:20:50.67,0:20:54.55,Default,,0,0,0,,{\i1}Từ hôm đó mình cứ\Nnghĩ ngợi mãi về khoảnh khắc ấy.{\i0}
Dialogue: 0,0:21:01.34,0:21:02.34,Default,,0,0,0,,{\i1}Nhưng...{\i0}
Dialogue: 0,0:21:07.14,0:21:08.14,Default,,0,0,0,,{\i1}Nhưng mà...{\i0}
Dialogue: 0,0:21:12.65,0:21:15.57,Default,,0,0,0,,{\i1}Mình phải nói trực tiếp với chị ấy!{\i0}
Dialogue: 0,0:21:25.33,0:21:26.33,Default,,0,0,0,,Con về rồi!
Dialogue: 0,0:21:27.08,0:21:29.92,Default,,0,0,0,,Chà, ô kìa. Sao lại vội thế?
Dialogue: 0,0:21:29.91,0:21:32.83,Default,,0,0,0,,- Chị Chinatsu đâu rồi?\N- Con bé đi rồi.
Dialogue: 0,0:21:35.42,0:21:37.80,Default,,0,0,0,,Chuyến bay của bố mẹ con bé tới sớm.
Dialogue: 0,0:21:38.30,0:21:40.43,Default,,0,0,0,,Bố con đưa con bé ra sân bay rồi.
Dialogue: 0,0:21:43.55,0:21:46.22,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:21:52.06,0:21:54.90,Default,,0,0,0,,{\i1}Sao chị ấy không ở đây chứ?{\i0}
Dialogue: 0,0:23:48.93,0:23:53.94,Default,,0,0,0,,{\an8}Phụ đề Việt ngữ bởi: Amtia(NOFACE)
