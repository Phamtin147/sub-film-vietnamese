Dialogue: 0,0:00:16.47,0:00:20.60,Default,,0,0,0,,BLUE BOX MÙA 2
Dialogue: 0,0:01:43.02,0:01:44.02,Default,,0,0,0,,{\an8}31 THÁNG 12
Dialogue: 0,0:01:44.10,0:01:47.60,Default,,0,0,0,,TẬP 32\NĐIỀU CẦN NÓI
Dialogue: 0,0:01:48.27,0:01:50.19,Default,,0,0,0,,Cứ vậy nhé.
Dialogue: 0,0:01:51.49,0:01:53.45,Default,,0,0,0,,Ai chơi chậm thế?
Dialogue: 0,0:01:53.53,0:01:54.70,Default,,0,0,0,,Hiển nhiên là ông rồi.
Dialogue: 0,0:01:55.82,0:01:57.66,Default,,0,0,0,,{\i1}Lại thời điểm này trong năm.{\i0}
Dialogue: 0,0:01:57.74,0:02:00.70,Default,,0,0,0,,{\i1}Cả nhà quây quần chơi bài còn tivi thì bật ở phía sau.{\i0}
Dialogue: 0,0:02:01.41,0:02:04.71,Default,,0,0,0,,{\i1}Chẳng có gì khác biệt\Nso với mọi Đêm Giao Thừa khác cả.{\i0}
Dialogue: 0,0:02:05.42,0:02:07.67,Default,,0,0,0,,{\i1}Mình dần tự hỏi liệu mình có mơ thấy{\i0}
Dialogue: 0,0:02:07.75,0:02:11.34,Default,,0,0,0,,{\i1}chuyện Đêm Giáng Sinh,\Nhay cả chuyện sống chung nhà hiện tại này không nữa.{\i0}
Dialogue: 0,0:02:13.42,0:02:14.84,Default,,0,0,0,,{\i1}Nhưng đó không phải mơ.{\i0}
Dialogue: 0,0:02:15.72,0:02:17.18,Default,,0,0,0,,Có khó chịu không?
Dialogue: 0,0:02:19.06,0:02:21.35,Default,,0,0,0,,{\i1}Từ đó mình chưa có dịp nói với chị ấy.{\i0}
Dialogue: 0,0:02:24.14,0:02:24.97,Default,,0,0,0,,Đầu hàng!
Dialogue: 0,0:02:25.06,0:02:27.35,Default,,0,0,0,,Thắng rồi!
Dialogue: 0,0:02:30.44,0:02:32.86,Default,,0,0,0,,{\i1}Mình sẽ nhắn "Chúc mừng năm mới" cho chị ấy.{\i0}
Dialogue: 0,0:02:33.44,0:02:35.44,Default,,0,0,0,,Ồ, sắp tới giờ rồi.
Dialogue: 0,0:02:36.45,0:02:38.37,Default,,0,0,0,,{\i1}Năm, sáu…{\i0}
Dialogue: 0,0:02:38.45,0:02:39.58,Default,,0,0,0,,{\i1}Và rồi…{\i0}
Dialogue: 0,0:02:39.66,0:02:42.45,Default,,0,0,0,,{\i1}Ba, hai, một.{\i0}
Dialogue: 0,0:02:42.54,0:02:44.58,Default,,0,0,0,,{\i1}Chúc mừng năm mới!{\i0}
Dialogue: 0,0:02:44.66,0:02:45.62,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:02:45.71,0:02:48.50,Default,,0,0,0,,MẸ:\NCHINATSU! CHÚC MỪNG NĂM MỚI!
Dialogue: 0,0:02:49.09,0:02:51.55,Default,,0,0,0,,Hẳn lúc này Chinatsu đang ở Nagano.
Dialogue: 0,0:02:51.63,0:02:53.72,Default,,0,0,0,,Chắc gia đình con bé đang quây quần vui vẻ lắm.
Dialogue: 0,0:02:53.80,0:02:56.26,Default,,0,0,0,,{\i1}Sao mẹ lại nhanh tay nhắn trước mất tiêu thế chứ?{\i0}
Dialogue: 0,0:02:56.84,0:02:58.26,Default,,0,0,0,,BỐ:\NCHỖ ÔNG CHÁU RA SAO?
Dialogue: 0,0:03:00.26,0:03:01.76,Default,,0,0,0,,{\i1}Cả nhóm chat nhắn tin,{\i0}
Dialogue: 0,0:03:01.85,0:03:04.94,Default,,0,0,0,,{\i1}chứ nhắn chúc riêng mỗi chị ấy\Nthì mình lại thấy ngượng sao ấy.{\i0}
Dialogue: 0,0:03:05.73,0:03:07.40,Default,,0,0,0,,KANO CHINATSU:\NCHÚC MỪNG NĂM MỚI!
Dialogue: 0,0:03:08.48,0:03:10.77,Default,,0,0,0,,Ở ĐÂY ĐỔ TUYẾT.\NXÚC TUYẾT LÀ BÀI THỂ DỤC TỐT.
Dialogue: 0,0:03:12.03,0:03:13.28,Default,,0,0,0,,{\i1}Dù chị ấy đang ở xa,{\i0}
Dialogue: 0,0:03:14.36,0:03:16.40,Default,,0,0,0,,{\i1}mình vẫn thấy hạnh phúc đến nhường này.{\i0}
Dialogue: 0,0:03:18.36,0:03:20.91,Default,,0,0,0,,ĐÀN ANH NISHIDA:\NTỚI ĐỀN THỜ ĐI!
Dialogue: 0,0:03:20.99,0:03:23.41,Default,,0,0,0,,LỐI VÀO ĐỀN TACHIBANA
Dialogue: 0,0:03:26.92,0:03:28.92,Default,,0,0,0,,Cậu tới rồi!
Dialogue: 0,0:03:29.00,0:03:31.42,Default,,0,0,0,,Mãi mới thấy xuất hiện đấy, Taiki!
Dialogue: 0,0:03:32.46,0:03:34.42,Default,,0,0,0,,Mãi em mới tìm thấy khăn quàng cổ.
Dialogue: 0,0:03:34.51,0:03:36.72,Default,,0,0,0,,Lâu rồi không gặp ạ, chị Karen.
Dialogue: 0,0:03:36.80,0:03:38.30,Default,,0,0,0,,Trông em có vẻ cao thêm đấy nhỉ.
Dialogue: 0,0:03:38.38,0:03:40.30,Default,,0,0,0,,- Gì cơ?\N- Vậy à?
Dialogue: 0,0:03:40.39,0:03:42.77,Default,,0,0,0,,Ngày nào cậu chẳng gặp cậu ấy.
Dialogue: 0,0:03:44.64,0:03:47.31,Default,,0,0,0,,Nhìn em xem, chững chạc lớn hẳn ra rồi.
Dialogue: 0,0:03:48.02,0:03:49.40,Default,,0,0,0,,Cảm ơn ạ.
Dialogue: 0,0:03:52.11,0:03:54.91,Default,,0,0,0,,Thôi nào, cùng đi thôi!
Dialogue: 0,0:04:00.87,0:04:03.08,Default,,0,0,0,,Chờ đấy. Để mua đồ uống.
Dialogue: 0,0:04:06.58,0:04:07.79,Default,,0,0,0,,Tớ mời cậu.
Dialogue: 0,0:04:08.58,0:04:09.46,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:04:10.42,0:04:14.47,Default,,0,0,0,,Vì mấy đứa em nhà tớ mê tít\Nbánh quy cậu làm hồi Giáng Sinh đấy.
Dialogue: 0,0:04:22.80,0:04:24.22,Default,,0,0,0,,{\an8}SÚP ĐẬU ĐỎ {\i1}OSHIRUKO{\i0}
Dialogue: 0,0:04:31.81,0:04:33.56,Default,,0,0,0,,Ở đây đông người quá.
Dialogue: 0,0:04:33.65,0:04:35.74,Default,,0,0,0,,Mãi không tiến lên được.
Dialogue: 0,0:04:45.08,0:04:50.00,Default,,0,0,0,,{\i1}Cầu sức khỏe, cầu lông tiến bộ hơn,\Ntình duyên, điểm số tốt, và hòa bình thế giới.{\i0}
Dialogue: 0,0:04:50.75,0:04:52.00,Default,,0,0,0,,{\i1}Làm ơn,{\i0}
Dialogue: 0,0:04:52.08,0:04:56.33,Default,,0,0,0,,{\i1}cầu mong năm nay\Nmình sẽ tiến thẳng tới mục tiêu.{\i0}
Dialogue: 0,0:04:59.09,0:05:02.18,Default,,0,0,0,,Đến lúc rút quẻ cầu may mắn rồi!
Dialogue: 0,0:05:02.26,0:05:04.39,Default,,0,0,0,,{\an8}HUNG
Dialogue: 0,0:05:04.47,0:05:06.14,Default,,0,0,0,,{\an8}Quẻ Hung ư?
Dialogue: 0,0:05:06.22,0:05:08.85,Default,,0,0,0,,Mình sẽ rút mãi để ra Đại Cát mới thôi!
Dialogue: 0,0:05:08.93,0:05:10.10,Default,,0,0,0,,Làm thế mà được à?
Dialogue: 0,0:05:10.18,0:05:12.06,Default,,0,0,0,,Đâu có luật cấm làm thế đâu.
Dialogue: 0,0:05:13.60,0:05:16.02,Default,,0,0,0,,{\an8}ĐẠI HUNG
Dialogue: 0,0:05:16.61,0:05:19.03,Default,,0,0,0,,{\an8}{\i1}Đại hung ư?{\i0}
Dialogue: 0,0:05:19.11,0:05:22.11,Default,,0,0,0,,Mình sẽ rút được quẻ Đại Cát cho coi!
Dialogue: 0,0:05:22.61,0:05:24.53,Default,,0,0,0,,{\i1}Lần hai, mình rút được Tiểu Cát.{\i0}
Dialogue: 0,0:05:24.62,0:05:27.54,Default,,0,0,0,,{\i1}Lần ba, mình rút được Mạt Cát.{\i0}
Dialogue: 0,0:05:28.16,0:05:29.04,Default,,0,0,0,,{\i1}Lần bốn nào!{\i0}
Dialogue: 0,0:05:29.12,0:05:31.04,Default,,0,0,0,,{\an8}ĐẠI CÁT
Dialogue: 0,0:05:31.79,0:05:33.04,Default,,0,0,0,,{\i1}Rút được Đại Cát rồi!{\i0}
Dialogue: 0,0:05:39.55,0:05:42.55,Default,,0,0,0,,{\i1}"Đừng chần chừ… chuyện tình duyên".{\i0}
Dialogue: 0,0:05:45.39,0:05:46.89,Default,,0,0,0,,ĐỀN TACHIBANA
Dialogue: 0,0:05:46.97,0:05:49.93,Default,,0,0,0,,Hinacchi rút được quẻ gì?
Dialogue: 0,0:05:50.89,0:05:52.14,Default,,0,0,0,,{\an8}Tèn ten!
Dialogue: 0,0:05:52.23,0:05:53.65,Default,,0,0,0,,{\an8}ĐẠI CÁT
Dialogue: 0,0:05:53.73,0:05:54.56,Default,,0,0,0,,{\an8}Còn Ayame?
Dialogue: 0,0:05:55.19,0:05:58.07,Default,,0,0,0,,Tớ chỉ quan tâm\Nquẻ nói gì về chuyện tình cảm.
Dialogue: 0,0:05:58.65,0:06:01.57,Default,,0,0,0,,"Tình duyên… đường đi đầy chông gai".
Dialogue: 0,0:06:04.16,0:06:06.58,Default,,0,0,0,,Mình đi rút quẻ khác đây!
Dialogue: 0,0:06:07.20,0:06:09.58,Default,,0,0,0,,{\i1}Đại Cát!{\i0}
Dialogue: 0,0:06:09.66,0:06:12.00,Default,,0,0,0,,AI CŨNG HẠNH PHÚC
Dialogue: 0,0:06:12.08,0:06:13.58,Default,,0,0,0,,Không dài dòng nữa!
Dialogue: 0,0:06:14.17,0:06:17.67,Default,,0,0,0,,Đi càn quét đồ ăn vặt ngoài phố thôi!
Dialogue: 0,0:06:18.17,0:06:20.01,Default,,0,0,0,,Đi uống rượu ngọt nào!
Dialogue: 0,0:06:20.09,0:06:22.09,Default,,0,0,0,,Đừng để bị lạc.
Dialogue: 0,0:06:30.18,0:06:31.60,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:06:32.10,0:06:34.81,Default,,0,0,0,,Hình như cậu đang lết chân kìa.
Dialogue: 0,0:06:34.89,0:06:37.85,Default,,0,0,0,,Thật ra có người vừa dẫm vào cổ chân tớ.
Dialogue: 0,0:06:38.48,0:06:40.48,Default,,0,0,0,,Hình như bị trầy da rồi.
Dialogue: 0,0:06:40.57,0:06:43.78,Default,,0,0,0,,Tớ có mang băng cá nhân.\NMình qua bên kia dán vào đi.
Dialogue: 0,0:06:43.86,0:06:45.61,Default,,0,0,0,,Nhưng mọi người…
Dialogue: 0,0:06:48.74,0:06:49.99,Default,,0,0,0,,Xin lỗi, Moriya.
Dialogue: 0,0:06:50.66,0:06:53.50,Default,,0,0,0,,Cứ bảo mọi người\Nlà bọn tớ sẽ đuổi theo sau nhé.
Dialogue: 0,0:06:54.54,0:06:56.58,Default,,0,0,0,,Ừ, được rồi.
Dialogue: 0,0:07:03.59,0:07:06.01,Default,,0,0,0,,{\i1}Mình bị tách khỏi cả hội mất rồi.{\i0}
Dialogue: 0,0:07:06.09,0:07:11.01,Default,,0,0,0,,Mấy anh khóa trên chẳng thèm quay lại xem\Ntụi mình có theo kịp không nữa.
Dialogue: 0,0:07:12.43,0:07:13.97,Default,,0,0,0,,{\i1}Chắc mình nhắn tin cho họ vậy.{\i0}
Dialogue: 0,0:07:15.73,0:07:17.65,Default,,0,0,0,,{\an8}NHÀ INOMATA\NCÓ NGƯỜI GỬI NHÃN DÁN
Dialogue: 0,0:07:20.73,0:07:21.73,Default,,0,0,0,,{\an8}MORIYA KAREN GỌI
Dialogue: 0,0:07:21.82,0:07:22.65,Default,,0,0,0,,{\an8}{\i1}Chào!{\i0}
Dialogue: 0,0:07:23.48,0:07:25.40,Default,,0,0,0,,{\an8}Chúc mừng năm mới, Chii!
Dialogue: 0,0:07:26.15,0:07:29.32,Default,,0,0,0,,{\an8}{\i1}Đừng bất thình lình gọi video cho tớ thế chứ.{\i0}
Dialogue: 0,0:07:30.12,0:07:33.96,Default,,0,0,0,,Tớ thấy việc chúc mừng năm mới trực tiếp\Nmặt đối mặt quan trọng lắm đấy.
Dialogue: 0,0:07:34.75,0:07:37.17,Default,,0,0,0,,Cả hội vừa cùng đi lễ đền đấy.
Dialogue: 0,0:07:38.00,0:07:38.96,Default,,0,0,0,,Thấy chưa?
Dialogue: 0,0:07:44.34,0:07:45.26,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:07:45.34,0:07:47.22,Default,,0,0,0,,Tụi mình lạc mất Taiki từ đời nào rồi.
Dialogue: 0,0:07:47.93,0:07:50.48,Default,,0,0,0,,{\i1}Thế mà mình đã mong hai người họ nhìn thấy nhau.{\i0}
Dialogue: 0,0:07:53.39,0:07:55.23,Default,,0,0,0,,{\an8}Có rút quẻ xin may mắn không?
Dialogue: 0,0:07:55.31,0:07:56.81,Default,,0,0,0,,{\i1}Cậu hỏi đúng lúc ghê!{\i0}
Dialogue: 0,0:07:56.89,0:07:57.85,Default,,0,0,0,,TAIKI\NTIN NHẮN MỚI
Dialogue: 0,0:07:58.90,0:08:00.74,Default,,0,0,0,,Cậu vừa nhận tin nhắn à?
Dialogue: 0,0:08:00.81,0:08:02.81,Default,,0,0,0,,Cậu đang bận thì tớ gọi lại sau.
Dialogue: 0,0:08:09.95,0:08:12.70,Default,,0,0,0,,{\an8}INOMATA TAIKI\NCHỊ VỀ THÌ NÓI CHUYỆN NHÉ?
Dialogue: 0,0:08:12.78,0:08:15.74,Default,,0,0,0,,{\an8}EM CÓ ĐIỀU CẦN NÓI.
Dialogue: 0,0:08:16.58,0:08:18.87,Default,,0,0,0,,{\an8}ĐÃ ĐỌC 1:42 SÁNG.
Dialogue: 0,0:08:52.24,0:08:53.20,Default,,0,0,0,,{\an8}KANO CHINATSU\NĐƯỢC.
Dialogue: 0,0:09:17.18,0:09:19.06,Default,,0,0,0,,Chà, cậu tới rồi.
Dialogue: 0,0:09:20.02,0:09:22.90,Default,,0,0,0,,Ban đầu thì đi muộn, xong lại đi lạc.\NEm cũng gan đấy nhỉ.
Dialogue: 0,0:09:22.98,0:09:24.06,Default,,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:09:24.73,0:09:27.19,Default,,0,0,0,,Đừng có trễ chuyến trượt tuyết ngày mùng 4 và mùng 5 đấy.
Dialogue: 0,0:09:27.28,0:09:29.57,Default,,0,0,0,,Em sẽ đặt 20 lần chuông báo thức.
Dialogue: 0,0:09:30.44,0:09:32.61,Default,,0,0,0,,Kyo và Hina đâu rồi?
Dialogue: 0,0:09:35.99,0:09:37.32,Default,,0,0,0,,Các cậu cũng bị lạc à?
Dialogue: 0,0:09:37.41,0:09:39.75,Default,,0,0,0,,Không, tụi tớ chỉ tách ra đi riêng thôi.
Dialogue: 0,0:09:39.83,0:09:42.37,Default,,0,0,0,,Đám vận động viên môn cá nhân hay thế lắm.
Dialogue: 0,0:09:42.46,0:09:43.59,Default,,0,0,0,,Đúng là thế.
Dialogue: 0,0:09:43.67,0:09:46.17,Default,,0,0,0,,"Ngưu tầm ngưu, mã tầm mã".
Dialogue: 0,0:09:46.25,0:09:47.79,Default,,0,0,0,,Khoan, tính cả tớ à?
Dialogue: 0,0:09:50.80,0:09:51.72,Default,,0,0,0,,LỐI RA
Dialogue: 0,0:09:51.80,0:09:54.30,Default,,0,0,0,,- Chào nhé!\N- Gặp ở chỗ tập luyện!
Dialogue: 0,0:10:00.39,0:10:04.14,Default,,0,0,0,,Quản lý nổi đám người tự do tự tại như thế\Nhẳn phải vất vả lắm nhỉ.
Dialogue: 0,0:10:04.23,0:10:05.61,Default,,0,0,0,,Đáng nể nhỉ?
Dialogue: 0,0:10:06.23,0:10:08.40,Default,,0,0,0,,Đâu ngờ em lại khéo chăm lo cho người khác thế đấy.
Dialogue: 0,0:10:08.48,0:10:10.27,Default,,0,0,0,,Chị nói "đâu ngờ" là có ý gì hả?
Dialogue: 0,0:10:10.36,0:10:13.32,Default,,0,0,0,,Cẩn thận đấy, kiểu người như em\Ndễ phải lòng mấy gã vô tích sự lắm.
Dialogue: 0,0:10:13.40,0:10:16.11,Default,,0,0,0,,Em biết thừa chuyện đó rồi.
Dialogue: 0,0:10:16.20,0:10:20.12,Default,,0,0,0,,Cơ mà cậu nhóc đeo kính kia trông cũng ổn áp đấy.
Dialogue: 0,0:10:21.00,0:10:22.25,Default,,0,0,0,,Chị nói Kasahara á?
Dialogue: 0,0:10:22.83,0:10:24.46,Default,,0,0,0,,Em phải lòng cậu ta rồi đúng không?
Dialogue: 0,0:10:24.54,0:10:27.13,Default,,0,0,0,,Trông em ghen ra mặt\Nkhi thấy cậu ấy đi chung với Hina kìa.
Dialogue: 0,0:10:27.71,0:10:29.38,Default,,0,0,0,,Làm gì có chuyện đó!
Dialogue: 0,0:10:29.46,0:10:33.96,Default,,0,0,0,,{\i1}Gu của mình là mấy anh chàng đẹp trai\Nmà cực kỳ bảnh bao phong độ cơ.{\i0}
Dialogue: 0,0:10:34.05,0:10:35.13,Default,,0,0,0,,TÌNH YÊU SỐ 1 YUSA
Dialogue: 0,0:10:38.30,0:10:40.55,Default,,0,0,0,,{\i1}Mình làm bộ mặt đó{\i0}
Dialogue: 0,0:10:40.64,0:10:43.14,Default,,0,0,0,,{\i1}là vì mình hiểu Hinacchi đang cảm thấy thế nào.{\i0}
Dialogue: 0,0:10:43.85,0:10:46.14,Default,,0,0,0,,{\i1}Kasahara có lẽ…{\i0}
Dialogue: 0,0:10:48.31,0:10:50.52,Default,,0,0,0,,Chắc chắn là không mà.
Dialogue: 0,0:10:51.19,0:10:52.02,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:10:53.24,0:10:55.12,Default,,0,0,0,,Nếu em nói vậy.
Dialogue: 0,0:11:00.12,0:11:04.04,Default,,0,0,0,,{\an8}NGÀY 1 THÁNG MỘT
Dialogue: 0,0:11:04.12,0:11:07.04,Default,,0,0,0,,CHÚC MỪNG NĂM MỚI
Dialogue: 0,0:11:07.12,0:11:07.95,Default,,0,0,0,,Nhìn ngon đó.
Dialogue: 0,0:11:08.04,0:11:10.04,Default,,0,0,0,,- Làm rất khéo phải không?\N- Phải.
Dialogue: 0,0:11:10.96,0:11:12.13,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:11:12.63,0:11:14.09,Default,,0,0,0,,- Đây!\N- Họ sửa đường đó.
Dialogue: 0,0:11:14.17,0:11:15.55,Default,,0,0,0,,- Nhỉ?\N- Cảm ơn.
Dialogue: 0,0:11:16.26,0:11:17.22,Default,,0,0,0,,{\an8}NGÀY 2 THÁNG MỘT
Dialogue: 0,0:11:17.30,0:11:18.55,Default,,0,0,0,,{\an8}Ra bờ sông đi!
Dialogue: 0,0:11:18.64,0:11:19.52,Default,,0,0,0,,{\an8}- Ừ!\N- Chờ đó!
Dialogue: 0,0:11:19.60,0:11:21.06,Default,,0,0,0,,{\an8}Ra công viên bên kia đi.
Dialogue: 0,0:11:25.14,0:11:28.06,Default,,0,0,0,,{\an8}HẠNG 4: YOSHIKUNI HAYAMA - ĐẠI HỌC JYO-OU
Dialogue: 0,0:11:34.78,0:11:37.57,Default,,0,0,0,,{\i1}Thời gian trôi chậm quá.{\i0}
Dialogue: 0,0:11:42.16,0:11:45.50,Default,,0,0,0,,{\i1}Chị Chinatsu phải mùng 6 mới về cơ.{\i0}
Dialogue: 0,0:11:45.58,0:11:48.67,Default,,0,0,0,,{\i1}dẫu vậy thì vẫn còn bốn ngày nữa cơ.{\i0}
Dialogue: 0,0:11:48.75,0:11:50.09,Default,,0,0,0,,{\i1}Mình nhớ chị ấy quá đi mất.{\i0}
Dialogue: 0,0:11:52.63,0:11:54.09,Default,,0,0,0,,{\i1}Mình nhớ chị ấy quá.{\i0}
Dialogue: 0,0:11:54.17,0:11:55.80,Default,,0,0,0,,{\an8}CHỊ VỀ THÌ NÓI CHUYỆN NHÉ?
Dialogue: 0,0:11:55.88,0:11:57.09,Default,,0,0,0,,{\an8}EM CÓ ĐIỀU CẦN NÓI.
Dialogue: 0,0:11:59.68,0:12:02.10,Default,,0,0,0,,{\i1}Có lẽ mình chẳng muốn gặp chị ấy.{\i0}
Dialogue: 0,0:12:02.97,0:12:05.10,Default,,0,0,0,,{\i1}Vì lần tới gặp chị ấy…{\i0}
Dialogue: 0,0:12:11.11,0:12:12.70,Default,,0,0,0,,Con đi chạy bộ đây.
Dialogue: 0,0:12:15.15,0:12:18.11,Default,,0,0,0,,Thằng bé nghỉ vài ngày lễ thì có sao đâu.
Dialogue: 0,0:12:18.20,0:12:20.12,Default,,0,0,0,,Thằng bé là vậy mà.
Dialogue: 0,0:13:10.33,0:13:12.12,Default,,0,0,0,,{\i1}Cho tới một năm trước,{\i0}
Dialogue: 0,0:13:12.75,0:13:15.25,Default,,0,0,0,,{\i1}mình và chị ấy còn chả mấy khi nói chuyện.{\i0}
Dialogue: 0,0:13:17.96,0:13:19.75,Default,,0,0,0,,{\i1}Vậy mà, chẳng biết từ lúc nào…{\i0}
Dialogue: 0,0:13:40.90,0:13:44.03,Default,,0,0,0,,{\an8}TRUNG HỌC TƯ THỤC EIMEI
Dialogue: 0,0:14:17.57,0:14:19.66,Default,,0,0,0,,{\i1}Chào buổi sáng, Taiki!{\i0}
Dialogue: 0,0:14:39.13,0:14:40.30,Default,,0,0,0,,Con về rồi.
Dialogue: 0,0:14:42.26,0:14:46.47,Default,,0,0,0,,Mẹ để thiệp chúc mừng năm mới trên bàn.
Dialogue: 0,0:14:50.26,0:14:51.68,Default,,0,0,0,,GỬI INOMATA TAIKI
Dialogue: 0,0:14:53.02,0:14:54.35,Default,,0,0,0,,{\an8}CHÚC MỪNG NĂM MỚI
Dialogue: 0,0:14:57.77,0:15:00.19,Default,,0,0,0,,UNZEN, NAGANO\NKANO CHINATSU
Dialogue: 0,0:15:04.78,0:15:07.33,Default,,0,0,0,,{\an8}{\i1}"Chúc mừng năm mới!{\i0}
Dialogue: 0,0:15:07.41,0:15:10.58,Default,,0,0,0,,{\i1}Cháu có được một năm học đáng nhớ như vừa qua{\i0}
Dialogue: 0,0:15:10.66,0:15:13.20,Default,,0,0,0,,{\i1}đều là nhờ cả gia đình Inomata đã giúp đỡ ạ".{\i0}
Dialogue: 0,0:15:22.50,0:15:24.29,Default,,0,0,0,,{\i1}Nhớ chị ấy quá.{\i0}
Dialogue: 0,0:15:25.72,0:15:28.72,Default,,0,0,0,,{\i1}Chỉ đọc mấy dòng này thôi\Nmà mình đã muốn gặp chị ấy rồi.{\i0}
Dialogue: 0,0:15:29.30,0:15:33.72,Default,,0,0,0,,{\i1}Dù chị ấy không ở bên,\Nmình vẫn cứ nghĩ về chị ấy mãi.{\i0}
Dialogue: 0,0:15:34.81,0:15:37.73,Default,,0,0,0,,{\i1}Chỉ ở bên chị ấy cũng đủ làm mình vui.{\i0}
Dialogue: 0,0:15:39.81,0:15:41.15,Default,,0,0,0,,{\i1}Đó là kiểu tình yêu{\i0}
Dialogue: 0,0:15:41.73,0:15:43.77,Default,,0,0,0,,{\i1}mà mình đang trải qua lúc này.{\i0}
Dialogue: 0,0:15:44.28,0:15:46.74,Default,,0,0,0,,{\an8}NGÀY 1 THÁNG MỘT, NAGANO
Dialogue: 0,0:16:16.35,0:16:18.02,Default,,0,0,0,,{\an8}CHỊ VỀ THÌ NÓI CHUYỆN NHÉ?
Dialogue: 0,0:16:18.10,0:16:19.27,Default,,0,0,0,,{\an8}EM CÓ ĐIỀU CẦN NÓI.
Dialogue: 0,0:16:34.24,0:16:36.28,Default,,0,0,0,,Khi nào con bé mới chịu rời giường thế?
Dialogue: 0,0:16:37.37,0:16:39.00,Default,,0,0,0,,Con dậy ngay đây ạ!
Dialogue: 0,0:16:41.46,0:16:42.71,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:16:42.79,0:16:44.54,Default,,0,0,0,,Chào buổi sáng, Chii.
Dialogue: 0,0:16:45.13,0:16:46.88,Default,,0,0,0,,Cháu muốn ăn mochi nhân gì nào?
Dialogue: 0,0:16:46.96,0:16:48.84,Default,,0,0,0,,Nhân đậu đỏ ngọt hay chan nước tương?
Dialogue: 0,0:16:48.92,0:16:51.55,Default,,0,0,0,,Để con bé ngồi xuống đi đã.
Dialogue: 0,0:16:56.47,0:16:57.56,Default,,0,0,0,,Cảm ơn cả nhà vì bữa ăn ạ.
Dialogue: 0,0:17:02.86,0:17:06.32,Default,,0,0,0,,Ông tự trồng hết mấy loại rau này đấy.
Dialogue: 0,0:17:10.90,0:17:13.57,Default,,0,0,0,,Cháu ăn khỏe ghê nhỉ.
Dialogue: 0,0:17:14.37,0:17:15.96,Default,,0,0,0,,Tại đồ ăn ngon quá mà ạ.
Dialogue: 0,0:17:16.45,0:17:18.08,Default,,0,0,0,,Mà bố cháu đâu rồi ạ?
Dialogue: 0,0:17:18.66,0:17:20.50,Default,,0,0,0,,Bố cháu đi chào hàng xóm rồi.
Dialogue: 0,0:17:21.00,0:17:23.09,Default,,0,0,0,,Lâu rồi bố cháu mới về đây.
Dialogue: 0,0:17:23.88,0:17:26.92,Default,,0,0,0,,Giờ kể cho ông bà nghe xem\Ndạo này cháu sống thế nào nào?
Dialogue: 0,0:17:27.00,0:17:28.84,Default,,0,0,0,,Đội bóng rổ thế nào rồi?
Dialogue: 0,0:17:28.92,0:17:30.09,Default,,0,0,0,,Còn điểm trên lớp?
Dialogue: 0,0:17:31.34,0:17:33.09,Default,,0,0,0,,Cháu vẫn lo được ạ.
Dialogue: 0,0:17:33.68,0:17:35.27,Default,,0,0,0,,Thế cháu đã có người thương chưa?
Dialogue: 0,0:17:36.01,0:17:40.93,Default,,0,0,0,,Ông nó, bọn trẻ dạo này\Nkhông thích bị hỏi thế đâu.
Dialogue: 0,0:17:41.02,0:17:43.23,Default,,0,0,0,,- Nhưng bà không lo à?\N- Ôi, trời.
Dialogue: 0,0:17:47.32,0:17:48.78,Default,,0,0,0,,Hai ông bà gặp nhau
Dialogue: 0,0:17:48.86,0:17:51.74,Default,,0,0,0,,ở chỗ làm của bà nhỉ?
Dialogue: 0,0:17:51.82,0:17:53.95,Default,,0,0,0,,{\i1}Phải, ở một nhà trọ truyền thống.{\i0}
Dialogue: 0,0:17:54.03,0:17:58.49,Default,,0,0,0,,{\i1}Phải, ở một lữ quán truyền thống.\NHồi đó ông cháu sáng nào cũng tới giao rau củ cả.{\i0}
Dialogue: 0,0:17:58.58,0:18:01.58,Default,,0,0,0,,Ông phải lòng bà từ lúc nào thế ạ?
Dialogue: 0,0:18:02.79,0:18:06.84,Default,,0,0,0,,Các ông dạo này\Nkhông thích bị hỏi thế đâu.
Dialogue: 0,0:18:06.92,0:18:09.38,Default,,0,0,0,,Ôi chà, tiện lợi quá!
Dialogue: 0,0:18:10.01,0:18:12.76,Default,,0,0,0,,Ông quên rồi, chuyện lâu lắc lâu lơ rồi mà.
Dialogue: 0,0:18:12.84,0:18:15.97,Default,,0,0,0,,Ông cháu đang ngượng\Nkhi nhắc lại mấy chuyện này đấy.
Dialogue: 0,0:18:18.76,0:18:19.93,Default,,0,0,0,,Chinatsu.
Dialogue: 0,0:18:20.47,0:18:22.35,Default,,0,0,0,,Ăn xong thì ra xúc tuyết giúp ông nhé?
Dialogue: 0,0:18:22.43,0:18:23.89,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:26.40,0:18:29.40,Default,,0,0,0,,{\an8}NGÀY 2 THÁNG MỘT
Dialogue: 0,0:18:51.00,0:18:52.92,Default,,0,0,0,,Cháu ra ngoài đi dạo chút ạ.
Dialogue: 0,0:18:53.51,0:18:55.10,Default,,0,0,0,,Ngoài kia lạnh lắm.
Dialogue: 0,0:18:55.18,0:18:58.93,Default,,0,0,0,,Con bé không thích ngồi yên một chỗ trong nhà đâu.
Dialogue: 0,0:19:12.53,0:19:14.37,Default,,0,0,0,,Trời, lạnh quá.
Dialogue: 0,0:19:14.44,0:19:16.82,Default,,0,0,0,,Biết thế mình nên mặc ấm hơn chút.
Dialogue: 0,0:19:16.91,0:19:18.20,Default,,0,0,0,,Đúng là thế.
Dialogue: 0,0:19:19.45,0:19:21.29,Default,,0,0,0,,Anh ổn chứ?
Dialogue: 0,0:19:21.37,0:19:22.62,Default,,0,0,0,,Không quay về đâu.
Dialogue: 0,0:19:22.70,0:19:23.95,Default,,0,0,0,,Đừng để bị ốm.
Dialogue: 0,0:19:42.97,0:19:45.14,Default,,0,0,0,,Chà, nhìn tuyết kìa!
Dialogue: 0,0:19:47.31,0:19:49.10,Default,,0,0,0,,Chơi trò ném tuyết đi!
Dialogue: 0,0:19:50.77,0:19:53.06,Default,,0,0,0,,- Cho em chạy trước mười giây đấy!\N- Gì chứ?!
Dialogue: 0,0:20:20.51,0:20:22.18,Default,,0,0,0,,Nếu cần thì dùng chiếc khăn này đi!
Dialogue: 0,0:20:26.52,0:20:28.27,Default,,0,0,0,,Nhớ giữ ấm đấy nhé.
Dialogue: 0,0:20:28.85,0:20:30.48,Default,,0,0,0,,{\i1}Inomata Taiki.{\i0}
Dialogue: 0,0:20:41.91,0:20:44.87,Default,,0,0,0,,Khó tin là sáng nào cậu cũng dậy sớm thế.
Dialogue: 0,0:21:06.89,0:21:08.31,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:21:16.86,0:21:18.82,Default,,0,0,0,,{\i1}Hôm nay cậu ấy lại có mặt rồi.{\i0}
Dialogue: 0,0:21:19.82,0:21:21.45,Default,,0,0,0,,{\i1}Hôm nay Taiki cũng ở đây.{\i0}
Dialogue: 0,0:21:23.07,0:21:24.24,Default,,0,0,0,,{\i1}Cả hôm nay nữa.{\i0}
Dialogue: 0,0:21:37.17,0:21:39.01,Default,,0,0,0,,Chii!
Dialogue: 0,0:21:39.09,0:21:40.55,Default,,0,0,0,,Chuyện ban nãy cháu hỏi…
Dialogue: 0,0:21:41.22,0:21:43.51,Default,,0,0,0,,Không chỉ dừng lại ở đó đâu.
Dialogue: 0,0:21:43.59,0:21:45.05,Default,,0,0,0,,Chuyện ban nãy cháu hỏi?
Dialogue: 0,0:21:45.64,0:21:49.23,Default,,0,0,0,,Điều ông cháu đã nói khi thổ lộ với bà đấy.
Dialogue: 0,0:21:51.52,0:21:56.19,Default,,0,0,0,,{\an8}NGÀY 3 THÁNG MỘT
Dialogue: 0,0:22:05.66,0:22:07.58,Default,,0,0,0,,Ông cháu đã rất ngượng
Dialogue: 0,0:22:07.66,0:22:10.83,Default,,0,0,0,,khi nói điều này với bà.
Dialogue: 0,0:22:14.71,0:22:16.09,Default,,0,0,0,,{\i1}"Một ngày nọ,{\i0}
Dialogue: 0,0:22:17.17,0:22:18.84,Default,,0,0,0,,{\i1}tôi chợt nhận ra{\i0}
Dialogue: 0,0:22:19.50,0:22:22.38,Default,,0,0,0,,{\i1}người đầu tiên tôi muốn nhìn thấy mỗi sáng là em."{\i0}
Dialogue: 0,0:23:48.80,0:23:53.81,Default,,0,0,0,,{\an8}Phụ đề Việt ngữ bởi: Amtia(NOFACE)
