Dialogue: 0,0:02:27.83,0:02:30.19,Default,Grid,0,0,0,,Cuối cùng mình cũng có được nó rồi!
Dialogue: 0,0:02:30.19,0:02:32.10,Default,Grid,0,0,0,,Dainsleif!
Dialogue: 0,0:02:32.06,0:02:33.21,screen_text,Sign,0,0,0,,{\fs10\fad(133,0)\c&H6756A9&\3c&H4A4663&\pos(320.667,230)}Kiếm Dainsleif (Bản sao)
Dialogue: 0,0:02:33.91,0:02:36.51,italics,Grid,0,0,0,,Cường hóa thanh này lên thì khối đứa\Nsẽ phải trầm trồ ngước nhìn cho xem!
Dialogue: 0,0:02:36.73,0:02:41.34,Default,Khan,0,0,0,,Ta thật không ngờ cháu lại tìm ra được bức bích họa\NKiếm Vũ Pagma do tổ tiên ta để lại!
Dialogue: 0,0:02:41.79,0:02:45.32,Default,Khan,0,0,0,,Cháu chính là người mà bác kính trọng nhất đấy!
Dialogue: 0,0:02:45.63,0:02:50.23,Default,Grid,0,0,0,,Mà bác này, cháu cũng muốn kiếm luôn\Nbộ giáp Valhalla kia nữa.
Dialogue: 0,0:02:53.88,0:02:56.72,Default,Khan,0,0,0,,Cháu vừa đi xa về chắc vẫn còn mệt.
Dialogue: 0,0:02:56.72,0:02:58.95,Default,Khan,0,0,0,,Cứ nghỉ ngơi cho lại sức trước đã.
Dialogue: 0,0:03:00.43,0:03:01.90,Default,Grid,0,0,0,,Bác ấy đánh trống lảng kìa.
Dialogue: 0,0:03:05.58,0:03:07.49,Default,Man,0,0,0,,Ngài Grid có ở đây không ạ?
Dialogue: 0,0:03:07.94,0:03:09.66,Default,Grid,0,0,0,,Tôi đây.
Dialogue: 0,0:03:09.93,0:03:13.33,Default,Man,0,0,0,,Chấp chính quan Valdi muốn gặp\Nmời ngài vào trong lâu đài bàn chuyện.
Dialogue: 0,0:03:13.33,0:03:15.51,Default,Man,0,0,0,,Ngài ấy bảo là việc khẩn cấp ạ.
Dialogue: 0,0:03:24.01,0:03:26.51,Default,Grid,0,0,0,,Uầy! Nhìn xem kìa!
Dialogue: 0,0:03:26.87,0:03:29.68,Default,Grid,0,0,0,,Trong lâu đài cũng có hẳn một lò rèn cơ à?
Dialogue: 0,0:03:29.68,0:03:31.79,Default,Valdi,0,0,0,,Ta không vòng vo mất thời gian nữa.
Dialogue: 0,0:03:31.79,0:03:35.15,Default,Valdi,0,0,0,,Ta muốn cậu chế tạo gấp cho ta một món đồ.
Dialogue: 0,0:03:35.50,0:03:43.16,Default,Valdi,0,0,0,,Như cậu đã biết, Huyết Phù Thủy Yura\Nđã trở thành Đại Tội Đồ Thứ Tám của Yatan,
Dialogue: 0,0:03:43.16,0:03:46.24,Default,Valdi,0,0,0,,khiến cho thanh thế của giáo hội đó\Nngày càng lớn mạnh hơn.
Dialogue: 0,0:03:47.43,0:03:53.87,Default,Valdi,0,0,0,,Pháo đài Kinbai, một trong những thành trì kiên cố nhất\Nlãnh địa ta, đã thất thủ rồi.
Dialogue: 0,0:03:54.42,0:03:55.65,italics,Grid,0,0,0,,Yura sao?
Dialogue: 0,0:03:56.01,0:03:58.13,italics,Grid,0,0,0,,Nghe có vẻ chẳng lành chút nào.
Dialogue: 0,0:03:58.13,0:04:01.25,Default,Valdi,0,0,0,,Ta muốn cậu rèn chiếc khiên này cho chúng ta,
Dialogue: 0,0:04:01.25,0:04:04.82,Default,Valdi,0,0,0,,để giúp ngăn chặn cuộc xâm lăng của bọn chúng.
Dialogue: 0,0:04:11.23,0:04:14.29,italics,System,0,0,0,,[Hệ Thống] Bạn đã học được công thức\Nchế tạo Thánh Thuẫn.
Dialogue: 0,0:04:14.75,0:04:17.31,screen_text,Sign,0,0,0,,{\fad(129,0)\fs10\b0\pos(320,121.333)}Nhiệm Vụ
Dialogue: 0,0:04:14.75,0:04:17.31,screen_text,Sign,0,0,0,,{\fs10\fad(129,0)\pos(320,159.333)\3c&H7A7471&}Giao Kèo Với Chấp Chính Quan 2 (AA)
Dialogue: 1,0:04:14.75,0:04:17.31,screen_text,Sign,0,0,0,,{\fs14\bord0.75\fad(129,0)\b0\c&HD3D0CC&\pos(320,170)}Chế tạo và giao nộp "Thánh Thuẫn"\Nđể chặn đứng cuộc xâm lăng của Giáo hội Yatan.\N\NĐiều kiện hoàn thành: Rèn và giao nộp "Thánh Thuẫn"\Nphẩm chất Cực Phẩm (Epic) trở lên trong hai ngày.\NPhần thưởng: Tùy thuộc vào chất lượng.\N\NThất bại: Hủy bỏ giao kèo.\NCác nhiệm vụ liên kết sẽ biến mất.
Dialogue: 0,0:04:14.75,0:04:17.31,screen_text,Sign,0,0,0,,{\fad(129,0)\an8\bord0\p1\fscy220\alpha&H5&\c&H8B7261&\pos(320,170.667)}m 0 0 l 320 0 320 58 0 58
Dialogue: 0,0:04:15.13,0:04:17.31,italics,System,0,0,0,,Một nhiệm vụ mới vừa được kích hoạt.
Dialogue: 0,0:04:18.07,0:04:19.38,italicstop,System,0,0,0,,Thánh Thuẫn ẩn chứa sức mạnh
Dialogue: 0,0:04:19.38,0:04:22.27,italicstop,System,0,0,0,,gia hộ thiêng liêng của\NRebecca, Nữ thần Ánh sáng.
Dialogue: 0,0:04:21.87,0:04:23.47,italics,Grid,0,0,0,,Thánh Thuẫn cơ à?
Dialogue: 0,0:04:22.27,0:04:25.27,italicstop,System,0,0,0,,Vật phẩm này cực kỳ uy lực trước\Nquái vật hệ Bóng tối, ác ma,
Dialogue: 0,0:04:23.47,0:04:26.53,italics,Grid,0,0,0,,Đây là cơ hội vàng để mình hốt bạc bù lại\Nsố tiền hụt từ chuyến đi săn vừa rồi!
Dialogue: 0,0:04:25.27,0:04:27.77,italicstop,System,0,0,0,,và tín đồ của Giáo hội Yatan.
Dialogue: 0,0:04:29.52,0:04:34.12,Default,Valdi,0,0,0,,Ta đã mời một vị tư tế tới đây\Nđể hỗ trợ ban phước cho chiếc khiên.
Dialogue: 0,0:04:35.19,0:04:39.13,Default,Cassus,0,0,0,,Ta là bề tôi trung thành của Nữ thần Ánh sáng Rebecca.
Dialogue: 0,0:04:39.13,0:04:42.09,Default,Cassus,0,0,0,,Tên ta là Cassus.
Dialogue: 0,0:04:42.33,0:04:44.50,Default,Grid,0,0,0,,Ờm... chào ông...
Dialogue: 0,0:04:50.65,0:04:52.81,italics,Grid,0,0,0,,Mythril khó tinh luyện thấy mồ.
Dialogue: 0,0:04:53.09,0:04:55.35,italics,Grid,0,0,0,,Mình nhiều lắm cũng chỉ rèn nổi hai cái thôi.
Dialogue: 0,0:04:55.35,0:04:58.81,italics,Grid,0,0,0,,Mà lỡ ra đồ Hiếm là giao kèo coi như đi tong.
Dialogue: 0,0:04:59.24,0:05:02.44,italics,Grid,0,0,0,,Tuyệt đối không được làm hỏng chuyện,\Nvì cả gia đình mình nữa!
Dialogue: 0,0:05:07.10,0:05:11.91,Default,Toban,0,0,0,,Thưa Bang chủ, tôi đã điều tra ra thân phận cô gái\Nhạ gục Faker lần trước rồi.
Dialogue: 0,0:05:11.91,0:05:13.58,Default,Jishuka,0,0,0,,Tốt lắm. Nói nghe xem nào.
Dialogue: 0,0:05:13.58,0:05:14.41,Default,Toban,0,0,0,,Vâng ạ.
Dialogue: 0,0:05:14.41,0:05:18.38,Default,Toban,0,0,0,,Cô ta khai tên giả là "Erina" trong cuộc thi\Nrèn trang bị ở Winston,
Dialogue: 0,0:05:18.38,0:05:20.29,Default,Toban,0,0,0,,nhưng tên thật là Euphemina.
Dialogue: 0,0:05:21.60,0:05:22.84,Default,Jishuka,0,0,0,,Euphemina à?
Dialogue: 0,0:05:23.20,0:05:27.05,Default,Toban,0,0,0,,Hiện tại có vẻ cô ta chưa đầu quân\Ncho kẻ thù của chúng ta là
Dialogue: 0,0:05:27.05,0:05:29.05,Default,Toban,0,0,0,,Bang Giant đâu, cơ mà...
Dialogue: 0,0:05:30.60,0:05:33.06,Default,Jishuka,0,0,0,,Sẽ gay to nếu bọn chúng bắt đầu\Nđánh hơi tới nhắm vào cô ta đấy.
Dialogue: 0,0:05:33.06,0:05:37.84,Default,Jishuka,0,0,0,,Trong trò chơi này chỉ đếm trên đầu ngón tay\Nnhững thợ rèn chế tác được trang bị xịn.
Dialogue: 0,0:05:38.52,0:05:43.22,Default,Jishuka,0,0,0,,Bang hội nào cũng khao khát người chế tạo được\Nmấy thứ cỡ như đống mũi tên Jaffa đó.
Dialogue: 0,0:05:43.76,0:05:47.60,Default,Jishuka,0,0,0,,Bằng mọi giá, ta sẽ lần theo đầu mối Euphemina\Nđể tìm ra gã thợ rèn ta đang truy tìm!
Dialogue: 0,0:05:47.60,0:05:48.75,Default,Jishuka,0,0,0,,Nhất định phải tóm được hắn!
Dialogue: 0,0:05:48.75,0:05:49.66,Default,All,0,0,0,,Rõ!
Dialogue: 0,0:05:52.87,0:05:56.54,Default,Grid,0,0,0,,Kịp sát nút luôn, hú hồn thật chứ...
Dialogue: 0,0:05:57.51,0:06:01.46,Default,Grid,0,0,0,,Thế sao? Ông đã yểm được\Nthánh lực lên khiên chưa vậy?
Dialogue: 0,0:06:01.75,0:06:02.68,Default,Cassus,0,0,0,,Rồi.
Dialogue: 0,0:06:04.69,0:06:08.72,Default,Cassus,0,0,0,,Nữ thần Rebecca đã đáp lại lời cầu nguyện của ta.
Dialogue: 0,0:06:08.72,0:06:10.45,Default,Grid,0,0,0,,Khoan, thật luôn hả?!
Dialogue: 0,0:06:11.24,0:06:12.71,Default,Grid,0,0,0,,Để tôi ngó thử xem nào...
Dialogue: 0,0:06:13.24,0:06:14.60,screen_text,Sign,0,0,0,,{\blur2.5\fad(133,0)\c&HD4C56B&\frx346\fry26\pos(222,116.666)\frz21.05\3c&H574A43&}Thánh Thuẫn
