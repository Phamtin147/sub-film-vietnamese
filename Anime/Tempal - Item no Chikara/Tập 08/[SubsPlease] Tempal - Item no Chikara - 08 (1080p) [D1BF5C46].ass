Dialogue: 0,0:06:17.30,0:06:19.29,Default,Grid,0,0,0,,Cái của nợ này có được ban phước quái đâu,\Nthằng cha lẩm cẩm này!
Dialogue: 0,0:06:19.29,0:06:20.52,Default,Cassus,0,0,0,,À, không.
Dialogue: 0,0:06:21.36,0:06:23.19,Default,Cassus,0,0,0,,Chiếc khiên được Nữ thần ban phước là...
Dialogue: 0,0:06:23.63,0:06:25.40,Default,Cassus,0,0,0,,chiếc này cơ.
Dialogue: 0,0:06:25.71,0:06:27.07,screen_text,Sign,0,0,0,,{\fs15\bord0.5\fad(133,0)\c&H3994C2&\pos(212,140)\3c&H4D4540&\frx16\fry350\frz1.03}Thánh Thuẫn Hoàn Mỹ
Dialogue: 0,0:06:25.90,0:06:31.15,italicstop,System,0,0,0,,Chế tác thành công vật phẩm Huyền Thoại:\NTất cả chỉ số tăng thêm 25 điểm.
Dialogue: 0,0:06:29.68,0:06:33.95,Default,Grid,0,0,0,,Trúng mánh rồi! Đồ Huyền Thoại luôn, vãi chưởng!
Dialogue: 0,0:06:31.15,0:06:33.95,italicstop,System,0,0,0,,Danh tiếng của bạn trên toàn lục địa\Nđã tăng thêm 1.000 điểm.
Dialogue: 0,0:06:34.74,0:06:36.95,Default,Valdi,0,0,0,,Rèn xong chiếc khiên rồi hả?
Dialogue: 0,0:06:37.79,0:06:39.79,Default,Grid,0,0,0,,Hoàn mỹ hết nước chấm luôn, đúng chứ?
Dialogue: 0,0:06:39.79,0:06:42.16,Default,Grid,0,0,0,,Giờ thì xì tiền ra đây nào.
Dialogue: 0,0:06:42.16,0:06:43.74,Default,Valdi,0,0,0,,Tiền nong tính sau.
Dialogue: 0,0:06:43.74,0:06:45.50,Default,Valdi,0,0,0,,Trước hết, ngươi mau cút khỏi đây đi.
Dialogue: 0,0:06:45.50,0:06:47.68,Default,Grid,0,0,0,,Cái gì?! Đâu có thỏa thuận kiểu thế!
Dialogue: 0,0:06:47.68,0:06:51.48,Default,Valdi,0,0,0,,Ngân khố đang eo hẹp kể từ lúc\Nchiến tranh nổ ra rồi.
Dialogue: 0,0:06:51.48,0:06:52.92,Default,Grid,0,0,0,,Vậy thì trả khiên lại đây!
Dialogue: 0,0:06:52.92,0:06:55.01,Default,Grid,0,0,0,,Ta đây không có rảnh đi làm từ thiện đâu nhé!
Dialogue: 0,0:06:55.99,0:06:59.02,Default,Valdi,0,0,0,,Láo xược. Tống cổ hắn xuống ngục tối ngay.
Dialogue: 0,0:06:59.02,0:07:01.52,Default,Grid,0,0,0,,Cái... Khốn nạn thật sự!
Dialogue: 0,0:06:59.36,0:07:01.80,Default,Valdi,0,0,0,,Mang thứ đó tới cho ngài ấy đi.
Dialogue: 0,0:07:01.80,0:07:03.23,Default,Grid,0,0,0,,Này! Trả tiền công cho tao!
Dialogue: 0,0:07:03.23,0:07:04.78,Default,Grid,0,0,0,,Đồ ăn cướp khiên!
Dialogue: 0,0:07:03.23,0:07:05.76,Default,Cassus,0,0,0,,Hỡi Rebecca, Nữ thần Ánh sáng!
Dialogue: 0,0:07:07.19,0:07:09.07,Default,Cassus,0,0,0,,Ánh Sáng Thanh Tẩy!
Dialogue: 0,0:07:15.29,0:07:17.74,Default,Cassus,0,0,0,,Ta đã nghi ngờ có uẩn khúc từ đầu rồi.
Dialogue: 0,0:07:17.98,0:07:22.32,Default,Cassus,0,0,0,,Chỉ có giáo sĩ của Giáo hội Rebecca\Nmới sử dụng được chiếc khiên này.
Dialogue: 0,0:07:22.32,0:07:26.91,Default,Cassus,0,0,0,,Thế mà bọn chúng lại chẳng hề đề cập tới một\Nthánh kỵ sĩ nào đủ điều kiện trang bị nó.
Dialogue: 0,0:07:26.91,0:07:28.73,Default,Grid,0,0,0,,Ch-Chuyện quái gì đang diễn ra vậy?
Dialogue: 0,0:07:28.73,0:07:32.68,Default,Cassus,0,0,0,,Ép chúng ta rèn thứ mà bản thân không dùng nổi,\Nthì chỉ có duy nhất một mục đích...
Dialogue: 0,0:07:32.98,0:07:34.76,Default,Cassus,0,0,0,,đó là bọn chúng định đánh cắp nó.
Dialogue: 0,0:07:34.76,0:07:36.67,Default,Cassus,0,0,0,,Bọn chúng là tín đồ của Giáo hội Yatan!
Dialogue: 0,0:07:44.52,0:07:46.65,Default,Musta,0,0,0,,Ngươi nhìn thấu được lớp ngụy trang của ta sao.
Dialogue: 0,0:07:46.65,0:07:49.28,Default,Grid,0,0,0,,Ngươi là thằng quái nào thế hả?!\NMau trả chiếc khiên lại cho tao!
Dialogue: 0,0:07:49.28,0:07:54.07,Default,Cassus,0,0,0,,Cầm nổi cả Thánh Thuẫn trên tay thế kia,\Nhắn hẳn là một tên cốt cán sừng sỏ của Yatan.
Dialogue: 0,0:07:55.16,0:07:59.87,Default,Musta,0,0,0,,Ngươi chẳng qua chỉ là một tên tư tế quèn của Rebecca.\NĐừng hòng cản bước được ta, bởi ta chính là Musta—
Dialogue: 0,0:08:07.56,0:08:10.01,Default,Isabel,0,0,0,,Xem ra linh cảm của ta chuẩn xác thật rồi.
Dialogue: 0,0:08:13.95,0:08:16.18,screen_text,Sign,0,0,0,,{\bord3\blur3\fad(252,185)\c&H0FF2F1&\3c&H4FC1E2&\move(320,41.333,320,60,0,1920))}Isabel
Dialogue: 0,0:08:16.18,0:08:19.09,italics,Grid,0,0,0,,Lại NPC mới nữa à? Chuyện quái gì đang xảy ra vậy trời?
Dialogue: 0,0:08:19.09,0:08:22.55,Default,Cassus,0,0,0,,Thánh nữ Isabel à, người thật sự nên\Ngiữ nguyên vẹn mấy bức tường chứ.
Dialogue: 0,0:08:22.55,0:08:24.60,Default,Isabel,0,0,0,,Đập tường xông vào thế này mới ngầu lòi chứ ông!
Dialogue: 0,0:08:24.98,0:08:27.86,Default,Isabel,0,0,0,,Còn ngươi, tên tà giáo Yatan kia...
Dialogue: 0,0:08:34.95,0:08:41.25,Default,Isabel,0,0,0,,Trước tiên hãy khai mau, vì sao ngươi\Nlại muốn đoạt lấy Thánh Thuẫn.
Dialogue: 0,0:08:42.11,0:08:44.71,Default,Musta,0,0,0,,Th-Thánh khí đó là...
Dialogue: 0,0:08:44.71,0:08:47.82,Default,Musta,0,0,0,,Sao Thánh Nữ của Rebecca lại xuất hiện ở tận đây chứ?!
Dialogue: 0,0:08:47.82,0:08:50.38,Default,Isabel,0,0,0,,Nào, bắt đầu khai ra đi.
Dialogue: 0,0:08:55.59,0:08:56.71,Default,Cassus,0,0,0,,Thánh nữ Isabel!
Dialogue: 0,0:08:57.47,0:09:00.06,Default,Isabel,0,0,0,,Hắn định chơi trò đuổi bắt với ta đấy à?
Dialogue: 0,0:09:02.73,0:09:06.23,italics,Grid,0,0,0,,Đây là chuỗi nhiệm vụ đòi lại khiên sao nhỉ?
Dialogue: 0,0:09:06.23,0:09:08.94,italics,Grid,0,0,0,,Đáng lẽ phải bật bảng thông báo nhiệm vụ\Nlên tới nơi rồi chứ?
Dialogue: 0,0:09:14.78,0:09:17.12,Default,Grid,0,0,0,,Trôi qua tận ba mươi phút rồi mà chẳng thấy\Ncái bảng nào hiện lên hết trơn.
Dialogue: 0,0:09:18.37,0:09:21.58,Default,Grid,0,0,0,,Trả cái khiên lại cho tao mau!
Dialogue: 0,0:09:21.58,0:09:25.79,screen_text,Sign,0,0,0,,{\fscy120\c&HD8D3D3&\frx6\fry10\frz5.579\pos(271.999,42.001)}Bang Hội
