Dialogue: 0,0:09:21.58,0:09:25.79,screen_text,Sign,0,0,0,,{\blur2\an8\bord0\p1\fscy220\frx6\fry10\frz8.375\alpha&H0&\c&HA48C7A&\pos(352.001,224)}m 0 0 l 32 0 32 6 0 6
Dialogue: 0,0:09:23.48,0:09:27.30,Default,Regas,0,0,0,,Phải nhanh chóng tìm ra thợ rèn kia thôi,
Dialogue: 0,0:09:27.30,0:09:29.66,Default,Regas,0,0,0,,không là lại bị Bang chủ nổi đóa lên mất.
Dialogue: 0,0:09:31.90,0:09:34.56,Default,Regas,0,0,0,,Ồ, anh là Grid phải không nhỉ?
Dialogue: 0,0:09:38.43,0:09:42.51,Default,Grid,0,0,0,,Anh là gã cơ bắp phiền phức tôi gặp\Nở Làng Bairan hồi trước...
Dialogue: 0,0:09:42.96,0:09:44.15,Default,Grid,0,0,0,,Tên là Regas đúng không?
Dialogue: 0,0:09:44.15,0:09:46.10,Default,Regas,0,0,0,,Anh nhớ tên tôi luôn kìa!
Dialogue: 0,0:09:46.10,0:09:47.67,Default,Regas,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:09:47.67,0:09:49.31,Default,Regas,0,0,0,,Trông anh ủ rũ thế.
Dialogue: 0,0:09:49.31,0:09:51.29,italics,Grid,0,0,0,,À quên mất. Tên này là...
Dialogue: 0,0:09:52.49,0:09:54.86,italics,Grid,0,0,0,,một thằng ngu thích làm việc nghĩa!
Dialogue: 0,0:09:56.80,0:10:01.36,Default,Grid,0,0,0,,Món trang bị tôi khổ công rèn ra\Nbị Giáo hội Yatan cuỗm mất rồi!
Dialogue: 0,0:10:01.36,0:10:02.20,Default,Regas,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:10:02.20,0:10:03.62,Default,Grid,0,0,0,,Tôi muốn chết quách cho xong!
Dialogue: 0,0:10:04.47,0:10:06.49,Default,Regas,0,0,0,,Đừng nói gở thế chứ!
Dialogue: 0,0:10:07.25,0:10:09.02,Default,Regas,0,0,0,,Để tôi giúp anh một tay!
Dialogue: 0,0:10:09.02,0:10:11.07,Default,Regas,0,0,0,,Đừng buông xuôi cuộc sống mà!
Dialogue: 0,0:10:09.85,0:10:12.26,Default,Jishuka,0,0,0,,Cậu nghĩ mình đang làm cái trò khỉ gì thế hả?!
Dialogue: 0,0:10:18.97,0:10:19.89,Default,Regas,0,0,0,,Úi đau!
Dialogue: 0,0:10:19.89,0:10:24.06,Default,Jishuka,0,0,0,,Việc của bản thân không lo làm, lại chạy đi\Ngiúp người ngoài hả?!
Dialogue: 0,0:10:24.06,0:10:26.73,Default,Grid,0,0,0,,Ch-Chà, nóng bỏng dã man.
Dialogue: 0,0:10:26.73,0:10:31.34,Default,Regas,0,0,0,,À, đây là chị Jishuka,\NBang chủ của Bang Tzedakah bọn tôi.
Dialogue: 0,0:10:31.34,0:10:33.82,Default,Jishuka,0,0,0,,Xin lỗi nhé, nhưng Regas đang bận việc rồi.
Dialogue: 0,0:10:34.05,0:10:36.17,Default,Jishuka,0,0,0,,Cậu ta không rảnh đi lo chuyện bao đồng đâu.
Dialogue: 0,0:10:36.17,0:10:37.98,Default,Grid,0,0,0,,Này, cô làm gì có quyền quyết định thay anh ta!
Dialogue: 0,0:10:37.98,0:10:39.91,Default,Grid,0,0,0,,Anh ấy bảo sẽ giúp tôi rồi mà!
Dialogue: 0,0:10:40.13,0:10:42.90,Default,Jishuka,0,0,0,,Chính cậu mới là kẻ tự dưng từ đâu chui ra\Nxin người khác giúp đỡ ấy chứ!
Dialogue: 0,0:10:42.90,0:10:46.58,Default,Grid,0,0,0,,Làm ơn mà! Cho tôi mượn gã cơ bắp này đi!\NTôi năn nỉ cô đấy!
Dialogue: 0,0:10:46.82,0:10:48.56,Default,Crowd,0,0,0,,Gì thế kia? Đôi tình nhân cãi nhau à?
Dialogue: 0,0:10:47.70,0:10:49.83,Default,Crowd,0,0,0,,Giữa thanh thiên bạch nhật ngoài phố luôn sao?
Dialogue: 0,0:10:50.06,0:10:52.15,Default,Jishuka,0,0,0,,Haiz, thôi được rồi...
Dialogue: 0,0:10:52.15,0:10:53.79,Default,Jishuka,0,0,0,,Tôi sẽ để tự Regas quyết định.
Dialogue: 0,0:10:53.79,0:10:55.20,Default,Jishuka,0,0,0,,Thế được chưa hả?
Dialogue: 0,0:10:56.48,0:10:59.35,Default,Regas,0,0,0,,Giúp đỡ kẻ yếu! Tinh thần hiệp nghĩa!
Dialogue: 0,0:11:00.01,0:11:01.74,Default,Regas,0,0,0,,Đi thôi nào, anh Grid!
Dialogue: 0,0:11:01.74,0:11:02.46,Default,Grid,0,0,0,,Anh bạn cơ bắp!
Dialogue: 0,0:11:02.46,0:11:03.51,Default,Jishuka,0,0,0,,Chậc!
Dialogue: 0,0:11:03.51,0:11:04.97,Default,Jishuka,0,0,0,,Khốn kiếp!
Dialogue: 0,0:11:05.33,0:11:08.81,Default,Jishuka,0,0,0,,Cái tên cuồng võ thuật đó lát nữa về\Nkiểu gì cũng ăn mắng cho coi.
Dialogue: 0,0:11:08.81,0:11:10.44,Default,Woman A,0,0,0,,Cái gã trông ẻo lả yếu ớt kia
Dialogue: 0,0:11:10.70,0:11:13.04,Default,Woman A,0,0,0,,là người thi đấu với Erina trong\Ncuộc thi chế tác lần trước, đúng không?
Dialogue: 0,0:11:13.04,0:11:15.24,Default,Woman B,0,0,0,,Ừ. Hắn đi cùng lão Khan đấy.
Dialogue: 0,0:11:17.29,0:11:20.57,Default,Malaxus,0,0,0,,Rồi ta cũng sẽ sớm có được Thánh Thuẫn trong tay thôi.
Dialogue: 0,0:11:22.30,0:11:26.03,Default,Malaxus,0,0,0,,Chỉ cần dâng vật hiến tế để yểm hắc ma thuật\Nvào chiếc khiên đó,
Dialogue: 0,0:11:26.49,0:11:31.29,Default,Malaxus,0,0,0,,thánh lực của nó sẽ chuyển hóa thành\Ntà khí kinh hoàng.
Dialogue: 0,0:11:42.52,0:11:46.79,Default,Malaxus,0,0,0,,Và lời nguyền sẽ bao trùm toàn cõi Eternal.
Dialogue: 0,0:11:53.34,0:11:55.67,Default,Cassus,0,0,0,,Nguy rồi! Mất dấu hắn mất rồi!
Dialogue: 0,0:11:55.67,0:11:59.07,Default,Isabel,0,0,0,,Hắn vẫn quanh quẩn gần đây thôi.\NDù thế nào cũng phải tìm ra hắn bằng được!
Dialogue: 0,0:11:59.07,0:11:59.86,Default,Cassus,0,0,0,,Vâng!
Dialogue: 0,0:12:04.72,0:12:07.15,Default,Musta,0,0,0,,Khứu giác của con ả đó thính phát khiếp...
Dialogue: 0,0:12:09.62,0:12:11.37,Default,Musta,0,0,0,,Ngài Malaxus...
Dialogue: 0,0:12:11.37,0:12:14.71,Default,Musta,0,0,0,,Thần vô cùng tạ tội vì không mang được khiên về.
Dialogue: 0,0:12:17.29,0:12:19.21,Default,Musta,0,0,0,,Lũ Thánh Nữ của Rebecca...
Dialogue: 0,0:12:19.46,0:12:22.79,Default,Musta,0,0,0,,Ta nguyền rủa cả tông tộc nhà các ngươi!
Dialogue: 0,0:12:30.60,0:12:32.22,Default,Grid,0,0,0,,Anh Regas!
Dialogue: 0,0:12:32.22,0:12:33.05,Default,Regas,0,0,0,,Hả?
Dialogue: 0,0:12:33.05,0:12:36.37,Default,Grid,0,0,0,,Nhỡ ngọn núi này cũng không phải\Nchỗ cần tìm thì sao?
Dialogue: 0,0:12:37.27,0:12:39.23,Default,Regas,0,0,0,,Thì mình chuyển sang ngọn núi kế tiếp chứ sao!
Dialogue: 0,0:12:39.53,0:12:40.72,Default,Grid,0,0,0,,Nói thật đấy à?
Dialogue: 0,0:12:40.72,0:12:44.21,Default,Regas,0,0,0,,Cơ mà bộ giáp anh đang mặc ngầu thật đấy.
Dialogue: 0,0:12:45.35,0:12:48.76,Default,Grid,0,0,0,,Mà này, anh chắc chắn ở đây có\Nsào huyệt của Giáo hội Yatan chứ?
Dialogue: 0,0:12:49.23,0:12:50.20,Default,Regas,0,0,0,,Chắc mà.
Dialogue: 0,0:12:51.22,0:12:53.66,Default,Regas,0,0,0,,Một chiến hữu luyện võ của tôi tiết lộ rằng
Dialogue: 0,0:12:51.22,0:12:53.66,screen_text,Sign,0,0,0,,{\fs18\fad(259,0)\pos(117.333,14.5)\c&HD5CBC1&\3c&H766C65&}Bản Đồ
Dialogue: 0,0:12:51.22,0:12:53.66,screen_text,Sign,0,0,0,,{\fs10\fad(259,0)\c&HE2CCC1&\3c&H807369&\pos(201.333,22.5)}Núi Luluf
Dialogue: 0,0:12:53.93,0:12:56.73,Default,Regas,0,0,0,,từ khi chiến sự với liên quân nổ ra ác liệt,
Dialogue: 0,0:12:56.73,0:12:59.13,Default,Regas,0,0,0,,bọn chúng đã dựng căn cứ khắp nơi rồi.
Dialogue: 0,0:13:09.01,0:13:12.47,Default,Grid,0,0,0,,Chẳng thấy tên giáo đồ nào canh gác hết.\NYên ắng lạ thường luôn.
Dialogue: 0,0:13:12.47,0:13:15.14,Default,Regas,0,0,0,,Nơi này e là không phải sào huyệt tầm thường đâu.
Dialogue: 0,0:13:22.85,0:13:25.07,Default,Malaxus,0,0,0,,Khách không mời mà đến sao?
Dialogue: 0,0:13:34.85,0:13:37.00,screen_text,Sign,0,0,0,,{\fad(130,0)\move(309.333,85.333,330,85.333,0,2150))\c&HD7D6E4&\3c&H534F68&\frz1.409\frx20\fry20}Đại Tội Đồ Thứ Sáu Yatan: Malaxus\Nđã xuất hiện.
Dialogue: 0,0:13:35.17,0:13:37.00,italics,System,0,0,0,,Bạn đã bước vào trạng thái chiến đấu.
Dialogue: 0,0:13:37.00,0:13:41.99,italics,System,0,0,0,,Hắc ma pháp hùng mạnh của\NMalaxus, Đại Tội Đồ Thứ Sáu Giáo hội Yatan,
Dialogue: 0,0:13:41.99,0:13:47.15,italics,System,0,0,0,,sẽ giáng xuống các hiệu ứng bất lợi: Khiếp Sợ,\NSuy Yếu và Định Thân.
Dialogue: 0,0:13:49.59,0:13:51.56,Default,Grid,0,0,0,,Mở màn trận đấu đã dính ngay debuff rồi à?
Dialogue: 0,0:13:52.30,0:13:56.52,Default,Malaxus,0,0,0,,Ta cứ tưởng là Musta mang Thánh Thuẫn về\Ncho ta cơ đấy.
Dialogue: 0,0:13:56.80,0:13:59.43,Default,Grid,0,0,0,,Khốn nạn! Hóa ra vụ trộm khiên là do mày giật dây hả?
Dialogue: 0,0:13:59.43,0:14:00.98,Default,Grid,0,0,0,,Mau trả lại cho tao ngay!
Dialogue: 0,0:14:00.98,0:14:03.33,Default,Malaxus,0,0,0,,Ngươi biết về chiếc khiên đó sao?
Dialogue: 0,0:14:03.33,0:14:04.94,Default,Malaxus,0,0,0,,Thế thì ngươi phải chết!
Dialogue: 0,0:14:07.60,0:14:08.70,Default,Grid,0,0,0,,Anh Regas!
Dialogue: 0,0:14:14.65,0:14:18.54,Default,Regas,0,0,0,,Lão này mạnh quá tầm làm đối thủ giao hữu rồi đấy.
Dialogue: 0,0:14:20.84,0:14:22.46,Default,Malaxus,0,0,0,,Ta khá ấn tượng đấy.
Dialogue: 0,0:14:22.46,0:14:24.95,Default,Malaxus,0,0,0,,Ngươi trụ nổi qua ma pháp của ta cơ à?
Dialogue: 0,0:14:24.95,0:14:27.38,Default,Malaxus,0,0,0,,Ngươi thuộc dạng giống Yura sao?
Dialogue: 0,0:14:27.38,0:14:30.55,Default,Grid,0,0,0,,Yura á? Đừng có đánh đồng tôi với ả đàn bà đó!
Dialogue: 0,0:14:30.55,0:14:33.11,Default,Malaxus,0,0,0,,Ngươi là kẻ thù của Giáo hội Yatan sao?
Dialogue: 0,0:14:33.11,0:14:34.76,Default,Malaxus,0,0,0,,Vậy thì ta sẽ không nương tay đâu!
Dialogue: 0,0:14:35.97,0:14:37.72,Default,Grid,0,0,0,,Phản Xạ Thần Tốc!
Dialogue: 0,0:14:38.05,0:14:40.69,italicstop,System,0,0,0,,Cơn Thịnh Nộ Của Thợ Rèn đã kích hoạt.
Dialogue: 0,0:14:39.65,0:14:42.27,Default,Grid,0,0,0,,May quá nãy trước khi chui vào đây\Nmình đã buff sẵn hết rồi!
Dialogue: 0,0:14:42.69,0:14:45.28,Default,Grid,0,0,0,,Dainsleif +5!
Dialogue: 0,0:14:46.09,0:14:48.15,Default,Grid,0,0,0,,Lên đây!
Dialogue: 0,0:14:48.62,0:14:50.30,Default,Grid,0,0,0,,Kiếm Vũ Pagma!
Dialogue: 0,0:15:06.92,0:15:08.76,Default,Malaxus,0,0,0,,Kỹ năng thú vị đấy.
Dialogue: 0,0:15:08.76,0:15:10.93,Default,Malaxus,0,0,0,,Nhưng không đánh trúng được ta\Nthì cũng chỉ là đồ bỏ đi thôi!
Dialogue: 0,0:15:15.63,0:15:17.55,Default,Grid,0,0,0,,Cái áo choàng quái quỷ gì thế kia?
Dialogue: 0,0:15:17.55,0:15:20.02,Default,Grid,0,0,0,,Chắc mình phải xả chiêu liên tục...
Dialogue: 0,0:15:20.02,0:15:23.58,italics,Grid,0,0,0,,Không được, mình chẳng đủ mana\Nđể tung chiêu bừa bãi vậy.
Dialogue: 0,0:15:23.58,0:15:25.98,italics,Grid,0,0,0,,Phải tính thật kỹ thời điểm tung đòn tiếp theo.
Dialogue: 0,0:15:26.39,0:15:27.19,italics,Grid,0,0,0,,Chết tiệt...
Dialogue: 0,0:15:27.19,0:15:30.15,Default,Malaxus,0,0,0,,Yếu ớt... Quá yếu ớt!
Dialogue: 0,0:15:30.15,0:15:32.86,Default,Malaxus,0,0,0,,Cả hai tên ngu xuẩn các ngươi!
Dialogue: 0,0:15:35.24,0:15:37.01,Default,Malaxus,0,0,0,,Chết hết đi!
Dialogue: 0,0:15:44.92,0:15:48.67,Default,Jishuka,0,0,0,,Nếu không muốn bị bắn rụng như con quái kia,\Nthì né ra khỏi tầm ngắm ngay!
Dialogue: 0,0:15:48.67,0:15:49.93,Default,Regas,0,0,0,,Bang chủ!
Dialogue: 0,0:15:49.93,0:15:51.63,Default,Jishuka,0,0,0,,Tôi bám theo sau cậu đấy.
Dialogue: 0,0:15:55.30,0:15:57.89,Default,Jishuka,0,0,0,,Nghe đây. Đừng rời mắt khỏi hắn!
Dialogue: 0,0:15:58.17,0:15:59.43,Default,Grid,0,0,0,,Kia chẳng lẽ là...
Dialogue: 0,0:15:59.98,0:16:01.52,Default,Grid,0,0,0,,mũi tên Jaffa đặc biệt sao?
Dialogue: 0,0:16:01.52,0:16:03.05,Default,Grid,0,0,0,,Mũi tên đó do chính tôi rèn mà!
Dialogue: 0,0:16:04.44,0:16:05.96,Default,Jishuka,0,0,0,,Hóa ra {\i1}chính là{\i0} cậu sao...
Dialogue: 0,0:16:06.46,0:16:08.30,Default,Malaxus,0,0,0,,Lũ ngu muội!
Dialogue: 0,0:16:08.30,0:16:12.20,Default,Malaxus,0,0,0,,Ta đã vượt thoát khỏi giới hạn phàm nhân rồi!\NCác ngươi nghĩ mình làm gì nổi ta chứ?
Dialogue: 0,0:16:13.23,0:16:15.52,Default,Jishuka,0,0,0,,Vượt thoát á? Nghe nực cười ghê.
Dialogue: 0,0:16:15.52,0:16:16.89,Default,Jishuka,0,0,0,,Ngươi chẳng qua chỉ là con mồi.
Dialogue: 0,0:16:16.89,0:16:20.88,Default,Jishuka,0,0,0,,Con mồi của Bang Tzedakah bọn ta thôi!
Dialogue: 0,0:16:23.67,0:16:26.60,Default,Malaxus,0,0,0,,Ta? Là con mồi sao?
Dialogue: 0,0:16:26.60,0:16:28.27,Default,Malaxus,0,0,0,,Thật nực cười.
Dialogue: 0,0:16:28.27,0:16:31.34,Default,Malaxus,0,0,0,,Ta sẽ đem lũ các ngươi hiến tế cho Thần Yatan!
Dialogue: 0,0:16:31.34,0:16:32.67,Default,Toban,0,0,0,,Khiên Bền Bỉ!
Dialogue: 0,0:16:32.90,0:16:37.22,Default,Jishuka,0,0,0,,Tưởng mấy đòn gãi ngứa đó ăn thua à?\NCó bao nhiêu bài tung hết ra đi!
Dialogue: 0,0:16:38.93,0:16:41.56,Default,Regas,0,0,0,,Trước hết, hãy để tôi vinh dự\Ntiếp chiêu ngươi một ván!
Dialogue: 0,0:16:42.98,0:16:45.08,Default,Regas,0,0,0,,Xuyên Tâm Quyền!
Dialogue: 0,0:16:50.38,0:16:51.62,Default,Pon,0,0,0,,Nếm đòn đi!
Dialogue: 0,0:16:55.32,0:16:57.03,Default,Pon,0,0,0,,Hắn phản ứng kịp với cả chiêu đó luôn sao!
Dialogue: 0,0:16:57.03,0:16:59.59,Default,Vantner,0,0,0,,Pon! Mày lại định hớt tay trên\Ncướp công của tao nữa hả?
Dialogue: 0,0:17:00.14,0:17:03.34,Default,Pon,0,0,0,,Đánh sát thương là việc của DPS,\Ncòn Hộ Vệ như mày chỉ lo đỡ đòn đi!
Dialogue: 0,0:17:03.34,0:17:05.84,Default,Pon,0,0,0,,Hay tóc rụng sạch rồi rụng luôn\Ncả não rồi đấy hả?!
Dialogue: 0,0:17:05.84,0:17:06.98,Default,Vantner,0,0,0,,Mày vừa sủa cái gì với tao thế?!
Dialogue: 0,0:17:06.98,0:17:11.50,Default,Vantner,0,0,0,,Để tao cho mày sáng mắt ra sức mạnh của\Nmột Hộ Vệ toàn năng là thế nào!
Dialogue: 0,0:17:10.25,0:17:12.23,top,Malaxus,0,0,0,,Thảm hại...
Dialogue: 0,0:17:12.23,0:17:13.30,Default,Malaxus,0,0,0,,Câm họng!
Dialogue: 0,0:17:15.93,0:17:20.10,Default,Pon,0,0,0,,Thương Tốc Thanh!
Dialogue: 0,0:17:20.10,0:17:22.68,Default,Malaxus,0,0,0,,Đừng hòng coi thường khiên ba tầng của ta!
Dialogue: 0,0:17:22.68,0:17:24.35,Default,Vantner,0,0,0,,Búa Chiến Tomahawk!
Dialogue: 0,0:17:26.53,0:17:28.69,Default,Vantner,0,0,0,,Phá được có đúng một tầng thôi à?!
Dialogue: 0,0:17:28.69,0:17:31.00,Default,Pon,0,0,0,,Tại vũ khí của mày cùi bắp quá đấy!
Dialogue: 0,0:17:31.00,0:17:33.99,Default,Pon,0,0,0,,Công nhận bang mình đang khát một tay thợ rèn xịn thật sự.
Dialogue: 0,0:17:34.46,0:17:37.31,Default,Pon,0,0,0,,Cái gì? Hắn còn tự hồi phục được nữa sao?
Dialogue: 0,0:17:37.31,0:17:38.99,Default,Vantner,0,0,0,,Công sức nãy giờ của tao đổ sông đổ biển hết rồi!
Dialogue: 0,0:17:38.99,0:17:41.84,Default,Malaxus,0,0,0,,Trò hề láo xược tới đây là đủ rồi.
Dialogue: 0,0:17:41.84,0:17:44.70,Default,Malaxus,0,0,0,,Lũ sâu bọ dám cả gan chống lại thần linh...
Dialogue: 0,0:17:45.80,0:17:48.42,italics,System,0,0,0,,Hắc ma pháp hùng mạnh của\NMalaxus, Đại Tội Đồ Thứ Sáu Giáo hội Yatan,
Dialogue: 0,0:17:48.42,0:17:53.15,italics,System,0,0,0,,một lần nữa giáng xuống hiệu ứng bất lợi:\NKhiếp Sợ, Suy Yếu và Định Thân.
Dialogue: 0,0:17:53.15,0:17:57.53,italics,System,0,0,0,,Đòn ma pháp bổ trợ của Malaxus,\N"Cơn Thịnh Nộ Của Thần" được kích hoạt.
Dialogue: 0,0:17:59.97,0:18:03.68,Default,Toban,0,0,0,,Vừa dính debuff khủng khiếp, vừa trúng ma pháp tấn công,\Nlại còn có {\i1}hồi phục{\i0} nữa sao?!
Dialogue: 0,0:18:06.34,0:18:08.96,Default,Malaxus,0,0,0,,Và giờ là thời khắc định đoạt!
Dialogue: 0,0:18:09.62,0:18:13.85,Default,Malaxus,0,0,0,,Nhìn cho kỹ vào! Đây là cách các ngươi bỏ mạng đấy!
Dialogue: 0,0:18:15.72,0:18:17.03,Default,Vantner,0,0,0,,Regas...
Dialogue: 0,0:18:17.03,0:18:18.74,Default,Pon,0,0,0,,Chết tiệt thật chứ!
Dialogue: 0,0:18:18.74,0:18:22.04,Default,Pon,0,0,0,,Người chơi cấp cao mà chết là mất\Ncả đống điểm kinh nghiệm đấy!
Dialogue: 0,0:18:22.04,0:18:24.21,Default,Malaxus,0,0,0,,Hãy dâng tiếng gào thét tuyệt vọng cho Malaxus ta đi!
Dialogue: 0,0:18:24.21,0:18:25.35,italics,Jishuka,0,0,0,,Giờ mình phải làm sao đây?
Dialogue: 0,0:18:25.35,0:18:28.25,italics,Jishuka,0,0,0,,Lao vào cứu cậu ta rồi đặt cả đội\Nvào vòng nguy hiểm sao?
Dialogue: 0,0:18:28.25,0:18:31.42,italics,Jishuka,0,0,0,,Hay đành bỏ mặc Regas để bảo toàn\Nlực lượng của cả bang?
Dialogue: 0,0:18:32.14,0:18:36.26,Default,Grid,0,0,0,,Buông anh chàng cơ bắp ra ngay, thằng khốn!
Dialogue: 0,0:18:37.93,0:18:39.84,Default,Grid,0,0,0,,Kiếm Vũ Pagma!
Dialogue: 0,0:18:40.55,0:18:41.57,Default,Grid,0,0,0,,Khắc Chế!
Dialogue: 0,0:18:45.06,0:18:48.18,italics,System,0,0,0,,Malaxus đã rơi vào trạng thái bất động\Ntrong vòng ba giây.
Dialogue: 0,0:18:48.69,0:18:49.58,top,Grid,0,0,0,,Không sao chứ?
Dialogue: 0,0:18:48.69,0:18:49.58,italics,Malaxus,0,0,0,,Tại sao?
Dialogue: 0,0:18:49.92,0:18:54.27,italics,Malaxus,0,0,0,,Ta cứ tưởng thân xác này chỉ biết khiếp sợ mỗi Yatan thôi chứ!
Dialogue: 0,0:18:51.12,0:18:53.85,top,Regas,0,0,0,,Cảm ơn anh... Grid...
Dialogue: 0,0:18:54.90,0:18:58.86,Default,Malaxus,0,0,0,,Đừng hòng áp đảo được ta!
Dialogue: 0,0:19:00.32,0:19:03.16,Default,Malaxus,0,0,0,,Kẻ nào?!
Dialogue: 0,0:19:05.70,0:19:08.48,Default,Laella,0,0,0,,Lối này! Mau lên!
Dialogue: 0,0:19:09.37,0:19:11.30,Default,Grid,0,0,0,,L-Laella!
Dialogue: 0,0:19:11.30,0:19:13.92,Default,Grid,0,0,0,,Sao một nữ ca sĩ đẳng cấp thế giới ngoài đời thực\Nlại có mặt ở đây thế này?!
Dialogue: 0,0:19:13.92,0:19:16.14,Default,Regas,0,0,0,,Cô ấy là thành viên bang bọn tôi đấy.
Dialogue: 0,0:19:16.14,0:19:17.62,Default,Grid,0,0,0,,Tôi là fan cuồng của cô luôn đấy!
Dialogue: 0,0:19:17.62,0:19:18.53,Default,Jishuka,0,0,0,,Nhanh lên!
Dialogue: 0,0:19:19.85,0:19:20.72,Default,Malaxus,0,0,0,,Đừng hòng chạy thoát!
Dialogue: 0,0:19:25.48,0:19:27.64,Default,Malaxus,0,0,0,,Còn giấu cả chuột nhắt rình mò ở đây nữa cơ à?
Dialogue: 0,0:19:32.37,0:19:34.11,Default,Faker,0,0,0,,Kỹ năng Ẩn Thân của tôi.
Dialogue: 0,0:19:36.73,0:19:39.21,Default,Grid,0,0,0,,Chẳng rõ anh là ai, nhưng cứu bồ đúng lúc lắm!
Dialogue: 0,0:19:44.06,0:19:48.54,Default,Malaxus,0,0,0,,Lũ giòi bọ... Ta sẽ tiễn các ngươi xuống địa ngục\Nlàm vật hiến tế vinh quang!
Dialogue: 0,0:19:49.46,0:19:51.81,Default,Malaxus,0,0,0,,Hỡi Chủ nhân cao quý...
Dialogue: 0,0:19:52.31,0:19:55.00,Default,Malaxus,0,0,0,,Xin hãy thả lũ địa ngục khuyển ra,
Dialogue: 0,0:19:55.00,0:19:58.68,Default,Malaxus,0,0,0,,để chúng xé xác ăn tươi nuốt sống\Nđám người này!
Dialogue: 0,0:20:22.41,0:20:25.57,Default,Toban,0,0,0,,Kh-Khiên bất hoại của tôi...!
Dialogue: 0,0:20:25.57,0:20:26.87,Default,Jishuka,0,0,0,,Giữ vững đội hình!
Dialogue: 0,0:20:26.87,0:20:30.04,Default,Jishuka,0,0,0,,Chỉ cần tập trung phòng thủ để câu giờ\Nchờ cơ hội phản công...
Dialogue: 0,0:20:32.12,0:20:33.68,Default,Malaxus,0,0,0,,Cũng gan dạ phết đấy.
Dialogue: 0,0:20:33.68,0:20:37.94,Default,Malaxus,0,0,0,,Nhưng các ngươi tưởng chỉ có mỗi\Nmột con địa ngục khuyển thôi sao?
Dialogue: 0,0:20:46.65,0:20:49.65,Default,Malaxus,0,0,0,,Chết trong thống khổ đi, lũ ngu xuẩn.
Dialogue: 0,0:20:56.57,0:21:00.78,Default,Grid,0,0,0,,Sao lúc quái nào mình cũng phải xài\Ncái đồ phế phẩm lỗi này thế nhỉ?
Dialogue: 0,0:21:01.32,0:21:03.19,Default,Malaxus,0,0,0,,S-Sao ngươi lại có chiếc khiên đó trên tay?!
Dialogue: 0,0:21:03.42,0:21:04.33,Default,Grid,0,0,0,,Câm mồm!
Dialogue: 0,0:21:04.33,0:21:06.86,Default,Grid,0,0,0,,Chính tao rèn ra nó! Đương nhiên tao phải có rồi!
Dialogue: 0,0:21:07.42,0:21:09.49,Default,Grid,0,0,0,,Còn cái xịn kia thì bị bọn mày cuỗm mất tiêu rồi!
Dialogue: 0,0:21:09.82,0:21:11.53,Default,Malaxus,0,0,0,,Chuyện quái gì đang xảy ra thế?
Dialogue: 0,0:21:11.53,0:21:14.41,Default,Malaxus,0,0,0,,Musta đâu rồi?!
Dialogue: 0,0:21:14.78,0:21:18.96,Default,Jishuka,0,0,0,,C-Cậu không chỉ rèn ra đống mũi tên Jaffa đó,\Nmà chế tạo được cả chiếc khiên kia luôn sao?
Dialogue: 0,0:21:20.33,0:21:21.72,Default,Grid,0,0,0,,Thì sao nào?
Dialogue: 0,0:21:23.31,0:21:26.59,italics,Jishuka,0,0,0,,Cậu ta không phải thợ rèn tầm thường...
Dialogue: 0,0:21:27.03,0:21:29.30,italics,Jishuka,0,0,0,,Lẽ nào cậu ta sở hữu chức nghiệp ẩn sao?
Dialogue: 0,0:21:29.68,0:21:32.34,Default,Regas,0,0,0,,Anh Grid, làm ơn đi.
Dialogue: 0,0:21:32.34,0:21:35.27,Default,Regas,0,0,0,,Hãy giúp Bang Tzedakah bọn tôi!
Dialogue: 0,0:21:35.52,0:21:36.65,Default,Grid,0,0,0,,Anh Regas...
Dialogue: 0,0:21:37.53,0:21:40.34,italics,Grid,0,0,0,,Anh ta năn nỉ tới mức đó thì mình chẳng nỡ từ chối.
Dialogue: 0,0:21:40.67,0:21:43.28,italics,Grid,0,0,0,,Bởi như vậy mình mới vòi được của bọn họ\Nmột mớ tiền công khổng lồ chứ!
Dialogue: 0,0:21:44.00,0:21:45.33,Default,Grid,0,0,0,,Được rồi.
Dialogue: 0,0:21:45.33,0:21:46.60,Default,Regas,0,0,0,,Anh Grid!
Dialogue: 0,0:21:46.60,0:21:49.44,Default,Grid,0,0,0,,Nhưng đổi lại, chiến lợi phẩm phải chia phần!
Dialogue: 0,0:21:49.44,0:21:52.79,Default,Grid,0,0,0,,Nếu đồng ý chia đều vàng và vật phẩm rơi ra,\Nthì tôi sẽ giúp các người!
Dialogue: 0,0:21:52.79,0:21:55.07,Default,Toban,0,0,0,,Hắn đòi ăn chia một nửa cho riêng mình luôn á?!
Dialogue: 0,0:21:55.07,0:21:57.49,Default,Vantner,0,0,0,,Trong khi bọn mình vừa cứu mạng hắn miễn phí luôn đấy hả?!
Dialogue: 0,0:21:57.49,0:21:59.67,Default,Grid,0,0,0,,Các người đều chung một bang cả, đúng chứ?
Dialogue: 0,0:21:59.67,0:22:02.69,Default,Grid,0,0,0,,Vả lại người giúp tôi lúc đầu là anh Regas!
Dialogue: 0,0:22:02.69,0:22:04.76,Default,Grid,0,0,0,,Hai ông không có quyền ý kiến cò gì hết!
Dialogue: 0,0:22:05.77,0:22:08.89,Default,Faker,0,0,0,,Được thôi. Không có chiếc khiên đó...
Dialogue: 0,0:22:08.89,0:22:10.73,Default,Laella,0,0,0,,Đằng nào đội ta cũng thất bại trận công thành này thôi.
Dialogue: 0,0:22:11.26,0:22:13.47,Default,Pon,0,0,0,,Bang chủ cũng đồng ý chứ?
Dialogue: 0,0:22:14.09,0:22:14.89,Default,Jishuka,0,0,0,,Ừ.
Dialogue: 0,0:22:16.93,0:22:17.88,Default,Jishuka,0,0,0,,Grid!
Dialogue: 0,0:22:18.74,0:22:20.77,Default,Jishuka,0,0,0,,Gia nhập tổ đội của bọn tôi đi!
Dialogue: 0,0:22:22.57,0:22:24.90,Default,Jishuka,0,0,0,,Từ giờ cậu là người của Bang Tzedakah rồi đấy!
Dialogue: 0,0:22:26.59,0:22:28.72,Default,Grid,0,0,0,,Ừ, cứ giao cho tôi lo.
Dialogue: 0,0:22:30.44,0:22:34.21,italics,Grid,0,0,0,,Khoan đã, đáng lẽ mình nên đòi tỷ lệ chia vật phẩm\N70-30 mới phải chứ nhỉ.

