Dialogue: 0,0:05:33.68,0:05:35.34,Default,Man,0,0,0,,Phẩm cấp "Sử thi" ư?!
Dialogue: 0,0:05:35.34,0:05:37.45,Default,Man,0,0,0,,Lại còn có các chỉ số kinh ngạc thế kia nữa chứ!
Dialogue: 0,0:05:37.45,0:05:39.56,Default,Man,0,0,0,,Coi như kết quả trận đấu đã ngã ngũ rồi còn gì!
Dialogue: 0,0:05:40.07,0:05:41.72,Default,Man,0,0,0,,Tiểu thư Erina thật là đỉnh quá đi mất!
Dialogue: 0,0:05:46.80,0:05:49.45,top,Euphemina,0,0,0,,Cảm ơn tất cả mọi người nhé!
Dialogue: 0,0:05:47.01,0:05:49.45,Default,Khan,0,0,0,,Tay nghề của cô bé đó ngang ngửa với bác.
Dialogue: 0,0:05:49.93,0:05:52.20,Default,Khan,0,0,0,,Ở độ tuổi đó mà đạt tới trình độ này quả thực rất đáng nể.
Dialogue: 0,0:05:52.81,0:05:56.21,Default,Khan,0,0,0,,Nhưng cô bé vẫn chưa phải là đối thủ của cháu đâu.
Dialogue: 0,0:05:56.99,0:05:58.90,Default,Khan,0,0,0,,Đúng không, Grid?
Dialogue: 0,0:05:59.71,0:06:01.90,Default,Grid,0,0,0,,Vâng, tất nhiên rồi ạ.
Dialogue: 0,0:06:01.90,0:06:04.74,italics,System,0,0,0,,"Hơi Thở của Thợ Rèn Huyền Thoại" đã kích hoạt.
Dialogue: 0,0:06:04.74,0:06:06.37,italics,System,0,0,0,,Chỉ số của trang bị được chế tác sẽ tăng lên.
Dialogue: 0,0:06:06.37,0:06:07.17,Default,Grid,0,0,0,,Mình...
Dialogue: 0,0:06:08.56,0:06:10.34,Default,Grid,0,0,0,,cũng rèn xong rồi đây!
Dialogue: 0,0:06:10.34,0:06:12.72,Default,Grid,0,0,0,,Chắc chắn đám đông ngoài kia sẽ phải há hốc mồm kinh ngạc cho xem!
Dialogue: 0,0:06:15.23,0:06:16.14,Default,Guard,0,0,0,,Đứng im, không được nhúc nhích!
Dialogue: 0,0:06:16.90,0:06:18.27,Default,Guard,0,0,0,,Huroi đã khai ra tất cả rồi!
Dialogue: 0,0:06:18.27,0:06:21.73,Default,Guard,0,0,0,,Hắn ta khai rằng ngươi cũng là kẻ phản bội Bá tước Steim!
Dialogue: 0,0:06:24.53,0:06:26.65,Default,Crowd,0,0,0,,Có chuyện gì đang xảy ra thế kia?
Dialogue: 0,0:06:27.51,0:06:31.10,Default,Rabbit,0,0,0,,Đáng lẽ ra Huroi không thể còn chút sức lực nào để nói được chứ.
Dialogue: 0,0:06:31.10,0:06:33.44,Default,Rabbit,0,0,0,,Và để điều động được đám lính canh đó thì...
Dialogue: 0,0:06:33.91,0:06:37.01,Default,Rabbit,0,0,0,,Ngài đã ra tay sắp đặt chuyện này từ trước khi trận đấu bắt đầu rồi đúng không?
Dialogue: 0,0:06:38.41,0:06:41.04,Default,Valmont,0,0,0,,Ta vốn là một kẻ cẩn trọng mà.
Dialogue: 0,0:06:41.66,0:06:44.96,Default,Rabbit,0,0,0,,Ý ngài là ngài không tin tưởng ta sao?
Dialogue: 0,0:06:44.96,0:06:46.49,Default,Valmont,0,0,0,,Nếu đúng là vậy thì sao nào?
Dialogue: 0,0:06:46.49,0:06:48.30,Default,Valmont,0,0,0,,Ngươi chỉ là một con thỏ trong cái chuồng nhỏ mà thôi.
Dialogue: 0,0:06:48.30,0:06:50.80,Default,Valmont,0,0,0,,Lẽ nào ngươi định cắn lại chính chủ nhân của mình sao...
Dialogue: 0,0:06:51.47,0:06:52.88,Default,Valmont,0,0,0,,hả Rabbit?
Dialogue: 0,0:06:54.61,0:06:58.75,Default,Valmont,0,0,0,,Khan, có vẻ như ngươi sẽ phải ngoan ngoãn giao nộp lò rèn ra rồi!
Dialogue: 0,0:06:59.14,0:07:02.48,Default,Khan,0,0,0,,Tên khốn Valmont, ngươi đã gài bẫy bọn ta!
Dialogue: 0,0:07:00.66,0:07:03.52,Default,Grid,0,0,0,,Thả tao ra! Khốn nạn, mau thả tao ra!
Dialogue: 0,0:07:03.52,0:07:05.04,Default,Grid,0,0,0,,Tôi chỉ là một người thợ rèn thôi mà!
Dialogue: 0,0:07:05.04,0:07:09.49,Default,Grid,0,0,0,,Mẹ kiếp! Thả tao ra mau!
Dialogue: 0,0:07:14.62,0:07:16.45,italics,Grid,0,0,0,,Nhảm nhí hết sức.
Dialogue: 0,0:07:16.45,0:07:19.02,italics,Grid,0,0,0,,Thế còn nhiệm vụ thi đấu chế tạo trang bị thì tính sao đây hả?
