Dialogue: 0,0:18:50.82,0:18:53.10,italics,Grid,0,0,0,,Đ-Đúng là thanh kiếm tuyệt phẩm!
Dialogue: 0,0:18:53.10,0:18:54.65,italics,Grid,0,0,0,,Thèm thật đấy, nhưng mà...
Dialogue: 0,0:18:54.65,0:18:57.40,Default,Pairo,0,0,0,,Nếu ngươi vẫn khăng khăng từ chối, ta sẽ lấy mạng ngươi.
Dialogue: 0,0:19:00.02,0:19:01.61,Default,Grid,0,0,0,,Muốn giết thì cứ việc.
Dialogue: 0,0:19:01.61,0:19:02.61,Default,Pairo,0,0,0,,Sao cơ?
Dialogue: 0,0:19:02.61,0:19:08.33,Default,Grid,0,0,0,,Bị ông giết ở đây còn hơn là nhận nhiệm vụ\Nrồi thất bại bị phạt tụt cấp.
Dialogue: 0,0:19:09.17,0:19:10.29,Default,Grid,0,0,0,,Hơn nữa...
Dialogue: 0,0:19:14.46,0:19:19.17,Default,Grid,0,0,0,,Báo thù cũng chẳng có gì hay ho cả, theo tôi là vậy.
Dialogue: 0,0:19:21.21,0:19:22.16,Default,Pairo,0,0,0,,Cút đi.
Dialogue: 0,0:19:23.39,0:19:25.91,Default,Grid,0,0,0,,Ông vừa bảo tôi từ chối thì sẽ giết tôi cơ mà.
Dialogue: 0,0:19:25.91,0:19:28.33,Default,Pairo,0,0,0,,Ta không bao giờ ra tay với kẻ vô tội.
Dialogue: 0,0:19:30.32,0:19:31.68,italics,Grid,0,0,0,,Lão này bị dở hơi à?
Dialogue: 0,0:19:31.68,0:19:34.00,italics,Grid,0,0,0,,Ít ra cũng phải để lại thanh kiếm chứ.
Dialogue: 0,0:19:41.22,0:19:46.08,Default,Grid,0,0,0,,Đây là Thác Nước Loran,\Nnơi hẻo lánh nhất của hẻm núi này.
Dialogue: 0,0:19:46.62,0:19:48.49,Default,Grid,0,0,0,,Nhưng chuyện đó không quan trọng!
Dialogue: 0,0:19:48.49,0:19:51.77,Default,Grid,0,0,0,,Bích họa Kiếm Vũ Pagma đâu rồi?!\NBức tranh rốt cuộc ở đâu?!
Dialogue: 0,0:19:58.09,0:20:00.08,Default,Grid,0,0,0,,Sau làn thác nước!
Dialogue: 0,0:20:00.08,0:20:02.54,Default,Grid,0,0,0,,Mấy game kiểu này hay giấu đồ ở đây lắm!
Dialogue: 0,0:20:07.43,0:20:10.98,italics,Grid,0,0,0,,Cuối cùng mình cũng tìm thấy Kiếm Vũ Pagma rồi!
Dialogue: 0,0:20:12.06,0:20:13.63,italics,Grid,0,0,0,,Hóa ra đây là Pagma sao?
Dialogue: 0,0:20:14.44,0:20:16.97,italics,Grid,0,0,0,,Ngay cả trong tranh vẽ mà\Nông ta cũng đẹp trai quá mức quy định rồi đấy.
Dialogue: 0,0:20:17.29,0:20:20.55,Default,Grid,0,0,0,,Ủa, sao nhiệm vụ vẫn chưa hoàn thành?
Dialogue: 0,0:20:20.55,0:20:23.12,Default,Grid,0,0,0,,Chẳng lẽ bắt mình phải học thuộc hết đống này?
Dialogue: 0,0:20:23.72,0:20:25.41,Default,Grid,0,0,0,,Phiền phức thật đấy.
Dialogue: 0,0:20:26.96,0:20:29.34,Default,Grid,0,0,0,,Sao vẫn chưa nhận được kỹ năng nữa?!
Dialogue: 0,0:20:29.34,0:20:32.12,Default,Grid,0,0,0,,Mình đứng múa may bắt chước suốt ba tiếng đồng hồ rồi đấy!
Dialogue: 0,0:20:35.24,0:20:36.29,Default,Grid,0,0,0,,Ở đây cũng có một hình vẽ nữa à?
Dialogue: 0,0:20:36.65,0:20:38.54,screen_text,Sign,0,0,0,,{\fad(127,0)\c&HEEEDEB&\bord0\blur2\t(127,294,\bord1\blur0)\pos(322,114)\3c&H69625D&}Đã Học Được Kiếm Vũ Pagma
Dialogue: 0,0:20:36.65,0:20:38.54,screen_text,Sign,0,0,0,,{\fs15\b0\fad(127,0)\c&HEEEDEB&\bord0\blur2\t(127,294,\bord1\blur0)\3c&H69625D&\pos(322,168)}Nhiệm Vụ Nghề Nghiệp
Dialogue: 0,0:20:36.65,0:20:38.54,screen_text,Sign,0,0,0,,{\fad(127,0)\c&HEEEDEB&\bord0\blur2\t(127,294,\bord1\blur0)\3c&H69625D&\pos(322,270)}Chứng Minh Huyền Thoại 1 {\b0}hoàn thành!{\b1}
Dialogue: 0,0:20:37.14,0:20:38.54,italics,System,0,0,0,,[Hệ thống] Nhiệm vụ hoàn thành.
Dialogue: 0,0:20:38.54,0:20:41.88,Default,Grid,0,0,0,,Ch-Chỉ cần tìm ra nó là xong thôi á?
