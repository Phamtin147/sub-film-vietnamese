Dialogue: 0,0:10:20.78,0:10:23.99,italics,System,0,0,0,,[Hệ thống] Bạn nhận được 948.000 điểm kinh nghiệm.
Dialogue: 0,0:10:24.89,0:10:28.39,Default,Grid,0,0,0,,Xả đống kỹ năng xong cạn sạch mana rồi.
Dialogue: 0,0:10:28.70,0:10:31.21,Default,Grid,0,0,0,,Lên cấp thì mana sẽ tự hồi phục đầy lại, nhưng mà...
Dialogue: 0,0:10:33.24,0:10:34.82,italics,Grid,0,0,0,,Cơ mà thôi kệ...
Dialogue: 0,0:10:37.25,0:10:41.24,italics,Grid,0,0,0,,Miễn là không đụng độ Nhện Hẻm Núi\Nthì chắc vẫn ổn áp thôi.
Dialogue: 0,0:10:41.55,0:10:45.74,italics,Grid,0,0,0,,Đó là thứ cuối cùng mình muốn chạm mặt lúc này!
Dialogue: 0,0:10:49.18,0:10:52.25,Default,Pairo,0,0,0,,Chuỗi combo kỹ năng kết hợp cùng trang bị uy lực...
Dialogue: 0,0:10:53.59,0:10:56.54,Default,Pairo,0,0,0,,Lại còn cẩn trọng từng li từng tí nữa.
Dialogue: 0,0:10:58.52,0:10:59.93,Default,Pairo,0,0,0,,Asmophel...
Dialogue: 0,0:11:01.09,0:11:04.29,Default,Pairo,0,0,0,,Cuối cùng ta cũng tìm được kẻ\Ncó thể giúp ta rửa mối hận này!
Dialogue: 0,0:11:07.15,0:11:09.43,Default,Grid,0,0,0,,Kiếm Vũ Pagma...
Dialogue: 0,0:11:09.79,0:11:12.44,Default,Grid,0,0,0,,Rốt cuộc bức bích họa đó nằm ở đâu nhỉ?
Dialogue: 0,0:11:12.68,0:11:13.54,Default,Otogi,0,0,0,,Chết tiệt!
Dialogue: 0,0:11:15.98,0:11:18.82,Default,Minowa,0,0,0,,Biết thế chúng ta chả dại gì mò tới Hẻm Núi Kesan.
Dialogue: 0,0:11:18.82,0:11:21.41,Default,Otogi,0,0,0,,Minowa! Mày vừa lảm nhảm cái gì đấy?
Dialogue: 0,0:11:21.41,0:11:23.00,Default,Minowa,0,0,0,,K-Không có gì đâu...
Dialogue: 0,0:11:23.00,0:11:25.89,Default,Otogi,0,0,0,,Đừng có tinh tướng chỉ vì\Ntao cho mày vào tổ đội đấy nhé!
Dialogue: 0,0:11:25.89,0:11:27.57,Default,Otogi,0,0,0,,Tao tẩn cho một trận bây giờ!
Dialogue: 0,0:11:27.57,0:11:30.87,Default,Minowa,0,0,0,,X-Xin lỗi mà! Tao chỉ đùa thôi!
Dialogue: 0,0:11:30.87,0:11:32.33,Default,Ueno,0,0,0,,Này, nhìn đằng kia kìa.
Dialogue: 0,0:11:33.35,0:11:35.17,Default,Minowa,0,0,0,,Có đứa đi solo ở chỗ này á?
Dialogue: 0,0:11:35.17,0:11:37.80,Default,Minowa,0,0,0,,Chắc chắn phải là người chơi cấp cao rồi!
Dialogue: 0,0:11:37.80,0:11:40.76,Default,Otogi,0,0,0,,Chào đằng ấy! Giúp tụi tôi với được không?
Dialogue: 0,0:11:41.31,0:11:42.47,italics,Grid,0,0,0,,Hả?
Dialogue: 0,0:11:42.47,0:11:43.86,Default,Otogi,0,0,0,,Làm ơn cứu tụi tôi với!
Dialogue: 0,0:11:43.86,0:11:45.93,Default,Otogi,0,0,0,,Bọn tôi bị một con nhện khổng lồ tóm dính rồi!
Dialogue: 0,0:11:46.46,0:11:47.43,italics,Grid,0,0,0,,Mình biết tên này!
Dialogue: 0,0:11:49.32,0:11:50.88,Default,Otogi,0,0,0,,Cứu tụi tôi với.
Dialogue: 0,0:11:52.52,0:11:54.05,Default,Otogi,0,0,0,,Này!
Dialogue: 0,0:11:54.05,0:11:55.52,italics,Grid,0,0,0,,Otogi Atsushi!
Dialogue: 0,0:11:55.76,0:11:58.69,italics,Grid,0,0,0,,Sao bọn chúng lại ở đây?
Dialogue: 0,0:12:01.00,0:12:04.03,italics,Grid,0,0,0,,Mấy thằng khốn nạn từng bắt nạt mình\Nsuốt những năm cấp ba!
Dialogue: 0,0:12:04.70,0:12:07.29,italics,Grid,0,0,0,,Vào trong game mà cũng phải đụng mặt bọn chúng nữa sao!
Dialogue: 0,0:12:08.19,0:12:11.33,italics,Grid,0,0,0,,Khoan đã, sao mình lại phải chạy trốn chứ?
Dialogue: 0,0:12:12.16,0:12:14.89,italics,Grid,0,0,0,,Mình đâu còn là thằng hèn nhát của ngày xưa nữa.
Dialogue: 0,0:12:17.39,0:12:18.34,Default,Otogi,0,0,0,,Khốn kiếp thật!
Dialogue: 0,0:12:18.71,0:12:21.33,Default,Otogi,0,0,0,,Chẳng lẽ bọn mình đành phải đăng xuất sao?
Dialogue: 0,0:12:22.02,0:12:22.97,Default,Grid,0,0,0,,Yo.
Dialogue: 0,0:12:25.25,0:12:26.51,Default,Grid,0,0,0,,Cần giúp một tay không?
Dialogue: 0,0:12:26.51,0:12:29.31,Default,Minowa,0,0,0,,T-Thật á? Làm ơn giúp bọn tôi với!
Dialogue: 0,0:12:32.49,0:12:34.97,italics,Grid,0,0,0,,Chúng nó không nhìn thấy mặt mình\Nnhờ chiếc mũ này.
Dialogue: 0,0:12:34.97,0:12:36.97,italics,Grid,0,0,0,,Cơ hội trả thù nghìn năm có một đây rồi!
Dialogue: 0,0:12:37.42,0:12:39.13,Default,Grid,0,0,0,,Tự mình không thoát ra được à?
Dialogue: 0,0:12:39.13,0:12:41.30,Default,Grid,0,0,0,,Lạ thật đấy nha.
Dialogue: 0,0:12:42.79,0:12:45.07,Default,Grid,0,0,0,,Mấy cái tơ này chém đứt dễ ẹc mà.
Dialogue: 0,0:12:45.57,0:12:48.28,Default,Minowa,0,0,0,,Luồng sáng đó... Đoản kiếm đó là cấp +8!
Dialogue: 0,0:12:48.28,0:12:52.08,Default,Otogi,0,0,0,,Này, kiếm xịn vãi!\NCậu chém đứt tơ cứu bọn tôi ra được không?
Dialogue: 0,0:12:54.50,0:12:56.29,Default,Grid,0,0,0,,Được thôi, chuyện nhỏ.
Dialogue: 0,0:12:56.29,0:12:58.61,Default,Grid,0,0,0,,Miễn là tụi mày giao nộp hết tiền ra đây.
Dialogue: 0,0:12:59.21,0:13:00.79,Default,Grid,0,0,0,,Có bao nhiêu nôn ra hết xem nào.
Dialogue: 0,0:13:00.79,0:13:02.49,Default,Grid,0,0,0,,Thử nhảy lên một cái xem sao.
Dialogue: 0,0:13:03.13,0:13:03.63,Default,Grid,0,0,0,,Ồ!
Dialogue: 0,0:13:04.30,0:13:06.97,Default,Grid,0,0,0,,Bị trói chặt thế thì nhảy bằng niềm tin à!
Dialogue: 0,0:13:07.86,0:13:09.89,Default,Otogi,0,0,0,,Mày... thằng khốn nạn này!
Dialogue: 0,0:13:10.45,0:13:14.47,Default,Grid,0,0,0,,Ủa, cái ánh mắt đó là sao?\NCó ý kiến gì với tao à?
Dialogue: 0,0:13:14.47,0:13:17.60,Default,Grid,0,0,0,,Muốn nói cái gì thì cứ việc nói to lên xem nào!
Dialogue: 0,0:13:17.82,0:13:19.93,Default,Grid,0,0,0,,Ngon thì nhào vô! Nhào vô xem nào!
Dialogue: 0,0:13:18.72,0:13:20.57,Default,Otogi,0,0,0,,Mẹ kiếp mày!
Dialogue: 0,0:13:20.57,0:13:25.70,Default,Otogi,0,0,0,,Tao biết tỏng rồi. Ngoài đời chắc mày\Nchỉ là thằng otaku thất bại hèn nhát chứ gì!
Dialogue: 0,0:13:26.33,0:13:29.06,Default,Otogi,0,0,0,,Nói địa chỉ nhà mày ra đây!
Dialogue: 0,0:13:29.45,0:13:31.75,Default,Otogi,0,0,0,,Tao tới tận nơi đập mày nhừ tử ngay bây giờ!
Dialogue: 0,0:13:33.41,0:13:36.46,Default,Grid,0,0,0,,Muốn biết tao sống ở đâu à?
Dialogue: 0,0:13:36.46,0:13:37.98,Default,Grid,0,0,0,,Argentina!
Dialogue: 0,0:13:37.98,0:13:40.46,Default,Grid,0,0,0,,Có giỏi thì mò sang đó mà tìm tao!
Dialogue: 0,0:13:44.25,0:13:47.70,Default,Minowa,0,0,0,,Dừng lại đi! Mày nghĩ mày\Ncó thể muốn làm gì thì làm sao hả?!
Dialogue: 0,0:13:47.70,0:13:48.91,Default,Grid,0,0,0,,Câm mồm lại!
Dialogue: 0,0:13:49.40,0:13:51.20,Default,Minowa,0,0,0,,Eo ơi, nhìn buồn nôn quá!
Dialogue: 0,0:13:53.37,0:13:56.01,italics,Grid,0,0,0,,{\i0}Satisfy{\i1} đúng là tuyệt vời ông mặt trời!
Dialogue: 0,0:13:56.49,0:13:58.56,Default,Ueno,0,0,0,,Này, thôi đi.
Dialogue: 0,0:13:59.81,0:14:02.55,Default,Ueno,0,0,0,,Nếu cậu không định giúp\Nthì cứ việc rời đi cho rảnh nợ.
Dialogue: 0,0:14:03.26,0:14:04.23,italics,Grid,0,0,0,,Ueno...
Dialogue: 0,0:14:05.72,0:14:07.50,italics,Grid,0,0,0,,Cậu ta không giống như những kẻ khác.
Dialogue: 0,0:14:07.50,0:14:10.17,italics,Grid,0,0,0,,Đôi khi cậu ta còn khuyên can bọn chúng dừng lại.
Dialogue: 0,0:14:11.37,0:14:13.86,italics,Grid,0,0,0,,Nhưng dù sao thì cậu ta vẫn đàn đúm với tụi nó.
Dialogue: 0,0:14:14.83,0:14:16.71,Default,Grid,0,0,0,,Tao không cần tiền nữa.
Dialogue: 0,0:14:16.71,0:14:21.22,Default,Grid,0,0,0,,Quỳ xuống van xin tao cứu đi.
Dialogue: 0,0:14:21.88,0:14:22.97,Default,Ueno,0,0,0,,Tôi từ chối.
Dialogue: 0,0:14:23.63,0:14:27.75,Default,Ueno,0,0,0,,Tôi thà chết chứ nhất quyết không\Nhạ mình van xin kẻ như cậu.
Dialogue: 0,0:14:28.05,0:14:30.24,Default,Ueno,0,0,0,,Thà chết còn hơn.
Dialogue: 0,0:14:31.53,0:14:32.76,Default,Minowa,0,0,0,,Đúng thế!
Dialogue: 0,0:14:32.76,0:14:35.11,Default,Otogi,0,0,0,,Bọn tao đách thèm cho mày\Ncái cảm giác hả hê đó đâu!
Dialogue: 0,0:14:35.11,0:14:36.47,Default,Otogi,0,0,0,,Đồ tâm thần biến thái!
Dialogue: 0,0:14:37.35,0:14:39.15,italics,Grid,0,0,0,,Chết tiệt thật...
Dialogue: 0,0:14:39.15,0:14:41.06,italics,Grid,0,0,0,,Tại sao lại như thế này?
Dialogue: 0,0:14:41.53,0:14:43.98,italics,Grid,0,0,0,,Mình chẳng cảm thấy hả dạ chút nào cả!
Dialogue: 0,0:14:48.16,0:14:48.95,Default,Minowa,0,0,0,,Này!
Dialogue: 0,0:14:48.95,0:14:50.53,Default,Minowa,0,0,0,,Mày bỏ đi thật đấy à?
Dialogue: 0,0:14:52.07,0:14:54.66,Default,Otogi,0,0,0,,Biết ngay thằng đó là thằng otaku thất bại mà!
Dialogue: 0,0:15:02.85,0:15:04.02,italics,Grid,0,0,0,,Rốt cuộc mình bị làm sao thế này?
Dialogue: 0,0:15:04.02,0:15:06.99,italics,Grid,0,0,0,,Khốn kiếp! Đúng là nhảm nhí hết sức!
Dialogue: 0,0:15:08.73,0:15:12.56,italics,Grid,0,0,0,,Ngoài đời thực chúng nó bắt nạt mình tối ngày.
Dialogue: 0,0:15:12.56,0:15:17.43,italics,Grid,0,0,0,,Giờ vào trong game lại để chúng nó sỉ nhục tiếp sao?
Dialogue: 0,0:15:19.25,0:15:21.87,italics,Grid,0,0,0,,Không, tao nhất định phải bắt tụi mày trả giá.
Dialogue: 0,0:15:30.51,0:15:32.99,Default,Grid,0,0,0,,Tao dẫn Nhện Hẻm Núi tới cho tụi mày đây!
Dialogue: 0,0:15:32.99,0:15:36.26,Default,Grid,0,0,0,,Cứ việc nếm trải đau đớn rồi chết đi!
Dialogue: 0,0:15:38.58,0:15:40.14,italics,Grid,0,0,0,,Hở?
Dialogue: 0,0:15:40.88,0:15:43.85,italics,Grid,0,0,0,,Bọn chúng chọn đăng xuất trước rồi à?
Dialogue: 0,0:15:47.85,0:15:50.81,Default,Grid,0,0,0,,Oa, đúng là Nhện Hẻm Núi rồi!
Dialogue: 0,0:15:51.58,0:15:55.44,Default,Grid,0,0,0,,Chết tiệt! Đâu có tính tới nước này đâu chứ!
Dialogue: 0,0:15:55.95,0:15:57.10,Default,Grid,0,0,0,,Đao Phong!
Dialogue: 0,0:16:02.19,0:16:03.77,Default,Grid,0,0,0,,Không xi nhê gì cả!
Dialogue: 0,0:16:05.48,0:16:07.62,italics,Grid,0,0,0,,Phòng thủ của nó trâu bò quá!
Dialogue: 0,0:16:07.62,0:16:12.45,italics,Grid,0,0,0,,Mình muốn tung đòn Chính Nghĩa Bất Khuất\N300% uy lực, nhưng mà...
Dialogue: 0,0:16:17.61,0:16:19.44,italics,Grid,0,0,0,,Chết tiệt! Không thể áp sát lại gần nó được!
Dialogue: 0,0:16:19.44,0:16:21.50,italics,Grid,0,0,0,,Phải dùng Đao Phong tấn công từ xa thôi.
Dialogue: 0,0:16:21.90,0:16:22.96,italics,Grid,0,0,0,,Khoan đã...
Dialogue: 0,0:16:23.95,0:16:26.92,italics,Grid,0,0,0,,Trò chơi này cho phép tự do đến mức đó cơ mà...
Dialogue: 0,0:16:27.69,0:16:29.84,italics,Grid,0,0,0,,Liệu mình có thể kết hợp...
Dialogue: 0,0:16:31.98,0:16:33.74,italics,Grid,0,0,0,,kỹ năng này với kỹ năng khác được không nhỉ!
Dialogue: 0,0:16:36.70,0:16:37.92,Default,Grid,0,0,0,,Đao Phong!
Dialogue: 0,0:16:45.71,0:16:47.45,italics,Grid,0,0,0,,Mục tiêu là chỗ này!
Dialogue: 0,0:16:47.78,0:16:49.85,Default,Grid,0,0,0,,Chính Nghĩa Bất Khuất!
Dialogue: 0,0:17:08.59,0:17:10.55,Default,Grid,0,0,0,,M-Mình làm được rồi...
Dialogue: 1,0:17:10.55,0:17:12.96,italics,System,0,0,0,,[Hệ thống] Hợp nhất kỹ năng thành công.
