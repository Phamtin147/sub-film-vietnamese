Dialogue: 0,0:21:03.74,0:21:06.58,italics,System,0,0,0,,[Hệ thống] "Ba", "Tĩnh", "Liên", "Sát" và "Siêu".
Dialogue: 0,0:21:06.58,0:21:08.08,Default,Grid,0,0,0,,Các chiêu thức kiếm vũ!
Dialogue: 0,0:21:13.67,0:21:15.08,Default,Grid,0,0,0,,Thật không thể tin nổi!
Dialogue: 0,0:21:15.08,0:21:17.92,Default,Grid,0,0,0,,Giờ thì mình mạnh ngang ngửa\Ncác chức nghiệp chiến đấu rồi!
Dialogue: 0,0:21:18.18,0:21:21.65,Default,Grid,0,0,0,,Hiện tại mình chưa thể thi triển Sát hay Siêu được.
Dialogue: 0,0:21:21.65,0:21:25.85,Default,Grid,0,0,0,,Chắc phải nâng chỉ số trí tuệ\Nđể tăng lượng mana lên đã.
Dialogue: 0,0:21:29.64,0:21:33.04,Default,Grid,0,0,0,,Nhưng Kiếm Vũ Pagma quả thực mạnh bá cháy!
Dialogue: 0,0:21:41.69,0:21:46.49,Default,Phoenix,0,0,0,,Tôi e rằng quân đoàn Yatan\Nsẽ tiến sát pháo đài trong vài ngày tới.
Dialogue: 0,0:21:46.78,0:21:48.40,Default,Irene,0,0,0,,Bọn chúng hành quân thần tốc quá...
Dialogue: 0,0:21:48.97,0:21:51.76,Default,Irene,0,0,0,,Liệu đây có phải là kế sách của Huyết Phù Thủy không?
Dialogue: 0,0:21:51.76,0:21:55.29,Default,Phoenix,0,0,0,,Không, cô ta thích hành sự độc lập hơn.
Dialogue: 0,0:21:55.29,0:21:57.78,Default,Phoenix,0,0,0,,Kẻ vạch ra mưu đồ này\Nnhiều khả năng chính là...
Dialogue: 0,0:22:00.06,0:22:02.51,Default,Phoenix,0,0,0,,Đại Tội Đồ Thứ Sáu của Giáo hội Yatan,
Dialogue: 0,0:22:04.27,0:22:07.35,Default,Phoenix,0,0,0,,Đại Tế Ty Malaxus.

