Dialogue: 0,0:00:02.89,0:00:05.65,Default,Cultist,0,0,0,,Chào mừng các đồng đạo mới gia nhập!
Dialogue: 0,0:00:06.17,0:00:10.53,Default,Cultist,0,0,0,,Hãy dâng hiến lòng trung thành cho vị thần Yatan vĩ đại của chúng ta!
Dialogue: 0,0:00:14.33,0:00:15.48,Default,Players,0,0,0,,Các cậu cũng về phe Yatan à?
Dialogue: 0,0:00:15.48,0:00:17.20,Default,Players,0,0,0,,Vậy là chúng ta sẽ đối đầu với liên quân sao?
Dialogue: 0,0:00:17.20,0:00:19.29,Default,Players,0,0,0,,Làm kẻ phản diện cũng thú vị phết,\Nanh em thấy đúng không?
Dialogue: 0,0:00:21.73,0:00:26.01,Default,Yuta,0,0,0,,Gia nhập Giáo hội Yatan sẽ được\Ntăng thêm 20% điểm kinh nghiệm.
Dialogue: 0,0:00:26.71,0:00:30.05,Default,Yuta,0,0,0,,Bảo sao mà có biết bao nhiêu người chơi\Nđổ xô đi theo bọn chúng.
Dialogue: 0,0:00:30.71,0:00:32.42,Default,Yuta,0,0,0,,Không biết liệu phe liên quân
Dialogue: 0,0:00:33.30,0:00:35.89,Default,Yuta,0,0,0,,sẽ làm gì để ngăn chặn chúng ta đây?
