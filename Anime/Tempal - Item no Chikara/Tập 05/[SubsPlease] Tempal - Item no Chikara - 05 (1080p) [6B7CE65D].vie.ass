Dialogue: 0,0:09:11.58,0:09:14.74,Default,Khan,0,0,0,,Sao mặt cháu xị ra thế? Bộ giáp này tuyệt tác lắm mà!
Dialogue: 0,0:09:15.03,0:09:17.28,Default,Grid,0,0,0,,Nhưng nó vẫn chỉ dừng ở mức Cực Phẩm thôi bác ạ.
Dialogue: 0,0:09:17.28,0:09:19.62,Default,Grid,0,0,0,,Bác nghĩ bộ này bán được khoảng bao nhiêu?
Dialogue: 0,0:09:20.18,0:09:22.02,Default,Khan,0,0,0,,Khó nói lắm.
Dialogue: 0,0:09:22.02,0:09:24.66,Default,Khan,0,0,0,,Nhưng biết đâu cháu có thể mang nó \Nđến sàn đấu giá trong lâu đài xem sao.
Dialogue: 0,0:09:24.94,0:09:26.62,Default,Grid,0,0,0,,Đấu giá ư?
Dialogue: 0,0:09:26.62,0:09:28.51,Default,Khan,0,0,0,,Ừ. Nếu họ biết là do bác giới thiệu cháu tới,
Dialogue: 0,0:09:28.51,0:09:31.04,Default,Khan,0,0,0,,chắc họ sẽ miễn cho cháu \Nmấy thủ tục giấy tờ rườm rà đấy.
Dialogue: 0,0:09:31.33,0:09:35.30,Default,Khan,0,0,0,,Đừng kỳ vọng cao quá, \Ncứ coi như đi lấy kinh nghiệm là tốt rồi.
Dialogue: 0,0:09:36.04,0:09:38.80,italics,System,0,0,0,,Bạn đã nhận được "Chứng Nhận Người Kế Thừa Của Khan".
Dialogue: 0,0:09:39.24,0:09:41.31,Default,Grid,0,0,0,,Mình sẽ không ôm hy vọng viển vông đâu.
Dialogue: 0,0:09:41.89,0:09:44.68,Default,Grid,0,0,0,,Mình thừa biết vận may của bản thân thối cỡ nào mà.
Dialogue: 0,0:09:54.26,0:09:57.02,italics,Grid,0,0,0,,Mình sẽ đưa bộ giáp tấm này lên sàn,
Dialogue: 0,0:09:57.02,0:10:00.87,italics,Grid,0,0,0,,cùng với đôi găng tay sắt Cực Phẩm \Nmà mình vừa kịp hoàn thành sát giờ.
Dialogue: 0,0:10:01.29,0:10:03.40,italics,Grid,0,0,0,,Vấn đề là nên đặt giá khởi điểm \Nở mức bao nhiêu đây.
Dialogue: 0,0:10:03.40,0:10:05.29,italics,Grid,0,0,0,,Nếu hét giá cao quá thì sẽ chẳng ma nào mua.
Dialogue: 0,0:10:05.78,0:10:06.90,Default,Steng,0,0,0,,Xin chào!
Dialogue: 0,0:10:07.89,0:10:09.67,Default,Steng,0,0,0,,Em tên là Steng.
Dialogue: 0,0:10:09.67,0:10:11.81,Default,Steng,0,0,0,,Em đến đây để làm việc vặt cho sư phụ,
Dialogue: 0,0:10:11.81,0:10:15.09,Default,Steng,0,0,0,,nhưng nếu có chỗ nào anh chưa rõ, \Nem có thể giải thích giúp anh ạ.
Dialogue: 0,0:10:15.09,0:10:16.92,italics,Grid,0,0,0,,Ai thế này? Một người chơi khác à?
Dialogue: 0,0:10:17.60,0:10:21.98,Default,Grid,0,0,0,,Giá khởi điểm thông thường cho trang bị \Nquanh mức cấp 120 là khoảng bao nhiêu?
Dialogue: 0,0:10:22.41,0:10:25.96,Default,Steng,0,0,0,,Nếu là trang bị phẩm chất Thường, \Nchắc rơi vào khoảng 300 vàng ạ?
Dialogue: 0,0:10:25.96,0:10:27.33,Default,Grid,0,0,0,,Thế còn nếu là Cực Phẩm?
Dialogue: 0,0:10:27.33,0:10:29.45,Default,Steng,0,0,0,,C-Cực Phẩm á?!
Dialogue: 0,0:10:29.45,0:10:33.73,Default,Steng,0,0,0,,Găng tay sẽ tầm 600 vàng, \Ncòn áo giáp thì phải trên 1.800 vàng đấy ạ!
Dialogue: 0,0:10:33.97,0:10:36.18,italics,Grid,0,0,0,,Tổng cộng hai món là khoảng 2.400 vàng!
Dialogue: 0,0:10:36.18,0:10:37.86,italics,Grid,0,0,0,,Quy đổi ra là khoảng 290.000 yên á?!
Dialogue: 0,0:10:38.25,0:10:40.87,italics,Grid,0,0,0,,Nếu mình bán được với cái giá đó...
Dialogue: 0,0:10:40.87,0:10:42.99,italics,Grid,0,0,0,,thì mình giàu to rồi!
Dialogue: 0,0:10:45.60,0:10:46.62,Default,Grid,0,0,0,,Nhìn cái gì hả?
Dialogue: 0,0:10:46.62,0:10:48.31,Default,Steng,0,0,0,,Dạ không có gì...
Dialogue: 0,0:10:53.05,0:10:55.92,Default,Steng,0,0,0,,Anh Grid ơi, phiên bỏ thầu kết thúc rồi.
Dialogue: 0,0:10:56.22,0:10:57.99,Default,Steng,0,0,0,,Kết quả đấu giá sắp được công bố đấy ạ.
Dialogue: 0,0:11:00.33,0:11:02.18,Default,Woman,0,0,0,,Xin mọi người chú ý lắng nghe.
Dialogue: 0,0:11:02.47,0:11:05.93,Default,Woman,0,0,0,,Hôm nay chỉ có sáu vật phẩm được đấu giá thành công.
Dialogue: 0,0:11:07.05,0:11:08.81,Default,Man,0,0,0,,Chỉ có sáu món thôi ư?
Dialogue: 0,0:11:09.03,0:11:12.92,Default,Woman,0,0,0,,Dây chuyền của cô Claris được mua với giá 453 vàng.
Dialogue: 0,0:11:12.92,0:11:16.68,Default,Woman,0,0,0,,Đệm lót giáp của cô Grace \Nđược mua với giá 189 vàng.
Dialogue: 0,0:11:17.09,0:11:21.07,Default,Woman,0,0,0,,Vật phẩm hồi phục của anh Figret \Nđược mua với giá 15 vàng mỗi món.
Dialogue: 0,0:11:21.29,0:11:25.33,Default,Woman,0,0,0,,Và thanh trường kiếm của cậu Steng \Nđược mua với giá 1.900 vàng.
Dialogue: 0,0:11:25.33,0:11:26.88,Default,Steng,0,0,0,,H-Hoan hô!
Dialogue: 0,0:11:26.88,0:11:29.03,Default,Steng,0,0,0,,Sư phụ của em chắc chắn sẽ vui lắm cho xem!
Dialogue: 0,0:11:29.03,0:11:30.58,Default,Steng,0,0,0,,Anh cũng nghĩ vậy đúng không?
Dialogue: 0,0:11:30.58,0:11:34.25,Default,Grid,0,0,0,,Làm thế quái nào tao biết được \Nsư phụ mày nghĩ gì trong đầu chứ?
Dialogue: 0,0:11:34.77,0:11:36.59,Default,Steng,0,0,0,,A-Anh nói cũng phải.
Dialogue: 0,0:11:36.59,0:11:38.03,Default,Woman,0,0,0,,Và cuối cùng...
Dialogue: 0,0:11:38.03,0:11:39.97,Default,Woman,0,0,0,,Xin hỏi ngài Grid có mặt ở đây không ạ?
Dialogue: 0,0:11:40.88,0:11:42.43,Default,Grid,0,0,0,,Là tôi đây.
Dialogue: 0,0:11:42.78,0:11:45.08,Default,Woman,0,0,0,,Ngài Quản lý muốn trực tiếp trao đổi với ngài.
Dialogue: 0,0:11:45.39,0:11:46.81,Default,Woman,0,0,0,,Xin hãy đi theo tôi vào phòng riêng.
Dialogue: 0,0:11:47.05,0:11:48.93,Default,Steng,0,0,0,,Em tin chắc là tin tốt lành đấy ạ!
Dialogue: 0,0:11:48.93,0:11:52.06,Default,Steng,0,0,0,,Họ đã ghi nhận tâm huyết của anh rồi!
Dialogue: 0,0:11:52.49,0:11:54.59,Default,Grid,0,0,0,,C-Cậu nghĩ vậy thật à?
Dialogue: 0,0:11:58.22,0:12:01.53,Default,Valdi,0,0,0,,Ta đã nghe danh về cậu.
Dialogue: 0,0:12:01.80,0:12:04.07,Default,Valdi,0,0,0,,Xem ra ông Khan đã chỉ dạy cậu rất tốt.
Dialogue: 0,0:12:04.07,0:12:07.33,italics,Grid,0,0,0,,Thực ra phần lớn là nhờ tài năng thiên bẩm của tôi đấy.
Dialogue: 0,0:12:07.33,0:12:09.63,Default,Valdi,0,0,0,,Ta sẽ đi thẳng vào vấn đề chính.
Dialogue: 0,0:12:09.63,0:12:14.58,Default,Valdi,0,0,0,,Ta sẽ thu mua đôi găng tay và bộ giáp \Ncậu chế tạo với giá 5.500 vàng.
Dialogue: 0,0:12:16.46,0:12:20.05,italics,Grid,0,0,0,,5.500 vàng... Tức là...
Dialogue: 0,0:12:20.82,0:12:22.85,italics,Grid,0,0,0,,660.000 yên!
Dialogue: 0,0:12:23.22,0:12:27.36,Default,Valdi,0,0,0,,Và ta không chỉ dừng lại ở giáp trụ đâu. \NTa muốn đặt hàng cả vũ khí nữa.
Dialogue: 0,0:12:27.36,0:12:29.92,Default,Valdi,0,0,0,,Ba thanh kiếm, giao hàng trong vòng một tuần.
Dialogue: 0,0:12:29.92,0:12:32.98,Default,Valdi,0,0,0,,Phẩm chất tối thiểu phải đạt mức Cực Phẩm.
Dialogue: 0,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\b0\fad(130,0)\fs10\pos(317.334,98)\c&HD3D2D6&\3c&H635C58&}Nhiệm Vụ
Dialogue: 0,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\fad(130,0)\fs10\c&HD3D2D6&\3c&H635C58&\pos(304.667,138.666)}Thương Vụ Với Quản Lý Lâu Đài
Dialogue: 0,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\bord0.75\b0\fad(130,0)\fs10\c&HD3D2D6&\3c&H635C58&\pos(316.667,165.999)}Chế tạo các trang bị theo yêu cầu của Quản lý Valdi!
Dialogue: 0,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\fad(130,0)\blur2\an7\bord0\p1\fscy220\alpha&H5&\c&H7D6D74&\pos(167.999,181.333)}m 0 0 l 305 0 305 35 0 35
Dialogue: 1,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\an8\b0\fad(130,0)\fs10\c&HD3D2D6&\3c&H635C58&\bord0.75\pos(320,189.331)}Điều kiện hoàn thành: Chế tạo và bàn giao 3 thanh kiếm hạng Cực Phẩm\Ntrong khoảng cấp 120 đến 180 nội trong một tuần.
Dialogue: 1,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\an8\b0\fad(130,0)\fs10\c&HD3D2D6&\3c&H635C58&\bord0.75\pos(320,221)}Phần thưởng: Thay đổi tùy theo phẩm chất vật phẩm.
Dialogue: 1,0:12:33.12,0:12:39.73,screen_text,Sign,0,0,0,,{\an8\b0\fad(130,0)\fs10\c&HD3D2D6&\3c&H635C58&\bord0.75\pos(320,246.332)}Thất bại: Hủy bỏ thương vụ và mất toàn bộ chuỗi nhiệm vụ tiếp theo.
Dialogue: 0,0:12:33.53,0:12:34.96,italicstop,System,0,0,0,,Một nhiệm vụ mới đã được khởi tạo.
Dialogue: 0,0:12:33.77,0:12:34.95,italics,Grid,0,0,0,,Này, đùa nhau đấy à...
Dialogue: 0,0:12:34.95,0:12:37.13,italics,Grid,0,0,0,,Mình rèn mười lần thì hết chín lần rưỡi ra đồ Thường!
Dialogue: 0,0:12:37.13,0:12:39.73,italics,Grid,0,0,0,,Đương nhiên là mình phải từ chối rồi!
Dialogue: 0,0:12:39.73,0:12:43.74,Default,Valdi,0,0,0,,Tất nhiên, ta sẽ trả thù lao hậu hĩnh hơn \Nnhiều so với giá của hai món đồ hôm nay.
Dialogue: 0,0:12:48.25,0:12:48.89,italics,Grid,0,0,0,,Mình...
Dialogue: 0,0:12:50.23,0:12:51.31,italics,Grid,0,0,0,,Mình lỡ gật đầu nhận lời mất rồi.
Dialogue: 0,0:12:51.93,0:12:56.68,italics,Grid,0,0,0,,Liệu mình có thực sự rèn nổi ba món \NCực Phẩm chỉ trong vòng một tuần không trời?!
Dialogue: 0,0:13:01.51,0:13:03.63,flashback,Steng,0,0,0,,Em tin chắc là tin tốt lành đấy ạ!
Dialogue: 0,0:13:03.63,0:13:06.55,flashback,Steng,0,0,0,,Họ đã ghi nhận tâm huyết của anh rồi!
Dialogue: 0,0:13:07.36,0:13:10.00,Default,Grid,0,0,0,,Thằng nhóc đó hớn hở cứ như thể \Nngười được mời vào phòng riêng là nó không bằng...
Dialogue: 0,0:13:11.35,0:13:12.99,Default,Grid,0,0,0,,Đành phải liều mạng làm thôi.
Dialogue: 0,0:13:14.95,0:13:17.90,Default,Grid,0,0,0,,Mình sẽ không bỏ cuộc khi còn chưa bắt đầu.
Dialogue: 0,0:13:22.40,0:13:24.65,screen_text,Sign,0,0,0,,{\b1\c&HE4E4E1&\3c&H5F625A&\pos(270.667,133.001)\frx8\fry8\frz359.8}Trường Kiếm Kiên Cố
Dialogue: 0,0:13:22.40,0:13:24.65,screen_text,Sign,0,0,0,,{\frz1.876\frx0\fry2\c&HE4E4E1&\3c&H5F625A&\fs10\pos(267,197.333)}Phẩm chất: Thường (Normal)
Dialogue: 0,0:13:22.40,0:13:24.65,screen_text,Sign,0,0,0,,{\pos(248,239.333)\frz1.876\frx0\fry2\c&HD5D5D5&\3c&H5F625A&}Tấn công
Dialogue: 0,0:13:29.19,0:13:31.03,Default,Khan,0,0,0,,Một thanh kiếm thật tuyệt vời.
Dialogue: 0,0:13:31.03,0:13:33.13,Default,Grid,0,0,0,,Hả?! Lại là đồ Thường!
Dialogue: 0,0:13:33.13,0:13:34.75,Default,Grid,0,0,0,,Đồ Thường đấy!
Dialogue: 0,0:13:35.24,0:13:37.71,Default,Khan,0,0,0,,Sao cháu lại nổi nóng thế?
Dialogue: 0,0:13:37.71,0:13:40.47,Default,Grid,0,0,0,,Cháu chỉ gom đủ nguyên liệu \Nđể rèn tối đa bảy thanh kiếm thôi,
Dialogue: 0,0:13:40.47,0:13:43.96,Default,Grid,0,0,0,,vậy mà ngay thanh đầu tiên đã xịt rồi!
Dialogue: 0,0:13:45.55,0:13:48.34,Default,Khan,0,0,0,,Nỗ lực sẽ không bao giờ phản bội cháu đâu.
Dialogue: 0,0:13:48.34,0:13:50.85,Default,Khan,0,0,0,,Hãy vững tin vào bản thân và cố gắng hết sức mình.
Dialogue: 0,0:13:51.42,0:13:52.83,Default,Grid,0,0,0,,Ông già Khan này...
Dialogue: 0,0:13:58.25,0:14:01.29,Default,Khan,0,0,0,,N-Nỗ lực sẽ không bao giờ phản bội cháu...
Dialogue: 0,0:14:00.27,0:14:02.17,Default,Grid,0,0,0,,Ông im ngay đi! Đừng có nói thêm câu nào nữa!
Dialogue: 0,0:14:02.61,0:14:05.49,Default,Grid,0,0,0,,Cực Phẩm! Độc Nhất! Huyền Thoại!
Dialogue: 0,0:14:05.61,0:14:08.32,Default,Grid,0,0,0,,Cực Phẩm! Độc Nhất! Huyền Thoại!
Dialogue: 0,0:14:09.61,0:14:13.79,Default,Grid,0,0,0,,Cực Phẩm! Độc Nhất! Huyền Thoại!\NCực Phẩm! Độc Nhất! Huyền Thoại!
Dialogue: 0,0:14:15.16,0:14:18.16,Default,Grid,0,0,0,,Cực Phẩm! Độc Nhất! Huyền Thoại!\NCực Phẩm! Độc Nhất! Huyền Thoại!
Dialogue: 0,0:14:18.45,0:14:23.17,Default,Grid,0,0,0,,Cực Phẩm! Độc Nhất! Huyền Thoại!\NCực Phẩm! Độc Nhất! Huyền Thoại!
Dialogue: 0,0:14:23.74,0:14:28.93,Default,Khan,0,0,0,,Ba thanh Thường, một thanh Hiếm, và hai thanh Cực Phẩm ư?
Dialogue: 0,0:14:30.12,0:14:31.98,Default,Grid,0,0,0,,Đây là phôi nguyên liệu cuối cùng rồi...
Dialogue: 0,0:14:32.75,0:14:35.21,Default,Khan,0,0,0,,Grid, cháu ổn chứ?
Dialogue: 0,0:14:36.01,0:14:38.53,Default,Grid,0,0,0,,Tất nhiên rồi. Cháu hoàn toàn ổn.
Dialogue: 0,0:14:38.89,0:14:41.19,Default,Grid,0,0,0,,Cháu buông xuôi rồi.
Dialogue: 0,0:14:41.19,0:14:44.69,Default,Khan,0,0,0,,Đừng có nhụt chí yếu đuối như thế! \NCháu là Hậu Duệ Của Pagma cơ mà!
Dialogue: 0,0:14:46.46,0:14:49.70,Default,Grid,0,0,0,,Cháu chẳng phải Hậu Duệ Của Pagma đâu. \NCháu là Hậu Duệ Đồ Thường thì có.
Dialogue: 0,0:14:52.17,0:14:54.25,italics,Grid,0,0,0,,Tâm hồn cháu giờ đã trống rỗng như mặt hồ phẳng lặng.
Dialogue: 0,0:14:55.93,0:14:57.28,italics,Grid,0,0,0,,Cháu không còn ham muốn bất kỳ điều gì nữa.
Dialogue: 0,0:15:00.71,0:15:02.21,Default,Khan,0,0,0,,Đ-Đây là...
Dialogue: 0,0:15:09.32,0:15:11.79,Default,Grid,0,0,0,,H-Hiệu ứng hào quang gì thế này?!
Dialogue: 0,0:15:12.99,0:15:16.77,screen_text,Sign,0,0,0,,{\fad(2007,0)\an9\bord0\p1\fscy220\alpha&H20&\c&H4E5246&}m 0 0 l 200 0 200 42 0 42
Dialogue: 1,0:15:12.99,0:15:16.77,screen_text,Sign,0,0,0,,{\fad(2007,0)\b1\c&H38BCEA&\bord1\3c&H514843&\blur0.5\fs10\an8\pos(530,12.667)}Thanh Kiếm Siêu Việt Bản Ngã\N{\b0\fs9\c&HCACFCF&}Phẩm chất: {\c&H38BCEA&}Huyền Thoại (Legendary)\N\N{\c&HCACFCF&}Tấn công: 356\NTốc độ đánh: +6%\NChính xác: +10%\NPhòng thủ: +10%\N*Gây sát thương cộng thêm bằng Cấp độ mục tiêu + 200\Nkhi tung đòn tấn công\N*Khởi tạo kỹ năng "Siêu Việt"
Dialogue: 0,0:15:17.01,0:15:22.77,italics,System,0,0,0,,Chế tác thành công vật phẩm Huyền Thoại \Ngiúp tăng vĩnh viễn +25 cho toàn bộ chỉ số của bạn.
Dialogue: 0,0:15:23.18,0:15:26.11,italics,System,0,0,0,,Danh vọng của bạn tăng thêm 1.000 điểm \Ntrên toàn bộ đại lục.
Dialogue: 0,0:15:26.11,0:15:30.03,italics,System,0,0,0,,Bạn đã đạt được danh hiệu \N"Nghệ Nhân Huyền Thoại Duy Nhất".
Dialogue: 0,0:15:35.61,0:15:37.26,Default,Grid,0,0,0,,Bác Khan ơi!
Dialogue: 0,0:15:42.36,0:15:44.41,Default,Man,0,0,0,,Ph-Phù Thủy Máu...
Dialogue: 0,0:15:44.94,0:15:46.30,Default,Man,0,0,0,,Không ai có thể cản nổi ả ta...
Dialogue: 0,0:15:48.27,0:15:54.09,Default,Man,0,0,0,,Thuộc hạ xin lỗi vì không thể báo thù \Ncho ngài, thưa ngài Doran...
Dialogue: 0,0:15:57.97,0:16:02.19,Default,Man,0,0,0,,Chúng ta phải phanh thây cái xác của hắn \Nđể hiến tế cho thần Yatan.
Dialogue: 0,0:16:02.73,0:16:07.44,italics,Yura,0,0,0,,Thú thực thì mình chẳng ưa nổi \Nlũ tà giáo Yatan ghê tởm này chút nào.
Dialogue: 0,0:16:07.91,0:16:10.94,italics,Yura,0,0,0,,Nhưng nếu không kiếm được sách chuyển chức \Nnhư Roy,
Dialogue: 0,0:16:10.94,0:16:13.95,italics,Yura,0,0,0,,thì sớm muộn gì mình cũng sẽ bị \Ncác chức nghiệp cấp cao bỏ lại phía sau.
Dialogue: 0,0:16:13.95,0:16:19.70,screen_text,Sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 200 0 200 50 0 50
Dialogue: 1,0:16:13.95,0:16:19.70,screen_text,Sign,0,0,0,,{\b0\c&HD8D2CF&\bord1\3c&H514843&\blur0.5\fs9\an8\pos(530,12.667)}Nhiệm Vụ\N{\b1}Tôi Tớ Thứ Tám (Hạng SS){\b0}\N\NGiải cứu các tín đồ Yatan đang bị\N quân đội của Bá tước Steim bao vây trong đền thờ.\NTrở thành Tôi Tớ Thứ Tám của Yatan.\N\NPhần thưởng: Danh vị "Tôi Tớ Thứ Tám"\N*Tôi Tớ Thứ Tám: Kỹ năng "Đức Tin Vô Hạn"\NKỹ năng: "Truyền Đạo"\NKỹ năng: "Thần Phạt"\N\NThất bại: Cấp độ -5, Đức tin -1.000
Dialogue: 0,0:16:14.75,0:16:19.70,italics,Yura,0,0,0,,Mình phải hoàn thành nhiệm vụ cấp SS này \Nvà sở hữu những kỹ năng hùng mạnh.
Dialogue: 0,0:16:20.25,0:16:23.22,italics,Yura,0,0,0,,Mình sẽ vượt qua giới hạn \Ncủa chức nghiệp Hắc Pháp Sư...
Dialogue: 0,0:16:23.96,0:16:25.87,italics,Yura,0,0,0,,để vươn lên vị trí người chơi đứng đầu bảng xếp hạng!
Dialogue: 0,0:16:27.59,0:16:29.70,Default,Irene,0,0,0,,Đội quân chúng ta phái đi đã bị tiêu diệt sạch rồi sao?
Dialogue: 0,0:16:29.70,0:16:33.47,Default,Phoenix,0,0,0,,Đúng như tin tình báo thu thập được, \Nsố lượng tà giáo đồ ở đó rất ít.
Dialogue: 0,0:16:33.72,0:16:36.22,Default,Phoenix,0,0,0,,Thế nhưng Phù Thủy Máu lại xuất hiện ở đó.
Dialogue: 0,0:16:38.75,0:16:40.45,Default,Irene,0,0,0,,Chúng ta không thể bỏ cuộc!
Dialogue: 0,0:16:40.88,0:16:43.02,Default,Irene,0,0,0,,Xin hãy mau chóng cường hóa trang bị \Ncho quân đội của chúng ta!
Dialogue: 0,0:16:44.39,0:16:47.66,italics,Irene,0,0,0,,Doran, ta nhất định sẽ báo thù cho ngươi!
Dialogue: 0,0:16:48.26,0:16:50.07,Default,Grid,0,0,0,,Biết ngay mà! Tiền kìa!
Dialogue: 0,0:16:50.55,0:16:52.73,Default,Grid,0,0,0,,Nhặt được hẳn một đồng vàng luôn!
Dialogue: 0,0:16:52.73,0:16:54.91,Default,Grid,0,0,0,,Mình thực sự nhặt được tiền rơi ngoài đường!
Dialogue: 0,0:16:54.91,0:16:57.07,Default,Grid,0,0,0,,Phải chăng thần may mắn đã bắt đầu mỉm cười với mình rồi?
Dialogue: 0,0:16:57.07,0:16:59.38,Default,Grid,0,0,0,,Chào mừng em về với ví của anh nhé, đồng vàng bé nhỏ!
Dialogue: 0,0:17:00.79,0:17:05.64,Default,Valdi,0,0,0,,Thưa tiểu thư Irene, thực ra thần đã đặt \NGrid rèn trang bị cho chúng ta.
Dialogue: 0,0:17:05.64,0:17:09.58,Default,Valdi,0,0,0,,Cậu ấy chính là người đã vạch trần \Nnhững tội ác của Công ty Thương mại Mero trước đây.
Dialogue: 0,0:17:09.58,0:17:12.80,Default,Irene,0,0,0,,Ôi chà! Vậy ra cậu chính là người thợ rèn \Nmà ai nấy đều đang bàn tán xôn xao!
Dialogue: 0,0:17:13.45,0:17:18.32,Default,Irene,0,0,0,,Ta đã định ban thưởng cho cậu sớm hơn, \Nnhưng vì bận nhiều công việc quá...
Dialogue: 0,0:17:18.32,0:17:22.89,Default,Valdi,0,0,0,,Thưa tiểu thư Irene, đây là thanh đại kiếm \Nmà cậu ấy vừa giao cho chúng ta.
Dialogue: 0,0:17:22.89,0:17:24.33,Default,Phoenix,0,0,0,,K-Kinh ngạc thật!
Dialogue: 0,0:17:24.33,0:17:25.64,Default,Phoenix,0,0,0,,Quả là một thanh tuyệt thế bảo kiếm!
Dialogue: 0,0:17:27.07,0:17:27.89,Default,Grid,0,0,0,,Sao nào?
Dialogue: 0,0:17:31.04,0:17:33.36,Default,Grid,0,0,0,,Các vị định trả giá bao nhiêu cho nó đây?
Dialogue: 0,0:17:33.36,0:17:37.38,Default,Grid,0,0,0,,Các vị sẽ trả đúng với giá trị thực \Ncủa món trang bị Huyền Thoại này chứ?
Dialogue: 0,0:17:37.38,0:17:38.67,Default,Irene,0,0,0,,Ngài Phoenix...
Dialogue: 0,0:17:38.67,0:17:42.12,Default,Irene,0,0,0,,Với thanh kiếm này, chúng ta có thể đánh bại mụ phù thủy đó không?
Dialogue: 0,0:17:42.86,0:17:45.12,Default,Phoenix,0,0,0,,Ả ta sẽ không có lấy một tia cơ hội nào.
Dialogue: 0,0:17:46.12,0:17:48.38,Default,Irene,0,0,0,,Vậy thì không cần phải đắn đo thêm nữa.
Dialogue: 0,0:17:48.75,0:17:51.16,Default,Irene,0,0,0,,Ta giao cho Quản lý \Ntoàn quyền định giá thu mua.
Dialogue: 0,0:17:52.28,0:17:54.34,Default,Irene,0,0,0,,Cậu tên là Grid phải không nhỉ?
Dialogue: 0,0:17:54.72,0:17:57.78,Default,Irene,0,0,0,,Ta hy vọng sau này chúng ta vẫn sẽ tiếp tục hợp tác lâu dài.
Dialogue: 0,0:18:00.33,0:18:03.05,italics,Grid,0,0,0,,Hình như mình đã từng thấy chiếc nhẫn đó ở đâu rồi thì phải...
Dialogue: 0,0:18:04.09,0:18:05.17,italics,Grid,0,0,0,,Thôi, kệ xác đi.
Dialogue: 0,0:18:06.25,0:18:09.61,italics,Grid,0,0,0,,Trước mắt, mình chỉ cần biết cô nàng này \Nrất chịu chi tiền tươi thóc thật là được.
Dialogue: 0,0:18:10.61,0:18:13.34,Default,Valdi,0,0,0,,Chúng tôi sẽ trả 220.000 vàng cho thanh kiếm này.
Dialogue: 0,0:18:13.34,0:18:16.40,Default,Grid,0,0,0,,Cái gì cơ?! Giá trị của nó phải cao hơn thế nhiều...
Dialogue: 0,0:18:16.94,0:18:18.32,Default,Grid,0,0,0,,Hả? Nghìn vàng á?
Dialogue: 0,0:18:20.56,0:18:23.04,italics,Grid,0,0,0,,220.000 vàng luôn á?!
Dialogue: 0,0:18:23.04,0:18:26.08,italics,Grid,0,0,0,,Quy ra tiền mặt là 26,4 triệu yên!
Dialogue: 0,0:18:26.70,0:18:31.42,italics,Grid,0,0,0,,Mình có thể tậu một chiếc siêu xe hạng sang \Nrồi phóng tới buổi họp lớp mà trước giờ toàn trốn tránh!
Dialogue: 0,0:18:31.42,0:18:34.96,italics,Grid,0,0,0,,Phải rồi! Mình có thể đường hoàng tỏ tình \Nvới mối tình đầu Arisa nữa!
Dialogue: 0,0:18:35.21,0:18:39.38,italics,Grid,0,0,0,,Mọi nỗi thống khổ mình chịu đựng đều là để đổi lấy ngày hôm nay...
Dialogue: 0,0:18:41.17,0:18:43.10,Default,Grid,0,0,0,,Tôi chốt đơn thương vụ này!
Dialogue: 0,0:18:43.10,0:18:45.10,Default,Valdi,0,0,0,,Tốt lắm. Chúng tôi rất cảm kích.
Dialogue: 0,0:18:45.10,0:18:48.31,Default,Valdi,0,0,0,,Còn đây là một món quà nhỏ từ phía chúng tôi.
Dialogue: 0,0:18:48.31,0:18:49.92,Default,Valdi,0,0,0,,Lam Orichalcum.
Dialogue: 0,0:18:49.92,0:18:51.86,Default,Valdi,0,0,0,,Ta tin chắc thứ nguyên liệu này sẽ rất hữu ích với cậu.
Dialogue: 0,0:18:52.08,0:18:55.69,italics,Grid,0,0,0,,Đó chính là nguyên liệu để rèn món đồ \Nmà trước đây mình từng thử chế tác nhưng thất bại!
Dialogue: 0,0:18:55.69,0:18:59.57,italics,Grid,0,0,0,,Tuy hiện tại mình vẫn chưa đủ trình độ để rèn nó, \Nnhưng đúng là vận đỏ tới cản không kịp!
Dialogue: 0,0:18:59.91,0:19:01.24,Default,Grid,0,0,0,,Xin cảm ơn rất nhiều!
Dialogue: 0,0:19:01.24,0:19:04.24,Default,Valdi,0,0,0,,Giao dịch của chúng ta hoàn tất tại đây.
Dialogue: 0,0:19:05.38,0:19:06.83,italics,System,0,0,0,,Hoàn thành nhiệm vụ.
Dialogue: 0,0:19:06.83,0:19:13.04,screen_text,Sign,0,0,0,,{\b0\fs15\bord0.5\c&HF4ECE3&\3c&H43403E&\frx24\fry16\frz359.1\move(282.668,66.667,124,122,1942,2359)}Hoàn Thành Nhiệm Vụ!\NBạn đã nhận được phần thưởng hoàn thành!
Dialogue: 0,0:19:06.83,0:19:09.98,italics,System,0,0,0,,Bạn cũng nhận được thêm tước vị \Nnhư một phần thưởng bổ sung.
Dialogue: 0,0:19:08.75,0:19:13.04,screen_text,Sign,0,0,0,,{\b0\fs15\bord0.5\c&HF4ECE3&\3c&H43403E&\fad(439,0)\frz1.097\frx18\fry18\pos(420,118)}Tước vị: {\b1}Quý Tộc Xứ Winston
Dialogue: 0,0:19:09.98,0:19:13.04,italics,System,0,0,0,,Bạn được miễn trừ hoàn toàn nghĩa vụ \Nđóng thuế tại lãnh địa Winston.
Dialogue: 0,0:19:13.04,0:19:15.97,italics,Grid,0,0,0,,Cảm giác phê lâng lâng...
Dialogue: 0,0:19:15.97,0:19:18.14,italics,Grid,0,0,0,,Mình nóng lòng muốn khoe với bố mẹ quá đi mất!
Dialogue: 0,0:19:19.01,0:19:21.26,sign_generic,Sign,0,0,0,,{\fs24\an1\b1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs23)\move(322,170.667,321.333,170,0,2233)}Grid
Dialogue: 0,0:19:19.01,0:19:21.26,sign_generic,Sign,0,0,0,,{\fs9\b1\an1\blur0.25\bord0\t(0,4260,\fs8)\c&H696A6A&\move(220,219.333,222.666,219.333,22,2233)}Chức nghiệp
Dialogue: 0,0:19:19.01,0:19:21.26,sign_generic,Sign,0,0,0,,{\fs9\b1\an1\blur0.25\bord0\t(0,4260,\fs8)\c&H696A6A&\move(253,219.334,253.333,218,22,2233)}Hậu Duệ Của Pagma
Dialogue: 0,0:19:19.01,0:19:21.26,sign_generic,Sign,0,0,0,,{\fs9\b1\an1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs8)\move(219.334,240.333,222,239,22,2233)}Danh hiệu
Dialogue: 0,0:19:19.01,0:19:21.26,sign_generic,Sign,0,0,0,,{\fs9\b1\an1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs8)\move(252.334,240.334,254.666,237.667,22,2233)}Nghệ Nhân Huyền Thoại Duy Nhất
Dialogue: 0,0:19:21.26,0:19:25.01,Default,Tsukishima,0,0,0,,Grid cứ ngỡ mình vừa vớ được một món hời khổng lồ, nhưng...
Dialogue: 0,0:19:25.01,0:19:27.77,Default,Hinako,0,0,0,,Thực chất cậu ta vừa chịu lỗ nặng.
Dialogue: 0,0:19:28.01,0:19:29.73,Default,Hinako,0,0,0,,Chỉ vài tháng nữa thôi,
Dialogue: 0,0:19:29.73,0:19:33.87,Default,Hinako,0,0,0,,khi nhiều người chơi đạt đủ cấp độ để sử dụng \Nnhững vũ khí tầm cỡ Thanh Kiếm Siêu Việt Bản Ngã,
Dialogue: 0,0:19:33.87,0:19:35.90,Default,Hinako,0,0,0,,giá trị của nó sẽ còn đắt đỏ hơn gấp bội.
Dialogue: 0,0:19:36.35,0:19:40.65,Default,Hinako,0,0,0,,Thanh kiếm đó hoàn toàn có thể bán được \Nvới giá hàng trăm triệu yên.
Dialogue: 0,0:19:40.65,0:19:44.91,sign_generic,Sign,0,0,0,,{\fs24\an1\b1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs25)\move(322,170.667,320,170,0,4242)}Grid
Dialogue: 0,0:19:40.65,0:19:44.91,sign_generic,Sign,0,0,0,,{\fs8\b1\an1\blur0.25\bord0\t(0,4260,\fs9)\c&H696A6A&\move(224,218.667,221.333,220,0,4242)}Chức nghiệp
Dialogue: 0,0:19:40.65,0:19:44.91,sign_generic,Sign,0,0,0,,{\fs8\b1\an1\blur0.25\bord0\t(0,4260,\fs9)\c&H696A6A&\move(255,218.667,253.333,220,0,4242)}Hậu Duệ Của Pagma
Dialogue: 0,0:19:40.65,0:19:44.91,sign_generic,Sign,0,0,0,,{\fs8\b1\an1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs9)\move(224,239,221.333,241,0,4242)}Danh hiệu
Dialogue: 0,0:19:40.65,0:19:44.91,sign_generic,Sign,0,0,0,,{\fs8\b1\an1\blur0.25\bord0\c&H696A6A&\t(0,4260,\fs9)\move(255,239,253.333,241,0,4242)}Nghệ Nhân Huyền Thoại Duy Nhất
Dialogue: 0,0:19:41.12,0:19:43.19,Default,Tsukishima,0,0,0,,Thế thì số cậu ta vẫn nhọ thật đấy.
Dialogue: 0,0:19:44.91,0:19:47.66,sign_generic,Sign,0,0,0,,{\fs9\bord0\frx350\fry8\c&H21120D&\frz358\pos(440.667,191.334)}Tiệm Rau Củ Nagamine
Dialogue: 0,0:19:49.80,0:19:51.32,Default,Grid,0,0,0,,Con về rồi đây!
Dialogue: 0,0:19:51.32,0:19:53.72,Default,Grid,0,0,0,,Mọi người nghe con nói này! Cuối cùng con đã...
Dialogue: 0,0:19:53.72,0:19:55.92,Default,Grid,0,0,0,,Nhà mình vừa có chuyện gì xảy ra sao?
Dialogue: 0,0:19:56.50,0:19:57.67,Default,Seira,0,0,0,,Anh hai...
Dialogue: 0,0:19:58.33,0:20:02.56,Default,Seira,0,0,0,,Bố đứng ra bảo lãnh vay nợ cho một người quen...
Dialogue: 0,0:20:03.93,0:20:07.11,Default,Seira,0,0,0,,và giờ người ta quỵt nợ nên bố phải gánh hết.
Dialogue: 0,0:20:07.52,0:20:08.81,Default,Seira,0,0,0,,Tám mươi triệu yên.
Dialogue: 0,0:20:11.56,0:20:17.82,Default,Dad,0,0,0,,Nếu bán căn nhà này đi và vét sạch tiền tiết kiệm, \Nthì chúng ta gom được bốn mươi triệu yên.
Dialogue: 0,0:20:18.22,0:20:22.01,Default,Dad,0,0,0,,Đó là số tiền bố chắt chiu dành dụm cho Seira học đại học,
Dialogue: 0,0:20:22.01,0:20:23.95,Default,Dad,0,0,0,,làm lễ trưởng thành và của hồi môn lấy chồng...
Dialogue: 0,0:20:23.95,0:20:25.80,Default,Dad,0,0,0,,Bố xin lỗi con nhiều lắm!
Dialogue: 0,0:20:25.80,0:20:29.30,top,Seira,0,0,0,,Bố ơi, con không cần học đại học đâu.
Dialogue: 0,0:20:28.59,0:20:31.29,Default,Grid,0,0,0,,Con cũng là con của bố mẹ mà, hai người có nhớ không...
Dialogue: 0,0:20:29.30,0:20:31.29,top,Seira,0,0,0,,Con sẽ đi xin việc làm để phụ bố mẹ trả nợ!
Dialogue: 0,0:20:31.64,0:20:34.84,Default,Mom,0,0,0,,Seira! Bố mẹ xin lỗi vì \Nđã không thể làm bậc sinh thành tốt hơn!
Dialogue: 0,0:20:34.84,0:20:37.28,Default,Seira,0,0,0,,Không sao đâu mà! Con ổn thật mà!
Dialogue: 0,0:20:37.28,0:20:40.30,Default,Dad,0,0,0,,Bố thực sự xin lỗi con, Seira!
Dialogue: 0,0:20:40.30,0:20:44.84,italics,Grid,0,0,0,,Hơ? Họ quên bẵng sự tồn tại của mình luôn rồi...
Dialogue: 0,0:20:49.68,0:20:52.81,Default,Grid,0,0,0,,Được lắm! Chính con sẽ kiếm \Ntám mươi triệu yên đó về cho gia đình mình!
Dialogue: 0,0:20:54.56,0:20:58.01,Default,Dad,0,0,0,,Ngày mai bố sẽ đi tìm thêm việc làm mới!
Dialogue: 0,0:20:54.56,0:20:57.69,top,Mom,0,0,0,,Ngày mai mẹ cũng sẽ bắt đầu đi làm thêm!
Dialogue: 0,0:20:54.56,0:20:57.69,top,Seira,0,0,0,,Con sẽ đi làm thêm vào những ngày cuối tuần!
Dialogue: 0,0:20:58.01,0:21:00.65,Default,Grid,0,0,0,,Con vừa kiếm được cả đống tiền trong game đây này!
Dialogue: 0,0:21:00.65,0:21:02.62,Default,Grid,0,0,0,,Hơn hai mươi triệu yên đấy!
Dialogue: 0,0:21:05.16,0:21:06.33,Default,Dad,0,0,0,,Con vừa nói cái gì cơ?
Dialogue: 0,0:21:09.03,0:21:11.78,Default,Dad,0,0,0,,Tr-Trong tài khoản có hơn hai mươi triệu yên thật này!
Dialogue: 0,0:21:11.78,0:21:13.00,Default,Mom,0,0,0,,Chẳng lẽ con...
Dialogue: 0,0:21:13.00,0:21:15.75,Default,Seira,0,0,0,,Anh hai, không phải anh đi làm \Nchuyện phạm pháp đấy chứ?!
Dialogue: 0,0:21:15.75,0:21:19.04,Default,Grid,0,0,0,,Anh kiếm được hoàn toàn hợp pháp trong game. Yên tâm đi.
Dialogue: 0,0:21:23.23,0:21:27.05,Default,Dad,0,0,0,,Bố xin lỗi vì đã không chịu lắng nghe \Nnhững lời con nói trước đây.
Dialogue: 0,0:21:27.29,0:21:28.80,Default,Grid,0,0,0,,Bố à...
Dialogue: 0,0:21:28.80,0:21:31.55,Default,Dad,0,0,0,,Con đã thực sự nỗ lực làm việc \Nrất vất vả trong game, đúng không?
Dialogue: 0,0:21:31.91,0:21:34.27,Default,Dad,0,0,0,,Con giỏi lắm, Takumi.
Dialogue: 0,0:21:34.27,0:21:36.37,Default,Dad,0,0,0,,Nhưng con có chắc muốn đưa số tiền này cho bố mẹ không?
Dialogue: 0,0:21:36.69,0:21:38.42,Default,Grid,0,0,0,,Vâng. Bố mẹ cứ cầm lấy mà trang trải nợ nần đi ạ.
Dialogue: 0,0:21:38.78,0:21:40.07,Default,Dad,0,0,0,,Cảm ơn con.
Dialogue: 0,0:21:40.07,0:21:42.58,Default,Dad,0,0,0,,Có khoản này là nhà mình xoay xở trả nợ được rồi.
Dialogue: 0,0:21:43.07,0:21:48.28,Default,Dad,0,0,0,,Trong vòng ba năm tới, bố sẽ trả hết số nợ còn lại \Nvà hoàn trả đầy đủ 24 triệu yên này cho con.
Dialogue: 0,0:21:48.62,0:21:51.34,Default,Grid,0,0,0,,Người một nhà cả mà. Bố đừng bận tâm chuyện hoàn trả.
Dialogue: 0,0:21:51.34,0:21:56.21,Default,Grid,0,0,0,,Với lại không phải 24 triệu đâu bố. \NChính xác là 24.800.000 yên cơ.
Dialogue: 0,0:21:56.21,0:21:57.63,Default,Dad,0,0,0,,À-Ừ...
Dialogue: 0,0:21:57.63,0:21:59.44,italics,Grid,0,0,0,,Cuối cùng thì mọi người trong nhà cũng nể trọng mình rồi!
Dialogue: 0,0:21:59.44,0:22:02.09,Default,Mom,0,0,0,,Em cũng sẽ cố gắng làm việc chăm chỉ, mình ơi!
Dialogue: 0,0:22:02.09,0:22:03.36,Default,Seira,0,0,0,,Con cũng sẽ phụ giúp nữa!
Dialogue: 0,0:22:03.36,0:22:05.54,italics,Grid,0,0,0,,Khoản nợ mà ông già phải gánh vẫn còn lớn lắm.
Dialogue: 0,0:22:04.37,0:22:06.25,top,Dad,0,0,0,,Ừ, cả nhà chúng ta hãy cùng nhau đồng lòng vượt qua nhé!
Dialogue: 0,0:22:05.82,0:22:08.72,italics,Grid,0,0,0,,Nhưng lần này, chính mình phải là trụ cột vực dậy gia đình!

