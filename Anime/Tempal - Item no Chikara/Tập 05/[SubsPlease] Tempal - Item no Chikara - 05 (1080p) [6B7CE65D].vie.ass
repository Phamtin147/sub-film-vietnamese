Dialogue: 0,0:00:06.57,0:00:07.77,italics,Grid,0,0,0,,Rabbit...
Dialogue: 0,0:00:08.13,0:00:10.16,italics,Grid,0,0,0,,Sao tự dưng ông lại để bị tóm cổ thế hả?
Dialogue: 0,0:00:10.69,0:00:13.65,italics,Grid,0,0,0,,Rõ ràng trước đó còn vẽ ra bao nhiêu viễn cảnh ngon ăn...
Dialogue: 0,0:00:14.39,0:00:18.62,italics,Grid,0,0,0,,Nhưng giờ mình đã tự tin hơn nhiều \Nsau khi thực sự rèn ra được một vật phẩm xịn.
Dialogue: 0,0:00:23.41,0:00:25.12,sign_generic,Sign,0,0,0,,{\bord0\fs15\frz17.43\c&H6B5C82&\pos(262,133.334)\frx8\fry4}Việc làm
Dialogue: 0,0:00:25.50,0:00:28.97,italics,Grid,0,0,0,,Thay vì đi phụ hồ bốc vác theo ngày, \Nchẳng phải kiếm tiền bằng thứ
Dialogue: 0,0:00:28.97,0:00:31.69,italics,Grid,0,0,0,,mình giỏi nhất sẽ tốt hơn sao?
Dialogue: 0,0:00:33.55,0:00:34.38,Default,Mom,0,0,0,,Cái gì cơ?
Dialogue: 0,0:00:34.38,0:00:36.64,Default,Mom,0,0,0,,Con định nghỉ làm công việc ban ngày luôn đấy à?
Dialogue: 0,0:00:36.64,0:00:40.65,Default,Grid,0,0,0,,Vâng. Con nghĩ mình nên phát huy \Nnhững thế mạnh sẵn có của bản thân.
Dialogue: 0,0:00:40.65,0:00:42.80,Default,Seira,0,0,0,,Anh đang nghĩ cái quái gì vậy, anh hai?
Dialogue: 0,0:00:42.80,0:00:45.02,Default,Mom,0,0,0,,Mày lại định quay về làm thằng ăn bám NEET đấy hả?
Dialogue: 0,0:00:45.02,0:00:47.95,Default,Grid,0,0,0,,Không phải! Con định kiếm tiền trong game cơ mà.
Dialogue: 0,0:00:47.95,0:00:49.98,Default,Mom,0,0,0,,Mày vẫn còn mở mồm nói câu đó được à?
Dialogue: 0,0:00:49.98,0:00:51.90,Default,Mom,0,0,0,,Chẳng qua là mày chỉ muốn cắm đầu chơi game cả ngày thôi.
Dialogue: 0,0:00:51.90,0:00:53.49,Default,Grid,0,0,0,,Không phải thế đâu mà!
Dialogue: 0,0:00:53.49,0:00:56.10,Default,Grid,0,0,0,,Con có thể bán những vật phẩm mình chế tạo trong game!
Dialogue: 0,0:00:56.10,0:00:58.95,Default,Grid,0,0,0,,Mỗi tháng con có thể kiếm được \Nhàng trăm nghìn yên đấy!
Dialogue: 0,0:00:59.75,0:01:02.97,Default,Dad,0,0,0,,Takumi, con tỉnh mộng lại đi.
Dialogue: 0,0:01:03.51,0:01:09.02,Default,Dad,0,0,0,,Nếu con thực sự kiếm ra tiền từ game, \Nthì đã chẳng ngập đầu trong nợ nần như thế.
Dialogue: 0,0:01:09.02,0:01:11.63,Default,Grid,0,0,0,,Ch-Chuyện đó thì cũng đúng...
Dialogue: 0,0:01:11.63,0:01:14.69,Default,Grid,0,0,0,,Nhưng con vừa mới chuyển chức \Nthành Thợ Rèn Huyền Thoại mà...
Dialogue: 0,0:01:14.69,0:01:16.33,Default,Dad,0,0,0,,Đừng có nói chuyện viển vông nữa.
Dialogue: 0,0:01:17.18,0:01:21.24,Default,Dad,0,0,0,,Takumi à, kiếm đồng tiền không dễ dàng vậy đâu.
Dialogue: 0,0:01:21.24,0:01:24.23,Default,Dad,0,0,0,,Con chỉ có nước chăm chỉ làm lụng \Nrồi tích cóp từng chút một thôi.
Dialogue: 0,0:01:24.23,0:01:27.65,Default,Dad,0,0,0,,Bố và mẹ ngày nào cũng phải nai lưng ra làm việc.
Dialogue: 0,0:01:28.06,0:01:32.08,Default,Dad,0,0,0,,Con đã là người lớn rồi. \NHãy tiếp tục đi làm đàng hoàng như vừa qua đi.
Dialogue: 0,0:01:32.41,0:01:33.31,Default,Dad,0,0,0,,Hiểu chưa hả?
Dialogue: 0,0:01:56.24,0:01:57.77,sign_generic,Sign,0,0,0,,{\fad(51,0)\bord3\blur2\an1\fs17\b1\fnSegoe UI\c&H095DF8&\3c&HBFBEC1&\t(0,1469,\fs16)\move(365.999,253.999,359.333,248.667,0,1450)}O{\c&H0A27EB&}v{\c&H1828CE&}e{\c&H1026F3&\}r{\c&H1705C3&}g{\c&H1306A0&}e{\c&H0F028F&}a{\c&H090544&}r{\c&H211D2F&}e{\c&H000000&}d
Dialogue: 0,0:01:57.77,0:02:01.00,sign_generic,Sign,0,0,0,,{\fad(0,1080)\bord3\blur2\an1\fs16\b1\fnSegoe UI\c&H095DF8&\3c&HBFBEC1&\t(0,273,\3c&HFEFEFE&)\t(0,273,\c&H252525&)\pos(359.333,248.667)}O{\c&H0A27EB&\t(0,273,\c&H666767&)}v{\c&H1828CE&\t(0,273,\c&H363636&)}e{\c&H1026F3&\t(0,273,\c&H7E7E7E&)}r{\c&H1705C3&\t(0,273,\c&H5E5E5E&)}g{\c&H1306A0&\t(0,273,\c&H252525&)}e{\c&H0F028F&\t(0,273,\c&H666767&)}a{\c&H090544&\t(0,273,\c&H363636&)}r{\c&H211D2F&\t(0,273,\c&H7E7E7E&)}e{\c&H000000&\t(0,273,\c&H5E5E5E&)}d
Dialogue: 0,0:03:17.02,0:03:21.69,Default,Grid,0,0,0,,Mình đã cày nghề rèn mỗi tối sau giờ đi làm \Nsuốt trọn một tháng trời rồi.
Dialogue: 0,0:03:21.69,0:03:24.12,Default,Grid,0,0,0,,Oải thật sự đấy!
Dialogue: 0,0:03:24.55,0:03:27.53,Default,Grid,0,0,0,,Đúng là mình nên nghỉ quách việc làm ban ngày đi...
Dialogue: 0,0:03:28.41,0:03:31.19,Default,Grid,0,0,0,,Phải tìm cách nào đó thuyết phục người nhà đồng ý mới được.
Dialogue: 0,0:03:32.75,0:03:36.25,Default,Grid,0,0,0,,Khốn kiếp! Giá như lão Rabbit \Nkhông bị tống vào ngục!
Dialogue: 0,0:03:36.62,0:03:37.73,italics,Rabbit,0,0,0,,Gửi anh Grid.
Dialogue: 0,0:03:38.39,0:03:41.74,italics,Rabbit,0,0,0,,Chắc hẳn anh cũng đã biết \Ntình cảnh hiện tại của tôi.
Dialogue: 0,0:03:41.74,0:03:46.37,italics,Rabbit,0,0,0,,Tôi thực sự lấy làm tiếc vì kế hoạch làm ăn \Ncủa chúng ta đã đổ bể.
Dialogue: 0,0:03:46.37,0:03:53.84,italics,Rabbit,0,0,0,,Nhưng với tay nghề của anh cùng sự trợ giúp của ông Khan, \Ntôi tin chắc anh sẽ phát tài.
Dialogue: 0,0:03:54.33,0:03:58.88,italics,Rabbit,0,0,0,,Tôi rất mong chờ ngày được nghe \Ntin tức thành công vang dội của anh.
Dialogue: 0,0:03:59.45,0:04:00.80,italics,Rabbit,0,0,0,,Ký tên: Rabbit.
Dialogue: 0,0:04:03.78,0:04:05.80,Default,Grid,0,0,0,,Số mình đúng là nhọ như con bọ.
Dialogue: 0,0:04:06.05,0:04:09.77,Default,Grid,0,0,0,,Mà tên Huroi dạo này đang làm gì không biết?
Dialogue: 0,0:04:10.28,0:04:14.94,Default,Grid,0,0,0,,Cả con nhóc láo toét làm mình sôi máu kia \Ncũng bặt vô âm tín luôn.
Dialogue: 0,0:04:16.52,0:04:21.61,sign_generic,Sign,0,0,0,,{\an1\fs24\fad(236,0)\b1\bord1\blur0.5\pos(55,294.666)}Frontier
Dialogue: 0,0:04:17.95,0:04:23.37,top,Euphemina,0,0,0,,Mất công lặn lội tới tận thủ đô, \Nthế mà chẳng tìm nổi công thức chế tạo Pháp Cầu.
Dialogue: 0,0:04:48.98,0:04:52.18,Default,Euphemina,0,0,0,,Này. Mấy người là lũ biến thái đấy à?
Dialogue: 0,0:04:52.67,0:04:56.16,Default,Euphemina,0,0,0,,Lớn đầu rồi mà còn đi bám đuôi \Nmột cô gái suốt cả ngày trời không biết ngượng sao.
Dialogue: 0,0:04:57.21,0:04:59.93,italics,Faker,0,0,0,,Cô ta nhìn thấu được kỹ năng Ngụy Trang của mình ư?
Dialogue: 0,0:05:00.81,0:05:03.66,Default,Faker,0,0,0,,Cô chính là người thợ rèn \Nđã chế tác ra vật phẩm Cực Phẩm
Dialogue: 0,0:05:03.66,0:05:06.28,Default,Faker,0,0,0,,trong cuộc thi rèn trang bị \Nở Làng Winston, đúng không?
Dialogue: 0,0:05:06.67,0:05:08.49,Default,Faker,0,0,0,,Tôi muốn nói chuyện với cô.
Dialogue: 0,0:05:13.77,0:05:16.85,Default,Euphemina,0,0,0,,Đó là thái độ khi muốn nhờ vả \Nngười khác đấy hả?
Dialogue: 0,0:05:16.85,0:05:18.65,Default,Faker,0,0,0,,Nói chuyện đàng hoàng đi, nhóc.
Dialogue: 0,0:05:19.25,0:05:21.30,Default,Euphemina,0,0,0,,Anh vừa gọi ai là nhóc cơ?
Dialogue: 0,0:05:24.80,0:05:26.26,Default,Euphemina,0,0,0,,Tiếng Thét Thiên Thần!
Dialogue: 0,0:05:34.11,0:05:36.77,Default,Euphemina,0,0,0,,Sao nào, còn muốn nói chuyện nữa không?
Dialogue: 0,0:05:39.10,0:05:42.32,Default,Faker,0,0,0,,Rốt cuộc cô {\i1}là{\i0} ai?
Dialogue: 0,0:05:48.23,0:05:50.19,Default,Jishuka,0,0,0,,Ch-Chuyện này là...
Dialogue: 0,0:05:51.84,0:05:52.87,Default,Jishuka,0,0,0,,Faker!
Dialogue: 0,0:05:53.72,0:05:55.94,Default,Faker,0,0,0,,Xin lỗi... Tôi thất thủ rồi.
Dialogue: 0,0:05:57.19,0:05:59.25,Default,Vantner,0,0,0,,Cô ta chỉ có một mình thôi á?!
Dialogue: 0,0:05:59.25,0:06:00.61,Default,Jishuka,0,0,0,,Lố bịch thật!
Dialogue: 0,0:06:00.61,0:06:03.12,Default,Jishuka,0,0,0,,Cậu là Sát Thủ đứng hạng nhất trên bảng xếp hạng đấy!
Dialogue: 0,0:06:03.12,0:06:05.42,Default,Jishuka,0,0,0,,Làm thế quái nào lại bị một thợ rèn phát hiện được?!
Dialogue: 0,0:06:05.42,0:06:10.21,Default,Faker,0,0,0,,Cô ta có thể sử dụng đủ mọi loại kỹ năng khác nhau.
Dialogue: 0,0:06:10.21,0:06:11.43,Default,Jishuka,0,0,0,,Cái gì cơ?
Dialogue: 0,0:06:11.90,0:06:14.97,Default,Jishuka,0,0,0,,Cô ta không phải người thợ rèn mà chị đang tìm sao?
Dialogue: 0,0:06:15.45,0:06:16.33,Default,Jishuka,0,0,0,,Nhưng mà...
Dialogue: 0,0:06:16.95,0:06:18.85,Default,Jishuka,0,0,0,,Mau tìm ra cô ta ngay lập tức.
Dialogue: 0,0:06:19.31,0:06:24.36,Default,Jishuka,0,0,0,,Chúng ta sẽ dạy cho cô ta biết hậu quả \Nkhi dám đụng vào Bang Tzedakah này!
Dialogue: 0,0:06:28.32,0:06:31.44,Default,Khan,0,0,0,,Grid à, cháu nghỉ tay một lát đi.
Dialogue: 0,0:06:31.44,0:06:36.62,Default,Grid,0,0,0,,Vâng. Cháu đã vung búa ròng rã \Nsuốt cả tháng trời rồi.
