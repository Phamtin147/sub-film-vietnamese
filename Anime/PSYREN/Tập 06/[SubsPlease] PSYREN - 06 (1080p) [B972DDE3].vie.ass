Dialogue: 0,0:00:01.56,0:00:03.08,DefaultItalics,SIGN & VO,0,0,0,,Cậu có biết truyền thuyết đô thị đó không?
Dialogue: 0,0:00:03.08,0:00:04.98,DefaultItalics,SIGN & VO,0,0,0,,Tớ mới nghe được chuyện rùng rợn về bốt điện thoại công cộng đấy.
Dialogue: 0,0:00:04.98,0:00:07.58,DefaultItalics,SIGN & VO,0,0,0,,Nếu cậu nhấc máy nghe cuộc gọi đó,\Ncậu sẽ bị đưa tới thiên đường.
Dialogue: 0,0:00:07.58,0:00:08.71,DefaultItalics,SIGN & VO,0,0,0,,Thật hả?
Dialogue: 0,0:00:09.49,0:00:11.66,DefaultItalics,SIGN & VO,0,0,0,,Điện thoại công cộng đúng kiểu hoài cổ thật đấy.
Dialogue: 0,0:00:12.08,0:00:13.86,DefaultItalics,SIGN & VO,0,0,0,,Giờ vẫn còn thứ đó cơ à?
Dialogue: 0,0:00:14.49,0:00:16.99,DefaultItalics,SIGN & VO,0,0,0,,Hồi tiểu học tớ từng được dạy cách dùng rồi.
Dialogue: 0,0:00:16.99,0:00:19.50,DefaultItalicsTop,SIGN & VO,0,0,0,,Chuyện đó tớ xem trên TV rồi.\NNghe bảo đã có người mất tích thật đấy.
Dialogue: 0,0:01:58.26,0:02:03.27,Signs_EpTitle,SIGN,0,0,0,,{\fad(525,523)\an9\blur2\fs18\pos(600.857,277.714)}Tập 6  {\fs24}Ký Ức
Dialogue: 0,0:02:00.56,0:02:04.23,FlashbackTop,AMAMIYA,0,0,0,,Cậu ấy không còn là Tatsuo-kun mà cậu từng biết nữa đâu.
Dialogue: 0,0:02:05.07,0:02:08.25,Flashback,AMAMIYA,0,0,0,,Ý thức hay ký ức của cậu ấy\Nhầu như chẳng còn sót lại chút nào.
Dialogue: 0,0:02:08.25,0:02:12.11,Flashback,AMAMIYA,0,0,0,,Khó mà trở lại làm con người trước kia được nữa.
Dialogue: 0,0:02:13.26,0:02:14.45,Default,HIRYU,0,0,0,,Tatsuo...
Dialogue: 0,0:02:16.49,0:02:17.38,Default,AGEHA,0,0,0,,Hiryu.
Dialogue: 0,0:02:18.12,0:02:20.05,Default,AGEHA,0,0,0,,Lại đây bàn bạc cùng tụi này đi.
Dialogue: 0,0:02:21.83,0:02:23.84,Default,AGEHA,0,0,0,,Cướp mặt nạ của Tatsuo sao?
Dialogue: 0,0:02:24.74,0:02:29.38,Default,OBORO,0,0,0,,Trong đó có gắn một loại sáo khiến\Ncon giun khổng lồ kia rất khó chịu.
Dialogue: 0,0:02:29.68,0:02:33.65,Default,OBORO,0,0,0,,Nếu lấy được chiếc mặt nạ ấy,\Ntụi mình có thể tiến tới cánh cổng.
Dialogue: 0,0:02:33.65,0:02:37.85,Default,OBORO,0,0,0,,Chẳng phải tụi mình nên hành động\Ntrước khi bị tấn công lần nữa sao?
Dialogue: 0,0:02:37.85,0:02:41.04,Default,AGEHA,0,0,0,,Thà thế còn hơn ngồi yên chịu trận ở đây.
Dialogue: 0,0:02:41.04,0:02:43.85,Default,AMAMIYA,0,0,0,,Nhưng làm thế nào để lấy được mặt nạ của cậu ta đây?
Dialogue: 0,0:02:44.10,0:02:47.79,Default,AMAMIYA,0,0,0,,Ngay từ đầu chúng ta còn chẳng nhúc nhích được\Nvì con giun kia cơ mà.
Dialogue: 0,0:02:48.15,0:02:51.25,Default,OBORO,0,0,0,,Cần phải có người thu hút\Nsự chú ý của con giun đó.
Dialogue: 0,0:02:51.25,0:02:53.86,Default,OBORO,0,0,0,,Những người còn lại sẽ đi cướp mặt nạ.
Dialogue: 0,0:02:54.14,0:02:58.83,Default,HIRYU,0,0,0,,Vậy tôi sẽ đi chỗ Tatsuo.\NĐừng hòng ai ngăn cản tôi.
Dialogue: 0,0:02:58.83,0:03:00.09,Default,AMAMIYA,0,0,0,,Asaga-kun...
Dialogue: 0,0:03:00.60,0:03:04.11,Default,HIRYU,0,0,0,,Tôi sẽ làm tròn phần việc của mình.\NĐây là chuyện tôi nhất định phải làm.
Dialogue: 0,0:03:04.11,0:03:05.21,Default,AMAMIYA,0,0,0,,Nhưng mà—
Dialogue: 0,0:03:04.39,0:03:05.75,DefaultOverlap,AGEHA,0,0,0,,Được rồi.
Dialogue: 0,0:03:05.75,0:03:07.75,Default,AGEHA,0,0,0,,Tao đi cùng mày, Hiryu.
Dialogue: 0,0:03:07.75,0:03:10.46,Default,AGEHA,0,0,0,,Thế thì chẳng còn gì phải lo nữa nhé.\NĐúng không, Amamiya?
Dialogue: 0,0:03:11.46,0:03:13.81,Default,AGEHA,0,0,0,,Á, đau, đau, đau!
Dialogue: 0,0:03:11.86,0:03:14.11,DefaultOverlap,AMAMIYA,0,0,0,,Như vậy càng làm tớ lo hơn đấy.
Dialogue: 0,0:03:14.11,0:03:15.25,Default,AGEHA,0,0,0,,Tại sao chứ?!
Dialogue: 0,0:03:15.25,0:03:17.98,Default,AGEHA,0,0,0,,Tớ quyết định xong xuôi hết rồi.\NTớ và Hiryu sẽ đi.
Dialogue: 0,0:03:17.98,0:03:19.47,Default,AMAMIYA,0,0,0,,Đừng có ăn nói hồ đồ.
Dialogue: 0,0:03:19.47,0:03:21.47,Default,AGEHA,0,0,0,,Cậu mới là người vô lý ấy!
Dialogue: 0,0:03:21.47,0:03:24.14,Default,AGEHA,0,0,0,,Cậu định lao vào chỗ chết\Nkhi bảo vệ bọn tớ đấy à?
Dialogue: 0,0:03:26.38,0:03:29.09,Default,AGEHA,0,0,0,,Cậu cứ cố tỏ ra mạnh mẽ bao nhiêu cũng được,
Dialogue: 0,0:03:29.09,0:03:32.37,Default,AGEHA,0,0,0,,nhưng đến thằng ngốc nhìn vào\Ncũng thấy tình trạng của cậu bây giờ ra sao.
Dialogue: 0,0:03:33.17,0:03:37.07,Default,AGEHA,0,0,0,,Cậu nghĩ tớ sẽ trơ mắt nhìn cậu giao đấu với hắn\Nđể bảo vệ bọn tớ lần nữa sao? Đừng hòng.
Dialogue: 0,0:03:37.44,0:03:39.59,Default,AMAMIYA,0,0,0,,Nhưng cậu ta rất nguy hiểm.
Dialogue: 0,0:03:39.59,0:03:42.53,Default,AMAMIYA,0,0,0,,Nếu hai cậu đánh với cậu ta,\Nchính mạng sống của hai cậu sẽ gặp nguy đấy!
Dialogue: 0,0:03:42.53,0:03:45.07,DefaultItalics,AGEHA/ID,0,0,0,,Mình đời nào để cậu ấy đi mạo hiểm được.
Dialogue: 0,0:03:45.64,0:03:52.34,DefaultItalics,AGEHA/ID,0,0,0,,Mình sẽ không bao giờ ngồi yên tự nhủ mọi chuyện rồi sẽ ổn\Ntrong khi để mặc Amamiya chiến đấu một mình nữa.
Dialogue: 0,0:03:52.77,0:03:56.59,Default,AGEHA,0,0,0,,Đánh đấm là sở trường của tụi tớ mà. Giao cho tụi tớ đi.
Dialogue: 0,0:03:58.57,0:04:00.86,Default,AMAMIYA,0,0,0,,Tùy cậu muốn làm gì thì làm.
Dialogue: 0,0:04:00.86,0:04:03.51,Default,AGEHA,0,0,0,,Vậy thì tớ không khách sáo đâu đấy!
Dialogue: 0,0:04:05.71,0:04:07.38,Default,OBORO,0,0,0,,Thật là mất mặt hết sức.
Dialogue: 0,0:04:07.38,0:04:11.21,Default,KABUTO,0,0,0,,Con nhỏ đó đúng là điên rồi\Nmới đòi đi bảo vệ gã kia.
Dialogue: 0,0:04:13.24,0:04:14.44,Default,OBORO,0,0,0,,Khoan đã!
Dialogue: 0,0:04:14.44,0:04:16.66,Default,OBORO,0,0,0,,Tại sao tôi lại phải ngồi chờ ở đây chứ?
Dialogue: 0,0:04:16.66,0:04:18.45,Default,OBORO,0,0,0,,Tôi cũng muốn làm gì đó góp sức mà!
Dialogue: 0,0:04:18.45,0:04:20.45,Default,AGEHA,0,0,0,,Cậu {\i1}có{\i0} làm được cái quái gì đâu chứ.
Dialogue: 0,0:04:20.45,0:04:23.14,Default,OBORO,0,0,0,,Nhưng mà chán chết đi được!
Dialogue: 0,0:04:23.14,0:04:24.27,Default,AGEHA,0,0,0,,Cậu là trẻ con đấy à?
Dialogue: 0,0:04:24.27,0:04:28.06,Default,HIRYU,0,0,0,,Cậu có nhiệm vụ trọng đại\Nlà bảo vệ người bị thương đấy.
Dialogue: 0,0:04:28.06,0:04:29.99,Default,AGEHA,0,0,0,,Trông chừng Kirisaki cẩn thận nhé.
Dialogue: 0,0:04:34.90,0:04:38.37,Default,AMAMIYA,0,0,0,,Hai cậu đừng quên lời tớ dặn đấy.
Dialogue: 0,0:04:38.37,0:04:40.93,Default,AGEHA,0,0,0,,Trông cậy cả vào cậu đấy, Amamiya.
Dialogue: 0,0:04:40.93,0:04:46.81,Default,AGEHA,0,0,0,,Tụi tớ không thể vừa thu hút sự chú ý\Ncủa con quái đó vừa né đòn được.
Dialogue: 0,0:04:47.47,0:04:48.47,Default,AMAMIYA,0,0,0,,Tớ biết rồi.
Dialogue: 0,0:04:49.95,0:04:53.73,Default,AMAMIYA,0,0,0,,Nếu hai cậu mà bỏ mạng ở đó,\Ntớ sẽ không bao giờ tha thứ đâu.
Dialogue: 0,0:04:56.82,0:04:59.07,Default,AGEHA,0,0,0,,Nghe câu đó mát lòng mát dạ thật đấy.
Dialogue: 0,0:05:00.21,0:05:02.29,Default,HIRYU,0,0,0,,Rồi, kế hoạch là gì đây?
Dialogue: 0,0:05:02.29,0:05:04.65,Default,AGEHA,0,0,0,,Tao sẽ xông thẳng vào đối đầu trực diện.
Dialogue: 0,0:05:05.27,0:05:08.99,Default,AGEHA,0,0,0,,Mày vòng ra sau rồi khống chế cậu ta lại.
Dialogue: 0,0:05:08.99,0:05:11.33,Default,HIRYU,0,0,0,,Nói thật đấy à? Kế hoạch quái gì thế hả?
Dialogue: 0,0:05:11.33,0:05:13.54,Default,AGEHA,0,0,0,,Nhớ những gì Amamiya đã nói không.
Dialogue: 0,0:05:14.28,0:05:19.94,Flashback,AMAMIYA,0,0,0,,Tatsuo-kun đang dùng Rise để bù đắp cho\Nsự thiếu linh hoạt của cơ thể khiếm khuyết.
Dialogue: 0,0:05:19.94,0:05:21.80,Flashback,AMAMIYA,0,0,0,,Trong cận chiến,
Dialogue: 0,0:05:21.80,0:05:27.06,Flashback,AMAMIYA,0,0,0,,cậu ta sẽ phải tụ năng lượng Burst\Ntrong khi vẫn duy trì Rise ở mức tối đa.
Dialogue: 0,0:05:28.76,0:05:30.49,Flashback,AMAMIYA,0,0,0,,Khoảnh khắc đó sẽ tạo ra sơ hở.
Dialogue: 0,0:05:31.23,0:05:33.90,Default,AGEHA,0,0,0,,Burst của tao không ổn định chút nào.
Dialogue: 0,0:05:33.90,0:05:40.37,Default,AGEHA,0,0,0,,Chỉ có mày mới khống chế được cậu ta\Nmột khi cậu ta dùng cạn PSI.
Dialogue: 0,0:05:40.37,0:05:43.09,Default,HIRYU,0,0,0,,Mày có biết chuyện đó sẽ nguy hiểm\Ncho mày tới mức nào không hả?
Dialogue: 0,0:05:43.99,0:05:47.37,Default,AGEHA,0,0,0,,Mày muốn cứu Tatsuo đúng không?
Dialogue: 0,0:05:47.83,0:05:52.53,Default,AGEHA,0,0,0,,Amamiya bảo là bất khả thi,\Nnhưng mày vẫn chưa từ bỏ hy vọng.
Dialogue: 0,0:05:53.02,0:05:55.91,Default,AGEHA,0,0,0,,Mày muốn gọi cậu ta tỉnh lại\Nrồi cùng nhau trở về nhà, đúng chứ?
Dialogue: 0,0:05:55.92,0:05:59.76,Default,AGEHA,0,0,0,,Vậy nên tao sẽ dốc hết sức mình để giúp mày.
Dialogue: 0,0:06:00.84,0:06:02.30,Default,HIRYU,0,0,0,,Yoshina...
Dialogue: 0,0:06:05.14,0:06:06.49,Default,AGEHA,0,0,0,,Lên thôi!
Dialogue: 0,0:06:10.17,0:06:11.52,Default,AMAMIYA,0,0,0,,Lại đây nào.
Dialogue: 0,0:06:12.45,0:06:15.28,Default,AMAMIYA,0,0,0,,Đến giờ đi dạo rồi, nhóc giun ơi.
Dialogue: 0,0:06:16.55,0:06:17.80,Default,OBORO,0,0,0,,Họ bắt đầu rồi kìa.
Dialogue: 0,0:06:21.40,0:06:23.79,Default,AMAMIYA,0,0,0,,Ngoan lắm. Lối này cơ mà.
Dialogue: 0,0:06:28.86,0:06:30.97,DefaultItalics,AGEHA/ID,0,0,0,,Cảm giác hưng phấn thật đấy.
Dialogue: 0,0:06:31.70,0:06:36.42,Default,AGEHA,0,0,0,,Đừng có bơm căng cái thứ đó nữa\Nmà bước xuống đây đi!
Dialogue: 0,0:06:36.42,0:06:39.17,Default,AGEHA,0,0,0,,Ra tiếp chiêu với tao chút coi!
Dialogue: 0,0:06:40.21,0:06:43.77,DefaultItalics,AGEHA/ID,0,0,0,,Ăn một đòn thôi là tắt thở ngay.
Dialogue: 0,0:06:43.77,0:06:46.89,DefaultItalics,AGEHA/ID,0,0,0,,Lấy hết can đảm lên nào, Yoshina Ageha!
Dialogue: 0,0:06:46.89,0:06:48.96,Default,AGEHA,0,0,0,,Xông vào đi, Tatsuo!
Dialogue: 0,0:06:50.13,0:06:51.39,Default,KABUTO,0,0,0,,Này, khoan đã.
Dialogue: 0,0:06:51.76,0:06:53.27,Default,KABUTO,0,0,0,,Cậu đi đâu thế?
Dialogue: 0,0:06:53.55,0:06:55.70,Default,OBORO,0,0,0,,Tất nhiên là tới chỗ mấy người kia rồi.
Dialogue: 0,0:06:55.70,0:06:59.44,Default,OBORO,0,0,0,,Vớ vẩn thật sự. Tôi không thể cứ ngồi yên nhìn\Ntrong khi bọn họ đang chiến đấu được.
Dialogue: 0,0:06:59.44,0:07:04.85,Default,OBORO,0,0,0,,Tôi chắc chắn không phải cay cú\Nvì lòng tự trọng bị tổn thương đâu nhé.
Dialogue: 0,0:07:04.85,0:07:07.15,Default,OBORO,0,0,0,,Đó là tiếng gọi từ tận sâu thẳm tâm hồn tôi.
Dialogue: 0,0:07:07.15,0:07:07.95,Default,KABUTO,0,0,0,,Gì cơ?
Dialogue: 0,0:07:07.95,0:07:12.17,Default,OBORO,0,0,0,,Tôi đơn giản là không thể khoanh tay đứng nhìn\Nkhi hiểm nguy đang ở ngay trước mắt.
Dialogue: 0,0:07:12.70,0:07:16.35,Default,OBORO,0,0,0,,Sự tò mò vô tận chính là bản sắc của tôi.
Dialogue: 0,0:07:16.35,0:07:20.09,Default,OBORO,0,0,0,,Thời khắc đã điểm\Nđể chứng minh rằng tôi đang thực sự sống.
Dialogue: 0,0:07:20.09,0:07:21.75,Default,OBORO,0,0,0,,Đó chính là định mệnh của tôi!
Dialogue: 0,0:07:22.47,0:07:25.42,DefaultItalics,KABUTO/ID,0,0,0,,Ôi vãi. Thằng cha này bị ngáo rồi.
Dialogue: 0,0:07:25.97,0:07:28.10,DefaultItalics,KABUTO/ID,0,0,0,,Thôi, mình cũng chẳng cản nổi hắn đâu.
Dialogue: 0,0:07:28.88,0:07:30.80,DefaultItalics,KABUTO/ID,0,0,0,,Chúc mấy người may mắn nhé.
Dialogue: 0,0:07:31.83,0:07:34.71,DefaultItalics,OBORO/ID,0,0,0,,Sao mình lại thấy phấn khích thế này nhỉ?
Dialogue: 0,0:07:34.71,0:07:37.21,DefaultItalics,OBORO/ID,0,0,0,,Có một nguồn sức mạnh đang dâng trào\Ntừ sâu thẳm trong não bộ mình.
Dialogue: 0,0:07:37.21,0:07:39.15,DefaultItalics,OBORO/ID,0,0,0,,Cảm giác như thể mình sắp hóa thành thần thánh vậy.
Dialogue: 0,0:07:39.93,0:07:43.72,DefaultItalics,OBORO/ID,0,0,0,,Giờ thì tiến lên đi, Oboro, và đặt chân\Nvào thế giới mới đầy dũng cảm này!
Dialogue: 0,0:07:45.47,0:07:47.70,DefaultItalics,HIRYU/ID,0,0,0,,Em còn nhớ không, Tatsuo?
Dialogue: 0,0:07:48.05,0:07:51.20,DefaultItalics,HIRYU/ID,0,0,0,,Hồi mà em vẫn chưa biết đi xe đạp ấy.
Dialogue: 0,0:07:51.56,0:07:56.22,Flashback,YOUNG TATSUO,0,0,0,,Chắc trên đời này chỉ có mình em bảy tuổi rồi\Nmà gắn bánh phụ vẫn không chạy nổi xe đạp mất.
Dialogue: 0,0:07:56.22,0:07:57.79,Flashback,YOUNG TATSUO,0,0,0,,Em muốn chết quách đi cho rồi.
Dialogue: 0,0:07:57.79,0:07:59.38,Flashback,YOUNG HIRYU,0,0,0,,Đừng có ủ rũ thế chứ.
Dialogue: 0,0:07:59.38,0:08:01.29,Flashback,YOUNG HIRYU,0,0,0,,Chẳng phải em bảo muốn trở thành anh hùng sao.
Dialogue: 0,0:08:01.61,0:08:03.98,Flashback,YOUNG TATSUO,0,0,0,,Chuyện đó chỉ là mơ hão thôi.
Dialogue: 0,0:08:03.98,0:08:05.55,Flashback,YOUNG HIRYU,0,0,0,,Thế thì chúng ta làm thế này đi.
Dialogue: 0,0:08:05.88,0:08:09.65,Flashback,YOUNG HIRYU,0,0,0,,Nếu em không chạy được, anh sẽ chạy thay em.
Dialogue: 0,0:08:09.65,0:08:11.82,Flashback,YOUNG HIRYU,0,0,0,,Anh cũng sẽ chiến đấu thay cho em nữa.
Dialogue: 0,0:08:11.82,0:08:14.72,Flashback,YOUNG HIRYU,0,0,0,,Còn em sẽ yểm trợ cho anh.
Dialogue: 0,0:08:14.72,0:08:17.55,Flashback,YOUNG HIRYU,0,0,0,,Em sẽ làm bộ não,\Ncòn anh sẽ làm cơ thể.
Dialogue: 0,0:08:17.55,0:08:19.48,Flashback,YOUNG HIRYU,0,0,0,,Hợp lại với nhau, chúng ta sẽ là một thể thống nhất.
Dialogue: 0,0:08:19.74,0:08:21.80,Flashback,YOUNG HIRYU,0,0,0,,Chúng ta là Đội Song Long Kỳ Tích (Miracle Dragon)!
Dialogue: 0,0:08:21.80,0:08:23.82,Flashback,YOUNG TATSUO,0,0,0,,Song Long Kỳ Tích ư?
Dialogue: 0,0:08:23.82,0:08:26.42,Flashback,YOUNG HIRYU,0,0,0,,Chúng ta là con rồng\Nkhông gì có thể chia lìa.
Dialogue: 0,0:08:26.42,0:08:29.63,Flashback,YOUNG HIRYU,0,0,0,,Chỉ cần ở bên nhau,\Nem cũng có thể trở thành anh hùng.
Dialogue: 0,0:08:30.36,0:08:32.07,DefaultItalics,HIRYU/ID,0,0,0,,Song Long Kỳ Tích...
Dialogue: 0,0:08:32.38,0:08:36.95,DefaultItalics,HIRYU/ID,0,0,0,,Đến trò quay vòng trên xà đơn mình còn làm chẳng xong,\Nvậy mà vẫn cứ cố ra vẻ.
Dialogue: 0,0:08:37.30,0:08:41.67,Flashback,YOUNG TATSUO,0,0,0,,Anh Hiryu ơi, chuyển nhà đi rồi\Nđừng có quên em nhé.
Dialogue: 0,0:08:42.56,0:08:45.21,Flashback,YOUNG HIRYU,0,0,0,,Đây chính là Song Long Kỳ Tích.
Dialogue: 0,0:08:45.62,0:08:47.71,Flashback,YOUNG TATSUO,0,0,0,,Chúng ta nhất định sẽ gặp lại nhau đúng không anh?
Dialogue: 0,0:08:48.47,0:08:49.22,Flashback,YOUNG HIRYU,0,0,0,,Ừ.
Dialogue: 0,0:08:50.21,0:08:52.64,DefaultItalics,HIRYU/ID,0,0,0,,Từ dạo đó đến nay anh luôn nỗ lực\Nđể thay đổi bản thân
Dialogue: 0,0:08:53.10,0:08:56.77,DefaultItalics,HIRYU/ID,0,0,0,,để có thể ngẩng cao đầu tự hào\Nkhi chúng ta gặp lại nhau.
Dialogue: 0,0:08:57.40,0:08:59.70,DefaultItalics,HIRYU/ID,0,0,0,,Để anh có thể cùng em trở thành anh hùng.
Dialogue: 0,0:09:02.52,0:09:04.86,DefaultItalics,AGEHA/ID,0,0,0,,Rise giúp cậu ta di chuyển nhanh đến điên cuồng.
Dialogue: 0,0:09:06.53,0:09:10.86,Default,AGEHA,0,0,0,,Có nhanh hơn thật đấy,\Nnhưng động tác vẫn còn thô lắm.
Dialogue: 0,0:09:10.86,0:09:12.70,Default,AGEHA,0,0,0,,Cậu chưa quen đánh đấm nhỉ.
Dialogue: 0,0:09:12.70,0:09:15.20,Default,AGEHA,0,0,0,,Phải thu gọn thân người lại hơn nữa.
Dialogue: 0,0:09:17.68,0:09:20.62,DefaultItalics,AGEHA/ID,0,0,0,,Chết cha. Mình hăng máu quá đà rồi.
Dialogue: 0,0:09:20.62,0:09:21.92,Flashback,AMAMIYA,0,0,0,,Đừng quên.
Dialogue: 0,0:09:22.18,0:09:24.80,Flashback,AMAMIYA,0,0,0,,Phải đặt việc né tránh lên hàng đầu.
Dialogue: 0,0:09:24.80,0:09:27.20,Flashback,AMAMIYA,0,0,0,,Đòn đánh thường không có tác dụng với cậu ta đâu.
Dialogue: 0,0:09:27.63,0:09:29.76,FlashbackItalics,AMAMIYA,0,0,0,,Chỉ cần để cậu ta tóm được một lần thôi...
Dialogue: 0,0:09:36.20,0:09:39.16,Default,AGEHA,0,0,0,,Người ta bảo anh hùng lúc nào cũng xuất hiện vào phút chót mà!
Dialogue: 0,0:09:44.44,0:09:45.90,Default,HIRYU,0,0,0,,Đây mới là chiến thuật thật sự của tụi này!
Dialogue: 0,0:09:45.90,0:09:47.40,Default,HIRYU,0,0,0,,Long Vĩ Kích (Dragon Tail)!
Dialogue: 0,0:09:51.12,0:09:56.11,Default,HIRYU,0,0,0,,Tatsuo, anh vẫn chưa thể ngẩng cao đầu ngay được,\Nnhưng đây chính là sức mạnh của anh!
Dialogue: 0,0:09:58.20,0:09:59.76,Default,AGEHA,0,0,0,,Cẩn thận đấy, Hiryu!
Dialogue: 0,0:10:07.33,0:10:11.76,DefaultItalics,HIRYU/ID,0,0,0,,Dù có vỡ nát hộp sọ, mình cũng quyết không buông tay!
Dialogue: 0,0:10:11.76,0:10:16.01,Default,HIRYU,0,0,0,,Anh không đời nào để em nói đã quên anh đâu,\NTatsuo! Là anh, Hiryu đây!
Dialogue: 0,0:10:16.01,0:10:19.52,Default,HIRYU,0,0,0,,Bạn thuở nhỏ của em, Asaga Hiryu đây!
Dialogue: 0,0:10:20.72,0:10:22.44,Default,HIRYU,0,0,0,,Anh đã đi tìm em suốt đấy!
Dialogue: 0,0:10:22.44,0:10:24.81,Default,HIRYU,0,0,0,,Anh sẽ đưa em về nhà!
Dialogue: 0,0:10:24.81,0:10:26.81,Default,HIRYU,0,0,0,,Nhìn thẳng vào mắt anh đi!
Dialogue: 0,0:10:27.18,0:10:30.48,Default,HIRYU,0,0,0,,Tỉnh lại đi, Tatsuo!
Dialogue: 0,0:10:35.50,0:10:36.63,Default,TATSUO,0,0,0,,Hiryu.
Dialogue: 0,0:10:47.20,0:10:48.37,DefaultItalics,HIRYU/ID,0,0,0,,Tatsuo.
Dialogue: 0,0:10:51.75,0:10:53.55,Default,HIRYU,0,0,0,,Em đã tỉnh lại rồi sao, Tatsuo?
Dialogue: 0,0:10:54.07,0:10:56.55,Default,TATSUO,0,0,0,,Anh Hiryu.
Dialogue: 0,0:10:56.82,0:11:00.42,Default,HIRYU,0,0,0,,Em lấy lại được ý thức rồi.
Dialogue: 0,0:11:00.42,0:11:05.51,Default,TATUO,0,0,0,,Trận đấu thế nào rồi ạ?\NAnh đánh cú grand slam luôn đúng không?
Dialogue: 0,0:11:05.92,0:11:08.12,Default,HIRYU,0,0,0,,Em đang nói gì thế?
Dialogue: 0,0:11:08.12,0:11:13.53,Default,TATSUO,0,0,0,,Chúng ta đã hứa sẽ đi chơi cùng nhau\Nmột khi em biết đi xe đạp cơ mà.
Dialogue: 0,0:11:13.53,0:11:15.40,Default,HIRYU,0,0,0,,Ký ức của em ấy...
Dialogue: 0,0:11:16.55,0:11:17.49,Default,HIRYU,0,0,0,,Tatsuo!
Dialogue: 0,0:11:18.87,0:11:21.99,Default,TATSUO,0,0,0,,Em là ai thế? Đây là đâu?
Dialogue: 0,0:11:21.99,0:11:24.75,Default,TATSUO,0,0,0,,Anh Hiryu ơi, em là ai vậy?
Dialogue: 0,0:11:26.67,0:11:29.13,Default,AGEHA,0,0,0,,Có gì đó không ổn!\NMau tránh xa cậu ta ra, Hiryu!
Dialogue: 0,0:11:29.13,0:11:32.02,Default,HIRYU,0,0,0,,Anh ở ngay đây! Anh sẽ không đi đâu hết!
Dialogue: 0,0:11:32.02,0:11:34.26,Default,HIRYU,0,0,0,,Đừng gục ngã trước bản thân chứ!
Dialogue: 0,0:11:34.26,0:11:37.82,Default,HIRYU,0,0,0,,Không sao đâu. Em rồi sẽ khỏe lại thôi.
Dialogue: 0,0:11:37.82,0:11:40.64,Default,HIRYU,0,0,0,,Ý chí của em vẫn chưa gục ngã mà.
Dialogue: 0,0:11:40.95,0:11:43.02,Default,HIRYU,0,0,0,,Chúng ta đã hẹn cùng nhau\Ntrở thành anh hùng cơ mà, đúng không?
Dialogue: 0,0:11:43.02,0:11:46.33,Default,HIRYU,0,0,0,,Anh là cơ thể,\Ncòn em là bộ não đấy, Tatsuo!
Dialogue: 0,0:11:46.33,0:11:47.81,Default,HIRYU,0,0,0,,Tìm lại chính mình đi!
Dialogue: 0,0:11:48.23,0:11:51.06,Default,HIRYU,0,0,0,,Cả hai chúng ta mới tạo nên một con rồng hoàn chỉnh!
Dialogue: 0,0:11:51.59,0:11:55.77,Default,HIRYU,0,0,0,,Em nhớ chiếc mặt dây chuyền đó không? Anh vẫn còn—
Dialogue: 0,0:11:59.46,0:12:02.58,Default,HIRYU,0,0,0,,Cùng... về nhà thôi... Tatsuo...
Dialogue: 0,0:12:12.04,0:12:14.33,Default,AGEHA,0,0,0,,Hiryu!
Dialogue: 0,0:12:44.38,0:12:46.12,Default,AGEHA,0,0,0,,Tránh xa Hiryu ra.
Dialogue: 0,0:12:46.67,0:12:49.20,Default,AGEHA,0,0,0,,Dám cản đường tao thì tao nghiền nát mày luôn đấy!
Dialogue: 0,0:12:50.72,0:12:51.79,Default,AMAMIYA,0,0,0,,Cảm giác này là...
Dialogue: 0,0:12:52.06,0:12:55.29,DefaultItalics,AMAMIYA/ID,0,0,0,,Yoshina ư? Năng lực PSI của cậu ấy mạnh kinh khủng.
Dialogue: 0,0:12:56.46,0:12:59.76,DefaultItalics,AMAMIYA/ID,0,0,0,,Nó không hề tấn công mình. Mà nó đang run sợ.
Dialogue: 0,0:13:00.42,0:13:01.79,DefaultItalics,AMAMIYA/ID,0,0,0,,Giờ mình đã có thể cử động tự do.
Dialogue: 0,0:13:02.97,0:13:04.86,DefaultItalics,AMAMIYA/ID,0,0,0,,Mình có linh cảm cực kỳ chẳng lành về chuyện này.
Dialogue: 0,0:13:11.85,0:13:16.47,Default,AGEHA,0,0,0,,Mày rút lui à? Hóa ra vẫn biết sợ cơ đấy.
Dialogue: 0,0:13:16.47,0:13:19.03,Default,AMAMIYA,0,0,0,,Yoshina, dừng lại đi! Não cậu sẽ nổ tung mất!
Dialogue: 0,0:13:19.03,0:13:21.46,Default,AGEHA,0,0,0,,Chuyện đó không quan trọng!
Dialogue: 0,0:13:21.46,0:13:23.24,Default,AGEHA,0,0,0,,Cậu mau lo cho Hiryu đi.
Dialogue: 0,0:13:23.50,0:13:24.39,Default,AMAMIYA,0,0,0,,Hả?
Dialogue: 0,0:13:25.73,0:13:26.98,Default,AMAMIYA,0,0,0,,Asaga-kun.
Dialogue: 0,0:13:27.63,0:13:29.97,Default,AMAMIYA,0,0,0,,Asaga-kun! Asaga-kun!
Dialogue: 0,0:13:29.97,0:13:32.02,Default,AGEHA,0,0,0,,Hắn vẫn chưa chết đâu.
Dialogue: 0,0:13:32.02,0:13:34.52,Default,AGEHA,0,0,0,,Chỗ này cứ để tớ lo!
Dialogue: 0,0:13:34.52,0:13:35.04,Default,AMAMIYA,0,0,0,,Nhưng—
Dialogue: 0,0:13:35.04,0:13:39.38,Default,AGEHA,0,0,0,,Mau đi đi! Tên đó vừa nạp đạn xong đấy.
Dialogue: 0,0:13:39.82,0:13:45.27,Default,AGEHA,0,0,0,,Thằng khốn đó nãy giờ giấu bài để lừa tụi mình.
Dialogue: 0,0:13:45.85,0:13:46.81,Default,AGEHA,0,0,0,,Amamiya!
Dialogue: 0,0:13:51.56,0:13:54.93,DefaultItalics,AMAMIYA/ID,0,0,0,,Không thể tin được. Cậu ấy xóa sổ viên đạn Burst luôn rồi.
Dialogue: 0,0:13:54.93,0:13:57.19,DefaultItalics,AMAMIYA/ID,0,0,0,,Không, là nuốt chửng nó mới đúng.
Dialogue: 0,0:13:58.98,0:14:00.55,Default,AMAMIYA,0,0,0,,Yoshina!
Dialogue: 0,0:14:00.55,0:14:04.06,DefaultItalics,AMAMIYA/ID,0,0,0,,Quả cầu đen đó chính là Burst của Yoshina.
Dialogue: 0,0:14:04.06,0:14:07.83,DefaultItalics,AMAMIYA/ID,0,0,0,,Nó nuốt chửng mọi thứ mà nó chạm vào.
Dialogue: 0,0:14:08.53,0:14:11.34,Default,AGEHA,0,0,0,,Amamiya, chạy khỏi đây mau lên!
Dialogue: 0,0:14:11.34,0:14:13.41,Default,AGEHA,0,0,0,,Tớ không điều khiển nổi nó nữa rồi.
Dialogue: 0,0:14:13.41,0:14:16.67,Default,AGEHA,0,0,0,,Nó cứ mạnh lên không ngừng,\Nvà chẳng chịu đứng yên một chỗ.
Dialogue: 0,0:14:17.24,0:14:19.55,Default,AGEHA,0,0,0,,Cậu mà ở lại thì nó sẽ nuốt chửng cả cậu đấy!
Dialogue: 0,0:14:22.13,0:14:24.36,Default,AGEHA,0,0,0,,Chạy đi, Amamiya!
Dialogue: 0,0:14:34.48,0:14:36.02,DefaultItalics,AMAMIYA/ID,0,0,0,,Nhìn sức mạnh của nó kìa.
Dialogue: 0,0:14:36.02,0:14:39.94,DefaultItalics,AMAMIYA/ID,0,0,0,,Nếu mình còn ở lại, chắc chắn đã tan xác\Nkhông còn một mảnh dấu vết nào.
Dialogue: 0,0:14:40.44,0:14:45.32,DefaultItalics,AMAMIYA/ID,0,0,0,,Nhưng tại sao nó lại bảo vệ mình\Nnếu Yoshina không thể kiểm soát nó?
Dialogue: 0,0:14:46.01,0:14:48.33,DefaultItalics,AMAMIYA/ID,0,0,0,,Lẽ nào nó phản ứng với PSI sao?
Dialogue: 0,0:15:16.56,0:15:17.70,Default,AMAMIYA,0,0,0,,Yoshina.
Dialogue: 0,0:15:18.30,0:15:19.74,Default,AMAMIYA,0,0,0,,Yoshina!
Dialogue: 0,0:15:24.96,0:15:26.95,Default,OBORO,0,0,0,,Xem ra tôi tới hơi trễ một chút rồi nhỉ.
Dialogue: 0,0:15:27.32,0:15:30.82,Default,OBORO,0,0,0,,Cậu đúng là luôn mang tới hết bất ngờ này tới bất ngờ khác.
Dialogue: 0,0:15:30.82,0:15:34.22,Default,OBORO,0,0,0,,Sức mạnh của cậu đúng là hiện thân của sự hủy diệt.
Dialogue: 0,0:15:34.22,0:15:37.13,Default,OBORO,0,0,0,,Lặn lội tới tận đây,\Nmà rốt cuộc chẳng còn việc gì để tôi thể hiện cả.
Dialogue: 0,0:15:37.13,0:15:40.02,Default,OBORO,0,0,0,,Không sao. Vào cơ hội tiếp theo,
Dialogue: 0,0:15:40.02,0:15:45.26,Default,OBORO,0,0,0,,tôi sẽ phô diễn thứ sức mạnh tuyệt diệu\Nđang sục sôi bên trong mình.
Dialogue: 0,0:15:45.53,0:15:48.24,Default,OBORO,0,0,0,,PSI hả? Mới nghĩ tới thôi đã thấy rạo rực rồi.
Dialogue: 0,0:15:49.28,0:15:50.72,Default,OBORO,0,0,0,,Này, có chuyện gì thế?
Dialogue: 0,0:15:51.19,0:15:52.26,Default,OBORO,0,0,0,,Yoshina-kun?
Dialogue: 0,0:15:52.64,0:15:53.77,Default,AMAMIYA,0,0,0,,Yoshina!
Dialogue: 0,0:15:53.77,0:15:56.62,Default,OBORO,0,0,0,,Khoan đã... Cậu sắp chết sao?
Dialogue: 0,0:15:56.62,0:15:58.60,Default,OBORO,0,0,0,,Cậu định chết ngay tại đây à?
Dialogue: 0,0:15:58.90,0:16:00.61,Default,OBORO,0,0,0,,Không được! Như thế bất công quá!
Dialogue: 0,0:16:00.61,0:16:04.23,Default,OBORO,0,0,0,,Chúng ta mới quen nhau chưa được bao lâu! Sao cậu lại phải chết chứ?
Dialogue: 0,0:16:04.23,0:16:06.29,Default,OBORO,0,0,0,,Tôi không cho phép chuyện đó xảy ra.
Dialogue: 0,0:16:06.29,0:16:10.13,Default,OBORO,0,0,0,,Cuộc đời của Mochizuki Oboro này\Nvừa mới bắt đầu trở nên thú vị thôi mà.
Dialogue: 0,0:16:10.71,0:16:13.70,Default,OBORO,0,0,0,,Không thể để thiếu mất dù chỉ một mảnh ghép được.
Dialogue: 0,0:16:14.62,0:16:17.33,Default,OBORO,0,0,0,,Cậu mà chết thì còn gì thú vị nữa!
Dialogue: 0,0:16:19.42,0:16:26.06,Default,OBORO,0,0,0,,Tôi đã cảm nhận được cậu là mảnh ghép then chốt\Nkhiến bức tranh cuộc đời tôi trở nên hấp dẫn.
Dialogue: 0,0:16:26.06,0:16:28.59,Default,OBORO,0,0,0,,Cậu bắt buộc phải sống, vì tôi muốn thế!
Dialogue: 0,0:16:29.14,0:16:31.90,Default,AMAMIYA,0,0,0,,Đó là... Cure!
Dialogue: 0,0:16:35.17,0:16:37.35,Default,AGEHA,0,0,0,,Mình ngủ thiếp đi mất à?
Dialogue: 0,0:16:37.35,0:16:39.70,Default,AGEHA,0,0,0,,Đầu óc bỗng nhiên nhẹ bẫng hẳn.
Dialogue: 0,0:16:40.15,0:16:43.01,Default,OBORO,0,0,0,,Cậu suýt nữa thì mất mạng\Nvì não bộ bị tổn thương nặng đấy.
Dialogue: 0,0:16:43.73,0:16:46.62,Default,OBORO,0,0,0,,Mừng là cậu đã thấy khỏe lại rồi,\NYoshina-kun.
Dialogue: 0,0:16:48.83,0:16:51.16,Default,AGEHA,0,0,0,,Cậu vừa làm gì với tôi thế?!
Dialogue: 0,0:16:51.16,0:16:52.95,Default,OBORO,0,0,0,,Tôi đã chữa lành cho cậu đấy.
Dialogue: 0,0:16:52.95,0:16:56.61,Default,OBORO,0,0,0,,Xem ra điều này có nghĩa là\Nsức mạnh của tôi cũng đã thức tỉnh rồi.
Dialogue: 0,0:16:58.06,0:16:59.22,Default,AGEHA,0,0,0,,Đây là cái gì vậy?
Dialogue: 0,0:16:59.22,0:17:03.28,Default,AMAMIYA,0,0,0,,Cure — năng lực chia sẻ Rise của bản thân\Ncho người khác.
Dialogue: 0,0:17:04.07,0:17:06.64,Default,AMAMIYA,0,0,0,,Đó là một dạng PSI chỉ số ít\Nngười được chọn mới có thể sử dụng.
Dialogue: 0,0:17:07.55,0:17:10.38,Default,AMAMIYA,0,0,0,,May quá. Thật sự may quá rồi.
Dialogue: 0,0:17:10.38,0:17:12.55,Default,AMAMIYA,0,0,0,,Chẳng phải tớ đã dặn cậu không được chết rồi sao?
Dialogue: 0,0:17:12.55,0:17:15.68,Default,AGEHA,0,0,0,,Đừng khóc mà. Tớ đã trở về rồi đây thôi?
Dialogue: 0,0:17:15.68,0:17:17.72,Default,AGEHA,0,0,0,,Tớ không bao giờ nuốt lời đâu.
Dialogue: 0,0:17:17.72,0:17:19.62,Default,AMAMIYA,0,0,0,,Chuyện qua rồi thì nói sao chẳng dễ!
Dialogue: 0,0:17:19.62,0:17:20.89,Default,AGEHA,0,0,0,,Cậu chẳng hiểu gì cả, đồ ngốc.
Dialogue: 0,0:17:20.89,0:17:23.65,Default,AGEHA,0,0,0,,Đến cả định mệnh cũng đứng về phía tớ đấy.
Dialogue: 0,0:17:24.11,0:17:26.74,DefaultItalics,AMAMIYA/ID,0,0,0,,Mình ghét phải tranh cãi với Yoshina lắm.
Dialogue: 0,0:17:26.74,0:17:31.22,DefaultItalics,AMAMIYA/ID,0,0,0,,Cậu ta đầu óc đơn giản nên chẳng chịu hiểu\Nmấy thứ như cảm xúc gì cả.
Dialogue: 0,0:17:31.65,0:17:34.62,Default,OBORO,0,0,0,,Ageha-kun, tôi dừng chữa cho cậu ấy được chưa?
Dialogue: 0,0:17:34.62,0:17:36.95,Default,AGEHA,0,0,0,,Hả? Cậu ta khỏe hẳn rồi à?
Dialogue: 0,0:17:36.95,0:17:38.97,Default,OBORO,0,0,0,,Chưa đâu, nhưng tôi thấy chán rồi.
Dialogue: 0,0:17:38.97,0:17:39.93,Default,AMAMIYA,0,0,0,,Đừng có dừng lại!
Dialogue: 0,0:17:39.93,0:17:41.50,Default,AGEHA,0,0,0,,Sao cậu chóng chán nhanh thế hả?!
Dialogue: 0,0:17:41.50,0:17:44.58,Default,OBORO,0,0,0,,Nghĩ kỹ lại thì,\Ntôi cũng có quyền lựa chọn mà!
Dialogue: 0,0:17:44.58,0:17:48.40,Default,OBORO,0,0,0,,Tôi muốn ôm người mình thích\Nvào lúc mình muốn ôm cơ!
Dialogue: 0,0:17:48.40,0:17:50.25,Default,AGEHA,0,0,0,,Không có thời gian cho mấy trò vớ vẩn đâu!
Dialogue: 0,0:17:50.25,0:17:52.46,Default,AGEHA,0,0,0,,Nếu không mau lên, con giun kia—
Dialogue: 0,0:17:54.97,0:17:56.24,Default,AGEHA,0,0,0,,Chết tiệt!
Dialogue: 0,0:17:56.87,0:17:57.78,Default,AMAMIYA,0,0,0,,Được rồi.
Dialogue: 0,0:17:59.81,0:18:00.92,Default,AGEHA,0,0,0,,Ngươi!
Dialogue: 0,0:18:00.92,0:18:02.21,Default,AMAMIYA,0,0,0,,Tatsuo-kun!
Dialogue: 0,0:18:08.34,0:18:10.63,Default,TATSUO,0,0,0,,Đòn vừa rồi của cậu đau thấu trời luôn đấy.
Dialogue: 0,0:18:11.19,0:18:16.24,Default,TATSUO,0,0,0,,Tôi đã đánh mất sức mạnh, nhưng cũng nhờ vậy\Nmà tôi lấy lại được lý trí.
Dialogue: 0,0:18:16.24,0:18:19.62,Default,TATSUO,0,0,0,,Thứ này đã phong ấn nhân cách của tôi suốt thời gian qua.
Dialogue: 0,0:18:19.62,0:18:22.77,Default,TATSUO,0,0,0,,Nhờ có cậu, cuối cùng tôi cũng được tự do.
Dialogue: 0,0:18:23.21,0:18:25.53,Default,AGEHA,0,0,0,,Cậu thực sự tỉnh táo lại rồi sao?
Dialogue: 0,0:18:25.53,0:18:28.06,Default,TATSUO,0,0,0,,Không sao đâu. Tôi tự biết rõ mà.
Dialogue: 0,0:18:28.06,0:18:30.35,Default,TATSUO,0,0,0,,Thứ này giờ đã trở thành một phần cơ thể tôi rồi.
Dialogue: 0,0:18:30.79,0:18:34.48,Default,TATSUO,0,0,0,,Cảm giác cứ như tôi bị nhốt làm khán giả\Ntrong chính cơ thể người khác vậy,
Dialogue: 0,0:18:34.48,0:18:38.47,Default,TATSUO,0,0,0,,nhưng mọi việc tôi từng gây ra\Nđều hằn sâu vào trong tâm trí.
Dialogue: 0,0:18:38.89,0:18:42.54,Default,TATSUO,0,0,0,,Anh Asaga, những gì em gây ra không thể vãn hồi được nữa.
Dialogue: 0,0:18:43.30,0:18:44.35,Default,TATSUO,0,0,0,,Em xin lỗi.
Dialogue: 0,0:18:44.83,0:18:46.64,Default,TATSUO,0,0,0,,Tất cả là lỗi tại em mới ra cơ sự này.
Dialogue: 0,0:18:48.58,0:18:51.36,DefaultItalics,TATSUO/ID,0,0,0,,Đó là biểu tượng của tụi mình...
Dialogue: 0,0:18:51.78,0:18:56.11,DefaultItalics,TATSUO/ID,0,0,0,,Cảm ơn anh vì đã đi tìm em.
Dialogue: 0,0:18:56.11,0:18:57.70,Default,OBORO,0,0,0,,Đừng lo lắng.
Dialogue: 0,0:18:58.32,0:19:00.57,Default,OBORO,0,0,0,,Tôi sẽ chữa lành cho cậu ấy.
Dialogue: 0,0:19:00.57,0:19:04.88,Default,AMAMIYA,0,0,0,,Tatsuo-kun, lũ Tavoo đã cấy lõi đó vào người cậu\Nkhi chúng bắt được cậu.
Dialogue: 0,0:19:05.39,0:19:07.42,Default,AMAMIYA,0,0,0,,Cậu còn nhớ chuyện gì xảy ra sau đó không?
Dialogue: 0,0:19:08.57,0:19:10.80,Default,TATSUO,0,0,0,,Chỉ nhớ được vài mảnh ký ức vụn vặt thôi.
Dialogue: 0,0:19:10.80,0:19:13.77,Flashback,DOLKEY,0,0,0,,Tiêu diệt toàn bộ kẻ xâm nhập!
Dialogue: 0,0:19:13.77,0:19:17.80,Flashback,DOLKEY,0,0,0,,Giết sạch đám năng lực gia PSI dám chống đối chúng ta!
Dialogue: 0,0:19:18.28,0:19:20.99,Default,AGEHA,0,0,0,,Có một con người đang chỉ huy lũ Tavoo sao?
Dialogue: 0,0:19:20.99,0:19:23.57,Default,TATSUO,0,0,0,,Kể từ đó tới nay tôi luôn bị giam cầm ở đây.
Dialogue: 0,0:19:24.24,0:19:30.86,Default,TATSUO,0,0,0,,Thỉnh thoảng tôi chợt tỉnh lại rồi vừa thấy nhẹ nhõm\N— lại vừa tuyệt vọng — khi nhận ra mình vẫn còn sống.
Dialogue: 0,0:19:32.35,0:19:36.43,Default,OBORO,0,0,0,,Tôi đã khép miệng vết thương rồi,\Nnhưng đó là tất cả những gì tôi làm được cho cậu ấy.
Dialogue: 0,0:19:36.43,0:19:39.47,Default,AGEHA,0,0,0,,Cậu ta không chịu tỉnh lại. Nguy to rồi.
Dialogue: 0,0:19:39.47,0:19:41.90,Default,AMAMIYA,0,0,0,,Tụi mình nên mau chóng\Ntrở về thời hiện đại thôi.
Dialogue: 0,0:19:41.90,0:19:43.29,Default,AMAMIYA,0,0,0,,Mau tiến tới cánh cổng nào.
Dialogue: 0,0:19:50.47,0:19:52.36,Default,AGEHA,0,0,0,,Lấy thẻ ra hết đi mọi người.
Dialogue: 0,0:19:52.36,0:19:53.84,Default,AGEHA,0,0,0,,À phải rồi. Tatsuo.
Dialogue: 0,0:19:53.84,0:19:55.38,Default,TATSUO,0,0,0,,Tôi có một chiếc đây.
Dialogue: 0,0:19:55.91,0:19:56.63,Default,AGEHA,0,0,0,,Ra vậy.
Dialogue: 0,0:19:58.62,0:20:00.39,Default,KABUTO,0,0,0,,Tụi mình nhét thẻ vào khe này à?
Dialogue: 0,0:20:00.39,0:20:01.18,Default,AMAMIYA,0,0,0,,Ừ.
Dialogue: 0,0:20:06.26,0:20:07.52,Default,KABUTO,0,0,0,,Kia chẳng phải là...
Dialogue: 0,0:20:09.19,0:20:11.44,Signs,SIGN LEFT,0,0,0,,{\fs10\c&HB8CADE&\3c&H637198&\bord2\pos(292,122.5)}SỐ DƯ THẺ
Dialogue: 0,0:20:09.19,0:20:11.44,Signs,SIGN LEFT,0,0,0,,{\fs10\c&HB8CADE&\3c&H637198&\bord2\pos(292,199.5)}SỐ DƯ XU
Dialogue: 0,0:20:09.19,0:20:11.44,Signs,SIGN RIGHT,0,0,0,,{\blur0.2\fs14\b0\c&H8A9AB7&\pos(403,151)}QUAY SỐ
Dialogue: 0,0:20:09.19,0:20:11.44,Signs,SIGN BOTTOM LEFT,0,0,0,,{\blur0.2\fs14\b0\c&H8A9AB7&\pos(291.5,280)}NGUỒN
Dialogue: 0,0:20:09.19,0:20:11.44,Signs,SIGN BOTTOM RIGHT,0,0,0,,{\blur0.2\fs14\b0\c&H8A9AB7&\pos(536,280)}GHI CHÚ
Dialogue: 0,0:20:18.57,0:20:20.55,Default,OBORO,0,0,0,,Cậu và Asaga-kun là người tiếp theo đấy.
Dialogue: 0,0:20:20.55,0:20:24.08,Default,AGEHA,0,0,0,,Cậu cầm giùm tớ ống nghe được không?\NTớ sẽ đút thẻ của Hiryu vào.
Dialogue: 0,0:20:33.75,0:20:35.75,Default,TATSUO,0,0,0,,Cảm ơn mọi người. Tạm biệt nhé.
Dialogue: 0,0:20:35.75,0:20:36.55,Default,AGEHA,0,0,0,,Hả?
Dialogue: 0,0:20:38.34,0:20:39.63,Default,AGEHA,0,0,0,,Cậu định—
Dialogue: 0,0:20:43.42,0:20:44.61,Default,AGEHA,0,0,0,,Cái tên ngốc đó!
Dialogue: 0,0:20:44.61,0:20:45.89,Default,AGEHA,0,0,0,,Cái quái gì vừa xảy ra thế?!
Dialogue: 0,0:20:46.67,0:20:49.07,Default,AGEHA,0,0,0,,Tatsuo vốn không hề có thẻ!
Dialogue: 0,0:20:49.07,0:20:50.22,Default,AMAMIYA,0,0,0,,Tại sao cậu ấy lại nói dối chứ?
Dialogue: 0,0:20:50.22,0:20:52.40,Default,KABUTO,0,0,0,,Vậy thì cậu ta không thể trở về được rồi.
Dialogue: 0,0:20:52.40,0:20:55.18,Default,AGEHA,0,0,0,,Cậu ta cố tình không muốn tụi mình biết điều đó.
Dialogue: 0,0:20:58.29,0:21:00.95,Default,OBORO,0,0,0,,Đây là đâu thế? Tụi mình về lại thế giới thực rồi phải không?
Dialogue: 0,0:21:00.95,0:21:03.25,Default,AGEHA,0,0,0,,Oboro, Tatsuo đâu rồi?
Dialogue: 0,0:21:03.25,0:21:05.68,Default,OBORO,0,0,0,,Cậu ấy bỏ đi rồi.
Dialogue: 0,0:21:06.16,0:21:08.78,Default,AMAMIYA,0,0,0,,Sao cậu ấy lại không nói cho bọn mình biết?
Dialogue: 0,0:21:08.78,0:21:11.17,Default,AGEHA,0,0,0,,Ít nhất cậu ta phải nói gì đó chứ, đúng không?
Dialogue: 0,0:21:12.04,0:21:13.11,Default,OBORO,0,0,0,,Không đâu.
Dialogue: 0,0:21:13.11,0:21:15.63,Flashback,TATSUO,0,0,0,,Tôi cảm nhận được cái chết đang cận kề rồi.
Dialogue: 0,0:21:15.97,0:21:18.39,Flashback,TATSUO,0,0,0,,Viên ngọc này đang cạn dần năng lượng.
Dialogue: 0,0:21:18.93,0:21:20.88,Flashback,TATSUO,0,0,0,,Khi nó tắt lịm hoàn toàn, tôi cũng sẽ chết.
Dialogue: 0,0:21:20.88,0:21:24.72,Flashback,OBORO,0,0,0,,Rất tiếc, nhưng tôi không nghĩ\Nmình có thể gỡ nó ra được.
Dialogue: 0,0:21:24.72,0:21:25.90,Flashback,TATSUO,0,0,0,,Không sao đâu.
Dialogue: 0,0:21:25.90,0:21:30.72,Flashback,TATSUO,0,0,0,,Tôi chỉ không muốn chết ngay trước mặt\NYoshina-kun. Nhất là sau khi cậu ấy đã cứu mình.
Dialogue: 0,0:21:30.72,0:21:33.35,Flashback,TATSUO,0,0,0,,Tôi không muốn cậu ấy phải tự dằn vặt\Nrằng mình chịu trách nhiệm cho cái chết của tôi.
Dialogue: 0,0:21:34.45,0:21:38.30,Default,OBORO,0,0,0,,Có lẽ cậu ấy không muốn gây thêm\Nbất kỳ phiền phức nào nữa đâu.
Dialogue: 0,0:21:39.09,0:21:40.44,Default,AGEHA,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:41.11,0:21:43.43,Default,AGEHA,0,0,0,,Tụi mình biết ăn nói thế nào với Hiryu đây?
Dialogue: 0,0:21:44.44,0:21:45.12,DefaultItalics,TATSUO/ID,0,0,0,,Anh Asaga à.
Dialogue: 0,0:21:45.76,0:21:48.12,DefaultItalics,TATSUO/ID,0,0,0,,Em không hề có ý định nằm chờ chết đâu.
Dialogue: 0,0:21:48.71,0:21:51.17,DefaultItalics,TATSUO/ID,0,0,0,,Biết đâu vẫn còn cách để em tiếp tục sống sót.
Dialogue: 0,0:21:51.75,0:21:55.64,DefaultItalics,TATSUO/ID,0,0,0,,Em nhất định sẽ tìm ra con đường ấy ở thế giới này.
Dialogue: 0,0:21:56.38,0:21:57.96,DefaultItalics,TATSUO/ID,0,0,0,,Hãy chờ em nhé.
Dialogue: 0,0:21:58.35,0:22:03.23,DefaultItalics,TATSUO/ID,0,0,0,,Em sẽ tự đứng trên đôi chân của mình mà trở về bên anh.
Dialogue: 0,0:22:05.18,0:22:08.69,Credits,CREDITS,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:22:09.06,0:22:12.56,Credits,CREDITS,0,0,0,,Timing: Amtia(NOFACE)\NBiên tập & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:22:12.82,0:22:16.32,Credits,CREDITS,0,0,0,,Kiểm định chất lượng: Amtia(NOFACE)\NHiệu đính bản dịch: Amtia(NOFACE)
