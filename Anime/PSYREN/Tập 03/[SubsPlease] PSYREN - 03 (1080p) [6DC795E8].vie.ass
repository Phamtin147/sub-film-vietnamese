Dialogue: 0,0:00:01.56,0:00:03.08,DefaultItalics,SIGN & VO,0,0,0,,Cậu có biết truyền thuyết đô thị đó không?
Dialogue: 0,0:00:03.08,0:00:04.98,DefaultItalics,SIGN & VO,0,0,0,,Tớ nghe được một tin đồn điên rồ về mấy bốt điện thoại công cộng đấy.
Dialogue: 0,0:00:04.98,0:00:07.58,DefaultItalics,SIGN & VO,0,0,0,,Nếu cậu nhấc máy trả lời cuộc gọi,\Ncậu sẽ được đưa tới thiên đường.
Dialogue: 0,0:00:07.58,0:00:08.71,DefaultItalics,SIGN & VO,0,0,0,,Thật thế á?
Dialogue: 0,0:00:09.49,0:00:11.66,DefaultItalics,SIGN & VO,0,0,0,,Mấy bốt điện thoại công cộng đó nhìn hoài niệm phết nhỉ.
Dialogue: 0,0:00:12.08,0:00:13.86,DefaultItalics,SIGN & VO,0,0,0,,Bây giờ người ta vẫn còn dùng thứ đó sao?
Dialogue: 0,0:00:14.49,0:00:16.99,DefaultItalics,SIGN & VO,0,0,0,,Hồi tiểu học tớ từng được học cách dùng rồi.
Dialogue: 0,0:00:16.99,0:00:19.50,DefaultItalicsTop,SIGN & VO,0,0,0,,Tớ thấy vụ đó trên tivi rồi.\NĐã có người thực sự mất tích đấy.
Dialogue: 0,0:01:58.26,0:02:03.27,Signs_EpTitle,SIGN,0,0,0,,{\fad(525,523)\an9\blur2\fs18\pos(428.357,279.214)\3c&HA34031&}Tập 3  {\fs24}SIÊU NĂNG LỰC PSI
Dialogue: 0,0:02:01.34,0:02:04.13,DefaultItalicsTop,HIRYU/ID,0,0,0,,Khốn nạn. Mắt mình bắt đầu mờ đi rồi.
Dialogue: 0,0:02:04.13,0:02:07.36,DefaultItalics,HIRYU/ID,0,0,0,,Chỉ cần hít thở sâu một hơi thôi là xương sườn lại đau nhói lên.
Dialogue: 0,0:02:09.07,0:02:10.40,DefaultItalics,HIRYU/ID,0,0,0,,Cái gì?!
Dialogue: 0,0:02:11.23,0:02:12.32,Default,ALFRED,0,0,0,,Agro.
Dialogue: 0,0:02:38.83,0:02:40.31,DefaultItalics,HIRYU/ID,0,0,0,,Không thể nào...
Dialogue: 0,0:02:42.87,0:02:45.31,DefaultItalics,HIRYU/ID,0,0,0,,Cơ thể mình không nhúc nhích nổi nữa rồi.
Dialogue: 0,0:02:51.55,0:02:52.78,Default,HIRYU,0,0,0,,Amamiya?
Dialogue: 0,0:02:52.78,0:02:55.74,Default,HIRYU,0,0,0,,Cậu nghĩ cái quái gì thế hả? Cậu muốn chết à?!
Dialogue: 0,0:02:55.74,0:02:59.12,Default,AMAMIYA,0,0,0,,Tớ sẽ câu giờ cho cậu. Chạy mau đi!
Dialogue: 0,0:03:00.63,0:03:01.60,Default,AMAMIYA,0,0,0,,Cường hóa Rise!
Dialogue: 0,0:03:09.19,0:03:11.80,Default,AMAMIYA,0,0,0,,Tớ không trụ được lâu đâu. Mau đứng dậy đi!
Dialogue: 0,0:03:16.91,0:03:18.59,Default,AMAMIYA,0,0,0,,Nhanh lên...
Dialogue: 0,0:03:18.59,0:03:20.55,Default,HIRYU,0,0,0,,Đừng lo cho tớ! Cậu mau biến khỏi đây đi!
Dialogue: 0,0:03:26.29,0:03:29.31,DefaultItalics,AMAMIYA/ID,0,0,0,,Không ngờ mọi chuyện lại kết thúc thế này.
Dialogue: 0,0:03:32.52,0:03:33.96,Default,ALFRED,0,0,0,,Graham?
Dialogue: 0,0:03:35.81,0:03:37.70,Default,AGEHA,0,0,0,,Bọn tao nhất định sẽ sống sót trở về!
Dialogue: 0,0:03:38.68,0:03:39.53,Default,AMAMIYA,0,0,0,,Yoshina!
Dialogue: 0,0:03:41.78,0:03:42.91,Default,ALFRED,0,0,0,,Graham.
Dialogue: 0,0:03:42.91,0:03:46.29,Default,AGEHA,0,0,0,,Ngon thì nhào vô!
Dialogue: 0,0:03:57.33,0:04:00.58,Default,AGEHA,0,0,0,,Ối chà, xin lỗi mày nhé.
Dialogue: 0,0:04:00.58,0:04:03.43,Default,AGEHA,0,0,0,,Có vẻ như tao đã chọn đúng mục tiêu rồi.
Dialogue: 0,0:04:07.14,0:04:08.64,Default,AGEHA,0,0,0,,Đồ khốn kiếp!
Dialogue: 0,0:04:08.64,0:04:09.60,Default,AMAMIYA,0,0,0,,Yoshina!
Dialogue: 0,0:04:24.76,0:04:26.95,Default,AGEHA,0,0,0,,Rốt cuộc lũ quái vật đó là cái giống loài gì thế hả trời?
Dialogue: 0,0:04:26.95,0:04:29.21,Default,AGEHA,0,0,0,,Kiệt sức mất thôi.
Dialogue: 0,0:04:29.87,0:04:32.84,DefaultItalics,HIRYU/ID,0,0,0,,Phải rồi, chuyện quái gì đang xảy ra thế này?
Dialogue: 0,0:04:32.84,0:04:36.46,DefaultItalics,HIRYU/ID,0,0,0,,Quái vật giết người, một đứa con gái tay không chặn đứng mũi tên nỏ...
Dialogue: 0,0:04:36.99,0:04:41.40,DefaultItalics,HIRYU/ID,0,0,0,,và trên hết, tên của thằng nhóc này là Yoshina? Không lẽ nào...
Dialogue: 0,0:04:42.11,0:04:45.47,Default,AGEHA,0,0,0,,Mấy con quái vật đó là cái thứ gì thế, Amamiya?
Dialogue: 0,0:04:45.75,0:04:49.18,Default,AMAMIYA,0,0,0,,Là Tavoo. Ai ở đây cũng gọi chúng như vậy.
Dialogue: 0,0:04:49.86,0:04:54.10,Default,AMAMIYA,0,0,0,,Có đủ mọi chủng loài quái vật khác nhau đang lởn vởn khắp thế giới này.
Dialogue: 0,0:04:54.10,0:04:59.04,Default,AMAMIYA,0,0,0,,Tớ không biết chúng từ đâu tới và mục đích của chúng là gì.
Dialogue: 0,0:04:59.40,0:05:03.62,Default,AGEHA,0,0,0,,Còn gì nữa không? Tớ muốn biết ngọn ngành mọi chi tiết.
Dialogue: 0,0:05:04.03,0:05:07.58,Default,AMAMIYA,0,0,0,,Để sau đi. Chỗ này không an toàn đâu.
Dialogue: 0,0:05:18.76,0:05:21.61,Default,AMAMIYA,0,0,0,,Bốt điện thoại công cộng đằng kia chính là đích đến. Đó là cánh cổng thoát hiểm.
Dialogue: 0,0:05:21.61,0:05:23.89,Default,AGEHA,0,0,0,,Oa, nó thực sự tồn tại kìa!
Dialogue: 0,0:05:23.89,0:05:26.45,Default,AGEHA,0,0,0,,Tuyệt cú mèo, tới đích rồi! Bọn mình làm được rồi!
Dialogue: 0,0:05:26.45,0:05:30.14,Default,AGEHA,0,0,0,,Cậu không phiền nếu tớ về trước chứ?
Dialogue: 0,0:05:30.14,0:05:31.84,Default,HIRYU,0,0,0,,Chết tiệt, cái thằng nhóc phiền phức này.
Dialogue: 0,0:05:31.84,0:05:33.23,Default,SEMITANI,0,0,0,,Ủa, nó thực sự ở đây này.
Dialogue: 0,0:05:33.69,0:05:36.89,Default,SEMITANI,0,0,0,,Thoát rồi. Đây là cánh cổng đúng không?
Dialogue: 0,0:05:37.73,0:05:39.78,Default,HIRYU,0,0,0,,Mày còn sống à?
Dialogue: 0,0:05:39.78,0:05:46.54,Default,SEMITANI,0,0,0,,Kể từ lúc ngã lăn xuống vách đá đó, tao đã bám theo sau lưng tụi mày suốt đấy.
Dialogue: 0,0:05:47.17,0:05:49.10,Default,SEMITANI,0,0,0,,Trông tụi mày có vẻ chật vật vất vả phết nhỉ.
Dialogue: 0,0:05:49.10,0:05:51.25,Default,SEMITANI,0,0,0,,Đừng để bụng làm gì, nhóc con.
Dialogue: 0,0:05:51.25,0:05:54.42,Default,SEMITANI,0,0,0,,Đằng nào thì cái thằng nhóc bị thương kia cũng chết thôi mà. Chỉ là vấn đề thời gian.
Dialogue: 0,0:05:54.76,0:05:55.51,Default,AGEHA,0,0,0,,Mày vừa sủa cái gì...
Dialogue: 0,0:05:55.51,0:05:56.46,Default,HIRYU,0,0,0,,Đừng, bỏ đi.
Dialogue: 0,0:05:56.46,0:05:59.77,Default,AMAMIYA,0,0,0,,Có gì lát nữa đánh nhau sau. Mọi người mau lấy thẻ điện thoại ra đi.
Dialogue: 0,0:06:02.05,0:06:04.33,Default,AMAMIYA,0,0,0,,Bây giờ chúng ta có thể quay trở về thế giới thực rồi.
Dialogue: 0,0:06:05.17,0:06:06.68,Default,AMAMIYA,0,0,0,,Làm theo tớ.
