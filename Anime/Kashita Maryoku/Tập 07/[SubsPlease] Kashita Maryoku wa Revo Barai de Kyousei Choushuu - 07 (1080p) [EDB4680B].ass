Dialogue: 0,0:00:05.57,0:00:07.18,Default,LENT,0,0,0,,Em làm tuyệt lắm, Linka!
Dialogue: 0,0:00:07.48,0:00:10.98,Default,LENT,0,0,0,,Em đã quét sạch cả bầy goblin đó\Nchỉ trong vỏn vẹn vài phút thôi đấy!
Dialogue: 0,0:00:10.98,0:00:12.57,Default,LENT,0,0,0,,Em đúng thật là—
Dialogue: 0,0:00:19.44,0:00:20.75,Default,LENT,0,0,0,,Linka!
Dialogue: 0,0:00:22.33,0:00:23.89,Default,LINKA,0,0,0,,Anh Lent.
Dialogue: 0,0:00:25.75,0:00:30.01,Default,LINKA,0,0,0,,Em xin lỗi. Tại em hăng hái quá đà mất.
Dialogue: 0,0:00:30.49,0:00:36.51,Default,LINKA,0,0,0,,Từ trước tới giờ em chưa từng duy trì\Nkỹ năng được lâu tới mức này bao giờ cả.
Dialogue: 0,0:00:36.83,0:00:38.19,Default,LENT,0,0,0,,Linka.
Dialogue: 0,0:00:39.65,0:00:41.41,Default,LINKA,0,0,0,,Em xin lỗi!
Dialogue: 0,0:00:41.41,0:00:45.79,Default,EMPEE,0,0,0,,Hai người ngây thơ trong sáng ghê nhỉ.
Dialogue: 0,0:01:00.41,0:01:01.43,Signs,EMPEE,0,0,0,,{\fad(500,200)\fnSegoe UI\bord2\blur5\pos(108.445,114.222)\c&H98905C&\3c&HFFED6A&}Cho Vay\NMa Lực
Dialogue: 0,0:01:00.41,0:01:01.43,Signs,EMPEE,0,0,0,,{\fad(500,200)\fnSegoe UI\bord2\blur5\c&H98905C&\3c&HFFED6A&\pos(343.445,112.222)}Bị Tổ Đội Ruồng Bỏ, Tôi Thu Nợ Cùng Bé Tinh Linh\NĐể Trở Thành Kẻ Mạnh Nhất!
Dialogue: 0,0:01:01.43,0:01:03.04,Signs,EMPEE,0,0,0,,{\fad(200,000)\fnSegoe UI\pos(108.445,114.222)}Cho Vay\N{\c&H1D1EFF&}Ma Lực {\c&HFFFFFF&}Trả Góp
Dialogue: 0,0:01:01.43,0:01:03.04,Signs,EMPEE,0,0,0,,{\fad(200,000)\fnSegoe UI\c&H1D1EFF&\pos(356.132,115.838)}Bị Tổ Đội {\c&HFFFFFF&}Ruồng Bỏ, Tôi Thu Nợ {\c&H1D1EFF&}Cùng\NBé Tinh Linh {\c&HFFFFFF&}Để Trở Thành Kẻ {\c&H1D1EFF&}Mạnh Nhất!
Dialogue: 0,0:02:17.20,0:02:20.51,Default,PANNA,0,0,0,,Tổng cộng là 1.043 viên\NMa Thạch của goblin.
Dialogue: 0,0:02:21.00,0:02:23.72,Default,PANNA,0,0,0,,Tính gộp lại thì được 104.300 gol.
Dialogue: 0,0:02:21.64,0:02:23.72,Signs,PANNA,0,0,0,,{\fad(700,500)\blur1\3c&H2E2E2E&\4c&H848487&\fnSegoe UI\alpha20\bord1\pos(553,275)}"Hội Ngộ"
Dialogue: 0,0:02:24.49,0:02:27.99,Default,PANNA,0,0,0,,18 viên Ma Thạch của thủ lĩnh goblin,\Nquy đổi thành 9.000 gol.
Dialogue: 0,0:02:28.25,0:02:33.00,Default,PANNA,0,0,0,,18 hạt nhân từ việc tiêu diệt hang ổ goblin,\Nquy đổi thành 36.000 gol.
Dialogue: 0,0:02:33.47,0:02:35.51,Default,PANNA,0,0,0,,Đây là tiền thù lao của hai người ạ.
Dialogue: 0,0:02:35.51,0:02:37.97,Default,ADVENTURER A,0,0,0,,Ghê thật đấy. Lại là cậu nữa à?
Dialogue: 0,0:02:37.97,0:02:40.20,Default,LENT,0,0,0,,Hôm nay toàn bộ là công sức của cô bé này cả đấy.
Dialogue: 0,0:02:42.74,0:02:44.77,Default,LINKA,0,0,0,,Không thể tin nổi luôn, anh Lent ơi!
Dialogue: 0,0:02:44.77,0:02:47.77,Default,LINKA,0,0,0,,Ch-Chỉ riêng trong hôm nay thôi,
Dialogue: 0,0:02:47.77,0:02:51.27,Default,LINKA,0,0,0,,giới hạn MP tối đa của em đã tăng thêm\Ntận bốn điểm liền đấy!
Dialogue: 0,0:02:51.52,0:02:52.77,Default,LENT,0,0,0,,Chúc mừng em nhé.
Dialogue: 0,0:02:53.53,0:02:56.15,Default,LINKA,0,0,0,,Đã ba năm kể từ khi em\Ntrở thành mạo hiểm giả.
Dialogue: 0,0:02:56.15,0:02:58.78,Default,LINKA,0,0,0,,Vậy mà từ trước tới nay em mới tăng được có hai điểm.
Dialogue: 0,0:02:59.33,0:03:03.66,Default,LINKA,0,0,0,,Tất cả đều nhờ công của anh Lent cả đấy.\NEm cảm ơn anh nhiều lắm.
Dialogue: 0,0:03:03.89,0:03:08.17,Default,LENT,0,0,0,,Anh chỉ góp chút sức mọn thôi.\NChính em mới là người tự mình làm được.
Dialogue: 0,0:03:08.17,0:03:12.42,Default,LINKA,0,0,0,,Em vẫn chẳng thể tin nổi\Nnhững chuyện xảy ra hôm nay.
Dialogue: 0,0:03:12.70,0:03:16.58,Default,LENT,0,0,0,,Em thật sự rất mạnh mẽ đấy.\NHãy ngẩng cao đầu tự hào lên nhé.
Dialogue: 0,0:03:17.04,0:03:18.45,Default,LINKA,0,0,0,,Anh Lent.
Dialogue: 0,0:03:18.45,0:03:21.60,Default,EMPEE,0,0,0,,Vâng vâng, xin lỗi vì cắt ngang nhé,
Dialogue: 0,0:03:21.60,0:03:25.67,Default,EMPEE,0,0,0,,nhưng em có thông báo về khoản vay MP\Nhôm nay của cô Linka ạ.
Dialogue: 0,0:03:25.67,0:03:31.21,Default,EMPEE,0,0,0,,Cô ấy đã kích hoạt kỹ năng 18 lần,\Ntổng cộng hết 126 MP.
Dialogue: 0,0:03:31.21,0:03:34.78,Default,EMPEE,0,0,0,,Tổng thời gian duy trì là 1 tiếng\N21 phút 40 giây.
Dialogue: 0,0:03:34.78,0:03:38.18,Default,EMPEE,0,0,0,,Cứ mỗi mười giây tiêu hao một MP...
Dialogue: 0,0:03:38.39,0:03:42.44,Default,EMPEE,0,0,0,,vậy tính gộp lại tổng nợ là 616 MP.
Dialogue: 0,0:03:42.78,0:03:46.45,Default,LINKA,0,0,0,,Em sẽ còn mạnh hơn nữa\Nvà trả hết sạch nợ cho anh.
Dialogue: 0,0:03:46.67,0:03:48.72,Default,EMPEE,0,0,0,,Ngoài ra, lãi suất áp dụng là 10% nhé.
Dialogue: 0,0:03:48.72,0:03:51.11,Default,EMPEE,0,0,0,,Nhưng không có thời hạn trả nợ đâu.
Dialogue: 0,0:03:51.11,0:03:52.45,Default,LINKA,0,0,0,,V-Vâng ạ.
Dialogue: 0,0:03:52.45,0:03:57.41,Italic,LENT/ID,0,0,0,,Nghĩ lại mới thấy, lần cuối có người cảm ơn mình\Nvì đã dùng sức mạnh này là từ bao giờ nhỉ?
Dialogue: 0,0:03:57.74,0:03:59.89,Flashback,GUY,0,0,0,,Kỹ năng của bọn mình tăng cấp rồi.
Dialogue: 0,0:03:59.89,0:04:01.57,Flashback,MISA,0,0,0,,Tất cả đều nhờ cậu đấy, Lent.
Dialogue: 0,0:04:01.57,0:04:03.17,Flashback,GUY & MISA,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:04:03.39,0:04:05.31,Italic,LENT/ID,0,0,0,,Mình sẽ không đi vào vết xe đổ nữa đâu.
Dialogue: 0,0:04:05.68,0:04:08.00,Italic,LENT/ID,0,0,0,,Lần này, cả hai sẽ cùng nhau trở nên mạnh mẽ hơn.
Dialogue: 0,0:04:08.00,0:04:09.43,Default,EMPEE,0,0,0,,Chủ nhân à.
Dialogue: 0,0:04:09.67,0:04:13.86,Default,EMPEE,0,0,0,,Để ăn mừng ngày thành lập tổ đội mới,\Nmình đi chén món gì thật ngon đi.
Dialogue: 0,0:04:13.86,0:04:16.38,Default,LENT,0,0,0,,Phải đấy nhỉ.\NLinka, em muốn ăn món gì nào?
Dialogue: 0,0:04:16.38,0:04:19.94,Default,LINKA,0,0,0,,Thịt ạ! Em mê thịt lắm!\NMấy món làm từ bột mì cũng ngon nữa ạ.
Dialogue: 0,0:04:21.07,0:04:24.91,Signs,SIGN,0,0,0,,{\fad(400,400)\shad1\bord2\p1\alpha&H50&\c&HFFFFFF&\3c&H000000&\4c&HB7B7B7&\fscx82\fscy36\pos(317.527,189.054)}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:04:21.07,0:04:24.91,Signs,SIGN,0,0,0,,{\fad(400,400)\bord0\fs13\c&H151515&\fnSegoe UI\pos(318.804,191.497)}Mê Cung Melva\NTầng 8 "Dãy Núi Wyvern"
Dialogue: 0,0:04:31.90,0:04:33.55,Default,ROGER,0,0,0,,Nó lao tới đấy, Jin.
Dialogue: 0,0:04:33.55,0:04:34.85,Default,JIN,0,0,0,,Thuẫn Aegis!
Dialogue: 0,0:04:42.45,0:04:44.78,Default,JIN,0,0,0,,Cứ nhây thế này chẳng ăn thua đâu.
Dialogue: 0,0:04:44.78,0:04:48.18,Default,ROGER,0,0,0,,Vậy thì đành kéo sập nó xuống đất thôi.\NNamilia!
Dialogue: 0,0:04:48.18,0:04:49.30,Default,NAMILIA,0,0,0,,Rõ rồi.
Dialogue: 0,0:04:53.32,0:04:55.30,Default,NAMILIA,0,0,0,,Cường Hóa Thể Chất!
Dialogue: 0,0:05:05.65,0:05:07.24,Default,FUUGA,0,0,0,,Thiên Thương Kích!
Dialogue: 0,0:05:10.99,0:05:14.25,Default,COMET,0,0,0,,Rơi xuống đi! Thiên Thạch Kích!
Dialogue: 0,0:05:26.01,0:05:28.31,Default,JIN,0,0,0,,Chào mừng xuống mặt đất nhé, bạn hiền.
Dialogue: 0,0:05:28.31,0:05:31.01,Default,ROGER,0,0,0,,Tiếp đón nó nồng hậu chút nào.
Dialogue: 0,0:05:33.75,0:05:35.51,Default,NAMILIA,0,0,0,,Cường Hóa Tốc Độ!
Dialogue: 0,0:05:51.74,0:05:53.66,Signs,SIGN,0,0,0,,{\fad(400,000)\shad1\bord2\p1\alpha&H50&\c&HFFFFFF&\3c&H000000&\4c&HB7B7B7&\fscx86\fscy34\pos(318.527,210.054)}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:05:51.74,0:05:53.66,Signs,SIGN,0,0,0,,{\fad(400,000)\bord0\fs13\c&H151515&\fnSegoe UI\pos(318.804,211.497)}Kỹ Năng: Chiến Hống\NHét lớn thu hút sự chú ý của kẻ địch
Dialogue: 0,0:05:55.99,0:05:57.33,Default,JIN,0,0,0,,Kiên Bích Phòng Ngự!
Dialogue: 0,0:06:00.76,0:06:02.05,Default,FUUGA,0,0,0,,Liên Hoàn Xuyên Phá!
Dialogue: 0,0:06:05.54,0:06:07.71,Default,ROGER,0,0,0,,Comet, hất anh lên không trung đi!
Dialogue: 0,0:06:08.15,0:06:09.98,Default,COMET,0,0,0,,Cuồng Phong Trận!
Dialogue: 0,0:06:14.21,0:06:15.94,Default,NAMILIA,0,0,0,,Cường Hóa Kỹ Năng!
Dialogue: 0,0:06:19.69,0:06:21.39,Default,ROGER,0,0,0,,Trọng Trảm!
Dialogue: 0,0:06:33.04,0:06:35.28,Default,JIN,0,0,0,,Mấy cái vảy này vừa to vừa nặng ghê.
Dialogue: 0,0:06:35.28,0:06:38.00,Default,JIN,0,0,0,,Gỡ có một mảnh thôi mà mệt bở hơi tai.
Dialogue: 0,0:06:38.00,0:06:41.44,Default,FUUGA,0,0,0,,Nhiệm vụ lần này cần tới 30 mảnh vảy lận đấy.
Dialogue: 0,0:06:41.44,0:06:44.81,Default,JIN,0,0,0,,Ba mươi cái cơ á?! Kiểu này vất vả to rồi.
Dialogue: 0,0:06:44.81,0:06:48.71,Default,JIN,0,0,0,,Ai mà ngờ khâu thu thập nguyên liệu\Nlại cực hơn cả lúc đi săn wyvern chứ.
Dialogue: 0,0:06:51.63,0:06:53.21,Default,ROGER,0,0,0,,Tôi về rồi đây.
Dialogue: 0,0:06:53.61,0:06:56.63,Default,JIN,0,0,0,,Roger, nãy giờ cậu chui ở đâu ra thế hả?
Dialogue: 0,0:06:56.63,0:06:57.60,Default,ROGER,0,0,0,,Này.
Dialogue: 0,0:06:58.24,0:07:00.43,Default,ROGER,0,0,0,,Tôi lấy được lá gan wyvern về rồi đây.
Dialogue: 0,0:07:00.43,0:07:03.97,Default,JIN,0,0,0,,Đừng nói với tôi là cậu chui hẳn\Nvào bên trong bụng con quái đó nhé!
Dialogue: 0,0:07:04.20,0:07:08.23,Default,ROGER,0,0,0,,Axit dạ dày của nó suýt nữa thì làm tan chảy tôi luôn đấy.
Dialogue: 0,0:07:08.23,0:07:12.47,Default,JIN,0,0,0,,Thằng ngốc này! Tôi đã dặn đi dặn lại bao lần\Nlà cấm làm mấy trò nguy hiểm thế rồi cơ mà!
Dialogue: 0,0:07:12.47,0:07:13.80,Default,ROGER,0,0,0,,Tôi sơ suất quá.
Dialogue: 0,0:07:20.95,0:07:23.75,Default,ROGER,0,0,0,,Bên trong bụng con wyvern có đầy ký sinh trùng đấy.
Dialogue: 0,0:07:23.75,0:07:27.47,Default,NAMILIA,0,0,0,,Ôi trời ơi! Làm ơn xử lý lẹ đi.
Dialogue: 0,0:07:27.47,0:07:29.66,Default,JIN,0,0,0,,Đừng có rên mấy tiếng kỳ quặc thế nữa, Namilia!
Dialogue: 0,0:07:29.66,0:07:32.04,Default,JIN,0,0,0,,Còn Comet, nói một câu gì đi chứ!
Dialogue: 0,0:07:32.63,0:07:34.21,Default,JIN,0,0,0,,Thật luôn hả trời?
Dialogue: 0,0:07:38.20,0:07:39.56,Default,LINKA,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:07:39.79,0:07:42.55,Default,LINKA,0,0,0,,Đi ăn tối cùng tổ đội Meteor Shower á?
Dialogue: 0,0:07:42.55,0:07:45.01,Default,LENT,0,0,0,,Đâu cần phải ngạc nhiên dữ vậy chứ.
Dialogue: 0,0:07:45.01,0:07:47.33,Default,LINKA,0,0,0,,À, em xin lỗi.
Dialogue: 0,0:07:47.82,0:07:50.56,Default,LENT,0,0,0,,Hôm trước anh Roger có ngỏ lời mời anh.
Dialogue: 0,0:07:50.56,0:07:54.33,Default,LENT,0,0,0,,Anh nghĩ đây là dịp tốt để em\Ngặp gỡ làm quen với họ luôn.
Dialogue: 0,0:07:54.33,0:07:58.34,Default,LINKA,0,0,0,,Ôi không được đâu ạ! Em chỉ là một\Nmạo hiểm giả hạng F quèn thôi mà!
Dialogue: 0,0:07:58.34,0:08:00.64,Top,LINKA,0,0,0,,Em không xứng ngồi chung bàn với họ đâu!
Dialogue: 0,0:07:59.57,0:08:02.38,Default,EMPEE,0,0,0,,Cứ lắc đầu kiểu đó khéo đứt cổ luôn\Nbây giờ đấy cô em.
Dialogue: 0,0:08:02.84,0:08:07.20,Default,LINKA,0,0,0,,Anh Lent quen biết thật với\Ntổ đội Meteor Shower luôn à?
Dialogue: 0,0:08:07.20,0:08:08.08,Default,LENT,0,0,0,,Ừ.
Dialogue: 0,0:08:08.88,0:08:13.11,Default,LENT,0,0,0,,Anh từng đi nhậu với họ vài lần\Ntừ hồi nhóm Skypiercers
Dialogue: 0,0:08:13.11,0:08:16.01,Default,LENT,0,0,0,,bắt đầu nổi danh được chú ý ấy.
Dialogue: 0,0:08:17.09,0:08:18.80,Default,LINKA,0,0,0,,Ra là vậy.
Dialogue: 0,0:08:18.80,0:08:23.54,Default,LENT,0,0,0,,Giờ chúng ta đã chung một tổ đội rồi,\Nnên anh muốn giới thiệu em với họ.
Dialogue: 0,0:08:25.79,0:08:28.96,Default,LINKA,0,0,0,,Em xin lỗi. Em vẫn xin phép kiếu thôi ạ.
Dialogue: 0,0:08:29.30,0:08:32.61,Default,LINKA,0,0,0,,Em không muốn làm kỳ đà cản mũi\Nbuổi hội ngộ của mọi người đâu.
Dialogue: 0,0:08:33.05,0:08:34.11,Default,LENT,0,0,0,,Vậy cũng được.
Dialogue: 0,0:08:34.45,0:08:38.97,Default,LINKA,0,0,0,,Anh Lent tối nay nhớ vui chơi thay cả phần em nhé.
Dialogue: 0,0:08:46.70,0:08:50.21,Italic,LENT/ID,0,0,0,,Lâu lắm rồi mình mới lại được ngồi uống\Ncùng với anh Roger.
Dialogue: 0,0:08:50.21,0:08:53.07,Italic,LENT/ID,0,0,0,,Vừa háo hức mà cũng\Nhơi hồi hộp nữa.
Dialogue: 0,0:08:53.72,0:08:55.50,Default,NAMILIA,0,0,0,,Xin lỗi để hai người đợi lâu nhé.
Dialogue: 0,0:08:58.71,0:09:00.15,Default,LENT,0,0,0,,Chị Namilia!
Dialogue: 0,0:09:00.40,0:09:03.13,Default,LENT,0,0,0,,Chẳng phải chị vừa mới đi\Nthám hiểm mê cung về sao?
Dialogue: 0,0:09:03.13,0:09:08.53,Default,NAMILIA,0,0,0,,Tối nay đi nhậu với em nên chị mới\Ncất công chưng diện một chút đấy.
Dialogue: 0,0:09:10.78,0:09:14.03,Default,NAMILIA,0,0,0,,Em thấy bộ đồ này của chị thế nào?
Dialogue: 0,0:09:14.39,0:09:18.91,Default,LENT,0,0,0,,E-Em thấy hợp với chị lắm ạ.
Dialogue: 0,0:09:19.21,0:09:22.15,Default,NAMILIA,0,0,0,,Nào, nhìn thẳng đàng hoàng xem thử đi chứ.
Dialogue: 0,0:09:23.14,0:09:25.66,Default,NAMILIA,0,0,0,,Úi chà, mặt đỏ bừng hết lên rồi kìa.
Dialogue: 0,0:09:25.92,0:09:28.42,Default,NAMILIA,0,0,0,,Lúc nào trông em cũng dễ thương thế này cả.
Dialogue: 0,0:09:28.42,0:09:30.56,Default,ROGER,0,0,0,,Này!
Dialogue: 0,0:09:31.43,0:09:35.01,Default,ROGER,0,0,0,,Cái bộ dạng lố bịch gì đây hả?
Dialogue: 0,0:09:35.01,0:09:38.31,Default,NAMILIA,0,0,0,,Sao anh nỡ nói thế? Đây là bộ cánh\Nđẹp nhất của em đấy nhé!
Dialogue: 0,0:09:38.31,0:09:41.74,Default,ROGER,0,0,0,,Này, mặt thằng Lent sắp đổi sang màu\Nkỳ quặc luôn rồi kìa!
Dialogue: 0,0:09:42.55,0:09:44.26,Default,ALL,0,0,0,,Cạn ly nào!
Dialogue: 0,0:09:48.15,0:09:49.78,Default,ROGER,0,0,0,,Cho tôi thêm một vại bia nữa nhé.
Dialogue: 0,0:09:49.78,0:09:51.00,Default,NAMILIA,0,0,0,,Cho chị thêm một ly luôn.
Dialogue: 0,0:09:51.00,0:09:53.20,Default,WAITRESS,0,0,0,,Hai bia ạ. Có ngay đây.
Dialogue: 0,0:09:53.20,0:09:56.58,Italic,LENT/ID,0,0,0,,Cố uống theo tốc độ của hai người này\Nchắc mình gục tại bàn mất.
Dialogue: 0,0:09:58.08,0:09:59.56,Default,ROGER,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:10:06.36,0:10:10.63,Default,ROGER,0,0,0,,Lent này, gần đây tôi nghe đủ thứ tin đồn\Nvề nhóm Skypiercers đấy.
Dialogue: 0,0:10:10.63,0:10:12.89,Default,ROGER,0,0,0,,Cả chuyện bọn họ đá cậu ra khỏi đội nữa.
Dialogue: 0,0:10:14.37,0:10:16.17,Default,ROGER,0,0,0,,Chắc hẳn thời gian qua cậu vất vả lắm nhỉ.
Dialogue: 0,0:10:17.94,0:10:21.95,Default,LENT,0,0,0,,Xin lỗi vì làm mất vui mọi người nhé.
Dialogue: 0,0:10:22.46,0:10:25.05,Default,NAMILIA,0,0,0,,Dù sao đi nữa, bọn họ đối xử quá tệ bạc.
Dialogue: 0,0:10:25.05,0:10:27.81,Default,NAMILIA,0,0,0,,Gắn bó với nhau tận năm năm trời,\Nthế mà nỡ lòng nào đuổi em đi cái rụp vậy?
Dialogue: 0,0:10:27.81,0:10:32.37,Default,ROGER,0,0,0,,Dạo này tôi chẳng nghe thấy tin tức gì tốt lành\Nvề lũ ngu ngốc đó cả.
Dialogue: 0,0:10:32.37,0:10:35.56,Default,ROGER,0,0,0,,Chắc là vận may của bọn chúng cạn sạch\Nkể từ ngày đá cậu đi rồi.
Dialogue: 0,0:10:35.80,0:10:39.81,Default,ROGER,0,0,0,,Kỹ năng của cậu giúp cho đồng đội\Nvay MP, đúng chứ?
Dialogue: 0,0:10:39.81,0:10:43.82,Default,ROGER,0,0,0,,Xem ra lũ đó quên sạch mất việc mình đã\Nphải dựa dẫm vào nó tới mức nào rồi.
Dialogue: 0,0:10:44.14,0:10:47.62,Default,NAMILIA,0,0,0,,Chính cậu góp công đưa họ thành tổ đội\Nlên hạng B nhanh nhất lịch sử còn gì.
Dialogue: 0,0:10:47.62,0:10:50.34,Default,ROGER,0,0,0,,Phải đấy. Bảo sao đám đó lại ảo tưởng\Nrồi tự cao tự đại lên tận mây xanh.
Dialogue: 0,0:10:50.55,0:10:55.08,Default,LENT,0,0,0,,Giờ ngẫm lại thì có lẽ chính em\Ncũng đã ỷ lại vào họ.
Dialogue: 0,0:10:55.50,0:10:59.72,Default,LENT,0,0,0,,Em từng nghĩ chỉ cần đứng tuyến sau\Nvà dùng kỹ năng là đủ đi thám hiểm rồi.
Dialogue: 0,0:10:59.72,0:11:03.22,Default,LENT,0,0,0,,Em chưa từng nghĩ đến việc tự mình mở lối đi riêng.
Dialogue: 0,0:11:04.10,0:11:06.76,Default,LENT,0,0,0,,Bị họ đuổi đi cũng chẳng có gì lạ.
Dialogue: 0,0:11:06.76,0:11:09.83,Default,LENT,0,0,0,,Hồi đó em thật sự quá vô dụng mà.
Dialogue: 0,0:11:10.68,0:11:13.11,Default,ROGER,0,0,0,,Lent à, cậu rắn rỏi lên nhiều rồi đấy.
Dialogue: 0,0:11:13.11,0:11:14.86,Default,LENT,0,0,0,,Hả? Anh thấy thế thật sao?
Dialogue: 0,0:11:14.86,0:11:16.94,Default,NAMILIA,0,0,0,,Ừ, đương nhiên rồi.
Dialogue: 0,0:11:17.33,0:11:21.87,Default,NAMILIA,0,0,0,,Nhưng chị không đồng ý chuyện em tự nhận\Nmình trước đây vô dụng đâu nhé.
Dialogue: 0,0:11:23.37,0:11:27.37,Default,NAMILIA,0,0,0,,Em có nhớ lần đầu tụi mình gặp nhau thế nào không?
Dialogue: 0,0:11:27.37,0:11:32.99,Default,LENT,0,0,0,,Có ạ. Là từ hồi chị vẫn chưa gia nhập\Ntổ đội Meteor Shower.
Dialogue: 0,0:11:33.44,0:11:34.76,Default,NAMILIA,0,0,0,,Đúng rồi đấy.
Dialogue: 0,0:11:34.76,0:11:38.62,Default,NAMILIA,0,0,0,,Lúc đó chị đang ngồi ở một quán rượu hội quán\Nnáo nhiệt hệt như thế này.
Dialogue: 0,0:11:39.01,0:11:44.14,Default,NAMILIA,0,0,0,,Thật ra hôm ấy chị vừa mới bỏ tổ đội cũ xong.
Dialogue: 0,0:11:44.14,0:11:47.67,Default,NAMILIA,0,0,0,,Trong lúc cãi vã nảy lửa, chị đã quát vào mặt họ\Nrằng chính họ đang kìm chân chị.
Dialogue: 0,0:11:47.67,0:11:49.93,Default,NAMILIA,0,0,0,,Chị tính uống rượu giải sầu cho hả giận, đúng lúc đó...
Dialogue: 0,0:11:50.92,0:11:52.70,Flashback,NAMILIA,0,0,0,,Chỗ này có ai ngồi chưa?
Dialogue: 0,0:11:52.70,0:11:53.94,Flashback,LENT,0,0,0,,Chưa ạ, mời chị cứ tự nhiên.
Dialogue: 0,0:11:55.18,0:11:57.52,Flashback,NAMILIA,0,0,0,,Tôi là Namilia. Cậu tên gì thế?
Dialogue: 0,0:11:57.87,0:11:58.94,Flashback,LENT,0,0,0,,Lent ạ.
Dialogue: 0,0:11:59.27,0:12:02.45,Flashback,NAMILIA,0,0,0,,Tôi vừa mới đi chinh phục mê cung về.\NCòn cậu thì sao?
Dialogue: 0,0:12:02.45,0:12:03.95,Flashback,LENT,0,0,0,,Tôi cũng vậy.
Dialogue: 0,0:12:04.21,0:12:08.50,Flashback,NAMILIA,0,0,0,,Thật á? Nhìn cậu chẳng giống dân đánh đấm\Nchút nào cả.
Dialogue: 0,0:12:09.12,0:12:12.51,Flashback,LENT,0,0,0,,Đúng thế. Tôi thuộc hệ hỗ trợ.
Dialogue: 0,0:12:12.92,0:12:15.88,Flashback,NAMILIA,0,0,0,,Vậy tức là cậu để đồng đội gánh mình à?
Dialogue: 0,0:12:16.46,0:12:20.91,Flashback,NAMILIA,0,0,0,,Tôi cũng thuộc hệ hỗ trợ đây,\Nnhưng tôi luôn cố hết sức để tự mạnh lên.
Dialogue: 0,0:12:21.33,0:12:23.95,Flashback,NAMILIA,0,0,0,,Cậu không nghĩ mình cũng nên làm thế sao?
Dialogue: 0,0:12:24.22,0:12:28.47,Flashback,LENT,0,0,0,,Đương nhiên bản thân mạnh lên được thì tốt quá rồi,
Dialogue: 0,0:12:28.47,0:12:31.13,Flashback,LENT,0,0,0,,nhưng kỹ năng của tôi sinh ra là để giúp\Nđồng đội mạnh mẽ hơn.
Dialogue: 0,0:12:31.13,0:12:35.68,Flashback,LENT,0,0,0,,Tôi thà giúp họ trở nên hùng mạnh\Ncòn hơn là chỉ biết mạnh cho riêng mình.
Dialogue: 0,0:12:35.68,0:12:38.23,Flashback,LENT,0,0,0,,Suy cho cùng, hỗ trợ họ mới là công việc của tôi mà.
Dialogue: 0,0:12:41.73,0:12:47.19,Default,NAMILIA,0,0,0,,Lúc đó chị mới chợt bừng tỉnh rằng không phải\Nlỗi do đồng đội khiến mọi chuyện đổ vỡ.
Dialogue: 0,0:12:47.77,0:12:54.60,Default,NAMILIA,0,0,0,,Lời nói của em giúp chị nhận ra trước giờ mình chỉ biết\Ndùng phép cường hóa ích kỷ cho bản thân thôi.
Dialogue: 0,0:12:55.43,0:12:59.95,Default,NAMILIA,0,0,0,,Vậy nên đừng có gọi bản thân mình ngày xưa\Nlà vô dụng nữa nhé, Lent.
Dialogue: 0,0:13:00.25,0:13:01.96,Default,LENT,0,0,0,,Em cảm ơn chị.
Dialogue: 0,0:13:02.37,0:13:05.90,Default,NAMILIA,0,0,0,,Mà công nhận, đem so với em thì,
Dialogue: 0,0:13:05.90,0:13:08.67,Default,NAMILIA,0,0,0,,đội trưởng nhà chị vẫn trẻ con hết chỗ nói.
Dialogue: 0,0:13:08.67,0:13:09.97,Default,ROGER,0,0,0,,Nói xấu tôi đấy à?
Dialogue: 0,0:13:10.17,0:13:12.73,Default,NAMILIA,0,0,0,,Hôm nọ, ngay sau khi cả đội vừa\Nhạ gục xong con wyvern...
Dialogue: 0,0:13:12.73,0:13:17.90,Default,LENT,0,0,0,,W-Wyvern cơ ạ? Chẳng phải bọn đó tận\Ntầng 8 của mê cung mới xuất hiện sao?
Dialogue: 0,0:13:17.90,0:13:21.23,Default,ROGER,0,0,0,,Bọn tôi đang trong quá trình chinh phục\Ntầng 8 đây.
Dialogue: 0,0:13:21.23,0:13:26.49,Default,LENT,0,0,0,,K-Kinh khủng thật đấy. Khu vực đó\Nlúc nhúc toàn rồng hung dữ mà.
Dialogue: 0,0:13:26.49,0:13:30.89,Top,ROGER,0,0,0,,Mấy con thằn lằn đó chẳng có cửa đấu lại\Nvới tôi đâu.
Dialogue: 0,0:13:27.01,0:13:32.10,Italic,LENT/ID,0,0,0,,Anh Roger và chị Namilia rõ ràng đẳng cấp\Nvượt xa mình cả một trời một vực,
Dialogue: 0,0:13:30.89,0:13:33.49,Top,NAMILIA,0,0,0,,Thế mà lúc hạ con wyvern xong,
Dialogue: 0,0:13:32.10,0:13:35.49,Italic,LENT/ID,0,0,0,,nhưng họ vẫn háo hức kể chuyện phiêu lưu\Ncho mình nghe vui vẻ như thế này.
Dialogue: 0,0:13:33.49,0:13:37.50,Top,NAMILIA,0,0,0,,Roger gây ra một trận náo loạn kinh thiên động địa\Nlúc cả nhóm đang thu thập nguyên liệu.
Dialogue: 0,0:13:35.49,0:13:37.50,Italic,LENT/ID,0,0,0,,Cảm giác cứ như bọn mình là bạn bè thật sự vậy.
Dialogue: 0,0:13:37.80,0:13:41.51,Italic,LENT/ID,0,0,0,,Phải rồi. Đây chính là mẫu mạo hiểm giả\Nmà mình hằng mơ ước trở thành.
Dialogue: 0,0:13:41.76,0:13:46.71,Default,ROGER,0,0,0,,Dù sao thì lần tới bọn tôi dự định sẽ hoàn tất\Nchinh phục tầng 8.
Dialogue: 0,0:13:46.71,0:13:48.26,Default,LENT,0,0,0,,Nghĩa là...
Dialogue: 0,0:13:49.14,0:13:53.26,Default,ROGER,0,0,0,,Mục tiêu của bọn tôi là tầng cuối cùng\Ncủa Mê Cung Melva.
Dialogue: 0,0:13:53.44,0:13:55.17,Italic,LENT/ID,0,0,0,,Tầng cuối cùng sao...
Dialogue: 0,0:13:55.17,0:13:58.27,Italic,LENT/ID,0,0,0,,Điểm đến tối thượng trong mơ\Ncủa biết bao mạo hiểm giả.
Dialogue: 0,0:13:58.27,0:14:02.04,Default,ROGER,0,0,0,,Mà tiện thể hỏi, cái mê cung đó\Ncó tổng cộng bao nhiêu tầng nhỉ?
Dialogue: 0,0:14:02.04,0:14:04.78,Default,NAMILIA,0,0,0,,Chẳng ai biết chính xác cả.
Dialogue: 0,0:14:04.78,0:14:08.79,Default,ROGER,0,0,0,,Thế thì chính bọn tôi sẽ là những người đầu tiên\Nkhám phá trọn vẹn bí mật của mê cung.
Dialogue: 0,0:14:09.14,0:14:12.49,Default,LENT,0,0,0,,À phải rồi. Thật ra em cũng có\Nmột chuyện muốn báo tin với mọi người.
Dialogue: 0,0:14:14.34,0:14:16.60,Default,ROGER,0,0,0,,Cậu lập tổ đội mới rồi à?
Dialogue: 0,0:14:16.60,0:14:17.50,Default,LENT,0,0,0,,Vâng ạ.
Dialogue: 0,0:14:17.50,0:14:18.29,Default,NAMILIA,0,0,0,,Thật hả em?
Dialogue: 0,0:14:18.60,0:14:22.54,Default,LENT,0,0,0,,Em lập đội cùng một cô gái tên Linka,\Ncũng từng bị tổ đội cũ ruồng bỏ giống em.
Dialogue: 0,0:14:22.54,0:14:24.66,Default,ROGER,0,0,0,,Cô bé đó à?
Dialogue: 0,0:14:27.06,0:14:29.21,Default,ROGER,0,0,0,,Nếu vậy thì...
Dialogue: 0,0:14:29.69,0:14:31.82,Default,ROGER,0,0,0,,từ giờ chúng ta là đối thủ của nhau rồi nhé.
Dialogue: 0,0:14:32.42,0:14:36.06,Default,LENT,0,0,0,,Vâng. Em rất mong chờ ngày đó ạ.
Dialogue: 0,0:14:37.31,0:14:39.67,Default,LENT,0,0,0,,Cảm ơn anh vì chầu nhậu hôm nay nhé, anh Roger.
Dialogue: 0,0:14:39.67,0:14:40.48,Default,ROGER,0,0,0,,Có gì đâu mà.
Dialogue: 0,0:14:41.46,0:14:45.23,Default,NAMILIA,0,0,0,,Tiếc ghê, tụi mình lỡ mất cơ hội ngỏ lời mời em ấy rồi.
Dialogue: 0,0:14:45.23,0:14:51.74,Default,ROGER,0,0,0,,Người ta vừa mới lập tổ đội mới tinh xong,\Nsao mở miệng rủ về Meteor Shower được chứ, đồ ngốc.
Dialogue: 0,0:14:52.16,0:14:53.24,Default,ROGER,0,0,0,,Vả lại...
Dialogue: 0,0:14:53.28,0:14:57.24,Signs,SIGN,0,0,0,,{\fad(400,000)\shad1\bord2\p1\alpha&H50&\c&HFFFFFF&\3c&H000000&\4c&HB7B7B7&\fscx49\fscy35\pos(317.527,232.054)}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:14:53.28,0:14:57.24,Signs,SIGN,0,0,0,,{\fad(400,000)\bord0\fs13\c&H151515&\fnSegoe UI\pos(317.804,239.497)}Hai Năm Trước
Dialogue: 0,0:14:54.93,0:14:57.24,Flashback,ROGER,0,0,0,,Bọn tôi sắp rời khỏi đây một thời gian.
Dialogue: 0,0:14:57.82,0:15:02.12,Flashback,ROGER,0,0,0,,Đợi khi nào đủ mạnh để đánh tầng 8\Nthì bọn tôi sẽ quay lại.
Dialogue: 0,0:15:02.53,0:15:04.50,Flashback,LENT,0,0,0,,Chắc em sẽ nhớ mọi người lắm đây.
Dialogue: 0,0:15:07.97,0:15:10.23,Flashback,ROGER,0,0,0,,Nên tôi có chuyện này muốn đề nghị với cậu.
Dialogue: 0,0:15:10.23,0:15:11.46,Flashback,LENT,0,0,0,,Chuyện gì thế anh?
Dialogue: 0,0:15:11.78,0:15:13.94,Flashback,ROGER,0,0,0,,Cậu có muốn gia nhập Meteor Shower không?
Dialogue: 0,0:15:13.94,0:15:15.56,Flashback,LENT,0,0,0,,Hả, em á?
Dialogue: 0,0:15:16.25,0:15:20.58,Flashback,LENT,0,0,0,,Em rất cảm kích lời mời của anh.\NĐó đúng là vinh hạnh quá lớn đối với em.
Dialogue: 0,0:15:20.58,0:15:25.54,Flashback,LENT,0,0,0,,Nhưng em đã gắn bó với tổ đội hiện tại\Ntừ ngày chập chững làm mạo hiểm giả rồi.
Dialogue: 0,0:15:25.89,0:15:30.93,Flashback,LENT,0,0,0,,Em không thể bỏ rơi họ để sang đội khác được.
Dialogue: 0,0:15:34.06,0:15:39.78,Default,ROGER,0,0,0,,Ngay cả khi bị đối xử tệ bạc thế nào,\Ncậu ta cũng không nỡ bỏ rơi Skypiercers.
Dialogue: 0,0:15:39.78,0:15:42.00,Default,ROGER,0,0,0,,Hồi đó có hỏi cũng bằng thừa thôi.
Dialogue: 0,0:15:42.00,0:15:46.93,Default,NAMILIA,0,0,0,,Hay mình chiêu mộ cả em ấy lẫn\Ncô bé đồng đội mới luôn đi?
Dialogue: 0,0:15:47.25,0:15:51.67,Default,ROGER,0,0,0,,Trước đây tôi từng có một thằng bạn nhậu\Nlàm nghề cho vay nặng lãi.
Dialogue: 0,0:15:52.16,0:15:56.96,Default,ROGER,0,0,0,,Nó chẳng tin tưởng bất kỳ ai nữa,\Nvà bắt đầu giở trò bóc lột cắt cổ.
Dialogue: 0,0:15:56.96,0:16:00.07,Default,ROGER,0,0,0,,Kết cục là đi tới đâu cũng rước đầy kẻ thù\Ncăm hận thấu xương.
Dialogue: 0,0:16:00.07,0:16:03.68,Default,ROGER,0,0,0,,Cuối cùng, nó bị một gã nào đó xiên chết tươi.
Dialogue: 0,0:16:04.14,0:16:06.78,Default,ROGER,0,0,0,,Thiên phú của Lent là Cho Vay Ma Lực.
Dialogue: 0,0:16:06.78,0:16:10.16,Default,ROGER,0,0,0,,Với nhiều kẻ, thứ đó còn hấp dẫn\Nhơn cả việc đi vay tiền bạc ấy chứ.
Dialogue: 0,0:16:10.96,0:16:13.98,Default,ROGER,0,0,0,,Tôi đã lo chuyện bị đuổi khỏi đội sẽ khiến cậu ta\Nmất hết niềm tin vào lòng người,
Dialogue: 0,0:16:13.98,0:16:17.35,Default,ROGER,0,0,0,,rồi trượt dài theo vết xe đổ đó...
Dialogue: 0,0:16:18.40,0:16:20.71,Default,ROGER,0,0,0,,nhưng giờ cậu ta đã tìm được đồng đội mới rồi.
Dialogue: 0,0:16:21.02,0:16:25.25,Default,ROGER,0,0,0,,Cậu ta sẽ ổn thôi, khỏi cần gia nhập với tụi mình đâu... hả?
Dialogue: 0,0:16:26.66,0:16:29.98,Default,NAMILIA,0,0,0,,Lent này, hay lát nữa tụi mình đi uống thêm\Ntăng nữa đi?
Dialogue: 0,0:16:29.98,0:16:33.51,Default,LENT,0,0,0,,Em xin lỗi. Linka đang chờ em\Nở nhà trọ rồi ạ.
Dialogue: 0,0:16:33.51,0:16:37.04,Default,LENT,0,0,0,,Đi muộn quá cô ấy sẽ lo lắng mất.
Dialogue: 0,0:16:37.04,0:16:41.04,Default,NAMILIA,0,0,0,,Ồ? Giờ em mê mẩn cô bé Linka đó luôn rồi hả?
Dialogue: 0,0:16:41.04,0:16:44.71,Default,LENT,0,0,0,,Không có đâu ạ. Bọn em là đồng đội thôi,\Nkhông phải mối quan hệ kiểu đó.
Dialogue: 0,0:16:46.73,0:16:50.25,Default,NAMILIA,0,0,0,,Chà, nếu chỉ qua lại cho vui thì chị cũng chẳng ngại đâu nhé.
Dialogue: 0,0:16:50.78,0:16:52.89,Default,ROGER,0,0,0,,Tha cho thằng Lent giùm tôi cái đi!
Dialogue: 0,0:16:53.28,0:16:57.37,Default,NAMILIA,0,0,0,,Gì chứ? Em chỉ rủ Lent đi uống thêm chút\Nthôi mà.
Dialogue: 0,0:16:57.66,0:17:00.88,Default,ROGER,0,0,0,,Mà này Lent, sao cậu lại đi lối này thế?
Dialogue: 0,0:17:00.88,0:17:03.47,Default,NAMILIA,0,0,0,,Nhà trọ của em cùng hướng với tụi chị à?
Dialogue: 0,0:17:04.29,0:17:08.28,Default,LENT,0,0,0,,Thật ra em đang có một chuyện muốn nhờ\NTổ đội Meteor Shower ạ.
Dialogue: 0,0:17:10.80,0:17:15.12,Default,EMPEE,0,0,0,,Quả nhiên đúng như em dự liệu, bọn chúng đã mò tới\Nchính xác sau ba tuần.
Dialogue: 0,0:17:15.12,0:17:19.55,Default,EMPEE,0,0,0,,Phải mau bảo Chủ nhân mua ngay {\i1}thứ đó{\i0}\Nmới được.
Dialogue: 0,0:17:19.55,0:17:25.64,Default,EMPEE,0,0,0,,Cây Thế Giới Yggdrasil nắm rõ từng chân tơ kẽ tóc\Nvề đám con nợ của ngài ấy mà.
Dialogue: 0,0:17:35.50,0:17:38.94,Default,LINKA,0,0,0,,Mấy xiên này ngon tuyệt luôn ạ.
Dialogue: 0,0:17:38.99,0:17:41.45,Signs,SIGN,0,0,0,,{\fad(400,000)\shad1\bord2\p1\alpha&H50&\c&HFFFFFF&\3c&H000000&\4c&HB7B7B7&\pos(318.527,175.054)\fscx96\fscy44}m 0 0 l 268 0 268 88 0 88
Dialogue: 0,0:17:38.99,0:17:41.45,Signs,SIGN,0,0,0,,{\fad(400,000)\bord0\fs13\c&H151515&\fnSegoe UI\pos(318.804,174.497)}Xúc Xích Chiên Melva\NTrong: Xúc xích Cuồng Ngưu\NNgoài: Bột chiên giòn
Dialogue: 0,0:17:41.76,0:17:44.96,Default,EMPEE,0,0,0,,Đặc sản trứ danh của hội quán địa phương đây mà.
Dialogue: 0,0:17:44.96,0:17:47.45,Default,EMPEE,0,0,0,,Vỏ làm bằng bột chiên giòn,\Nđúng chuẩn gu của em luôn đấy.
Dialogue: 0,0:17:47.45,0:17:50.88,Default,LINKA,0,0,0,,Cứ dùng xong Đòn Đánh Khởi Đầu là\Nem lại đói cồn cào ruột gan.
Dialogue: 0,0:17:50.88,0:17:52.97,Default,LINKA,0,0,0,,Đói tới mức nuốt chửng cả con ngựa cũng được luôn.
Dialogue: 0,0:17:53.21,0:17:57.71,Default,EMPEE,0,0,0,,Tốt lắm. Người ta bảo trẻ nhỏ ăn khỏe\Nmới mau ăn chóng lớn được.
Dialogue: 0,0:17:57.71,0:17:59.97,Default,LENT,0,0,0,,Empee cũng ăn khỏe lắm còn gì.
Dialogue: 0,0:17:59.97,0:18:04.41,Default,EMPEE,0,0,0,,Mà này cô Linka, chẳng phải cô có tin vui\Ncần báo với Chủ nhân hay sao?
Dialogue: 0,0:18:04.41,0:18:06.10,Default,LINKA,0,0,0,,À, đúng rồi nhỉ.
Dialogue: 0,0:18:06.10,0:18:13.32,Signs,SIGN,0,0,0,,{\fad(500,000)\fnSegoe UI\bord0\fs16\c&H000000&\frz3.119\pos(185,115)}Linka
Dialogue: 0,0:18:06.10,0:18:13.32,Signs,SIGN,0,0,0,,{\fad(500,000)\fnSegoe UI\bord0\fs16\c&H000000&\frz2.771\pos(158,148)}Tu La\NĐạo
Dialogue: 0,0:18:06.10,0:18:13.32,Signs,SIGN,0,0,0,,{\fad(500,000)\fnSegoe UI\bord0\fs10\c&H000000&\frz2.771\pos(244,194)}Hạng Mạo Hiểm Giả: E
Dialogue: 0,0:18:06.10,0:18:13.32,Signs,SIGN,0,0,0,,{\fad(500,000)\fnSegoe UI\bord0\fs10\c&H000000&\frz2.771\pos(247,216)}Tổ đội: Twice Exceptional
Dialogue: 0,0:18:06.68,0:18:10.64,Default,LINKA,0,0,0,,Tính từ hôm nay, hạng mạo hiểm giả của em đã được thăng cấp.
Dialogue: 0,0:18:10.64,0:18:12.36,Default,LINKA,0,0,0,,Giờ em lên hạng E rồi đấy ạ.
Dialogue: 0,0:18:13.31,0:18:17.36,Default,LENT,0,0,0,,Chà, mới có bốn ngày mà thăng hạng luôn rồi à.
Dialogue: 0,0:18:17.36,0:18:21.80,Default,LINKA,0,0,0,,Vâng. Giới hạn MP tối đa của em cũng tăng lên 24 rồi.
Dialogue: 0,0:18:22.51,0:18:28.54,Default,LINKA,0,0,0,,Thật không ngờ có ngày em lại tự tin đi thám hiểm\Nbằng chính thiên phú mà mình từng căm ghét.
Dialogue: 0,0:18:28.95,0:18:31.47,Default,LINKA,0,0,0,,Tất cả đều nhờ anh Lent cả đấy ạ.
Dialogue: 0,0:18:31.76,0:18:36.47,Default,LENT,0,0,0,,Cho tới tận gần đây, chính anh cũng từng\Ncảm thấy y hệt vậy về thiên phú của mình đấy.
Dialogue: 0,0:18:38.06,0:18:43.23,Default,EMPEE,0,0,0,,Vậy để em tặng cô một món quà\Năn mừng sự kiện này nhé.
Dialogue: 0,0:18:43.23,0:18:44.32,Default,LINKA,0,0,0,,Thật sao?
Dialogue: 0,0:18:44.32,0:18:49.23,Default,EMPEE,0,0,0,,Đây là phần vỏ giòn rụm trên que Xúc Xích Chiên Melva\Nmà cô vừa ăn nham nhở bỏ lại đó.
Dialogue: 0,0:18:49.43,0:18:53.14,Default,EMPEE,0,0,0,,Phần ngon nhất trên cả que luôn đấy.
Dialogue: 0,0:18:53.14,0:18:54.22,Default,LINKA,0,0,0,,Ra là vậy.
Dialogue: 0,0:18:54.22,0:18:58.73,Default,EMPEE,0,0,0,,Thật ra toàn bộ phần xúc xích phía trên\Nchỉ là màn dạo đầu cho miếng này thôi!
Dialogue: 0,0:19:04.09,0:19:06.83,Default,LINKA,0,0,0,,Thơm phức mà giòn ngon quá trời luôn!
Dialogue: 0,0:19:06.83,0:19:08.35,Default,EMPEE,0,0,0,,Đúng không nào?
Dialogue: 0,0:19:16.92,0:19:18.58,Default,LINKA,0,0,0,,M-Mấy người làm cái trò gì thế?
Dialogue: 0,0:19:18.86,0:19:21.34,Default,GUY,0,0,0,,Này, Lent. Bọn tao lùng sục tìm mày mãi đấy.
Dialogue: 0,0:19:21.56,0:19:24.97,Default,LENT,0,0,0,,Các người còn muốn gì nữa?\NTưởng đã dứt tình với tôi rồi cơ mà.
Dialogue: 0,0:19:24.97,0:19:27.19,Default,GUY,0,0,0,,Đừng có giả ngu!
Dialogue: 0,0:19:28.92,0:19:32.92,Default,MISA,0,0,0,,Chính cậu đã giở trò ăn cắp MP của bọn tôi.
Dialogue: 0,0:19:32.92,0:19:35.09,Default,MISA,0,0,0,,Mọi chuyện đều do một tay cậu giật dây, đúng không?
Dialogue: 0,0:19:35.44,0:19:38.57,Default,LENT,0,0,0,,Ăn cắp á? Chính các người mới là kẻ\Năn cướp của tôi đấy.
Dialogue: 0,0:19:39.56,0:19:43.44,Default,LENT,0,0,0,,Tôi đâu có cho không đống MP đó.\NTôi chỉ cho các người vay thôi.
Dialogue: 0,0:19:43.82,0:19:50.08,Default,LENT,0,0,0,,Tại các người chẳng có dấu hiệu gì sẽ trả lại,\Nnên tôi đành cưỡng chế thu hồi đấy.
Dialogue: 0,0:19:50.55,0:19:52.03,Default,GUY,0,0,0,,Thằng khốn kiếp...
Dialogue: 0,0:19:53.20,0:19:54.92,Default,MISA,0,0,0,,Con nhãi nhà ngươi rốt cuộc là ai?
Dialogue: 0,0:19:55.50,0:19:59.16,Default,LINKA,0,0,0,,Tôi là đồng đội cùng đi thám hiểm với anh Lent.
Dialogue: 0,0:19:59.49,0:20:01.67,Default,MISA,0,0,0,,Nhìn chằm chằm cái thái độ gì thế hả?
Dialogue: 0,0:20:02.44,0:20:04.72,Default,MISA,0,0,0,,Con nhỏ này chọc điên tao rồi đấy.
Dialogue: 0,0:20:04.72,0:20:05.69,Default,LENT,0,0,0,,Dừng tay lại!
Dialogue: 0,0:20:05.69,0:20:06.35,Default,GUY,0,0,0,,Ồ?
Dialogue: 0,0:20:06.35,0:20:07.75,Default,GUY,0,0,0,,Muốn đánh nhau đấy à?
Dialogue: 0,0:20:08.59,0:20:11.95,Default,ROGER,0,0,0,,Thôi nào, thôi nào. Nếu muốn đánh đấm\Nthì kéo nhau ra ngoài kia mà giải quyết.
Dialogue: 0,0:20:11.95,0:20:13.78,Default,GUY,0,0,0,,Ồ, anh Roger...
Dialogue: 0,0:20:13.78,0:20:15.76,Default,ROGER,0,0,0,,Chán thật đấy.
Dialogue: 0,0:20:15.76,0:20:17.77,Default,ROGER,0,0,0,,Nhìn đống hỗn độn các cậu vừa bày ra xem kìa.
Dialogue: 0,0:20:18.11,0:20:20.70,Default,ROGER,0,0,0,,Phí phạm hết cả đồ ăn ngon.
Dialogue: 0,0:20:20.70,0:20:22.27,Default,GUY,0,0,0,,Anh Roger phải nghe chuyện này mới được!
Dialogue: 0,0:20:22.72,0:20:26.85,Default,GUY,0,0,0,,Thằng ngu này cứ giở thứ ma thuật quái đản\Nra hành hạ bọn em suốt đấy!
Dialogue: 0,0:20:26.85,0:20:28.14,Default,ROGER,0,0,0,,Ma thuật quái đản á?
Dialogue: 0,0:20:28.14,0:20:30.71,Default,MISA,0,0,0,,Hắn ăn trộm MP của bọn em đấy!
Dialogue: 0,0:20:30.71,0:20:34.65,Default,ELLE,0,0,0,,Hắn trả thù vì bọn em đuổi hắn ra khỏi đội!
Dialogue: 0,0:20:34.65,0:20:37.66,Default,ROGER,0,0,0,,Chẳng phải trước giờ các cậu vẫn vay MP của Lent\Nđể đi thám hiểm sao?
Dialogue: 0,0:20:37.66,0:20:40.71,Default,ROGER,0,0,0,,Và dùng chính sức mạnh đó để đánh quái, đúng chứ?
Dialogue: 0,0:20:41.10,0:20:44.50,Default,ROGER,0,0,0,,Có vay thì phải có trả.\NLẽ đời xưa nay vẫn thế mà.
Dialogue: 0,0:20:44.50,0:20:46.58,Default,GUY,0,0,0,,Thì đúng vậy, nhưng mà...
Dialogue: 0,0:20:46.58,0:20:50.49,Default,MISA,0,0,0,,Nhưng hắn tự ý rút lại mà chẳng thèm hỏi bọn em tiếng nào!
Dialogue: 0,0:20:50.49,0:20:51.92,Default,ROGER,0,0,0,,Thật vậy sao?
Dialogue: 0,0:20:51.92,0:20:55.30,Default,LENT,0,0,0,,Vâng, tại thái độ của họ quá đỗi tráo trở ạ.
Dialogue: 0,0:20:56.44,0:21:01.48,Default,ROGER,0,0,0,,Ra thế. Đòi nợ gắt gao quá đà\Ncũng dễ sinh ra lắm chuyện phiền phức nhỉ.
Dialogue: 0,0:21:02.42,0:21:05.45,Default,ROGER,0,0,0,,Vậy thì thế này đi?
Dialogue: 0,0:21:06.95,0:21:10.95,Default,ROGER,0,0,0,,Các cậu hãy quyết đấu tay đôi để giải quyết dứt điểm chuyện này.

