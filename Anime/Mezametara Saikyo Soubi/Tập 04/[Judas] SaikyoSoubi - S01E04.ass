Dialogue: 0,0:02:56.11,0:03:00.07,Signs,EPTITLE,0,0,0,,{\fad(736,888)\fnVerdana\c&HFFFFFF&\shad2\b0\blur3\t(27,736,\blur0.2)\t(3072,3947,\blur3)\pos(105,262)}Cuộc Sống Thường Nhật Mới
Dialogue: 0,0:03:09.05,0:03:10.89,DefaultItalics,PIRATE A,0,0,0,,Một mẻ lớn đấy chứ.
Dialogue: 0,0:03:10.89,0:03:13.67,DefaultItalics,PIRATE A,0,0,0,,Bảo sao mà ta không thể bỏ nghề hải tặc được.
Dialogue: 0,0:03:13.67,0:03:14.50,DefaultItalics,PIRATE B,0,0,0,,Phát hiện nguồn nhiệt đang tiếp cận!
Dialogue: 0,0:03:14.50,0:03:15.74,DefaultItalics,PIRATE A,0,0,0,,Cái gì?
Dialogue: 0,0:03:24.34,0:03:26.89,Default,HIRO,0,0,0,,Và tôi cũng không thể bỏ nghề lính đánh thuê được.
Dialogue: 0,0:03:32.48,0:03:34.54,DefaultItalics,PIRATE A,0,0,0,,Lính đánh thuê sao? Khốn kiếp!
Dialogue: 0,0:03:34.54,0:03:35.67,DefaultItalics,PIRATE A,0,0,0,,Bọn chúng phục kích ta!
Dialogue: 0,0:03:35.67,0:03:36.72,DefaultItalics,PIRATE C,0,0,0,,Mau rút lui thôi!
Dialogue: 0,0:03:37.77,0:03:40.08,Default,MIMI,0,0,0,,Chiến hạm địch đang tản ra!
Dialogue: 0,0:03:40.08,0:03:41.94,Default,ELMA,0,0,0,,Chạy cũng nhanh đấy.
Dialogue: 0,0:03:41.94,0:03:43.14,Default,HIRO,0,0,0,,Đừng hòng thoát khỏi tay tôi.
Dialogue: 0,0:03:50.16,0:03:52.69,DefaultItalics,PIRATE A,0,0,0,,K-Không thể nào! Lũ điên này!
Dialogue: 0,0:03:53.38,0:03:54.65,DefaultItalics,PIRATE B,0,0,0,,D-Dừng lại đi!
Dialogue: 0,0:03:54.65,0:03:56.47,DefaultItalics,PIRATE C,0,0,0,,Lũ cầm thú!
Dialogue: 0,0:03:59.70,0:04:03.04,Default,MIMI,0,0,0,,Toàn bộ chiến hạm địch đã ngừng hoạt động.
Dialogue: 0,0:04:03.04,0:04:04.43,Default,HIRO,0,0,0,,Xong việc.
Dialogue: 0,0:04:04.43,0:04:06.89,Default,HIRO,0,0,0,,Trước hỏa lực của Krishna, \Nbọn chúng không có lấy một cơ hội.
Dialogue: 0,0:04:06.89,0:04:09.86,Default,ELMA,0,0,0,,Dù sao thì, tay nghề của cậu cũng khá đấy.
Dialogue: 0,0:04:09.86,0:04:13.07,Default,ELMA,0,0,0,,Cậu làm chủ được con tàu phi thường này,
Dialogue: 0,0:04:13.07,0:04:15.72,Default,ELMA,0,0,0,,lại còn rất giỏi mấy đòn phục kích \Nvới đánh úp bất ngờ nữa.
Dialogue: 0,0:04:15.72,0:04:17.61,Default,HIRO,0,0,0,,Chắc là do thiên phú bẩm sinh đấy.
Dialogue: 0,0:04:17.61,0:04:22.68,Default,HIRO,0,0,0,,Lạ là cứ đụng tới mấy vụ chiến đấu \Nlà tôi lại thấy quen tay đến kỳ lạ.
Dialogue: 0,0:04:24.09,0:04:26.41,Default,ELMA,0,0,0,,Cậu cứ khéo tự sướng.
Dialogue: 0,0:04:26.41,0:04:29.67,Default,HIRO,0,0,0,,Nào, thu gom chiến lợi phẩm rồi tìm \Nmục tiêu tiếp theo thôi.
Dialogue: 0,0:04:34.08,0:04:38.04,DefaultItalicsTop,ANNOUNCE,0,0,0,,Ghi nhận chiến công và lĩnh thưởng \Ntại quầy tiếp nhận...
Dialogue: 0,0:04:36.66,0:04:38.86,Default,GUILD RECEPTIONIST,0,0,0,,Anh đã tiêu diệt 70 chiến hạm hải tặc không gian.
Dialogue: 0,0:04:38.86,0:04:44.75,Default,GUILD RECEPTIONIST,0,0,0,,Tổng tiền thưởng truy nã, \Ntiền công thảo phạt và vật tư thu hồi
Dialogue: 0,0:04:44.75,0:04:48.43,Default,GUILD RECEPTIONIST,0,0,0,,là 1,8 triệu Enel.
Dialogue: 0,0:04:48.73,0:04:50.58,Default,MIMI,0,0,0,,Tuyệt quá đi ạ.
Dialogue: 0,0:04:50.58,0:04:53.17,Default,ELMA,0,0,0,,Một tuần mà kiếm chừng đó là khá lắm rồi.
Dialogue: 0,0:04:53.54,0:04:58.49,Default,HIRO,0,0,0,,Ừ. Vẫn còn vài tên nhát gan trốn thoát khỏi \Nchiến dịch thảo phạt quy mô lớn vừa rồi,
Dialogue: 0,0:04:58.49,0:05:02.74,Default,HIRO,0,0,0,,nhưng lũ hải tặc mang món tiền thưởng kếch xù \Nthì vẫn còn lảng vảng quanh đây.
Dialogue: 0,0:05:02.74,0:05:04.90,Default,HIRO,0,0,0,,Đây là lúc kiếm tiền hời nhất.
Dialogue: 0,0:05:05.52,0:05:10.05,Default,ELMA,0,0,0,,Nhưng tôi vẫn không tin tưởng được \NĐế Quốc hay Liên Bang Belbellum đâu.
Dialogue: 0,0:05:10.05,0:05:12.75,Default,ELMA,0,0,0,,Xung đột giữa hai bên có thể nổ ra bất cứ lúc nào.
Dialogue: 0,0:05:12.75,0:05:17.33,Default,HIRO,0,0,0,,Tới lúc đó thì chúng ta chuồn khỏi đây là xong.
Dialogue: 0,0:05:17.33,0:05:20.96,Default,HIRO,0,0,0,,Dù sao thì, đây là thù lao của hai người. Mọi người vất vả rồi.
Dialogue: 0,0:05:21.27,0:05:22.27,Default,ELMA,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:05:22.27,0:05:23.92,Default,MIMI,0,0,0,,Những 9.000 Enel lận sao ạ?
Dialogue: 0,0:05:24.43,0:05:28.62,Default,MIMI,0,0,0,,Anh trả cho em nhiều thế này \Nthực sự có ổn không ạ?
Dialogue: 0,0:05:28.62,0:05:29.46,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:05:29.46,0:05:35.64,Default,MIMI,0,0,0,,Không như anh và chị Elma, \Nem chỉ ngồi ở ghế hoa tiêu thôi mà.
Dialogue: 0,0:05:36.00,0:05:38.65,Default,MIMI,0,0,0,,Em không dám nhận nhiều thế này đâu ạ.
Dialogue: 0,0:05:38.95,0:05:45.73,Default,HIRO,0,0,0,,Đâu có được. Dù em vẫn đang học việc, \Nnhưng em cũng đang liều mạng ngoài đó mà.
Dialogue: 0,0:05:45.73,0:05:49.16,Default,ELMA,0,0,0,,Em xứng đáng nhận số tiền đó. Đừng khiêm tốn thế.
Dialogue: 0,0:05:49.43,0:05:53.26,Default,ELMA,0,0,0,,Đó cũng là thù lao \Ncho công em chăm sóc tên này nữa.
Dialogue: 0,0:05:53.26,0:05:54.53,Default,HIRO,0,0,0,,Chăm sóc tôi á?
Dialogue: 0,0:05:54.53,0:05:55.33,Default,MIMI,0,0,0,,Nhưng mà...
Dialogue: 0,0:05:55.66,0:05:59.62,Default,HIRO,0,0,0,,Dù sao thì, đây cũng là minh chứng \Ncho tình bạn giữa chúng ta.
Dialogue: 0,0:05:59.62,0:06:01.29,Default,HIRO,0,0,0,,Em cứ yên tâm mà nhận đi.
Dialogue: 0,0:06:01.65,0:06:04.26,Default,MIMI,0,0,0,,Bạn bè sao ạ? Vâng.
Dialogue: 0,0:06:04.55,0:06:07.65,Default,ELMA,0,0,0,,Toàn bạn bè vui vẻ \Ngắn kết với nhau bằng tiền bạc.
Dialogue: 0,0:06:07.65,0:06:08.72,Default,HIRO,0,0,0,,Đừng nói khó nghe thế chứ.
Dialogue: 0,0:06:09.71,0:06:14.15,Default,HIRO,0,0,0,,Giờ ví tiền đã rủng rỉnh rồi, \Nchúng ta đi mua sắm chút đi.
Dialogue: 0,0:06:14.15,0:06:16.22,Default,HIRO,0,0,0,,Ai cũng cần nghỉ ngơi thư giãn một chút.
Dialogue: 0,0:06:16.92,0:06:19.82,Default,ELMA,0,0,0,,Ý cậu là bản thân cậu muốn nghỉ thì có.
Dialogue: 0,0:06:19.82,0:06:21.98,Default,HIRO,0,0,0,,Thì đúng là vậy, nhưng quan trọng nhất là,
Dialogue: 0,0:06:22.60,0:06:27.57,Default,HIRO,0,0,0,,tôi muốn Mimi được trải nghiệm cảm giác \Ntự tay tiêu số tiền mình kiếm được theo ý thích.
Dialogue: 0,0:06:27.83,0:06:28.77,Default,MIMI,0,0,0,,Dạ?
Dialogue: 0,0:06:29.46,0:06:32.23,Default,ELMA,0,0,0,,Hiểu rồi. Điều đó đúng là quan trọng thật.
Dialogue: 0,0:06:32.52,0:06:34.62,Default,MIMI,0,0,0,,E-Em sẽ cố gắng hết sức ạ.
Dialogue: 0,0:06:58.74,0:07:00.97,Default,HIRO,0,0,0,,Trông như một cửa hàng đồ nhập khẩu.
Dialogue: 0,0:07:01.45,0:07:04.86,Default,ELMA,0,0,0,,Họ có đủ mọi loại thực phẩm \Ntrong khắp vũ trụ đấy.
Dialogue: 0,0:07:04.86,0:07:06.90,Default,ELMA,0,0,0,,Nơi này chuẩn đét để mua sắm rồi.
Dialogue: 0,0:07:08.08,0:07:11.24,Default,MIMI,0,0,0,,Đó chẳng phải là yura từ \NHệ sao Brachy sao ạ?
Dialogue: 0,0:07:11.24,0:07:14.17,Default,MIMI,0,0,0,,Họ còn có cả tôm squilla, loài chỉ \Nxuất hiện ở Hệ sao Orato nữa.
Dialogue: 0,0:07:15.09,0:07:19.10,Default,MIMI,0,0,0,,Hóa ra sinh vật tinh thể đó \Ntrước khi sơ chế trông như thế này sao?
Dialogue: 0,0:07:19.10,0:07:20.88,Default,MIMI,0,0,0,,Lần đầu tiên em được thấy tận mắt đấy.
Dialogue: 0,0:07:21.11,0:07:23.62,Default,ELMA,0,0,0,,Em hiểu biết rộng thật đấy, Mimi.
Dialogue: 0,0:07:23.62,0:07:28.56,Default,MIMI,0,0,0,,Dạ, vì em thích các trang ẩm thực, \Nnên thường xuyên đọc nhiều bài viết ạ.
Dialogue: 0,0:07:28.56,0:07:30.84,Default,MIMI,0,0,0,,Xin lỗi vì em đã phấn khích quá.
Dialogue: 0,0:07:31.24,0:07:34.32,Default,HIRO,0,0,0,,Thấy thứ mình thích mà không phấn khích \Nthì mới là lạ đấy chứ.
Dialogue: 0,0:07:34.78,0:07:35.81,Default,MIMI,0,0,0,,Vâng ạ.
Dialogue: 0,0:07:36.68,0:07:41.06,Default,HIRO,0,0,0,,M-Miếng thịt hình dáng như hoạt hình ăn liền sao?
Dialogue: 0,0:07:41.31,0:07:44.52,Default,HIRO,0,0,0,,Càng không biết thịt con gì \Nthì ăn lại càng thấy cuốn!
Dialogue: 0,0:07:44.90,0:07:46.33,Default,ELMA,0,0,0,,Giờ thì tới lượt {\i1}cậu ta{\i0} lên cơn phấn khích.
Dialogue: 0,0:07:46.33,0:07:47.48,Default,MIMI,0,0,0,,Chắc anh ấy có hứng thú với món đó.
Dialogue: 0,0:07:47.74,0:07:50.50,Default,HIRO,0,0,0,,Được rồi, mua món này thôi! \NTôi nhất định phải ăn thử!
Dialogue: 0,0:07:50.50,0:07:52.44,Default,HIRO,0,0,0,,Một miếng những 76 Enel sao?
Dialogue: 0,0:07:52.44,0:07:55.22,Default,HIRO,0,0,0,,Đắt thật đấy, nhưng không cưỡng lại nổi!
Dialogue: 0,0:07:56.67,0:07:58.50,Default,MIMI,0,0,0,,Để em mua cho ạ.
Dialogue: 0,0:07:58.50,0:08:01.90,Default,HIRO,0,0,0,,Hả? Nhưng mà mọi người cùng ăn mà. \NĐể anh mua.
Dialogue: 0,0:08:01.90,0:08:06.08,Default,MIMI,0,0,0,,Không đâu, em muốn dùng tháng lương đầu tiên \Nđể mua món này.
Dialogue: 0,0:08:06.55,0:08:08.97,Default,HIRO,0,0,0,,Được rồi, vậy lần này để em bao nhé.
Dialogue: 0,0:08:08.97,0:08:10.91,Default,MIMI,0,0,0,,Cứ tin ở em ạ.
Dialogue: 0,0:08:10.91,0:08:13.38,Default,ELMA,0,0,0,,Nhìn xem họ còn có món gì kìa.
Dialogue: 0,0:08:15.83,0:08:18.90,Default,ELMA,0,0,0,,Đây là món cao lương mỹ vị còn sống nguyên đấy.
Dialogue: 0,0:08:18.90,0:08:19.85,Default,ELMA,0,0,0,,Có muốn nếm thử không?
Dialogue: 0,0:08:19.85,0:08:21.73,Default,MIMI,0,0,0,,D-Dạ thôi, em xin kiếu.
Dialogue: 0,0:08:21.73,0:08:23.50,Default,ELMA,0,0,0,,Họ có cả món này nữa cơ!
Dialogue: 0,0:08:25.26,0:08:28.24,Default,HIRO,0,0,0,,Khoan đã. Chẳng lẽ là...
Dialogue: 0,0:08:28.81,0:08:32.44,DefaultItalics,HIRO/ID,0,0,0,,Đích đến của chuyến hành trình nằm ngay tại đây rồi!
Dialogue: 0,0:08:38.73,0:08:41.00,Default,HIRO,0,0,0,,Biết ngay mà.
Dialogue: 0,0:08:41.00,0:08:43.74,Default,HIRO,0,0,0,,Vị thì giống hệt cola, \Nnhưng lại chẳng có chút ga nào.
Dialogue: 0,0:08:43.74,0:08:44.96,Default,HIRO,0,0,0,,Bị lừa rồi.
Dialogue: 0,0:08:44.96,0:08:48.34,Default,EMPLOYEE,0,0,0,,Q-Quý khách có thắc mắc gì \Nvề sản phẩm bên chúng tôi không ạ?
Dialogue: 0,0:08:48.34,0:08:49.42,Default,HIRO,0,0,0,,Ở đây còn món này nữa không?
Dialogue: 0,0:08:49.88,0:08:53.26,Default,EMPLOYEE,0,0,0,,Ngoài những chai đang trưng bày, \Nbên trong kho còn 7 thùng nữa ạ.
Dialogue: 0,0:08:53.26,0:08:54.39,Default,HIRO,0,0,0,,Tôi lấy hết toàn bộ.
Dialogue: 0,0:08:54.63,0:08:59.35,Default,ELMA,0,0,0,,Haa, cảm giác sảng khoái \Nchảy trôi xuống tận ruột gan.
Dialogue: 0,0:08:59.65,0:09:03.82,Default,ELMA,0,0,0,,Không ngờ cậu lại chẳng uống được rượu bia đấy. \NTrẻ con chắc?
Dialogue: 0,0:09:03.82,0:09:06.29,Default,HIRO,0,0,0,,Im đi. Cơ địa tôi nó thế rồi.
Dialogue: 0,0:09:06.29,0:09:08.31,Default,HIRO,0,0,0,,Uống cái này là đủ thỏa mãn rồi.
Dialogue: 0,0:09:08.53,0:09:13.02,Default,HIRO,0,0,0,,Ít nhất là cho đến khi tôi tìm được \Ncola có ga đích thực.
Dialogue: 0,0:09:15.02,0:09:16.99,Default,ELMA,0,0,0,,Ánh mắt cậu trông cuồng loạn thật đấy.
Dialogue: 0,0:09:17.59,0:09:19.37,Default,MIMI,0,0,0,,Để mọi người phải đợi lâu rồi ạ.
Dialogue: 0,0:09:20.15,0:09:23.81,Default,HIRO,0,0,0,,Ngon thật đấy. Gia vị đậm đà \Năn cuốn ghê.
Dialogue: 0,0:09:23.81,0:09:26.19,Default,HIRO,0,0,0,,Ước gì gặm được cả phần xương này luôn.
Dialogue: 0,0:09:26.19,0:09:28.87,Default,MIMI,0,0,0,,May quá. Đúng là không uổng tiền mà.
Dialogue: 0,0:09:29.25,0:09:31.84,Default,ELMA,0,0,0,,Tada! Vẫn còn nữa này.
Dialogue: 0,0:09:32.73,0:09:34.29,Default,HIRO,0,0,0,,Cô mua đống đó từ lúc nào thế?
Dialogue: 0,0:09:34.61,0:09:36.04,Default,HIRO,0,0,0,,Món này cũng ngon phết.
Dialogue: 0,0:09:36.04,0:09:37.13,Default,MIMI,0,0,0,,Không tệ chút nào ạ.
Dialogue: 0,0:09:37.13,0:09:39.76,Default,ELMA,0,0,0,,Chuẩn chưa? Mau thử món tiếp theo đi.
Dialogue: 0,0:09:40.12,0:09:41.74,Default,HIRO,0,0,0,,Nói thật đấy, cô mua đống này từ lúc nào thế hả?
Dialogue: 0,0:09:41.74,0:09:45.71,Default,ELMA,0,0,0,,Tiêu số tiền mình tự kiếm được \Ntheo ý thích thì có gì sai đâu chứ?
Dialogue: 0,0:09:45.71,0:09:47.72,Default,HIRO,0,0,0,,Tôi có ý đó đâu.
Dialogue: 0,0:09:48.11,0:09:49.91,Default,MIMI,0,0,0,,Em đã quyết định rồi.
Dialogue: 0,0:09:50.66,0:09:51.88,Default,ELMA,0,0,0,,Quyết định chuyện gì cơ?
Dialogue: 0,0:09:51.88,0:09:52.91,Default,HIRO,0,0,0,,Quyết định gì thế em?
Dialogue: 0,0:09:53.30,0:09:59.19,Default,MIMI,0,0,0,,Cũng giống như anh Hiro muốn có một ngôi nhà \Nvới chị Elma muốn chuộc lại chiến hạm riêng,
Dialogue: 0,0:09:59.19,0:10:03.62,Default,MIMI,0,0,0,,em muốn thưởng thức tất cả những món ăn ngon \Ntrên khắp cõi vũ trụ này!
Dialogue: 0,0:10:04.82,0:10:09.46,Default,MIMI,0,0,0,,Em muốn được nếm thử mọi sơn hào hải vị \Ncủa ngân hà cùng với hai người.
Dialogue: 0,0:10:09.93,0:10:12.02,Default,MIMI,0,0,0,,Đó là mục tiêu của em ạ.
Dialogue: 0,0:10:12.60,0:10:15.47,Default,HIRO,0,0,0,,Nghe hay đấy chứ. \NĐúng là phong cách của em.
Dialogue: 0,0:10:15.71,0:10:19.92,Default,MIMI,0,0,0,,Từ nay về sau, lại nhờ anh chỉ bảo thêm nhé, anh Hiro.
Dialogue: 0,0:10:19.92,0:10:21.45,Default,ELMA,0,0,0,,Tôi cũng vậy.
Dialogue: 0,0:10:21.45,0:10:24.55,Default,ELMA,0,0,0,,Mà thực ra, cậu là người lôi kéo tôi vào đây đấy chứ.
Dialogue: 0,0:10:24.55,0:10:26.32,Default,ELMA,0,0,0,,Cậu liệu mà chịu trách nhiệm đi.
Dialogue: 0,0:10:26.59,0:10:28.62,Default,HIRO,0,0,0,,Mimi, Elma...
Dialogue: 0,0:10:29.63,0:10:30.78,Default,MIMI,0,0,0,,Anh Hiro?
Dialogue: 0,0:10:30.78,0:10:32.83,Default,ELMA,0,0,0,,Cậu khóc cái gì đấy hả?
Dialogue: 0,0:10:32.83,0:10:37.48,Default,HIRO,0,0,0,,Xin lỗi. Chỉ là nghe hai người nói vậy, \Ntôi thấy vui quá thôi.
Dialogue: 0,0:10:37.83,0:10:41.39,Default,HIRO,0,0,0,,Thật lòng thì tôi từng có chút băn khoăn,
Dialogue: 0,0:10:41.39,0:10:45.38,Default,HIRO,0,0,0,,sợ rằng hai người ở lại chỉ vì mang ơn cứu mạng.
Dialogue: 0,0:10:46.44,0:10:52.08,Default,ELMA,0,0,0,,Có vẻ cậu vẫn chưa hiểu \Nbọn tôi nghiêm túc tới mức nào đâu nhỉ.
Dialogue: 0,0:10:59.51,0:11:02.94,Default,ELMA,0,0,0,,Phải khắc sâu vào người cậu mới được.
Dialogue: 0,0:11:03.58,0:11:05.42,Default,MIMI,0,0,0,,E-Em cũng sẽ cố gắng hết sức ạ.
Dialogue: 0,0:11:05.69,0:11:07.52,Default,HIRO,0,0,0,,Này, khoan đã...
Dialogue: 0,0:11:23.22,0:11:27.28,Default,SERENA,0,0,0,,Vẫn chưa nắm được động thái \Ncủa Liên Bang Belbellum sao?
Dialogue: 0,0:11:27.28,0:11:28.07,Default,GEORG,0,0,0,,Báo cáo Trung úy, chưa ạ.
Dialogue: 0,0:11:28.07,0:11:31.68,Default,GEORG,0,0,0,,Mấy ngày gần đây chúng ta nhận được \Nngày càng nhiều báo cáo
Dialogue: 0,0:11:31.68,0:11:35.66,Default,GEORG,0,0,0,,về các chiến hạm nghi của Liên Bang \Ntiến vào hải phận của chúng ta, nhưng mà...
Dialogue: 0,0:11:36.01,0:11:39.70,Default,SERENA,0,0,0,,Vẫn chưa thu được bằng chứng xác thực.
Dialogue: 0,0:11:39.70,0:11:44.80,Default,SERENA,0,0,0,,Dù sao đi nữa, tôi không thể để bọn chúng \Ntự tung tự tác trong lãnh thổ của chúng ta được.
Dialogue: 0,0:11:45.16,0:11:48.10,Default,GEORG,0,0,0,,Rõ! Chúng tôi sẽ đi xử lý ngay.
Dialogue: 0,0:11:52.10,0:11:55.02,Signs,TITLE,0,0,0,,{\fad(901,1)\fs12\fscx88\an7\bord1.5\fnArial Black\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(462,274)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:11:55.02,0:12:00.03,Signs,TITLE,0,0,0,,{\fs12\fscx88\an7\bord1.5\fnArial Black\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(452,270)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:12:03.90,0:12:05.92,Default,HIRO,0,0,0,,Chẳng thấy bóng dáng tên nào cả.
Dialogue: 0,0:12:06.49,0:12:09.11,Default,HIRO,0,0,0,,Hải tặc không gian cũng có ngày nghỉ phép à?
Dialogue: 0,0:12:09.39,0:12:11.19,Default,ELMA,0,0,0,,Đương nhiên là không rồi.
Dialogue: 0,0:12:11.57,0:12:14.34,Default,ELMA,0,0,0,,Mimi, mở rộng phạm vi quét radar đi.
Dialogue: 0,0:12:14.64,0:12:17.79,Default,MIMI,0,0,0,,Rõ ạ. Em sẽ nâng lên công suất tối đa.
Dialogue: 0,0:12:18.08,0:12:21.11,DefaultItalics,HIRO/ID,0,0,0,,Sao hai người này lúc nào cũng tràn trề năng lượng thế nhỉ?
Dialogue: 0,0:12:21.11,0:12:23.01,DefaultItalics,HIRO/ID,0,0,0,,Bộ hai người hút hết sinh khí của mình rồi à?
Dialogue: 0,0:12:25.04,0:12:26.98,Default,MIMI,0,0,0,,Radar phát hiện có phản ứng!
Dialogue: 0,0:12:27.51,0:12:28.97,Default,ELMA,0,0,0,,Hải tặc sao?
Dialogue: 0,0:12:29.43,0:12:33.90,Default,MIMI,0,0,0,,Dựa theo tín hiệu đăng ký, \Nđó là đội tàu khai thác mỏ.
Dialogue: 0,0:12:34.23,0:12:36.88,Default,HIRO,0,0,0,,Hụt rồi, cơ mà...
Dialogue: 0,0:12:36.88,0:12:37.61,Default,ELMA,0,0,0,,Ừ.
Dialogue: 0,0:12:37.61,0:12:38.71,Default,MIMI,0,0,0,,Dạ?
Dialogue: 0,0:12:38.71,0:12:41.84,Default,ELMA,0,0,0,,Phần lớn tiểu hành tinh quanh đây \Nđều đã bị khai thác cạn kiệt từ lâu.
Dialogue: 0,0:12:41.84,0:12:43.82,Default,ELMA,0,0,0,,Làm gì còn khoáng sản nào ra hồn nữa.
Dialogue: 0,0:12:44.24,0:12:46.79,Default,ELMA,0,0,0,,Nếu bọn chúng lượn lờ ở khu vực này...
Dialogue: 0,0:12:47.05,0:12:51.45,Default,HIRO,0,0,0,,Thì hoặc là lũ ngốc, \Nhoặc là đang có mưu đồ khác.
Dialogue: 0,0:12:51.45,0:12:52.74,Default,ELMA,0,0,0,,Cậu tính sao đây?
Dialogue: 0,0:12:52.74,0:12:56.67,Default,HIRO,0,0,0,,Tốt nhất là tránh voi chẳng xấu mặt nào, \Nchuồn sớm cho lành.
Dialogue: 0,0:12:57.34,0:12:58.62,Default,MIMI,0,0,0,,Bọn chúng đang di chuyển!
Dialogue: 0,0:12:58.96,0:13:01.03,Default,HIRO,0,0,0,,Không kịp rồi.
Dialogue: 0,0:13:04.79,0:13:07.26,Default,MIMI,0,0,0,,Các chiến hạm không rõ lai lịch \Nđang triển khai vũ khí!
Dialogue: 0,0:13:07.84,0:13:11.56,Default,HIRO,0,0,0,,Tàu khai khoáng cái nỗi gì chứ. \NVũ trang tận răng thế kia.
Dialogue: 0,0:13:11.56,0:13:13.45,Default,ELMA,0,0,0,,Nhìn vào đội hình tác chiến nhịp nhàng thế kia,
Dialogue: 0,0:13:13.45,0:13:16.68,Default,ELMA,0,0,0,,tôi đoán chúng là chiến hạm ngụy trang \Ncủa Liên Bang Belbellum.
Dialogue: 0,0:13:17.06,0:13:20.15,Default,ELMA,0,0,0,,Số cậu đúng là đen như chó mực.
Dialogue: 0,0:13:20.15,0:13:22.11,Default,HIRO,0,0,0,,Cô cũng có khác gì tôi đâu.
Dialogue: 0,0:13:23.83,0:13:27.40,Default,ELMA,0,0,0,,Vận may của Mimi cũng tệ chẳng kém.
Dialogue: 0,0:13:27.40,0:13:29.25,Default,MIMI,0,0,0,,Ơ, em sao ạ?
Dialogue: 0,0:13:29.54,0:13:33.46,Default,HIRO,0,0,0,,Thôi đủ rồi, không khéo lại xuống tinh thần mất.
Dialogue: 0,0:13:33.87,0:13:36.75,Default,HIRO,0,0,0,,Đẩy máy phát lên công suất tối đa! \NChúng ta sẽ nghênh chiến!
Dialogue: 0,0:13:36.75,0:13:37.86,Default,ELMA,0,0,0,,Rõ, thưa Thuyền trưởng.
Dialogue: 0,0:13:47.73,0:13:50.10,Default,ELMA,0,0,0,,Khiên chắn giảm 30%!
Dialogue: 0,0:13:50.10,0:13:52.80,Default,HIRO,0,0,0,,Chưa xi nhê gì đâu. Trả đòn thôi!
Dialogue: 0,0:14:03.12,0:14:06.03,Default,ELMA,0,0,0,,Lối di chuyển của cậu vẫn điên rồ như mọi khi.
Dialogue: 0,0:14:06.94,0:14:08.99,Default,MIMI,0,0,0,,E-Em cũng quen dần rồi ạ.
Dialogue: 0,0:14:08.99,0:14:10.21,Default,HIRO,0,0,0,,Lên nào!
Dialogue: 0,0:14:10.57,0:14:11.64,Default,HIRO,0,0,0,,Trúng phóc!
Dialogue: 0,0:14:17.70,0:14:20.01,Default,HIRO,0,0,0,,Thích đấu súng tay đôi à?
Dialogue: 0,0:14:20.26,0:14:21.94,Default,HIRO,0,0,0,,Nhào vô kiếm ăn!
Dialogue: 0,0:14:30.58,0:14:31.71,Default,ELMA,0,0,0,,N-Này, khoan đã!
Dialogue: 0,0:14:38.10,0:14:41.31,Default,HIRO,0,0,0,,Biết ngay mà. Tàu quân sự có khác, \Nmột phát bắn là chưa đủ hạ được nó.
Dialogue: 0,0:14:41.60,0:14:44.07,Default,HIRO,0,0,0,,Để xem chúng chịu được bao lâu!
Dialogue: 0,0:14:45.45,0:14:47.63,Default,ELMA,0,0,0,,Ắc-quy khiên chắn của địch đã cạn kiệt!
Dialogue: 0,0:14:47.89,0:14:49.63,Default,HIRO,0,0,0,,Biết đường tháo chạy rồi đấy.
Dialogue: 0,0:14:49.63,0:14:51.80,Default,HIRO,0,0,0,,Nhưng đừng mơ thoát!
Dialogue: 0,0:15:12.81,0:15:15.76,Default,HIRO,0,0,0,,Thấy thế nào? \NĐừng có coi thường Thuyền trưởng Hiro này!
Dialogue: 0,0:15:15.76,0:15:18.21,Default,ELMA,0,0,0,,Cậu làm cái trò gì thế hả?!
Dialogue: 0,0:15:18.21,0:15:20.23,Default,ELMA,0,0,0,,Bắn nát bấy thế thì còn mót được cái gì nữa?!
Dialogue: 0,0:15:25.70,0:15:28.44,Default,MIMI,0,0,0,,Em nghĩ vẫn còn một tàu có thể thu hồi được ạ.
Dialogue: 0,0:15:32.97,0:15:36.95,Default,HIRO,0,0,0,,Chết dở. Suýt nữa thì công cốc làm không công.
Dialogue: 0,0:15:36.95,0:15:38.66,Default,ELMA,0,0,0,,Tất cả là do cậu hăng máu quá đấy.
Dialogue: 0,0:15:39.16,0:15:43.12,Default,ELMA,0,0,0,,Ít nhất thì cũng lấy được hộp đen. \NVẫn chưa đến nỗi nào.
Dialogue: 0,0:15:43.44,0:15:45.18,Default,MIMI,0,0,0,,Hộp đen sao ạ?
Dialogue: 0,0:15:45.18,0:15:48.08,Default,ELMA,0,0,0,,Ừ. Trong đó chắc chắn chứa \Nđủ loại dữ liệu cơ mật.
Dialogue: 0,0:15:48.51,0:15:53.54,Default,ELMA,0,0,0,,Hạm đội hệ sao sẽ chi một khoản hậu hĩnh \Nđể mua lại hộp đen của Liên Bang đấy.
Dialogue: 0,0:15:53.54,0:15:55.23,Default,MIMI,0,0,0,,Ra là vậy ạ.
Dialogue: 0,0:15:55.55,0:15:57.93,Default,HIRO,0,0,0,,Để tôi lo vụ bán dữ liệu này.
Dialogue: 0,0:15:57.93,0:15:59.86,Default,HIRO,0,0,0,,Tôi có mối quen bên quân đội.
Dialogue: 0,0:15:59.86,0:16:01.59,Default,ELMA,0,0,0,,Mối quen cơ à?
Dialogue: 0,0:16:01.97,0:16:04.89,Default,ELMA,0,0,0,,Liệu mà đừng có rước rắc rối \Nvề tàu đấy nhé.
Dialogue: 0,0:16:05.61,0:16:07.08,Default,HIRO,0,0,0,,Tôi đâu có ngu ngốc đến thế.
Dialogue: 0,0:16:07.08,0:16:09.53,Default,HIRO,0,0,0,,Tôi bán xong mớ chiến lợi phẩm này rồi về ngay.
Dialogue: 0,0:16:17.55,0:16:19.54,Default,ELMA,0,0,0,,Cậu có lời gì muốn tự bào chữa không hả?
Dialogue: 0,0:16:19.90,0:16:21.08,Default,HIRO,0,0,0,,Tôi xin lỗi...
Dialogue: 0,0:16:21.08,0:16:22.33,Default,MIMI,0,0,0,,Anh Hiro...
Dialogue: 0,0:16:22.33,0:16:23.62,Default,HIRO,0,0,0,,Tôi thật lòng xin lỗi hai người...
Dialogue: 0,0:16:23.62,0:16:24.74,Default,ELMA,0,0,0,,Thật không thể tin nổi cậu.
Dialogue: 0,0:16:25.38,0:16:30.07,Default,ELMA,0,0,0,,Làm thế quái nào mà cậu lại tự ý đăng ký \Ncho bọn tôi tham gia chiến dịch quân sự hả?!
Dialogue: 0,0:16:30.07,0:16:33.40,Default,HIRO,0,0,0,,Tôi cũng chẳng biết tại sao nữa...
Dialogue: 0,0:16:34.30,0:16:37.78,Flashback,SERENA,0,0,0,,Chúng tôi đã phân tích dữ liệu \Ntrong chiếc hộp đen mà anh giao nộp,
Dialogue: 0,0:16:38.13,0:16:42.08,Flashback,SERENA,0,0,0,,đúng như anh dự đoán, chúng là điệp viên \Ncủa Liên Bang Belbellum.
Dialogue: 0,0:16:42.08,0:16:43.06,Flashback,HIRO,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:16:43.42,0:16:47.77,Flashback,SERENA,0,0,0,,Anh đã thể hiện rất xuất sắc trong đợt thảo phạt vừa rồi, \Nvà lần này cũng không ngoại lệ.
Dialogue: 0,0:16:47.77,0:16:51.74,Flashback,HIRO,0,0,0,,Không dám đâu. Chúng tôi chỉ làm phận sự thôi.
Dialogue: 0,0:16:52.06,0:16:55.22,Flashback,HIRO,0,0,0,,Thôi, nhận thù lao xong rồi, \Ntôi xin phép cáo từ.
Dialogue: 0,0:16:55.69,0:16:57.97,Flashback,SERENA,0,0,0,,Dựa trên dữ liệu mà anh thu thập được,
Dialogue: 0,0:16:57.97,0:17:02.00,Flashback,SERENA,0,0,0,,một cuộc xâm lược vào Hệ sao Tarmein \Nđang được rục rịch tiến hành.
Dialogue: 0,0:17:02.41,0:17:07.70,Flashback,SERENA,0,0,0,,Đương nhiên, hạm đội hệ sao sẽ nghênh chiến, \Nvà xung đột sẽ sớm nổ ra thôi.
Dialogue: 0,0:17:08.07,0:17:11.88,Flashback,HIRO,0,0,0,,Thế à? Nghe gay go đấy nhỉ. \NDù sao thì tôi phải đi đây.
Dialogue: 0,0:17:12.23,0:17:18.03,Flashback,SERENA,0,0,0,,Bởi vậy, quân đội chúng tôi đang tìm kiếm \Nsự hợp tác từ giới lính đánh thuê,
Dialogue: 0,0:17:18.03,0:17:22.10,Flashback,SERENA,0,0,0,,đặc biệt là những chiến binh dũng cảm \Nvà thiện chiến như anh.
Dialogue: 0,0:17:22.10,0:17:27.16,Flashback,HIRO,0,0,0,,Ấy, tôi chẳng phải chiến binh gì đâu. \NMấy chuyện đó không hợp với tôi.
Dialogue: 0,0:17:27.16,0:17:28.80,Flashback,HIRO,0,0,0,,Cô có tâng bốc tôi thì cũng vô ích thôi.
Dialogue: 0,0:17:29.12,0:17:32.20,Flashback,SERENA,0,0,0,,Vậy sao. Tiếc thật đấy.
Dialogue: 0,0:17:32.20,0:17:34.91,Flashback,SERENA,0,0,0,,Mà cũng phải thôi, lần này {\i1}đối thủ{\i0} \Nlà quân đội chính quy của Liên Bang mà.
Dialogue: 0,0:17:34.91,0:17:37.52,Flashback,SERENA,0,0,0,,Tôi cũng chẳng trách việc anh thấy sợ hãi đâu.
Dialogue: 0,0:17:38.02,0:17:39.62,Flashback,SERENA,0,0,0,,Chuyện thường tình thôi.
Dialogue: 0,0:17:40.01,0:17:44.24,Flashback,SERENA,0,0,0,,Tôi không thể ép một kẻ không có gan \Nra chiến trường được.
Dialogue: 0,0:17:46.71,0:17:49.47,Flashback,SERENA,0,0,0,,Tôi sẽ ghi nhớ rằng \NThuyền trưởng Hiro lừng danh
Dialogue: 0,0:17:49.47,0:17:55.25,Flashback,SERENA,0,0,0,,rốt cuộc cũng chỉ là gã lính đánh thuê hạng bét, \Nsuốt đời chỉ biết săn mấy tên cướp biển vặt vãnh.
Dialogue: 0,0:17:55.77,0:17:56.85,Flashback,SERENA,0,0,0,,Đi thôi.
Dialogue: 0,0:17:56.85,0:17:58.45,Flashback,EMMA,0,0,0,,Rõ, thưa Tiểu thư Serena.
Dialogue: 0,0:17:59.51,0:18:01.68,Flashback,SERENA,0,0,0,,Anh thực sự không muốn tham gia sao?
Dialogue: 0,0:18:01.68,0:18:02.95,Flashback,HIRO,0,0,0,,Tôi làm! Tôi sẽ tham gia!
Dialogue: 0,0:18:05.43,0:18:07.09,Flashback,SERENA,0,0,0,,Tôi đặt nhiều kỳ vọng vào anh đấy.
Dialogue: 0,0:18:07.83,0:18:10.81,Default,EMMA,0,0,0,,Anh bị cô ấy khích tướng trúng phóc rồi.
Dialogue: 0,0:18:11.05,0:18:12.33,Default,MIMI,0,0,0,,Anh Hiro...
Dialogue: 0,0:18:12.33,0:18:14.47,Default,HIRO,0,0,0,,Anh thật lòng xin lỗi...
Dialogue: 0,0:18:14.47,0:18:16.78,Default,ELMA,0,0,0,,Thiệt tình chứ. Mà thôi kệ đi.
Dialogue: 0,0:18:17.53,0:18:19.71,Default,ELMA,0,0,0,,Cậu là thuyền trưởng mà.
Dialogue: 0,0:18:19.71,0:18:23.98,Default,ELMA,0,0,0,,Cậu có toàn quyền quyết định \Nmà không cần thông qua bọn tôi.
Dialogue: 0,0:18:24.29,0:18:25.74,Default,MIMI,0,0,0,,Chị nói đúng ạ.
Dialogue: 0,0:18:25.74,0:18:28.24,Default,MIMI,0,0,0,,Anh hãy ngẩng cao đầu lên đi, anh Hiro.
Dialogue: 0,0:18:28.24,0:18:29.33,Default,HIRO,0,0,0,,Hai người tha lỗi cho tôi thật sao?
Dialogue: 0,0:18:29.65,0:18:34.30,Default,ELMA,0,0,0,,Nhưng bù lại bọn tôi sẽ mong đợi tiền thưởng hậu hĩnh đấy, \Ncậu hiểu ý tôi rồi chứ?
Dialogue: 0,0:18:35.57,0:18:39.31,Default,HIRO,0,0,0,,Tôi sẽ ghi nhận điều đó...
Dialogue: 0,0:18:39.64,0:18:42.99,Default,MERC A,0,0,0,,Tên đó đi cùng hai em gái xinh xắn thế kia á?
Dialogue: 0,0:18:43.62,0:18:45.87,Default,MERC B,0,0,0,,Đó là Elma cấp Bạc đấy.
Dialogue: 0,0:18:45.87,0:18:47.56,Default,MERC B,0,0,0,,Sao cô ấy lại đi chung với hắn ta nhỉ?
Dialogue: 0,0:18:48.09,0:18:50.77,Default,MERC C,0,0,0,,Cầu cho hắn bị bắn nát bấy đi.
Dialogue: 0,0:18:51.14,0:18:53.81,DefaultItalics,HIRO/ID,0,0,0,,Đi cùng hai mỹ nhân đúng là hút mắt thiên hạ thật.
Dialogue: 0,0:18:53.81,0:18:56.23,DefaultItalics,HIRO/ID,0,0,0,,Mà bị bắn nát xác chẳng vui vẻ gì đâu. \NĐừng có trù ẻo tôi chứ.
Dialogue: 0,0:18:56.49,0:18:57.60,Default,GEORG,0,0,0,,Nghiêm!
Dialogue: 0,0:18:58.41,0:19:01.53,Default,ELMA,0,0,0,,Kẻ đã gài bẫy cậu đến rồi kìa.
Dialogue: 0,0:19:04.06,0:19:08.78,Default,GEORG,0,0,0,,Buổi báo cáo tác chiến phòng tuyến Hệ sao Tarmein \Nxin phép được bắt đầu.
Dialogue: 0,0:19:09.67,0:19:12.19,Default,GEORG,0,0,0,,Dựa theo dữ liệu chúng ta thu thập được,
Dialogue: 0,0:19:12.19,0:19:15.57,Default,GEORG,0,0,0,,đây là quy mô binh lực của quân Liên Bang.
Dialogue: 0,0:19:15.57,0:19:19.75,Default,GEORG,0,0,0,,Hỏa lực của chúng vượt trội hoàn toàn \Nso với lực lượng đóng quân tại Hệ sao Tarmein.
Dialogue: 0,0:19:20.14,0:19:24.72,Default,GEORG,0,0,0,,Chúng tôi nhận định đại bộ phận quân địch \Nsẽ tấn công vào khu vực này.
Dialogue: 0,0:19:27.41,0:19:30.45,Default,GEORG,0,0,0,,Viện binh hiện đang trên đường tới,
Dialogue: 0,0:19:30.45,0:19:33.40,Default,GEORG,0,0,0,,nhưng phải một ngày sau khi Liên Bang phát động tấn công \Nmới có thể tiếp cận.
Dialogue: 0,0:19:33.84,0:19:38.61,Default,GEORG,0,0,0,,Nói cách khác, chúng ta phải cầm cự ít nhất một ngày \Nvới lực lượng hiện có.
Dialogue: 0,0:19:39.37,0:19:44.22,Default,GEORG,0,0,0,,Khi hạm đội Liên Bang thoát khỏi bước nhảy siêu không gian,
Dialogue: 0,0:19:44.22,0:19:47.19,Default,GEORG,0,0,0,,lực lượng hệ sao sẽ nghênh chiến trực diện,
Dialogue: 0,0:19:47.19,0:19:49.66,Default,GEORG,0,0,0,,sau đó dụ chúng vào vành đai tiểu hành tinh.
Dialogue: 0,0:19:50.38,0:19:52.82,Default,GEORG,0,0,0,,Các lính đánh thuê dưới quyền chỉ huy \Ncủa Trung úy Serena
Dialogue: 0,0:19:52.82,0:19:56.35,Default,GEORG,0,0,0,,sẽ mai phục giữa các tiểu hành tinh \Nvà tiến hành tập kích du kích.
Dialogue: 0,0:19:56.35,0:19:59.41,Default,GEORG,0,0,0,,Nhiệm vụ là làm chậm bước tiến quân của hạm đội địch.
Dialogue: 0,0:19:59.41,0:20:01.17,Default,GEORG,0,0,0,,Đó là toàn bộ chiến lược tổng quát.
Dialogue: 0,0:20:01.89,0:20:03.14,Default,MERC D,0,0,0,,Nói thật đấy à?
Dialogue: 0,0:20:04.50,0:20:06.00,Default,ELMA,0,0,0,,Đối thủ là cả một hạm đội gồm
Dialogue: 0,0:20:06.00,0:20:10.00,Default,ELMA,0,0,0,,các chiến hạm cấp tuần dương hạm trở lên \Nvới khiên chắn công suất cực đại.
Dialogue: 0,0:20:10.40,0:20:13.43,Default,ELMA,0,0,0,,Một nhúm lính đánh thuê chỉ quen trang bị \Nđể săn cướp biển vặt
Dialogue: 0,0:20:13.43,0:20:15.47,Default,ELMA,0,0,0,,thì dù có đánh úp bất ngờ \Ncũng trầy vi tróc vảy thôi.
Dialogue: 0,0:20:15.47,0:20:17.37,Default,MIMI,0,0,0,,Sao cơ ạ? Vậy thì...
Dialogue: 0,0:20:18.17,0:20:21.47,Default,SERENA,0,0,0,,Thành thật mà nói, tôi không thể khẳng định \Nchúng ta đang nắm giữ lợi thế.
Dialogue: 0,0:20:21.88,0:20:24.00,Default,SERENA,0,0,0,,Nếu các vị có cao kiến gì, \Nchúng tôi rất sẵn lòng lắng nghe.
Dialogue: 0,0:20:24.37,0:20:27.21,Default,SERENA,0,0,0,,Chỉ cần phương án có tính khả thi, \Nchúng tôi đều sẽ áp dụng.
Dialogue: 0,0:20:27.21,0:20:29.17,Default,SERENA,0,0,0,,Xin mời phát biểu.
Dialogue: 0,0:20:29.97,0:20:31.28,Default,MIMI,0,0,0,,Anh Hiro...
Dialogue: 0,0:20:31.28,0:20:32.13,Default,SERENA,0,0,0,,Mời anh.
Dialogue: 0,0:20:33.13,0:20:38.70,Default,HIRO,0,0,0,,Tôi có kế hoạch này. \NThực ra chỉ cần một mình tàu của tôi thôi.
Dialogue: 0,0:20:39.26,0:20:43.17,Default,HIRO,0,0,0,,Một mình tôi sẽ mai phục sẵn \Ntại tọa độ thoát bước nhảy của hạm đội địch.
Dialogue: 0,0:20:43.17,0:20:44.90,Default,HIRO,0,0,0,,Ngay khi chúng vừa xuất hiện,
Dialogue: 0,0:20:44.90,0:20:49.75,Default,HIRO,0,0,0,,tôi sẽ lao thẳng xuyên qua đội hình, \Ndùng ngư lôi diệt hạm tiêu diệt soái hạm của chúng.
Dialogue: 0,0:20:51.42,0:20:53.22,Default,HIRO,0,0,0,,Sau đó tôi sẽ rút lui ngay lập tức.
Dialogue: 0,0:20:55.34,0:20:57.60,Default,GEORG,0,0,0,,Một chiến hạm đơn độc đối đầu cả hạm đội sao?
Dialogue: 0,0:20:57.93,0:20:59.35,Default,MERC A,0,0,0,,Điên rồ thật.
Dialogue: 0,0:20:59.35,0:21:01.52,Default,MERC B,0,0,0,,Đừng hòng có cửa sống sót trở về.
Dialogue: 0,0:21:01.80,0:21:04.20,Default,MERC C,0,0,0,,Sẽ bị bắn tan xác cho mà xem.
Dialogue: 0,0:21:06.95,0:21:08.41,Default,SERENA,0,0,0,,Anh mất trí rồi à?
Dialogue: 0,0:21:08.41,0:21:10.06,Default,HIRO,0,0,0,,Tôi sẽ làm được.
Dialogue: 0,0:21:10.56,0:21:14.89,Default,HIRO,0,0,0,,Sự hỗn loạn sẽ làm vỡ trận hình của chúng, \Ntừ đó kìm hãm bước tiến công.
Dialogue: 0,0:21:15.31,0:21:18.54,Default,HIRO,0,0,0,,Còn nếu tôi thất bại, các người chỉ mất đi \Nmột gã ngốc mà thôi.
Dialogue: 0,0:21:18.92,0:21:21.67,Default,HIRO,0,0,0,,Đế Quốc chẳng suy suyển một cọng lông nào cả.
Dialogue: 0,0:21:22.01,0:21:25.23,Default,HIRO,0,0,0,,Tôi cũng chẳng ép các người phải theo.
Dialogue: 0,0:21:26.20,0:21:29.74,Default,HIRO,0,0,0,,Nhưng mà tiếc thật đấy. \NTôi hoàn toàn có thể làm được.
Dialogue: 0,0:21:30.12,0:21:34.55,Default,HIRO,0,0,0,,Dù sao thì, theo lời ai đó, \Ntôi cũng là chiến binh thiện chiến và dũng cảm mà.
Dialogue: 0,0:21:36.79,0:21:43.28,Default,HIRO,0,0,0,,Không chịu à? Vậy tôi đành ghi nhớ rằng \Nhạm đội hệ sao hóa ra cũng chẳng có chút gan góc nào.
Dialogue: 0,0:21:43.58,0:21:45.99,Default,SERENA,0,0,0,,Được lắm. Tôi chấp thuận.
Dialogue: 0,0:21:46.21,0:21:48.20,Default,HIRO,0,0,0,,Cảm ơn cô.
Dialogue: 0,0:21:48.20,0:21:50.01,Default,SERENA,0,0,0,,Đây là nhiệm vụ cực kỳ nguy hiểm.
Dialogue: 0,0:21:50.01,0:21:52.66,Default,SERENA,0,0,0,,Nếu thành công, anh sẽ được đền đáp xứng đáng.
Dialogue: 0,0:21:53.36,0:21:54.57,Default,SERENA,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:57.55,0:21:59.56,Default,SERENA,0,0,0,,{\i1}chỉ khi{\i0} anh thành công trở về thôi đấy.
Dialogue: 0,0:22:00.15,0:22:01.32,Default,HIRO,0,0,0,,Đương nhiên rồi.
Dialogue: 0,0:22:06.13,0:22:10.13,Credits,CREDITS,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:22:10.13,0:22:14.14,Credits,CREDITS,0,0,0,,Biên dịch & Kỹ thuật: Amtia(NOFACE)
