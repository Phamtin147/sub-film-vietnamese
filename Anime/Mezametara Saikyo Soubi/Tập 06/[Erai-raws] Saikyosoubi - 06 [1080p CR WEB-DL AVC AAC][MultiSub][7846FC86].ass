Dialogue: 0,0:00:05.45,0:00:06.64,Default,HIRO,0,0,0,,Bắn!
Dialogue: 0,0:00:11.11,0:00:12.18,DefaultItalics,PIRATE A,0,0,0,,Khiên của chúng ta!
Dialogue: 0,0:00:12.18,0:00:13.47,DefaultItalics,PIRATE A,0,0,0,,Đ-Đừng mà!
Dialogue: 0,0:00:16.11,0:00:17.83,Default,HIRO,0,0,0,,Hai chiếc cùng lúc!
Dialogue: 0,0:00:20.75,0:00:21.80,Default,HIRO,0,0,0,,Kẻ tiếp theo là ai đây?
Dialogue: 0,0:00:22.11,0:00:23.19,Default,HIRO,0,0,0,,Để xem nào...
Dialogue: 0,0:00:23.19,0:00:24.92,Default,ELMA,0,0,0,,Bọn chúng đang định chuồn đấy.
Dialogue: 0,0:00:24.92,0:00:25.34,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:00:25.65,0:00:28.75,Default,MIMI,0,0,0,,Chiến hạm hải tặc đang kích hoạt động cơ tốc độ ánh sáng!
Dialogue: 0,0:00:28.75,0:00:29.30,Default,HIRO,0,0,0,,Cái gì cơ?
Dialogue: 0,0:00:29.30,0:00:32.05,DefaultItalics,PIRATE C,0,0,0,,Ai thèm đánh nhau với con quái vật đó chứ!
Dialogue: 0,0:00:36.40,0:00:39.78,Default,ELMA,0,0,0,,Lũ hải tặc đó chuồn lẹ thật đấy.
Dialogue: 0,0:00:39.78,0:00:42.56,Default,HIRO,0,0,0,,Mấy tên như vậy phiền phức thật.
Dialogue: 0,0:00:42.85,0:00:46.76,Default,HIRO,0,0,0,,Vừa mới thoát khỏi bước nhảy warp \Nlà chúng ta đã bắt được tín hiệu cầu cứu rồi.
Dialogue: 0,0:00:46.76,0:00:49.87,Default,HIRO,0,0,0,,Xem ra ở hệ sao này \Nchúng ta cũng chẳng được thảnh thơi rồi.
Dialogue: 0,0:00:49.87,0:00:51.89,Default,ELMA,0,0,0,,Tôi thấy hai mắt cậu hiện rõ hình đồng Enel rồi kìa.
Dialogue: 0,0:00:51.89,0:00:53.03,Default,HIRO,0,0,0,,Thì, rõ ràng mà.
Dialogue: 0,0:00:53.48,0:00:57.54,DefaultItalics,CAPTAIN,0,0,0,,Đây là tàu Koueimaru \Nthuộc Tập đoàn Công nghệ Inagawa.
Dialogue: 0,0:00:57.54,0:00:59.37,DefaultItalics,CAPTAIN,0,0,0,,Chúng tôi vô cùng cảm kích trước sự giúp đỡ của quý vị.
Dialogue: 0,0:00:59.96,0:01:01.07,Default,PASSENGER,0,0,0,,Chúng ta được cứu rồi.
Dialogue: 0,0:01:01.07,0:01:02.75,Default,PASSENGER,0,0,0,,Lúc nãy tôi sợ muốn chết.
Dialogue: 0,0:01:04.60,0:01:06.25,Default,SHOUKO,0,0,0,,Thật tình.
Dialogue: 0,0:01:08.17,0:01:12.50,Default,SHOUKO,0,0,0,,Xác suất được nhóm lính đánh thuê \Ntình cờ đi ngang qua giải cứu...
Dialogue: 0,0:01:14.26,0:01:17.29,Default,SHOUKO,0,0,0,,...thấp đến mức không tưởng luôn đấy.
Dialogue: 1,0:02:43.80,0:02:45.80,Signs,TITLE,0,0,0,,{\an7\fad(1359,308)\bord2\fnArial Black\c&HFFFF91&\3c&HF8C034&\blur1\pos(200,262)\frz14.71\4c&HFFFC65&\shad2}Thức Tỉnh Với Trang Bị Tối Thượng Và Chiến Hạm Không Gian!
Dialogue: 0,0:02:45.43,0:02:48.05,Signs,TITLE,0,0,0,,{\an7\fad(396,1)\bord2\fnArial Black\c&HF6FAFE&\3c&HA46B01&\frz14.71\pos(200,262)\4c&H00DFE2&\shad2}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:02:48.72,0:02:50.27,Default,HIRO,0,0,0,,Khám sức khỏe tổng quát á?
Dialogue: 0,0:02:50.31,0:02:54.27,Signs,EPTITLE,0,0,0,,{\fad(736,888)\fnVerdana\c&HE2DFE3&\shad2\b0\blur3\t(27,736,\blur0.2)\t(3072,3947,\blur3)\pos(104,258.5)\4c&H544A50&}Hệ Sao Arein
Dialogue: 0,0:02:50.27,0:02:53.13,Default,MIMI,0,0,0,,Vâng ạ. Tập đoàn Công nghệ Inagawa
Dialogue: 0,0:02:53.13,0:02:57.93,Default,MIMI,0,0,0,,là một trong hai tập đoàn công nghệ sinh học \Nhàng đầu tại Hệ sao Arein này.
Dialogue: 0,0:02:57.93,0:03:00.24,Default,MIMI,0,0,0,,Em nghĩ họ chắc chắn có \Ncác trang thiết bị y tế tối tân nhất,
Dialogue: 0,0:03:00.51,0:03:06.58,Default,MIMI,0,0,0,,nên em đã yêu cầu được khám sức khỏe \Nnhư một phần thù lao cứu tàu Koueimaru,
Dialogue: 0,0:03:06.58,0:03:09.03,Default,MIMI,0,0,0,,và họ đã mời chúng ta đến kiểm tra ạ.
Dialogue: 0,0:03:09.03,0:03:12.99,Default,ELMA,0,0,0,,Đúng là việc duy trì sức khỏe \Ncho thuyền viên rất quan trọng.
Dialogue: 0,0:03:12.99,0:03:15.51,Default,ELMA,0,0,0,,Em chu đáo thật đấy, Mimi.
Dialogue: 0,0:03:17.45,0:03:20.68,Default,HIRO,0,0,0,,Bõ công chúng ta hộ tống tàu của họ \Nsau khi giải cứu nhỉ.
Dialogue: 0,0:03:20.68,0:03:23.55,Default,HIRO,0,0,0,,Được rồi, vậy cả ba chúng ta cùng đi khám thôi.
Dialogue: 0,0:03:23.55,0:03:25.07,Default,MIMI,0,0,0,,Nhất là anh đấy ạ.
Dialogue: 0,0:03:25.07,0:03:25.64,Default,HIRO,0,0,0,,Hở?
Dialogue: 0,0:03:25.64,0:03:30.10,Default,MIMI,0,0,0,,Anh nhân cơ hội này đi kiểm tra \Ncho kỹ chứng mất trí nhớ của mình đi.
Dialogue: 0,0:03:30.10,0:03:33.05,Default,MIMI,0,0,0,,Anh phải biết chăm sóc bản thân mình hơn chứ.
Dialogue: 0,0:03:33.05,0:03:35.02,Default,HIRO,0,0,0,,Đ-Được rồi.
Dialogue: 0,0:03:40.36,0:03:41.37,Default,ELMA,0,0,0,,Này.
Dialogue: 0,0:03:41.37,0:03:44.83,Default,ELMA,0,0,0,,Cậu bịa ra cái vụ mất trí nhớ đó, \Nđúng không?
Dialogue: 0,0:03:47.39,0:03:49.22,Default,HIRO,0,0,0,,Tôi không hề nói dối.
Dialogue: 0,0:03:49.22,0:03:50.74,Default,ELMA,0,0,0,,Là chuyện cậu không thể nói ra à?
Dialogue: 0,0:03:52.22,0:03:55.93,Default,HIRO,0,0,0,,Cũng không hẳn, nhưng nói ra khéo cô lại tưởng thần kinh tôi có vấn đề.
Dialogue: 0,0:03:55.93,0:03:56.70,Default,ELMA,0,0,0,,Ý cậu là sao cơ?
Dialogue: 0,0:03:57.00,0:03:57.97,Default,HIRO,0,0,0,,Cô thực sự muốn biết à?
Dialogue: 0,0:03:57.97,0:03:58.66,Default,ELMA,0,0,0,,Muốn chứ.
Dialogue: 0,0:03:58.96,0:04:02.64,Default,HIRO,0,0,0,,Được rồi. Biết bắt đầu từ đâu đây nhỉ...
Dialogue: 0,0:04:06.69,0:04:08.48,Default,ELMA,0,0,0,,Thế giới khác á?
Dialogue: 0,0:04:08.72,0:04:10.93,Default,HIRO,0,0,0,,Thấy chưa? Giờ cô đang nghi ngờ thần kinh tôi rồi đấy.
Dialogue: 0,0:04:12.01,0:04:13.39,Default,ELMA,0,0,0,,Hầy, sao cũng được.
Dialogue: 0,0:04:14.34,0:04:20.13,Default,ELMA,0,0,0,,Mấy chuyện về thế giới khác, trò chơi, \Nvới cả dân văn phòng đúng là khó tin thật,
Dialogue: 0,0:04:20.13,0:04:21.57,Default,ELMA,0,0,0,,nhưng điều {\i1}bản thân cậu{\i0} muốn làm là gì?
Dialogue: 0,0:04:21.57,0:04:25.28,Default,HIRO,0,0,0,,Tôi thấy hạnh phúc với những gì mình đang làm hiện tại.
Dialogue: 0,0:04:25.62,0:04:27.50,Default,ELMA,0,0,0,,Vậy thì chẳng có vấn đề gì cả.
Dialogue: 0,0:04:28.03,0:04:33.46,Default,ELMA,0,0,0,,Cậu đến từ đâu cũng chẳng làm thay đổi \Ncách tôi nhìn nhận về cậu đâu.
Dialogue: 0,0:04:33.46,0:04:36.42,Default,HIRO,0,0,0,,Elma... Cô đúng là một người phụ nữ tuyệt vời đấy.
Dialogue: 0,0:04:37.23,0:04:40.62,Default,ELMA,0,0,0,,Đương nhiên rồi! Cậu nghĩ tôi là ai chứ?
Dialogue: 0,0:04:40.90,0:04:42.67,Default,HIRO,0,0,0,,Một nàng elf vũ trụ phế phẩm.
Dialogue: 0,0:04:43.10,0:04:45.30,Default,ELMA,0,0,0,,Muốn gây sự thì tôi chiều nhé.
Dialogue: 0,0:04:45.30,0:04:47.00,Default,HIRO,0,0,0,,Ồ? Cô nhào vô xem nào?
Dialogue: 0,0:04:47.00,0:04:50.47,Default,HIRO,0,0,0,,Nhanh quá! Ái đau đau đau! Tha cho tôi, xin hàng!
Dialogue: 0,0:04:50.71,0:04:53.97,DefaultItalics,HIRO/NA,0,0,0,,Sau đó, cô ấy dùng thế khóa siết \Nlàm tôi phải khóc ròng xin tha.
Dialogue: 0,0:05:01.06,0:05:02.53,Default,HIRO,0,0,0,,Rộng lớn thật đấy.
Dialogue: 0,0:05:02.53,0:05:04.23,Default,MIMI,0,0,0,,Đúng là vậy thật ạ.
Dialogue: 0,0:05:05.41,0:05:07.18,DefaultItalics,GUIDEBOT,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:05:08.20,0:05:10.35,DefaultItalics,GUIDEBOT,0,0,0,,Mời đi lối này ạ.
Dialogue: 0,0:05:11.83,0:05:14.03,Default,HIRO,0,0,0,,Oa, hiện đại quá đi mất.
Dialogue: 0,0:05:14.03,0:05:15.62,Default,HIRO,0,0,0,,Nó hoạt động thế nào nhỉ?
Dialogue: 0,0:05:15.94,0:05:18.41,Default,ELMA,0,0,0,,Cũng chẳng tân tiến đến mức đó đâu.
Dialogue: 0,0:05:25.72,0:05:30.84,Default,SHOUKO,0,0,0,,Tôi là Shouko, bác sĩ phụ trách buổi khám này \Ncủa mọi người. Rất vui được gặp.
Dialogue: 0,0:05:30.84,0:05:32.52,Default,HIRO,0,0,0,,Tôi là Thuyền trưởng Hiro.
Dialogue: 0,0:05:32.52,0:05:34.42,Default,HIRO,0,0,0,,Xin phép được giới thiệu cả Mimi và Elma.
Dialogue: 0,0:05:34.42,0:05:36.56,Default,HIRO,0,0,0,,Rất hân hạnh được diện kiến cô.
Dialogue: 0,0:05:36.91,0:05:41.00,Default,SHOUKO,0,0,0,,Ôi dào, không cần khách sáo câu nệ vậy đâu.
Dialogue: 0,0:05:41.00,0:05:44.03,Default,SHOUKO,0,0,0,,Nghe mỏi hết cả vai ấy chứ. Vả lại...
Dialogue: 0,0:05:44.42,0:05:48.55,Default,SHOUKO,0,0,0,,Các bạn đã cứu mạng tôi mà, \Nsao tôi nỡ để ân nhân phải khép nép thế chứ.
Dialogue: 0,0:05:48.55,0:05:49.45,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:05:51.90,0:05:54.66,Default,HIRO,0,0,0,,Bác sĩ Shouko, cô cũng có mặt trên chiếc tàu chở khách đó sao?
Dialogue: 0,0:05:54.66,0:05:59.34,Default,SHOUKO,0,0,0,,Lúc đó tôi cứ ngỡ bọn tôi tiêu đời rồi chứ.
Dialogue: 0,0:05:59.34,0:06:05.89,Default,SHOUKO,0,0,0,,Chúng tôi đã thoát chết trong gang tấc—\Nà không, chuẩn xác là một phần triệu sợi tóc đấy.
Dialogue: 0,0:06:05.89,0:06:06.80,Default,HIRO,0,0,0,,À vâng.
Dialogue: 0,0:06:06.80,0:06:11.49,Default,SHOUKO,0,0,0,,Chính vì thế tôi mới đích thân xin phụ trách ca khám này.
Dialogue: 0,0:06:11.49,0:06:14.57,Default,SHOUKO,0,0,0,,Thực ra tôi làm bên phòng Nghiên cứu & Phát triển (R&D).
Dialogue: 0,0:06:14.57,0:06:20.77,Default,SHOUKO,0,0,0,,Ôi, đừng lo. Tay nghề của tôi còn ăn đứt \Nmấy tay bác sĩ bình thường nhiều.
Dialogue: 0,0:06:24.35,0:06:26.90,Default,SHOUKO,0,0,0,,Trước tiên, hãy quét toàn thân \Nbằng buồng y tế chuyên dụng nhé.
Dialogue: 0,0:06:29.32,0:06:31.53,Default,MIMI,0,0,0,,Oa, to thật đấy ạ.
Dialogue: 0,0:06:31.94,0:06:34.99,Default,HIRO,0,0,0,,Đây là sản phẩm của Tập đoàn Công nghệ Inagawa sao?
Dialogue: 0,0:06:36.16,0:06:38.13,Default,SHOUKO,0,0,0,,Hỏi đúng chỗ rồi đấy!
Dialogue: 0,0:06:38.13,0:06:42.75,Default,SHOUKO,0,0,0,,Tuy hơi cồng kềnh và đắt đỏ một chút, \Nnhưng hiệu năng thì được chứng nhận đỉnh cao nhé.
Dialogue: 0,0:06:42.75,0:06:47.69,Default,SHOUKO,0,0,0,,Mỗi buồng đều trang bị riêng một siêu máy tính positron \Nđể phục vụ phân tích dữ liệu.
Dialogue: 0,0:06:47.69,0:06:52.41,Default,SHOUKO,0,0,0,,Điểm nhấn đặc biệt nhất chính là \Nnhững cảm biến chuyên dụng
Dialogue: 0,0:06:52.41,0:06:54.55,Default,SHOUKO,0,0,0,,dành cho các xi-lanh điều khiển vị trí của buồng.
Dialogue: 0,0:06:54.55,0:06:58.44,DefaultTop,SHOUKO,0,0,0,,Chúng ứng dụng công nghệ định vị tàu vũ trụ \Nđể chuyển động mượt mà như lụa.
Dialogue: 0,0:06:58.44,0:07:01.80,DefaultTop,SHOUKO,0,0,0,,Bên trong thì êm ái chẳng khác nào \Nchiếc giường ngủ thượng hạng...
Dialogue: 0,0:06:56.68,0:06:58.72,Default,ELMA,0,0,0,,Hóa ra cô ta là một trong {\i1}những kẻ như thế{\i0} à.
Dialogue: 0,0:06:58.72,0:06:59.66,Default,HIRO,0,0,0,,Ừ.
Dialogue: 0,0:06:59.66,0:07:01.31,Default,MIMI,0,0,0,,Ra là vậy ạ.
Dialogue: 0,0:07:04.57,0:07:08.23,Default,SHOUKO,0,0,0,,Nào, cởi hết đồ ra rồi bước vào buồng đi.
Dialogue: 0,0:07:08.23,0:07:11.95,Default,HIRO,0,0,0,,Hả? Cởi hết đồ? Cởi đến mức nào cơ?
Dialogue: 0,0:07:11.95,0:07:15.88,Default,SHOUKO,0,0,0,,Cởi sạch không còn mảnh vải nào. Ôi dào, đừng ngại tôi.
Dialogue: 0,0:07:15.88,0:07:18.37,Default,SHOUKO,0,0,0,,Tôi nhìn cơ thể trần như nhộng của đối tượng quen rồi.
Dialogue: 0,0:07:18.37,0:07:19.21,Default,HIRO,0,0,0,,Thực ra thì...
Dialogue: 0,0:07:19.21,0:07:20.95,DefaultItalics,HIRO/ID,0,0,0,,Tôi thấy cũng hơi ngại đấy chứ.
Dialogue: 0,0:07:21.88,0:07:24.06,Default,ELMA,0,0,0,,Cấm có nhìn sang bên này đấy!
Dialogue: 0,0:07:24.06,0:07:25.83,Default,ELMA,0,0,0,,Mimi, mau vào trong buồng đi em!
Dialogue: 0,0:07:25.83,0:07:28.71,Default,ELMA,0,0,0,,Bọn tôi chưa vào trong thì cấm cậu nhúc nhích đấy!
Dialogue: 0,0:07:28.71,0:07:30.27,Default,HIRO,0,0,0,,Rõ, thưa bà chị.
Dialogue: 0,0:07:33.89,0:07:35.09,Default,MIMI,0,0,0,,Cân nặng của mình...
Dialogue: 0,0:07:35.09,0:07:36.20,Default,ELMA,0,0,0,,Cho chị xem nào.
Dialogue: 0,0:07:36.20,0:07:38.45,Default,MIMI,0,0,0,,Không, không được đâu ạ!
Dialogue: 0,0:07:38.45,0:07:40.05,Default,MIMI,0,0,0,,Kìa chị!
Dialogue: 0,0:07:40.36,0:07:46.33,Default,SHOUKO,0,0,0,,Chứng mất trí nhớ mà các bạn lo lắng \Nxem ra chẳng có vấn đề gì cả đâu.
Dialogue: 0,0:07:46.33,0:07:51.77,Default,SHOUKO,0,0,0,,Trái lại, anh khỏe mạnh trên cả tuyệt vời ấy chứ. \NThú vị đến mức kỳ lạ luôn.
Dialogue: 0,0:07:52.38,0:07:54.50,Default,HIRO,0,0,0,,Cô giải thích bằng từ ngữ dễ hiểu hơn được không?
Dialogue: 0,0:07:55.25,0:08:01.46,Default,SHOUKO,0,0,0,,Dữ liệu của anh chứa rất nhiều dạng biểu mẫu \Nmà từ trước tới nay chưa từng được ghi nhận.
Dialogue: 0,0:08:01.46,0:08:02.67,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:08:02.67,0:08:07.45,Default,SHOUKO,0,0,0,,Thông tin di truyền của dạng người chưa xác định \Nchính là ranh giới tiên phong hiện nay.
Dialogue: 0,0:08:07.45,0:08:09.89,Default,SHOUKO,0,0,0,,Những khám phá của chúng tôi trong lĩnh vực này
Dialogue: 0,0:08:09.89,0:08:15.26,Default,SHOUKO,0,0,0,,có tiềm năng đưa nhân loại bước lên một tầm cao mới. \NTầm quan trọng của nó lớn đến thế đấy.
Dialogue: 0,0:08:15.26,0:08:17.20,DefaultItalics,HIRO/ID,0,0,0,,Tầm cao mới ư?
Dialogue: 0,0:08:17.20,0:08:18.84,Default,SHOUKO,0,0,0,,Thế nên là...
Dialogue: 0,0:08:18.84,0:08:21.48,Default,SHOUKO,0,0,0,,Anh có thể cho tôi xin \Nchút vật chất di truyền được không?
Dialogue: 0,0:08:21.48,0:08:21.93,Default,HIRO,0,0,0,,Gì cơ?
Dialogue: 0,0:08:22.23,0:08:23.39,Default,HIRO,0,0,0,,Tôi được lợi lộc gì từ chuyện đó?
Dialogue: 0,0:08:23.39,0:08:25.56,Default,SHOUKO,0,0,0,,Đương nhiên tôi đâu có xin không của anh.
Dialogue: 0,0:08:25.56,0:08:29.43,Default,SHOUKO,0,0,0,,Tôi đã bàn với cấp trên rồi, họ đồng ý \Nchi trả cho anh tới ba triệu Enel lận đấy!
Dialogue: 0,0:08:29.43,0:08:30.81,Default,HIRO,0,0,0,,Nhiều đến thế cơ á?
Dialogue: 0,0:08:31.21,0:08:32.27,Default,SHOUKO,0,0,0,,Anh thấy thế nào?
Dialogue: 0,0:08:35.26,0:08:37.99,Default,HIRO,0,0,0,,Cô nhớ phải bảo mật dữ liệu cá nhân \Ncủa tôi cẩn thận đấy nhé?
Dialogue: 0,0:08:37.99,0:08:39.23,Default,SHOUKO,0,0,0,,Tất nhiên rồi!
Dialogue: 0,0:08:42.72,0:08:46.09,Default,SHOUKO,0,0,0,,Vậy giờ ta tiến hành thu thập máu và tinh dịch nhé.
Dialogue: 0,0:08:46.09,0:08:48.04,Default,HIRO,0,0,0,,Hả? Tinh dịch á?!
Dialogue: 0,0:08:49.71,0:08:53.92,Default,SHOUKO,0,0,0,,Tôi hy vọng anh sẽ thấy hào hứng \Nvới quy trình chiết xuất này.
Dialogue: 0,0:08:55.02,0:08:58.18,Default,HIRO,0,0,0,,N-Nơi này cung cấp cả dịch vụ đó luôn sao?
Dialogue: 0,0:09:00.83,0:09:02.11,Default,HIRO,0,0,0,,Cô... Cô định làm gì thế?
Dialogue: 0,0:09:02.49,0:09:06.80,Default,SHOUKO,0,0,0,,Đừng lo lắng mà. Khối người sau khi thử xong \Nlại sinh ra nghiện ngập món này đấy.
Dialogue: 0,0:09:07.70,0:09:09.51,Default,HIRO,0,0,0,,Tôi... ơ...
Dialogue: 0,0:09:15.32,0:09:16.91,Default,ELMA,0,0,0,,Có chuyện gì thế kia?
Dialogue: 0,0:09:17.38,0:09:20.84,Default,HIRO,0,0,0,,Không có gì đâu. Cứ để tôi yên một mình đi.
Dialogue: 0,0:09:23.21,0:09:26.10,Default,SHOUKO,0,0,0,,Cả ba người đều hoàn toàn khỏe mạnh nhé.
Dialogue: 0,0:09:26.10,0:09:29.27,Default,SHOUKO,0,0,0,,Tôi vừa tiêm cho các bạn vài mũi vắc-xin thiết yếu rồi.
Dialogue: 0,0:09:29.27,0:09:35.17,Default,SHOUKO,0,0,0,,Mọi người chỉ cần nghỉ ngơi trong ba ngày \Nđể phòng ngừa bất kỳ tác dụng phụ nào thôi.
Dialogue: 0,0:09:35.43,0:09:37.76,Default,SHOUKO,0,0,0,,À này, hai cô gái ra đây tôi bảo.
Dialogue: 0,0:09:42.76,0:09:44.55,Default,HIRO,0,0,0,,Họ đang nói chuyện gì thế nhỉ?
Dialogue: 0,0:09:44.55,0:09:47.26,Default,SHOUKO,0,0,0,,Dù sao thì hai đứa cũng phải cẩn thận đấy nhé?
Dialogue: 0,0:09:47.26,0:09:48.06,Default,MIMI,0,0,0,,Vâng ạ.
Dialogue: 0,0:09:48.06,0:09:50.03,Default,ELMA,0,0,0,,Ừ, tôi biết rồi.
Dialogue: 0,0:09:56.07,0:09:58.95,Default,SHOUKO,0,0,0,,Buổi khám sức khỏe kết thúc tại đây.
Dialogue: 0,0:09:58.95,0:10:02.11,Default,SHOUKO,0,0,0,,Tôi sẽ gửi báo cáo chi tiết đến chiến hạm của các bạn.
Dialogue: 0,0:10:06.54,0:10:07.53,Default,HIRO,0,0,0,,Sao nào?
Dialogue: 0,0:10:08.64,0:10:11.80,Default,HIRO,0,0,0,,Vừa xông vào phòng cái là cô câm như hến vậy?
Dialogue: 0,0:10:12.92,0:10:15.24,Default,HIRO,0,0,0,,Kết quả kiểm tra của cô có gì không ổn à?
Dialogue: 0,0:10:23.25,0:10:25.35,Default,HIRO,0,0,0,,Ở đâu ra thế này?
Dialogue: 0,0:10:25.35,0:10:30.80,Default,ELMA,0,0,0,,T-Tôi... m-m-mang...
Dialogue: 0,0:10:30.80,0:10:31.94,Default,HIRO,0,0,0,,Mang?
Dialogue: 0,0:10:33.67,0:10:36.23,Default,HIRO,0,0,0,,Elma, cô... Nồng nặc mùi rượu luôn kìa!
Dialogue: 0,0:10:36.75,0:10:38.19,Default,HIRO,0,0,0,,Cô đã uống bao nhiêu rượu thế hả?
Dialogue: 0,0:10:40.05,0:10:41.72,Default,HIRO,0,0,0,,Ngủ lăn quay ra luôn rồi.
Dialogue: 0,0:10:43.20,0:10:45.62,Default,HIRO,0,0,0,,Cô ấy giờ có thể mang thai sao?
Dialogue: 0,0:10:45.62,0:10:50.10,Default,MIMI,0,0,0,,Dạ chuyện là thế này, ngay cả sau khi trưởng thành,
Dialogue: 0,0:10:50.10,0:10:54.33,Default,MIMI,0,0,0,,phụ nữ tộc Elf thông thường vẫn không thể mang thai.
Dialogue: 0,0:10:54.59,0:10:58.18,Default,MIMI,0,0,0,,Cơ thể của họ sẽ chỉ biến đổi để có thể thụ thai
Dialogue: 0,0:10:58.18,0:11:01.29,Default,MIMI,0,0,0,,khi trong tâm thức họ thực sự \Nchấp nhận bạn đời của mình.
Dialogue: 0,0:11:02.79,0:11:05.79,Default,HIRO,0,0,0,,Đó là một cơ chế sinh tồn à?
Dialogue: 0,0:11:05.79,0:11:09.27,Default,HIRO,0,0,0,,Anh không rành lắm, nhưng Elf vũ trụ \Nđúng là tuyệt vời thật đấy!
Dialogue: 0,0:11:10.03,0:11:12.63,Default,ELMA,0,0,0,,Cậu đừng có tỏ vẻ đắc ý như thế!
Dialogue: 0,0:11:12.63,0:11:16.23,Default,MIMI,0,0,0,,Chị Elma, không được dùng bạo lực \Nđể che giấu sự ngượng ngùng đâu nhé.
Dialogue: 0,0:11:17.69,0:11:20.65,Default,HIRO,0,0,0,,Chà, có một điều chúng ta vừa nhận ra đấy.
Dialogue: 0,0:11:22.11,0:11:25.62,Default,HIRO,0,0,0,,Elma đã trót yêu say đắm tôi mất rồi.
Dialogue: 0,0:11:26.25,0:11:30.03,Default,HIRO,0,0,0,,Ái đau đau đau!
Dialogue: 0,0:11:27.55,0:11:30.03,DefaultTop,MIMI,0,0,0,,C-Chị Elma ơi, bình tĩnh lại đi ạ!
Dialogue: 0,0:11:30.03,0:11:34.83,DefaultTop,MIMI,0,0,0,,Còn anh Hiro, không được trêu chọc chị Elma nữa!
Dialogue: 0,0:11:30.08,0:11:35.04,Signs,TITLE,0,0,0,,{\fad(901,1)\fs12\fscx88\an7\bord1.5\fnArial Black\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(462,274)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:11:35.04,0:11:40.05,Signs,TITLE,0,0,0,,{\fs12\fscx88\an7\bord1.5\fnArial Black\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(452,270)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:11:40.26,0:11:45.50,DefaultItalicsTop,ANNOUNCEMENT,0,0,0,,Chào mừng quý khách đến với cơ sở sản xuất \Nthịt nhân tạo của Tập đoàn Cierra.
Dialogue: 0,0:11:45.50,0:11:49.38,DefaultItalicsTop,ANNOUNCEMENT,0,0,0,,Hãy cùng chiêm ngưỡng hệ thống sản xuất thịt nuôi cấy \Nhàng đầu của công ty chúng tôi.
Dialogue: 0,0:11:45.69,0:11:47.78,Default,MIMI,0,0,0,,Không biết họ làm ra nó thế nào nhỉ.
Dialogue: 0,0:11:47.78,0:11:50.59,Default,MIMI,0,0,0,,Thật may vì hôm qua em đã đặt lịch tham quan trước.
Dialogue: 0,0:11:50.59,0:11:54.90,Default,HIRO,0,0,0,,Ừ. Hệ sao Arein toàn là các viện nghiên cứu công nghệ sinh học,
Dialogue: 0,0:11:54.90,0:11:57.45,Default,HIRO,0,0,0,,nên cũng chẳng có nhiều chỗ vui chơi giải trí.
Dialogue: 0,0:11:57.45,0:11:59.50,Default,HIRO,0,0,0,,Đi thế này cũng là cách hay để giết thời gian.
Dialogue: 0,0:11:59.50,0:12:00.48,Default,HIRO,0,0,0,,Đúng không, Elma?
Dialogue: 0,0:12:01.29,0:12:02.94,Default,ELMA,0,0,0,,Tôi cũng mong là vậy.
Dialogue: 0,0:12:12.30,0:12:14.88,Default,HIRO,0,0,0,,Đó là trứng hay gì thế kia?
Dialogue: 0,0:12:14.88,0:12:17.25,Default,MIMI,0,0,0,,Nhìn nhỏ nhắn đáng yêu thật đấy.
Dialogue: 0,0:12:22.60,0:12:28.09,DefaultItalics,ANNOUNCEMENT,0,0,0,,Và đây là công đoạn cuối cùng trước khi \Nthịt nhân tạo của chúng tôi sẵn sàng xuất xưởng!
Dialogue: 0,0:12:29.10,0:12:31.32,Default,ELMA,0,0,0,,Đó là lý do tôi không hề muốn đến đây chút nào.
Dialogue: 0,0:12:34.37,0:12:37.26,DefaultItalics,ANNOUNCEMENT,0,0,0,,Cảm ơn quý khách đã ghé thăm ngày hôm nay.
Dialogue: 0,0:12:38.36,0:12:42.24,Default,HIRO,0,0,0,,Thật không ngờ họ lại bắt chúng ta \Ntận mắt chứng kiến cảnh xẻ thịt lũ quái vật đó.
Dialogue: 0,0:12:42.24,0:12:45.45,Default,MIMI,0,0,0,,Chắc một thời gian dài nữa \Nem không dám nuốt nổi miếng thịt nào mất.
Dialogue: 0,0:12:45.72,0:12:47.43,Default,ELMA,0,0,0,,Xin chia buồn cùng em nhé.
Dialogue: 0,0:12:49.12,0:12:53.57,Default,MIMI,0,0,0,,Chúng ta chuyển sang điểm tham quan tiếp theo \Nđể khuây khỏa đi ạ.
Dialogue: 0,0:12:55.53,0:13:00.51,Default,ELMA,0,0,0,,Eo ôi. Chỗ phân bón đó được chế xuất từ \Nrác thải sinh hoạt thu gom từ các con tàu đấy.
Dialogue: 0,0:13:00.51,0:13:02.85,Default,MIMI,0,0,0,,Rác thải sinh hoạt ạ?
Dialogue: 0,0:13:02.85,0:13:04.60,Default,HIRO,0,0,0,,Tái chế à?
Dialogue: 0,0:13:04.60,0:13:07.46,Default,HIRO,0,0,0,,Ở quê nhà tôi chuyện đó hết sức bình thường luôn.
Dialogue: 0,0:13:07.46,0:13:10.03,Default,ELMA,0,0,0,,Nghe là biết cậu đến từ \Nmột hành tinh kém phát triển rồi.
Dialogue: 0,0:13:10.03,0:13:12.18,Default,HIRO,0,0,0,,Đừng có nói kiểu mỉa mai thế chứ.
Dialogue: 0,0:13:29.12,0:13:31.91,Default,ELMA,0,0,0,,Uống trực tiếp từ quả thế này \Ntrông tao nhã ghê.
Dialogue: 0,0:13:32.38,0:13:35.00,Default,MIMI,0,0,0,,Em cá là ăn nhiều quả này \Ncũng say bí tỉ luôn đấy ạ.
Dialogue: 0,0:13:35.00,0:13:36.88,Default,ELMA,0,0,0,,Muốn thử một quả không, Hiro? A nào.
Dialogue: 0,0:13:39.00,0:13:40.66,Default,HIRO,0,0,0,,Rượu cồn sao?!
Dialogue: 0,0:13:40.66,0:13:43.31,Default,HIRO,0,0,0,,Bản thân quả này đã chứa cồn rồi à?
Dialogue: 0,0:13:44.64,0:13:49.09,Default,HIRO,0,0,0,,Công nghệ biến đổi gen của thế giới này \Nđiên rồ thật đấy.
Dialogue: 0,0:13:49.09,0:13:50.81,Default,ELMA,0,0,0,,Hiro à...
Dialogue: 0,0:13:51.80,0:13:55.77,Default,MIMI,0,0,0,,Tự nhiên em thấy người cứ lâng lâng sao ấy, anh Hiro...
Dialogue: 0,0:13:56.15,0:13:59.72,Default,HIRO,0,0,0,,Hai người này cũng bắt đầu 'ngáo' luôn rồi.
Dialogue: 0,0:14:00.03,0:14:01.53,Default,MAN,0,0,0,,Đứng im, đừng chống cự nữa!
Dialogue: 0,0:14:02.18,0:14:04.15,Default,SHOUKO,0,0,0,,Dừng tay lại, đồ khốn kiếp!
Dialogue: 0,0:14:05.06,0:14:08.41,Default,HIRO,0,0,0,,Cái số của mình ở vũ trụ này \Nchẳng bao giờ thoát khỏi rắc rối nhỉ?
Dialogue: 0,0:14:09.11,0:14:10.06,Default,MIMI,0,0,0,,Anh Hiro?
Dialogue: 0,0:14:10.06,0:14:11.11,Default,ELMA,0,0,0,,Hiro?
Dialogue: 0,0:14:14.69,0:14:15.66,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:14:15.94,0:14:17.12,Default,SHOUKO,0,0,0,,L-Là anh!
Dialogue: 0,0:14:17.48,0:14:18.52,Default,HIRO,0,0,0,,Lại gặp nhau rồi nhỉ.
Dialogue: 0,0:14:19.08,0:14:21.80,Default,HIRO,0,0,0,,Khoan đã nào, đừng có manh động đấy nhé.
Dialogue: 0,0:14:24.99,0:14:29.72,Default,HIRO,0,0,0,,Tôi chẳng rõ đầu đuôi sự tình ra sao, \Nnhưng tốt nhất các người nên quay đầu bước đi đi?
Dialogue: 0,0:14:54.23,0:14:56.20,Default,HIRO,0,0,0,,Là người máy sinh học à?
Dialogue: 0,0:14:56.86,0:14:58.20,Default,HIRO,0,0,0,,Cô không sao chứ?
Dialogue: 0,0:14:58.20,0:15:01.41,Default,SHOUKO,0,0,0,,Vâng. Anh lại cứu mạng tôi thêm một lần nữa rồi.
Dialogue: 0,0:15:01.78,0:15:04.04,Default,HIRO,0,0,0,,Đã xảy ra chuyện gì thế?
Dialogue: 0,0:15:04.04,0:15:07.27,Default,SHOUKO,0,0,0,,Chuyện là... có khi tại anh cả đấy.
Dialogue: 0,0:15:07.27,0:15:08.10,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:15:09.00,0:15:12.29,Default,SHOUKO,0,0,0,,Tôi bị những kẻ khả nghi tấn công \Ntrên đường di chuyển
Dialogue: 0,0:15:12.29,0:15:15.15,Default,SHOUKO,0,0,0,,từ trung tâm y tế sang phòng thí nghiệm.
Dialogue: 0,0:15:15.15,0:15:18.58,Default,SHOUKO,0,0,0,,Tôi đã chớp được cơ hội bỏ chạy,
Dialogue: 0,0:15:19.26,0:15:21.76,Default,SHOUKO,0,0,0,,và đúng lúc đó thì được anh ra tay tương cứu.
Dialogue: 0,0:15:21.76,0:15:24.10,Default,MIMI,0,0,0,,Hóa ra câu chuyện là như vậy ạ.
Dialogue: 0,0:15:24.10,0:15:27.74,Default,ELMA,0,0,0,,Cậu lúc nào cũng vướng vào rắc rối nhỉ?
Dialogue: 0,0:15:28.28,0:15:31.46,Default,ELMA,0,0,0,,Cẩn thận đấy. Tên này chuyên câu dẫn gái kiểu đó đấy.
Dialogue: 0,0:15:31.83,0:15:33.00,Default,SHOUKO,0,0,0,,Thật thế sao?
Dialogue: 0,0:15:33.00,0:15:34.40,Default,HIRO,0,0,0,,Tôi vô tội mà.
Dialogue: 0,0:15:34.68,0:15:37.37,Default,HIRO,0,0,0,,Thế cô có biết lý do tại sao \Nbọn chúng lại tấn công cô không?
Dialogue: 0,0:15:37.84,0:15:40.77,Default,SHOUKO,0,0,0,,Mục tiêu chính của chúng không phải bắt cóc tôi.
Dialogue: 0,0:15:40.77,0:15:43.34,Default,SHOUKO,0,0,0,,Nhiều khả năng chúng nhắm vào \Nthứ nằm trong chiếc vali tôi cầm theo.
Dialogue: 0,0:15:43.65,0:15:45.16,Default,HIRO,0,0,0,,Trong đó chứa cái gì?
Dialogue: 0,0:15:45.16,0:15:47.26,Default,SHOUKO,0,0,0,,Dữ liệu di truyền của anh đấy.
Dialogue: 0,0:15:47.26,0:15:49.20,Default,ALL,0,0,0,,CÁI GÌ CƠ?!
Dialogue: 0,0:15:49.46,0:15:52.19,Default,SHOUKO,0,0,0,,Nên mới bảo là tại anh đó thôi.
Dialogue: 0,0:15:52.19,0:15:54.69,Default,HIRO,0,0,0,,Vô lý. Cô đừng hòng đổ vạ lên đầu tôi.
Dialogue: 0,0:15:56.03,0:15:58.19,Default,SHOUKO,0,0,0,,Cơ mà, đó chẳng phải chiếc vali bình thường đâu.
Dialogue: 0,0:15:58.19,0:16:01.90,Default,SHOUKO,0,0,0,,Bọn chúng không dễ gì lấy được đồ bên trong, \Nhơn nữa nó còn gắn máy định vị.
Dialogue: 0,0:16:01.90,0:16:05.71,Default,SHOUKO,0,0,0,,Chính quyền thuộc địa và các chuyên viên của chúng tôi \Nsẽ phối hợp truy tìm,
Dialogue: 0,0:16:05.71,0:16:07.42,Default,SHOUKO,0,0,0,,nên thể nào cũng sẽ sớm tìm ra thôi.
Dialogue: 0,0:16:08.06,0:16:09.68,Default,SHOUKO,0,0,0,,Ôi, nhắc tào tháo là tào tháo tới liền.
Dialogue: 0,0:16:10.00,0:16:11.58,Default,SHOUKO,0,0,0,,Cảm ơn anh rất nhiều.
Dialogue: 0,0:16:11.58,0:16:14.32,Default,SHOUKO,0,0,0,,Anh đã cứu mạng tôi không chỉ một mà tận hai lần.
Dialogue: 0,0:16:14.32,0:16:17.66,Default,SHOUKO,0,0,0,,Có lẽ anh chính là kỵ sĩ định mệnh của đời tôi rồi.
Dialogue: 0,0:16:17.89,0:16:19.62,Default,HIRO,0,0,0,,Nghe vậy tôi cũng mát lòng mát dạ.
Dialogue: 0,0:16:22.17,0:16:24.68,Default,SQUAD A,0,0,0,,Tiến sĩ, ban lãnh đạo đang nổi lôi đình đấy ạ.
Dialogue: 0,0:16:24.68,0:16:28.68,Default,SHOUKO,0,0,0,,Tôi biết rồi, xin lỗi nhé. Lần sau tôi sẽ xin đội hộ tống.
Dialogue: 0,0:16:29.57,0:16:31.54,Default,HIRO,0,0,0,,Cô ta suốt ngày gây rắc rối nhỉ.
Dialogue: 0,0:16:32.48,0:16:37.66,Default,ELMA,0,0,0,,Vướng vào biến cố ở một thuộc địa an toàn \Nnhư thế này cũng là một loại tài năng đấy.
Dialogue: 0,0:16:37.66,0:16:40.61,Default,MIMI,0,0,0,,Chẳng biết anh còn kéo thêm rắc rối nào nữa không đây?
Dialogue: 0,0:16:42.08,0:16:44.52,DefaultItalics,HIRO/ID,0,0,0,,Mình khẳng định là mình hoàn toàn vô tội.
Dialogue: 0,0:16:50.28,0:16:53.37,Default,SERENA,0,0,0,,Tôi đã đợi anh rất lâu rồi đấy, Thuyền trưởng Hiro.
Dialogue: 0,0:16:58.43,0:17:00.58,Default,SERENA,0,0,0,,Tôi đã được thăng chức
Dialogue: 0,0:17:00.58,0:17:05.03,Default,SERENA,0,0,0,,nhờ ghi nhận công lao trên phòng tuyến phòng thủ \Ntại Hệ sao Tarmein.
Dialogue: 0,0:17:05.03,0:17:07.16,Default,SERENA,0,0,0,,Hiện tại tôi là Thiếu tá Serena Holz.
Dialogue: 0,0:17:07.16,0:17:09.13,Default,HIRO,0,0,0,,Chúc mừng cô nhé.
Dialogue: 0,0:17:09.13,0:17:13.48,Default,SERENA,0,0,0,,Tất cả cũng là nhờ vào những nỗ lực phi thường của anh.
Dialogue: 0,0:17:13.48,0:17:17.08,Default,SERENA,0,0,0,,Đó là chưa kể đám sinh vật tinh thể may mắn thay,
Dialogue: 0,0:17:17.08,0:17:18.83,Default,SERENA,0,0,0,,chẳng hiểu vì lý do gì lại lao vào tấn công hạm đội địch.
Dialogue: 0,0:17:18.83,0:17:21.19,Default,HIRO,0,0,0,,Vâng, đúng là may mắn thật đấy.
Dialogue: 0,0:17:21.19,0:17:24.43,Default,HIRO,0,0,0,,Tôi chỉ tình cờ có mặt ở đó thôi, \Nmà sợ toát cả mồ hôi hột ra ấy chứ.
Dialogue: 0,0:17:31.12,0:17:34.03,Default,HIRO,0,0,0,,Sao cô không vào thẳng vấn đề chính luôn đi?
Dialogue: 0,0:17:34.82,0:17:35.98,Default,SERENA,0,0,0,,Được thôi.
Dialogue: 0,0:17:36.46,0:17:41.77,Default,SERENA,0,0,0,,Tôi được giao trọng trách chỉ huy \Nbiệt đội săn hải tặc độc lập mới thành lập.
Dialogue: 0,0:17:41.77,0:17:46.08,Default,SERENA,0,0,0,,Đơn vị này được chính thức phê duyệt \Ndựa trên chiến công gần đây của tôi.
Dialogue: 0,0:17:46.90,0:17:48.53,Default,HIRO,0,0,0,,Biệt đội săn hải tặc ư?
Dialogue: 0,0:17:48.53,0:17:51.54,Default,SERENA,0,0,0,,Thay vì phụ thuộc hoàn toàn vào lính đánh thuê,
Dialogue: 0,0:17:51.54,0:17:56.03,Default,SERENA,0,0,0,,Quân đội Đế Quốc đã lập ra một đơn vị cơ động \Nnhằm tiêu diệt lũ hải tặc không gian,
Dialogue: 0,0:17:56.03,0:17:59.01,Default,SERENA,0,0,0,,những kẻ đe dọa đến sự phồn vinh \Nvà nền hòa bình của hệ sao.
Dialogue: 0,0:17:59.42,0:18:02.47,Default,SERENA,0,0,0,,Đó chính là Biệt đội Săn Hải Tặc của tôi.
Dialogue: 0,0:18:03.18,0:18:04.43,Default,HIRO,0,0,0,,Rồi sao nữa?
Dialogue: 0,0:18:05.16,0:18:09.60,Default,SERENA,0,0,0,,Tôi tới đây vì có một công việc dành cho anh.
Dialogue: 0,0:18:09.60,0:18:10.40,Default,HIRO,0,0,0,,Một công việc?
Dialogue: 0,0:18:11.40,0:18:16.88,Default,SERENA,0,0,0,,Quân đội Đế Quốc rất am hiểu \Ntác chiến hạm đội và đánh chiếm căn cứ,
Dialogue: 0,0:18:16.88,0:18:21.07,Default,SERENA,0,0,0,,nhưng chúng tôi lại thiếu bí quyết đối phó với \Nlũ hải tặc không gian chuyên đánh du kích.
Dialogue: 0,0:18:21.07,0:18:22.63,Default,HIRO,0,0,0,,Ừ, tôi hiểu mà.
Dialogue: 0,0:18:22.92,0:18:25.23,Default,HIRO,0,0,0,,Lũ hải tặc đâu có ngu ngốc.
Dialogue: 0,0:18:25.23,0:18:29.78,Default,HIRO,0,0,0,,Thấy cả một hạm đội kéo tới \Nthì chúng chạy biến hoặc trốn biệt tăm rồi.
Dialogue: 0,0:18:29.78,0:18:31.16,Default,SERENA,0,0,0,,Chính vì thế...
Dialogue: 0,0:18:31.87,0:18:36.83,Default,SERENA,0,0,0,,Tôi muốn một chuyên gia săn hải tặc \Nnhư anh chỉ dạy cho chúng tôi.
Dialogue: 0,0:18:37.23,0:18:38.30,Default,HIRO,0,0,0,,Hả?
Dialogue: 0,0:18:39.33,0:18:42.01,Default,HIRO,0,0,0,,Tôi hiểu rồi. Tôi nắm được rồi.
Dialogue: 0,0:18:42.01,0:18:42.64,Default,SERENA,0,0,0,,Vậy thì—
Dialogue: 0,0:18:42.99,0:18:44.25,Default,HIRO,0,0,0,,Và tôi từ chối.
Dialogue: 0,0:18:44.48,0:18:45.48,Default,SERENA,0,0,0,,Tại sao chứ?
Dialogue: 0,0:18:45.73,0:18:47.56,Default,HIRO,0,0,0,,Tại sao tôi {\i1}lại phải{\i0} nhận một công việc như thế?
Dialogue: 0,0:18:47.56,0:18:50.61,Default,HIRO,0,0,0,,Cô đi mà nhờ Công hội Lính Đánh Thuê ấy.
Dialogue: 0,0:18:50.61,0:18:52.86,Default,SERENA,0,0,0,,Người tôi muốn học hỏi là {\i1}anh{\i0} kia mà.
Dialogue: 0,0:18:52.86,0:18:53.68,Default,HIRO,0,0,0,,Không đời nào.
Dialogue: 0,0:18:53.68,0:18:56.91,Default,SERNA,0,0,0,,Sao anh lại cứng đầu cứng cổ thế hả?
Dialogue: 0,0:18:56.91,0:18:58.12,Default,HIRO,0,0,0,,Bởi vì...
Dialogue: 0,0:18:58.38,0:19:01.93,DefaultItalics,HIRO/ID,0,0,0,,Bởi vì dính líu đến cô phiền phức bỏ xừ. \NRõ như ban ngày rồi còn gì.
Dialogue: 0,0:19:02.32,0:19:04.47,DefaultItalics,HIRO/ID,0,0,0,,Nhưng mình không thể nói toẹt ra câu đó được.
Dialogue: 0,0:19:05.12,0:19:09.49,Default,HIRO,0,0,0,,Thù lao chắc gì đã bõ, vả lại tôi không muốn \Nbị trói buộc chân tay quá lâu đâu.
Dialogue: 0,0:19:09.49,0:19:12.29,Default,HIRO,0,0,0,,Mà sao nhất định cứ phải là tôi cơ chứ?
Dialogue: 0,0:19:13.76,0:19:19.09,Default,SERENA,0,0,0,,Anh sở hữu tư duy đột phá, phi chính quy—\Nvà hiếm có hơn nữa là lòng quả cảm để hiện thực hóa nó.
Dialogue: 0,0:19:19.09,0:19:23.63,Default,SERENA,0,0,0,,Chiến thuật của anh ngông cuồng đến mức phi lý, \Nthế nhưng anh vẫn làm nên kỳ tích.
Dialogue: 0,0:19:23.63,0:19:25.69,DefaultItalics,HIRO/ID,0,0,0,,Cô ta đang khen đểu mình đấy à?
Dialogue: 0,0:19:26.39,0:19:29.26,Default,SERENA,0,0,0,,Hãy dạy cho tôi cách thức tàn bạo, tàn nhẫn,
Dialogue: 0,0:19:29.26,0:19:34.68,Default,SERENA,0,0,0,,và triệt để quét sạch lũ rác rưởi hải tặc ấy đi!
Dialogue: 0,0:19:36.88,0:19:40.11,Default,SERENA,0,0,0,,Làm ơn! Tôi tha thiết khẩn cầu sự giúp đỡ của anh!
Dialogue: 0,0:19:44.17,0:19:47.72,Default,ELMA,0,0,0,,Để một vị chỉ huy quý tộc Đế Quốc phải hạ mình van nài \Nđến mức đó mà cậu còn từ chối,
Dialogue: 0,0:19:47.72,0:19:49.99,Default,ELMA,0,0,0,,thì hậu quả khôn lường đấy nhé.
Dialogue: 0,0:19:54.42,0:19:56.13,Default,HIRO,0,0,0,,Được rồi. Cô nợ tôi một ân huệ đấy.
Dialogue: 0,0:19:56.44,0:19:58.09,Default,SERENA,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:19:58.37,0:20:01.09,Default,SERENA,0,0,0,,Vậy là chúng ta đã đạt thỏa thuận.
Dialogue: 0,0:20:01.09,0:20:03.06,Default,SERENA,0,0,0,,Một khi hoàn thành nhiệm vụ,
Dialogue: 0,0:20:03.06,0:20:08.40,Default,SERENA,0,0,0,,Thuyền trưởng Hiro, tôi sẽ ban cho anh vinh dự \Nđược trở thành lính đánh thuê riêng của tôi.
Dialogue: 0,0:20:09.27,0:20:13.17,Default,SERENA,0,0,0,,Với tư cách Thiếu tá Đế Quốc \Nkiêm con gái của Hầu tước,
Dialogue: 0,0:20:13.17,0:20:16.44,Default,SERENA,0,0,0,,các mối quan hệ của tôi sẽ mang lại \Nlợi ích vô bờ bến cho anh.
Dialogue: 0,0:20:16.44,0:20:20.48,Default,SERENA,0,0,0,,Nó cũng sẽ giúp anh tránh khỏi rắc rối \Nvới giới quý tộc lẫn quân đội Đế Quốc nữa.
Dialogue: 0,0:20:21.65,0:20:24.60,Default,HIRO,0,0,0,,Cô đang nói nghiêm túc đấy à?
Dialogue: 0,0:20:24.60,0:20:27.57,Default,SERENA,0,0,0,,Đúng vậy. Có vấn đề gì sao?
Dialogue: 0,0:20:27.87,0:20:30.03,Default,HIRO,0,0,0,,Để tôi nói cho cô nghe điều này nhé.
Dialogue: 0,0:20:30.03,0:20:34.00,Default,HIRO,0,0,0,,Phần thưởng cho việc hoàn thành công việc \Nlà trở thành lính đánh thuê riêng của cô á?
Dialogue: 0,0:20:34.00,0:20:36.62,Default,HIRO,0,0,0,,Thế chẳng phải sẽ bó buộc mọi hành động của tôi sao?
Dialogue: 0,0:20:36.62,0:20:37.95,Default,SERENA,0,0,0,,C-Chuyện đó...
Dialogue: 0,0:20:38.29,0:20:42.69,Default,HIRO,0,0,0,,Nó sẽ bóp chết phong cách lính đánh thuê \Ntự do phóng khoáng của tôi mất.
Dialogue: 0,0:20:42.69,0:20:47.89,Default,HIRO,0,0,0,,Chưa kể, chẳng có gì đảm bảo là cô sẽ bảo bọc \Nmỗi khi tôi gặp phải rắc rối.
Dialogue: 0,0:20:47.89,0:20:50.92,Default,HIRO,0,0,0,,Nếu cô phủi tay ruồng bỏ tôi lúc nguy cấp nhất, \Nthì tôi chỉ có nước chết chắc.
Dialogue: 0,0:20:50.92,0:20:54.51,Default,HIRO,0,0,0,,Nói thật lòng, tôi chẳng hời được bao nhiêu \Nkhi làm lính đánh thuê riêng cho cô cả.
Dialogue: 0,0:20:54.51,0:20:57.00,Default,HIRO,0,0,0,,Ngược lại, cái mất còn nhiều hơn cái được nữa là.
Dialogue: 0,0:20:57.32,0:20:59.26,Default,HIRO,0,0,0,,Tôi chỉ muốn được tự do thôi!
Dialogue: 0,0:21:00.23,0:21:02.95,Default,MIMI,0,0,0,,Anh Hiro, anh nói như vậy là hơi quá rồi đấy ạ!
Dialogue: 0,0:21:02.95,0:21:05.66,Default,ELMA,0,0,0,,Cô ấy là quý tộc đấy! Cậu có thể bị xử chém \Nchỉ vì tội bất kính này đấy biết không hả?!
Dialogue: 0,0:21:09.81,0:21:14.22,Default,SERENA,0,0,0,,Anh là tay lính đánh thuê đầu tiên \Ndám ăn nói xấc xược như thế trước mặt tôi đấy!
Dialogue: 0,0:21:14.22,0:21:16.05,Default,SERENA,0,0,0,,Tôi lại càng thêm mê anh rồi đấy!
Dialogue: 0,0:21:16.05,0:21:22.00,Default,SERENA,0,0,0,,Mèo nhà thì đáng yêu thật, nhưng tôi càng ngưỡng mộ \Nsự kiên cường bất kham của một chú mèo hoang hơn.
Dialogue: 0,0:21:22.00,0:21:23.46,Default,HIRO,0,0,0,,Cô bảo ai là mèo hoang cơ?!
Dialogue: 0,0:21:23.77,0:21:28.41,Default,SERENA,0,0,0,,Anh nói đúng. Tôi sẽ đợi cho anh ăn no nê đẫy đà \Nrồi mới chính thức đeo vòng cổ cho anh.
Dialogue: 0,0:21:30.02,0:21:34.10,Default,SERENA,0,0,0,,Hôm nay tôi tạm tha cho anh đấy, \Nnhưng nhớ cho kỹ điều này:
Dialogue: 0,0:21:34.10,0:21:38.50,Default,SERENA,0,0,0,,một khi tôi đã nhắm trúng con mồi, \Nthì đừng hòng bao giờ trốn thoát khỏi tay tôi.
Dialogue: 0,0:21:43.11,0:21:47.11,Credits,CREDITS,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:21:47.11,0:21:51.12,Credits,CREDITS,0,0,0,,Biên dịch & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:23:15.18,0:23:20.03,Default,SHOUKO,0,0,0,,Thông tin di truyền của dạng người chưa xác định \Nlà ranh giới tiên phong hiện nay, nhưng...
Dialogue: 0,0:23:26.30,0:23:30.77,Default,SHOUKO,0,0,0,,chỉ cần sẩy một bước, chúng ta có thể \Nmở toang cánh cổng dẫn tới địa ngục.
Dialogue: 0,0:23:35.01,0:23:40.09,Signs,NEXTEPTITLE,0,0,0,,{\fnSegoe UI\fs32\bord1.7\c&H2AFFFD&\3c&H171817&\pos(320,234)}Đội Săn Hải Tặc

