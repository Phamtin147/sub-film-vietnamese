Dialogue: 0,0:00:03.69,0:00:07.94,Default,HIRO,0,0,0,,Trước tiên sẽ bắt đầu bằng một con tàu vận tải\Ngiả vờ gặp trục trặc hỏng hóc.
Dialogue: 0,0:00:07.94,0:00:11.90,DefaultItalics,PIRATE,0,0,0,,Hú! Tụi này tới cứu mấy người đây,\Nđúng theo yêu cầu rồi nhé.
Dialogue: 0,0:00:11.90,0:00:16.88,DefaultItalics,PIRATE,0,0,0,,Đừng lo. Tàu, hàng hóa lẫn mấy cô em xinh đẹp\Nbọn ta sẽ chăm sóc chu đáo hết cả.
Dialogue: 0,0:00:21.59,0:00:26.21,DefaultItalics,PIRATE,0,0,0,,Quân Đế Quốc á? Chết tiệt!\NSao bọn chúng lại ở đây chứ?!
Dialogue: 0,0:00:26.21,0:00:31.72,Default,HIRO,0,0,0,,Một khi lũ hải tặc đã cắn câu,\Nta sẽ tung chiến hạm quân đội ẩn nấp ra tóm gọn.
Dialogue: 0,0:00:32.17,0:00:33.71,DefaultItalics,PIRATE,0,0,0,,Đổ bộ sang tàu vận tải ngay!
Dialogue: 0,0:00:33.71,0:00:36.16,DefaultItalics,PIRATE,0,0,0,,Bắt sạch người trên tàu làm con tin!
Dialogue: 0,0:00:36.97,0:00:39.04,Default,HIRO,0,0,0,,Nhỡ có tình huống xấu nhất xảy ra thì cũng khỏi lo.
Dialogue: 0,0:00:39.98,0:00:44.05,Default,PIRATE,0,0,0,,Tất cả đứng im. Đứa nào chống cự\Nlà ăn đạn bỏ mạng ngay.
Dialogue: 0,0:00:44.34,0:00:45.24,Default,PIRATE,0,0,0,,Cái gì?
Dialogue: 0,0:00:45.77,0:00:47.20,Default,SOLDIERS,0,0,0,,Chào mừng quý khách.
Dialogue: 0,0:00:48.00,0:00:51.55,Default,HIRO,0,0,0,,Một phân đội giáp cường hóa quân đội\Nsẽ ém sẵn bên trong khoang tàu.
Dialogue: 0,0:00:51.55,0:00:54.20,Default,HIRO,0,0,0,,Đúng chuẩn chiến thuật hai lớp kín kẽ không kẽ hở.
Dialogue: 0,0:00:55.64,0:00:58.45,Default,HIRO,0,0,0,,Cắn câu lia lịa luôn. Bội thu rồi đây.
Dialogue: 0,0:00:58.45,0:01:04.83,Default,SERENA,0,0,0,,Thuyền trưởng Hiro, tôi biết mình thuê anh\Nlàm cố vấn săn hải tặc,
Dialogue: 0,0:01:04.83,0:01:07.54,Default,SERENA,0,0,0,,nhưng chơi chiêu lừa đảo như thế này\Nchẳng phải hơi mất tinh thần thượng võ sao?
Dialogue: 0,0:01:07.85,0:01:14.77,Default,HIRO,0,0,0,,Tôi chỉ làm đúng theo mệnh lệnh của cô\Nlà phải tàn nhẫn, không khoan nhượng và triệt để thôi mà.
Dialogue: 0,0:01:15.16,0:01:20.47,Default,SERENA,0,0,0,,T-Tôi đúng là có nói thế thật, nhưng tôi cũng phải\Ngiữ thể diện danh dự của một quý tộc chứ.
Dialogue: 0,0:01:20.47,0:01:23.23,Default,HIRO,0,0,0,,Tiến tới bãi câu tiếp theo thôi nào!
Dialogue: 0,0:01:24.83,0:01:29.39,Default,SERENA,0,0,0,,Tổng cộng 382 tàu hải tặc\Nbị tiêu diệt hoặc bắt giữ.
Dialogue: 0,0:01:29.39,0:01:32.42,Default,SERENA,0,0,0,,Chỉ vỏn vẹn trong một tuần, nhờ đơn vị mới của chúng ta.
Dialogue: 0,0:01:32.42,0:01:35.28,Default,SERENA,0,0,0,,Dù chính tay mình tham gia chỉ huy,\Ntôi vẫn thấy khó mà tin nổi.
Dialogue: 0,0:01:35.28,0:01:37.58,Default,EMMA,0,0,0,,Trung bình hơn 50 chiến hạm mỗi ngày,
Dialogue: 0,0:01:37.58,0:01:41.73,Default,EMMA,0,0,0,,vượt xa mức bình quân trước đây rất nhiều.
Dialogue: 0,0:01:42.05,0:01:44.90,Default,SERENA,0,0,0,,Dẫu vậy, với tư cách một quý tộc nhà Grakkan kiêu hãnh,
Dialogue: 0,0:01:44.90,0:01:49.89,Default,SERENA,0,0,0,,cách làm này khiến tôi hơi lấn cấn\Nkhi ăn mừng chiến công.
Dialogue: 0,0:01:49.89,0:01:51.90,Default,SERENA,0,0,0,,Georg, tâm trạng anh em trong đơn vị\Ndạo này thế nào rồi?
Dialogue: 0,0:01:51.90,0:01:57.59,Default,GEORG,0,0,0,,Giống như cô, cũng có vài người thấy mấy trò lừa gạt đó\Nhơi hạ đẳng so với quân đội chính quy,
Dialogue: 0,0:01:57.59,0:02:02.05,Default,GEORG,0,0,0,,nhưng không một ai dám phủ nhận chiến tích\Nmà Thuyền trưởng Hiro đã lập nên.
Dialogue: 0,0:02:02.05,0:02:06.51,Default,GEORG,0,0,0,,Rất nhiều binh sĩ đang háo hức muốn học hỏi\Nkỹ năng săn hải tặc từ anh ấy.
Dialogue: 0,0:02:06.83,0:02:09.47,Default,SERENA,0,0,0,,Ra vậy. Bất kể anh ta dùng thủ đoạn nào,
Dialogue: 0,0:02:09.47,0:02:14.73,Default,SERENA,0,0,0,,anh ta đã góp công lớn chứng minh được\Ngiá trị của đội săn hải tặc chúng ta.
Dialogue: 0,0:02:14.73,0:02:17.42,Default,EMMA,0,0,0,,Cấp trên cũng đang dần đổi thái độ rồi,
Dialogue: 0,0:02:17.42,0:02:21.20,Default,EMMA,0,0,0,,họ còn cân nhắc tính chi phí mấy tàu vận tải mồi nhử\Nvào ngân sách vận hành chính thức nữa.
Dialogue: 0,0:02:23.17,0:02:27.88,Default,GEORG,0,0,0,,Tóm lại, rõ ràng Thuyền trưởng Hiro\Nlà một nhân tài vô giá không thể thiếu.
Dialogue: 0,0:02:27.88,0:02:31.70,Default,SERENA,0,0,0,,Biết ngay là không thể để anh ta tuột mất được mà.
Dialogue: 1,0:03:58.71,0:04:00.71,Signs,TITLE,0,0,0,,{\an7\fad(1359,308)\bord2\fnSegoe UI\c&HFFFF91&\3c&HF8C034&\blur1\pos(200,262)\frz14.71\4c&HFFFC65&\shad2}Thức Tỉnh Với Trang Bị Tối Thượng Và Chiến Hạm Không Gian!
Dialogue: 0,0:04:00.34,0:04:02.96,Signs,TITLE,0,0,0,,{\an7\fad(396,1)\bord2\fnSegoe UI\c&HF6FAFE&\3c&HA46B01&\frz14.71\pos(200,262)\4c&H00DFE2&\shad2}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:04:05.26,0:04:09.22,Signs,EPTITLE,0,0,0,,{\fs20\fad(736,888)\fnSegoe UI\c&HF6EBE4&\shad2\b0\blur3\t(27,736,\blur0.2)\t(3072,3947,\blur3)\4c&H795442&\pos(130.5,263.5)}Đội Săn Hải Tặc
Dialogue: 0,0:04:05.98,0:04:08.83,Default,SERENA,0,0,0,,Vậy, mình đi thôi chứ?
Dialogue: 0,0:04:09.68,0:04:11.65,Default,HIRO,0,0,0,,Cô lại định giở trò gì nữa đây?
Dialogue: 0,0:04:12.07,0:04:15.22,Default,HIRO,0,0,0,,Tôi vừa mới xử lý xong việc hôm nay rồi mà.
Dialogue: 0,0:04:15.63,0:04:18.12,Default,SERENA,0,0,0,,Anh có muốn dùng bữa tối cùng tôi không?
Dialogue: 0,0:04:18.12,0:04:21.45,Default,HIRO,0,0,0,,Ăn tối á? Sao không mời thưởng cho mấy\Nthuộc cấp của cô thì hơn?
Dialogue: 0,0:04:21.45,0:04:25.41,Default,SERENA,0,0,0,,Bọn họ làm sao thoải mái dùng bữa được\Nkhi ngồi cùng bàn với cấp trên trực tiếp chứ.
Dialogue: 0,0:04:25.78,0:04:29.87,Default,SERENA,0,0,0,,Nói thật là, đáng tiếc tôi chẳng có nổi\Nmột người bạn nào ở hệ sao này cả.
Dialogue: 0,0:04:29.87,0:04:31.56,Default,HIRO,0,0,0,,Chỉ mỗi ở hệ sao này thôi sao?
Dialogue: 0,0:04:31.56,0:04:32.62,Default,SERENA,0,0,0,,Anh có ẩn ý gì đấy hả?
Dialogue: 0,0:04:32.62,0:04:33.84,Default,HIRO,0,0,0,,Không có gì hết trơn.
Dialogue: 0,0:04:35.14,0:04:40.26,Default,SERENA,0,0,0,,Tôi vốn muốn được trò chuyện với anh\Nngoài khuôn khổ công việc từ lâu rồi.
Dialogue: 0,0:04:40.54,0:04:43.30,Default,SERENA,0,0,0,,Cá nhân tôi rất hứng thú với các học thuyết\Nsăn hải tặc của anh
Dialogue: 0,0:04:43.30,0:04:46.01,Default,SERENA,0,0,0,,cũng như những chiến tích lính đánh thuê trước kia.
Dialogue: 0,0:04:46.01,0:04:48.46,Default,HIRO,0,0,0,,Trừ phi cho phép phi hành đoàn của tôi đi cùng.
Dialogue: 0,0:04:48.89,0:04:53.17,Default,SERENA,0,0,0,,Đi hẹn hò ăn tối mà dẫn theo phụ nữ khác\Nthì có vẻ không thích hợp lắm nhỉ?
Dialogue: 0,0:04:53.59,0:04:56.24,Default,HIRO,0,0,0,,Thế thì tôi e là lần này đành xin phép\Ntừ chối khéo vậy.
Dialogue: 0,0:04:57.09,0:04:58.66,Default,SERENA,0,0,0,,Được rồi.
Dialogue: 0,0:04:59.38,0:05:05.28,Default,ELMA,0,0,0,,Tiểu thư Serena, xin phép thay mặt cả nhóm\Nchân thành cảm ơn lời mời thịnh soạn của cô.
Dialogue: 0,0:05:05.28,0:05:07.61,DefaultItalics,ELMA/ID,0,0,0,,Tiếc ghê nha, khỏi hòng đánh lẻ hai người với Hiro rồi!
Dialogue: 0,0:05:07.80,0:05:12.38,Default,SERENA,0,0,0,,Không có gì. Tôi cũng rất muốn lắng nghe góc nhìn\Ncủa một lính đánh thuê kỳ cựu như cô mà.
Dialogue: 0,0:05:12.38,0:05:17.01,DefaultItalics,SERENA/ID,0,0,0,,Đồ mặt dày! Ngay cả suy nghĩ thật hay tuổi tác\Nmà cô cũng giấu nhẹm chẳng lộ tí nào!
Dialogue: 0,0:05:19.50,0:05:20.96,Default,HIRO,0,0,0,,Bầu không khí quái quỷ gì thế này?
Dialogue: 0,0:05:21.24,0:05:25.12,Default,SERENA,0,0,0,,Tối nay tôi đã đặt bàn ở một\Nnhà hàng thực phẩm hữu cơ.
Dialogue: 0,0:05:25.12,0:05:28.42,Default,SERENA,0,0,0,,Nơi đó được đánh giá cao lắm,\Nnên tôi tin chắc mọi người sẽ thích mê.
Dialogue: 0,0:05:29.40,0:05:33.16,Default,HIRO,0,0,0,,Tức là họ phục vụ thịt thật với rau củ thật á?
Dialogue: 0,0:05:33.16,0:05:35.68,DefaultItalics,HIRO/ID,0,0,0,,Đây là lần đầu tiên mình được ăn đồ tươi sống\Ntrong thế giới này luôn đấy.
Dialogue: 0,0:05:35.69,0:05:40.34,Default,MIMI,0,0,0,,Th-Thịt với rau thật không phải loại ép ra từ\Nống dinh dưỡng đóng hộp luôn hả?!
Dialogue: 0,0:05:48.00,0:05:50.45,Default,ELMA,0,0,0,,Chi nhánh chính của chuỗi nhà hàng này\Nnằm ngay tại Thủ đô Đế quốc đấy.
Dialogue: 0,0:05:50.45,0:05:52.95,Default,ELMA,0,0,0,,Tiểu thư Serena đúng là có con mắt tinh đời thật.
Dialogue: 0,0:05:52.95,0:05:55.94,Default,SERENA,0,0,0,,Quá khen rồi. Hồi còn ở thủ đô tôi hay\Nghé qua ăn suốt.
Dialogue: 0,0:05:55.94,0:05:57.56,Default,SERENA,0,0,0,,Ngon xuất sắc luôn đấy.
Dialogue: 0,0:05:57.56,0:05:59.90,Default,HIRO,0,0,0,,Chà, Elma đúng chuẩn đàn chị sành sỏi.
Dialogue: 0,0:05:59.90,0:06:04.14,Default,HIRO,0,0,0,,Đã là lính đánh thuê hạng nhất thì dĩ nhiên phải\Nrành rẽ cả mấy tiệm cao cấp hàng đầu chứ.
Dialogue: 0,0:06:04.45,0:06:09.09,Default,SERENA,0,0,0,,À phải rồi. Tôi đặt sẵn phòng riêng rồi,\Nnên cứ thoải mái bỏ qua nghi thức xã giao đi.
Dialogue: 0,0:06:09.60,0:06:13.57,Default,ELMA,0,0,0,,Đặt hẳn phòng riêng để mưu đồ gì cùng Hiro\Nthế hả cô nương?
Dialogue: 0,0:06:14.82,0:06:18.51,Default,SERENA,0,0,0,,Dù sao đi nữa, hôm nay cứ tạm gác lễ nghi sang bên\Nvà cùng nâng ly ngang hàng nhau nhé.
Dialogue: 0,0:06:19.89,0:06:24.53,Default,SERENA,0,0,0,,Ai nấy đều coi thường tôi chỉ vì\Ntôi là phụ nữ cả!
Dialogue: 0,0:06:24.98,0:06:27.73,Default,SERENA,0,0,0,,Tôi cũng đang nỗ lực hết mình đấy chứ bộ.
Dialogue: 0,0:06:27.98,0:06:32.52,DefaultItalics,ALL/ID,0,0,0,,Trong công việc thì sắc sảo giỏi giang thật,\Nchứ ra ngoài đời thường lại chán hẳn luôn.
Dialogue: 0,0:06:34.62,0:06:37.24,DefaultItalics,HIRO/ID,0,0,0,,Rõ ràng ban đầu mọi thứ diễn ra suôn sẻ lắm mà.
Dialogue: 0,0:06:37.54,0:06:42.54,Flashback,SERENA,0,0,0,,Hôm nay mọi người cứ ăn uống no say\Nthỏa thích đi nhé.
Dialogue: 0,0:06:42.54,0:06:44.71,Flashback,SERENA,0,0,0,,Nhờ công của Thuyền trưởng Hiro,
Dialogue: 0,0:06:44.71,0:06:47.61,Flashback,SERENA,0,0,0,,hầu hết bọn hải tặc trong hệ sao này\Nđều đã bị quét sạch sẽ.
Dialogue: 0,0:06:47.61,0:06:49.71,Flashback,SERENA,0,0,0,,Thậm chí chúng tôi còn định vị được sào huyệt của chúng.
Dialogue: 0,0:06:50.28,0:06:56.67,Flashback,SERENA,0,0,0,,Sắp tới mọi người cũng sẽ tham gia trận tổng tấn công,\Nnên hôm nay cứ bồi bổ lấy sức cho thật tốt vào.
Dialogue: 0,0:06:56.95,0:06:57.73,Flashback,HIRO,0,0,0,,Ngon xỉu luôn!
Dialogue: 0,0:06:57.73,0:07:00.78,Flashback,MIMI,0,0,0,,Hóa ra thịt thật nó ngon tới mức này sao! Tuyệt quá đi!
Dialogue: 0,0:07:00.78,0:07:02.44,Flashback,ELMA,0,0,0,,Chà, ngon đỉnh cao thật sự!
Dialogue: 0,0:07:03.15,0:07:05.24,DefaultItalics,HIRO/ID,0,0,0,,Cứ tưởng buổi tối sẽ khép lại êm đềm thế thôi.
Dialogue: 0,0:07:05.24,0:07:08.93,Default,SERENA,0,0,0,,Lũ đó dám chê hạm đội của tôi là đồ chơi con nít,
Dialogue: 0,0:07:08.93,0:07:11.62,Default,SERENA,0,0,0,,vậy mà vừa thấy lập công phát là quay ngoắt thái độ\Nnhanh hơn lật bánh tráng!
Dialogue: 0,0:07:11.62,0:07:15.08,Default,SERENA,0,0,0,,Mặc xác mấy lão già đầu hói háo sắc chết bầm đó đi!
Dialogue: 0,0:07:15.24,0:07:16.68,DefaultItalics,HIRO/ID,0,0,0,,Thế nhưng như mọi người thấy đấy...
Dialogue: 0,0:07:17.55,0:07:19.36,Default,HIRO,0,0,0,,Ờm, Thiếu tá Serena à,
Dialogue: 0,0:07:19.36,0:07:22.04,Default,HIRO,0,0,0,,dù đây là bữa tối thân mật thật đấy,\Nnhưng có lẽ cô nên bình tĩnh chút đi.
Dialogue: 0,0:07:22.63,0:07:26.11,Default,SERENA,0,0,0,,Hả? Vậy thì anh mau gia nhập quân đội đi chứ!
Dialogue: 0,0:07:26.11,0:07:29.93,Default,SERENA,0,0,0,,Sao cứ từ chối mãi trong khi tôi đang ra sức\Nchiêu mộ anh thế hả?!
Dialogue: 0,0:07:29.93,0:07:34.77,Default,SERENA,0,0,0,,Tôi vừa xinh đẹp kiều diễm! Lại còn có cả\Ntiền tài lẫn quyền lực nữa nhé!
Dialogue: 0,0:07:35.14,0:07:39.22,Default,SERENA,0,0,0,,Tôi hiểu rồi. Chỉ là anh ngại không muốn\Nchịu đựng mấy thứ {\i1}như thế này{\i0} thôi chứ gì.
Dialogue: 0,0:07:39.55,0:07:40.93,Default,ELMA,0,0,0,,Chà, ít nhất thì cô cũng tự biết mình biết ta đấy.
Dialogue: 0,0:07:40.93,0:07:47.52,Default,HIRO,0,0,0,,Tôi sẽ không vào quân đội đâu, nhưng sau này\Nvẫn sẵn sàng nhận thêm ủy thác từ cô.
Dialogue: 0,0:07:47.52,0:07:49.90,Default,SERENA,0,0,0,,Thế thì ký hợp đồng độc quyền dài hạn với tôi đi.
Dialogue: 0,0:07:49.90,0:07:51.66,Default,MIMI,0,0,0,,Kh-Không được đâu ạ!
Dialogue: 0,0:07:51.66,0:07:53.62,Default,HIRO,0,0,0,,À thì, thật ra là...
Dialogue: 0,0:07:53.84,0:07:58.95,Default,SERENA,0,0,0,,Sao hai người lại nhìn nhau đắm đuối thế kia?\NBộ không muốn sao?
Dialogue: 0,0:07:59.24,0:08:04.01,Default,HIRO,0,0,0,,Bọn tôi làm việc không ngừng nghỉ kể từ lúc\Nrời khỏi Hệ sao Tarmein rồi.
Dialogue: 0,0:08:04.01,0:08:05.40,Default,HIRO,0,0,0,,Sau khi xong xuôi phi vụ này,
Dialogue: 0,0:08:05.40,0:08:09.80,Default,HIRO,0,0,0,,cả ba tụi tôi tính ghé một hành tinh du lịch gần đây\Nđể nghỉ dưỡng xả hơi.
Dialogue: 0,0:08:11.64,0:08:16.60,Default,SERENA,0,0,0,,Bất công quá! Tôi cũng muốn đi chơi xả hơi nữa!
Dialogue: 0,0:08:15.49,0:08:17.38,DefaultOverlap,ELMA,0,0,0,,Ấy, coi chừng đổ.
Dialogue: 0,0:08:17.96,0:08:19.45,Default,HIRO,0,0,0,,Trời ạ, phiền phức chết mất.
Dialogue: 0,0:08:19.45,0:08:21.35,DefaultItalics,HIRO/ID,0,0,0,,Thưa Tiểu thư Serena, làm ơn giữ bình tĩnh giùm đi ạ.
Dialogue: 0,0:08:21.35,0:08:23.65,Default,MIMI,0,0,0,,Anh Hiro ơi, anh nói nhầm vế đáng lẽ phải nghĩ trong đầu\Nra thành tiếng luôn rồi kìa!
Dialogue: 0,0:08:23.65,0:08:27.13,Default,SERENA,0,0,0,,Dám hỗn láo thế à! Ta đây đường đường là\Ncon gái của một ngài Hầu tước đấy nhé!
Dialogue: 0,0:08:27.13,0:08:29.11,Default,SERENA,0,0,0,,Ta là tiểu thư quý tộc danh giá đấy!
Dialogue: 0,0:08:32.11,0:08:34.02,Default,HIRO,0,0,0,,Giờ phải xử lý bà cô này sao đây?
Dialogue: 0,0:08:34.02,0:08:35.99,Default,ELMA,0,0,0,,Hay cậu đưa cô ta lên giường luôn cho gọn.
Dialogue: 0,0:08:35.99,0:08:36.87,Default,HIRO,0,0,0,,Thôi xin kiếu.
Dialogue: 0,0:08:38.82,0:08:42.97,Default,HIRO,0,0,0,,Nói vậy chứ cũng chẳng nỡ tống cô ấy về doanh trại\Ntrong bộ dạng say bí tỉ thế này được.
Dialogue: 0,0:08:51.50,0:08:54.48,Default,SERENA,0,0,0,,Tôi vô cùng xin lỗi về chuyện tối qua.
Dialogue: 0,0:08:55.72,0:08:59.50,Default,HIRO,0,0,0,,Đâu có gì, chúng ta chỉ thưởng thức mỹ vị\Nvà rượu ngon một chút thôi mà.
Dialogue: 0,0:08:59.92,0:09:02.05,Default,SERENA,0,0,0,,Cảm ơn sự thấu hiểu chu đáo của anh.
Dialogue: 0,0:09:02.73,0:09:08.59,Default,SERENA,0,0,0,,Ờ-Ờm, về việc gia hạn hợp đồng để cùng\Ntổng tấn công căn cứ hải tặc ấy...
Dialogue: 0,0:09:08.59,0:09:11.40,Default,HIRO,0,0,0,,Là lính đánh thuê, tôi nhất định giữ trọn chữ tín hợp đồng.
Dialogue: 0,0:09:11.68,0:09:13.33,Default,SERENA,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:09:14.05,0:09:16.00,Default,SERENA,0,0,0,,Vậy tôi xin phép cáo từ trước.
Dialogue: 0,0:09:19.29,0:09:23.74,Default,MIMI,0,0,0,,Làm tiểu thư quý tộc kiêm nữ sĩ quan chỉ huy\Nchắc hẳn áp lực lắm nhỉ.
Dialogue: 0,0:09:31.09,0:09:33.05,Default,SERENA,0,0,0,,Đã đến lúc thu hoạch thành quả\Ncủa mọi nỗ lực suốt thời gian qua.
Dialogue: 0,0:09:33.33,0:09:37.52,Default,SERENA,0,0,0,,Với kỹ năng các vị đã rèn giũa,\Ntrận đánh này chắc chắn nằm gọn trong tầm tay.
Dialogue: 0,0:09:37.52,0:09:41.96,Default,SERENA,0,0,0,,Chần chừ gì nữa, hãy nhuộm đỏ vũ trụ bằng máu tươi\Nvà tiếng gào thét của lũ hải tặc cặn bã kia!
Dialogue: 0,0:09:42.32,0:09:43.82,DefaultItalics,SOLDIERS,0,0,0,,Rõ, thưa Thiếu tá!
Dialogue: 0,0:09:44.74,0:09:47.73,Default,ELMA,0,0,0,,Uầy, tinh thần binh sĩ hừng hực khí thế quá trời.
Dialogue: 0,0:09:47.73,0:09:50.81,Default,HIRO,0,0,0,,Ít nhất về mặt chỉ huy tác chiến thì cô ấy\Ncũng là một sĩ quan cực kỳ có năng lực.
Dialogue: 0,0:09:50.81,0:09:54.62,Default,MIMI,0,0,0,,Anh Hiro, em đã bắt đầu nạp năng lượng cho\Nđộng cơ tốc độ ánh sáng rồi ạ.
Dialogue: 0,0:09:54.95,0:09:59.78,Default,MIMI,0,0,0,,Năm, bốn, ba, hai, một.
Dialogue: 0,0:09:59.78,0:10:02.00,Default,MIMI,0,0,0,,Kích hoạt bước nhảy ánh sáng!
Dialogue: 0,0:10:03.32,0:10:08.04,Default,HIRO,0,0,0,,Được rồi. Đi hoàn thành nốt bản hợp đồng thôi nào.
Dialogue: 0,0:10:04.08,0:10:09.00,Signs,TITLE,0,0,0,,{\fad(901,1)\fs12\fscx88\an7\bord1.5\fnSegoe UI\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(462,274)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:10:09.00,0:10:14.00,Signs,TITLE,0,0,0,,{\fs12\fscx88\an7\bord1.5\fnSegoe UI\c&HF6FAFE&\3c&HA46B01&\frz14.71\4c&H1FEEFA&\shad1.5\pos(452,270)}Thức Tỉnh Với {\c&H00ECF6&\3c&H0D0812&}Trang Bị Tối Thượng Và Chiến Hạm Không Gian:\N{\c&HFEFDFB&\3c&HAFA7A8&}Tôi Quyết Định Làm Lính Đánh Thuê Tự Do {\c&HFFFDFB&\3c&HC77F00&}Để Tậu Nhà Riêng!
Dialogue: 0,0:10:17.14,0:10:20.76,Default,HIRO,0,0,0,,Lũ hải tặc đó cũng dai sức phết đấy.
Dialogue: 0,0:10:20.76,0:10:23.22,Default,ELMA,0,0,0,,Bản mặt tỉnh bơ của cậu chẳng giống đang nói thế chút nào.
Dialogue: 0,0:10:24.68,0:10:27.94,Default,HIRO,0,0,0,,Quả nhiên sào huyệt của bọn chúng\Nchất đầy chiến lợi phẩm.
Dialogue: 0,0:10:27.94,0:10:30.66,Default,ELMA,0,0,0,,Cậu làm ơn đừng có nhặt nhạnh thêm\Ncái của nợ kỳ quái nào về nữa đấy.
Dialogue: 0,0:10:30.66,0:10:33.64,Default,HIRO,0,0,0,,Cô bị sang chấn tâm lý nặng tới mức nào\Nvì viên pha lê biết hát đó thế hả?
Dialogue: 0,0:10:33.90,0:10:37.11,Default,HIRO,0,0,0,,Dù sao cũng xong việc rồi. Mọi người vất vả nhiều nhé.
Dialogue: 0,0:10:37.78,0:10:41.00,Default,ELMA,0,0,0,,Thiếu tá Serena lườm tụi mình cháy mặt cho tới tận giây phút\Nbọn mình rút lui trong khi cổ phải ở lại dọn dẹp bãi chiến trường.
Dialogue: 0,0:10:41.00,0:10:44.46,Default,ELMA,0,0,0,,ở lại gánh hết đống hậu quả phía sau.
Dialogue: 0,0:10:44.46,0:10:48.20,Default,HIRO,0,0,0,,Hợp đồng đâu có trả tiền để tụi mình dọn rác giùm.
Dialogue: 0,0:10:48.20,0:10:49.92,Default,HIRO,0,0,0,,Thôi kệ, về tới trạm là chính thức xả hơi nghỉ phép.
Dialogue: 0,0:10:49.92,0:10:55.05,Default,MIMI,0,0,0,,Em vừa tìm hiểu kỹ rồi. Anh thấy hệ sao\NCierra thế nào ạ?
Dialogue: 0,0:10:55.05,0:10:57.89,Default,MIMI,0,0,0,,Ở đó có hẳn ba hành tinh du lịch nghỉ dưỡng luôn đấy.
Dialogue: 0,0:10:57.89,0:11:01.51,Default,HIRO,0,0,0,,Ồ? Nguyên cả hành tinh chỉ để nghỉ dưỡng luôn cơ à?
Dialogue: 0,0:11:01.51,0:11:03.87,Default,HIRO,0,0,0,,Đẳng cấp ăn chơi thư giãn hoàn toàn khác bọt thật.
Dialogue: 0,0:11:03.87,0:11:06.35,Default,MIMI,0,0,0,,Chúng ta đã tới Thuộc Địa Arein Tertius rồi ạ.
Dialogue: 0,0:11:06.35,0:11:09.08,Default,MIMI,0,0,0,,Em xin phép ngắt động cơ tốc độ cao.
Dialogue: 0,0:11:14.85,0:11:17.35,Default,HIRO,0,0,0,,Hai người có thấy chỗ này hơi lạ lùng bất thường không?
Dialogue: 0,0:11:17.35,0:11:18.27,Default,ELMA,0,0,0,,Hả?
Dialogue: 0,0:11:24.86,0:11:26.65,Default,ELMA,0,0,0,,Cậu nói phải. Có chuyện gì đó chẳng lành rồi.
Dialogue: 0,0:11:26.65,0:11:31.62,Default,ELMA,0,0,0,,Điện đóm mất rải rác khắp nơi, mà mấy con tàu kia\Nnhìn như đang hớt hải tháo chạy vậy.
Dialogue: 0,0:11:31.90,0:11:35.46,DefaultItalics,STAFF,0,0,0,,Đây là ban quản lý cảng vũ trụ\NThuộc Địa Arein Tertius.
Dialogue: 0,0:11:35.46,0:11:38.09,DefaultItalics,STAFF,0,0,0,,Nếu ai nghe được tín hiệu này, xin hãy cứu giúp chúng tôi.
Dialogue: 0,0:11:38.09,0:11:38.96,Default,HIRO,0,0,0,,Mimi.
Dialogue: 0,0:11:38.96,0:11:40.01,Default,MIMI,0,0,0,,Vâng, thưa anh.
Dialogue: 0,0:11:40.01,0:11:42.07,Default,HIRO,0,0,0,,Tôi là Thuyền trưởng Hiro, lính đánh thuê tự do.
Dialogue: 0,0:11:42.07,0:11:43.88,Default,HIRO,0,0,0,,Chuyện gì đã xảy ra trên thuộc địa vậy?
Dialogue: 0,0:11:43.88,0:11:45.20,DefaultItalics,STAFF,0,0,0,,Lính đánh thuê sao?
Dialogue: 0,0:11:45.57,0:11:49.10,DefaultItalics,STAFF,0,0,0,,Trên tàu các vị có trang bị giáp cường hóa\Nchuyên dụng để chiến đấu không?
Dialogue: 0,0:11:49.10,0:11:51.43,Default,HIRO,0,0,0,,Hả? Ừ, tôi có.
Dialogue: 0,0:11:51.69,0:11:52.94,DefaultItalics,STAFF,0,0,0,,Làm ơn hãy cứu chúng tôi.
Dialogue: 0,0:11:52.94,0:11:55.80,DefaultItalics,STAFF,0,0,0,,Chúng tôi đang bị những sinh vật không rõ nguồn gốc\Ntấn công dồn dập.
Dialogue: 0,0:11:56.14,0:11:57.41,Default,ALL,0,0,0,,Cái gì?!
Dialogue: 0,0:12:01.32,0:12:03.68,Default,HIRO,0,0,0,,Elma, cô phụ trách neo đậu tàu nhé.
Dialogue: 0,0:12:03.68,0:12:04.77,DefaultItalics,ELMA,0,0,0,,Rõ, thưa thuyền trưởng.
Dialogue: 0,0:12:05.53,0:12:08.49,Default,HIRO,0,0,0,,Mimi, có thông tin gì mới lập tức báo ngay cho anh.
Dialogue: 0,0:12:08.49,0:12:09.58,DefaultItalics,MIMI,0,0,0,,Vâng, em rõ rồi.
Dialogue: 0,0:12:14.34,0:12:17.22,Default,ELMA,0,0,0,,Đã hoàn tất neo đậu tại khoang chứa số 3 của thuộc địa.
Dialogue: 0,0:12:17.67,0:12:20.76,Default,MIMI,0,0,0,,Em đang gửi bản đồ khu vực quanh cảng cho anh.
Dialogue: 0,0:12:20.76,0:12:23.18,Default,MIMI,0,0,0,,Phát hiện khoảng 100 dấu hiệu sự sống thù địch.
Dialogue: 0,0:12:23.18,0:12:26.46,Default,HIRO,0,0,0,,Thả anh xuống xong hai người cứ ở yên trên tàu.
Dialogue: 0,0:12:26.46,0:12:29.08,Default,HIRO,0,0,0,,Ở trên tàu Krishna là an toàn nhất.
Dialogue: 0,0:12:29.08,0:12:30.81,DefaultItalics,ELMA,0,0,0,,Chẳng cần cậu nhắc tới lần thứ hai đâu.
Dialogue: 0,0:12:30.81,0:12:32.88,DefaultItalics,ELMA,0,0,0,,Ra ngoài đấy đừng có bỏ mạng lãng nhách đấy nhé.
Dialogue: 0,0:12:32.88,0:12:34.57,Default,MIMI,0,0,0,,Anh Hiro, cẩn thận đấy ạ.
Dialogue: 0,0:12:34.57,0:12:36.05,DefaultItalics,HIRO,0,0,0,,Đã rõ. Mở cửa khoang.
Dialogue: 0,0:12:36.05,0:12:36.85,Default,MIMI,0,0,0,,Đang mở cửa khoang.
Dialogue: 0,0:12:37.39,0:12:39.58,DefaultItalics,HIRO,0,0,0,,Quái vật chưa xác định cơ à?
Dialogue: 0,0:12:40.04,0:12:43.97,Default,HIRO,0,0,0,,Mình chẳng nhớ nổi có sự kiện nào như thế này\Ntrong {\i1}Stella Online{\i0} cả.
Dialogue: 0,0:12:43.97,0:12:46.66,Default,HIRO,0,0,0,,Xem ra thế giới thực này cũng có điểm\Nkhác biệt so với trong game nhỉ.
Dialogue: 0,0:12:46.66,0:12:48.25,Default,HIRO,0,0,0,,Phiền phức hết chỗ nói.
Dialogue: 0,0:12:48.78,0:12:52.74,DefaultItalics,HIRO,0,0,0,,TMPA13 RIKISHI Mark 3 xuất kích.
Dialogue: 0,0:13:06.66,0:13:08.70,DefaultItalics,HIRO,0,0,0,,Thật là một mớ hỗn độn kinh hoàng.
Dialogue: 0,0:13:10.11,0:13:12.68,DefaultItalics,HIRO,0,0,0,,Không phát hiện dấu hiệu sự sống nào còn sót.
Dialogue: 0,0:13:13.72,0:13:17.09,Default,HIRO,0,0,0,,Tôi sẽ nhận thù lao để báo thù cho mọi người,\Nnên hãy an tâm yên nghỉ nhé.
Dialogue: 0,0:13:23.82,0:13:25.65,Default,HIRO,0,0,0,,Mấy con quái này...
Dialogue: 0,0:13:40.47,0:13:42.42,Default,HIRO,0,0,0,,Thế này mới đã tay chứ.
Dialogue: 0,0:13:43.39,0:13:44.72,DefaultItalics,HIRO,0,0,0,,Hò dô!
Dialogue: 0,0:13:47.78,0:13:52.84,DefaultItalics,HIRO,0,0,0,,Nào, tiếp đi. Con giáp này còn trâu bò\Nvà cứng cáp hơn thế nhiều đấy.
Dialogue: 0,0:13:53.07,0:13:54.35,Default,HIRO,0,0,0,,Nhào hết vô đây!
Dialogue: 0,0:13:54.35,0:13:57.31,DefaultItalics,HIRO,0,0,0,,Ta đã sẵn sàng cho trận chiến mở màn tại\NThuộc Địa Arein Tertius rồi đây!
Dialogue: 0,0:13:57.87,0:14:02.26,DefaultItalics,HIRO,0,0,0,,Song chưởng phóng điện siêu cao áp — Harite!
Dialogue: 0,0:14:06.94,0:14:10.44,DefaultItalics,HIRO,0,0,0,,Dậm chân khuếch đại — Shiko!
Dialogue: 0,0:14:15.41,0:14:19.44,DefaultItalics,HIRO,0,0,0,,Pháo laser vai công suất cực đại — Shikiri!
Dialogue: 0,0:14:22.45,0:14:26.94,DefaultItalics,HIRO,0,0,0,,Húc toàn thân tốc độ cao kèm khiên năng lượng!
Dialogue: 0,0:14:27.83,0:14:29.71,DefaultItalics,HIRO,0,0,0,,Ăn đòn này đi!
Dialogue: 0,0:14:33.50,0:14:35.47,Default,MIMI,0,0,0,,Chị Elma ơi, anh ấy cứ như...
Dialogue: 0,0:14:35.47,0:14:39.48,Default,ELMA,0,0,0,,Đàn ông con trai cứ leo lên điều khiển mấy cỗ máy\Nkiểu đó là hưng phấn chẳng kìm lại nổi đâu em.
Dialogue: 0,0:14:40.44,0:14:42.23,Default,HIRO,0,0,0,,Cơ bắp chính là sức mạnh tuyệt đối!
Dialogue: 0,0:14:46.79,0:14:51.31,DefaultItalics,MIMI,0,0,0,,Không còn dấu hiệu sinh vật thù địch.\NKhu vực cảng đã an toàn rồi ạ.
Dialogue: 0,0:14:51.31,0:14:53.67,DefaultItalics,MIMI,0,0,0,,Anh Hiro vất vả rồi ạ.
Dialogue: 0,0:14:54.31,0:14:57.10,Default,HIRO,0,0,0,,Rõ rồi. Cảm ơn em đã dẫn đường nhé, Mimi.
Dialogue: 0,0:14:57.10,0:14:59.54,DefaultItalics,ELMA,0,0,0,,Cơn hăng máu ban nãy bay đâu mất tiêu rồi?
Dialogue: 0,0:14:59.54,0:15:01.40,Default,HIRO,0,0,0,,Quẩy tung một trận xong giờ tự dưng thấy đầu óc\Nbình thản lạ thường luôn.
Dialogue: 0,0:15:01.40,0:15:03.62,Default,HIRO,0,0,0,,Vậy việc của tụi mình ở đây coi như xong rồi chứ?
Dialogue: 0,0:15:03.87,0:15:08.36,Default,ELMA,0,0,0,,Các phân đội giáp cường hóa địa phương\Nđang xử lý những khu vực khác rồi.
Dialogue: 0,0:15:08.36,0:15:09.83,Default,ELMA,0,0,0,,Giờ chắc ổn thỏa cả thôi.
Dialogue: 0,0:15:10.99,0:15:13.80,Default,MIMI,0,0,0,,Chúng ta vừa nhận được yêu cầu cứu viện\Nthông qua Công hội đấy ạ.
Dialogue: 0,0:15:13.80,0:15:16.55,Default,MIMI,0,0,0,,Là từ Tập đoàn Công nghệ Inagawa.
Dialogue: 0,0:15:16.55,0:15:20.03,Default,MIMI,0,0,0,,Lũ quái vật đó đã bao vây\Nbệnh viện của họ rồi.
Dialogue: 0,0:15:20.03,0:15:21.01,Default,HIRO,0,0,0,,Inagawa á?
Dialogue: 0,0:15:21.55,0:15:23.98,DefaultItalics,MIMI,0,0,0,,Quân đội hiện vẫn chưa tiếp cận tới nơi được.
Dialogue: 0,0:15:23.98,0:15:25.63,DefaultItalics,MIMI,0,0,0,,Họ sẵn sàng trả thù lao gấp đôi đấy ạ.
Dialogue: 0,0:15:25.63,0:15:28.48,Default,HIRO,0,0,0,,Gấp đôi cơ à? Quá hời luôn. Nhận kèo ngay.
Dialogue: 0,0:15:28.48,0:15:34.23,DefaultItalics,MIMI,0,0,0,,Vậy anh cứ đi thẳng rồi rẽ vào thang máy bên phải\Nđể xuống tầng giữa nhé.
Dialogue: 0,0:15:34.23,0:15:35.95,DefaultItalics,HIRO,0,0,0,,Đã rõ.
Dialogue: 0,0:15:39.32,0:15:42.90,DefaultItalics,HIRO,0,0,0,,Có lẽ bây giờ không phải lúc thích hợp để nhắc,\Nnhưng lũ quái vật kia...
Dialogue: 0,0:15:43.58,0:15:44.85,Default,HIRO,0,0,0,,Trông bọn chúng hơi quen mặt phải không?
Dialogue: 0,0:15:44.85,0:15:45.94,DefaultItalics,MIMI,0,0,0,,Đúng vậy ạ.
Dialogue: 0,0:15:45.94,0:15:47.12,DefaultItalics,ELMA,0,0,0,,Giống hệt luôn chứ còn gì nữa.
Dialogue: 0,0:15:49.16,0:15:51.44,DefaultItalics,HIRO,0,0,0,,Có khi nào khâu bảo mật bên đó bị lọt lưới không.
Dialogue: 0,0:15:51.44,0:15:53.63,DefaultItalics,HIRO,0,0,0,,Nhưng biết đâu chúng cũng chẳng phải xuất phát từ\Nnhà máy đó thật.
Dialogue: 0,0:15:54.16,0:15:57.70,Default,ELMA,0,0,0,,Rõ ràng họ bảo thứ đó không thể sống sót nổi\Nbên ngoài nhà máy cơ mà.
Dialogue: 0,0:15:57.70,0:16:00.04,Default,ELMA,0,0,0,,Hay là tụi mình đừng nên đào sâu làm gì.
Dialogue: 0,0:16:00.04,0:16:02.48,Default,MIMI,0,0,0,,Để giữ sự bình yên cho đầu óc nữa chứ ạ.
Dialogue: 0,0:16:02.69,0:16:05.34,DefaultItalics,HIRO,0,0,0,,Dù thế nào thì xử lý vụ trước mắt vẫn ưu tiên hơn.
Dialogue: 0,0:16:06.18,0:16:09.35,Default,HIRO,0,0,0,,Tới giờ dọn sạch đống rác rưởi bẩn thỉu này rồi!
Dialogue: 0,0:16:15.82,0:16:18.28,DefaultItalics,HIRO,0,0,0,,Khoan đã. Cái quái gì thế kia?
Dialogue: 0,0:16:26.20,0:16:27.66,Default,HIRO,0,0,0,,Kia là đôi mắt của con người sao?
Dialogue: 0,0:16:30.29,0:16:31.51,DefaultItalics,HIRO,0,0,0,,Nhanh thật đấy.
Dialogue: 0,0:16:47.73,0:16:50.32,Default,HIRO,0,0,0,,Nhanh ngang ngửa mình luôn. Chẳng lẽ nào...
Dialogue: 0,0:16:53.09,0:16:54.95,DefaultItalics,HIRO,0,0,0,,Đừng có đùa nhé!
Dialogue: 0,0:16:55.30,0:16:57.03,DefaultItalics,HIRO,0,0,0,,Vĩnh biệt đi!
Dialogue: 0,0:17:03.17,0:17:04.15,DefaultItalics,HIRO,0,0,0,,Úi chà.
Dialogue: 0,0:17:10.15,0:17:12.43,Default,HIRO,0,0,0,,Ngươi dai sức gớm nhỉ?
Dialogue: 0,0:17:21.79,0:17:24.77,DefaultItalics,HIRO,0,0,0,,Công nhận, trâu bò thật sự luôn đấy.
Dialogue: 0,0:17:24.97,0:17:27.27,DefaultItalics,MIMI,0,0,0,,Anh Hiro, năng lượng của giáp sắp cạn rồi đấy ạ.
Dialogue: 0,0:17:27.27,0:17:29.24,DefaultItalics,ELMA,0,0,0,,Cẩn thận nổ tung luôn lò phản ứng bây giờ.
Dialogue: 0,0:17:29.55,0:17:33.61,Default,HIRO,0,0,0,,Chẳng muốn dùng tới chiêu này đâu,\Nnhưng xem ra hết cách lựa chọn rồi.
Dialogue: 0,0:17:33.61,0:17:35.19,Default,HIRO,0,0,0,,Tắt lá chắn năng lượng.
Dialogue: 0,0:17:35.19,0:17:37.26,DefaultItalics,HIRO,0,0,0,,Nhào vô đây!
Dialogue: 0,0:17:41.61,0:17:44.37,Default,HIRO,0,0,0,,Chính là lúc này. Khóa chặt toàn bộ khớp nối.
Dialogue: 0,0:17:44.72,0:17:46.62,DefaultItalics,HIRO,0,0,0,,Tóm gọn ngươi rồi!
Dialogue: 0,0:17:47.59,0:17:49.09,DefaultItalics,HIRO,0,0,0,,Giờ hết đường cựa quậy rồi nhé, đúng không?
Dialogue: 0,0:17:49.09,0:17:51.34,DefaultItalics,HIRO,0,0,0,,Đâu ngờ tôi làm được trò này chứ gì?
Dialogue: 0,0:17:51.34,0:17:54.54,Default,HIRO,0,0,0,,Mà nhân tiện, đây là lựu đạn plasma đấy.
Dialogue: 0,0:17:57.19,0:18:03.23,Default,HIRO,0,0,0,,Để xem ngươi tự tái tạo nổi cỡ nào với một bụng\Nđầy ắp plasma siêu nóng nhé.
Dialogue: 0,0:18:18.89,0:18:21.61,Default,HIRO,0,0,0,,Kiểu này có mọc lại đằng trời cũng bất lực thôi.
Dialogue: 0,0:18:21.61,0:18:24.39,DefaultItalics,MIMI,0,0,0,,Anh Hiro, anh có sao không ạ?
Dialogue: 0,0:18:24.39,0:18:26.87,Default,HIRO,0,0,0,,Ừ, anh ổn. Đừng lo.
Dialogue: 0,0:18:26.87,0:18:28.48,DefaultItalics,MIMI,0,0,0,,May quá đi mất.
Dialogue: 0,0:18:28.48,0:18:30.74,DefaultItalics,ELMA,0,0,0,,Nghe giọng là biết lâu rồi mới có một trận\Ncậu phải chật vật thật sự đấy nhỉ.
Dialogue: 0,0:18:30.74,0:18:33.85,Default,HIRO,0,0,0,,Phải. Nó cứng đầu kinh khủng,\Nnên tôi buộc phải xài lá bài tẩy luôn.
Dialogue: 0,0:18:33.85,0:18:35.83,Default,HIRO,0,0,0,,Sắp tới tôi thà không bao giờ phải lặp lại trò đó nữa.
Dialogue: 0,0:18:36.11,0:18:40.29,Default,SHOUKO,0,0,0,,Xem ra cậu lại cứu mạng tôi thêm một lần nữa rồi nhỉ.
Dialogue: 0,0:18:40.58,0:18:42.14,Default,HIRO,0,0,0,,Bác sĩ Shouko.
Dialogue: 0,0:18:42.93,0:18:48.89,Default,SHOUKO,0,0,0,,Cậu cứu tôi nhiều lần tới mức\Nbắt đầu thấy đúng chuẩn duyên phận rồi đấy.
Dialogue: 0,0:18:51.34,0:18:53.59,Default,SHOUKO,0,0,0,,Tôi thật sự cảm kích lắm.
Dialogue: 0,0:18:53.59,0:18:56.82,Default,SHOUKO,0,0,0,,Tôi đã cố thủ chặn cửa cùng các đồng nghiệp,\Nnhưng tình thế ngàn cân treo sợi tóc thật sự.
Dialogue: 0,0:18:57.11,0:18:58.41,DefaultItalics,HIRO/ID,0,0,0,,Chẳng phải thứ này là Pocari sao?
Dialogue: 0,0:18:58.88,0:19:01.79,Default,SHOUKO,0,0,0,,Tình hình xung quanh còn ngổn ngang lắm,
Dialogue: 0,0:19:01.79,0:19:05.10,Default,SHOUKO,0,0,0,,nhưng tôi có thể chế tạo ra\Nnanomachine tiêu diệt lũ sinh vật kia
Dialogue: 0,0:19:05.10,0:19:07.64,Default,SHOUKO,0,0,0,,từ mẫu vật mà cậu cùng quân đội vừa hạ gục.
Dialogue: 0,0:19:07.64,0:19:09.74,Default,SHOUKO,0,0,0,,Mọi chuyện chắc sẽ giải quyết dứt điểm trong một hai ngày.
Dialogue: 0,0:19:10.09,0:19:12.77,Default,HIRO,0,0,0,,Chế tạo dễ dàng nhanh chóng tới vậy luôn cơ à?
Dialogue: 0,0:19:12.77,0:19:17.32,Default,SHOUKO,0,0,0,,Nơi này quy tụ toàn các tập đoàn công nghệ cao\Nhàng đầu Đế quốc mà.
Dialogue: 0,0:19:17.32,0:19:19.39,Default,SHOUKO,0,0,0,,Với nguồn lực của họ thì dễ như trở bàn tay.
Dialogue: 0,0:19:19.39,0:19:23.57,Default,SHOUKO,0,0,0,,Dĩ nhiên, cũng phải "cảm ơn" chính họ\Nđã gây ra toàn bộ mớ bòng bong lần này.
Dialogue: 0,0:19:24.05,0:19:29.23,Default,SHOUKO,0,0,0,,Chắc bọn họ lại lấp liếm đổ vấy thành\Nvụ tấn công sinh học của bọn khủng bố môi trường thôi.
Dialogue: 0,0:19:29.58,0:19:31.57,Default,HIRO,0,0,0,,Hóa ra bao che đít cho nhau cả một giuộc à.
Dialogue: 0,0:19:31.57,0:19:34.09,Default,SHOUKO,0,0,0,,Xin lỗi vì để cậu bị vạ lây vào chuyện này.
Dialogue: 0,0:19:34.09,0:19:37.27,Default,HIRO,0,0,0,,Đâu phải lỗi của cô.
Dialogue: 0,0:19:37.27,0:19:40.18,Default,HIRO,0,0,0,,Vả lại tôi là lính đánh thuê.\NTôi quen đối mặt với mấy chuyện thối nát này rồi.
Dialogue: 0,0:19:40.43,0:19:42.61,Default,SHOUKO,0,0,0,,Cảm ơn cậu, Hiro.
Dialogue: 0,0:19:42.61,0:19:47.16,Default,HIRO,0,0,0,,Cơ mà bên Inagawa cũng nên siết chặt lại\Nhệ thống an ninh đi thì hơn.
Dialogue: 0,0:19:47.16,0:19:48.79,Default,SHOUKO,0,0,0,,Tôi sẽ báo cáo lại lên cấp trên.
Dialogue: 0,0:19:48.79,0:19:52.15,Default,SHOUKO,0,0,0,,Nói vậy chứ mấy lão già trên đó chậm chạp bảo thủ lắm.
Dialogue: 0,0:19:52.41,0:19:55.25,Default,HIRO,0,0,0,,Thế sao cô không lên làm bác sĩ riêng trên tàu bọn tôi đi?
Dialogue: 0,0:19:55.65,0:19:58.12,Default,HIRO,0,0,0,,Chiến hạm Krishna là nơi an toàn nhất\Nkhắp cả vũ trụ này đấy.
Dialogue: 0,0:19:58.53,0:20:02.52,Default,SHOUKO,0,0,0,,Bao giờ cậu trang bị đủ phòng nghiên cứu tối tân\Vvà mẫu vật thí nghiệm làm tôi vừa lòng thì hỏi lại nhé.
Dialogue: 0,0:20:02.52,0:20:06.59,Default,SHOUKO,0,0,0,,với đầy đủ thiết bị nghiên cứu và đối tượng thí nghiệm\Nlàm tôi mãn nhãn thì hãy rủ.
Dialogue: 0,0:20:06.97,0:20:08.31,Default,HIRO,0,0,0,,Thôi, ít ra cũng thử mở lời rồi.
Dialogue: 0,0:20:14.44,0:20:19.40,Default,ELMA,0,0,0,,Mới ở lại có một đêm đã nhổ neo rồi sao?\NGì mà vội vã thế?
Dialogue: 0,0:20:19.65,0:20:23.85,Default,HIRO,0,0,0,,Sự cố coi như xong nhưng thuộc địa vẫn đang\Nbộn bề giải quyết hậu quả.
Dialogue: 0,0:20:24.18,0:20:27.81,Default,HIRO,0,0,0,,Tôi thà đi nghỉ mát còn hơn ngồi mòn mỏi chờ họ\Ndọn dẹp xong xuôi.
Dialogue: 0,0:20:28.32,0:20:30.25,Default,HIRO,0,0,0,,Hơn nữa, nếu bọn mình chuồn ngay lúc này—
Dialogue: 0,0:20:30.25,0:20:34.47,Default,MIMI,0,0,0,,Anh Hiro ơi, chúng ta vừa nhận được tín hiệu liên lạc\Ntừ Thiếu tá Serena ạ.
Dialogue: 0,0:20:34.47,0:20:35.79,Default,HIRO,0,0,0,,Chậm mất một bước rồi à?
Dialogue: 0,0:20:36.28,0:20:39.75,DefaultItalics,SERENA,0,0,0,,Anh đối xử hơi phũ phàng đấy nhé, Thuyền trưởng Hiro.
Dialogue: 0,0:20:40.11,0:20:43.73,Default,SERENA,0,0,0,,Tôi vừa nhận được báo cáo về mọi chuyện\Nxảy ra tại thuộc địa rồi.
Dialogue: 0,0:20:43.73,0:20:45.73,Default,SERENA,0,0,0,,Xem ra anh lại giật trọn hào quang thêm lần nữa nhỉ.
Dialogue: 0,0:20:46.04,0:20:48.68,DefaultItalics,HIRO,0,0,0,,Ừ, thế nên tôi mới nghĩ mình cũng tới lúc\Nđược đi nghỉ mát xả hơi rồi.
Dialogue: 0,0:20:48.92,0:20:52.11,Default,SERENA,0,0,0,,Thực chất là anh muốn chuồn êm trước khi tôi\Nkịp quay về chứ gì.
Dialogue: 0,0:20:53.38,0:20:57.05,Default,SERENA,0,0,0,,Tôi phiền phức đáng ghét tới mức đó sao?
Dialogue: 0,0:20:57.05,0:20:59.99,Default,HIRO,0,0,0,,T-Tôi đâu dám nói thế.
Dialogue: 0,0:20:59.99,0:21:02.99,Default,HIRO,0,0,0,,Chỉ tại địa vị danh giá của cô khiến mọi chuyện\Nhơi phức tạp rắc rối thôi.
Dialogue: 0,0:21:02.99,0:21:05.44,DefaultItalics,HIRO,0,0,0,,Thân phận nhỏ bé này nào dám sánh cạnh tiểu thư.
Dialogue: 0,0:21:06.11,0:21:10.24,Default,SERENA,0,0,0,,Tôi sẽ không ép anh thêm nữa đâu. Chỉ là...
Dialogue: 0,0:21:11.24,0:21:12.70,Default,HIRO,0,0,0,,Cô vừa nói gì thế?
Dialogue: 0,0:21:12.70,0:21:14.21,DefaultItalics,SERENA,0,0,0,,Liệu tôi, ờm...
Dialogue: 0,0:21:15.02,0:21:17.16,DefaultItalics,SERENA,0,0,0,,Liệu tôi có còn cơ hội được gặp lại anh không?
Dialogue: 0,0:21:18.29,0:21:20.12,Default,HIRO,0,0,0,,Nếu có dịp hội ngộ thì nhất định.
Dialogue: 0,0:21:21.33,0:21:23.58,Default,SERENA,0,0,0,,Tốt lắm. Vậy hẹn gặp lại lần sau nhé.
Dialogue: 0,0:21:26.31,0:21:28.83,Default,HIRO,0,0,0,,Chơi chiêu đó là ăn gian đấy nhé.
Dialogue: 0,0:21:28.83,0:21:29.72,Default,MIMI,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:30.42,0:21:34.04,Default,MIMI,0,0,0,,Anh Hiro đúng chuẩn cứ thấy mỹ nhân\Nlà mềm lòng ngay lập tức nhỉ.
Dialogue: 0,0:21:34.04,0:21:38.35,Default,ELMA,0,0,0,,Phải đấy, bất kể là Thiếu tá Serena\Nhay Bác sĩ Shouko luôn.
Dialogue: 0,0:21:38.35,0:21:40.69,Default,HIRO,0,0,0,,Rồi rồi, biết lỗi rồi.
Dialogue: 0,0:21:40.69,0:21:43.57,Default,HIRO,0,0,0,,Anh hứa tới Hệ sao Cierra sẽ khao hai người\Nmột bữa linh đình đền bù.
Dialogue: 0,0:21:43.57,0:21:45.41,Default,ELMA,0,0,0,,Nhớ giữ lời đấy nhé.
Dialogue: 0,0:21:45.41,0:21:46.62,Default,MIMI,0,0,0,,Em mong chờ tới lúc đó lắm ạ.
Dialogue: 0,0:21:46.62,0:21:48.22,Default,HIRO,0,0,0,,Giờ thì, thẳng tiến đi nghỉ mát thôi nào!
Dialogue: 0,0:21:48.22,0:21:49.27,Default,MIMI & ELMA,0,0,0,,Đi thôi!
Dialogue: 0,0:21:53.08,0:21:57.08,Credits,CREDITS,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)\NBiên tập & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:21:57.08,0:22:01.09,Credits,CREDITS,0,0,0,,Timing: Amtia(NOFACE)\NKiểm định chất lượng (QC): Amtia(NOFACE)
Dialogue: 0,0:23:35.01,0:23:40.09,Signs,NEXTEPTITLE,0,0,0,,{\fnSegoe UI\fs32\bord1.7\c&H2AFFFD&\3c&H171817&\pos(325,234)}Người Đẹp Ngủ Trong Rừng
