Dialogue: 0,0:00:00.97,0:00:03.18,Default,Kousuke(M),0,0,0,,{\i1}Nếu cậu là nam chính của một tựa game eroge,
Dialogue: 0,0:00:03.18,0:00:06.18,Default,Kousuke(M),0,0,0,,{\i1}thì thường cậu sẽ có một đời tư\Nhào nhoáng lắm đấy.
Dialogue: 0,0:00:13.49,0:00:15.49,Default,Kousuke(M),0,0,0,,{\i1}Có những đàn chị đáng tin cậy để dựa dẫm,
Dialogue: 0,0:00:15.49,0:00:17.25,Default,Kousuke(M),0,0,0,,{\i1}có dàn nữ chính hết mực si mê,
Dialogue: 0,0:00:17.25,0:00:19.88,Default,Kousuke(M),0,0,0,,{\i1}cùng một cốt truyện được bảo chứng\Nsẽ đi đến cái kết viên mãn.
Dialogue: 0,0:00:19.88,0:00:22.39,Default,Kousuke(M),0,0,0,,{\i1}Chuyện thiết lập như thế cũng hoàn toàn dễ hiểu thôi,
Dialogue: 0,0:00:22.39,0:00:27.02,Default,Kousuke(M),0,0,0,,{\i1}vì đa số người chơi đều tìm kiếm\Nnhững câu chuyện hạnh phúc như vậy mà.
Dialogue: 0,0:00:27.02,0:00:28.73,Default,Marino,0,0,0,,Chào buổi sáng, Kou-chan.
Dialogue: 0,0:00:28.73,0:00:31.71,Default,Marino,0,0,0,,Chị nhờ em lên đánh thức Hatsumi dậy được không?
Dialogue: 0,0:00:31.71,0:00:32.78,Default,Kousuke,0,0,0,,Em hiểu rồi ạ.
Dialogue: 0,0:00:33.00,0:00:35.92,Default,Kousuke(M),0,0,0,,{\i1}Thế còn nhân vật bạn thân làm nền\Ntrong game eroge thì sao nhỉ?
Dialogue: 0,0:00:35.92,0:00:38.78,Default,Kousuke(M),0,0,0,,{\i1}Tôi chẳng dám vờ như cậu ta\Nlúc nào cũng tận hưởng cuộc sống đâu...
Dialogue: 0,0:00:39.63,0:00:40.69,Default,Kousuke,0,0,0,,Chị Hatsumi ơi.
Dialogue: 0,0:00:40.69,0:00:42.79,Default,Kousuke,0,0,0,,Tới giờ ăn sáng rồi đấy ạ, nên là...
Dialogue: 0,0:00:45.89,0:00:46.96,Default,Kousuke,0,0,0,,Dậy đi nào, chị ơi.
Dialogue: 0,0:00:47.23,0:00:49.34,Default,Kousuke,0,0,0,,Không dậy là trễ gi—
Dialogue: 0,0:00:53.39,0:00:55.93,Default,Hatsumi,0,0,0,,Phải gọi chị là "Chị gái yêu dấu" mới đúng chứ.
Dialogue: 0,0:00:58.00,0:01:00.20,Default,Kousuke(M),0,0,0,,{\i1}Nhưng riêng cậu bạn nền này thì đang sống sướng như tiên.
Dialogue: 0,0:01:00.20,0:01:03.06,Default,Kousuke(M),0,0,0,,{\i1}Thậm chí tôi dám khẳng định mình sống tốt\Nchẳng kém gì nam chính eroge nào hết.
Dialogue: 0,0:01:03.06,0:01:04.98,Default,Kousuke(M),0,0,0,,{\i1}Ít nhất thì tôi tự thấy thế...
Dialogue: 0,0:01:04.98,0:01:09.98,sign_35245_386_Reborn_as_a_Side,SIGN,0,0,0,,{\fs23\move(262,73,265,83,16,4979)}{\blur2}{\c&H000000&}Đó là{\c&H6E00E7&} Quả Bom Hồng {\c&H000000&}\N{\fs12\i1}Phụ đề: Amtia(NOFACE){\i0}
Dialogue: 0,0:01:06.40,0:01:07.51,Default,Kousuke(M),0,0,0,,{\i1}Đúng không nào?
Dialogue: 0,0:02:44.40,0:02:46.59,Default,Kousuke,0,0,0,,Chắc tụi mình cũng nên xuất phát thôi nhỉ.
Dialogue: 0,0:02:49.43,0:02:51.55,Default,Ludie,0,0,0,,Thế còn tiết học tiếp theo thì sao?
Dialogue: 0,0:02:51.55,0:02:54.88,Default,Kousuke,0,0,0,,Không sao đâu. Tôi đi học đủ số buổi quy định rồi.
Dialogue: 0,0:02:54.88,0:02:55.57,Default,Ludie,0,0,0,,Nhưng mà!
Dialogue: 0,0:02:57.78,0:03:00.12,Default,Katorina,0,0,0,,Hắn lại cúp tiết nữa à?
Dialogue: 0,0:03:00.71,0:03:01.91,Default,Iori,0,0,0,,Kousuke-kun...
Dialogue: 0,0:03:02.13,0:03:04.81,Default,Classmates,0,0,0,,Tên khốn đó, hắn lại làm tiểu thư\NLudivine phật lòng rồi kìa.
Dialogue: 0,0:03:04.81,0:03:06.79,Default,Classmates,0,0,0,,Hắn nên biết thân biết phận mình đi chứ.
Dialogue: 0,0:03:06.79,0:03:08.67,Default,Classmates,0,0,0,,Đúng là đồ học sinh cá biệt vô tích sự...
Dialogue: 0,0:03:08.67,0:03:11.76,Default,Classmates,0,0,0,,Đã không chịu học hành tử tế\Nthì vác mặt tới trường làm gì không biết?
Dialogue: 0,0:03:12.39,0:03:15.47,Default,Nanami,0,0,0,,Thưa Chủ nhân, hôm nay ta lại vào hầm ngục tiếp ạ?
Dialogue: 0,0:03:15.47,0:03:18.14,Default,Kousuke,0,0,0,,Chắc vậy rồi. Có một kỹ năng\Ntôi muốn kiếm về.
Dialogue: 0,0:03:18.84,0:03:21.88,Default,Kousuke(M),0,0,0,,{\i1}Nhưng muốn vào chỗ đó thì phải xin giấy phép.
Dialogue: 0,0:03:21.88,0:03:23.56,Default,Ruija,0,0,0,,Em Takioto!
Dialogue: 0,0:03:24.51,0:03:26.01,Default,Kousuke,0,0,0,,C-Cô Ruija ạ?
Dialogue: 0,0:03:26.01,0:03:27.07,Default,Ruija,0,0,0,,Trời đất ơi!
Dialogue: 0,0:03:27.07,0:03:29.11,Default,Ruija,0,0,0,,Cô biết ngay là em lại trốn học mà!
Dialogue: 0,0:03:29.11,0:03:30.97,Default,Ruija,0,0,0,,Mau đi theo cô ngay lập tức!
Dialogue: 0,0:03:30.97,0:03:31.65,Default,Kousuke,0,0,0,,Hả?
Dialogue: 0,0:03:32.79,0:03:35.26,Default,Ruija,0,0,0,,May quá cô tìm được em ngay lập tức.
Dialogue: 0,0:03:36.07,0:03:37.23,Default,Ruija,0,0,0,,Mà này.
Dialogue: 0,0:03:37.23,0:03:44.36,Default,Ruija,0,0,0,,Thật ra Hatsumi có tâm sự với cô\Nvề chuyện em "không thể phóng thích ma lực".
Dialogue: 0,0:03:44.36,0:03:45.57,Default,Kousuke,0,0,0,,Chị ấy kể ạ?
Dialogue: 0,0:03:46.68,0:03:48.67,Default,Ruija,0,0,0,,Thật ra Hatsumi là đàn em khóa dưới của cô đấy!
Dialogue: 0,0:03:49.10,0:03:51.33,Default,Ruija,0,0,0,,Ngày xưa hai chị em cô hay rủ nhau đi càn hầm ngục lắm.
Dialogue: 0,0:03:51.33,0:03:52.92,Default,Kousuke,0,0,0,,Em không hề biết chuyện đó luôn.
Dialogue: 0,0:03:53.15,0:03:54.06,Default,Ruija,0,0,0,,Thật đấy.
Dialogue: 0,0:03:54.06,0:03:56.36,Default,Ruija,0,0,0,,Ủa, Hatsumi chưa kể với em à?
Dialogue: 0,0:03:56.36,0:03:58.80,Default,Kousuke,0,0,0,,Chị ấy ít khi kể mấy chuyện kiểu đó\Nvới em lắm ạ.
Dialogue: 0,0:03:58.80,0:04:03.31,Default,Ruija,0,0,0,,Vậy mà với cô, con bé lại cởi mở\Nkể đủ thứ chuyện về em một cách lạ thường đấy.
Dialogue: 0,0:04:03.31,0:04:06.77,Default,Ruija,0,0,0,,Đây là món đồ cô mượn về\Nvì con bé nhờ vả đấy.
Dialogue: 0,0:04:09.17,0:04:10.19,Default,Ruija,0,0,0,,Tèn ten!
Dialogue: 0,0:04:10.19,0:04:12.44,Default,Ruija,0,0,0,,Máy đo chỉ số ma lực đấy!
Dialogue: 0,0:04:13.38,0:04:15.21,Default,Kousuke,0,0,0,,Máy đo ma lực cơ ạ?
Dialogue: 0,0:04:16.01,0:04:18.20,Default,Nanami,0,0,0,,Hình dáng nom thú vị phết nhỉ.
Dialogue: 0,0:04:18.41,0:04:20.65,Default,Kousuke,0,0,0,,Tại sao trên máy lại mọc hai cái sừng thế kia?
Dialogue: 0,0:04:20.65,0:04:21.53,Default,Ruija,0,0,0,,Cô chịu thôi.
Dialogue: 0,0:04:21.82,0:04:24.96,Default,Kousuke,0,0,0,,Thế còn hàng tá biểu tượng đầu lâu\Nkia là sao ạ?
Dialogue: 0,0:04:24.96,0:04:25.79,Default,Ruija,0,0,0,,Cô cũng không rõ.
Dialogue: 0,0:04:25.79,0:04:28.46,Default,Kousuke,0,0,0,,Với lại sao vài cái công tắc ở đây\Nlại đang bật sẵn vậy?
Dialogue: 0,0:04:28.46,0:04:29.63,Default,Ruija,0,0,0,,Cô không biết đâu.
Dialogue: 0,0:04:29.63,0:04:31.17,Default,Kousuke,0,0,0,,Em chợt nhớ ra mình có việc gấp phải đi rồi.
Dialogue: 0,0:04:31.17,0:04:33.39,Default,Ruija,0,0,0,,Khoan đã nào!
Dialogue: 0,0:04:33.92,0:04:35.32,Default,Ruija,0,0,0,,An toàn tuyệt đối mà!
Dialogue: 0,0:04:35.32,0:04:39.60,Default,Ruija,0,0,0,,Lúc mới nhìn thấy cô cũng hơi rờn rợn,\Nnhưng bảo đảm an toàn!
Dialogue: 0,0:04:39.60,0:04:42.40,Default,Ruija,0,0,0,,Cô mượn của nhà phát minh thiên tài\Nsố một học viện cơ mà,
Dialogue: 0,0:04:42.40,0:04:44.47,Default,Ruija,0,0,0,,nên cô bảo an toàn là chắc chắn an toàn!
Dialogue: 0,0:04:44.47,0:04:45.35,Default,Ruija,0,0,0,,Chắc thế.
Dialogue: 0,0:04:46.35,0:04:49.05,Default,Kousuke,0,0,0,,Thứ này từng chạy thử nghiệm chưa đấy ạ?
Dialogue: 0,0:04:50.17,0:04:52.84,Default,Kousuke,0,0,0,,Mà rốt cuộc ai là người phát minh ra nó thế cô?
Dialogue: 0,0:04:53.24,0:04:55.63,Default,Ruija,0,0,0,,Chắc em không biết chị ấy đâu...
Dialogue: 0,0:04:55.63,0:04:57.57,Default,Ruija,0,0,0,,Là chị Anemone học năm ba đấy.
Dialogue: 0,0:04:59.31,0:05:02.23,Default,Kousuke,0,0,0,,Em không có ý thất lễ đâu,\Nnhưng cô mau đem trả lại đi ạ.
Dialogue: 0,0:05:02.80,0:05:06.99,Default,Ruija,0,0,0,,Nhưng nhỡ đâu phép màu thật sự xảy ra thì sao?!
Dialogue: 0,0:05:06.99,0:05:08.29,Default,Kousuke(M),0,0,0,,{\i1}Hừm...
Dialogue: 0,0:05:08.87,0:05:15.36,Default,Kousuke(M),0,0,0,,{\i1}Chị Anemone đúng chuẩn hình mẫu nữ bác học\Nquyến rũ chắc chắn có mặt trong dàn MagiEx.
Dialogue: 0,0:05:15.69,0:05:18.17,Default,Kousuke(M),0,0,0,,{\i1}Đúng là chị ấy thiên tài thật đấy, cơ mà...
Dialogue: 0,0:05:18.71,0:05:20.99,Default,Kousuke,0,0,0,,Chẳng phải cô nên dùng thử trước cho biết sao?
Dialogue: 0,0:05:20.99,0:05:22.19,Default,Ruija,0,0,0,,Chuyện đó bất khả thi rồi.
Dialogue: 0,0:05:22.19,0:05:25.13,Default,Ruija,0,0,0,,Hơn nữa, khi cô kể với chị ấy\Nvề tình trạng của em,
Dialogue: 0,0:05:25.13,0:05:28.13,Default,Ruija,0,0,0,,chị ấy bảo có món đồ hoàn hảo đúng bệnh\Nrồi cho cô mượn cái này luôn.
Dialogue: 0,0:05:28.13,0:05:30.25,Default,Ruija,0,0,0,,Vả lại, nếu cô báo cáo kết quả lại cho chị ấy,
Dialogue: 0,0:05:30.25,0:05:33.15,Default,Ruija,0,0,0,,chị ấy hứa sẽ giữ kín\N"chuyện đó" giùm cô.
Dialogue: 0,0:05:33.15,0:05:34.61,Default,Kousuke,0,0,0,,Chuyện gì cơ ạ?
Dialogue: 0,0:05:34.86,0:05:38.07,Default,Ruija,0,0,0,,Ặc! Ừm, à thì...
Dialogue: 0,0:05:38.43,0:05:39.40,Default,Kousuke(M),0,0,0,,{\i1}Mình nhớ ra rồi.
Dialogue: 0,0:05:39.40,0:05:43.32,Default,Kousuke(M),0,0,0,,{\i1}Trong cốt truyện MagiEx, thiết lập là\Nchị Anemone nắm thóp được bí mật của cô Ruija.
Dialogue: 0,0:05:45.79,0:05:46.91,Default,Nanami,0,0,0,,Thưa Chủ nhân?
Dialogue: 0,0:05:46.91,0:05:48.01,Default,Kousuke,0,0,0,,Được rồi.
Dialogue: 0,0:05:48.01,0:05:49.22,Default,Kousuke,0,0,0,,Thử thì thử.
Dialogue: 0,0:05:49.22,0:05:51.94,Default,Kousuke,0,0,0,,Nhưng đổi lại cô phải khai thật\Nxem cô đang giấu giếm chuyện gì.
Dialogue: 0,0:05:51.94,0:05:53.80,Default,Ruija,0,0,0,,Hả? Nhưng chuyện đó thì...
Dialogue: 0,0:05:53.80,0:05:56.13,Default,Ruija,0,0,0,,Thì tụi mình... đang ở trong học viện,\Nnên xét về quy tắc ứng xử...
Dialogue: 0,0:05:56.13,0:05:57.55,Default,Ruija,0,0,0,,sợ vi phạm nội quy học đường mất...
Dialogue: 0,0:05:57.55,0:05:58.30,Default,Kousuke(M),0,0,0,,{\i1}Ở trong game,
Dialogue: 0,0:05:58.30,0:06:01.88,Default,Kousuke(M),0,0,0,,{\i1}mạch truyện phát triển tình cảm với cô Ruija\Nkhông hề diễn ra trong khuôn viên trường.
Dialogue: 0,0:06:02.93,0:06:04.43,Default,Kousuke(M),0,0,0,,{\i1}Địa điểm bắt gặp cô ấy chính là...
Dialogue: 0,0:06:04.43,0:06:07.31,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\c&HC59BFF&\frz358.5\move(66,64,117,66,19,2855)}Quán Cà Phê Gặp Gỡ
Dialogue: 0,0:06:04.43,0:06:07.31,sign_10776_105_Boo_m,SIGN,0,0,0,,{\blur1\move(261,114,308,115,19,2855)}Bùm~
Dialogue: 0,0:06:04.43,0:06:07.31,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\fs10\c&HE3B4E0&\frz8.504\move(377,49,425,47,19,2855)}{\blur1}Mèo và\NBạn bè
Dialogue: 0,0:06:04.43,0:06:07.31,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\3c&HFDBDFD&\c&HFFFFFF&\frz353.2\move(489,116,532,119,19,2855)}{\blur1\i1}Quán Rượu Gợi Cảm
Dialogue: 0,0:06:04.96,0:06:07.31,Default,Kousuke(M),0,0,0,,{\i1}Cái nơi mà người ta hay gọi là\Nphố đèn đỏ ấy.
Dialogue: 0,0:06:08.07,0:06:11.73,Default,Kousuke(M),0,0,0,,{\i1}Tên Takioto cực kỳ tò mò nên đã\Nrủ rê Iori cùng kéo tới đó.
Dialogue: 0,0:06:11.73,0:06:15.09,Default,Kousuke(M),0,0,0,,{\i1}Và ngay tại chốn đó, Iori tình cờ\Nbắt gặp...
Dialogue: 0,0:06:11.73,0:06:14.52,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\c&HAE5DFB&\pos(228,168)\frz2.313}Bí Mật <3
Dialogue: 0,0:06:25.28,0:06:27.87,Default,Kousuke(M),0,0,0,,{\i1}Trong game không hề giải thích\Nchi tiết lý do,
Dialogue: 0,0:06:27.87,0:06:31.91,Default,Kousuke(M),0,0,0,,{\i1}nhưng nghe bảo cô ấy phải đi làm thêm\Nvì túng thiếu tiền bạc.
Dialogue: 0,0:06:32.37,0:06:35.78,Default,Kousuke(M),0,0,0,,{\i1}Nếu nhân vật của cô ấy được lòng\Ncánh mày râu người chơi,
Dialogue: 0,0:06:35.78,0:06:37.50,Default,Kousuke(M),0,0,0,,{\i1}thì bản cập nhật sau mới bổ sung\Nthêm tuyến truyện giải thích lý do cần tiền.
Dialogue: 0,0:06:37.79,0:06:40.98,Default,Kousuke(M),0,0,0,,{\i1}về nguyên nhân thực sự đằng sau.
Dialogue: 0,0:06:42.85,0:06:44.49,Default,Kousuke,0,0,0,,Em cũng đoán ra đại khái rồi.
Dialogue: 0,0:06:44.49,0:06:46.48,Default,Kousuke,0,0,0,,Nhưng em vẫn muốn tự miệng cô\Nkhai hết bí mật ra cơ.
Dialogue: 0,0:06:46.48,0:06:48.66,Default,Ruija,0,0,0,,Hả?! Cô tưởng em hiểu rồi chứ.
Dialogue: 0,0:06:48.66,0:06:49.08,Default,Kousuke,0,0,0,,Nhìn chằm chằm...
Dialogue: 0,0:06:49.08,0:06:50.68,Default,Ruija,0,0,0,,Cô... Cô xin lỗi.
Dialogue: 0,0:06:51.51,0:06:52.88,Default,Kousuke,0,0,0,,Thôi được rồi ạ.
Dialogue: 0,0:06:52.88,0:06:56.64,Default,Kousuke,0,0,0,,Mình bật máy lên đo nhanh\Ncho xong chuyện đi cô.
Dialogue: 0,0:06:56.64,0:06:57.78,Default,Kousuke,0,0,0,,Sau đó rồi tính tiếp...
Dialogue: 0,0:06:57.78,0:06:58.77,Default,Ruija,0,0,0,,Ư-Ừm!
Dialogue: 0,0:06:58.77,0:07:02.03,Default,Ruija,0,0,0,,Ờm, em chắc chắn không sao khi\Ndùng cái máy này chứ?
Dialogue: 0,0:07:02.28,0:07:05.57,Default,Kousuke,0,0,0,,Cô định dùng nó tìm hiểu nguyên nhân vì sao em
Dialogue: 0,0:07:05.57,0:07:07.87,Default,Kousuke,0,0,0,,"không thể phóng thích ma lực trôi chảy", đúng không?
Dialogue: 0,0:07:08.98,0:07:12.33,Default,Kousuke,0,0,0,,Thế... tại sao em lại phải cởi sạch trơn thế này?!
Dialogue: 0,0:07:12.60,0:07:15.08,Default,Nanami,0,0,0,,Trong sách hướng dẫn sử dụng nó ghi y như vậy mà.
Dialogue: 0,0:07:16.83,0:07:18.80,Default,Ruija,0,0,0,,Đáng kinh ngạc thật...
Dialogue: 0,0:07:18.80,0:07:21.19,Default,Nanami,0,0,0,,Tiếp theo, tôi sẽ gắn các đầu giác hút\Nlên khắp cơ thể ngài.
Dialogue: 0,0:07:21.19,0:07:22.67,Default,Ruija,0,0,0,,Đ-Để cô phụ một tay!
Dialogue: 0,0:07:28.79,0:07:30.46,Default,Kousuke,0,0,0,,Hai người làm nhanh giùm em được không?!
Dialogue: 0,0:07:30.46,0:07:32.12,Default,Ruija,0,0,0,,Cô... xin lỗi!
Dialogue: 0,0:07:33.42,0:07:35.36,Default,Kousuke(M),0,0,0,,{\i1}Mình đang được hưởng phúc lợi đấy à?!
Dialogue: 0,0:07:35.36,0:07:36.94,Default,Kousuke(M),0,0,0,,{\i1}Tình huống này nguy hiểm đủ đường luôn rồi,
Dialogue: 0,0:07:36.94,0:07:38.44,Default,Kousuke(M),0,0,0,,{\i1}làm ơn đứng dậy lẹ lên giùm em đi cô ơi!
Dialogue: 0,0:07:38.44,0:07:39.71,Default,Ruija,0,0,0,,Xin lỗi nhé!
Dialogue: 0,0:07:39.71,0:07:41.69,Default,Kousuke,0,0,0,,Nanami, nhanh tay lên giùm tôi đi!
Dialogue: 0,0:07:41.69,0:07:44.49,Default,Nanami,0,0,0,,Vậy tôi xin phép bật công tắc đây.
Dialogue: 0,0:07:52.58,0:07:55.00,Default,Ruija,0,0,0,,E-Em có sao không đấy?!
Dialogue: 0,0:07:55.65,0:08:00.46,Default,Kousuke,0,0,0,,Về mặt thể xác thì ổn, nhưng tinh thần\Nthì em đang cố gắng bám trụ từng giây.
Dialogue: 0,0:08:00.46,0:08:02.02,Default,Ruija,0,0,0,,Cô thật lòng xin lỗi mà!
Dialogue: 0,0:08:02.02,0:08:04.74,Default,Ruija,0,0,0,,Nhưng chí ít tụi mình cũng thu thập được\Nmột lượng dữ liệu đáng kể rồi!
Dialogue: 0,0:08:06.51,0:08:08.93,Default,Nanami,0,0,0,,Xem ra cỗ máy này không được mặt dày\Nbền bỉ như ngài nhỉ...
Dialogue: 0,0:08:09.19,0:08:13.81,Default,Kousuke(M),0,0,0,,{\i1}Quả nhiên đúng như mình nghi ngờ,\Nđồ chị Anemone chế tạo chẳng đáng tin nổi...
Dialogue: 0,0:08:16.14,0:08:17.72,Default,Kousuke,0,0,0,,Cô có phân tích ra được manh mối gì không ạ?
Dialogue: 0,0:08:17.72,0:08:19.19,Default,Ruija,0,0,0,,Cũng sơ sơ rồi.
Dialogue: 0,0:08:19.19,0:08:21.65,Default,Ruija,0,0,0,,Nhìn từ số liệu vừa hiện lên lúc nãy,
Dialogue: 0,0:08:21.65,0:08:24.78,Default,Ruija,0,0,0,,có vẻ như có thứ gì đó đang chặn đứng\Nquá trình cụ thể hóa ma thuật
Dialogue: 0,0:08:24.78,0:08:26.19,Default,Ruija,0,0,0,,ngay trước khi nó kịp diễn ra.
Dialogue: 0,0:08:26.19,0:08:28.74,Default,Ruija,0,0,0,,Hoặc cũng có khả năng là có thứ gì đó\Nđang gây nhiễu loạn từ bên trong chăng?
Dialogue: 0,0:08:29.31,0:08:34.37,Default,Nanami,0,0,0,,Nói vậy chứ, lượng ma lực tiềm ẩn của ngài\Ncao tới mức kinh ngạc thật đấy.
Dialogue: 0,0:08:34.88,0:08:37.91,Default,Nanami,0,0,0,,Thậm chí còn là một bí ẩn y học khi\Ncơ thể ngài chứa nổi chừng đó ma lực.
Dialogue: 0,0:08:37.91,0:08:39.33,Default,Kousuke,0,0,0,,Thật luôn á?
Dialogue: 0,0:08:39.33,0:08:43.09,Default,Ruija,0,0,0,,Chẳng lẽ vấn đề không nằm ở số lượng khác thường,
Dialogue: 0,0:08:43.09,0:08:46.18,Default,Ruija,0,0,0,,mà nằm ở nơi lưu trữ ma lực vốn dĩ\Nhoàn toàn khác biệt từ bản chất sao?
Dialogue: 0,0:08:46.18,0:08:47.34,Default,Ruija,0,0,0,,Nếu đúng là như vậy thật,
Dialogue: 0,0:08:47.56,0:08:50.56,Default,Ruija,0,0,0,,điều đó sẽ củng cố hoàn toàn giả thuyết\Ncủa Hatsumi từng đề xuất
Dialogue: 0,0:08:50.56,0:08:53.63,Default,Ruija,0,0,0,,về sự sinh sôi và tích trữ ma lực\Nbên trong chiều không gian khác...
Dialogue: 0,0:08:53.63,0:08:56.28,Default,Ruija,0,0,0,,Nhưng nếu giả thuyết đó chuẩn xác,\Nthì học thuyết mà Faust chủ xướng,
Dialogue: 0,0:08:54.35,0:08:56.71,Default,Nanami,0,0,0,,{\an8}Không biết nghiên cứu này\Ncó dẫn tới giải pháp gì không nhỉ.
Dialogue: 0,0:08:56.28,0:08:58.85,Default,Ruija,0,0,0,,và vốn đã được nhiều nhà khoa học\Nchứng minh từng phần...
Dialogue: 0,0:08:56.71,0:08:57.85,Default,Kousuke,0,0,0,,{\an8}Tôi cũng tò mò ghê.
Dialogue: 0,0:09:01.62,0:09:03.07,Default,Ruija,0,0,0,,Tuyệt vời quá đi mất!
Dialogue: 0,0:09:03.07,0:09:06.23,Default,Ruija,0,0,0,,Nếu giải mã thành công, đây chắc chắn\Nsẽ là phát kiến mang tính lịch sử luôn đấy!
Dialogue: 0,0:09:06.63,0:09:09.06,Default,Ruija,0,0,0,,Quá xứng đáng làm đề tài nghiên cứu\Nđể đời luôn rồi!
Dialogue: 0,0:09:09.06,0:09:11.70,Default,Kousuke,0,0,0,,Vậy cô cứ từ từ phân tích chỗ dữ liệu đó nhé.
Dialogue: 0,0:09:11.96,0:09:13.76,Default,Kousuke,0,0,0,,Nhưng tạm gác chuyện đó sang một bên đã...
Dialogue: 0,0:09:14.14,0:09:16.90,Default,Kousuke,0,0,0,,Mong là cô vẫn nhớ giữ đúng lời hứa ban nãy.
Dialogue: 0,0:09:16.90,0:09:17.84,Default,Ruija,0,0,0,,Hở?
Dialogue: 0,0:09:18.47,0:09:19.71,Default,Ruija,0,0,0,,Hức...
Dialogue: 0,0:09:19.71,0:09:21.42,Default,Kousuke,0,0,0,,Nợ nần ngập đầu cơ ạ?!
Dialogue: 0,0:09:21.42,0:09:22.54,Default,Ruija,0,0,0,,Cô xin lỗi nhiều lắm...
Dialogue: 0,0:09:23.06,0:09:24.24,Default,Kousuke,0,0,0,,Để em tóm tắt lại cho rõ nhé.
Dialogue: 0,0:09:24.24,0:09:27.68,Default,Kousuke,0,0,0,,Vì nợ nần và thuế má chất chồng,\Nnên cô cạn sạch tiền bạc.
Dialogue: 0,0:09:27.68,0:09:29.96,Default,Kousuke,0,0,0,,Tiền thuê nhà khất quá hạn nên bị đuổi ra đường.
Dialogue: 0,0:09:29.96,0:09:33.74,Default,Kousuke,0,0,0,,Cô vừa mới định bước chân đi làm thêm\Nở khu phố đèn đỏ
Dialogue: 0,0:09:33.74,0:09:35.84,Default,Kousuke,0,0,0,,thì bị chị Anemone bắt gặp ngay tại trận,
Dialogue: 0,0:09:35.84,0:09:40.65,Default,Kousuke,0,0,0,,nên cô đành nhắm mắt làm theo mọi sai khiến\Ncủa chị ấy để đổi lấy sự im lặng, đúng không?
Dialogue: 0,0:09:40.65,0:09:41.90,Default,Ruija,0,0,0,,Đúng thế.
Dialogue: 0,0:09:42.13,0:09:44.13,Default,Nanami,0,0,0,,Thế có lập hợp đồng giấy trắng mực đen không?
Dialogue: 0,0:09:44.13,0:09:45.19,Default,Ruija,0,0,0,,Không có đâu.
Dialogue: 0,0:09:45.50,0:09:47.10,Default,Ruija,0,0,0,,Nhưng mà người bên chỗ cho vay họ cũng\Nlập cho cô một lộ trình
Dialogue: 0,0:09:47.10,0:09:50.82,Default,Ruija,0,0,0,,trả góp nhẹ nhàng không áp lực\Nvừa túi tiền hàng tháng luôn đấy.
Dialogue: 0,0:09:51.07,0:09:53.05,Default,Kousuke,0,0,0,,Em e là cô bị bọn họ lừa gạt rồi đấy.
Dialogue: 0,0:09:53.05,0:09:53.63,Default,Ruija,0,0,0,,Hả?
Dialogue: 0,0:09:53.63,0:09:56.33,Default,Kousuke,0,0,0,,Sao cô lại để mọi chuyện trượt dài\Ntới nông nỗi thê thảm này thế?
Dialogue: 0,0:09:57.22,0:09:59.03,Default,Kousuke,0,0,0,,Cô bao nhiêu tuổi rồi hả?
Dialogue: 0,0:09:59.03,0:10:00.96,Default,Kousuke,0,0,0,,Cô bước ra đời sống tự lập\Nđược bao nhiêu năm rồi?!
Dialogue: 0,0:10:00.96,0:10:03.51,Default,Ruija,0,0,0,,Cô xin lỗi mà!
Dialogue: 0,0:10:03.51,0:10:06.51,Default,Kousuke(M),0,0,0,,{\i1}Phải rồi, tầm này chắc mình cũng muốn khóc luôn quá.
Dialogue: 0,0:10:04.50,0:10:09.19,Default,Ruija,0,0,0,,{\an8}Nhưng mà, nhưng mà!
Dialogue: 0,0:10:06.51,0:10:09.77,Default,Kousuke(M),0,0,0,,{\i1}Ý là, cô giáo đường đường mà bị chính\Nhọc sinh lên lớp dạy đời về chuyện tiền bạc kìa.
Dialogue: 0,0:10:10.11,0:10:11.97,Default,Nanami,0,0,0,,Thưa Chủ nhân, giờ ngài định xử lý ra sao?
Dialogue: 0,0:10:12.81,0:10:14.72,Default,Kousuke,0,0,0,,Chuyện này thì...
Dialogue: 0,0:10:18.22,0:10:19.62,Default,Kousuke,0,0,0,,Này, chị Marino ơi?
Dialogue: 0,0:10:19.62,0:10:21.69,Default,Ruija,0,0,0,,Hiệu trưởng?! Đừng gọi hiệu trưởng tới mà!
Dialogue: 0,0:10:23.40,0:10:25.23,sign_16985_199_Dunning_Letter,SIGN,0,0,0,,{\pos(511,40)\frz338.1\frx18\fry2}Giấy Đòi Nợ
Dialogue: 0,0:10:26.75,0:10:29.82,Default,Marino,0,0,0,,Chị cũng phục em thật đấy, trụ tới tận giờ\Nmà chưa bị tụi nó lôi đi bán nội tạng.
Dialogue: 0,0:10:30.09,0:10:35.31,Default,Kousuke(M),0,0,0,,{\i1}Cuối cùng, tụi mình cũng thương lượng giảm được\Nmột khoản đáng kể trong số nợ của cô Ruija.
Dialogue: 0,0:10:35.71,0:10:39.64,Default,Kousuke(M),0,0,0,,{\i1}Dù cũng phải nhờ tới luật sư và cố vấn thuế\Ndo gia tộc Hanamura thuê,
Dialogue: 0,0:10:39.64,0:10:45.00,Default,Kousuke(M),0,0,0,,{\i1}lẫn đích thân sang dàn xếp với mấy gã\Ntrông mặt mũi bặm trợn kia nữa...
Dialogue: 0,0:10:46.77,0:10:48.94,Default,Marino,0,0,0,,Về phần số nợ còn lại,
Dialogue: 0,0:10:48.94,0:10:51.61,Default,Marino,0,0,0,,chị quyết định gia tộc Hanamura sẽ đứng ra\Ngánh trọn đứng tên quản lý toàn bộ.
Dialogue: 0,0:10:52.19,0:10:55.18,Default,Kousuke,0,0,0,,Chủ nợ uy tín và an toàn nhất quả đất\Nmà em có thể nghĩ ra luôn đấy.
Dialogue: 0,0:10:55.42,0:10:57.23,Default,Marino,0,0,0,,Thiệt tình.
Dialogue: 0,0:10:57.23,0:10:59.93,Default,Marino,0,0,0,,Nếu em là giáo viên bình thường khác\Nthì chị đã sa thải ngay tại chỗ rồi.
Dialogue: 0,0:11:00.54,0:11:03.34,Default,Marino,0,0,0,,Hãy biết ơn Kou-chan và thành tích giảng dạy\Nvững vàng của chính em đi đấy.
Dialogue: 0,0:11:03.34,0:11:04.54,Default,Ruija,0,0,0,,Tất nhiên rồi ạ!
Dialogue: 0,0:11:04.54,0:11:06.65,Default,Ruija,0,0,0,,Em cảm ơn nhiều lắm ạ!
Dialogue: 0,0:11:06.65,0:11:09.02,Default,Marino,0,0,0,,Chị không thể để em tiếp tục ăn dầm nằm dề\Ntrong trường mãi thế này,
Dialogue: 0,0:11:09.50,0:11:12.49,Default,Marino,0,0,0,,nên em sẽ dọn sang ở căn hộ do\Ngia tộc Hanamura quản lý.
Dialogue: 0,0:11:13.20,0:11:16.07,Default,Marino,0,0,0,,Tiền thuê nhà và tiền trả nợ sẽ được\Nkhấu trừ trực tiếp vào tiền lương.
Dialogue: 0,0:11:16.79,0:11:18.61,Default,Marino,0,0,0,,Nếu không có biện pháp đột phá nào thì
Dialogue: 0,0:11:18.61,0:11:20.77,Default,Marino,0,0,0,,chắc phải mất khoảng mười năm\Nmới trả hết sạch nợ nần đấy.
Dialogue: 0,0:11:20.77,0:11:22.04,Default,Ruija,0,0,0,,Mười năm trời lận...
Dialogue: 0,0:11:22.31,0:11:24.12,Default,Kousuke,0,0,0,,Vâng, hợp lý mà chị.
Dialogue: 0,0:11:24.12,0:11:28.38,Default,Marino,0,0,0,,Ngoài ra, chị nhận định rằng\Ncô nàng này cần phải có người giám sát kèm cặp.
Dialogue: 0,0:11:28.64,0:11:30.75,Default,Kousuke,0,0,0,,Vâng, quá hợp lý luôn.
Dialogue: 0,0:11:31.63,0:11:33.35,Default,Kousuke(M),0,0,0,,{\i1}Sau từng ấy chuyện tày trời cô ấy gây ra,
Dialogue: 0,0:11:33.35,0:11:36.43,Default,Kousuke(M),0,0,0,,{\i1}mà không có người để mắt trông chừng\Nthì đúng là lo ngay ngáy thật.
Dialogue: 0,0:11:36.43,0:11:38.72,Default,Kousuke(M),0,0,0,,{\i1}Cốt yếu nhất vẫn là cái tính nhẹ dạ\Ndễ bị lừa của cô ấy.
Dialogue: 0,0:11:38.97,0:11:40.40,Default,Marino,0,0,0,,Thế nên Kou-chan à.
Dialogue: 0,0:11:40.40,0:11:42.10,Default,Marino,0,0,0,,Em phụ trách việc đó nhé.
Dialogue: 0,0:11:42.10,0:11:43.41,Default,Kousuke,0,0,0,,Vâng, quá hợp lý...
Dialogue: 0,0:11:43.41,0:11:44.46,Default,Kousuke,0,0,0,,Khoan, cái gì cơ ạ?!
Dialogue: 0,0:11:44.46,0:11:48.06,Default,Nanami,0,0,0,,Quyền sở hữu khu căn hộ đó vừa được\Nchuyển nhượng sang tên ngài rồi.
Dialogue: 0,0:11:48.06,0:11:49.90,Default,Nanami,0,0,0,,Tất nhiên là nguyên cả tòa chung cư luôn ạ.
Dialogue: 0,0:11:49.90,0:11:50.99,Default,Kousuke,0,0,0,,Ra vậy.
Dialogue: 0,0:11:50.99,0:11:52.52,Default,Kousuke,0,0,0,,Thế thì ổn quá rồi!
Dialogue: 0,0:11:52.52,0:11:54.11,Default,Kousuke,0,0,0,,Không, chẳng ổn tí nào hết trơn!
Dialogue: 0,0:11:54.11,0:11:55.70,Default,Marino,0,0,0,,Ổn hết mà.
Dialogue: 0,0:11:55.70,0:11:56.07,Default,Marino,0,0,0,,Đúng không nè?
Dialogue: 0,0:11:57.58,0:12:01.24,Default,Nanami,0,0,0,,Vậy phiền cô ký vào đây để giao toàn quyền\Nkiểm soát bản thân cho Chủ nhân nhé.
Dialogue: 0,0:11:58.41,0:12:01.24,cr_sign_1,SIGN,0,0,0,,{\an7\bord0\p1\c&HF8F7FA&\3c&HF8F7FA&\4c&HF8F7FA&\1a&H21&\pos(398,11)}m 0 0 l 225 0 225 280 0 280
Dialogue: 0,0:11:58.41,0:12:01.24,sign_19263_238_Labor_Contract__,SIGN,0,0,0,,{\pos(513,280)\c&H020202&}Hợp Đồng Lao Động\N\NHợp đồng lao động này được ký kết\Nvới các điều khoản sau.\NThời hạn: Vô thời hạn, suốt phần đời còn lại\NMô tả công việc: Tuyệt đối tuân theo\Nmọi mệnh lệnh của chủ sử dụng lao động\NĐịa điểm làm việc: Tất cả mọi nơi\Ntheo chỉ định của chủ sử dụng lao động\NGiờ làm việc: Sẵn sàng phục vụ 24/7\NThời gian nghỉ ngơi: Không có\NNgày nghỉ: Không có ngày nghỉ cố định\NThù lao: Tùy hứng, nếu chủ sử dụng lao động\Ncảm thấy vui vẻ\NXin nghỉ việc: Không chấp nhận đơn từ chức\NĐiều khoản phụ: Sự phục tùng tuyệt đối\Nlà ưu tiên hàng đầu. Cấm phản kháng dưới mọi hình thức.\NNgười lao động thề sẽ tuân thủ nghiêm ngặt\Ncác điều khoản này để làm nhân viên trung thành.\N\NTên chủ sử dụng: Takioto Kousuke
Dialogue: 0,0:12:01.24,0:12:02.60,Default,Ruija,0,0,0,,Vâng, ký ngay đây ạ!
Dialogue: 0,0:12:02.60,0:12:06.16,Default,Kousuke,0,0,0,,Em vừa mới dặn cô không được tùy tiện\Nký bừa hợp đồng lạ xong đấy!
Dialogue: 0,0:12:07.02,0:12:08.11,Default,Ruija,0,0,0,,Nhẹ cả người luôn.
Dialogue: 0,0:12:08.11,0:12:10.67,Default,Ruija,0,0,0,,Giờ thì cô ngủ ngon giấc được rồi.
Dialogue: 0,0:12:10.91,0:12:12.48,Default,Kousuke,0,0,0,,Thế thì tốt quá.
Dialogue: 0,0:12:12.48,0:12:14.95,Default,Kousuke,0,0,0,,Cô nhớ ráng chăm chỉ cày trả nợ đấy nhé.
Dialogue: 0,0:12:14.95,0:12:16.17,Default,Ruija,0,0,0,,Tất nhiên rồi!
Dialogue: 0,0:12:16.17,0:12:17.40,Default,Kousuke,0,0,0,,À phải rồi.
Dialogue: 0,0:12:17.40,0:12:20.01,Default,Kousuke,0,0,0,,Em có chuyện này muốn nhờ cô một chút.
Dialogue: 0,0:12:29.17,0:12:33.81,Default,Nanami,0,0,0,,Thưa Chủ nhân, sao ngài lại cất công\Nchui vào hầm ngục tân thủ làm gì thế?
Dialogue: 0,0:12:34.93,0:12:36.31,Default,Kousuke,0,0,0,,Chuyện là...
Dialogue: 0,0:12:36.31,0:12:38.53,Default,Kousuke,0,0,0,,Tôi định chạy thử tốc độ RTA (phá kỷ lục thời gian).
Dialogue: 0,0:12:38.53,0:12:41.68,Default,Nanami,0,0,0,,À, ngài nhắm tới phần thưởng đặc biệt sao?
Dialogue: 0,0:12:41.68,0:12:43.76,Default,Kousuke,0,0,0,,Biết ngay một Hầu Gái Hầm Ngục như cô sẽ hiểu ngay mà.
Dialogue: 0,0:12:43.74,0:12:46.62,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(324,308)}[Hầm Ngục Tân Thủ - Tầng 1]
Dialogue: 0,0:12:47.63,0:12:48.08,cr_sign_2,SIGN,0,0,0,,{\pos(353,116)}Dừng
Dialogue: 0,0:12:47.63,0:12:48.08,cr_sign_2,SIGN,0,0,0,,{\pos(364,164)}Vòng
Dialogue: 0,0:12:48.08,0:12:48.91,Default,Kousuke,0,0,0,,Xuất phát nào!
Dialogue: 0,0:12:48.91,0:12:49.64,Default,Nanami,0,0,0,,Rõ!
Dialogue: 0,0:12:51.34,0:12:55.02,Default,Kousuke(M),0,0,0,,{\i1}Khi chạy đua thời gian, việc đánh đấm\Nvới đám quái vặt chỉ tổ lãng phí thì giờ.
Dialogue: 0,0:12:55.02,0:12:56.50,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(321,310)\c&HD9D9DB&}[Tầng 5]
Dialogue: 0,0:12:56.10,0:13:00.17,Default,Kousuke(M),0,0,0,,{\i1\an8}Vì chẳng cần nhặt nhạnh điểm kinh nghiệm\Ndọc đường làm gì,
Dialogue: 0,0:13:00.17,0:13:03.26,Default,Kousuke(M),0,0,0,,{\i1\an8}nên bọn mình cứ phớt lờ sạch lũ quái\Nmà cắm đầu chạy thẳng xuống tầng tiếp theo.
Dialogue: 0,0:13:03.26,0:13:04.36,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(320,309)}[Tầng 6]
Dialogue: 0,0:13:09.00,0:13:10.41,Default,Nanami,0,0,0,,Xin thứ lỗi cho sự thất lễ này.
Dialogue: 0,0:13:10.41,0:13:11.69,Default,Kousuke,0,0,0,,Không sao đâu.
Dialogue: 0,0:13:11.69,0:13:13.14,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(320,309)}[Tầng 7]
Dialogue: 0,0:13:12.61,0:13:17.15,Default,Kousuke(M),0,0,0,,{\i1\an8}Trong game thì cứ chạy xộc thẳng qua hầm ngục\Nmà chẳng cần nghỉ lấy hơi,
Dialogue: 0,0:13:17.15,0:13:18.74,Default,Kousuke(M),0,0,0,,{\i1\an8}nhưng ngoài đời thực thì bất khả thi.
Dialogue: 0,0:13:18.74,0:13:20.04,Default,Kousuke(M),0,0,0,,{\i1\an8}Hơi thở đứt quãng dần,
Dialogue: 0,0:13:18.92,0:13:25.95,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(318,305)}[Tầng 8]
Dialogue: 0,0:13:20.04,0:13:21.51,Default,Kousuke(M),0,0,0,,{\i1\an8}hai chân nặng trịch như đeo chì,
Dialogue: 0,0:13:21.51,0:13:23.75,Default,Kousuke(M),0,0,0,,{\i1\an8}và vì mất tập trung nên rất dễ\Nbị tập kích bất ngờ nữa.
Dialogue: 0,0:13:23.75,0:13:25.95,Default,Kousuke(M),0,0,0,,{\i1\an8}lơ là chút là ăn phục kích ngay.
Dialogue: 0,0:13:26.79,0:13:29.12,Default,Kousuke(M),0,0,0,,{\i1\an8}Xem ra phải dừng nghỉ chút rồi.
Dialogue: 0,0:13:29.88,0:13:31.08,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(320,310)}[Tầng 9]
Dialogue: 0,0:13:31.36,0:13:33.15,Default,Kousuke,0,0,0,,Nanami, cô ổn không đấy?
Dialogue: 0,0:13:33.15,0:13:35.54,Default,Nanami,0,0,0,,Vâng. Liệu ta có kịp giờ không ạ?
Dialogue: 0,0:13:35.77,0:13:37.96,cr_sign_2,SIGN,0,0,0,,{\pos(354,199)}Dừng
Dialogue: 0,0:13:35.77,0:13:37.96,cr_sign_2,SIGN,0,0,0,,{\pos(377,239)}Vòng
Dialogue: 0,0:13:36.35,0:13:37.96,Default,Kousuke,0,0,0,,1 tiếng 25 phút.
Dialogue: 0,0:13:38.49,0:13:40.91,Default,Kousuke,0,0,0,,Ừ, xem ra vừa kịp lúc đấy.
Dialogue: 0,0:13:41.10,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(421,306)}Tầng 1 {bắt đầu từ đáy}
Dialogue: 0,0:13:41.40,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(227,277)}Tầng 2
Dialogue: 0,0:13:41.53,0:13:47.20,Default,Kousuke,0,0,0,,{\an8}Nếu chạm tới được tầng 10\Ntrong vòng 1 tiếng 40 phút,
Dialogue: 0,0:13:41.69,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(421,254)}Tầng 3
Dialogue: 0,0:13:41.98,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(224,228)}Tầng 4
Dialogue: 0,0:13:42.27,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(423,204)}Tầng 5
Dialogue: 0,0:13:42.56,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(224,176)}Tầng 6
Dialogue: 0,0:13:42.86,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(422,150)}Tầng 7
Dialogue: 0,0:13:43.15,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(225,126)}Tầng 8
Dialogue: 0,0:13:43.44,0:13:48.95,sign_23163_282_1st_Layer_,SIGN,0,0,0,,{\pos(423,99)}Tầng 9
Dialogue: 0,0:13:45.11,0:13:48.95,sign_23259_291_Within_1_40_00,SIGN,0,0,0,,{\c&H7FFFFE&\pos(115,128)}Trong 1:40:00
Dialogue: 0,0:13:47.20,0:13:48.51,Default,Kousuke,0,0,0,,{\an8}bạn có thể tiến vào tầng đặc biệt.
Dialogue: 0,0:13:48.95,0:13:52.14,sign_23351_292_Within_1_40_00,SIGN,0,0,0,,{\pos(328,322)}Trong 1:40:00
Dialogue: 0,0:13:49.09,0:13:52.14,Default,Kousuke,0,0,0,,{\an8}Và xem chừng bọn mình sắp kịp thật rồi.
Dialogue: 0,0:13:53.16,0:13:54.60,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\pos(326,309)}[Tầng 10 - Tầng Đặc Biệt]
Dialogue: 0,0:13:55.45,0:13:57.41,Default,Nanami,0,0,0,,Đây là... tầng mê cung sao ạ?
Dialogue: 0,0:13:57.86,0:13:59.46,Default,Kousuke,0,0,0,,Vừa chạy tôi vừa giải thích cho.
Dialogue: 0,0:13:59.46,0:14:00.39,Default,Kousuke,0,0,0,,Đi thôi!
Dialogue: 0,0:14:01.55,0:14:05.19,Default,Kousuke,0,0,0,,Có tám kiểu bản đồ ngẫu nhiên\Ncho tầng 10 đặc biệt này.
Dialogue: 0,0:14:05.61,0:14:07.41,Default,Kousuke,0,0,0,,Mỗi bản đồ đều có các ngã rẽ riêng,
Dialogue: 0,0:14:07.41,0:14:11.04,Default,Kousuke,0,0,0,,và vài kiểu còn gài sẵn vòng lặp vô tận\Ncực kỳ ác ôn nữa.
Dialogue: 0,0:14:11.57,0:14:13.57,Default,Kousuke,0,0,0,,Cô giúp tôi ghi nhớ toàn bộ ngã rẽ đi qua nhé?
Dialogue: 0,0:14:13.57,0:14:14.46,Default,Nanami,0,0,0,,Cứ giao cho tôi lo!
Dialogue: 0,0:14:18.56,0:14:19.88,Default,Nanami,0,0,0,,Đầu tiên là một ngã ba chữ T,
Dialogue: 0,0:14:19.88,0:14:21.61,Default,Nanami,0,0,0,,rẽ hướng đông gặp một ngã tư.
Dialogue: 0,0:14:21.61,0:14:25.59,Default,Nanami,0,0,0,,Sau đó đi hướng bắc lại đụng thêm\Nmột ngã tư nữa.
Dialogue: 0,0:14:25.59,0:14:26.30,Default,Kousuke,0,0,0,,Hiểu rồi!
Dialogue: 0,0:14:26.67,0:14:29.57,Default,Kousuke(M),0,0,0,,{\i1}Chốt kèo, đây là sơ đồ D.
Dialogue: 0,0:14:29.57,0:14:35.60,Default,Kousuke(M),0,0,0,,{\i1}Từ điểm này thì chỉ cần đi đông,\Nnam, tây, nam, nam, đông, bắc là tới!
Dialogue: 0,0:14:38.50,0:14:40.27,Default,Kousuke,0,0,0,,Chuẩn cơm mẹ nấu.
Dialogue: 0,0:14:40.76,0:14:41.81,Default,Kousuke,0,0,0,,Mấy giờ rồi?
Dialogue: 0,0:14:41.81,0:14:43.81,Default,Nanami,0,0,0,,1 tiếng 56 phút ạ.
Dialogue: 0,0:14:44.15,0:14:45.57,Default,Kousuke(M),0,0,0,,{\i1}Điều kiện để nhận phần thưởng
Dialogue: 0,0:14:45.57,0:14:50.66,Default,Kousuke(M),0,0,0,,{\i1}là dọn sạch toàn bộ từ tầng 1\Ntới trùm cuối trong vòng 2 tiếng.
Dialogue: 0,0:14:53.12,0:14:55.08,Default,Kousuke,0,0,0,,Còn vỏn vẹn 4 phút...
Dialogue: 0,0:14:55.62,0:14:57.58,sign_21788_254__Beginner_Dungeo,SIGN,0,0,0,,{\c&HFFFFFF&\pos(322,306)}[Tầng 11 - Phòng Trùm]
Dialogue: 0,0:14:57.58,0:14:59.16,Default,Nanami,0,0,0,,Để tôi xử lý—
Dialogue: 0,0:14:59.16,0:15:03.01,Default,Kousuke,0,0,0,,Không cần, có mẹo hạ gục con này\Nnhanh gọn lẹ lắm.
Dialogue: 0,0:15:11.13,0:15:12.12,Default,Nanami,0,0,0,,Thưa Chủ nhân!
Dialogue: 0,0:15:12.12,0:15:13.09,Default,Kousuke,0,0,0,,Lùi ra!
Dialogue: 0,0:15:22.82,0:15:24.00,Default,Kousuke,0,0,0,,Ngon lành!
Dialogue: 0,0:15:24.00,0:15:26.00,Default,Kousuke,0,0,0,,Chưa tốn tới một phút luôn.
Dialogue: 0,0:15:31.09,0:15:35.87,Default,GoddessStatue,0,0,0,,Ngươi đã xuất sắc đánh bại tà ma\Nvà đứng trước mặt ta tại đây.
Dialogue: 0,0:15:36.71,0:15:40.29,Default,GoddessStatue,0,0,0,,Ghi nhận chiến công này,\Nta xin ban tặng cho ngươi một kỹ năng.
Dialogue: 0,0:15:43.38,0:15:46.69,Default,Nanami,0,0,0,,Có vẻ ngươi vừa nhận được phép\NTăng Cường Thể Lực rồi.
Dialogue: 0,0:15:46.69,0:15:47.47,Default,Kousuke,0,0,0,,Chuẩn luôn.
Dialogue: 0,0:15:48.77,0:15:50.53,Default,Kousuke(M),0,0,0,,{\i1}Có tổng cộng năm loại kỹ năng phần thưởng.
Dialogue: 0,0:15:50.53,0:15:52.59,Default,Kousuke(M),0,0,0,,{\i1}Mỗi lần vượt ải sẽ nhận ngẫu nhiên một loại.
Dialogue: 0,0:15:53.02,0:15:55.07,Default,Kousuke(M),0,0,0,,{\i1}Nếu muốn xây dựng nhân vật mạnh nhất,
Dialogue: 0,0:15:55.07,0:15:57.31,Default,Kousuke(M),0,0,0,,{\i1}thì tuyệt đối không thể bỏ qua mấy món này được.
Dialogue: 0,0:15:58.08,0:16:00.81,Default,Kousuke(M),0,0,0,,{\i1}Xem ra sắp tới mình còn phải quay lại đây\Ncày dài dài rồi.
Dialogue: 0,0:16:02.04,0:16:06.56,Default,Kousuke,0,0,0,,Phải kiểm tra xem giờ mình chạy bền\Nđược xa hơn tới mức nào mới được!
Dialogue: 0,0:16:06.56,0:16:08.64,Default,Kousuke,0,0,0,,Tôi cũng chẳng ngại chạy vào hầm ngục lần nữa đâu,
Dialogue: 0,0:16:08.64,0:16:10.45,Default,Kousuke,0,0,0,,cơ mà giờ tan trường hết giờ mở cửa rồi...
Dialogue: 0,0:16:10.45,0:16:12.39,Default,Nanami,0,0,0,,Tôi có sáng kiến này hay lắm.
Dialogue: 0,0:16:15.08,0:16:18.04,sign_26855_337_Treadmill,SIGN,0,0,0,,{\c&HFDCC6B&\fs24\b1\pos(312,287)}Máy Chạy Bộ
Dialogue: 0,0:16:15.64,0:16:18.04,Default,Nanami,0,0,0,,{\an8}Máy chạy bộ!
Dialogue: 0,0:16:18.97,0:16:22.10,Default,Nanami,0,0,0,,Mưa to, bão lớn,\Ntuyết rơi ngập trời, hay Nanami khổng lồ,
Dialogue: 0,0:16:22.10,0:16:23.37,Default,Nanami,0,0,0,,bất chấp mọi điều kiện thời tiết khắc nghiệt,
Dialogue: 0,0:16:23.37,0:16:26.17,Default,Nanami,0,0,0,,từ giờ Chủ nhân thích chạy bộ lúc nào\Ncũng đều được hết ạ.
Dialogue: 0,0:16:26.17,0:16:28.72,Default,Kousuke,0,0,0,,Khoan, "Nanami khổng lồ" là cái quái gì vậy?
Dialogue: 0,0:16:28.72,0:16:32.24,Default,Nanami,0,0,0,,À thì cái thứ mà bảy ngày một tuần\Nlúc nào cũng ập tới ấy ạ.
Dialogue: 0,0:16:32.24,0:16:35.09,Default,Kousuke,0,0,0,,Tôi chẳng hiểu cô đang lảm nhảm cái gì nữa.
Dialogue: 0,0:16:35.09,0:16:37.39,Default,Yukine,0,0,0,,Cơ mà cái máy này nhìn tân tiến phết nhỉ.
Dialogue: 0,0:16:37.39,0:16:39.62,Default,Claris,0,0,0,,Kiểu dáng nom cũng kỳ lạ thật.
Dialogue: 0,0:16:39.62,0:16:43.35,Default,Nanami,0,0,0,,Hôm nọ tôi tình cờ ghé một tiệm đồ cổ\Nkhá khả nghi.
Dialogue: 0,0:16:43.65,0:16:46.33,Default,Nanami,0,0,0,,Tôi mua sỉ một đống đồ thanh lý giá rẻ,
Dialogue: 0,0:16:46.33,0:16:49.53,Default,Nanami,0,0,0,,tự giải mã đống linh kiện bí ẩn đó\Ntheo lý thuyết của riêng mình,
Dialogue: 0,0:16:49.53,0:16:51.03,Default,Nanami,0,0,0,,rồi lắp ráp thành cỗ máy này đấy ạ.
Dialogue: 0,0:16:51.83,0:16:55.70,Default,Kousuke,0,0,0,,Vừa mới nghe qua toàn mấy từ khóa\Nkhiến mình bất an tột độ luôn.
Dialogue: 0,0:16:56.43,0:16:58.84,Default,Nanami,0,0,0,,Sao ngài không lên chạy thử một vòng xem?
Dialogue: 0,0:16:58.84,0:17:00.96,Default,Nanami,0,0,0,,Dễ sử dụng cực kỳ luôn đấy.
Dialogue: 0,0:17:01.44,0:17:06.16,Default,Kousuke,0,0,0,,Dự cảm chẳng lành vượt ngưỡng báo động rồi,\Nnhưng kệ, thử luôn.
Dialogue: 0,0:17:06.16,0:17:08.34,Default,Ludie,0,0,0,,Vượt ngưỡng báo động mà cậu vẫn leo lên à...
Dialogue: 0,0:17:10.30,0:17:11.76,Default,Kousuke,0,0,0,,Đặt chế độ ở đây hả?
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_357_Select_User,SIGN,0,0,0,,{\frz8.191\pos(255,34)}Chọn Người Dùng
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\frz7.354\pos(349,40)}Takioto Kousuke
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\frz7.627\pos(405,76)}Giới tính: Nam
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(324,117)}Chiều cao
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(333,142)}Cân nặng
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(206,252)}Hủy
Dialogue: 0,0:17:11.76,0:17:12.43,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(452,204)}Tiếp tục
Dialogue: 0,0:17:12.43,0:17:16.05,Default,Nanami,0,0,0,,{\an8}Tôi đã hoàn tất đăng ký\Nhồ sơ người dùng cho ngài rồi.
Dialogue: 0,0:17:16.05,0:17:19.36,Default,Nanami,0,0,0,,Tên tuổi, giới tính, chỉ số cơ thể, đủ cả.
Dialogue: 0,0:17:16.05,0:17:19.32,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\frz9.395\fs14\move(504,92,501,58,24,3236)}Takioto Kousuke
Dialogue: 0,0:17:16.05,0:17:19.32,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\frz9.395\fs14\move(568,175,564,142,24,3236)}Giới tính:\NNam
Dialogue: 0,0:17:19.36,0:17:20.07,Default,Kousuke,0,0,0,,Hửm?
Dialogue: 0,0:17:20.45,0:17:24.81,Default,Kousuke,0,0,0,,Làm sao cô nắm rõ số đo cơ thể tôi\Ntới từng con số thập phân thế này?!
Dialogue: 0,0:17:25.04,0:17:29.94,Default,Nanami,0,0,0,,Máy còn đo được cả tỷ lệ mỡ cơ thể\Nvà lượng calo tiêu thụ nữa đấy.
Dialogue: 0,0:17:30.38,0:17:33.06,Default,Nanami,0,0,0,,Dữ liệu này có thể đồng bộ thẳng sang\NTsukuyomi Traveler của mọi người.
Dialogue: 0,0:17:33.06,0:17:36.49,Default,Yukine,0,0,0,,Tiện lợi thật đấy.\NTôi cũng muốn dùng thử xem sao.
Dialogue: 0,0:17:36.49,0:17:38.20,Default,Claris,0,0,0,,Tôi cũng rất hứng thú muốn thử ạ!
Dialogue: 0,0:17:38.79,0:17:40.49,Default,Nanami,0,0,0,,Xin mọi người cứ yên tâm.
Dialogue: 0,0:17:40.49,0:17:44.83,Default,Nanami,0,0,0,,Tôi đã đăng ký sẵn hồ sơ người dùng\Ncho tất cả mọi người có mặt ở đây rồi.
Dialogue: 0,0:17:45.37,0:17:47.73,Default,Nanami,0,0,0,,Tuy nhiên, ngoại trừ Chủ nhân ra
Dialogue: 0,0:17:47.73,0:17:52.06,Default,Nanami,0,0,0,,thì mọi người cần phải chọn cô hầu gái chính\Nhoặc anh quản gia chính đồng hành trước.
Dialogue: 0,0:17:52.06,0:17:55.03,Default,Kousuke,0,0,0,,"Hầu gái chính" nghĩa là cái quái gì?
Dialogue: 0,0:17:55.03,0:17:56.59,Default,Nanami,0,0,0,,Là giọng nói cổ vũ hỗ trợ trong lúc chạy ạ.
Dialogue: 0,0:17:57.08,0:17:58.23,Default,Nanami,0,0,0,,Chỉ cần bấm như thế này...
Dialogue: 0,0:17:58.36,0:18:02.35,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\frz6.232\pos(255,32)}Chọn Chế Độ
Dialogue: 0,0:17:58.81,0:18:00.41,Default,NanamiVoice,0,0,0,,{\i1}Vui lòng thao tác trên màn hình cảm ứng.
Dialogue: 0,0:18:00.41,0:18:02.35,Default,NanamiVoice,0,0,0,,{\i1}Hoặc ra lệnh bằng giọng nói.
Dialogue: 0,0:18:02.35,0:18:04.52,Default,Kousuke,0,0,0,,Ồ, đó là giọng của cô thu sẵn đấy à?!
Dialogue: 0,0:18:04.52,0:18:07.31,Default,Nanami,0,0,0,,Đương nhiên tôi là hầu gái chính của ngài rồi.
Dialogue: 0,0:18:07.63,0:18:11.85,Default,Nanami,0,0,0,,Còn về phần quản gia chính, tôi đã mạn phép\Nlấy giọng của Chủ nhân làm mẫu ạ.
Dialogue: 0,0:18:11.85,0:18:14.34,Default,Ludie,0,0,0,,Nghe vui quá đi!
Dialogue: 0,0:18:14.34,0:18:17.28,Default,Yukine,0,0,0,,Ừ, nghe đúng là một tính năng\Nrất tiện dụng.
Dialogue: 0,0:18:17.69,0:18:19.78,Default,Nanami,0,0,0,,Vậy thì cùng thiết lập quãng đường mục tiêu nào.
Dialogue: 0,0:18:19.78,0:18:25.29,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\c&H4A001C&\frz16.16\fs14\move(431,142,346,185,25,5489)}Mục tiêu
Dialogue: 0,0:18:20.09,0:18:24.16,Default,Nanami,0,0,0,,Mức mặc định được cài đặt là 42,195 km.
Dialogue: 0,0:18:24.16,0:18:25.29,Default,Ludie,0,0,0,,Xa quá trời quá đất rồi!
Dialogue: 0,0:18:25.29,0:18:27.48,Default,Yukine,0,0,0,,Cự ly đó cũng bình thường mà.
Dialogue: 0,0:18:27.48,0:18:29.69,Default,Yukine,0,0,0,,Cô Claris thấy có đúng không?
Dialogue: 0,0:18:30.50,0:18:34.03,Default,Claris,0,0,0,,Tôi nghĩ mức này chỉ dành cho cậu Takioto\Nvà cô đây thôi.
Dialogue: 0,0:18:34.03,0:18:35.83,Default,Hatsumi,0,0,0,,Tôi chịu thua.
Dialogue: 0,0:18:41.31,0:18:42.83,Default,Kousuke,0,0,0,,Cơ mà mấy cái nút này có tác dụng gì thế?
Dialogue: 0,0:18:43.30,0:18:47.63,Default,Nanami,0,0,0,,Tôi vẫn chưa nắm hết toàn bộ chức năng\Ncủa chúng đâu,
Dialogue: 0,0:18:47.63,0:18:49.15,Default,Nanami,0,0,0,,nên xin vui lòng đừng bấm bừa nhé.
Dialogue: 0,0:18:49.55,0:18:51.88,Default,Kousuke,0,0,0,,Ý cô là sao khi bảo chưa nắm hết hả?
Dialogue: 0,0:18:51.88,0:18:54.36,Default,Nanami,0,0,0,,Ý tôi là dù sao đây cũng là đồ cũ\Nnhặt từ hầm ngục về mà...
Dialogue: 0,0:18:54.36,0:18:55.74,Default,Hatsumi,0,0,0,,Tò mò quá đi.
Dialogue: 0,0:18:55.74,0:18:56.24,Default,Kousuke,0,0,0,,Hả?!
Dialogue: 0,0:18:57.20,0:19:00.45,Default,Kousuke,0,0,0,,Tôi không dừng lại được!
Dialogue: 0,0:19:05.75,0:19:07.96,Default,Kousuke,0,0,0,,Cái quái gì thế này?!
Dialogue: 0,0:19:07.96,0:19:09.45,Default,Nanami,0,0,0,,Đây chắc hẳn là chức năng Thần Phong rồi.
Dialogue: 0,0:19:09.45,0:19:12.06,Default,Nanami,0,0,0,,Sức gió thổi ra sẽ tỷ lệ thuận\Nvới tốc độ chạy của ngài.
Dialogue: 0,0:19:12.06,0:19:14.17,Default,Nanami,0,0,0,,Có vẻ nó chia làm ba cấp độ:
Dialogue: 0,0:19:14.17,0:19:16.47,Default,Nanami,0,0,0,,Xâm Phạm Không Gian, Đánh Mất Phẩm Giá,\Nvà Cực Lạc Tịnh Độ (Sukhavati).
Dialogue: 0,0:19:16.47,0:19:18.88,Default,Kousuke(M),0,0,0,,{\i1}Cái quái này rành rành là tính năng thổi tốc váy\Nnhìn trộm quần lót chứ còn gì nữa!
Dialogue: 0,0:19:18.93,0:19:20.26,Default,Kousuke,0,0,0,,Khoan đã! Không xong rồi!
Dialogue: 0,0:19:20.26,0:19:21.00,Default,Kousuke,0,0,0,,Chịu hết nổi!
Dialogue: 0,0:19:21.00,0:19:23.18,Default,Kousuke,0,0,0,,Tôi không nhảy xuống được, tắt ngay đi!
Dialogue: 0,0:19:23.41,0:19:25.93,Default,Claris,0,0,0,,Tiểu thư Hatsumi! Bấm nút dừng mau lên!
Dialogue: 0,0:19:26.53,0:19:26.93,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\3c&H7649F5&\c&HFFFFFF&\b1\frz10.45\pos(200,187)}Tạm dừng
Dialogue: 0,0:19:26.53,0:19:26.93,sign_10776_104_Encounter_Cafe,SIGN,0,0,0,,{\c&HFFFFFF&\3c&HED6437&\b1\frz11.07\pos(362,157)}Tiếp tục
Dialogue: 0,0:19:32.19,0:19:34.15,Default,Nanami,0,0,0,,Mọi người sao thế ạ?
Dialogue: 0,0:19:34.15,0:19:37.05,Default,Ludie,0,0,0,,C-Cái máy này đúng là... đồ ngốc!
Dialogue: 0,0:19:37.05,0:19:38.81,Default,Yukine,0,0,0,,Thật vô liêm sỉ hết chỗ nói!
Dialogue: 0,0:19:38.81,0:19:41.23,Default,Nanami,0,0,0,,Thì đã bảo đây là đồ cũ nhặt từ hầm ngục về mà.
Dialogue: 0,0:19:41.23,0:19:44.87,Default,Nanami,0,0,0,,Nhưng tôi hiểu nỗi bận tâm của mọi người.
Dialogue: 0,0:19:45.21,0:19:46.91,Default,Nanami,0,0,0,,Chỉ cần nhấn chiếc nút ngay đây thôi...
Dialogue: 0,0:19:47.78,0:19:49.80,Default,Kousuke,0,0,0,,Ồ, mùi thơm dễ chịu ghê.
Dialogue: 0,0:19:49.80,0:19:52.29,Default,Nanami,0,0,0,,Tôi đã tích hợp thêm chức năng tỏa hương đặc biệt đấy.
Dialogue: 0,0:19:52.70,0:19:55.23,Default,Kousuke,0,0,0,,Công nhận ngửi thấy thư giãn hẳn ra thật.
Dialogue: 0,0:19:55.23,0:19:56.80,Default,Nanami,0,0,0,,Đây là hỗn hợp chiết xuất từ tinh chất Nanami đấy.
Dialogue: 0,0:19:56.80,0:19:58.83,Default,Kousuke,0,0,0,,Cái quái gì gọi là tinh chất Nanami hả?!
Dialogue: 0,0:19:58.83,0:20:00.21,Default,Kousuke,0,0,0,,Cô có họ hàng gì với loài nghêu sò hay sao vậy?!
Dialogue: 0,0:20:00.21,0:20:02.66,Default,Nanami,0,0,0,,Thật không thể tin nổi... Chủ nhân lại ép tôi\Nphải thốt ra câu đó.
Dialogue: 0,0:20:02.66,0:20:04.39,Default,Kousuke,0,0,0,,Tự nhiên sao cô lại đỏ mặt xấu hổ thế hả?
Dialogue: 0,0:20:04.39,0:20:12.02,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(44,72)}Gió\NLạnh
Dialogue: 0,0:20:04.39,0:20:12.02,sign_28214_358_Takioto_Kousuke,SIGN,0,0,0,,{\pos(189,45)}Gió\NẤm
Dialogue: 0,0:20:04.79,0:20:08.44,Default,Nanami,0,0,0,,Hơn thế nữa, ngài còn tùy chọn thổi\Ngió lạnh hoặc gió ấm được nữa.
Dialogue: 0,0:20:08.44,0:20:09.36,Default,Hatsumi,0,0,0,,Bấm cái nào.
Dialogue: 0,0:20:10.82,0:20:13.06,Default,Kousuke,0,0,0,,Ồ, ấm áp hơn một chút rồi đấy.
Dialogue: 0,0:20:13.37,0:20:16.17,Default,Ludie,0,0,0,,Sai trái hết sức luôn ấy!
Dialogue: 0,0:20:16.17,0:20:21.02,Default,Ludie,0,0,0,,Tại sao đang chạy nóng nực muốn chết\Nmà lại còn phải hứng gió nóng thổi vào người chứ?!
Dialogue: 0,0:20:21.02,0:20:22.92,Default,Claris,0,0,0,,Tiểu thư Ludie, xin người hãy bình tĩnh!
Dialogue: 0,0:20:22.92,0:20:25.15,Default,Kousuke,0,0,0,,Ơ khoan? Sao nhiệt độ cứ tăng\Nvùn vụt thế này...
Dialogue: 0,0:20:25.62,0:20:28.77,Default,Kousuke,0,0,0,,Nóng! Nóng! Nóng bỏng da rồi đấy?!
Dialogue: 0,0:20:28.77,0:20:30.35,Default,Kousuke,0,0,0,,Cháy rụi tới nơi rồi!
Dialogue: 0,0:20:30.35,0:20:31.83,Default,Yukine,0,0,0,,Em có sao không, Takioto?!
Dialogue: 0,0:20:31.83,0:20:33.15,Default,Yukine,0,0,0,,Nút gió lạnh đâu rồi!
Dialogue: 0,0:20:33.15,0:20:35.17,Default,Hatsumi,0,0,0,,Chị nhìn không ra.
Dialogue: 0,0:20:35.17,0:20:37.20,Default,Kousuke,0,0,0,,Ai đó làm ơn xử lý lẹ giùm đi!
Dialogue: 0,0:20:37.20,0:20:38.05,Default,NanamiVoice,0,0,0,,Đã tiếp nhận lệnh.
Dialogue: 0,0:20:42.17,0:20:46.64,Default,Nanami,0,0,0,,Chủ nhân vẫn bình an vô sự vì đã được yểm sẵn\Nbùa chú bảo hộ trên đầu rồi.
Dialogue: 0,0:20:46.88,0:20:50.64,Default,Nanami,0,0,0,,Tôi cũng từng thử qua chế độ này rồi,\Ncảm giác sảng khoái kích thích lắm.
Dialogue: 0,0:20:50.64,0:20:52.98,Default,Ludie,0,0,0,,Kousuke!
Dialogue: 0,0:20:54.68,0:20:57.42,Default,Kousuke,0,0,0,,Hóa ra cái lỗ thủng kia... là tác phẩm của cô à.
Dialogue: 0,0:20:59.67,0:21:02.57,Default,Yukine,0,0,0,,Em thật sự không sao chứ, Takioto?
Dialogue: 0,0:21:03.32,0:21:04.46,Default,Kousuke,0,0,0,,Em ổn rồi ạ.
Dialogue: 0,0:21:04.46,0:21:05.57,Default,Kousuke,0,0,0,,Và sau vụ việc này, mọi người đã thống nhất rằng
Dialogue: 0,0:21:05.57,0:21:09.16,Default,Kousuke,0,0,0,,Nanami sẽ phải sửa lại cỗ máy kia\Ndưới sự giám sát chặt chẽ của chị Claris.
Dialogue: 0,0:21:09.71,0:21:13.24,Default,Yukine,0,0,0,,Phải đấy, tụi mình cũng nên cảm ơn\Ncô Claris vì chuyện đó nữa.
Dialogue: 0,0:21:13.24,0:21:14.23,Default,Yukine,0,0,0,,Cơ mà này...
Dialogue: 0,0:21:14.23,0:21:16.95,Default,Yukine,0,0,0,,Tại sao em lại cố gắng liều mạng tới mức này?
Dialogue: 0,0:21:17.32,0:21:19.63,Default,Yukine,0,0,0,,Chẳng phải em đang ép bản thân quá sức rồi sao?
Dialogue: 0,0:21:19.63,0:21:21.88,Default,Yukine,0,0,0,,Nghỉ ngơi đúng lúc cũng rất quan trọng đấy.
Dialogue: 0,0:21:22.15,0:21:23.18,Default,Kousuke,0,0,0,,Chị cũng nói thế được luôn à.
Dialogue: 0,0:21:23.18,0:21:25.92,Default,Kousuke,0,0,0,,Chị còn tập luyện điên cuồng hơn cả em nữa mà.
Dialogue: 0,0:21:25.92,0:21:26.95,Default,Kousuke,0,0,0,,Với lại...
Dialogue: 0,0:21:26.95,0:21:29.00,Default,Kousuke,0,0,0,,Nếu muốn trở thành kẻ mạnh nhất,
Dialogue: 0,0:21:29.00,0:21:31.10,Default,Kousuke,0,0,0,,thì ngay từ bây giờ em phải làm mọi thứ thật nghiêm túc.
Dialogue: 0,0:21:32.07,0:21:33.81,Default,Kousuke(M),0,0,0,,{\i1}Thì, lý do thực sự của mình
Dialogue: 0,0:21:34.32,0:21:37.68,Default,Kousuke(M),0,0,0,,{\i1}là muốn dẫn dắt tất cả các nữ chính\Ntới cái kết viên mãn nhất
Dialogue: 0,0:21:37.68,0:21:39.41,Default,Kousuke(M),0,0,0,,{\i1}đâu thể nào tùy tiện nói toẹt ra được.
Dialogue: 0,0:21:39.85,0:21:41.11,Default,Yukine,0,0,0,,Kẻ mạnh nhất sao...
Dialogue: 0,0:21:41.42,0:21:44.44,Default,Kousuke,0,0,0,,Chị không muốn trở nên mạnh mẽ hơn sao?
Dialogue: 0,0:21:44.76,0:21:45.95,Default,Yukine,0,0,0,,Có chứ.
Dialogue: 0,0:21:46.28,0:21:48.16,Default,Kousuke,0,0,0,,Vậy thì hai chị em mình cùng nhau mạnh lên nhé!
Dialogue: 0,0:21:49.70,0:21:50.62,Default,Yukine,0,0,0,,Ừ, nhất trí!
Dialogue: 0,0:21:50.62,0:21:54.53,Default,Kousuke,0,0,0,,À đúng rồi, hôm nào chị em mình\Ncùng đi chinh phục hầm ngục không?
Dialogue: 0,0:21:54.53,0:21:55.81,Default,Yukine,0,0,0,,Đi hầm ngục á?
Dialogue: 0,0:21:56.25,0:21:58.74,Default,Kousuke,0,0,0,,Chuyện đó... có bất tiện gì sao ạ?
Dialogue: 0,0:21:58.74,0:22:02.22,Default,Yukine,0,0,0,,Không đâu. Nếu không vướng bận lịch trực,\Nchị cũng sẵn lòng đi cùng em.
Dialogue: 0,0:22:05.93,0:22:07.41,Default,Kousuke,0,0,0,,Hứa rồi đấy nhé!

