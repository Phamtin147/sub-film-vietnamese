Dialogue: 0,0:00:00.84,0:00:03.58,main,Kousuke,0,0,0,,Ma thạch thì mình mua rồi này...
Dialogue: 0,0:00:03.58,0:00:05.35,main,Kousuke,0,0,0,,Thuốc hồi phục cũng đã có đủ.
Dialogue: 0,0:00:05.35,0:00:07.39,main,Kousuke,0,0,0,,Còn quên thứ gì nữa không nhỉ?
Dialogue: 0,0:00:07.39,0:00:11.25,main,Nanami,0,0,0,,Thưa Chủ nhân, ngài đã quên mất phần thưởng ngọt ngào\Ncho những nỗ lực cố gắng của chúng ta rồi.
Dialogue: 0,0:00:11.25,0:00:13.19,main,Kousuke,0,0,0,,Thế thì tôi sẽ lấy bánh kem matcha và...
Dialogue: 0,0:00:13.19,0:00:15.63,main,Kousuke,0,0,0,,Khoan đã nào, chúng ta đâu phải mấy cô nhân viên văn phòng\Nđang nghỉ trưa đâu chứ.
Dialogue: 0,0:00:16.21,0:00:19.22,main,Kousuke,0,0,0,,À phải rồi, tôi vẫn chưa trả lương cho cô nhỉ.
Dialogue: 0,0:00:19.22,0:00:20.18,main,Nanani,0,0,0,,Dạ sao cơ?
Dialogue: 0,0:00:20.43,0:00:22.28,main,Kousuke,0,0,0,,Sao cô lại ngạc nhiên thế?
Dialogue: 0,0:00:22.28,0:00:25.18,main,Nanami,0,0,0,,À, tôi chỉ không nghĩ là mình sẽ được nhận lương thôi.
Dialogue: 0,0:00:25.89,0:00:28.64,main - italics,Kousuke(M),0,0,0,,Mà cũng đúng thật, trong game MagiEx\Nchưa từng có phân cảnh nào
Dialogue: 0,0:00:28.64,0:00:31.27,main - italics,Kousuke(M),0,0,0,,Nanami được trả lương cả.
Dialogue: 0,0:00:32.29,0:00:36.04,main,Kousuke,0,0,0,,Nhưng nếu tôi trả lương cho cô, cô sẽ không cần\Nphải làm việc ở cửa hàng này nữa đúng chứ?
Dialogue: 0,0:00:36.04,0:00:40.74,main,Nanami,0,0,0,,Đúng là vậy, nhưng bằng việc làm việc ở cửa hàng này,\Ntôi có thể đường đường chính chính ở bên cạnh ngài một cách hợp pháp.
Dialogue: 0,0:00:40.74,0:00:43.60,main,Nanami,0,0,0,,Chưa kể, thiên sứ thì đâu có cần đến tiền bạc.
Dialogue: 0,0:00:43.60,0:00:46.70,main,Kousuke,0,0,0,,Không không không, cứ cầm lấy mà chi tiêu vào những ngày nghỉ đi.
Dialogue: 0,0:00:46.96,0:00:48.43,main,Nanami,0,0,0,,Tôi cũng có ngày nghỉ nữa sao?
Dialogue: 0,0:00:48.43,0:00:50.83,main,Kousuke,0,0,0,,Cô lại nghĩ là mình không có chắc?
Dialogue: 0,0:00:51.37,0:00:55.29,main - italics,Kousuke(M),0,0,0,,Về cơ bản kiếp trước mình đi làm hùng hục\Ncũng chỉ để chơi game eroge vào ngày nghỉ thôi mà!
Dialogue: 0,0:00:55.67,0:00:58.63,main,Kousuke,0,0,0,,Thế rốt cuộc cô đang sống vì mục đích gì vậy hả?
Dialogue: 0,0:00:58.63,0:01:01.25,main,Nanami,0,0,0,,Ngày nghỉ là không cần thiết, miễn là tôi được nạp năng lượng,
Dialogue: 0,0:01:01.25,0:01:04.18,main,Nanami,0,0,0,,dù là từ ma lực của ngài hay từ những bữa ăn.
Dialogue: 0,0:01:04.59,0:01:08.08,main,Kousuke,0,0,0,,Dù sao thì, chuyện chế độ làm việc của cô\Ntôi sẽ suy nghĩ kỹ càng lại sau.
Dialogue: 0,0:01:08.08,0:01:09.02,main,Benito,0,0,0,,Chà chà, trời đất ơi.
Dialogue: 0,0:01:09.02,0:01:10.89,main,Benito,0,0,0,,Lại có thêm một thứ chướng tai gai mắt ở đây rồi.
Dialogue: 0,0:01:11.14,0:01:13.57,main,Benito,0,0,0,,Mày không thể tự biết điều mà thôi học đi cho rảnh nợ à?
Dialogue: 0,0:01:16.24,0:01:17.68,main,Kousuke,0,0,0,,Bọn tôi có làm gì sai sao?
Dialogue: 0,0:01:17.68,0:01:20.44,main,Benito,0,0,0,,Làm gì sai ư? Đương nhiên là có rồi.
Dialogue: 0,0:01:20.44,0:01:22.32,main,Benito,0,0,0,,Tao đến đây để xác minh các báo cáo...
Dialogue: 0,0:01:22.32,0:01:25.16,main,Benito,0,0,0,,Nhưng nói tao nghe xem nào, mày đến đây\Nđể tán tỉnh ve vãn cô hầu gái của mình đấy à?
Dialogue: 0,0:01:25.16,0:01:28.20,main,Benito,0,0,0,,Nếu chỉ muốn làm mấy trò đó thì sao không về nhà mà làm?
Dialogue: 0,0:01:28.63,0:01:32.86,main,Benito,0,0,0,,Vì mày có đủ tiền thuê một cô hầu gái,\Nchắc mày cũng có chút của nả đấy nhỉ?
Dialogue: 0,0:01:40.59,0:01:41.62,main,Nanami,0,0,0,,Chủ nhân...
Dialogue: 0,0:01:41.62,0:01:44.13,main,Kousuke,0,0,0,,Không sao đâu. Cứ đứng sau lưng tôi.
Dialogue: 0,0:01:45.90,0:01:49.35,main,Benito,0,0,0,,Tao nghĩ mày đã nhầm lẫn nơi này thành một sân chơi rồi đấy.
Dialogue: 0,0:01:49.35,0:01:51.98,main,Benito,0,0,0,,Tao nghĩ mày nên dành thời gian mà luyện tập cái gì đó đi,
Dialogue: 0,0:01:52.28,0:01:54.52,main,Benito,0,0,0,,thay vì cứ lượn lờ lêu lổng ở đây.
Dialogue: 0,0:01:54.88,0:01:57.11,main,Benito,0,0,0,,Sự yếu kém về tài năng của mày\Nchắc chắn đòi hỏi điều đó đấy!
Dialogue: 0,0:02:01.97,0:02:04.31,main,Kousuke,0,0,0,,Ôi trời, thế mà bấy lâu nay tôi cứ tưởng một người đứng đầu Tam Đại Ủy Ban
Dialogue: 0,0:02:04.31,0:02:06.32,main,Kousuke,0,0,0,,phải có con mắt nhìn người tinh tường lắm chứ.
Dialogue: 0,0:02:07.10,0:02:09.49,main,Kousuke,0,0,0,,Này, Benito Evangelista.
Dialogue: 0,0:02:09.49,0:02:12.00,main,Kousuke,0,0,0,,Cậu có mắt như mù vậy à?
Dialogue: 0,0:02:12.00,0:02:12.79,main,Benito,0,0,0,,Ồ?
Dialogue: 0,0:02:13.11,0:02:15.30,main,Kousuke,0,0,0,,Cậu sẽ không cười cợt được lâu nữa đâu.
Dialogue: 0,0:02:15.30,0:02:18.29,main,Kousuke,0,0,0,,Cả Nanami và tôi sẽ sớm vượt qua cậu\Nchỉ trong chớp mắt thôi.
Dialogue: 0,0:02:18.29,0:02:21.21,main,Benito,0,0,0,,Chà, nghe có vẻ thú vị đấy chứ.
Dialogue: 0,0:02:21.21,0:02:24.30,main,Benito,0,0,0,,Tao chỉ cầu mong là mày không chỉ biết\Nba hoa chích chòe bằng cái mồm thôi đâu nhé.
Dialogue: 0,0:02:28.20,0:02:29.90,main,Nanami,0,0,0,,Chúng ta để thế này có ổn không ạ?
Dialogue: 0,0:02:29.90,0:02:30.56,main,Kousuke,0,0,0,,Ổn chứ.
Dialogue: 0,0:02:31.16,0:02:33.30,main,Kousuke,0,0,0,,Hiện tại thì đúng là rất khó để đánh bại Benito,
Dialogue: 0,0:02:33.30,0:02:36.81,main,Kousuke,0,0,0,,Trưởng ban Lễ Nghi.
Dialogue: 0,0:02:37.76,0:02:40.52,main,Kousuke,0,0,0,,Nhưng việc tôi sẽ trở thành kẻ mạnh nhất là điều chắc chắn rồi,
Dialogue: 0,0:02:40.83,0:02:43.24,main,Kousuke,0,0,0,,nên chúng ta hãy cùng nhau mạnh lên nhé, Nanami!
Dialogue: 0,0:02:44.17,0:02:46.55,main,Nanami,0,0,0,,Cùng nhau... trở nên mạnh hơn!
Dialogue: 0,0:04:17.17,0:04:19.99,sign_8204_57_Night_Sky_Cave,sign,0,0,0,,{\fad(881,1)\pos(321,311)}Hang Động Dạ Không
Dialogue: 0,0:04:19.99,0:04:25.24,main - italics,Kousuke(M),0,0,0,,Tôi và Nanami đang cùng nhau khám phá "Hang Động Dạ Không",
Dialogue: 0,0:04:25.24,0:04:27.25,main - italics,Kousuke(M),0,0,0,,một hầm ngục phần thưởng giới hạn khi đặt mua trước tại một cửa hàng nhất định.
Dialogue: 0,0:04:31.49,0:04:34.83,main - italics,Kousuke(M),0,0,0,,Nơi này được xem là một hầm ngục chưa xếp hạng bên ngoài Học viện
Dialogue: 0,0:04:34.83,0:04:38.79,main - italics,Kousuke(M),0,0,0,,và là địa điểm hoàn hảo cho Nanami, người vừa mới học được các đòn tấn công tầm xa.
Dialogue: 0,0:04:39.13,0:04:40.91,main,Kousuke,0,0,0,,Nanami, cô dùng cung thấy thế nào rồi?
Dialogue: 0,0:04:41.73,0:04:43.76,main,Nanami,0,0,0,,Đến giờ thì nó về cơ bản\Nđã như một phần cơ thể của tôi rồi.
Dialogue: 0,0:04:44.19,0:04:45.84,main,Nanami,0,0,0,,Mà, nếu ngài đạt đến đẳng cấp siêu phàm như tôi,
Dialogue: 0,0:04:45.84,0:04:49.01,main,Nanami,0,0,0,,thì việc làm chủ bất kỳ món vũ khí nào cũng chỉ là chuyện cỏn con.
Dialogue: 0,0:04:49.39,0:04:51.02,main,Kousuke,0,0,0,,Nghe đầy hứa hẹn đấy chứ.
Dialogue: 0,0:04:51.85,0:04:53.89,main - italics,Kousuke(M),0,0,0,,Mục tiêu tối thượng của mình ở nơi này
Dialogue: 0,0:04:53.89,0:04:57.48,main - italics,Kousuke(M),0,0,0,,là đoạt được các kỹ năng của đạo tặc\Nbằng cách tiêu diệt con trùm.
Dialogue: 0,0:04:57.75,0:05:01.32,main - italics,Kousuke(M),0,0,0,,Mấy kỹ năng đó rất hữu dụng vì giúp ta dễ dàng né tránh các cạm bẫy thông thường.
Dialogue: 0,0:05:01.68,0:05:05.86,main - italics,Kousuke(M),0,0,0,,Dù vậy thì mấy cái bẫy gợi cảm dâm dục có tăng tối đa cấp độ cũng chẳng né nổi đâu...
Dialogue: 0,0:05:09.97,0:05:11.92,main,Nanami,0,0,0,,Như thế này có ổn không ạ?
Dialogue: 0,0:05:11.92,0:05:14.33,main,Nanami,0,0,0,,Đáng lẽ ngài có nên nói chuyện này cho Ludie-sama\Nvà những người khác biết không?
Dialogue: 0,0:05:14.33,0:05:16.20,main,Kousuke,0,0,0,,Chúng ta đang ở ngoài khuôn viên trường mà.
Dialogue: 0,0:05:16.20,0:05:18.96,main,Kousuke,0,0,0,,Nếu hôm nay không có tiết học thì tôi đã rủ họ đi cùng rồi.
Dialogue: 0,0:05:19.73,0:05:21.66,main,Nanami,0,0,0,,Đây quả thực là một trận chiến trường kỳ và gian khổ.
Dialogue: 0,0:05:21.66,0:05:22.97,main,Kousuke,0,0,0,,Cô nói xạo vừa thôi.
Dialogue: 0,0:05:23.24,0:05:26.55,main,Kousuke,0,0,0,,Nhưng công nhận là chuyến đi này\Ndiễn ra suôn sẻ không một chút trở ngại thật.
Dialogue: 0,0:05:31.31,0:05:32.36,main - italics,Kousuke(M),0,0,0,,Kỳ lạ thật đấy.
Dialogue: 0,0:05:32.36,0:05:35.10,main - italics,Kousuke(M),0,0,0,,Trong tựa game MagiEx mà mình biết đâu có cánh cổng nào như thế này đâu chứ!
Dialogue: 0,0:05:35.10,0:05:36.73,main,Nanami,0,0,0,,Đây là phòng trùm sao ạ?
Dialogue: 0,0:05:36.73,0:05:39.06,main,Kousuke,0,0,0,,Không... đây là...
Dialogue: 0,0:05:39.47,0:05:41.16,main,Kousuke,0,0,0,,tầng phụ mở rộng!
Dialogue: 0,0:05:43.19,0:05:46.17,main - italics,Kousuke(M),0,0,0,,Đúng chuẩn phong cách của Magical Explorer mà lị.
Dialogue: 0,0:05:46.17,0:05:49.91,main - italics,Kousuke(M),0,0,0,,Nó luôn đẩy bạn vào những tình huống lố bịch quái đản\Nmà chẳng có tựa game eroge nào khác dám làm...
Dialogue: 0,0:05:52.39,0:05:54.83,main,Nanami,0,0,0,,Thưa Chủ nhân, ở đây có một rương kho báu này.
Dialogue: 0,0:05:56.31,0:05:57.08,main,Nanami,0,0,0,,Cái gì thế này?
Dialogue: 0,0:05:57.78,0:05:59.79,main,Kousuke,0,0,0,,Ủa sao lại có cái roi da ở đây thế?
Dialogue: 0,0:06:01.64,0:06:06.31,main,Nanami,0,0,0,,Thưa Chủ nhân, chủng tộc của ngài là con người,\Nvà Ludie-sama là một elf.
Dialogue: 0,0:06:06.31,0:06:08.43,main,Nanami,0,0,0,,Ngài có biết chủng tộc của tôi là gì không?
Dialogue: 0,0:06:08.71,0:06:10.53,main,Kousuke,0,0,0,,H-Hình như là thiên sứ đúng không?
Dialogue: 0,0:06:10.53,0:06:12.41,main,Nanami,0,0,0,,Hoàn toàn chính xác thưa Chủ nhân.
Dialogue: 0,0:06:13.03,0:06:14.63,main,Nanami,0,0,0,,Vậy thì thứ này là cái gì đây?
Dialogue: 0,0:06:15.27,0:06:20.05,main,Kousuke,0,0,0,,N-Nó trông như một bộ trang phục ác ma đầy khêu gợi vậy?
Dialogue: 0,0:06:20.44,0:06:22.44,main,Nanami,0,0,0,,Lại hoàn toàn chính xác một lần nữa.
Dialogue: 0,0:06:22.44,0:06:23.98,main,Nanami,0,0,0,,Ngài làm tốt lắm thưa Chủ nhân.
Dialogue: 0,0:06:23.98,0:06:27.52,main,Nanami,0,0,0,,Hơn nữa, nếu những gì viết ở đây là sự thật,
Dialogue: 0,0:06:27.52,0:06:29.75,main,Nanami,0,0,0,,thì tôi bắt buộc phải mặc bộ trang phục này vào.
Dialogue: 0,0:06:29.75,0:06:32.41,main,Kousuke,0,0,0,,Mặc thế có sao không, vì cô vốn là thiên sứ mà?
Dialogue: 0,0:06:32.41,0:06:36.16,main,Nanami,0,0,0,,Không, việc khoác lên mình vài bộ quần áo thì chẳng có vấn đề gì cả.
Dialogue: 0,0:06:36.56,0:06:39.85,main,Nanami,0,0,0,,Tuy nhiên, trông tôi sẽ chẳng khác nào một thiên thần sa ngã.
Dialogue: 0,0:06:39.85,0:06:41.15,main,Nanami,0,0,0,,Ngài có hiểu không?
Dialogue: 0,0:06:41.58,0:06:43.00,main,Nanami,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:06:43.00,0:06:44.92,main,Nanami,0,0,0,,Làm ơn hãy nói với tôi là họ đang nói dối đi!
Dialogue: 0,0:06:45.33,0:06:48.26,main,Kousuke,0,0,0,,Rất tiếc là tôi nghĩ chuyện này là thật đấy.
Dialogue: 0,0:06:48.26,0:06:50.93,main,Kousuke,0,0,0,,Ở đó còn viết gì nữa không?
Dialogue: 0,0:06:51.48,0:06:54.93,main,Nanami,0,0,0,,"Hãy cosplay thành một ác ma quyến rũ gợi cảm\Nvà dùng roi quất vào các vật thể!
Dialogue: 0,0:06:55.45,0:06:56.54,main,Nanami,0,0,0,,Một khi thanh năng lượng được lấp đầy,
Dialogue: 0,0:06:56.54,0:06:58.89,main,Nanami,0,0,0,,ma pháp trận dịch chuyển\Nsẽ được tiếp tế đầy đủ ma lực!"
Dialogue: 0,0:06:59.65,0:07:00.87,main,Nanami,0,0,0,,là những gì được viết ở đây ạ.
Dialogue: 0,0:07:00.87,0:07:01.88,main,Kousuke,0,0,0,,Tôi hiểu rồi...
Dialogue: 0,0:07:02.59,0:07:05.69,main - italics,Kousuke(M),0,0,0,,Đá phù văn truyền tống... đương nhiên là không xài được rồi.
Dialogue: 0,0:07:05.69,0:07:09.44,main - italics,Kousuke(M),0,0,0,,Không thể tin nổi là trong MagiEx vẫn còn những hầm ngục\Nmà mình chưa từng biết đến...
Dialogue: 0,0:07:10.23,0:07:11.60,main,Nanami,0,0,0,,Ôi trời đất ơi!
Dialogue: 0,0:07:11.60,0:07:14.20,main,Nanami,0,0,0,,Có một bộ trang phục nam ở dưới đáy rương này!
Dialogue: 0,0:07:14.20,0:07:17.75,main - italics,Kousuke(M),0,0,0,,Khoan đã nào, chuyện này hoàn toàn điên rồ hết chỗ nói!
Dialogue: 0,0:07:18.03,0:07:19.81,main - italics,Kousuke(M),0,0,0,,Ý tôi là, thôi nào!
Dialogue: 0,0:07:19.81,0:07:23.15,main - italics,Kousuke(M),0,0,0,,Đại đa số người chơi game eroge đều muốn ngắm nhìn các cô gái xinh đẹp!
Dialogue: 0,0:07:23.15,0:07:26.34,main - italics,Kousuke(M),0,0,0,,Đó là lý do các nhà phát triển phải dồn hết tâm huyết vào điều đó!
Dialogue: 0,0:07:26.59,0:07:28.68,main - italics,Kousuke(M),0,0,0,,Nhưng dù có nhìn nhận theo cách nào đi chăng nữa,
Dialogue: 0,0:07:28.68,0:07:32.93,main - italics,Kousuke(M),0,0,0,,chẳng có một ai lại muốn ngắm nhìn một gã đực rựa đi cosplay cả!
Dialogue: 0,0:07:33.17,0:07:36.77,main,Nanami,0,0,0,,Ôi không, tôi cứ tưởng mình có thể\Nhy sinh thân mình vì chuyện này chứ.
Dialogue: 0,0:07:36.77,0:07:38.28,main,Nanami,0,0,0,,Thật là vô cùng đáng tiếc.
Dialogue: 0,0:07:38.28,0:07:40.88,main,Nanami,0,0,0,,Xem ra ngài cũng sẽ phải khoác bộ này lên người rồi.
Dialogue: 0,0:07:40.88,0:07:43.69,main,Kousuke,0,0,0,,Khoan khoan đã, tôi mặc vào rồi thì\Nrốt cuộc phải làm cái quái gì sau đó cơ chứ?!
Dialogue: 0,0:07:45.44,0:07:48.11,main - italics,Kousuke(M),0,0,0,,Chết tiệt thật, mình nhớ ra rồi!
Dialogue: 0,0:07:49.26,0:07:51.49,main - italics,Kousuke(M),0,0,0,,Giờ mình mới nhớ ngày xưa nhà phát triển từng nói
Dialogue: 0,0:07:51.49,0:07:53.74,main - italics,Kousuke(M),0,0,0,,có một hầm ngục mà người chơi hoàn toàn không hề mong muốn.
Dialogue: 0,0:07:54.11,0:07:56.20,main - italics,Kousuke(M),0,0,0,,Lẽ nào đây chính là cái hầm ngục đó sao?!
Dialogue: 0,0:07:56.84,0:07:58.25,main - italics,Kousuke(M),0,0,0,,Mình hoàn toàn hiểu được tại sao nó lại bị hủy bỏ.
Dialogue: 0,0:07:58.51,0:08:01.33,main - italics,Kousuke(M),0,0,0,,Nếu mình mà là đạo diễn thì mình đã gạt phăng cái thứ này ngay từ đầu rồi!
Dialogue: 0,0:08:01.33,0:08:04.00,main - italics,Kousuke(M),0,0,0,,Rốt cuộc trên đời này ai lại cần hay muốn ngắm nhìn thứ quái thai như thế này chứ?!
Dialogue: 0,0:08:04.00,0:08:07.22,main - italics,Kousuke(M),0,0,0,,Hay là mình cứ để Nanami làm chuyện này một mình nhỉ?
Dialogue: 0,0:08:07.22,0:08:09.13,main - italics,Kousuke(M),0,0,0,,Không, mình không thể làm thế được.
Dialogue: 0,0:08:09.13,0:08:11.01,main - italics,Kousuke(M),0,0,0,,Mình không thể bắt cô ấy phải chịu thiệt thòi một mình
Dialogue: 0,0:08:11.01,0:08:12.88,main - italics,Kousuke(M),0,0,0,,trong khi bản thân hoàn toàn có khả năng làm được...
Dialogue: 0,0:08:12.88,0:08:15.85,main,Kousuke,0,0,0,,Chết tiệt thật!
Dialogue: 0,0:08:21.68,0:08:22.73,main,Nanami,0,0,0,,Nanami...
Dialogue: 0,0:08:23.25,0:08:25.98,main,Nanami,0,0,0,,đã sa ngã rồi.
Dialogue: 0,0:08:26.61,0:08:28.33,main,Nanami,0,0,0,,Thiên Thần Sa Ngã Nanami...
Dialogue: 0,0:08:29.66,0:08:31.27,main,Nanami,0,0,0,,đã xuất hiện rồi đây!
Dialogue: 0,0:08:32.43,0:08:34.02,main,Kousuke,0,0,0,,Trông cô nhiệt tình hào hứng ghê nhỉ.
Dialogue: 0,0:08:34.02,0:08:36.55,main,Kousuke,0,0,0,,Sao lại còn tạo dáng khoe khoang thế kia nữa?
Dialogue: 0,0:08:37.91,0:08:42.00,main,Nanami,0,0,0,,Đương nhiên là tôi mặc bộ này trông rất đẹp rồi,\Nnhưng nó cũng rất hợp với ngài đấy, thưa Chủ nhân.
Dialogue: 0,0:08:42.40,0:08:43.58,main,Kousuke,0,0,0,,Cảm ơn cô nhé.
Dialogue: 0,0:08:43.58,0:08:46.31,main,Kousuke,0,0,0,,Giờ thì mau mau chuồn khỏi cái chỗ quỷ quái này thôi nào.
Dialogue: 0,0:08:46.31,0:08:47.29,main,Nanami,0,0,0,,Tôi đồng ý.
Dialogue: 0,0:08:47.29,0:08:48.68,main,Nanami,0,0,0,,Bắt đầu thôi nào.
Dialogue: 0,0:08:49.63,0:08:52.22,main - italics top,Voice,0,0,0,,Hãy căn chuẩn thời gian và quất một roi\Nkhi nó đi vào trong vòng tròn.
Dialogue: 0,0:08:51.59,0:08:53.41,main,Kousuke,0,0,0,,Cứ như là chơi game âm nhạc vậy.
Dialogue: 0,0:08:52.22,0:08:54.69,main - italics top,Voice,0,0,0,,Nếu các bạn có thể lấp đầy thanh năng lượng\Ntrước khi bài hát kết thúc,
Dialogue: 0,0:08:53.41,0:08:58.22,main,Nanami,0,0,0,,Có vẻ như chúng ta sẽ nhận được nhiều mana hơn\Nnếu quất trúng khi chiếc roi và biểu tượng đè lên nhau.
Dialogue: 0,0:08:54.69,0:08:56.65,main - italics top,Voice,0,0,0,,các bạn sẽ vượt qua màn chơi.
Dialogue: 0,0:08:56.65,0:08:58.76,main - italics top,Voice,0,0,0,,Nếu phạm sai lầm,\Ncác bạn sẽ phải chịu hình phạt thích đáng.
Dialogue: 0,0:08:58.76,0:09:02.10,main,Nanami,0,0,0,,Nếu chúng ta căn trượt quá xa, chúng ta sẽ bị trừ bớt mana.
Dialogue: 0,0:09:03.10,0:09:06.07,main,Nanami,0,0,0,,Dạ ừm, nếu chúng ta phạm phải dù chỉ một sai lầm thôi,
Dialogue: 0,0:09:06.60,0:09:09.73,main,Nanami,0,0,0,,thì một loại chất bôi trơn màu hồng\Nsẽ phun ra khiến chúng ta hưng phấn rạo rực đấy ạ.
Dialogue: 0,0:09:10.55,0:09:11.86,main,Kousuke,0,0,0,,Thật luôn đấy à?!
Dialogue: 0,0:09:11.86,0:09:13.17,main,Kousuke,0,0,0,,Lại trò này nữa sao?
Dialogue: 0,0:09:13.17,0:09:16.00,main,Kousuke,0,0,0,,Họ nghĩ đổi màu sang màu hồng thì sẽ khác biệt chắc?!
Dialogue: 0,0:09:16.35,0:09:19.56,main,Nanami,0,0,0,,Nhưng lần này nó có những công dụng chăm sóc da rất tuyệt vời,
Dialogue: 0,0:09:19.56,0:09:22.29,main,Nanami,0,0,0,,chẳng hạn như làm sáng da, dưỡng ẩm sâu và thậm chí nâng tông nữa đấy ạ.
Dialogue: 0,0:09:22.29,0:09:25.58,main,Kousuke,0,0,0,,Chỉ riêng cái việc nó khiến người ta nứng lên thôi\Nlà đã đủ khiến tôi mất sạch niềm tin vào nó rồi!
Dialogue: 0,0:09:25.85,0:09:28.67,main,Nanami,0,0,0,,Thưa Chủ nhân, có thể có giới hạn thời gian đấy ạ.
Dialogue: 0,0:09:28.67,0:09:30.08,main,Nanami,0,0,0,,Tôi nghĩ chúng ta nên bắt đầu thôi.
Dialogue: 0,0:09:30.08,0:09:31.41,main,Kousuke,0,0,0,,Cô nói đúng.
Dialogue: 0,0:09:31.41,0:09:32.05,main,Kousuke,0,0,0,,Làm thôi nào!
Dialogue: 0,0:09:37.18,0:09:40.01,main,Kousuke,0,0,0,,Ủa mà tại sao của tôi lại là cái đập thảm\Nthay vì một cái roi da chứ hả?!
Dialogue: 0,0:09:40.01,0:09:42.45,main,Nanami,0,0,0,,Nhưng tôi nghĩ cái đó dùng dễ hơn một cây roi dài mà.
Dialogue: 0,0:09:43.02,0:09:44.01,main,Kousuke,0,0,0,,Gãy mất tiêu rồi kìa!
Dialogue: 0,0:09:44.01,0:09:45.27,main,Nanami,0,0,0,,Các biểu tượng khác đang ùa tới kìa!
Dialogue: 0,0:09:50.98,0:09:53.40,main,Nanami,0,0,0,,Kỹ năng tét mông xuất sắc lắm thưa Chủ nhân.
Dialogue: 0,0:09:53.40,0:09:55.48,main,Nanami,0,0,0,,Đó có phải là dấu hiệu cho thấy ngài đã rất quen thuộc\Nvới hoạt động này không ạ?
Dialogue: 0,0:09:55.48,0:09:57.03,main,Kousuke,0,0,0,,Cô thừa biết là tôi đâu có tét mông ai bao giờ đâu đúng không?!
Dialogue: 0,0:09:57.03,0:09:58.21,main,Nanami,0,0,0,,Ồ, vậy là ngài toàn bị người ta tét mông sao.
Dialogue: 0,0:09:58.21,0:09:59.80,main,Kousuke,0,0,0,,Không có đâu nhé!
Dialogue: 0,0:09:59.80,0:10:02.04,main,Kousuke,0,0,0,,Trong đầu cô đang hình dung ra cái hình ảnh gì về tôi thế hả?!
Dialogue: 0,0:10:12.28,0:10:14.55,main,Voice,0,0,0,,Thanh năng lượng gần đầy rồi kìa.
Dialogue: 0,0:10:14.94,0:10:15.76,main,Kousuke,0,0,0,,Ngon lành!
Dialogue: 0,0:10:15.76,0:10:17.17,main,Kousuke,0,0,0,,Ủa, cái gì thế kia?
Dialogue: 0,0:10:17.17,0:10:20.01,main,Nanami,0,0,0,,Thưa Chủ nhân, có vẻ như chúng ta vẫn chưa thể vội mừng đâu ạ.
Dialogue: 0,0:10:20.01,0:10:24.31,main,Kousuke,0,0,0,,Khoan đã nào, tại sao thanh năng lượng đã đầy rồi\Nmà nhạc vẫn còn đang chạy tiếp thế kia?
Dialogue: 0,0:10:24.31,0:10:25.60,main,Nanami,0,0,0,,Xin ngài hãy bình tĩnh giữ vững tinh thần.
Dialogue: 0,0:10:25.60,0:10:27.81,main,Nanami,0,0,0,,Nếu chúng ta mắc sai lầm lúc này, chúng ta sẽ bị ướt sũng đấy!
Dialogue: 0,0:10:28.03,0:10:31.06,main,Kousuke,0,0,0,,Chết tiệt thật, hóa ra là chưa kết thúc cho tới khi hết nhạc.
Dialogue: 0,0:10:31.52,0:10:34.03,main,Kousuke,0,0,0,,Nếu kẻ nghĩ ra cái trò này mà còn sống,
Dialogue: 0,0:10:34.03,0:10:36.19,main,Kousuke,0,0,0,,tôi nhất định phải đấm cho hắn một phát mới hả dạ!
Dialogue: 0,0:10:43.68,0:10:44.89,main,Kousuke,0,0,0,,Chúng ta làm được rồi!
Dialogue: 0,0:10:44.89,0:10:46.61,main,Nanami,0,0,0,,Chúng ta làm được rồi thưa Chủ nhân!
Dialogue: 0,0:10:46.61,0:10:50.46,main,Kousuke,0,0,0,,Cô thấy chưa? Đó chính là sức mạnh\Ncủa tôi và Nanami đấy!
Dialogue: 0,0:10:53.41,0:10:53.96,main,Both,0,0,0,,Ồ.
Dialogue: 0,0:10:56.67,0:10:58.83,main - italics top,Voice,0,0,0,,Hỏng rồi.
Dialogue: 0,0:10:58.83,0:10:59.65,main,Nanami,0,0,0,,Không thể nào...
Dialogue: 0,0:11:01.42,0:11:06.10,main - italics,Kousuke(M),0,0,0,,Mình vốn đã tính trước xem sẽ làm gì\Nnếu tình huống này xảy ra rồi.
Dialogue: 0,0:11:06.10,0:11:08.04,main - italics,Kousuke(M),0,0,0,,Thực ra, mình thậm chí còn chẳng cần phải suy nghĩ về nó.
Dialogue: 0,0:11:08.04,0:11:10.05,main - italics,Kousuke(M),0,0,0,,Ý mình là, dựa theo những nguyên tắc sống của mình,
Dialogue: 0,0:11:10.05,0:11:13.52,main - italics,Kousuke(M),0,0,0,,mình biết bản thân sẽ hành động theo bản năng như thế này.
Dialogue: 0,0:11:13.88,0:11:15.69,main,Kousuke,0,0,0,,Nanami, cảm ơn cô nhé.
Dialogue: 0,0:11:16.14,0:11:17.28,main,Kousuke,0,0,0,,Cô hãy lùi lại phía sau đi.
Dialogue: 0,0:11:18.21,0:11:19.45,main,Nanami,0,0,0,,Chủ nhân?!
Dialogue: 0,0:11:20.13,0:11:23.16,main,Kousuke,0,0,0,,Chỉ cần một mình tôi bị ướt là đủ rồi.
Dialogue: 0,0:11:25.77,0:11:26.95,main,Nanami,0,0,0,,Chủ nhân ơi, ở phía trên ngài kìa!
Dialogue: 0,0:11:26.95,0:11:27.75,main,Kousuke,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:11:29.49,0:11:32.31,main,Kousuke,0,0,0,,Chơi hai vòi xịt thế này là gian lận quá đáng lắm đấy nhé.
Dialogue: 0,0:11:32.31,0:11:34.09,main,Kousuke,0,0,0,,Họ thực sự quyết tâm nhắm vào chúng ta mà.
Dialogue: 0,0:11:44.60,0:11:45.86,main,Kousuke,0,0,0,,Đồ ngốc này!
Dialogue: 0,0:11:45.86,0:11:48.45,main,Kousuke,0,0,0,,Thế thì việc tôi che chắn cho cô\Ncòn có ý nghĩa gì nữa chứ hả?!
Dialogue: 0,0:11:49.51,0:11:54.63,main,Nanami,0,0,0,,Nỗi đau của ngài... cũng chính là nỗi... đau của tôi.
Dialogue: 0,0:11:56.31,0:11:57.98,main,Kousuke,0,0,0,,Nanami...
Dialogue: 0,0:12:11.16,0:12:12.66,main,Kousuke,0,0,0,,Cô có sao không hả Nanami?
Dialogue: 0,0:12:12.66,0:12:14.29,main,Nanami,0,0,0,,Dạ vâng, tôi ổn rồi ạ.
Dialogue: 0,0:12:14.29,0:12:16.42,main,Nanami,0,0,0,,Có vẻ như tác dụng của chất bôi trơn cũng đã tan biến rồi.
Dialogue: 0,0:12:24.97,0:12:26.34,main,Kousuke,0,0,0,,Con trùm đấy à?
Dialogue: 0,0:12:26.34,0:12:27.85,main,Nanami,0,0,0,,Vâng ạ, chính là con trùm.
Dialogue: 0,0:12:28.10,0:12:30.68,main,Nanami,0,0,0,,Ồ, có vẻ như thời khắc cuối cùng cũng đã điểm...
Dialogue: 0,0:12:30.68,0:12:33.39,main,Nanami,0,0,0,,Thời khắc mà tôi phải phô diễn sức mạnh thực sự của mình.
Dialogue: 0,0:12:33.39,0:12:34.56,main,Kousuke,0,0,0,,Mỗi lần nghe mấy câu thoại kiểu đó,
Dialogue: 0,0:12:34.56,0:12:37.61,main,Kousuke,0,0,0,,tôi luôn tự hỏi sao không tung hết sức ra ngay từ đầu đi chứ?
Dialogue: 0,0:12:39.07,0:12:40.53,main,Nanami,0,0,0,,Nanami, xông lên!
Dialogue: 0,0:12:40.78,0:12:43.11,main,Nanami,0,0,0,,Tiễn Kích Bộc Phá (Impact Arrow)!
Dialogue: 0,0:12:44.70,0:12:48.37,main,Kousuke,0,0,0,,Chà, tôi nghĩ ở đây chẳng cần đến tôi nữa rồi.
Dialogue: 0,0:12:48.37,0:12:49.66,main,Nanami,0,0,0,,Ngài đang nói cái gì thế ạ?
Dialogue: 0,0:12:49.66,0:12:50.74,main,Nanami,0,0,0,,Đương nhiên là cần ngài rồi chứ.
Dialogue: 0,0:12:50.74,0:12:52.33,main,Nanami,0,0,0,,"Hừ, ngươi chỉ có bấy nhiêu đó thôi sao?
Dialogue: 0,0:12:52.33,0:12:54.46,main,Nanami,0,0,0,,Ngươi thậm chí còn không xứng để ta phải bẩn tay nữa,"
Dialogue: 0,0:12:54.96,0:12:56.42,main,Nanami,0,0,0,,đó là cách ngài nên cười khẩy đấy ạ.
Dialogue: 0,0:12:56.42,0:12:59.21,main,Kousuke,0,0,0,,Nghe cứ như lời thoại của mấy tên phản diện\Nsắp bị ăn đòn no nê sau đó vậy.
Dialogue: 0,0:13:08.35,0:13:09.76,main,Kousuke,0,0,0,,Ấn tượng thật đấy.
Dialogue: 0,0:13:09.76,0:13:11.81,main,Nanami,0,0,0,,Chẳng qua là con bù nhìn đó to xác hơn thôi mà.
Dialogue: 0,0:13:11.81,0:13:15.02,main,Nanami,0,0,0,,Nó có đủ thông minh để hiểu được rằng có một cơ thể to lớn hơn
Dialogue: 0,0:13:15.02,0:13:16.44,main,Nanami,0,0,0,,cũng chẳng giải quyết được vấn đề gì không nhỉ?
Dialogue: 0,0:13:17.69,0:13:18.48,main,Kousuke,0,0,0,,Hắn lao tới kìa!
Dialogue: 0,0:13:21.61,0:13:24.03,main,Kousuke,0,0,0,,Tên này khá đấy chứ.
Dialogue: 0,0:13:25.86,0:13:27.91,main,Kousuke,0,0,0,,Khả năng cảm nhận nguy hiểm của hắn cũng thuộc hàng đỉnh cao nữa.
Dialogue: 0,0:13:28.74,0:13:31.03,main - italics,Kousuke(M),0,0,0,,Mình nghĩ điểm yếu của hắn là...
Dialogue: 0,0:13:33.50,0:13:34.79,main,Kousuke,0,0,0,,Thấy đòn này thế nào hả?!
Dialogue: 0,0:13:48.51,0:13:50.68,main,Kousuke,0,0,0,,Hi vọng là đòn đó đã phát huy tác dụng.
Dialogue: 0,0:14:01.52,0:14:02.40,main,Nanami,0,0,0,,Chủ nhân!
Dialogue: 0,0:14:05.90,0:14:07.65,main,Nanami,0,0,0,,Cứ để đó cho tôi thưa Chủ nhân!
Dialogue: 0,0:14:07.65,0:14:09.78,main,Kousuke,0,0,0,,Nanami! Đừng có liều lĩnh thế chứ!
Dialogue: 0,0:14:13.70,0:14:15.33,main,Nanami,0,0,0,,Bộc Liệt Tiễn (Explosive Arrow)!
Dialogue: 0,0:14:31.26,0:14:35.18,main,Kousuke,0,0,0,,Thôi nào anh bạn, chơi combo liên hoàn thế là không công bằng đâu nhé.
Dialogue: 0,0:14:35.18,0:14:37.02,main,Nanami,0,0,0,,Chủ nhân... cánh tay của ngài...
Dialogue: 0,0:14:37.81,0:14:41.77,main,Kousuke,0,0,0,,Thời gian để ngươi ảo tưởng rằng mình mạnh hơn đã chấm dứt rồi!
Dialogue: 0,0:14:48.95,0:14:50.03,main,Kousuke,0,0,0,,Ngay bây giờ, Nanami!
Dialogue: 0,0:14:50.45,0:14:52.03,main,Nanami,0,0,0,,Bộc Liệt Tiễn (Explosive Arrow)!
Dialogue: 0,0:14:58.12,0:14:59.16,main,Kousuke,0,0,0,,Bạt Đao Thuật...
Dialogue: 0,0:15:03.71,0:15:04.67,main,Kousuke,0,0,0,,Thiểm Quang (Flash).
Dialogue: 0,0:15:09.76,0:15:13.55,main,Kousuke,0,0,0,,Chà, đó là những gì sẽ xảy ra\Nkhi đối đầu với tôi và Nanami đấy.
Dialogue: 0,0:15:13.55,0:15:15.01,main,Kousuke,0,0,0,,Đúng không nào, Nanami?
Dialogue: 0,0:15:16.31,0:15:17.68,main,Kousuke,0,0,0,,Sao thế hả Nanami?
Dialogue: 0,0:15:20.19,0:15:22.98,main,Kousuke,0,0,0,,Đúng là chuẩn bị kỹ càng thì chẳng lo ngại gì nữa nhỉ?
Dialogue: 0,0:15:23.86,0:15:25.98,main,Kousuke,0,0,0,,Không sao đâu mà. Chỉ là vết thương ngoài da thôi.
Dialogue: 0,0:15:31.28,0:15:35.53,main,Kousuke,0,0,0,,Thế là cô không thể yên lòng được\Ncho đến khi tự trách móc bản thân một trận ra trò sao?
Dialogue: 0,0:15:35.83,0:15:38.29,main,Nanami,0,0,0,,Chuyện không hẳn là như thế...
Dialogue: 0,0:15:38.29,0:15:41.12,main,Kousuke,0,0,0,,Vậy tại sao cô lại khắt khe với bản thân đến mức như thế chứ?
Dialogue: 0,0:15:41.87,0:15:44.75,main,Nanami,0,0,0,,Tôi thực sự phải trả lời câu hỏi đó sao ạ?
Dialogue: 0,0:15:44.75,0:15:47.88,main,Kousuke,0,0,0,,Không, nếu cô không muốn trả lời thì không cần phải nói đâu.
Dialogue: 0,0:15:47.88,0:15:51.34,main,Nanami,0,0,0,,Chính là cái tính đó đấy! Cái tính cách đó của ngài đấy!
Dialogue: 0,0:15:52.13,0:15:53.13,main,Kousuke,0,0,0,,Nanami?
Dialogue: 0,0:15:53.59,0:15:57.81,main,Nanami,0,0,0,,Mọi tri thức đều được chuyển giao cho các Hiệp Sĩ Hầu Gái thuộc dòng Hầu Gái Hầm Ngục.
Dialogue: 0,0:15:57.81,0:16:00.31,main,Nanami,0,0,0,,Nên tôi biết rất rõ...
Dialogue: 0,0:16:01.48,0:16:04.27,main,Nanami,0,0,0,,Có vô số cá thể khả thi khác\Nsẵn sàng thay thế vị trí của tôi bất cứ lúc nào.
Dialogue: 0,0:16:04.52,0:16:08.02,main - italics,Kousuke(M),0,0,0,,Hình như mình nhớ mang máng từng nghe điều gì đó tương tự trong MagiEx.
Dialogue: 0,0:16:08.32,0:16:10.24,main,Nanami,0,0,0,,Có những chuyện đáng lẽ tôi phải nói cho ngài biết,
Dialogue: 0,0:16:10.24,0:16:12.95,main,Nanami,0,0,0,,nhưng vì lý do cá nhân mà tôi đã giấu kín.
Dialogue: 0,0:16:12.95,0:16:14.82,main,Nanami,0,0,0,,Chắc hẳn ngài đã vỡ mộng và chán ghét tôi rồi đúng không.
Dialogue: 0,0:16:15.28,0:16:17.62,main,Nanami,0,0,0,,Ngài cũng có thể nghĩ rằng tôi là một cô hầu gái vô dụng
Dialogue: 0,0:16:17.62,0:16:19.54,main,Nanami,0,0,0,,do vô số những sai lầm ngớ ngẩn mà tôi đã phạm phải.
Dialogue: 0,0:16:19.54,0:16:22.58,main,Nanami,0,0,0,,Đó là lý do tôi luôn muốn trở nên có ích cho ngài,
Dialogue: 0,0:16:22.58,0:16:24.42,main,Nanami,0,0,0,,nhưng rốt cuộc lại toàn khiến ngài phải đứng ra gánh vác che chở cho tôi.
Dialogue: 0,0:16:24.42,0:16:26.25,main,Kousuke,0,0,0,,Cô đang nói cái lảm nhảm gì thế hả?
Dialogue: 0,0:16:26.25,0:16:28.46,main,Kousuke,0,0,0,,Vỡ mộng sao?
Dialogue: 0,0:16:28.84,0:16:31.05,main,Kousuke,0,0,0,,Tôi thật sự chưa từng có bất kỳ cảm xúc nào\Ndù chỉ là gần giống như thế về cô đâu đấy.
Dialogue: 0,0:16:31.67,0:16:34.30,main,Kousuke,0,0,0,,Chưa kể bản thân tôi cũng phạm sai lầm suốt ngày đấy thôi.
Dialogue: 0,0:16:35.64,0:16:36.80,main,Nanami,0,0,0,,Chủ nhân...
Dialogue: 0,0:16:37.05,0:16:39.76,main,Kousuke,0,0,0,,Nanami, tôi muốn cô lắng nghe điều này.
Dialogue: 0,0:16:40.22,0:16:42.52,main,Kousuke,0,0,0,,Chuyện xảy ra trước khi chúng ta gặp nhau,
Dialogue: 0,0:16:42.52,0:16:45.81,main,Kousuke,0,0,0,,nhưng khi đó bọn tôi đã rơi vào một tình cảnh vô cùng tồi tệ\Nmà Ludie suýt chút nữa đã mất mạng.
Dialogue: 0,0:16:45.81,0:16:47.15,main,Nanami,0,0,0,,Thật thế sao ạ?
Dialogue: 0,0:16:47.15,0:16:48.57,main,Kousuke,0,0,0,,Ừ, thật đấy.
Dialogue: 0,0:16:48.90,0:16:50.90,main,Kousuke,0,0,0,,Tôi đã nằng nặc kéo đàn chị Yukine đi cùng,
Dialogue: 0,0:16:50.90,0:16:52.74,main,Kousuke,0,0,0,,và lao vào cứu cậu ấy mà chẳng thèm suy tính gì cả.
Dialogue: 0,0:16:53.19,0:16:55.82,main - italics,Kousuke(M),0,0,0,,Đúng là một phép màu khi chúng tôi có thể sống sót trở về.
Dialogue: 0,0:16:56.28,0:16:57.74,main - italics,Kousuke(M),0,0,0,,Cả Ludie lẫn tôi...
Dialogue: 0,0:16:58.07,0:17:00.12,main,Kousuke,0,0,0,,Chính điều đó đã giúp tôi nhận ra.
Dialogue: 0,0:17:00.12,0:17:03.08,main,Kousuke,0,0,0,,Tôi muốn trở nên thật mạnh mẽ để có thể bảo vệ tất cả mọi người.
Dialogue: 0,0:17:03.08,0:17:05.62,main,Kousuke,0,0,0,,Đó chính là lý do tôi quyết tâm sẽ trở thành kẻ mạnh nhất.
Dialogue: 0,0:17:06.04,0:17:09.13,main - italics,Kousuke(M),0,0,0,,Phải, mạnh mẽ đến mức có thể dẫn lối toàn bộ các nữ chính của Magical Explorer
Dialogue: 0,0:17:09.13,0:17:11.21,main - italics,Kousuke(M),0,0,0,,tiến tới một cái kết có hậu viên mãn.
Dialogue: 0,0:17:11.59,0:17:16.18,main,Kousuke,0,0,0,,Và tôi luôn tính cả cô vào danh sách những người tôi muốn bảo vệ.
Dialogue: 0,0:17:16.93,0:17:21.60,main,Kousuke,0,0,0,,Ban đầu tôi cũng không biết phải đối phó thế nào\Nvới cô và thái độ của cô nữa.
Dialogue: 0,0:17:21.60,0:17:24.31,main,Kousuke,0,0,0,,Ý tôi là, cô thậm chí còn tự mang theo đồ bơi học sinh của mình nữa cơ mà.
Dialogue: 0,0:17:24.81,0:17:29.06,main,Kousuke,0,0,0,,Nhưng khi chúng ta có những cuộc trò chuyện ngớ ngẩn buồn cười\Nở nhà cũng như trong hầm ngục,
Dialogue: 0,0:17:29.06,0:17:30.27,main,Kousuke,0,0,0,,tôi luôn cảm thấy thực sự rất vui vẻ.
Dialogue: 0,0:17:31.02,0:17:33.94,main,Kousuke,0,0,0,,Tôi không biết cô cảm thấy thế nào về chuyện đó,
Dialogue: 0,0:17:33.94,0:17:37.53,main,Kousuke,0,0,0,,nhưng tôi thực sự rất trân trọng những màn đối đáp bông đùa ngớ ngẩn giữa hai chúng ta.
Dialogue: 0,0:17:38.57,0:17:40.53,main,Kousuke,0,0,0,,Cô ghét điều đó sao?
Dialogue: 0,0:17:40.53,0:17:42.29,main,Kousuke,0,0,0,,Cô chỉ đi cùng tôi
Dialogue: 0,0:17:42.29,0:17:44.29,main,Kousuke,0,0,0,,bởi vì bản giao kèo không cho cô sự lựa chọn nào khác sao?
Dialogue: 0,0:17:44.29,0:17:46.87,main,Nanami,0,0,0,,Tôi... không hề ghét điều đó.
Dialogue: 0,0:17:47.29,0:17:50.42,main,Nanami,0,0,0,,Chúng tôi làm việc trong hầm ngục, và chúng tôi chết trong hầm ngục.
Dialogue: 0,0:17:50.96,0:17:53.59,main,Nanami,0,0,0,,Đó là tất cả những gì tôi từng nghĩ về ý nghĩa tồn tại của một Hầu Gái Hầm Ngục.
Dialogue: 0,0:17:53.59,0:17:54.59,main,Nanami,0,0,0,,Nên là tôi...
Dialogue: 0,0:17:54.92,0:17:57.59,main,Kousuke,0,0,0,,Tôi luôn giữ vững niềm tin này.
Dialogue: 0,0:17:58.64,0:18:03.60,main,Kousuke,0,0,0,,Đúng vậy, cuộc sống có những quy tắc, nhưng cô có thể làm hầu như bất cứ điều gì mình muốn.
Dialogue: 0,0:18:04.02,0:18:05.64,main,Kousuke,0,0,0,,Cô có thể đi bất cứ nơi đâu mình muốn,
Dialogue: 0,0:18:05.64,0:18:07.19,main,Kousuke,0,0,0,,tận hưởng cuộc sống theo bất kỳ cách nào mình thích,
Dialogue: 0,0:18:07.19,0:18:08.85,main,Kousuke,0,0,0,,ăn bất cứ món gì mình thèm.
Dialogue: 0,0:18:09.27,0:18:12.07,main,Kousuke,0,0,0,,Tôi thậm chí còn muốn nói rằng nhận ra điều đó
Dialogue: 0,0:18:12.07,0:18:13.61,main,Kousuke,0,0,0,,và thực hiện nó mới chính là ý nghĩa đích thực của cuộc sống.
Dialogue: 0,0:18:13.94,0:18:15.74,main,Kousuke,0,0,0,,Có ít ranh giới và giới hạn hơn cô tưởng nhiều đấy.
Dialogue: 0,0:18:16.11,0:18:20.03,main,Kousuke,0,0,0,,Nên cô phải tự tìm ra cách để sống một cuộc đời trọn vẹn và tràn ngập niềm vui cho riêng mình.
Dialogue: 0,0:18:20.91,0:18:22.99,main,Kousuke,0,0,0,,Thế giới này là tự do.
Dialogue: 0,0:18:23.54,0:18:28.71,main,Kousuke,0,0,0,,Nếu ở bên cạnh tôi khiến cô cảm thấy đau khổ hay gò bó,
Dialogue: 0,0:18:28.71,0:18:30.17,main,Kousuke,0,0,0,,thì xin cô hãy hủy bỏ bản giao kèo đi.
Dialogue: 0,0:18:30.67,0:18:33.92,main,Kousuke,0,0,0,,Và sau đó hãy sống thật tự do!
Dialogue: 0,0:18:36.34,0:18:38.47,main,Kousuke,0,0,0,,Có cái khế ước thiên sứ gì đó đúng không?
Dialogue: 0,0:18:38.47,0:18:41.51,main,Kousuke,0,0,0,,Nếu thứ đó trói buộc cô và khiến cô không hạnh phúc,
Dialogue: 0,0:18:41.51,0:18:43.39,main,Kousuke,0,0,0,,thì xin cô hãy hủy bỏ nó ngay tại đây đi.
Dialogue: 0,0:18:43.76,0:18:47.60,main,Kousuke,0,0,0,,Nếu ở đây là điều khó khăn với cô, tôi không cần bản giao kèo đó nữa đâu.
Dialogue: 0,0:18:48.02,0:18:50.10,main,Kousuke,0,0,0,,Tôi chỉ đơn giản muốn cô được làm những gì mình muốn thôi.
Dialogue: 0,0:18:51.69,0:18:54.36,main,Kousuke,0,0,0,,Cô có thể đến sống ở một nơi khác cùng ai đó.
Dialogue: 0,0:18:54.90,0:18:56.94,main,Kousuke,0,0,0,,Cô có thể tự lập sống một mình.
Dialogue: 0,0:18:57.44,0:18:59.45,main,Kousuke,0,0,0,,Nếu cô vẫn muốn tiếp tục làm một hầu gái,
Dialogue: 0,0:18:59.45,0:19:01.66,main,Kousuke,0,0,0,,cô có thể đi làm việc cho một người khác.
Dialogue: 0,0:19:02.20,0:19:03.74,main,Kousuke,0,0,0,,Tôi sẽ chu cấp hỗ trợ cho cô cho tới khi cô hoàn toàn tự lập!
Dialogue: 0,0:19:05.12,0:19:07.16,main,Kousuke,0,0,0,,Về góc độ cá nhân...
Dialogue: 0,0:19:07.16,0:19:10.00,main,Kousuke,0,0,0,,Tôi không nghĩ mình có thể trả cho cô mức lương hậu hĩnh đến thế...
Dialogue: 0,0:19:10.33,0:19:12.96,main,Kousuke,0,0,0,,Nhưng nếu phải nói thật lòng, tôi vẫn muốn cô ở lại bên cạnh tôi...
Dialogue: 0,0:19:13.46,0:19:14.84,main,Kousuke,0,0,0,,Nhưng tôi muốn cô hiểu điều này!
Dialogue: 0,0:19:14.84,0:19:17.42,main,Kousuke,0,0,0,,Khoảng thời gian ở bên cô vô cùng quan trọng đối với tôi!
Dialogue: 0,0:19:17.84,0:19:21.59,main,Kousuke,0,0,0,,Và tôi rất muốn có sự giúp đỡ của cô trên con đường trở thành kẻ mạnh nhất,
Dialogue: 0,0:19:21.59,0:19:24.97,main,Kousuke,0,0,0,,nhưng mà... tôi không hề muốn ép buộc cô...
Dialogue: 0,0:19:28.85,0:19:32.73,main,Nanami,0,0,0,,Tôi vừa mới phát hiện ra một khiếm khuyết cực kỳ to lớn của ngài rồi đấy.
Dialogue: 0,0:19:32.73,0:19:33.69,main,Kousuke,0,0,0,,Một khiếm khuyết ư?
Dialogue: 0,0:19:34.11,0:19:39.07,main,Nanami,0,0,0,,Vâng. Nó vừa là nguồn gốc sức mạnh của ngài, mà cũng là một điểm yếu to đùng đoàng.
Dialogue: 0,0:19:39.32,0:19:43.78,main,Nanami,0,0,0,,Đó là một lỗ hổng khổng lồ đến mức không thể nào trám lại được. Nó toang hoác ra kìa.
Dialogue: 0,0:19:43.78,0:19:46.78,main,Nanami,0,0,0,,Tôi thậm chí còn chẳng hiểu sao ngài lại có thể tạo ra một lỗ hổng to đùng đến thế.
Dialogue: 0,0:19:47.04,0:19:48.95,main,Kousuke,0,0,0,,Tôi có một lỗ hổng như thế sao?
Dialogue: 0,0:19:48.95,0:19:50.08,main,Nanami,0,0,0,,Vâng, đúng là ngài có đấy.
Dialogue: 0,0:19:50.08,0:19:55.04,main,Nanami,0,0,0,,Lỗ hổng đó to đến mức ngài chẳng còn lựa chọn nào khác ngoài việc từ bỏ giấc mơ của mình.
Dialogue: 0,0:19:55.59,0:19:57.13,main,Nanami,0,0,0,,Nhưng cứ giao chuyện này cho tôi.
Dialogue: 0,0:19:59.46,0:20:02.09,main,Nanami,0,0,0,,Tôi sẽ lấp đầy cái lỗ hổng đó cho ngài.
Dialogue: 0,0:20:02.09,0:20:04.05,main,Nanami,0,0,0,,Tôi sẽ luôn ở bên hỗ trợ ngài.
Dialogue: 0,0:20:04.80,0:20:09.52,main,Nanami,0,0,0,,À, vừa rồi ngài có nói về chuyện hủy bỏ giao kèo đúng không.
Dialogue: 0,0:20:10.10,0:20:11.48,main,Nanami,0,0,0,,Tôi sẽ tuyệt đối không bao giờ làm điều đó đâu.
Dialogue: 0,0:20:12.69,0:20:17.90,main,Nanami,0,0,0,,Không, dù bất cứ ai có nói gì đi nữa, tôi cũng sẽ không bao giờ hủy bỏ nó.
Dialogue: 0,0:20:17.90,0:20:19.15,main,Nanami,0,0,0,,Ngài có biết không?
Dialogue: 0,0:20:19.15,0:20:21.86,main,Nanami,0,0,0,,Một khi đã trang bị Nanami lên người rồi,\Nngài sẽ không thể nào tháo gỡ tôi ra được đâu.
Dialogue: 0,0:20:22.32,0:20:24.78,main,Nanami,0,0,0,,Kể cả ngài có muốn, ngài cũng không thể nào tống khứ tôi đi được.
Dialogue: 0,0:20:26.16,0:20:28.95,main,Kousuke,0,0,0,,Không thể tháo gỡ sao? Cô là cái loại trang bị bị nguyền rủa đấy à?
Dialogue: 0,0:20:28.95,0:20:30.50,main,Nanami,0,0,0,,Ngài đang nói cái gì thế ạ?
Dialogue: 0,0:20:30.50,0:20:32.29,main,Nanami,0,0,0,,Tôi là một thiên sứ cơ mà.
Dialogue: 0,0:20:32.29,0:20:35.42,main,Nanami,0,0,0,,Điều đó có nghĩa là ngài đang được ban phước lành đấy.
Dialogue: 0,0:20:35.42,0:20:36.29,main,Kousuke,0,0,0,,Nghe có lý phết nhỉ!
Dialogue: 0,0:20:41.01,0:20:42.22,sign_33231_357_Tsukuyomi_Magic_,sign,0,0,0,,{\frz60.19\pos(77,172)}Học Viện Ma Pháp Tsukuyomi
Dialogue: 0,0:20:41.01,0:20:42.22,sign_33231_358_Registration_of_,sign,0,0,0,,{\frz62.43\pos(190,129)}Đơn Đăng Ký Nhập Học
Dialogue: 0,0:20:41.01,0:20:42.22,main,Marino,0,0,0,,Của hai đứa đây.
Dialogue: 0,0:20:41.92,0:20:42.22,sign_33231_357_Tsukuyomi_Magic_,sign,0,0,0,,{\3c&HDBDBDB&\c&HFFFDFD&\frz59.25\pos(392,101)}Thẻ Học Sinh
Dialogue: 0,0:20:43.22,0:20:45.26,main,Marino,0,0,0,,Xin lỗi vì đã để hai đứa đợi lâu nhé.
Dialogue: 0,0:20:45.26,0:20:46.47,main,Kousuke,0,0,0,,Đơn Đăng Ký Nhập Học sao ạ?
Dialogue: 0,0:20:46.47,0:20:50.47,sign_33231_357_Tsukuyomi_Magic_,sign,0,0,0,,{\fs12\c&H350002&\pos(124,93)\frz20.05}Học Viện Ma Pháp Tsukuyomi
Dialogue: 0,0:20:46.47,0:20:50.47,sign_33231_358_Registration_of_,sign,0,0,0,,{\frz22.77\pos(380,149)}Đơn Đăng Ký Nhập Học
Dialogue: 0,0:20:46.47,0:20:50.47,sign_33231_358_Registration_of_,sign,0,0,0,,{\b0\c&H323235&\pos(487,204)\frz22.2}Người Giám Hộ {\b1}Hanamura Marino
Dialogue: 0,0:20:46.47,0:20:50.47,sign_33231_358_Registration_of_,sign,0,0,0,,{\frz23.96\pos(567,295)}Nanami
Dialogue: 0,0:20:47.10,0:20:50.47,main,Nanami,0,0,0,,Giờ thì tôi đã có thể chính thức đến trường cùng ngài rồi thưa Chủ nhân.
Dialogue: 0,0:20:51.10,0:20:53.98,main,Nanami,0,0,0,,Trời ạ, đừng có tỏ ra vui sướng tột cùng đến mức thế chứ.
Dialogue: 0,0:20:53.98,0:20:55.98,main,Kousuke,0,0,0,,Ý tôi là, nếu phải chọn giữa vui vẻ và buồn rầu,
Dialogue: 0,0:20:55.98,0:20:57.44,main,Kousuke,0,0,0,,đương nhiên là tôi vui rồi.
Dialogue: 0,0:20:57.44,0:20:58.69,main,Kousuke,0,0,0,,Nhưng tôi cũng có chút lo lắng.
Dialogue: 0,0:20:58.69,0:21:01.32,main,Kousuke,0,0,0,,Hiện tại mọi người có vẻ khá ác cảm và thù địch với tôi.
Dialogue: 0,0:21:01.32,0:21:03.82,main,Marino,0,0,0,,Đó là tại vì em chẳng chịu lên lớp đi học đàng hoàng đấy thôi.
Dialogue: 0,0:21:03.82,0:21:08.74,main,Kousuke,0,0,0,,Chà, xét đến những gì sắp tới thì mọi chuyện cứ như bây giờ là ổn rồi.
Dialogue: 0,0:21:08.74,0:21:11.79,main,Marino,0,0,0,,Những gì sắp tới ư? Ý em là Tam Đại Ủy Ban sao?
Dialogue: 0,0:21:12.70,0:21:18.17,main,Nanami,0,0,0,,Dù nó là gì đi nữa, tôi sẽ không bao giờ rời xa ngài đâu.
Dialogue: 0,0:21:18.17,0:21:21.80,main,Nanami,0,0,0,,Tôi chẳng cần quan tâm mấy cái lũ sâu bọ lêu nghêu đó nói gì với tôi cả,
Dialogue: 0,0:21:21.80,0:21:23.13,main,Nanami,0,0,0,,tôi sẽ tiêu diệt sạch bọn chúng.
Dialogue: 0,0:21:23.13,0:21:26.30,main,Kousuke,0,0,0,,Tôi nghĩ cô có quan tâm đấy nếu cô định đi xa tới mức tiêu diệt sạch bọn họ.
Dialogue: 0,0:21:26.30,0:21:30.39,main,Nanami,0,0,0,,Đó chỉ là trò đùa thôi mà, và tôi đoan chắc với ngài là tôi chẳng quan tâm tí nào đâu.
Dialogue: 0,0:21:30.39,0:21:35.14,main,Marino,0,0,0,,Vậy Kou-chan này, em có phiền không nếu nói cho chị biết em đang tính làm gì?
Dialogue: 0,0:21:39.98,0:21:44.99,sign_33231_358_Registration_of_,sign,0,0,0,,{\fs22\pos(201,51)}Và Kể Từ {\c&H7F00D5&}Đoạn Này...
Dialogue: 0,0:21:45.53,0:21:50.03,main - italics,Nanami(M),0,0,0,,Lần đầu tiên gặp gỡ Chủ nhân, tôi đã hoàn toàn chết lặng vì kinh ngạc.
Dialogue: 0,0:21:50.87,0:21:56.04,main - italics,Nanami(M),0,0,0,,Bởi vì thông thường, con người không thể nào lập khế ước với các Hiệp Sĩ Hầu Gái.
Dialogue: 0,0:21:56.46,0:22:00.00,main,Kousuke,0,0,0,,Tôi nghĩ là mình đã dẫn cô đi xem hết những địa điểm quan trọng rồi đấy.
Dialogue: 0,0:22:00.59,0:22:02.96,main,Nanami,0,0,0,,Cảm ơn ngài rất nhiều thưa Chủ nhân.
Dialogue: 0,0:22:03.42,0:22:06.30,main,Nanami,0,0,0,,Nhưng tôi không bao giờ muốn rời xa ngài đâu,
Dialogue: 0,0:22:06.30,0:22:09.93,main,Nanami,0,0,0,,nên nếu có phải đi bất cứ đâu, chúng ta sẽ cùng đi bên nhau.
Dialogue: 0,0:22:10.51,0:22:12.72,main,Kousuke,0,0,0,,Một điều khác tôi muốn nói cho cô biết là...
Dialogue: 0,0:22:13.43,0:22:18.06,main,Kousuke,0,0,0,,Nanami, phía trước có vài người thú vị kìa.
Dialogue: 0,0:22:14.93,0:22:17.23,main - top,Shion,0,0,0,,Đúng vậy đấy.
Dialogue: 0,0:22:18.90,0:22:20.10,main,Shion,0,0,0,,Ồ, nhìn xem ai đây này.
Dialogue: 0,0:22:20.10,0:22:22.48,main,Shion,0,0,0,,Chẳng phải là người yêu quý của Yukine đó sao.
Dialogue: 0,0:22:22.90,0:22:26.03,main,Shion,0,0,0,,Mọi chuyện đã phát triển theo một hướng khá thú vị rồi đấy nhỉ?
Dialogue: 0,0:22:26.03,0:22:27.49,main,Fran,0,0,0,,Hóa ra cậu ta là người đó sao?
Dialogue: 0,0:22:27.49,0:22:30.53,main,Fran,0,0,0,,Takioto Kousuke và... Ừm, cô kia...
Dialogue: 0,0:22:31.03,0:22:32.28,main,Fran,0,0,0,,Tại sao cô lại mặc trang phục hầu gái thế?
Dialogue: 0,0:22:32.28,0:22:33.41,main,Fran,0,0,0,,Đồng phục của cô đâu rồi?
Dialogue: 0,0:22:33.41,0:22:34.74,main,Nanami,0,0,0,,Đây chính là đồng phục hầu gái mà.
Dialogue: 0,0:22:34.74,0:22:37.12,main,Fran,0,0,0,,Nhưng đây là học viện cơ mà.
Dialogue: 0,0:22:38.00,0:22:39.62,main,Shion,0,0,0,,Ôi dào, chúng ta có thể châm chước bỏ qua chuyện đó được mà.
Dialogue: 0,0:22:39.62,0:22:42.46,main,Kousuke,0,0,0,,Không cần phải lo lắng đâu, chúng tôi đã được cấp phép rồi.
Dialogue: 0,0:22:42.46,0:22:46.17,main,Nanami,0,0,0,,Thưa Chủ nhân, liệu đây có phải là những ứng cử viên vợ tương lai tiếp theo không ạ?
Dialogue: 0,0:22:46.17,0:22:49.68,main,Kousuke,0,0,0,,Không đời nào! Cô coi tôi là cái thứ người gì thế hả?!
Dialogue: 0,0:22:49.68,0:22:51.01,main,Nanami,0,0,0,,Xin ngài thứ lỗi cho tôi.
Dialogue: 0,0:22:51.01,0:22:53.47,main,Nanami,0,0,0,,Tôi sẽ không đùa nữa đâu ạ.
Dialogue: 0,0:22:54.89,0:22:58.60,main - italics,Nanami(M),0,0,0,,Tôi làm việc trong hầm ngục và tôi chết trong hầm ngục.
Dialogue: 0,0:22:58.60,0:23:00.73,main - italics,Nanami(M),0,0,0,,Đó là tất cả ý nghĩa cuộc sống của tôi với tư cách là một Hiệp Sĩ Hầu Gái.
Dialogue: 0,0:23:01.40,0:23:05.69,main - italics,Nanami(M),0,0,0,,Thế nhưng, Chủ nhân lại cố gắng mang lại tự do cho tôi.
Dialogue: 0,0:23:06.48,0:23:08.74,main - italics,Nanami(M),0,0,0,,Chính vì vậy, tôi sẽ sống một cuộc đời thật tự do.
Dialogue: 0,0:23:09.15,0:23:10.61,main - italics,Nanami(M),0,0,0,,Tôi sẽ cống hiến toàn bộ bản thân mình vì ngài,
Dialogue: 0,0:23:10.61,0:23:13.83,main - italics,Nanami(M),0,0,0,,vì một vị Chủ nhân luôn quan tâm quá nhiều đến người khác
Dialogue: 0,0:23:13.83,0:23:15.74,main - italics,Nanami(M),0,0,0,,và sẵn sàng hy sinh chính mình trong quá trình đó.
Dialogue: 0,0:23:17.16,0:23:19.46,main - italics,Nanami(M),0,0,0,,Dù số lượng vợ tương lai có tăng lên bao nhiêu đi chăng nữa,
Dialogue: 0,0:23:19.46,0:23:22.38,main - italics,Nanami(M),0,0,0,,dù cho họ có là những chiến binh hùng mạnh đến nhường nào,
Dialogue: 0,0:23:22.38,0:23:24.17,main - italics,Nanami(M),0,0,0,,tôi cũng sẽ không bao giờ nhường lại vị trí của mình đâu.
Dialogue: 0,0:23:24.67,0:23:26.67,main - italics,Nanami(M),0,0,0,,Bởi vì đây chính là nơi tôi thuộc về.
Dialogue: 0,0:23:27.42,0:23:31.88,main,Nanami,0,0,0,,Tôi phụng sự Chủ nhân của mình, người luôn nỗ lực để trở thành kẻ mạnh nhất thế gian.
Dialogue: 0,0:23:32.30,0:23:35.10,main,Nanami,0,0,0,,Tôi là cô hầu gái sở hữu vẻ đẹp nghiêng nước nghiêng thành Nanami.
Dialogue: 0,0:23:36.35,0:23:38.27,main,Nanami,0,0,0,,Rất hân hạnh được diện kiến các vị.
Comment: 0,0:00:00.02,0:00:00.02,main,,0,0,0,,

