Dialogue: 0,0:00:06.33,0:00:08.82,Default,Kousuke(M),0,0,0,,{\i1}Một khi đã chuyển sinh thành nhân vật bạn thân\Ncủa nam chính trong một tựa game eroge,
Dialogue: 0,0:00:08.82,0:00:12.04,Default,Kousuke(M),0,0,0,,{\i1}và đã hạ quyết tâm sẽ dẫn dắt tất cả mọi người\Nđến với một kết cục có hậu (Happy Ending),
Dialogue: 0,0:00:12.04,0:00:13.88,Default,Kousuke(M),0,0,0,,{\i1}thì có một việc tối quan trọng mà mình bắt buộc phải làm.
Dialogue: 0,0:00:14.20,0:00:17.57,Default,Kousuke(M),0,0,0,,{\i1}Đó chính là phải trở nên mạnh mẽ\Ncàng nhanh càng tốt.
Dialogue: 0,0:00:18.14,0:00:20.85,Default,Kousuke(M),0,0,0,,{\i1}Trong MagiEx, có những sự kiện bị giới hạn thời gian.
Dialogue: 0,0:00:21.25,0:00:28.49,Default,Kousuke(M),0,0,0,,{\i1}Mình tuyệt đối không được phép tiến bộ quá chậm chạp\Nđể rồi không kịp cứu giúp các nữ chính.
Dialogue: 0,0:00:29.09,0:00:32.16,Default,Kousuke(M),0,0,0,,{\i1}Vậy thì, đâu là phương pháp tốt nhất\Nđể rèn luyện bản thân?
Dialogue: 0,0:00:32.16,0:00:33.50,Default,Kousuke(M),0,0,0,,{\i1}Có rất nhiều giả thuyết được đưa ra,
Dialogue: 0,0:00:33.50,0:00:38.08,Default,Kousuke(M),0,0,0,,{\i1}nhưng tất cả đều có chung một điểm:\Nđi solo một mình là hạ sách.
Dialogue: 0,0:00:38.91,0:00:41.64,Default,Kousuke(M),0,0,0,,{\i1}Đó là lý do vì sao lúc này mình lại có mặt ở Hang Động Hoàng Hôn,
Dialogue: 0,0:00:41.64,0:00:45.03,Default,Kousuke(M),0,0,0,,{\i1}một hầm ngục chỉ dành riêng cho việc đi solo\Nđược thêm vào trong bản cập nhật quà tặng
Dialogue: 0,0:00:45.03,0:00:47.12,Default,Kousuke(M),0,0,0,,{\i1}dành cho đợt phát hành đầu tiên của game.
Dialogue: 0,0:00:49.80,0:00:51.96,Default,Kousuke(M),0,0,0,,{\i1}Mình đã mang theo đầy đủ phù thạch ma pháp hệ thủy.
Dialogue: 0,0:00:51.96,0:00:54.26,Default,Kousuke(M),0,0,0,,{\i1}Bình thuốc hồi phục cũng đã chuẩn bị xong,
Dialogue: 0,0:00:54.26,0:00:56.67,Default,Kousuke(M),0,0,0,,{\i1}và chiếc khăn choàng cũng đã được yểm ma pháp thủy hoàn tất.
Dialogue: 0,0:01:13.85,0:01:16.57,Default,Kousuke,0,0,0,,Bắt đầu thôi nào...
Dialogue: 0,0:01:19.78,0:01:21.45,Default,Kousuke,0,0,0,,để trở thành kẻ mạnh nhất!
Dialogue: 0,0:02:53.98,0:02:56.86,Flashback,Yukine,0,0,0,,Ngoài chiếc khăn choàng ra thì nên dùng thêm vũ khí gì ư?
Dialogue: 0,0:02:56.86,0:03:00.49,Flashback,Kousuke,0,0,0,,Em từng tính đến việc mang theo khiên,
Dialogue: 0,0:03:00.49,0:03:02.32,Flashback,Kousuke,0,0,0,,nhưng cảm giác nó không thực sự vừa tay cho lắm.
Dialogue: 0,0:03:02.32,0:03:04.07,Flashback,Yukine,0,0,0,,Theo góc nhìn của chị,
Dialogue: 0,0:03:04.07,0:03:08.12,Flashback,Yukine,0,0,0,,em nên chọn một loại vũ khí mà em đã dùng thử\Nvà cảm thấy dễ dàng thuần thục nhất.
Dialogue: 0,0:03:08.12,0:03:12.37,Flashback,Kousuke,0,0,0,,Nghĩa là em nên thử qua tất cả các loại vũ khí ạ?
Dialogue: 0,0:03:12.58,0:03:14.13,Flashback,Yukine,0,0,0,,Ừm, đúng hướng rồi đấy.
Dialogue: 0,0:03:14.13,0:03:14.88,Flashback,Yukine,0,0,0,,Tuy nhiên...
Dialogue: 0,0:03:15.13,0:03:18.05,Flashback,Yukine,0,0,0,,Katana và trường đao Naginata là những vũ khí tuyệt vời,
Dialogue: 0,0:03:18.05,0:03:19.55,Flashback,Yukine,0,0,0,,chúng cực kỳ dễ dàng truyền dẫn ma lực vào bên trong.
Dialogue: 0,0:03:19.55,0:03:20.84,Flashback,Yukine,0,0,0,,Nên đó là gợi ý hàng đầu của chị dành cho em!
Dialogue: 0,0:03:21.59,0:03:23.09,Flashback,Yukine,0,0,0,,Hơn nữa em lại đã học được kỹ năng Tâm Nhãn (Mind's Eye),
Dialogue: 0,0:03:23.09,0:03:25.60,Flashback,Yukine,0,0,0,,lại còn sở hữu cả Cánh Tay Thứ Ba và Cánh Tay Thứ Tư,
Dialogue: 0,0:03:25.60,0:03:27.56,Flashback,Yukine,0,0,0,,chị tin chắc rằng em hoàn toàn có thể\Nphát huy tối đa 100% tiềm năng của thanh Katana
Dialogue: 0,0:03:27.56,0:03:30.39,Flashback,Yukine,0,0,0,,mà không hề chịu bất kỳ một nhược điểm nào cả.
Dialogue: 0,0:03:30.39,0:03:31.52,Flashback,Yukine,0,0,0,,Em thấy thế nào?!
Dialogue: 0,0:03:33.35,0:03:36.36,Flashback,Kousuke,0,0,0,,D-Dạ vâng, thế thì em sẽ dùng thử Katana xem sao ạ.
Dialogue: 0,0:03:41.99,0:03:43.53,Flashback,Yukine,0,0,0,,Chị biết thế nào ngày này cũng sẽ tới mà,
Dialogue: 0,0:03:43.53,0:03:44.82,Flashback,Yukine,0,0,0,,nên chị đã chuẩn bị sẵn từ trước rồi đây.
Dialogue: 0,0:03:45.87,0:03:50.04,Default,Kousuke(M),0,0,0,,{\i1}Chị ấy đã nói như thế khi trao cho mình thanh kiếm này.
Dialogue: 0,0:03:50.04,0:03:52.96,Default,Kousuke(M),0,0,0,,{\i1}Sau đó, mình đã bị chị ấy 'bón hành' cho tơi bời hoa lá...
Dialogue: 0,0:04:10.43,0:04:12.56,Default,Kousuke,0,0,0,,Đ-Đáng sợ quá đi mất...
Dialogue: 0,0:04:37.46,0:04:41.67,Default,Kousuke,0,0,0,,Mình đã khổ luyện thể lực và vung kiếm\Ncho khoảnh khắc này suốt từng ngày từng giờ.
Dialogue: 0,0:04:43.38,0:04:46.14,Default,Kousuke,0,0,0,,Dẫu cho mình không có chút thiên phú nào về kiếm thuật,
Dialogue: 0,0:04:46.72,0:04:49.51,Default,Kousuke,0,0,0,,thì mình nhất định cũng phải thành thục tuyệt kỹ duy nhất này.
Dialogue: 0,0:04:52.27,0:04:55.02,Default,Kousuke(M),0,0,0,,{\i1}Cư Hợp Kiếm Thuật {\fnSegoe UI Symbol}─{\fnGandhi Sans}Thiểm Quang (Flash){\fnSegoe UI Symbol}─{\fnGandhi Sans}!
Dialogue: 0,0:05:20.04,0:05:21.34,Default,Kousuke,0,0,0,,Oa.
Dialogue: 0,0:05:21.34,0:05:23.30,Default,Kousuke,0,0,0,,Đẹp thật đấy.
Dialogue: 0,0:05:23.30,0:05:26.43,Default,Kousuke,0,0,0,,Giờ thì mình đã hiểu tại sao nơi này\Nlại được gọi là Nấc Thang Thiên Thần rồi.
Dialogue: 0,0:05:29.85,0:05:31.68,Default,Kousuke,0,0,0,,Chỉ có duy nhất một chỗ kia là không mọc cỏ.
Dialogue: 0,0:05:36.73,0:05:39.44,Default,Kousuke,0,0,0,,Trông có vẻ hơi khác so với trong game,
Dialogue: 0,0:05:40.40,0:05:42.15,Default,Kousuke,0,0,0,,nhưng chắc chắn là chỗ này rồi đúng không?
Dialogue: 0,0:05:42.73,0:05:46.53,Default,Kousuke(M),0,0,0,,{\i1}Trong MagiEx, nó là một viên ngọc phong ấn\Ntrông tựa như pha lê.
Dialogue: 0,0:05:46.95,0:05:48.91,Default,Kousuke,0,0,0,,Oa, mềm mại bồng bềnh như kẹo bông vậy.
Dialogue: 0,0:05:55.79,0:05:59.00,Default,Kousuke(M),0,0,0,,{\i1}Nhân vật chính đã truyền một lượng ma lực vào trong này.
Dialogue: 0,0:06:01.46,0:06:03.34,Default,Kousuke(M),0,0,0,,{\i1}Nhờ vào việc khổ luyện hàng ngày,
Dialogue: 0,0:06:03.34,0:06:05.84,Default,Kousuke(M),0,0,0,,{\i1}lượng ma lực của mình đã gia tăng một cách đáng kinh ngạc.
Dialogue: 0,0:06:05.84,0:06:07.47,Default,Kousuke(M),0,0,0,,{\i1}Để mở rộng dung lượng ma lực tối đa,
Dialogue: 0,0:06:07.47,0:06:09.84,Default,Kousuke(M),0,0,0,,{\i1}mình đã duy trì trạng thái yểm ma lực lên khăn choàng\Nsuốt 24/7, trừ những lúc đi ngủ.
Dialogue: 0,0:06:09.84,0:06:11.26,Default,Kousuke(M),0,0,0,,{\i1}Và trong các buổi chạy bộ hay đấu tập,
Dialogue: 0,0:06:11.26,0:06:13.39,Default,Kousuke(M),0,0,0,,{\i1}mình luôn vắt kiệt ma lực tới giới hạn tột cùng.
Dialogue: 0,0:06:13.89,0:06:17.10,Default,Kousuke(M),0,0,0,,{\i1}Đáng lẽ lượng ma lực hiện tại của mình\Nphải ở mức khủng bố lắm rồi chứ...
Dialogue: 0,0:06:18.39,0:06:20.65,Default,Kousuke(M),0,0,0,,{\i1}Vậy mà vẫn chưa đủ sao?
Dialogue: 0,0:06:20.94,0:06:22.52,Default,Kousuke(M),0,0,0,,{\i1}Nguy rồi! Như vậy có nghĩa là...
Dialogue: 0,0:06:30.95,0:06:33.70,Default,System,0,0,0,,{\i1}Đã ghi nhận ma lực thành công.
Dialogue: 0,0:06:36.75,0:06:37.96,Default,Kousuke,0,0,0,,Mình chẳng đọc được chữ nào cả...
Dialogue: 0,0:06:38.87,0:06:41.04,Default,System,0,0,0,,{\i1}Xin vui lòng lựa chọn hình thái.
Dialogue: 0,0:06:37.96,0:06:42.42,sign_Arial,TEXT,0,0,0,,{\an8\c&HF8FFF0&\bord0\shad0\pos(318.67,228)\fs28}Xin vui lòng lựa chọn hình thái
