Dialogue: 0,0:00:00.61,0:00:02.25,flashback,NOELLE,0,0,0,,Bọn ta đã không hề bỏ cuộc!
Dialogue: 0,0:00:02.86,0:00:06.49,flashback,NOELLE,0,0,0,,Đó chính là lý do bọn ta chiến thắng trận này đấy, Megicula!
Dialogue: 0,0:00:07.80,0:00:14.44,flashback,MEGICULA,0,0,0,,Xem ra ta đã đánh giá thấp…\Nsức mạnh thực sự của các ngươi rồi.
Dialogue: 0,0:00:20.58,0:00:24.58,flashback,ACIER,0,0,0,,Hai đứa… đã trưởng thành và mạnh mẽ lên nhiều quá rồi.
Dialogue: 0,0:01:59.57,0:02:04.94,Ep Title,EPISODE TITLE,0,0,0,,{\pos(321,100)\c&HF7F8FF&}Trái Tim Ác Ma
Dialogue: 0,0:02:26.04,0:02:28.29,main,ASTA,0,0,0,,Noelle! Cô làm được rồi!
Dialogue: 0,0:02:28.68,0:02:30.17,main,NOELLE,0,0,0,,Asta! Loropechika!
Dialogue: 0,0:02:31.20,0:02:34.26,main,NOELLE,0,0,0,,Chúng ta đánh bại được Megicula rồi, vậy là\Nlời nguyền trên người Loropechika hẳn cũng…
Dialogue: 0,0:02:39.62,0:02:42.74,main,ASTA,0,0,0,,Ồ! Nữ vương Loropechika! Người tỉnh lại rồi ạ?!
Dialogue: 0,0:02:46.32,0:02:49.19,main,LOROPECHIKA,0,0,0,,Tôi xin lỗi! Tôi xin lỗi nhiều lắm!\NXin lỗi vì đang khỏa thân thế này!
Dialogue: 0,0:02:49.19,0:02:52.07,main,ASTA,0,0,0,,Đừng lo lắng! Tôi không nhìn thấy gì hết trơn!
Dialogue: 0,0:02:52.07,0:02:54.60,main,NOELLE,0,0,0,,Cậu làm cái quái gì thế hả, Ngốc Asta?!
Dialogue: 0,0:02:54.60,0:02:56.82,main,ASTA,0,0,0,,Khoan đã, tôi có làm gì đâu cơ chứ!
Dialogue: 0,0:02:57.65,0:02:58.78,main,NOELLE,0,0,0,,Loropechika!
Dialogue: 0,0:03:00.28,0:03:02.16,main,NOELLE,0,0,0,,May quá, cậu vẫn còn sống rồi!
Dialogue: 0,0:03:02.16,0:03:04.66,main,SMALL UNDINE,0,0,0,,Loropechika ơi!
Dialogue: 0,0:03:04.66,0:03:07.75,main,LOROPECHIKA,0,0,0,,Noelle… Undine…
Dialogue: 0,0:03:08.18,0:03:10.42,main,ASTA,0,0,0,,Sao tự dưng đánh tôi thế hả, Noelle?!
Dialogue: 0,0:03:10.69,0:03:13.44,main,NOELLE,0,0,0,,Im đi, Ngốc Asta! Tất cả là tại cậu cứ…
Dialogue: 0,0:03:16.20,0:03:17.37,italics,NOELLE (INT),0,0,0,,Mình phải làm sao bây giờ?
Dialogue: 0,0:03:17.37,0:03:19.74,italics,NOELLE (INT),0,0,0,,Lâu lắm rồi mới gặp lại cậu ấy,\Nmình thấy vui lắm chứ bộ, nhưng mà…
Dialogue: 0,0:03:19.74,0:03:20.81,main,ASTA,0,0,0,,Noelle sao thế?
Dialogue: 0,0:03:20.81,0:03:24.60,italics,NOELLE (INT),0,0,0,,Mình ngại đến mức thậm chí\Nchẳng dám nhìn thẳng vào mắt cậu ấy nữa!
Dialogue: 0,0:03:23.12,0:03:24.60,top,ASTA,0,0,0,,Này, Noelle ơi?
Dialogue: 0,0:03:24.60,0:03:28.02,main,NOELLE,0,0,0,,Không có gì hết, Ngốc Asta!
Dialogue: 0,0:03:31.90,0:03:34.18,italics,NOZEL (INT),0,0,0,,Lời nguyền đã được hóa giải…
Dialogue: 0,0:03:34.18,0:03:37.76,italics,NOZEL (INT),0,0,0,,nhưng mình chẳng biết phải đối diện\Nvới Noelle như thế nào nữa.
Dialogue: 0,0:03:37.76,0:03:39.53,main,NOELLE,0,0,0,,Anh Nozel?
Dialogue: 0,0:03:39.53,0:03:45.29,main,RILL,0,0,0,,Tôi xin lỗi, Charlotte. Ma pháp của tôi\Nsắp hết hiệu lực mất rồi.
Dialogue: 0,0:03:45.94,0:03:49.18,italics,RILL (INT),0,0,0,,Rốt cuộc mình vẫn chưa thể hoàn thành\Ntuyệt tác đỉnh cao nhất đời mình.
Dialogue: 0,0:03:49.68,0:03:52.18,italics,RILL (INT),0,0,0,,Có lẽ tuyệt tác đỉnh cao ấy của mình chính là…
Dialogue: 0,0:03:52.18,0:03:54.17,main,CHARLOTTE,0,0,0,,Sao cậu lại phải xin lỗi chứ, Rill?
Dialogue: 0,0:03:54.85,0:03:57.29,main,CHARLOTTE,0,0,0,,Nhờ có cậu mà tôi mới có thể\Ntiếp tục chiến đấu đến tận lúc này.
Dialogue: 0,0:03:58.33,0:03:59.55,main,CHARLOTTE,0,0,0,,Vậy nên cảm ơn cậu nhiều lắm.
Dialogue: 0,0:04:01.14,0:04:02.22,main,CHARLOTTE,0,0,0,,Huống chi là…
Dialogue: 0,0:04:02.64,0:04:06.88,main,CHARLOTTE,0,0,0,,Chúng ta đâu thể chết ngay lúc này được. Đúng chứ?
Dialogue: 0,0:04:08.98,0:04:10.81,main,LUCK,0,0,0,,Này!
Dialogue: 0,0:04:11.17,0:04:12.14,main,NOELLE,0,0,0,,Luck!
Dialogue: 0,0:04:12.14,0:04:13.97,main,LUCK,0,0,0,,Đỉnh quá trời luôn, Noelle.
Dialogue: 0,0:04:13.97,0:04:16.74,main,LUCK,0,0,0,,Cô hạ gục được cả Ác ma Tối thượng luôn đấy.
Dialogue: 0,0:04:22.28,0:04:24.90,main,LUCK,0,0,0,,Tôi cũng không thể lãng phí thời gian được.
Dialogue: 0,0:04:25.65,0:04:26.79,main,LOROPECHIKA,0,0,0,,Gaja!
Dialogue: 0,0:04:26.79,0:04:28.41,main,GAJA,0,0,0,,Nữ vương Loropechika.
Dialogue: 0,0:04:29.00,0:04:30.54,main,GAJA,0,0,0,,May quá Người vẫn an t—
Dialogue: 0,0:04:37.34,0:04:38.28,main,NOELLE,0,0,0,,Gaja!
Dialogue: 0,0:04:40.25,0:04:42.78,main,NOELLE,0,0,0,,Đoàn trưởng Charlotte! Đoàn trưởng Rill!
Dialogue: 0,0:04:46.45,0:04:49.65,italics,LOROPECHIKA (INT),0,0,0,,Thủy Hồi Phục Ma Pháp: Aquenelle Lore.
Dialogue: 0,0:04:53.76,0:04:58.09,italics,LOROPECHIKA (INT),0,0,0,,Ma pháp của mình… không thể chữa lành những vết thương này!
Dialogue: 0,0:04:58.81,0:05:04.42,main,LOROPECHIKA,0,0,0,,Không… Họ vừa cứu sống mình… vậy mà mình lại… mình…
Dialogue: 0,0:05:05.13,0:05:08.23,italics,ASTA (INT),0,0,0,,Diệt Ma Kiếm của mình chẳng làm gì được\Nvới những vết thương này cả!
Dialogue: 0,0:05:08.23,0:05:10.83,main,ASTA,0,0,0,,Chết tiệt! Mình không giúp được gì nữa sao?!
Dialogue: 0,0:05:11.97,0:05:13.21,italics,NOELLE (INT),0,0,0,,Không thể nào…
Dialogue: 0,0:05:14.04,0:05:16.72,main,NOELLE,0,0,0,,Họ đã làm điều đúng đắn và dốc hết sức mình…
Dialogue: 0,0:05:17.10,0:05:19.55,main,NOELLE,0,0,0,,Họ không thể chết một cách oan uổng thế này được!
Dialogue: 0,0:05:19.55,0:05:22.18,main,NACHT,0,0,0,,Chẳng còn cách nào cứu vãn được nữa đâu.
Dialogue: 0,0:05:22.80,0:05:24.45,main,ASTA,0,0,0,,Phó đoàn trưởng Nacht!
Dialogue: 0,0:05:24.89,0:05:29.61,main,NACHT,0,0,0,,Chúng ta đã tiêu diệt được một Ác ma Tối thượng.\NHãy biết hài lòng với kết quả đó đi.
Dialogue: 0,0:05:30.02,0:05:33.70,main,NACHT,0,0,0,,Không phải bất cứ ai làm điều đúng đắn\Ncũng chắc chắn nhận được phần thưởng xứng đáng.
Dialogue: 0,0:05:33.70,0:05:35.19,main,NACHT,0,0,0,,Thực tế tàn khốc là vậy đấy.
Dialogue: 0,0:05:36.37,0:05:38.21,italics,NACHT (INT),0,0,0,,Dù rằng chính tôi cũng mong họ được đền đáp.
Dialogue: 0,0:05:39.00,0:05:41.03,main,LUCK,0,0,0,,Này, anh đưa cô ấy tới rồi chứ?
Dialogue: 0,0:05:41.03,0:05:41.74,main,NACHT,0,0,0,,Ừ.
Dialogue: 0,0:05:42.89,0:05:44.20,main,NACHT,0,0,0,,Nhưng mà đã quá muộn…
Dialogue: 0,0:05:49.68,0:05:50.70,main,NOELLE,0,0,0,,Chưa đâu!
Dialogue: 0,0:05:54.18,0:05:55.40,main,NOELLE,0,0,0,,Mimosa chắc chắn làm được!
Dialogue: 0,0:05:57.72,0:06:00.09,main,MIMOSA,0,0,0,,Mình tuyệt đối không để bất kỳ ai phải chết!
Dialogue: 0,0:06:03.20,0:06:05.37,italics,MIMOSA (INT),0,0,0,,Tuyệt Kỹ Thực Vật Ma Pháp…
Dialogue: 0,0:06:06.49,0:06:08.57,italics,MIMOSA (INT),0,0,0,,Lạc Viên Công Chúa Hoa (Flower Princess Utopia).
Dialogue: 0,0:06:13.45,0:06:15.40,italics,NACHT (INT),0,0,0,,Ma pháp hồi phục này là…
Dialogue: 0,0:06:15.88,0:06:18.36,main,NOELLE,0,0,0,,Chúng ta sẽ đảo ngược cả cái thực tế đó luôn!
Dialogue: 0,0:06:19.10,0:06:22.81,main,NOELLE,0,0,0,,Vì đó mới là sức mạnh của ma pháp, đúng không nào?
Dialogue: 0,0:06:23.89,0:06:25.24,main,LOROPECHIKA,0,0,0,,Gaja!
Dialogue: 0,0:06:25.72,0:06:28.67,main,ASTA,0,0,0,,Rill! Đoàn trưởng Charlotte!
Dialogue: 0,0:06:28.67,0:06:30.74,main,ASTA,0,0,0,,May quá đi mất!
Dialogue: 0,0:06:31.05,0:06:33.94,main,ASTA,0,0,0,,Mimosa, cậu đỉnh thật đấy!
Dialogue: 0,0:06:35.42,0:06:37.49,main,LOROPECHIKA,0,0,0,,Mọi người lại hy sinh đến mức này vì kẻ như tôi…
Dialogue: 0,0:06:37.49,0:06:39.91,main,LOROPECHIKA,0,0,0,,Tôi xin lỗi! Tôi thật sự xin lỗi mọi người!
Dialogue: 0,0:06:39.91,0:06:43.67,main,GAJA,0,0,0,,Không. Thần chỉ làm tròn bổn phận\Ncủa một Tinh Linh Thủ Hộ thôi.
Dialogue: 0,0:06:43.96,0:06:48.13,main,NOELLE,0,0,0,,Thiệt tình. Hai người không còn điều gì\Nmuốn nói với nhau nữa sao?
Dialogue: 0,0:06:52.94,0:06:54.30,main,GAJA,0,0,0,,Thần yêu Người.
Dialogue: 0,0:06:58.48,0:07:00.23,main,GAJA,0,0,0,,Không phải tình cảm kính trọng dành cho Nữ vương.
Dialogue: 0,0:07:00.23,0:07:03.65,main,GAJA,0,0,0,,Người chính là người phụ nữ mà thần yêu say đắm.
Dialogue: 0,0:07:08.56,0:07:10.46,main,NOELLE,0,0,0,,Khoan đã, hả?! Nói thật luôn hả?!
Dialogue: 0,0:07:10.46,0:07:11.89,main,GAJA,0,0,0,,Thần có lỡ lời điều gì sai trái sao ạ?
Dialogue: 0,0:07:11.89,0:07:14.75,main,SMALL UNDINE,0,0,0,,Loropechika là của riêng ta cơ mà!
Dialogue: 0,0:07:15.20,0:07:17.26,main,SMALL UNDINE,0,0,0,,Nhưng nếu là ngươi, Gaja à…
Dialogue: 0,0:07:20.06,0:07:24.26,main,NOZEL,0,0,0,,Dù chẳng ưa gì việc thừa nhận điều này, nhưng đúng là\Nnhờ cậu ta mà Noelle mới trở nên mạnh mẽ thế này.
Dialogue: 0,0:07:25.05,0:07:28.73,main,NOZEL,0,0,0,,Bằng mọi giá, chúng ta nhất định phải\Ncứu được Yami trở về.
Dialogue: 0,0:07:31.81,0:07:37.85,italics,NACHT (INT),0,0,0,,Xem ra họ đã trưởng thành và mạnh mẽ vượt xa\Nmọi sự tưởng tượng của mình rồi.
Dialogue: 0,0:07:38.93,0:07:41.42,italics,NACHT (INT),0,0,0,,Giờ đây chỉ còn sót lại duy nhất một kẻ\Ntrong Bộ Ba Hắc Ám nữa thôi.
Dialogue: 0,0:07:42.34,0:07:43.52,italics,NACHT (INT),0,0,0,,Và kẻ cuối cùng đó chính là…
Dialogue: 0,0:07:41.86,0:07:44.62,sign_TimesNewRoman,SIGN,0,0,0,,{\an8\fad(0,790)}Ngay trước thời điểm Megicula bị đánh bại
Dialogue: 0,0:07:49.72,0:07:52.26,main,ZENON,0,0,0,,Ta đã lãng phí quá nhiều thời gian rồi.
Dialogue: 0,0:07:52.70,0:07:54.75,main,ZENON,0,0,0,,Chấm dứt tại đây thôi.
Dialogue: 0,0:07:57.50,0:08:00.19,main,LANGRIS,0,0,0,,Chết tiệt… Giờ phải làm sao đây?
Dialogue: 0,0:08:00.19,0:08:01.13,main,YUNO,0,0,0,,Langris.
Dialogue: 0,0:08:02.41,0:08:03.57,main,YUNO,0,0,0,,Hãy câu cho tôi đúng ba phút!
Dialogue: 0,0:08:04.01,0:08:06.13,main,YUNO,0,0,0,,Tôi sẽ kết liễu hắn bằng đòn tiếp theo.
Dialogue: 0,0:08:07.81,0:08:12.54,italics,YUNO (INT),0,0,0,,Mình có một ma pháp đủ sức đánh bại hắn…\Nnhưng cần thời gian để tích tụ mana.
Dialogue: 0,0:08:13.92,0:08:17.27,italics,YUNO (INT),0,0,0,,Mình không thể thi triển khi cả hai vẫn đang\Nbị ép vào thế phòng thủ bị động thế này.
Dialogue: 0,0:08:18.21,0:08:20.19,italics,YUNO (INT),0,0,0,,Để hạ gục được hắn ta…
Dialogue: 0,0:08:20.77,0:08:24.44,italics,LANGRIS (INT),0,0,0,,Mình buộc phải làm mồi nhử\Nvà bảo vệ cho Yuno.
Dialogue: 0,0:08:24.94,0:08:25.92,italics,LANGRIS (INT),0,0,0,,Thế nhưng…
Dialogue: 0,0:08:26.29,0:08:29.90,italics,LANGRIS (INT),0,0,0,,Mình chỉ né nổi đòn của hắn nhờ có\Nsự hỗ trợ từ Yuno,
Dialogue: 0,0:08:29.90,0:08:33.06,italics,LANGRIS (INT),0,0,0,,nên bảo mình tự câu giờ trọn vẹn ba phút\Nlà chuyện bất khả thi…
Dialogue: 0,0:08:34.01,0:08:36.70,italics,YUNO/LANGRIS (INT),0,0,0,,Nhưng dẫu vậy cũng buộc phải làm bằng được!
Dialogue: 0,0:08:38.73,0:08:42.53,main,YUNO,0,0,0,,Anh là ma pháp sư không gian mạnh nhất\Ncủa Vương quốc Clover cơ mà,
Dialogue: 0,0:08:42.53,0:08:45.21,main,YUNO,0,0,0,,chắc chắn anh đã bắt đầu nhìn ra\Nmột lối thoát rồi, đúng không?
Dialogue: 0,0:08:45.68,0:08:49.34,main,YUNO,0,0,0,,Anh đâu định cam chịu đứng yên để hắn\Nvùi dập hai ta mãi thế này, phải không?
Dialogue: 0,0:08:52.22,0:08:56.30,main,ZENON,0,0,0,,Ta đã nhìn thấu giới hạn sức mạnh của các ngươi rồi.
Dialogue: 0,0:08:57.22,0:09:00.99,italics,LANGRIS (INT),0,0,0,,Một khi lọt vào Không Gian Tuyệt Đối:\NChi Phối Mana Không Gian của Zenon,
Dialogue: 0,0:09:00.99,0:09:04.11,italics,LANGRIS (INT),0,0,0,,đa số mọi người thậm chí còn\Nchẳng thi triển nổi bất kỳ ma pháp nào.
Dialogue: 0,0:09:04.45,0:09:09.36,italics,LANGRIS (INT),0,0,0,,Những kẻ duy nhất còn cử động được chỉ có thể là\Nngười sở hữu lượng mana tương đương.
Dialogue: 0,0:09:09.80,0:09:13.90,italics,LANGRIS (INT),0,0,0,,Những kẻ được mana sủng ái như Yuno\Nvà tự thoát khỏi sự trói buộc đó.
Dialogue: 0,0:09:16.60,0:09:17.73,italics,LANGRIS (INT),0,0,0,,Hoặc là…
Dialogue: 0,0:09:19.16,0:09:22.46,italics,LANGRIS (INT),0,0,0,,những ma pháp sư không gian đã\Nlĩnh hội thành thạo Khu Vực Mana!
Dialogue: 0,0:09:26.38,0:09:27.45,main,ZENON,0,0,0,,Ồ…
Dialogue: 0,0:09:27.84,0:09:33.26,italics,ZENON (INT),0,0,0,,Tuy nhỏ hẹp, nhưng hắn đã dựng nên được lãnh địa riêng\Nbên trong Không Gian Tuyệt Đối của mình.
Dialogue: 0,0:09:33.48,0:09:35.94,main,YUNO,0,0,0,,Thấy chưa? Tôi biết ngay anh làm được mà.
Dialogue: 0,0:09:35.94,0:09:37.36,main,YUNO,0,0,0,,Làm tốt lắm.
Dialogue: 0,0:09:37.81,0:09:42.19,main,LANGRIS,0,0,0,,Thiệt tình… Đúng là thằng đàn em\Nláo xược hết chỗ nói mà!
Dialogue: 0,0:09:43.24,0:09:46.60,italics,LANGRIS (INT),0,0,0,,Ngay từ hồi mới gia nhập, cậu ta đã là một\Nđàn em ngông nghênh và tự phụ,
Dialogue: 0,0:09:46.60,0:09:49.54,italics,LANGRIS (INT),0,0,0,,nhưng lại sở hữu thực lực tương xứng với sự kiêu hãnh đó.
Dialogue: 0,0:09:50.18,0:09:53.60,italics,LANGRIS (INT),0,0,0,,Ngẫm lại lúc này, có lẽ mình từng ghét cậu ta\Nchỉ vì hai đứa quá giống nhau.
Dialogue: 0,0:09:54.64,0:09:58.17,italics,LANGRIS (INT),0,0,0,,Nhưng chưa bao giờ mình nghĩ mình sẽ thua cả.
Dialogue: 0,0:09:58.61,0:10:01.90,italics,LANGRIS (INT),0,0,0,,Mình chẳng ngờ có ngày cậu lại\Nvượt xa được cả mình như thế.
Dialogue: 0,0:10:04.18,0:10:08.14,main,ZENON,0,0,0,,Nhưng rốt cuộc, các ngươi vẫn chẳng có\Ncách nào đả thương nổi ta.
Dialogue: 0,0:10:08.14,0:10:11.38,main,ZENON,0,0,0,,Các ngươi không có bất kỳ ma pháp nào\Nđủ sức đánh bại ta lúc này đâu.
Dialogue: 0,0:10:13.13,0:10:16.14,italics,LANGRIS (INT),0,0,0,,Lượng mana của tên này hoàn toàn\Nvượt xa đẳng cấp của bọn mình!
Dialogue: 0,0:10:16.14,0:10:18.14,italics,LANGRIS (INT),0,0,0,,Mình không trụ nổi lâu nữa đâu.
Dialogue: 0,0:10:20.22,0:10:22.27,italics,LANGRIS (INT),0,0,0,,Cậu liệu mà khẩn trương lên đi!
Dialogue: 0,0:10:22.65,0:10:24.34,italics,YUNO (INT),0,0,0,,Tôi đang dồn hết sức đây!
Dialogue: 0,0:10:25.82,0:10:29.37,italics,LANGRIS (INT),0,0,0,,Phải rồi. Ma pháp không gian của mình\Ntừng là bất khả chiến bại.
Dialogue: 0,0:10:30.65,0:10:32.82,italics,LANGRIS (INT),0,0,0,,Chỉ cần mình dốc hết sức, bấy nhiêu là quá đủ.
Dialogue: 0,0:10:33.60,0:10:37.16,italics,LANGRIS (INT),0,0,0,,Miễn có mình ở đó, binh đoàn của mình\Nsẽ mãi là mạnh nhất.
Dialogue: 0,0:10:37.89,0:10:40.70,italics,LANGRIS (INT),0,0,0,,Nhưng sức mạnh của cậu lại hoàn toàn khác biệt.
Dialogue: 0,0:10:42.05,0:10:44.65,italics,LANGRIS (INT),0,0,0,,Cứ như thể cậu đang dùng luồng gió ấy\Nnâng cánh đẩy cả bọn cùng tiến lên…
Dialogue: 0,0:10:45.17,0:10:50.42,italics,LANGRIS (INT),0,0,0,,Như thể tất cả đang cùng nhau bay lượn trên bầu trời.\NSức mạnh của cậu chưa bao giờ là vì riêng bản thân mình.
Dialogue: 0,0:10:52.88,0:10:55.60,italics,LANGRIS (INT),0,0,0,,Tinh thần không cam chịu thất bại của cậu\Nđã truyền lửa cho tất cả mọi người
Dialogue: 0,0:10:56.22,0:10:57.49,italics,LANGRIS (INT),0,0,0,,và khiến bọn mình trở nên mạnh mẽ hơn.
Dialogue: 0,0:11:00.49,0:11:04.10,main,LANGRIS,0,0,0,,Ngứa mắt thật đấy, nhưng tôi công nhận rồi.
Dialogue: 0,0:11:05.05,0:11:09.78,main,LANGRIS,0,0,0,,Cậu quả thực xứng danh Phó Đoàn trưởng\Ncủa binh đoàn Kim Sắc Nhật Xuất!
Dialogue: 0,0:11:10.70,0:11:13.82,main,ZENON,0,0,0,,Trước sức mạnh áp đảo tuyệt đối,
Dialogue: 0,0:11:13.82,0:11:17.52,main,ZENON,0,0,0,,cảm xúc và lòng kiên trì đều\Nchẳng có chút ý nghĩa nào hết.
Dialogue: 0,0:11:20.93,0:11:26.96,main,ZENON,0,0,0,,Thứ duy nhất tồn tại chỉ là sự thật rằng\Nta mạnh hơn cả hai ngươi.
Dialogue: 0,0:11:27.96,0:11:32.48,main,LANGRIS,0,0,0,,Phải, nhưng bọn này đâu thể chỉ gật gù bảo:\N"Ồ, thế à?" rồi ngoan ngoãn lùi bước được!
Dialogue: 0,0:11:38.94,0:11:40.39,main,LANGRIS,0,0,0,,Bọn này chính là…
Dialogue: 0,0:11:40.89,0:11:45.49,main,LANGRIS,0,0,0,,Binh đoàn Hiệp sĩ Ma Pháp tối thượng,\NKim Sắc Nhật Xuất!
Dialogue: 0,0:11:46.17,0:11:47.19,main,YUNO,0,0,0,,Chính xác là vậy.
Dialogue: 0,0:11:49.25,0:11:51.98,main,YUNO,0,0,0,,Anh cũng ghét cay ghét đắng việc thua cuộc y như tôi thôi!
Dialogue: 0,0:11:53.01,0:11:56.90,main,YUNO,0,0,0,,Phong Tinh Linh Sáng Thành Ma Pháp:\NSpirit of Euros.
Dialogue: 0,0:12:12.38,0:12:14.09,italics,ZENON (INT),0,0,0,,Nhanh kinh khủng…
Dialogue: 0,0:12:14.84,0:12:18.76,italics,ZENON (INT),0,0,0,,Không ngờ lại có đòn đủ sức xuyên thủng\Ntrọn vẹn cơ thể này…
Dialogue: 0,0:12:21.04,0:12:23.89,main,YUNO,0,0,0,,Lòng kiên trì của bọn này đã thắng rồi!
Dialogue: 0,0:12:29.50,0:12:30.66,italics,ZENON (INT),0,0,0,,Allen…
Dialogue: 0,0:12:39.64,0:12:41.07,flashback,YOUNG VANICA (FB),0,0,0,,Em sao thế hả?
Dialogue: 0,0:12:42.32,0:12:44.44,flashback,YOUNG VANICA (FB),0,0,0,,Lại bị thương nữa rồi à?
Dialogue: 0,0:12:44.44,0:12:46.11,flashback,YOUNG VANICA (FB),0,0,0,,Đúng là đồ thảm hại!
Dialogue: 0,0:12:46.11,0:12:47.34,flashback,YOUNG DANTE (FB),0,0,0,,Thiệt tình…
Dialogue: 0,0:12:47.68,0:12:50.28,flashback,YOUNG DANTE (FB),0,0,0,,Mang tiếng là em trai của anh mà\Nsao lại yếu ớt thảm hại thế hả.
Dialogue: 0,0:12:56.68,0:12:59.04,flashback,LUCIUS (FB),0,0,0,,Đừng lo lắng, Zenon.
Dialogue: 0,0:13:01.56,0:13:02.58,flashback,YOUNG ZENON (FB),0,0,0,,Anh cả…
Dialogue: 0,0:13:03.20,0:13:05.82,flashback,LUCIUS (FB),0,0,0,,Em là đứa giống anh nhất trong nhà này đấy.
Dialogue: 0,0:13:08.93,0:13:13.77,flashback,LUCIUS (FB),0,0,0,,Em sở hữu tư chất làm Ác Ma Túc Chủ\Nvượt trội hơn hẳn Dante hay Vanica.
Dialogue: 0,0:13:18.28,0:13:19.41,flashback,BOY 1/BOY 2/JOHN (FB),0,0,0,,Này!
Dialogue: 0,0:13:20.44,0:13:21.68,flashback,JOHN (FB),0,0,0,,Nếm đòn đi!
Dialogue: 0,0:13:23.28,0:13:25.64,flashback,BOY 1 (FB),0,0,0,,Cậu khỏe ghê luôn á, John!
Dialogue: 0,0:13:25.64,0:13:29.40,flashback,JOHN (FB),0,0,0,,Thằng nhóc quái dị kia. Trên người mày\Nmọc ra toàn xương là xương kìa.
Dialogue: 0,0:13:30.04,0:13:37.10,flashback,JOHN (FB),0,0,0,,Bố tao làm trong Đội Phòng Vệ Ma Pháp đấy,\Ntao sẽ diệt trừ mày ngay tại đây!
Dialogue: 0,0:13:37.42,0:13:38.36,flashback,JOHN (FB),0,0,0,,Ối!
Dialogue: 0,0:13:38.92,0:13:40.12,flashback,JOHN (FB),0,0,0,,Nóng quá!
Dialogue: 0,0:13:40.12,0:13:41.64,flashback,YOUNG ALLEN (FB),0,0,0,,Mấy cậu nói linh tinh gì thế hả?
Dialogue: 0,0:13:42.43,0:13:45.53,flashback,YOUNG ALLEN (FB),0,0,0,,Đó chỉ là một hệ ma pháp khác thôi mà!
Dialogue: 0,0:13:45.53,0:13:47.48,flashback,JOHN (FB),0,0,0,,Á, là thằng Allen!
Dialogue: 0,0:13:47.48,0:13:49.48,flashback,JOHN (FB),0,0,0,,Chạy lẹ tụi bay ơi!
Dialogue: 0,0:13:49.48,0:13:53.23,flashback,YOUNG ALLEN (FB),0,0,0,,Mang tiếng con trai thành viên Đội Phòng Vệ Ma Pháp\Nmà hèn thế à? Nhục nhã hết chỗ nói.
Dialogue: 0,0:13:55.34,0:13:56.48,flashback,YOUNG ALLEN (FB),0,0,0,,Tớ là Allen!
Dialogue: 0,0:13:56.73,0:13:59.25,flashback,YOUNG ALLEN (FB),0,0,0,,Ma pháp của cậu nhìn mạnh kinh khủng luôn ấy!
Dialogue: 0,0:14:02.97,0:14:05.37,flashback,YOUNG ALLEN (FB),0,0,0,,Ai nấy ở đây đều sống trong lo âu sợ hãi.
Dialogue: 0,0:14:06.29,0:14:09.52,flashback,YOUNG ALLEN (FB),0,0,0,,Vương quốc Spade quanh năm bị tuyết vùi lấp.
Dialogue: 0,0:14:09.52,0:14:11.72,flashback,YOUNG ALLEN (FB),0,0,0,,Bạo loạn thì cứ triền miên không dứt,
Dialogue: 0,0:14:11.72,0:14:14.50,flashback,YOUNG ALLEN (FB),0,0,0,,lại còn Vương quốc Diamond suốt ngày lăm le xâm lược.
Dialogue: 0,0:14:15.45,0:14:20.17,flashback,YOUNG ALLEN (FB),0,0,0,,Tớ muốn trở nên mạnh mẽ hơn để bảo vệ\Nnhững người dân đang run rẩy trong sợ hãi.
Dialogue: 0,0:14:21.58,0:14:25.93,flashback,YOUNG ALLEN (FB),0,0,0,,Tớ muốn thắp lên ngọn lửa hy vọng\Ngiữa vùng đất băng giá này.
Dialogue: 0,0:14:29.04,0:14:29.92,flashback,YOUNG ALLEN (FB),0,0,0,,Vậy nên…
Dialogue: 0,0:14:30.86,0:14:34.35,flashback,YOUNG ALLEN (FB),0,0,0,,Tớ nhất định sẽ trở thành Tổng tư lệnh\Ncủa Đội Phòng Vệ Ma Pháp.
Dialogue: 0,0:14:35.74,0:14:36.65,flashback,YOUNG ZENON (FB),0,0,0,,Tớ cũng vậy.
Dialogue: 0,0:14:38.98,0:14:40.82,flashback,YOUNG ZENON (FB),0,0,0,,Tớ cũng sẽ trở thành Tổng tư lệnh.
Dialogue: 0,0:14:41.48,0:14:44.36,flashback,YOUNG ALLEN (FB),0,0,0,,Vậy thì hai đứa mình chính thức là kỳ phùng địch thủ rồi nhé!
Dialogue: 0,0:14:44.72,0:14:48.00,flashback,YOUNG ALLEN (FB),0,0,0,,Cùng thi xem ai sẽ trở thành\NTổng tư lệnh trước nào!
Dialogue: 0,0:15:01.12,0:15:03.63,flashback,TEEN ZENON (FB),0,0,0,,Em vô cùng xin lỗi, Anh cả.
Dialogue: 0,0:15:05.13,0:15:09.05,flashback,TEEN ZENON (FB),0,0,0,,Em không hề có hứng thú trở thành\Nmột Ác Ma Túc Chủ đâu.
Dialogue: 0,0:15:13.26,0:15:17.22,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,Chúc mừng hai tân binh đã gia nhập\NSư đoàn 4 Đội Phòng Vệ Ma Pháp.
Dialogue: 0,0:15:18.02,0:15:20.77,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,Cả hai thành viên mới năm nay\Nđều sẵn sàng xung trận hết cả rồi!
Dialogue: 0,0:15:20.77,0:15:23.61,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,Nhất là Zenon, cậu chàng dùng\NXương Ma Pháp kia đúng chuẩn thiên tài luôn!
Dialogue: 0,0:15:24.81,0:15:27.70,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,Một ma cung vừa xuất hiện ở phía Tây Bắc\Nthị trấn Lawton!
Dialogue: 0,0:15:27.70,0:15:29.74,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,Sư đoàn 4 lập tức xuất phát\Ntới điều tra ngay tức khắc!
Dialogue: 0,0:15:30.65,0:15:32.74,flashback,ALLEN (FB),0,0,0,,Lần này tớ không chịu thua đâu nhé, Zenon.
Dialogue: 0,0:15:35.00,0:15:37.64,flashback,TEEN ZENON (FB),0,0,0,,Làm nhiệm vụ thì làm gì có chuyện thắng thua,\NAllen.
Dialogue: 0,0:15:37.64,0:15:40.33,flashback,ALLEN (FB),0,0,0,,Trời ạ, lúc nào cậu cũng nghiêm túc quá mức thế.
Dialogue: 0,0:15:52.42,0:15:55.52,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,Không thể tin nổi lại có một con ác ma\Nbị phong ấn bên trong nơi này!
Dialogue: 0,0:15:55.52,0:15:59.26,flashback,MAGE DEFENSE FORCE MEMBER 3 (FB),0,0,0,,Nó mạnh khủng khiếp quá! Cứ đà này\Ntất cả bọn mình sẽ bị xóa sổ sạch mất!
Dialogue: 0,0:16:01.02,0:16:02.69,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Muốn đánh bại thứ quái vật đó…
Dialogue: 0,0:16:03.42,0:16:07.04,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,mình bắt buộc phải tung ra đòn ma pháp\Ndốc cạn toàn bộ mana.
Dialogue: 0,0:16:07.77,0:16:10.82,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Nhưng nó không chừa cho mình cơ hội nào để đánh trúng.
Dialogue: 0,0:16:11.68,0:16:15.20,flashback,ALLEN (FB),0,0,0,,Tớ… nhất định sẽ trở thành Tổng tư lệnh\Ncủa Đội Phòng Vệ Ma Pháp!
Dialogue: 0,0:16:18.32,0:16:21.25,flashback,ALLEN (FB),0,0,0,,Tớ không thể gục ngã ở đây được!
Dialogue: 0,0:16:21.25,0:16:22.83,flashback,TEEN ZENON (FB),0,0,0,,Allen!
Dialogue: 0,0:16:22.83,0:16:25.13,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Cậu làm thế cũng chỉ câu thêm được chút thời gian thôi!
Dialogue: 0,0:16:28.36,0:16:30.14,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Đây là cơ hội duy nhất của mình!
Dialogue: 0,0:16:30.70,0:16:33.10,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Nếu bắn ngay lúc này, mình sẽ tiêu diệt được\Ncon ác ma kia…
Dialogue: 0,0:16:33.45,0:16:35.01,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,cùng với cả Allen nữa.
Dialogue: 0,0:16:36.28,0:16:40.40,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Nếu không hạ gục nó ngay lúc này,\Ntất cả mọi người, kể cả bản thân mình…
Dialogue: 0,0:16:41.34,0:16:42.37,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,đều sẽ bỏ mạng.
Dialogue: 0,0:16:43.96,0:16:46.60,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Rồi sẽ còn nhiều nạn nhân hơn nữa\Nphải ngã xuống khắp vương quốc.
Dialogue: 0,0:16:46.60,0:16:50.16,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Ít nhất thì toàn bộ người dân\Nở thị trấn lân cận sẽ chết sạch.
Dialogue: 0,0:17:01.04,0:17:04.00,flashback,ALLEN (FB),0,0,0,,Chưa kết thúc đâu!
Dialogue: 0,0:17:10.89,0:17:12.95,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Không có sức mạnh tuyệt đối,
Dialogue: 0,0:17:12.95,0:17:15.49,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,cảm xúc và lòng kiên trì đều\Nchẳng mang lại ý nghĩa gì hết.
Dialogue: 0,0:17:18.34,0:17:20.82,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Kẻ yếu ớt buộc phải bị đào thải.
Dialogue: 0,0:17:24.18,0:17:27.94,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Sức mạnh áp đảo chính là tất cả!
Dialogue: 0,0:17:29.57,0:17:33.01,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,Nếu ngay cả một con ác ma vô danh tiểu tốt\Ncũng sở hữu sức mạnh khủng khiếp đến thế thì…
Dialogue: 0,0:17:34.12,0:17:35.25,flashback,TEEN ZENON (FB),0,0,0,,Anh cả ơi.
Dialogue: 0,0:17:37.21,0:17:40.66,flashback,TEEN ZENON (FB),0,0,0,,Xin hãy biến em thành Ác Ma Túc Chủ đi.
Dialogue: 0,0:17:44.49,0:17:47.52,main,ZENON,0,0,0,,Beelzebub, chúng ta lập giao ước đi.
Dialogue: 0,0:17:47.92,0:17:50.57,main,ZENON,0,0,0,,Hãy ban cho ta một trái tim ác ma.
Dialogue: 0,0:17:52.74,0:17:54.70,main,BEELZEBUB,0,0,0,,Trái tim ư?
Dialogue: 0,0:17:59.76,0:18:03.83,main,BEELZEBUB,0,0,0,,Vậy ngươi định đánh đổi thứ gì\Nđể nhận lấy từ ta?
Dialogue: 0,0:18:03.83,0:18:05.86,main,ZENON,0,0,0,,Toàn bộ con người ta.
Dialogue: 0,0:18:07.46,0:18:12.44,main,ZENON,0,0,0,,Nếu đúng như khế ước đã định, Vương quốc Spade\Ncó thể tiếp tục trường tồn,
Dialogue: 0,0:18:12.44,0:18:15.45,main,ZENON,0,0,0,,ta sẵn sàng dâng cho ngươi cả linh hồn mình.
Dialogue: 0,0:18:18.46,0:18:19.65,main,BEELZEBUB,0,0,0,,Được thôi.
Dialogue: 0,0:18:20.68,0:18:22.38,main,BEELZEBUB,0,0,0,,Ta chấp thuận ban cho ngươi.
Dialogue: 0,0:18:34.04,0:18:35.54,main,YUNO,0,0,0,,Cái gì?!
Dialogue: 0,0:18:43.85,0:18:48.11,italics,YUNO,0,0,0,,Cảm giác này… Hắn giống hệt tên kia rồi!
Dialogue: 0,0:18:48.52,0:18:51.76,main,ZENON,0,0,0,,Giờ đây khi đã sở hữu trái tim ác ma,
Dialogue: 0,0:18:52.14,0:18:55.42,main,ZENON,0,0,0,,sức mạnh của ta càng trở nên hủy diệt hơn gấp bội.
Dialogue: 0,0:18:56.14,0:19:00.08,italics,LANGRIS (INT),0,0,0,,Hắn sử dụng sức mạnh ác ma,\Nvà còn mang trong mình trái tim ác ma.
Dialogue: 0,0:19:00.54,0:19:02.25,italics,LANGRIS (INT),0,0,0,,Một con người đã biến thành thế kia thì…
Dialogue: 0,0:19:03.32,0:19:04.76,italics,LANGRIS (INT),0,0,0,,chẳng phải vốn dĩ đã là ác ma rồi sao?
Dialogue: 0,0:19:22.21,0:19:24.60,main,ZENON,0,0,0,,Mũi tên lúc nãy…
Dialogue: 0,0:19:25.98,0:19:30.25,main,ZENON,0,0,0,,Vì sợ bắn trúng đồng đội mình nên ngươi đã\Nchỉnh chệch đường bay đi một chút
Dialogue: 0,0:19:30.25,0:19:32.86,main,ZENON,0,0,0,,và sượt khỏi trái tim của ta.
Dialogue: 0,0:19:35.15,0:19:39.49,main,ZENON,0,0,0,,Nếu ngươi dám hy sinh đồng đội của mình\Nmà bắn thẳng xuyên tim ta,
Dialogue: 0,0:19:40.24,0:19:42.70,main,ZENON,0,0,0,,thì kẻ thắng đã là ngươi rồi.
Dialogue: 0,0:20:11.78,0:20:13.70,main,ZENON,0,0,0,,Con sâu cái kiến dai dẳng kia…
Dialogue: 0,0:20:14.09,0:20:16.19,main,ZENON,0,0,0,,Ngươi vẫn còn ngoan cố ngáng đường ta sao?
Dialogue: 0,0:20:17.26,0:20:19.14,main,ZENON,0,0,0,,Ta sẽ tiễn ngươi một đoạn cho đỡ khổ.
Dialogue: 0,0:20:28.48,0:20:30.50,main,FINRAL,0,0,0,,Chào nhé, Langris!
Dialogue: 0,0:20:30.50,0:20:31.58,main,LANGRIS,0,0,0,,Anh hai?!
Dialogue: 0,0:20:31.93,0:20:33.64,main,ZENON,0,0,0,,Tên đó là…
Dialogue: 0,0:20:34.34,0:20:37.31,main,LANGRIS,0,0,0,,Em chẳng hiểu sao anh lại có mặt ở đây,
Dialogue: 0,0:20:37.31,0:20:39.63,main,LANGRIS,0,0,0,,nhưng đừng nói anh lại định tới giải cứu em nữa đấy nhé?
Dialogue: 0,0:20:40.14,0:20:43.90,italics,FINRAL (INT),0,0,0,,Mình vừa nhìn thấy Langris và tên kia là\Nlao thẳng tới đây chẳng kịp suy nghĩ gì luôn.
Dialogue: 0,0:20:44.47,0:20:45.52,main,FINRAL,0,0,0,,Đâu có!
Dialogue: 0,0:20:46.09,0:20:51.05,main,FINRAL,0,0,0,,Hắn ta đã dùng không gian ma pháp\Nbắt cóc Đoàn trưởng của bọn anh.
Dialogue: 0,0:20:51.50,0:20:54.77,main,FINRAL,0,0,0,,Anh không thể để hắn yên thân thoát tội dễ dàng thế được.
Dialogue: 0,0:20:55.72,0:20:56.69,italics,FINRAL (INT),0,0,0,,Xin lỗi nhé…
Dialogue: 0,0:20:57.03,0:20:59.87,italics,FINRAL (INT),0,0,0,,Em xin phép rẽ ngang một chút nhé, Đoàn trưởng Yami!
Dialogue: 0,0:21:00.89,0:21:04.17,italics,FINRAL (INT),0,0,0,,Mình sẽ kích hoạt Đôi Cánh Đọa Thiên Sứ\Ntrực tiếp lên người Langris!
Dialogue: 0,0:21:05.24,0:21:06.87,italics,FINRAL (INT),0,0,0,,Tức Thời Dịch Chuyển!
Dialogue: 0,0:21:08.23,0:21:10.01,italics,FINRAL (INT),0,0,0,,Khu Vực Mana của Langris giúp mình\Nvẫn thi triển được ma pháp
Dialogue: 0,0:21:10.01,0:21:13.21,italics,FINRAL (INT),0,0,0,,ngay cả bên trong Không Gian Tuyệt Đối của Zenon.
Dialogue: 0,0:21:13.95,0:21:18.21,italics,LANGRIS (INT),0,0,0,,Tốc độ dịch chuyển của anh Finral\Nvô cùng linh hoạt và chuẩn xác.
Dialogue: 0,0:21:18.89,0:21:22.42,main,FINRAL,0,0,0,,Nếu hai anh em mình cùng sát cánh lúc này thì chiến được đấy!
Dialogue: 0,0:21:22.42,0:21:23.85,main,FINRAL,0,0,0,,Đúng không nào, Langris?
Dialogue: 0,0:21:25.35,0:21:26.68,main,LANGRIS,0,0,0,,Thiệt tình chứ…
Dialogue: 0,0:21:26.68,0:21:29.02,main,LANGRIS,0,0,0,,Đúng là ông anh trai ngạo mạn hết thuốc chữa mà!
Dialogue: 0,0:21:34.31,0:21:37.28,italics,FINRAL (INT),0,0,0,,Langris sẽ không trụ nổi qua một trận đánh kéo dài đâu!
Dialogue: 0,0:21:37.28,0:21:38.32,italics,FINRAL (INT),0,0,0,,Tụi mình phải giải quyết nhanh gọn lẹ!
Dialogue: 0,0:21:39.44,0:21:42.27,italics,ZENON (INT),0,0,0,,Giờ ta đã nắm rõ tốc độ dịch chuyển của hắn,
Dialogue: 0,0:21:42.27,0:21:46.13,italics,ZENON (INT),0,0,0,,thời điểm hắn ra tay lẫn mục tiêu\Nmà hai tên này đang nhắm tới.
Dialogue: 0,0:21:46.13,0:21:48.95,italics,ZENON (INT),0,0,0,,Khoảnh khắc chúng lao tới kết liễu,\Nta sẽ tiễn cả hai về chầu trời.
Dialogue: 0,0:21:49.56,0:21:51.93,italics,ZENON (INT),0,0,0,,Một khi bước vào Khu Vực Mana của ta…
Dialogue: 0,0:21:50.43,0:21:52.96,top,FINRAL (INT),0,0,0,,Tụi mình sẽ áp sát để xông thẳng\Nvào Khu Vực Mana của hắn!
Dialogue: 0,0:21:57.21,0:21:58.63,italics,ZENON (INT),0,0,0,,…là coi như chấm hết.
Dialogue: 0,0:22:01.10,0:22:02.20,italics,ZENON (INT),0,0,0,,Cái gì?!
Dialogue: 0,0:22:03.90,0:22:06.80,italics,FINRAL (INT),0,0,0,,Mình đã dùng Thuật Thức Mana để gia tăng tốc độ tối đa!
Dialogue: 0,0:22:07.31,0:22:09.82,italics,FINRAL (INT),0,0,0,,Ma pháp của Langris xé toạc\Nchính bản thân không gian ra!
Dialogue: 0,0:22:09.82,0:22:13.06,italics,FINRAL (INT),0,0,0,,Cho dù ngươi có mạnh tới đâu đi nữa,\Nphòng ngự của ngươi…
Dialogue: 0,0:22:13.61,0:22:15.34,italics,FINRAL/LANGRIS (INT),0,0,0,,…cũng trở nên vô nghĩa hoàn toàn!

