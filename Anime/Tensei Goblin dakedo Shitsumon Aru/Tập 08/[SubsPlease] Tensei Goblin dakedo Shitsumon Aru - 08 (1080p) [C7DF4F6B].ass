Dialogue: 0,0:00:00.00,0:00:10.07,Sign_Basic,title,0,0,0,,CHUYỂN SINH THÀNH GOBLIN\NTHÌ CÓ GÌ SAI?
Dialogue: 0,0:01:32.19,0:01:37.95,Sign_Basic,text,0,0,0,,TẬP 8: MUỐN THĂNG TIẾN VÌ BỘ TỘC CỦA MÌNH\NTHÌ CÓ GÌ SAI?
Dialogue: 0,0:01:44.54,0:01:47.24,Main,woman C/D,0,0,0,,Akira dễ thương quá đi mất!
Dialogue: 0,0:01:47.53,0:01:51.86,Main,proprietress,0,0,0,,Hai đứa bình tĩnh nào.\NĐừng làm Akira ngại chứ.
Dialogue: 0,0:01:53.34,0:01:55.37,Main,Akira,0,0,0,,Ờm, ngài Simon à?
Dialogue: 0,0:01:56.71,0:01:59.02,Main,Akira,0,0,0,,Sao hôm nay chúng ta lại đến đây thế?
Dialogue: 0,0:01:59.37,0:02:01.94,Main,Simon,0,0,0,,Đều tại cậu cả đấy, người anh em ạ.
Dialogue: 0,0:02:01.94,0:02:02.87,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:02:03.10,0:02:06.44,Main,Simon,0,0,0,,Cậu làm mấy cô nàng xinh xắn này mê mệt,
Dialogue: 0,0:02:06.44,0:02:09.48,Main,Simon,0,0,0,,rồi từ đó tới giờ chẳng thèm\Nghé lại lần nào cả.
Dialogue: 0,0:02:10.35,0:02:12.35,Main,woman C/D,0,0,0,,Huhu, buồn quá đi mất.
Dialogue: 0,0:02:12.35,0:02:13.43,Main,Akira,0,0,0,,Gì cơ?
Dialogue: 0,0:02:14.03,0:02:18.60,Main,Simon,0,0,0,,Mấy cô bé năn nỉ tôi\Nphải dẫn cậu qua đây cho bằng được đấy.
Dialogue: 0,0:02:18.60,0:02:19.78,Main,Akira,0,0,0,,Ra là vậy.
Dialogue: 0,0:02:19.78,0:02:22.51,Main,Akira,0,0,0,,Xin lỗi nhé, dạo này tôi bận túi bụi luôn.
Dialogue: 0,0:02:22.51,0:02:26.44,Main,Simon,0,0,0,,Karen có bảo là cậu muốn gặp tôi,
Dialogue: 0,0:02:26.44,0:02:29.28,Main,Simon,0,0,0,,nên tôi nghĩ nhân dịp này\Nqua đây luôn là tiện đôi đường.
Dialogue: 0,0:02:29.28,0:02:31.89,Main,woman E,0,0,0,,Ờm, xin anh đừng làm thế ạ.
Dialogue: 0,0:02:33.70,0:02:35.67,Main,creeper,0,0,0,,Giờ cô thấy thế nào?
Dialogue: 0,0:02:35.67,0:02:38.08,Main,creeper,0,0,0,,Vinh hạnh khi được làm người phụ nữ của ta lắm chứ?
Dialogue: 0,0:02:39.06,0:02:41.38,Main,woman E,0,0,0,,À, ờm...
Dialogue: 0,0:02:43.76,0:02:45.44,Main,Akira,0,0,0,,Tôi nghĩ dừng ở đây được rồi đấy.
Dialogue: 0,0:02:46.47,0:02:50.41,Main,creeper,0,0,0,,Hả? Cái gì, một con Goblin à?
Dialogue: 0,0:02:50.41,0:02:54.68,Main,creeper,0,0,0,,Này bà chủ, quán này từ bao giờ\Nlại cho dắt thú cưng vào thế hả?
Dialogue: 0,0:02:55.43,0:02:58.41,Italics,Akira,0,0,0,,Nói lý với hạng người này\Nchắc cũng chẳng ăn thua đâu.
Dialogue: 0,0:02:59.26,0:03:02.23,Main,Akira,0,0,0,,Hay là tôi với anh\Nthi uống rượu một phen nhé?
Dialogue: 0,0:03:02.23,0:03:06.03,Main,creeper,0,0,0,,Với một con Goblin á? Nghe vui phết đấy.
Dialogue: 0,0:03:06.03,0:03:07.37,Main,creeper,0,0,0,,Mang ly ra đây!
Dialogue: 0,0:03:08.11,0:03:09.24,Main,Akira,0,0,0,,Nào, bắt đầu thôi.
Dialogue: 0,0:03:10.67,0:03:12.46,Main,creeper,0,0,0,,Thua rồi thì đừng có khóc lóc ăn vạ đấy.
Dialogue: 0,0:03:24.13,0:03:27.09,Main,Akira,0,0,0,,Nổ cho lắm vào, mới chừng đó\Nmà đã gục rồi sao?
Dialogue: 0,0:03:27.09,0:03:28.85,Main,Akira,0,0,0,,Chán chết đi được.
Dialogue: 0,0:03:28.85,0:03:33.60,Sign_Basic,text,0,0,0,,TỬU THẦN
Dialogue: 0,0:03:29.15,0:03:33.60,Italics,Akira,0,0,0,,Kỹ năng Tửu Thần giúp mình kháng cồn\Ngấp hàng chục lần người thường.
Dialogue: 0,0:03:33.60,0:03:36.09,Main,creeper,0,0,0,,Mày vừa nói cái gì...
Dialogue: 0,0:03:39.18,0:03:40.81,Main,proprietress,0,0,0,,Th-Thất lễ quá ạ.
Dialogue: 0,0:03:41.71,0:03:44.16,Main,proprietress,0,0,0,,Tôi xin lỗi vì đã để xảy ra chuyện này.
Dialogue: 0,0:03:44.16,0:03:46.31,Main,Akira,0,0,0,,Để một vị khách khác tiễn hắn ra cửa
Dialogue: 0,0:03:46.31,0:03:49.09,Main,Akira,0,0,0,,vẫn tốt hơn là để nhân viên\Ntrong quán cô phải ra mặt.
Dialogue: 0,0:03:49.56,0:03:51.65,Main,proprietress,0,0,0,,Cảm ơn anh rất nhiều.
Dialogue: 0,0:03:51.65,0:03:54.09,Main,woman B,0,0,0,,Akira tuy nhỏ con mà khí phách ghê gớm thật.
Dialogue: 0,0:03:54.09,0:03:55.61,Main,Simon,0,0,0,,Chuẩn không cần chỉnh.
Dialogue: 0,0:03:55.61,0:03:59.80,Main,Simon,0,0,0,,Cậu ấy đã kéo hết sự hậm hực\Ncủa gã biến thái kia về phía mình đấy.
Dialogue: 0,0:04:00.59,0:04:03.79,Main,Akira,0,0,0,,Xin lỗi vì tôi tự tiện xen vào nhé, Simon.
Dialogue: 0,0:04:05.48,0:04:10.35,Main,Simon,0,0,0,,Nếu cậu không ra tay,\Ntôi cũng định cho hắn một bài học rồi.
Dialogue: 0,0:04:11.60,0:04:16.45,Main,Simon,0,0,0,,Mà cái gã đó nghĩ cứ bước chân vào quán\Nlà cô ấy thành đàn bà của mình chắc?
Dialogue: 0,0:04:16.45,0:04:20.13,Main,Simon,0,0,0,,Ăn nói kiểu đó thì đích thị\Nlà trai tân chưa trải sự đời rồi.
Dialogue: 0,0:04:21.19,0:04:22.72,Main,Akira,0,0,0,,Ông nói nghe phũ phàng thật đấy.
Dialogue: 0,0:04:22.72,0:04:26.28,Main,Akira,0,0,0,,Trước ông bảo đàn ông phải qua tay\Nbao nhiêu người ấy nhỉ? Một nghìn à?
Dialogue: 0,0:04:26.59,0:04:30.89,Main,Simon,0,0,0,,Chuẩn rồi, và đó chính là chỗ\Nmà Albert thiếu sót trầm trọng nhất đấy.
Dialogue: 0,0:04:30.89,0:04:34.18,Main,Simon,0,0,0,,Cả đời mới biết đúng một người phụ nữ\Nnên mới sinh ra lắm chuyện như vậy.
Dialogue: 0,0:04:34.67,0:04:39.72,Main,Simon,0,0,0,,Suy cho cùng, chiến hữu à, cậu ta\Nđang tính biến cậu thành Ma Vương đấy.
Dialogue: 0,0:04:40.38,0:04:42.15,Main,Akira,0,0,0,,Biến tôi thành Ma Vương á?!
Dialogue: 0,0:04:42.15,0:04:43.06,Main,Simon,0,0,0,,Ừm.
Dialogue: 0,0:04:43.31,0:04:45.23,Main,Akira,0,0,0,,Chuyện đó là sao chứ?
Dialogue: 0,0:04:45.23,0:04:48.71,Main,Simon,0,0,0,,Nhân loại từng bị Ma Vương\Nhành hạ suốt một thời gian dài.
Dialogue: 0,0:04:49.06,0:04:52.92,Main,Simon,0,0,0,,Chó cùng thì dứt giậu, bị dồn vào đường cùng\Nthì còn nhảy qua tường cao hơn cả mèo nữa cơ.
Dialogue: 0,0:04:56.70,0:05:02.03,Main,Simon,0,0,0,,Một vị anh hùng đã xuất hiện giữa đàn chó đó,\Nvà dồn ngược lại Ma Vương.
Dialogue: 0,0:05:05.29,0:05:07.44,Italics,Akira,0,0,0,,"Nhân loại từng bị hành hạ."
Dialogue: 0,0:05:07.80,0:05:10.46,Italics,Akira,0,0,0,,Chắc hẳn phải xảy ra biết bao thảm kịch,
Dialogue: 0,0:05:10.46,0:05:13.21,Italics,Akira,0,0,0,,mới có thể đúc kết thành\Nmột câu ngắn gọn như vậy.
Dialogue: 0,0:05:14.37,0:05:16.12,Main,Simon,0,0,0,,Người anh em à.
Dialogue: 0,0:05:17.04,0:05:20.71,Main,Simon,0,0,0,,Để ngăn chặn mối họa Ma Vương,\Nchúng ta nên làm gì đây?
Dialogue: 0,0:05:21.88,0:05:24.14,Italics,Akira,0,0,0,,Mọi câu hỏi đều ẩn chứa mục đích riêng.
Dialogue: 0,0:05:24.14,0:05:27.18,Italics,Akira,0,0,0,,Ông ấy đang tìm câu trả lời, hay tìm sự đồng thuận?
Dialogue: 0,0:05:27.53,0:05:28.97,Italics,Akira,0,0,0,,Theo trực giác của mình thì...
Dialogue: 0,0:05:29.77,0:05:30.87,Italics,Akira,0,0,0,,là sự đồng thuận.
Dialogue: 0,0:05:31.48,0:05:33.86,Main,Akira,0,0,0,,Tự chúng ta lập nên một Ma Vương của riêng mình?
Dialogue: 0,0:05:34.74,0:05:36.28,Main,Simon,0,0,0,,Chính xác.
Dialogue: 0,0:05:36.82,0:05:39.48,Main,Simon,0,0,0,,Tự lập nên Ma Vương của riêng mình.
Dialogue: 0,0:05:39.48,0:05:41.65,Main,Simon,0,0,0,,Hẳn cậu ta cũng nảy ra ý tưởng đó,
Dialogue: 0,0:05:41.65,0:05:45.74,Main,Simon,0,0,0,,và nhắm tới cậu vì cậu\Nlà kẻ có thể nói lý lẽ được.
Dialogue: 0,0:05:46.55,0:05:50.02,Italics,Akira,0,0,0,,Người ở thế giới này mà nghe được\Nkế hoạch của Hoàng tử Albert
Dialogue: 0,0:05:50.02,0:05:53.81,Italics,Akira,0,0,0,,chắc sẽ thấy ý tưởng con người\Ngiật dây chuyện nội bộ Ma Vương
Dialogue: 0,0:05:53.81,0:05:55.91,Italics,Akira,0,0,0,,nghe thật nực cười.
Dialogue: 0,0:05:56.54,0:05:59.14,Italics,Akira,0,0,0,,Nhưng kiếp trước mình là người Nhật hiện đại.
Dialogue: 0,0:05:59.14,0:06:02.05,Italics,Akira,0,0,0,,Với đại đa số người Nhật mà nói,
Dialogue: 0,0:06:02.53,0:06:06.18,Italics,Akira,0,0,0,,cứ đánh bại Ma Vương xong\Nlà mọi người sống hạnh phúc mãi mãi.
Dialogue: 0,0:06:06.18,0:06:09.47,Italics,Akira,0,0,0,,Chẳng ai bận tâm chuyện gì\Nsẽ xảy ra sau đó ở thế giới kiểu này.
Dialogue: 0,0:06:09.70,0:06:11.30,Italics,Akira,0,0,0,,Chừng nào Ma vật còn tồn tại,
Dialogue: 0,0:06:11.30,0:06:14.02,Italics,Akira,0,0,0,,chuyện một Ma Vương mới xuất hiện\Nlà điều tất yếu.
Dialogue: 0,0:06:14.70,0:06:17.48,Flashback,Izyz,0,0,0,,Này, nhóc có muốn làm Ma Vương không?
Dialogue: 0,0:06:17.77,0:06:20.08,Italics,Akira,0,0,0,,Lúc đó mình chưa kịp nhận ra.
Dialogue: 0,0:06:20.08,0:06:22.73,Italics,Akira,0,0,0,,Mình biết ông ta có mưu đồ riêng,
Dialogue: 0,0:06:22.73,0:06:26.40,Italics,Akira,0,0,0,,nhưng đáng ra mình phải sớm hiểu rằng\Nphía con người
Dialogue: 0,0:06:26.40,0:06:28.46,Italics,Akira,0,0,0,,cũng có toan tính riêng của họ.
Dialogue: 0,0:06:28.76,0:06:31.40,Main,Akira,0,0,0,,Không thể thương lượng với\Nvị Ma Vương tiền nhiệm sao?
Dialogue: 0,0:06:31.70,0:06:34.39,Main,Simon,0,0,0,,Ông ta vốn chẳng phải kẻ xấu xa gì.
Dialogue: 0,0:06:34.39,0:06:37.04,Main,Simon,0,0,0,,Ít nhất là đứng từ góc nhìn\Nphía các cậu.
Dialogue: 0,0:06:37.59,0:06:39.91,Italics,Akira,0,0,0,,Vì địa vị nên ông ấy không thể nói thẳng,
Dialogue: 0,0:06:39.91,0:06:42.42,Italics,Akira,0,0,0,,nhưng hẳn ông ấy đánh giá rất cao\Nvị Ma Vương tiền nhiệm.
Dialogue: 0,0:06:42.82,0:06:44.76,Italics,Akira,0,0,0,,Mình chỉ tiếp xúc thoáng qua với ông ta,
Dialogue: 0,0:06:44.76,0:06:48.22,Italics,Akira,0,0,0,,nhưng cũng cảm nhận được\Nông ta không phải kẻ tàn ác tuyệt đối.
Dialogue: 0,0:06:48.69,0:06:53.44,Italics,Akira,0,0,0,,Chloe kính yêu ông ta, tộc Tiên được giữ mạng,\Nvà ông ta cai quản toàn bộ Ma vật.
Dialogue: 0,0:06:53.79,0:06:55.80,Italics,Akira,0,0,0,,Rốt cuộc ông ta là người thế nào nhỉ?
Dialogue: 0,0:06:58.03,0:07:01.69,Main,Simon,0,0,0,,Tôi nghĩ nếu cậu làm Ma Vương\Nthì chắc chẳng có vấn đề gì đâu.
Dialogue: 0,0:07:01.69,0:07:05.93,Main,Simon,0,0,0,,Cậu đâu có hứng thú với chuyện chinh phục\Nthế giới hay hủy diệt nhân loại, đúng không?
Dialogue: 0,0:07:06.73,0:07:08.90,Main,Akira,0,0,0,,Hoàn toàn không có chút hứng thú nào.
Dialogue: 0,0:07:08.90,0:07:12.71,Main,Simon,0,0,0,,Thấy chưa? Bản thân ý tưởng đó đâu có sai.
Dialogue: 0,0:07:12.71,0:07:16.00,Main,Akira,0,0,0,,Vậy sao lúc nãy ông lại\Nnói giọng tiêu cực về chuyện đó?
Dialogue: 0,0:07:16.00,0:07:21.24,Main,Simon,0,0,0,,Bởi vì kinh nghiệm yêu đương nghèo nàn\Ncủa cậu ta đang gây ra tác dụng phụ đấy.
Dialogue: 0,0:07:21.24,0:07:23.49,Main,Simon,0,0,0,,Cậu ta thuộc kiểu thanh niên hấp tấp,
Dialogue: 0,0:07:23.49,0:07:26.17,Main,Simon,0,0,0,,âm thầm bày ra đủ thứ kế hoạch bí mật,
Dialogue: 0,0:07:26.17,0:07:29.91,Main,Simon,0,0,0,,rồi đột ngột vác mặt tới tận cửa\Ncầu hôn người ta vậy đó.
Dialogue: 0,0:07:30.79,0:07:35.74,Main,Simon,0,0,0,,Xét ra thì ngay cả Tam Đại Quý Tộc\Ncòn dễ chịu hơn kiểu đó một chút.
Dialogue: 0,0:07:36.30,0:07:41.07,Main,Simon,0,0,0,,Albert đinh ninh rằng làm như vậy\Nlà vì lợi ích của toàn nhân loại.
Dialogue: 0,0:07:41.07,0:07:45.65,Main,Simon,0,0,0,,Còn Tam Đại Quý Tộc thì cơ bản\Nchỉ nghĩ làm thế cho vui thôi.
Dialogue: 0,0:07:46.08,0:07:49.58,Main,Simon,0,0,0,,Cậu thấy bên nào\Ndễ chấp nhận hơn?
Dialogue: 0,0:07:49.94,0:07:55.32,Italics,Akira,0,0,0,,Không gì đáng sợ bằng một kẻ\Ntin chắc tuyệt đối rằng mình đang làm điều đúng.
Dialogue: 0,0:07:55.83,0:07:58.23,Main,Akira,0,0,0,,Cả hai bên đều chẳng khá khẩm gì.
Dialogue: 0,0:07:58.47,0:08:00.67,Main,Akira,0,0,0,,Nhưng sao ông lại mang chuyện này ra nói với tôi?
Dialogue: 0,0:08:00.67,0:08:03.91,Main,Simon,0,0,0,,Chính cậu đã dạy tôi bài học đó còn gì.
Dialogue: 0,0:08:03.91,0:08:07.85,Main,Simon,0,0,0,,Cậu từng bảo muốn biết bản chất một người,\Nhãy nhìn cách họ đối mặt với sai lầm.
Dialogue: 0,0:08:08.32,0:08:11.20,Main,Simon,0,0,0,,Tôi đã suy ngẫm về câu nói ấy rất lâu.
Dialogue: 0,0:08:11.20,0:08:14.50,Main,Simon,0,0,0,,Đó là một góc nhìn độc đáo và xác đáng.
Dialogue: 0,0:08:14.81,0:08:17.61,Main,Simon,0,0,0,,Albert rất xuất chúng ở một khía cạnh nào đó.
Dialogue: 0,0:08:17.61,0:08:21.42,Main,Simon,0,0,0,,Cậu ta chưa từng mắc sai lầm,\Nvà rốt cuộc cứ tự ôm hết mọi việc vào thân.
Dialogue: 0,0:08:21.82,0:08:26.04,Italics,Akira,0,0,0,,Nếu kỹ năng của Hoàng tử đúng như\Nmình phỏng đoán, thì chuyện đó hoàn toàn hợp lý.
Dialogue: 0,0:08:26.04,0:08:30.19,Main,Simon,0,0,0,,Ngay cả lúc gần gũi với vị hôn thê,\Ncậu ta cũng chẳng nói lời nào.
Dialogue: 0,0:08:31.29,0:08:34.19,Italics,Akira,0,0,0,,Hả? Chuyện gì nữa đây?
Dialogue: 0,0:08:34.19,0:08:36.45,Italics,Akira,0,0,0,,Mà sao ông ấy lại biết cả chuyện đó cơ chứ?
Dialogue: 0,0:08:36.69,0:08:41.96,Main,Simon,0,0,0,,Cứ lầm lì tập trung, làm theo đúng cái cách\Nmà {\i1}cậu ta{\i0} cho là tốt nhất.
Dialogue: 0,0:08:44.66,0:08:47.37,Main,Simon,0,0,0,,Cách tiếp cận đó không hẳn là sai hoàn toàn.
Dialogue: 0,0:08:47.37,0:08:49.61,Main,Akira,0,0,0,,Thế thì chẳng phải cũng ổn rồi sao?
Dialogue: 0,0:08:49.61,0:08:51.37,Main,Simon,0,0,0,,À, không ổn chút nào đâu.
Dialogue: 0,0:08:51.75,0:08:54.60,Main,Simon,0,0,0,,Ân ái với phụ nữ\Nlà chuyện của sự giao tiếp.
Dialogue: 0,0:08:54.60,0:08:58.17,Main,Simon,0,0,0,,Sở thích, tình trạng sức khỏe,\Nvà nhịp điệu cảm xúc trong khoảnh khắc đó.
Dialogue: 0,0:08:58.38,0:09:01.91,Main,Simon,0,0,0,,Không thể cứ áp đặt thứ mà riêng mình\Ncho là "tốt nhất" được.
Dialogue: 0,0:09:01.91,0:09:03.25,Main,Akira,0,0,0,,Nghe cũng có lý thật.
Dialogue: 0,0:09:03.51,0:09:07.44,Main,Simon,0,0,0,,Tôi không phản đối chuyện cậu làm Ma Vương,\Nchiến hữu à,
Dialogue: 0,0:09:07.44,0:09:10.57,Main,Simon,0,0,0,,nhưng tôi không thích cái cách\Nép buộc nó lên đầu cậu.
Dialogue: 0,0:09:10.87,0:09:13.73,Main,Simon,0,0,0,,Thế nên tôi mới quyết định\Nnói thẳng hết với cậu.
Dialogue: 0,0:09:14.11,0:09:15.34,Main,Akira,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:09:16.41,0:09:19.08,Main,Simon,0,0,0,,Vì Albert không bao giờ mắc sai lầm,
Dialogue: 0,0:09:19.08,0:09:22.33,Main,Simon,0,0,0,,nên giờ cậu ta có xu hướng\Ntự gánh vác mọi thứ một mình.
Dialogue: 0,0:09:22.54,0:09:25.04,Main,Simon,0,0,0,,Đó chính là sai lầm duy nhất của cậu ta.
Dialogue: 0,0:09:25.04,0:09:29.00,Main,Simon,0,0,0,,Tôi thấy cách xử lý vấn đề\Ncủa cậu thực sự rất tuyệt vời.
Dialogue: 0,0:09:30.24,0:09:32.13,Italics,Akira,0,0,0,,Ông ấy nhìn thấu mình rồi.
Dialogue: 0,0:09:32.13,0:09:34.74,Italics,Akira,0,0,0,,Simon không hài lòng với Hoàng tử\Nvì tự ý hành động
Dialogue: 0,0:09:34.74,0:09:37.18,Italics,Akira,0,0,0,,và cố giải quyết mọi thứ một mình,
Dialogue: 0,0:09:37.62,0:09:40.51,Italics,Akira,0,0,0,,còn mình chủ động tìm tới đây lại được ông ấy tán đồng.
Dialogue: 0,0:09:40.51,0:09:46.10,Italics,Akira,0,0,0,,Ông ấy mở lời chuyện này vì nhận ra\Nmình đang muốn nhờ giúp đỡ vào thời khắc quyết định.
Dialogue: 0,0:09:46.39,0:09:50.15,Main,Akira,0,0,0,,Simon, tôi cần phải làm gì\Nđể gia nhập giới quý tộc loài người?
Dialogue: 0,0:09:57.55,0:09:59.69,Main,Akira,0,0,0,,Ch-Chào buổi sáng.
Dialogue: 0,0:10:00.15,0:10:01.70,Main,Karen,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:10:02.37,0:10:04.80,Italics,Akira,0,0,0,,Mình lỡ làm gì phật ý cô ấy sao?
Dialogue: 0,0:10:04.80,0:10:06.59,Italics,Akira,0,0,0,,Những lúc thế này, phải đoán trúng phóc
Dialogue: 0,0:10:06.59,0:10:09.15,Italics,Akira,0,0,0,,lý do cô ấy giận,\Nkhông thì mình tiêu đời mất!
Dialogue: 0,0:10:09.15,0:10:11.47,Italics,Akira,0,0,0,,Nghĩ đi nào. Mình đã làm gì chứ?!
Dialogue: 0,0:10:14.14,0:10:15.67,Main,Karen,0,0,0,,Thôi bỏ đi.
Dialogue: 0,0:10:16.05,0:10:18.74,Main,Karen,0,0,0,,Cậu đã bàn bạc xong với\NPhiên Hầu chưa?
Dialogue: 0,0:10:19.10,0:10:21.35,Main,Akira,0,0,0,,À, ư-ừ.
Dialogue: 0,0:10:21.57,0:10:23.51,Main,Akira,0,0,0,,Ông ấy nói cho tôi biết nhiều điều quan trọng lắm.
Dialogue: 0,0:10:24.05,0:10:25.80,Main,Karen,0,0,0,,Chẳng hạn như chuyện gì?
Dialogue: 0,0:10:26.18,0:10:29.22,Main,Akira,0,0,0,,Về cách gia nhập hàng ngũ quý tộc loài người.
Dialogue: 0,0:10:29.61,0:10:31.13,Main,Karen,0,0,0,,Cậu định làm quý tộc sao?
Dialogue: 0,0:10:31.13,0:10:31.98,Main,Akira,0,0,0,,Ừ.
Dialogue: 0,0:10:32.36,0:10:35.22,Main,Akira,0,0,0,,Tôi đang tính ký một thỏa thuận như thế.
Dialogue: 0,0:10:35.22,0:10:38.23,Main,Akira,0,0,0,,Để tôi có thể trở thành chủ nhân hợp pháp của khu rừng này.
Dialogue: 0,0:10:38.53,0:10:40.39,Main,Karen,0,0,0,,Sao cậu lại làm chuyện đó?
Dialogue: 0,0:10:40.39,0:10:45.14,Main,Akira,0,0,0,,Karen, nếu không đi đường tắt để thành công\Nthì cô sẽ làm thế nào?
Dialogue: 0,0:10:45.14,0:10:46.99,Main,Karen,0,0,0,,{\i1}Không{\i0} đi đường tắt á?
Dialogue: 0,0:10:46.99,0:10:49.16,Main,Karen,0,0,0,,Tôi còn chưa từng nghĩ đến chuyện đó bao giờ.
Dialogue: 0,0:10:49.42,0:10:51.74,Main,Akira,0,0,0,,Thể chế, hệ thống...
Dialogue: 0,0:10:51.74,0:10:55.58,Main,Akira,0,0,0,,Có nhiều cách gọi lắm, nhưng tôi nghĩ\Ncách đơn giản nhất là hòa nhập vào trong nó.
Dialogue: 0,0:10:55.58,0:11:00.10,Main,Karen,0,0,0,,Hiểu rồi. Gia nhập vào hệ thống trước,\Nrồi từng bước leo lên bậc thang quyền lực?
Dialogue: 0,0:11:00.30,0:11:04.56,Main,Akira,0,0,0,,Đúng thế. Nấc thang cuộc đời\Nthường là một con đường thẳng tắp,
Dialogue: 0,0:11:04.56,0:11:08.33,Main,Akira,0,0,0,,đã đặt chân lên rồi thì mấy lối đi tắt\Nlớn lao hiếm khi xuất hiện lắm.
Dialogue: 0,0:11:08.33,0:11:10.27,Main,Karen,0,0,0,,Cậu không muốn tạo dựng\Ndanh tiếng vang dội à?
Dialogue: 0,0:11:10.70,0:11:12.98,Main,Akira,0,0,0,,Chính vì muốn thế mà tôi mới ra nông nỗi này đấy.
Dialogue: 0,0:11:13.34,0:11:16.24,Main,Akira,0,0,0,,Tôi không mong cầu thứ gì quá to tát đâu.
Dialogue: 0,0:11:16.77,0:11:18.07,Main,Akira,0,0,0,,Ý kiến của cô thế nào?
Dialogue: 0,0:11:18.33,0:11:21.77,Main,Karen,0,0,0,,Đã là ý tưởng của cậu\Nthì chắc chắn không tồi rồi.
Dialogue: 0,0:11:22.19,0:11:24.45,Italics,Akira,0,0,0,,Cô ấy tin tưởng mình thật đấy.
Dialogue: 0,0:11:24.68,0:11:27.86,Main,Karen,0,0,0,,Vậy cậu phải làm gì\Nmới trở thành quý tộc được?
Dialogue: 0,0:11:28.06,0:11:30.99,Flashback,Simon,0,0,0,,Lên chức Nam tước thì đơn giản thôi.
Dialogue: 0,0:11:30.99,0:11:33.86,Flashback,Simon,0,0,0,,Tôi là Phiên Hầu, nên cậu chỉ cần\Nký kết khế ước với tôi,
Dialogue: 0,0:11:33.86,0:11:36.00,Flashback,Simon,0,0,0,,rồi nộp một khoản tiền và cung cấp binh lực
Dialogue: 0,0:11:36.00,0:11:38.72,Flashback,Simon,0,0,0,,tương xứng với quy mô\Nlãnh thổ của cậu là xong.
Dialogue: 0,0:11:39.91,0:11:45.54,Main,Akira,0,0,0,,Thế nên đôi lúc một vài thành viên Đội Hanzo\Nsẽ phải đi viễn chinh xa nhà đấy.
Dialogue: 0,0:11:45.54,0:11:46.97,Main,Hanzo VII,0,0,0,,Chuyện nhỏ thôi ạ.
Dialogue: 0,0:11:46.97,0:11:48.89,Main,Akira,0,0,0,,Ồ, cậu đồng ý luôn à?
Dialogue: 0,0:11:48.89,0:11:51.69,Main,Hanzo VII,0,0,0,,Dù sao thì cũng giống như\Nnhóm của Echigoya thôi mà.
Dialogue: 0,0:11:51.69,0:11:53.47,Main,Hanzo VII,0,0,0,,Nên em sẵn lòng nhận nhiệm vụ ngay.
Dialogue: 0,0:11:53.47,0:11:55.45,Main,Akira,0,0,0,,Cảm ơn cậu nhé, Hanzo.
Dialogue: 0,0:11:56.42,0:11:59.44,Main,Akira,0,0,0,,Giờ chỉ còn đúng một vấn đề nữa thôi.
Dialogue: 0,0:11:59.44,0:12:00.68,Main,Hanzo VII,0,0,0,,Hửm?
Dialogue: 0,0:12:00.68,0:12:04.52,Main,Akira,0,0,0,,Tôi muốn cử những người\Nnhìn vào là thấy mạnh mẽ ngay.
Dialogue: 0,0:12:04.52,0:12:06.99,Main,Akira,0,0,0,,Thực lực có mạnh thật hay không cũng không quan trọng.
Dialogue: 0,0:12:06.99,0:12:09.50,Main,Akira,0,0,0,,Tôi muốn họ toát ra đúng khí chất\Ncủa một "chiến binh".
Dialogue: 0,0:12:09.50,0:12:14.12,Main,Akira,0,0,0,,Vì cung cấp quân lực cho Simon,\Nnên ngoại hình cũng phải ra dáng một chút.
Dialogue: 0,0:12:14.60,0:12:17.98,Main,Akira,0,0,0,,Hiện tại trong Đội Hanzo\Nkhông có nhiều người như vậy nhỉ?
Dialogue: 0,0:12:17.98,0:12:19.76,Main,Hanzo VII,0,0,0,,Thôn trưởng nói có lý thật.
Dialogue: 0,0:12:19.76,0:12:21.92,Main,Izyz,0,0,0,,Vậy dùng rồng thì sao?
Dialogue: 0,0:12:21.92,0:12:25.41,Main,Akira,0,0,0,,I-Izyz! "Rồng" là có ý gì cơ?
Dialogue: 0,0:12:25.41,0:12:27.92,Main,Izyz,0,0,0,,Loài người chẳng phải vẫn có\Nkỵ sĩ cưỡi ngựa đánh trận sao?
Dialogue: 0,0:12:27.92,0:12:29.34,Main,Izyz,0,0,0,,Kiểu đại loại thế đấy.
Dialogue: 0,0:12:29.34,0:12:31.00,Main,Akira,0,0,0,,Long Kỵ Sĩ hả?
Dialogue: 0,0:12:31.00,0:12:33.31,Main,Akira,0,0,0,,Nếu làm được thì tôi chẳng có gì phải ngại cả.
Dialogue: 0,0:12:34.21,0:12:35.53,Main,Akira,0,0,0,,Mà làm được thật sao?
Dialogue: 0,0:12:35.53,0:12:38.44,Main,Izyz,0,0,0,,Ta cung cấp vài đứa trong tộc ta thì có khó gì.
Dialogue: 0,0:12:38.75,0:12:41.60,Main,Akira,0,0,0,,Sao ông lại nhiệt tình giúp đỡ đến thế?
Dialogue: 0,0:12:41.60,0:12:45.41,Main,Izyz,0,0,0,,Nhìn ta thế này thôi chứ\Nta sống thọ lắm đấy.
Dialogue: 0,0:12:45.41,0:12:47.55,Main,Akira,0,0,0,,Đầu tư đón đầu xu hướng từ sớm hả?
Dialogue: 0,0:12:47.55,0:12:48.82,Main,Akira,0,0,0,,Vậy xin nhờ cậy ông nhé.
Dialogue: 0,0:12:48.82,0:12:50.62,Main,Izyz,0,0,0,,Được, để ta gọi chúng nó tới thử xem.
Dialogue: 0,0:12:50.62,0:12:52.55,Main,Akira,0,0,0,,Ông gọi được ngay bây giờ luôn á?!
Dialogue: 0,0:13:12.84,0:13:14.06,Main,Albert,0,0,0,,Kia là...
Dialogue: 0,0:13:14.56,0:13:16.52,Italics,Albert,0,0,0,,Mất cậu ta vào lúc này thì...
Dialogue: 0,0:13:17.28,0:13:21.65,Italics,Albert,0,0,0,,Quá Tam Bát Bận không thể quay ngược\Nnhững chuyện mà ta không trực tiếp tham gia.
Dialogue: 0,0:13:21.93,0:13:23.43,Italics,Albert,0,0,0,,Phải nhanh lên mới được!
Dialogue: 0,0:13:31.84,0:13:34.19,Italics,Akira,0,0,0,,Chúng ngoan ngoãn chờ lệnh như chó trung thành vậy.
Dialogue: 0,0:13:34.19,0:13:36.58,Italics,Akira,0,0,0,,Nhìn đúng là đồng tộc với ông ấy thật.
Dialogue: 0,0:13:36.58,0:13:38.92,Main,Akira,0,0,0,,Hai con rồng này chịu cho bọn tôi cưỡi sao?
Dialogue: 0,0:13:38.92,0:13:40.20,Main,Izyz,0,0,0,,Chắc chắn rồi.
Dialogue: 0,0:13:40.20,0:13:42.50,Main,Izyz,0,0,0,,Hai đứa bay, cho tụi nó leo lên lưng đi.
Dialogue: 0,0:13:43.42,0:13:45.44,Main,Akira,0,0,0,,Cậu thấy cưỡi được không?
Dialogue: 0,0:13:45.93,0:13:47.13,Main,Hanzo VII,0,0,0,,Để em thử xem sao ạ!
Dialogue: 0,0:13:51.47,0:13:52.14,Sign_Basic,text,0,0,0,,CƯỠI THÚ
Dialogue: 0,0:13:52.52,0:13:54.12,Main,Hanzo VII,0,0,0,,Nào, xuất phát!
Dialogue: 0,0:13:57.49,0:13:58.98,Main,Karen,0,0,0,,Ấn tượng thật đấy.
Dialogue: 0,0:13:58.98,0:14:00.81,Main,Karen,0,0,0,,Không cần dây cương lẫn yên ngựa luôn.
Dialogue: 0,0:14:00.81,0:14:03.60,Main,Akira,0,0,0,,Chắc chắn là nhờ cậu ấy có kỹ năng Cưỡi Thú đấy.
Dialogue: 0,0:14:03.60,0:14:05.00,Main,Karen,0,0,0,,Thảo nào.
Dialogue: 0,0:14:05.00,0:14:08.07,Main,Karen,0,0,0,,Cái hệ thống cậu lập ra\Nphát huy tác dụng ghê thật.
Dialogue: 0,0:14:08.07,0:14:09.34,Main,Akira,0,0,0,,Đúng vậy.
Dialogue: 0,0:14:09.34,0:14:10.50,Main,Akira,0,0,0,,Nào.
Dialogue: 0,0:14:11.90,0:14:13.36,Main,Akira,0,0,0,,Tôi quay lại ngay đây.
Dialogue: 0,0:14:14.66,0:14:16.32,Main,Hanzo VII,0,0,0,,Ồ, Thôn trưởng.
Dialogue: 0,0:14:16.32,0:14:17.54,Main,Hanzo VII,0,0,0,,Ngồi trên này sướng lắm luôn—
Dialogue: 0,0:14:17.54,0:14:18.51,Main,Akira,0,0,0,,Bắt đầu nào.
Dialogue: 0,0:14:22.43,0:14:24.75,Main,Hanzo VII,0,0,0,,Em hiểu rồi, Thôn trưởng!
Dialogue: 0,0:14:24.75,0:14:27.92,Sign_Basic,text,0,0,0,,GIẢ KIM THUẬT
Dialogue: 0,0:14:25.29,0:14:26.42,Main,Hanzo VII,0,0,0,,Giả Kim Thuật!
Dialogue: 0,0:14:34.69,0:14:37.98,Main,Karen,0,0,0,,Đúng là Hanzo có khác.\NCảm quan chiến đấu đỉnh thật.
Dialogue: 0,0:14:38.21,0:14:40.04,Main,Karen,0,0,0,,Cậu ấy đang dồn Akira vào thế yếu rồi.
Dialogue: 0,0:14:40.04,0:14:41.70,Main,Izyz,0,0,0,,Akira mới là người nắm lợi thế.
Dialogue: 0,0:14:41.70,0:14:43.24,Main,Karen,0,0,0,,Ý ông là sao?
Dialogue: 0,0:14:43.24,0:14:45.49,Main,Izyz,0,0,0,,Hai đứa nó là thầy với trò đấy.
Dialogue: 0,0:14:47.11,0:14:50.45,Main,Izyz,0,0,0,,Nhìn giống sư phụ đang rèn luyện cho đệ tử vậy.
Dialogue: 0,0:14:50.83,0:14:54.86,Main,Karen,0,0,0,,Đúng thật, trông Akira\Nđúng là đang nương tay.
Dialogue: 0,0:14:55.21,0:14:57.36,Main,Izyz,0,0,0,,Kinh nghiệm thực chiến của hai đứa cũng khác xa nhau.
Dialogue: 0,0:14:58.07,0:14:59.06,Main,Izyz,0,0,0,,Thấy chưa?
Dialogue: 0,0:15:01.01,0:15:02.34,Main,Hanzo VII,0,0,0,,Trúng rồi nhé!
Dialogue: 0,0:15:08.04,0:15:09.92,Main,Akira,0,0,0,,Phân thắng bại rồi đấy.
Dialogue: 0,0:15:14.26,0:15:16.65,Main,Hanzo VII,0,0,0,,Đỉnh quá, Thôn trưởng! Ngài mạnh thật đấy!
Dialogue: 0,0:15:16.65,0:15:18.08,Main,Akira,0,0,0,,Cậu cũng giỏi lắm, Hanzo.
Dialogue: 0,0:15:18.08,0:15:21.07,Main,Akira,0,0,0,,Lần đầu cưỡi rồng mà điều khiển được\Nnhư vậy là quá xuất sắc rồi.
Dialogue: 0,0:15:21.07,0:15:22.50,Main,Hanzo VII,0,0,0,,Thật sao ạ?!
Dialogue: 0,0:15:22.50,0:15:28.02,Main,Akira,0,0,0,,Khác với ngựa, rồng còn biết cắn\Nvà cào xé bằng móng vuốt nữa.
Dialogue: 0,0:15:28.36,0:15:29.76,Main,Akira,0,0,0,,Nếu cậu làm chủ được những đòn đó,
Dialogue: 0,0:15:29.76,0:15:32.96,Main,Akira,0,0,0,,cậu sẽ có thể tung đòn đánh\Ntừ điểm mù của kẻ địch.
Dialogue: 0,0:15:32.96,0:15:35.12,Main,Hanzo VII,0,0,0,,Vâng, nghe khả thi đấy ạ.
Dialogue: 0,0:15:35.85,0:15:36.99,Main,Hanzo VII,0,0,0,,Này, chị Karen ơi.
Dialogue: 0,0:15:37.35,0:15:39.39,Main,Hanzo VII,0,0,0,,Chị thấy trận đấu vừa rồi thế nào ạ?
Dialogue: 0,0:15:39.39,0:15:43.00,Main,Karen,0,0,0,,Cậu tuyệt lắm,\Nchẳng kém gì một kỵ sĩ hạng nhất cả.
Dialogue: 0,0:15:43.00,0:15:46.37,Main,Hanzo VII,0,0,0,,Thật ạ? Em còn cả khối chiêu\Nmuốn thử nghiệm nữa cơ!
Dialogue: 0,0:15:46.69,0:15:51.01,Italics,Akira,0,0,0,,Thấy tụi nhỏ đứa nào cũng thân mật gọi\N"chị Karen" mà ấm lòng thật,
Dialogue: 0,0:15:51.01,0:15:55.28,Italics,Akira,0,0,0,,cứ như chúng truyền thừa cả ký ức\Nqua từng thế hệ vậy.
Dialogue: 0,0:16:01.31,0:16:02.64,Main,Akira,0,0,0,,Albert!
Dialogue: 0,0:16:02.64,0:16:04.96,Main,Akira,0,0,0,,À, Điện hạ! Gió nào thổi ngài tới đây thế?
Dialogue: 0,0:16:05.28,0:16:06.70,Main,Albert,0,0,0,,Akira.
Dialogue: 0,0:16:08.87,0:16:12.28,Main,Albert,0,0,0,,Xem ra cậu {\i1}không phải{\i0} đang đánh nhau\Nvới Hắc Thiên Long nhỉ.
Dialogue: 0,0:16:12.53,0:16:14.69,Main,Akira,0,0,0,,Ồ, hoàn toàn không có chuyện đó đâu ạ.
Dialogue: 0,0:16:14.69,0:16:16.48,Main,Albert,0,0,0,,Ta vội vàng suy đoán nhầm rồi.
Dialogue: 0,0:16:16.85,0:16:19.62,Main,Albert,0,0,0,,Thôi, không có chuyện gì\Nthì tốt rồi.
Dialogue: 0,0:16:19.97,0:16:21.08,Main,Albert,0,0,0,,Khởi động lại.
Dialogue: 0,0:16:26.74,0:16:28.07,Main,Akira,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:16:28.84,0:16:30.97,Main,Izyz,0,0,0,,Chẳng có gì đâu.
Dialogue: 0,0:16:33.19,0:16:35.30,Main,Hanzo VII,0,0,0,,Đánh nhau xong mày đói bụng rồi à?
Dialogue: 0,0:16:36.97,0:16:39.47,Italics,Akira,0,0,0,,Rồng thì ăn cái gì nhỉ...?
Dialogue: 0,0:16:44.48,0:16:48.46,Main,Akira,0,0,0,,Mày cũng ăn thứ này được không?
Dialogue: 0,0:16:47.48,0:16:48.94,Sign_Basic,text,0,0,0,,LIỆT HỎA
Dialogue: 0,0:16:58.80,0:17:00.20,Italics,Akira,0,0,0,,Hỏa long sao?
Dialogue: 0,0:17:00.20,0:17:02.39,Italics,Akira,0,0,0,,Nó biến đổi vì\Nnuốt kỹ năng đó à?
Dialogue: 0,0:17:02.39,0:17:04.67,Main,Akira,0,0,0,,Izyz, chuyện gì vừa xảy ra thế?!
Dialogue: 0,0:17:06.10,0:17:08.51,Main,Izyz,0,0,0,,Cậu vừa làm cái quái gì vậy?
Dialogue: 0,0:17:09.83,0:17:12.54,Italics,Akira,0,0,0,,Mình có cảm giác như con ếch\Nbị rắn độc nhìn chằm chằm vậy.
Dialogue: 0,0:17:14.27,0:17:15.72,Main,Akira,0,0,0,,Tôi làm gì á?
Dialogue: 0,0:17:15.72,0:17:19.42,Main,Akira,0,0,0,,Tôi cho nó ăn kỹ năng giống hệt lúc cho ông ăn thôi.
Dialogue: 0,0:17:19.42,0:17:20.92,Main,Akira,0,0,0,,Làm thế không ổn sao?
Dialogue: 0,0:17:25.49,0:17:28.34,Italics,Akira,0,0,0,,Con rồng to lớn thế kia mà cũng sợ ông ta.
Dialogue: 0,0:17:28.34,0:17:32.49,Italics,Akira,0,0,0,,Izyz kiểm soát toàn bộ tình huống\Nchỉ bằng một ánh nhìn.
Dialogue: 0,0:17:34.03,0:17:37.92,Main,Izyz,0,0,0,,Bất ngờ thật đấy. Ta không hề biết\Nchuyện kiểu này có thể xảy ra.
Dialogue: 0,0:17:38.63,0:17:41.52,Main,Izyz,0,0,0,,Chà! Nhìn ngầu đét luôn đấy, anh bạn.
Dialogue: 0,0:17:41.84,0:17:44.94,Main,Akira,0,0,0,,Đây là lần đầu tiên\Nông thấy cảnh này sao?
Dialogue: 0,0:17:44.94,0:17:48.02,Main,Izyz,0,0,0,,Ừ, theo ta biết thì đúng là lần đầu tiên.
Dialogue: 0,0:17:48.02,0:17:49.44,Main,Izyz,0,0,0,,Chưa từng có tiền lệ luôn.
Dialogue: 0,0:17:49.44,0:17:53.01,Main,Akira,0,0,0,,Đến cả {\i1}ông{\i0} mà cũng bảo chưa từng nghe thấy,\Nthì nghe hơi đáng sợ đấy.
Dialogue: 0,0:17:53.01,0:17:55.42,Main,Karen,0,0,0,,Chẳng phải ông cũng hay ăn kỹ năng sao?
Dialogue: 0,0:17:55.42,0:17:58.64,Main,Izyz,0,0,0,,Bình thường ăn kỹ năng\Nđâu có sinh ra chuyện này.
Dialogue: 0,0:17:58.64,0:18:00.13,Main,Akira,0,0,0,,Với bọn nó cũng thế à?
Dialogue: 0,0:18:00.51,0:18:01.35,Main,Izyz,0,0,0,,Ừ.
Dialogue: 0,0:18:01.35,0:18:06.25,Main,Akira,0,0,0,,Chúng vẫn ăn kỹ năng đều đặn,\Nnhưng chưa bao giờ biến đổi thế này sao?
Dialogue: 0,0:18:06.25,0:18:08.26,Main,Izyz,0,0,0,,Mày còn thấy chỗ nào thay đổi nữa không?
Dialogue: 0,0:18:11.19,0:18:13.01,Main,Hanzo VII,0,0,0,,Ồ, đỉnh quá!
Dialogue: 0,0:18:13.01,0:18:15.24,Main,Izyz,0,0,0,,Thay đổi hoàn toàn luôn rồi.
Dialogue: 0,0:18:15.24,0:18:16.79,Main,Akira,0,0,0,,Thật sao?
Dialogue: 0,0:18:16.79,0:18:19.28,Main,Izyz,0,0,0,,Này, cậu thử làm thêm lần nữa xem?
Dialogue: 0,0:18:19.28,0:18:20.05,Main,Akira,0,0,0,,Được thôi.
Dialogue: 0,0:18:24.18,0:18:26.09,Main,Akira,0,0,0,,Chẳng có gì xảy ra cả.
Dialogue: 0,0:18:26.09,0:18:28.41,Main,Izyz,0,0,0,,Chuyện này có nghĩa là gì nhỉ?
Dialogue: 0,0:18:28.41,0:18:30.11,Main,Akira,0,0,0,,Còn con kia thì sao?
Dialogue: 0,0:18:30.87,0:18:32.63,Sign_Basic,text,0,0,0,,TIA ĐIỆN
Dialogue: 0,0:18:38.11,0:18:39.17,Main,Akira,0,0,0,,Quả nhiên là vậy!
Dialogue: 0,0:18:39.17,0:18:40.63,Main,Izyz,0,0,0,,Nó tiến hóa rồi.
Dialogue: 0,0:18:41.91,0:18:43.93,Main,Akira,0,0,0,,Không biết chúng còn ăn thêm được nữa không.
Dialogue: 0,0:18:45.84,0:18:46.95,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:18:46.95,0:18:50.88,Main,Hanzo VII,0,0,0,,Thôn trưởng ơi, chắc nó no rồi đấy ạ.
Dialogue: 0,0:18:50.88,0:18:51.92,Main,Hanzo VII,0,0,0,,Phải không nào?
Dialogue: 0,0:18:56.34,0:18:58.65,Italics,Akira,0,0,0,,Bọn họ thân thiết nhanh thật đấy.
Dialogue: 0,0:18:59.30,0:19:04.32,Main,Karen,0,0,0,,Akira, trước đây cậu chẳng phải từng\Ntiến hóa kỹ năng cho Chloe với Hanzo sao?
Dialogue: 0,0:19:04.32,0:19:06.24,Main,Akira,0,0,0,,Ừ, đúng vậy.
Dialogue: 0,0:19:06.48,0:19:10.53,Main,Karen,0,0,0,,Và những kỹ năng đó chẳng phải\Nmạnh hơn kỹ năng thông thường rất nhiều à?
Dialogue: 0,0:19:14.54,0:19:16.53,Italics,Akira,0,0,0,,Mọi câu hỏi đều ẩn chứa mục đích riêng.
Dialogue: 0,0:19:16.53,0:19:18.01,Italics,Akira,0,0,0,,Mình hiểu ý của Karen rồi.
Dialogue: 0,0:19:18.26,0:19:20.34,Main,Akira,0,0,0,,Để tôi thử cho nó ăn\Nmột kỹ năng bậc cao hơn xem.
Dialogue: 0,0:19:20.78,0:19:21.85,Main,Akira,0,0,0,,Lôi Đình.
Dialogue: 0,0:19:21.97,0:19:24.68,Sign_Basic,text,0,0,0,,LÔI ĐÌNH
Dialogue: 0,0:19:22.22,0:19:24.67,Main,Akira,0,0,0,,Kỹ năng này là do một Hanzo tiền nhiệm\Nđể lại cho tôi đấy.
Dialogue: 0,0:19:39.43,0:19:41.40,Main,Izyz,0,0,0,,Ấn tượng thật đấy.
Dialogue: 0,0:19:41.40,0:19:43.60,Main,Hanzo VII,0,0,0,,Nó còn to hơn nữa, nhìn mạnh mẽ hẳn ra!
Dialogue: 0,0:19:43.99,0:19:45.16,Italics,Akira,0,0,0,,Thám Thị Nhãn.
Dialogue: 0,0:19:44.57,0:19:45.53,Sign_Basic,text,0,0,0,,THÁM THỊ NHÃN
Dialogue: 0,0:19:46.49,0:19:47.95,Sign_Basic,text,0,0,0,,KHÔNG CÓ KỸ NĂNG
Dialogue: 0,0:19:47.94,0:19:51.10,Main,Akira,0,0,0,,Vậy là cả hai con rồng\Nđều không sở hữu kỹ năng nào cả.
Dialogue: 0,0:19:51.10,0:19:52.40,Main,Izyz,0,0,0,,Đúng thế.
Dialogue: 0,0:19:52.40,0:19:54.36,Main,Izyz,0,0,0,,Nghĩa là chẳng có gì để ta ăn hết.
Dialogue: 0,0:19:55.02,0:19:58.26,Main,Akira,0,0,0,,Ừ, đúng là kiểu đánh giá\Nđặc trưng của ông thật.
Dialogue: 0,0:19:58.26,0:20:00.88,Main,Akira,0,0,0,,Tôi cũng muốn thử nghiệm thêm chút nữa,
Dialogue: 0,0:20:00.88,0:20:03.50,Main,Akira,0,0,0,,nhưng có vẻ con này cũng no căng rồi.
Dialogue: 0,0:20:05.71,0:20:07.71,Main,Akira,0,0,0,,Ngày mai chúng ta sẽ lại tập trận tiếp.
Dialogue: 0,0:20:07.71,0:20:08.78,Main,Hanzo VII,0,0,0,,Rõ ạ!
Dialogue: 0,0:20:08.78,0:20:11.44,Main,Hanzo VII,0,0,0,,À, nhưng ngày mai cho em ghé về nhà một lát được không?
Dialogue: 0,0:20:11.44,0:20:13.60,Main,Akira,0,0,0,,Chắc là không vấn đề gì đâu.
Dialogue: 0,0:20:13.60,0:20:15.64,Main,Hanzo VII,0,0,0,,May quá. Nhẹ cả người.
Dialogue: 0,0:20:17.80,0:20:22.25,Main,Hanzo VII,0,0,0,,Em đã hứa đánh xong trận đó\Nsẽ về sinh một đứa con mà.
Dialogue: 0,0:20:22.25,0:20:24.23,Main,Akira,0,0,0,,Đừng có tự cắm cờ tử thần kiểu đó chứ!
Dialogue: 0,0:20:29.75,0:20:31.82,Main,Kainas,0,0,0,,Cảm ơn nhé, Echigoya.
Dialogue: 0,0:20:31.82,0:20:32.79,Main,Echigoya VIII,0,0,0,,Hả?
Dialogue: 0,0:20:33.82,0:20:36.51,Main,Kainas,0,0,0,,Vì đã may quần áo cho con gái tôi.
Dialogue: 0,0:20:37.76,0:20:41.04,Flashback,Kainas's daughter,0,0,0,,Hoan hô! Con cứ mơ ước mãi\Nmột bộ đồ nhà Echigoya!
Dialogue: 0,0:20:41.04,0:20:42.95,Flashback,Kainas's daughter,0,0,0,,Con cảm ơn bố nhiều lắm!
Dialogue: 0,0:20:43.25,0:20:48.12,Main,Echigoya VIII,0,0,0,,Bọn cháu được yên tâm buôn bán\Nlà nhờ chú Kainas bảo vệ cả đấy ạ.
Dialogue: 0,0:20:48.12,0:20:50.30,Main,Echigoya VIII,0,0,0,,Chút quà mọn ấy có đáng gì đâu!
Dialogue: 0,0:20:51.08,0:20:53.90,Main,Kainas,0,0,0,,Tôi chỉ làm đúng nhiệm vụ thôi.
Dialogue: 0,0:20:53.90,0:20:56.52,Main,Echigoya VIII,0,0,0,,Chú thương con gái mình lắm nhỉ?
Dialogue: 0,0:20:56.80,0:20:58.48,Main,Kainas,0,0,0,,Con bé là bảo bối của tôi.
Dialogue: 0,0:20:58.48,0:21:00.54,Main,Kainas,0,0,0,,Có đổi cả thế giới tôi cũng chẳng màng.
Dialogue: 0,0:21:00.89,0:21:03.69,Main,Echigoya VIII,0,0,0,,Cháu cũng muốn sớm có con của riêng mình quá!
Dialogue: 0,0:21:03.69,0:21:05.03,Main,Kainas,0,0,0,,Ồ, thế à?
Dialogue: 0,0:21:05.03,0:21:06.72,Main,Echigoya VIII,0,0,0,,Cháu sẽ đẻ thật nhiều luôn!
Dialogue: 0,0:21:06.72,0:21:10.13,Main,Echigoya VIII,0,0,0,,Không biết con gái chú\Ncũng sắp sinh em bé chưa nhỉ?
Dialogue: 0,0:21:11.86,0:21:13.49,Main,Kainas,0,0,0,,Sinh... em bé á?
Dialogue: 0,0:21:13.80,0:21:17.92,Main,Kainas,0,0,0,,"Xin chú hãy gả con gái\Ncho cháu..."
Dialogue: 0,0:21:16.53,0:21:17.93,Main - Top,Echigoya VIII,0,0,0,,Chú Kainas ơi?
Dialogue: 0,0:21:17.93,0:21:21.74,Main - Top,Kainas,0,0,0,,Chết đi, tên khốn!
Dialogue: 0,0:21:21.74,0:21:23.75,Main - Top,Kainas,0,0,0,,Tao đời nào chịu gả con gái cho hạng như mày!
Dialogue: 0,0:21:20.74,0:21:25.31,Main,Echigoya VIII,0,0,0,,Cháu chả hiểu chuyện gì đang xảy ra,\Nnhưng cháu xin lỗi! Cháu xin lỗi ạ!
Dialogue: 0,0:21:28.81,0:21:30.79,Main,Kainas,0,0,0,,Lùi lại đi, Echigoya.
Dialogue: 0,0:21:34.60,0:21:35.73,Main,Kainas,0,0,0,,Mau chạy đi!
Dialogue: 0,0:21:40.59,0:21:42.15,Main,Echigoya VIII,0,0,0,,Chú Kainas!
Dialogue: 0,0:21:42.48,0:21:45.04,Main,Genesis,0,0,0,,Khá lắm đấy, đối với một con người.
Dialogue: 0,0:21:54.79,0:21:55.91,Sign_Basic,text,0,0,0,,CẢNH BÁO
Dialogue: 0,0:21:56.63,0:21:58.42,Main,Hanzo VII,0,0,0,,Có chuyện gì thế, Thôn trưởng?
Dialogue: 0,0:21:58.42,0:22:02.40,Main,Akira,0,0,0,,Tôi có gắn kỹ năng Cảnh Báo lên người\NEchigoya để phòng bất trắc.
Dialogue: 0,0:22:02.40,0:22:03.86,Main,Akira,0,0,0,,Trông chừng ngôi làng nhé!
Dialogue: 0,0:22:03.86,0:22:04.87,Main,Hanzo VII,0,0,0,,Rõ ạ!
Dialogue: 0,0:22:07.12,0:22:09.55,Italics,Akira,0,0,0,,Echigoya, làm ơn đừng xảy ra chuyện gì nhé.
Dialogue: 0,0:22:10.64,0:22:14.98,Sign_Basic,Credit,0,0,0,,{\an8}DỊCH THUẬT: Amtia(NOFACE)
Dialogue: 0,0:22:15.15,0:22:19.44,Sign_Basic,Credit,0,0,0,,{\an8}CANH THỜI GIAN: Amtia(NOFACE)\NBIÊN TẬP: Amtia(NOFACE)
Dialogue: 0,0:22:24.07,0:22:27.15,Sign_Basic,Credit,0,0,0,,{\an8}KIỂM ĐỊNH CHẤT LƯỢNG: Amtia(NOFACE)\NHOÀN THIỆN PHỤ ĐỀ: Amtia(NOFACE)

