Dialogue: 0,0:00:02.42,0:00:03.89,Main,goblin 62,0,0,0,,Chính là nó rồi.
Dialogue: 0,0:00:03.89,0:00:05.80,Main,Akira,0,0,0,,Được rồi, để tôi lo.
Dialogue: 0,0:00:06.09,0:00:07.56,Main,Akira,0,0,0,,Đại Trị Liệu.
Dialogue: 0,0:00:06.23,0:00:07.56,Sign_Basic,text,0,0,0,,ĐẠI TRỊ LIỆU
Dialogue: 0,0:00:08.90,0:00:10.28,Sign_Basic,text,0,0,0,,THẤU THỊ NHÃN (SEARCH EYE)
Dialogue: 0,0:00:10.28,0:00:12.49,Sign_Basic,text,0,0,0,,CHẤN ĐỘNG THẾ GIỚI (WORLD-SHAKER)
Dialogue: 0,0:00:08.75,0:00:10.27,Main,Akira,0,0,0,,Một con rồng non sao?
Dialogue: 0,0:00:12.48,0:00:15.20,Italics,Akira,0,0,0,,Lại còn sở hữu kỹ năng độc nhất Chấn Động Thế Giới nữa à?!
Dialogue: 0,0:00:15.20,0:00:17.59,Italics,Akira,0,0,0,,Nhóc con này {\i0}rốt cuộc là{\i1} ai vậy?
Dialogue: 0,0:00:19.03,0:00:21.45,Main,goblin 63,0,0,0,,Thôn trưởng ơi, ổn cả không ạ?
Dialogue: 0,0:00:21.45,0:00:23.80,Main,Akira,0,0,0,,Chắc lát nữa nó sẽ tỉnh lại thôi.
Dialogue: 0,0:00:23.80,0:00:25.17,Main,goblin 64,0,0,0,,Không phải chuyện đó!
Dialogue: 0,0:00:25.17,0:00:27.38,Main,goblin 63,0,0,0,,{\i1}Ngài{\i0} có sao không ạ, Thôn trưởng?!
Dialogue: 0,0:00:28.36,0:00:29.81,Main,Akira,0,0,0,,Tôi không sao đâu.
Dialogue: 0,0:00:30.35,0:00:31.51,Main,Akira,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:00:31.51,0:00:32.79,Main,goblin 64,0,0,0,,May quá!
Dialogue: 0,0:00:33.21,0:00:36.21,Main,Akira,0,0,0,,Nhưng mà giờ tôi muốn ăn món gì thật ngon cơ.
Dialogue: 0,0:00:36.21,0:00:39.23,Main,goblin 63,0,0,0,,Rõ! Tụi em đi nhờ Masamune ngay đây.
Dialogue: 0,0:00:39.23,0:00:42.68,Main,Akira,0,0,0,,Nhân tiện, đưa luôn nhóc này về làng giúp tôi.
Dialogue: 0,0:00:42.93,0:00:43.52,Sign_Basic,text,0,0,0,,MANH LỰC
Dialogue: 0,0:00:42.68,0:00:43.52,Main,goblin 64,0,0,0,,Vâng ạ!
Dialogue: 0,0:00:48.14,0:00:51.10,Main,Akira,0,0,0,,Ta biết ngươi đang trốn ở đó. Bước ra đây.
Dialogue: 0,0:00:55.29,0:00:58.34,Main,Akira,0,0,0,,Ngươi là ai? Tới đây làm gì?
Dialogue: 0,0:00:59.29,0:01:01.32,Italics,Akira,0,0,0,,Sau vụ rắc rối với Echigoya,
Dialogue: 0,0:01:01.32,0:01:04.00,Italics,Akira,0,0,0,,có lẽ mình cần phải mạnh tay hơn\Nmột chút với chuyện này rồi nhỉ?
Dialogue: 0,0:01:04.00,0:01:05.99,Main,Akira,0,0,0,,Không chịu trả lời thì ta đành dùng vũ lực đấy.
Dialogue: 0,0:01:07.67,0:01:08.63,Sign_Basic,text,0,0,0,,THỦY PHÂN THÂN
Dialogue: 0,0:01:07.42,0:01:08.62,Main,Akira,0,0,0,,Thủy Phân Thân!
Dialogue: 0,0:01:11.46,0:01:13.13,Sign_Basic,text,0,0,0,,KẺ MẠNH SINH TỒN
Dialogue: 0,0:01:11.45,0:01:13.14,Main,Akira,0,0,0,,Kẻ Mạnh Sinh Tồn.
Dialogue: 0,0:01:16.14,0:01:19.27,Main,Akira,0,0,0,,Ngươi là ai, và tới đây với mục đích gì?
Dialogue: 0,0:01:19.27,0:01:24.03,Main,soldier,0,0,0,,Tôi đang truy tìm Hắc Thiên Long\Ntheo mật lệnh của Hoàng tử Albert.
Dialogue: 0,0:01:24.03,0:01:26.39,Italics,Akira,0,0,0,,Hoàng tử đó ư? Nhưng để làm gì chứ?
Dialogue: 0,0:01:26.39,0:01:28.40,Main,Akira,0,0,0,,Hắc Thiên Long là sinh vật gì?
Dialogue: 0,0:01:28.40,0:01:29.78,Main,soldier,0,0,0,,Tôi không rõ.
Dialogue: 0,0:01:29.78,0:01:32.31,Main,Akira,0,0,0,,Tại sao hoàng tử lại truy lùng một con rồng?
Dialogue: 0,0:01:32.31,0:01:33.71,Main,soldier,0,0,0,,Tôi cũng không biết.
Dialogue: 0,0:01:33.71,0:01:37.52,Italics,Akira,0,0,0,,Với tính cách của Albert, hẳn ngài ấy\Nđang giấu kín chuyện gì đó.
Dialogue: 0,0:01:37.52,0:01:39.35,Main,Akira,0,0,0,,Cút khỏi nơi này ngay.
Dialogue: 0,0:01:39.35,0:01:41.74,Main,Akira,0,0,0,,Và hãy quên sạch chuyện ngươi từng gặp ta ở đây đi.
Dialogue: 0,0:01:45.41,0:01:47.55,Italics,Akira,0,0,0,,Một con rồng bị hoàng tử truy lùng ư?
Dialogue: 0,0:01:48.95,0:01:50.54,Main,goblins,0,0,0,,Con rồng này ở đâu ra vậy ta?
Dialogue: 0,0:01:49.81,0:01:50.87,Main - Top,goblins,0,0,0,,Vẫn còn nhỏ xíu à.
Dialogue: 0,0:01:50.87,0:01:52.92,Main,goblins,0,0,0,,Ai bế nó về đây thế?
Dialogue: 0,0:01:52.92,0:01:54.55,Main,goblin 63,0,0,0,,Ồ, Thôn trưởng về rồi.
Dialogue: 0,0:01:54.55,0:01:56.34,Main,Akira,0,0,0,,Cảm ơn mọi người đã giúp đỡ nhé.
Dialogue: 0,0:01:56.34,0:02:01.02,Italics,Akira,0,0,0,,Nếu có dính dáng đến Albert, đây chắc chắn\Nkhông chỉ là một con rồng bình thường.
Dialogue: 0,0:02:01.02,0:02:03.50,Italics,Akira,0,0,0,,Trong tình huống xấu nhất, chuyện này\Ncó thể châm ngòi cho một cuộc xung đột.
Dialogue: 0,0:02:04.73,0:02:06.06,Main,goblin 65,0,0,0,,Ông ổn không đấy?
Dialogue: 0,0:02:10.05,0:02:11.73,Main,goblin 66,0,0,0,,Mệt rã rời rồi.
Dialogue: 0,0:02:11.73,0:02:15.21,Main,goblin 66,0,0,0,,Thôn trưởng ơi, hôm nay vui lắm ạ.
Dialogue: 0,0:02:15.21,0:02:17.41,Main,Akira,0,0,0,,Ừ, cậu nghỉ ngơi đi nhé.
Dialogue: 0,0:02:17.41,0:02:19.25,Main,goblin 66,0,0,0,,Vâng, chắc em chợp mắt chút đây.
Dialogue: 0,0:02:21.99,0:02:24.99,Sign_Basic,text,0,0,0,,TRỊ LIỆU
Dialogue: 0,0:02:22.09,0:02:23.45,Italics,Akira,0,0,0,,Trị Liệu.
Dialogue: 0,0:02:23.45,0:02:25.01,Italics,Akira,0,0,0,,Mình đã nhận bao nhiêu kỹ năng {\i0}kiểu đó{\i1} rồ—
Dialogue: 0,0:02:26.50,0:02:29.76,Main,Akira,0,0,0,,Cái gì?! Mi vừa nuốt chửng kỹ năng sao?!
Dialogue: 0,0:02:29.76,0:02:31.26,Main,Izyz,0,0,0,,Ngon quá xá!
Dialogue: 0,0:02:34.00,0:02:44.10,Sign_Basic,title,0,0,0,,CHUYỂN SINH THÀNH GOBLIN\NTHÌ CÓ GÌ SAI SAO?
Dialogue: 0,0:04:04.51,0:04:10.31,Sign_Basic,text,0,0,0,,TẬP 7: KẾT BẠN VỚI RỒNG THÌ CÓ GÌ SAI SAO?
Dialogue: 0,0:04:07.38,0:04:09.48,Main,Izyz,0,0,0,,{\pos(320,305)}Ăn đã miệng thật đấy.
Dialogue: 0,0:04:10.60,0:04:12.23,Main,goblins,0,0,0,,Nó vừa ăn cái gì kìa.
Dialogue: 0,0:04:11.05,0:04:12.22,Main - Top,goblins,0,0,0,,Thế có sao không vậy?
Dialogue: 0,0:04:12.22,0:04:13.51,Main,goblins,0,0,0,,Liệu nó có ổn không thế?
Dialogue: 0,0:04:13.51,0:04:16.33,Main,Izyz,0,0,0,,Cậu vừa cho ta ăn món đó hả?
Dialogue: 0,0:04:16.33,0:04:18.68,Main,Akira,0,0,0,,Tôi đâu có chủ định đút cho cậu ăn.
Dialogue: 0,0:04:18.97,0:04:21.86,Main,Izyz,0,0,0,,Cảm ơn nha, ngon tuyệt vời luôn.
Dialogue: 0,0:04:21.86,0:04:24.05,Italics,Akira,0,0,0,,Nói chuyện cũng bình thường ra phết nhỉ.
Dialogue: 0,0:04:24.05,0:04:26.28,Main,Akira,0,0,0,,Sao cậu lại ăn kỹ năng vậy?
Dialogue: 0,0:04:26.28,0:04:28.61,Main,Izyz,0,0,0,,Tại ăn vào thì bụng ta mới hết kêu réo chứ sao.
Dialogue: 0,0:04:28.61,0:04:30.45,Main,Akira,0,0,0,,Ý tôi không phải hỏi cái đó.
Dialogue: 0,0:04:30.45,0:04:35.43,Italics,Izyz,0,0,0,,Đối với con rồng này,\Nkỹ năng chỉ đơn thuần là nguồn thức ăn thôi sao?
Dialogue: 0,0:04:36.58,0:04:39.71,Sign_Basic,text,0,0,0,,XOA XOA
Dialogue: 0,0:04:36.93,0:04:38.59,Main,goblin 67,0,0,0,,Da nó láng mịn luôn kìa!
Dialogue: 0,0:04:38.59,0:04:39.70,Main,goblin 68,0,0,0,,Lại còn mát lạnh nữa chứ!
Dialogue: 0,0:04:41.59,0:04:44.34,Italics,Akira,0,0,0,,Có lẽ nào cậu ta cũng không phải kẻ xấu?
Dialogue: 0,0:04:45.64,0:04:47.39,Main,Chloe,0,0,0,,Akira!
Dialogue: 0,0:04:48.43,0:04:49.80,Main,Chloe,0,0,0,,Vừa khéo tôi mới về tới đây này!
Dialogue: 0,0:04:49.80,0:04:51.90,Main,Akira,0,0,0,,Chloe, có chuyện gì vui thế?
Dialogue: 0,0:04:51.90,0:04:53.35,Main,Chloe,0,0,0,,Tôi vừa thu hoạch được một mẻ lớn luôn.
Dialogue: 0,0:04:53.74,0:04:57.27,Main,Chloe,0,0,0,,Tôi mới đi kiếm ít trứng gà về\Nđể làm món Masamune-yaki đấy.
Dialogue: 0,0:04:57.27,0:04:59.70,Main,Akira,0,0,0,,Ồ, đỉnh thế.
Dialogue: 0,0:04:59.70,0:05:04.44,Italics,Akira,0,0,0,,Masamune-yaki là món ăn do một\Ntiền bối Masamune đời trước sáng tạo ra.
Dialogue: 0,0:05:04.70,0:05:08.54,Italics,Akira,0,0,0,,Về cơ bản nó chính là món sukiyaki,\Nnhưng thế giới này vốn chưa có món đó,
Dialogue: 0,0:05:08.54,0:05:10.94,Italics,Akira,0,0,0,,nên Masamune đã tự mày mò chế biến ra từ đầu.
Dialogue: 0,0:05:11.46,0:05:16.12,Italics,Akira,0,0,0,,Sau đó tôi gợi ý rằng chấm cùng trứng đánh tan\Nsẽ giúp hương vị ngon hơn hẳn.
Dialogue: 0,0:05:16.75,0:05:20.27,Main,Chloe,0,0,0,,Để tôi đi bảo cô ấy làm món\NMasamune-yaki ngay lập tức mới được!
Dialogue: 0,0:05:20.27,0:05:22.32,Main,Chloe,0,0,0,,Ủa, Masamune đâu rồi nhỉ?
Dialogue: 0,0:05:25.25,0:05:28.37,Main,Chloe,0,0,0,,Hắc Không Vương đang làm cái quái gì ở đây vậy?
Dialogue: 0,0:05:29.17,0:05:32.05,Main,Izyz,0,0,0,,Cái sừng đó. Nhóc có họ hàng gì với gã Ma à?
Dialogue: 0,0:05:32.05,0:05:34.71,Main,Akira,0,0,0,,Ma à? Ý cậu là Ma Vương sao?
Dialogue: 0,0:05:34.71,0:05:37.39,Main,Izyz,0,0,0,,Đâu có, là Công Tước Ma Tộc kia kìa.
Dialogue: 0,0:05:37.39,0:05:40.85,Italics,Akira,0,0,0,,Nghe cái danh hiệu đậm chất ma tộc\Nvà khét lẹt thật đấy.
Dialogue: 0,0:05:40.85,0:05:42.48,Main,Akira,0,0,0,,Chloe, cô biết cậu ta à?
Dialogue: 0,0:05:42.48,0:05:45.77,Main,Chloe,0,0,0,,Hắn chính là Hắc Không Vương,\NHắc Thiên Long Izyz đấy.
Dialogue: 0,0:05:46.06,0:05:50.03,Italics,Akira,0,0,0,,Hắc Thiên Long mà Hoàng tử Albert\Nđang ráo riết truy tìm,
Dialogue: 0,0:05:50.03,0:05:52.73,Italics,Akira,0,0,0,,kẻ sở hữu kỹ năng độc nhất Chấn Động Thế Giới.
Dialogue: 0,0:05:52.73,0:05:55.19,Italics,Akira,0,0,0,,Chắc chắn không phải hạng rồng tầm thường rồi.
Dialogue: 0,0:05:56.87,0:05:59.06,Italics,Akira,0,0,0,,Ít nhất là tôi nghĩ vậy.
Dialogue: 0,0:05:59.06,0:06:00.62,Main,Chloe,0,0,0,,Ngươi mò tới đây với mục đích gì?
Dialogue: 0,0:06:00.62,0:06:02.51,Main,Izyz,0,0,0,,Ta thấy đói bụng thôi mà.
Dialogue: 0,0:06:03.17,0:06:05.08,Main,Chloe,0,0,0,,Đừng có giỡn mặt với ta!
Dialogue: 0,0:06:12.39,0:06:13.83,Main,Izyz,0,0,0,,Ta có đùa với cô đâu chứ.
Dialogue: 0,0:06:17.10,0:06:18.27,Sign_Basic,text,0,0,0,,PHÂN THÂN BÓNG TỐI
Dialogue: 0,0:06:17.26,0:06:18.62,Main,Akira,0,0,0,,Phân Thân Bóng Tối.
Dialogue: 0,0:06:18.52,0:06:19.27,Sign_Basic,text,0,0,0,,BAY (FLOAT)
Dialogue: 0,0:06:18.62,0:06:19.27,Main,Akira,0,0,0,,Bay!
Dialogue: 0,0:06:19.48,0:06:20.65,Sign_Basic,text,0,0,0,,HẮC DIỄM
Dialogue: 0,0:06:19.58,0:06:20.56,Main,Akira,0,0,0,,Hắc Diễm.
Dialogue: 0,0:06:20.81,0:06:24.03,Main,Akira,0,0,0,,Dừng tay lại đi. Mọi người đang sợ hết cả rồi kìa.
Dialogue: 0,0:06:25.07,0:06:27.11,Sign_Basic,text,0,0,0,,RUN RẨY
Dialogue: 0,0:06:24.35,0:06:25.07,Main,Izyz,0,0,0,,Hả?
Dialogue: 0,0:06:27.10,0:06:29.28,Main,Izyz,0,0,0,,Ối, xin lỗi nha!
Dialogue: 0,0:06:29.28,0:06:31.43,Main,Izyz,0,0,0,,Giờ ổn rồi đấy.
Dialogue: 0,0:06:32.13,0:06:34.17,Main,goblin 69,0,0,0,,Cãi vã nhau là không tốt đâu.
Dialogue: 0,0:06:34.17,0:06:36.15,Main,goblin 70,0,0,0,,Em hết cả hồn luôn ấy.
Dialogue: 0,0:06:36.15,0:06:38.33,Main,goblin 71,0,0,0,,Cậu biến hình ra được {\i1}bự chảng{\i0} luôn nhỉ.
Dialogue: 0,0:06:38.33,0:06:40.41,Main,goblins,0,0,0,,Tôi cũng giật nảy mình luôn.
Dialogue: 0,0:06:40.97,0:06:43.33,Italics,Akira,0,0,0,,Nếu hai người họ mà đánh nhau thật...
Dialogue: 0,0:06:45.06,0:06:47.12,Main,Izyz,0,0,0,,Cậu cũng ra gì phết đấy.
Dialogue: 0,0:06:47.78,0:06:50.90,Main,Izyz,0,0,0,,Cậu khéo là con Goblin mạnh nhất\Nmà ta từng gặp từ trước tới nay luôn ấy.
Dialogue: 0,0:06:50.90,0:06:52.41,Main,Akira,0,0,0,,Ồ, vậy sao?
Dialogue: 0,0:06:52.41,0:06:54.67,Main,Izyz,0,0,0,,Có khi còn mạnh hơn cả gã kia nữa.
Dialogue: 0,0:06:56.56,0:06:57.93,Main,Akira,0,0,0,,Sao thế?
Dialogue: 0,0:06:57.93,0:07:01.50,Main,Izyz,0,0,0,,Tại vừa ăn lót dạ chút ít nên bụng ta lại càng cồn cào.
Dialogue: 0,0:07:01.86,0:07:05.41,Main,Izyz,0,0,0,,Bình thường ta nhịn ăn cả năm trời\Ncũng chẳng sao đâu,
Dialogue: 0,0:07:05.41,0:07:09.04,Main,Izyz,0,0,0,,nhưng hễ đã ăn vào rồi là cơn đói\Ncứ cào ruột gan không chịu nổi.
Dialogue: 0,0:07:09.04,0:07:11.90,Main,Akira,0,0,0,,Đôi khi ăn nhẹ lại kích thích cơn thèm lên thật, ừ.
Dialogue: 0,0:07:11.90,0:07:13.67,Main,Akira,0,0,0,,Đây, cậu cầm lấy ăn tạm—
Dialogue: 0,0:07:16.16,0:07:19.24,Main,Izyz,0,0,0,,Ngon quá! Cậu tốt bụng ghê.
Dialogue: 0,0:07:19.24,0:07:20.33,Main,Akira,0,0,0,,C-Cảm ơn...
Dialogue: 0,0:07:20.84,0:07:23.79,Main,Izyz,0,0,0,,Này, cậu có muốn làm Ma Vương không?
Dialogue: 0,0:07:23.79,0:07:26.28,Main,Akira,0,0,0,,Không, tôi xin kiếu.
Dialogue: 0,0:07:27.29,0:07:30.17,Main,Akira,0,0,0,,Khoan đã, sao cậu lại hỏi câu đó?
Dialogue: 0,0:07:30.17,0:07:34.71,Main,Izyz,0,0,0,,Thực ra thì ta cũng là nhân vật máu mặt\Ntrong Long Tộc đấy nhé.
Dialogue: 0,0:07:35.18,0:07:37.21,Main,Akira,0,0,0,,Máu mặt cỡ nào cơ?
Dialogue: 0,0:07:37.21,0:07:40.85,Main,Izyz,0,0,0,,Ta là một trong ba kẻ có quyền\Nquyết định xem ai sẽ lên ngôi Ma Vương.
Dialogue: 0,0:07:40.85,0:07:42.95,Main,Akira,0,0,0,,Tầm cỡ hơn tôi tưởng nhiều đấy!
Dialogue: 0,0:07:42.95,0:07:45.49,Main,Chloe,0,0,0,,Lần này thì hắn không nói dối đâu.
Dialogue: 0,0:07:45.49,0:07:48.69,Main,Izyz,0,0,0,,Cơ mà, thường thì chỉ cần một trong ba đứa ta\Nđề cử ai đó lên là,
Dialogue: 0,0:07:48.69,0:07:51.47,Main,Izyz,0,0,0,,hai đứa còn lại đều gật gù kiểu "Ừ, sao cũng được."
Dialogue: 0,0:07:51.47,0:07:55.24,Main,Izyz,0,0,0,,Ngoài mấy kẻ lọt vào mắt xanh của tụi ta ra,\Nchẳng ai thèm quan tâm mấy đâu.
Dialogue: 0,0:07:55.24,0:07:57.61,Main,Akira,0,0,0,,Thế sao lại đề nghị chức đó cho tôi?
Dialogue: 0,0:08:00.04,0:08:01.95,Main,Akira,0,0,0,,Cậu vừa nói gì cơ?
Dialogue: 0,0:08:02.24,0:08:04.33,Main,Izyz,0,0,0,,Tại cậu có cả rổ kỹ năng chứ sao!
Dialogue: 0,0:08:04.33,0:08:04.87,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:08:05.13,0:08:07.66,Main,Izyz,0,0,0,,Ta nghe đồn có một con Goblin\Nsống cực kỳ dai,
Dialogue: 0,0:08:07.66,0:08:10.05,Main,Izyz,0,0,0,,nghe giống kèo thơm để được\Nbao ăn dài dài quá trời,
Dialogue: 0,0:08:10.05,0:08:11.99,Main,Izyz,0,0,0,,nên ta tính cho cậu nợ ta một ân tình trước ấy mà.
Dialogue: 0,0:08:11.99,0:08:14.19,Italics,Akira,0,0,0,,Hóa ra nhắm tới chuyện đó à?
Dialogue: 0,0:08:14.19,0:08:16.72,Main,Akira,0,0,0,,Xin lỗi nhé, tôi không định làm Ma Vương đâu.
Dialogue: 0,0:08:17.42,0:08:19.80,Main,Izyz,0,0,0,,Thế à, tiếc thật đấy.
Dialogue: 0,0:08:19.80,0:08:22.60,Main,goblin 72,0,0,0,,Izyz nhìn mướt mát ghê!
Dialogue: 0,0:08:22.99,0:08:25.05,Main,Akira,0,0,0,,Từ bỏ nhanh gọn nhẹ phết nhỉ.
Dialogue: 0,0:08:25.41,0:08:27.24,Italics,Akira,0,0,0,,Mình sẽ không làm Ma Vương đâu.
Dialogue: 0,0:08:27.24,0:08:28.92,Italics,Akira,0,0,0,,Ít nhất là chưa phải lúc này.
Dialogue: 0,0:08:29.33,0:08:33.60,Italics,Akira,0,0,0,,Nếu nhận lời, rất có thể mình sẽ biến thành\Nkẻ thù của toàn thể nhân loại mất.
Dialogue: 0,0:08:35.75,0:08:38.78,Main,Izyz,0,0,0,,Này, này. Ta ở nhờ đây một thời gian được không?
Dialogue: 0,0:08:38.78,0:08:40.58,Main,Akira,0,0,0,,Ừ, cứ tự nhiên.
Dialogue: 0,0:08:40.58,0:08:41.84,Main,Izyz,0,0,0,,Thật á?!
Dialogue: 0,0:08:42.37,0:08:45.70,Italics,Akira,0,0,0,,Izyz... Có vẻ cậu ta không nói dối,
Dialogue: 0,0:08:45.70,0:08:48.17,Italics,Akira,0,0,0,,nhưng mình có cảm giác cậu ta vẫn đang\Ngiấu nhẹm chuyện gì đó rất quan trọng.
Dialogue: 0,0:08:48.77,0:08:52.45,Italics,Akira,0,0,0,,Thế nên cứ giữ cậu ta bên cạnh\Nđể tiện trông chừng vẫn an toàn hơn.
Dialogue: 0,0:08:52.45,0:08:54.86,Main,goblin 73,0,0,0,,Tiệc chào mừng Izyz gia nhập làng nào!
Dialogue: 0,0:08:54.86,0:08:56.67,Main,goblin 74,0,0,0,,Thôn trưởng nhớ tới chung vui đấy nhé!
Dialogue: 0,0:08:59.35,0:09:01.01,Main,goblins,0,0,0,,Này, xịn thế.
Dialogue: 0,0:09:01.68,0:09:03.36,Main,goblins,0,0,0,,Xem cái này đi này.
Dialogue: 0,0:09:05.24,0:09:07.13,Main,goblins,0,0,0,,Đừng khách sáo thế chứ.
Dialogue: 0,0:09:13.86,0:09:14.93,Main,Akira,0,0,0,,Masamune.
Dialogue: 0,0:09:16.58,0:09:17.83,Main,Akira,0,0,0,,Cô thấy trong người ổn chứ?
Dialogue: 0,0:09:19.07,0:09:20.65,Main,Masamune VI,0,0,0,,Tôi vẫn ổn ạ.
Dialogue: 0,0:09:21.81,0:09:24.82,Italics,Akira,0,0,0,,Mình đã chứng kiến cảnh này\Nhàng nghìn lần rồi.
Dialogue: 0,0:09:24.82,0:09:26.74,Italics,Akira,0,0,0,,Sắc chết hiện rõ trên khuôn mặt của một Goblin.
Dialogue: 0,0:09:27.49,0:09:30.61,Italics,Akira,0,0,0,,Cô ấy mới chào đời còn chưa đầy ba ngày nữa.
Dialogue: 0,0:09:31.55,0:09:32.99,Main,Akira,0,0,0,,Cô thấy ốm mệt chỗ nào à?
Dialogue: 0,0:09:32.99,0:09:35.46,Main,Masamune VI,0,0,0,,Không, hoàn toàn không ạ.
Dialogue: 0,0:09:35.89,0:09:37.39,Main,Akira,0,0,0,,Vậy tại sao lại...
Dialogue: 0,0:09:37.39,0:09:39.39,Main,Izyz,0,0,0,,Vì cô ta là thiên tài chứ sao?
Dialogue: 0,0:09:39.77,0:09:45.31,Main,Izyz,0,0,0,,Lâu lâu lại có con Goblin sinh ra mang tài năng thiên bẩm,\Nnhưng đánh đổi bằng tuổi thọ ngắn ngủi.
Dialogue: 0,0:09:45.31,0:09:46.90,Main,Akira,0,0,0,,Ra là vậy sao?
Dialogue: 0,0:09:48.45,0:09:49.73,Main,Akira,0,0,0,,Masamune!
Dialogue: 0,0:09:50.35,0:09:51.40,Sign_Basic,text,0,0,0,,ĐẠI TRỊ LIỆU
Dialogue: 0,0:09:57.14,0:10:00.57,Italics,Akira,0,0,0,,Không phải do thương tích.\NMà là quy luật tự nhiên.
Dialogue: 0,0:10:00.57,0:10:03.03,Italics,Akira,0,0,0,,Đại Trị Liệu hoàn toàn vô hiệu.
Dialogue: 0,0:10:03.03,0:10:08.91,Main,Masamune VI,0,0,0,,Thưa Thôn trưởng, tôi... vừa nghĩ ra một món mới.
Dialogue: 0,0:10:09.29,0:10:13.78,Main,Masamune VI,0,0,0,,Một món ăn mà tất cả mọi người trong làng\Nđều có thể vui vẻ cùng nhau làm.
Dialogue: 0,0:10:16.52,0:10:20.42,Italics,Akira,0,0,0,,Ồ, Masamune. Đây là bánh xếp gyoza mà.
Dialogue: 0,0:10:20.42,0:10:25.48,Main,Masamune VI,0,0,0,,Tôi đã nảy ra ý tưởng này khi nhìn thấy\Nngài và cô Karen.
Dialogue: 0,0:10:25.48,0:10:30.16,Main,Masamune VI,0,0,0,,Một món gì đó mọi người vừa cười nói\Nvừa gói bánh, rồi cùng thưởng thức...
Dialogue: 0,0:10:30.16,0:10:33.21,Main,Masamune VI,0,0,0,,Tôi tự nhủ, đó chính là loại món ăn\Nmà mình muốn tạo ra nhất.
Dialogue: 0,0:10:33.21,0:10:34.42,Main,Akira,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:10:34.85,0:10:36.52,Main,Akira,0,0,0,,Cô đúng là thiên tài đấy.
Dialogue: 0,0:10:36.92,0:10:40.53,Main,Akira,0,0,0,,Tôi tin chắc mọi người sẽ mãi\Nghi nhớ về cô.
Dialogue: 0,0:10:40.99,0:10:42.63,Main,Masamune VI,0,0,0,,Cả ngài cũng vậy chứ ạ?
Dialogue: 0,0:10:43.26,0:10:44.28,Main,Akira,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:10:46.49,0:10:48.79,Main,Masamune VI,0,0,0,,Xin... cảm ơn ngài.
Dialogue: 0,0:10:52.18,0:10:55.36,Main,goblin 75,0,0,0,,Nào! Đến giờ mở tiệc tiễn đưa Masamune rồi!
Dialogue: 0,0:10:55.36,0:10:56.37,Main,all,0,0,0,,Chí lý!
Dialogue: 0,0:10:57.98,0:10:59.10,Main,Izyz,0,0,0,,Khoan đã nào.
Dialogue: 0,0:10:59.44,0:11:01.67,Main,Akira,0,0,0,,Cậu định ăn kỹ năng đó sao?
Dialogue: 0,0:11:01.67,0:11:05.82,Main,Izyz,0,0,0,,Không. Cậu cứ quan sát kỹ năng đó\Nthêm một chút nữa đi.
Dialogue: 0,0:11:05.82,0:11:07.85,Main,Akira,0,0,0,,Hả? Ý cậu là sao?
Dialogue: 0,0:11:08.98,0:11:10.53,Main,Izyz,0,0,0,,Thấy chưa?
Dialogue: 0,0:11:10.53,0:11:11.90,Main,Akira,0,0,0,,Chuyện gì thế này?
Dialogue: 0,0:11:14.33,0:11:16.43,Main,Akira,0,0,0,,M-Masamune?!
Dialogue: 0,0:11:20.65,0:11:23.60,Main,Akira,0,0,0,,Chuyện quái gì... đang xảy ra vậy?
Dialogue: 0,0:11:28.74,0:11:30.91,Main,Masamune,0,0,0,,Đây là tôi sao?
Dialogue: 0,0:11:30.91,0:11:33.89,Main,Akira,0,0,0,,Cô thật sự là Masamune à?
Dialogue: 0,0:11:33.89,0:11:36.83,Main,Masamune,0,0,0,,Đúng vậy, tôi chính là Masamune.
Dialogue: 0,0:11:36.83,0:11:38.69,Main,Akira,0,0,0,,Sao cơ thể cô lại biến thành thế này?
Dialogue: 0,0:11:38.69,0:11:40.30,Main,Masamune,0,0,0,,Tôi cũng không rõ nữa ạ.
Dialogue: 0,0:11:40.30,0:11:42.06,Main,Akira,0,0,0,,Có thấy điểm nào khác lạ không?
Dialogue: 0,0:11:42.06,0:11:43.85,Main,Masamune,0,0,0,,Chắc là kỹ năng của tôi ạ.
Dialogue: 0,0:11:44.68,0:11:45.68,Sign_Basic,text,0,0,0,,THẤU THỊ NHÃN (SEARCH EYE)
Dialogue: 0,0:11:44.43,0:11:45.68,Main,Akira,0,0,0,,Thấu Thị Nhãn.
Dialogue: 0,0:11:46.85,0:11:51.52,Sign_Basic,text,0,0,0,,MASAMUNE
Dialogue: 0,0:11:47.28,0:11:49.88,Main,Akira,0,0,0,,Kỹ năng tên là "Masamune" ư?
Dialogue: 0,0:11:49.88,0:11:51.52,Main,Akira,0,0,0,,Nó có công dụng gì vậy?
Dialogue: 0,0:11:51.52,0:11:53.20,Main,Masamune,0,0,0,,Tôi cũng chưa rõ.
Dialogue: 0,0:11:53.20,0:11:55.82,Main,Masamune,0,0,0,,Cảm giác chẳng có gì thay đổi nhiều lắm.
Dialogue: 0,0:11:55.82,0:12:00.28,Main,Masamune,0,0,0,,Nhưng tôi vẫn làm được mọi việc\Nnhư trước đây.
Dialogue: 0,0:12:07.17,0:12:08.74,Main,goblin 76,0,0,0,,Tốc độ kinh khủng thật!
Dialogue: 0,0:12:08.74,0:12:10.23,Main,goblin 77,0,0,0,,Cái nào cũng đẹp tăm tắp luôn!
Dialogue: 0,0:12:10.55,0:12:13.22,Main,Masamune,0,0,0,,Như mọi người thấy đấy, chẳng có gì đổi khác cả.
Dialogue: 0,0:12:13.22,0:12:14.17,Main,Akira,0,0,0,,Phải rồi...
Dialogue: 0,0:12:14.17,0:12:16.74,Main,goblin 77,0,0,0,,Này, chị đúng thật là Masamune sao?
Dialogue: 0,0:12:16.74,0:12:19.06,Main,Masamune,0,0,0,,Phải, là tôi đây.
Dialogue: 0,0:12:19.06,0:12:21.87,Main,Masamune,0,0,0,,Có lẽ... tôi đã sống lại rồi.
Dialogue: 0,0:12:21.87,0:12:23.35,Main,goblins,0,0,0,,Cái gì?!
Dialogue: 0,0:12:23.35,0:12:25.63,Main,goblin 76,0,0,0,,Mở tiệc ăn mừng hồi sinh thôi!
Dialogue: 0,0:12:28.95,0:12:32.13,Main,Akira,0,0,0,,Hồi sinh á? Rốt cuộc là chuyện gì vậy?
Dialogue: 0,0:12:32.13,0:12:34.18,Main,Izyz,0,0,0,,Là vì cô ta thuộc tộc Goblin đấy.
Dialogue: 0,0:12:34.44,0:12:37.87,Main,Izyz,0,0,0,,Thực ra ta có một kỹ năng hơi bị đặc biệt chút.
Dialogue: 0,0:12:37.87,0:12:40.61,Main,Akira,0,0,0,,Nói ngang thế. Kỹ năng đặc biệt gì cơ?
Dialogue: 0,0:12:40.90,0:12:46.86,Main,Izyz,0,0,0,,Đại khái là ta nhìn thấu được một sinh vật có kỹ năng\Nsẽ còn sống được bao lâu nữa thì chết.
Dialogue: 0,0:12:46.86,0:12:48.45,Italics,Akira,0,0,0,,Để tiện đường đi săn thức ăn hả.
Dialogue: 0,0:12:48.73,0:12:51.50,Main,Izyz,0,0,0,,Con Goblin kia chưa thể chết sớm được đâu.
Dialogue: 0,0:12:52.92,0:12:57.21,Main,Izyz,0,0,0,,Ta đoán cô ta sẽ sống thọ gấp mấy chục lần\Nđám Goblin bình thường khác đấy.
Dialogue: 0,0:12:58.03,0:12:59.16,Main,Akira,0,0,0,,Không thể nào!
Dialogue: 0,0:12:59.53,0:13:03.21,Main,Izyz,0,0,0,,Chờ một tuần nữa là biết ngay thật giả ấy mà.
Dialogue: 0,0:13:03.95,0:13:08.38,Italics,Akira,0,0,0,,Nghe giọng điệu cứ như cậu ta đã biết rõ\Nlý do từ đầu rồi vậy.
Dialogue: 0,0:13:08.73,0:13:13.87,Main,Izyz,0,0,0,,Tộc Goblin sở hữu khả năng thích nghi với môi trường\Nvượt trội hơn bất kỳ loài sinh vật nào.
Dialogue: 0,0:13:14.18,0:13:16.41,Main,Izyz,0,0,0,,Tiềm năng của chúng là vô tận.
Dialogue: 0,0:13:17.08,0:13:19.39,Italics,Akira,0,0,0,,Simon ngày trước cũng từng nói câu y hệt thế.
Dialogue: 0,0:13:19.39,0:13:22.50,Main,Izyz,0,0,0,,Này, theo cậu thì "môi trường" có nghĩa là gì?
Dialogue: 0,0:13:22.50,0:13:25.94,Main,Akira,0,0,0,,Chẳng phải là nơi sinh sống và khí hậu xung quanh sao?
Dialogue: 0,0:13:26.69,0:13:32.21,Main,Izyz,0,0,0,,Đối với sinh vật, "môi trường"\Nchính là những yếu tố bất biến xung quanh nó.
Dialogue: 0,0:13:32.80,0:13:34.55,Main,Akira,0,0,0,,Những yếu tố bất biến ư?
Dialogue: 0,0:13:34.55,0:13:36.25,Main,Izyz,0,0,0,,Đối với đám Goblin nơi đây...
Dialogue: 0,0:13:36.80,0:13:39.21,Main,Izyz,0,0,0,,cậu chính là một hằng số bất biến đấy.
Dialogue: 0,0:13:40.38,0:13:41.41,Main,Akira,0,0,0,,Tôi sao?
Dialogue: 0,0:13:41.70,0:13:46.58,Main,Izyz,0,0,0,,Cậu cứ sống mãi không già, khiến lũ Goblin\Ncũng bắt đầu tự tiến hóa để thích nghi theo.
Dialogue: 0,0:13:46.58,0:13:48.98,Main,Izyz,0,0,0,,Chẳng hạn như kéo dài tuổi thọ ra đấy.
Dialogue: 0,0:13:49.38,0:13:53.22,Italics,Akira,0,0,0,,À. Nghĩ vậy thì chuyện đó cũng chẳng hề vô lý.
Dialogue: 0,0:13:54.03,0:13:58.14,Main,Izyz,0,0,0,,Khiến loài Goblin sống thọ hơn ư?\NChuyện chưa từng nghe trong lịch sử đấy.
Dialogue: 0,0:13:58.39,0:14:01.09,Main,goblin 77,0,0,0,,Thôn trưởng ơi, lại đây nhập tiệc đi ạ!
Dialogue: 0,0:14:01.09,0:14:01.76,Main,Akira,0,0,0,,Tới ngay đây.
Dialogue: 0,0:14:01.76,0:14:03.50,Main,goblins,0,0,0,,Nhanh lên đi Thôn trưởng. Nhanh nào!
Dialogue: 0,0:14:03.50,0:14:05.55,Main - Top,goblins,0,0,0,,Ngài ăn thử mấy món này xem sao.
Dialogue: 0,0:14:03.50,0:14:08.16,Italics,Izyz,0,0,0,,Quả thực, ngay cả với Goblin thường\Ntiềm năng cũng đã là vô tận.
Dialogue: 0,0:14:08.79,0:14:14.87,Italics,Izyz,0,0,0,,Huống chi là một cá thể Goblin dị biệt\Nvới những khả năng khó lường như cậu ta.
Dialogue: 0,0:14:20.17,0:14:21.04,Main,goblins,0,0,0,,Cạn ly!
Dialogue: 0,0:14:21.04,0:14:23.08,Main,goblins,0,0,0,,Vui hết sảy luôn!
Dialogue: 0,0:14:28.95,0:14:31.46,Main,Eirene,0,0,0,,Ngài gọi tôi ạ, Ngài Thôn trưởng?
Dialogue: 0,0:14:31.46,0:14:34.54,Main,Akira,0,0,0,,Phải, tôi có chuyện muốn hỏi cô.
Dialogue: 0,0:14:35.27,0:14:35.81,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:14:38.62,0:14:40.93,Main,Akira,0,0,0,,Này! Cô làm cái gì thế hả?!
Dialogue: 0,0:14:40.93,0:14:44.16,Main,Eirene,0,0,0,,Ồ? Ngài thích nằm dưới hơn sao?
Dialogue: 0,0:14:44.16,0:14:46.87,Main,Akira,0,0,0,,Tôi chẳng cần nằm trên\Nhay nằm dưới gì hết!
Dialogue: 0,0:14:47.12,0:14:50.01,Main,Eirene,0,0,0,,Vậy hay là chúng ta lên giường luôn nhé?
Dialogue: 0,0:14:52.46,0:14:56.09,Main,Masamune,0,0,0,,Ngài Thôn trưởng ơi, giờ có... tiện không ạ?
Dialogue: 0,0:14:58.40,0:15:00.61,Main,Masamune,0,0,0,,Hai người đang bận tạo em bé ạ.
Dialogue: 0,0:15:00.61,0:15:01.72,Main,Masamune,0,0,0,,Vậy lát tôi quay lại sau.
Dialogue: 0,0:15:01.12,0:15:02.70,Main - Top,Akira,0,0,0,,Không phải thế đâu!
Dialogue: 0,0:15:02.70,0:15:06.43,Main,Eirene,0,0,0,,Lũ Goblin công nhận tinh tế ghê\Ntrong chuyện tạo em bé nhỉ.
Dialogue: 0,0:15:06.43,0:15:09.38,Main,Akira,0,0,0,,Làm ơn đừng trêu chọc tôi quá đáng thế nữa.
Dialogue: 0,0:15:09.38,0:15:12.77,Main,Akira,0,0,0,,Vào việc chính đi,\Ntôi có chuyện nghiêm túc muốn hỏi cô.
Dialogue: 0,0:15:12.77,0:15:17.54,Main,Eirene,0,0,0,,Cậu cứ hỏi bất cứ điều gì cậu muốn biết.
Dialogue: 0,0:15:18.21,0:15:21.78,Main,Akira,0,0,0,,Cô biết gì về Izyz không?
Dialogue: 0,0:15:21.78,0:15:23.56,Main,Eirene,0,0,0,,Sao cậu lại hỏi tôi?
Dialogue: 0,0:15:23.56,0:15:24.90,Main,Akira,0,0,0,,Vì hai lý do.
Dialogue: 0,0:15:25.30,0:15:29.37,Main,Akira,0,0,0,,Thứ nhất, Chloe chắc chắn không thể nhìn nhận khách quan được.
Dialogue: 0,0:15:30.37,0:15:33.11,Main,Eirene,0,0,0,,Cô nàng đúng là chẳng mất mấy giây\Nđã nổi đóa lên ngay rồi.
Dialogue: 0,0:15:33.69,0:15:39.10,Main,Akira,0,0,0,,Lý do thứ hai là cô từng gọi\NMa Vương là "người đàn ông đó".
Dialogue: 0,0:15:39.10,0:15:40.17,Main,Eirene,0,0,0,,Tôi từng gọi thế à?
Dialogue: 0,0:15:40.41,0:15:43.88,Main,Akira,0,0,0,,Có vẻ cô hiểu biết sâu rộng hơn\Nhẳn hai người chị em của mình.
Dialogue: 0,0:15:43.88,0:15:46.74,Main,Eirene,0,0,0,,Tôi cũng chẳng biết nhiều lắm đâu.
Dialogue: 0,0:15:46.74,0:15:48.31,Main,Akira,0,0,0,,Cô cứ kể những gì mình biết đi.
Dialogue: 0,0:15:48.81,0:15:52.64,Main,Eirene,0,0,0,,Con rồng đó là một thành viên\Ncủa Tam Đại Quý Tộc.
Dialogue: 0,0:15:53.01,0:15:58.49,Main,Eirene,0,0,0,,Hắc Không Vương. Lạc Viên Ma Nhân.\NTinh Linh Kỳ Tích.
Dialogue: 0,0:15:58.49,0:16:01.01,Main,Eirene,0,0,0,,Đó là danh xưng của ba kẻ đứng đầu bọn họ.
Dialogue: 0,0:16:02.04,0:16:05.23,Main,Akira,0,0,0,,Tại sao họ lại được gọi là "quý tộc" vậy?
Dialogue: 0,0:16:05.23,0:16:09.47,Main,Eirene,0,0,0,,Lạc Viên Ma Nhân còn được gọi\Nlà Công Tước Ma Tộc.
Dialogue: 0,0:16:09.47,0:16:13.93,Main,Eirene,0,0,0,,Nghe đồn là vì trước kia hắn từng giữ tước vị\Ncông tước ở một vương quốc loài người.
Dialogue: 0,0:16:14.22,0:16:16.20,Main,Akira,0,0,0,,Sao lại ở vương quốc loài người cơ chứ?
Dialogue: 0,0:16:16.20,0:16:18.41,Main,Eirene,0,0,0,,Chuyện đó thì tôi chịu, không rõ nữa.
Dialogue: 0,0:16:18.41,0:16:22.80,Main,Akira,0,0,0,,Chính Tam Đại Quý Tộc đó là những người\Nquyết định ai được làm Ma Vương sao?
Dialogue: 0,0:16:22.80,0:16:28.00,Main,Eirene,0,0,0,,Phải, kẻ muốn lên ngôi Ma Vương\Nbắt buộc phải có sự chấp thuận của họ.
Dialogue: 0,0:16:28.00,0:16:31.11,Main,Eirene,0,0,0,,Tôi cũng không biết tại sao luật lệ lại\Nthành ra như vậy nữa.
Dialogue: 0,0:16:31.11,0:16:32.10,Main,Akira,0,0,0,,Ra vậy.
Dialogue: 0,0:16:32.36,0:16:36.75,Main,Akira,0,0,0,,Thế sao lúc nãy Chloe đột nhiên\Nbật chế độ chiến đấu căng thẳng thế?
Dialogue: 0,0:16:38.06,0:16:40.40,Main,Eirene,0,0,0,,Tại vì có lời đồn rằng...
Dialogue: 0,0:16:42.34,0:16:48.21,Main,Eirene,0,0,0,,con rồng đó đã từng chỉ điểm cho con người\Ncách để đánh bại Ma Vương.
Dialogue: 0,0:16:55.30,0:16:56.81,Main,Hanzo VI,0,0,0,,Thôn trưởng ơi!
Dialogue: 0,0:16:58.09,0:17:01.51,Main,Hanzo VI,0,0,0,,Lại có thêm đám con người lảng vảng\Nbên ngoài làng nữa rồi ạ.
Dialogue: 0,0:17:01.51,0:17:02.83,Main,Hanzo VI,0,0,0,,Chúng ta phải làm sao đây ạ?
Dialogue: 0,0:17:03.07,0:17:06.08,Main,Hanzo VI,0,0,0,,Trông bộ dạng như bọn chúng đang\Nlùng sục tìm kiếm thứ gì đó.
Dialogue: 0,0:17:06.51,0:17:10.66,Italics,Akira,0,0,0,,Thuộc hạ của hoàng tử vẫn đang\Nráo riết truy tìm Izyz à.
Dialogue: 0,0:17:11.21,0:17:14.46,Main,Akira,0,0,0,,Cứ tiếp tục tuần tra, nếu thấy có dấu hiệu\Nbọn chúng định xông vào làng,
Dialogue: 0,0:17:14.46,0:17:16.36,Main,Akira,0,0,0,,thì đừng nương tay mà cứ thẳng tay đánh đuổi đi.
Dialogue: 0,0:17:16.36,0:17:17.36,Main,Hanzo VI,0,0,0,,Vâng, em rõ rồi.
Dialogue: 0,0:17:17.36,0:17:19.00,Main,Akira,0,0,0,,À, khoan đã nào.
Dialogue: 0,0:17:19.77,0:17:21.74,Main,Akira,0,0,0,,Cậu có chuyện gì bận tâm không?
Dialogue: 0,0:17:22.11,0:17:23.47,Main,Hanzo VI,0,0,0,,Chuyện gì cơ ạ?
Dialogue: 0,0:17:24.11,0:17:27.03,Main,Akira,0,0,0,,Cậu có thấy bất mãn với điều gì ở đây không?
Dialogue: 0,0:17:28.77,0:17:30.80,Main,Hanzo VI,0,0,0,,Làm gì có chuyện đó ạ!
Dialogue: 0,0:17:30.80,0:17:35.25,Main,Hanzo VI,0,0,0,,Ngày nào cũng được ở bên Thôn trưởng yêu quý\Nvà mọi người, vui ơi là vui ấy chứ.
Dialogue: 0,0:17:35.73,0:17:38.75,Main,Akira,0,0,0,,Ừm. Xin lỗi vì hỏi mấy câu kỳ quặc nhé.
Dialogue: 0,0:17:38.75,0:17:40.02,Main,Akira,0,0,0,,Đi tuần cẩn thận nhé.
Dialogue: 0,0:17:40.02,0:17:40.77,Main,Hanzo VI,0,0,0,,Rõ thưa Thôn trưởng!
Dialogue: 0,0:17:41.68,0:17:43.98,Main,Izyz,0,0,0,,Tên Goblin đó cũng mạnh gớm nhỉ.
Dialogue: 0,0:17:44.46,0:17:49.51,Main,Izyz,0,0,0,,Hắn khéo lọt top tám con Goblin mạnh nhất\Nmà ta từng biết đấy.
Dialogue: 0,0:17:49.51,0:17:52.34,Main,Akira,0,0,0,,Hanzo đời này khéo là kẻ mạnh nhất\Ntrong dòng họ cậu ta rồi.
Dialogue: 0,0:17:54.07,0:17:55.76,Main,Akira,0,0,0,,Không biết có phải tại mình không nữa.
Dialogue: 0,0:17:57.67,0:18:02.66,Main,Akira,0,0,0,,Tự hỏi có phải tại mình mà lũ Goblin\Nvốn dĩ không chịu tiến hóa
Dialogue: 0,0:18:02.66,0:18:04.68,Main,Akira,0,0,0,,để kéo dài tuổi thọ hơn không.
Dialogue: 0,0:18:05.27,0:18:07.41,Main,Izyz,0,0,0,,Sao cậu lại nghĩ vậy?
Dialogue: 0,0:18:07.41,0:18:09.85,Main,Akira,0,0,0,,Tôi vốn mang ý tốt khi xây dựng nên hệ thống này
Dialogue: 0,0:18:09.85,0:18:12.89,Main,Akira,0,0,0,,để vòng đời ngắn ngủi không gây\Nbất tiện gì cho bọn họ,
Dialogue: 0,0:18:12.89,0:18:16.55,Main,Akira,0,0,0,,nhưng biết đâu chính tôi lại đang kìm hãm\Ntiềm năng phát triển của họ mất rồi.
Dialogue: 0,0:18:19.18,0:18:21.02,Main,Izyz,0,0,0,,Cậu đúng là phi thường thật đấy!
Dialogue: 0,0:18:21.02,0:18:21.49,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:18:21.49,0:18:26.88,Main,Izyz,0,0,0,,Chính vì cậu luôn khiến tất cả lũ Goblin\Ngặp được cậu đều sống hạnh phúc đấy.
Dialogue: 0,0:18:27.59,0:18:31.35,Main,Izyz,0,0,0,,Nếu chẳng có gì bất mãn trong cuộc sống\Nthì cần quái gì phải tiến hóa thích nghi nữa.
Dialogue: 0,0:18:32.22,0:18:36.34,Main,Izyz,0,0,0,,Cậu đúng là vị minh quân tuyệt vời nhất\Nmà ta từng nghe nói tới đấy.
Dialogue: 0,0:18:36.78,0:18:39.58,Italics,Akira,0,0,0,,Kéo dài tuổi thọ như một dạng thích nghi tiến hóa.
Dialogue: 0,0:18:39.97,0:18:41.84,Italics,Akira,0,0,0,,Nếu mình có thể chủ động kích hoạt điều đó,
Dialogue: 0,0:18:41.84,0:18:44.86,Italics,Akira,0,0,0,,thì phải kiến tạo môi trường như thế nào\Nđể dẫn dắt họ đây?
Dialogue: 0,0:18:48.52,0:18:50.64,Main,goblins,0,0,0,,Thơm nức mũi luôn kìa.
Dialogue: 0,0:18:51.89,0:18:53.63,Main,Masamune,0,0,0,,Vậy là đã hoàn tất công đoạn chế biến.
Dialogue: 0,0:18:53.63,0:18:56.11,Main,Akira,0,0,0,,Đến lượt cậu đấy, Hokusai. Trổ tài đi nào.
Dialogue: 0,0:18:57.39,0:18:59.07,Main,Hokusai I,0,0,0,,Chúng tôi tuyệt đối không phụ lòng ngài.
Dialogue: 0,0:18:59.92,0:19:01.56,Italics,Akira,0,0,0,,Đội Hokusai.
Dialogue: 0,0:19:01.56,0:19:05.37,Italics,Akira,0,0,0,,Một nhóm gồm những Goblin sở hữu kỹ năng\Nhội họa và nghệ thuật chuyên biệt.
Dialogue: 0,0:19:09.04,0:19:10.46,Main,Akira,0,0,0,,Ấn tượng thật đấy.
Dialogue: 0,0:19:10.70,0:19:14.23,Main,Akira,0,0,0,,Mẫu thiết kế nào nhìn cũng na ná mà lại có nét riêng biệt.
Dialogue: 0,0:19:15.17,0:19:16.12,Main,Akira,0,0,0,,Được rồi.
Dialogue: 0,0:19:16.17,0:19:21.05,Sign_Basic,text,0,0,0,,MANH LỰC
Dialogue: 0,0:19:16.49,0:19:20.44,Main,Akira,0,0,0,,Những ai khiêng được đồ nặng thì vác đống này\Nxuống hầm chứa ngầm nhé.
Dialogue: 0,0:19:21.04,0:19:23.37,Main,Karen,0,0,0,,Giờ cậu lại bày trò mới gì thế này?
Dialogue: 0,0:19:23.37,0:19:27.84,Main,Akira,0,0,0,,Tôi đang nhờ lứa Goblin trẻ tự tay\Nủ một mẻ rượu mơ để trữ.
Dialogue: 0,0:19:28.54,0:19:33.09,Main,Akira,0,0,0,,Thông thường rượu mơ ngâm tầm một tuần\Nlà đã uống được rồi,
Dialogue: 0,0:19:33.59,0:19:36.92,Main,Akira,0,0,0,,nhưng để ủ tầm nửa năm tới một năm\Nthì hương vị sẽ đậm đà ngon hơn hẳn.
Dialogue: 0,0:19:38.14,0:19:40.20,Main,Karen,0,0,0,,Nhưng làm vậy chẳng khác nào...
Dialogue: 0,0:19:40.20,0:19:42.45,Main,Akira,0,0,0,,Tôi đang cố tình tạo ra sự luyến tiếc.
Dialogue: 0,0:19:42.77,0:19:46.00,Main,Akira,0,0,0,,Trước giờ tôi vẫn thử nghiệm đủ cách\Nđể dựng nên một chế độ
Dialogue: 0,0:19:46.00,0:19:48.58,Main,Akira,0,0,0,,giúp bọn họ tận hưởng cuộc sống trọn vẹn nhất,
Dialogue: 0,0:19:49.04,0:19:50.75,Main,Akira,0,0,0,,nhưng xem ra đó lại là một sai lầm.
Dialogue: 0,0:19:50.75,0:19:55.17,Main,Akira,0,0,0,,Dù nói vậy cũng dễ làm nảy sinh câu hỏi rằng,\Nthế nào mới thực sự là sai lầm?
Dialogue: 0,0:19:55.70,0:19:57.01,Main,Akira,0,0,0,,Nhưng dẫu sao đi nữa...
Dialogue: 0,0:19:57.49,0:19:59.43,Main,Karen,0,0,0,,Tôi cũng hiểu được tâm trạng đó.
Dialogue: 0,0:19:59.43,0:20:02.51,Main,Karen,0,0,0,,Sống vỏn vẹn bảy ngày trời cũng gây không ít\Ntâm tư trĩu nặng cho con người tụi tôi mà.
Dialogue: 0,0:20:02.78,0:20:05.07,Main,Akira,0,0,0,,Tôi sẽ không lặp lại sai lầm cũ nữa.
Dialogue: 0,0:20:05.07,0:20:09.84,Main,Akira,0,0,0,,Nếu tuổi thọ của họ vẫn ngắn chỉ vì\Nhọ đã quá mãn nguyện với kiếp sống hiện tại...
Dialogue: 0,0:20:10.56,0:20:12.56,Main,Akira,0,0,0,,thì tôi sẽ gieo cho họ thêm những niềm nuối tiếc.
Dialogue: 0,0:20:12.56,0:20:14.76,Main,Karen,0,0,0,,Làm thế sẽ kéo dài tuổi thọ của họ sao?
Dialogue: 0,0:20:14.76,0:20:17.35,Main,Akira,0,0,0,,À, đây chỉ là một khía cạnh trong chính sách thôi.
Dialogue: 0,0:20:17.68,0:20:20.54,Main,Akira,0,0,0,,Họ vẫn sẽ được tận hưởng trọn vẹn niềm vui\Nnhư từ trước tới nay,
Dialogue: 0,0:20:20.54,0:20:23.14,Main,Akira,0,0,0,,nhưng nếu sống lâu hơn thì sẽ càng thêm\Nnhiều điều thú vị nữa chứ.
Dialogue: 0,0:20:23.94,0:20:25.47,Main,Karen,0,0,0,,Làm tốt lắm.
Dialogue: 0,0:20:25.47,0:20:28.40,Main,Karen,0,0,0,,Chắc tôi phải thêm cụm "như mọi khi" vào nữa nhỉ.
Dialogue: 0,0:20:28.40,0:20:31.38,Main,Karen,0,0,0,,Có việc gì giúp được, tôi sẽ hỗ trợ hết mình.
Dialogue: 0,0:20:31.38,0:20:33.06,Main,Akira,0,0,0,,Tôi luôn sẵn lòng đón nhận.
Dialogue: 0,0:20:42.31,0:20:44.59,Main,Diké,0,0,0,,Mia, em định đi đâu thế?
Dialogue: 0,0:20:44.93,0:20:46.80,Main,Diké,0,0,0,,Con bé bị làm sao thế không biết?
Dialogue: 0,0:20:47.72,0:20:50.10,Italics,Eunomia,0,0,0,,Cái tên đó bị làm sao vậy?! Là sao chứ?!
Dialogue: 0,0:20:50.10,0:20:54.78,Main,Eunomia,0,0,0,,Cái con Goblin tên "Akira" hay gì gì đó\Nđáng lẽ phải chết từ tám kiếp nào rồi chứ!
Dialogue: 0,0:22:05.55,0:22:09.10,Sign_Basic,Credit,0,0,0,,{\an9}PHỤ ĐỀ VIỆT NGỮ: Amtia(NOFACE)
Dialogue: 0,0:22:09.27,0:22:13.06,Sign_Basic,Credit,0,0,0,,{\an9}TIMING: Amtia(NOFACE)\NBIÊN TẬP & KỸ THUẬT: Amtia(NOFACE)
Dialogue: 0,0:22:17.86,0:22:20.94,Sign_Basic,Credit,0,0,0,,{\an3}KIỂM ĐỊNH (QC): Amtia(NOFACE)\NHOÀN THIỆN: Amtia(NOFACE)
Dialogue: 0,0:22:05.70,0:22:10.15,Main,Eunomia,0,0,0,,Bọn chúng... chẳng mấy chốc đều tan biến hết cả.
Dialogue: 0,0:22:11.53,0:22:12.64,Main,Akira,0,0,0,,Eunomia.
Dialogue: 0,0:22:13.05,0:22:14.56,Main,Akira,0,0,0,,Có chuyện gì vậy?
Dialogue: 0,0:22:14.56,0:22:16.61,Main,Eunomia,0,0,0,,C-Cậu nhìn cái gì hả?!
Dialogue: 0,0:22:16.61,0:22:19.05,Main - Top,Eunomia,0,0,0,,Chẳng liên quan gì tới cậu hết!
Dialogue: 0,0:22:19.05,0:22:21.03,Main - Top,Akira,0,0,0,,Có lẽ đúng là không liên quan thật,
Dialogue: 0,0:22:21.30,0:22:23.67,Main - Top,Akira,0,0,0,,nhưng cả Eirene lẫn Diké đều đang lo lắng cho cô đấy.
Dialogue: 0,0:22:23.98,0:22:25.54,Main,Akira,0,0,0,,Đã xảy ra chuyện gì à?
Dialogue: 0,0:22:25.54,0:22:27.08,Main,Eunomia,0,0,0,,Chẳng có chuyện gì cả!
Dialogue: 0,0:22:27.08,0:22:29.73,Main,Eunomia,0,0,0,,Cậu định lấy lòng chị Diké\Nqua chuyện này đấy à?!
Dialogue: 0,0:22:29.73,0:22:30.96,Main,Akira,0,0,0,,Tôi không có ý đó.
Dialogue: 0,0:22:30.96,0:22:32.62,Italics,Akira,0,0,0,,Cũng như mọi khi thôi nhỉ.
Dialogue: 0,0:22:32.62,0:22:34.36,Main,Eunomia,0,0,0,,Với lại, cả cậu nữa!
Dialogue: 0,0:22:34.83,0:22:36.53,Main,Eunomia,0,0,0,,Cậu tính sống dai tới chừng nào nữa hả?!
Dialogue: 0,0:22:36.53,0:22:38.03,Main,Eunomia,0,0,0,,Cậu chỉ là một con Goblin thôi mà!
Dialogue: 0,0:22:38.03,0:22:40.17,Main,Akira,0,0,0,,Nói phũ thế.
Dialogue: 0,0:22:40.17,0:22:41.72,Main,Akira,0,0,0,,Nhưng câu hỏi hay đấy.
Dialogue: 0,0:22:42.19,0:22:45.33,Italics,Akira,0,0,0,,Masamune đã tiến hóa và\Nkéo dài tuổi thọ của mình.
Dialogue: 0,0:22:45.33,0:22:48.71,Italics,Akira,0,0,0,,Điều đó chứng tỏ Bát Tuần Trường Thọ\Ncũng sẽ tiếp tục biến đổi thêm nữa.
Dialogue: 0,0:22:49.27,0:22:53.09,Italics,Akira,0,0,0,,Cách thức thực hiện trên chặng đường này có thể thay đổi,\Nnhưng mục tiêu của mình vẫn không đổi.
Dialogue: 0,0:22:54.39,0:22:55.75,Main,Akira,0,0,0,,Ít nhất thì...
Dialogue: 0,0:22:55.76,0:22:58.43,Sign_Basic,text,0,0,0,,TA KHÔNG MUỐN PHẢI CHỨNG KIẾN AI KHÓC THƯƠNG\NKHI TA CHẾT NỮA.
Dialogue: 0,0:22:59.86,0:23:04.58,Main,Akira,0,0,0,,Tôi muốn sống lâu hơn tất cả mọi người,\Nkể cả cô đấy.
Dialogue: 0,0:23:20.40,0:23:21.63,Main,Akira,0,0,0,,Cô sao vậy?
Dialogue: 0,0:23:21.63,0:23:23.38,Main,Eunomia,0,0,0,,K-Không có gì!
Dialogue: 0,0:23:25.27,0:23:27.68,Italics,Eunomia,0,0,0,,Cái tên đó bị làm sao vậy?! Là sao chứ?!

