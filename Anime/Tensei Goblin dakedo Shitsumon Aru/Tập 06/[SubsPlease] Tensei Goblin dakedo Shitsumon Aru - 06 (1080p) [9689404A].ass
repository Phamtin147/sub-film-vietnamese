Dialogue: 0,0:00:08.08,0:00:09.26,Main,Akira,0,0,0,,Eirene.
Dialogue: 0,0:00:09.69,0:00:11.74,Main,Akira,0,0,0,,Cô vẫn cảm thấy trong người không khỏe à?
Dialogue: 0,0:00:11.74,0:00:14.71,Main,Eirene,0,0,0,,Cảm ơn cậu, nhưng không phải chuyện đó đâu.
Dialogue: 0,0:00:14.71,0:00:16.44,Main,Akira,0,0,0,,Nếu cô không thích tiệc tùng,
Dialogue: 0,0:00:16.44,0:00:18.95,Main,Akira,0,0,0,,thì không cần phải gượng ép\Nbản thân tham gia đâu.
Dialogue: 0,0:00:18.95,0:00:21.91,Main,Eirene,0,0,0,,Không sao đâu mà.\NTiệc của làng Goblin rất dễ thương và cuốn hút.
Dialogue: 0,0:00:21.91,0:00:22.91,Main,Akira,0,0,0,,Ừm, vậy thì tốt rồi.
Dialogue: 0,0:00:22.91,0:00:25.17,Main,Chloe,0,0,0,,Cô ấy ít khi hòa nhập với đám đông lắm.
Dialogue: 0,0:00:25.17,0:00:28.43,Main,Chloe,0,0,0,,Eirene xưa nay lúc nào cũng chọn đứng ở đầu ngọn gió cả.
Dialogue: 0,0:00:28.43,0:00:29.74,Main,Akira,0,0,0,,Đầu gió sao?
Dialogue: 0,0:00:29.74,0:00:32.88,Main,Chloe,0,0,0,,Để cô ấy có thể kích hoạt kỹ năng của mình bất kỳ lúc nào đấy.
Dialogue: 0,0:00:32.88,0:00:35.09,Main,Akira,0,0,0,,Hả? Cô có thể dùng độc dược hay gì đó sao?
Dialogue: 0,0:00:35.09,0:00:37.32,Main,Eirene,0,0,0,,Kỹ năng của tôi có tên là Pheromone.
Dialogue: 0,0:00:37.32,0:00:40.51,Main,Eirene,0,0,0,,Cơ thể tôi tỏa ra những mùi hương mang lại nhiều hiệu ứng khác nhau.
Dialogue: 0,0:00:41.19,0:00:43.60,Main,Eirene,0,0,0,,Có thể gây hại, nhưng cũng có thể giúp ích.
Dialogue: 0,0:00:43.81,0:00:45.26,Main,Chloe,0,0,0,,Khè...
Dialogue: 0,0:00:45.26,0:00:46.90,Main,Akira,0,0,0,,Nghe tiện lợi ghê nhỉ.
Dialogue: 0,0:00:47.14,0:00:48.81,Main,Akira,0,0,0,,Đó là một kỹ năng độc nhất sao?
Dialogue: 0,0:00:48.81,0:00:51.18,Main,Eirene,0,0,0,,Cũng chẳng có gì to tát lắm đâu.
Dialogue: 0,0:00:51.18,0:00:53.03,Main,Eirene,0,0,0,,Chỉ hơi hiếm gặp một chút thôi.
Dialogue: 0,0:00:53.03,0:00:54.62,Main,Akira,0,0,0,,Một kỹ năng hiếm sao...
Dialogue: 0,0:00:54.90,0:00:56.19,Main,Karen,0,0,0,,Akira.
Dialogue: 0,0:00:56.48,0:00:59.73,Main,Karen,0,0,0,,Hoàng tử Albert nói ngài ấy muốn gặp cậu.
Dialogue: 0,0:01:00.12,0:01:01.54,Main,Akira,0,0,0,,Hoàng tử muốn gặp tôi sao?
Dialogue: 0,0:01:01.54,0:01:05.19,Main,Karen,0,0,0,,Đúng vậy. Do thân phận nên ngài ấy không thể tùy tiện vào làng nếu chưa được phép,
Dialogue: 0,0:01:05.19,0:01:07.18,Main,Karen,0,0,0,,vì thế ngài ấy muốn hẹn gặp ở bìa rừng bên ngoài.
Dialogue: 0,0:01:07.18,0:01:09.09,Main,Akira,0,0,0,,Được rồi, tôi sẽ đi.
Dialogue: 0,0:01:09.09,0:01:13.19,Main,Eirene,0,0,0,,Albert chính là người đã săn lùng gã đàn ông đó, đúng không?
Dialogue: 0,0:01:13.51,0:01:14.55,Main,Akira,0,0,0,,Hở?
Dialogue: 0,0:01:14.55,0:01:15.46,Main,Akira,0,0,0,,Đúng vậy.
Dialogue: 0,0:01:15.46,0:01:17.43,Main,Eirene,0,0,0,,Vậy thì tôi sẽ đi cùng cậu.
Dialogue: 0,0:01:17.43,0:01:19.82,Main,Eirene,0,0,0,,Như vậy có được không, Thanh tra?
Dialogue: 0,0:01:20.86,0:01:24.24,Main,Karen,0,0,0,,Miễn là cô luôn ở trong tầm mắt của tôi và Akira.
Dialogue: 0,0:01:24.98,0:01:35.07,Sign_Basic,title,0,0,0,,CHUYỂN SINH THÀNH GOBLIN THÌ CÓ GÌ SAI SAO?
Dialogue: 0,0:02:55.52,0:02:59.70,Sign_Basic,text,0,0,0,,{\an3\pos(606,305)}TẬP 6: DÙNG THỜI TRANG ĐÁNH CHIẾN\NTHÌ CÓ GÌ SAI SAO?
Dialogue: 0,0:02:56.44,0:02:58.77,Main - Top,Albert,0,0,0,,Đã lâu không gặp, Akira.
Dialogue: 0,0:02:58.77,0:02:59.65,Main - Top,Akira,0,0,0,,Vâng.
Dialogue: 0,0:03:00.28,0:03:02.55,Main,Albert,0,0,0,,Cô ấy là một trong những Elf mà cậu từng nhắc tới sao?
Dialogue: 0,0:03:02.55,0:03:03.69,Main,Akira,0,0,0,,Đúng vậy.
Dialogue: 0,0:03:03.69,0:03:08.38,Main,Albert,0,0,0,,Tôi hiểu rồi. Vậy ra cậu thực sự đã chữa khỏi căn bệnh của tộc Elf.
Dialogue: 0,0:03:08.38,0:03:10.17,Main,Akira,0,0,0,,Sao đột nhiên ngài lại ghé thăm thế này?
Dialogue: 0,0:03:10.17,0:03:13.09,Main,Albert,0,0,0,,À phải rồi, ta có một đề xuất dành cho cậu.
Dialogue: 0,0:03:13.09,0:03:14.25,Main,Akira,0,0,0,,Đề xuất ạ?
Dialogue: 0,0:03:14.64,0:03:17.54,Main,Albert,0,0,0,,Cậu có ý định thành lập một vương quốc không?
Dialogue: 0,0:03:18.94,0:03:20.14,Main,Akira,0,0,0,,Ngài nói sao cơ ạ?
Dialogue: 0,0:03:20.62,0:03:23.80,Main,Albert,0,0,0,,Cậu có kế hoạch biến ngôi làng này thành một vương quốc không?
Dialogue: 0,0:03:23.80,0:03:27.09,Main,Albert,0,0,0,,Ta muốn cậu trở thành vua của một vương quốc Goblin.
Dialogue: 0,0:03:27.09,0:03:32.53,Main,Albert,0,0,0,,Bọn ta đang cố cấm các mạo hiểm giả xâm phạm nơi này, nhưng mọi chuyện không mấy suôn sẻ.
Dialogue: 0,0:03:32.53,0:03:34.39,Main,Albert,0,0,0,,Luật pháp không có điều khoản cấm đoán nghiêm ngặt
Dialogue: 0,0:03:34.39,0:03:36.59,Main,Albert,0,0,0,,đối với một ngôi làng Ma thú,\Nmà bọn ta cũng không thể tự tiện đặt ra luật mới.
Dialogue: 0,0:03:37.03,0:03:40.87,Main,Albert,0,0,0,,Nhưng nếu đối phương là một vương quốc độc lập, mọi chuyện sẽ hoàn toàn khác.
Dialogue: 0,0:03:41.24,0:03:44.02,Main,Akira,0,0,0,,À, ra là vậy sao.
Dialogue: 0,0:03:44.95,0:03:47.24,Sign_Basic,text,0,0,0,,PHEROMONE
Dialogue: 0,0:03:44.90,0:03:46.83,Main,Eirene,0,0,0,,Sự thật đằng sau chuyện này là gì?
Dialogue: 0,0:03:53.59,0:03:55.45,Main,Eirene,0,0,0,,Sự thật đằng sau chuyện này là gì?
Dialogue: 0,0:03:55.45,0:03:59.13,Main,Albert,0,0,0,,Đó là bước đệm để sau này biến cậu ta thành Ma Vương.
Dialogue: 0,0:04:00.05,0:04:02.37,Main,Eirene,0,0,0,,Tại sao lại muốn biến cậu ta thành Ma Vương?
Dialogue: 0,0:04:02.37,0:04:04.17,Main,Albert,0,0,0,,Vì hai lý do.
Dialogue: 0,0:04:04.17,0:04:07.51,Main,Albert,0,0,0,,Thứ nhất, cậu ta là một Goblin có lý lẽ và biết điều.
Dialogue: 0,0:04:07.51,0:04:09.23,Main,Albert,0,0,0,,Thứ hai, cậu ta chính là...
Dialogue: 0,0:04:14.71,0:04:18.69,Main,Albert,0,0,0,,Chà, mình sơ suất quá rồi.
Dialogue: 0,0:04:20.07,0:04:21.48,Main,Albert,0,0,0,,Khởi động lại (Restart).
Dialogue: 0,0:04:25.33,0:04:27.62,Main,Albert,0,0,0,,Đã lâu không gặp, Akira.
Dialogue: 0,0:04:27.62,0:04:28.48,Main,Akira,0,0,0,,Vâng.
Dialogue: 0,0:04:31.57,0:04:34.49,Main,Albert,0,0,0,,Thứ lỗi cho ta vì đã vào thẳng vấn đề,
Dialogue: 0,0:04:34.49,0:04:37.91,Main,Albert,0,0,0,,nhưng cậu có từng nghĩ đến việc thành lập một vương quốc Goblin không?
Dialogue: 0,0:04:38.32,0:04:40.10,Main,Akira,0,0,0,,Một vương quốc Goblin sao?
Dialogue: 0,0:04:40.59,0:04:43.17,Main,Akira,0,0,0,,Xin hãy cho tôi thêm chút thời gian để cân nhắc.
Dialogue: 0,0:04:43.17,0:04:46.51,Main,Albert,0,0,0,,Tất nhiên rồi. Ta sẽ rất mong chờ một câu trả lời thuận lợi từ cậu.
Dialogue: 0,0:04:49.89,0:04:53.88,Main,Akira,0,0,0,,Eirene, vừa nãy cô vừa dùng năng lực lên người ngài ấy đúng không?
Dialogue: 0,0:04:53.88,0:04:55.23,Main,Eirene,0,0,0,,Cậu nhận ra rồi sao?
Dialogue: 0,0:04:56.60,0:04:59.45,Main,Akira,0,0,0,,Bởi vì hai người rõ ràng rất cảnh giác lẫn nhau,
Dialogue: 0,0:04:59.45,0:05:02.27,Main,Akira,0,0,0,,và ngài ấy đã cố tình di chuyển lên phía đầu gió.
Dialogue: 0,0:05:02.27,0:05:04.94,Main,Eirene,0,0,0,,Tôi không có ác ý gì với ngài ấy đâu.
Dialogue: 0,0:05:04.94,0:05:07.07,Main,Akira,0,0,0,,Cô đã dùng loại pheromone nào thế?
Dialogue: 0,0:05:07.07,0:05:09.77,Main,Eirene,0,0,0,,Một loại khiến người ta sẵn sàng khai ra mọi sự thật.
Dialogue: 0,0:05:09.77,0:05:11.93,Main,Eirene,0,0,0,,Nó rất dễ phát huy tác dụng, nhưng hiệu lực cũng tan biến rất nhanh.
Dialogue: 0,0:05:11.93,0:05:13.86,Main,Eirene,0,0,0,,Nó hoàn toàn không thể tẩy não hay thao túng tâm trí đâu.
Dialogue: 0,0:05:13.86,0:05:16.67,Main,Akira,0,0,0,,Trước đây cô đã từng dùng năng lực này lên ngài ấy chưa?
Dialogue: 0,0:05:16.67,0:05:18.08,Main,Eirene,0,0,0,,Chưa từng.
Dialogue: 0,0:05:18.08,0:05:19.14,Main,Akira,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:05:20.00,0:05:25.42,Italics,Akira,0,0,0,,Nếu vậy, tôi gần như chắc chắn năng lực của ngài ấy có liên quan đến việc tua ngược thời gian.
Dialogue: 0,0:05:25.42,0:05:27.79,Italics,Akira,0,0,0,,Ngài ấy đúng là một nhân vật khó lường thật đấy.
Dialogue: 0,0:05:28.10,0:05:30.73,Main,goblin A,0,0,0,,Thôn trưởng ơi!
Dialogue: 0,0:05:33.73,0:05:35.19,Main,Akira,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:05:35.19,0:05:39.12,Main,goblin A,0,0,0,,Echigoya vừa bị con người tấn công rồi!
Dialogue: 0,0:05:41.66,0:05:42.95,Main,goblin B,0,0,0,,Thôn trưởng!
Dialogue: 0,0:05:42.95,0:05:45.39,Main,goblin B,0,0,0,,Phép Trị Thương (Heal) chẳng ăn thua gì cả!
Dialogue: 0,0:05:46.43,0:05:48.03,Main,Akira,0,0,0,,Mọi người đã cố hết sức rồi.
Dialogue: 0,0:05:48.03,0:05:50.04,Main,Akira,0,0,0,,Giờ có tôi ở đây rồi, cậu ấy sẽ ổn thôi.
Dialogue: 0,0:05:51.12,0:05:52.46,Main,Akira,0,0,0,,Đại Trị Thương (Great Heal).
Dialogue: 0,0:05:59.13,0:06:01.03,Main,Karen,0,0,0,,Chuyện này rốt cuộc là thế nào hả?!
Dialogue: 0,0:06:01.03,0:06:02.46,Main,merchant 1,0,0,0,,Thưa Thanh tra...
Dialogue: 0,0:06:02.46,0:06:03.61,Main,merchant 2,0,0,0,,Chuyện là thế này...
Dialogue: 0,0:06:08.68,0:06:09.69,Main,Karen,0,0,0,,Akira.
Dialogue: 0,0:06:10.21,0:06:11.40,Main,Karen,0,0,0,,Cậu có sao...?
Dialogue: 0,0:06:11.94,0:06:12.97,Main,Akira,0,0,0,,Gì cơ?
Dialogue: 0,0:06:13.40,0:06:15.77,Main,Karen,0,0,0,,Không, không có gì đâu.
Dialogue: 0,0:06:15.77,0:06:16.85,Main,Akira,0,0,0,,Được rồi.
Dialogue: 0,0:06:16.85,0:06:19.24,Main,Akira,0,0,0,,Karen, cô chăm sóc cho Echigoya giúp tôi nhé.
Dialogue: 0,0:06:19.24,0:06:20.76,Main,Akira,0,0,0,,Vết thương không còn nguy hiểm đến tính mạng nữa,
Dialogue: 0,0:06:20.76,0:06:23.74,Main,Akira,0,0,0,,nhưng cậu ấy cần được nghỉ ngơi thật nhiều và bồi bổ dinh dưỡng.
Dialogue: 0,0:06:23.74,0:06:24.78,Main,Karen,0,0,0,,Tôi biết rồi.
Dialogue: 0,0:06:25.20,0:06:27.19,Main,Karen,0,0,0,,Tôi sẽ bảo Masamune nấu gì đó tẩm bổ cho cậu ấy.
Dialogue: 0,0:06:28.16,0:06:30.70,Main,Akira,0,0,0,,Thế còn... hai người thì sao?
Dialogue: 0,0:06:31.54,0:06:33.62,Main,merchant 1,0,0,0,,Bọn tôi vô cùng xin lỗi! Mọi chuyện bỗng trở nên phức tạp quá!
Dialogue: 0,0:06:33.62,0:06:37.03,Main,Akira,0,0,0,,Tôi hiểu, nhưng đó không phải điều tôi muốn biết.
Dialogue: 0,0:06:38.88,0:06:42.42,Main,merchant 1,0,0,0,,Ngay sau khi ngài Echigoya vừa rời khỏi cửa tiệm của chúng tôi,
Dialogue: 0,0:06:42.42,0:06:45.03,Main,merchant 1,0,0,0,,thì một tên mạo hiểm giả bất ngờ lao vào tấn công cậu ấy.
Dialogue: 0,0:06:45.45,0:06:48.02,Main,Akira,0,0,0,,Bất ngờ ư? Hắn tấn công ngẫu nhiên à?
Dialogue: 0,0:06:48.02,0:06:52.04,Main,merchant 1,0,0,0,,Không đâu ạ. Ngài biết đấy, trán của hắn có một hình xăm.
Dialogue: 0,0:06:49.72,0:06:49.76,Sign_Basic,text,0,0,0,,TAO ĐÃ THUA MỘT CON GOBLIN
Dialogue: 0,0:06:53.80,0:06:56.10,Main,merchant 1,0,0,0,,Bọn tôi nhất định sẽ bắt hắn phải chịu trách nhiệm...
Dialogue: 0,0:06:56.10,0:06:58.09,Main,Akira,0,0,0,,Được rồi, tôi nghe đủ rồi.
Dialogue: 0,0:06:58.09,0:07:02.92,Italics,Akira,0,0,0,,Nói cách khác, mối hận thù nhắm vào tôi đã bị trút lên đầu Echigoya.
Dialogue: 0,0:07:02.23,0:07:03.86,Sign_Basic,text,0,0,0,,BAY (FLOAT)
Dialogue: 0,0:07:17.50,0:07:20.65,Main,Simon,0,0,0,,Bọn tôi đã xác định được vị trí của thủ phạm rồi.
Dialogue: 0,0:07:20.65,0:07:23.75,Main,Akira,0,0,0,,Xác định được rồi ư? Vậy các ông vẫn chưa tóm cổ hắn sao?
Dialogue: 0,0:07:24.03,0:07:27.59,Main,Simon,0,0,0,,Chúng tôi không có cơ sở pháp lý nào để làm điều đó cả.
Dialogue: 0,0:07:27.97,0:07:30.05,Main,Simon,0,0,0,,Lần này, nguyên nhân chính là...
Dialogue: 0,0:07:30.62,0:07:35.45,Main,Akira,0,0,0,,Hắn chỉ đơn thuần tấn công một Ma thú đi lạc vào thị trấn thôi, đúng chứ?
Dialogue: 0,0:07:35.45,0:07:36.49,Main,Simon,0,0,0,,Ừm.
Dialogue: 0,0:07:37.02,0:07:39.94,Italics,Akira,0,0,0,,Xét theo góc độ của con người thì điều đó hoàn toàn hợp lý.
Dialogue: 0,0:07:39.94,0:07:43.15,Italics,Akira,0,0,0,,Nếu mọi chuyện diễn ra đúng như lời hoàng tử đề xuất...
Dialogue: 0,0:07:44.85,0:07:47.65,Main,Akira,0,0,0,,Simon, tôi có một câu hỏi dành cho ông.
Dialogue: 0,0:07:47.65,0:07:48.98,Main,Simon,0,0,0,,Chuyện gì thế?
Dialogue: 0,0:07:49.46,0:07:50.64,Main,Akira,0,0,0,,Chuyện này không phải...
Dialogue: 0,0:07:52.56,0:07:55.10,Main,Akira,0,0,0,,do chính ông tự dàn dựng đấy chứ?
Dialogue: 0,0:07:57.24,0:08:01.54,Main,Simon,0,0,0,,Cậu... sẽ phải tin tưởng tôi thôi.
Dialogue: 0,0:08:04.25,0:08:05.28,Main,Akira,0,0,0,,Được rồi.
Dialogue: 0,0:08:05.69,0:08:08.45,Main,Akira,0,0,0,,Nếu là do ông làm thì kế hoạch ắt hẳn đã thành công mĩ mãn hơn thế này nhiều.
Dialogue: 0,0:08:08.45,0:08:10.38,Main,Akira,0,0,0,,Dựa vào điểm đó, tôi sẽ tin ông.
Dialogue: 0,0:08:10.38,0:08:11.73,Main,Simon,0,0,0,,Cậu chắc chắn chứ?
Dialogue: 0,0:08:11.73,0:08:13.39,Main,Simon,0,0,0,,Vậy chúng ta nên giải quyết vụ này thế nào đây?
Dialogue: 0,0:08:13.39,0:08:14.50,Main,Akira,0,0,0,,Tôi giao toàn quyền cho ông xử lý đấy.
Dialogue: 0,0:08:14.50,0:08:18.63,Main,Akira,0,0,0,,Trước đây ông cũng từng phó thác cho tôi mà. Lần này cũng tương tự vậy thôi.
Dialogue: 0,0:08:18.63,0:08:21.93,Main,Simon,0,0,0,,Và cậu chấp nhận chuyện tên thủ phạm được tuyên bố trắng án sao?
Dialogue: 0,0:08:21.93,0:08:22.93,Main,Akira,0,0,0,,Phải.
Dialogue: 0,0:08:24.13,0:08:26.14,Main,Simon,0,0,0,,Cậu đang toan tính điều gì thế?
Dialogue: 0,0:08:26.14,0:08:27.22,Main,Akira,0,0,0,,Chẳng có gì cả.
Dialogue: 0,0:08:27.66,0:08:32.60,Main,Akira,0,0,0,,Tuy nhiên, tôi sẽ ngừng hoàn toàn việc cử Echigoya và những người khác tới đây,
Dialogue: 0,0:08:32.60,0:08:35.61,Main,Akira,0,0,0,,cho đến khi quyền lợi và sự an toàn của loài Goblin được đảm bảo.
Dialogue: 0,0:08:36.67,0:08:38.16,Main,Simon,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:08:40.66,0:08:45.03,Main,maid,0,0,0,,Hôm nay trông ngài Akira có vẻ khác lạ ghê.
Dialogue: 0,0:08:45.38,0:08:48.55,Main,maid,0,0,0,,Thưa ngài, đã có chuyện gì xảy ra thế ạ?
Dialogue: 0,0:08:48.55,0:08:52.57,Main,Simon,0,0,0,,Cậu ta là một kẻ đáng sợ hơn ta tưởng tượng nhiều.
Dialogue: 0,0:08:53.08,0:08:53.96,Main,maid,0,0,0,,Dạ?
Dialogue: 0,0:08:53.96,0:08:58.39,Main,Simon,0,0,0,,Càng tức giận, cậu ta lại càng trở nên điềm tĩnh lạ thường.
Dialogue: 0,0:08:58.39,0:09:01.30,Main,Simon,0,0,0,,Cậu ta là một kẻ có thể trở nên tàn nhẫn và lạnh lùng.
Dialogue: 0,0:09:03.73,0:09:09.02,Main,Simon,0,0,0,,Nếu cậu ta ngừng gửi Goblin đến, giá trị khan hiếm của các bộ trang phục sẽ tăng vọt.
Dialogue: 0,0:09:09.02,0:09:12.15,Main,Simon,0,0,0,,Nhưng liệu đó có phải mục tiêu duy nhất của cậu ta không?
Dialogue: 0,0:09:12.15,0:09:13.67,Main,spy,0,0,0,,Thưa chủ nhân.
Dialogue: 0,0:09:14.23,0:09:15.44,Main,Simon,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:09:15.44,0:09:19.49,Main,spy,0,0,0,,Tên thủ lĩnh Goblin vừa tiếp xúc với một vài tay anh chị bất hảo ở địa phương.
Dialogue: 0,0:09:19.49,0:09:22.80,Main,spy,0,0,0,,Có vẻ như cậu ta đang lên kế hoạch buôn lậu quần áo.
Dialogue: 0,0:09:23.69,0:09:25.13,Main,Simon,0,0,0,,Aha.
Dialogue: 0,0:09:26.33,0:09:31.20,Main,Simon,0,0,0,,Xem ra cậu ta cũng không ngại dùng tới những biện pháp quyết liệt đấy chứ.
Dialogue: 0,0:09:34.31,0:09:36.46,Main,Tony's wife,0,0,0,,Này, rốt cuộc chuyện này là thế nào hả?!
Dialogue: 0,0:09:36.46,0:09:39.57,Main,Tony's wife,0,0,0,,Tôi tưởng hôm nay quần áo của tiệm Echigoya sẽ về chứ!
Dialogue: 0,0:09:39.57,0:09:41.57,Main,woman 1,0,0,0,,Tôi đã ngóng chờ mãi để xem những mẫu thiết kế mới đấy!
Dialogue: 0,0:09:41.57,0:09:43.74,Main,woman 2,0,0,0,,Tuần sau đi hẹn hò thì tôi biết mặc cái gì bây giờ hả?!
Dialogue: 0,0:09:43.74,0:09:47.55,Main,shopkeeper,0,0,0,,Tôi vô cùng xin lỗi quý khách! Tôi cũng muốn bán cho mọi người lắm chứ!
Dialogue: 0,0:09:47.55,0:09:49.65,Main,Tony's wife,0,0,0,,Tại sao hàng vẫn chưa về tới nơi hả?!
Dialogue: 0,0:09:49.65,0:09:53.93,Main,shopkeeper,0,0,0,,Tôi nghe nói có liên quan đến một gã mạo hiểm giả nào đó.
Dialogue: 0,0:09:56.71,0:09:57.70,Main,Tony's wife,0,0,0,,Ông xã ơi!
Dialogue: 0,0:09:57.93,0:10:01.90,Main,Tony's wife,0,0,0,,Em nghe nói anh thả tự do cho kẻ đã làm bé Echigoya bị thương đúng không?!
Dialogue: 0,0:10:02.56,0:10:06.88,Main,Tony,0,0,0,,Thả tự do sao? Chuyện là... hắn ta đâu có phạm luật gì đâu em...
Dialogue: 0,0:10:06.88,0:10:10.04,Main,Tony's wife,0,0,0,,Không thể tin nổi! Sao anh không trừng phạt hắn ta chứ?!
Dialogue: 0,0:10:10.04,0:10:15.71,Main,Tony,0,0,0,,Thì là, quy chụp lại thì hắn chỉ hạ gục một con Ma thú đi lạc vào thị trấn thôi mà.
Dialogue: 0,0:10:15.71,0:10:16.66,Main,Tony,0,0,0,,Luật đâu có quy định xử phạt chuyện đó đâu em.
Dialogue: 0,0:10:16.66,0:10:21.84,Main,Tony's wife,0,0,0,,Cái gì cơ?! Anh dám gọi mấy bé tí hon dễ thương ngây thơ đó là Ma thú á?!
Dialogue: 0,0:10:22.11,0:10:24.07,Main,Tony's wife,0,0,0,,Nếu anh làm việc cho đàng hoàng,
Dialogue: 0,0:10:24.07,0:10:27.20,Main,Tony's wife,0,0,0,,thì em đã có thể mua được vài bộ đồ mới toanh của bé Echigoya rồi!
Dialogue: 0,0:10:27.20,0:10:31.20,Main,Tony,0,0,0,,Em làm quá lên rồi đấy. Em còn bao nhiêu quần áo khác cơ mà.
Dialogue: 0,0:10:31.20,0:10:33.43,Main,Tony's wife,0,0,0,,Anh vừa nói đùa đấy à?
Dialogue: 0,0:10:34.17,0:10:35.44,Main,Tony,0,0,0,,Anh xin lỗi mà.
Dialogue: 0,0:10:35.44,0:10:36.39,Main,Tony's wife,0,0,0,,Mặc kệ anh đấy!
Dialogue: 0,0:10:41.43,0:10:44.15,Main,Tony,0,0,0,,Mình phải mau chóng giải quyết vụ này cho xong, không thì toi đời mất.
Dialogue: 0,0:10:47.95,0:10:50.25,Main,Karen,0,0,0,,Bầu không khí trong thành phố bắt đầu thay đổi rồi đấy.
Dialogue: 0,0:10:51.87,0:10:53.02,Main,Akira,0,0,0,,Hửm?
Dialogue: 0,0:10:53.49,0:10:57.07,Main,Karen,0,0,0,,Đặc biệt là các quý bà quý cô, họ đang kịch liệt lên án tên mạo hiểm giả đã tấn công Echigoya,
Dialogue: 0,0:10:57.07,0:11:00.08,Main,Karen,0,0,0,,cũng như chỉ trích công hội vì đã giao nhiệm vụ cho hắn.
Dialogue: 0,0:11:00.85,0:11:04.26,Main,Karen,0,0,0,,Nếu luật pháp không đứng về phía mình, cậu sẽ trả đũa bằng những cách tinh vi hơn sao?
Dialogue: 0,0:11:04.26,0:11:05.96,Main,Akira,0,0,0,,Không phải thế đâu.
Dialogue: 0,0:11:06.67,0:11:09.35,Main,Akira,0,0,0,,Trả đũa chỉ là phương án cuối cùng khi mọi cách khác đều đã cạn kiệt.
Dialogue: 0,0:11:09.77,0:11:12.66,Main,Akira,0,0,0,,Điều cần làm bây giờ là ngăn chặn chuyện tương tự tái diễn.
Dialogue: 0,0:11:12.66,0:11:16.45,Main,Akira,0,0,0,,Tôi đã quá ngây thơ khi nghĩ rằng nếu thất bại thì ta chỉ việc từ bỏ giao thương là xong.
Dialogue: 0,0:11:16.45,0:11:21.52,Main,Akira,0,0,0,,Tôi đã không lường trước rằng thất bại có thể đe dọa đến tính mạng của các Goblin.
Dialogue: 0,0:11:21.52,0:11:23.80,Main,Akira,0,0,0,,Đây hoàn toàn là sai lầm của tôi.
Dialogue: 0,0:11:23.80,0:11:26.60,Main,Akira,0,0,0,,Vì thế tôi phải đảm bảo chuyện này sẽ không bao giờ xảy ra lần nữa.
Dialogue: 0,0:11:26.94,0:11:31.40,Main,Karen,0,0,0,,Kế hoạch của cậu đã xoay chuyển thành công dư luận rồi đấy.
Dialogue: 0,0:11:31.40,0:11:33.38,Main,Karen,0,0,0,,Đến mức mà một hội phụ nữ trong thành phố
Dialogue: 0,0:11:33.38,0:11:37.25,Main,Karen,0,0,0,,đã đệ đơn yêu cầu công hội phải có biện pháp bảo vệ cho loài Goblin rồi.
Dialogue: 0,0:11:37.25,0:11:42.04,Main,Akira,0,0,0,,Nếu dư luận đang thay đổi tích cực như vậy, có khi chúng ta chẳng cần luật pháp cũng được an toàn.
Dialogue: 0,0:11:44.54,0:11:46.91,Main,Karen,0,0,0,,Tôi không thể bảo cậu đừng bận lòng suy nghĩ,
Dialogue: 0,0:11:46.91,0:11:49.89,Main,Karen,0,0,0,,nhưng tình hình đang tiến triển tốt đẹp hơn nhờ quyết định của cậu đấy.
Dialogue: 0,0:11:49.89,0:11:51.28,Main,Karen,0,0,0,,Làm tốt lắm.
Dialogue: 0,0:11:56.20,0:11:58.96,Italics,Akira,0,0,0,,Mình đã khiến Karen phải lo lắng vì chuyện này.
Dialogue: 0,0:12:00.88,0:12:02.43,Italics,Akira,0,0,0,,Thế nhưng cô ấy đã hiểu nhầm rồi.
Dialogue: 0,0:12:03.31,0:12:07.50,Italics,Akira,0,0,0,,Mình đã dùng kỹ năng Kẻ Mạnh Sinh Tồn để ngấm ngầm định hướng dư luận trong thành phố.
Dialogue: 0,0:12:07.50,0:12:10.36,Italics,Akira,0,0,0,,Và chính mình là người đã gián tiếp gửi lá đơn yêu cầu bảo vệ đó.
Dialogue: 0,0:12:13.41,0:12:16.41,Main,Akira,0,0,0,,Quyền năng của Ma Vương sao...?
Dialogue: 0,0:12:23.29,0:12:24.71,Main,Karen,0,0,0,,Cậu đến muộn đấy nhé.
Dialogue: 0,0:12:25.36,0:12:27.39,Main,Akira,0,0,0,,Ừ, muộn một chút xíu.
Dialogue: 0,0:12:27.39,0:12:29.56,Main,Akira,0,0,0,,Cô không quay về thành phố sao?
Dialogue: 0,0:12:29.91,0:12:32.72,Main,Karen,0,0,0,,Mỗi lần tôi ở đó, các quý bà lại vây lấy tra hỏi
Dialogue: 0,0:12:32.72,0:12:35.74,Main,Karen,0,0,0,,xem liệu tôi có thể thu xếp lấy giúp vài bộ đồ của Echigoya được không.
Dialogue: 0,0:12:35.74,0:12:38.05,Main,Akira,0,0,0,,À. Cho tôi xin lỗi nhé.
Dialogue: 0,0:12:38.05,0:12:40.21,Main,Akira,0,0,0,,Chắc mọi chuyện sẽ sớm lắng xuống thôi mà.
Dialogue: 0,0:12:41.57,0:12:43.47,Main,Karen,0,0,0,,Cậu đang thực hiện kế hoạch gì à?
Dialogue: 0,0:12:48.57,0:12:51.70,Main,Karen,0,0,0,,Akira, cậu thấy cô ấy thế nào?
Dialogue: 0,0:12:54.14,0:12:57.48,Main,Akira,0,0,0,,Thấy thế nào ư? Tôi thấy cô ấy đang rất tận hưởng niềm vui đấy chứ.
Dialogue: 0,0:12:58.18,0:12:59.29,Main,Karen,0,0,0,,Đúng vậy.
Dialogue: 0,0:12:59.77,0:13:02.30,Main,Karen,0,0,0,,Thế nhưng khi mới đến làng, cô ấy đâu có như thế.
Dialogue: 0,0:13:03.32,0:13:08.02,Italics,Akira,0,0,0,,Hồi đó, gương mặt của Chloe trông như bị ám ảnh
Dialogue: 0,0:13:08.02,0:13:11.31,Italics,Akira,0,0,0,,bởi những cảm xúc tiêu cực như hận thù và khao khát trả thù vậy.
Dialogue: 0,0:13:13.23,0:13:17.27,Main,Karen,0,0,0,,Nét mặt của một người sẽ ảnh hưởng rất lớn đến những người xung quanh họ.
Dialogue: 0,0:13:17.69,0:13:21.31,Main,Karen,0,0,0,,Từ khi cô ấy gắn bó với cậu và những đứa trẻ Goblin ngây thơ,
Dialogue: 0,0:13:21.31,0:13:23.40,Main,Karen,0,0,0,,cô ấy đã cười nhiều hơn hẳn.
Dialogue: 0,0:13:26.91,0:13:30.95,Main,Karen,0,0,0,,Còn hiện tại, vẻ mặt của cậu lại giống hệt cô ấy ngày trước đấy.
Dialogue: 0,0:13:32.54,0:13:34.24,Main,Akira,0,0,0,,Tôi sao?
Dialogue: 0,0:13:37.42,0:13:39.39,Main,Karen,0,0,0,,Này mọi người ơi!
Dialogue: 0,0:13:39.95,0:13:41.80,Main,goblin C,0,0,0,,Dạ, chị Karen?
Dialogue: 0,0:13:41.80,0:13:43.01,Main,goblin D,0,0,0,,Có chuyện gì thế ạ?
Dialogue: 0,0:13:43.34,0:13:45.80,Main,Karen,0,0,0,,Hình như Thôn trưởng Akira làm việc xong rồi đấy.
Dialogue: 0,0:13:47.09,0:13:48.31,Main,goblin C,0,0,0,,Thật sao ạ?
Dialogue: 0,0:13:48.31,0:13:49.32,Main,goblin D,0,0,0,,Đến giờ giải lao rồi ư?
Dialogue: 0,0:13:49.32,0:13:51.06,Main,Akira,0,0,0,,Không, tôi vẫn còn...
Dialogue: 0,0:13:51.06,0:13:52.58,Main,goblin E,0,0,0,,Thế thì mở tiệc thôi nào!
Dialogue: 0,0:13:52.58,0:13:54.57,Main,goblin F,0,0,0,,Cùng nhảy múa với Thôn trưởng đi!
Dialogue: 0,0:13:53.76,0:13:55.05,Main - Top,Akira,0,0,0,,N-Này các cậu!
Dialogue: 0,0:13:55.05,0:13:57.49,Main,goblin C,0,0,0,,Lúc nào ngài cũng làm việc chăm chỉ hết trơn á, Thôn trưởng ơi.
Dialogue: 0,0:13:57.49,0:13:59.71,Main,goblin G,0,0,0,,Ngài muốn uống chút rượu không? Hay nhảy cùng em nhé?
Dialogue: 0,0:13:59.71,0:14:02.82,Main,goblin G,0,0,0,,Hay là... sinh em bé với em nha?
Dialogue: 0,0:14:02.82,0:14:04.60,Main,Chloe,0,0,0,,Không có chuyện đó đâu nhé!
Dialogue: 0,0:14:04.60,0:14:08.31,Main,Chloe,0,0,0,,Akira đang mệt rồi, hãy để cậu ấy được nghỉ ngơi thoải mái đi!
Dialogue: 0,0:14:09.17,0:14:14.21,Italics,Akira,0,0,0,,Mình cứ ngỡ là bản thân đang dốc hết sức vì lợi ích của mọi người.
Dialogue: 0,0:14:14.61,0:14:16.79,Italics,Akira,0,0,0,,Thế mà trong đầu lại nảy ra những toan tính ngớ ngẩn đến vậy.
Dialogue: 0,0:14:17.49,0:14:21.40,Italics,Akira,0,0,0,,Nét mặt của một người sẽ ảnh hưởng đến những người xung quanh sao?
Dialogue: 0,0:14:22.28,0:14:23.67,Main,Akira,0,0,0,,Cảm ơn cô nhé, Karen.
Dialogue: 0,0:14:24.81,0:14:29.73,Main,Akira,0,0,0,,Chính nhờ có Karen mà lúc này mình mới có thể mỉm cười được.
Dialogue: 0,0:14:33.11,0:14:34.56,Main,girl,0,0,0,,Của anh đây ạ.
Dialogue: 0,0:14:34.56,0:14:35.65,Main,Akira,0,0,0,,Hôm nay lại cảm ơn em nhiều nhé.
Dialogue: 0,0:14:36.22,0:14:38.38,Main,Akira,0,0,0,,Đi về cẩn thận đấy.
Dialogue: 0,0:14:38.38,0:14:40.06,Main,girl,0,0,0,,Tạm biệt anh ạ!
Dialogue: 0,0:14:40.06,0:14:41.52,Main,Karen,0,0,0,,Ai thế cậu?
Dialogue: 0,0:14:42.83,0:14:45.31,Main,Akira,0,0,0,,Cô bé là một cư dân trong thành phố.
Dialogue: 0,0:14:45.31,0:14:46.87,Main,Karen,0,0,0,,Cậu vừa nhận được gì từ cô bé thế?
Dialogue: 0,0:14:46.87,0:14:48.12,Main,Akira,0,0,0,,À, cái này sao?
Dialogue: 0,0:14:49.08,0:14:51.44,Main,Karen,0,0,0,,Mấy hòn đá ư? Dùng chúng để làm gì vậy?
Dialogue: 0,0:14:51.97,0:14:54.32,Main,Akira,0,0,0,,Tôi đang thử nghiệm kỹ năng Kẻ Mạnh Sinh Tồn.
Dialogue: 0,0:14:55.66,0:14:57.61,Main,Akira,0,0,0,,Không phải để tôi lạm dụng vào việc xấu đâu nhé!
Dialogue: 0,0:14:58.01,0:15:00.70,Main,Akira,0,0,0,,Tôi chỉ muốn hiểu thật rõ cách thức vận hành của nó thôi.
Dialogue: 0,0:15:02.02,0:15:04.35,Main,Karen,0,0,0,,Vậy cậu đã tìm hiểu được những gì rồi?
Dialogue: 0,0:15:04.35,0:15:06.17,Main,Akira,0,0,0,,Khái quát lại thì có hai điều.
Dialogue: 0,0:15:06.17,0:15:09.71,Main,Akira,0,0,0,,Thứ nhất, tôi có thể khiến một người liên tục lặp lại cùng một hành vi.
Dialogue: 0,0:15:09.71,0:15:14.06,Main,Akira,0,0,0,,Thứ hai, họ sẽ không thể tuân theo mệnh lệnh nếu điều đó vượt quá khả năng của họ.
Dialogue: 0,0:15:14.06,0:15:16.60,Main,Karen,0,0,0,,Không thể tuân theo ư? Ý cậu là sao?
Dialogue: 0,0:15:16.60,0:15:20.36,Main,Akira,0,0,0,,Ý tôi là những điều bất khả thi, chẳng hạn như "mọc cánh ra"
Dialogue: 0,0:15:20.36,0:15:22.51,Main,Akira,0,0,0,,hay "biến thành một con mèo."
Dialogue: 0,0:15:22.97,0:15:24.44,Main,Karen,0,0,0,,Nghe cũng hợp lý đấy.
Dialogue: 0,0:15:25.18,0:15:26.78,Main,Karen,0,0,0,,Theo những gì tôi được biết,
Dialogue: 0,0:15:26.78,0:15:29.59,Main,Karen,0,0,0,,thì tôi đoán cậu đang vận dụng nó hiệu quả hơn cả Ma Vương tiền nhiệm đấy.
Dialogue: 0,0:15:29.59,0:15:31.00,Main,Akira,0,0,0,,Cô nghĩ thế thật sao?
Dialogue: 0,0:15:31.44,0:15:34.62,Main,Karen,0,0,0,,Cứ như thể cậu có thể điều khiển cả một vương quốc từ trong bóng tối vậy.
Dialogue: 0,0:15:35.66,0:15:37.78,Main,Akira,0,0,0,,Tôi đâu có rảnh rỗi mà làm những chuyện như thế chứ.
Dialogue: 0,0:15:38.02,0:15:41.83,Main,Karen,0,0,0,,Cũng đúng, cậu sẽ chẳng đời nào làm vậy nếu không có lý do chính đáng.
Dialogue: 0,0:15:43.68,0:15:44.66,Main,Akira,0,0,0,,Karen này.
Dialogue: 0,0:15:46.13,0:15:49.19,Main,Akira,0,0,0,,Xin lỗi cô, và cũng cảm ơn cô nhiều nhé.
Dialogue: 0,0:15:49.80,0:15:51.72,Main,Karen,0,0,0,,T-Tự dưng sao lại nói thế chứ?
Dialogue: 0,0:15:51.72,0:15:54.44,Main,Akira,0,0,0,,Nhờ có cô mà tôi đã kịp thời chuyển hướng suy nghĩ đúng đắn.
Dialogue: 0,0:15:54.44,0:15:55.66,Main,Akira,0,0,0,,Tôi biết ơn cô lắm.
Dialogue: 0,0:15:56.01,0:15:57.86,Main,Karen,0,0,0,,Giờ cậu đã thấy ổn hơn chưa?
Dialogue: 0,0:15:58.43,0:16:02.01,Main,Akira,0,0,0,,Ổn rồi. Tôi sẽ không bao giờ đánh mất mục tiêu ban đầu của mình nữa.
Dialogue: 0,0:16:02.57,0:16:06.31,Main,Akira,0,0,0,,Tôi chỉ muốn những người dân của mình có được một cuộc sống hạnh phúc mà thôi.
Dialogue: 0,0:16:08.06,0:16:09.35,Main,Karen,0,0,0,,Được rồi.
Dialogue: 0,0:16:09.35,0:16:11.91,Main,Karen,0,0,0,,Hãy tiếp tục dẫn dắt mọi việc đi đúng hướng nhé, Thôn trưởng.
Dialogue: 0,0:16:11.91,0:16:13.03,Main,Akira,0,0,0,,Ừ.
Dialogue: 0,0:16:20.12,0:16:21.59,Main,Akira,0,0,0,,Tôi xin lỗi ông nhé.
Dialogue: 0,0:16:23.37,0:16:26.83,Main,Simon,0,0,0,,C-Có chuyện gì thế hỡi người anh em chiến hữu của tôi?
Dialogue: 0,0:16:26.83,0:16:28.62,Main,Akira,0,0,0,,Lúc trước tôi đã sai rồi.
Dialogue: 0,0:16:28.62,0:16:30.95,Main,Akira,0,0,0,,Tôi đã quá nóng giận và để cơn giận che mờ lý trí.
Dialogue: 0,0:16:30.95,0:16:32.16,Main,Akira,0,0,0,,Hy vọng ông có thể bỏ qua cho tôi.
Dialogue: 0,0:16:32.16,0:16:34.90,Main,Simon,0,0,0,,Này, chuyện đó cũng khó trách cậu mà.
Dialogue: 0,0:16:34.90,0:16:39.17,Main,Simon,0,0,0,,Dù vậy thì tôi thực sự kinh ngạc trước tốc độ lấy lại phong độ của cậu đấy.
Dialogue: 0,0:16:39.51,0:16:41.34,Main,Akira,0,0,0,,Bị Karen mắng cho một trận tơi bời đấy mà.
Dialogue: 0,0:16:45.41,0:16:48.02,Main,Simon,0,0,0,,À, nếu thế thì tôi hiểu rồi.
Dialogue: 0,0:16:48.02,0:16:50.14,Italics,Akira,0,0,0,,Có vẻ như ông ấy lại hiểu lầm sang hướng khác rồi thì phải.
Dialogue: 0,0:16:50.14,0:16:52.88,Main,Akira,0,0,0,,Và vì thế, tôi có một đề xuất này.
Dialogue: 0,0:16:53.50,0:16:54.70,Main,Simon,0,0,0,,Chẳng hạn như điều gì?
Dialogue: 0,0:16:54.70,0:16:58.87,Main,Akira,0,0,0,,Chúng ta có thể thiết lập một khu vực đồng quản lý giữa ngôi làng và thành phố được không?
Dialogue: 0,0:16:59.99,0:17:01.28,Main,Simon,0,0,0,,Ồ?
Dialogue: 0,0:17:01.28,0:17:04.81,Main,Akira,0,0,0,,Tôi muốn có một nơi mà tôi có thể yên tâm cử các Goblin tới đó.
Dialogue: 0,0:17:05.20,0:17:06.84,Main,Simon,0,0,0,,Đúng là như vậy.
Dialogue: 0,0:17:06.84,0:17:12.76,Main,Simon,0,0,0,,Việc ngay lập tức cấm chỉ hành vi gây hại cho Goblin lúc này quả thực rất khó khăn.
Dialogue: 0,0:17:12.76,0:17:15.12,Main,Akira,0,0,0,,Phía chúng tôi cũng đối mặt với vấn đề tương tự.
Dialogue: 0,0:17:15.12,0:17:17.58,Main,Akira,0,0,0,,Nếu loài Goblin đột ngột lập quốc lúc này,
Dialogue: 0,0:17:17.58,0:17:20.39,Main,Akira,0,0,0,,chắc chắn sẽ khiến tất cả các thế lực xung quanh hoang mang lo ngại.
Dialogue: 0,0:17:20.39,0:17:26.25,Italics,Akira,0,0,0,,Có thể một ngày nào đó chúng tôi bắt buộc phải lập quốc, nhưng hiện tại rủi ro là quá lớn.
Dialogue: 0,0:17:26.25,0:17:30.70,Italics,Akira,0,0,0,,Simon thì tôi hiểu, nhưng tôi vẫn chưa thể nắm rõ dã tâm thực sự của vị hoàng tử kia.
Dialogue: 0,0:17:30.70,0:17:32.76,Main,Akira,0,0,0,,Nếu chúng ta lập ra một khu vực đồng quản lý,
Dialogue: 0,0:17:32.76,0:17:36.50,Main,Akira,0,0,0,,chúng ta có thể trao quyền bình đẳng có giới hạn cho cả con người và Goblin,
Dialogue: 0,0:17:36.50,0:17:38.74,Main,Akira,0,0,0,,và nó sẽ đóng vai trò răn đe hiệu quả nếu có luật pháp ràng buộc.
Dialogue: 0,0:17:39.08,0:17:41.17,Main,Simon,0,0,0,,Rốt cuộc vẫn quay về với luật pháp nhỉ?
Dialogue: 0,0:17:41.75,0:17:46.91,Main,Simon,0,0,0,,Cái cách cậu thao túng cảm xúc của đám đông trước đó thực sự khiến tôi phát khiếp đấy.
Dialogue: 0,0:17:46.91,0:17:51.84,Italics,Akira,0,0,0,,Biết ngay là ông ấy đã nhận ra mình đứng sau kích động các quý cô mà.
Dialogue: 0,0:17:51.84,0:17:53.88,Main,Akira,0,0,0,,Tuy nhiên có một vấn đề nảy sinh.
Dialogue: 0,0:17:54.17,0:17:56.73,Main,Akira,0,0,0,,Đó là khoản thuế thương mại thu được từ quần áo của Echigoya.
Dialogue: 0,0:17:56.73,0:17:59.29,Main,Akira,0,0,0,,Ông sẽ không thể thu khoản phí đó trong khu vực đồng quản lý nữa.
Dialogue: 0,0:17:59.29,0:18:03.98,Main,Simon,0,0,0,,Tôi không bận tâm đâu. Như thế vẫn tốt hơn nhiều so với việc bất hòa tranh chấp.
Dialogue: 0,0:18:04.30,0:18:06.23,Main,Akira,0,0,0,,Cảm ơn ông nhiều nhé, Simon!
Dialogue: 0,0:18:06.65,0:18:08.86,Main,Akira,0,0,0,,Vậy là giải quyết xong xuôi một mối lo rồi!
Dialogue: 0,0:18:17.87,0:18:20.61,Main,soldier,0,0,0,,Báo cáo Hoàng tử! Thuộc hạ xin chịu tội.
Dialogue: 0,0:18:20.61,0:18:22.92,Main,soldier,0,0,0,,Chúng thuộc hạ đã để mất dấu Hắc Thiên Long (Dark-Sky Dragon) rồi ạ.
Dialogue: 0,0:18:22.92,0:18:25.75,Main,soldier,0,0,0,,Nghi ngờ là nó đã xâm nhập vào lãnh thổ của loài Goblin.
Dialogue: 0,0:18:28.45,0:18:31.25,Main,Albert,0,0,0,,Hãy tiếp tục tìm kiếm sát tới tận ranh giới đường biên.
Dialogue: 0,0:18:31.25,0:18:33.21,Main,Albert,0,0,0,,Tuyệt đối cẩn thận không được xâm phạm vào lãnh thổ của họ.
Dialogue: 0,0:18:33.21,0:18:34.34,Main,soldier,0,0,0,,Rõ, thưa Hoàng tử.
Dialogue: 0,0:18:34.64,0:18:37.84,Main,Albert,0,0,0,,Những lúc như thế này, năng lực của mình hoàn toàn vô dụng.
Dialogue: 0,0:18:38.59,0:18:44.26,Sign_Basic,text,0,0,0,,THẤT BẠI QUÁ TAM (EIGHTH TIME'S THE CHARM)
Dialogue: 0,0:18:38.38,0:18:41.25,Italics,Albert,0,0,0,,"Thất Bại Quá Tam" là một kỹ năng cực kỳ hùng mạnh,
Dialogue: 0,0:18:41.25,0:18:44.25,Italics,Albert,0,0,0,,có thể đảo ngược thời gian và xóa bỏ một sự kiện như thể chưa từng xảy ra,
Dialogue: 0,0:18:44.25,0:18:46.07,Italics,Albert,0,0,0,,thế nhưng nó lại có những hạn chế vô cùng ngặt nghèo.
Dialogue: 0,0:18:46.07,0:18:49.46,Italics,Albert,0,0,0,,Nó chỉ có thể tua ngược cùng một sự kiện,
Dialogue: 0,0:18:49.46,0:18:52.97,Italics,Albert,0,0,0,,hoặc một mục tiêu nhất định tối đa bảy lần.
Dialogue: 0,0:18:52.97,0:18:54.51,Italics,Albert,0,0,0,,Thời gian luôn trôi đi không ngừng nghỉ,
Dialogue: 0,0:18:54.51,0:18:57.75,Italics,Albert,0,0,0,,bởi chỉ những sai lầm xảy ra trong vòng ba mươi phút mới có thể đảo ngược.
Dialogue: 0,0:18:58.13,0:19:01.23,Italics,Albert,0,0,0,,Sau nửa tiếng đồng hồ, mọi sự việc đều sẽ trở thành dĩ vãng vĩnh viễn không thể thay đổi.
Dialogue: 0,0:19:01.61,0:19:06.04,Italics,Albert,0,0,0,,Hơn nữa ta chỉ có thể tua ngược những gì nằm trong phạm vi nhận thức của chính mình,
Dialogue: 0,0:19:06.04,0:19:08.08,Italics,Albert,0,0,0,,điều đó hoàn toàn loại trừ tình huống hiện tại.
Dialogue: 0,0:19:08.88,0:19:09.79,Main,Albert,0,0,0,,Saxon.
Dialogue: 0,0:19:09.79,0:19:10.79,Main,Saxon,0,0,0,,Có thuộc hạ, thưa Hoàng tử.
Dialogue: 0,0:19:10.79,0:19:12.61,Main,Albert,0,0,0,,Hãy quay về trước ta,
Dialogue: 0,0:19:12.61,0:19:15.50,Main,Albert,0,0,0,,và tăng cường thêm lính canh giám sát chặt chẽ Hầu Tước Ma Quỷ và Tinh Linh Công Chúa.
Dialogue: 0,0:19:15.50,0:19:16.58,Main,Saxon,0,0,0,,Tuân lệnh ngài.
Dialogue: 0,0:19:18.78,0:19:22.39,Italics,Albert,0,0,0,,Vẫn còn quá sớm để Tam Đại Quý Tộc tiếp xúc với Akira.
Dialogue: 0,0:19:23.21,0:19:27.45,Main,Tony,0,0,0,,Tôi là Tony Weston, hiện đang đảm nhiệm chức vụ Hội trưởng Công hội.
Dialogue: 0,0:19:27.45,0:19:29.46,Main,Tony,0,0,0,,Còn đây là người bạn tri kỷ lâu năm của tôi.
Dialogue: 0,0:19:29.46,0:19:32.33,Main,Tony,0,0,0,,Cậu ấy được mệnh danh là Kainas - Vô Hình Kiếm (The Unformed Blade).
Dialogue: 0,0:19:33.14,0:19:34.41,Main,Akira,0,0,0,,Vô Hình Kiếm sao.
Dialogue: 0,0:19:34.86,0:19:36.06,Sign_Basic,text,0,0,0,,THẤU THỊ NHÃN (SEARCH EYE)
Dialogue: 0,0:19:34.88,0:19:36.06,Italics,Akira,0,0,0,,Thấu Thị Nhãn.
Dialogue: 0,0:19:36.06,0:19:39.28,Sign_Basic,text,0,0,0,,BẬC THẦY BINH KHÍ (WEAPON MASTER)
Dialogue: 0,0:19:36.57,0:19:39.45,Italics,Akira,0,0,0,,Đó là một kỹ năng hiếm có. Anh ta không phải dạng vừa đâu.
Dialogue: 0,0:19:39.53,0:19:41.49,Sign_Basic,text,0,0,0,,KHÔNG CÓ GÌ
Dialogue: 0,0:19:41.48,0:19:43.78,Main,Akira,0,0,0,,Vậy hai người có chuyện gì cần bàn bạc với tôi sao?
Dialogue: 0,0:19:43.78,0:19:47.82,Main,Tony,0,0,0,,Cậu có phiền lòng nếu để cậu ấy làm vệ sĩ một thời gian không?
Dialogue: 0,0:19:47.82,0:19:49.60,Main,Akira,0,0,0,,Vệ sĩ cho ai cơ ạ?
Dialogue: 0,0:19:49.60,0:19:53.53,Main,Tony,0,0,0,,Cho Echigoya. Cậu ấy là kiếm sĩ số một của tôi đấy.
Dialogue: 0,0:19:53.53,0:19:55.74,Main,Akira,0,0,0,,Oa, tay kiếm số một của ông sao?
Dialogue: 0,0:19:56.09,0:19:58.59,Main,Akira,0,0,0,,Nhưng tại sao ông lại đưa ra yêu cầu như thế chứ?
Dialogue: 0,0:19:58.59,0:20:02.95,Main,Tony,0,0,0,,À thì, chuyện là bà xã nhà tôi là một fan cuồng nhiệt của thương hiệu Echigoya.
Dialogue: 0,0:20:02.95,0:20:05.13,Main,Tony,0,0,0,,Tôi bị bà ấy cằn nhằn mắng mỏ cho lên bờ xuống ruộng luôn.
Dialogue: 0,0:20:05.73,0:20:09.40,Italics,Akira,0,0,0,,Có vẻ mọi chuyện đang diễn ra theo ý mình còn thuận lợi hơn cả dự tính.
Dialogue: 0,0:20:10.54,0:20:14.14,Italics,Akira,0,0,0,,Các mẫu trang phục của Echigoya đã trở thành thương hiệu nổi tiếng trong thị trấn.
Dialogue: 0,0:20:14.14,0:20:19.21,Italics,Akira,0,0,0,,Mình biết thừa một khi nguồn cung bị cắt đứt, các quý cô sẽ lập tức lên tiếng bày tỏ sự bất mãn.
Dialogue: 0,0:20:19.21,0:20:23.94,Italics,Akira,0,0,0,,Và khi phụ nữ nổi giận, cánh đàn ông cũng chẳng thể nào ngồi yên được.
Dialogue: 0,0:20:23.94,0:20:26.42,Main,Tony,0,0,0,,Thật ra thì chuyện đó cũng xảy ra với cả cậu ta nữa đấy.
Dialogue: 0,0:20:26.42,0:20:27.35,Main,Akira,0,0,0,,Dạ?
Dialogue: 0,0:20:27.35,0:20:29.03,Main,Tony,0,0,0,,Là con gái cậu ấy đấy mà.
Dialogue: 0,0:20:29.03,0:20:33.95,Flashback,Kainas's daughter,0,0,0,,Bố giữ chức vụ to tát thế mà đến một bé Goblin nhỏ xíu cũng không bảo vệ nổi sao bố?
Dialogue: 0,0:20:33.95,0:20:35.75,Main,Tony,0,0,0,,Con bé đã nói thẳng vào mặt cậu ấy như thế đấy.
Dialogue: 0,0:20:35.75,0:20:38.18,Main,Kainas,0,0,0,,Giờ nhắc lại chuyện đó có ích gì đâu chứ.
Dialogue: 0,0:20:38.18,0:20:40.88,Italics,Akira,0,0,0,,Ồ? Không ngờ anh ta cũng có điểm yếu mềm lòng đáng yêu như thế.
Dialogue: 0,0:20:40.88,0:20:42.03,Main,Akira,0,0,0,,Về chuyện đó...
Dialogue: 0,0:20:42.54,0:20:44.00,Main,Akira,0,0,0,,Tôi thực sự xin lỗi hai người nhé.
Dialogue: 0,0:20:45.57,0:20:47.97,Main,Tony,0,0,0,,Tôi không hề nghĩ là cậu lại xin lỗi đâu đấy.
Dialogue: 0,0:20:47.97,0:20:51.00,Main,Akira,0,0,0,,Thì là, dù đó không phải lỗi của tôi,
Dialogue: 0,0:20:51.00,0:20:54.40,Main,Akira,0,0,0,,nhưng tôi vẫn thấy áy náy trước chuyện của cô con gái nhỏ.
Dialogue: 0,0:20:55.49,0:21:00.03,Main,Tony,0,0,0,,Cậu trông không giống với những gì tôi từng mường tượng chút nào.
Dialogue: 0,0:21:01.53,0:21:04.49,Main,Tony,0,0,0,,Ngay cả một nhà chiến thuật lão luyện cũng sẽ gặp muôn vàn khó khăn
Dialogue: 0,0:21:04.79,0:21:07.22,Main,Tony,0,0,0,,khi thực thi kế hoạch chuẩn xác đến từng milimet như cậu vừa làm.
Dialogue: 0,0:21:07.67,0:21:13.16,Main,Tony,0,0,0,,Vì thế tôi cứ ngỡ cậu phải là một kẻ... tàn nhẫn và lạnh lùng hơn cơ.
Dialogue: 0,0:21:13.86,0:21:17.12,Italics,Akira,0,0,0,,Có lẽ điều đó cũng không hẳn là sai đâu.
Dialogue: 0,0:21:19.22,0:21:23.45,Italics,Akira,0,0,0,,Nếu tôi cứ tiếp tục đà đó, rất có thể tôi đã tự nhấn chìm mình vào bóng tối rồi.
Dialogue: 0,0:21:24.07,0:21:27.01,Italics,Akira,0,0,0,,Lần này mình thực sự mang ơn Karen rất nhiều.
Dialogue: 0,0:21:27.34,0:21:29.12,Main,Akira,0,0,0,,Tôi đã lắng nghe lời đề nghị của hai người rồi.
Dialogue: 0,0:21:29.12,0:21:32.52,Main,Akira,0,0,0,,Vậy chúng ta hãy thử nghiệm bằng việc để anh ấy hộ tống Echigoya vào thành phố nhé.
Dialogue: 0,0:21:33.01,0:21:36.43,Main,Tony,0,0,0,,Tuyệt quá! Tôi mừng vì cậu đã đồng ý!
Dialogue: 0,0:21:37.35,0:21:40.89,Italics,Akira,0,0,0,,Tôi cũng đang tính hàn gắn lại mối quan hệ với phía con người.
Dialogue: 0,0:21:40.89,0:21:42.37,Italics,Akira,0,0,0,,Đây đúng là một lời đề nghị kịp thời.
Dialogue: 0,0:23:14.36,0:23:18.11,Main,goblin H/I/J,0,0,0,,Thôn trưởng ơi! Đừng qua bên này!
Dialogue: 0,0:23:18.11,0:23:19.69,Italics,Akira,0,0,0,,Chắc chắn đã có chuyện gì xảy ra rồi.
Dialogue: 0,0:23:19.69,0:23:23.25,Main,Akira,0,0,0,,Ở đó thực sự không có gì sao? Đừng làm mấy trò nguy hiểm đấy nhé.
Dialogue: 0,0:23:23.25,0:23:25.22,Main,goblin J,0,0,0,,Bọn em xin lỗi ạ!
Dialogue: 0,0:23:25.22,0:23:27.42,Main,goblin I,0,0,0,,Bọn em tưởng Thôn trưởng sẽ nổi giận cơ.
Dialogue: 0,0:23:27.67,0:23:30.70,Main,goblin I,0,0,0,,Có một bé tí hon đáng thương đang ngã gục ở đằng kia kìa!
Dialogue: 0,0:23:30.70,0:23:32.33,Main,Akira,0,0,0,,Có ai đó bị thương sao?!
Dialogue: 0,0:23:32.80,0:23:34.35,Main,goblin H,0,0,0,,Chính là bé đó đấy ạ.
Dialogue: 0,0:23:35.24,0:23:36.46,Main,Akira,0,0,0,,Đó là...
Dialogue: 0,0:23:37.42,0:23:38.71,Main,Akira,0,0,0,,một con rồng sao?

