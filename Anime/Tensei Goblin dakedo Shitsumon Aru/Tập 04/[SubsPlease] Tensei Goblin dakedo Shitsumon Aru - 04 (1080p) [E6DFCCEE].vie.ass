Dialogue: 0,0:00:07.87,0:00:10.51,Italics,Akira,0,0,0,,Cái gì thế này, quyến rũ mỹ nhân kế đấy à?!
Dialogue: 0,0:00:10.51,0:00:13.07,Italics,Akira,0,0,0,,Không, làm sao mà có chuyện đó được chứ!
Dialogue: 0,0:00:35.43,0:00:36.55,Sign_Basic,text,0,0,0,,DỆT SỢI TƠ
Dialogue: 0,0:00:41.93,0:00:43.37,Main,Karen,0,0,0,,Tại sao lại không?
Dialogue: 0,0:00:43.37,0:00:45.68,Main,Akira,0,0,0,,Rõ ràng là chuyện này quá gượng gạo và khó xử đối với cô mà.
Dialogue: 0,0:00:47.10,0:00:50.74,Main,Akira,0,0,0,,Hơn nữa, cô không thể dùng mỹ nhân kế để mê hoặc một con goblin được đâu.
Dialogue: 0,0:00:51.14,0:00:52.59,Main,Karen,0,0,0,,Không được thật sao?!
Dialogue: 0,0:00:52.98,0:00:56.19,Main,Akira,0,0,0,,Cô cảm thấy thế nào khi nhìn thấy những người như Hanzo hay Echigoya?
Dialogue: 0,0:00:58.36,0:01:01.78,Main,Akira,0,0,0,,Goblin thuần chủng hoàn toàn không hề có ham muốn tình dục với con người đâu.
Dialogue: 0,0:01:02.52,0:01:03.89,Main,Karen,0,0,0,,Ra là vậy...
Dialogue: 0,0:01:06.62,0:01:09.27,Main,Karen,0,0,0,,Xin lỗi nhé, hãy quên hết chuyện vừa rồi đi.
Dialogue: 0,0:01:14.70,0:01:18.02,Italics,Akira,0,0,0,,Cái thứ siêu dâm dục của goblin chết tiệt trong truyền thuyết đúng là lừa đảo mà!
Dialogue: 0,0:01:26.17,0:01:30.27,Italics,Akira,0,0,0,,Dù vậy, lý do vì sao Karen lại hành động kỳ quặc như thế,
Dialogue: 0,0:01:30.81,0:01:32.87,Italics,Akira,0,0,0,,mình thà không nghĩ tới thì hơn.
Dialogue: 0,0:01:34.99,0:01:45.08,Sign_Basic,title,0,0,0,,CHUYỂN SINH THÀNH GOBLIN\NTHÌ CÓ GÌ SAI SAO?
Dialogue: 0,0:03:05.68,0:03:07.44,Main,goblin 41,0,0,0,,Ơ kìa, cô Karen.
Dialogue: 0,0:03:07.44,0:03:09.88,Main,goblin 42,0,0,0,,Có chuyện gì thế nhỉ? Cô ấy còn chẳng buồn mặc quần áo kìa.
Dialogue: 0,0:03:12.10,0:03:14.26,Main,goblin 43,0,0,0,,Là cô Karen đấy phải không?
Dialogue: 0,0:03:14.92,0:03:20.97,Sign_Basic,text,0,0,0,,{\pos(606,308)\an3}TẬP 4: TRỞ THÀNH MỤC TIÊU ÁM SÁT THÌ ĐÃ LÀM SAO?
Dialogue: 0,0:03:14.91,0:03:17.29,Main - Top,goblin 43,0,0,0,,Ngọn gió nào đưa cô cất công tới tận đây thế?
Dialogue: 0,0:03:17.29,0:03:18.96,Main - Top,Karen,0,0,0,,À... ừm thì...
Dialogue: 0,0:03:18.96,0:03:20.75,Main - Top,goblin 43,0,0,0,,Quần áo của cô đâu hết cả rồi?
Dialogue: 0,0:03:22.04,0:03:23.83,Main,Karen,0,0,0,,Chuyện là, tôi chỉ...
Dialogue: 0,0:03:24.94,0:03:27.22,Main,goblin 43,0,0,0,,Tôi hiểu rồi! Đến giờ giặt đồ rồi chứ gì!
Dialogue: 0,0:03:27.22,0:03:31.14,Main,goblin 43,0,0,0,,Để tôi đi nhờ Echigoya may cho cô vài bộ quần áo mới nhé!
Dialogue: 0,0:03:31.42,0:03:33.99,Italics,Karen,0,0,0,,Cậu ta thực sự chẳng có chút phản ứng nào khi thấy mình gần như khỏa thân cả.
Dialogue: 0,0:03:33.99,0:03:36.27,Italics,Karen,0,0,0,,Mình đã chẳng phải rơi vào cái tình cảnh đáng xấu hổ này
Dialogue: 0,0:03:36.27,0:03:37.95,Italics,Karen,0,0,0,,nếu như không răm rắp làm theo kế hoạch của ngài Hầu tước.
Dialogue: 0,0:03:38.70,0:03:41.28,Flashback,Simon,0,0,0,,Cứ quyến rũ cậu ta là mọi chuyện sẽ dễ như trở bàn tay.
Dialogue: 0,0:03:41.28,0:03:43.99,Italics,Karen,0,0,0,,Không! Mình chỉ nên tự trách bản thân đã quá ngây thơ,
Dialogue: 0,0:03:43.99,0:03:47.25,Italics,Karen,0,0,0,,không chịu tìm hiểu kỹ sự khác biệt sinh học giữa loài goblin và con người!
Dialogue: 0,0:03:47.25,0:03:49.96,Italics,Karen,0,0,0,,Đổ lỗi cho ngài Hầu tước đúng là hành vi hèn hạ đáng xấu hổ!
Dialogue: 0,0:03:52.35,0:03:55.16,Italics,Karen,0,0,0,,Nhưng không chỉ có vậy...
Dialogue: 0,0:03:55.16,0:03:57.79,Italics,Karen,0,0,0,,Mình thực sự không thể nào nhẫn tâm xuống tay giết chết cậu ấy được.
Dialogue: 0,0:03:57.79,0:04:00.18,Main,spy,0,0,0,,Từ đây cứ để tôi tiếp quản.
Dialogue: 0,0:04:11.55,0:04:14.43,Main,goblin 43,0,0,0,,Không biết cô Karen có ổn không nhỉ.
Dialogue: 0,0:04:26.48,0:04:27.43,Main,Akira,0,0,0,,Chạy mau!
Dialogue: 0,0:04:28.87,0:04:30.65,Main,Akira,0,0,0,,Kẻ nào ở đó?! Mau lộ mặt ra!
Dialogue: 0,0:04:32.94,0:04:34.46,Main,Akira,0,0,0,,Đã muốn thế thì đừng trách!
Dialogue: 0,0:04:34.62,0:04:35.00,Sign_Basic,text,0,0,0,,CHỚP NHÁNG
Dialogue: 0,0:04:40.61,0:04:41.47,Main,Akira,0,0,0,,Karen!
Dialogue: 0,0:04:47.18,0:04:47.68,Sign_Basic,text,0,0,0,,MANH LỰC
Dialogue: 0,0:04:50.06,0:04:51.24,Main,Akira,0,0,0,,Cô có sao không?!
Dialogue: 0,0:04:57.44,0:04:58.77,Main,spy,0,0,0,,Tóm được mày rồi.
Dialogue: 0,0:05:02.86,0:05:03.36,Sign_Basic,text,0,0,0,,PHÂN THÂN BÓNG TỐI
Dialogue: 0,0:05:14.48,0:05:15.74,Main,Akira,0,0,0,,Thứ này là cái gì?!
Dialogue: 0,0:05:21.63,0:05:27.27,Main,Akira,0,0,0,,Cảm giác tử khí nồng nặc và cái chết cận kề này... rốt cuộc là sao?!
Dialogue: 0,0:05:28.00,0:05:31.43,Main,Karen,0,0,0,,Đó là Goblin Slayer.
Dialogue: 0,0:05:31.95,0:05:35.11,Main,Karen,0,0,0,,Một thứ vũ khí được chế tạo ra với mục đích duy nhất là tàn sát loài goblin.
Dialogue: 0,0:05:35.11,0:05:38.88,Main,Karen,0,0,0,,Chỉ cần một vết xước nhỏ thôi cũng đủ khiến bất kỳ con goblin nào mất mạng ngay lập tức.
Dialogue: 0,0:05:47.94,0:05:51.37,Main,Akira,0,0,0,,Không ngờ là Simon vẫn luôn cảm thấy bị đe dọa bởi mình bất kể thế nào đi nữa.
Dialogue: 0,0:05:51.94,0:05:53.53,Main,Karen,0,0,0,,Cậu biết chuyện đó từ trước rồi sao?
Dialogue: 0,0:05:53.53,0:05:55.13,Main,Akira,0,0,0,,Tôi cũng lờ mờ đoán được phần nào rồi.
Dialogue: 0,0:05:55.86,0:05:58.71,Main,Akira,0,0,0,,Dù sao thì ông già đó cũng là một kẻ lão luyện lọc lõi mà.
Dialogue: 0,0:05:58.71,0:06:02.12,Main,Akira,0,0,0,,Chẳng có gì đáng ngạc nhiên nếu ông ta toan tính điều gì đó đằng sau nụ cười niềm nở kia.
Dialogue: 0,0:06:02.78,0:06:04.14,Main,Karen,0,0,0,,Cậu không tức giận sao?
Dialogue: 0,0:06:04.51,0:06:06.25,Main,Akira,0,0,0,,Ông già đó là một chính trị gia.
Dialogue: 0,0:06:06.58,0:06:11.13,Main,Akira,0,0,0,,Sẽ là một sai lầm chết người nếu ông ta {\i1}không{\i0} đề phòng một kẻ ngoại lai đầy sức mạnh như tôi.
Dialogue: 0,0:06:11.13,0:06:13.13,Main,Akira,0,0,0,,Và điều đó hoàn toàn bình thường.
Dialogue: 0,0:06:13.42,0:06:17.05,Main,Akira,0,0,0,,Điều tôi không hiểu là tại sao ông ta lại phải làm chuyện này theo cách vòng vo đến thế.
Dialogue: 0,0:06:17.05,0:06:19.25,Main,Akira,0,0,0,,Nếu là tôi mà coi thứ gì đó là mối đe dọa,
Dialogue: 0,0:06:19.25,0:06:21.69,Main,Akira,0,0,0,,tôi sẽ phái ngay một đội quân viễn chinh tới tiêu diệt tận gốc cho xong chuyện.
Dialogue: 0,0:06:21.69,0:06:27.04,Main,Karen,0,0,0,,Đúng thật. Giờ cậu nhắc tôi mới để ý, từ trước tới giờ ngài ấy luôn hành động rất gián tiếp.
Dialogue: 0,0:06:27.04,0:06:29.61,Main,Karen,0,0,0,,Ngài ấy báo cáo lên cấp trên rằng mọi chuyện vẫn hoàn toàn êm đẹp,
Dialogue: 0,0:06:29.61,0:06:31.99,Main,Karen,0,0,0,,trong khi lại âm thầm tính toán những phương án để đối phó với cậu.
Dialogue: 0,0:06:31.99,0:06:33.60,Main,Akira,0,0,0,,Thật thế sao?
Dialogue: 0,0:06:33.60,0:06:35.65,Main,Akira,0,0,0,,Như vậy thì lại càng kỳ lạ hơn nữa.
Dialogue: 0,0:06:35.88,0:06:38.57,Main,Karen,0,0,0,,Đó hoàn toàn không phải là phương thức thông thường được áp dụng đối với một kẻ thù là Quái vật.
Dialogue: 0,0:06:39.08,0:06:41.18,Main,Akira,0,0,0,,Có lẽ tôi phải đích thân tới hỏi thẳng mặt ông ta mới được.
Dialogue: 0,0:06:45.50,0:06:47.17,Main,Simon,0,0,0,,Ngươi đã thất bại rồi sao?
Dialogue: 0,0:06:47.43,0:06:49.35,Main,Karen,0,0,0,,Mỹ nhân kế hoàn toàn không có tác dụng ạ.
Dialogue: 0,0:06:49.35,0:06:51.40,Italics,Akira,0,0,0,,Cô ấy nghe có vẻ cay cú phết nhỉ.
Dialogue: 0,0:06:51.75,0:06:55.94,Main,Simon,0,0,0,,Vậy thì, cậu tới đây là để lấy mạng ta sao?
Dialogue: 0,0:06:56.60,0:06:58.51,Main,Akira,0,0,0,,Tôi tới đây để lắng nghe ngài giải thích ngọn ngành.
Dialogue: 0,0:06:58.51,0:06:59.88,Main,Simon,0,0,0,,Ồ?
Dialogue: 0,0:07:00.17,0:07:03.11,Main,Akira,0,0,0,,Tại sao ngài lại phải hành xử vòng vo tam quốc đến mức này chứ?
Dialogue: 0,0:07:05.86,0:07:11.43,Main,Simon,0,0,0,,Chủng loài goblin... bản chất của chúng là tự biến đổi để thích nghi với môi trường sống.
Dialogue: 0,0:07:11.94,0:07:15.11,Main,Simon,0,0,0,,Nếu sống ở nơi khô hạn, chúng sẽ có khả năng chịu hạn phi thường.
Dialogue: 0,0:07:15.11,0:07:18.25,Main,Simon,0,0,0,,Nếu sống ở nơi băng giá, chúng sẽ có khả năng chống chọi cực tốt với cái lạnh.
Dialogue: 0,0:07:18.25,0:07:20.53,Main,Simon,0,0,0,,Ngay cả khi môi trường đột ngột biến đổi khắc nghiệt,
Dialogue: 0,0:07:20.53,0:07:22.55,Main,Simon,0,0,0,,các cậu cũng có thể thích nghi hoàn toàn chỉ trong vòng vài thế hệ ngắn ngủi.
Dialogue: 0,0:07:22.55,0:07:29.33,Main,Simon,0,0,0,,Năm mươi năm trước, đã từng xảy ra một sự kiện xóa sổ tới 99% loài goblin trên toàn thế giới.
Dialogue: 0,0:07:29.33,0:07:33.22,Main,Simon,0,0,0,,Theo quan điểm của ta, nguyên nhân dẫn tới thảm họa đó vốn bắt nguồn từ một chuyện vô cùng tầm thường.
Dialogue: 0,0:07:33.22,0:07:37.64,Main,Simon,0,0,0,,Đó là thời kỳ mà con người tiến hành tàn sát hàng loạt loài goblin trên quy mô lớn.
Dialogue: 0,0:07:37.91,0:07:39.56,Main,Simon,0,0,0,,Cậu có đoán được chuyện gì đã xảy ra sau đó không?
Dialogue: 0,0:07:39.56,0:07:43.10,Main,Akira,0,0,0,,Những con goblin còn sót lại đã tiến hóa vượt bậc để sinh tồn sao?
Dialogue: 0,0:07:43.59,0:07:44.55,Main,Simon,0,0,0,,Chính xác.
Dialogue: 0,0:07:46.60,0:07:48.11,Main,Simon,0,0,0,,Kẻ Sống Sót Cuối Cùng (Last One).
Dialogue: 0,0:07:48.50,0:07:54.20,Main,Simon,0,0,0,,Cá thể goblin duy nhất còn sống sót khi ấy đã thức tỉnh ba kỹ năng hoàn toàn mới.
Dialogue: 0,0:07:54.74,0:07:57.34,Main,Simon,0,0,0,,Thứ nhất chính là sự bất tử.
Dialogue: 0,0:07:57.34,0:08:00.41,Main,Simon,0,0,0,,Bất kể bị tấn công tàn khốc đến mức nào, nó cũng tuyệt đối không chết.
Dialogue: 0,0:08:01.20,0:08:04.32,Main,Simon,0,0,0,,Thứ hai chính là khả năng trinh sản (sinh sản đơn tính).
Dialogue: 0,0:08:04.32,0:08:08.58,Main,Simon,0,0,0,,Nó đã tự mình sinh ra hàng trăm cá thể goblin khác, đổi lại bằng chính sinh mệnh của mình.
Dialogue: 0,0:08:09.09,0:08:12.00,Main,Simon,0,0,0,,Và nhờ đó, nó trở thành thủy tổ của toàn bộ loài goblin ngày nay.
Dialogue: 0,0:08:12.24,0:08:13.67,Main,Simon,0,0,0,,Và thứ ba...
Dialogue: 0,0:08:14.28,0:08:18.09,Main,Simon,0,0,0,,Nó có thể sử dụng toàn bộ mọi kỹ năng mà chủng tộc goblin từng sở hữu từ trước tới nay.
Dialogue: 0,0:08:19.53,0:08:23.34,Main,Simon,0,0,0,,Cá thể Last One đó đã tàn sát hàng vạn con người.
Dialogue: 0,0:08:23.34,0:08:26.71,Main,Simon,0,0,0,,Dù ký ức kinh hoàng đó giờ đây đang dần phai nhạt theo thời gian,
Dialogue: 0,0:08:26.71,0:08:29.34,Main,Simon,0,0,0,,nhưng con người chúng ta đã hình thành thói quen phải lên kế hoạch tỉ mỉ đến từng chi tiết
Dialogue: 0,0:08:29.34,0:08:32.25,Main,Simon,0,0,0,,mỗi khi có ý định tiêu diệt toàn bộ một bộ tộc goblin.
Dialogue: 0,0:08:32.71,0:08:34.22,Main,Akira,0,0,0,,Giờ thì tôi đã hiểu rồi.
Dialogue: 0,0:08:34.22,0:08:38.04,Main,Akira,0,0,0,,Nếu ngài tấn công cả ngôi làng chỉ để lấy mạng một mình tôi,
Dialogue: 0,0:08:38.04,0:08:41.66,Main,Akira,0,0,0,,thì chẳng ai có thể lường trước được tôi sẽ tiến hóa thành cái giống loài khủng khiếp nào.
Dialogue: 0,0:08:42.28,0:08:43.73,Main,Simon,0,0,0,,Đúng là như vậy.
Dialogue: 0,0:08:43.73,0:08:47.80,Main,Simon,0,0,0,,Một cá thể goblin đặc biệt như cậu đương nhiên sẽ khiến chúng ta phải hết sức dè chừng.
Dialogue: 0,0:08:48.69,0:08:51.61,Main,Simon,0,0,0,,Cậu từng nói rằng cậu luôn quan sát và học hỏi từ những sai lầm.
Dialogue: 0,0:08:52.05,0:08:55.92,Main,Simon,0,0,0,,Việc không lặp lại những sai lầm cũ quả thực rất quan trọng,
Dialogue: 0,0:08:55.92,0:08:59.26,Main,Simon,0,0,0,,nhưng luôn có nguy cơ người ta sẽ mắc phải những loại sai lầm hoàn toàn mới.
Dialogue: 0,0:08:59.26,0:09:01.44,Main,Akira,0,0,0,,Vâng, điều đó hoàn toàn chính xác.
Dialogue: 0,0:09:03.30,0:09:05.64,Main,Simon,0,0,0,,Trông cậu có vẻ rất thản nhiên về chuyện đó nhỉ.
Dialogue: 0,0:09:06.01,0:09:08.56,Main,Akira,0,0,0,,Sai lầm không phải là dấu chấm hết cho con đường.
Dialogue: 0,0:09:08.56,0:09:10.94,Main,Akira,0,0,0,,Luôn có một con đường thẳng tắp dẫn tới thành công.
Dialogue: 0,0:09:10.94,0:09:12.14,Main,Akira,0,0,0,,Nếu mắc phải sai lầm,
Dialogue: 0,0:09:12.14,0:09:15.08,Main,Akira,0,0,0,,người ta chỉ việc chú ý để không giẫm phải vết xe đổ đó khi tiếp tục tiến bước,
Dialogue: 0,0:09:15.40,0:09:18.39,Main,Akira,0,0,0,,và tôi tin rằng rồi một ngày nào đó, ta sẽ chạm tay tới thành công.
Dialogue: 0,0:09:22.50,0:09:25.06,Main,Simon,0,0,0,,Cậu nói làm ta không thể cãi lại được câu nào.
Dialogue: 0,0:09:25.06,0:09:28.91,Main,Simon,0,0,0,,Một người đồng chí đang dạy cho ta bài học về những giá trị của con người.
Dialogue: 0,0:09:29.18,0:09:30.58,Main,Simon,0,0,0,,Ta chẳng nên lấy làm ngạc nhiên mới phải.
Dialogue: 0,0:09:31.33,0:09:33.62,Main,Akira,0,0,0,,Tôi đâu dám nhận nhiều lời khen ngợi đến thế.
Dialogue: 0,0:09:34.24,0:09:37.68,Main,Akira,0,0,0,,Vậy thì, trong trường hợp này chúng ta nên làm gì đây?
Dialogue: 0,0:09:37.68,0:09:39.61,Main,Akira,0,0,0,,Chuyện đó đơn giản thôi mà.
Dialogue: 0,0:09:41.52,0:09:44.43,Main,Akira,0,0,0,,Tôi chỉ cần chứng minh giá trị của mình lớn hơn nhiều so với bất kỳ mối đe dọa nào.
Dialogue: 0,0:09:44.43,0:09:46.22,Main,Simon,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:09:46.49,0:09:50.69,Main,Akira,0,0,0,,Nói toạc móng heo ra, chẳng phải ngài tìm cách ám sát tôi chỉ vì nỗi sợ hãi hay sao?
Dialogue: 0,0:09:50.69,0:09:56.06,Main,Simon,0,0,0,,Phải, mặc dù về phương diện cá nhân, ta vẫn luôn coi cậu là một người đáng tin cậy.
Dialogue: 0,0:09:56.90,0:10:01.33,Main,Karen,0,0,0,,Thưa Hầu tước, điều gì khiến ngài nghĩ rằng có thể tin tưởng được Akira chứ?
Dialogue: 0,0:10:02.78,0:10:04.99,Italics,Akira,0,0,0,,Chuyện đó không thể nói cho cô ấy biết được đâu!
Dialogue: 0,0:10:02.78,0:10:04.99,Italics - Top,Simon,0,0,0,,Chuyện đó tuyệt đối không thể nói cho con bé biết được!
Dialogue: 0,0:10:04.99,0:10:07.74,Main,Simon,0,0,0,,Đó là bí mật riêng giữa những người đàn ông với nhau.
Dialogue: 0,0:10:09.67,0:10:14.37,Main,Simon,0,0,0,,Nhưng những gì được lòng ta thì chưa chắc đã vừa mắt các quý tộc, quan chức khác,
Dialogue: 0,0:10:14.37,0:10:16.60,Main,Simon,0,0,0,,hay thậm chí là đức vua.
Dialogue: 0,0:10:16.60,0:10:18.35,Main,Akira,0,0,0,,À thì, điều đó cũng đúng thật.
Dialogue: 0,0:10:18.63,0:10:23.43,Main,Akira,0,0,0,,Nhân tiện thì Simon này, những kẻ nắm giữ quyền lực có khao khát sự bất tử không?
Dialogue: 0,0:10:23.43,0:10:24.57,Main,Simon,0,0,0,,Hửm?
Dialogue: 0,0:10:24.57,0:10:27.14,Main,Simon,0,0,0,,Đương nhiên rồi, có rất nhiều kẻ khao khát điều đó.
Dialogue: 0,0:10:27.32,0:10:29.22,Main,Akira,0,0,0,,Tôi cũng đoán chừng như vậy.
Dialogue: 0,0:10:29.22,0:10:34.95,Main,Simon,0,0,0,,Cái gì? Đừng nói là cậu định đi lừa đảo bán thuốc trường sinh bất lão đấy nhé.
Dialogue: 0,0:10:34.95,0:10:37.02,Main,Akira,0,0,0,,Tôi đâu có điên mà làm cái trò đó.
Dialogue: 0,0:10:39.24,0:10:40.72,Main,Simon,0,0,0,,Vậy cậu đang mưu tính điều gì trong đầu?
Dialogue: 0,0:10:43.95,0:10:45.00,Main,Akira,0,0,0,,Xin lỗi mày nhé!
Dialogue: 0,0:10:49.12,0:10:50.33,Sign_Basic,text,0,0,0,,BĂNG CHÂM
Dialogue: 0,0:10:49.11,0:10:50.34,Main,Karen,0,0,0,,Akira!
Dialogue: 0,0:10:53.96,0:10:54.92,Sign_Basic,text,0,0,0,,ĐẠI TRỊ LIỆU
Dialogue: 0,0:11:00.81,0:11:02.46,Main,Karen,0,0,0,,Cái quái gì...
Dialogue: 0,0:11:02.46,0:11:04.28,Main,Akira,0,0,0,,Đại Trị Liệu (Great Heal).
Dialogue: 0,0:11:04.28,0:11:08.51,Main,Akira,0,0,0,,Tôi nghĩ nó có thể chữa lành mọi vết thương, miễn là đối tượng vẫn còn đang thở.
Dialogue: 0,0:11:08.51,0:11:10.44,Main,Simon,0,0,0,,Thật không thể tin nổi.
Dialogue: 0,0:11:12.10,0:11:14.59,Main,Akira,0,0,0,,Tao thực sự xin lỗi mày nhé, chú chim chích nhỏ bé!
Dialogue: 0,0:11:14.59,0:11:17.05,Main,Karen,0,0,0,,Đương nhiên là nó nổi giận rồi. Tự đi mà dỗ dành nó đi.
Dialogue: 0,0:11:21.13,0:11:23.69,Main,Simon,0,0,0,,Quả thực điều này mang lại giá trị vô cùng to lớn.
Dialogue: 0,0:11:24.00,0:11:25.08,Main,Akira,0,0,0,,Đúng không nào?
Dialogue: 0,0:11:25.83,0:11:30.54,Main,Akira,0,0,0,,Nếu chúng ta hòa thuận hợp tác, tôi sẽ là chiếc phao cứu sinh đắt giá nhất khi ngài cần tới.
Dialogue: 0,0:11:30.54,0:11:34.80,Main,Simon,0,0,0,,Dù một con goblin đơn độc có đáng sợ đến mức nào đi chăng nữa,
Dialogue: 0,0:11:34.80,0:11:37.97,Main,Simon,0,0,0,,thì sự lộng hành của nó cũng khó lòng mà đụng tới giới hoàng gia và quý tộc.
Dialogue: 0,0:11:38.31,0:11:43.26,Main,Simon,0,0,0,,Năng lực chữa lành mọi thương tổn này dư sức tạo ra giá trị áp đảo mọi mối đe dọa.
Dialogue: 0,0:11:44.08,0:11:45.96,Main,Simon,0,0,0,,Cứ để việc này cho ta lo liệu.
Dialogue: 0,0:11:48.94,0:11:51.28,Main,Simon,0,0,0,,Ta xin lỗi nhé, Karen.
Dialogue: 0,0:11:51.28,0:11:52.14,Main,Karen,0,0,0,,Thưa Hầu tước?
Dialogue: 0,0:11:52.41,0:11:55.81,Main,Simon,0,0,0,,Ta không cố ý để con phải chịu tổn thương đâu.
Dialogue: 0,0:11:55.81,0:11:59.75,Main,Karen,0,0,0,,Con hiểu những suy tính của ngài mà.
Dialogue: 0,0:11:59.75,0:12:03.06,Main,Karen,0,0,0,,Nhưng xin ngài hãy nói thật cho con biết, ngài thực sự định bắt tay theo kế hoạch của Akira sao?
Dialogue: 0,0:12:03.43,0:12:05.72,Main,Simon,0,0,0,,Cậu ta trên thực tế chẳng khác nào một con người cả.
Dialogue: 0,0:12:05.72,0:12:08.89,Main,Simon,0,0,0,,Sở hữu sức mạnh của loài goblin, nhưng lại có tuổi thọ và trí tuệ của con người.
Dialogue: 0,0:12:08.89,0:12:12.33,Main,Simon,0,0,0,,Thêm vào đó, cậu ta thậm chí còn nắm giữ kỹ năng của Đại Ma Vương.
Dialogue: 0,0:12:12.70,0:12:17.85,Main,Simon,0,0,0,,Nhưng... ta nghĩ mình sẽ đặt trọn niềm tin vào trái tim con người của cậu ta.
Dialogue: 0,0:12:18.47,0:12:19.38,Main,Karen,0,0,0,,Vâng, thưa Hầu tước.
Dialogue: 0,0:12:21.45,0:12:24.11,Main,Akira,0,0,0,,Simon, mọi chuyện tiến triển thế nào rồi?
Dialogue: 0,0:12:24.11,0:12:28.09,Main,Simon,0,0,0,,À. Ta xin lỗi nhé, người anh em.
Dialogue: 0,0:12:28.09,0:12:30.63,Main,Akira,0,0,0,,Đừng nói là phía bên kia từ chối thẳng thừng đấy nhé.
Dialogue: 0,0:12:30.63,0:12:33.83,Main,Simon,0,0,0,,Không, cho đến lúc này thì mọi chuyện vẫn rất suôn sẻ. Chỉ có điều...
Dialogue: 0,0:12:34.77,0:12:37.12,Main,Albert,0,0,0,,Ngươi hẳn là con goblin nổi tiếng đang được bàn tán xôn xao dạo gần đây.
Dialogue: 0,0:12:37.12,0:12:37.92,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:12:39.47,0:12:41.72,Main,Akira,0,0,0,,Ủa, vị này là ai thế?
Dialogue: 0,0:12:43.28,0:12:47.95,Main,Simon,0,0,0,,Đây là Đệ Tam Hoàng Tử Albert South Windsor.
Dialogue: 0,0:12:49.31,0:12:51.78,Main,Simon,0,0,0,,Người anh hùng đã đích thân tiêu diệt Đại Ma Vương.
Dialogue: 0,0:12:58.88,0:13:00.36,Main,Akira,0,0,0,,Ngài đã tiêu diệt...
Dialogue: 0,0:13:00.72,0:13:02.17,Main,Akira,0,0,0,,Đại Ma Vương sao?
Dialogue: 0,0:13:02.66,0:13:04.10,Main,Akira,0,0,0,,Bằng cách nào chứ?
Dialogue: 0,0:13:05.85,0:13:09.48,Main,Albert,0,0,0,,Nhờ vào kỹ năng của ta, Lần Thứ Tám Sẽ May Mắn (Eighth Time's the Charm).
Dialogue: 0,0:13:07.55,0:13:09.47,Sign_Basic,text,0,0,0,,LẦN THỨ TÁM SẼ MAY MẮN
Dialogue: 0,0:13:09.48,0:13:11.29,Main,Albert,0,0,0,,Lần Thứ Tám Sẽ May Mắn...
Dialogue: 0,0:13:11.92,0:13:16.37,Italics,Albert,0,0,0,,Dựa vào cái tên, có thể đó là một năng lực cho phép làm lại sai lầm
Dialogue: 0,0:13:16.37,0:13:18.56,Italics,Albert,0,0,0,,tối đa tới bảy lần.
Dialogue: 0,0:13:18.93,0:13:22.31,Main,Albert,0,0,0,,Chắc chắn nhờ đó mà ngài ấy đã vô hiệu hóa được kỹ năng Kẻ Mạnh Sinh Tồn của Đại Ma Vương.
Dialogue: 0,0:13:22.64,0:13:27.58,Main,Albert,0,0,0,,Ngươi quả thực là một kẻ xảo quyệt và nhạy bén hơn những gì ta nghe đồn đấy.
Dialogue: 0,0:13:27.58,0:13:28.67,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:13:28.67,0:13:32.17,Main,Albert,0,0,0,,Chỉ bấy nhiêu thôi cũng đủ để ngươi phỏng đoán được bản chất kỹ năng của ta rồi, đúng chứ?
Dialogue: 0,0:13:32.17,0:13:34.75,Main,Akira,0,0,0,,À thì, tôi đoán vậy...
Dialogue: 0,0:13:35.65,0:13:37.16,Main,Albert,0,0,0,,Khởi động lại (Restart).
Dialogue: 0,0:13:40.58,0:13:42.51,Main,Akira,0,0,0,,Ngài đã tiêu diệt Đại Ma Vương sao?
Dialogue: 0,0:13:42.51,0:13:43.77,Main,Akira,0,0,0,,Bằng cách nào chứ?
Dialogue: 0,0:13:44.74,0:13:46.84,Main,Albert,0,0,0,,Đó là bí mật.
Dialogue: 0,0:13:46.84,0:13:48.75,Main,Akira,0,0,0,,Đương nhiên rồi.
Dialogue: 0,0:13:48.75,0:13:51.14,Main,Akira,0,0,0,,Nhưng nếu ngài có thể tiêu diệt được Đại Ma Vương,
Dialogue: 0,0:13:51.14,0:13:52.95,Main,Akira,0,0,0,,chắc chắn ngài phải sở hữu một năng lực nào đó
Dialogue: 0,0:13:52.95,0:13:55.18,Main,Akira,0,0,0,,giúp ngài vô hiệu hóa được kỹ năng Kẻ Mạnh Sinh Tồn.
Dialogue: 0,0:13:55.18,0:13:59.64,Main,Akira,0,0,0,,Về phần tôi, tôi rất thích có được một thứ gì đó giúp mình có thể sửa chữa sai lầm.
Dialogue: 0,0:14:00.87,0:14:03.69,Main,Albert,0,0,0,,Ngươi quả thực rất ranh mãnh đấy.
Dialogue: 0,0:14:03.69,0:14:04.64,Main,Akira,0,0,0,,Sao cơ?
Dialogue: 0,0:14:04.64,0:14:05.60,Main,Albert,0,0,0,,Tốt lắm.
Dialogue: 0,0:14:05.60,0:14:08.87,Main,Albert,0,0,0,,Như vậy cũng hay, nếu nó giúp mọi chuyện trở nên đơn giản hơn.
Dialogue: 0,0:14:09.19,0:14:11.85,Main,Albert,0,0,0,,Người ta đã đưa ra một thỉnh cầu nhờ người đã tiêu diệt Đại Ma Vương
Dialogue: 0,0:14:11.85,0:14:15.71,Main,Albert,0,0,0,,đích thân tới kiểm tra kẻ đã thừa kế kỹ năng của Đại Ma Vương.
Dialogue: 0,0:14:15.71,0:14:17.16,Main,Akira,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:14:17.16,0:14:20.63,Main,Albert,0,0,0,,Ông chú họ của ta vốn nhìn người rất chuẩn,
Dialogue: 0,0:14:20.63,0:14:22.99,Main,Albert,0,0,0,,nhưng thỉnh thoảng ông ấy lại bị xiêu lòng bởi những lý do hết sức kỳ quặc.
Dialogue: 0,0:14:22.99,0:14:24.75,Italics,Akira,0,0,0,,Nghe chuẩn xác đến mức không trượt phát nào luôn.
Dialogue: 0,0:14:24.75,0:14:26.45,Main,Simon,0,0,0,,Gì thế hả?!
Dialogue: 0,0:14:32.47,0:14:35.94,Main,Akira,0,0,0,,Vậy ra Simon, ngài là ông chú họ của Hoàng tử Albert sao?
Dialogue: 0,0:14:35.94,0:14:36.86,Main,Simon,0,0,0,,Ừm.
Dialogue: 0,0:14:36.86,0:14:39.93,Main,Albert,0,0,0,,Bởi vì ông ấy là chú ruột của Phụ hoàng ta, Đức vua.
Dialogue: 0,0:14:39.93,0:14:42.69,Main,Akira,0,0,0,,Thế chẳng khác nào ngài ấy là cháu trai của ông sao?
Dialogue: 0,0:14:42.69,0:14:43.74,Main,Simon,0,0,0,,Ừm.
Dialogue: 0,0:14:43.74,0:14:48.53,Main,Simon,0,0,0,,Bản thân Albert quả thực là một người xuất chúng, nhưng thằng bé cũng, cậu biết đấy...
Dialogue: 0,0:14:48.53,0:14:49.65,Main,Akira,0,0,0,,"Tôi biết đấy" là sao?
Dialogue: 0,0:14:49.95,0:14:53.65,Main,Simon,0,0,0,,Đường đường là một hoàng tử, vậy mà trong mắt thằng bé lúc nào cũng chỉ có mỗi vị hôn thê của mình mà thôi.
Dialogue: 0,0:14:53.65,0:14:54.62,Main,Akira,0,0,0,,Hả?
Dialogue: 0,0:14:55.37,0:14:58.82,Main,Simon,0,0,0,,Ta chẳng phản đối việc nó yêu thương quý trọng vợ mình,
Dialogue: 0,0:14:58.82,0:15:02.59,Main,Simon,0,0,0,,nhưng làm sao chúng ta có thể an tâm phó thác vương quốc cho một kẻ cả đời chỉ biết đến duy nhất một người phụ nữ chứ?!
Dialogue: 0,0:15:02.59,0:15:07.90,Main,Albert,0,0,0,,Ngươi thấy rồi đấy? Đó là lý do tại sao ta không thể tin tưởng hoàn toàn vào trực giác của ông chú họ được.
Dialogue: 0,0:15:07.90,0:15:10.55,Main,Albert,0,0,0,,Thế nên ta mới nghĩ mình cần phải đích thân tới tận nơi mục sở thị.
Dialogue: 0,0:15:10.55,0:15:11.71,Main,Akira,0,0,0,,Ra là thế.
Dialogue: 0,0:15:11.71,0:15:14.90,Main,Albert,0,0,0,,Nhân tiện, liên quan tới kỹ năng Đại Trị Liệu của ngươi.
Dialogue: 0,0:15:14.90,0:15:17.01,Main,Albert,0,0,0,,Ngươi có ý định cung cấp nó hoàn toàn miễn phí không?
Dialogue: 0,0:15:17.01,0:15:18.17,Main,Akira,0,0,0,,À, ừm thì...
Dialogue: 0,0:15:18.56,0:15:21.91,Main,Akira,0,0,0,,Tôi định đợi sau khi đưa ra quyết định cuối cùng mới tới bàn bạc kỹ hơn,
Dialogue: 0,0:15:21.91,0:15:26.11,Main,Akira,0,0,0,,nhưng tôi đang phân vân không biết nên làm từ thiện miễn phí hoàn toàn,
Dialogue: 0,0:15:26.11,0:15:28.09,Main,Akira,0,0,0,,hay là chém một mức giá cắt cổ trên trời đây?
Dialogue: 0,0:15:28.09,0:15:30.31,Main,Albert,0,0,0,,Ngươi chắc chắn nên chọn phương án thu phí cắt cổ.
Dialogue: 0,0:15:30.31,0:15:32.11,Main,Akira,0,0,0,,Tôi cũng có linh cảm như vậy.
Dialogue: 0,0:15:32.11,0:15:38.04,Main,Albert,0,0,0,,Một con Quái vật làm việc tốt không công sẽ chỉ khiến người ta càng thêm nghi kỵ và cảnh giác hơn mà thôi.
Dialogue: 0,0:15:38.33,0:15:41.01,Italics,Akira,0,0,0,,Bản thân tôi thì sẵn lòng cung cấp dịch vụ chữa trị miễn phí
Dialogue: 0,0:15:41.01,0:15:44.96,Italics,Akira,0,0,0,,nếu điều đó nâng cao giá trị của mình và ngăn chặn người ta tìm cách trừ khử tôi.
Dialogue: 0,0:15:44.96,0:15:48.41,Main,Albert,0,0,0,,Nhưng ta nghĩ việc chữa trị miễn phí cho bách tính bình dân lại là một ý kiến không tồi.
Dialogue: 0,0:15:48.41,0:15:49.64,Main,Akira,0,0,0,,Ý kiến hay đấy.
Dialogue: 0,0:15:49.64,0:15:52.75,Main,Akira,0,0,0,,Vậy thì tôi sẽ chỉ thu phí cắt cổ từ giới quý tộc giàu có mà thôi.
Dialogue: 0,0:15:52.75,0:15:55.06,Main,Albert,0,0,0,,Phải, làm như thế là ổn thỏa nhất.
Dialogue: 0,0:15:58.36,0:16:01.03,Main,Simon,0,0,0,,Thế nào? Giờ thì cháu đã tận mắt chứng kiến cậu ta rồi đấy.
Dialogue: 0,0:16:02.18,0:16:04.91,Main,Albert,0,0,0,,Cháu nghĩ mình có thể không phải là đối thủ của cậu ta.
Dialogue: 0,0:16:04.91,0:16:06.20,Main,Simon,0,0,0,,Ồ?
Dialogue: 0,0:16:06.20,0:16:09.46,Main,Albert,0,0,0,,Cái cách mà cậu ta đã tính toán sẵn về chuyện thù lao và lợi ích ấy?
Dialogue: 0,0:16:09.46,0:16:11.35,Main,Albert,0,0,0,,Cậu ta suy nghĩ chẳng khác nào một con người thực thụ cả.
Dialogue: 0,0:16:11.66,0:16:15.64,Main,Albert,0,0,0,,Nếu cháu dốc toàn lực ra chiến đấu, tỷ lệ thắng của cháu chắc chỉ rơi vào khoảng 50-50.
Dialogue: 0,0:16:18.15,0:16:19.74,Main,Simon,0,0,0,,Chà chà.
Dialogue: 0,0:16:19.74,0:16:23.20,Main,Simon,0,0,0,,Cháu chẳng có mấy cơ hội đâu, nhất là khi cậu ta vẫn đang cư xử hết sức nhã nhặn và lịch thiệp.
Dialogue: 0,0:16:23.20,0:16:26.12,Main,Albert,0,0,0,,Cháu chỉ hy vọng sinh mạng duy nhất gặp nguy hiểm sẽ là của cháu mà thôi.
Dialogue: 0,0:16:26.42,0:16:31.42,Main,Simon,0,0,0,,Cá nhân ta cũng không muốn thấy mọi chuyện trở nên tanh bành hỗn loạn đâu.
Dialogue: 0,0:16:31.72,0:16:35.59,Main,Albert,0,0,0,,Ý ông là ông thực sự có thể đặt trọn niềm tin vào con goblin đó sao?
Dialogue: 0,0:16:35.59,0:16:36.68,Main,Simon,0,0,0,,Ừm.
Dialogue: 0,0:16:39.15,0:16:41.36,Main,Albert,0,0,0,,Cháu có một đề xuất này.
Dialogue: 0,0:16:43.20,0:16:46.15,Main,Albert,0,0,0,,Tại sao chúng ta không biến cậu ta thành Đại Ma Vương tiếp theo nhỉ?
Dialogue: 0,0:16:47.49,0:16:48.92,Main,Simon,0,0,0,,Ồ hô.
Dialogue: 0,0:16:52.92,0:16:54.70,Italics,Akira,0,0,0,,Hoàng tử Albert.
Dialogue: 0,0:16:54.93,0:16:58.37,Italics,Akira,0,0,0,,Ngài ấy hoàn toàn có thể trở thành kẻ địch, tùy thuộc vào thời điểm và hoàn cảnh.
Dialogue: 0,0:16:58.37,0:16:59.70,Italics,Akira,0,0,0,,Trong trường hợp đó,
Dialogue: 0,0:16:59.70,0:17:02.79,Italics,Akira,0,0,0,,tốt hơn hết mình nên tìm hiểu cặn kẽ năng lực đã giúp ngài ấy tiêu diệt Đại Ma Vương.
Dialogue: 0,0:17:03.43,0:17:06.77,Italics,Akira,0,0,0,,Có thể đó là thứ giúp ngài ấy làm lại khi mắc sai lầm,
Dialogue: 0,0:17:06.77,0:17:09.34,Italics,Akira,0,0,0,,nhưng cũng rất có thể suy nghĩ đó lại là một cái bẫy.
Dialogue: 0,0:17:09.64,0:17:13.85,Italics,Akira,0,0,0,,Dù sao đi nữa, lựa chọn an toàn nhất lúc này có lẽ là không dùng kỹ năng Kẻ Mạnh Sinh Tồn lên ngài ấy.
Dialogue: 0,0:17:15.85,0:17:16.90,Main,Akira,0,0,0,,Chloe!
Dialogue: 0,0:17:17.30,0:17:18.59,Main,Chloe,0,0,0,,Akira!
Dialogue: 0,0:17:23.02,0:17:25.27,Main,Akira,0,0,0,,Ngọn gió nào đưa em tới tận đây thế?
Dialogue: 0,0:17:25.56,0:17:27.69,Main,Chloe,0,0,0,,Tự nhiên em cảm thấy có thứ gì đó vô cùng hoài niệm ở quanh đây.
Dialogue: 0,0:17:27.69,0:17:29.11,Main,Akira,0,0,0,,Hoài niệm sao?
Dialogue: 0,0:17:29.11,0:17:30.62,Main,Akira,0,0,0,,Không hiểu tại sao nhỉ.
Dialogue: 0,0:17:32.48,0:17:33.71,Main,Akira,0,0,0,,À này, Chloe.
Dialogue: 0,0:17:35.03,0:17:35.99,Sign_Basic,text,0,0,0,,PHÁC HỌA
Dialogue: 0,0:17:37.93,0:17:40.39,Main,Chloe,0,0,0,,Anh vẽ tranh cũng đỉnh ghê cơ đấy!
Dialogue: 0,0:17:40.39,0:17:42.43,Main,Akira,0,0,0,,Em đã từng nhìn thấy người đàn ông này bao giờ chưa?
Dialogue: 0,0:17:42.43,0:17:44.34,Main,Chloe,0,0,0,,Chưa từng ạ.
Dialogue: 0,0:17:44.34,0:17:46.68,Main,Akira,0,0,0,,Được rồi. Không sao cả.
Dialogue: 0,0:17:48.01,0:17:50.29,Italics,Akira,0,0,0,,Nếu Chloe không biết người này, thì cũng coi như hợp lý thôi.
Dialogue: 0,0:17:50.67,0:17:54.85,Italics,Akira,0,0,0,,Nếu năng lực của ngài ấy đúng là một trong những thứ mình đang nghi ngờ,
Dialogue: 0,0:17:54.85,0:17:57.12,Italics,Akira,0,0,0,,thì chẳng trách em ấy lại không nhận ra ngài ấy.
Dialogue: 0,0:17:57.12,0:17:58.34,Italics,Akira,0,0,0,,Nếu đúng như thế...
Dialogue: 0,0:17:59.02,0:18:00.63,Main,Chloe,0,0,0,,Em biết ngay mà! Họ đang ở đằng kia!
Dialogue: 0,0:18:00.63,0:18:01.77,Main,Akira,0,0,0,,Chloe?
Dialogue: 0,0:18:04.28,0:18:06.34,Main,adventurer 1,0,0,0,,Chật vật mãi mới tóm được lũ này đấy.
Dialogue: 0,0:18:10.24,0:18:11.89,Main,adventurer 2,0,0,0,,Là tàn dư của quân đội Đại Ma Vương!
Dialogue: 0,0:18:11.89,0:18:15.06,Main,Chloe,0,0,0,,Lũ người các ngươi nghĩ mình là ai hả?!
Dialogue: 0,0:18:15.42,0:18:17.20,Main,adventurer 1,0,0,0,,Chúng ta sẽ dùng chúng làm con tin.
Dialogue: 0,0:18:18.35,0:18:20.04,Main,Akira,0,0,0,,Tôi khuyên các người không nên thử làm trò đó đâu.
Dialogue: 0,0:18:20.04,0:18:22.21,Main,adventurer 1,0,0,0,,Ngọn lửa hắc ám kia...
Dialogue: 0,0:18:22.60,0:18:24.52,Main,adventurer 1,0,0,0,,Ngươi là Goblin Chúa (Goblin Lord) đấy sao?!
Dialogue: 0,0:18:24.52,0:18:27.34,Main,Akira,0,0,0,,Ngượng chín người mất! Mọi người gọi mình bằng cái danh xưng đó thật đấy à?!
Dialogue: 0,0:18:27.62,0:18:29.54,Sign_Basic,text,0,0,0,,HẮC DIỄM (NHIỆT ĐỘ THẤP)
Dialogue: 0,0:18:29.54,0:18:30.72,Main,adventurer 1,0,0,0,,Rút quân mau.
Dialogue: 0,0:18:31.01,0:18:32.63,Main,adventurer 1,0,0,0,,Rút lui ngay!
Dialogue: 0,0:18:32.63,0:18:34.79,Main,Chloe,0,0,0,,Làm tốt lắm, Akira!
Dialogue: 0,0:18:34.79,0:18:37.74,Main,Chloe,0,0,0,,Thật là sảng khoái khi thấy anh thiêu rụi bọn chúng trong chớp mắt như thế!
Dialogue: 0,0:18:37.74,0:18:39.58,Main,Akira,0,0,0,,Đâu có, tôi đã giết ai đâu nào.
Dialogue: 0,0:18:41.27,0:18:43.68,Main,Akira,0,0,0,,Nhưng tại sao bọn họ lại tấn công những người này nhỉ?
Dialogue: 0,0:18:46.24,0:18:47.44,Main,Chloe,0,0,0,,Eirene.
Dialogue: 0,0:18:47.67,0:18:48.86,Main,Chloe,0,0,0,,Diké.
Dialogue: 0,0:18:49.00,0:18:50.26,Main,Chloe,0,0,0,,Eunomia.
Dialogue: 0,0:18:50.91,0:18:52.57,Main,Chloe,0,0,0,,Họ tình cờ lại là những người bạn thân của em đấy.
Dialogue: 0,0:18:58.30,0:18:59.82,Main,Diké,0,0,0,,Tôi... đang ở đâu thế này?
Dialogue: 0,0:19:00.70,0:19:02.37,Main,Akira,0,0,0,,Này! Masamune!
Dialogue: 0,0:19:02.37,0:19:04.45,Main,Masamune IV,0,0,0,,Có chuyện gì thế, Thị trưởng?
Dialogue: 0,0:19:04.83,0:19:09.78,Italics,Akira,0,0,0,,Masamune Đệ Tứ. Trưởng nhóm đầu bếp sở hữu kỹ năng nấu nướng thượng thừa.
Dialogue: 0,0:19:09.78,0:19:12.13,Main,Akira,0,0,0,,Cậu có thể nấu chút đồ ăn tẩm bổ cho người ốm được không?
Dialogue: 0,0:19:12.13,0:19:13.84,Main,Masamune IV,0,0,0,,Dễ như trở bàn tay ạ!
Dialogue: 0,0:19:13.84,0:19:15.70,Main,Chloe,0,0,0,,Em cũng sẽ giúp một tay!
Dialogue: 0,0:19:22.84,0:19:25.55,Main,Diké,0,0,0,,Cảm ơn vì đã cứu chúng tôi.
Dialogue: 0,0:19:25.55,0:19:27.96,Main,Akira,0,0,0,,Kìa, cô không cần phải cảm ơn tôi đâu.
Dialogue: 0,0:19:27.96,0:19:29.59,Main,Akira,0,0,0,,Tôi nhớ hình như tên cô là...
Dialogue: 0,0:19:29.87,0:19:31.02,Main,Diké,0,0,0,,Tôi là Diké.
Dialogue: 0,0:19:31.02,0:19:32.68,Main,Akira,0,0,0,,Tôi là Akira.
Dialogue: 0,0:19:32.68,0:19:34.61,Main,Diké,0,0,0,,Vâng, thưa Akira đại nhân.
Dialogue: 0,0:19:34.61,0:19:36.98,Main,Akira,0,0,0,,Cô không cần phải gọi tôi bằng kính ngữ như thế đâu.
Dialogue: 0,0:19:36.98,0:19:41.17,Main,Diké,0,0,0,,Nếu Chloe tự nguyện ở lại nơi này,
Dialogue: 0,0:19:41.17,0:19:44.29,Main,Diké,0,0,0,,điều đó có nghĩa ngài chính là người kế vị của Đại Ma Vương tôn kính.
Dialogue: 0,0:19:44.29,0:19:47.15,Main,Akira,0,0,0,,Thực ra thứ tôi thừa kế chỉ là kỹ năng của ngài ấy mà thôi.
Dialogue: 0,0:19:47.15,0:19:53.60,Main,Diké,0,0,0,,Thưa Akira đại nhân, xin ngài hãy hạ lệnh cho hai người chị em của tôi tiếp tục sống đi ạ.
Dialogue: 0,0:19:54.07,0:19:56.30,Main,Diké,0,0,0,,Tộc elf chúng tôi sở hữu sự trường thọ và tuổi trẻ vĩnh cửu.
Dialogue: 0,0:19:56.30,0:19:58.34,Main,Diké,0,0,0,,Chính vì sống quá lâu,
Dialogue: 0,0:19:58.34,0:20:03.51,Main,Diké,0,0,0,,rất nhiều người trong chúng tôi đã mất đi hoàn toàn ý chí sinh tồn, chứ đừng nói tới việc duy trì nòi giống.
Dialogue: 0,0:20:03.51,0:20:04.60,Main,Akira,0,0,0,,Mất đi ý chí sinh tồn sao?
Dialogue: 0,0:20:05.00,0:20:09.52,Main,Diké,0,0,0,,Hai người họ thậm chí đã không còn hứng thú với việc ăn uống nữa rồi.
Dialogue: 0,0:20:10.21,0:20:11.84,Main,Karen,0,0,0,,Tôi từng nghe nói về chuyện này.
Dialogue: 0,0:20:12.17,0:20:16.17,Main,Karen,0,0,0,,Về căn bệnh quái ác của tộc elf khi họ đánh mất đi động lực để sống tiếp.
Dialogue: 0,0:20:16.17,0:20:17.61,Main,Akira,0,0,0,,Cô tới đây từ lúc nào thế?
Dialogue: 0,0:20:17.61,0:20:19.28,Main,Karen,0,0,0,,Tôi là thanh tra đấy, quên rồi sao?
Dialogue: 0,0:20:19.64,0:20:22.49,Main,Diké,0,0,0,,Ngoại trừ chúng tôi, toàn bộ tộc elf ngoài kia đều đã diệt vong,
Dialogue: 0,0:20:22.49,0:20:24.27,Main,Diké,0,0,0,,và vì không thể khoanh tay đứng nhìn chuyện đó xảy ra,
Dialogue: 0,0:20:24.27,0:20:26.94,Main,Diké,0,0,0,,Đại Ma Vương đại nhân khi trước đã hạ lệnh cho cả hai người họ phải sống tiếp.
Dialogue: 0,0:20:26.95,0:20:29.99,Sign_Basic,text,0,0,0,,KẺ MẠNH SINH TỒN
Dialogue: 0,0:20:27.25,0:20:29.99,Main,Akira,0,0,0,,Với cái chết của Đại Ma Vương, mệnh lệnh đó đã mất đi hiệu lực.
Dialogue: 0,0:20:30.30,0:20:31.92,Main,Akira,0,0,0,,Nhưng cô vẫn ổn chứ?
Dialogue: 0,0:20:32.32,0:20:34.84,Main,Diké,0,0,0,,Bản thân tôi thì chưa mắc phải căn bệnh đó.
Dialogue: 0,0:20:35.57,0:20:36.70,Main,Diké,0,0,0,,Tôi cầu xin ngài đấy!
Dialogue: 0,0:20:37.06,0:20:40.27,Main,Diké,0,0,0,,Xin ngài hãy hạ lệnh cho họ tiếp tục sống đi!
Dialogue: 0,0:20:40.68,0:20:41.78,Main,Akira,0,0,0,,Được rồi.
Dialogue: 0,0:20:44.37,0:20:46.11,Main,Diké,0,0,0,,Cảm ơn ngài!
Dialogue: 0,0:20:52.02,0:20:53.60,Sign_Basic,text,0,0,0,,MỘ ĐÁ
Dialogue: 0,0:20:52.01,0:20:53.09,Main,Akira,0,0,0,,Mộ Đá (Rock Grave)!
Dialogue: 0,0:20:54.56,0:20:55.35,Main,Diké,0,0,0,,Ngài vừa làm cái gì thế?!
Dialogue: 0,0:20:59.61,0:21:01.94,Main,Diké,0,0,0,,Eirene! Eunomia!
Dialogue: 0,0:21:11.03,0:21:12.45,Sign_Basic,text,0,0,0,,KẺ MẠNH SINH TỒN
Dialogue: 0,0:21:12.78,0:21:15.39,Main,Akira,0,0,0,,Hai người, hãy sống tiếp đi!
Dialogue: 0,0:21:33.65,0:21:35.49,Main,Eunomia,0,0,0,,Được rồi...
Dialogue: 0,0:21:35.49,0:21:37.42,Main,Eirene,0,0,0,,Chúng ta... phải sống tiếp đúng không?
Dialogue: 0,0:21:40.13,0:21:43.10,Main,Diké,0,0,0,,Tôi mừng cho hai người quá đi mất!
Dialogue: 0,0:21:43.98,0:21:45.44,Main,Masamune IV,0,0,0,,Thị trưởng ơi!
Dialogue: 0,0:21:45.44,0:21:47.33,Main,Chloe,0,0,0,,Thức ăn bồi bổ cho người ốm đã nấu xong xuôi rồi đây ạ!
Dialogue: 0,0:21:47.33,0:21:48.50,Main,Eirene,0,0,0,,Chlo ơi!
Dialogue: 0,0:21:50.24,0:21:51.59,Main,Chloe,0,0,0,,Mọi người...
Dialogue: 0,0:21:52.23,0:21:54.32,Italics,Akira,0,0,0,,Giờ thì họ sẽ ổn cả thôi.
Dialogue: 0,0:21:59.79,0:22:01.50,Sign_Basic,text,0,0,0,,ĐẠI TRỊ LIỆU
Dialogue: 0,0:22:01.88,0:22:03.45,Main,Karen,0,0,0,,Kỹ năng Kẻ Thế Mạng (Scapegoat) sao?
Dialogue: 0,0:22:04.14,0:22:05.78,Main,Karen,0,0,0,,Đúng là phong cách quen thuộc của cậu.
Dialogue: 0,0:22:06.55,0:22:09.22,Main,Akira,0,0,0,,Không hiểu ngày trước Đại Ma Vương đã làm chuyện đó như thế nào nhỉ.
Dialogue: 0,0:22:10.68,0:22:14.97,Sign_Basic,Credit,0,0,0,,Phụ đề Việt ngữ: Phamtin147
Dialogue: 0,0:22:15.14,0:22:19.43,Sign_Basic,Credit,0,0,0,,Biên dịch & Kỹ thuật: Phamtin147
Dialogue: 0,0:22:19.65,0:22:23.90,Sign_Basic,Credit,0,0,0,,Kiểm định chất lượng: Phamtin147

