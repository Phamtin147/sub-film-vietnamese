Dialogue: 0,0:00:05.89,0:00:08.71,italics,MARGARET/ID,0,0,0,,Tôi biết là anh ấy đang cố sống một cách nghiêm túc...
Dialogue: 0,0:00:08.71,0:00:10.57,italics,LILY/ID,0,0,0,,Nhưng anh ấy ngốc nghếch hết phần thiên hạ thật.
Dialogue: 0,0:00:10.88,0:00:15.57,main,MARGARET,0,0,0,,Bộ anh không thấy kỳ lạ khi \Nchẳng ai thèm dùng bộ giáp đó sao?
Dialogue: 0,0:00:15.57,0:00:19.47,main,MARGARET,0,0,0,,Đến cả thành viên của Nanh Vuốt Dã Thú \Ncũng chẳng ai đụng vào nó, đúng chứ?
Dialogue: 0,0:00:19.47,0:00:27.14,main,REIN,0,0,0,,Tôi chỉ nghĩ đơn giản là chẳng ai khác \Nchạm tay vào được bộ giáp này thôi mà.
Dialogue: 0,0:00:27.14,0:00:32.56,main,REIN,0,0,0,,Tôi cứ tưởng nếu mình mặc nó vào, cô sẽ \Ntức tối giậm chân giậm cẳng...
Dialogue: 0,0:00:32.56,0:00:33.84,main,LILY,0,0,0,,Tức chết đi được ấy chứ!
Dialogue: 0,0:00:33.84,0:00:36.05,main,REIN,0,0,0,,...và rồi tôi có thể nhìn cô bằng nửa con mắt.
Dialogue: 0,0:00:36.05,0:00:37.52,main,MARGARET & LILY,0,0,0,,Tính nết anh cũng thối tha không kém!
Dialogue: 0,0:00:51.95,0:00:54.58,top,SIGN,0,0,0,,MA PHÁP SƯ BAN PHƯỚC CHEAT BỊ ĐUỔI VIỆC\NTẬN HƯỞNG CUỘC SỐNG MỚI
Dialogue: 0,0:02:09.10,0:02:14.72,main,REIN,0,0,0,,Việc tôi chọn trở thành ma pháp sư ban phước \Nthay vì một mạo hiểm giả
Dialogue: 0,0:02:14.72,0:02:16.20,main,REIN,0,0,0,,chẳng vì lý do đặc biệt nào cả.
Dialogue: 0,0:02:16.20,0:02:17.24,main,LILY,0,0,0,,Động lực của anh vứt cho chó ăn rồi à?!
Dialogue: 0,0:02:17.46,0:02:23.95,main,REIN,0,0,0,,Nhưng trong tiềm thức, chắc tôi đã chọn \Nvị trí ít phải gánh vác trách nhiệm hơn.
Dialogue: 0,0:02:24.26,0:02:29.70,main,REIN,0,0,0,,Bởi khi làm mạo hiểm giả, hành động của cậu \Ncó thể làm tổn thương những người xung quanh.
Dialogue: 0,0:02:31.44,0:02:34.15,main,MARGARET,0,0,0,,Coi bộ anh ta cũng không hẳn là người xấu.
Dialogue: 0,0:02:34.15,0:02:35.83,main,LILY,0,0,0,,Em cũng nghĩ thế.
Dialogue: 0,0:02:35.83,0:02:39.73,main,REIN,0,0,0,,Giờ thì tôi sợ mất đi hai người lắm.
Dialogue: 0,0:02:40.13,0:02:46.31,main,REIN,0,0,0,,Di tích Quang Long ở Gadressa, \Nvương đô phía đông, rất nguy hiểm đúng không?
Dialogue: 0,0:02:47.96,0:02:54.22,main,LILY,0,0,0,,Nếu cứ bàn về rủi ro,\Nthì em chẳng nên đi mạo hiểm nữa làm gì.
Dialogue: 0,0:02:54.22,0:03:00.44,main,LILY,0,0,0,,Dù vậy, em nhất định phải đến \NDi tích Quang Long.
Dialogue: 0,0:03:02.54,0:03:05.23,main,MARGARET,0,0,0,,Nếu Lily đi, tôi cũng sẽ đi.
Dialogue: 0,0:03:05.23,0:03:07.95,main,MARGARET,0,0,0,,Tôi cần phải xác minh lý do chị gái tôi qua đời.
Dialogue: 0,0:03:06.98,0:03:07.95,main,REIN,0,0,0,,Nhưng mà...
Dialogue: 0,0:03:08.77,0:03:12.54,main,REIN,0,0,0,,nếu chết trước khi đạt được mục tiêu, \Nthì mọi chuyện cũng coi như chấm hết.
Dialogue: 0,0:03:13.08,0:03:14.30,main,LILY,0,0,0,,Chuyện đó...
Dialogue: 0,0:03:14.30,0:03:20.49,main,REIN,0,0,0,,Tôi sợ hai người sẽ mù quáng đâm đầu \Nmà không chịu rút lui khi tình thế nguy cấp.
Dialogue: 0,0:03:20.92,0:03:24.05,main,REIN,0,0,0,,Nên tôi có một thỉnh cầu.
Dialogue: 0,0:03:25.48,0:03:28.31,main,REIN,0,0,0,,Hãy để tôi chỉ huy chuyến mạo hiểm này.
Dialogue: 0,0:03:29.64,0:03:32.90,main,MARGARET,0,0,0,,Anh á? Kẻ ít kinh nghiệm nhất trong ba người chúng ta?
Dialogue: 0,0:03:32.90,0:03:35.65,main,MARGARET,0,0,0,,Xem ra cái thói đùa cợt của anh \Nvẫn chưa bỏ được nhỉ.
Dialogue: 0,0:03:35.65,0:03:39.05,main,REIN,0,0,0,,Đương nhiên tôi vẫn cần kinh nghiệm \Nvà lời khuyên từ hai người,
Dialogue: 0,0:03:39.05,0:03:42.51,main,REIN,0,0,0,,nhưng tôi nghĩ mình có thể giữ được bình tĩnh \Nhơn cả hai,
Dialogue: 0,0:03:42.51,0:03:45.41,main,REIN,0,0,0,,vì thế hãy để tôi đưa ra quyết định cuối cùng.
Dialogue: 0,0:03:46.23,0:03:49.91,main,LILY,0,0,0,,Ý anh là bọn em phải rút lui nếu anh yêu cầu sao?
Dialogue: 0,0:03:49.91,0:03:53.45,main,REIN,0,0,0,,Ừ. Đương nhiên khi đó \Nchúng ta sẽ quay lại thử sức lần nữa.
Dialogue: 0,0:03:53.77,0:03:55.00,main,REIN,0,0,0,,Hai người thấy thế được chứ?
Dialogue: 0,0:03:58.62,0:04:02.02,main,MARGARET,0,0,0,,Tôi sao cũng được. Tùy hai người quyết định.
Dialogue: 0,0:04:02.54,0:04:04.01,main,LILY,0,0,0,,Được rồi, anh Rein.
Dialogue: 0,0:04:04.29,0:04:05.78,main,LILY,0,0,0,,Anh sẽ là đội trưởng của bọn em.
Dialogue: 0,0:04:05.78,0:04:06.78,main,REIN,0,0,0,,Tuyệt vời!
Dialogue: 0,0:04:07.59,0:04:11.48,main,REIN,0,0,0,,Vậy thì đặt trang bị lên bàn đi. \NTôi sẽ ban phước cường hóa cho.
Dialogue: 0,0:04:11.48,0:04:11.99,main,LILY,0,0,0,,Hả?
Dialogue: 0,0:04:11.99,0:04:13.48,main,MARGARET,0,0,0,,Không cần thiết đâu.
Dialogue: 0,0:04:13.48,0:04:16.19,main,LILY,0,0,0,,Em đã nói bao nhiêu lần \Nlà em không cần rồi mà?
Dialogue: 0,0:04:16.19,0:04:18.97,main,REIN,0,0,0,,Bắt buộc đấy. Có thể không cần \Ncường hóa vũ khí của hai người,
Dialogue: 0,0:04:18.97,0:04:21.49,main,REIN,0,0,0,,nhưng tôi nhất định sẽ cường hóa \Ngiáp bảo hộ bằng mọi giá,
Dialogue: 0,0:04:21.49,0:04:23.84,main,REIN,0,0,0,,để tất cả chúng ta đều có thể sống sót trở về.
Dialogue: 0,0:04:23.84,0:04:25.61,main,REIN,0,0,0,,Đó là mệnh lệnh của đội trưởng.
Dialogue: 0,0:04:27.03,0:04:29.98,main,LILY,0,0,0,,Hóa ra đây là lý do anh muốn làm đội trưởng đấy à?
Dialogue: 0,0:04:29.98,0:04:30.87,main,REIN,0,0,0,,Phải đấy.
Dialogue: 0,0:04:33.84,0:04:36.93,main,LILY,0,0,0,,Vậy thì trăm sự nhờ đội trưởng cường hóa giúp em nhé.
Dialogue: 0,0:04:38.13,0:04:43.14,top,EPTITLE,0,0,0,,TẬP 4: BÀI HỌC RÚT RA SAU HAI LẦN KHỎA THÂN...\NCỨ LỘT ĐỒ LÀ SẼ BỊ CẮN HAI PHÁT.
Dialogue: 0,0:04:47.99,0:04:51.93,main,REIN,0,0,0,,Lily, tôi đã buff thêm 300 điểm \Nvào giáp của cậu rồi đấy.
Dialogue: 0,0:04:51.93,0:04:55.52,main,REIN,0,0,0,,Đó là giới hạn tối đa hiện tại \Ntôi có thể buff vào giáp của người khác.
Dialogue: 0,0:04:55.52,0:04:57.56,italics,MARGARET/ID,0,0,0,,B-Ba trăm điểm cơ á?!
Dialogue: 0,0:04:57.56,0:05:02.67,italics,MARGARET/ID,0,0,0,,Ngay cả ma pháp sư ban phước cấp cao \Ncũng chỉ buff được từ 3 đến 5 điểm thôi mà.
Dialogue: 0,0:05:03.01,0:05:05.77,italics,MARGARET/ID,0,0,0,,Con số này quá sức phi lý rồi.
Dialogue: 0,0:05:05.77,0:05:09.21,main,REIN,0,0,0,,Margaret, đưa giáp của cô cho tôi xem nào.
Dialogue: 0,0:05:10.03,0:05:14.49,main,MARGARET,0,0,0,,Từ trước tới giờ tôi đi thám hiểm \Nchẳng bao giờ nợ nần hay mang ơn ai cả.
Dialogue: 0,0:05:14.49,0:05:16.89,main,MARGARET,0,0,0,,Tôi không muốn phải nợ anh bất cứ điều gì.
Dialogue: 0,0:05:16.89,0:05:19.25,main,REIN,0,0,0,,Cô sẽ chẳng nợ nần gì tôi đâu.
Dialogue: 0,0:05:19.25,0:05:23.26,main,REIN,0,0,0,,Tôi chỉ làm những gì mình có thể \Nvì chúng ta đi cùng nhau thôi.
Dialogue: 0,0:05:23.51,0:05:24.81,main,REIN,0,0,0,,Vì chúng ta là đồng đội mà.
Dialogue: 0,0:05:25.80,0:05:26.98,main,MARGARET,0,0,0,,Đồng đội ư?
Dialogue: 0,0:05:30.53,0:05:31.26,main,MARGARET,0,0,0,,Chị gái tôi...
Dialogue: 0,0:05:32.64,0:05:38.30,main,MARGARET,0,0,0,,Chị tôi từng tin tưởng đồng đội, \Nđể rồi bỏ mạng trong chuyến thám hiểm.
Dialogue: 0,0:05:38.61,0:05:42.90,main,MARGARET,0,0,0,,Những kẻ mà chị tin tưởng giao phó sau lưng \Nlại chính là những kẻ bỏ chạy trước nhất.
Dialogue: 0,0:05:44.05,0:05:47.57,main,MARGARET,0,0,0,,Thế nên tôi không cần đồng đội.
Dialogue: 0,0:05:49.16,0:05:49.58,main,REIN,0,0,0,,Nhưng mà—
Dialogue: 0,0:05:49.58,0:05:51.37,main,MARGARET,0,0,0,,Cuộc nói chuyện kết thúc ở đây.
Dialogue: 0,0:05:51.74,0:05:55.13,main,MARGARET,0,0,0,,Xin mời hai người về cho. Chúng ta sẽ gặp lại \Nvào lúc khởi hành.
Dialogue: 0,0:05:59.33,0:06:00.39,main,MARGARET,0,0,0,,Về đi!
Dialogue: 0,0:06:11.69,0:06:15.77,flashback,MELISSA,0,0,0,,Margaret, qua bên này ăn cùng bọn chị đi.
Dialogue: 0,0:06:17.35,0:06:21.45,italics,MARGARET/ID,0,0,0,,Một nửa số mạo hiểm giả trong nhóm đó \Nđã bỏ mạng rồi.
Dialogue: 0,0:06:22.43,0:06:25.20,italics,MARGARET/ID,0,0,0,,Người phụ nữ đó đã phạm phải một sai lầm ngớ ngẩn,
Dialogue: 0,0:06:25.20,0:06:28.13,italics,MARGARET/ID,0,0,0,,và những người đồng đội của cô ta \Nđã phải trả giá bằng cả mạng sống.
Dialogue: 0,0:06:32.07,0:06:36.55,italics,MARGARET/ID,0,0,0,,Có lẽ đi mạo hiểm cùng đồng đội sẽ vui hơn.
Dialogue: 0,0:06:36.55,0:06:39.30,italics,MARGARET/ID,0,0,0,,Lại còn có thể tương trợ lẫn nhau nữa.
Dialogue: 0,0:06:39.74,0:06:43.91,italics,MARGARET/ID,0,0,0,,Nhưng đồng đội chỉ là thứ mật ngọt tẩm độc dược.
Dialogue: 0,0:06:44.81,0:06:48.92,italics,MARGARET/ID,0,0,0,,Mình luôn phải tự lực cánh sinh để sinh tồn.
Dialogue: 0,0:06:50.09,0:06:51.30,main,MARGARET,0,0,0,,Đi dạo một—
Dialogue: 0,0:06:56.06,0:06:59.00,main,MARGARET,0,0,0,,A-A-A-Anh đang làm cái trò gì thế hả Rein?!
Dialogue: 0,0:06:59.00,0:07:00.92,main,REIN,0,0,0,,Tôi đang đợi cô nè.
Dialogue: 0,0:07:00.92,0:07:02.94,main,MARGARET,0,0,0,,Khỏa thân trong khi bị chó cắn á?!
Dialogue: 0,0:07:02.94,0:07:05.50,main,REIN,0,0,0,,Quần áo của tôi được ếm phép cường hóa rồi.
Dialogue: 0,0:07:05.50,0:07:08.45,main,REIN,0,0,0,,Nó cứng đến mức ai đấm vào tôi \Nlà gãy tay như chơi đấy.
Dialogue: 0,0:07:08.45,0:07:11.20,main,REIN,0,0,0,,Tôi làm thế này là để bảo vệ răng của chú chó \Nkhi nó lỡ ngoạm vào tôi thôi.
Dialogue: 0,0:07:11.20,0:07:12.82,main,REIN,0,0,0,,Tôi lột đồ là vì chú chó này đấy!
Dialogue: 0,0:07:11.20,0:07:14.83,top,SIGN,0,0,0,,TRẢI NGHIỆM NÓNG BỎNG ĐẦU ĐỜI
Dialogue: 0,0:07:12.82,0:07:14.83,main,MARGARET,0,0,0,,Anh lột đồ vì con chó á?!
Dialogue: 0,0:07:14.83,0:07:16.16,main,MARGARET,0,0,0,,Mày có sao không thế?
Dialogue: 0,0:07:16.16,0:07:18.44,main,REIN,0,0,0,,Ừ, tôi hoàn toàn ổn mà.
Dialogue: 0,0:07:18.44,0:07:22.63,top,MARGARET,0,0,0,,Tao đã bảo bao nhiêu lần \Nlà không được ăn mấy thứ bậy bạ rồi cơ mà.
Dialogue: 0,0:07:22.98,0:07:24.22,top,MARGARET,0,0,0,,Lần sau phải cẩn thận hơn đấy nhé.
Dialogue: 0,0:07:22.10,0:07:26.81,italics,REIN/ID,0,0,0,,Hóa ra cô ấy nói chuyện với con chó, \Nchứ không phải mình. Lại còn lễ phép thế nữa chứ.
Dialogue: 0,0:07:27.72,0:07:33.32,italics,REIN/ID,0,0,0,,Chắc cô ấy chẳng mở lòng với ai bao giờ \Nnên mới dùng kính ngữ với cả loài chó.
Dialogue: 0,0:07:24.22,0:07:27.21,top,MARGARET,0,0,0,,Khắp nơi đều là vi khuẩn đấy. \NLại còn có cả ký sinh trùng nữa.
Dialogue: 0,0:07:27.21,0:07:30.23,top,MARGARET,0,0,0,,Đồ sống thế này phải nấu chín lên đã.
Dialogue: 0,0:07:30.64,0:07:33.97,top,MARGARET,0,0,0,,Tốt nhất là nên nướng cho cháy xém một tí.
Dialogue: 0,0:07:35.76,0:07:40.31,main,REIN,0,0,0,,Tôi không thể dẫn chủ nhân của mày đi cùng \Nnếu không cường hóa giáp cho cô ấy được.
Dialogue: 0,0:07:40.31,0:07:43.44,main,REIN,0,0,0,,Mày có thể giúp tôi giữ chân cô ấy ở đây \Ncho đến khi cô ấy chịu để tôi—
Dialogue: 0,0:07:49.60,0:07:50.54,main,REIN,0,0,0,,Xong xuôi rồi nhé.
Dialogue: 0,0:07:50.87,0:07:52.82,main,REIN,0,0,0,,Giờ thì bộ này cũng được +300 rồi.
Dialogue: 0,0:07:55.28,0:07:57.24,italics,MARGARET/ID,0,0,0,,Không thể để lại một vết xước nào luôn.
Dialogue: 0,0:07:57.24,0:07:59.62,main,REIN,0,0,0,,Sao nào Margaret? Tuyệt cú mèo đúng không?
Dialogue: 0,0:07:59.84,0:08:03.23,italics,MARGARET/ID,0,0,0,,Khốn kiếp. Đúng là +300 thật.
Dialogue: 0,0:08:03.23,0:08:06.19,italics,MARGARET/ID,0,0,0,,Nếu giáp của Lily cũng được cường hóa tương tự,
Dialogue: 0,0:08:06.63,0:08:09.30,italics,MARGARET/ID,0,0,0,,thì thanh kiếm này của mình sẽ không thể giết chết ả.
Dialogue: 0,0:08:10.13,0:08:13.97,main,MARGARET,0,0,0,,Rein, anh có thể cường hóa \Nthanh kiếm này giúp tôi luôn được không?
Dialogue: 0,0:08:15.94,0:08:17.45,main,MARGARET,0,0,0,,Của anh này, Rein.
Dialogue: 0,0:08:18.48,0:08:22.10,main,MARGARET,0,0,0,,Đây là bộ giáp dự phòng của tôi. \NHãy nhận nó coi như lời cảm ơn nhé.
Dialogue: 0,0:08:22.50,0:08:27.18,main,MARGARET,0,0,0,,Tôi không phải đồng đội của ai cả, \Nnên đôi bên chẳng ai nợ nần ai hết.
Dialogue: 0,0:08:30.01,0:08:31.77,main,REIN,0,0,0,,Hẹn gặp lại sau nhé, Margaret.
Dialogue: 0,0:08:34.90,0:08:38.80,italics,MARGARET/ID,0,0,0,,Giờ thì mình có thể khử ả một khi ả kiệt sức rồi.
Dialogue: 0,0:08:41.04,0:08:44.05,main,MARGARET,0,0,0,,Có chuyện gì thế Rein? Anh quên đồ...
Dialogue: 0,0:08:45.81,0:08:49.29,main,MARGARET,0,0,0,,Cornelius của Nanh Vuốt Dã Thú và...
Dialogue: 0,0:08:49.29,0:08:51.14,main,MARGARET,0,0,0,,Cô là ai?
Dialogue: 0,0:08:51.14,0:08:54.47,main,CORNELIUS,0,0,0,,Bọn tao chuẩn bị bắt cóc thằng Rein. Khôn hồn thì nhập hội đi.
Dialogue: 0,0:08:54.47,0:08:58.18,main,MARGARET,0,0,0,,Mày quên mất là anh ấy từng cho mày \Năn một trận no đòn rồi à?
Dialogue: 0,0:08:58.18,0:08:59.83,main,MARGARET,0,0,0,,Và tao không rảnh hợp tác với lũ yếu—
Dialogue: 0,0:08:59.83,0:09:00.73,main,CORNELIUS,0,0,0,,Bọn tao vào đây.
Dialogue: 0,0:09:00.73,0:09:02.26,main,MARGARET,0,0,0,,Này, đứng lại!
Dialogue: 0,0:09:02.72,0:09:04.82,main,MARGARET,0,0,0,,Ai cho phép các người tự tiện xông vào—
Dialogue: 0,0:09:06.52,0:09:11.48,main,MARGARET,0,0,0,,Ra là vậy. Trông bà có vẻ là người đủ sức \Nbắt cóc Rein đấy,
Dialogue: 0,0:09:12.06,0:09:16.41,main,MARGARET,0,0,0,,Phó bang chủ của Nanh Vuốt Dã Thú, Glenda.
Dialogue: 0,0:09:18.12,0:09:21.31,main,GLENDA,0,0,0,,Nanh Vuốt Dã Thú đang chuyển mình \Ntheo một hướng đi mới.
Dialogue: 0,0:09:21.31,0:09:25.57,main,GLENDA,0,0,0,,Bọn ta sẽ bắt cóc, giam cầm Rein \Nvà ép hắn phải ban phước cho toàn bộ trang bị.
Dialogue: 0,0:09:25.57,0:09:29.85,main,GLENDA,0,0,0,,Nhờ vào năng lực ban phước của hắn, \Ncác thành viên cũ sẽ quay trở lại với bọn ta.
Dialogue: 0,0:09:30.54,0:09:33.13,main,MARGARET,0,0,0,,Và bà định đi bắt Rein cùng với...
Dialogue: 0,0:09:33.53,0:09:37.61,main,GLENDA,0,0,0,,Cornelius, ta đã bảo ngươi đi tìm một sát thủ cơ mà.
Dialogue: 0,0:09:38.74,0:09:41.18,main,GLENDA,0,0,0,,Con nhóc kia là sát thủ đấy à?
Dialogue: 0,0:09:42.02,0:09:43.18,main,MARGARET,0,0,0,,Sát thủ ư?
Dialogue: 0,0:09:43.53,0:09:47.22,main,GLENDA,0,0,0,,Ta nghi là con nhóc đó chẳng thể nào giết nổi Lily đâu.
Dialogue: 0,0:09:47.22,0:09:49.23,main,GLENDA,0,0,0,,Đúng là đồ vô dụng.
Dialogue: 0,0:09:51.13,0:09:54.40,main,CORNELIUS,0,0,0,,Câm mồm đi, bà già. T-Tao giết bà luôn bây giờ!
Dialogue: 0,0:10:09.13,0:10:12.96,main,GLENDA,0,0,0,,C-Cornelius, ngươi làm cái—
Dialogue: 0,0:10:13.25,0:10:17.04,main,CORNELIUS,0,0,0,,Tao cóc thèm quan tâm đến Nanh Vuốt Dã Thú nữa.
Dialogue: 0,0:10:17.04,0:10:20.16,main,CORNELIUS,0,0,0,,Giết chết Rein và Lily đối với tao \Nquan trọng hơn nhiều.
Dialogue: 0,0:10:20.16,0:10:24.82,main,CORNELIUS,0,0,0,,Nếu không, tao sẽ mãi là trò cười \Ntrong cái nghề này suốt đời!
Dialogue: 0,0:10:32.49,0:10:36.73,main,CORNELIUS,0,0,0,,Mirabel, cô đã chứng minh được thực lực của mình rồi.
Dialogue: 0,0:10:36.73,0:10:41.91,main,CORNELIUS,0,0,0,,Ta chính thức thuê cô để lấy mạng Lily. \NTiền thù lao của cô đây.
Dialogue: 0,0:10:43.66,0:10:45.61,main,CORNELIUS,0,0,0,,Xin lỗi vì chuyện vừa rồi nhé, Margaret.
Dialogue: 0,0:10:46.55,0:10:48.64,main,CORNELIUS,0,0,0,,Bọn tao sẽ dọn dẹp cái xác này.
Dialogue: 0,0:10:48.64,0:10:52.55,main,MARGARET,0,0,0,,Đương nhiên là thế rồi. Và Lily sẽ do chính tay tôi giết.
Dialogue: 0,0:10:52.55,0:10:55.34,main,MARGARET,0,0,0,,Nếu các người đồng ý không can thiệp \Nvào kế hoạch của tôi,
Dialogue: 0,0:10:55.57,0:10:58.26,main,MARGARET,0,0,0,,tôi sẽ cho các người biết thời điểm \NRein và Lily khởi hành,
Dialogue: 0,0:10:58.26,0:11:01.70,main,MARGARET,0,0,0,,nơi họ đến, tình trạng trang bị \Nvà bất cứ thông tin nào khác.
Dialogue: 0,0:11:02.26,0:11:06.59,main,CORNELIUS,0,0,0,,Tao có nghe về mối ân oán giữa mày với Lily rồi. \NTao sẽ không ngáng đường mày đâu.
Dialogue: 0,0:11:06.98,0:11:12.86,main,CORNELIUS,0,0,0,,Tao chỉ việc khử thằng Rein, \Ndù mày có thích hay không.
Dialogue: 0,0:11:54.47,0:11:56.62,italics,NARRATION,0,0,0,,Vương đô Gadressa.
Dialogue: 0,0:12:07.31,0:12:11.37,italics,NARRATION,0,0,0,,Cách vương đô hai giờ đi xe ngựa chính là...
Dialogue: 0,0:12:21.80,0:12:24.05,main,REIN,0,0,0,,Cuối cùng cũng tới nơi rồi.
Dialogue: 0,0:12:24.63,0:12:27.42,main,REIN,0,0,0,,Ra đó là hầm ngục với độ khó khét tiếng,
Dialogue: 0,0:12:27.91,0:12:29.67,main,REIN,0,0,0,,Di tích Quang Long.
Dialogue: 0,0:12:30.57,0:12:32.46,italics,NARRATION,0,0,0,,Di tích Quang Long.
Dialogue: 0,0:12:33.38,0:12:42.73,italics,NARRATION,0,0,0,,Nơi sâu thẳm nhất chính là nơi ngự trị của thanh quang kiếm mang sức mạnh của loài rồng, Lefaid.
Dialogue: 0,0:12:41.20,0:12:49.71,top,SIGN,0,0,0,,LEFAID
Dialogue: 0,0:12:42.73,0:12:46.23,italics,NARRATION,0,0,0,,Nó được canh giữ bởi một con rồng cấp cao trong di tích ở ngoại ô Gadressa,
Dialogue: 0,0:12:46.23,0:12:48.81,italics,NARRATION,0,0,0,,Vương quốc của loài Rồng.
Dialogue: 0,0:12:59.73,0:13:02.46,main,REIN,0,0,0,,Ngôi đền đồ sộ thật đấy.
Dialogue: 0,0:13:04.45,0:13:09.67,main,MARGARET,0,0,0,,Chị Lily, bên trong có điều gì cần lưu ý không? \NTình hình trong đó thế nào?
Dialogue: 0,0:13:10.37,0:13:14.98,main,LILY,0,0,0,,Chị xin lỗi, Margaret. Chị chẳng nhớ được \Ngì về khu di tích này cả.
Dialogue: 0,0:13:15.86,0:13:20.81,main,LILY,0,0,0,,Những gì chị nhớ chỉ là cảm giác \Nbất lực và tuyệt vọng cùng cực mà thôi.
Dialogue: 0,0:13:21.65,0:13:24.60,main,MARGARET,0,0,0,,Tôi hiểu rồi. Vậy thì chúng ta xuất phát thôi.
Dialogue: 0,0:13:27.72,0:13:29.38,italics,MARGARET/ID,0,0,0,,Đúng là nhảm nhí.
Dialogue: 0,0:13:30.84,0:13:35.69,italics,MARGARET/ID,0,0,0,,Chẳng nhớ được gì á? \NLàm quái gì có chuyện đó.
Dialogue: 0,0:13:37.63,0:13:41.38,main,REIN,0,0,0,,Chà, hóa ra đây là hầm ngục sao.
Dialogue: 0,0:13:41.38,0:13:43.48,main,LILY,0,0,0,,Đừng có lơ đãng thế. Nguy hiểm lắm đấy.
Dialogue: 0,0:13:44.46,0:13:49.39,main,MARGARET,0,0,0,,Tôi vẫn tin chắc Lily đã bỏ rơi mọi người \Nmà tháo chạy một mình.
Dialogue: 0,0:13:49.76,0:13:51.54,main,MARGARET,0,0,0,,Anh nghĩ sao hả Rein?
Dialogue: 0,0:13:51.98,0:13:54.17,main,REIN,0,0,0,,Tôi không nghĩ cô ấy làm vậy đâu.
Dialogue: 0,0:13:54.64,0:14:00.16,main,REIN,0,0,0,,Tôi hy vọng chuyến đi này có thể làm sáng tỏ điều đó \Nđể hai người làm lành với nhau.
Dialogue: 0,0:14:00.16,0:14:01.23,main,MARGARET,0,0,0,,Cái gì cơ?
Dialogue: 0,0:14:01.23,0:14:04.73,main,REIN,0,0,0,,Chị gái cô và Lily từng là đồng đội, đúng chứ?
Dialogue: 0,0:14:04.73,0:14:08.70,main,REIN,0,0,0,,Tôi tin chắc chị gái cô cũng muốn \Nhai người hòa thuận với nhau thôi.
Dialogue: 0,0:14:10.28,0:14:13.34,main,MARGARET,0,0,0,,Tôi đã theo dõi sát sao từng cử động của Lily.
Dialogue: 0,0:14:14.17,0:14:16.52,main,MARGARET,0,0,0,,Nghe đồn ả không thể chiến đấu được nữa.
Dialogue: 0,0:14:16.97,0:14:20.58,main,MARGARET,0,0,0,,Nhưng nếu ả đã vác xác tới đây, \Nthì chắc chắn đó cũng là lời dối trá.
Dialogue: 0,0:14:21.71,0:14:23.42,main,MARGARET,0,0,0,,Chị vẫn chiến đấu được đúng không?
Dialogue: 0,0:14:24.34,0:14:28.49,main,REIN,0,0,0,,Cứ bước vào trận là Lily lại run rẩy \Nđến mức không cầm nổi thanh kiếm.
Dialogue: 0,0:14:28.49,0:14:30.08,main,REIN,0,0,0,,Cô ấy chẳng thể làm được gì cả.
Dialogue: 0,0:14:30.08,0:14:32.03,main,REIN,0,0,0,,Nhưng cô ấy vẫn tận tình chỉ dẫn \Ncho một tân binh mạo hiểm giả như tôi,
Dialogue: 0,0:14:32.03,0:14:34.52,main,REIN,0,0,0,,bằng tất cả kiến thức và kinh nghiệm của mình.
Dialogue: 0,0:14:34.52,0:14:37.65,main,REIN,0,0,0,,Đó là lý do hiện tại tôi đồng hành cùng Lily.
Dialogue: 0,0:14:37.65,0:14:38.99,main,MARGARET,0,0,0,,Nực cười thật.
Dialogue: 0,0:14:40.12,0:14:41.69,main,REIN,0,0,0,,Margaret...
Dialogue: 0,0:14:41.96,0:14:44.94,italics,MARGARET/ID,0,0,0,,Vậy ra ả vẫn dám tới dù không thể chiến đấu sao?
Dialogue: 0,0:14:45.80,0:14:47.69,italics,MARGARET/ID,0,0,0,,Mình không tin.
Dialogue: 0,0:14:48.17,0:14:50.28,italics,MARGARET/ID,0,0,0,,Cả hai đứa bọn họ chắc chắn đều bị ngốc.
Dialogue: 0,0:14:51.20,0:14:56.20,italics,MARGARET/ID,0,0,0,,Lúc nào cũng chỉ có mỗi mình \Nlà nghiêm túc với mọi chuyện thôi à.
Dialogue: 0,0:15:11.23,0:15:13.05,main,MARGARET,0,0,0,,Ồ?
Dialogue: 0,0:15:13.29,0:15:15.29,main,MARGARET,0,0,0,,Người ta đồn nơi này là bất khả xâm phạm,
Dialogue: 0,0:15:15.29,0:15:18.66,main,MARGARET,0,0,0,,nhưng hóa ra cũng chỉ toàn lũ goblin \Nnhan nhản ở khắp mọi nơi.
Dialogue: 0,0:15:19.53,0:15:21.81,main,MARGARET,0,0,0,,Nhào vô hết đây, lũ tép riu.
Dialogue: 0,0:15:32.23,0:15:38.45,italics,MARGARET/ID,0,0,0,,Mình có mặt ở đây là vì chị có thể sẽ tìm cách \Nphi tang bằng chứng năm xưa đấy, Lily.
Dialogue: 0,0:15:39.45,0:15:42.33,italics,MARGARET/ID,0,0,0,,Bây giờ chị chỉ là một kẻ hèn nhát vô dụng.
Dialogue: 0,0:15:42.33,0:15:47.00,italics,MARGARET/ID,0,0,0,,Một khi đã tới đây, mình phải tiến lên phía trước, \Ndù cho có phải đơn độc một mình.
Dialogue: 0,0:15:50.78,0:15:56.12,italics,MARGARET/ID,0,0,0,,Chết tiệt. Nếu chúng đồng loạt lao vào, \Nchúng sẽ tự đâm lẫn nhau, nhưng mà...
Dialogue: 0,0:15:56.51,0:15:59.60,italics,MARGARET/ID,0,0,0,,Ra đây là lý do họ gọi nơi này \Nlà bất khả xâm phạm.
Dialogue: 0,0:16:03.67,0:16:04.26,main,MARGARET,0,0,0,,Chị Lily?!
Dialogue: 0,0:16:04.26,0:16:05.27,main,LILY,0,0,0,,Đừng cử động! Nằm rạp xuống!
Dialogue: 0,0:16:17.21,0:16:18.32,main,LILY,0,0,0,,Margaret.
Dialogue: 0,0:16:20.29,0:16:25.50,main,LILY,0,0,0,,Chị lo bộ giáp không chặn nổi hết đòn đánh của chúng \Nnên mới hoảng loạn xông ra.
Dialogue: 0,0:16:29.00,0:16:31.13,main,MARGARET,0,0,0,,Chị vừa cử động được kìa.
Dialogue: 0,0:16:31.13,0:16:31.97,main,LILY,0,0,0,,Hở?
Dialogue: 0,0:16:32.41,0:16:36.61,main,MARGARET,0,0,0,,Tôi cứ tưởng chị run đến mức \Nchẳng thể làm được gì trong trận chiến cơ đấy.
Dialogue: 0,0:16:41.33,0:16:45.19,main,MARGARET,0,0,0,,Hy vọng tiếp theo chị có thể \Ncầm lại thanh kiếm trên tay.
Dialogue: 0,0:16:45.72,0:16:48.42,main,LILY,0,0,0,,Chị cũng mong là thế.
Dialogue: 0,0:16:57.44,0:17:01.40,main,MARGARET,0,0,0,,Từ giờ tôi sẽ bám sát hai người.
Dialogue: 0,0:17:01.40,0:17:02.16,main,LILY,0,0,0,,Tốt quá rồi.
Dialogue: 0,0:17:07.81,0:17:08.71,main,LILY,0,0,0,,Anh Rein?
Dialogue: 0,0:17:09.53,0:17:10.92,main,REIN,0,0,0,,Tôi nghe thấy tiếng gì đó.
Dialogue: 0,0:17:11.14,0:17:15.26,main,MARGARET,0,0,0,,Quan trọng hơn là Rein à, sao thanh kiếm \Ncủa anh lại mạnh một cách phi lý—
Dialogue: 0,0:17:24.31,0:17:26.28,main,REIN,0,0,0,,Chỗ này sập mất! Chạy mau!
Dialogue: 0,0:17:26.28,0:17:29.77,main,LILY,0,0,0,,Anh ra tay quá đà rồi đấy!
Dialogue: 0,0:17:29.77,0:17:32.15,main,MARGARET,0,0,0,,Rốt cuộc anh đã ban phước cái quái gì vào thanh kiếm đó thế hả?!
Dialogue: 0,0:17:32.15,0:17:33.88,main,REIN,0,0,0,,Hả? À thì, thật ra...
Dialogue: 0,0:17:34.48,0:17:35.68,main,MARGARET,0,0,0,,Nghiêm túc đấy, cái quái gì thế này?!
Dialogue: 0,0:17:35.68,0:17:36.95,main,LILY,0,0,0,,Anh Rein, đằng sau anh kìa!
Dialogue: 0,0:17:43.79,0:17:44.51,main,REIN,0,0,0,,Lùi lại mau!
Dialogue: 0,0:18:01.05,0:18:02.88,main,LILY,0,0,0,,Ai thèm bận tâm đến con quái đó chứ?!
Dialogue: 0,0:18:02.88,0:18:04.97,main,MARGARET,0,0,0,,Bộ chúng ta cần phải để ý tới hắn à?!
Dialogue: 0,0:18:08.36,0:18:10.37,main,REIN,0,0,0,,T-Thoát chết rồi.
Dialogue: 0,0:18:10.37,0:18:12.93,main,LILY,0,0,0,,Nhưng mà chúng ta lạc đường hoàn toàn rồi.
Dialogue: 0,0:18:13.26,0:18:14.01,main,MARGARET,0,0,0,,Rein.
Dialogue: 0,0:18:14.69,0:18:19.24,main,MARGARET,0,0,0,,Kiếm của anh lại gãy nữa rồi kìa. \NAnh mang theo bao nhiêu thanh thế?
Dialogue: 0,0:18:20.66,0:18:22.89,main,REIN,0,0,0,,Tôi vẫn còn hơn 20 thanh nữa lận.
Dialogue: 0,0:18:23.22,0:18:25.29,main,REIN,0,0,0,,Mỗi khi mấy thanh kiếm rẻ tiền được ban phước bị gãy,
Dialogue: 0,0:18:25.29,0:18:29.50,main,REIN,0,0,0,,tôi sẽ thu hồi lại chỉ số buff rồi \Nchuyển chúng sang một thanh kiếm mới.
Dialogue: 0,0:18:29.50,0:18:32.38,main,REIN,0,0,0,,Tôi luôn duy trì hai thanh được cường hóa.
Dialogue: 0,0:18:32.97,0:18:35.48,main,REIN,0,0,0,,Đó là phương án tối ưu nhất của tôi hiện tại.
Dialogue: 0,0:18:35.48,0:18:38.38,italics,MARGARET/ID,0,0,0,,Hóa ra anh ta không hề hành động bừa bãi \Nmà không suy tính.
Dialogue: 0,0:18:38.38,0:18:42.01,main,REIN,0,0,0,,Giờ tôi sẽ chuyển chỉ số qua. \NChờ tôi một chút nhé.
Dialogue: 0,0:18:43.77,0:18:46.30,main,REIN,0,0,0,,Trong lúc chờ thì hai người cứ tự nhiên trò chuyện đi.
Dialogue: 0,0:18:52.06,0:18:53.50,main,MARGARET,0,0,0,,H-Hôm nay thời tiết đẹp thật nhỉ.
Dialogue: 0,0:18:53.50,0:18:55.68,main,LILY,0,0,0,,À, ừ.
Dialogue: 0,0:18:58.33,0:19:02.10,main,MARGARET,0,0,0,,Kể từ lúc bước vào di tích, \Nchị đã nhớ ra điều gì chưa?
Dialogue: 0,0:19:03.85,0:19:06.16,main,LILY,0,0,0,,Chưa, chẳng có gì cả.
Dialogue: 0,0:19:15.37,0:19:16.63,main,LILY,0,0,0,,Chị...
Dialogue: 0,0:19:18.49,0:19:21.78,main,LILY,0,0,0,,nghĩ là mình từng đi qua đây rồi.
Dialogue: 0,0:19:23.86,0:19:26.79,main,LILY,0,0,0,,Cùng với mọi người năm đó.
Dialogue: 0,0:19:29.12,0:19:32.75,main,LILY,0,0,0,,Cứ đi tiếp chắc chị sẽ nhớ ra nhiều hơn.
Dialogue: 0,0:19:38.29,0:19:40.14,italics,REIN/ID,0,0,0,,Con goblin vừa rồi...
Dialogue: 0,0:19:41.05,0:19:44.52,italics,REIN/ID,0,0,0,,Mình tình cờ chém trúng nó, \Nnhưng nếu nó còn sống sót...
Dialogue: 0,0:19:45.69,0:19:49.83,italics,REIN/ID,0,0,0,,Mấy thanh kiếm này không đủ tốt. \NMình sẽ chẳng thể bảo vệ được hai người họ.
Dialogue: 0,0:19:50.83,0:19:54.17,italics,REIN/ID,0,0,0,,Mình nhất định phải đoạt được Lefaid.
Dialogue: 0,0:19:59.84,0:20:02.01,main,REIN,0,0,0,,Là một đồng tiền vàng cổ này!
Dialogue: 0,0:20:02.95,0:20:06.32,italics,REIN/ID,0,0,0,,Đây là món kho báu đầu tiên \Nmình nhặt được trong chuyến mạo hiểm.
Dialogue: 0,0:20:06.71,0:20:08.79,italics,REIN/ID,0,0,0,,Giờ thì mình đã là mạo hiểm giả thực thụ rồi.
Dialogue: 0,0:20:08.79,0:20:09.93,main,LILY,0,0,0,,Anh Rein.
Dialogue: 0,0:20:10.15,0:20:11.70,main,LILY,0,0,0,,Anh vừa nhặt được cái gì đấy?
Dialogue: 0,0:20:11.70,0:20:14.46,main,MARGARET,0,0,0,,Là kho báu à? Cho bọn tôi xem với.
Dialogue: 0,0:20:14.46,0:20:17.67,main,LILY,0,0,0,,Theo luật bất thành văn, \Nkho báu tìm được phải chia đều đấy nhé.
Dialogue: 0,0:20:17.67,0:20:21.32,main,MARGARET,0,0,0,,Nếu không chia chác sòng phẳng, \Nthế nào cũng xảy ra đánh nhau cho xem.
Dialogue: 0,0:20:21.32,0:20:22.41,main,REIN,0,0,0,,Không đời nào!
Dialogue: 0,0:20:23.11,0:20:24.72,main,REIN,0,0,0,,Xin hai người đừng đánh nhau mà!
Dialogue: 0,0:20:24.72,0:20:25.40,main,LILY,0,0,0,,Đưa bọn em xem mau lên.
Dialogue: 0,0:20:25.40,0:20:27.24,main,MARGARET,0,0,0,,Sao anh cứ thích chọc điên người khác thế hả?
Dialogue: 0,0:20:28.74,0:20:30.04,main,LILY,0,0,0,,Đồng xu này đẹp thật đấy.
Dialogue: 0,0:20:30.04,0:20:31.65,main,MARGARET,0,0,0,,Ừ.
Dialogue: 0,0:20:34.94,0:20:36.97,main,LILY,0,0,0,,Chị giữ đồng này được không Margaret?
Dialogue: 0,0:20:36.97,0:20:40.33,main,MARGARET,0,0,0,,Được chứ. Dù sao em cũng nợ chị ơn cứu mạng ban nãy.
Dialogue: 0,0:20:40.33,0:20:41.08,main,LILY,0,0,0,,Anh Rein.
Dialogue: 0,0:20:42.55,0:20:45.19,main,LILY,0,0,0,,Em tặng lại anh đồng xu này làm kỷ niệm nhé.
Dialogue: 0,0:20:45.19,0:20:46.96,main,MARGARET,0,0,0,,Lần này bọn tôi phá lệ cho anh đấy.
Dialogue: 0,0:20:49.96,0:20:52.33,main,REIN,0,0,0,,Lily, Margaret...
Dialogue: 0,0:20:52.65,0:20:53.85,main,REIN,0,0,0,,Cảm ơn hai người nhiều lắm!
Dialogue: 0,0:20:54.69,0:20:56.65,main,LILY,0,0,0,,Anh cường hóa trang bị xong rồi đúng không?
Dialogue: 0,0:20:56.65,0:20:58.25,main,MARGARET,0,0,0,,Chúng ta đi tiếp thôi nào.
Dialogue: 0,0:20:58.25,0:20:59.69,main,REIN,0,0,0,,Ừ, đi thôi.
Dialogue: 0,0:21:07.21,0:21:08.76,main,REIN,0,0,0,,Lại có cái gì đó rơi dưới đất nữa kìa.
Dialogue: 0,0:21:09.29,0:21:10.31,main,LILY,0,0,0,,Lần này lại là cái gì nữa thế anh?
Dialogue: 0,0:21:10.31,0:21:12.20,main,MARGARET,0,0,0,,Đừng quên là kho báu phải chia đều đấy nhé.
Dialogue: 0,0:21:12.42,0:21:15.83,main,REIN,0,0,0,,Hả? Cái này tôi cũng không được giữ luôn sao?
Dialogue: 0,0:21:15.83,0:21:18.25,main,LILY,0,0,0,,Một mẩu giấy à? Viết gì thế anh?
Dialogue: 0,0:21:18.25,0:21:20.86,main,MARGARET,0,0,0,,Đừng có lề mề nữa. \NMau nói xem nó viết gì đi.
Dialogue: 0,0:21:23.82,0:21:28.44,italics,REIN/ID,0,0,0,,"Lily Flambert đã giết chết chúng tôi"?
Dialogue: 0,0:21:29.79,0:21:31.94,main,MARGARET,0,0,0,,Nó viết cái gì thế?
Dialogue: 0,0:21:31.94,0:21:32.92,main,LILY,0,0,0,,Cho bọn em xem đi mà, anh Rein.
Dialogue: 0,0:21:32.92,0:21:35.35,main,REIN,0,0,0,,Nó là, ờ thì...
Dialogue: 0,0:21:35.77,0:21:37.42,main,MARGARET,0,0,0,,Đưa đây xem mau.
Dialogue: 0,0:21:37.42,0:21:39.68,main,LILY,0,0,0,,Sao anh lại giấu nó đi thế hả anh Rein?
Dialogue: 0,0:21:42.40,0:21:44.25,main,REIN,0,0,0,,Thôi mà hai người! Bỏ tay ra đi!
Dialogue: 0,0:21:44.25,0:21:47.61,main,REIN,0,0,0,,Tôi sẽ nhét nó vào trong áo!
Dialogue: 0,0:21:48.12,0:21:50.66,main,REIN,0,0,0,,Bộ giáp này đã được cường hóa cực mạnh rồi!
Dialogue: 0,0:21:50.66,0:21:52.62,main,REIN,0,0,0,,Dù hai người có kéo cỡ nào \Ncũng vô ích thôi!
Dialogue: 0,0:21:53.66,0:21:54.64,main,REIN,0,0,0,,Trả lại đây mau!
Dialogue: 0,0:21:54.64,0:21:57.12,main,REIN,0,0,0,,Tôi đâu có cường hóa quần áo đâu á á!
Dialogue: 0,0:21:57.12,0:21:58.38,main,LILY,0,0,0,,Đưa mẩu giấy đó ra đây!
Dialogue: 0,0:21:58.38,0:21:59.38,main,MARGARET,0,0,0,,Đưa xem mau lên!
Dialogue: 0,0:21:59.38,0:22:02.71,main,REIN,0,0,0,,D-Dừng lại đi! Nếu hai người cứ kéo nữa là rách...
Dialogue: 0,0:22:47.67,0:22:49.18,top,SIGN,0,0,0,,LILY
Dialogue: 0,0:22:53.35,0:22:54.51,top,SIGN,0,0,0,,CÔ ẤY VỪA GỌI REIN KÌA!!
Dialogue: 0,0:22:54.51,0:22:59.52,top,sign,0,0,0,,{\an3}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:00.14,0:23:04.94,top,sign,0,0,0,,{\an1}Biên dịch & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:23:04.98,0:23:09.74,top,sign,0,0,0,,{\an3}Kiểm định chất lượng: Amtia(NOFACE)
Dialogue: 0,0:22:53.35,0:22:54.51,top,SIGN,0,0,0,,CÓ PHẢI CÔ ẤY...
Dialogue: 0,0:22:53.35,0:22:54.51,top,SIGN,0,0,0,,ĐANG NÓI VỀ MÌNH ĐẤY ÀAAA?!
Dialogue: 0,0:22:54.51,0:23:04.98,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:23:15.08,0:23:15.74,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:15.74,0:23:26.13,top,SIGN,0,0,0,,{\an4}REIN ĐẬP TAN SÂN KHẤU
Dialogue: 0,0:23:15.74,0:23:18.75,top,SIGN,0,0,0,,CÔ VỪA NÓI VỀ TÔI ĐẤY ĐÚNG KHÔNG?!
Dialogue: 0,0:23:15.74,0:23:18.75,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:18.75,0:23:19.50,top,SIGN,0,0,0,,ĐÚNG KHÔNG HẢ?!
Dialogue: 0,0:23:19.50,0:23:20.25,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:20.25,0:23:21.00,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:21.00,0:23:21.75,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:21.75,0:23:22.50,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:23:22.50,0:23:23.25,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:23.25,0:23:24.00,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:23:24.00,0:23:24.75,top,SIGN,0,0,0,,ĐÚNG THẾ MÀ, PHẢI KHÔNG?!
Dialogue: 0,0:23:24.75,0:23:25.50,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:23:25.50,0:23:26.13,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:28.05,0:23:30.63,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:23:28.05,0:23:28.80,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:28.80,0:23:29.55,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:29.55,0:23:30.30,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:30.30,0:23:30.63,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:35.39,0:23:40.18,top,SIGN,0,0,0,,XÔNG LÊN
Dialogue: 0,0:23:35.39,0:23:40.18,top,SIGN,0,0,0,,{\an9}LILY ƠI!!
Dialogue: 0,0:23:35.39,0:23:40.18,top,SIGN,0,0,0,,{\an7}LILY ƠI!!
