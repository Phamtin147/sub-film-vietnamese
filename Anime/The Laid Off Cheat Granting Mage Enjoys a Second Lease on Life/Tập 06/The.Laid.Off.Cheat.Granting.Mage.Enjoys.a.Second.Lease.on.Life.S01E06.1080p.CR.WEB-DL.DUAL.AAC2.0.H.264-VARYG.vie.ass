Dialogue: 0,0:00:13.91,0:00:16.54,top,SIGN,0,0,0,,MA PHÁP SƯ BAN PHƯỚC CHEAT BỊ ĐUỔI VIỆC\NTẬN HƯỞNG CUỘC SỐNG MỚI
Dialogue: 0,0:01:32.01,0:01:35.23,main,DRAGON LEFT,0,0,0,,Tên yếu nhớt đó chỉ biết to mồm chứ chẳng làm nên trò trống gì.
Dialogue: 0,0:01:38.56,0:01:40.80,main,DRAGON RIGHT,0,0,0,,Đi giết nốt lũ còn lại thôi.
Dialogue: 0,0:01:40.80,0:01:42.35,main,DRAGON LEFT,0,0,0,,Ừ.
Dialogue: 0,0:01:43.35,0:01:45.20,main,LILY,0,0,0,,Đ-Đợi đã.
Dialogue: 0,0:01:47.80,0:01:50.79,main,DRAGON LEFT,0,0,0,,Con nhỏ này dai như đỉa ấy.
Dialogue: 0,0:01:50.79,0:01:51.89,main,DRAGON RIGHT,0,0,0,,Giết nó đi.
Dialogue: 0,0:01:56.54,0:02:02.81,main,LILY,0,0,0,,Muốn giết ta thì cứ việc,\Nnhưng ta sẽ không để các ngươi muốn làm gì thì làm đâu!
Dialogue: 0,0:02:03.68,0:02:05.06,main,DRAGON RIGHT,0,0,0,,Mà khoan đã...
Dialogue: 0,0:02:07.83,0:02:10.31,main,DRAGON RIGHT,0,0,0,,Có cách này hay hơn này.
Dialogue: 0,0:02:10.80,0:02:15.69,main,DRAGON RIGHT,0,0,0,,Ngươi sẽ chỉ rời khỏi đây với nỗi khiếp sợ,\Nvà phải sống cả phần đời còn lại
Dialogue: 0,0:02:15.69,0:02:18.74,main,DRAGON RIGHT,0,0,0,,trong sự ám ảnh về quá khứ.
Dialogue: 0,0:02:19.90,0:02:25.66,main,DRAGON LEFT,0,0,0,,Bọn ta sẽ khiến ngươi quên sạch mọi chuyện\Nđã xảy ra ở nơi này.
Dialogue: 0,0:02:33.58,0:02:36.13,main,DRAGON RIGHT,0,0,0,,Bọn ta chẳng có gì phải sợ cả.
Dialogue: 0,0:02:37.08,0:02:41.16,main,DRAGON RIGHT,0,0,0,,Con nhỏ này từ hồi đó tới giờ chẳng thay đổi gì hết.
Dialogue: 0,0:02:42.02,0:02:46.64,main,DRAGON RIGHT,0,0,0,,Ngươi muốn thằng nhóc đó đánh vào\Nvết dấu ngươi đã để lại trên ngực bọn ta sao?
Dialogue: 0,0:02:46.91,0:02:48.97,main,DRAGON RIGHT,0,0,0,,Đừng có nực cười thế chứ!
Dialogue: 0,0:02:57.24,0:03:01.69,main,DRAGON RIGHT,0,0,0,,Đòn tấn công mạnh nhất cũng chỉ là vô nghĩa\Nnếu không đánh trúng đích.
Dialogue: 0,0:03:01.69,0:03:06.20,main,DRAGON RIGHT,0,0,0,,Nhìn xem. Thằng ranh đó đang ở tít dưới kia kìa.
Dialogue: 0,0:03:18.24,0:03:22.99,main,DRAGON RIGHT,0,0,0,,Ngươi lại bất lực chẳng làm nổi trò gì rồi,\Ncon ranh!
Dialogue: 0,0:03:23.51,0:03:25.68,main,LILY,0,0,0,,Tên ta không phải là "con ranh".
Dialogue: 0,0:03:26.33,0:03:29.02,main,LILY,0,0,0,,Chàng trai yếu đuối đó là Rein.
Dialogue: 0,0:03:31.05,0:03:32.31,main,LILY,0,0,0,,Còn ta...
Dialogue: 0,0:03:33.64,0:03:35.90,main,LILY,0,0,0,,chính là Lily Flambert!
Dialogue: 0,0:03:38.86,0:03:41.14,main,LILY,0,0,0,,Vảy của các ngươi là lớp giáp tối thượng,
Dialogue: 0,0:03:41.14,0:03:44.07,main,LILY,0,0,0,,nhưng mỗi khi cử động, giữa chúng sẽ lộ ra những khe hở!
Dialogue: 0,0:03:44.49,0:03:46.25,main,DRAGON RIGHT,0,0,0,,Con khốn này...
Dialogue: 0,0:03:52.59,0:03:55.25,main,LILY,0,0,0,,Lưỡi kiếm của ta đã chạm đến tận dây thần kinh của ngươi.
Dialogue: 0,0:03:55.25,0:03:59.76,main,LILY,0,0,0,,Mỗi cử động của ngươi sẽ truyền cơn chấn động lên cổ\Nvà gây ra nỗi đau đớn tột cùng.
Dialogue: 0,0:04:00.13,0:04:02.97,main,LILY,0,0,0,,Các ngươi không thể chạy thoát được nữa đâu!
Dialogue: 0,0:04:02.97,0:04:06.30,main,DRAGON RIGHT,0,0,0,,Khốn kiếp, con ranh này!
Dialogue: 0,0:04:06.30,0:04:10.98,main,DRAGON LEFT,0,0,0,,Tỉnh táo lại đi, Right!\NNgươi có sao không đấy?!
Dialogue: 0,0:04:11.25,0:04:11.98,top,SIGN FX,0,0,0,,PHẬP
Dialogue: 0,0:04:13.41,0:04:15.48,main,LILY,0,0,0,,Anh Rein, hãy đánh vào vết dấu đi!
Dialogue: 0,0:04:15.48,0:04:19.25,main,LILY,0,0,0,,Nếu anh dồn đòn tấn công vào một điểm duy nhất,\Nanh có thể đâm xuyên tim nó đấy!
Dialogue: 0,0:04:19.25,0:04:20.53,main,REIN,0,0,0,,Anh rõ rồi!
Dialogue: 0,0:04:20.53,0:04:23.51,main,REIN,0,0,0,,Anh tới đây!
Dialogue: 0,0:04:26.91,0:04:29.30,italics,REIN/ID,0,0,0,,Giáp của mọi người đã đến giới hạn rồi.
Dialogue: 0,0:04:29.82,0:04:34.17,italics,REIN/ID,0,0,0,,Nếu mình thất bại, tất cả sẽ mất mạng!
Dialogue: 0,0:04:34.79,0:04:39.80,top,EPTITLE,0,0,0,,NGƯƠI KIÊN TRÌ ĐẤY, CON RANH... NGƯƠI CHẲNG HỀ THAY ĐỔI\NCHÚT NÀO, VÀ LẠI BẤT LỰC CHẲNG LÀM ĐƯỢC GÌ...\NNHƯNG TA VẪN LÀ LILY FLAMBERT!
Dialogue: 0,0:04:40.17,0:04:43.55,main,DRAGON LEFT,0,0,0,,Ui da, đau quá.
Dialogue: 0,0:04:43.55,0:04:46.34,main,DRAGON LEFT,0,0,0,,Nói gì đi chứ, Right.
Dialogue: 0,0:04:46.34,0:04:49.81,main,DRAGON LEFT,0,0,0,,Ngươi giơ cờ trắng đầu hàng rồi đấy à?
Dialogue: 0,0:04:49.81,0:04:54.81,italics,DRAGON RIGHT/ID,0,0,0,,Thằng nhóc đó sẽ lao thẳng tới đây\Nđể đâm xuyên tim mình.
Dialogue: 0,0:04:54.81,0:05:01.02,italics,DRAGON RIGHT/ID,0,0,0,,Chỉ cần đợi khoảnh khắc đó, mình có thể\Nnghiền nát nó ngay trước mắt con nhỏ kia.
Dialogue: 0,0:05:02.72,0:05:04.78,main,LILY,0,0,0,,Anh Rein, bọn chúng định dùng đuôi\Nquất trúng anh đấy!
Dialogue: 0,0:05:04.78,0:05:06.54,main,LILY,0,0,0,,Hãy vung kiếm từ chỗ đó đi!
Dialogue: 0,0:05:06.54,0:05:09.41,main,MARGARET,0,0,0,,Ở khoảng cách đó cậu cũng gây đủ sát thương rồi!
Dialogue: 0,0:05:12.68,0:05:14.20,main,LILY,0,0,0,,Anh Rein, anh có nghe thấy không hả?!
Dialogue: 0,0:05:15.41,0:05:21.46,main,REIN,0,0,0,,Đ-Đừng lo. Anh sẽ n-nhảy lên\Nđể né cái đ-đuôi của nó.
Dialogue: 0,0:05:21.46,0:05:23.21,main,LILY,0,0,0,,Anh làm gì còn đủ sức mà làm trò đó chứ!
Dialogue: 0,0:05:23.54,0:05:26.76,italics,DRAGON RIGHT/ID,0,0,0,,Thằng nhóc này đúng là gà mờ chính hiệu.
Dialogue: 0,0:05:27.78,0:05:31.64,main,REIN,0,0,0,,Anh sẽ đâm thẳng vào tim nó!
Dialogue: 0,0:05:31.64,0:05:34.48,main,LILY,0,0,0,,Anh không thể né được cái đuôi đó đâu, đồ ngốc này!
Dialogue: 0,0:05:34.48,0:05:37.19,main,MARGARET,0,0,0,,Đừng có cố tỏ ra ngầu lòi nữa, đồ ngốc xít!
Dialogue: 0,0:05:37.19,0:05:40.69,main,REIN,0,0,0,,Nhưng nếu vung kiếm từ đằng này,\Ntôi không thể tránh làm trúng hai người được!
Dialogue: 0,0:05:41.53,0:05:44.36,main,REIN,0,0,0,,Hai người sẽ không chịu nổi sóng xung kích đâu!
Dialogue: 0,0:05:44.92,0:05:45.94,main,LILY,0,0,0,,Anh ấy...
Dialogue: 0,0:05:45.94,0:05:47.97,main,MARGARET,0,0,0,,Cậu ấy lo cho tụi mình sao?
Dialogue: 0,0:05:48.36,0:05:52.26,main,MARGARET,0,0,0,,Rein, tụi này tự phòng thủ được!\NCứ vung kiếm đi!
Dialogue: 0,0:05:52.26,0:05:55.16,main,LILY,0,0,0,,Cứ bận tâm chuyện đó thì tất cả chúng ta\Nsẽ chết hết mất!
Dialogue: 0,0:06:08.63,0:06:11.87,main,LILY,0,0,0,,Mau vung kiếm đi!
Dialogue: 0,0:06:11.87,0:06:13.28,main,MARGARET,0,0,0,,Cậu lúc nào cũng lập dị thế hả?!
Dialogue: 0,0:06:13.28,0:06:15.11,main,MARGARET,0,0,0,,Ai đời lại đi mặc bộ đồ màu đất thế kia chứ?!
Dialogue: 0,0:06:15.11,0:06:17.14,main,MARGARET,0,0,0,,Bà ngoại cậu mua cho cậu bộ đấy à?!
Dialogue: 0,0:06:17.14,0:06:20.40,main,DRAGON RIGHT,0,0,0,,Chiến thắng đòi hỏi phải hy sinh\Nvà chấp nhận rủi ro.
Dialogue: 0,0:06:20.40,0:06:23.32,main,DRAGON RIGHT,0,0,0,,Thằng nhóc đó thậm chí còn chẳng nhận ra điều đó!
Dialogue: 0,0:06:24.09,0:06:25.57,main,LILY & MARGARET,0,0,0,,Anh Rein!
Dialogue: 0,0:06:28.20,0:06:30.30,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:06:31.14,0:06:33.10,main,MARGARET,0,0,0,,Cái quái gì thế?!
Dialogue: 0,0:06:31.22,0:06:35.37,top,SIGN FACE,0,0,0,,GIẾT
Dialogue: 0,0:06:33.10,0:06:35.37,main,LILY,0,0,0,,Tôi đã bảo rồi mà, cái thằng nhóc này?!
Dialogue: 0,0:06:38.04,0:06:40.83,main,DRAGON RIGHT,0,0,0,,Thiếu kinh nghiệm khiến ngươi trở nên ngây thơ!
Dialogue: 0,0:06:40.83,0:06:43.06,main,DRAGON RIGHT,0,0,0,,Đó là lý do ngươi thua đấy!
Dialogue: 0,0:06:43.50,0:06:46.38,main,REIN,0,0,0,,Ngươi mới là kẻ ngây thơ ở đây!
Dialogue: 0,0:06:47.71,0:06:52.13,main,REIN,0,0,0,,Ngươi cố dụ ta lại càng gần càng tốt\Nđể có thể kết liễu ta.
Dialogue: 0,0:06:52.13,0:06:55.56,main,REIN,0,0,0,,Nhưng dù là một kẻ nghiệp dư,\Nở khoảng cách gần như thế...
Dialogue: 0,0:06:56.17,0:07:00.60,main,REIN,0,0,0,,ta vẫn có thể ném trúng mục tiêu bằng cách phi kiếm!
Dialogue: 0,0:07:04.01,0:07:06.25,main,DRAGON RIGHT,0,0,0,,K-Không thể nào!
Dialogue: 0,0:07:06.25,0:07:12.39,main,DRAGON RIGHT,0,0,0,,Con người không thể nào m-mạnh đến mức này được!
Dialogue: 0,0:07:12.39,0:07:15.83,main,DRAGON RIGHT,0,0,0,,Ngươi chẳng khác nào một vị thần hay ác quỷ!
Dialogue: 0,0:07:31.27,0:07:32.57,main,LILY,0,0,0,,Nó chết rồi.
Dialogue: 0,0:07:34.15,0:07:35.50,main,DRAGON LEFT,0,0,0,,Ui da...
Dialogue: 0,0:07:36.05,0:07:38.05,main,DRAGON LEFT,0,0,0,,Đau quá...
Dialogue: 0,0:07:40.27,0:07:49.98,main,DRAGON LEFT,0,0,0,,Ta vốn muốn sống một cuộc đời vui vẻ và bình yên hơn,\Nnhưng tên Right lại mạnh hơn ta.
Dialogue: 0,0:07:49.98,0:07:53.62,main,DRAGON LEFT,0,0,0,,Hắn cứ thụi vào vai đe dọa,\Nbắt ta phải nghe theo lời hắn.
Dialogue: 0,0:07:53.62,0:07:55.03,main,DRAGON LEFT,0,0,0,,Hắn bắt ta chạy vặt cho hắn.
Dialogue: 0,0:07:55.03,0:08:01.30,main,DRAGON LEFT,0,0,0,,Cả việc hốt cứt chó cũng luôn là phần của ta,\Ndù con chó đó là của hắn.
Dialogue: 0,0:08:01.30,0:08:05.58,main,DRAGON LEFT,0,0,0,,Ta ghét cuộc sống này. Thảm hại chết đi được.
Dialogue: 0,0:08:05.98,0:08:08.84,main,MARGARET,0,0,0,,Ừ, nghe có vẻ vất vả thật đấy.
Dialogue: 0,0:08:11.41,0:08:13.66,main,LILY,0,0,0,,Cái gì đây? Súng tiểu liên á?
Dialogue: 0,0:08:13.66,0:08:15.09,main,LILY,0,0,0,,Một khẩu Uzi chết tiệt luôn này!
Dialogue: 0,0:08:15.55,0:08:16.68,italics,DRAGON LEFT/ID,0,0,0,,Chết tiệt!
Dialogue: 0,0:08:16.68,0:08:20.73,italics,DRAGON LEFT/ID,0,0,0,,Mình tính kể khổ để tụi nó lơ là cảnh giác\Nrồi mới xả súng bắn chết tụi nó mà!
Dialogue: 0,0:08:20.73,0:08:22.10,italics,DRAGON LEFT/ID,0,0,0,,Sơ suất quá đi mất!
Dialogue: 0,0:08:22.67,0:08:24.82,main,LILY,0,0,0,,Không ngờ ngươi lại sở hữu\Nthứ như thế này đấy.
Dialogue: 0,0:08:24.82,0:08:27.11,main,MARGARET,0,0,0,,Đúng là một món vũ khí đáng gờm.
Dialogue: 0,0:08:27.11,0:08:31.22,main,DRAGON LEFT,0,0,0,,K-Khoan đã, đừng. Tàn nhẫn quá rồi đấy.
Dialogue: 0,0:08:36.23,0:08:37.49,main,DRAGON LEFT,0,0,0,,X-Xin tha mạ—
Dialogue: 0,0:08:48.55,0:08:52.30,italics,DRAGON LEFT/ID,0,0,0,,Suýt thì toi, nhưng mình vẫn sống sót.
Dialogue: 0,0:08:52.30,0:08:55.93,italics,DRAGON LEFT/ID,0,0,0,,Tim thì hỏng rồi,\Nnhưng chắc vẫn xoay xở được bằng cách nào đó.
Dialogue: 0,0:08:55.93,0:08:59.01,italics,DRAGON LEFT/ID,0,0,0,,Con nhỏ đó không có gan bóp cò bắn mình đâu.
Dialogue: 0,0:08:59.01,0:09:03.00,italics,DRAGON LEFT/ID,0,0,0,,Thảo nào cả tổ đội của nó mới bị tiêu diệt sạch.
Dialogue: 0,0:09:03.00,0:09:07.19,italics,DRAGON LEFT/ID,0,0,0,,Con đần độn! Con ngu xuẩn! Chết đi cho khuất mắt!
Dialogue: 0,0:09:15.07,0:09:18.58,main,MARGARET,0,0,0,,Không được phép lơ là cảnh giác\Ntrước mặt quái vật.
Dialogue: 0,0:09:20.74,0:09:22.62,main,LILY,0,0,0,,Mà này, anh Rein đâu rồi?
Dialogue: 0,0:09:24.75,0:09:25.80,main,LILY,0,0,0,,Anh Rein!
Dialogue: 0,0:09:27.51,0:09:31.75,main,REIN,0,0,0,,Tay trái và chân trái của tôi thế nào rồi?
Dialogue: 0,0:09:32.05,0:09:34.34,main,MARGARET,0,0,0,,C-Chúng hoàn toàn bình thường mà.
Dialogue: 0,0:09:34.60,0:09:37.08,main,REIN,0,0,0,,Ui da, đau quá...
Dialogue: 0,0:09:37.08,0:09:38.37,main,MARGARET,0,0,0,,Cậu rên rỉ y hệt như con Thánh Long ấy.
Dialogue: 0,0:09:38.37,0:09:39.28,main,LILY,0,0,0,,Buồn cười chết đi được.
Dialogue: 0,0:09:43.41,0:09:46.01,main,REIN,0,0,0,,Cảm ơn em, Lily, và cả Margaret nữa.
Dialogue: 0,0:09:46.01,0:09:46.91,main,MARGARET,0,0,0,,Một triệu yên.
Dialogue: 0,0:09:46.91,0:09:48.15,main,LILY,0,0,0,,Một triệu yên.
Dialogue: 0,0:09:49.32,0:09:50.14,main,LILY,0,0,0,,Anh Rein.
Dialogue: 0,0:09:50.56,0:09:53.20,main,MARGARET,0,0,0,,Cậu đã đánh bại được Thánh Long rồi.
Dialogue: 0,0:09:53.20,0:09:57.19,main,LILY,0,0,0,,Anh đã dồn đòn tấn công vào một điểm duy nhất,\Nđúng như dự tính ban đầu.
Dialogue: 0,0:09:57.19,0:09:58.59,main,LILY,0,0,0,,Đây hoàn toàn là chiến công của anh đấy.
Dialogue: 0,0:09:59.49,0:10:00.68,main,REIN,0,0,0,,Không đâu.
Dialogue: 0,0:10:02.63,0:10:05.41,main,REIN,0,0,0,,Một mình anh thì chẳng thể nào đánh bại được nó.
Dialogue: 0,0:10:05.87,0:10:07.39,main,REIN,0,0,0,,Tất cả là nhờ có hai người ở bên cạnh.
Dialogue: 0,0:10:09.55,0:10:10.88,main,REIN,0,0,0,,Ui da...
Dialogue: 0,0:10:10.88,0:10:11.55,main,MARGARET,0,0,0,,Cậu đứng dậy nổi không?
Dialogue: 0,0:10:11.55,0:10:12.25,main,LILY,0,0,0,,Cẩn thận đấy!
Dialogue: 0,0:10:12.25,0:10:14.19,main,LILY,0,0,0,,Anh ta sẽ sờ soạng ngực với mông cậu bây giờ!
Dialogue: 0,0:10:14.89,0:10:16.36,main,REIN,0,0,0,,Tôi không có làm thế đâu!
Dialogue: 0,0:10:17.50,0:10:19.32,main,LILY,0,0,0,,Gì cơ? Anh từng làm thế thật à?
Dialogue: 0,0:10:19.32,0:10:20.72,main,REIN,0,0,0,,Không có mà!
Dialogue: 0,0:10:20.72,0:10:25.47,top,SIGN FX,0,0,0,,HAHAHA
Dialogue: 0,0:10:25.88,0:10:27.59,main,LILY,0,0,0,,Anh Rein, tựa vào em này!
Dialogue: 0,0:10:27.59,0:10:29.23,main,REIN,0,0,0,,Thế này có được không em?
Dialogue: 0,0:10:29.77,0:10:31.33,main,MARGARET,0,0,0,,Bàn tay kia đang mò mẫm đi đâu đấy hả?!
Dialogue: 0,0:10:34.15,0:10:38.24,main,REIN,0,0,0,,Không có bộ giáp hai người tặng,\Nchắc tôi đã chết mất rồi.
Dialogue: 0,0:10:38.60,0:10:43.08,main,MARGARET,0,0,0,,Tôi cũng thế. Nếu không có cậu cường hóa giáp,\Ntôi cũng bỏ mạng rồi.
Dialogue: 0,0:10:43.08,0:10:46.33,main,LILY,0,0,0,,Em cũng vậy. Anh đã cứu mạng em, anh Rein.
Dialogue: 0,0:10:46.33,0:10:50.33,main,REIN,0,0,0,,Không có bộ giáp hai người tặng,\Nchắc tôi đã chết mất rồi.
Dialogue: 0,0:10:50.33,0:10:52.50,main,LILY,0,0,0,,Thôi đi. Sao anh cứ lặp đi lặp lại thế?
Dialogue: 0,0:10:57.37,0:10:59.29,flashback italics,REIN,0,0,0,,Ai ai cũng đều có giá trị cả!
Dialogue: 0,0:10:59.29,0:11:02.42,flashback italics,REIN,0,0,0,,Và điều đó hiển nhiên bao gồm cả em nữa!
Dialogue: 0,0:11:17.74,0:11:20.20,main,MIRABELLE,0,0,0,,Cái gì thế này?
Dialogue: 0,0:11:21.35,0:11:22.28,flashback italics,MOM,0,0,0,,Mirabelle.
Dialogue: 0,0:11:23.24,0:11:25.86,flashback,MOM,0,0,0,,Người đàn ông này đã thuê con đi giết người.
Dialogue: 0,0:11:25.86,0:11:26.70,flashback,THIRD SON,0,0,0,,Mẹ ơi!
Dialogue: 0,0:11:26.70,0:11:32.12,top,SIGN SHIRT,0,0,0,,GIA ĐÌNH
Dialogue: 0,0:11:27.93,0:11:31.25,flashback,THIRD SON,0,0,0,,Con xin lỗi! Lần sau con nhất định sẽ giết được chúng!
Dialogue: 0,0:11:31.72,0:11:33.73,flashback,THIRD SON,0,0,0,,Xin mẹ tha thứ cho con, mẹ ơi!
Dialogue: 0,0:11:31.72,0:11:35.02,flashback,MOM,0,0,0,,Nhìn xem nó tuyệt vọng đến mức nào kìa!
Dialogue: 0,0:11:35.37,0:11:38.09,flashback,MOM,0,0,0,,Nó thèm khát được yêu thương đến phát cuồng!
Dialogue: 0,0:11:38.09,0:11:41.26,flashback,MOM,0,0,0,,Nói thật, trông tởm lợm kinh lên được.
Dialogue: 0,0:11:41.63,0:11:47.97,flashback,MOM,0,0,0,,Mirabelle à, con và tất cả những kẻ khác\Nđều là lũ vô giá trị.
Dialogue: 0,0:11:47.97,0:11:50.41,flashback,MOM,0,0,0,,Đó là lý do con có thể giết chúng mà chẳng cần bận tâm.
Dialogue: 0,0:11:50.77,0:11:58.02,flashback,MOM,0,0,0,,Nhưng khi con giết được mục tiêu,\Nmẹ sẽ yêu thương con.
Dialogue: 0,0:11:59.08,0:12:03.52,main,MIRABELLE,0,0,0,,Đúng vậy. Mình là kẻ vô giá trị.
Dialogue: 0,0:12:04.91,0:12:06.16,italics,MIRABELLE/ID,0,0,0,,Em xin lỗi, anh Rein.
Dialogue: 0,0:12:06.69,0:12:10.70,italics,MIRABELLE/ID,0,0,0,,Em buộc phải giết anh thôi.
Dialogue: 0,0:12:11.41,0:12:13.79,main,REIN,0,0,0,,Oà, con Thánh Long đúng là\Nkhông làm mình thất vọng mà.
Dialogue: 0,0:12:13.79,0:12:15.51,main,REIN,0,0,0,,Mình kiếm được tận 5.000 điểm từ nó.
Dialogue: 0,0:12:16.45,0:12:21.21,italics,LILY/ID,0,0,0,,Mình đã chiến đấu. Mình thực sự đã có thể đứng lên chiến đấu.
Dialogue: 0,0:12:22.08,0:12:23.75,main,REIN,0,0,0,,Này, này, này!
Dialogue: 0,0:12:23.75,0:12:25.44,main,REIN,0,0,0,,Em làm cái dáng đứng ngầu lòi gì thế kia?
Dialogue: 0,0:12:25.44,0:12:27.54,main,REIN,0,0,0,,Bộ em là học sinh cấp hai hay sao?
Dialogue: 0,0:12:27.54,0:12:29.87,main,REIN,0,0,0,,Mùa hè nóng bỏng năm lớp tám của em\Nđã qua cả mấy tuần rồi đấy nhé!
Dialogue: 0,0:12:29.87,0:12:31.28,main,REIN,0,0,0,,Ôi, nhớ lại thời đó của mình khiến tôi hừng hực cả người!
Dialogue: 0,0:12:31.28,0:12:32.89,main,REIN,0,0,0,,Sự nóng lên toàn cầu\Nvẫn cứ không ngừng tiếp diễn!
Dialogue: 0,0:12:32.89,0:12:34.64,main,LILY,0,0,0,,Anh bị cái quái gì thế hả?!
Dialogue: 0,0:12:34.86,0:12:37.22,main,REIN,0,0,0,,Cho anh xem lại cái dáng ngầu lòi đó lần nữa đi!
Dialogue: 0,0:12:37.22,0:12:38.05,main,LILY,0,0,0,,Anh phiền phức thật đấy.
Dialogue: 0,0:12:43.52,0:12:47.87,main,MARGARET,0,0,0,,Ta sẽ không để ngươi làm hại họ đâu,\Nsát thủ Mirabelle.
Dialogue: 0,0:12:48.40,0:12:51.39,main,MARGARET,0,0,0,,Không chỉ chậm chạp hơn hẳn\Nso với lúc chúng ta mới chạm trán,
Dialogue: 0,0:12:51.39,0:12:53.85,main,MARGARET,0,0,0,,mà ngươi còn chẳng thèm ẩn mình kỹ càng nữa.
Dialogue: 0,0:12:53.85,0:12:54.68,main,REIN,0,0,0,,Mirabelle.
Dialogue: 0,0:12:54.68,0:12:56.65,main,MIRABELLE,0,0,0,,Đ-Đừng có lại gần tôi!
Dialogue: 0,0:13:03.30,0:13:12.77,main,MIRABELLE,0,0,0,,Anh Rein, khi anh đối xử tốt với em và bảo rằng\Nem không phải kẻ vô giá trị, em đã thấy rất vui.
Dialogue: 0,0:13:13.46,0:13:19.83,main,MIRABELLE,0,0,0,,Nó khiến em nghĩ những người khác cũng có giá trị,\Nvà em muốn trân trọng họ.
Dialogue: 0,0:13:21.57,0:13:25.04,main,MIRABELLE,0,0,0,,Cái gì thế này? Cảm giác này rốt cuộc là sao?
Dialogue: 0,0:13:26.29,0:13:30.17,main,MIRABELLE,0,0,0,,Cho đến tận bây giờ, trong mắt em con người, sâu bọ\Nhay dã thú chẳng có gì khác biệt.
Dialogue: 0,0:13:30.99,0:13:33.74,main,MIRABELLE,0,0,0,,Tất cả chỉ là những tảng thịt vụn mà thôi.
Dialogue: 0,0:13:34.34,0:13:38.33,main,MIRABELLE,0,0,0,,Nhưng giờ em lại không thể giết bất kỳ ai được nữa!
Dialogue: 0,0:13:39.54,0:13:43.77,main,MIRABELLE,0,0,0,,Cứ cái đà này, tại anh... tất cả là tại anh...
Dialogue: 0,0:13:44.76,0:13:47.22,main,MIRABELLE,0,0,0,,Mẹ sẽ bỏ rơi em mất thôi.
Dialogue: 0,0:13:48.93,0:13:49.68,main,REIN,0,0,0,,Anh xin lỗi.
Dialogue: 0,0:13:49.68,0:13:50.76,main,LILY,0,0,0,,Anh ấy xin lỗi luôn kìa!
Dialogue: 0,0:13:51.09,0:13:52.40,main,MIRABELLE,0,0,0,,Mẹ ơi...
Dialogue: 0,0:13:52.91,0:13:56.30,main,REIN,0,0,0,,Mirabelle, anh sẽ cùng em suy nghĩ.
Dialogue: 0,0:13:56.30,0:13:59.56,main,MARGARET,0,0,0,,Vừa đi vừa suy nghĩ cũng được mà, phải không?
Dialogue: 0,0:13:59.56,0:14:01.47,main,MARGARET,0,0,0,,Đi nào, Mirabelle. Hãy đi cùng bọn này.
Dialogue: 0,0:14:03.45,0:14:05.97,main,LILY,0,0,0,,Mọi người quên mất lý do chúng ta đến đây rồi à?
Dialogue: 0,0:14:10.16,0:14:11.05,main,REIN,0,0,0,,Là Thằng Đầu Phân kìa!
Dialogue: 0,0:14:11.05,0:14:14.41,main,CORNELIUS,0,0,0,,Mẹ kiếp chúng mày! Mau cứu tao coi!
Dialogue: 0,0:14:14.41,0:14:16.56,main,MARGARET,0,0,0,,Gợi cảm! Gợi cảm quá!
Dialogue: 0,0:14:16.56,0:14:18.04,main,CORNELIUS,0,0,0,,Này!
Dialogue: 0,0:14:18.04,0:14:19.71,main,CORNELIUS,0,0,0,,Này, Mirabelle!
Dialogue: 0,0:14:19.71,0:14:21.35,main,CORNELIUS,0,0,0,,Con ranh con kia!
Dialogue: 0,0:14:21.35,0:14:23.90,main,CORNELIUS,0,0,0,,Mau giết sạch tụi nó đi!
Dialogue: 0,0:14:16.59,0:14:23.66,top,MARGARET,0,0,0,,Gợi cảm! Gợi cảm! Gợi cảm!
Dialogue: 0,0:14:23.90,0:14:26.69,main,MIRABELLE,0,0,0,,T-Tôi đã làm đúng số tiền được trả rồi.
Dialogue: 0,0:14:26.69,0:14:29.72,main,MIRABELLE,0,0,0,,Nếu tôi không chiến đấu với Thánh Long,\Ntất cả chúng ta đều đã chết rồi.
Dialogue: 0,0:14:29.72,0:14:31.59,main,CORNELIUS,0,0,0,,Tao đéo quan tâm! Giết tụi nó mau!
Dialogue: 0,0:14:31.59,0:14:32.97,main,CORNELIUS,0,0,0,,Giết chúng nó! Giết chúng nó! Giết chúng nó đi!
Dialogue: 0,0:14:33.22,0:14:37.11,main,CORNELIUS,0,0,0,,Nếu mày không giết, mẹ mày\Nsẽ không bao giờ yêu thương mày nữa đâu!
Dialogue: 0,0:14:37.11,0:14:43.43,main,CORNELIUS,0,0,0,,Tao cá là thằng Rein đã bảo con người không hề vô giá trị,\Nnhưng đó là trò xảo trá lừa đảo đấy!
Dialogue: 0,0:14:43.43,0:14:44.11,main,MIRABELLE,0,0,0,,Lừa đảo ư?
Dialogue: 0,0:14:44.11,0:14:45.56,main,CORNELIUS,0,0,0,,Chứ còn gì nữa!
Dialogue: 0,0:14:45.56,0:14:48.56,main,CORNELIUS,0,0,0,,Mày đã giết chết nó rồi\Nnếu nó không giở trò lừa bịp mày!
Dialogue: 0,0:14:48.56,0:14:50.92,main,CORNELIUS,0,0,0,,Rõ ràng là nó nói dối rồi!
Dialogue: 0,0:14:50.92,0:14:53.54,main,MIRABELLE,0,0,0,,Nhưng với tôi, nghe chẳng giống nói dối chút nào.
Dialogue: 0,0:14:53.54,0:14:58.86,main,CORNELIUS,0,0,0,,Mày nghĩ thằng Rein sẽ rủ mày\Nđi chơi bowling vào cuối tuần chắc?!
Dialogue: 0,0:14:59.66,0:15:03.17,main,CORNELIUS,0,0,0,,Mirabelle, mày đã giết hàng chục mạng người rồi đấy!
Dialogue: 0,0:15:03.17,0:15:06.41,main,CORNELIUS,0,0,0,,Người bình thường chẳng ai thèm qua lại\Nvới một đứa như mày đâu!
Dialogue: 0,0:15:06.41,0:15:08.46,main,CORNELIUS,0,0,0,,Họ chỉ coi mày là con điên thôi!
Dialogue: 0,0:15:08.46,0:15:12.93,main,CORNELIUS,0,0,0,,Mày không chỉ vô giá trị, mà còn là đồ ác quỷ!\NAi thèm yêu thương mày cơ chứ?!
Dialogue: 0,0:15:12.93,0:15:14.43,main,CORNELIUS,0,0,0,,Chỉ có mẹ mày thôi!
Dialogue: 0,0:15:14.43,0:15:18.63,main,CORNELIUS,0,0,0,,Nên mày phải tiếp tục giết người\Ntheo lệnh của mẹ mày đi!
Dialogue: 0,0:15:19.31,0:15:20.86,main,REIN,0,0,0,,Đủ rồi đấy.
Dialogue: 0,0:15:20.86,0:15:23.40,main,REIN,0,0,0,,Mirabelle đang cố gắng hết sức để thay đổi!
Dialogue: 0,0:15:23.40,0:15:25.94,main,REIN,0,0,0,,Tại sao ngươi lại có thể thốt ra\Nnhững lời tàn nhẫn như thế với cô bé hả?!
Dialogue: 0,0:15:25.94,0:15:29.23,main,CORNELIUS,0,0,0,,Tụi mày có nghe thấy mấy lời sến súa ỉa chảy\Nmà thằng này vừa phun ra không?!
Dialogue: 0,0:15:29.23,0:15:33.84,main,CORNELIUS,0,0,0,,Cứ như thể tao đang ngồi thư giãn trong phòng khách ấm cúng\Nvà xem TV cùng với cún cưng vậy!
Dialogue: 0,0:15:35.45,0:15:38.95,main,REIN,0,0,0,,Đó không phải là nói dối! Không phải!
Dialogue: 0,0:15:38.95,0:15:40.96,main,REIN,0,0,0,,Ui da!
Dialogue: 0,0:15:41.19,0:15:44.29,main,CORNELIUS,0,0,0,,Tin tao đi, Mirabelle! Con người đều là đồ vô giá trị!
Dialogue: 0,0:15:44.29,0:15:45.51,main,CORNELIUS,0,0,0,,Mẹ là người duy nhất mày có trên đời này!
Dialogue: 0,0:15:45.51,0:15:47.71,main,CORNELIUS,0,0,0,,Giết người sướng vãi đái! Giết người muôn năm!
Dialogue: 0,0:15:47.71,0:15:49.51,main,REIN,0,0,0,,Hắn nói dối đấy, Mirabelle!
Dialogue: 0,0:15:49.51,0:15:52.94,main,REIN,0,0,0,,Em không thể tin những kẻ mở mồm ra\Nlà bảo con người vô giá trị được!
Dialogue: 0,0:15:53.47,0:15:56.22,main,MIRABELLE,0,0,0,,Em không biết điều gì mới là đúng nữa.
Dialogue: 0,0:15:56.22,0:15:58.72,main,CORNELIUS,0,0,0,,Thế để tao phân tích cho mày hiểu nhé!
Dialogue: 0,0:15:58.72,0:16:02.85,main,CORNELIUS,0,0,0,,Đầu tiên, Mirabelle, mày là kẻ sát nhân hàng loạt!\NMày là đồ vô giá trị!
Dialogue: 0,0:16:02.85,0:16:06.11,main,CORNELIUS,0,0,0,,Rồi đến những kẻ khác! Giả sử mày thấy\Nmột kẻ xa lạ bên lề đường...
Dialogue: 0,0:16:06.11,0:16:09.61,main,REIN,0,0,0,,Con người có giá trị mà!
Dialogue: 0,0:16:11.11,0:16:13.11,main,CORNELIUS,0,0,0,,Mày gào cái gì thế hả, thằng Rein kia?!
Dialogue: 0,0:16:09.61,0:16:13.11,main,REIN,0,0,0,,Có mà! Có mà! Có mà! Có mà!
Dialogue: 0,0:16:13.45,0:16:16.87,main,REIN,0,0,0,,Có mà, có mà,\Ncó mà, có mà, có mà!
Dialogue: 0,0:16:16.87,0:16:20.62,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:18.96,0:16:19.92,main,MARGARET,0,0,0,,Mirabelle.
Dialogue: 0,0:16:20.62,0:16:25.38,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:20.89,0:16:24.51,main,MARGARET,0,0,0,,Rein đang cố nói cho em hiểu\Nrằng con người không hề vô giá trị.
Dialogue: 0,0:16:24.27,0:16:25.38,top,SIGN FX RED,0,0,0,,KHỤ
Dialogue: 0,0:16:25.87,0:16:29.38,main,MARGARET,0,0,0,,Nhìn xem cậu ấy đang nỗ lực hết mình vì em\Nđến mức nào kìa.
Dialogue: 0,0:16:25.38,0:16:29.38,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:29.83,0:16:34.12,main,MARGARET,0,0,0,,Chẳng phải điều đó làm em cảm thấy\Nbản thân mình thực sự có giá trị sao?
Dialogue: 0,0:16:29.38,0:16:34.57,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:34.57,0:16:39.56,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:37.25,0:16:39.56,main,MIRABELLE,0,0,0,,Vâng, đúng vậy ạ.
Dialogue: 0,0:16:39.56,0:16:45.83,top,SIGN FX,0,0,0,,AAAAAHHH
Dialogue: 0,0:16:39.79,0:16:45.77,main,MARGARET,0,0,0,,Rein cũng từng nói điều tương tự với chị,\Nvà chị cũng...
Dialogue: 0,0:16:45.77,0:16:46.31,main,MARGARET,0,0,0,,Này!
Dialogue: 0,0:16:46.31,0:16:48.31,main,REIN,0,0,0,,Oái, hết hồn hà!
Dialogue: 0,0:16:54.43,0:16:55.74,main,LILY,0,0,0,,Lũ Goblin!
Dialogue: 0,0:16:56.14,0:16:59.69,main,REIN,0,0,0,,X-Xin lỗi, tại anh hét to quá.
Dialogue: 0,0:17:00.27,0:17:02.22,main,LILY,0,0,0,,Giờ anh có thì thầm cũng chẳng giải quyết được gì đâu!
Dialogue: 0,0:17:02.22,0:17:03.54,main,CORNELIUS,0,0,0,,Mirabelle!
Dialogue: 0,0:17:03.90,0:17:05.13,main,CORNELIUS,0,0,0,,Cứu tao với!
Dialogue: 0,0:17:05.13,0:17:07.33,main,CORNELIUS,0,0,0,,Mày định để mặc tao chết đấy à?
Dialogue: 0,0:17:07.33,0:17:12.59,top,SIGN PURPLE,0,0,0,,ĐƯỢC LẮM! TRƯỚC KHI CHẾT TA CŨNG PHẢI ĐỂ LẠI\NVẾT TÍCH TRÊN NGƯỜI CÁC NGƯƠI MỚI HẢ DẠ, MẸ KIẾP!
Dialogue: 0,0:17:07.33,0:17:12.59,top,SIGN RED,0,0,0,,{\an5}VĨNH BIỆT MÃI MÃI!
Dialogue: 0,0:17:07.61,0:17:09.86,main,CORNELIUS,0,0,0,,Thế là mày tính giết tao à?
Dialogue: 0,0:17:09.86,0:17:12.59,main,CORNELIUS,0,0,0,,Hóa ra mày vẫn là một con sát nhân!
Dialogue: 0,0:17:12.59,0:17:14.75,top,CORNELIUS,0,0,0,,Rút cuộc mày vẫn chỉ là đồ vô giá trị!
Dialogue: 0,0:17:14.75,0:17:18.50,top,CORNELIUS,0,0,0,,Tao cá là mày sẽ tiếp tục đi giết người\Nnhư lời mẹ mày bảo thôi!
Dialogue: 0,0:17:13.29,0:17:17.01,main,LILY,0,0,0,,Chúng ta nên chạy thôi. Kệ thây mấy lời nhảm nhí của hắn đi.
Dialogue: 0,0:17:17.18,0:17:20.54,main,MARGARET,0,0,0,,Chắc hắn đang nghĩ bụng: 'Được lắm!\NTrước khi chết tao cũng phải để lại vết tích
Dialogue: 0,0:17:20.54,0:17:23.11,main,MARGARET,0,0,0,,trên người tụi mày, mẹ kiếp! Vĩnh biệt mãi mãi!'
Dialogue: 0,0:17:25.72,0:17:26.33,main,REIN,0,0,0,,Cô bé nhanh quá!
Dialogue: 0,0:17:26.33,0:17:27.56,main,LILY,0,0,0,,Mirabelle, em làm gì thế?!
Dialogue: 0,0:17:27.86,0:17:30.89,main,MIRABELLE,0,0,0,,Cornelius, tôi sẽ nói với mẹ.
Dialogue: 0,0:17:31.87,0:17:36.49,main,MIRABELLE,0,0,0,,Tôi sẽ nói với mẹ rằng tôi không phải kẻ vô giá trị,\Nvà tôi sẽ không đi giết người nữa.
Dialogue: 0,0:17:37.42,0:17:42.24,main,MIRABELLE,0,0,0,,Nếu vì thế mà mẹ bỏ rơi tôi, thì cũng đành chịu thôi.
Dialogue: 0,0:17:42.91,0:17:49.75,main,MIRABELLE,0,0,0,,Tôi sẽ tìm kiếm những đồng đội biết tin tưởng,\Nsát cánh và nỗ lực vì nhau!
Dialogue: 0,0:17:51.59,0:17:52.34,main,REIN,0,0,0,,Mirabelle!
Dialogue: 0,0:17:52.34,0:17:53.38,main,LILY,0,0,0,,Lũ goblin kìa!
Dialogue: 0,0:17:54.05,0:18:00.22,main,MIRABELLE,0,0,0,,Thế nên tôi sẽ không bao giờ dùng sức mạnh này\Nđể đi tước đoạt mạng sống của ai nữa!
Dialogue: 0,0:18:02.65,0:18:04.64,main,MIRABELLE,0,0,0,,Tôi sẽ dùng nó để cứu người!
Dialogue: 0,0:18:15.85,0:18:17.39,main,REIN,0,0,0,,Tuyệt thật.
Dialogue: 0,0:18:18.65,0:18:20.17,main,RIEN,0,0,0,,Một chiêu đã quét sạch toàn bộ rồi.
Dialogue: 0,0:18:22.53,0:18:24.31,main,MIRABELLE,0,0,0,,Đừng sợ, Cornelius.
Dialogue: 0,0:18:25.92,0:18:27.43,main,MIRABELLE,0,0,0,,Tôi rất mạnh.
Dialogue: 0,0:18:30.75,0:18:33.42,main,MIRABELLE,0,0,0,,Cornelius sẽ không bao giờ làm hại mọi người nữa đâu.
Dialogue: 0,0:18:33.91,0:18:35.42,main,MIRABELLE,0,0,0,,Tôi sẽ đảm bảo điều đó.
Dialogue: 0,0:18:35.42,0:18:36.43,main,REIN,0,0,0,,Được rồi.
Dialogue: 0,0:18:36.43,0:18:37.52,main,LILY,0,0,0,,Cảm ơn em nhiều nhé.
Dialogue: 0,0:18:39.01,0:18:42.81,main,REIN,0,0,0,,Mirabelle, em nghĩ thanh kiếm Lefaid\Nsẽ trông như thế nào?
Dialogue: 0,0:18:43.38,0:18:45.61,main,MIRABELLE,0,0,0,,Dạ? Em cũng không biết nữa.
Dialogue: 0,0:18:45.61,0:18:46.64,main,REIN,0,0,0,,Em có muốn xem thử không?
Dialogue: 0,0:18:48.09,0:18:49.98,main,MIRABELLE,0,0,0,,Dạ, em muốn ạ!
Dialogue: 0,0:18:49.98,0:18:52.52,main,REIN,0,0,0,,Thế à? Thế thì anh không cho xem đâu.
Dialogue: 0,0:18:52.52,0:18:54.36,main,REIN,0,0,0,,Hôm nay em hãy cùng Cornelius về nhà đi.
Dialogue: 0,0:18:54.36,0:18:55.09,main,MIRABELLE,0,0,0,,Dạ?
Dialogue: 0,0:18:55.09,0:18:56.32,main,CORNELIUS,0,0,0,,Tại sao chứ?
Dialogue: 0,0:18:56.32,0:18:57.49,main,MARGARET,0,0,0,,Câm mồm đi, đồ mắt lồi.
Dialogue: 0,0:18:57.49,0:19:02.50,main,REIN,0,0,0,,Nói ra cảm xúc thật của mình với mẹ\Ncó thể sẽ cần rất nhiều dũng khí,
Dialogue: 0,0:19:02.50,0:19:05.00,main,REIN,0,0,0,,nhưng anh tin là em làm được.
Dialogue: 0,0:19:05.53,0:19:07.83,main,REIN,0,0,0,,Sau khi nói xong, hãy đến gặp bọn anh nhé.
Dialogue: 0,0:19:07.83,0:19:09.77,main,REIN,0,0,0,,Lúc đó anh sẽ cho em xem thanh kiếm.
Dialogue: 0,0:19:12.29,0:19:16.88,main,MIRABELLE,0,0,0,,Vâng ạ. Em hứa nói chuyện với mẹ xong\Nsẽ lập tức quay lại tìm anh.
Dialogue: 0,0:19:16.88,0:19:19.90,main,REIN,0,0,0,,Hứa rồi đấy nhé. Chúc em may mắn.
Dialogue: 0,0:19:25.40,0:19:28.09,main,MARGARET,0,0,0,,Hóa ra Rein cũng có lúc nói năng đứng đắn ra trò nhỉ.
Dialogue: 0,0:19:28.09,0:19:29.23,main,LILY,0,0,0,,Chuẩn luôn chị nhỉ?
Dialogue: 0,0:19:29.23,0:19:32.48,main,REIN,0,0,0,,Ý hai người là sao chứ? Tôi lúc nào chẳng đứng đắn.
Dialogue: 0,0:19:33.08,0:19:35.13,main,LILY,0,0,0,,Anh ta nói câu đấy mà mặt không biến sắc luôn kìa!
Dialogue: 0,0:19:35.13,0:19:37.23,main,MARGARET,0,0,0,,C-Cậu ta bị chập mạch à?
Dialogue: 0,0:19:37.23,0:19:41.04,main,REIN,0,0,0,,Những lúc then chốt tôi luôn giải quyết êm đẹp mà.
Dialogue: 0,0:19:41.04,0:19:43.20,main,LILY,0,0,0,,Anh vừa hét toáng lên dụ cả lũ goblin tới còn gì!
Dialogue: 0,0:19:43.20,0:19:46.03,main,MARGARET,0,0,0,,Đã thế còn bao nhiêu lần làm trò dở hơi\Nkhông đúng nơi đúng lúc nữa chứ!
Dialogue: 0,0:19:48.84,0:19:50.51,main,LILY,0,0,0,,Eo ơi, phát gớm.
Dialogue: 0,0:19:50.51,0:19:52.79,main,MARGARET,0,0,0,,Đừng bao giờ cười kiểu đó nữa.
Dialogue: 0,0:19:58.07,0:20:01.55,main,REIN,0,0,0,,Nơi này quả đúng là xứng danh\Nnơi ngự trị của một thanh bảo kiếm huyền thoại!
Dialogue: 0,0:20:01.55,0:20:04.89,main,REIN,0,0,0,,Sự phấn khích và hồi hộp\Nlàm tôi thở không ra hơi luôn rồi này!
Dialogue: 0,0:20:05.50,0:20:06.87,main,LILY,0,0,0,,Anh đang thở hổn hển rồi kìa.
Dialogue: 0,0:20:11.78,0:20:13.08,main,LILY,0,0,0,,Chắc chắn là ở đây rồi.
Dialogue: 0,0:20:15.56,0:20:17.07,main,LILY,0,0,0,,Lefaid.
Dialogue: 0,0:20:19.56,0:20:21.89,main,LILY,0,0,0,,Thanh kiếm đó xứng đáng thuộc về anh, anh Rein.
Dialogue: 0,0:20:22.34,0:20:23.45,main,REIN,0,0,0,,Ừm.
Dialogue: 0,0:20:40.55,0:20:44.62,main,REIN,0,0,0,,Vậy đây... chính là Lefaid.
Dialogue: 0,0:20:50.52,0:20:55.35,main,REIN,0,0,0,,Hai người nghĩ tôi đã trưởng thành được bao nhiêu\Ntrong chuyến mạo hiểm này?
Dialogue: 0,0:21:00.45,0:21:06.36,main,LILY,0,0,0,,Ừm, nếu anh nhìn ra thế giới bên ngoài,\Ncó lẽ mọi thứ giờ đây đã rất khác rồi.
Dialogue: 0,0:21:06.67,0:21:10.52,main,MARGARET,0,0,0,,Phải đấy, tôi chắc chắn là vậy.
Dialogue: 0,0:21:10.52,0:21:12.84,main,REIN,0,0,0,,Hai người cũng thấy thế sao?
Dialogue: 0,0:21:12.84,0:21:14.12,main,LILY & MARGARET,0,0,0,,Chắc chắn rồi.
Dialogue: 0,0:21:28.12,0:21:29.97,main,REIN,0,0,0,,Chói mắt quá đi mất!
Dialogue: 0,0:22:07.68,0:22:09.18,top,SIGN,0,0,0,,LILY
Dialogue: 0,0:22:13.35,0:22:14.52,top,SIGN,0,0,0,,CÔ ẤY VỪA GỌI REIN KÌA!!
Dialogue: 0,0:22:14.52,0:22:19.52,top,sign,0,0,0,,{\an3}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:22:20.15,0:22:24.94,top,sign,0,0,0,,{\an1}Biên dịch & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:22:24.98,0:22:29.74,top,sign,0,0,0,,{\an3}Kiểm định chất lượng: Amtia(NOFACE)
Dialogue: 0,0:22:13.35,0:22:14.52,top,SIGN,0,0,0,,CÓ PHẢI CÔ ẤY...
Dialogue: 0,0:22:13.35,0:22:14.52,top,SIGN,0,0,0,,ĐANG NÓI VỀ MÌNH ĐẤY ÀAAA?!
Dialogue: 0,0:22:14.52,0:22:24.98,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:22:35.08,0:22:35.75,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:22:35.75,0:22:46.13,top,SIGN,0,0,0,,{\an4}REIN ĐẬP TAN SÂN KHẤU
Dialogue: 0,0:22:35.75,0:22:38.75,top,SIGN,0,0,0,,CÔ VỪA NÓI VỀ TÔI ĐẤY ĐÚNG KHÔNG?!
Dialogue: 0,0:22:35.75,0:22:38.75,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:38.75,0:22:39.50,top,SIGN,0,0,0,,ĐÚNG KHÔNG HẢ?!
Dialogue: 0,0:22:39.50,0:22:40.25,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:22:40.25,0:22:41.00,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:41.00,0:22:41.75,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:22:41.75,0:22:42.50,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:22:42.50,0:22:43.25,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:43.25,0:22:44.00,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:22:44.00,0:22:44.75,top,SIGN,0,0,0,,ĐÚNG THẾ MÀ, PHẢI KHÔNG?!
Dialogue: 0,0:22:44.75,0:22:45.51,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:22:45.51,0:22:46.13,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:48.05,0:22:50.64,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:22:48.05,0:22:48.80,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:22:48.80,0:22:49.55,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:49.55,0:22:50.30,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:22:50.30,0:22:50.64,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:22:55.39,0:22:59.98,top,SIGN,0,0,0,,XÔNG LÊN
Dialogue: 0,0:22:55.39,0:22:59.98,top,SIGN,0,0,0,,{\an7}LILY ƠI!!
Dialogue: 0,0:22:55.39,0:22:59.98,top,SIGN,0,0,0,,{\an9}LILY ƠI!!
Dialogue: 0,0:22:55.39,0:22:59.98,top,SIGN,0,0,0,,{\an5}TINH THỂ XANH ĐẬP TAN SÂN KHẤU!
Dialogue: 0,0:23:00.12,0:23:02.56,top,SIGN BLACK,0,0,0,,QUÁN TRỌ
Dialogue: 0,0:23:00.12,0:23:02.56,top,SIGN RED,0,0,0,,QUA ĐÊM (KHÔNG KÈM ĂN) 1.980 YÊN
Dialogue: 0,0:23:03.46,0:23:04.85,main,MARGARET,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:23:06.18,0:23:08.18,main,MARGARET,0,0,0,,Hôm nay thời tiết lại đẹp nhỉ?
Dialogue: 0,0:23:14.17,0:23:15.91,main,MARGARET,0,0,0,,À mà này.
Dialogue: 0,0:23:27.99,0:23:29.55,main,LILY,0,0,0,,Bộ đang chơi ú òa đấy à?

