Dialogue: 0,0:00:03.29,0:00:06.17,italics,NARRATION,0,0,0,,Điểm hẹn!
Dialogue: 0,0:00:06.97,0:00:08.33,main,REIN,0,0,0,,Cô ấy đằng kia rồi!
Dialogue: 0,0:00:08.33,0:00:12.73,main,REIN,0,0,0,,Này, Lily! Lily ơi!
Dialogue: 0,0:00:13.04,0:00:14.11,main,REIN,0,0,0,,Hở?
Dialogue: 0,0:00:14.11,0:00:16.55,main,REIN,0,0,0,,Không phải cô ấy rồi. Đó là một đứa nhóc tiểu học mà.
Dialogue: 0,0:00:17.49,0:00:22.50,main,REIN,0,0,0,,Xin lỗi cháu nhé. Người chú đang đợi cũng ăn mặc y chang học sinh tiểu học vậy.
Dialogue: 0,0:00:22.50,0:00:24.01,main,LILY,0,0,0,,Hứ!
Dialogue: 0,0:00:24.31,0:00:26.86,main,LILY,0,0,0,,Rein! Nãy giờ anh trốn ở xó này đấy à?
Dialogue: 0,0:00:26.86,0:00:29.69,main,LILY,0,0,0,,Sao anh không đứng ở điểm hẹn hả?
Dialogue: 0,0:00:29.69,0:00:31.11,main,LILY,0,0,0,,Em tìm anh mỏi cả mắt rồi đấy.
Dialogue: 0,0:00:32.46,0:00:35.05,main,LILY,0,0,0,,Ủa? Không phải anh ấy. Chỉ là một đống bùn đất thôi.
Dialogue: 0,0:00:35.43,0:00:38.90,main,LILY,0,0,0,,Xin lỗi nhé. Tại màu của mày nhìn giống hệt màu của Rein ấy mà.
Dialogue: 0,0:00:39.42,0:00:42.33,main,REIN,0,0,0,,Tôi xin lỗi rồi mà, được chưa? Lỗi của tôi.
Dialogue: 0,0:00:56.97,0:00:59.58,top,SIGN,0,0,0,,MA PHÁP SƯ BAN PHƯỚC CHEAT BỊ ĐUỔI VIỆC\NTẬN HƯỞNG CUỘC SỐNG MỚI
Dialogue: 0,0:02:12.98,0:02:17.99,top,EPTITLE,0,0,0,,TẬP 3: KHI TÔI CÙNG NGƯỜI BẠN TỪNG TỰ KỶ SUỐT HAI NĂM ĐI XIN LỖI,\NBẤT NGỜ ĐƯỢC MỜI MÓN TÁO HÌNH THỎ, CHẮC LÀ ĐÃ ĐƯỢC THA THỨ RỒI NHỈ.
Dialogue: 0,0:02:18.85,0:02:20.45,main,MARGARET,0,0,0,,Lâu rồi không gặp nhỉ.
Dialogue: 0,0:02:20.82,0:02:23.24,main,MARGARET,0,0,0,,Trông cậu có vẻ đang tận hưởng cuộc sống vui vẻ gớm nhỉ.
Dialogue: 0,0:02:23.49,0:02:25.87,main,LILY,0,0,0,,M-Margaret...
Dialogue: 0,0:02:26.09,0:02:31.00,main,MARGARET,0,0,0,,Cậu đã hoàn toàn xóa sạch ký ức về Gadressa khỏi đầu óc rồi sao?
Dialogue: 0,0:02:31.60,0:02:32.93,main,LILY,0,0,0,,Tôi...
Dialogue: 0,0:02:35.84,0:02:38.17,main,REIN,0,0,0,,Có chuyện gì thế Lily? Cậu quen cô ấy à?
Dialogue: 0,0:02:38.61,0:02:41.22,main,LILY,0,0,0,,C-Cô ấy là...
Dialogue: 0,0:02:41.90,0:02:43.26,main,MARGARET,0,0,0,,Vậy ra anh là Rein?
Dialogue: 0,0:02:43.51,0:02:45.72,main,REIN,0,0,0,,Sao cô biết tên tôi?
Dialogue: 0,0:02:45.96,0:02:50.25,main,MARGARET,0,0,0,,Bọn Nanh Vuốt Dã Thú đang lùng sục ráo riết khắp nơi tìm Rein và Lily đấy.
Dialogue: 0,0:02:50.25,0:02:51.96,main,MARGARET,0,0,0,,Cả cái thành phố này ai nấy đều biết chuyện đó rồi.
Dialogue: 0,0:02:52.60,0:02:54.63,main,REIN,0,0,0,,Nanh Vuốt Dã Thú sao?
Dialogue: 0,0:02:54.63,0:02:57.23,main,REIN,0,0,0,,Sao cô lại tốt bụng báo cho bọn tôi biết chuyện đó?
Dialogue: 0,0:02:57.56,0:03:00.69,main,MARGARET,0,0,0,,Chẳng phải anh nên quan tâm lo lắng cho Lily hơn sao?
Dialogue: 0,0:03:01.12,0:03:02.66,main,MARGARET,0,0,0,,Cậu ta đang run lẩy bẩy kìa.
Dialogue: 0,0:03:03.01,0:03:04.66,main,MARGARET,0,0,0,,Hai người không phải là bạn bè đồng đội của nhau à?
Dialogue: 0,0:03:05.04,0:03:07.97,main,REIN,0,0,0,,Lily, em có sao không? Xảy ra chuyện gì thế?
Dialogue: 0,0:03:08.62,0:03:10.53,main,LILY,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:03:10.53,0:03:13.10,main,MARGARET,0,0,0,,Dù vậy thì anh cũng nên cẩn thận đi.
Dialogue: 0,0:03:14.25,0:03:20.09,main,MARGARET,0,0,0,,Có ngày cậu ta sẽ đâm sau lưng phản bội anh vào thời khắc sinh tử rồi khiến anh mất mạng đấy.
Dialogue: 0,0:03:20.09,0:03:21.34,main,REIN,0,0,0,,Gì cơ?!
Dialogue: 0,0:03:21.82,0:03:24.04,main,MARGARET,0,0,0,,Thôi, hẹn gặp lại sau nhé.
Dialogue: 0,0:03:25.13,0:03:31.85,main,MARGARET,0,0,0,,Lily, tôi hy vọng lần tới gặp lại trông cậu sẽ thê thảm và khốn khổ hơn bây giờ.
Dialogue: 0,0:03:32.43,0:03:34.04,main,REIN,0,0,0,,Cô ta bị làm sao thế nhỉ?
Dialogue: 0,0:03:34.74,0:03:37.42,main,REIN,0,0,0,,Lily, tạm thời chúng ta cứ quay về công hội trước đã.
Dialogue: 0,0:03:39.41,0:03:41.46,main,REIN,0,0,0,,Lạ thật đấy.
Dialogue: 0,0:03:41.46,0:03:46.12,main,REIN,0,0,0,,Tôi cứ tưởng bọn Nanh Vuốt Dã Thú đang lùng sục bọn mình khắp mọi ngóc ngách cơ chứ,
Dialogue: 0,0:03:46.12,0:03:47.93,main,REIN,0,0,0,,nhưng tình hình ngoài kia trông chẳng có vẻ gì là như vậy cả.
Dialogue: 0,0:03:48.62,0:03:52.07,main,REIN,0,0,0,,Chắc con bé Margaret đó nói dối chúng ta rồi.
Dialogue: 0,0:03:52.81,0:03:56.36,main,NINA,0,0,0,,Oa, hai người thực sự đã hạ gục một con rồng thật sao!
Dialogue: 0,0:03:57.93,0:03:59.03,main,NINA,0,0,0,,Lily?
Dialogue: 0,0:03:59.67,0:04:03.42,main,REIN,0,0,0,,Nina này, em có nghe ngóng được tin tức gì về bọn Nanh Vuốt Dã Thú không?
Dialogue: 0,0:04:03.42,0:04:06.72,main,NINA,0,0,0,,À, em nghĩ là hai người an toàn rồi đấy ạ.
Dialogue: 0,0:04:07.18,0:04:08.06,main,REIN,0,0,0,,Hở?
Dialogue: 0,0:04:08.06,0:04:12.56,main,ELSIE,0,0,0,,Bọn Nanh Vuốt Dã Thú từng tính bắt cóc hai người thật.
Dialogue: 0,0:04:12.82,0:04:14.61,main,REIN,0,0,0,,Bắt cóc bọn tôi á?
Dialogue: 0,0:04:14.61,0:04:17.82,main,ELSIE,0,0,0,,Nhưng công hội của chúng hiện giờ đang rơi vào tình cảnh đại loạn rồi.
Dialogue: 0,0:04:18.17,0:04:20.56,main,ELSIE,0,0,0,,Vũ khí và áo giáp của chúng bị suy giảm sức mạnh trầm trọng,
Dialogue: 0,0:04:20.56,0:04:26.44,main,ELSIE,0,0,0,,đã thế một kẻ sừng sỏ như Cornelius lại bị một mạo hiểm giả hạng D như anh đánh bại tơi bời.
Dialogue: 0,0:04:27.15,0:04:29.45,main,NINA,0,0,0,,Anh chắc chắn phải mạnh khủng khiếp lắm đúng không, Rein?
Dialogue: 0,0:04:29.70,0:04:31.89,main,REIN,0,0,0,,Là do ma pháp cường hóa của tôi mạnh thôi.
Dialogue: 0,0:04:31.89,0:04:34.36,main,ELSIE,0,0,0,,Chà, chuyện đó tạo ra chấn động lớn lắm đấy.
Dialogue: 0,0:04:34.36,0:04:38.85,main,ELSIE,0,0,0,,Cả đống thành viên đang lũ lượt rời bỏ Nanh Vuốt Dã Thú để đầu quân cho các công hội khác kìa.
Dialogue: 0,0:04:39.21,0:04:44.47,main,ELSIE,0,0,0,,Nói cách khác, bây giờ chúng bận tối mắt tối mũi, chẳng còn tâm trí đâu mà đi tìm hai người nữa.
Dialogue: 0,0:04:44.47,0:04:46.83,main,LILY,0,0,0,,Vậy thì chẳng còn gì phải lo lắng nữa rồi.
Dialogue: 0,0:04:48.25,0:04:50.22,main,LILY,0,0,0,,Nếu vậy thì em xin phép về phòng nghỉ ngơi trước đây ạ.
Dialogue: 0,0:04:50.54,0:04:54.06,main,ELSIE,0,0,0,,Dù sao thì em cũng nên cẩn thận đấy nhé.
Dialogue: 0,0:04:54.06,0:04:54.74,main,LILY,0,0,0,,Em biết rồi ạ.
Dialogue: 0,0:04:57.63,0:04:59.60,main,REIN,0,0,0,,Tôi muốn hỏi cô một chuyện này.
Dialogue: 0,0:05:00.01,0:05:00.86,main,ELSIE,0,0,0,,Chuyện gì thế?
Dialogue: 0,0:05:00.86,0:05:03.74,main,REIN,0,0,0,,Cô có biết chuyện gì đã từng xảy ra ở Gadressa không?
Dialogue: 0,0:05:06.63,0:05:08.24,main,ELSIE,0,0,0,,Ai kể cho anh nghe về chuyện đó thế?
Dialogue: 0,0:05:08.49,0:05:11.37,main,REIN,0,0,0,,Là Margaret, cô gái dắt theo một chú chó ấy.
Dialogue: 0,0:05:11.64,0:05:13.53,main,ELSIE,0,0,0,,Lẽ nào là...
Dialogue: 0,0:05:13.53,0:05:15.25,main,NINA,0,0,0,,Đúng vậy, chính là em ấy.
Dialogue: 0,0:05:16.81,0:05:18.80,main,ELSIE,0,0,0,,Con bé là người sống sót duy nhất.
Dialogue: 0,0:05:18.80,0:05:19.75,main,REIN,0,0,0,,Người sống sót sao?
Dialogue: 0,0:05:20.27,0:05:23.51,main,NINA,0,0,0,,Gadressa là chiến trường cuối cùng nơi Lily từng chiến đấu.
Dialogue: 0,0:05:24.49,0:05:26.79,main,NINA,0,0,0,,Đó chính là lý do khiến em ấy không thể cầm kiếm chiến đấu được nữa.
Dialogue: 0,0:05:29.03,0:05:30.76,top,SIGN,0,0,0,,2 NĂM TRƯỚC
Dialogue: 0,0:05:32.49,0:05:35.02,flashback,MARGARET SISTER,0,0,0,,Chị vừa nhận được một nhiệm vụ mới toanh cho cả nhóm này mọi người ơi.
Dialogue: 0,0:05:35.02,0:05:36.64,flashback,MARGARET,0,0,0,,Nhiệm vụ mới á chị!
Dialogue: 0,0:05:37.37,0:05:39.90,flashback,ADVENTURER A,0,0,0,,Nghiêm túc đấy chứ? Chúng ta còn chưa kịp nghỉ ngơi lấy lại sức mà.
Dialogue: 0,0:05:40.42,0:05:42.52,flashback,ADVENTURER C,0,0,0,,Làm như anh muốn nghỉ ngơi lắm không bằng ấy.
Dialogue: 0,0:05:42.80,0:05:46.28,flashback,ADVENTURER B,0,0,0,,Tốt nhất đó phải là một nhiệm vụ độ khó cao đấy nhé.
Dialogue: 0,0:05:46.50,0:05:49.91,flashback,MARGARET SISTER,0,0,0,,Chị đây có bao giờ chọn mấy cái nhiệm vụ cỏn con dở hơi đâu?
Dialogue: 0,0:05:54.72,0:05:58.92,flashback,LILY,0,0,0,,Vậy chắc chắn độ khó phải là cấp cao nhất rồi.
Dialogue: 0,0:05:59.45,0:06:00.62,flashback,MARGARET SISTER,0,0,0,,Đương nhiên rồi cưng.
Dialogue: 0,0:06:01.23,0:06:05.38,flashback,ADVENTURER A,0,0,0,,Di Tích Hỏa Long tại Gadressa, Vương Quốc của loài Rồng sao?
Dialogue: 0,0:06:05.68,0:06:09.76,flashback,ADVENTURER C,0,0,0,,Vậy mục tiêu của chúng ta chắc chắn là kho báu ở tầng sâu nhất rồi.
Dialogue: 0,0:06:09.76,0:06:13.51,flashback,ADVENTURER B,0,0,0,,Từ trước tới giờ chưa từng có ai đặt chân xuống được tầng đáy đúng không?
Dialogue: 0,0:06:13.98,0:06:17.16,flashback,MARGARET SISTER,0,0,0,,Nghe đồn ở đó có một con rồng cực kỳ hung hãn và hùng mạnh.
Dialogue: 0,0:06:17.16,0:06:18.49,flashback,MARGARET SISTER,0,0,0,,Em thấy thế nào hả Lily?
Dialogue: 0,0:06:19.27,0:06:21.52,flashback,MARGARET,0,0,0,,Gặp lại sau nhé chị!
Dialogue: 0,0:06:20.42,0:06:21.52,flashback,LILY,0,0,0,,Đối với chúng ta...
Dialogue: 0,0:06:23.14,0:06:25.93,flashback,LILY,0,0,0,,chuyện đó chỉ là chuyện nhỏ như con thỏ thôi!
Dialogue: 0,0:06:57.06,0:07:00.63,flashback,MARGARET,0,0,0,,Chị gái em là mạnh nhất quả đất đúng không chị?
Dialogue: 0,0:07:05.05,0:07:06.28,flashback,MARGARET,0,0,0,,Lily!
Dialogue: 0,0:07:06.28,0:07:07.85,flashback,MARGARET,0,0,0,,Chị gái em đâu rồi?
Dialogue: 0,0:07:08.25,0:07:10.86,flashback,MARGARET,0,0,0,,Tại sao chị ấy vẫn chưa quay về?
Dialogue: 0,0:07:11.74,0:07:14.23,flashback,LILY,0,0,0,,Chị xin lỗi, Margaret...
Dialogue: 0,0:07:15.23,0:07:16.62,flashback,LILY,0,0,0,,Chị thực sự xin lỗi em...
Dialogue: 0,0:07:18.11,0:07:21.62,flashback,LILY,0,0,0,,Tất cả mọi người... đều đã hy sinh hết rồi.
Dialogue: 0,0:07:23.04,0:07:23.85,flashback,MARGARET,0,0,0,,Chị nói cái gì cơ?!
Dialogue: 0,0:07:24.29,0:07:26.30,flashback,LILY,0,0,0,,Ngay cả chị gái của em... cũng không qua khỏi.
Dialogue: 0,0:07:27.51,0:07:28.94,flashback,LILY,0,0,0,,Chị xin lỗi...
Dialogue: 0,0:07:29.99,0:07:31.36,flashback,MARGARET,0,0,0,,Tại sao chứ?!
Dialogue: 0,0:07:31.36,0:07:34.04,flashback,MARGARET,0,0,0,,Tại sao chỉ có độc một mình chị sống sót trở về hả?!
Dialogue: 0,0:07:34.04,0:07:35.43,flashback,MARGARET,0,0,0,,Ước gì...
Dialogue: 0,0:07:35.74,0:07:39.21,flashback,MARGARET,0,0,0,,Ước gì người phải chết ngày hôm đó là chị chứ không phải chị gái em!
Dialogue: 0,0:07:44.19,0:07:45.51,main,LILY,0,0,0,,Chị xin lỗi...
Dialogue: 0,0:07:47.26,0:07:48.57,main,LILY,0,0,0,,Chị ngàn lần xin lỗi em...
Dialogue: 0,0:07:50.49,0:07:51.67,main,LILY,0,0,0,,Chị thực sự xin lỗi...
Dialogue: 0,0:07:53.44,0:07:57.45,main,REIN,0,0,0,,Tổ đội của Lily năm xưa đã cố gắng tìm kiếm thứ gì ở Gadressa thế?
Dialogue: 0,0:07:59.35,0:08:05.96,top,SIGN,0,0,0,,LEFAID
Dialogue: 0,0:07:57.79,0:08:00.42,main,ELSIE,0,0,0,,Thanh kiếm huyền thoại Lefaid, Quang Kiếm của Long Đế.
Dialogue: 0,0:08:01.13,0:08:05.54,main,ELSIE,0,0,0,,Đó là một thanh kiếm rực sáng đầy uy lực, tương truyền sở hữu sức mạnh tối thượng của loài rồng.
Dialogue: 0,0:08:06.25,0:08:07.86,main,REIN,0,0,0,,Thì ra là vì lý do đó...
Dialogue: 0,0:08:09.28,0:08:11.41,flashback,LILY,0,0,0,,Em biết một nơi...
Dialogue: 0,0:08:11.82,0:08:15.72,flashback,LILY,0,0,0,,nơi mà chúng ta có thể tìm thấy một thanh kiếm đủ sức chịu đựng được ma pháp cường hóa của anh.
Dialogue: 0,0:08:15.72,0:08:18.97,main,REIN,0,0,0,,Nhưng lúc đó cô ấy nhất quyết không chịu hé răng nói thêm lời nào.
Dialogue: 0,0:08:20.22,0:08:22.98,main,ELSIE,0,0,0,,Con bé vẫn chưa thể đối diện với quá khứ đau thương đó.
Dialogue: 0,0:08:25.68,0:08:26.36,main,ELSIE,0,0,0,,Lily.
Dialogue: 0,0:08:26.85,0:08:29.23,main,LILY,0,0,0,,Em đổi ý rồi. Em muốn ra ngoài một lát.
Dialogue: 0,0:08:29.48,0:08:30.97,main,REIN,0,0,0,,Tôi đi cùng em nhé.
Dialogue: 0,0:08:31.29,0:08:32.39,main,LILY,0,0,0,,Không cần đâu ạ.
Dialogue: 0,0:08:32.83,0:08:34.31,main,ELSIE,0,0,0,,Em không thể đi một mình được đâu.
Dialogue: 0,0:08:34.31,0:08:37.81,main,ELSIE,0,0,0,,Lỡ như tàn dư của Nanh Vuốt Dã Thú lại tới gây sự thì sao.
Dialogue: 0,0:08:40.01,0:08:41.45,main,REIN,0,0,0,,Chúng ta đang đi đâu thế?
Dialogue: 0,0:08:42.00,0:08:47.29,main,REIN,0,0,0,,Chúng ta đi đâu thế hả? Này, đi đâu thế em?
Dialogue: 0,0:08:47.52,0:08:50.37,main,REIN,0,0,0,,Này, này, này, Lily ơi.
Dialogue: 0,0:08:48.35,0:08:49.59,main,LILY,0,0,0,,Anh im lặng giùm em đi.
Dialogue: 0,0:08:50.37,0:08:52.59,main,REIN,0,0,0,,Li-Li-Li-Li-Li—
Dialogue: 0,0:08:52.59,0:08:55.39,main,REIN,0,0,0,,Ủa, đây là nhà của Margaret mà.
Dialogue: 0,0:08:58.22,0:09:01.56,main,REIN,0,0,0,,Sao thế em? Em có chuyện muốn nói với cô ấy à?
Dialogue: 0,0:09:02.12,0:09:06.61,main,LILY,0,0,0,,Rein, hai người họ đã kể cho anh nghe về chuyện ở Gadressa rồi đúng không?
Dialogue: 0,0:09:06.61,0:09:07.94,main,REIN,0,0,0,,Sao em biết được hay vậy?
Dialogue: 0,0:09:08.18,0:09:10.69,main,LILY,0,0,0,,Tường của công hội cách âm kém lắm.
Dialogue: 0,0:09:11.67,0:09:15.70,main,LILY,0,0,0,,Em hoàn toàn không còn nhớ bất cứ điều gì về chuyện xảy ra hai năm trước cả.
Dialogue: 0,0:09:16.08,0:09:17.20,main,REIN,0,0,0,,Không nhớ một chút nào sao?
Dialogue: 0,0:09:17.45,0:09:23.06,main,LILY,0,0,0,,Ngoại trừ nỗi sợ hãi tột cùng và cảm giác bất lực chưa từng trải qua trong đời ra, em chẳng nhớ gì hết.
Dialogue: 0,0:09:24.13,0:09:27.31,main,LILY,0,0,0,,Đến khi tỉnh lại, em đã nằm trên giường bệnh và đang được trị thương rồi.
Dialogue: 0,0:09:27.72,0:09:30.82,main,LILY,0,0,0,,Đó cũng là lúc em bàng hoàng biết tin toàn bộ đồng đội của mình đều đã hy sinh.
Dialogue: 0,0:09:32.21,0:09:37.07,main,LILY,0,0,0,,Chắc chắn là em đã hèn nhát bỏ rơi họ để tháo chạy một mình rồi.
Dialogue: 0,0:09:37.42,0:09:41.90,main,REIN,0,0,0,,Đó chỉ là suy nghĩ chủ quan của em thôi mà, đúng không? Sự thật có thể hoàn toàn khác đấy.
Dialogue: 0,0:09:46.73,0:09:53.75,main,LILY,0,0,0,,Em luôn cảm thấy mình bắt buộc phải quay trở lại Gadressa để làm sáng tỏ toàn bộ sự thật.
Dialogue: 0,0:09:54.43,0:09:58.97,main,LILY,0,0,0,,Em xin lỗi vì đã lôi anh vào chuyện riêng đầy rắc rối của em nhé, Rein.
Dialogue: 0,0:09:59.70,0:10:02.73,main,LILY,0,0,0,,Em thực sự không hề muốn chuyện này xảy ra chút nào,
Dialogue: 0,0:10:03.07,0:10:05.81,main,LILY,0,0,0,,nhưng đó là thanh kiếm duy nhất mà em có thể nghĩ ra
Dialogue: 0,0:10:05.81,0:10:10.46,main,LILY,0,0,0,,đủ mạnh để chịu đựng được ma pháp cường hóa của anh, nên là...
Dialogue: 0,0:10:10.46,0:10:11.96,main,REIN,0,0,0,,Em đừng bận tâm về chuyện đó làm gì.
Dialogue: 0,0:10:12.25,0:10:16.20,main,REIN,0,0,0,,Em có thể tới đó để tìm ra sự thật, còn tôi sẽ tới đó để lấy thanh kiếm về.
Dialogue: 0,0:10:16.72,0:10:21.18,main,REIN,0,0,0,,Có ma pháp cường hóa của tôi bảo bọc rồi, cả hai chúng ta chắc chắn sẽ không ai phải chết cả.
Dialogue: 0,0:10:22.50,0:10:23.71,main,LILY,0,0,0,,Anh nói đúng.
Dialogue: 0,0:10:24.34,0:10:28.85,main,LILY,0,0,0,,Trước khi khởi hành, em muốn nói chuyện đàng hoàng với người em gái còn sống sót.
Dialogue: 0,0:10:29.77,0:10:31.36,main,REIN,0,0,0,,Vậy thì em vào đi.
Dialogue: 0,0:10:31.69,0:10:32.98,main,REIN,0,0,0,,Dũng cảm lên nào.
Dialogue: 0,0:10:51.71,0:10:53.81,main,LILY,0,0,0,,Ủa? Con bé không có ở nhà.
Dialogue: 0,0:10:56.54,0:10:59.88,main,BARRIUS,0,0,0,,Ta nghe danh cô là một thành viên đầy triển vọng của Khiên Đế Quốc.
Dialogue: 0,0:11:00.17,0:11:03.47,main,BARRIUS,0,0,0,,Ta là Barrius, hội trưởng của công hội Nanh Vuốt Dã Thú.
Dialogue: 0,0:11:03.47,0:11:06.89,main,BARRIUS,0,0,0,,Cô chủ động muốn gặp ta, chắc hẳn là muốn chuyển sang công hội của ta đúng không?
Dialogue: 0,0:11:06.89,0:11:11.40,main,BARRIUS,0,0,0,,Bọn ta rất hoan nghênh cô. Thậm chí sẽ dành cho cô những đãi ngộ đặc biệt nhất.
Dialogue: 0,0:11:11.85,0:11:14.15,main,MARGARET,0,0,0,,Đó không phải là mục đích tôi tới đây.
Dialogue: 0,0:11:15.06,0:11:15.98,main,BARRIUS,0,0,0,,Hử?
Dialogue: 0,0:11:16.33,0:11:20.96,main,MARGARET,0,0,0,,Các người không có ý định giết chết Lily và Rein sao?
Dialogue: 0,0:11:23.33,0:11:24.25,main,BARRIUS,0,0,0,,Gì cơ?
Dialogue: 0,0:11:25.49,0:11:28.83,main,MARGARET,0,0,0,,Các người không muốn giết chúng à?
Dialogue: 0,0:11:28.83,0:11:34.25,main,MARGARET,0,0,0,,Hay là sự lùng sục nửa vời của đám thuộc cấp và thành viên bang hội đang cản chân các người?
Dialogue: 0,0:11:34.48,0:11:36.00,main,MARGARET,0,0,0,,Tình hình là như thế đúng không?
Dialogue: 0,0:11:38.18,0:11:41.88,main,MARGARET,0,0,0,,Theo những gì tôi quan sát, có vẻ như các người đang thiếu thốn nhân lực trầm trọng.
Dialogue: 0,0:11:42.32,0:11:44.89,main,MARGARET,0,0,0,,Xem ra tôi đã kỳ vọng quá nhiều vào các người rồi.
Dialogue: 0,0:11:45.24,0:11:51.14,main,MARGARET,0,0,0,,Tôi sẵn lòng giúp các người một tay nếu các người có thể khiến Lily phải sống trong khốn khổ tủi nhục.
Dialogue: 0,0:11:51.38,0:11:53.11,main,BARRIUS,0,0,0,,C-Cái gì cơ?!
Dialogue: 0,0:11:53.11,0:11:55.87,main,MARGARET,0,0,0,,Lily vừa rồi đã mỉm cười,
Dialogue: 0,0:11:56.20,0:11:59.53,main,MARGARET,0,0,0,,cứ như thể cậu ta đã hoàn toàn quên sạch những tội lỗi trong quá khứ vậy.
Dialogue: 0,0:11:59.76,0:12:02.07,main,MARGARET,0,0,0,,Tôi tuyệt đối không cho phép chuyện đó xảy ra.
Dialogue: 0,0:12:03.35,0:12:09.08,main,MARGARET,0,0,0,,Xương tàn của chị gái tôi vẫn đang ngày đêm phơi mình dưới những cơn gió lạnh buốt của tàn tích đó kìa.
Dialogue: 0,0:12:09.53,0:12:14.83,main,MARGARET,0,0,0,,Làm sao cậu ta có thể thản nhiên mỉm cười và tiếp tục làm mạo hiểm giả sau khi đã bỏ mặc đồng đội chết thảm chứ?!
Dialogue: 0,0:12:15.31,0:12:17.85,main,MARGARET,0,0,0,,Rốt cuộc cậu ta bị cái quái gì thế hả?!
Dialogue: 0,0:12:18.59,0:12:22.27,main,MARGARET,0,0,0,,Tuyệt đối không bao giờ được phép để Lily Flambert tiếp tục làm mạo hiểm giả thêm một ngày nào nữa.
Dialogue: 0,0:12:22.98,0:12:27.45,main,MARGARET,0,0,0,,Nếu không, tôi làm sao còn mặt mũi nào để đối diện với người chị đã khuất của mình chứ!
Dialogue: 0,0:12:30.81,0:12:36.30,main,BARRIUS,0,0,0,,Ta cũng ghét cay ghét đắng con nhỏ đó, nhưng Nanh Vuốt Dã Thú hiện đang ngập trong đống rắc rối to đùng rồi.
Dialogue: 0,0:12:36.30,0:12:42.12,main,BARRIUS,0,0,0,,À phải rồi. Cô có biết ma pháp sư cường hóa nào đủ mạnh để thay thế thằng nhóc Rein không?
Dialogue: 0,0:12:42.12,0:12:43.65,main,LILY,0,0,0,,Xin phép làm phiền nhé.
Dialogue: 0,0:12:52.88,0:12:55.22,main,MARGARET,0,0,0,,Chà, xin chào Lily.
Dialogue: 0,0:12:55.87,0:12:59.53,main,MARGARET,0,0,0,,Điều gì khiến cậu nghĩ rằng mình có tư cách tới đây gặp tôi một lần nữa thế hả?
Dialogue: 0,0:12:59.53,0:13:00.75,main,REIN,0,0,0,,Cô đâu cần phải nói những lời cay nghiệt như thế.
Dialogue: 0,0:13:00.75,0:13:02.88,main,MARGARET,0,0,0,,Tôi không nói chuyện với anh.
Dialogue: 0,0:13:02.88,0:13:04.33,main,LILY,0,0,0,,Không sao đâu anh Rein.
Dialogue: 0,0:13:05.11,0:13:07.48,main,LILY,0,0,0,,Tôi muốn nói chuyện rõ ràng với cậu, Margaret.
Dialogue: 0,0:13:09.76,0:13:10.77,main,MARGARET,0,0,0,,Vào nhà đi.
Dialogue: 0,0:13:10.77,0:13:15.64,main,MARGARET,0,0,0,,Tôi có thể pha trà cho hai người, nhưng đừng mong chờ bất cứ sự tiếp đón tử tế nào khác từ tôi.
Dialogue: 0,0:13:17.66,0:13:19.65,main,REIN,0,0,0,,Lily, em ổn chứ?
Dialogue: 0,0:13:20.20,0:13:23.94,main,LILY,0,0,0,,Khi nghĩ tới những nỗi đau mà Margaret phải chịu đựng, chuyện này cũng là điều đương nhiên thôi mà.
Dialogue: 0,0:13:37.35,0:13:40.61,main,MARGARET,0,0,0,,Uống đi. Tôi không bỏ độc vào trong đó đâu.
Dialogue: 0,0:13:42.27,0:13:46.01,main,LILY,0,0,0,,Cảm ơn cậu đã mời bọn tôi vào nhà nhé, Margaret.
Dialogue: 0,0:13:46.25,0:13:48.12,main,MARGARET,0,0,0,,Hai người muốn cái gì?
Dialogue: 0,0:13:48.12,0:13:50.51,main,MARGARET,0,0,0,,Nói nhanh cho xong chuyện đi.
Dialogue: 0,0:13:51.30,0:13:53.79,main,LILY,0,0,0,,Tôi sẽ cùng Rein tới Gadressa.
Dialogue: 0,0:13:54.69,0:13:57.64,main,LILY,0,0,0,,Tôi muốn tới đó để xác nhận lại toàn bộ những gì đã xảy ra trong quá khứ.
Dialogue: 0,0:13:57.64,0:13:59.99,main,MARGARET,0,0,0,,Xác nhận những gì đã xảy ra sao?
Dialogue: 0,0:14:00.36,0:14:03.53,main,MARGARET,0,0,0,,Chẳng phải chính cậu đã bỏ rơi chị gái tôi rồi tháo chạy thục mạng hay sao?
Dialogue: 0,0:14:03.93,0:14:09.78,main,LILY,0,0,0,,Có lẽ đúng là như vậy thật, nhưng dù thế nào đi nữa, tôi cũng muốn biết rõ sự thật.
Dialogue: 0,0:14:10.59,0:14:15.04,main,LILY,0,0,0,,Tôi cảm thấy vô cùng hổ thẹn vì trước đây chưa từng đưa ra được một lời giải thích thấu đáo cho cậu.
Dialogue: 0,0:14:15.35,0:14:16.33,main,LILY,0,0,0,,Tôi thực sự xin lỗi cậu.
Dialogue: 0,0:14:19.81,0:14:26.85,main,LILY,0,0,0,,Tôi sẽ quay lại Gadressa để hoàn thành trọn vẹn trách nhiệm của một đội trưởng.
Dialogue: 0,0:14:29.08,0:14:33.18,main,MARGARET,0,0,0,,Tôi hiểu rồi. Ra là giờ cậu nghĩ như thế đấy à?
Dialogue: 0,0:14:34.53,0:14:39.06,main,MARGARET,0,0,0,,Từ trước tới giờ tôi đã đối xử rất cay nghiệt tệ bạc với cậu đấy.
Dialogue: 0,0:14:39.71,0:14:43.29,main,LILY,0,0,0,,Cậu đừng bận lòng về chuyện đó. Tôi xứng đáng nhận tất cả những lời trách móc đó mà.
Dialogue: 0,0:14:47.21,0:14:52.85,main,MARGARET,0,0,0,,Nếu đã như vậy, Lily và Rein, liệu tôi có thể tham gia cùng hai người được không?
Dialogue: 0,0:14:53.76,0:14:55.65,main,MARGARET,0,0,0,,Tôi thừa biết chuyến đi này nguy hiểm đến mức nào.
Dialogue: 0,0:14:56.20,0:15:01.48,main,MARGARET,0,0,0,,Nhưng đây cũng là trách nhiệm của tôi. Tôi phải làm điều này, vì người chị đã khuất của mình.
Dialogue: 0,0:15:02.02,0:15:04.53,main,MARGARET,0,0,0,,Tôi không thể nào nguôi ngoai được mối hận thù dành cho Lily,
Dialogue: 0,0:15:05.29,0:15:09.97,main,MARGARET,0,0,0,,nhưng tôi muốn tận mắt chứng kiến khoảnh khắc cuối cùng của chị gái mình.
Dialogue: 0,0:15:10.24,0:15:11.84,main,REIN,0,0,0,,Chúng tôi rất hoan nghênh cô cùng tham gia.
Dialogue: 0,0:15:13.91,0:15:18.70,main,LILY,0,0,0,,Được rồi. Margaret, cậu là một mạo hiểm giả hạng B đúng không?
Dialogue: 0,0:15:19.31,0:15:21.74,main,LILY,0,0,0,,Có cậu đi cùng thì chúng tôi sẽ yên tâm hơn rất nhiều.
Dialogue: 0,0:15:22.37,0:15:24.10,main,MARGARET,0,0,0,,Cảm ơn hai người.
Dialogue: 0,0:15:27.25,0:15:30.05,main,MARGARET,0,0,0,,Trà nguội mất rồi.
Dialogue: 0,0:15:30.05,0:15:31.49,main,MARGARET,0,0,0,,Để tôi hâm nóng lại cho nhé.
Dialogue: 0,0:15:40.72,0:15:42.38,main,REIN,0,0,0,,Cùng nhau cố gắng hết sức nhé, Lily.
Dialogue: 0,0:15:42.38,0:15:45.84,main,LILY,0,0,0,,Vâng ạ. Chúng ta nhất định phải đưa Margaret trở về an toàn.
Dialogue: 0,0:15:46.22,0:15:50.13,main,REIN,0,0,0,,Em nói cái gì thế? Tất cả chúng ta đều sẽ bình an trở về mà.
Dialogue: 0,0:15:54.17,0:15:55.13,main,MARGARET,0,0,0,,Lily à...
Dialogue: 0,0:15:56.01,0:16:00.56,main,MARGARET,0,0,0,,Thời khắc để cậu phải bỏ mạng tại Gadressa cuối cùng cũng đã điểm rồi.
Dialogue: 0,0:16:01.64,0:16:06.46,main,MARGARET,0,0,0,,Tôi đã rèn luyện cật lực để trở nên mạnh mẽ chỉ với hy vọng một ngày nào đó cậu sẽ phải đền mạng.
Dialogue: 0,0:16:08.12,0:16:09.29,main,MARGARET,0,0,0,,Hoàn toàn chỉ bằng chính thực lực của riêng tôi.
Dialogue: 0,0:16:11.12,0:16:13.15,flashback,MELISSA,0,0,0,,Ngày mai là chúng ta sẽ tới nơi rồi.
Dialogue: 0,0:16:13.37,0:16:15.42,flashback,MELISSA,0,0,0,,Tối nay mọi người nhớ đi ngủ sớm đấy nhé.
Dialogue: 0,0:16:15.42,0:16:17.71,flashback,ADVENTURER 1,0,0,0,,Thế giờ chúng ta có làm vài chén rượu không nhỉ?
Dialogue: 0,0:16:17.71,0:16:19.80,flashback,ADVENTURER 2,0,0,0,,Định vừa say xỉn vừa chiến đấu đấy à?
Dialogue: 0,0:16:19.80,0:16:21.69,flashback,ADVENTURER 3,0,0,0,,Thế chẳng phải sẽ làm chân tay lảo đảo mất thăng bằng sao?
Dialogue: 0,0:16:21.69,0:16:24.18,flashback,ADVENTURER 1,0,0,0,,Gì cơ chứ? Tửu lượng của tôi cao lắm đấy nhé.
Dialogue: 0,0:16:24.18,0:16:26.98,flashbacktop,ADVENTURER 4,0,0,0,,Cậu lúc nào chẳng lăn quay ra ngủ ngay sau khi uống có một ly.
Dialogue: 0,0:16:24.79,0:16:28.29,flashback,MELISSA,0,0,0,,Margaret, qua đằng kia ăn chung cùng mọi người đi em.
Dialogue: 0,0:16:28.55,0:16:31.30,flashback,MARGARET,0,0,0,,Cảm ơn lòng tốt của chị, nhưng em ổn rồi.
Dialogue: 0,0:16:31.30,0:16:36.30,flashback,MELISSA,0,0,0,,Thì biết là vậy, nhưng chúng ta đang cùng đi làm nhiệm vụ mà. Đừng có tách biệt lẻ loi một mình thế chứ.
Dialogue: 0,0:16:36.30,0:16:40.18,flashback,MARGARET,0,0,0,,Ý chị là chúng ta nên cùng ăn chung một nồi thức ăn sao?
Dialogue: 0,0:16:40.58,0:16:41.85,flashback,MELISSA,0,0,0,,Đúng vậy, chuẩn luôn đấy.
Dialogue: 0,0:16:44.00,0:16:46.81,flashback,MARGARET,0,0,0,,Lỡ như trong cái nồi đó có thứ gì độc hại thì sao?
Dialogue: 0,0:16:47.42,0:16:50.41,flashback,MARGARET,0,0,0,,Chẳng lẽ em cũng phải ngã bệnh nằm bẹp dí cùng với tất cả mọi người hay sao?
Dialogue: 0,0:16:51.11,0:16:54.58,flashback,MELISSA,0,0,0,,Con bé này bị làm sao thế không biết nữa?! Người ta có lòng tốt mời mọc đàng hoàng mà!
Dialogue: 0,0:16:54.58,0:16:56.22,flashback,ADVENTURER 2,0,0,0,,Bình tĩnh lại đi, Melissa.
Dialogue: 0,0:16:56.22,0:17:00.12,flashback,ADVENTURER 2,0,0,0,,Bọn anh đã bảo từ trước rồi mà, con bé đó tính tình cộc cằn khó chịu lắm.
Dialogue: 0,0:17:01.95,0:17:03.12,flashback,MELISSA,0,0,0,,Mặc kệ em ấy luôn đi!
Dialogue: 0,0:17:03.51,0:17:08.13,flashback,MELISSA,0,0,0,,Margaret, em cứ tiếp tục cư xử như thế thì chẳng có ma nào thèm giúp đỡ em đâu!
Dialogue: 0,0:17:12.58,0:17:15.03,italics,MARGARET/ID,0,0,0,,Thật là mỉa mai làm sao, hả Lily.
Dialogue: 0,0:17:15.37,0:17:18.88,italics,MARGARET/ID,0,0,0,,Ý nghĩ duy nhất trong đầu là phải giết chết cậu đã biến tôi trở thành một kẻ
Dialogue: 0,0:17:19.21,0:17:23.02,italics,MARGARET/ID,0,0,0,,sẵn sàng bỏ rơi đồng đội của mình, hệt như cái cách mà cậu đã từng làm vậy.
Dialogue: 0,0:17:36.58,0:17:39.53,main,REIN,0,0,0,,Nhưng tại sao chứ? Chúng ta đã trang bị đầy đủ tận răng rồi cơ mà.
Dialogue: 0,0:17:42.81,0:17:45.71,main,REIN,0,0,0,,Lily! Margaret!
Dialogue: 0,0:18:04.57,0:18:06.01,main,REIN,0,0,0,,Không thể nào...
Dialogue: 0,0:18:22.61,0:18:27.18,italics,REIN/ID,0,0,0,,Chúng đã từng đánh bại Lily khi em ấy còn là một mạo hiểm giả hạng S lừng lẫy.
Dialogue: 0,0:18:27.83,0:18:30.89,italics,REIN/ID,0,0,0,,Chúng đủ sức mạnh khủng khiếp để tàn sát toàn bộ tổ đội của em ấy.
Dialogue: 0,0:18:33.04,0:18:34.96,italics,REIN/ID,0,0,0,,Không biết bọn quái vật đó thực sự đáng sợ đến mức độ nào nhỉ.
Dialogue: 0,0:18:35.56,0:18:37.67,italics,REIN/ID,0,0,0,,Dù nguy hiểm đến đâu đi chăng nữa thì Lily vẫn nhất quyết dấn thân vào.
Dialogue: 0,0:18:38.94,0:18:42.10,italics,REIN/ID,0,0,0,,Và một khi Lily đã đi, Margaret chắc chắn cũng sẽ đi theo.
Dialogue: 0,0:18:43.04,0:18:46.09,italics,REIN/ID,0,0,0,,Nếu tình huống tồi tệ nhất xảy ra...
Dialogue: 0,0:18:51.41,0:18:54.72,italics,REIN/ID,0,0,0,,thì làm thế nào để tất cả chúng ta đều có thể sống sót trở về đây?
Dialogue: 0,0:18:57.48,0:18:58.73,main,REIN,0,0,0,,Có ai ở đó không?
Dialogue: 0,0:19:13.37,0:19:14.57,main,MIRABELLE,0,0,0,,Tên đó là Rein sao?
Dialogue: 0,0:19:15.50,0:19:18.87,main,CORNELIUS,0,0,0,,Phải. Bên cạnh vẫn còn một người nữa.
Dialogue: 0,0:19:25.80,0:19:28.27,main,MARGARET,0,0,0,,Chào buổi sáng nhé, Lily.
Dialogue: 0,0:19:28.61,0:19:30.65,main,LILY,0,0,0,,Chào buổi sáng, Margaret.
Dialogue: 0,0:19:30.65,0:19:34.01,main,LILY,0,0,0,,Rein muốn gặp mặt chúng ta một lần trước khi khởi hành.
Dialogue: 0,0:19:35.11,0:19:40.65,main,MARGARET,0,0,0,,Tôi ước gì hai người không chọn nhà tôi làm điểm hẹn, nhưng thôi cứ vào đi.
Dialogue: 0,0:19:41.29,0:19:42.41,main,LILY,0,0,0,,Xin phép làm phiền nhé.
Dialogue: 0,0:19:44.73,0:19:47.16,main,MARGARET,0,0,0,,Ngồi xuống ghế đằng kia đợi chút đi.
Dialogue: 0,0:19:51.97,0:19:53.42,italics,MARGARET/ID,0,0,0,,Ước gì...
Dialogue: 0,0:19:55.46,0:19:57.59,italics,MARGARET/ID,0,0,0,,mình có thể một kiếm chém bay đầu cậu ta.
Dialogue: 0,0:19:58.42,0:20:01.29,italics,MARGARET/ID,0,0,0,,Ước gì mình có thể rạch nát cổ họng cậu ta ngay lúc này.
Dialogue: 0,0:20:02.69,0:20:03.85,italics,MARGARET/ID,0,0,0,,Không được.
Dialogue: 0,0:20:06.74,0:20:07.51,italics,MARGARET/ID,0,0,0,,Vẫn còn quá sớm.
Dialogue: 0,0:20:09.03,0:20:10.61,italics,MARGARET/ID,0,0,0,,Chưa phải lúc.
Dialogue: 0,0:20:16.38,0:20:18.36,main,MARGARET,0,0,0,,Mời dùng bữa nhé.
Dialogue: 0,0:20:19.38,0:20:21.61,main,LILY,0,0,0,,Cảm ơn cậu nhiều nhé, Margaret.
Dialogue: 0,0:20:21.96,0:20:23.31,main,MARGARET,0,0,0,,Không có gì đâu.
Dialogue: 0,0:20:24.15,0:20:25.46,italics,MARGARET/ID,0,0,0,,Mình sẽ giết chết Lily...
Dialogue: 0,0:20:25.46,0:20:29.87,italics,MARGARET/ID,0,0,0,,ngay sau khi ép cậu ta phải đối diện với sự thật cay đắng rằng cậu ta đã bỏ rơi chị gái mình để tháo chạy!
Dialogue: 0,0:20:30.83,0:20:33.29,main,REIN,0,0,0,,Lily! Margaret ơi!
Dialogue: 0,0:20:33.37,0:20:36.21,italics,NARRATION,0,0,0,,Ngầu lòi! Long tướng quân!
Dialogue: 0,0:20:36.21,0:20:37.88,italics,NARRATION,0,0,0,,Rồng dũng mãnh ngầu đét!
Dialogue: 0,0:20:40.09,0:20:41.40,main,REIN,0,0,0,,Xin lỗi vì đã để hai người phải đợi lâu nhé!
Dialogue: 0,0:20:43.83,0:20:46.09,main,LILY & MARGARET,0,0,0,,Cái quái gì thế này?!
Dialogue: 0,0:20:46.43,0:20:49.88,main,REIN,0,0,0,,Từ trước tới giờ, tôi toàn nói đùa cợt nhả và sống một cuộc đời vô định không mục tiêu.
Dialogue: 0,0:20:50.36,0:20:53.17,main,REIN,0,0,0,,Tôi đã luôn trốn tránh việc phải đối diện trực tiếp với mọi thứ.
Dialogue: 0,0:20:53.17,0:20:56.98,main,REIN,0,0,0,,Giờ đây khi đã thấu hiểu điều đó, tôi quyết định sẽ sống một cách nghiêm túc và chỉn chu hơn.
Dialogue: 0,0:20:57.35,0:20:59.98,italics,LILY & MARGARET/ID,0,0,0,,Thế này mà gọi là nghiêm túc đấy à?!
Dialogue: 0,0:20:59.98,0:21:03.74,main,LILY,0,0,0,,Rein, anh ngộ ra cái chân lý đó từ lúc nào thế hả?
Dialogue: 0,0:21:04.27,0:21:05.28,main,REIN,0,0,0,,Tối hôm qua.
Dialogue: 0,0:21:05.28,0:21:07.82,main,MARGARET,0,0,0,,Tên này bị đần độn à?!
Dialogue: 0,0:21:07.39,0:21:08.83,top,SIGN,0,0,0,,CON BÉ ĐÃ NHẬN RA
Dialogue: 0,0:21:09.05,0:21:11.08,main,LILY,0,0,0,,Rein, anh vớ đâu ra cái bộ giáp kỳ quái đó thế?
Dialogue: 0,0:21:11.08,0:21:13.42,main,REIN,0,0,0,,Ồ, hai người nhận ra rồi à?
Dialogue: 0,0:21:13.42,0:21:14.55,main,LILY,0,0,0,,Đập thẳng vào mắt thế này thì làm sao mà không thấy cho được?!
Dialogue: 0,0:21:14.55,0:21:19.59,main,REIN,0,0,0,,Tôi còn dư một ít tiền thưởng từ vụ hạ con rồng hôm nọ, nên tôi tậu ngay bộ này đấy!
Dialogue: 0,0:21:19.95,0:21:23.23,main,REIN,0,0,0,,Chẳng lẽ cứ mặc mãi mấy bộ đồ cũ kỹ tầm thường này hoài sao, đúng không?
Dialogue: 0,0:21:23.23,0:21:25.59,main,REIN,0,0,0,,Giờ thì tôi cảm thấy an tâm tuyệt đối để dấn thân vào bất kỳ chuyến phiêu lưu nào rồi!
Dialogue: 0,0:21:25.59,0:21:31.13,main,MARGARET,0,0,0,,Anh vừa bị một tên gian thương lừa gạt trắng trợn khi nhắm vào mấy tên mạo hiểm giả tân binh ngây thơ rồi.
Dialogue: 0,0:21:26.61,0:21:31.33,top,SIGN,0,0,0,,ĐÓ LÀ KIẾN THỨC CƠ BẢN TRONG NGHỀ ĐẤY
Dialogue: 0,0:21:31.13,0:21:33.35,main,LILY,0,0,0,,Oa, cô thực sự nói thẳng toẹt ra luôn kìa.
Dialogue: 0,0:21:31.99,0:21:33.35,top,SIGN RIGHT,0,0,0,,OA, NÓI THẲNG LUÔN
Dialogue: 0,0:21:32.20,0:21:33.35,top,SIGN LEFT,0,0,0,,THỰC SỰ NÓI THẲNG TOẸT RA KÌA
Dialogue: 0,0:21:33.68,0:21:34.43,main,REIN,0,0,0,,Hả?
Dialogue: 0,0:21:34.96,0:21:38.24,main,MARGARET,0,0,0,,Trông thì màu mè hoa lá cành đấy, nhưng thực chất hoàn toàn vô dụng.
Dialogue: 0,0:21:38.24,0:21:41.69,main,MARGARET,0,0,0,,Xét tới việc nó cản trở cử động linh hoạt của anh, nó thậm chí còn tệ hơn cả đồ phế thải.
Dialogue: 0,0:21:41.91,0:21:45.72,main,MARGARET,0,0,0,,Lại còn khắc chữ "Long Dũng Mãnh" nữa chứ? Chúng ta là những kẻ đi săn rồng cơ mà.
Dialogue: 0,0:21:46.07,0:21:48.60,main,MARGARET,0,0,0,,Anh nên cẩn thận hơn đi.
Dialogue: 0,0:21:48.60,0:21:51.88,main,MARGARET,0,0,0,,Cái nghề này nhung nhúc toàn lũ lừa đảo giảo hoạt thôi.
Dialogue: 0,0:21:49.22,0:21:53.26,top,SIGN,0,0,0,,CORNELIUS CỦA NANH VUỐT DÃ THÚ,\NKẺ TỪNG GIẾT VÀI NGƯỜI
Dialogue: 0,0:21:54.08,0:21:56.89,main,MARGARET,0,0,0,,Tôi biết là anh đang cố gắng sống một cách nghiêm túc và đứng đắn...
Dialogue: 0,0:21:57.38,0:21:59.25,main,LILY,0,0,0,,Nhưng anh ngốc nghếch hết phần thiên hạ thật đấy.
Dialogue: 0,0:22:08.92,0:22:10.05,italics,NARRATION,0,0,0,,Ngầu—
Dialogue: 0,0:22:47.76,0:22:49.26,top,SIGN,0,0,0,,LILY
Dialogue: 0,0:22:53.43,0:22:54.60,top,SIGN,0,0,0,,CÔ ẤY VỪA GỌI REIN KÌA!!
Dialogue: 0,0:22:54.60,0:22:59.60,main,sign,0,0,0,,{\an3}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:00.23,0:23:05.02,main,sign,0,0,0,,{\an1}Biên dịch & Kỹ thuật: Amtia(NOFACE)
Dialogue: 0,0:23:05.07,0:23:09.82,main,sign,0,0,0,,{\an3}Kiểm định chất lượng: Amtia(NOFACE)
Dialogue: 0,0:22:53.43,0:22:54.60,top,SIGN,0,0,0,,CÓ PHẢI CÔ ẤY...
Dialogue: 0,0:22:53.43,0:22:54.60,top,SIGN,0,0,0,,ĐANG NÓI VỀ MÌNH ĐẤY ÀAAA?!
Dialogue: 0,0:22:54.60,0:23:05.07,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:23:15.16,0:23:15.83,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:15.83,0:23:26.21,top,SIGN,0,0,0,,{\an4}REIN ĐẬP TAN SÂN KHẤU
Dialogue: 0,0:23:15.83,0:23:18.83,top,SIGN,0,0,0,,CÔ VỪA NÓI VỀ TÔI ĐẤY ĐÚNG KHÔNG?!
Dialogue: 0,0:23:15.83,0:23:18.83,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:18.83,0:23:19.58,top,SIGN,0,0,0,,ĐÚNG KHÔNG HẢ?!
Dialogue: 0,0:23:20.33,0:23:21.08,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:21.08,0:23:21.83,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:21.83,0:23:22.58,top,SIGN,0,0,0,,NÀY ƠI LÀ NÀY!!
Dialogue: 0,0:23:22.58,0:23:23.33,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:24.09,0:23:24.84,top,SIGN,0,0,0,,ĐÚNG THẾ MÀ, PHẢI KHÔNG?!
Dialogue: 0,0:23:25.59,0:23:26.21,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:28.13,0:23:30.72,top,SIGN,0,0,0,,CUỘC ĐỜI NHẬP VAI
Dialogue: 0,0:23:28.88,0:23:29.63,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:29.63,0:23:30.38,top,SIGN,0,0,0,,NÀY!
Dialogue: 0,0:23:30.38,0:23:30.72,top,SIGN,0,0,0,,LILY ƠI!!
Dialogue: 0,0:23:35.47,0:23:40.05,top,SIGN,0,0,0,,XÔNG LÊN
Dialogue: 0,0:23:35.47,0:23:40.05,top,SIGN,0,0,0,,{\an9}LILY ƠI!!
Dialogue: 0,0:23:35.47,0:23:40.05,top,SIGN,0,0,0,,{\an9}LILY ƠI!!
Dialogue: 0,0:23:35.47,0:23:40.05,top,SIGN,0,0,0,,{\an5}TINH THỂ XANH ĐẬP TAN SÂN KHẤU!

