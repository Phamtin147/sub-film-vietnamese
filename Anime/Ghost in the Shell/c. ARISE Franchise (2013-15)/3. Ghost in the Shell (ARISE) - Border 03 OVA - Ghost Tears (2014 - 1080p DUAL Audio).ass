Dialogue: 5,0:01:44.54,0:01:45.60,Default,,0,0,0,,Thiếu tá.
Dialogue: 5,0:01:45.60,0:01:46.83,Default,,0,0,0,,Này, Thiếu tá!
Dialogue: 5,0:01:49.62,0:01:51.98,Default,,0,0,0,,Cái gì thế kia? Thực tế ảo à?
Dialogue: 5,0:01:51.98,0:01:53.46,Default,,0,0,0,,Tôi đang trong kỳ nghỉ.
Dialogue: 5,0:01:53.46,0:01:55.72,Default,,0,0,0,,Anh có phiền không nếu đừng tùy tiện bước vào sảnh không gian mạng của tôi như thế?
Dialogue: 5,0:01:55.72,0:01:57.47,Default,,0,0,0,,Xin chia buồn nhé.
Dialogue: 5,0:01:57.86,0:01:59.53,Default,,0,0,0,,Vừa xảy ra một vụ đánh bom khủng bố ở Nishinouchi.
Dialogue: 5,0:01:59.53,0:02:02.12,Default,,0,0,0,,Các nạn nhân là một giám đốc điều hành của một công ty nước có vốn đầu tư nước ngoài,
Dialogue: 5,0:02:02.12,0:02:05.43,Default,,0,0,0,,một quan chức Bộ Thương mại, và một nhà sản xuất vũ khí trong nước.
Dialogue: 5,0:02:06.22,0:02:11.40,Default,,0,0,0,,Mục ưu tiên hàng đầu trong danh sách dự đoán khủng bố\Nmà cô giao cho Cục An ninh Công cộng trúng phóc luôn.
Dialogue: 5,0:02:11.80,0:02:15.00,Default,,0,0,0,,Tôi đoán họ đang có một cuộc họp kín\Nđể thỏa thuận giá nước.
Dialogue: 5,0:02:15.00,0:02:17.36,Default,,0,0,0,,Mọi thứ đều tan tành thành từng mảnh vụn,\Nkể cả vài nhân viên bảo vệ của Bộ Ngoại giao.
Dialogue: 5,0:02:18.65,0:02:21.48,Default,,0,0,0,,Tiện thể, ở con đập Yamanote cũng vừa có một vụ nổ đấy.
Dialogue: 5,0:02:21.48,0:02:22.33,Default,,0,0,0,,Con đập sao?
Dialogue: 5,0:02:25.93,0:02:27.82,Default,,0,0,0,,Không rõ liệu có liên quan hay không.
Dialogue: 5,0:02:27.82,0:02:32.99,Default,,0,0,0,,Nhưng trên thực tế nó thuộc về một công ty nước có vốn nước ngoài,\Nvà có một cựu quan chức Bộ Thương mại trong ban điều hành.
Dialogue: 5,0:02:36.82,0:02:39.97,Default,,0,0,0,,Các cuộc chiến tranh giành lãnh địa của đám quan chức\Ntrong ngành đó khốc liệt lắm.
Dialogue: 5,0:02:41.43,0:02:44.14,Default,,0,0,0,,Vậy, ai yêu cầu chúng ta?
Dialogue: 5,0:02:44.14,0:02:46.10,Default,,0,0,0,,Đội 9, như thường lệ.
Dialogue: 5,0:02:46.83,0:02:50.83,Default,,0,0,0,,Họ không tận dụng tốt danh sách của cô,\Nnhưng họ đã lần theo dấu vết của thủ phạm.
Dialogue: 5,0:02:50.83,0:02:53.94,Default,,0,0,0,,Tuy nhiên họ bảo không thể bắt giữ được chúng.\NHỏa lực bên kia áp đảo quá.
Dialogue: 5,0:02:59.07,0:03:01.64,Default,,0,0,0,,Tập hợp mọi người lại đi. Tôi cũng sẽ tới.
Dialogue: 5,0:03:02.82,0:03:04.37,Default,,0,0,0,,Công việc gọi à?
Dialogue: 5,0:03:06.94,0:03:08.01,Default,,0,0,0,,Em xin lỗi.
Dialogue: 5,0:03:08.80,0:03:10.29,Default,,0,0,0,,Năm tiếng, bảy phút.
Dialogue: 5,0:03:11.05,0:03:13.50,Default,,0,0,0,,Đó là kỳ nghỉ dài kỷ lục của em đấy.
Dialogue: 5,0:03:13.50,0:03:15.61,Default,,0,0,0,,Hôm nay em lại làm cố vấn cho cảnh sát à?
Dialogue: 5,0:03:15.61,0:03:17.67,Default,,0,0,0,,Hay là Cục Phát triển Não điện tử?
Dialogue: 5,0:03:18.90,0:03:20.56,Default,,0,0,0,,Em sẽ đền cho anh sau.
Dialogue: 5,0:03:21.35,0:03:23.43,Default,,0,0,0,,Đừng quên chuyện chúng ta đã nói đấy.
Dialogue: 5,0:03:24.37,0:03:25.71,Default,,0,0,0,,Anh nghiêm túc đấy chứ?
Dialogue: 5,0:03:25.71,0:03:26.56,Default,,0,0,0,,Tất nhiên rồi.
Dialogue: 5,0:03:26.56,0:03:29.09,Default,,0,0,0,,Em nên đi đi.
Dialogue: 5,0:03:29.09,0:03:31.34,Default,,0,0,0,,Khách hàng của em chưa bao giờ là những kẻ kiên nhẫn cả, phải không nào?
Dialogue: 5,0:03:33.29,0:03:34.02,Default,,0,0,0,,Vâng.
Dialogue: 5,0:03:34.42,0:03:37.71,Default,,0,0,0,,Chà, cô đã gắn bó với gã đó được ba tháng rồi đấy!
Dialogue: 5,0:03:37.71,0:03:39.57,Default,,0,0,0,,Đó là một kỷ lục mới.
Dialogue: 5,0:03:43.53,0:03:46.68,Default,,0,0,0,,Anh có phiền không nếu đừng tùy tiện dùng cái chìa khóa\Nthâm nhập Hồn đó như thế?
Dialogue: 5,0:04:55.23,0:04:59.07,Default,,0,0,0,,Đồn cảnh sát của anh đã xác nhận danh tính nạn nhân là Thanh tra Mizuki Naoharu.
Dialogue: 5,0:04:59.38,0:05:00.53,Default,,0,0,0,,Có đúng vậy không?
Dialogue: 5,0:05:01.11,0:05:03.45,Default,,0,0,0,,Đúng thế. Anh ấy là tiền bối của tôi.
Dialogue: 5,0:05:11.68,0:05:13.37,Default,,0,0,0,,Đây là tất cả những gì anh ấy mang theo bên người sao?
Dialogue: 5,0:05:13.74,0:05:15.33,Default,,0,0,0,,Bao súng của anh ấy trống rỗng.
Dialogue: 5,0:05:16.02,0:05:18.79,Default,,0,0,0,,Khẩu súng của anh ấy chắc đã bị cuốn trôi hoặc bị đánh cắp rồi.
Dialogue: 5,0:05:19.17,0:05:21.71,Default,,0,0,0,,Thật khó tin khi khẩu súng nằm bên trong áo khoác\Nlại có thể bị nước cuốn trôi được.
Dialogue: 5,0:05:22.15,0:05:25.10,Default,,0,0,0,,Và cũng thật kỳ lạ nếu ai đó lấy cắp súng\Nmà lại để lại ví tiền.
Dialogue: 5,0:05:31.51,0:05:32.96,Default,,0,0,0,,Một chuyên gia về thể máy...
Dialogue: 5,0:05:34.82,0:05:37.23,Default,,0,0,0,,Trông anh ta chắc chắn không giống người đã cơ thể hóa.
Dialogue: 5,0:05:37.23,0:05:40.82,Default,,0,0,0,,Trung úy, người của anh đã gom tất cả tài sản vô chủ trong khu vực rồi đúng không?
Dialogue: 5,0:05:40.82,0:05:43.36,Default,,0,0,0,,Hãy tìm xem còn thứ gì khác có liên hệ với anh ấy không.
Dialogue: 5,0:05:43.36,0:05:45.29,Default,,0,0,0,,Anh muốn tôi làm chân chạy việc cho anh à?
Dialogue: 5,0:05:45.29,0:05:47.94,Default,,0,0,0,,Nếu sự cố ở con đập thực sự là một tai nạn, thì đúng vậy.
Dialogue: 5,0:05:47.94,0:05:48.95,Default,,0,0,0,,Trung úy!
Dialogue: 5,0:05:49.98,0:05:51.58,Default,,0,0,0,,Tôi tìm thấy một thứ kỳ lạ.
Dialogue: 5,0:05:55.09,0:05:56.56,Default,,0,0,0,,Thứ gì đây?
Dialogue: 5,0:05:56.56,0:05:58.00,Default,,0,0,0,,Trông giống như chân nhân tạo, nhưng mà...
Dialogue: 5,0:06:07.32,0:06:09.03,Default,,0,0,0,,Đôi chân Người cá (Mermaid's Legs)...
Dialogue: 5,0:06:16.79,0:06:17.77,Default,,0,0,0,,Báo cáo đi.
Dialogue: 5,0:06:19.32,0:06:21.32,Default,,0,0,0,,Rất nhiều cảnh sát bị thương.
Dialogue: 5,0:06:21.32,0:06:23.23,Default,,0,0,0,,Sáu tên thủ phạm vẫn đang tiến công dữ dội.
Dialogue: 5,0:06:23.52,0:06:25.20,Default,,0,0,0,,Bọn chúng đang trên đường tới Khu 4.
Dialogue: 5,0:06:25.20,0:06:27.70,Default,,0,0,0,,Chúng nhìn thấu toàn bộ chiến thuật của cảnh sát.
Dialogue: 5,0:06:27.70,0:06:30.91,Default,,0,0,0,,Chúng đã bảo đảm sẵn một lộ trình tẩu thoát từ trước.
Dialogue: 5,0:06:31.20,0:06:33.37,Default,,0,0,0,,Nhóm này được huấn luyện rất bài bản.
Dialogue: 5,0:06:33.68,0:06:35.74,Default,,0,0,0,,Chỉ huy của chúng chắc chắn đang ở ngoài kia.
Dialogue: 5,0:06:35.74,0:06:36.33,Default,,0,0,0,,Ishikawa!
Dialogue: 5,0:06:39.07,0:06:40.83,Default,,0,0,0,,Tôi đã bắt được đường truyền của chúng rồi!
Dialogue: 5,0:06:44.52,0:06:47.13,Default,,0,0,0,,Tên thứ bảy. Đây chính là kẻ cầm đầu.
Dialogue: 5,0:07:19.51,0:07:21.19,Default,,0,0,0,,Đây là khóa hồn (ghost lock) tối tân đấy.
Dialogue: 5,0:07:21.19,0:07:22.63,Default,,0,0,0,,Đừng lãng phí thời gian kháng cự vô ích.
Dialogue: 5,0:07:24.60,0:07:26.67,Default,,0,0,0,,Tôi sẽ bắt hắn ra lệnh cho đồng bọn đầu hàng.
Dialogue: 5,0:07:26.67,0:07:29.63,Default,,0,0,0,,Ishikawa, chạy chương trình cưỡng chế nhận diện.
Dialogue: 5,0:07:29.63,0:07:30.55,Default,,0,0,0,,Rõ.
Dialogue: 5,0:07:31.78,0:07:32.97,Default,,0,0,0,,Hủy bỏ chiến dịch.
Dialogue: 5,0:07:33.34,0:07:35.06,Default,,0,0,0,,Vứt súng xuống và đầu hàng.
Dialogue: 5,0:07:36.07,0:07:40.36,Default,,0,0,0,,Nhắc lại: hủy bỏ chiến dịch và đầu hàng mau.
Dialogue: 5,0:07:43.98,0:07:44.48,Default,,0,0,0,,Hả?
Dialogue: 5,0:07:48.11,0:07:50.15,Default,,0,0,0,,Ủa, không có đọ súng à?
Dialogue: 5,0:07:51.64,0:07:54.12,Default,,0,0,0,,Tôi tóm được một tên rồi này!
Dialogue: 5,0:07:55.94,0:07:58.09,Default,,0,0,0,,Này, cậu cũng hữu dụng phết đấy chứ!
Dialogue: 5,0:07:59.83,0:08:01.96,Default,,0,0,0,,Chúng ta tóm được tên cuối cùng rồi.
Dialogue: 5,0:08:01.96,0:08:04.47,Default,,0,0,0,,Tốt. Bàn giao tất cả bọn chúng cho An ninh Công cộng.
Dialogue: 5,0:08:07.08,0:08:08.55,Default,,0,0,0,,Cảnh báo virus sao?
Dialogue: 5,0:08:11.42,0:08:12.80,Default,,0,0,0,,Là từ tên mà cô vừa bắt giữ đấy!
Dialogue: 5,0:08:28.17,0:08:29.32,Default,,0,0,0,,{\i1}Cơn đau này...{\i0}
Dialogue: 5,0:08:36.01,0:08:37.95,Default,,0,0,0,,{\i1}Khóa hồn bị giải trừ rồi sao?{\i0}
Dialogue: 5,0:08:39.15,0:08:40.08,Default,,0,0,0,,Thiếu tá?
Dialogue: 5,0:08:40.08,0:08:41.87,Default,,0,0,0,,Chết tiệt. Saito!
Dialogue: 5,0:08:45.88,0:08:46.81,Default,,0,0,0,,Đừng giết hắn!
Dialogue: 5,0:09:15.82,0:09:17.03,Default,,0,0,0,,Xong đời rồi, anh bạn!
Dialogue: 5,0:09:20.94,0:09:26.04,Default,,0,0,0,,Khốn khiếp, cảm giác bị ai đó thâm nhập vào Hồn kinh tởm thật. Dù là Thiếu tá đi nữa.
Dialogue: 5,0:09:26.04,0:09:27.37,Default,,0,0,0,,Chuẩn không cần chỉnh...
Dialogue: 5,0:09:27.37,0:09:29.21,Default,,0,0,0,,Lỗi của anh vì dám ngắm vào đầu đấy.
Dialogue: 5,0:09:29.97,0:09:31.57,Default,,0,0,0,,Đừng vội bàn giao bọn chúng.
Dialogue: 5,0:09:31.57,0:09:34.78,Default,,0,0,0,,Chúng ta sẽ đưa chúng đến trại giam có trang bị hệ thống mạng.
Dialogue: 5,0:09:34.78,0:09:36.76,Default,,0,0,0,,Cô đang bảo tôi đóng vai bạn tâm giao thẩm vấn đấy à?
Dialogue: 5,0:09:36.76,0:09:38.93,Default,,0,0,0,,Tôi không hứng thú với những ký ức giả tạo.
Dialogue: 5,0:09:39.35,0:09:40.93,Default,,0,0,0,,Ký ức sao?
Dialogue: 5,0:09:41.19,0:09:44.15,Default,,0,0,0,,Tôi hứng thú với những linh Hồn đã bị vấy bẩn của bọn chúng.
Dialogue: 5,0:09:53.15,0:09:55.95,Default,,0,0,0,,Xin lỗi vì đã phải gọi bà đến đây.
Dialogue: 5,0:09:56.43,0:09:59.17,Default,,0,0,0,,Đó là nghĩa vụ công dân của tôi mà.
Dialogue: 5,0:09:59.17,0:10:01.41,Default,,0,0,0,,Tôi hiểu bà là người chịu trách nhiệm quản lý con đập.
Dialogue: 5,0:10:01.86,0:10:02.90,Default,,0,0,0,,Để xem nào...
Dialogue: 5,0:10:04.13,0:10:07.12,Default,,0,0,0,,Tiến sĩ Zhinzhee Bekka Arr Thied.
Dialogue: 5,0:10:07.12,0:10:08.91,Default,,0,0,0,,Xin hãy cứ gọi tôi là Thied.
Dialogue: 5,0:10:09.94,0:10:11.91,Default,,0,0,0,,Bà có một người thư ký trông khá bặm trợn đấy.
Dialogue: 5,0:10:12.74,0:10:14.34,Default,,0,0,0,,Anh ấy rất đáng tin cậy.
Dialogue: 5,0:10:14.68,0:10:19.34,Default,,0,0,0,,Các cuộc xung đột vẫn đang tiếp diễn tại Cộng hòa Kuzan, quê hương của bà.
Dialogue: 5,0:10:19.34,0:10:25.06,Default,,0,0,0,,Tôi nghe nói người thiểu số Qhardi nói riêng vẫn đang tiến hành cuộc chiến giành độc lập.
Dialogue: 5,0:10:25.83,0:10:28.02,Default,,0,0,0,,Đó là một cuộc chiến đau lòng.
Dialogue: 5,0:10:28.02,0:10:30.48,Default,,0,0,0,,Bà là người Qhardi, đúng không?
Dialogue: 5,0:10:30.48,0:10:36.08,Default,,0,0,0,,Vâng. Giống như đại đa số đồng bào của mình, tôi mong muốn một giải pháp hòa bình.
Dialogue: 5,0:10:38.22,0:10:39.92,Default,,0,0,0,,Vậy vụ nổ ở con đập...
Dialogue: 5,0:10:39.92,0:10:42.41,Default,,0,0,0,,Tôi được thông báo đó là do van bị trục trặc kỹ thuật.
Dialogue: 5,0:10:42.41,0:10:45.88,Default,,0,0,0,,Công ty của bà bán nước, phải không?
Dialogue: 5,0:10:45.88,0:10:47.58,Default,,0,0,0,,Cho mục đích sử dụng nào thế?
Dialogue: 5,0:10:47.58,0:10:49.75,Default,,0,0,0,,Cho các doanh nghiệp sản xuất máy móc chính xác.
Dialogue: 5,0:10:49.75,0:10:53.62,Default,,0,0,0,,Ngành công nghiệp đó phụ thuộc vào nước tinh khiết 100%.
Dialogue: 5,0:10:53.62,0:10:55.38,Default,,0,0,0,,Máy móc chính xác...
Dialogue: 5,0:10:55.74,0:10:57.53,Default,,0,0,0,,Sản xuất thể máy nhân tạo, chẳng hạn?
Dialogue: 5,0:10:57.53,0:10:58.27,Default,,0,0,0,,Đúng vậy.
Dialogue: 5,0:11:00.98,0:11:01.79,Default,,0,0,0,,Thưa Cục trưởng.
Dialogue: 5,0:11:03.91,0:11:04.76,Default,,0,0,0,,Đồ ngu!
Dialogue: 5,0:11:05.38,0:11:08.56,Default,,0,0,0,,Bộ Thương mại đã mời họ đến đây để xây dựng nhà máy đấy!
Dialogue: 5,0:11:08.56,0:11:11.19,Default,,0,0,0,,Cậu muốn biến đồn cảnh sát địa phương thành kẻ thù nữa sao?
Dialogue: 5,0:11:11.19,0:11:12.47,Default,,0,0,0,,Nhưng mà...
Dialogue: 5,0:11:17.26,0:11:19.31,Default,,0,0,0,,Dừng lại, đó là vật chứng!
Dialogue: 5,0:11:20.37,0:11:25.83,Default,,0,0,0,,Tôi rất biết ơn các anh vì đã tìm lại\Nsố hàng hóa bị đánh cắp từ kho của chúng tôi.
Dialogue: 5,0:11:26.41,0:11:27.76,Default,,0,0,0,,Xin mời các anh cứ giữ lấy mang đi.
Dialogue: 5,0:11:28.86,0:11:29.77,Default,,0,0,0,,Cục trưởng!
Dialogue: 5,0:11:29.77,0:11:30.73,Default,,0,0,0,,Lùi lại mau!
Dialogue: 5,0:11:32.30,0:11:34.18,Default,,0,0,0,,Một thanh tra cảnh sát đã thiệt mạng đấy, thưa sếp.
Dialogue: 5,0:11:34.18,0:11:35.79,Default,,0,0,0,,Cậu nghĩ tôi không biết chuyện đó sao?
Dialogue: 5,0:11:36.21,0:11:38.76,Default,,0,0,0,,Cậu hãy đến Nishinouchi và thu thập thông tin cho tôi.
Dialogue: 5,0:11:39.34,0:11:41.25,Default,,0,0,0,,Nishinouchi? Ở đó có gì?
Dialogue: 5,0:11:41.25,0:11:45.28,Default,,0,0,0,,Một vụ đánh bom, rõ ràng là do khủng bố Qhardi thực hiện.
Dialogue: 5,0:11:45.28,0:11:48.36,Default,,0,0,0,,Nghe đây. Cậu phải thỉnh thị cấp trên trước bất kỳ động thái nào trong vụ án này.
Dialogue: 5,0:11:48.36,0:11:49.09,Default,,0,0,0,,Khủng bố sao?
Dialogue: 5,0:11:50.74,0:11:54.73,Default,,0,0,0,,Nếu vụ nổ là cố ý, và anh ấy không phải nạn nhân...
Dialogue: 5,0:11:55.85,0:11:56.88,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:11:56.88,0:11:59.10,Default,,0,0,0,,Rõ, thưa sếp! Tôi đi ngay!
Dialogue: 5,0:12:01.98,0:12:04.11,Default,,0,0,0,,Đừng có gây thêm rắc rối đấy!
Dialogue: 5,0:12:08.12,0:12:10.58,Default,,0,0,0,,Bọn chúng là một băng đảng buôn lậu vũ khí người Qhardi.
Dialogue: 5,0:12:10.58,0:12:12.79,Default,,0,0,0,,Tôi từng chạm trán chúng trong một chiến dịch nằm vùng.
Dialogue: 5,0:12:13.13,0:12:16.66,Default,,0,0,0,,Mục tiêu của chúng là tuồn vũ khí về cho đồng bào ở quê nhà.
Dialogue: 5,0:12:16.66,0:12:18.95,Default,,0,0,0,,Bọn chúng chẳng có lý do gì để tấn công đất nước này cả.
Dialogue: 5,0:12:18.95,0:12:21.02,Default,,0,0,0,,Lời khai của bọn chúng rành rọt như ban ngày.
Dialogue: 5,0:12:21.02,0:12:24.80,Default,,0,0,0,,Chúng phản đối thỏa thuận định giá nước, nên đã đánh bom địa điểm họp.
Dialogue: 5,0:12:24.80,0:12:27.88,Default,,0,0,0,,Cô đang bảo tôi đó là những ký ức bị cấy vào sao?
Dialogue: 5,0:12:27.88,0:12:30.27,Default,,0,0,0,,Tôi cá là tất cả bọn chúng đều đã bị nhiễm virus,
Dialogue: 5,0:12:30.67,0:12:33.27,Default,,0,0,0,,và con virus đó đã can thiệp vào khóa hồn của tôi.
Dialogue: 5,0:12:39.78,0:12:42.28,Default,,0,0,0,,Làm tốt lắm. Các cậu đã trấn áp chúng một cách xuất sắc.
Dialogue: 5,0:12:42.28,0:12:47.24,Default,,0,0,0,,Chúng tôi còn làm dễ dàng hơn thế nữa nếu ông\Nchịu điều chỉnh chuẩn liên lạc của các ông theo của chúng tôi.
Dialogue: 5,0:12:47.80,0:12:49.41,Default,,0,0,0,,Tôi đã đọc báo cáo của cô.
Dialogue: 5,0:12:49.41,0:12:54.75,Default,,0,0,0,,Một loại virus ký ức giả tạo có thể vừa thâm nhập, vừa hack, vừa tẩy não cùng lúc sao?
Dialogue: 5,0:12:55.09,0:12:57.71,Default,,0,0,0,,Nó là loại virus tự hủy tương tự Stuxnet.
Dialogue: 5,0:12:57.71,0:13:00.71,Default,,0,0,0,,Ngoài những triệu chứng khởi phát ban đầu, nó không để lại bất kỳ dấu vết nào.
Dialogue: 5,0:13:01.03,0:13:04.92,Default,,0,0,0,,Thao túng điện tử lên ký ức là điều vô cùng khó khăn.
Dialogue: 5,0:13:04.92,0:13:07.28,Default,,0,0,0,,Chưa có ai trên thế giới này được xác nhận là đã thành công cả.
Dialogue: 5,0:13:07.28,0:13:11.60,Default,,0,0,0,,Vậy mà các vụ việc vừa qua cho thấy rõ ràng kẻ chế tạo và kẻ môi giới đều có thật.
Dialogue: 5,0:13:12.04,0:13:16.73,Default,,0,0,0,,Phải. Ở đâu đó ngoài kia có một lập trình viên cấp siêu phù thủy
Dialogue: 5,0:13:16.73,0:13:19.52,Default,,0,0,0,,được biết đến với cái tên "Fire-Starter" (Kẻ Châm Lửa),\Nkẻ đã tạo ra loại virus mạng cấp cao này.
Dialogue: 5,0:13:19.95,0:13:23.44,Default,,0,0,0,,Cho đến tận bây giờ, chưa có tổ chức nào trên thế giới lần ra được danh tính của hắn.
Dialogue: 5,0:13:23.44,0:13:24.49,Default,,0,0,0,,Nhưng cô thì đã làm được?
Dialogue: 5,0:13:25.04,0:13:26.45,Default,,0,0,0,,Dù sao thì cũng có một manh mối.
Dialogue: 5,0:13:32.61,0:13:33.37,Default,,0,0,0,,Cái gì đây?
Dialogue: 5,0:13:33.93,0:13:36.66,Default,,0,0,0,,Tất cả những tên khủng bố đều có cùng một hình xăm.
Dialogue: 5,0:13:36.66,0:13:42.05,Default,,0,0,0,,Đó là biểu tượng từng được Scylla sử dụng,\Nngười anh hùng từng lãnh đạo Quân đội Ly khai Qhardi.
Dialogue: 5,0:13:42.05,0:13:43.75,Default,,0,0,0,,Tôi từng nghe nói về hắn.
Dialogue: 5,0:13:43.75,0:13:46.17,Default,,0,0,0,,Nghe đồn hắn là bậc thầy về tác chiến không gian mạng.
Dialogue: 5,0:13:46.17,0:13:47.97,Default,,0,0,0,,Hắn chính là Fire-Starter sao?
Dialogue: 5,0:13:47.97,0:13:50.55,Default,,0,0,0,,Không đời nào. Hắn đã chết trong chiến tranh rồi.
Dialogue: 5,0:13:50.55,0:13:53.11,Default,,0,0,0,,Cô sẽ đi tìm hiểu xem điều đó có thật hay không.
Dialogue: 5,0:13:53.11,0:13:56.35,Default,,0,0,0,,Tôi sẽ cấp quyền truy cập giới hạn vào cơ sở dữ liệu của Đội 9.
Dialogue: 5,0:13:56.35,0:13:58.07,Default,,0,0,0,,Hãy đọc chi tiết ở trong đó.
Dialogue: 5,0:13:58.07,0:13:59.02,Default,,0,0,0,,Chỉ có vậy thôi sao?
Dialogue: 5,0:13:59.33,0:14:00.58,Default,,0,0,0,,Cô còn phàn nàn gì nữa?
Dialogue: 5,0:14:00.58,0:14:05.49,Default,,0,0,0,,Tôi đã giao cho cô tất cả số Logicoma tôi có,\Ncộng thêm vũ khí và quyền sử dụng chúng rồi.
Dialogue: 5,0:14:05.49,0:14:09.95,Default,,0,0,0,,Mọi danh sách tôi lập ra đều vô nghĩa nếu tổ chức không thể hành động.
Dialogue: 5,0:14:10.33,0:14:11.64,Default,,0,0,0,,Và?
Dialogue: 5,0:14:11.64,0:14:13.90,Default,,0,0,0,,Tôi muốn có thẩm quyền đặc biệt và một ngân sách được phê duyệt.
Dialogue: 5,0:14:13.90,0:14:19.22,Default,,0,0,0,,Và tiện thể hãy làm cho các đường truyền mỏng manh của các ông tương thích ngược với chúng tôi đi.
Dialogue: 5,0:14:19.97,0:14:21.38,Default,,0,0,0,,Đủ rồi đấy!
Dialogue: 5,0:14:21.86,0:14:25.01,Default,,0,0,0,,Đội ngũ của cô không đủ quân số theo quy định,\Nvà tôi đã độ lượng nhắm mắt làm ngơ rồi đấy nhé!
Dialogue: 5,0:14:25.43,0:14:28.20,Default,,0,0,0,,Đơn vị này được chuẩn hóa theo thông số hoàn hảo.
Dialogue: 5,0:14:28.20,0:14:30.00,Default,,0,0,0,,Chúng tôi không cần thêm người.
Dialogue: 5,0:14:30.00,0:14:32.93,Default,,0,0,0,,Thế thì cả đơn vị sẽ sụp đổ ngay giây phút cô bị hack.
Dialogue: 5,0:14:32.93,0:14:34.80,Default,,0,0,0,,Y hệt như đám khủng bố kia vậy.
Dialogue: 5,0:14:35.96,0:14:38.69,Default,,0,0,0,,"Thông số hoàn hảo" của cô không đáng để tôi đặt trọn niềm tin.
Dialogue: 5,0:14:39.34,0:14:41.06,Default,,0,0,0,,Nếu muốn có thẩm quyền và ngân sách,
Dialogue: 5,0:14:41.06,0:14:45.54,Default,,0,0,0,,hãy tìm thêm ít nhất một thành viên nữa và chấp nhận\Nsự hợp tác từ một người có thông số kỹ thuật khác biệt.
Dialogue: 5,0:14:47.42,0:14:52.41,Default,,0,0,0,,Nếu họ không chịu cấp tiền, chúng ta sẽ phải\Nmắc kẹt ở cái bãi rác này thêm một thời gian nữa rồi.
Dialogue: 5,0:14:53.87,0:14:56.45,Default,,0,0,0,,Tôi chỉ mừng là chúng ta còn có một phòng thí nghiệm để dùng.
Dialogue: 5,0:14:57.96,0:15:02.63,Default,,0,0,0,,Ừ, hiệu năng thể máy cao đòi hỏi phải bảo trì thượng hạng...
Dialogue: 5,0:15:04.57,0:15:07.49,Default,,0,0,0,,Chúng ta sẽ phải tự bỏ tiền túi ra để nâng cấp thôi.
Dialogue: 5,0:15:07.49,0:15:08.80,Default,,0,0,0,,Tốn kém lắm đấy.
Dialogue: 5,0:15:10.91,0:15:13.47,Default,,0,0,0,,Giảng viên bãi huấn luyện kiếm được bộn tiền đấy chứ.
Dialogue: 5,0:15:15.31,0:15:19.51,Default,,0,0,0,,Cơ sở bảo trì chất lượng đỉnh cao, thẩm quyền tối thượng—chúng ta sẽ có tất cả.
Dialogue: 5,0:15:19.51,0:15:21.48,Default,,0,0,0,,Bớt cằn nhằn lãng phí thời gian đi và mau giải quyết vụ án này!
Dialogue: 5,0:15:22.47,0:15:23.94,Default,,0,0,0,,Quốc tịch của hắn chưa rõ.
Dialogue: 5,0:15:23.94,0:15:28.92,Default,,0,0,0,,Hắn sử dụng nhiều cơ thể khác nhau để che giấu danh tính,\Nnên mới có cái tên Skulla,
Dialogue: 5,0:15:28.92,0:15:30.83,Default,,0,0,0,,hay còn gọi là Scylla.
Dialogue: 5,0:15:30.83,0:15:33.41,Default,,0,0,0,,Đó là tên của một con thủy quái trong thần thoại Hy Lạp.
Dialogue: 5,0:15:33.82,0:15:37.80,Default,,0,0,0,,Một chuyên gia chiến tranh từng chỉ huy quân ly khai, kiêm một phù thủy hacker...
Dialogue: 5,0:15:37.80,0:15:40.46,Default,,0,0,0,,Hừm, sở trường của hắn là chiến dịch đường hầm (tunnel ops).
Dialogue: 5,0:15:40.46,0:15:41.62,Default,,0,0,0,,"Chiến dịch đường hầm" sao?
Dialogue: 5,0:15:41.92,0:15:47.09,Default,,0,0,0,,Đó là khi cậu đánh bom các huyết mạch sinh hoạt của một nơi nào đó,\Nrồi thâm nhập điện tử vào chúng trong quá trình khôi phục sửa chữa.
Dialogue: 5,0:15:47.49,0:15:51.66,Default,,0,0,0,,Cuối cùng cậu tung ra một đòn tấn công mạng hủy diệt\Ntừ ngay bên trong phòng tuyến phòng thủ của chúng.
Dialogue: 5,0:15:51.66,0:15:56.22,Default,,0,0,0,,Các lực lượng cố ngăn chặn độc lập\Nngược lại đã phải chịu tổn thất nặng nề.
Dialogue: 5,0:15:56.22,0:16:02.56,Default,,0,0,0,,Nhưng Kuzan đã liên kết với các cường quốc tiên tiến để thao túng người Qhardi\Nnhằm kiềm chế các nước láng giềng.
Dialogue: 5,0:16:02.90,0:16:07.19,Default,,0,0,0,,Đó là một cuộc chiến tranh giành độc lập bị biến thành tốt thí,\Nvà đất nước này dính líu đặc biệt sâu đậm.
Dialogue: 5,0:16:07.19,0:16:12.36,Default,,0,0,0,,Sau chiến tranh chẳng ai công nhận nền độc lập của người Qhardi,\Nvà quân du kích đã bị giải tán rồi tàn sát.
Dialogue: 5,0:16:12.36,0:16:18.68,Default,,0,0,0,,Nhưng thủ lĩnh đã chết của họ thực chất vẫn còn sống,\Nvà hắn đã phát triển một loại virus đặc biệt đi trước tất cả các viện nghiên cứu trên thế giới,
Dialogue: 5,0:16:18.68,0:16:22.35,Default,,0,0,0,,rồi đổi tên thành Fire-Starter và bắt đầu công cuộc trả thù...
Dialogue: 5,0:16:22.35,0:16:24.50,Default,,0,0,0,,Tôi hiểu logic đó, nhưng chuyện đó thực sự khả thi sao?
Dialogue: 5,0:16:24.50,0:16:29.08,Default,,0,0,0,,Ở một vùng chiến sự, cậu có thể làm mọi thí nghiệm trên người tùy thích.
Dialogue: 5,0:16:29.08,0:16:30.77,Default,,0,0,0,,Chẳng có gì đáng ngạc nhiên cả, thực sự đấy.
Dialogue: 5,0:16:30.77,0:16:32.97,Default,,0,0,0,,Scylla đã chết rồi.
Dialogue: 5,0:16:33.42,0:16:35.30,Default,,0,0,0,,Vậy là một kẻ kế vị của hắn sao?
Dialogue: 5,0:16:35.30,0:16:38.99,Default,,0,0,0,,Dù sao đi nữa, kẻ môi giới không thể nào rao bán nó mà không biết công dụng của nó.
Dialogue: 5,0:16:39.82,0:16:44.69,Default,,0,0,0,,Vậy hắn muốn dùng đám du kích đó để lặp lại chiến dịch đường hầm cũ ở đây sao?
Dialogue: 5,0:16:44.98,0:16:48.47,Default,,0,0,0,,Tôi thấy cấn ở chỗ không ai trong số chúng mang theo kíp nổ cả.
Dialogue: 5,0:16:49.90,0:16:51.75,Default,,0,0,0,,Borma, hãy kiểm tra hiện trường vụ án.
Dialogue: 5,0:16:51.75,0:16:52.68,Default,,0,0,0,,Rõ.
Dialogue: 5,0:16:52.68,0:16:57.16,Default,,0,0,0,,Paz, cậu và Saito hãy đến thăm dò băng đảng đó. Tôi muốn biết ai đã huấn luyện chúng.
Dialogue: 5,0:16:57.57,0:17:00.33,Default,,0,0,0,,Batou và Ishikawa, hai người hãy xem xét khả năng xảy ra chiến dịch đường hầm.
Dialogue: 5,0:17:00.83,0:17:04.83,Default,,0,0,0,,Cô có định lặn vào não điện tử của đám du kích để tìm con virus đó không?
Dialogue: 5,0:17:07.32,0:17:09.56,Default,,0,0,0,,Tôi sẽ đi tinh chỉnh lại cơ thể mình trước đã.
Dialogue: 5,0:17:13.51,0:17:14.72,Default,,0,0,0,,Tinh chỉnh sao?
Dialogue: 5,0:17:14.72,0:17:18.26,Default,,0,0,0,,Bạn trai cô ấy đấy. Gã là một kỹ thuật viên thể máy cựu quân đội.
Dialogue: 5,0:17:18.26,0:17:20.00,Default,,0,0,0,,Chẳng phải gã đó là lính thủy quân lục chiến sao?
Dialogue: 5,0:17:20.00,0:17:21.56,Default,,0,0,0,,Đó là người trước rồi.
Dialogue: 5,0:17:21.56,0:17:25.27,Default,,0,0,0,,Họ cãi nhau trong buổi hẹn hò,\Nvà cô ấy sút vào mông hắn mạnh đến mức hắn phải nhập viện.
Dialogue: 5,0:17:26.63,0:17:28.68,Default,,0,0,0,,Thế còn gã nhà giàu bên Cục Não điện tử thì sao?
Dialogue: 5,0:17:28.68,0:17:30.86,Default,,0,0,0,,Hắn ta trụ không nổi hai tuần.
Dialogue: 5,0:17:30.86,0:17:33.82,Default,,0,0,0,,Vậy đây là người thứ sáu trong sáu tháng rồi à? Cô ấy bị bệnh nặng rồi.
Dialogue: 5,0:17:33.82,0:17:37.36,Default,,0,0,0,,Không, đó là bản năng. Tôi cũng chẳng bao giờ ngủ với một người phụ nữ hai lần.
Dialogue: 5,0:17:37.76,0:17:40.28,Default,,0,0,0,,Bởi vì anh luôn kết thúc bằng việc trở thành con tin hoặc mục tiêu trả thù chứ gì?
Dialogue: 5,0:17:40.28,0:17:41.91,Default,,0,0,0,,Không, bởi vì đó là nguyên tắc của tôi.
Dialogue: 5,0:17:42.22,0:17:46.02,Default,,0,0,0,,Ít nhất cũng phải điều tra lý lịch nhanh chứ! Lỡ một trong số họ là cái bẫy thì sao?
Dialogue: 5,0:17:46.02,0:17:48.59,Default,,0,0,0,,Dù sao cũng đỡ hơn việc phải nghe câu: "Em muốn có một gia đình".
Dialogue: 5,0:17:48.59,0:17:50.93,Default,,0,0,0,,Ừ, dù sao thì anh có thể chết bất cứ lúc nào mà.
Dialogue: 5,0:17:50.93,0:17:53.59,Default,,0,0,0,,Đây không phải là công việc dành cho người đàn ông của gia đình.
Dialogue: 5,0:17:59.34,0:18:02.96,Default,,0,0,0,,Vậy là khẩu súng của cố thanh tra vẫn chưa được tìm thấy sao?
Dialogue: 5,0:18:02.96,0:18:05.53,Default,,0,0,0,,Nếu Thanh tra Mizuki đã nổ súng,
Dialogue: 5,0:18:05.53,0:18:08.31,Default,,0,0,0,,điều đó sẽ chứng minh đây là một vụ án mạng, chứ không phải tai nạn.
Dialogue: 5,0:18:08.62,0:18:11.02,Default,,0,0,0,,Cậu nghĩ có kẻ muốn ngụy tạo nó thành một vụ tai nạn sao?
Dialogue: 5,0:18:11.40,0:18:15.28,Default,,0,0,0,,Nguyên nhân tử vong là do ngạt nước,\Nnhưng anh ấy đã mất rất nhiều máu trước khi chết,
Dialogue: 5,0:18:15.28,0:18:17.99,Default,,0,0,0,,và vài mảnh xương của anh ấy bị biến mất.
Dialogue: 5,0:18:18.47,0:18:24.20,Default,,0,0,0,,Thi thể bị hủy hoại quá nặng để kết luận, nhưng có thể anh ấy đã bị bắn.
Dialogue: 5,0:18:24.20,0:18:27.60,Default,,0,0,0,,Thanh tra Mizuki từng điều tra đường dây buôn lậu vũ khí.
Dialogue: 5,0:18:27.60,0:18:30.57,Default,,0,0,0,,Cuộc gặp gần đây nhất của anh ấy là với một tổ chức người Qhardi.
Dialogue: 5,0:18:30.57,0:18:33.96,Default,,0,0,0,,Tôi nghi ngờ anh ấy bị sát hại vì đã tìm ra chứng cứ.
Dialogue: 5,0:18:34.60,0:18:39.93,Default,,0,0,0,,Cậu cảm thấy vụ nổ con đập là cố ý, được dàn dựng để chôn vùi bằng chứng sao?
Dialogue: 5,0:18:40.54,0:18:42.81,Default,,0,0,0,,Trí tưởng tượng của cậu phong phú đấy.
Dialogue: 5,0:18:42.81,0:18:45.11,Default,,0,0,0,,Sếp từ chối tôi sao?
Dialogue: 5,0:18:45.11,0:18:47.77,Default,,0,0,0,,Không, tôi thích điều đó. Tôi cho phép cậu điều tra.
Dialogue: 5,0:18:48.09,0:18:50.48,Default,,0,0,0,,Hãy cố tìm ra mối liên hệ giữa các vụ việc đi.
Dialogue: 5,0:18:51.54,0:18:52.47,Default,,0,0,0,,Một mình tôi sao?
Dialogue: 5,0:18:53.22,0:18:54.23,Default,,0,0,0,,Cậu phàn nàn đấy à?
Dialogue: 5,0:18:55.14,0:18:56.20,Default,,0,0,0,,Tôi cảm ơn sếp nhiều lắm!
Dialogue: 5,0:19:00.40,0:19:03.92,Default,,0,0,0,,Con người không bao giờ có thể tái tạo hoàn hảo các chuyển động.
Dialogue: 5,0:19:03.92,0:19:09.05,Default,,0,0,0,,Một độ dốc nhỏ, khoảng cách tới mục tiêu, chênh lệch vài miligram trọng lượng...
Dialogue: 5,0:19:09.05,0:19:13.69,Default,,0,0,0,,Bộ não tính toán tất cả những điều đó để tạo ra những chuyển động chưa từng biết đến.
Dialogue: 5,0:19:13.69,0:19:18.52,Default,,0,0,0,,Em sở hữu bộ não nguyên bản độc đáo nhất mà anh từng biết,\Nvà em thấu hiểu vẻ đẹp của các tiêu chuẩn đồng nhất.
Dialogue: 5,0:19:20.94,0:19:22.14,Default,,0,0,0,,Anh đang tâng bốc quá lời rồi đấy.
Dialogue: 5,0:19:22.44,0:19:23.79,Default,,0,0,0,,Không có vấn đề gì với em cả.
Dialogue: 5,0:19:25.14,0:19:26.10,Default,,0,0,0,,Nó vẫn còn đau sao?
Dialogue: 5,0:19:29.58,0:19:31.10,Default,,0,0,0,,Thử cử động chân phải của em xem.
Dialogue: 5,0:19:33.71,0:19:34.67,Default,,0,0,0,,Đáng yêu thật.
Dialogue: 5,0:19:36.70,0:19:38.08,Default,,0,0,0,,Cái gì "đáng yêu" cơ?
Dialogue: 5,0:19:38.08,0:19:39.18,Default,,0,0,0,,Đôi chân của em.
Dialogue: 5,0:19:42.94,0:19:44.45,Default,,0,0,0,,Cơn đau biến mất rồi.
Dialogue: 5,0:19:45.46,0:19:47.13,Default,,0,0,0,,Gửi hóa đơn cho em đi.
Dialogue: 5,0:19:47.13,0:19:50.49,Default,,0,0,0,,Anh sẽ giảm giá cho em. Đổi lại, đừng quên lời hứa của chúng ta đấy.
Dialogue: 5,0:19:50.49,0:19:52.28,Default,,0,0,0,,Anh đúng là một người đàn ông kỳ lạ.
Dialogue: 5,0:19:52.28,0:19:53.63,Default,,0,0,0,,Chẳng kỳ lạ bằng em đâu.
Dialogue: 5,0:20:08.29,0:20:10.69,Default,,0,0,0,,Này, anh bạn. Anh đang chắn tầm quét của tôi đấy.
Dialogue: 5,0:20:10.69,0:20:12.27,Default,,0,0,0,,Ồ, xin lỗi.
Dialogue: 5,0:20:13.05,0:20:16.10,Default,,0,0,0,,Mắt thịt tự nhiên thì có tích sự gì trong thời đại mạng này chứ?
Dialogue: 5,0:20:16.10,0:20:19.14,Default,,0,0,0,,Bình thường đâu có khó tìm tâm chấn vụ nổ đến mức này.
Dialogue: 5,0:20:19.14,0:20:22.04,Default,,0,0,0,,Anh hiểu biết nhiều về quá trình cháy nổ nhỉ?
Dialogue: 5,0:20:22.04,0:20:24.64,Default,,0,0,0,,Tôi học được những điều cơ bản ở nước ngoài trong thời chiến.
Dialogue: 5,0:20:24.64,0:20:25.99,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 5,0:20:27.05,0:20:28.49,Default,,0,0,0,,Anh là thể nhân tạo toàn phần à?
Dialogue: 5,0:20:28.49,0:20:30.14,Default,,0,0,0,,Ừ, gần như vậy.
Dialogue: 5,0:20:31.26,0:20:37.30,Default,,0,0,0,,Tôi không phải chuyên gia, nhưng trừ khi lắp bộ khung xương chuyên dụng,\Nchẳng phải cấu tạo cơ bản cũng giống cơ thể người sao?
Dialogue: 5,0:20:37.30,0:20:40.20,Default,,0,0,0,,Nhưng hai bàn tay anh ta vẫn mở rộng sau khi bị thiêu cháy...
Dialogue: 5,0:20:40.20,0:20:40.96,Default,,0,0,0,,Cái gì cơ?
Dialogue: 5,0:20:41.43,0:20:47.22,Default,,0,0,0,,Khi một người bình thường bị thiêu chết, các cơ sẽ co rút lại,\Nkhiến bàn tay nắm chặt và cơ thể gập về phía trước.
Dialogue: 5,0:20:47.22,0:20:50.08,Default,,0,0,0,,Tư thế thai nhi, hoặc, anh biết đấy, tư thế võ sĩ quyền anh.
Dialogue: 5,0:20:50.08,0:20:51.87,Default,,0,0,0,,Co cứng do nhiệt à?
Dialogue: 5,0:20:51.87,0:20:52.93,Default,,0,0,0,,Thế thì sao nào?
Dialogue: 5,0:20:53.34,0:20:55.41,Default,,0,0,0,,Thi thể người bảo vệ này
Dialogue: 5,0:20:56.53,0:20:59.36,Default,,0,0,0,,lại đứng thẳng tắp, hai bàn tay mở rộng.
Dialogue: 5,0:20:59.36,0:21:02.87,Default,,0,0,0,,Ắt hẳn là do đặc tính của thể máy của anh ta, hoặc là do loại bom.
Dialogue: 5,0:21:02.87,0:21:03.72,Default,,0,0,0,,Thể máy sao?
Dialogue: 5,0:21:10.65,0:21:11.41,Default,,0,0,0,,Alo?
Dialogue: 5,0:21:13.40,0:21:14.75,Default,,0,0,0,,Ồ, khám thai à?
Dialogue: 5,0:21:15.52,0:21:16.72,Default,,0,0,0,,Hai tuần nữa sao?
Dialogue: 5,0:21:17.70,0:21:18.48,Default,,0,0,0,,Anh nhớ rồi.
Dialogue: 5,0:21:19.26,0:21:21.34,Default,,0,0,0,,Không, anh đang làm việc, xin lỗi nhé.
Dialogue: 5,0:21:21.83,0:21:22.76,Default,,0,0,0,,"Khám thai"?
Dialogue: 5,0:21:25.04,0:21:26.51,Default,,0,0,0,,Xin lỗi vì đã làm phiền anh.
Dialogue: 5,0:21:35.31,0:21:38.90,Default,,0,0,0,,C-4 và thuốc nổ dynamite, glycerin, và phân bón hóa học...
Dialogue: 5,0:21:39.22,0:21:41.16,Default,,0,0,0,,Một nơi ẩn náu y hệt bước ra từ sách giáo khoa.
Dialogue: 5,0:21:42.30,0:21:44.71,Default,,0,0,0,,Đậm đặc phong cách của một kẻ cuồng bom.
Dialogue: 5,0:21:45.63,0:21:48.82,Default,,0,0,0,,Nhưng tôi chẳng có manh mối nào về thứ chúng thực sự đã dùng.
Dialogue: 5,0:21:49.14,0:21:50.78,Default,,0,0,0,,Mệnh lệnh đang được truyền xuống đường dây của chúng!
Dialogue: 5,0:21:51.44,0:21:54.50,Default,,0,0,0,,Một kẻ tự xưng là Scylla vừa ra lệnh cho "Đạo quân Thứ hai" xuất kích.
Dialogue: 5,0:21:54.50,0:21:57.71,Default,,0,0,0,,Đồ khốn kiếp! Động thái của An ninh Công cộng đang bị rò rỉ!
Dialogue: 5,0:22:03.63,0:22:06.87,Default,,0,0,0,,Máy chủ của Cục Cấp nước vừa phát nổ, thổi bay toàn bộ tầng lầu.
Dialogue: 5,0:22:06.87,0:22:08.24,Default,,0,0,0,,Chúng đã sử dụng thứ gì thế?
Dialogue: 5,0:22:08.24,0:22:13.28,Default,,0,0,0,,Chất gia tốc cháy tại hiện trường Nishinouchi lan tỏa khắp trần nhà, thậm chí cả các đường ống dẫn.
Dialogue: 5,0:22:13.28,0:22:17.79,Default,,0,0,0,,Chúng ta đang nói về vụ nổ đa hướng. Chính không khí đã phát nổ.
Dialogue: 5,0:22:17.79,0:22:18.98,Default,,0,0,0,,Bom nhiệt áp (nổ thể khí / FAE) sao?
Dialogue: 5,0:22:18.98,0:22:20.84,Default,,0,0,0,,Vậy thì đây chỉ là một nơi ẩn náu bù nhìn thôi.
Dialogue: 5,0:22:20.84,0:22:23.94,Default,,0,0,0,,Bọn chúng có một phòng chế tạo bom tối tân hơn ở đâu đó.
Dialogue: 5,0:22:28.82,0:22:31.87,Default,,0,0,0,,Tên anh hùng du kích chết tiệt đang gửi lời thách thức đấy.
Dialogue: 5,0:22:38.70,0:22:40.79,Default,,0,0,0,,Cục Cấp nước đang bắt đầu công tác sửa chữa.
Dialogue: 5,0:22:40.79,0:22:43.80,Default,,0,0,0,,Rất có thể tên hacker đã đột nhập vào trong rồi!
Dialogue: 5,0:22:43.80,0:22:45.62,Default,,0,0,0,,Hãy tìm ra mục tiêu tiếp theo của chúng.
Dialogue: 5,0:22:45.62,0:22:47.52,Default,,0,0,0,,Đừng để chúng đào thêm bất kỳ đường hầm nào nữa.
Dialogue: 5,0:23:07.89,0:23:09.32,Default,,0,0,0,,Tôi rất cảm kích sự hợp tác của anh.
Dialogue: 5,0:23:10.06,0:23:12.32,Default,,0,0,0,,Tôi quen với việc bị cảnh sát thẩm vấn rồi.
Dialogue: 5,0:23:12.32,0:23:14.78,Default,,0,0,0,,Gần đây có rất nhiều vụ trộm cắp thể máy.
Dialogue: 5,0:23:15.42,0:23:18.29,Default,,0,0,0,,"Đôi chân Người cá", hả?
Dialogue: 5,0:23:18.75,0:23:21.50,Default,,0,0,0,,Không phải cái tên nghệ thuật cho lắm, nhưng rất dễ hiểu.
Dialogue: 5,0:23:21.86,0:23:24.02,Default,,0,0,0,,Khách hàng nữ của tôi khá thích nó.
Dialogue: 5,0:23:24.02,0:23:26.21,Default,,0,0,0,,Anh có nhận ra đôi chân này không?
Dialogue: 5,0:23:28.81,0:23:30.38,Default,,0,0,0,,Trông nó có vẻ là mẫu sản xuất hàng loạt.
Dialogue: 5,0:23:30.78,0:23:32.25,Default,,0,0,0,,Hãy nhìn vào nhãn hiệu đi.
Dialogue: 5,0:23:34.34,0:23:35.31,Default,,0,0,0,,"Ariel".
Dialogue: 5,0:23:35.90,0:23:39.60,Default,,0,0,0,,Tôi đã dò hỏi khắp nơi, không có mẫu nào như vậy trên thị trường cả.
Dialogue: 5,0:23:39.60,0:23:41.22,Default,,0,0,0,,Tôi cũng không bán loại đó.
Dialogue: 5,0:23:41.22,0:23:43.27,Default,,0,0,0,,Nó hẳn là tên thương hiệu của một nhà thiết kế được cấp phép.
Dialogue: 5,0:23:43.90,0:23:48.43,Default,,0,0,0,,Các nhà thiết kế lấy mẫu sản xuất hàng loạt làm nền tảng rồi cải tiến để đáp ứng yêu cầu của khách hàng.
Dialogue: 5,0:23:48.43,0:23:49.61,Default,,0,0,0,,Có gợi ý nào không?
Dialogue: 5,0:23:50.56,0:23:52.32,Default,,0,0,0,,Tôi sẽ đưa cho anh danh sách của tôi.
Dialogue: 5,0:23:52.78,0:23:54.15,Default,,0,0,0,,Xin chờ một chút.
Dialogue: 5,0:23:55.18,0:23:56.24,Default,,0,0,0,,Cảm ơn anh.
Dialogue: 5,0:24:05.44,0:24:06.96,Default,,0,0,0,,Cảnh sát khoái danh sách lắm.
Dialogue: 5,0:24:07.46,0:24:09.28,Default,,0,0,0,,Hắn ta sẽ tiện thể bị cuốn vào đó một thời gian.
Dialogue: 5,0:24:09.28,0:24:11.84,Default,,0,0,0,,An ninh Công cộng đã chiếm được nơi ẩn náu nghi binh của chúng ta.
Dialogue: 5,0:24:11.84,0:24:15.14,Default,,0,0,0,,Đường truyền liên lạc ở đây có an toàn không, Đại tá Hozumi?
Dialogue: 5,0:24:15.50,0:24:18.64,Default,,0,0,0,,Đừng lo. Đó là một trong những đường truyền độc lập của Cục Tình báo.
Dialogue: 5,0:24:18.64,0:24:21.10,Default,,0,0,0,,Tại sao bà vẫn chưa trừ khử tên thanh tra đó?
Dialogue: 5,0:24:21.10,0:24:24.06,Default,,0,0,0,,Hắn là một gã lập dị, nhưng chẳng có kẻ chống lưng quyền lực nào cả.
Dialogue: 5,0:24:24.62,0:24:26.79,Default,,0,0,0,,Vấn đề thực sự là Ariel đã bị rò rỉ.
Dialogue: 5,0:24:26.79,0:24:30.96,Default,,0,0,0,,Chúng tôi đã thu hồi mẫu thử trước khi nó bị phân tích, và nhà máy đã được dọn dẹp sạch sẽ.
Dialogue: 5,0:24:30.96,0:24:33.31,Default,,0,0,0,,Tôi không ngờ bà lại hoảng loạn và cho nổ tung nó.
Dialogue: 5,0:24:33.31,0:24:36.37,Default,,0,0,0,,Chúng ta may mắn là Ariel đã được lắp đặt kịp thời.
Dialogue: 5,0:24:36.37,0:24:39.29,Default,,0,0,0,,Bà suýt nữa đã cản trở nghiêm trọng kế hoạch của chúng ta rồi đấy.
Dialogue: 5,0:24:39.66,0:24:43.25,Default,,0,0,0,,Ariel là phương thức để tuồn chất nổ cho người Qhardi!
Dialogue: 5,0:24:43.70,0:24:44.83,Default,,0,0,0,,Nó không phải dành cho những kẻ đánh bom tự sát!
Dialogue: 5,0:24:45.65,0:24:47.45,Default,,0,0,0,,Tình thế đã thay đổi rồi.
Dialogue: 5,0:24:47.45,0:24:53.05,Default,,0,0,0,,Nếu các dự án phát triển vũ khí ở nước ngoài chuyển thành nội địa, các kênh phân phối sẽ biến mất.
Dialogue: 5,0:24:53.55,0:24:55.51,Default,,0,0,0,,Những người lính Qhardi chỉ là những con tốt thí thôi sao?
Dialogue: 5,0:24:55.85,0:24:57.32,Default,,0,0,0,,Chúng ta đang nâng cấp.
Dialogue: 5,0:24:57.32,0:25:00.88,Default,,0,0,0,,Fire-Starter có thể tạo ra bao nhiêu binh lính tùy thích.
Dialogue: 5,0:25:00.88,0:25:03.23,Default,,0,0,0,,Hãy giải cứu đơn vị vừa bị bắt giữ đi.
Dialogue: 5,0:25:03.85,0:25:05.76,Default,,0,0,0,,Tôi sẽ không giao dữ liệu cho bà cho đến khi việc đó được thực hiện.
Dialogue: 5,0:25:06.75,0:25:08.69,Default,,0,0,0,,Bọn chúng thậm chí còn không phải đồng bào của anh.
Dialogue: 5,0:25:09.34,0:25:11.86,Default,,0,0,0,,Scylla sẽ không bao giờ bỏ rơi họ.
Dialogue: 5,0:25:13.72,0:25:17.62,Default,,0,0,0,,Được thôi. Vẫn còn ba bộ Ariel có thể sử dụng được.
Dialogue: 5,0:25:17.97,0:25:20.58,Default,,0,0,0,,Một trong số đó nằm trong sân nhà của anh.
Dialogue: 5,0:25:21.49,0:25:23.04,Default,,0,0,0,,Nhất thiết phải là cô ấy sao?
Dialogue: 5,0:25:23.53,0:25:25.24,Default,,0,0,0,,Đã nảy sinh tình cảm với cô ta rồi à?
Dialogue: 5,0:25:25.24,0:25:27.25,Default,,0,0,0,,Kích hoạt bộ Ariel của ả đàn bà đó đi.
Dialogue: 5,0:25:27.70,0:25:30.50,Default,,0,0,0,,Thả đồng minh của chúng ta ra trước. Hiểu chưa?
Dialogue: 5,0:25:56.13,0:25:57.03,Default,,0,0,0,,Lên xe đi cùng tôi.
Dialogue: 5,0:26:03.51,0:26:07.47,Default,,0,0,0,,Cô không nói với ai chuyện tôi và cô đã giết Scylla đấy chứ?
Dialogue: 5,0:26:07.47,0:26:08.49,Default,,0,0,0,,Không.
Dialogue: 5,0:26:08.49,0:26:11.24,Default,,0,0,0,,Chiến dịch đó là một vết nhơ trong hồ sơ của cả hai chúng ta.
Dialogue: 5,0:26:11.24,0:26:13.89,Default,,0,0,0,,Sẽ vô cùng bất tiện nếu chuyện đó bị khơi lại vào lúc này.
Dialogue: 5,0:26:13.89,0:26:17.93,Default,,0,0,0,,Tôi thấy cô vui vẻ lao vào trò chơi quyền lực ngay khi vừa lên Trung tá nhỉ.
Dialogue: 5,0:26:18.53,0:26:22.58,Default,,0,0,0,,Bọn họ đã dùng tổ hợp công nghiệp quân sự để trục lợi từ cái chết.
Dialogue: 5,0:26:22.58,0:26:28.78,Default,,0,0,0,,Tôi sẽ xóa sổ chúng, phát triển mạnh ngành kỹ thuật vũ khí nội địa, và chặt đứt các tuyến đường thương mại tới các tập đoàn ngoại quốc.
Dialogue: 5,0:26:28.78,0:26:31.15,Default,,0,0,0,,Trung tá Mamuro từng mong muốn điều đó.
Dialogue: 5,0:26:31.59,0:26:33.82,Default,,0,0,0,,Tôi sẽ không chơi trò chơi của cô đâu.
Dialogue: 5,0:26:34.22,0:26:36.89,Default,,0,0,0,,Scylla là một trò chơi mà cô không thể bỏ cuộc giữa chừng.
Dialogue: 5,0:26:36.89,0:26:38.99,Default,,0,0,0,,Hắn buộc phải tiếp tục chết.
Dialogue: 5,0:26:39.96,0:26:41.53,Default,,0,0,0,,Cô từng dùng thứ này trước đây rồi.
Dialogue: 5,0:26:42.74,0:26:46.19,Default,,0,0,0,,Hãy chôn vùi nó cùng bất kỳ kẻ nào đang mượn danh Scylla—lần này là vĩnh viễn.
Dialogue: 5,0:26:46.19,0:26:49.72,Default,,0,0,0,,Nếu không thì cấp trên sẽ chôn vùi chính cô, cùng với chiến dịch đó đấy.
Dialogue: 5,0:26:58.20,0:27:01.64,Default,,0,0,0,,Độc lập khỏi hệ thống không có nghĩa là cô được tự do.
Dialogue: 5,0:27:01.64,0:27:06.06,Default,,0,0,0,,Cô chẳng khác nào đám lập trình viên của thế kỷ trước,\Nnhững kẻ đã kỳ vọng quá nhiều vào sự ra đời của Mạng lưới.
Dialogue: 5,0:27:06.79,0:27:10.44,Default,,0,0,0,,Ngay cả Đội 9 cũng chỉ đang để cô làm theo ý mình nhằm thử thách cô thôi.
Dialogue: 5,0:27:10.44,0:27:14.62,Default,,0,0,0,,Khi cần thiết, họ sẽ khống chế cô bằng một chiếc chìa khóa thâm nhập Hồn rồi thủ tiêu cô.
Dialogue: 5,0:27:14.62,0:27:17.93,Default,,0,0,0,,Tôi không có ý định để bất kỳ ai thâm nhập vào Hồn của mình một lần nữa đâu.
Dialogue: 5,0:27:17.93,0:27:19.78,Default,,0,0,0,,Bất kể người đó là ai đi nữa.
Dialogue: 5,0:27:26.47,0:27:28.56,Default,,0,0,0,,Người phụ nữ đó là Kusanagi Motoko sao?
Dialogue: 5,0:27:29.26,0:27:31.18,Default,,0,0,0,,Phải, tiền bối của cô đấy.
Dialogue: 5,0:27:31.18,0:27:32.21,Default,,0,0,0,,Cô có thể thắng không?
Dialogue: 5,0:27:35.78,0:27:37.53,Default,,0,0,0,,Nếu bà muốn.
Dialogue: 5,0:28:03.86,0:28:05.62,Default,,0,0,0,,Em thực sự đã đến sao?
Dialogue: 5,0:28:06.28,0:28:07.70,Default,,0,0,0,,Em đã hứa rồi mà.
Dialogue: 5,0:28:08.63,0:28:10.47,Default,,0,0,0,,Anh chưa chuẩn bị được gì cả.
Dialogue: 5,0:28:10.47,0:28:11.66,Default,,0,0,0,,Em đoán được rồi.
Dialogue: 5,0:28:18.30,0:28:20.55,Default,,0,0,0,,Nhưng trước tiên, chúng ta sẽ giải quyết việc này đã.
Dialogue: 5,0:28:32.34,0:28:37.24,Default,,0,0,0,,Tôi đã kiểm tra băng đảng Qhardi, nhưng không có dấu vết nào về chỉ huy chiến thuật của chúng.
Dialogue: 5,0:28:37.24,0:28:40.57,Default,,0,0,0,,À, nhưng tôi đã có được máy chủ cho thuê mà chúng đã dùng.
Dialogue: 5,0:28:41.23,0:28:43.41,Default,,0,0,0,,Nhiều kẻ xâm nhập vào một cơ sở công cộng...
Dialogue: 5,0:28:43.41,0:28:45.60,Default,,0,0,0,,Lũ khốn đó đã tiến triển rất tốt trên các đường hầm của chúng.
Dialogue: 5,0:28:45.60,0:28:47.53,Default,,0,0,0,,Đã biết chúng đang hướng tới đâu chưa?
Dialogue: 5,0:28:47.84,0:28:50.43,Default,,0,0,0,,Nơi nào đó liên quan đến nước và máy móc chính xác.
Dialogue: 5,0:28:50.43,0:28:53.40,Default,,0,0,0,,Có 78 địa điểm trong thành phố phù hợp với mô tả đó.
Dialogue: 5,0:28:53.40,0:28:55.04,Default,,0,0,0,,Kiểm tra tất cả bọn chúng đi.
Dialogue: 5,0:28:55.78,0:29:00.00,Default,,0,0,0,,Chết tiệt... Thà làm nhà thầu phụ cho Cục Tình báo kiếm tiền còn dễ hơn.
Dialogue: 5,0:29:00.50,0:29:03.09,Default,,0,0,0,,Vậy là, cô vẫn đang trong đợt "tinh chỉnh" đấy à?
Dialogue: 5,0:29:03.09,0:29:05.47,Default,,0,0,0,,Phải. Tôi sẽ ngắt kết nối này một lát.
Dialogue: 5,0:29:06.49,0:29:08.36,Default,,0,0,0,,Anh có thể nghe thấy tiếng ồn.
Dialogue: 5,0:29:08.36,0:29:11.80,Default,,0,0,0,,Đồng nghiệp của em ra vào sảnh của em liên tục nhỉ?
Dialogue: 5,0:29:11.80,0:29:13.31,Default,,0,0,0,,Em đuổi bọn họ đi hết rồi.
Dialogue: 5,0:29:13.73,0:29:16.27,Default,,0,0,0,,Em có nghĩ anh sẽ có ngày được bước vào sảnh của em không?
Dialogue: 5,0:29:17.49,0:29:19.97,Default,,0,0,0,,Nếu anh làm việc cùng em.
Dialogue: 5,0:29:19.97,0:29:22.94,Default,,0,0,0,,Nếu em nói em cần thêm một người nữa, anh sẽ đến chứ?
Dialogue: 5,0:29:25.11,0:29:27.70,Default,,0,0,0,,Được tinh chỉnh cho em bất cứ khi nào anh muốn là một lời đề nghị rất hấp dẫn,
Dialogue: 5,0:29:28.61,0:29:31.03,Default,,0,0,0,,nhưng anh không muốn dính líu đến quân đội hay cảnh sát.
Dialogue: 5,0:29:32.10,0:29:32.91,Default,,0,0,0,,Ồ.
Dialogue: 5,0:29:36.26,0:29:38.36,Default,,0,0,0,,Anh vừa sơ cứu một chút cho các bộ phận cảm giác của em.
Dialogue: 5,0:29:38.36,0:29:40.00,Default,,0,0,0,,Chúng ta hãy làm công việc chi tiết trong phòng thí nghiệm nhé.
Dialogue: 5,0:29:41.02,0:29:42.80,Default,,0,0,0,,Cơn đau đã tan biến rồi.
Dialogue: 5,0:29:42.80,0:29:44.38,Default,,0,0,0,,Phần còn lại em sẽ tự làm.
Dialogue: 5,0:29:48.89,0:29:50.22,Default,,0,0,0,,Vậy thì chúng ta bắt đầu thôi.
Dialogue: 5,0:29:57.24,0:29:59.56,Default,,0,0,0,,Anh vẫn nhớ lần đầu tiên gặp em đấy.
Dialogue: 5,0:30:00.62,0:30:05.28,Default,,0,0,0,,Tất cả các kỹ sư khác đều bảo em là nữ hoàng khiếu nại khách hàng.
Dialogue: 5,0:30:05.55,0:30:07.99,Default,,0,0,0,,Đó là lý do tại sao họ đẩy em cho một kẻ làm việc tự do như anh sao?
Dialogue: 5,0:30:08.68,0:30:10.95,Default,,0,0,0,,Không phải đâu. Sự thật là, chính anh đã xin họ đấy.
Dialogue: 5,0:30:11.78,0:30:12.46,Default,,0,0,0,,Cái gì cơ?
Dialogue: 5,0:30:13.82,0:30:19.88,Default,,0,0,0,,Em không thể quyết định xem mình nên đối xử với cơ thể mình như một đồ vật hay một con người.
Dialogue: 5,0:30:21.22,0:30:23.07,Default,,0,0,0,,Điều đó khiến anh thấy hứng thú với em.
Dialogue: 5,0:30:29.52,0:30:34.72,Default,,0,0,0,,Ở cơ sở trước đây em từng ở, họ coi em là kẻ dị biệt\Nvì em muốn ngủ trên giường và tắm dưới vòi sen.
Dialogue: 5,0:30:35.27,0:30:38.21,Default,,0,0,0,,Khi em được lắp thể máy trên chiến trường, họ bảo em:
Dialogue: 5,0:30:38.21,0:30:41.73,Default,,0,0,0,,"Một cyborg không cần cuộc sống thường ngày; hắn chỉ cần trang bị vũ khí thôi."
Dialogue: 5,0:30:42.98,0:30:44.90,Default,,0,0,0,,Đó là lý do tại sao anh chuyển sang ngành kỹ thuật thể máy.
Dialogue: 5,0:30:46.17,0:30:49.36,Default,,0,0,0,,Anh muốn trở thành một kỹ thuật viên đối xử với các cyborg như những con người.
Dialogue: 5,0:30:51.11,0:30:55.87,Default,,0,0,0,,Hồi còn nhỏ, họ đã huấn luyện kỹ năng sống thường nhật cho em bên ngoài cơ sở.
Dialogue: 5,0:30:55.87,0:30:58.33,Default,,0,0,0,,Để em học cách làm một con người hơn.
Dialogue: 5,0:30:59.26,0:31:00.83,Default,,0,0,0,,Em không thực sự nhớ rõ về nó.
Dialogue: 5,0:31:01.71,0:31:03.58,Default,,0,0,0,,Mọi thứ đều quá đỗi chói lòa...
Dialogue: 5,0:31:04.46,0:31:07.16,Default,,0,0,0,,Em nhớ mình đã trở về trước thời hạn.
Dialogue: 5,0:31:09.15,0:31:13.39,Default,,0,0,0,,Nhưng... ngày hôm đó em đã quyết định giữ cơ thể mình theo chuẩn mực truyền thống.
Dialogue: 5,0:31:13.82,0:31:15.92,Default,,0,0,0,,Em muốn trông giống một con người.
Dialogue: 5,0:31:15.92,0:31:18.13,Default,,0,0,0,,Cơ thể nhân tạo của em không phải là một món đồ vật.
Dialogue: 5,0:31:18.13,0:31:19.91,Default,,0,0,0,,Nó chính là cơ thể thực sự của em.
Dialogue: 5,0:31:19.91,0:31:23.15,Default,,0,0,0,,Nó không được phép bị đối xử như một đồ vật... Không bởi bất kỳ ai.
Dialogue: 5,0:31:24.90,0:31:26.10,Default,,0,0,0,,Kể cả bởi chính em.
Dialogue: 5,0:31:27.96,0:31:29.98,Default,,0,0,0,,Em cũng ước được như vậy.
Dialogue: 5,0:31:29.98,0:31:31.68,Default,,0,0,0,,Anh sẽ cho em thấy bằng chứng.
Dialogue: 5,0:31:31.68,0:31:32.78,Default,,0,0,0,,Bằng chứng sao?
Dialogue: 5,0:31:35.84,0:31:37.37,Default,,0,0,0,,Đó là một bất ngờ.
Dialogue: 5,0:31:40.93,0:31:42.83,Default,,0,0,0,,Chúng ta đang thiếu mất mảnh ghép quan trọng: quả bom.
Dialogue: 5,0:31:43.13,0:31:47.04,Default,,0,0,0,,Làm sao chúng đưa được nó vào một địa điểm họp được canh phòng cẩn mật như thế?
Dialogue: 5,0:31:47.04,0:31:48.05,Default,,0,0,0,,Thế còn đám thủ phạm thì sao?
Dialogue: 5,0:31:48.05,0:31:50.51,Default,,0,0,0,,Bọn chúng bảo chính chúng là kẻ đã cho nổ tung nơi đó.
Dialogue: 5,0:31:51.02,0:31:53.97,Default,,0,0,0,,Mặc dù thực tế là chúng chẳng có chút ký ức nào về quả bom cả.
Dialogue: 5,0:31:53.97,0:31:57.71,Default,,0,0,0,,Bọn chúng chỉ là những kẻ chịu tội thay thôi.\NCó lẽ chúng chẳng liên quan gì đến quả bom cả.
Dialogue: 5,0:31:57.71,0:32:01.84,Default,,0,0,0,,Chúng ta sẽ giám sát toàn bộ 78 địa điểm cho đến khi thu hẹp được mục tiêu của chúng.
Dialogue: 5,0:32:01.84,0:32:03.58,Default,,0,0,0,,Cô nghiêm túc đấy chứ?!
Dialogue: 5,0:32:03.58,0:32:05.33,Default,,0,0,0,,Liên lạc với tôi nếu có chuyện gì xảy ra.
Dialogue: 5,0:32:09.07,0:32:10.64,Default,,0,0,0,,Cô đang đi giày cao gót kìa.
Dialogue: 5,0:32:10.64,0:32:14.26,Default,,0,0,0,,Chúng ta có nên cho rằng anh chàng kỹ thuật viên cựu quân đội sẽ gia nhập đội không?
Dialogue: 5,0:32:18.14,0:32:19.88,Default,,0,0,0,,Có khi chuyện đó là thật đấy.
Dialogue: 5,0:32:31.55,0:32:33.47,Default,,0,0,0,,Đây là thứ anh muốn cho em xem sao?
Dialogue: 5,0:32:34.24,0:32:35.89,Default,,0,0,0,,Họ là những khách hàng thường xuyên của anh.
Dialogue: 5,0:32:36.26,0:32:38.35,Default,,0,0,0,,Độ tuổi trung bình của họ là 70.
Dialogue: 5,0:32:39.55,0:32:41.31,Default,,0,0,0,,Tất cả họ đều là thể nhân tạo toàn phần...
Dialogue: 5,0:32:41.66,0:32:45.24,Default,,0,0,0,,Những người cao tuổi giàu có đang là cốt lõi của ngành phát triển cyborg ngày nay.
Dialogue: 5,0:32:45.24,0:32:46.52,Default,,0,0,0,,Chứ không phải binh lính.
Dialogue: 5,0:32:46.84,0:32:51.24,Default,,0,0,0,,Họ muốn cơ thể nhân tạo mang lại cho họ cuộc đời thứ hai, và một phong cách sống trọn vẹn.
Dialogue: 5,0:32:52.22,0:32:56.12,Default,,0,0,0,,Ngày càng nhiều loại thực phẩm cho cyborg được phát triển để đáp ứng nhu cầu của họ nữa.
Dialogue: 5,0:33:03.94,0:33:04.95,Default,,0,0,0,,Nếm thử đi.
Dialogue: 5,0:33:17.82,0:33:18.85,Default,,0,0,0,,Ngon lắm.
Dialogue: 5,0:33:19.56,0:33:21.95,Default,,0,0,0,,Đây là lần đầu tiên em phân bổ bộ nhớ cho vị giác của mình à?
Dialogue: 5,0:33:23.91,0:33:26.27,Default,,0,0,0,,Tiện thể, cô dâu mới đang mang thai đấy.
Dialogue: 5,0:33:27.96,0:33:29.56,Default,,0,0,0,,Thú vị đúng không?
Dialogue: 5,0:33:29.56,0:33:33.28,Default,,0,0,0,,Một thế giới mới của những con người không còn phân biệt\Ngiữa thể máy và da thịt.
Dialogue: 5,0:33:34.78,0:33:37.10,Default,,0,0,0,,Anh thực sự rất kỳ lạ.
Dialogue: 5,0:33:44.62,0:33:47.86,Default,,0,0,0,,Có những người cự tuyệt tương lai.
Dialogue: 5,0:33:47.86,0:33:51.46,Default,,0,0,0,,Và cũng có những người bị nó bỏ lại phía sau.
Dialogue: 5,0:33:55.42,0:33:58.63,Default,,0,0,0,,Anh muốn mang tương lai của cyborg đến với thế giới thứ ba.
Dialogue: 5,0:34:00.89,0:34:02.29,Default,,0,0,0,,Em sẽ đi cùng anh chứ?
Dialogue: 5,0:34:04.14,0:34:06.90,Default,,0,0,0,,Em nên sử dụng sức mạnh của mình một cách tự do,
Dialogue: 5,0:34:07.74,0:34:10.69,Default,,0,0,0,,chứ không phải làm việc dưới trướng một đám giật dây con rối.
Dialogue: 5,0:34:13.19,0:34:15.33,Default,,0,0,0,,Chiến tranh đã kết thúc rồi mà.
Dialogue: 5,0:34:15.33,0:34:17.01,Default,,0,0,0,,Không, nó vẫn đang tiếp diễn.
Dialogue: 5,0:34:17.01,0:34:20.44,Default,,0,0,0,,Chỉ là các quốc gia cảm thấy bất tiện nên rút lui thôi, chỉ có vậy.
Dialogue: 5,0:34:23.62,0:34:26.59,Default,,0,0,0,,Em còn những việc phải làm ở đất nước này.
Dialogue: 5,0:34:28.00,0:34:28.95,Default,,0,0,0,,Anh hiểu rồi.
Dialogue: 5,0:34:29.82,0:34:31.42,Default,,0,0,0,,Lát nữa em có rảnh không?
Dialogue: 5,0:34:31.42,0:34:35.26,Default,,0,0,0,,Nếu chúng ta chia sẻ sảnh không gian mạng, chúng ta có thể gặp nhau bất cứ lúc nào muốn.
Dialogue: 5,0:34:35.26,0:34:37.38,Default,,0,0,0,,Anh có thể sẽ chạm vào Hồn của em đấy.
Dialogue: 5,0:34:37.38,0:34:39.41,Default,,0,0,0,,Em sẽ hạ màng chắn xuống.
Dialogue: 5,0:34:39.41,0:34:40.36,Default,,0,0,0,,Em chắc chắn chứ?
Dialogue: 5,0:34:40.36,0:34:43.00,Default,,0,0,0,,Nếu anh thâm nhập vào em, em có thể nướng chín não anh đấy.
Dialogue: 5,0:34:43.00,0:34:44.69,Default,,0,0,0,,Có khi thế lại đáng giá.
Dialogue: 5,0:35:07.92,0:35:09.50,Default,,0,0,0,,Đây là cơ thể của em.
Dialogue: 5,0:35:11.71,0:35:13.54,Default,,0,0,0,,Đây là đôi bàn tay của em.
Dialogue: 5,0:35:39.36,0:35:40.87,Default,,0,0,0,,Motoko, chạy mau!
Dialogue: 5,0:36:16.16,0:36:16.86,Default,,0,0,0,,Akira!
Dialogue: 5,0:36:19.03,0:36:19.84,Default,,0,0,0,,Em có sao không?
Dialogue: 5,0:36:21.11,0:36:22.45,Default,,0,0,0,,Ừ...
Dialogue: 5,0:36:30.79,0:36:32.04,Default,,0,0,0,,Anh xin lỗi.
Dialogue: 5,0:36:32.04,0:36:33.37,Default,,0,0,0,,Đây là lỗi của anh.
Dialogue: 5,0:37:12.32,0:37:13.62,Default,,0,0,0,,Rất tiếc khi nghe về những gì vừa xảy ra.
Dialogue: 5,0:37:14.91,0:37:16.83,Default,,0,0,0,,Paz đang cùng Đội 9 kiểm tra hiện trường.
Dialogue: 5,0:37:17.54,0:37:20.05,Default,,0,0,0,,Kẻ tấn công cô là một tay chuyên nghiệp, dù hắn đã bắn trượt.
Dialogue: 5,0:37:20.58,0:37:22.77,Default,,0,0,0,,Chưa rõ liệu việc này có liên hệ với vụ đánh bom hay không,
Dialogue: 5,0:37:22.77,0:37:25.60,Default,,0,0,0,,nhưng bình thường thì chúng tôi sẽ cử cảnh sát bảo vệ cô vào lúc này.
Dialogue: 5,0:37:25.60,0:37:26.85,Default,,0,0,0,,Tôi không cần.
Dialogue: 5,0:37:26.85,0:37:28.00,Default,,0,0,0,,Anh ấy thế nào rồi?
Dialogue: 5,0:37:28.00,0:37:30.48,Default,,0,0,0,,Chúng tôi sẽ cho anh ta về nhà ngay sau khi thẩm vấn xong.
Dialogue: 5,0:37:30.48,0:37:32.52,Default,,0,0,0,,Tôi sẽ cắt cử người đi cùng anh ta, nên đừng lo.
Dialogue: 5,0:37:32.52,0:37:33.77,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 5,0:37:33.77,0:37:37.10,Default,,0,0,0,,Giới chức quân đội không chịu cung cấp cho tôi bất kỳ thông tin nào về Scylla cả.
Dialogue: 5,0:37:37.10,0:37:38.89,Default,,0,0,0,,Mối liên hệ giữa cô và hắn là gì?
Dialogue: 5,0:37:41.46,0:37:43.49,Default,,0,0,0,,Hãy gọi cho tôi bất cứ khi nào cô cần giúp đỡ.
Dialogue: 5,0:37:47.35,0:37:49.40,Default,,0,0,0,,Scylla trả thù à?
Dialogue: 5,0:37:49.40,0:37:51.45,Default,,0,0,0,,Cũng may bạn trai cô là dân thường.
Dialogue: 5,0:37:51.79,0:37:53.63,Default,,0,0,0,,Chúng ta không phải nghi ngờ có tin rò rỉ.
Dialogue: 5,0:37:55.82,0:37:56.79,Default,,0,0,0,,Bọn chúng lại ra tay rồi.
Dialogue: 5,0:37:57.42,0:38:00.80,Default,,0,0,0,,Mục tiêu số ba: một trung tâm điều phối nguyên vật liệu ở bờ biển.
Dialogue: 5,0:38:01.26,0:38:05.49,Default,,0,0,0,,Tôi bắt được một lệnh xuất kích dưới danh nghĩa của Scylla 30 giây trước vụ nổ.
Dialogue: 5,0:38:05.49,0:38:07.05,Default,,0,0,0,,Sau đó toàn bộ đường truyền biến mất.
Dialogue: 5,0:38:07.05,0:38:09.13,Default,,0,0,0,,Việc giám sát này có còn tích sự gì nữa không vậy?!
Dialogue: 5,0:38:09.13,0:38:13.02,Default,,0,0,0,,Hãy tìm một kỹ sư vũ khí trong danh sách khách hàng của họ\Ncó liên quan đến vụ này.
Dialogue: 5,0:38:13.02,0:38:14.39,Default,,0,0,0,,Kỹ sư vũ khí sao?
Dialogue: 5,0:38:14.39,0:38:16.52,Default,,0,0,0,,Cũng lấy thông tin từ những nạn nhân đầu tiên nữa đi. Mau lên.
Dialogue: 5,0:38:17.02,0:38:19.49,Default,,0,0,0,,Tìm bất cứ thứ gì. Con virus, những quả bom, tên chỉ huy chiến thuật,
Dialogue: 5,0:38:19.49,0:38:23.69,Default,,0,0,0,,nơi các tin nhắn từ "Scylla" phát ra—tôi không quan tâm là thứ gì.
Dialogue: 5,0:38:24.29,0:38:29.41,Default,,0,0,0,,Sao cô không chịu nói cho chúng tôi biết tại sao cô lại chắc chắn Scylla đã chết đi?
Dialogue: 5,0:38:30.18,0:38:30.83,Default,,0,0,0,,Xin thứ lỗi.
Dialogue: 5,0:38:32.88,0:38:34.00,Default,,0,0,0,,Là anh!
Dialogue: 5,0:38:34.00,0:38:36.99,Default,,0,0,0,,Tôi được báo là có thể tìm thấy Thiếu tá Kusanagi ở đây.
Dialogue: 5,0:38:36.99,0:38:37.84,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 5,0:38:44.29,0:38:45.71,Default,,0,0,0,,Khai báo mục đích của anh đi.
Dialogue: 5,0:38:45.71,0:38:49.06,Default,,0,0,0,,Cái danh sách tôi nhận được từ hắn là đồ giả.
Dialogue: 5,0:38:49.72,0:38:54.68,Default,,0,0,0,,Và một thanh tra điều tra vụ buôn lậu vũ khí đã bị sát hại\Nngay sau khi nhận thông tin từ hắn.
Dialogue: 5,0:38:55.07,0:39:01.15,Default,,0,0,0,,Các kỹ thuật viên luôn bị đổ lỗi cho các vụ việc liên quan đến thể máy mà.
Dialogue: 5,0:39:02.03,0:39:05.02,Default,,0,0,0,,Và người quản lý con đập phát nổ hôm nọ...
Dialogue: 5,0:39:06.51,0:39:08.47,Default,,0,0,0,,Hose cũng chính là người trang bị thể máy cho tên vệ sĩ của bà ta.
Dialogue: 5,0:39:08.47,0:39:09.86,Default,,0,0,0,,Thế thì sao chứ?!
Dialogue: 5,0:39:10.74,0:39:13.83,Default,,0,0,0,,Cô cảm thấy thế nào khi tận mắt chứng kiến người yêu mình bị tấn công ngay trước mặt?
Dialogue: 5,0:39:15.69,0:39:19.40,Default,,0,0,0,,Cô tức giận với thủ phạm, và cô cảm thấy tội lỗi.
Dialogue: 5,0:39:19.40,0:39:21.79,Default,,0,0,0,,Cô nghĩ đó là lỗi của mình khi anh ta bị tấn công.
Dialogue: 5,0:39:25.11,0:39:27.08,Default,,0,0,0,,Hắn ta cũng y hệt như vậy.
Dialogue: 5,0:39:27.08,0:39:28.80,Default,,0,0,0,,Tức giận và tội lỗi.
Dialogue: 5,0:39:29.37,0:39:31.43,Default,,0,0,0,,Hắn đang che giấu điều gì đó.
Dialogue: 5,0:39:31.43,0:39:35.76,Default,,0,0,0,,Con đập, viên thanh tra đã chết, những bộ thể máy, và thậm chí cả cô nữa, Thiếu tá...
Dialogue: 5,0:39:36.49,0:39:38.59,Default,,0,0,0,,Mọi thứ đều dẫn ngược về Hose Akira.
Dialogue: 5,0:39:42.46,0:39:45.00,Default,,0,0,0,,Anh chỉ là một tên cớm quèn tọc mạch bằng đôi mắt thịt thôi!
Dialogue: 5,0:39:45.00,0:39:46.61,Default,,0,0,0,,Đừng bao giờ vác mặt đến đây nữa!
Dialogue: 5,0:39:51.01,0:39:53.07,Default,,0,0,0,,Đau đấy...
Dialogue: 5,0:40:14.58,0:40:16.26,Default,,0,0,0,,Bà là một kẻ ngu ngốc, Đại tá!
Dialogue: 5,0:40:18.65,0:40:20.09,Default,,0,0,0,,Màng chắn tấn công!
Dialogue: 5,0:40:20.09,0:40:21.23,Default,,0,0,0,,Hãy bình tĩnh đi.
Dialogue: 5,0:40:21.86,0:40:26.99,Default,,0,0,0,,Nếu phe nội địa tước đi quyền lợi ngành vũ khí của bà,\Nbà sẽ bị các tập đoàn sát hại thôi.
Dialogue: 5,0:40:26.99,0:40:30.39,Default,,0,0,0,,Vậy mà bà lại vội vàng trừ khử tôi và cướp dữ liệu của tôi sao?
Dialogue: 5,0:40:30.39,0:40:34.20,Default,,0,0,0,,Thế mà bà làm như mình là kẻ tai to mặt lớn, nhưng lại chẳng thả nổi người của tôi ra?
Dialogue: 5,0:40:34.54,0:40:36.37,Default,,0,0,0,,Dữ liệu ở đâu?
Dialogue: 5,0:40:36.79,0:40:38.47,Default,,0,0,0,,Thỏa thuận của chúng ta chấm dứt rồi.
Dialogue: 5,0:40:38.47,0:40:44.48,Default,,0,0,0,,Tôi biết ơn vì thông tin về cô ấy và vì sự hồi sinh của Scylla,\Nnhưng tôi sẽ rời khỏi đất nước này.
Dialogue: 5,0:40:44.48,0:40:45.96,Default,,0,0,0,,Bà cũng nên làm vậy đi.
Dialogue: 5,0:40:45.96,0:40:47.67,Default,,0,0,0,,Không cần thiết.
Dialogue: 5,0:40:53.59,0:40:57.60,Default,,0,0,0,,Chúng tôi đã đóng gói thành công con virus vào các bộ não điện tử rồi.
Dialogue: 5,0:40:59.97,0:41:03.44,Default,,0,0,0,,Chúng tôi sẽ dùng não điện tử của anh cho bản nâng cấp cuối cùng.
Dialogue: 5,0:41:03.74,0:41:05.90,Default,,0,0,0,,Hãy trở thành Scylla, đúng như anh hằng mong muốn đi.
Dialogue: 5,0:41:15.07,0:41:18.59,Default,,0,0,0,,"Hai bàn tay anh ta vẫn mở rộng sau khi bị thiêu cháy", hả?
Dialogue: 5,0:41:39.66,0:41:41.11,Default,,0,0,0,,Đúng y như cuộc gọi đã thông báo.
Dialogue: 5,0:41:41.11,0:41:44.18,Default,,0,0,0,,Hai sĩ quan An ninh Công cộng bị sát hại,\Nvà tung tích của Hose Akira hiện chưa rõ.
Dialogue: 5,0:41:44.48,0:41:46.28,Default,,0,0,0,,Thiếu tá không phải là mục tiêu sao?
Dialogue: 5,0:41:46.28,0:41:48.27,Default,,0,0,0,,Này, nhìn vào danh sách này đi.
Dialogue: 5,0:41:48.27,0:41:53.88,Default,,0,0,0,,Chỉ là phỏng đoán thôi, nhưng tôi nghĩ những quả bom nhiệt áp\Nchính là những chi nhân tạo đó.
Dialogue: 5,0:41:53.88,0:41:57.30,Default,,0,0,0,,Có một vệ sĩ thể máy toàn phần khác trong khu vực đó của tòa nhà.
Dialogue: 5,0:41:57.30,0:42:00.24,Default,,0,0,0,,Hồ sơ quản lý các chi đó có cùng một chữ ký...
Dialogue: 5,0:42:03.59,0:42:05.08,Default,,0,0,0,,Cô đang làm cái gì thế?
Dialogue: 5,0:42:07.96,0:42:09.42,Default,,0,0,0,,Người đàn ông này là ai?!
Dialogue: 5,0:42:14.21,0:42:17.04,Default,,0,0,0,,Màng chắn tấn công của tôi mở rộng theo từng giây.
Dialogue: 5,0:42:17.04,0:42:18.80,Default,,0,0,0,,Nếu không muốn não bị nướng chín, thì mau khai ra!
Dialogue: 5,0:42:18.80,0:42:20.55,Default,,0,0,0,,Anh ấy sẽ chết mất!
Dialogue: 5,0:42:21.18,0:42:23.56,Default,,0,0,0,,Anh ấy đã trao cho chúng tôi sức mạnh...
Dialogue: 5,0:42:23.56,0:42:25.56,Default,,0,0,0,,Anh ấy chính là Scylla tái sinh!
Dialogue: 5,0:42:26.02,0:42:28.00,Default,,0,0,0,,Nó giống như phép thuật vậy.
Dialogue: 5,0:42:28.00,0:42:31.89,Default,,0,0,0,,Một chương trình học chiến đấu được Scylla quá cố để lại cho chúng tôi...
Dialogue: 5,0:42:31.89,0:42:35.56,Default,,0,0,0,,Anh ấy đã nạp nó vào não điện tử của tôi, cùng với con virus.
Dialogue: 5,0:42:35.56,0:42:39.91,Default,,0,0,0,,Tôi chưa từng được huấn luyện, nhưng giờ tôi có thể chiến đấu ngay cả với người của các người!
Dialogue: 5,0:42:39.91,0:42:41.37,Default,,0,0,0,,Cho tôi một cái tên!
Dialogue: 5,0:42:41.98,0:42:43.63,Default,,0,0,0,,Hose Akira!
Dialogue: 5,0:42:43.63,0:42:45.83,Default,,0,0,0,,Anh ấy là người Nhật Bản, giống như cô vậy!
Dialogue: 5,0:42:54.29,0:42:55.42,Default,,0,0,0,,Hose đã trốn thoát rồi.
Dialogue: 5,0:42:56.02,0:42:57.05,Default,,0,0,0,,Có manh mối nào về nơi hắn tới không?
Dialogue: 5,0:42:57.05,0:42:58.59,Default,,0,0,0,,Sao lại hỏi tôi?
Dialogue: 5,0:42:58.59,0:43:01.35,Default,,0,0,0,,Đôi mắt của anh hiện đang nhìn vào thứ gì thế?
Dialogue: 5,0:43:03.27,0:43:05.31,Default,,0,0,0,,Zhinzhee Bekka Arr Thied.
Dialogue: 5,0:43:06.11,0:43:12.23,Default,,0,0,0,,Bà ta là trùm một công ty nước Kuzan,\Nvà rất có thể là kẻ tài trợ cho đường dây vũ khí.
Dialogue: 5,0:43:12.23,0:43:14.48,Default,,0,0,0,,Vậy đây chính là lối ra của đường hầm!
Dialogue: 5,0:43:15.11,0:43:18.15,Default,,0,0,0,,Một công ty vũ khí trong nước. Tập đoàn Công nghiệp Nặng Harimadara!
Dialogue: 5,0:43:18.94,0:43:22.37,Default,,0,0,0,,Các lãnh đạo đang đi thị sát Nhà máy Một cùng với Thứ trưởng Cao cấp Bộ Quốc phòng!
Dialogue: 5,0:43:22.91,0:43:26.04,Default,,0,0,0,,Đề xuất lập màng chắn, và chuyển dữ liệu cho Đội 9.
Dialogue: 5,0:43:26.04,0:43:28.29,Default,,0,0,0,,Paz, Borma, Saito, tới đó ngay.
Dialogue: 5,0:43:31.09,0:43:34.16,Default,,0,0,0,,Gọi đội phá bom và một kỹ thuật viên thể máy.
Dialogue: 5,0:43:34.16,0:43:36.76,Default,,0,0,0,,Rất có thể sẽ xảy ra một cuộc tấn công mạng hủy diệt.
Dialogue: 5,0:43:41.34,0:43:43.90,Default,,0,0,0,,Ý này là sao đây, Trưởng ban Aramaki?
Dialogue: 5,0:43:43.90,0:43:45.31,Default,,0,0,0,,Sơ tán ngay lập tức.
Dialogue: 5,0:43:45.82,0:43:48.27,Default,,0,0,0,,Ngài và cơ sở này chính là mục tiêu.
Dialogue: 5,0:43:48.86,0:43:50.73,Default,,0,0,0,,C-Có chuyện gì đang xảy ra thế?!
Dialogue: 5,0:43:54.51,0:43:56.19,Default,,0,0,0,,Có bom! Chạy mau!
Dialogue: 5,0:44:02.20,0:44:03.19,Default,,0,0,0,,Chết tiệt.
Dialogue: 5,0:44:03.19,0:44:04.21,Default,,0,0,0,,Khốn nạn!
Dialogue: 5,0:44:04.21,0:44:05.20,Default,,0,0,0,,Paz, Borma!
Dialogue: 5,0:44:05.84,0:44:06.66,Default,,0,0,0,,Lối này!
Dialogue: 5,0:44:09.55,0:44:11.33,Default,,0,0,0,,Cứu tôi với! Cứu tôi với!
Dialogue: 5,0:44:20.19,0:44:22.71,Default,,0,0,0,,Chết tiệt, khói lửa đang bóp nghẹt cổ họng tôi rồi.
Dialogue: 5,0:44:22.71,0:44:25.18,Default,,0,0,0,,Tôi cũng thế. Suýt chết.
Dialogue: 5,0:44:26.06,0:44:27.83,Default,,0,0,0,,Thứ trưởng, ngài có sao không?
Dialogue: 5,0:44:27.83,0:44:29.46,Default,,0,0,0,,Tôi không sao.
Dialogue: 5,0:44:35.41,0:44:36.18,Default,,0,0,0,,Logicoma.
Dialogue: 5,0:44:36.82,0:44:37.57,Default,,0,0,0,,Rõ, thưa sếp!
Dialogue: 5,0:44:40.14,0:44:42.03,Default,,0,0,0,,Đó là một trong những sản phẩm của chúng tôi mà!
Dialogue: 5,0:44:45.45,0:44:46.53,Default,,0,0,0,,Tránh xa các cửa sổ ra!
Dialogue: 5,0:44:51.78,0:44:54.04,Default,,0,0,0,,Đó là toàn bộ thông tin về Đại tá Hozumi.
Dialogue: 5,0:44:54.04,0:44:55.48,Default,,0,0,0,,Thế là được rồi.
Dialogue: 5,0:44:55.48,0:44:58.75,Default,,0,0,0,,Chúng tôi có một quân bài, và bà có một thời gian ân hạn.
Dialogue: 5,0:44:59.14,0:45:02.47,Default,,0,0,0,,Làm ơn hãy nói cho tôi biết bà ta có liên quan gì đến Scylla!
Dialogue: 5,0:45:02.88,0:45:04.50,Default,,0,0,0,,Hãy tự đi tìm hiểu từ bà ta đi.
Dialogue: 5,0:45:04.50,0:45:09.81,Default,,0,0,0,,Bộ não bị vấy bẩn của cô rất thú vị,\Nnhưng tôi sẽ cắt kết nối trước khi sự lây nhiễm lan rộng.
Dialogue: 5,0:45:15.06,0:45:16.15,Default,,0,0,0,,Tạm biệt.
Dialogue: 5,0:45:26.06,0:45:27.62,Default,,0,0,0,,Bị vấy bẩn à?
Dialogue: 5,0:45:28.02,0:45:31.12,Default,,0,0,0,,Tôi đang bị phá sản bởi mức thuế đặc biệt đánh vào các công ty nước ngoài sao?!
Dialogue: 5,0:45:31.74,0:45:34.15,Default,,0,0,0,,Làm sao chuyện này có thể được phép xảy ra chứ?!
Dialogue: 5,0:45:34.15,0:45:36.83,Default,,0,0,0,,Đó là kiểu hành động mà phe nội địa sẽ làm mà.
Dialogue: 5,0:45:37.93,0:45:39.04,Default,,0,0,0,,Bà định làm gì?
Dialogue: 5,0:45:39.98,0:45:41.45,Default,,0,0,0,,Giết Đại tá sao?
Dialogue: 5,0:45:42.01,0:45:45.03,Default,,0,0,0,,Bà ta xong đời rồi. Và cả bà lẫn tôi cũng vậy.
Dialogue: 5,0:45:52.46,0:45:54.35,Default,,0,0,0,,Hãy trốn đi, và tuân lệnh phe nội địa.
Dialogue: 5,0:45:55.19,0:45:59.06,Default,,0,0,0,,Công ty của bà sẽ bị nghiền nát dưới cái cớ thuế khóa của quốc gia này.
Dialogue: 5,0:45:59.65,0:46:01.60,Default,,0,0,0,,Bà sẽ bị các tập đoàn giết chết nếu không làm gì đó.
Dialogue: 5,0:46:04.75,0:46:06.44,Default,,0,0,0,,Cô ổn chứ, Thiếu tá?
Dialogue: 5,0:46:06.44,0:46:07.77,Default,,0,0,0,,Không vấn đề gì.
Dialogue: 5,0:46:07.77,0:46:10.74,Default,,0,0,0,,Cậu hãy đi cùng viên thanh tra đó và trấn áp đám bảo vệ.
Dialogue: 5,0:46:11.68,0:46:14.96,Default,,0,0,0,,Tôi sẽ lo liệu Scylla.
Dialogue: 5,0:46:20.30,0:46:22.42,Default,,0,0,0,,Trời đất, cứng đầu thật đấy. Người phụ nữ đáng sợ.
Dialogue: 5,0:46:28.16,0:46:28.80,Default,,0,0,0,,Cái gì thế?
Dialogue: 5,0:46:29.52,0:46:31.18,Default,,0,0,0,,Khẩu Mateba, vào cái thời buổi này sao?
Dialogue: 5,0:46:31.18,0:46:32.51,Default,,0,0,0,,Có vấn đề gì với nó à?!
Dialogue: 5,0:46:32.51,0:46:34.37,Default,,0,0,0,,Tôi tin khẩu súng này hơn bất kỳ thứ nào khác.
Dialogue: 5,0:46:45.25,0:46:46.32,Default,,0,0,0,,Dấu vết máu.
Dialogue: 5,0:46:46.77,0:46:48.24,Default,,0,0,0,,Có ai đó đã bị bắn.
Dialogue: 5,0:46:54.63,0:46:55.50,Default,,0,0,0,,Một viên đạn...
Dialogue: 5,0:47:14.29,0:47:17.21,Default,,0,0,0,,Ariel. Hóa ra đây chính là những quả bom thể máy.
Dialogue: 5,0:47:35.95,0:47:37.91,Default,,0,0,0,,Vừa rồi không phải là em.
Dialogue: 5,0:47:37.91,0:47:40.50,Default,,0,0,0,,Kẻ quái nào đã thâm nhập vào thị giác của tôi?!
Dialogue: 5,0:47:40.84,0:47:41.63,Default,,0,0,0,,Đứng im!
Dialogue: 5,0:47:44.46,0:47:49.93,Default,,0,0,0,,Trong vũng lầy của cuộc chiến đó,\NScylla là người lính duy nhất mà tôi có thể đồng cảm.
Dialogue: 5,0:47:50.43,0:47:53.64,Default,,0,0,0,,Tôi luôn muốn hỏi cô tại sao hắn lại bị giết.
Dialogue: 5,0:47:55.31,0:47:57.68,Default,,0,0,0,,Em đã không giết Scylla.
Dialogue: 5,0:47:57.68,0:47:59.10,Default,,0,0,0,,Cuối cùng tôi cũng nhận ra điều đó.
Dialogue: 5,0:48:01.84,0:48:02.95,Default,,0,0,0,,Về nhà đi.
Dialogue: 5,0:48:02.95,0:48:05.48,Default,,0,0,0,,Nếu không bộ Ariel của em sẽ kích hoạt đấy.
Dialogue: 5,0:48:06.75,0:48:08.11,Default,,0,0,0,,Ngay cả anh cũng không thể ngăn nó lại được đâu.
Dialogue: 5,0:48:33.84,0:48:34.92,Default,,0,0,0,,Chuyện quái gì đang diễn ra ở đây thế này?
Dialogue: 5,0:48:34.92,0:48:39.12,Default,,0,0,0,,Tên khốn đó đã thâm nhập vào thị giác của tôi y hệt như cách cô làm!
Dialogue: 5,0:48:39.12,0:48:40.48,Default,,0,0,0,,Trả lời tôi đi, Thiếu tá!
Dialogue: 5,0:48:58.66,0:49:00.44,Default,,0,0,0,,Sao Lục quân lại chậm chạp thế này?!
Dialogue: 5,0:49:00.44,0:49:02.12,Default,,0,0,0,,Tất cả chúng ta sẽ chết mất!
Dialogue: 5,0:49:02.45,0:49:04.24,Default,,0,0,0,,Nó đã bị chiếm quyền rồi.
Dialogue: 5,0:49:04.24,0:49:07.38,Default,,0,0,0,,Nó sẽ không dừng lại cho đến khi chúng ta tắt thứ được đóng gói cùng với nó.
Dialogue: 5,0:49:07.38,0:49:09.12,Default,,0,0,0,,Ký ức được cấy ghép.
Dialogue: 5,0:49:09.12,0:49:09.96,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:49:10.28,0:49:13.18,Default,,0,0,0,,Những bộ não điện tử được đóng gói chính là vật chủ của con virus.
Dialogue: 5,0:49:13.82,0:49:17.68,Default,,0,0,0,,Họ đã chuyển đổi chương trình chiến thuật mà tôi từng thả ra ở Qhardistan thành ký ức.
Dialogue: 5,0:49:18.11,0:49:19.60,Default,,0,0,0,,Bản sao chép của tôi.
Dialogue: 5,0:49:24.02,0:49:25.81,Default,,0,0,0,,Cô đang nói cái quái gì thế?!
Dialogue: 5,0:49:34.24,0:49:35.10,Default,,0,0,0,,{\i1}Motoko.{\i0}
Dialogue: 5,0:50:03.52,0:50:07.31,Default,,0,0,0,,Anh đã đuổi theo em, nhưng rốt cuộc, em lại bắt được anh.
Dialogue: 5,0:50:09.21,0:50:11.88,Default,,0,0,0,,Chính bộ não điện tử của anh đã bị đóng gói.
Dialogue: 5,0:50:11.88,0:50:14.96,Default,,0,0,0,,Nếu em bóp cò, em và các đồng đội của em sẽ được cứu sống.
Dialogue: 5,0:50:18.89,0:50:21.07,Default,,0,0,0,,Thứ mà em đã đem lòng yêu chính là thế giới này.
Dialogue: 5,0:50:25.34,0:50:28.54,Default,,0,0,0,,Cứ tiếp tục bước đi đi, cho tới ngày em bị phản bội.
Dialogue: 5,0:50:33.26,0:50:34.23,Default,,0,0,0,,Scylla...
Dialogue: 5,0:50:35.66,0:50:37.13,Default,,0,0,0,,Em rất vui vì đã được gặp anh.
Dialogue: 5,0:51:05.44,0:51:06.28,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:51:07.10,0:51:08.49,Default,,0,0,0,,Nó dừng lại rồi...
Dialogue: 5,0:51:17.91,0:51:19.30,Default,,0,0,0,,Thật mỉa mai.
Dialogue: 5,0:51:19.30,0:51:21.61,Default,,0,0,0,,Họ sống sót qua một cuộc thế chiến,
Dialogue: 5,0:51:21.61,0:51:26.08,Default,,0,0,0,,rồi lại mắc kẹt trong một cuộc chiến vô tận, và cuối cùng tự kết liễu đời mình.
Dialogue: 5,0:51:26.08,0:51:28.61,Default,,0,0,0,,Có vẻ như chẳng còn cách nào khác để họ có thể dừng lại.
Dialogue: 5,0:51:29.42,0:51:31.27,Default,,0,0,0,,Chẳng phải cô cũng từng như vậy sao?
Dialogue: 5,0:51:32.73,0:51:35.25,Default,,0,0,0,,Scylla chính là cô.
Dialogue: 5,0:51:35.25,0:51:38.75,Default,,0,0,0,,Cô đã giúp đỡ quân đội ly khai, rồi ngụy tạo cái chết của mình.
Dialogue: 5,0:51:38.75,0:51:41.74,Default,,0,0,0,,Về sau, đám lính du kích mà cô từng chỉ huy đều bị giết sạch.
Dialogue: 5,0:51:42.56,0:51:44.81,Default,,0,0,0,,Tôi hiểu tại sao cô lại không muốn nhớ lại chiến dịch đó.
Dialogue: 5,0:51:46.59,0:51:49.77,Default,,0,0,0,,Kể từ đó, tôi không còn thường xuyên đổi cơ thể nữa.
Dialogue: 5,0:51:50.68,0:51:52.71,Default,,0,0,0,,Nó khiến tôi bị khủng hoảng căn tính.
Dialogue: 5,0:51:53.14,0:51:55.67,Default,,0,0,0,,Tôi đánh mất dấu vết của việc mình là ai,
Dialogue: 5,0:51:55.67,0:51:59.65,Default,,0,0,0,,và rồi tôi lại muốn ai đó nói với tôi rằng tôi không phải là một cỗ người máy.
Dialogue: 5,0:52:03.10,0:52:06.68,Default,,0,0,0,,Đó là lý do tại sao cô khăng khăng tự tạo ra những nét tinh chỉnh nguyên bản\Ntrên các mẫu sản xuất hàng loạt sao?
Dialogue: 5,0:52:07.45,0:52:11.10,Default,,0,0,0,,Thật đáng kinh ngạc khi cô có thể điều khiển nhiều cơ thể như thế\Ntrong một thời gian ngắn.
Dialogue: 5,0:52:11.52,0:52:12.95,Default,,0,0,0,,Tôi sẽ chợp mắt một lát.
Dialogue: 5,0:52:12.95,0:52:14.11,Default,,0,0,0,,Anh có thể đi rồi đấy.
Dialogue: 5,0:52:14.65,0:52:16.57,Default,,0,0,0,,Cứ coi đây là tình đoàn kết giữa các cyborg đi.
Dialogue: 5,0:52:16.57,0:52:19.61,Default,,0,0,0,,Tôi sẽ canh chừng để bảo đảm họ không gắn\Nbất kỳ bộ phận mờ ám nào vào người cô.
Dialogue: 5,0:52:20.30,0:52:22.54,Default,,0,0,0,,Được thôi, tùy anh.
Dialogue: 5,0:52:23.94,0:52:26.03,Default,,0,0,0,,Ít nhất cô cũng có thể nói một câu "cảm ơn" chứ!
Dialogue: 5,0:52:29.81,0:52:33.17,Default,,0,0,0,,Viên đạn tại hiện trường được bắn ra từ khẩu súng của Trung úy.
Dialogue: 5,0:52:33.82,0:52:36.68,Default,,0,0,0,,Tôi cũng tìm thấy vũ khí của Mizuki tại nhà của Trung úy.
Dialogue: 5,0:52:36.68,0:52:39.13,Default,,0,0,0,,Ngoài ra còn có một khoản tiền gửi khổng lồ vào tài khoản của hắn nữa.
Dialogue: 5,0:52:43.16,0:52:44.05,Default,,0,0,0,,Làm tốt lắm.
Dialogue: 5,0:52:44.54,0:52:45.63,Default,,0,0,0,,Cậu có thể đi rồi.
Dialogue: 5,0:52:57.66,0:53:00.24,Default,,0,0,0,,Bắt giữ một đồng nghiệp cảnh sát sẽ khiến cậu chuốc lấy nhiều kẻ thù đấy.
Dialogue: 5,0:53:03.18,0:53:06.20,Default,,0,0,0,,Cậu sẽ bị đám người ở đồn của hắn bắn lén từ sau lưng đấy.
Dialogue: 5,0:53:06.54,0:53:09.36,Default,,0,0,0,,Tôi nhất định sẽ cẩn thận để mắt phía sau lưng.
Dialogue: 5,0:53:09.36,0:53:10.91,Default,,0,0,0,,Cậu đến đây chỉ để nói điều đó thôi sao?
Dialogue: 5,0:53:11.98,0:53:13.87,Default,,0,0,0,,Cậu có muốn gia nhập đội của tôi không?
Dialogue: 5,0:53:16.04,0:53:18.91,Default,,0,0,0,,Đó là một đơn vị tấn công độc lập với quyền ưu tiên cao nhất.
Dialogue: 5,0:53:20.57,0:53:21.30,Default,,0,0,0,,Ồ, xin thứ lỗi.
Dialogue: 5,0:53:22.61,0:53:23.49,Default,,0,0,0,,Alo?
Dialogue: 5,0:53:24.37,0:53:25.68,Default,,0,0,0,,Cái gì?!
Dialogue: 5,0:53:25.68,0:53:27.21,Default,,0,0,0,,Anh tưởng phải hai tuần nữa cơ mà!
Dialogue: 5,0:53:27.21,0:53:28.37,Default,,0,0,0,,Không, anh xin lỗi.
Dialogue: 5,0:53:29.20,0:53:30.85,Default,,0,0,0,,Anh biết rồi. Anh tới ngay đây.
Dialogue: 5,0:53:31.27,0:53:33.44,Default,,0,0,0,,Lớn chuyện rồi! Vợ tôi vỡ ối rồi!
Dialogue: 5,0:53:34.52,0:53:35.40,Default,,0,0,0,,Hả?
Dialogue: 5,0:53:35.40,0:53:37.68,Default,,0,0,0,,Chúng tôi sắp có con rồi!
Dialogue: 5,0:53:37.68,0:53:39.81,Default,,0,0,0,,Chờ anh nhé, anh tới ngay đây!
Dialogue: 5,0:53:39.81,0:53:41.36,Default,,0,0,0,,Chúng ta sẽ nói chuyện vào dịp khác nhé.
Dialogue: 5,0:53:41.79,0:53:43.03,Default,,0,0,0,,Anh tới đây!
Dialogue: 5,0:53:46.34,0:53:49.56,Default,,0,0,0,,Cơ thể tự nhiên, đã kết hôn, và sắp làm bố sao?

