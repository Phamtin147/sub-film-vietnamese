Dialogue: 5,0:03:56.99,0:04:00.22,Default,,0,0,0,,Địa vị của chúng ta như một đơn vị tấn công độc lập phụ thuộc vào phi vụ này.
Dialogue: 5,0:04:00.22,0:04:03.77,Default,,0,0,0,,An ninh Công cộng lo vụ việc, còn chúng ta lo nguyên nhân gây ra nó.
Dialogue: 5,0:04:03.77,0:04:04.61,Default,,0,0,0,,Hành động.
Dialogue: 5,0:05:10.18,0:05:11.74,Default,,0,0,0,,Kẻ địch vừa phát lệnh xuất kích.
Dialogue: 5,0:05:12.26,0:05:13.20,Default,,0,0,0,,Bắt giữ bọn chúng!
Dialogue: 5,0:05:19.30,0:05:20.67,Default,,0,0,0,,Các người đáng đời lắm...
Dialogue: 5,0:05:21.28,0:05:23.55,Default,,0,0,0,,Lũ tư bản tham lam khốn khiếp!
Dialogue: 5,0:05:32.37,0:05:36.31,Default,,0,0,0,,Hôm nay, chúng tôi tuân thủ nguyên tắc thương mại tự do
Dialogue: 5,0:05:36.31,0:05:39.90,Default,,0,0,0,,để duy trì mức giá công bằng nhằm thúc đẩy phục hồi kinh tế hậu chiến.
Dialogue: 5,0:05:45.76,0:05:48.91,Default,,0,0,0,,Đây là vũ khí duy nhất của hắn. Có gì đó mờ ám.
Dialogue: 5,0:06:05.82,0:06:07.88,Default,,0,0,0,,Lực lượng chống bạo động nổ súng rồi sao?!
Dialogue: 5,0:06:34.28,0:06:36.93,Default,,0,0,0,,{\i1}Đội phía tây đang tàn sát những người biểu tình kìa!{\i0}
Dialogue: 5,0:06:36.93,0:06:38.75,Default,,0,0,0,,{\i1}Vài người trong số họ thậm chí còn đang bắn vào đồng nghiệp cảnh sát!{\i0}
Dialogue: 5,0:06:39.43,0:06:42.00,Default,,0,0,0,,Đó là vụ hack Hồn đồng loạt lớn nhất từ trước đến nay.
Dialogue: 5,0:06:42.00,0:06:44.35,Default,,0,0,0,,Điên rồ thật, nhưng đó là lời giải thích duy nhất.
Dialogue: 5,0:06:45.03,0:06:48.44,Default,,0,0,0,,Không có công nghệ nào kiểm soát được 100 người cùng một lúc cả.
Dialogue: 5,0:06:48.44,0:06:50.91,Default,,0,0,0,,Đám thủ phạm trong ca trực của tôi cũng chết sạch cả rồi.
Dialogue: 5,0:06:50.91,0:06:54.18,Default,,0,0,0,,Kiểm tra các đường truyền của đội chống bạo động và tìm ra nguyên nhân gây ra vụ tấn công.
Dialogue: 5,0:06:54.86,0:06:56.96,Default,,0,0,0,,Có một nhật ký có thể là của Starter, nhưng mà...
Dialogue: 5,0:06:56.96,0:06:59.41,Default,,0,0,0,,Vậy thì đây không phải bị hack. Mà là một con virus.
Dialogue: 5,0:06:59.41,0:07:01.80,Default,,0,0,0,,Tôi không thấy con nào trong chuỗi mã cả.
Dialogue: 5,0:07:01.80,0:07:04.27,Default,,0,0,0,,Nó là loại tự hủy kiểu Stuxnet.
Dialogue: 5,0:07:04.81,0:07:09.74,Default,,0,0,0,,Chắc chắn có kẻ đang gửi đi những hành động đóng gói sẵn\Ncho phép chúng điều khiển cả đám đông.
Dialogue: 5,0:07:28.86,0:07:30.13,Default,,0,0,0,,Là bà sao?
Dialogue: 5,0:07:38.39,0:07:43.19,Default,,0,0,0,,Tôi đã ký thỏa ước với quỷ dữ vì mục tiêu tái thiết và độc lập!
Dialogue: 5,0:07:43.19,0:07:45.52,Default,,0,0,0,,Đúng như các người hằng mong muốn!
Dialogue: 5,0:07:46.45,0:07:53.70,Default,,0,0,0,,Và nó đã rước về một cuộc thảm sát thứ hai bằng nước và tiền điện tử\Nnối tiếp cuộc thảm sát thứ nhất bằng súng đạn!
Dialogue: 5,0:07:54.10,0:07:57.66,Default,,0,0,0,,{\an8}Các người từng bảo công nghệ não điện tử và ngành thể máy sẽ mang lại tương lai cho chúng tôi,{\i0}
Dialogue: 5,0:07:54.46,0:07:56.28,Default,,0,0,0,,Tôi muốn phong tỏa toàn bộ truyền thông.
Dialogue: 5,0:07:56.28,0:07:57.66,Default,,0,0,0,,Và phải thực hiện ngay lúc này!
Dialogue: 5,0:07:57.66,0:08:01.94,Default,,0,0,0,,{\an8}nhưng hy vọng đâu phải là thứ mà chúng mang lại cho Qhardistan!{\i0}
Dialogue: 5,0:08:01.94,0:08:06.63,Default,,0,0,0,,Chúng chỉ gieo rắc những hạt mầm phản bội lớn lên để hút cạn lòng tự tôn của đồng bào tôi!
Dialogue: 5,0:08:07.34,0:08:10.55,Default,,0,0,0,,Hãy nếm trải cảm giác đó đi!
Dialogue: 5,0:08:10.55,0:08:13.97,Default,,0,0,0,,Khi đó các người sẽ chẳng còn lựa chọn nào khác ngoài việc cho tôi tị nạn!
Dialogue: 5,0:08:14.34,0:08:18.01,Default,,0,0,0,,Bởi vì đây là một quốc gia hòa bình, văn minh cơ mà!
Dialogue: 5,0:08:18.50,0:08:19.70,Default,,0,0,0,,Ồ, thật vậy sao?
Dialogue: 5,0:08:57.54,0:08:58.85,Default,,0,0,0,,Ngụy trang quang học!
Dialogue: 5,0:08:59.90,0:09:02.31,Default,,0,0,0,,{\i1}Ngươi không thể ngăn cản Fire-Starter đâu.{\i0}
Dialogue: 5,0:09:03.83,0:09:05.42,Default,,0,0,0,,Có kẻ đã hack đường truyền của tôi?!
Dialogue: 5,0:09:17.78,0:09:18.45,Default,,0,0,0,,{\i1}Thiếu tá?!{\i0}
Dialogue: 5,0:09:18.83,0:09:19.91,Default,,0,0,0,,{\i1}Saito!{\i0}
Dialogue: 5,0:09:32.46,0:09:33.31,Default,,0,0,0,,{\i1}Khốn kiếp.{\i0}
Dialogue: 5,0:09:45.63,0:09:47.39,Default,,0,0,0,,Xin chào ạ!
Dialogue: 5,0:09:49.98,0:09:51.05,Default,,0,0,0,,Đưa vũ khí cho tôi!
Dialogue: 5,0:09:51.05,0:09:52.27,Default,,0,0,0,,Được rồi ạ!
Dialogue: 5,0:09:52.61,0:09:54.24,Default,,0,0,0,,{\i1}Thiếu tá, tôi tới ngay đây!{\i0}
Dialogue: 5,0:09:54.24,0:09:57.45,Default,,0,0,0,,{\i1}Đừng có ngu ngốc thế. Hãy đuổi theo kẻ đã hack tôi mau!{\i0}
Dialogue: 5,0:10:13.19,0:10:14.37,Default,,0,0,0,,Quỳ xuống!
Dialogue: 5,0:10:15.84,0:10:18.51,Default,,0,0,0,,Đừng kháng cự và tôi sẽ không bắn cô.
Dialogue: 5,0:10:36.49,0:10:37.61,Default,,0,0,0,,Vụ đó từ đâu chui ra thế?!
Dialogue: 5,0:10:38.18,0:10:40.32,Default,,0,0,0,,Đó là nhiệm vụ của cậu mà, đồ ngốc!
Dialogue: 5,0:10:43.41,0:10:45.86,Default,,0,0,0,,Xin lỗi! Đó chỉ là tai nạn thôi.
Dialogue: 5,0:10:45.86,0:10:47.80,Default,,0,0,0,,Lắp thêm tay vịn vào đi!
Dialogue: 5,0:10:50.90,0:10:52.42,Default,,0,0,0,,{\i1}Bắn đi, Saito.{\i0}
Dialogue: 5,0:11:02.54,0:11:04.86,Default,,0,0,0,,{\i1}Tôi để hắn chạy mất rồi. Xin lỗi nhé!{\i0}
Dialogue: 0,0:11:17.32,0:11:19.45,thank fuck this is static,,0,0,0,,{\blur1.2\pos(741,258)\shad3\fax-0.25\frx0\fry0\fscx147\fscy147\c&H9A9B9B&\4c&H000000&\4a&HE7&\1a&H23&\frz15.7}S{*\fax-0.263}e{*\fax-0.277}c{*\fax-0.29}t{*\fax-0.303}i{*\fax-0.317}o{*\fax-0.33}n {*\fax-0.357}9 {*\fax-0.383}O{*\fax-0.397}f{*\fax-0.41}f{*\fax-0.423}i{*\fax-0.437}c{\fax-0.45}e
Dialogue: 5,0:11:18.44,0:11:19.45,Default,,0,0,0,,Tôi cạn lời luôn!
Dialogue: 5,0:11:21.25,0:11:25.89,Default,,0,0,0,,Cô vừa mới nhận nhiệm vụ, thế rồi cô hành quyết một người ngay trên Mạng lưới quốc gia sao?
Dialogue: 5,0:11:25.89,0:11:26.99,Default,,0,0,0,,Ai cơ, tôi á?
Dialogue: 5,0:11:27.32,0:11:29.13,Default,,0,0,0,,Ông không có bằng chứng đâu.
Dialogue: 5,0:11:29.13,0:11:31.23,Default,,0,0,0,,Cô đang khẳng định rằng mình không còn lựa chọn nào khác đấy à?
Dialogue: 5,0:11:31.23,0:11:34.46,Default,,0,0,0,,Cô là một hacker cấp siêu phù thủy trong một đơn vị át chủ bài.
Dialogue: 5,0:11:34.46,0:11:38.42,Default,,0,0,0,,Có lẽ Lục quân đã đánh giá cô quá mức nhiệt tình rồi đấy.
Dialogue: 5,0:11:39.99,0:11:43.05,Default,,0,0,0,,Nói cho tôi biết về con virus và cô bé thể máy hạng nặng đó đi.
Dialogue: 5,0:11:43.05,0:11:45.72,Default,,0,0,0,,Không phát hiện thấy con virus mạng nào cả.
Dialogue: 5,0:11:45.72,0:11:47.84,Default,,0,0,0,,Tên cô bé đó là Tsuda Emma.
Dialogue: 5,0:11:47.84,0:11:52.10,Default,,0,0,0,,Nghe nói cô bé khá nổi tiếng trên Mạng với tư cách là người tạo ra các ứng dụng trò chơi.
Dialogue: 5,0:11:52.10,0:11:54.82,Default,,0,0,0,,Chín tiếng sau khi bắt giữ cô ta, và tất cả những gì các người có chỉ có ngần đó sao?
Dialogue: 5,0:11:54.82,0:12:01.03,Default,,0,0,0,,Tôi cứ ngỡ một cựu thanh tra Hạng A Đặc biệt của Lục quân sẽ biết vây quanh mình những cấp dưới tài năng hơn chứ.
Dialogue: 5,0:12:01.34,0:12:06.56,Default,,0,0,0,,Nỗ lực tận tụy của người của tôi đã giúp tóm sống được nhiều tên thủ phạm đấy.
Dialogue: 5,0:12:06.56,0:12:10.33,Default,,0,0,0,,Chà, chiến công hiển hách ghê, bắt được vài con drone đóng gói vô tri vô giác.
Dialogue: 5,0:12:13.05,0:12:15.71,Default,,0,0,0,,Chúng tôi đã có thể ngăn chặn được nếu chúng tôi có thẩm quyền đặc biệt.
Dialogue: 5,0:12:17.06,0:12:20.33,Default,,0,0,0,,Vậy thì hãy ngừng chơi trò xã hội đen đi và gia nhập Đội 9.
Dialogue: 5,0:12:21.16,0:12:26.40,Default,,0,0,0,,Trừ phi cô làm việc trực tiếp cho Bộ Nội vụ,\Ncô sẽ phải chịu sự giám sát chính thức và sẽ không có sự bảo mật tuyệt đối đâu.
Dialogue: 5,0:12:27.33,0:12:29.68,Default,,0,0,0,,Ông có bảo đảm rằng tôi sẽ được tiếp tục là chính mình không?
Dialogue: 5,0:12:30.30,0:12:34.11,Default,,0,0,0,,Trang thiết bị tối tân có thể bảo vệ não điện tử và cơ thể nhân tạo.
Dialogue: 5,0:12:34.11,0:12:36.50,Default,,0,0,0,,Còn Hồn của tôi thì sao? Đức tin của tôi thì sao?
Dialogue: 5,0:12:36.50,0:12:39.53,Default,,0,0,0,,Tùy thuộc vào năng lực của cô. Tôi thậm chí sẽ xem xét cấp ngân sách.
Dialogue: 5,0:12:41.03,0:12:45.99,Default,,0,0,0,,Hãy lập ra một cơ quan chống khủng bố quốc tế cho chúng tôi\Nvới ngân sách ngang hàng với Biệt kích.
Dialogue: 5,0:12:49.36,0:12:51.79,Default,,0,0,0,,Tôi đi ăn đây.
Dialogue: 5,0:12:54.38,0:12:56.13,Default,,0,0,0,,Aramaki, lâu rồi không gặp.
Dialogue: 5,0:13:00.06,0:13:03.30,Default,,0,0,0,,Đại tá Hozumi. Cơn gió nào đưa Cục Tình báo Lục quân đến đây thế?
Dialogue: 5,0:13:05.68,0:13:07.71,Default,,0,0,0,,Tôi sẽ tiếp quản cô bé từ đây.
Dialogue: 5,0:13:08.39,0:13:09.64,Default,,0,0,0,,Phiền bà giải thích cho?
Dialogue: 5,0:13:11.26,0:13:14.04,Default,,0,0,0,,Họ đến từ một đơn vị mà tôi tin cậy.
Dialogue: 5,0:13:15.50,0:13:20.09,Default,,0,0,0,,Cựu Thiếu tá Kusanagi Motoko, của Tổ chức 501.
Dialogue: 5,0:13:20.09,0:13:22.86,Default,,0,0,0,,Ghét chủ nhân cũ đến mức biến thành một con chó hoang đấy à?
Dialogue: 5,0:13:23.48,0:13:25.06,Default,,0,0,0,,Tin tình báo của bà lỗi thời rồi.
Dialogue: 5,0:13:25.06,0:13:26.32,Default,,0,0,0,,Bọn họ vừa khôi phục quân hàm của tôi.
Dialogue: 5,0:13:28.39,0:13:33.04,Default,,0,0,0,,Con virus mạng được sử dụng là mấu chốt quan trọng để chúng tôi điều tra.
Dialogue: 5,0:13:33.42,0:13:36.28,Default,,0,0,0,,Làm ơn hãy giải thích tại sao nó lại là mấu chốt quan trọng đi.
Dialogue: 5,0:13:36.28,0:13:41.25,Default,,0,0,0,,Nó là một gói ba trong một: tẩy não, thâm nhập Hồn, và tạo ký ức giả.
Dialogue: 5,0:13:41.66,0:13:42.97,Default,,0,0,0,,Ký ức giả sao?
Dialogue: 5,0:13:43.75,0:13:48.47,Default,,0,0,0,,Lần gần nhất tôi kiểm tra, chính phủ không hề thừa nhận điều đó là khả thi,\Nbất chấp mọi báo cáo.
Dialogue: 5,0:13:49.72,0:13:54.22,Default,,0,0,0,,Các đơn vị virus đã xâm nhập vào đất nước này thông qua một tay môi giới nọ.
Dialogue: 5,0:13:54.55,0:13:58.45,Default,,0,0,0,,Tin tôi đi. Các người thậm chí sẽ chẳng thể nào khởi tố được cô bé đó đâu.
Dialogue: 5,0:13:59.86,0:14:03.56,Default,,0,0,0,,Rất tiếc, cô bé đã được chuyển giao cho Tổ chức 501 rồi.
Dialogue: 5,0:14:03.56,0:14:04.19,Default,,0,0,0,,Từ khi nào?
Dialogue: 5,0:14:04.58,0:14:07.65,Default,,0,0,0,,Ngay khoảnh khắc tôi đồng ý với yêu cầu hợp tác của họ.
Dialogue: 5,0:14:08.38,0:14:11.24,Default,,0,0,0,,Tôi chưa bao giờ nghĩ ông là kẻ khôn ngoan, nhưng đến mức này ư?
Dialogue: 5,0:14:12.05,0:14:15.52,Default,,0,0,0,,Ông sẽ phải hối hận vì sự ngoan cố của mình đấy.
Dialogue: 5,0:14:23.71,0:14:26.24,Default,,0,0,0,,Khủng bố bằng ký ức giả...
Dialogue: 5,0:14:27.26,0:14:30.55,Default,,0,0,0,,Tuyên bố của cô cuối cùng đã được chứng minh rồi đấy, Thiếu tá.
Dialogue: 5,0:14:30.55,0:14:34.14,Default,,0,0,0,,Sự tồn tại của một con virus cho phép hack Hồn cũng vậy.
Dialogue: 5,0:14:34.57,0:14:38.10,Default,,0,0,0,,Đây là nhiệm vụ tiếp theo của cô: áp giải cô bé đến Tổ chức 501.
Dialogue: 5,0:14:38.51,0:14:40.81,Default,,0,0,0,,Cái gì? Có yêu cầu đó thật sao?
Dialogue: 5,0:14:40.81,0:14:43.53,Default,,0,0,0,,Có chữ ký của Bộ trưởng Quốc phòng đấy.
Dialogue: 5,0:14:43.53,0:14:45.75,Default,,0,0,0,,Giờ hãy cho tôi mượn một người của cô để đổi lại đi.
Dialogue: 5,0:14:45.75,0:14:49.20,Default,,0,0,0,,Cô đồng nghiệp cũ đáng sợ vừa rồi khiến ông muốn có vệ sĩ à?
Dialogue: 5,0:14:49.20,0:14:51.01,Default,,0,0,0,,Tôi muốn chia sẻ thông tin.
Dialogue: 5,0:14:51.01,0:14:52.78,Default,,0,0,0,,Hãy đi hâm nóng lại tình cảm với nơi làm việc cũ đi.
Dialogue: 5,0:14:53.38,0:14:54.88,Default,,0,0,0,,Tôi có thể hỏi một câu không?
Dialogue: 5,0:14:54.88,0:14:55.75,Default,,0,0,0,,Chuyện gì thế?
Dialogue: 5,0:14:56.60,0:14:59.00,Default,,0,0,0,,Giả sử tôi thực sự đã bắn bà ta...
Dialogue: 5,0:15:00.03,0:15:03.44,Default,,0,0,0,,tại sao ông lại không dùng chiếc chìa khóa thâm nhập Hồn của tôi để ngăn tôi lại?
Dialogue: 5,0:15:06.16,0:15:08.72,Default,,0,0,0,,Tôi không thể trả lời những câu hỏi giả định.
Dialogue: 5,0:15:09.61,0:15:10.35,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 5,0:15:12.72,0:15:16.14,Default,,0,0,0,,Đây là Tiến sĩ Zhinzhee Bekka Arr Thied, người mà Thiếu tá đã bắn chết.
Dialogue: 5,0:15:16.74,0:15:20.86,Default,,0,0,0,,Bà ta là người Qhardi, nhưng đã tốt nghiệp thủ khoa Đại học Hoàng gia Kuzan.
Dialogue: 5,0:15:20.86,0:15:25.61,Default,,0,0,0,,Một nhân vật sừng sỏ trong ngành nhập khẩu nước Kuzan từ thời chính phủ lâm thời.
Dialogue: 5,0:15:26.42,0:15:30.93,Default,,0,0,0,,Nhưng bà ta đã tài trợ cho khủng bố khi nhận ra thế giới sẽ ruồng bỏ đồng bào mình, nhỉ?
Dialogue: 5,0:15:31.65,0:15:34.59,Default,,0,0,0,,Bà ta thông minh và có động cơ, nhưng bà ta không phải là một hacker.
Dialogue: 5,0:15:35.41,0:15:38.22,Default,,0,0,0,,Có kẻ khác đã đóng gói mớ này.
Dialogue: 5,0:15:38.22,0:15:40.50,Default,,0,0,0,,Thế còn cô bé mà chúng ta bắt giữ thì sao?
Dialogue: 5,0:15:42.12,0:15:45.63,Default,,0,0,0,,Tên cô bé là Tsuda Emma. Một đứa trẻ mồ côi vì chiến tranh 17 tuổi.
Dialogue: 5,0:15:45.63,0:15:49.67,Default,,0,0,0,,Cô bé tạo ra những trò chơi não điện tử ăn khách,\Nvà đăng ký bản quyền dưới cái tên "Tin Man" (Người Thiếc).
Dialogue: 5,0:15:50.07,0:15:52.92,Default,,0,0,0,,"Người Thiếc"... Như trong chuyện Phù thủy xứ Oz à?
Dialogue: 5,0:15:52.92,0:15:54.18,Default,,0,0,0,,Cái gì thế?
Dialogue: 5,0:15:54.51,0:16:01.66,Default,,0,0,0,,{\an8}Bất chấp tất cả, tôi vẫn tin rằng sâu thẳm trong tim con người ta vốn luôn hướng thiện.{\i0}
Dialogue: 5,0:15:55.17,0:15:59.35,Default,,0,0,0,,Cứ cho cô bé là một siêu hacker tuổi thiếu niên đi, cô bé ăn nhập thế nào vào vụ này?
Dialogue: 5,0:15:59.99,0:16:03.09,Default,,0,0,0,,Đừng bảo với tôi cô bé chính là người cô đang săn lùng đấy nhé?
Dialogue: 5,0:16:01.66,0:16:04.81,Default,,0,0,0,,{\an8}Tôi ước mong được tiếp tục sống ngay cả sau khi đã chết đi.{\i0}
Dialogue: 5,0:16:03.09,0:16:05.81,Default,,0,0,0,,Tôi sẽ biết khi tôi lặn vào Hồn của cô bé.
Dialogue: 5,0:16:06.25,0:16:08.32,Default,,0,0,0,,Ishikawa, tiếp tục theo dõi sát con virus và cô bé.
Dialogue: 5,0:16:08.32,0:16:10.07,Default,,0,0,0,,Saito, cậu tới Đội 9.
Dialogue: 5,0:16:10.07,0:16:12.48,Default,,0,0,0,,Paz và Borma, hai người đi thả mồi nhử.
Dialogue: 5,0:16:12.48,0:16:15.93,Default,,0,0,0,,Batou, Togusa, và tôi sẽ áp giải cô bé.
Dialogue: 5,0:16:15.93,0:16:17.53,Default,,0,0,0,,Chúng ta bắt đầu hiệp hai thôi.
Dialogue: 5,0:16:18.85,0:16:22.99,Default,,0,0,0,,Có một đề xuất cho cô đây, tiểu thư "Đầu nóng lao bừa".
Dialogue: 5,0:16:24.02,0:16:28.84,Default,,0,0,0,,Hay là để tôi làm trưởng nhóm và dẫn dắt chúng ta rút lui một cách hợp lý nhé?
Dialogue: 5,0:16:28.84,0:16:31.85,Default,,0,0,0,,Gan dạ đấy khi dám nói câu đó ngay trong không gian não điện tử của tôi.
Dialogue: 5,0:16:35.29,0:16:37.76,Default,,0,0,0,,Cô muốn ra ngoài giải quyết không?!
Dialogue: 5,0:16:38.19,0:16:41.63,Default,,0,0,0,,Ủa thôi, thôi đi hai người ơi!
Dialogue: 5,0:17:07.03,0:17:08.84,Default,,0,0,0,,Cuối cùng thì hắn cũng chịu di chuyển rồi.
Dialogue: 5,0:17:08.84,0:17:10.96,Default,,0,0,0,,Tưởng chết vì buồn chán chứ!
Dialogue: 5,0:17:18.51,0:17:21.18,Default,,0,0,0,,Có khi sẽ rất ngầu nếu chúng ta có thể ngồi cưỡi bên trong cậu đấy.
Dialogue: 5,0:17:21.18,0:17:25.45,Default,,0,0,0,,Thiếu tá đã yêu cầu một khoang vận chuyển người từ Phòng Bảo trì rồi ạ!
Dialogue: 5,0:17:25.45,0:17:27.65,Default,,0,0,0,,Chúng tôi sẽ điều khiển cậu từ bên trong sao?
Dialogue: 5,0:17:27.65,0:17:29.15,Default,,0,0,0,,Chẳng phải đó là kho vũ khí di động của chúng ta à?
Dialogue: 5,0:17:29.73,0:17:31.20,Default,,0,0,0,,Thế thì vũ khí nhét vào đâu?
Dialogue: 5,0:17:32.44,0:17:34.45,Default,,0,0,0,,Chúng ta có thể tự tiếp tế cho nhau mà.
Dialogue: 5,0:17:34.45,0:17:37.40,Default,,0,0,0,,Nếu vũ trang cho gã này, hắn có thể làm lực lượng yểm trợ cho chúng ta đấy.
Dialogue: 5,0:17:37.40,0:17:39.40,Default,,0,0,0,,Yểm trợ à, hử?
Dialogue: 5,0:17:39.40,0:17:42.90,Default,,0,0,0,,Tại sao chúng ta lại phải dùng một mẫu Hậu cần cổ lỗ sĩ thế này chứ?
Dialogue: 5,0:17:42.90,0:17:47.16,Default,,0,0,0,,Mặt Khỉ không xin được ngân sách như Thiếu tá mong muốn,\Nnên ông ấy mới ném cho chúng ta mấy con bot này.
Dialogue: 5,0:17:47.87,0:17:51.87,Default,,0,0,0,,Dù sao thì AI loại vi mạch thần kinh rất khó bị hack hay bị nhiễm virus.
Dialogue: 5,0:17:51.87,0:17:54.17,Default,,0,0,0,,Nên về cơ bản, hoặc là phục vụ chúng ta, hoặc là ra bãi phế liệu chứ gì?
Dialogue: 5,0:17:54.58,0:17:55.75,Default,,0,0,0,,Cái gì cơ?
Dialogue: 5,0:17:55.75,0:18:00.83,Default,,0,0,0,,Không đủ tốt đối với một cựu cảnh sát vẫn còn đeo cà vạt đấy à?
Dialogue: 5,0:18:00.83,0:18:05.73,Default,,0,0,0,,Người cha quá cố của tôi từng bảo ăn mặc lịch sự thể hiện niềm tin vào chính mình.
Dialogue: 5,0:18:06.34,0:18:09.69,Default,,0,0,0,,Nhìn anh, cựu Biệt kích, tôi hiểu ý của ông ấy rồi.
Dialogue: 5,0:18:10.24,0:18:12.65,Default,,0,0,0,,Mạnh miệng gớm nhỉ, nhóc.
Dialogue: 5,0:18:15.74,0:18:20.19,Default,,0,0,0,,Ngài Batou đề xuất cải tiến chúng tôi để mọi người có thể ngồi lên!
Dialogue: 5,0:18:20.19,0:18:22.23,Default,,0,0,0,,Tôi nghĩ đó thực sự là một ý tưởng tuyệt vời ạ!
Dialogue: 5,0:18:22.23,0:18:24.62,Default,,0,0,0,,Thiếu tá nghĩ sao?
Dialogue: 5,0:18:24.95,0:18:26.94,Default,,0,0,0,,Bớt diễn kịch đi.
Dialogue: 5,0:18:27.70,0:18:30.60,Default,,0,0,0,,Tôi ghét những cỗ máy giả vờ có nhân cách.
Dialogue: 5,0:18:32.59,0:18:33.41,Default,,0,0,0,,Cô bé tới rồi.
Dialogue: 5,0:18:47.58,0:18:50.79,Default,,0,0,0,,Em đã cố tình hack đường truyền của tôi để bị bắt đúng không?
Dialogue: 5,0:18:52.42,0:18:54.48,Default,,0,0,0,,"Fire-Starter" là cái gì?
Dialogue: 5,0:18:54.48,0:18:56.32,Default,,0,0,0,,Đó thực sự là tên của một hacker sao?
Dialogue: 5,0:18:57.26,0:18:59.76,Default,,0,0,0,,Cục Tình báo muốn có em.
Dialogue: 5,0:18:59.76,0:19:02.28,Default,,0,0,0,,Tòa án quân sự không có chuyện mặc cả giảm án đâu, em biết đấy.
Dialogue: 5,0:19:05.66,0:19:07.75,Default,,0,0,0,,Em ngửi thấy mùi nước biển.
Dialogue: 5,0:19:08.64,0:19:12.23,Default,,0,0,0,,Chúng em thậm chí còn không được phép đến gần biển.
Dialogue: 5,0:19:13.18,0:19:18.34,Default,,0,0,0,,Các lập trình viên chẳng khác nào vũ khí:\Nchúng em bị pháp luật cấm không được tự do di chuyển.
Dialogue: 5,0:19:18.34,0:19:20.56,Default,,0,0,0,,Vậy em thực sự là hacker của nhóm.
Dialogue: 5,0:19:20.56,0:19:21.97,Default,,0,0,0,,Em muốn gì?
Dialogue: 5,0:19:21.97,0:19:27.88,Default,,0,0,0,,Ngày xưa, những người thợ thổi thủy tinh không hề có tự do, bởi nghề thủy tinh nuôi sống cả quốc gia.
Dialogue: 5,0:19:28.59,0:19:32.69,Default,,0,0,0,,Nếu họ trốn khỏi đất nước, họ sẽ bị chọc mù mắt trước tiên.
Dialogue: 5,0:19:33.26,0:19:34.53,Default,,0,0,0,,Em là dân tị nạn sao?
Dialogue: 5,0:19:34.53,0:19:36.15,Default,,0,0,0,,Đó là lý do tại sao em phát động một cuộc thảm sát à?
Dialogue: 5,0:19:39.01,0:19:41.93,Default,,0,0,0,,Chị có nghĩ não điện tử mang lại hạnh phúc cho con người không?
Dialogue: 5,0:19:46.82,0:19:49.15,Default,,0,0,0,,Ký ức của chị có đáng tin không?
Dialogue: 5,0:19:49.15,0:19:51.79,Default,,0,0,0,,Hay chúng đã được ai đó cấy vào rồi?
Dialogue: 5,0:19:53.18,0:19:59.81,Default,,0,0,0,,Khi quá trình cơ thể hóa bằng vi máy móc diễn ra,\Ncác chuyên gia trên toàn thế giới đã cảnh báo chúng ta:
Dialogue: 5,0:19:59.81,0:20:02.90,Default,,0,0,0,,"Ký ức giả tạo sẽ bị sử dụng để phạm tội."
Dialogue: 5,0:20:03.59,0:20:06.41,Default,,0,0,0,,Mọi tổ chức đều khao khát công nghệ đó.
Dialogue: 5,0:20:06.41,0:20:07.97,Default,,0,0,0,,Công nghệ của em.
Dialogue: 5,0:20:08.41,0:20:11.18,Default,,0,0,0,,Ý em là em đã tạo ra thành công công nghệ thao túng ký ức sao?
Dialogue: 5,0:20:12.60,0:20:14.90,Default,,0,0,0,,Ký ức của chị thậm chí có thể...
Dialogue: 5,0:20:17.57,0:20:20.47,Default,,0,0,0,,Tôi sẽ lặn ngay tại đây, ngay lúc này!
Dialogue: 5,0:20:20.47,0:20:21.96,Default,,0,0,0,,Biết ngay mà.
Dialogue: 5,0:20:22.68,0:20:25.07,Default,,0,0,0,,Chúng ta chưa biết con virus này là thứ gì.
Dialogue: 5,0:20:25.07,0:20:26.53,Default,,0,0,0,,Lỡ cô bị nhiễm thì sao?
Dialogue: 5,0:20:27.50,0:20:30.14,Default,,0,0,0,,Tôi sẽ thổi bay nó, cùng với cả não điện tử của cô ta.
Dialogue: 5,0:20:30.14,0:20:35.50,Default,,0,0,0,,Một hacker gây ra vụ thảm sát hàng loạt chỉ để chạy trốn thì đáng bị ám sát.
Dialogue: 5,0:20:35.50,0:20:37.46,Default,,0,0,0,,Ngay trong lúc cô đang lặn á?!
Dialogue: 5,0:20:37.46,0:20:39.96,Default,,0,0,0,,Phong cách tác chiến mạng của cô méo mó thật đấy.
Dialogue: 5,0:20:40.29,0:20:42.47,Default,,0,0,0,,Tôi thích dùng từ "cấp siêu phù thủy" hơn.
Dialogue: 5,0:20:43.34,0:20:46.12,Default,,0,0,0,,"Phù thủy"... Ảo thuật gia.
Dialogue: 5,0:20:46.12,0:20:48.18,Default,,0,0,0,,Ảo thuật gia không thể trở về nhà...
Dialogue: 5,0:20:48.90,0:20:50.89,Default,,0,0,0,,Tôi đang lặn thẳng vào qua đường truyền của cô bé.
Dialogue: 5,0:20:50.89,0:20:52.59,Default,,0,0,0,,Ừ rồi, lại phớt lờ quy trình.
Dialogue: 5,0:20:54.18,0:20:55.85,Default,,0,0,0,,Này, có cái gì đó lạ lắm.
Dialogue: 5,0:20:59.02,0:21:00.52,Default,,0,0,0,,Cô đang bị hack kìa!
Dialogue: 5,0:21:00.52,0:21:02.24,Default,,0,0,0,,Bọn chúng đang làm điều đó thông qua não điện tử của cô bé!
Dialogue: 5,0:21:03.18,0:21:05.66,Default,,0,0,0,,Chuyện gì đang xảy ra thế này? Đây đâu chỉ là phản kích thông thường!
Dialogue: 5,0:21:06.70,0:21:09.62,Default,,0,0,0,,Emma... Nguy hiểm... Emma...
Dialogue: 5,0:21:15.53,0:21:16.51,Default,,0,0,0,,Ngươi...
Dialogue: 5,0:21:25.59,0:21:26.73,Default,,0,0,0,,Thiếu tá!
Dialogue: 5,0:21:31.43,0:21:33.60,Default,,0,0,0,,Tôi xin lỗi, Emma...
Dialogue: 5,0:21:33.60,0:21:35.08,Default,,0,0,0,,Tôi xin lỗi.
Dialogue: 5,0:21:35.08,0:21:38.52,Default,,0,0,0,,Không sao đâu. Em muốn điều này mà.
Dialogue: 5,0:21:39.08,0:21:40.77,Default,,0,0,0,,Đừng khóc, Brinda.
Dialogue: 5,0:21:42.98,0:21:45.72,Default,,0,0,0,,Có tới hai linh Hồn ở bên trong đó ư?
Dialogue: 5,0:21:55.98,0:21:58.27,Default,,0,0,0,,Tôi nghe nói về sự can thiệp của Đội 9 rồi.
Dialogue: 5,0:21:59.43,0:22:02.81,Default,,0,0,0,,Các người không thể bắn chết ả trước khi ả bắt đầu bép xép về chuyện tị nạn sao?
Dialogue: 5,0:22:02.81,0:22:06.55,Default,,0,0,0,,Vụ nổ súng đó hiện đang được điều tra, thưa Phó Cục trưởng Amagata.
Dialogue: 5,0:22:07.19,0:22:12.00,Default,,0,0,0,,Tôi có thể hình dung ra những tác động sâu sắc mà vụ việc này sẽ gây ra
Dialogue: 5,0:22:12.00,0:22:16.52,Default,,0,0,0,,cho Ủy ban Thẩm tra Vũ khí Thế hệ Mới mà ngài đang phục vụ.
Dialogue: 5,0:22:16.52,0:22:19.65,Default,,0,0,0,,Hội chợ ngành công nghiệp cuối năm đã bị hủy bỏ.
Dialogue: 5,0:22:19.65,0:22:24.79,Default,,0,0,0,,Và nhờ áp lực từ Bộ Ngoại giao, chúng ta cũng sẽ không ra mắt các mẫu vũ khí thử nghiệm.
Dialogue: 5,0:22:24.79,0:22:27.49,Default,,0,0,0,,Nó đang làm lung lay tận gốc rễ của tập đoàn.
Dialogue: 5,0:22:27.99,0:22:33.11,Default,,0,0,0,,Tôi nghe nói ngài đang thúc đẩy các thương vụ bán nước quy mô lớn ngay cả sau cái chết của Tiến sĩ Thied.
Dialogue: 5,0:22:33.11,0:22:35.68,Default,,0,0,0,,Tôi có nghĩa vụ phải hoàn thành hợp đồng của mình.
Dialogue: 5,0:22:35.68,0:22:39.96,Default,,0,0,0,,Và việc sử dụng hiệu quả tài nguyên là chìa khóa đối với một công ty quốc tế.
Dialogue: 5,0:22:40.48,0:22:43.55,Default,,0,0,0,,Có những người ngoài kia thậm chí còn không có nổi nước uống.
Dialogue: 5,0:22:44.33,0:22:47.63,Default,,0,0,0,,Nếu ngài đến đây để chỉ trích đường lối kinh tế của tôi, tôi còn có những việc khác đang chờ.
Dialogue: 5,0:22:55.69,0:22:58.84,Default,,0,0,0,,Ông không hợp với công việc chính quyền đâu.
Dialogue: 5,0:22:58.84,0:23:02.40,Default,,0,0,0,,Hãy lập một tổ chức phi chính phủ (NPO) rồi đến sống ở trại tị nạn nào đó đi.
Dialogue: 5,0:23:07.32,0:23:09.35,Default,,0,0,0,,Gã đó thật khó chịu.
Dialogue: 5,0:23:09.35,0:23:13.87,Default,,0,0,0,,Lão là một cựu chính trị gia điển hình, và lão nợ tôi một ân huệ từ hồi tôi còn làm tình báo.
Dialogue: 5,0:23:13.87,0:23:16.23,Default,,0,0,0,,Điều đó có nghĩa lão là một nguồn tin đáng tin cậy.
Dialogue: 5,0:23:18.02,0:23:21.42,Default,,0,0,0,,Các NPO, các khu trại tị nạn... và Bộ Ngoại giao sao?
Dialogue: 5,0:23:22.01,0:23:23.83,Default,,0,0,0,,Hội đồng phát triển vũ khí!
Dialogue: 5,0:23:25.17,0:23:28.13,Default,,0,0,0,,Đó có phải là mục tiêu đằng sau cuộc khủng bố mạng nhằm vào Harimadara không?
Dialogue: 5,0:23:28.66,0:23:34.37,Default,,0,0,0,,Gần đây đang có tranh cãi về việc vũ khí thế hệ mới nên sản xuất trong nước hay phát triển ở nước ngoài.
Dialogue: 5,0:23:34.37,0:23:38.87,Default,,0,0,0,,Phe thân nước ngoài sẽ sướng rơn nếu một nhà sản xuất nội địa bị tấn công.
Dialogue: 5,0:23:39.83,0:23:43.95,Default,,0,0,0,,Đây rồi: một NPO chuyên "điều trị các chứng rối loạn cơ thể hóa".
Dialogue: 5,0:23:43.95,0:23:49.88,Default,,0,0,0,,Họ đã phổ biến thiết bị cơ thể hóa và học tập trong các trại tị nạn ở Kuzan thời chiến tranh.
Dialogue: 5,0:23:49.88,0:23:51.40,Default,,0,0,0,,Thế còn trong nước?
Dialogue: 5,0:23:51.40,0:23:55.78,Default,,0,0,0,,Tìm thấy cô bé đó trong hồ sơ điều trị của chính NPO này rồi.
Dialogue: 5,0:23:55.78,0:23:58.12,Default,,0,0,0,,Hội chứng đào thải cơ thể hóa.
Dialogue: 5,0:23:58.12,0:24:02.29,Default,,0,0,0,,Rõ ràng là cô bé đã bỏ trốn khỏi một cơ sở trẻ mồ côi vì chiến tranh do từ chối bị cơ thể hóa.
Dialogue: 5,0:24:02.69,0:24:05.09,Default,,0,0,0,,Không muốn có não điện tử thì bị coi là có bệnh sao?
Dialogue: 5,0:24:05.79,0:24:11.22,Default,,0,0,0,,Sách trắng về cơ thể hóa mà Bộ Y tế công bố sau chiến tranh xếp nó chung với chứng biếng ăn đấy.
Dialogue: 5,0:24:11.22,0:24:13.18,Default,,0,0,0,,Giờ tôi mới biết đấy.
Dialogue: 5,0:24:14.28,0:24:17.91,Default,,0,0,0,,Ngành kinh doanh cơ thể hóa kiếm được những khoản tiền khổng lồ đến điên rồ.
Dialogue: 5,0:24:17.91,0:24:23.08,Default,,0,0,0,,Khá dễ đoán khi những người không muốn nó bị đối xử như người bệnh.
Dialogue: 5,0:24:23.08,0:24:26.11,Default,,0,0,0,,Liệu cô bé có thể là một trường hợp đa nhân cách thực sự không?
Dialogue: 5,0:24:26.11,0:24:30.64,Default,,0,0,0,,Giả thuyết phổ biến là nhân cách có thể phân chia nhưng Hồn thì không.
Dialogue: 5,0:24:31.36,0:24:37.33,Default,,0,0,0,,Vấn đề là, NPO đó có liên hệ gì với một thương vụ kinh doanh xuất phát từ phát triển quân sự?
Dialogue: 5,0:24:37.73,0:24:41.79,Default,,0,0,0,,Tấn công vào tổ hợp công nghiệp quân sự từ cả hai đầu. Binh lính và các tập đoàn.
Dialogue: 5,0:24:53.00,0:24:54.24,Default,,0,0,0,,Tôi đây.
Dialogue: 5,0:24:54.24,0:24:56.30,Default,,0,0,0,,Những người khác bị bắt rồi.
Dialogue: 5,0:24:59.88,0:25:03.27,Default,,0,0,0,,Đừng lo, cậu sẽ sớm gặp lại họ dưới suối vàng thôi.
Dialogue: 5,0:25:08.51,0:25:09.40,Default,,0,0,0,,Xin chào!
Dialogue: 5,0:25:10.01,0:25:11.29,Default,,0,0,0,,A-Anh là cảnh sát à?
Dialogue: 5,0:25:15.98,0:25:18.44,Default,,0,0,0,,T-Tôi đã chuẩn bị sẵn bản tự thú rồi.
Dialogue: 5,0:25:18.44,0:25:19.99,Default,,0,0,0,,Để tôi gọi cho luật sư của tôi—
Dialogue: 5,0:25:21.19,0:25:23.50,Default,,0,0,0,,Tôi không nghĩ chuyện đó sẽ xảy ra đâu.
Dialogue: 5,0:25:24.31,0:25:27.07,Default,,0,0,0,,Mày vừa giết con mồi của bọn tao.
Dialogue: 5,0:25:27.07,0:25:29.46,Default,,0,0,0,,Tốt hơn hết là bắt đầu khai đi.
Dialogue: 5,0:25:36.02,0:25:38.39,Default,,0,0,0,,Bắt đầu thấy nhớ mái nhà xưa rồi à?
Dialogue: 5,0:25:40.45,0:25:44.10,Default,,0,0,0,,Tôi chỉ ở đây để áp giải nhân chứng của cô thôi, Trung tá Kurutsu.
Dialogue: 5,0:25:44.10,0:25:46.14,Default,,0,0,0,,Tsumugi đang túc trực.
Dialogue: 5,0:25:46.14,0:25:48.52,Default,,0,0,0,,Cứ lặn nếu cô muốn.
Dialogue: 5,0:25:48.52,0:25:50.11,Default,,0,0,0,,Cứ cho là cô bé đó có một linh Hồn đi đã.
Dialogue: 5,0:25:51.31,0:25:52.26,Default,,0,0,0,,Ý cô là sao?
Dialogue: 5,0:25:53.05,0:25:54.66,Default,,0,0,0,,Tôi phải ra ngoài rồi.
Dialogue: 5,0:25:54.66,0:25:58.45,Default,,0,0,0,,Với tư cách là thành viên của ủy ban, tôi cần phải có mặt tại buổi kiểm tra sản phẩm của Harimadara.
Dialogue: 5,0:25:58.94,0:26:01.61,Default,,0,0,0,,Vẫn còn ám ảnh với sự nghiệp quân ngũ của cô à?
Dialogue: 5,0:26:02.34,0:26:04.75,Default,,0,0,0,,Ít nhất thì tôi cũng không trốn chạy khỏi nó.
Dialogue: 5,0:26:30.69,0:26:32.36,Default,,0,0,0,,Rất vui được gặp lại cô, Kusanagi.
Dialogue: 5,0:26:32.82,0:26:35.70,Default,,0,0,0,,Tôi không nghĩ chúng ta lại có cơ hội khác để làm việc cùng cô.
Dialogue: 5,0:26:35.70,0:26:37.32,Default,,0,0,0,,Đây là người của cô à?
Dialogue: 5,0:26:37.73,0:26:39.77,Default,,0,0,0,,Phải. Batou và Togusa.
Dialogue: 5,0:26:40.43,0:26:42.27,Default,,0,0,0,,Đây là Tsumugi Dokuro.
Dialogue: 5,0:26:42.27,0:26:44.54,Default,,0,0,0,,Họ đều là các sĩ quan chiến thuật tác chiến mạng.
Dialogue: 5,0:26:44.92,0:26:48.81,Default,,0,0,0,,"Đều" sao? Họ dùng chung một cơ thể à?
Dialogue: 5,0:26:48.81,0:26:52.17,Default,,0,0,0,,Cô ấy bảo họ là hai chị em sinh đôi trong một cơ thể dính liền.
Dialogue: 5,0:26:52.17,0:26:55.00,Default,,0,0,0,,Tôi chẳng hiểu họ di chuyển kiểu gì nữa.
Dialogue: 5,0:26:55.00,0:26:56.51,Default,,0,0,0,,Thế giới này đầy rẫy những điều bất ngờ.
Dialogue: 5,0:27:00.15,0:27:02.02,Default,,0,0,0,,Bắt đầu thôi.
Dialogue: 5,0:27:11.33,0:27:13.66,Default,,0,0,0,,Vậy là, chỉ có cái xác là trở về.
Dialogue: 5,0:27:13.66,0:27:14.65,Default,,0,0,0,,Ý cô là sao?
Dialogue: 5,0:27:15.33,0:27:18.32,Default,,0,0,0,,Cô ấy là một sĩ quan kỹ thuật thuộc quyền chỉ huy của Trung tá Kurutsu.
Dialogue: 5,0:27:18.88,0:27:23.04,Default,,0,0,0,,Cô ấy từng điều tra một hacker sở hữu bộ não điện tử loại vi mạch thần kinh đặc biệt.
Dialogue: 5,0:27:24.06,0:27:25.54,Default,,0,0,0,,Hắn được biết đến với biệt danh "Scarecrow" (Bù nhìn rơm),
Dialogue: 5,0:27:25.91,0:27:29.17,Default,,0,0,0,,và hắn là nghi phạm trong vụ tấn công khủng bố nhằm vào Harimadara.
Dialogue: 5,0:27:29.17,0:27:32.17,Default,,0,0,0,,Lại một nhân vật trong chuyện xứ Oz nữa à?
Dialogue: 5,0:27:32.17,0:27:33.13,Default,,0,0,0,,Hả?
Dialogue: 5,0:27:33.66,0:27:38.41,Default,,0,0,0,,Kết luận của chúng tôi là hắn là một điệp viên đặc biệt dựa trên công nghệ thời hậu chiến.
Dialogue: 5,0:27:39.20,0:27:41.77,Default,,0,0,0,,Emma chính là người đã suy luận ra điều đó.
Dialogue: 5,0:27:41.77,0:27:45.31,Default,,0,0,0,,Cô bé đưa ra giả thuyết về một hacker mắc chứng rối loạn tương tự như cô bé.
Dialogue: 5,0:27:45.31,0:27:49.85,Default,,0,0,0,,Một kẻ buộc phải thay thế dần dần bộ não của mình bằng các vi mạch thần kinh và cơ thể hóa để sinh tồn.
Dialogue: 5,0:27:50.27,0:27:52.56,Default,,0,0,0,,Cô bé mắc chứng rối loạn đó sao?
Dialogue: 5,0:27:53.26,0:27:57.64,Default,,0,0,0,,Nhân cách bị suy giảm, và bản ngã không thể duy trì nếu thiếu các bộ não điện tử phụ trợ.
Dialogue: 5,0:27:57.64,0:28:03.11,Default,,0,0,0,,Emma biến sự khiếm khuyết của mình thành nét đặc trưng, và Scarecrow cũng vậy.
Dialogue: 5,0:28:03.11,0:28:07.96,Default,,0,0,0,,Emma thường xuyên sử dụng cơ thể hóa tiên tiến để cấu trúc bản ngã, nhưng Scarecrow thì khác.
Dialogue: 5,0:28:08.81,0:28:11.82,Default,,0,0,0,,Để bù đắp cho nhân cách bị suy giảm của mình, hắn sao chép Hồn (Ghost Dubbing) của người khác,
Dialogue: 5,0:28:11.82,0:28:14.72,Default,,0,0,0,,cướp đoạt cơ thể của họ, và chiếm đoạt danh tính của họ.
Dialogue: 5,0:28:14.72,0:28:18.00,Default,,0,0,0,,Giống như con bù nhìn rơm không biết suy nghĩ nhét một bộ não giả vào đầu vậy.
Dialogue: 5,0:28:18.36,0:28:19.71,Default,,0,0,0,,Nghiêm túc đấy chứ?
Dialogue: 5,0:28:20.14,0:28:22.21,Default,,0,0,0,,Nói cách khác, đây là...
Dialogue: 5,0:28:22.21,0:28:23.73,Default,,0,0,0,,Cơ thể là của Emma,
Dialogue: 5,0:28:23.73,0:28:30.46,Default,,0,0,0,,nhưng nó đang được vận hành bởi bộ não của một người đàn ông chỉ bằng một phần ba kích thước bình thường và được cơ thể hóa bằng vi mạch thần kinh.
Dialogue: 5,0:28:31.38,0:28:35.94,Default,,0,0,0,,Vậy thứ tôi đã lặn vào chính là linh Hồn bị sao chép của cô bé.
Dialogue: 5,0:28:35.94,0:28:38.40,Default,,0,0,0,,Chuyện gì đã xảy ra với bộ não của cô bé?
Dialogue: 5,0:28:38.40,0:28:40.40,Default,,0,0,0,,Việc sao chép Hồn (Ghost Dubbing) ắt hẳn đã làm nó thoái hóa rồi.
Dialogue: 5,0:28:40.40,0:28:43.94,Default,,0,0,0,,Nó hoặc là đã nằm trong thùng rác hoặc bị cắt lát trong phòng nghiên cứu của hắn rồi.
Dialogue: 5,0:28:43.94,0:28:45.37,Default,,0,0,0,,Thật kinh khủng...
Dialogue: 5,0:28:46.66,0:28:48.62,Default,,0,0,0,,Tội nghiệp Emma.
Dialogue: 5,0:28:48.62,0:28:50.06,Default,,0,0,0,,Tôi xin lỗi.
Dialogue: 5,0:28:50.06,0:28:51.33,Default,,0,0,0,,Không sao đâu, Junior.
Dialogue: 5,0:28:51.33,0:28:53.00,Default,,0,0,0,,Đừng sợ.
Dialogue: 5,0:28:53.00,0:28:55.06,Default,,0,0,0,,Tôi biết những chú sư tử sẽ đến mà.
Dialogue: 5,0:28:55.06,0:28:56.79,Default,,0,0,0,,Những con người mang lòng dũng cảm...
Dialogue: 5,0:28:56.79,0:28:58.72,Default,,0,0,0,,Ngươi là ai?
Dialogue: 5,0:28:58.72,0:29:00.40,Default,,0,0,0,,Nói cho tôi biết ngươi làm việc cho ai.
Dialogue: 5,0:29:00.40,0:29:02.09,Default,,0,0,0,,Tôi là một con bù nhìn rơm.
Dialogue: 5,0:29:02.09,0:29:04.19,Default,,0,0,0,,Bộ não của tôi đang dần phai nhạt.
Dialogue: 5,0:29:04.19,0:29:07.26,Default,,0,0,0,,Tôi là người thiếc. Trái tim tôi đang dần phai nhạt.
Dialogue: 5,0:29:07.26,0:29:12.24,Default,,0,0,0,,Đó là Emma đang nói, hay là linh Hồn bị sao chép của cô bé?
Dialogue: 5,0:29:12.24,0:29:15.10,Default,,0,0,0,,Cô Bé Thiếc, hãy cho tôi biết tên của gã đàn ông bù nhìn rơm đi.
Dialogue: 5,0:29:17.65,0:29:20.28,Default,,0,0,0,,Tên của anh ấy là Brinda Jr.
Dialogue: 5,0:29:20.28,0:29:22.32,Default,,0,0,0,,Làm ơn, đừng trách anh ấy.
Dialogue: 5,0:29:25.42,0:29:27.64,Default,,0,0,0,,{\i1}Tìm thấy manh mối tại một viện dưỡng lão hậu chiến rồi!{\i0}
Dialogue: 5,0:29:27.64,0:29:30.28,Default,,0,0,0,,{\i1}Và chính NPO đó có dính líu đến nơi này.{\i0}
Dialogue: 5,0:29:30.28,0:29:32.27,Default,,0,0,0,,{\i1}Brinda Jr., 32 tuổi.{\i0}
Dialogue: 5,0:29:32.27,0:29:35.04,Default,,0,0,0,,{\i1}Sau khi cơ thể hóa, hắn trở thành kế toán tại một trung tâm môi giới việc làm.{\i0}
Dialogue: 5,0:29:35.65,0:29:40.50,Default,,0,0,0,,{\i1}Nhân cách của hắn rất mờ nhạt, nhưng hắn đã ghi nhớ một dãy số 200 chữ số trong hai giây cho một bài kiểm tra IQ.{\i0}
Dialogue: 5,0:29:41.15,0:29:43.94,Default,,0,0,0,,{\i1}Đó là đặc trưng kinh điển của một người có năng lực nhận thức đặc biệt.{\i0}
Dialogue: 5,0:29:43.94,0:29:46.89,Default,,0,0,0,,{\i1}Hãy tìm xem tổ chức nào đã dựng hắn lên thành một hacker.{\i0}
Dialogue: 5,0:29:46.89,0:29:47.81,Default,,0,0,0,,{\i1}Rõ.{\i0}
Dialogue: 5,0:29:48.54,0:29:51.27,Default,,0,0,0,,Tôi sẽ lặn vào Hồn của gã đàn ông đó.
Dialogue: 5,0:29:52.05,0:29:55.48,Default,,0,0,0,,Chỉ có một số ít trường hợp Hồn kép được chứng minh là tồn tại thôi.
Dialogue: 5,0:29:55.48,0:29:57.37,Default,,0,0,0,,Chúng ta không biết những mối nguy hiểm đâu.
Dialogue: 5,0:29:58.02,0:30:01.17,Default,,0,0,0,,Tôi muốn biết linh Hồn nào có động cơ.
Dialogue: 5,0:30:01.17,0:30:03.94,Default,,0,0,0,,Cô đang nghi ngờ Emma sao? Cô bé là nạn nhân ở đây mà.
Dialogue: 5,0:30:04.28,0:30:05.83,Default,,0,0,0,,Vậy thì tôi sẽ xác nhận điều đó.
Dialogue: 5,0:30:05.83,0:30:09.41,Default,,0,0,0,,Batou, làm bọc lót cho tôi phòng khi bọn chúng hack ngược lại tôi.
Dialogue: 5,0:30:09.72,0:30:12.37,Default,,0,0,0,,Hai đánh hai à, hử?
Dialogue: 5,0:30:17.05,0:30:19.99,Default,,0,0,0,,Togusa. Sao chép lại toàn bộ hồ sơ đi.
Dialogue: 5,0:30:19.99,0:30:21.14,Default,,0,0,0,,Rõ.
Dialogue: 5,0:30:21.14,0:30:24.21,Default,,0,0,0,,Ồ, đây... Xin lỗi, cuộc gọi từ bố tôi.
Dialogue: 5,0:30:26.42,0:30:28.39,Default,,0,0,0,,Alo, bố à, lâu rồi con không gọi.
Dialogue: 5,0:30:28.39,0:30:28.89,Default,,0,0,0,,Vâng.
Dialogue: 5,0:30:29.19,0:30:31.23,Default,,0,0,0,,Batou! Khống chế Togusa mau!
Dialogue: 5,0:30:31.90,0:30:34.18,Default,,0,0,0,,Hiểu rồi. Tôi sẽ trở thành chú Sư tử.
Dialogue: 5,0:30:40.28,0:30:41.40,Default,,0,0,0,,Vẫn là khẩu Mateba sao?
Dialogue: 5,0:30:43.48,0:30:44.55,Default,,0,0,0,,Đứng im!
Dialogue: 5,0:30:57.25,0:30:58.00,Default,,0,0,0,,Thiếu tá!
Dialogue: 5,0:30:58.67,0:30:59.41,Default,,0,0,0,,Hành động thôi.
Dialogue: 5,0:31:02.21,0:31:03.92,Default,,0,0,0,,{\i1}Thế này là điên rồ thật rồi!{\i0}
Dialogue: 5,0:31:03.92,0:31:07.34,Default,,0,0,0,,{\i1}Tôi tìm thấy nhật ký Starter trên đường truyền của hắn—chính là con virus!{\i0}
Dialogue: 5,0:31:08.17,0:31:12.00,Default,,0,0,0,,Hắn chắc chắn đã giữ con virus ở trạng thái ngủ bên trong các vi mạch thần kinh của mình.
Dialogue: 5,0:31:12.00,0:31:14.16,Default,,0,0,0,,Tốc độ thâm nhập của hắn nhanh ngoài dự kiến.
Dialogue: 5,0:31:14.16,0:31:20.69,Default,,0,0,0,,Nó kết hợp ký ức của nạn nhân về mối thù trong quá khứ với các đồ vật trước mặt để cấy vào những ký ức giả tức thời sao?
Dialogue: 5,0:31:51.09,0:31:52.94,Default,,0,0,0,,Được phép dùng vũ lực chết người chứ?
Dialogue: 5,0:31:52.94,0:31:55.10,Default,,0,0,0,,Tôi sẽ dùng nó lên anh nếu anh không bắt đầu ngay bây giờ đấy.
Dialogue: 5,0:31:57.29,0:31:58.68,Default,,0,0,0,,Cô nghĩ tôi là ai chứ?!
Dialogue: 5,0:32:03.10,0:32:06.84,Default,,0,0,0,,{\i1}Con bù nhìn rơm là vật chủ của virus và bộ não của Togusa là gói dữ liệu, đúng không?{\i0}
Dialogue: 5,0:32:06.84,0:32:07.32,Default,,0,0,0,,Chuẩn rồi.
Dialogue: 5,0:32:07.78,0:32:10.47,Default,,0,0,0,,Nhưng lộ trình lây nhiễm có tính chọn lọc đến đáng lo ngại.
Dialogue: 5,0:32:10.47,0:32:12.78,Default,,0,0,0,,Chỉ những người xung quanh cô mới bị lây nhiễm thôi.
Dialogue: 5,0:32:14.88,0:32:17.88,Default,,0,0,0,,{\i1}Điều đó có nghĩa là sự khởi phát có thể được điều chỉnh sao?{\i0}
Dialogue: 5,0:32:17.88,0:32:21.45,Default,,0,0,0,,{\i1}Điều đó là bất khả thi nếu không có bên thứ ba bật công tắc.{\i0}
Dialogue: 5,0:32:21.45,0:32:25.25,Default,,0,0,0,,{\i1}Nghĩa là đây là một loại virus mà thiệt hại của nó có thể kiểm soát được.{\i0}
Dialogue: 5,0:32:25.82,0:32:29.46,Default,,0,0,0,,{\i1}Vậy thì nó là cấp quân sự rồi. Phân tích lại dữ liệu lây nhiễm hôm qua đi.{\i0}
Dialogue: 5,0:32:29.80,0:32:32.75,Default,,0,0,0,,{\i1}Chúng ta không muốn đuổi theo con virus; chúng ta muốn đuổi theo kẻ địch đang sở hữu nó.{\i0}
Dialogue: 5,0:32:33.54,0:32:36.68,Default,,0,0,0,,Tôi ước mong được tiếp tục sống ngay cả sau khi đã chết đi.
Dialogue: 5,0:32:37.22,0:32:38.39,Default,,0,0,0,,Dữ liệu ẩn sao?
Dialogue: 5,0:32:38.39,0:32:44.85,Default,,0,0,0,,Vì 620 lý do này, chúng tôi phản đối việc cơ thể hóa mà không có sự tự do lựa chọn.
Dialogue: 5,0:32:45.46,0:32:53.59,Default,,0,0,0,,Lý do: Chúng tôi khẳng định rằng phần mềm trong não điện tử rất dễ bị bên thứ ba can thiệp.
Dialogue: 5,0:32:54.38,0:32:59.24,Default,,0,0,0,,Lý do: Sự thay đổi điện tử của ký ức gây ra những bất thường
Dialogue: 5,0:32:59.24,0:33:03.54,Default,,0,0,0,,trong toàn bộ ý chí độc lập của chúng ta, thứ được gọi là "Hồn".
Dialogue: 5,0:33:04.58,0:33:09.50,Default,,0,0,0,,Các người thực sự nghĩ một thế giới không có lây nhiễm và thâm nhập là khả thi sao?!
Dialogue: 5,0:33:12.16,0:33:13.42,Default,,0,0,0,,{\i1}Tsumugi! Cô còn sống không?{\i0}
Dialogue: 5,0:33:14.07,0:33:17.47,Default,,0,0,0,,{\i1}Tôi đang chạy mô phỏng bộ não của con bù nhìn rơm. Giúp tôi một tay.{\i0}
Dialogue: 5,0:33:17.47,0:33:19.86,Default,,0,0,0,,{\i1}Cô có chiếc chìa khóa thâm nhập Hồn của Tsuda Emma đúng không?{\i0}
Dialogue: 5,0:33:19.86,0:33:21.16,Default,,0,0,0,,{\i1}Tạo cho tôi một cửa sau (backdoor).{\i0}
Dialogue: 5,0:33:21.16,0:33:22.36,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 5,0:33:22.36,0:33:26.90,Default,,0,0,0,,Cô định dùng cấu trúc não điện tử của Scarecrow để xấp xỉ một loại vắc-xin sao?
Dialogue: 5,0:33:39.54,0:33:45.91,Default,,0,0,0,,Lý do: Hiện tại có mười bảy cách khả thi để thay đổi ký ức của chúng ta.
Dialogue: 5,0:33:45.91,0:33:47.00,Default,,0,0,0,,Chết tiệt!
Dialogue: 5,0:33:47.57,0:33:51.92,Default,,0,0,0,,Thiếu tá! Sao cô không dùng chìa khóa thâm nhập Hồn của tôi để ngăn chặn chuyện này lại?!
Dialogue: 5,0:33:51.92,0:33:52.71,Default,,0,0,0,,Vô ích thôi.
Dialogue: 5,0:33:53.26,0:33:54.83,Default,,0,0,0,,Brinda sẽ không cho phép cô ấy làm điều đó.
Dialogue: 5,0:33:55.75,0:33:57.93,Default,,0,0,0,,Tôi sẽ trở thành bất kỳ ai.
Dialogue: 5,0:33:57.93,0:34:00.83,Default,,0,0,0,,Tôi đã nạp vào và xóa sạch rất nhiều linh Hồn.
Dialogue: 5,0:34:00.83,0:34:02.80,Default,,0,0,0,,Tôi cũng đã biến mất rồi...
Dialogue: 5,0:34:02.80,0:34:04.39,Default,,0,0,0,,Tôi là ai?
Dialogue: 5,0:34:04.39,0:34:07.60,Default,,0,0,0,,Tổ chức 501 cũng là một mục tiêu sao?
Dialogue: 5,0:34:07.60,0:34:09.75,Default,,0,0,0,,Chẳng phải rốt cuộc ngươi cũng chỉ là một nạn nhân thôi sao?!
Dialogue: 5,0:34:10.38,0:34:12.36,Default,,0,0,0,,Không còn cách nào khác.
Dialogue: 5,0:34:12.68,0:34:14.25,Default,,0,0,0,,Các người muốn gì?
Dialogue: 5,0:34:29.32,0:34:31.25,Default,,0,0,0,,Đừng biến mất, Emma.
Dialogue: 5,0:34:35.03,0:34:38.97,Default,,0,0,0,,Chúng ta hãy tiếp tục sống sau cái chết của chúng ta, cùng nhau.
Dialogue: 5,0:34:42.26,0:34:43.39,Default,,0,0,0,,Bọn chúng đến rồi.
Dialogue: 5,0:34:50.54,0:34:52.15,Default,,0,0,0,,{\i1}Màng chắn tấn công!{\i0}
Dialogue: 5,0:34:54.09,0:34:54.86,Default,,0,0,0,,Thiếu tá!
Dialogue: 5,0:34:56.05,0:34:56.82,Default,,0,0,0,,Đại tá!
Dialogue: 5,0:34:57.66,0:35:00.37,Default,,0,0,0,,Bọn chúng đã tấn công lẫn nhau bằng các màng chắn tấn công.
Dialogue: 5,0:35:00.37,0:35:02.60,Default,,0,0,0,,Một trong số chúng đã bị chuyển tiếp.
Dialogue: 5,0:35:02.60,0:35:05.12,Default,,0,0,0,,Không thể tin nổi nó lại mạnh hơn của chúng ta...
Dialogue: 5,0:35:05.12,0:35:07.24,Default,,0,0,0,,Cô vừa bị thâm nhập trong một khoảnh khắc.
Dialogue: 5,0:35:07.89,0:35:11.12,Default,,0,0,0,,Xóa toàn bộ các bộ chỉ huy chiến dịch liên quan khỏi Mạng lưới não điện tử.
Dialogue: 5,0:35:11.12,0:35:13.54,Default,,0,0,0,,Đuổi theo Brinda mau. Chẳng còn gì để làm ở đây nữa đâu.
Dialogue: 5,0:35:18.07,0:35:19.47,Default,,0,0,0,,Con chó hoang chết tiệt...
Dialogue: 5,0:35:28.10,0:35:30.12,Default,,0,0,0,,Có vẻ chúng ta đã thành công rồi.
Dialogue: 5,0:35:30.12,0:35:32.54,Default,,0,0,0,,Vật chủ và Starter vẫn đang hoạt động.
Dialogue: 5,0:35:48.71,0:35:50.87,Default,,0,0,0,,Chúng ta có thể nhìn thấy biển rồi, Emma.
Dialogue: 5,0:35:52.98,0:35:55.29,Default,,0,0,0,,Chuyện này thậm chí còn khiến cả tôi thấy rùng mình đấy, Thiếu tá.
Dialogue: 5,0:35:55.89,0:35:57.23,Default,,0,0,0,,Báo cáo đi.
Dialogue: 5,0:35:57.23,0:36:01.26,Default,,0,0,0,,Đại tá Hozumi thuộc Cục Tình báo Lục quân chính là người đã chiêu mộ Brinda Jr.
Dialogue: 5,0:36:01.70,0:36:05.36,Default,,0,0,0,,"Scarecrow" là một chiến dịch do Ban Điều tra cũ của họ dựng lên
Dialogue: 5,0:36:05.36,0:36:08.84,Default,,0,0,0,,trong thời kỳ họ đang phát triển các thiết bị sao chép Hồn (Ghost Dub).
Dialogue: 5,0:36:08.84,0:36:13.76,Default,,0,0,0,,Hozumi đã chen chân vào Ủy ban Thẩm tra Vũ khí Thế hệ Mới thông qua Bộ Ngoại giao.
Dialogue: 5,0:36:14.54,0:36:22.49,Default,,0,0,0,,Nhưng bà ta ở đó không lâu, và Kurutsu của Tổ chức 501 đã chiếm ghế của bà ta theo đề bạt của Thứ trưởng Kitahara.
Dialogue: 5,0:36:23.22,0:36:27.95,Default,,0,0,0,,Tổ chức 501 đã nắm thóp Hozumi qua trò chơi ghế âm nhạc của quân đội à, hử?
Dialogue: 5,0:36:27.95,0:36:39.67,Default,,0,0,0,,{\an8}Lý do: Chúng tôi có thể chứng minh rằng những ký ức giả ép buộc chúng ta thực hiện hành vi giết người, tự sát, và các tội ác khác.{\i0}
Dialogue: 5,0:36:37.77,0:36:39.67,Default,,0,0,0,,Bên nào đã chế tạo cỗ máy đó?
Dialogue: 5,0:36:40.05,0:36:41.30,Default,,0,0,0,,Chưa rõ.
Dialogue: 5,0:36:41.30,0:36:45.65,Default,,0,0,0,,Nhưng Cục Tình báo Lục quân đã quyết định phản đòn bằng cách can thiệp vào Ủy ban Thẩm tra.
Dialogue: 5,0:36:46.47,0:36:49.88,Default,,0,0,0,,Tôi đoán rằng ở đâu đó trong quá trình đó, hai hacker đã nhận biết được sự tồn tại của nhau.
Dialogue: 5,0:36:49.88,0:36:52.97,Default,,0,0,0,,Cuộc tấn công vào Harimadara chính là mối liên kết sao?
Dialogue: 5,0:36:52.97,0:36:55.84,Default,,0,0,0,,Không có bằng chứng nào cho thấy họ đã làm điều đó.
Dialogue: 5,0:36:55.84,0:37:01.61,Default,,0,0,0,,Nhưng Hozumi thuộc phe phát triển vũ khí ở nước ngoài, còn Harimadara là thành trì của phe nội địa.
Dialogue: 5,0:37:02.28,0:37:04.07,Default,,0,0,0,,Ai đã bắn chết con mồi của chúng ta?
Dialogue: 5,0:37:04.07,0:37:07.20,Default,,0,0,0,,Một sát thủ của tập đoàn nước Kuzan.
Dialogue: 5,0:37:07.20,0:37:10.54,Default,,0,0,0,,Hozumi đang đùa với lửa lớn thật rồi.
Dialogue: 5,0:37:10.54,0:37:16.61,Default,,0,0,0,,Bà ta đã dùng cái cớ ngành công nghiệp thời chiến để can thiệp vào công việc nội bộ của Kuzan trong thời gian đồn trú ở đó thời chiến tranh.
Dialogue: 5,0:37:16.61,0:37:21.13,Default,,0,0,0,,Nếu bà ta không thể khuất phục phe nội địa và mang lại lợi nhuận cho tập đoàn như đã hứa,
Dialogue: 5,0:37:21.13,0:37:23.72,Default,,0,0,0,,chúng sẽ trả đũa bà ta.
Dialogue: 5,0:37:23.72,0:37:25.45,Default,,0,0,0,,Kết quả phân tích Starter thế nào?
Dialogue: 5,0:37:25.45,0:37:30.56,Default,,0,0,0,,Không thể xác định được chốt kích hoạt, nhưng tôi có được câu trả lời từ thực tế là chúng ta không thể
Dialogue: 5,0:37:31.06,0:37:35.63,Default,,0,0,0,,tìm ra lộ trình lây nhiễm vào tòa nhà mặc dù Đội 9 đã chiếm quyền kiểm soát toàn bộ.
Dialogue: 5,0:37:35.63,0:37:38.36,Default,,0,0,0,,Đó là một mạng lưới C4ISR.
Dialogue: 5,0:37:38.36,0:37:40.52,Default,,0,0,0,,Một hệ thống liên lạc quân sự.
Dialogue: 5,0:37:40.52,0:37:42.69,Default,,0,0,0,,Mọi chuyện đang dần trở nên sáng tỏ rồi.
Dialogue: 5,0:37:42.69,0:37:49.24,Default,,0,0,0,,Chính Đại tá Hozumi là người đã kích hoạt Starter và truyền con virus qua đó để lây nhiễm đội bảo vệ phòng VIP.
Dialogue: 5,0:37:49.70,0:37:52.05,Default,,0,0,0,,Bà ta nhắm vào người phụ nữ mà tên bảo vệ đã bắn chết.
Dialogue: 5,0:37:52.05,0:37:55.21,Default,,0,0,0,,Thứ trưởng Cao cấp Kitahara, người thuộc phe nội địa.
Dialogue: 5,0:37:55.58,0:37:58.52,Default,,0,0,0,,Vụ thảm sát đó chỉ là bức bình phong cho một vụ ám sát thôi sao?!
Dialogue: 5,0:37:58.52,0:38:00.42,Default,,0,0,0,,Đoán chừng bà ta sinh ra là kẻ nghiện chiến tranh rồi.
Dialogue: 5,0:38:00.78,0:38:03.20,Default,,0,0,0,,Sao lại bắn tỉa Cô Bé Thiếc?
Dialogue: 5,0:38:03.20,0:38:03.88,Default,,0,0,0,,Đó là một đòn nghi binh.
Dialogue: 5,0:38:04.30,0:38:08.95,Default,,0,0,0,,Bà ta chắc chắn muốn loại bỏ chúng ta và đưa Cô Bé Thiếc an toàn đến 501.
Dialogue: 5,0:38:09.58,0:38:12.61,Default,,0,0,0,,Vậy chuyến ghé thăm Đội 9 của bà ta cũng chỉ là bình phong thôi sao?
Dialogue: 5,0:38:12.61,0:38:16.60,Default,,0,0,0,,Bà ta nhượng bộ dễ dàng như vậy vì ngay từ đầu bà ta đã nhắm vào Tổ chức 501 rồi.
Dialogue: 5,0:38:16.98,0:38:21.57,Default,,0,0,0,,Để bà ta có thể gài bẫy người chống cơ thể hóa Tsuda Emma làm kẻ cầm đầu vụ thảm sát.
Dialogue: 5,0:38:21.57,0:38:25.24,Default,,0,0,0,,Harimadara, Thứ trưởng, và 501...
Dialogue: 5,0:38:25.24,0:38:28.17,Default,,0,0,0,,Bà ta có một kế hoạch một mũi tên trúng ba đích để triệt hạ tất cả!
Dialogue: 5,0:38:28.17,0:38:30.43,Default,,0,0,0,,Thế còn linh Hồn của cô bé bị sao chép thì sao?
Dialogue: 5,0:38:30.43,0:38:35.40,Default,,0,0,0,,Nếu cô bé thực sự có ý chí riêng, tại sao cô bé lại cố tình để Hozumi lợi dụng mình?
Dialogue: 5,0:38:35.40,0:38:40.52,Default,,0,0,0,,Chỉ nhìn từ hoàn cảnh, con bù nhìn rơm chính là kẻ mà cô hằng săn đuổi đấy.
Dialogue: 5,0:38:40.52,0:38:42.88,Default,,0,0,0,,Chưa chắc hắn đã là người viết ra con virus.
Dialogue: 5,0:38:42.88,0:38:45.01,Default,,0,0,0,,Hozumi bảo có một tay môi giới.
Dialogue: 5,0:38:45.43,0:38:48.96,Default,,0,0,0,,Nếu bà ta nói thật, thì ngoài kia có kẻ đã chế tạo và rao bán nó.
Dialogue: 5,0:38:48.96,0:38:50.47,Default,,0,0,0,,Đó mới là kẻ tôi đang săn lùng.
Dialogue: 5,0:38:50.47,0:38:52.36,Default,,0,0,0,,Tất cả chuyện này chỉ là suy đoán thôi.
Dialogue: 5,0:38:52.36,0:38:56.82,Default,,0,0,0,,Hiện tại, chỉ có một cách duy nhất để chúng ta có được bằng chứng.
Dialogue: 5,0:38:56.82,0:38:58.90,Default,,0,0,0,,Tôi đoán anh đã có vị trí của Togusa rồi.
Dialogue: 5,0:38:58.90,0:39:00.32,Default,,0,0,0,,Chúng ta sẽ hội quân trên đường đi.
Dialogue: 5,0:39:00.32,0:39:04.19,Default,,0,0,0,,Chúng ta sẽ tóm gọn cả hai linh Hồn—của con bù nhìn rơm, và của cô bé.
Dialogue: 5,0:39:05.19,0:39:06.93,Default,,0,0,0,,Togusa mới là vấn đề.
Dialogue: 5,0:39:06.93,0:39:10.70,Default,,0,0,0,,Bắn nát đầu một đồng đội đã có gia đình không phải là việc của tôi.
Dialogue: 5,0:39:11.21,0:39:14.33,Default,,0,0,0,,Chúng ta biết chắc chắn sự lây nhiễm này cấy vào những ký ức giả, đúng không?
Dialogue: 5,0:39:14.33,0:39:17.37,Default,,0,0,0,,Anh đã thấy cậu ấy nói chuyện với người cha quá cố của mình rồi đấy.
Dialogue: 5,0:39:18.06,0:39:19.96,Default,,0,0,0,,Chắc chắn phải có một dạng thức chung.
Dialogue: 5,0:39:19.96,0:39:24.47,Default,,0,0,0,,Tôi sẽ để mình bị nhiễm, nên anh hãy nhận diện nó và nâng cấp vắc-xin tự chế của mình lên.
Dialogue: 5,0:39:24.47,0:39:26.42,Default,,0,0,0,,Cô muốn tự làm gương phản chiếu bộ não của chính mình sao?
Dialogue: 5,0:39:26.42,0:39:29.34,Default,,0,0,0,,Trong tình huống xấu nhất, hãy bắn nát đầu tôi.
Dialogue: 5,0:39:29.34,0:39:31.53,Default,,0,0,0,,Vậy đó là nhiệm vụ của tôi đấy à?
Dialogue: 5,0:39:31.53,0:39:34.34,Default,,0,0,0,,Cô luôn có thể để tôi làm đội trưởng mà, cô biết đấy.
Dialogue: 5,0:39:35.18,0:39:35.81,Default,,0,0,0,,Một trạm kiểm soát sao?
Dialogue: 5,0:39:38.22,0:39:40.90,Default,,0,0,0,,Các người đang nằm trong danh sách truy nã như những nghi phạm khủng bố!
Dialogue: 5,0:39:40.90,0:39:42.58,Default,,0,0,0,,Chết tiệt, là Đội 9!
Dialogue: 5,0:39:42.58,0:39:44.70,Default,,0,0,0,,Lão khỉ đó từng thuộc Cục Tình báo Lục quân.
Dialogue: 5,0:39:44.70,0:39:47.23,Default,,0,0,0,,Lão đã bắt tay thỏa thuận với Hozumi, và lão đang gài bẫy chúng ta!
Dialogue: 5,0:39:47.70,0:39:49.76,Default,,0,0,0,,Có thể bà ta chỉ muốn chúng ta nghĩ như vậy thôi.
Dialogue: 5,0:39:49.76,0:39:52.20,Default,,0,0,0,,Tôi sẽ gửi tin tình báo của chúng ta cho Đội 9.
Dialogue: 5,0:39:52.62,0:39:55.04,Default,,0,0,0,,Sau tất cả những chuyện này, cô vẫn còn tin tưởng lão ta sao?!
Dialogue: 5,0:39:55.04,0:39:56.05,Default,,0,0,0,,Không.
Dialogue: 5,0:39:56.05,0:39:56.87,Default,,0,0,0,,Vậy thì tại sao?!
Dialogue: 5,0:39:58.02,0:40:00.75,Default,,0,0,0,,Đó là điều mà linh Hồn tôi đang thì thầm bảo tôi phải làm.
Dialogue: 5,0:40:17.60,0:40:18.68,Default,,0,0,0,,Đợi đã!
Dialogue: 5,0:40:18.68,0:40:20.06,Default,,0,0,0,,Cậu đang đi đâu thế?!
Dialogue: 5,0:40:21.61,0:40:23.02,Default,,0,0,0,,Dừng lại!
Dialogue: 5,0:40:24.30,0:40:26.73,Default,,0,0,0,,Chúng ta đã hứa sẽ cùng nhau đi thật xa mà.
Dialogue: 5,0:40:33.86,0:40:34.96,Default,,0,0,0,,Tạm biệt.
Dialogue: 5,0:40:56.61,0:40:58.26,Default,,0,0,0,,Tôi đã giải phóng gói dữ liệu rồi!
Dialogue: 5,0:41:00.50,0:41:01.62,Default,,0,0,0,,Tôi đi trước đây.
Dialogue: 5,0:41:02.69,0:41:04.76,Default,,0,0,0,,Tôi đã bảo anh phải bắn nếu mọi chuyện tồi tệ đi cơ mà!
Dialogue: 5,0:41:04.76,0:41:06.15,Default,,0,0,0,,Mang theo khẩu súng chết tiệt đi chứ...
Dialogue: 5,0:41:08.80,0:41:09.79,Default,,0,0,0,,Thiếu tá...
Dialogue: 5,0:41:13.59,0:41:15.32,Default,,0,0,0,,Cô bé bị nát vụn rồi!
Dialogue: 5,0:41:15.32,0:41:17.53,Default,,0,0,0,,Nếu cô bé là phiên bản vi mạch thần kinh, cô bé vẫn còn sống.
Dialogue: 5,0:41:21.01,0:41:23.16,Default,,0,0,0,,Chúng ta sẽ tiếp tục sống.
Dialogue: 5,0:41:32.56,0:41:35.68,Default,,0,0,0,,Đó là sao chép Hồn, chứ không phải chuyển giao sao?!
Dialogue: 5,0:41:45.60,0:41:47.40,Default,,0,0,0,,Đó là cỗ máy nguyên mẫu thử nghiệm của Harimadara!
Dialogue: 5,0:41:50.82,0:41:52.10,Default,,0,0,0,,Thiếu tá!
Dialogue: 5,0:41:52.10,0:41:54.76,Default,,0,0,0,,Hai linh Hồn đã được sao chép vào trong thứ đó rồi.
Dialogue: 5,0:41:54.76,0:41:57.75,Default,,0,0,0,,Chúng ta sẽ chặn đứng nó! Logicoma, dồn toàn lực cho tôi!
Dialogue: 5,0:41:57.75,0:41:59.28,Default,,0,0,0,,Rõ, thưa sếp!
Dialogue: 5,0:42:02.20,0:42:05.66,Default,,0,0,0,,Chúng từ bỏ mạng sống của chính mình để đi đâu cơ chứ?
Dialogue: 5,0:42:07.29,0:42:08.13,Default,,0,0,0,,Đại dương.
Dialogue: 5,0:42:08.68,0:42:09.33,Default,,0,0,0,,Hả?
Dialogue: 5,0:42:09.81,0:42:11.53,Default,,0,0,0,,Chúng sẽ không đi đâu được cả!
Dialogue: 5,0:42:11.53,0:42:12.84,Default,,0,0,0,,Mọi chuyện chấm dứt tại đây!
Dialogue: 5,0:42:58.72,0:43:02.16,Default,,0,0,0,,Vũ khí thế hệ mới hay không thì bộ não của nó cũng chỉ là tay mơ thôi.
Dialogue: 5,0:43:02.16,0:43:04.18,Default,,0,0,0,,Ngắm vào mắt và chân của nó, thế là nắm chắc phần thắng.
Dialogue: 5,0:43:18.03,0:43:19.24,Default,,0,0,0,,Thật đấy à?!
Dialogue: 5,0:44:08.93,0:44:10.08,Default,,0,0,0,,Bắt được mày rồi nhé!
Dialogue: 5,0:44:21.68,0:44:22.97,Default,,0,0,0,,Cái gì thế kia?
Dialogue: 5,0:44:22.97,0:44:26.14,Default,,0,0,0,,Là Cục Tình báo Lục quân! Lũ khốn đó vừa yêu cầu pháo kích!
Dialogue: 5,0:44:33.34,0:44:35.55,Default,,0,0,0,,Ngươi đã cắt đứt hệ thống cảm giác của mình rồi sao?!
Dialogue: 5,0:44:36.26,0:44:37.02,Default,,0,0,0,,Chết tiệt!
Dialogue: 5,0:44:46.45,0:44:48.72,Default,,0,0,0,,Ngươi đã vứt bỏ các vùng cường độ...
Dialogue: 5,0:44:48.72,0:44:53.51,Default,,0,0,0,,Hệ thống nhận diện, các vùng ký ức,\NMạng lưới duy trì cấu trúc của ngươi...
Dialogue: 5,0:45:14.54,0:45:17.25,Default,,0,0,0,,Ngươi thậm chí đã vứt bỏ cả linh Hồn của chính mình!
Dialogue: 5,0:45:17.25,0:45:20.36,Default,,0,0,0,,Ngươi muốn một cuộc sống mà ngươi đã tước đoạt đi toàn bộ ý nghĩa của nó sao?!
Dialogue: 5,0:46:35.68,0:46:36.58,Default,,0,0,0,,Tạm biệt.
Dialogue: 5,0:47:05.42,0:47:07.12,Default,,0,0,0,,Kết thúc rồi.
Dialogue: 5,0:47:07.12,0:47:10.39,Default,,0,0,0,,Trở về căn cứ thôi. Chúng ta sẽ đến Kuzan, bằng đường qua Benares.
Dialogue: 5,0:47:13.34,0:47:16.72,Default,,0,0,0,,Nền kinh tế không gian mạng của thế giới mới chỉ bắt đầu thôi.
Dialogue: 5,0:47:16.72,0:47:19.06,Default,,0,0,0,,Tôi sẽ trả bất cứ giá nào để hòa giải với tập đoàn—
Dialogue: 5,0:47:32.07,0:47:33.45,Default,,0,0,0,,Quỳ xuống, giơ hai tay lên trời!
Dialogue: 5,0:47:35.34,0:47:37.27,Default,,0,0,0,,Ồ, lệnh truy nã kìa.
Dialogue: 5,0:47:37.27,0:47:38.41,Default,,0,0,0,,Tôi đã bảo rồi mà.
Dialogue: 5,0:47:46.49,0:47:48.77,Default,,0,0,0,,Cô đúng là y hệt như lão trưởng ban Đội 9 đó vậy.
Dialogue: 5,0:47:48.77,0:47:52.48,Default,,0,0,0,,Chẳng bao giờ thấy vui vẻ trừ phi đi đào bới những thứ đã chết và được chôn cất.
Dialogue: 5,0:47:53.61,0:47:56.07,Default,,0,0,0,,Đó là điều mà cô đã trốn chạy mà không dám làm.
Dialogue: 5,0:47:58.35,0:48:01.52,Default,,0,0,0,,Sẽ chẳng có gì thay đổi đâu, Kusanagi.
Dialogue: 5,0:48:02.58,0:48:05.00,Default,,0,0,0,,Chúng tôi là một đơn vị tấn công độc lập.
Dialogue: 5,0:48:05.81,0:48:11.49,Default,,0,0,0,,Chúng tôi đứng độc lập khỏi hệ thống, và chúng tôi sở hữu những nhân cách thực sự riêng biệt không bị đóng gói.
Dialogue: 5,0:48:12.21,0:48:15.40,Default,,0,0,0,,Khi chúng tôi chính thức được phê duyệt là ưu tiên cao nhất,
Dialogue: 5,0:48:15.40,0:48:19.45,Default,,0,0,0,,chúng tôi sẽ nhổ tận gốc tất cả những kẻ khốn nạn âm mưu mờ ám vì sợ bê bối.
Dialogue: 5,0:48:21.96,0:48:24.49,Default,,0,0,0,,Và cô tính cả tôi vào số đó sao?
Dialogue: 5,0:48:26.38,0:48:29.31,Default,,0,0,0,,Tôi chưa bao giờ đổi kênh của cô cả.
Dialogue: 5,0:48:29.31,0:48:32.69,Default,,0,0,0,,Hãy liên lạc với tôi bất cứ khi nào cô muốn trở về nhà.
Dialogue: 5,0:48:45.54,0:48:46.86,Default,,0,0,0,,Cô có thể tự do đi rồi.
Dialogue: 5,0:48:46.86,0:48:49.94,Default,,0,0,0,,Chúng tôi đã hủy bỏ lệnh truy nã mà Đại tá Hozumi đưa ra.
Dialogue: 5,0:48:50.50,0:48:54.53,Default,,0,0,0,,Thứ trưởng Quốc phòng Kitahara muốn gửi lời cảm ơn cô.
Dialogue: 5,0:48:54.53,0:48:56.41,Default,,0,0,0,,Đó là một trò đùa đấy à?
Dialogue: 5,0:48:57.03,0:48:58.62,Default,,0,0,0,,Một trò đùa chính trị.
Dialogue: 5,0:48:59.26,0:49:02.64,Default,,0,0,0,,Đội 9 vừa lục soát tài sản của Đại tá Hozumi
Dialogue: 5,0:49:02.64,0:49:07.19,Default,,0,0,0,,và tịch thu một thiết bị sao chép Hồn cùng bản phác thảo chiến dịch Scarecrow.
Dialogue: 5,0:49:07.19,0:49:09.46,Default,,0,0,0,,Dù vậy họ không thể bắt giữ bà ta.
Dialogue: 5,0:49:09.46,0:49:11.84,Default,,0,0,0,,Không—nhưng sau đó bà ta đã tự thú.
Dialogue: 5,0:49:16.11,0:49:20.23,Default,,0,0,0,,Trực thăng của bà ta bị bắn hạ bằng vũ khí của Kuzan.
Dialogue: 5,0:49:21.12,0:49:26.79,Default,,0,0,0,,Bà ta sợ sự trả thù của tập đoàn đến mức phải xin được bảo vệ và thỏa thuận nhận tội.
Dialogue: 5,0:49:26.79,0:49:28.76,Default,,0,0,0,,Vậy là bà ta sẽ được thoát tội trắng án sao.
Dialogue: 5,0:49:28.76,0:49:30.39,Default,,0,0,0,,Tôi sẽ bảo đảm bà ta không thoát được đâu.
Dialogue: 5,0:49:30.39,0:49:35.28,Default,,0,0,0,,NPO mà bà ta hợp tác là một bình phong cho các hoạt động làm ăn mờ ám về não điện tử.
Dialogue: 5,0:49:35.28,0:49:40.37,Default,,0,0,0,,Không chỉ có vậy, chúng tôi đã phát hiện thấy Starter trong não điện tử của bà ta, đúng như tin tình báo của cô.
Dialogue: 5,0:49:41.14,0:49:44.68,Default,,0,0,0,,Bà ta đã khiến rất nhiều người bị thương và thiệt mạng, và tôi sẽ bắt bà ta phải trả giá—
Dialogue: 5,0:49:44.68,0:49:47.43,Default,,0,0,0,,ngay cả khi hiện tại tôi chưa thể đưa bà ta ra trước tòa án.
Dialogue: 5,0:49:48.38,0:49:50.72,Default,,0,0,0,,Bà ta lấy con virus từ đâu?
Dialogue: 5,0:49:50.72,0:49:53.42,Default,,0,0,0,,Thông qua một tay môi giới, bà ta khai như vậy.
Dialogue: 5,0:49:53.42,0:49:56.24,Default,,0,0,0,,Bà ta khẳng định mình không biết gì về tác giả của nó cả.
Dialogue: 5,0:49:56.24,0:49:57.09,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 5,0:49:58.37,0:50:01.06,Default,,0,0,0,,Có thực sự là tập đoàn đã cố ám sát Hozumi không?
Dialogue: 5,0:50:01.86,0:50:05.79,Default,,0,0,0,,Ngay cả khi đó là một kẻ muốn ngăn chặn chúng ta điều tra bà ta,
Dialogue: 5,0:50:05.79,0:50:08.02,Default,,0,0,0,,tôi chắc chắn mọi dấu vết về chúng đều đã biến mất từ lâu rồi.
Dialogue: 5,0:50:21.29,0:50:22.41,Default,,0,0,0,,Thiếu tá.
Dialogue: 5,0:50:22.73,0:50:25.08,Default,,0,0,0,,Tất cả các cậu đều đến sao?
Dialogue: 5,0:50:25.08,0:50:27.87,Default,,0,0,0,,Tôi không biết mình lại có những cấp dưới đáng khen ngợi đến thế đấy.
Dialogue: 5,0:50:28.17,0:50:31.13,Default,,0,0,0,,Cô có thể đã bị tấn công trong khi đang bị tạm giam mà.
Dialogue: 5,0:50:31.79,0:50:34.55,Default,,0,0,0,,Bọn tôi đã để mắt tới tất cả những con mèo khả nghi đi ngang qua đấy.
Dialogue: 5,0:50:36.00,0:50:37.52,Default,,0,0,0,,Còn một điều nữa.
Dialogue: 5,0:50:37.52,0:50:42.27,Default,,0,0,0,,Tôi đã báo cáo với Bộ trưởng Nội vụ rằng tiểu đội của cô đã có công ngăn chặn con virus.
Dialogue: 5,0:50:43.10,0:50:48.02,Default,,0,0,0,,Hãy dùng bộ não điện tử đáng tự hào của cô để đọc báo cáo N2077 của Ủy ban An toàn Công cộng đi.
Dialogue: 5,0:50:48.54,0:50:51.99,Default,,0,0,0,,Kể từ ngày mai, cô sẽ nhận được thẩm quyền đặc biệt.
Dialogue: 5,0:50:51.99,0:50:53.98,Default,,0,0,0,,Mà không chịu sự giám sát chính thức.
Dialogue: 5,0:50:54.70,0:50:56.97,Default,,0,0,0,,Vụ án này vẫn chưa kết thúc đâu.
Dialogue: 5,0:50:56.97,0:51:01.00,Default,,0,0,0,,Hãy điều tra con virus hack cấp cao này và bất kỳ tổ chức nào có liên quan,
Dialogue: 5,0:51:01.74,0:51:04.38,Default,,0,0,0,,và hãy chuẩn bị sẵn sàng để tham dự nhiều đám tang trên con đường đó đi.
Dialogue: 5,0:51:04.38,0:51:06.45,Default,,0,0,0,,Tôi đã bắn Thied.
Dialogue: 5,0:51:07.18,0:51:09.71,Default,,0,0,0,,Chắc hẳn ông đã linh cảm thấy một nhân vật tai to mặt lớn của tình báo đứng sau vụ này,
Dialogue: 5,0:51:10.03,0:51:13.05,Default,,0,0,0,,nghĩa là ông sẽ muốn có lợi thế tình báo bằng mọi giá.
Dialogue: 5,0:51:13.05,0:51:15.21,Default,,0,0,0,,Vậy tại sao ông lại không ngăn tôi lại?!
Dialogue: 5,0:51:16.15,0:51:19.46,Default,,0,0,0,,Bởi vì tôi không có chiếc chìa khóa thâm nhập Hồn của cô.
Dialogue: 5,0:51:22.56,0:51:25.81,Default,,0,0,0,,Sẽ không bao giờ có bất kỳ tổ chức nào có được nó cả.
Dialogue: 5,0:51:26.57,0:51:30.02,Default,,0,0,0,,Tôi đã hứa điều đó với người chỉ huy quá cố của cô.
Dialogue: 5,0:51:54.68,0:52:00.42,Default,,0,0,0,,Chốt lại, tất cả những gì chúng ta tìm ra là ngoài kia có kẻ
Dialogue: 5,0:52:00.42,0:52:04.35,Default,,0,0,0,,đã lợi dụng một cặp hacker chống cơ thể hóa và một ả đàn bà công ty nước đáng thương.
Dialogue: 5,0:52:05.06,0:52:08.16,Default,,0,0,0,,Chúng ta có thể đang tìm kiếm một tội ác đáng để hy sinh mạng sống,
Dialogue: 5,0:52:08.16,0:52:13.72,Default,,0,0,0,,nhưng tất cả những gì chúng ta có chỉ là những kẻ trục lợi chiến tranh hám tiền và một gã đàn ông cùng cô bé bị ám ảnh bởi việc vứt bỏ mọi thứ.
Dialogue: 5,0:52:13.72,0:52:15.08,Default,,0,0,0,,Hiện tại là như vậy.
Dialogue: 5,0:52:16.83,0:52:21.33,Default,,0,0,0,,Ai mới là kẻ có ý chí tự chủ, gã đàn ông hay cô bé?
Dialogue: 5,0:52:21.33,0:52:24.62,Default,,0,0,0,,Họ có thực sự có ý chí thực sự không?
Dialogue: 5,0:52:26.21,0:52:29.36,Default,,0,0,0,,Ít nhất là khi họ chặn đứng sự thâm nhập của tôi.
Dialogue: 5,0:52:30.19,0:52:36.05,Default,,0,0,0,,Nhưng họ đã chạy trốn mà không có nơi nào để đi,\Nrồi buộc phải chuyển giao vào cỗ vũ khí đó.
Dialogue: 5,0:52:36.59,0:52:41.62,Default,,0,0,0,,Bộ não điện tử của cỗ xe chiến thuật đó có một hệ thống đầu ra khổng lồ.
Dialogue: 5,0:52:41.62,0:52:42.35,Default,,0,0,0,,Hửm?
Dialogue: 5,0:52:43.06,0:52:50.31,Default,,0,0,0,,Sẽ ra sao nếu lý do họ vứt bỏ những thứ làm nên chính mình là để truyền xuất thứ cuối cùng còn sót lại vào Mạng lưới?
Dialogue: 5,0:52:50.71,0:52:53.11,Default,,0,0,0,,Anh nghĩ đó là nơi họ hướng tới sao?
Dialogue: 5,0:52:53.11,0:52:57.84,Default,,0,0,0,,Rót những mảnh vụn cuối cùng của linh Hồn vào Mạng lưới... Điều đó thực sự khả thi sao?
Dialogue: 5,0:52:59.24,0:53:02.46,Default,,0,0,0,,Điều đó đã từng được nghiên cứu, nhưng không thể chứng minh được.
Dialogue: 5,0:53:05.29,0:53:10.06,Default,,0,0,0,,Nhưng ngay khoảnh khắc linh Hồn của họ mất đi,\Ntôi có cảm giác như họ đã hòa làm một.
Dialogue: 5,0:53:10.06,0:53:11.91,Default,,0,0,0,,Rằng hai sinh mệnh đã hợp nhất thành một...
Dialogue: 5,0:53:12.88,0:53:14.56,Default,,0,0,0,,Điều đó chẳng giống cô chút nào.
Dialogue: 5,0:53:14.56,0:53:18.16,Default,,0,0,0,,Linh hồn là thứ độc lập nhất trên thế giới này.
Dialogue: 5,0:53:18.16,0:53:22.46,Default,,0,0,0,,Ngay cả những kẻ đang bị kiểm soát, về mặt căn bản, vĩnh viễn đều là những cá thể độc lập (standalone).
Dialogue: 5,0:53:22.46,0:53:24.19,Default,,0,0,0,,Giống như tiểu đội của chúng ta vậy, nhỉ?
Dialogue: 5,0:53:27.99,0:53:29.35,Default,,0,0,0,,Phải.
Dialogue: 5,0:53:29.82,0:53:32.50,Default,,0,0,0,,Sao nào? Phao bơi đã sẵn sàng cả rồi.
Dialogue: 5,0:53:32.50,0:53:34.72,Default,,0,0,0,,Tôi mua luôn một bộ hai cái đấy.
Dialogue: 5,0:53:34.72,0:53:37.56,Default,,0,0,0,,Ngay cả kẻ có hộp sọ bằng titan cũng không sợ bị chìm đâu.
Dialogue: 5,0:53:37.56,0:53:40.64,Default,,0,0,0,,Anh nghiêm túc muốn đi bơi biển vào giữa mùa đông đấy à?
Dialogue: 5,0:53:40.64,0:53:43.32,Default,,0,0,0,,Phải rũ bỏ mớ ký ức suýt chết đuối đó chứ.
Dialogue: 5,0:53:43.82,0:53:46.68,Default,,0,0,0,,Thêm nữa, đâu phải lúc nào tôi cũng có cơ hội được ngắm cô mặc áo tắm.
Dialogue: 5,0:53:46.68,0:53:48.17,Default,,0,0,0,,Đó mới là mục đích thực sự của anh hả?
Dialogue: 5,0:53:48.17,0:53:48.91,Default,,0,0,0,,Hả?
Dialogue: 5,0:53:48.91,0:53:49.96,Default,,0,0,0,,Không thể tin nổi.
Dialogue: 5,0:53:49.96,0:53:53.25,Default,,0,0,0,,Không, không! Tôi làm tất cả là vì cô mà!
Dialogue: 5,0:53:55.80,0:53:57.61,Default,,0,0,0,,Để lần sau đi nhé.
Dialogue: 5,0:53:57.61,0:53:59.93,Default,,0,0,0,,Không, chỉ là—cô hiểu lầm hoàn toàn rồi!
Dialogue: 0,0:54:31.44,0:54:38.23,ED_Romaji,,0,0,0,,{\fad(300,300)\blur0.5}yureru kanashimi soshite nikushimi
Dialogue: 0,0:54:31.44,0:54:38.23,ED_English,,0,0,0,,{\fad(300,300)\blur0.5}Nỗi buồn mơ hồ cùng niềm căm hận trong ta
