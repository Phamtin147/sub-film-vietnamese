Dialogue: 0,0:38:24.11,0:38:27.07,Sharpie,,0,0,0,,{\pos(616,214.667)\blur0.6\frz5.689\c&H4D429A&}"Đặc vụ" \h\h\h\h\h\h\h{\frz359.4}"Trung tá vô tội"
Dialogue: 3,0:38:24.74,0:38:26.29,Default,,0,0,0,,Đúng là một đống hỗn độn!
Dialogue: 3,0:38:45.93,0:38:47.77,Default,,0,0,0,,{\i1}Hồ sơ không hề bị can thiệp.{\i0}
Dialogue: 3,0:38:48.64,0:38:52.83,Default,,0,0,0,,{\i1}Bọn họ chỉ chôn vùi sự thật dưới một lời dối trá.{\i0}
Dialogue: 3,0:39:27.26,0:39:28.42,Default,,0,0,0,,Tôi đã tìm thấy nó rồi...
Dialogue: 3,0:39:30.10,0:39:32.30,Default,,0,0,0,,Hiện thực của chính mình.
Dialogue: 3,0:39:41.40,0:39:42.15,Default,,0,0,0,,Lái xe đi.
Dialogue: 3,0:39:53.19,0:39:56.77,Default,,0,0,0,,Trung tá đã tìm đến ông để tố giác.
Dialogue: 3,0:39:56.77,0:40:00.47,Default,,0,0,0,,Có phải vậy không, Thứ trưởng Bộ Quốc phòng Sadamoto?
Dialogue: 3,0:40:00.47,0:40:01.54,Default,,0,0,0,,Phải.
Dialogue: 3,0:40:01.54,0:40:03.81,Default,,0,0,0,,Nhưng ông lại ra lệnh che đậy mọi chuyện.
Dialogue: 3,0:40:03.81,0:40:06.05,Default,,0,0,0,,Bởi vì chuyện đó không thể nào công khai ra ngoài được!
Dialogue: 3,0:40:06.05,0:40:08.72,Default,,0,0,0,,Chúng ta đã phớt lờ các hiệp ước và bán vũ khí cho các nước Thế giới thứ Ba trong chiến tranh
Dialogue: 3,0:40:08.72,0:40:12.08,Default,,0,0,0,,để giảm bớt gánh nặng tài chính đè nặng lên đất nước.
Dialogue: 3,0:40:12.08,0:40:14.43,Default,,0,0,0,,Đó chính là hành vi buôn lậu vũ khí cấp chính phủ!
Dialogue: 3,0:40:14.43,0:40:16.98,Default,,0,0,0,,Harimadara đứng ở trung tâm của đường dây đó,
Dialogue: 3,0:40:15.31,0:40:17.69,Default,,0,0,0,,{\an8}Thứ trưởng, có chuyện gì thế?
Dialogue: 3,0:40:16.98,0:40:20.39,Default,,0,0,0,,và với tư cách là quan chức an ninh của họ,\NTrung tá Mamuro đã phát hiện ra vụ buôn bán phi pháp này.
Dialogue: 3,0:40:18.50,0:40:19.42,Default,,0,0,0,,{\an8}Thứ trưởng!
Dialogue: 3,0:40:20.39,0:40:21.49,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 3,0:40:21.49,0:40:26.19,Default,,0,0,0,,Cô có biết mảng kinh doanh tên lửa đã giúp ích cho ngân sách quốc gia nhiều đến mức nào không?!
Dialogue: 3,0:40:21.66,0:40:22.82,Default,,0,0,0,,{\an8}Ngài ấy đang gặp nguy hiểm!
Dialogue: 3,0:40:26.19,0:40:28.77,Default,,0,0,0,,Trung tá đã biết về vụ che đậy của ông và tiến hành điều tra.
Dialogue: 3,0:40:28.77,0:40:32.74,Default,,0,0,0,,Cô gái bán hoa mà ông hay lui tới. Người lính Biệt kích hộ tống ông.
Dialogue: 3,0:40:32.74,0:40:36.75,Default,,0,0,0,,Khi nắm được thông tin từ họ,\Nông ấy đã quyết định sẽ vạch trần ông ra ánh sáng.
Dialogue: 3,0:40:36.75,0:40:40.48,Default,,0,0,0,,Nên ông đã ra lệnh cho Đại úy Kanzaki sát hại ông ấy.
Dialogue: 3,0:40:40.48,0:40:43.01,Default,,0,0,0,,Tôi chỉ ra lệnh cho hắn giải quyết tình hình thôi!
Dialogue: 3,0:40:43.01,0:40:47.83,Default,,0,0,0,,Đúng là có vài kẻ phải chịu vạ lây,\Nnhưng tôi không biết ai đã giết Mamuro cả.
Dialogue: 3,0:40:47.83,0:40:50.64,Default,,0,0,0,,Chết tiệt, có khi ông ta bị cướp giết thật cũng nên.
Dialogue: 3,0:40:50.64,0:40:52.13,Default,,0,0,0,,Ông dám khẳng định ngay cả ông cũng không biết sao?
Dialogue: 3,0:40:52.39,0:40:54.19,Default,,0,0,0,,Không biết, và tôi cũng chẳng muốn biết!
Dialogue: 3,0:40:54.19,0:40:57.86,Default,,0,0,0,,Dù sao thì đường dây buôn vũ khí đó cũng sẽ bị thanh trừng trong đợt tái cơ cấu,
Dialogue: 3,0:40:57.86,0:41:01.07,Default,,0,0,0,,và chúng tôi đang bàn thảo về vũ khí thế hệ mới để thay thế tên lửa.
Dialogue: 3,0:41:01.07,0:41:06.24,Default,,0,0,0,,Nhưng mớ hỗn độn này sẽ phá hỏng công việc mà Harimadara đã sắp xếp sẵn cho tôi sau khi rời nhiệm sở!
Dialogue: 3,0:41:06.24,0:41:09.87,Default,,0,0,0,,Ông nói nhiều thật đấy. Muốn thú tội sao?
Dialogue: 3,0:41:09.87,0:41:14.86,Default,,0,0,0,,Có thể là vậy. Dù sao thì, cô sẽ không bao giờ có cơ hội nói cho ai biết đâu!
Dialogue: 3,0:41:21.47,0:41:23.00,Default,,0,0,0,,Dừng lại!
Dialogue: 3,0:41:25.23,0:41:26.29,Default,,0,0,0,,Ai đó cứu tôi với!
Dialogue: 3,0:41:38.46,0:41:40.61,Default,,0,0,0,,Đáng lẽ phải bắn nát đầu hắn ra mới phải.
Dialogue: 3,0:41:40.61,0:41:45.14,Default,,0,0,0,,Chẳng phải việc trở thành một thứ gì đó hơn cả một cỗ máy giết người\Nlà mục đích của việc giải ngũ sao?
Dialogue: 3,0:41:45.40,0:41:47.94,Default,,0,0,0,,Rốt cuộc thì, tôi cũng chẳng có nơi nào để đi.
Dialogue: 3,0:41:48.90,0:41:52.46,Default,,0,0,0,,Bọn chúng truy vết chúng ta qua đường điều khiển từ xa rồi. Chúng đang tới.
Dialogue: 3,0:41:53.09,0:41:55.94,Default,,0,0,0,,Đi trước đi. Lũ đó là của tôi.
Dialogue: 3,0:41:56.30,0:41:57.98,Default,,0,0,0,,Có tận hai tên đấy.
Dialogue: 3,0:41:57.98,0:42:01.22,Default,,0,0,0,,Càng tốt. Để xem ai mới là sát thủ giỏi hơn.
Dialogue: 3,0:42:03.80,0:42:05.36,Default,,0,0,0,,Bảo trọng.
Dialogue: 3,0:42:05.36,0:42:06.08,Default,,0,0,0,,Anh cũng vậy.
Dialogue: 3,0:42:07.74,0:42:13.70,Default,,0,0,0,,Tôi ghét phải nói ra điều này, nhưng bọn họ không phải là những kẻ duy nhất hưởng lợi từ cái chết của ông ấy đâu.
Dialogue: 3,0:42:14.36,0:42:16.26,Default,,0,0,0,,Vâng. Cảm ơn anh.
Dialogue: 3,0:43:21.63,0:43:23.58,Default,,0,0,0,,Chính các người mới là kẻ đã giết Trung tá!
Dialogue: 3,0:43:55.89,0:44:01.59,Default,,0,0,0,,Tôi đã cảnh cáo nếu cô bước quá giới hạn,\Nchính tay tôi sẽ trừ khử cô rồi.
Dialogue: 3,0:45:39.90,0:45:41.38,Default,,0,0,0,,Đến đây là đủ rồi.
Dialogue: 3,0:45:46.58,0:45:50.27,Default,,0,0,0,,Cô đã chạm tới giới hạn rồi, Kusanagi.
Dialogue: 3,0:45:57.12,0:46:01.44,Default,,0,0,0,,Raizo và Ibachi dùng số tiền đó làm mồi nhử kẻ địch đến đây.
Dialogue: 3,0:46:03.82,0:46:06.66,Default,,0,0,0,,Chúng tôi đã tiêu diệt sáu tên gián điệp.
Dialogue: 3,0:46:06.66,0:46:07.86,Default,,0,0,0,,Thế là quá đủ rồi.
Dialogue: 3,0:46:08.27,0:46:13.21,Default,,0,0,0,,Kanzaki tuồn tiền vào tài khoản của Mamuro, tôi chuyển đi...
Dialogue: 3,0:46:13.21,0:46:15.17,Default,,0,0,0,,...và cô đã sử dụng nó.
Dialogue: 3,0:46:15.74,0:46:16.33,Default,,0,0,0,,Đúng vậy.
Dialogue: 3,0:46:17.34,0:46:21.61,Default,,0,0,0,,Khẩu súng bắn cô gái điếm là khởi đầu cho âm mưu của kẻ địch.
Dialogue: 3,0:46:22.29,0:46:26.27,Default,,0,0,0,,Vụ nổ giết người lính Biệt kích, vụ hối lộ giả mạo...
Dialogue: 3,0:46:26.27,0:46:28.57,Default,,0,0,0,,Toàn bộ tội lỗi đều bị đổ lên đầu Mamuro.
Dialogue: 3,0:46:33.50,0:46:36.94,Default,,0,0,0,,Và ông ấy định kéo theo cả Thứ trưởng xuống mồ cùng mình.
Dialogue: 3,0:46:37.28,0:46:39.52,Default,,0,0,0,,Đó là sự lựa chọn tồi tệ nhất.
Dialogue: 3,0:46:39.52,0:46:45.65,Default,,0,0,0,,Tổ chức 501 sẽ bị đưa vào danh sách thanh trừng của Lục quân\Nđể trả đũa cho vụ bê bối.
Dialogue: 3,0:46:46.32,0:46:50.62,Default,,0,0,0,,Nên các người đã giương mắt nhìn ông ấy chết.\NTất cả các người.
Dialogue: 3,0:47:10.87,0:47:14.85,Default,,0,0,0,,Nếu không có con virus ký ức đó, có lẽ chúng tôi đã cứu được ông ấy.
Dialogue: 3,0:47:15.77,0:47:19.09,Default,,0,0,0,,Nhưng với tình hình lúc bấy giờ, lựa chọn duy nhất là thu hồi
Dialogue: 3,0:47:19.09,0:47:23.90,Default,,0,0,0,,não điện tử của Mamuro, cỗ mìn và số tiền\Ntrước khi ông ấy bị nổ tung.
Dialogue: 3,0:47:29.42,0:47:35.16,Default,,0,0,0,,Nhưng điều mà cả chúng tôi lẫn kẻ địch đều không lường trước được...\Nlà cô.
Dialogue: 3,0:47:36.60,0:47:42.33,Default,,0,0,0,,Ngay khi vừa về nước và nhận được dữ liệu, tôi đã bám theo Trung tá.
Dialogue: 3,0:47:56.15,0:47:59.06,Default,,0,0,0,,Và cô đã bị lây nhiễm từ não điện tử của ông ấy.
Dialogue: 3,0:48:10.17,0:48:16.09,Default,,0,0,0,,Ngay cả khi thu thập bằng chứng,\Ncô cũng liên tục bị xóa sạch ký ức.
