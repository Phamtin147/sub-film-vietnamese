Dialogue: 0,0:13:16.40,0:13:18.86,Defense of ministry,,0,0,0,,{\clip(1037,144,1038,181)\pos(894,177)\blur0.6\shad1.5\c&H272A2A&}Bộ Quốc phòng
Dialogue: 0,0:13:16.40,0:13:18.86,Defense of ministry,,0,0,0,,{\clip(1038,144,1039,181)\pos(894,177)\blur0.6\shad1.5\c&H262929&}Bộ Quốc phòng
Dialogue: 0,0:13:16.40,0:13:18.86,Defense of ministry,,0,0,0,,{\clip(1039,144,1040,181)\pos(894,177)\blur0.6\shad1.5\c&H262928&}Bộ Quốc phòng
Dialogue: 3,0:13:17.01,0:13:22.16,Default,,0,0,0,,cô sẽ phải chịu sự điều chỉnh của các quy định mới\Ntheo Đạo luật Vũ khí sửa đổi.
Dialogue: 3,0:13:22.16,0:13:27.25,Default,,0,0,0,,Quy định Bảo trì Thể máy hiện được áp dụng cho việc cấp giấy tờ tùy thân,
Dialogue: 3,0:13:27.25,0:13:31.88,Default,,0,0,0,,nắm giữ tiền mặt, mở tài khoản ngân hàng,\Nhay sở hữu bất kỳ tài sản nào khác.
Dialogue: 3,0:13:31.88,0:13:37.83,Default,,0,0,0,,Trong bức thư về việc tái phân loại của tôi,\NTrung tá Mamuro đã đảm bảo quyền tự chủ tài chính cho tôi.
Dialogue: 3,0:13:38.01,0:13:41.93,Default,,0,0,0,,Nếu ông ta bị chứng minh là tham nhũng,\Nông ta sẽ bị tước quân tịch trong ô nhục,
Dialogue: 3,0:13:41.93,0:13:43.80,Default,,0,0,0,,và toàn bộ các văn bản như vậy sẽ bị hủy bỏ vô hiệu.
Dialogue: 3,0:13:44.48,0:13:49.76,Default,,0,0,0,,Các người nghĩ tôi chịu được cái cảnh mỗi lần mở ví ra\Nlà lại phải nộp một đống giấy tờ đơn từ sao?
Dialogue: 3,0:13:50.11,0:13:53.82,Default,,0,0,0,,Chi phí bảo trì cơ thể nhân tạo\Nvượt xa mức chi trả bảo hiểm y tế tiêu chuẩn.
Dialogue: 3,0:13:53.82,0:13:58.19,Default,,0,0,0,,Cô phải thực hiện nghĩa vụ đối với chính phủ,\Nnơi đã bảo đảm quyền được sống cho cô.
Dialogue: 3,0:13:58.36,0:14:01.90,Default,,0,0,0,,Đây là đơn chấp thuận cho việc giám sát và quản thúc cô\Nsau đợt tái cơ cấu.
Dialogue: 3,0:14:02.24,0:14:04.71,Default,,0,0,0,,Hãy ráng mà hiểu rõ tình cảnh của mình đi.
Dialogue: 3,0:14:17.85,0:14:23.22,Default,,0,0,0,,Trong chiến tranh, Nhật Bản đã chi ra khoản ngân sách trên trời\Nđể thúc đẩy phát triển cyborg.
Dialogue: 3,0:14:23.22,0:14:27.05,Default,,0,0,0,,Họ có bảo cô biến thành tài sản của Lục quân\Nđể trả nợ cho khoản tiền đó không?
Dialogue: 3,0:14:28.61,0:14:31.78,Default,,0,0,0,,Có những khoản tiền gửi khổng lồ vào tài khoản của Mamuro.
Dialogue: 3,0:14:31.78,0:14:37.57,Default,,0,0,0,,Nhưng ngay sau vụ sát hại,\Nai đó đã rút sạch toàn bộ số tiền đó.
Dialogue: 3,0:14:37.57,0:14:39.34,Default,,0,0,0,,Ông muốn gì?
Dialogue: 3,0:14:39.34,0:14:44.58,Default,,0,0,0,,Thiếu tá Kusanagi, Tổ chức 501. Tiền án trong sạch.
Dialogue: 3,0:14:44.58,0:14:48.25,Default,,0,0,0,,Cô làm việc với Lục quân và An ninh Công cộng\Nvới tư cách cố vấn đặc biệt.
Dialogue: 3,0:14:48.25,0:14:51.49,Default,,0,0,0,,Cô là chuyên gia giải quyết các vụ tội phạm không gian mạng.
Dialogue: 3,0:14:58.77,0:15:02.64,Default,,0,0,0,,Tôi yêu cầu cô truy vết số tiền mất tích\Nvà phân tích dữ liệu quan tài.
Dialogue: 3,0:15:02.64,0:15:05.92,Default,,0,0,0,,Vì đây là cuộc điều tra chính thức,\Ncô sẽ được phép rời căn cứ.
Dialogue: 3,0:15:06.94,0:15:08.10,Default,,0,0,0,,Thù lao thế nào?
Dialogue: 3,0:15:08.10,0:15:12.48,Default,,0,0,0,,Tôi sẽ trả cho cô mức phí cố vấn thông thường,\Nnhư một thường dân.
Dialogue: 3,0:15:12.48,0:15:13.93,Default,,0,0,0,,Đó sẽ là một vấn đề đấy, ông biết chứ.
Dialogue: 3,0:15:14.32,0:15:18.85,Default,,0,0,0,,Một người lính nổi tiếng thanh liêm bị bắn chết trong bí mật\Nlà vấn đề lớn hơn nhiều đấy.
Dialogue: 3,0:15:29.59,0:15:31.25,Default,,0,0,0,,Này! Sao cô dám hả?!
Dialogue: 3,0:15:31.25,0:15:34.95,Default,,0,0,0,,Sáng mai, tôi sẽ phái đến cho cô một liên lạc viên\Nkiêm luôn nhiệm vụ vệ sĩ.
Dialogue: 3,0:15:36.13,0:15:37.59,Default,,0,0,0,,Sếp nghĩ cô ấy sẽ nhận lời chứ?
Dialogue: 3,0:15:37.59,0:15:39.97,Default,,0,0,0,,Cô ấy cũng đang mờ mịt chẳng khác gì chúng ta.
Dialogue: 3,0:15:39.97,0:15:42.98,Default,,0,0,0,,Nếu muốn tự do, cô ấy buộc phải tìm ra sự thật.
Dialogue: 3,0:15:49.07,0:15:50.88,Default,,0,0,0,,Cô vẫn không muốn để 501 tham gia điều tra sao?
Dialogue: 3,0:15:51.69,0:15:54.85,Default,,0,0,0,,Chỉ cần một bước đi sai lầm,\Nđơn vị của chúng ta có thể bị giải tán đấy.
Dialogue: 3,0:15:55.23,0:15:56.89,Default,,0,0,0,,An ninh Công cộng vừa đề nghị tôi nhận một nhiệm vụ.
Dialogue: 3,0:15:57.40,0:15:58.69,Default,,0,0,0,,Cô sẽ chấp nhận chứ?
Dialogue: 3,0:15:58.69,0:16:00.15,Default,,0,0,0,,Giúp tôi một tay đi.
Dialogue: 3,0:16:00.15,0:16:03.74,Default,,0,0,0,,Nếu một mình cô không cáng đáng nổi,\Ncô sẽ đi đến bước đường cùng đấy.
Dialogue: 3,0:16:03.74,0:16:06.66,Default,,0,0,0,,Khi đó sẽ chẳng còn ai có thể bảo vệ cô được nữa đâu.
Dialogue: 3,0:16:06.66,0:16:10.20,Default,,0,0,0,,Được bảo vệ không phải là điều tôi học được ở nơi này!
Dialogue: 3,0:16:10.20,0:16:12.30,Default,,0,0,0,,Tôi học là để phát huy tối đa năng lực của mình!
Dialogue: 3,0:16:14.93,0:16:17.49,Default,,0,0,0,,Tôi sẽ cấp quyền cho cô sử dụng Máy chủ 6.
Dialogue: 3,0:16:18.05,0:16:19.24,Default,,0,0,0,,Cảm ơn.
Dialogue: 3,0:16:19.92,0:16:21.93,Default,,0,0,0,,Chỉ cần đừng quên nhiệm vụ tôi đã giao cho cô đấy.
Dialogue: 3,0:16:29.07,0:16:31.38,Default,,0,0,0,,{\i1}Lập danh sách những người đang xử lý vụ án.{\i0}
Dialogue: 3,0:16:31.81,0:16:35.35,Default,,0,0,0,,Nhưng chuyện này rõ ràng liên quan đến vụ cướp sát hại Trung tá!
Dialogue: 3,0:16:35.35,0:16:37.59,Default,,0,0,0,,Chúng ta biết rõ ông ấy đã gặp cô gái bán hoa đó.
Dialogue: 3,0:16:37.59,0:16:39.23,Default,,0,0,0,,Chúng ta cần lệnh bắt giữ cô ta—
Dialogue: 3,0:16:39.23,0:16:42.23,Default,,0,0,0,,Đó là quyền tài phán của quân đội! Cậu bớt xía mũi vào đi!
Dialogue: 3,0:16:42.78,0:16:46.17,Default,,0,0,0,,Cậu hãy quên vụ này đi, nghe rõ chưa hả? Đây là mệnh lệnh!
Dialogue: 3,0:16:49.63,0:16:52.80,Default,,0,0,0,,Vậy thì lập ra chức điều tra viên đặc nhiệm để làm cái quái gì chứ,\Nchết tiệt?!
Dialogue: 0,0:16:55.03,0:16:58.28,lolwin8,,0,0,0,,{\c&H9F9C8F&\frz2.109\fax0.03\fscx50\fscy50\blur0.6\pos(613,209)}Trung tá đã bị theo dõi.
Dialogue: 0,0:16:58.28,0:16:58.33,lolwin8,,0,0,0,,{\c&H9F9C8F&\frz2.109\fax0.03\fscx50\fscy50\blur0.6\pos(613,209)}Trung tá đã bị theo dõi.
Dialogue: 0,0:16:58.33,0:16:58.37,lolwin8,,0,0,0,,{\c&H9F9C8F&\frz2.109\fax0.03\fscx50\fscy50\blur0.6\pos(613,209)}Trung tá đã bị theo dõi.
Dialogue: 0,0:16:58.37,0:16:58.58,lolwin8,,0,0,0,,{\c&H9F9C8F&\frz2.109\fax0.03\fscx50\fscy50\blur0.6\pos(613,209)}Trung tá đã bị theo dõi.
Dialogue: 3,0:16:59.18,0:16:59.99,Default,,0,0,0,,Cái gì?!
Dialogue: 3,0:17:20.37,0:17:23.02,Default,,0,0,0,,Này! Đ-Đứng lại đó!
Dialogue: 3,0:17:39.64,0:17:40.33,Default,,0,0,0,,Cô đây rồi!
Dialogue: 3,0:17:50.57,0:17:53.59,Default,,0,0,0,,Chà, chẳng phải là cô nhóc ngổ ngáo\Ncủa phòng thí nghiệm đấy sao?
Dialogue: 3,0:17:59.49,0:18:03.02,Default,,0,0,0,,Kẻ đã thâm nhập vào não tôi... đang ở trong chiếc xe đó!
Dialogue: 3,0:18:09.63,0:18:11.52,Default,,0,0,0,,Đồ ngu! Làm thế cô sẽ thành kẻ đào ngũ đấy!
Dialogue: 3,0:18:17.17,0:18:19.08,Default,,0,0,0,,Dừng lại, Raizo!
Dialogue: 3,0:18:19.08,0:18:21.13,Default,,0,0,0,,Cô ổn chứ, Kusanagi?
Dialogue: 3,0:18:21.13,0:18:22.45,Default,,0,0,0,,Giảng viên Ibachi...
Dialogue: 3,0:18:23.06,0:18:26.83,Default,,0,0,0,,Đừng tưởng là trò cưng của Mamuro\Nthì muốn làm gì thì làm nhé!
Dialogue: 3,0:18:27.76,0:18:31.00,Default,,0,0,0,,Hành động ích kỷ của cô đang đẩy cả đơn vị vào chỗ nguy hiểm đấy!
Dialogue: 3,0:18:31.26,0:18:35.23,Default,,0,0,0,,Đủ rồi! Tôi sẽ là người răn đe cô ấy.
Dialogue: 3,0:18:37.32,0:18:40.41,Default,,0,0,0,,Con khốn đó sống sót được\Nchẳng qua chỉ nhờ làm vật thí nghiệm thôi.
Dialogue: 3,0:18:45.87,0:18:48.19,Default,,0,0,0,,Biển số là giả. Hắn ta đúng là một kẻ lươn lẹo.
Dialogue: 3,0:18:48.70,0:18:52.07,Default,,0,0,0,,Ít nhất chúng ta cũng đã chứng minh được có kẻ xâm nhập.
Dialogue: 3,0:18:52.07,0:18:53.87,Default,,0,0,0,,Kurutsu nói sao?
Dialogue: 3,0:18:53.87,0:18:55.34,Default,,0,0,0,,"Mặc kệ đi."
Dialogue: 3,0:18:57.05,0:18:58.15,Default,,0,0,0,,Cơ thể nhân tạo của cô lại giở chứng à?
Dialogue: 3,0:19:01.26,0:19:02.92,Default,,0,0,0,,Tôi không biết nữa.
Dialogue: 3,0:19:02.92,0:19:04.59,Default,,0,0,0,,Chà chà, lại có khách đến nữa kìa.
Dialogue: 3,0:19:04.59,0:19:06.75,Default,,0,0,0,,Có một vị khách kỳ lạ muốn gặp cô đấy.
Dialogue: 3,0:19:11.02,0:19:12.13,Default,,0,0,0,,Cái gì thế này?
Dialogue: 3,0:19:17.28,0:19:21.01,Default,,0,0,0,,Nó dùng đèn tín hiệu sao? Thứ này cổ lỗ sĩ từ thời nào thế?
Dialogue: 3,0:19:23.62,0:19:24.87,Default,,0,0,0,,Lại đây, đi theo tôi.
Dialogue: 3,0:19:37.51,0:19:41.13,Default,,0,0,0,,Hãy tự mình xây dựng cơ sở học tập đi.
Dialogue: 3,0:19:47.31,0:19:49.22,Default,,0,0,0,,Xin chào, rất hân hạnh được gặp ngài!
Dialogue: 3,0:19:49.22,0:19:55.17,Default,,0,0,0,,Tôi là hệ thống hậu cần tự hành bám đuôi:\Nmột "Cỗ máy Vận chuyển Hậu cần" (Logistics Conveyer Machine)!
Dialogue: 3,0:19:55.47,0:19:59.38,Default,,0,0,0,,Cậu chính là "liên lạc viên kiêm vệ sĩ" của Đội 9 sao?
Dialogue: 3,0:19:59.52,0:20:02.52,Default,,0,0,0,,Trưởng ban Aramaki gọi tôi là "Logicoma" ạ!
Dialogue: 3,0:20:02.52,0:20:07.15,Default,,0,0,0,,Ngài sẽ tiếp nhận thông tin thông qua tôi,\Nthưa Thiếu tá Kusanagi!
Dialogue: 3,0:20:07.15,0:20:11.78,Default,,0,0,0,,Không đồng bộ mạng. Hãy báo cáo bằng lời nói hoặc truyền tệp dữ liệu.
Dialogue: 3,0:20:11.78,0:20:17.03,Default,,0,0,0,,Dạ... Mọi thông tin của Lục quân về nhóm buôn lậu vũ khí trái phép
Dialogue: 3,0:20:17.03,0:20:21.07,Default,,0,0,0,,đều sẽ rất hữu ích cho Trưởng ban Aramaki\Ntrong việc truy vết một cỗ mìn di động đấy ạ!
Dialogue: 3,0:20:21.50,0:20:24.03,Default,,0,0,0,,Lục quân? Bọn buôn vũ khí sao?
Dialogue: 3,0:20:24.46,0:20:26.24,Default,,0,0,0,,Rõ, thưa sếp!
Dialogue: 3,0:20:29.06,0:20:31.88,Default,,0,0,0,,Cậu tàng hình đi. Từ đây để tôi lo.
Dialogue: 3,0:20:31.88,0:20:34.39,Default,,0,0,0,,Đã nhận lệnh!
Dialogue: 3,0:20:36.19,0:20:37.42,Default,,0,0,0,,Ngụy trang quang học à?
Dialogue: 3,0:20:46.49,0:20:48.40,Default,,0,0,0,,Ở lại đây và canh chừng xe máy của tôi.
Dialogue: 3,0:20:48.40,0:20:49.68,Default,,0,0,0,,Rõ ạ!
Dialogue: 3,0:20:53.75,0:20:57.79,Default,,0,0,0,,Nào, đi thẳng coi! Nhìn xem, sắp đến nơi rồi.
Dialogue: 3,0:21:04.01,0:21:05.28,Default,,0,0,0,,Chào đằng ấy!
Dialogue: 3,0:21:05.88,0:21:06.83,Default,,0,0,0,,Cứ tự nhiên vào đi.
Dialogue: 3,0:21:06.83,0:21:09.92,Default,,0,0,0,,Còn chưa tới giờ ăn tối mà gã này đã say bí tỉ thế này rồi!
Dialogue: 3,0:21:09.92,0:21:12.26,Default,,0,0,0,,Lấy cho hắn thứ gì mát lạnh đi, được chứ?
Dialogue: 3,0:21:12.26,0:21:15.64,Default,,0,0,0,,Nào, tỉnh táo lại coi! Ngồi thẳng lưng lên!
Dialogue: 3,0:21:28.20,0:21:29.22,Default,,0,0,0,,Tôi bỏ bài.
Dialogue: 3,0:21:29.65,0:21:31.28,Default,,0,0,0,,Đi giải quyết nỗi buồn cái đã.
Dialogue: 3,0:21:31.28,0:21:32.99,Default,,0,0,0,,Này, chơi bẩn thế!
Dialogue: 3,0:21:32.99,0:21:34.73,Default,,0,0,0,,Bài ông đang đẹp thế cơ mà!
Dialogue: 3,0:21:41.17,0:21:42.01,Default,,0,0,0,,Xong.
Dialogue: 3,0:21:49.01,0:21:50.59,Default,,0,0,0,,Cảnh báo! Cảnh báo!
Dialogue: 3,0:21:50.59,0:21:52.99,Default,,0,0,0,,Có ai đó đang tiếp cận, ở cự ly cực gần!
Dialogue: 3,0:21:55.85,0:21:58.54,Default,,0,0,0,,Đứng im. Ai phái anh tới?!
Dialogue: 3,0:22:17.54,0:22:19.81,Default,,0,0,0,,Các người chính là kẻ đã sát hại Trung tá Mamuro phải không?
Dialogue: 3,0:22:20.07,0:22:21.99,Default,,0,0,0,,Hả? Cô là người của An ninh Công cộng à?
Dialogue: 3,0:22:21.99,0:22:23.01,Default,,0,0,0,,Trả lời mau!
Dialogue: 3,0:22:23.66,0:22:29.71,Default,,0,0,0,,Trước tiên hãy kiểm tra cơ sở dữ liệu của Lục quân đi!\NMã số 24, Chiến dịch H2976...
Dialogue: 3,0:22:29.71,0:22:31.62,Default,,0,0,0,,...mật danh Paz!
Dialogue: 3,0:22:32.93,0:22:34.64,Default,,0,0,0,,Anh là nội gián ư?!
Dialogue: 3,0:22:35.68,0:22:40.09,Default,,0,0,0,,Ừ, nhóm tôi đang trà trộn được thuê để thực hiện một vụ ám sát.
Dialogue: 3,0:22:40.09,0:22:44.60,Default,,0,0,0,,Bọn chúng bảo mục tiêu là một thể nhân tạo toàn phần\Nvà não điện tử của hắn phải bị phá hủy hoàn toàn,\Nnên bọn tôi sẽ dùng mìn di động.
Dialogue: 3,0:22:44.60,0:22:46.67,Default,,0,0,0,,Ba quả—toàn hàng chuẩn quân đội đấy.
Dialogue: 3,0:22:47.73,0:22:49.63,Default,,0,0,0,,Vụ sát hại Trung tá Mamuro sao?
Dialogue: 3,0:22:50.15,0:22:54.40,Default,,0,0,0,,Ai mà biết được? Hình như có kẻ đã nhanh tay hơn bọn tôi một bước,
Dialogue: 3,0:22:54.40,0:22:56.61,Default,,0,0,0,,và bọn tôi đã để sổng mất mấy quả mìn.
Dialogue: 3,0:22:56.61,0:22:58.05,Default,,0,0,0,,Mấy quả mìn đó lấy từ đâu ra?
Dialogue: 3,0:22:58.77,0:23:00.95,Default,,0,0,0,,Khu vực tập trận số 6.
Dialogue: 3,0:23:00.95,0:23:05.59,Default,,0,0,0,,Nơi đó đúng là trò hề. Chẳng khác nào giao trứng cho ác.
Dialogue: 3,0:23:07.42,0:23:09.57,Default,,0,0,0,,Có hứng cùng tôi đi chứng minh điều đó không?
Dialogue: 3,0:23:11.89,0:23:15.00,Default,,0,0,0,,Công việc này chẳng hay ho gì, nhưng tôi không thể bỏ ngang được.
Dialogue: 3,0:23:15.00,0:23:19.13,Default,,0,0,0,,Tôi sẽ gặp nguy hiểm, và còn gây rắc rối cho chỉ huy của tôi nữa.
Dialogue: 3,0:23:19.13,0:23:21.27,Default,,0,0,0,,Chỉ huy của anh đáng tin chứ?
Dialogue: 3,0:23:22.69,0:23:24.04,Default,,0,0,0,,Từng như vậy.
Dialogue: 3,0:23:26.44,0:23:27.20,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 3,0:23:29.65,0:23:31.14,Default,,0,0,0,,Cảm ơn vì đã hợp tác.
Dialogue: 3,0:23:32.53,0:23:34.89,Default,,0,0,0,,Ước gì tôi cũng có được sự tự do hành động như anh.
Dialogue: 3,0:23:46.00,0:23:47.57,Default,,0,0,0,,Cô không phân tích được à?
Dialogue: 3,0:23:48.00,0:23:49.46,Default,,0,0,0,,Có thể nó chỉ là tạp âm thôi.
Dialogue: 3,0:24:09.53,0:24:14.94,Default,,0,0,0,,Chẳng có thể nhân tạo toàn phần nào\Nđược phép rời khỏi tổ chức này để độc lập đâu.
Dialogue: 3,0:24:14.94,0:24:18.08,Default,,0,0,0,,Cô chỉ là một con nhóc có chút tài năng về tác chiến mạng thôi.
Dialogue: 3,0:24:19.40,0:24:21.90,Default,,0,0,0,,Cái chết của Mamuro là điều tất yếu.
Dialogue: 3,0:24:21.90,0:24:25.29,Default,,0,0,0,,Đừng có vượt quá giới hạn, không thì chính tay tôi sẽ trừ khử cô đấy.
Dialogue: 3,0:24:26.51,0:24:29.19,Default,,0,0,0,,Kurutsu và Ibachi không thể che chở cho cô trước tôi đâu.
Dialogue: 3,0:24:30.51,0:24:31.65,Default,,0,0,0,,Một điều tất yếu sao...
