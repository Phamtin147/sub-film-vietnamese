Dialogue: 3,0:26:01.06,0:26:03.58,Default,,0,0,0,,Thế này là vô lý hết sức! Bọn họ thậm chí còn chẳng có ở—
Dialogue: 2,0:26:03.58,0:26:09.04,Fire Hydrant,,0,0,0,,{\pos(620,607.999)\blur0.6}Trụ cứu hỏa
Dialogue: 3,0:26:05.81,0:26:09.04,Default,,0,0,0,,À, xin lỗi. Tôi là điều tra viên đặc nhiệm thuộc Cảnh sát Niihama.
Dialogue: 3,0:26:10.05,0:26:11.75,Default,,0,0,0,,Tôi được báo là có thể tìm thấy hai người này ở đây.
Dialogue: 3,0:26:13.06,0:26:15.28,Default,,0,0,0,,Tôi có vài câu hỏi dành cho Trung úy Seta Moto...
Dialogue: 3,0:26:15.28,0:26:17.73,Default,,0,0,0,,...và Đại úy Amuri Noto ở đây—
Dialogue: 3,0:26:17.73,0:26:20.39,Default,,0,0,0,,Cảm ơn. Anh vừa giúp tôi chắp nối các manh mối rồi đấy.
Dialogue: 0,0:26:20.39,0:26:27.89,Fire Hydrant,,0,0,0,,{\pos(620,607.999)\blur0.6}Trụ cứu hỏa
Dialogue: 3,0:26:21.73,0:26:27.89,Default,,0,0,0,,Và tôi thấy một vài manh mối khác cũng vừa kết nối rồi.\NSao không lộ diện đi?
Dialogue: 3,0:26:34.63,0:26:35.94,Default,,0,0,0,,Batou Biệt kích đấy à?
Dialogue: 3,0:26:37.04,0:26:41.41,Default,,0,0,0,,Lâu rồi không gặp.\NPhải nói là tôi không ngờ cô lại dính vào vụ này đấy.
Dialogue: 3,0:26:42.25,0:26:43.84,Default,,0,0,0,,Ý anh là sao?
Dialogue: 3,0:26:43.84,0:26:47.60,Default,,0,0,0,,Người đàn ông mà cô đã giết 7 ngày trước\Ntừng là chiến hữu của tôi!
Dialogue: 3,0:26:48.72,0:26:51.38,Default,,0,0,0,,Tôi mới chỉ vừa về nước được 3 ngày thôi.
Dialogue: 3,0:26:51.38,0:26:52.64,Default,,0,0,0,,Ồ, thật vậy sao?!
Dialogue: 3,0:27:13.79,0:27:19.41,Default,,0,0,0,,Tôi đã bảo anh bao nhiêu lần rồi,\Ncái con mắt không ngủ của anh rất dễ bị thâm nhập.
Dialogue: 3,0:27:19.41,0:27:22.21,Default,,0,0,0,,Vẫn còn sợ bị quân mình bắn nhầm giữa rừng rậm à?
Dialogue: 3,0:27:23.09,0:27:25.63,Default,,0,0,0,,Tôi cũng là chuyên gia tác chiến điện tử đấy nhé!
Dialogue: 3,0:27:25.63,0:27:28.84,Default,,0,0,0,,Không thể tin nổi cô lại dám thâm nhập vào não tôi\Nngay giữa trận đấu!
Dialogue: 3,0:27:28.84,0:27:32.44,Default,,0,0,0,,Chắc cũng chỉ có mỗi cô mới làm được cái trò thâm nhập vào tôi thôi.
Dialogue: 3,0:27:32.44,0:27:35.00,Default,,0,0,0,,Vậy rốt cuộc tại sao anh lại săn đuổi tôi?
Dialogue: 3,0:27:35.18,0:27:36.52,Default,,0,0,0,,Đừng có giả ngơ!
Dialogue: 3,0:27:36.52,0:27:39.55,Default,,0,0,0,,Chính cô là kẻ đã lấy cắp mấy cỗ mìn di động ở nơi này!
Dialogue: 3,0:27:44.24,0:27:45.38,Default,,0,0,0,,Cái quái gì thế này?!
Dialogue: 3,0:27:53.73,0:27:54.63,Default,,0,0,0,,Đợi đã!
Dialogue: 3,0:27:55.08,0:27:56.88,Default,,0,0,0,,Đừng bắn! Chạy mau!
Dialogue: 3,0:28:08.64,0:28:09.20,Default,,0,0,0,,Đừng!
Dialogue: 3,0:28:36.54,0:28:38.54,Default,,0,0,0,,Mấy gã đó không phải phe của cô à?!
Dialogue: 3,0:28:38.54,0:28:40.37,Default,,0,0,0,,Nghiêm túc đấy, anh đang nói cái quái gì thế?
Dialogue: 3,0:28:40.37,0:28:42.11,Default,,0,0,0,,Này, nhìn kìa!
Dialogue: 3,0:28:46.55,0:28:47.76,Default,,0,0,0,,Chúng tìm thấy chúng ta rồi!
Dialogue: 3,0:28:48.93,0:28:50.51,Default,,0,0,0,,Chúng muốn trừ khử chúng ta ngay tại đây.
Dialogue: 3,0:28:50.51,0:28:52.63,Default,,0,0,0,,Và cái cớ của chúng sẽ là "tai nạn trong đợt diễn tập" sao?
Dialogue: 3,0:28:52.63,0:28:55.25,Default,,0,0,0,,Với khẩu súng tí hon này thì chặn bọn chúng thế nào được?!
Dialogue: 3,0:28:58.32,0:28:59.86,Default,,0,0,0,,Chúng ta chỉ còn cách chạy thôi!
Dialogue: 3,0:29:05.74,0:29:06.90,Default,,0,0,0,,Mau trèo lên!
Dialogue: 3,0:29:06.90,0:29:08.02,Default,,0,0,0,,Trèo lên cái này á?!
Dialogue: 3,0:29:08.02,0:29:09.60,Default,,0,0,0,,Chuẩn mẹ nó rồi!
Dialogue: 3,0:29:10.11,0:29:12.69,Default,,0,0,0,,Chúng tôi sẽ cầm chân chúng, mau di chuyển đi!
Dialogue: 3,0:29:12.69,0:29:13.69,Default,,0,0,0,,Được rồi, nghe đây.
Dialogue: 3,0:29:13.69,0:29:14.74,Default,,0,0,0,,Xin chào ạ!
Dialogue: 3,0:29:14.74,0:29:15.48,Default,,0,0,0,,Cái gì thế kia?!
Dialogue: 3,0:29:18.34,0:29:19.57,Default,,0,0,0,,Chúng ta bị bao vây rồi.
Dialogue: 3,0:29:22.71,0:29:24.08,Default,,0,0,0,,Tôi đã bảo rồi, biến đi mau!
Dialogue: 3,0:29:24.08,0:29:25.53,Default,,0,0,0,,Tôi biết rồi, biết rồi mà!
Dialogue: 3,0:29:35.89,0:29:36.83,Default,,0,0,0,,Vào xe mau!
Dialogue: 3,0:29:56.50,0:29:58.40,Default,,0,0,0,,Tôi tưởng anh "không thể bỏ ngang"?
Dialogue: 3,0:29:58.57,0:30:01.00,Default,,0,0,0,,Thế này xem như đổi gió một chút.
Dialogue: 3,0:30:19.98,0:30:23.14,Default,,0,0,0,,Cô nhờ Quân cảnh giúp đỡ à?
Dialogue: 3,0:30:23.14,0:30:24.96,Default,,0,0,0,,Để áp giải một nghi phạm.
Dialogue: 3,0:30:26.31,0:30:27.60,Default,,0,0,0,,Chuyện này là thế nào?
Dialogue: 3,0:30:34.70,0:30:36.57,Default,,0,0,0,,Chuyện này hoàn toàn vô lý.
Dialogue: 3,0:30:36.57,0:30:41.86,Default,,0,0,0,,Thứ nhất: số tiền mất tích đã được chuyển\Nvào tài khoản của cô, Thiếu tá Kusanagi.
Dialogue: 3,0:30:42.16,0:30:46.46,Default,,0,0,0,,Thứ hai: viên đạn cô bắn vào cỗ mìn di động ở nghĩa trang
Dialogue: 3,0:30:46.46,0:30:49.36,Default,,0,0,0,,trùng khớp với viên đạn đã giết chết Trung tá Mamuro.
Dialogue: 3,0:30:49.67,0:30:53.37,Default,,0,0,0,,Bảy ngày trước, một gái bán hoa trong thị trấn đã bị bắn chết.
Dialogue: 3,0:30:53.92,0:30:56.45,Default,,0,0,0,,Viên đạn cũng trùng khớp với loại đã giết Mamuro.
Dialogue: 3,0:30:56.80,0:31:00.09,Default,,0,0,0,,Mamuro từng gặp cô ta, và theo lời các cô gái khác,
Dialogue: 3,0:31:00.09,0:31:03.09,Default,,0,0,0,,ông ta đã gặng hỏi về một trong những khách quen của cô ta.
Dialogue: 3,0:31:03.39,0:31:06.89,Default,,0,0,0,,Bảy ngày trước, một chiến hữu Biệt kích của tôi
Dialogue: 3,0:31:06.89,0:31:09.53,Default,,0,0,0,,đã bị giết bởi một cỗ mìn di động, cùng với cả gia đình anh ấy.
Dialogue: 3,0:31:12.45,0:31:15.68,Default,,0,0,0,,Cậu ấy cũng từng liên lạc với Mamuro.
Dialogue: 3,0:31:15.98,0:31:20.60,Default,,0,0,0,,Và khi tôi truy vết nguồn gốc cỗ mìn,\Nnó đã dẫn tôi thẳng tới nữ Thiếu tá đây.
Dialogue: 3,0:31:21.11,0:31:24.37,Default,,0,0,0,,Tiện thể nói luôn, cô ta bảo mình mới về nước 3 ngày trước,
Dialogue: 3,0:31:24.37,0:31:26.98,Default,,0,0,0,,nhưng hồ sơ Cục Xuất nhập cảnh lại ghi rõ là 7 ngày trước.
Dialogue: 3,0:31:26.98,0:31:30.00,Default,,0,0,0,,Ba cỗ mìn mà nhóm tôi được giao sử dụng
Dialogue: 3,0:31:30.00,0:31:33.21,Default,,0,0,0,,cùng kiểu với cỗ mìn mà Đội 9 đã đào lên ở nghĩa trang.
Dialogue: 3,0:31:33.21,0:31:36.91,Default,,0,0,0,,Cứ cho là một cỗ bị chôn và một cỗ đã giết người lính Biệt kích kia,
Dialogue: 3,0:31:37.34,0:31:39.67,Default,,0,0,0,,thì vẫn còn một cỗ nữa chưa rõ tung tích.
Dialogue: 3,0:31:39.67,0:31:43.76,Default,,0,0,0,,Hiện tại, mọi manh mối đều chỉ ra rằng chính cô đã sát hại Mamuro
Dialogue: 3,0:31:43.76,0:31:45.88,Default,,0,0,0,,và cướp sạch tiền của ông ấy.
Dialogue: 3,0:31:47.57,0:31:53.34,Default,,0,0,0,,{\fad(0,1031)}Ngay sau khi hạ cánh, tôi nhận được một tin nhắn cùng một chiếc va-li từ ông ấy.{\i0}
Dialogue: 3,0:31:53.34,0:31:58.22,Default,,0,0,0,,Tôi xin lỗi, Thiếu tá Kusanagi.\NTôi e rằng mình chẳng còn sống được bao lâu nữa.
Dialogue: 3,0:32:00.16,0:32:02.77,Default,,0,0,0,,Tôi từng muốn đòi lại công lý.
Dialogue: 3,0:32:03.12,0:32:05.73,Default,,0,0,0,,Tôi đã gửi gắm bức thư đề bạt của cô cho một người khác trông coi.
Dialogue: 3,0:32:07.12,0:32:12.50,Default,,0,0,0,,Cô là thành viên có triển vọng nhất mà tôi từng biết.\NChúc cô may mắn.
Dialogue: 3,0:32:12.50,0:32:17.12,Default,,0,0,0,,Bên trong chiếc va-li, tôi tìm thấy dữ liệu\Nvề một đường dây tuồn vũ khí nội bộ...
Dialogue: 3,0:32:17.88,0:32:19.80,Default,,0,0,0,,...và khẩu súng này.
Dialogue: 3,0:32:19.80,0:32:23.62,Default,,0,0,0,,Mấy ngày qua cô đã chuyển đi một số tiền rất lớn.
Dialogue: 3,0:32:24.39,0:32:25.92,Default,,0,0,0,,Cô gửi số tiền đó cho ai?
Dialogue: 3,0:32:27.01,0:32:30.09,Default,,0,0,0,,Vợ góa của người đàn ông đã nuôi nấng tôi.
Dialogue: 3,0:32:30.68,0:32:35.28,Default,,0,0,0,,Bà ấy đã chăm sóc tôi từ thuở nhỏ,\Nnhưng giờ bà đang ở viện dưỡng lão.
Dialogue: 3,0:32:36.06,0:32:37.85,Default,,0,0,0,,Bà ấy tên gì?
Dialogue: 3,0:32:39.87,0:32:41.68,Default,,0,0,0,,Tên của người phụ nữ này là gì?
Dialogue: 3,0:32:55.34,0:32:57.24,Default,,0,0,0,,Cơn đau chi ma à?
Dialogue: 3,0:32:57.50,0:33:01.33,Default,,0,0,0,,Ngay cả khi đã máy móc hóa cơ thể,\Nnhưng bộ não vẫn không bao giờ quên được cơ thể nguyên bản.
Dialogue: 3,0:33:02.13,0:33:03.88,Default,,0,0,0,,Đúng là phiền toái thật.
Dialogue: 3,0:33:03.88,0:33:06.22,Default,,0,0,0,,Tôi không có cơ thể "nguyên bản" nào cả.
Dialogue: 3,0:33:06.22,0:33:07.64,Default,,0,0,0,,Cái gì?
Dialogue: 3,0:33:07.64,0:33:11.21,Default,,0,0,0,,Các anh đã nghe nói về hệ thống y tế khẩn cấp của Tiến sĩ Bakeru chưa?
Dialogue: 3,0:33:11.52,0:33:13.36,Default,,0,0,0,,Cái hệ thống mà một người mang cơ thể nhân tạo toàn phần
Dialogue: 3,0:33:13.36,0:33:16.93,Default,,0,0,0,,sử dụng hệ thống duy trì sự sống của mình cho người khác ấy à?
Dialogue: 3,0:33:17.99,0:33:23.52,Default,,0,0,0,,Người nuôi nấng tôi đã dùng nó cho tôi\Nkhi tôi còn nằm trong bụng mẹ.
Dialogue: 3,0:33:28.46,0:33:34.11,Default,,0,0,0,,Nghe nói một vụ tấn công vũ khí hóa học năm xưa\Nđã cướp đi sinh mạng của vô số thường dân.
Dialogue: 3,0:33:34.25,0:33:38.08,Default,,0,0,0,,Một phụ nữ mang thai và người đàn ông được cho là chồng bà đều thiệt mạng.
Dialogue: 3,0:33:38.08,0:33:39.58,Default,,0,0,0,,Thậm chí người ta còn chẳng rõ danh tính của họ.
Dialogue: 3,0:33:40.09,0:33:43.76,Default,,0,0,0,,Nhờ có một người mang thiết bị cứu sinh đặc biệt đó tình cờ có mặt tại hiện trường,
Dialogue: 3,0:33:43.76,0:33:46.00,Default,,0,0,0,,mà duy nhất bộ não của bào thai là còn sống sót.
Dialogue: 3,0:33:46.43,0:33:48.96,Default,,0,0,0,,Ý cô là cô đã được biến thành cyborg toàn phần ngay từ lúc lọt lòng sao?!
Dialogue: 3,0:33:49.47,0:33:52.47,Default,,0,0,0,,Tôi hoàn toàn không có bất kỳ ký ức nào về một cơ thể bằng xương bằng thịt.
Dialogue: 3,0:33:52.47,0:33:57.93,Default,,0,0,0,,Nên có lẽ thứ này gọi là "nỗi đau bóng ma" (ghost pain),\Nsinh ra từ những ký ức giả tạo.
Dialogue: 3,0:34:04.66,0:34:07.81,Default,,0,0,0,,Đây là đoạn băng giám sát từ Khu vực Tập trận số 6.
Dialogue: 3,0:34:08.03,0:34:10.36,Default,,0,0,0,,Cấp dưới của cô có mặt trong đó.
Dialogue: 3,0:34:10.74,0:34:13.08,Default,,0,0,0,,Nếu cô từ chối giao nộp cô ta,
Dialogue: 3,0:34:13.08,0:34:16.49,Default,,0,0,0,,tôi sẽ đem đến trát triệu tập có chữ ký của chính Bộ trưởng Quốc phòng.
Dialogue: 3,0:34:16.67,0:34:20.45,Default,,0,0,0,,Tôi sẽ nộp báo cáo bằng văn bản sau.\NTôi không thể giao cô ấy được.
Dialogue: 3,0:34:21.26,0:34:23.13,Default,,0,0,0,,Đồ hồ ly tinh.
Dialogue: 3,0:34:23.13,0:34:25.41,Default,,0,0,0,,Tôi sẽ khiến cô phải hối hận vì chuyện này.
Dialogue: 3,0:34:32.80,0:34:34.64,Default,,0,0,0,,Hắn là Kanzaki Shujiro.
Dialogue: 3,0:34:34.64,0:34:39.65,Default,,0,0,0,,Hắn phụ trách Khu vực Tập trận số 6,\Nvà chỉ huy một đội đặc vụ.
Dialogue: 3,0:34:39.65,0:34:42.60,Default,,0,0,0,,Hắn cũng chính là đầu mối trung gian bẩn thỉu\Ngiữa Lục quân và Bộ Quốc phòng.
Dialogue: 3,0:34:42.94,0:34:46.29,Default,,0,0,0,,Đừng lo. Tôi sẽ bảo vệ cô.
Dialogue: 3,0:34:49.46,0:34:50.96,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 3,0:34:52.17,0:34:53.71,Default,,0,0,0,,Không có gì.
Dialogue: 3,0:35:07.56,0:35:11.17,Default,,0,0,0,,Nó vốn trống rỗng ngay từ đầu sao?\NVậy thì khẩu súng ở đâu ra?!
Dialogue: 3,0:35:13.01,0:35:16.14,Default,,0,0,0,,Tại sao tôi lại nghĩ bên trong có tài liệu tố giác cơ chứ?!
Dialogue: 3,0:35:16.14,0:35:17.30,Default,,0,0,0,,Còn Trung tá thì sao?
Dialogue: 3,0:35:36.42,0:35:38.15,Default,,0,0,0,,Điều gì mới là thật?
Dialogue: 3,0:35:38.15,0:35:39.80,Default,,0,0,0,,{\i1}Đâu mới là sự thật?{\i0}
Dialogue: 3,0:35:46.72,0:35:48.52,Default,,0,0,0,,Não điện tử của Trung tá đang ở đâu?
Dialogue: 3,0:35:52.94,0:35:54.37,Default,,0,0,0,,Đợi đã, Kusanagi.
Dialogue: 3,0:35:54.37,0:35:55.13,Default,,0,0,0,,Bình tĩnh lại đi.
Dialogue: 3,0:35:56.84,0:36:02.68,Default,,0,0,0,,Phần cứng mà Kurutsu bảo tôi phân tích trùng khớp với dạng thức đồng bộ mạng của ông ấy.
Dialogue: 3,0:36:02.68,0:36:06.15,Default,,0,0,0,,Ông ấy và tôi đã cùng nhiễm một loại virus, phải không?
Dialogue: 3,0:36:06.15,0:36:08.76,Default,,0,0,0,,Với một thứ được giả định là virus không gian mạng.
Dialogue: 3,0:36:08.76,0:36:11.30,Default,,0,0,0,,Chúng tôi suy đoán nó là loại tương tự Stuxnet tự hủy
Dialogue: 3,0:36:11.30,0:36:13.85,Default,,0,0,0,,gây ra rối loạn chức năng không xác định.
Dialogue: 3,0:36:14.45,0:36:18.30,Default,,0,0,0,,"Rối loạn chức năng không xác định"... Ý các người là ký ức giả tạo.
Dialogue: 3,0:36:18.30,0:36:19.94,Default,,0,0,0,,Đó thuần túy chỉ là một giả thuyết thôi.
Dialogue: 3,0:36:19.94,0:36:22.26,Default,,0,0,0,,Ít nhất là cho đến khi chúng tôi kiểm tra hành vi của cô.
Dialogue: 3,0:36:23.07,0:36:24.99,Default,,0,0,0,,{\i1}Hôm nay tôi mới vừa đặt chân về Nhật Bản đấy thôi.{\i0}
Dialogue: 3,0:36:26.48,0:36:27.74,Default,,0,0,0,,{\i1}Cũng đúng.{\i0}
Dialogue: 3,0:36:28.72,0:36:30.79,Default,,0,0,0,,Tôi đã về Nhật Bản từ khi nào?
Dialogue: 3,0:36:30.79,0:36:34.30,Default,,0,0,0,,Khoảng 180 giờ trước. Nói cách khác là 7 ngày.
Dialogue: 3,0:36:34.30,0:36:39.78,Default,,0,0,0,,Vậy mà cô vẫn khăng khăng khẳng định đó là một ngày hoàn toàn khác.
Dialogue: 3,0:36:39.78,0:36:41.13,Default,,0,0,0,,Con đường lây nhiễm?
Dialogue: 3,0:36:41.13,0:36:43.57,Default,,0,0,0,,Chắc chắn là do tiếp xúc với não điện tử của Mamuro,
Dialogue: 3,0:36:43.57,0:36:46.26,Default,,0,0,0,,thứ hiện vẫn còn nằm cùng cơ thể nhân tạo của ông ấy.
Dialogue: 3,0:36:47.41,0:36:49.39,Default,,0,0,0,,{\i1}Quan tài của ông ấy đã bị gài bẫy.{\i0}
Dialogue: 3,0:36:50.29,0:36:54.06,Default,,0,0,0,,{\i1}Và hồ sơ mai táng mà An ninh Công cộng có được không hề có dấu hiệu bị can thiệp.{\i0}
Dialogue: 3,0:36:56.18,0:36:57.94,Default,,0,0,0,,Ra là như vậy sao...
Dialogue: 3,0:36:59.89,0:37:01.94,Default,,0,0,0,,Logicoma, đồng bộ với tôi.
Dialogue: 3,0:37:01.94,0:37:03.29,Default,,0,0,0,,Ngài có chắc chắn không?
Dialogue: 3,0:37:03.29,0:37:07.70,Default,,0,0,0,,Cứ làm mau đi. Ghi lại tầm nhìn của tôi\Nvà phát lại theo thời gian thực.
Dialogue: 3,0:37:08.91,0:37:10.74,Default,,0,0,0,,Rõ ạ!
Dialogue: 3,0:37:13.30,0:37:15.75,Default,,0,0,0,,{\i1}Tôi nhìn thấy những thứ không hề tồn tại.{\i0}
Dialogue: 3,0:37:23.36,0:37:26.43,Default,,0,0,0,,{\i1}Tôi lại chẳng thấy những thứ đang hiện hữu ngay trước mắt.{\i0}
Dialogue: 3,0:37:50.64,0:37:52.66,Default,,0,0,0,,Bà ấy đã luôn ở đây suốt thời gian qua sao?
Dialogue: 0,0:37:54.79,0:37:55.41,Sharpie,,0,0,0,,{\c&H3D2F43&\fs40\blur0.6\frz3.329\pos(730.668,112)}"Đặc vụ" "Trung tá vô tội"
Dialogue: 3,0:38:14.78,0:38:17.48,Default,,0,0,0,,Đây là lệnh bắt giữ Thiếu tá Kusanagi.
Dialogue: 3,0:38:20.10,0:38:21.90,Default,,0,0,0,,Giao nộp cô ta ngay lập tức.
