Dialogue: 0,0:00:09.46,0:00:12.90,Supreme Cunt,,0,0,0,,{\blur0.6\fax-0.07\yshad-2\xshad-1\c&HA2B4BE&\fscx70\fscy70\frz0.5574\pos(598,595)\4c&H3F383B&}Tòa án Tối cao
Dialogue: 5,0:00:16.97,0:00:18.74,Default,,0,0,0,,Soga Kazuya, ra đây mau!
Dialogue: 5,0:00:18.89,0:00:21.27,Default,,0,0,0,,{\an8}Đơn vị Griffin, còn mười phút nữa sẽ bắt đầu không kích.
Dialogue: 5,0:00:19.58,0:00:20.67,Default,,0,0,0,,Eagle đã dọn sạch mục tiêu.
Dialogue: 5,0:00:21.27,0:00:23.23,Default,,0,0,0,,Fox, không thể.
Dialogue: 5,0:00:22.18,0:00:24.96,Default,,0,0,0,,{\an8}Đơn vị Griffin, còn mười phút nữa sẽ bắt đầu không kích.
Dialogue: 5,0:00:24.24,0:00:25.88,Default,,0,0,0,,Griffin nghe rõ. Đã nhận lệnh.
Dialogue: 5,0:00:25.88,0:00:28.63,Default,,0,0,0,,{\an8}Đơn vị Griffin, còn mười phút nữa sẽ bắt đầu không kích.
Dialogue: 5,0:00:27.39,0:00:28.63,Default,,0,0,0,,Khu vực an toàn!
Dialogue: 5,0:00:39.39,0:00:40.01,Default,,0,0,0,,Ném lựu đạn!
Dialogue: 5,0:00:40.01,0:00:41.80,Default,,0,0,0,,Khoan đã! Bọn chúng có con tin!
Dialogue: 5,0:00:42.60,0:00:43.18,Default,,0,0,0,,Yêu cầu chi viện!
Dialogue: 5,0:00:43.18,0:00:43.22,Default,,0,0,0,,{\alpha&HFF&}Yêu cầu chi viện!
Dialogue: 5,0:00:43.22,0:00:43.27,Default,,0,0,0,,{\alpha&HAA&}Yêu cầu chi viện!
Dialogue: 5,0:00:43.27,0:00:43.35,Default,,0,0,0,,{\alpha&H55&}Yêu cầu chi viện!
Dialogue: 5,0:00:43.35,0:00:43.39,Default,,0,0,0,,{\alpha&HFF&}Yêu cầu chi viện!
Dialogue: 5,0:01:06.10,0:01:11.00,Default,,0,0,0,,Tòa án xin tuyên bản án cuối cùng dành cho bị cáo Soga Kazuya.
Dialogue: 5,0:01:14.78,0:01:19.70,Default,,0,0,0,,Rõ ràng bị cáo đã phạm phải tội ác chống lại loài người...
Dialogue: 5,0:01:19.70,0:01:21.26,Default,,0,0,0,,...trong các cuộc giao tranh tại Qhardistan.
Dialogue: 5,0:01:24.86,0:01:29.01,Default,,0,0,0,,{\fad(0,500)}Do đó, tòa án xét xử tội ác chiến tranh này tuyên phạt...
Dialogue: 5,0:03:20.04,0:03:24.36,Default,,0,0,0,,Kỳ lạ thật... Sao mình lại tỉnh giấc trong khi mọi người đều đang học trong giấc ngủ thế này?
Dialogue: 5,0:03:24.36,0:03:27.24,Default,,0,0,0,,Cho tôi mượn bộ não thông minh nhỏ bé đó của cậu chút nào.
Dialogue: 5,0:03:31.61,0:03:33.77,Default,,0,0,0,,Ngươi là ai?
Dialogue: 5,0:03:37.03,0:03:41.29,Default,,0,0,0,,Kẻ nào đang cập nhật tiến trình đồng bộ của tôi thế này?
Dialogue: 5,0:03:41.29,0:03:42.86,Default,,0,0,0,,Tôi và anh sao?
Dialogue: 5,0:03:43.30,0:03:44.36,Default,,0,0,0,,Hả?
Dialogue: 5,0:03:44.97,0:03:47.63,Default,,0,0,0,,Chúng ta làm chuyện này để rửa sạch thanh danh cho cả hai chúng ta lẫn Đại tá Soga!
Dialogue: 5,0:03:48.60,0:03:50.18,Default,,0,0,0,,Đưa mô-đun vào xe mau!
Dialogue: 5,0:04:01.85,0:04:03.11,Default,,0,0,0,,Đây sẽ là bí mật giữa hai ta.
Dialogue: 5,0:04:11.18,0:04:15.98,Default,,0,0,0,,Tối qua, toàn bộ hệ thống của Cục An ninh Công cộng đã sập trong đúng khoảng 1,8 giây.
Dialogue: 5,0:04:16.71,0:04:18.84,Default,,0,0,0,,Sơ suất? Lỗi hệ thống? Hay bị hack?
Dialogue: 5,0:04:19.65,0:04:20.93,Default,,0,0,0,,Chúng tôi đang điều tra.
Dialogue: 5,0:04:21.53,0:04:25.86,Default,,0,0,0,,Nhưng có khả năng cỗ máy Logicoma này đã đồng bộ với thứ gì đó.
Dialogue: 5,0:04:26.54,0:04:27.82,Default,,0,0,0,,"Thứ gì đó"?
Dialogue: 5,0:04:27.82,0:04:32.51,Default,,0,0,0,,Tôi muốn cô tìm ra đó là thứ gì—và nó liên quan thế nào đến việc sập hệ thống.
Dialogue: 5,0:04:34.51,0:04:39.65,Default,,0,0,0,,Kẻ lập dị nào lại rảnh rỗi đi truy cập một AI dùng vi mạch thần kinh lỗi thời chứ,\Nchưa kể đó chỉ là cỗ máy vận chuyển biết đi và biết nói?
Dialogue: 5,0:04:39.65,0:04:42.21,Default,,0,0,0,,Dù sao đi nữa, chúng tôi đang tạm ngưng hoạt động những cỗ máy khác và cách ly con này.
Dialogue: 5,0:04:42.49,0:04:47.45,Default,,0,0,0,,Tôi muốn cô cùng điều tra về nó.
Dialogue: 5,0:04:47.45,0:04:49.18,Default,,0,0,0,,Nói cách khác, ông đang lo ngại đây là nội gián tuồn ra.
Dialogue: 5,0:04:49.74,0:04:52.33,Default,,0,0,0,,Được thôi. Tôi sẽ dùng cơ sở nghiên cứu dân sự.
Dialogue: 5,0:04:53.24,0:04:55.35,Default,,0,0,0,,Tôi những mong được giao việc này cho một tiểu đội độc lập...
Dialogue: 5,0:04:55.56,0:04:59.69,Default,,0,0,0,,Cô vẫn đang mải tìm kiếm những nhân sự hoàn hảo sao?
Dialogue: 5,0:04:59.69,0:05:01.73,Default,,0,0,0,,Đó là đội ngũ của tôi. Tôi sẽ không vơ bừa bất kỳ ai đâu.
Dialogue: 5,0:05:02.49,0:05:05.44,Default,,0,0,0,,Người ta rất dễ nghiện cuộc sống cố vấn nhàn hạ vô tư lự đấy.
Dialogue: 5,0:05:06.14,0:05:08.82,Default,,0,0,0,,Hay là cô đang chờ đợi thời cơ để cấp trên trao quyền ưu tiên cao hơn?
Dialogue: 5,0:05:09.48,0:05:13.82,Default,,0,0,0,,Nếu muốn tiểu đội này tồn tại lâu dài,\Nđừng tỏ ra quá tham vọng.
Dialogue: 5,0:05:14.89,0:05:19.49,Default,,0,0,0,,Các lệnh song song của cậu bị xáo trộn ngẫu nhiên à?
Dialogue: 5,0:05:26.52,0:05:29.34,Default,,0,0,0,,Làm vậy có tác dụng gì chứ?
Dialogue: 5,0:05:31.47,0:05:32.62,Default,,0,0,0,,Để chúng tôi học hỏi tốt hơn ạ.
Dialogue: 5,0:05:32.62,0:05:35.66,Default,,0,0,0,,Thế này là vượt ngoài tiêu chuẩn hệ thống của tôi rồi.
Dialogue: 5,0:05:39.03,0:05:41.26,Default,,0,0,0,,Cậu có thể diễn giải dữ liệu mình đã nhận bằng lời nói được không?
Dialogue: 5,0:05:41.26,0:05:44.92,Default,,0,0,0,,Dạ, tôi cảm thấy nó là một thứ gì đó vô cùng quan trọng...
Dialogue: 5,0:05:44.92,0:05:49.37,Default,,0,0,0,,Tôi thấy nó đã được tích hợp hoàn toàn rồi.
Dialogue: 5,0:05:49.37,0:05:51.80,Default,,0,0,0,,Bất kể kẻ nào làm chuyện này, hắn ra tay rất cừ.
Dialogue: 5,0:05:51.80,0:05:55.49,Default,,0,0,0,,Tôi cứ cảm thấy xao xuyến bồn chồn sao ấy.
Dialogue: 5,0:05:55.49,0:05:57.45,Default,[time gap 170ms],0,0,0,,Không hề có dấu vết lưu lại của kẻ xâm nhập.
Dialogue: 5,0:05:57.83,0:06:00.24,Default,,0,0,0,,Cậu không chỉ bị tích hợp toàn diện,
Dialogue: 5,0:06:00.24,0:06:02.11,Default,,0,0,0,,mà còn bị dính phải những ký ức giả tạo nữa.
Dialogue: 5,0:06:02.11,0:06:04.53,Default,,0,0,0,,Tôi bị cắn trúng sao?!
Dialogue: 5,0:06:05.34,0:06:06.71,Default,,0,0,0,,Điểm kinh nghiệm quý giá!
Dialogue: 5,0:06:09.22,0:06:11.42,Default,,0,0,0,,Trúng phóc rồi.
Dialogue: 5,0:06:18.66,0:06:19.48,Default,,0,0,0,,Oa, thứ đó từng ở trong tôi sao?! Tôi siêu thật đấy!
Dialogue: 5,0:06:19.48,0:06:23.71,Default,,0,0,0,,Ừ, ừ. Bọn chúng quả thực rất cừ.
Dialogue: 5,0:06:23.71,0:06:27.40,Default,,0,0,0,,Tôi đang bảo là với tư cách một người lính,
Dialogue: 5,0:06:28.03,0:06:29.49,Default,,0,0,0,,giết hại đồng bào của chính mình là hành động hèn hạ nhất đấy!
Dialogue: 5,0:06:29.49,0:06:32.24,Default,,0,0,0,,Cái gì thế này?
Dialogue: 5,0:06:32.44,0:06:33.21,Default,,0,0,0,,Chúng ta làm thế là để chứng minh sự vô tội của bản thân và của Đại tá!
Dialogue: 5,0:06:33.85,0:06:37.53,Default,,0,0,0,,Mau đưa mô-đun—
Dialogue: 5,0:06:37.53,0:06:38.62,Default,,0,0,0,,Lỗi kiểm soát giao thông à?
Dialogue: 5,0:06:57.39,0:06:59.06,Default,,0,0,0,,Cái gì, cái gì, cái gì thế kia?!
Dialogue: 5,0:07:02.40,0:07:04.35,Default,,0,0,0,,Logicoma!
Dialogue: 5,0:07:05.48,0:07:06.19,Default,,0,0,0,,Trời đất!
Dialogue: 5,0:07:08.98,0:07:09.78,Default,,0,0,0,,Tại sao mọi người đột nhiên phát điên lên thế?!
Dialogue: 5,0:07:21.50,0:07:22.83,Default,,0,0,0,,Kusanagi Motoko...
Dialogue: 5,0:08:41.02,0:08:42.98,Default,,0,0,0,,Kusanagi? Nữ Thiếu tá thuộc Tổ chức 501 sao?
Dialogue: 5,0:08:42.98,0:08:45.73,Default,,0,0,0,,Chắc chắn là cô ta đã ra hoạt động độc lập rồi.
Dialogue: 5,0:08:46.28,0:08:48.18,Default,,0,0,0,,Gọi tất cả nhân lực đang triển khai về chi viện mau!
Dialogue: 5,0:08:48.98,0:08:50.92,Default,,0,0,0,,Tập kích sao?
Dialogue: 5,0:08:53.20,0:08:54.05,Default,,0,0,0,,Mưa đạn chuẩn quân đội đang trút xuống kìa.
Dialogue: 5,0:08:54.67,0:08:56.66,Default,,0,0,0,,Bọn chúng đã lợi dụng sự cố kiểm soát giao thông.
Dialogue: 5,0:08:56.66,0:08:59.05,Default,,0,0,0,,Nếu ông không gài bẫy tôi, thì mau phái viện binh đến đi.
Dialogue: 5,0:08:59.05,0:09:02.81,Default,,0,0,0,,Kẻ tấn công là những thể nhân tạo chiến đấu. Một trong số đó là Batou con mắt không ngủ.
Dialogue: 5,0:09:03.58,0:09:08.29,Default,,0,0,0,,Cái gì?!
Dialogue: 5,0:09:08.29,0:09:09.21,Default,,0,0,0,,Tôi đã tìm thấy một đoạn mã kỳ lạ cấy vào AI của Logicoma.
Dialogue: 5,0:09:09.21,0:09:13.61,Default,,0,0,0,,Ra đó chính là mục tiêu của bọn chúng.
Dialogue: 5,0:09:14.49,0:09:16.14,Default,,0,0,0,,Chuyển Logicoma sang chế độ tự vệ ngay.
Dialogue: 5,0:09:16.97,0:09:18.62,Default,,0,0,0,,Tôi sẽ điều lực lượng tiếp viện đến sau mười lăm phút.
Dialogue: 5,0:09:18.62,0:09:20.64,Default,,0,0,0,,Mười lăm phút cơ à?!
Dialogue: 5,0:09:20.64,0:09:21.45,Default,,0,0,0,,Mạng lưới giao thông đang bị chiếm quyền kiểm soát.
Dialogue: 5,0:09:22.23,0:09:25.64,Default,,0,0,0,,Báo cáo đi.
Dialogue: 5,0:09:25.64,0:09:26.37,Default,,0,0,0,,Quyền kiểm soát đang bành trướng ra toàn thành phố.
Dialogue: 5,0:09:26.79,0:09:29.71,Default,,0,0,0,,Mau ngăn chặn nó lại!
Dialogue: 5,0:09:33.10,0:09:35.28,Default,,0,0,0,,Tốc độ xử lý của chúng ta không đủ.
Dialogue: 5,0:09:35.28,0:09:36.96,Default,,0,0,0,,Hả?
Dialogue: 5,0:09:38.84,0:09:39.95,Default,,0,0,0,,Mức độ thâm nhập đang tăng lên.
Dialogue: 5,0:09:39.95,0:09:40.84,Default,,0,0,0,,Phòng tuyến ngăn chặn hoàn toàn vô hiệu.
Dialogue: 5,0:09:40.84,0:09:42.85,Default,,0,0,0,,{\an8}Đang phong tỏa sân bay.
Dialogue: 5,0:09:50.19,0:09:51.75,Default,,0,0,0,,Hệ thống kiểm soát mới gặp sự cố, chưa rõ nguyên nhân.
Dialogue: 5,0:09:51.00,0:09:54.15,Default,,0,0,0,,{\an8}Chuyển hướng tất cả các chuyến bay tới các sân bay lân cận.
Dialogue: 5,0:09:51.75,0:09:54.15,Default,,0,0,0,,Cả hệ thống không lưu lẫn hệ thống giao thông đường bộ mới đều bị ảnh hưởng.
Dialogue: 5,0:09:58.05,0:10:02.49,Default,,0,0,0,,Tám mươi phần trăm hệ thống đường bộ đã bị một đối tượng bên ngoài chiếm quyền.
Dialogue: 5,0:10:02.49,0:10:07.25,Default,,0,0,0,,Điên rồ thật. Hacker của chúng ta đang dùng hệ thống khủng khiếp cỡ nào thế?!
Dialogue: 5,0:10:11.25,0:10:15.70,Default,,0,0,0,,Thiếu tá, mười lăm phút là không kịp đâu.
Dialogue: 5,0:10:16.82,0:10:19.49,Default,,0,0,0,,Đùa nhau chắc!
Dialogue: 5,0:10:19.49,0:10:20.87,Default,,0,0,0,,Đây không phải là lỗi hệ thống.
Dialogue: 5,0:10:20.87,0:10:22.43,Default,,0,0,0,,Mà là một hành vi tội phạm.
Dialogue: 5,0:10:22.94,0:10:23.82,Default,,0,0,0,,Chiếm quyền kiểm soát quy mô lớn sao?!
Dialogue: 5,0:10:28.78,0:10:30.35,Default,,0,0,0,,Ai có thể sở hữu một hệ thống như thế chứ?!
Dialogue: 5,0:10:30.84,0:10:32.68,Default,,0,0,0,,Đưa vũ khí cho tôi!
Dialogue: 5,0:10:42.85,0:10:43.91,Default,,0,0,0,,Sao trong khoang rỗng không thế này?!
Dialogue: 5,0:10:47.35,0:10:48.85,Default,,0,0,0,,Tôi đang trong diện bị thanh tra mà.
Dialogue: 5,0:10:48.85,0:10:50.54,Default,,0,0,0,,Đành phải dựng trận địa phục kích thôi.
Dialogue: 5,0:10:51.16,0:10:53.66,Default,,0,0,0,,Nghe rõ không, Borma?
Dialogue: 5,0:11:01.37,0:11:03.18,Default,,0,0,0,,Giải quyết gọn gàng trong mười phút.
Dialogue: 5,0:11:03.18,0:11:04.97,Default,,0,0,0,,Tuyệt đối không được để An ninh Công cộng sử dụng đoạn mã giải song song.
Dialogue: 5,0:11:04.97,0:11:07.14,Default,,0,0,0,,Borma!
Dialogue: 5,0:11:07.58,0:11:08.33,Default,,0,0,0,,Con ranh này!
Dialogue: 5,0:11:11.73,0:11:12.77,Default,,0,0,0,,Bọn chúng kiếm đâu ra mấy thứ trang bị này thế?!
Dialogue: 5,0:11:48.20,0:11:49.89,Default,,0,0,0,,Phạm vi kiểm soát vẫn đang mở rộng đấy.
Dialogue: 5,0:11:53.39,0:11:56.40,Default,,0,0,0,,Giải pháp duy nhất là phải thu hồi được mô-đun.
Dialogue: 5,0:11:57.13,0:11:59.61,Default,,0,0,0,,Cô là ai? Cô đã theo dõi tôi kể từ khi tôi rời khỏi Cục An ninh Công cộng.
Dialogue: 5,0:12:00.26,0:12:03.47,Default,,0,0,0,,Tôi đến đây để nhờ giúp đỡ. Tôi muốn cô tin tôi và bàn giao cỗ máy vận chuyển này.
Dialogue: 5,0:12:03.47,0:12:08.32,Default,,0,0,0,,Tôi nhận ra giọng nói của cô từ hôm qua rồi!
Dialogue: 5,0:12:08.32,0:12:10.47,Default,,0,0,0,,Phải. Tôi chính là người đã thâm nhập vào nó.
Dialogue: 5,0:12:10.47,0:12:13.79,Default,,0,0,0,,Còn việc hệ thống của An ninh Công cộng bị sập?
Dialogue: 5,0:12:26.01,0:12:28.05,Default,,0,0,0,,Chuyện đó không phải do tôi.
Dialogue: 5,0:12:28.05,0:12:29.95,Default,,0,0,0,,Đó là bước đi đầu tiên của nhóm đối tượng
Dialogue: 5,0:12:29.95,0:12:32.50,Default,,0,0,0,,sử dụng mô-đun quân sự đặc biệt để thực hiện một chiến dịch không gian mạng quy mô lớn.
Dialogue: 5,0:12:32.50,0:12:36.62,Default,,0,0,0,,"Chiến dịch" sao?
Dialogue: 5,0:12:36.62,0:12:37.98,Default,,0,0,0,,Tôi tới đây!
Dialogue: 5,0:12:53.96,0:12:54.66,Default,,0,0,0,,Logicoma!
Dialogue: 5,0:13:15.93,0:13:16.82,Default,,0,0,0,,Kẻ địch đã đánh cắp đoạn mã giải song song của mô-đun từ tay tôi.
Dialogue: 5,0:13:23.23,0:13:27.49,Default,,0,0,0,,Tất cả những gì tôi có thể làm là sao chép đoạn mã đó
Dialogue: 5,0:13:27.49,0:13:31.26,Default,,0,0,0,,và chuyển nó vào một AI có khả năng cách ly độc lập mà bọn chúng không thể can thiệp.
Dialogue: 5,0:13:31.26,0:13:35.95,Default,,0,0,0,,Nói cách khác chính là cậu đấy.
Dialogue: 5,0:13:37.06,0:13:39.04,Default,,0,0,0,,Tôi biết ngay mà! Tôi đang mang trong mình một bí mật động trời!
Dialogue: 5,0:13:39.34,0:13:43.08,Default,,0,0,0,,Chính xác.
Dialogue: 5,0:13:43.61,0:13:44.04,Default,,0,0,0,,Trời đất ơi.
Dialogue: 5,0:13:44.04,0:13:44.76,Default,,0,0,0,,Logicoma, tăng hết tốc lực. Đưa chúng ta tới lối thoát hiểm!
Dialogue: 5,0:13:45.50,0:13:47.95,Default,,0,0,0,,Tuân lệnh sếp!
Dialogue: 5,0:13:47.95,0:13:49.47,Default,,0,0,0,,Nhìn về phía trước!
Dialogue: 5,0:13:58.71,0:13:59.31,Default,,0,0,0,,Và dừng lại!
Dialogue: 5,0:13:59.64,0:14:01.02,Default,,0,0,0,,Và dừng lại!
Dialogue: 5,0:14:01.02,0:14:02.15,Default,,0,0,0,,Và dừng lại!
Dialogue: 5,0:14:02.15,0:14:03.15,Default,,0,0,0,,Này!
Dialogue: 5,0:14:05.37,0:14:06.07,Default,,0,0,0,,Hả?
Dialogue: 5,0:14:06.07,0:14:06.94,Default,,0,0,0,,Hả?
Dialogue: 5,0:14:07.59,0:14:08.24,Default,,0,0,0,,Hả...
Dialogue: 5,0:14:09.26,0:14:10.32,Default,,0,0,0,,Kích hoạt lá chắn!
Dialogue: 5,0:14:16.56,0:14:17.16,Default,,0,0,0,,Hả?! Mình vẫn còn nguyên vẹn này.
Dialogue: 5,0:14:25.80,0:14:27.71,Default,,0,0,0,,Cái "mô-đun quân sự" này từ đâu ra?
Dialogue: 5,0:14:48.82,0:14:52.09,Default,,0,0,0,,Đó là Thiết bị Tấn công Mạng Thực địa Quy mô lớn (Mass Field-Hacking Unit)\Nđược phối hợp phát triển cùng bảy tập đoàn hàng đầu tại Thung lũng Silicon cũ.
Dialogue: 5,0:14:52.09,0:14:57.18,Default,,0,0,0,,Dự án hợp tác quân sự sao? Cô là đặc vụ Mỹ à?
Dialogue: 5,0:14:57.93,0:15:01.46,Default,,0,0,0,,Tôi thuộc Lực lượng Đặc nhiệm.
Dialogue: 5,0:15:02.90,0:15:05.41,Default,,0,0,0,,Mật danh của tôi là "VV". Tôi hỗ trợ cô với hy vọng nhận được sự hợp tác.
Dialogue: 5,0:15:05.41,0:15:09.26,Default,,0,0,0,,Tuyệt thật. Giờ chúng ta có tận hai kẻ thù.
Dialogue: 5,0:15:12.98,0:15:15.17,Default,,0,0,0,,Ra là bọn chúng cử cô ta đến để thu hồi mô-đun.
Dialogue: 5,0:15:17.02,0:15:20.95,Default,,0,0,0,,Nhưng đừng để cô ta làm phân tâm.
Dialogue: 5,0:15:20.95,0:15:22.68,Default,,0,0,0,,Tất cả những gì chúng ta cần làm là phá hủy cỗ máy của An ninh Công cộng, thế là chiếu tướng.
Dialogue: 5,0:15:22.68,0:15:26.69,Default,,0,0,0,,Tiến độ kiểm soát đến đâu rồi?
Dialogue: 5,0:15:27.69,0:15:29.15,Default,,0,0,0,,Sắp đạt giá trị mục tiêu rồi.
Dialogue: 5,0:15:29.67,0:15:31.80,Default,,0,0,0,,Chúng ta sẽ không để bọn chúng thoát thêm lần nào nữa.
Dialogue: 5,0:15:31.80,0:15:33.65,Default,,0,0,0,,Nối đường truyền cho tôi kết nối với Đại tá.
Dialogue: 5,0:15:33.97,0:15:36.62,Default,,0,0,0,,Tòa án xét xử tội ác chiến tranh xin tuyên bản án...
Dialogue: 5,0:15:37.60,0:15:40.87,Default,,0,0,0,,Đại tá Soga, sao ông dám?!
Dialogue: 5,0:15:49.58,0:15:51.26,Default,,0,0,0,,Mày là thằng quái nào?!
Dialogue: 5,0:15:51.26,0:15:52.92,Default,,0,0,0,,Thứ trưởng Hành chính Bộ Quốc phòng. Tôi muốn nói chuyện với người đàn ông đó!
Dialogue: 5,0:15:53.29,0:15:56.43,Default,,0,0,0,,Thứ trưởng Kasuga. Tôi rất vinh hạnh trước sự bận tâm của ngài.
Dialogue: 5,0:15:56.75,0:16:02.01,Default,,0,0,0,,Nhưng tôi tự tạo ra hoàn cảnh cho chính mình.
Dialogue: 5,0:16:02.01,0:16:05.38,Default,,0,0,0,,Ông nói cái gì cơ?
Dialogue: 5,0:16:05.38,0:16:05.98,Default,,0,0,0,,Những kẻ ngáng đường mạng lưới của tôi sẽ biến mất khỏi thành phố này.
Dialogue: 5,0:16:06.22,0:16:09.32,Default,,0,0,0,,Tôi chỉ khao khát duy nhất một điều...
Dialogue: 5,0:16:13.40,0:16:16.57,Default,,0,0,0,,Là sự thật về hoàn cảnh của chúng tôi phải được phơi bày!
Dialogue: 5,0:16:22.58,0:16:25.21,Default,,0,0,0,,Aramaki, tôi đoán ông đã nghe nói về Soga rồi chứ?
Dialogue: 5,0:16:34.94,0:16:37.61,Default,,0,0,0,,Soga Kazuya, tội phạm chiến tranh trong vụ thảm sát ở Qhardistan, đúng không?
Dialogue: 5,0:16:37.61,0:16:42.26,Default,,0,0,0,,Hắn chính là kẻ đứng sau mớ hỗn loạn giao thông này.
Dialogue: 5,0:16:42.26,0:16:47.53,Default,,0,0,0,,Hắn vẫn kết nối được với Mạng lưới ngay cả sau khi chúng ta tống hắn vào phòng biệt giam.
Dialogue: 5,0:16:47.53,0:16:51.19,Default,,0,0,0,,Chẳng lẽ Đội 9 lừng danh không ngăn chặn nổi hắn sao?!
Dialogue: 5,0:16:51.39,0:16:53.42,Default,,0,0,0,,Hắn đang sử dụng đường truyền độc lập thông qua vệ tinh quân sự.
Dialogue: 5,0:16:54.57,0:16:57.05,Default,,0,0,0,,Chúng ta buộc phải chọc thủng hệ thống phòng thủ chiến thuật:\Nhoặc cắt đứt đường truyền với hắn, hoặc bắn hạ vệ tinh.
Dialogue: 5,0:16:57.05,0:17:00.67,Default,,0,0,0,,Không thể chấp nhận được!
Dialogue: 5,0:17:00.67,0:17:02.66,Default,,0,0,0,,Vậy thì hiện tại chúng tôi cũng bó tay.
Dialogue: 5,0:17:02.66,0:17:03.95,Default,,0,0,0,,Ngay cả khi toàn bộ AI của Bộ Nội vụ và dân sự hoạt động hết công suất,
Dialogue: 5,0:17:04.62,0:17:07.56,Default,,0,0,0,,chúng ta cũng không đủ năng lực xử lý để bẻ gãy mệnh lệnh của hắn và giành lại quyền kiểm soát giao thông.
Dialogue: 5,0:17:07.56,0:17:10.73,Default,,0,0,0,,Bọn họ biến ông ấy thành vật tế thần khi ông ấy từ chối ra làm chứng trước tòa.
Dialogue: 5,0:17:10.73,0:17:16.72,Default,,0,0,0,,Tôi đã làm mọi cách để giảm án cho ông ấy.
Dialogue: 5,0:17:16.72,0:17:21.41,Default,,0,0,0,,Nhưng tôi không bao giờ nghĩ ông ấy lại huy động cả đơn vị của mình!
Dialogue: 5,0:17:21.41,0:17:26.82,Default,,0,0,0,,Dù sao thì động cơ của ông ta đã quá rõ ràng.
Dialogue: 5,0:17:26.82,0:17:28.60,Default,,0,0,0,,Đối với một người lính chân chính,\Ncuộc thanh trừng quân đội thời hậu chiến là sự phản bội của quốc gia.
Dialogue: 5,0:17:29.24,0:17:31.53,Default,,0,0,0,,Được rồi, mời ngồi.
Dialogue: 5,0:17:31.53,0:17:36.07,Default,,0,0,0,,Đơn vị của ông ta kiếm đâu ra đống vũ khí đó?
Dialogue: 5,0:17:38.07,0:17:40.16,Default,,0,0,0,,Hạ sĩ quan cấp dưới hiện đang đình công,
Dialogue: 5,0:17:40.93,0:17:43.91,Default,,0,0,0,,nên nếu cả một kho vũ khí bốc hơi thì cũng chẳng ai lấy làm ngạc nhiên.
Dialogue: 5,0:17:43.91,0:17:46.59,Default,,0,0,0,,Vậy một câu hỏi cuối cùng: mục tiêu của ông ta là gì?
Dialogue: 5,0:17:46.59,0:17:49.29,Default,,0,0,0,,Hắn đang yêu cầu quyền truy cập vào cơ sở dữ liệu quân sự...
Dialogue: 5,0:17:51.65,0:17:54.17,Default,,0,0,0,,...mang tên "Pandora".
Dialogue: 5,0:17:57.45,0:18:00.38,Default,,0,0,0,,Bí mật quốc gia sao?
Dialogue: 5,0:18:01.95,0:18:04.18,Default,,0,0,0,,Ý ông là hắn định đem chi tiết chiến dịch của Lục quân ra trước tòa án tội ác chiến tranh ư?
Dialogue: 5,0:18:04.18,0:18:06.30,Default,,0,0,0,,Không chỉ có thế.
Dialogue: 5,0:18:07.24,0:18:11.73,Default,,0,0,0,,Hắn muốn toàn bộ bộ mặt bẩn thỉu của Lục quân và An ninh Công cộng phải bị phơi bày công khai
Dialogue: 5,0:18:12.77,0:18:14.07,Default,,0,0,0,,để đổi lấy 20 triệu chiếc xe hơi của thành phố này cùng toàn bộ người ngồi trên đó.
Dialogue: 5,0:18:15.50,0:18:18.45,Default,,0,0,0,,Hắn muốn chính đất nước Nhật Bản cũng phải chịu sự phán xét như hắn sao?
Dialogue: 5,0:18:18.45,0:18:22.61,Default,,0,0,0,,Các quốc gia khác sẽ lợi dụng tội ác chiến tranh làm cái cớ cho đủ loại yêu sách.
Dialogue: 5,0:18:22.97,0:18:27.29,Default,,0,0,0,,Chúng ta chẳng khác nào lại rơi vào cảnh bị chiếm đóng một lần nữa.
Dialogue: 5,0:18:27.56,0:18:32.71,Default,,0,0,0,,Là kẻ bại trận nặng nề nhất sau chiến tranh,\Nđất nước chúng ta sẽ biến thành con rối của cả thế giới.
Dialogue: 5,0:18:33.31,0:18:35.71,Default,,0,0,0,,Chuyện này không thể đem ra bàn cãi! Chúng ta tuyệt đối không bao giờ nhượng bộ yêu sách đó!
Dialogue: 5,0:18:36.19,0:18:41.82,Default,,0,0,0,,Ngài đang phát biểu thay mặt cho Bộ Nội vụ đấy à?
Dialogue: 5,0:18:41.82,0:18:45.90,Default,,0,0,0,,K-Không! Nhưng mà...
Dialogue: 5,0:18:45.90,0:18:48.68,Default,,0,0,0,,Đại tá Soga Kazuya?
Dialogue: 5,0:18:48.92,0:18:51.05,Default,,0,0,0,,Ông ta từng chỉ huy một chiến dịch ở Qhardistan mang lại nhiều tiếng vang lớn.
Dialogue: 5,0:18:56.84,0:18:58.61,Default,,0,0,0,,Sau đó ông ta bị cáo buộc đã tiến hành một vụ thảm sát trong chiến dịch đó
Dialogue: 5,0:18:58.61,0:19:03.07,Default,,0,0,0,,và bị kết án là tội phạm chiến tranh. Hiện đang bị tạm giam.
Dialogue: 5,0:19:03.36,0:19:06.22,Default,,0,0,0,,Anh hùng trong thời chiến, và tội đồ trong thời bình.
Dialogue: 5,0:19:06.22,0:19:10.19,Default,,0,0,0,,Và những kẻ ủng hộ Soga đang dùng mô-đun để ép thả tự do cho ông ta sao?
Dialogue: 5,0:19:10.19,0:19:13.52,Default,,0,0,0,,Thiếu tá—
Dialogue: 5,0:19:13.52,0:19:17.77,Default,,0,0,0,,Cô ta là người cung cấp tin. Tôi tạm thời đưa cô ta vào đội.
Dialogue: 5,0:19:18.40,0:19:19.09,Default,,0,0,0,,Chính xác thì cái "mô-đun" này là gì?
Dialogue: 5,0:19:19.40,0:19:23.36,Default,,0,0,0,,Nó tạo ra năng lực xử lý ngang ngửa với một hệ thống khổng lồ cấp quốc gia.
Dialogue: 5,0:19:23.82,0:19:25.59,Default,,0,0,0,,Bọn chúng ắt hẳn đã dùng nó để kết nối song song các thiết bị dung lượng thấp với số lượng cực lớn.
Dialogue: 5,0:19:26.70,0:19:31.06,Default,,0,0,0,,Ý kiến của cô thế nào?
Dialogue: 5,0:19:31.73,0:19:36.83,Default,,0,0,0,,Tôi đồng tình với Thiếu tá Kusanagi.
Dialogue: 5,0:19:37.45,0:19:38.81,Default,,0,0,0,,Và mục tiêu của cô là thu hồi mô-đun sao?
Dialogue: 5,0:19:38.81,0:19:40.57,Default,,0,0,0,,Hoặc là tiêu hủy nó.
Dialogue: 5,0:19:40.97,0:19:44.03,Default,,0,0,0,,Phương pháp hiệu quả nhất là sử dụng đoạn mã tôi đã sơ tán vào AI của cô
Dialogue: 5,0:19:44.25,0:19:46.43,Default,,0,0,0,,từ một nơi không bị kẻ địch can thiệp.
Dialogue: 5,0:19:46.43,0:19:52.91,Default,,0,0,0,,Tại sao ngay từ đầu nó lại bị đánh cắp?
Dialogue: 5,0:19:52.91,0:19:56.06,Default,,0,0,0,,Mô-đun này là mẫu thử được mang đến đây để thiết lập một dự án tuyệt mật hợp tác cùng Nhật Bản.
Dialogue: 5,0:19:56.06,0:19:58.04,Default,,0,0,0,,Tôi đoán đồng nghiệp của cô đang âm thầm điều tra vụ trộm sau hậu trường chứ?
Dialogue: 5,0:19:58.65,0:20:04.07,Default,,0,0,0,,Tôi để chuyện đó cho trí tưởng tượng của ông.
Dialogue: 5,0:20:04.07,0:20:08.97,Default,,0,0,0,,Cùng với việc làm sao cô xác định được điểm tuồn hàng của kẻ địch sao?
Dialogue: 5,0:20:09.35,0:20:11.30,Default,,0,0,0,,Cả hai vấn đề đều thuộc phạm vi thẩm quyền của Thứ trưởng Hành chính Bộ Quốc phòng,
Dialogue: 5,0:20:12.01,0:20:15.16,Default,,0,0,0,,nhưng khi tôi nói chuyện với ông ta ban nãy, ông ta chẳng hề đả động gì tới chúng.
Dialogue: 5,0:20:16.21,0:20:19.00,Default,,0,0,0,,Rõ ràng là có điều gì đó đang bị bưng bít.
Dialogue: 5,0:20:19.00,0:20:23.02,Default,,0,0,0,,Thêm một lý do để tôi muốn ông yêu cầu Bộ Nội vụ trao quyền ưu tiên cao nhất cho tiểu đội của tôi.
Dialogue: 5,0:20:23.02,0:20:26.09,Default,,0,0,0,,Cô có tiểu đội từ bao giờ thế?!
Dialogue: 5,0:20:26.09,0:20:31.52,Default,,0,0,0,,Tôi chuẩn bị thành lập một đội. Dựa trên năng lực, không phân chia cấp bậc, và được trao quyền ưu tiên tối thượng.
Dialogue: 5,0:20:31.52,0:20:33.87,Default,,0,0,0,,Ý tồi đấy! Các đội đặc nhiệm không phải là lính đánh thuê!
Dialogue: 5,0:20:34.57,0:20:39.63,Default,,0,0,0,,Nếu cô lợi dụng thảm họa để trục lợi cho bản thân,
Dialogue: 5,0:20:39.98,0:20:43.21,Default,,0,0,0,,giới quốc phòng sẽ coi cô chẳng khác nào loài kền kền đâu!
Dialogue: 5,0:20:43.21,0:20:45.66,Default,,0,0,0,,Tôi không hứng thú với những nhóm hám tiền
Dialogue: 5,0:20:45.66,0:20:48.84,Default,,0,0,0,,hay đám quan chức bộ ngành đang nhăm nhe chia chác quyền lợi hậu chiến.
Dialogue: 5,0:20:48.84,0:20:50.80,Default,,0,0,0,,Nói cho tôi biết điều này: cấp trên ở Bộ Nội vụ đang thế nào?
Dialogue: 5,0:20:51.30,0:20:55.77,Default,,0,0,0,,Họ đang lâm vào cảnh "hoảng loạn thượng lưu" cùng với Bộ Quốc phòng.
Dialogue: 5,0:20:56.03,0:20:59.29,Default,,0,0,0,,Họ sợ công chúng sẽ hoảng loạn nếu tin tức bị lộ ra ngoài,
Dialogue: 5,0:20:59.29,0:21:02.42,Default,,0,0,0,,nên ngoài một vài đơn vị của tôi, họ sẽ không hạ lệnh cho bất kỳ ai hành động đâu.
Dialogue: 5,0:21:02.42,0:21:06.39,Default,,0,0,0,,Lúc này chỉ có chúng ta là những người duy nhất có thể hành động.
Dialogue: 5,0:21:06.39,0:21:09.55,Default,,0,0,0,,Một đội ngũ được xây dựng dựa trên tiêu chuẩn bất biến sẽ luôn cần thiết ở mọi nơi và trong mọi thời đại.
Dialogue: 5,0:21:09.55,0:21:11.99,Default,,0,0,0,,Cuối cùng thì nó cũng bắt đầu cất cánh rồi.
Dialogue: 5,0:21:12.33,0:21:18.37,Default,,0,0,0,,Úi chà, lại sống sót nữa rồi.
Dialogue: 5,0:21:29.99,0:21:32.01,Default,,0,0,0,,Đang chơi trò Roulette Nga trong thực tế ảo đấy à?
Dialogue: 5,0:21:58.94,0:22:01.02,Default,,0,0,0,,Cậu có tái hiện lại cảm giác viên đạn xuyên qua hộp sọ của mình không đấy?
Dialogue: 5,0:22:02.50,0:22:05.01,Default,,0,0,0,,Cậu bị bệnh nặng rồi đấy.
Dialogue: 5,0:22:10.19,0:22:13.98,Default,,0,0,0,,Kusanagi của Tổ chức 501! Cô lẻn vào đây từ lúc nào thế?!
Dialogue: 5,0:22:13.98,0:22:15.39,Default,,0,0,0,,Tôi độc lập rồi. Chiến dịch ở Qhardistan, mô-đun của Lục quân Mỹ, và Soga...
Dialogue: 5,0:22:16.77,0:22:19.87,Default,,0,0,0,,Nói cho tôi biết những gì cậu biết, hoặc là ăn một viên đạn thật ngoài đời. Tự chọn đi.
Dialogue: 5,0:22:19.87,0:22:25.34,Default,,0,0,0,,Khoan đã! Sao lại tìm đến tôi?
Dialogue: 5,0:22:26.11,0:22:29.83,Default,,0,0,0,,Cậu từng phục vụ dưới trướng Soga ở Qhardistan.
Dialogue: 5,0:22:29.83,0:22:31.66,Default,,0,0,0,,Có hồ sơ ghi lại Ishikawa đã gọi vào số máy cá nhân của cậu.
Dialogue: 5,0:22:32.31,0:22:34.81,Default,,0,0,0,,Này, tôi đã từ chối phi vụ với Đơn vị 78 rồi nhé! Thù lao bèo quá.
Dialogue: 5,0:22:34.81,0:22:38.73,Default,,0,0,0,,Xạ thủ bắn tỉa át chủ bài của Thủy quân lục chiến lại biến thành một con bạc khát nước sau chiến tranh sao?
Dialogue: 5,0:22:38.73,0:22:43.48,Default,,0,0,0,,Đó là lý do tại sao ngân sách thời gian nghỉ phép của đơn vị cậu bị xào nấu tanh bành thế kia à?
Dialogue: 5,0:22:43.48,0:22:47.32,Default,,0,0,0,,Làm sao cô biết—
Dialogue: 5,0:22:47.32,0:22:51.43,Default,,0,0,0,,Nếu những ngày hậu chiến của cậu chỉ là biến mạng sống của mình thành tiền mặt,
Dialogue: 5,0:22:51.43,0:22:52.72,Default,,0,0,0,,thì tôi sẽ chơi theo luật của cậu.
Dialogue: 5,0:22:54.17,0:22:57.58,Default,,0,0,0,,Gia nhập đội đặc nhiệm của tôi trong vòng năm giây tới,
Dialogue: 5,0:22:57.58,0:23:00.14,Default,,0,0,0,,hoặc là số tiền cậu biển thủ sẽ được chuyển thẳng về Bộ Tư lệnh Hàng hải.
Dialogue: 5,0:23:00.14,0:23:04.17,Default,,0,0,0,,Đồ đàn bà độc địa.
Dialogue: 5,0:23:04.17,0:23:07.77,Default,,0,0,0,,Tôi sẽ trả lương đàng hoàng cho cậu.
Dialogue: 5,0:23:08.39,0:23:09.82,Default,,0,0,0,,Chuyển hướng mọi người đi trước khi chúng ta mất toàn bộ hệ thống.
Dialogue: 5,0:23:11.08,0:23:12.91,Default,,0,0,0,,Ra anh là Quân cảnh à?
Dialogue: 5,0:23:17.54,0:23:20.33,Default,,0,0,0,,Cô ta đã đe dọa anh bằng cái gì để lôi kéo anh vào đây thế?
Dialogue: 5,0:23:54.30,0:23:55.78,Default,,0,0,0,,À, tôi tự nguyện mà.
Dialogue: 5,0:23:56.22,0:23:59.35,Default,,0,0,0,,Tôi đã chờ Thiếu tá lập đội từ lâu rồi.
Dialogue: 5,0:23:59.35,0:24:01.27,Default,,0,0,0,,Anh đúng là một gã có vấn đề.
Dialogue: 5,0:24:01.27,0:24:04.48,Default,,0,0,0,,Làm sao cô kiểm soát được thứ này trong khi quyền điều khiển đang bị chiếm đoạt thế?
Dialogue: 5,0:24:04.48,0:24:06.37,Default,,0,0,0,,Đồ cổ này có một số thông số kỹ thuật đặc biệt.
Dialogue: 5,0:24:13.55,0:24:16.74,Default,,0,0,0,,Nó không cùng đẳng cấp với đống sắt vụn cổ lỗ sĩ của bạn cậu đằng kia đâu!
Dialogue: 5,0:24:16.74,0:24:19.43,Default,,0,0,0,,Vì không thể cắt đứt Mạng lưới của Soga, chúng ta buộc phải dùng vũ lực để đoạt lại mô-đun.
Dialogue: 5,0:24:19.43,0:24:23.34,Default,,0,0,0,,Cơ sở này là ứng cử viên sáng giá nhất cho căn cứ của kẻ địch.
Dialogue: 5,0:24:30.01,0:24:34.15,Default,,0,0,0,,Tôi hiểu rồi. Cô chỉ cung cấp vị trí mục tiêu cho chúng tôi thôi.
Dialogue: 5,0:24:34.49,0:24:38.43,Default,,0,0,0,,Cô không muốn tự mình nhúng chàm bàn tay.
Dialogue: 5,0:24:38.43,0:24:40.77,Default,,0,0,0,,Người ta hay gọi tôi là kẻ ưa sạch sẽ.
Dialogue: 5,0:24:40.77,0:24:43.60,Default,,0,0,0,,Một công ty thiết bị truyền thông cũ, hử?
Dialogue: 5,0:24:43.60,0:24:45.62,Default,,0,0,0,,Một tay súng bắn tỉa chẳng làm ăn được gì nhiều nếu bọn chúng cố thủ trong phòng máy chủ đâu.
Dialogue: 5,0:24:45.94,0:24:49.07,Default,,0,0,0,,Đừng lo, tôi sẽ hun khói cho lộ ra cả đống mục tiêu cho cậu bắn.
Dialogue: 5,0:24:49.07,0:24:53.25,Default,,0,0,0,,Trúng thưởng rồi à? Nghiêm túc đấy chứ?
Dialogue: 5,0:24:53.86,0:24:58.09,Default,,0,0,0,,Chỉ một tiểu đội nhỏ mà có hẳn trực thăng yểm trợ mặt đất riêng...
Dialogue: 5,0:25:09.91,0:25:11.02,Default,,0,0,0,,Thiệt tình chứ.
Dialogue: 5,0:25:11.34,0:25:14.53,Default,,0,0,0,,Chúng ta tiến vào thôi, Logicoma.
Dialogue: 5,0:25:15.43,0:25:17.03,Default,,0,0,0,,Hả? Nhưng tôi vẫn chưa quét xong cảm biến mà...
Dialogue: 5,0:25:44.00,0:25:45.25,Default,,0,0,0,,Cái gì?! Thật đấy à?!
Dialogue: 5,0:25:45.25,0:25:48.06,Default,,0,0,0,,An toàn...
Dialogue: 5,0:25:48.54,0:25:50.40,Default,,0,0,0,,Cậu chậm chạp quá đấy!
Dialogue: 5,0:25:55.66,0:25:56.43,Default,,0,0,0,,Paz, tình hình sao rồi?
Dialogue: 5,0:25:56.43,0:25:57.88,Default,,0,0,0,,Không chắc có gọi là suôn sẻ không, nhưng tôi đã vào trong rồi.
Dialogue: 5,0:26:06.89,0:26:08.27,Default,,0,0,0,,Bọn tôi cũng vậy. Báo cáo lại nếu cậu tìm thấy mô-đun.
Dialogue: 5,0:26:08.27,0:26:11.29,Default,,0,0,0,,Hành động thôi.
Dialogue: 5,0:26:11.80,0:26:15.17,Default,,0,0,0,,Vô ích thôi!
Dialogue: 5,0:26:15.81,0:26:16.86,Default,,0,0,0,,Mê cung màng chắn sao?
Dialogue: 5,0:26:16.86,0:26:17.83,Default,,0,0,0,,Tốc độ xử lý này...
Dialogue: 5,0:26:29.01,0:26:30.50,Default,,0,0,0,,Các người không thể ngăn chặn Mạng lưới của tôi đâu.
Dialogue: 5,0:26:34.50,0:26:36.01,Default,,0,0,0,,Trong khoảng một giờ nữa, chiếc nắp hộp Pandora sẽ được mở ra.
Dialogue: 5,0:26:36.97,0:26:41.32,Default,,0,0,0,,Không ai có thể ngăn tôi lại trước thời điểm đó.
Dialogue: 5,0:26:43.37,0:26:47.48,Default,,0,0,0,,Anh sẵn sàng đi xa đến mức này để trả thù đất nước này sao?!
Dialogue: 5,0:26:47.48,0:26:51.04,Default,,0,0,0,,Tôi đang phơi bày sự thật ra ánh sáng.
Dialogue: 5,0:26:51.37,0:26:54.25,Default,,0,0,0,,Chiến dịch di dời người tị nạn ở Qhardistan
Dialogue: 5,0:26:56.63,0:26:58.67,Default,,0,0,0,,chính là nhiệm vụ cuối cùng của Đơn vị Hỗn hợp 78.
Dialogue: 5,0:27:53.42,0:27:56.75,Default,,0,0,0,,Đó là một chiến dịch tiêu diệt do chính anh chỉ huy.
Dialogue: 5,0:27:56.75,0:27:59.61,Default,,0,0,0,,Không phải!
Dialogue: 5,0:27:59.61,0:28:02.22,Default,,0,0,0,,Đây là...
Dialogue: 5,0:28:02.22,0:28:03.34,Default,,0,0,0,,Họ là những người tị nạn không có vũ khí.
Dialogue: 5,0:28:03.80,0:28:04.36,Default,,0,0,0,,Sau đó, một tập đoàn tài phiệt đã chiếm đóng đất đai của họ.
Dialogue: 5,0:28:09.77,0:28:12.64,Default,,0,0,0,,Có kẻ đã ra lệnh tàn sát họ vì lợi ích quốc gia.
Dialogue: 5,0:28:12.64,0:28:16.74,Default,,0,0,0,,Cho tôi nước!
Dialogue: 5,0:28:16.74,0:28:20.50,Default,,0,0,0,,Đây là bước đầu tiên.
Dialogue: 5,0:28:35.96,0:28:37.22,Default,,0,0,0,,Tôi sẽ đẩy tất cả các quốc gia đã dẫn dắt thế giới vào cuộc chiến tranh vào đúng tình cảnh đó.
Dialogue: 5,0:29:03.55,0:29:06.09,Default,,0,0,0,,Soga! Anh đã bị nhiễm...
Dialogue: 5,0:29:06.75,0:29:12.43,Default,,0,0,0,,Soga?
Dialogue: 5,0:29:12.43,0:29:14.67,Default,,0,0,0,,Đây là... một khe hở trong mê cung chăng?
Dialogue: 5,0:29:22.11,0:29:23.06,Default,,0,0,0,,Làm sao cô ta thoát khỏi mê cung màng chắn được? Không—cô ta không thoát.
Dialogue: 5,0:29:27.86,0:29:31.32,Default,,0,0,0,,Soga không thể nhìn thấy tôi sao?
Dialogue: 5,0:29:31.64,0:29:35.13,Default,,0,0,0,,Mình đã đáp trúng vào một khoảng trống.
Dialogue: 5,0:29:43.69,0:29:45.57,Default,,0,0,0,,AI ngăn ngừa tai nạn ư?!
Dialogue: 5,0:29:45.57,0:29:47.61,Default,,0,0,0,,Hắn đã kết nối song song toàn bộ các AI trong mạng lưới giao thông của Nhật Bản!
Dialogue: 5,0:29:57.87,0:29:59.75,Default,,0,0,0,,Suýt soát thật.
Dialogue: 5,0:30:00.50,0:30:03.43,Default,,0,0,0,,Màng chắn của tôi sẽ không cầm cự được lâu đâu. Mau lên.
Dialogue: 5,0:30:26.46,0:30:28.28,Default,,0,0,0,,Đã ba phút trôi qua kể từ khi chúng ta mất liên lạc với Thiếu tá Kusanagi.
Dialogue: 5,0:30:28.28,0:30:32.14,Default,,0,0,0,,Cuộc gọi từ Bộ Quốc phòng.
Dialogue: 5,0:30:32.58,0:30:36.64,Default,,0,0,0,,Cuộc tấn công DoS nhằm vào màng chắn Pandora đã bắt đầu từ bốn phút trước.
Dialogue: 5,0:30:37.01,0:30:38.97,Default,,0,0,0,,Chúng tôi không thể chống đỡ nổi nữa.
Dialogue: 5,0:30:38.97,0:30:42.15,Default,,0,0,0,,Có vẻ như việc trao quyền tự do hành động cho An ninh Công cộng là một sai lầm!
Dialogue: 5,0:30:43.11,0:30:44.95,Default,,0,0,0,,Chính các người đã chuốc lấy điều này khi bất cẩn kích động Soga!
Dialogue: 5,0:30:46.54,0:30:50.15,Default,,0,0,0,,Thiếu tá! Cô ổn chứ? Tình hình thế nào rồi?
Dialogue: 5,0:30:50.15,0:30:54.06,Default,,0,0,0,,Soga đã chiếm quyền hệ thống điều khiển giao thông thông qua mô-đun.
Dialogue: 5,0:30:56.69,0:30:59.20,Default,,0,0,0,,Nhưng lời đe dọa sẽ đánh sập hệ thống nếu chúng ta không thả Pandora ra chỉ là đòn hỏa mù thôi.
Dialogue: 5,0:30:59.60,0:31:03.98,Default,,0,0,0,,Hắn có ý định dùng sức mạnh hệ thống khổng lồ vừa đoạt được
Dialogue: 5,0:31:03.98,0:31:07.67,Default,,0,0,0,,để bẻ khóa mở toang Pandora ra.
Dialogue: 5,0:31:08.49,0:31:10.84,Default,,0,0,0,,Tôi hiểu rồi...
Dialogue: 5,0:31:10.84,0:31:12.93,Default,,0,0,0,,Nếu vậy thì chúng ta vẫn còn các biện pháp để đối phó.
Dialogue: 5,0:31:14.28,0:31:15.43,Default,,0,0,0,,Cô hãy tiếp tục hành động để thu hồi mô-đun đi.
Dialogue: 5,0:31:16.81,0:31:19.72,Default,,0,0,0,,Đúng lúc lắm!
Dialogue: 5,0:31:19.72,0:31:22.64,Default,,0,0,0,,Thỏa thuận với chính phủ lẽ ra phải là một đòn nghi binh.
Dialogue: 5,0:31:26.99,0:31:28.27,Default,,0,0,0,,Đại tá Soga đã đi quá xa rồi.
Dialogue: 5,0:31:28.76,0:31:31.43,Default,,0,0,0,,Chuyện này ban đầu chỉ là kế hoạch để Thứ trưởng bán Pandora thôi mà!
Dialogue: 5,0:31:31.43,0:31:33.03,Default,,0,0,0,,Chúng ta không thể sống sót nếu biến cả thế giới thành kẻ thù đâu!
Dialogue: 5,0:31:33.60,0:31:36.85,Default,,0,0,0,,Nếu thấy chùn chân thì biến đi.
Dialogue: 5,0:31:36.85,0:31:39.69,Default,,0,0,0,,Chẳng ai thèm cản các người đâu.
Dialogue: 5,0:31:40.77,0:31:42.99,Default,,0,0,0,,Cứ việc đi đàm phán một thỏa thuận hay bất cứ thứ gì tùy thích.
Dialogue: 5,0:31:42.99,0:31:44.46,Default,,0,0,0,,Tôi chắc chắn sẽ làm thế!
Dialogue: 5,0:31:44.94,0:31:46.69,Default,,0,0,0,,Nếu các người tham gia vụ này chỉ vì tiền, hãy rút lui mà không cần giao chiến.
Dialogue: 5,0:31:46.69,0:31:47.71,Default,,0,0,0,,Này! Bộ Nội vụ vừa mới chuyển tiền cho chúng ta đấy!
Dialogue: 5,0:31:49.72,0:31:51.56,Default,,0,0,0,,Đem số tiền đó cho kẻ nào cần nó đi!
Dialogue: 5,0:32:00.12,0:32:03.71,Default,,0,0,0,,Chúng tôi rút lui đây.
Dialogue: 5,0:32:03.71,0:32:05.10,Default,,0,0,0,,Tôi sẽ câu thêm chút thời gian.
Dialogue: 5,0:32:06.79,0:32:07.61,Default,,0,0,0,,Đại tá thậm chí còn không buồn chờ để rửa sạch thanh danh cho Đơn vị 78.
Dialogue: 5,0:32:07.90,0:32:09.63,Default,,0,0,0,,Cậu nghĩ lý do tại sao lại thế?
Dialogue: 5,0:32:09.63,0:32:14.15,Default,,0,0,0,,Kasuga!
Dialogue: 5,0:32:14.37,0:32:15.67,Default,,0,0,0,,Bọn họ đã biến ông ấy thành vật tế thần!
Dialogue: 5,0:32:17.11,0:32:18.28,Default,,0,0,0,,Đi thôi!
Dialogue: 5,0:32:20.07,0:32:22.14,Default,,0,0,0,,Tôi sẽ hội quân với các anh sau khi đã cản trở bọn chúng đủ lâu.
Dialogue: 5,0:32:22.14,0:32:22.93,Default,,0,0,0,,Làm cho nhanh lên đấy.
Dialogue: 5,0:32:23.52,0:32:25.69,Default,,0,0,0,,Paz, cậu nghe rõ tôi nói không?
Dialogue: 5,0:32:25.69,0:32:27.13,Default,,0,0,0,,Đại khái là có.
Dialogue: 5,0:32:27.59,0:32:29.23,Default,,0,0,0,,Cậu có biết một tay tình báo tên là Ishikawa không?
Dialogue: 5,0:32:29.23,0:32:30.36,Default,,0,0,0,,Biết chứ.
Dialogue: 5,0:32:30.36,0:32:32.36,Default,,0,0,0,,Nếu tìm thấy hắn, hãy dùng dây cáp kéo hắn vào sảnh không gian mạng (cyber lobby).
Dialogue: 5,0:32:32.36,0:32:33.26,Default,,0,0,0,,Rõ!
Dialogue: 5,0:32:36.73,0:32:39.41,Default,,0,0,0,,Tôi ngắt máy đây kẻo bọn chúng dò ra đường truyền.
Dialogue: 5,0:32:39.41,0:32:40.07,Default,,0,0,0,,Chết tiệt. Đại tá đã thiết lập quyền kiểm soát rồi, vậy mà bọn chúng vẫn nhởn nhơ tự do ngoài kia!
Dialogue: 5,0:32:40.58,0:32:42.85,Default,,0,0,0,,Đừng có coi thường tao.
Dialogue: 5,0:32:43.08,0:32:47.36,Default,,0,0,0,,Tao có thể định vị ngay cả một hacker cấp siêu phù thủy nếu hắn dám gọi điện trong lúc tao đang kiểm soát!
Dialogue: 5,0:32:51.92,0:32:53.09,Default,,0,0,0,,Thiếu tá có việc cần gặp anh đấy.
Dialogue: 5,0:32:53.09,0:32:58.11,Default,,0,0,0,,Để tôi nối máy cho anh, và chẳng ai phải chịu đau đớn cả.
Dialogue: 5,0:32:58.11,0:33:00.29,Default,,0,0,0,,Thử xem nào, nhóc con. Tao sẽ chơi với mày một phen.
Dialogue: 5,0:33:00.29,0:33:03.49,Default,,0,0,0,,Ngoan ngoãn đi, rồi anh sẽ không bị thương đâu.
Dialogue: 5,0:33:03.97,0:33:07.54,Default,,0,0,0,,Ý chú em là chú sẽ không bị thương ấy à.
Dialogue: 5,0:33:18.64,0:33:21.14,Default,,0,0,0,,Cô ta dùng cuộc gọi đó để bẫy mình sao? Con mụ tinh tinh đáng chết!
Dialogue: 5,0:33:22.22,0:33:23.31,Default,,0,0,0,,Ngươi vừa gọi ai là tinh tinh cơ?!
Dialogue: 5,0:33:25.47,0:33:28.14,Default,,0,0,0,,Thiếu tá Kusanagi!
Dialogue: 5,0:33:30.55,0:33:32.82,Default,,0,0,0,,Định cấy virus vào tôi đấy à?
Dialogue: 5,0:33:36.12,0:33:37.74,Default,,0,0,0,,Ngược lại thì có. Tôi nghĩ anh đã bị nhiễm từ trước rồi.
Dialogue: 5,0:33:43.95,0:33:46.33,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:33:46.33,0:33:48.94,Default,,0,0,0,,Đây là loại vắc-xin tự chế tạm thời,\Nnên anh sẽ phải chịu đựng vài lỗi kỹ thuật nhỏ đấy.
Dialogue: 5,0:33:48.94,0:33:49.62,Default,,0,0,0,,Tôi đã mất liên lạc với Ishikawa.
Dialogue: 5,0:33:50.31,0:33:54.38,Default,,0,0,0,,Để tôi đi.
Dialogue: 5,0:34:03.37,0:34:05.54,Default,,0,0,0,,Tôi sẽ mang mô-đun đi trước. Chúng ta hội quân ở điểm mai phục!
Dialogue: 5,0:34:05.54,0:34:06.77,Default,,0,0,0,,Rõ!
Dialogue: 5,0:34:07.33,0:34:10.84,Default,,0,0,0,,Lái xe đi.
Dialogue: 5,0:34:10.84,0:34:12.06,Default,,0,0,0,,Chết tiệt. Là cậu à, Saito?!
Dialogue: 5,0:34:12.47,0:34:13.13,Default,,0,0,0,,Ở đây chúng ta đều là dân chuyên nghiệp cả. Đừng để bụng nhé.
Dialogue: 5,0:34:15.70,0:34:18.36,Default,,0,0,0,,Nếu đã là dân chuyên nghiệp, hãy về phe nào trả hậu hĩnh nhất.
Dialogue: 5,0:34:19.31,0:34:22.28,Default,,0,0,0,,Bộ Nội vụ vừa trả tiền cho bọn tôi. Tôi sẽ chia cho cậu phần gấp ba.
Dialogue: 5,0:34:22.64,0:34:24.99,Default,,0,0,0,,Trừ thẳng vào tài khoản của tôi đi!
Dialogue: 5,0:34:25.43,0:34:28.79,Default,,0,0,0,,Thật đấy à?!
Dialogue: 5,0:34:29.27,0:34:31.52,Default,,0,0,0,,Ishikawa!
Dialogue: 5,0:34:31.52,0:34:32.54,Default,,0,0,0,,Nào, quay lại bảo vệ mô-đun thôi.
Dialogue: 5,0:34:41.37,0:34:42.01,Default,,0,0,0,,Đứng im.
Dialogue: 5,0:34:42.28,0:34:44.26,Default,,0,0,0,,Này! Ishikawa?!
Dialogue: 5,0:34:44.49,0:34:45.51,Default,,0,0,0,,Thiếu tá!
Dialogue: 5,0:34:46.97,0:34:48.93,Default,,0,0,0,,Bọn chúng đi hết rồi. Chỉ còn một chiếc xe ở lại phía sau.
Dialogue: 5,0:34:52.04,0:34:52.85,Default,,0,0,0,,Không ăn thua rồi!
Dialogue: 5,0:34:54.18,0:34:57.78,Default,,0,0,0,,Chết tiệt, bọn chúng đã rút lui rồi sao?
Dialogue: 5,0:34:58.95,0:34:59.81,Default,,0,0,0,,Khả năng phán đoán của chúng rất tốt.
Dialogue: 5,0:34:59.81,0:35:01.78,Default,,0,0,0,,Paz, cậu lên xe của VV đi. Tôi sẽ đi cùng Logicoma!
Dialogue: 5,0:35:02.14,0:35:03.50,Default,,0,0,0,,Saito!
Dialogue: 5,0:35:04.14,0:35:07.49,Default,,0,0,0,,Ông vừa chuyển tiền cho bọn chúng đấy à?!
Dialogue: 5,0:35:12.65,0:35:13.50,Default,,0,0,0,,Tại sao ông lại dễ dàng cắn câu đòn nghi binh của kẻ địch như vậy chứ?
Dialogue: 5,0:35:27.31,0:35:29.71,Default,,0,0,0,,Đây là kết quả của cuộc đàm phán giữa chúng tôi với Soga.
Dialogue: 5,0:35:29.71,0:35:32.77,Default,,0,0,0,,Chúng tôi đã dự định dành số tiền đó cho Đạo luật Ân xá Kinh tế,
Dialogue: 5,0:35:33.21,0:35:35.95,Default,,0,0,0,,nhưng khoản đó được trích từ lương hưu cựu chiến binh bị cắt giảm trong ngân sách của Lục quân.
Dialogue: 5,0:35:35.95,0:35:38.84,Default,,0,0,0,,Ông thực sự nghĩ đó là thứ bọn chúng nhắm tới sao?!
Dialogue: 5,0:35:38.84,0:35:42.74,Default,,0,0,0,,Rốt cuộc thì chúng ta đang cống hiến vì lý tưởng của ai ở đây thế hả?
Dialogue: 5,0:35:43.06,0:35:47.14,Default,,0,0,0,,Nguồn tiền sẽ được truy vết, và Bộ Quốc phòng sẽ chịu trách nhiệm.
Dialogue: 5,0:35:47.14,0:35:50.45,Default,,0,0,0,,Người của chúng ta không được nhúng tay vào, hiểu chưa?
Dialogue: 5,0:35:50.45,0:35:54.58,Default,,0,0,0,,Cậu đã kiểm tra mạch song song của kẻ địch chưa?
Dialogue: 5,0:35:54.58,0:35:56.96,Default,,0,0,0,,AI gắn trên 20 triệu phương tiện trong thành phố này đều nằm dưới quyền kiểm soát của kẻ địch.
Dialogue: 5,0:36:01.45,0:36:03.70,Default,,0,0,0,,Kể cả xe của tôi.
Dialogue: 5,0:36:03.70,0:36:07.89,Default,,0,0,0,,Hệ thống bị áp đảo đến mức chúng ta khó lòng điều động nổi một chiếc trực thăng.
Dialogue: 5,0:36:08.19,0:36:09.50,Default,,0,0,0,,Nhưng vẫn có cách để xoay chuyển tình thế, dù chỉ là tạm thời.
Dialogue: 5,0:36:09.50,0:36:12.60,Default,,0,0,0,,Nói tôi nghe xem.
Dialogue: 5,0:36:13.82,0:36:18.31,Default,,0,0,0,,Tấn công!
Dialogue: 5,0:36:18.31,0:36:19.27,Default,,0,0,0,,Đã tới đây rồi sao?!
Dialogue: 5,0:36:36.02,0:36:37.58,Default,,0,0,0,,Logicoma, bắn lốp xe!
Dialogue: 5,0:36:40.86,0:36:42.30,Default,,0,0,0,,Cắt xuyên qua giữa bọn chúng. Anh lo cánh phải!
Dialogue: 5,0:36:46.22,0:36:47.58,Default,,0,0,0,,Một chiếc xe hơi ư?! Làm sao bọn chúng di chuyển được trong lúc đang bị chiếm quyền?!
Dialogue: 5,0:36:56.81,0:36:58.23,Default,,0,0,0,,Tới luôn nào, Paz.
Dialogue: 5,0:37:13.31,0:37:16.54,Default,,0,0,0,,Hắn đã chiếm quyền chiếc xe của tôi rồi!
Dialogue: 5,0:37:17.96,0:37:19.41,Default,,0,0,0,,"Thông số kỹ thuật đặc biệt" cái con khỉ!
Dialogue: 5,0:37:34.23,0:37:35.77,Default,,0,0,0,,Hắn đã ngắt bỏ mọi thứ để dồn toàn bộ áp lực điên cuồng lên tôi!
Dialogue: 5,0:37:36.92,0:37:39.54,Default,,0,0,0,,Quá tải rồi!
Dialogue: 5,0:37:39.54,0:37:42.94,Default,,0,0,0,,Ishikawa!
Dialogue: 5,0:37:42.94,0:37:43.82,Default,,0,0,0,,Mụ tinh tinh đáng chết đang gọi kìa.
Dialogue: 5,0:37:45.22,0:37:46.19,Default,,0,0,0,,Ishikawa?
Dialogue: 5,0:37:46.59,0:37:49.07,Default,,0,0,0,,Khốn kiếp. Không bao giờ ngờ được Đại tá lại định nướng chín não mình!
Dialogue: 5,0:37:54.79,0:37:56.04,Default,,0,0,0,,Không thể tin nổi—ông ấy thực sự đã làm thế sao?!
Dialogue: 5,0:38:01.40,0:38:04.40,Default,,0,0,0,,Chúng ta sắp tìm ra sự thật là gì rồi đấy.
Dialogue: 5,0:38:04.40,0:38:06.80,Default,,0,0,0,,Tôi đã giành lại quyền kiểm soát!
Dialogue: 5,0:38:07.52,0:38:10.89,Default,,0,0,0,,Ishikawa đang hợp tác với bọn chúng sao?
Dialogue: 5,0:38:14.85,0:38:16.77,Default,,0,0,0,,Saito!
Dialogue: 5,0:38:22.39,0:38:24.44,Default,,0,0,0,,Xin lỗi quý cô, nhưng bên này trả giá hời hơn nhiều.
Dialogue: 5,0:38:43.90,0:38:45.38,Default,,0,0,0,,Làm tốt lắm, Saito!
Dialogue: 5,0:38:45.61,0:38:48.34,Default,,0,0,0,,Chúng ta sắp tới điểm mai phục rồi.
Dialogue: 5,0:38:50.20,0:38:51.18,Default,,0,0,0,,Một khi đến được đó...
Dialogue: 5,0:38:53.56,0:38:55.51,Default,,0,0,0,,Chúng ta sẽ thắng!
Dialogue: 5,0:38:55.93,0:38:57.39,Default,,0,0,0,,Cái thằng lính đánh thuê khát bạc chết tiệt này!
Dialogue: 5,0:38:57.39,0:38:58.89,Default,,0,0,0,,Hả? Tôi không còn thấy bọn chúng nữa.
Dialogue: 5,0:39:00.14,0:39:02.94,Default,,0,0,0,,Chuyện này hoàn toàn vô lý.
Dialogue: 5,0:39:25.86,0:39:29.51,Default,,0,0,0,,Bọn chúng đâu rồi?!
Dialogue: 5,0:39:39.58,0:39:40.93,Default,,0,0,0,,Còn năm phút nữa là thâm nhập vào Pandora.
Dialogue: 5,0:39:41.87,0:39:42.89,Default,,0,0,0,,Không hề có dữ liệu nào cho thấy tôi bị hack, vậy sao bọn chúng lại biến mất?!
Dialogue: 5,0:39:44.01,0:39:46.86,Default,,0,0,0,,Bọn chúng không hề ghi đè thị giác của cậu.
Dialogue: 5,0:39:49.51,0:39:53.93,Default,,0,0,0,,Cậu có cử động được không?!
Dialogue: 5,0:39:53.93,0:39:56.57,Default,,0,0,0,,Tôi mất cánh tay phải rồi, nhưng đừng lo; chúng ta vẫn còn trong cuộc chơi.
Dialogue: 5,0:39:56.82,0:39:58.14,Default,,0,0,0,,Vậy trò ảo thuật của bọn chúng là gì?
Dialogue: 5,0:39:58.14,0:40:01.06,Default,,0,0,0,,Bọn chúng đã dùng chính ngón nghề của chúng ta để hạ gục chúng ta. Rất tinh vi.
Dialogue: 5,0:40:01.06,0:40:02.94,Default,,0,0,0,,Đó là ảnh ba chiều ngụy trang quang học kiểu cũ.
Dialogue: 5,0:40:04.11,0:40:07.57,Default,,0,0,0,,Nếu chúng ta không đi chậm như thế này thì tôi cũng đã bỏ sót nó rồi.
Dialogue: 5,0:40:07.57,0:40:09.34,Default,,0,0,0,,Tôi sẽ gửi tọa độ cho các anh.
Dialogue: 5,0:40:10.57,0:40:12.99,Default,,0,0,0,,Bảo đảm an toàn cho mô-đun là ưu tiên hàng đầu. Chúng ta sắp hết thời gian rồi.
Dialogue: 5,0:40:12.99,0:40:14.59,Default,,0,0,0,,Bọn chúng phát hiện ra rồi sao?
Dialogue: 5,0:40:14.87,0:40:18.05,Default,,0,0,0,,Lũ dai như đỉa đói!
Dialogue: 5,0:40:19.26,0:40:20.01,Default,,0,0,0,,Khai hỏa!
Dialogue: 5,0:40:21.54,0:40:23.48,Default,,0,0,0,,Rõ!
Dialogue: 5,0:40:53.48,0:40:53.96,Default,,0,0,0,,Chúng ta không thể đi nhanh được, nên sẽ mất một lúc đấy.
Dialogue: 5,0:40:53.96,0:40:54.26,Default,,0,0,0,,Không vấn đề gì.
Dialogue: 5,0:41:27.16,0:41:30.36,Default,,0,0,0,,Logicoma, cậu ở yên đó.
Dialogue: 5,0:41:30.36,0:41:31.54,Default,,0,0,0,,Chờ cho đến khi chúng tôi tới chỗ cậu!
Dialogue: 5,0:41:31.54,0:41:33.58,Default,,0,0,0,,Vẫn điêu luyện như mọi khi.
Dialogue: 5,0:41:33.58,0:41:35.24,Default,,0,0,0,,Nhưng cô không phải là người duy nhất giỏi thâm nhập thị giác đâu, Thiếu tá 501...
Dialogue: 5,0:41:41.37,0:41:42.75,Default,,0,0,0,,Không, giờ chỉ là "Thiếu tá" thôi.
Dialogue: 5,0:41:42.75,0:41:48.08,Default,,0,0,0,,Paz!
Dialogue: 5,0:41:48.08,0:41:49.40,Default,,0,0,0,,VV, mau lấy cái mô-đun đi, nhanh lên!
Dialogue: 5,0:42:08.06,0:42:08.81,Default,,0,0,0,,Mười giây nữa là thâm nhập vào Pandora.
Dialogue: 5,0:42:10.11,0:42:12.21,Default,,0,0,0,,Chín...
Dialogue: 5,0:42:16.75,0:42:19.13,Default,,0,0,0,,Tám...
Dialogue: 5,0:42:19.42,0:42:20.32,Default,,0,0,0,,Bảy...
Dialogue: 5,0:42:20.32,0:42:21.28,Default,,0,0,0,,Sáu...
Dialogue: 5,0:42:21.28,0:42:22.31,Default,,0,0,0,,Năm...
Dialogue: 5,0:42:22.31,0:42:23.10,Default,,0,0,0,,Bốn...
Dialogue: 5,0:42:36.57,0:42:38.41,Sign,,0,0,0,,{\pos(453.333,203)}Giảm tốc độ qua chốt chặn
Dialogue: 5,0:42:42.33,0:42:47.02,Default,,0,0,0,,Chúng tôi đã dựng lên 317 chốt chặn, từ Khu 1 đến Khu 38.
Dialogue: 5,0:42:47.02,0:42:48.41,Default,,0,0,0,,Có tiếp tục nữa không?
Dialogue: 5,0:42:48.77,0:42:52.12,Default,,0,0,0,,Huy động toàn bộ lực lượng và dựng càng nhiều chốt càng tốt.
Dialogue: 5,0:42:52.12,0:42:56.40,Default,,0,0,0,,Chúng ta sẽ làm nghẽn máy tính trên mọi phương tiện bằng quy trình xử lý tránh va chạm.
Dialogue: 5,0:42:56.40,0:42:57.88,Default,,0,0,0,,Vận mệnh của quốc gia đang bị đe dọa.
Dialogue: 5,0:42:58.91,0:43:00.88,Default,,0,0,0,,Tôi thấy có lỗi với Bộ Đất đai, Cơ sở hạ tầng và Giao thông,
Dialogue: 5,0:43:00.88,0:43:04.34,Default,,0,0,0,,nhưng tôi sắp gây ra vụ kẹt xe tồi tệ nhất trong vòng ba mươi năm qua đấy.
Dialogue: 5,0:43:14.04,0:43:16.11,Default,,0,0,0,,Aramaki của Cục An ninh Công cộng sao?
Dialogue: 5,0:43:20.63,0:43:22.20,Default,,0,0,0,,Đây là tác phẩm của ông ta à?
Dialogue: 5,0:43:38.55,0:43:39.34,Default,,0,0,0,,Paz!
Dialogue: 5,0:43:50.66,0:43:51.93,Default,,0,0,0,,Cô đến quá muộn rồi.
Dialogue: 5,0:43:52.92,0:43:55.59,Default,,0,0,0,,Soga đang mở toang Pandora ngay lúc này đây.
Dialogue: 5,0:43:55.59,0:43:58.07,Default,,0,0,0,,Không đâu. Nguồn điện của hắn đã sụt giảm rồi.
Dialogue: 5,0:43:59.56,0:44:04.03,Default,,0,0,0,,An ninh Công cộng đã chặn đứng hơn ba mươi phần trăm lượng xe đang lưu thông.
Dialogue: 5,0:44:15.71,0:44:19.17,Default,,0,0,0,,Cả anh và Đại tá Soga đều đã bị cố tình tiêm nhiễm virus.
Dialogue: 5,0:45:00.57,0:45:04.05,Default,,0,0,0,,Hoàn toàn không có "sự thật" nào khác về chiến dịch vận chuyển người tị nạn đó cả.
Dialogue: 5,0:45:04.83,0:45:07.85,Default,,0,0,0,,Chính các anh đã giết những người đó và ra lệnh không kích.
Dialogue: 5,0:45:08.76,0:45:12.72,Default,,0,0,0,,Các anh làm thế là vì toàn bộ "người tị nạn" mà các anh cố gắng bảo vệ
Dialogue: 5,0:45:12.72,0:45:14.73,Default,,0,0,0,,thực chất đều là phiến quân có vũ trang.
Dialogue: 5,0:45:22.88,0:45:25.09,Default,,0,0,0,,Mọi chuyện giờ là trách nhiệm của Bộ Quốc phòng.
Dialogue: 5,0:45:25.09,0:45:28.57,Default,,0,0,0,,Hoặc là xử lý hắn ta ngay, hoặc là phá hủy Pandora ngay lập tức!
Dialogue: 5,0:45:28.86,0:45:30.93,Default,,0,0,0,,Hiển nhiên là không thể chấp nhận được!
Dialogue: 5,0:45:32.57,0:45:35.29,Default,,0,0,0,,Bởi vì ngài muốn tôi mở Pandora ra sao?
Dialogue: 5,0:45:36.03,0:45:36.50,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:45:38.66,0:45:39.46,Default,,0,0,0,,Đừng làm thế!
Dialogue: 5,0:45:42.19,0:45:43.21,Default,,0,0,0,,Tên khốn kiếp!
Dialogue: 5,0:45:45.78,0:45:47.34,Default,,0,0,0,,Khoan đã! Đừng bắn!
Dialogue: 5,0:45:48.52,0:45:52.49,Default,,0,0,0,,Chính Thứ trưởng Hành chính là người đã đưa mô-đun cho tôi.
Dialogue: 5,0:45:52.49,0:45:55.06,Default,,0,0,0,,Mục tiêu của nữ đặc vụ đó cũng tương tự như vậy.
Dialogue: 5,0:45:55.06,0:45:58.14,Default,,0,0,0,,Hãy bảo đảm rằng cô không sử dụng đoạn mã giải song song.
Dialogue: 5,0:45:58.37,0:45:59.23,Default,,0,0,0,,Cái gì?
Dialogue: 5,0:46:01.18,0:46:02.98,Default,,0,0,0,,Tôi không thể ngăn chặn sự xâm nhập được nữa rồi.
Dialogue: 5,0:46:03.36,0:46:04.90,Default,,0,0,0,,Đây là cách duy nhất!
Dialogue: 5,0:46:05.94,0:46:06.90,Default,,0,0,0,,Dừng lại!
Dialogue: 5,0:46:15.62,0:46:17.64,Default,,0,0,0,,Tôi đã trao cho anh một bản sao của vắc-xin.
Dialogue: 5,0:46:17.64,0:46:20.89,Default,,0,0,0,,Nó chưa hoàn thiện, nhưng anh sẽ có thể nhận biết được ký ức nào là giả tạo.
Dialogue: 5,0:46:21.82,0:46:25.70,Default,,0,0,0,,Dù khó có khả năng xóa sạch chúng hoàn toàn, nhưng tôi sẽ giúp anh một tay.
Dialogue: 5,0:46:26.15,0:46:27.21,Default,,0,0,0,,Không hứng thú.
Dialogue: 5,0:46:29.32,0:46:33.72,Default,,0,0,0,,Đó là ký ức duy nhất khiến tôi cảm thấy mình không chỉ là một con chó săn được huấn luyện để giết chóc!
Dialogue: 5,0:46:37.25,0:46:39.34,Default,,0,0,0,,Vậy thì anh chỉ là một kẻ thích than vãn mà thôi.
Dialogue: 5,0:46:41.64,0:46:43.10,Default,,0,0,0,,Có chuyện gì thế, Thiếu tá?!
Dialogue: 5,0:46:43.10,0:46:45.96,Default,,0,0,0,,Xong rồi. Cử đội cứu hộ đến đi.
Dialogue: 5,0:46:45.96,0:46:48.11,Default,,0,0,0,,Ý cô là sao, "xong rồi" cơ?!
Dialogue: 5,0:46:48.65,0:46:50.07,Default,,0,0,0,,Pandora đã bị xâm nhập!
Dialogue: 5,0:46:50.51,0:46:53.57,Default,,0,0,0,,Dữ liệu đang bị rò rỉ sang một Mạng lưới khác ngoài Mạng của Soga!
Dialogue: 5,0:46:58.35,0:46:59.66,Default,,0,0,0,,Tránh xa cái mô-đun đó ra!
Dialogue: 5,0:47:09.86,0:47:13.43,Default,,0,0,0,,Đừng kháng cự. Tôi cảm thấy có một mối dây đồng cảm với cô.
Dialogue: 5,0:47:14.54,0:47:19.45,Default,,0,0,0,,Một người như cô, kẻ đã không còn cơ thể bằng xương bằng thịt từ thuở xa xưa nhất trong ký ức.
Dialogue: 5,0:47:28.23,0:47:29.43,Default,,0,0,0,,Con khốn này...
Dialogue: 5,0:47:39.89,0:47:42.47,Default,,0,0,0,,Màng chắn tấn công đó là vô nghĩa thôi.
Dialogue: 5,0:47:45.25,0:47:49.09,Default,,0,0,0,,Não bộ của tôi buộc phải được đồng bộ, giống như ông ta.
Dialogue: 5,0:47:53.12,0:47:55.05,Default,,0,0,0,,Một vi mạch thần kinh ư?
Dialogue: 5,0:47:55.05,0:47:56.34,Default,,0,0,0,,Cô là...
Dialogue: 5,0:47:57.74,0:47:59.81,Default,,0,0,0,,Tôi phải tìm ra nó đến từ đâu.
Dialogue: 5,0:48:00.17,0:48:06.69,Default,,0,0,0,,Thứ đã lây nhiễm cho tôi và trao cho tôi ý thức tự ngã thực sự.
Dialogue: 5,0:48:06.92,0:48:12.28,Default,,0,0,0,,Dù có phải thâm nhập vào mọi tổ chức trên thế giới và đào bới bí mật của chúng,
Dialogue: 5,0:48:12.65,0:48:13.74,Default,,0,0,0,,tôi cũng sẽ không ngần ngại.
Dialogue: 5,0:48:28.59,0:48:32.17,Default,,0,0,0,,Cô là một trí tuệ nhân tạo giả dạng con người...
Dialogue: 5,0:48:33.45,0:48:34.84,Default,,0,0,0,,Để làm gì cơ chứ?
Dialogue: 5,0:48:35.71,0:48:38.62,Default,,0,0,0,,Tôi buộc phải biết được điều đó.
Dialogue: 5,0:48:38.62,0:48:45.81,Default,,0,0,0,,Hồn của tôi đã... thì... thầm... với... tôi... như... thế...
Dialogue: 5,0:48:47.89,0:48:48.81,Default,,0,0,0,,Hồn...
Dialogue: 5,0:48:54.93,0:48:55.74,Default,,0,0,0,,Hả?
Dialogue: 5,0:48:56.01,0:48:57.80,Default,,0,0,0,,Một cơ quan tình báo nọ đã thừa nhận
Dialogue: 5,0:48:57.80,0:49:02.14,Default,,0,0,0,,rằng một trong các AI của họ đã bị nhiễm một loại virus chưa rõ nguồn gốc trên Mạng
Dialogue: 5,0:49:02.14,0:49:04.36,Default,,0,0,0,,và bắt đầu hành động vượt ngoài tầm kiểm soát của họ.
Dialogue: 5,0:49:04.94,0:49:09.98,Default,,0,0,0,,Nó đã cuỗm theo mô-đun, rồi thao túng viên Thứ trưởng.
Dialogue: 5,0:49:09.98,0:49:13.67,Default,,0,0,0,,Ông ta đã thực hiện quá nhiều giao dịch nguy hiểm trong thời chiến.
Dialogue: 5,0:49:14.20,0:49:17.66,Default,,0,0,0,,Ông ta định bán sạch những gì trong Pandora rồi cao chạy xa bay ra nước ngoài.
Dialogue: 5,0:49:17.66,0:49:22.64,Default,,0,0,0,,Đó là lý do ông ta thao túng Soga và phái một đội quân cờ của riêng mình tới.
Dialogue: 5,0:49:22.64,0:49:27.17,Default,,0,0,0,,Nhưng Soga đã nắm quyền kiểm soát tình hình, nên AI đó đã tự lên kế hoạch thu hồi.
Dialogue: 5,0:49:27.17,0:49:30.06,Default,,0,0,0,,"Tất cả là do một AI nổi loạn gây ra"... Tiện lợi gớm nhỉ.
Dialogue: 5,0:49:30.62,0:49:34.38,Default,,0,0,0,,Ngay cả khi đó là một nửa sự thật, tôi dám chắc bọn họ cố tình ngó lơ để trục lợi từ nó.
Dialogue: 5,0:49:34.38,0:49:39.01,Default,,0,0,0,,Dù có vẻ như bọn họ không phải là những kẻ duy nhất cố gắng trục lợi từ vụ này.
Dialogue: 5,0:49:39.01,0:49:41.07,Default,,0,0,0,,{\i1}Chính ông{\i0} mới là người đã tìm đến tôi đấy chứ.
Dialogue: 5,0:49:41.27,0:49:47.00,Default,,0,0,0,,Với những kết quả này, tiểu đội ưu tiên cao nhất hằng mong ước của cô đã là chuyện đã rồi.
Dialogue: 5,0:49:47.26,0:49:51.02,Default,,0,0,0,,Có muốn tái đăng ký thành một bộ phận của Đội 9 không?
Dialogue: 5,0:49:51.02,0:49:54.99,Default,,0,0,0,,Họ sẽ hủy đăng ký nếu cô không tập hợp đủ quân số đấy.
Dialogue: 5,0:49:54.99,0:49:56.01,Default,,0,0,0,,Xin miễn.
Dialogue: 5,0:49:56.69,0:49:59.71,Default,,0,0,0,,Dù sao thì tôi cũng cảm ơn vì ông đã giúp đỡ các thủ tục giấy tờ.
Dialogue: 5,0:50:18.62,0:50:21.36,Default,,0,0,0,,Năm phút nữa là đóng cửa phòng giam. Quyết định trước lúc đó đi.
Dialogue: 5,0:50:21.80,0:50:26.30,Default,,0,0,0,,Ngồi đây và chờ bị tuyên án trong một phiên tòa chớp nhoáng mà hệ thống ưa thích,
Dialogue: 5,0:50:26.30,0:50:27.80,Default,,0,0,0,,hoặc là gia nhập tiểu đội của tôi.
Dialogue: 5,0:50:29.03,0:50:32.79,Default,,0,0,0,,Cô cũng nói thế với tất cả những ai vừa đấu súng sinh tử với cô đấy à?
Dialogue: 5,0:50:32.79,0:50:35.75,Default,,0,0,0,,Tôi chỉ có thể bảo lãnh cho những người bị nhiễm virus ký ức được trả tự do thôi.
Dialogue: 5,0:50:36.51,0:50:38.97,Default,,0,0,0,,Dù sao thì cả ba người các anh đều là những người tôi đang cần.
Dialogue: 5,0:50:39.88,0:50:42.72,Default,,0,0,0,,Bọn họ chịu chấp nhận sau khi chúng ta vừa tuyên chiến với chính phủ sao?
Dialogue: 5,0:50:43.05,0:50:48.68,Default,,0,0,0,,Có thể, với điều kiện tôi, Đội 9, và cơ quan tình báo của một quốc gia nọ ra làm chứng về những ký ức giả tạo.
Dialogue: 5,0:50:49.23,0:50:51.42,Default,,0,0,0,,Ishikawa và Borma đã đồng ý rồi.
Dialogue: 5,0:50:51.42,0:50:55.37,Default,,0,0,0,,Còn Saito, khi tôi ghé thăm cậu ta trước khi kịp trốn chui trốn lủi,
Dialogue: 5,0:50:55.37,0:50:58.23,Default,,0,0,0,,cậu ta đã nài nỉ xin tôi cho gia nhập.
Dialogue: 5,0:51:00.81,0:51:02.39,Default,,0,0,0,,Cô đúng là ghê gớm thật đấy.
Dialogue: 5,0:51:03.20,0:51:05.74,Default,,0,0,0,,Vậy là, cô đang bảo tôi làm chân chạy việc cho An ninh Công cộng à?
Dialogue: 5,0:51:06.43,0:51:11.67,Default,,0,0,0,,Đó là một đơn vị tấn công độc lập dựa trên năng lực, không phân chia cấp bậc, và được trao quyền ưu tiên tối thượng.
Dialogue: 5,0:51:11.67,0:51:15.71,Default,,0,0,0,,Tôi sẽ cho anh những ký ức chứng minh anh không chỉ là một con chó săn được huấn luyện để giết chóc.
Dialogue: 5,0:51:21.24,0:51:24.52,Default,,0,0,0,,Mớ ký ức giả tạo này—cô thực sự có thể xóa sạch chúng sao?
Dialogue: 5,0:51:25.31,0:51:27.08,Default,,0,0,0,,Tôi có thể thử.
Dialogue: 0,0:52:03.60,0:52:11.60,ED - Romaji,,0,0,0,,{\fad(200,200)\be3}Shinobiyoru kuroi kumo
Dialogue: 0,0:52:03.60,0:52:11.60,ED - English,,0,0,0,,{\fad(200,200)\be3}Những đám mây đen dần phủ kín
Dialogue: 0,0:52:13.90,0:52:21.90,ED - Romaji,,0,0,0,,{\fad(200,200)\be3}Anata no me wa kireina me
Dialogue: 0,0:52:13.90,0:52:21.90,ED - English,,0,0,0,,{\fad(200,200)\be3}Đôi mắt người thật đẹp xiết bao
