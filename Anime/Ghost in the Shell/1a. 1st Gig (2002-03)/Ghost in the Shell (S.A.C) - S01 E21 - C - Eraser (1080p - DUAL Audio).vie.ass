Dialogue: 0,0:01:31.73,0:01:32.59,Default,,0000,0000,0000,,Togusa!
Dialogue: 0,0:01:33.06,0:01:36.09,Default,,0000,0000,0000,,Không được vào đây! Cậu ấy đang trong\Ntình trạng hết sức nguy kịch!
Dialogue: 0,0:01:37.17,0:01:38.26,Default,,0000,0000,0000,,Thiếu tá...
Dialogue: 0,0:01:40.60,0:01:45.17,Default,,0000,0000,0000,,Hãy xem qua ký ức của tôi...\NĐúng là người của Bộ Y tế thật rồi...
Dialogue: 0,0:01:45.61,0:01:48.01,Default,,0000,0000,0000,,Đầu tôi...\Nvẫn chưa bị bắn trúng.
Dialogue: 0,0:01:49.11,0:01:50.28,Default,,0000,0000,0000,,- Đặt nội khí quản!\N- Vâng, thưa bác sĩ!
Dialogue: 0,0:01:50.28,0:01:55.69,Default,,0000,0000,0000,,Trong lúc phẫu thuật, hãy trích xuất ký ức 16 tiếng\Nvừa qua từ não điện tử của cậu ấy ra đây.
Dialogue: 0,0:01:55.69,0:01:56.62,Default,,0000,0000,0000,,Tôi không thể làm vậy được!
Dialogue: 0,0:01:56.62,0:01:57.75,Default,,0000,0000,0000,,Cứ làm đi.
Dialogue: 0,0:01:58.12,0:02:01.35,Default,,0000,0000,0000,,Ngay lúc này, nguồn thông tin đó\Nlà sống còn đối với chúng tôi.
Dialogue: 0,0:02:11.50,0:02:12.40,Default,,0000,0000,0000,,Thế nào rồi?
Dialogue: 0,0:02:12.40,0:02:15.20,Default,,0000,0000,0000,,Chắc là do tác dụng của thuốc gây mê.\NNhiễu loạn nhiều quá.
Dialogue: 0,0:02:16.57,0:02:19.06,Default,,0000,0000,0000,,Chúng ta sẽ tiếp nhận toàn bộ mọi thứ,\Ntừ biến động cảm xúc của cậu ấy,
Dialogue: 0,0:02:19.61,0:02:21.77,Default,,0000,0000,0000,,nên thậm chí nó có thể ảnh hưởng\Nđến cả nhận thức của chúng ta đấy.
Dialogue: 0,0:02:22.38,0:02:24.28,Default,,0000,0000,0000,,Không còn cách nào khác đâu.\NPhát đi.
Dialogue: 0,0:02:24.78,0:02:26.98,Default,,0000,0000,0000,,Nhịp tim của cậu ấy\Nđang tăng cao bất thường...
Dialogue: 0,0:02:28.85,0:02:30.25,Default,,0000,0000,0000,,Thằng ngốc này...
Dialogue: 0,0:02:30.25,0:02:34.02,Default,,0000,0000,0000,,Cứ thích lao đi làm anh hùng kiểu đó,\Nthì {\i1}tất nhiên{\i0} là bị xơi đạn rồi...
Dialogue: 0,0:02:37.33,0:02:38.82,Default,,0000,0000,0000,,Hãy điểm lại\Ntình hình xem nào.
Dialogue: 0,0:02:39.16,0:02:41.76,Default,,0000,0000,0000,,Phán đoán kẻ đứng sau vụ tấn công mạng...
Dialogue: 0,0:02:42.10,0:02:44.60,Default,,0000,0000,0000,,...từ trung tâm hướng nghiệp\Nnhắm vào tài liệu giấy,
Dialogue: 0,0:02:44.60,0:02:48.00,Default,,0000,0000,0000,,Togusa đã liên tục lui tới Bộ Y tế, Lao động\Nvà Phúc lợi để kiểm chứng linh cảm của mình.
Dialogue: 0,0:02:48.14,0:02:53.10,Default,,0000,0000,0000,,Và giữa biển tài liệu khổng lồ đó, cậu ấy\Nđã phát hiện ra sự tồn tại của một bản danh sách bị mất.
Dialogue: 0,0:02:53.34,0:02:56.57,Default,,0000,0000,0000,,Đó chính là danh sách những người\Nđược cấp vắc-xin Murai.
Dialogue: 0,0:02:56.85,0:02:59.05,Default,,0000,0000,0000,,Phải. Dù chúng ta vẫn chưa rõ\Nchuyện gì đã xảy ra sau đó,
Dialogue: 0,0:02:59.05,0:03:04.61,Default,,0000,0000,0000,,nhưng Togusa đã bị phục kích khi đến Hội Hoa Hướng Dương,\Nnơi đang cần bản danh sách ấy.
Dialogue: 0,0:03:05.39,0:03:06.96,Default,,0000,0000,0000,,Rõ mười mươi rồi còn gì!
Dialogue: 0,0:03:06.96,0:03:08.62,Default,,0000,0000,0000,,Chính bọn Cục Kiểm soát Ma túy\Nđã nổ súng bắn Togusa!
Dialogue: 0,0:03:09.16,0:03:12.56,Default,,0000,0000,0000,,Nghĩa là Ban Phòng chống Ma túy, một lực lượng\Nchuyên trấn áp tội phạm bạo lực,
Dialogue: 0,0:03:12.56,0:03:14.83,Default,,0000,0000,0000,,đã tàn sát dã man một nhóm dân thường!\NChỉ đơn giản là thế thôi!
Dialogue: 0,0:03:15.13,0:03:17.79,Default,,0000,0000,0000,,Mục tiêu của chúng là thu giữ\Nhoặc tiêu hủy tập hồ sơ đó sao?
Dialogue: 0,0:03:18.07,0:03:20.34,Default,,0000,0000,0000,,Có vẻ như nguồn cơn\Ncủa mọi chuyện bắt nguồn từ việc...
Dialogue: 0,0:03:20.34,0:03:23.53,Default,,0000,0000,0000,,...cái tên "Imakurusu"\Ncó mặt trong bản danh sách ấy.
Dialogue: 0,0:03:24.04,0:03:26.04,Default,,0000,0000,0000,,Quan tâm quái gì đến việc\Nnó dính líu tới ai cơ chứ?!
Dialogue: 0,0:03:26.04,0:03:29.55,Default,,0000,0000,0000,,Cứ tóm cổ lũ khốn bên Cục Kiểm soát Ma túy\Nlà khắc rõ ngọn ngành ngay thôi!
Dialogue: 0,0:03:29.55,0:03:31.88,Default,,0000,0000,0000,,Đừng để những mảnh ký ức đó\Nlàm lung lay phán đoán của cậu.
Dialogue: 0,0:03:32.21,0:03:35.84,Default,,0000,0000,0000,,Tôi chắc chắn bọn chúng đã tuồn thông tin bịa đặt\Ncho giới truyền thông rồi.
Dialogue: 0,0:03:36.25,0:03:38.19,Default,,0000,0000,0000,,Sự thật\Nđang dần bị xóa sổ.
Dialogue: 0,0:03:38.82,0:03:41.79,Default,,0000,0000,0000,,Thiếu tá, gã Imakurusu\Nnày là ai vậy?
Dialogue: 0,0:03:43.79,0:03:47.85,Default,,0000,0000,0000,,Imakurusu Hisashi, cựu chủ tịch\NHội đồng Thẩm định Dược phẩm Trung ương.
Dialogue: 0,0:03:48.60,0:03:52.17,Default,,0000,0000,0000,,Là chuyên gia đầu ngành về xơ cứng não điện tử, kiêm\Nchủ tịch Hiệp hội Y khoa Nhật Bản.
Dialogue: 0,0:03:52.17,0:03:54.19,Default,,0000,0000,0000,,Dù đã rời khỏi\NHội đồng thẩm định,
Dialogue: 0,0:03:54.50,0:03:57.37,Default,,0000,0000,0000,,nhưng nghe nói ông ta vẫn có vòi bạch tuộc\Năn sâu vào Bộ Y tế.
Dialogue: 0,0:03:57.71,0:04:00.57,Default,,0000,0000,0000,,Được rồi. Thiếu tá, cô hãy\Nđi gặp Imakurusu.
Dialogue: 0,0:04:00.91,0:04:05.44,Default,,0000,0000,0000,,Tôi sẽ điều tra xem vì sao Ban Phòng chống Ma túy\Nlại được lệnh điều động.
Dialogue: 0,0:04:05.68,0:04:06.65,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:04:08.38,0:04:10.98,Default,,0000,0000,0000,,Pazu và Saito, hai cậu theo tôi\Nđến chỗ của Imakurusu.
Dialogue: 0,0:04:11.55,0:04:14.46,Default,,0000,0000,0000,,Batou, cậu ở lại phân tích ký ức\Ncùng Ishikawa và Borma.
Dialogue: 0,0:04:14.46,0:04:17.32,Default,,0000,0000,0000,,Đùa nhau à! Cô phải cho tôi đi điều tra\Nbọn khốn Cục Kiểm soát Ma túy chứ!
Dialogue: 0,0:04:17.76,0:04:19.93,Default,,0000,0000,0000,,Cậu vác cái bản mặt hằm hằm đó đến đó\Nthì định giải quyết được trò trống gì?
Dialogue: 0,0:04:19.93,0:04:21.66,Default,,0000,0000,0000,,Khi nào cần\Ntôi sẽ gọi.
Dialogue: 0,0:04:22.63,0:04:24.57,Default,,0000,0000,0000,,Vậy cô {\i1}nghĩ{\i0} tôi phải mang\Nkhuôn mặt thế nào đây hả?
Dialogue: 0,0:04:24.57,0:04:27.27,Default,,0000,0000,0000,,Ý Thiếu tá chỉ là cậu cần phải\Nhạ hỏa cái đầu xuống một chút thôi.
Dialogue: 0,0:04:27.27,0:04:28.96,Default,,0000,0000,0000,,Nhìn cảnh tượng đó xong thì\Nai mà giữ bình tĩnh cho nổi chứ?!
Dialogue: 0,0:04:29.31,0:04:33.24,Default,,0000,0000,0000,,Cậu đang bị ảnh hưởng bởi ký ức của Togusa đấy.\NQuyết định của Thiếu tá là hoàn toàn đúng.
Dialogue: 0,0:04:42.28,0:04:43.65,Default,,0000,0000,0000,,Thứ lỗi.
Dialogue: 0,0:04:43.65,0:04:45.05,Default,,0000,0000,0000,,Ông là ai?
Dialogue: 0,0:04:45.49,0:04:47.25,Default,,0000,0000,0000,,Aramaki, Ban An ninh\NCông cộng số 9.
Dialogue: 0,0:04:47.79,0:04:51.63,Default,,0000,0000,0000,,Tôi nghe nói ông đã qua mặt Cục trưởng Cục Ma túy\Nđể đích thân ban hành...
Dialogue: 0,0:04:51.63,0:04:54.80,Default,,0000,0000,0000,,...mệnh lệnh dọn dẹp Hội Hoa Hướng Dương\Ntrong đêm qua.
Dialogue: 0,0:04:54.80,0:04:56.93,Default,,0000,0000,0000,,Tôi muốn nghe lý do vì sao\Nông lại làm như vậy.
Dialogue: 0,0:04:56.93,0:04:58.23,Default,,0000,0000,0000,,Ông tưởng ông\Nlà ai cơ chứ?!
Dialogue: 0,0:04:58.57,0:04:59.59,Default,,0000,0000,0000,,Không sao.
Dialogue: 0,0:05:00.00,0:05:02.63,Default,,0000,0000,0000,,Tôi đang trên đường đi họp báo\Nđể làm rõ đúng vấn đề đó đây.
Dialogue: 0,0:05:02.97,0:05:05.00,Default,,0000,0000,0000,,Cái hội Hoa Hướng Dương đó\Nlà một lũ ranh mãnh.
Dialogue: 0,0:05:05.51,0:05:11.31,Default,,0000,0000,0000,,Đó là chiến dịch tuyệt mật được lên kế hoạch kỹ lưỡng,\Nchỉ riêng Ban Phòng chống Ma túy được biết.
Dialogue: 0,0:05:11.75,0:05:15.88,Default,,0000,0000,0000,,Thật đáng tiếc, nhưng bọn chúng đã chống trả\Nquyết liệt đến cùng,
Dialogue: 0,0:05:16.19,0:05:19.95,Default,,0000,0000,0000,,buộc lực lượng trấn áp phải dùng đến\Nbiện pháp mạnh.
Dialogue: 0,0:05:20.76,0:05:23.32,Default,,0000,0000,0000,,Lũ điên đó thậm chí còn châm lửa\Nđốt luôn cả tòa nhà...
Dialogue: 0,0:05:23.83,0:05:25.38,Default,,0000,0000,0000,,Thưa Cục trưởng,\Ngần đến giờ rồi ạ.
Dialogue: 0,0:05:26.26,0:05:29.20,Default,,0000,0000,0000,,Vậy thì tôi thấy Đội 9 chúng tôi\Nchẳng còn lý do gì để can thiệp nữa rồi.
Dialogue: 0,0:05:30.03,0:05:33.20,Default,,0000,0000,0000,,Có điều, vẫn {\i1}còn{\i0} một việc\Nkhiến tôi bận lòng.
Dialogue: 0,0:05:34.67,0:05:37.17,Default,,0000,0000,0000,,Tôi tin đó chỉ là\Nmột sự trùng hợp ngẫu nhiên thôi,
Dialogue: 0,0:05:37.17,0:05:42.24,Default,,0000,0000,0000,,nhưng đêm qua, một điều tra viên của tôi\Nlại tình cờ có mặt tại hiện trường vụ đột kích.
Dialogue: 0,0:05:46.12,0:05:47.81,Default,,0000,0000,0000,,Hy vọng một ngày nào đó\Nchúng ta sẽ còn tái ngộ.
Dialogue: 0,0:05:54.19,0:05:55.62,Default,,0000,0000,0000,,Thưa sếp, có nên\Nđể ông ta đi không ạ?
Dialogue: 0,0:05:55.62,0:05:56.93,Default,,0000,0000,0000,,Kệ lão đi.
Dialogue: 0,0:05:56.93,0:05:59.92,Default,,0000,0000,0000,,Lão phải đích thân mò đến tận đây,\Nchứng tỏ bọn chúng chẳng có chút bằng chứng nào trong tay cả.
Dialogue: 0,0:06:00.76,0:06:01.63,Default,,0000,0000,0000,,Gayle!
Dialogue: 0,0:06:02.97,0:06:05.93,Default,,0000,0000,0000,,{\i1}Xui rồi. Có vẻ lão ta đã{\i0}\N{\i1}chuồn đi đâu mất rồi.{\i0}
Dialogue: 0,0:06:06.77,0:06:09.50,Default,,0000,0000,0000,,{\i1}Bên An ninh Công cộng đang đánh hơi quanh đây đấy.{\i0}\N{\i1}Cậu không có nhiều thời gian đâu.{\i0}
Dialogue: 0,0:06:09.84,0:06:10.54,Default,,0000,0000,0000,,An ninh Công cộng sao?
Dialogue: 0,0:06:10.54,0:06:13.74,Default,,0000,0000,0000,,{\i1}Đội 9 đấy! Hãy tóm gọn Imakurusu{\i0}\N{\i1}trước khi bọn chúng tiếp cận được lão!{\i0}
Dialogue: 0,0:06:14.11,0:06:17.14,Default,,0000,0000,0000,,À, ý sếp là đám người máy\Nxuất thân quân đội đó hả?
Dialogue: 0,0:06:17.78,0:06:20.15,Default,,0000,0000,0000,,Vậy là... có lẽ tôi\Nsẽ cần đến... "thứ đó" rồi.
Dialogue: 0,0:06:21.15,0:06:24.02,Default,,0000,0000,0000,,Món hàng mà tôi vẫn hằng\Nyêu cầu ông đấy.
Dialogue: 0,0:06:24.59,0:06:27.52,Default,,0000,0000,0000,,{\i1}Được rồi. Tôi sẽ thu xếp{\i0}\N{\i1}cho cậu thứ cậu muốn.{\i0}
Dialogue: 0,0:06:27.86,0:06:31.16,Default,,0000,0000,0000,,{\i1}Nhưng nếu chạm trán với Đội 9,{\i0}\N{\i1}tuyệt đối không được để lại dấu vết gì.{\i0}
Dialogue: 0,0:06:32.39,0:06:34.86,Default,,0000,0000,0000,,Rõ rồi.\NKhông để lại dấu vết.
Dialogue: 0,0:06:37.00,0:06:39.87,Default,,0000,0000,0000,,{\i1}Chuyện đã đến nước này rồi,{\i0}\N{\i1}liệu ông có định phản bội chúng tôi không?{\i0}
Dialogue: 0,0:06:46.11,0:06:47.17,Default,,0000,0000,0000,,Rắc rối to rồi đây...
Dialogue: 0,0:06:52.51,0:06:54.45,Default,,0000,0000,0000,,Ra đây là phát súng\Nmở màn...
Dialogue: 0,0:06:54.98,0:06:56.58,Default,,0000,0000,0000,,{\i1}Trưởng ban, chúng tôi{\i0}\N{\i1}đến muộn mất rồi.{\i0}
Dialogue: 0,0:06:57.25,0:06:59.19,Default,,0000,0000,0000,,{\i1}Có vẻ đã có kẻ{\i0}\N{\i1}ghé thăm lão trước chúng tôi.{\i0}
Dialogue: 0,0:06:59.19,0:07:00.92,Default,,0000,0000,0000,,{\i1}Chắc chắn là tác phẩm{\i0}\N{\i1}của bọn Cục Ma túy.{\i0}
Dialogue: 0,0:07:01.26,0:07:04.56,Default,,0000,0000,0000,,{\i1}Nhưng nhìn hiện trường thế này, chẳng phải{\i0}\N{\i1}Imakurusu đã kịp tẩu thoát rồi sao?{\i0}
Dialogue: 0,0:07:04.93,0:07:06.13,Default,,0000,0000,0000,,{\i1}Nhiều khả năng là vậy.{\i0}
Dialogue: 0,0:07:06.13,0:07:09.53,Default,,0000,0000,0000,,{\i1}Nghĩa là rất có thể ông ta sẽ sử dụng{\i0}\N{\i1}phương thức liên lạc nào đó.{\i0}
Dialogue: 0,0:07:09.80,0:07:12.33,Default,,0000,0000,0000,,{\i1}Tôi hiểu ý cô rồi. Hay là nhờ...{\i0}\N{\i1}Cục Trinh sát Quốc gia của Đế chế Mỹ...{\i0}
Dialogue: 0,0:07:12.33,0:07:15.24,Default,,0000,0000,0000,,{\i1}... hỗ trợ một tay nhé?{\i0}
Dialogue: 0,0:07:15.50,0:07:17.47,Default,,0000,0000,0000,,{\i1}Ý sếp là mạng lưới vệ tinh do thám toàn cầu{\i0}\N{\i1}của họ sao?{\i0}
Dialogue: 0,0:07:17.81,0:07:18.70,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:07:18.91,0:07:19.81,Default,,0000,0000,0000,,{\i1}Trưởng ban!{\i0}
Dialogue: 0,0:07:19.81,0:07:22.68,Default,,0000,0000,0000,,{\i1}Được rồi. Tôi sẽ yêu cầu Bộ Ngoại giao{\i0}\N{\i1}phê duyệt bổ sung sau.{\i0}
Dialogue: 0,0:07:22.95,0:07:25.65,Default,,0000,0000,0000,,{\i1}Dù sao thì CIA cũng còn nợ chúng ta{\i0}\N{\i1}ít nhất là một ân huệ!{\i0}
Dialogue: 0,0:07:25.65,0:07:26.64,Default,,0000,0000,0000,,{\i1}Rõ rồi ạ.{\i0}
Dialogue: 0,0:07:27.28,0:07:29.15,Default,,0000,0000,0000,,Đến lúc để Người Anh Cả\Ntrổ tài rồi.
Dialogue: 0,0:07:29.15,0:07:32.25,Default,,0000,0000,0000,,Hệ thống này cho phép chúng ta nghe lén mọi liên lạc\Ntrên toàn Nhật Bản theo thời gian thực!
Dialogue: 0,0:07:56.88,0:07:57.71,Default,,0000,0000,0000,,Đã kết nối trực tuyến!
Dialogue: 0,0:07:57.71,0:08:00.05,Default,,0000,0000,0000,,Lượng dữ liệu khổng lồ này không chỉ đánh sập\Nmọi thiết bị đầu cuối trong tòa nhà {\i1}này{\i0},
Dialogue: 0,0:08:00.05,0:08:01.91,Default,,0000,0000,0000,,mà nó còn sẽ làm tê liệt toàn bộ hệ thống\Ntrong bán kính một cây số đấy!
Dialogue: 0,0:08:02.35,0:08:05.62,Default,,0000,0000,0000,,{\i1}Có lẽ mình nên nhờ mấy lão làng{\i0}\N{\i1}làm hệ thống dự phòng thứ cấp thôi...{\i0}
Dialogue: 0,0:08:11.93,0:08:14.05,Default,,0000,0000,0000,,Chết tiệt,\Nmình tiêu đời rồi...
Dialogue: 0,0:08:14.50,0:08:16.26,Default,,0000,0000,0000,,Lẽ ra mình không nên bỏ chạy.
Dialogue: 0,0:08:16.53,0:08:18.63,Default,,0000,0000,0000,,{\i1}Chính ông{\i0} là kẻ\Nđã đánh cắp tập tài liệu đó.
Dialogue: 0,0:08:19.23,0:08:22.57,Default,,0000,0000,0000,,Giờ thì bọn chúng chỉ còn nước\Nnghĩ rằng tôi đã phản bội thôi.
Dialogue: 0,0:08:23.04,0:08:27.10,Default,,0000,0000,0000,,Nếu tôi không sắp đặt vụ này, ông sẽ chẳng\Nbao giờ nghiêm túc nhìn nhận vấn đề cả.
Dialogue: 0,0:08:27.88,0:08:30.74,Default,,0000,0000,0000,,Bọn chúng không hề nhân từ\Nnhư ông tưởng tượng đâu!
Dialogue: 0,0:08:31.61,0:08:34.58,Default,,0000,0000,0000,,Tôi rất lấy làm tiếc về những gì\Nđã xảy ra với những người ở Hội Hoa Hướng Dương.
Dialogue: 0,0:08:35.18,0:08:38.89,Default,,0000,0000,0000,,Nhưng tôi đã thề sẽ không\Nbao giờ bỏ cuộc cho tới khi phơi bày...
Dialogue: 0,0:08:38.89,0:08:42.12,Default,,0000,0000,0000,,...toàn bộ sự thật đen tối đằng sau\Ncác liệu pháp điều trị bằng vi máy móc.
Dialogue: 0,0:08:42.89,0:08:44.52,Default,,0000,0000,0000,,Cậu quá ngây thơ rồi.
Dialogue: 0,0:08:45.13,0:08:47.96,Default,,0000,0000,0000,,Thời điểm đó, nghiên cứu công nghệ\Nnão điện tử đang trên đà phát triển ở nhiều lĩnh vực khác.
Dialogue: 0,0:08:47.96,0:08:50.93,Default,,0000,0000,0000,,Nếu tôi phê duyệt loại vắc-xin đó, người ta\Ncó thể sẽ bài xích luôn cả công nghệ não điện tử,
Dialogue: 0,0:08:51.27,0:08:53.56,Default,,0000,0000,0000,,khiến sự phát triển của nó\Nbị thụt lùi hàng chục năm!
Dialogue: 0,0:08:54.14,0:08:58.77,Default,,0000,0000,0000,,Dù vậy, điều đó cũng không cho phép ông quyền\Nđược dập tắt thành quả nghiên cứu chính đáng.
Dialogue: 0,0:08:59.01,0:09:00.31,Default,,0000,0000,0000,,Cậu hiểu sai hoàn toàn rồi.
Dialogue: 0,0:09:00.31,0:09:03.55,Default,,0000,0000,0000,,Tôi không hề mù quáng\Nphản đối một cách vô cớ.
Dialogue: 0,0:09:03.55,0:09:07.38,Default,,0000,0000,0000,,Nếu Murai giải quyết được vấn đề thiếu hụt dữ liệu lâm sàng,\Ntôi đã sẵn sàng cấp phép phê duyệt.
Dialogue: 0,0:09:08.28,0:09:13.88,Default,,0000,0000,0000,,Vậy thì ông dựa vào cơ sở nào mà chỉ mất vỏn vẹn\Nba tháng để phê duyệt mẫu ứng dụng...
Dialogue: 0,0:09:14.32,0:09:17.49,Default,,0000,0000,0000,,...do Tập đoàn Serano Genomics đệ trình, một kẻ\Nnhảy vào cuộc đua vi máy móc muộn màng?
Dialogue: 0,0:09:17.96,0:09:21.62,Default,,0000,0000,0000,,Chúng tôi chỉ làm theo đúng hướng dẫn\Ndo Bộ Y tế ban hành.
Dialogue: 0,0:09:21.90,0:09:24.46,Default,,0000,0000,0000,,Hội đồng của chúng tôi\Nchỉ là con dê tế thần thôi.
Dialogue: 0,0:09:24.93,0:09:26.56,Default,,0000,0000,0000,,Lời ngụy biện nghe\Ntiện lợi làm sao.
Dialogue: 0,0:09:27.10,0:09:30.00,Default,,0000,0000,0000,,Tập đoàn Công nghiệp Vi máy móc, nơi ông\Ntừng ngồi trong hội đồng quản trị,
Dialogue: 0,0:09:30.27,0:09:34.00,Default,,0000,0000,0000,,cũng được phê duyệt chỉ một tháng sau khi nộp hồ sơ,\Ny hệt như Serano.
Dialogue: 0,0:09:34.78,0:09:38.98,Default,,0000,0000,0000,,Và nhờ thế, các người đã bỏ túi nguồn lợi nhuận\Ngần cả nghìn tỷ yên mỗi năm...
Dialogue: 0,0:09:38.98,0:09:42.82,Default,,0000,0000,0000,,...bằng việc bán những hạt protein hoàn toàn\Nvô tác dụng đối với chứng xơ cứng não điện tử.
Dialogue: 0,0:09:43.45,0:09:46.85,Default,,0000,0000,0000,,Đây là một hành vi lừa đảo trắng trợn\Nđược thực hiện dưới sự bảo kê của chính quyền.
Dialogue: 0,0:09:47.59,0:09:50.76,Default,,0000,0000,0000,,Ông định đưa ra lời giải thích thế nào trước những bệnh nhân\Nđã khuất, những người vì không biết sự thật...
Dialogue: 0,0:09:50.76,0:09:54.92,Default,,0000,0000,0000,,...mà vẫn cắn răng chi trả viện phí cắt cổ\Nvới niềm tin ngây thơ rằng thuốc có tác dụng?
Dialogue: 0,0:09:55.43,0:09:59.06,Default,,0000,0000,0000,,Hiện nay vi máy móc đã thể hiện được\Nmức độ hiệu quả nhất định rồi.
Dialogue: 0,0:09:59.50,0:10:05.53,Default,,0000,0000,0000,,Xét trên khía cạnh phòng ngừa xơ cứng, cậu không thể\Nbảo quyết định của chúng tôi là hoàn toàn vô ích.
Dialogue: 0,0:10:06.14,0:10:11.24,Default,,0000,0000,0000,,Nếu đã vậy, tại sao chính bản thân ông\Nlại không điều trị bằng vi máy móc đi?!
Dialogue: 0,0:10:17.09,0:10:23.62,Default,,0000,0000,0000,,Ông từng là người duy nhất nắm giữ vị thế\Ncó thể ngăn chặn thảm cảnh đau lòng này.
Dialogue: 0,0:10:24.36,0:10:29.23,Default,,0000,0000,0000,,Ông mang trên mình thiên chức cứu người,\Nvậy tại sao ông lại không làm điều đó?
Dialogue: 0,0:10:30.97,0:10:36.77,Default,,0000,0000,0000,,Tôi đã từng tràn đầy tự hào vì cống hiến cả đời mình\Nđể tìm kiếm phương thuốc chữa xơ cứng não điện tử.
Dialogue: 0,0:10:37.84,0:10:38.97,Default,,0000,0000,0000,,Thế nhưng Murai...
Dialogue: 0,0:10:38.97,0:10:40.94,Default,,0000,0000,0000,,Đã đi trước ông\Nmột bước.
Dialogue: 0,0:10:42.68,0:10:43.87,Default,,0000,0000,0000,,Là vì ghen ăn tức ở sao?
Dialogue: 0,0:10:44.85,0:10:47.75,Default,,0000,0000,0000,,Tôi nghe nói để bóp chết\Nvắc-xin Murai,
Dialogue: 0,0:10:48.18,0:10:51.35,Default,,0000,0000,0000,,ông đã đặc chế một con dấu riêng\Nmang dòng chữ "Bác Bỏ Phê Duyệt".
Dialogue: 0,0:10:51.82,0:10:54.35,Default,,0000,0000,0000,,Và chỉ vì lòng tự ái\Nti tiện hèn mạt của ông,
Dialogue: 0,0:10:54.99,0:10:57.58,Default,,0000,0000,0000,,mà những kẻ đó giờ đây đang ung dung hưởng lạc\Ntrên những vị thế mà chúng vơ vét được.
Dialogue: 0,0:10:58.43,0:11:01.19,Default,,0000,0000,0000,,Nếu cậu đã biết tường tận đến thế,\Ncòn cần đến tôi làm gì nữa?
Dialogue: 0,0:11:01.80,0:11:05.93,Default,,0000,0000,0000,,Cậu có thể xâm nhập não điện tử của tôi\Nvà chiếm đoạt tất cả, kể cả Ghost cơ mà.
Dialogue: 0,0:11:07.07,0:11:08.70,Default,,0000,0000,0000,,Nếu làm vậy, mọi chuyện\Nsẽ chẳng còn chút ý nghĩa nào cả.
Dialogue: 0,0:11:09.84,0:11:13.54,Default,,0000,0000,0000,,Giờ đây mạng sống của ông đang được duy trì\Nnhờ chính loại vắc-xin đó,
Dialogue: 0,0:11:13.98,0:11:16.47,Default,,0000,0000,0000,,hãy tự nguyện đứng ra vạch trần toàn bộ sự thật\Nbằng chính ý chí tự do của mình.
Dialogue: 0,0:11:17.45,0:11:19.74,Default,,0000,0000,0000,,Ông muốn sống những năm tháng cuối đời\Nnhư một con người danh giá,
Dialogue: 0,0:11:20.08,0:11:23.15,Default,,0000,0000,0000,,hay muốn bị muôn đời nguyền rủa\Nvề sự đê tiện sau khi nhắm mắt xuôi tay?
Dialogue: 0,0:11:23.15,0:11:24.35,Default,,0000,0000,0000,,Lựa chọn là ở ông.
Dialogue: 0,0:11:25.45,0:11:29.02,Default,,0000,0000,0000,,Gã Mặt Cười...\Nrốt cuộc cậu là ai?
Dialogue: 0,0:11:29.56,0:11:32.22,Default,,0000,0000,0000,,Cậu đứng đó giương cao ngọn cờ chính nghĩa,\Nvậy tại sao cậu lại...
Dialogue: 0,0:11:32.73,0:11:36.32,Default,,0000,0000,0000,,...thực hiện hàng loạt vụ khủng bố doanh nghiệp\Nvà vòi vĩnh ngần ấy tiền cho riêng mình?
Dialogue: 0,0:11:37.23,0:11:40.90,Default,,0000,0000,0000,,Tôi chưa từng tự nhận mình là Gã Mặt Cười,\Ndù chỉ một lần.
Dialogue: 0,0:11:41.74,0:11:45.54,Default,,0000,0000,0000,,Và kẻ biển thủ tiền bạc thông qua các vụ khủng bố doanh nghiệp\Nđó là một kẻ hoàn toàn khác.
Dialogue: 0,0:11:48.01,0:11:49.03,Default,,0000,0000,0000,,Chẳng lẽ ý cậu là...
Dialogue: 0,0:11:49.51,0:11:50.98,Default,,0000,0000,0000,,Ông đoán đúng rồi đấy.
Dialogue: 0,0:11:52.45,0:11:59.44,Default,,0000,0000,0000,,Ông hiểu rồi chứ? Để đưa lũ chúng ra trước vành móng ngựa,\Nngoài lời khai của ông tôi còn cần một thứ khác nữa.
Dialogue: 0,0:12:00.52,0:12:04.01,Default,,0000,0000,0000,,Tuyệt đối không được rời khỏi căn phòng này\Nvì bất cứ lý do gì cho tới khi tôi quay lại.
Dialogue: 0,0:12:04.56,0:12:05.75,Default,,0000,0000,0000,,Rõ chưa?
Dialogue: 0,0:12:14.30,0:12:15.74,Default,,0000,0000,0000,,X-Xin lỗi quý khách.
Dialogue: 0,0:12:15.74,0:12:17.43,Default,,0000,0000,0000,,Dạ, tôi có thể giúp gì\Nđược cho quý khách không ạ?
Dialogue: 0,0:12:19.01,0:12:20.74,Default,,0000,0000,0000,,Không có gì.\NĐi chỗ khác đi.
Dialogue: 0,0:12:21.91,0:12:23.57,Default,,0000,0000,0000,,Thành thật xin lỗi\Nvì đã làm phiền.
Dialogue: 0,0:12:25.41,0:12:26.71,Default,,0000,0000,0000,,Chờ một chút đã, cậu trai.
Dialogue: 0,0:12:27.75,0:12:30.72,Default,,0000,0000,0000,,Gần đây có trạm thiết bị\Nđầu cuối công cộng nào không?
Dialogue: 0,0:12:34.16,0:12:36.06,Default,,0000,0000,0000,,Tôi nghĩ cậu ấy\Nđã qua cơn nguy kịch rồi.
Dialogue: 0,0:12:36.66,0:12:38.56,Default,,0000,0000,0000,,Huyết áp cũng đã\Nổn định trở lại.
Dialogue: 0,0:12:38.56,0:12:40.19,Default,,0000,0000,0000,,Cảm ơn bác sĩ.
Dialogue: 0,0:12:40.66,0:12:41.63,Default,,0000,0000,0000,,Không có gì.
Dialogue: 0,0:12:41.63,0:12:43.97,Default,,0000,0000,0000,,Nhưng nếu sau khi tỉnh lại,\Nphát hiện thấy...
Dialogue: 0,0:12:43.97,0:12:47.53,Default,,0000,0000,0000,,...có tổn thương cơ thể lâu dài hoặc di chứng\Nđể lại từ vết thương,
Dialogue: 0,0:12:47.94,0:12:50.93,Default,,0000,0000,0000,,các anh nên chuẩn bị tinh thần\Nthay thế một phần cơ thể bằng bộ phận máy móc.
Dialogue: 0,0:13:06.46,0:13:09.15,Default,,0000,0000,0000,,Tôi vô cùng xin lỗi\Nvì thời tiết hôm nay xấu quá.
Dialogue: 0,0:13:09.49,0:13:14.33,Default,,0000,0000,0000,,Không, đâu phải lỗi do anh. Hôm nay là ngày\Nduy nhất mọi người sắp xếp được thời gian thôi.
Dialogue: 0,0:13:16.73,0:13:19.13,Default,,0000,0000,0000,,Tôi đây. Imakurusu đây.\NÔng phải cứu tôi với.
Dialogue: 0,0:13:19.70,0:13:21.83,Default,,0000,0000,0000,,Ông phải nói chuyện với Niimi\Nvà giải tỏa sự hiểu lầm này giúp tôi.
Dialogue: 0,0:13:22.74,0:13:25.97,Default,,0000,0000,0000,,Phải, tôi đang ở sân golf đó.\NTrông cậy cả vào ông đấy.
Dialogue: 0,0:13:30.58,0:13:32.75,Default,,0000,0000,0000,,Bắt được rồi! Đúng là đẳng cấp\NNgười Anh Cả có khác!
Dialogue: 0,0:13:32.75,0:13:34.05,Default,,0000,0000,0000,,Vẫn chưa thể khẳng định\Nchắc chắn đâu.
Dialogue: 0,0:13:34.05,0:13:37.54,Default,,0000,0000,0000,,Tìm kiếm theo sóng âm giọng nói vừa khớp\Nvới từ "Imakurusu", chỉ vậy thôi.
Dialogue: 0,0:13:37.85,0:13:38.95,Default,,0000,0000,0000,,Đang quét sóng âm giọng nói.
Dialogue: 0,0:13:38.95,0:13:42.96,Default,,0000,0000,0000,,Đang đối chiếu sóng âm của người gọi\Nvới dữ liệu của Imakurusu Hisashi.
Dialogue: 0,0:13:41.69,0:13:45.33,Top Secondary Dialog 1080P,,0000,0000,0000,,So sánh dữ liệu sóng âm\Ncủa Imakurusu Hisashi...
Dialogue: 0,0:13:43.16,0:13:45.83,Default,,0000,0000,0000,,Bắt đầu định vị trạm thiết bị\Nngười gọi sử dụng.
Dialogue: 0,0:13:45.33,0:13:47.66,Top Secondary Dialog 1080P,,0000,0000,0000,,...với người đàm thoại\Nhiện đạt 36% độ trùng khớp.
Dialogue: 0,0:13:47.66,0:13:49.26,Top Secondary Dialog 1080P,,0000,0000,0000,,Tiếp quản quy trình truy vết vị trí trạm thiết bị người gọi.
Dialogue: 0,0:13:49.26,0:13:50.47,Top Secondary Dialog 1080P,,0000,0000,0000,,Đã khóa chính xác vị trí trạm thiết bị!
Dialogue: 0,0:13:50.47,0:13:53.20,Top Secondary Dialog 1080P,,0000,0000,0000,,Đang chạy lộ trình truyền dẫn tín hiệu.\NXác nhận định tuyến qua vệ tinh thông tin.
Dialogue: 0,0:13:51.20,0:13:53.70,Default,,0000,0000,0000,,Này, hệ thống điện toán viên\Nđang bị quá tải đánh sập kìa!
Dialogue: 0,0:13:53.20,0:13:55.07,Top Secondary Dialog 1080P,,0000,0000,0000,,Đang kích hoạt chương trình truy vết!
Dialogue: 0,0:13:53.70,0:13:55.07,Default,,0000,0000,0000,,{\i1}Tôi đã khởi động hệ thống dự phòng rồi.{\i0}
Dialogue: 0,0:14:03.98,0:14:07.57,Default,,0000,0000,0000,,Tuyệt vời ông mặt trời, hôm nay đúng là ngày may mắn!\NPhong độ lên đỉnh rồi!
Dialogue: 0,0:14:07.78,0:14:09.55,Default,,0000,0000,0000,,Được mượn não điện tử của mấy vị\Nquả là đáng đồng tiền bát gạo.
Dialogue: 0,0:14:09.82,0:14:11.29,Default,,0000,0000,0000,,Cậu cũng quái chiêu gớm đấy,\Nbiết không hả?
Dialogue: 0,0:14:11.29,0:14:15.25,Default,,0000,0000,0000,,Cứ nối mạng song song vào, thì ngay cả mấy lão già lẩm cẩm đó\Ncũng đem lại sức mạnh tính toán đáng nể đấy.
Dialogue: 0,0:14:16.59,0:14:17.59,Default,,0000,0000,0000,,Tình hình sao rồi?
Dialogue: 0,0:14:17.59,0:14:21.93,Default,,0000,0000,0000,,Chúng tôi vừa xác định được vị trí trạm máy\Ndo người bị nghi là Imakurusu sử dụng.
Dialogue: 0,0:14:22.80,0:14:24.73,Default,,0000,0000,0000,,Giờ cần xác minh xem\Nliệu đó có thực sự là ông ta hay không.
Dialogue: 0,0:14:31.47,0:14:33.44,Default,,0000,0000,0000,,Trưởng ban, có cuộc gọi\Nđường dây trực tiếp của ngài.
Dialogue: 0,0:14:33.44,0:14:34.31,Default,,0000,0000,0000,,Cái gì?
Dialogue: 0,0:14:35.34,0:14:36.31,Default,,0000,0000,0000,,Niimi đây.
Dialogue: 0,0:14:36.98,0:14:38.00,Default,,0000,0000,0000,,Có thật vậy không?
Dialogue: 0,0:14:38.15,0:14:39.55,Default,,0000,0000,0000,,Vâng, thưa ngài.\NĐúng vậy.
Dialogue: 0,0:14:39.55,0:14:41.45,Default,,0000,0000,0000,,Không, tôi sẽ xử lý\Nhắn ta ngay lập tức.
Dialogue: 0,0:14:44.75,0:14:46.25,Default,,0000,0000,0000,,Gayle? Tôi đây.
Dialogue: 0,0:14:46.25,0:14:49.09,Default,,0000,0000,0000,,Đã có vị trí của Imakurusu.\NLão đang ở Câu lạc bộ Đồng quê Kohoku.
Dialogue: 0,0:14:49.42,0:14:50.62,Default,,0000,0000,0000,,Mau tới đó ngay!
Dialogue: 0,0:14:51.79,0:14:52.78,Default,,0000,0000,0000,,Lão già ngu xuẩn...
Dialogue: 0,0:14:54.46,0:14:56.69,Default,,0000,0000,0000,,Tìm nhầm chỗ\Nđể cầu cứu rồi...
Dialogue: 0,0:14:57.77,0:15:00.10,Default,,0000,0000,0000,,{\i1}Vị trí của lão là{\i0}\N{\i1}Câu lạc bộ Đồng quê Kohoku.{\i0}
Dialogue: 0,0:15:00.44,0:15:05.60,Default,,0000,0000,0000,,{\i1}Lão được phát hiện tại trạm máy công cộng ở lề đường{\i0}\N{\i1}phía bắc cách đây hai phút.{\i0}
Dialogue: 0,0:15:14.15,0:15:14.78,Default,,0000,0000,0000,,Trúng phóc!
Dialogue: 0,0:15:14.78,0:15:16.75,Default,,0000,0000,0000,,{\i1}Nhưng kẻ mà lão vừa gọi điện tới{\i0}\N{\i1}mới là điều khiến tôi lo ngại.{\i0}
Dialogue: 0,0:15:16.75,0:15:18.12,Default,,0000,0000,0000,,Tôi chỉ cần biết\Nvị trí của lão thôi!
Dialogue: 0,0:15:18.12,0:15:20.65,Default,,0000,0000,0000,,Sếp già, tôi có thể tới đó nhanh hơn\NThiếu tá đấy! Tôi sẽ dùng trực thăng!
Dialogue: 0,0:15:20.82,0:15:22.85,Default,,0000,0000,0000,,Được rồi, phải bắt giữ ông ta\Ntrước bất kỳ ai khác.
Dialogue: 0,0:15:24.83,0:15:27.26,Default,,0000,0000,0000,,{\i1}Ishikawa, anh đã bám theo{\i0}\N{\i1}dấu vết của Imakurusu chưa?{\i0}
Dialogue: 0,0:15:27.36,0:15:29.99,Default,,0000,0000,0000,,{\i1}Sau cuộc gọi, lão đã vào{\i0}\N{\i1}phòng 909 ở khu phụ khách sạn.{\i0}
Dialogue: 0,0:15:30.33,0:15:31.92,Default,,0000,0000,0000,,{\i1}Hiện tại lão vẫn đang{\i0}\N{\i1}nằm im ở đó.{\i0}
Dialogue: 0,0:15:32.80,0:15:34.46,Default,,0000,0000,0000,,Borma, cậu nhìn xem\Ncái này là gì?
Dialogue: 0,0:15:35.00,0:15:35.97,Default,,0000,0000,0000,,Chỗ này này.
Dialogue: 0,0:15:36.74,0:15:40.77,Default,,0000,0000,0000,,Mã xác thực nắm quyền ưu tiên cao nhất\Ntrong danh sách nghe lén của Đế chế Mỹ sao?
Dialogue: 0,0:15:41.31,0:15:44.48,Default,,0000,0000,0000,,Ừ. Trên danh nghĩa chính thức\Nthì nó không tồn tại,
Dialogue: 0,0:15:44.48,0:15:47.18,Default,,0000,0000,0000,,nhưng chẳng phải đây là số liên lạc tới trụ sở\Ncủa Đảng cầm quyền hay sao?
Dialogue: 0,0:15:53.05,0:15:56.08,Default,,0000,0000,0000,,Chỉ huy thấy cỗ Giáp Chiến\NType-303 của Hải quân này thế nào?
Dialogue: 0,0:15:56.66,0:16:00.06,Default,,0000,0000,0000,,Hàng của Hải quân đúng là bóng bẩy mượt mà thật.\NMột tác phẩm nghệ thuật chết chóc.
Dialogue: 0,0:16:00.86,0:16:04.23,Default,,0000,0000,0000,,Giờ chỉ cần lũ đó mò tới là chúng ta\Ntha hồ thu thập dữ liệu thực chiến rồi...
Dialogue: 0,0:16:07.84,0:16:11.10,Default,,0000,0000,0000,,Thưa Chỉ huy! Đang có một chiếc trực thăng\Nbay thẳng về phía tòa nhà mục tiêu.
Dialogue: 0,0:16:11.54,0:16:12.71,Default,,0000,0000,0000,,Có vẻ là người của Đội 9.
Dialogue: 0,0:16:12.71,0:16:14.80,Default,,0000,0000,0000,,Chà chà!\NĐúng lúc quá còn gì!
Dialogue: 0,0:16:15.14,0:16:18.14,Default,,0000,0000,0000,,Được rồi, các cậu hãy trổ tài\Ntóm gọn Imakurusu cho tôi xem.
Dialogue: 0,0:16:18.71,0:16:20.77,Default,,0000,0000,0000,,Tôi sẽ mất một lúc\Nđể khởi động toàn bộ hệ thống.
Dialogue: 0,0:16:21.12,0:16:23.14,Default,,0000,0000,0000,,Khi đã khóa chặt đường lui của chúng,\Nphần còn lại cứ để tôi lo!
Dialogue: 0,0:16:29.16,0:16:30.28,Default,,0000,0000,0000,,Đó là...
Dialogue: 0,0:16:40.67,0:16:42.97,Default,,0000,0000,0000,,Imakurusu Hisashi phải không?\NTôi là cảnh sát đây.
Dialogue: 0,0:16:43.41,0:16:45.07,Default,,0000,0000,0000,,Bọn Cục Ma túy đang tới đây rồi.\NRút khỏi đây mau!
Dialogue: 0,0:16:45.94,0:16:47.03,Default,,0000,0000,0000,,Đừng có lại gần tôi!
Dialogue: 0,0:17:08.80,0:17:09.92,Default,,0000,0000,0000,,{\i1}Batou, cậu vẫn ổn chứ?{\i0}
Dialogue: 0,0:17:10.33,0:17:12.80,Default,,0000,0000,0000,,{\i1}Ừ, tạm thời là vậy.{\i0}\N{\i1}Nhưng bọn tôi đang bị ghìm chặt rồi.{\i0}
Dialogue: 0,0:17:13.17,0:17:14.76,Default,,0000,0000,0000,,{\i1}Cậu có thể thoát ra{\i0}\N{\i1}bằng trực thăng được không?{\i0}
Dialogue: 0,0:17:14.97,0:17:16.73,Default,,0000,0000,0000,,{\i1}Nếu phải tha theo lão già này{\i0}\N{\i1}thì chịu chết.{\i0}
Dialogue: 0,0:17:17.21,0:17:19.23,Default,,0000,0000,0000,,{\i1}Cố gắng cầm cự đi!{\i0}\N{\i1}Tôi sắp tới nơi rồi!{\i0}
Dialogue: 0,0:17:29.15,0:17:31.98,Default,,0000,0000,0000,,{\i1}Bọn chúng tàng hình được, nhưng không thể{\i0}\N{\i1}che giấu hoàn toàn dấu vết...{\i0}
Dialogue: 0,0:17:33.32,0:17:34.58,Default,,0000,0000,0000,,{\i1}Bước tiếp theo của chúng là gì đây...?{\i0}
Dialogue: 0,0:17:48.94,0:17:49.90,Default,,0000,0000,0000,,Thiếu tá đó hả?!
Dialogue: 0,0:17:51.47,0:17:54.34,Default,,0000,0000,0000,,Tôi đã mở đường thoát rồi.\NTạm thời lui về sảnh trước đã.
Dialogue: 0,0:17:56.75,0:17:57.64,Default,,0000,0000,0000,,Chạy mau!
Dialogue: 0,0:18:14.30,0:18:15.42,Default,,0000,0000,0000,,Nằm rạp xuống!
Dialogue: 0,0:18:20.14,0:18:21.10,Default,,0000,0000,0000,,Thứ quái gì thế kia?!
Dialogue: 0,0:18:24.34,0:18:25.77,Default,,0000,0000,0000,,Khốn kiếp,\Nlà Giáp Chiến Hạng Nặng!
Dialogue: 0,0:18:28.54,0:18:30.51,Default,,0000,0000,0000,,{\i1}Batou, tôi sẽ nhử nó đi.{\i0}
Dialogue: 0,0:18:30.51,0:18:32.98,Default,,0000,0000,0000,,{\i1}Đừng có điên! Chuyện đó{\i0}\N{\i1}cô cứ để{\i0} tôi {\i1}lo!{\i0}
Dialogue: 0,0:18:33.38,0:18:36.01,Default,,0000,0000,0000,,{\i1}Không phải tôi không tin cậu, nhưng một mình cậu{\i0}\N{\i1}không chặn nổi con quái vật đó đâu.{\i0}
Dialogue: 0,0:18:36.25,0:18:38.98,Default,,0000,0000,0000,,{\i1}Đây là mệnh lệnh của cấp trên.{\i0}\N{\i1}Mau đưa Imakurusu thoát khỏi đây ngay!{\i0}
Dialogue: 0,0:18:39.25,0:18:42.42,Default,,0000,0000,0000,,{\i1}Được rồi, tôi nghe...{\i0}\N{\i1}Nhưng đừng có để mất mạng đấy!{\i0}
Dialogue: 0,0:18:59.14,0:19:01.11,Default,,0000,0000,0000,,{\i1}Thiếu tá, chúng tôi gần tới nơi rồi!{\i0}
Dialogue: 0,0:20:05.84,0:20:07.54,Default,,0000,0000,0000,,Đến bắn trực diện mà cũng\Nkhông xuyên thủng nổi sao?!
Dialogue: 0,0:20:20.36,0:20:21.41,Default,,0000,0000,0000,,SAITO!
Dialogue: 0,0:20:21.82,0:20:24.16,Default,,0000,0000,0000,,ĐƯA ĐÂY CHO TA!
Dialogue: 0,0:20:34.20,0:20:36.10,Default,,0000,0000,0000,,N-Này, chờ đã!\NMở nắp khoang lái ra!
Dialogue: 0,0:20:39.37,0:20:40.14,Default,,0000,0000,0000,,Đừng có mở!
Dialogue: 0,0:21:07.24,0:21:08.86,Default,,0000,0000,0000,,K-Không thở nổi...
Dialogue: 0,0:21:09.50,0:21:10.66,Default,,0000,0000,0000,,Làm ơn mở nắp ra đi!
Dialogue: 0,0:21:17.11,0:21:19.01,Default,,0000,0000,0000,,Lại gần thêm chút nữa!\NTốt lắm!
Dialogue: 0,0:21:33.86,0:21:35.42,Default,,0000,0000,0000,,Đưa lão già này lên máy bay ngay lập tức!
Dialogue: 0,0:21:38.77,0:21:39.87,Default,,0000,0000,0000,,Thằng ngu đó...
Dialogue: 0,0:21:39.87,0:21:40.84,Default,,0000,0000,0000,,Ở yên đây!
Dialogue: 0,0:21:41.84,0:21:43.50,Default,,0000,0000,0000,,Này! Đứng yên đó,\Ncả hai người!
Dialogue: 0,0:21:46.21,0:21:47.90,Default,,0000,0000,0000,,Đúng rồi,\Nđứng im...
Dialogue: 0,0:21:59.32,0:22:00.29,Default,,0000,0000,0000,,Imakurusu!
Dialogue: 0,0:22:03.56,0:22:06.25,Default,,0000,0000,0000,,{\i1}Imakurusu bị trúng đạn rồi!{\i0}\N{\i1}Yêu cầu xe cấp cứu khẩn cấp!{\i0}
Dialogue: 0,0:22:10.43,0:22:15.03,Default,,0000,0000,0000,,Gã Mặt Cười...\NĐây mới chính là diện mạo thực sự của cậu sao?
Dialogue: 0,0:22:15.20,0:22:16.07,Default,,0000,0000,0000,,Cái gì?
Dialogue: 0,0:22:17.91,0:22:20.67,Default,,0000,0000,0000,,Gã Mặt Cười á?\NCậu đang lảm nhảm cái gì thế hả?
Dialogue: 0,0:22:25.65,0:22:27.05,Default,,0000,0000,0000,,Khoan đã, tập tài liệu này là...
Dialogue: 0,0:22:32.35,0:22:35.38,Default,,0000,0000,0000,,Ngụy trang quang học sao?\NKhông, không phải...
Dialogue: 0,0:22:35.92,0:22:39.95,Default,,0000,0000,0000,,Khốn kiếp! Mày đã hack\Nthẳng vào thị giác của tao đúng không?!
Dialogue: 0,0:22:47.37,0:22:49.50,Default,,0000,0000,0000,,Mày đang ở đâu?!\NMày đang ở gần đây phải không?!
Dialogue: 0,0:22:53.21,0:22:55.18,Default,,0000,0000,0000,,Mày rốt cuộc\Nđang ở cái xó nào hả?!
Dialogue: 0,0:22:55.18,0:22:57.18,Default,,0000,0000,0000,,{\an8\c&HFFFFFF&\fs22}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.50,0:23:20.85,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng vừa lạnh lùng vừa rất đỗi con người
Dialogue: 0,0:23:20.85,0:23:23.75,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.75,0:23:26.06,GitS ED Credits,,0000,0000,0000,,Nàng vẫn rạng rỡ đơn độc một mình
Dialogue: 0,0:23:26.06,0:23:29.12,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng chính là hiện thân của số chín
Dialogue: 0,0:23:29.12,0:23:31.87,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Một ẩn số toán học diệu kỳ
Dialogue: 0,0:23:33.13,0:23:36.15,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Một bài toán kỳ diệu đến không tưởng
Dialogue: 0,0:23:36.42,0:23:40.61,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.61,0:23:43.90,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng là một điều gì đó quá đỗi mới lạ
Dialogue: 0,0:23:43.90,0:23:46.15,GitS ED Credits,,0000,0000,0000,,Đóa hoa lithium vừa bừng tỉnh giấc
Dialogue: 0,0:23:46.15,0:23:49.01,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang hé nở rực rỡ
Dialogue: 0,0:23:49.10,0:23:51.81,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi ngửi thấy mùi lithium thoảng qua
Dialogue: 0,0:23:52.85,0:23:55.93,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Thoang thoảng hương lithium
Dialogue: 0,0:23:57.10,0:24:01.14,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:01.14,0:24:04.97,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:04.97,0:24:07.87,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:07.87,0:24:12.07,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tự hỏi nàng sẽ làm gì khi thức giấc?
Dialogue: 0,0:24:13.35,0:24:16.64,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Mỗi khi nàng tỉnh giấc?

