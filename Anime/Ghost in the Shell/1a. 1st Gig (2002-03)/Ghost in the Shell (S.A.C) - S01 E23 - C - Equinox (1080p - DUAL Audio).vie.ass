Dialogue: 0,0:01:41.71,0:01:43.81,Default,,0000,0000,0000,,Bọn chúng tăng cường tuần tra rồi hả?
Dialogue: 0,0:02:12.34,0:02:16.51,Default,,0000,0000,0000,,Ishikawa, có moi thêm được lời khai hữu ích nào từ đám tàn dư đội ma túy không?
Dialogue: 0,0:02:17.12,0:02:19.31,Default,,0000,0000,0000,,Chúng tôi không moi được nhiều thông tin giá trị từ lũ đó.
Dialogue: 0,0:02:19.69,0:02:23.62,Default,,0000,0000,0000,,Cấp trên trực tiếp của chúng là Cục trưởng Niimi thì đã toan tự sát não điện tử,
Dialogue: 0,0:02:24.09,0:02:26.02,Default,,0000,0000,0000,,nên manh mối đó coi như đã đi vào ngõ cụt.
Dialogue: 0,0:02:26.69,0:02:29.25,Default,,0000,0000,0000,,Và chúng ta cũng chưa lần ra tung tích của chính Gã Mặt Cười nữa.
Dialogue: 0,0:02:30.86,0:02:32.13,Default,,0000,0000,0000,,Đúng là như vậy.
Dialogue: 0,0:02:32.63,0:02:36.16,Default,,0000,0000,0000,,Theo chỉ thị của Trưởng ban, mục tiêu tiếp theo của chúng ta sẽ là nhân vật này.
Dialogue: 0,0:02:37.44,0:02:38.20,Default,,0000,0000,0000,,Đó là...
Dialogue: 0,0:02:38.64,0:02:39.87,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:02:39.87,0:02:43.34,Default,,0000,0000,0000,,Nghị viên Yakushima Kaoru, đương kim Tổng Thư ký của liên minh cầm quyền.
Dialogue: 0,0:02:43.34,0:02:47.14,Default,,0000,0000,0000,,Yakushima sao? Ông ta là nhân vật quyền lực nhất trong nội bộ đảng hiện nay,
Dialogue: 0,0:02:47.61,0:02:50.98,Default,,0000,0000,0000,,và cũng chính là Bộ trưởng Y tế vào thời điểm xảy ra vụ án Gã Mặt Cười.
Dialogue: 0,0:02:50.98,0:02:53.29,Default,,0000,0000,0000,,Một tay chân trung thành của Bộ Y tế, kẻ leo lên địa vị ngày hôm nay...
Dialogue: 0,0:02:53.29,0:02:57.79,Default,,0000,0000,0000,,...bằng cách chuyển giao thẩm quyền quản lý công nghệ não điện tử từ Bộ Công Thương sang cho Bộ Y tế.
Dialogue: 0,0:02:57.79,0:02:59.92,Default,,0000,0000,0000,,Và dù ít người biết đến,
Dialogue: 0,0:03:00.29,0:03:03.19,Default,,0000,0000,0000,,nhưng giữa ông ta và Lực lượng Phòng vệ Biển có một mối liên hệ ngầm mờ ám.
Dialogue: 0,0:03:03.56,0:03:05.72,Default,,0000,0000,0000,,Ý anh là cỗ Giáp Chiến đó bắt nguồn từ nơi ấy sao?
Dialogue: 0,0:03:06.20,0:03:08.19,Default,,0000,0000,0000,,Đó chính là điều mà Trưởng ban đang hoài nghi.
Dialogue: 0,0:03:09.14,0:03:12.73,Default,,0000,0000,0000,,Đường dây ngầm béo bở giữa giới chính khách và Lực lượng Phòng vệ Biển do chính Yakushima thiết lập,
Dialogue: 0,0:03:13.04,0:03:15.24,Default,,0000,0000,0000,,khi ông ta còn giữ chức Tham mưu trưởng Hải quân,
Dialogue: 0,0:03:15.24,0:03:18.70,Default,,0000,0000,0000,,trước khi bước chân vào chính trường với một lượng tiền vốn khổng lồ.
Dialogue: 0,0:03:19.38,0:03:21.61,Default,,0000,0000,0000,,Thế nhưng nguồn gốc của số tiền đó từng làm dấy lên nhiều nghi vấn,
Dialogue: 0,0:03:21.61,0:03:25.55,Default,,0000,0000,0000,,và kế toán trưởng của Hải quân từng tố cáo Yakushima biển thủ quỹ đen công.
Dialogue: 0,0:03:26.25,0:03:29.38,Default,,0000,0000,0000,,Tuy nhiên, vị công tố viên trưởng phụ trách vụ án đó lại bị phát hiện chết cán trên đường ray xe lửa,
Dialogue: 0,0:03:29.72,0:03:31.25,Default,,0000,0000,0000,,khiến cuộc điều tra bị đình trệ hoàn toàn.
Dialogue: 0,0:03:32.09,0:03:36.72,Default,,0000,0000,0000,,Rốt cuộc, Yakushima chưa từng bị truy tố, và những hoài nghi xung quanh ông ta vẫn chìm vào bóng tối.
Dialogue: 0,0:03:37.43,0:03:38.59,Default,,0000,0000,0000,,Vẫn còn nữa đấy.
Dialogue: 0,0:03:40.30,0:03:42.17,Default,,0000,0000,0000,,Tổng Thanh tra Cảnh sát Daido vừa mới nghỉ hưu,
Dialogue: 0,0:03:42.17,0:03:45.04,Default,,0000,0000,0000,,từng là đàn em khóa dưới của Yakushima tại Học viện Quốc phòng,
Dialogue: 0,0:03:45.80,0:03:50.04,Default,,0000,0000,0000,,và nghe đồn cố chủ tịch Imakurusu từng là bạn chơi golf thân cận của Yakushima...
Dialogue: 0,0:03:50.04,0:03:51.94,Default,,0000,0000,0000,,...từ thời còn là quân y trong quân đội.
Dialogue: 0,0:03:51.94,0:03:53.74,Default,,0000,0000,0000,,Cậu đã đi lại được rồi à?
Dialogue: 0,0:03:54.71,0:03:57.15,Default,,0000,0000,0000,,Tôi không thể là người duy nhất nằm bẹp trên giường trong lúc nước sôi lửa bỏng thế này.
Dialogue: 0,0:03:57.22,0:03:59.32,Default,,0000,0000,0000,,Điều đó có nghĩa là xét trên toàn bộ chuỗi biến cố này,
Dialogue: 0,0:03:59.32,0:04:04.76,Default,,0000,0000,0000,,ông ta có thừa quyền lực và động cơ để giật dây toàn bộ mọi việc sau cánh gà sao?
Dialogue: 0,0:04:05.09,0:04:08.46,Default,,0000,0000,0000,,Dù tại thời điểm này chúng ta chưa nắm trong tay lấy một mẩu bằng chứng.
Dialogue: 0,0:04:08.63,0:04:12.15,Default,,0000,0000,0000,,Vậy sếp định nhắm vào đương kim Tổng Thư ký Đảng bằng cách nào?
Dialogue: 0,0:04:12.46,0:04:14.57,Default,,0000,0000,0000,,Chúng ta sẽ lần theo sợi dây liên kết cuối cùng...
Dialogue: 0,0:04:14.57,0:04:17.13,Default,,0000,0000,0000,,...giữa Tổng Thư ký Yakushima và vụ án Gã Mặt Cười.
Dialogue: 0,0:04:18.17,0:04:19.83,Default,,0000,0000,0000,,Tập đoàn Serano Genomics.
Dialogue: 0,0:04:20.34,0:04:21.20,Default,,0000,0000,0000,,Chính xác.
Dialogue: 0,0:04:21.44,0:04:22.84,Default,,0000,0000,0000,,Sự việc bóp chết vắc-xin Murai,
Dialogue: 0,0:04:22.84,0:04:25.31,Default,,0000,0000,0000,,thứ mà chúng ta tin là nguồn cơn khởi đầu của vụ án Gã Mặt Cười,
Dialogue: 0,0:04:25.31,0:04:29.81,Default,,0000,0000,0000,,và liệu pháp vi máy móc của Serano được phê duyệt thần tốc ngay trong thời điểm đó.
Dialogue: 0,0:04:30.08,0:04:34.71,Default,,0000,0000,0000,,Nếu chúng ta tiếp cận và tạm giữ ngài Ernest Serano, nhân vật can dự sâu sắc vào cả hai việc,
Dialogue: 0,0:04:35.05,0:04:39.01,Default,,0000,0000,0000,,rồi tiến hành thẩm vấn ngay lập tức, mối liên hệ giữa hai bên chắc chắn sẽ sáng tỏ.
Dialogue: 0,0:04:39.36,0:04:41.83,Default,,0000,0000,0000,,Suốt sáu năm qua kể từ ngay sau vụ án đó cho tới tận hôm nay,
Dialogue: 0,0:04:41.83,0:04:44.80,Default,,0000,0000,0000,,ông Serano luôn bị quản thúc tại gia dưới danh nghĩa được cảnh sát bảo vệ nghiêm ngặt.
Dialogue: 0,0:04:45.36,0:04:48.73,Default,,0000,0000,0000,,Bằng mọi giá, lần này các cậu phải áp giải được ông ta về đây.
Dialogue: 0,0:04:48.73,0:04:52.04,Default,,0000,0000,0000,,Gã Mặt Cười có lẽ cũng đang toan tính điều tương tự.
Dialogue: 0,0:04:52.04,0:04:54.47,Default,,0000,0000,0000,,Chúng ta phải làm gì nếu chạm trán hắn?
Dialogue: 0,0:04:55.54,0:05:00.60,Default,,0000,0000,0000,,Bắt giữ hắn. Theo một góc độ nào đó, hắn là nhân chứng then chốt của toàn bộ vụ án này.
Dialogue: 0,0:05:02.38,0:05:06.08,Default,,0000,0000,0000,,Liệu có nguy cơ Serano sẽ bị thủ tiêu ngay khi chúng ta bắt đầu hành động không, như các lần trước?
Dialogue: 0,0:05:06.25,0:05:10.09,Default,,0000,0000,0000,,Tất nhiên là có. Chính vì thế tôi mới yêu cầu các cậu phải hành động bằng mọi giá.
Dialogue: 0,0:05:26.37,0:05:29.90,Default,,0000,0000,0000,,{\i1}Thưa ngài Serano, có cuộc gọi từ chi nhánh Hà Lan gọi tới ạ.{\i0}
Dialogue: 0,0:05:30.24,0:05:31.61,Default,,0000,0000,0000,,{\i1}Ngài muốn tôi xử lý thế nào ạ?{\i0}
Dialogue: 0,0:05:31.88,0:05:35.48,Default,,0000,0000,0000,,Bảo họ tôi sẽ gọi lại ngay khi tới văn phòng làm việc.
Dialogue: 0,0:05:35.48,0:05:36.65,Default,,0000,0000,0000,,{\i1}Tôi rõ rồi ạ.{\i0}
Dialogue: 0,0:05:36.65,0:05:40.48,Default,,0000,0000,0000,,Tôi thấy thật ngại khi cứ bắt cô phải đóng vai thư ký bất đắc dĩ suốt thế này.
Dialogue: 0,0:05:41.15,0:05:47.25,Default,,0000,0000,0000,,Dù vậy, cô là thám tử năng nổ và tháo vát nhất trong số những người từng được phân công bảo vệ tôi đấy.
Dialogue: 0,0:05:47.76,0:05:51.36,Default,,0000,0000,0000,,Cô thấy sao? Hay là sang làm thư ký thực thụ cho tôi nhé?
Dialogue: 0,0:05:51.66,0:05:53.10,Default,,0000,0000,0000,,Tôi sẽ trả mức đãi ngộ hậu hĩnh xứng đáng.
Dialogue: 0,0:05:53.43,0:05:54.73,Default,,0000,0000,0000,,{\i1}Cảm ơn ngài,{\i0}\N{\i1}nhưng tôi xin từ chối ạ.{\i0}
Dialogue: 0,0:05:54.73,0:05:57.33,Default,,0000,0000,0000,,{\i1}Có vẻ như xe của ngài{\i0}\N{\i1}đã tới nơi rồi ạ.{\i0}
Dialogue: 0,0:05:57.57,0:05:59.20,Default,,0000,0000,0000,,Tôi hiểu rồi. Cảm ơn cô.
Dialogue: 0,0:05:59.54,0:06:02.77,Default,,0000,0000,0000,,{\i1}Tôi sẽ lên hộ tống ngài xuống, xin ngài vui lòng đợi ở đó một lát.{\i0}
Dialogue: 0,0:06:03.34,0:06:06.94,Default,,0000,0000,0000,,Tình hình an ninh thắt chặt dạo này khiến tôi có chút bồn chồn lo lắng.
Dialogue: 0,0:06:07.65,0:06:09.44,Default,,0000,0000,0000,,{\i1}Chẳng có gì đáng phải bận tâm đâu ạ.{\i0}
Dialogue: 0,0:06:25.43,0:06:26.56,Default,,0000,0000,0000,,Cửa mở đấy.
Dialogue: 0,0:06:38.11,0:06:41.64,Default,,0000,0000,0000,,Kể từ lúc xem tin tức về Hội Hoa Hướng Dương và Imakurusu,
Dialogue: 0,0:06:41.98,0:06:44.85,Default,,0000,0000,0000,,tôi đã cam chịu một điều rằng nơi tiếp theo cậu tìm tới chắc chắn sẽ là chỗ này.
Dialogue: 0,0:06:46.59,0:06:49.61,Default,,0000,0000,0000,,{\i1}Tôi tới đây để bảo đảm rằng ông sẽ thực hiện trọn vẹn lời hứa từ sáu năm trước.{\i0}
Dialogue: 0,0:06:50.96,0:06:52.75,Default,,0000,0000,0000,,{\i1}Ông sẽ đi cùng tôi chứ?{\i0}
Dialogue: 0,0:06:56.90,0:06:58.66,Default,,0000,0000,0000,,Mục tiêu đã rời khỏi phòng.
Dialogue: 0,0:07:00.87,0:07:02.56,Default,,0000,0000,0000,,Ông ta đang hướng về phía sảnh chính.
Dialogue: 0,0:07:09.01,0:07:10.24,Default,,0000,0000,0000,,Chào buổi sáng, thưa ngài Serano.
Dialogue: 0,0:07:10.61,0:07:11.70,Default,,0000,0000,0000,,Chào buổi sáng.
Dialogue: 0,0:07:14.31,0:07:16.01,Default,,0000,0000,0000,,{\i1}Đang mở cửa sảnh chính.{\i0}
Dialogue: 0,0:07:18.95,0:07:20.04,Default,,0000,0000,0000,,Xin ngài cẩn thận.
Dialogue: 0,0:07:20.52,0:07:21.71,Default,,0000,0000,0000,,Cảm ơn.
Dialogue: 0,0:07:22.25,0:07:24.19,Default,,0000,0000,0000,,{\i1}Mục tiêu đã bước qua sảnh chính.{\i0}
Dialogue: 0,0:07:24.42,0:07:26.69,Default,,0000,0000,0000,,{\i1}Rõ rồi. Đã có hình ảnh quan sát.{\i0}
Dialogue: 0,0:07:40.51,0:07:42.30,Default,,0000,0000,0000,,Cảnh tượng này giống hệt như lần trước, đúng chứ?
Dialogue: 0,0:07:44.81,0:07:45.74,Default,,0000,0000,0000,,{\i1}Ông nói đúng.{\i0}
Dialogue: 0,0:07:45.74,0:07:49.70,Default,,0000,0000,0000,,{\i1}Điểm khác biệt duy nhất là đứng ở sảnh giờ là đám thám tử thay vì gia đình của ông.{\i0}
Dialogue: 0,0:07:51.05,0:07:53.21,Default,,0000,0000,0000,,{\i1}Và khi đó cũng không có xe bám đuôi theo sau chúng ta.{\i0}
Dialogue: 0,0:07:53.45,0:07:55.32,Default,,0000,0000,0000,,Vậy thì cậu định đối phó với bọn họ thế nào đây?
Dialogue: 0,0:07:56.12,0:07:57.42,Default,,0000,0000,0000,,{\i1}À, để xem nào...{\i0}
Dialogue: 0,0:07:58.86,0:08:02.52,Default,,0000,0000,0000,,{\i1}Tài xế, rẽ trái ở ngã tư tiếp theo.{\i0}
Dialogue: 0,0:08:07.00,0:08:08.13,Default,,0000,0000,0000,,Hành động này không giống ông ấy chút nào...
Dialogue: 0,0:08:08.13,0:08:09.40,Default,,0000,0000,0000,,Đừng để hắn cắt đuôi.
Dialogue: 0,0:08:16.84,0:08:21.61,Default,,0000,0000,0000,,{\i1}Sẽ mất khoảng một tiếng để chiếc xe cảnh sát ngụy trang đó tới được trụ sở Serano Genomics.{\i0}
Dialogue: 0,0:08:22.35,0:08:25.68,Default,,0000,0000,0000,,{\i1}Cho tới lúc đó, tôi muốn ông hãy nói cho tôi biết vì sao ông không giữ lời hứa,_{\i0}
Dialogue: 0,0:08:25.68,0:08:28.12,Default,,0000,0000,0000,,{\i1}và vì sao ông lại chọn cách giữ im lặng suốt sáu năm đằng đẵng vừa qua.{\i0}
Dialogue: 0,0:08:28.99,0:08:31.15,Default,,0000,0000,0000,,{\i1}Tôi cần phải đưa ra quyết định cho bước đi tiếp theo của mình.{\i0}
Dialogue: 0,0:08:31.99,0:08:33.36,Default,,0000,0000,0000,,Cậu quả thực vô cùng táo bạo đấy.
Dialogue: 0,0:08:44.84,0:08:47.21,Default,,0000,0000,0000,,Đứng yên! Đặt cả hai tay lên nắp capo ngay!
Dialogue: 0,0:08:47.21,0:08:48.67,Default,,0000,0000,0000,,Bình tĩnh nào.
Dialogue: 0,0:08:49.71,0:08:52.18,Default,,0000,0000,0000,,Chúng tôi thuộc Ban An ninh Công cộng số 9. Chúng tôi đã liên hệ với các anh từ trước rồi.
Dialogue: 0,0:08:53.15,0:08:55.94,Default,,0000,0000,0000,,Tôi nghe báo là ngài Serano đã rời đi rồi. Có đúng như vậy không?
Dialogue: 0,0:08:56.28,0:08:59.69,Default,,0000,0000,0000,,Xe chở ông ấy tới văn phòng vừa đi xong, như mọi ngày thôi. Có chuyện gì à?
Dialogue: 0,0:08:59.69,0:09:02.55,Default,,0000,0000,0000,,Nhìn lại đồng hồ của anh xem. Đó có đúng là khung giờ như mọi khi không?
Dialogue: 0,0:09:04.56,0:09:07.49,Default,,0000,0000,0000,,Chà chà, vị CEO đó đúng là người gương mẫu chăm chỉ gớm nhỉ?
Dialogue: 0,0:09:07.83,0:09:11.69,Default,,0000,0000,0000,,Cả lũ các người đều đã bị hắn hack mắt sạch sành sanh rồi!
Dialogue: 0,0:09:16.47,0:09:19.84,Default,,0000,0000,0000,,Lúc tôi gọi lên phòng, ngài Serano cũng chỉ có một mình mà.
Dialogue: 0,0:09:22.47,0:09:25.34,Default,,0000,0000,0000,,Có vẻ như AI của camera giám sát cũng bị hack rồi...
Dialogue: 0,0:09:27.61,0:09:28.74,Default,,0000,0000,0000,,"Medusa" sao?
Dialogue: 0,0:09:28.85,0:09:29.78,Default,,0000,0000,0000,,Thẻ căn cước của anh.
Dialogue: 0,0:09:29.78,0:09:30.44,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:09:30.78,0:09:31.84,Default,,0000,0000,0000,,Mau đưa ra đây.
Dialogue: 0,0:09:39.06,0:09:40.29,Default,,0000,0000,0000,,Thật là ngớ ngẩn hết chỗ nói...
Dialogue: 0,0:09:41.99,0:09:43.50,Default,,0000,0000,0000,,Lũ các người đúng là miếng mồi ngon dễ xơi.
Dialogue: 0,0:09:43.50,0:09:44.52,Default,,0000,0000,0000,,Cái gì thế kia?
Dialogue: 0,0:09:45.50,0:09:49.30,Default,,0000,0000,0000,,Thiết bị Đánh chặn Interceptor. Thật không thể tin nổi các anh vẫn bị cài bọ theo dõi bằng thứ này.
Dialogue: 0,0:09:50.74,0:09:55.90,Default,,0000,0000,0000,,Khi Interceptor tải dữ liệu lên mạng, nó sẽ trưng dụng bộ phát sóng trong não điện tử của đối tượng.
Dialogue: 0,0:09:56.58,0:09:58.98,Default,,0000,0000,0000,,Chắc hẳn thỉnh thoảng các anh cũng nhận thấy tải trọng thần kinh tăng đột biến nhỉ.
Dialogue: 0,0:10:04.02,0:10:05.28,Default,,0000,0000,0000,,Cái {\i1}quái quỷ{\i0} gì thế này?
Dialogue: 0,0:10:05.62,0:10:09.75,Default,,0000,0000,0000,,Não của các anh chỉ ghi nhận việc Serano tự mình bước đi một mình,
Dialogue: 0,0:10:10.19,0:10:13.21,Default,,0000,0000,0000,,nhưng {\i1}hình ảnh của hắn{\i0} lại hiển thị rõ mồn một trên Interceptor kìa.
Dialogue: 0,0:10:13.86,0:10:16.49,Default,,0000,0000,0000,,Đây chính xác là những gì đã xảy ra trong vụ bắt cóc sáu năm trước.
Dialogue: 0,0:10:18.60,0:10:23.16,Default,,0000,0000,0000,,{\i1}Thiếu tá, hãy lặn vào toàn bộ hệ thống Hồng ngoại trong bán kính 3km từ tư dinh Serano...{\i0}
Dialogue: 0,0:10:23.50,0:10:25.40,Default,,0000,0000,0000,,{\i1}... và tìm kiếm chiếc xe công vụ của ngài Serano ngay.{\i0}
Dialogue: 0,0:10:25.97,0:10:28.44,Default,,0000,0000,0000,,{\i1}Gã Mặt Cười lại bắt cóc ngài Serano thêm một lần nữa rồi.{\i0}
Dialogue: 0,0:10:29.31,0:10:30.90,Default,,0000,0000,0000,,{\i1}Bằng mọi giá phải tìm ra bọn họ!{\i0}
Dialogue: 0,0:10:31.18,0:10:35.17,Default,,0000,0000,0000,,{\i1}Rõ rồi. Nhưng không có gì đảm bảo chiếc xe đó sẽ hiển thị trên hệ thống Hồng ngoại đâu.{\i0}
Dialogue: 0,0:10:35.55,0:10:36.35,Default,,0000,0000,0000,,{\i1}Ishikawa!{\i0}
Dialogue: 0,0:10:36.35,0:10:38.68,Default,,0000,0000,0000,,{\i1}Tôi nghe thấy rồi. Đang bắt đầu quét tìm diện rộng.{\i0}
Dialogue: 0,0:10:39.22,0:10:41.28,Default,,0000,0000,0000,,{\i1}Hãy lưu ý đến khả năng AI bị ghi đè dữ liệu đấy.{\i0}
Dialogue: 0,0:10:41.72,0:10:42.69,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:10:58.00,0:11:00.77,Default,,0000,0000,0000,,Cứ chạy lòng vòng quanh khu vực này khoảng nửa tiếng đi.
Dialogue: 0,0:11:01.11,0:11:03.04,Default,,0000,0000,0000,,Tôi có chút việc riêng cần phải giải quyết.
Dialogue: 0,0:11:05.88,0:11:06.94,Default,,0000,0000,0000,,Đi thôi.
Dialogue: 0,0:11:14.12,0:11:17.75,Default,,0000,0000,0000,,Khung cảnh nhìn từ nơi này đã đổi thay khá nhiều rồi nhỉ?
Dialogue: 0,0:11:18.49,0:11:21.36,Default,,0000,0000,0000,,Tôi thấy tóc ông đã bạc trắng cả rồi, ngài Serano.
Dialogue: 0,0:11:21.69,0:11:23.68,Default,,0000,0000,0000,,Sáu năm qua quả thực là chuỗi ngày vô cùng gian khổ.
Dialogue: 0,0:11:23.76,0:11:27.76,Default,,0000,0000,0000,,Câu chuyện chính thức rêu rao rằng cảnh sát túc trực là để bảo vệ tôi trước những lời đe dọa từ cậu,
Dialogue: 0,0:11:28.13,0:11:30.40,Default,,0000,0000,0000,,nhưng thực chất bọn chúng ở đó là để giám sát tôi...
Dialogue: 0,0:11:30.40,0:11:33.80,Default,,0000,0000,0000,,...để đảm bảo tôi không mở mồm bép xép nửa lời về chân tướng đằng sau vụ án năm xưa.
Dialogue: 0,0:11:34.34,0:11:36.33,Default,,0000,0000,0000,,Xét trên mọi phương diện, tôi chẳng khác nào một kẻ đang chịu cảnh tù đày tại gia.
Dialogue: 0,0:11:36.98,0:11:40.24,Default,,0000,0000,0000,,So với hồi đó, tôi thấy cậu đã bớt đi phần nào nét ngây thơ non nớt rồi đấy.
Dialogue: 0,0:11:40.65,0:11:42.88,Default,,0000,0000,0000,,Có lẽ tôi cũng đã trưởng thành hơn đôi chút rồi.
Dialogue: 0,0:11:43.35,0:11:44.72,Default,,0000,0000,0000,,Tôi thừa nhận rằng vào thời điểm đó,
Dialogue: 0,0:11:44.72,0:11:48.88,Default,,0000,0000,0000,,tôi đã thực sự muốn tống một cú đá như trời giáng vào mông tất cả những kẻ giả tạo đê tiện trên đời,
Dialogue: 0,0:11:50.26,0:11:54.72,Default,,0000,0000,0000,,Dù sao thì chính bản thân ông hồi đó cũng khá liều lĩnh đấy chứ.
Dialogue: 0,0:11:55.36,0:11:58.12,Default,,0000,0000,0000,,Suốt hai ngày ròng rã, ông đã cùng trò chuyện với một cậu sinh viên vô danh tiểu tốt...
Dialogue: 0,0:11:58.46,0:12:03.03,Default,,0000,0000,0000,,...kẻ đã hack thẳng vào ông, bất chấp việc não bộ của mình đang bị xâm nhập mạng.
Dialogue: 0,0:12:03.70,0:12:06.14,Default,,0000,0000,0000,,Thời đó trong tôi vẫn còn đủ nhiệt huyết sục sôi...
Dialogue: 0,0:12:06.14,0:12:10.04,Default,,0000,0000,0000,,...khiến tôi muốn tranh luận đến cùng với một cậu sinh viên buông ra những lời lý tưởng viển vông.
Dialogue: 0,0:12:14.81,0:12:16.75,Default,,0000,0000,0000,,Tôi hiểu những gì cậu đang cố gắng truyền đạt,
Dialogue: 0,0:12:16.75,0:12:20.78,Default,,0000,0000,0000,,nhưng tôi là một nhà phát triển vi máy móc, chứ không phải thành viên Hội đồng Thẩm định Dược phẩm.
Dialogue: 0,0:12:21.12,0:12:23.62,Default,,0000,0000,0000,,Tôi hoàn toàn không can dự gì vào việc vắc-xin Murai bị bác bỏ phê duyệt cả.
Dialogue: 0,0:12:23.62,0:12:25.06,Default,,0000,0000,0000,,{\i1}Điều đó thì tôi hiểu.{\i0}
Dialogue: 0,0:12:25.06,0:12:28.19,Default,,0000,0000,0000,,{\i1}Thế nhưng Hội đồng Thẩm định Dược phẩm chỉ là một lũ lừa đảo giả tạo trơ tráo.{\i0}
Dialogue: 0,0:12:28.19,0:12:33.37,Default,,0000,0000,0000,,{\i1}Sẽ có ngày tôi lôi bọn chúng ra ánh sáng, nhưng trước hết,{\i0}\N{\i1}tôi muốn ông hãy công khai toàn bộ tập dữ liệu chứng minh...{\i0}
Dialogue: 0,0:12:33.37,0:12:37.40,Default,,0000,0000,0000,,{\i1}... rằng vi máy móc của công ty ông thực chất hoàn toàn vô tác dụng đối với chứng xơ cứng não điện tử.{\i0}
Dialogue: 0,0:12:37.40,0:12:40.70,Default,,0000,0000,0000,,Tôi đã nhắc đi nhắc lại với cậu bao nhiêu lần rồi, tôi không thể làm như vậy được!
Dialogue: 0,0:12:41.01,0:12:44.67,Default,,0000,0000,0000,,Tôi thừa nhận đúng như những gì cậu viết trong bức thư tống tiền ba năm trước,
Dialogue: 0,0:12:45.01,0:12:49.61,Default,,0000,0000,0000,,liệu pháp vi máy móc vào thời điểm đó chỉ dừng lại ở mức độ lý thuyết thuần túy.
Dialogue: 0,0:12:49.88,0:12:52.18,Default,,0000,0000,0000,,Thế nhưng đó chính là cách thức vận hành của bằng sáng chế!
Dialogue: 0,0:12:52.52,0:12:54.45,Default,,0000,0000,0000,,Pháp luật đâu có cấm đoán việc người ta là kẻ đầu tiên...
Dialogue: 0,0:12:54.45,0:12:57.51,Default,,0000,0000,0000,,...đăng ký độc quyền một công nghệ chắc chắn sẽ trở nên khả thi trong tương lai!
Dialogue: 0,0:12:57.86,0:13:00.85,Default,,0000,0000,0000,,{\i1}Đó là luận điệu quen thuộc mà lũ luật sư khốn kiếp vẫn luôn rêu rao.{\i0}
Dialogue: 0,0:13:01.29,0:13:02.35,Default,,0000,0000,0000,,{\i1}Chúa tôi ơi...{\i0}
Dialogue: 0,0:13:02.99,0:13:06.69,Default,,0000,0000,0000,,Tôi thừa biết rằng yêu cầu phê duyệt khi đó của chúng tôi là quá vội vã.
Dialogue: 0,0:13:07.23,0:13:10.29,Default,,0000,0000,0000,,Một phần trong đó là đòn nghi binh giương oai trước các đối thủ cạnh tranh.
Dialogue: 0,0:13:12.70,0:13:15.24,Default,,0000,0000,0000,,Thế nhưng tôi tin lý do chúng tôi nhận được cái gật đầu từ Hội đồng Thẩm định Dược phẩm...
Dialogue: 0,0:13:15.24,0:13:17.21,Default,,0000,0000,0000,,...chỉ sau vỏn vẹn ba tháng, nhanh hơn bất kỳ ai tưởng tượng,
Dialogue: 0,0:13:17.21,0:13:21.01,Default,,0000,0000,0000,,là bởi vì họ nhận ra các học thuyết của công ty tôi là ưu việt vượt trội.
Dialogue: 0,0:13:21.61,0:13:24.91,Default,,0000,0000,0000,,Cậu không thể hình dung nổi những tổn thất to lớn nhường nào sẽ ập đến...
Dialogue: 0,0:13:25.25,0:13:28.81,Default,,0000,0000,0000,,...nếu niềm tin vào ứng dụng vi máy móc y tế bị sụp đổ ngay lúc này đâu.
Dialogue: 0,0:13:29.19,0:13:31.16,Default,,0000,0000,0000,,Cậu đang nhẫn tâm bóp chết một công nghệ sở hữu tiềm năng vô hạn...
Dialogue: 0,0:13:31.22,0:13:34.85,Default,,0000,0000,0000,,{\i1}Điều tôi muốn nói ở đây là chuyện này liên quan trực tiếp đến sinh tử của con người...{\i0}
Dialogue: 0,0:13:35.19,0:13:37.42,Default,,0000,0000,0000,,{\i1}... đối với những bệnh nhân đang ngày đêm quằn quại trong đau đớn vì chứng xơ cứng não điện tử.{\i0}
Dialogue: 0,0:13:37.76,0:13:41.49,Default,,0000,0000,0000,,{\i1}Ít nhất thì ông không thể công nhận hiệu quả của vắc-xin Murai...{\i0}
Dialogue: 0,0:13:41.80,0:13:44.89,Default,,0000,0000,0000,,{\i1}... cho tới khi liệu pháp vi máy móc đem lại kết quả thực tế rõ ràng hay sao?{\i0}
Dialogue: 0,0:13:45.27,0:13:48.51,Default,,0000,0000,0000,,Tôi không có gì để bình luận về Murai cả.
Dialogue: 0,0:13:48.51,0:13:50.30,Default,,0000,0000,0000,,{\i1}Ông thực sự có thể thốt ra những lời đó sao?{\i0}
Dialogue: 0,0:13:50.64,0:13:55.51,Default,,0000,0000,0000,,{\i1}Nếu lão Thượng đế khốn khiếp giáng chứng xơ cứng não điện tử xuống đầu ông vì trò đùa dai,{\i0}
Dialogue: 0,0:13:55.85,0:13:59.28,Default,,0000,0000,0000,,{\i1}liệu ông có nhắm mắt chọn ngay liệu pháp vi máy móc mà không cần đắn đo suy nghĩ một giây nào không?{\i0}
Dialogue: 0,0:13:59.45,0:14:03.48,Default,,0000,0000,0000,,Tất nhiên rồi. Tôi có niềm tự hào và đức tin tuyệt đối vào sản phẩm của công ty mình.
Dialogue: 0,0:14:03.79,0:14:07.35,Default,,0000,0000,0000,,{\i1}Vậy ông vẫn sẽ chọn nó nếu người mắc phải căn bệnh đó chính là những đứa con ruột thịt của ông chứ?{\i0}
Dialogue: 0,0:14:07.93,0:14:10.43,Default,,0000,0000,0000,,Đúng vậy. Tôi nghĩ là tôi vẫn sẽ chọn.
Dialogue: 0,0:14:10.43,0:14:12.66,Default,,0000,0000,0000,,Thôi nào, chúng ta hãy dẹp mấy câu hỏi giả định đó sang một bên đi.
Dialogue: 0,0:14:15.60,0:14:18.30,Default,,0000,0000,0000,,{\i1}Niềm tự hào và tình cảm gia đình là hai chuyện hoàn toàn khác nhau, đúng chứ?{\i0}
Dialogue: 0,0:14:18.30,0:14:19.83,Default,,0000,0000,0000,,{\i1}Ông chơi không đẹp chút nào đâu, ngài Serano.{\i0}
Dialogue: 0,0:14:20.44,0:14:23.03,Default,,0000,0000,0000,,{\i1}Nếu ông thực sự tự hào về liệu pháp vi máy móc đến thế,{\i0}
Dialogue: 0,0:14:23.68,0:14:26.61,Default,,0000,0000,0000,,{\i1}ông nên tận dụng vị thế quyền lực của mình để làm điều đúng đắn.{\i0}
Dialogue: 0,0:14:27.65,0:14:30.12,Default,,0000,0000,0000,,{\i1}Thứ duy nhất mà Imakurusu có thể nghĩ tới...{\i0}
Dialogue: 0,0:14:30.12,0:14:32.88,Default,,0000,0000,0000,,{\i1}... chỉ là dập tắt loại vắc-xin mang tên Tiến sĩ Murai.{\i0}
Dialogue: 0,0:14:33.62,0:14:36.82,Default,,0000,0000,0000,,{\i1}Cái Hội đồng Thẩm định Dược phẩm thối nát đó, nơi chỉ có độc một nhiệm vụ là đóng dấu duyệt...{\i0}
Dialogue: 0,0:14:36.82,0:14:39.79,Default,,0000,0000,0000,,{\i1}... cho bất kỳ loại thuốc mới nào được Bộ Y tế bật đèn xanh,{\i0}
Dialogue: 0,0:14:40.19,0:14:42.59,Default,,0000,0000,0000,,{\i1}lại được chủ trì bởi Imakurusu,{\i0}
Dialogue: 0,0:14:42.59,0:14:45.72,Default,,0000,0000,0000,,{\i1}kẻ đã đặc chế riêng một con dấu chỉ để bác bỏ vắc-xin Murai...{\i0}
Dialogue: 0,0:14:45.93,0:14:47.69,Default,,0000,0000,0000,,{\i1}... mang dòng chữ khắc chìm "Bác Bỏ Phê Duyệt"!{\i0}
Dialogue: 0,0:14:48.10,0:14:52.13,Default,,0000,0000,0000,,{\i1}Chính vi máy móc của công ty ông đã bị lợi dụng trong phi vụ bẩn thỉu đó!{\i0}
Dialogue: 0,0:14:52.54,0:14:56.97,Default,,0000,0000,0000,,{\i1}Ông không thể hoàn toàn phủ nhận việc mình không hay biết bối cảnh ấy, ngài Serano.{\i0}
Dialogue: 0,0:14:57.44,0:15:00.43,Default,,0000,0000,0000,,{\i1}Đối với bọn chúng, thứ được duyệt có phải là vi máy móc của ông hay không cũng chẳng quan trọng.{\i0}
Dialogue: 0,0:15:01.15,0:15:03.72,Default,,0000,0000,0000,,{\i1}Bất kỳ thứ vi máy móc chết tiệt nào nộp hồ sơ xin cấp phép vào thời điểm đó...{\i0}
Dialogue: 0,0:15:03.72,0:15:05.62,Default,,0000,0000,0000,,{\i1}... cũng đều sẽ trở thành công cụ đắc lực cho chúng!{\i0}
Dialogue: 0,0:15:06.18,0:15:08.21,Default,,0000,0000,0000,,{\i1}Nếu ông đã thấu rõ cái ngành công nghiệp y tế mục ruỗng này thối nát nhường nào,{\i0}
Dialogue: 0,0:15:08.55,0:15:11.89,Default,,0000,0000,0000,,liệu ông có thể trơ trẽn bảo rằng chuyện đó chẳng liên quan gì đến mình hay không?!
Dialogue: 0,0:15:15.63,0:15:17.36,Default,,0000,0000,0000,,Được rồi. Vậy chúng ta hãy làm thế này đi.
Dialogue: 0,0:15:17.66,0:15:20.63,Default,,0000,0000,0000,,Tạm thời hãy thả tôi ra và để tôi được hành động độc lập.
Dialogue: 0,0:15:20.97,0:15:22.80,Default,,0000,0000,0000,,Sau khi tôi hoàn tất mọi khâu chuẩn bị,
Dialogue: 0,0:15:22.80,0:15:26.83,Default,,0000,0000,0000,,tôi sẽ triệu tập một buổi họp báo và công khai toàn bộ thực trạng hiện tại của liệu pháp vi máy móc.
Dialogue: 0,0:15:27.64,0:15:31.60,Default,,0000,0000,0000,,Ông nói nghiêm túc đấy chứ? Lời hứa đó chẳng đem lại chút lợi lộc nào cho ông cả.
Dialogue: 0,0:15:32.38,0:15:34.81,Default,,0000,0000,0000,,Tôi không phải là kẻ tiểu nhân bủn xỉn hẹp hòi đến mức đó.
Dialogue: 0,0:15:34.81,0:15:36.55,Default,,0000,0000,0000,,Có thể nó không vĩ đại như lý tưởng của cậu,
Dialogue: 0,0:15:36.55,0:15:39.81,Default,,0000,0000,0000,,nhưng tôi tin mình cũng có ý thức về công lý xã hội hệt như bất kỳ ai khác.
Dialogue: 0,0:15:40.55,0:15:41.59,Default,,0000,0000,0000,,{\i1}Để rồi xem.{\i0}
Dialogue: 0,0:15:41.59,0:15:42.92,Default,,0000,0000,0000,,Tôi xin lấy danh dự ra bảo đảm.
Dialogue: 0,0:15:49.36,0:15:52.76,Default,,0000,0000,0000,,Thời điểm đó, tôi đã kiệt sức sau đợt lặn mạng của cậu,
Dialogue: 0,0:15:53.13,0:15:55.83,Default,,0000,0000,0000,,và tôi đã vội vã đưa ra lời hứa hẹn ấy với hy vọng được giải thoát.
Dialogue: 0,0:15:56.27,0:15:59.14,Default,,0000,0000,0000,,Tôi nghĩ rằng nếu có thể đưa cậu ra trước ống kính truyền hình, trước hàng triệu con mắt của công chúng,
Dialogue: 0,0:15:59.47,0:16:02.44,Default,,0000,0000,0000,,cậu sẽ không dám làm ra bất kỳ hành động điên rồ nào.
Dialogue: 0,0:16:03.81,0:16:04.78,Default,,0000,0000,0000,,Đúng vậy...
Dialogue: 0,0:16:05.21,0:16:10.24,Default,,0000,0000,0000,,Thế nhưng trớ trêu thay, trong túi áo tôi khi đó lại có khẩu súng lục S&W.
Dialogue: 0,0:16:12.05,0:16:14.21,Default,,0000,0000,0000,,Cậu sẽ giải trừ phiên lặn não chứ?
Dialogue: 0,0:16:14.69,0:16:18.65,Default,,0000,0000,0000,,Ngay cả {\i1}cậu{\i0} cũng phải nhận thức được những gì mình đang làm là phạm pháp.
Dialogue: 0,0:16:18.99,0:16:21.66,Default,,0000,0000,0000,,Nếu cậu muốn che giấu khuôn mặt và duy trì danh tính ẩn danh của mình,
Dialogue: 0,0:16:21.66,0:16:23.72,Default,,0000,0000,0000,,thì việc để hình ảnh bị phát sóng trên truyền hình không phải là một ý kiến khôn ngoan đâu.
Dialogue: 0,0:16:30.27,0:16:32.53,Default,,0000,0000,0000,,Tôi rất thích những cuộc tranh luận với cậu.
Dialogue: 0,0:16:33.24,0:16:37.33,Default,,0000,0000,0000,,Nhưng với tư cách là người gánh vác vận mệnh của cả một doanh nghiệp, có thể tôi sẽ không thể giữ trọn lời hứa.
Dialogue: 0,0:16:37.71,0:16:40.80,Default,,0000,0000,0000,,Xã hội này không hề rạch ròi và đơn giản như cậu nghĩ đâu.
Dialogue: 0,0:16:41.25,0:16:44.11,Default,,0000,0000,0000,,Tôi cũng sẽ không cố truy lùng danh tính thực sự của cậu làm gì.
Dialogue: 0,0:16:44.72,0:16:46.58,Default,,0000,0000,0000,,Tạm thời, chúng ta hãy đường ai nấy đi tại đây.
Dialogue: 0,0:16:52.59,0:16:53.96,Default,,0000,0000,0000,,Chơi thế là không đẹp chút nào!
Dialogue: 0,0:17:03.54,0:17:07.16,Default,,0000,0000,0000,,{\i1}Vậy thì hãy nhìn thẳng vào ống kính máy quay đằng kia và nói ra sự thật đi!{\i0}
Dialogue: 0,0:17:07.97,0:17:10.03,Default,,0000,0000,0000,,{\i1}Dừng lại đi. Cậu sẽ không nổ súng bắn tôi đâu.{\i0}
Dialogue: 0,0:17:10.64,0:17:11.84,Default,,0000,0000,0000,,{\i1}Ông dám chắc về điều đó chứ?{\i0}
Dialogue: 0,0:17:25.06,0:17:27.96,Default,,0000,0000,0000,,Về sau, khi được cảnh sát đưa về diện bảo vệ đặc biệt,
Dialogue: 0,0:17:28.19,0:17:30.30,Default,,0000,0000,0000,,tôi mới hay tin từ một vị giám đốc công ty tới thăm...
Dialogue: 0,0:17:30.30,0:17:33.03,Default,,0000,0000,0000,,...rằng hai ngày tôi trải qua cùng cậu...
Dialogue: 0,0:17:33.43,0:17:36.26,Default,,0000,0000,0000,,...đã biến thành một vụ bắt cóc chấn động làm rung chuyển toàn bộ xã hội.
Dialogue: 0,0:17:37.64,0:17:40.11,Default,,0000,0000,0000,,Tôi cũng được biết rằng ngay sau khi tôi rời khỏi nhà cùng cậu,
Dialogue: 0,0:17:40.11,0:17:44.77,Default,,0000,0000,0000,,một yêu sách đòi tiền chuộc khổng lồ đã được gửi tới tập đoàn.
Dialogue: 0,0:17:46.01,0:17:50.64,Default,,0000,0000,0000,,Thế nhưng tôi không thể tin nổi người đưa ra yêu sách đó lại là cậu.
Dialogue: 0,0:17:50.85,0:17:54.88,Default,,0000,0000,0000,,Việc cậu là một hacker thiên tài không làm thay đổi sự thật rằng cậu là một tội phạm,
Dialogue: 0,0:17:55.22,0:17:58.52,Default,,0000,0000,0000,,nhưng đối với tôi, dường như cậu chỉ dùng những tài năng xuất chúng đó...
Dialogue: 0,0:17:58.52,0:18:02.48,Default,,0000,0000,0000,,...để chiến đấu chống lại sự bất công của thế giới bằng nhiệt huyết chính nghĩa của tuổi trẻ.
Dialogue: 0,0:18:03.63,0:18:07.86,Default,,0000,0000,0000,,Thế nhưng cảnh sát lại khăng khăng kết luận rằng cậu bắt cóc tôi vì tiền chuộc,
Dialogue: 0,0:18:08.30,0:18:12.53,Default,,0000,0000,0000,,và họ thẩm vấn tôi hết lần này đến lần khác, gặng hỏi xem tôi có biết điều gì hữu ích hay không.
Dialogue: 0,0:18:13.24,0:18:18.27,Default,,0000,0000,0000,,Nhưng tôi và vị giám đốc quyết định giữ vững lời khai rằng chúng tôi chẳng nghĩ ra được bất cứ manh mối nào.
Dialogue: 0,0:18:19.18,0:18:21.68,Default,,0000,0000,0000,,Chúng tôi không thể để xảy ra một tình thế dẫn tới sự nghi ngờ...
Dialogue: 0,0:18:21.68,0:18:23.91,Default,,0000,0000,0000,,...rằng vi máy móc của công ty chúng tôi có khuyết tật.
Dialogue: 0,0:18:25.05,0:18:29.32,Default,,0000,0000,0000,,Đúng như lời cậu nói, chúng tôi đã bị dạy cho một bài học vì lương tâm cắn rứt.
Dialogue: 0,0:18:30.22,0:18:33.73,Default,,0000,0000,0000,,Bí mật về vi máy móc của chúng tôi bị đem ra làm con tin,
Dialogue: 0,0:18:33.73,0:18:36.32,Default,,0000,0000,0000,,và một khoản tiền chuộc khổng lồ đã bị tống ép.
Dialogue: 0,0:18:38.16,0:18:43.00,Default,,0000,0000,0000,,Và rồi sau đó, vụ án virus sát thủ tiêu diệt vi máy móc đã nổ ra.
Dialogue: 0,0:18:43.00,0:18:44.04,Default,,0000,0000,0000,,Chính xác là như vậy.
Dialogue: 0,0:18:44.04,0:18:46.24,Default,,0000,0000,0000,,Ngay cả khi tôi đang giận dữ với chính bản thân mình vì đã vui mừng khôn xiết...
Dialogue: 0,0:18:46.24,0:18:49.30,Default,,0000,0000,0000,,...khi liệu pháp vi máy móc của chúng tôi được phê duyệt,
Dialogue: 0,0:18:49.64,0:18:51.73,Default,,0000,0000,0000,,thì cùng lúc đó tôi cũng đang nguyền rủa cậu từ tận đáy lòng.
Dialogue: 0,0:18:52.31,0:18:55.28,Default,,0000,0000,0000,,Tôi đã nghĩ: "Đây đích thị là hành vi khủng bố doanh nghiệp trắng trợn!"
Dialogue: 0,0:18:56.11,0:18:58.58,Default,,0000,0000,0000,,Thế nhưng đó đâu phải là do cậu làm, đúng chứ?
Dialogue: 0,0:18:59.12,0:19:05.18,Default,,0000,0000,0000,,Cái ác ẩn nấp trong thế giới này tồn tại ở một đẳng cấp cao hơn nhiều so với những gì chúng ta tưởng tượng.
Dialogue: 0,0:19:06.66,0:19:11.99,Default,,0000,0000,0000,,Tôi đồ rằng cậu thừa biết chúng tôi đã tống tiền các công ty được rót vốn...
Dialogue: 0,0:19:12.46,0:19:15.83,Default,,0000,0000,0000,,...từ ngân sách công quỹ vì chúng tôi đang đứng bên bờ vực phá sản do thảm họa virus sát thủ.
Dialogue: 0,0:19:16.07,0:19:18.66,Default,,0000,0000,0000,,Để tôi kể cho cậu nghe những gì đã xảy ra sau đó.
Dialogue: 0,0:19:19.80,0:19:24.26,Default,,0000,0000,0000,,Cùng lúc giá cổ phiếu của chúng tôi bắt đầu dần hồi phục sau cú sụp đổ thảm hại,
Dialogue: 0,0:19:24.61,0:19:27.94,Default,,0000,0000,0000,,chúng tôi được một người đàn ông tìm tới gặp, tự xưng là thành viên...
Dialogue: 0,0:19:28.28,0:19:30.37,Default,,0000,0000,0000,,...trong hội cổ động viên ủng hộ riêng của một nghị viên quốc hội nào đó.
Dialogue: 0,0:19:30.72,0:19:34.38,Default,,0000,0000,0000,,Hắn nói hắn có quen biết với một người có thể chấm dứt các vụ tống tiền doanh nghiệp,
Dialogue: 0,0:19:34.82,0:19:38.39,Default,,0000,0000,0000,,và hỏi liệu chúng tôi có sẵn lòng đóng góp một khoản quyên góp chính trị cho vị nghị viên này hay không...
Dialogue: 0,0:19:38.39,0:19:41.69,Default,,0000,0000,0000,,...trong trường hợp có một tuyên bố chính thức được đưa ra rằng các vụ tống tiền sẽ chấm dứt hoàn toàn.
Dialogue: 0,0:19:43.43,0:19:45.90,Default,,0000,0000,0000,,Số tiền mà hắn đề xuất tương đương với toàn bộ số vốn công...
Dialogue: 0,0:19:45.90,0:19:48.46,Default,,0000,0000,0000,,...cộng thêm cả số tiền bị đòi tống tiền nữa.
Dialogue: 0,0:19:49.30,0:19:53.87,Default,,0000,0000,0000,,Điều này chứng tỏ rõ ràng rằng Serano Genomics ngay từ đầu đã trở thành mục tiêu tống tiền...
Dialogue: 0,0:19:53.87,0:19:57.17,Default,,0000,0000,0000,,...chỉ bởi vì chúng tôi là kẻ gia nhập muộn màng nhất trong số các nhà sản xuất.
Dialogue: 0,0:19:57.54,0:20:02.38,Default,,0000,0000,0000,,Đối với bọn chúng, hành động bồng bột của tôi khi ấy ắt hẳn giống như một màn trình diễn xuất hiện đúng lúc hoàn hảo.
Dialogue: 0,0:20:02.38,0:20:04.18,Default,,0000,0000,0000,,Tôi cho rằng đúng là như vậy.
Dialogue: 0,0:20:04.45,0:20:07.82,Default,,0000,0000,0000,,Bằng cách tiếp tục sao chép bắt chước vụ án do cậu châm ngòi,
Dialogue: 0,0:20:07.82,0:20:10.31,Default,,0000,0000,0000,,bọn chúng đã nhào nặn nên một biểu tượng ngụy tạo mang tên Gã Mặt Cười.
Dialogue: 0,0:20:10.76,0:20:13.95,Default,,0000,0000,0000,,Chúng thao túng giá cổ phiếu bằng cách mượn danh một tên tội phạm không hề có thật,
Dialogue: 0,0:20:14.29,0:20:16.69,Default,,0000,0000,0000,,và bòn rút tiền của các tập đoàn doanh nghiệp khác ngoài chúng tôi.
Dialogue: 0,0:20:17.63,0:20:19.83,Default,,0000,0000,0000,,Bất chấp một thực tế là ngay cả trước đó, chúng có lẽ đã...
Dialogue: 0,0:20:19.83,0:20:22.46,Default,,0000,0000,0000,,...bỏ túi những món hời béo bở từ việc bán khống cổ phiếu.
Dialogue: 0,0:20:23.17,0:20:26.40,Default,,0000,0000,0000,,Vị nghị viên đó chính là Tổng Thư ký Yakushima, đúng không?
Dialogue: 0,0:20:28.01,0:20:29.37,Default,,0000,0000,0000,,Cậu đã biết từ trước rồi sao?
Dialogue: 0,0:20:29.87,0:20:35.37,Default,,0000,0000,0000,,Về căn bản, hacker sinh ra là để dòm ngó những bí mật bị kẻ khác giấu giếm.
Dialogue: 0,0:20:36.01,0:20:40.58,Default,,0000,0000,0000,,Thế nhưng chiều sâu tăm tối trong cái ổ tham nhũng nhung nhúc mà tôi từng cố đối đầu đã đánh bại tôi hoàn toàn,
Dialogue: 0,0:20:40.92,0:20:45.95,Default,,0000,0000,0000,,và tất cả những gì tôi có thể làm là giả câm giả điếc và ngoảnh mặt làm ngơ trước tất cả.
Dialogue: 0,0:20:46.99,0:20:49.36,Default,,0000,0000,0000,,Hệt như những gì ông đã làm suốt sáu năm qua vậy.
Dialogue: 0,0:20:52.13,0:20:55.90,Default,,0000,0000,0000,,Gã Mặt Cười... Đó quả là một cái tên hay mà bọn chúng đã nghĩ ra.
Dialogue: 0,0:20:56.30,0:20:59.83,Default,,0000,0000,0000,,Và ở đây tôi từng nghĩ rằng nếu thất bại trong việc thuyết phục ông,
Dialogue: 0,0:21:00.17,0:21:02.50,Default,,0000,0000,0000,,tôi sẽ chỉ đơn giản làm theo câu trích dẫn của Holden mà biến mất khỏi thế gian...
Dialogue: 0,0:21:03.34,0:21:06.37,Default,,0000,0000,0000,,Bọn họ đã lần theo manh mối Salinger... Thật là hết nước nói.
Dialogue: 0,0:21:08.65,0:21:13.61,Default,,0000,0000,0000,,Này ngài Serano, nếu bọn chúng đã làm đến nước này, tôi buộc phải trở thành Gã Mặt Cười nguyên bản...
Dialogue: 0,0:21:13.95,0:21:16.55,Default,,0000,0000,0000,,...và lôi cổ tên Yakushima giả tạo trơ trẽn đó ra trước ánh sáng công lý.
Dialogue: 0,0:21:17.02,0:21:20.18,Default,,0000,0000,0000,,Khi cậu xuất hiện trước mặt tôi, tôi cũng đã hạ quyết tâm rồi.
Dialogue: 0,0:21:20.53,0:21:23.93,Default,,0000,0000,0000,,Dù không có nhiều bằng chứng trực tiếp để buộc tội hắn,
Dialogue: 0,0:21:24.40,0:21:27.36,Default,,0000,0000,0000,,nhưng tôi sẽ trở thành kẻ bắt chước của cậu và cùng chiến đấu chống lại hắn.
Dialogue: 0,0:21:32.94,0:21:36.34,Default,,0000,0000,0000,,Đừng có chết trước khi ông bước lên bục nhân chứng đấy nhé.
Dialogue: 0,0:21:37.38,0:21:38.27,Default,,0000,0000,0000,,Chắc chắn rồi.
Dialogue: 0,0:21:39.48,0:21:40.94,Default,,0000,0000,0000,,{\i1}Đội 2, sẵn sàng.{\i0}
Dialogue: 0,0:21:41.21,0:21:42.51,Default,,0000,0000,0000,,{\i1}Đội 3, sẵn sàng.{\i0}
Dialogue: 0,0:21:43.15,0:21:44.41,Default,,0000,0000,0000,,{\i1}Đội 4, sẵn sàng.{\i0}
Dialogue: 0,0:21:44.75,0:21:46.38,Default,,0000,0000,0000,,{\i1}Tất cả các đội đã vào vị trí.{\i0}
Dialogue: 0,0:21:46.68,0:21:48.88,Default,,0000,0000,0000,,{\i1}Hệ thống an ninh của tòa nhà hiện đã nằm trong tầm kiểm soát của chúng ta.{\i0}
Dialogue: 0,0:21:49.29,0:21:49.99,Default,,0000,0000,0000,,{\i1}Batou.{\i0}
Dialogue: 0,0:21:49.99,0:21:51.35,Default,,0000,0000,0000,,{\i1}Đối tượng không có chuyển biến gì mới.{\i0}
Dialogue: 0,0:21:52.19,0:21:53.05,Default,,0000,0000,0000,,Đột kích vào trong!
Dialogue: 0,0:22:06.74,0:22:07.80,Default,,0000,0000,0000,,Tất cả đứng yên!
Dialogue: 0,0:22:09.41,0:22:10.47,Default,,0000,0000,0000,,Đứng yên tại chỗ!
Dialogue: 0,0:22:12.98,0:22:15.17,Default,,0000,0000,0000,,{\i1}Đã khống chế đối tượng B. Ông ta chỉ có một mình.{\i0}
Dialogue: 0,0:22:16.58,0:22:18.48,Default,,0000,0000,0000,,{\i1}Không thấy dấu vết của đối tượng A đâu cả.{\i0}
Dialogue: 0,0:22:19.28,0:22:20.65,Default,,0000,0000,0000,,{\i1}Giữ nguyên vị trí ở đó.{\i0}
Dialogue: 0,0:22:25.99,0:22:27.89,Default,,0000,0000,0000,,Màn diễn xuất đỉnh đấy chứ.
Dialogue: 0,0:22:29.16,0:22:32.32,Default,,0000,0000,0000,,Trình diễn thế này thì cậu lừa ai mà chẳng được một cách dễ dàng.
Dialogue: 0,0:22:33.40,0:22:35.83,Default,,0000,0000,0000,,{\i1}Thế mà hồi đi học tôi chưa từng tham gia vở kịch nào ở trường đâu đấy.{\i0}
Dialogue: 0,0:22:42.97,0:22:46.07,Default,,0000,0000,0000,,Tôi đoán việc này coi như đã chốt hạ mối liên hệ giữa Yakushima và Serano rồi nhỉ?
Dialogue: 0,0:22:46.28,0:22:50.04,Default,,0000,0000,0000,,Phải. Và những gì Gã Mặt Cười nói với tôi cũng hoàn toàn là sự thật.
Dialogue: 0,0:22:50.78,0:22:53.01,Default,,0000,0000,0000,,Việc này chắc hẳn cũng đã châm ngòi đốt lửa dưới mông ngài Serano rồi.
Dialogue: 0,0:22:53.65,0:22:54.98,Default,,0000,0000,0000,,Kế hoạch này có thể sẽ thành công đấy.
Dialogue: 0,0:22:54.98,0:22:56.98,Default,,0000,0000,0000,,{\an8\c&HFFFFFF&\fs22}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.40,0:23:20.75,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng vừa lạnh lùng vừa rất đỗi con người
Dialogue: 0,0:23:20.75,0:23:23.65,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.65,0:23:25.96,GitS ED Credits,,0000,0000,0000,,Nàng vẫn rạng rỡ đơn độc một mình
Dialogue: 0,0:23:25.96,0:23:29.02,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng chính là hiện thân của số chín
