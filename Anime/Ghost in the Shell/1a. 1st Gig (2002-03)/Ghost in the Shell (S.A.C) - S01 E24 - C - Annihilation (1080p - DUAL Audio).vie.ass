Dialogue: 0,0:01:49.92,0:01:51.22,Default,,0000,0000,0000,,Báo cáo, tôi đã có mặt.
Dialogue: 0,0:01:52.62,0:01:54.59,Default,,0000,0000,0000,,Tôi tưởng cậu vẫn chưa được phép xuất viện cơ mà.
Dialogue: 0,0:01:55.26,0:01:59.66,Default,,0000,0000,0000,,Thôi nào, đừng khắt khe thế chứ. Tôi không thể nằm bẹp một chỗ vào thời khắc thế này được.
Dialogue: 0,0:02:00.70,0:02:02.60,Default,,0000,0000,0000,,Chính tôi là người đã gọi Togusa tới.
Dialogue: 0,0:02:03.30,0:02:05.03,Default,,0000,0000,0000,,Tôi đã chuẩn bị đầy đủ mọi hồ sơ tài liệu rồi.
Dialogue: 0,0:02:05.03,0:02:07.56,Default,,0000,0000,0000,,Cậu sẽ đi cùng tôi tới phủ Thủ tướng.
Dialogue: 0,0:02:08.14,0:02:09.10,Default,,0000,0000,0000,,Rõ, thưa Trưởng ban!
Dialogue: 0,0:02:09.44,0:02:12.24,Default,,0000,0000,0000,,Cậu đi đứng ổn chứ? Vẫn chưa hồi phục 100% đúng không?
Dialogue: 0,0:02:12.24,0:02:13.27,Default,,0000,0000,0000,,Tôi cáng đáng được mà.
Dialogue: 0,0:02:14.94,0:02:19.21,Default,,0000,0000,0000,,Dù sao thì chính Togusa là người đầu tiên phát hiện ra sự tồn tại của vụ án này.
Dialogue: 0,0:02:28.76,0:02:29.66,Default,,0000,0000,0000,,{\i1}Trưởng ban.{\i0}
Dialogue: 0,0:02:29.66,0:02:30.49,Default,,0000,0000,0000,,{\i1}Có chuyện gì thế?{\i0}
Dialogue: 0,0:02:30.49,0:02:33.19,Default,,0000,0000,0000,,{\i1}Ngài có cuộc gọi khẩn cấp từ Bộ trưởng Bộ Nội vụ.{\i0}
Dialogue: 0,0:02:33.63,0:02:35.15,Default,,0000,0000,0000,,{\i1}Được rồi, nối máy đi.{\i0}
Dialogue: 0,0:02:37.20,0:02:41.10,Default,,0000,0000,0000,,{\i1}Aramaki, tôi đây. Ông có đang theo dõi kênh 3-3 không đấy?{\i0}
Dialogue: 0,0:02:41.10,0:02:41.94,Default,,0000,0000,0000,,{\i1}Báo cáo, không ạ.{\i0}
Dialogue: 0,0:02:41.94,0:02:43.77,Default,,0000,0000,0000,,{\i1}Vậy thì bật lên ngay đi!{\i0}
Dialogue: 0,0:02:45.91,0:02:49.24,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Hiện đang dấy lên những nghi vấn rằng các thành viên của Ban An ninh Công cộng số 9,{\i0}
Dialogue: 0,0:02:49.15,0:02:55.62,GitS Signs B/W,,0000,0000,0000,,{\fs24\pos(498,768)}Chân tướng đằng sau Vụ án Gã Mặt Cười?
Dialogue: 0,0:02:49.15,0:02:55.62,GitS Signs B/W,,0000,0000,0000,,{\fs34\pos(972,875)}Tổ chức An ninh Công cộng của Bộ Nội vụ dính líu đến vụ bắt cóc ông Serano?
Dialogue: 0,0:02:49.61,0:02:52.38,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}một lực lượng vũ trang thuộc quyền quản lý trực tiếp của Bộ Nội vụ,{\i0}
Dialogue: 0,0:02:52.38,0:02:55.62,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}đã tham gia vào vụ mưu toan bắt cóc ông Ernest Serano, CEO của Serano Genomics.{\i0}
Dialogue: 0,0:02:55.65,0:02:58.49,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Ban An ninh Công cộng số 9 được thành lập dưới danh nghĩa một đội cứu nạn quốc tế...{\i0}
Dialogue: 0,0:02:55.87,0:03:06.34,GitS Signs B/W,,0000,0000,0000,,{\fad(127,0)\fs30\pos(696,891)}Trụ sở Đội An ninh Công cộng, \Ntọa lạc tại thành phố Niihama
Dialogue: 0,0:02:56.12,0:03:06.34,GitS Signs B/W,,0000,0000,0000,,{\fad(43,0)\fs24\pos(1556,151)}Đội 9 dính líu đến vụ bắt cóc Serano?
Dialogue: 0,0:02:58.49,0:03:00.69,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...do chính Bộ Nội vụ thành lập,{\i0}
Dialogue: 0,0:03:01.02,0:03:03.19,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}nhưng các hành vi thu thập thông tin thái quá cũng như việc tự ý sử dụng vũ lực...{\i0}
Dialogue: 0,0:03:03.19,0:03:06.39,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...dưới quyền hạn riêng của họ từ lâu đã làm dấy lên những mối quan ngại sâu sắc.{\i0}
Dialogue: 0,0:03:06.83,0:03:10.63,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Sự việc này cho thấy khả năng rất cao là Đội 9 cũng có liên quan trực tiếp...{\i0}
Dialogue: 0,0:03:10.63,0:03:13.97,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...tới hàng loạt vụ án Gã Mặt Cười từng xảy ra vào năm 2024.{\i0}
Dialogue: 0,0:03:13.97,0:03:15.94,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chính phủ đang nhìn nhận những diễn biến này một cách hết sức nghiêm trọng,{\i0}
Dialogue: 0,0:03:13.97,0:03:15.00,Default,,0000,0000,0000,,Thiếu tá?!
Dialogue: 0,0:03:15.00,0:03:17.54,Default,,0000,0000,0000,,{\i1}Tôi vừa bị triệu tập tham dự một phiên họp Nội các khẩn cấp.{\i0}
Dialogue: 0,0:03:15.94,0:03:18.44,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và đã tuyên bố sẽ thành lập một ủy ban điều tra đặc biệt,{\i0}
Dialogue: 0,0:03:17.54,0:03:21.08,Default,,0000,0000,0000,,{\i1}Hãy nhìn xem các người đã lôi kéo tôi vào cái mớ bòng bong gì thế này. Ông cũng phải lập tức có mặt ở đây ngay.{\i0}
Dialogue: 0,0:03:18.44,0:03:21.78,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}đồng thời sẽ yêu cầu giải thể ngay lập tức phân ban nói trên.{\i0}
Dialogue: 0,0:03:21.08,0:03:24.51,Default,,0000,0000,0000,,{\i1}Trong lúc này, tốt nhất là ông hãy chuẩn bị sẵn những lời giải trình để tự bào chữa cho mình đi.{\i0}
Dialogue: 0,0:03:24.85,0:03:28.64,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Hơn nữa, phản ứng của tất cả các cơ quan liên quan đối với Ban An ninh Công cộng số 9...{\i0}
Dialogue: 0,0:03:26.12,0:03:28.64,Default,,0000,0000,0000,,Điều này có nghĩa là thông tin đã bị rò rỉ ngay trước thềm chiến dịch sao?
Dialogue: 0,0:03:29.28,0:03:32.95,Default,,0000,0000,0000,,Bình tĩnh lại. Điều đó chỉ có nghĩa là chiến dịch thực sự giờ mới bắt đầu thôi.
Dialogue: 0,0:03:33.19,0:03:35.59,Default,,0000,0000,0000,,Hai chúng tôi vẫn sẽ tới phủ Thủ tướng theo đúng kế hoạch ban đầu.
Dialogue: 0,0:03:37.96,0:03:38.69,Default,,0000,0000,0000,,{\i1}Thiếu tá.{\i0}
Dialogue: 0,0:03:38.69,0:03:39.53,Default,,0000,0000,0000,,{\i1}Có tôi.{\i0}
Dialogue: 0,0:03:39.53,0:03:42.02,Default,,0000,0000,0000,,{\i1}Các cậu còn lại, hãy điều tra xem tin tức về chiến dịch của chúng ta bị rò rỉ từ đâu.{\i0}
Dialogue: 0,0:03:42.40,0:03:43.26,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:03:46.30,0:03:49.27,Default,,0000,0000,0000,,Tôi cho rằng tình hình hiện nay đòi hỏi một sự đánh giá lại một cách triệt để...
Dialogue: 0,0:03:49.27,0:03:51.26,Default,,0000,0000,0000,,...về sự cần thiết của các phân ban An ninh Công cộng.
Dialogue: 0,0:03:51.64,0:03:57.20,Default,,0000,0000,0000,,Tình trạng bất ổn xã hội do việc phơi bày sự tồn tại của họ đã chạm tới mức giới hạn rồi.
Dialogue: 0,0:03:57.61,0:04:01.07,Default,,0000,0000,0000,,Thưa Thủ tướng, dẫu trên danh nghĩa họ trực thuộc quyền quản lý của Bộ Nội vụ,
Dialogue: 0,0:04:01.52,0:04:05.68,Default,,0000,0000,0000,,nhưng tôi nghe nói đã từng có những thời điểm đích thân ngài là người trực tiếp ra mệnh lệnh cho họ.
Dialogue: 0,0:04:06.39,0:04:09.79,Default,,0000,0000,0000,,À thì, tôi không thể nói rằng mình {\i1}chưa từng...{\i0}
Dialogue: 0,0:04:10.03,0:04:13.70,Default,,0000,0000,0000,,Dẫu vậy, việc họ là một đơn vị thiện chiến dày dạn kinh nghiệm thực chiến cũng là sự thật...
Dialogue: 0,0:04:13.70,0:04:18.16,Default,,0000,0000,0000,,...vốn được thành lập với vai trò một đội cứu nạn quốc tế.
Dialogue: 0,0:04:18.37,0:04:22.70,Default,,0000,0000,0000,,Thật là những lời đao to búa lớn phát ra từ kẻ thậm chí còn chẳng biết chuyện gì đang xảy ra ngay sau lưng mình.
Dialogue: 0,0:04:23.27,0:04:27.94,Default,,0000,0000,0000,,Dù sao đi nữa, họ cũng chỉ là một đội thanh trừng được phê duyệt trong thời kỳ hỗn loạn thời hậu chiến...
Dialogue: 0,0:04:28.28,0:04:31.51,Default,,0000,0000,0000,,...dưới vỏ bọc của một sắc lệnh do vị Thủ tướng tiền nhiệm ban hành khi đó.
Dialogue: 0,0:04:31.95,0:04:35.95,Default,,0000,0000,0000,,Trong bối cảnh chúng ta vẫn chưa thể dung hòa giữa Quân đội Phòng vệ và Điều 9 Hiến pháp,
Dialogue: 0,0:04:35.95,0:04:38.15,Default,,0000,0000,0000,,thì công chúng {\i1}vô cùng{\i0} nhạy cảm đối với vấn đề nhức nhối này.
Dialogue: 0,0:04:38.52,0:04:43.48,Default,,0000,0000,0000,,Dù thế nào đi nữa, sự việc này sẽ không thể giải quyết nếu chúng ta không triệu tập Trưởng ban Đội 9 tới đây.
Dialogue: 0,0:04:50.10,0:04:51.12,Default,,0000,0000,0000,,Cái gì?
Dialogue: 0,0:04:51.53,0:04:54.33,Default,,0000,0000,0000,,Xin mọi người thứ lỗi cho tôi một lát. Tôi sẽ quay lại ngay.
Dialogue: 0,0:05:02.04,0:05:06.00,Default,,0000,0000,0000,,Thế này là có ý gì hả? Vụ bê bối này đang đẩy tôi vào thế vô cùng khó xử đấy.
Dialogue: 0,0:05:06.48,0:05:09.35,Default,,0000,0000,0000,,Chắc chắn ông cũng sẽ bị tống đạt trát hầu tòa với tư cách nhân chứng thôi.
Dialogue: 0,0:05:09.35,0:05:14.12,Default,,0000,0000,0000,,Lẽ nào ông lại không nhận thức được việc tôi gặp gỡ ông lúc này là cực kỳ không thích hợp hay sao?
Dialogue: 0,0:05:14.66,0:05:17.65,Default,,0000,0000,0000,,Tôi hiểu. Nhưng tôi muốn ngài hãy xem qua tập tài liệu này.
Dialogue: 0,0:05:19.46,0:05:20.66,Default,,0000,0000,0000,,Cái gì thế này?
Dialogue: 0,0:05:21.43,0:05:24.83,Default,,0000,0000,0000,,Tài liệu tuyệt mật tối quan trọng liên quan trực tiếp đến Tổng Thư ký Yakushima.
Dialogue: 0,0:05:30.67,0:05:33.27,Default,,0000,0000,0000,,Tôi đoán chúng ta đã kịp thời ra tay trước một đợt càn quét lớn...
Dialogue: 0,0:05:41.15,0:05:46.02,Default,,0000,0000,0000,,Ngoài ông ra thì còn có những ai nắm được đường đi nước bước của dòng tiền này nữa?
Dialogue: 0,0:05:46.36,0:05:48.46,Default,,0000,0000,0000,,Giờ ngài đã đọc xong, thì chỉ có ngài,
Dialogue: 0,0:05:48.46,0:05:51.12,Default,,0000,0000,0000,,có ông Serano, người đã quyết định đứng ra tố giác Tổng Thư ký Yakushima,
Dialogue: 0,0:05:51.59,0:05:53.69,Default,,0000,0000,0000,,và những cấp dưới của tôi, chỉ có ngần ấy người mà thôi.
Dialogue: 0,0:05:54.03,0:05:55.69,Default,,0000,0000,0000,,Tôi hiểu rồi. Được thôi.
Dialogue: 0,0:05:56.03,0:05:59.99,Default,,0000,0000,0000,,Chúng ta sẽ xử lý Yakushima vào thời điểm thích hợp.
Dialogue: 0,0:06:00.47,0:06:04.27,Default,,0000,0000,0000,,Thế nhưng hiện tại chúng ta đang ở vào giai đoạn then chốt trước thềm bầu cử Hạ viện.
Dialogue: 0,0:06:04.81,0:06:07.93,Default,,0000,0000,0000,,Tôi muốn công chúng và giới truyền thông phải cảm thấy họ đã giành được một thắng lợi vang dội.
Dialogue: 0,0:06:08.48,0:06:11.28,Default,,0000,0000,0000,,Nếu tôi để một nhân vật quyền lực tầm cỡ như ông Yakushima ra đi,
Dialogue: 0,0:06:11.28,0:06:14.48,Default,,0000,0000,0000,,thì việc chúng ta phải chịu tổn thất tương ứng là điều khó lòng tránh khỏi.
Dialogue: 0,0:06:15.25,0:06:18.19,Default,,0000,0000,0000,,Tôi chưa hiểu rõ ẩn ý của Thủ tướng là gì, thưa ngài.
Dialogue: 0,0:06:21.16,0:06:23.65,Default,,0000,0000,0000,,Ý tôi là việc thông qua Đạo luật Hạn chế Lực lượng Đặc nhiệm.
Dialogue: 0,0:06:23.86,0:06:26.02,Default,,0000,0000,0000,,Ngài muốn tôi ném Đội 9 vào miệng cọp sao?
Dialogue: 0,0:06:26.30,0:06:27.76,Default,,0000,0000,0000,,Tôi đâu có nói những lời đó.
Dialogue: 0,0:06:28.00,0:06:29.19,Default,,0000,0000,0000,,Chờ một chút đã!
Dialogue: 0,0:06:29.53,0:06:33.63,Default,,0000,0000,0000,,Chúng ta đang nói về niềm tin của tôi đối với cấp dưới của mình! Những con người luôn tuyệt đối phục tùng tôi trong mọi nghịch cảnh!
Dialogue: 0,0:06:34.14,0:06:39.17,Default,,0000,0000,0000,,{\i1}Đó{\i0} là khối tài sản vô giá mà tôi đã dành trọn cả đời gây dựng! Ngài đang đòi hỏi tôi phải...
Dialogue: 0,0:06:39.17,0:06:43.54,Default,,0000,0000,0000,,Chà, tôi cho rằng đã đến lúc phải đem khối tài sản đó ra sử dụng rồi, ông có nghĩ vậy không?
Dialogue: 0,0:06:44.11,0:06:45.91,Default,,0000,0000,0000,,Tôi sẽ lo liệu mọi khâu thu xếp cần thiết.
Dialogue: 0,0:06:46.28,0:06:48.91,Default,,0000,0000,0000,,Hãy tập hợp người của ông lại đi.
Dialogue: 0,0:06:49.75,0:06:53.52,Default,,0000,0000,0000,,Đừng lo. Miễn là ông còn sống, ông hoàn toàn có thể tái thiết lại đơn vị của mình.
Dialogue: 0,0:07:09.81,0:07:11.71,Default,,0000,0000,0000,,Đưa chúng tôi tới Bộ Tư pháp.
Dialogue: 0,0:07:12.24,0:07:13.21,Default,,0000,0000,0000,,Vâng, thưa Trưởng ban.
Dialogue: 0,0:07:14.94,0:07:16.38,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi đây.{\i0}
Dialogue: 0,0:07:16.85,0:07:18.87,Default,,0000,0000,0000,,{\i1}Sếp có thuyết phục được ngài Thủ tướng không?{\i0}
Dialogue: 0,0:07:19.35,0:07:21.91,Default,,0000,0000,0000,,{\i1}Hãy tập hợp toàn bộ mọi người tại trụ sở Đội 9 ngay lập tức.{\i0}
Dialogue: 0,0:07:23.42,0:07:24.65,Default,,0000,0000,0000,,{\i1}Sếp còn mệnh lệnh nào khác nữa không?{\i0}
Dialogue: 0,0:07:25.75,0:07:28.85,Default,,0000,0000,0000,,{\i1}Tuyệt đối không được chết. Bằng mọi giá phải sống sót.{\i0}
Dialogue: 0,0:07:45.37,0:07:47.90,Default,,0000,0000,0000,,{\i1}Kẻ thù sở hữu chín cỗ xe tăng chiến thuật AI.{\i0}
Dialogue: 0,0:07:48.78,0:07:52.68,Default,,0000,0000,0000,,{\i1}Đội 3 và Đội 4, các cậu sẽ đổ bộ từ trên không và thâm nhập vào nhà chứa máy bay từ bãi đáp trực thăng.{\i0}
Dialogue: 0,0:07:53.42,0:07:55.58,Default,,0000,0000,0000,,{\i1}Mục tiêu ưu tiên hàng đầu là tiêu diệt toàn bộ các cỗ xe tăng.{\i0}
Dialogue: 0,0:07:56.05,0:07:59.28,Default,,0000,0000,0000,,{\i1}Đội 5 và Đội 6, mau chóng tóm gọn bảy thành viên cốt cán...{\i0}
Dialogue: 0,0:07:59.62,0:08:01.21,Default,,0000,0000,0000,,{\i1}...và giành quyền kiểm soát toàn bộ cơ sở này.{\i0}
Dialogue: 0,0:08:01.69,0:08:05.68,Default,,0000,0000,0000,,{\i1}Tất cả các đơn vị, lập tức ngắt mạng và kích hoạt chế độ tự kỷ sau khi tiến vào. Lũ người này là bậc thầy về chiến tranh thông tin.{\i0}
Dialogue: 0,0:08:06.03,0:08:07.96,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ đè bẹp bọn chúng bằng sức mạnh cơ bắp tuyệt đối!{\i0}
Dialogue: 0,0:08:21.14,0:08:21.94,Default,,0000,0000,0000,,Trưởng ban.
Dialogue: 0,0:08:29.58,0:08:30.92,Default,,0000,0000,0000,,Đúng là bọn chúng đang bám đuôi theo sau chúng ta rồi.
Dialogue: 0,0:08:49.30,0:08:50.46,Default,,0000,0000,0000,,Tôi sẽ cắt đuôi bọn chúng!
Dialogue: 0,0:09:34.58,0:09:35.52,Default,,0000,0000,0000,,Trưởng ban!
Dialogue: 0,0:09:36.82,0:09:41.72,Default,,0000,0000,0000,,Chúng tôi tới để đón ông. Vẫn còn vài việc ông cần phải làm cho chúng tôi đấy.
Dialogue: 0,0:09:45.33,0:09:48.63,Default,,0000,0000,0000,,Thu xếp mọi sự sắp đặt cần thiết chỉ trong một khoảng thời gian ngắn ngủi thế này...
Dialogue: 0,0:09:48.63,0:09:51.12,Default,,0000,0000,0000,,Ngài Thủ tướng quả thực là một chính khách vô cùng tháo vát và lão luyện.
Dialogue: 0,0:09:51.47,0:09:54.44,Default,,0000,0000,0000,,Lúc này đây chắc hẳn Đội 9 đang bị vô hiệu hóa rồi.
Dialogue: 0,0:09:54.44,0:09:55.49,Default,,0000,0000,0000,,Cái {\i1}gì cơ?!{\i0}
Dialogue: 0,0:10:01.38,0:10:02.24,Default,,0000,0000,0000,,Giải ông ta đi.
Dialogue: 0,0:10:02.24,0:10:03.18,Default,,0000,0000,0000,,Rõ, thưa chỉ huy!
Dialogue: 0,0:10:04.28,0:10:06.51,Default,,0000,0000,0000,,Trưởng ban! Chuyện này rốt cuộc là sao hả sếp?!
Dialogue: 0,0:10:06.92,0:10:09.04,Default,,0000,0000,0000,,Làm ơn giải thích cho tôi hiểu với! Trưởng ban!
Dialogue: 0,0:10:10.02,0:10:11.35,Default,,0000,0000,0000,,Trưởng ban!
Dialogue: 0,0:10:20.16,0:10:22.86,Default,,0000,0000,0000,,{\i1}Là do tôi nhạy cảm quá, hay là tòa nhà hôm nay có vẻ khác thường thế nhỉ?{\i0}
Dialogue: 0,0:10:23.40,0:10:26.23,Default,,0000,0000,0000,,{\i1}Mà lệnh triệu tập khẩn cấp này là sao? Hơi kỳ lạ đấy.{\i0}
Dialogue: 0,0:10:26.54,0:10:28.73,Default,,0000,0000,0000,,{\i1}Hiện tại tôi không có thời gian để giải thích đầu đuôi câu chuyện cho các cậu.{\i0}
Dialogue: 0,0:10:29.07,0:10:31.04,Default,,0000,0000,0000,,{\i1}Cứ giữ im lặng và nghiêm chỉnh chấp hành mệnh lệnh của tôi đi.{\i0}
Dialogue: 0,0:10:31.94,0:10:35.00,Default,,0000,0000,0000,,{\i1}Chuẩn bị sáu vỏ bọc cơ thể giả nguyên bản và mang ngay lên phòng chỉ huy.{\i0}
Dialogue: 0,0:10:36.88,0:10:37.94,Default,,0000,0000,0000,,{\i1}Khoan đã, chẳng lẽ ý cô là...{\i0}
Dialogue: 0,0:10:39.55,0:10:40.91,Default,,0000,0000,0000,,{\i1}Làm ngay đi!{\i0}
Dialogue: 0,0:10:52.06,0:10:55.05,Default,,0000,0000,0000,,Thiếu tá, chuyện quái quỷ gì đang diễn ra thế này?
Dialogue: 0,0:11:00.00,0:11:01.63,Default,,0000,0000,0000,,Cầm lấy những hạt giống dữ liệu này đi.
Dialogue: 0,0:11:01.97,0:11:05.46,Default,,0000,0000,0000,,Sau khi thoát khỏi đây, hãy tuồn toàn bộ thông tin bên trong cho giới truyền thông và làm cho chúng đâm chồi nảy lộc.
Dialogue: 0,0:11:06.31,0:11:09.24,Default,,0000,0000,0000,,Chúng ta cần một cú hích từ dư luận công chúng để hạ bệ tên Tổng Thư ký Đảng.
Dialogue: 0,0:11:42.64,0:11:43.80,Default,,0000,0000,0000,,Được rồi, chúng tôi đã mang chúng lên đây.
Dialogue: 0,0:11:45.08,0:11:47.48,Default,,0000,0000,0000,,Cách đây một lúc, tôi vừa nhận được một bức điện mã hóa gửi từ Trưởng ban.
Dialogue: 0,0:11:47.98,0:11:51.18,Default,,0000,0000,0000,,Một lực lượng đặc nhiệm quân đội sắp sửa tràn vào đánh chiếm tòa nhà này.
Dialogue: 0,0:11:51.82,0:11:54.88,Default,,0000,0000,0000,,Vậy ra Dự luật Hạn chế Lực lượng Đặc nhiệm đã được thông qua rồi sao?
Dialogue: 0,0:11:55.56,0:11:59.62,Default,,0000,0000,0000,,Một khi phiên họp Nội các đặc biệt đã ủy quyền cho hành động quân sự, thì mọi sự coi như đã an bài.
Dialogue: 0,0:12:00.00,0:12:01.39,Default,,0000,0000,0000,,Chuyện này diễn ra như cơm bữa ấy mà.
Dialogue: 0,0:12:03.33,0:12:04.46,Default,,0000,0000,0000,,Bọn chúng đã tới nơi rồi.
Dialogue: 0,0:12:07.34,0:12:10.30,Default,,0000,0000,0000,,Một khi đã câu đủ thời gian cần thiết, chúng ta sẽ cho nổ tung xóa sổ nơi này.
Dialogue: 0,0:12:23.89,0:12:27.45,Default,,0000,0000,0000,,Nhà chứa đã được phong tỏa. Không thấy dấu vết của các cỗ xe tăng chiến thuật.
Dialogue: 0,0:12:27.79,0:12:29.46,Default,,0000,0000,0000,,Cảnh giác coi chừng bẫy phục kích.
Dialogue: 0,0:12:29.46,0:12:33.48,Default,,0000,0000,0000,,Đại úy, thiết bị đầu cuối này ghi nhận các cỗ xe tăng chiến thuật đã bị chuyển trả về phòng thí nghiệm rồi.
Dialogue: 0,0:12:34.00,0:12:36.36,Default,,0000,0000,0000,,Khốn kiếp, thông tin tình báo từ cấp trên lúc nào cũng như trò hề...
Dialogue: 0,0:12:36.36,0:12:37.80,Default,,0000,0000,0000,,Bớt lải nhải đi!
Dialogue: 0,0:12:38.07,0:12:40.04,Default,,0000,0000,0000,,Tình hình trên chiến trường thay đổi từng giây từng phút.
Dialogue: 0,0:12:40.04,0:12:43.16,Default,,0000,0000,0000,,Triển khai các phân đội và luôn đề phòng mọi tình huống bất trắc.
Dialogue: 0,0:12:48.01,0:12:49.03,Default,,0000,0000,0000,,Bọn chúng tới rồi!
Dialogue: 0,0:12:51.78,0:12:52.80,Default,,0000,0000,0000,,Hành động thôi!
Dialogue: 0,0:12:57.69,0:13:00.59,Default,,0000,0000,0000,,Ishikawa! Kích hoạt toàn bộ hệ thống vòi phun nước cứu hỏa của tòa nhà!
Dialogue: 0,0:13:04.09,0:13:05.12,Default,,0000,0000,0000,,Vô dụng sao?
Dialogue: 0,0:13:10.80,0:13:11.82,Default,,0000,0000,0000,,Chỉ là nước lã thôi mà.
Dialogue: 0,0:13:12.60,0:13:13.97,Default,,0000,0000,0000,,Đội 2, chi viện hỏa lực!
Dialogue: 0,0:13:14.30,0:13:16.50,Default,,0000,0000,0000,,Xung phong bằng Giáp Chiến Hạng Nặng và áp đảo bọn chúng ngay!
Dialogue: 0,0:13:20.04,0:13:21.10,Default,,0000,0000,0000,,Rút lui mau!
Dialogue: 0,0:13:21.44,0:13:23.84,Default,,0000,0000,0000,,Với lớp giáp dày cộm đó, dù chúng ta có bắn bao nhiêu phát đi nữa cũng chẳng thể làm chậm bước tiến của chúng!
Dialogue: 0,0:13:37.86,0:13:40.66,Default,,0000,0000,0000,,Lũ đó thuộc đơn vị nào thế? Bọn chúng tác chiến đỉnh thật đấy.
Dialogue: 0,0:13:40.66,0:13:42.19,Default,,0000,0000,0000,,Bọn chúng mang biệt danh là Umibozu.
Dialogue: 0,0:13:43.06,0:13:44.22,Default,,0000,0000,0000,,Umibozu sao?
Dialogue: 0,0:13:45.47,0:13:48.49,Default,,0000,0000,0000,,Phải, lũ từng tham gia vào chiến dịch tái chiếm Nemuro đấy.
Dialogue: 0,0:13:49.00,0:13:50.53,Default,,0000,0000,0000,,Lũ đó khét tiếng trong thế giới ngầm.
Dialogue: 0,0:13:50.97,0:13:54.57,Default,,0000,0000,0000,,Trên danh nghĩa chính thức thì bọn chúng không tồn tại, nên làm gì có tên đơn vị cụ thể.
Dialogue: 0,0:14:04.29,0:14:06.69,Default,,0000,0000,0000,,Được rồi, đến lúc rồi. Chúng ta rút khỏi đây mau!
Dialogue: 0,0:14:34.42,0:14:37.54,Default,,0000,0000,0000,,Xác minh hiện trường ngay! Mau chóng cấp cứu cho những người bị thương!
Dialogue: 0,0:14:43.16,0:14:46.18,Default,,0000,0000,0000,,Có vẻ như các thành viên của Đội 9 đã kích hoạt khối thuốc nổ tự sát rồi.
Dialogue: 0,0:14:48.13,0:14:49.70,Default,,0000,0000,0000,,Hãy luôn đề phòng khả năng...
Dialogue: 0,0:14:49.70,0:14:52.06,Default,,0000,0000,0000,,...đây chỉ là một chiến dịch ngụy trang nhằm dàn dựng cái chết giả của bọn chúng.
Dialogue: 0,0:14:53.17,0:14:56.30,Default,,0000,0000,0000,,Tuyệt đối không được lơ là mất cảnh giác! Tiếp tục lùng sục!
Dialogue: 0,0:14:56.67,0:14:57.57,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:15:07.38,0:15:09.51,Default,,0000,0000,0000,,Trời đất ơi, biết làm sao với cậu bây giờ đây?
Dialogue: 0,0:15:09.62,0:15:11.71,Default,,0000,0000,0000,,Cậu biết là không nên làm đổ trà lênh láng như thế cơ mà.
Dialogue: 0,0:15:14.52,0:15:16.69,Default,,0000,0000,0000,,Tachikoma nhiệt tình xông xáo ghê chưa kìa.
Dialogue: 0,0:15:14.96,0:15:16.69,Top Secondary Dialog 1080P,,0000,0000,0000,,Ôi dào, đằng này vẫn còn nước đổ này...
Dialogue: 0,0:15:16.69,0:15:20.25,Default,,0000,0000,0000,,Cậu nhóc này chăm chỉ thật đấy, vừa đến đã làm quen với tất cả cư dân ở đây ngay được.
Dialogue: 0,0:15:20.60,0:15:22.43,Default,,0000,0000,0000,,Có cậu ấy giúp quả thực đỡ đần được bao nhiêu việc.
Dialogue: 0,0:15:21.33,0:15:23.77,Top Secondary Dialog 1080P,,0000,0000,0000,,Khoan đã, đây đâu phải là nước trà!
Dialogue: 0,0:15:22.43,0:15:25.23,Default,,0000,0000,0000,,Cậu nhóc đó được bán đấu giá thanh lý từ một cơ quan nào đó, đúng không?
Dialogue: 0,0:15:25.57,0:15:27.00,Default,,0000,0000,0000,,Không biết có còn chú nào nữa không nhỉ?
Dialogue: 0,0:15:27.00,0:15:31.27,Default,,0000,0000,0000,,Tôi cũng nghĩ thế. Nhưng cậu nghĩ mấy con robot như nhóc này ban đầu được chế tạo để làm gì nhỉ?
Dialogue: 0,0:15:31.51,0:15:34.18,Default,,0000,0000,0000,,Nhìn kìa, có bản tin thời sự rồi! Xem tivi đi!
Dialogue: 0,0:15:32.81,0:15:34.18,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chúng tôi xin tạm dừng chương trình phát sóng...{\i0}
Dialogue: 0,0:15:34.18,0:15:37.24,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...để chuyển tới quý vị bản tin thời sự nóng bỏng liên quan đến Đội 9.{\i0}
Dialogue: 0,0:15:37.75,0:15:40.85,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tại phiên họp Nội các khẩn cấp kêu gọi giải thể Ban An ninh Công cộng số 9,{\i0}
Dialogue: 0,0:15:40.18,0:15:51.23,GitS Signs B/W,,0000,0000,0000,,{\fs24\pos(494,778)}Đơn vị Chống khủng bố của Bộ Nội vụ
Dialogue: 0,0:15:40.18,0:15:51.23,GitS Signs B/W,,0000,0000,0000,,{\fs40\pos(972,875)}Phớt lờ Đạo luật Hạn chế Đặc nhiệm, Đụng độ nổ ra với Quân đội tại Niihama
Dialogue: 0,0:15:40.85,0:15:45.05,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}dự luật hạn chế lực lượng đặc nhiệm liên quan đến việc triển khai quân đội đã chính thức được thông qua,{\i0}
Dialogue: 0,0:15:45.05,0:15:49.12,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và có vẻ như một đơn vị đặc nhiệm quân đội vừa ập vào đánh chiếm cơ sở này ít phút trước...{\i0}
Dialogue: 0,0:15:49.12,0:15:51.46,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...nhằm đáp trả việc Đội 9 phớt lờ hàng loạt các cảnh báo trước đó,{\i0}
Dialogue: 0,0:15:51.46,0:15:53.06,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}thể hiện rõ ý định tử thủ chống trả đến cùng.{\i0}
Dialogue: 0,0:15:53.06,0:15:54.19,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Giờ đây chúng tôi xin kết nối trực tiếp với hiện trường.{\i0}
Dialogue: 0,0:15:54.83,0:15:57.47,Default,,0000,0000,0000,,Kìa! Đó chính là Đội 9!
Dialogue: 0,0:15:55.70,0:15:57.47,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Cách đây ít phút, phía trên tòa nhà phức hợp của Đội 9...{\i0}
Dialogue: 0,0:15:57.47,0:15:59.16,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...một chiếc trực thăng quân sự...{\i0}
Dialogue: 0,0:16:02.10,0:16:04.63,Default,,0000,0000,0000,,Tạm thời có vẻ như chưa có kẻ nào bám đuôi theo sau chúng ta.
Dialogue: 0,0:16:05.11,0:16:07.07,Default,,0000,0000,0000,,Màn kịch đó sẽ chẳng câu được cho chúng ta nhiều thời gian đâu.
Dialogue: 0,0:16:07.54,0:16:10.03,Default,,0000,0000,0000,,Chưa có bộ não điện tử nào trong số đó từng được sử dụng thực tế cả.
Dialogue: 0,0:16:10.58,0:16:11.60,Default,,0000,0000,0000,,Vậy thì...
Dialogue: 0,0:16:12.25,0:16:13.58,Default,,0000,0000,0000,,Giờ chúng ta\Nphải làm gì đây?
Dialogue: 0,0:16:19.05,0:16:22.11,Default,,0000,0000,0000,,Trưởng ban đã dặn dò tôi bằng mọi giá phải sống sót.
Dialogue: 0,0:16:23.06,0:16:24.52,Default,,0000,0000,0000,,Tôi cũng hoàn toàn đồng tình với sếp già.
Dialogue: 0,0:16:25.53,0:16:28.55,Default,,0000,0000,0000,,Từ đây, chúng ta sẽ tản ra ba hướng khác nhau để chia cắt lực lượng truy đuổi.
Dialogue: 0,0:16:29.30,0:16:32.27,Default,,0000,0000,0000,,Sau đó, hãy phân tán và ẩn nấp sâu vào các ngóc ngách của thành phố.
Dialogue: 0,0:16:33.23,0:16:35.70,Default,,0000,0000,0000,,Kể từ ngày hôm nay, Ban An ninh Công cộng số 9 chính thức giải thể.
Dialogue: 0,0:16:36.14,0:16:37.26,Default,,0000,0000,0000,,Hết lệnh.
Dialogue: 0,0:16:43.04,0:16:46.45,Default,,0000,0000,0000,,Các thi thể bị hư hại nặng nề, nhưng chúng tôi tin đây chính là xác của sáu thành viên cốt cán.
Dialogue: 0,0:16:47.15,0:16:49.51,Default,,0000,0000,0000,,Chúng tôi đang phân tích các dấu vết sử dụng còn sót lại trên não điện tử.
Dialogue: 0,0:16:50.45,0:16:52.65,Default,,0000,0000,0000,,Trong lúc chờ kết quả, hãy điều động Đội 5 tới đây ngay.
Dialogue: 0,0:16:52.95,0:16:54.62,Default,,0000,0000,0000,,Hãy luôn giả định rằng đây chỉ là một chiến dịch ngụy trang.
Dialogue: 0,0:16:54.62,0:16:59.75,Default,,0000,0000,0000,,Phong tỏa mọi lối thoát hiểm mà các anh có thể nghĩ tới, bao gồm hố thang máy, lỗ thông gió và cả hệ thống cống ngầm.
Dialogue: 0,0:17:00.03,0:17:00.89,Default,,0000,0000,0000,,Rõ, thưa chỉ huy!
Dialogue: 0,0:17:08.27,0:17:09.34,Default,,0000,0000,0000,,Cô đi trước đi.
Dialogue: 0,0:17:09.34,0:17:11.00,Default,,0000,0000,0000,,Không, cậu đi trước đi.
Dialogue: 0,0:17:11.34,0:17:14.24,Default,,0000,0000,0000,,Nếu bọn chúng đuổi tới, tôi sẽ dùng thân mình chặn đường hầm lại.
Dialogue: 0,0:17:15.04,0:17:17.57,Default,,0000,0000,0000,,Thế nếu bọn chúng phục kích ngay tại cửa hầm thì sao?
Dialogue: 0,0:17:17.98,0:17:22.54,Default,,0000,0000,0000,,Nếu lúc đó tôi lại chắn ngay trước mặt cậu ở lối ra, thì cậu định chạy đường nào?
Dialogue: 0,0:17:28.36,0:17:30.29,Default,,0000,0000,0000,,Vậy là cuối cùng Đội 9 cũng đi tong rồi nhỉ?
Dialogue: 0,0:17:30.69,0:17:33.99,Default,,0000,0000,0000,,Bao nhiêu công sức chúng ta đổ dồn vào đó giờ tan thành mây khói hết sạch.
Dialogue: 0,0:17:34.23,0:17:35.36,Default,,0000,0000,0000,,Cậu thực sự nghĩ thế sao?
Dialogue: 0,0:17:35.36,0:17:39.66,Default,,0000,0000,0000,,Được thoải mái tiếp cận với những trang thiết bị đỉnh cao và chế độ bảo dưỡng tối tân nhất kể cũng sướng thật,
Dialogue: 0,0:17:40.00,0:17:40.99,Default,,0000,0000,0000,,nhưng mọi chuyện cũng chỉ có vậy thôi.
Dialogue: 0,0:17:41.40,0:17:43.84,Default,,0000,0000,0000,,Giờ thì chúng ta chỉ cần tìm kiếm một nhà tài trợ mới, đơn giản thế thôi.
Dialogue: 0,0:17:44.51,0:17:48.24,Default,,0000,0000,0000,,Hay là còn điều gì khác nữa? Cậu có sự gắn bó sâu nặng nào với nơi đó sao, Batou?
Dialogue: 0,0:17:49.34,0:17:53.75,Default,,0000,0000,0000,,Không, nếu cô đã nói thế. Có chăng thì, tôi đoán đó là những kỷ niệm.
Dialogue: 0,0:17:54.25,0:17:57.41,Default,,0000,0000,0000,,Kỷ niệm sao? Cậu đa sầu đa cảm đến mức đáng ngạc nhiên đấy.
Dialogue: 0,0:17:59.89,0:18:03.05,Default,,0000,0000,0000,,Nhắc mới nhớ, chiếc đồng hồ mà cô vẫn thường đeo đâu rồi?
Dialogue: 0,0:18:04.23,0:18:06.75,Default,,0000,0000,0000,,Đúng ngày hôm nay tôi lại để quên nó cạnh giường ngủ ở căn nhà an toàn bí mật...
Dialogue: 0,0:18:07.23,0:18:11.03,Default,,0000,0000,0000,,Nếu bọn chúng đã càn quét Đội 9, chắc chắn nơi ẩn náu của tôi cũng đã bị phong tỏa rồi.
Dialogue: 0,0:18:11.30,0:18:12.47,Default,,0000,0000,0000,,Cô cam lòng chấp nhận điều đó sao?
Dialogue: 0,0:18:12.47,0:18:17.67,Default,,0000,0000,0000,,Chẳng phải cô có được chiếc đồng hồ đó để kỷ niệm lần cuối cùng điều chỉnh kích thước cơ thể máy hay sao?
Dialogue: 0,0:18:18.31,0:18:20.24,Default,,0000,0000,0000,,Dù tôi chẳng biết ai là người đã tặng nó cho cô...
Dialogue: 0,0:18:21.21,0:18:22.54,Default,,0000,0000,0000,,Ồ, cậu cũng biết chuyện đó cơ à?
Dialogue: 0,0:18:22.78,0:18:26.71,Default,,0000,0000,0000,,Nhưng đừng có hiểu lầm. Tôi đeo nó chẳng phải vì lý do tình cảm sướt mướt gì đâu.
Dialogue: 0,0:18:27.42,0:18:29.52,Default,,0000,0000,0000,,Chẳng phải lý do cô luôn gắn bó trung thành với những vỏ bọc mẫu nữ...
Dialogue: 0,0:18:29.52,0:18:33.42,Default,,0000,0000,0000,,...là bởi vì cô muốn có một cổ tay thon gọn vừa vặn với dây đeo của chiếc đồng hồ đó hay sao?
Dialogue: 0,0:18:33.76,0:18:35.76,Default,,0000,0000,0000,,Cô có thể thay đổi vỏ bọc cơ thể giả hay hộp sọ chứa não,
Dialogue: 0,0:18:35.76,0:18:38.69,Default,,0000,0000,0000,,nhưng có những thứ mà cô {\i1}tuyệt đối không thể{\i0} hoán đổi được đâu, và chính cô cũng thừa biết điều đó!
Dialogue: 0,0:18:38.69,0:18:40.42,Default,,0000,0000,0000,,Sao cậu lại nổi nóng gay gắt đến thế cơ chứ?
Dialogue: 0,0:18:40.80,0:18:43.86,Default,,0000,0000,0000,,Tôi thay đổi thân xác và hộp sọ là tùy theo hoàn cảnh thực tế đòi hỏi.
Dialogue: 0,0:18:44.37,0:18:46.39,Default,,0000,0000,0000,,Vậy nên tôi cũng sẽ chỉ đơn giản là thay đổi cả những ký ức của mình thôi.
Dialogue: 0,0:18:53.31,0:18:54.87,Default,,0000,0000,0000,,Nói chuyện phiếm thế là đủ rồi.
Dialogue: 0,0:18:55.31,0:18:57.57,Default,,0000,0000,0000,,Một khi đã bước chân ra khỏi đây, chúng ta sẽ không thể liên lạc với nhau được nữa.
Dialogue: 0,0:18:58.15,0:19:01.55,Default,,0000,0000,0000,,Ngay cả khi chúng ta {\i1}có{\i0} gặp lại nhau đi chăng nữa, có thể tôi sẽ không còn là tôi của hiện tại nữa đâu.
Dialogue: 0,0:19:01.88,0:19:04.78,Default,,0000,0000,0000,,Tôi muốn cậu cũng phải đặt sự sống còn của bản thân lên ưu tiên hàng đầu, Batou.
Dialogue: 0,0:19:12.13,0:19:15.69,Default,,0000,0000,0000,,Như tôi đã nói đi nói lại với các anh bao nhiêu lần rồi, chuyện đó không hề đúng sự thật.
Dialogue: 0,0:19:16.23,0:19:19.39,Default,,0000,0000,0000,,Vậy thì một thành viên của Đội 9 đã làm cái quái gì khi tiếp xúc với ông Serano...
Dialogue: 0,0:19:19.73,0:19:21.70,Default,,0000,0000,0000,,...trong khi mạo danh là Gã Mặt Cười hả?
Dialogue: 0,0:19:22.40,0:19:23.74,Default,,0000,0000,0000,,Nghe này, việc đó là để...
Dialogue: 0,0:19:23.74,0:19:24.77,Default,,0000,0000,0000,,Để làm gì hả?
Dialogue: 0,0:19:24.77,0:19:27.76,Default,,0000,0000,0000,,Hơn nữa, bản thân Đội 9 thậm chí còn {\i1}chưa hề tồn tại{\i0} vào sáu năm trước, đúng chứ?
Dialogue: 0,0:19:28.11,0:19:30.91,Default,,0000,0000,0000,,Thì làm quái nào mà Đội 9 có thể dính líu đến vụ án Gã Mặt Cười cho được hả?!
Dialogue: 0,0:19:31.41,0:19:35.08,Default,,0000,0000,0000,,Ngụy tạo dữ liệu vốn là ngón nghề sở trường của đám các người còn gì, đúng không?
Dialogue: 0,0:19:37.65,0:19:39.09,Default,,0000,0000,0000,,Làm ơn tha cho tôi đi có được không?
Dialogue: 0,0:19:39.45,0:19:42.51,Default,,0000,0000,0000,,Sáu năm trước, tôi cũng chỉ là một điều tra viên ở sở cảnh sát, y hệt như các anh bây giờ thôi!
Dialogue: 0,0:19:43.96,0:19:48.49,Default,,0000,0000,0000,,Được rồi, chúng ta hãy làm lại từ đầu một lần nữa nhé.
Dialogue: 0,0:19:54.80,0:19:56.10,Default,,0000,0000,0000,,Chúng ta chia tay tại đây thôi.
Dialogue: 0,0:19:57.00,0:19:58.40,Default,,0000,0000,0000,,Ừ, được thôi.
Dialogue: 0,0:20:34.48,0:20:37.67,Default,,0000,0000,0000,,Thiếu tá cử tôi tới. Chú có món đồ uống quen thuộc của cô ấy không?
Dialogue: 0,0:20:39.28,0:20:42.91,Default,,0000,0000,0000,,Thứ lỗi cho tôi nhé, nhưng tôi còn cả đống nợ tiền mua cơ thể máy phải trả...
Dialogue: 0,0:20:45.79,0:20:48.69,Default,,0000,0000,0000,,Nếu còn muốn giữ mạng thì đừng có mà chống cự!
Dialogue: 0,0:20:49.72,0:20:52.39,Default,,0000,0000,0000,,Bọn chúng đã đánh hơi ra cả cái xó này rồi sao?!
Dialogue: 0,0:21:11.75,0:21:15.27,Default,,0000,0000,0000,,Bình thường tôi chẳng bao giờ nhận làm việc cho ai ngoài quý cô đó cả,
Dialogue: 0,0:21:16.22,0:21:20.21,Default,,0000,0000,0000,,nhưng đây là tình huống khẩn cấp, nên có lẽ lần này tôi sẽ phá lệ vậy...
Dialogue: 0,0:21:29.43,0:21:30.36,Default,,0000,0000,0000,,Xác nhận.
Dialogue: 0,0:21:30.70,0:21:31.19,Default,,0000,0000,0000,,Xác nhận.
Dialogue: 0,0:21:31.80,0:21:32.46,Default,,0000,0000,0000,,Xác nhận.
Dialogue: 0,0:21:32.83,0:21:33.49,Default,,0000,0000,0000,,Và xác nhận.
Dialogue: 0,0:21:42.08,0:21:44.77,Default,,0000,0000,0000,,Thế trận đang chuyển biến vô cùng tồi tệ...
Dialogue: 0,0:21:46.48,0:21:47.74,Default,,0000,0000,0000,,Mọi người...
Dialogue: 0,0:21:49.42,0:21:51.09,Default,,0000,0000,0000,,Ý ngài là sao, thưa chỉ huy?!
Dialogue: 0,0:21:51.09,0:21:53.28,Default,,0000,0000,0000,,Rút lui các đơn vị Giáp Chiến Hạng Nặng vào lúc này thì...
Dialogue: 0,0:21:53.82,0:21:56.19,Default,,0000,0000,0000,,Lũ đó {\i1}không phải{\i0} là những kẻ chúng ta có thể hạ gục nếu không dốc toàn lực đề phòng đâu!
Dialogue: 0,0:21:56.76,0:21:58.59,Default,,0000,0000,0000,,{\i1}Tòa nhà đã được kiểm soát hoàn toàn.{\i0}
Dialogue: 0,0:21:58.59,0:22:02.22,Default,,0000,0000,0000,,{\i1}Tại thời điểm nhạy cảm này, việc chúng ta tiếp tục có những hành động công khai lộ liễu là không có lợi.{\i0}
Dialogue: 0,0:22:03.50,0:22:04.83,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:22:06.00,0:22:09.27,Default,,0000,0000,0000,,Để lại hai cỗ Giáp Chiến, toàn bộ lực lượng còn lại lập tức rút lui!
Dialogue: 0,0:22:09.60,0:22:11.24,Default,,0000,0000,0000,,Rõ, thưa chỉ huy! Nhưng...
Dialogue: 0,0:22:11.24,0:22:14.38,Default,,0000,0000,0000,,Tôi đâu có bảo là phải rút {\i1}tất cả{\i0} về. Mau thi hành mệnh lệnh đi!
Dialogue: 0,0:22:14.38,0:22:15.03,Default,,0000,0000,0000,,Rõ, thưa chỉ huy!
Dialogue: 0,0:22:38.43,0:22:40.16,Default,,0000,0000,0000,,Kệ mẹ nó chứ, mạng này là của riêng tao.
Dialogue: 0,0:22:40.67,0:22:43.36,Default,,0000,0000,0000,,Tao muốn ném nó vào đâu là việc của tao!
Dialogue: 0,0:22:43.36,0:22:45.36,Default,,0000,0000,0000,,{\an8\c&HFFFFFF&\fs22}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.40,0:23:20.75,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng vừa lạnh lùng vừa rất đỗi con người
Dialogue: 0,0:23:20.75,0:23:23.65,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.65,0:23:25.96,GitS ED Credits,,0000,0000,0000,,Nàng vẫn rạng rỡ đơn độc một mình
Dialogue: 0,0:23:25.96,0:23:29.02,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng chính là hiện thân của số chín
Dialogue: 0,0:23:29.02,0:23:31.77,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Một ẩn số toán học diệu kỳ
Dialogue: 0,0:23:33.03,0:23:36.05,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Một bài toán kỳ diệu đến không tưởng
Dialogue: 0,0:23:36.32,0:23:40.51,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.51,0:23:43.80,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng là một điều gì đó quá đỗi mới lạ
Dialogue: 0,0:23:43.80,0:23:46.05,GitS ED Credits,,0000,0000,0000,,Đóa hoa lithium vừa bừng tỉnh giấc
Dialogue: 0,0:23:46.05,0:23:48.91,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang hé nở rực rỡ
Dialogue: 0,0:23:49.00,0:23:51.71,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi ngửi thấy mùi lithium thoảng qua
Dialogue: 0,0:23:52.75,0:23:55.83,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Thoang thoảng hương lithium
Dialogue: 0,0:23:57.00,0:24:01.04,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:01.04,0:24:04.87,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:04.87,0:24:07.77,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:07.77,0:24:11.97,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tự hỏi nàng sẽ làm gì khi thức giấc?
Dialogue: 0,0:24:13.25,0:24:16.54,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Mỗi khi nàng tỉnh giấc?


