Dialogue: 0,0:01:47.89,0:01:50.25,Default,,0000,0000,0000,,Vậy ra bọn chúng vẫn chưa tìm thấy người đó sao?
Dialogue: 0,0:02:02.17,0:02:05.70,Default,,0000,0000,0000,,Thôi thì đành đợi đến lúc trời tối vậy...
Dialogue: 0,0:02:28.56,0:02:32.55,Default,,0000,0000,0000,,Thật vinh hạnh khi ông vẫn còn nhớ tới sự tồn tại của Bộ Tư pháp.
Dialogue: 0,0:02:35.17,0:02:39.26,Default,,0000,0000,0000,,Sự cố lần này quả thực là một thảm họa tồi tệ. Tôi thực sự rất lấy làm tiếc cho ông.
Dialogue: 0,0:02:39.71,0:02:42.80,Default,,0000,0000,0000,,Tôi không có nhiều thời gian. Chúng ta hãy đi thẳng vào vấn đề.
Dialogue: 0,0:02:43.71,0:02:48.74,Default,,0000,0000,0000,,Về mặt kỹ thuật, tôi đã giải tán Đội 9, nhưng cấp dưới của tôi hiện vẫn đang lẩn trốn ngoài vòng pháp luật.
Dialogue: 0,0:02:49.68,0:02:53.88,Default,,0000,0000,0000,,Người tôi muốn bảo vệ chính là {\i1}họ{\i0}, chứ không phải cái danh xưng hão huyền của Đội 9.
Dialogue: 0,0:02:55.25,0:02:57.75,Default,,0000,0000,0000,,Ông có thể dùng tài liệu này để thuyết phục ủy ban được không?
Dialogue: 0,0:03:04.23,0:03:06.39,Default,,0000,0000,0000,,Dù tôi có thuyết phục được ủy ban đi chăng nữa,
Dialogue: 0,0:03:06.87,0:03:09.63,Default,,0000,0000,0000,,thì việc làm lung lay quyết định của Thủ tướng có lẽ là điều bất khả thi.
Dialogue: 0,0:03:10.27,0:03:13.24,Default,,0000,0000,0000,,Ít nhất là cho tới khi cuộc bầu cử Hạ viện kết thúc.
Dialogue: 0,0:03:14.04,0:03:15.70,Default,,0000,0000,0000,,Tạm thời bây giờ, ngài ấy vẫn sẽ đứng ra ủng hộ Yakushima.
Dialogue: 0,0:03:16.04,0:03:18.64,Default,,0000,0000,0000,,Rồi sau cuộc bầu cử, ngài ấy sẽ thúc đẩy bổ nhiệm một Tổng Thư ký Đảng mới,
Dialogue: 0,0:03:19.08,0:03:20.98,Default,,0000,0000,0000,,ném cho giới truyền thông một mẩu tin sốt dẻo,
Dialogue: 0,0:03:20.98,0:03:24.68,Default,,0000,0000,0000,,và ban phát cho công chúng một ảo tưởng ngọt ngào về công lý xã hội.
Dialogue: 0,0:03:25.18,0:03:28.02,Default,,0000,0000,0000,,Đó chính là kế hoạch đã được vạch sẵn trong đầu Thủ tướng.
Dialogue: 0,0:03:28.55,0:03:30.25,Default,,0000,0000,0000,,Để đổi lấy tính mạng của người của tôi sao?
Dialogue: 0,0:03:31.79,0:03:34.89,Default,,0000,0000,0000,,Chỉ cần ông còn được tự do, tổ chức của ông luôn có thể được tái sinh.
Dialogue: 0,0:03:35.53,0:03:38.36,Default,,0000,0000,0000,,Ông việc gì phải chôn vùi số phận cùng với Đội 9 cơ chứ.
Dialogue: 0,0:03:39.23,0:03:44.07,Default,,0000,0000,0000,,Nếu để vụt mất cơ hội ngàn vàng này, tôi sẽ chẳng bao giờ có thể quy tụ được những thành viên xuất chúng như họ nữa.
Dialogue: 0,0:03:44.94,0:03:48.96,Default,,0000,0000,0000,,Nếu không có họ, Đội 9 sẽ vĩnh viễn không bao giờ có thể tái thiết được.
Dialogue: 0,0:03:50.84,0:03:52.11,Default,,0000,0000,0000,,Dừng xe lại.
Dialogue: 0,0:03:55.18,0:03:57.58,Default,,0000,0000,0000,,Yakushima là một kẻ vô cùng quyền thế.
Dialogue: 0,0:03:58.25,0:04:02.05,Default,,0000,0000,0000,,Việc bắt giữ ông ta ắt hẳn cũng là giấc mơ thành hiện thực đối với các công tố viên.
Dialogue: 0,0:04:03.09,0:04:05.58,Default,,0000,0000,0000,,Thế nhưng suy cho cùng, họ làm việc là vì lợi ích chung của nhà nước.
Dialogue: 0,0:04:06.49,0:04:09.62,Default,,0000,0000,0000,,Ông định làm gì với thứ này? Mang nó về lại sao?
Dialogue: 0,0:04:10.33,0:04:13.09,Default,,0000,0000,0000,,Không. Tôi sẽ gửi lại nó cho ông.
Dialogue: 0,0:04:13.80,0:04:17.33,Default,,0000,0000,0000,,Vậy sao ông không thử cất lời nhờ vả một cách lịch thiệp hơn xem?
Dialogue: 0,0:04:18.14,0:04:22.80,Default,,0000,0000,0000,,Cầu xin một cách lịch thiệp chẳng bao giờ mang lại kết quả chừng nào ta chưa nắm thế thượng phong.
Dialogue: 0,0:04:23.51,0:04:24.81,Default,,0000,0000,0000,,Ông có nghĩ vậy không?
Dialogue: 0,0:04:25.71,0:04:27.14,Default,,0000,0000,0000,,Tất nhiên là ông nói đúng rồi.
Dialogue: 0,0:04:28.31,0:04:30.15,Default,,0000,0000,0000,,Tôi không có ác ý gì đâu nhé.
Dialogue: 0,0:04:50.17,0:04:52.83,Default,,0000,0000,0000,,Bản tin về Đội 9 khiến tôi bồn chồn lo lắng quá...
Dialogue: 0,0:04:53.27,0:04:55.80,Default,,0000,0000,0000,,Chiến sự đang diễn biến hết sức bất lợi...
Dialogue: 0,0:05:01.08,0:05:03.84,Default,,0000,0000,0000,,Đúng vậy đấy, người anh em à...
Dialogue: 0,0:05:04.35,0:05:06.32,Default,,0000,0000,0000,,Chiến sự đang diễn biến hết sức bất lợi.
Dialogue: 0,0:05:06.82,0:05:11.78,Default,,0000,0000,0000,,Tòa nhà bị nổ tung đêm qua chính là nơi tôi từng sinh sống đấy.
Dialogue: 0,0:05:13.43,0:05:17.79,Default,,0000,0000,0000,,Ở đây kể cũng dễ chịu, tôi rất quý tất cả các bác lão làng ở đây,
Dialogue: 0,0:05:19.06,0:05:22.19,Default,,0000,0000,0000,,nhưng có một người mà tôi thực sự muốn tới ứng cứu bằng mọi giá.
Dialogue: 0,0:05:24.30,0:05:26.24,Default,,0000,0000,0000,,Chiến sự đang diễn biến hết sức bất lợi...
Dialogue: 0,0:05:28.77,0:05:30.50,Default,,0000,0000,0000,,Bác gì ơi, thứ kia có phải là thứ cháu đang nghĩ không?
Dialogue: 0,0:05:31.41,0:05:33.64,Default,,0000,0000,0000,,Bác ơi, cháu... Cảm ơn bác nhiều lắm!
Dialogue: 0,0:05:33.98,0:05:35.17,Default,,0000,0000,0000,,Cháu phải đi ngay đây!
Dialogue: 0,0:06:29.70,0:06:31.10,Default,,0000,0000,0000,,Đang phân tích mã vạch máy đọc.
Dialogue: 0,0:06:31.10,0:06:34.56,Default,,0000,0000,0000,,Thời gian chuyển đổi dữ liệu thành các hạt giống và phân tán hoàn tất là 16 phút.
Dialogue: 0,0:06:35.57,0:06:36.94,Default,,0000,0000,0000,,Tốt lắm...
Dialogue: 0,0:06:49.15,0:06:53.35,Default,,0000,0000,0000,,Hãy giữ bình tĩnh! Nghe theo chỉ dẫn của chúng tôi và rời khỏi hiện trường ngay lập tức.
Dialogue: 0,0:07:01.03,0:07:04.00,Default,,0000,0000,0000,,Đại úy, chúng tôi đã sơ tán toàn bộ thường dân rồi.
Dialogue: 0,0:07:04.37,0:07:05.17,Default,,0000,0000,0000,,Tốt, vậy thì...
Dialogue: 0,0:07:05.60,0:07:07.84,Default,,0000,0000,0000,,Bắt tay vào việc thu giữ bằng chứng ngay.
Dialogue: 0,0:07:07.84,0:07:08.83,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:07:15.28,0:07:16.48,Default,,0000,0000,0000,,{\i1}Tốt lắm.{\i0}
Dialogue: 0,0:07:17.15,0:07:18.45,Default,,0000,0000,0000,,{\i1}Xin lỗi các người nhé.{\i0}
Dialogue: 0,0:07:25.39,0:07:28.16,Default,,0000,0000,0000,,Chuyện gì thế hả?! Xác minh tình hình ngay!
Dialogue: 0,0:07:28.83,0:07:30.56,Default,,0000,0000,0000,,{\i1}Nợ máu thì phải trả bằng máu.{\i0}
Dialogue: 0,0:07:31.70,0:07:33.23,Default,,0000,0000,0000,,Tại sao các người không cho chúng tôi sơ tán hả?
Dialogue: 0,0:07:33.23,0:07:35.10,Default,,0000,0000,0000,,Các người định giết sạch chúng tôi sao?!
Dialogue: 0,0:07:43.91,0:07:45.50,Default,,0000,0000,0000,,Chắc hẳn anh là Ishikawa rồi.
Dialogue: 0,0:07:52.05,0:07:53.85,Default,,0000,0000,0000,,Sau khi đã sơ cứu cho những người bị thương,
Dialogue: 0,0:07:53.85,0:07:57.15,Default,,0000,0000,0000,,hãy tập hợp những ai còn sót lại và rút lui khỏi đây ngay.
Dialogue: 0,0:07:58.12,0:08:00.28,Default,,0000,0000,0000,,Chúng ta sẽ chẳng thể thu giữ được thứ gì từ đống đổ nát đó nữa đâu.
Dialogue: 0,0:08:01.63,0:08:03.72,Default,,0000,0000,0000,,Chà chà, tiếc thật đấy nhỉ...
Dialogue: 0,0:08:04.90,0:08:07.16,Default,,0000,0000,0000,,Tôi nhất định sẽ bắt anh phải trả giá đắt cho mạng sống của những cấp dưới của tôi.
Dialogue: 0,0:08:10.20,0:08:13.17,Default,,0000,0000,0000,,Tôi sẽ khiến anh phải ước gì mình {\i1}đã thực sự{\i0} bỏ mạng tại nơi đó.
Dialogue: 0,0:08:13.64,0:08:17.60,Default,,0000,0000,0000,,{\i1}Đại úy! Có vẻ như mẻ lưới chúng ta giăng quanh căn nhà an toàn đã tóm được mục tiêu rồi ạ!{\i0}
Dialogue: 0,0:08:18.04,0:08:19.45,Default,,0000,0000,0000,,{\i1}Là nữ chỉ huy sao?{\i0}
Dialogue: 0,0:08:19.45,0:08:22.01,Default,,0000,0000,0000,,{\i1}Báo cáo, không phải ạ. Là gã to con mang đôi mắt giả máy móc.{\i0}
Dialogue: 0,0:08:22.98,0:08:25.85,Default,,0000,0000,0000,,{\i1}Điều động ngay các cỗ Giáp Chiến Hạng Nặng chúng ta giữ lại tới đó!{\i0}
Dialogue: 0,0:08:25.85,0:08:26.82,Default,,0000,0000,0000,,{\i1}Rõ!{\i0}
Dialogue: 0,0:08:29.86,0:08:34.62,Default,,0000,0000,0000,,Batou, anh đã để lại ít dầu tự nhiên cho tụi em kìa!
Dialogue: 0,0:08:35.49,0:08:36.48,Default,,0000,0000,0000,,Chào anh nhé!
Dialogue: 0,0:08:37.80,0:08:39.40,Default,,0000,0000,0000,,Mấy {\i1}đứa nhóc các em{\i0} làm cái trò gì ở đây thế hả?
Dialogue: 0,0:08:39.40,0:08:42.70,Default,,0000,0000,0000,,Một khi đã là những đứa trẻ ngỗ nghịch rắc rối, thì sẽ mãi là những đứa trẻ ngỗ nghịch mà, anh biết rồi đấy?
Dialogue: 0,0:08:43.00,0:08:46.84,Default,,0000,0000,0000,,Em đoán điều này có nghĩa là tụi em đều chung một khát khao dù mỗi đứa đều hoàn toàn độc lập với nhau.
Dialogue: 0,0:08:47.24,0:08:50.44,Default,,0000,0000,0000,,Một điểm chung gắn kết tụi em là tất cả đều muốn tới cứu anh Batou.
Dialogue: 0,0:08:51.04,0:08:55.88,Default,,0000,0000,0000,,Vả lại, một mình anh đâu thể tự nạp được viên đạn pháo cối khổng lồ đang cầm trên tay, đúng không?
Dialogue: 0,0:08:55.88,0:08:56.71,Default,,0000,0000,0000,,Ừ thì...
Dialogue: 0,0:08:57.38,0:08:59.78,Default,,0000,0000,0000,,Nhưng chỉ có mấy đứa tụi em tới đây thôi sao?
Dialogue: 0,0:09:00.42,0:09:03.48,Default,,0000,0000,0000,,Trong số tất cả những đứa bị đưa về phòng thí nghiệm, chỉ có mình em là sống sót thôi.
Dialogue: 0,0:09:04.32,0:09:07.92,Default,,0000,0000,0000,,Họ để em nằm trơ trọi một chỗ, cắm chằng chịt dây nhợ để chuẩn bị cho bài kiểm tra phân hủy cuối cùng.
Dialogue: 0,0:09:08.53,0:09:10.83,Default,,0000,0000,0000,,Thế là em giật tung dây nhợ rồi bỏ chạy thục mạng luôn!
Dialogue: 0,0:09:11.70,0:09:14.23,Default,,0000,0000,0000,,Em không tài nào ngừng thắc mắc chuyện gì đang xảy ra...
Dialogue: 0,0:09:14.23,0:09:16.53,Default,,0000,0000,0000,,...trong lúc em đang phải làm việc trên cao ở một công trường xây dựng.
Dialogue: 0,0:09:16.87,0:09:17.97,Default,,0000,0000,0000,,Còn cậu thì sao?
Dialogue: 0,0:09:17.97,0:09:19.90,Default,,0000,0000,0000,,Tớ cũng gần như y chang vậy thôi.
Dialogue: 0,0:09:20.24,0:09:22.81,Default,,0000,0000,0000,,Chuyện gì đã xảy ra với những đứa khác bị đưa về phòng thí nghiệm thế?
Dialogue: 0,0:09:22.81,0:09:23.84,Default,,0000,0000,0000,,Ừ, chuyện gì đã xảy ra vậy?
Dialogue: 0,0:09:23.84,0:09:26.08,Default,,0000,0000,0000,,Tất cả bọn họ đều bị rã xác hết rồi!
Dialogue: 0,0:09:26.08,0:09:28.74,Default,,0000,0000,0000,,Này, có cái cậu suốt ngày chỉ mải mê đọc sách ấy, nhớ không?
Dialogue: 0,0:09:29.42,0:09:33.35,Default,,0000,0000,0000,,Lúc vừa về tới phòng thí nghiệm, việc đầu tiên họ làm là tháo tung não của cậu ấy ra.
Dialogue: 0,0:09:34.12,0:09:36.49,Default,,0000,0000,0000,,Cơ mà trông cậu ấy có vẻ như đang tận hưởng trải nghiệm đó lắm...
Dialogue: 0,0:09:36.96,0:09:37.98,Default,,0000,0000,0000,,À, ra là vậy...
Dialogue: 0,0:09:39.19,0:09:42.96,Default,,0000,0000,0000,,Vậy là ai cũng được nếm trải cảm giác cái chết là như thế nào rồi...
Dialogue: 0,0:10:01.18,0:10:02.67,Default,,0000,0000,0000,,Đúng là Thiếu tá của mình có khác...
Dialogue: 0,0:10:03.18,0:10:04.71,Default,,0000,0000,0000,,Chẳng bao giờ cô ấy bỏ sót bất kỳ chi tiết nào.
Dialogue: 0,0:10:51.66,0:10:53.65,Default,,0000,0000,0000,,Đừng có manh động! Bỏ vũ khí xuống ngay!
Dialogue: 0,0:10:55.30,0:10:57.89,Default,,0000,0000,0000,,Được rồi. Tôi đầu hàng.
Dialogue: 0,0:11:46.72,0:11:47.84,Default,,0000,0000,0000,,Trúng phóc!
Dialogue: 0,0:11:48.19,0:11:50.68,Default,,0000,0000,0000,,Mình biết ngay là Thiếu tá thể nào cũng giấu một kho vũ khí quanh đây mà.
Dialogue: 0,0:12:11.04,0:12:12.74,Default,,0000,0000,0000,,Mày đã chịu ngừng chống cự rồi đấy à?
Dialogue: 0,0:12:26.39,0:12:28.15,Default,,0000,0000,0000,,Chết tiệt, mình giết chết hắn rồi...
Dialogue: 0,0:12:28.93,0:12:33.09,Default,,0000,0000,0000,,Ồ, tao hiểu rồi... Trong mắt mày thì tao đã chết rồi đúng không?
Dialogue: 0,0:12:36.03,0:12:38.94,Default,,0000,0000,0000,,Xin lỗi nhé anh bạn, tao vừa hack mắt mày rồi.
Dialogue: 0,0:13:05.56,0:13:08.56,Default,,0000,0000,0000,,Đùa tao đấy à?! Vẫn còn {\i1}nữa sao?!{\i0}
Dialogue: 0,0:13:25.92,0:13:28.18,Default,,0000,0000,0000,,Đáng lẽ ra chẳng ai phải chết cả, khốn kiếp thật.
Dialogue: 0,0:13:28.62,0:13:30.28,Default,,0000,0000,0000,,{\i1}Quên chuyện{\i0} bắt sống mày đi!
Dialogue: 0,0:13:30.96,0:13:32.51,Default,,0000,0000,0000,,Tao sẽ mang cái {\i1}xác không hồn{\i0} của mày về quy án.
Dialogue: 0,0:13:33.73,0:13:35.42,Default,,0000,0000,0000,,Nhưng trước đó...
Dialogue: 0,0:13:37.83,0:13:40.35,Default,,0000,0000,0000,,Phát này là trả thù cho những đồng đội của tao mà mày đã giết!
Dialogue: 0,0:13:49.41,0:13:51.60,Default,,0000,0000,0000,,Phát này là dành cho người cộng sự quá cố của tao!
Dialogue: 0,0:14:03.66,0:14:04.68,Default,,0000,0000,0000,,Thứ quái gì thế này...?
Dialogue: 0,0:14:05.49,0:14:07.01,Default,,0000,0000,0000,,Cơ hội tới rồi! Mau đưa anh Batou rời khỏi đây ngay!
Dialogue: 0,0:14:07.53,0:14:08.46,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:14:12.83,0:14:14.13,Default,,0000,0000,0000,,Là đám xe tăng chiến thuật sao?!
Dialogue: 0,0:14:20.71,0:14:21.60,Default,,0000,0000,0000,,Em sẽ xông lên trước!
Dialogue: 0,0:14:23.58,0:14:26.17,Default,,0000,0000,0000,,Anh Batou... Em xin lỗi vì đã tới muộn.
Dialogue: 0,0:14:26.91,0:14:29.64,Default,,0000,0000,0000,,Tụi em mất một lúc lâu mới bắt được tần số tín hiệu đàm thoại của chúng.
Dialogue: 0,0:14:31.35,0:14:36.34,Default,,0000,0000,0000,,Dù thế nào tụi em cũng sẽ hạ gục tên này, nên anh cứ ở đây đợi tụi em quay lại nhé?
Dialogue: 0,0:14:37.19,0:14:38.68,Default,,0000,0000,0000,,Lũ quỷ nhỏ này...
Dialogue: 0,0:14:43.73,0:14:45.56,Default,,0000,0000,0000,,Rốt cuộc thì mấy đứa đã biến đi đằng nào suốt thời gian qua thế hả?
Dialogue: 0,0:14:46.67,0:14:49.07,Default,,0000,0000,0000,,Cậu nghĩ mình có thể dùng dây cáp ghìm chặt nó lại được không?
Dialogue: 0,0:14:49.40,0:14:50.37,Default,,0000,0000,0000,,Tớ sẽ cố hết sức!
Dialogue: 0,0:14:54.81,0:14:56.36,Default,,0000,0000,0000,,Mấy đứa nhóc này định làm cái trò gì thế không biết?
Dialogue: 0,0:15:04.25,0:15:05.61,Default,,0000,0000,0000,,À, mình hiểu rồi...
Dialogue: 0,0:15:12.89,0:15:14.05,Default,,0000,0000,0000,,Thằng khốn!
Dialogue: 0,0:15:28.77,0:15:32.34,Default,,0000,0000,0000,,Mình không được vội vàng... Mình chỉ có duy nhất một phát bắn này thôi.
Dialogue: 0,0:15:44.76,0:15:46.38,Default,,0000,0000,0000,,Ngay bây giờ! Bắn đi!
Dialogue: 0,0:15:46.59,0:15:47.42,Default,,0000,0000,0000,,Rõ rồi!
Dialogue: 0,0:15:50.66,0:15:52.22,Default,,0000,0000,0000,,Ăn đạn này!
Dialogue: 0,0:15:59.37,0:16:00.57,Default,,0000,0000,0000,,Đùa nhau đấy à?
Dialogue: 0,0:16:03.18,0:16:04.70,Default,,0000,0000,0000,,Là một phát đạn xịt sao?
Dialogue: 0,0:16:07.51,0:16:09.14,Default,,0000,0000,0000,,Mình vẫn còn sống sao?
Dialogue: 0,0:16:20.43,0:16:21.55,Default,,0000,0000,0000,,Hỡi Thượng đế cao cả...
Dialogue: 0,0:16:23.76,0:16:26.03,Default,,0000,0000,0000,,Anh em chúng con thật là bất lực xiết bao...
Dialogue: 0,0:16:27.73,0:16:28.96,Default,,0000,0000,0000,,...anh em chúng con...
Dialogue: 0,0:16:29.30,0:16:30.77,Default,,0000,0000,0000,,{\i1}Không phải như vậy đâu.{\i0}
Dialogue: 0,0:16:35.31,0:16:39.71,Default,,0000,0000,0000,,{\i1}Những gì mà các em và những đứa khác đã gặt hái được khiến các em không hề bất lực chút nào.{\i0}
Dialogue: 0,0:16:41.25,0:16:42.37,Default,,0000,0000,0000,,Giọng nói đó!
Dialogue: 0,0:16:48.45,0:16:49.92,Default,,0000,0000,0000,,Đây là phát đạn cuối cùng của tớ rồi!
Dialogue: 0,0:16:57.60,0:16:58.32,Default,,0000,0000,0000,,Ngay bây giờ!
Dialogue: 0,0:16:59.06,0:17:00.16,Default,,0000,0000,0000,,R-Rõ rồi!
Dialogue: 0,0:17:03.24,0:17:04.50,Default,,0000,0000,0000,,Anh Batou!
Dialogue: 0,0:17:06.91,0:17:09.90,Default,,0000,0000,0000,,Vĩnh biệt anh, anh Batou...
Dialogue: 0,0:17:27.19,0:17:28.99,Default,,0000,0000,0000,,Chúng ta vừa mất luôn tín hiệu của Đơn vị số 2 rồi.
Dialogue: 0,0:17:29.56,0:17:33.43,Default,,0000,0000,0000,,Thật khó mà tưởng tượng nổi, chẳng lẽ cả hai cỗ máy đó đều đã bị tiêu diệt rồi sao?
Dialogue: 0,0:17:34.67,0:17:36.79,Default,,0000,0000,0000,,Ở đây tôi là người đưa ra phán quyết.
Dialogue: 0,0:17:37.27,0:17:39.26,Default,,0000,0000,0000,,Trước mắt, hãy điều khiển xe lao hết tốc lực tới hiện trường ngay lập tức.
Dialogue: 0,0:17:48.18,0:17:50.20,Default,,0000,0000,0000,,Bọn chúng đã làm cái gì ở đây thế này?
Dialogue: 0,0:17:51.05,0:17:55.42,Default,,0000,0000,0000,,Chúng chẳng nghĩ được điều gì ngoài việc muốn cứu cậu, nên đã liều mạng trốn khỏi phòng thí nghiệm.
Dialogue: 0,0:17:57.72,0:17:59.38,Default,,0000,0000,0000,,Thiếu tá? Có phải cô đó không?
Dialogue: 0,0:18:00.53,0:18:05.09,Default,,0000,0000,0000,,Tôi đã từng phán quyết chúng không còn hữu dụng như một vũ khí...
Dialogue: 0,0:18:05.63,0:18:08.39,Default,,0000,0000,0000,,...bởi vì trí tuệ nhân tạo của chúng phát triển quá nhanh.
Dialogue: 0,0:18:09.17,0:18:12.93,Default,,0000,0000,0000,,Thế nhưng trong suốt quá trình mải miết thu thập dữ liệu...
Dialogue: 0,0:18:13.27,0:18:15.26,Default,,0000,0000,0000,,...và đồng bộ hóa với nhau hết lần này đến lần khác,
Dialogue: 0,0:18:15.61,0:18:20.64,Default,,0000,0000,0000,,chúng đã âm thầm hình thành cá tính riêng mà tôi không hề hay biết, thậm chí còn biết hy sinh thân mình.
Dialogue: 0,0:18:22.61,0:18:25.64,Default,,0000,0000,0000,,Giá như tôi nhận ra điều đó sớm hơn,
Dialogue: 0,0:18:26.55,0:18:32.08,Default,,0000,0000,0000,,tôi đã có thể kiểm chứng xem liệu thứ chúng vừa gặt hái được có phải là một Ghost hay không.
Dialogue: 0,0:18:32.66,0:18:33.92,Default,,0000,0000,0000,,Một Ghost sao?
Dialogue: 0,0:18:34.93,0:18:39.76,Default,,0000,0000,0000,,Nếu không nhờ chúng có mặt ở đây, giờ này cậu đã chết mất xác rồi.
Dialogue: 0,0:18:40.83,0:18:41.73,Default,,0000,0000,0000,,Di chuyển thôi!
Dialogue: 0,0:18:57.12,0:18:58.88,Default,,0000,0000,0000,,Tầm nhìn từ chỗ này hướng về Đội 9 đẹp thật đấy.
Dialogue: 0,0:18:59.85,0:19:02.79,Default,,0000,0000,0000,,Tôi không thể tin nổi là cô lại có một căn nhà an toàn bí mật ở {\i1}chính nơi này{\i0} đấy...
Dialogue: 0,0:19:05.96,0:19:07.12,Default,,0000,0000,0000,,Này.
Dialogue: 0,0:19:18.27,0:19:20.70,Default,,0000,0000,0000,,Phải rồi, không có vỏ bọc nào sánh bằng được...
Dialogue: 0,0:19:25.68,0:19:27.77,Default,,0000,0000,0000,,Đó là một con rối điều khiển từ xa sao?
Dialogue: 0,0:19:30.28,0:19:31.48,Default,,0000,0000,0000,,Chính xác là như vậy.
Dialogue: 0,0:19:56.57,0:20:01.07,Default,,0000,0000,0000,,Nhắc mới nhớ, suýt chút nữa thì tôi không kịp trao tận tay thứ này cho cậu rồi.
Dialogue: 0,0:20:04.02,0:20:05.31,Default,,0000,0000,0000,,Tôi biết ngay mà...
Dialogue: 0,0:20:05.82,0:20:07.82,Default,,0000,0000,0000,,Dù cho cậu có thay đổi bao nhiêu vỏ bọc cơ thể giả đi chăng nữa,
Dialogue: 0,0:20:07.82,0:20:11.78,Default,,0000,0000,0000,,thì đây vẫn là thứ duy nhất luôn điểm từng nhịp thời gian cùng với cậu, đúng chứ?
Dialogue: 0,0:20:13.56,0:20:16.03,Default,,0000,0000,0000,,Trong dòng thời gian quá đỗi phù du này,
Dialogue: 0,0:20:16.36,0:20:20.56,Default,,0000,0000,0000,,con người ta gửi gắm ký ức vào các thiết bị {\i1}ngoại vi{\i0} vì họ muốn khắc ghi một bằng chứng...
Dialogue: 0,0:20:21.40,0:20:23.89,Default,,0000,0000,0000,,...có thể định danh bản thân như một cá thể độc nhất vô nhị.
Dialogue: 0,0:20:25.04,0:20:29.74,Default,,0000,0000,0000,,Đối với cậu, chẳng phải chiếc đồng hồ đó chính là {\i1}thiết bị ghi nhớ ngoại vi duy nhất{\i0}...
Dialogue: 0,0:20:30.11,0:20:32.41,Default,,0000,0000,0000,,...có thể định danh con người cậu từ trước cho tới tận hôm nay hay sao?
Dialogue: 0,0:20:34.65,0:20:39.41,Default,,0000,0000,0000,,Nghe thâm thúy gớm nhỉ... Cô nhặt mấy câu triết lý này ở đâu ra thế?
Dialogue: 0,0:20:41.59,0:20:43.65,Default,,0000,0000,0000,,Một chiếc đồng hồ và những bài tập tạ sao?
Dialogue: 0,0:20:44.56,0:20:48.58,Default,,0000,0000,0000,,Cả hai chúng ta đều cố bấu víu vào những mảnh vụn ký ức vô tích sự, đúng chứ?
Dialogue: 0,0:20:51.20,0:20:56.07,Default,,0000,0000,0000,,Có lẽ cậu và tôi là hai thành viên duy nhất của Đội 9 vẫn chưa bị bắt giữ.
Dialogue: 0,0:20:56.90,0:21:01.70,Default,,0000,0000,0000,,Hãy cùng sống sót và để lại minh chứng cho những gì chúng ta đã nỗ lực thực hiện.
Dialogue: 0,0:21:02.94,0:21:06.07,Default,,0000,0000,0000,,Ừ, tôi sẽ không chịu chết khi chưa hoàn thành sứ mệnh của mình đâu.
Dialogue: 0,0:21:29.57,0:21:33.06,Default,,0000,0000,0000,,{\i1}Mục tiêu bắn tỉa ưu tiên số một là Motoko Kusanagi.{\i0}
Dialogue: 0,0:21:33.84,0:21:37.40,Default,,0000,0000,0000,,{\i1}Ủy ban đã ban hành mệnh lệnh trừ khử cô ta.{\i0}
Dialogue: 0,0:21:38.14,0:21:39.58,Default,,0000,0000,0000,,{\i1}Chúng ta chỉ có duy nhất một cơ hội này thôi.{\i0}
Dialogue: 0,0:21:40.95,0:21:43.04,Default,,0000,0000,0000,,{\i1}Bắn hạ khi ả đang leo lên máy bay.{\i0}
Dialogue: 0,0:22:14.35,0:22:15.28,Default,,0000,0000,0000,,Motoko!
Dialogue: 0,0:22:27.96,0:22:28.89,Default,,0000,0000,0000,,Motoko!
Dialogue: 0,0:22:29.36,0:22:30.49,Default,,0000,0000,0000,,Motoko!
Dialogue: 0,0:22:33.80,0:22:35.49,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:22:38.07,0:22:41.06,Default,,0000,0000,0000,,{\i1}Không phát hiện dấu hiệu sinh tồn. Xác nhận mục tiêu đã bị tiêu diệt hoàn toàn.{\i0}
Dialogue: 0,0:22:45.18,0:22:46.67,Default,,0000,0000,0000,,Lũ chó chết...
Dialogue: 0,0:22:52.18,0:22:56.24,Default,,0000,0000,0000,,MOTOKO!
Dialogue: 0,0:22:56.24,0:22:58.24,Default,,0000,0000,0000,,{\an8\c&HFFFFFF&\fs22}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.40,0:23:20.75,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng vừa lạnh lùng vừa rất đỗi con người
Dialogue: 0,0:23:20.75,0:23:23.65,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.65,0:23:25.96,GitS ED Credits,,0000,0000,0000,,Nàng vẫn rạng rỡ đơn độc một mình
Dialogue: 0,0:23:25.96,0:23:29.02,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng chính là hiện thân của số chín
Dialogue: 0,0:23:29.02,0:23:31.77,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Một ẩn số toán học diệu kỳ
Dialogue: 0,0:23:33.03,0:23:36.05,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Một bài toán kỳ diệu đến không tưởng
Dialogue: 0,0:23:36.32,0:23:40.51,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.51,0:23:43.80,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng là một điều gì đó quá đỗi mới lạ
Dialogue: 0,0:23:43.80,0:23:46.05,GitS ED Credits,,0000,0000,0000,,Đóa hoa lithium vừa bừng tỉnh giấc
Dialogue: 0,0:23:46.05,0:23:48.91,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang hé nở rực rỡ
Dialogue: 0,0:23:49.00,0:23:51.71,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi ngửi thấy mùi lithium thoảng qua
Dialogue: 0,0:23:52.75,0:23:55.83,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Thoang thoảng hương lithium
Dialogue: 0,0:23:57.00,0:24:01.04,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:01.04,0:24:04.87,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:04.87,0:24:07.77,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:07.77,0:24:11.97,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tự hỏi nàng sẽ làm gì khi thức giấc?
Dialogue: 0,0:24:13.25,0:24:16.54,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Mỗi khi nàng tỉnh giấc?

