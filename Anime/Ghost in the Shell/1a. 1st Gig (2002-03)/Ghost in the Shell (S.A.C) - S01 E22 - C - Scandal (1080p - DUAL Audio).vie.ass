Dialogue: 0,0:01:43.55,0:01:44.52,Default,,0000,0000,0000,,Vậy là chúng đã tới...
Dialogue: 0,0:01:45.28,0:01:48.92,Default,,0000,0000,0000,,Aramaki sẽ chẳng thể đi xa hơn tôi đâu. Nói với ông ta như thế.
Dialogue: 0,0:01:48.92,0:01:50.29,Default,,0000,0000,0000,,Tôi hiểu rồi, thưa ngài.
Dialogue: 0,0:02:01.20,0:02:02.26,Default,,0000,0000,0000,,Vào đi.
Dialogue: 0,0:02:03.17,0:02:04.16,Default,,0000,0000,0000,,Thất lễ rồi.
Dialogue: 0,0:02:04.97,0:02:08.98,Default,,0000,0000,0000,,Cục trưởng Niimi, lệnh bắt giữ ngài đã được ban hành, với các cáo buộc...
Dialogue: 0,0:02:08.98,0:02:13.18,Default,,0000,0000,0000,,...xúi giục giết người trong chiến dịch vây ráp Hội Hoa Hướng Dương,
Dialogue: 0,0:02:13.18,0:02:14.84,Default,,0000,0000,0000,,cũng như cái chết\Ncủa Imakurusu Hisashi.
Dialogue: 0,0:02:15.18,0:02:17.08,Default,,0000,0000,0000,,Mời ngài\Nđi cùng chúng tôi.
Dialogue: 0,0:02:18.62,0:02:20.55,Default,,0000,0000,0000,,Tôi đã nghe về những gì xảy ra bên lực lượng chống ma túy rồi.
Dialogue: 0,0:02:20.89,0:02:25.89,Default,,0000,0000,0000,,Nhưng các anh nghĩ tôi lại ra lệnh giết Imakurusu sao?
Dialogue: 0,0:02:25.89,0:02:28.86,Default,,0000,0000,0000,,Còn về đội trưởng đội bài trừ ma túy\NGayle Yasuoka,
Dialogue: 0,0:02:29.63,0:02:32.26,Default,,0000,0000,0000,,hắn ta đang tỏ ra hợp tác hơn nhiều so với dự tính của chúng tôi đấy.
Dialogue: 0,0:02:32.50,0:02:35.09,Default,,0000,0000,0000,,Rõ ràng hắn đã ghi âm lại toàn bộ các cuộc đàm thoại với ngài,
Dialogue: 0,0:02:35.43,0:02:37.27,Default,,0000,0000,0000,,thế nên hắn đang vô cùng tích cực phối hợp điều tra.
Dialogue: 0,0:02:37.67,0:02:42.23,Default,,0000,0000,0000,,Vụ án Gã Mặt Cười cũng có mối liên hệ mật thiết tới động cơ trừ khử Imakurusu của ngài,
Dialogue: 0,0:02:42.58,0:02:44.98,Default,,0000,0000,0000,,vì vậy tôi tin chúng ta sẽ có rất nhiều điều để đàm đạo đấy.
Dialogue: 0,0:02:45.88,0:02:48.28,Default,,0000,0000,0000,,Được thôi.\NTôi đã sẵn sàng.
Dialogue: 0,0:02:49.72,0:02:50.84,Default,,0000,0000,0000,,Giải ông ta đi.
Dialogue: 0,0:03:05.63,0:03:07.29,Default,,0000,0000,0000,,Tạm thời tôi sẽ\Nquay về tổng hành dinh.
Dialogue: 0,0:03:07.67,0:03:10.07,Default,,0000,0000,0000,,Borma, cậu đi cùng Niimi\Nvà tham gia buổi thẩm vấn.
Dialogue: 0,0:03:10.34,0:03:13.14,Default,,0000,0000,0000,,Paz, cậu tới Ban Nhân sự\Ncủa Cục Kiểm soát Ma túy...
Dialogue: 0,0:03:13.14,0:03:15.54,Default,,0000,0000,0000,,...và truy lùng tung tích các thành viên còn lại của đội trấn áp.
Dialogue: 0,0:03:15.88,0:03:17.28,Default,,0000,0000,0000,,Chúng ta sẽ bắt đầu từ đó.
Dialogue: 0,0:03:17.28,0:03:18.44,Default,,0000,0000,0000,,- Rõ, thưa sếp!\N- Rõ, thưa sếp!
Dialogue: 0,0:03:26.82,0:03:29.12,Default,,0000,0000,0000,,Nghị viên Kanzaki?
Dialogue: 0,0:03:32.16,0:03:34.89,Default,,0000,0000,0000,,Vụ giải cứu con gái tôi dạo trước, ông đã xử lý vô cùng xuất sắc.
Dialogue: 0,0:03:35.26,0:03:38.03,Default,,0000,0000,0000,,Không dám, thưa ngài, tôi chỉ làm đúng bổn phận của mình thôi.
Dialogue: 0,0:03:38.36,0:03:40.09,Default,,0000,0000,0000,,Nghị viên tới đây\Ncó việc gì vậy?
Dialogue: 0,0:03:40.63,0:03:44.73,Default,,0000,0000,0000,,Tôi đã thất thế rồi, giờ chỉ là kẻ rảnh rỗi vô công rồi nghề thôi.
Dialogue: 0,0:03:46.31,0:03:50.44,Default,,0000,0000,0000,,Có vẻ ông đang nhân cơ hội này để chạm tới tận cùng chân tướng của vụ án nhỉ.
Dialogue: 0,0:03:50.91,0:03:53.94,Default,,0000,0000,0000,,Ông nghĩ Niimi\Nđang phục vụ dưới trướng ai?
Dialogue: 0,0:03:54.81,0:03:57.01,Default,,0000,0000,0000,,Tôi không thể tiết lộ điều đó.
Dialogue: 0,0:03:57.42,0:03:59.32,Default,,0000,0000,0000,,Ở đây sẽ chẳng ai\Nnghe thấy đâu.
Dialogue: 0,0:04:00.39,0:04:02.38,Default,,0000,0000,0000,,Là Tổng Thư ký Đảng\NYakushima sao?
Dialogue: 0,0:04:05.02,0:04:07.19,Default,,0000,0000,0000,,Vậy là tôi đoán đúng rồi?
Dialogue: 0,0:04:07.53,0:04:12.52,Default,,0000,0000,0000,,Cẩn thận đấy. Khi bị dồn vào chân tường, người đàn ông đó sở hữu những vây cánh vô cùng đáng sợ.
Dialogue: 0,0:04:13.00,0:04:16.96,Default,,0000,0000,0000,,Ít người biết chuyện này, nhưng ông ta có tiếng nói cực kỳ nặng ký trong Hải quân.
Dialogue: 0,0:04:17.30,0:04:19.36,Default,,0000,0000,0000,,Đa tạ ngài\Nđã nhắc nhở.
Dialogue: 0,0:04:19.71,0:04:22.44,Default,,0000,0000,0000,,À, tôi chỉ buột miệng nói vu vơ thôi...
Dialogue: 0,0:04:25.21,0:04:28.87,Default,,0000,0000,0000,,{\i1}Batou, tiến độ điều tra về kẻ nắm giữ tập hồ sơ đó thế nào rồi?{\i0}
Dialogue: 0,0:04:29.18,0:04:31.22,Default,,0000,0000,0000,,{\i1}Tôi vẫn chưa tìm ra manh mối nào cả.{\i0}
Dialogue: 0,0:04:31.22,0:04:34.42,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi. Hắn là một nhân chứng trọng yếu dường như nắm rõ...{\i0}
Dialogue: 0,0:04:34.42,0:04:37.65,Default,,0000,0000,0000,,{\i1}... mối liên hệ giữa loại thuốc bị cấm lưu hành và vụ án Gã Mặt Cười.{\i0}
Dialogue: 0,0:04:38.62,0:04:44.15,Default,,0000,0000,0000,,{\i1}Mau chóng tìm ra mục đích của hắn khi nắm giữ danh sách cấp vắc-xin đó càng sớm càng tốt.{\i0}
Dialogue: 0,0:04:44.73,0:04:47.77,Default,,0000,0000,0000,,{\i1}Còn một điều nữa. Tôi vừa nhận được thông tin đáng ngờ về nguồn gốc...{\i0}
Dialogue: 0,0:04:47.77,0:04:49.33,Default,,0000,0000,0000,,{\i1}... của bộ Giáp Chiến Hạng Nặng đó.{\i0}
Dialogue: 0,0:04:49.67,0:04:52.87,Default,,0000,0000,0000,,{\i1}Tôi sẽ báo cáo chi tiết tại tổng hành dinh. Chúng ta hãy tập hợp ở đó.{\i0}
Dialogue: 0,0:04:53.21,0:04:54.07,Default,,0000,0000,0000,,{\i1}Rõ, thưa Trưởng ban.{\i0}
Dialogue: 0,0:04:54.81,0:04:56.00,Default,,0000,0000,0000,,Cuộc gọi của sếp già hả?
Dialogue: 0,0:04:56.34,0:05:01.87,Default,,0000,0000,0000,,Ừ. Sếp vừa tóm gáy gã tên Niimi, kẻ giật dây sau lưng đội bài trừ ma túy.
Dialogue: 0,0:05:02.72,0:05:06.69,Default,,0000,0000,0000,,Không đùa chứ... Vậy coi như phát đạn găm vào người tôi cũng không uổng công.
Dialogue: 0,0:05:06.69,0:05:09.02,Default,,0000,0000,0000,,Nhưng chuyện về cỗ Giáp Chiến đó là sao thế?
Dialogue: 0,0:05:09.59,0:05:13.22,Default,,0000,0000,0000,,Món đồ chơi mà bọn Cục Ma túy câu trộm được từ đâu đó thôi.
Dialogue: 0,0:05:13.93,0:05:15.62,Default,,0000,0000,0000,,Thiếu tá đã một mình đối đầu với nó.
Dialogue: 0,0:05:16.33,0:05:19.07,Default,,0000,0000,0000,,Cơ thể cô ấy bị quá nhiệt, giờ đang phải đi thay một vỏ bọc mới rồi.
Dialogue: 0,0:05:19.07,0:05:20.23,Default,,0000,0000,0000,,Cô ấy không sao chứ?
Dialogue: 0,0:05:20.47,0:05:21.87,Default,,0000,0000,0000,,À thì, không sao, nhưng mà...
Dialogue: 0,0:05:22.94,0:05:27.57,Default,,0000,0000,0000,,Những gì cậu nói quả không sai. Mắt của tôi cũng vừa bị hack rồi.
Dialogue: 0,0:05:29.91,0:05:32.34,Default,,0000,0000,0000,,Tôi lượn đây. Hàng tá việc đang chờ giải quyết.
Dialogue: 0,0:05:32.65,0:05:34.34,Default,,0000,0000,0000,,Tạm thời tôi để cái này lại cho cậu giữ.
Dialogue: 0,0:05:40.02,0:05:41.02,Default,,0000,0000,0000,,Cái này là...
Dialogue: 0,0:05:41.02,0:05:42.78,Default,,0000,0000,0000,,Khoan đã, ý anh là bị Gã Mặt Cười hack sao?
Dialogue: 0,0:05:54.80,0:05:57.46,Default,,0000,0000,0000,,Tôi thuộc Ban An ninh Công cộng số 9. Lúc nãy tôi có gọi điện tới.
Dialogue: 0,0:05:58.20,0:06:01.47,Default,,0000,0000,0000,,Vào phòng thì mở mồm chào một tiếng chứ! Cậu làm người ta đau tim đấy.
Dialogue: 0,0:06:02.27,0:06:06.64,Default,,0000,0000,0000,,Tôi cần danh sách hồ sơ thành viên của Đội Bài trừ Ma túy, kèm theo ảnh nhận diện.
Dialogue: 0,0:06:07.38,0:06:10.04,Default,,0000,0000,0000,,Về cơ bản, Cục Ma túy là một cơ quan không có gương mặt cố định.
Dialogue: 0,0:06:10.48,0:06:13.01,Default,,0000,0000,0000,,Kẻ lang thang, nhạc công đường phố, thành viên băng đảng...
Dialogue: 0,0:06:13.62,0:06:17.06,Default,,0000,0000,0000,,Nên chẳng ai dám chắc khuôn mặt hiện tại của chúng có giống với ảnh lưu trong này hay không đâu.
Dialogue: 0,0:06:19.16,0:06:21.13,Default,,0000,0000,0000,,Ngồi làm việc bàn giấy kể cũng nhàn nhã gớm nhỉ...
Dialogue: 0,0:06:41.11,0:06:44.08,Default,,0000,0000,0000,,Ông là Trưởng ban Aramaki của Ban An ninh Công cộng số 9 phải không?
Dialogue: 0,0:06:44.28,0:06:46.59,Default,,0000,0000,0000,,Thất lễ rồi, tôi là phóng viên của tờ Thể thao Kyoto.
Dialogue: 0,0:06:46.59,0:06:47.75,Default,,0000,0000,0000,,Làm sao anh\Nvào được đây?
Dialogue: 0,0:06:48.52,0:06:49.78,Default,,0000,0000,0000,,À thì, dẫu sao...
Dialogue: 0,0:06:50.62,0:06:52.99,Default,,0000,0000,0000,,Tôi tự hỏi liệu có thể phỏng vấn ông vài câu được không.
Dialogue: 0,0:06:53.96,0:06:56.69,Default,,0000,0000,0000,,Người đàn ông này là anh trai ruột của ông, đúng chứ?
Dialogue: 0,0:06:57.03,0:07:01.73,Default,,0000,0000,0000,,Người có tên "Yosuke" này vừa bị bắt giam vài ngày trước vì tội buôn bán chất ma túy,
Dialogue: 0,0:07:02.00,0:07:07.67,Default,,0000,0000,0000,,và hiện đang bị quản thúc tại bệnh viện cảnh sát để điều trị chứng nghiện ngập nghiêm trọng.
Dialogue: 0,0:07:08.14,0:07:09.77,Default,,0000,0000,0000,,Ông đã nghe tin gì\Nvề chuyện này chưa?
Dialogue: 0,0:07:12.81,0:07:14.28,Default,,0000,0000,0000,,Trông ông ấy quả thực\Nrất giống anh trai tôi,
Dialogue: 0,0:07:14.28,0:07:18.15,Default,,0000,0000,0000,,nhưng từ khi anh ấy mất tích trong thời kỳ chiến tranh, tôi chưa từng gặp lại dù chỉ một lần.
Dialogue: 0,0:07:18.98,0:07:21.45,Default,,0000,0000,0000,,Ông có phiền lòng chia sẻ đôi chút về điều đó không?
Dialogue: 0,0:07:24.02,0:07:25.46,Default,,0000,0000,0000,,Này, chờ một chút đã! Tấm ảnh của tôi!
Dialogue: 0,0:07:55.09,0:07:57.28,Default,,0000,0000,0000,,{\i1}Đây{\i0} là vỏ bọc giả mới của cậu đấy à, Motoko?
Dialogue: 0,0:07:57.99,0:08:01.45,Default,,0000,0000,0000,,Trông chẳng khác gì cơ thể hiện tại cả! Lẽ ra cậu nên đặt làm riêng một mẫu độc lạ chứ.
Dialogue: 0,0:08:01.83,0:08:03.56,Default,,0000,0000,0000,,Ngoại hình thế nào\Ntôi không quan tâm.
Dialogue: 0,0:08:04.30,0:08:07.27,Default,,0000,0000,0000,,Mấy thứ này là gì đây? Toàn là trang bị phụ trợ vi phạm quy chuẩn thôi!
Dialogue: 0,0:08:07.53,0:08:10.87,Default,,0000,0000,0000,,Oa, mới tưởng tượng cậu sẽ làm được những gì với đống này thôi mà người tớ đã rạo rực hết cả lên rồi!
Dialogue: 0,0:08:12.40,0:08:15.40,Default,,0000,0000,0000,,Cơ mà... Cậu có chắc là muốn tớ đứng đây làm người giám sát chính thức không?
Dialogue: 0,0:08:15.98,0:08:19.97,Default,,0000,0000,0000,,Đâu có vấn đề gì, đúng chứ? Dù sao cậu cũng có chứng chỉ hành nghề hợp lệ mà.
Dialogue: 0,0:08:20.61,0:08:22.24,Default,,0000,0000,0000,,Kéo khóa lưng hộ tôi với?
Dialogue: 0,0:08:22.78,0:08:25.34,Default,,0000,0000,0000,,Bác sĩ phẫu thuật\Nđến muộn thật đấy nhỉ?
Dialogue: 0,0:08:26.55,0:08:27.52,Default,,0000,0000,0000,,Cảm ơn nhé.
Dialogue: 0,0:08:28.05,0:08:29.68,Default,,0000,0000,0000,,Để tớ ra xem\Ncó chuyện gì mà lâu thế.
Dialogue: 0,0:08:29.79,0:08:31.19,Default,,0000,0000,0000,,Tuyệt, cảm ơn cậu.
Dialogue: 0,0:08:37.83,0:08:39.56,Default,,0000,0000,0000,,Aramaki, Ban An ninh\NCông cộng số 9.
Dialogue: 0,0:08:41.37,0:08:42.83,Default,,0000,0000,0000,,Tôi muốn vào gặp anh trai tôi.
Dialogue: 0,0:08:44.60,0:08:49.01,Default,,0000,0000,0000,,Thành thật xin lỗi ngài, nhưng chỉ thị từ cấp trên quy định tuyệt đối không cho phép ngài gặp mặt...
Dialogue: 0,0:08:49.01,0:08:51.31,Default,,0000,0000,0000,,...bởi vì ngài là người trong gia đình.
Dialogue: 0,0:08:52.44,0:08:55.28,Default,,0000,0000,0000,,Cho tôi ba phút thôi. Tôi chỉ muốn xác nhận xem đó có đúng là ông ấy hay không.
Dialogue: 0,0:08:55.71,0:08:57.98,Default,,0000,0000,0000,,Thành thật xin lỗi ngài, nhưng quy định đã đề ra như vậy rồi...
Dialogue: 0,0:08:58.65,0:08:59.91,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:09:02.99,0:09:07.45,Default,,0000,0000,0000,,Tình trạng của anh trai tôi... Yosuke Aramaki hiện ra sao rồi?
Dialogue: 0,0:09:08.39,0:09:10.79,Default,,0000,0000,0000,,Về việc đó tôi cũng không được phép trả lời, thưa ngài...
Dialogue: 0,0:09:12.26,0:09:13.66,Default,,0000,0000,0000,,Tôi hiểu.
Dialogue: 0,0:09:28.01,0:09:30.15,Default,,0000,0000,0000,,Vô cùng xin lỗi vì đã để quý cô phải chờ đợi lâu.
Dialogue: 0,0:09:30.15,0:09:33.02,Default,,0000,0000,0000,,Tôi tên là Sano. Tôi sẽ là người phụ trách ca phẫu thuật này.
Dialogue: 0,0:09:35.15,0:09:39.96,Default,,0000,0000,0000,,Nào nào, đây đâu phải lần đầu tiên của cô. Đừng lo lắng, tôi hứa sẽ không làm đau cô đâu.
Dialogue: 0,0:09:43.83,0:09:45.76,Default,,0000,0000,0000,,Được rồi, chúng ta hãy bắt đầu quá trình kiểm tra ngay lập tức.
Dialogue: 0,0:09:46.27,0:09:49.33,Default,,0000,0000,0000,,Với tư cách người giám sát, tôi xin mời cô đợi ở ngoài phòng.
Dialogue: 0,0:09:53.37,0:09:55.67,Default,,0000,0000,0000,,Thì ra đây là cơ thể mới của cô sao?
Dialogue: 0,0:09:56.64,0:10:00.84,Default,,0000,0000,0000,,Trong quá trình chuyển giao, tôi sẽ ngắt toàn bộ chức năng kết nối mạng của cô.
Dialogue: 0,0:10:01.91,0:10:05.25,Default,,0000,0000,0000,,Căn phòng này sẽ hoàn toàn bị cô lập khỏi mọi tín hiệu điện tử...
Dialogue: 0,0:10:05.25,0:10:07.34,Default,,0000,0000,0000,,...cho tới khi quá trình hoán đổi vỏ bọc giả của cô hoàn tất.
Dialogue: 0,0:10:07.79,0:10:09.42,Default,,0000,0000,0000,,Tôi có được sự cho phép của cô chứ?
Dialogue: 0,0:10:09.42,0:10:11.75,Default,,0000,0000,0000,,Mau tiến hành cho xong đi được không? Tôi đang vội.
Dialogue: 0,0:10:13.53,0:10:15.08,Default,,0000,0000,0000,,Chà chà, chúng ta nóng vội quá nhỉ?
Dialogue: 0,0:10:19.16,0:10:23.12,Default,,0000,0000,0000,,Được rồi, giờ tôi sẽ bắt đầu mở nắp kiểm tra bên trong.
Dialogue: 0,0:10:25.47,0:10:28.00,Default,,0000,0000,0000,,Cô sở hữu một thân thể tuyệt mỹ đấy...
Dialogue: 0,0:10:33.41,0:10:35.24,Default,,0000,0000,0000,,Sếp già có vẻ đến muộn quá nhỉ?
Dialogue: 0,0:10:35.55,0:10:39.21,Default,,0000,0000,0000,,Bị Gã Mặt Cười hack mắt xong khiến cậu biến thành kẻ hay lo bò trắng răng từ bao giờ thế?
Dialogue: 0,0:10:40.52,0:10:43.61,Default,,0000,0000,0000,,Tôi phải nhận thông tin tình báo từ sếp già ở đây.
Dialogue: 0,0:10:46.19,0:10:47.95,Default,,0000,0000,0000,,Có lẽ tôi nên thử lần theo dấu vết của ông ấy xem sao.
Dialogue: 0,0:10:55.70,0:10:57.97,Default,,0000,0000,0000,,Ủa? Ông ấy vừa về rồi lại rời đi ngay lập tức.
Dialogue: 0,0:10:59.10,0:11:01.87,Default,,0000,0000,0000,,Sếp vừa chạy xác minh danh tính của một tay phóng viên từ hầm gửi xe.
Dialogue: 0,0:11:02.21,0:11:03.44,Default,,0000,0000,0000,,Một tay săn tin sao?
Dialogue: 0,0:11:03.44,0:11:07.50,Default,,0000,0000,0000,,Lạ thật đấy. Trưởng ban đang bật chế độ ngắt kết nối tự kỷ.
Dialogue: 0,0:11:08.08,0:11:09.27,Default,,0000,0000,0000,,Định vị GPS của ông ấy báo thế nào?
Dialogue: 0,0:11:09.82,0:11:11.78,Default,,0000,0000,0000,,Xe của sếp đang ở Khu lưu trú Tị nạn.
Dialogue: 0,0:11:11.98,0:11:14.45,Default,,0000,0000,0000,,Nhật ký hành trình ghi nhận ông ấy đỗ xe ở đó ba phút trước.
Dialogue: 0,0:11:15.12,0:11:16.68,Default,,0000,0000,0000,,Ở một nơi nguy hiểm như vậy sao?
Dialogue: 0,0:11:17.02,0:11:18.89,Default,,0000,0000,0000,,Rốt cuộc ông ấy đang nghĩ cái quái gì thế không biết?
Dialogue: 0,0:11:19.32,0:11:20.79,Default,,0000,0000,0000,,Tôi sẽ tới đó xem sao.
Dialogue: 0,0:11:45.85,0:11:47.22,Default,,0000,0000,0000,,Yosuke!
Dialogue: 0,0:11:47.65,0:11:49.25,Default,,0000,0000,0000,,Yosuke đó phải không?
Dialogue: 0,0:11:51.52,0:11:53.62,Default,,0000,0000,0000,,Anh về rồi đấy à?
Dialogue: 0,0:11:54.23,0:11:57.16,Default,,0000,0000,0000,,Đồ diện bảnh bao gớm nhỉ... Kiếm được em nào rồi à?
Dialogue: 0,0:11:59.06,0:12:01.16,Default,,0000,0000,0000,,Cậu có quen biết Yosuke sao?
Dialogue: 0,0:12:02.84,0:12:05.13,Default,,0000,0000,0000,,Ông là em trai của Yosuke, đúng không?
Dialogue: 0,0:12:05.70,0:12:07.70,Default,,0000,0000,0000,,Trông ông giống hệt anh ấy. Nhìn một cái là tôi nhận ra ngay.
Dialogue: 0,0:12:08.04,0:12:10.08,Default,,0000,0000,0000,,Yosuke từng ở đây sao?
Dialogue: 0,0:12:10.08,0:12:13.81,Default,,0000,0000,0000,,Phải. Nhưng hôm qua anh ấy vừa bị cảnh sát còng tay giải đi rồi.
Dialogue: 0,0:12:15.78,0:12:18.25,Default,,0000,0000,0000,,Cậu có thể kể cho tôi nghe chuyện gì đã xảy ra không?
Dialogue: 0,0:12:26.73,0:12:29.63,Default,,0000,0000,0000,,Tất cả mọi người quanh đây đều kính trọng Yosuke.
Dialogue: 0,0:12:30.16,0:12:33.29,Default,,0000,0000,0000,,Chính Yosuke là người đã mang lại trật tự cho cái nơi này.
Dialogue: 0,0:12:33.97,0:12:37.47,Default,,0000,0000,0000,,Trước đó, nơi đây chỉ là một khu vực hoàn toàn vô pháp vô thiên.
Dialogue: 0,0:12:37.47,0:12:42.00,Default,,0000,0000,0000,,Thế nhưng đùng một cái, cảnh sát bất ngờ ập tới và bắt giữ Yosuke đi.
Dialogue: 0,0:12:42.47,0:12:45.14,Default,,0000,0000,0000,,Vậy ra chuyện đó hoàn toàn không liên quan gì đến buôn bán ma túy sao?
Dialogue: 0,0:12:45.14,0:12:46.37,Default,,0000,0000,0000,,Tất nhiên là không rồi!
Dialogue: 0,0:12:51.28,0:12:54.51,Default,,0000,0000,0000,,Tôi đã quay lại toàn bộ hành vi của bọn cảnh sát vào đây.
Dialogue: 0,0:12:54.82,0:12:58.45,Default,,0000,0000,0000,,Thứ này chắc chắn sẽ chứng minh sự trong sạch của Yosuke. Chúng ta phải cứu anh ấy!
Dialogue: 0,0:13:09.97,0:13:14.13,Default,,0000,0000,0000,,Không có dấu hiệu giằng co... Ra là sếp tự nguyện rời đi sao?
Dialogue: 0,0:13:17.51,0:13:19.07,Default,,0000,0000,0000,,{\i1}Cậu có thể trích xuất video bên trong đó không?{\i0}
Dialogue: 0,0:13:19.68,0:13:22.51,Default,,0000,0000,0000,,Tôi tìm thấy nhật ký camera của khu dân cư rồi.
Dialogue: 0,0:13:22.78,0:13:24.87,Default,,0000,0000,0000,,Trưởng ban đang gặp gỡ ai đó...
Dialogue: 0,0:13:25.75,0:13:27.98,Default,,0000,0000,0000,,{\i1}Hình ảnh nhiễu hạt quá... Cậu lọc sạch tín hiệu được không?{\i0}
Dialogue: 0,0:13:28.99,0:13:30.59,Default,,0000,0000,0000,,Có lẽ sẽ mất một lúc đấy.
Dialogue: 0,0:13:30.59,0:13:31.45,Default,,0000,0000,0000,,{\i1}Làm ngay đi!{\i0}
Dialogue: 0,0:13:31.99,0:13:36.45,Default,,0000,0000,0000,,{\i1}Ishikawa, tôi đã tìm ra diện mạo hiện tại của ba tên còn lại trong đội bài trừ ma túy rồi.{\i0}
Dialogue: 0,0:13:37.13,0:13:38.93,Default,,0000,0000,0000,,{\i1}Tôi đang gửi toàn bộ tập dữ liệu cho anh đây.{\i0}
Dialogue: 0,0:13:38.93,0:13:40.90,Default,,0000,0000,0000,,{\i1}Rõ rồi. Bắn qua đây đi.{\i0}
Dialogue: 0,0:13:42.37,0:13:43.89,Default,,0000,0000,0000,,Chính là chúng nó rồi, nhỉ?
Dialogue: 0,0:13:44.37,0:13:47.30,Default,,0000,0000,0000,,Xếp hàng lấy số đi mấy nhóc. Anh sẽ chăm sóc từng đứa một sau.
Dialogue: 0,0:13:48.57,0:13:50.04,Default,,0000,0000,0000,,Các người làm cái trò gì thế? Buông tôi ra!
Dialogue: 0,0:13:51.01,0:13:52.61,Default,,0000,0000,0000,,Chúng tao nhận được tin báo về mày! Ngồi im đấy!
Dialogue: 0,0:13:52.61,0:13:53.78,Default,,0000,0000,0000,,Thế này là có ý gì hả?!
Dialogue: 0,0:13:53.78,0:13:56.15,Default,,0000,0000,0000,,Các người lục soát cái gì? Sẽ chẳng tìm thấy thứ gì đâu!
Dialogue: 0,0:13:56.78,0:13:57.75,Default,,0000,0000,0000,,Tìm thấy rồi nhé.
Dialogue: 0,0:13:57.85,0:13:58.58,Default,,0000,0000,0000,,Cái... gì...?
Dialogue: 0,0:13:58.58,0:14:00.78,Default,,0000,0000,0000,,Mày gài bẫy tao, đồ khốn nạn!
Dialogue: 0,0:14:01.12,0:14:02.05,Default,,0000,0000,0000,,Các người đang làm cái gì thế hả?!
Dialogue: 0,0:14:02.05,0:14:03.11,Default,,0000,0000,0000,,Khôn hồn thì ngoan ngoãn đi theo chúng tao!
Dialogue: 0,0:14:06.33,0:14:08.82,Default,,0000,0000,0000,,Ra đúng là một vụ vu khống gài bẫy, hệt như mình dự đoán...
Dialogue: 0,0:14:09.46,0:14:12.29,Default,,0000,0000,0000,,Phải, lũ đó là một đám bẩn thỉu đê tiện cùng cực.
Dialogue: 0,0:14:12.53,0:14:16.26,Default,,0000,0000,0000,,Tôi cá là bọn chúng muốn lập công tích điểm nên mới đổ tội lên đầu Yosuke.
Dialogue: 0,0:14:16.74,0:14:23.47,Default,,0000,0000,0000,,Suốt quãng thời gian tôi quen biết anh ấy, chưa từng thấy Yosuke đụng vào ma túy dù chỉ một lần.
Dialogue: 0,0:14:26.01,0:14:30.61,Default,,0000,0000,0000,,Với bằng chứng thép vững như bàn thạch thế này, tôi sẽ có thể chứng minh anh trai mình vô tội.
Dialogue: 0,0:14:33.62,0:14:36.35,Default,,0000,0000,0000,,Cảm ơn cậu. Tôi hứa nhất định sẽ báo đáp ân tình này.
Dialogue: 0,0:14:36.66,0:14:37.62,Default,,0000,0000,0000,,Không cần đâu...
Dialogue: 0,0:14:38.12,0:14:42.79,Default,,0000,0000,0000,,Bởi vì đằng nào thì, ông cũng chẳng còn mạng lành lặn để mà quay về đâu!
Dialogue: 0,0:14:54.11,0:14:55.13,Default,,0000,0000,0000,,Thiếu tá...
Dialogue: 0,0:14:57.41,0:14:58.67,Default,,0000,0000,0000,,Tôi đã khử nhiễu xong rồi!
Dialogue: 0,0:15:01.25,0:15:02.28,Default,,0000,0000,0000,,Này, hai kẻ đó là...
Dialogue: 0,0:15:02.28,0:15:03.30,Default,,0000,0000,0000,,{\i1}Có chuyện gì thế?{\i0}
Dialogue: 0,0:15:03.38,0:15:04.37,Default,,0000,0000,0000,,Tôi đang truyền tín hiệu qua cho anh đây!
Dialogue: 0,0:15:07.39,0:15:08.69,Default,,0000,0000,0000,,Này, hai tên đó chính là...
Dialogue: 0,0:15:08.69,0:15:11.18,Default,,0000,0000,0000,,{\i1}Chết tiệt, bọn chúng hoàn toàn gài bẫy sếp già rồi!{\i0}
Dialogue: 0,0:15:12.89,0:15:14.55,Default,,0000,0000,0000,,{\i1}Chế độ tự kỷ của ông ấy vừa bị giải trừ.{\i0}
Dialogue: 0,0:15:18.90,0:15:22.36,Default,,0000,0000,0000,,Cảnh sát sắp ập tới đây rồi. Ông tiêu đời rồi nhé.
Dialogue: 0,0:15:22.73,0:15:25.10,Default,,0000,0000,0000,,Trời đất, cái thứ quái quỷ gì thế này? Một loại ma túy nào đó sao?
Dialogue: 0,0:15:26.24,0:15:27.51,Default,,0000,0000,0000,,{\i1}Nguy to rồi.{\i0}
Dialogue: 0,0:15:27.51,0:15:30.18,Default,,0000,0000,0000,,Lực lượng chức năng đang trên đường ập vào khu dân cư tị nạn...
Dialogue: 0,0:15:30.18,0:15:32.14,Default,,0000,0000,0000,,...để bắt quả tang một vụ giao dịch ma túy và tiến hành đột kích!
Dialogue: 0,0:15:32.71,0:15:33.70,Default,,0000,0000,0000,,Lũ chó chết khốn nạn!
Dialogue: 0,0:15:58.70,0:16:01.07,Default,,0000,0000,0000,,Não của cô không bị đau đớn chứ?
Dialogue: 0,0:16:01.61,0:16:05.54,Default,,0000,0000,0000,,Trò đùa nhảm nhí. Ông thừa biết não bộ làm gì có thụ thể cảm nhận cơn đau.
Dialogue: 0,0:16:05.84,0:16:08.94,Default,,0000,0000,0000,,Ôi dào, đừng lạnh lùng thế chứ. Chúng ta hãy cứ từ từ tận hưởng từng chút một, được không?
Dialogue: 0,0:16:09.58,0:16:11.52,Default,,0000,0000,0000,,Hay là vì... cô không thích tôi sao?
Dialogue: 0,0:16:11.88,0:16:13.65,Default,,0000,0000,0000,,Không có ý xúc phạm đâu, nhưng chính xác là như vậy đấy.
Dialogue: 0,0:16:13.99,0:16:15.98,Default,,0000,0000,0000,,Giờ thì chúng ta đã thẳng thắn với nhau rồi, giải quyết cho xong luôn được chưa?
Dialogue: 0,0:16:16.42,0:16:17.95,Default,,0000,0000,0000,,Tôi không có nhiều thời gian rảnh rỗi để lãng phí đâu.
Dialogue: 0,0:16:19.06,0:16:21.22,Default,,0000,0000,0000,,Chà chà, cô gái nhỏ này xấc xược thật đấy...
Dialogue: 0,0:16:23.96,0:16:26.16,Default,,0000,0000,0000,,Tôi vừa khóa chặt trung khu ngôn ngữ của cô rồi.
Dialogue: 0,0:16:26.70,0:16:32.14,Default,,0000,0000,0000,,Tất nhiên là dù cô có gào thét to đến mức nào thì cũng chẳng có ai tới cứu cô đâu.
Dialogue: 0,0:16:41.18,0:16:44.71,Default,,0000,0000,0000,,Cô Kusanagi? Cảm giác của cô lúc này thế nào rồi?
Dialogue: 0,0:16:45.05,0:16:47.49,Default,,0000,0000,0000,,Ái chà! Ánh mắt phản kháng dữ dội gớm nhỉ!
Dialogue: 0,0:16:47.49,0:16:48.68,Default,,0000,0000,0000,,Thế là không ngoan chút nào đâu nhé.
Dialogue: 0,0:16:50.39,0:16:54.05,Default,,0000,0000,0000,,Cô nghĩ sao về một thế giới không còn sắc đỏ? Trông có đẹp đẽ không?
Dialogue: 0,0:16:57.00,0:17:00.45,Default,,0000,0000,0000,,Tôi thực sự chẳng hề muốn làm những chuyện dã man này chút nào đâu...
Dialogue: 0,0:17:01.53,0:17:05.99,Default,,0000,0000,0000,,Nhưng cô và bạn bè của cô đã đi quá giới hạn rồi.
Dialogue: 0,0:17:08.07,0:17:09.54,Default,,0000,0000,0000,,{\i1}Cảnh sát đã tới nơi rồi!{\i0}
Dialogue: 0,0:17:09.54,0:17:10.47,Default,,0000,0000,0000,,{\i1}Tôi thấy bọn chúng rồi!{\i0}
Dialogue: 0,0:17:31.36,0:17:32.26,Default,,0000,0000,0000,,Cảnh sát đây!
Dialogue: 0,0:17:33.40,0:17:34.09,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:17:36.47,0:17:37.83,Default,,0000,0000,0000,,Này, hắn có thực sự là...
Dialogue: 0,0:17:40.21,0:17:42.14,Default,,0000,0000,0000,,Cái quái gì thế này? Chết tiệt...
Dialogue: 0,0:17:45.94,0:17:46.91,Default,,0000,0000,0000,,Khốn kiếp...
Dialogue: 0,0:17:47.45,0:17:49.28,Default,,0000,0000,0000,,Cố giữ vững nhé, sếp già!
Dialogue: 0,0:17:52.78,0:17:56.35,Default,,0000,0000,0000,,{\i1}Cái gì thế này? Đây là một trò đùa nhằm vào tôi đấy à?{\i0}
Dialogue: 0,0:17:56.76,0:17:58.78,Default,,0000,0000,0000,,Cô đang phát ra những làn sóng não đầy khó chịu đấy.
Dialogue: 0,0:17:59.22,0:18:01.32,Default,,0000,0000,0000,,Tạm thời hãy mượn đôi mắt của tôi đi.
Dialogue: 0,0:18:06.33,0:18:08.63,Default,,0000,0000,0000,,Cậu là Gã Mặt Cười, đúng chứ?
Dialogue: 0,0:18:08.97,0:18:11.80,Default,,0000,0000,0000,,Thực ra đây là lần thứ ba chúng ta gặp nhau rồi đấy. Cô có biết không?
Dialogue: 0,0:18:12.57,0:18:15.67,Default,,0000,0000,0000,,Dù rằng tôi không phải là kẻ đầu tiên khởi xướng gọi tôi bằng cái tên đó...
Dialogue: 0,0:18:16.84,0:18:20.40,Default,,0000,0000,0000,,Cậu to gan thật đấy khi dám mò vào tận một nơi như thế này.
Dialogue: 0,0:18:20.71,0:18:21.97,Default,,0000,0000,0000,,Cậu đến đây làm gì?
Dialogue: 0,0:18:22.55,0:18:24.28,Default,,0000,0000,0000,,Để nhờ cô giúp tôi một tay.
Dialogue: 0,0:18:24.62,0:18:26.95,Default,,0000,0000,0000,,Chẳng phải cậu đang nói ngược ngạo sao?
Dialogue: 0,0:18:27.75,0:18:28.82,Default,,0000,0000,0000,,Cũng đúng thật.
Dialogue: 0,0:18:28.82,0:18:33.45,Default,,0000,0000,0000,,Nhưng lưng tôi đã bị dồn vào chân tường rồi, và đây là phương án duy nhất tôi có thể nghĩ ra.
Dialogue: 0,0:18:34.23,0:18:39.32,Default,,0000,0000,0000,,Tôi tự nhủ nếu lão Thượng đế khốn kiếp chưa bỏ rơi tôi, thì cô nhất định sẽ ra tay tương trợ.
Dialogue: 0,0:18:39.76,0:18:44.72,Default,,0000,0000,0000,,Nói chuyện ích kỷ thật đấy... Giọng điệu của cậu vừa lễ độ lại vừa báng bổ.
Dialogue: 0,0:18:45.14,0:18:47.50,Default,,0000,0000,0000,,Đây là lần duy nhất mà tôi tuyệt đối không được phép thất bại, bằng bất cứ giá nào.
Dialogue: 0,0:18:48.01,0:18:51.77,Default,,0000,0000,0000,,Nếu tôi không hành động, mọi kẻ giả mạo đê tiện trên cõi đời này sẽ được hợp thức hóa.
Dialogue: 0,0:18:52.38,0:18:55.81,Default,,0000,0000,0000,,Nghe như thể cậu đang một mình gánh vác mọi vấn nạn của cả thế giới vậy.
Dialogue: 0,0:18:56.45,0:19:00.32,Default,,0000,0000,0000,,Vậy thì người hùng của cõi mạng muốn tôi phải làm gì cho cậu đây?
Dialogue: 0,0:19:01.69,0:19:05.78,Default,,0000,0000,0000,,Tôi sẽ kể cho cô nghe toàn bộ câu chuyện chân tướng đằng sau vụ án Gã Mặt Cười.
Dialogue: 0,0:19:06.09,0:19:11.26,Default,,0000,0000,0000,,Và sau đó, tôi muốn cô hãy lùi lại và đừng can thiệp trong lúc tôi đối mặt với thử thách cuối cùng.
Dialogue: 0,0:19:11.80,0:19:15.23,Default,,0000,0000,0000,,Nếu chẳng may tôi thất bại và phải bỏ mạng,
Dialogue: 0,0:19:15.70,0:19:18.90,Default,,0000,0000,0000,,tôi muốn cô và những người của cô hãy đưa toàn bộ vụ bê bối này ra ánh sáng.
Dialogue: 0,0:19:19.24,0:19:20.30,Default,,0000,0000,0000,,Thật không thể tin nổi...
Dialogue: 0,0:19:20.94,0:19:26.61,Default,,0000,0000,0000,,"Dấu hiệu của kẻ chưa trưởng thành là muốn chết một cách cao cả vì lý tưởng,"
Dialogue: 0,0:19:27.18,0:19:33.31,Default,,0000,0000,0000,,"còn dấu hiệu của người đã trưởng thành là muốn sống một cách khiêm nhường vì lý tưởng đó."
Dialogue: 0,0:19:33.75,0:19:37.35,Default,,0000,0000,0000,,Đó là câu nói của nhà phân tâm học Wilhelm Stekel.
Dialogue: 0,0:19:38.09,0:19:40.56,Default,,0000,0000,0000,,Đúng như cảm giác của tôi ngay từ lần đầu tiên biết về cậu.
Dialogue: 0,0:19:40.56,0:19:43.76,Default,,0000,0000,0000,,Cậu chính là kiểu người mà tôi không ưa chút nào, đồ nhóc ra vẻ thông thái.
Dialogue: 0,0:19:44.40,0:19:46.49,Default,,0000,0000,0000,,Nhưng chẳng phải chính cô cũng thuộc vế đầu tiên đó hay sao?
Dialogue: 0,0:19:46.83,0:19:49.63,Default,,0000,0000,0000,,Tất cả những gì cô cần làm chỉ là cất lời nhờ vả, và tôi sẽ giúp ngay.
Dialogue: 0,0:19:50.30,0:19:51.90,Default,,0000,0000,0000,,Hẳn là thói ghét bỏ chính đồng loại của mình rồi.
Dialogue: 0,0:19:51.90,0:19:54.67,Default,,0000,0000,0000,,Được rồi, được rồi. Cô có thể vui lòng làm gì đó giúp tôi được không?
Dialogue: 0,0:19:55.01,0:19:57.10,Default,,0000,0000,0000,,Tôi không dám chắc liệu mình có giữ được lời hứa hay không đâu nhé.
Dialogue: 0,0:19:57.38,0:19:59.67,Default,,0000,0000,0000,,Tôi biết thừa cô mà, cô chắc chắn sẽ làm được.
Dialogue: 0,0:20:08.92,0:20:10.58,Default,,0000,0000,0000,,Tôi sẽ để lại ký ức của mình cho cô rồi rời đi.
Dialogue: 0,0:20:11.22,0:20:12.62,Default,,0000,0000,0000,,Trông cậy cả vào cô đấy.
Dialogue: 0,0:20:25.04,0:20:26.40,Default,,0000,0000,0000,,Tôi để cô lại tự xử lý nhé.
Dialogue: 0,0:20:35.71,0:20:36.82,Default,,0000,0000,0000,,Nào, vậy thì...
Dialogue: 0,0:20:36.82,0:20:39.84,Default,,0000,0000,0000,,Tôi sẽ thấy nhớ cô lắm đấy, nhưng giờ tôi sẽ để cô ra đi một cách thanh thản.
Dialogue: 0,0:20:41.55,0:20:42.58,Default,,0000,0000,0000,,Mấy cây kim!
Dialogue: 0,0:21:00.47,0:21:01.61,Default,,0000,0000,0000,,Chuyện gì đang xảy ra thế này?
Dialogue: 0,0:21:01.61,0:21:03.11,Default,,0000,0000,0000,,Đừng lo, chẳng có gì đâu.
Dialogue: 0,0:21:03.11,0:21:04.01,Default,,0000,0000,0000,,{\i1}Thiếu tá.{\i0}
Dialogue: 0,0:21:04.34,0:21:05.24,Default,,0000,0000,0000,,{\i1}Có chuyện gì thế?{\i0}
Dialogue: 0,0:21:05.88,0:21:07.31,Default,,0000,0000,0000,,{\i1}Bọn chúng đã nhắm vào sếp già rồi.{\i0}
Dialogue: 0,0:21:16.82,0:21:19.76,Default,,0000,0000,0000,,Cục trưởng Niimi, đã đến giờ thẩm vấn rồi.
Dialogue: 0,0:21:21.09,0:21:22.56,Default,,0000,0000,0000,,Ông Niimi?
Dialogue: 0,0:21:24.60,0:21:25.53,Default,,0000,0000,0000,,Cục trưởng?!
Dialogue: 0,0:21:26.23,0:21:29.00,Default,,0000,0000,0000,,Thân thể cơ khí mới của cô hoạt động thế nào rồi?
Dialogue: 0,0:21:31.77,0:21:33.20,Default,,0000,0000,0000,,Ổn thỏa cả, như sếp thấy đấy.
Dialogue: 0,0:21:33.87,0:21:35.81,Default,,0000,0000,0000,,Trông sếp còn phong độ hơn tôi tưởng tượng nhiều đấy, Trưởng ban.
Dialogue: 0,0:21:36.14,0:21:37.21,Default,,0000,0000,0000,,Tôi cũng nghĩ vậy...
Dialogue: 0,0:21:37.21,0:21:39.21,Default,,0000,0000,0000,,Tôi rất tiếc vì vừa tỉnh dậy đã phải báo tin này cho sếp,
Dialogue: 0,0:21:39.21,0:21:42.01,Default,,0000,0000,0000,,nhưng tôi có một tin tốt và một tin xấu.
Dialogue: 0,0:21:43.95,0:21:45.81,Default,,0000,0000,0000,,Bắt đầu bằng tin xấu trước đi.
Dialogue: 0,0:21:46.28,0:21:49.28,Default,,0000,0000,0000,,Cục trưởng Niimi vừa cố tự sát bằng cách phá hủy não điện tử.
Dialogue: 0,0:21:51.42,0:21:54.26,Default,,0000,0000,0000,,Một phần trung khu ngôn ngữ và trí nhớ của ông ta đã bị xóa sạch.
Dialogue: 0,0:21:54.83,0:21:59.02,Default,,0000,0000,0000,,Điều này khiến lời khai của ông ta không còn giá trị pháp lý làm bằng chứng trước tòa nữa.
Dialogue: 0,0:22:00.03,0:22:04.90,Default,,0000,0000,0000,,Và giờ là tin tốt... Liên quan đến anh trai của sếp.
Dialogue: 0,0:22:05.57,0:22:07.47,Default,,0000,0000,0000,,Toàn bộ vụ việc chỉ là một màn kịch được ngụy tạo...
Dialogue: 0,0:22:07.47,0:22:09.53,Default,,0000,0000,0000,,...do tàn dư của đội bài trừ ma túy dàn dựng nên.
Dialogue: 0,0:22:11.04,0:22:13.91,Default,,0000,0000,0000,,Tôi không dám chắc đó có hoàn toàn là một tin tốt lành hay không...
Dialogue: 0,0:22:14.01,0:22:18.71,Default,,0000,0000,0000,,Rất có thể anh trai sếp thực sự {\i1}đã từng{\i0} ở đó.
Dialogue: 0,0:22:19.95,0:22:23.39,Default,,0000,0000,0000,,Sự thật là trong khi tôi ngày đêm mải miết phơi bày chân tướng đằng sau tội ác bên ngoài xã hội,
Dialogue: 0,0:22:23.92,0:22:30.26,Default,,0000,0000,0000,,tôi lại chưa từng hay biết anh trai mình vẫn đang sống ở một nơi nào đó dưới bầu trời giá lạnh kia.
Dialogue: 0,0:22:31.43,0:22:35.03,Default,,0000,0000,0000,,Tôi đã luôn tâm niệm rằng công lý nghĩa là phải tận tụy hoàn thành chức trách của mình...
Dialogue: 0,0:22:35.03,0:22:38.99,Default,,0000,0000,0000,,...trong khi phải nhắm mắt làm ngơ trước nỗi thống khổ của những người thân yêu,
Dialogue: 0,0:22:39.90,0:22:44.27,Default,,0000,0000,0000,,nhưng thành thật mà nói, giờ đây tôi không còn dám chắc về điều đó nữa.
Dialogue: 0,0:22:45.58,0:22:48.74,Default,,0000,0000,0000,,Nhưng sếp vẫn sẽ tiếp tục kiên cường chiến đấu vì lẽ phải, đúng chứ?
Dialogue: 0,0:22:48.74,0:22:50.74,Default,,0000,0000,0000,,{\an8\c&HFFFFFF&\fs22}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.50,0:23:20.85,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng vừa lạnh lùng vừa rất đỗi con người
Dialogue: 0,0:23:20.85,0:23:23.75,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.75,0:23:26.06,GitS ED Credits,,0000,0000,0000,,Nàng vẫn rạng rỡ đơn độc một mình
Dialogue: 0,0:23:26.06,0:23:29.12,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng chính là hiện thân của số chín
Dialogue: 0,0:23:29.12,0:23:31.87,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Một ẩn số toán học diệu kỳ
Dialogue: 0,0:23:33.13,0:23:36.15,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Một bài toán kỳ diệu đến không tưởng
Dialogue: 0,0:23:36.42,0:23:40.61,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.61,0:23:43.90,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng là một điều gì đó quá đỗi mới lạ
Dialogue: 0,0:23:43.90,0:23:46.15,GitS ED Credits,,0000,0000,0000,,Đóa hoa lithium vừa bừng tỉnh giấc
Dialogue: 0,0:23:46.15,0:23:49.01,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang hé nở rực rỡ
Dialogue: 0,0:23:49.10,0:23:51.81,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi ngửi thấy mùi lithium thoảng qua
Dialogue: 0,0:23:52.85,0:23:55.93,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Thoang thoảng hương lithium
Dialogue: 0,0:23:57.10,0:24:01.14,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:01.14,0:24:04.97,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:04.97,0:24:07.87,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Nàng sẽ ra sao khi không lướt sóng trên dòng mạng?
Dialogue: 0,0:24:07.87,0:24:12.07,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tự hỏi nàng sẽ làm gì khi thức giấc?
Dialogue: 0,0:24:13.35,0:24:16.64,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Mỗi khi nàng tỉnh giấc?


