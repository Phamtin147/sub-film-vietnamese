Dialogue: 0,0:00:00.85,0:00:03.18,Default,,0000,0000,0000,,MOTOKO!
Dialogue: 0,0:00:05.48,0:00:08.78,Default,,0000,0000,0000,,Ý cô muốn nói là ngay cả khi thể xác đã mất đi, những suy nghĩ của một người...
Dialogue: 0,0:00:08.95,0:00:12.65,Default,,0000,0000,0000,,...vẫn có thể lang thang trên mạng lưới và tiếp tục tồn tại như một cá thể độc nhất vô nhị sao?
Dialogue: 0,0:00:13.46,0:00:14.93,Default,,0000,0000,0000,,Tôi không dám chắc.
Dialogue: 0,0:00:15.26,0:00:17.63,Default,,0000,0000,0000,,Thật khó mà hình dung được rằng một ý chí được giải phóng khỏi lớp vỏ bọc...
Dialogue: 0,0:00:17.63,0:00:19.93,Default,,0000,0000,0000,,...lại có thể duy trì tính cá bản của mình giữa biển thông tin bao la của mạng lưới.
Dialogue: 0,0:00:20.53,0:00:24.56,Default,,0000,0000,0000,,Vậy thì đối với một người vẫn tiếp tục sống, ngay cả khi họ liên tục đánh mất đi tính cá bản của mình,
Dialogue: 0,0:00:24.97,0:00:26.63,Default,,0000,0000,0000,,thế giới này chính là sự tuyệt vọng.
Dialogue: 0,0:00:27.11,0:00:29.44,Default,,0000,0000,0000,,Tôi nghĩ điều đó còn tùy thuộc vào cách cậu định nghĩa thế nào là tuyệt vọng.
Dialogue: 0,0:00:30.31,0:00:32.90,Default,,0000,0000,0000,,Dù sao đi nữa, người ta luôn có lựa chọn là thử tìm đến cái chết cơ mà, đúng không?
Dialogue: 0,0:00:33.35,0:00:34.81,Default,,0000,0000,0000,,Tôi đoán luôn có sự lựa chọn đó.
Dialogue: 0,0:00:35.11,0:00:38.48,Default,,0000,0000,0000,,Dù sao thì tôi cũng nợ cô một ân tình. Cảm ơn cô nhé.
Dialogue: 0,0:00:39.35,0:00:42.98,Default,,0000,0000,0000,,Cách cậu giữ trọn lời hứa quả thực vô cùng duyên dáng đấy.
Dialogue: 0,0:00:50.96,0:00:55.37,Default,,0000,0000,0000,,{\i1}"Ở Đội 9 này, chúng ta không có những lời ngụy biện tiện lợi như tinh thần đồng đội."{\i0}
Dialogue: 0,0:00:56.74,0:01:00.93,Default,,0000,0000,0000,,{\i1}"Tất cả những gì chúng ta cần là sự phối hợp nhịp nhàng nảy sinh như hệ quả tất yếu từ màn độc diễn đỉnh cao của từng cá nhân."{\i0}
Dialogue: 0,0:01:01.77,0:01:07.37,Default,,0000,0000,0000,,{\i1}Đó là lời khuyên răn đầu tiên mà Trưởng ban đã dành cho chúng tôi vào những ngày đầu thành lập Đội 9.{\i0}
Dialogue: 0,0:01:11.98,0:01:16.94,Default,,0000,0000,0000,,{\i1}Khi mọi biến cố ập đến, liệu có thực sự là sếp già đã ném chúng tôi vào miệng cọp hay không?{\i0}
Dialogue: 0,0:01:18.09,0:01:20.43,Default,,0000,0000,0000,,{\i1}Tôi phải trải qua những đợt thẩm vấn vô ích và mỏi mòn,{\i0}
Dialogue: 0,0:01:20.43,0:01:24.95,Default,,0000,0000,0000,,{\i1}không thể liên lạc với đồng đội, thậm chí chẳng thể tiếp cận bất kỳ nguồn dữ liệu nào từ bên ngoài.{\i0}
Dialogue: 0,0:01:25.83,0:01:29.27,Default,,0000,0000,0000,,{\i1}Và rồi, 15 ngày sau đó, tôi đột ngột được trả tự do.{\i0}
Dialogue: 0,0:01:44.82,0:01:46.92,Default,,0000,0000,0000,,{\i1}Ghi trong lệnh phóng thích trao tận tay tôi khi ấy là hai điều.{\i0}
Dialogue: 0,0:01:46.92,0:01:50.22,Default,,0000,0000,0000,,{\i1}Sự thật rằng Ban An ninh Công cộng số 9 đã chính thức bị giải thể,{\i0}
Dialogue: 0,0:01:50.59,0:01:54.63,Default,,0000,0000,0000,,{\i1}và thông báo từ công ty an ninh vốn là vỏ bọc danh nghĩa của tôi...{\i0}
Dialogue: 0,0:01:54.63,0:01:57.29,Default,,0000,0000,0000,,{\i1}...cho biết tôi được tạm nghỉ phép vô thời hạn tại nhà.{\i0}
Dialogue: 0,0:01:58.10,0:02:01.90,Default,,0000,0000,0000,,{\i1}Thế nhưng tôi biết phải chờ đợi liên lạc từ ai đây?{\i0}
Dialogue: 0,0:02:04.94,0:02:10.71,Default,,0000,0000,0000,,{\i1}Tôi đôn đáo chạy vạy khắp nơi, cố tìm hiểu xem chuyện gì đã diễn ra trong suốt thời gian tôi bị giam giữ.{\i0}
Dialogue: 0,0:02:11.87,0:02:12.12,GitS Signs B/W,,0000,0000,0000,,{\fs25\frx8\fry352\frz18.916\pos(834,259)}243 Ứng viên Liên minh Cầm quyền trong Cuộc Bầu cử Hạ viện
