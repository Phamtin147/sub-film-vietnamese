Dialogue: 0,0:02:44.34,0:02:48.78,Default,,0000,0000,0000,,{\i1}"Vạch trần âm mưu đảo chính vũ trang của một số thành viên An ninh Công cộng cực đoan."{\i0}
Dialogue: 0,0:02:49.25,0:02:52.98,Default,,0000,0000,0000,,{\i1}Đó là cách vụ việc được tóm tắt và công bố rầm rộ cho toàn thể công chúng.{\i0}
Dialogue: 0,0:02:53.49,0:02:58.42,Default,,0000,0000,0000,,{\i1}Thậm chí việc Quân đội Phòng vệ sử dụng vũ lực trấn áp âm mưu đảo chính...{\i0}
Dialogue: 0,0:02:58.76,0:03:01.49,Default,,0000,0000,0000,,{\i1}...cũng được ca ngợi nhiệt liệt trên hầu khắp các phương tiện truyền thông.{\i0}
Dialogue: 0,0:03:12.84,0:03:14.74,Default,,0000,0000,0000,,{\i1}Các thành viên của Đội 9,{\i0}
Dialogue: 0,0:03:14.74,0:03:17.41,Default,,0000,0000,0000,,{\i1}bị gán cho tội danh chủ mưu phản quốc đặc biệt nguy hiểm,{\i0}
Dialogue: 0,0:03:17.41,0:03:20.67,Default,,0000,0000,0000,,{\i1}đã bị quân đội truy quét bắt giữ và chuyển giao sang cho viện kiểm sát công tố.{\i0}
Dialogue: 0,0:03:21.21,0:03:23.61,Default,,0000,0000,0000,,{\i1}Rồi nhanh chóng bị tuyên án sau một phiên tòa sơ thẩm chóng vánh.{\i0}
Dialogue: 0,0:03:24.25,0:03:29.78,Default,,0000,0000,0000,,{\i1}Thế nhưng tung tích của họ sau đó lại bị bưng bít hoàn toàn dưới danh nghĩa bí mật quốc gia.{\i0}
Dialogue: 0,0:03:30.19,0:03:35.49,Default,,0000,0000,0000,,{\i1}Bị tước bỏ mọi đặc quyền đặc lợi và bị giáng xuống thành một thường dân trắng tay,{\i0}
Dialogue: 0,0:03:36.16,0:03:38.36,Default,,0000,0000,0000,,{\i1}tôi hoàn toàn bất lực trong việc tiếp cận thêm bất kỳ nguồn thông tin nào.{\i0}
Dialogue: 0,0:03:38.76,0:03:42.33,Default,,0000,0000,0000,,{\i1}Thế nhưng có hai điều khiến tôi không tài nào nuốt trôi được.{\i0}
Dialogue: 0,0:03:43.20,0:03:47.14,Default,,0000,0000,0000,,{\i1}Một là sự tồn tại của Trưởng ban, linh hồn và trái tim của Đội 9,{\i0}
Dialogue: 0,0:03:47.14,0:03:50.30,Default,,0000,0000,0000,,{\i1}dường như đã biến mất hoàn toàn không dấu vết khỏi vũ đài công luận.{\i0}
Dialogue: 0,0:03:50.84,0:03:53.31,Default,,0000,0000,0000,,{\i1}Tên của sếp già không hề xuất hiện trên bất kỳ bản tin nào,{\i0}
Dialogue: 0,0:03:53.75,0:03:56.65,Default,,0000,0000,0000,,{\i1}và cũng chẳng hề có mặt trong danh sách những kẻ cầm đầu.{\i0}
Dialogue: 0,0:03:57.42,0:04:00.61,Default,,0000,0000,0000,,{\i1}Liệu có thực sự là sếp đã ruồng bỏ chúng tôi hay không?{\i0}
Dialogue: 0,0:04:01.15,0:04:04.19,Default,,0000,0000,0000,,{\i1}Và điều còn lại chính là số phận của Thiếu tá,{\i0}
Dialogue: 0,0:04:04.19,0:04:07.89,Default,,0000,0000,0000,,{\i1}thành viên duy nhất được làm rõ tình trạng sau cuộc đột kích định mệnh đó.{\i0}
Dialogue: 0,0:04:10.20,0:04:13.32,Default,,0000,0000,0000,,{\i1}Liệu Thiếu tá... đã thực sự hy sinh rồi sao...?{\i0}
Dialogue: 0,0:04:15.30,0:04:17.10,Default,,0000,0000,0000,,{\i1}Đó là chuyện của ba tháng trước.{\i0}
Dialogue: 0,0:04:21.81,0:04:25.17,Default,,0000,0000,0000,,{\i1}Đôi khi, việc thực thi nghĩa vụ của người lính An ninh Công cộng...{\i0}
Dialogue: 0,0:04:25.61,0:04:29.08,Default,,0000,0000,0000,,{\i1}...chẳng là gì khác ngoài việc rèn giũa ý chí sắt đá...{\i0}
Dialogue: 0,0:04:29.08,0:04:31.05,Default,,0000,0000,0000,,{\i1}...để chịu đựng những cuộc điều tra dài dằng dặc tưởng chừng như không bao giờ kết thúc.{\i0}
Dialogue: 0,0:04:32.48,0:04:36.01,Default,,0000,0000,0000,,{\i1}Nhưng chưa một lần nào tôi cảm thấy đau đớn vì điều đó.{\i0}
Dialogue: 0,0:04:36.46,0:04:40.26,Default,,0000,0000,0000,,{\i1}Thế nhưng trong suốt ba tháng này, trong dòng thời gian không ngừng trôi chảy ấy,{\i0}
Dialogue: 0,0:04:40.26,0:04:43.82,Default,,0000,0000,0000,,{\i1}tại sao tôi lại là người duy nhất được sống tự do, như thể chưa từng có chuyện gì xảy ra?{\i0}
Dialogue: 0,0:04:44.66,0:04:48.29,Default,,0000,0000,0000,,{\i1}Những ngày tháng này, khi tôi phải tiếp tục đóng vai người chồng thất nghiệp trong mắt gia đình,{\i0}
Dialogue: 0,0:04:48.50,0:04:53.46,Default,,0000,0000,0000,,{\i1}đã mang theo nỗi dằn vặt khôn nguôi và nghiền nát tinh thần tôi từng ngày.{\i0}
Dialogue: 0,0:04:54.91,0:04:57.90,Default,,0000,0000,0000,,Có lẽ đã đến lúc mình nên bắt đầu đi tìm một công việc mới rồi...
Dialogue: 0,0:05:02.55,0:05:05.58,Default,,0000,0000,0000,,{\i1}Chúng tôi nhận được tin báo rằng các công tố viên viện kiểm sát sẽ sớm có mặt tại hiện trường.{\i0}
Dialogue: 0,0:05:05.58,0:05:08.29,Default,,0000,0000,0000,,{\i1}Hàng đoàn phóng viên báo chí đang tập trung đông nghẹt trước trụ sở Đảng cầm quyền,{\i0}
Dialogue: 0,0:05:08.29,0:05:10.28,Default,,0000,0000,0000,,{\i1}và bầu không khí nơi đây đang bao trùm một sự căng thẳng tột độ.{\i0}
Dialogue: 0,0:05:11.52,0:05:14.29,Default,,0000,0000,0000,,{\i1}Vụ bê bối Bộ Y tế liên quan đến Serano Genomics từng lan truyền râm ran...{\i0}
Dialogue: 0,0:05:14.39,0:05:17.36,Default,,0000,0000,0000,,{\i1}...trên các mặt báo lá cải trước thềm bầu cử Hạ viện...{\i0}
Dialogue: 0,0:05:17.80,0:05:21.40,Default,,0000,0000,0000,,...đã chỉ đích danh Tổng Thư ký Yakushima, và giờ đây, chỉ một tuần sau khi Nội các mới thành lập,
Dialogue: 0,0:05:21.40,0:05:25.44,Default,,0000,0000,0000,,nó cuối cùng đã leo thang thành một cuộc điều tra toàn diện do Viện Công tố tối cao chỉ đạo.
Dialogue: 0,0:05:25.44,0:05:28.87,Default,,0000,0000,0000,,Cuộc điều tra quy mô lớn của Viện Kiểm sát hiện đang được tiến hành khẩn trương, và...
Dialogue: 0,0:05:33.01,0:05:33.98,Default,,0000,0000,0000,,Công tố viên tới rồi kìa!
Dialogue: 0,0:05:36.92,0:05:38.62,Default,,0000,0000,0000,,Một cuộc điều tra toàn diện cuối cùng đã chính thức bắt đầu,
Dialogue: 0,0:05:38.62,0:05:40.88,Default,,0000,0000,0000,,nhưng liệu Yakushima có bị bắt giam ngay trước khi ngày hôm nay khép lại không?
Dialogue: 0,0:05:40.99,0:05:44.39,Default,,0000,0000,0000,,Thế còn số cổ phiếu Serano bị đồn là đang cất giữ tại trụ sở Đảng cầm quyền thì sao?
Dialogue: 0,0:05:44.82,0:05:46.79,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chúng tôi đã nắm trong tay những nguồn tin xác thực đáng tin cậy.{\i0}
Dialogue: 0,0:05:47.33,0:05:50.30,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Nhiều khả năng chúng tôi sẽ mời Tổng Thư ký đi cùng để phục vụ công tác thẩm vấn.{\i0}
Dialogue: 0,0:05:50.30,0:05:53.27,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Liệu có khả năng những cọc tiền mặt mang số sê-ri liên tiếp...{\i0}
Dialogue: 0,0:05:53.27,0:05:55.32,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...được nhắc đến trong lời khai của ông Serano đang được cất giấu ngay tại nơi này không ạ?{\i0}
Dialogue: 0,0:05:56.30,0:05:58.96,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Mọi việc sẽ sớm được làm sáng tỏ, bao gồm cả điều đó nữa.{\i0}
Dialogue: 0,0:05:59.40,0:06:04.18,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chúng tôi đã nỗ lực làm việc không ngừng nghỉ suốt một thời gian dài để chuẩn bị cho ngày bắt giữ ông Yakushima.{\i0}
Dialogue: 0,0:06:04.18,0:06:05.64,Default,,0000,0000,0000,,{\i1}"Lâu dài và nỗ lực" sao... Nghe ngứa tai thật...{\i0}
Dialogue: 0,0:06:05.31,0:06:08.08,Top Secondary Dialog 1080P,,0000,0000,0000,,Cuộc điều tra quy mô này được hậu thuẫn bởi sự tự tin đúc kết từ quá trình làm việc gian khổ đó.
Dialogue: 0,0:06:06.51,0:06:09.61,Default,,0000,0000,0000,,{\i1}Tôi chẳng biết Viện Công tố đã thò tay lấy đâu ra tất cả những nguồn thông tin này,{\i0}
Dialogue: 0,0:06:08.08,0:06:09.61,Top Secondary Dialog 1080P,,0000,0000,0000,,Các quý vị hoàn toàn có quyền đặt nhiều kỳ vọng.
Dialogue: 0,0:06:10.08,0:06:13.28,Default,,0000,0000,0000,,{\i1}thế nhưng thông tin lan truyền trên các tờ báo lá cải và các trang mạng cá nhân...{\i0}
Dialogue: 0,0:06:13.49,0:06:17.05,Default,,0000,0000,0000,,{\i1}...rõ ràng chính là nguồn tin tình báo mà Thiếu tá và những người chúng tôi đã dốc máu xương tìm ra.{\i0}
Dialogue: 0,0:06:17.56,0:06:19.75,Default,,0000,0000,0000,,{\i1}Ngay cả cuộc điều tra về dòng tiền đen dẫn thẳng tới Serano...{\i0}
Dialogue: 0,0:06:20.09,0:06:23.03,Default,,0000,0000,0000,,{\i1}...nguyên bản cũng là chiến công của những người Đội 9 chúng tôi.{\i0}
Dialogue: 0,0:06:23.53,0:06:27.56,Default,,0000,0000,0000,,{\i1}Đúng là nếu Yakushima bị bắt, mục tiêu của chúng tôi coi như đã hoàn thành.{\i0}
Dialogue: 0,0:06:28.60,0:06:32.20,Default,,0000,0000,0000,,{\i1}Ai là người thực tế tra tay vào còng bắt giữ hắn suy cho cùng chỉ là chuyện thứ yếu.{\i0}
Dialogue: 0,0:06:33.31,0:06:36.54,Default,,0000,0000,0000,,{\i1}Thế nhưng bất chấp điều đó, cái cảm giác nhói buốt trong lòng tôi lúc này là gì đây?{\i0}
Dialogue: 0,0:06:37.54,0:06:39.41,Default,,0000,0000,0000,,{\i1}Cái vẻ mặt đắc thắng hợm hĩnh của lũ công tố viên...{\i0}
Dialogue: 0,0:06:40.08,0:06:42.91,Default,,0000,0000,0000,,{\i1}Ngay cả màu áo sơ mi trắng tinh tươm phẳng phiu của chúng cũng khiến tôi ngứa mắt phát điên.{\i0}
Dialogue: 0,0:06:44.48,0:06:46.47,Default,,0000,0000,0000,,{\i1}Mọi chuyện lẽ ra phải diễn ra như thế này sao...?{\i0}
Dialogue: 0,0:06:46.82,0:06:49.19,Default,,0000,0000,0000,,{\i1}Những sự thật trần trụi mà Thiếu tá và các đồng đội tôi đã chắp vá nên,{\i0}
Dialogue: 0,0:06:49.19,0:06:52.55,Default,,0000,0000,0000,,{\i1}chẳng phải đây mới chính là chân tướng thực sự đằng sau vụ án Gã Mặt Cười từ sáu năm trước hay sao?{\i0}
Dialogue: 0,0:06:53.53,0:06:56.49,Default,,0000,0000,0000,,{\i1}Dù cho Viện Công tố có phơi bày thành công toàn bộ vụ bê bối của Bộ Y tế đi chăng nữa,{\i0}
Dialogue: 0,0:06:56.90,0:06:59.80,Default,,0000,0000,0000,,{\i1}thì Yakushima thậm chí có thể còn chẳng buồn từ chức nghị viên quốc hội.{\i0}
Dialogue: 0,0:07:00.63,0:07:03.36,Default,,0000,0000,0000,,Làm sao mà cái cách thức này có thể biến thế giới thành một nơi tốt đẹp hơn được cơ chứ?!
Dialogue: 0,0:07:26.09,0:07:29.89,Default,,0000,0000,0000,,{\i1}Chẳng phải là tôi từng mơ mộng muốn trở thành một người hùng gì cho cam.{\i0}
Dialogue: 0,0:07:31.03,0:07:36.59,Default,,0000,0000,0000,,{\i1}Nhưng tôi tin chắc rằng chúng tôi đã kiên định đi theo lẽ phải mà mình tôn thờ mà chưa từng một lần thỏa hiệp.{\i0}
Dialogue: 0,0:07:37.74,0:07:38.73,Default,,0000,0000,0000,,{\i1}Gã Mặt Cười...{\i0}
Dialogue: 0,0:07:39.24,0:07:44.17,Default,,0000,0000,0000,,{\i1}Cậu chính là người đầu tiên cố gắng rọi chiếu ánh sáng vào vực thẳm tăm tối của vụ án này.{\i0}
Dialogue: 0,0:07:45.21,0:07:49.24,Default,,0000,0000,0000,,{\i1}Liệu có phải ngay lúc này đây, cậu cũng đang mang cùng nỗi niềm cay đắng như tôi không?{\i0}
Dialogue: 0,0:07:50.12,0:07:54.42,Default,,0000,0000,0000,,{\i1}Không, cậu sẽ không như thế đâu. Cậu không phải kiểu người thèm bận tâm đến những chuyện vụn vặt đó.{\i0}
Dialogue: 0,0:07:51.17,0:07:51.25,GitS Catcher in the Rye,,0000,0000,0000,,{\frx0\fry340\frz34.903\fs40\pos(1214,875)}{\c6E6C68}Bắt Trẻ Đồng{\cC5B3A9} Xanh
Dialogue: 0,0:07:51.25,0:07:51.38,GitS Catcher in the Rye,,0000,0000,0000,,{\frz18.386\pos(1070,639)}{\c6E6C68}Bắt {\cC5B3A9}Trẻ Đồng Xanh
Dialogue: 0,0:07:51.38,0:07:51.50,GitS Catcher in the Rye,,0000,0000,0000,,{\frz13.313\pos(1014,529)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:07:51.50,0:07:51.63,GitS Catcher in the Rye,,0000,0000,0000,,{\frz12.084\pos(984,475)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:07:51.63,0:07:59.43,GitS Catcher in the Rye,,0000,0000,0000,,{\frz9.324\pos(954,409)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:07:55.09,0:07:56.66,Default,,0000,0000,0000,,{\i1}Chắc hẳn cậu đã giác ngộ được một điều gì đó to lớn hơn,{\i0}
Dialogue: 0,0:07:56.66,0:07:59.36,Default,,0000,0000,0000,,{\i1}và đang dõi theo cục diện này bằng một đôi mắt có tầm nhìn rộng mở bao la hơn tôi nhiều.{\i0}
Dialogue: 0,0:07:59.36,0:08:01.79,Default,,0000,0000,0000,,{\i1}Có đúng vậy không? Tôi cảm nhận được điều đó.{\i0}
Dialogue: 0,0:07:59.43,0:07:59.51,GitS Catcher in the Rye,,0000,0000,0000,,{\frz6.117\pos(1030,377)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:07:59.51,0:07:59.60,GitS Catcher in the Rye,,0000,0000,0000,,{\frz4.209\fs53\pos(1124,345)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:07:59.60,0:07:59.64,GitS Catcher in the Rye,,0000,0000,0000,,{\fs56\frz0.466\pos(1294,261)}Bắt Trẻ Đồng Xanh
Dialogue: 0,0:08:03.46,0:08:04.52,Default,,0000,0000,0000,,{\i1}Thiếu tá...{\i0}
Dialogue: 0,0:08:05.83,0:08:09.23,Default,,0000,0000,0000,,{\i1}Nếu chuyện này diễn biến đúng như tôi nghĩ...{\i0}
Dialogue: 0,0:08:34.26,0:08:35.53,Default,,0000,0000,0000,,Đứng yên!
Dialogue: 0,0:08:35.53,0:08:37.83,Default,,0000,0000,0000,,Rút tay ra thật chậm rãi, rồi quay người lại đây!
Dialogue: 0,0:08:46.30,0:08:49.97,Default,,0000,0000,0000,,Với trình còi của chú mày, thì còn lâu mới tới gần được lão Yakushima mà không bị tóm cổ.
Dialogue: 0,0:08:50.28,0:08:52.04,Default,,0000,0000,0000,,Anh... to con?
Dialogue: 0,0:08:55.78,0:08:59.48,Default,,0000,0000,0000,,Chú mày đúng là thằng đại ngốc, biết không hả? Đi theo anh.
Dialogue: 0,0:09:18.54,0:09:20.00,Default,,0000,0000,0000,,Ngôi sao của chúng ta đã tới rồi kìa!
Dialogue: 0,0:09:20.44,0:09:22.07,Default,,0000,0000,0000,,Làm cái gì mà lâu la thế hả?
Dialogue: 0,0:09:22.07,0:09:24.20,Default,,0000,0000,0000,,Thế chú mày bám đuôi cậu ta tới tận đâu?
Dialogue: 0,0:09:24.34,0:09:27.04,Default,,0000,0000,0000,,Đúng như chúng ta dự đoán, cậu ta mò tới tận trụ sở Đảng cầm quyền.
Dialogue: 0,0:09:27.61,0:09:28.81,Default,,0000,0000,0000,,Cậu nói thật đấy à?!
Dialogue: 0,0:09:29.88,0:09:32.71,Default,,0000,0000,0000,,Này, chú mày sao thế? Chú mày đang {\i1}khóc đấy à?{\i0}
Dialogue: 0,0:09:33.35,0:09:34.82,Default,,0000,0000,0000,,Làm gì có chuyện đó!
Dialogue: 0,0:09:35.42,0:09:37.42,Default,,0000,0000,0000,,Thế tình hình bên các anh diễn ra sao rồi?
Dialogue: 0,0:09:37.42,0:09:39.29,Default,,0000,0000,0000,,Có vẻ như lão Tổng Thư ký đã chịu buông tay quy hàng rồi.
Dialogue: 0,0:09:39.29,0:09:43.19,Default,,0000,0000,0000,,Đúng là tác phong của dân cựu quân đội có khác. Xem ra lão đang hợp tác đầy đủ với các buổi thẩm vấn.
Dialogue: 0,0:09:44.03,0:09:47.17,Default,,0000,0000,0000,,Tôi đoán đám người bên Viện Công tố sẽ được tung hô như những người hùng trong một thời gian dài nhờ vụ này.
Dialogue: 0,0:09:47.17,0:09:48.33,Default,,0000,0000,0000,,Anh nói {\i1}chuẩn{\i0} đấy...
Dialogue: 0,0:09:48.83,0:09:50.70,Default,,0000,0000,0000,,Nhưng các anh thấy thế này mà ổn sao?
Dialogue: 0,0:09:50.70,0:09:52.60,Default,,0000,0000,0000,,Chiến công lùng bắt và hạ bệ Yakushima...
Dialogue: 0,0:09:52.87,0:09:56.03,Default,,0000,0000,0000,,"Lẽ ra phải thuộc về những người Đội 9 chúng ta", chú mày muốn nói vậy chứ gì?
Dialogue: 0,0:09:57.34,0:09:59.48,Default,,0000,0000,0000,,Thì, đâu phải là tôi không thấu hiểu cảm giác uất ức của chú mày,
Dialogue: 0,0:09:59.48,0:10:03.71,Default,,0000,0000,0000,,nhưng đây chính xác là những gì lão khỉ già gian xảo đó đã toan tính ngay từ đầu.
Dialogue: 0,0:10:04.48,0:10:05.65,Default,,0000,0000,0000,,{\i1}Toan tính sao?{\i0}
Dialogue: 0,0:10:05.65,0:10:06.31,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:10:06.99,0:10:10.15,Default,,0000,0000,0000,,Lão khỉ già sớm nhận ra ngài Thủ tướng sẽ tìm cách né tránh...
Dialogue: 0,0:10:10.56,0:10:13.22,Default,,0000,0000,0000,,...việc cải tổ ghế Tổng Thư ký Đảng trước thềm bầu cử.
Dialogue: 0,0:10:13.49,0:10:17.15,Default,,0000,0000,0000,,Nên sếp đã táo bạo chọn cách biến Đội 9 thành kẻ phản diện để hiến tế.
Dialogue: 0,0:10:18.23,0:10:22.50,Default,,0000,0000,0000,,Vào thời điểm Thiếu tá cải trang thành Gã Mặt Cười và moi được toàn bộ sự thật từ miệng Serano,
Dialogue: 0,0:10:22.83,0:10:24.89,Default,,0000,0000,0000,,sự tồn tại của Đội 9 đã bị rò rỉ cho các phương tiện truyền thông đại chúng,
Dialogue: 0,0:10:25.24,0:10:28.00,Default,,0000,0000,0000,,khiến chúng ta không thể tiếp tục hoạt động trong bóng tối như trước kia được nữa.
Dialogue: 0,0:10:28.54,0:10:31.34,Default,,0000,0000,0000,,Vì vậy, kế hoạch của Trưởng ban là bắt tay thực hiện một thỏa thuận ngầm với Thủ tướng,
Dialogue: 0,0:10:31.68,0:10:36.67,Default,,0000,0000,0000,,buộc Viện Công tố phải vào cuộc bằng cách ngoài mặt hy sinh toàn bộ Đội 9.
Dialogue: 0,0:10:37.82,0:10:40.08,Default,,0000,0000,0000,,Hiến tế Đội 9...
Dialogue: 0,0:10:42.15,0:10:47.86,Default,,0000,0000,0000,,Dù có là như thế đi chăng nữa, các anh có biết ba tháng qua tôi đã phải sống trong chuỗi ngày thế nào không?!
Dialogue: 0,0:10:47.86,0:10:51.59,Default,,0000,0000,0000,,Thôi nào, đừng bi quan quá thế. Hãy coi đó như một kỳ nghỉ phép đặc biệt đi.
Dialogue: 0,0:10:52.10,0:10:55.62,Default,,0000,0000,0000,,Bọn anh ban đầu cũng đâu có được thông báo trước về chiến dịch ngầm này đâu.
Dialogue: 0,0:10:56.17,0:10:59.97,Default,,0000,0000,0000,,Sếp già có niềm tin tuyệt đối rằng tất cả chúng ta đều sẽ sống sót và tập hợp lại cùng nhau,
Dialogue: 0,0:11:00.47,0:11:02.94,Default,,0000,0000,0000,,và đã đưa ra một quyết định vô cùng khó khăn để tiến hành kế hoạch ấy.
Dialogue: 0,0:11:03.51,0:11:06.74,Default,,0000,0000,0000,,Thậm chí việc chú mày bị bắt giữ và quản thúc đầu tiên cũng chính là cách của sếp...
Dialogue: 0,0:11:06.74,0:11:11.01,Default,,0000,0000,0000,,...nhằm giữ cho chú mày còn sống bằng cách đưa chú mày ra khỏi phạm vi chiến dịch càn quét Đội 9.
Dialogue: 0,0:11:11.95,0:11:14.39,Default,,0000,0000,0000,,Trước hết, chú mày là người hoàn toàn bằng xương bằng thịt, {\i1}lại còn{\i0} vừa mới xuất viện xong.
Dialogue: 0,0:11:14.39,0:11:17.65,Default,,0000,0000,0000,,Thêm nữa, chú mày là người đã có gia đình vợ con, việc thao túng thông tin sẽ khó khăn hơn rất nhiều,
Dialogue: 0,0:11:18.02,0:11:21.46,Default,,0000,0000,0000,,nên chú mày cần phải được tách xa khỏi Đội 9 cho tới khi mọi khâu chuẩn bị của sếp hoàn tất.
Dialogue: 0,0:11:21.89,0:11:27.06,Default,,0000,0000,0000,,Đừng để bụng làm gì. Trên hồ sơ lưu trữ thì anh đây cũng đang phải thụ án mọt gông trong tù kia kìa.
Dialogue: 0,0:11:27.43,0:11:29.47,Default,,0000,0000,0000,,"Được lợi nhiều hơn, bớt danh hão đi."
Dialogue: 0,0:11:29.47,0:11:34.03,Default,,0000,0000,0000,,Điều này đồng nghĩa với việc chúng ta đã quay trở lại làm một lực lượng tấn công không chính thức tồn tại trên giấy tờ.
Dialogue: 0,0:11:35.07,0:11:36.97,Default,,0000,0000,0000,,Toàn bộ mọi chuyện... rốt cuộc là vì vậy sao?
Dialogue: 0,0:11:37.61,0:11:39.51,Default,,0000,0000,0000,,Cơ mà này... Thế còn Thiếu tá thì sao?
Dialogue: 0,0:11:42.81,0:11:45.91,Default,,0000,0000,0000,,Ai thèm quan tâm chứ? Tôi chẳng thèm để tâm đến mụ quái chiêu đó đâu.
Dialogue: 0,0:11:51.92,0:11:55.26,Default,,0000,0000,0000,,Nhắc mới nhớ nhé Batou, chẳng phải hồi đó chú mày đã gào khóc thảm thiết nước mắt đầm đìa sao?
Dialogue: 0,0:11:55.59,0:11:56.79,Default,,0000,0000,0000,,Á à, câm mồm đi nhé.
Dialogue: 0,0:11:56.96,0:11:58.20,Default,,0000,0000,0000,,Ồ, thật thế cơ à?
Dialogue: 0,0:11:58.20,0:12:01.17,Default,,0000,0000,0000,,Nếu vậy thì, hay là để tôi trích xuất đoạn phim vệ tinh quay lại hiện trường lúc đó ra nhé?
Dialogue: 0,0:12:01.37,0:12:03.50,Default,,0000,0000,0000,,Này, rồi bắn qua cho Thiếu tá xem luôn thể!
Dialogue: 0,0:12:03.50,0:12:04.50,Default,,0000,0000,0000,,Này, dừng lại ngay!
Dialogue: 0,0:12:04.50,0:12:06.54,Default,,0000,0000,0000,,"Motoko!" Có phải chú mày đã gào lên như thế không hả?
Dialogue: 0,0:12:06.54,0:12:07.56,Default,,0000,0000,0000,,Thằng khốn nạn này!
Dialogue: 0,0:12:08.14,0:12:09.30,Default,,0000,0000,0000,,- Tao bảo dừng lại cơ mà!\N- Được rồi, tao chịu thua!
Dialogue: 0,0:12:11.38,0:12:12.84,Default,,0000,0000,0000,,- Nói lời chúc ngủ ngon đi!\N- Này, thôi ngay đi!
Dialogue: 0,0:12:18.32,0:12:19.98,Default,,0000,0000,0000,,Mọi chuyện đã ngã ngũ cả rồi, tôi thấy vậy.
Dialogue: 0,0:12:22.65,0:12:25.09,Default,,0000,0000,0000,,Phần còn lại cứ để cho Tổng Chưởng lý lo liệu.
Dialogue: 0,0:12:25.79,0:12:27.95,Default,,0000,0000,0000,,Công việc của tôi ở đây coi như đã hoàn tất.
Dialogue: 0,0:12:28.33,0:12:31.73,Default,,0000,0000,0000,,Nhờ có vụ này mà Viện Công tố sẽ có thể ngẩng cao đầu hãnh diện trước công chúng.
Dialogue: 0,0:12:31.73,0:12:34.36,Default,,0000,0000,0000,,Thế nhưng giờ đây ông còn lại được những gì?
Dialogue: 0,0:12:34.67,0:12:38.40,Default,,0000,0000,0000,,Tôi đã có thể bảo đảm rằng công lý được thực thi theo cách thức của riêng mình.
Dialogue: 0,0:12:38.74,0:12:40.43,Default,,0000,0000,0000,,Chừng đó là quá đủ đối với tôi rồi.
Dialogue: 0,0:12:43.04,0:12:45.27,Default,,0000,0000,0000,,Vậy thì giờ ông định sẽ làm gì?
Dialogue: 0,0:12:46.58,0:12:49.55,Default,,0000,0000,0000,,Ông đâu thể cứ mải miết chơi trò đánh trận với súng ống và xe tăng mãi được.
Dialogue: 0,0:12:50.78,0:12:52.94,Default,,0000,0000,0000,,Ông thấy sao? Hay là sang đầu quân cho phe chúng tôi nhé?
Dialogue: 0,0:12:53.42,0:12:57.12,Default,,0000,0000,0000,,Tôi luôn tâm niệm rằng ông phù hợp với thế giới tư pháp hơn nhiều.
Dialogue: 0,0:12:57.12,0:12:58.71,Default,,0000,0000,0000,,Tôi lại không nghĩ như vậy.
Dialogue: 0,0:12:59.16,0:13:01.85,Default,,0000,0000,0000,,Sẽ cần nhiều hơn một biến cố cỏn con thế này để có thể chôn vùi Đội 9.
Dialogue: 0,0:13:02.26,0:13:07.29,Default,,0000,0000,0000,,Tôi đang trên đường đi chiêu mộ một thành viên mới đầy tiềm năng nhằm tái thiết lại Đội 9 đây.
Dialogue: 0,0:13:46.37,0:13:47.53,Default,,0000,0000,0000,,Giờ thì tôi hiểu rồi...
Dialogue: 0,0:13:49.94,0:13:53.07,Default,,0000,0000,0000,,Cô quả thực {\i1}hoàn toàn không phải{\i0} là Gã Mặt Cười, điều đó chắc chắn trăm phần trăm.
Dialogue: 0,0:14:34.49,0:14:35.75,Default,,0000,0000,0000,,Kính chào quý khách.
Dialogue: 0,0:14:36.02,0:14:38.12,Default,,0000,0000,0000,,Cậu đến muộn hơn tôi tưởng tượng đấy.
Dialogue: 0,0:14:38.12,0:14:42.15,Default,,0000,0000,0000,,Đừng có nói cái giọng đó. Cậu thậm chí còn chẳng buồn gửi lấy một lời mời cho tôi cơ mà.
Dialogue: 0,0:14:42.49,0:14:45.86,Default,,0000,0000,0000,,Nếu cô đứng yên một chỗ, người ta sẽ tự tìm đến với {\i1}cô{\i0}.
Dialogue: 0,0:14:46.70,0:14:48.46,Default,,0000,0000,0000,,Ai đã nói câu đó nhỉ? Doisneau sao?
Dialogue: 0,0:14:48.87,0:14:49.66,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:14:49.97,0:14:55.13,Default,,0000,0000,0000,,À thì, một phần là vì tôi đã dành rất nhiều thời gian suy nghĩ xem chúng tôi nên làm gì với cậu.
Dialogue: 0,0:14:55.44,0:14:58.11,Default,,0000,0000,0000,,Tôi đã có chút băn khoăn lo lắng rằng cậu sẽ quyết định...
Dialogue: 0,0:14:58.11,0:15:00.98,Default,,0000,0000,0000,,...tiếp tục trôi dạt vô định như thế rồi tìm đến cái chết.
Dialogue: 0,0:15:00.98,0:15:03.34,Default,,0000,0000,0000,,Tôi thực sự vẫn chưa mong muốn tìm đến cái chết vào lúc này đâu.
Dialogue: 0,0:15:03.88,0:15:07.78,Default,,0000,0000,0000,,Dù rằng tôi cũng vừa được nếm trải một trải nghiệm cận tử khá thú vị...
Dialogue: 0,0:15:08.22,0:15:10.69,Default,,0000,0000,0000,,...khi bộ não điện tử trong cơ thể điều khiển từ xa của tôi bị nổ tung.
Dialogue: 0,0:15:11.36,0:15:15.19,Default,,0000,0000,0000,,Vậy là cơ thể mới toanh của cô đã bị phá hủy, và cô vẫn chưa tiến hành thay thế một vỏ bọc mới...
Dialogue: 0,0:15:19.86,0:15:21.16,Default,,0000,0000,0000,,Mắt cậu tinh tường thật đấy.
Dialogue: 0,0:15:21.57,0:15:23.36,Default,,0000,0000,0000,,À thì, nhìn trộm vốn {\i1}là{\i0} sở thích của tôi mà.
Dialogue: 0,0:15:23.77,0:15:26.53,Default,,0000,0000,0000,,Cơ mà dẫu sao, cái chốn này rốt cuộc là nơi thế nào vậy?
Dialogue: 0,0:15:27.44,0:15:29.50,Default,,0000,0000,0000,,Trông nó chẳng khác nào một nghĩa địa chứa thông tin.
Dialogue: 0,0:15:30.01,0:15:33.47,Default,,0000,0000,0000,,Cậu thực sự từng nghĩ rằng mình có thể thay đổi thế giới từ một nơi như thế này sao?
Dialogue: 0,0:15:34.11,0:15:35.94,Default,,0000,0000,0000,,Ban đầu thì... tôi từng có chút ảo tưởng như vậy.
Dialogue: 0,0:15:36.21,0:15:39.05,Default,,0000,0000,0000,,Vậy giờ cậu cảm thấy thế nào về điều đó?
Dialogue: 0,0:15:39.55,0:15:42.18,Default,,0000,0000,0000,,Tôi không hề cảm thấy hừng hực thỏa mãn hay gì đâu.
Dialogue: 0,0:15:42.79,0:15:48.92,Default,,0000,0000,0000,,Sự thật là, có lẽ mọi chuyện đã kết thúc đối với tôi ngay khoảnh khắc tôi chia sẻ ký ức của mình cho cô.
Dialogue: 0,0:15:49.43,0:15:52.33,Default,,0000,0000,0000,,Tôi tự nhủ rằng cô có lẽ sẽ có thể tiếp quản và gánh vác phần còn lại từ thời điểm đó.
Dialogue: 0,0:15:52.63,0:15:55.39,Default,,0000,0000,0000,,Thật là... Cậu đúng là một kẻ nói dối trắng trợn, cậu biết điều đó không?
Dialogue: 0,0:15:55.83,0:15:57.93,Default,,0000,0000,0000,,Thế còn cái câu dặn tôi hãy đứng ngoài và đừng làm gì là sao hả?
Dialogue: 0,0:15:58.34,0:15:59.57,Default,,0000,0000,0000,,Tôi xin lỗi.
Dialogue: 0,0:15:59.57,0:16:04.71,Default,,0000,0000,0000,,Thế nhưng khoảnh khắc ta chia sẻ và đồng bộ hóa toàn bộ thông tin của mình, ta sẽ đánh mất tính độc bản...
Dialogue: 0,0:16:04.71,0:16:07.87,Default,,0000,0000,0000,,...và bị hòa tan vào ác ý vô thức của một bên thứ ba không có động cơ,
Dialogue: 0,0:16:07.98,0:16:10.57,Default,,0000,0000,0000,,hoặc có lẽ là hòa vào ý chí của một kẻ {\i1}thực sự có{\i0} động cơ.
Dialogue: 0,0:16:13.38,0:16:16.48,Default,,0000,0000,0000,,Đó là những lời lẽ của {\i1}chính cậu{\i0} sao? Đúc kết từ những trải nghiệm xương máu?
Dialogue: 0,0:16:16.89,0:16:17.89,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:16:17.89,0:16:21.99,Default,,0000,0000,0000,,Bởi vì sự thật là cuối cùng, chính bản thân tôi cũng đã đóng vai trò là một kẻ bắt chước Gã Mặt Cười.
Dialogue: 0,0:16:22.46,0:16:24.93,Default,,0000,0000,0000,,Tôi phải thừa nhận rằng đó là một hiện tượng vô cùng cuốn hút.
Dialogue: 0,0:16:25.73,0:16:30.46,Default,,0000,0000,0000,,Dù thế nào đi nữa, động cơ ban đầu của cậu khi châm ngòi cho một biến cố chấn động nhường ấy là gì?
Dialogue: 0,0:16:31.44,0:16:36.00,Default,,0000,0000,0000,,"Đối với cậu, mọi thứ đang diễn ra trên cõi đời này đều trông thật giả tạo, đúng chứ?"
Dialogue: 0,0:16:37.24,0:16:38.73,Default,,0000,0000,0000,,J.D. Salinger sao?
Dialogue: 0,0:16:39.01,0:16:39.98,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:16:41.95,0:16:45.78,Default,,0000,0000,0000,,Tất nhiên, tôi gần như là hình mẫu tiêu biểu cho trào lưu cơ khí hóa não bộ,
Dialogue: 0,0:16:46.45,0:16:51.41,Default,,0000,0000,0000,,nên chí ít tôi cũng từng nếm trải cảm giác kinh hoàng trước viễn cảnh xơ cứng não điện tử.
Dialogue: 0,0:16:52.56,0:16:58.86,Default,,0000,0000,0000,,Tất cả bắt đầu từ một mẩu thư điện tử mà tôi tình cờ bắt gặp khi lang thang trên mạng.
Dialogue: 0,0:17:00.57,0:17:05.26,Default,,0000,0000,0000,,Bức thư tống tiền có lẽ từng được gửi tới Serano Genomics...
Dialogue: 0,0:17:05.90,0:17:08.44,Default,,0000,0000,0000,,...được trang bị một luận án là công trình nghiên cứu so sánh...
Dialogue: 0,0:17:08.44,0:17:12.81,Default,,0000,0000,0000,,...giữa sự vô hiệu của vi máy móc Serano đối với hiệu quả vượt trội của vắc-xin Murai.
Dialogue: 0,0:17:14.35,0:17:17.11,Default,,0000,0000,0000,,Người viết lá thư đó mới chính là Gã Mặt Cười nguyên bản sao?
Dialogue: 0,0:17:17.75,0:17:19.72,Default,,0000,0000,0000,,Nếu cô muốn gọi như vậy.
Dialogue: 0,0:17:20.15,0:17:24.09,Default,,0000,0000,0000,,"Tôi là cỗ máy cho các bạn thấy thế giới như cách riêng tôi nhìn thấy nó."
Dialogue: 0,0:17:24.42,0:17:27.66,Default,,0000,0000,0000,,Dziga Vertov. Ông ấy là một đạo diễn phim tài liệu đúng không?
Dialogue: 0,0:17:27.66,0:17:28.52,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:17:28.73,0:17:32.46,Default,,0000,0000,0000,,Tôi đã tự huyễn hoặc bản thân rằng việc chứng minh và lan truyền rộng rãi...
Dialogue: 0,0:17:32.90,0:17:35.39,Default,,0000,0000,0000,,...nguồn thông tin mà chỉ mình tôi tình cờ phát hiện ra là sứ mệnh thiêng liêng của đời mình.
Dialogue: 0,0:17:35.93,0:17:37.59,Default,,0000,0000,0000,,Và rồi chuốc lấy thất bại ê chề thảm hại.
Dialogue: 0,0:17:37.94,0:17:41.54,Default,,0000,0000,0000,,Người môi giới thuần khiết và ngây thơ đã rơi vào tuyệt vọng trước bản chất mục ruỗng của hệ thống xã hội,
Dialogue: 0,0:17:41.54,0:17:42.80,Default,,0000,0000,0000,,và cậu ta đã chọn cách câm lặng.
Dialogue: 0,0:17:43.14,0:17:46.91,Default,,0000,0000,0000,,Phải. Và tôi đã trở thành kẻ môi giới biến mất.
Dialogue: 0,0:17:47.51,0:17:49.78,Default,,0000,0000,0000,,Hệt như một tác giả mà sự tồn tại càng được khắc sâu...
Dialogue: 0,0:17:49.78,0:17:52.51,Default,,0000,0000,0000,,...bởi chính sự thật rằng ông ta hiếm khi cho ra đời những tác phẩm mới.
Dialogue: 0,0:17:53.72,0:17:56.75,Default,,0000,0000,0000,,Nói cách khác, "Bằng cách biến mất,"
Dialogue: 0,0:17:56.75,0:17:59.48,Default,,0000,0000,0000,,"nó đóng vai trò như một môi chất điều tiết cho tính năng động của hệ thống xã hội."
Dialogue: 0,0:17:59.89,0:18:05.42,Default,,0000,0000,0000,,"Cuối cùng, nó tan biến, không để lại bất kỳ dấu vết tồn tại nào bên trong hay bên ngoài hệ thống."
Dialogue: 0,0:18:06.00,0:18:07.40,Default,,0000,0000,0000,,Fredric Jameson.
Dialogue: 0,0:18:07.93,0:18:11.80,Default,,0000,0000,0000,,Đúng vậy. Và cũng không hẳn. Vế cuối cùng là của Ohsawa Masachi.
Dialogue: 0,0:18:12.17,0:18:16.27,Default,,0000,0000,0000,,Dù đã thuộc nằm lòng những câu chữ đó, tôi vẫn không thể tin nổi cho tới khi tận mắt chứng kiến.
Dialogue: 0,0:18:16.74,0:18:20.70,Default,,0000,0000,0000,,Ai mà ngờ được rằng sự vắng bóng của một bản gốc lại sản sinh ra hàng loạt những bản sao không cần có bản gốc cơ chứ?
Dialogue: 0,0:18:21.51,0:18:24.31,Default,,0000,0000,0000,,Nếu phải đặt cho hiện tượng kỳ lạ này một cái tên, cô sẽ gọi nó là gì?
Dialogue: 0,0:18:25.92,0:18:27.91,Default,,0000,0000,0000,,Stand Alone Complex.
Dialogue: 0,0:18:28.32,0:18:30.98,Default,,0000,0000,0000,,Phải. Stand Alone Complex.
Dialogue: 0,0:18:31.92,0:18:35.16,Default,,0000,0000,0000,,Ngay từ đầu, chính bản chất của hệ thống xã hội đương đại...
Dialogue: 0,0:18:35.16,0:18:37.79,Default,,0000,0000,0000,,...đã chứa đựng sẵn những cơ chế tự động kích hoạt hiện tượng đó.
Dialogue: 0,0:18:38.56,0:18:42.50,Default,,0000,0000,0000,,Về mặt cá nhân, tôi buộc phải cảm thấy rằng đó chính là khởi đầu của sự tuyệt vọng,
Dialogue: 0,0:18:43.10,0:18:44.44,Default,,0000,0000,0000,,thế nhưng còn cô thì sao?
Dialogue: 0,0:18:44.44,0:18:47.10,Default,,0000,0000,0000,,Tôi không biết. Thật khó mà nói trước được.
Dialogue: 0,0:18:48.01,0:18:51.81,Default,,0000,0000,0000,,Thế nhưng tôi {\i1}đã{\i0} tìm ra một thứ có khả năng khôi phục lại tính độc bản của mình...
Dialogue: 0,0:18:51.81,0:18:53.83,Default,,0000,0000,0000,,...sau khi toàn bộ thông tin đã bị đồng bộ hóa hoàn toàn.
Dialogue: 0,0:18:54.45,0:18:56.35,Default,,0000,0000,0000,,Và đó là thứ gì vậy?
Dialogue: 0,0:19:00.89,0:19:02.85,Default,,0000,0000,0000,,Lòng hiếu kỳ, tôi nghĩ vậy.
Dialogue: 0,0:19:04.26,0:19:07.71,Default,,0000,0000,0000,,Ồ, tôi hiểu rồi. Cô biết không, điều đó tôi chưa từng nghĩ tới.
Dialogue: 0,0:19:08.39,0:19:10.83,Default,,0000,0000,0000,,Não của tôi có lẽ đã bắt đầu bị xơ cứng mất rồi.
Dialogue: 0,0:19:12.50,0:19:14.46,Default,,0000,0000,0000,,Vậy thì chuyện gì sẽ xảy ra với tôi lúc này đây?
Dialogue: 0,0:19:15.10,0:19:19.59,Default,,0000,0000,0000,,Bắt giữ vì tội bắt cóc sao? Hay vì tội kích động hàng loạt các vụ khủng bố đồng thời?
Dialogue: 0,0:19:19.94,0:19:23.84,Default,,0000,0000,0000,,Chịu thôi. Chuyện cỏn con đó hoàn toàn nằm trong quyền định đoạt của ông ấy,
Dialogue: 0,0:19:23.84,0:19:25.60,Default,,0000,0000,0000,,sao cậu không thử hỏi thẳng ông ấy xem?
Dialogue: 0,0:19:27.75,0:19:29.30,Default,,0000,0000,0000,,Tôi đã đứng nghe hai người trò chuyện từ nãy tới giờ,
Dialogue: 0,0:19:29.68,0:19:33.34,Default,,0000,0000,0000,,thế nhưng nếu không có một thiết bị ghi nhớ ngoại vi hỗ trợ, tôi hoàn toàn không thể theo kịp cuộc đàm đạo của hai người.
Dialogue: 0,0:19:34.42,0:19:36.58,Default,,0000,0000,0000,,Cậu đã đọc hết toàn bộ số sách vở trong cái thư viện này chưa?
Dialogue: 0,0:19:37.36,0:19:38.82,Default,,0000,0000,0000,,Vẫn chưa đọc được nhiều đến mức đó đâu ạ.
Dialogue: 0,0:19:39.39,0:19:44.45,Default,,0000,0000,0000,,Để tôi giới thiệu với cậu. Đây là sếp của tôi, Daisuke Aramaki, Trưởng ban Đội 9.
Dialogue: 0,0:19:45.43,0:19:46.42,Default,,0000,0000,0000,,Rất hân hạnh được diện kiến ngài.
Dialogue: 0,0:19:47.87,0:19:52.44,Default,,0000,0000,0000,,Cậu định tiếp tục gắn bó với công việc tẻ nhạt là bảo tồn những ấn phẩm in ấn...
Dialogue: 0,0:19:52.44,0:19:56.13,Default,,0000,0000,0000,,...vốn ngày nay chỉ được xuất bản theo thói quen quán tính này mãi sao?
Dialogue: 0,0:19:57.51,0:19:59.64,Default,,0000,0000,0000,,Nếu như cháu được phép làm vậy ạ.
Dialogue: 0,0:20:00.01,0:20:03.18,Default,,0000,0000,0000,,Xét trên bình diện vụ án này, kết luận cuối cùng có lẽ sẽ được đưa ra...
Dialogue: 0,0:20:03.18,0:20:05.98,Default,,0000,0000,0000,,...rằng Gã Mặt Cười nguyên bản chưa từng tồn tại trên phương diện pháp lý.
Dialogue: 0,0:20:06.75,0:20:08.31,Default,,0000,0000,0000,,Vì vậy tôi có một lời đề nghị muốn gửi tới cậu.
Dialogue: 0,0:20:08.99,0:20:12.06,Default,,0000,0000,0000,,Cậu thấy sao? Cậu có muốn đem tài năng xuất chúng của một hacker ra cống hiến cho việc có ích...
Dialogue: 0,0:20:12.06,0:20:15.18,Default,,0000,0000,0000,,...và gia nhập Đội 9 với tư cách thành viên chính thức thứ chín của chúng tôi không?
Dialogue: 0,0:20:17.53,0:20:21.16,Default,,0000,0000,0000,,Thật là bất ngờ quá. Ngài đang có ý định chiêu mộ cháu sao?
Dialogue: 0,0:20:21.67,0:20:22.63,Default,,0000,0000,0000,,Chính xác là như vậy.
Dialogue: 0,0:20:23.57,0:20:24.97,Default,,0000,0000,0000,,Cháu chẳng biết phải nói gì nữa...
Dialogue: 0,0:20:25.90,0:20:30.27,Default,,0000,0000,0000,,Nghe {\i1}có vẻ{\i0} vô cùng thú vị đấy ạ, nhưng cháu nghĩ cháu xin phép được từ chối.
Dialogue: 0,0:20:30.84,0:20:33.94,Default,,0000,0000,0000,,Dù cháu rất tiếc phải thừa nhận điều này, nhưng cháu dở tệ môn bóng chày.
Dialogue: 0,0:20:43.59,0:20:46.25,Default,,0000,0000,0000,,Sếp bị từ chối thẳng thừng rồi kìa. Giờ sếp định tính sao?
Dialogue: 0,0:20:46.59,0:20:47.75,Default,,0000,0000,0000,,Chẳng tính sao cả.
Dialogue: 0,0:20:48.19,0:20:50.89,Default,,0000,0000,0000,,Đội 9 sẽ tiếp tục sứ mệnh là một tổ chức tấn công bài trừ tội phạm...
Dialogue: 0,0:20:51.23,0:20:54.25,Default,,0000,0000,0000,,...chừng nào cô và tôi vẫn muốn nó tiếp tục tồn tại như vậy.
Dialogue: 0,0:20:54.60,0:20:56.16,Default,,0000,0000,0000,,Chỉ có thế thôi.
Dialogue: 0,0:21:16.39,0:21:19.56,Default,,0000,0000,0000,,Thưa ngài Serano, cuối cùng cũng tới ngày mở màn phiên tòa rồi ạ.
Dialogue: 0,0:21:18.72,0:21:23.75,GitS Episode 26 Insert Lyrics,,0000,0000,0000,,Thiên thần cùng ác quỷ lượn quanh quanh tôi,\N{\c&H00FF00&}Angels and demons circle above me,
Dialogue: 0,0:21:19.56,0:21:20.52,Default,,0000,0000,0000,,Phải rồi.
Dialogue: 0,0:21:23.49,0:21:26.46,Default,,0000,0000,0000,,Giờ đây tôi cuối cùng cũng có thể giữ trọn lời hứa năm xưa với cậu ấy.
Dialogue: 0,0:21:24.46,0:21:29.29,GitS Episode 26 Insert Lyrics,,0000,0000,0000,,vượt muôn trùng chông gai hướng đến các vì sao.\N{\c&H00FF00&}through the thorns to the stars.
Dialogue: 0,0:21:29.83,0:21:35.03,GitS Episode 26 Insert Lyrics,,0000,0000,0000,,Chỉ những kẻ không nghe thấu tiếng gọi ấy...\N{\c&H00FF00&}Only those unable to perceive its call...
