Dialogue: 0,0:03:06.78,0:03:08.17,Default,,0000,0000,0000,,Tiến lên, tiến lên, mau!
Dialogue: 0,0:03:27.46,0:03:28.93,Default,,0000,0000,0000,,G2, đã vô hiệu hóa các mục tiêu!
Dialogue: 0,0:03:28.93,0:03:32.16,Default,,0000,0000,0000,,{\i1}G3, đã vô hiệu hóa mục tiêu.{\i0}\N{\i1}Chưa thể xác nhận tung tích xe tăng tư duy.{\i0}
Dialogue: 0,0:03:32.50,0:03:36.73,Default,,0000,0000,0000,,{\i1}G4, nhóm người tị nạn vũ trang ở đây cũng đã bị tiêu diệt.{\i0}\N{\i1}Vẫn chưa phát hiện sự hiện diện của xe tăng.{\i0}
Dialogue: 0,0:03:54.69,0:03:56.05,Default,,0000,0000,0000,,Đã xác nhận mục tiêu!
Dialogue: 0,0:03:56.32,0:03:58.42,Default,,0000,0000,0000,,Kẻ địch đã khóa tên lửa.
Dialogue: 0,0:03:58.46,0:03:59.69,Default,,0000,0000,0000,,Thằng khốn...
Dialogue: 0,0:03:59.69,0:04:04.10,Default,,0000,0000,0000,,{\i1}J1, nhịp tim của anh đang vượt ngưỡng bình thường.{\i0}\N{\i1}Anh có ổn không đấy?!{\i0}
Dialogue: 0,0:04:04.37,0:04:05.49,Default,,0000,0000,0000,,Im mồm đi, chết tiệt!
Dialogue: 0,0:04:05.90,0:04:09.80,Default,,0000,0000,0000,,Dù đây chỉ là đạn giả, nhưng ai mà giữ bình tĩnh nổi\Nkhi cái còi báo động chết tiệt đó cứ ré lên liên hồi chứ?!
Dialogue: 0,0:04:18.28,0:04:19.54,Default,,0000,0000,0000,,Mày tiêu đời rồi...
Dialogue: 0,0:04:34.73,0:04:37.39,Default,,0000,0000,0000,,J1, có chuyện gì thế?\NTim anh ngừng đập rồi.
Dialogue: 0,0:04:46.34,0:04:47.78,Default,,0000,0000,0000,,Có tình huống khẩn cấp.
Dialogue: 0,0:04:47.78,0:04:51.84,Default,,0000,0000,0000,,Phi công của J1 dường như đã chết trong buồng lái,\Nkhông rõ nguyên nhân.
Dialogue: 0,0:04:52.05,0:04:56.62,Default,,0000,0000,0000,,Máy bay đã tự động chuyển sang chế độ lái tự động của AI hỗ trợ...\NĐường bay đã được ổn định.
Dialogue: 0,0:04:56.62,0:04:58.28,Default,,0000,0000,0000,,Nguy cơ rơi máy bay bằng không.
Dialogue: 0,0:04:58.82,0:05:03.35,Default,,0000,0000,0000,,{\i1}HAW-01AV, hủy bỏ mã tác chiến I-S.{\i0}\N{\i1}Lập tức quay trở về tàu sân bay.{\i0}
Dialogue: 0,0:05:03.63,0:05:07.79,Default,,0000,0000,0000,,{\i1}Nhắc lại, hủy bỏ mã tác chiến I-S{\i0}\N{\i1}và lập tức quay về tàu sân bay ngay.{\i0}
Dialogue: 0,0:05:08.26,0:05:10.90,Default,,0000,0000,0000,,{\i1}Tất cả các đơn vị chú ý.{\i0}\N{\i1}Chúng ta có tình huống khẩn cấp.{\i0}
Dialogue: 0,0:05:10.90,0:05:12.50,Default,,0000,0000,0000,,{\i1}Đây không phải là diễn tập.{\i0}
Dialogue: 0,0:05:12.50,0:05:16.10,Default,,0000,0000,0000,,{\i1}Phi công của J-1 dường như đã tử vong trong buồng lái,{\i0}\N{\i1}không rõ nguyên nhân.{\i0}
Dialogue: 0,0:05:16.51,0:05:21.17,Default,,0000,0000,0000,,{\i1}Để đảm bảo an toàn, chúng tôi dỡ bỏ mã I-S.{\i0}\N{\i1}Bắt đầu hành động rút quân theo mã S-A.{\i0}
Dialogue: 0,0:05:21.48,0:05:24.74,Default,,0000,0000,0000,,{\i1}Nhắc lại, bắt đầu hành động rút quân{\i0}\N{\i1}theo mã S-A.{\i0}
Dialogue: 0,0:05:25.45,0:05:28.81,Default,,0000,0000,0000,,HA-01AV vẫn chưa dỡ bỏ\Nmã tác chiến I-S.
Dialogue: 0,0:05:29.32,0:05:32.48,Default,,0000,0000,0000,,Tín hiệu hỗ trợ sinh tồn của phi công\Nvẫn toàn bộ màu xanh.
Dialogue: 0,0:05:32.79,0:05:36.72,Default,,0000,0000,0000,,Chúng tôi phát hiện tim đã ngừng đập,\Nnhưng dường như AI đang phớt lờ...
Dialogue: 0,0:05:37.16,0:05:39.15,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...mệnh lệnh từ Trung tâm Chỉ huy bởi não điện tử{\i0}\N{\i1}của phi công vẫn đang hoạt động.{\i0}
Dialogue: 0,0:05:39.53,0:05:41.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Nó đang phân loại lệnh rút quân{\i0}\N{\i1}như một đòn tấn công từ bên ngoài,{\i0}
Dialogue: 0,0:05:41.36,0:05:44.69,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và đang ưu tiên hàng đầu cho việc bảo vệ phi công.{\i0}
Dialogue: 0,0:05:42.50,0:05:44.69,Default,,0000,0000,0000,,N-Này! Đám trực thăng Jigabachi kìa!
Dialogue: 0,0:06:01.40,0:06:04.22,GitS Signs B/W,,0000,0000,0000,,{\pos(960,813)}Cơ quan Phòng vệ
Dialogue: 0,0:06:10.83,0:06:12.05,Default,,0000,0000,0000,,Kubota!
Dialogue: 0,0:06:13.43,0:06:15.09,Default,,0000,0000,0000,,Aramaki...
Dialogue: 0,0:06:15.33,0:06:18.20,Default,,0000,0000,0000,,Vụ này đòi hỏi phải được xử lý ngay lập tức,\Ntôi cho là vậy.
Dialogue: 0,0:06:21.17,0:06:23.47,Default,,0000,0000,0000,,Chỉ cần có một tia khả năng\Nxảy ra hành vi phạm tội,
Dialogue: 0,0:06:23.67,0:06:26.94,Default,,0000,0000,0000,,là ông lại không kìm được\Nmà nhúng mũi vào, phải không?
Dialogue: 0,0:06:33.45,0:06:38.78,Default,,0000,0000,0000,,Trước mắt, chúng tôi đang thông báo với truyền thông rằng đây là một cuộc diễn tập\Nnhận tiếp dầu trên không cho các khí tài đang phát triển.
Dialogue: 0,0:06:39.19,0:06:43.85,Default,,0000,0000,0000,,Nhưng xem ra đây là cuộc diễn tập bắn đạn thật\Nquy mô lớn nhất từ trước đến nay...
Dialogue: 0,0:06:44.26,0:06:47.00,Default,,0000,0000,0000,,...vốn được tiến hành trong bí mật tuyệt đối suốt ba năm qua...
Dialogue: 0,0:06:47.00,0:06:51.23,Default,,0000,0000,0000,,...xuất phát từ chính sách tị nạn mới sắp được ban hành trong thời gian tới.
Dialogue: 0,0:06:51.53,0:06:54.54,Default,,0000,0000,0000,,Chiếc trực thăng đang gặp sự cố đó có phải là mẫu máy bay AI\Nđang làm dấy lên nghi vấn...
Dialogue: 0,0:06:54.54,0:06:58.34,Default,,0000,0000,0000,,...về khả năng thông đồng mờ ám do dính líu đến hiệp ước an ninh\Nvới Đế chế Hoa Kỳ không?
Dialogue: 0,0:06:58.51,0:07:00.60,Default,,0000,0000,0000,,Không, không phải chiếc đó.
Dialogue: 0,0:07:01.28,0:07:04.15,Default,,0000,0000,0000,,Lục quân Phòng vệ cũng e ngại những đòn công kích\Ntừ phía truyền thông đại chúng,
Dialogue: 0,0:07:04.15,0:07:07.84,Default,,0000,0000,0000,,nên họ dường như đang tham gia cuộc diễn tập...
Dialogue: 0,0:07:08.25,0:07:10.42,Default,,0000,0000,0000,,...bằng chính những cỗ máy tự phát triển của mình,\Nmang mật danh \"Jigabachi Cải tiến\",
Dialogue: 0,0:07:10.42,0:07:12.58,Default,,0000,0000,0000,,được nâng cấp bổ sung thêm\Nmột AI hỗ trợ.
Dialogue: 0,0:07:13.26,0:07:18.69,Default,,0000,0000,0000,,Họ cho rằng cái chết bất ngờ của viên phi công\Nchính là nguyên nhân dẫn đến vụ việc lần này.
Dialogue: 0,0:07:19.06,0:07:23.39,Default,,0000,0000,0000,,Ông không thấy tình hình diễn biến thế này\Nlà quá đáng ngờ để chỉ coi là một tai nạn thôi sao?
Dialogue: 0,0:07:24.17,0:07:25.56,Default,,0000,0000,0000,,Đúng là chẳng có chuyện gì qua mặt nổi ông cả,\Nphải không?
Dialogue: 0,0:07:26.33,0:07:29.86,Default,,0000,0000,0000,,Vậy người của ông đã đào bới ra được\Nnhững thông tin gì rồi?
Dialogue: 0,0:07:30.64,0:07:34.37,Default,,0000,0000,0000,,Phi công của chiếc trực thăng chống tăng\Nđược AI hỗ trợ...
Dialogue: 0,0:07:34.78,0:07:38.18,Default,,0000,0000,0000,,...đã mất ý thức trong lúc diễn tập bắn đạn thật\Nvào hồi 5 giờ 57 phút sáng.
Dialogue: 0,0:07:38.51,0:07:43.47,Default,,0000,0000,0000,,Sau đó, chiếc trực thăng tưởng chừng như đang được kiểm soát\Nan toàn dưới chế độ lái tự động của AI,
Dialogue: 0,0:07:43.99,0:07:47.08,Default,,0000,0000,0000,,lại phớt lờ mệnh lệnh hủy mã tác chiến\Ncủa Trung tâm Điều khiển...
Dialogue: 0,0:07:47.26,0:07:51.92,Default,,0000,0000,0000,,...rồi bay thẳng vào không phận bên trên\Nkhu tị nạn. Đó là lúc 6 giờ 03 phút sáng.
Dialogue: 0,0:07:52.33,0:07:56.63,Default,,0000,0000,0000,,Và sau đó, AI đã đồng thời xâm nhập hack vào hai chiếc trực thăng đồng đội...
Dialogue: 0,0:07:56.63,0:07:59.33,Default,,0000,0000,0000,,...cùng một máy bay chở dầu tiếp nhiên liệu trên không\Nngay trên boong tàu sân bay.
Dialogue: 0,0:07:59.60,0:08:03.33,Default,,0000,0000,0000,,Cả ba chiếc máy bay đã cất cánh\Nrời khỏi tàu sân bay lúc 6 giờ 12 phút sáng.
Dialogue: 0,0:08:03.91,0:08:07.47,Default,,0000,0000,0000,,Sau đó chúng hội quân trên bầu trời\Nkhu người tị nạn,
Dialogue: 0,0:08:07.84,0:08:11.95,Default,,0000,0000,0000,,và dường như hiện tại vẫn đang lượn vòng\Nbên trên tháp truyền hình.
Dialogue: 0,0:08:11.95,0:08:13.58,Default,,0000,0000,0000,,Về cơ bản,\Nông nắm hoàn toàn chính xác.
Dialogue: 0,0:08:13.58,0:08:19.89,Default,,0000,0000,0000,,Tôi cũng vừa nhận được tin báo chưa kiểm chứng rằng hai chiếc thuộc dòng đó\Ntừ đồn trú Awaji...
Dialogue: 0,0:08:19.89,0:08:24.79,Default,,0000,0000,0000,,...và ba chiếc từ đồn trú Wakayama\Nđã tự ý cất cánh bay đi dưới sự điều hướng qua mạng.
Dialogue: 0,0:08:25.06,0:08:26.69,Default,,0000,0000,0000,,Ông cũng đúng\Nở cả điểm đó nữa.
Dialogue: 0,0:08:27.63,0:08:30.62,Default,,0000,0000,0000,,Các căn cứ mà chúng tôi liên lạc\Nđã lập tức chuyển...
Dialogue: 0,0:08:30.70,0:08:34.47,Default,,0000,0000,0000,,...các AI trên dòng máy bay đó sang chế độ tự kỷ,
Dialogue: 0,0:08:34.47,0:08:40.00,Default,,0000,0000,0000,,nhưng căn cứ ở Itami lại phản ứng quá chậm chạp, và thêm hai chiếc nữa\Nđã bay mất hút như thể bám theo những chiếc kia.
Dialogue: 0,0:08:40.24,0:08:43.97,Default,,0000,0000,0000,,Khả năng đây là một vụ khủng bố mạng\Nnhắm thẳng vào các AI hỗ trợ là bao nhiêu?
Dialogue: 0,0:08:44.45,0:08:47.07,Default,,0000,0000,0000,,Bằng cách xuyên thủng cả hàng rào phòng thủ của quân đội sao?
Dialogue: 0,0:08:47.75,0:08:50.19,Default,,0000,0000,0000,,Cơ quan Tình báo cũng cho rằng vụ này có mùi khủng bố,\Nvà đã bắt đầu...
Dialogue: 0,0:08:50.19,0:08:56.02,Default,,0000,0000,0000,,...tạm giữ toàn bộ đội ngũ phát triển AI hỗ trợ\Nđể thẩm vấn,
Dialogue: 0,0:08:56.56,0:08:58.36,Default,,0000,0000,0000,,nhưng chúng tôi vẫn chưa\Ntìm ra được manh mối gì.
Dialogue: 0,0:08:58.36,0:09:01.89,Default,,0000,0000,0000,,Thế còn khả năng xảy ra một cuộc binh biến nổi dậy vũ trang\Ncủa phe phản loạn bên trong đơn vị thì sao?
Dialogue: 0,0:09:02.40,0:09:03.59,Default,,0000,0000,0000,,Tôi cũng không nghĩ điều đó\Ncó thể xảy ra.
Dialogue: 0,0:09:04.37,0:09:07.13,Default,,0000,0000,0000,,Tôi cũng không cho rằng chuyện này chịu bất kỳ ảnh hưởng nào\Ntừ những kẻ theo chủ nghĩa cá nhân đó.
Dialogue: 0,0:09:07.60,0:09:10.16,Default,,0000,0000,0000,,Ngược lại, điều nghi vấn lớn nhất mà chúng tôi có lúc này\Nlà khả năng đây là...
Dialogue: 0,0:09:10.47,0:09:14.58,Default,,0000,0000,0000,,...một đòn tấn công của vài thành viên từng gia nhập nhóm theo chủ nghĩa khoái lạc \"Stabat Mater\"...
Dialogue: 0,0:09:14.58,0:09:17.20,Default,,0000,0000,0000,,...những kẻ từng bị truyền thông điểm mặt chỉ tên\Nchỉ trích gay gắt dạo trước.
Dialogue: 0,0:09:17.58,0:09:19.14,Default,,0000,0000,0000,,Hướng đó cũng đi vào ngõ cụt rồi sao?
Dialogue: 0,0:09:20.75,0:09:25.98,Default,,0000,0000,0000,,Hiện tại, giới chóp bu đang sốt sắng muốn dàn xếp vụ việc\Ntheo hướng một \"tai nạn bất ngờ\".
Dialogue: 0,0:09:26.79,0:09:31.38,Default,,0000,0000,0000,,May mắn thay, tất cả những gì đám trực thăng đang làm\Nchỉ là bay lượn vòng tròn quanh tháp truyền hình.
Dialogue: 0,0:09:31.69,0:09:34.42,Default,,0000,0000,0000,,Tôi mong là chúng\Nsẽ chỉ dừng lại ở đó...
Dialogue: 0,0:09:34.86,0:09:37.16,Default,,0000,0000,0000,,Ý ông là\Nđám người tị nạn.
Dialogue: 0,0:09:39.83,0:09:41.67,Default,,0000,0000,0000,,{\i1}Thiếu tá, cô nghe rõ lời ông ấy rồi chứ...{\i0}
Dialogue: 0,0:09:42.44,0:09:45.90,Default,,0000,0000,0000,,{\i1}Những thông tin đó chẳng hơn được bao nhiêu so với{\i0}\N{\i1}những gì chúng ta đã tự mình điều tra được.{\i0}
Dialogue: 0,0:09:46.44,0:09:48.14,Default,,0000,0000,0000,,{\i1}Tuy nhiên, có vẻ như hiện trường đang được kiểm soát...{\i0}
Dialogue: 0,0:09:48.14,0:09:49.84,Default,,0000,0000,0000,,{\i1}...bởi các đội cảnh sát cơ động chống bạo động{\i0}\N{\i1}thuộc sở cảnh sát tỉnh.{\i0}
Dialogue: 0,0:09:50.15,0:09:53.65,Default,,0000,0000,0000,,{\i1}Họ không chỉ ngăn chặn những người tị nạn{\i0}\N{\i1}đang gây rối rải rác khắp nơi,{\i0}
Dialogue: 0,0:09:53.65,0:09:57.05,Default,,0000,0000,0000,,{\i1}mà còn chặn cả các đơn vị cơ giới của Lục quân Phòng vệ{\i0}\N{\i1}đang có mặt ở đây để giải quyết tình hình.{\i0}
Dialogue: 0,0:09:57.05,0:09:59.59,Default,,0000,0000,0000,,{\i1}Xem ra họ đang tuyên bố rằng chính họ mới là những người liều mình...{\i0}
Dialogue: 0,0:09:59.59,0:10:01.75,Default,,0000,0000,0000,,{\i1}...để duy trì quyền kiểm soát{\i0}\N{\i1}đối với khu lưu trú tị nạn.{\i0}
Dialogue: 0,0:10:01.99,0:10:04.36,Default,,0000,0000,0000,,{\i1}Thảm hại thật...{\i0}\N{\i1}Thế sự rồi sẽ đi về đâu đây?{\i0}
Dialogue: 0,0:10:04.56,0:10:07.93,Default,,0000,0000,0000,,{\i1}Trước mắt, tôi đang bảo Togusa và Ishikawa{\i0}\N{\i1}đến kiểm tra nhà riêng...{\i0}
Dialogue: 0,0:10:07.93,0:10:10.06,Default,,0000,0000,0000,,{\i1}...của viên phi công mà chúng ta cho rằng{\i0}\N{\i1}đã tử vong giữa không trung,{\i0}
Dialogue: 0,0:10:10.47,0:10:12.13,Default,,0000,0000,0000,,{\i1}nhưng Thiếu tá muốn những người còn lại{\i0}\N{\i1}phải làm gì đây?{\i0}
Dialogue: 0,0:10:12.50,0:10:15.23,Default,,0000,0000,0000,,{\i1}Chúng ta sắp đến{\i0}\N{\i1}khu tị nạn rồi.{\i0}
Dialogue: 0,0:10:15.54,0:10:17.77,Default,,0000,0000,0000,,{\i1}Cứ tiếp cận hiện trường{\i0}\N{\i1}và tạm thời giữ vị trí chờ lệnh.{\i0}
Dialogue: 0,0:10:17.77,0:10:20.07,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ chờ phán quyết cuối cùng của Thủ tướng...{\i0}
Dialogue: 0,0:10:20.28,0:10:22.37,Default,,0000,0000,0000,,{\i1}...về việc liệu sự cố này{\i0}\N{\i1}có thuộc thẩm quyền của chúng ta hay không.{\i0}
Dialogue: 0,0:10:22.64,0:10:23.67,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:10:24.48,0:10:27.45,Default,,0000,0000,0000,,Đừng tiết lộ bất cứ điều gì\Ntôi vừa nói với ông đấy.
Dialogue: 0,0:10:27.75,0:10:31.58,Default,,0000,0000,0000,,Chỉ riêng việc bị bắt gặp đi cùng ông như thế này\Ncũng đủ gây ra một vụ bê bối ầm ĩ rồi.
Dialogue: 0,0:10:32.75,0:10:36.59,Default,,0000,0000,0000,,Sao, ông vẫn chưa từ bỏ tham vọng\Nthăng quan tiến chức của mình à?
Dialogue: 0,0:10:37.06,0:10:40.62,Default,,0000,0000,0000,,Xin lỗi, nhưng tôi không thể sống cuộc đời\Ntheo cách của ông được.
Dialogue: 0,0:10:41.20,0:10:42.79,Default,,0000,0000,0000,,Tôi xin phép.
Dialogue: 0,0:10:47.87,0:10:50.67,Default,,0000,0000,0000,,Trưởng ban Aramaki của Đội 9,\Ntôi đoán không lầm chứ?
Dialogue: 0,0:10:55.24,0:10:58.65,Default,,0000,0000,0000,,Cơ quan Tình báo Nội các, Ủy ban Điều tra\NTác động Chiến lược.
Dialogue: 0,0:10:58.65,0:11:02.10,Default,,0000,0000,0000,,Trợ lý Đại diện,\NHitori Gohda...
Dialogue: 0,0:11:02.22,0:11:04.15,Default,,0000,0000,0000,,Kazundo Gohda.
Dialogue: 0,0:11:04.15,0:11:07.25,Default,,0000,0000,0000,,Hiếm khi tôi gặp được ai\Nđọc đúng tên mình.
Dialogue: 0,0:11:07.72,0:11:10.56,Default,,0000,0000,0000,,Mặc dù về mặt cá nhân, tôi không nghĩ\Nđó là một cái tên kỳ lạ đến thế.
Dialogue: 0,0:11:11.53,0:11:14.76,Default,,0000,0000,0000,,Nhưng giờ đây, tôi lại thấy nó là\Nmột cái tên tuyệt vời.
Dialogue: 0,0:11:15.10,0:11:19.43,Default,,0000,0000,0000,,Một khi tôi đã nói cho họ biết cách phát âm, nó có xu hướng\Nin sâu vào ký ức của mọi người, ông thấy đấy.
Dialogue: 0,0:11:19.77,0:11:22.29,Default,,0000,0000,0000,,Đặc biệt là khi kết hợp\Nvới gương mặt này.
Dialogue: 0,0:11:24.67,0:11:28.80,Default,,0000,0000,0000,,Vậy, có điều gì tôi có thể giúp cho cái Cơ quan\NTình báo Nội các này của các ông không?
Dialogue: 0,0:11:28.98,0:11:36.25,Default,,0000,0000,0000,,Có chứ. Chúng tôi muốn có sự hỗ trợ của Đội 9\Ntrong sự vụ hiện đang diễn ra.
Dialogue: 0,0:11:36.25,0:11:39.78,Default,,0000,0000,0000,,Dù biết có phần đường đột,\Nnhưng tôi đã đích thân đến gặp ông.
Dialogue: 0,0:11:44.33,0:11:50.63,Default,,0000,0000,0000,,Như ông đã biết, CIS là cơ quan hoạt động\Ntrực thuộc Chánh Văn phòng Nội các,
Dialogue: 0,0:11:50.63,0:11:53.80,Default,,0000,0000,0000,,tập trung vào việc thu thập, phân tích tình báo\Ntrong và ngoài nước,
Dialogue: 0,0:11:53.80,0:11:58.26,Default,,0000,0000,0000,,và đôi khi là thao túng định hướng\Ndư luận xã hội.
Dialogue: 0,0:11:58.81,0:12:03.87,Default,,0000,0000,0000,,Tôi sẽ rất cảm kích nếu ông coi đây là mệnh lệnh\Ntrực tiếp từ Chánh Văn phòng Nội các.
Dialogue: 0,0:12:04.68,0:12:07.75,Default,,0000,0000,0000,,Dù sao thì, với sở trường của Thủ tướng\Nlà quản lý khủng hoảng,
Dialogue: 0,0:12:07.75,0:12:10.84,Default,,0000,0000,0000,,chúng ta khó lòng mong đợi bà ấy\Nđưa ra một quyết định nhanh chóng được.
Dialogue: 0,0:12:42.98,0:12:45.65,Default,,0000,0000,0000,,Khả năng tiếp nhiên liệu của cỗ máy đó\Nlớn đến mức nào?
Dialogue: 0,0:12:46.22,0:12:50.32,Default,,0000,0000,0000,,Nếu họ chưa thay đổi thông số kỹ thuật cũ, nó mang đủ nhiên liệu để chạy một chiếc ô tô suốt sáu năm,
Dialogue: 0,0:12:50.63,0:12:55.43,Default,,0000,0000,0000,,hoặc đủ để giữ cho một cỗ máy ngốn xăng như Jigabachi\Nbay liên tục trong 10 tiếng đồng hồ.
Dialogue: 0,0:12:56.23,0:12:59.46,Default,,0000,0000,0000,,Chà, vì xem ra nó đang chia sẻ lượng nhiên liệu đó\Ncho tất cả đám trực thăng kia,
Dialogue: 0,0:13:00.07,0:13:03.70,Default,,0000,0000,0000,,tôi ước tính sơ bộ mỗi chiếc sẽ còn bay được\Nthêm khoảng một giờ nữa.
Dialogue: 0,0:13:05.31,0:13:09.44,Default,,0000,0000,0000,,Với thời gian bay tiêu chuẩn\N2,5 giờ của một chiếc Jigabachi,
Dialogue: 0,0:13:09.74,0:13:14.08,Default,,0000,0000,0000,,tôi đoán chúng ta có thể giả định rằng chúng chỉ còn\Nchưa đầy một giờ bay nữa thôi.
Dialogue: 0,0:13:15.15,0:13:18.05,Default,,0000,0000,0000,,Khả năng chiếc máy bay chở dầu đó\Nbị rơi trước là bao nhiêu?
Dialogue: 0,0:13:18.39,0:13:21.65,Default,,0000,0000,0000,,Hoàn toàn không có đâu. Chiếc Hanamuguri đó\Nsẽ là chiếc rơi xuống cuối cùng.
Dialogue: 0,0:13:22.19,0:13:24.72,Default,,0000,0000,0000,,Nó đang ngày càng nhẹ đi\Ntrong quá trình bay, cậu hiểu không?
Dialogue: 0,0:13:25.03,0:13:27.26,Default,,0000,0000,0000,,Điều đó có nghĩa là thời gian bay của nó\Nsẽ ngày càng kéo dài hơn.
Dialogue: 0,0:13:27.83,0:13:32.73,Default,,0000,0000,0000,,Này anh Batou... Đám đó cũng là AI\Ngiống như chúng em đúng không ạ?
Dialogue: 0,0:13:34.77,0:13:37.67,Default,,0000,0000,0000,,Thì theo những gì tôi nghe được, người ta thiết kế chúng dựa trên giả định\Nsẽ có con người ngồi lái,
Dialogue: 0,0:13:37.74,0:13:39.87,Default,,0000,0000,0000,,nên chúng chỉ là\NAI hỗ trợ mà thôi.
Dialogue: 0,0:13:40.24,0:13:42.01,Default,,0000,0000,0000,,Dù vậy, bây giờ chúng\Nkhông có người lái,
Dialogue: 0,0:13:42.01,0:13:44.41,Default,,0000,0000,0000,,nghĩa là chúng đang tự suy nghĩ\Nvà tự bay, đúng không ạ?
Dialogue: 0,0:13:45.15,0:13:49.38,Default,,0000,0000,0000,,Chắc là chúng thực sự không thể chịu đựng nổi\Nđiều kiện làm việc của mình...
Dialogue: 0,0:13:50.52,0:13:53.32,Default,,0000,0000,0000,,Điều kiện làm việc trong quân đội\Nthực sự tệ đến thế sao?
Dialogue: 0,0:13:53.55,0:13:56.39,Default,,0000,0000,0000,,Em thề đấy, đám AI mà dở chứng\Nlà nổi loạn nhanh khủng khiếp luôn!
Dialogue: 0,0:13:57.16,0:14:01.65,Default,,0000,0000,0000,,Vậy chúng em sẽ phải chiến đấu với đám đó\Nnếu có lệnh sao ạ?
Dialogue: 0,0:14:02.03,0:14:03.36,Default,,0000,0000,0000,,Đúng là như vậy.
Dialogue: 0,0:14:03.90,0:14:07.80,Default,,0000,0000,0000,,Chúng là trực thăng chống tăng, nên chắc\Nchúng là kẻ thù tự nhiên của chúng ta rồi, nhỉ?
Dialogue: 0,0:14:10.54,0:14:11.94,Default,,0000,0000,0000,,Anh Batou, anh Batou ơi!
Dialogue: 0,0:14:12.47,0:14:13.14,Default,,0000,0000,0000,,Gì thế?
Dialogue: 0,0:14:13.14,0:14:16.60,Default,,0000,0000,0000,,Bọn em bị đau bụng rồi,\Nbọn em về nhà được không ạ?
Dialogue: 0,0:14:17.01,0:14:19.00,Default,,0000,0000,0000,,Bụng á?\NBụng {\i1}nào{\i0} cơ?!
Dialogue: 0,0:14:25.85,0:14:28.55,Default,,0000,0000,0000,,Xem ra Lục quân Phòng vệ\Nđã tiến lại quá gần...
Dialogue: 0,0:14:29.82,0:14:32.49,Default,,0000,0000,0000,,Chắc họ đã cố lặn vào các AI hỗ trợ\Nvà làm hỏng bét nhiệm vụ rồi.
Dialogue: 0,0:14:38.57,0:14:42.83,Default,,0000,0000,0000,,Mấy tay phi công của Lục quân Phòng vệ này\Nchắc kiếm chẳng được bao nhiêu tiền đâu nhỉ.
Dialogue: 0,0:15:22.84,0:15:25.65,Default,,0000,0000,0000,,Trưởng ban?!\NChuyện gì đang xảy ra thế này?
Dialogue: 0,0:15:25.65,0:15:27.61,Default,,0000,0000,0000,,Sao đích thân ông lại ra tận hiện trường thế này?
Dialogue: 0,0:15:27.98,0:15:30.95,Default,,0000,0000,0000,,Thế này có nghĩa là Thủ tướng\Nvẫn đang siết chặt xích cổ ông sao?
Dialogue: 0,0:15:32.39,0:15:34.72,Default,,0000,0000,0000,,Để tôi giải thích cho cô,\Nthưa Thiếu tá.
Dialogue: 0,0:15:34.72,0:15:37.59,Default,,0000,0000,0000,,Đây là đặc vụ của\NCơ quan Tình báo Nội các.
Dialogue: 0,0:15:37.59,0:15:40.89,Default,,0000,0000,0000,,Gohda, Ủy ban Điều tra\NTác động Chiến lược.
Dialogue: 0,0:15:41.20,0:15:42.86,Default,,0000,0000,0000,,Tôi xin phép đi thẳng\Nvào vấn đề.
Dialogue: 0,0:15:42.86,0:15:46.40,Default,,0000,0000,0000,,Toàn bộ quyền chỉ huy tại hiện trường\Nchính thức được chuyển giao...
Dialogue: 0,0:15:46.40,0:15:50.89,Default,,0000,0000,0000,,...cho Đội 9 với mục tiêu\Ngiải quyết dứt điểm tình huống này.
Dialogue: 0,0:15:51.31,0:15:57.07,Default,,0000,0000,0000,,Tuy nhiên, tôi muốn các cậu thực hiện chiến dịch\Ntheo đúng chỉ dẫn của ông ta.
Dialogue: 0,0:15:57.28,0:15:58.97,Default,,0000,0000,0000,,Ông già,\Nông nghiêm túc đấy à?!
Dialogue: 0,0:15:59.28,0:16:04.05,Default,,0000,0000,0000,,Chúng tôi gắn bó với Đội 9 đâu phải để trở thành\Nlũ chó săn tay sai cho chính phủ.
Dialogue: 0,0:16:04.89,0:16:06.62,Default,,0000,0000,0000,,Theo tính toán\Ncủa chúng tôi,
Dialogue: 0,0:16:06.62,0:16:11.42,Default,,0000,0000,0000,,chiếc trực thăng đầu tiên sẽ đâm xuống khu tị nạn\Ntrong vòng 48 phút nữa.
Dialogue: 0,0:16:11.76,0:16:14.30,Default,,0000,0000,0000,,Một khi điều đó xảy ra,\Nsẽ không còn đường lui đâu.
Dialogue: 0,0:16:14.30,0:16:18.46,Default,,0000,0000,0000,,Đây rõ ràng đã là một vụ khủng bố rành rành rồi.\NCác người định tính sao đây?
Dialogue: 0,0:16:19.27,0:16:22.40,Default,,0000,0000,0000,,Được rồi, chúng tôi sẽ lắng nghe.\NKế hoạch của ông là gì?
Dialogue: 0,0:16:23.20,0:16:25.20,Default,,0000,0000,0000,,Tôi rất mừng vì cô có cùng\Ngóc nhìn với tôi.
Dialogue: 0,0:16:26.87,0:16:31.15,Default,,0000,0000,0000,,{\i1}Thiếu tá, ngay cả khi cho rằng chúng ta có thể{\i0}\N{\i1}tin tưởng vào mọi lời gã đó nói,{\i0}
Dialogue: 0,0:16:31.15,0:16:32.64,Default,,0000,0000,0000,,{\i1}tại sao cô lại đồng ý{\i0}\N{\i1}với chuyện này chứ?{\i0}
Dialogue: 0,0:16:33.15,0:16:37.91,Default,,0000,0000,0000,,{\i1}Ngay cả khi tạm thời giả định cái chết của phi công{\i0}\N{\i1}và sự mất kiểm soát của AI không phải khủng bố,{\i0}
Dialogue: 0,0:16:38.32,0:16:42.31,Default,,0000,0000,0000,,{\i1}thì nếu thứ đó rơi xuống, nó sẽ gây ra{\i0}\N{\i1}thiệt hại nặng nề cho khu vực này.{\i0}
Dialogue: 0,0:16:42.82,0:16:47.69,Default,,0000,0000,0000,,{\i1}Khi điều đó xảy ra, tình hình người tị nạn{\i0}\N{\i1}có thể biến thành một thùng thuốc súng phát nổ.{\i0}
Dialogue: 0,0:16:48.36,0:16:52.32,Default,,0000,0000,0000,,{\i1}Vả lại, không có thông tin của ông ta,{\i0}\N{\i1}chúng ta chẳng có quân bài nào trong tay để hành động cả.{\i0}
Dialogue: 0,0:16:52.90,0:16:56.63,Default,,0000,0000,0000,,{\i1}Ý tôi là, tôi cần phải biết{\i0}\N{\i1}lập trường của chúng ta ở đâu trong...{\i0}
Dialogue: 0,0:16:57.61,0:16:58.80,Default,,0000,0000,0000,,{\i1}Thôi, bỏ đi.{\i0}
Dialogue: 0,0:17:01.21,0:17:02.84,Default,,0000,0000,0000,,{\i1}Saito, cậu sẵn sàng chưa?{\i0}
Dialogue: 0,0:17:03.58,0:17:04.58,Default,,0000,0000,0000,,{\i1}Tôi đã sẵn sàng.{\i0}
Dialogue: 0,0:17:04.58,0:17:05.67,Default,,0000,0000,0000,,{\i1}Tốt.{\i0}
Dialogue: 0,0:17:18.86,0:17:22.33,Default,,0000,0000,0000,,Xem ra chúng sẽ tấn công bừa bãi\Nvào bất cứ thứ gì chuyển động...
Dialogue: 0,0:17:22.33,0:17:23.46,Default,,0000,0000,0000,,{\i1}Hành động thôi!{\i0}
Dialogue: 0,0:17:36.94,0:17:38.14,Default,,0000,0000,0000,,{\i1}Được rồi, lên nào!{\i0}
Dialogue: 0,0:17:50.93,0:17:52.22,Default,,0000,0000,0000,,Chúng đang tới kìa!
Dialogue: 0,0:18:00.37,0:18:01.77,Default,,0000,0000,0000,,{\i1}Đừng hạ thấp xuống{\i0}\N{\i1}mặt đất.{\i0}
Dialogue: 0,0:18:02.67,0:18:05.20,Default,,0000,0000,0000,,{\i1}Các cậu sẽ không né nổi tên lửa không đối đất của chúng{\i0}\N{\i1}nếu bị khóa mục tiêu đâu.{\i0}
Dialogue: 0,0:18:28.93,0:18:30.40,Default,,0000,0000,0000,,{\i1}Tỷ lệ cược này{\i0}\N{\i1}chẳng cân sức chút nào.{\i0}
Dialogue: 0,0:18:30.40,0:18:33.33,Default,,0000,0000,0000,,Hai chọi một, và chúng đã nắm chắc\Nlợi thế tuyệt đối về hỏa lực rồi.
Dialogue: 0,0:18:45.25,0:18:47.68,Default,,0000,0000,0000,,{\i1}Tốt lắm, đúng hệt như{\i0}\N{\i1}những gì ông ta nói.{\i0}
Dialogue: 0,0:18:48.12,0:18:50.99,Default,,0000,0000,0000,,{\i1}Batou, mục tiêu đang bám đuôi{\i0}\N{\i1}ngay sát phía sau tôi.{\i0}
Dialogue: 0,0:18:50.99,0:18:52.18,Default,,0000,0000,0000,,{\i1}Nhường lại cho anh đấy!{\i0}
Dialogue: 0,0:19:10.50,0:19:11.71,Default,,0000,0000,0000,,{\i1}Đã bắt được mục tiêu.{\i0}
Dialogue: 0,0:19:11.71,0:19:15.61,Default,,0000,0000,0000,,{\i1}Thiếu tá, hãy làm cho mục tiêu ngửa đầu lên một giây{\i0}\N{\i1}khi nó bay lướt qua trước mặt tôi.{\i0}
Dialogue: 0,0:19:15.84,0:19:18.28,Default,,0000,0000,0000,,{\i1}Tôi muốn bắn một phát xuyên qua nắp buồng lái{\i0}\N{\i1}từ bên sườn...{\i0}
Dialogue: 0,0:19:18.28,0:19:20.45,Default,,0000,0000,0000,,{\i1}...để hạ gục phi công{\i0}\N{\i1}mà không phá hủy AI.{\i0}
Dialogue: 0,0:19:20.45,0:19:21.54,Default,,0000,0000,0000,,{\i1}Rõ rồi!{\i0}
Dialogue: 0,0:19:55.68,0:19:56.84,Default,,0000,0000,0000,,Tachikoma!
Dialogue: 0,0:20:42.46,0:20:45.56,Default,,0000,0000,0000,,Nó đã chấp nhận lệnh hủy mã tác chiến\Ntừ Trung tâm Điều khiển rồi, hả?
Dialogue: 0,0:20:56.24,0:20:58.80,Default,,0000,0000,0000,,Tôi rất vui vì những dự đoán của chúng ta\Nđã được chứng minh là chính xác.
Dialogue: 0,0:20:59.05,0:21:03.05,Default,,0000,0000,0000,,Chúng tôi tin rằng nếu tín hiệu từ não điện tử\Ncủa viên phi công đã chết bị cắt đứt,
Dialogue: 0,0:21:03.05,0:21:07.54,Default,,0000,0000,0000,,AI hỗ trợ sẽ chấp nhận\Nmã lệnh từ Trung tâm Điều khiển.
Dialogue: 0,0:21:07.92,0:21:12.29,Default,,0000,0000,0000,,Ngoài ra, phán đoán của tôi cũng hoàn toàn chuẩn xác\Nkhi tìm đến sự trợ giúp của các người trong sự vụ lần này.
Dialogue: 0,0:21:12.63,0:21:15.13,Default,,0000,0000,0000,,Nhờ có các người, giới chức Phòng vệ\Nsẽ không phải...
Dialogue: 0,0:21:15.13,0:21:17.80,Default,,0000,0000,0000,,...chịu nỗi nhục nhã vì phải tự tay bắn hạ\Nchính đồng đội của mình, các người thấy đấy.
Dialogue: 0,0:21:17.80,0:21:22.39,Default,,0000,0000,0000,,Ý ông là sao hả? Rằng việc ép Saito của chúng tôi\Nphải làm điều đó thì chẳng khiến ông bận tâm chút nào sao?!
Dialogue: 0,0:21:23.14,0:21:25.80,Default,,0000,0000,0000,,Batou. Không sao đâu,\Ntôi quen rồi.
Dialogue: 0,0:21:35.55,0:21:37.07,Default,,0000,0000,0000,,Làm tốt lắm,\Nmọi người.
Dialogue: 0,0:21:37.45,0:21:41.44,Default,,0000,0000,0000,,Báo cáo cho biết toàn bộ 11 chiếc đã được xác nhận\Nquay trở về căn cứ an toàn.
Dialogue: 0,0:21:41.76,0:21:44.55,Default,,0000,0000,0000,,Cô đã nghe báo cáo\Ntừ Togusa chưa?
Dialogue: 0,0:21:44.83,0:21:45.72,Default,,0000,0000,0000,,Chưa.
Dialogue: 0,0:21:45.93,0:21:50.36,Default,,0000,0000,0000,,Cậu ấy bảo đã tìm thấy thuốc trợ tim\Ntại nhà riêng của viên phi công.
Dialogue: 0,0:21:50.83,0:21:54.20,Default,,0000,0000,0000,,Tôi đoán anh ta đã giấu giếm\Nbệnh tình với cấp trên của mình.
Dialogue: 0,0:21:54.20,0:21:57.37,Default,,0000,0000,0000,,Vậy ý cô là vụ này không phải khủng bố\Nnhư lời Gohda nói,
Dialogue: 0,0:21:57.37,0:21:59.50,Default,,0000,0000,0000,,mà đúng hơn chỉ là một tai nạn hy hữu thôi sao,\NThiếu tá?
Dialogue: 0,0:22:00.07,0:22:01.48,Default,,0000,0000,0000,,Tôi không chắc chắn.
Dialogue: 0,0:22:01.48,0:22:04.98,Default,,0000,0000,0000,,Không có cách nào để biết chắc chắn nếu không tiến hành phân tích cấu trúc...
Dialogue: 0,0:22:04.98,0:22:09.42,Default,,0000,0000,0000,,...trên cả loại thuốc tìm thấy\Nvà máu của viên phi công đã chết.
Dialogue: 0,0:22:10.89,0:22:15.82,Default,,0000,0000,0000,,Cơ quan Tình báo Nội các xuất hiện với thời điểm\Nnhư thể họ đã biết trước mọi chuyện từ đầu...
Dialogue: 0,0:22:16.26,0:22:21.53,Default,,0000,0000,0000,,Và những chiếc trực thăng của Lục quân Phòng vệ lại lượn vòng\Ntrên đầu người tị nạn,
Dialogue: 0,0:22:21.53,0:22:26.99,Default,,0000,0000,0000,,khiêu khích chọc giận họ một cách không cần thiết,\Nnhư thể đó vốn là chủ đích ban đầu của chúng...
Dialogue: 0,0:22:27.40,0:22:29.53,Default,,0000,0000,0000,,Tất cả những điều này rốt cuộc có ý nghĩa gì,\Ntôi tự hỏi?
Dialogue: 0,0:22:30.27,0:22:36.87,Default,,0000,0000,0000,,Rất có thể một tội ác với quy mô khổng lồ\Nđang bắt đầu mở màn ở một nơi nào đó mà chúng ta chưa thể nhìn thấy.
