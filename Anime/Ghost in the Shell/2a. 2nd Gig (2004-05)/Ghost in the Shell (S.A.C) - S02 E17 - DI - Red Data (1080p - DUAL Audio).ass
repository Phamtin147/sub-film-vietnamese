Dialogue: 0,0:01:40.06,0:01:43.52,Default,,0000,0000,0000,,Những người này thật sự phấn khích đến thế\Nkhi được chụp ảnh cùng người đàn ông này sao?
Dialogue: 0,0:01:44.36,0:01:46.56,Default,,0000,0000,0000,,Trông ai nấy\Nđều rất hạnh phúc.
Dialogue: 0,0:01:46.83,0:01:50.60,Default,,0000,0000,0000,,Phải. Chữ Hán trong tên anh ta có nghĩa là \"anh hùng\",\Nvà có vẻ đối với họ anh ta đúng là như thế.
Dialogue: 0,0:01:51.34,0:01:55.83,Default,,0000,0000,0000,,Dĩ nhiên, ở đây người ta gọi anh ta là \"Roh\",\Nchứ không phải Hideo Kuze.
Dialogue: 0,0:01:56.54,0:01:57.57,Default,,0000,0000,0000,,\"Roh\" ư?
Dialogue: 0,0:01:57.88,0:02:00.61,Default,,0000,0000,0000,,Anh ta có thể tàn nhẫn và hung bạo như một con sói,\Nviết bằng chữ \"Lang\",
Dialogue: 0,0:02:00.71,0:02:03.58,Default,,0000,0000,0000,,nhưng cũng có thể tĩnh lặng và rạng rỡ\Nnhư một ngày nắng đẹp, viết bằng chữ \"Lãng\".
Dialogue: 0,0:02:04.02,0:02:07.18,Default,,0000,0000,0000,,Và vì anh ta còn giống như một lãng khách,\Nmột kẻ có thể...
Dialogue: 0,0:02:07.42,0:02:09.39,Default,,0000,0000,0000,,...bất chợt phiêu bạt\Nvà biến mất bất cứ lúc nào,
Dialogue: 0,0:02:09.49,0:02:11.86,Default,,0000,0000,0000,,nên những người tị nạn\Nđã bắt đầu gọi anh ta là Roh.
Dialogue: 0,0:02:40.42,0:02:43.45,Default,,0000,0000,0000,,Chỉ mới gần đây giới chức Đài Loan...
Dialogue: 0,0:02:43.69,0:02:45.66,Default,,0000,0000,0000,,...mới nhận thức được\Nsự tồn tại của người đàn ông này.
Dialogue: 0,0:02:45.99,0:02:48.43,Default,,0000,0000,0000,,Những lời đồn kỳ lạ bắt đầu râm ran\Nsau khi người tị nạn...
Dialogue: 0,0:02:48.53,0:02:52.59,Default,,0000,0000,0000,,...đạt được thỏa thuận với giới yakuza địa phương\Nvà bắt đầu tự do đi lại trên đường phố.
Dialogue: 0,0:02:53.10,0:02:56.07,Default,,0000,0000,0000,,\"Có một người đàn ông lãnh đạo dân tị nạn,\Ntrông tựa như một bậc thủ lĩnh.\"
Dialogue: 0,0:02:56.50,0:02:58.20,Default,,0000,0000,0000,,Ban đầu, những lời đồn đại\Nđại loại là như thế.
Dialogue: 0,0:02:58.34,0:03:02.36,Default,,0000,0000,0000,,Nhưng chẳng mấy chốc, chúng tôi bắt đầu thấy\Ndân tị nạn buôn lậu hàng cấm...
Dialogue: 0,0:03:02.48,0:03:06.28,Default,,0000,0000,0000,,...và thường xuyên xảy ra tranh chấp địa bàn\Ngiữa họ với yakuza địa phương.
Dialogue: 0,0:03:06.71,0:03:11.12,Default,,0000,0000,0000,,Chúng tôi buộc phải điều tra làm rõ\Nsự thật đằng sau những lời đồn đó.
Dialogue: 0,0:03:11.75,0:03:14.28,Default,,0000,0000,0000,,Và đó là lúc các anh\Nphát hiện ra Kuze.
Dialogue: 0,0:03:14.92,0:03:19.76,Default,,0000,0000,0000,,Lúc đầu, chúng tôi mừng vì đám tị nạn\Nđã chịu ngừng gây rối,
Dialogue: 0,0:03:20.39,0:03:22.36,Default,,0000,0000,0000,,nhưng giờ thì chuyện này lại biến thành\Nmột mớ rắc rối đau đầu.
Dialogue: 0,0:03:23.26,0:03:26.79,Default,,0000,0000,0000,,Mới gần đây thôi, bọn họ chẳng qua\Nchỉ là những thuyền nhân tị nạn,
Dialogue: 0,0:03:27.13,0:03:28.86,Default,,0000,0000,0000,,thế nhưng hoạt động làm ăn\Ncủa họ trên bộ,
Dialogue: 0,0:03:28.97,0:03:31.37,Default,,0000,0000,0000,,chưa kể đến những phương thức họ sử dụng\Ntrong các cuộc đụng độ với yakuza,
Dialogue: 0,0:03:31.47,0:03:34.24,Default,,0000,0000,0000,,đột nhiên trở nên tinh vi hơn\Nrất nhiều lần.
Dialogue: 0,0:03:34.81,0:03:38.50,Default,,0000,0000,0000,,Nếu người đàn ông này thực sự\Nlà nguyên nhân của mọi chuyện,
Dialogue: 0,0:03:38.85,0:03:41.47,Default,,0000,0000,0000,,thì tôi phải thừa nhận rằng\Nhắn ta quả thực là một kẻ ghê gớm.
Dialogue: 0,0:03:41.81,0:03:44.81,Default,,0000,0000,0000,,Anh ta cũng là người thiết lập\Nđường dây buôn lậu C4 sao?
Dialogue: 0,0:03:45.25,0:03:48.71,Default,,0000,0000,0000,,Phải, chiêu bài ưa thích dạo này\Ncủa người tị nạn...
Dialogue: 0,0:03:49.06,0:03:51.96,Default,,0000,0000,0000,,...là dùng tàu đánh cá hoán cải\Nđể thực hiện các vụ cướp biển.
Dialogue: 0,0:03:52.76,0:03:58.03,Default,,0000,0000,0000,,Dù sao thì, cuộc sống của chúng tôi cũng dễ thở hơn nhiều\Nkhi Roh đã biết điều mà rời khỏi Đài Loan.
Dialogue: 0,0:03:58.97,0:04:01.70,Default,,0000,0000,0000,,Có điều tôi chẳng hề ghen tị với bên An ninh Công cộng\Ncác cô ở Nhật Bản chút nào đâu.
Dialogue: 0,0:04:02.24,0:04:04.80,Default,,0000,0000,0000,,Anh có biết tại sao\NKuze lại rời khỏi đây không?
Dialogue: 0,0:04:10.81,0:04:11.87,Default,,0000,0000,0000,,Chịu thôi.
Dialogue: 0,0:04:12.21,0:04:15.41,Default,,0000,0000,0000,,Giang hồ đồn rằng anh ta\Nphải quay về Nhật Bản...
Dialogue: 0,0:04:15.52,0:04:18.42,Default,,0000,0000,0000,,...để bảo trì và tu sửa lại\Ncơ thể giả của mình.
Dialogue: 0,0:04:18.95,0:04:20.89,Default,,0000,0000,0000,,Nhưng chuyện đó có thật hay không\Nthì...
Dialogue: 0,0:04:23.26,0:04:25.22,Default,,0000,0000,0000,,Tôi đoán điều đó khá trùng khớp\Nvới những gì chúng tôi nắm được.
Dialogue: 0,0:04:25.69,0:04:27.56,Default,,0000,0000,0000,,Cảm ơn anh.\NAnh đã giúp tôi rất nhiều.
Dialogue: 0,0:04:27.66,0:04:28.96,Default,,0000,0000,0000,,Không có chi.
Dialogue: 0,0:04:29.56,0:04:32.40,Default,,0000,0000,0000,,À, còn một chuyện nữa.\NVề vé máy bay khứ hồi của cô...
Dialogue: 0,0:04:32.73,0:04:34.76,Default,,0000,0000,0000,,Tôi rất tiếc, nhưng tôi không thể đặt vé\Ncho cô trên chuyến bay hôm nay được.
Dialogue: 0,0:04:35.13,0:04:36.12,Default,,0000,0000,0000,,Phải đợi đến mai sao?
Dialogue: 0,0:04:36.24,0:04:39.30,Default,,0000,0000,0000,,Chắc cô cũng biết rồi, Hiệp ước An ninh Mỹ - Nhật\Nvừa được ký kết xong...
Dialogue: 0,0:04:39.41,0:04:41.93,Default,,0000,0000,0000,,...đúng vào lúc quan hệ với Trung Quốc đại lục\Ncuối cùng cũng được bình thường hóa.
Dialogue: 0,0:04:42.48,0:04:47.17,Default,,0000,0000,0000,,Không lạ gì khi liên tiếp xảy ra\Nhàng loạt sự cố rắc rối.
Dialogue: 0,0:04:48.08,0:04:52.14,Default,,0000,0000,0000,,Việc điều phối lịch bay quốc tế\Ngần như bị tê liệt hoàn toàn.
Dialogue: 0,0:04:53.02,0:04:58.36,Default,,0000,0000,0000,,Nói cách khác, anh đã khéo léo thu xếp cho một nhân viên Cục An ninh bận rộn có chút thời gian nghỉ ngơi nhỉ?
Dialogue: 0,0:04:59.09,0:05:01.53,Default,,0000,0000,0000,,Hãy dành trọn ngày hôm nay\Nđể đi vãn cảnh ngắm phố phường đi.
Dialogue: 0,0:05:01.99,0:05:03.72,Default,,0000,0000,0000,,Cảm ơn, chắc tôi\Nsẽ làm thế.
Dialogue: 0,0:05:04.06,0:05:08.23,Default,,0000,0000,0000,,Nhưng đừng dại dột mà một mình lang thang\Nvào khu ổ chuột của người tị nạn đấy nhé.
Dialogue: 0,0:05:09.10,0:05:11.59,Default,,0000,0000,0000,,Ở cái thành phố này không còn thông tin nào\Nvề hắn nữa đâu.
Dialogue: 0,0:05:12.07,0:05:13.37,Default,,0000,0000,0000,,Nếu cô muốn đào sâu hơn nữa,
Dialogue: 0,0:05:13.47,0:05:15.94,Default,,0000,0000,0000,,cô sẽ phải sang Trung Quốc đại lục\Nrồi đi về phía tây.
Dialogue: 0,0:05:16.44,0:05:19.47,Default,,0000,0000,0000,,Nghe đồn có ảnh của hắn ở các khu tị nạn\Ntrên khắp đất nước...
Dialogue: 0,0:05:19.71,0:05:22.34,Default,,0000,0000,0000,,...cho thấy hắn được người tị nạn\Nđón rước như một vị thần.
Dialogue: 0,0:05:22.98,0:05:26.65,Default,,0000,0000,0000,,Dù sao thì hắn cũng đâu phải tội phạm\Nbị truy nã quốc tế,
Dialogue: 0,0:05:26.99,0:05:30.15,Default,,0000,0000,0000,,nên tôi đoán chưa ai thực sự\Nxác nhận điều đó cả.
Dialogue: 0,0:05:41.30,0:05:42.73,Default,,0000,0000,0000,,{\i1}Chuyện này chẳng hợp lý chút nào...{\i0}
Dialogue: 0,0:05:43.20,0:05:46.90,Default,,0000,0000,0000,,{\i1}Mình nghĩ bộ não điện tử trung tâm xuất hiện{\i0}\N{\i1}ở Nagasaki chính là Kuze,{\i0}
Dialogue: 0,0:05:47.07,0:05:51.48,Default,,0000,0000,0000,,{\i1}nhưng hầu hết người tị nạn ở đây, đặc biệt là trẻ em{\i0}\N{\i1}và người già, đều chưa hề được cơ khí hóa não bộ.{\i0}
Dialogue: 0,0:05:52.14,0:05:56.44,Default,,0000,0000,0000,,{\i1}Nếu vậy, làm thế nào anh ta có thể{\i0}\N{\i1}đồng bộ hóa tư tưởng với họ được chứ?{\i0}
Dialogue: 0,0:05:59.55,0:06:01.82,Default,,0000,0000,0000,,Để tao làm việc\Ncủa tao đi!
Dialogue: 0,0:06:02.05,0:06:03.75,Default,,0000,0000,0000,,Tao đang cố làm ăn sòng phẳng\Nở đây cơ mà, đúng không?!
Dialogue: 0,0:06:08.96,0:06:11.76,Default,,0000,0000,0000,,{\i1}Bọn chúng thậm chí còn tàn nhẫn{\i0}\N{\i1}với cả trẻ con...{\i0}
Dialogue: 0,0:06:13.57,0:06:17.73,Default,,0000,0000,0000,,Người ta không gọi việc trả lại đồ ăn trộm\Ncho chủ nhân là \"làm ăn\" đâu ranh con!
Dialogue: 0,0:06:18.17,0:06:19.90,Default,,0000,0000,0000,,Khai mau!\NHàng giấu ở đâu hả?!
Dialogue: 0,0:06:22.24,0:06:23.44,Default,,0000,0000,0000,,Hàng ở đâu?!
Dialogue: 0,0:06:27.45,0:06:28.81,Default,,0000,0000,0000,,Cái thằng nhãi ranh này!
Dialogue: 0,0:06:44.06,0:06:45.39,Default,,0000,0000,0000,,Đi đi.
Dialogue: 0,0:07:07.85,0:07:09.12,Default,,0000,0000,0000,,Cái gì?
Dialogue: 0,0:07:10.92,0:07:12.55,Default,,0000,0000,0000,,Đừng có bám theo tôi nữa.
Dialogue: 0,0:07:12.86,0:07:14.55,Default,,0000,0000,0000,,Hãy làm cho trót việc chị đã khơi mào đi.
Dialogue: 0,0:07:15.29,0:07:16.09,Default,,0000,0000,0000,,Việc tôi khơi mào ư?
Dialogue: 0,0:07:16.20,0:07:18.76,Default,,0000,0000,0000,,Phải, những gã đó\Nthuộc băng Tiểu Kiệt.
Dialogue: 0,0:07:19.10,0:07:21.46,Default,,0000,0000,0000,,Bọn chúng nổi danh khắp khu này\Nlà một băng yakuza mới nổi đấy.
Dialogue: 0,0:07:21.93,0:07:22.83,Default,,0000,0000,0000,,Chuyện đó thì có liên quan quái gì\Nđến tôi chứ?
Dialogue: 0,0:07:23.44,0:07:25.20,Default,,0000,0000,0000,,Sau những gì chị vừa làm, chúng sẽ quay lại...
Dialogue: 0,0:07:25.30,0:07:27.80,Default,,0000,0000,0000,,...và làm điều tồi tệ hơn nhiều với tôi\Nđể trả thù, đúng chứ?
Dialogue: 0,0:07:28.14,0:07:29.84,Default,,0000,0000,0000,,Dù tôi chẳng liên quan gì đến chuyện đó.
Dialogue: 0,0:07:30.31,0:07:32.97,Default,,0000,0000,0000,,Đáng lẽ tôi phải đứng trơ mắt nhìn\Nchúng chặt đứt cánh tay của nhóc sao?
Dialogue: 0,0:07:33.21,0:07:34.08,Default,,0000,0000,0000,,Theo một nghĩa nào đó thì đúng là vậy.
Dialogue: 0,0:07:34.18,0:07:35.91,Default,,0000,0000,0000,,Vậy sao nhóc không tới\Nxin lỗi chúng đi?
Dialogue: 0,0:07:36.02,0:07:38.81,Default,,0000,0000,0000,,Có điều lần tới có khi nhóc mất mạng\Nchứ chẳng phải mất mỗi cánh tay đâu.
Dialogue: 0,0:07:42.29,0:07:44.19,Default,,0000,0000,0000,,Ôi, cảnh sát kìa!
Dialogue: 0,0:07:48.69,0:07:49.46,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:07:49.56,0:07:50.72,Default,,0000,0000,0000,,Đi mau.
Dialogue: 0,0:07:57.07,0:07:58.47,Default,,0000,0000,0000,,Nhóc nghĩ mình\Nđang làm cái gì thế?
Dialogue: 0,0:08:01.44,0:08:03.37,Default,,0000,0000,0000,,Tôi cứu nhóc, và đây là cách nhóc\Nđền ơn tôi đấy à?
Dialogue: 0,0:08:03.81,0:08:06.14,Default,,0000,0000,0000,,Này, khoan đã...\NChị mang cơ thể máy toàn phần hả bà chị?
Dialogue: 0,0:08:06.75,0:08:08.37,Default,,0000,0000,0000,,Ngầu quá xá luôn!
Dialogue: 0,0:08:08.48,0:08:11.11,Default,,0000,0000,0000,,Em chưa từng thấy cơ thể nào cao cấp\Nđến mức này bao giờ!
Dialogue: 0,0:08:11.62,0:08:12.98,Default,,0000,0000,0000,,Chị từ đâu tới thế?
Dialogue: 0,0:08:13.59,0:08:14.92,Default,,0000,0000,0000,,Nhóc muốn cái gì?
Dialogue: 0,0:08:15.02,0:08:18.15,Default,,0000,0000,0000,,Một ngày nào đó em cũng sẽ đổi sang cơ thể máy toàn phần,\Ngiống như anh Roh vậy.
Dialogue: 0,0:08:18.56,0:08:21.69,Default,,0000,0000,0000,,Nên em cũng chẳng bận tâm\Nnếu có mất một cánh tay đâu.
Dialogue: 0,0:08:21.93,0:08:22.79,Default,,0000,0000,0000,,Roh ư?
Dialogue: 0,0:08:23.20,0:08:24.29,Default,,0000,0000,0000,,Nhóc biết Roh sao?
Dialogue: 0,0:08:24.40,0:08:27.23,Default,,0000,0000,0000,,Tôi mới là người hỏi ở đây.\NNhóc muốn gì hả?!
Dialogue: 0,0:08:28.53,0:08:32.03,Default,,0000,0000,0000,,Như em đã nói đấy, em muốn chị\Ngiúp em làm cho trót việc.
Dialogue: 0,0:08:32.41,0:08:33.80,Default,,0000,0000,0000,,Đi theo em\Nmột lát.
Dialogue: 0,0:08:35.21,0:08:37.51,Default,,0000,0000,0000,,Nhanh lên nào!\NĐường này nè!
Dialogue: 0,0:08:46.49,0:08:47.42,Default,,0000,0000,0000,,Tới nơi rồi.
Dialogue: 0,0:09:07.77,0:09:08.50,Default,,0000,0000,0000,,Mấy thứ này là gì thế?
Dialogue: 0,0:09:08.61,0:09:09.54,Default,,0000,0000,0000,,Tượng mô hình.
Dialogue: 0,0:09:09.64,0:09:13.20,Default,,0000,0000,0000,,Kia là rùa biển xanh\Ntrong dòng Red Data EX.
Dialogue: 0,0:09:13.41,0:09:15.74,Default,,0000,0000,0000,,Còn đây là đà điểu\Ntừ dòng EW.
Dialogue: 0,0:09:15.85,0:09:17.11,Default,,0000,0000,0000,,Làm đẹp mắt lắm\Nđúng không?
Dialogue: 0,0:09:17.55,0:09:20.31,Default,,0000,0000,0000,,Giờ chỉ còn sơn phết lên chúng\Nvà chờ ngày xuất xưởng thôi.
Dialogue: 0,0:09:21.42,0:09:24.08,Default,,0000,0000,0000,,Đó là mô hình thật\Nđược làm từ trước chiến tranh.
Dialogue: 0,0:09:24.62,0:09:27.82,Default,,0000,0000,0000,,Phải công nhận là so với hàng xịn,\Nnước sơn của bọn em trông còn thô thiển,
Dialogue: 0,0:09:27.93,0:09:30.16,Default,,0000,0000,0000,,và nhiều chi tiết\Nkhông được sắc nét cho lắm.
Dialogue: 0,0:09:30.70,0:09:35.36,Default,,0000,0000,0000,,Nhưng chúng có đủ tem niêm phong và số sê-ri,\Nnên trông cũng đủ giống thật rồi đúng không?
Dialogue: 0,0:09:38.37,0:09:39.43,Default,,0000,0000,0000,,Chị vẫn chưa hiểu ra à?
Dialogue: 0,0:09:39.67,0:09:40.66,Default,,0000,0000,0000,,Hiểu cái gì?
Dialogue: 0,0:09:41.97,0:09:44.27,Default,,0000,0000,0000,,Toàn bộ mấy thứ này\Nđều được làm từ cocaine đấy.
Dialogue: 0,0:09:48.55,0:09:50.07,Default,,0000,0000,0000,,Chúng được đúc ép bằng áp suất cao.
Dialogue: 0,0:09:50.62,0:09:53.52,Default,,0000,0000,0000,,Nghe nói người ta từng dùng phương pháp này\Nở quanh vùng Mexico.
Dialogue: 0,0:09:54.45,0:09:57.91,Default,,0000,0000,0000,,Bởi vì một người lớn mang theo mấy bức tượng thế này\Nsẽ chẳng gây ra chút nghi ngờ nào cả.
Dialogue: 0,0:09:58.26,0:09:59.66,Default,,0000,0000,0000,,Nhóc nghĩ ra trò này à?
Dialogue: 0,0:09:59.93,0:10:01.32,Default,,0000,0000,0000,,Là anh Roh đã nghĩ ra\Ný tưởng này đấy.
Dialogue: 0,0:10:02.03,0:10:04.09,Default,,0000,0000,0000,,Dù đây là lần đầu tiên bọn em\Nthực sự bắt tay vào làm.
Dialogue: 0,0:10:05.10,0:10:08.12,Default,,0000,0000,0000,,Nhóc đang muốn ép tôi trở thành đồng phạm...
Dialogue: 0,0:10:08.37,0:10:10.80,Default,,0000,0000,0000,,...bằng cách tiết lộ một bí mật động trời\Nnhư thế này sao?
Dialogue: 0,0:10:11.00,0:10:12.94,Default,,0000,0000,0000,,Chị hiểu lầm\Nhoàn toàn rồi.
Dialogue: 0,0:10:13.24,0:10:17.57,Default,,0000,0000,0000,,Bà chị à, nhìn chị chẳng bao giờ bị nhầm\Nlà người của băng Tiểu Kiệt hay Hoàng Long đâu.
Dialogue: 0,0:10:18.34,0:10:22.28,Default,,0000,0000,0000,,Nhưng chị cũng không phải dân tị nạn, và càng chẳng phải\Nmột du khách bình thường.
Dialogue: 0,0:10:22.62,0:10:23.58,Default,,0000,0000,0000,,Thế thì sao nào?
Dialogue: 0,0:10:23.68,0:10:26.31,Default,,0000,0000,0000,,Em muốn sở hữu\Nmột cơ thể máy toàn phần.
Dialogue: 0,0:10:26.65,0:10:32.56,Default,,0000,0000,0000,,Em đoán một người như chị hẳn phải biết\Nđường dây chợ đen nào đó để kiếm được một bộ.
Dialogue: 0,0:10:33.09,0:10:36.03,Default,,0000,0000,0000,,Nhóc muốn làm gì\Nnếu có được nó?
Dialogue: 0,0:10:36.13,0:10:38.72,Default,,0000,0000,0000,,Em sẽ tiếp tục con đường\Nmà anh Roh còn dang dở.
Dialogue: 0,0:10:39.43,0:10:41.16,Default,,0000,0000,0000,,Khốn kiếp, lại gì nữa đây?
Dialogue: 0,0:10:41.97,0:10:42.73,Default,,0000,0000,0000,,Tôi đây.
Dialogue: 0,0:10:42.84,0:10:44.17,Default,,0000,0000,0000,,Ừ. Được rồi.
Dialogue: 0,0:10:44.27,0:10:45.90,Default,,0000,0000,0000,,Tôi biết rồi. Cảm ơn.
Dialogue: 0,0:10:46.24,0:10:49.33,Default,,0000,0000,0000,,Tao sẽ đi lánh mặt một thời gian.\NTụi mày cũng phải biến mất tạm thời đi.
Dialogue: 0,0:10:50.51,0:10:51.94,Default,,0000,0000,0000,,Ở đây sẽ\Nan toàn thôi.
Dialogue: 0,0:10:52.75,0:10:56.41,Default,,0000,0000,0000,,Bọn kia là lũ đần. Chúng sẽ chẳng bao giờ\Nbiết mấy thứ này là cái gì đâu.
Dialogue: 0,0:10:56.85,0:10:58.34,Default,,0000,0000,0000,,Được rồi.\NCẩn thận đấy.
Dialogue: 0,0:11:03.79,0:11:07.32,Default,,0000,0000,0000,,Có vẻ băng Tiểu Kiệt đã đánh hơi được chỗ này rồi.\NChúng ta phải đi thôi.
Dialogue: 0,0:11:39.06,0:11:41.15,Default,,0000,0000,0000,,Nơi này xịn sò hơn nhiều\Nso với những gì em tưởng tượng đấy.
Dialogue: 0,0:11:41.26,0:11:45.53,Default,,0000,0000,0000,,Này, chị vào đây làm gì thế?!\NĐến nơi ẩn náu của em đi!
Dialogue: 0,0:11:45.66,0:11:48.63,Default,,0000,0000,0000,,Ở một nơi thế này\Nnhóc sẽ an toàn hơn nhiều.
Dialogue: 0,0:11:49.97,0:11:51.60,Default,,0000,0000,0000,,Cho tôi một phòng\Npenthouse suite.
Dialogue: 0,0:11:54.57,0:11:56.20,Default,,0000,0000,0000,,Phòng suite cao cấp ạ?
Dialogue: 0,0:11:59.91,0:12:01.47,Default,,0000,0000,0000,,Xin quý khách vui lòng đợi một lát.
Dialogue: 0,0:12:07.09,0:12:10.89,Default,,0000,0000,0000,,Thẻ bạch kim sao?!\NTrời đất, bà chị rốt cuộc {\i1}là{\i0} ai vậy?
Dialogue: 0,0:12:13.56,0:12:17.46,Default,,0000,0000,0000,,Cảm ơn quý khách đã đợi.\NChìa khóa phòng của quý khách đây ạ.
Dialogue: 0,0:12:17.80,0:12:19.02,Default,,0000,0000,0000,,Cảm ơn.
Dialogue: 0,0:12:21.80,0:12:24.67,Default,,0000,0000,0000,,Tôi không cho phép nó\Ngọi tôi là \"Mẹ\".
Dialogue: 0,0:12:25.20,0:12:26.23,Default,,0000,0000,0000,,Đi thôi nào con yêu.
Dialogue: 0,0:12:26.64,0:12:28.47,Default,,0000,0000,0000,,Mẹ em trẻ đẹp ghê\Nđúng không?
Dialogue: 0,0:12:37.65,0:12:39.98,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Trong các cuộc hội đàm với Nhật Bản gần đây,{\i0}\N{\i1}vấn đề quân đội Mỹ...{\i0}
Dialogue: 0,0:12:40.09,0:12:43.45,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...đóng quân tại Nhật Bản sau khi hoàn tất Hiệp ước An ninh{\i0}\N{\i1}vẫn là điểm gây tranh cãi gay gắt.{\i0}
Dialogue: 0,0:12:43.56,0:12:44.78,Top Secondary Dialog 1080P,,0000,0000,0000,,Phản ứng từ phía\NNhật Bản...
Dialogue: 0,0:12:45.02,0:12:48.26,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Về loài đà điểu, loài vật hiện nay chỉ được nuôi{\i0}\N{\i1}chủ yếu để lấy thịt phục vụ con người,{\i0}
Dialogue: 0,0:12:48.73,0:12:52.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}chúng từng được nhìn thấy tung vó trên các thảo nguyên{\i0}\N{\i1}cho tới đầu thế kỷ này.{\i0}
Dialogue: 0,0:12:52.46,0:12:56.59,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chúng có một tập tính nuôi con rất độc đáo,{\i0}\N{\i1}trong đó con mái khỏe nhất đàn...{\i0}
Dialogue: 0,0:12:56.70,0:13:02.13,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...sẽ bảo vệ con non của mình khỏi kẻ săn mồi{\i0}\N{\i1}bằng cách gom toàn bộ con non trong đàn lại...{\i0}
Dialogue: 0,0:12:58.94,0:13:00.54,Default,,0000,0000,0000,,Vậy giờ nhóc định làm gì?
Dialogue: 0,0:13:02.24,0:13:05.21,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...và bao bọc con non của mình ở giữa{\i0}\N{\i1}nhằm bảo tồn nguồn gen mạnh nhất.{\i0}
Dialogue: 0,0:13:05.51,0:13:08.14,Default,,0000,0000,0000,,Tôi không muốn nhóc ôm hy vọng hão huyền,\Nnên tôi nói thẳng luôn.
Dialogue: 0,0:13:08.25,0:13:09.91,Default,,0000,0000,0000,,Sáng mai tôi sẽ rời khỏi đất nước này.
Dialogue: 0,0:13:10.05,0:13:11.07,Default,,0000,0000,0000,,Và đi đâu cơ chứ?
Dialogue: 0,0:13:17.62,0:13:19.11,Default,,0000,0000,0000,,Dù không phải điều\Nnhóc muốn nghe,
Dialogue: 0,0:13:19.46,0:13:23.33,Default,,0000,0000,0000,,nhưng nhóc nên trình báo sự việc với cảnh sát\Nvà xin được bảo vệ nhân chứng.
Dialogue: 0,0:13:24.43,0:13:27.80,Default,,0000,0000,0000,,Ai thèm bảo vệ\Nmột thằng nhãi tị nạn chứ hả?!
Dialogue: 0,0:13:28.03,0:13:31.80,Default,,0000,0000,0000,,Người tị nạn chẳng có nơi nào để gọi là nhà\Ntrên cái thế giới này cả!
Dialogue: 0,0:13:32.17,0:13:35.44,Default,,0000,0000,0000,,Bọn em chính là những con đà điểu làm mồi béo bở\Ncho cái đám tư sản các người!
Dialogue: 0,0:13:37.68,0:13:40.70,Default,,0000,0000,0000,,Đó là những gì Kuze...\Nnhững gì Roh đã nói với nhóc sao?
Dialogue: 0,0:13:41.91,0:13:43.07,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:13:44.02,0:13:46.61,Default,,0000,0000,0000,,Anh ta là gì đối với\Nnhững con người ở đây?
Dialogue: 0,0:13:46.72,0:13:49.71,Default,,0000,0000,0000,,Là tất cả.\NNgười hùng của bọn em. Vị thần của bọn em.
Dialogue: 0,0:13:49.92,0:13:51.45,Default,,0000,0000,0000,,Ý định chuyển sang cơ thể máy\Nlà do anh ta gợi ý à?
Dialogue: 0,0:13:51.56,0:13:57.02,Default,,0000,0000,0000,,Không. Nhưng nếu em muốn làm được những điều như anh Roh,\Nem cũng phải có cơ thể máy.
Dialogue: 0,0:13:58.06,0:13:59.33,Default,,0000,0000,0000,,Nhóc còn quá trẻ\Ncho chuyện đó đấy.
Dialogue: 0,0:13:59.43,0:14:03.42,Default,,0000,0000,0000,,Anh Roh bảo anh ấy\Nđã chết từ rất lâu rồi,
Dialogue: 0,0:14:03.84,0:14:08.67,Default,,0000,0000,0000,,nên anh ấy đang dùng những tàn tro cuối cùng của Ghost mình\Nđể giúp đỡ những người hiểu được anh ấy.
Dialogue: 0,0:14:08.94,0:14:13.90,Default,,0000,0000,0000,,Em từng muốn buông xuôi tất cả, và những lời nói đó\Ngiống như đã thắp lại hy vọng trong em.
Dialogue: 0,0:14:14.51,0:14:19.04,Default,,0000,0000,0000,,Rằng bắt chước mọi thứ về anh ấy là điều vô cùng xứng đáng,\Ndù điều đó có nghĩa em chỉ là một bản sao.
Dialogue: 0,0:14:19.45,0:14:21.85,Default,,0000,0000,0000,,Trông nhóc thậm chí còn chưa hề\Ncó một bộ não điện tử.
Dialogue: 0,0:14:21.95,0:14:24.45,Default,,0000,0000,0000,,Làm thế nào nhóc có thể\Nđồng bộ hóa suy nghĩ của anh ta với mình?
Dialogue: 0,0:14:24.56,0:14:28.08,Default,,0000,0000,0000,,Hả? Đơn giản lắm.\NChỉ cần nói chuyện với anh ấy thôi.
Dialogue: 0,0:14:28.46,0:14:32.73,Default,,0000,0000,0000,,Chỉ cần nói chuyện với anh Roh một lần\Nlà chị sẽ quý mến anh ấy ngay.
Dialogue: 0,0:14:33.07,0:14:34.19,Default,,0000,0000,0000,,Nói chuyện với anh ta ư?
Dialogue: 0,0:14:35.37,0:14:37.20,Default,,0000,0000,0000,,Một người đàn ông kỳ lạ...
Dialogue: 0,0:14:37.60,0:14:41.90,Default,,0000,0000,0000,,Lần đầu tiên nhìn thấy chị, em đã tự nhủ:\N\"Bà chị này giống hệt anh Roh.\"
Dialogue: 0,0:14:42.37,0:14:43.77,Default,,0000,0000,0000,,Đó là lý do em\Nrủ chị đi cùng.
Dialogue: 0,0:14:44.14,0:14:47.08,Default,,0000,0000,0000,,Nhưng không sao đâu.\NEm sẽ tự mình làm một mình.
Dialogue: 0,0:14:47.51,0:14:49.85,Default,,0000,0000,0000,,Dù sao thì anh Roh cũng luôn chiến đấu\Nmà chẳng cần ai giúp đỡ cả.
Dialogue: 0,0:14:51.28,0:14:54.01,Default,,0000,0000,0000,,Tùy nhóc.\NTôi sẽ không cản đâu.
Dialogue: 0,0:14:54.29,0:14:55.45,Default,,0000,0000,0000,,Em sẽ làm thế.
Dialogue: 0,0:15:17.31,0:15:20.24,Default,,0000,0000,0000,,Bà chị, chị có phiền không nếu em hỏi chị\Nmột câu thôi?
Dialogue: 0,0:15:20.58,0:15:21.88,Default,,0000,0000,0000,,Hỏi gì?
Dialogue: 0,0:15:22.48,0:15:26.25,Default,,0000,0000,0000,,Khi mang cơ thể máy toàn phần...\NChị có quan hệ tình dục được không?
Dialogue: 0,0:15:32.66,0:15:34.63,Default,,0000,0000,0000,,Có muốn tự mình\Nkiểm chứng không?
Dialogue: 0,0:15:35.63,0:15:37.19,Default,,0000,0000,0000,,Em xin kiếu ạ.
Dialogue: 0,0:15:52.44,0:15:54.04,Default,,0000,0000,0000,,Thẻ căn cước của chị ấy...
Dialogue: 0,0:16:31.82,0:16:32.88,Default,,0000,0000,0000,,Xe của tôi đã tới chưa?
Dialogue: 0,0:16:33.42,0:16:34.58,Default,,0000,0000,0000,,Đang đợi ở trước cửa rồi thưa cô.
Dialogue: 0,0:16:34.69,0:16:35.81,Default,,0000,0000,0000,,Cảm ơn.
Dialogue: 0,0:16:42.56,0:16:43.96,Default,,0000,0000,0000,,Đưa tôi ra sân bay.
Dialogue: 0,0:16:53.27,0:16:55.54,Default,,0000,0000,0000,,{\i1}Thằng nhóc đó có khí phách hơn{\i0}\N{\i1}mình tưởng đấy.{\i0}
Dialogue: 0,0:16:55.64,0:16:58.08,Default,,0000,0000,0000,,{\i1}Giờ thì mình cũng hiểu rõ hơn{\i0}\N{\i1}về con người của Kuze rồi.{\i0}
Dialogue: 0,0:16:58.41,0:17:01.97,Default,,0000,0000,0000,,{\i1}Dù vậy, đâu mới thực sự là nhân tố{\i0}\N{\i1}khiến họ bị anh ta cuốn hút đến thế?{\i0}
Dialogue: 0,0:17:02.31,0:17:04.98,Default,,0000,0000,0000,,{\i1}Liệu đây có phải là một dạng khác{\i0}\N{\i1}của hiện tượng Stand Alone Complex không?{\i0}
Dialogue: 0,0:17:07.45,0:17:09.04,Default,,0000,0000,0000,,Tôi có kịp chuyến bay không?
Dialogue: 0,0:17:09.15,0:17:11.25,Default,,0000,0000,0000,,Chúng ta sẽ tới nơi sớm\Nvà dư dả thời gian thưa cô.
Dialogue: 0,0:17:17.43,0:17:18.83,Default,,0000,0000,0000,,Cái thằng nhóc ngốc nghếch này...
Dialogue: 0,0:17:23.54,0:17:27.10,Default,,0000,0000,0000,,{\i1}Hóa ra nhóc vẫn chỉ là một đứa trẻ{\i0}\N{\i1}muốn được chở che mà thôi...{\i0}
Dialogue: 0,0:17:29.61,0:17:31.87,Default,,0000,0000,0000,,Bác tài, chở tôi đến nhà tắm công cộng này\Nđược không?
Dialogue: 0,0:17:32.31,0:17:33.87,Default,,0000,0000,0000,,Tôi vừa nhớ ra có chút chuyện\Ncần phải giải quyết.
Dialogue: 0,0:17:34.11,0:17:34.84,Default,,0000,0000,0000,,Có ngay thưa cô.
Dialogue: 0,0:17:35.35,0:17:37.82,Default,,0000,0000,0000,,Lần này dàn xếp một vụ làm ăn\Nsẽ không hề dễ dàng đâu.
Dialogue: 0,0:17:38.05,0:17:39.52,Default,,0000,0000,0000,,Đó là lý do tao sẽ\Nđi vào một mình.
Dialogue: 0,0:17:39.72,0:17:44.62,Default,,0000,0000,0000,,Trong trường hợp tao không trở ra,\Nmột trong tụi mày phải tiếp tục kế hoạch.
Dialogue: 0,0:17:45.02,0:17:47.25,Default,,0000,0000,0000,,Đúng như những gì anh Roh đã dạy chúng ta,\Nđừng chết một cách vô ích.
Dialogue: 0,0:17:47.36,0:17:48.33,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:17:49.03,0:17:50.62,Default,,0000,0000,0000,,Mày cũng phải cẩn thận đấy.
Dialogue: 0,0:17:50.76,0:17:51.66,Default,,0000,0000,0000,,Tao biết rồi.
Dialogue: 0,0:18:05.11,0:18:06.84,Default,,0000,0000,0000,,Tôi sẽ đi dạo quanh một chút,\Nnếu anh không phiền.
Dialogue: 0,0:18:27.87,0:18:32.27,Default,,0000,0000,0000,,Thật khó tin là bên trong mình\Nvẫn còn sót lại những cảm xúc thế này...
Dialogue: 0,0:18:45.95,0:18:47.38,Default,,0000,0000,0000,,Tôi đã dẫn thằng nhóc tới rồi.
Dialogue: 0,0:18:55.26,0:18:56.96,Default,,0000,0000,0000,,Mày là A Sài hả?
Dialogue: 0,0:18:57.53,0:18:58.43,Default,,0000,0000,0000,,Dạ phải.
Dialogue: 0,0:18:58.73,0:19:02.33,Default,,0000,0000,0000,,Cảm ơn các ông lớn đã nể mặt chấp thuận\Nyêu cầu đường đột của cháu.
Dialogue: 0,0:19:03.34,0:19:05.74,Default,,0000,0000,0000,,Chà chà. Biết điều đấy chứ.
Dialogue: 0,0:19:06.24,0:19:08.40,Default,,0000,0000,0000,,Vì đây là lần đầu tiên\Nta gặp mặt,
Dialogue: 0,0:19:08.51,0:19:12.64,Default,,0000,0000,0000,,và vì các ông là đối tác mà cháu hy vọng\Nsẽ cùng làm ăn phát đạt trong tương lai.
Dialogue: 0,0:19:13.48,0:19:16.61,Default,,0000,0000,0000,,Bọn tao chưa đồng ý đàm phán\Nvới mày đâu nhé ranh con.
Dialogue: 0,0:19:16.72,0:19:19.55,Default,,0000,0000,0000,,Thằng nhãi này thú vị đấy chứ.\NÔng thấy sao hả Lão Bản?
Dialogue: 0,0:19:20.02,0:19:24.89,Default,,0000,0000,0000,,Nếu gặp nhau trong hoàn cảnh khác,\Nbiết đâu ta đã có thể là đối tác của nhau.
Dialogue: 0,0:19:25.32,0:19:27.55,Default,,0000,0000,0000,,Mày thấy có đúng không,\NTiểu Kiệt?
Dialogue: 0,0:19:27.66,0:19:29.59,Default,,0000,0000,0000,,Lão Bản đùa vui tính quá...
Dialogue: 0,0:19:32.73,0:19:36.29,Default,,0000,0000,0000,,Bọn tôi chưa từng có ý định gây chiến\Nvới băng Hoàng Long vì chuyện này.
Dialogue: 0,0:19:37.17,0:19:38.50,Default,,0000,0000,0000,,Diễn đạt lắm, nhãi ranh.
Dialogue: 0,0:19:38.77,0:19:42.60,Default,,0000,0000,0000,,Tao sẽ giết mày, rồi sau đó khử sạch\Ntất cả những thằng nhóc làm việc cho mày.
Dialogue: 0,0:19:43.14,0:19:45.04,Default,,0000,0000,0000,,Sau đó bọn tao sẽ từ từ\Ntìm số hàng đó sau.
Dialogue: 0,0:19:57.59,0:20:00.11,Default,,0000,0000,0000,,Tao không nhớ là mình có gọi\Nmột em đào tới đây đâu đấy.
Dialogue: 0,0:20:02.29,0:20:04.79,Default,,0000,0000,0000,,Và tôi cũng chẳng nhớ là có ai\Ngọi mình tới cả.
Dialogue: 0,0:20:09.00,0:20:10.06,Default,,0000,0000,0000,,Cảm ơn.
Dialogue: 0,0:20:13.74,0:20:15.33,Default,,0000,0000,0000,,Bọn em xin lỗi vì đã gây phiền toái,\NLão Bản.
Dialogue: 0,0:20:15.44,0:20:17.91,Default,,0000,0000,0000,,Chúng ta không thể làm nhơ bẩn nơi này\Nbằng máu của lũ tị nạn được.
Dialogue: 0,0:20:18.41,0:20:20.71,Default,,0000,0000,0000,,Bọn em sẽ trả ơn này cho ngài\Nbằng cách này hay cách khác.
Dialogue: 0,0:20:27.12,0:20:29.95,Default,,0000,0000,0000,,Xin lỗi vì tôi tới muộn.\NBắt đầu đàm phán thôi.
Dialogue: 0,0:20:33.23,0:20:34.66,Default,,0000,0000,0000,,Chị là bà chị\Nhôm qua!
Dialogue: 0,0:20:38.70,0:20:40.56,Default,,0000,0000,0000,,Tôi muốn làm một giao dịch.\NĐổi thứ này lấy thằng nhóc.
Dialogue: 0,0:20:40.67,0:20:44.03,Default,,0000,0000,0000,,Và các người không được trả thù\Nnhững người tị nạn.
Dialogue: 0,0:20:44.27,0:20:46.03,Default,,0000,0000,0000,,Đó là hai điều kiện\Ncủa tôi.
Dialogue: 0,0:20:46.37,0:20:48.77,Default,,0000,0000,0000,,Nếu đồng ý,\Ntôi sẽ rời đi.
Dialogue: 0,0:20:49.17,0:20:51.94,Default,,0000,0000,0000,,Nếu không, e là tôi sẽ buộc phải\Nsử dụng đến bạo lực.
Dialogue: 0,0:20:52.28,0:20:53.68,Default,,0000,0000,0000,,Mày nghĩ mày là ai hả con ranh?!
Dialogue: 0,0:20:56.92,0:20:58.82,Default,,0000,0000,0000,,Tôi là một người phụ nữ thiếu kiên nhẫn.
Dialogue: 0,0:21:10.43,0:21:13.12,Default,,0000,0000,0000,,Cô cùng một chủng tộc\Nvới Roh sao?
Dialogue: 0,0:21:13.47,0:21:15.16,Default,,0000,0000,0000,,Ông nhìn mà\Nkhông nhận ra à?
Dialogue: 0,0:21:21.47,0:21:23.41,Default,,0000,0000,0000,,Được lắm.\NĐi đi.
Dialogue: 0,0:21:32.18,0:21:34.95,Default,,0000,0000,0000,,Đừng manh động.\NCô ta sẽ giết sạch tất cả các người đấy.
Dialogue: 0,0:21:42.06,0:21:43.89,Default,,0000,0000,0000,,- Đuổi theo chúng mau!\N- Là tôi thì tôi sẽ không làm thế đâu.
Dialogue: 0,0:21:44.63,0:21:48.57,Default,,0000,0000,0000,,\"Biết người biết ta, trăm trận không nguy.\"
Dialogue: 0,0:21:48.67,0:21:51.00,Default,,0000,0000,0000,,Giao dịch lần này kết thúc tại đây.
Dialogue: 0,0:22:07.92,0:22:11.72,Default,,0000,0000,0000,,Tôi chắc chắn Roh không hề bảo nhóc\Nphải đổi sang cơ thể máy...
Dialogue: 0,0:22:11.82,0:22:15.19,Default,,0000,0000,0000,,...hay lao vào một cuộc thanh trừng băng đảng nguy hiểm\Ncó thể cướp đi mạng sống của nhóc.
Dialogue: 0,0:22:18.23,0:22:20.46,Default,,0000,0000,0000,,Nhóc có lòng dũng cảm\Nvà tài năng.
Dialogue: 0,0:22:20.83,0:22:22.89,Default,,0000,0000,0000,,Nhưng nếu chết đi,\Nnhóc sẽ chẳng còn lại gì cả.
Dialogue: 0,0:22:24.10,0:22:27.20,Default,,0000,0000,0000,,Bây giờ, hãy gạt lòng tự ái sang một bên\Nvà tự xây dựng tương lai cho chính mình đi.
Dialogue: 0,0:22:27.81,0:22:29.07,Default,,0000,0000,0000,,Hẹn gặp lại.
Dialogue: 0,0:22:29.07,0:22:31.07,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
