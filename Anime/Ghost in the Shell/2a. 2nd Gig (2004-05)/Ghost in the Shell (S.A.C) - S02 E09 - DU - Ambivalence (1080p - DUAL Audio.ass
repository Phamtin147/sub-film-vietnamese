Dialogue: 0,0:01:41.83,0:01:42.99,Default,,0000,0000,0000,,Có kẻ đột nhập\Nsao?
Dialogue: 0,0:01:45.33,0:01:47.50,Default,,0000,0000,0000,,Virus đã xâm nhập qua hàng rào phòng thủ.\NSự lây nhiễm đang lan rộng.
Dialogue: 0,0:01:47.50,0:01:50.94,Default,,0000,0000,0000,,Xung đột với kháng thể.\NĐầu dò của địch đã xuyên thủng bức tường ngoài.
Dialogue: 0,0:01:50.94,0:01:53.14,Default,,0000,0000,0000,,Tăng cường phân bổ nhân lực\Ncho tuyến phòng thủ ngoại vi.
Dialogue: 0,0:01:53.14,0:01:55.61,Default,,0000,0000,0000,,Cắt bỏ các phân khu bị nhiễm độc\Nvà biến chúng thành mồi nhử!
Dialogue: 0,0:01:56.05,0:01:58.85,Default,,0000,0000,0000,,Tình trạng phân tích virus.\NĐang trong quá trình tự hủy hoại lẫn nhau.
Dialogue: 0,0:01:58.85,0:02:02.08,Default,,0000,0000,0000,,Mười bốn biến thể đã bị vô hiệu hóa.\NHai biến thể đang hoạt động. Một biến thể chưa xác định danh tính.
Dialogue: 0,0:02:02.18,0:02:04.59,Default,,0000,0000,0000,,Chưa xác định là thế nào?!\NMau xác minh cho tôi!
Dialogue: 0,0:02:04.59,0:02:07.95,Default,,0000,0000,0000,,Quét sơ bộ cho thấy nó trơ lì và không phản hồi.\NCó vẻ chỉ là một mồi nhử.
Dialogue: 0,0:02:08.59,0:02:10.58,Default,,0000,0000,0000,,Thay đổi phiên bản kháng thể\Nvà tiếp tục phân tích.
Dialogue: 0,0:02:10.93,0:02:13.00,Default,,0000,0000,0000,,Đừng để kẻ đột nhập nhận diện được\Ngiao thức phản ứng của chúng ta.
Dialogue: 0,0:02:13.00,0:02:15.23,Default,,0000,0000,0000,,Kẻ xâm nhập đã bắt đầu\Nchiếm quyền kiểm soát các máy chủ ủy quyền proxy.
Dialogue: 0,0:02:15.53,0:02:17.40,Default,,0000,0000,0000,,Không thể ngắt mạch\Nvật lý được.
Dialogue: 0,0:02:17.60,0:02:20.47,Default,,0000,0000,0000,,- Các virus giành được quyền truy cập đang tiếp tục nhân bản.\N- Chết tiệt... Lũ cướp mạng này rốt cuộc là ai thế?
Dialogue: 0,0:02:20.47,0:02:22.57,Default,,0000,0000,0000,,Tuyến phòng thủ số 1\Nđã bị triệt tiêu 60%.
Dialogue: 0,0:02:22.57,0:02:25.06,Default,,0000,0000,0000,,Yêu cầu yểm trợ chi viện\Ntừ hệ thống Decatoncheir của Poseidon!
Dialogue: 0,0:02:54.80,0:02:56.13,Default,,0000,0000,0000,,Khốn kiếp, muộn mất rồi!
Dialogue: 0,0:02:57.11,0:02:59.63,Default,,0000,0000,0000,,Gọi xe cứu thương mau!\NCứu chữa người bị thương là ưu tiên hàng đầu.
Dialogue: 0,0:02:59.71,0:03:00.94,Default,,0000,0000,0000,,Điều thêm vài xe cấp cứu\Ntới đây ngay!
Dialogue: 0,0:03:00.94,0:03:03.38,Default,,0000,0000,0000,,Chúng tôi đang ở trung tâm thương mại thuộc Phường 3 Niihama!\NChúng tôi cần ít nhất năm chiếc!
Dialogue: 0,0:03:13.52,0:03:15.51,Default,,0000,0000,0000,,{\i1}Đúng là cùng một kiểu ra tay rồi.{\i0}\N{\i1}Không còn nghi ngờ gì nữa.{\i0}
Dialogue: 0,0:03:16.43,0:03:17.98,Default,,0000,0000,0000,,{\i1}Lại là đánh bom liều chết sao?{\i0}
Dialogue: 0,0:03:18.19,0:03:22.53,Default,,0000,0000,0000,,{\i1}Ừ, dùng thuốc nổ dẻo trộn lẫn{\i0}\N{\i1}đầy đinh và ốc vít găm bên trong.{\i0}
Dialogue: 0,0:03:27.10,0:03:31.30,Default,,0000,0000,0000,,Chết tiệt! Khủng bố bừa bãi không phân biệt mà lại còn phát cảnh báo trước à?\NTrò quái quỷ gì thế này?
Dialogue: 0,0:03:31.67,0:03:35.97,Default,,0000,0000,0000,,Xem ra thứ mà bọn chúng nhắm tới\Nlà tạo ra nỗi kinh hoàng tột độ.
Dialogue: 0,0:03:36.55,0:03:37.77,Default,,0000,0000,0000,,Nỗi sợ hãi tột độ sao?
Dialogue: 0,0:03:37.91,0:03:38.78,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:03:39.18,0:03:43.24,Default,,0000,0000,0000,,Hệt như Nhóm 11 Cá Nhân,\Nbọn chúng phát đi lời cảnh báo từ trước,
Dialogue: 0,0:03:43.45,0:03:46.05,Default,,0000,0000,0000,,nhưng rồi lại kết thúc bằng việc tấn công bừa bãi,\Nhết vụ đánh bom này đến vụ đánh bom khác.
Dialogue: 0,0:03:46.69,0:03:51.02,Default,,0000,0000,0000,,Rõ ràng chúng là thể loại tội phạm cực kỳ tàn độc,\Ncoi bản thân hành vi khủng bố chính là mục đích.
Dialogue: 0,0:03:51.09,0:03:55.59,Default,,0000,0000,0000,,Vậy ý cậu là sẽ có thêm\Nít nhất một vụ đánh bom liều chết nữa sao?
Dialogue: 0,0:03:55.80,0:03:57.99,Default,,0000,0000,0000,,Nếu chúng ta tin vào lời cảnh báo của chúng,\Nthì đúng là vậy.
Dialogue: 0,0:03:59.07,0:04:02.23,Default,,0000,0000,0000,,Khốn kiếp thật... Đất nước này\Nrốt cuộc đang xảy ra chuyện quái gì thế?
Dialogue: 0,0:04:02.54,0:04:04.94,Default,,0000,0000,0000,,Có phải có thứ gì đó đang bắt đầu\Nsai lệch ở một nơi nào đó không?
Dialogue: 0,0:04:04.94,0:04:06.13,Default,,0000,0000,0000,,Ừ, tôi cũng nghĩ vậy.
Dialogue: 0,0:04:06.81,0:04:09.11,Default,,0000,0000,0000,,Cứ với cái đà này, chúng ta sẽ chẳng bao giờ\Ncó đủ quân số để theo kịp bọn chúng đâu.
Dialogue: 0,0:04:14.72,0:04:17.24,Default,,0000,0000,0000,,{\i1}Trưởng ban, cứ đuổi theo đám đánh bom kiểu này{\i0}\N{\i1}thì chúng ta chẳng bao giờ đón đầu kịp mất.{\i0}
Dialogue: 0,0:04:17.55,0:04:21.32,Default,,0000,0000,0000,,{\i1}Bên ông vẫn chưa tìm thấy manh mối nào về{\i0}\N{\i1}thời gian hay địa điểm trong lời cảnh báo sao?{\i0}
Dialogue: 0,0:04:21.76,0:04:25.53,Default,,0000,0000,0000,,{\i1}Hiện tại, tất cả những gì ta có chỉ là bức thư điện tử{\i0}\N{\i1}gửi tới Sở Cảnh sát Tỉnh với nội dung:{\i0}
Dialogue: 0,0:04:25.53,0:04:28.55,Default,,0000,0000,0000,,{\i1}\"Hôm nay chúng ta sẽ kích nổ năm vụ đánh bom liều chết{\i0}\N{\i1}bên trong thành phố Niihama.\"{\i0}
Dialogue: 0,0:04:29.23,0:04:31.57,Default,,0000,0000,0000,,{\i1}Nếu nó diễn biến theo đúng mô thức của{\i0}\N{\i1}những vụ xảy ra ở Fukuoka tuần trước,{\i0}
Dialogue: 0,0:04:31.57,0:04:34.83,Default,,0000,0000,0000,,{\i1}thì vụ nổ cuối cùng chắc chắn nhất định{\i0}\N{\i1}cũng sẽ xảy ra tại Niihama này.{\i0}
Dialogue: 0,0:04:35.47,0:04:37.67,Default,,0000,0000,0000,,{\i1}Bàn giao hiện trường lại cho{\i0}\N{\i1}Cảnh sát Tỉnh...{\i0}
Dialogue: 0,0:04:37.87,0:04:40.27,Default,,0000,0000,0000,,{\i1}...và bằng mọi giá phải ngăn chặn{\i0}\N{\i1}vụ đánh bom tiếp theo xảy ra.{\i0}
Dialogue: 0,0:04:40.94,0:04:44.50,Default,,0000,0000,0000,,{\i1}Ngăn chặn bằng cách nào? Bắt giữ tất cả mọi người{\i0}\N{\i1}đang dùng cơ thể giả ở Niihama chắc?{\i0}
Dialogue: 0,0:04:44.88,0:04:48.41,Default,,0000,0000,0000,,{\i1}Dù đây có là khủng bố bừa bãi đi nữa,{\i0}\N{\i1}thì chắc chắn vẫn phải có một phương thức quy luật nào đó.{\i0}
Dialogue: 0,0:04:48.82,0:04:49.94,Default,,0000,0000,0000,,{\i1}Rõ...{\i0}
Dialogue: 0,0:04:50.69,0:04:53.45,Default,,0000,0000,0000,,{\i1}Nhân tiện, Thiếu tá đang ở đâu{\i0}\N{\i1}vào những lúc dầu sôi lửa bỏng thế này vậy?{\i0}
Dialogue: 0,0:04:53.82,0:04:56.12,Default,,0000,0000,0000,,{\i1}Cô ấy bảo đang tiến hành một cuộc lặn điều tra{\i0}\N{\i1}thuộc diện tuyệt mật.{\i0}
Dialogue: 0,0:04:56.99,0:04:58.93,Default,,0000,0000,0000,,{\i1}Tuyệt mật sao?{\i0}
Dialogue: 0,0:04:59.56,0:05:02.55,Default,,0000,0000,0000,,Giao lại chỗ này cho cảnh sát tỉnh\Nvà ông già đi. Chúng ta lên đường thôi.
Dialogue: 0,0:05:04.03,0:05:06.30,Default,,0000,0000,0000,,{\i1}Borma, nếu tìm ra manh mối gì,{\i0}\N{\i1}nhớ hú bọn này một tiếng đấy.{\i0}
Dialogue: 0,0:05:08.30,0:05:11.20,Default,,0000,0000,0000,,Rốt cuộc cái trò quái gở \"bom người\" này\Nlà sao chứ?
Dialogue: 0,0:05:11.57,0:05:13.73,Default,,0000,0000,0000,,Đây đâu phải là một quốc gia vô chính phủ\Nđang nằm dưới ách thống trị ngoại bang đâu.
Dialogue: 0,0:05:14.14,0:05:18.01,Default,,0000,0000,0000,,Nó chỉ chứng tỏ rằng đất nước này không còn thanh bình đến mức\Nđể cậu có thể nói những lời vô tư như thế nữa rồi.
Dialogue: 0,0:05:18.01,0:05:19.31,Default,,0000,0000,0000,,Hệt như bao người khác thôi.
Dialogue: 0,0:05:20.32,0:05:24.65,Default,,0000,0000,0000,,Tôi thừa nhận vấn đề người tị nạn là một thùng thuốc súng\Nsớm muộn gì cũng phát nổ,
Dialogue: 0,0:05:24.95,0:05:28.62,Default,,0000,0000,0000,,và việc những kẻ theo chủ nghĩa cá nhân dùng đến những biện pháp cực đoan thế này...
Dialogue: 0,0:05:28.92,0:05:32.49,Default,,0000,0000,0000,,...có thể là do tình hình chính trị tương lai ở đây\Nquá đỗi bấp bênh mơ hồ.
Dialogue: 0,0:05:32.90,0:05:36.46,Default,,0000,0000,0000,,Ôi chết tiệt! Có thể thủ phạm chính là người tị nạn!\NTôi quên khuấy mất chuyện đó!
Dialogue: 0,0:05:39.67,0:05:40.64,Default,,0000,0000,0000,,{\i1}Trưởng ban!{\i0}
Dialogue: 0,0:05:40.97,0:05:45.07,Default,,0000,0000,0000,,{\i1}Hãy điều tra sâu hơn về các nghi phạm trong cả{\i0}\N{\i1}các vụ đánh bom tuần trước ở Fukuoka...{\i0}
Dialogue: 0,0:05:45.47,0:05:48.14,Default,,0000,0000,0000,,{\i1}...lẫn các vụ đánh bom liều chết{\i0}\N{\i1}trong vài giờ đồng hồ vừa qua.{\i0}
Dialogue: 0,0:05:49.48,0:05:51.81,Default,,0000,0000,0000,,{\i1}Thi thể của họ đã bị phá hủy tan nát{\i0}\N{\i1}đến mức không thể nhận dạng nổi.{\i0}
Dialogue: 0,0:05:52.11,0:05:56.11,Default,,0000,0000,0000,,{\i1}Tất cả những gì ta biết là họ sở hữu tỷ lệ{\i0}\N{\i1}các bộ phận giả trên cơ thể khá cao.{\i0}
Dialogue: 0,0:05:56.25,0:05:57.41,Default,,0000,0000,0000,,{\i1}Không, ý tôi không phải{\i0}\N{\i1}như vậy.{\i0}
Dialogue: 0,0:05:57.49,0:06:01.65,Default,,0000,0000,0000,,{\i1}Họ chắc chắn từng lọt vào hệ thống cảm biến hồng ngoại IR{\i0}\N{\i1}hoặc camera an ninh trong lúc vẫn còn sống.{\i0}
Dialogue: 0,0:06:01.86,0:06:03.69,Default,,0000,0000,0000,,{\i1}Tôi muốn ông trích xuất toàn bộ{\i0}\N{\i1}các bản ghi đó cho tôi.{\i0}
Dialogue: 0,0:06:04.29,0:06:06.42,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}\N{\i1}Tôi sẽ xem mình có thể làm được gì.{\i0}
Dialogue: 0,0:06:07.93,0:06:09.12,Default,,0000,0000,0000,,Ý cậu là sao thế?
Dialogue: 0,0:06:09.80,0:06:13.30,Default,,0000,0000,0000,,Những vụ đánh bom kiểu này không phải là hành động quy mô lớn\Nđược thực hiện bởi những người...
Dialogue: 0,0:06:13.30,0:06:17.03,Default,,0000,0000,0000,,...bị ép buộc hay nghe theo lệnh của cấp trên.
Dialogue: 0,0:06:17.57,0:06:23.71,Default,,0000,0000,0000,,Đánh bom liều chết là thứ mà người ta tìm đến\Nkhi đã hoàn toàn tuyệt vọng và mất hết niềm tin vào cuộc sống.
Dialogue: 0,0:06:47.27,0:06:49.00,Default,,0000,0000,0000,,{\i1}Trưởng ban, tình hình bên đó{\i0}\N{\i1}vẫn ổn chứ?{\i0}
Dialogue: 0,0:06:49.34,0:06:51.47,Default,,0000,0000,0000,,{\i1}Có vẻ như chúng ta đang bị động chạy theo sau đuôi bọn chúng{\i0}\N{\i1}và đang nắm phần thua.{\i0}
Dialogue: 0,0:06:51.47,0:06:54.47,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ kịp thời ngăn chặn vụ tiếp theo.{\i0}\N{\i1}Tình hình bên cô diễn ra thế nào rồi?{\i0}
Dialogue: 0,0:06:55.18,0:06:57.44,Default,,0000,0000,0000,,{\i1}Các phân thân Tachikoma{\i0}\N{\i1}đang hoạt động rất tốt.{\i0}
Dialogue: 0,0:06:57.91,0:07:00.61,Default,,0000,0000,0000,,{\i1}Tôi thực sự không cần phải lo lắng về{\i0}\N{\i1}sự suy hao tín hiệu theo cự ly khoảng cách.{\i0}
Dialogue: 0,0:07:01.18,0:07:03.78,Default,,0000,0000,0000,,{\i1}Bọn tôi chẳng nắm chắc phần thắng,{\i0}\N{\i1}nhưng xem ra cũng chẳng dễ dàng thua cuộc đâu.{\i0}
Dialogue: 0,0:07:04.02,0:07:05.95,Default,,0000,0000,0000,,Chuẩn không cần chỉnh, chuẩn luôn!
Dialogue: 0,0:07:07.36,0:07:08.85,Default,,0000,0000,0000,,{\i1}Đừng làm trò gì phô trương quá đấy.{\i0}
Dialogue: 0,0:07:09.56,0:07:12.36,Default,,0000,0000,0000,,{\i1}Tôi sẽ cố. Dù sao thì tôi cũng sẽ{\i0}\N{\i1}tự kiềm chế bản thân.{\i0}
Dialogue: 0,0:07:19.13,0:07:21.23,Default,,0000,0000,0000,,{\i1}Tachikoma! Mặt nạ cảm giác của tôi{\i0}\N{\i1}hoạt động tốt chứ?{\i0}
Dialogue: 0,0:07:21.94,0:07:24.06,Default,,0000,0000,0000,,Em đã hoàn thành việc vạch ra\Ntuyến đường ngắn nhất rồi ạ!
Dialogue: 0,0:07:24.41,0:07:26.31,Default,,0000,0000,0000,,Mảng mặt nạ ngụy trang\Nđã kích hoạt hoàn tất!
Dialogue: 0,0:07:26.38,0:07:29.21,Default,,0000,0000,0000,,Em đã ngắt khóa khẩn cấp\Ntrên phòng an ninh rồi, thưa Thiếu tá!
Dialogue: 0,0:07:37.42,0:07:41.02,Default,,0000,0000,0000,,Kẻ đột nhập đang sử dụng 512 biến thể hàng rào tấn công.\NĐang triển khai ở cấp độ 1.
Dialogue: 0,0:07:38.15,0:07:42.09,Top Secondary Dialog 1080P White,,0000,0000,0000,,Virus Chimera vẫn đang tiếp tục lan tràn.\NTốc độ tiến triển hiện tại là 52%.
Dialogue: 0,0:07:41.02,0:07:46.73,Default,,0000,0000,0000,,Tuyến phòng thủ đã phục hồi lên 70%.\N22% đang giao chiến với kẻ xâm nhập, 8% đã bị ăn mòn.
Dialogue: 0,0:07:42.09,0:07:47.56,Top Secondary Dialog 1080P White,,0000,0000,0000,,403 cỗ máy thuộc dạng tự hủy/cơ động. 82 cỗ máy là linh kiện lai tạo Chimera.\N27 cỗ máy là chất nổ và mồi nhử.
Dialogue: 0,0:07:47.00,0:07:52.33,Default,,0000,0000,0000,,Trong số 512 biến thể hàng rào tấn công của địch,\N7 biến thể đã xâm nhập tới cấp độ 2. Yêu cầu thả mồi nhử.
Dialogue: 0,0:07:47.56,0:07:52.33,Top Secondary Dialog 1080P White,,0000,0000,0000,,Mức độ hoạt động của hàng rào bổ trợ\Ntừ Decatoncheir đang chạm mức cực đại 97%.
Dialogue: 0,0:07:52.33,0:07:54.60,Default,,0000,0000,0000,,- 108 trong số 403 hàng rào tấn công của kẻ địch đã bị triệt tiêu.\N- Chúng ta đã đánh trả giành lại thế trận rồi hả?
Dialogue: 0,0:07:57.07,0:07:59.56,Top Secondary Dialog 1080P,,0000,0000,0000,,Hiệu năng hoạt động giảm 30%\Ndo sự xâm nhập của kẻ thù.
Dialogue: 0,0:07:59.91,0:08:04.60,Top Secondary Dialog 1080P,,0000,0000,0000,,Tuyến xâm nhập vẫn chưa xác định được. Tuyến an ninh\Nbị loại bỏ 40%. Hàng rào tấn công bị loại bỏ 28%.
Dialogue: 0,0:08:00.11,0:08:04.60,Default,,0000,0000,0000,,{\i1}Nếu cứ phó mặc mọi thứ cho AI,{\i0}\N{\i1}thì ngay cả mèo vờn chuột cũng sẽ qua mặt được các người thôi.{\i0}
Dialogue: 0,0:08:05.15,0:08:07.31,Default,,0000,0000,0000,,Chúng tôi vừa nhận được báo cáo\Ntừ Cảnh sát An ninh Mạng.
Dialogue: 0,0:08:08.05,0:08:10.64,Default,,0000,0000,0000,,\"Những người được cho là các kẻ đánh bom liều chết\Nđã được nhận diện...\"
Dialogue: 0,0:08:10.95,0:08:13.05,Default,,0000,0000,0000,,\"...dựa trên các cảnh quay thu thập được\Ntại các địa điểm xảy ra vụ việc.\"
Dialogue: 0,0:08:14.29,0:08:16.28,Default,,0000,0000,0000,,\"Xin xem hình ảnh\Nđính kèm bên dưới.\"
Dialogue: 0,0:08:16.89,0:08:18.19,Default,,0000,0000,0000,,Tôi hiểu rồi...
Dialogue: 0,0:08:18.86,0:08:20.85,Default,,0000,0000,0000,,{\i1}Borma, việc phân tích thuốc nổ{\i0}\N{\i1}tiến triển đến đâu rồi?{\i0}
Dialogue: 0,0:08:21.40,0:08:24.89,Default,,0000,0000,0000,,{\i1}Đánh giá từ lượng tàn dư sót lại,{\i0}\N{\i1}có vẻ như chất nổ C-4 đã được sử dụng trong cả bốn vụ.{\i0}
Dialogue: 0,0:08:25.73,0:08:28.76,Default,,0000,0000,0000,,{\i1}Cậu có thể xác định nguồn gốc nơi chúng lấy thuốc nổ{\i0}\N{\i1}hay phương pháp điều chế không?{\i0}
Dialogue: 0,0:08:29.20,0:08:33.14,Default,,0000,0000,0000,,{\i1}Tôi có thể cho cô biết nhiều hơn nếu tôi có thể{\i0}\N{\i1}mang mớ này sang máy gia tốc Spring-8.{\i0}
Dialogue: 0,0:08:33.74,0:08:34.73,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:08:35.18,0:08:39.48,Default,,0000,0000,0000,,{\i1}Trưởng ban, tôi vừa tìm thấy một dữ liệu rất thú vị{\i0}\N{\i1}từ các cửa hàng bị đánh bom.{\i0}
Dialogue: 0,0:08:39.92,0:08:44.65,Default,,0000,0000,0000,,{\i1}Hai địa điểm đầu tiên là các tòa nhà được dùng làm nơi tụ họp{\i0}\N{\i1}của những kẻ theo chủ nghĩa cá nhân,{\i0}
Dialogue: 0,0:08:45.02,0:08:48.16,Default,,0000,0000,0000,,{\i1}và hai địa điểm tiếp theo cũng thuộc về các tổ chức{\i0}\N{\i1}đang kiếm chác trục lợi bộn tiền...{\i0}
Dialogue: 0,0:08:48.16,0:08:50.52,Default,,0000,0000,0000,,{\i1}...khi hoạt động dưới vỏ bọc{\i0}\N{\i1}của Chính sách Người tị nạn.{\i0}
Dialogue: 0,0:08:51.89,0:08:54.62,Default,,0000,0000,0000,,{\i1}Nhà hàng này cũng có{\i0}\N{\i1}lai lịch y hệt như vậy.{\i0}
Dialogue: 0,0:08:55.13,0:08:57.69,Default,,0000,0000,0000,,{\i1}Nhận định của Batou về vụ này{\i0}\N{\i1}xem ra đã trúng phóc rồi.{\i0}
Dialogue: 0,0:08:58.20,0:09:01.19,Default,,0000,0000,0000,,{\i1}Cục An ninh Cảnh sát Tỉnh{\i0}\N{\i1}có nắm được thông tin đó không?{\i0}
Dialogue: 0,0:09:01.44,0:09:03.63,Default,,0000,0000,0000,,{\i1}Không hề có dữ liệu nào trùng khớp{\i0}\N{\i1}trên mạng công cộng cả.{\i0}
Dialogue: 0,0:09:04.11,0:09:05.16,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:09:05.97,0:09:07.77,Default,,0000,0000,0000,,Liên lạc với Cảnh sát Tỉnh\Nngay lập tức.
Dialogue: 0,0:09:08.08,0:09:11.58,Default,,0000,0000,0000,,Bảo họ cử các đội tuần tra tới các điểm hẹn của phe chủ nghĩa cá nhân,\Ncác văn phòng của giới xã hội đen và các nhà hàng...
Dialogue: 0,0:09:11.58,0:09:16.92,Default,,0000,0000,0000,,...nơi các phần tử cá nhân tụ tập hoặc nơi kiếm chác tiền bạc\Ntrên danh nghĩa Chính sách Người tị nạn.
Dialogue: 0,0:09:18.15,0:09:21.95,Default,,0000,0000,0000,,Nếu họ phát hiện bất kỳ ai tầm 20 tuổi\Ncó vẻ ngoài như đến từ trại tị nạn,
Dialogue: 0,0:09:22.26,0:09:23.82,Default,,0000,0000,0000,,hãy lập tức thẩm vấn ngay,\Nbất kể là nam hay nữ.
Dialogue: 0,0:09:24.16,0:09:27.09,Default,,0000,0000,0000,,Và nhắc họ phải hết sức cẩn trọng trước bất kỳ ai\Ncó tỷ lệ cơ thể giả cao!
Dialogue: 0,0:09:27.50,0:09:28.79,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:09:32.53,0:09:33.87,Default,,0000,0000,0000,,Vậy thủ phạm thực sự\Nlà người tị nạn sao?
Dialogue: 0,0:09:34.34,0:09:35.40,Default,,0000,0000,0000,,Tôi ngạc nhiên thật đấy.
Dialogue: 0,0:09:35.40,0:09:39.34,Default,,0000,0000,0000,,Cứ tưởng chính đám {\i1}công dân{\i0} trong nước\Nmới là những kẻ có thù hằn với {\i1}họ{\i0} chứ...
Dialogue: 0,0:09:40.14,0:09:43.04,Default,,0000,0000,0000,,Đó chính là lý do vì sao những nhóm mang tư tưởng cá nhân\Nnhư Nhóm 11 Cá Nhân...
Dialogue: 0,0:09:43.11,0:09:45.81,Default,,0000,0000,0000,,...mới xuất hiện trên vũ đài chính trị,\Nđúng không?
Dialogue: 0,0:09:46.58,0:09:48.57,Default,,0000,0000,0000,,Có lẽ đây là một đòn phản pháo\Nđáp trả lại bọn chúng.
Dialogue: 0,0:09:49.22,0:09:52.31,Default,,0000,0000,0000,,Thì đúng là khi cậu nhắc đến điều đó,\Ncó lẽ là như vậy thật,
Dialogue: 0,0:09:52.59,0:09:56.55,Default,,0000,0000,0000,,nên có thể giả định một cách an toàn rằng\Nthùng thuốc súng người tị nạn giờ đây đã được châm ngòi.
Dialogue: 0,0:09:57.73,0:10:02.25,Default,,0000,0000,0000,,Tự sát để đưa ra một thông điệp tuyên ngôn...\NThật là bệnh hoạn điên rồ.
Dialogue: 0,0:10:03.90,0:10:08.96,Default,,0000,0000,0000,,Khoảng thời gian cách quãng giữa các vụ đánh bom,\Ntừ vụ thứ nhất cho đến vụ thứ tư này là bao lâu?
Dialogue: 0,0:10:09.40,0:10:12.24,Default,,0000,0000,0000,,Lời cảnh báo được phát đi\Nvào đúng 12 giờ trưa.
Dialogue: 0,0:10:12.24,0:10:15.18,Default,,0000,0000,0000,,Vụ thứ nhất xảy ra\Nsau đó 13 phút.
Dialogue: 0,0:10:15.61,0:10:17.94,Default,,0000,0000,0000,,Vụ thứ hai xảy ra\Nsau đó 38 phút.
Dialogue: 0,0:10:18.71,0:10:23.28,Default,,0000,0000,0000,,Đến vụ thứ ba, khoảng cách thời gian giãn ra một chút,\Nxảy ra khoảng hai tiếng sau đó, lúc 3 giờ 23 phút.
Dialogue: 0,0:10:23.65,0:10:26.68,Default,,0000,0000,0000,,Khoảng cách lại càng rộng hơn ở vụ thứ tư,\Nxảy ra lúc 7 giờ 11 phút.
Dialogue: 0,0:10:27.72,0:10:29.66,Default,,0000,0000,0000,,Khoảng cách thời gian chắc chắn sẽ còn kéo dài hơn nữa\Nđối với vụ nổ tiếp theo.
Dialogue: 0,0:10:30.09,0:10:34.79,Default,,0000,0000,0000,,Trong các vụ khủng bố bằng chuỗi đánh bom liều chết liên hoàn,\Nchúng được kích nổ theo thứ tự mức độ sẵn sàng đón nhận cái chết.
Dialogue: 0,0:10:35.16,0:10:38.86,Default,,0000,0000,0000,,Hy vọng là chúng ta sẽ có thêm một chút thời gian\Ntrước khi vụ đánh bom tiếp theo xảy ra.
Dialogue: 0,0:10:46.88,0:10:50.37,Default,,0000,0000,0000,,Người Khổng lồ ơi, anh biết {\i1}quá{\i0} nhiều\Nvề những thứ chết tiệt đáng sợ kiểu này đấy.
Dialogue: 0,0:10:51.71,0:10:53.82,Default,,0000,0000,0000,,Tôi hỏi anh thêm\Nmột câu nữa được không?
Dialogue: 0,0:10:53.82,0:10:54.78,Default,,0000,0000,0000,,Gì thế?
Dialogue: 0,0:10:54.78,0:10:56.88,Default,,0000,0000,0000,,Nếu mục tiêu của chúng là gieo rắc\Nnỗi sợ hãi tột cùng,
Dialogue: 0,0:10:57.19,0:11:01.45,Default,,0000,0000,0000,,thì cậu sẽ nghĩ rằng việc tiến hành đánh bom {\i1}mà không{\i0} cảnh báo trước\Nsẽ mang lại hiệu quả cao hơn nhiều chứ.
Dialogue: 0,0:11:01.76,0:11:04.59,Default,,0000,0000,0000,,Tại sao anh lại nghĩ rằng\Nchúng lại phát cảnh báo trước?
Dialogue: 0,0:11:04.93,0:11:09.30,Default,,0000,0000,0000,,Chịu thôi. Có lẽ bọn chúng muốn\Ncho ai đó biết được...
Dialogue: 0,0:11:10.13,0:11:12.69,Default,,0000,0000,0000,,...biết được hành động cuối cùng của chúng\Ntrên cõi đời này là gì.
Dialogue: 0,0:11:19.81,0:11:21.28,Default,,0000,0000,0000,,{\i1}Đúng như mình dự đoán...{\i0}
Dialogue: 0,0:11:22.11,0:11:26.38,Default,,0000,0000,0000,,{\i1}Chúng ta đã xác nhận từ lý lịch của Gohda rằng hắn có đường dây ngầm béo bở với Poseidon,{\i0}
Dialogue: 0,0:11:26.72,0:11:28.74,Default,,0000,0000,0000,,{\i1}nhưng tôi không ngờ mọi thứ lại được quy chuẩn bài bản{\i0}\N{\i1}đến mức độ như thế này.{\i0}
Dialogue: 0,0:11:30.25,0:11:33.22,Default,,0000,0000,0000,,{\i1}Đây là một cái bẫy sao?{\i0}\N{\i1}Hay nó là một...{\i0}
Dialogue: 0,0:11:46.90,0:11:50.46,Default,,0000,0000,0000,,{\i1}Triển khai mảng gốc dọc theo cả ba trục tọa độ.{\i0}\N{\i1}Cho toàn bộ các biến thể hàng rào tấn công chuyển sang trạng thái chờ lệnh.{\i0}
Dialogue: 0,0:11:57.45,0:11:59.47,Default,,0000,0000,0000,,Đã triển khai hoàn tất,\Nthưa Thiếu tá!
Dialogue: 0,0:11:59.68,0:12:03.52,Default,,0000,0000,0000,,{\i1}Hỗ trợ tôi với toàn bộ công suất tối đa.{\i0}\N{\i1}Coi chừng các virus Chimera đấy.{\i0}
Dialogue: 0,0:12:03.59,0:12:04.89,Default,,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 0,0:12:04.89,0:12:08.34,Default,,0000,0000,0000,,{\i1}Được rồi, thực hiện phép chiếu cảm giác{\i0}\N{\i1}vào sâu trong hàng rào kiên cố nhất.{\i0}
Dialogue: 0,0:12:18.03,0:12:21.23,Default,,0000,0000,0000,,{\i1}Tải tệp Chroma của tôi lên hệ thống{\i0}\N{\i1}trước khi đội an ninh của chúng xuất hiện.{\i0}
Dialogue: 0,0:12:21.57,0:12:23.83,Default,,0000,0000,0000,,{\i1}Chuyển sang trạng thái cảnh giác chiến đấu cao độ{\i0}\N{\i1}bằng tám mảng ma trận.{\i0}
Dialogue: 0,0:12:35.98,0:12:38.99,Default,,0000,0000,0000,,{\i1}Tất cả mìn theo dõi trang bị mảng ma trận virus{\i0}\N{\i1}đã chuyển sang trạng thái kích hoạt!{\i0}
Dialogue: 0,0:12:38.99,0:12:41.22,Default,,0000,0000,0000,,Chúng em đã chiếm quyền kiểm soát não điện tử\Ncủa 12 nhân viên thuộc Đội Cảnh báo An ninh.
Dialogue: 0,0:12:41.22,0:12:43.62,Default,,0000,0000,0000,,{\i1}Được rồi, kiểm tra an ninh lần cuối{\i0}\N{\i1}toàn bộ khu vực chu vi xung quanh.{\i0}
Dialogue: 0,0:12:46.76,0:12:50.79,Default,,0000,0000,0000,,Các virus kiểm soát hoạt động mà chúng em tải vào 45 nhân viên an ninh\Nđang vận hành trơn tru!
Dialogue: 0,0:12:51.10,0:12:54.36,Default,,0000,0000,0000,,Mọi biến thể hàng rào tấn công đã hoạt động!\NKhông phát hiện xung đột nào!
Dialogue: 0,0:12:54.70,0:12:58.43,Default,,0000,0000,0000,,{\i1}Được rồi, chúng ta sẽ có thời gian cho đến khi ai đó phát hiện ra{\i0}\N{\i1}trạng thái đóng băng mà ta áp đặt lên người của đội an ninh.{\i0}
Dialogue: 0,0:12:58.77,0:13:03.34,Default,,0000,0000,0000,,{\i1}Ba đứa giám sát chặt chẽ 45 não điện tử đó.{\i0}\N{\i1}Nếu bị lộ, lập tức báo cho tôi ngay.{\i0}
Dialogue: 0,0:13:03.75,0:13:04.87,Default,,0000,0000,0000,,Rõ rồi ạ sếp!
Dialogue: 0,0:13:10.49,0:13:11.82,Default,,0000,0000,0000,,Có điều gì bất thường sao,\Nthưa ngài?
Dialogue: 0,0:13:12.75,0:13:14.75,Default,,0000,0000,0000,,Không. Chẳng có gì đâu.
Dialogue: 0,0:13:30.11,0:13:32.77,Default,,0000,0000,0000,,{\i1}Hóa ra đây là Decatoncheir{\i0}\N{\i1}mà mình đã được nghe nói đến bấy lâu nay sao.{\i0}
Dialogue: 0,0:13:33.21,0:13:36.01,Default,,0000,0000,0000,,{\i1}Nó đang chạy một chương trình mô phỏng, sử dụng một nhân cách ảo...{\i0}
Dialogue: 0,0:13:36.14,0:13:38.24,Default,,0000,0000,0000,,{\i1}...được kiến tạo nên từ{\i0}\N{\i1}lượng dữ liệu khổng lồ sao?{\i0}
Dialogue: 0,0:13:39.88,0:13:41.37,Default,,0000,0000,0000,,Cô là ai?
Dialogue: 0,0:13:43.18,0:13:45.18,Default,,0000,0000,0000,,Tôi là Kazundo Gohda.
Dialogue: 0,0:13:45.39,0:13:48.82,Default,,0000,0000,0000,,Ngoài những thứ khác, tôi từng tham gia vào dự án robot công nghệ phân tử...
Dialogue: 0,0:13:48.82,0:13:52.22,Default,,0000,0000,0000,,...tại Viện Nghiên cứu Kỹ thuật Đại Nhật Bản,\Nnơi đã tạo ra các cỗ máy làm sạch bụi phóng xạ hạt nhân.
Dialogue: 0,0:13:53.13,0:13:56.83,Default,,0000,0000,0000,,Máy làm sạch bụi phóng xạ sao?\NÝ ông là Kỳ tích Nhật Bản.
Dialogue: 0,0:13:57.37,0:13:59.00,Default,,0000,0000,0000,,Với tư cách là một kỹ sư à?
Dialogue: 0,0:13:59.00,0:14:03.49,Default,,0000,0000,0000,,Không, hoàn toàn không phải. Bộ não của tôi\Nchuyên biệt về các chức năng ngôn ngữ.
Dialogue: 0,0:14:04.37,0:14:09.11,Default,,0000,0000,0000,,Sau hai cuộc đại chiến, đất nước này đã vươn mình trỗi dậy\Nnhư một siêu cường kinh tế một lần nữa...
Dialogue: 0,0:14:09.11,0:14:14.14,Default,,0000,0000,0000,,...nhờ vào công nghệ làm sạch phóng xạ\Nmà tôi từng đóng vai trò là nhà sản xuất đứng sau.
Dialogue: 0,0:14:15.02,0:14:19.58,Default,,0000,0000,0000,,Vào thời điểm đó, tôi đã nghĩ rằng mình cũng sẽ thăng tiến\Nlên hàng ngũ những kẻ đứng đầu thiên hạ.
Dialogue: 0,0:14:19.89,0:14:25.09,Default,,0000,0000,0000,,Nhưng hệt như cái cách đất nước này không thể giành được vị thế nổi bật\Ntrên trường quốc tế,
Dialogue: 0,0:14:25.39,0:14:29.89,Default,,0000,0000,0000,,tôi cũng không thể nắm giữ một vị trí trọng yếu\Nbên trong hệ thống bộ máy quyền lực.
Dialogue: 0,0:14:30.53,0:14:36.33,Default,,0000,0000,0000,,Vậy ý ông là xã hội đã không dành bất kỳ giá trị cụ thể nào\Ncho một kẻ chỉ biết múa mép khua môi sao?
Dialogue: 0,0:14:37.14,0:14:45.20,Default,,0000,0000,0000,,Tôi đã nhận ra từ rất lâu trước đây rằng hệ thống xã hội hiện tại của chúng ta\Ncó một lỗ hổng cấu trúc chí mạng.
Dialogue: 0,0:14:46.58,0:14:47.72,Default,,0000,0000,0000,,Đó là gì?
Dialogue: 0,0:14:47.72,0:14:51.19,Default,,0000,0000,0000,,Sự suy thoái của thông tin, thứ mà đáng lẽ ra\Nkhông bao giờ được phép suy thoái...
Dialogue: 0,0:14:51.19,0:14:54.72,Default,,0000,0000,0000,,...và sự độc bản ảo tưởng\Nđược gọi là \"tính cá nhân\"...
Dialogue: 0,0:14:54.72,0:15:00.82,Default,,0000,0000,0000,,...rất dễ kích hoạt quá trình đồng bộ hóa mù quáng\Nbên trong hệ thống xã hội hiện tại của chúng ta.
Dialogue: 0,0:15:01.20,0:15:05.73,Default,,0000,0000,0000,,Tôi gọi đó là, \"hành vi sáng tạo\Ndưới danh nghĩa tiêu thụ\".
Dialogue: 0,0:15:05.73,0:15:09.27,Default,,0000,0000,0000,,Đó là kết luận mà một kẻ tự cô lập giam mình trong thế giới mạng\Nsẽ nghĩ ra.
Dialogue: 0,0:15:09.27,0:15:11.64,Default,,0000,0000,0000,,Ý cô là một hiện tượng phức hợp cô lập,\Nđúng chứ?
Dialogue: 0,0:15:11.64,0:15:16.27,Default,,0000,0000,0000,,May mắn thay, tôi có một sức chịu đựng\Nkhá phi thường đối với sự cô độc.
Dialogue: 0,0:15:17.28,0:15:20.45,Default,,0000,0000,0000,,Tuy nhiên, phải mất một khoảng thời gian khá dài trước khi\Ntôi nhận ra rằng lý do vì sao...
Dialogue: 0,0:15:20.45,0:15:24.25,Default,,0000,0000,0000,,...hệ thống đã không dành cho những đóng góp của tôi đối với xã hội\Nsự công nhận xứng đáng mà chúng đáng được nhận...
Dialogue: 0,0:15:24.69,0:15:28.92,Default,,0000,0000,0000,,...chính là vì thiên hướng tâm lý bẩm sinh\Nmà tôi đã mang trong mình từ thuở lọt lòng...
Dialogue: 0,0:15:28.92,0:15:31.98,Default,,0000,0000,0000,,...đã ngăn cản bọn họ\Nlàm điều đó.
Dialogue: 0,0:15:32.83,0:15:35.39,Default,,0000,0000,0000,,Nói cách khác, ông mang một mặc cảm\Ntự ti sâu sắc.
Dialogue: 0,0:15:35.50,0:15:39.09,Default,,0000,0000,0000,,Không, vấn đề nằm ở\Nchính sự tồn tại của tôi.
Dialogue: 0,0:15:39.57,0:15:45.47,Default,,0000,0000,0000,,Trong một xã hội, luôn tồn tại những nhân cách\Nmà chính hệ thống bộ máy khao khát có được.
Dialogue: 0,0:15:45.67,0:15:47.67,Default,,0000,0000,0000,,Người đời thèm muốn khao khát chúng.
Dialogue: 0,0:15:47.81,0:15:51.84,Default,,0000,0000,0000,,Nhưng bất chấp điều đó, họ lại hoàn toàn không nhận thức được\Nvề niềm khao khát đó đến mức nực cười.
Dialogue: 0,0:15:52.38,0:15:54.31,Default,,0000,0000,0000,,Và ông hài lòng với con người\Nmà ông đang là lúc này sao?
Dialogue: 0,0:15:54.72,0:15:56.62,Default,,0000,0000,0000,,Hài lòng hơn nhiều so với\Nnhững gì tôi từng kỳ vọng.
Dialogue: 0,0:15:57.59,0:16:01.09,Default,,0000,0000,0000,,Cô có nhận thức được sự thật rằng Ghost, thứ mà sự tồn tại của nó...
Dialogue: 0,0:16:01.09,0:16:03.49,Default,,0000,0000,0000,,...được chứng minh một cách nghịch lý\Nbởi chính thân xác vật lý,
Dialogue: 0,0:16:03.49,0:16:08.43,Default,,0000,0000,0000,,sẽ tự biến đổi diện mạo của mình để trùng khớp\Nvới diện mạo của thân xác vật lý hay không?
Dialogue: 0,0:16:08.76,0:16:09.89,Default,,0000,0000,0000,,Tôi không hẳn nghĩ vậy.
Dialogue: 0,0:16:10.20,0:16:13.69,Default,,0000,0000,0000,,Từng có một nhà tư tưởng nhìn thấy trong các cuộc cách mạng\Nlý do tồn tại của chính bản thân mình,
Dialogue: 0,0:16:13.87,0:16:16.67,Default,,0000,0000,0000,,và đã cố gắng thực hành những gì\Nmà ông ta rao giảng đấy thôi.
Dialogue: 0,0:16:17.27,0:16:19.47,Default,,0000,0000,0000,,Ý ông là\NPatrick Sylvestre?
Dialogue: 0,0:16:20.18,0:16:23.04,Default,,0000,0000,0000,,Tôi cũng từng một thời tôn sùng\Ntư tưởng của ông ấy.
Dialogue: 0,0:16:23.61,0:16:27.88,Default,,0000,0000,0000,,Tôi đã ngưỡng mộ người hùng của mình và thực lòng\Nhy vọng sẽ có được sức hút mị lực của ông ta.
Dialogue: 0,0:16:28.35,0:16:31.55,Default,,0000,0000,0000,,\"Ta là một kẻ đứng trên\Nmuôn người khác.\"
Dialogue: 0,0:16:31.75,0:16:36.42,Default,,0000,0000,0000,,Ý nghĩ đó đã choán lấy tâm trí tôi\Ntừ lúc tôi bắt đầu có nhận thức.
Dialogue: 0,0:16:36.86,0:16:42.32,Default,,0000,0000,0000,,Rốt cuộc, thân xác vật lý tầm thường đã cản bước tôi,\Nnhưng số phận đã đứng về phía tôi.
Dialogue: 0,0:16:43.10,0:16:45.70,Default,,0000,0000,0000,,Bị cuốn vào một vụ tai nạn khiến tôi phải cận kề\Ngiữa lằn ranh sinh tử,
Dialogue: 0,0:16:45.70,0:16:50.00,Default,,0000,0000,0000,,thân thể tôi đã trải qua một sự biến đổi diệu kỳ,\Nvà Ghost của tôi cũng bất ngờ thay đổi theo.
Dialogue: 0,0:16:50.51,0:16:54.38,Default,,0000,0000,0000,,Hệt như cái cách mà tác giả mà cô vừa nhắc tới\Nđã tình cờ bước chân vào một cuộc cách mạng,
Dialogue: 0,0:16:54.38,0:16:56.81,Default,,0000,0000,0000,,tôi cũng đã được trao cho\Nmột sứ mệnh thiêng liêng.
Dialogue: 0,0:16:57.55,0:17:02.51,Default,,0000,0000,0000,,Một sứ mệnh tái thiết lập lại hệ thống bộ máy\Nmang tên Quốc gia.
Dialogue: 0,0:17:02.82,0:17:06.81,Default,,0000,0000,0000,,Ông là một người ủng hộ cải cách quốc gia sao?\NHay chỉ là một kẻ mang chứng hoang tưởng tự đại?
Dialogue: 0,0:17:07.12,0:17:09.72,Default,,0000,0000,0000,,Thứ mà đất nước này đang tìm kiếm\Nngay lúc này chính là sự quay trở lại...
Dialogue: 0,0:17:09.72,0:17:15.39,Default,,0000,0000,0000,,...về một cõi cực lạc Shangri-la được xây dựng hoàn toàn\Ntrên lưng của những kẻ ngoại bang.
Dialogue: 0,0:17:15.93,0:17:20.09,Default,,0000,0000,0000,,Từng có một thời kỳ trong lịch sử đất nước này khi điều đó\Nđã trở thành hiện thực, dù chỉ là do tình cờ ngẫu nhiên.
Dialogue: 0,0:17:20.34,0:17:24.80,Default,,0000,0000,0000,,Ngay cả bây giờ, những kẻ không có động cơ\Nvẫn khao khát điều đó mà không hề nhận ra.
Dialogue: 0,0:17:25.14,0:17:28.11,Default,,0000,0000,0000,,Tất cả những gì tôi đang làm chỉ là trao cho họ\Nthứ mà họ đang thèm khát.
Dialogue: 0,0:17:28.18,0:17:30.51,Default,,0000,0000,0000,,Và tự biến mình thành một người hùng\Ntrong tiến trình đó sao?
Dialogue: 0,0:17:31.81,0:17:34.41,Default,,0000,0000,0000,,Bây giờ tôi không còn hứng thú\Nvới những thứ như thế nữa.
Dialogue: 0,0:17:34.52,0:17:38.25,Default,,0000,0000,0000,,Vai trò của tôi là trở thành nhà sản xuất đứng sau\Nnhững người hùng đó.
Dialogue: 0,0:17:38.75,0:17:44.63,Default,,0000,0000,0000,,Tạo ra một nhà hoạt động sẽ đại diện cho những kẻ thiếu động cơ\Nvà thực thi những gì họ hằng khao khát,
Dialogue: 0,0:17:44.63,0:17:47.93,Default,,0000,0000,0000,,nhưng lại không thể cất lên tiếng nói\Ncủa chính mình.
Dialogue: 0,0:17:49.10,0:17:53.63,Default,,0000,0000,0000,,Cái \"Shangri-la như một hệ quả của sự tiêu thụ\" đó\Ncó phải là nước Nhật Bản thời Chiến tranh Lạnh không?
Dialogue: 0,0:17:56.74,0:18:01.14,Default,,0000,0000,0000,,Vậy người hùng mà ông bảo\Nông đang sản xuất là ai?
Dialogue: 0,0:18:04.35,0:18:06.44,Default,,0000,0000,0000,,Có phải là\NNhóm 11 Cá Nhân không?
Dialogue: 0,0:18:17.23,0:18:18.32,Default,,0000,0000,0000,,Ối chết rồi!
Dialogue: 0,0:18:20.66,0:18:22.69,Default,,0000,0000,0000,,Này, có chuyện gì thế?
Dialogue: 0,0:18:26.80,0:18:30.26,Default,,0000,0000,0000,,Này, liên lạc với đội an ninh mau.\NChúng ta bị cướp mạng đột nhập rồi.
Dialogue: 0,0:18:36.38,0:18:38.54,Default,,0000,0000,0000,,Bọn chúng mất nhiều thời gian hơn\Ntôi tưởng đấy.
Dialogue: 0,0:18:39.58,0:18:41.88,Default,,0000,0000,0000,,Thiếu tá! Bọn chúng đã phát hiện ra\Nmàn đột nhập của chúng ta rồi!
Dialogue: 0,0:18:43.02,0:18:44.21,Default,,0000,0000,0000,,Tôi rõ rồi.
Dialogue: 0,0:18:44.99,0:18:48.49,Default,,0000,0000,0000,,Vậy kẻ thù của cái \"người hùng\" này\Ncủa ông là người tị nạn sao?
Dialogue: 0,0:18:48.49,0:18:52.69,Default,,0000,0000,0000,,Ông đang điều hướng tư tưởng của người dân bằng cách dựng lên\Nngười tị nạn như một kẻ thù tưởng tượng.
Dialogue: 0,0:18:52.86,0:18:54.13,Default,,0000,0000,0000,,Có đúng vậy không?
Dialogue: 0,0:18:54.13,0:18:58.86,Default,,0000,0000,0000,,Định hướng tư tưởng của họ là điều cần thiết.\NVà bẻ cong luật pháp để làm được điều đó cũng là điều hiển nhiên.
Dialogue: 0,0:18:59.17,0:19:01.36,Default,,0000,0000,0000,,Cứu cánh biện minh\Ncho phương tiện.
Dialogue: 0,0:19:01.44,0:19:05.77,Default,,0000,0000,0000,,Đó là lý thuyết được áp dụng bình đẳng cho cả những kẻ khủng bố\Nlẫn các quốc gia dân chủ.
Dialogue: 0,0:19:05.77,0:19:08.51,Default,,0000,0000,0000,,Ông đang bảo tôi rằng ý kiến đồng thuận chung\Ncủa người dân chúng ta là tống khứ người tị nạn đi sao?
Dialogue: 0,0:19:08.51,0:19:11.03,Default,,0000,0000,0000,,Sự khiêm nhường chính là đức tính cốt lõi\Ncủa người dân chúng ta.
Dialogue: 0,0:19:11.51,0:19:13.21,Default,,0000,0000,0000,,- Thiếu tá!\N- Tôi nghe rồi.
Dialogue: 0,0:19:13.48,0:19:17.01,Default,,0000,0000,0000,,Một câu hỏi cuối cùng. Thế còn\NĐội An ninh Công cộng 9 thì sao?
Dialogue: 0,0:19:17.35,0:19:20.41,Default,,0000,0000,0000,,Đội 9 sao?\NĐó là một câu hỏi hay đấy.
Dialogue: 0,0:19:21.86,0:19:25.19,Default,,0000,0000,0000,,Vòng xoáy thù hận dựa trên sự vắng mặt của lý do\Ngiờ đây không thể ngăn cản được nữa rồi.
Dialogue: 0,0:19:25.49,0:19:29.43,Default,,0000,0000,0000,,Tôi dự đoán rằng họ sẽ giằng xé đứng giữa lằn ranh\Ngiữa ý chí của nhân dân và công lý của chính mình,
Dialogue: 0,0:19:29.43,0:19:31.73,Default,,0000,0000,0000,,trong khi miệng không ngừng nghiến răng cay đắng\Nsuốt thời gian đó.
Dialogue: 0,0:19:31.80,0:19:34.36,Default,,0000,0000,0000,,Thiếu tá, cô sẽ gặp rắc rối lớn nếu\Nkhông ngắt kết nối đăng xuất ngay {\i1}lúc này{\i0} đấy!
Dialogue: 0,0:19:34.60,0:19:36.00,Default,,0000,0000,0000,,{\i1}Hết giờ rồi sao?{\i0}
Dialogue: 0,0:19:49.72,0:19:51.31,Default,,0000,0000,0000,,{\i1}Chúng tôi vừa tới{\i0}\N{\i1}Cổng số 6!{\i0}
Dialogue: 0,0:19:51.92,0:19:54.62,Default,,0000,0000,0000,,{\i1}Khi Cảnh sát Tỉnh định tiếp cận thẩm vấn một cô gái,{\i0}
Dialogue: 0,0:19:54.62,0:19:57.11,Default,,0000,0000,0000,,{\i1}cô ta đã bỏ chạy vào ga tàu điện ngầm,{\i0}\N{\i1}đe dọa sẽ tự kích nổ chính mình.{\i0}
Dialogue: 0,0:19:58.03,0:19:59.29,Default,,0000,0000,0000,,{\i1}Tôi đã yêu cầu họ dừng{\i0}\N{\i1}các đoàn tàu lại,{\i0}
Dialogue: 0,0:19:59.29,0:20:02.70,Default,,0000,0000,0000,,{\i1}nhưng hầu hết các chuyến tàu đã tiến vào nhà ga{\i0}\N{\i1}với toàn bộ hành khách bên trong.{\i0}
Dialogue: 0,0:20:03.40,0:20:04.80,Default,,0000,0000,0000,,{\i1}Bằng mọi giá{\i0}\N{\i1}hãy ngăn cô ta lại!{\i0}
Dialogue: 0,0:20:06.27,0:20:07.39,Default,,0000,0000,0000,,Cậu đi đường đó!
Dialogue: 0,0:20:09.74,0:20:10.73,Default,,0000,0000,0000,,Tên thủ phạm đang ở đâu?!
Dialogue: 0,0:20:17.58,0:20:19.77,Default,,0000,0000,0000,,{\i1}Tôi tìm thấy cô ta rồi.{\i0}\N{\i1}Đúng là người tị nạn rồi.{\i0}
Dialogue: 0,0:20:20.35,0:20:21.71,Default,,0000,0000,0000,,Tất cả mọi người đứng yên tại chỗ!
Dialogue: 0,0:20:23.89,0:20:26.91,Default,,0000,0000,0000,,Được rồi, bây giờ... Đặt hai tay\Nra sau đầu.
Dialogue: 0,0:20:31.43,0:20:33.49,Default,,0000,0000,0000,,Đúng rồi đấy.\NChúng tôi không làm hại cô đâu.
Dialogue: 0,0:20:33.80,0:20:35.85,Default,,0000,0000,0000,,Chầm chậm thôi.\NCứ bình tĩnh.
Dialogue: 0,0:20:51.85,0:20:52.78,Default,,0000,0000,0000,,Tránh ra mau!
Dialogue: 0,0:20:59.52,0:21:00.32,Default,,0000,0000,0000,,Sao anh lại nổ súng hả?!
Dialogue: 0,0:21:00.36,0:21:01.52,Default,,0000,0000,0000,,Đồ ngu xuẩn này!
Dialogue: 0,0:21:10.03,0:21:11.36,Default,,0000,0000,0000,,Đây là kíp nổ đấy!
Dialogue: 0,0:21:17.01,0:21:18.20,Default,,0000,0000,0000,,Gọi xe cấp cứu mau.
Dialogue: 0,0:21:18.84,0:21:22.21,Default,,0000,0000,0000,,Cô ta có một quả bom trong bụng,\Nnên hãy giữ cô ta cách ly tuyệt đối.
Dialogue: 0,0:21:22.31,0:21:23.50,Default,,0000,0000,0000,,V-Vâng, thưa sếp.
Dialogue: 0,0:21:40.70,0:21:43.36,Default,,0000,0000,0000,,Bộ phận an ninh đâu rồi?!\NTôi muốn kiểm tra tòa nhà từ trên xuống dưới ngay.
Dialogue: 0,0:21:43.36,0:21:45.92,Default,,0000,0000,0000,,Có vẻ như tên cướp mạng đã sử dụng mồi nhử\Nđể đích thân xâm nhập vào tòa nhà.
Dialogue: 0,0:21:46.70,0:21:49.50,Default,,0000,0000,0000,,Đám nhân viên an ninh làm cái trò gì thế hả?\NKích hoạt lại đội SAT mau!
Dialogue: 0,0:21:55.68,0:21:57.11,Default,,0000,0000,0000,,Kiểm tra rà soát virus.
Dialogue: 0,0:21:57.31,0:22:02.01,Default,,0000,0000,0000,,Một khi mảng phòng thủ được khởi động lại, hãy chuyển phần công việc còn lại\Nsang cho bên Poseidon xử lý.
Dialogue: 0,0:22:02.68,0:22:04.51,Default,,0000,0000,0000,,Tên trộm mạng đó sẽ không dám\Nquay lại đây nữa đâu.
Dialogue: 0,0:22:09.09,0:22:11.52,Default,,0000,0000,0000,,{\i1}Vậy là các anh đã kịp ngăn chặn{\i0}\N{\i1}vụ nổ cuối cùng rồi hả?{\i0}
Dialogue: 0,0:22:12.06,0:22:15.03,Default,,0000,0000,0000,,{\i1}Suýt soát trong gang tấc. Dù vậy chuyện này{\i0}\N{\i1}chắc chắn sẽ để lại những hậu quả nặng nề.{\i0}
Dialogue: 0,0:22:19.37,0:22:22.77,Default,,0000,0000,0000,,{\i1}Đây chính là một lời tuyên chiến{\i0}\N{\i1}từ phía người tị nạn.{\i0}
Dialogue: 0,0:22:24.34,0:22:27.10,Default,,0000,0000,0000,,{\i1}Tôi rất tiếc phải nói điều này Batou à,{\i0}\N{\i1}nhưng suy đoán của anh về chuyện này là hoàn toàn chính xác.{\i0}
Dialogue: 0,0:22:27.78,0:22:32.77,Default,,0000,0000,0000,,{\i1}Nhóm 11 Cá Nhân rất có thể là{\i0}\N{\i1}những phần tử cá nhân do Gohda nhào nặn sản xuất nên.{\i0}
Dialogue: 0,0:22:33.01,0:22:35.07,Default,,0000,0000,0000,,{\i1}Mục tiêu của bọn chúng là{\i0}\N{\i1}châm ngòi cho một cuộc nổi dậy của người tị nạn.{\i0}
Dialogue: 0,0:22:35.78,0:22:41.09,Default,,0000,0000,0000,,{\i1}Mục đích chính của chúng nhiều khả năng là tạo ra{\i0}\N{\i1}một khu tự trị cho riêng họ ngay bên trong nước Nhật.{\i0}
Dialogue: 0,0:22:45.03,0:22:46.82,Default,,0000,0000,0000,,{\i1}Cho đến nay chúng ta vẫn có số không tròn trĩnh{\i0}\N{\i1}ở cột chiến thắng.{\i0}
Dialogue: 0,0:22:47.26,0:22:51.49,Default,,0000,0000,0000,,{\i1}Vòng xoáy thù hận mà Gohda{\i0}\N{\i1}toan tính trong đầu chắc chắn đã bắt đầu rồi.{\i0}
