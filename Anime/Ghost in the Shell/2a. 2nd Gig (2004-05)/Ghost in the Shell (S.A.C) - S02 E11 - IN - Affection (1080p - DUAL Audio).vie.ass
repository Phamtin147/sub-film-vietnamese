Dialogue: 0,0:01:14.56,0:01:21.62,GitS 2nd Gig OP Credits,,0000,0000,0000,,{\i1\fs85\c&H00FF00&\fad(0,2000)}Chúng ta sẽ quật khởi hay lụi tàn...{\i0}
Dialogue: 0,0:01:47.33,0:01:48.73,Default,,0000,0000,0000,,{\i1}Đi vào nhà vệ sinh nữ à?{\i0}
Dialogue: 0,0:01:48.96,0:01:50.62,Default,,0000,0000,0000,,{\i1}Có vẻ là vậy.{\i0}
Dialogue: 0,0:01:52.23,0:01:53.22,Default,,0000,0000,0000,,{\i1}Chúng ta có bám theo không?{\i0}
Dialogue: 0,0:01:53.53,0:01:55.00,Default,,0000,0000,0000,,{\i1}Khoan đã nào.{\i0}
Dialogue: 0,0:01:56.57,0:01:59.16,Default,,0000,0000,0000,,{\i1}Tường và sàn nhà vệ sinh{\i0}\N{\i1}được lát gạch hoàn toàn.{\i0}
Dialogue: 0,0:01:59.67,0:02:02.94,Default,,0000,0000,0000,,{\i1}Cửa sổ là loại cố định{\i0}\N{\i1}và có chấn song nhôm bên ngoài.{\i0}
Dialogue: 0,0:02:03.64,0:02:07.98,Default,,0000,0000,0000,,{\i1}Tôi nghĩ cô ấy phá chúng dễ ợt, nhưng chắc{\i0}\N{\i1}cô ấy sẽ không làm điều gì thô bạo thế đâu.{\i0}
Dialogue: 0,0:02:38.48,0:02:40.14,Default,,0000,0000,0000,,Ngoài này nóng\Nnhư cái lò thiêu vậy...
Dialogue: 0,0:02:41.38,0:02:42.75,Default,,0000,0000,0000,,Có quà lưu niệm cho cậu đây.
Dialogue: 0,0:02:43.38,0:02:44.31,Default,,0000,0000,0000,,Bia á?
Dialogue: 0,0:02:44.68,0:02:48.88,Default,,0000,0000,0000,,Sướng thật đấy, có nhà máy nội tạng\Nphân giải cồn tự động như cậu...
Dialogue: 0,0:02:49.96,0:02:54.59,Default,,0000,0000,0000,,Cơ mà, anh không thấy độ khó của bài kiểm tra\Ndành cho tân binh này hơi quá trớn sao?
Dialogue: 0,0:02:54.76,0:02:55.69,Default,,0000,0000,0000,,Nghiêm túc đi.
Dialogue: 0,0:02:56.13,0:03:00.46,Default,,0000,0000,0000,,Nếu không vượt qua nổi bài kiểm tra thế này,\Nthì chứng tỏ chúng không đủ tố chất làm học viên.
Dialogue: 0,0:03:00.73,0:03:03.17,Default,,0000,0000,0000,,Thì đúng là vậy, nhưng mà...
Dialogue: 0,0:03:06.87,0:03:08.54,Default,,0000,0000,0000,,- {\i1}Batou.{\i0}\N{\i1}- Gì thế?{\i0}
Dialogue: 0,0:03:08.54,0:03:09.97,Default,,0000,0000,0000,,{\i1}Tình hình bên đó{\i0}\N{\i1}thế nào rồi?{\i0}
Dialogue: 0,0:03:10.04,0:03:12.14,Default,,0000,0000,0000,,{\i1}Đang đọc báo{\i0}\N{\i1}và nhâm nhi chút cà phê.{\i0}
Dialogue: 0,0:03:12.44,0:03:14.84,Default,,0000,0000,0000,,{\i1}Không phải anh.{\i0}\N{\i1}Ý tôi là đám tân binh kia kìa.{\i0}
Dialogue: 0,0:03:15.35,0:03:17.01,Default,,0000,0000,0000,,{\i1}Tôi cũng đang nói về chúng đấy.{\i0}
Dialogue: 0,0:03:17.52,0:03:19.21,Default,,0000,0000,0000,,{\i1}Chúng đang hoàn toàn thư giãn.{\i0}
Dialogue: 0,0:03:21.62,0:03:26.11,Default,,0000,0000,0000,,{\i1}Bọn họ không mảy may nghĩ đến khả năng{\i0}\N{\i1}mình đã bị cấy ký ức giả vào đầu sao?{\i0}
Dialogue: 0,0:03:26.49,0:03:28.93,Default,,0000,0000,0000,,{\i1}Đó là bài học đầu tiên{\i0}\N{\i1}mà tôi dạy chúng cách phát hiện đấy.{\i0}
Dialogue: 0,0:03:29.33,0:03:30.69,Default,,0000,0000,0000,,{\i1}Còn lại{\i0}\N{\i1}bao nhiêu người?{\i0}
Dialogue: 0,0:03:31.00,0:03:32.36,Default,,0000,0000,0000,,{\i1}Sáu người,\Nchia làm ba đội.{\i0}
Dialogue: 0,0:03:32.43,0:03:33.83,Default,,0000,0000,0000,,{\i1}Chuyển sang{\i0}\N{\i1}nhóm tiếp theo đi.{\i0}
Dialogue: 0,0:03:33.90,0:03:34.89,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:03:42.71,0:03:43.87,Default,,0000,0000,0000,,{\i1}Đây là nhóm cuối cùng rồi sao?{\i0}
Dialogue: 0,0:03:44.11,0:03:46.27,Default,,0000,0000,0000,,{\i1}Ừ, dù tôi rất ghét{\i0}\N{\i1}phải thừa nhận điều đó.{\i0}
Dialogue: 0,0:04:46.54,0:04:48.90,Default,,0000,0000,0000,,{\i1}Tôi xin lỗi, sếp!{\i0}\N{\i1}Tôi mất dấu mục tiêu rồi!{\i0}
Dialogue: 0,0:04:49.11,0:04:52.60,Default,,0000,0000,0000,,{\i1}Mất dấu rồi à?{\i0}\N{\i1}Vậy bước tiếp theo của cậu là gì?{\i0}
Dialogue: 0,0:04:53.01,0:04:55.05,Default,,0000,0000,0000,,{\i1}Chúng tôi sẽ thử rà soát lại{\i0}\N{\i1}khu vực này một lần nữa...{\i0}
Dialogue: 0,0:04:55.05,0:04:57.24,Default,,0000,0000,0000,,{\i1}Rà soát lại cơ đấy?{\i0}\N{\i1}Thế thì chúc may mắn nhé.{\i0}
Dialogue: 0,0:04:58.02,0:04:59.78,Default,,0000,0000,0000,,Anh có hơi khắt khe quá\Nvới chúng không đấy?
Dialogue: 0,0:04:59.85,0:05:01.34,Default,,0000,0000,0000,,Thương hại chúng thì\Nđược ích gì chứ?
Dialogue: 0,0:05:02.92,0:05:05.39,Default,,0000,0000,0000,,{\i1}Thiếu tá, xong rồi.{\i0}\N{\i1}Quay về trụ sở thôi.{\i0}
Dialogue: 0,0:05:06.69,0:05:07.85,Default,,0000,0000,0000,,{\i1}Thiếu tá?{\i0}
Dialogue: 0,0:05:09.63,0:05:10.62,Default,,0000,0000,0000,,{\i1}Thiếu tá ơi?{\i0}
Dialogue: 0,0:05:11.80,0:05:13.53,Default,,0000,0000,0000,,Không liên lạc được rồi.
Dialogue: 0,0:05:14.03,0:05:16.16,Default,,0000,0000,0000,,Anh nghĩ cô ấy bực mình\Nmà tự về trước rồi sao?
Dialogue: 0,0:05:35.52,0:05:36.82,Default,,0000,0000,0000,,{\i1}Bị hack rồi sao?{\i0}
Dialogue: 0,0:05:37.79,0:05:38.85,Default,,0000,0000,0000,,{\i1}Batou.{\i0}
Dialogue: 0,0:05:39.36,0:05:40.42,Default,,0000,0000,0000,,{\i1}Batou?{\i0}
Dialogue: 0,0:05:46.20,0:05:47.96,Default,,0000,0000,0000,,{\i1}Vậy là đúng bị hack thật rồi...{\i0}
Dialogue: 0,0:05:49.03,0:05:52.09,Default,,0000,0000,0000,,{\i1}Mình còn không cảm nhận được thứ gì vượt qua\Nđược bốn tầng rào chắn phòng thủ.{\i0}
Dialogue: 0,0:05:53.27,0:05:56.17,Default,,0000,0000,0000,,{\i1}Nếu đám học viên đứng sau vụ này,{\i0}\N{\i1}thì chúng cũng khá ấn tượng đấy.{\i0}
Dialogue: 0,0:06:14.53,0:06:17.50,GitS Signs B/W,,0000,0000,0000,,{\fs27\pos(966,433)}Tiệm Ký Ứ{\c&H725346&}c
Dialogue: 0,0:06:22.87,0:06:25.00,Default,,0000,0000,0000,,{\i1}Thì ra, đây là vạch đích sao?{\i0}
Dialogue: 0,0:06:41.75,0:06:43.74,Default,,0000,0000,0000,,{\i1}Cảm giác này là gì thế này?{\i0}
Dialogue: 0,0:06:46.02,0:06:49.26,Default,,0000,0000,0000,,{\i1}Cảm giác được thụ thể xúc giác của lớp da thu nhận\Nhoàn toàn là chân thực...{\i0}
Dialogue: 0,0:06:50.90,0:06:54.46,Default,,0000,0000,0000,,{\i1}Nhưng dẫu vậy, toàn bộ khung cảnh này\Nlại chẳng có vẻ gì là thực cả...{\i0}
Dialogue: 0,0:07:52.09,0:07:53.58,Default,,0000,0000,0000,,Cơ thể cyborg sao?
Dialogue: 0,0:08:07.41,0:08:08.90,Default,,0000,0000,0000,,Trông chúng đáng yêu phải không?
Dialogue: 0,0:08:09.31,0:08:10.74,Default,,0000,0000,0000,,Ý tôi là hai đứa trẻ ấy.
Dialogue: 0,0:08:13.11,0:08:15.34,Default,,0000,0000,0000,,Bà là người trông coi\Nnơi này sao?
Dialogue: 0,0:08:15.48,0:08:17.35,Default,,0000,0000,0000,,Cũng đại loại là vậy.
Dialogue: 0,0:08:17.78,0:08:20.55,Default,,0000,0000,0000,,Cô có món gì muốn gửi\Ntôi trông nom giúp không?
Dialogue: 0,0:08:21.02,0:08:22.15,Default,,0000,0000,0000,,Trông nom ư?
Dialogue: 0,0:08:22.55,0:08:23.52,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:08:23.79,0:08:28.23,Default,,0000,0000,0000,,Khách hàng gửi lại ký ức ngoại vi\Nở chỗ tôi, và tôi sẽ gìn giữ chúng.
Dialogue: 0,0:08:29.93,0:08:34.70,Default,,0000,0000,0000,,Mọi món đồ ở đây có thể trông hoàn toàn vô giá trị\Ntrong mắt người khác,
Dialogue: 0,0:08:34.83,0:08:39.17,Default,,0000,0000,0000,,nhưng từng món một đều được đong đầy\Nbởi những ký ức của chủ nhân chúng.
Dialogue: 0,0:08:39.24,0:08:42.64,Default,,0000,0000,0000,,Chính vì thế mà đôi lúc tôi cảm thấy\Nngột ngạt như muốn ngạt thở...
Dialogue: 0,0:08:42.64,0:08:45.67,Default,,0000,0000,0000,,...trước những dấu ấn tâm linh\Nmà chúng tỏa ra.
Dialogue: 0,0:08:46.38,0:08:48.11,Default,,0000,0000,0000,,Dấu ấn tâm linh...
Dialogue: 0,0:08:56.99,0:09:01.25,Default,,0000,0000,0000,,Cô cũng được chúng\Nchỉ lối đến đây sao?
Dialogue: 0,0:09:05.20,0:09:09.69,Default,,0000,0000,0000,,Đây là những món đồ hiếm hoi, được tạo ra từ thuở\Nsơ khai của những cơ thể cyborg toàn phần.
Dialogue: 0,0:09:10.20,0:09:15.20,Default,,0000,0000,0000,,Những ký ức bao quanh hai đứa trẻ này\Nluôn khiến lòng tôi đau nhói.
Dialogue: 0,0:09:16.41,0:09:20.08,Default,,0000,0000,0000,,Nhưng đồng thời, nó cũng cho tôi\Nđược trải nghiệm...
Dialogue: 0,0:09:20.08,0:09:23.14,Default,,0000,0000,0000,,...niềm hạnh phúc khi được gìn giữ\Nký ức của người khác.
Dialogue: 0,0:09:24.02,0:09:26.61,Default,,0000,0000,0000,,Bà cảm nhận được loại ký ức nào\Ngiữa hai đứa...
Dialogue: 0,0:09:27.85,0:09:30.05,Default,,0000,0000,0000,,Ôi chao, đã muộn thế này\Nrồi cơ à?
Dialogue: 0,0:09:30.56,0:09:33.58,Default,,0000,0000,0000,,Thành thật xin lỗi cô nhé,\Nhôm nay tôi phải đóng cửa sớm rồi.
Dialogue: 0,0:09:33.66,0:09:35.99,Default,,0000,0000,0000,,Hôm nào rảnh rỗi,\Nmời cô lại ghé qua.
Dialogue: 0,0:09:35.99,0:09:39.93,Default,,0000,0000,0000,,Lúc đó tôi sẽ kể cho cô\Nnghe tất cả về chúng.
Dialogue: 0,0:09:55.85,0:09:57.28,Default,,0000,0000,0000,,À, mình hiểu rồi...
Dialogue: 0,0:09:58.82,0:10:02.22,Default,,0000,0000,0000,,Cảm giác kỳ lạ đó...\NChính là hoài niệm.
Dialogue: 0,0:10:08.83,0:10:12.49,Default,,0000,0000,0000,,Thôi nào, anh bạn to con.\NChúng ta cũng nghỉ ngơi thôi.
Dialogue: 0,0:10:12.80,0:10:15.36,Default,,0000,0000,0000,,Mai rồi hãy báo cáo\Ncho Thiếu tá.
Dialogue: 0,0:10:18.84,0:10:22.14,Default,,0000,0000,0000,,Chết tiệt, Thiếu tá, đừng có biến mất\Nđột ngột như thế chứ.
Dialogue: 0,0:10:22.54,0:10:24.27,Default,,0000,0000,0000,,Rốt cuộc thì cô đã\Nđi đâu vậy?
Dialogue: 0,0:10:25.28,0:10:26.27,Default,,0000,0000,0000,,Đi loanh quanh thôi.
Dialogue: 0,0:10:27.05,0:10:30.91,Default,,0000,0000,0000,,Vậy có bao nhiêu ứng viên triển vọng\Ncó thể gia nhập đội?
Dialogue: 0,0:10:31.32,0:10:34.22,Default,,0000,0000,0000,,Chỉ có duy nhất một gã xuất thân\Ntừ Cục Tình báo Quân sự GSDA...
Dialogue: 0,0:10:34.79,0:10:37.41,Default,,0000,0000,0000,,...được người quen của Sếp già tiến cử.
Dialogue: 0,0:10:37.62,0:10:39.18,Default,,0000,0000,0000,,Nghe không yên tâm\Nchút nào cả...
Dialogue: 0,0:10:39.56,0:10:41.56,Default,,0000,0000,0000,,Tôi không thể phủ nhận việc thiếu hụt\Nnhân sự chất lượng cao,
Dialogue: 0,0:10:41.56,0:10:44.72,Default,,0000,0000,0000,,nhưng có một điều chắc chắn là chúng ta\Nđang cực kỳ khát thêm người.
Dialogue: 0,0:10:45.30,0:10:50.20,Default,,0000,0000,0000,,Nhưng nếu hạ chuẩn xuống thấp hơn nữa,\Nthì chỉ làm suy yếu toàn đội mà thôi.
Dialogue: 0,0:10:51.04,0:10:54.73,Default,,0000,0000,0000,,Thế giờ tính sao? Tổ chức kiểm tra lại\Nvào một ngày khác à?
Dialogue: 0,0:10:54.94,0:10:57.10,Default,,0000,0000,0000,,Tôi sẽ bàn lại với Sếp già\Nrồi mới quyết định.
Dialogue: 0,0:10:57.18,0:11:00.58,Default,,0000,0000,0000,,Này, cậu thấy tôi có tố chất\Nlàm người hướng dẫn không?
Dialogue: 0,0:11:02.55,0:11:06.11,Default,,0000,0000,0000,,Nếu anh mà không đủ tố chất,\Nthì chẳng ai làm nổi đâu.
Dialogue: 0,0:11:06.52,0:11:08.54,Default,,0000,0000,0000,,Tôi xin phép\Nnghỉ trước đây.
Dialogue: 0,0:11:08.92,0:11:10.18,Default,,0000,0000,0000,,Trông chừng doanh trại nhé.
Dialogue: 0,0:11:13.69,0:11:15.28,Default,,0000,0000,0000,,Thôi nào, bận tâm làm gì.
Dialogue: 0,0:11:15.39,0:11:19.33,Default,,0000,0000,0000,,Ngay cả tôi, trước khi về Đội 9,\Ncũng bị Thiếu tá cắt đuôi chỉ sau 5 phút thôi.
Dialogue: 0,0:11:19.63,0:11:22.10,Default,,0000,0000,0000,,Hả, thật á? Thế thì tôi đoán trình độ\Ncủa anh cũng thường thôi.
Dialogue: 0,0:11:22.40,0:11:23.49,Default,,0000,0000,0000,,Cậu nói cái gì cơ?!
Dialogue: 0,0:11:23.97,0:11:26.91,Default,,0000,0000,0000,,Vậy ý cậu là cậu có thể bám đuôi\Nmột mục tiêu...
Dialogue: 0,0:11:26.91,0:11:29.60,Default,,0000,0000,0000,,...vốn có thể bốc hơi biến mất\Nnhư Thiếu tá sao?
Dialogue: 0,0:11:33.08,0:11:34.88,Default,,0000,0000,0000,,Chắc chắn là làm được.
Dialogue: 0,0:11:37.42,0:11:38.88,Default,,0000,0000,0000,,Mộng du giữa ban ngày à?
Dialogue: 0,0:11:39.65,0:11:42.25,Default,,0000,0000,0000,,Tôi không chắc, nhưng nó có thể là thứ gì đó...\Nmang tính tâm linh hơn thế.
Dialogue: 0,0:11:42.75,0:11:44.19,Default,,0000,0000,0000,,À thì, mỗi khi trở mình trong lúc ngủ,
Dialogue: 0,0:11:44.19,0:11:47.32,Default,,0000,0000,0000,,thỉnh thoảng tôi cũng xuất hồn ra khỏi xác\Nvà nhìn thấy vài thứ khá kỳ quái...
Dialogue: 0,0:11:47.83,0:11:48.82,Default,,0000,0000,0000,,Thật thế sao?
Dialogue: 0,0:11:49.43,0:11:52.95,Default,,0000,0000,0000,,Thế anh đã bao giờ cảm nhận được năng lượng tâm linh\Ntừ thứ đồ nào thuộc quyền sở hữu của mình chưa?
Dialogue: 0,0:11:54.00,0:11:57.64,Default,,0000,0000,0000,,Ừ thì, tôi từng có cảm giác chiếc xe của mình...
Dialogue: 0,0:11:57.64,0:12:01.37,Default,,0000,0000,0000,,...giống như cánh tay và đôi chân nối dài của tôi\Ntrong những chuyến lái xe đường dài, nếu đúng ý cô là vậy.
Dialogue: 0,0:12:02.11,0:12:05.41,Default,,0000,0000,0000,,Này, hay là mình rủ Courtin đi quẩy\Nmột bữa ra trò đi?
Dialogue: 0,0:12:05.48,0:12:09.38,Default,,0000,0000,0000,,Tôi xin kiếu. Hôm nay tôi có việc\Nbắt buộc phải làm rồi.
Dialogue: 0,0:12:13.02,0:12:17.08,Default,,0000,0000,0000,,{\i1}Quái quỷ thật, Thiếu tá đang làm gì mà lại đi lại{\i0}\N{\i1}đúng lộ trình hôm qua thế kia?{\i0}
Dialogue: 0,0:12:41.31,0:12:44.15,Default,,0000,0000,0000,,{\i1}Liệu cô ấy có nhận ra{\i0}\N{\i1}mình đang bám theo không?{\i0}
Dialogue: 0,0:12:48.19,0:12:50.12,Default,,0000,0000,0000,,Tôi đã đợi cô đấy.
Dialogue: 0,0:12:51.56,0:12:53.96,Default,,0000,0000,0000,,Tôi có linh cảm rằng cô sẽ đến\Nvào tầm giờ này.
Dialogue: 0,0:12:54.49,0:12:55.72,Default,,0000,0000,0000,,Tại sao vậy bà?
Dialogue: 0,0:12:56.76,0:12:59.42,Default,,0000,0000,0000,,Bởi vì hai đứa nhỏ này\Ncũng sốt ruột chờ cô lắm rồi.
Dialogue: 0,0:13:00.90,0:13:02.03,Default,,0000,0000,0000,,Vậy sao.
Dialogue: 0,0:13:02.53,0:13:05.20,Default,,0000,0000,0000,,Thế thì cháu muốn vào thẳng vấn đề\Nvà nghe về hai đứa trẻ này.
Dialogue: 0,0:13:05.64,0:13:07.57,Default,,0000,0000,0000,,Chà chà, cô quả là nôn nóng...
Dialogue: 0,0:13:08.71,0:13:09.70,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:13:10.41,0:13:15.71,Default,,0000,0000,0000,,Hai cơ thể cyborg này từng được cậu bé\Ngìn giữ và chăm sóc vô cùng cẩn thận,
Dialogue: 0,0:13:15.71,0:13:18.48,Default,,0000,0000,0000,,cậu bé ấy giờ đây\Nđã trở thành một người đàn ông.
Dialogue: 0,0:13:26.46,0:13:30.22,Default,,0000,0000,0000,,Năm cậu bé lên sáu tuổi,\Ncậu đã gặp phải một vụ tai nạn máy bay.
Dialogue: 0,0:13:30.76,0:13:34.36,Default,,0000,0000,0000,,Nghe đâu đó là một thảm kịch kinh hoàng\Nkhiến phần lớn hành khách thiệt mạng.
Dialogue: 0,0:13:34.67,0:13:39.19,Default,,0000,0000,0000,,Tôi nghe nói ngay cả những người được cứu thoát\Ncũng đều qua đời không lâu sau đó.
Dialogue: 0,0:13:39.84,0:13:45.67,Default,,0000,0000,0000,,Tất cả, ngoại trừ cậu bé này và một bé gái\Ntình cờ ngồi ở ghế bên cạnh cậu.
Dialogue: 0,0:13:46.14,0:13:51.64,Default,,0000,0000,0000,,Hai đứa trẻ đã sống sót một cách kỳ diệu,\Nnhưng bé gái lại chẳng bao giờ tỉnh lại,
Dialogue: 0,0:13:52.22,0:13:57.12,Default,,0000,0000,0000,,còn cậu bé thì bị liệt toàn thân,\Nngoại trừ cánh tay trái.
Dialogue: 0,0:14:01.59,0:14:07.96,Default,,0000,0000,0000,,Khi các vết thương đã lành lặn,\Ncậu bé lập tức thấu hiểu hoàn cảnh của mình.
Dialogue: 0,0:14:08.60,0:14:12.04,Default,,0000,0000,0000,,Như sự thật rằng cha mẹ đi cùng chuyến bay\Nđều đã qua đời,
Dialogue: 0,0:14:12.30,0:14:17.26,Default,,0000,0000,0000,,và lý do vì sao những người họ hàng xa,\Nvốn ban đầu ân cần đến thăm hỏi,
Dialogue: 0,0:14:17.58,0:14:20.07,Default,,0000,0000,0000,,lại dần dần xa lánh\Nvà lảng tránh cậu bé.
Dialogue: 0,0:14:20.31,0:14:25.31,Default,,0000,0000,0000,,Cậu bé đã cố hết sức để đón nhận mọi điều\Nbằng tâm trí non nớt của mình.
Dialogue: 0,0:14:26.22,0:14:30.95,Default,,0000,0000,0000,,Và rồi cậu bắt đầu xem cô bé nằm ngủ\Nở chiếc giường bệnh bên cạnh,
Dialogue: 0,0:14:31.22,0:14:34.92,Default,,0000,0000,0000,,cô bé cũng chịu chung số phận nghiệt ngã như mình,\Nlà người bạn duy nhất trên cõi đời này.
Dialogue: 0,0:14:37.36,0:14:39.85,Default,,0000,0000,0000,,"Xin hãy để cho\Ncậu ấy tỉnh lại."
Dialogue: 0,0:14:40.23,0:14:43.23,Default,,0000,0000,0000,,Cậu bé đã cầu nguyện điều đó hết lần này đến lần khác,\Ntrong khi nhẫn nại tiếp tục...
Dialogue: 0,0:14:43.23,0:14:45.33,Default,,0000,0000,0000,,...gấp những con hạc giấy\Nbằng cánh tay lành lặn duy nhất.
Dialogue: 0,0:14:50.64,0:14:51.73,Default,,0000,0000,0000,,Nhưng rồi...
Dialogue: 0,0:14:52.04,0:14:54.71,Default,,0000,0000,0000,,Đã có chuyện xảy ra với cô bé đó\Nphải không bà?
Dialogue: 0,0:14:54.91,0:14:58.51,Default,,0000,0000,0000,,Một thời gian sau, tình trạng của cô bé\Nđột ngột chuyển biến xấu.
Dialogue: 0,0:15:02.05,0:15:03.88,Default,,0000,0000,0000,,Huyết áp 60. Mất huyết áp tâm trương.
Dialogue: 0,0:15:04.36,0:15:06.29,Default,,0000,0000,0000,,Tiêm ngay một đơn vị Lidocaine và Epinephrine!
Dialogue: 0,0:15:06.59,0:15:08.12,Default,,0000,0000,0000,,Không bắt được chỉ số ECF.
Dialogue: 0,0:15:08.79,0:15:10.23,Default,,0000,0000,0000,,Huyết áp tụt xuống 40 rồi.
Dialogue: 0,0:15:11.16,0:15:12.72,Default,,0000,0000,0000,,Chuẩn bị phòng mổ khẩn cấp!
Dialogue: 0,0:15:16.30,0:15:22.07,Default,,0000,0000,0000,,Sáng hôm sau, người ta nói với cậu bé rằng\Ncô bé ấy đã đi đến một nơi rất xa.
Dialogue: 0,0:15:40.83,0:15:42.62,Default,,0000,0000,0000,,Hai năm trôi qua.
Dialogue: 0,0:15:43.19,0:15:51.10,Default,,0000,0000,0000,,Cậu không nói chuyện với ai, chỉ lặng lẽ\Ndành từng ngày gấp những con hạc giấy.
Dialogue: 0,0:16:01.05,0:16:03.74,Default,,0000,0000,0000,,Cứ như thể việc tiếp tục\Ngấp những con hạc đó...
Dialogue: 0,0:16:04.55,0:16:09.08,Default,,0000,0000,0000,,...là một nghĩa vụ thiêng liêng\Nđược giao phó cho cậu.
Dialogue: 0,0:16:10.46,0:16:12.02,Default,,0000,0000,0000,,Hôm nay thằng bé có nói gì không?
Dialogue: 0,0:16:12.02,0:16:14.36,Default,,0000,0000,0000,,Chỉ bảo là muốn thêm\Nvài tờ giấy gấp hạc màu trắng.
Dialogue: 0,0:16:14.66,0:16:18.10,Default,,0000,0000,0000,,Rồi một ngày nọ, khi các thủ tục pháp lý\Nvề vụ tai nạn đã hoàn tất,
Dialogue: 0,0:16:18.20,0:16:22.53,Default,,0000,0000,0000,,một người họ hàng của cậu bé\Nđã đến cùng với một bác sĩ trẻ.
Dialogue: 0,0:16:22.97,0:16:24.73,Default,,0000,0000,0000,,Họ đã nói với cậu bé\Nnhững lời này.
Dialogue: 0,0:16:26.64,0:16:28.54,Default,,0000,0000,0000,,"Nếu cháu muốn,"
Dialogue: 0,0:16:28.97,0:16:33.50,Default,,0000,0000,0000,,"thì có một phương pháp điều trị cho phép chúng ta\Nthay thế hoàn toàn cơ thể bại liệt của cháu."
Dialogue: 0,0:16:33.78,0:16:36.18,Default,,0000,0000,0000,,"Cháu có đủ dũng cảm\Nđể thử không?"
Dialogue: 0,0:16:36.75,0:16:41.48,Default,,0000,0000,0000,,"Nếu mọi chuyện diễn ra theo đúng kế hoạch, cháu sẽ có thể\Nsống một cuộc đời bình thường như trước kia."
Dialogue: 0,0:16:44.29,0:16:46.88,Default,,0000,0000,0000,,Cậu bé không trả lời.
Dialogue: 0,0:16:47.56,0:16:50.72,Default,,0000,0000,0000,,Nhưng không phải là vì cậu bé\Nkhông đủ dũng cảm.
Dialogue: 0,0:16:50.93,0:16:52.36,Default,,0000,0000,0000,,Cô có biết vì sao không?
Dialogue: 0,0:16:52.66,0:16:57.80,Default,,0000,0000,0000,,Đó là vì cậu bé chẳng còn động lực nào\Nđể {\i1}muốn{\i0} quay lại cuộc sống bình thường trước kia.
Dialogue: 0,0:16:58.47,0:17:04.67,Default,,0000,0000,0000,,Dẫu sao, vào lúc đó cậu bé chẳng còn thiết tha\Nbất cứ điều gì ngoài việc gấp hạc nữa.
Dialogue: 0,0:17:04.98,0:17:10.97,Default,,0000,0000,0000,,Và thế là, những người lớn xung quanh\Nđành bỏ cuộc trong việc thuyết phục cậu.
Dialogue: 0,0:17:11.62,0:17:17.82,Default,,0000,0000,0000,,Nhưng đã có một cô bé trao cho cậu sự khích lệ\Ncần thiết để mở lòng.
Dialogue: 0,0:17:18.56,0:17:19.99,Default,,0000,0000,0000,,À, ra cô bé đó\Nchính là người này.
Dialogue: 0,0:17:20.29,0:17:26.82,Default,,0000,0000,0000,,Phải. Cô bé này khi đó đã tiếp nhận thành công\Nliệu trình cơ thể cyborg toàn phần.
Dialogue: 0,0:17:27.53,0:17:32.60,Default,,0000,0000,0000,,Tôi đoán vị bác sĩ trẻ tuổi đã giới thiệu\Nhài đứa với nhau...
Dialogue: 0,0:17:32.60,0:17:34.90,Default,,0000,0000,0000,,...như một tia hy vọng cuối cùng\Nnhằm thuyết phục cậu bé.
Dialogue: 0,0:17:36.11,0:17:40.01,Default,,0000,0000,0000,,Nghe đâu, ngày nào cô bé\Ncũng đến thăm cậu.
Dialogue: 0,0:17:41.05,0:17:44.31,Default,,0000,0000,0000,,Đó là một cô bé vui tươi,\Ntràn đầy năng lượng.
Dialogue: 0,0:17:45.12,0:17:49.02,Default,,0000,0000,0000,,Dù chắc hẳn đã vô cùng khó khăn để cô bé\Nlàm quen với một cơ thể cyborg toàn phần,
Dialogue: 0,0:17:49.02,0:17:52.55,Default,,0000,0000,0000,,nhưng cô bé chưa từng hé môi nửa lời\Nvề điều đó với cậu.
Dialogue: 0,0:17:53.02,0:17:55.69,Default,,0000,0000,0000,,Không những thế, mỗi khi nhắc đến chuyện đó,\Ncô bé còn khuyên...
Dialogue: 0,0:17:55.69,0:17:57.89,Default,,0000,0000,0000,,...cậu bé cũng hãy chuyển sang\Ncơ thể cyborg toàn phần như mình.
Dialogue: 0,0:17:58.50,0:18:03.66,Default,,0000,0000,0000,,Cậu bé chỉ im lặng lắng nghe, nhưng rồi một ngày nọ,\Ncậu chợt buột miệng hỏi,
Dialogue: 0,0:18:04.34,0:18:06.97,Default,,0000,0000,0000,,"Cơ thể cyborg của cậu có gấp được\Nhạc giấy origami không?"
Dialogue: 0,0:18:06.97,0:18:11.20,Default,,0000,0000,0000,,"Nếu cậu làm được, thì tớ nghĩ tớ cũng không ngại\Nchuyển sang cơ thể cyborg toàn phần đâu."
Dialogue: 0,0:18:14.25,0:18:17.37,Default,,0000,0000,0000,,Thế nhưng, dù cô bé đã có thể tự đứng vững\Nvà đi lại được,
Dialogue: 0,0:18:17.78,0:18:22.45,Default,,0000,0000,0000,,cô bé vẫn chưa thể truyền mệnh lệnh cho những cử động\Ntinh tế, tỉ mỉ của cơ thể.
Dialogue: 0,0:18:24.16,0:18:26.89,Default,,0000,0000,0000,,Có lẽ cô bé ấy là người\Nkhông chịu thua kém ai...
Dialogue: 0,0:18:27.19,0:18:30.46,Default,,0000,0000,0000,,Nên cô bé đã kiên trì cố hết lần này đến lần khác\Nđể gấp bằng được một con hạc.
Dialogue: 0,0:18:31.43,0:18:35.80,Default,,0000,0000,0000,,Tôi tin rằng cô bé chính là nguồn hy vọng\Ndành cho cậu bé.
Dialogue: 0,0:18:36.23,0:18:39.83,Default,,0000,0000,0000,,Thế nhưng lúc ấy cả hai\Nvẫn còn quá nhỏ...
Dialogue: 0,0:19:11.34,0:19:13.44,Default,,0000,0000,0000,,Cậu bé trở nên nản lòng,\Nvà nói rằng,
Dialogue: 0,0:19:13.44,0:19:19.97,Default,,0000,0000,0000,,"Nếu không thể tiếp tục gấp hạc cho bạn gái đã mất,\Nthì tớ chấp nhận cứ giữ nguyên như thế này."
Dialogue: 0,0:19:21.01,0:19:25.57,Default,,0000,0000,0000,,Kể từ sau hôm đó, cậu bé\Nchẳng bao giờ gặp lại cô bé ấy nữa.
Dialogue: 0,0:19:25.85,0:19:28.69,Default,,0000,0000,0000,,Cô bé rời đi, và nói rằng: "Tớ sẽ tập luyện\Nđể gấp được hạc giấy...
Dialogue: 0,0:19:28.69,0:19:31.05,Default,,0000,0000,0000,,...để tớ có thể gấp cho {\i1}cậu,{\i0} nhé?"
Dialogue: 0,0:19:32.62,0:19:38.39,Default,,0000,0000,0000,,Phải, cô bé chính là người bạn mà cậu đinh ninh\Nlà đã không còn trên cõi đời này nữa.
Dialogue: 0,0:19:39.66,0:19:42.86,Default,,0000,0000,0000,,Tại sao cô bé lại không nói\Ncho cậu ấy biết chứ?
Dialogue: 0,0:19:43.74,0:19:46.83,Default,,0000,0000,0000,,Hẳn cô bé phải có một lý do vô cùng\Nkhó nói nào đó.
Dialogue: 0,0:19:50.17,0:19:55.11,Default,,0000,0000,0000,,Thế nhưng ngày hôm ấy, cậu bé cũng đã hạ quyết tâm\Ntiếp nhận một cơ thể cyborg.
Dialogue: 0,0:19:55.31,0:19:58.21,Default,,0000,0000,0000,,Và cậu đã tự thề với lòng mình\Nrằng cậu sẽ đi tìm...
Dialogue: 0,0:19:58.28,0:20:00.72,Default,,0000,0000,0000,,...cô bé đã biến mất\Nkhỏi bệnh viện năm xưa.
Dialogue: 0,0:20:01.92,0:20:05.52,Default,,0000,0000,0000,,Một thời gian sau, cậu bé được chuyển đổi\Nthành cơ thể cyborg toàn phần...
Dialogue: 0,0:20:05.52,0:20:07.55,Default,,0000,0000,0000,,...và kiên cường vượt qua quá trình\Nphục hồi chức năng đầy gian khổ,
Dialogue: 0,0:20:07.73,0:20:11.18,Default,,0000,0000,0000,,để rồi lớn lên trở thành một chuyên gia sử dụng\Ncơ thể cyborg cự phách.
Dialogue: 0,0:20:12.26,0:20:17.00,Default,,0000,0000,0000,,Vì vào thời kỳ đó chưa có nhiều trẻ em mang\Ncơ thể cyborg toàn phần,
Dialogue: 0,0:20:17.14,0:20:20.66,Default,,0000,0000,0000,,nên điều đó hẳn gian nan hơn bất cứ ai\Ncó thể tưởng tượng được.
Dialogue: 0,0:20:20.74,0:20:25.47,Default,,0000,0000,0000,,Nhưng mỗi khi nghĩ về việc cô bé ấy\Ncũng từng nếm trải nỗi đau tương tự,
Dialogue: 0,0:20:25.68,0:20:28.20,Default,,0000,0000,0000,,cậu bé lại có thể vượt qua nó\Nmột cách nhẹ nhàng.
Dialogue: 0,0:20:30.31,0:20:34.15,Default,,0000,0000,0000,,Vậy xin bà hãy nói cho cháu biết,\Ncậu ấy có tìm thấy cô bé không?
Dialogue: 0,0:20:34.45,0:20:38.01,Default,,0000,0000,0000,,Một bé gái mang cơ thể cyborg toàn phần\Ntừng gặp tai nạn máy bay...
Dialogue: 0,0:20:38.09,0:20:41.06,Default,,0000,0000,0000,,Người ta ngỡ chừng ngần ấy manh mối\Nđã là quá đủ để lần ra.
Dialogue: 0,0:20:41.09,0:20:43.99,Default,,0000,0000,0000,,Nhưng cậu bé đã không thể\Ntìm thấy cô bé ấy.
Dialogue: 0,0:20:44.03,0:20:46.86,Default,,0000,0000,0000,,Thế thì cậu ấy tìm thấy cơ thể cyborg\Ncủa cô bé ở đâu?
Dialogue: 0,0:20:47.57,0:20:53.66,Default,,0000,0000,0000,,Nghe đâu cậu tìm thấy nó được bảo quản như tiêu bản\Ntại một phòng thí nghiệm thời đại học.
Dialogue: 0,0:20:54.57,0:20:59.51,Default,,0000,0000,0000,,Cậu nhận ra ngay đó chính là cô bé\Nmà mình tìm kiếm bấy lâu,
Dialogue: 0,0:20:59.94,0:21:03.85,Default,,0000,0000,0000,,nhưng cậu chẳng thể nào lần ra tung tích của cô bé,\Nngười vốn đã chuyển sang một cơ thể trưởng thành hơn.
Dialogue: 0,0:21:04.58,0:21:09.42,Default,,0000,0000,0000,,Đó là lý do vì sao ký ức tôi nhận được từ cô bé\Nđến tận bây giờ vẫn hoàn toàn trống rỗng.
Dialogue: 0,0:21:10.35,0:21:12.82,Default,,0000,0000,0000,,Còn cậu bé thì sao?\NCậu ấy...
Dialogue: 0,0:21:13.56,0:21:17.86,Default,,0000,0000,0000,,Vào những ngày cuối của cuộc chiến tranh, cậu ấy\Nđã được điều động ra nước ngoài và bặt vô âm tín.
Dialogue: 0,0:21:18.16,0:21:24.26,Default,,0000,0000,0000,,Kể từ đó cậu không trở lại đây nữa, nên tôi nghĩ\Nkhả năng là cậu ấy đã hy sinh rồi.
Dialogue: 0,0:21:26.14,0:21:27.50,Default,,0000,0000,0000,,Ra là vậy...
Dialogue: 0,0:21:31.84,0:21:33.67,Default,,0000,0000,0000,,Cảm ơn bà đã kể cho cháu nghe\Ncâu chuyện này.
Dialogue: 0,0:21:34.01,0:21:39.51,Default,,0000,0000,0000,,Tôi dám cá là ngay cả lúc này, cô gái ấy vẫn đang đi tìm\Nchàng trai đầu tiên mà cô từng đem lòng yêu thương.
Dialogue: 0,0:21:40.15,0:21:42.24,Default,,0000,0000,0000,,Chàng trai đầu tiên\Ncô ấy từng yêu sao?
Dialogue: 0,0:22:09.51,0:22:11.95,Default,,0000,0000,0000,,Đá trong ly trà của cô\Ntan hết cả rồi kìa.
Dialogue: 0,0:22:12.12,0:22:13.28,Default,,0000,0000,0000,,Ừ, tôi biết rồi.
Dialogue: 0,0:22:14.09,0:22:15.07,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:22:15.39,0:22:18.15,Default,,0000,0000,0000,,À thì, chuyện bài kiểm tra\Ndành cho tân binh ấy mà...
Dialogue: 0,0:22:18.36,0:22:22.99,Default,,0000,0000,0000,,Tôi muốn cân nhắc lại mức độ khó,\Nvà cho chúng thử sức thêm lần nữa.
Dialogue: 0,0:22:23.26,0:22:24.49,Default,,0000,0000,0000,,Cô thấy thế nào?
Dialogue: 0,0:22:24.60,0:22:26.62,Default,,0000,0000,0000,,Cơn gió nào khiến anh\Nnghĩ như {\i1}vậy{\i0} thế?
Dialogue: 0,0:22:26.90,0:22:28.10,Default,,0000,0000,0000,,Chẳng có gì to tát đâu.
Dialogue: 0,0:22:28.10,0:22:35.11,Default,,0000,0000,0000,,Tôi chỉ chợt nhớ lại hồi mới nhập ngũ mình cũng lóng ngóng,
Dialogue: 0,0:22:35.11,0:22:37.01,Default,,0000,0000,0000,,rồi bị cấp trên mắng cho một trận tơi bời.
Dialogue: 0,0:22:38.58,0:22:43.67,Default,,0000,0000,0000,,Cũng được thôi. Đâu phải ai sinh ra\Ncũng làm tốt mọi thứ ngay từ đầu.
Dialogue: 0,0:22:44.08,0:22:44.98,Default,,0000,0000,0000,,Ừ.
Dialogue: 0,0:22:45.38,0:22:48.65,Default,,0000,0000,0000,,Nghe cô nói thế tôi cũng thấy\Nnhẹ cả người.
Dialogue: 0,0:22:48.65,0:22:50.65,Default,,0000,0000,0000,,
