Dialogue: 0,0:01:37.59,0:01:42.52,Default,,0000,0000,0000,,{\i1}Sai lầm ngớ ngẩn thế này{\i0}\N{\i1}không giống phong cách của cô chút nào.{\i0}
Dialogue: 0,0:01:43.86,0:01:45.52,Default,,0000,0000,0000,,{\i1}Tôi cũng chẳng biết{\i0}\N{\i1}phải nói gì nữa.{\i0}
Dialogue: 0,0:01:46.60,0:01:51.16,Default,,0000,0000,0000,,{\i1}Cho họ ra thực địa lúc này là quá sớm. Cố huấn luyện{\i0}\N{\i1}lính mới ngoài chiến trường thật điên rồ.{\i0}
Dialogue: 0,0:01:53.87,0:01:56.81,Default,,0000,0000,0000,,{\i1}Sao không thử tải ký ức của Yano{\i0}\N{\i1}sang một não điện tử khác?{\i0}
Dialogue: 0,0:01:56.91,0:01:58.60,Default,,0000,0000,0000,,{\i1}Như thế chẳng phải sẽ đưa cậu ấy{\i0}\N{\i1}trở lại hoạt động sao?{\i0}
Dialogue: 0,0:01:58.84,0:02:00.78,Default,,0000,0000,0000,,{\i1}Cũng giống như việc cậu không thể{\i0}\N{\i1}nhân bản một Ghost vậy.{\i0}
Dialogue: 0,0:02:00.88,0:02:03.31,Default,,0000,0000,0000,,{\i1}Dù có sao chép ký ức của cậu ấy vào đó,{\i0}\N{\i1}thì Ghost của cậu ấy cũng không còn ở đó nữa.{\i0}
Dialogue: 0,0:02:06.25,0:02:10.78,Default,,0000,0000,0000,,{\i1}Nếu mối bận tâm duy nhất chỉ là duy trì Đội 9,{\i0}\N{\i1}thì có lẽ nhân sự mới là không cần thiết.{\i0}
Dialogue: 0,0:02:11.79,0:02:14.19,Default,,0000,0000,0000,,{\i1}Nhưng xét đến việc mọi chuyện có thể diễn ra{\i0}\N{\i1}thế nào trong tương lai gần,{\i0}
Dialogue: 0,0:02:14.59,0:02:18.22,Default,,0000,0000,0000,,{\i1}đây là vấn đề mà chúng ta{\i0}\N{\i1}buộc phải đối mặt và vượt qua.{\i0}
Dialogue: 0,0:02:18.56,0:02:22.46,Default,,0000,0000,0000,,{\i1}Có thể. Dù vậy, tôi sẽ rút Azuma{\i0}\N{\i1}khỏi chiến dịch lần này.{\i0}
Dialogue: 0,0:02:23.07,0:02:24.19,Default,,0000,0000,0000,,{\i1}Được rồi.{\i0}
Dialogue: 0,0:02:28.07,0:02:31.10,Default,,0000,0000,0000,,Hãy dành sự tôn trọng cho thằng bé nhé?\NChăm sóc nó chu đáo vào.
Dialogue: 0,0:02:52.53,0:02:57.43,Default,,0000,0000,0000,,{\i1}Đây là tin tình báo tôi nhận được{\i0}\N{\i1}từ một người bạn cũ.{\i0}
Dialogue: 0,0:02:59.17,0:03:01.36,Default,,0000,0000,0000,,{\i1}Đã xác nhận được rằng{\i0}\N{\i1}Boris Jabrov,{\i0}
Dialogue: 0,0:03:01.47,0:03:05.00,Default,,0000,0000,0000,,{\i1}cựu sĩ quan quân đội Nga chuyển sang làm mafia,{\i0}\N{\i1}cùng vài thuộc hạ...{\i0}
Dialogue: 0,0:03:05.41,0:03:10.57,Default,,0000,0000,0000,,{\i1}...đã buôn lậu plutonium ra khỏi đất nước họ{\i0}\N{\i1}và tiến vào Etorofu.{\i0}
Dialogue: 0,0:03:14.32,0:03:18.38,Default,,0000,0000,0000,,Vậy anh nghĩ Kuze đang lên kế hoạch\Nmua số plutonium đó à?
Dialogue: 0,0:03:19.29,0:03:22.82,Default,,0000,0000,0000,,Chúng định sở hữu vũ khí hạt nhân\Nrồi tuyên bố độc lập đấy à?
Dialogue: 0,0:03:23.13,0:03:24.75,Default,,0000,0000,0000,,Dùng từ \"gan cùng mình\" cũng chẳng đủ\Nđể diễn tả vụ này đâu.
Dialogue: 0,0:03:27.06,0:03:30.03,Default,,0000,0000,0000,,{\i1}Một trong những đồng phạm người máy của hắn{\i0}\N{\i1}đã sát hại một điệp viên tình báo...{\i0}
Dialogue: 0,0:03:30.13,0:03:32.07,Default,,0000,0000,0000,,{\i1}...người đang thực hiện{\i0}\N{\i1}một chiến dịch giăng bẫy.{\i0}
Dialogue: 0,0:03:32.40,0:03:34.53,Default,,0000,0000,0000,,{\i1}Hiện chưa rõ tung tích{\i0}\N{\i1}của chúng.{\i0}
Dialogue: 0,0:03:37.34,0:03:40.71,Default,,0000,0000,0000,,{\i1}Tên điệp viên bị giết{\i0}\N{\i1}cách đây hai tiếng rồi sao?{\i0}
Dialogue: 0,0:03:42.21,0:03:46.67,Default,,0000,0000,0000,,Kế hoạch thế nào đây? Tôi đoán lúc này\Nta cũng chẳng còn nhiều lựa chọn.
Dialogue: 0,0:03:48.38,0:03:49.68,Default,,0000,0000,0000,,Chắc là vậy rồi.
Dialogue: 0,0:03:53.56,0:03:55.96,Default,,0000,0000,0000,,{\i1}Nếu anh ta đã chết, làm sao ta xác định được{\i0}\N{\i1}vị trí của chúng?{\i0}
Dialogue: 0,0:03:56.49,0:03:58.96,Default,,0000,0000,0000,,{\i1}Lao đến Etorofu mà không có kế hoạch{\i0}\N{\i1}thì chẳng giải quyết được gì đâu.{\i0}
Dialogue: 0,0:03:59.73,0:04:02.56,Default,,0000,0000,0000,,{\i1}Có vài manh mối trong tin tình báo{\i0}\N{\i1}tôi nhận được từ Cục An ninh Công cộng.{\i0}
Dialogue: 0,0:04:02.80,0:04:05.83,Default,,0000,0000,0000,,{\i1}Có vẻ chi nhánh Etorofu của Tập đoàn{\i0}\N{\i1}Điện tử Sagawa đang mở rộng...{\i0}
Dialogue: 0,0:04:05.97,0:04:08.66,Default,,0000,0000,0000,,{\i1}...các cơ sở ngầm của họ ở quận Berutarube{\i0}\N{\i1}mà không xin phép.{\i0}
Dialogue: 0,0:04:09.04,0:04:12.67,Default,,0000,0000,0000,,{\i1}Berutarube ư? Chẳng phải từng có{\i0}\N{\i1}một căn cứ tàu ngầm của Nga ở đó sao?{\i0}
Dialogue: 0,0:04:12.91,0:04:17.81,Default,,0000,0000,0000,,{\i1}Theo tôi nhớ thì quân đội Nga đã cho nổ tung{\i0}\N{\i1}và chôn vùi nó khi họ rút quân.{\i0}
Dialogue: 0,0:04:18.21,0:04:19.11,Default,,0000,0000,0000,,{\i1}Đúng thế.{\i0}
Dialogue: 0,0:04:19.45,0:04:23.04,Default,,0000,0000,0000,,{\i1}Và nếu công trình mở rộng của Sagawa{\i0}\N{\i1}diễn ra suôn sẻ kể từ đó,{\i0}
Dialogue: 0,0:04:23.15,0:04:25.64,Default,,0000,0000,0000,,{\i1}thì hiện giờ họ ắt hẳn đang ở ngay{\i0}\N{\i1}phía trên căn cứ cũ đó.{\i0}
Dialogue: 0,0:04:25.89,0:04:27.55,Default,,0000,0000,0000,,{\i1}Chà chà...{\i0}\N{\i1}Mùi mờ ám nồng nặc ra đấy.{\i0}
Dialogue: 0,0:04:27.66,0:04:31.09,Default,,0000,0000,0000,,{\i1}Một căn cứ tàu ngầm sẽ là nơi hoàn hảo{\i0}\N{\i1}để giấu các con tàu ngụy trang.{\i0}
Dialogue: 0,0:04:31.63,0:04:33.56,Default,,0000,0000,0000,,{\i1}Có thể, nhưng ta chưa có{\i0}\N{\i1}bằng chứng xác thực nào.{\i0}
Dialogue: 0,0:04:34.76,0:04:37.60,Default,,0000,0000,0000,,{\i1}Nếu chúng lên kế hoạch{\i0}\N{\i1}cho một thương vụ cỡ này,{\i0}
Dialogue: 0,0:04:37.93,0:04:40.80,Default,,0000,0000,0000,,{\i1}thì đám chỉ điểm địa phương{\i0}\N{\i1}ắt phải nghe ngóng được đôi điều.{\i0}
Dialogue: 0,0:04:41.80,0:04:45.14,Default,,0000,0000,0000,,{\i1}Trưởng phòng, chúng tôi sẽ{\i0}\N{\i1}tiến thẳng đến Etorofu.{\i0}
Dialogue: 0,0:04:45.61,0:04:49.64,Default,,0000,0000,0000,,{\i1}Để đảm bảo an toàn, hãy yêu cầu Lực lượng Phòng vệ Biển{\i0}\N{\i1}phong tỏa quanh Dejima.{\i0}
Dialogue: 0,0:04:50.01,0:04:53.74,Default,,0000,0000,0000,,{\i1}Nếu người tị nạn chạm tay vào vũ khí hạt nhân,{\i0}\N{\i1}dưới đó sẽ đại loạn mất.{\i0}
Dialogue: 0,0:04:53.95,0:04:57.89,Default,,0000,0000,0000,,{\i1}Ta sẽ làm việc đó. Nhưng ta đặt{\i0}\N{\i1}niềm tin vào các cậu.{\i0}
Dialogue: 0,0:04:58.29,0:05:02.52,Default,,0000,0000,0000,,{\i1}Nếu bỏ lỡ cơ hội bắt giữ Kuze lần này, những tội ác{\i0}\N{\i1}của CIS sẽ chìm vào bóng tối,{\i0}
Dialogue: 0,0:05:02.66,0:05:04.42,Default,,0000,0000,0000,,{\i1}và quân đội{\i0}\N{\i1}sẽ can thiệp.{\i0}
Dialogue: 0,0:05:05.06,0:05:07.79,Default,,0000,0000,0000,,{\i1}Chúng ta không được để Dejima{\i0}\N{\i1}biến thành bãi chiến trường.{\i0}
Dialogue: 0,0:05:14.84,0:05:15.96,Default,,0000,0000,0000,,Tình hình thế nào rồi?
Dialogue: 0,0:05:16.37,0:05:19.31,Default,,0000,0000,0000,,Tôi nghĩ không sao đâu. Trông có vẻ\Nkhông có cạm bẫy nào.
Dialogue: 0,0:05:20.91,0:05:24.68,Default,,0000,0000,0000,,Ta còn chút thời gian trước giờ giao dịch.\NHãy thay phiên nhau nghỉ ngơi.
Dialogue: 0,0:05:25.01,0:05:26.48,Default,,0000,0000,0000,,- Rõ.\N- Được thôi.
Dialogue: 0,0:05:38.49,0:05:40.62,Default,,0000,0000,0000,,Này, cô nên\Năn chút gì đi.
Dialogue: 0,0:05:48.84,0:05:51.10,Default,,0000,0000,0000,,Cô chắc là mình ổn chứ?
Dialogue: 0,0:05:51.54,0:05:52.91,Default,,0000,0000,0000,,Gớm ghiếc thật...
Dialogue: 0,0:05:53.44,0:05:56.93,Default,,0000,0000,0000,,Vị dở tệ.\NTôi phải phàn nàn với Sếp mới được.
Dialogue: 0,0:05:57.55,0:06:01.68,Default,,0000,0000,0000,,Ta còn chút thời gian trước khi hạ cánh.\NCô có muốn kiểm tra chức năng não điện tử không?
Dialogue: 0,0:06:03.42,0:06:04.58,Default,,0000,0000,0000,,Tôi ổn.
Dialogue: 0,0:06:05.32,0:06:08.62,Default,,0000,0000,0000,,Tầm vóc ảo tưởng của Kuze\Nkhiến tôi hơi choáng váng thôi, chỉ có vậy.
Dialogue: 0,0:06:09.93,0:06:14.09,Default,,0000,0000,0000,,Đó là điều tôi không hiểu nổi.\NTên này có thứ ảo tưởng quái quỷ gì vậy?
Dialogue: 0,0:06:15.00,0:06:18.16,Default,,0000,0000,0000,,Nói thẳng ra thì, cậu có thể\Ngọi đó là thống trị thế giới.
Dialogue: 0,0:06:18.40,0:06:19.56,Default,,0000,0000,0000,,Cái gì cơ?
Dialogue: 0,0:06:20.04,0:06:22.03,Default,,0000,0000,0000,,Mắc chứng hoang tưởng tự đại\Nnặng rồi hả?
Dialogue: 0,0:06:22.14,0:06:25.16,Default,,0000,0000,0000,,Để một chuyện như thế làm lung lay\Nkhông giống cô chút nào.
Dialogue: 0,0:06:25.41,0:06:30.57,Default,,0000,0000,0000,,Trời ạ, trông cô cứ như thiếu nữ mới lớn\Nvừa gặp được người đàn ông trong mộng ấy.
Dialogue: 0,0:06:30.71,0:06:32.11,Default,,0000,0000,0000,,Phải rồi.
Dialogue: 0,0:06:33.25,0:06:35.18,Default,,0000,0000,0000,,Nhưng giờ chúng ta\Nđã biết chắc một điều.
Dialogue: 0,0:06:35.28,0:06:38.74,Default,,0000,0000,0000,,Đó là dù hắn từng bộc lộ các triệu chứng\Ncủa virus Mười Một Cá Nhân,
Dialogue: 0,0:06:39.22,0:06:41.75,Default,,0000,0000,0000,,nhưng các hành động hiện tại lại được thúc đẩy\Nbởi phẩm chất cá nhân...
Dialogue: 0,0:06:41.86,0:06:44.09,Default,,0000,0000,0000,,...và hệ tư tưởng mà hắn có\Ntrước khi bị nhiễm.
Dialogue: 0,0:06:44.76,0:06:50.10,Default,,0000,0000,0000,,Bản thân ảo tưởng của hắn có thể là sáo rỗng,\Nnhưng lý do tôi không thể cười trừ bỏ qua...
Dialogue: 0,0:06:50.43,0:06:54.93,Default,,0000,0000,0000,,...là vì hắn thực tâm tin rằng mình có thể mang lại\Nhòa bình cho thế giới bằng cách trở thành một kẻ độc tài.
Dialogue: 0,0:06:55.27,0:06:57.17,Default,,0000,0000,0000,,Đó là cảm nhận\Nmà tôi nhận được từ hắn.
Dialogue: 0,0:06:57.31,0:07:01.40,Default,,0000,0000,0000,,Thêm vào đó, mức tiết adrenaline của hắn cao\Nđến mức đủ để giết chết một người bình thường.
Dialogue: 0,0:07:03.25,0:07:08.34,Default,,0000,0000,0000,,Tôi nghĩ ta có thể xem như Kuze\Nđã mất kết nối với thực tế rồi.
Dialogue: 0,0:07:08.45,0:07:10.35,Default,,0000,0000,0000,,Ý cô mất kết nối\Nlà sao?
Dialogue: 0,0:07:10.45,0:07:12.55,Default,,0000,0000,0000,,Ý tôi là hắn đang\Nbị ám ảnh cực độ.
Dialogue: 0,0:07:13.19,0:07:17.02,Default,,0000,0000,0000,,Nhìn lại lịch sử, những kẻ như hắn\Ntừng nắm giữ quyền lực không thể tin nổi.
Dialogue: 0,0:07:17.56,0:07:22.96,Default,,0000,0000,0000,,Chẳng hạn như Che Guevara, Malcolm X\Nvà Cassius Clay là những ví dụ điển hình trong sách giáo khoa.
Dialogue: 0,0:07:23.37,0:07:25.06,Default,,0000,0000,0000,,Cô bảo hắn\Nkhông giống Hitler sao?
Dialogue: 0,0:07:25.40,0:07:30.36,Default,,0000,0000,0000,,Ở khía cạnh nào đó thì giống, nhưng về tư tưởng,\Nhắn gần gũi hơn với Gandhi hay Martin Luther King.
Dialogue: 0,0:07:31.44,0:07:36.34,Default,,0000,0000,0000,,Những người tị nạn liên tục kết nối với hắn\Nqua mạng lưới phân vùng và chọn lọc...
Dialogue: 0,0:07:36.78,0:07:39.54,Default,,0000,0000,0000,,...đang hưng phấn cực độ trước nguồn truyền\Ntrực tiếp mọi hành động của hắn.
Dialogue: 0,0:07:40.18,0:07:43.78,Default,,0000,0000,0000,,Nhưng lý do họ không cố tác động đến hắn\Nhay chia sẻ ý thức của mình...
Dialogue: 0,0:07:43.89,0:07:47.52,Default,,0000,0000,0000,,...là vì họ biết khu vực bên ngoài Đường ranh Ghost\Ncủa hắn là một vùng tử địa.
Dialogue: 0,0:07:49.09,0:07:51.58,Default,,0000,0000,0000,,Ngay cả tôi cũng\Nsuýt chết trong đó.
Dialogue: 0,0:07:55.53,0:07:57.76,Default,,0000,0000,0000,,Chà, nghe nản lòng\Nthật đấy...
Dialogue: 0,0:08:26.73,0:08:29.25,Default,,0000,0000,0000,,Ishikawa, Paz, Borma, ở lại đây\Nvà tiếp tục trực chiến.
Dialogue: 0,0:08:29.70,0:08:31.83,Default,,0000,0000,0000,,Sẵn sàng ứng biến trong trường hợp\Nta xác định sai địa điểm giao dịch.
Dialogue: 0,0:08:32.07,0:08:33.37,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:08:59.76,0:09:01.56,Default,,0000,0000,0000,,Đả đảo bọn quân phiệt!
Dialogue: 0,0:09:09.01,0:09:10.70,Default,,0000,0000,0000,,Nơi này trông hỗn loạn gớm nhỉ?
Dialogue: 0,0:09:11.31,0:09:12.87,Default,,0000,0000,0000,,Hòn đảo có thể đã được trao trả cho Nhật Bản,\Nnhưng xung đột giữa...
Dialogue: 0,0:09:13.08,0:09:16.67,Default,,0000,0000,0000,,...người gốc Nga và người Nhật bản địa\Nsẽ không biến mất trong một sớm một chiều.
Dialogue: 0,0:09:27.62,0:09:31.39,Default,,0000,0000,0000,,Chà! Họ đang xây\Nmột thành phố ngầm geofront kìa!
Dialogue: 0,0:09:31.49,0:09:35.59,Default,,0000,0000,0000,,Tôi đoán nếu đi men theo hướng này về phía căn cứ,\Ncó thể ta sẽ đụng độ Kuze.
Dialogue: 0,0:09:35.70,0:09:37.76,Default,,0000,0000,0000,,Nếu may mắn vẫn còn\Nđứng về phía chúng ta...
Dialogue: 0,0:09:38.13,0:09:39.50,Default,,0000,0000,0000,,Còn nếu không thì sao?
Dialogue: 0,0:09:40.00,0:09:44.00,Default,,0000,0000,0000,,Thì ta chỉ đành trò chuyện thân mật\Nvới đám công nhân xây dựng của Sagawa thôi.
Dialogue: 0,0:09:44.34,0:09:46.97,Default,,0000,0000,0000,,Ta không thể ngồi chờ\Ntin từ Thiếu tá mãi được.
Dialogue: 0,0:09:59.69,0:10:00.95,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:10:01.19,0:10:04.52,Default,,0000,0000,0000,,Tôi lên con tàu này vì nghe nói\Nchúng ta đi mua vũ khí.
Dialogue: 0,0:10:04.99,0:10:09.45,Default,,0000,0000,0000,,Nhưng nếu biết anh là người chỉ huy nhiệm vụ,\Ntôi đời nào chịu đi.
Dialogue: 0,0:10:09.63,0:10:12.93,Default,,0000,0000,0000,,Tôi hiểu rồi. Nếu vậy thì anh không cần\Nphải gượng ép đi theo tôi.
Dialogue: 0,0:10:13.14,0:10:16.66,Default,,0000,0000,0000,,Anh có thể tự do trở về nhà, hoặc hòa mình\Nvào đường phố Etorofu nếu muốn.
Dialogue: 0,0:10:16.87,0:10:18.17,Default,,0000,0000,0000,,Tôi không ép anh\Nphải ở lại.
Dialogue: 0,0:10:18.31,0:10:20.30,Default,,0000,0000,0000,,Tôi cũng ủng hộ cách mạng,\Ngiống như bao người khác.
Dialogue: 0,0:10:20.41,0:10:24.31,Default,,0000,0000,0000,,Nhưng người đầu tiên dạy chúng tôi\Ncách nổi dậy là Densetsu.
Dialogue: 0,0:10:24.55,0:10:28.35,Default,,0000,0000,0000,,Giờ hầu hết mọi người ở Dejima\Nđều biết về \"Đồng chí Kuze\".
Dialogue: 0,0:10:28.62,0:10:31.78,Default,,0000,0000,0000,,Nhưng chẳng mấy ai biết\Ncon người thật của anh là ai.
Dialogue: 0,0:10:32.15,0:10:34.21,Default,,0000,0000,0000,,Đó là lý do\Ntôi không thể tin anh được.
Dialogue: 0,0:10:38.73,0:10:42.93,Default,,0000,0000,0000,,Tôi vẫn sẵn sàng làm theo lời dạy của Densetsu\Nvà đánh bom liều chết.
Dialogue: 0,0:10:44.13,0:10:48.63,Default,,0000,0000,0000,,Đừng ngu xuẩn thế. Đánh bom tự sát chẳng qua\Nchỉ là hành vi tự thỏa mãn bản thân.
Dialogue: 0,0:10:49.07,0:10:51.84,Default,,0000,0000,0000,,Cách mạng chỉ có thể tạo nên\Ntừ Ghost của con người.
Dialogue: 0,0:10:52.41,0:10:54.60,Default,,0000,0000,0000,,Chính vì thế tôi mới muốn\Nhiểu thêm về anh.
Dialogue: 0,0:10:55.61,0:10:58.21,Default,,0000,0000,0000,,Cho tôi một lý do\Nđể tin anh đi.
Dialogue: 0,0:11:03.62,0:11:04.92,Default,,0000,0000,0000,,Bằng không thì...
Dialogue: 0,0:11:10.49,0:11:11.76,Default,,0000,0000,0000,,Sao, trả lời đi chứ?!
Dialogue: 0,0:11:17.63,0:11:21.54,Default,,0000,0000,0000,,Thứ vũ khí mà hôm nay chúng ta\Nđến đây để lấy là plutonium.
Dialogue: 0,0:11:22.04,0:11:24.44,Default,,0000,0000,0000,,Tôi sẽ dùng nó để buộc\Nchính phủ Nhật Bản...
Dialogue: 0,0:11:24.54,0:11:26.91,Default,,0000,0000,0000,,...phải công nhận Dejima là\Nmột quốc gia độc lập.
Dialogue: 0,0:11:33.68,0:11:37.48,Default,,0000,0000,0000,,Có vay có trả! Đạo lý cơ bản nhất trần đời đấy!
Dialogue: 0,0:11:37.99,0:11:38.75,Default,,0000,0000,0000,,Rõ chưa hả?!
Dialogue: 0,0:11:38.85,0:11:40.55,Default,,0000,0000,0000,,Có vẻ dạo này anh lên hương\Nthành đại ca rồi nhỉ.
Dialogue: 0,0:11:41.89,0:11:44.22,Default,,0000,0000,0000,,Anh có nhiều của nả đến mức\Ncho vay mượn cơ đấy?
Dialogue: 0,0:11:44.29,0:11:46.06,Default,,0000,0000,0000,,Ôi trời đất ơi!\NChào cô em!
Dialogue: 0,0:11:46.43,0:11:47.76,Default,,0000,0000,0000,,Ra là vẫn còn nhớ tôi.
Dialogue: 0,0:11:48.33,0:11:52.03,Default,,0000,0000,0000,,Tin đồn Krolden vẫn làm việc\Ntrong này có thật không?
Dialogue: 0,0:11:52.47,0:11:54.90,Default,,0000,0000,0000,,Thật một trăm phần trăm!\NMời đi lối này!
Dialogue: 0,0:12:00.34,0:12:02.50,Default,,0000,0000,0000,,Lão vẫn giữ thói cẩn thận như xưa.
Dialogue: 0,0:12:06.35,0:12:07.87,Default,,0000,0000,0000,,Mời đi đường này.
Dialogue: 0,0:12:08.12,0:12:09.88,Default,,0000,0000,0000,,Togusa, cậu đợi tôi ở đây.
Dialogue: 0,0:12:10.52,0:12:11.58,Default,,0000,0000,0000,,Lão ở bên dưới đấy.
Dialogue: 0,0:12:12.05,0:12:16.99,Default,,0000,0000,0000,,Anh cũng ở lại đây. Trong nghề này, chẳng ai\Nưa kẻ quá mức sốt sắng đâu.
Dialogue: 0,0:12:25.20,0:12:28.90,Default,,0000,0000,0000,,Làm việc với bà chị đó\Nchắc cực lắm nhỉ.
Dialogue: 0,0:12:29.81,0:12:34.71,Default,,0000,0000,0000,,Chọc giận cô ta một cái là cô ta\Ncho chú mày hối hận không kịp ngáp luôn.
Dialogue: 0,0:12:49.33,0:12:50.92,Default,,0000,0000,0000,,Krolden, tôi đây.
Dialogue: 0,0:12:51.39,0:12:54.56,Default,,0000,0000,0000,,Tôi vẫn còn nợ ông ơn cứu mạng hồi\Nchiến dịch đổ bộ Nemuro.
Dialogue: 0,0:12:59.07,0:13:00.93,Default,,0000,0000,0000,,Tường lửa tấn công ư?
Dialogue: 0,0:13:05.47,0:13:07.34,Default,,0000,0000,0000,,Lão vừa bị thiêu cháy não\Nchưa được bao lâu...
Dialogue: 0,0:13:08.11,0:13:10.77,Default,,0000,0000,0000,,Lão đã lặn vào đâu\Nmà lại rước họa vào thân thế này?
Dialogue: 0,0:13:28.33,0:13:30.13,Default,,0000,0000,0000,,Có vẻ kẻ xâm nhập\Nvẫn còn trong hệ thống.
Dialogue: 0,0:13:30.27,0:13:35.17,Default,,0000,0000,0000,,Dù vậy, kẻ nướng chín được một hacker tầm cỡ như Krolden\Nắt hẳn tay nghề cực cao.
Dialogue: 0,0:13:35.44,0:13:38.24,Default,,0000,0000,0000,,Cấu hình tường lửa tấn công này\Ncũng không hề được phê chuẩn...
Dialogue: 0,0:13:38.34,0:13:40.37,Default,,0000,0000,0000,,...bởi Đạo luật Bảo tồn\NBí mật.
Dialogue: 0,0:13:46.98,0:13:48.11,Default,,0000,0000,0000,,Tìm thấy rồi.
Dialogue: 0,0:13:53.56,0:13:54.82,Default,,0000,0000,0000,,Đĩa mềm sao...
Dialogue: 0,0:13:54.96,0:13:58.19,Default,,0000,0000,0000,,Không ngờ lão lại dùng phương tiện cổ lỗ sĩ thế này\Nđể lưu trữ bộ nhớ ngoài.
Dialogue: 0,0:13:58.56,0:14:01.12,Default,,0000,0000,0000,,Tên kia nán lại đây là vì gặp khó khăn\Ntrong việc xóa đống này sao?
Dialogue: 0,0:14:06.24,0:14:07.90,Default,,0000,0000,0000,,Sổ cái bí mật của Sagawa à?
Dialogue: 0,0:14:09.10,0:14:11.54,Default,,0000,0000,0000,,\"Rao bán: bánh chanh,\N20 kg.\"
Dialogue: 0,0:14:12.34,0:14:13.87,Default,,0000,0000,0000,,Bánh chanh ư?
Dialogue: 0,0:14:14.78,0:14:16.27,Default,,0000,0000,0000,,\"500.000 đô mỗi kg.\"
Dialogue: 0,0:14:16.38,0:14:18.64,Default,,0000,0000,0000,,\"M: Au đã rút khỏi\Nthương vụ.\"
Dialogue: 0,0:14:18.75,0:14:20.72,Default,,0000,0000,0000,,\"Môi giới: Sagawa K.\"
Dialogue: 0,0:14:20.85,0:14:23.25,Default,,0000,0000,0000,,\"B.J.: bánh chanh,\N20 kg.\"
Dialogue: 0,0:14:23.55,0:14:26.54,Default,,0000,0000,0000,,\"K: cắt 40%\Nlàm phí thôi việc.\"
Dialogue: 0,0:14:26.99,0:14:29.48,Default,,0000,0000,0000,,\"Bên mua: giới thiệu\Nqua B.P.\"
Dialogue: 0,0:14:30.43,0:14:34.89,Default,,0000,0000,0000,,Đúng như mình nghĩ, lão đã tấn công ngược\Nđể lấy dữ liệu vụ buôn bán plutonium.
Dialogue: 0,0:14:35.56,0:14:37.36,Default,,0000,0000,0000,,Sagawa K...
Dialogue: 0,0:14:38.00,0:14:40.47,Default,,0000,0000,0000,,\"K\" là Kagazaki, Trưởng ban\NĐặc vụ Viễn Bắc sao?
Dialogue: 0,0:14:41.20,0:14:45.04,Default,,0000,0000,0000,,Hắn làm môi giới và bán với giá\N500.000 đô một ký...
Dialogue: 0,0:14:45.74,0:14:48.04,Default,,0000,0000,0000,,Bên bán là Boris Jabrov...
Dialogue: 0,0:14:48.41,0:14:52.54,Default,,0000,0000,0000,,Bên mua là... ASIAN / B.P.
Dialogue: 0,0:14:52.72,0:14:56.52,Default,,0000,0000,0000,,Chắc là chỉ người tị nạn châu Á...\NVậy hacker vừa rồi chính là...
Dialogue: 0,0:14:59.32,0:15:02.22,Default,,0000,0000,0000,,Có vẻ phần ăn chia của Kagazaki\Nlà bằng đồng Yên...
Dialogue: 0,0:15:04.39,0:15:07.36,Default,,0000,0000,0000,,Khoản tiền cọc đã được chuyển\Nvào tài khoản Sagawa rồi.
Dialogue: 0,0:15:08.23,0:15:09.99,Default,,0000,0000,0000,,240 triệu Yên sao?
Dialogue: 0,0:15:10.87,0:15:13.16,Default,,0000,0000,0000,,Đám tị nạn lấy đâu ra\Nsố tiền lớn đến thế?
Dialogue: 0,0:15:13.50,0:15:15.49,Default,,0000,0000,0000,,Do Kuze thu xếp\Ncho họ à?
Dialogue: 0,0:15:16.17,0:15:18.14,Default,,0000,0000,0000,,Nếu đúng thế thì hắn làm\Nbằng cách nào?
Dialogue: 0,0:15:19.51,0:15:20.84,Default,,0000,0000,0000,,Dù sao thì chuyện này\Ncũng giúp ích rất nhiều.
Dialogue: 0,0:15:20.94,0:15:22.74,Default,,0000,0000,0000,,Tôi nhớ ông từng nói\NTập đoàn Điện tử Sagawa...
Dialogue: 0,0:15:22.85,0:15:24.94,Default,,0000,0000,0000,,...là công ty Nhật Bản\Nmà ông căm ghét nhất trần đời.
Dialogue: 0,0:15:29.18,0:15:29.30,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\pos(1130,1071)\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)}Điều tra của Cục Tình báo Nội các
Dialogue: 0,0:15:29.30,0:15:29.42,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)\pos(1100,936)}Điều tra của Cục Tình báo Nội các
Dialogue: 0,0:15:29.42,0:15:29.55,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\pos(992,1031)\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)}Điều tra của Cục Tình báo Nội các\N\N\N\N\N\N\N\NSách trắng Không chính thức
Dialogue: 0,0:15:29.55,0:15:29.67,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)\pos(953,902)}Điều tra của Cục Tình báo Nội các\N\N\N\N\N\N\N\NSách trắng Không chính thức
Dialogue: 0,0:15:29.67,0:15:29.80,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)\pos(905,767)}Điều tra của Cục Tình báo Nội các\N\N\N\N\N\N\N\NSách trắng Không chính thức
Dialogue: 0,0:15:29.80,0:15:31.80,GitS Signs B/W,,0000,0000,0000,,{\frz345.065\iclip(m 727 1058 l 1620 1059 1620 1080 727 1080)\pos(865,610)}Điều tra của Cục Tình báo Nội các\N\N\N\N\N\N\N\NSách trắng Không chính thức
Dialogue: 0,0:15:32.05,0:15:34.05,Default,,0000,0000,0000,,Ồ, giờ thì tôi hiểu rồi...
Dialogue: 0,0:15:34.59,0:15:37.82,Default,,0000,0000,0000,,Lẽ ra ông không nên từ bỏ công việc\Nở Cơ quan Báo chí Nội các.
Dialogue: 0,0:15:38.83,0:15:43.66,Default,,0000,0000,0000,,Nếu ông không từ chức, CIS có lẽ đã\Ntrở thành một cơ quan chính trực hơn rồi.
Dialogue: 0,0:15:45.87,0:15:48.56,Default,,0000,0000,0000,,{\i1}Ishikawa, thương vụ đang diễn ra{\i0}\N{\i1}tại căn cứ tàu ngầm.{\i0}
Dialogue: 0,0:15:49.17,0:15:51.73,Default,,0000,0000,0000,,{\i1}Cũng có khả năng CIS{\i0}\N{\i1}có dính líu đến vụ này.{\i0}
Dialogue: 0,0:15:51.84,0:15:52.83,Default,,0000,0000,0000,,{\i1}Thật sao?!{\i0}
Dialogue: 0,0:15:53.08,0:15:54.74,Default,,0000,0000,0000,,{\i1}Ta không còn nhiều thời gian.{\i0}\N{\i1}Batou và Saito đâu rồi?{\i0}
Dialogue: 0,0:15:54.84,0:15:57.94,Default,,0000,0000,0000,,{\i1}Họ đã xuống sâu dưới lòng đất rồi.{\i0}\N{\i1}Liên lạc bị nghẽn sóng hoàn toàn.{\i0}
Dialogue: 0,0:15:58.15,0:15:59.58,Default,,0000,0000,0000,,{\i1}Bọn tôi sẽ qua đó ngay lập tức.{\i0}
Dialogue: 0,0:16:11.03,0:16:13.55,Default,,0000,0000,0000,,Gần đến giờ rồi.\NChúng ta phải đi thôi.
Dialogue: 0,0:16:14.13,0:16:15.46,Default,,0000,0000,0000,,Cho tôi biết một điều nữa thôi!
Dialogue: 0,0:16:16.10,0:16:20.26,Default,,0000,0000,0000,,Tôi từng nghe muốn mua plutonium phải cần đến\Nkhoảng 250 nghìn đô la.
Dialogue: 0,0:16:20.94,0:16:24.87,Default,,0000,0000,0000,,Làm sao anh có được số tiền lớn thế?\NLừa lấy plutonium từ lũ người Nga à?
Dialogue: 0,0:16:25.04,0:16:27.84,Default,,0000,0000,0000,,Không, tôi sẽ mua sòng phẳng từ họ.
Dialogue: 0,0:16:28.08,0:16:30.67,Default,,0000,0000,0000,,Đám công dân sống dựa trên mồ hôi\Nnước mắt của người tị nạn,
Dialogue: 0,0:16:30.78,0:16:32.94,Default,,0000,0000,0000,,nên để giúp họ thấu hiểu nỗi khổ của chúng ta,\Ntôi đã mạn phép...
Dialogue: 0,0:16:33.08,0:16:35.88,Default,,0000,0000,0000,,...khiến mỗi người trong số họ\Nquyên góp một khoản nhỏ cho chúng ta.
Dialogue: 0,0:16:37.49,0:16:39.28,Default,,0000,0000,0000,,Tôi đoán giải thích như thế\Nvẫn chưa rõ ràng lắm.
Dialogue: 0,0:16:40.02,0:16:41.75,Default,,0000,0000,0000,,Cách thức vận hành\Nlà thế này.
Dialogue: 0,0:16:43.29,0:16:45.35,Default,,0000,0000,0000,,Quần chúng nhân dân, những kẻ vốn coi việc cơm no\Náo ấm là điều dĩ nhiên...
Dialogue: 0,0:16:45.46,0:16:49.45,Default,,0000,0000,0000,,...có tổng số tiền tiết kiệm dễ dàng\Nvượt quá 900 nghìn tỷ Yên.
Dialogue: 0,0:16:49.80,0:16:53.70,Default,,0000,0000,0000,,Lẽ dĩ nhiên, họ cũng chẳng thèm\Nbận tâm đến con số lẻ này.
Dialogue: 0,0:16:54.37,0:16:56.86,Default,,0000,0000,0000,,Ngoài ra, anh có biết rằng có những khoản tiền\Nvốn không hề tồn tại chính thức...
Dialogue: 0,0:16:57.21,0:17:00.33,Default,,0000,0000,0000,,...trong số tiền lãi phát sinh\Ntừ các khoản tiết kiệm đó không?
Dialogue: 0,0:17:01.24,0:17:03.47,Default,,0000,0000,0000,,Tiền không tồn tại ư?
Dialogue: 0,0:17:04.05,0:17:06.48,Default,,0000,0000,0000,,Những khoản tiền\Ndưới một Yên.
Dialogue: 0,0:17:07.48,0:17:12.25,Default,,0000,0000,0000,,Những con số thập phân thậm chí thường không\Nhiển thị trên dữ liệu thiết bị đầu cuối.
Dialogue: 0,0:17:13.89,0:17:18.62,Default,,0000,0000,0000,,Chỉ bằng việc thu gom những số lẻ li ti đó\Ntừ các tài khoản ngân hàng trực tuyến,
Dialogue: 0,0:17:18.96,0:17:21.52,Default,,0000,0000,0000,,...nó gom lại thành hàng chục ngàn\NYên mỗi ngày.
Dialogue: 0,0:17:22.23,0:17:26.83,Default,,0000,0000,0000,,Tôi đã lập trình một phần mềm tự động nạp\Ncác khoản đó vào tài khoản ảo của mình.
Dialogue: 0,0:17:28.00,0:17:30.06,Default,,0000,0000,0000,,Đó là nguồn gốc\Nsố tiền của tôi.
Dialogue: 0,0:17:31.04,0:17:35.98,Default,,0000,0000,0000,,Dân chúng chẳng mảy may hay biết họ có\Nnhững số tiền lẻ như thế trong tài khoản.
Dialogue: 0,0:17:37.41,0:17:41.51,Default,,0000,0000,0000,,Mà việc quản lý ngân hàng\Ngiờ đều giao hết cho AI rồi.
Dialogue: 0,0:17:42.18,0:17:45.78,Default,,0000,0000,0000,,Mặc dù người tị nạn phải đóng thuế\Nnếu làm việc trên đất liền,
Dialogue: 0,0:17:46.15,0:17:48.32,Default,,0000,0000,0000,,nhưng họ sẽ vĩnh viễn không bao giờ\Nđược nhập quốc tịch.
Dialogue: 0,0:17:49.39,0:17:53.73,Default,,0000,0000,0000,,Về phần đám công dân, họ thậm chí còn chẳng nhận ra\Nsự bóc lột tàn tệ gắn liền trong hệ thống.
Dialogue: 0,0:17:54.06,0:17:58.16,Default,,0000,0000,0000,,Họ chỉ tiếp nhận những thông tin vừa mắt họ,\Ndễ dàng chấp nhận đối với họ.
Dialogue: 0,0:17:58.90,0:18:03.50,Default,,0000,0000,0000,,Xã hội của họ là một xã hội đạo đức giả.\NTôi muốn mở mắt cho họ thấy sự thật đó.
Dialogue: 0,0:18:06.48,0:18:09.67,Default,,0000,0000,0000,,Giờ anh có bao nhiêu tiền\Ntrong tài khoản đó rồi?
Dialogue: 0,0:18:10.41,0:18:13.81,Default,,0000,0000,0000,,Khoảng 10 tỷ\N760 triệu Yên.
Dialogue: 0,0:18:14.55,0:18:17.35,Default,,0000,0000,0000,,Đây sẽ là ngân quỹ\Ncho cuộc cách mạng của chúng ta.
Dialogue: 0,0:18:17.79,0:18:18.98,Default,,0000,0000,0000,,Vãi chưởng...
Dialogue: 0,0:18:19.99,0:18:21.82,Default,,0000,0000,0000,,Rốt cuộc anh\N{\i1}là{\i0} cái quái gì vậy?
Dialogue: 0,0:18:22.89,0:18:25.05,Default,,0000,0000,0000,,Tôi chỉ là một\Ntên khủng bố bình thường thôi.
Dialogue: 0,0:18:25.49,0:18:30.30,Default,,0000,0000,0000,,Dù tôi cho rằng lúc này mình hơi say men\Nchủ nghĩa anh hùng một chút.
Dialogue: 0,0:18:32.77,0:18:34.24,Default,,0000,0000,0000,,Tôi muốn anh\Nở lại đây.
Dialogue: 0,0:18:36.17,0:18:39.47,Default,,0000,0000,0000,,Chuẩn bị sẵn tàu để nhổ neo\Nbất cứ lúc nào.
Dialogue: 0,0:18:40.34,0:18:42.28,Default,,0000,0000,0000,,Tôi trông cậy vào anh đấy.
Dialogue: 0,0:18:55.46,0:18:57.32,Default,,0000,0000,0000,,Đây là khu vực mở rộng\Nmà ta nghe nói tới hả?
Dialogue: 0,0:18:57.43,0:19:00.09,Default,,0000,0000,0000,,Lại {\i1}thêm{\i0} người của các anh nữa à?\NHôm nay các người có vụ gì thế?
Dialogue: 0,0:19:00.76,0:19:02.75,Default,,0000,0000,0000,,Tôi cho là hai anh có giấy phép\Nxuống đây chứ?
Dialogue: 0,0:19:02.86,0:19:04.13,Default,,0000,0000,0000,,Ông là người phụ trách ở đây à?
Dialogue: 0,0:19:04.23,0:19:07.46,Default,,0000,0000,0000,,Này, ông vừa nói \"Lại thêm người của các anh\"\Nnghĩa là sao hả?!
Dialogue: 0,0:19:07.67,0:19:10.37,Default,,0000,0000,0000,,Lúc nãy có hai bộ Giáp Chiến của công ty chúng tôi\Nvừa đi qua đây.
Dialogue: 0,0:19:10.51,0:19:13.91,Default,,0000,0000,0000,,Còn trước đó thì một tay người máy\Ngốc Nga trông mờ ám...
Dialogue: 0,0:19:14.18,0:19:17.70,Default,,0000,0000,0000,,...đã đi xuống hướng đó,\Nxách theo hai chiếc vali khổng lồ.
Dialogue: 0,0:19:17.95,0:19:18.71,Default,,0000,0000,0000,,Cậu nghĩ là chúng không?
Dialogue: 0,0:19:18.78,0:19:19.58,Default,,0000,0000,0000,,Chắc vậy rồi!
Dialogue: 0,0:19:19.85,0:19:21.34,Default,,0000,0000,0000,,Nhưng Quân Phòng vệ Mặt đất\Nlàm cái quái gì ở đây chứ?!
Dialogue: 0,0:19:42.67,0:19:44.37,Default,,0000,0000,0000,,Sao ngươi lại tới đây\Nmột mình?
Dialogue: 0,0:19:45.51,0:19:49.24,Default,,0000,0000,0000,,Cả Jabrov và Kagazaki đều đang\Nbị An ninh Công cộng theo dõi.
Dialogue: 0,0:19:49.98,0:19:51.84,Default,,0000,0000,0000,,Đó là lý do tôi đến một mình.
Dialogue: 0,0:19:56.62,0:19:58.95,Default,,0000,0000,0000,,Mau hoàn tất\Nthương vụ này đi.
Dialogue: 0,0:20:01.56,0:20:02.52,Default,,0000,0000,0000,,Tùy ý ngươi.
Dialogue: 0,0:20:03.49,0:20:06.12,Default,,0000,0000,0000,,Hồ sơ chuyển tiền vào tài khoản ông chỉ định\Nđược lưu trong này.
Dialogue: 0,0:20:07.13,0:20:08.43,Default,,0000,0000,0000,,Kiểm tra đi.
Dialogue: 0,0:20:21.54,0:20:24.14,Default,,0000,0000,0000,,Tôi sẽ đi trước! Những người khác,\Nhãy theo sau khi có thể!
Dialogue: 0,0:20:40.23,0:20:45.06,Default,,0000,0000,0000,,Giao dịch thành công. Đôi bên chúng ta\Nđều không thể kiểm tra hàng tại đây.
Dialogue: 0,0:21:23.71,0:21:25.23,Default,,0000,0000,0000,,Bỏ vũ khí xuống\Nvà bước ra ngoài!
Dialogue: 0,0:21:25.34,0:21:27.54,Default,,0000,0000,0000,,Các người bị bắt vì tình nghi\Nvi phạm Đạo luật Kiểm soát Vũ khí...
Dialogue: 0,0:21:27.64,0:21:29.80,Default,,0000,0000,0000,,...và buôn bán trái phép\Nnguyên liệu hạt nhân!
Dialogue: 0,0:21:34.52,0:21:36.61,Default,,0000,0000,0000,,Nào, lộ mặt ra đi chứ...
Dialogue: 0,0:21:37.69,0:21:38.55,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:21:42.02,0:21:42.89,Default,,0000,0000,0000,,Thôi toi rồi!
Dialogue: 0,0:22:00.54,0:22:02.44,Default,,0000,0000,0000,,{\i1}Saito! Có mùi mờ ám{\i0}\N{\i1}ở đây rồi!{\i0}
Dialogue: 0,0:22:02.54,0:22:04.10,Default,,0000,0000,0000,,{\i1}Tôi sẽ lo liệu ở đây!{\i0}\N{\i1}Cậu đi tóm Koil đi!{\i0}
Dialogue: 0,0:22:04.21,0:22:05.27,Default,,0000,0000,0000,,{\i1}Rõ!{\i0}
Dialogue: 0,0:22:09.79,0:22:10.68,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:22:10.92,0:22:12.98,Default,,0000,0000,0000,,Tao rút đây!\NLiệu mà nghiền nát con bọ đó đi!
Dialogue: 0,0:22:21.63,0:22:23.86,Default,,0000,0000,0000,,Đứng lại đó,\NKuze!
Dialogue: 0,0:22:26.50,0:22:28.59,Default,,0000,0000,0000,,Đặt hai chiếc vali\Nxuống đất mau!
Dialogue: 0,0:22:33.41,0:22:37.00,Default,,0000,0000,0000,,Sao ngươi không bắn ngay?\NVì ngươi biết trong vali có chứa thứ gì à?
Dialogue: 0,0:22:37.11,0:22:40.98,Default,,0000,0000,0000,,Tao đếch thèm quan tâm tới đống đó.\NCái tao muốn lấy là cái đầu của mày!
Dialogue: 0,0:22:42.62,0:22:44.64,Default,,0000,0000,0000,,Tôi không nghĩ là anh\Nlàm được việc đó đâu.
Dialogue: 0,0:22:45.79,0:22:47.55,Default,,0000,0000,0000,,Cầm lấy vali và quay về tàu ngay.
Dialogue: 0,0:22:48.02,0:22:49.32,Default,,0000,0000,0000,,- Nhưng...\N- Đi đi!
Dialogue: 0,0:22:51.63,0:22:53.29,Default,,0000,0000,0000,,Mày nghĩ mày ăn được tao hả,\Nthằng khốn nạn?!
Dialogue: 0,0:22:53.29,0:22:55.29,Default,,0000,0000,0000,,
