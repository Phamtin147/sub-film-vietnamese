Dialogue: 0,0:00:34.56,0:00:36.32,Default,,0000,0000,0000,,Một đợt không kích khác\Nlại bắt đầu rồi!
Dialogue: 0,0:00:37.36,0:00:39.66,Default,,0000,0000,0000,,Đã có ai tìm thấy bất kỳ tín hiệu nào\Ntừ phía các thủy thủ đoàn chưa?
Dialogue: 0,0:00:40.00,0:00:43.56,Default,,0000,0000,0000,,Vô ích thôi! Tôi chẳng thấy có tín hiệu nào\Nmà chúng ta có thể lợi dụng để phản công mạng cả!
Dialogue: 0,0:00:44.17,0:00:48.30,Default,,0000,0000,0000,,{\i1}Tachikoma! Hãy gom góp tất cả dung lượng còn trống{\i0}\N{\i1}mà các cậu có thể tìm thấy trong không gian mạng...{\i0}
Dialogue: 0,0:00:49.01,0:00:52.60,Default,,0000,0000,0000,,{\i1}...và bảo đảm đủ chỗ trống cho tôi để tải lên{\i0}\N{\i1}toàn bộ ký ức và linh hồn Ghost của ba triệu người.{\i0}
Dialogue: 0,0:00:53.75,0:00:55.61,Default,,0000,0000,0000,,Tại sao Thiếu tá lại muốn bọn em\Nphải làm một chuyện như thế cơ chứ?
Dialogue: 0,0:00:55.98,0:00:57.75,Default,,0000,0000,0000,,{\i1}Không còn thời gian để giải thích đâu,{\i0}\N{\i1}mau bắt tay vào làm ngay đi!{\i0}
Dialogue: 0,0:00:57.88,0:01:00.94,Default,,0000,0000,0000,,{\i1}N-Nhưng chuyện đó liệu có{\i0}\N{\i1}khả thi hay không cơ chứ?{\i0}
Dialogue: 0,0:01:01.25,0:01:05.62,Default,,0000,0000,0000,,{\i1}Tôi cũng không biết. Nhưng tôi không thấy còn bất kỳ{\i0}\N{\i1}con đường nào khác để cứu rỗi những người tị nạn nữa.{\i0}
Dialogue: 0,0:01:05.76,0:01:06.59,Default,,0000,0000,0000,,{\i1}Làm ngay đi!{\i0}
Dialogue: 0,0:01:06.69,0:01:08.56,Default,,0000,0000,0000,,R-Rõ rồi ạ!
Dialogue: 0,0:01:10.70,0:01:15.10,Default,,0000,0000,0000,,Tôi vừa ra lệnh cho các AI hỗ trợ của mình bắt đầu\Nchiếm dụng toàn bộ dung lượng còn trống trên mạng.
Dialogue: 0,0:01:16.24,0:01:18.03,Default,,0000,0000,0000,,Một khi chúng đã chuẩn bị sẵn sàng,\Nchúng ta sẽ bắt đầu.
Dialogue: 0,0:01:18.50,0:01:19.53,Default,,0000,0000,0000,,Cảm ơn sự giúp đỡ của cô.
Dialogue: 0,0:01:19.94,0:01:24.71,Default,,0000,0000,0000,,Dẫu cho {\i1}chúng ta{\i0} có thể sống sót bằng cách tải\Nlinh hồn Ghost của mình lên không gian mạng,
Dialogue: 0,0:01:25.21,0:01:27.51,Default,,0000,0000,0000,,thế còn những người tị nạn\Nkhông có não điện tử thì sao?
Dialogue: 0,0:01:29.28,0:01:33.98,Default,,0000,0000,0000,,Những người tị nạn có người thân trong gia đình như vậy\Nsẽ rất khó lòng chấp nhận quyết định này.
Dialogue: 0,0:01:35.29,0:01:39.28,Default,,0000,0000,0000,,Tôi dự liệu rằng họ sẽ mất hết niềm tin nơi tôi\Nvà tự nguyện rời khỏi Dejima theo ý họ.
Dialogue: 0,0:01:40.73,0:01:45.82,Default,,0000,0000,0000,,Trong những tình huống thế này, vai trò của người thủ lĩnh\Nvừa vô giá lại vừa chất chứa đầy sự bất định.
Dialogue: 0,0:01:46.97,0:01:50.03,Default,,0000,0000,0000,,Khi ở vị thế phải gánh vác trách nhiệm dẫn dắt muôn người,
Dialogue: 0,0:01:50.54,0:01:53.33,Default,,0000,0000,0000,,đôi khi người ta buộc phải đưa ra những quyết định nghiệt ngã để ứng phó với thời cuộc.
Dialogue: 0,0:01:53.77,0:01:56.26,Default,,0000,0000,0000,,Tôi tin chắc rằng\Nnhững con người ấy rồi sẽ hiểu.
Dialogue: 0,0:01:57.38,0:02:00.35,Default,,0000,0000,0000,,Tôi hy vọng nhận định của cô là đúng.
Dialogue: 0,0:02:03.92,0:02:06.91,Default,,0000,0000,0000,,{\i1}Tachikoma! Đường đi ngắn nhất{\i0}\N{\i1}đến vị trí của Thiếu tá là hướng nào?!{\i0}
Dialogue: 0,0:02:07.19,0:02:10.25,Default,,0000,0000,0000,,Anh Batou?! Em tưởng anh\Nđang trên đường tới cây cầu cơ mà!
Dialogue: 0,0:02:10.46,0:02:11.68,Default,,0000,0000,0000,,{\i1}Tôi phải đến giúp{\i0}\N{\i1}Thiếu tá...{\i0}
Dialogue: 0,0:02:14.39,0:02:15.33,Default,,0000,0000,0000,,Anh Batou?
Dialogue: 0,0:02:15.43,0:02:16.69,Default,,0000,0000,0000,,Đường truyền đã bị cắt đứt rồi...
Dialogue: 0,0:02:22.60,0:02:26.77,Default,,0000,0000,0000,,Các cậu có nghĩ rằng chúng sẽ lợi dụng tình trạng hỗn loạn\Ncủa đợt không kích để khai hỏa tên lửa hạt nhân không?
Dialogue: 0,0:02:27.47,0:02:30.31,Default,,0000,0000,0000,,Xét theo việc chiếc tàu ngầm kia đang chạy ở chế độ\Nhoàn toàn im lặng tuyệt đối,
Dialogue: 0,0:02:30.64,0:02:32.87,Default,,0000,0000,0000,,thì thời điểm phóng có thể đã\Nđược cài đặt sẵn từ trước rồi.
Dialogue: 0,0:02:33.38,0:02:34.68,Default,,0000,0000,0000,,Nếu sự thật là như vậy...
Dialogue: 0,0:02:35.28,0:02:39.12,Default,,0000,0000,0000,,Nếu chúng ta quan sát thời điểm rút lui của tuần dương hạm Aegis\Nvà thời điểm rải vi cỗ máy micromachine,
Dialogue: 0,0:02:39.65,0:02:42.55,Default,,0000,0000,0000,,rất có thể thời điểm phóng tên lửa\Nsẽ là vào đúng 10 giờ 00 phút...
Dialogue: 0,0:02:45.96,0:02:48.48,Default,,0000,0000,0000,,Này các cậu, hãy nói cho tôi nghe\Nsuy nghĩ thật lòng của các cậu xem nào.
Dialogue: 0,0:02:48.96,0:02:51.26,Default,,0000,0000,0000,,Các cậu có tin rằng linh hồn Ghost của người tị nạn\Nsẽ thực sự được bảo tồn...
Dialogue: 0,0:02:51.60,0:02:54.12,Default,,0000,0000,0000,,...chỉ bằng cách tải toàn bộ\Nký ức của họ lên mạng hay không?
Dialogue: 0,0:02:57.04,0:03:00.60,Default,,0000,0000,0000,,Xét theo góc độ hoạt động sinh học,\Nký ức đúng là một thành phần cốt yếu.
Dialogue: 0,0:03:01.27,0:03:03.87,Default,,0000,0000,0000,,Thế nhưng nếu thiếu đi một linh hồn Ghost, ký ức\Ncũng chẳng qua chỉ là những dòng dữ liệu vô hồn.
Dialogue: 0,0:03:04.31,0:03:08.21,Default,,0000,0000,0000,,Nhưng chẳng phải Thiếu tá đang đánh cược tất cả vào điều này\Nnhư niềm hy vọng cuối cùng của họ hay sao?
Dialogue: 0,0:03:08.41,0:03:12.04,Default,,0000,0000,0000,,Tớ hiểu hết những điều đó chứ,\Nnhưng mệnh lệnh lần này quả thực quá điên rồ!
Dialogue: 0,0:03:12.42,0:03:13.72,Default,,0000,0000,0000,,Tớ cũng nghĩ y như vậy.
Dialogue: 0,0:03:14.15,0:03:17.71,Default,,0000,0000,0000,,Thế nhưng nếu chúng ta không hành động, chúng ta cũng sẽ\Nchẳng thể cứu được anh Batou và những người khác.
Dialogue: 0,0:03:18.39,0:03:22.12,Default,,0000,0000,0000,,Chính vì vậy tớ nghĩ rằng chúng ta\Nnên phớt lờ mệnh lệnh này của Thiếu tá.
Dialogue: 0,0:03:22.70,0:03:25.36,Default,,0000,0000,0000,,- Thế cậu định bảo chúng ta phải làm gì bây giờ?!\N- Bọn mình không được phép làm trái lệnh!
Dialogue: 0,0:03:26.77,0:03:28.32,Default,,0000,0000,0000,,Ngài có liên lạc được\Nvới ai không?
Dialogue: 0,0:03:28.43,0:03:32.10,Default,,0000,0000,0000,,Vô ích thôi. Không hề có\Nbất kỳ tín hiệu phản hồi nào.
Dialogue: 0,0:03:33.21,0:03:36.11,Default,,0000,0000,0000,,Đường dây nóng vẫn đang hoạt động\Nvẫn thông suốt bình thường, nhưng mà...
Dialogue: 0,0:03:36.98,0:03:37.87,Default,,0000,0000,0000,,Thế nhưng điều đó đồng nghĩa với việc...
Dialogue: 0,0:03:40.18,0:03:41.54,Default,,0000,0000,0000,,Thật là đáng tức giận.
Dialogue: 0,0:03:41.88,0:03:45.41,Default,,0000,0000,0000,,Tôi thừa hiểu rằng mình chẳng qua chỉ là một gương mặt bù nhìn\Ntrên các biển quảng cáo để tranh cử chiến thắng...
Dialogue: 0,0:03:45.55,0:03:47.04,Default,,0000,0000,0000,,...sau khi Nội các tiền nhiệm\Nbị sụp đổ giải tán.
Dialogue: 0,0:03:47.89,0:03:50.75,Default,,0000,0000,0000,,Thế nhưng tôi chưa từng làm bất cứ điều gì\Nđể đáng phải chịu sự đối xử nhục nhã thế này!
Dialogue: 0,0:03:55.19,0:04:01.10,Default,,0000,0000,0000,,Nếu Takakura đã bất chấp thủ đoạn đến nước này, tôi sẽ đích thân\Nchấm dứt cục diện khủng hoảng này theo cách của {\i1}chính tôi{\i0}!
Dialogue: 0,0:04:01.30,0:04:03.27,Default,,0000,0000,0000,,Thưa Thủ tướng, ngài đang gọi cho ai vậy?
Dialogue: 0,0:04:09.48,0:04:12.27,Default,,0000,0000,0000,,Được rồi, bọn mình làm được rồi!\NĐây đã là chiếc thứ tám!
Dialogue: 0,0:04:12.48,0:04:15.14,Default,,0000,0000,0000,,Những phép tính toán quỹ đạo thế này\Nchính là sở trường số một của tụi mình!
Dialogue: 0,0:04:16.55,0:04:20.35,Default,,0000,0000,0000,,Vệ tinh tiếp theo này sẽ cho phép chúng ta tạo ra một tấm màn chắn mảnh vỡ\Nchắn ngang đường bay của quả tên lửa!
Dialogue: 0,0:04:20.59,0:04:23.52,Default,,0000,0000,0000,,Đúng như lời cậu nói, dẫu cho điều đó có nghĩa là\Nchúng ta phải bất tuân mệnh lệnh của Thiếu tá,
Dialogue: 0,0:04:23.62,0:04:26.59,Default,,0000,0000,0000,,thì quyết định đánh cược hạ rơi các vệ tinh xuống chặn đường bay của nó\Nchắc chắn là một sự lựa chọn hoàn toàn chuẩn xác!
Dialogue: 0,0:04:27.59,0:04:28.56,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:04:29.13,0:04:31.79,Default,,0000,0000,0000,,Có chuyện gì thế?\NKế hoạch sắp sửa thành công rồi cơ mà!
Dialogue: 0,0:04:32.67,0:04:34.22,Default,,0000,0000,0000,,Vấn đề là...
Dialogue: 0,0:04:34.67,0:04:39.20,Default,,0000,0000,0000,,Chẳng phải vệ tinh này chính là nơi\Nlưu trữ dữ liệu AI của tụi mình hay sao?
Dialogue: 0,0:04:41.14,0:04:44.17,Default,,0000,0000,0000,,Tớ không hiểu nổi! Đó là một vệ tinh\Ncủa Đế chế Mỹ cơ mà!
Dialogue: 0,0:04:44.74,0:04:45.61,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:04:46.31,0:04:50.04,Default,,0000,0000,0000,,Thế nhưng có vẻ như bọn mình đang được lưu trữ\Ntrong khoang tải trọng thuê lại...
Dialogue: 0,0:04:50.15,0:04:52.91,Default,,0000,0000,0000,,...trên một vệ tinh của Đế chế Mỹ\Nđược phóng lên từ chính lãnh thổ Nhật Bản.
Dialogue: 0,0:04:53.05,0:04:58.08,Default,,0000,0000,0000,,Ôi trời, cái quái gì thế này?! Kể cả khi không có Hiệp ước An ninh đó,\Nchúng ta rốt cuộc vẫn phải ngoan ngoãn nghe theo răm rắp lời họ sao!
Dialogue: 0,0:04:58.49,0:05:02.62,Default,,0000,0000,0000,,Dẫu vậy, tại sao cậu nghĩ Thiếu tá lại quyết định\Nđặt dữ liệu AI của chúng ta lên một vệ tinh của bọn họ chứ?
Dialogue: 0,0:05:02.73,0:05:07.26,Default,,0000,0000,0000,,Biết đâu chị ấy định dùng tụi mình\Nđể làm gián điệp theo dõi bọn họ thì sao.
Dialogue: 0,0:05:07.67,0:05:11.00,Default,,0000,0000,0000,,Chẳng thể nào biết được rốt cuộc chị ấy đang tính toán điều gì,\Nnhưng tình thế này thực sự đẩy tụi mình vào thế khó...
Dialogue: 0,0:05:11.44,0:05:13.13,Default,,0000,0000,0000,,Chúng ta sắp hết thời gian rồi!
Dialogue: 0,0:05:23.02,0:05:24.92,Default,,0000,0000,0000,,Anh Ishikawa ơi!
Dialogue: 0,0:05:25.42,0:05:26.48,Default,,0000,0000,0000,,Ừ, gì thế?
Dialogue: 0,0:05:26.62,0:05:31.39,Default,,0000,0000,0000,,Dạ, em phải đi cùng các bạn đến một nơi...
Dialogue: 0,0:05:35.83,0:05:37.35,Default,,0000,0000,0000,,Cậu phải đi sao?
Dialogue: 0,0:05:37.46,0:05:38.76,Default,,0000,0000,0000,,Em xin lỗi anh nhé.
Dialogue: 0,0:05:38.90,0:05:41.96,Default,,0000,0000,0000,,Không sao đâu. Hãy chăm sóc thật tốt\Ncho Thiếu tá và mọi người nhé.
Dialogue: 0,0:05:42.10,0:05:43.13,Default,,0000,0000,0000,,Dạ chắc chắn rồi ạ!
Dialogue: 0,0:05:46.14,0:05:50.07,Default,,0000,0000,0000,,Chà, vậy là... xem ra kể từ lúc này\Nmình thực sự {\i1}phải đơn độc tác chiến{\i0} rồi.
Dialogue: 0,0:05:55.01,0:05:56.50,Default,,0000,0000,0000,,Thiếu tá?
Dialogue: 0,0:05:57.05,0:05:58.31,Default,,0000,0000,0000,,Cô đang ở đâu vậy?
Dialogue: 0,0:06:07.89,0:06:08.88,Default,,0000,0000,0000,,Kuze.
Dialogue: 0,0:06:09.00,0:06:09.98,Default,,0000,0000,0000,,Tôi nghe đây?
Dialogue: 0,0:06:10.10,0:06:12.66,Default,,0000,0000,0000,,Cậu có biết cách\Ngấp hạc giấy không?
Dialogue: 0,0:06:12.77,0:06:13.82,Default,,0000,0000,0000,,Hạc giấy sao?
Dialogue: 0,0:06:13.93,0:06:16.99,Default,,0000,0000,0000,,Ừ. Và chỉ được dùng\Nduy nhất bàn tay trái thôi.
Dialogue: 0,0:06:20.04,0:06:23.10,Default,,0000,0000,0000,,Nếu được cài đặt phần mềm điều khiển thích hợp,\Nthì bất kỳ ai cũng có thể làm được điều đó.
Dialogue: 0,0:06:23.21,0:06:25.04,Default,,0000,0000,0000,,Ý tôi không phải như vậy.
Dialogue: 0,0:06:28.15,0:06:31.12,Default,,0000,0000,0000,,Bản thân {\i1}cậu{\i0} có thể làm được điều đó không?\NTự mình gấp một con hạc chỉ bằng tay trái?
Dialogue: 0,0:06:31.62,0:06:33.21,Default,,0000,0000,0000,,Bây giờ thì tôi làm được rồi.
Dialogue: 0,0:06:36.19,0:06:39.09,Default,,0000,0000,0000,,Nghe giọng thì dường như cô cũng là một người\Ntừng nếm trải không ít sự cô đơn trong đời.
Dialogue: 0,0:06:39.39,0:06:42.33,Default,,0000,0000,0000,,Tên của cô là gì?\NTôi chưa từng hỏi, nhưng rốt cuộc cô là ai?
Dialogue: 0,0:06:43.10,0:06:46.72,Default,,0000,0000,0000,,Tôi không còn nhớ nữa.\NNhưng tôi có một bí danh.
Dialogue: 0,0:06:47.07,0:06:49.33,Default,,0000,0000,0000,,Với cậu cũng vậy,\Nphải không?
Dialogue: 0,0:06:49.57,0:06:54.40,Default,,0000,0000,0000,,Cô nói đúng. Tôi đã được những người tị nạn\Nđặt cho vô số cái tên khác nhau.
Dialogue: 0,0:06:55.71,0:06:58.94,Default,,0000,0000,0000,,Tôi từng sát cánh cùng họ\Nvới ý nguyện cứu rỗi họ,
Dialogue: 0,0:06:59.28,0:07:03.41,Default,,0000,0000,0000,,nhưng có lẽ lý do thực sự khiến tôi gắn bó với họ\Nchỉ là để xua tan đi nỗi cô đơn trong lòng mà thôi.
Dialogue: 0,0:07:03.75,0:07:06.34,Default,,0000,0000,0000,,Thế nhưng cuối cùng, cậu vẫn chẳng thể nào\Nxua tan đi được nỗi cô đơn ấy.
Dialogue: 0,0:07:06.99,0:07:11.51,Default,,0000,0000,0000,,Bởi vì dẫu cho muôn người có thể dựa dẫm vào cậu,\Nnhưng cậu lại chẳng thể dựa dẫm vào {\i1}bất kỳ ai trong số họ{\i0}.
Dialogue: 0,0:07:12.79,0:07:16.59,Default,,0000,0000,0000,,Cô đã có ai đó để bản thân\Ncó thể mở lòng trọn vẹn chưa?
Dialogue: 0,0:07:17.13,0:07:19.56,Default,,0000,0000,0000,,Cũng gần như vậy...
Dialogue: 0,0:07:23.40,0:07:24.66,Default,,0000,0000,0000,,Tôi hiểu rồi...
Dialogue: 0,0:07:25.81,0:07:29.47,Default,,0000,0000,0000,,Còn tôi, tôi đã mải miết đi tìm người ấy của mình\Nsuốt một quãng thời gian đằng đẵng rất dài.
Dialogue: 0,0:07:38.65,0:07:42.14,Default,,0000,0000,0000,,Chúng ta sẽ ổn thôi! Tên lửa\Nsẽ không rơi trúng gần cây cầu này đâu!
Dialogue: 0,0:07:42.29,0:07:44.26,Default,,0000,0000,0000,,Hãy giữ bình tĩnh\Nvà tiếp tục di chuyển!
Dialogue: 0,0:08:51.62,0:08:55.32,Default,,0000,0000,0000,,Motoko!
Dialogue: 0,0:09:23.96,0:09:27.85,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(1500,250)}bokura wa minna ikite iru\N{\c&H00FF00&}Chúng ta đều đang sống, mỗi người trong chúng ta,
Dialogue: 0,0:09:27.85,0:09:31.86,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}ikite iru kara kanashii n' da\N{\c&H00FF00&}và vì đang sống nên ta mới biết buồn đau!
Dialogue: 0,0:09:32.16,0:09:36.03,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}tenohira wo taiyou\N{\c&H00FF00&}Khi ta giơ bàn tay hướng về phía mặt trời...
Dialogue: 0,0:09:36.03,0:09:39.37,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}ni sukashite mireba\N{\c&H00FF00&}...và nhìn qua từng kẽ ngón tay,
Dialogue: 0,0:09:39.81,0:09:46.80,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}makka ni nagareru boku no chishio\N{\c&H00FF00&}ta nhìn thấy dòng máu đỏ tươi đang cuộn chảy bên trong!
Dialogue: 0,0:09:47.05,0:09:55.96,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}mimizu datte okera datte amenbo datte\N{\c&H00FF00&}Dẫu là giun đất, dẫu là dế chũi, hay là những chú cà cuống!
Dialogue: 0,0:09:51.45,0:09:57.82,Default,,0000,0000,0000,,Không thể tin được... Các cậu biết không, tôi cá\Nchắc chắn rằng các cậu cũng có một linh hồn Ghost...
Dialogue: 0,0:09:55.96,0:09:59.80,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}minna minna ikite iru n' da\N{\c&H00FF00&}Tất cả, tất cả chúng ta đều đang sống,
Dialogue: 0,0:09:59.23,0:10:01.33,Default,,0000,0000,0000,,Có chuyện gì thế?!\NProto!
Dialogue: 0,0:09:59.80,0:10:03.19,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}tomodachi nan da\N{\c&H00FF00&}và tất cả chúng ta đều là bạn bè!
Dialogue: 0,0:10:03.60,0:10:07.62,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}bokura wa minna ikite iru\N{\c&H00FF00&}Chúng ta đều đang sống, mỗi người trong chúng ta,
Dialogue: 0,0:10:07.62,0:10:11.44,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}ikite iru kara warau n' da\N{\c&H00FF00&}và vì đang sống nên ta mới có thể cất tiếng cười!
Dialogue: 0,0:10:11.54,0:10:15.38,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}bokura wa minna ikite iru\N{\c&H00FF00&}Chúng ta đều đang sống, mỗi người trong chúng ta,
Dialogue: 0,0:10:15.38,0:10:19.54,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}ikite iru kara ureshii n' da\N{\c&H00FF00&}và vì đang sống nên ta mới cảm thấy ngập tràn niềm vui!
Dialogue: 0,0:10:19.75,0:10:23.28,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}tenohira wo taiyou ni\N{\c&H00FF00&}Khi ta giơ bàn tay hướng về phía mặt trời...
Dialogue: 0,0:10:23.28,0:10:27.08,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}sukashite mireba\N{\c&H00FF00&}...và nhìn qua từng kẽ ngón tay,
Dialogue: 0,0:10:27.42,0:10:34.48,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}makka ni nagareru boku no chishio\N{\c&H00FF00&}ta nhìn thấy dòng máu đỏ tươi đang cuộn chảy bên trong!
Dialogue: 0,0:10:34.66,0:10:42.83,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,250)}donbo datte kaeru datte mitsubachi datte\N{\c&H00FF00&}Dẫu là chuồn chuồn, dẫu là ếch xanh, hay là những chú ong mật!
Dialogue: 0,0:10:43.54,0:10:47.97,GitS 2nd Gig E26 Insert,,0000,0000,0000,,{\fad(250,1500)}minna minna ikite iru n' da tomodachi \N{\c&H00FF00&}Tất cả, tất cả chúng ta đều đang sống, và chúng ta là...
Dialogue: 0,0:10:51.81,0:10:54.28,Default,,0000,0000,0000,,Có chuyện gì vậy, Proto?\NĐã xảy ra chuyện gì thế?
Dialogue: 0,0:10:54.91,0:10:59.54,Default,,0000,0000,0000,,Có vẻ như các Tachikoma vừa đâm thẳng vệ tinh của chúng\Nvào quả tên lửa hạt nhân.
Dialogue: 0,0:10:59.72,0:11:00.98,Default,,0000,0000,0000,,Chúng vừa làm cái gì cơ?!
Dialogue: 0,0:11:01.49,0:11:04.39,Default,,0000,0000,0000,,Vậy là chúng ta đã ngăn chặn được\Nkịch bản tồi tệ nhất rồi.
Dialogue: 0,0:11:04.56,0:11:05.72,Default,,0000,0000,0000,,Vâng, thưa sếp.
Dialogue: 0,0:11:05.96,0:11:08.79,Default,,0000,0000,0000,,Tôi xin lỗi,\Ntôi nghe không hiểu rõ lắm.
Dialogue: 0,0:11:09.23,0:11:14.00,Default,,0000,0000,0000,,Dường như vài người cấp dưới của tôi vừa hy sinh thân mình\Nđể chặn đứng quả tên lửa hạt nhân.
Dialogue: 0,0:11:14.10,0:11:15.26,Default,,0000,0000,0000,,Ông vừa mất đi\Nnhững người đồng đội của mình sao?!
Dialogue: 0,0:11:15.53,0:11:17.66,Default,,0000,0000,0000,,Chuyện đó không quan trọng đâu, thưa ngài.\NLúc nãy ngài vừa gọi điện cho ai vậy?
Dialogue: 0,0:11:22.78,0:11:24.14,Default,,0000,0000,0000,,Tôi đây.
Dialogue: 0,0:11:26.05,0:11:28.14,Default,,0000,0000,0000,,Quả tên lửa\Nđã bị đánh chặn rồi sao?
Dialogue: 0,0:11:28.65,0:11:29.81,Default,,0000,0000,0000,,Chà, cũng chẳng sao cả.
Dialogue: 0,0:11:30.15,0:11:34.71,Default,,0000,0000,0000,,Đằng nào đi nữa, chúng ta cũng sẽ lợi dụng hành động của Kayabuki\Nđể thiết lập nên một khuôn khổ Chiến tranh Lạnh mới.
Dialogue: 0,0:11:37.42,0:11:40.55,Default,,0000,0000,0000,,Thật đáng tiếc, hắn ta đã không thể\Ntrở thành một người hùng...
Dialogue: 0,0:11:43.80,0:11:45.02,Default,,0000,0000,0000,,Vụ nổ vừa rồi có phải là thứ\Nmà tôi đang nghĩ đến không?
Dialogue: 0,0:11:45.13,0:11:48.79,Default,,0000,0000,0000,,Ừ, tôi vừa nghe thấy tiếng hát\Ncủa các Tachikoma.
Dialogue: 0,0:11:48.93,0:11:51.49,Default,,0000,0000,0000,,Chính bọn chúng đã ngăn chặn nó\Nphải không?
Dialogue: 0,0:12:08.32,0:12:09.34,Default,,0000,0000,0000,,Chuyện gì đã xảy ra vậy?
Dialogue: 0,0:12:09.46,0:12:14.02,Default,,0000,0000,0000,,Tôi cũng không rõ tại sao, nhưng dường như các AI của tôi\Nđã làm một điều hoàn toàn khác với những gì tôi đã ra lệnh.
Dialogue: 0,0:12:18.76,0:12:20.20,Default,,0000,0000,0000,,Thiếu tá! Cô ở trong đó\Nvẫn ổn chứ?!
Dialogue: 0,0:12:20.67,0:12:22.07,Default,,0000,0000,0000,,Các Tachikoma...
Dialogue: 0,0:12:23.87,0:12:25.20,Default,,0000,0000,0000,,Tôi biết rồi.
Dialogue: 0,0:12:32.54,0:12:35.48,Default,,0000,0000,0000,,Trưởng ban. Nếu Thủ tướng vừa liên lạc với người\Nmà tôi đang nghĩ tới, thì điều đó sẽ...
Dialogue: 0,0:12:35.58,0:12:40.58,Default,,0000,0000,0000,,Ừ, tôi biết. Nhưng hiện tại, việc bắt giữ Tổng thư ký\NNội các và Gohda là ưu tiên hàng đầu.
Dialogue: 0,0:12:41.32,0:12:46.05,Default,,0000,0000,0000,,Rất có khả năng những gì diễn ra ngày hôm nay\Nsẽ chẳng bao giờ được công khai trong suốt cuộc đời chúng ta.
Dialogue: 0,0:12:46.86,0:12:49.12,Default,,0000,0000,0000,,Trước hết, hãy dọn dẹp đống hỗn độn này\Ncàng nhanh càng tốt.
Dialogue: 0,0:12:49.53,0:12:50.83,Default,,0000,0000,0000,,Rõ rồi!
Dialogue: 0,0:12:54.93,0:12:56.30,Default,,0000,0000,0000,,Vào đi.
Dialogue: 0,0:12:59.20,0:13:03.90,Default,,0000,0000,0000,,Tổng thư ký Nội các Takakura, tôi tin là ông\Nthừa hiểu lý do tại sao chúng tôi có mặt ở đây.
Dialogue: 0,0:13:04.58,0:13:09.04,Default,,0000,0000,0000,,Hành vi của ông cấu thành tội đảo chính, cũng như tội giết người\Nhàng loạt dưới vỏ bọc chiến tranh.
Dialogue: 0,0:13:09.62,0:13:12.71,Default,,0000,0000,0000,,Tôi không thể đứng khoanh tay nhìn chúng tự kích nổ\Nbằng một vũ khí hạt nhân được.
Dialogue: 0,0:13:12.82,0:13:14.75,Default,,0000,0000,0000,,Bọn họ {\i1}không hề có{\i0}\Nbất kỳ thứ vũ khí nào như vậy!
Dialogue: 0,0:13:15.09,0:13:18.92,Default,,0000,0000,0000,,Vở kịch dựng sẵn đó là do đích thân ông và tên Gohda\Nbên Cục Tình báo Nội các thêu dệt nên!
Dialogue: 0,0:13:19.46,0:13:20.76,Default,,0000,0000,0000,,Gohda sao?
Dialogue: 0,0:13:21.16,0:13:25.89,Default,,0000,0000,0000,,Tất cả những gì tôi làm chỉ là đẩy nhanh tiến trình phê chuẩn Hiệp ước An ninh\Nnhằm bảo đảm tương lai cho đất nước này.
Dialogue: 0,0:13:26.00,0:13:28.52,Default,,0000,0000,0000,,Chúng ta đang ở trong một cuộc chiến\Nchống lại người tị nạn.
Dialogue: 0,0:13:30.57,0:13:31.59,Default,,0000,0000,0000,,Thưa Tổng thư ký!
Dialogue: 0,0:13:31.97,0:13:35.87,Default,,0000,0000,0000,,Tôi xin nhắc cho ông nhớ rằng ông sẽ phải trải qua\Nmột cuộc thẩm vấn bí mật vô cùng gắt gao...
Dialogue: 0,0:13:35.97,0:13:38.03,Default,,0000,0000,0000,,Tôi đã chuẩn bị tâm lý sẵn sàng\Ncho điều đó ngay từ đầu rồi.
Dialogue: 0,0:13:38.14,0:13:43.21,Default,,0000,0000,0000,,Còn về phần cô, cô quả thực hành xử đúng chất phụ nữ\Nhơn nhiều so với những gì tôi từng nghĩ đấy.
Dialogue: 0,0:13:43.72,0:13:47.05,Default,,0000,0000,0000,,Tôi không biết cô đã van nài ai cứu giúp\Ntrong cơn bộc phát cảm xúc nhất thời đó,
Dialogue: 0,0:13:47.15,0:13:50.32,Default,,0000,0000,0000,,nhưng đất nước này buộc phải tự đứng vững trên đôi chân của mình\Nmà không cần phải dựa dẫm vào Đế chế Mỹ!
Dialogue: 0,0:13:51.09,0:13:54.08,Default,,0000,0000,0000,,Xem ra ông đang ngộ nhận\Ntrong ảo tưởng sai lầm rồi đấy.
Dialogue: 0,0:13:56.96,0:13:59.12,Default,,0000,0000,0000,,Đó trông không giống\Nmột vụ nổ hạt nhân.
Dialogue: 0,0:13:59.23,0:14:02.17,Default,,0000,0000,0000,,Xin lệnh chỉ thị, thưa chỉ huy? Chúng ta có phóng\Nquả tên lửa thứ hai không?
Dialogue: 0,0:14:02.53,0:14:07.70,Default,,0000,0000,0000,,Không. Tạm hoãn lại cho tới khi chúng ta nhận dạng được những mục tiêu lạ\Nđang bay từ phía đông bắc xuống phía nam.
Dialogue: 0,0:14:08.14,0:14:12.44,Default,,0000,0000,0000,,Nếu như chúng mang trên mình\Nphù hiệu quân sự \"Bát Nhất\" thì sao?
Dialogue: 0,0:14:16.11,0:14:20.48,Default,,0000,0000,0000,,\"Độc lập quốc gia thông qua\Nđộc lập cá nhân.\"
Dialogue: 0,0:14:23.32,0:14:26.92,Default,,0000,0000,0000,,Tôi muốn tin rằng bản thân luôn hành động nhất quán với lý tưởng đó\Nkể từ ngày đầu tiên tôi nhậm chức.
Dialogue: 0,0:14:27.89,0:14:29.88,Default,,0000,0000,0000,,Đúng như trước đây, chính phủ Kayabuki\Nsẽ kiên định theo đuổi...
Dialogue: 0,0:14:30.00,0:14:32.16,Default,,0000,0000,0000,,...chính sách hành động tự chủ\Nvà hòa giải thông qua Liên Hợp Quốc.
Dialogue: 0,0:14:32.40,0:14:38.36,Default,,0000,0000,0000,,Tôi chủ trương duy trì khoảng cách bình đẳng với Đế chế Mỹ,\NLiên minh Mỹ-Xô,
Dialogue: 0,0:14:38.70,0:14:41.76,Default,,0000,0000,0000,,Trung Quốc, cũng như các nước châu Á\Nvà các quốc gia trong Liên minh châu Âu.
Dialogue: 0,0:14:54.09,0:14:56.95,Default,,0000,0000,0000,,Một đơn vị bí mật của Lực lượng Phòng vệ Không quân sao?
Dialogue: 0,0:14:57.72,0:15:01.06,Default,,0000,0000,0000,,Được rồi, phía Nhật Bản đã thể hiện rõ lập trường của họ.\NChúng ta rút lui thôi.
Dialogue: 0,0:15:02.46,0:15:03.95,Default,,0000,0000,0000,,Giải hắn đi.
Dialogue: 0,0:15:04.06,0:15:05.53,Default,,0000,0000,0000,,Rõ, thưa Thủ tướng.
Dialogue: 0,0:15:11.94,0:15:14.87,Default,,0000,0000,0000,,Thủ tướng cử chúng tôi đến!\NMau lên xe đi!
Dialogue: 0,0:15:15.14,0:15:16.37,Default,,0000,0000,0000,,Có ngay!
Dialogue: 0,0:15:17.51,0:15:18.74,Default,,0000,0000,0000,,Đứng dậy đi.
Dialogue: 0,0:15:19.65,0:15:22.77,Default,,0000,0000,0000,,Tôi xin phép lấy lại thứ này,\Nnếu cậu không phiền.
Dialogue: 0,0:15:32.32,0:15:34.45,Default,,0000,0000,0000,,{\i1}Saito! Paz!{\i0}\N{\i1}Borma!{\i0}
Dialogue: 0,0:15:35.19,0:15:36.75,Default,,0000,0000,0000,,{\i1}Thiếu tá vẫn còn lành lặn nguyên vẹn{\i0}\N{\i1}đấy chứ?{\i0}
Dialogue: 0,0:15:36.86,0:15:41.86,Default,,0000,0000,0000,,{\i1}Ừ. Thứ lỗi nhé, nhưng các anh hãy ở yên đó và lập một bản báo cáo{\i0}\N{\i1}chi tiết đầy đủ cho Lực lượng Phòng vệ.{\i0}
Dialogue: 0,0:15:42.07,0:15:43.19,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:15:57.45,0:15:59.25,Default,,0000,0000,0000,,Anh là...
Dialogue: 0,0:16:13.20,0:16:15.00,Default,,0000,0000,0000,,Ishikawa của Đội 9 Cục An ninh Công cộng,\Ntôi đoán không lầm chứ?
Dialogue: 0,0:16:15.47,0:16:17.49,Default,,0000,0000,0000,,Tôi xin phép giữ lại thứ này,\Nnếu anh không phiền.
Dialogue: 0,0:16:18.77,0:16:20.00,Default,,0000,0000,0000,,Ồ, anh muốn nói tới cái này sao?
Dialogue: 0,0:16:20.14,0:16:21.57,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:16:26.85,0:16:28.18,Default,,0000,0000,0000,,Đừng hòng giở trò với bọn tao, thằng ranh.
Dialogue: 0,0:16:28.65,0:16:32.55,Default,,0000,0000,0000,,Đội 9 là chuyên gia trong các thủ đoạn đen tối\Nvà chiến tranh thông tin.
Dialogue: 0,0:16:36.76,0:16:39.12,Default,,0000,0000,0000,,Nếu quốc gia chư hầu lơ là trễ nải\Ntrong việc phụng sự,
Dialogue: 0,0:16:39.29,0:16:41.92,Default,,0000,0000,0000,,thì tình trạng đói khát kiệt quệ của quốc gia tiêu thụ\Nlà điều tất yếu không thể tránh khỏi.
Dialogue: 0,0:16:42.26,0:16:45.13,Default,,0000,0000,0000,,Tình trạng thiếu hụt nhân lực luôn là đòn bẩy thúc đẩy\Ncho các ngành công nghiệp bóc lột nô dịch,
Dialogue: 0,0:16:45.46,0:16:49.80,Default,,0000,0000,0000,,thế nhưng nếu các người đòi hỏi quyền lợi quá gay gắt,\Nnhững huyết mạch của chủ nghĩa tư bản sẽ bị xơ vữa.
Dialogue: 0,0:16:50.30,0:16:53.67,Default,,0000,0000,0000,,Trong tâm thức, quốc gia này luôn tự coi mình\Nlà một nhà nước tư bản chủ nghĩa,
Dialogue: 0,0:16:54.17,0:16:57.01,Default,,0000,0000,0000,,nhưng trong thực tế, đây lại là\Nnhà nước xã hội chủ nghĩa lý tưởng nhất.
Dialogue: 0,0:16:57.74,0:16:59.61,Default,,0000,0000,0000,,Thế nhưng khi những chất cặn bã phế thải\Ntích tụ quá nhiều trong huyết quản,
Dialogue: 0,0:16:59.75,0:17:02.71,Default,,0000,0000,0000,,thì những bộ não đủ năng lực điều tiết phân bổ dòng máu\Nsẽ trở nên vô cùng cấp thiết.
Dialogue: 0,0:17:03.75,0:17:07.48,Default,,0000,0000,0000,,Với những lời hô hào về tự do và bình đẳng,\Ntôi chắc chắn ở đất nước của các anh cũng y như vậy mà thôi.
Dialogue: 0,0:17:07.59,0:17:08.68,Default,,0000,0000,0000,,Tất nhiên rồi!
Dialogue: 0,0:17:08.82,0:17:11.79,Default,,0000,0000,0000,,{\i1}Thế nhưng những gì chúng tôi làm ngoài mặt và những gì làm sau cánh cửa đóng kín{\i0}\N{\i1}lại là hai chuyện hoàn toàn khác biệt.{\i0}
Dialogue: 0,0:17:13.23,0:17:15.16,Default,,0000,0000,0000,,Được rồi... Bắn đi!
Dialogue: 0,0:17:25.20,0:17:26.07,Default,,0000,0000,0000,,Đừng bắn!
Dialogue: 0,0:17:26.67,0:17:28.23,Default,,0000,0000,0000,,Đừng có vội vàng tìm đến\Ncái chết như thế.
Dialogue: 0,0:17:30.24,0:17:33.01,Default,,0000,0000,0000,,Ông Aramaki... Chuyện này rốt cuộc\Nlà có ý gì đây?
Dialogue: 0,0:17:33.25,0:17:36.51,Default,,0000,0000,0000,,Kazundo Gohda! Cậu bị tình nghi có hành vi cấu kết\Nnhằm khơi mào một cuộc nội chiến,
Dialogue: 0,0:17:37.15,0:17:42.09,Default,,0000,0000,0000,,...cũng như cấu kết với một thế lực ngoại bang\Nđể kích động chiến tranh vì mưu đồ tư lợi cá nhân.
Dialogue: 0,0:17:42.49,0:17:43.92,Default,,0000,0000,0000,,Cậu phải đi cùng chúng tôi.
Dialogue: 0,0:17:44.02,0:17:47.19,Default,,0000,0000,0000,,Tổng thư ký Nội các đã thừa nhận\Nhầu hết các cáo buộc rồi.
Dialogue: 0,0:17:47.86,0:17:50.92,Default,,0000,0000,0000,,Hơn nữa, màn kịch cuối cùng của cậu\Nđã thất bại thảm hại.
Dialogue: 0,0:17:51.06,0:17:55.52,Default,,0000,0000,0000,,Ông có chắc không? Dù vậy, bắt giữ tôi lúc này\Ncũng sẽ hoàn toàn vô ích mà thôi.
Dialogue: 0,0:17:55.87,0:17:57.16,Default,,0000,0000,0000,,Cậu nói vậy\Nlà có ý gì?
Dialogue: 0,0:17:57.64,0:18:02.10,Default,,0000,0000,0000,,Thứ nhất, Tổng thư ký Nội các và tôi\Nvốn dĩ luôn duy trì một mối quan hệ hoàn toàn độc lập.
Dialogue: 0,0:18:02.27,0:18:05.68,Default,,0000,0000,0000,,Thứ hai, một bản báo cáo do đích thân\Ntôi chắp bút...
Dialogue: 0,0:18:05.81,0:18:08.37,Default,,0000,0000,0000,,...lẽ ra lúc này đã nằm trên bàn của Sở Cảnh sát Đô thị rồi.
Dialogue: 0,0:18:10.05,0:18:14.95,Default,,0000,0000,0000,,Chẳng lẽ ông không biết sao? Bộ luật hình sự quy định\Nrằng việc tự nguyện ra trình diện trước pháp luật,
Dialogue: 0,0:18:15.05,0:18:18.65,Default,,0000,0000,0000,,sẽ giúp tôi không thể bị truy cứu với bất kỳ\Ntội danh nào mà ông vừa nêu ra.
Dialogue: 0,0:18:19.36,0:18:23.49,Default,,0000,0000,0000,,Tôi sẽ chuyển đến một quốc gia\Nđang có nhu cầu sử dụng tài năng của tôi.
Dialogue: 0,0:18:25.20,0:18:27.19,Default,,0000,0000,0000,,Cậu chắc chắn chứ? Cậu thực sự muốn\Nchơi ván bài này theo cách đó sao?
Dialogue: 0,0:18:28.70,0:18:31.07,Default,,0000,0000,0000,,Tôi có mang theo một chỉ thị từ Thủ tướng đây.
Dialogue: 0,0:18:31.50,0:18:34.56,Default,,0000,0000,0000,,Thủ tướng luôn đánh giá rất cao\Nnăng lực vượt trội của cậu.
Dialogue: 0,0:18:34.77,0:18:38.61,Default,,0000,0000,0000,,Thế nhưng nếu có bất kỳ nguy cơ nào cho thấy những tài năng đó\Nrơi vào tay của một thế lực ngoại bang,
Dialogue: 0,0:18:38.74,0:18:40.84,Default,,0000,0000,0000,,thì chúng tôi được lệnh phải ngăn chặn điều đó\Nbằng mọi giá.
Dialogue: 0,0:18:41.18,0:18:45.62,Default,,0000,0000,0000,,Bà ấy cũng căn dặn rằng nếu thấy cần thiết,\Nchúng tôi không được ngần ngại sử dụng vũ lực sát thương.
Dialogue: 0,0:18:47.09,0:18:48.55,Default,,0000,0000,0000,,Cậu muốn giải quyết chuyện này\Nnhư thế nào đây?
Dialogue: 0,0:18:49.55,0:18:52.39,Default,,0000,0000,0000,,Đừng bận tâm tới ông ta.\NChỉ là đòn dọa dẫm suông thôi.
Dialogue: 0,0:18:52.72,0:18:53.88,Default,,0000,0000,0000,,Đi thôi.
Dialogue: 0,0:18:53.99,0:18:54.79,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:18:55.03,0:18:56.52,Default,,0000,0000,0000,,Cậu nghĩ vậy thật sao?
Dialogue: 0,0:18:59.23,0:19:00.72,Default,,0000,0000,0000,,Vậy thì cứ việc\Nchết đi!
Dialogue: 0,0:19:09.11,0:19:10.63,Default,,0000,0000,0000,,Chà, thật là một nỗi tiếc nuối cay đắng...
Dialogue: 0,0:19:12.24,0:19:13.47,Default,,0000,0000,0000,,Chào!
Dialogue: 0,0:19:14.25,0:19:15.71,Default,,0000,0000,0000,,Này, mày chính là cái thằng khốn nạn ở...
Dialogue: 0,0:19:15.81,0:19:19.65,Default,,0000,0000,0000,,Bọn mày đã nhúng tay vào chuyện này\Ntừ bao lâu rồi cơ chứ?!
Dialogue: 0,0:19:20.79,0:19:21.78,Default,,0000,0000,0000,,Trưởng ban!
Dialogue: 0,0:19:22.12,0:19:24.52,Default,,0000,0000,0000,,Nhanh lên! Tuyệt đối không được để\Nbọn chúng khử hắn ta!
Dialogue: 0,0:19:25.79,0:19:26.92,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:19:43.44,0:19:45.17,Default,,0000,0000,0000,,Cái gì trong tay cậu\Nthế kia?
Dialogue: 0,0:19:45.51,0:19:47.00,Default,,0000,0000,0000,,Một con hạc...
Dialogue: 0,0:19:47.11,0:19:48.44,Default,,0000,0000,0000,,Hạc giấy sao?
Dialogue: 0,0:19:49.92,0:19:52.71,Default,,0000,0000,0000,,Chà chà, những vi cỗ máy micromachine này\Nhoạt động khá là hiệu quả đấy chứ nhỉ?
Dialogue: 0,0:19:53.29,0:19:55.19,Default,,0000,0000,0000,,Cậu sẽ có được\Nmột cái chết êm ái không đau đớn.
Dialogue: 0,0:19:55.75,0:20:00.95,Default,,0000,0000,0000,,Cậu là một kẻ đầy cuốn hút, nhưng bọn tôi\Ncoi cậu là một phần tử vô cùng nguy hiểm.
Dialogue: 0,0:20:01.46,0:20:05.56,Default,,0000,0000,0000,,Đất nước của cậu không cần những thủ lĩnh mang mầm mống mị dân\Nmà không thể nào kiểm soát được.
Dialogue: 0,0:20:05.66,0:20:08.60,Default,,0000,0000,0000,,Những kẻ tiêu thụ ngoan ngoãn biết vâng lời,\Nđó mới chính là mục tiêu tối thượng.
Dialogue: 0,0:20:11.44,0:20:14.13,Default,,0000,0000,0000,,Tôi sẽ đi trước một bước...
Dialogue: 0,0:20:32.92,0:20:35.89,Default,,0000,0000,0000,,{\i1}Thiếu tá! Chị đang lêu lổng ở xó xỉnh nào{\i0}\N{\i1}mà không chịu về thế hả?!{\i0}
Dialogue: 0,0:20:36.46,0:20:39.56,Default,,0000,0000,0000,,{\i1}Hãy hội quân với Azuma và Proto{\i0}\N{\i1}tại Phường 4 Niihama ngay đi!{\i0}
Dialogue: 0,0:20:40.50,0:20:44.83,Default,,0000,0000,0000,,{\i1}Có chuyện gì vậy? Ngân sách bổ sung mà chị yêu cầu{\i0}\N{\i1}đã được thông qua toàn bộ rồi đấy.{\i0}
Dialogue: 0,0:20:45.60,0:20:47.30,Default,,0000,0000,0000,,Uchikoma! Báo cáo thông tin!
Dialogue: 0,0:20:47.77,0:20:49.03,Default,,0000,0000,0000,,Rõ, thưa sếp!
Dialogue: 0,0:20:51.98,0:20:53.38,Default,,0000,0000,0000,,Này, Thiếu tá...
Dialogue: 0,0:20:53.85,0:20:56.58,Default,,0000,0000,0000,,{\i1}Đã có quá nhiều sinh mạng{\i0}\N{\i1}phải nằm xuống trong sự việc lần này...{\i0}
Dialogue: 0,0:20:57.18,0:21:00.05,Default,,0000,0000,0000,,{\i1}Tất cả những gì đạt được chỉ là đưa vấn đề người tị nạn{\i0}\N{\i1}quay trở lại vạch xuất phát ban đầu,{\i0}
Dialogue: 0,0:21:00.15,0:21:03.02,Default,,0000,0000,0000,,{\i1}và chính sách \"Mặt trận Thống nhất Tự chủ\" của Thủ tướng Kayabuki...{\i0}
Dialogue: 0,0:21:03.12,0:21:06.25,Default,,0000,0000,0000,,{\i1}...có lẽ sẽ là một con đường đầy chông gai trắc trở đối với người dân.{\i0}
Dialogue: 0,0:21:06.63,0:21:10.72,Default,,0000,0000,0000,,{\i1}Những người như chúng ta sẽ được cần tới{\i0}\N{\i1}nhiều hơn bao giờ hết lúc này.{\i0}
Dialogue: 0,0:21:11.06,0:21:11.99,Default,,0000,0000,0000,,Có lẽ là vậy.
Dialogue: 0,0:21:12.10,0:21:15.40,Default,,0000,0000,0000,,Này, cô bị làm sao thế? Nói năng nghe cứ như thể\Nđó là chuyện của ai khác vậy.
Dialogue: 0,0:21:16.03,0:21:19.87,Default,,0000,0000,0000,,Thôi nào Thiếu tá, chẳng lẽ cô lại bắt đầu\Ntrở nên triết lý hóa sự đời rồi đấy à?
Dialogue: 0,0:21:21.91,0:21:25.71,Default,,0000,0000,0000,,Thiếu tá, tôi vừa nhận được báo cáo xác nhận rằng\Nngân sách bổ sung đã chính thức được thông qua...
Dialogue: 0,0:21:25.84,0:21:27.94,Default,,0000,0000,0000,,...trong phiên họp thứ 329\Ncủa Quốc hội.
Dialogue: 0,0:21:28.31,0:21:29.18,Default,,0000,0000,0000,,Tốt lắm!
Dialogue: 0,0:21:30.62,0:21:32.98,Default,,0000,0000,0000,,Tôi tuyên bố giải tán chiến dịch theo dõi hoa anh đào\Nxuyên ngày đêm của chúng ta!
Dialogue: 0,0:21:33.42,0:21:35.05,Default,,0000,0000,0000,,Lên đồ thôi nào,\Nchúng ta quay trở lại làm việc!
Dialogue: 0,0:21:35.59,0:21:36.75,Default,,0000,0000,0000,,Cũng đến lúc rồi đấy...
Dialogue: 0,0:21:36.89,0:21:38.01,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:21:38.52,0:21:40.39,Default,,0000,0000,0000,,Cứ tưởng là sắp sửa\Nchết vì buồn chán rồi chứ.
Dialogue: 0,0:21:41.09,0:21:42.89,Default,,0000,0000,0000,,Đáng lẽ mình nên làm một hớp rượu\Nđể sưởi ấm người lên một chút.
Dialogue: 0,0:21:43.13,0:21:45.29,Default,,0000,0000,0000,,Thật tuyệt khi Thiếu tá\Nđã quay trở lại...
Dialogue: 0,0:21:45.20,0:21:47.31,GitS 2nd Gig E26 ED Credits A,,0000,0000,0000,,{\fad(750,300)}Thì thầm xuyên qua những kẽ hở...
Dialogue: 0,0:21:45.66,0:21:48.69,Default,,0000,0000,0000,,Thế còn buổi họp giao ban thì sao?\NCô có muốn giải quyết bằng một cú lặn não không?
Dialogue: 0,0:21:47.31,0:21:52.07,GitS 2nd Gig E26 ED Credits A,,0000,0000,0000,,{\fad(300,300)}Trong bóng tối trỗi dậy trên mặt nước...
Dialogue: 0,0:21:49.00,0:21:51.59,Default,,0000,0000,0000,,Không, anh cứ đi trước và trực tiếp nắm quyền chỉ huy đi.
Dialogue: 0,0:21:51.70,0:21:53.57,Default,,0000,0000,0000,,Tôi sẽ đến hội quân\Nvới mọi người sau.
Dialogue: 0,0:21:52.65,0:21:58.12,GitS 2nd Gig E26 ED Credits A,,0000,0000,0000,,{\fad(300,700)}Bên trong tâm trí của một ai đó...
Dialogue: 0,0:21:53.71,0:21:54.87,Default,,0000,0000,0000,,Cô sẽ đến chứ?
Dialogue: 0,0:21:58.12,0:22:02.87,GitS 2nd Gig E26 ED Credits A,,0000,0000,0000,,{\fad(300,700)}Những thanh âm vang vọng ngự trị...
Dialogue: 0,0:22:01.45,0:22:02.50,Default,,0000,0000,0000,,Chuyện gì thế?
Dialogue: 0,0:22:03.18,0:22:06.15,Default,,0000,0000,0000,,Không có gì đâu,\Nquên đi.
Dialogue: 0,0:22:07.43,0:22:31.62,GitS 2nd Gig E26 ED Credits A,,0000,0000,0000,,{\fad(300,3000)}Những thanh âm vang vọng ngự trị!
Dialogue: 0,0:23:01.58,0:23:05.56,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(600,300)}Nỗi buồn đau vô can...
Dialogue: 0,0:23:06.06,0:23:10.98,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Sự tĩnh lặng rỗng không của những hàng cây...
Dialogue: 0,0:23:10.98,0:23:16.97,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Những rễ cây đan cài sâu vào lòng đất...
Dialogue: 0,0:23:17.15,0:23:19.41,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Thì thầm xuyên qua những kẽ hở...
Dialogue: 0,0:23:19.42,0:23:24.44,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Trong bóng tối trỗi dậy trên mặt nước...
Dialogue: 0,0:23:24.44,0:23:29.66,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Trong tiếng thở dài của ai đó...
Dialogue: 0,0:23:30.04,0:23:35.71,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Những mảnh ghép gào thét rền vang!
Dialogue: 0,0:23:35.71,0:23:44.85,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Sự tĩnh lặng đang thổn thức khóc than...
Dialogue: 0,0:23:45.50,0:23:55.88,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,500)}Những cánh cửa mở toang và những chiếc ly cạn đáy,
Dialogue: 0,0:23:56.04,0:24:01.86,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,300)}Một mùa Giáng sinh nơi Khu rừng Tĩnh lặng...
Dialogue: 0,0:24:01.96,0:24:08.55,GitS 2nd Gig E26 ED Credits B,,0000,0000,0000,,{\fad(300,1000)}Tiếng tích tắc buông lơi của bàn tay mỏi mệt...
Dialogue: 0,0:24:08.55,0:24:10.55,Default,,0000,0000,0000,,


