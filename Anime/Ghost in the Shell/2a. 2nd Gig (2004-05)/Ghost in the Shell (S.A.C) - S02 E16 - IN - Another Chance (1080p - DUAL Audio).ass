Dialogue: 0,0:01:14.56,0:01:21.62,GitS 2nd Gig OP Credits,,0000,0000,0000,,{\i1\fs85\c&H00FF00&\fad(0,2000)}Chúng ta trỗi dậy hay gục ngã...{\i0}
Dialogue: 0,0:01:46.06,0:01:48.55,Default,,0000,0000,0000,,{\i1}Trụ sở, tôi vừa trở về{\i0}\N{\i1}từ bán đảo.{\i0}
Dialogue: 0,0:01:49.30,0:01:52.49,Default,,0000,0000,0000,,{\i1}Tôi đã nắm được một vài{\i0}\N{\i1}tin tình báo thú vị về Kuze.{\i0}
Dialogue: 0,0:01:53.03,0:01:56.23,Default,,0000,0000,0000,,{\i1}Trưởng ban và Thiếu tá hiện đang đi vắng.{\i0}\N{\i1}Họ bị Thủ tướng triệu tập gấp.{\i0}
Dialogue: 0,0:01:56.64,0:01:58.60,Default,,0000,0000,0000,,{\i1}Họ bảo tôi ở đây nghe{\i0}\N{\i1}báo cáo của cậu.{\i0}
Dialogue: 0,0:01:58.67,0:02:00.90,Default,,0000,0000,0000,,{\i1}Còn chuyện gì quan trọng hơn{\i0}\N{\i1}việc này được nữa chứ?{\i0}
Dialogue: 0,0:02:02.27,0:02:05.44,Default,,0000,0000,0000,,{\i1}Thực tình mà nói, chúng ta đang đối mặt với{\i0}\N{\i1}nguy cơ bùng nổ một cuộc nổi dậy tị nạn toàn diện.{\i0}
Dialogue: 0,0:02:06.08,0:02:08.34,Default,,0000,0000,0000,,{\i1}Tin xấu đấy.{\i0}
Dialogue: 0,0:02:16.29,0:02:19.22,Default,,0000,0000,0000,,Kể từ sau vụ tự sát chấn động của nhóm Thập nhất Cá nhân,\Ntôi liên tục nhận được báo cáo...
Dialogue: 0,0:02:19.22,0:02:23.52,Default,,0000,0000,0000,,...về việc người tị nạn từ các khu định cư trên cả nước\Nđang bắt đầu lũ lượt đổ về Dejima...
Dialogue: 0,0:02:23.60,0:02:28.23,Default,,0000,0000,0000,,...thuộc Nagasaki, nhằm đối phó với làn sóng\Nbiểu tình chống tị nạn đang dâng cao.
Dialogue: 0,0:02:28.47,0:02:31.49,Default,,0000,0000,0000,,Truyền thông đại chúng thì cứ hấp tấp\Nthổi bùng ngọn lửa dư luận,
Dialogue: 0,0:02:31.57,0:02:33.97,Default,,0000,0000,0000,,...rêu rao rằng đây là khúc dạo đầu\Ncho một cuộc tổng khởi nghĩa.
Dialogue: 0,0:02:34.27,0:02:36.21,Default,,0000,0000,0000,,Các vị có ý kiến gì\Nvề vấn đề này không?
Dialogue: 0,0:02:36.48,0:02:42.51,Default,,0000,0000,0000,,Tôi thừa nhận là đã nhận được báo cáo cho thấy\Ntỷ lệ bắt giữ người trốn trại đang tăng lên,
Dialogue: 0,0:02:42.82,0:02:45.98,Default,,0000,0000,0000,,nhưng nếu quy kết việc đó với một cuộc nổi dậy\Nthì e là còn quá sớm.
Dialogue: 0,0:02:46.19,0:02:48.95,Default,,0000,0000,0000,,Mọi dòng người tị nạn tràn vào Nagasaki\Nsẽ bị ngăn chặn bởi rào cản đường thủy.
Dialogue: 0,0:02:49.46,0:02:51.98,Default,,0000,0000,0000,,Nói như vậy chứng tỏ các ông\Nchưa nắm rõ thực tế tình hình rồi.
Dialogue: 0,0:02:52.62,0:02:56.36,Default,,0000,0000,0000,,Chỉ tính riêng trong tháng này, lực lượng Cảnh sát Biển\Nchúng tôi đã chặn đứng...
Dialogue: 0,0:02:56.56,0:03:00.46,Default,,0000,0000,0000,,...hai tàu khả nghi, cùng 16 thuyền nhỏ\Nđang tìm cách cập bến Dejima.
Dialogue: 0,0:03:00.73,0:03:04.26,Default,,0000,0000,0000,,Rõ như ban ngày là một làn sóng tị nạn\Nđang âm thầm đổ dồn về Nagasaki.
Dialogue: 0,0:03:04.40,0:03:10.36,Default,,0000,0000,0000,,Tôi hiểu rồi. Tuy nhiên, phía cảnh sát còn nhiều\Nviệc hệ trọng khác cần phải giải quyết.
Dialogue: 0,0:03:10.64,0:03:12.20,Default,,0000,0000,0000,,Ý ông là những kẻ theo\Nchủ nghĩa cá nhân sao?
Dialogue: 0,0:03:12.54,0:03:15.41,Default,,0000,0000,0000,,Nếu vậy, tôi rất muốn biết bấy lâu nay\NCục An ninh Công cộng rốt cuộc đã làm được gì?
Dialogue: 0,0:03:15.81,0:03:20.18,Default,,0000,0000,0000,,Việc để mặc cho những kẻ kích động nhởn nhơ ngoài vòng pháp luật\Nchính là nguyên nhân lớn dẫn đến cục diện hôm nay.
Dialogue: 0,0:03:20.85,0:03:24.29,Default,,0000,0000,0000,,Còn về những kẻ thuộc Thập nhất Cá nhân\Nđã tự sát tập thể,
Dialogue: 0,0:03:24.36,0:03:28.45,Default,,0000,0000,0000,,bắt Cục An ninh Công cộng phải nắm trước vị trí của chúng\Nlà một đòi hỏi hoàn toàn phi lý.
Dialogue: 0,0:03:28.93,0:03:33.26,Default,,0000,0000,0000,,Mặc dù hầu hết những kẻ theo chủ nghĩa cá nhân\Nđều hết lời tán dương hành động đó,
Dialogue: 0,0:03:33.47,0:03:37.99,Default,,0000,0000,0000,,nhưng đa phần đều cho rằng nhóm Thập nhất Cá nhân\Nlà một đẳng cấp hoàn toàn khác biệt.
Dialogue: 0,0:03:38.50,0:03:44.14,Default,,0000,0000,0000,,Dù sao đi nữa, theo quan điểm của tôi thì Cơ quan Phòng vệ\Nphải chịu trách nhiệm về vấn đề tị nạn này.
Dialogue: 0,0:03:44.71,0:03:48.27,Default,,0000,0000,0000,,Chính các ông quá nóng lòng tăng cường vũ trang\Nđến mức tổ chức tập trận bắn đạn thật...
Dialogue: 0,0:03:48.35,0:03:52.04,Default,,0000,0000,0000,,...ngay trước mũi người tị nạn,\Nchẳng khác nào chọc thẳng vào tổ ong vò vẽ.
Dialogue: 0,0:03:52.12,0:03:55.88,Default,,0000,0000,0000,,Nếu các ông muốn tranh cãi xem \"con gà hay quả trứng\Ncó trước\" thì tôi cũng sẵn lòng tiếp thôi.
Dialogue: 0,0:03:55.95,0:03:58.58,Default,,0000,0000,0000,,Nhưng theo tôi thấy, chính các vị bên\NBộ phận An ninh...
Dialogue: 0,0:03:58.66,0:04:01.46,Default,,0000,0000,0000,,...mới là những kẻ vẫn đang tranh giành quyền hạn\Nngay cả vào lúc dầu sôi lửa bỏng này đấy.
Dialogue: 0,0:04:01.99,0:04:05.59,Default,,0000,0000,0000,,Nếu đã lôi chuyện đó ra, tại sao Lực lượng Phòng vệ Biển\Nlại làm ngơ nhắm mắt làm ngơ?
Dialogue: 0,0:04:05.96,0:04:07.96,Default,,0000,0000,0000,,Trước khi các vị bàn tới vấn đề thẩm quyền này nọ,
Dialogue: 0,0:04:08.03,0:04:11.37,Default,,0000,0000,0000,,chúng tôi sẽ rất biết ơn nếu nhận được thêm sự hợp tác,\Nbởi chính chúng tôi mới là những người đang liều mạng ngoài kia!
Dialogue: 0,0:04:11.80,0:04:14.36,Default,,0000,0000,0000,,Theo như tôi hiểu, một khi sự việc đã đi đến nước này,
Dialogue: 0,0:04:14.44,0:04:17.71,Default,,0000,0000,0000,,thì quyền tài phán đối với vấn đề tị nạn\Nđã được bàn giao cho người của tôi rồi.
Dialogue: 0,0:04:17.88,0:04:19.07,Default,,0000,0000,0000,,Sao ông dám nói ra những lời như thế chứ?
Dialogue: 0,0:04:19.14,0:04:22.11,Default,,0000,0000,0000,,Có cần tôi phải nhắc cho ông nhớ lại những cuộc tranh chấp\Nxung quanh Hiệp ước An ninh vào thế kỷ trước không?
Dialogue: 0,0:04:22.55,0:04:25.31,Default,,0000,0000,0000,,Không có ý bất kính với vị đồng nghiệp vận động hành lang quốc phòng\Nvừa mới nhảy vào cuộc quá muộn màng này,
Dialogue: 0,0:04:25.52,0:04:29.75,Default,,0000,0000,0000,,nhưng lực lượng cảnh sát vẫn sẽ là bên duy trì trật tự công cộng\Ncủa quốc gia trong sự vụ lần này.
Dialogue: 0,0:04:30.76,0:04:32.66,Default,,0000,0000,0000,,Tranh luận về những vấn đề này là cần thiết,
Dialogue: 0,0:04:32.72,0:04:36.09,Default,,0000,0000,0000,,nhưng điều chúng ta cần lúc này là sự đồng thuận\Ngiữa các cơ quan bộ ngành chính phủ.
Dialogue: 0,0:04:36.66,0:04:38.43,Default,,0000,0000,0000,,Tạm thời hãy hoãn lại cuộc họp\Nvà giải lao đôi chút.
Dialogue: 0,0:04:55.65,0:04:58.67,Default,,0000,0000,0000,,Tôi thấy ngài thậm chí chẳng có lấy một phút\Nđể tĩnh tâm cho nhẹ đầu.
Dialogue: 0,0:04:58.78,0:05:01.08,Default,,0000,0000,0000,,Một phần nguyên nhân là do tôi thiếu thực quyền,
Dialogue: 0,0:05:01.22,0:05:04.92,Default,,0000,0000,0000,,nhưng ai nấy cũng chỉ chăm chăm vào quyền lợi cục bộ\Nmà đánh mất tầm nhìn vào vấn đề cốt lõi trước mắt.
Dialogue: 0,0:05:05.52,0:05:10.15,Default,,0000,0000,0000,,Vấn đề tị nạn đòi hỏi sự chung tay của tất cả bọn họ,\Nấy vậy mà...
Dialogue: 0,0:05:10.93,0:05:14.19,Default,,0000,0000,0000,,Thưa Thủ tướng, ngài có biết lý do hàng đầu...
Dialogue: 0,0:05:14.27,0:05:17.96,Default,,0000,0000,0000,,...khiến quân đội và các cơ quan phòng vệ của bất kỳ quốc gia nào\Nbị suy yếu đi không?
Dialogue: 0,0:05:18.94,0:05:22.10,Default,,0000,0000,0000,,Chính là vì điều mà ngài\Nvừa nhắc tới đấy.
Dialogue: 0,0:05:22.24,0:05:25.77,Default,,0000,0000,0000,,Khoảnh khắc những kẻ đứng đầu một tổ chức...
Dialogue: 0,0:05:25.84,0:05:29.01,Default,,0000,0000,0000,,...bắt đầu biến nó thành công cụ để mưu cầu tư lợi,
Dialogue: 0,0:05:29.11,0:05:31.08,Default,,0000,0000,0000,,thì tổ chức đó sẽ bắt đầu\Nchết dần chết mòn.
Dialogue: 0,0:05:31.72,0:05:37.42,Default,,0000,0000,0000,,Dù vậy, tôi {\i1}thực sự{\i0} áy náy khi đã đẩy\Nlực lượng Cảnh sát Biển vào thế chịu nhiều thiệt thòi...
Dialogue: 0,0:05:37.92,0:05:42.83,Default,,0000,0000,0000,,À, cũng chẳng có gì bảo đảm rằng Đội của tôi\Nsẽ không gặp phải vận rủi tương tự.
Dialogue: 0,0:05:42.90,0:05:44.16,Default,,0000,0000,0000,,Có lẽ là vậy...
Dialogue: 0,0:05:45.26,0:05:48.56,Default,,0000,0000,0000,,Nhân tiện, bên các vị đã thu thập được...
Dialogue: 0,0:05:48.63,0:05:51.33,Default,,0000,0000,0000,,...thông tin cụ thể nào liên quan đến\Nhành tung của người tị nạn chưa?
Dialogue: 0,0:05:51.60,0:05:55.66,Default,,0000,0000,0000,,Thưa Thủ tướng, có rồi. Ngài có biết\Nnão điện tử trung tâm là gì không?
Dialogue: 0,0:05:57.08,0:05:58.06,Default,,0000,0000,0000,,E là tôi chưa nghe qua.
Dialogue: 0,0:05:58.41,0:06:00.28,Default,,0000,0000,0000,,Thiếu tá,\Ncô hãy giải thích đi.
Dialogue: 0,0:06:03.48,0:06:06.01,Default,,0000,0000,0000,,Thưa Thủ tướng, ngài có phiền không\Nnếu tôi kết nối trực tiếp với ngài?
Dialogue: 0,0:06:06.69,0:06:07.67,Default,,0000,0000,0000,,Không sao, cô cứ làm đi.
Dialogue: 0,0:06:17.43,0:06:22.33,Default,,0000,0000,0000,,{\i1}Ban đầu, khái niệm về một nút trung tâm hay lõi điều phối{\i0}\N{\i1}vốn không hề tồn tại trên mạng lưới.{\i0}
Dialogue: 0,0:06:22.97,0:06:26.30,Default,,0000,0000,0000,,{\i1}Nhưng dạo gần đây, chúng tôi nhận thấy{\i0}\N{\i1}xuất hiện một hiện tượng khi một máy chủ...{\i0}
Dialogue: 0,0:06:26.37,0:06:31.00,Default,,0000,0000,0000,,{\i1}...khiến các ý thức biệt lập trên không gian mạng{\i0}\N{\i1}đồng loạt chuyển động theo một hướng duy nhất,{\i0}
Dialogue: 0,0:06:31.28,0:06:34.91,Default,,0000,0000,0000,,{\i1}và tạo ra một dạng thực thể tập hợp{\i0}\N{\i1}bằng cách mời gọi họ thâm nhập vào chính não điện tử của hắn.{\i0}
Dialogue: 0,0:06:35.68,0:06:39.48,Default,,0000,0000,0000,,{\i1}Cho đến nay, quy mô của nó chỉ giới hạn ở mức các cộng đồng nhỏ...{\i0}
Dialogue: 0,0:06:39.55,0:06:43.35,Default,,0000,0000,0000,,{\i1}...tập trung xoay quanh các giáo phái hẹp{\i0}\N{\i1}hoặc những nghệ sĩ có sức hút quần chúng.{\i0}
Dialogue: 0,0:06:43.42,0:06:46.26,Default,,0000,0000,0000,,{\i1}Thế nhưng giờ đây, trong cộng đồng người tị nạn{\i0}\N{\i1}đã xuất hiện một kẻ...{\i0}
Dialogue: 0,0:06:46.33,0:06:49.69,Default,,0000,0000,0000,,{\i1}...sở hữu năng lực thuyết phục và thu phục họ,{\i0}\N{\i1}khiến họ cam tâm lưu lại trong não điện tử của mình.{\i0}
Dialogue: 0,0:06:50.23,0:06:53.03,Default,,0000,0000,0000,,{\i1}Tôi tin rằng đây chính là căn nguyên thúc đẩy{\i0}\N{\i1}làn sóng người tị nạn lũ lượt kéo về Nagasaki.{\i0}
Dialogue: 0,0:06:53.33,0:06:57.00,Default,,0000,0000,0000,,{\i1}Đó chỉ là một cá nhân đơn lẻ thôi sao?{\i0}\N{\i1}Một kẻ mà chúng ta có thể coi là thủ lĩnh của họ ư?{\i0}
Dialogue: 0,0:06:57.40,0:07:00.06,Default,,0000,0000,0000,,{\i1}Xét về mặt thực tế, rất khó để tin rằng{\i0}\N{\i1}đây chỉ là một cá nhân duy nhất.{\i0}
Dialogue: 0,0:07:00.64,0:07:04.58,Default,,0000,0000,0000,,{\i1}Dù chưa thể khẳng định tuyệt đối, nhưng tôi không nghĩ rằng{\i0}\N{\i1}não điện tử của một người lại có đủ dung lượng...{\i0}
Dialogue: 0,0:07:04.78,0:07:08.04,Default,,0000,0000,0000,,{\i1}...để thu phục ý thức của ba triệu con người{\i0}\N{\i1}cùng một lúc.{\i0}
Dialogue: 0,0:07:08.75,0:07:11.44,Default,,0000,0000,0000,,{\i1}Thế nhưng, nếu được hỏi liệu cái nút trung tâm này{\i0}\N{\i1}có đóng vai trò như thủ lĩnh của họ hay không,{\i0}
Dialogue: 0,0:07:11.52,0:07:13.51,Default,,0000,0000,0000,,{\i1}thì tôi buộc phải trả lời rằng{\i0}\N{\i1}đúng là như vậy.{\i0}
Dialogue: 0,0:07:14.35,0:07:15.58,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:07:19.69,0:07:24.06,Default,,0000,0000,0000,,Sự xuất hiện của một kẻ như vậy chính là\Nmối đe dọa hàng đầu mà chính phủ đang phải đối mặt.
Dialogue: 0,0:07:24.86,0:07:26.63,Default,,0000,0000,0000,,Các vị hãy tiếp tục\Nđề cao cảnh giác.
Dialogue: 0,0:07:27.10,0:07:28.19,Default,,0000,0000,0000,,Rõ thưa ngài.
Dialogue: 0,0:07:28.73,0:07:32.23,Default,,0000,0000,0000,,Khi tôi bãi bỏ Chính sách Đặc biệt về Người tị nạn,
Dialogue: 0,0:07:32.54,0:07:35.13,Default,,0000,0000,0000,,ý định ban đầu của tôi là hạn chế nạn trục lợi\Nnhắm vào người tị nạn...
Dialogue: 0,0:07:35.21,0:07:37.68,Default,,0000,0000,0000,,...và giải quyết vấn đề tận gốc rễ,\Nbắt đầu từ chuyện thuế khóa.
Dialogue: 0,0:07:38.08,0:07:41.64,Default,,0000,0000,0000,,Điều đó có nghĩa là đã có đối thủ chính trị\Nlợi dụng nó để phục vụ mưu đồ riêng.
Dialogue: 0,0:07:41.85,0:07:43.78,Default,,0000,0000,0000,,Xin ngài đừng quá bận lòng về chuyện đó.
Dialogue: 0,0:07:46.65,0:07:50.61,Default,,0000,0000,0000,,Thực ra... Còn một việc khác\Nmà tôi muốn nhờ các vị điều tra giúp.
Dialogue: 0,0:07:51.42,0:07:52.58,Default,,0000,0000,0000,,Đó là việc gì vậy thưa ngài?
Dialogue: 0,0:07:53.26,0:07:56.92,Default,,0000,0000,0000,,Dường như có một nghị sĩ vận động hành lang quốc phòng\Nđang câu kết mờ ám với...
Dialogue: 0,0:07:57.00,0:08:00.56,Default,,0000,0000,0000,,...Viện Nghiên cứu Kỹ thuật Đại Nhật Bản trước đây\Nxung quanh vấn đề Hiệp ước An ninh Nhật - Mỹ.
Dialogue: 0,0:08:02.40,0:08:07.74,Default,,0000,0000,0000,,Đất nước chúng ta nắm giữ công nghệ máy lọc phóng xạ\Nduy nhất trên thế giới,
Dialogue: 0,0:08:08.07,0:08:11.44,Default,,0000,0000,0000,,trong khi Đế chế Hoa Kỳ trước giờ luôn dựa dẫm\Nvào sức răn đe hạt nhân.
Dialogue: 0,0:08:11.54,0:08:13.57,Default,,0000,0000,0000,,Tôi tin rằng Hiệp ước An ninh mới này sẽ mang lại hiệu quả...
Dialogue: 0,0:08:13.65,0:08:15.74,Default,,0000,0000,0000,,...đặt chúng ta vào vị thế ngang hàng,\Nnếu không muốn nói là vượt trội hơn họ.
Dialogue: 0,0:08:16.05,0:08:20.75,Default,,0000,0000,0000,,Nếu điều này chứng minh là bất khả thi, tôi sẵn sàng\Nhoãn việc ký kết Hiệp ước An ninh mới lại.
Dialogue: 0,0:08:21.52,0:08:24.42,Default,,0000,0000,0000,,Tuy nhiên, có một số nghị sĩ và tập đoàn công nghiệp...
Dialogue: 0,0:08:24.59,0:08:26.72,Default,,0000,0000,0000,,...chẳng mảy may bận tâm đến lý tưởng đó.
Dialogue: 0,0:08:27.09,0:08:31.19,Default,,0000,0000,0000,,Với những gì họ đang làm, đất nước này\Nsẽ chẳng bao giờ có được nền độc lập thực sự.
Dialogue: 0,0:08:32.23,0:08:33.96,Default,,0000,0000,0000,,Ngài lấy thông tin này\Ntừ đâu vậy thưa ngài?
Dialogue: 0,0:08:34.63,0:08:36.57,Default,,0000,0000,0000,,Từ một nguồn tin nội bộ bên trong Bộ Ngoại giao.
Dialogue: 0,0:08:36.77,0:08:40.20,Default,,0000,0000,0000,,Nếu vậy, chúng tôi sẽ lập tức bắt tay vào việc\Nbằng cách lần theo dòng tiền.
Dialogue: 0,0:08:40.91,0:08:45.74,Default,,0000,0000,0000,,Tuy nhiên, xin mạn phép hỏi thẳng một câu, liệu tôi nên coi\Nnhững mệnh lệnh này được đưa ra...
Dialogue: 0,0:08:46.24,0:08:49.65,Default,,0000,0000,0000,,...là xuất phát từ tư lợi cá nhân của ngài,\Nhay từ lý tưởng chính trị?
Dialogue: 0,0:08:51.02,0:08:52.85,Default,,0000,0000,0000,,Đáng lẽ ông không cần\Nphải hỏi câu đó đâu.
Dialogue: 0,0:08:54.22,0:08:55.65,Default,,0000,0000,0000,,Tuân lệnh, thưa Thủ tướng.
Dialogue: 0,0:09:11.84,0:09:14.17,Default,,0000,0000,0000,,Lẽ ra tôi phải nhận ra\Nđiều này sớm hơn.
Dialogue: 0,0:09:15.37,0:09:19.17,Default,,0000,0000,0000,,Thủ tướng Kayabuki đúng là mẫu phụ nữ\Nđúng gu của ngài đấy, Trưởng ban.
Dialogue: 0,0:09:19.28,0:09:21.80,Default,,0000,0000,0000,,Sao, đến tận bây giờ\Ncô mới nhận ra điều đó à?
Dialogue: 0,0:09:23.65,0:09:25.62,Default,,0000,0000,0000,,Tôi chịu thua ngài rồi đấy, Trưởng ban.
Dialogue: 0,0:09:28.59,0:09:31.02,Default,,0000,0000,0000,,Ngài có nghĩ \"vị nghị sĩ vận động hành lang quốc phòng\"\Nmà bà ấy nhắc tới...
Dialogue: 0,0:09:31.09,0:09:33.06,Default,,0000,0000,0000,,...chính là Chánh văn phòng Nội các Takakura không?
Dialogue: 0,0:09:33.46,0:09:34.72,Default,,0000,0000,0000,,Chắc chắn là hắn rồi.
Dialogue: 0,0:09:36.09,0:09:40.22,Default,,0000,0000,0000,,Tôi không nghĩ mục tiêu của hắn trong vụ này\Nchỉ đơn thuần là kiếm vài đồng hối lộ.
Dialogue: 0,0:09:40.93,0:09:44.10,Default,,0000,0000,0000,,Takakura vốn là một kẻ tân bảo thủ thân Mỹ,\Nphải vậy không?
Dialogue: 0,0:09:45.87,0:09:48.17,Default,,0000,0000,0000,,Hắn là một thành viên kỳ cựu của tổ hợp quân sự - công nghiệp...
Dialogue: 0,0:09:48.24,0:09:50.73,Default,,0000,0000,0000,,...kẻ cho đến tận bây giờ vẫn chưa dứt bỏ được niềm tin mù quáng\Nvào Đế chế Hoa Kỳ.
Dialogue: 0,0:09:51.18,0:09:57.95,Default,,0000,0000,0000,,Dưới góc nhìn của hắn, chúng ta có thể sử dụng công nghệ lọc phóng xạ\Nvốn đã sụt giá thảm hại sau chiến tranh,
Dialogue: 0,0:09:58.02,0:09:59.92,Default,,0000,0000,0000,,và bằng cách bắt tay với Đế chế Hoa Kỳ thêm một lần nữa,
Dialogue: 0,0:09:59.99,0:10:04.22,Default,,0000,0000,0000,,chúng ta có thể dùng nó làm lá chắn răn đe mới chống lại các nước khác\Nvà đẩy giá trị của nó lên cao vút.
Dialogue: 0,0:10:04.32,0:10:06.55,Default,,0000,0000,0000,,Bằng cách đó, hắn vừa dọn đường để bỏ túi tiền hoa hồng...
Dialogue: 0,0:10:06.63,0:10:11.65,Default,,0000,0000,0000,,...vừa giữ thể diện cho phe bảo thủ\Nmà chẳng cần phải chạy đua vũ trang tốn kém.
Dialogue: 0,0:10:11.80,0:10:15.20,Default,,0000,0000,0000,,Nghe có vẻ chẳng giống chút nào với chính sách\N\"độc lập và tự chủ hợp tác\"...
Dialogue: 0,0:10:15.27,0:10:17.53,Default,,0000,0000,0000,,...mà Thủ tướng Kayabuki\Nđang dốc sức thúc đẩy nhỉ.
Dialogue: 0,0:10:18.24,0:10:21.47,Default,,0000,0000,0000,,Hắn cũng chính là kẻ cầm đầu tối cao\Ncủa Cục Tình báo Nội các, đúng chứ?
Dialogue: 0,0:10:21.54,0:10:24.17,Default,,0000,0000,0000,,Hơn nữa, hồ sơ lý lịch của Gôda còn có vết tích giám sát sản xuất...
Dialogue: 0,0:10:24.24,0:10:28.01,Default,,0000,0000,0000,,...dự án \"Kỳ tích Nhật Bản\" tại Viện Nghiên cứu Kỹ thuật Đại Nhật Bản trước đây.
Dialogue: 0,0:10:29.41,0:10:32.11,Default,,0000,0000,0000,,Kích động khủng bố tị nạn, rồi lại đến Hiệp ước An ninh Nhật - Mỹ...
Dialogue: 0,0:10:32.18,0:10:33.98,Default,,0000,0000,0000,,Và cả vũ khí hạt nhân nữa...
Dialogue: 0,0:10:35.72,0:10:39.16,Default,,0000,0000,0000,,Có vẻ như việc giúp bà ấy rửa hận\Ncũng rất bõ công đấy chứ?
Dialogue: 0,0:10:58.31,0:11:01.34,Default,,0000,0000,0000,,Chúng tôi đợi ngài đến sốt cả ruột rồi đấy,\NThủ tướng Kayabuki...
Dialogue: 0,0:11:04.82,0:11:06.41,Default,,0000,0000,0000,,Tôi vào ngay đây.
Dialogue: 0,0:11:19.43,0:11:20.42,Default,,0000,0000,0000,,Togusa này.
Dialogue: 0,0:11:21.30,0:11:22.29,Default,,0000,0000,0000,,Gì thế, Azuma?
Dialogue: 0,0:11:22.90,0:11:25.34,Default,,0000,0000,0000,,Tôi biết là bọn mình không được mời tham dự cuộc họp,
Dialogue: 0,0:11:25.74,0:11:27.86,Default,,0000,0000,0000,,nhưng cậu có chắc là chúng ta\Nkhông nên ngồi dự thính không?
Dialogue: 0,0:11:27.97,0:11:30.34,Default,,0000,0000,0000,,Thế còn cuộc điều tra bí mật về Thập nhất Cá nhân\Ncủa các cậu thì sao?
Dialogue: 0,0:11:30.88,0:11:33.21,Default,,0000,0000,0000,,Bên phía bọn chúng ít động tĩnh hơn hẳn so với đám tị nạn,
Dialogue: 0,0:11:33.31,0:11:35.94,Default,,0000,0000,0000,,thành thử, cậu biết đấy, bọn tôi\Ncũng bắt đầu thấy hơi chán rồi.
Dialogue: 0,0:11:36.85,0:11:38.11,Default,,0000,0000,0000,,Cái thằng ngu này!
Dialogue: 0,0:11:38.18,0:11:40.91,Default,,0000,0000,0000,,Chán thì đã làm sao hả?!\NĐó là công việc chết tiệt của cậu đấy!
Dialogue: 0,0:11:40.99,0:11:43.25,Default,,0000,0000,0000,,Tôi thề, hai đứa các cậu còn non và xanh đến phát bực!
Dialogue: 0,0:11:45.56,0:11:49.02,Default,,0000,0000,0000,,Đó là vào khoảng thời gian mà cuộc chiến vô nghĩa...
Dialogue: 0,0:11:49.09,0:11:51.49,Default,,0000,0000,0000,,...tranh giành quyền bá chủ lục địa Á-Âu\Ncuối cùng cũng dần đi đến hồi kết.
Dialogue: 0,0:11:51.90,0:11:54.66,Default,,0000,0000,0000,,Hồi đó tôi có lẻn vào bán đảo\Nvài lần.
Dialogue: 0,0:11:54.73,0:11:56.86,Default,,0000,0000,0000,,Vào thời điểm ấy, vùng đó\Nđã khá là hiện đại hóa rồi.
Dialogue: 0,0:11:57.60,0:11:58.80,Default,,0000,0000,0000,,Các cậu đã bắt đầu\Nbáo cáo rồi à?
Dialogue: 0,0:11:59.07,0:12:02.63,Default,,0000,0000,0000,,Chưa đâu. Bọn tôi mới chỉ khởi động đôi chút\Ntrong lúc chờ Thiếu tá thôi.
Dialogue: 0,0:12:04.18,0:12:05.77,Default,,0000,0000,0000,,Vậy thì, chúng ta\Nbắt đầu chứ nhỉ?
Dialogue: 0,0:12:06.58,0:12:10.17,Default,,0000,0000,0000,,Vô cùng xin lỗi vì đã bắt cậu lao ngay vào việc\Nngay khi vừa mới chân ướt chân ráo trở về.
Dialogue: 0,0:12:11.18,0:12:12.74,Default,,0000,0000,0000,,À, cảm ơn.
Dialogue: 0,0:12:26.67,0:12:31.69,Default,,0000,0000,0000,,Đó là vào năm 2024, các quốc gia trên khắp thế giới\Nđều đã kiệt quệ sau Thế chiến thứ Tư.
Dialogue: 0,0:12:32.24,0:12:35.67,Default,,0000,0000,0000,,Bán đảo Triều Tiên khi ấy vẫn đang chìm trong nội chiến, và khi cuộc thế chiến vừa chấm dứt,
Dialogue: 0,0:12:35.74,0:12:38.11,Default,,0000,0000,0000,,Đế chế Hoa Kỳ đã kêu gọi Liên Hợp Quốc gửi quân vào can thiệp.
Dialogue: 0,0:12:38.18,0:12:41.67,Default,,0000,0000,0000,,Đây chính là động lực trực tiếp dẫn đến việc\NLục quân Phòng vệ được điều động tới đó.
Dialogue: 0,0:12:42.28,0:12:44.61,Default,,0000,0000,0000,,Nhưng thực chất thì Đế chế Hoa Kỳ...
Dialogue: 0,0:12:44.68,0:12:47.85,Default,,0000,0000,0000,,...đang tìm cách gượng dậy và thiết lập lại vị thế cường quốc thống trị toàn cầu.
Dialogue: 0,0:12:47.95,0:12:50.72,Default,,0000,0000,0000,,Họ lợi dụng việc điều quân để ép chính phủ thống nhất phải nhượng lại quyền khai thác...
Dialogue: 0,0:12:51.02,0:12:55.05,Default,,0000,0000,0000,,...các mỏ uranium chôn sâu ở phía bắc bán đảo, đúng không?
Dialogue: 0,0:12:55.26,0:12:59.96,Default,,0000,0000,0000,,Phải, chuyện đó nữa. Nhưng dẫu cho dã tâm của họ\Nrõ ràng mười mươi như ban ngày,
Dialogue: 0,0:13:00.23,0:13:04.93,Default,,0000,0000,0000,,Nhật Bản vẫn không thể từ chối Liên Hợp Quốc, nhất là khi họ đang vớ bẫm từ các hợp đồng cung ứng chiến tranh.
Dialogue: 0,0:13:05.20,0:13:09.07,Default,,0000,0000,0000,,Ngoại trừ trận chiến tái chiếm Nemuro, Lục quân Phòng vệ...
Dialogue: 0,0:13:09.14,0:13:11.73,Default,,0000,0000,0000,,...đã xoay xở né tránh được mọi cuộc giao tranh qua suốt hai cuộc thế chiến,
Dialogue: 0,0:13:12.08,0:13:14.34,Default,,0000,0000,0000,,...nên đây chính là phép thử đầu tiên dưới làn mưa bom bão đạn của họ.
Dialogue: 0,0:13:16.21,0:13:18.77,Default,,0000,0000,0000,,Nhưng hồi đó sếp già và Thiếu tá\Nđều hoạt động ở nước ngoài...
Dialogue: 0,0:13:18.88,0:13:21.11,Default,,0000,0000,0000,,...dưới danh nghĩa phi chính thức suốt cuộc chiến, đúng không?
Dialogue: 0,0:13:21.55,0:13:22.65,Default,,0000,0000,0000,,Đại loại là thế.
Dialogue: 0,0:13:23.12,0:13:26.06,Default,,0000,0000,0000,,Phi chính thức, là bởi ngài Thủ tướng bị đánh bom khủng bố thiệt mạng năm đó...
Dialogue: 0,0:13:26.12,0:13:29.82,Default,,0000,0000,0000,,...là một trong số ít chính khách có tầm nhìn quốc tế thực sự.
Dialogue: 0,0:13:30.10,0:13:32.03,Default,,0000,0000,0000,,Dù sao thì, bởi vì tất cả những toan tính ngầm sau cánh gà ấy,
Dialogue: 0,0:13:32.10,0:13:36.69,Default,,0000,0000,0000,,chính phủ đã áp đặt lệnh kiểm duyệt báo chí gắt gao nhằm định hướng dư luận trong nước.
Dialogue: 0,0:13:37.07,0:13:40.33,Default,,0000,0000,0000,,Và địa điểm được lựa chọn để triển khai lực lượng gìn giữ hòa bình PKF chính là Sinuiju,
Dialogue: 0,0:13:40.41,0:13:42.31,Default,,0000,0000,0000,,nơi được đánh giá là\Ntương đối an toàn.
Dialogue: 0,0:13:42.61,0:13:45.13,Default,,0000,0000,0000,,Tôi vẫn còn nhớ đợt dư luận dậy sóng\Nvề vụ điều quân đó.
Dialogue: 0,0:13:45.74,0:13:50.34,Default,,0000,0000,0000,,Nhưng tôi đồ rằng mọi người cuối cùng cũng mất dần hứng thú\Nkhi toàn bộ những gì bản tin thời sự chiếu...
Dialogue: 0,0:13:50.82,0:13:53.48,Default,,0000,0000,0000,,...chỉ là cảnh những người lính Phòng vệ trông có vẻ buồn chán\Nđang giao lưu cùng người dân địa phương.
Dialogue: 0,0:13:53.72,0:13:57.52,Default,,0000,0000,0000,,Chẳng có gì lạ. Tuy nhiên, sự thật diễn ra nơi chiến trường\Nlại là một câu chuyện hoàn toàn khác.
Dialogue: 0,0:13:58.32,0:14:02.23,Default,,0000,0000,0000,,Và những kẻ giật dây kiểm duyệt truyền thông\Ntừ trong bóng tối...
Dialogue: 0,0:14:02.33,0:14:06.59,Default,,0000,0000,0000,,chính là tiền thân của Cục Tình báo CIS ngày nay,\NCục Báo chí Nội các.
Dialogue: 0,0:14:06.83,0:14:09.93,Default,,0000,0000,0000,,Vậy rốt cuộc, \"bộ mặt thật của tình hình\"\Nbên phía PKF là gì?
Dialogue: 0,0:14:10.04,0:14:14.34,Default,,0000,0000,0000,,Chuyện là... Xem ra thực tế ở đó\Nbi thảm hơn nhiều so với những gì chúng ta từng nghe.
Dialogue: 0,0:14:16.07,0:14:19.34,Default,,0000,0000,0000,,Đơn vị mà Kuze trực thuộc\Nlà một đơn vị cơ giới hóa...
Dialogue: 0,0:14:19.61,0:14:22.31,Default,,0000,0000,0000,,...thuộc tốp lực lượng chủ lực cuối cùng được điều động tới mảnh đất này.
Dialogue: 0,0:14:22.71,0:14:27.21,Default,,0000,0000,0000,,Vào thời điểm đó, Sinuiju vừa là đặc khu hành chính\Nvừa là trung tâm giao thương,
Dialogue: 0,0:14:27.65,0:14:30.09,Default,,0000,0000,0000,,nên nó nằm ngoài danh sách mục tiêu bắn phá\Ncủa tất cả các bên.
Dialogue: 0,0:14:30.29,0:14:33.12,Default,,0000,0000,0000,,Thế nhưng tàn quân tháo chạy của Quân đội Nhân dân...
Dialogue: 0,0:14:33.19,0:14:35.96,Default,,0000,0000,0000,,...đã chọn nơi tử thủ cuối cùng sau khi chính phủ thống nhất được thành lập...
Dialogue: 0,0:14:36.06,0:14:39.66,Default,,0000,0000,0000,,...chính là một vùng nông thôn cách thành phố khoảng 20 cây số về phía đông.
Dialogue: 0,0:14:40.03,0:14:42.40,Default,,0000,0000,0000,,Một khi vượt qua biên giới ở đó,\Nnơi ấy là vùng đồi núi, đúng không?
Dialogue: 0,0:14:42.77,0:14:45.57,Default,,0000,0000,0000,,Đúng hơn thì là một con đèo hiểm trở.
Dialogue: 0,0:14:45.77,0:14:47.64,Default,,0000,0000,0000,,Độ cao ở đó tối đa\Nchỉ chừng 800 mét.
Dialogue: 0,0:14:47.97,0:14:51.91,Default,,0000,0000,0000,,Thế nên đó là địa bàn hoàn hảo\Ncho chiến tranh du kích.
Dialogue: 0,0:14:52.98,0:14:57.71,Default,,0000,0000,0000,,Đại đội bộ binh cyborg được chia làm hai cánh quân\Nvới vai trò là đơn vị tiễu phỉ du kích,
Dialogue: 0,0:14:57.78,0:15:02.31,Default,,0000,0000,0000,,và gần như ngay khi vừa đặt chân tới nơi, họ đã lập tức tiến sâu vào rặng núi giữa mùa đông giá rét cắt da cắt thịt.
Dialogue: 0,0:15:02.95,0:15:06.22,Default,,0000,0000,0000,,Dẫu cho đây là lần đầu tiên họ được triển khai tác chiến quy mô lớn nơi tiền tuyến,
Dialogue: 0,0:15:06.42,0:15:11.36,Default,,0000,0000,0000,,nhưng những cỗ cơ thể cơ khí hóa bán phần PKF\Ncó lẽ chẳng hề gặp mấy áp lực,
Dialogue: 0,0:15:11.56,0:15:14.56,Default,,0000,0000,0000,,ngay cả khi hành quân qua lớp tuyết dày\Ndưới nhiệt độ âm bốn độ C.
Dialogue: 0,0:15:16.13,0:15:20.66,Default,,0000,0000,0000,,Vào lúc đó, lực lượng chủ lực đang trong trạng thái báo động cao độ sau khi nhận được tin tình báo...
Dialogue: 0,0:15:20.74,0:15:25.23,Default,,0000,0000,0000,,...rằng lực lượng tinh nhuệ cuối cùng của Quân đội Nhân dân đang lên kế hoạch đột kích Sinuiju.
Dialogue: 0,0:15:25.91,0:15:28.47,Default,,0000,0000,0000,,Kế hoạch đặt ra là đại đội của Kuze...
Dialogue: 0,0:15:28.55,0:15:31.71,Default,,0000,0000,0000,,...sẽ vu hồi bọc hậu từ phía bắc và tung đòn tấn công phủ đầu.
Dialogue: 0,0:15:31.98,0:15:34.88,Default,,0000,0000,0000,,Thế nhưng trung đội của Kuze, vốn đi tiên phong mở đường,
Dialogue: 0,0:15:35.29,0:15:40.66,Default,,0000,0000,0000,,đã phát hiện ra một trại tị nạn không hề có trong bản đồ tình báo\Nnằm sát bên bờ con sông chảy dọc biên giới.
Dialogue: 0,0:15:41.89,0:15:47.13,Default,,0000,0000,0000,,Một cuộc đột kích tàn bạo đang diễn ra\Ndo chính những binh lính của Quân đội Nhân dân tiến hành.
Dialogue: 0,0:15:47.53,0:15:51.53,Default,,0000,0000,0000,,Những kẻ mang danh người lính ấy\Ngiờ đây đã thoái hóa thành lũ thảo khấu vùng biên.
Dialogue: 0,0:15:55.84,0:16:00.50,Default,,0000,0000,0000,,Chứng kiến cảnh tượng dã man ấy, Kuze cùng trung đội của anh ta\Nđã sục sôi phẫn nộ và lập tức lao vào hành động.
Dialogue: 0,0:16:01.45,0:16:04.18,Default,,0000,0000,0000,,Đó là một trận chiến tương quan\Ngiữa 120 người chọi lại 30 người,
Dialogue: 0,0:16:07.75,0:16:10.12,Default,,0000,0000,0000,,...nhưng mọi thứ đã ngã ngũ\Nchỉ trong chớp mắt.
Dialogue: 0,0:16:10.72,0:16:14.18,Default,,0000,0000,0000,,Bởi lẽ trung đội của Kuze là một đơn vị cyborg tinh nhuệ,
Dialogue: 0,0:16:14.49,0:16:18.12,Default,,0000,0000,0000,,còn những kẻ đang tấn công khu trại, dẫu từng là quân nhân,
Dialogue: 0,0:16:18.20,0:16:22.86,Default,,0000,0000,0000,,nhưng đa phần đều là cơ thể bằng xương bằng thịt,\Nvà từng tên một đều đã bị bỏ đói đến dở sống dở chết.
Dialogue: 0,0:16:32.84,0:16:36.91,Default,,0000,0000,0000,,Dù sau đó họ vẫn nhận được một vài báo cáo\Nvề tàn dư của Quân đội Nhân dân,
Dialogue: 0,0:16:37.15,0:16:39.58,Default,,0000,0000,0000,,nhưng sự vụ lần đó là trận giao tranh duy nhất\Nmà họ phải nổ súng.
Dialogue: 0,0:16:39.78,0:16:42.72,Default,,0000,0000,0000,,Mặc dù phải chịu áp lực từ cái lạnh khắc nghiệt...
Dialogue: 0,0:16:42.79,0:16:45.85,Default,,0000,0000,0000,,...và nỗi bất an không biết du kích sẽ đánh úp lúc nào,
Dialogue: 0,0:16:46.12,0:16:51.08,Default,,0000,0000,0000,,nhưng các lực lượng chủ lực đóng quân trong nội đô\Nthì chẳng phải nếm trải chút gian nan nào.
Dialogue: 0,0:16:51.50,0:16:53.19,Default,,0000,0000,0000,,Tôi nhớ là mình\Ntừng thấy thước phim này.
Dialogue: 0,0:16:53.40,0:16:59.39,Default,,0000,0000,0000,,Phải. Nhưng chẳng bao lâu sau, rắc rối đã nảy sinh\Nngay trong khu doanh trại đóng ngoài nông thôn.
Dialogue: 0,0:16:59.77,0:17:01.03,Default,,0000,0000,0000,,Hội chứng PTSD à?
Dialogue: 0,0:17:01.11,0:17:05.10,Default,,0000,0000,0000,,Chuẩn xác rồi đấy.\NRối loạn căng thẳng sau sang chấn.
Dialogue: 0,0:17:05.48,0:17:09.81,Default,,0000,0000,0000,,Trải nghiệm lần đầu tiên bước vào chiến trận, mà lại là một cuộc tàn sát một chiều đẫm máu,
Dialogue: 0,0:17:10.28,0:17:13.74,Default,,0000,0000,0000,,đã dần dần gặm nhấm và hủy hoại tâm can\Ncủa những người lính trẻ tuổi.
Dialogue: 0,0:17:14.45,0:17:17.05,Default,,0000,0000,0000,,Những kẻ vẫn còn giữ lại lá phổi nguyên bản\Ncùng các cơ quan nội tạng bằng xương thịt...
Dialogue: 0,0:17:17.16,0:17:20.72,Default,,0000,0000,0000,,...đã điên cuồng tìm cách trốn chạy khỏi những hồi tưởng kinh hoàng và ác mộng về vụ thảm sát...
Dialogue: 0,0:17:21.16,0:17:26.15,Default,,0000,0000,0000,,...bằng cách lao vào men rượu tổng hợp và cần sa\Ndo chính những người tị nạn mang tới cho họ.
Dialogue: 0,0:17:28.27,0:17:33.67,Default,,0000,0000,0000,,Trước thời điểm đó, Lục quân Phòng vệ\Nvốn nổi tiếng là một đội quân vô cùng kỷ luật.
Dialogue: 0,0:17:34.14,0:17:37.40,Default,,0000,0000,0000,,Khi kỷ cương bắt đầu rạn nứt vỡ vụn, giới truyền thông tại Nhật Bản\Nđã lập tức chĩa mũi dùi chỉ trích họ vô cùng gay gắt.
Dialogue: 0,0:17:40.38,0:17:43.07,Default,,0000,0000,0000,,Mặc dù sự thật trần trụi về vụ thảm sát tại trại tị nạn...
Dialogue: 0,0:17:43.15,0:17:47.14,Default,,0000,0000,0000,,...chưa từng lọt tới tai giới báo chí\Ndo có lệnh cấm vận thông tin nghiêm ngặt,
Dialogue: 0,0:17:47.59,0:17:50.88,Default,,0000,0000,0000,,nhưng điều này lại càng khiến cho những lời chỉ trích về hành vi đồi trụy của binh lính\Ntrở nên cay nghiệt hơn bao giờ hết.
Dialogue: 0,0:17:51.76,0:17:56.02,Default,,0000,0000,0000,,Hơn thế nữa, quyền tự do của những người lính đã bị tước đoạt bởi lệnh phong tỏa tin tức...
Dialogue: 0,0:17:56.33,0:17:59.39,Default,,0000,0000,0000,,...được dựng lên cốt để che đậy những hành vi nhục nhã của binh sĩ không bị phơi bày trên mặt báo.
Dialogue: 0,0:17:59.46,0:18:02.56,Default,,0000,0000,0000,,Mọi chuyện dần tệ hại đến mức họ thậm chí\Ncòn không được phép bước chân trở về Nhật Bản.
Dialogue: 0,0:18:03.20,0:18:05.00,Default,,0000,0000,0000,,Nghe chẳng khác nào\Nmột khu cách ly bệnh nhân cả...
Dialogue: 0,0:18:05.30,0:18:06.79,Default,,0000,0000,0000,,Ừ, và tệ hại hơn cả là,
Dialogue: 0,0:18:07.34,0:18:11.33,Default,,0000,0000,0000,,tin tức về vụ thảm sát tại khu trại tị nạn gần biên giới\Nđã bị rò rỉ cho một số cơ quan báo chí.
Dialogue: 0,0:18:11.74,0:18:14.37,Default,,0000,0000,0000,,Và những tin đồn thậm chí bắt đầu lan truyền rằng\Nđó có thể...
Dialogue: 0,0:18:14.45,0:18:16.81,Default,,0000,0000,0000,,...là tác phẩm do chính bàn tay\NLục quân Phòng vệ Nhật Bản gây ra.
Dialogue: 0,0:18:17.25,0:18:21.84,Default,,0000,0000,0000,,Người dân tại vùng nông thôn đã ùa tới gây áp lực dữ dội,\Nyêu cầu một lời giải thích thỏa đáng.
Dialogue: 0,0:18:22.19,0:18:26.35,Default,,0000,0000,0000,,Thế nhưng dưới bức màn sắt cấm vận thông tin,\Nnhững người lính trẻ,
Dialogue: 0,0:18:26.76,0:18:30.72,Default,,0000,0000,0000,,và ngay cả các sĩ quan chỉ huy của họ, đều chẳng thể thốt lên nửa lời\Nđể tự biện hộ cho chính mình.
Dialogue: 0,0:18:30.96,0:18:35.19,Default,,0000,0000,0000,,Họ chẳng thể làm gì khác ngoài việc câm nín\Nvà thu mình trốn chặt trong những túp lều bạt.
Dialogue: 0,0:18:36.70,0:18:38.79,Default,,0000,0000,0000,,Một ngày nọ, sau khi tình trạng bế tắc này kéo dài được một thời gian,
Dialogue: 0,0:18:39.10,0:18:42.77,Default,,0000,0000,0000,,một phóng viên địa phương dường như đã nói những lời sau đây\Nvới một trong số những người lính.
Dialogue: 0,0:18:43.31,0:18:49.91,Default,,0000,0000,0000,,Gã phóng viên đó có lẽ cố tình mỉa mai một tên lính\Nđã không còn lá phổi tự nhiên mà cha sinh mẹ đẻ ban cho.
Dialogue: 0,0:18:52.55,0:18:53.71,Default,,0000,0000,0000,,Này.
Dialogue: 0,0:18:54.95,0:18:58.75,Default,,0000,0000,0000,,Anh có biết nguồn gốc của từ\N\"sát thủ\" (assassin) bắt nguồn từ đâu không?
Dialogue: 0,0:18:59.79,0:19:03.25,Default,,0000,0000,0000,,Trong tiếng Ả Rập, nó có nghĩa là\N\"kẻ nghiện cần sa hashish\".
Dialogue: 0,0:19:04.23,0:19:09.22,Default,,0000,0000,0000,,Những sát thủ Hồi giáo tấn công quân Thập tự chinh sau khi tái chiếm Jerusalem vào thế kỷ 11...
Dialogue: 0,0:19:09.70,0:19:13.19,Default,,0000,0000,0000,,...đã hút cần sa và lạnh lùng tiến hành những vụ ám sát đẫm máu\Nnhư thể đang chìm trong một giấc mộng mị.
Dialogue: 0,0:19:15.47,0:19:17.17,Default,,0000,0000,0000,,Người ta kể lại rằng khi quân Thập tự chinh\Nchứng kiến điều đó,
Dialogue: 0,0:19:17.24,0:19:19.90,Default,,0000,0000,0000,,họ đã gọi những kẻ đó là \"assassins\"\Nvà vô cùng khiếp đảm kinh hồn bạt vía.
Dialogue: 0,0:19:20.55,0:19:23.95,Default,,0000,0000,0000,,Có phải các anh cũng bú mớm thứ cỏ rác đó rồi ảo tưởng\Nrằng mảnh đất này chính là Thiên đường không hả?
Dialogue: 0,0:19:24.18,0:19:28.12,Default,,0000,0000,0000,,Các anh xâm lược nơi này, rồi giờ đây lại cứ nhởn nhơ bám víu lấy\Nnhư thể các anh là khách quý tới thăm vậy!
Dialogue: 0,0:19:28.45,0:19:30.15,Default,,0000,0000,0000,,Lũ giết người man rợ...
Dialogue: 0,0:19:33.06,0:19:34.52,Default,,0000,0000,0000,,A-Anh muốn cái gì hả?
Dialogue: 0,0:19:34.96,0:19:36.29,Default,,0000,0000,0000,,Anh nói đúng đấy.
Dialogue: 0,0:19:37.46,0:19:39.95,Default,,0000,0000,0000,,Có lẽ ban đầu chúng tôi quả thực\Nđã tự coi mình là những người khách tới đây.
Dialogue: 0,0:19:48.61,0:19:51.73,Default,,0000,0000,0000,,Đổi cho tôi đi. Khẩu này\Nlấy một chiếc máy ảnh kia.
Dialogue: 0,0:19:55.08,0:19:58.52,Default,,0000,0000,0000,,Nói đoạn, Kuze liền đem khẩu súng của mình\Nđổi lấy một chiếc máy ảnh,
Dialogue: 0,0:19:58.58,0:20:01.21,Default,,0000,0000,0000,,rồi cứ thế một mình dấn bước\Nvào bên trong trại tị nạn.
Dialogue: 0,0:20:03.45,0:20:05.72,Default,,0000,0000,0000,,Sau đó thì sao? Anh ta\Nđã làm gì trong trại tị nạn?
Dialogue: 0,0:20:06.09,0:20:09.49,Default,,0000,0000,0000,,Theo lời kể thì anh ta chẳng làm gì to tát cả.\NTất cả những gì anh ta làm chỉ là đeo chiếc máy ảnh đi loanh quanh...
Dialogue: 0,0:20:09.56,0:20:12.65,Default,,0000,0000,0000,,...thỉnh thoảng lại nhìn qua kính ngắm ngắm nhìn cuộc sống thường nhật của những người tị nạn...
Dialogue: 0,0:20:12.90,0:20:15.56,Default,,0000,0000,0000,,...và cặm cụi gấp những hình\Norigami giấy khác nhau.
Dialogue: 0,0:20:15.73,0:20:16.89,Default,,0000,0000,0000,,Tôi chẳng hiểu gì cả.
Dialogue: 0,0:20:16.97,0:20:20.56,Default,,0000,0000,0000,,Phải, tôi cũng chịu, chẳng thể nào đoán ra\Nmục đích thực sự của anh ta là gì.
Dialogue: 0,0:20:20.97,0:20:24.17,Default,,0000,0000,0000,,Thế nhưng một thời gian sau khi anh ta bước vào,\Nmột hiện tượng kỳ lạ bắt đầu xảy ra.
Dialogue: 0,0:20:25.08,0:20:28.17,Default,,0000,0000,0000,,Đầu tiên, những người già trong trại dần dà bắt đầu\Ndành sự quan tâm chú ý đến Kuze,
Dialogue: 0,0:20:28.25,0:20:29.94,Default,,0000,0000,0000,,và cuối cùng họ còn chủ động\Nmời anh ta uống nước.
Dialogue: 0,0:20:30.38,0:20:33.41,Default,,0000,0000,0000,,Tiếp đó, lũ trẻ con xúm lại nài nỉ anh ta\Ngấp máy bay giấy cho chúng,
Dialogue: 0,0:20:33.89,0:20:37.18,Default,,0000,0000,0000,,rồi từng đứa một kết bạn với Kuze,\Nngười đàn ông chưa từng hé răng lấy một lời.
Dialogue: 0,0:20:38.16,0:20:43.79,Default,,0000,0000,0000,,Và đến ngày hôm sau, ngay cả phụ nữ và những người đàn ông trưởng thành\Ncũng thay nhau đến bắt chuyện với Kuze.
Dialogue: 0,0:20:44.20,0:20:49.10,Default,,0000,0000,0000,,Kuze chỉ đơn giản mỉm cười nhìn họ với vẻ hạnh phúc,\Nthỉnh thoảng lại đưa máy lên bấm tách một kiểu ảnh.
Dialogue: 0,0:20:51.20,0:20:52.10,Default,,0000,0000,0000,,Rồi sau đó ra sao nữa?
Dialogue: 0,0:20:52.20,0:20:53.83,Default,,0000,0000,0000,,Quân đội Nhân dân\Nchính thức đầu hàng,
Dialogue: 0,0:20:53.91,0:20:58.10,Default,,0000,0000,0000,,và Kuze cứ thế duy trì nếp sống ấy suốt ba tháng ròng,\Ncho đến ngày Lục quân Phòng vệ được giải trừ nhiệm vụ.
Dialogue: 0,0:20:58.41,0:21:02.61,Default,,0000,0000,0000,,Kể từ sau đó, không còn bất kỳ cơ quan truyền thông nào\Nnhắc lại vụ thảm sát ấy nữa.
Dialogue: 0,0:21:03.41,0:21:06.08,Default,,0000,0000,0000,,Và đúng một ngày trước khi Lục quân Phòng vệ\Nlên đường trở về Nhật Bản,
Dialogue: 0,0:21:06.22,0:21:09.05,Default,,0000,0000,0000,,Kuze bỗng nhiên biến mất không dấu vết\Nkhỏi khu trại tị nạn.
Dialogue: 0,0:21:09.95,0:21:12.98,Default,,0000,0000,0000,,Bức ảnh duy nhất chụp lại từ khu trại tị nạn ấy\Nvẫn còn lưu giữ đến tận ngày nay.
Dialogue: 0,0:21:15.26,0:21:16.78,Default,,0000,0000,0000,,Vậy sau đó anh ta\Nđã đi đâu?
Dialogue: 0,0:21:17.23,0:21:21.43,Default,,0000,0000,0000,,Người ta đồn rằng anh ta đã vượt biên\Nvà đi về hướng tây, nhưng đó không phải tin tình báo đáng tin cậy.
Dialogue: 0,0:21:21.97,0:21:25.53,Default,,0000,0000,0000,,Còn về việc anh ta trôi dạt về đâu và bằng cách nào,\Nthì trong quá trình điều tra,
Dialogue: 0,0:21:25.64,0:21:29.44,Default,,0000,0000,0000,,tôi có nói chuyện với một tay vừa mới trở về\Ntừ khu tị nạn ở Đài Loan.
Dialogue: 0,0:21:29.87,0:21:33.44,Default,,0000,0000,0000,,Hắn ta kể rằng đã nhìn thấy một người đàn ông ở đó,\Nngười rất có thể chính là Kuze.
Dialogue: 0,0:21:34.21,0:21:37.01,Default,,0000,0000,0000,,Mái tóc trên cỗ cơ thể cơ khí của anh ta\Nđã bạc trắng hoàn toàn,
Dialogue: 0,0:21:37.42,0:21:39.91,Default,,0000,0000,0000,,nhưng người đó quả quyết rằng\Nchắc chắn đó chính là Kuze.
Dialogue: 0,0:21:40.45,0:21:43.42,Default,,0000,0000,0000,,Anh ta bảo bằng chứng\Nđể nhận ra Kuze...
Dialogue: 0,0:21:43.62,0:21:46.95,Default,,0000,0000,0000,,...chính là việc xung quanh anh ta lúc nào cũng có một đám đông\Nnhững con người tràn ngập niềm vui và hạnh phúc.
Dialogue: 0,0:21:49.73,0:21:51.32,Default,,0000,0000,0000,,Cháu là người Nhật à?
Dialogue: 0,0:21:51.70,0:21:52.49,Default,,0000,0000,0000,,Vâng ạ.
Dialogue: 0,0:21:52.53,0:21:55.12,Default,,0000,0000,0000,,Chà, lạ thật đấy.\NCháu nói được sao?
Dialogue: 0,0:22:05.08,0:22:07.54,Default,,0000,0000,0000,,Ồ, chào Thiếu tá.\NCô cũng tới dự cuộc họp à?
Dialogue: 0,0:22:07.61,0:22:09.38,Default,,0000,0000,0000,,Ừ. Tôi đã nghe toàn bộ mọi chuyện rồi.
Dialogue: 0,0:22:10.85,0:22:13.54,Default,,0000,0000,0000,,Quả là một câu chuyện\Nhết sức lôi cuốn đấy.
Dialogue: 0,0:22:18.89,0:22:19.98,Default,,0000,0000,0000,,Thưa Đại diện.
Dialogue: 0,0:22:20.32,0:22:23.02,Default,,0000,0000,0000,,Tôi gặp chút rắc rối với mảng lọc dữ liệu\Ncủa não điện tử trung tâm,
Dialogue: 0,0:22:23.46,0:22:26.49,Default,,0000,0000,0000,,nhưng cuối cùng tôi cũng đã lần ngược thành công dấu vết\Ntrên não điện tử của người tị nạn.
Dialogue: 0,0:22:27.03,0:22:28.66,Default,,0000,0000,0000,,Đúng như ngài dự đoán, dường như hắn\Nđang có mặt tại Dejima.
Dialogue: 0,0:22:29.47,0:22:32.23,Default,,0000,0000,0000,,Tôi đã yêu cầu Cơ quan An ninh Quốc gia NSA\Nxác thực thông tin,
Dialogue: 0,0:22:32.84,0:22:35.60,Default,,0000,0000,0000,,nên tôi dự kiến sẽ có hình ảnh xác nhận trực tiếp\Nngay trong giây lát nữa thôi.
Dialogue: 0,0:22:35.60,0:22:37.60,Default,,0000,0000,0000,,
