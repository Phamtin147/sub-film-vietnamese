Dialogue: 0,0:01:57.79,0:02:00.92,Default,,0000,0000,0000,,Mọi người lọt qua được lưới an ninh\Ncủa Cảnh sát biển theo đúng kế hoạch chứ?
Dialogue: 0,0:02:01.06,0:02:04.46,Default,,0000,0000,0000,,Ừ. Họ mở một lỗ hổng cho bọn tôi\Nđúng giờ đã hẹn.
Dialogue: 0,0:02:14.24,0:02:17.70,Default,,0000,0000,0000,,Hàng thật giá thật này... Có đống này\Nlà ta phát động chiến tranh được rồi!
Dialogue: 0,0:02:18.68,0:02:21.61,Default,,0000,0000,0000,,Chúng ta mua chúng\Nđâu phải để gây chiến.
Dialogue: 0,0:02:21.92,0:02:24.82,Default,,0000,0000,0000,,Số vũ khí này là để ta có đủ sức mạnh\Nmà {\i1}không cần{\i0} phải đổ máu.
Dialogue: 0,0:02:25.82,0:02:28.19,Default,,0000,0000,0000,,Đó là một trong những lời dạy\Ncủa đồng chí Kuze sao?
Dialogue: 0,0:02:28.39,0:02:29.45,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:02:29.89,0:02:32.69,Default,,0000,0000,0000,,Tôi vẫn chưa được gặp trực tiếp Kuze,
Dialogue: 0,0:02:33.03,0:02:35.46,Default,,0000,0000,0000,,mà cũng chẳng có kết nối mạng\Nnên tôi không rõ lắm.
Dialogue: 0,0:02:36.20,0:02:38.36,Default,,0000,0000,0000,,Anh ta thật sự là\Nmột nhà cách mạng ư?
Dialogue: 0,0:02:39.10,0:02:41.12,Default,,0000,0000,0000,,Lại còn có tin đồn\Nanh ta là người Nhật nữa.
Dialogue: 0,0:02:41.57,0:02:44.20,Default,,0000,0000,0000,,Tôi không biết anh ấy có phải nhà cách mạng\Nđích thực hay không,
Dialogue: 0,0:02:44.47,0:02:47.20,Default,,0000,0000,0000,,nhưng anh ấy có hoài bão lớn lao,\Nvà là người dám nghĩ dám làm...
Dialogue: 0,0:02:47.31,0:02:49.57,Default,,0000,0000,0000,,...người sẵn sàng làm mọi việc cần thiết\Nđể đạt được mục tiêu của mình.
Dialogue: 0,0:02:54.35,0:02:56.41,Default,,0000,0000,0000,,Thôi nào, mau bốc số hàng này lên đi.
Dialogue: 0,0:03:03.72,0:03:08.79,Default,,0000,0000,0000,,Nếu làm quá tải đường dây cao thế của lưới điện\NFukuoka ở hai vị trí cùng một lúc,
Dialogue: 0,0:03:09.00,0:03:10.86,Default,,0000,0000,0000,,toàn bộ mạng lưới sẽ\Nbị ngắt tạm thời.
Dialogue: 0,0:03:11.57,0:03:15.26,Default,,0000,0000,0000,,Có sẵn các giao thức an toàn\Nđể tự động cấp điện...
Dialogue: 0,0:03:15.40,0:03:17.43,Default,,0000,0000,0000,,...thông qua các đường dây dự phòng\Ntrong trường hợp đó,
Dialogue: 0,0:03:17.67,0:03:22.94,Default,,0000,0000,0000,,nhưng nếu phát một dòng xung điện qua các dây đó,\Nnó sẽ kích hoạt phản ứng quá tải dây chuyền,
Dialogue: 0,0:03:23.44,0:03:26.81,Default,,0000,0000,0000,,khiến thủ đô Fukuoka chìm trong bóng tối\Nchỉ trong vòng vài phút.
Dialogue: 0,0:03:27.75,0:03:30.27,Default,,0000,0000,0000,,Các thành phố khác\Ncũng được thiết lập như vậy.
Dialogue: 0,0:03:30.48,0:03:34.48,Default,,0000,0000,0000,,Quả đúng như kỳ vọng ở đám nhân công\Nđược tập hợp để dời đô.
Dialogue: 0,0:03:34.86,0:03:36.48,Default,,0000,0000,0000,,Đám tị nạn này cũng chẳng bỏ sót\Nmánh lới nào nhỉ?
Dialogue: 0,0:03:37.02,0:03:39.96,Default,,0000,0000,0000,,Hẳn là do hắn làm, vừa chỉ họ cách gây mất điện diện rộng,
Dialogue: 0,0:03:40.06,0:03:46.02,Default,,0000,0000,0000,,vừa tuồn lên mạng tin đám tị nạn\Ncó thể dùng thủ đoạn đó để khủng bố.
Dialogue: 0,0:03:46.67,0:03:50.83,Default,,0000,0000,0000,,Ra vậy... Hắn đúng là kẻ thích hợp nhất\Nđể lãnh đạo người tị nạn.
Dialogue: 0,0:04:02.02,0:04:04.42,Default,,0000,0000,0000,,{\i1}Ngươi đã khiến họ từ bỏ{\i0}\N{\i1}các vụ đánh bom liều chết,{\i0}
Dialogue: 0,0:04:04.55,0:04:08.28,Default,,0000,0000,0000,,{\i1}và đang dạy họ cách giải phóng người tị nạn{\i0}\N{\i1}bằng các phương thức phi sát thương.{\i0}
Dialogue: 0,0:04:08.62,0:04:13.15,Default,,0000,0000,0000,,{\i1}Ta không hiểu ngươi đã làm gì để thu phục{\i0}\N{\i1}đám tị nạn trong khoảng thời gian ngắn đến thế,{\i0}
Dialogue: 0,0:04:13.33,0:04:15.63,Default,,0000,0000,0000,,{\i1}nhưng ta nắm rất rõ{\i0}\N{\i1}ngươi đang nghĩ gì.{\i0}
Dialogue: 0,0:04:16.16,0:04:20.00,Default,,0000,0000,0000,,{\i1}Ta sẽ cung cấp cho ngươi{\i0}\N{\i1}kịch bản hoàn hảo nhất của ta.{\i0}
Dialogue: 0,0:04:35.72,0:04:38.84,Default,,0000,0000,0000,,Có vẻ Dejima vừa tuyên bố\Nlà khu tự trị rồi.
Dialogue: 0,0:04:40.22,0:04:42.15,Default,,0000,0000,0000,,Cậu nghĩ Kuze đứng sau vụ này à?
Dialogue: 0,0:04:42.82,0:04:46.92,Default,,0000,0000,0000,,Vẫn chưa thấy tăm hơi Kuze,\Nnhưng chắc chắn là do hắn rồi.
Dialogue: 0,0:04:47.46,0:04:52.09,Default,,0000,0000,0000,,Hắn đang tận dụng mạng lưới rất hiệu quả\Nđể tuồn ý đồ của người tị nạn cho truyền thông.
Dialogue: 0,0:04:52.80,0:04:57.53,Default,,0000,0000,0000,,Báo Nanyou Shinbun còn gọi hắn là Che\NGuevara của Khu Định cư Tị nạn kìa.
Dialogue: 0,0:04:57.91,0:05:00.24,Default,,0000,0000,0000,,Lại thêm một anh hùng vô hình nữa à,\Nđúng thứ ta cần đấy.
Dialogue: 0,0:05:03.01,0:05:07.38,Default,,0000,0000,0000,,Nhưng điều tôi không hiểu là, hắn vốn là một\Ntrong Nhóm Mười Một Cá Nhân, đúng chứ?
Dialogue: 0,0:05:08.18,0:05:10.71,Default,,0000,0000,0000,,Sao đám người tị nạn lại dang rộng\Nvòng tay đón nhận hắn chứ?
Dialogue: 0,0:05:11.32,0:05:14.25,Default,,0000,0000,0000,,Có phải hắn thực sự có khả năng đặc biệt gì đó,
Dialogue: 0,0:05:14.25,0:05:16.65,Default,,0000,0000,0000,,...như điều tra của Thiếu tá\Nvà Ishikawa đã chỉ ra không?
Dialogue: 0,0:05:17.66,0:05:20.82,Default,,0000,0000,0000,,Để trả lời chuyện đó, ta chỉ có nước\Ntóm lấy hắn rồi đích thân thẩm vấn thôi.
Dialogue: 0,0:05:21.16,0:05:25.39,Default,,0000,0000,0000,,Vả lại, lý do duy nhất chúng ta có thể can thiệp\Nlúc này là vì có hắn dính líu.
Dialogue: 0,0:05:25.80,0:05:27.32,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:05:28.17,0:05:30.83,Default,,0000,0000,0000,,Nhiệm vụ trước mắt là phải kìm hãm\Ntình hình này...
Dialogue: 0,0:05:30.97,0:05:33.63,Default,,0000,0000,0000,,...bằng cách bắt giữ Kuze, kẻ mà ta tin\Nlà thủ lĩnh của người tị nạn.
Dialogue: 0,0:05:34.34,0:05:37.14,Default,,0000,0000,0000,,Còn chuyện xin thẩm quyền\Nđể đối đầu với CIS thì tính sau.
Dialogue: 0,0:05:44.95,0:05:46.65,Default,,0000,0000,0000,,Bên dưới đông đúc ghê nhỉ?
Dialogue: 0,0:05:52.23,0:05:54.63,Default,,0000,0000,0000,,Có lẽ tinh thần đoàn kết\Ncủa đám tị nạn đang dâng cao...
Dialogue: 0,0:05:54.73,0:05:57.60,Default,,0000,0000,0000,,...như một phản ứng\Ntrước làn sóng dư luận.
Dialogue: 0,0:05:58.20,0:06:01.63,Default,,0000,0000,0000,,Trong những tình huống thế này, những kẻ\Nbị dồn vào chân tường...
Dialogue: 0,0:06:01.74,0:06:04.03,Default,,0000,0000,0000,,...lại là những kẻ liên kết\Nvà hành động nhanh nhất.
Dialogue: 0,0:06:04.81,0:06:06.71,Default,,0000,0000,0000,,Thực tế thì các hành động\Ncủa công dân nước ta...
Dialogue: 0,0:06:06.81,0:06:09.21,Default,,0000,0000,0000,,...lúc này chẳng qua chỉ là biểu tình\Nphản đối các cơ quan chính phủ.
Dialogue: 0,0:06:09.31,0:06:11.21,Default,,0000,0000,0000,,Có vẻ như một phong trào\Nchủ nghĩa cá nhân đại chúng,
Dialogue: 0,0:06:11.31,0:06:15.84,Default,,0000,0000,0000,,không, đúng hơn là tư tưởng cầu an bằng mọi giá,\Nđang lan rộng trong quần chúng.
Dialogue: 0,0:06:16.85,0:06:20.12,Default,,0000,0000,0000,,Mặc dù chuyện này về cơ bản là\Nlời tuyên chiến từ phía người tị nạn...
Dialogue: 0,0:06:21.96,0:06:23.51,Default,,0000,0000,0000,,Cho chúng tôi vào Dejima!
Dialogue: 0,0:06:23.66,0:06:25.28,Default,,0000,0000,0000,,Cho chúng tôi\Nqua cầu!
Dialogue: 0,0:06:38.94,0:06:42.07,Default,,0000,0000,0000,,Batou, cậu và những người khác hãy đi trước\Nvà thu thập tin tức...
Dialogue: 0,0:06:42.21,0:06:44.51,Default,,0000,0000,0000,,...xem người tị nạn được trang bị\Nvũ khí đến mức nào.
Dialogue: 0,0:06:45.21,0:06:47.68,Default,,0000,0000,0000,,Tôi và Ishikawa sẽ lặn vào mạng của đám tị nạn\Nrồi hội quân với các cậu...
Dialogue: 0,0:06:47.78,0:06:50.38,Default,,0000,0000,0000,,...ngay khi xác định được\Nvị trí của Kuze.
Dialogue: 0,0:06:50.68,0:06:51.71,Default,,0000,0000,0000,,- Rõ!\N- Rõ!
Dialogue: 0,0:07:03.53,0:07:06.66,Default,,0000,0000,0000,,Bọn tôi thuộc Đội 9. Có vẻ tình hình\Nở đây đang căng thẳng lắm nhỉ.
Dialogue: 0,0:07:07.43,0:07:09.49,Default,,0000,0000,0000,,Cấp trên có vẻ lại\Nchẳng nghĩ vậy đâu.
Dialogue: 0,0:07:09.60,0:07:12.23,Default,,0000,0000,0000,,Phải thừa nhận là lính thực địa\Nbọn tôi lúc nào cũng thiếu thốn.
Dialogue: 0,0:07:12.61,0:07:17.37,Default,,0000,0000,0000,,Không ít kẻ đang nóng lòng muốn trao\Nquyền chỉ huy tác chiến cho Quân Phòng vệ.
Dialogue: 0,0:07:17.71,0:07:20.58,Default,,0000,0000,0000,,Các anh đến đây\Ncũng là một phần trong kế hoạch đó à?
Dialogue: 0,0:07:20.85,0:07:23.11,Default,,0000,0000,0000,,Bọn tôi chỉ đến làm\Nnhiệm vụ độc lập thôi.
Dialogue: 0,0:07:24.38,0:07:27.29,Default,,0000,0000,0000,,Được làm việc không bị trói buộc thế thì thích thật.\NGhen tị đấy.
Dialogue: 0,0:07:27.62,0:07:30.25,Default,,0000,0000,0000,,Có thể, nhưng bọn tôi phải tự lo liệu\Ncái mạng của mình.
Dialogue: 0,0:07:37.93,0:07:40.02,Default,,0000,0000,0000,,Trước tiên ta sẽ thâm nhập\Nvào não điện tử của một người tị nạn.
Dialogue: 0,0:07:40.23,0:07:43.20,Default,,0000,0000,0000,,Não điện tử của Kuze dường như\Nluôn mở cửa cho người tị nạn mọi lúc.
Dialogue: 0,0:07:44.27,0:07:47.67,Default,,0000,0000,0000,,Ta không cần yểm trợ cho tới khi\Ntiếp cận được Đường ranh Ghost của hắn.
Dialogue: 0,0:07:48.04,0:07:49.17,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:07:54.68,0:07:58.14,Default,,0000,0000,0000,,Điều tra sơ bộ không phát hiện mối liên hệ nào,\Nchẳng hạn như dòng tiền,
Dialogue: 0,0:07:58.25,0:08:02.38,Default,,0000,0000,0000,,giữa Chánh Văn phòng Nội các Takakura\Nvà Tập đoàn Công nghiệp Poseidon.
Dialogue: 0,0:08:02.89,0:08:04.08,Default,,0000,0000,0000,,Ta hiểu rồi.
Dialogue: 0,0:08:04.93,0:08:06.59,Default,,0000,0000,0000,,Chúng ta có đến kịp\Ncuộc họp không?
Dialogue: 0,0:08:06.89,0:08:08.45,Default,,0000,0000,0000,,Hiện tại đường sá có vẻ không bị\Ntắc nghẽn, thưa Trưởng phòng.
Dialogue: 0,0:08:09.93,0:08:13.96,Default,,0000,0000,0000,,{\i1}Trưởng phòng, về quan chức Bộ Ngoại giao{\i0}\N{\i1}mà ngài dự kiến gặp hôm nay...{\i0}
Dialogue: 0,0:08:14.30,0:08:17.03,Default,,0000,0000,0000,,{\i1}Có chuyện gì? Có tin tức gì{\i0}\N{\i1}về cậu ta rồi sao?{\i0}
Dialogue: 0,0:08:17.40,0:08:21.84,Default,,0000,0000,0000,,{\i1}Vâng, Sở Cảnh sát Niihama vừa ra thông cáo{\i0}\N{\i1}qua Hãng tin Kyodo...{\i0}
Dialogue: 0,0:08:21.94,0:08:26.07,Default,,0000,0000,0000,,{\i1}...nói rằng anh ta đã bị tàu đâm chết{\i0}\N{\i1}tại ga tàu điện ngầm.{\i0}
Dialogue: 0,0:08:29.82,0:08:31.48,Default,,0000,0000,0000,,Ngài nghĩ việc này có ý nghĩa gì,\Nthưa ngài?
Dialogue: 0,0:08:31.62,0:08:36.18,Default,,0000,0000,0000,,Dường như cũng có những đợt sóng ngầm khổng lồ\Nẩn sau Hiệp ước An ninh...
Dialogue: 0,0:08:36.36,0:08:37.52,Default,,0000,0000,0000,,Quay về\Ntổng hành dinh thôi.
Dialogue: 0,0:08:38.29,0:08:39.28,Default,,0000,0000,0000,,Rõ, thưa Trưởng phòng.
Dialogue: 0,0:09:00.05,0:09:02.21,Default,,0000,0000,0000,,Nơi này nhộn nhịp hơn nhiều\Nso với những gì tôi nghe được.
Dialogue: 0,0:09:03.12,0:09:07.52,Default,,0000,0000,0000,,Người tị nạn đã xây dựng khu ổ chuột\Ncao tầng này suốt hơn 20 năm rồi.
Dialogue: 0,0:09:08.42,0:09:12.22,Default,,0000,0000,0000,,Họ gọi nơi này là lâu đài của mình\Ncũng chẳng ngoa đâu.
Dialogue: 0,0:09:23.70,0:09:25.33,Default,,0000,0000,0000,,Chúng ta sẽ chia làm hai nhóm\Ntừ đây.
Dialogue: 0,0:09:25.77,0:09:27.64,Default,,0000,0000,0000,,Tôi sẽ dẫn Azuma và Yano\Ntheo.
Dialogue: 0,0:09:27.84,0:09:30.78,Default,,0000,0000,0000,,Đội của cậu gồm Paz, Borma,\NSaito và Togusa.
Dialogue: 0,0:09:31.38,0:09:32.81,Default,,0000,0000,0000,,Việc bắt Kuze sẽ\Nkhó khăn hơn rất nhiều...
Dialogue: 0,0:09:32.91,0:09:34.01,Default,,0000,0000,0000,,...tùy thuộc vào lượng vũ khí\Nmà họ tích trữ,
Dialogue: 0,0:09:34.11,0:09:38.95,Default,,0000,0000,0000,,liệu có dân quân hay không, và họ có\Nchuỗi chỉ huy bài bản hay không.
Dialogue: 0,0:09:39.12,0:09:42.45,Default,,0000,0000,0000,,Hiểu rồi. Bọn tôi sẽ\Nkiểm tra các ổ thuốc phiện.
Dialogue: 0,0:09:42.69,0:09:46.65,Default,,0000,0000,0000,,Nếu họ lập đội dân quân, cá là sẽ có\Nnhiều người tìm đến bàn đèn hơn đấy.
Dialogue: 0,0:09:46.93,0:09:50.66,Default,,0000,0000,0000,,Được rồi, nhóm tôi sẽ liên hệ đám buôn lậu\Nchợ đen để truy vết đường đi của vũ khí.
Dialogue: 0,0:09:50.76,0:09:51.70,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:09:57.57,0:10:01.47,Default,,0000,0000,0000,,Giờ thì... con đường ngắn nhất\Nđể tiếp cận Kuze là gì đây?
Dialogue: 0,0:10:02.08,0:10:03.13,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:10:03.38,0:10:05.90,Default,,0000,0000,0000,,Em vừa tìm thấy lịch trực của một đồn cảnh sát\Nbên trong Dejima, trong đó ghi...
Dialogue: 0,0:10:06.01,0:10:09.95,Default,,0000,0000,0000,,...có một cảnh sát toàn thân cyborg hóa,\Nlại còn là nữ, đang làm nhiệm vụ ngay lúc này!
Dialogue: 0,0:10:10.42,0:10:13.41,Default,,0000,0000,0000,,{\i1}Được rồi, làm tốt lắm.{\i0}\N{\i1}Cho tôi hình ảnh đi.{\i0}
Dialogue: 0,0:10:13.75,0:10:14.91,Default,,0000,0000,0000,,Vâng ạ!
Dialogue: 0,0:10:15.49,0:10:17.68,Default,,0000,0000,0000,,Trông họ rảnh rỗi ghê.
Dialogue: 0,0:10:17.79,0:10:19.76,Default,,0000,0000,0000,,Có lẽ họ đang cảnh giác\Ntrước các vụ tấn công khủng bố.
Dialogue: 0,0:10:19.86,0:10:22.35,Default,,0000,0000,0000,,Được rồi, chúng ta sẽ\Nmượn tạm não điện tử của cô nàng này.
Dialogue: 0,0:10:22.53,0:10:24.02,Default,,0000,0000,0000,,- Rõ!\N- Rõ!
Dialogue: 0,0:10:26.53,0:10:29.80,Default,,0000,0000,0000,,Thằng chả ngồi ngoài kia\Ntrông rợn cả người...
Dialogue: 0,0:10:30.27,0:10:31.79,Default,,0000,0000,0000,,Cẩn thận, hắn nghe thấy\Nbây giờ.
Dialogue: 0,0:10:33.24,0:10:37.30,Default,,0000,0000,0000,,Này, nhắc mới nhớ. Cậu đã khởi tạo lại\Nhệ điều khiển cánh tay phải chưa?
Dialogue: 0,0:10:37.88,0:10:41.47,Default,,0000,0000,0000,,Tin tôi đi, đừng bao giờ\Nnâng cấp hệ điều khiển làm gì.
Dialogue: 0,0:10:42.28,0:10:45.31,Default,,0000,0000,0000,,{\i1}Tổng bộ gọi Khu tuần tra 26.{\i0}\N{\i1}Trả lời!{\i0}
Dialogue: 0,0:10:48.16,0:10:49.35,Default,,0000,0000,0000,,Cậu ổn chứ?
Dialogue: 0,0:10:50.92,0:10:52.05,Default,,0000,0000,0000,,Tay này hợp đấy.
Dialogue: 0,0:10:54.16,0:10:56.03,Default,,0000,0000,0000,,Này, có chuyện gì thế?
Dialogue: 0,0:11:10.78,0:11:14.87,Default,,0000,0000,0000,,Tìm thấy rồi! Hắn dường như đang kết nối\Nvới Kuze ngay lúc này!
Dialogue: 0,0:11:15.18,0:11:18.85,Default,,0000,0000,0000,,{\i1}Tốt. Ta sẽ theo tuyến này{\i0}\N{\i1}để định vị nơi ở của Kuze.{\i0}
Dialogue: 0,0:11:19.05,0:11:20.31,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:11:24.36,0:11:27.02,Default,,0000,0000,0000,,Thề luôn, tụi người máy này\Ntoàn lũ điên...
Dialogue: 0,0:11:47.68,0:11:48.94,Default,,0000,0000,0000,,{\i1}Mê cung tường lửa ư?{\i0}
Dialogue: 0,0:11:49.52,0:11:52.61,Default,,0000,0000,0000,,{\i1}Hắn phân vùng để chỉ cho phép{\i0}\N{\i1}người tị nạn truy cập sao?{\i0}
Dialogue: 0,0:11:53.35,0:11:55.41,Default,,0000,0000,0000,,{\i1}Lúc này không thể{\i0}\N{\i1}định vị được hắn...{\i0}
Dialogue: 0,0:11:55.92,0:12:00.36,Default,,0000,0000,0000,,Tuyến này cố định rồi, nên em nghĩ\Nhắn đang ở đâu đó trong Dejima, thưa Thiếu tá.
Dialogue: 0,0:12:03.73,0:12:05.10,Default,,0000,0000,0000,,Này! Hẳn là nó rồi!
Dialogue: 0,0:12:06.30,0:12:09.33,Default,,0000,0000,0000,,Trời đất, lượng người tị nạn\Ntruy cập vào hắn đông thật đấy...
Dialogue: 0,0:12:13.24,0:12:17.23,Default,,0000,0000,0000,,Dù vậy, ngoài bộ lọc ra thì em không thấy\Ntường lửa nào rõ rệt cả.
Dialogue: 0,0:12:17.58,0:12:18.57,Default,,0000,0000,0000,,Mệnh lệnh thế nào ạ?
Dialogue: 0,0:12:18.71,0:12:21.65,Default,,0000,0000,0000,,Được rồi, ta sẽ lặn vào\Ntrước khi đối phương nhận ra.
Dialogue: 0,0:12:22.22,0:12:25.65,Default,,0000,0000,0000,,Chuẩn bị mặt nạ cảm giác toàn phần.\NMục tiêu là thị trường của Kuze.
Dialogue: 0,0:12:26.12,0:12:27.98,Default,,0000,0000,0000,,Ta sẽ dựa vào tầm nhìn của hắn\Nđể xác định vị trí.
Dialogue: 0,0:12:39.87,0:12:41.86,Default,,0000,0000,0000,,{\i1}Tệp Mười Một Cá Nhân hả?{\i0}
Dialogue: 0,0:12:42.00,0:12:46.30,Default,,0000,0000,0000,,{\i1}Tôi thấy rồi. Nhưng ưu tiên hiện tại{\i0}\N{\i1}là tìm ra tung tích Kuze.{\i0}
Dialogue: 0,0:12:48.48,0:12:51.04,Default,,0000,0000,0000,,Ishikawa, cậu hãy lần ngược mạng lưới\Ntừ Cổng 5...
Dialogue: 0,0:12:51.14,0:12:53.84,Default,,0000,0000,0000,,...và tìm xem yếu tố nào\Nthu hút đám tị nạn đến với Kuze.
Dialogue: 0,0:12:54.28,0:12:55.27,Default,,0000,0000,0000,,Tôi làm ngay.
Dialogue: 0,0:12:55.38,0:12:59.68,Default,,0000,0000,0000,,Tachikoma! Tiêm mảng mặt nạ vào. Tôi sẽ vượt qua\NĐường ranh Ghost của hắn bằng tệp Chroma.
Dialogue: 0,0:13:07.59,0:13:08.79,Default,,0000,0000,0000,,Cái gì thế này...?
Dialogue: 0,0:13:09.13,0:13:11.69,Default,,0000,0000,0000,,Ma trận ký ức ngột ngạt này\Nlà sao?
Dialogue: 0,0:13:12.30,0:13:16.74,Default,,0000,0000,0000,,Thiếu tá! Chị phải nhanh lên!\NMặt nạ cảm giác toàn phần đang suy thoái rất nhanh!
Dialogue: 0,0:13:20.97,0:13:22.17,Default,,0000,0000,0000,,Nếu là cô, tôi sẽ không làm thế đâu.
Dialogue: 0,0:13:23.01,0:13:25.48,Default,,0000,0000,0000,,Nếu liên kết sâu hơn với tôi,\Ncô sẽ chết đấy.
Dialogue: 0,0:13:25.85,0:13:28.71,Default,,0000,0000,0000,,{\i1}Hắn đã nhìn thấu mặt nạ{\i0}\N{\i1}cảm giác của mình rồi sao?{\i0}
Dialogue: 0,0:13:28.95,0:13:30.97,Default,,0000,0000,0000,,{\i1}Tường lửa tấn công{\i0}\N{\i1}vô tác dụng với ta!{\i0}
Dialogue: 0,0:13:31.35,0:13:32.44,Default,,0000,0000,0000,,Ý tôi không phải\Nnhư vậy.
Dialogue: 0,0:13:32.95,0:13:36.15,Default,,0000,0000,0000,,Ý tôi là nếu liên kết với tâm thức của tôi,\Ncô sẽ đau khổ khôn cùng.
Dialogue: 0,0:13:44.10,0:13:45.16,Default,,0000,0000,0000,,Chỉ có thế thôi sao?
Dialogue: 0,0:13:47.37,0:13:48.43,Default,,0000,0000,0000,,Thiếu tá?
Dialogue: 0,0:13:50.14,0:13:52.90,Default,,0000,0000,0000,,Tachikoma! Có chuyện gì vậy?!\NRút lui khỏi đó {\i1}ngay!{\i0}
Dialogue: 0,0:13:52.97,0:13:54.00,Default,,0000,0000,0000,,{\i1}Rõ!{\i0}
Dialogue: 0,0:13:58.24,0:14:01.18,Default,,0000,0000,0000,,Thiếu tá, tỉnh lại đi!\NThiếu tá!
Dialogue: 0,0:14:01.62,0:14:03.95,Default,,0000,0000,0000,,Tachikoma! Là tường lửa\Ntấn công à?
Dialogue: 0,0:14:04.25,0:14:09.15,Default,,0000,0000,0000,,Em không biết, nhưng em chẳng phát hiện bất kỳ\Nloại virus hay tường lửa tấn công nào!
Dialogue: 0,0:14:09.49,0:14:12.12,Default,,0000,0000,0000,,Nó chẳng ảnh hưởng gì\Nđến đám AI bọn em cả.
Dialogue: 0,0:14:12.43,0:14:15.22,Default,,0000,0000,0000,,Chẳng lẽ là ảo giác\Nhay chất kích thích gì đó tương tự sao?
Dialogue: 0,0:14:16.00,0:14:18.76,Default,,0000,0000,0000,,Tôi không nghĩ mấy thứ đó\Ncó tác dụng được với Thiếu tá đâu...
Dialogue: 0,0:14:19.47,0:14:21.37,Default,,0000,0000,0000,,Này! Thiếu tá?
Dialogue: 0,0:14:22.64,0:14:24.04,Default,,0000,0000,0000,,Cô ổn chứ?
Dialogue: 0,0:14:24.87,0:14:26.96,Default,,0000,0000,0000,,Chuyện gì đã xảy ra?\NCô đã thấy gì vậy?
Dialogue: 0,0:14:30.11,0:14:31.63,Default,,0000,0000,0000,,Một ảo ảnh...
Dialogue: 0,0:14:34.35,0:14:35.75,Default,,0000,0000,0000,,Quên đi, không có gì đâu.
Dialogue: 0,0:14:36.02,0:14:40.35,Default,,0000,0000,0000,,Điều quan trọng lúc này là dùng dữ liệu tôi đã lấy\Ntừ hắn để định vị nơi hắn trốn.
Dialogue: 0,0:14:41.45,0:14:42.55,Default,,0000,0000,0000,,Làm việc đi!
Dialogue: 0,0:14:43.06,0:14:44.46,Default,,0000,0000,0000,,Đã rõ.
Dialogue: 0,0:14:47.49,0:14:48.96,Default,,0000,0000,0000,,{\i1}Tên này khó nhằn thật...{\i0}
Dialogue: 0,0:14:49.56,0:14:51.43,Default,,0000,0000,0000,,{\i1}Hiện tại hắn đang ở{\i0}\N{\i1}trên con tàu đó...{\i0}
Dialogue: 0,0:14:52.87,0:14:56.80,Default,,0000,0000,0000,,{\i1}Và mình biết hắn,{\i0}\N{\i1}khốn kiếp!{\i0}
Dialogue: 0,0:15:02.04,0:15:03.07,Default,,0000,0000,0000,,{\i1}Tôi đây.{\i0}
Dialogue: 0,0:15:03.21,0:15:05.64,Default,,0000,0000,0000,,{\i1}Kuze đấy à?{\i0}\N{\i1}Có chuyện gì xảy ra sao?{\i0}
Dialogue: 0,0:15:06.05,0:15:08.57,Default,,0000,0000,0000,,{\i1}Xin lỗi, nhưng rất có thể{\i0}\N{\i1}các anh sẽ bị đột kích...{\i0}
Dialogue: 0,0:15:08.68,0:15:11.48,Default,,0000,0000,0000,,{\i1}...bởi cảnh sát hoặc đặc nhiệm{\i0}\N{\i1}quân đội sớm thôi.{\i0}
Dialogue: 0,0:15:12.52,0:15:14.85,Default,,0000,0000,0000,,{\i1}Nhưng các anh không cần{\i0}\N{\i1}phải giao chiến với họ.{\i0}
Dialogue: 0,0:15:15.32,0:15:17.65,Default,,0000,0000,0000,,{\i1}Hãy giấu vũ khí và tránh{\i0}\N{\i1}giao tranh hết mức có thể.{\i0}
Dialogue: 0,0:15:18.56,0:15:20.36,Default,,0000,0000,0000,,{\i1}Đừng vứt bỏ{\i0}\N{\i1}mạng sống của mình.{\i0}
Dialogue: 0,0:15:57.26,0:16:00.79,Default,,0000,0000,0000,,Lời khuyên chân thành nhé.\NÔng nên đổi sang cặp mắt này đi.
Dialogue: 0,0:16:00.90,0:16:03.43,Default,,0000,0000,0000,,Nhìn là hiểu rồi.\NHàng ngon đấy.
Dialogue: 0,0:16:03.60,0:16:04.63,Default,,0000,0000,0000,,Chuẩn chứ hả?
Dialogue: 0,0:16:04.80,0:16:08.30,Default,,0000,0000,0000,,Chắc ông nghĩ ở Dejima thì\Nkhông mua nổi các bộ phận sinh học đâu nhỉ,
Dialogue: 0,0:16:08.68,0:16:12.48,Default,,0000,0000,0000,,nhưng thực tế là, chỉ cần chịu chi tiền,\Nông có thể chạm tay vào gần như mọi thứ.
Dialogue: 0,0:16:09.51,0:16:12.48,Top Secondary Dialog 1080P,,0000,0000,0000,,Này ông anh. Cho ké một hơi đi?
Dialogue: 0,0:16:13.25,0:16:14.47,Default,,0000,0000,0000,,Biến ra chỗ khác đi mày.
Dialogue: 0,0:16:15.05,0:16:19.35,Default,,0000,0000,0000,,Ừ, tôi hiểu rồi. Thế Kuze\Ncũng từng đến đây đổi cơ thể à?
Dialogue: 0,0:16:19.59,0:16:21.25,Default,,0000,0000,0000,,Tôi chưa từng hoán đổi\Ncơ thể cho anh ta.
Dialogue: 0,0:16:21.52,0:16:24.25,Default,,0000,0000,0000,,Tôi không kiếm đâu ra một cơ thể người máy\Nđặc biệt như của hắn được.
Dialogue: 0,0:16:24.49,0:16:26.22,Default,,0000,0000,0000,,Tôi chỉ thay\Nlớp da ngoài thôi.
Dialogue: 0,0:16:26.56,0:16:27.39,Default,,0000,0000,0000,,Còn khuôn mặt\Nthì sao?
Dialogue: 0,0:16:27.49,0:16:30.52,Default,,0000,0000,0000,,Mặt thì hắn nhờ một\Nnghệ nhân tạo hình mặt làm cho.
Dialogue: 0,0:16:31.36,0:16:33.92,Default,,0000,0000,0000,,Đó là món độc nhất vô nhị với cái miệng\Nhầu như chẳng cử động được...
Dialogue: 0,0:16:34.33,0:16:36.00,Default,,0000,0000,0000,,Ngạc nhiên là hắn lại quen được\Nngười như thế đấy.
Dialogue: 0,0:16:36.17,0:16:39.63,Default,,0000,0000,0000,,Một kẻ như hắn thì tôi tin ai cũng\Nsẵn lòng làm cho một khuôn mặt thôi.
Dialogue: 0,0:16:39.94,0:16:43.47,Default,,0000,0000,0000,,Thậm chí nếu hắn tìm đến tôi,\Ntôi cũng tình nguyện làm giúp.
Dialogue: 0,0:16:48.01,0:16:50.61,Default,,0000,0000,0000,,Sao hắn lại cuốn hút\Nngười khác đến vậy?
Dialogue: 0,0:16:51.62,0:16:57.92,Default,,0000,0000,0000,,Chịu thôi. Có lẽ bọn tôi bị choáng ngợp\Nbởi tầm vóc hoài bão của anh ta.
Dialogue: 0,0:16:58.59,0:17:00.75,Default,,0000,0000,0000,,Tầm vóc hoài bão\Ncủa hắn ư?
Dialogue: 0,0:17:01.33,0:17:02.16,Default,,0000,0000,0000,,{\i1}Batou.{\i0}
Dialogue: 0,0:17:02.26,0:17:03.32,Default,,0000,0000,0000,,{\i1}Có chuyện gì thế?{\i0}
Dialogue: 0,0:17:03.43,0:17:05.40,Default,,0000,0000,0000,,{\i1}Bọn tôi đã có vị trí của Kuze.{\i0}
Dialogue: 0,0:17:06.43,0:17:09.60,Default,,0000,0000,0000,,{\i1}Đó là một bến cảng ngụy trang ở{\i0}\N{\i1}rìa đông bắc Dejima.{\i0}
Dialogue: 0,0:17:10.67,0:17:13.30,Default,,0000,0000,0000,,{\i1}Có một chiếc thuyền đánh cá cải tiến{\i0}\N{\i1}đang neo đậu ở đó.{\i0}
Dialogue: 0,0:17:13.81,0:17:16.17,Default,,0000,0000,0000,,{\i1}Hắn có thể đang ở{\i0}\N{\i1}trên con thuyền đó.{\i0}
Dialogue: 0,0:17:17.48,0:17:19.11,Default,,0000,0000,0000,,{\i1}Câu này không giống phong cách của cô chút nào.{\i0}
Dialogue: 0,0:17:17.91,0:17:20.75,Top Secondary Dialog 1080P,,0000,0000,0000,,Mấy tay này bị ám ảnh bởi vũ khí rồi.
Dialogue: 0,0:17:19.11,0:17:20.85,Default,,0000,0000,0000,,Cô không chắc 100% à?
Dialogue: 0,0:17:20.75,0:17:22.38,Top Secondary Dialog 1080P,,0000,0000,0000,,Dạo này làm ăn ế ẩm quá.
Dialogue: 0,0:17:21.58,0:17:23.75,Default,,0000,0000,0000,,{\i1}Hắn đã phát hiện ra tôi vào phút chót.{\i0}
Dialogue: 0,0:17:24.05,0:17:27.21,Default,,0000,0000,0000,,{\i1}Hiện bọn tôi đang lượn vòng{\i0}\N{\i1}bên trên bến cảng.{\i0}
Dialogue: 0,0:17:27.89,0:17:32.26,Default,,0000,0000,0000,,{\i1}Hắn vẫn chưa đi đâu cả.{\i0}\N{\i1}Ta sẽ tóm hắn trước khi hắn trốn thoát.{\i0}
Dialogue: 0,0:17:32.79,0:17:34.56,Default,,0000,0000,0000,,{\i1}Hội quân với bọn tôi{\i0}\N{\i1}ở bến cảng càng sớm càng tốt.{\i0}
Dialogue: 0,0:17:34.79,0:17:35.89,Default,,0000,0000,0000,,{\i1}Rõ!{\i0}
Dialogue: 0,0:17:40.10,0:17:41.26,Default,,0000,0000,0000,,Đi thôi!
Dialogue: 0,0:17:52.91,0:17:54.28,Default,,0000,0000,0000,,Thỏa thuận đã xong.
Dialogue: 0,0:17:54.78,0:17:58.22,Default,,0000,0000,0000,,Ngày mai, cuối cùng chúng ta\Ncũng sẽ có được hy vọng.
Dialogue: 0,0:17:58.65,0:17:59.81,Default,,0000,0000,0000,,Thật sao?
Dialogue: 0,0:18:00.32,0:18:02.41,Default,,0000,0000,0000,,Tôi biết anh\Nsẽ làm được mà.
Dialogue: 0,0:18:02.79,0:18:04.22,Default,,0000,0000,0000,,Chúng ta có\Ncơ hội rồi!
Dialogue: 0,0:18:04.32,0:18:05.55,Default,,0000,0000,0000,,Cách mạng rồi!
Dialogue: 0,0:18:10.03,0:18:12.52,Default,,0000,0000,0000,,A-Anh là Kuze sao?
Dialogue: 0,0:18:14.30,0:18:15.29,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:18:15.54,0:18:20.50,Default,,0000,0000,0000,,Anh... Anh là một trong Nhóm\NMười Một Cá Nhân, đúng không?
Dialogue: 0,0:18:26.28,0:18:30.98,Default,,0000,0000,0000,,Làm sao anh lại là người phe ta được? Anh là kẻ\Nđã giết Densetsu, phải không?!
Dialogue: 0,0:18:31.48,0:18:32.45,Default,,0000,0000,0000,,Này.
Dialogue: 0,0:18:37.39,0:18:41.09,Default,,0000,0000,0000,,Như anh nói đấy, tôi là một\Ntrong Nhóm Mười Một Cá Nhân.
Dialogue: 0,0:18:42.03,0:18:44.96,Default,,0000,0000,0000,,Vậy tại sao mọi người\Nlại chấp nhận anh chứ?
Dialogue: 0,0:18:45.06,0:18:47.16,Default,,0000,0000,0000,,Nghe này!\NAnh ấy đã...
Dialogue: 0,0:18:50.00,0:18:52.13,Default,,0000,0000,0000,,Nếu anh không thể tin tôi,\Ncũng chẳng sao.
Dialogue: 0,0:18:52.41,0:18:54.60,Default,,0000,0000,0000,,Con người về căn bản là\Nkhông thể thấu hiểu lẫn nhau.
Dialogue: 0,0:18:54.97,0:18:59.31,Default,,0000,0000,0000,,Trước mắt, chỉ cần anh nhận ra rằng\Nanh không thể hiểu được tôi là đủ rồi.
Dialogue: 0,0:18:59.91,0:19:05.51,Default,,0000,0000,0000,,Vai trò của tôi là dẫn dắt các anh\Nđến cùng một nơi với tôi lúc này.
Dialogue: 0,0:19:06.69,0:19:09.62,Default,,0000,0000,0000,,Nhưng điều đó chỉ có thể thể hiện\Nqua hành động, chứ không phải lời nói.
Dialogue: 0,0:19:10.06,0:19:12.62,Default,,0000,0000,0000,,Nếu sau khi chứng kiến những hành động đó\Nmà anh vẫn chưa bị thuyết phục,
Dialogue: 0,0:19:12.96,0:19:17.09,Default,,0000,0000,0000,,anh vẫn có quyền tự do\Nrút lui theo ý chí của mình.
Dialogue: 0,0:19:27.64,0:19:28.77,Default,,0000,0000,0000,,{\i1}Cái quái gì thế này?{\i0}
Dialogue: 0,0:19:29.28,0:19:31.54,Default,,0000,0000,0000,,{\i1}Thiếu tá, ở đây có tới{\i0}\N{\i1}ba chiếc tàu như vậy!{\i0}
Dialogue: 0,0:19:31.81,0:19:34.34,Default,,0000,0000,0000,,{\i1}Hẳn là họ đã cải tạo chúng{\i0}\N{\i1}với vẻ ngoài giống hệt nhau...{\i0}
Dialogue: 0,0:19:34.58,0:19:37.24,Default,,0000,0000,0000,,{\i1}...để dễ dàng lọt qua lưới{\i0}\N{\i1}tuần tra của Cảnh sát biển.{\i0}
Dialogue: 0,0:19:37.62,0:19:39.52,Default,,0000,0000,0000,,{\i1}Mục tiêu của chúng ta nằm trên{\i0}\N{\i1}một trong ba con tàu đó.{\i0}
Dialogue: 0,0:19:39.95,0:19:41.25,Default,,0000,0000,0000,,{\i1}\"Một trong số đó\" ư?{\i0}
Dialogue: 0,0:19:42.76,0:19:46.69,Default,,0000,0000,0000,,{\i1}Tôi nghĩ cô ấy đã bị thứ gì đó tấn công{\i0}\N{\i1}trong lúc thâm nhập vào mắt Kuze.{\i0}
Dialogue: 0,0:19:46.99,0:19:48.52,Default,,0000,0000,0000,,{\i1}Này, cô ổn chứ?{\i0}
Dialogue: 0,0:19:48.63,0:19:49.60,Default,,0000,0000,0000,,{\i1}Tôi ổn.{\i0}
Dialogue: 0,0:19:50.23,0:19:53.76,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ kiểm tra các con tàu, mỗi toán hai người.{\i0}\N{\i1}Bật ngụy trang quang học và xâm nhập.{\i0}
Dialogue: 0,0:19:54.40,0:19:56.63,Default,,0000,0000,0000,,{\i1}Batou và Togusa.{\i0}\N{\i1}Paz và Borma.{\i0}
Dialogue: 0,0:19:56.77,0:19:57.90,Default,,0000,0000,0000,,{\i1}Saito và tôi.{\i0}
Dialogue: 0,0:19:58.34,0:20:00.97,Default,,0000,0000,0000,,{\i1}Ishikawa, Azuma và Yano,{\i0}\N{\i1}làm nhiệm vụ yểm trợ.{\i0}
Dialogue: 0,0:20:01.47,0:20:02.96,Default,,0000,0000,0000,,{\i1}Tachikoma, canh chừng{\i0}\N{\i1}từ phía trên.{\i0}
Dialogue: 0,0:20:31.97,0:20:32.94,Default,,0000,0000,0000,,{\i1}Không thấy dấu vết của hắn.{\i0}
Dialogue: 0,0:20:33.44,0:20:34.70,Default,,0000,0000,0000,,{\i1}Bên này cũng chẳng có ai.{\i0}
Dialogue: 0,0:20:46.82,0:20:48.08,Default,,0000,0000,0000,,Máy phát tín hiệu sao?
Dialogue: 0,0:20:49.19,0:20:50.25,Default,,0000,0000,0000,,Coi chừng!
Dialogue: 0,0:20:53.06,0:20:54.22,Default,,0000,0000,0000,,Phục kích chết tiệt sao?!
Dialogue: 0,0:21:28.33,0:21:30.99,Default,,0000,0000,0000,,Lũ bay đến đây... để bắt Kuze sao?
Dialogue: 0,0:21:37.74,0:21:38.97,Default,,0000,0000,0000,,Cái quái gì thế này?!
Dialogue: 0,0:21:39.27,0:21:40.64,Default,,0000,0000,0000,,Lũ ngốc các người...
Dialogue: 0,0:21:41.54,0:21:44.98,Default,,0000,0000,0000,,Loại như các người\Nđời nào bắt được Kuze...
Dialogue: 0,0:21:45.95,0:21:50.41,Default,,0000,0000,0000,,Anh ấy là hàng thật giá thật...\NAnh ấy là người hùng.
Dialogue: 0,0:21:58.09,0:21:59.56,Default,,0000,0000,0000,,{\i1}Tại sao họ lại{\i0}\N{\i1}khai hỏa với chúng?{\i0}
Dialogue: 0,0:22:01.36,0:22:03.56,Default,,0000,0000,0000,,{\i1}Mình đã dặn họ không được{\i0}\N{\i1}vứt bỏ mạng sống rồi mà...{\i0}
Dialogue: 0,0:22:15.64,0:22:18.41,Default,,0000,0000,0000,,Thiếu tá, rốt cuộc ở đây\Nđang xảy ra chuyện quái gì vậy?
Dialogue: 0,0:22:18.88,0:22:20.97,Default,,0000,0000,0000,,Cô chưa bao giờ\Nphạm sai lầm như thế này cả!
Dialogue: 0,0:22:21.18,0:22:22.31,Default,,0000,0000,0000,,Kuze không có ở đây,
Dialogue: 0,0:22:22.42,0:22:27.61,Default,,0000,0000,0000,,và chúng ta vừa mất một lính mới vào tay\Nổ phục kích của đám {\i1}tị nạn{\i0} vũ trang!
Dialogue: 0,0:22:30.12,0:22:31.22,Default,,0000,0000,0000,,Tôi xin lỗi.
Dialogue: 0,0:22:31.36,0:22:35.09,Default,,0000,0000,0000,,Ngay từ đầu Kuze\Nđã không có ở đây.
Dialogue: 0,0:22:41.23,0:22:45.36,Default,,0000,0000,0000,,Hắn đang thực hiện một thỏa thuận\Nmua plutonium với Mafia Nga.
