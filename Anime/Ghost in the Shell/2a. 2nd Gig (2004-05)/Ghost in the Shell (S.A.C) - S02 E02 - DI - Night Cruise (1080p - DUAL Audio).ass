Dialogue: 0,0:07:12.45,0:07:14.32,GitS Signs 2,,0000,0000,0000,,{\an1\fs65\fsp0\pos(333,751)}Tập\N\N Kích\N\N Tòa\N\N Nhà\N\N Chính\N\N Phủ
Dialogue: 0,0:07:14.43,0:07:14.79,GitS Signs 2,,0000,0000,0000,,{\fs55\fsp8\pos(966,851)}Trực tiếp Từ Hiện trường
Dialogue: 0,0:07:14.79,0:07:17.59,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tại hiện trường vụ tấn công,{\i0}\N{\i1}khói đen đang cuồn cuộn bốc lên,{\i0}
Dialogue: 0,0:07:17.59,0:07:20.16,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}cho thấy cuộc tập kích vào tòa nhà chính phủ{\i0}\N{\i1}do các phần tử tị nạn châu Á...{\i0}
Dialogue: 0,0:07:20.16,0:07:24.03,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...những kẻ phản đối chính sách tị nạn của chính phủ,{\i0}\N{\i1}là một cuộc tấn công có quy mô lớn.{\i0}
Dialogue: 0,0:07:24.90,0:07:26.30,Default,,0000,0000,0000,,{\i1}Bọn chúng làm ăn cẩu thả thật...{\i0}
Dialogue: 0,0:07:26.67,0:07:29.10,Default,,0000,0000,0000,,{\i1}Mấy trò này chẳng thể kết thúc{\i0}\N{\i1}được bất cứ điều gì.{\i0}
Dialogue: 0,0:07:29.70,0:07:32.10,Default,,0000,0000,0000,,{\i1}Và cũng chẳng thể bắt đầu{\i0}\N{\i1}được điều gì cả.{\i0}
Dialogue: 0,0:07:35.51,0:07:37.84,Default,,0000,0000,0000,,{\i1}Tái lập lại thế giới...{\i0}
Dialogue: 0,0:07:40.72,0:07:42.74,Default,,0000,0000,0000,,{\i1}Kẻ thù thực sự{\i0}\N{\i1}chính là đám truyền thông đại chúng.{\i0}
Dialogue: 0,0:07:43.29,0:07:47.09,Default,,0000,0000,0000,,{\i1}Chúng cấu kết tay trong với chính phủ,{\i0}\N{\i1}lớn tiếng rao giảng đạo đức giả tạo.{\i0}
Dialogue: 0,0:07:47.82,0:07:49.72,Default,,0000,0000,0000,,{\i1}Nhưng chúng đâu có biết.{\i0}
Dialogue: 0,0:07:50.23,0:07:52.85,Default,,0000,0000,0000,,{\i1}Chúng không hề biết rằng ở đây có một người{\i0}\N{\i1}thấu suốt mọi sự thật.{\i0}
Dialogue: 0,0:07:53.10,0:07:54.63,Default,,0000,0000,0000,,{\i1}Rằng người đó biết được{\i0}\N{\i1}đâu là chân lý,{\i0}
Dialogue: 0,0:07:54.63,0:07:58.09,Default,,0000,0000,0000,,{\i1}và sở hữu ý chí sắt đá không lay chuyển{\i0}\N{\i1}để sống trọn vẹn với chân lý đó.{\i0}
Dialogue: 0,0:07:59.90,0:08:02.23,Default,,0000,0000,0000,,{\i1}Bản án tử hình dành cho ông ta{\i0}\N{\i1}phải được thi hành sớm thôi.{\i0}
Dialogue: 0,0:08:02.50,0:08:05.91,Default,,0000,0000,0000,,{\i1}Đó là sứ mệnh được trao cho{\i0}\N{\i1}người nắm giữ sự thật...{\i0}
Dialogue: 0,0:08:05.91,0:08:08.54,Default,,0000,0000,0000,,{\i1}...và không hề sợ hãi cái chết{\i0}\N{\i1}trên con đường phụng sự nó.{\i0}
Dialogue: 0,0:08:18.79,0:08:23.68,Default,,0000,0000,0000,,- Này anh bạn, sao không vào chơi?\N- {\i1}Một văn hào Do Thái vĩ đại từng nói vào đầu thế kỷ trước:{\i0}
Dialogue: 0,0:08:23.79,0:08:26.33,Default,,0000,0000,0000,,{\i1}\"Sống mà không có sự thật{\i0}\N{\i1}thì không thể tồn tại.\"{\i0}
Dialogue: 0,0:08:26.33,0:08:29.32,Default,,0000,0000,0000,,{\i1}\"Sự thật có lẽ{\i0}\N{\i1}chính là bản thân sự sống.\"{\i0}
Dialogue: 0,0:08:32.80,0:08:36.76,Default,,0000,0000,0000,,{\i1}Và chính tại nơi này,{\i0}\N{\i1}\"sự sống\" đích thực đó đang hiện hữu.{\i0}
Dialogue: 0,0:08:51.65,0:08:54.62,Default,,0000,0000,0000,,{\i1}Vẻ đẹp của em là{\i0}\N{\i1}một chân lý không thể chối từ.{\i0}
Dialogue: 0,0:08:55.19,0:08:58.63,Default,,0000,0000,0000,,{\i1}Một nét đẹp không hề che giấu sự thật{\i0}\N{\i1}rằng em là một sinh linh bằng xương bằng thịt.{\i0}
Dialogue: 0,0:08:58.83,0:09:01.06,Default,,0000,0000,0000,,{\i1}Một sự thuần khiết đón nhận lạc thú{\i0}\N{\i1}vì chính bản thân nó,{\i0}
Dialogue: 0,0:09:01.06,0:09:05.59,Default,,0000,0000,0000,,{\i1}...và không sở hữu bất cứ thứ gì ngoài những điều{\i0}\N{\i1}cần thiết để duy trì sự sinh tồn.{\i0}
Dialogue: 0,0:09:05.87,0:09:08.34,Default,,0000,0000,0000,,{\i1}Một cơ thể mà chỉ cần nhìn thoáng qua{\i0}\N{\i1}là biết đã được thay thế hoàn toàn bằng máy móc.{\i0}
Dialogue: 0,0:09:08.34,0:09:10.10,Default,,0000,0000,0000,,{\i1}Một hình thể hoàn mỹ đến mức{\i0}\N{\i1}không thể phân biệt nổi...{\i0}
Dialogue: 0,0:09:10.17,0:09:12.50,Default,,0000,0000,0000,,{\i1}...với một tạo vật được sinh ra chỉ chuyên phục vụ{\i0}\N{\i1}cho việc hoan lạc.{\i0}
Dialogue: 0,0:09:12.97,0:09:15.03,Default,,0000,0000,0000,,{\i1}Đây mới chính là vẻ đẹp đích thực.{\i0}
Dialogue: 0,0:09:18.11,0:09:21.31,Default,,0000,0000,0000,,{\i1}Em là người duy nhất{\i0}\N{\i1}mà tôi chắc chắn là một con người.{\i0}
Dialogue: 0,0:09:22.38,0:09:29.09,Default,,0000,0000,0000,,{\i1}Tôi thấy ở em một điều gì đó, như thể em đang ngoan cường{\i0}\N{\i1}bảo vệ tính người của mình, hệt như tôi.{\i0}
Dialogue: 0,0:09:45.17,0:09:48.20,Default,,0000,0000,0000,,{\i1}Mọi thứ khác đều lu mờ{\i0}\N{\i1}trước tâm hồn của em.{\i0}
Dialogue: 0,0:09:48.94,0:09:52.31,Default,,0000,0000,0000,,{\i1}Ngay cả khi người ta có chiếm đoạt được thân xác em{\i0}\N{\i1}bằng sức mạnh của đồng tiền,{\i0}
Dialogue: 0,0:09:52.31,0:09:57.18,Default,,0000,0000,0000,,{\i1}họ cũng vĩnh viễn không bao giờ có được ý chí,{\i0}\N{\i1}vẻ đẹp và chân lý nơi em.{\i0}
Dialogue: 0,0:10:41.83,0:10:43.32,Default,,0000,0000,0000,,Tại sao ư?
Dialogue: 0,0:10:47.97,0:10:51.06,Default,,0000,0000,0000,,{\i1}Không một ai có thể bôi bẩn{\i0}\N{\i1}được chân lý.{\i0}
Dialogue: 0,0:10:51.81,0:10:54.08,Default,,0000,0000,0000,,{\i1}Dù cho họ có đem hết toàn bộ sức mạnh{\i0}\N{\i1}của quyền lực ra áp đặt...{\i0}
Dialogue: 0,0:10:54.08,0:10:56.54,Default,,0000,0000,0000,,{\i1}...và cố tình đùa giỡn{\i0}\N{\i1}với cảm xúc của chúng ta,{\i0}
Dialogue: 0,0:10:57.18,0:10:59.34,Default,,0000,0000,0000,,{\i1}thì vẫn luôn có một người{\i0}\N{\i1}thấu suốt sự thật.{\i0}
Dialogue: 0,0:10:59.68,0:11:02.17,Default,,0000,0000,0000,,{\i1}Và người đó chính là tôi.{\i0}\N{\i1}Chẳng có ai khác ngoài tôi cả.{\i0}
Dialogue: 0,0:11:04.39,0:11:05.48,Default,,0000,0000,0000,,{\i1}Ngày mai sẽ là thời khắc đó.{\i0}
Dialogue: 0,0:11:05.89,0:11:08.79,Default,,0000,0000,0000,,{\i1}Ngày mai, thế giới sẽ phải mở to mắt{\i0}\N{\i1}nhìn vào sự thật.{\i0}
Dialogue: 0,0:11:17.90,0:11:19.53,Default,,0000,0000,0000,,{\i1}Ngày mai rốt cuộc{\i0}\N{\i1}cũng đã đến.{\i0}
Dialogue: 0,0:11:20.47,0:11:23.37,Default,,0000,0000,0000,,Này, nếu cậu định nghỉ làm một hôm,\Nthì phải báo trước với tôi chứ!
Dialogue: 0,0:11:23.67,0:11:26.61,Default,,0000,0000,0000,,Tôi không cần biết đây là nghề chính\Nhày chỉ là việc làm thêm ngoài giờ của cậu,
Dialogue: 0,0:11:26.61,0:11:29.54,Default,,0000,0000,0000,,nhưng cậu nên biết ơn vì đã được phân công...
Dialogue: 0,0:11:29.54,0:11:33.31,Default,,0000,0000,0000,,...vào một vị trí béo bở là phi công riêng\Ncủa Chủ tịch Katakura đấy.
Dialogue: 0,0:11:34.02,0:11:38.45,Default,,0000,0000,0000,,Tôi công nhận cậu là một tay lái xuất sắc.\NThời chiến cậu từng là anh hùng mà.
Dialogue: 0,0:11:38.75,0:11:42.06,Default,,0000,0000,0000,,Nhưng cậu phải hiểu rằng thời buổi này\Nchẳng có việc làm nào...
Dialogue: 0,0:11:42.06,0:11:45.79,Default,,0000,0000,0000,,...cho đám cyborg thương binh như các cậu đâu!
Dialogue: 0,0:11:48.46,0:11:49.83,Default,,0000,0000,0000,,Cậu bị cái quái gì thế hả?
Dialogue: 0,0:11:50.27,0:11:53.06,Default,,0000,0000,0000,,Ngày xưa,\Nanh đâu có giống như thế này.
Dialogue: 0,0:11:54.10,0:11:59.10,Default,,0000,0000,0000,,Ngày xưa, anh có đủ lòng quả cảm\Nđể không bao giờ né tránh sự thật.
Dialogue: 0,0:12:00.11,0:12:06.28,Default,,0000,0000,0000,,Anh của ngày xưa sẽ không bao giờ để\Nmột kẻ như Katakura nhởn nhơ ngoài vòng pháp luật!
Dialogue: 0,0:12:06.28,0:12:08.77,Default,,0000,0000,0000,,T-Thời thế\Nthay đổi rồi.
Dialogue: 0,0:12:09.18,0:12:11.65,Default,,0000,0000,0000,,Phải làm những gì cần làm\Nđể mà tồn tại chứ!
Dialogue: 0,0:12:11.65,0:12:16.42,Default,,0000,0000,0000,,Anh đã quên lý do vì sao tôi rời quân ngũ\Nvà đến đây cùng anh rồi sao?
Dialogue: 0,0:12:21.80,0:12:23.29,Default,,0000,0000,0000,,Này, cậu có nghe tôi nói không đấy?
Dialogue: 0,0:12:23.40,0:12:24.26,Default,,0000,0000,0000,,Thưa ngài?
Dialogue: 0,0:12:25.70,0:12:29.66,Default,,0000,0000,0000,,Cậu ổn không đấy, chàng trai?\NCậu vừa lẩm bẩm cái gì thế?
Dialogue: 0,0:12:31.14,0:12:34.84,Default,,0000,0000,0000,,Không có gì đâu ạ, thưa ngài.\NThành thật xin lỗi ngài.
Dialogue: 0,0:12:38.45,0:12:40.52,Default,,0000,0000,0000,,Tôi sẽ để anh\Nxử lý vụ đó nhé.
Dialogue: 0,0:12:40.52,0:12:42.18,Default,,0000,0000,0000,,Vâng, bọn họ định...
Dialogue: 0,0:12:43.02,0:12:44.31,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:12:44.65,0:12:45.75,Default,,0000,0000,0000,,Dạ không có gì thưa ngài.
Dialogue: 0,0:12:45.75,0:12:50.05,Default,,0000,0000,0000,,Tôi xin lỗi về ngày hôm qua.\NTôi đã tự ý nghỉ mà không xin phép.
Dialogue: 0,0:12:50.43,0:12:51.73,Default,,0000,0000,0000,,Hôm qua sao?
Dialogue: 0,0:12:51.73,0:12:53.93,Default,,0000,0000,0000,,Tôi rất xin lỗi nếu đã làm phiền\Nđến công việc của ngài.
Dialogue: 0,0:12:53.93,0:12:56.23,Default,,0000,0000,0000,,Ồ... Cậu nghỉ à?
Dialogue: 0,0:12:57.53,0:13:01.20,Default,,0000,0000,0000,,Tôi đây. Xin lỗi nhé.\NKhông, chẳng có gì đâu. Vậy nên...
Dialogue: 0,0:13:07.11,0:13:09.47,Default,,0000,0000,0000,,Khốn kiếp! Chết tiệt thật!
Dialogue: 0,0:13:15.78,0:13:20.16,Default,,0000,0000,0000,,Lão ta cần đến năng lực của mình, thế mà\Ncái gã khốn nạn đó lại giả vờ như quên mất!
Dialogue: 0,0:13:20.16,0:13:21.86,Default,,0000,0000,0000,,Đồ khốn biến thái tàn bạo!
Dialogue: 0,0:13:21.86,0:13:25.22,Default,,0000,0000,0000,,Mình vừa tỏ ra nhã nhặn một chút,\Nlà lão ta đã dẫm đạp lên mình ngay!
Dialogue: 0,0:13:25.53,0:13:28.66,Default,,0000,0000,0000,,Chỉ cần bẻ lái một đường thôi,\Nlà mình có thể...
Dialogue: 0,0:13:46.11,0:13:48.91,Default,,0000,0000,0000,,{\i1}Lương tâm của tôi{\i0}\N{\i1}hoàn toàn trong sạch.{\i0}
Dialogue: 0,0:13:49.75,0:13:53.65,Default,,0000,0000,0000,,{\i1}Tôi chẳng tiếc mạng sống của mình{\i0}\N{\i1}vì đám quần chúng đáng thương kia.{\i0}
Dialogue: 0,0:13:53.96,0:13:58.43,Default,,0000,0000,0000,,{\i1}Nhưng ngay cả khi tôi có tận diệt{\i0}\N{\i1}Katakura khỏi cõi đời này,{\i0}
Dialogue: 0,0:13:58.43,0:14:02.89,Default,,0000,0000,0000,,{\i1}thì rất có thể vụ việc cũng sẽ bị che đậy{\i0}\N{\i1}bởi mạng lưới thông tin của bọn họ.{\i0}
Dialogue: 0,0:14:04.07,0:14:08.50,Default,,0000,0000,0000,,{\i1}Nếu điều đó xảy ra, thế giới này{\i0}\N{\i1}sẽ vĩnh viễn không bao giờ biết được sự thật.{\i0}
Dialogue: 0,0:14:08.80,0:14:13.43,Default,,0000,0000,0000,,{\i1}Để đảm bảo chuyện đó không diễn ra,{\i0}\N{\i1}tôi cần phải nói sự thật cho một người khác biết.{\i0}
Dialogue: 0,0:14:17.48,0:14:19.71,Default,,0000,0000,0000,,Bà vợ già nhà tôi chẳng thèm hé răng\Nnói với tôi nửa lời nữa rồi.
Dialogue: 0,0:14:19.71,0:14:24.15,Default,,0000,0000,0000,,Tệ thật đấy. Cậu phải đối xử thật ngọt ngào\Nthì bả mới nguôi giận chứ!
Dialogue: 0,0:14:27.26,0:14:28.56,Default,,0000,0000,0000,,Này, có chuyện gì thế?
Dialogue: 0,0:14:28.56,0:14:30.82,Default,,0000,0000,0000,,Đi làm một chầu\Nnhậu không anh?
Dialogue: 0,0:14:31.23,0:14:34.92,Default,,0000,0000,0000,,Ghé cái quán có món hàu\Nmà anh kể dạo trước ấy?
Dialogue: 0,0:14:35.13,0:14:37.89,Default,,0000,0000,0000,,Hôm nay hiếm thấy thật đấy.\NCó chuyện gì xảy ra à?
Dialogue: 0,0:14:38.10,0:14:44.70,Default,,0000,0000,0000,,Dạ không... Chẳng qua là sắp tới chắc tôi phải nghỉ việc ở đây\Nvì công việc chính rồi.
Dialogue: 0,0:14:44.94,0:14:45.77,Default,,0000,0000,0000,,Nên tôi nghĩ chúng ta...
Dialogue: 0,0:14:45.77,0:14:49.51,Default,,0000,0000,0000,,Ồ, cậu sắp thăng tiến đổi đời rồi hả?\NGhen tị thật đấy nhé.
Dialogue: 0,0:14:49.51,0:14:51.78,Default,,0000,0000,0000,,Không, không phải thế đâu anh.
Dialogue: 0,0:14:52.11,0:14:56.11,Default,,0000,0000,0000,,À, nếu vì lý do đó thì nhất định\Ntôi phải đi uống với cậu một bữa rồi.
Dialogue: 0,0:14:56.55,0:14:58.25,Default,,0000,0000,0000,,Nhưng hôm nay thì\Ntôi bận mất rồi.
Dialogue: 0,0:14:58.62,0:15:00.92,Default,,0000,0000,0000,,Không sao đâu anh.\NKhông phiền gì đâu.
Dialogue: 0,0:15:03.19,0:15:04.92,Default,,0000,0000,0000,,Cố gắng lên nhé.
Dialogue: 0,0:15:12.80,0:15:16.47,Default,,0000,0000,0000,,{\i1}Tôi bị lùa đi chiến đấu vì một lý do{\i0}\N{\i1}hoàn toàn xa rời với sự sinh tồn của chính mình.{\i0}
Dialogue: 0,0:15:16.47,0:15:19.87,Default,,0000,0000,0000,,{\i1}Đó đơn thuần chỉ là để bảo vệ quyền lực{\i0}\N{\i1}cho một số phe phái nhất định.{\i0}
Dialogue: 0,0:15:20.28,0:15:23.80,Default,,0000,0000,0000,,{\i1}Không một ai có thể thấu hiểu được mức độ to lớn{\i0}\N{\i1}của những mất mát mà tôi đã gánh chịu nơi chiến trường.{\i0}
Dialogue: 0,0:15:39.59,0:15:41.12,Default,,0000,0000,0000,,Anh cần mua gì\Nđúng không?
Dialogue: 0,0:15:44.93,0:15:47.42,Default,,0000,0000,0000,,T-Tôi muốn chuộc em ấy\Nbằng số tiền này.
Dialogue: 0,0:15:48.44,0:15:49.70,Default,,0000,0000,0000,,Chừng này không đủ đâu.
Dialogue: 0,0:15:50.51,0:15:54.03,Default,,0000,0000,0000,,Mớ tiền lẻ còm cõi này\Nchẳng bõ bèn {\i1}gì đâu{\i0}.
Dialogue: 0,0:15:56.31,0:15:57.94,Default,,0000,0000,0000,,Đâu chỉ có mỗi mình anh.
Dialogue: 0,0:15:59.11,0:16:03.57,Default,,0000,0000,0000,,Anh không phải người duy nhất đánh mất\Nnhững điều quý giá trong chiến tranh đâu.
Dialogue: 0,0:16:12.13,0:16:13.80,Default,,0000,0000,0000,,Được rồi, xong xuôi hết rồi đấy.
Dialogue: 0,0:16:13.80,0:16:17.23,Default,,0000,0000,0000,,Hả? Nhưng chúng ta còn chưa kịp\N{\i1}làm{\i0} gì cơ mà!
Dialogue: 0,0:16:18.07,0:16:20.50,Default,,0000,0000,0000,,Muốn tiến xa hơn\Nthì phải trả thêm tiền.
Dialogue: 0,0:16:21.04,0:16:22.50,Default,,0000,0000,0000,,Vả lại...
Dialogue: 0,0:16:26.74,0:16:30.04,Default,,0000,0000,0000,,Gì cơ? Tôi thậm chí đã trả trước\Nnhư một phần phí thành viên rồi mà!
Dialogue: 0,0:16:30.58,0:16:32.41,Default,,0000,0000,0000,,Này, Đại ca!
Dialogue: 0,0:16:47.30,0:16:48.80,Default,,0000,0000,0000,,L-Làm ơn,\Ntha cho tôi!
Dialogue: 0,0:16:48.80,0:16:51.79,Default,,0000,0000,0000,,Nếu các người lấy thứ đó đi,\Nvợ con tôi...
Dialogue: 0,0:16:53.27,0:17:00.41,Default,,0000,0000,0000,,V-Vợ con tôi\Nsẽ chết đói mất!
Dialogue: 0,0:17:00.41,0:17:01.84,Default,,0000,0000,0000,,Pằng!
Dialogue: 0,0:17:28.54,0:17:31.17,Default,,0000,0000,0000,,{\i1}Xin kính chào quý khách, đây là{\i0}\N{\i1}Quỹ Cứu trợ Người tị nạn.{\i0}
Dialogue: 0,0:17:31.17,0:17:35.28,Default,,0000,0000,0000,,Xin lỗi đã làm phiền. Tôi từng đăng ký quyên góp cho quỹ, và tôi...
Dialogue: 0,0:17:35.28,0:17:37.38,Default,,0000,0000,0000,,{\i1}Chân thành cảm ơn sự ủng hộ{\i0}\N{\i1}của quý khách.{\i0}
Dialogue: 0,0:17:37.75,0:17:42.45,Default,,0000,0000,0000,,À, tôi có chút việc đột xuất, nên muốn hỏi xem\Nliệu tôi có thể dừng trích nợ tự động từ tài khoản được không.
Dialogue: 0,0:17:43.89,0:17:44.95,Default,,0000,0000,0000,,Alo, xin chào?
Dialogue: 0,0:17:44.95,0:17:50.48,Default,,0000,0000,0000,,{\i1}Thành thật xin lỗi, hệ thống không thể{\i0}\N{\i1}hiểu được yêu cầu của quý khách.{\i0}
Dialogue: 0,0:17:51.23,0:17:56.03,Default,,0000,0000,0000,,Alo? Tôi muốn dừng việc trừ tiền! Tôi muốn hủy đăng ký!
Dialogue: 0,0:17:56.03,0:17:59.66,Default,,0000,0000,0000,,{\i1}Trong trường hợp đó, tôi sẽ hướng dẫn quý khách{\i0}\N{\i1}quy trình đăng ký lại từ đầu.{\i0}
Dialogue: 0,0:18:00.17,0:18:04.07,Default,,0000,0000,0000,,{\i1}Để được giải đáp thắc mắc về quỹ cứu trợ,{\i0}\N{\i1}vui lòng bấm phím 1.{\i0}
Dialogue: 0,0:18:04.64,0:18:07.27,Default,,0000,0000,0000,,{\i1}Đối với các câu hỏi khác,{\i0}\N{\i1}vui lòng bấm phím 2.{\i0}
Dialogue: 0,0:18:09.64,0:18:11.87,Default,,0000,0000,0000,,Đã lâu lắm rồi họ mới có\Nmột trận thắng dễ dàng như vậy!
Dialogue: 0,0:18:12.45,0:18:14.71,Default,,0000,0000,0000,,Ồ, ý anh là\Ntrận giao hữu ngôi sao hả?
Dialogue: 0,0:18:15.58,0:18:18.95,Default,,0000,0000,0000,,Đường tạt bóng từ cánh phải\Nđỉnh thật đấy!
Dialogue: 0,0:18:18.95,0:18:20.48,Default,,0000,0000,0000,,Làm tôi sởn cả gai ốc!
Dialogue: 0,0:18:22.76,0:18:25.46,Default,,0000,0000,0000,,{\i1}Tại sao họ lại muốn ăn chứ?{\i0}\N{\i1}Rõ ràng họ đâu có nhu cầu...{\i0}
Dialogue: 0,0:18:23.66,0:18:25.46,Top Secondary Dialog 1080P,,0000,0000,0000,,Cú đánh đầu đó đẹp mắt thật!
Dialogue: 0,0:18:26.13,0:18:28.42,Default,,0000,0000,0000,,{\i1}Tại sao họ lại muốn ăn cơ chứ?!{\i0}\N{\i1}Rõ ràng họ đâu cần thiết!{\i0}
Dialogue: 0,0:18:26.73,0:18:28.42,Top Secondary Dialog 1080P,,0000,0000,0000,,Hàng thủ của họ thi đấu thiếu nhiệt huyết quá.
Dialogue: 0,0:18:35.14,0:18:37.47,Default,,0000,0000,0000,,{\i1}Tại sao?! Tại sao?!{\i0}\N{\i1}Tại sao cơ chứ?!{\i0}
Dialogue: 0,0:18:37.84,0:18:39.34,Default,,0000,0000,0000,,{\i1}Tại sao họ lại{\i0}\N{\i1}muốn ăn?!{\i0}
Dialogue: 0,0:18:39.34,0:18:42.54,Default,,0000,0000,0000,,{\i1}Đây đâu phải là bản năng!{\i0}\N{\i1}Đây đâu phải là sự thật!{\i0}
Dialogue: 0,0:18:44.98,0:18:46.88,Default,,0000,0000,0000,,Tôi đã rất ngạc nhiên đấy,\Nphải nói thật với cậu như vậy.
Dialogue: 0,0:18:47.35,0:18:48.18,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:18:48.18,0:18:50.35,Default,,0000,0000,0000,,Tôi không thể tin nổi là hắn ta lại bị\Nbên An ninh Công cộng tóm cổ.
Dialogue: 0,0:18:50.35,0:18:51.99,Default,,0000,0000,0000,,Chắc chắn là vậy rồi.
Dialogue: 0,0:18:51.99,0:18:55.29,Default,,0000,0000,0000,,Cậu nghĩ hắn có biết không?\NÝ tôi là chuyện hắn là người châu Á ấy.
Dialogue: 0,0:18:55.29,0:18:56.36,Default,,0000,0000,0000,,Ai cơ?
Dialogue: 0,0:18:56.36,0:18:58.93,Default,,0000,0000,0000,,Gino. Hai người họ\Nkhá thân nhau mà, đúng không?
Dialogue: 0,0:18:58.93,0:18:59.95,Default,,0000,0000,0000,,À, hắn ta á.
Dialogue: 0,0:19:00.43,0:19:02.50,Default,,0000,0000,0000,,Không đời nào, cái gã ngốc nghếch đó\Nchẳng bao giờ mảy may nghi ngờ đâu!
Dialogue: 0,0:19:02.50,0:19:03.73,Default,,0000,0000,0000,,Tôi cũng nghĩ vậy.
Dialogue: 0,0:19:03.73,0:19:04.86,Default,,0000,0000,0000,,Ừ, đúng rồi!
Dialogue: 0,0:19:06.90,0:19:10.96,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Thủ phạm vụ tấn công tòa nhà chính phủ{\i0}\N{\i1}là một người tị nạn châu Á đã bị bắt giữ.{\i0}
Dialogue: 0,0:19:11.31,0:19:14.23,GitS Signs 3,,0000,0000,0000,,{\fs60\pos(678,813)}Nghi phạm
Dialogue: 0,0:19:11.31,0:19:14.23,GitS Signs 3,,0000,0000,0000,,{\fs70\pos(1040,891)}Misawa Youichi (43 tuổi)
Dialogue: 0,0:19:11.91,0:19:14.24,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Yoichi Misawa.{\i0}\N{\i1}Còn gọi là Dương Mẫn Đức.{\i0}
Dialogue: 0,0:19:15.28,0:19:18.68,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Hiện hắn đang được dẫn giải ra ngoài,{\i0}\N{\i1}với cảnh sát áp giải hai bên.{\i0}
Dialogue: 0,0:19:22.82,0:19:25.51,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Phải chăng thái độ nghênh ngang này có nghĩa là{\i0}\N{\i1}hắn ta nắm chắc phần thắng trong tay?{\i0}
Dialogue: 0,0:19:26.02,0:19:29.68,Default,,0000,0000,0000,,Làm sao có thể là anh ta được chứ?
Dialogue: 0,0:19:30.32,0:19:34.78,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Trước vụ bắt giữ này, các cuộc họp báo chưa từng có tiền lệ{\i0}\N{\i1}đã được triệu tập khẩn cấp...{\i0}
Dialogue: 0,0:19:34.96,0:19:36.76,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...bởi ba hiệp hội cứu trợ{\i0}\N{\i1}người tị nạn châu Á,{\i0}
Dialogue: 0,0:19:36.76,0:19:39.63,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}cùng với Hội Bảo đảm Nhân quyền{\i0}\N{\i1}cho Người tị nạn châu Á.{\i0}
Dialogue: 0,0:19:40.03,0:19:46.10,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Họ tuyên bố rằng hành động của hắn có những tình tiết giảm nhẹ,{\i0}\N{\i1}khi họ lên tiếng...{\i0}
Dialogue: 0,0:19:46.41,0:19:50.18,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...về sự phân biệt đối xử mà người tị nạn châu Á và Nhật Bản{\i0}\N{\i1}phải chịu đựng hàng ngày.{\i0}
Dialogue: 0,0:19:50.18,0:19:53.71,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Họ thông báo sẽ chính thức{\i0}\N{\i1}yêu cầu giảm nhẹ bản án.{\i0}
Dialogue: 0,0:20:01.19,0:20:03.32,Default,,0000,0000,0000,,Cho người này\Nquá giang về nhà đi.
Dialogue: 0,0:20:30.32,0:20:31.81,Default,,0000,0000,0000,,Có chuyện gì vậy?
Dialogue: 0,0:20:33.72,0:20:37.09,Default,,0000,0000,0000,,Ông ta đã làm gì...\NKatakura đã làm gì em?
Dialogue: 0,0:20:37.59,0:20:39.08,Default,,0000,0000,0000,,Đó là công việc của tôi.
Dialogue: 0,0:20:41.80,0:20:44.36,Default,,0000,0000,0000,,Anh... vẫn luôn tìm kiếm em.
Dialogue: 0,0:20:44.57,0:20:46.76,Default,,0000,0000,0000,,Mấy ngày qua anh đã không ngừng tìm em.
Dialogue: 0,0:20:47.27,0:20:50.17,Default,,0000,0000,0000,,Không, từ rất lâu trước khi\Nanh được sinh ra trên đời này.
Dialogue: 0,0:20:50.67,0:20:52.07,Default,,0000,0000,0000,,Em cũng vậy.
Dialogue: 0,0:20:53.64,0:20:56.20,Default,,0000,0000,0000,,Anh sẽ không để em\Nphải chịu đau khổ thêm nữa.
Dialogue: 0,0:20:56.74,0:20:59.54,Default,,0000,0000,0000,,Hãy cứ bay mãi thế này\Nvà đi thật xa nhé.
Dialogue: 0,0:20:59.81,0:21:03.48,Default,,0000,0000,0000,,Đến một vùng đất chỉ có hai chúng ta,\Nnơi không ai có thể quấy rầy được nữa.
Dialogue: 0,0:21:04.15,0:21:08.25,Default,,0000,0000,0000,,Nhưng có một việc\Nanh phải làm trước lúc đó.
Dialogue: 0,0:21:09.29,0:21:10.95,Default,,0000,0000,0000,,Anh định\Nlàm gì?
Dialogue: 0,0:21:11.66,0:21:15.46,Default,,0000,0000,0000,,Anh phải giải phóng\Ncho sự thật.
Dialogue: 0,0:21:16.03,0:21:18.16,Default,,0000,0000,0000,,Anh sẽ đưa em\Nđi cùng chứ?
Dialogue: 0,0:21:34.35,0:21:37.01,Default,,0000,0000,0000,,Anh đã chiến đấu\Nquá đủ rồi.
Dialogue: 0,0:21:39.52,0:21:41.82,Default,,0000,0000,0000,,Anh đã chiến thắng rồi.
Dialogue: 0,0:21:44.56,0:21:48.19,Default,,0000,0000,0000,,Giá như... điều đó là sự thật.
Dialogue: 0,0:21:56.10,0:21:58.97,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi vừa nhận được tin{\i0}\N{\i1}từ Ishikawa.{\i0}
Dialogue: 0,0:21:58.97,0:22:02.24,Default,,0000,0000,0000,,{\i1}Anh ấy bảo chẳng có mối liên hệ nào kết nối gã này{\i0}\N{\i1}với chuỗi vụ án khủng bố cả.{\i0}
Dialogue: 0,0:22:02.74,0:22:06.74,Default,,0000,0000,0000,,{\i1}Hồ sơ quân ngũ cũng ghi rõ việc hắn mất nửa thân dưới{\i0}\N{\i1}hoàn toàn không liên quan đến tác chiến quân sự.{\i0}
Dialogue: 0,0:22:07.38,0:22:10.21,Default,,0000,0000,0000,,{\i1}Hóa ra là hắn dính phải một căn bệnh tình dục quái ác{\i0}\N{\i1}trong thời gian đóng quân.{\i0}
Dialogue: 0,0:22:11.39,0:22:13.32,Default,,0000,0000,0000,,{\i1}Này Thiếu tá?{\i0}\N{\i1}Cô có nghe không đấy?{\i0}
Dialogue: 0,0:22:13.32,0:22:18.38,Default,,0000,0000,0000,,{\i1}Tôi nghe rồi. Kế hoạch ám sát mà hắn vẽ ra{\i0}\N{\i1}chỉ thuần túy là ảo tưởng của bản thân mà thôi.{\i0}
Dialogue: 0,0:22:20.66,0:22:22.23,Default,,0000,0000,0000,,{\i1}Vậy cô định{\i0}\N{\i1}xử lý hắn thế nào?{\i0}
Dialogue: 0,0:22:22.23,0:22:23.96,Default,,0000,0000,0000,,{\i1}Đừng bận tâm{\i0}\N{\i1}về chuyện đó.{\i0}
Dialogue: 0,0:22:26.50,0:22:30.17,Default,,0000,0000,0000,,{\i1}Anh ta cũng chỉ là một trong vô số những con người...{\i0}
Dialogue: 0,0:22:30.17,0:22:32.57,Default,,0000,0000,0000,,{\i1}...luôn ôm ấp những hy vọng mong manh{\i0}\N{\i1}cùng nỗi thất vọng tràn trề trước thực tại mà thôi.{\i0}
Dialogue: 0,0:22:32.94,0:22:35.34,Default,,0000,0000,0000,,{\i1}Anh ta sẽ chẳng bao giờ thực hiện{\i0}\N{\i1}kế hoạch đó đâu.{\i0}
Dialogue: 0,0:22:36.24,0:22:39.68,Default,,0000,0000,0000,,Ừm, tôi c-có thể chở cô\Nđi đâu được đây?
Dialogue: 0,0:22:47.69,0:22:51.75,Default,,0000,0000,0000,,{\i1}Anh ta là một thành viên của giai cấp vô sản,{\i0}\N{\i1}đáng thương đến mức chẳng hề nhận thức được thực tại...{\i0}
Dialogue: 0,0:22:51.75,0:22:53.75,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:55.66,0:24:01.47,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:01.47,0:24:04.17,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:04.17,0:24:08.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
