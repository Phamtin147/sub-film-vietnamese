Dialogue: 0,0:05:39.29,0:05:48.76,GitS Signs White,,0000,0000,0000,,{\pos(944,967)}Tuyên bố Nhận trách nhiệm Vụ Đánh bom Khu Tị nạn
Dialogue: 0,0:05:39.83,0:05:44.50,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Theo thông cáo, nhóm này yêu cầu trục xuất{\i0}\N{\i1}toàn bộ người tị nạn gốc Á,{\i0}
Dialogue: 0,0:05:44.50,0:05:49.44,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...và mô tả tội ác này là hành động trả đũa{\i0}\N{\i1}cho thứ mà chúng coi là sự sụp đổ tài chính...{\i0}
Dialogue: 0,0:05:49.44,0:05:52.57,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...bắt nguồn từ các cuộc bạo loạn của người tị nạn châu Á{\i0}\N{\i1}cùng các chính sách cứu trợ tị nạn.{\i0}
Dialogue: 0,0:05:53.94,0:05:55.34,Default,,0000,0000,0000,,Chỉ là đòn gió lừa phỉnh thôi.
Dialogue: 0,0:05:56.04,0:05:59.57,Default,,0000,0000,0000,,{\i1}Đám truyền thông đại chúng chỉ biết nuốt trọn{\i0}\N{\i1}mọi lời lẽ mà giới chức cầm quyền đưa ra.{\i0}
Dialogue: 0,0:06:00.02,0:06:03.61,Default,,0000,0000,0000,,{\i1}Chúng biết thừa đó là đòn bịp, nhưng vẫn thao túng{\i0}\N{\i1}thông tin để trục lợi tối đa.{\i0}
Dialogue: 0,0:06:05.02,0:06:07.11,Default,,0000,0000,0000,,{\i1}Đó là cách thức hoạt động{\i0}\N{\i1}của bọn chúng.{\i0}
Dialogue: 0,0:06:12.59,0:06:16.73,Default,,0000,0000,0000,,{\i1}Nếu muốn biết truyền thông thực sự thèm muốn điều gì{\i0}\N{\i1}và chúng đang mưu toan làm gì,{\i0}
Dialogue: 0,0:06:16.73,0:06:19.90,Default,,0000,0000,0000,,{\i1}...thì chỉ cần nhìn vào{\i0}\N{\i1}những gì chúng làm về đêm.{\i0}
Dialogue: 0,0:06:20.40,0:06:24.43,Default,,0000,0000,0000,,{\i1}Đánh mất năng lực nhìn nhận một cách khách quan{\i0}\N{\i1}về lối sống trụy lạc của chính mình,{\i0}
Dialogue: 0,0:06:24.77,0:06:28.30,Default,,0000,0000,0000,,{\i1}chúng chẳng làm gì khác ngoài việc liên tục giễu cợt{\i0}\N{\i1}đám quần chúng ngu muội.{\i0}
Dialogue: 0,0:06:41.49,0:06:44.48,Default,,0000,0000,0000,,{\i1}Điều đó được thể hiện quá rõ qua cái cách Katakura,{\i0}\N{\i1}chủ tịch của Ba Đài truyền hình lớn,{\i0}
Dialogue: 0,0:06:44.76,0:06:49.09,Default,,0000,0000,0000,,{\i1}bới móc và chỉ trích những người{\i0}\N{\i1}thường xuyên ăn uống tại các nhà hàng sang trọng.{\i0}
Dialogue: 0,0:06:49.66,0:06:52.66,Default,,0000,0000,0000,,{\i1}Hiển nhiên trong số đó bao gồm cả tầng lớp đại diện các đảng phái,{\i0}
Dialogue: 0,0:06:52.87,0:06:55.07,Default,,0000,0000,0000,,{\i1}mà còn có cả các giám đốc điều hành của các tập đoàn đa quốc gia,{\i0}\N{\i1}những kẻ nắm giữ bản quyền sáng chế...{\i0}
Dialogue: 0,0:06:55.07,0:06:58.94,Default,,0000,0000,0000,,{\i1}...về não điện tử và cơ thể giả của các quan chức cấp cao{\i0}\N{\i1}trong mọi bộ ngành và cơ quan chính phủ.{\i0}
Dialogue: 0,0:06:59.37,0:07:02.17,Default,,0000,0000,0000,,{\i1}Katakura chưa từng có đủ dũng khí{\i0}\N{\i1}để đưa tin về sự thật.{\i0}
Dialogue: 0,0:07:02.58,0:07:07.45,Default,,0000,0000,0000,,{\i1}Tất cả những gì ông ta thèm khát chỉ là duy trì{\i0}\N{\i1}đế chế quyền lực cá nhân của mình mà thôi.{\i0}
