Dialogue: 0,0:02:05.91,0:02:09.65,Default,,0000,0000,0000,,Rốt cuộc, bất kể sự thật có là gì đi chăng nữa,
Dialogue: 0,0:02:12.22,0:02:15.62,Default,,0000,0000,0000,,thì cũng đúng là chúng ta từng tìm kiếm\Nmột cơ hội để chuộc lại lỗi lầm.
Dialogue: 0,0:02:16.02,0:02:18.08,Default,,0000,0000,0000,,Ý tôi là, với các nước\Nchâu Á.
Dialogue: 0,0:02:18.46,0:02:21.33,Default,,0000,0000,0000,,Điều đó có lẽ đặc biệt đúng\Nvới những người từng tiếp nhận...
Dialogue: 0,0:02:21.73,0:02:23.72,Default,,0000,0000,0000,,...nền giáo dục thời hậu chiến\Nở thế kỷ trước.
Dialogue: 0,0:02:24.17,0:02:27.94,Default,,0000,0000,0000,,Bằng việc tham chiến toàn diện trong Chiến tranh Việt Nam lần 2\Nngay cả khi chỉ là kẻ đứng ngoài...
Dialogue: 0,0:02:27.94,0:02:31.10,Default,,0000,0000,0000,,...trong cuộc chiến giữa\Nchâu Á và châu Âu.
Dialogue: 0,0:02:31.51,0:02:35.00,Default,,0000,0000,0000,,Và thông qua những con số\Ntrong quỹ cứu trợ này.
Dialogue: 0,0:02:35.84,0:02:37.31,Default,,0000,0000,0000,,Tôi ổn mà.
Dialogue: 0,0:02:37.68,0:02:39.98,Default,,0000,0000,0000,,Cứ coi như nộp thuế\Nđi là được.
Dialogue: 0,0:02:40.28,0:02:42.48,Default,,0000,0000,0000,,Tôi chịu thua ngài rồi đấy,\Nthưa Chủ tịch.
Dialogue: 0,0:02:56.17,0:02:57.76,Default,,0000,0000,0000,,C-Các người là...
Dialogue: 0,0:03:11.18,0:03:13.44,Default,,0000,0000,0000,,Đ-Đừng làm thế, Gino!
Dialogue: 0,0:03:14.92,0:03:17.32,Default,,0000,0000,0000,,T-Tha cho tôi!
Dialogue: 0,0:03:17.32,0:03:20.02,Default,,0000,0000,0000,,L-Làm ơn, tôi cầu xin cậu!
Dialogue: 0,0:03:22.09,0:03:23.49,Default,,0000,0000,0000,,Gino!
Dialogue: 0,0:03:24.63,0:03:26.18,Default,,0000,0000,0000,,Gino?
Dialogue: 0,0:03:26.70,0:03:27.96,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:03:28.60,0:03:32.66,Default,,0000,0000,0000,,Gino, có chuyện gì à?\NChuyến bay hơi chòng chành đấy.
Dialogue: 0,0:03:34.60,0:03:37.33,Default,,0000,0000,0000,,Tôi xin lỗi về chuyện đó,\Nthưa Chủ tịch.
Dialogue: 0,0:03:52.82,0:03:55.92,Default,,0000,0000,0000,,Này, ghé quán ăn hàu mà bữa trước tôi kể với cậu\Nlàm một bữa nhé?
Dialogue: 0,0:03:55.92,0:03:57.29,Default,,0000,0000,0000,,Hàng hảo hạng đấy.
Dialogue: 0,0:03:57.49,0:03:59.46,Default,,0000,0000,0000,,Được thôi ạ, nhưng hôm nay thì không tiện rồi.
Dialogue: 0,0:03:59.46,0:04:03.42,Default,,0000,0000,0000,,Ồ, vì công việc chính của cậu à?\NDạo này chắc cậu kiếm bộn tiền lắm nhỉ.
Dialogue: 0,0:04:07.74,0:04:09.14,Default,,0000,0000,0000,,{\i1}Tôi thấy tội nghiệp cho ông ta.{\i0}
Dialogue: 0,0:04:09.64,0:04:12.57,Default,,0000,0000,0000,,{\i1}Những cyborg dùng nội tạng nhân tạo{\i0}\N{\i1}đâu có nhu cầu ăn uống.{\i0}
Dialogue: 0,0:04:12.98,0:04:16.17,Default,,0000,0000,0000,,{\i1}Huống hồ các cơ quan cảm giác của ông ta{\i0}\N{\i1}giờ đây đã được số hóa hoàn toàn,{\i0}
Dialogue: 0,0:04:16.25,0:04:20.38,Default,,0000,0000,0000,,{\i1}thì việc thưởng thức đồ ăn ngon{\i0}\N{\i1}chẳng qua cũng chỉ là một sự hoài niệm.{\i0}
Dialogue: 0,0:04:30.99,0:04:34.72,Default,,0000,0000,0000,,Có chuyện gì thế, bên An ninh Công cộng\Nlại sờ gáy cậu nữa à?
Dialogue: 0,0:04:35.30,0:04:36.49,Default,,0000,0000,0000,,Không...
Dialogue: 0,0:04:38.63,0:04:41.10,GitS Form,,0000,0000,0000,,{\fs30\pos(225,427)\frz51.422}Phiếu Đăng Ký Trích Nợ Tự Động Quỹ Cứu Trợ Người Tị Nạn
Dialogue: 0,0:04:40.44,0:04:42.04,Default,,0000,0000,0000,,Cậu đang nói về\NNakamatsu hả?
Dialogue: 0,0:04:42.04,0:04:42.91,Default,,0000,0000,0000,,Ừ, đúng rồi!
Dialogue: 0,0:04:42.91,0:04:44.47,Default,,0000,0000,0000,,Tôi nghe nói cậu ta\Nlại bị đá {\i1}nữa rồi!{\i0}
Dialogue: 0,0:04:44.47,0:04:46.17,Default,,0000,0000,0000,,{\i1}Thực phẩm chuyên dụng cho cyborg...{\i0}
Dialogue: 0,0:04:46.38,0:04:48.74,Default,,0000,0000,0000,,{\i1}Nghĩ kỹ thì,{\i0}\N{\i1}họ cũng chỉ là nạn nhân mà thôi.{\i0}
Dialogue: 0,0:04:49.01,0:04:52.54,Default,,0000,0000,0000,,{\i1}Họ từng bị triệu tập tham chiến trong Thế chiến IV phi hạt nhân,{\i0}\N{\i1}cái gọi là Chiến tranh Việt Nam lần 2,{\i0}
Dialogue: 0,0:04:52.98,0:04:54.98,Default,,0000,0000,0000,,{\i1}và theo quy chế chiến dịch,{\i0}\N{\i1}họ được cấp phát...{\i0}
Dialogue: 0,0:04:54.98,0:04:56.97,Default,,0000,0000,0000,,{\i1}...não điện tử hiệu năng cao{\i0}\N{\i1}cùng các bộ phận cơ thể giả bán phần.{\i0}
Dialogue: 0,0:04:57.22,0:05:00.81,Default,,0000,0000,0000,,{\i1}Người ta thường bảo chiến tranh là hội chợ thương mại{\i0}\N{\i1}của các tập đoàn đa quốc gia.{\i0}
Dialogue: 0,0:05:01.39,0:05:05.59,Default,,0000,0000,0000,,{\i1}Một bãi thử nghiệm nơi công nghệ điện tử hóa não bộ và{\i0}\N{\i1}cơ thể nhân tạo phát triển vượt bậc như vũ bão.{\i0}
Dialogue: 0,0:05:05.79,0:05:08.49,Default,,0000,0000,0000,,{\i1}Đó mới thực sự là bản chất{\i0}\N{\i1}của cuộc chiến vừa qua.{\i0}
Dialogue: 0,0:05:08.53,0:05:11.19,Default,,0000,0000,0000,,{\i1}Không hề hay biết rằng{\i0}\N{\i1}mình chỉ là những vật thí nghiệm,{\i0}
Dialogue: 0,0:05:11.40,0:05:15.37,Default,,0000,0000,0000,,{\i1}họ đã đánh mất thân xác, gia đình,{\i0}\N{\i1}và thậm chí cả quê hương...{\i0}
Dialogue: 0,0:05:15.37,0:05:18.91,Default,,0000,0000,0000,,{\i1}...để rồi bấu víu vào những đồng trợ cấp ít ỏi{\i0}\N{\i1}và công việc được bố thí cho họ.{\i0}
Dialogue: 0,0:05:18.91,0:05:21.74,Default,,0000,0000,0000,,{\i1}Thoạt nhìn trông họ{\i0}\N{\i1}như thể rất hạnh phúc.{\i0}
Dialogue: 0,0:05:22.28,0:05:26.42,Default,,0000,0000,0000,,{\i1}Họ thậm chí còn chẳng biết đó chỉ là khoái cảm giả tạo{\i0}\N{\i1}tạo ra bởi một nhân cách ảo...{\i0}
Dialogue: 0,0:05:26.42,0:05:29.11,Default,,0000,0000,0000,,{\i1}...được cấu thành từ não điện tử{\i0}\N{\i1}và thân thể nhân tạo.{\i0}
Dialogue: 0,0:05:29.89,0:05:32.82,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Sở Chỉ huy Điều tra Liên ngành Cảnh sát Đô thị{\i0}\N{\i1}vừa đưa ra thông báo rằng họ...{\i0}
Dialogue: 0,0:05:32.82,0:05:37.29,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...đã nhận được tuyên bố nhận trách nhiệm về chuỗi vụ đánh bom{\i0}\N{\i1}tại các khu lưu trú của người tị nạn...{\i0}
