Dialogue: 0,0:01:35.20,0:01:38.50,Default,,0000,0000,0000,,Báo cáo từ các lực lượng Quân Phòng vệ\Ntham gia vào chiến dịch xử lý bom...
Dialogue: 0,0:01:38.60,0:01:41.40,Default,,0000,0000,0000,,...tại Tháp Phát thanh Kyushu\Nđến đây là kết thúc.
Dialogue: 0,0:01:42.34,0:01:44.36,Default,,0000,0000,0000,,Việc này đã giải quyết xong\Nvấn đề chưa?
Dialogue: 0,0:01:45.08,0:01:49.15,Default,,0000,0000,0000,,Chuyện này {\i1}đồng nghĩa với việc{\i0} vẫn còn hơn\N10 kg plutonium nằm lại trong Dejima.
Dialogue: 0,0:01:51.28,0:01:52.21,Default,,0000,0000,0000,,Thưa Thủ tướng.
Dialogue: 0,0:01:53.12,0:01:57.02,Default,,0000,0000,0000,,Tôi sẽ tuyên bố lệnh tổng động viên chính thức\NQuân Phòng vệ theo hướng này.
Dialogue: 0,0:01:57.15,0:01:58.28,Default,,0000,0000,0000,,Như thế có nhận được\Nsự phê chuẩn của ngài không?
Dialogue: 0,0:01:59.06,0:02:03.55,Default,,0000,0000,0000,,Nội các đã đạt được sự đồng thuận.\NTôi không có ý kiến gì thêm.
Dialogue: 0,0:02:16.71,0:02:20.94,Default,,0000,0000,0000,,Nội dung cuộc họp Nội các lần này\Ncó vẻ hơi quá áp đặt đối với tôi.
Dialogue: 0,0:02:22.68,0:02:26.05,Default,,0000,0000,0000,,Các vị định phớt lờ lời kêu gọi từ các nước láng giềng châu Á,\Nbắt đầu từ chính phủ Trung Quốc,
Dialogue: 0,0:02:26.18,0:02:29.64,Default,,0000,0000,0000,,về việc tránh sử dụng vũ lực sao?
Dialogue: 0,0:02:30.29,0:02:35.38,Default,,0000,0000,0000,,Một quốc gia từ chối tiếp nhận người tị nạn\Nthì không có tư cách can thiệp vào chuyện này.
Dialogue: 0,0:02:35.96,0:02:40.09,Default,,0000,0000,0000,,Tuy nhiên, sự lo ngại của các nước láng giềng\Nvề việc ta tăng cường vũ trang ngày càng gia tăng...
Dialogue: 0,0:02:40.20,0:02:44.22,Default,,0000,0000,0000,,Nhắc mới nhớ, chúng ta cũng vừa nhận được\Nmột thông điệp từ Đế quốc Mỹ.
Dialogue: 0,0:02:44.97,0:02:48.00,Default,,0000,0000,0000,,Họ nói rằng chúng ta tuyệt đối không được\Nđể đám tị nạn tạo ra một tiền lệ...
Dialogue: 0,0:02:48.11,0:02:50.70,Default,,0000,0000,0000,,...về việc giành độc lập\Nbằng vũ khí hạt nhân.
Dialogue: 0,0:02:51.21,0:02:54.23,Default,,0000,0000,0000,,Để đạt được mục tiêu đó, chúng ta nên thể hiện\Nmột mặt trận thống nhất trong việc giải quyết vấn đề này,
Dialogue: 0,0:02:54.48,0:02:57.61,Default,,0000,0000,0000,,ngay cả khi điều đó đồng nghĩa với việc đẩy nhanh\Ntiến độ ký kết Hiệp ước An ninh.
Dialogue: 0,0:02:58.08,0:03:01.42,Default,,0000,0000,0000,,Họ nói điều đó khi nào?\NTôi chẳng được thông báo gì về...
Dialogue: 0,0:03:01.69,0:03:04.78,Default,,0000,0000,0000,,Bà quá thân Trung Quốc so với khẩu vị của họ.\NHọ không tin tưởng bà.
Dialogue: 0,0:03:06.02,0:03:10.29,Default,,0000,0000,0000,,Có vẻ như Nội các Kayabuki\Nsẽ chỉ tồn tại cho tới khi Dejima sụp đổ.
Dialogue: 0,0:03:29.78,0:03:32.68,Default,,0000,0000,0000,,Thằng khốn đó có lẽ\Nsẽ nhận ra bất cứ lúc nào.
Dialogue: 0,0:03:33.22,0:03:34.51,Default,,0000,0000,0000,,Chắc là vậy.
Dialogue: 0,0:03:43.79,0:03:48.29,Default,,0000,0000,0000,,Chiếc xe mục tiêu vừa được tìm thấy bị bỏ lại\Ntại một bãi đỗ trên Đường cao tốc Nagasaki.
Dialogue: 0,0:03:49.10,0:03:50.50,Default,,0000,0000,0000,,Còn plutonium\Nthì sao?!
Dialogue: 0,0:03:50.63,0:03:52.26,Default,,0000,0000,0000,,Không thấy dấu vết nào\Ncủa nó, thưa sếp.
Dialogue: 0,0:03:52.90,0:03:54.34,Default,,0000,0000,0000,,Tôi hiểu rồi...
Dialogue: 0,0:03:54.44,0:03:59.24,Default,,0000,0000,0000,,Vậy thì chúng ta không còn lựa chọn nào khác.\NKhông được để truyền thông đánh hơi thấy vụ này.
Dialogue: 0,0:03:59.88,0:04:01.97,Default,,0000,0000,0000,,Tôi muốn các anh ưu tiên hàng đầu\Ncho việc thao túng thông tin,
Dialogue: 0,0:04:02.08,0:04:06.38,Default,,0000,0000,0000,,và phối hợp dưới quyền chỉ huy của chúng tôi\Nđể tiến hành thu hồi plutonium.
Dialogue: 0,0:04:06.88,0:04:09.55,Default,,0000,0000,0000,,Tôi biết rõ điều đó.\NTôi sẽ để anh xử lý việc này, nhưng...
Dialogue: 0,0:04:09.92,0:04:13.86,Default,,0000,0000,0000,,Đừng lo. Nếu anh làm chính xác như tôi bảo,\Nmọi chuyện sẽ ổn thỏa cả thôi.
Dialogue: 0,0:04:17.49,0:04:21.43,Default,,0000,0000,0000,,Tôi sẽ quay về văn phòng và bắt đầu\Nxoay chuyển tình hình này.
Dialogue: 0,0:04:21.70,0:04:22.93,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:04:29.37,0:04:33.71,Default,,0000,0000,0000,,Chà, có vẻ Thiếu tá và những người khác\Nđang trên đường tới Spring-8 ngay lúc này.
Dialogue: 0,0:04:34.08,0:04:35.14,Default,,0000,0000,0000,,Tốt rồi.
Dialogue: 0,0:04:37.31,0:04:40.37,Default,,0000,0000,0000,,Lệnh điều động Quân Phòng vệ\Nđã được quyết định chính thức.
Dialogue: 0,0:04:40.95,0:04:43.35,Default,,0000,0000,0000,,Cuộc họp báo của Chánh Văn phòng Nội các\Nsẽ diễn ra lúc 7 giờ,
Dialogue: 0,0:04:43.69,0:04:46.75,Default,,0000,0000,0000,,và tại thời điểm đó việc điều động Quân Phòng vệ\Nsẽ chính thức bắt đầu.
Dialogue: 0,0:04:47.52,0:04:49.58,Default,,0000,0000,0000,,Chỉ còn chưa đầy\Nmột tiếng nữa.
Dialogue: 0,0:04:49.99,0:04:52.36,Default,,0000,0000,0000,,Tôi đoán công tác chuẩn bị ở Nagasaki\Nđang được ráo riết tiến hành rồi.
Dialogue: 0,0:04:53.63,0:04:56.83,Default,,0000,0000,0000,,Ông Aramaki, tôi không hiểu Chánh Văn phòng Nội các\Nhy vọng thu được gì...
Dialogue: 0,0:04:56.93,0:05:00.46,Default,,0000,0000,0000,,...từ việc để tình hình trở nên tồi tệ đến mức này.
Dialogue: 0,0:05:01.51,0:05:03.84,Default,,0000,0000,0000,,Việc này chẳng mang lại gì ngoài việc biến tình hình\Nthành một bãi lầy.
Dialogue: 0,0:05:04.74,0:05:07.73,Default,,0000,0000,0000,,Dejima sẽ sụp đổ gần như ngay khi\Ngiao tranh nổ ra,
Dialogue: 0,0:05:07.91,0:05:11.31,Default,,0000,0000,0000,,nên nó không thể trở thành một trong những quốc gia thù địch tiềm tàng\Ncủa Hiệp ước An ninh được.
Dialogue: 0,0:05:11.45,0:05:15.94,Default,,0000,0000,0000,,Nhưng nếu đúng như vậy, tôi không tin điều đó ăn khớp\Nvới mục tiêu của Chánh Văn phòng Nội các,
Dialogue: 0,0:05:16.35,0:05:18.51,Default,,0000,0000,0000,,kẻ đang hy vọng thiết lập nên\Nmột tổ hợp công nghiệp - quân sự.
Dialogue: 0,0:05:18.86,0:05:19.91,Default,,0000,0000,0000,,Điều đó hoàn toàn đúng.
Dialogue: 0,0:05:20.06,0:05:22.92,Default,,0000,0000,0000,,Tuy nhiên, nếu ta giả định rằng chính vũng lầy đó\Nmới là mục tiêu của hắn,
Dialogue: 0,0:05:23.03,0:05:24.99,Default,,0000,0000,0000,,thì nó lại trở nên\Ncó lý ở một mức độ nào đó.
Dialogue: 0,0:05:25.43,0:05:29.73,Default,,0000,0000,0000,,Ngay cả khi người tị nạn đầu hàng,\Nđiều đó không có nghĩa là họ sẽ biến mất.
Dialogue: 0,0:05:30.83,0:05:33.30,Default,,0000,0000,0000,,Nó tạo ra một lý do để lấy ngân quỹ vốn dành cho...
Dialogue: 0,0:05:33.40,0:05:35.80,Default,,0000,0000,0000,,...chính sách tị nạn và chuyển hướng chúng\Nsang việc tăng cường quân bị.
Dialogue: 0,0:05:36.37,0:05:41.87,Default,,0000,0000,0000,,Đúng là vậy, nhưng điều đó cũng đồng nghĩa với việc\Náp lực từ Trung Quốc sẽ lớn hơn...
Dialogue: 0,0:05:42.91,0:05:47.04,Default,,0000,0000,0000,,Hắn hẳn phải có chiêu bài nào khác\Nmà chúng ta chưa biết đến.
Dialogue: 0,0:05:47.85,0:05:49.58,Default,,0000,0000,0000,,Tôi chợt nghĩ ra một ý,\Nthưa Thủ tướng.
Dialogue: 0,0:05:50.12,0:05:55.06,Default,,0000,0000,0000,,Liệu ngài có thể chuyển quyết định này sang cho Liên Hợp Quốc\Nnhằm kéo dài thời gian không?
Dialogue: 0,0:06:00.23,0:06:04.56,Default,,0000,0000,0000,,{\i1}Thiếu tá, có vẻ như Quân Phòng vệ Mặt đất{\i0}\N{\i1}đã lập một trạm kiểm soát phía trước.{\i0}
Dialogue: 0,0:06:06.20,0:06:09.73,Default,,0000,0000,0000,,Chà, tôi cũng chẳng trông mong\Nhọ để ta đi dễ dàng thế này...
Dialogue: 0,0:06:10.21,0:06:11.54,Default,,0000,0000,0000,,Kế hoạch thế nào đây?
Dialogue: 0,0:06:12.34,0:06:14.31,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi đây.{\i0}
Dialogue: 0,0:06:14.88,0:06:18.97,Default,,0000,0000,0000,,{\i1}Thủ tướng vừa đệ trình một yêu cầu{\i0}\N{\i1}tới Liên Hợp Quốc để thanh sát hạt nhân.{\i0}
Dialogue: 0,0:06:19.32,0:06:22.55,Default,,0000,0000,0000,,{\i1}Nếu mọi chuyện suôn sẻ, đoàn thanh sát{\i0}\N{\i1}sẽ tới Nhật Bản trong hai ngày nữa.{\i0}
Dialogue: 0,0:06:23.29,0:06:25.92,Default,,0000,0000,0000,,{\i1}Nếu ta có thể bàn giao số plutonium này{\i0}\N{\i1}cho họ khi họ đến,{\i0}
Dialogue: 0,0:06:26.16,0:06:29.28,Default,,0000,0000,0000,,{\i1}thì có cơ hội rất lớn là ta{\i0}\N{\i1}có thể chấm dứt tình hình này.{\i0}
Dialogue: 0,0:06:29.66,0:06:31.56,Default,,0000,0000,0000,,{\i1}Cô có nghĩ mình có thể giữ mình ngoài vòng pháp luật{\i0}\N{\i1}cho tới lúc đó không?{\i0}
Dialogue: 0,0:06:32.10,0:06:34.33,Default,,0000,0000,0000,,{\i1}Có, nếu chúng tôi tìm được{\i0}\N{\i1}nơi nào đó để ẩn náu.{\i0}
Dialogue: 0,0:06:34.90,0:06:38.49,Default,,0000,0000,0000,,{\i1}Nhưng tôi nghĩ việc tìm cách gặp được{\i0}\N{\i1}đoàn thanh sát sẽ khá rắc rối đấy.{\i0}
Dialogue: 0,0:06:38.90,0:06:43.97,Default,,0000,0000,0000,,Hãy tìm cách xoay xở đi. Đây có thể là\Nquân bài cuối cùng mà chúng ta có để chơi.
Dialogue: 0,0:06:45.34,0:06:46.97,Default,,0000,0000,0000,,{\i1}Tôi sẽ làm hết sức mình.{\i0}
Dialogue: 0,0:06:47.48,0:06:50.67,Default,,0000,0000,0000,,{\i1}Thêm nữa, về những lính mới tuyển{\i0}\N{\i1}đang ở lại tổng hành dinh...{\i0}
Dialogue: 0,0:06:50.88,0:06:54.58,Default,,0000,0000,0000,,{\i1}Phòng trường hợp có chuyện xảy ra,{\i0}\N{\i1}xin hãy thu xếp để họ không bị cuốn vào.{\i0}
Dialogue: 0,0:06:55.19,0:06:57.65,Default,,0000,0000,0000,,{\i1}Kể từ đây trở đi,{\i0}\N{\i1}chúng tôi sẽ tự mình giải quyết.{\i0}
Dialogue: 0,0:06:57.75,0:07:00.88,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi. Tôi sẽ thu xếp{\i0}\N{\i1}những việc cần thiết.{\i0}
Dialogue: 0,0:07:01.16,0:07:03.49,Default,,0000,0000,0000,,{\i1}Còn về các đơn vị{\i0}\N{\i1}Tachikoma...{\i0}
Dialogue: 0,0:07:05.76,0:07:06.92,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:07:07.33,0:07:08.96,Default,,0000,0000,0000,,Tín hiệu của chúng ta\Nbị cắt đứt rồi.
Dialogue: 0,0:07:09.63,0:07:11.60,Default,,0000,0000,0000,,Có thể là do điều khoản hạn chế thông tin liên lạc địa phương...
Dialogue: 0,0:07:11.70,0:07:13.76,Default,,0000,0000,0000,,...thuộc Hệ thống Luật Tình trạng Khẩn cấp Quốc gia.
Dialogue: 0,0:07:16.01,0:07:19.94,Default,,0000,0000,0000,,Cuộc họp báo sắp bắt đầu rồi.\NTôi sẽ tới phòng họp báo.
Dialogue: 0,0:07:27.12,0:07:30.28,Default,,0000,0000,0000,,Vậy là chúng ta có\Nmột cuộc chiến tranh rồi sao?
Dialogue: 0,0:07:35.53,0:07:38.82,Default,,0000,0000,0000,,Liên Hợp Quốc ư?\NKayabuki gọi họ tới à?
Dialogue: 0,0:07:38.93,0:07:40.09,Default,,0000,0000,0000,,Vâng, thưa ngài.
Dialogue: 0,0:07:43.90,0:07:46.60,Default,,0000,0000,0000,,Hãy chuẩn bị những bước cần thiết\Nđể phế truất bà ta khỏi chức vụ.
Dialogue: 0,0:07:46.70,0:07:48.03,Default,,0000,0000,0000,,Rõ, thưa ngài.
Dialogue: 0,0:07:49.91,0:07:51.74,Default,,0000,0000,0000,,Được rồi,\Nbắt đầu thôi.
Dialogue: 0,0:08:40.72,0:08:42.79,Default,,0000,0000,0000,,Tiếp sau việc Quân Phòng vệ\Nphong tỏa Dejima,
Dialogue: 0,0:08:42.79,0:08:45.76,Default,,0000,0000,0000,,các rào chắn giao thông quy mô lớn\Nđang được dựng lên tại các quận xung quanh.
Dialogue: 0,0:08:53.44,0:08:59.03,Default,,0000,0000,0000,,Hôm nay, chúng ta sẽ giành được độc lập\Ntrên thực tế!
Dialogue: 0,0:09:18.83,0:09:21.19,Default,,0000,0000,0000,,Chúng tôi yêu cầu\Nchính phủ Nhật Bản...
Dialogue: 0,0:09:21.30,0:09:23.53,Default,,0000,0000,0000,,...phải công nhận Dejima là\Nmột quốc gia độc lập!
Dialogue: 0,0:09:24.37,0:09:28.57,Default,,0000,0000,0000,,Khi đó chúng ta sẽ có thể tự do giao thương\Nvà tự cung tự cấp!
Dialogue: 0,0:09:29.41,0:09:31.43,Default,,0000,0000,0000,,Điều đó thì có gì\Nlà sai trái cơ chứ?!
Dialogue: 0,0:09:31.61,0:09:33.54,Default,,0000,0000,0000,,Chúng ta đang sở hữu\Nvũ khí hạt nhân trong tay!
Dialogue: 0,0:09:33.88,0:09:36.31,Default,,0000,0000,0000,,Chính phủ cũng đã thừa nhận\Nsự thật này rồi!
Dialogue: 0,0:09:36.71,0:09:39.24,Default,,0000,0000,0000,,Đây chính là thành quả từ công sức\Ncủa Đồng chí Kuze!
Dialogue: 0,0:09:39.92,0:09:42.94,Default,,0000,0000,0000,,Chỉ riêng vì lý do đó, việc đuổi anh ấy đi\Nlà một hành động không thể tưởng tượng nổi!
Dialogue: 0,0:09:43.55,0:09:46.39,Default,,0000,0000,0000,,Hơn nữa, thời hạn trước khi chúng ta bắt đầu\Ntấn công là hai ngày.
Dialogue: 0,0:09:46.92,0:09:50.32,Default,,0000,0000,0000,,Hạn chót cuối cùng sẽ là lúc đoàn thanh sát hạt nhân\Ncủa Liên Hợp Quốc tới nơi.
Dialogue: 0,0:09:50.86,0:09:54.46,Default,,0000,0000,0000,,Nếu tới lúc đó chúng tôi không nhận được câu trả lời\Ntừ phía người tị nạn,
Dialogue: 0,0:09:55.00,0:09:57.93,Default,,0000,0000,0000,,các đợt tấn công mở màn của chúng tôi\Nsẽ bắt đầu.
Dialogue: 0,0:09:59.64,0:10:00.83,Default,,0000,0000,0000,,Đó là tất cả.
Dialogue: 0,0:10:03.71,0:10:04.83,Default,,0000,0000,0000,,Có vẻ như cuộc chiến đã bắt đầu.
Dialogue: 0,0:10:05.71,0:10:07.90,Default,,0000,0000,0000,,Giờ ta đã bị cắt đứt liên lạc\Nvới Sếp,
Dialogue: 0,0:10:08.01,0:10:11.41,Default,,0000,0000,0000,,ta không còn lựa chọn nào khác ngoài việc\Nhành động theo ý chí của chính mình.
Dialogue: 0,0:10:12.25,0:10:16.81,Default,,0000,0000,0000,,Nhưng tôi để cho mỗi người tự quyết định\Nliệu có tham gia vào chiến dịch này hay không.
Dialogue: 0,0:10:17.39,0:10:19.32,Default,,0000,0000,0000,,Này, nói thế là sao chứ?
Dialogue: 0,0:10:19.42,0:10:22.55,Default,,0000,0000,0000,,Đâu phải lần đầu chúng ta phải hành động\Nnhư một băng đảng ngoài vòng pháp luật.
Dialogue: 0,0:10:23.19,0:10:26.32,Default,,0000,0000,0000,,Chẳng phải chúng ta chỉ việc chơi trò trốn tìm\Nvới Quân Phòng vệ thôi sao?
Dialogue: 0,0:10:26.66,0:10:30.12,Default,,0000,0000,0000,,Không, chúng ta sẽ mang số plutonium này\Nvào Dejima.
Dialogue: 0,0:10:30.90,0:10:31.99,Default,,0000,0000,0000,,Vào Dejima ư?!
Dialogue: 0,0:10:32.10,0:10:37.20,Default,,0000,0000,0000,,Đúng vậy. Chúng ta sẽ lẻn vào Dejima\Ndưới sự che chở của cuộc tiến công từ Quân Phòng vệ.
Dialogue: 0,0:10:37.87,0:10:40.21,Default,,0000,0000,0000,,Dù sao thì Dejima cũng là nơi\Nđoàn thanh sát sẽ đến.
Dialogue: 0,0:10:40.74,0:10:42.94,Default,,0000,0000,0000,,Nếu đã như thế, chúng ta sẽ bắt giữ Kuze\Ntrước lúc đó...
Dialogue: 0,0:10:43.05,0:10:45.14,Default,,0000,0000,0000,,...rồi bàn giao cả plutonium lẫn hắn\Nnhư một gói trọn gói cho họ.
Dialogue: 0,0:10:46.82,0:10:50.55,Default,,0000,0000,0000,,Ý tưởng đó điên rồ đến mức chỉ có cô mới nghĩ ra được.\NTôi sẽ đi cùng để góp vui.
Dialogue: 0,0:10:51.69,0:10:52.88,Default,,0000,0000,0000,,Tôi cũng tán thành.
Dialogue: 0,0:10:53.62,0:10:54.95,Default,,0000,0000,0000,,Tôi cũng tham gia,\Ntất nhiên rồi.
Dialogue: 0,0:10:56.33,0:10:58.29,Default,,0000,0000,0000,,Tôi cũng chẳng có phản đối gì,\Nnhưng...
Dialogue: 0,0:10:59.13,0:11:00.56,Default,,0000,0000,0000,,Anh phản đối\Ný tưởng này à?
Dialogue: 0,0:11:01.16,0:11:06.23,Default,,0000,0000,0000,,Không, tôi sẽ kiếm tiền lương của mình\Nđể đổi lấy một chút cảm giác mạnh.
Dialogue: 0,0:11:08.67,0:11:09.97,Default,,0000,0000,0000,,Thế thì quyết định vậy đi.
Dialogue: 0,0:11:10.21,0:11:13.51,Default,,0000,0000,0000,,Các rào chắn quy mô lớn đã được quân đội dựng lên\Ntrên các đường phố Nagasaki, nơi mà...
Dialogue: 0,0:11:13.51,0:11:16.05,Default 2,,0000,0000,0000,,Ngoài ra, toàn bộ các chuyến bay nội địa\Nhiện đang...
Dialogue: 0,0:11:16.15,0:11:19.15,Default,,0000,0000,0000,,Vì vậy theo khía cạnh đó, quyết định này\Ncủa chính phủ là...
Dialogue: 0,0:11:22.79,0:11:24.69,Default,,0000,0000,0000,,{\i1}Ishikawa, tình trạng của anh thế nào rồi?{\i0}
Dialogue: 0,0:11:24.79,0:11:28.42,Default,,0000,0000,0000,,{\i1}Thiếu tá đấy à?{\i0}\N{\i1}Tôi vẫn đang phải nằm bẹp trên giường đây.{\i0}
Dialogue: 0,0:11:28.79,0:11:31.19,Default,,0000,0000,0000,,{\i1}Thỉnh thoảng được nghỉ ốm một chút{\i0}\N{\i1}cũng không tệ lắm.{\i0}
Dialogue: 0,0:11:31.53,0:11:34.40,Default,,0000,0000,0000,,{\i1}Hay đúng hơn là lý do thực sự tôi gọi{\i0}\N{\i1}là vì có một việc muốn nhờ anh.{\i0}
Dialogue: 0,0:11:34.66,0:11:37.86,Default,,0000,0000,0000,,{\i1}Việc gì thế? Nếu có việc tôi giúp được,{\i0}\N{\i1}cứ nói một tiếng là xong.{\i0}
Dialogue: 0,0:11:38.70,0:11:41.83,Default,,0000,0000,0000,,{\i1}Tôi vừa phái một chiếc Tachikoma{\i0}\N{\i1}đến chỗ anh.{\i0}
Dialogue: 0,0:11:42.24,0:11:47.20,Default,,0000,0000,0000,,{\i1}Bên trong khoang của nó là một nửa số plutonium{\i0}\N{\i1}ta thu hồi được từ Tháp Phát thanh Kyushu.{\i0}
Dialogue: 0,0:11:47.61,0:11:49.81,Default,,0000,0000,0000,,{\i1}Tôi muốn anh mang nó{\i0}\N{\i1}tới Spring-8.{\i0}
Dialogue: 0,0:11:50.11,0:11:52.78,Default,,0000,0000,0000,,{\i1}Ồ, được rồi... Tôi hiểu{\i0}\N{\i1}ý đồ của cô rồi.{\i0}
Dialogue: 0,0:11:53.42,0:11:56.25,Default,,0000,0000,0000,,{\i1}Chắc chắn rồi, tôi làm được.{\i0}\N{\i1}Nhưng còn các cậu thì sao?{\i0}
Dialogue: 0,0:11:57.35,0:12:00.59,Default,,0000,0000,0000,,{\i1}Bọn tôi đang hướng về Dejima{\i0}\N{\i1}với số plutonium còn lại.{\i0}
Dialogue: 0,0:12:00.69,0:12:02.12,Default,,0000,0000,0000,,{\i1}Vào Dejima ư?!{\i0}
Dialogue: 0,0:12:02.23,0:12:05.19,Default,,0000,0000,0000,,{\i1}Đúng là một kế hoạch điên rồ hết cỡ{\i0}\N{\i1}mà cô có thể nghĩ ra...{\i0}
Dialogue: 0,0:12:05.53,0:12:06.36,Default,,0000,0000,0000,,{\i1}Còn Togusa thì sao?{\i0}
Dialogue: 0,0:12:06.70,0:12:08.63,Default,,0000,0000,0000,,{\i1}Cậu ấy đang ở cùng Trưởng phòng{\i0}\N{\i1}tại tư dinh của Thủ tướng.{\i0}
Dialogue: 0,0:12:08.97,0:12:12.83,Default,,0000,0000,0000,,{\i1}Nghe thế thì mừng rồi. Thiếu tá, tôi tiếc là{\i0}\N{\i1}không thể có mặt ở đó cùng mọi người,{\i0}
Dialogue: 0,0:12:13.00,0:12:14.60,Default,,0000,0000,0000,,{\i1}nhưng đừng có làm điều gì{\i0}\N{\i1}quá dại dột đấy.{\i0}
Dialogue: 0,0:12:14.84,0:12:18.17,Default,,0000,0000,0000,,{\i1}Nếu chúng bắt đầu dội bom nơi đó,{\i0}\N{\i1}thì chẳng biết chuyện gì sẽ xảy ra đâu.{\i0}
Dialogue: 0,0:12:18.58,0:12:21.64,Default,,0000,0000,0000,,{\i1}Tôi biết rồi. Anh cũng phải{\i0}\N{\i1}tự cẩn thận đấy.{\i0}
Dialogue: 0,0:12:24.48,0:12:26.01,Default,,0000,0000,0000,,{\i1}Cứ tin ở tôi.{\i0}
Dialogue: 0,0:12:26.15,0:12:27.38,Default,,0000,0000,0000,,{\i1}Giao lại cho anh đấy.{\i0}
Dialogue: 0,0:12:27.52,0:12:31.85,Default,,0000,0000,0000,,{\i1}Hãy đón xem chúng tôi trên bản tin thời sự khi chúng tôi{\i0}\N{\i1}bàn giao plutonium cho đoàn thanh sát LHQ nhé.{\i0}
Dialogue: 0,0:12:37.86,0:12:40.76,Default,,0000,0000,0000,,{\i1}Đừng để mất mạng đấy,{\i0}\N{\i1}Thiếu tá.{\i0}
Dialogue: 0,0:12:43.10,0:12:44.66,Default,,0000,0000,0000,,Này, Thiếu tá.
Dialogue: 0,0:12:46.50,0:12:48.20,Default,,0000,0000,0000,,Tôi hỏi cô một câu được không?
Dialogue: 0,0:12:48.31,0:12:49.40,Default,,0000,0000,0000,,Nói đi.
Dialogue: 0,0:12:50.54,0:12:54.03,Default,,0000,0000,0000,,Lúc tôi dùng bộ nhớ ngoài của cô\Nđể nói chuyện với Gohda,
Dialogue: 0,0:12:54.44,0:12:58.35,Default,,0000,0000,0000,,tôi thấy hơi có lỗi khi làm vậy, nhưng tôi đã liếc qua\Nký ức của cô về Kuze.
Dialogue: 0,0:12:58.72,0:12:59.84,Default,,0000,0000,0000,,Rồi sao?
Dialogue: 0,0:13:00.28,0:13:02.65,Default,,0000,0000,0000,,Cũng không hẳn là tôi\Nnhìn thấy điều gì,
Dialogue: 0,0:13:03.09,0:13:05.65,Default,,0000,0000,0000,,nhưng tôi có cảm giác rằng cô có\Ntình cảm đặc biệt dành cho Kuze.
Dialogue: 0,0:13:06.69,0:13:09.82,Default,,0000,0000,0000,,Chuyện gì đã xảy ra với cô\Nkhi cô lặn vào não hắn?
Dialogue: 0,0:13:12.23,0:13:14.66,Default,,0000,0000,0000,,Chẳng có chuyện gì đặc biệt xảy ra cả.
Dialogue: 0,0:13:14.86,0:13:20.13,Default,,0000,0000,0000,,Nhưng khi tiếp xúc với ký ức của anh ta, anh ta\Nkhiến tôi nhớ đến một người tôi từng thân thiết.
Dialogue: 0,0:13:21.24,0:13:23.17,Default,,0000,0000,0000,,Từng thân thiết ư?
Dialogue: 0,0:13:23.67,0:13:27.58,Default,,0000,0000,0000,,Ừ, nhưng chuyện đó đã qua rồi.\NGiờ nó là chuyện cổ tích xưa như diễm rồi.
Dialogue: 0,0:13:29.45,0:13:31.07,Default,,0000,0000,0000,,Được rồi, chúng ta sắp tới nơi rồi!
Dialogue: 0,0:13:43.13,0:13:45.56,Default,,0000,0000,0000,,Họ thực sự định dùng xe tăng\Nđể tấn công chúng ta sao?
Dialogue: 0,0:13:46.20,0:13:49.17,Default,,0000,0000,0000,,Ừ, vì họ biết chúng ta sẵn sàng\Nđánh bom liều chết với họ mà.
Dialogue: 0,0:13:50.03,0:13:52.56,Default,,0000,0000,0000,,Đồng chí Kuze đã dặn không được manh động,\Nnhớ chứ?
Dialogue: 0,0:13:53.34,0:13:55.60,Default,,0000,0000,0000,,Dù làm gì đi nữa,\Ntuyệt đối không được nổ súng trước.
Dialogue: 0,0:13:55.77,0:13:59.21,Default,,0000,0000,0000,,Nếu làm thế, dư luận quốc tế\Nsẽ đứng về phía chúng ta.
Dialogue: 0,0:13:59.31,0:14:02.40,Default,,0000,0000,0000,,Chúng ta sẽ thắng cuộc chiến này\Nmà không cần tốn một viên đạn.
Dialogue: 0,0:14:03.35,0:14:05.28,Default,,0000,0000,0000,,Hãy chắc chắn là đã kết nối với Kuze\Ntrước khi làm bất cứ điều gì.
Dialogue: 0,0:14:22.47,0:14:25.16,Default,,0000,0000,0000,,Vậy ra cậu hẳn là\NHideo Kuze.
Dialogue: 0,0:14:25.77,0:14:27.00,Default,,0000,0000,0000,,Còn ông là?
Dialogue: 0,0:14:31.21,0:14:34.18,Default,,0000,0000,0000,,Cậu biết đấy, tôi từng nhìn thấy cậu\Nở hải ngoại một lần rồi.
Dialogue: 0,0:14:35.18,0:14:36.41,Default,,0000,0000,0000,,Ồ, vậy sao?
Dialogue: 0,0:14:37.28,0:14:40.44,Default,,0000,0000,0000,,Cậu bị vây quanh bởi cả biển người\Nở Đài Loan,
Dialogue: 0,0:14:40.55,0:14:44.88,Default,,0000,0000,0000,,nhưng có vẻ ở Dejima này chẳng mấy ai\Nbiết mặt mũi cậu ra sao.
Dialogue: 0,0:14:45.86,0:14:48.85,Default,,0000,0000,0000,,Đó là bởi vì nhiều người ở đây\Nđều có não điện tử.
Dialogue: 0,0:14:49.16,0:14:55.22,Default,,0000,0000,0000,,À, tôi hiểu rồi. Đó là cách cậu truyền bá\Nniềm tin của mình trong cộng đồng người tị nạn.
Dialogue: 0,0:14:56.90,0:15:01.67,Default,,0000,0000,0000,,Tất nhiên, tôi nghĩ việc cậu có đủ sức mạnh tinh thần...
Dialogue: 0,0:15:01.81,0:15:07.14,Default,,0000,0000,0000,,...để liên tục trả lời câu hỏi của ba triệu người\Nquả thực là một kỳ tích.
Dialogue: 0,0:15:08.11,0:15:10.98,Default,,0000,0000,0000,,Vâng, nhưng có một hiểm họa\Ntiềm ẩn trong đó.
Dialogue: 0,0:15:11.55,0:15:13.35,Default,,0000,0000,0000,,Hiểm họa tiềm ẩn ư?
Dialogue: 0,0:15:13.45,0:15:14.44,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:15:15.69,0:15:20.42,Default,,0000,0000,0000,,Cũng giống như nước chảy chỗ trũng, trái tim con người\Ncũng có xu hướng quay về với bản năng nguyên thủy nhất.
Dialogue: 0,0:15:23.09,0:15:26.46,Default,,0000,0000,0000,,Sau khi thoát khỏi con virus hệ tư tưởng\Nvà trở về Dejima,
Dialogue: 0,0:15:26.80,0:15:29.59,Default,,0000,0000,0000,,rất nhiều người tị nạn đã bắt đầu\Nkết nối với tôi.
Dialogue: 0,0:15:30.40,0:15:33.73,Default,,0000,0000,0000,,Kể từ đó, tôi đã trân trọng\Nmục tiêu của họ...
Dialogue: 0,0:15:34.10,0:15:38.30,Default,,0000,0000,0000,,...và biến việc giúp họ thực hiện ước mơ\Nthành nguyên tắc hành động duy nhất của mình.
Dialogue: 0,0:15:39.34,0:15:43.24,Default,,0000,0000,0000,,Chính vì thế việc trở thành thủ lĩnh của họ\Nkhông mấy khó khăn.
Dialogue: 0,0:15:44.78,0:15:47.38,Default,,0000,0000,0000,,Tôi đã lọc bỏ toàn bộ các ý thức khác\Nngoài ý thức của họ,
Dialogue: 0,0:15:47.48,0:15:53.12,Default,,0000,0000,0000,,và cố gắng đồng bộ hóa niềm tin của mình\Nvới những người tị nạn liên tục kết nối với tôi.
Dialogue: 0,0:15:54.32,0:15:57.45,Default,,0000,0000,0000,,Ngay sau khi chiến tranh kết thúc,\Ntôi đã phiêu bạt khắp lục địa Á-Âu,
Dialogue: 0,0:15:57.79,0:16:01.92,Default,,0000,0000,0000,,cố gắng tìm kiếm lý do tồn tại\Ncủa các cá nhân bên trong một hệ thống.
Dialogue: 0,0:16:02.60,0:16:05.03,Default,,0000,0000,0000,,Trong hành trình tìm kiếm đó,\Nngười tị nạn đã dạy cho tôi...
Dialogue: 0,0:16:05.37,0:16:10.60,Default,,0000,0000,0000,,...rằng con người vốn dĩ chỉ tồn tại\Nthông qua sự can thiệp của những người khác.
Dialogue: 0,0:16:12.08,0:16:15.37,Default,,0000,0000,0000,,Nếu đặt nghĩa vụ và quyền lợi của mình\Nlên bàn cân để đong đếm,
Dialogue: 0,0:16:15.48,0:16:18.38,Default,,0000,0000,0000,,và trước tiên đặt quả cân\Nvào bên đĩa \"quyền lợi\",
Dialogue: 0,0:16:18.52,0:16:23.32,Default,,0000,0000,0000,,thì bạn sẽ không đánh mất ý thức về bản thân\Nngay cả khi tuân theo các quy tắc của xã hội.
Dialogue: 0,0:16:26.76,0:16:27.72,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:16:31.86,0:16:36.73,Default,,0000,0000,0000,,Khái niệm phổ quát đó\Ntrông rất lôi cuốn đối với tôi.
Dialogue: 0,0:16:37.70,0:16:43.66,Default,,0000,0000,0000,,Nhưng một khi người tị nạn hiểu được mạng lưới\Nvà nhận biết các cấp bậc cao hơn của hệ thống phân cấp,
Dialogue: 0,0:16:44.01,0:16:47.70,Default,,0000,0000,0000,,họ quên sạch tất cả những điều đó, và họ quay về\Nvới bản năng nguyên thủy nhất của mình.
Dialogue: 0,0:16:48.51,0:16:50.81,Default,,0000,0000,0000,,Khi nắm trong tay quyền lực,\Nngười ta sẽ muốn phô trương nó.
Dialogue: 0,0:16:51.15,0:16:54.28,Default,,0000,0000,0000,,Cũng giống như khi có một món vũ khí,\Nngười ta sẽ muốn đem ra bắn thử.
Dialogue: 0,0:16:55.39,0:16:59.25,Default,,0000,0000,0000,,Nếu cậu biết điều đó, tại sao cậu lại\Nkéo dài tình hình đến mức này?
Dialogue: 0,0:16:59.59,0:17:03.03,Default,,0000,0000,0000,,Cậu thực sự nghĩ rằng mình sẽ có thể hoàn thành...
Dialogue: 0,0:17:03.13,0:17:05.12,Default,,0000,0000,0000,,...trò \"cách mạng\" vô nghĩa này\Nmột cách dễ dàng sao?
Dialogue: 0,0:17:05.73,0:17:11.00,Default,,0000,0000,0000,,Không, tôi không nghĩ vậy. Tuy nhiên, cuộc cách mạng\Nmà tôi hình dung vẫn còn một chặng đường dài phía trước.
Dialogue: 0,0:17:12.44,0:17:15.20,Default,,0000,0000,0000,,Tôi coi đây là bước đầu tiên, như việc chỉ hướng cho mọi người\Ntiến về kiến trúc thượng tầng...
Dialogue: 0,0:17:15.44,0:17:18.57,Default,,0000,0000,0000,,...vốn là mục tiêu tối thượng\Ntrong cuộc cách mạng của tôi.
Dialogue: 0,0:17:19.01,0:17:23.84,Default,,0000,0000,0000,,Kiến trúc thượng tầng ư? Chẳng phải nó cũng giống\Nnhư hệ thống phân cấp sao?
Dialogue: 0,0:17:23.95,0:17:25.81,Default,,0000,0000,0000,,Không, không giống.
Dialogue: 0,0:17:26.38,0:17:30.79,Default,,0000,0000,0000,,Mạng lưới bao phủ phần lớn Trái Đất hiện nay\Nđang dần biến thành hạ tầng cơ sở.
Dialogue: 0,0:17:31.45,0:17:34.98,Default,,0000,0000,0000,,Khi mục đích ban đầu của nó đã hoàn thành,\Nnó đang tạo ra một ý nghĩa mới.
Dialogue: 0,0:17:36.03,0:17:37.79,Default,,0000,0000,0000,,Từ đó, nó sẽ trở thành một thực thể\Nmang ý nghĩa mới...
Dialogue: 0,0:17:37.89,0:17:39.95,Default,,0000,0000,0000,,...tác động ngược trở lại\Nlên hạ tầng cơ sở.
Dialogue: 0,0:17:40.06,0:17:43.19,Default,,0000,0000,0000,,Mặc dù không thể tách rời\Nkhỏi hạ tầng cơ sở,
Dialogue: 0,0:17:43.73,0:17:46.10,Default,,0000,0000,0000,,nhưng nó sẽ trải qua một bước chuyển dịch\Nđể trở thành kiến trúc thượng tầng.
Dialogue: 0,0:17:57.38,0:18:01.08,Default,,0000,0000,0000,,Đó chính là định nghĩa về cuộc cách mạng\Nmà tôi hướng tới.
Dialogue: 0,0:18:01.52,0:18:06.05,Default,,0000,0000,0000,,Tôi không thực sự hiểu hết những điều đó, nhưng liệu cậu có thể\Nkhiến đám tị nạn cùng chia sẻ niềm tin đó không?
Dialogue: 0,0:18:07.19,0:18:11.79,Default,,0000,0000,0000,,Tôi nghĩ họ chia sẻ nó ở cấp độ trừu tượng,\Nchứ chưa hẳn là ở cấp độ cụ thể lúc này.
Dialogue: 0,0:18:13.96,0:18:18.16,Default,,0000,0000,0000,,Từ lâu rồi, tôi đã rời bỏ công việc nhà nước\Nvì niềm say mê đối với con người.
Dialogue: 0,0:18:18.77,0:18:22.03,Default,,0000,0000,0000,,Nếu cậu chịu nghe lời khuyên từ một lão già\Nlẩm cẩm như tôi,
Dialogue: 0,0:18:22.27,0:18:25.67,Default,,0000,0000,0000,,thì tôi khuyên cậu lúc này nên ưu tiên\Nthực tế hơn là lý tưởng.
Dialogue: 0,0:18:25.91,0:18:28.88,Default,,0000,0000,0000,,Cậu vẫn có thể chấm dứt\Nmớ hỗn độn này.
Dialogue: 0,0:19:00.48,0:19:03.74,Default,,0000,0000,0000,,{\i1}Tachikoma, tôi sẽ lặn vào não điện tử của Kuze{\i0}\N{\i1}một lần nữa. Hãy yểm trợ cho tôi.{\i0}
Dialogue: 0,0:19:05.11,0:19:06.41,Default,,0000,0000,0000,,Chị có nghĩ làm vậy an toàn không?
Dialogue: 0,0:19:06.75,0:19:08.77,Default,,0000,0000,0000,,Kết nối với anh ta\Nkhông khó.
Dialogue: 0,0:19:09.12,0:19:12.45,Default,,0000,0000,0000,,Câu hỏi thực sự là liệu anh ta\Ncó chấp nhận thông điệp từ chúng ta không.
Dialogue: 0,0:19:22.47,0:19:25.20,Default,,0000,0000,0000,,Thưa Đại diện. Chúng tôi vừa nhận được báo cáo\Nrằng một chiếc trực thăng...
Dialogue: 0,0:19:25.30,0:19:27.79,Default,,0000,0000,0000,,...vừa cất cánh mà không có lệnh\Ntừ đồn trú Oomura.
Dialogue: 0,0:19:28.57,0:19:33.03,Default,,0000,0000,0000,,{\i1}Vậy là ta đã tìm ra chúng.{\i0}\N{\i1}Chúng đang làm theo kịch bản của ta từng li từng tí.{\i0}
Dialogue: 0,0:19:33.41,0:19:36.34,Default,,0000,0000,0000,,{\i1}Tình hình triển khai EP-3C{\i0}\N{\i1}của chúng ta thế nào rồi?{\i0}
Dialogue: 0,0:19:36.48,0:19:40.04,Default,,0000,0000,0000,,{\i1}Thưa ngài, chúng tôi tin rằng nó đã{\i0}\N{\i1}vào vị trí trực chiến trên bầu trời Dejima.{\i0}
Dialogue: 0,0:19:40.48,0:19:43.15,Default,,0000,0000,0000,,{\i1}Tốt, chúng ta sẽ bắt đầu{\i0}\N{\i1}bằng việc đó.{\i0}
Dialogue: 0,0:19:43.29,0:19:47.62,Default,,0000,0000,0000,,Chúng ta sẽ phủ sóng gây nhiễu lên toàn bộ Dejima,\Nbiến đám tị nạn thành những kẻ đơn độc (standalones).
Dialogue: 0,0:19:47.72,0:19:50.75,Default,,0000,0000,0000,,Nếu làm thế, người tị nạn sẽ tự động\Nmất kiểm soát mà thôi.
Dialogue: 0,0:20:03.57,0:20:05.47,Default,,0000,0000,0000,,{\i1}Trời ơi, mạng lưới{\i0}\N{\i1}đang bị cắt đứt...{\i0}
Dialogue: 0,0:20:05.71,0:20:08.04,Default,,0000,0000,0000,,{\i1}Có vẻ như tình trạng phong tỏa liên lạc{\i0}\N{\i1}đang bắt đầu trên Dejima.{\i0}
Dialogue: 0,0:20:08.61,0:20:12.24,Default,,0000,0000,0000,,{\i1}Chuẩn bị mảng tường lửa phòng thủ sẵn sàng.{\i0}\N{\i1}Chúng ta sẽ bắn tệp tin nhắn của ta vào!{\i0}
Dialogue: 0,0:20:12.48,0:20:13.74,Default,,0000,0000,0000,,{\i1}- Rõ!\N- Rõ!{\i0}
Dialogue: 0,0:20:21.09,0:20:21.99,Default,,0000,0000,0000,,Cái gì?!
Dialogue: 0,0:20:22.73,0:20:23.59,Default,,0000,0000,0000,,Có chuyện gì vậy?
Dialogue: 0,0:20:23.69,0:20:27.15,Default,,0000,0000,0000,,Họ đang tới đây sao?\NLại còn mang theo cả plutonium nữa chứ...
Dialogue: 0,0:20:28.06,0:20:29.62,Default,,0000,0000,0000,,Cậu đang nói\Ncái quái gì thế?
Dialogue: 0,0:20:29.73,0:20:34.03,Default,,0000,0000,0000,,Chúng ta bị cắt đứt khỏi mạng rồi.\NQuân Phòng vệ đang gây nhiễu sao?
Dialogue: 0,0:20:42.85,0:20:45.28,Default,,0000,0000,0000,,Chúng hẳn đang cố\Ncô lập người tị nạn.
Dialogue: 0,0:20:47.02,0:20:48.38,Default,,0000,0000,0000,,Xe tăng đang tới kìa!
Dialogue: 0,0:20:49.02,0:20:53.35,Default,,0000,0000,0000,,Có vẻ như ai đó trong chính phủ\Ncũng có cùng triết lý với tôi.
Dialogue: 0,0:20:58.26,0:21:02.89,Default,,0000,0000,0000,,Tôi sẽ ra chiến lũy trên cầu. Rất có khả năng\Ngiao tranh sẽ nổ ra.
Dialogue: 0,0:21:04.20,0:21:09.26,Default,,0000,0000,0000,,Tôi không thể để những người như ông bị giết hại.\NNếu có thể, xin ông hãy trốn thoát khỏi Dejima.
Dialogue: 0,0:21:09.94,0:21:14.84,Default,,0000,0000,0000,,Cậu mới là người không được chết.\NVẫn còn việc cậu có thể làm mà.
Dialogue: 0,0:21:15.65,0:21:17.48,Default,,0000,0000,0000,,Tôi mong là ông nói đúng.
Dialogue: 0,0:21:25.72,0:21:26.65,Default,,0000,0000,0000,,{\i1}Có thành công không?!{\i0}
Dialogue: 0,0:21:26.82,0:21:29.59,Default,,0000,0000,0000,,{\i1}Tin nhắn đã lọt vào ngay trước khi{\i0}\N{\i1}mạng lưới bị cắt đứt ạ!{\i0}
Dialogue: 0,0:21:29.69,0:21:30.66,Default,,0000,0000,0000,,Tốt lắm!
Dialogue: 0,0:21:39.30,0:21:41.00,Default,,0000,0000,0000,,Khốn kiếp, tao sẽ giết sạch\Nlũ các người!
Dialogue: 0,0:21:47.68,0:21:48.84,Default,,0000,0000,0000,,Bắn trúng hắn rồi!
Dialogue: 0,0:21:50.48,0:21:52.78,Default,,0000,0000,0000,,Có người bị thương rồi!\NYểm trợ cho chúng tôi!
Dialogue: 0,0:22:02.02,0:22:03.89,Default,,0000,0000,0000,,Tôi nghe thấy tiếng súng!\NGiao tranh nổ ra rồi sao?!
Dialogue: 0,0:22:07.23,0:22:09.49,Default,,0000,0000,0000,,Dừng lại! Đừng bắn!\NNgừng bắn mau!
Dialogue: 0,0:22:09.60,0:22:11.59,Default,,0000,0000,0000,,Bên đó có\Nvũ khí hạt nhân đấy!
Dialogue: 0,0:22:14.10,0:22:19.78,Default,,0000,0000,0000,,{\i1}Cũng giống như nước chảy chỗ trũng, trái tim con người{\i0}\N{\i1}cũng có xu hướng quay về với bản năng nguyên thủy nhất.{\i0}
Dialogue: 0,0:22:23.18,0:22:25.91,Default,,0000,0000,0000,,Chuyện quái gì đã xảy ra vậy? Có vẻ như\Ngiao tranh đã bùng nổ ở bên dưới rồi!
Dialogue: 0,0:22:30.85,0:22:34.12,Default,,0000,0000,0000,,Xe tăng đang tiến vào, đúng như chúng ta nghĩ!\NHạ cầu xuống!
Dialogue: 0,0:22:36.12,0:22:38.12,Default,,0000,0000,0000,,
