Dialogue: 0,0:01:40.53,0:01:43.52,Default,,0000,0000,0000,,Tôi nghĩ anh đang quá kỳ vọng\Nvào cơ thể người máy tiêu chuẩn PKF đó rồi.
Dialogue: 0,0:01:43.96,0:01:47.59,Default,,0000,0000,0000,,Nó đã quá hạn sử dụng từ lâu.\NChẳng mang lại cho tôi chút lợi thế nào cả.
Dialogue: 0,0:01:48.50,0:01:50.63,Default,,0000,0000,0000,,Thế mà mày vẫn nghĩ\Nmày sẽ hạ được tao hả?
Dialogue: 0,0:01:51.24,0:01:52.60,Default,,0000,0000,0000,,Nghe ngứa tai\Nchết đi được...
Dialogue: 0,0:02:36.85,0:02:39.15,Default,,0000,0000,0000,,Cách duy nhất để đánh gục một cơ thể người máy\Nđã ngắt thụ thể cảm giác đau...
Dialogue: 0,0:02:39.25,0:02:40.72,Default,,0000,0000,0000,,...là làm cho não bộ\Nbị chấn động.
Dialogue: 0,0:02:59.21,0:03:00.37,Default,,0000,0000,0000,,Thằng khốn!
Dialogue: 0,0:03:26.17,0:03:27.96,Default,,0000,0000,0000,,Trước đây anh từng\Nở trong Lực lượng Biệt kích à?
Dialogue: 0,0:03:28.57,0:03:29.87,Default,,0000,0000,0000,,Thì đã sao?
Dialogue: 0,0:03:30.47,0:03:34.41,Default,,0000,0000,0000,,Anh rất giỏi. Có lẽ tôi thắng chỉ nhờ\Nmột chút khác biệt về động lực thôi.
Dialogue: 0,0:03:36.04,0:03:40.38,Default,,0000,0000,0000,,Tôi vẫn còn những việc phải làm.\NĐừng bám theo tôi nữa.
Dialogue: 0,0:03:42.12,0:03:43.61,Default,,0000,0000,0000,,Thằng chó...
Dialogue: 0,0:04:02.64,0:04:04.43,Default,,0000,0000,0000,,- Cậu chắc hắn đi hướng này chứ?\N- Chắc chắn.
Dialogue: 0,0:04:25.09,0:04:26.12,Default,,0000,0000,0000,,Coi chừng!
Dialogue: 0,0:04:45.11,0:04:47.64,Default,,0000,0000,0000,,Tên này là một cái xác điều khiển từ xa sao?
Dialogue: 0,0:04:51.75,0:04:54.15,Default,,0000,0000,0000,,Coi chừng đấy, đồ ngốc! Các cậu\Nđịnh bắn chết cả tôi hay sao hả?!
Dialogue: 0,0:04:54.25,0:04:55.55,Default,,0000,0000,0000,,Không phải lo đâu ạ!
Dialogue: 0,0:04:55.66,0:04:57.62,Default,,0000,0000,0000,,Nhờ phần mềm điều khiển hỏa lực\Nđược nâng cấp,
Dialogue: 0,0:04:57.76,0:05:00.69,Default,,0000,0000,0000,,bọn em bắn chuẩn hơn\Nanh Saito nhiều đấy ạ!
Dialogue: 0,0:05:04.50,0:05:08.87,Default,,0000,0000,0000,,Chuyện quái gì thế này? Thùy trán của tên này\Nđã bị thiêu cháy từ bao giờ rồi?
Dialogue: 0,0:05:08.97,0:05:10.40,Default,,0000,0000,0000,,Mùi hôi thối bốc lên\Nnồng nặc cả ra.
Dialogue: 0,0:05:11.07,0:05:13.16,Default,,0000,0000,0000,,Vả lại, nếu tên này là một cái xác điều khiển từ xa,
Dialogue: 0,0:05:13.41,0:05:16.00,Default,,0000,0000,0000,,thì làm sao chúng truyền được tín hiệu điều khiển\Nxuống sâu dưới lòng đất thế này?
Dialogue: 0,0:05:18.44,0:05:20.34,Default,,0000,0000,0000,,Chẳng lẽ họ dùng\Nthứ đó sao?
Dialogue: 0,0:05:29.22,0:05:30.31,Default,,0000,0000,0000,,Ở đằng kia!
Dialogue: 0,0:05:31.19,0:05:32.25,Default,,0000,0000,0000,,{\i1}Batou?{\i0}
Dialogue: 0,0:05:33.26,0:05:36.02,Default,,0000,0000,0000,,Sao chúng lại chuyển động kiểu đó?\NCả hai đều là loại không người lái sao?
Dialogue: 0,0:05:36.50,0:05:37.66,Default,,0000,0000,0000,,{\i1}Batou!{\i0}
Dialogue: 0,0:05:47.04,0:05:47.84,Default,,0000,0000,0000,,Batou đâu rồi?
Dialogue: 0,0:05:47.94,0:05:49.20,Default,,0000,0000,0000,,Anh ấy đuổi theo Kuze rồi!
Dialogue: 0,0:05:49.34,0:05:50.64,Default,,0000,0000,0000,,Chúng ta đuổi theo anh ấy thôi!
Dialogue: 0,0:05:53.81,0:05:55.61,Default,,0000,0000,0000,,{\i1}Bộ Giáp Chiến đó làm gì{\i0}\N{\i1}ở đằng kia chứ?{\i0}
Dialogue: 0,0:05:55.92,0:05:58.28,Default,,0000,0000,0000,,{\i1}Quân Phòng vệ Mặt đất chẳng có lý do gì{\i0}\N{\i1}để dính líu vào chuyện này cả.{\i0}
Dialogue: 0,0:05:59.35,0:06:00.15,Default,,0000,0000,0000,,{\i1}Còn Koil thì sao?{\i0}
Dialogue: 0,0:06:00.25,0:06:01.95,Default,,0000,0000,0000,,Anh Saito đang đuổi theo hắn ạ!
Dialogue: 0,0:06:02.05,0:06:02.92,Default,,0000,0000,0000,,{\i1}Tốt.{\i0}
Dialogue: 0,0:06:08.16,0:06:09.02,Default,,0000,0000,0000,,Batou?!
Dialogue: 0,0:06:09.16,0:06:10.29,Default,,0000,0000,0000,,Anh Batou!
Dialogue: 0,0:06:10.43,0:06:11.73,Default,,0000,0000,0000,,Có chuyện gì đã xảy ra\Nở đây vậy, Batou?
Dialogue: 0,0:06:14.20,0:06:16.83,Default,,0000,0000,0000,,Xin lỗi, hắn chạy mất rồi.
Dialogue: 0,0:06:22.58,0:06:23.54,Default,,0000,0000,0000,,Cậu có sao không?
Dialogue: 0,0:06:23.64,0:06:27.81,Default,,0000,0000,0000,,Tôi ổn. Tôi bất cẩn thôi, chỉ có vậy.\NMau đuổi theo hắn đi.
Dialogue: 0,0:06:28.11,0:06:30.88,Default,,0000,0000,0000,,Borma và những người khác sẽ tới đây ngay.\NCậu cứ ở yên đây.
Dialogue: 0,0:06:30.98,0:06:32.11,Default,,0000,0000,0000,,Đi thôi!
Dialogue: 0,0:06:36.46,0:06:39.58,Default,,0000,0000,0000,,{\i1}Cẩn thận đấy.{\i0}\N{\i1}Tên đó khó xơi lắm...{\i0}
Dialogue: 0,0:06:46.17,0:06:48.40,Default,,0000,0000,0000,,Ta phải xuất phát ngay. Chúng sẽ ập tới đây sớm thôi.
Dialogue: 0,0:06:51.64,0:06:53.97,Default,,0000,0000,0000,,Nếu anh tìm thằng nhóc đó,\Nthì có vẻ nó đã rời tàu rồi.
Dialogue: 0,0:06:54.31,0:06:57.67,Default,,0000,0000,0000,,Nó biến mất sau khi anh và những người khác\Nrời đi để thực hiện giao dịch.
Dialogue: 0,0:06:58.44,0:06:59.74,Default,,0000,0000,0000,,Ồ.
Dialogue: 0,0:07:15.29,0:07:16.16,Default,,0000,0000,0000,,Kuze...
Dialogue: 0,0:07:16.56,0:07:17.55,Default,,0000,0000,0000,,Yểm trợ cho tôi!
Dialogue: 0,0:07:39.99,0:07:40.95,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:08:15.32,0:08:19.82,Default,,0000,0000,0000,,Chúng đang hướng về Nagasaki! Ta sẽ đón Batou\Nrồi đuổi theo chúng bằng máy bay cánh xoay!
Dialogue: 0,0:08:19.96,0:08:21.26,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:08:36.58,0:08:37.63,Default,,0000,0000,0000,,Cảm ơn...
Dialogue: 0,0:08:38.34,0:08:39.87,Default,,0000,0000,0000,,Anh Batou!
Dialogue: 0,0:08:41.25,0:08:42.87,Default,,0000,0000,0000,,Anh Batou,\Nanh có sao không?
Dialogue: 0,0:08:42.98,0:08:44.51,Default,,0000,0000,0000,,Kệ tôi đi,\NThiếu tá thế nào rồi?
Dialogue: 0,0:08:51.02,0:08:54.62,Default,,0000,0000,0000,,Con tàu ngụy trang đã rời cảng.\NTa mau dùng máy bay cánh xoay đuổi theo thôi.
Dialogue: 0,0:08:55.03,0:08:56.55,Default,,0000,0000,0000,,Đưa Batou vào\Nmột Tachikoma mau!
Dialogue: 0,0:08:57.23,0:09:02.39,Default,,0000,0000,0000,,Thiếu tá, có vẻ Koil đã chết vì bị thiêu cháy\Nthùy trán từ trước rồi.
Dialogue: 0,0:09:02.74,0:09:04.64,Default,,0000,0000,0000,,Hắn hẳn đã là một cái xác điều khiển từ xa...
Dialogue: 0,0:09:04.74,0:09:08.10,Default,,0000,0000,0000,,...từ lúc chính quyền Nga\Nbắt đầu bám đuôi hắn.
Dialogue: 0,0:09:08.67,0:09:13.01,Default,,0000,0000,0000,,Thêm nữa, Jabrov và Kagazaki\Nđã biến mất từ trước khi ta đến đây.
Dialogue: 0,0:09:13.85,0:09:16.37,Default,,0000,0000,0000,,Các phi công lái Giáp Chiến\Ncũng là xác điều khiển từ xa.
Dialogue: 0,0:09:16.98,0:09:20.08,Default,,0000,0000,0000,,Có lẽ họ là nhân viên của Sagawa\Nhoặc công nhân địa phương.
Dialogue: 0,0:09:20.45,0:09:23.22,Default,,0000,0000,0000,,Và những bộ Giáp Chiến đó là những mẫu\Nvẫn chưa được bàn giao cho Quân Phòng vệ.
Dialogue: 0,0:09:23.79,0:09:25.92,Default,,0000,0000,0000,,Có vẻ như có rất nhiều uẩn khúc\Nđằng sau thương vụ này...
Dialogue: 0,0:09:26.66,0:09:28.65,Default,,0000,0000,0000,,Manh mối này sẽ giúp ta lần ra...
Dialogue: 0,0:09:28.76,0:09:30.82,Default,,0000,0000,0000,,...nguồn tiền mà Kuze đã dùng\Nđể trả cho chúng.
Dialogue: 0,0:09:31.60,0:09:35.73,Default,,0000,0000,0000,,Trông như hắn có một nguồn quỹ\Nkhổng lồ không tưởng.
Dialogue: 0,0:09:35.84,0:09:39.24,Default,,0000,0000,0000,,Làm tốt lắm. Cuộc điều tra đó tạm gác lại đã.\NChúng ta di chuyển thôi!
Dialogue: 0,0:09:52.42,0:09:55.55,Default,,0000,0000,0000,,Chúng sẽ tới sớm thôi.\NTrước mắt ta sẽ hướng về Shikotan.
Dialogue: 0,0:09:56.06,0:09:59.05,Default,,0000,0000,0000,,Những con tàu giống hệt con tàu này\Nhẳn đã rời Dejima rồi.
Dialogue: 0,0:09:59.26,0:10:02.42,Default,,0000,0000,0000,,Ta sẽ đợi người của ta đến\Nrồi lọt qua lưới tuần tra của Cảnh sát biển.
Dialogue: 0,0:10:03.03,0:10:06.26,Default,,0000,0000,0000,,Vấn đề thực sự là nếu đám người đằng kia\Ntấn công ta từ trên không.
Dialogue: 0,0:10:06.97,0:10:08.83,Default,,0000,0000,0000,,Tốt hơn hết ta nên\Nchuẩn bị pháo phòng không.
Dialogue: 0,0:10:23.88,0:10:25.11,Default,,0000,0000,0000,,Chuyện quái gì đã xảy ra vậy?
Dialogue: 0,0:10:33.09,0:10:34.92,Default,,0000,0000,0000,,Có kẻ hạ đo ván cậu sao,\NAnh bự?
Dialogue: 0,0:10:35.16,0:10:37.15,Default,,0000,0000,0000,,Tôi ổn, đừng có lo!
Dialogue: 0,0:10:37.26,0:10:40.36,Default,,0000,0000,0000,,Chúng ta xuất phát ngay.\NMau đuổi theo tàu của Kuze thôi.
Dialogue: 0,0:10:46.27,0:10:48.47,Default,,0000,0000,0000,,Ishikawa! Cắt đuôi hắn đi!
Dialogue: 0,0:11:06.46,0:11:07.19,Default,,0000,0000,0000,,Ishikawa!
Dialogue: 0,0:11:07.29,0:11:08.69,Default,,0000,0000,0000,,Khốn kiếp, hắn tự sát rồi!
Dialogue: 0,0:12:10.79,0:12:12.22,Default,,0000,0000,0000,,Đạn chì...
Dialogue: 0,0:12:18.10,0:12:19.36,Default,,0000,0000,0000,,Sao lâu thế nhỉ?
Dialogue: 0,0:12:22.10,0:12:23.83,Default,,0000,0000,0000,,Có vẻ như anh ấy\Nđã cản chân chúng giúp chúng ta.
Dialogue: 0,0:12:23.94,0:12:25.23,Default,,0000,0000,0000,,\"Anh ấy\" ư?
Dialogue: 0,0:12:26.27,0:12:28.57,Default,,0000,0000,0000,,Anh nghĩ chính quyền\Nđã biết về thương vụ này sao?
Dialogue: 0,0:12:28.94,0:12:30.24,Default,,0000,0000,0000,,Có khả năng.
Dialogue: 0,0:12:30.68,0:12:33.11,Default,,0000,0000,0000,,Dù sao thì chúng ta\Ncũng đã có plutonium.
Dialogue: 0,0:12:33.35,0:12:34.54,Default,,0000,0000,0000,,Tôi đoán anh nói đúng.
Dialogue: 0,0:12:35.31,0:12:37.98,Default,,0000,0000,0000,,Chuyện này sẽ biến Dejima\Nthành quốc gia của riêng chúng ta.
Dialogue: 0,0:12:39.35,0:12:40.55,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:12:40.92,0:12:45.05,Default,,0000,0000,0000,,Chúng ta chưa thể lạc quan lúc này được.\NÍt nhất là cho tới khi mang được nó vào Dejima.
Dialogue: 0,0:12:45.49,0:12:46.96,Default,,0000,0000,0000,,Tôi đoán anh nói đúng.
Dialogue: 0,0:12:47.56,0:12:49.25,Default,,0000,0000,0000,,Tôi có một đề xuất về cách\Nthực hiện việc đó.
Dialogue: 0,0:12:49.36,0:12:50.35,Default,,0000,0000,0000,,Như thế nào?
Dialogue: 0,0:12:50.83,0:12:55.66,Default,,0000,0000,0000,,Tôi sẽ tự mình hướng về Dejima.\NHai anh sẽ xuống ở Shikotan.
Dialogue: 0,0:12:57.54,0:13:04.24,Default,,0000,0000,0000,,Phía trước sẽ có tàu tuần tra Cảnh sát biển.\NTa không thể đi đường bộ sao?
Dialogue: 0,0:13:04.51,0:13:06.54,Default,,0000,0000,0000,,Có thể ta sẽ cắt đuôi được\Nđám cảnh sát.
Dialogue: 0,0:13:06.68,0:13:09.88,Default,,0000,0000,0000,,Không, cách đó không được đâu.\NTa không thể vào Dejima bằng đường bộ.
Dialogue: 0,0:13:10.22,0:13:11.94,Default,,0000,0000,0000,,Cách duy nhất\Nlà đường biển.
Dialogue: 0,0:13:12.08,0:13:15.88,Default,,0000,0000,0000,,Hơn nữa, việc lọt qua lưới tuần tra của Cảnh sát biển\Nvà mang plutonium vào...
Dialogue: 0,0:13:15.99,0:13:18.51,Default,,0000,0000,0000,,...là cách hiệu quả nhất\Nđể tuyên bố độc lập.
Dialogue: 0,0:13:19.06,0:13:21.49,Default,,0000,0000,0000,,Việc ta sở hữu vũ khí hạt nhân\Nlà một phần của cuộc kháng nghị chính trị.
Dialogue: 0,0:13:21.93,0:13:25.86,Default,,0000,0000,0000,,Sau cùng thì, vũ khí hạt nhân là công cụ răn đe.\NChúng sinh ra không phải để sử dụng.
Dialogue: 0,0:13:25.93,0:13:27.90,Default,,0000,0000,0000,,Thế thì lại càng là lý do\Nđể bọn tôi đi cùng anh.
Dialogue: 0,0:13:28.37,0:13:31.56,Default,,0000,0000,0000,,Một mình anh thì làm được gì nếu phải giao chiến\Nvới Cảnh sát biển chứ?
Dialogue: 0,0:13:31.97,0:13:33.96,Default,,0000,0000,0000,,Một mình tôi vẫn có thể\Nsống sót trước họ.
Dialogue: 0,0:13:34.11,0:13:36.13,Default,,0000,0000,0000,,Dù thế nào tôi cũng sẽ\Nmang plutonium trở về.
Dialogue: 0,0:13:36.74,0:13:39.07,Default,,0000,0000,0000,,Hai anh đi cùng\Nchỉ làm tôi chậm lại thôi.
Dialogue: 0,0:13:46.45,0:13:50.82,Default,,0000,0000,0000,,Chà, nếu anh đã thẳng thắn như vậy,\Nthì chúng tôi đành phải đặt niềm tin vào anh thôi.
Dialogue: 0,0:13:55.49,0:14:00.02,Default,,0000,0000,0000,,{\i1}Ba triệu người tị nạn đang theo dõi từng cử động{\i0}\N{\i1}của mình trong thời gian thực ngay lúc này.{\i0}
Dialogue: 0,0:14:00.47,0:14:02.70,Default,,0000,0000,0000,,{\i1}Mình không thể lùi bước,{\i0}\N{\i1}không phải lúc này.{\i0}
Dialogue: 0,0:14:09.74,0:14:11.11,Default,,0000,0000,0000,,Trực thăng của Cảnh sát Hokkaido sao?
Dialogue: 0,0:14:11.51,0:14:16.47,Default,,0000,0000,0000,,Cứ như déjà vu vậy... Đêm qua ta chẳng phải\Nvừa thấy cảnh tượng y hệt thế này sao?
Dialogue: 0,0:14:19.35,0:14:23.52,Default,,0000,0000,0000,,{\i1}Trưởng phòng, tôi sẽ ưu tiên cứu chữa y tế{\i0}\N{\i1}cho Batou và Ishikawa lên hàng đầu.{\i0}
Dialogue: 0,0:14:24.09,0:14:27.82,Default,,0000,0000,0000,,{\i1}Còn về chuyện bên Cảnh sát biển,{\i0}\N{\i1}tôi xin lỗi, nhưng ngài hãy liên lạc với họ nhé.{\i0}
Dialogue: 0,0:14:28.33,0:14:31.16,Default,,0000,0000,0000,,{\i1}Tôi sẽ dẫn Paz và Borma theo{\i0}\N{\i1}để kiểm tra Sagawa.{\i0}
Dialogue: 0,0:14:31.53,0:14:33.00,Default,,0000,0000,0000,,{\i1}Có một điều khiến tôi{\i0}\N{\i1}cảm thấy lấn cấn.{\i0}
Dialogue: 0,0:14:33.47,0:14:37.66,Default,,0000,0000,0000,,Được rồi. Nếu Kuze đã nhận được plutonium,
Dialogue: 0,0:14:37.77,0:14:40.17,Default,,0000,0000,0000,,thì ta e rằng Cảnh sát biển\Nsẽ là phòng tuyến cuối cùng của chúng ta.
Dialogue: 0,0:14:40.41,0:14:45.37,Default,,0000,0000,0000,,{\i1}Có khả năng. Họ đã đóng sẵn vài chiếc tàu ngụy trang{\i0}\N{\i1}giống hệt nhau ở Dejima rồi.{\i0}
Dialogue: 0,0:14:45.68,0:14:47.58,Default,,0000,0000,0000,,{\i1}Hãy bảo họ hết sức cẩn trọng.{\i0}
Dialogue: 0,0:14:48.08,0:14:50.71,Default,,0000,0000,0000,,{\i1}Xét theo khoảng cách, tôi nghĩ hắn sẽ mất vài ngày...{\i0}
Dialogue: 0,0:14:50.82,0:14:54.08,Default,,0000,0000,0000,,{\i1}...để chạy về phía nam ngoài vùng lãnh hải của ta{\i0}\N{\i1}và xuất hiện ngoài khơi Nagasaki.{\i0}
Dialogue: 0,0:15:06.03,0:15:09.02,Default,,0000,0000,0000,,Trưởng phòng? Tôi quên mất, hôm nay ta có lịch hẹn\Nvới một thợ chụp ảnh nào không nhỉ?
Dialogue: 0,0:15:09.50,0:15:11.44,Default,,0000,0000,0000,,Thôi nào, cậu bị mất trí nhớ\Nhay sao thế?
Dialogue: 0,0:15:11.57,0:15:13.56,Default,,0000,0000,0000,,Đó là người phụ nữ tiếp quản\NStudio Uesawa đấy.
Dialogue: 0,0:15:13.67,0:15:16.73,Default,,0000,0000,0000,,Chúng ta đã làm ăn với họ\Nsuốt 40 năm nay rồi.
Dialogue: 0,0:15:21.05,0:15:24.41,Default,,0000,0000,0000,,Người tị nạn ư? Có vẻ họ đã tự động hóa\Nquá đà ở nơi này rồi.
Dialogue: 0,0:15:24.78,0:15:27.68,Default,,0000,0000,0000,,Có lẽ họ không thể kiếm sống nếu chỉ dựa\Nvào những tài năng chuyên biệt.
Dialogue: 0,0:15:28.82,0:15:32.15,Default,,0000,0000,0000,,Hai cậu kiểm tra bộ phận Xử lý Dữ liệu\Nvà Quản lý Hồ sơ đi.
Dialogue: 0,0:15:32.52,0:15:34.32,Default,,0000,0000,0000,,Tôi sẽ lo phòng chủ tịch.
Dialogue: 0,0:15:34.76,0:15:37.79,Default,,0000,0000,0000,,Nếu thương vụ này do CIS dàn dựng,
Dialogue: 0,0:15:37.90,0:15:40.96,Default,,0000,0000,0000,,thì có khả năng cao là Kuze\Nchưa hề nhận được plutonium.
Dialogue: 0,0:15:41.07,0:15:42.66,Default,,0000,0000,0000,,Tôi muốn tìm bằng chứng\Nvề chuyện đó.
Dialogue: 0,0:15:43.34,0:15:46.46,Default,,0000,0000,0000,,Rất có thể Gohda đã đạt được mục đích của hắn, nhưng có lẽ...
Dialogue: 0,0:15:46.57,0:15:50.41,Default,,0000,0000,0000,,...hắn đang cố tạo ra một sự đã rồi rằng đám tị nạn đã có vũ khí hạt nhân...
Dialogue: 0,0:15:50.64,0:15:53.74,Default,,0000,0000,0000,,...để đảm bảo Quân Phòng vệ chắc chắn sẽ được điều động.
Dialogue: 0,0:15:54.15,0:15:55.74,Default,,0000,0000,0000,,Tìm kiếm chút gì đó\Nrồi quay về thôi.
Dialogue: 0,0:15:55.85,0:15:56.94,Default,,0000,0000,0000,,- Rõ, thưa Thiếu tá.\N- Rõ, thưa Thiếu tá.
Dialogue: 0,0:15:57.62,0:16:00.64,Default,,0000,0000,0000,,{\i1}Nếu mọi chuyện cứ tiếp diễn thế này, nội chiến{\i0}\N{\i1}với người tị nạn sẽ trở thành hiện thực,{\i0}
Dialogue: 0,0:16:00.75,0:16:03.55,Default,,0000,0000,0000,,{\i1}và kế hoạch tăng cường quân sự của chính quyền{\i0}\N{\i1}hiện tại sẽ thành công tốt đẹp.{\i0}
Dialogue: 0,0:16:03.99,0:16:08.62,Default,,0000,0000,0000,,{\i1}Nhưng vấn đề tị nạn đang ngày một tồi tệ hơn...{\i0}\N{\i1}Ngươi định giải quyết nó thế nào đây, Gohda?{\i0}
Dialogue: 0,0:16:26.38,0:16:30.58,Default,,0000,0000,0000,,Kia hẳn là Kagazaki. Nhưng trông như đây\Nchỉ là một cơ thể người máy tạm thời...
Dialogue: 0,0:16:31.18,0:16:36.12,Default,,0000,0000,0000,,Hắn cố đổi về cơ thể chính để trốn chạy,\Nnhưng rốt cuộc lại bị giết chết.
Dialogue: 0,0:16:41.69,0:16:43.59,Default,,0000,0000,0000,,Và kia hẳn là Jabrov\Ncùng thuộc hạ của hắn.
Dialogue: 0,0:16:44.50,0:16:46.93,Default,,0000,0000,0000,,Có vẻ sự tự động hóa ở nơi này\Nđã trở thành cái bẫy chôn vùi họ.
Dialogue: 0,0:16:47.17,0:16:50.50,Default,,0000,0000,0000,,Họ đã bị trừ khử mà chẳng ai hay biết,\Ngiống hệt như Krolden.
Dialogue: 0,0:16:53.87,0:16:59.17,Default,,0000,0000,0000,,Mọi thứ đã bị xóa sạch. Nghĩa là dữ liệu tôi lấy từ Krolden\Nlà manh mối duy nhất còn lại.
Dialogue: 0,0:17:00.18,0:17:02.04,Default,,0000,0000,0000,,{\i1}Paz, Borma.{\i0}\N{\i1}Tình hình bên các cậu thế nào rồi?{\i0}
Dialogue: 0,0:17:02.51,0:17:05.24,Default,,0000,0000,0000,,{\i1}Ở đây chỉ còn lại hồ sơ{\i0}\N{\i1}liên quan đến công ty thôi.{\i0}
Dialogue: 0,0:17:05.78,0:17:08.58,Default,,0000,0000,0000,,{\i1}Có dấu vết cho thấy một lượng lớn{\i0}\N{\i1}dữ liệu đã bị xóa sạch,{\i0}
Dialogue: 0,0:17:08.72,0:17:10.75,Default,,0000,0000,0000,,{\i1}nhưng có vẻ rất khó{\i0}\N{\i1}để khôi phục lại.{\i0}
Dialogue: 0,0:17:11.16,0:17:12.59,Default,,0000,0000,0000,,Bên này cũng\Ny như vậy.
Dialogue: 0,0:17:12.69,0:17:13.75,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:17:14.19,0:17:18.19,Default,,0000,0000,0000,,{\i1}Nhìn tình hình ở đây, có vẻ thương vụ đã diễn ra{\i0}\N{\i1}dưới sự kiểm soát của CIS,{\i0}
Dialogue: 0,0:17:18.53,0:17:21.52,Default,,0000,0000,0000,,{\i1}nhưng chẳng có bằng chứng nào cho thấy{\i0}\N{\i1}họ là kẻ đã điều khiển Koil.{\i0}
Dialogue: 0,0:17:22.07,0:17:24.30,Default,,0000,0000,0000,,{\i1}Sau khi ghi lại hiện trường,{\i0}\N{\i1}tạm thời ta sẽ quay về tổng hành dinh.{\i0}
Dialogue: 0,0:17:24.54,0:17:25.63,Default,,0000,0000,0000,,{\i1}- Rõ rồi.{\i0}\N{\i1}- Rõ.{\i0}
Dialogue: 0,0:17:26.44,0:17:29.24,Default,,0000,0000,0000,,Chúng ta vẫn đang nhảy múa\Ntheo điệu nhạc của Gohda nhỉ?
Dialogue: 0,0:17:33.08,0:17:36.24,Default,,0000,0000,0000,,Còn anh định làm gì đây,\NKuze?
Dialogue: 0,0:17:49.93,0:17:55.03,Default,,0000,0000,0000,,Đừng lo, tôi ổn. Ba ngày chưa đủ để làm quen\Nvới các bộ phận mới thôi, chỉ có vậy.
Dialogue: 0,0:17:58.97,0:18:01.20,Default,,0000,0000,0000,,Tình hình sức khỏe của lão làng thế nào rồi?
Dialogue: 0,0:18:01.64,0:18:04.37,Default,,0000,0000,0000,,May mắn là não bộ của anh ấy\Nkhông gặp vấn đề gì.
Dialogue: 0,0:18:04.84,0:18:06.83,Default,,0000,0000,0000,,Khoảng một tháng nữa là anh ấy\Nsẽ hồi phục như mới thôi.
Dialogue: 0,0:18:08.31,0:18:11.28,Default,,0000,0000,0000,,Chúng ta đã chịu tổn thất nặng nề\Ntrong suốt vụ án này.
Dialogue: 0,0:18:11.95,0:18:15.85,Default,,0000,0000,0000,,Một đồng đội hy sinh, một người bị thương,\Nvà ta cũng mất luôn chiếc máy bay cánh xoay.
Dialogue: 0,0:18:15.95,0:18:18.51,Default,,0000,0000,0000,,Có thể coi đây là\Nmột thất bại thảm hại.
Dialogue: 0,0:18:21.13,0:18:24.19,Default,,0000,0000,0000,,Tàu của Kuze vẫn chưa\Nxuất hiện sao?
Dialogue: 0,0:18:24.86,0:18:27.30,Default,,0000,0000,0000,,Hắn vẫn chưa lọt vào\Nlưới của Cảnh sát biển.
Dialogue: 0,0:18:27.97,0:18:30.43,Default,,0000,0000,0000,,Bên phía chính phủ cũng chưa có\Nhành động công khai nào.
Dialogue: 0,0:18:30.77,0:18:33.50,Default,,0000,0000,0000,,Hiện tại đám tị nạn đang cư xử rất chừng mực,
Dialogue: 0,0:18:33.61,0:18:38.70,Default,,0000,0000,0000,,và quan điểm chiếm ưu thế là có rất ít lý do\Nđể điều động Quân Phòng vệ.
Dialogue: 0,0:18:39.88,0:18:42.85,Default,,0000,0000,0000,,Dù không chính thức, nhưng chính phủ Trung Quốc\Ncó vẻ đang lo ngại...
Dialogue: 0,0:18:42.95,0:18:45.64,Default,,0000,0000,0000,,...về cách ứng phó với khu tự trị.
Dialogue: 0,0:18:46.08,0:18:47.45,Default,,0000,0000,0000,,\"Khu tự trị\" hả?
Dialogue: 0,0:18:47.55,0:18:51.49,Default,,0000,0000,0000,,Họ từ chối tiếp nhận người tị nạn,\Nnên hẳn là đang cố tìm cách giữ thân an toàn.
Dialogue: 0,0:18:51.92,0:18:54.12,Default,,0000,0000,0000,,Việc Thủ tướng Kayabuki được cho là\Nthân Trung Quốc...
Dialogue: 0,0:18:54.26,0:18:57.46,Default,,0000,0000,0000,,...có thể là động lực thúc đẩy\Nnhững bình luận từ phía Trung Quốc.
Dialogue: 0,0:18:57.93,0:19:01.16,Default,,0000,0000,0000,,Lúc này, chỉ có một số ít người\Ntrong Cảnh sát biển...
Dialogue: 0,0:19:01.27,0:19:05.86,Default,,0000,0000,0000,,...nắm được khả năng con tàu ngụy trang\Ncó thể đang chở plutonium.
Dialogue: 0,0:19:06.24,0:19:09.70,Default,,0000,0000,0000,,Tuy nhiên, dường như vài nghị sĩ\Nnhư Kanzaki...
Dialogue: 0,0:19:09.81,0:19:12.47,Default,,0000,0000,0000,,...đã đánh hơi được chuyện này\Nqua các kênh riêng của họ.
Dialogue: 0,0:19:12.74,0:19:16.04,Default,,0000,0000,0000,,Do đó, chúng ta nên hiểu rằng vài nhân vật\Ntrong đảng cầm quyền...
Dialogue: 0,0:19:16.15,0:19:18.31,Default,,0000,0000,0000,,...cũng đã nắm được tình hình.
Dialogue: 0,0:19:18.88,0:19:21.88,Default,,0000,0000,0000,,Tôi tự hỏi liệu lý do Chánh Văn phòng Nội các\NTakakura không có động thái gì bất chấp điều đó...
Dialogue: 0,0:19:22.32,0:19:26.02,Default,,0000,0000,0000,,...có phải là vì nếu plutonium được đưa vào Dejima\Ntheo đúng kịch bản của CIS,
Dialogue: 0,0:19:26.26,0:19:31.72,Default,,0000,0000,0000,,nó sẽ trở thành một {\i1}sự đã rồi,{\i0} qua đó xóa bỏ\Nmọi rào cản đối với việc điều động Quân Phòng vệ?
Dialogue: 0,0:19:31.90,0:19:33.89,Default,,0000,0000,0000,,Nói ngắn gọn thì\Nđúng là như vậy đấy.
Dialogue: 0,0:19:35.03,0:19:39.16,Default,,0000,0000,0000,,Trên một số diễn đàn mạng, người ta đã bắt đầu\Nlàm ầm lên về khả năng...
Dialogue: 0,0:19:39.50,0:19:44.87,Default,,0000,0000,0000,,...một thương vụ plutonium đã diễn ra\Ngiữa Mafia Nga và người tị nạn.
Dialogue: 0,0:19:45.68,0:19:48.51,Default,,0000,0000,0000,,Và nếu đúng là như vậy, bước đi tiếp theo\Ncủa người tị nạn sẽ là gì?
Dialogue: 0,0:19:48.85,0:19:54.81,Default,,0000,0000,0000,,Nếu cô nói đúng và Kuze chưa nhận được plutonium,\Ncô nghĩ hắn sẽ làm gì, Thiếu tá?
Dialogue: 0,0:19:56.62,0:20:02.72,Default,,0000,0000,0000,,Hắn kéo dài được đến mức này là nhờ sức hút độc nhất\Nvà sự tháo vát phi thường của mình,
Dialogue: 0,0:20:02.86,0:20:05.30,Default,,0000,0000,0000,,chứ không phải nhờ khả năng đánh giá tình hình chính xác.
Dialogue: 0,0:20:05.43,0:20:07.46,Default,,0000,0000,0000,,Nhưng sau cùng thì,\Nhắn cũng chỉ là một tên khủng bố.
Dialogue: 0,0:20:08.03,0:20:10.16,Default,,0000,0000,0000,,Xét cả về chiến lược lẫn sức mạnh chiến đấu,
Dialogue: 0,0:20:10.40,0:20:13.60,Default,,0000,0000,0000,,Gohda nắm giữ thế thượng phong\Nnhờ sự hậu thuẫn từ chính phủ.
Dialogue: 0,0:20:14.31,0:20:18.47,Default,,0000,0000,0000,,Kết quả là, các hành động của Kuze\Nđều đi theo kịch bản mà Gohda đã vạch ra...
Dialogue: 0,0:20:18.61,0:20:22.67,Default,,0000,0000,0000,,...và hắn đang đóng vai trò thúc đẩy tình hình\Nphát triển theo đúng ý đồ của Gohda.
Dialogue: 0,0:20:23.08,0:20:26.28,Default,,0000,0000,0000,,Nhưng thực tế là,\Nhắn không nằm dưới sự kiểm soát của Gohda.
Dialogue: 0,0:20:27.72,0:20:33.02,Default,,0000,0000,0000,,Nếu có yếu tố nào có thể đảo ngược tình thế,\Nthì chính là hành động của hắn.
Dialogue: 0,0:20:33.79,0:20:40.13,Default,,0000,0000,0000,,Nghe có vẻ kỳ lạ, nhưng chuyện này cũng có thể\Nlà kết quả của một phức cảm độc lập (standalone complex).
Dialogue: 0,0:20:45.54,0:20:49.27,Default,,0000,0000,0000,,Trưởng phòng, chúng ta vừa nhận được báo cáo\Ntừ một tàu tuần tra Cảnh sát biển...
Dialogue: 0,0:20:49.37,0:20:53.28,Default,,0000,0000,0000,,...rằng họ đã phát hiện thứ dường như là\Ncon tàu ngụy trang của Kuze...
Dialogue: 0,0:20:53.51,0:20:56.50,Default,,0000,0000,0000,,...ở gần Amakusanada, ngoài khơi bờ biển Nagasaki.
Dialogue: 0,0:20:57.52,0:20:59.61,Default,,0000,0000,0000,,Họ có đang chuyển tiếp\Ntình hình cho chúng ta không?
Dialogue: 0,0:20:59.79,0:21:03.19,Default,,0000,0000,0000,,Có, thưa Trưởng phòng. Có nguồn cấp video\Ntrực tiếp từ tàu tuần tra.
Dialogue: 0,0:21:03.66,0:21:05.32,Default,,0000,0000,0000,,Chuyển tiếp lên màn hình\Nở đây đi.
Dialogue: 0,0:21:05.46,0:21:06.82,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:21:13.03,0:21:14.36,Default,,0000,0000,0000,,Trông họ chẳng có vẻ gì\Nlà muốn dừng lại cả...
Dialogue: 0,0:21:14.47,0:21:18.49,Default,,0000,0000,0000,,Tôi không nghĩ đe dọa sẽ có tác dụng đâu...\NCho tàu áp sát hơn đi.
Dialogue: 0,0:21:18.67,0:21:20.30,Default,,0000,0000,0000,,Rõ, thưa Thuyền trưởng.\NTiếp cận gần hơn!
Dialogue: 0,0:21:20.54,0:21:22.10,Default,,0000,0000,0000,,Chuẩn bị hỏa lực diệt hạm!
Dialogue: 0,0:21:22.17,0:21:23.30,Default,,0000,0000,0000,,Hỏa lực diệt hạm!
Dialogue: 0,0:21:23.41,0:21:24.47,Default,,0000,0000,0000,,Hỏa lực diệt hạm!
Dialogue: 0,0:21:24.68,0:21:26.01,Default,,0000,0000,0000,,Khai hỏa!
Dialogue: 0,0:21:28.51,0:21:29.31,Default,,0000,0000,0000,,Bắn trúng hắn chưa?
Dialogue: 0,0:21:29.41,0:21:30.40,Default,,0000,0000,0000,,Đã bắn trúng mục tiêu!
Dialogue: 0,0:21:30.62,0:21:31.95,Default,,0000,0000,0000,,Xác nhận trúng đích trực diện!
Dialogue: 0,0:21:39.19,0:21:40.35,Default,,0000,0000,0000,,Họ đang bắn\Nvào chúng ta!
Dialogue: 0,0:21:43.03,0:21:45.29,Default,,0000,0000,0000,,Mạn phải của ta đã trúng đạn!\NMạn phải của tàu đang bị bắn!
Dialogue: 0,0:21:46.03,0:21:48.97,Default,,0000,0000,0000,,Chúng ta hiện đang bị tấn công.\NCho phép các anh bắn trả để tự vệ!
Dialogue: 0,0:21:49.07,0:21:50.09,Default,,0000,0000,0000,,Bắn đi!
Dialogue: 0,0:21:50.20,0:21:51.29,Default,,0000,0000,0000,,Bắn! Bắn!
Dialogue: 0,0:21:54.81,0:21:56.90,Default,,0000,0000,0000,,Cẩn thận! Tránh xa\Ncác thùng nhiên liệu ra!
Dialogue: 0,0:21:57.18,0:21:59.47,Default,,0000,0000,0000,,Lỡ số plutonium đó\Nbị nổ tung lên trời thì sao hả?!
Dialogue: 0,0:22:00.65,0:22:04.31,Default,,0000,0000,0000,,Không ổn rồi. Đoạn phim này cũng sẽ\Nlọt vào tay truyền thông thôi.
Dialogue: 0,0:22:04.65,0:22:06.31,Default,,0000,0000,0000,,Hỏa hoạn đã bùng phát\Ntrên tàu!
Dialogue: 0,0:22:06.45,0:22:09.22,Default,,0000,0000,0000,,Bắt giữ thủy thủ đoàn của nó!\NÁp sát tàu vào!
Dialogue: 0,0:22:13.46,0:22:15.15,Default,,0000,0000,0000,,Tiến lại gần hơn nữa!\NBắt chúng lại!
Dialogue: 0,0:22:15.26,0:22:17.02,Default,,0000,0000,0000,,Này, ngoài kia có chuyện gì\Nxảy ra thế?
Dialogue: 0,0:22:17.56,0:22:20.05,Default,,0000,0000,0000,,Cái quái gì vậy?\NThuyền trưởng!
Dialogue: 0,0:22:20.47,0:22:21.52,Default,,0000,0000,0000,,Có chuyện gì?
Dialogue: 0,0:22:21.67,0:22:22.83,Default,,0000,0000,0000,,Là Nagasaki!
Dialogue: 0,0:22:23.50,0:22:24.63,Default,,0000,0000,0000,,Nagasaki thì sao?
Dialogue: 0,0:22:24.74,0:22:27.10,Default,,0000,0000,0000,,Đèn đang tắt dần kìa!
Dialogue: 0,0:22:36.85,0:22:38.18,Default,,0000,0000,0000,,Cái gì cơ...?
Dialogue: 0,0:22:40.39,0:22:43.18,Default,,0000,0000,0000,,Đám tị nạn đã kích hoạt\Nmất điện diện rộng sao?
Dialogue: 0,0:22:43.59,0:22:45.45,Default,,0000,0000,0000,,Chúng làm vậy\Nđể giúp Kuze à?
Dialogue: 0,0:22:45.66,0:22:49.12,Default,,0000,0000,0000,,Tôi khó mà tin nổi đám tị nạn lại có khả năng\Ndàn dựng một vụ lớn đến thế này.
Dialogue: 0,0:22:49.59,0:22:50.58,Default,,0000,0000,0000,,Vậy thì ai...
Dialogue: 0,0:22:50.80,0:22:56.06,Default,,0000,0000,0000,,Nằm ở cuối chu kỳ thù hận này là một vũng lầy\Nchiến tranh với người tị nạn...
Dialogue: 0,0:22:56.06,0:22:58.06,Default,,0000,0000,0000,,
