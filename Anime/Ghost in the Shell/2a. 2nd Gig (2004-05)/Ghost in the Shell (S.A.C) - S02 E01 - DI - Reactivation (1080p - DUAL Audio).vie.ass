Dialogue: 0,0:02:02.09,0:02:04.49,Default,,0000,0000,0000,,Vậy, cậu thấy tình hình\Nlúc này thế nào rồi?
Dialogue: 0,0:02:04.49,0:02:06.50,Default,,0000,0000,0000,,Bọn chúng đến nhanh hơn\Ntôi dự đoán đấy.
Dialogue: 0,0:02:06.50,0:02:09.99,Default,,0000,0000,0000,,Bọn chúng đâu có ngu. Phải nhận thức được\Nmức độ nghiêm trọng của vụ này chứ.
Dialogue: 0,0:02:10.40,0:02:16.13,Default,,0000,0000,0000,,Với các chiến dịch chống khủng bố của cảnh sát,\Nđây thường là lúc bắt đầu màn giằng co chờ đợi.
Dialogue: 0,0:02:40.20,0:02:42.13,Default,,0000,0000,0000,,{\i1}Được rồi mọi người, chuẩn bị{\i0}\N{\i1}lặn vào não điện tử.{\i0}
Dialogue: 0,0:02:42.93,0:02:45.59,Default,,0000,0000,0000,,{\i1}Nhớ bật hết các tường lửa{\i0}\N{\i1}chống hack ngược lên đấy.{\i0}
Dialogue: 0,0:02:54.54,0:02:58.68,Default,,0000,0000,0000,,{\i1}23 phút trước, một nhóm tội phạm{\i0}\N{\i1}vũ trang hạng nặng...{\i0}
Dialogue: 0,0:02:58.68,0:03:02.01,Default,,0000,0000,0000,,{\i1}...đã chiếm giữ Đại sứ quán Trung Quốc,{\i0}\N{\i1}nằm ở tầng 46 của tòa nhà này.{\i0}
Dialogue: 0,0:03:02.32,0:03:05.09,Default,,0000,0000,0000,,{\i1}Hiện tại vẫn chưa rõ{\i0}\N{\i1}có bao nhiêu con tin,{\i0}
Dialogue: 0,0:03:05.09,0:03:10.22,Default,,0000,0000,0000,,{\i1}nhưng đã xác nhận có ít nhất mười nhân viên{\i0}\N{\i1}vẫn còn bên trong vào thời điểm xảy ra vụ việc.{\i0}
Dialogue: 0,0:03:10.79,0:03:13.26,Default,,0000,0000,0000,,{\i1}Tương tự, số lượng tên khủng bố{\i0}\N{\i1}trong nhóm cũng chưa xác định được.{\i0}
Dialogue: 0,0:03:14.53,0:03:17.56,Default,,0000,0000,0000,,{\i1}Dù chưa rõ con số đó có phải{\i0}\N{\i1}chỉ số lượng thành viên hay không,{\i0}
Dialogue: 0,0:03:18.07,0:03:23.03,Default,,0000,0000,0000,,{\i1}nhưng trong tuyên bố nhận trách nhiệm,{\i0}\N{\i1}chúng tự xưng là \"Nhóm 11 Cá Nhân\".{\i0}
Dialogue: 0,0:03:24.14,0:03:26.40,Default,,0000,0000,0000,,{\i1}Cố thủ bên trong{\i0}\N{\i1}đại sứ quán sao?{\i0}
Dialogue: 0,0:03:27.38,0:03:31.68,Default,,0000,0000,0000,,{\i1}Thế này nghĩa là lệnh tạm đình chỉ vô thời hạn{\i0}\N{\i1}của Đội 9 có thể sẽ được dỡ bỏ rồi nhỉ?{\i0}
Dialogue: 0,0:03:31.98,0:03:35.44,Default,,0000,0000,0000,,{\i1}Khi chưa nhận được lệnh xuất quân chính thức,{\i0}\N{\i1}tôi chưa thể nói trước điều gì.{\i0}
Dialogue: 0,0:03:36.25,0:03:39.38,Default,,0000,0000,0000,,{\i1}Vậy nhóm 11 Cá Nhân đó{\i0}\N{\i1}đang đòi hỏi yêu sách gì?{\i0}
Dialogue: 0,0:03:39.86,0:03:42.45,Default,,0000,0000,0000,,{\i1}Lập tức dừng việc tiếp nhận{\i0}\N{\i1}người tị nạn châu Á,{\i0}
Dialogue: 0,0:03:42.66,0:03:47.65,Default,,0000,0000,0000,,{\i1}đồng thời đóng cửa hoàn toàn 5 khu lưu trú{\i0}\N{\i1}người tị nạn rải rác trên toàn quốc.{\i0}
Dialogue: 0,0:03:48.16,0:03:51.83,Default,,0000,0000,0000,,{\i1}Đùa nhau chắc? Chúng nghĩ cần bao lâu{\i0}\N{\i1}thì ta mới thực hiện được điều đó chứ?!{\i0}
Dialogue: 0,0:03:52.30,0:03:55.34,Default,,0000,0000,0000,,{\i1}Chính phủ Trung Quốc vốn liên tục mở các chuyến bay{\i0}\N{\i1}định kỳ đưa người sang đảo Dejima...{\i0}
Dialogue: 0,0:03:55.34,0:03:59.30,Default,,0000,0000,0000,,{\i1}...để tránh phải tiếp nhận làn sóng tị nạn khổng lồ{\i0}\N{\i1}từ châu Á tràn sang,{\i0}
Dialogue: 0,0:03:59.54,0:04:02.41,Default,,0000,0000,0000,,{\i1}nên phen này coi như họ bị vạ lây{\i0}\N{\i1}giữa lằn ranh xung đột rồi.{\i0}
Dialogue: 0,0:04:02.71,0:04:04.91,Default,,0000,0000,0000,,{\i1}Nếu xét theo lẽ thường{\i0}\N{\i1}thì đúng là như vậy.{\i0}
Dialogue: 0,0:04:05.28,0:04:08.82,Default,,0000,0000,0000,,{\i1}Nhưng khi chưa rõ động cơ thực sự của chúng,{\i0}\N{\i1}chúng ta không nên vội vã kết luận.{\i0}
Dialogue: 0,0:04:08.82,0:04:10.29,Default,,0000,0000,0000,,{\i1}Ishikawa,{\i0}\N{\i1}tình hình sao rồi?{\i0}
Dialogue: 0,0:04:10.92,0:04:13.41,Default,,0000,0000,0000,,{\i1}Tôi đã nghe lén toàn bộ trang thiết bị{\i0}\N{\i1}trong tòa nhà này rồi.{\i0}
Dialogue: 0,0:04:13.72,0:04:15.43,Default,,0000,0000,0000,,{\i1}Phía cảnh sát địa phương{\i0}\N{\i1}đang bố trí thế nào?{\i0}
Dialogue: 0,0:04:15.43,0:04:19.19,Default,,0000,0000,0000,,{\i1}Có vẻ họ đang phát sóng phá sóng diện rộng{\i0}\N{\i1}kèm theo lệnh phong tỏa báo chí.{\i0}
Dialogue: 0,0:04:19.60,0:04:24.43,Default,,0000,0000,0000,,{\i1}Việc đó đang gây nhiễu sóng vô tuyến. Sắp tới liên lạc não{\i0}\N{\i1}của chúng ta khả năng cũng sẽ dính tạp âm đấy.{\i0}
Dialogue: 0,0:04:24.97,0:04:27.24,Default,,0000,0000,0000,,{\i1}Mọi camera an ninh trong đại sứ quán{\i0}\N{\i1}đều đã bị phá hủy.{\i0}
Dialogue: 0,0:04:27.24,0:04:32.17,Default,,0000,0000,0000,,{\i1}Bọn chúng đang đàm phán với cảnh sát{\i0}\N{\i1}qua một đường dây điện thoại không có hình ảnh.{\i0}
Dialogue: 0,0:04:32.48,0:04:35.91,Default,,0000,0000,0000,,{\i1}Được rồi, cắm nghe lén được dây đó rồi{\i0}\N{\i1}thì rút về xe ngụy trang đi.{\i0}
Dialogue: 0,0:04:35.91,0:04:37.07,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:04:38.21,0:04:39.24,Default,,0000,0000,0000,,{\i1}Saito!{\i0}
Dialogue: 0,0:04:39.75,0:04:41.58,Default,,0000,0000,0000,,{\i1}Tôi đã tới vị trí{\i0}\N{\i1}được chỉ định.{\i0}
Dialogue: 0,0:04:42.79,0:04:44.82,Default,,0000,0000,0000,,{\i1}Cửa sổ tòa nhà đang bị che kín{\i0}\N{\i1}bởi rèm chắn quang học,{\i0}
Dialogue: 0,0:04:44.82,0:04:46.48,Default,,0000,0000,0000,,{\i1}nên tôi không thể quan sát{\i0}\N{\i1}tình hình bên trong.{\i0}
Dialogue: 0,0:04:48.19,0:04:50.26,Default,,0000,0000,0000,,{\i1}Tôi đang ưu tiên hàng đầu{\i0}\N{\i1}để vô hiệu hóa lớp rèm đó.{\i0}
Dialogue: 0,0:04:50.26,0:04:51.19,Default,,0000,0000,0000,,{\i1}Tốt.{\i0}
Dialogue: 0,0:04:51.49,0:04:55.90,Default,,0000,0000,0000,,{\i1}Những người còn lại, chuẩn bị sẵn sàng đột kích và{\i0}\N{\i1}chờ lệnh. Chúng ta sẽ đợi chỉ thị từ Trưởng ban.{\i0}
Dialogue: 0,0:04:56.90,0:04:58.13,Default,,0000,0000,0000,,{\i1}Tuy nhiên...{\i0}
Dialogue: 0,0:04:59.00,0:05:01.60,Default,,0000,0000,0000,,{\i1}Nếu Trưởng ban không thuyết phục được{\i0}\N{\i1}giới chóp bu trên đó,{\i0}
Dialogue: 0,0:05:01.60,0:05:06.27,Default,,0000,0000,0000,,{\i1}chúng ta sẽ rút khỏi vụ giám sát này{\i0}\N{\i1}và đi uống rượu giải sầu ở quán bar thoát y.{\i0}
Dialogue: 0,0:05:08.54,0:05:12.24,Default,,0000,0000,0000,,{\i1}Thời điểm{\i0} xảy ra vụ khủng bố này\Nmới chính là vấn đề nan giải.
Dialogue: 0,0:05:12.48,0:05:17.42,Default,,0000,0000,0000,,Chính phủ dự định sẽ tuyên bố\Ntrong bài phát biểu chính sách sắp tới...
Dialogue: 0,0:05:17.42,0:05:21.58,Default,,0000,0000,0000,,...rằng chúng ta sẽ bãi bỏ\NChính sách Đặc biệt về Người tị nạn.
Dialogue: 0,0:05:21.89,0:05:24.43,Default,,0000,0000,0000,,Đồng thời đình chỉ vô thời hạn việc tiếp nhận\Nlàn sóng người tị nạn không ngừng đổ vào...
Dialogue: 0,0:05:24.43,0:05:28.23,Default,,0000,0000,0000,,...cũng như từng bước thu hẹp\Ncác khu lưu trú tị nạn.
Dialogue: 0,0:05:28.60,0:05:32.90,Default,,0000,0000,0000,,Bà muốn tránh để dư luận có ấn tượng rằng\Nchuyển biến chính sách lớn đầu tiên...
Dialogue: 0,0:05:33.20,0:05:37.30,Default,,0000,0000,0000,,...về vấn đề người tị nạn thời hậu chiến\Nlại là hệ quả của việc nhượng bộ khủng bố.
Dialogue: 0,0:05:37.61,0:05:40.91,Default,,0000,0000,0000,,Để làm được điều đó, bà cần phải\Nvô hiệu hóa bọn khủng bố...
Dialogue: 0,0:05:40.91,0:05:43.64,Default,,0000,0000,0000,,...trước khi yêu sách của chúng\Nbị rò rỉ ra ngoài truyền thông.
Dialogue: 0,0:05:44.58,0:05:48.57,Default,,0000,0000,0000,,Tôi đoán việc mình được triệu tập tới đây\Ncũng liên quan đến chuyện đó, phải không?
Dialogue: 0,0:05:49.22,0:05:52.05,Default,,0000,0000,0000,,Đúng như lời đồn đại.\NTrưởng ban quả là người sắc sảo.
Dialogue: 0,0:05:52.36,0:05:54.96,Default,,0000,0000,0000,,Không cần phải lãng phí thời gian\Ncho những lời tâng bốc đâu.
Dialogue: 0,0:05:54.96,0:05:57.36,Default,,0000,0000,0000,,Vấn đề này đòi hỏi\Nphải được xử lý ngay lập tức.
Dialogue: 0,0:05:58.09,0:06:01.69,Default,,0000,0000,0000,,Được thôi. Vậy tôi xin đi thẳng\Nvào vấn đề chính.
Dialogue: 0,0:06:02.63,0:06:08.43,Default,,0000,0000,0000,,Tôi sẵn sàng ủng hộ dự toán ngân sách tái lập Đội 9\Ncủa ông trong kỳ họp quốc hội tới.
Dialogue: 0,0:06:09.21,0:06:14.94,Default,,0000,0000,0000,,Nhưng với điều kiện {\i1}duy nhất{\i0} là không một con tin nào\Nđược phép thiệt mạng trong quá trình triệt hạ bọn khủng bố.
Dialogue: 0,0:06:15.31,0:06:17.35,Default,,0000,0000,0000,,Đó là điều kiện tiên quyết.
Dialogue: 0,0:06:17.35,0:06:22.19,Default,,0000,0000,0000,,Chỉ cần bà ban lệnh xuất quân, chúng tôi\Nsẽ đáp ứng yêu cầu đó bất cứ lúc nào.
Dialogue: 0,0:06:22.19,0:06:24.18,Default,,0000,0000,0000,,Đừng nóng vội thế,\NAramaki.
Dialogue: 0,0:06:24.62,0:06:27.92,Default,,0000,0000,0000,,Chúng tôi mới vừa bắt đầu chạy đôn chạy đáo\Nliên hệ các ban ngành liên quan...
Dialogue: 0,0:06:27.92,0:06:32.16,Default,,0000,0000,0000,,...để gom đủ chữ ký cần thiết cho việc\Ntu chính Dự luật Lực lượng Đặc nhiệm.
Dialogue: 0,0:06:32.43,0:06:34.50,Default,,0000,0000,0000,,Đến giờ này các vị mới bắt đầu\Nlàm thủ tục giấy tờ {\i1}sao?{\i0}
Dialogue: 0,0:06:34.50,0:06:37.30,Default,,0000,0000,0000,,Ngài thực sự nghĩ chúng ta có được\Nsự xa xỉ về mặt thời gian như thế à?
Dialogue: 0,0:06:37.30,0:06:39.34,Default,,0000,0000,0000,,Nếu ông phái đội của mình vào\Nmà không có ủy quyền,
Dialogue: 0,0:06:39.34,0:06:44.24,Default,,0000,0000,0000,,...thì tôi có thể hình dung ra cảnh tượng truyền thông sẽ xâu xé\Nngay cả khi các ông có hoàn thành nhiệm vụ {\i1}đi chăng nữa{\i0}.
Dialogue: 0,0:06:44.74,0:06:48.14,Default,,0000,0000,0000,,Nên nhớ rằng, vụ bê bối của Đội 9\Nxảy ra cách đây chưa bao lâu đâu.
Dialogue: 0,0:06:48.51,0:06:52.55,Default,,0000,0000,0000,,Cho đến khi yêu cầu ủy quyền tu chính tạm thời của dự luật\Nđược thông qua,
Dialogue: 0,0:06:52.55,0:06:54.35,Default,,0000,0000,0000,,người của ông tuyệt đối\Nkhông được phép can thiệp.
Dialogue: 0,0:06:55.35,0:06:58.75,Default,,0000,0000,0000,,Thành thật xin lỗi, nhưng những gì Bộ trưởng\NNội vụ vừa nói là hoàn toàn chính xác.
Dialogue: 0,0:06:59.72,0:07:02.66,Default,,0000,0000,0000,,Xin ông hãy tiếp tục chờ lệnh cho đến khi\Nchúng tôi hoàn tất mọi thủ tục giấy tờ.
Dialogue: 0,0:07:06.63,0:07:07.69,Default,,0000,0000,0000,,Có tin tức gì chưa?
Dialogue: 0,0:07:09.97,0:07:11.90,Default,,0000,0000,0000,,Chưa có một mẩu tin nào cả.
Dialogue: 0,0:07:12.27,0:07:17.50,Default,,0000,0000,0000,,Trời ạ, tôi chỉ muốn xông vào làm một trận khủng bố\Ncái Nội các toàn những kẻ nhát gan đó cho rồi!
Dialogue: 0,0:07:17.94,0:07:21.01,Default,,0000,0000,0000,,Chúng ta là một lực lượng vũ trang không chính thức\Ntự ý điều động quân...
Dialogue: 0,0:07:21.01,0:07:22.71,Default,,0000,0000,0000,,...mà Sở Cảnh sát Đô thị\Nhoàn toàn không hay biết.
Dialogue: 0,0:07:23.21,0:07:27.01,Default,,0000,0000,0000,,Xét theo tình cảnh hiện tại,\Nchúng ta chẳng khác nào khủng bố rồi còn gì.
Dialogue: 0,0:07:28.92,0:07:31.02,Default,,0000,0000,0000,,Nghĩ lại thì thấy đúng là mỉa mai thật.
Dialogue: 0,0:07:31.02,0:07:35.86,Default,,0000,0000,0000,,Nội các Kayabuki này kế nhiệm từ chính phủ tiền nhiệm,\Ncái gọi là \"Chính quyền Yakushima\",
Dialogue: 0,0:07:36.36,0:07:38.76,Default,,0000,0000,0000,,vốn được coi là một chính quyền bảo thủ phản động...
Dialogue: 0,0:07:38.76,0:07:41.23,Default,,0000,0000,0000,,...đi ngược lại đường lối dân chủ thời hậu chiến, phải không?
Dialogue: 0,0:07:41.90,0:07:48.06,Default,,0000,0000,0000,,Thậm chí trong bài diễn văn nhậm chức, bà ta còn hứa\Nsẽ từng bước xóa bỏ chính sách tị nạn nữa cơ mà.
Dialogue: 0,0:07:48.34,0:07:49.91,Default,,0000,0000,0000,,Dù bọn chúng có không manh động gì,
Dialogue: 0,0:07:49.91,0:07:52.70,Default,,0000,0000,0000,,thì một chính sách tương tự như yêu sách của chúng\Nrồi cũng sẽ được ban hành thôi.
Dialogue: 0,0:07:53.24,0:07:57.91,Default,,0000,0000,0000,,{\i1}Thời kỳ tái thiết hậu chiến từng có nhu cầu lớn{\i0}\N{\i1}về người tị nạn như một nguồn lao động giá rẻ,{\i0}
Dialogue: 0,0:07:58.31,0:08:02.72,Default,,0000,0000,0000,,{\i1}nhưng tỷ lệ thất nghiệp trong nước cứ tăng dần qua từng năm,{\i0}\N{\i1}và thuế khóa cũng leo thang theo.{\i0}
Dialogue: 0,0:08:03.25,0:08:06.12,Default,,0000,0000,0000,,{\i1}Cộng thêm việc chính phủ cứ vung tay vô tội vạ...{\i0}
Dialogue: 0,0:08:06.12,0:08:09.39,Default,,0000,0000,0000,,{\i1}...trích một phần khoản thuế nặng nề đó{\i0}\N{\i1}để chu cấp cho lượng người tị nạn ngày một tăng,{\i0}
Dialogue: 0,0:08:09.79,0:08:12.33,Default,,0000,0000,0000,,{\i1}chẳng trách sao các phần tử chống đối lại xuất hiện nhan nhản...{\i0}
Dialogue: 0,0:08:12.33,0:08:14.30,Default,,0000,0000,0000,,{\i1}...khi sự kiên nhẫn của họ{\i0}\N{\i1}đã chạm đáy giới hạn.{\i0}
Dialogue: 0,0:08:14.83,0:08:17.80,Default,,0000,0000,0000,,{\i1}Rốt cuộc, chính người nộp thuế lại là những kẻ{\i0}\N{\i1}phải gánh chịu cái giá bồi thường...{\i0}
Dialogue: 0,0:08:17.80,0:08:21.67,Default,,0000,0000,0000,,{\i1}...dưới hình thức tiếp nhận người tị nạn để đổi chác{\i0}\N{\i1}cho vấn đề Điều 9 Hiến pháp...{\i0}
Dialogue: 0,0:08:22.14,0:08:24.83,Default,,0000,0000,0000,,{\i1}...nhằm giúp đất nước này đóng vai kẻ tốt bụng{\i0}\N{\i1}trên trường quốc tế.{\i0}
Dialogue: 0,0:08:25.07,0:08:28.41,Default,,0000,0000,0000,,Nhưng trong số những người tị nạn đó,\Ncũng có người nộp thuế mà.
Dialogue: 0,0:08:28.61,0:08:32.48,Default,,0000,0000,0000,,Nói là vậy, nhưng tôi đoán nhiều người nộp thuế chân chính\Nđang dần nhận ra gánh nặng thuế má của họ...
Dialogue: 0,0:08:32.48,0:08:36.94,Default,,0000,0000,0000,,...lại đi nuôi sống những kẻ có thể sẽ cướp mất\Nchính công ăn việc làm của mình.
Dialogue: 0,0:08:37.85,0:08:41.98,Default,,0000,0000,0000,,Dù thế, biến chuyện đó thành khủng bố\Nthì vẫn là quá bốc đồng.
Dialogue: 0,0:08:42.19,0:08:46.23,Default,,0000,0000,0000,,Nếu cậu nói vậy, thì tôi cũng thấy chuyện này\Nquá sức nực cười...
Dialogue: 0,0:08:46.23,0:08:49.73,Default,,0000,0000,0000,,...khi một tổ chức từng bị giải tán bằng vũ lực như chúng ta,
Dialogue: 0,0:08:49.73,0:08:53.26,Default,,0000,0000,0000,,lại bị gọi đến ngay khoảnh khắc xảy ra sự vụ\Nmà phía cảnh sát bó tay không giải quyết nổi.
Dialogue: 0,0:08:53.97,0:08:57.57,Default,,0000,0000,0000,,Tôi cá là Trưởng ban lúc này đang gặp mặt đám tai to mặt lớn\Ncủa chính quyền mới...
Dialogue: 0,0:08:57.57,0:09:00.51,Default,,0000,0000,0000,,...với một cục tức nghẹn ứ\Ntrong lồng ngực cho mà xem.
Dialogue: 0,0:09:00.81,0:09:02.65,Default,,0000,0000,0000,,Bộ trưởng Bộ Nội vụ là người duy nhất còn sót lại...
Dialogue: 0,0:09:02.65,0:09:04.31,Default,,0000,0000,0000,,...bình an vô sự bước ra\Ntừ chính quyền tiền nhiệm.
Dialogue: 0,0:09:04.38,0:09:05.97,Default,,0000,0000,0000,,Thế nghĩa là {\i1}sao chứ?{\i0}
Dialogue: 0,0:09:06.32,0:09:09.15,Default,,0000,0000,0000,,Hiện tại, chức năng duy nhất\Ncủa Bộ Nội vụ...
Dialogue: 0,0:09:09.15,0:09:11.45,Default,,0000,0000,0000,,...chỉ là vùng đệm hòa giải giữa các bộ ngành\Ntrong nước mà thôi.
Dialogue: 0,0:09:12.49,0:09:14.92,Default,,0000,0000,0000,,Việc vị Bộ trưởng đó không bị thay thế...
Dialogue: 0,0:09:14.92,0:09:18.05,Default,,0000,0000,0000,,...có lẽ là bằng chứng cho thấy chẳng ai coi\Nbản thân cái bộ đó là một mối đe dọa.
Dialogue: 0,0:09:18.53,0:09:22.22,Default,,0000,0000,0000,,Và chính sự vô hại đó đã giúp Đội 9\Nthoát khỏi tầm ngắm của bọn họ cho tới tận bây giờ.
Dialogue: 0,0:09:24.63,0:09:27.94,Default,,0000,0000,0000,,Nhân tiện, mọi người đã nghe tin gì chưa...
Dialogue: 0,0:09:27.94,0:09:31.24,Default,,0000,0000,0000,,...rằng chúng ta sẽ đón nhận thêm một đám lính mới\Nnếu nhiệm vụ lần này trót lọt không?
Dialogue: 0,0:09:31.57,0:09:32.70,Default,,0000,0000,0000,,Lính mới sao?
Dialogue: 0,0:09:33.38,0:09:36.28,Default,,0000,0000,0000,,{\i1}Thiếu tá? Tôi biết tôi không có tư cách{\i0}\N{\i1}để bàn luận chuyện này,{\i0}
Dialogue: 0,0:09:36.28,0:09:40.68,Default,,0000,0000,0000,,{\i1}...nhưng tôi không nghĩ có nhiều người{\i0}\N{\i1}đủ trình độ gánh vác nổi công việc của chúng ta đâu.{\i0}
Dialogue: 0,0:09:44.22,0:09:49.25,Default,,0000,0000,0000,,Chuyện đó chỉ xảy ra nếu chúng ta hoàn thành nhiệm vụ này\Ntheo cách {\i1}chúng ta{\i0} muốn thôi.
Dialogue: 0,0:09:49.89,0:09:54.73,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi đã vô hiệu hóa rèm quang học rồi,{\i0}\N{\i1}nhưng bên trong bọn chúng còn kéo cả rèm sáo nữa.{\i0}
Dialogue: 0,0:09:54.93,0:09:57.09,Default,,0000,0000,0000,,{\i1}Xem ra đám này hành động{\i0}\N{\i1}khá bài bản đấy.{\i0}
Dialogue: 0,0:09:57.37,0:09:58.30,Default,,0000,0000,0000,,Ishikawa.
Dialogue: 0,0:09:59.60,0:10:02.26,Default,,0000,0000,0000,,Bắc cầu nối qua đường dây điện thoại\Nmà anh đã cài nghe lén đi.
Dialogue: 0,0:10:02.67,0:10:06.37,Default,,0000,0000,0000,,Tôi sẽ mượn tầm mắt của ai đó bên trong\Nđể nắm bắt tình hình rõ nhất có thể.
Dialogue: 0,0:10:06.68,0:10:08.30,Default,,0000,0000,0000,,Rõ rồi.\NTôi tiến hành ngay.
Dialogue: 0,0:10:49.69,0:10:51.55,Default,,0000,0000,0000,,Được rồi,\Ncá đã cắn câu.
Dialogue: 0,0:10:58.13,0:10:59.32,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:11:01.23,0:11:04.46,Default,,0000,0000,0000,,Không có gì... Lạ thật,\Nđây đâu phải tín hiệu từ cảnh sát.
Dialogue: 0,0:11:21.08,0:11:22.64,Default,,0000,0000,0000,,Chà chà...
Dialogue: 0,0:11:24.62,0:11:26.02,Default,,0000,0000,0000,,{\i1}Cái quái gì thế này...?{\i0}
Dialogue: 0,0:11:47.28,0:11:52.21,Default,,0000,0000,0000,,Lũ khốn đó dám cử lính do thám vào... Xem ra\Nchúng muốn rút ngắn thời gian đàm phán rồi.
Dialogue: 0,0:11:55.89,0:11:57.51,Default,,0000,0000,0000,,Tín hiệu đã\Nbị ngắt.
Dialogue: 0,0:12:05.26,0:12:07.25,Default,,0000,0000,0000,,{\i1}Tổng cộng có chín tên{\i0}\N{\i1}tất cả sao?{\i0}
Dialogue: 0,0:12:10.40,0:12:11.96,Default,,0000,0000,0000,,{\i1}Tên nào là chỉ huy?{\i0}
Dialogue: 0,0:12:16.71,0:12:19.77,Default,,0000,0000,0000,,Ngoại trừ não điện tử ra,\Ngã này hoàn toàn là người sinh học tự nhiên ư?
Dialogue: 0,0:12:32.86,0:12:33.82,Default,,0000,0000,0000,,Thưa Thủ tướng!
Dialogue: 0,0:12:33.82,0:12:36.35,Default,,0000,0000,0000,,Chuyện gì thế?\NChúng tôi đang họp cơ mà!
Dialogue: 0,0:12:36.99,0:12:39.23,Default,,0000,0000,0000,,Chúng tôi vừa nhận được tin báo\Ntừ phía đại sứ quán.
Dialogue: 0,0:12:39.23,0:12:42.00,Default,,0000,0000,0000,,Đội xung kích của cảnh sát dường như\Nđã chạm trán với bọn khủng bố,
Dialogue: 0,0:12:42.00,0:12:44.06,Default,,0000,0000,0000,,và cả hai bên đều đã\Ncó thương vong.
Dialogue: 0,0:12:44.37,0:12:47.53,Default,,0000,0000,0000,,Cái {\i1}gì cơ?{\i0} Tôi đã cho phép\Nbọn họ nổ súng đâu chứ!
Dialogue: 0,0:12:48.24,0:12:52.50,Default,,0000,0000,0000,,Một cuộc đấu súng bất ngờ nổ ra trong lúc họ\Nđang cố gắng thu thập thông tin tình báo bên trong.
Dialogue: 0,0:12:53.04,0:12:56.53,Default,,0000,0000,0000,,Rất tiếc phải báo cáo rằng một cảnh sát đã bị bắt làm con tin,\Nvà bọn chúng tuyên bố...
Dialogue: 0,0:12:57.01,0:13:01.78,Default,,0000,0000,0000,,...nếu trong vòng một giờ, bà không công khai tuyên bố\Nchấp thuận các yêu sách của chúng,
Dialogue: 0,0:13:02.08,0:13:07.08,Default,,0000,0000,0000,,chúng sẽ hành quyết viên cảnh sát đó,\Nvà cứ mỗi 10 phút sau sẽ xử tử thêm một con tin.
Dialogue: 0,0:13:07.86,0:13:10.45,Default,,0000,0000,0000,,Nói cách khác, bọn họ đã khiến tình hình\Ntồi tệ thêm một cách vô ích.
Dialogue: 0,0:13:10.96,0:13:13.33,Default,,0000,0000,0000,,Tình thế này đòi hỏi\Nphải có giải pháp nhanh chóng.
Dialogue: 0,0:13:14.43,0:13:17.52,Default,,0000,0000,0000,,Tôi kính đề nghị bà đưa ra\Nphán quyết ngay tại chỗ.
Dialogue: 0,0:13:18.13,0:13:21.80,Default,,0000,0000,0000,,Tôi cho rằng lệnh phong tỏa báo chí đối với truyền thông\Nsẽ không duy trì được lâu nữa đâu.
Dialogue: 0,0:13:22.30,0:13:25.90,Default,,0000,0000,0000,,Nếu các bài đăng kiểu du kích bắt đầu\Nxuất hiện trên các mạng lưới địa phương,
Dialogue: 0,0:13:26.18,0:13:28.30,Default,,0000,0000,0000,,thì chiến dịch này sẽ\Nhoàn toàn trở nên vô nghĩa.
Dialogue: 0,0:13:29.58,0:13:31.77,Default,,0000,0000,0000,,Thủ tục giấy tờ\Nvẫn chưa xong sao?
Dialogue: 0,0:13:32.75,0:13:34.11,Default,,0000,0000,0000,,Thành thật xin lỗi bà,\Nthưa Thủ tướng.
Dialogue: 0,0:13:35.55,0:13:39.15,Default,,0000,0000,0000,,Thưa Thủ tướng. Nếu vậy,\Nbà nghĩ sao về phương án này?
Dialogue: 0,0:13:40.02,0:13:44.76,Default,,0000,0000,0000,,Vụ khủng bố này chỉ có thể được giải quyết\Nbằng một cuộc đột kích của lực lượng cảnh sát.
Dialogue: 0,0:13:45.06,0:13:47.16,Default,,0000,0000,0000,,Miễn là kịch bản đó\Nđược giữ vững,
Dialogue: 0,0:13:47.16,0:13:51.10,Default,,0000,0000,0000,,...liệu bà có thể dùng thẩm quyền của riêng mình để ban lệnh\Ntấn công đại sứ quán ngay lúc này không?
Dialogue: 0,0:13:52.43,0:13:57.30,Default,,0000,0000,0000,,Chúng tôi sẽ bí mật thực hiện nhiệm vụ\Ndưới vỏ bọc chiến dịch của cảnh sát.
Dialogue: 0,0:13:57.94,0:14:01.88,Default,,0000,0000,0000,,Phải thừa nhận rằng, sau đó bà sẽ cần\Nphải thu thập đủ giấy tờ...
Dialogue: 0,0:14:01.94,0:14:04.97,Default,,0000,0000,0000,,...để hợp thức hóa tính pháp lý\Ncho sự việc đã rồi.
Dialogue: 0,0:14:05.75,0:14:07.28,Default,,0000,0000,0000,,Tôi có thể hứa với ông\Nvề điều đó,
Dialogue: 0,0:14:07.28,0:14:10.74,Default,,0000,0000,0000,,nhưng điều gì sẽ xảy ra trong trường hợp\Ncác ông thất bại trong việc triệt hạ bọn khủng bố?
Dialogue: 0,0:14:11.65,0:14:14.29,Default,,0000,0000,0000,,Tôi có thể bảo đảm với bà\Nvề sự thành công của chiến dịch,
Dialogue: 0,0:14:14.29,0:14:19.39,Default,,0000,0000,0000,,nhưng tôi không có cách nào chứng minh điều đó cho bà,\Nngoài việc bà phải đặt niềm tin vào chúng tôi.
Dialogue: 0,0:14:19.93,0:14:22.20,Default,,0000,0000,0000,,Nếu bà vẫn còn\Nmối e ngại,
Dialogue: 0,0:14:22.20,0:14:26.44,Default,,0000,0000,0000,,thì cứ việc tuyên bố rằng toàn bộ hành động của Đội An ninh\NCông cộng 9 kể từ thời điểm này trở đi...
Dialogue: 0,0:14:26.44,0:14:29.23,Default,,0000,0000,0000,,...đều được thực hiện dưới quyền hạn\Ncủa một mình tôi chứ không phải ai khác.
Dialogue: 0,0:14:29.64,0:14:32.73,Default,,0000,0000,0000,,Bằng cách đó, mọi rắc rối sẽ được giải quyết\Nbằng việc đưa duy nhất {\i1}mình tôi{\i0} ra xét xử.
Dialogue: 0,0:14:33.01,0:14:35.61,Default,,0000,0000,0000,,Dù cho công chúng có chất vấn\Ntrách nhiệm của chính phủ,
Dialogue: 0,0:14:35.61,0:14:38.51,Default,,0000,0000,0000,,bà vẫn có thể khẳng định rằng không một ai\Ntrong nội các biết trước về hành động của tôi.
Dialogue: 0,0:14:39.45,0:14:40.78,Default,,0000,0000,0000,,Có đúng vậy không?
Dialogue: 0,0:14:42.42,0:14:43.25,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:14:43.75,0:14:45.12,Default,,0000,0000,0000,,Thưa Thủ tướng?!
Dialogue: 0,0:14:45.12,0:14:46.71,Default,,0000,0000,0000,,Bộ trưởng Bộ Nội vụ.
Dialogue: 0,0:14:47.16,0:14:51.68,Default,,0000,0000,0000,,Tôi muốn ông liên lạc với Giám đốc\NSở Cảnh sát Đô thị ngay lập tức.
Dialogue: 0,0:14:53.50,0:14:54.69,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:14:55.13,0:14:56.10,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}
Dialogue: 0,0:14:56.10,0:14:57.66,Default,,0000,0000,0000,,{\i1}Có biến chuyển mới rồi,{\i0}\N{\i1}phải không?{\i0}
Dialogue: 0,0:14:58.23,0:15:02.80,Default,,0000,0000,0000,,{\i1}Mười lăm phút nữa, đội đặc nhiệm SWAT{\i0}\N{\i1}sẽ bắt đầu cuộc đột kích vào đại sứ quán.{\i0}
Dialogue: 0,0:15:03.17,0:15:07.58,Default,,0000,0000,0000,,{\i1}Hãy lẻn vào trước bọn họ và khống chế{\i0}\N{\i1}lũ khủng bố trước thời điểm đó.{\i0}
Dialogue: 0,0:15:08.08,0:15:10.51,Default,,0000,0000,0000,,{\i1}Các cậu được quyền nổ súng{\i0}\N{\i1}nếu không còn lựa chọn nào khác.{\i0}
Dialogue: 0,0:15:10.81,0:15:13.51,Default,,0000,0000,0000,,{\i1}Giải cứu con tin{\i0}\N{\i1}là ưu tiên hàng đầu.{\i0}
Dialogue: 0,0:15:14.05,0:15:16.29,Default,,0000,0000,0000,,{\i1}Tôi giao quyền lựa chọn đội hình đột kích{\i0}\N{\i1}cho cô quyết định.{\i0}
Dialogue: 0,0:15:16.29,0:15:17.51,Default,,0000,0000,0000,,Mười lăm phút sao?
Dialogue: 0,0:15:17.92,0:15:21.58,Default,,0000,0000,0000,,Bắt chúng ta chờ sốt ruột đến nước này,\Nrồi nói ra nhẹ tênh như không vậy!
Dialogue: 0,0:15:22.36,0:15:24.66,Default,,0000,0000,0000,,{\i1}Saito, tạm thời lái trực thăng{\i0}\N{\i1}quay trở lại đây.{\i0}
Dialogue: 0,0:15:27.13,0:15:28.96,Default,,0000,0000,0000,,{\i1}Được rồi mọi người,{\i0}\N{\i1}nghe lệnh rồi đấy.{\i0}
Dialogue: 0,0:15:29.73,0:15:31.70,Default,,0000,0000,0000,,{\i1}Đây là sơ đồ tình hình{\i0}\N{\i1}bên trong đại sứ quán.{\i0}
Dialogue: 0,0:15:32.00,0:15:35.23,Default,,0000,0000,0000,,{\i1}Có chín tên khủng bố,{\i0}\N{\i1}một tên đã chết.{\i0}
Dialogue: 0,0:15:35.50,0:15:38.60,Default,,0000,0000,0000,,{\i1}Ghi nhớ cấu trúc và cách bố trí{\i0}\N{\i1}của tòa nhà đi.{\i0}
Dialogue: 0,0:15:39.17,0:15:41.54,Default,,0000,0000,0000,,{\i1}Chúng ta có tối đa 10 phút{\i0}\N{\i1}cho chiến dịch này.{\i0}
Dialogue: 0,0:15:41.84,0:15:44.28,Default,,0000,0000,0000,,{\i1}Không còn nhiều thời gian trước khi{\i0}\N{\i1}đội SWAT xông vào đâu.{\i0}
Dialogue: 0,0:15:44.28,0:15:46.77,Default,,0000,0000,0000,,{\i1}Cứ coi đây là minh chứng cho{\i0}\N{\i1}sự tin tưởng của Trưởng ban dành cho chúng ta đi.{\i0}
Dialogue: 0,0:15:47.02,0:15:48.54,Default,,0000,0000,0000,,Rồi rồi, sao cũng được...
Dialogue: 0,0:15:59.66,0:16:01.13,Default,,0000,0000,0000,,Còn phân chia đội hình thì sao?
Dialogue: 0,0:16:01.13,0:16:04.53,Default,,0000,0000,0000,,{\i1}Tách thành các tổ hai người.{\i0}\N{\i1}Batou đi với Togusa, Pazu đi với Saito.{\i0}
Dialogue: 0,0:16:04.53,0:16:07.23,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ xâm nhập vào đại sứ quán theo{\i0}\N{\i1}lối đi khác với đội đặc nhiệm SWAT.{\i0}
Dialogue: 0,0:16:10.14,0:16:12.66,Default,,0000,0000,0000,,Chúng ta sẽ đi thang máy\Nvà tạo một màn ra mắt thật hoành tráng.
Dialogue: 0,0:16:13.11,0:16:16.67,Default,,0000,0000,0000,,{\i1}Mọi người cứ tiến vào trước đi. Tôi sẽ lên sau{\i0}\N{\i1}khi xong một vài bước chuẩn bị.{\i0}
Dialogue: 0,0:16:17.15,0:16:18.34,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:16:27.69,0:16:29.62,Default,,0000,0000,0000,,Tấn công tòa nhà\Ntrong 15 phút sao?
Dialogue: 0,0:16:29.93,0:16:33.99,Default,,0000,0000,0000,,Chúng ta còn chẳng biết bên trong đang có chuyện gì!\NCấp trên rốt cuộc đang nghĩ cái quái gì thế?
Dialogue: 0,0:16:39.57,0:16:41.40,Default,,0000,0000,0000,,Các tuyến đột kích khác\Ncủa các anh ở đâu?
Dialogue: 0,0:16:44.07,0:16:47.60,Default,,0000,0000,0000,,Sân thượng... và\Ncầu thang thoát hiểm.
Dialogue: 0,0:16:49.48,0:16:52.17,Default,,0000,0000,0000,,Chuyển một nửa số con tin\Nqua cầu thang thoát hiểm đi.
Dialogue: 0,0:16:52.78,0:16:54.18,Default,,0000,0000,0000,,Ý hay đấy.
Dialogue: 0,0:16:55.72,0:16:57.34,Default,,0000,0000,0000,,{\i1}Đám này kỳ lạ thật.{\i0}
Dialogue: 0,0:16:57.55,0:17:00.59,Default,,0000,0000,0000,,{\i1}Chúng thực hiện nhiệm vụ một cách trơn tru{\i0}\N{\i1}mà chẳng có kẻ nào đứng ra chỉ huy,{\i0}
Dialogue: 0,0:17:00.59,0:17:02.18,Default,,0000,0000,0000,,{\i1}nhưng chúng lại hoàn toàn không có{\i0}\N{\i1}cơ cấu tổ chức rõ ràng.{\i0}
Dialogue: 0,0:17:02.66,0:17:05.83,Default,,0000,0000,0000,,{\i1}Còn gã này... Hắn hầu như chẳng có{\i0}\N{\i1}hàng rào phòng thủ não bộ nào đáng kể,{\i0}
Dialogue: 0,0:17:05.83,0:17:08.63,Default,,0000,0000,0000,,{\i1}nhưng mình lại không thể tìm thấy bất kỳ thông tin nào{\i0}\N{\i1}về tổ chức của chúng.{\i0}
Dialogue: 0,0:17:10.00,0:17:11.26,Default,,0000,0000,0000,,Đứng dậy mau.
Dialogue: 0,0:17:13.47,0:17:15.46,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi chuẩn bị{\i0}\N{\i1}tiến vào tòa nhà đây.{\i0}
Dialogue: 0,0:17:15.70,0:17:19.40,Default,,0000,0000,0000,,{\i1}Tốt. Tôi sẽ gây náo loạn tối đa{\i0}\N{\i1}trong chừng mực con rối này còn chịu đựng được.{\i0}
Dialogue: 0,0:17:19.78,0:17:23.68,Default,,0000,0000,0000,,{\i1}Sau đó, cứ một phát một mạng.{\i0}\N{\i1}Tuyệt đối không được bắn nhầm vào con tin.{\i0}
Dialogue: 0,0:17:26.28,0:17:27.87,Default,,0000,0000,0000,,Đứng yên đó, chết tiệt!
Dialogue: 0,0:17:32.32,0:17:34.15,Default,,0000,0000,0000,,Này, thang máy đang chuyển động!
Dialogue: 0,0:17:35.82,0:17:38.52,Default,,0000,0000,0000,,Để tôi đi kiểm tra.\NCoi chừng đám con tin.
Dialogue: 0,0:17:51.87,0:17:52.84,Default,,0000,0000,0000,,Anh đang làm...
Dialogue: 0,0:17:53.98,0:17:54.91,Default,,0000,0000,0000,,Thằng ngu này!
Dialogue: 0,0:17:55.08,0:17:56.48,Default,,0000,0000,0000,,Mày làm cái trò gì thế?!
Dialogue: 0,0:18:12.53,0:18:14.50,Default,,0000,0000,0000,,{\i1}Batou, tôi bắn trượt{\i0}\N{\i1}một tên rồi!{\i0}
Dialogue: 0,0:18:15.06,0:18:16.26,Default,,0000,0000,0000,,{\i1}Tôi thấy rồi!{\i0}
Dialogue: 0,0:18:30.15,0:18:31.77,Default,,0000,0000,0000,,Kệ mẹ nó,\Nchúng ta xông vào {\i1}ngay bây giờ!{\i0}
Dialogue: 0,0:18:39.25,0:18:41.25,Default,,0000,0000,0000,,Mày kia.\NLại đây!
Dialogue: 0,0:19:04.28,0:19:05.27,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:19:43.02,0:19:44.78,Default,,0000,0000,0000,,Này, những kẻ khác...
Dialogue: 0,0:19:57.83,0:19:59.53,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}\N{\i1}Bọn chúng ập vào sớm hơn dự kiến!{\i0}
Dialogue: 0,0:20:04.44,0:20:06.87,Default,,0000,0000,0000,,{\i1}Chết tiệt, mấy gã SWAT{\i0}\N{\i1}đang cản đường ngắm của tôi!{\i0}
Dialogue: 0,0:20:14.15,0:20:16.31,Default,,0000,0000,0000,,Chúng ta là\NNhóm 11 Cá Nhân.
Dialogue: 0,0:20:16.69,0:20:21.56,Default,,0000,0000,0000,,Dù cho chúng ta có ngã xuống nơi đây, những bản ngã\Ncá nhân khác sẽ tiếp nối ý chí của chúng ta.
Dialogue: 0,0:20:21.56,0:20:24.35,Default,,0000,0000,0000,,Bởi lẽ đó,\Ncái chết chẳng có nghĩa lý gì với chúng ta cả!
Dialogue: 0,0:20:24.59,0:20:25.96,Default,,0000,0000,0000,,Ồ, nói vậy đấy à?
Dialogue: 0,0:20:26.33,0:20:27.85,Default,,0000,0000,0000,,Vậy thì cứ việc\Nchết đi.
Dialogue: 0,0:20:32.20,0:20:33.53,Default,,0000,0000,0000,,Bên ngoài cửa sổ kìa!
Dialogue: 0,0:20:45.75,0:20:49.01,Default,,0000,0000,0000,,Tôi chân thành cảm ơn sự thể hiện xuất sắc\Ncủa ông trong sự vụ lần này.
Dialogue: 0,0:20:50.12,0:20:55.85,Default,,0000,0000,0000,,Tôi sẽ chấp thuận toàn bộ dự toán ngân sách của ông\Nvà cho phép tái lập cũng như vận hành đơn vị.
Dialogue: 0,0:20:56.46,0:20:57.66,Default,,0000,0000,0000,,Giấy tờ phê duyệt đây.
Dialogue: 0,0:20:57.66,0:20:59.32,Default,,0000,0000,0000,,Cảm ơn bà,\Nthưa Thủ tướng.
Dialogue: 0,0:21:00.46,0:21:03.09,Default,,0000,0000,0000,,Còn cô là chỉ huy đơn vị\Nđã dẫn đầu cuộc đột kích sao?
Dialogue: 0,0:21:06.47,0:21:09.73,Default,,0000,0000,0000,,Hồi nãy ông chẳng hề buông một câu mỉa mai nào cả.\NĐó đâu phải phong cách thường ngày của ông, Trưởng ban.
Dialogue: 0,0:21:10.24,0:21:12.31,Default,,0000,0000,0000,,Có phải bởi vì\Nbà ấy là phụ nữ không?
Dialogue: 0,0:21:12.31,0:21:15.71,Default,,0000,0000,0000,,Bà ấy không phải là người\Nmà tôi nên trút giận.
Dialogue: 0,0:21:15.81,0:21:21.18,Default,,0000,0000,0000,,Vả lại, tôi chưa từng nghe nói có ai bị đau dạ dày\Nchỉ vì phải nuốt cục tức vào trong lòng cả.
Dialogue: 0,0:21:21.45,0:21:23.82,Default,,0000,0000,0000,,Nhưng ông không nghĩ có một vị sếp như bà ta\Nsẽ rất phiền phức sao?
Dialogue: 0,0:21:24.12,0:21:27.45,Default,,0000,0000,0000,,Bà ta thuộc mẫu người luôn khăng khăng\Nphải xích chặt dây cổ chú chó cưng của mình.
Dialogue: 0,0:21:27.76,0:21:32.06,Default,,0000,0000,0000,,Hơn nữa, tôi không khỏi nghĩ rằng\Nlệnh tấn công vừa rồi...
Dialogue: 0,0:21:32.06,0:21:36.16,Default,,0000,0000,0000,,...chẳng qua là kết quả của việc bà ta khéo léo moi kế hoạch giải quyết\Ntừ ông trong khi vẫn phủi sạch trách nhiệm cho bản thân.
Dialogue: 0,0:21:36.57,0:21:41.56,Default,,0000,0000,0000,,Tôi phải thừa nhận, bà ấy dường như không phải\Ncon rối tầm thường do liên minh cầm quyền dựng lên.
Dialogue: 0,0:21:42.50,0:21:46.13,Default,,0000,0000,0000,,Trước mắt, chúng ta nên hân hoan ăn mừng\Nviệc Đội 9 được tái lập, không phải sao?
Dialogue: 0,0:21:48.21,0:21:49.73,Default,,0000,0000,0000,,Ông nói đúng.
Dialogue: 0,0:21:51.58,0:21:54.71,Default,,0000,0000,0000,,Này, đến lúc rồi đấy!\NDự toán ngân sách có được duyệt không thế?
Dialogue: 0,0:21:55.08,0:21:56.68,Default,,0000,0000,0000,,Được thông qua toàn bộ.
Dialogue: 0,0:21:57.19,0:21:59.68,Default,,0000,0000,0000,,Togusa, xét theo tình thế lúc đó,\Ncậu đã làm rất tốt.
Dialogue: 0,0:21:59.99,0:22:01.55,Default,,0000,0000,0000,,Tôi thấy cậu tiến bộ nhiều rồi đấy.
Dialogue: 0,0:22:02.49,0:22:04.22,Default,,0000,0000,0000,,Cảm ơn Thiếu tá\Nđã khen ngợi.
Dialogue: 0,0:22:04.39,0:22:08.19,Default,,0000,0000,0000,,Xem ra cậu có thể ngẩng cao đầu\Nkhi đám lính mới của chúng ta bước vào rồi.
Dialogue: 0,0:22:08.60,0:22:11.46,Default,,0000,0000,0000,,À, phải rồi!\NThế đám lính mới là ai vậy?
Dialogue: 0,0:22:12.30,0:22:13.53,Default,,0000,0000,0000,,Để tôi giới thiệu cho các cậu.
Dialogue: 0,0:22:13.97,0:22:15.13,Default,,0000,0000,0000,,Vào đi!
Dialogue: 0,0:22:26.05,0:22:28.64,Default,,0000,0000,0000,,Hân-hạnh-được-gặp-mọi-người.\NTôi-là-Tachikoma.
Dialogue: 0,0:22:30.49,0:22:31.98,Default,,0000,0000,0000,,Các cậu là...
Dialogue: 0,0:22:41.73,0:22:46.00,Default,,0000,0000,0000,,Em đùa tí thôi, anh Batou ơi!\NEm lừa được anh rồi đúng không? Hả? Hả?
Dialogue: 0,0:22:46.87,0:22:48.30,Default,,0000,0000,0000,,Anh Batou ơi!
Dialogue: 0,0:22:48.50,0:22:51.96,Default,,0000,0000,0000,,Bọn tôi đã phục hồi lại các Tachikoma từng bị đem đi\Nphân tích cấu trúc ở phòng thí nghiệm.
Dialogue: 0,0:22:52.61,0:22:54.54,Default,,0000,0000,0000,,Kể từ hôm nay, chúng sẽ là thành viên\Ncủa Đội 9.
Dialogue: 0,0:22:54.78,0:22:55.87,Default,,0000,0000,0000,,Cô ấy đã nói rồi đấy nhé!
Dialogue: 0,0:22:56.61,0:22:59.14,Default,,0000,0000,0000,,Chúng em rất mong được hợp tác\Nvới anh, anh Batou!
Dialogue: 0,0:23:10.78,0:23:13.28,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:13.28,0:23:17.24,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:17.43,0:23:19.90,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:19.90,0:23:23.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:23.89,0:23:27.90,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:27.90,0:23:31.19,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:31.19,0:23:35.70,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:35.70,0:23:37.19,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:37.19,0:23:39.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:39.89,0:23:43.83,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:43.83,0:23:46.34,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:46.34,0:23:49.87,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:49.87,0:23:53.21,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:53.21,0:23:58.01,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:58.01,0:24:03.82,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:03.82,0:24:06.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:06.52,0:24:10.46,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:24:10.46,0:24:12.97,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:24:12.97,0:24:16.50,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:24:16.50,0:24:19.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:24:19.84,0:24:24.64,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:24:24.64,0:24:29.30,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,2000)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...
