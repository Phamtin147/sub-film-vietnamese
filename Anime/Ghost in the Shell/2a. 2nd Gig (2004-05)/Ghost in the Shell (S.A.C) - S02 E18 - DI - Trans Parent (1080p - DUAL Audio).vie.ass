Dialogue: 0,0:01:31.74,0:01:34.98,Default,,0000,0000,0000,,Berlin, một thành phố nơi sự lụi tàn\Nvà tái sinh cùng song hành tồn tại.
Dialogue: 0,0:01:35.72,0:01:39.62,Default,,0000,0000,0000,,Đây là một trong số ít những đô thị quốc tế\Ntừng là mục tiêu của các cuộc tập kích tên lửa...
Dialogue: 0,0:01:39.95,0:01:45.29,Default,,0000,0000,0000,,...trong cả Thế chiến III hạt nhân\Nlẫn Thế chiến IV phi hạt nhân.
Dialogue: 0,0:01:46.36,0:01:49.76,Default,,0000,0000,0000,,Thế nhưng thành phố này, nơi mang ý nghĩa thiêng liêng\Nđối với dân tộc German,
Dialogue: 0,0:01:50.03,0:01:53.43,Default,,0000,0000,0000,,đều đã trải qua sự hồi sinh thần kỳ\Nsau cả hai lần ấy,
Dialogue: 0,0:01:53.77,0:01:58.70,Default,,0000,0000,0000,,và hiện đang đứng dậy lần thứ ba\Nvới tư cách là thủ đô của đất nước này.
Dialogue: 0,0:02:28.67,0:02:34.07,Default,,0000,0000,0000,,{\i1}Có vẻ như ngay cả ngụy trang quang học Kyo-re hệ 3003{\i0}\N{\i1}cũng chẳng lừa nổi khứu giác của loài chó.{\i0}
Dialogue: 0,0:02:35.21,0:02:39.01,Default,,0000,0000,0000,,{\i1}Anh đang làm cái gì thế hả Batou? Cứ lơ là nghịch ngợm thế{\i0}\N{\i1}có ngày phải hối hận đấy.{\i0}
Dialogue: 0,0:02:39.41,0:02:40.44,Default,,0000,0000,0000,,{\i1}Xin lỗi, tôi không kìm được.{\i0}
Dialogue: 0,0:02:40.68,0:02:44.17,Default,,0000,0000,0000,,{\i1}Dù sao thì tôi cũng chẳng hợp{\i0}\N{\i1}với mấy vụ mai phục giám sát dài ngày này chút nào.{\i0}
Dialogue: 0,0:02:44.88,0:02:47.58,Default,,0000,0000,0000,,{\i1}Chưa kể tuyết lại rơi đúng vào lúc{\i0}\N{\i1}tồi tệ nhất thế này nữa.{\i0}
Dialogue: 0,0:02:48.39,0:02:50.45,Default,,0000,0000,0000,,{\i1}Nó khiến lớp ngụy trang quang học của ta{\i0}\N{\i1}dễ bị lộ hơn.{\i0}
Dialogue: 0,0:02:51.32,0:02:56.09,Default,,0000,0000,0000,,{\i1}Chẳng có mấy ai sinh ra để làm mấy chiến dịch giám sát{\i0}\N{\i1}căng thẳng tột độ như thế này đâu.{\i0}
Dialogue: 0,0:03:01.93,0:03:04.46,Default,,0000,0000,0000,,{\i1}Mau giải quyết xong xuôi cái vụ chết tiệt này{\i0}\N{\i1}rồi về nhà thôi...{\i0}
Dialogue: 0,0:03:04.60,0:03:07.73,Default,,0000,0000,0000,,{\i1}Mọi chuyện sẽ kết thúc{\i0}\N{\i1}trong vài ngày tới thôi.{\i0}
Dialogue: 0,0:03:08.34,0:03:10.14,Default,,0000,0000,0000,,{\i1}Batou, tôi ngắt liên lạc đây.{\i0}
Dialogue: 0,0:03:10.88,0:03:14.51,Default,,0000,0000,0000,,{\i1}Kênh này dù đã được mã hóa, nhưng không có gì đảm bảo{\i0}\N{\i1}ta sẽ không bị hack ngược lại đâu.{\i0}
Dialogue: 0,0:03:14.91,0:03:16.61,Default,,0000,0000,0000,,{\i1}Quay lại vị trí gác của anh{\i0}\N{\i1}ngay lập tức đi.{\i0}
Dialogue: 0,0:03:16.72,0:03:18.31,Default,,0000,0000,0000,,{\i1}Biết rồi, biết rồi khổ lắm...{\i0}
Dialogue: 0,0:03:33.57,0:03:37.50,Default,,0000,0000,0000,,{\i1}Dù đã tắt các cơ quan cảm giác,{\i0}\N{\i1}cái lạnh nơi này vẫn buốt đến tận xương tủy.{\i0}
Dialogue: 0,0:03:42.01,0:03:43.60,Default,,0000,0000,0000,,Tôi ngạc nhiên là cô\Ntới đây kịp giờ đấy.
Dialogue: 0,0:03:44.04,0:03:46.27,Default,,0000,0000,0000,,Có chuyến bay thẳng\Ntừ Đài Loan sang à?
Dialogue: 0,0:03:47.05,0:03:51.18,Default,,0000,0000,0000,,Tôi quá cảnh ở Hồng Kông, rồi bảo họ sắp xếp cho tôi\Nlên chuyến bay sớm nhất tới đây.
Dialogue: 0,0:03:52.15,0:03:56.59,Default,,0000,0000,0000,,Dù vậy, tôi khá bất ngờ khi họ lại săn lùng một mục tiêu lớn\Nbằng một đội đặc nhiệm hỗn hợp quốc tế thế này.
Dialogue: 0,0:03:57.36,0:04:01.76,Default,,0000,0000,0000,,Phải. Khi nghe Sếp phổ biến chi tiết về chiến dịch này,
Dialogue: 0,0:04:01.86,0:04:04.80,Default,,0000,0000,0000,,trong một khoảnh khắc,\Ntôi cứ ngỡ ông ấy đang trêu đùa tôi.
Dialogue: 0,0:04:05.13,0:04:09.03,Default,,0000,0000,0000,,Dẫu sao thì, tên \"Lông vũ Thiên thần\" này\Nlà một tay khủng bố sừng sỏ...
Dialogue: 0,0:04:09.14,0:04:12.63,Default,,0000,0000,0000,,...kẻ chỉ chuyên nhắm vào các hội nghị thượng đỉnh\Ncủa các quốc gia phát triển.
Dialogue: 0,0:04:13.97,0:04:16.00,Default,,0000,0000,0000,,Tôi cá là lý do họ chọn cơ cấu phối hợp này\Ncho chiến dịch...
Dialogue: 0,0:04:16.11,0:04:19.67,Default,,0000,0000,0000,,...là để đảm bảo mỗi quốc gia đều được chia phần công trạng\Nkhi tóm được hắn.
Dialogue: 0,0:04:20.48,0:04:23.92,Default,,0000,0000,0000,,Và cô với tôi đều được đích danh chỉ định...
Dialogue: 0,0:04:24.58,0:04:26.95,Default,,0000,0000,0000,,Xét đến thời điểm của nhiệm vụ nước ngoài này,
Dialogue: 0,0:04:27.29,0:04:30.65,Default,,0000,0000,0000,,hoàn toàn có thể khẳng định lời đề xuất đó\Nxuất phát từ Cục Tình báo Nội các.
Dialogue: 0,0:04:38.20,0:04:41.46,Default,,0000,0000,0000,,Được rồi, chúng ta bắt đầu phổ biến tóm tắt\Ncho chiến dịch này.
Dialogue: 0,0:04:42.44,0:04:44.53,Default,,0000,0000,0000,,Trước tiên, tôi muốn các vị\Nxem qua người này.
Dialogue: 0,0:04:45.04,0:04:47.37,Default,,0000,0000,0000,,Người đàn ông này\Ntên là Angelica.
Dialogue: 0,0:04:47.94,0:04:50.50,Default,,0000,0000,0000,,Hắn tự xưng là nhà phân phối thương mại\Ncơ thể máy toàn phần.
Dialogue: 0,0:04:50.98,0:04:52.67,Default,,0000,0000,0000,,Quốc tịch Hà Lan.
Dialogue: 0,0:04:53.18,0:04:54.84,Default,,0000,0000,0000,,Thế nhưng từ một sự cố nọ,
Dialogue: 0,0:04:55.18,0:04:59.85,Default,,0000,0000,0000,,chúng tôi phát hiện ra người này chính là Lông vũ Thiên thần,\Nngười mà tôi tin chắc tất cả các vị đều đã từng nghe danh.
Dialogue: 0,0:05:00.42,0:05:04.05,Default,,0000,0000,0000,,Tên khủng bố độc lập này đã gây ra số thương vong\Nlớn hơn bất kỳ ai trong lịch sử.
Dialogue: 0,0:05:04.42,0:05:06.05,Default,,0000,0000,0000,,Họ cuối cùng đã có\Nchứng cứ xác thực rồi sao?
Dialogue: 0,0:05:07.59,0:05:09.49,Default,,0000,0000,0000,,Sự cố mà ngài đang đề cập\Nlà gì thế ạ?
Dialogue: 0,0:05:10.33,0:05:12.46,Default,,0000,0000,0000,,Để tôi nói từ đầu.
Dialogue: 0,0:05:12.97,0:05:17.10,Default,,0000,0000,0000,,Tư tưởng phạm tội và phương thức hành động của Lông vũ Thiên thần\Nluôn nhất quán từ trước tới nay.
Dialogue: 0,0:05:18.24,0:05:20.93,Default,,0000,0000,0000,,Hắn lên án việc một số ít\Ncác cường quốc hàng đầu...
Dialogue: 0,0:05:21.04,0:05:24.34,Default,,0000,0000,0000,,...nắm giữ đặc quyền độc tôn quyền lực\Nra quyết định toàn cầu.
Dialogue: 0,0:05:25.01,0:05:27.74,Default,,0000,0000,0000,,Sau đó, hắn tuyên bố sẽ đánh bom một tòa nhà chọc trời\Nbọc kính...
Dialogue: 0,0:05:27.85,0:05:31.01,Default,,0000,0000,0000,,...ở một nơi nào đó trên lãnh thổ quốc gia\Nđang đăng cai hội nghị thượng đỉnh.
Dialogue: 0,0:05:31.62,0:05:34.59,Default,,0000,0000,0000,,Hắn có cái tên này bắt nguồn từ con số thương vong khổng lồ\Ngây ra bởi...
Dialogue: 0,0:05:34.92,0:05:38.72,Default,,0000,0000,0000,,...vô số mảnh kính vỡ trút xuống như mưa từ trên cao\Nvào thời điểm vụ nổ xảy ra.
Dialogue: 0,0:05:40.43,0:05:45.96,Default,,0000,0000,0000,,Dĩ nhiên, các nước chủ nhà đều đối phó với mối đe dọa\Nbằng cách ban bố các quy trình an ninh nghiêm ngặt,
Dialogue: 0,0:05:46.30,0:05:51.29,Default,,0000,0000,0000,,nhưng thực tế đã chứng minh không thể ngăn chặn một vụ nổ\Ncó thể xảy ra ở bất kỳ đâu trên cả nước.
Dialogue: 0,0:05:52.41,0:05:55.50,Default,,0000,0000,0000,,Với suy nghĩ đó, cơ quan điều tra đã nỗ lực\Ntrích xuất khuôn mặt của hắn...
Dialogue: 0,0:05:55.61,0:05:58.51,Default,,0000,0000,0000,,...từ nhật ký hồng ngoại của những tòa nhà\Nđã từng bị đánh bom.
Dialogue: 0,0:05:59.18,0:06:02.34,Default,,0000,0000,0000,,Thế nhưng vì mang cơ thể máy toàn phần,\Nhắn đều thay đổi khuôn mặt sau mỗi lần ra tay...
Dialogue: 0,0:06:02.98,0:06:05.01,Default,,0000,0000,0000,,...và biến thành một con người\Nhoàn toàn khác.
Dialogue: 0,0:06:05.62,0:06:08.42,Default,,0000,0000,0000,,Đó là lý do tại sao danh tính thực sự\Ncủa Lông vũ Thiên thần...
Dialogue: 0,0:06:08.52,0:06:11.68,Default,,0000,0000,0000,,...chưa bao giờ được đưa vào diện điều tra chính thức\Ncho tới tận thời điểm này.
Dialogue: 0,0:06:12.12,0:06:15.65,Default,,0000,0000,0000,,Nếu đúng như thế, làm sao bây giờ các ngài lại biết được\Nhắn ta mang cơ thể máy toàn phần?
Dialogue: 0,0:06:17.33,0:06:21.32,Default,,0000,0000,0000,,Sự thật là hai tháng trước, một bác sĩ cơ thể máy\Nở Hà Lan...
Dialogue: 0,0:06:21.43,0:06:28.03,Default,,0000,0000,0000,,...đã vô tình khiến một bệnh nhân rơi vào hôn mê\Ntrong một ca phẫu thuật hoán đổi cơ thể.
Dialogue: 0,0:06:28.61,0:06:31.58,Default,,0000,0000,0000,,Nhiều ký ức khác nhau đã được tìm thấy trong tâm trí bệnh nhân\Nkhiến vị bác sĩ phẫu thuật tin rằng...
Dialogue: 0,0:06:31.68,0:06:34.01,Default,,0000,0000,0000,,...người đàn ông đó có thể chính là\NLông vũ Thiên thần.
Dialogue: 0,0:06:35.41,0:06:40.28,Default,,0000,0000,0000,,Theo lời vị bác sĩ Hà Lan,\Ntrong số những ký ức trích xuất được...
Dialogue: 0,0:06:40.62,0:06:44.11,Default,,0000,0000,0000,,...có chi tiết về các vụ đánh bom khủng bố\Nmà người này từng thực hiện,
Dialogue: 0,0:06:44.52,0:06:50.69,Default,,0000,0000,0000,,cũng như dữ liệu khuôn mặt của những cơ thể máy\Nmà hắn hoán đổi vào trước mỗi vụ tấn công.
Dialogue: 0,0:06:51.40,0:06:54.09,Default,,0000,0000,0000,,Các ngài có tìm thấy ai trùng khớp\Nvới dữ liệu khuôn mặt đó...
Dialogue: 0,0:06:54.20,0:06:56.69,Default,,0000,0000,0000,,...trên nhật ký lưu trữ\Ncủa các tòa nhà bị đánh bom không?
Dialogue: 0,0:06:57.04,0:06:58.94,Default,,0000,0000,0000,,Chúng tôi đã tìm ra chính xác\Ntừng người một trong số đó.
Dialogue: 0,0:07:00.21,0:07:05.20,Default,,0000,0000,0000,,Sau nhiều ngày dằn vặt giữa việc nên chọn y đức\Nhay lương tâm đạo đức,
Dialogue: 0,0:07:05.31,0:07:07.68,Default,,0000,0000,0000,,vị bác sĩ Hà Lan đã báo cáo vụ việc\Nvới cảnh sát địa phương.
Dialogue: 0,0:07:08.15,0:07:10.58,Default,,0000,0000,0000,,Thật tiếc là ông ấy đã không báo cho cảnh sát\Nsớm hơn...
Dialogue: 0,0:07:11.12,0:07:14.58,Default,,0000,0000,0000,,Tôi hiểu ý cô, nhưng ta không thể\Ntrách người đàn ông đó được.
Dialogue: 0,0:07:14.99,0:07:19.55,Default,,0000,0000,0000,,Tôi hiểu tất cả những chuyện này, nhưng tại sao\Nchúng ta lại được đưa tới Berlin...
Dialogue: 0,0:07:19.66,0:07:23.43,Default,,0000,0000,0000,,...trong khi hội nghị thượng đỉnh tháng sau\Nlại được tổ chức ở Leeds?
Dialogue: 0,0:07:25.30,0:07:26.79,Default,,0000,0000,0000,,Đó là một câu hỏi rất hay.
Dialogue: 0,0:07:27.17,0:07:30.29,Default,,0000,0000,0000,,Cơ quan điều tra đã đối chiếu dữ liệu khuôn mặt\Ntrong quá khứ của người này...
Dialogue: 0,0:07:30.40,0:07:33.67,Default,,0000,0000,0000,,...với Hệ thống Hồng ngoại ở mọi sân bay\Ntrên toàn thế giới.
Dialogue: 0,0:07:34.04,0:07:39.57,Default,,0000,0000,0000,,Những gì họ phát hiện ra là trước khi thực hiện\Nmột vụ đánh bom,
Dialogue: 0,0:07:39.68,0:07:41.58,Default,,0000,0000,0000,,Lông vũ Thiên thần {\i1}luôn luôn{\i0} ghé qua\Ntrạm dừng ở Berlin này...
Dialogue: 0,0:07:41.68,0:07:47.88,Default,,0000,0000,0000,,...rồi mới rời sân bay quốc tế Tegel tới mục tiêu\Ntrước cuộc tấn công đúng hai ngày.
Dialogue: 0,0:07:49.26,0:07:53.69,Default,,0000,0000,0000,,Trong trường hợp thượng đỉnh Thượng Hải,\Nđó là ngày 17 tháng 2 năm 2028.
Dialogue: 0,0:07:54.43,0:07:59.13,Default,,0000,0000,0000,,Trước thượng đỉnh Moscow,\Nlà ngày 25 tháng 11 năm 2029.
Dialogue: 0,0:07:59.73,0:08:04.36,Default,,0000,0000,0000,,Và với thượng đỉnh Paris,\Nlà ngày 13 tháng 7 năm 2030.
Dialogue: 0,0:08:04.47,0:08:06.70,Default,,0000,0000,0000,,Trong mọi trường hợp, đều là hai ngày\Ntrước hội nghị thượng đỉnh.
Dialogue: 0,0:08:06.87,0:08:10.81,Default,,0000,0000,0000,,Vì lý do nào đó, hắn đã lặp lại quy luật này\Nđúng ba lần trong quá khứ.
Dialogue: 0,0:08:11.24,0:08:14.18,Default,,0000,0000,0000,,Đối với một kẻ như Lông vũ Thiên thần,\Nngười vốn chẳng bộc lộ hành vi chung nào...
Dialogue: 0,0:08:14.28,0:08:18.91,Default,,0000,0000,0000,,...ngoài phương thức tấn công của mình, đây chắc chắn\Nlà một kiểu mẫu hành vi bất thường.
Dialogue: 0,0:08:19.32,0:08:21.75,Default,,0000,0000,0000,,Hắn đi theo tuyến đường nào\Nđể vào Berlin?
Dialogue: 0,0:08:21.99,0:08:23.85,Default,,0000,0000,0000,,Đó là điều duy nhất\Nmà chúng tôi chưa biết.
Dialogue: 0,0:08:24.19,0:08:27.42,Default,,0000,0000,0000,,Nhưng dù vì bất kỳ lý do gì đi nữa,\Nhắn luôn...
Dialogue: 0,0:08:27.76,0:08:30.59,Default,,0000,0000,0000,,...ghé lại Berlin trước khi thực hiện\Ncác vụ đánh bom.
Dialogue: 0,0:08:31.16,0:08:34.46,Default,,0000,0000,0000,,Do đó, xác suất rất cao là hắn sẽ vào Berlin...
Dialogue: 0,0:08:34.77,0:08:38.07,Default,,0000,0000,0000,,...và lưu trú tại đây trong vài ngày\Ntrước thềm hội nghị.
Dialogue: 0,0:08:39.01,0:08:41.74,Default,,0000,0000,0000,,Chúng ta có thể giả định rằng cái tên và cơ thể máy\Nmà hắn sử dụng trong thời gian đó...
Dialogue: 0,0:08:41.84,0:08:43.93,Default,,0000,0000,0000,,...sẽ giống hệt với những thông tin\Ntrong tập hồ sơ này.
Dialogue: 0,0:08:44.91,0:08:48.37,Default,,0000,0000,0000,,Đây là cơ hội đầu tiên, và cũng là tốt nhất từ trước đến nay\Nđể chúng ta tóm gọn hắn.
Dialogue: 0,0:08:49.02,0:08:54.21,Default,,0000,0000,0000,,Trong thời gian hắn ở đây, chúng ta sẽ làm bất cứ giá nào\Nđể bắt giữ hắn.
Dialogue: 0,0:08:55.49,0:08:58.65,Default,,0000,0000,0000,,{\i1}Và đây chính là cái gọi là{\i0}\N{\i1}\"bằng bất cứ giá nào\" của ổng sao?{\i0}
Dialogue: 0,0:08:59.63,0:09:02.79,Default,,0000,0000,0000,,{\i1}Mình suýt nữa thì xin rút khỏi{\i0}\N{\i1}cái chiến dịch chết tiệt này rồi đấy...{\i0}
Dialogue: 0,0:09:08.60,0:09:11.00,Default,,0000,0000,0000,,{\i1}Chẳng hiểu sao mà lũ chó{\i0}\N{\i1}cứ ghét cay ghét đắng mình thế không biết...{\i0}
Dialogue: 0,0:09:22.05,0:09:23.64,Default,,0000,0000,0000,,{\i1}Lại là cô bé đó à?{\i0}
Dialogue: 0,0:09:24.05,0:09:26.31,Default,,0000,0000,0000,,{\i1}Tầm giờ này con bé đi đâu{\i0}\N{\i1}lủi thủi một mình thế kia?{\i0}
Dialogue: 0,0:09:26.72,0:09:28.38,Default,,0000,0000,0000,,{\i1}Lại còn đi giữa trời tuyết rơi nữa chứ...{\i0}
Dialogue: 0,0:10:04.59,0:10:08.79,Default,,0000,0000,0000,,{\i1}Sở chỉ huy kiểm tra.{\i0}\N{\i1}Toàn bộ nhân sự tại khu vực D, báo cáo tình trạng.{\i0}
Dialogue: 0,0:10:09.80,0:10:13.46,Default,,0000,0000,0000,,{\i1}D-1, không thấy bóng dáng mục tiêu.{\i0}\N{\i1}Không có gì bất thường.{\i0}
Dialogue: 0,0:10:16.17,0:10:19.40,Default,,0000,0000,0000,,{\i1}D-2, không thấy mục tiêu.{\i0}\N{\i1}Khả năng ẩn nấp bằng không.{\i0}
Dialogue: 0,0:10:23.14,0:10:26.34,Default,,0000,0000,0000,,{\i1}D-3, không thấy mục tiêu.{\i0}\N{\i1}Không có gì để báo cáo.{\i0}
Dialogue: 0,0:10:27.28,0:10:30.87,Default,,0000,0000,0000,,{\i1}D-4, không thấy mục tiêu.{\i0}\N{\i1}Không có gì bất thường.{\i0}
Dialogue: 0,0:10:31.42,0:10:32.61,Default,,0000,0000,0000,,{\i1}Sở chỉ huy rõ.{\i0}
Dialogue: 0,0:10:32.72,0:10:35.59,Default,,0000,0000,0000,,{\i1}Toàn đội duy trì vị trí mai phục{\i0}\N{\i1}và tiếp tục giám sát.{\i0}
Dialogue: 0,0:10:36.42,0:10:39.65,Default,,0000,0000,0000,,{\i1}Dù thế nào đi nữa, chiến dịch này{\i0}\N{\i1}sẽ kết thúc trong hai ngày nữa.{\i0}
Dialogue: 0,0:10:40.03,0:10:42.59,Default,,0000,0000,0000,,{\i1}Nếu Lông vũ Thiên thần{\i0}\N{\i1}không xuất hiện ở đây,{\i0}
Dialogue: 0,0:10:42.83,0:10:45.02,Default,,0000,0000,0000,,{\i1}giới chức ở Leeds{\i0}\N{\i1}sẽ tiếp quản chiến dịch,{\i0}
Dialogue: 0,0:10:45.13,0:10:48.97,Default,,0000,0000,0000,,{\i1}...và cuộc điều tra sẽ quay về việc truy lùng{\i0}\N{\i1}một tên khủng bố không mặt.{\i0}
Dialogue: 0,0:10:49.47,0:10:52.63,Default,,0000,0000,0000,,{\i1}Hãy thực hiện nhiệm vụ với sự tập trung cao độ.{\i0}\N{\i1}Đừng để cơ hội này tuột mất.{\i0}
Dialogue: 0,0:10:52.94,0:10:54.20,Default,,0000,0000,0000,,{\i1}- Rõ.{\i0}\N{\i1}- Rõ.{\i0}
Dialogue: 0,0:10:55.64,0:10:57.51,Default,,0000,0000,0000,,{\i1}D-4, không nghe thấy tín hiệu.{\i0}
Dialogue: 0,0:10:58.38,0:10:59.78,Default,,0000,0000,0000,,{\i1}Rõ rồi thưa sếp.{\i0}
Dialogue: 0,0:11:19.53,0:11:22.13,Default,,0000,0000,0000,,Mình {\i1}chắc chắn{\i0} không sinh ra\Nđể làm mấy cái nhiệm vụ kiểu này...
Dialogue: 0,0:11:33.38,0:11:37.08,Default,,0000,0000,0000,,\"Nhân chứng nhìn thấy Quái vật Vô hình\Ntại Ga tàu và Sân bay\" à?
Dialogue: 0,0:11:38.28,0:11:41.74,Default,,0000,0000,0000,,Hóa ra không phải mỗi mình mình\Nchán đến chết đi được...
Dialogue: 0,0:11:46.96,0:11:51.02,Default,,0000,0000,0000,,\"Người tị nạn châu Á tuyên bố Dejima của Nhật Bản\Nlà Khu tự trị\"...
Dialogue: 0,0:11:51.93,0:11:54.16,Default,,0000,0000,0000,,Nghe như tình hình ở quê nhà\Nđang ngày càng tồi tệ hơn...
Dialogue: 0,0:12:00.47,0:12:01.96,Default,,0000,0000,0000,,{\i1}Có chuyện gì với cô bé đó thế nhỉ?{\i0}
Dialogue: 0,0:12:02.21,0:12:04.61,Default,,0000,0000,0000,,{\i1}Chẳng lẽ con bé nhận ra mình{\i0}\N{\i1}từ tối hôm qua sao?{\i0}
Dialogue: 0,0:12:05.84,0:12:07.94,Default,,0000,0000,0000,,{\i1}Dù có nhận ra,{\i0}\N{\i1}thì bằng cách quái nào chứ...{\i0}
Dialogue: 0,0:12:47.72,0:12:53.22,Default,,0000,0000,0000,,Tại sao thế, Thiên thần? Email của bố\Nđã gửi tới từ hai tuần trước...
Dialogue: 0,0:12:53.86,0:12:56.16,Default,,0000,0000,0000,,Sao bố vẫn chưa chịu xuất hiện\Nvới con chứ?
Dialogue: 0,0:12:56.53,0:12:57.65,Default,,0000,0000,0000,,{\i1}\"Bố\" ư?{\i0}
Dialogue: 0,0:13:04.44,0:13:09.70,Default,,0000,0000,0000,,Nhưng con cảm nhận được bố đang ở rất gần con.\NChắc bố còn có việc quan trọng cần giải quyết.
Dialogue: 0,0:13:14.78,0:13:15.84,Default,,0000,0000,0000,,Ai ở đó thế?
Dialogue: 0,0:13:16.42,0:13:18.21,Default,,0000,0000,0000,,{\i1}Giác quan của con bé{\i0}\N{\i1}nhạy bén đến mức đó sao?{\i0}
Dialogue: 0,0:13:19.42,0:13:20.75,Default,,0000,0000,0000,,Khoan đã, chẳng lẽ...
Dialogue: 0,0:13:47.71,0:13:49.34,Default,,0000,0000,0000,,{\i1}Một trại trẻ mồ côi...{\i0}
Dialogue: 0,0:14:19.45,0:14:22.28,Default,,0000,0000,0000,,{\i1}Trời đất, con bé nhìn thấy mình{\i0}\N{\i1}từ tận khoảng cách này sao?{\i0}
Dialogue: 0,0:14:42.47,0:14:46.91,Default,,0000,0000,0000,,Thiên thần ơi, con luôn bảo với bố\Nlà con chẳng cần thứ gì cả.
Dialogue: 0,0:14:47.51,0:14:49.37,Default,,0000,0000,0000,,Thế nhưng lần này, con thực sự\Nrất muốn một thứ.
Dialogue: 0,0:14:50.08,0:14:54.07,Default,,0000,0000,0000,,Con nghĩ lần này bố sẽ lại trở về\Ntrong một cơ thể máy mới nữa,
Dialogue: 0,0:14:56.25,0:14:57.61,Default,,0000,0000,0000,,Thứ con muốn là...
Dialogue: 0,0:14:59.89,0:15:02.35,Default,,0000,0000,0000,,Theresia, con xuống đây\Nmột lát được không?
Dialogue: 0,0:15:02.82,0:15:03.88,Default,,0000,0000,0000,,Dạ con xuống ngay ạ!
Dialogue: 0,0:15:20.71,0:15:22.00,Default,,0000,0000,0000,,Đây là lá thư đó à?
Dialogue: 0,0:15:23.74,0:15:26.77,Default,,0000,0000,0000,,\"Bố đây. Bố sẽ đến thăm con\Nvào lúc nào đó trong hai tuần tới.
Dialogue: 0,0:15:27.15,0:15:28.98,Default,,0000,0000,0000,,Chúng ta gặp nhau ở nhà thờ\Nnhư mọi khi nhé.\"
Dialogue: 0,0:15:29.35,0:15:31.65,Default,,0000,0000,0000,,Bức thư chẳng hề có dấu mốc thời gian cụ thể nhỉ?
Dialogue: 0,0:15:48.73,0:15:51.46,Default,,0000,0000,0000,,Xin lỗi nhóc nhé, nhưng chú phải\Nngó qua một chút.
Dialogue: 0,0:15:58.04,0:15:59.94,Default,,0000,0000,0000,,Chà, nét chữ của con bé khó đọc thật...
Dialogue: 0,0:16:00.48,0:16:03.21,Default,,0000,0000,0000,,\"Ngày 12 tháng 7 năm 2030.\"
Dialogue: 0,0:16:03.32,0:16:07.25,Default,,0000,0000,0000,,\"Tối nay bố đã đến. Gặp nhau\Ntại nhà nguyện trong nhà thờ.\"
Dialogue: 0,0:16:11.09,0:16:13.96,Default,,0000,0000,0000,,\"Ngày 24 tháng 11 năm 2029.\"
Dialogue: 0,0:16:14.16,0:16:16.39,Default,,0000,0000,0000,,\"Bố đã trở về,\Nđúng như lời bố hứa.\"
Dialogue: 0,0:16:16.76,0:16:18.86,Default,,0000,0000,0000,,\"Giáng sinh đã đến\Nsớm hơn một tháng.\"
Dialogue: 0,0:16:19.13,0:16:23.53,Default,,0000,0000,0000,,\"Món quà bố tặng con trong nhà nguyện\Nlà một chiếc áo khoác cashmere.\"
Dialogue: 0,0:16:30.01,0:16:32.77,Default,,0000,0000,0000,,\"Ngày 11 tháng 2 năm 2028.\"
Dialogue: 0,0:16:33.51,0:16:35.88,Default,,0000,0000,0000,,\"Một tin nhắn từ bố\Nbất ngờ gửi tới.\"
Dialogue: 0,0:16:36.52,0:16:41.01,Default,,0000,0000,0000,,\"Gặp nhau tại nhà nguyện trong nhà thờ.\NNhận được đôi găng tay len làm quà.\"
Dialogue: 0,0:16:41.62,0:16:46.06,Default,,0000,0000,0000,,Tất cả đều trùng khớp. Mỗi ngày đều là\Nngày trước khi Angelica rời Berlin.
Dialogue: 0,0:16:50.93,0:16:52.09,Default,,0000,0000,0000,,Khoan đã, đây là...
Dialogue: 0,0:16:53.03,0:16:57.23,Default,,0000,0000,0000,,\"Đề phòng trường hợp bố trở về trong cơ thể máy mới\Nvà con không nhận ra,\"
Dialogue: 0,0:16:57.34,0:16:58.60,Default,,0000,0000,0000,,\"bố con mình có mật khẩu.\"
Dialogue: 0,0:16:59.57,0:17:02.04,Default,,0000,0000,0000,,\"Hôm nay thiên thần\Nsẽ lên đường làm gì?\"
Dialogue: 0,0:17:02.67,0:17:06.11,Default,,0000,0000,0000,,\"Người lên đường để rải những chiếc lông vũ\Ncủa mình khắp thế giới\"...
Dialogue: 0,0:17:07.38,0:17:11.21,Default,,0000,0000,0000,,Điều này đồng nghĩa với việc cô bé này\Nchính là con gái của Lông vũ Thiên thần?!
Dialogue: 0,0:17:41.28,0:17:46.18,Default,,0000,0000,0000,,{\i1}Sở chỉ huy kiểm tra.{\i0}\N{\i1}Toàn bộ nhân sự tại khu vực D, báo cáo tình trạng.{\i0}
Dialogue: 0,0:17:46.59,0:17:50.28,Default,,0000,0000,0000,,{\i1}D-1, không thấy bóng dáng mục tiêu.{\i0}\N{\i1}Khả năng ẩn nấp bằng không.{\i0}
Dialogue: 0,0:17:50.92,0:17:54.26,Default,,0000,0000,0000,,{\i1}D-2, không thấy mục tiêu.{\i0}\N{\i1}Khả năng ẩn nấp bằng không.{\i0}
Dialogue: 0,0:17:54.89,0:17:58.09,Default,,0000,0000,0000,,{\i1}D-3, không thấy mục tiêu.{\i0}\N{\i1}Không có gì bất thường.{\i0}
Dialogue: 0,0:17:59.83,0:18:01.96,Default,,0000,0000,0000,,{\i1}D-4, tại sao anh lại{\i0}\N{\i1}thay đổi vị trí?{\i0}
Dialogue: 0,0:18:02.33,0:18:07.80,Default,,0000,0000,0000,,{\i1}À thì, bên đó có nhiều chó hoang quá.{\i0}\N{\i1}Hệ 3003 cũng chẳng qua mắt được mũi chó.{\i0}
Dialogue: 0,0:18:08.14,0:18:10.44,Default,,0000,0000,0000,,{\i1}Nếu muốn đổi vị trí,{\i0}\N{\i1}phải báo cáo trước.{\i0}
Dialogue: 0,0:18:10.84,0:18:12.57,Default,,0000,0000,0000,,{\i1}Chúng tôi sẽ phát lệnh{\i0}\N{\i1}sau khi anh xác nhận tình trạng.{\i0}
Dialogue: 0,0:18:12.95,0:18:14.00,Default,,0000,0000,0000,,{\i1}Rõ...{\i0}
Dialogue: 0,0:18:59.69,0:19:03.35,Default,,0000,0000,0000,,Ngươi đang cố chuộc tội cho vô số sinh mạng vô tội\Nmà ngươi đã cướp đi sao?
Dialogue: 0,0:19:07.63,0:19:08.57,Default,,0000,0000,0000,,Ai ở đó?
Dialogue: 0,0:19:18.51,0:19:19.50,Default,,0000,0000,0000,,Angelica!
Dialogue: 0,0:19:19.61,0:19:24.07,Default,,0000,0000,0000,,Bọn tao biết mày chính là Lông vũ Thiên thần.\NTốt nhất hãy ngoan ngoãn đầu hàng đi.
Dialogue: 0,0:19:24.35,0:19:26.41,Default,,0000,0000,0000,,Các người nói cái gì thế?\NTôi...
Dialogue: 0,0:19:26.75,0:19:29.55,Default,,0000,0000,0000,,Đừng có quanh co. Bọn tao có tin tình báo\Nchứng minh mày chính là hắn.
Dialogue: 0,0:19:30.12,0:19:32.75,Default,,0000,0000,0000,,Nếu không, cảnh sát đâu có mặt ở đây,\Nđúng chứ?
Dialogue: 0,0:19:32.89,0:19:34.22,Default,,0000,0000,0000,,Tao nói có đúng không?
Dialogue: 0,0:19:36.26,0:19:39.86,Default,,0000,0000,0000,,Ngay cả sau khi đã tước đoạt biết bao sinh mạng\Nvì thứ tư tưởng vị kỷ của mình,
Dialogue: 0,0:19:39.97,0:19:42.33,Default,,0000,0000,0000,,ngươi vẫn muốn làm một người cha bình thường\Ncủa con gái mình sao?
Dialogue: 0,0:19:42.97,0:19:46.43,Default,,0000,0000,0000,,Tao dám cá từng có những đứa trẻ và những người mẹ\Nđang mỏi mòn chờ đợi quà...
Dialogue: 0,0:19:46.77,0:19:50.17,Default,,0000,0000,0000,,...ở tất cả những nơi mày đánh bom\Nvà trút mưa mảnh kính xuống đầu họ.
Dialogue: 0,0:19:50.68,0:19:55.74,Default,,0000,0000,0000,,Nếu mày nghĩ mình có thể giết chừng đó người\Nrồi vẫn thản nhiên đến gặp con gái như không có gì xảy ra,
Dialogue: 0,0:19:55.85,0:19:57.14,Default,,0000,0000,0000,,thì mày lầm to rồi!
Dialogue: 0,0:19:57.75,0:20:01.21,Default,,0000,0000,0000,,Rất tiếc anh bạn à, nhưng có lẽ mày sẽ không bao giờ\Nđược nhìn thấy con gái mình nữa đâu.
Dialogue: 0,0:20:03.26,0:20:05.72,Default,,0000,0000,0000,,Có lẽ là vậy...\NAnh nói đúng.
Dialogue: 0,0:20:08.89,0:20:11.83,Default,,0000,0000,0000,,Anh có biết\Ncon gái tôi không?
Dialogue: 0,0:20:13.00,0:20:18.44,Default,,0000,0000,0000,,Tôi có một thỉnh cầu. Nếu anh biết con bé là ai,\Nanh có thể trao gói đồ đó cho nó được không?
Dialogue: 0,0:20:19.27,0:20:22.30,Default,,0000,0000,0000,,Đó là thứ mà con bé\Nhằng ao ước bấy lâu nay.
Dialogue: 0,0:20:52.24,0:20:53.36,Default,,0000,0000,0000,,Thiếu tá?
Dialogue: 0,0:20:58.74,0:21:00.71,Default,,0000,0000,0000,,Anh thực sự cảm thấy thương hại\Ncho gã này sao?
Dialogue: 0,0:21:01.05,0:21:03.91,Default,,0000,0000,0000,,Tôi đã định đứng ngoài không can thiệp,\Nnhưng anh làm ăn {\i1}quá sức{\i0} cẩu thả đấy!
Dialogue: 0,0:21:04.75,0:21:07.51,Default,,0000,0000,0000,,Xin lỗi vì chuyện đó.\NNhưng làm sao cô biết được nơi này?
Dialogue: 0,0:21:08.49,0:21:12.92,Default,,0000,0000,0000,,Tôi biết mình không thể dùng chìa khóa xâm nhập Ghost\Nlên anh như đã làm với Togusa.
Dialogue: 0,0:21:13.36,0:21:16.02,Default,,0000,0000,0000,,Nên tôi đã hack ngược lại\Nvào các phần tử quang học của anh.
Dialogue: 0,0:21:16.53,0:21:17.96,Default,,0000,0000,0000,,Cô làm từ lúc nào...
Dialogue: 0,0:21:18.73,0:21:20.29,Default,,0000,0000,0000,,Nếu anh không mất cảnh giác kể từ sau cuộc liên lạc\Nmã hóa của chúng ta ngày hôm qua,
Dialogue: 0,0:21:20.40,0:21:22.09,Default,,0000,0000,0000,,thì anh đã phát hiện ra rồi.
Dialogue: 0,0:21:23.90,0:21:28.13,Default,,0000,0000,0000,,Sau khi báo cho sở chỉ huy tới bắt giữ tên này,\Nchiến dịch sẽ kết thúc.
Dialogue: 0,0:21:28.91,0:21:30.43,Default,,0000,0000,0000,,Chúng ta sẽ quay về\NNhật Bản.
Dialogue: 0,0:21:42.12,0:21:44.02,Default,,0000,0000,0000,,Bố ơi?\NCó phải bố đó không bố?
Dialogue: 0,0:21:44.29,0:21:47.02,Default,,0000,0000,0000,,Vừa nãy con nghe thấy tiếng động lớn.\NCó chuyện gì thế ạ?
Dialogue: 0,0:21:48.39,0:21:52.66,Default,,0000,0000,0000,,Khoan đã, con bé không nhìn thấy mình...\NNhóc bị mù suốt thời gian qua sao?
Dialogue: 0,0:21:53.60,0:21:54.83,Default,,0000,0000,0000,,Ai ở đó thế?
Dialogue: 0,0:21:56.94,0:22:01.30,Default,,0000,0000,0000,,Bố ơi? Là bố phải không?\NCon nhận ra bố mà.
Dialogue: 0,0:22:02.01,0:22:04.10,Default,,0000,0000,0000,,Bố ơi...
Dialogue: 0,0:22:06.75,0:22:10.01,Default,,0000,0000,0000,,Bố ơi? Con sợ quá.\NBố nói gì đi bố.
Dialogue: 0,0:22:10.75,0:22:12.61,Default,,0000,0000,0000,,Bố đang ở đó đúng không?
Dialogue: 0,0:22:14.29,0:22:18.59,Default,,0000,0000,0000,,Bố ơi, hôm nay thiên thần\Nsẽ lên đường làm gì ạ?
Dialogue: 0,0:22:20.89,0:22:23.92,Default,,0000,0000,0000,,Hôm nay thiên thần\Nsẽ lên đường làm gì ạ?
Dialogue: 0,0:22:26.77,0:22:28.32,Default,,0000,0000,0000,,Thiên thần...
Dialogue: 0,0:22:29.33,0:22:30.49,Default,,0000,0000,0000,,Thiên thần?
Dialogue: 0,0:22:32.94,0:22:34.10,Default,,0000,0000,0000,,Thiên thần...
Dialogue: 0,0:22:37.91,0:22:39.14,Default,,0000,0000,0000,,...sẽ không...
Dialogue: 0,0:22:42.48,0:22:44.51,Default,,0000,0000,0000,,...đi đâu\Nnữa cả.
Dialogue: 0,0:22:44.51,0:22:46.51,Default,,0000,0000,0000,,
