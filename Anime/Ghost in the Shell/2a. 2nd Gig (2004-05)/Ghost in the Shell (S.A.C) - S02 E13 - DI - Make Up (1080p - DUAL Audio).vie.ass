Dialogue: 0,0:01:33.09,0:01:35.79,Default,,0000,0000,0000,,Hãy lắng nghe đây,\Nhỡi quần chúng vô danh!
Dialogue: 0,0:01:35.79,0:01:37.62,Default,,0000,0000,0000,,Chúng ta là\NMười Một Cá Nhân,
Dialogue: 0,0:01:38.13,0:01:42.36,Default,,0000,0000,0000,,...những cá nhân độc lập tụ họp lại\Nđể cải tạo thế giới!
Dialogue: 0,0:01:43.37,0:01:48.23,Default,,0000,0000,0000,,Đất nước này đang nhanh chóng đi tới\Nhồi kết của một hệ thống!
Dialogue: 0,0:01:48.94,0:01:50.93,Default,,0000,0000,0000,,Những vụ đánh bom tự sát\Ncủa người tị nạn!
Dialogue: 0,0:01:51.24,0:01:54.70,Default,,0000,0000,0000,,Một chính phủ bất tín!\NXung đột với các quốc gia trên toàn thế giới!
Dialogue: 0,0:01:55.28,0:01:57.30,Default,,0000,0000,0000,,Chính những cá nhân liên kết lại\Ntạo nên một thể phức hợp...
Dialogue: 0,0:01:57.61,0:02:00.24,Default,,0000,0000,0000,,...sẽ cứu rỗi đất nước này thoát khỏi\Nhoàn cảnh ngặt nghèo hiện tại!
Dialogue: 0,0:02:00.85,0:02:03.44,Default,,0000,0000,0000,,Hãy thức tỉnh đi, hỡi quần chúng vô danh!
Dialogue: 0,0:02:03.92,0:02:06.59,Default,,0000,0000,0000,,Hãy thức tỉnh, và trở thành\Nmột phần của hệ thống!
Dialogue: 0,0:02:11.89,0:02:15.40,Top Secondary Dialog 1080P,,0000,0000,0000,,Hãy coi những hành động ngu xuẩn của lũ tị nạn\Nlà một lời tuyên chiến,
Dialogue: 0,0:02:12.29,0:02:16.87,Default,,0000,0000,0000,,Này! Bản tin 7 giờ đã bắt được âm thanh này chưa?\NĐược rồi à?
Dialogue: 0,0:02:15.40,0:02:16.87,Top Secondary Dialog 1080P,,0000,0000,0000,,và dẫn dắt chúng tới\Nsự tự do của chúng!
Dialogue: 0,0:02:16.87,0:02:19.00,Default,,0000,0000,0000,,Tốt, bọn tôi sẽ chuyển hình ảnh\Ncho các anh ngay!
Dialogue: 0,0:02:17.73,0:02:21.37,Top Secondary Dialog 1080P,,0000,0000,0000,,Những việc chúng ta đã làm\Nmới chỉ là màn dạo đầu mà thôi!
Dialogue: 0,0:02:19.57,0:02:21.37,Default,,0000,0000,0000,,Sugi! Nhìn kìa!
Dialogue: 0,0:02:22.47,0:02:26.13,Top Secondary Dialog 1080P,,0000,0000,0000,,Và hôm nay, chúng ta tới đây\Nđể thực hiện hành động cuối cùng!
Dialogue: 0,0:02:32.92,0:02:35.45,Default,,0000,0000,0000,,Hãy tiếp bước đại nghĩa của chúng ta!
Dialogue: 0,0:02:35.45,0:02:37.11,Default,,0000,0000,0000,,- Khoan đã!\N- Không cần nói nhiều nữa!
Dialogue: 0,0:02:40.86,0:02:44.05,Default,,0000,0000,0000,,{\i1}Đầu của họ! Họ vừa chém bay đầu{\i0}\N{\i1}của nhau kìa!{\i0}
Dialogue: 0,0:02:44.59,0:02:46.69,Default,,0000,0000,0000,,{\i1}Từng người một, họ...{\i0}\N{\i1}Họ đang tàn sát lẫn nhau!{\i0}
Dialogue: 0,0:02:46.80,0:02:49.29,Default,,0000,0000,0000,,{\i1}Một cảnh tượng không thể tin nổi!{\i0}
Dialogue: 0,0:02:49.50,0:02:51.27,Default,,0000,0000,0000,,{\i1}Những người đàn ông xuất hiện{\i0}\N{\i1}trên sân thượng...
Dialogue: 0,0:02:51.27,0:02:52.26,Default,,0000,0000,0000,,Dừng phát lại.
Dialogue: 0,0:02:52.43,0:02:55.06,Default,,0000,0000,0000,,Đó là đoạn phim quay lại cảnh tượng\Ncủa tổ chức Mười Một Cá Nhân...
Dialogue: 0,0:02:55.14,0:02:59.07,Default,,0000,0000,0000,,...bất ngờ xuất hiện trên bản tin thời sự 7 giờ\Ncủa đài NHTV tối qua.
Dialogue: 0,0:02:59.48,0:03:02.67,Default,,0000,0000,0000,,Cuối cùng chúng cũng lộ diện, rồi sau đó\Nlại tự sát tập thể sao?
Dialogue: 0,0:03:03.25,0:03:05.84,Default,,0000,0000,0000,,Hành động của chúng gợi nhắc rất rõ về hồ sơ tâm lý\Nmà chúng ta đã lập ra...
Dialogue: 0,0:03:05.95,0:03:07.94,Default,,0000,0000,0000,,...dựa trên thông tin tôi thu được từ nhân cách ảo\Ncủa Gohda.
Dialogue: 0,0:03:08.32,0:03:12.88,Default,,0000,0000,0000,,Tạo ra những mắt xích trung gian nhằm kích hoạt\Nmột hiện tượng Stand Alone Complex.
Dialogue: 0,0:03:13.02,0:03:17.02,Default,,0000,0000,0000,,\"Sự ra đời của một người anh hùng chỉ trọn vẹn\Nkhi người đó hy sinh...\"
Dialogue: 0,0:03:17.49,0:03:20.89,Default,,0000,0000,0000,,Tôi đoán hành động của chúng đã tuân theo\Nnhững trước tác của Patrick Sylvestre...
Dialogue: 0,0:03:21.00,0:03:23.46,Default,,0000,0000,0000,,...về cuộc cách mạng Cuba\Nmột cách rập khuôn.
Dialogue: 0,0:03:23.57,0:03:28.83,Default,,0000,0000,0000,,Và hắn đã cẩn thận ngụy tạo ra một bài tiểu luận ma\Nmang tên \"Mười Một Cá Nhân\".
Dialogue: 0,0:03:29.17,0:03:32.23,Default,,0000,0000,0000,,Việc đó đã che giấu khéo léo sự thật\Nrằng nó là một loại virus.
Dialogue: 0,0:03:33.18,0:03:36.61,Default,,0000,0000,0000,,Tôi cá là trên khắp cả nước, ngoài tên phóng viên\Nmà tôi tới gặp ra...
Dialogue: 0,0:03:36.68,0:03:40.67,Default,,0000,0000,0000,,...còn có rất nhiều kẻ khác đã tìm cách tự sát\Ntrong những hoàn cảnh đáng ngờ.
Dialogue: 0,0:03:41.35,0:03:43.72,Default,,0000,0000,0000,,Suýt nữa thì tôi cũng\Ntiêu đời rồi.
Dialogue: 0,0:03:44.79,0:03:49.09,Default,,0000,0000,0000,,Rõ ràng là tất cả những kẻ\Nbị nhiễm loại virus đó...
Dialogue: 0,0:03:49.39,0:03:52.02,Default,,0000,0000,0000,,...đều bị lập trình để tự kết liễu đời mình\Nvào phút cuối.
Dialogue: 0,0:03:54.86,0:03:58.86,Default,,0000,0000,0000,,Người tị nạn vốn đã bắt đầu hành động\Nbằng các vụ đánh bom tự sát.
Dialogue: 0,0:03:59.23,0:04:03.86,Default,,0000,0000,0000,,Chưa rõ sẽ có bao nhiêu kẻ bắt chước xuất hiện\Nsau buổi phát sóng vụ tự sát này,
Dialogue: 0,0:04:04.14,0:04:09.30,Default,,0000,0000,0000,,nhưng đa số người dân, những người vốn {\i1}chưa từng{\i0}\Nbận tâm đến vấn đề người tị nạn,
Dialogue: 0,0:04:09.38,0:04:12.84,Default,,0000,0000,0000,,...giờ đây đã nhận thức sâu sắc về sự tồn tại\Ncủa thùng thuốc súng này.
Dialogue: 0,0:04:13.75,0:04:16.72,Default,,0000,0000,0000,,Tôi e rằng chúng ta sẽ cần một loại vắc-xin\Nđể ngăn chặn một đợt bùng phát khác...
Dialogue: 0,0:04:16.99,0:04:18.75,Default,,0000,0000,0000,,...những người đã bắt đầu\Nphát tác triệu chứng.
Dialogue: 0,0:04:18.95,0:04:22.72,Default,,0000,0000,0000,,Rất có thể kế hoạch của Gohda\Nmới chỉ kết thúc giai đoạn một.
Dialogue: 0,0:04:23.33,0:04:26.92,Default,,0000,0000,0000,,Và dù phản ứng của dư luận cùng những kẻ bắt chước\Nsau buổi phát sóng này khiến tôi lo ngại,
Dialogue: 0,0:04:27.00,0:04:29.33,Default,,0000,0000,0000,,nhưng Đội 9 chúng ta cũng chẳng thể làm gì hơn\Nđể ngăn chặn điều đó,
Dialogue: 0,0:04:29.40,0:04:31.03,Default,,0000,0000,0000,,với quân số ít ỏi\Nnhư hiện tại.
Dialogue: 0,0:04:31.27,0:04:34.90,Default,,0000,0000,0000,,Đó là lý do chúng ta sẽ dồn toàn lực\Nvào Cục Tình báo Nội các.
Dialogue: 0,0:04:35.20,0:04:38.87,Default,,0000,0000,0000,,Và để làm được điều đó, tôi đoán chúng ta\Nsẽ phải tóm sống người đàn ông này.
Dialogue: 0,0:04:40.08,0:04:41.10,Default,,0000,0000,0000,,Chính xác.
Dialogue: 0,0:04:41.18,0:04:45.81,Default,,0000,0000,0000,,Nhưng rốt cuộc hắn {\i1}là{\i0} ai? Tại sao hắn lại là kẻ duy nhất\Nkhông tự kết liễu đời mình?
Dialogue: 0,0:04:46.05,0:04:49.61,Default,,0000,0000,0000,,Sẽ không thể xác định điều đó\Nmột cách chắc chắn...
Dialogue: 0,0:04:49.72,0:04:52.38,Default,,0000,0000,0000,,...nếu không trực tiếp phân tích\Nnão điện tử của hắn.
Dialogue: 0,0:04:52.62,0:04:56.89,Default,,0000,0000,0000,,Bên phòng giám định chúng tôi gọi những kẻ thế này,\Nnhững kẻ có hành vi hoàn toàn khác biệt...
Dialogue: 0,0:04:56.93,0:05:01.73,Default,,0000,0000,0000,,...dù nhiễm cùng một loại virus,\Nlà \"đột biến tự phát\".
Dialogue: 0,0:05:01.96,0:05:07.06,Default,,0000,0000,0000,,Vậy các anh đã thu thập thêm được thông tin gì mới\Nvề kẻ đột biến này từ đoạn phim chưa?
Dialogue: 0,0:05:07.24,0:05:10.50,Default,,0000,0000,0000,,Dĩ nhiên rồi. Trước hết,\Nhãy nhìn vào chỗ này.
Dialogue: 0,0:05:11.24,0:05:14.33,Default,,0000,0000,0000,,Điều này đã khiến tôi bận tâm khi xem đoạn phim\Nvụ tấn công Thủ tướng,
Dialogue: 0,0:05:14.64,0:05:17.04,Default,,0000,0000,0000,,nhưng người đàn ông này\Nkhông hề mấp máy môi khi nói.
Dialogue: 0,0:05:17.61,0:05:19.01,Default,,0000,0000,0000,,- Ngay chỗ này.\N- Các ngươi sẽ bị trừ khử!
Dialogue: 0,0:05:20.05,0:05:22.81,Default,,0000,0000,0000,,Vào lúc đó, tôi cứ ngỡ hắn đã ngắt kết nối\Nvới mạng lưới thần kinh...
Dialogue: 0,0:05:22.92,0:05:25.89,Default,,0000,0000,0000,,...nhằm tối ưu hóa hiệu năng\Ncủa cơ thể giả.
Dialogue: 0,0:05:26.62,0:05:28.85,Default,,0000,0000,0000,,Nhưng sau khi thấy hiện tượng tương tự\Ntrong vụ việc vừa rồi,
Dialogue: 0,0:05:28.92,0:05:31.66,Default,,0000,0000,0000,,tôi đã đi đến một kết luận\Nhoàn toàn khác.
Dialogue: 0,0:05:31.66,0:05:33.79,Default,,0000,0000,0000,,- Khoan đã!\N- Không cần nói nhiều nữa!
Dialogue: 0,0:05:38.83,0:05:42.20,Default,,0000,0000,0000,,Có vẻ như hắn hầu như không hề sử dụng\Nbất kỳ vi máy nào...
Dialogue: 0,0:05:42.27,0:05:45.10,Default,,0000,0000,0000,,...trong mạng lưới thần kinh\Ncơ mặt của mình.
Dialogue: 0,0:05:45.71,0:05:47.68,Default,,0000,0000,0000,,Ý anh là miệng hắn\Nchẳng bao giờ cử động sao?
Dialogue: 0,0:05:47.78,0:05:52.15,Default,,0000,0000,0000,,Không, nó có cử động chứ.\NChỉ là hắn hầu như {\i1}không thể{\i0} cử động nó được.
Dialogue: 0,0:05:52.35,0:05:55.11,Default,,0000,0000,0000,,Và điều đó sẽ giúp chúng ta\Ntruy lùng tên này kiểu gì?
Dialogue: 0,0:05:55.28,0:05:58.78,Default,,0000,0000,0000,,Đừng nóng vội thế. Tôi còn muốn các cậu\Nnhìn thật kỹ khuôn mặt của hắn.
Dialogue: 0,0:06:00.69,0:06:03.16,Default,,0000,0000,0000,,Hắn sở hữu một gương mặt khá điển trai đấy chứ,\Nđúng không?
Dialogue: 0,0:06:03.23,0:06:05.52,Default,,0000,0000,0000,,Chuyện đó thì có liên quan quái gì\Nở đây cơ chứ?
Dialogue: 0,0:06:05.59,0:06:07.29,Default,,0000,0000,0000,,Các cậu lúc nào\Ncũng sốt ruột...
Dialogue: 0,0:06:07.63,0:06:10.33,Default,,0000,0000,0000,,Nghe này.\NĐiều tôi muốn nói là,
Dialogue: 0,0:06:10.40,0:06:17.00,Default,,0000,0000,0000,,tại sao hắn lại mang gương mặt giống người đến thế,\Nnhưng lại {\i1}không có{\i0} các cơ biểu cảm?
Dialogue: 0,0:06:17.84,0:06:21.14,Default,,0000,0000,0000,,Khuôn mặt đó được tạo nên bởi\Nmột nghệ nhân điêu khắc mặt lành nghề?
Dialogue: 0,0:06:21.48,0:06:23.24,Default,,0000,0000,0000,,Tôi biết Thiếu tá sẽ nhận ra ngay mà,\NThiếu tá.
Dialogue: 0,0:06:23.55,0:06:28.11,Default,,0000,0000,0000,,Gương mặt này nhiều khả năng được chế tác\Nbởi một điêu khắc gia bậc thầy.
Dialogue: 0,0:06:28.92,0:06:33.18,Default,,0000,0000,0000,,Cảm nhận của tôi là tác giả của nó phải là một nghệ sĩ,\Nmột người hoạt động độc lập không thuộc công ty lớn nào.
Dialogue: 0,0:06:33.59,0:06:38.69,Default,,0000,0000,0000,,Nếu vậy, trên toàn bộ đất nước này\Nchỉ có vỏn vẹn hai nghệ nhân như thế.
Dialogue: 0,0:06:43.87,0:06:46.89,Default,,0000,0000,0000,,Tôi không ngờ nghệ nhân làm mặt\Nlại hiếm hoi đến mức đó đấy.
Dialogue: 0,0:06:47.14,0:06:49.20,Default,,0000,0000,0000,,Người ta bảo người Nhật\Nrất khéo tay,
Dialogue: 0,0:06:49.27,0:06:52.00,Default,,0000,0000,0000,,nhưng nghệ thuật tả thực chân thực như sống\Nchưa bao giờ là thế mạnh của họ.
Dialogue: 0,0:06:52.37,0:06:55.67,Default,,0000,0000,0000,,Có thể có vài nghệ nhân Nhật làm được mặt đại trà,\Nnhưng chắc chắn...
Dialogue: 0,0:06:55.74,0:06:58.41,Default,,0000,0000,0000,,...chẳng có mấy ai đủ tài năng nghệ thuật\Nđể tạo ra những khuôn mặt độc bản.
Dialogue: 0,0:06:58.51,0:06:59.91,Default,,0000,0000,0000,,Nghe cũng\Ncó lý đấy.
Dialogue: 0,0:07:02.12,0:07:03.41,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:07:10.63,0:07:12.53,Default,,0000,0000,0000,,Đội 9 đây!\NỞ đây xảy ra chuyện gì thế?
Dialogue: 0,0:07:12.76,0:07:15.39,Default,,0000,0000,0000,,Có vẻ là một vụ\Ngiết người, thưa sếp.
Dialogue: 0,0:07:16.97,0:07:20.16,Default,,0000,0000,0000,,{\i1}Thiếu tá, bọn tôi vừa tới nơi, và tình hình{\i0}\N{\i1}đã bắt đầu mờ ám rồi.{\i0}
Dialogue: 0,0:07:20.37,0:07:21.20,Default,,0000,0000,0000,,{\i1}Có chuyện gì thế?{\i0}
Dialogue: 0,0:07:21.27,0:07:23.47,Default,,0000,0000,0000,,{\i1}Có khả năng mục tiêu của chúng ta{\i0}\N{\i1}đã bị trừ khử.{\i0}
Dialogue: 0,0:07:23.57,0:07:25.20,Default,,0000,0000,0000,,{\i1}Hắn đã ra tay trước các cậu{\i0}\N{\i1}với người nghệ nhân sao?{\i0}
Dialogue: 0,0:07:25.24,0:07:29.20,Default,,0000,0000,0000,,{\i1}Tôi không rõ, nhưng cảnh sát tỉnh đã phong tỏa{\i0}\N{\i1}xưởng điêu khắc thành hiện trường án mạng rồi.{\i0}
Dialogue: 0,0:07:29.28,0:07:32.91,Default,,0000,0000,0000,,{\i1}Tôi sẽ cử Paz và Saito tới. Đừng để{\i0}\N{\i1}cảnh sát địa phương làm xáo trộn hiện trường.{\i0}
Dialogue: 0,0:07:33.18,0:07:35.05,Default,,0000,0000,0000,,{\i1}Tôi sẽ cố, nhưng e là{\i0}\N{\i1}đã quá muộn rồi.{\i0}
Dialogue: 0,0:07:36.69,0:07:41.21,Default,,0000,0000,0000,,Chúng tôi là Đội 9! Mấy người các anh\Nphiền tránh ra một bên một lát được không?
Dialogue: 0,0:07:42.56,0:07:46.19,Default,,0000,0000,0000,,Tại sao Đội 9 lại thọc mũi vào\Nmột vụ giết người rành rành thế này chứ?
Dialogue: 0,0:07:46.46,0:07:48.40,Default,,0000,0000,0000,,Nạn nhân có phải là nghệ nhân\Nđiêu khắc mặt không?
Dialogue: 0,0:07:48.50,0:07:49.56,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:07:49.70,0:07:52.90,Default,,0000,0000,0000,,Ông ấy là nhân chứng quan trọng\Ntrong một chuyên án chúng tôi đang thụ lý.
Dialogue: 0,0:07:53.20,0:07:54.76,Default,,0000,0000,0000,,Chà, thật tiếc\Nkhi phải nghe điều đó.
Dialogue: 0,0:07:54.90,0:07:57.37,Default,,0000,0000,0000,,Nhưng chúng tôi sẽ phá xong vụ này\Nngay trong nháy mắt thôi.
Dialogue: 0,0:07:57.67,0:08:01.87,Default,,0000,0000,0000,,Bọn tôi sẽ gửi hồ sơ cho các anh sau khi tóm được thủ phạm,\Nnên các chú ngoan ngoãn về nhà đi nhé.
Dialogue: 0,0:08:01.98,0:08:03.07,Default,,0000,0000,0000,,Ý các người là\Nsao hả?
Dialogue: 0,0:08:03.81,0:08:04.84,Default,,0000,0000,0000,,Nhìn đi.
Dialogue: 0,0:08:04.95,0:08:08.94,Default,,0000,0000,0000,,Chẳng cần phải là dân pháp y cũng thấy\Ncó thể lấy được dấu vân tay trên cán dao kia.
Dialogue: 0,0:08:09.02,0:08:11.58,Default,,0000,0000,0000,,Thêm nữa, nạn nhân và hung thủ\Nđã quen biết nhau từ trước.
Dialogue: 0,0:08:12.99,0:08:15.51,Default,,0000,0000,0000,,Họ còn ngồi uống rượu với nhau\Nngay trước khi án mạng xảy ra.
Dialogue: 0,0:08:16.69,0:08:21.69,Default,,0000,0000,0000,,Và trên hết, camera an ninh kia đã ghi lại\Nkhuôn mặt hung thủ rõ mồn một.
Dialogue: 0,0:08:22.43,0:08:25.16,Default,,0000,0000,0000,,Tôi nghĩ không cần phải nói huỵch toẹt ra\Ncho các anh hiểu đâu nhỉ.
Dialogue: 0,0:08:25.37,0:08:27.23,Default,,0000,0000,0000,,Vậy thì hãy cho chúng tôi\Nxem đoạn phim đó đi.
Dialogue: 0,0:08:27.34,0:08:28.46,Default,,0000,0000,0000,,Không được đâu.
Dialogue: 0,0:08:28.50,0:08:32.60,Default,,0000,0000,0000,,Nói {\i1}cái gì?{\i0} Nghe này, bọn tôi có thể tước quyền\Ncủa các người nếu cần thiết đấy.
Dialogue: 0,0:08:32.71,0:08:36.74,Default,,0000,0000,0000,,Mấy trò thị uy quyền lực đó chẳng dọa được tôi đâu.\NĐây là vụ án của {\i1}chúng tôi{\i0}.
Dialogue: 0,0:08:36.85,0:08:37.81,Default,,0000,0000,0000,,Thằng khốn này...
Dialogue: 0,0:08:38.51,0:08:40.11,Default,,0000,0000,0000,,Thôi nào, Batou...
Dialogue: 0,0:08:41.48,0:08:43.38,Default,,0000,0000,0000,,Này, dĩ hòa vi quý\Nkhông được sao?
Dialogue: 0,0:08:51.19,0:08:52.89,Default,,0000,0000,0000,,Đó là gã\Nđã...
Dialogue: 0,0:08:56.20,0:08:57.89,Default,,0000,0000,0000,,Anh là ai?
Dialogue: 0,0:09:07.14,0:09:09.70,Default,,0000,0000,0000,,Đúng là Paz rồi.\NKhông lẫn vào đâu được.
Dialogue: 0,0:09:10.01,0:09:12.31,Default,,0000,0000,0000,,Còn dấu vân tay\Ntrên vật chứng thì sao?
Dialogue: 0,0:09:12.58,0:09:13.91,Default,,0000,0000,0000,,Họ bảo kết quả\Ntrùng khớp hoàn toàn.
Dialogue: 0,0:09:14.22,0:09:16.74,Default,,0000,0000,0000,,Cả dấu môi trên\Nchiếc ly cũng thế.
Dialogue: 0,0:09:16.82,0:09:20.88,Default,,0000,0000,0000,,Lũ cảnh sát đang nóng lòng muốn bắt cậu ta,\Nnên không dễ gì bảo họ lùi bước đâu.
Dialogue: 0,0:09:22.36,0:09:27.62,Default,,0000,0000,0000,,Cảnh sát tỉnh phải hiểu rằng đoạn phim này\Nkhông phải chứng cứ kết luận,
Dialogue: 0,0:09:27.90,0:09:30.76,Default,,0000,0000,0000,,nhưng với dấu vân tay và dấu môi đó,\Nmọi chuyện trở nên phức tạp hơn nhiều.
Dialogue: 0,0:09:31.03,0:09:34.16,Default,,0000,0000,0000,,Ừ, nhưng cả hai thứ đó đều có thể\Nlàm giả được đúng không?
Dialogue: 0,0:09:34.67,0:09:38.70,Default,,0000,0000,0000,,Dĩ nhiên, nếu kẻ đó đánh cắp cả dữ liệu ADN\Nđược lưu trong cơ thể giả của nạn nhân.
Dialogue: 0,0:09:38.87,0:09:43.04,Default,,0000,0000,0000,,Nếu gã mang cơ thể giả đó là hung thủ,\Nliệu hắn có cất công bày vẽ đến mức này không?
Dialogue: 0,0:09:43.11,0:09:44.81,Default,,0000,0000,0000,,Tôi thấy khó mà\Ntin nổi.
Dialogue: 0,0:09:44.88,0:09:47.78,Default,,0000,0000,0000,,Rất có thể đây là một chuyện\Nhoàn toàn không liên quan.
Dialogue: 0,0:09:48.02,0:09:50.14,Default,,0000,0000,0000,,Paz, cậu có nghĩ ra\Nnghi phạm khả dĩ nào không?
Dialogue: 0,0:09:51.59,0:09:53.08,Default,,0000,0000,0000,,Hiện tại thì chưa.
Dialogue: 0,0:09:53.29,0:09:56.52,Default,,0000,0000,0000,,Được rồi, Ishikawa và Borma,\Nhãy rà soát lại dữ liệu chúng ta đã thu thập...
Dialogue: 0,0:09:56.73,0:09:58.92,Default,,0000,0000,0000,,...xem có hồ sơ nào về người đàn ông mang cơ thể giả\Ntrong đó không.
Dialogue: 0,0:09:59.19,0:10:01.69,Default,,0000,0000,0000,,Batou, Saito và Togusa, hãy phối hợp\Nvới cảnh sát tỉnh...
Dialogue: 0,0:10:01.76,0:10:04.06,Default,,0000,0000,0000,,...và điều tra theo hướng vụ sát hại\Nnghệ nhân điêu khắc mặt.
Dialogue: 0,0:10:04.83,0:10:07.30,Default,,0000,0000,0000,,Paz, cậu phải ở yên tại chỗ\Ncho đến khi được xóa bỏ hiềm nghi.
Dialogue: 0,0:10:07.64,0:10:11.07,Default,,0000,0000,0000,,Hãy báo cáo bất kỳ thông tin nào cậu nghĩ ra\Ncó thể liên quan đến vụ án.
Dialogue: 0,0:10:11.21,0:10:13.27,Default,,0000,0000,0000,,Chắc chắn phải có\Nnguyên do nào đó đằng sau chuyện này.
Dialogue: 0,0:10:14.44,0:10:15.64,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:10:23.85,0:10:27.62,Default,,0000,0000,0000,,Nói thật cho tôi biết đi.\NCậu thực sự biết điều gì đó đúng không?
Dialogue: 0,0:10:28.02,0:10:29.79,Default,,0000,0000,0000,,Không. Không có gì cả.
Dialogue: 0,0:10:30.46,0:10:33.05,Default,,0000,0000,0000,,Nếu có điều gì cậu không thể nói với Thiếu tá,\Ncậu có thể tâm sự với tôi.
Dialogue: 0,0:10:33.36,0:10:35.42,Default,,0000,0000,0000,,Nếu nhớ ra bất cứ điều gì,\Nhãy tìm tôi.
Dialogue: 0,0:10:36.43,0:10:37.80,Default,,0000,0000,0000,,Tôi sẽ làm thế.
Dialogue: 0,0:10:47.11,0:10:49.20,Default,,0000,0000,0000,,Một bộ mặt nạ tử thi\Ntrùng khớp.
Dialogue: 0,0:10:49.54,0:10:52.48,Default,,0000,0000,0000,,Chắc đó là sở thích mới\Ncủa bà chủ quán.
Dialogue: 0,0:10:53.78,0:10:55.01,Default,,0000,0000,0000,,Anh muốn dùng gì?
Dialogue: 0,0:10:56.69,0:10:58.45,Default,,0000,0000,0000,,Cho tôi một ly\Ngiống anh ta.
Dialogue: 0,0:11:01.86,0:11:03.26,Default,,0000,0000,0000,,Anh muốn gì à?
Dialogue: 0,0:11:03.46,0:11:07.45,Default,,0000,0000,0000,,Tôi từng tính bám đuôi anh, nhưng trông anh có vẻ sẽ nhận ra ngay,\Nnên tôi đành vào thẳng đây luôn.
Dialogue: 0,0:11:11.47,0:11:14.44,Default,,0000,0000,0000,,Tôi không thực sự nghĩ rằng\Nanh đã giết chết người đàn ông đó.
Dialogue: 0,0:11:15.40,0:11:19.40,Default,,0000,0000,0000,,Dù sao thì ở thành phố này chẳng hề thiếu người\Nmang khuôn mặt nhân tạo.
Dialogue: 0,0:11:20.08,0:11:22.91,Default,,0000,0000,0000,,Nhưng kẻ tôi thấy không chỉ đơn thuần\Ncó khuôn mặt giống anh.
Dialogue: 0,0:11:23.11,0:11:24.91,Default,,0000,0000,0000,,Hắn là một bản sao hoàn hảo\Ncủa chính anh.
Dialogue: 0,0:11:25.48,0:11:30.47,Default,,0000,0000,0000,,Cảm giác tôi nhận được từ đoạn phim đó\Nlà một sự ám ảnh kỳ lạ đối với anh.
Dialogue: 0,0:11:31.35,0:11:33.75,Default,,0000,0000,0000,,Hung thủ chắc chắn có mối liên hệ nào đó\Nvới anh.
Dialogue: 0,0:11:34.06,0:11:37.96,Default,,0000,0000,0000,,Nên tôi sẽ theo sát anh từng bước.\NTôi tới đây là để báo trước cho anh một tiếng.
Dialogue: 0,0:11:38.03,0:11:39.52,Default,,0000,0000,0000,,Tùy anh.
Dialogue: 0,0:11:46.54,0:11:50.03,Default,,0000,0000,0000,,Lần đầu tiên đấy nhé. Tôi chưa từng thấy anh\Nđến đây cùng một người đàn ông bao giờ.
Dialogue: 0,0:11:50.67,0:11:55.04,Default,,0000,0000,0000,,Thường thì anh chỉ đi một mình, hoặc mỗi lần\Nlại đi với một người phụ nữ khác nhau.
Dialogue: 0,0:11:55.61,0:11:57.44,Default,,0000,0000,0000,,Tôi không quen\Ngã đó.
Dialogue: 0,0:11:57.55,0:11:58.74,Default,,0000,0000,0000,,Ra vậy.
Dialogue: 0,0:11:59.71,0:12:01.51,Default,,0000,0000,0000,,Bà có sở thích mới\Nđấy à?
Dialogue: 0,0:12:02.28,0:12:03.68,Default,,0000,0000,0000,,Ồ, anh nói mấy thứ đó hả?
Dialogue: 0,0:12:07.02,0:12:10.48,Default,,0000,0000,0000,,Gần đây tôi có gặp một nghệ nhân\Nđiêu khắc mặt rất tài ba.
Dialogue: 0,0:12:10.56,0:12:11.92,Default,,0000,0000,0000,,Nghệ nhân điêu khắc mặt ư?
Dialogue: 0,0:12:12.03,0:12:16.46,Default,,0000,0000,0000,,Tôi đã quyết định nhờ ông ấy\Nlàm cho một khuôn mặt mới,
Dialogue: 0,0:12:16.57,0:12:20.83,Default,,0000,0000,0000,,nhưng khi đeo thử khuôn mặt ông ấy làm,\Ntôi đã nhận ra một điều.
Dialogue: 0,0:12:21.54,0:12:25.03,Default,,0000,0000,0000,,Rằng có thể Ghost của ta không nằm trong vỏ não,\Nmà lại nằm ngay trên làn da.
Dialogue: 0,0:12:25.54,0:12:29.91,Default,,0000,0000,0000,,Đặc biệt là trong từng đường nét và nếp nhăn\Nhằn sâu trên khuôn mặt.
Dialogue: 0,0:12:31.28,0:12:35.44,Default,,0000,0000,0000,,Nghe nói người nghệ nhân đó\Ntừng làm mặt mới...
Dialogue: 0,0:12:35.52,0:12:38.71,Default,,0000,0000,0000,,...cho những người lính\Nbị thương ngoài chiến trường.
Dialogue: 0,0:12:39.35,0:12:43.85,Default,,0000,0000,0000,,Ông ấy bảo một ngày nọ, ông nhận ra mức độ nghiêm trọng\Ncủa những vết thương tâm lý...
Dialogue: 0,0:12:43.93,0:12:47.42,Default,,0000,0000,0000,,...luôn tương xứng với độ sâu của những vết sẹo\Ntrên khuôn mặt họ.
Dialogue: 0,0:13:13.32,0:13:15.05,Default,,0000,0000,0000,,Ồ, hóa ra là cậu.
Dialogue: 0,0:13:20.63,0:13:21.72,Default,,0000,0000,0000,,Cậu đang làm cái gì thế?
Dialogue: 0,0:13:23.53,0:13:25.19,Default,,0000,0000,0000,,Mày là tên kia!
Dialogue: 0,0:13:30.14,0:13:31.80,Default,,0000,0000,0000,,Trời đất ơi.\NĐúng là hắn rồi.
Dialogue: 0,0:13:32.57,0:13:34.20,Default,,0000,0000,0000,,Tìm thấy hắn rồi,\NThiếu tá.
Dialogue: 0,0:13:35.11,0:13:39.01,Default,,0000,0000,0000,,Hắn tên là Hideo Kuze.\NCơ thể tên này là loại máy hoàn toàn.
Dialogue: 0,0:13:39.35,0:13:41.37,Default,,0000,0000,0000,,Đánh giá từ thông số kỹ thuật\Ntrong hồ sơ,
Dialogue: 0,0:13:41.45,0:13:44.54,Default,,0000,0000,0000,,hoàn toàn có thể khẳng định đó là cơ thể giả\Ndành riêng cho lực lượng gìn giữ hòa bình PKF.
Dialogue: 0,0:13:44.72,0:13:48.12,Default,,0000,0000,0000,,Còn về khuôn mặt, nó không có\Nnhiều mạng lưới thần kinh,
Dialogue: 0,0:13:48.19,0:13:51.02,Default,,0000,0000,0000,,đúng như bên phòng giám định\Nđã dự đoán.
Dialogue: 0,0:13:51.19,0:13:53.66,Default,,0000,0000,0000,,Có vẻ như chút ít biểu cảm và nếp nhăn\Ntrên khuôn mặt đó...
Dialogue: 0,0:13:53.73,0:13:56.06,Default,,0000,0000,0000,,...hoàn toàn là kết quả từ bàn tay tài hoa\Ncủa người nghệ nhân điêu khắc mặt.
Dialogue: 0,0:13:56.63,0:13:58.12,Default,,0000,0000,0000,,Khỏi phải nói,\Nđó là một tác phẩm độc bản.
Dialogue: 0,0:13:58.37,0:14:01.20,Default,,0000,0000,0000,,Nó được làm từ sợi lai nanocarbon và da sinh học nhân tạo...
Dialogue: 0,0:14:01.50,0:14:04.67,Default,,0000,0000,0000,,...có tích hợp cả chương trình tái tạo mô.
Dialogue: 0,0:14:05.27,0:14:06.64,Default,,0000,0000,0000,,Giờ thì tôi đã hiểu...
Dialogue: 0,0:14:06.71,0:14:10.94,Default,,0000,0000,0000,,Tôi không rõ có mối liên hệ trực tiếp nào không, nhưng người nghệ nhân bị sát hại...
Dialogue: 0,0:14:11.15,0:14:15.08,Default,,0000,0000,0000,,...dường như chỉ nhận làm mặt cho những cựu binh giải ngũ.
Dialogue: 0,0:14:16.32,0:14:21.48,Default,,0000,0000,0000,,Tôi cá là tên này đã nghe được tin đồn đó\Nvà nhờ ông ấy làm cho một khuôn mặt.
Dialogue: 0,0:14:22.02,0:14:24.15,Default,,0000,0000,0000,,Hideo Kuze sao?
Dialogue: 0,0:14:24.76,0:14:27.06,Default,,0000,0000,0000,,Toàn bộ hồ sơ từ thời đó\Nđã bị xóa sạch sành sanh,
Dialogue: 0,0:14:27.13,0:14:29.62,Default,,0000,0000,0000,,nên tôi đoán chúng ta phải truy lùng hắn\Ntheo cách truyền thống thôi.
Dialogue: 0,0:14:29.80,0:14:32.53,Default,,0000,0000,0000,,Ishikawa, chuẩn bị làm một chuyến\Nsang bán đảo đi.
Dialogue: 0,0:14:32.90,0:14:34.84,Default,,0000,0000,0000,,Mấy khúc xương già này quá cổ lỗ sĩ\Nđể chạy đôn chạy đáo khắp nơi thế này rồi...
Dialogue: 0,0:14:34.90,0:14:38.00,Default,,0000,0000,0000,,Anh là người có nhiều mối quan hệ\Nnhất ở bên đó mà.
Dialogue: 0,0:14:38.34,0:14:42.00,Default,,0000,0000,0000,,Vậy có lẽ tên này không liên quan gì\Nđến vụ giết người nghệ nhân điêu khắc mặt rồi.
Dialogue: 0,0:14:42.08,0:14:43.27,Default,,0000,0000,0000,,Nhiều khả năng là không.
Dialogue: 0,0:14:43.98,0:14:47.81,Default,,0000,0000,0000,,Nhưng hung thủ lại có mối liên hệ nào đó\Nvới Paz sao?
Dialogue: 0,0:14:49.38,0:14:52.08,Default,,0000,0000,0000,,Chuyện này rất có thể\Nlà liên quan đến phụ nữ đấy.
Dialogue: 0,0:14:53.32,0:14:55.15,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi có tin xấu đây.{\i0}
Dialogue: 0,0:14:55.26,0:14:56.38,Default,,0000,0000,0000,,{\i1}Chuyện gì thế?{\i0}
Dialogue: 0,0:14:56.46,0:14:58.59,Default,,0000,0000,0000,,{\i1}Một thanh tra thuộc cảnh sát tỉnh{\i0}\N{\i1}vừa bị giết hại.{\i0}
Dialogue: 0,0:15:00.46,0:15:03.76,Default,,0000,0000,0000,,{\i1}Và họ nói anh ta đã gặp Paz{\i0}\N{\i1}ngay trước khi bị sát hại.{\i0}
Dialogue: 0,0:15:04.00,0:15:05.16,Default,,0000,0000,0000,,{\i1}Paz đang ở cùng cậu à?{\i0}
Dialogue: 0,0:15:05.40,0:15:06.23,Default,,0000,0000,0000,,{\i1}Đúng vậy.{\i0}
Dialogue: 0,0:15:07.07,0:15:11.00,Default,,0000,0000,0000,,{\i1}Thiếu tá, rõ ràng có kẻ{\i0}\N{\i1}đang cố tình gài bẫy Paz.{\i0}
Dialogue: 0,0:15:11.71,0:15:13.67,Default,,0000,0000,0000,,{\i1}Căn cứ vào vỏ đạn{\i0}\N{\i1}rơi ở hiện trường,{\i0}
Dialogue: 0,0:15:13.74,0:15:16.80,Default,,0000,0000,0000,,{\i1}đầu đạn là loại chuyên dùng{\i0}\N{\i1}cho khẩu Seburo M5.{\i0}
Dialogue: 0,0:15:17.11,0:15:18.81,Default,,0000,0000,0000,,{\i1}Như thế thì quá mức{\i0}\N{\i1}trùng hợp rồi đấy.{\i0}
Dialogue: 0,0:15:18.91,0:15:21.97,Default,,0000,0000,0000,,{\i1}Paz, cậu vẫn chưa nhớ ra ai{\i0}\N{\i1}có thù oán với cậu sao?{\i0}
Dialogue: 0,0:15:22.18,0:15:24.08,Default,,0000,0000,0000,,{\i1}Khổ nỗi là có quá nhiều người.{\i0}
Dialogue: 0,0:15:24.89,0:15:30.69,Default,,0000,0000,0000,,{\i1}Thiếu tá, cho tôi xem dữ liệu khách hàng của ông thợ làm mặt,{\i0}\N{\i1}bắt đầu từ người gần đây nhất đi.{\i0}
Dialogue: 0,0:15:31.49,0:15:32.98,Default,,0000,0000,0000,,{\i1}Có thể nó sẽ gợi ra manh mối nào đó.{\i0}
Dialogue: 0,0:15:33.40,0:15:35.06,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}\N{\i1}Borma...{\i0}
Dialogue: 0,0:15:42.97,0:15:47.17,Default,,0000,0000,0000,,{\i1}Thiếu tá, từ lúc này hãy để tôi{\i0}\N{\i1}tự mình xử lý vụ án này.{\i0}
Dialogue: 0,0:15:48.08,0:15:50.34,Default,,0000,0000,0000,,{\i1}Nếu thấy tôi có nguy cơ gây phiền toái{\i0}\N{\i1}cho toàn đội,{\i0}
Dialogue: 0,0:15:50.41,0:15:52.64,Default,,0000,0000,0000,,{\i1}cứ việc khai trừ tôi ra{\i0}\N{\i1}nếu cần thiết.{\i0}
Dialogue: 0,0:15:53.42,0:15:57.35,Default,,0000,0000,0000,,Có vẻ đây là chuyện cá nhân rồi.\N{\i1}Rất{\i0} riêng tư nữa là đằng khác.
Dialogue: 0,0:15:58.42,0:16:00.65,Default,,0000,0000,0000,,{\i1}Được rồi.{\i0}\N{\i1}Cứ làm theo cách của cậu đi.{\i0}
Dialogue: 0,0:16:01.62,0:16:03.22,Default,,0000,0000,0000,,{\i1}Cảm ơn Thiếu tá.{\i0}
Dialogue: 0,0:16:08.13,0:16:10.46,Default,,0000,0000,0000,,Này, anh định đi đâu đấy?
Dialogue: 0,0:16:12.00,0:16:16.66,Default,,0000,0000,0000,,Các anh tìm nhầm người rồi. Định bảo Paz ở đây\Nlà nghi phạm đấy à?
Dialogue: 0,0:16:17.01,0:16:19.24,Default,,0000,0000,0000,,Chứng cứ gián tiếp\Nđang chỉ vào anh ta đấy.
Dialogue: 0,0:16:19.47,0:16:21.07,Default,,0000,0000,0000,,Có thể, nhưng\Ncậu ấy vô tội.
Dialogue: 0,0:16:21.44,0:16:22.97,Default,,0000,0000,0000,,Dù sao chúng tôi vẫn phải\Nthẩm vấn anh ta.
Dialogue: 0,0:16:23.08,0:16:24.55,Default,,0000,0000,0000,,Không cần thiết đâu.
Dialogue: 0,0:16:24.95,0:16:28.04,Default,,0000,0000,0000,,Nếu có bất kỳ khả năng nào là cậu ta,\Nchúng tôi đã tự tay làm từ lâu rồi.
Dialogue: 0,0:16:34.56,0:16:35.78,Default,,0000,0000,0000,,Batou.
Dialogue: 0,0:16:36.22,0:16:40.39,Default,,0000,0000,0000,,Tôi đã tải địa chỉ nơi tôi sắp đến\Nvào bộ nhớ ngoài của anh.
Dialogue: 0,0:16:40.76,0:16:44.70,Default,,0000,0000,0000,,Nếu tôi không quay lại,\Nhãy tới đó tìm tôi.
Dialogue: 0,0:16:45.57,0:16:47.73,Default,,0000,0000,0000,,Rõ rồi. Cậu có chắc muốn đi\Nmột mình không đấy?
Dialogue: 0,0:16:49.07,0:16:50.20,Default,,0000,0000,0000,,Chắc.
Dialogue: 0,0:18:25.47,0:18:26.87,Default,,0000,0000,0000,,Sao anh đến muộn thế?
Dialogue: 0,0:18:30.61,0:18:33.63,Default,,0000,0000,0000,,Đúng như em nghĩ, anh thực sự {\i1}đã{\i0}\Nquên sạch mọi thứ về em rồi.
Dialogue: 0,0:18:34.38,0:18:37.34,Default,,0000,0000,0000,,Mới chỉ có 5 năm trước thôi\Nkhi em còn sống ở nơi này.
Dialogue: 0,0:18:38.05,0:18:40.88,Default,,0000,0000,0000,,Cô cướp cơ thể giả của bà chủ quán bar\Ntừ lúc nào?
Dialogue: 0,0:18:41.32,0:18:43.48,Default,,0000,0000,0000,,Em đoán là vào khoảng\Nba tháng trước.
Dialogue: 0,0:18:43.89,0:18:46.72,Default,,0000,0000,0000,,Tình cờ một đêm nọ em nhìn thấy anh\Ntại quán bar.
Dialogue: 0,0:18:47.76,0:18:49.75,Default,,0000,0000,0000,,Anh chẳng hề để ý tới em chút nào,\Nphải không?
Dialogue: 0,0:18:50.26,0:18:52.35,Default,,0000,0000,0000,,Hộp não của người phụ nữ đó\Nđang ở đâu?
Dialogue: 0,0:18:52.79,0:18:56.66,Default,,0000,0000,0000,,Em chịu thôi. Chắc giờ đang nằm ở bãi rác\NYumenoshima rồi cũng nên.
Dialogue: 0,0:18:57.13,0:18:59.62,Default,,0000,0000,0000,,Tôi đoán đó cũng là nơi cô lấy được\Ndấu vân tay của tôi.
Dialogue: 0,0:19:00.07,0:19:01.26,Default,,0000,0000,0000,,Đúng thế.
Dialogue: 0,0:19:01.34,0:19:03.93,Default,,0000,0000,0000,,Tại sao cô lại cố gắng\Ntrở thành tôi?
Dialogue: 0,0:19:05.41,0:19:10.87,Default,,0000,0000,0000,,Em không tài nào hiểu nổi lý do\Ntại sao anh lại rời bỏ em.
Dialogue: 0,0:19:12.25,0:19:14.74,Default,,0000,0000,0000,,Đâu phải vì anh đã tìm thấy\Nngười phụ nữ khác.
Dialogue: 0,0:19:15.05,0:19:17.54,Default,,0000,0000,0000,,Cũng chẳng phải vì anh\Nghét bỏ em.
Dialogue: 0,0:19:18.49,0:19:22.58,Default,,0000,0000,0000,,Anh bảo em đừng hỏi gì về con người anh,\Nem đã ngoan ngoãn nghe lời.
Dialogue: 0,0:19:23.63,0:19:26.79,Default,,0000,0000,0000,,Em đã làm mọi điều anh muốn,\Nvậy mà anh vẫn bỏ rơi em...
Dialogue: 0,0:19:28.56,0:19:32.19,Default,,0000,0000,0000,,Anh có còn nhớ anh đã nói gì với em\Nkhi chúng ta lần đầu gặp gỡ không?
Dialogue: 0,0:19:33.23,0:19:36.26,Default,,0000,0000,0000,,\"Tôi không bao giờ ngủ với\Ncùng một người phụ nữ hai lần.\"
Dialogue: 0,0:19:37.81,0:19:40.37,Default,,0000,0000,0000,,Ban đầu, em đã nghĩ:\N\"Cái quái gì thế này?\"
Dialogue: 0,0:19:40.74,0:19:43.14,Default,,0000,0000,0000,,Nhưng khi chúng ta ngủ cùng nhau lần thứ hai,\Nem biết mình đã yêu anh.
Dialogue: 0,0:19:43.98,0:19:46.31,Default,,0000,0000,0000,,Em tin chắc rằng khi ấy\Nanh cũng cảm thấy như vậy.
Dialogue: 0,0:19:47.45,0:19:48.94,Default,,0000,0000,0000,,Anh là một kẻ nhẫn tâm.
Dialogue: 0,0:19:49.55,0:19:52.75,Default,,0000,0000,0000,,Em đã hận anh đến mức\Ntưởng chừng như phát điên.
Dialogue: 0,0:19:53.22,0:19:57.72,Default,,0000,0000,0000,,Nhưng dẫu vậy, em vẫn không ngừng tự hỏi\Ntại sao anh lại nỡ rời xa em.
Dialogue: 0,0:19:58.83,0:20:00.32,Default,,0000,0000,0000,,Và đó là lý do cô\Ncướp lấy khuôn mặt của tôi?
Dialogue: 0,0:20:00.63,0:20:01.53,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:20:01.60,0:20:03.26,Default,,0000,0000,0000,,Cô có hiểu thêm được điều gì\Nvề tôi không?
Dialogue: 0,0:20:04.70,0:20:08.93,Default,,0000,0000,0000,,Độ sâu sắc trong tình yêu\Nmà anh dành cho em.
Dialogue: 0,0:20:10.74,0:20:15.73,Default,,0000,0000,0000,,Anh và em vốn sống ở hai thế giới\Nhoàn toàn khác biệt, đúng chứ?
Dialogue: 0,0:20:17.28,0:20:21.91,Default,,0000,0000,0000,,Anh rời bỏ em là để ngăn em không phải nhìn thấy\Nthế giới tăm tối mà anh đang sống.
Dialogue: 0,0:20:22.25,0:20:23.95,Default,,0000,0000,0000,,Cô đánh giá tôi\Nquá cao rồi đấy.
Dialogue: 0,0:20:24.19,0:20:27.55,Default,,0000,0000,0000,,Không, anh chính là người đàn ông\Nnhư thế đấy.
Dialogue: 0,0:20:28.52,0:20:30.25,Default,,0000,0000,0000,,Nhưng giờ những điều đó\Nchẳng còn quan trọng nữa.
Dialogue: 0,0:20:30.43,0:20:34.45,Default,,0000,0000,0000,,Giờ đây em đã có Ghost của anh\Nbên trong mình rồi.
Dialogue: 0,0:20:35.50,0:20:39.09,Default,,0000,0000,0000,,Nên em không cần\Nmột bản thể thực sự của anh nữa.
Dialogue: 0,0:20:55.02,0:20:59.61,Default,,0000,0000,0000,,Nếu anh còn chút tình cảm nào dành cho em,\Nhãy chết ở đây đi.
Dialogue: 0,0:21:01.06,0:21:05.99,Default,,0000,0000,0000,,Được thôi, chẳng sao cả. Tôi không ngại bị giết\Nnếu người ra tay là cô.
Dialogue: 0,0:21:19.74,0:21:20.73,Default,,0000,0000,0000,,Bọn em đuổi theo\Nđây ạ!
Dialogue: 0,0:21:20.84,0:21:21.87,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:21:51.87,0:21:53.36,Default,,0000,0000,0000,,Cậu hạ được cô ta rồi chứ?
Dialogue: 0,0:22:12.93,0:22:14.92,Default,,0000,0000,0000,,Chi tiết đúng như\Ntôi đã báo cáo.
Dialogue: 0,0:22:15.33,0:22:17.30,Default,,0000,0000,0000,,Nghe đúng kiểu rắc rối mà Paz\Nsẽ dính vào thật đấy.
Dialogue: 0,0:22:17.37,0:22:18.49,Default,,0000,0000,0000,,Chắc vậy.
Dialogue: 0,0:22:19.87,0:22:23.23,Default,,0000,0000,0000,,Dù vậy, đáng lẽ cậu ta phải nhận ra\Nhung thủ là ai sớm hơn chứ.
Dialogue: 0,0:22:24.27,0:22:29.30,Default,,0000,0000,0000,,Tôi không chắc đâu. Ngoài kia có khi có cả tá phụ nữ\Nmuốn thấy cậu ta bỏ mạng đấy.
Dialogue: 0,0:22:30.01,0:22:31.14,Default,,0000,0000,0000,,Cô nói thật đấy à?
Dialogue: 0,0:22:31.21,0:22:36.08,Default,,0000,0000,0000,,Tôi chưa kiểm chứng hay gì đâu, nhưng lần đầu tiên\Ntôi tới gặp để chiêu mộ cậu ta,
Dialogue: 0,0:22:36.15,0:22:40.11,Default,,0000,0000,0000,,cậu ta đã bảo đại loại như: \"Tôi là kiểu đàn ông\Nkhông bao giờ ngủ với cùng một phụ nữ hai lần.\"
Dialogue: 0,0:22:42.49,0:22:43.58,Default,,0000,0000,0000,,Ôi trời đất ơi...
Dialogue: 0,0:22:44.69,0:22:48.56,Default,,0000,0000,0000,,Câu hỏi thực sự là, anh có nghĩ người tên Paz\N{\i1}kia{\i0} mới là hàng thật không?
Dialogue: 0,0:22:50.26,0:22:51.79,Default,,0000,0000,0000,,Chắc là vậy rồi.
Dialogue: 0,0:22:51.20,0:22:53.20,Default,,0000,0000,0000,,
