Dialogue: 0,0:01:16.81,0:01:23.87,GitS 2nd Gig OP Credits,,0000,0000,0000,,{\i1\fs85\c&H00FF00&\fad(0,2000)}Chúng ta sẽ quật khởi hay lụi tàn...{\i0}
Dialogue: 0,0:02:08.03,0:02:12.20,Default,,0000,0000,0000,,{\i1}Thủ tướng Kayabuki vừa chào đón{\i0}\N{\i1}Ngoại trưởng Schrader bằng một cái bắt tay.{\i0}
Dialogue: 0,0:02:12.64,0:02:15.76,Default,,0000,0000,0000,,{\i1}Đế quốc Mỹ vốn luôn phô trương cơ bắp{\i0}\N{\i1}như một cường quốc quân sự...{\i0}
Dialogue: 0,0:02:15.84,0:02:17.50,Default,,0000,0000,0000,,{\i1}...kể từ sau cuộc thế chiến{\i0}\N{\i1}vừa qua.{\i0}
Dialogue: 0,0:02:17.61,0:02:20.80,Default,,0000,0000,0000,,{\i1}Thế nhưng giờ đây, trước sự suy giảm quốc lực{\i0}\N{\i1}bắt nguồn từ cuộc sụp đổ kinh tế,{\i0}
Dialogue: 0,0:02:21.01,0:02:22.54,Default,,0000,0000,0000,,{\i1}họ dường như sẵn sàng{\i0}\N{\i1}gạt bỏ lòng tự tôn sang một bên,{\i0}
Dialogue: 0,0:02:22.65,0:02:25.11,Default,,0000,0000,0000,,{\i1}...minh chứng là việc Ngoại trưởng của họ{\i0}\N{\i1}đột ngột tới Nhật Bản nhằm tìm kiếm...{\i0}
Dialogue: 0,0:02:25.28,0:02:29.88,Default,,0000,0000,0000,,{\i1}...tiếng nói chung về Dự luật Tái đàm phán Hiệp ước An ninh{\i0}\N{\i1}do phía Nhật Bản đề xuất.{\i0}
Dialogue: 0,0:02:30.29,0:02:33.12,Default,,0000,0000,0000,,{\i1}Tuy nhiên, nếu chính phủ Nhật Bản{\i0}\N{\i1}nhìn lại tình hình bên trong biên giới của mình,{\i0}
Dialogue: 0,0:02:33.19,0:02:36.09,Default,,0000,0000,0000,,{\i1}họ sẽ thấy vô số vấn đề cần giải quyết,{\i0}\N{\i1}chẳng hạn như sự bất ổn kinh tế,{\i0}
Dialogue: 0,0:02:36.16,0:02:38.89,Default,,0000,0000,0000,,{\i1}sự trì trệ trong chính sách người tị nạn,{\i0}\N{\i1}và vấn đề Điều 9 Hiến pháp.{\i0}
Dialogue: 0,0:02:39.23,0:02:43.93,Default,,0000,0000,0000,,{\i1}Làn sóng biểu tình và tuần hành leo thang trên mọi mặt trận{\i0}\N{\i1}dường như là điều không thể tránh khỏi.{\i0}
Dialogue: 0,0:02:45.00,0:02:47.40,Default,,0000,0000,0000,,Tắt cái thứ nhảm nhí đó đi,\Nbọn mình đang trong giờ giải lao mà!
Dialogue: 0,0:02:47.64,0:02:50.27,Default,,0000,0000,0000,,Đừng có trút giận lên hai đứa nó\Nchỉ vì anh đang thua bài chứ.
Dialogue: 0,0:02:50.61,0:02:52.60,Default,,0000,0000,0000,,Cậu thì khá khẩm hơn ai\Nmà nói.
Dialogue: 0,0:02:56.91,0:02:58.74,Default,,0000,0000,0000,,Được rồi, lần này tôi sẽ\Nlột sạch túi các người!
Dialogue: 0,0:03:10.03,0:03:11.55,Default,,0000,0000,0000,,Chưa chắc\Nđâu nhé.
Dialogue: 0,0:03:21.37,0:03:26.07,Default,,0000,0000,0000,,Nói em nghe coi, sao thời buổi này ta vẫn phải bận tâm\Nvề cam kết an ninh chung làm gì nhỉ?
Dialogue: 0,0:03:26.28,0:03:28.61,Default,,0000,0000,0000,,Nhật Bản cũng có quân đội riêng\Nrồi mà, đúng không?
Dialogue: 0,0:03:28.91,0:03:31.64,Default,,0000,0000,0000,,Chính quyền hiện tại\Nthuộc phái cực kỳ hiếu chiến,
Dialogue: 0,0:03:31.75,0:03:34.34,Default,,0000,0000,0000,,nhưng vì kinh tế của Đế quốc Mỹ\Nđang cắm đầu xuống hố,
Dialogue: 0,0:03:34.65,0:03:38.85,Default,,0000,0000,0000,,họ muốn đàm phán một Hiệp ước An ninh mới\Nkhi chúng ta đang nắm đằng chuôi.
Dialogue: 0,0:03:39.26,0:03:41.95,Default,,0000,0000,0000,,Chắc họ muốn rửa mối nhục\Nmà họ phải nếm trải hồi thế kỷ 20.
Dialogue: 0,0:03:42.39,0:03:44.36,Default,,0000,0000,0000,,Mối nhục thế kỷ 20\Nlà gì thế ạ?
Dialogue: 0,0:03:44.56,0:03:48.40,Default,,0000,0000,0000,,Ờ thì, nói đơn giản là ký ức bại trận.
Dialogue: 0,0:03:48.77,0:03:53.60,Default,,0000,0000,0000,,Và vì lá bài tẩy Điều 9 của Hiến pháp\Nvẫn còn hiệu lực,
Dialogue: 0,0:03:53.97,0:03:56.70,Default,,0000,0000,0000,,nên Quân đội Phòng vệ không thể chính thức\Ntác chiến ngoài lãnh thổ.
Dialogue: 0,0:03:56.77,0:03:58.87,Default,,0000,0000,0000,,Chúng ta cũng không được phép\Nsở hữu vũ khí hạt nhân nữa.
Dialogue: 0,0:03:59.48,0:04:03.04,Default,,0000,0000,0000,,Và dù Hiệp ước An ninh thế kỷ 20 được ký kết\Nbằng việc đánh đổi lòng tự trọng,
Dialogue: 0,0:04:03.11,0:04:05.67,Default,,0000,0000,0000,,nhưng hai bên vẫn phối hợp khá ăn ý\Nnhư một bộ đôi ngầm không thể tách rời,
Dialogue: 0,0:04:05.75,0:04:08.48,Default,,0000,0000,0000,,với Mỹ là mũi giáo,\Ncòn Nhật Bản là tấm khiên.
Dialogue: 0,0:04:09.09,0:04:13.39,Default,,0000,0000,0000,,Thế nhưng giờ đây khi kẻ thù mới\Nlại là các vấn đề kinh tế,
Dialogue: 0,0:04:13.66,0:04:18.46,Default,,0000,0000,0000,,thì hiệp định mới này chẳng qua là để bảo vệ\Nnhững tử huyệt của nhau mà thôi.
Dialogue: 0,0:04:18.93,0:04:23.52,Default,,0000,0000,0000,,Oa, cậu biết nhiều ghê!\NĐồng bộ hóa mớ dữ liệu đó cho tớ với nhé?
Dialogue: 0,0:04:23.87,0:04:25.36,Default,,0000,0000,0000,,Được chứ, nếu cậu muốn.
Dialogue: 0,0:04:25.87,0:04:27.63,Default,,0000,0000,0000,,Hai đứa có chịu\Ntrật tự không?!
Dialogue: 0,0:04:27.77,0:04:30.47,Default,,0000,0000,0000,,Anh ấy nói phải đấy! Đây là cuộc chiến sinh tử đấy nhé.
Dialogue: 0,0:04:30.54,0:04:31.67,Default,,0000,0000,0000,,Ngậm miệng lại\Nmột lát đi.
Dialogue: 0,0:04:31.74,0:04:36.37,Default,,0000,0000,0000,,Trời đất, cả cậu nữa à Azuma! Là ma mới mà cậu hơi bị\Nhống hách rồi đấy, không thấy thế sao?
Dialogue: 0,0:04:37.31,0:04:40.28,Default,,0000,0000,0000,,Đừng có đổ lỗi cho người khác\Nchỉ vì anh đang thua bài.
Dialogue: 0,0:04:41.42,0:04:43.85,Default,,0000,0000,0000,,Để xem cậu còn cười được không\Nkhi tôi lật ngược tình thế nhé.
Dialogue: 0,0:04:44.55,0:04:45.54,Default,,0000,0000,0000,,Tôi tố thêm.
Dialogue: 0,0:04:50.46,0:04:51.52,Default,,0000,0000,0000,,Theo và tố tiếp.
Dialogue: 0,0:04:51.90,0:04:53.73,Default,,0000,0000,0000,,Giờ mới ra dáng\Nmột ván poker thực thụ chứ.
Dialogue: 0,0:04:57.90,0:05:02.77,Default,,0000,0000,0000,,Môn \"poker\" này cốt lõi là về xác suất,\Nvậy sao chú Saito lại luôn luôn thắng thế nhỉ?
Dialogue: 0,0:05:03.74,0:05:06.54,Default,,0000,0000,0000,,Tớ cũng thắc mắc\Nchuyện đó mãi.
Dialogue: 0,0:05:07.34,0:05:09.14,Default,,0000,0000,0000,,Đặc biệt là với luật chơi\Nmà họ đang áp dụng hiện tại,
Dialogue: 0,0:05:09.21,0:05:11.27,Default,,0000,0000,0000,,khi mà tất cả đều ghi nhớ\Nlá bài của những người khác.
Dialogue: 0,0:05:11.41,0:05:15.15,Default,,0000,0000,0000,,Đáng lẽ phải đoán được tay bài của đối phương\Ndựa trên lá đầu và lá cuối chứ.
Dialogue: 0,0:05:15.45,0:05:18.58,Default,,0000,0000,0000,,Chú Saito không thể nào\Nván nào cũng thắng được,
Dialogue: 0,0:05:18.79,0:05:21.76,Default,,0000,0000,0000,,thế mà chẳng hiểu sao cuối cùng\Ntoàn bộ chip đều chui vào túi chú ấy.
Dialogue: 0,0:05:22.46,0:05:24.15,Default,,0000,0000,0000,,Hắn giỏi trò lừa phỉnh thôi,\Nchẳng có gì đâu.
Dialogue: 0,0:05:24.56,0:05:26.76,Default,,0000,0000,0000,,Tôi sẽ sớm lột trần bộ mặt giả tạo\Ncủa anh thôi.
Dialogue: 0,0:05:27.26,0:05:31.63,Default,,0000,0000,0000,,Cậu ta nói đúng đấy. Đó gọi là \"khuôn mặt poker\".\NHọc hỏi đi.
Dialogue: 0,0:05:32.47,0:05:34.23,Default,,0000,0000,0000,,Cậu chưa đủ\Ntrình đâu.
Dialogue: 0,0:05:34.64,0:05:40.47,Default,,0000,0000,0000,,So với những canh bạc sinh tử mà tôi từng trải qua,\Nthì poker chỉ là trò con nít.
Dialogue: 0,0:05:40.78,0:05:42.57,Default,,0000,0000,0000,,Gớm, anh thì biết\Ncái quái gì chứ?
Dialogue: 0,0:05:42.65,0:05:45.88,Default,,0000,0000,0000,,Tôi công nhận anh là\Nmột tay bắn tỉa cự phách.
Dialogue: 0,0:05:45.95,0:05:49.18,Default,,0000,0000,0000,,Nhưng đánh đồng chuyện đó với poker ư?\NTôi không tin đâu.
Dialogue: 0,0:05:50.52,0:05:54.58,Default,,0000,0000,0000,,Từng có một lần, tôi bước vào\Nmột cuộc đấu tỉa tay đôi...
Dialogue: 0,0:05:54.99,0:05:58.22,Default,,0000,0000,0000,,...với một kẻ đã khiến tôi sợ hãi\Nđến tận xương tủy.
Dialogue: 0,0:05:59.00,0:06:02.80,Default,,0000,0000,0000,,Tôi chưa từng thấy một cuộc đấu trí nào\Nđáng sợ như khi đối đầu với người đó.
Dialogue: 0,0:06:06.90,0:06:13.90,Default,,0000,0000,0000,,Sau trận đấu ấy, tôi chỉ cần liếc mắt một cái\Nlà đoán được hầu hết người ta đang nghĩ gì.
Dialogue: 0,0:06:14.61,0:06:16.74,Default,,0000,0000,0000,,Xạo ke\Nvừa thôi.
Dialogue: 0,0:06:17.15,0:06:19.58,Default,,0000,0000,0000,,Thế kể nghe xem,\Nngười đó thế nào?
Dialogue: 0,0:06:20.35,0:06:21.41,Default,,0000,0000,0000,,Muốn nghe chuyện thật không?
Dialogue: 0,0:06:21.52,0:06:23.42,Default,,0000,0000,0000,,Kể đi chú ơi!\NKể chuyện đi chú!
Dialogue: 0,0:06:28.26,0:06:31.13,Default,,0000,0000,0000,,Nếu các cậu theo khoản tiền tôi vừa tố,\Ntôi sẽ kể cho nghe.
Dialogue: 0,0:06:35.70,0:06:38.76,Default,,0000,0000,0000,,Tôi chẳng thèm nghe mấy câu chuyện\Nbốc phét của anh đâu nhé.
Dialogue: 0,0:06:39.67,0:06:41.10,Default,,0000,0000,0000,,Đừng có\Nhiểu lầm.
Dialogue: 0,0:06:45.48,0:06:47.67,Default,,0000,0000,0000,,Đó là vào mùa hè\Nnăm 2020.
Dialogue: 0,0:06:48.01,0:06:51.24,Default,,0000,0000,0000,,Đại lục Á-Âu đang sa lầy vào\Nmột cuộc chiến tiêu hao vô nghĩa,
Dialogue: 0,0:06:51.48,0:06:55.85,Default,,0000,0000,0000,,và tôi đã phát ốm với cái chính sách bế quan tỏa cảng\Nđầy thù hằn mà Nhật Bản lúc bấy giờ đang hưởng thụ,
Dialogue: 0,0:06:55.92,0:06:58.89,Default,,0000,0000,0000,,khi ngồi rung đùi giữa\Ncán cân chính trị mong manh.
Dialogue: 0,0:06:59.19,0:07:02.42,Default,,0000,0000,0000,,Thế nên tôi đã đầu quân làm lính đánh thuê\Ncho \"Crimson Bianco\",
Dialogue: 0,0:07:02.49,0:07:06.62,Default,,0000,0000,0000,,một lực lượng quân tình nguyện ủng hộ\Nchính phủ lâm thời Mexico.
Dialogue: 0,0:07:07.33,0:07:12.29,Default,,0000,0000,0000,,Và hồi đó, con mắt trái của tôi\Nvẫn còn nguyên vẹn, chưa hề hấn gì.
Dialogue: 0,0:07:21.68,0:07:24.17,Default,,0000,0000,0000,,Dầu mỏ Trung Đông\Nvà ma túy Trung Mỹ.
Dialogue: 0,0:07:24.38,0:07:27.87,Default,,0000,0000,0000,,Ở đâu có lợi nhuận kếch xù,\Nở đó có xung đột đẫm máu.
Dialogue: 0,0:07:28.69,0:07:32.88,Default,,0000,0000,0000,,Đế quốc Mỹ, vốn bị chia rẽ và kiệt quệ\Nsau cuộc chiến tranh hạt nhân toàn cầu,
Dialogue: 0,0:07:32.96,0:07:37.42,Default,,0000,0000,0000,,bắt đầu nghiêm túc tính đến chuyện xóa sổ\Ncác thị trường ma túy ở Tân Thế giới...
Dialogue: 0,0:07:37.49,0:07:40.76,Default,,0000,0000,0000,,...nhằm ngăn chặn sự thất thoát\Nngân sách quốc gia.
Dialogue: 0,0:07:42.10,0:07:44.97,Default,,0000,0000,0000,,Lấy cớ lật đổ chính phủ tham nhũng của Mexico,
Dialogue: 0,0:07:45.03,0:07:47.73,Default,,0000,0000,0000,,Đế quốc Mỹ giật dây Liên Hợp Quốc cử lực lượng...
Dialogue: 0,0:07:47.80,0:07:50.77,Default,,0000,0000,0000,,...bao gồm quân đội Anh và Nhật Bản\Ntiến vào Nam Mỹ.
Dialogue: 0,0:07:51.14,0:07:53.94,Default,,0000,0000,0000,,Họ mở màn bằng những trận ném bom rải thảm\Nkhông ngơi nghỉ,
Dialogue: 0,0:07:54.01,0:07:56.04,Default,,0000,0000,0000,,lấy lý do \"nhanh chóng đánh chiếm thủ đô\".
Dialogue: 0,0:07:56.25,0:08:00.38,Default,,0000,0000,0000,,Sau đó, họ dùng đến các biện pháp mạnh tay\Nnhư điều các sư đoàn cơ giới hóa...
Dialogue: 0,0:08:00.45,0:08:02.94,Default,,0000,0000,0000,,...tiến vào Monterrey để càn quét\Nmọi sự kháng cự có vũ trang.
Dialogue: 0,0:08:03.85,0:08:08.35,Default,,0000,0000,0000,,Khi tiểu đội của tôi bị các đơn vị thiết giáp Liên Hợp Quốc\Nxóa sổ sau đợt ném bom,
Dialogue: 0,0:08:08.49,0:08:11.62,Default,,0000,0000,0000,,tôi đã nán lại, chờ đợi cơ hội\Nđể ra đầu hàng.
Dialogue: 0,0:08:12.10,0:08:13.65,Default,,0000,0000,0000,,Đúng lúc đó, chuyện xảy ra.
Dialogue: 0,0:08:15.10,0:08:17.46,Default,,0000,0000,0000,,Thiết bị đầu cuối tôi dùng để dò sóng liên lạc của địch...
Dialogue: 0,0:08:17.53,0:08:20.90,Default,,0000,0000,0000,,...báo rằng đã bắt được tín hiệu của một đơn vị đặc nhiệm\Nđang áp tải một đầu đạn hạt nhân chiến thuật.
Dialogue: 0,0:08:23.54,0:08:26.27,Default,,0000,0000,0000,,Trước đó tôi chưa hạ được nhiều mục tiêu cho lắm,
Dialogue: 0,0:08:26.64,0:08:31.38,Default,,0000,0000,0000,,nên tôi nghĩ mình sẽ kiếm cho xứng đồng tiền bát gạo\Nđể đổi lấy chút cảm giác mạnh.
Dialogue: 0,0:08:32.58,0:08:36.25,Default,,0000,0000,0000,,Lũ khốn đó dám mang cả một quả bom hạt nhân chiến thuật tới,
Dialogue: 0,0:08:36.45,0:08:41.45,Default,,0000,0000,0000,,nên tôi quyết tâm gieo rắc nỗi kinh hoàng của Chúa\Nxuống đầu chúng từ trên cao.
Dialogue: 0,0:09:04.78,0:09:05.55,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:09:05.55,0:09:07.24,Default,,0000,0000,0000,,Quên đi.\NKhông có gì đâu.
Dialogue: 0,0:09:17.73,0:09:19.25,Default,,0000,0000,0000,,Chắc là chúng rồi.
Dialogue: 0,0:09:20.83,0:09:25.23,Default,,0000,0000,0000,,Chúng quá sợ bị chỉ trích vì tấn công\Ncác cơ sở y tế và nhà thờ.
Dialogue: 0,0:09:25.90,0:09:28.60,Default,,0000,0000,0000,,Họ đã để lại quá nhiều nơi\Ncho quân du kích ẩn náu.
Dialogue: 0,0:09:28.94,0:09:29.93,Default,,0000,0000,0000,,Cũng đúng thật.
Dialogue: 0,0:09:30.01,0:09:33.57,Default,,0000,0000,0000,,Nhưng chúng ta có hai trung đội\Nđang càn quét những kẻ ngoan cố còn sót lại.
Dialogue: 0,0:09:33.94,0:09:38.04,Default,,0000,0000,0000,,Mong là vậy. Mấy gã Mỹ các cậu\Nvề cơ bản làm ăn rất cẩu thả.
Dialogue: 0,0:09:38.48,0:09:43.25,Default,,0000,0000,0000,,Còn tôi thì thấy mấy gã Ăng-lê các anh quá sùng bái\Ncái lực lượng SAS huyền thoại của mình rồi đấy.
Dialogue: 0,0:09:44.45,0:09:46.25,Default,,0000,0000,0000,,Thằng chả nghĩ mình\Nlà John Rambo chắc...
Dialogue: 0,0:09:51.39,0:09:52.88,Default,,0000,0000,0000,,Mồi nhử bắt đầu...
Dialogue: 0,0:10:03.14,0:10:04.13,Default,,0000,0000,0000,,Ba...
Dialogue: 0,0:10:05.01,0:10:06.00,Default,,0000,0000,0000,,Bốn...
Dialogue: 0,0:10:06.91,0:10:07.71,Default,,0000,0000,0000,,Năm.
Dialogue: 0,0:10:15.42,0:10:16.85,Default,,0000,0000,0000,,Bắn tỉa! Tìm chỗ nấp mau!
Dialogue: 0,0:10:19.26,0:10:21.72,Default,,0000,0000,0000,,Ishikawa, giả định tên bắn tỉa\Nđang dùng đường truyền vệ tinh.
Dialogue: 0,0:10:22.06,0:10:24.22,Default,,0000,0000,0000,,Hack vào vệ tinh và định vị\Nvị trí của hắn ngay.
Dialogue: 0,0:10:24.29,0:10:25.23,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:10:26.13,0:10:28.53,Default,,0000,0000,0000,,Sao lại là tao?\NĐồ chó chết...
Dialogue: 0,0:10:28.87,0:10:30.73,Default,,0000,0000,0000,,Hạ sĩ Mother!\NNằm im đó!
Dialogue: 0,0:10:31.13,0:10:32.60,Default,,0000,0000,0000,,Hắn không dùng\Nvệ tinh.
Dialogue: 0,0:10:32.80,0:10:35.46,Default,,0000,0000,0000,,Có một thiết bị gây nhiễu diện rộng đang hoạt động\Ntrong bán kính 1 km.
Dialogue: 0,0:10:35.57,0:10:38.80,Default,,0000,0000,0000,,Anh có thể dựa vào nguồn tín hiệu gây nhiễu\Nđể xác định vị trí của hắn không?
Dialogue: 0,0:10:38.98,0:10:40.03,Default,,0000,0000,0000,,Đang tiến hành rồi.
Dialogue: 0,0:10:40.28,0:10:43.44,Default,,0000,0000,0000,,Khỉ thật, hai người thạo nghề ghê.\NLàm việc này lâu rồi à?
Dialogue: 0,0:10:43.81,0:10:46.30,Default,,0000,0000,0000,,Nếu có thời gian buôn chuyện,\Nthì đi trinh sát đi!
Dialogue: 0,0:10:46.38,0:10:47.71,Default,,0000,0000,0000,,Đồ tân binh ngốc nghếch!
Dialogue: 0,0:10:48.28,0:10:50.91,Default,,0000,0000,0000,,Phát đạn bắn tới từ hướng nào?\NĐã xác định được chưa?!
Dialogue: 0,0:10:51.82,0:10:54.55,Default,,0000,0000,0000,,Tên bắn tỉa sẽ nghe lén đấy!\NChuyển sang liên lạc điện tử mau!
Dialogue: 0,0:10:55.02,0:10:58.12,Default,,0000,0000,0000,,Cứ thử đi, anh bạn gan dạ.\NTiếng rè nhiễu sẽ cho anh một bất ngờ khó chịu đấy.
Dialogue: 0,0:10:58.19,0:10:59.20,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:10:59.20,0:11:02.36,Default,,0000,0000,0000,,Xin lỗi, sơ suất quá. Bọn tôi hoàn toàn\Nkhông định vị được vị trí của địch.
Dialogue: 0,0:11:03.53,0:11:05.13,Default,,0000,0000,0000,,Chúng ta phải cứu cậu ấy ngay,\Nnếu không...
Dialogue: 0,0:11:05.27,0:11:06.79,Default,,0000,0000,0000,,Này Trung sĩ!\NKế hoạch thế nào đây?
Dialogue: 0,0:11:10.51,0:11:12.91,Default,,0000,0000,0000,,Ginger!\NTất cả sẽ yểm trợ cho cậu!
Dialogue: 0,0:11:12.98,0:11:16.78,Default,,0000,0000,0000,,Đi cứu Mother mau!\NSnow, cậu hỗ trợ Ginger!
Dialogue: 0,0:11:17.71,0:11:19.24,Default,,0000,0000,0000,,Thằng phân biệt chủng tộc...
Dialogue: 0,0:11:19.58,0:11:20.88,Default,,0000,0000,0000,,Này, mấy gã Nhật kia!
Dialogue: 0,0:11:20.95,0:11:24.78,Default,,0000,0000,0000,,Các người nhắm vào các tòa nhà phía tây!\NSố còn lại, tấn công các tòa nhà phía đông!
Dialogue: 0,0:11:24.99,0:11:25.95,Default,,0000,0000,0000,,Hành động thôi!
Dialogue: 0,0:11:31.83,0:11:33.63,Default,,0000,0000,0000,,Cậu sẽ ổn thôi.\NBọn tôi cứu cậu đây.
Dialogue: 0,0:11:33.93,0:11:34.86,Default,,0000,0000,0000,,Tóm được cậu ấy chưa?
Dialogue: 0,0:11:35.13,0:11:36.06,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:11:41.30,0:11:43.33,Default,,0000,0000,0000,,Mẹ kiếp! Là các tòa nhà\Nphía tây!
Dialogue: 0,0:11:50.68,0:11:54.78,Default,,0000,0000,0000,,{\i1}Tốt hơn là nên để các người thắc mắc{\i0}\N{\i1}về vị trí của tao thêm một chút nữa.{\i0}
Dialogue: 0,0:11:59.76,0:12:01.45,Default,,0000,0000,0000,,Nào, xem các người toát mồ hôi hột ra sao.
Dialogue: 0,0:12:09.57,0:12:10.73,Default,,0000,0000,0000,,Đạn 20 ly sao?!
Dialogue: 0,0:12:13.20,0:12:16.07,Default,,0000,0000,0000,,Khoan đã! Dừng bắn lại!\NNgừng bắn ngay!
Dialogue: 0,0:12:17.94,0:12:19.53,Default,,0000,0000,0000,,Ginger bị bắn\Ntừ hướng nào?
Dialogue: 0,0:12:19.81,0:12:20.78,Default,,0000,0000,0000,,Từ phía tây.
Dialogue: 0,0:12:20.84,0:12:24.40,Default,,0000,0000,0000,,Cô nói cái quái gì thế? Không thấy chiếc xe\Nvừa bị bắn nát bét lúc nãy à?!
Dialogue: 0,0:12:24.75,0:12:28.15,Default,,0000,0000,0000,,Địch ở phía đông! Không, rất có thể\Nchúng ta đã bị bao vây rồi!
Dialogue: 0,0:12:28.55,0:12:30.61,Default,,0000,0000,0000,,Ishikawa, tín hiệu gây nhiễu\Nphát ra từ đâu?
Dialogue: 0,0:12:30.75,0:12:32.35,Default,,0000,0000,0000,,Đoán sơ bộ thì có ba vị trí khả nghi.
Dialogue: 0,0:12:32.62,0:12:36.72,Default,,0000,0000,0000,,Một là tòa nhà phía đông, hai chỗ còn lại\Ncó lẽ là nhà thờ và bệnh viện đằng kia.
Dialogue: 0,0:12:37.29,0:12:39.02,Default,,0000,0000,0000,,Anh nghĩ tòa nhà phía đông\Nlà mồi nhử sao?
Dialogue: 0,0:12:39.10,0:12:40.15,Default,,0000,0000,0000,,Ừ, nhiều khả năng là thế.
Dialogue: 0,0:12:40.46,0:12:43.73,Default,,0000,0000,0000,,Ngay trước phát đạn 20 ly, tín hiệu gây nhiễu\Nđã bị ngắt trong tích tắc.
Dialogue: 0,0:12:43.97,0:12:46.46,Default,,0000,0000,0000,,Vả lại, nguyên tắc tác chiến căn bản\Nlà phải giữ mặt trời ở sau lưng.
Dialogue: 0,0:12:46.90,0:12:49.63,Default,,0000,0000,0000,,Trung sĩ! Vị trí phía đông chỉ là mồi nhử,\Nnhiều khả năng không có người.
Dialogue: 0,0:12:50.57,0:12:52.56,Default,,0000,0000,0000,,Nếu bị bao vây, chúng ta đã phải hứng chịu\Nlượng hỏa lực dữ dội hơn thế này nhiều!
Dialogue: 0,0:12:52.84,0:12:55.47,Default,,0000,0000,0000,,Rất có thể chúng ta chỉ đang đối đầu\Nvới duy nhất một tay bắn tỉa!
Dialogue: 0,0:12:55.71,0:12:57.24,Default,,0000,0000,0000,,Làm quái nào mà cô dám chắc chắn\Nnhư thế hả?!
Dialogue: 0,0:12:57.71,0:12:59.65,Default,,0000,0000,0000,,Tình hình chiến trường\Ncho tôi biết điều đó!
Dialogue: 0,0:13:00.02,0:13:04.48,Default,,0000,0000,0000,,Tôi có một đề xuất! Tôi sẽ đi vòng qua các tòa nhà\Nphía đông để tiếp cận chỗ các anh.
Dialogue: 0,0:13:05.12,0:13:07.42,Default,,0000,0000,0000,,Nếu đúng là không có người,\Ntôi sẽ phát tín hiệu.
Dialogue: 0,0:13:07.59,0:13:10.86,Default,,0000,0000,0000,,Khi đó, hãy bảo tất cả xả súng tổng lực\Nvào nhà thờ và bệnh viện.
Dialogue: 0,0:13:11.29,0:13:13.59,Default,,0000,0000,0000,,Tận dụng hỏa lực đó để giải cứu hạ sĩ\Nvà thu hồi đầu đạn hạt nhân chiến thuật.
Dialogue: 0,0:13:14.73,0:13:17.16,Default,,0000,0000,0000,,Không có nó,\Nchúng ta sẽ chết dẫm ở đây.
Dialogue: 0,0:13:17.90,0:13:19.96,Default,,0000,0000,0000,,Được rồi, đưa Snow\Nđi cùng cô!
Dialogue: 0,0:13:23.21,0:13:25.04,Default,,0000,0000,0000,,Đi đường vòng\Nđể tập hợp lại sao?
Dialogue: 0,0:13:25.21,0:13:27.80,Default,,0000,0000,0000,,Chắc chúng sẽ sớm nhận ra tòa nhà phía đông\Nchẳng có ma nào.
Dialogue: 0,0:13:28.24,0:13:31.27,Default,,0000,0000,0000,,Trước lúc đó, chắc tao phải tỉa thêm\Nmột đứa nữa cho vui.
Dialogue: 0,0:13:35.18,0:13:36.58,Default,,0000,0000,0000,,Đúng như tôi nghĩ.
Dialogue: 0,0:13:53.67,0:13:55.40,Default,,0000,0000,0000,,Nằm im đó,\NMother!
Dialogue: 0,0:13:58.14,0:13:59.73,Default,,0000,0000,0000,,Không có một bóng người,\Nđúng như tôi nghĩ.
Dialogue: 0,0:14:01.11,0:14:03.37,Default,,0000,0000,0000,,Hắn khôn ngoan chỉ nạp đúng một viên.
Dialogue: 0,0:14:03.58,0:14:04.85,Default,,0000,0000,0000,,Tên này thực sự rất cừ.
Dialogue: 0,0:14:04.85,0:14:07.94,Default,,0000,0000,0000,,Nhưng chúng ta có lẽ chỉ đấu với một người thôi.\NPhải lấy số đông để ghìm chặt hắn.
Dialogue: 0,0:14:08.15,0:14:11.18,Default,,0000,0000,0000,,Được rồi, tên bắn tỉa đang ở trong nhà thờ.\NChúng ta sẽ san phẳng cả cái chỗ chết tiệt đó.
Dialogue: 0,0:14:11.52,0:14:13.15,Default,,0000,0000,0000,,Không, có thể là\Nbệnh viện.
Dialogue: 0,0:14:13.82,0:14:15.65,Default,,0000,0000,0000,,Tín hiệu gây nhiễu vừa ngắt\Ntrong một giây,
Dialogue: 0,0:14:15.76,0:14:20.22,Default,,0000,0000,0000,,nên dù loại trừ đống đổ nát không có máy phát,\Nta vẫn không thể bỏ qua bệnh viện.
Dialogue: 0,0:14:20.73,0:14:24.83,Default,,0000,0000,0000,,Cô có biết từ đây tới đó cách bao nhiêu mét không?!\NChắc chắn là nhà thờ!
Dialogue: 0,0:14:25.07,0:14:31.20,Default,,0000,0000,0000,,Sao anh dám chắc thế? Tên này vừa bắn tỉa vừa đảm bảo\Nta không thể dùng GPS.
Dialogue: 0,0:14:31.71,0:14:35.54,Default,,0000,0000,0000,,Nếu hắn là dân chuyên nghiệp biết cách bù trừ hiệu ứng Coriolis,\Ntất cả chúng ta sẽ bị hắn tỉa sạch!
Dialogue: 0,0:14:37.35,0:14:40.01,Default,,0000,0000,0000,,Phiền phức chết tiệt...\NAi quan tâm là chỗ nào chứ?
Dialogue: 0,0:14:40.08,0:14:44.95,Default,,0000,0000,0000,,Đừng nóng vội thế. Chìa khóa sống sót trên chiến trường\Nkhông phải là dũng cảm, mà là sự thận trọng.
Dialogue: 0,0:14:45.22,0:14:47.21,Default,,0000,0000,0000,,Nhìn Nữ vương Kong\Nđằng kia mà xem.
Dialogue: 0,0:14:47.69,0:14:50.82,Default,,0000,0000,0000,,Khi người ta nói về dân chuyên nghiệp thực thụ,\Nhọ đang nói về những người như cô ấy đấy.
Dialogue: 0,0:14:51.36,0:14:52.79,Default,,0000,0000,0000,,\"Nữ vương Kong\" ư?
Dialogue: 0,0:14:57.07,0:14:58.43,Default,,0000,0000,0000,,Một phụ nữ sao?
Dialogue: 0,0:15:03.11,0:15:03.87,Default,,0000,0000,0000,,Pickles!
Dialogue: 0,0:15:03.94,0:15:04.96,Default,,0000,0000,0000,,Trúng rồi!
Dialogue: 0,0:15:07.08,0:15:09.24,Default,,0000,0000,0000,,Tên bắn tỉa ở trong bệnh viện!\NIshikawa!
Dialogue: 0,0:15:10.98,0:15:12.61,Default,,0000,0000,0000,,Đồ súc sinh!
Dialogue: 0,0:15:22.73,0:15:26.59,Default,,0000,0000,0000,,Ít nhất ta đã lấy lại được khoang chứa.\NCòn viên hạ sĩ thì không kịp nữa rồi.
Dialogue: 0,0:15:30.87,0:15:35.03,Default,,0000,0000,0000,,Được rồi, tạm thời rút về căn cứ đã.\NKhông thể ở lại đây để bị xóa sổ hết được.
Dialogue: 0,0:15:35.47,0:15:38.00,Default,,0000,0000,0000,,Đừng có ngu ngốc thế!\NHắn đã giết Pickles!
Dialogue: 0,0:15:38.31,0:15:40.30,Default,,0000,0000,0000,,Chúng ta phải trả thù cho cậu ấy.\NTên đó phải chết!
Dialogue: 0,0:15:40.44,0:15:43.64,Default,,0000,0000,0000,,Đây là mệnh lệnh! Chúng ta sẽ rút về căn cứ\Nđể tái tổ chức lại đội hình!
Dialogue: 0,0:15:43.98,0:15:47.88,Default,,0000,0000,0000,,Các anh muốn về thì cứ về, nhưng đằng nào\Nta cũng phải hạ gục tên bắn tỉa đó.
Dialogue: 0,0:15:48.35,0:15:50.58,Default,,0000,0000,0000,,Chừng nào thiết bị liên lạc chưa hoạt động,\Nta không thể gọi chi viện được đâu.
Dialogue: 0,0:15:50.95,0:15:54.25,Default,,0000,0000,0000,,Cô ấy nói đúng đấy. Chúng ta vẫn có\Nưu thế về quân số mà.
Dialogue: 0,0:15:54.69,0:15:57.28,Default,,0000,0000,0000,,Tính sao đây hả?\NĐồng đội của các anh cũng bị giết rồi đấy!
Dialogue: 0,0:16:00.53,0:16:02.00,Default,,0000,0000,0000,,Được rồi. Chúng tôi sẽ làm\Ntheo cách của cô.
Dialogue: 0,0:16:08.44,0:16:11.84,Default,,0000,0000,0000,,Lạ thật... Lẽ ra chúng phải hoảng loạn mới đúng,\Nnhưng chúng lại đang chấn chỉnh lại đội hình.
Dialogue: 0,0:16:12.27,0:16:14.33,Default,,0000,0000,0000,,Có vẻ như chúng có một chỉ huy rất cừ.
Dialogue: 0,0:16:17.08,0:16:20.57,Default,,0000,0000,0000,,Tôi nhận ra cuộc quyết đấu cuối cùng\Nđang nhanh chóng ập đến.
Dialogue: 0,0:16:21.42,0:16:26.41,Default,,0000,0000,0000,,Căng thẳng dâng trào, và tôi cảm nhận được adrenaline\Nsục sôi đến từng tế bào.
Dialogue: 0,0:16:27.69,0:16:31.72,Default,,0000,0000,0000,,Khi người ta tàn sát lẫn nhau trên chiến trường,\Nanh chẳng thể biết ai giết ai.
Dialogue: 0,0:16:32.29,0:16:36.32,Default,,0000,0000,0000,,Nhưng có một ngoại lệ duy nhất cho quy luật đó.\NChính là lính bắn tỉa.
Dialogue: 0,0:16:38.90,0:16:43.07,Default,,0000,0000,0000,,Với những phát đạn bắn tỉa, bản thân hành động đó\Nđã gắn liền một tấm danh thiếp độc nhất.
Dialogue: 0,0:16:43.37,0:16:46.17,Default,,0000,0000,0000,,Đó là lý do lính bắn tỉa\Nkhông bao giờ được bắt làm tù binh.
Dialogue: 0,0:16:46.74,0:16:49.73,Default,,0000,0000,0000,,Số phận của họ là luôn bị\Nhành quyết ngay tại chỗ...
Dialogue: 0,0:16:50.08,0:16:52.48,Default,,0000,0000,0000,,...như kẻ đã tước đi mạng sống của đồng đội\Nhay chỉ huy của người khác.
Dialogue: 0,0:16:57.05,0:17:00.45,Default,,0000,0000,0000,,Sau khi nã súng không giật vào tòa nhà,\Nhãy phóng lựu đạn khói liên tục!
Dialogue: 0,0:17:00.79,0:17:02.66,Default,,0000,0000,0000,,Chúng ta sẽ dùng màn khói\Nđể yểm trợ bước tiến!
Dialogue: 0,0:17:03.19,0:17:04.12,Default,,0000,0000,0000,,Được rồi, chúng ta...
Dialogue: 0,0:17:04.73,0:17:05.63,Default,,0000,0000,0000,,Cái...?
Dialogue: 0,0:17:07.06,0:17:08.39,Default,,0000,0000,0000,,Thằng khốn kiếp!
Dialogue: 0,0:17:16.77,0:17:19.87,Default,,0000,0000,0000,,Được rồi, yểm trợ tôi!\NTôi và Snow sẽ xông vào tòa nhà!
Dialogue: 0,0:17:20.51,0:17:22.00,Default,,0000,0000,0000,,Tôi là cái gì chứ,\Nquân tiếp viện của cô à?
Dialogue: 0,0:17:22.55,0:17:25.34,Default,,0000,0000,0000,,Nhìn vào mặt tích cực đi.\NĐiều đó có nghĩa anh đã giành được sự tin tưởng của cô ấy.
Dialogue: 0,0:17:34.36,0:17:37.42,Default,,0000,0000,0000,,Thế là đủ rồi.\NHãy để Thiếu tá lo.
Dialogue: 0,0:17:37.76,0:17:39.19,Default,,0000,0000,0000,,Từ lúc này cô ấy\Nsẽ tự ứng biến.
Dialogue: 0,0:17:39.70,0:17:43.19,Default,,0000,0000,0000,,\"Thiếu tá\" ư? Cái danh xưng đó với trò\NNữ vương Kong vớ vẩn là sao thế?
Dialogue: 0,0:17:43.47,0:17:44.93,Default,,0000,0000,0000,,Rốt cuộc cô ta\Nlà ai vậy?
Dialogue: 0,0:17:45.07,0:17:49.03,Default,,0000,0000,0000,,Biết chết liền.\NTôi chỉ biết cô ấy là một bậc thầy chiến đấu.
Dialogue: 0,0:17:49.11,0:17:52.51,Default,,0000,0000,0000,,Và tất cả chúng tôi\Nđều gọi cô ấy là Thiếu tá.
Dialogue: 0,0:18:30.28,0:18:34.15,Default,,0000,0000,0000,,Trong khoảnh khắc chưa đầy một giây đối mặt\Nvới Thiếu tá,
Dialogue: 0,0:18:34.45,0:18:37.89,Default,,0000,0000,0000,,tôi đã hình dung ra kết cục của màn đấu súng,\Nvà lông tơ sau gáy tôi dựng đứng cả lên.
Dialogue: 0,0:18:38.42,0:18:41.22,Default,,0000,0000,0000,,Sau khi cân nhắc\Nmọi yếu tố,
Dialogue: 0,0:18:41.49,0:18:45.36,Default,,0000,0000,0000,,đây là kết luận mà kinh nghiệm bắn tỉa\Ncủa tôi đưa ra.
Dialogue: 0,0:18:45.86,0:18:47.42,Default,,0000,0000,0000,,Tôi chắc chắn\Nsẽ bị giết.
Dialogue: 0,0:18:47.80,0:18:52.39,Default,,0000,0000,0000,,Từ tư thế đứng và cách cô ấy kẹp khẩu súng trường ngang hông\Nmà mắt không hề chớp lấy một cái,
Dialogue: 0,0:18:52.87,0:18:56.33,Default,,0000,0000,0000,,tôi biết ngay cô ấy là một người máy toàn phần.
Dialogue: 0,0:18:56.91,0:19:00.54,Default,,0000,0000,0000,,Và khẩu súng trường đó là loại bán tự động\Ncó cảm ứng toàn phần.
Dialogue: 0,0:19:01.31,0:19:05.77,Default,,0000,0000,0000,,Đương nhiên, cô ấy cũng cài đặt đủ phần mềm kiểm soát hỏa lực\Ntầm xa, tầm trung và tầm gần.
Dialogue: 0,0:19:06.62,0:19:10.98,Default,,0000,0000,0000,,Thử hình dung xem điều gì sẽ xảy ra\Nnếu tôi nã một phát đạn vào Thiếu tá.
Dialogue: 0,0:19:21.90,0:19:25.33,Default,,0000,0000,0000,,Cô ấy sẽ bắn chặn phát đạn đầu tiên của tôi,\Ncòn tôi, với khẩu súng trường lên đạn từng viên,
Dialogue: 0,0:19:25.40,0:19:28.50,Default,,0000,0000,0000,,sẽ dính ngay phát đạn thứ hai của cô ấy\Ntrong lúc cố nép mình lại sau cây cột.
Dialogue: 0,0:19:29.14,0:19:32.27,Default,,0000,0000,0000,,Tôi đã mô phỏng đi mô phỏng lại điều đó,\Nvà đều cho ra cùng một kết quả.
Dialogue: 0,0:19:32.71,0:19:34.61,Default,,0000,0000,0000,,Nhưng nếu cứ ngồi yên ở đó\Nmà không làm gì, thì chú sẽ...
Dialogue: 0,0:19:34.88,0:19:37.87,Default,,0000,0000,0000,,Phải. Nếu tôi ở yên một chỗ,\Nsớm muộn gì cũng bị tiêu diệt.
Dialogue: 0,0:19:38.45,0:19:40.47,Default,,0000,0000,0000,,Tôi đã vắt óc suy nghĩ trong tuyệt vọng,\Ncố tìm ra cách nào đó...
Dialogue: 0,0:19:40.55,0:19:43.11,Default,,0000,0000,0000,,...để có thể lật ngược thế cờ\Ntrong tình thế ngặt nghèo như vậy.
Dialogue: 0,0:19:44.45,0:19:46.75,Default,,0000,0000,0000,,Và đúng lúc đó,\Nmột ý nghĩ lóe lên.
Dialogue: 0,0:19:47.06,0:19:50.69,Default,,0000,0000,0000,,Tôi để ý thấy thiết bị gây nhiễu,\Nthứ đầu tiên mà Thiếu tá đã bắn nát.
Dialogue: 0,0:19:51.09,0:19:55.00,Default,,0000,0000,0000,,Tại sao cô ấy lại dùng tới tận ba phát đạn\Nđể phá hủy nó?
Dialogue: 0,0:19:56.30,0:20:01.17,Default,,0000,0000,0000,,{\i1}Khoan đã... Chẳng lẽ cô ta không hề cài đặt{\i0}\N{\i1}phần mềm kiểm soát hỏa lực tầm trung sao?{\i0}
Dialogue: 0,0:20:01.47,0:20:03.06,Default,,0000,0000,0000,,{\i1}Phải rồi, đó là lời giải thích duy nhất...{\i0}
Dialogue: 0,0:20:03.27,0:20:07.68,Default,,0000,0000,0000,,{\i1}Cô ta biết vị trí của tay bắn tỉa, nhưng lại dùng{\i0}\N{\i1}khẩu súng trường cảm ứng như súng nòng ngắn.{\i0}
Dialogue: 0,0:20:08.18,0:20:10.54,Default,,0000,0000,0000,,{\i1}Đó là vì cô ta dựa trên tiền đề rằng{\i0}\N{\i1}có thể dùng nó...{\i0}
Dialogue: 0,0:20:10.61,0:20:13.01,Default,,0000,0000,0000,,{\i1}...để thay thế súng tiểu liên ở cự ly tầm trung.{\i0}
Dialogue: 0,0:20:13.45,0:20:17.89,Default,,0000,0000,0000,,{\i1}Nếu vậy, cô ta cần phần mềm điều khiển{\i0}\N{\i1}để đấu tỉa với mình ở khoảng cách này.{\i0}
Dialogue: 0,0:20:19.19,0:20:23.82,Default,,0000,0000,0000,,{\i1}Chắc chắn cô ta đang tải phần mềm điều khiển{\i0}\N{\i1}qua đường truyền vệ tinh!{\i0}
Dialogue: 0,0:20:25.29,0:20:26.28,Default,,0000,0000,0000,,Bắn trước đi!
Dialogue: 0,0:20:41.31,0:20:43.78,Default,,0000,0000,0000,,Bắn súng trường cừ đấy,\Nthằng khốn.
Dialogue: 0,0:20:44.28,0:20:46.11,Default,,0000,0000,0000,,Từ nay về sau, tao muốn mày\Nlàm việc cho tao!
Dialogue: 0,0:20:47.12,0:20:49.95,Default,,0000,0000,0000,,Phần mềm đó...\NHóa ra cô đã có sẵn nó từ đầu rồi!
Dialogue: 0,0:20:54.29,0:20:59.16,Default,,0000,0000,0000,,Đúng vậy. Khuôn mặt poker của Thiếu tá\Nđã lừa tôi ngay từ giây phút đầu tiên.
Dialogue: 0,0:20:59.73,0:21:03.86,Default,,0000,0000,0000,,Và tôi chẳng có quyền gì\Nđể từ chối cả.
Dialogue: 0,0:21:04.40,0:21:08.36,Default,,0000,0000,0000,,Bởi đó là mệnh lệnh đầu tiên\Nmà Thiếu tá từng ban cho tôi.
Dialogue: 0,0:21:15.08,0:21:16.60,Default,,0000,0000,0000,,Chia những lá bài cuối cùng đi.
Dialogue: 0,0:21:21.75,0:21:25.15,Default,,0000,0000,0000,,Câu chuyện hay đấy, nhưng chẳng liên quan quái gì\Nđến ván bài ở đây cả.
Dialogue: 0,0:21:25.39,0:21:27.36,Default,,0000,0000,0000,,Tôi tố thêm.\NTất tay.
Dialogue: 0,0:21:29.69,0:21:31.32,Default,,0000,0000,0000,,Vậy thì tôi cũng tất tay luôn.
Dialogue: 0,0:21:31.83,0:21:33.02,Default,,0000,0000,0000,,Đừng có cố\Ntỏ ra ngầu nữa.
Dialogue: 0,0:21:33.53,0:21:36.73,Default,,0000,0000,0000,,Đây là ván bài mà anh không thể\Ndùng trò bịp để thoát thân đâu.
Dialogue: 0,0:21:37.37,0:21:40.23,Default,,0000,0000,0000,,Anh đang cố tạo một sảnh chúa bích\Nphải không?
Dialogue: 0,0:21:41.40,0:21:43.13,Default,,0000,0000,0000,,Nhưng bài của anh chẳng có tích sự gì cả.
Dialogue: 0,0:21:45.24,0:21:48.77,Default,,0000,0000,0000,,Tôi biết điều đó vì {\i1}tôi{\i0}\Nmới là người đang cầm con Át bích.
Dialogue: 0,0:21:50.35,0:21:54.61,Default,,0000,0000,0000,,Anh không thể nào thắng được đâu.\NVà câu chuyện vừa rồi hoàn toàn là bốc phét đúng không?
Dialogue: 0,0:21:54.68,0:21:56.38,Default,,0000,0000,0000,,Dù nó cũng khá\Nthú vị đấy,
Dialogue: 0,0:21:56.45,0:21:59.82,Default,,0000,0000,0000,,nhưng tôi nhớ mang máng có một bộ phim cũ\Nvới cốt truyện giống y hệt như thế.
Dialogue: 0,0:22:01.62,0:22:04.92,Default,,0000,0000,0000,,Ừ, cậu nói đúng rồi.\NTôi tự bịa ra hết đấy.
Dialogue: 0,0:22:05.36,0:22:07.45,Default,,0000,0000,0000,,Thật á? Chú bịa ra thật sao?
Dialogue: 0,0:22:15.17,0:22:19.30,Default,,0000,0000,0000,,Hôm nay tôi tha cho các cậu đấy.\NAzuma, đổi chip ra tiền cho tôi.
Dialogue: 0,0:22:20.51,0:22:22.17,Default,,0000,0000,0000,,Cảm thấy hơi xấu hổ\Nrồi chứ gì?
Dialogue: 0,0:22:22.31,0:22:24.48,Default,,0000,0000,0000,,Này ma mới! Trả cho anh ta\Nnhững gì anh ta đáng được nhận đi!
Dialogue: 0,0:22:24.48,0:22:27.14,Default,,0000,0000,0000,,Trời ạ, đúng là đồ ích kỷ.\NTấm gương sáng gớm nhỉ...
Dialogue: 0,0:22:27.48,0:22:30.65,Default,,0000,0000,0000,,Không biết chú Saito có thật sự\Nkhông có gì trong tay không nhỉ...
Dialogue: 0,0:22:33.96,0:22:35.15,Default,,0000,0000,0000,,Mọi người nhìn kìa!\NNhìn xem! Nhìn xem!
Dialogue: 0,0:22:35.26,0:22:39.42,Default,,0000,0000,0000,,Lá bài cuối cùng của chú ấy là con 9 bích!\NChú ấy có thùng phá sảnh kìa!
Dialogue: 0,0:22:39.86,0:22:41.16,Default,,0000,0000,0000,,Hắn có cái {\i1}gì{\i0} cơ?!
Dialogue: 0,0:22:46.40,0:22:50.74,Default,,0000,0000,0000,,Vậy điều này có nghĩa là... có thể câu chuyện lúc nãy\Ncũng là sự thật sao?
Dialogue: 0,0:22:51.91,0:22:53.40,Default,,0000,0000,0000,,Biết đâu đấy...
Dialogue: 0,0:22:53.40,0:22:55.40,Default,,0000,0000,0000,,
Dialogue: 0,0:23:10.68,0:23:13.18,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:13.18,0:23:17.14,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:17.33,0:23:19.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:19.80,0:23:23.79,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:23.79,0:23:27.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:27.80,0:23:31.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:31.09,0:23:35.60,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:35.60,0:23:37.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:37.09,0:23:39.79,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:39.79,0:23:43.73,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:43.73,0:23:46.24,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:46.24,0:23:49.77,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:49.77,0:23:53.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:53.11,0:23:57.91,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:57.91,0:24:03.72,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:03.72,0:24:06.42,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:06.42,0:24:10.36,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:24:10.36,0:24:12.87,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:24:12.87,0:24:16.40,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:24:16.40,0:24:19.74,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:24:19.74,0:24:24.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:24:24.54,0:24:29.20,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,2000)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...

