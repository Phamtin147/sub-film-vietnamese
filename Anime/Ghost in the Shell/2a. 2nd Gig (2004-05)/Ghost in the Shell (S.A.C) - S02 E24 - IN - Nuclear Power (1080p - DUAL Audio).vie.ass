Dialogue: 0,0:01:57.31,0:02:00.10,Default,,0000,0000,0000,,{\i1}Người tị nạn lúc này{\i0}\N{\i1}đã hoàn toàn bị cô lập.{\i0}
Dialogue: 0,0:02:00.58,0:02:03.84,Default,,0000,0000,0000,,{\i1}Giờ chỉ còn là câu hỏi xem nỗi bất an của những kẻ{\i0}\N{\i1}không thể chịu nổi sự cô độc...{\i0}
Dialogue: 0,0:02:03.95,0:02:08.58,Default,,0000,0000,0000,,{\i1}...sẽ dẫn tới hồi kết mà ta đã mường tượng{\i0}\N{\i1}như thế nào mà thôi.{\i0}
Dialogue: 0,0:02:09.02,0:02:11.54,Default,,0000,0000,0000,,{\i1}Chúng ta chỉ việc ngồi lại{\i0}\N{\i1}và chứng kiến.{\i0}
Dialogue: 0,0:02:29.91,0:02:33.74,Default,,0000,0000,0000,,Họ sẽ không chịu ngồi yên nghe lệnh giữ hỏa lực\Nkhi bạn bè mình đang bị bắn đâu.
Dialogue: 0,0:02:34.04,0:02:38.84,Default,,0000,0000,0000,,Báo cáo từ Cục Tình báo Chiến lược nói rằng\Ntoàn bộ số vũ khí hạt nhân còn lại đều ở Dejima.
Dialogue: 0,0:02:39.25,0:02:41.55,Default,,0000,0000,0000,,Chúng ta nên dùng các đơn vị thiết giáp đột kích nơi đó...
Dialogue: 0,0:02:41.65,0:02:45.09,Default,,0000,0000,0000,,...và giải quyết dứt điểm trong một đòn\Nthay vì chờ đợi đoàn thanh sát đó!
Dialogue: 0,0:02:45.29,0:02:49.32,Default,,0000,0000,0000,,Có thể, nhưng chúng ta cũng có tin tình báo rằng\Nnếu đưa quân vào Dejima,
Dialogue: 0,0:02:49.46,0:02:52.55,Default,,0000,0000,0000,,họ có thể sẽ thực hiện\Ncác vụ tấn công tự sát bằng vũ khí hạt nhân.
Dialogue: 0,0:02:53.00,0:02:55.43,Default,,0000,0000,0000,,Chắc chắn chúng ta có thể trì hoãn\Nviệc đưa quân vào...
Dialogue: 0,0:02:55.53,0:02:58.26,Default,,0000,0000,0000,,...cho tới sau khi chúng ta đập tan\Ncông sự của đám tị nạn.
Dialogue: 0,0:02:58.74,0:03:02.76,Default,,0000,0000,0000,,Vậy thế này thì sao? Sao ta không thử\Nđiều trực thăng tấn công không người lái vào?
Dialogue: 0,0:03:18.55,0:03:19.82,Default,,0000,0000,0000,,Thưa Thủ tướng Kayabuki.
Dialogue: 0,0:03:19.96,0:03:24.48,Default,,0000,0000,0000,,Cách đây ít phút, bà đã bị bãi nhiệm\Nkhỏi chức vụ Thủ tướng.
Dialogue: 0,0:03:26.06,0:03:28.46,Default,,0000,0000,0000,,Chuyện này nghĩa là sao?\NDựa trên căn cứ nào?
Dialogue: 0,0:03:28.90,0:03:32.86,Default,,0000,0000,0000,,Việc tự ý yêu cầu đoàn thanh sát Liên Hợp Quốc\Ndưới thẩm quyền cá nhân...
Dialogue: 0,0:03:32.97,0:03:35.94,Default,,0000,0000,0000,,...có thể bị coi là hành vi phản quốc\Ntheo Hệ thống Luật Tình trạng Khẩn cấp Quốc gia.
Dialogue: 0,0:03:36.54,0:03:41.67,Default,,0000,0000,0000,,Do đó, bà sẽ bị tạm giữ\Ncho tới khi tình hình này được giải quyết.
Dialogue: 0,0:03:42.01,0:03:42.91,Default,,0000,0000,0000,,Trưởng phòng!
Dialogue: 0,0:03:43.18,0:03:45.08,Default,,0000,0000,0000,,Tôi yêu cầu được biết dựa trên\Nthẩm quyền của ai mà các người...
Dialogue: 0,0:03:45.62,0:03:47.11,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:03:47.65,0:03:53.71,Default,,0000,0000,0000,,Trưởng phòng Aramaki của Đội 9 An ninh Công cộng, ông\Ncũng nằm trong diện tình nghi xúi giục phản quốc.
Dialogue: 0,0:03:54.82,0:03:56.55,Default,,0000,0000,0000,,Xin vui lòng quay lại\Nvà bước vào trong văn phòng kia.
Dialogue: 0,0:03:56.66,0:03:58.42,Default,,0000,0000,0000,,Này, lũ các người nghĩ mình là cái thớ gì...
Dialogue: 0,0:04:10.34,0:04:14.28,Default,,0000,0000,0000,,Chúng tôi đã mất liên lạc với Trưởng phòng Aramaki\Nsuốt sáu tiếng đồng hồ qua rồi.
Dialogue: 0,0:04:14.68,0:04:16.84,Default,,0000,0000,0000,,Ông ấy vẫn ở bên dưới tư dinh Thủ tướng chứ?
Dialogue: 0,0:04:16.95,0:04:17.74,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:04:18.41,0:04:22.71,Default,,0000,0000,0000,,Tôi hiểu rồi. Nếu vậy, hãy chuyển lời nhắn này\Nkhi các cậu liên lạc lại được với ông ấy.
Dialogue: 0,0:04:23.29,0:04:26.65,Default,,0000,0000,0000,,Tôi nghĩ đây có lẽ chỉ là chiêu thao túng thông tin của CIS,
Dialogue: 0,0:04:26.79,0:04:30.75,Default,,0000,0000,0000,,nhưng có một tin đồn đang lan truyền rằng đám tị nạn\Ncó thể sẽ dùng vũ khí hạt nhân để đánh bom tự sát.
Dialogue: 0,0:04:31.29,0:04:33.35,Default,,0000,0000,0000,,Tôi thấy có mùi mờ ám,\Nnên hãy bảo ông ấy điều tra kỹ chuyện đó.
Dialogue: 0,0:04:33.46,0:04:34.83,Default,,0000,0000,0000,,Rõ rồi ạ.
Dialogue: 0,0:04:40.20,0:04:44.54,Default,,0000,0000,0000,,Vì là anh nên tôi nghĩ\Nanh đã phát hiện ra điều gì đó rồi...
Dialogue: 0,0:05:01.86,0:05:03.45,Default,,0000,0000,0000,,Y hệt như\Nlần trước...
Dialogue: 0,0:05:03.56,0:05:06.59,Default,,0000,0000,0000,,Chính phủ đã lên kế hoạch làm chuyện này\Nngay từ đầu rồi!
Dialogue: 0,0:05:07.00,0:05:10.52,Default,,0000,0000,0000,,Lũ khốn Quân Phòng vệ kia, tao thách chúng mày\Ndám bước một bước vào Dejima!
Dialogue: 0,0:05:11.13,0:05:14.10,Default,,0000,0000,0000,,Bỏ vũ khí xuống!\NHạ súng xuống ngay!
Dialogue: 0,0:05:14.64,0:05:15.50,Default,,0000,0000,0000,,Kuze...
Dialogue: 0,0:05:16.84,0:05:21.14,Default,,0000,0000,0000,,Đừng manh động! Nếu các bạn hạ vũ khí xuống,\Nhọ sẽ không nổ súng đâu!
Dialogue: 0,0:05:22.45,0:05:24.11,Default,,0000,0000,0000,,- Kuze?\N- Là anh ấy thật sao?
Dialogue: 0,0:05:24.48,0:05:26.64,Default,,0000,0000,0000,,Là anh ấy ư?\NLà Đồng chí Kuze sao?
Dialogue: 0,0:06:15.93,0:06:17.73,Default,,0000,0000,0000,,Chuyện này đã vượt ra ngoài\Ntầm kiểm soát rồi...
Dialogue: 0,0:06:18.13,0:06:21.66,Default,,0000,0000,0000,,Này! Hãy tìm cho tôi\Nvài người bắn súng giỏi!
Dialogue: 0,0:06:21.94,0:06:24.84,Default,,0000,0000,0000,,Tôi sẽ kết nối mọi người\Nvào não điện tử của tôi một lần nữa!
Dialogue: 0,0:06:25.24,0:06:26.40,Default,,0000,0000,0000,,Bọn tôi làm ngay!
Dialogue: 0,0:06:30.11,0:06:32.74,Default,,0000,0000,0000,,{\i1}Trời ạ, cảnh tượng y hệt như cuộc diễn tập chung{\i0}\N{\i1}mà họ từng tiến hành...{\i0}
Dialogue: 0,0:06:32.85,0:06:34.87,Default,,0000,0000,0000,,{\i1}...ở khu định cư tị nạn Niihama, đúng không?{\i0}
Dialogue: 0,0:06:36.02,0:06:39.85,Default,,0000,0000,0000,,Một khi tiến vào không phận Dejima, mã nhận diện bạn-thù\Ncủa quân đội có lẽ sẽ vô dụng.
Dialogue: 0,0:06:40.42,0:06:42.82,Default,,0000,0000,0000,,Đám Jigabachi đó sẽ nổ súng vô điều kiện...
Dialogue: 0,0:06:42.93,0:06:46.33,Default,,0000,0000,0000,,...vào bất kỳ cỗ máy nào có cấu hình\Nkhác với của chúng.
Dialogue: 0,0:06:46.53,0:06:49.43,Default,,0000,0000,0000,,Chúng ta không còn lựa chọn nào khác.\NBorma, tăng tốc lên!
Dialogue: 0,0:06:49.53,0:06:50.56,Default,,0000,0000,0000,,Rõ rồi!
Dialogue: 0,0:06:54.14,0:06:56.13,Default,,0000,0000,0000,,Được rồi Borma,\Nđổi lái cho tôi.
Dialogue: 0,0:07:07.62,0:07:09.31,Default,,0000,0000,0000,,Có vẻ như cuộc tấn công\Nđã bắt đầu.
Dialogue: 0,0:07:10.05,0:07:11.08,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:07:11.22,0:07:13.12,Default,,0000,0000,0000,,Nhưng trông có vẻ bọn mình sẽ không được\Ntham gia vào cuộc chiến đâu.
Dialogue: 0,0:07:13.56,0:07:16.72,Default,,0000,0000,0000,,Sẽ không có chiến dịch đổ bộ nào diễn ra\Ncho tới khi số vũ khí hạt nhân đó được thu hồi.
Dialogue: 0,0:07:18.03,0:07:19.15,Default,,0000,0000,0000,,Thế kia là cái gì?
Dialogue: 0,0:07:19.26,0:07:21.13,Default,,0000,0000,0000,,Cái đó chẳng liên quan gì\Nđến người của chúng ta.
Dialogue: 0,0:07:21.53,0:07:24.29,Default,,0000,0000,0000,,Tôi nghe nói Quân Phòng vệ Mặt đất đang bí mật\Nphái một đội đặc nhiệm...
Dialogue: 0,0:07:24.43,0:07:26.63,Default,,0000,0000,0000,,...vào Dejima để thu hồi\Ncác đầu đạn hạt nhân.
Dialogue: 0,0:07:36.18,0:07:39.58,Default,,0000,0000,0000,,{\i1}Thiếu tá, các người sắp tiến vào{\i0}\N{\i1}vùng bị gây nhiễu rồi!{\i0}
Dialogue: 0,0:07:40.05,0:07:42.42,Default,,0000,0000,0000,,{\i1}Hãy mở một kênh liên lạc dù tín hiệu{\i0}\N{\i1}có bị cắt đứt đi chăng nữa.{\i0}
Dialogue: 0,0:07:42.72,0:07:45.05,Default,,0000,0000,0000,,{\i1}Thêm nữa, hãy để mắt tới{\i0}\N{\i1}tình hình trên mặt nước.{\i0}
Dialogue: 0,0:07:45.32,0:07:46.41,Default,,0000,0000,0000,,{\i1}Rõ rồi ạ!{\i0}
Dialogue: 0,0:07:47.49,0:07:50.19,Default,,0000,0000,0000,,{\i1}Đám Jigabachi hiện đang lượn vòng{\i0}\N{\i1}theo các chu kỳ đều đặn.{\i0}
Dialogue: 0,0:07:50.63,0:07:52.99,Default,,0000,0000,0000,,{\i1}Tiếp cận ở tầm thấp và bay vòng...{\i0}
Dialogue: 0,0:07:53.10,0:07:55.29,Default,,0000,0000,0000,,{\i1}...ra sau những tòa cao ốc đó{\i0}\N{\i1}sẽ là cách tốt nhất...{\i0}
Dialogue: 0,0:07:56.90,0:07:58.03,Default,,0000,0000,0000,,Bị ngắt tín hiệu rồi hả?
Dialogue: 0,0:07:58.80,0:08:00.20,Default,,0000,0000,0000,,Hành động thôi!
Dialogue: 0,0:08:04.81,0:08:08.44,Default,,0000,0000,0000,,Một chiếc trực thăng mang mã bạn-thù không hợp lệ\Nđang tiếp cận từ phía bắc Dejima.
Dialogue: 0,0:08:09.11,0:08:10.84,Default,,0000,0000,0000,,Nó đã biến mất vào\Nkhu vực chế áp điện tử (ECM).
Dialogue: 0,0:08:11.38,0:08:14.18,Default,,0000,0000,0000,,Hẳn là chúng rồi.\NCho trực thăng bám theo cùng đường bay.
Dialogue: 0,0:08:14.68,0:08:15.88,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:08:25.76,0:08:27.79,Default,,0000,0000,0000,,Vậy là tín hiệu của ta cuối cùng\Ncũng bị cắt đứt rồi nhỉ?
Dialogue: 0,0:08:28.06,0:08:31.12,Default,,0000,0000,0000,,Ừ. Em thực sự hy vọng anh Batou\Nsẽ không sao.
Dialogue: 0,0:08:31.80,0:08:35.36,Default,,0000,0000,0000,,Tớ hiểu ý cậu, đám AI u ám đó\Nđộc ác kinh khủng...
Dialogue: 0,0:08:35.54,0:08:36.63,Default,,0000,0000,0000,,- Ừ, công nhận luôn.\N- Em lo quá...
Dialogue: 0,0:08:36.74,0:08:37.97,Default,,0000,0000,0000,,- Đúng rồi, đúng rồi...\N- Tớ sợ muốn chết...
Dialogue: 0,0:08:38.07,0:08:41.48,Default,,0000,0000,0000,,Nhắc mới nhớ, các cậu có nghĩ cậu ấy đã gặp được\Nanh Ishikawa chưa?
Dialogue: 0,0:08:41.61,0:08:42.63,Default,,0000,0000,0000,,Câu hỏi hay đấy.
Dialogue: 0,0:08:43.28,0:08:46.44,Default,,0000,0000,0000,,Này! Cậu đã gặp được\Nanh Ishikawa chưa?
Dialogue: 0,0:08:46.58,0:08:49.07,Default,,0000,0000,0000,,Thôi đi, tớ đời nào có thể\Ntới nơi nhanh thế được!
Dialogue: 0,0:08:49.32,0:08:51.79,Default,,0000,0000,0000,,Tớ đang di chuyển bằng đường {\i1}bộ{\i0}\Nngoài đời thực đấy, đồ khỉ gió!
Dialogue: 0,0:08:51.99,0:08:53.28,Default,,0000,0000,0000,,{\i1}Úi, cậu nói đúng.{\i0}\N{\i1}Xin lỗi nha!{\i0}
Dialogue: 0,0:08:53.59,0:08:54.95,Default,,0000,0000,0000,,{\i1}Thế tình hình bên anh thế nào rồi,{\i0}\N{\i1}anh Ishikawa?{\i0}
Dialogue: 0,0:08:55.29,0:08:57.32,Default,,0000,0000,0000,,{\i1}Tôi cũng đang trên đường{\i0}\N{\i1}tới đó đây.{\i0}
Dialogue: 0,0:08:58.03,0:09:01.52,Default,,0000,0000,0000,,{\i1}Tôi không dám lái nhanh quá,{\i0}\N{\i1}kẻo bị tóm mất.{\i0}
Dialogue: 0,0:09:07.34,0:09:08.74,Default,,0000,0000,0000,,{\i1}Có chuyện gì xảy ra{\i0}\N{\i1}với Thiếu tá không?{\i0}
Dialogue: 0,0:09:08.90,0:09:12.43,Default,,0000,0000,0000,,Bọn em đã xác nhận bằng mắt thường rồi,\Nhiện tại họ vẫn ổn ạ.
Dialogue: 0,0:09:12.71,0:09:13.70,Default,,0000,0000,0000,,{\i1}Nghe vậy thì mừng rồi.{\i0}
Dialogue: 0,0:09:13.81,0:09:18.51,Default,,0000,0000,0000,,Nhưng đám Jigabachi đang nắm quyền kiểm soát trên không,\Nnên họ đang gặp nguy hiểm lớn đấy.
Dialogue: 0,0:09:19.15,0:09:21.45,Default,,0000,0000,0000,,{\i1}Và chúng ta cũng không liên lạc được{\i0}\N{\i1}với Sếp nữa.{\i0}
Dialogue: 0,0:09:21.58,0:09:25.82,Default,,0000,0000,0000,,{\i1}Có vẻ như từ giờ trở đi chúng ta sẽ phải{\i0}\N{\i1}tự mình chủ động hành động rồi.{\i0}
Dialogue: 0,0:09:27.96,0:09:30.72,Default,,0000,0000,0000,,{\i1}Đám tị nạn và Kuze,{\i0}\N{\i1}chính phủ và Gohda,{\i0}
Dialogue: 0,0:09:30.83,0:09:33.32,Default,,0000,0000,0000,,{\i1}Sếp và Thiếu tá,{\i0}\N{\i1}và còn có cả chúng ta nữa...{\i0}
Dialogue: 0,0:09:33.96,0:09:37.36,Default,,0000,0000,0000,,{\i1}Xem ra ai tung ra được nước cờ ngoạn mục nhất...{\i0}
Dialogue: 0,0:09:37.47,0:09:40.09,Default,,0000,0000,0000,,{\i1}...sẽ là kẻ ẵm trọn{\i0}\N{\i1}toàn bộ ván bài này.{\i0}
Dialogue: 0,0:09:44.94,0:09:48.64,Default,,0000,0000,0000,,{\i1}Thưa Đại diện, trực thăng của Đội 4{\i0}\N{\i1}đã tiến vào Dejima cách đây vài phút.{\i0}
Dialogue: 0,0:09:48.88,0:09:50.14,Default,,0000,0000,0000,,{\i1}Tốt.{\i0}
Dialogue: 0,0:09:50.85,0:09:54.15,Default,,0000,0000,0000,,{\i1}Điều này có nghĩa là chúng ta sẽ có thể thu hồi{\i0}\N{\i1}plutonium, đúng không thưa ngài?{\i0}
Dialogue: 0,0:09:54.62,0:09:59.95,Default,,0000,0000,0000,,{\i1}Thu hồi plutonium không phải lý do thực sự{\i0}\N{\i1}khiến ta phái Đội 4 vào đó.{\i0}
Dialogue: 0,0:10:00.29,0:10:02.35,Default,,0000,0000,0000,,{\i1}Ý ngài là sao, thưa ngài?{\i0}
Dialogue: 0,0:10:02.83,0:10:04.29,Default,,0000,0000,0000,,{\i1}Cậu sẽ hiểu ra{\i0}\N{\i1}sớm thôi.{\i0}
Dialogue: 0,0:10:24.71,0:10:26.27,Default,,0000,0000,0000,,Vô ích thôi,\Ntôi không thể hạ cánh được!
Dialogue: 0,0:10:26.85,0:10:28.18,Default,,0000,0000,0000,,Đất đá đổ nát\Nngổn ngang khắp nơi!
Dialogue: 0,0:10:28.32,0:10:31.05,Default,,0000,0000,0000,,Không còn cách nào khác.\NTa sẽ đu dây xuống từng người một.
Dialogue: 0,0:10:38.43,0:10:39.69,Default,,0000,0000,0000,,Sẵn sàng rồi,\NThiếu tá.
Dialogue: 0,0:10:46.84,0:10:47.60,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:10:56.55,0:10:57.38,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:11:09.63,0:11:11.25,Default,,0000,0000,0000,,Bánh lái đuôi bị bắn trúng rồi!
Dialogue: 0,0:11:51.80,0:11:55.40,Default,,0000,0000,0000,,Tiến triển thế nào rồi, Proto? Liệu chúng ta có thể\Nkết nối được với các Tachikoma không?
Dialogue: 0,0:11:55.54,0:11:57.06,Default,,0000,0000,0000,,Được ạ, bằng cách nào đó.
Dialogue: 0,0:11:57.21,0:11:59.07,Default,,0000,0000,0000,,Thật sao? Tôi biết cậu\Nsẽ làm được mà.
Dialogue: 0,0:11:59.64,0:12:01.74,Default,,0000,0000,0000,,Tự mình tôi thì đời nào\Nlàm nổi chuyện đó.
Dialogue: 0,0:12:02.24,0:12:03.73,Default,,0000,0000,0000,,Không có chi đâu, thưa ngài.
Dialogue: 0,0:12:04.28,0:12:07.22,Default,,0000,0000,0000,,Ngài là người có khả năng thực hiện bất cứ hành động nào\Nmà tình huống đòi hỏi.
Dialogue: 0,0:12:09.08,0:12:11.68,Default,,0000,0000,0000,,Tôi tự hỏi liệu Thủ tướng Kayabuki\Ncó ổn không...
Dialogue: 0,0:12:11.99,0:12:14.65,Default,,0000,0000,0000,,Bà ấy có lẽ đang bị quản thúc tại gia\Nở nơi nào đó.
Dialogue: 0,0:12:14.99,0:12:20.16,Default,,0000,0000,0000,,Chúng sẽ giấu kín việc bãi nhiệm bà ấy khỏi truyền thông\Ncho tới khi tình hình này được giải quyết.
Dialogue: 0,0:12:20.73,0:12:23.63,Default,,0000,0000,0000,,Để đổ hết mọi tội lỗi lên đầu bà ấy\Nsau khi tàn cuộc ư?
Dialogue: 0,0:12:24.00,0:12:24.86,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:12:24.97,0:12:27.13,Default,,0000,0000,0000,,Nhưng cho tới khi một thông cáo chính thức\Nđược đưa ra,
Dialogue: 0,0:12:27.24,0:12:29.76,Default,,0000,0000,0000,,bà ấy vẫn là Thủ tướng\Ntrên mọi phương diện.
Dialogue: 0,0:12:30.44,0:12:33.60,Default,,0000,0000,0000,,Vẫn sẽ có những tình huống\Nmà chúng cần đến tư cách của bà ấy.
Dialogue: 0,0:12:34.01,0:12:35.14,Default,,0000,0000,0000,,Cá là vậy rồi.
Dialogue: 0,0:12:35.51,0:12:38.57,Default,,0000,0000,0000,,Thưa ngài, tôi đã thiết lập được liên lạc\Nvới các Tachikoma.
Dialogue: 0,0:12:39.21,0:12:43.24,Default,,0000,0000,0000,,Có vẻ như Thiếu tá và những người khác\Nđã tiến vào Dejima cùng với số plutonium.
Dialogue: 0,0:12:43.45,0:12:44.44,Default,,0000,0000,0000,,Dejima ư?
Dialogue: 0,0:12:44.99,0:12:48.55,Default,,0000,0000,0000,,Chà chà, đó là một ý kiến hay đấy.\NThế tình hình dưới đó thế nào rồi?
Dialogue: 0,0:12:48.92,0:12:50.08,Default,,0000,0000,0000,,Không tốt ạ.
Dialogue: 0,0:12:50.19,0:12:53.56,Default,,0000,0000,0000,,Có vẻ như đã có một cuộc giao tranh nổ ra\Ngiữa đám tị nạn và Quân Phòng vệ.
Dialogue: 0,0:12:54.13,0:12:57.22,Default,,0000,0000,0000,,Trực thăng tấn công của Quân Phòng vệ\Nđã bắn phá tan tành các công sự ở Dejima.
Dialogue: 0,0:12:57.60,0:13:00.57,Default,,0000,0000,0000,,Họ nói rằng chiếc trực thăng chở Thiếu tá\Nvà những người khác vừa bị tấn công.
Dialogue: 0,0:13:01.24,0:13:03.97,Default,,0000,0000,0000,,Bị {\i1}cái gì cơ?{\i0} Cậu bảo Thiếu tá\Nvà Anh bự bị...
Dialogue: 0,0:13:04.31,0:13:07.54,Default,,0000,0000,0000,,Họ không thể liên lạc được vì toàn bộ Dejima\Nđang bị bao trùm bởi trường gây nhiễu ECM.
Dialogue: 0,0:13:07.84,0:13:10.71,Default,,0000,0000,0000,,Các Tachikoma không thể xác định\Nliệu họ còn sống hay đã chết.
Dialogue: 0,0:13:14.82,0:13:18.18,Default,,0000,0000,0000,,Bảo các Tachikoma\Ntiếp tục cập nhật báo cáo.
Dialogue: 0,0:13:18.52,0:13:19.82,Default,,0000,0000,0000,,Rõ rồi ạ.
Dialogue: 0,0:13:26.03,0:13:27.83,Default,,0000,0000,0000,,Thằng chó đẻ...
Dialogue: 0,0:13:52.25,0:13:54.38,Default,,0000,0000,0000,,Batou, tôi đi trước đây.
Dialogue: 0,0:13:57.86,0:13:59.56,Default,,0000,0000,0000,,{\i1}Anh đang ở đâu, Kuze?{\i0}
Dialogue: 0,0:14:39.23,0:14:43.03,Default,,0000,0000,0000,,Không việc gì phải vội. Vẫn còn thời gian\Ntrước khi máy bay trinh sát của chúng tới.
Dialogue: 0,0:15:01.29,0:15:01.88,Default,,0000,0000,0000,,Chết tiệt.
Dialogue: 0,0:15:04.79,0:15:07.96,Default,,0000,0000,0000,,Rắc rối rồi đây. Nếu ta không làm gì,\Nđám tị nạn sẽ bao vây chúng ta mất.
Dialogue: 0,0:15:16.91,0:15:19.93,Default,,0000,0000,0000,,Các mục tiêu hẳn vẫn còn trong khu vực!\NDi chuyển nhanh lên!
Dialogue: 0,0:15:20.04,0:15:23.21,Default,,0000,0000,0000,,Cái quái gì thế?\NĐám đó bám theo ta vào tận đây sao?!
Dialogue: 0,0:15:24.28,0:15:27.15,Default,,0000,0000,0000,,Chúng ta không dùng được bộ đàm!\NĐừng bật ngụy trang quang học!
Dialogue: 0,0:15:27.58,0:15:29.95,Default,,0000,0000,0000,,Có nguy cơ các cậu sẽ bắn trúng\Nngười của phe mình đấy!
Dialogue: 0,0:15:33.76,0:15:35.09,Default,,0000,0000,0000,,Chúng thuộc đơn vị nào thế?
Dialogue: 0,0:15:35.66,0:15:39.59,Default,,0000,0000,0000,,Toi rồi. Đó là đội đặc nhiệm\Ncủa Quân Phòng vệ Mặt đất.
Dialogue: 0,0:15:45.70,0:15:48.17,Default,,0000,0000,0000,,Em không thấy anh Batou\Nvà những người khác...
Dialogue: 0,0:15:48.30,0:15:51.27,Default,,0000,0000,0000,,Một chiếc trực thăng thứ hai đang ở hiện trường vụ rơi...\NEm tự hỏi chuyện đó là sao nhỉ?
Dialogue: 0,0:15:51.51,0:15:54.48,Default,,0000,0000,0000,,Trông như có vài người lính vừa bước ra...\NEm chẳng hiểu gì cả.
Dialogue: 0,0:15:54.68,0:15:58.64,Default,,0000,0000,0000,,Tớ cũng chẳng thấy Thiếu tá đâu cả.\NCó thể họ đang bật ngụy trang quang học.
Dialogue: 0,0:15:58.95,0:16:01.21,Default,,0000,0000,0000,,Này, các cậu thấy vụ này\Nthế nào?
Dialogue: 0,0:16:01.68,0:16:04.85,Default,,0000,0000,0000,,Những tàu tuần dương Aegis và tàu sân bay trực thăng\Ntừng bao vây Dejima...
Dialogue: 0,0:16:04.95,0:16:06.82,Default,,0000,0000,0000,,...đã bắt đầu lùi lại\Ncách đây vài phút rồi...
Dialogue: 0,0:16:07.06,0:16:09.79,Default,,0000,0000,0000,,Và vì lý do nào đó,\Nmột chiếc tàu quét mìn...
Dialogue: 0,0:16:09.89,0:16:12.69,Default,,0000,0000,0000,,...đã bắt đầu rải các vi cỗ máy\Ntẩy rửa phóng xạ.
Dialogue: 0,0:16:13.23,0:16:14.49,Default,,0000,0000,0000,,Gì cơ? Cho bọn tớ xem với!
Dialogue: 0,0:16:18.17,0:16:19.33,Default,,0000,0000,0000,,Cậu ấy nói đúng kìa...
Dialogue: 0,0:16:19.70,0:16:21.67,Default,,0000,0000,0000,,Khi một đầu đạn hạt nhân\Nđược kích nổ,
Dialogue: 0,0:16:22.10,0:16:27.01,Default,,0000,0000,0000,,cậu không thể giảm thiểu tác động của phóng xạ\Nnếu không rải chúng trước thời hạn, đúng không?
Dialogue: 0,0:16:27.61,0:16:30.64,Default,,0000,0000,0000,,Đúng, họ tận dụng hiệu ứng gió hút ngược\Nsau khi đầu đạn phát nổ...
Dialogue: 0,0:16:30.75,0:16:32.58,Default,,0000,0000,0000,,...để các vi cỗ máy\Nbị hút vào vùng tâm chấn vụ nổ.
Dialogue: 0,0:16:32.85,0:16:35.48,Default,,0000,0000,0000,,Dù vậy, tớ không hiểu\Nmục đích là gì.
Dialogue: 0,0:16:35.68,0:16:39.02,Default,,0000,0000,0000,,Có lẽ đó chỉ là biện pháp bảo hiểm phòng khi\Nđám tị nạn dùng vũ khí hạt nhân.
Dialogue: 0,0:16:39.22,0:16:40.92,Default,,0000,0000,0000,,Tớ không nghĩ thế.
Dialogue: 0,0:16:41.26,0:16:44.35,Default,,0000,0000,0000,,Ngay cả khi giả định rằng Quân Phòng vệ nghĩ\Ncó vũ khí hạt nhân trên Dejima,
Dialogue: 0,0:16:44.59,0:16:46.22,Default,,0000,0000,0000,,thì nếu suy luận của Thiếu tá\Nvà mọi người là đúng,
Dialogue: 0,0:16:46.33,0:16:51.10,Default,,0000,0000,0000,,Chánh Văn phòng Nội các, và ít nhất là Gohda,\Nđều biết rõ là chẳng có quả nào ở đó, đúng chứ?
Dialogue: 0,0:16:51.53,0:16:55.13,Default,,0000,0000,0000,,Có thể đây lại là một màn kịch nữa\Nđể tăng thêm tính hiện thực...
Dialogue: 0,0:16:55.40,0:16:59.20,Default,,0000,0000,0000,,Đó có thể là một phần lý do, nhưng trông họ\Ncó vẻ như đang làm thật vậy.
Dialogue: 0,0:16:59.68,0:17:02.01,Default,,0000,0000,0000,,Proto, cậu phân tích\Ntình hình này thế nào?
Dialogue: 0,0:17:02.11,0:17:04.70,Default,,0000,0000,0000,,Tôi sao? Ừm, để tôi nghĩ xem...
Dialogue: 0,0:17:05.01,0:17:07.85,Default,,0000,0000,0000,,Này mọi người!\NMọi người nghĩ đây là thứ gì?
Dialogue: 0,0:17:07.95,0:17:09.28,Default,,0000,0000,0000,,Gì thế? Cho bọn tớ xem với!
Dialogue: 0,0:17:10.02,0:17:16.12,Default,,0000,0000,0000,,Có một khối kim loại khổng lồ\Ncách rạn san hô Okinawa 370 km về phía đông...
Dialogue: 0,0:17:16.49,0:17:20.02,Default,,0000,0000,0000,,...đang nổi lên ngay sát ranh giới\Nvùng đặc quyền kinh tế của Nhật Bản!
Dialogue: 0,0:17:21.23,0:17:22.92,Default,,0000,0000,0000,,Các cậu không nghĩ\Nđây là một...
Dialogue: 0,0:17:24.07,0:17:26.90,Default,,0000,0000,0000,,Nó không phải là một chiếc tàu ngầm hạt nhân\Ncủa Đế quốc Mỹ đấy chứ?
Dialogue: 0,0:17:27.77,0:17:29.20,Default,,0000,0000,0000,,Một tàu ngầm hạt nhân\Ncủa Đế quốc Mỹ ư?
Dialogue: 0,0:17:32.04,0:17:35.20,Default,,0000,0000,0000,,Ngài nghĩ việc chúng nằm trong ranh giới 200 hải lý\Ncó ý nghĩa gì?
Dialogue: 0,0:17:35.64,0:17:40.67,Default,,0000,0000,0000,,Nó có lẽ đồng nghĩa với việc chúng có mặt ở đây\Nlà kết quả từ một chủ ý nào đó từ phía chính phủ.
Dialogue: 0,0:17:41.05,0:17:45.15,Default,,0000,0000,0000,,Chẳng lẽ ngài bảo chúng thực sự\Nsẽ phóng tên lửa hạt nhân vào Dejima sao?!
Dialogue: 0,0:17:45.49,0:17:48.85,Default,,0000,0000,0000,,Đánh giá từ tình hình lúc này,\Ntôi cho rằng rất có khả năng là như vậy.
Dialogue: 0,0:17:50.39,0:17:54.69,Default,,0000,0000,0000,,Gohda đã kiểm soát mọi thứ,\Nngay từ đầu đã trù tính chuyện này sẽ xảy ra.
Dialogue: 0,0:17:55.36,0:17:57.86,Default,,0000,0000,0000,,Ngài nghĩ đó cũng là lý do Chánh Văn phòng Nội các\Nlại thúc giục gấp rút...
Dialogue: 0,0:17:58.20,0:17:59.50,Default,,0000,0000,0000,,...về Hiệp ước An ninh Mỹ-Nhật\Nđến thế sao?
Dialogue: 0,0:17:59.60,0:18:00.80,Default,,0000,0000,0000,,Ngài đùa chắc!
Dialogue: 0,0:18:00.90,0:18:02.60,Default,,0000,0000,0000,,Chuyện đó hoàn toàn nằm\Ntrong phạm vi có thể xảy ra.
Dialogue: 0,0:18:02.74,0:18:05.76,Default,,0000,0000,0000,,Kịch bản của Gohda có lẽ sẽ kết thúc với việc đại loại như đám tị nạn...
Dialogue: 0,0:18:05.87,0:18:11.74,Default,,0000,0000,0000,,...bị dồn vào chân tường bởi Quân Phòng vệ và cố đánh bom tự sát bằng vũ khí hạt nhân.
Dialogue: 0,0:18:12.41,0:18:14.91,Default,,0000,0000,0000,,Số tiền hối lộ từ Tập đoàn Poseidon...
Dialogue: 0,0:18:15.25,0:18:17.24,Default,,0000,0000,0000,,Khoản công quỹ biến mất khỏi Bộ Ngoại giao...
Dialogue: 0,0:18:17.39,0:18:20.05,Default,,0000,0000,0000,,Tôi nghĩ hoàn toàn có cơ sở để nói rằng\Ntất cả đều được sử dụng để...
Dialogue: 0,0:18:20.16,0:18:22.56,Default,,0000,0000,0000,,...khiến Đế quốc Mỹ\Nphóng tên lửa hạt nhân.
Dialogue: 0,0:18:23.19,0:18:26.09,Default,,0000,0000,0000,,Tất cả đều nằm trong tay những kẻ hành động\Ntrong vòng bí mật tuyệt đối...
Dialogue: 0,0:18:26.19,0:18:28.92,Default,,0000,0000,0000,,...những kẻ ôm mộng\Ntái thiết lập lại trật tự thế giới.
Dialogue: 0,0:18:29.50,0:18:33.83,Default,,0000,0000,0000,,Và giờ đây, plutonium đã được đưa vào Dejima\Nbởi Thiếu tá và những người khác...
Dialogue: 0,0:18:34.47,0:18:37.17,Default,,0000,0000,0000,,Trưởng phòng! Hãy đưa Thủ tướng\NKayabuki trở lại đây thôi!
Dialogue: 0,0:18:37.54,0:18:40.53,Default,,0000,0000,0000,,Như ngài đã nói lúc nãy, bà ấy vẫn là\NThủ tướng của Nhật Bản...
Dialogue: 0,0:18:40.88,0:18:42.54,Default,,0000,0000,0000,,...xét về mặt quan hệ ngoại giao!
Dialogue: 0,0:18:43.01,0:18:47.31,Default,,0000,0000,0000,,Bà ấy có thể dùng thẩm quyền của mình\Nđể ngăn chặn cuộc tấn công hạt nhân!
Dialogue: 0,0:18:47.98,0:18:49.25,Default,,0000,0000,0000,,Đúng, cậu nói phải...
Dialogue: 0,0:18:52.62,0:18:57.42,Default,,0000,0000,0000,,Tôi biết họ có thể lục soát cậu hoặc Proto,\Nnhưng họ đời nào dám kiểm tra tôi.
Dialogue: 0,0:19:02.26,0:19:05.43,Default,,0000,0000,0000,,Proto, cậu có biết họ đang giữ\NThủ tướng ở đâu không?
Dialogue: 0,0:19:05.63,0:19:07.43,Default,,0000,0000,0000,,Tôi sẽ dò tìm\Nngay lập tức.
Dialogue: 0,0:19:17.95,0:19:18.94,Default,,0000,0000,0000,,Proto!
Dialogue: 0,0:19:19.98,0:19:21.61,Default,,0000,0000,0000,,Này, cậu có sao không?!
Dialogue: 0,0:19:21.82,0:19:23.94,Default,,0000,0000,0000,,Khốn kiếp, tường lửa tấn công sao?
Dialogue: 0,0:19:37.33,0:19:38.73,Default,,0000,0000,0000,,Togusa...
Dialogue: 0,0:19:39.57,0:19:40.40,Default,,0000,0000,0000,,Proto...
Dialogue: 0,0:19:41.17,0:19:45.13,Default,,0000,0000,0000,,Tôi đã tìm thấy vị trí\Ncủa Thủ tướng...
Dialogue: 0,0:19:45.37,0:19:49.10,Default,,0000,0000,0000,,Proto?\NCậu là người máy android sao?
Dialogue: 0,0:19:49.75,0:19:57.15,Default,,0000,0000,0000,,Không... Tôi là một\Nngười máy sinh học nguyên mẫu...
Dialogue: 0,0:20:10.17,0:20:11.00,Default,,0000,0000,0000,,Nó đang tới kìa!
Dialogue: 0,0:20:11.10,0:20:12.33,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:20:15.20,0:20:18.26,Default,,0000,0000,0000,,Bình tĩnh. Đây là\Ntên lửa tầm nhiệt.
Dialogue: 0,0:20:18.77,0:20:20.67,Default,,0000,0000,0000,,Thứ này sẽ bắn trúng mục tiêu\Nngay cả khi cậu nhắm mắt.
Dialogue: 0,0:20:21.34,0:20:23.61,Default,,0000,0000,0000,,Tôi không nghĩ họ ngờ được việc\Nsẽ bị bắn trả bằng tên lửa Stinger đâu.
Dialogue: 0,0:20:23.85,0:20:25.11,Default,,0000,0000,0000,,Họ đã quá chủ quan.
Dialogue: 0,0:20:29.52,0:20:30.49,Default,,0000,0000,0000,,Bắn!
Dialogue: 0,0:21:01.32,0:21:02.28,Default,,0000,0000,0000,,Bắn trúng rồi!
Dialogue: 0,0:21:03.22,0:21:04.85,Default,,0000,0000,0000,,Trực thăng tấn công của chúng\Nsẽ tới đây sớm thôi!
Dialogue: 0,0:21:05.09,0:21:06.31,Default,,0000,0000,0000,,Mau rút lui thôi!
Dialogue: 0,0:21:15.13,0:21:16.32,Default,,0000,0000,0000,,{\i1}Kuze...{\i0}
Dialogue: 0,0:21:21.37,0:21:23.89,Default,,0000,0000,0000,,Nếu ở lại trong này, chúng ta\Nsẽ bị găm chặt tại chỗ mất.
Dialogue: 0,0:21:24.74,0:21:28.27,Default,,0000,0000,0000,,Các cậu hãy ra ngoài trước đi.\NTôi sẽ ra sau cùng với số plutonium.
Dialogue: 0,0:21:28.94,0:21:32.31,Default,,0000,0000,0000,,Chúng ta sẽ tập hợp ở các tòa nhà phía sau.\NBên trong đó là một mê cung.
Dialogue: 0,0:21:32.51,0:21:33.95,Default,,0000,0000,0000,,Chúng ta vẫn có thể thắng ván này.
Dialogue: 0,0:21:41.16,0:21:42.52,Default,,0000,0000,0000,,Chúng đang tới kìa!\NDi chuyển mau!
Dialogue: 0,0:21:42.66,0:21:44.06,Default,,0000,0000,0000,,Mỗi toán hai người,\Nhai cặp!
Dialogue: 0,0:21:44.16,0:21:45.25,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:22:13.52,0:22:15.11,Default,,0000,0000,0000,,Chúng đang sử dụng\Nngụy trang nhiệt quang!
Dialogue: 0,0:22:15.56,0:22:18.46,Default,,0000,0000,0000,,Mục tiêu của chúng ta trông không giống\Nđơn vị Quân Phòng vệ thông thường!
Dialogue: 0,0:22:18.66,0:22:20.06,Default,,0000,0000,0000,,Chuyện gì đang xảy ra ở đây thế?
Dialogue: 0,0:22:20.40,0:22:23.69,Default,,0000,0000,0000,,Mệnh lệnh của chúng ta nói rằng những kẻ\Ncướp số plutonium...
Dialogue: 0,0:22:23.80,0:22:25.86,Default,,0000,0000,0000,,...chỉ là năm tên lính\Nhạng bét thôi mà!
Dialogue: 0,0:22:26.23,0:22:30.53,Default,,0000,0000,0000,,Được rồi, chia làm hai đội!\NChúng ta sẽ truy đuổi theo đội hình B!
Dialogue: 0,0:22:31.01,0:22:31.94,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:22:31.94,0:22:33.94,Default,,0000,0000,0000,,
