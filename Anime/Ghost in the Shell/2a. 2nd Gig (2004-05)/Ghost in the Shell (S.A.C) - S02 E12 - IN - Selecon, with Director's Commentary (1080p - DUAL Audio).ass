Dialogue: 0,0:01:48.50,0:01:49.90,Default,,0000,0000,0000,,Kích hoạt mồi bẫy F4!
Dialogue: 0,0:01:49.90,0:01:51.83,Default,,0000,0000,0000,,Bơm virus phá vỡ tường phòng thủ!
Dialogue: 0,0:01:52.53,0:01:53.40,Default,,0000,0000,0000,,Được rồi, làm tốt lắm.
Dialogue: 0,0:01:53.60,0:01:56.80,Default,,0000,0000,0000,,Khi các cậu đã thiết lập sẵn các biến thể tường tấn công\Ntrên vành đai ngoài,
Dialogue: 0,0:01:57.27,0:01:58.93,Default,,0000,0000,0000,,hãy mã hóa và nén nó lại.
Dialogue: 0,0:01:59.24,0:02:00.27,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:02:01.68,0:02:02.64,Default,,0000,0000,0000,,Tìm thấy rồi.
Dialogue: 0,0:02:04.71,0:02:07.38,Default,,0000,0000,0000,,Một cổng tàng hình mà ta không thể chạm tới\Ntrừ phi phải đi qua...
Dialogue: 0,0:02:07.38,0:02:09.87,Default,,0000,0000,0000,,...mạng vệ tinh châu Âu\Nqua bắc bán cầu sao?
Dialogue: 0,0:02:09.99,0:02:10.71,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:02:10.85,0:02:14.41,Default,,0000,0000,0000,,Nhưng nghe này.\NThực chất đích đến lại là Asian Matrix.
Dialogue: 0,0:02:14.86,0:02:18.23,Default,,0000,0000,0000,,Mạng cục bộ châu Á à?\NTên đó cũng chẳng khôn ngoan gì cho cam.
Dialogue: 0,0:02:18.23,0:02:19.33,Default,,0000,0000,0000,,Chắc chắn là vậy rồi.
Dialogue: 0,0:02:19.33,0:02:22.39,Default,,0000,0000,0000,,Cô có muốn tôi bắt tay vào phân tích cấu trúc\Nngay bây giờ không?
Dialogue: 0,0:02:22.70,0:02:24.67,Default,,0000,0000,0000,,Chúng ta sẽ liên lạc\Nvới Thiếu tá trước.
Dialogue: 0,0:02:33.01,0:02:35.37,Default,,0000,0000,0000,,Tên khốn Gohda\Nđang cố tình phô trương đấy.
Dialogue: 0,0:02:35.78,0:02:38.08,Default,,0000,0000,0000,,Hắn muốn nhắn cho chúng ta rằng: \"Cho dù các người\Ncó tìm thấy ký ức ngoài của Kawashima,\"
Dialogue: 0,0:02:38.51,0:02:42.05,Default,,0000,0000,0000,,\"thì cũng đừng hòng tìm ra bất kỳ\Nchứng cứ nào dẫn tới chỗ ta.\"
Dialogue: 0,0:02:42.05,0:02:44.68,Default,,0000,0000,0000,,Hắn cáo già thật, tôi công nhận.\NNhưng theo những gì tôi thấy,
Dialogue: 0,0:02:44.75,0:02:48.09,Default,,0000,0000,0000,,thì không có dấu hiệu cho thấy có bên thứ ba\Ncan thiệp vào bộ nhớ ngoài.
Dialogue: 0,0:02:48.16,0:02:52.06,Default,,0000,0000,0000,,Giả sử như tổ chức Mười Một Cá Nhân\Nbị kích hoạt bởi một loại virus,
Dialogue: 0,0:02:52.16,0:02:55.06,Default,,0000,0000,0000,,thì rất có thể chứng cứ của nó\Nđang nằm ngay tại đây.
Dialogue: 0,0:02:57.13,0:02:58.76,Default,,0000,0000,0000,,Được rồi, tôi sẽ\Nlặn vào đó.
Dialogue: 0,0:02:59.23,0:03:00.76,Default,,0000,0000,0000,,Ishikawa và Borma,\Nyểm trợ phía sau cho tôi.
Dialogue: 0,0:03:01.54,0:03:03.37,Default,,0000,0000,0000,,Tachikoma, chuẩn bị sẵn\Nmảng virus dự phòng.
Dialogue: 0,0:03:03.67,0:03:05.57,Default,,0000,0000,0000,,Dùng Bộ D được không ạ?
Dialogue: 0,0:03:05.87,0:03:06.90,Default,,0000,0000,0000,,Được, bộ đó ổn đấy.
Dialogue: 0,0:03:08.18,0:03:11.64,Default,,0000,0000,0000,,{\i1}Thiếu tá, xin lỗi vì đã ngắt lời,{\i0}\N{\i1}nhưng hãy lên đây gấp ngay lập tức.{\i0}
Dialogue: 0,0:03:12.05,0:03:13.41,Default,,0000,0000,0000,,{\i1}Đây là việc ưu tiên hàng đầu.{\i0}
Dialogue: 0,0:03:13.72,0:03:17.02,Default,,0000,0000,0000,,{\i1}Nếu còn quan trọng hơn cả việc này,{\i0}\N{\i1}thì ắt hẳn phải rất nghiêm trọng rồi.{\i0}
Dialogue: 0,0:03:17.29,0:03:20.55,Default,,0000,0000,0000,,{\i1}Đúng vậy. Gọi cả Batou,{\i0}\N{\i1}Saito và Paz nữa.{\i0}
Dialogue: 0,0:03:22.32,0:03:23.42,Default,,0000,0000,0000,,Các cậu nghe sếp nói rồi đấy.
Dialogue: 0,0:03:24.36,0:03:27.12,Default,,0000,0000,0000,,Borma, cậu lặn vào\Nthay tôi.
Dialogue: 0,0:03:28.06,0:03:29.93,Default,,0000,0000,0000,,Ishikawa, lo liệu phần còn lại nhé.
Dialogue: 0,0:03:35.84,0:03:38.27,Default,,0000,0000,0000,,Được rồi... Chúng ta giải quyết nhanh\Nvụ này luôn nhỉ?
Dialogue: 0,0:03:46.58,0:03:47.61,Default,,0000,0000,0000,,{\i1}Làm thôi.{\i0}
Dialogue: 0,0:03:54.52,0:03:59.12,Default,,0000,0000,0000,,Này Togusa, sao cậu không đặt avatar\Nvề hình dạng mặc định đi?
Dialogue: 0,0:04:00.00,0:04:02.97,Default,,0000,0000,0000,,Dùng avatar đó lúc tán gẫu thì không sao,\Nnhưng cậu không nghĩ sẽ nguy hiểm...
Dialogue: 0,0:04:02.97,0:04:05.16,Default,,0000,0000,0000,,...nếu bị thứ cồng kềnh như thế vướng víu\Nkhi đang lặn qua một mảng tường chắn à?
Dialogue: 0,0:04:05.53,0:04:07.74,Default,,0000,0000,0000,,Dù sao thì, cậu có thật sự muốn nhìn tôi\Nvới lão Ishikawa đây...
Dialogue: 0,0:04:07.74,0:04:10.83,Default,,0000,0000,0000,,...bay lượn trong mấy bộ đồ siêu anh hùng\Nkiểu truyện tranh Mỹ không hả?
Dialogue: 0,0:04:11.44,0:04:13.18,Default,,0000,0000,0000,,Cậu ta nói cũng có lý...
Dialogue: 0,0:04:13.18,0:04:16.70,Default,,0000,0000,0000,,{\i1}Bớt nói nhảm đi.{\i0}\N{\i1}Borma sắp vượt qua cổng rồi.{\i0}
Dialogue: 0,0:04:21.72,0:04:23.21,Default,,0000,0000,0000,,Tiếp tục bơm virus!
Dialogue: 0,0:04:23.69,0:04:27.02,Default,,0000,0000,0000,,Xác nhận đã va chạm với mảng tường phòng thủ của địch\Nvà bắt đầu tiến trình vô hiệu hóa.
Dialogue: 0,0:04:32.26,0:04:33.10,Default,,0000,0000,0000,,Có thấy gì không?
Dialogue: 0,0:04:33.10,0:04:36.76,Default,,0000,0000,0000,,Tôi thấy một thứ. Có một tập tin khả nghi\Nở tầng số 6...
Dialogue: 0,0:04:37.07,0:04:38.29,Default,,0000,0000,0000,,Tên tập tin là gì?
Dialogue: 0,0:04:38.67,0:04:40.36,Default,,0000,0000,0000,,\"Mười Một Cá Nhân.\"
Dialogue: 0,0:04:40.57,0:04:41.64,Default,,0000,0000,0000,,Kế hoạch thế nào đây?
Dialogue: 0,0:04:41.64,0:04:46.34,Default,,0000,0000,0000,,Để biết tập tin này có phải là virus\Nkích hoạt Mười Một Cá Nhân hay không,
Dialogue: 0,0:04:46.88,0:04:50.00,Default,,0000,0000,0000,,cách nhanh nhất là nạp thẳng nó vào não điện tử\Ncủa ai đó rồi xem điều gì xảy ra.
Dialogue: 0,0:04:50.35,0:04:51.38,Default,,0000,0000,0000,,Này!\NĐùa nhau à.
Dialogue: 0,0:04:51.38,0:04:53.28,Default,,0000,0000,0000,,Có muốn thử tống nó\Nvào đầu tôi không?
Dialogue: 0,0:04:53.85,0:04:56.41,Default,,0000,0000,0000,,Này, thế không phải quá mạo hiểm sao?
Dialogue: 0,0:04:56.59,0:04:58.69,Default,,0000,0000,0000,,Tôi nghĩ chúng ta nên lập trình vắc-xin\Ntrước khi...
Dialogue: 0,0:04:58.69,0:05:02.25,Default,,0000,0000,0000,,Vấn đề của vắc-xin là cậu chẳng thể viết được\Nnếu nó chưa {\i1}phát tác{\i0} triệu chứng.
Dialogue: 0,0:05:02.62,0:05:04.11,Default,,0000,0000,0000,,Đắng lòng nhưng là sự thật.
Dialogue: 0,0:05:05.63,0:05:07.39,Default,,0000,0000,0000,,Được rồi, tôi đã sao lưu\Ntoàn bộ cho cậu rồi.
Dialogue: 0,0:05:08.13,0:05:11.66,Default,,0000,0000,0000,,Để chắc ăn, hãy phân vùng riêng các khu vực\Nphân tích trong não điện tử của cậu ra.
Dialogue: 0,0:05:11.80,0:05:12.70,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:05:17.97,0:05:21.10,Default,,0000,0000,0000,,Đoạn phim này tình cờ được ghi lại\Nvào 22 phút trước...
Dialogue: 0,0:05:21.18,0:05:24.01,Default,,0000,0000,0000,,...bởi Hệ thống Hồng ngoại dọc theo\NKhu vực B Bờ biển Nagasaki.
Dialogue: 0,0:05:26.92,0:05:30.44,Default,,0000,0000,0000,,Thằng chó... Rốt cuộc hắn đã trốn\Nở cái xó xỉnh nào suốt thời gian qua?
Dialogue: 0,0:05:30.89,0:05:33.02,Default,,0000,0000,0000,,Nếu hắn chưa thay\Ncơ thể giả mới,
Dialogue: 0,0:05:33.02,0:05:36.75,Default,,0000,0000,0000,,thì có thể hắn đã tắt nguồn\Nđể chờ các bộ phận sinh học tái tạo.
Dialogue: 0,0:05:38.39,0:05:41.26,Default,,0000,0000,0000,,Chúng ta có thể sẽ không bao giờ\Ncó cơ hội thứ hai như thế này nữa.
Dialogue: 0,0:05:41.66,0:05:46.23,Default,,0000,0000,0000,,Tôi đã yêu cầu Cảnh sát Kyushu tăng cường\Ngiám sát trên toàn bộ hòn đảo.
Dialogue: 0,0:05:46.70,0:05:49.14,Default,,0000,0000,0000,,Hãy bay tới Nagasaki ngay lập tức\Nvà bắt giữ người này.
Dialogue: 0,0:05:55.68,0:05:57.74,Default,,0000,0000,0000,,Này... Borma?\NCậu có sao không?
Dialogue: 0,0:05:59.75,0:06:00.55,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:06:00.55,0:06:01.98,Default,,0000,0000,0000,,Thôi nào, không thể nào\Nnhư thế được!
Dialogue: 0,0:06:02.52,0:06:04.88,Default,,0000,0000,0000,,Tôi sẽ cưỡng chế\Ntắt chương trình.
Dialogue: 0,0:06:11.33,0:06:12.82,Default,,0000,0000,0000,,Này. Borma?
Dialogue: 0,0:06:22.44,0:06:23.57,Default,,0000,0000,0000,,Cậu ổn chứ?
Dialogue: 0,0:06:23.57,0:06:24.56,Default,,0000,0000,0000,,Ừ.
Dialogue: 0,0:06:25.07,0:06:26.27,Default,,0000,0000,0000,,Sao rồi? Trong đó\Ncó thứ gì?
Dialogue: 0,0:06:26.58,0:06:30.44,Default,,0000,0000,0000,,Chẳng có gì to tát cả. Tập tin đó\Nchỉ chứa một bài tiểu luận viết dở tệ.
Dialogue: 0,0:06:30.98,0:06:32.38,Default,,0000,0000,0000,,Chỉ có một bài tiểu luận thôi sao?
Dialogue: 0,0:06:41.72,0:06:45.49,Default,,0000,0000,0000,,Nếu người đàn ông đó chính là kẻ\Nđã tấn công Thủ tướng,
Dialogue: 0,0:06:46.03,0:06:49.70,Default,,0000,0000,0000,,thì rất có thể nhân tố kích hoạt Mười Một Cá Nhân...
Dialogue: 0,0:06:49.70,0:06:53.36,Default,,0000,0000,0000,,...vẫn còn được lưu giữ bên trong đầu hắn,\Nđúng như lời Sếp nói.
Dialogue: 0,0:06:54.47,0:06:57.17,Default,,0000,0000,0000,,Bắn tỉa từ tầm xa\Nlà một phương án,
Dialogue: 0,0:06:57.64,0:07:00.18,Default,,0000,0000,0000,,nhưng mẫu PKF đó là loại cơ thể máy bất tử...
Dialogue: 0,0:07:00.18,0:07:02.08,Default,,0000,0000,0000,,...với các bộ phận\Nhoạt động độc lập.
Dialogue: 0,0:07:02.34,0:07:04.11,Default,,0000,0000,0000,,Ta không thể hạ gục được chúng\Ntrừ phi bắn thẳng vào đầu.
Dialogue: 0,0:07:04.45,0:07:06.97,Default,,0000,0000,0000,,Trong trường hợp đó, ta sẽ áp sát\Nvà dùng vũ lực đè bẹp hắn.
Dialogue: 0,0:07:07.72,0:07:11.78,Default,,0000,0000,0000,,Nếu đường cùng, ta có thể dùng thứ này\Nvà mang mỗi cái đầu của hắn về.
Dialogue: 0,0:07:13.16,0:07:14.85,Default,,0000,0000,0000,,Cô đúng là tàn nhẫn\Nthật đấy nhỉ?
Dialogue: 0,0:07:22.03,0:07:25.60,Default,,0000,0000,0000,,Có lẽ virus không phát tác\Nchỉ bằng việc tải tập tin...
Dialogue: 0,0:07:25.60,0:07:28.37,Default,,0000,0000,0000,,Phải, sẽ chẳng có nghĩa lý gì nếu vô tình\Nphát tán nó...
Dialogue: 0,0:07:28.37,0:07:31.46,Default,,0000,0000,0000,,...và biến tất cả mọi người\Nthành Mười Một Cá Nhân.
Dialogue: 0,0:07:31.94,0:07:33.91,Default,,0000,0000,0000,,Có lẽ còn nhân tố nào khác\Ncan dự vào.
Dialogue: 0,0:07:35.31,0:07:36.30,Default,,0000,0000,0000,,Tiến triển tới đâu rồi?
Dialogue: 0,0:07:36.58,0:07:38.35,Default,,0000,0000,0000,,Bọn tôi chưa thu được\Nkết quả gì khả quan cả.
Dialogue: 0,0:07:38.35,0:07:40.62,Default,,0000,0000,0000,,Kế hoạch của Gohda mà Thiếu tá tình cờ phát hiện...
Dialogue: 0,0:07:40.62,0:07:43.11,Default,,0000,0000,0000,,...trong cuộc điều tra lặn sâu\Nhoàn toàn có cơ sở.
Dialogue: 0,0:07:43.92,0:07:46.62,Default,,0000,0000,0000,,Nó đã châm ngòi cho\Nthùng thuốc súng người tị nạn.
Dialogue: 0,0:07:46.86,0:07:49.02,Default,,0000,0000,0000,,Gã đó chắc chắn có tội,\Nkhông còn nghi ngờ gì nữa.
Dialogue: 0,0:07:49.66,0:07:54.60,Default,,0000,0000,0000,,Hơn nữa, hắn thuộc tuýp người luôn thèm khát\Nđể bên thứ ba biết mình là kẻ đứng sau.
Dialogue: 0,0:07:55.03,0:07:59.09,Default,,0000,0000,0000,,Nhưng chừng nào thứ này chưa phát tác,\Nta chẳng thể chứng minh nổi một lời nào.
Dialogue: 0,0:07:59.37,0:08:04.00,Default,,0000,0000,0000,,Ước gì ta có thể chạm tay vào bản gốc\Ncủa bài tiểu luận Mười Một Cá Nhân.
Dialogue: 0,0:08:04.44,0:08:08.17,Default,,0000,0000,0000,,Ừ, nhưng chưa ai từng tìm thấy bản sao nào,\Nngay cả trong các cuộc điều tra trước đây đúng không?
Dialogue: 0,0:08:09.41,0:08:11.85,Default,,0000,0000,0000,,Vậy thử tìm một bản in giấy\Nxem sao?
Dialogue: 0,0:08:12.41,0:08:15.01,Default,,0000,0000,0000,,Bản thảo gốc có thể vẫn còn trôi nổi\Nở đâu đó ngoài kia.
Dialogue: 0,0:08:15.48,0:08:16.65,Default,,0000,0000,0000,,Có lẽ cậu nói đúng...
Dialogue: 0,0:08:16.65,0:08:19.52,Default,,0000,0000,0000,,Tôi biết một nơi khả dĩ đấy.\NHãy tới đó xem cậu tìm được gì không.
Dialogue: 0,0:08:19.99,0:08:20.96,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:08:21.22,0:08:23.82,Default,,0000,0000,0000,,Được rồi, phần việc đó\Ntrông cậy vào cậu.
Dialogue: 0,0:08:24.13,0:08:26.80,Default,,0000,0000,0000,,Tôi và Borma sẽ thử chạy phân tích cấu trúc\Nmột lần nữa...
Dialogue: 0,0:08:26.80,0:08:29.03,Default,,0000,0000,0000,,...toàn bộ ký ức ngoài của Kawashima\Ntừ đầu đến chân.
Dialogue: 0,0:08:29.30,0:08:32.36,Default,,0000,0000,0000,,Vì hiện tại,\Nđây là manh mối duy nhất của chúng ta.
Dialogue: 0,0:08:32.77,0:08:35.13,Default,,0000,0000,0000,,Được rồi, nhờ hai người nhé.\NĐi thôi.
Dialogue: 0,0:08:51.82,0:08:53.12,Default,,0000,0000,0000,,Thôi đi.
Dialogue: 0,0:08:55.76,0:08:58.95,Default,,0000,0000,0000,,Hãy để dành cảm xúc đó\Ncho những việc chúng ta sắp làm.
Dialogue: 0,0:09:00.96,0:09:02.36,Default,,0000,0000,0000,,Tôi đồng ý.
Dialogue: 0,0:09:03.40,0:09:05.80,Default,,0000,0000,0000,,Có vẻ như những người khác\Nđang tới rồi.
Dialogue: 0,0:09:06.10,0:09:07.40,Default,,0000,0000,0000,,Không còn nhiều thời gian đâu.
Dialogue: 0,0:09:07.77,0:09:08.74,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:09:16.65,0:09:17.98,Default,,0000,0000,0000,,{\i1}Mất dấu rồi sao?{\i0}
Dialogue: 0,0:09:17.98,0:09:18.95,Default,,0000,0000,0000,,{\i1}Vâng, thưa Thiếu tá.{\i0}
Dialogue: 0,0:09:19.28,0:09:22.22,Default,,0000,0000,0000,,{\i1}Chúng tôi đã xác nhận qua hệ thống{\i0}\N{\i1}hồng ngoại của đường cao tốc...{\i0}
Dialogue: 0,0:09:22.22,0:09:24.71,Default,,0000,0000,0000,,{\i1}...rằng hắn đang hướng về Kagoshima.{\i0}
Dialogue: 0,0:09:25.39,0:09:29.05,Default,,0000,0000,0000,,{\i1}Chúng tôi nhận định có khả năng hắn đã rời xe{\i0}\N{\i1}và lẻn vào một chiếc xe tải chở hàng...{\i0}
Dialogue: 0,0:09:29.19,0:09:32.02,Default,,0000,0000,0000,,{\i1}...khi ghé vào trạm dừng chân, sau đó chiếc xe{\i0}\N{\i1}đã chuyển sang chế độ lái tự động.{\i0}
Dialogue: 0,0:09:33.06,0:09:37.09,Default,,0000,0000,0000,,{\i1}Có vẻ như nhân viên trung tâm giám sát{\i0}\N{\i1}đã bị đánh lừa và chỉ bám theo chiếc xe.{\i0}
Dialogue: 0,0:09:37.90,0:09:39.89,Default,,0000,0000,0000,,{\i1}Sau đó chiếc xe của hắn{\i0}\N{\i1}hướng về phía nào?{\i0}
Dialogue: 0,0:09:40.60,0:09:43.40,Default,,0000,0000,0000,,{\i1}Nó đã rẽ ở nút giao{\i0}\N{\i1}và đi về hướng Fukuoka.{\i0}
Dialogue: 0,0:09:44.37,0:09:46.67,Default,,0000,0000,0000,,{\i1}Thế còn việc hack vào A.I chiếc xe{\i0}\N{\i1}để truy vết ngược lại thì sao?{\i0}
Dialogue: 0,0:09:47.44,0:09:50.43,Default,,0000,0000,0000,,{\i1}Ngay khoảnh khắc chúng tôi tiếp cận,{\i0}\N{\i1}nó đã tự ngắt kết nối khỏi mạng.{\i0}
Dialogue: 0,0:09:51.38,0:09:54.37,Default,,0000,0000,0000,,{\i1}Ra là hắn cũng khá sành sỏi{\i0}\N{\i1}về tác chiến điện tử đấy nhỉ?{\i0}
Dialogue: 0,0:09:58.29,0:09:59.48,Default,,0000,0000,0000,,{\i1}Được lắm.{\i0}
Dialogue: 0,0:10:00.86,0:10:05.85,Default,,0000,0000,0000,,{\i1}Tôi muốn các cậu truy lùng tất cả xe chở hàng{\i0}\N{\i1}trong bức ảnh đó và xác định vị trí của hắn.{\i0}
Dialogue: 0,0:10:06.40,0:10:07.59,Default,,0000,0000,0000,,{\i1}Rõ, thưa Thiếu tá.{\i0}
Dialogue: 0,0:10:08.10,0:10:09.20,Default,,0000,0000,0000,,Giờ sao đây?
Dialogue: 0,0:10:09.20,0:10:10.49,Default,,0000,0000,0000,,Chúng ta đến\NKagoshima.
Dialogue: 0,0:10:10.57,0:10:13.53,Default,,0000,0000,0000,,Lỡ như đây là cái bẫy để ta tưởng\Nhắn tới đó thì sao?
Dialogue: 0,0:10:14.04,0:10:17.06,Default,,0000,0000,0000,,Nếu tính theo xác suất,\Nhắn chắc chắn đang tới Kagoshima.
Dialogue: 0,0:10:38.76,0:10:40.06,Default,,0000,0000,0000,,Đã đủ người chưa?
Dialogue: 0,0:10:41.36,0:10:46.39,Default,,0000,0000,0000,,Chẳng có ai chia sẻ ý chí cá nhân\Nlại đến trễ hơn lúc này cả.
Dialogue: 0,0:11:15.66,0:11:19.10,Default,,0000,0000,0000,,Trưởng phòng Aramaki cử tôi đến.\NTên tôi là Togusa.
Dialogue: 0,0:11:19.50,0:11:21.27,Default,,0000,0000,0000,,Ừ, cậu ấy có báo trước\Nvới tôi là cậu sẽ tới.
Dialogue: 0,0:11:21.27,0:11:24.47,Default,,0000,0000,0000,,Cậu ấy bảo cậu muốn xem bản gốc của cuốn\NMười Một Cá Nhân phải không?
Dialogue: 0,0:11:24.81,0:11:28.21,Default,,0000,0000,0000,,Vâng thưa giáo sư. Tôi không thể tìm thấy nó\Nở bất kỳ đâu trên mạng.
Dialogue: 0,0:11:28.88,0:11:30.37,Default,,0000,0000,0000,,Tôi không ngạc nhiên đâu.
Dialogue: 0,0:11:31.78,0:11:35.18,Default,,0000,0000,0000,,Thực tế là cuốn Mười Một Cá Nhân\Nlà một tác phẩm cực kỳ quý hiếm,
Dialogue: 0,0:11:35.18,0:11:37.17,Default,,0000,0000,0000,,chỉ có vỏn vẹn 20 bản in\Nđược xuất bản.
Dialogue: 0,0:11:37.79,0:11:39.92,Default,,0000,0000,0000,,Nó được viết ngay trước cái chết của Patrick Sylvestre,
Dialogue: 0,0:11:39.92,0:11:44.36,Default,,0000,0000,0000,,vào thời điểm ông ấy tham gia vào cuộc cách mạng Romania.
Dialogue: 0,0:11:45.23,0:11:50.22,Default,,0000,0000,0000,,Tôi đoán hiện nay có không ít bản dịch tái bản ngoài kia...
Dialogue: 0,0:11:50.70,0:11:55.30,Default,,0000,0000,0000,,Vâng, nhưng dường như chính tác giả\Nđã niêm phong bài tiểu luận đó...
Dialogue: 0,0:11:55.30,0:12:00.17,Default,,0000,0000,0000,,...vì ông ấy chưa từng coi Sự biến ngày 15 tháng 5 của Nhật Bản\Nlà một cuộc cách mạng thực thụ.
Dialogue: 0,0:12:00.68,0:12:04.58,Default,,0000,0000,0000,,Nhưng tôi nghe nói tư tưởng của ông ấy, như việc lấy kịch Noh\Nlàm ẩn dụ cho cách mạng,
Dialogue: 0,0:12:04.58,0:12:07.41,Default,,0000,0000,0000,,vẫn không hề mất đi giá trị sâu sắc,\Nngay cả ở thời đại này.
Dialogue: 0,0:12:09.02,0:12:12.08,Default,,0000,0000,0000,,Tôi thấy cậu không đến đây với thói khoe mẽ kiến thức.
Dialogue: 0,0:12:12.49,0:12:13.55,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:12:13.99,0:12:18.19,Default,,0000,0000,0000,,Aramaki đã đứng ra bảo lãnh cho cậu, nên tôi sẽ phá lệ\Ncho cậu xem cuốn sách đó.
Dialogue: 0,0:12:19.96,0:12:21.26,Default,,0000,0000,0000,,Tôi rất biết ơn giáo sư.
Dialogue: 0,0:12:25.53,0:12:26.73,Default,,0000,0000,0000,,{\i1}Tiến triển thế nào rồi?{\i0}
Dialogue: 0,0:12:26.80,0:12:29.46,Default,,0000,0000,0000,,{\i1}Có vẻ tôi đã tạo được{\i0}\N{\i1}lòng tin ở ông ấy rồi.{\i0}
Dialogue: 0,0:12:30.01,0:12:34.74,Default,,0000,0000,0000,,{\i1}Dù vậy, tôi thật sự bất ngờ khi sếp lại quen biết{\i0}\N{\i1}một giáo sư đại học già khó tính như ông cụ này đấy.{\i0}
Dialogue: 0,0:12:35.08,0:12:37.70,Default,,0000,0000,0000,,{\i1}Thời thế có thể đổi thay, nhưng mối quan hệ{\i0}\N{\i1}thì không bao giờ là thừa cả.{\i0}
Dialogue: 0,0:12:38.15,0:12:39.20,Default,,0000,0000,0000,,Cũng đúng thật...
Dialogue: 0,0:12:39.41,0:12:41.18,Default,,0000,0000,0000,,Lạ thật đấy.
Dialogue: 0,0:12:41.78,0:12:46.72,Default,,0000,0000,0000,,Từ lúc có nó đến giờ,\Ntôi chưa từng mang nó ra khỏi căn phòng này...
Dialogue: 0,0:12:47.72,0:12:53.13,Default,,0000,0000,0000,,Dạ, không nhất thiết phải là bản gốc đâu ạ.\NBản sao hay tái bản cũng được.
Dialogue: 0,0:12:53.53,0:12:57.12,Default,,0000,0000,0000,,Chẳng hiểu sao tôi lại không thấy nó\Nở đâu cả...
Dialogue: 0,0:13:17.25,0:13:20.28,Default,,0000,0000,0000,,Nhân tiện, anh đã cống hiến được gì\Ncho đại nghĩa của chúng ta?
Dialogue: 0,0:13:21.22,0:13:24.16,Default,,0000,0000,0000,,Việc duy nhất tôi làm là đâm chết\Nmột tên nghị viên phản bội...
Dialogue: 0,0:13:24.16,0:13:26.89,Default,,0000,0000,0000,,...kẻ luôn cổ xúy chính sách hòa giải\Nliên quan đến vấn đề người tị nạn.
Dialogue: 0,0:13:27.50,0:13:28.86,Default,,0000,0000,0000,,Còn anh thì sao?
Dialogue: 0,0:13:28.93,0:13:32.76,Default,,0000,0000,0000,,Bọn tôi đã lặn vào mạng kế toán của đài JNN-TV\Nvà dàn dựng như thể...
Dialogue: 0,0:13:33.07,0:13:36.53,Default,,0000,0000,0000,,...họ đang biển thủ tiền quyên góp\Nviện trợ cho người tị nạn.
Dialogue: 0,0:13:39.71,0:13:44.04,Default,,0000,0000,0000,,Chúng tôi đã hành động trực diện hơn\Ntrong lời kêu gọi giải phóng người tị nạn.
Dialogue: 0,0:13:45.41,0:13:48.42,Default,,0000,0000,0000,,Vụ đánh bom nhóm cứu trợ\N\"Hội Hồi hương Người tị nạn\".
Dialogue: 0,0:13:48.42,0:13:50.18,Default,,0000,0000,0000,,Đó là sự cống hiến của chúng tôi\Ncho đại nghĩa.
Dialogue: 0,0:13:50.49,0:13:53.58,Default,,0000,0000,0000,,Vụ đánh bom Hội Hồi hương Người tị nạn\Nđã tràn ngập trên các mặt báo,
Dialogue: 0,0:13:53.89,0:13:56.82,Default,,0000,0000,0000,,nhưng điều đó chỉ dẫn đến việc cắt đứt liên kết\Ngiữa những người tị nạn với nhau mà thôi.
Dialogue: 0,0:13:57.33,0:14:01.06,Default,,0000,0000,0000,,Chúng tôi đã diệt trừ một kẻ thù thực sự của quốc gia.\NMột kẻ phản bội đất nước.
Dialogue: 0,0:14:01.53,0:14:05.90,Default,,0000,0000,0000,,Mục tiêu của tôi là một tổ chức phi chính phủ chuyên cung cấp\Ncơ thể giả miễn phí cho dân tị nạn.
Dialogue: 0,0:14:06.53,0:14:09.03,Default,,0000,0000,0000,,Dù vụ đánh bom đó\Nđã kết thúc trong thất bại.
Dialogue: 0,0:14:09.40,0:14:12.04,Default,,0000,0000,0000,,Tôi thừa nhận giết kẻ thù quốc gia là việc đáng hoan nghênh,
Dialogue: 0,0:14:12.04,0:14:16.03,Default,,0000,0000,0000,,nhưng điều cốt lõi là phải chặt đứt phao cứu sinh\Ncủa những kẻ tị nạn cần được giải phóng.
Dialogue: 0,0:14:16.11,0:14:17.98,Default,,0000,0000,0000,,Vậy {\i1}anh{\i0}\Nđã làm được gì?
Dialogue: 0,0:14:18.81,0:14:21.51,Default,,0000,0000,0000,,Tôi đã lấy đầu của\Nchủ tịch một ngân hàng mạng.
Dialogue: 0,0:14:21.85,0:14:23.72,Default,,0000,0000,0000,,Anh chính là người đã sát hại\NChủ tịch Ichihiro Jima,
Dialogue: 0,0:14:23.72,0:14:28.06,Default,,0000,0000,0000,,nhà sáng lập ngân hàng mạng đã tích lũy khối tài sản kếch xù\Ndù xuất thân từ một kẻ tị nạn sao?!
Dialogue: 0,0:14:28.06,0:14:29.25,Default,,0000,0000,0000,,Chính là anh sao?!
Dialogue: 0,0:14:31.16,0:14:35.13,Default,,0000,0000,0000,,Tội trạng của tôi có thể không sánh bằng các anh về mặt\Nchặt đứt phao cứu sinh của người tị nạn,
Dialogue: 0,0:14:35.13,0:14:39.43,Default,,0000,0000,0000,,nhưng xét về mức độ chấn động dư luận,\Nthì chiến tích của tôi không thua kém bất cứ ai.
Dialogue: 0,0:14:40.17,0:14:43.76,Default,,0000,0000,0000,,Tôi chính là người đã giết chết\Nrapper mạng nổi tiếng Densetsu.
Dialogue: 0,0:14:44.24,0:14:46.11,Default,,0000,0000,0000,,Và một việc nữa.
Dialogue: 0,0:14:46.11,0:14:49.44,Default,,0000,0000,0000,,Tôi cũng chính là kẻ đã tung tin đồn rằng\Nngười tị nạn sắp sửa tiến hành...
Dialogue: 0,0:14:49.74,0:14:52.98,Default,,0000,0000,0000,,...một cuộc cướp phá thanh nhiên liệu đào được\Ntừ nhà máy điện hạt nhân bí mật của chính phủ.
Dialogue: 0,0:14:53.18,0:14:54.12,Default,,0000,0000,0000,,Ấn tượng đấy!
Dialogue: 0,0:14:54.12,0:14:58.88,Default,,0000,0000,0000,,Việc đó quả thực đã giáng một đòn tâm lý nặng nề\Nlên cả người dân lẫn dân tị nạn.
Dialogue: 0,0:14:59.09,0:15:02.99,Default,,0000,0000,0000,,Densetsu từng là chỗ dựa tinh thần\Ncho giới trẻ tị nạn.
Dialogue: 0,0:15:03.49,0:15:07.36,Default,,0000,0000,0000,,Khi mất đi cậu ta, ngọn lửa phẫn nộ bùng lên\Ntrong tim họ là điều tất yếu.
Dialogue: 0,0:15:08.00,0:15:10.56,Default,,0000,0000,0000,,Vừa làm điều đó, {\i1}lại vừa{\i0} tung tin giả\Nkích động một cuộc nổi dậy sao?
Dialogue: 0,0:15:10.93,0:15:14.83,Default,,0000,0000,0000,,So với những gì anh đã làm,\Nchiến tích của chúng tôi quả thực quá mờ nhạt.
Dialogue: 0,0:15:15.17,0:15:16.54,Default,,0000,0000,0000,,Thật đáng hổ thẹn...
Dialogue: 0,0:15:16.97,0:15:20.44,Default,,0000,0000,0000,,Nhưng xét theo nghĩa chặt đứt nguồn sống\Ncủa người tị nạn,
Dialogue: 0,0:15:20.44,0:15:24.28,Default,,0000,0000,0000,,thì việc chúng tôi tước đoạt mạng sống của tên bác sĩ\Nphản quốc kia cũng chẳng khác là bao.
Dialogue: 0,0:15:26.92,0:15:28.68,Default,,0000,0000,0000,,Thế còn {\i1}anh{\i0}, anh đã cống hiến gì\Ncho đại nghĩa?
Dialogue: 0,0:15:31.39,0:15:34.15,Default,,0000,0000,0000,,Tôi đã cố ám sát\NKayabuki.
Dialogue: 0,0:15:37.76,0:15:40.02,Default,,0000,0000,0000,,Tôi thấy anh đã chọn\Nmột phương thức táo bạo đấy.
Dialogue: 0,0:15:40.10,0:15:43.90,Default,,0000,0000,0000,,Nhưng tôi chưa từng nghe nói gì\Nvề cuộc tấn công đó cả.
Dialogue: 0,0:15:44.60,0:15:48.59,Default,,0000,0000,0000,,Có lẽ họ đã ém nhẹm nó đi, cũng như cách họ phớt lờ\Ntuyên bố nhận trách nhiệm của Mười Một Cá Nhân.
Dialogue: 0,0:15:49.17,0:15:51.16,Default,,0000,0000,0000,,Chuyện đó không quan trọng.
Dialogue: 0,0:15:51.44,0:15:54.84,Default,,0000,0000,0000,,Nhưng gác chuyện đó lại, sự giải phóng người tị nạn\Nmà các anh vừa nhắc đến...
Dialogue: 0,0:15:55.14,0:15:57.81,Default,,0000,0000,0000,,Dường như chẳng qua chỉ là ban phát\Nsự tuyệt vọng cho họ mà thôi.
Dialogue: 0,0:15:57.81,0:15:59.11,Default,,0000,0000,0000,,Tại sao lại như thế?
Dialogue: 0,0:16:01.25,0:16:04.42,Default,,0000,0000,0000,,Chúng ta cắt đứt sự hỗ trợ từ những kẻ phản quốc\Nvà từ chính những đồng bào của họ,
Dialogue: 0,0:16:04.42,0:16:06.82,Default,,0000,0000,0000,,để trao cho họ sự giải phóng\Ndưới hình thức tự lập.
Dialogue: 0,0:16:06.89,0:16:10.33,Default,,0000,0000,0000,,Bởi đó là phương thức hiệu quả nhất\Nbuộc người dân của chúng ta...
Dialogue: 0,0:16:10.33,0:16:13.73,Default,,0000,0000,0000,,...tự mình nhận thức được sự hiện diện\Ncủa những dị vật ngoại lai đó, chính là dân tị nạn.
Dialogue: 0,0:16:14.26,0:16:15.66,Default,,0000,0000,0000,,Anh không đồng ý sao?
Dialogue: 0,0:16:29.64,0:16:31.58,Default,,0000,0000,0000,,Này, Ishikawa.
Dialogue: 0,0:16:32.01,0:16:35.04,Default,,0000,0000,0000,,Cậu đã đọc hết các bài tiểu luận\Ncủa Sylvestre chưa?
Dialogue: 0,0:16:35.75,0:16:39.35,Default,,0000,0000,0000,,Rồi, trừ cuốn Mười Một Cá Nhân.\NSao cậu lại hỏi thế?
Dialogue: 0,0:16:39.45,0:16:43.22,Default,,0000,0000,0000,,Còn Sếp thì sao?\NThú thật là tôi chưa từng đọc qua.
Dialogue: 0,0:16:44.36,0:16:47.49,Default,,0000,0000,0000,,Tôi cũng đã đọc hết, ngoại trừ bài\NMười Một Cá Nhân.
Dialogue: 0,0:16:47.83,0:16:52.23,Default,,0000,0000,0000,,Thời buổi này chắc chẳng có mấy ai\Nđọc hết tất cả chúng đâu nhỉ.
Dialogue: 0,0:16:52.23,0:16:53.53,Default,,0000,0000,0000,,Chắc là\Nvậy rồi.
Dialogue: 0,0:16:54.27,0:16:57.24,Default,,0000,0000,0000,,Nhưng rõ ràng là cái gã\NKawashima kia đã đọc nó.
Dialogue: 0,0:16:57.47,0:17:00.28,Default,,0000,0000,0000,,Không những thế, hắn còn tải nó\Nvào ký ức ngoài...
Dialogue: 0,0:17:00.28,0:17:02.47,Default,,0000,0000,0000,,...và có lẽ đã học thuộc lòng\Nkhông sót một chữ nào.
Dialogue: 0,0:17:06.08,0:17:07.07,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:17:07.58,0:17:08.98,Default,,0000,0000,0000,,Chẳng lẽ là thứ đó sao?
Dialogue: 0,0:17:10.29,0:17:13.35,Default,,0000,0000,0000,,Đó chắc chắn là nhân tố\Nkhiến virus phát tác!
Dialogue: 0,0:17:14.86,0:17:16.12,Default,,0000,0000,0000,,Nhiều khả năng là vậy.
Dialogue: 0,0:17:18.16,0:17:21.03,Default,,0000,0000,0000,,Tachikoma. Tập hợp toàn bộ tập tin trong đó\Nliên quan đến tác phẩm...
Dialogue: 0,0:17:21.03,0:17:23.02,Default,,0000,0000,0000,,...\"Tuyển tập Sơ thảo Tiểu luận\Nvề Cách mạng\" của Sylvestre.
Dialogue: 0,0:17:23.33,0:17:24.39,Default,,0000,0000,0000,,Rõ ạ!
Dialogue: 0,0:17:40.95,0:17:43.01,Default,,0000,0000,0000,,Thiếu tá! Bọn tôi tìm thấy hắn rồi!
Dialogue: 0,0:17:43.59,0:17:47.75,Default,,0000,0000,0000,,Bức ảnh này được chụp lúc 2 giờ 32 phút chiều\Ntại Đài Tưởng niệm Tử sĩ Kagoshima.
Dialogue: 0,0:17:48.56,0:17:51.29,Default,,0000,0000,0000,,Được rồi, hướng thẳng tới\NĐài Tưởng niệm Tử sĩ!
Dialogue: 0,0:17:51.56,0:17:54.69,Default,,0000,0000,0000,,Rõ. Đang chuyển hướng tới\NĐài Tưởng niệm Tử sĩ.
Dialogue: 0,0:18:05.11,0:18:07.01,Default,,0000,0000,0000,,{\i1}Sếp, bên này tôi cũng chịu thua rồi.{\i0}
Dialogue: 0,0:18:07.41,0:18:10.28,Default,,0000,0000,0000,,{\i1}Ở đây cũng không có bản sao nào{\i0}\N{\i1}của cuốn Mười Một Cá Nhân cả.{\i0}
Dialogue: 0,0:18:10.98,0:18:15.44,Default,,0000,0000,0000,,{\i1}Nếu ở đó cũng không có, thì e là{\i0}\N{\i1}chúng ta chẳng còn nơi nào để tìm nữa.{\i0}
Dialogue: 0,0:18:15.55,0:18:17.64,Default,,0000,0000,0000,,{\i1}Togusa, tạm thời{\i0}\N{\i1}cậu hãy quay về đi.{\i0}
Dialogue: 0,0:18:18.09,0:18:20.25,Default,,0000,0000,0000,,Nếu cậu không tìm thấy, ở lại đó\Ncũng chẳng giải quyết được gì.
Dialogue: 0,0:18:20.56,0:18:21.54,Default,,0000,0000,0000,,{\i1}Vâng...{\i0}
Dialogue: 0,0:18:22.06,0:18:26.58,Default,,0000,0000,0000,,{\i1}Nhưng tôi vẫn còn nghĩ ra một nơi nữa.{\i0}\N{\i1}Tôi sẽ kiểm tra nốt rồi quay về.{\i0}
Dialogue: 0,0:18:26.66,0:18:27.69,Default,,0000,0000,0000,,{\i1}Được rồi.{\i0}
Dialogue: 0,0:18:27.76,0:18:29.20,Default,,0000,0000,0000,,Bọn em đã gom hết\Ntập tin rồi ạ!
Dialogue: 0,0:18:29.26,0:18:30.86,Default,,0000,0000,0000,,Được rồi. Cậu sẵn sàng\Nthử nghiệm chưa?
Dialogue: 0,0:18:31.10,0:18:31.93,Default,,0000,0000,0000,,Rồi.
Dialogue: 0,0:18:37.91,0:18:39.37,Default,,0000,0000,0000,,Sắp đến giờ rồi.
Dialogue: 0,0:18:40.34,0:18:42.57,Default,,0000,0000,0000,,Nhân tiện, ai sẽ là người\Nđọc bài diễn văn cuối cùng?
Dialogue: 0,0:18:43.18,0:18:47.55,Default,,0000,0000,0000,,Người lan tỏa ý chí của chúng ta xuất sắc nhất\Nsẽ là người thích hợp nhất.
Dialogue: 0,0:18:47.98,0:18:50.45,Default,,0000,0000,0000,,Vậy thì người đó chắc chắn\Nlà anh rồi.
Dialogue: 0,0:18:51.25,0:18:53.86,Default,,0000,0000,0000,,Dù tôi tin rằng có rất nhiều người\Nđã cống hiến cho đại nghĩa...
Dialogue: 0,0:18:53.86,0:18:56.69,Default,,0000,0000,0000,,...ngay cả trong số những đồng chí\Nkhông thể đến đây hôm nay,
Dialogue: 0,0:18:57.03,0:19:00.89,Default,,0000,0000,0000,,nhưng nếu mọi người đã đề cử, tôi xin vinh hạnh\Nđón nhận trọng trách cao cả này.
Dialogue: 0,0:19:03.03,0:19:04.73,Default,,0000,0000,0000,,Tôi cho rằng anh không có\Nphản đối gì chứ?
Dialogue: 0,0:19:05.33,0:19:08.96,Default,,0000,0000,0000,,Không. Nhưng tôi có\Nmột thỉnh cầu.
Dialogue: 0,0:19:09.70,0:19:11.73,Default,,0000,0000,0000,,Nếu không phiền,\Nliệu một trong số các anh...
Dialogue: 0,0:19:12.04,0:19:14.87,Default,,0000,0000,0000,,...có thể cho tôi xem cuốn kinh thánh của chúng ta,\Nbản thảo Mười Một Cá Nhân được không?
Dialogue: 0,0:19:15.31,0:19:17.14,Default,,0000,0000,0000,,Bản của anh có phải bản in đầu tiên không?
Dialogue: 0,0:19:18.21,0:19:19.30,Default,,0000,0000,0000,,Khoan đã.
Dialogue: 0,0:19:23.62,0:19:26.99,Default,,0000,0000,0000,,Nếu anh quan tâm đến số lần in,\Nthì bản của tôi chắc chắn là bản in đầu tiên.
Dialogue: 0,0:19:27.39,0:19:28.62,Default,,0000,0000,0000,,Anh có chắc không?
Dialogue: 0,0:19:28.72,0:19:29.92,Default,,0000,0000,0000,,C-Chắc chắn...
Dialogue: 0,0:19:32.63,0:19:35.65,Default,,0000,0000,0000,,Trước khi khởi hành tới đây hôm nay,\Ntôi đã định mang theo...
Dialogue: 0,0:19:35.96,0:19:39.23,Default,,0000,0000,0000,,...cuốn Mười Một Cá Nhân\Nnhét trong túi áo ngực.
Dialogue: 0,0:19:39.63,0:19:42.47,Default,,0000,0000,0000,,Nhưng dù có tìm kiếm kỹ đến đâu,\Ntôi cũng không thể tìm thấy nó.
Dialogue: 0,0:19:42.80,0:19:44.10,Default,,0000,0000,0000,,Tại sao tôi lại không tìm thấy chứ?!
Dialogue: 0,0:19:48.31,0:19:51.05,Default,,0000,0000,0000,,Xin các anh. Ai đó hãy cho tôi mượn\Nbản sao Mười Một...
Dialogue: 0,0:19:51.05,0:19:54.01,Default,,0000,0000,0000,,Này, chúng ta sắp tới nơi rồi.
Dialogue: 0,0:20:10.23,0:20:11.22,Default,,0000,0000,0000,,Ối!
Dialogue: 0,0:20:12.20,0:20:13.96,Default,,0000,0000,0000,,N-Này, anh là\Nngười ở...
Dialogue: 0,0:20:15.54,0:20:19.27,Default,,0000,0000,0000,,Trông anh có vẻ vội vã nhỉ. Thực ra,\Ntôi tới đây để hỏi anh một chuyện.
Dialogue: 0,0:20:19.27,0:20:20.40,Default,,0000,0000,0000,,Thật may là\Ngặp được anh!
Dialogue: 0,0:20:20.78,0:20:21.94,Default,,0000,0000,0000,,Đi với tôi mau!
Dialogue: 0,0:20:22.18,0:20:23.11,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:20:25.15,0:20:28.27,Default,,0000,0000,0000,,- Đừng làm thế! Bỏ xuống đi!\N- Xin anh, đừng làm vậy mà!
Dialogue: 0,0:20:29.95,0:20:31.28,Default,,0000,0000,0000,,Các người đang làm cái quái gì thế?!
Dialogue: 0,0:20:36.82,0:20:37.73,Default,,0000,0000,0000,,Có thấy gì bất thường không?
Dialogue: 0,0:20:37.73,0:20:39.82,Default,,0000,0000,0000,,Chẳng có gì khác lạ cả.
Dialogue: 0,0:20:39.89,0:20:44.59,Default,,0000,0000,0000,,Có lẽ chúng ta thực sự cần bản gốc\Ncủa bài tiểu luận cuối cùng.
Dialogue: 0,0:20:49.70,0:20:50.83,Default,,0000,0000,0000,,Cái quái gì...?
Dialogue: 0,0:20:54.88,0:20:55.71,Default,,0000,0000,0000,,Ishikawa!
Dialogue: 0,0:20:58.68,0:20:59.65,Default,,0000,0000,0000,,Borma!
Dialogue: 0,0:21:07.79,0:21:11.95,Default,,0000,0000,0000,,Tachikoma! Ngắt toàn bộ hoạt động não điện tử\Ncủa Borma và giữ cho cậu ta bất tỉnh ngay!
Dialogue: 0,0:21:12.79,0:21:17.09,Default,,0000,0000,0000,,Sau đó đánh dấu tập tin vừa rồi là \"Cấm mở\"\Nvà khóa chặt nó sau mảng tường phòng thủ!
Dialogue: 0,0:21:17.30,0:21:18.32,Default,,0000,0000,0000,,Rõ ạ!
Dialogue: 0,0:21:18.67,0:21:20.83,Default,,0000,0000,0000,,Có vẻ như chúng ta\Nđã trúng quả đậm rồi...
Dialogue: 0,0:21:21.40,0:21:22.49,Default,,0000,0000,0000,,{\i1}Sếp.{\i0}
Dialogue: 0,0:21:22.74,0:21:24.83,Default,,0000,0000,0000,,{\i1}Sếp có cuộc gọi khẩn{\i0}\N{\i1}từ Bộ Nội vụ.{\i0}
Dialogue: 0,0:21:26.21,0:21:27.61,Default,,0000,0000,0000,,Chuyển tiếp ngay\Nvào Phòng Lặn!
Dialogue: 0,0:21:27.61,0:21:28.60,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:21:37.05,0:21:38.21,Default,,0000,0000,0000,,Cái quái...
Dialogue: 0,0:21:40.76,0:21:43.32,Default,,0000,0000,0000,,Rốt cuộc tên đó làm cái quái gì\Nở dưới này thế?
Dialogue: 0,0:21:44.19,0:21:48.65,Default,,0000,0000,0000,,{\i1}Thiếu tá, tới ngay tháp truyền hình Kyushu!{\i0}\N{\i1}Hắn đã xuất hiện ở đó!{\i0}
Dialogue: 0,0:21:49.03,0:21:50.20,Default,,0000,0000,0000,,Chuyện gì đang xảy ra thế?
Dialogue: 0,0:21:50.20,0:21:53.93,Default,,0000,0000,0000,,{\i1}Tôi cũng không rõ, nhưng họ đang chiếu hình hắn{\i0}\N{\i1}trên kênh 33!{\i0}
Dialogue: 0,0:21:57.14,0:21:57.94,Default,,0000,0000,0000,,Họ tìm thấy hắn rồi sao?
Dialogue: 0,0:21:57.94,0:22:01.17,Default,,0000,0000,0000,,{\i1}Này, quay được chưa? Hả?{\i0}\N{\i1}Họ nói gì cơ? Chĩa ống kính vào hắn mau!{\i0}
Dialogue: 0,0:22:01.28,0:22:02.40,Default,,0000,0000,0000,,Cái quái gì thế...?
Dialogue: 0,0:22:03.68,0:22:05.54,Default,,0000,0000,0000,,{\i1}Kiếm! Bọn họ đang vung kiếm,{\i0}\N{\i1}và...{\i0}
Dialogue: 0,0:22:06.25,0:22:09.55,Default,,0000,0000,0000,,{\i1}Đầu của họ! Họ vừa chém bay đầu{\i0}\N{\i1}của nhau kìa!{\i0}
Dialogue: 0,0:22:09.82,0:22:11.81,Default,,0000,0000,0000,,{\i1}Từng người một, họ...{\i0}\N{\i1}Họ đang tàn sát lẫn nhau!{\i0}
Dialogue: 0,0:22:13.19,0:22:14.66,Default,,0000,0000,0000,,{\i1}Một cảnh tượng không thể tin nổi!{\i0}
Dialogue: 0,0:22:14.66,0:22:18.52,Default,,0000,0000,0000,,{\i1}Những người đàn ông xuất hiện trên nóc tòa nhà{\i0}\N{\i1}dường như đã dùng kiếm chém chết lẫn nhau!{\i0}
Dialogue: 0,0:22:19.06,0:22:21.76,Default,,0000,0000,0000,,Được rồi, bình tĩnh lại đi.\NTôi tới đây chỉ để nói chuyện thôi.
Dialogue: 0,0:22:21.76,0:22:22.79,Default,,0000,0000,0000,,Tránh xa tôi ra.
Dialogue: 0,0:22:22.86,0:22:26.20,Default,,0000,0000,0000,,Anh có biết về bài tiểu luận có tên\NMười Một Cá Nhân đúng không?
Dialogue: 0,0:22:26.53,0:22:30.94,Default,,0000,0000,0000,,Chưa từng có bài tiểu luận nào tên Mười Một Cá Nhân cả!\NNó chưa từng tồn tại!
Dialogue: 0,0:22:32.07,0:22:36.41,Default,,0000,0000,0000,,Tất cả những gì tồn tại chỉ là một hệ tư tưởng ngụy tạo\Nđược gán cái tên Mười Một Cá Nhân mà thôi!
Dialogue: 0,0:22:38.25,0:22:42.05,Default,,0000,0000,0000,,Ta chính là Mười Một Cá Nhân!\NThời khắc cuối cùng cũng đã đến!
Dialogue: 0,0:22:48.42,0:22:50.22,Default,,0000,0000,0000,,Gọi xe cứu thương mau!\NNhanh lên!
Dialogue: 0,0:22:50.22,0:22:52.22,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:55.66,0:24:01.47,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:01.47,0:24:04.17,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:04.17,0:24:08.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
