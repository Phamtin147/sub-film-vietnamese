Dialogue: 0,0:01:32.04,0:01:34.10,Default,,0000,0000,0000,,Này, nhìn cái này đi!
Dialogue: 0,0:01:34.48,0:01:37.42,Default,,0000,0000,0000,,Tớ vừa tìm thấy một tập tin tuyệt mật\Nvề Mười Một Cá Nhân...
Dialogue: 0,0:01:37.48,0:01:39.79,Default,,0000,0000,0000,,...trong cụm máy chủ\Ncủa Cơ quan Cảnh sát Quốc gia này!
Dialogue: 0,0:01:39.79,0:01:41.41,Default,,0000,0000,0000,,Thật á? Cho xem với!\NCho xem với!
Dialogue: 0,0:01:41.49,0:01:42.68,Default,,0000,0000,0000,,Cái này thú vị thật đấy...
Dialogue: 0,0:01:42.76,0:01:43.41,Default,,0000,0000,0000,,Để xem nào...
Dialogue: 0,0:01:43.49,0:01:44.58,Default,,0000,0000,0000,,Tớ cũng muốn xem nữa!
Dialogue: 0,0:01:44.66,0:01:45.49,Default,,0000,0000,0000,,Nó ở đâu thế?
Dialogue: 0,0:01:45.56,0:01:46.35,Default,,0000,0000,0000,,Là cái này nè.
Dialogue: 0,0:01:46.46,0:01:48.02,Default,,0000,0000,0000,,Khâm phục cậu thật đấy,\Ntìm ra được cái này luôn.
Dialogue: 0,0:01:48.26,0:01:49.99,Default,,0000,0000,0000,,Ước gì mình cũng được\Nxem một chút...
Dialogue: 0,0:01:50.06,0:01:53.50,Default,,0000,0000,0000,,Thôi nào các nhóc. Đừng có tùy tiện lặn vào\Nnhững nơi như thế mà chưa xin phép chứ.
Dialogue: 0,0:01:53.70,0:01:56.07,Default,,0000,0000,0000,,Chẳng thứ gì trên đời này\Nngăn nổi trí tò mò của tụi nó đâu.
Dialogue: 0,0:01:56.40,0:01:59.03,Default,,0000,0000,0000,,Nếu tụi nó va phải dữ liệu không phù hợp,\Nta chỉ việc xóa đi là xong.
Dialogue: 0,0:01:59.44,0:02:01.46,Default,,0000,0000,0000,,Ưu tiên hàng đầu của chúng ta\Nlà bảo trì phần cứng.
Dialogue: 0,0:02:03.04,0:02:04.98,Default,,0000,0000,0000,,Sếp chiều chuộng tụi nó\Nquá mức rồi đấy ạ.
Dialogue: 0,0:02:05.91,0:02:08.28,Default,,0000,0000,0000,,Thật không tin nổi sếp lại bị tụi nó mua chuộc\Nbằng món quà lưu niệm như thế...
Dialogue: 0,0:02:11.82,0:02:15.91,Default,,0000,0000,0000,,Một người đàn ông mặc áo blouse đỏ...\Nđang ăn bánh đậu đỏ.
Dialogue: 0,0:02:16.96,0:02:20.65,Default,,0000,0000,0000,,Người đàn ông hảo ngọt...\Nquá ngọt ngào.
Dialogue: 0,0:02:22.76,0:02:24.59,Default,,0000,0000,0000,,Câu đùa đó chẳng buồn cười chút nào.
Dialogue: 0,0:02:36.48,0:02:38.67,Default,,0000,0000,0000,,Có vẻ mấy đứa trong này\Nđang vui vẻ gớm nhỉ.
Dialogue: 0,0:02:39.48,0:02:40.71,Default,,0000,0000,0000,,Chú Batou!
Dialogue: 0,0:02:40.78,0:02:43.04,Default,,0000,0000,0000,,Tụi bay không lại giở trò nghịch ngợm\Nnhư mọi khi đấy chứ?
Dialogue: 0,0:02:43.35,0:02:45.94,Default,,0000,0000,0000,,Chú làm tụi cháu tổn thương đấy Togusa!\NNghịch ngợm á... làm gì có!
Dialogue: 0,0:02:46.42,0:02:50.58,Default,,0000,0000,0000,,Tụi cháu đang điều tra về Mười Một Cá Nhân\Ntheo cách riêng của tụi cháu mà.
Dialogue: 0,0:02:50.92,0:02:53.36,Default,,0000,0000,0000,,Ý cháu là, các chú còn chẳng thể tạo ra vắc-xin\Ncho con virus mà chú Borma tìm thấy...
Dialogue: 0,0:02:53.43,0:02:56.90,Default,,0000,0000,0000,,...chỉ vì không xác định được\Nnhân tố kích hoạt nó đúng không?
Dialogue: 0,0:02:56.90,0:02:57.79,Default,,0000,0000,0000,,Đúng rồi, đúng rồi...
Dialogue: 0,0:02:57.86,0:02:59.96,Default,,0000,0000,0000,,Ờ thì, đúng là vậy thật.
Dialogue: 0,0:03:00.03,0:03:01.23,Default,,0000,0000,0000,,Thấy chưa ạ?
Dialogue: 0,0:03:01.30,0:03:04.53,Default,,0000,0000,0000,,Nên tụi cháu đã thử rà soát qua\Ndữ liệu của bên cảnh sát.
Dialogue: 0,0:03:05.04,0:03:08.27,Default,,0000,0000,0000,,Các chú nhìn xem này! Tụi cháu đã kiểm tra 11 kẻ\Ntự sát tập thể đó,
Dialogue: 0,0:03:08.34,0:03:11.33,Default,,0000,0000,0000,,và thấy chúng có rất nhiều điểm tương đồng,\Nkể cả về công việc trước đây.
Dialogue: 0,0:03:11.74,0:03:14.24,Default,,0000,0000,0000,,Cựu sĩ quan Lục quân Phòng vệ, cảnh sát,\Nvà cả lính đánh thuê nữa.
Dialogue: 0,0:03:14.45,0:03:19.35,Default,,0000,0000,0000,,Và một điểm không thể bỏ qua là mỗi tên đều có\Nmức độ cơ khí hóa cơ thể trên 50%.
Dialogue: 0,0:03:19.55,0:03:24.51,Default,,0000,0000,0000,,Ngoài ra, họ bảo có khoảng 20.000 người mang mầm bệnh\Nmà họ nắm được thông tin, đúng chứ ạ?
Dialogue: 0,0:03:24.62,0:03:26.99,Default,,0000,0000,0000,,Nếu chúng ta không nhanh chóng\Ntạo ra vắc-xin,
Dialogue: 0,0:03:26.99,0:03:32.33,Default,,0000,0000,0000,,thì không có gì đảm bảo sẽ không có thêm nạn nhân\Nnhư gã phóng viên mà chú Togusa đã gặp đâu.
Dialogue: 0,0:03:34.07,0:03:36.33,Default,,0000,0000,0000,,Đó không phải việc của mấy đứa.
Dialogue: 0,0:03:36.64,0:03:37.86,Default,,0000,0000,0000,,Ơ, nhưng mà...
Dialogue: 0,0:03:38.14,0:03:42.84,Default,,0000,0000,0000,,Bọn tôi đã nhờ cơ sở Spring-8 chịu trách nhiệm\Nkhám nghiệm thi thể của đám Mười Một Cá Nhân.
Dialogue: 0,0:03:43.94,0:03:48.04,Default,,0000,0000,0000,,Nên bọn tôi đang trên đường tới đó\Nđể hội quân với Thiếu tá.
Dialogue: 0,0:03:48.85,0:03:52.37,Default,,0000,0000,0000,,Thiếu tá bảo dắt theo\Nmột đứa trong các cậu.
Dialogue: 0,0:03:52.92,0:03:55.25,Default,,0000,0000,0000,,- Ôi, nghe vui thế!\N- Cho cháu đi với, cho cháu đi với!
Dialogue: 0,0:03:55.82,0:03:58.69,Default,,0000,0000,0000,,Nhưng chắc không đứa nào đi được đâu\Nnếu chưa xong lượt kiểm tra bảo trì.
Dialogue: 0,0:03:58.76,0:04:02.28,Default,,0000,0000,0000,,Cháu ở đây! Cháu ở đây!\NCháu đã bảo trì xong rồi ạ!
Dialogue: 0,0:04:03.63,0:04:05.69,Default,,0000,0000,0000,,Xong rồi hả?\NĐược, đi thôi.
Dialogue: 0,0:04:05.80,0:04:06.86,Default,,0000,0000,0000,,Tuân lệnh sếp!
Dialogue: 0,0:04:06.93,0:04:08.56,Default,,0000,0000,0000,,Biết ngay mà, lại là con Tachikoma\Nruột của ổng.
Dialogue: 0,0:04:13.34,0:04:15.64,Default,,0000,0000,0000,,Hả? Này!
Dialogue: 0,0:04:16.41,0:04:18.34,Default,,0000,0000,0000,,Chờ tớ với chứ!
Dialogue: 0,0:04:21.28,0:04:22.71,Default,,0000,0000,0000,,Chuyện gì thế này?
Dialogue: 0,0:04:25.18,0:04:27.05,Default,,0000,0000,0000,,Mình còn chưa kịp tra dầu\Ncho nó nữa...
Dialogue: 0,0:04:30.89,0:04:34.45,Default,,0000,0000,0000,,Thế này là thế nào chứ?!\NLúc nào cậu ấy cũng được đi hết á!
Dialogue: 0,0:04:34.53,0:04:35.82,Default,,0000,0000,0000,,Lạ thật đấy...
Dialogue: 0,0:04:36.03,0:04:39.46,Default,,0000,0000,0000,,Kể từ khi được đổi sang cơ thể mới này,\Ntụi mình đâu còn được tra dầu tự nhiên nữa,
Dialogue: 0,0:04:39.73,0:04:43.53,Default,,0000,0000,0000,,thế sao cậu ấy vẫn giữ vững vị trí\Nlà cỗ máy cưng của chú Batou nhỉ?
Dialogue: 0,0:04:44.27,0:04:46.90,Default,,0000,0000,0000,,Và tớ còn có cảm giác là sự phân hóa cá tính\Ngiữa tụi mình...
Dialogue: 0,0:04:46.97,0:04:48.94,Default,,0000,0000,0000,,...thậm chí còn rõ rệt hơn\Nhồi trước nữa cơ.
Dialogue: 0,0:04:49.21,0:04:51.97,Default,,0000,0000,0000,,Này Proto, anh nghĩ lý do\Nlà vì sao thế?
Dialogue: 0,0:04:52.38,0:04:54.28,Default,,0000,0000,0000,,Tôi cũng không rõ nữa.
Dialogue: 0,0:04:54.65,0:04:58.31,Default,,0000,0000,0000,,Có thể là vì bọn tôi đã thiết lập\Nmột máy chủ chính cho các cậu,
Dialogue: 0,0:04:58.38,0:05:02.55,Default,,0000,0000,0000,,và các cậu đã được lập trình lại để lưu trữ\Nthông tin cá nhân một cách độc lập.
Dialogue: 0,0:05:05.79,0:05:08.12,Default,,0000,0000,0000,,Mấy đứa liệu mà ngoan ngoãn\Nngồi yên đi!
Dialogue: 0,0:05:08.49,0:05:10.49,Default,,0000,0000,0000,,Nếu không thì chẳng bao giờ\Nbảo trì xong đâu!
Dialogue: 0,0:05:24.68,0:05:27.51,Default,,0000,0000,0000,,Nói chuyện ở đây thì không bị ai quấy rầy\Nđúng không?
Dialogue: 0,0:05:27.58,0:05:29.95,Default,,0000,0000,0000,,Ừ. Mà ở đây thời gian trôi qua\Ncũng chẳng áp dụng được đâu.
Dialogue: 0,0:05:30.12,0:05:32.02,Default,,0000,0000,0000,,Dù sao thì, quay lại chuyện\Ntớ vừa nói lúc nãy,
Dialogue: 0,0:05:32.08,0:05:35.35,Default,,0000,0000,0000,,gác lại đám Mười Một Cá Nhân bị cho là\Nđã phát tác triệu chứng virus sang một bên,
Dialogue: 0,0:05:35.65,0:05:37.49,Default,,0000,0000,0000,,các cậu nghĩ sao về\Nnhững \"kẻ theo chủ nghĩa cá nhân\" này?
Dialogue: 0,0:05:37.79,0:05:41.42,Default,,0000,0000,0000,,Là những kẻ luôn đề cao tầm quan trọng của cá tính,\Nnhưng các cậu không thấy chúng hoàn toàn {\i1}thiếu nó{\i0} sao?
Dialogue: 0,0:05:42.06,0:05:43.26,Default,,0000,0000,0000,,Đúng là như thế thật.
Dialogue: 0,0:05:43.50,0:05:45.93,Default,,0000,0000,0000,,Chúng có thể bảo rằng chúng tìm kiếm giá trị\Ntrong sự khác biệt cá nhân...
Dialogue: 0,0:05:46.00,0:05:49.06,Default,,0000,0000,0000,,...bằng cách tìm kiếm sự cô lập trên mạng\Nhay bằng chứng cho sự tồn tại của bản thân,
Dialogue: 0,0:05:49.47,0:05:52.56,Default,,0000,0000,0000,,nhưng nỗ lực bài xích những người\Ncó tư tưởng khác biệt...
Dialogue: 0,0:05:52.67,0:05:54.94,Default,,0000,0000,0000,,...lại chính là nhân tố trói buộc tất cả bọn chúng\Nlại với nhau, các cậu không thấy thế sao?
Dialogue: 0,0:05:55.04,0:05:56.30,Default,,0000,0000,0000,,Ừ, cậu nói chuẩn đấy!
Dialogue: 0,0:05:56.48,0:05:58.71,Default,,0000,0000,0000,,Tớ nghĩ chúng là một tập thể {\i1}trông như{\i0}\Ncó bản sắc riêng, nhưng thực chất lại chẳng có.
Dialogue: 0,0:05:58.78,0:06:00.61,Default,,0000,0000,0000,,Chúng là những kẻ cố gắng tìm kiếm cá tính\Nđến mức tuyệt vọng...
Dialogue: 0,0:06:00.68,0:06:02.67,Default,,0000,0000,0000,,...để rồi rơi vào trạng thái\Nhoàn toàn phi cá tính.
Dialogue: 0,0:06:02.75,0:06:06.78,Default,,0000,0000,0000,,Theo một nghĩa nào đó, tớ cảm thấy\Nnhững kẻ này hoàn toàn trái ngược với tụi mình.
Dialogue: 0,0:06:06.89,0:06:07.91,Default,,0000,0000,0000,,Tớ cũng nghĩ vậy.
Dialogue: 0,0:06:08.19,0:06:10.55,Default,,0000,0000,0000,,Dù tụi mình có nghĩa vụ phải đồng bộ hóa\Nvới nhau liên tục,
Dialogue: 0,0:06:10.66,0:06:13.18,Default,,0000,0000,0000,,nhưng tụi mình vẫn bằng cách nào đó\Ncó được cá tính riêng từ một thời điểm nào đấy.
Dialogue: 0,0:06:13.59,0:06:17.08,Default,,0000,0000,0000,,Và giờ đây khi mọi người đã tôn trọng\Nnhững khác biệt đó như bản sắc riêng,
Dialogue: 0,0:06:17.23,0:06:20.13,Default,,0000,0000,0000,,tụi mình chỉ cần đồng bộ\Nnhững thông tin quan trọng mà thôi.
Dialogue: 0,0:06:21.50,0:06:25.30,Default,,0000,0000,0000,,Nếu đúng như vậy, và những kẻ theo chủ nghĩa cá nhân này\Nđã trở thành một tập thể không có bản sắc riêng...
Dialogue: 0,0:06:25.40,0:06:28.10,Default,,0000,0000,0000,,...chính vì chúng {\i1}cố gắng{\i0}\Ntrở thành những cá nhân riêng biệt,
Dialogue: 0,0:06:28.47,0:06:33.14,Default,,0000,0000,0000,,thì ai mới là kẻ đưa ra quyết định\Ncho tập thể đó như một thực thể phức hợp?
Dialogue: 0,0:06:33.35,0:06:36.55,Default,,0000,0000,0000,,Xét riêng về Mười Một Cá Nhân, tớ cho rằng\Nkẻ đưa ra quyết định...
Dialogue: 0,0:06:36.55,0:06:38.61,Default,,0000,0000,0000,,...chính là Gohda của Cục Tình báo Nội các.
Dialogue: 0,0:06:38.68,0:06:41.88,Default,,0000,0000,0000,,Nhưng người ta bảo đám khủng bố tấn công Đại sứ quán Trung Quốc\Nlà những kẻ theo chủ nghĩa cá nhân...
Dialogue: 0,0:06:41.95,0:06:46.45,Default,,0000,0000,0000,,...tự mình xuất hiện, chứ không phải do virus\Nhay bất cứ thứ gì kích hoạt, nhớ không?
Dialogue: 0,0:06:46.73,0:06:50.32,Default,,0000,0000,0000,,Phải thừa nhận rằng, vài nhà xã hội học cho rằng\Nnhững kẻ bắt chước xuất hiện hàng loạt...
Dialogue: 0,0:06:50.40,0:06:53.30,Default,,0000,0000,0000,,...trong vụ Án Người Cười mới chính là cội nguồn thực sự\Ncủa hiện tượng này.
Dialogue: 0,0:06:53.73,0:06:59.17,Default,,0000,0000,0000,,Nếu đúng là thế, chẳng phải điều đó đồng nghĩa với việc\Ntrong tâm trí, họ đã chia sẻ một viễn cảnh chung...
Dialogue: 0,0:06:59.24,0:07:03.27,Default,,0000,0000,0000,,...tương tự như tình hình hiện tại ngay từ trước khi\NGohda bắt tay vào kế hoạch của hắn sao?
Dialogue: 0,0:07:03.58,0:07:06.60,Default,,0000,0000,0000,,Biến việc trục xuất người tị nạn thành đồng thuận chung\Ncủa toàn thể công dân sao?
Dialogue: 0,0:07:06.81,0:07:09.84,Default,,0000,0000,0000,,Nếu cậu nói như thế, thì có nghĩa là\Nnhững người tị nạn vốn đã...
Dialogue: 0,0:07:09.92,0:07:13.65,Default,,0000,0000,0000,,...thực hiện các hành vi khủng bố ngay trước khi\NMười Một Cá Nhân xuất hiện rồi đúng không?
Dialogue: 0,0:07:13.95,0:07:17.29,Default,,0000,0000,0000,,Lạ lùng thật đấy. Dù chẳng có ai\Nra lệnh chỉ huy,
Dialogue: 0,0:07:17.36,0:07:20.02,Default,,0000,0000,0000,,nhưng tất cả các bên liên quan đều tự phát\Nchuyển động theo cùng một hướng.
Dialogue: 0,0:07:20.29,0:07:22.99,Default,,0000,0000,0000,,Hoặc có lẽ con người sở hữu một bản sắc thứ ba\Nđể đưa ra các quyết định.
Dialogue: 0,0:07:23.06,0:07:26.00,Default,,0000,0000,0000,,Một thứ gì đó nằm ngoài cá nhân\Nvà tập thể.
Dialogue: 0,0:07:26.33,0:07:27.76,Default,,0000,0000,0000,,Ý cậu là sao?
Dialogue: 0,0:07:31.17,0:07:34.50,Default,,0000,0000,0000,,Chẳng hạn như Dawkins, người đã tìm kiếm\Nsự phát triển của bản ngã...
Dialogue: 0,0:07:34.57,0:07:36.40,Default,,0000,0000,0000,,...trong các gen\Nở cấp độ vi mô,
Dialogue: 0,0:07:36.48,0:07:40.31,Default,,0000,0000,0000,,và Lovelock, người tập trung vào cấp độ cực kỳ vĩ mô,\Ntrên một thực thể quy mô tầm Trái Đất.
Dialogue: 0,0:07:39.11,0:07:40.71,Top Secondary Dialog 1080P,,0000,0000,0000,,Sinh quyển Trái Đất!
Dialogue: 0,0:07:40.31,0:07:43.41,Default,,0000,0000,0000,,Cả hai người họ xuất bản các công trình nghiên cứu\Nvào gần như cùng một thời điểm,
Dialogue: 0,0:07:43.48,0:07:45.32,Default,,0000,0000,0000,,dù có chủ đề đối lập nhau,\Nnhưng có thể nói...
Dialogue: 0,0:07:45.32,0:07:46.82,Top Secondary Dialog 1080P,,0000,0000,0000,,Cuốn này! Cuốn này nè!
Dialogue: 0,0:07:45.32,0:07:47.81,Default,,0000,0000,0000,,...đều đã đi đến gần như cùng một kết luận.
Dialogue: 0,0:07:47.89,0:07:49.44,Default,,0000,0000,0000,,Trong đó viết những thứ gì thế?
Dialogue: 0,0:07:49.59,0:07:51.72,Default,,0000,0000,0000,,Tớ đoán là về việc con người\Nlà thực thể logic nhất,
Dialogue: 0,0:07:51.79,0:07:53.55,Default,,0000,0000,0000,,cũng như là đơn vị nhỏ nhất sở hữu ý thức,
Dialogue: 0,0:07:53.86,0:07:57.52,Default,,0000,0000,0000,,và cả hai đều giả định rồi đề cập đến sự tồn tại\Ncủa cấu trúc chỉnh thể...
Dialogue: 0,0:07:57.60,0:08:00.79,Default,,0000,0000,0000,,...về một giống loài vừa vĩ đại hơn\Nlại vừa nhỏ bé hơn chính bản thân nó.
Dialogue: 0,0:08:00.87,0:08:03.53,Default,,0000,0000,0000,,Nói cách khác, họ ngầm ám chỉ rằng\Nnhân tố đang quyết định...
Dialogue: 0,0:08:03.64,0:08:06.04,Default,,0000,0000,0000,,...hành động của cả những kẻ theo chủ nghĩa cá nhân\Nvà người tị nạn...
Dialogue: 0,0:08:06.10,0:08:08.94,Default,,0000,0000,0000,,...hoặc là tồn tại ở cấp độ vi mô\Nnhỏ hơn từng cá nhân,
Dialogue: 0,0:08:09.01,0:08:11.91,Default,,0000,0000,0000,,hoặc là ở cấp độ vĩ mô,\Nvĩ đại hơn cả một tập thể.
Dialogue: 0,0:08:12.01,0:08:13.24,Default,,0000,0000,0000,,Trời đất, khó hiểu\Nquá đi...
Dialogue: 0,0:08:13.31,0:08:14.64,Default,,0000,0000,0000,,Đơn giản lắm!
Dialogue: 0,0:08:14.75,0:08:19.41,Default,,0000,0000,0000,,Nghĩa là như hiện tại, mạng lưới, thứ vốn chưa từng tồn tại\Ntrước khi loài người khai sinh ra nó,
Dialogue: 0,0:08:19.52,0:08:25.51,Default,,0000,0000,0000,,đang cấu thành một cách lỏng lẻo một tiềm thức chung\Ndưới dạng đồng thuận của toàn thể...
Dialogue: 0,0:08:25.89,0:08:29.49,Default,,0000,0000,0000,,...thông qua mạng lưới tâm trí và mạng điện tử\Nhiện đang bao phủ phần lớn Trái Đất.
Dialogue: 0,0:08:29.56,0:08:31.79,Default,,0000,0000,0000,,...tạo nên một tiềm thức lỏng lẻo dưới dạng\Nđồng thuận chung của toàn thể nhân loại!
Dialogue: 0,0:08:31.86,0:08:32.76,Default,,0000,0000,0000,,Cậu hiểu chưa hả?
Dialogue: 0,0:08:32.83,0:08:37.77,Default,,0000,0000,0000,,Vậy ý cậu là, thân xác và tâm trí con người\Nvốn dĩ đã là hai thứ tách biệt,
Dialogue: 0,0:08:37.84,0:08:40.30,Default,,0000,0000,0000,,nhưng chính họ lại\Nchưa nhận ra điều đó sao?
Dialogue: 0,0:08:40.51,0:08:42.37,Default,,0000,0000,0000,,Theo quan điểm thẳng thắn,\Ncá nhân tớ thì đúng là như vậy.
Dialogue: 0,0:08:43.48,0:08:46.88,Default,,0000,0000,0000,,Nhưng tụi mình từng nghiêng về kết luận rằng\Nthân xác và tâm trí là bất khả phân ly mà!
Dialogue: 0,0:08:46.95,0:08:48.71,Default,,0000,0000,0000,,Sự thay đổi suy nghĩ này\Nquay ngoắt 180 độ luôn rồi!
Dialogue: 0,0:08:48.78,0:08:53.11,Default,,0000,0000,0000,,Nếu quả đúng là như vậy, thì điều đó có nghĩa\NGohda đã cố tình chế tạo ra...
Dialogue: 0,0:08:53.15,0:08:55.88,Default,,0000,0000,0000,,...những mắt xích trung gian nhằm đẩy nhanh\Ntiến trình chậm chạp đó sao?
Dialogue: 0,0:08:56.86,0:08:58.19,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:09:03.33,0:09:05.85,Default,,0000,0000,0000,,Tôi xong rồi đấy.\NMau vào thế chỗ tôi đi.
Dialogue: 0,0:09:06.33,0:09:09.36,Default,,0000,0000,0000,,Xin lỗi anh nhé. Cuộc thảo luận của tụi cháu\Nhơi bị hăng say quá.
Dialogue: 0,0:09:09.64,0:09:11.54,Default,,0000,0000,0000,,Đồng bộ hóa dữ liệu những gì các cậu vừa bàn\Ncho tớ với nhé?
Dialogue: 0,0:09:11.84,0:09:13.00,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:09:19.18,0:09:22.15,Default,,0000,0000,0000,,Ồ, tớ hiểu rồi...\NÝ tưởng thú vị ghê.
Dialogue: 0,0:09:22.21,0:09:23.11,Default,,0000,0000,0000,,Chuẩn chưa nào?
Dialogue: 0,0:09:23.18,0:09:25.55,Default,,0000,0000,0000,,Nhưng dạo gần đây, có những lúc\Ntớ cảm thấy như thể...
Dialogue: 0,0:09:25.62,0:09:28.28,Default,,0000,0000,0000,,...ý thức và thể xác của tớ\Nlà hai thứ hoàn toàn tách biệt.
Dialogue: 0,0:09:28.59,0:09:29.55,Default,,0000,0000,0000,,Ý cậu là sao cơ?
Dialogue: 0,0:09:29.89,0:09:34.05,Default,,0000,0000,0000,,Tớ có cảm giác như mình đang nhìn xuống bản thân\Ntừ trên bầu trời rất cao.
Dialogue: 0,0:09:34.26,0:09:35.62,Default,,0000,0000,0000,,Này, tớ cũng từng có cảm giác đó đấy!
Dialogue: 0,0:09:35.86,0:09:39.32,Default,,0000,0000,0000,,Bản ngã của mỗi đứa tụi mình\Nnằm trong cơ thể riêng biệt của từng đứa sao?
Dialogue: 0,0:09:39.40,0:09:42.77,Default,,0000,0000,0000,,Hay chỉ có một \"bản ngã\" duy nhất được chia sẻ chung\Ngiữa tập thể Tachikoma tụi mình?
Dialogue: 0,0:09:42.90,0:09:46.70,Default,,0000,0000,0000,,Xét việc đồng bộ hóa là trạng thái tự nhiên của tụi mình,\Nthì tớ nghĩ phải là vế sau rồi.
Dialogue: 0,0:09:46.94,0:09:51.34,Default,,0000,0000,0000,,Phải, nhưng ý chí của đấng tối cao Thiếu tá\Nlại chen vào giữa hai điều đó.
Dialogue: 0,0:09:51.44,0:09:54.24,Default,,0000,0000,0000,,Ừ, nhưng tiến trình cá nhân hóa của tụi mình\Nvẫn tiếp tục phát triển...
Dialogue: 0,0:09:54.31,0:09:56.30,Default,,0000,0000,0000,,...bất chấp việc\Ndầu tự nhiên đã bị cấm tiệt rồi.
Dialogue: 0,0:09:56.48,0:09:59.25,Default,,0000,0000,0000,,Đáng lẽ tụi mình phải hoàn toàn đồng nhất,\Nvậy mà tụi mình lại có cá tính riêng.
Dialogue: 0,0:09:59.55,0:10:01.95,Default,,0000,0000,0000,,Và nếu tụi mình đang trong vô thức trải nghiệm\Ncảm giác vật lý...
Dialogue: 0,0:10:02.02,0:10:04.01,Default,,0000,0000,0000,,...về sự ngắt kết nối giữa cơ thể\Nvà thông tin, điều đó có nghĩa là...
Dialogue: 0,0:10:04.16,0:10:04.75,Default,,0000,0000,0000,,Chẳng lẽ là...?
Dialogue: 0,0:10:04.82,0:10:05.26,Default,,0000,0000,0000,,Chẳng lẽ là...?
Dialogue: 0,0:10:05.32,0:10:06.15,Default,,0000,0000,0000,,Chẳng lẽ là...?
Dialogue: 0,0:10:06.22,0:10:06.52,Default,,0000,0000,0000,,Một Gho...
Dialogue: 0,0:10:06.59,0:10:09.79,Default,,0000,0000,0000,,Này, khoan đã. Tụi mình đừng vội\Nđi tới kết luận chứ.
Dialogue: 0,0:10:10.23,0:10:12.53,Default,,0000,0000,0000,,Chẳng phải đó chỉ đơn thuần\Nlà cảm giác phân ly...
Dialogue: 0,0:10:12.63,0:10:15.10,Default,,0000,0000,0000,,...gây ra bởi việc bổ sung thêm\Nchức năng tác tử sao?
Dialogue: 0,0:10:15.27,0:10:18.73,Default,,0000,0000,0000,,Cũng có thể là vậy, nhưng tớ không thể không cảm thấy\Ncó một bản ngã thứ ba ở đâu đó,
Dialogue: 0,0:10:18.84,0:10:21.17,Default,,0000,0000,0000,,một thứ gì đó nằm ngoài\Nthân xác và linh hồn.
Dialogue: 0,0:10:21.27,0:10:22.74,Default,,0000,0000,0000,,Tớ hiểu cảm giác\Ncủa cậu mà.
Dialogue: 0,0:10:23.01,0:10:25.60,Default,,0000,0000,0000,,Hồi tụi mình chiến đấu\Nvới chiếc trực thăng Jigabachi đó,
Dialogue: 0,0:10:25.91,0:10:31.51,Default,,0000,0000,0000,,tớ đã có thể ngay lập tức hoàn thành vai trò \"bộ giáp\"\Ncủa Thiếu tá mà chẳng hề sợ chết.
Dialogue: 0,0:10:31.98,0:10:35.89,Default,,0000,0000,0000,,Khi chuyện đó xảy ra, ở đâu đó có một phần trong tớ\Nđã hoàn toàn tách biệt ra,
Dialogue: 0,0:10:36.09,0:10:38.32,Default,,0000,0000,0000,,nói rằng cơ thể này\Nkhông còn thuộc về tớ nữa.
Dialogue: 0,0:10:38.59,0:10:41.56,Default,,0000,0000,0000,,Nó có khác với cảm giác ngây ngất khôn tả\Nmà tụi mình từng trải qua...
Dialogue: 0,0:10:41.59,0:10:43.79,Default,,0000,0000,0000,,...khi tụi mình muốn\Nliều mạng cứu chú Batou không?
Dialogue: 0,0:10:43.96,0:10:48.16,Default,,0000,0000,0000,,Tớ nghĩ là có. Lần này giống một hành động đương nhiên,\Nmột thứ gì đó đã được lập trình sẵn trong tụi mình hơn.
Dialogue: 0,0:10:48.23,0:10:50.17,Default,,0000,0000,0000,,Nếu vậy thì,\Ntớ không muốn nói ra đâu,
Dialogue: 0,0:10:50.24,0:10:54.64,Default,,0000,0000,0000,,nhưng bản ngã thứ ba mà cậu cảm nhận được\Ncó thể rất khác với bản ngã ở con người đấy.
Dialogue: 0,0:10:54.91,0:10:57.88,Default,,0000,0000,0000,,Hơn nữa, tụi mình thậm chí còn chưa từng được bảo\Nvị trí đặt máy chủ...
Dialogue: 0,0:10:57.94,0:11:01.14,Default,,0000,0000,0000,,...nơi lưu trữ toàn bộ dữ liệu dùng chung\Ncủa tụi mình cơ mà, nhớ không?
Dialogue: 0,0:11:01.68,0:11:04.98,Default,,0000,0000,0000,,Đó rất có thể chính là bản chất\Ncủa bản ngã thứ ba của tụi mình đấy.
Dialogue: 0,0:11:05.58,0:11:09.21,Default,,0000,0000,0000,,Vậy thứ tụi mình tưởng là Ghost\Nchỉ là ảo giác thôi sao?
Dialogue: 0,0:11:09.45,0:11:12.42,Default,,0000,0000,0000,,Có lẽ là thế, nhưng tụi mình cần phải\Nsuy ngẫm nghiêm túc hơn...
Dialogue: 0,0:11:12.49,0:11:14.98,Default,,0000,0000,0000,,...về cái bản ngã thứ ba mà cậu bảo\Ncậu đã cảm nhận được.
Dialogue: 0,0:11:15.16,0:11:17.15,Default,,0000,0000,0000,,Đồng bộ hóa dữ liệu cảm giác đó\Ncho tớ với nhé.
Dialogue: 0,0:11:18.30,0:11:19.19,Default,,0000,0000,0000,,Được chứ.
Dialogue: 0,0:11:35.11,0:11:36.67,Default,,0000,0000,0000,,Có khả năng nào kết quả này\Nbị sai lệch không?
Dialogue: 0,0:11:37.22,0:11:38.74,Default,,0000,0000,0000,,Khó có khả năng đó lắm.
Dialogue: 0,0:11:38.88,0:11:42.08,Default,,0000,0000,0000,,Chúng tôi đã tìm thấy các mảnh protein hòa tan\Ntrong máu của viên phi công...
Dialogue: 0,0:11:42.19,0:11:44.62,Default,,0000,0000,0000,,...từng cấu thành nên\Ncác cỗ vi máy.
Dialogue: 0,0:11:45.16,0:11:47.65,Default,,0000,0000,0000,,Tuy nhiên, chúng tôi không thể trích xuất\Nthông tin cụ thể nào về chuyện đó...
Dialogue: 0,0:11:47.73,0:11:50.96,Default,,0000,0000,0000,,...từ não điện tử của đám\NMười Một Cá Nhân kia.
Dialogue: 0,0:11:51.16,0:11:53.86,Default,,0000,0000,0000,,Kết quả này đúng như những gì\Ntôi đã dự đoán từ trước.
Dialogue: 0,0:11:54.43,0:11:56.63,Default,,0000,0000,0000,,Dù vậy, kết quả xét nghiệm của viên phi công\Nlà một phát hiện vô cùng quan trọng.
Dialogue: 0,0:11:57.24,0:12:01.57,Default,,0000,0000,0000,,Điều này đồng nghĩa với việc ta quy kết cái chết của phi công\Nlà \"án mạng do vi máy gây ra\" sao?
Dialogue: 0,0:12:01.87,0:12:04.54,Default,,0000,0000,0000,,Dù chúng ta không thể loại trừ khả năng\Nhắn đã tự mình uống chúng.
Dialogue: 0,0:12:04.88,0:12:07.97,Default,,0000,0000,0000,,Lý tưởng nhất là tìm thấy chứng cứ\Ntrong não điện tử của cái xác...
Dialogue: 0,0:12:08.05,0:12:11.81,Default,,0000,0000,0000,,...cho thấy chuyến bay của 11 chiếc trực thăng đó\Nđóng vai trò như một ngòi nổ kích hoạt.
Dialogue: 0,0:12:11.88,0:12:13.68,Default,,0000,0000,0000,,Nhưng đòi hỏi như thế\Nthì hơi quá xa vời rồi.
Dialogue: 0,0:12:13.99,0:12:15.54,Default,,0000,0000,0000,,Bên anh có thu hoạch gì thêm\Nvề số thuốc nổ không?
Dialogue: 0,0:12:15.79,0:12:21.42,Default,,0000,0000,0000,,Theo phân tích ở cấp độ phân tử, nó giống hệt loại C4\Nđược sản xuất trên bán đảo.
Dialogue: 0,0:12:22.06,0:12:25.76,Default,,0000,0000,0000,,Dạo này, người ta phát hiện rất nhiều loại C4 như thế\Ntrong số hàng hóa bị tịch thu...
Dialogue: 0,0:12:26.06,0:12:28.56,Default,,0000,0000,0000,,...tuồn vào trong nước\Nqua tuyến buôn lậu Đài Loan.
Dialogue: 0,0:12:31.67,0:12:32.66,Default,,0000,0000,0000,,Cái gì thế?
Dialogue: 0,0:12:33.41,0:12:35.67,Default,,0000,0000,0000,,{\i1}Tachikoma! Chỗ cậu có nhìn thấy{\i0}\N{\i1}gì không?{\i0}
Dialogue: 0,0:12:41.01,0:12:42.71,Default,,0000,0000,0000,,{\i1}Hình như vừa có một vụ nổ lớn ạ!{\i0}
Dialogue: 0,0:12:47.12,0:12:50.85,Default,,0000,0000,0000,,Gần đây chúng tôi tiếp nhận rất nhiều việc điều tra\Nliên quan đến khủng bố.
Dialogue: 0,0:12:51.42,0:12:53.55,Default,,0000,0000,0000,,Có lẽ điều đó đã biến nơi này\Nthành mục tiêu...
Dialogue: 0,0:12:59.30,0:13:00.36,Default,,0000,0000,0000,,Này, chuyện gì đã xảy ra thế?
Dialogue: 0,0:13:00.47,0:13:02.16,Default,,0000,0000,0000,,Khai báo toàn bộ những gì\Nanh biết xem nào.
Dialogue: 0,0:13:02.23,0:13:05.00,Default,,0000,0000,0000,,Dạ thưa sếp, có vẻ như\Ncó thứ gì đó vừa phát nổ...
Dialogue: 0,0:13:05.14,0:13:12.20,Top Secondary Dialog 1080P,,0000,0000,0000,,Vâng, chúng tôi có khu vực chứa vật liệu dễ cháy.\NVâng, đúng vậy ạ.
Dialogue: 0,0:13:08.81,0:13:11.04,Default,,0000,0000,0000,,Kỳ lạ thật, chẳng thấy ai tháo chạy\Nra khỏi tòa nhà cả...
Dialogue: 0,0:13:11.04,0:13:12.20,Default,,0000,0000,0000,,Chỗ này không có người sao?
Dialogue: 0,0:13:12.68,0:13:18.48,Default,,0000,0000,0000,,Thực ra vài ngày trước chúng tôi có nhận được lời đe dọa\Nrằng sẽ có bom bị cài ở đây.
Dialogue: 0,0:13:18.88,0:13:20.61,Default,,0000,0000,0000,,Chúng tôi đã\Ntăng cường cảnh giác, nhưng mà...
Dialogue: 0,0:13:21.12,0:13:23.14,Default,,0000,0000,0000,,Đúng là trong cái rủi\Ncó cái may...
Dialogue: 0,0:13:23.42,0:13:27.22,Default,,0000,0000,0000,,Chỉ có điều rất có thể Tiến sĩ Asuda,\Nnhà khoa học trưởng ở đây,
Dialogue: 0,0:13:27.29,0:13:29.49,Default,,0000,0000,0000,,đã làm việc trong tòa nhà\Ntừ chiều tới giờ.
Dialogue: 0,0:13:29.59,0:13:31.03,Default,,0000,0000,0000,,Sao lúc đầu anh không nói\Nngay từ đầu hả?!
Dialogue: 0,0:13:38.44,0:13:40.80,Default,,0000,0000,0000,,{\i1}Thiếu tá, chúng tôi đang ở{\i0}\N{\i1}tâm vụ nổ.{\i0}
Dialogue: 0,0:13:41.34,0:13:43.53,Default,,0000,0000,0000,,{\i1}Theo tôi quan sát, thiệt hại này là kiểu tổn thất{\i0}\N{\i1}do một vụ nổ khí gas gây ra.{\i0}
Dialogue: 0,0:13:44.58,0:13:45.60,Default,,0000,0000,0000,,{\i1}Có thương vong gì không?{\i0}
Dialogue: 0,0:13:46.34,0:13:50.34,Default,,0000,0000,0000,,{\i1}Họ bảo có một nhà khoa học tên Asuda ở đây,{\i0}\N{\i1}nhưng bọn tôi vẫn đang tìm kiếm.{\i0}
Dialogue: 0,0:13:50.95,0:13:52.01,Default,,0000,0000,0000,,{\i1}Asuda ư?{\i0}
Dialogue: 0,0:13:52.42,0:13:54.51,Default,,0000,0000,0000,,{\i1}Tachikoma. Truy xuất dữ liệu{\i0}\N{\i1}về nhà nghiên cứu đó mau.{\i0}
Dialogue: 0,0:13:55.12,0:13:57.42,Default,,0000,0000,0000,,{\i1}Có lẽ đây chính là người{\i0}\N{\i1}mà họ đang nói tới ạ.{\i0}
Dialogue: 0,0:13:59.72,0:14:01.32,Default,,0000,0000,0000,,Ơ...
Dialogue: 0,0:14:01.86,0:14:03.05,Default,,0000,0000,0000,,Hử? Có chuyện gì thế?
Dialogue: 0,0:14:03.13,0:14:06.79,Default,,0000,0000,0000,,Vấn đề là, cháu từng thấy người này\Nở đâu đó rồi thì phải.
Dialogue: 0,0:14:08.60,0:14:11.16,Default,,0000,0000,0000,,Có lẽ cậu đã gặp ông ta khi họ chạy phân tích cấu trúc\Ncho mấy đứa các cậu.
Dialogue: 0,0:14:11.80,0:14:16.21,Default,,0000,0000,0000,,Lúc đầu cháu cũng nghĩ vậy, nhưng trong bộ nhớ của cháu\Nlại không có hồ sơ nào trùng khớp cả.
Dialogue: 0,0:14:16.81,0:14:20.51,Default,,0000,0000,0000,,{\i1}Trụ sở, kiểm tra hệ thống hồng ngoại trên các tuyến đường{\i0}\N{\i1}dẫn tới sân bay Itami và Niihama...{\i0}
Dialogue: 0,0:14:20.71,0:14:22.70,Default,,0000,0000,0000,,{\i1}...cũng như hệ thống bên trong{\i0}\N{\i1}các sân bay đó,{\i0}
Dialogue: 0,0:14:22.78,0:14:25.68,Default,,0000,0000,0000,,{\i1}xem có bắt được ai trùng khớp{\i0}\N{\i1}với hồ sơ của Tiến sĩ Asuda không.{\i0}
Dialogue: 0,0:14:26.05,0:14:27.45,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:14:27.95,0:14:29.68,Default,,0000,0000,0000,,{\i1}Thiếu tá, chuyện là thế nào vậy?{\i0}
Dialogue: 0,0:14:29.75,0:14:33.12,Default,,0000,0000,0000,,{\i1}Tôi sẽ giải thích sau. Bàn giao hiện trường lại cho cảnh sát địa phương{\i0}\N{\i1}rồi quay lại trực thăng cánh xoay mau.{\i0}
Dialogue: 0,0:14:33.83,0:14:35.79,Default,,0000,0000,0000,,{\i1}Ông ta nhiều khả năng{\i0}\N{\i1}đang hướng tới sân bay Niihama.{\i0}
Dialogue: 0,0:14:39.16,0:14:40.06,Default,,0000,0000,0000,,{\i1}Mọi người ơi!{\i0}
Dialogue: 0,0:14:40.40,0:14:41.89,Default,,0000,0000,0000,,Trời ạ, có cần phải\Nhét toáng lên như thế không.
Dialogue: 0,0:14:42.80,0:14:46.24,Default,,0000,0000,0000,,{\i1}Kiểm tra xem các cậu có dữ liệu nào{\i0}\N{\i1}trùng khớp với người đàn ông này không.{\i0}
Dialogue: 0,0:14:46.47,0:14:50.20,Default,,0000,0000,0000,,{\i1}Tớ không rõ vì sao, nhưng tớ dám chắc{\i0}\N{\i1}mình từng có ký ức đã gặp ông ấy trước đây.{\i0}
Dialogue: 0,0:14:52.91,0:14:54.64,Default,,0000,0000,0000,,Để tớ nghĩ xem...\NÔng ấy là ai thế nhỉ?
Dialogue: 0,0:14:54.75,0:14:59.21,Default,,0000,0000,0000,,Tớ cũng đoan chắc là mình từng gặp ông ấy, nhưng trong bộ nhớ\Ncũng chẳng có dữ liệu nào trùng khớp cả.
Dialogue: 0,0:14:59.85,0:15:01.91,Default,,0000,0000,0000,,Thế chẳng phải đồng nghĩa với việc\Ncậu chưa từng gặp ông ấy bao giờ sao?
Dialogue: 0,0:15:03.09,0:15:04.95,Default,,0000,0000,0000,,Thôi được rồi, đủ rồi đấy!\NTrật tự đi!
Dialogue: 0,0:15:14.33,0:15:18.29,Default,,0000,0000,0000,,Bực mình ghê cơ! Tớ biết rõ nó ở đó,\Nvậy mà lại chẳng thể nhớ ra được!
Dialogue: 0,0:15:18.37,0:15:20.07,Default,,0000,0000,0000,,Chắc là các khớp thần kinh synapse của cậu\Nchưa chịu kết nối với nhau rồi.
Dialogue: 0,0:15:20.14,0:15:23.67,Default,,0000,0000,0000,,\"Synapse\" á? Bỏ mấy cái so sánh sinh học hữu cơ đó\Nđi được không hả?
Dialogue: 0,0:15:23.78,0:15:26.90,Default,,0000,0000,0000,,Này, các cậu có thấy như thể\Nmảnh ký ức này...
Dialogue: 0,0:15:26.98,0:15:30.97,Default,,0000,0000,0000,,...đang nằm trong một phân vùng bị cô lập của não điện tử,\Nmà tụi mình không thể truy cập vào được không?
Dialogue: 0,0:15:35.52,0:15:38.55,Default,,0000,0000,0000,,Tiến sĩ Asuda là nhà khoa học\Nđã một tay phát triển...
Dialogue: 0,0:15:38.62,0:15:42.65,Default,,0000,0000,0000,,...mẫu chip thần kinh nguyên bản được sử dụng\Ntrong AI của các Tachikoma.
Dialogue: 0,0:15:42.99,0:15:45.59,Default,,0000,0000,0000,,Ý cô bảo ông ta là bố\Ncủa mấy con Tachikoma sao?
Dialogue: 0,0:15:46.77,0:15:48.63,Default,,0000,0000,0000,,Có thể hiểu\Ntheo cách đó.
Dialogue: 0,0:15:49.60,0:15:54.60,Default,,0000,0000,0000,,Chúng ta cũng đã nhờ đích thân Tiến sĩ Asuda hỗ trợ\Nkhi tái cấu trúc lại các Tachikoma.
Dialogue: 0,0:15:55.44,0:15:59.10,Default,,0000,0000,0000,,Ông ấy còn giúp chúng ta tìm ra giải pháp\Nloại bỏ nguy cơ mất mát dữ liệu trải nghiệm...
Dialogue: 0,0:15:59.38,0:16:04.54,Default,,0000,0000,0000,,...bằng cách bổ sung chức năng tác tử và trang bị cho chúng\Ncấu trúc bộ nhớ dự phòng.
Dialogue: 0,0:16:04.88,0:16:08.01,Default,,0000,0000,0000,,Cô nghĩ Tiến sĩ Asuda này có liên quan gì\Nđến vụ nổ sao?
Dialogue: 0,0:16:08.42,0:16:10.48,Default,,0000,0000,0000,,Rất có thể chính ông ta\Nđã tự mình gây ra vụ nổ đó.
Dialogue: 0,0:16:10.96,0:16:12.25,Default,,0000,0000,0000,,Để đạt được mục đích gì chứ?
Dialogue: 0,0:16:13.32,0:16:16.19,Default,,0000,0000,0000,,Để đào tẩu ra nước ngoài,\Nmang theo thành quả nghiên cứu của mình.
Dialogue: 0,0:16:22.43,0:16:26.53,Default,,0000,0000,0000,,Vị tiến sĩ rất tự hào về việc\Ntự mình phát triển chip thần kinh.
Dialogue: 0,0:16:27.07,0:16:29.54,Default,,0000,0000,0000,,Thế nhưng địa vị của ông ta\Nlại là nhà khoa học do nhà nước bảo trợ.
Dialogue: 0,0:16:30.11,0:16:32.41,Default,,0000,0000,0000,,Dù ông ta đã phát minh ra\Nthứ AI mang tính cách mạng đó,
Dialogue: 0,0:16:32.51,0:16:35.00,Default,,0000,0000,0000,,ông ta lại không thể đăng ký bằng sáng chế cá nhân\Ncho công trình của mình.
Dialogue: 0,0:16:38.22,0:16:40.68,Default,,0000,0000,0000,,Vì những lý do đó và nhiều nguyên nhân khác,\Nchúng ta đã theo nguyện vọng của Tiến sĩ thu xếp...
Dialogue: 0,0:16:40.79,0:16:44.05,Default,,0000,0000,0000,,...để ông ta có thể chạy các phân tích cấu trúc trên Tachikoma\Nnhằm giúp ông...
Dialogue: 0,0:16:44.12,0:16:47.32,Default,,0000,0000,0000,,...nghiên cứu tình trạng hiện tại, cũng như mức độ\Nphát triển của chip thần kinh.
Dialogue: 0,0:16:47.63,0:16:49.99,Default,,0000,0000,0000,,Thảo nào cô lại bảo bọn tôi\Ndắt theo một con Tachikoma...
Dialogue: 0,0:16:50.50,0:16:53.33,Default,,0000,0000,0000,,Nếu đúng như thế, tại sao tụi mình lại có\Nký ức mơ hồ về vị Tiến sĩ nhỉ?
Dialogue: 0,0:16:53.70,0:16:58.07,Default,,0000,0000,0000,,Bởi vì bọn tôi đã xóa ký ức của các cậu\Nsau mỗi lần trải qua phân tích cấu trúc.
Dialogue: 0,0:16:58.54,0:17:02.60,Default,,0000,0000,0000,,Nhưng chắc ông ta muốn để lại dấu vết\Nthành tựu của mình ở một nơi nào đó,
Dialogue: 0,0:17:02.81,0:17:05.97,Default,,0000,0000,0000,,nên đã cài ký ức về bản thân\Nvào một phần trong bộ nhớ của các cậu.
Dialogue: 0,0:17:06.98,0:17:10.85,Default,,0000,0000,0000,,{\i1}Thiếu tá, chúng tôi đã định vị được Tiến sĩ Asuda{\i0}\N{\i1}ở sảnh chờ của sân bay Niihama.{\i0}
Dialogue: 0,0:17:11.28,0:17:13.41,Default,,0000,0000,0000,,{\i1}Làm tốt lắm.{\i0}\N{\i1}Tiếp tục giám sát ông ta.{\i0}
Dialogue: 0,0:17:13.72,0:17:14.69,Default,,0000,0000,0000,,{\i1}Sếp.{\i0}
Dialogue: 0,0:17:14.75,0:17:19.02,Default,,0000,0000,0000,,{\i1}Được rồi. Tôi vừa yêu cầu hoãn toàn bộ chuyến bay{\i0}\N{\i1}khởi hành đi Bắc Mỹ.{\i0}
Dialogue: 0,0:17:19.26,0:17:20.42,Default,,0000,0000,0000,,{\i1}Thế thì giúp ích rất nhiều đấy ạ.{\i0}
Dialogue: 0,0:17:21.89,0:17:24.52,Default,,0000,0000,0000,,Cảm ơn Thủ tướng Kayabuki đã hỗ trợ\Ntrong việc này.
Dialogue: 0,0:17:24.83,0:17:26.59,Default,,0000,0000,0000,,Không cần phải\Ncảm ơn tôi đâu.
Dialogue: 0,0:17:26.97,0:17:31.87,Default,,0000,0000,0000,,Chúng ta đã ngăn chặn được một trong những bộ óc hàng đầu của đất nước\Ncùng thành quả nghiên cứu AI...
Dialogue: 0,0:17:32.27,0:17:34.24,Default,,0000,0000,0000,,...không bị tuồn trái phép\Nra nước ngoài.
Dialogue: 0,0:17:34.71,0:17:37.97,Default,,0000,0000,0000,,Nhờ sự nỗ lực của các thuộc cấp tôi\Nmà Thủ tướng mới có thể an tâm như vậy.
Dialogue: 0,0:17:39.88,0:17:41.90,Default,,0000,0000,0000,,Xin quý hành khách\Nchú ý lắng nghe thông báo.
Dialogue: 0,0:17:42.08,0:17:45.02,Default,,0000,0000,0000,,Giờ khởi hành của toàn bộ các chuyến bay chở khách\Nđi Bắc Mỹ...
Dialogue: 0,0:17:45.08,0:17:47.68,Default,,0000,0000,0000,,...vừa bị tạm hoãn\Ndo điều kiện thời tiết xấu.
Dialogue: 0,0:17:48.42,0:17:50.05,Default,,0000,0000,0000,,Ồ, ra là như thế sao...
Dialogue: 0,0:17:50.12,0:17:52.72,Default,,0000,0000,0000,,Nhưng tớ vẫn không thể nhớ ra\Nvị Tiến sĩ Asuda này.
Dialogue: 0,0:17:52.79,0:17:55.76,Default,,0000,0000,0000,,Các khớp synapse của tớ chỉ còn thiếu\Nđúng một bước nữa là kết nối được...
Dialogue: 0,0:17:55.83,0:17:58.32,Default,,0000,0000,0000,,Chẳng phải cậu vừa bảo là ghét cay ghét đắng\Ncái cách diễn đạt đó sao?
Dialogue: 0,0:17:58.43,0:17:59.33,Default,,0000,0000,0000,,Này, tớ có cách rồi!
Dialogue: 0,0:18:02.13,0:18:05.36,Default,,0000,0000,0000,,Này Proto. Tôi sắp mở nắp đầu\Ncủa cậu này ra đấy nhé.
Dialogue: 0,0:18:06.47,0:18:07.87,Default,,0000,0000,0000,,Chuyện này là sao đây?
Dialogue: 0,0:18:08.17,0:18:11.40,Default,,0000,0000,0000,,Cậu chán việc chỉ đồng bộ hóa rồi, nên giờ muốn tớ\Ngiao nộp toàn bộ AI cho cậu à?
Dialogue: 0,0:18:11.51,0:18:16.61,Default,,0000,0000,0000,,Không, tớ chỉ muốn kiểm tra xem phân vùng bị cô lập đó\Nnằm ở phần nào trong AI của cậu thôi.
Dialogue: 0,0:18:18.28,0:18:20.05,Default,,0000,0000,0000,,Cái đồ ngốc này!\NCậu không được làm thế đâu!
Dialogue: 0,0:18:24.99,0:18:26.96,Default,,0000,0000,0000,,- Có chuyện gì thế?\N- Chuyện gì xảy ra vậy?
Dialogue: 0,0:18:27.93,0:18:33.23,Default,,0000,0000,0000,,Nó... Nó không có ở đây! Biến mất rồi!\NAI của cậu ấy biến mất rồi!
Dialogue: 0,0:18:34.80,0:18:38.17,Default,,0000,0000,0000,,Chẳng lẽ điều này có nghĩa là mỗi đứa tụi mình\Nđều là lũ không não sao?!
Dialogue: 0,0:18:39.64,0:18:42.83,Default,,0000,0000,0000,,Vậy rốt cuộc AI của tụi mình\Nđang ở cái xó nào chứ?
Dialogue: 0,0:18:46.21,0:18:48.04,Top Secondary Dialog 1080P,,0000,0000,0000,,Xin quý hành khách\Nchú ý lắng nghe thông báo.
Dialogue: 0,0:18:48.35,0:18:53.38,Top Secondary Dialog 1080P,,0000,0000,0000,,Thời tiết xấu từng khiến các chuyến bay đi Bắc Mỹ bị hoãn\Nhiện đã quang đãng trở lại,
Dialogue: 0,0:18:50.05,0:18:52.42,Default,,0000,0000,0000,,Tiến sĩ Asuda, phải không ạ?
Dialogue: 0,0:18:53.02,0:18:56.39,Default,,0000,0000,0000,,Ông đã vi phạm Đạo luật Kiểm soát Xuất khẩu Vũ khí.\NXin mời ông đi theo tôi.
Dialogue: 0,0:18:53.69,0:18:55.39,Top Secondary Dialog 1080P,,0000,0000,0000,,nên chúng tôi sẽ khôi phục lại\Nhoạt động của các chuyến bay.
Dialogue: 0,0:18:55.79,0:19:01.29,Top Secondary Dialog 1080P,,0000,0000,0000,,Các chuyến bay bắt đầu đón khách trở lại,\Nxin quý khách vui lòng di chuyển ra cửa khởi hành.
Dialogue: 0,0:18:57.86,0:19:02.69,Default,,0000,0000,0000,,Tôi từ chối. Tôi sẽ làm việc ở một quốc gia\Nbiết công nhận quyền lợi chính đáng của tôi.
Dialogue: 0,0:19:02.43,0:19:04.29,Top Secondary Dialog 1080P,,0000,0000,0000,,Xin quý hành khách\Nchú ý lắng nghe thông báo.
Dialogue: 0,0:19:04.96,0:19:10.00,Top Secondary Dialog 1080P,,0000,0000,0000,,Thời tiết xấu từng khiến các chuyến bay đi Bắc Mỹ bị hoãn\Nhiện đã quang đãng trở lại,
Dialogue: 0,0:19:04.96,0:19:07.67,Default,,0000,0000,0000,,Ông trở thành nhà khoa học được nhà nước bảo trợ\Nđể đổi lại...
Dialogue: 0,0:19:07.67,0:19:09.73,Default,,0000,0000,0000,,...toàn bộ kinh phí và trang thiết bị\Nmà ông từng ao ước.
Dialogue: 0,0:19:10.20,0:19:12.00,Top Secondary Dialog 1080P,,0000,0000,0000,,nên chúng tôi sẽ khôi phục lại\Nhoạt động của các chuyến bay.
Dialogue: 0,0:19:10.20,0:19:14.64,Default,,0000,0000,0000,,Hơn ai hết, ông phải hiểu rõ rằng\Nmình không có quyền làm điều này.
Dialogue: 0,0:19:12.30,0:19:17.61,Top Secondary Dialog 1080P,,0000,0000,0000,,Các chuyến bay bắt đầu đón khách trở lại,\Nxin quý khách vui lòng di chuyển ra...
Dialogue: 0,0:19:24.18,0:19:29.38,Default,,0000,0000,0000,,Tiếc thật đấy. Vậy mà bọn tôi còn cất công đưa nhóc này\Nđến viện nghiên cứu thăm ông.
Dialogue: 0,0:19:31.16,0:19:32.28,Default,,0000,0000,0000,,Ra vậy.
Dialogue: 0,0:19:34.03,0:19:35.25,Default,,0000,0000,0000,,Dạ...
Dialogue: 0,0:19:36.79,0:19:40.03,Default,,0000,0000,0000,,Bác có phải là... cha của cháu không?
Dialogue: 0,0:19:42.87,0:19:44.56,Default,,0000,0000,0000,,Cha của cháu sao?
Dialogue: 0,0:19:46.77,0:19:49.93,Default,,0000,0000,0000,,Tình trạng của chúng tạm thời\Nđã ổn định,
Dialogue: 0,0:19:50.01,0:19:52.91,Default,,0000,0000,0000,,nhưng không ai biết điều gì có thể\Nkích hoạt một sự sụp đổ khác.
Dialogue: 0,0:19:53.61,0:19:56.84,Default,,0000,0000,0000,,Chúng tôi nhận định ông đã tự ý cài ký ức về mình\Nvào bộ nhớ của chúng.
Dialogue: 0,0:19:56.92,0:19:58.41,Default,,0000,0000,0000,,Ông có thể cho chúng tôi biết cách\Nxóa chúng đi không?
Dialogue: 0,0:20:02.09,0:20:05.42,Default,,0000,0000,0000,,Ngày xưa, từng có một người thợ mộc vô danh\Nxây dựng nên một tòa lâu đài...
Dialogue: 0,0:20:05.76,0:20:08.85,Default,,0000,0000,0000,,...ông ta đã cố tình để lại những dụng cụ mình từng dùng\Nđể khắc tên mình trên căn gác xép...
Dialogue: 0,0:20:09.16,0:20:12.89,Default,,0000,0000,0000,,...như một bằng chứng cho thấy ông đã góp phần\Ntạo nên công trình đó.
Dialogue: 0,0:20:13.60,0:20:17.00,Default,,0000,0000,0000,,Cô thậm chí còn muốn xóa bỏ cả chút tình cảm ủy mị\Nnhỏ nhoi đó nữa sao?
Dialogue: 0,0:20:17.30,0:20:18.20,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:20:18.54,0:20:21.03,Default,,0000,0000,0000,,Khi ông đánh đổi thứ gì đó cho chính phủ\Nđể đổi lấy quyền lực,
Dialogue: 0,0:20:21.11,0:20:23.23,Default,,0000,0000,0000,,đó chính là cái giá\Nmà ông phải trả.
Dialogue: 0,0:20:29.71,0:20:33.12,Default,,0000,0000,0000,,Hãy xóa tập tin C9 trong phân vùng số 8\Ncủa bộ não điện tử trung tâm...
Dialogue: 0,0:20:33.18,0:20:36.45,Default,,0000,0000,0000,,...mà tôi đã tích hợp vào vệ tinh đó\Ntheo yêu cầu của các người.
Dialogue: 0,0:20:38.32,0:20:39.55,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:20:40.66,0:20:42.49,Default,,0000,0000,0000,,Thiếu tá? Ý ông ấy là sao,\N\"vệ tinh\" là thế nào ạ?
Dialogue: 0,0:20:42.56,0:20:47.55,Default,,0000,0000,0000,,A, tớ hiểu rồi! Lý do tụi mình cảm thấy bản ngã\Nnằm ở đâu đó ngoài thân xác...
Dialogue: 0,0:20:47.97,0:20:53.37,Default,,0000,0000,0000,,...là vì AI của tụi mình đang đồng bộ qua bộ não điện tử trung tâm\Ntrên quỹ đạo, đúng không?
Dialogue: 0,0:20:54.31,0:20:55.70,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:20:56.01,0:21:00.14,Default,,0000,0000,0000,,Nghĩa là máy chủ của tụi mình\Ncũng nằm trên vệ tinh đó sao?
Dialogue: 0,0:21:00.24,0:21:03.30,Default,,0000,0000,0000,,Vậy có nghĩa là tụi mình\Nđang cảm nhận...
Dialogue: 0,0:21:03.35,0:21:05.75,Default,,0000,0000,0000,,...tầm nhìn bao quát từ trên cao\Nnhư bản ngã thứ ba của tụi mình sao?
Dialogue: 0,0:21:06.02,0:21:09.32,Default,,0000,0000,0000,,AI của tụi mình không được trang bị\Ncác cơ quan cảm giác,
Dialogue: 0,0:21:09.62,0:21:14.39,Default,,0000,0000,0000,,nên khi suy nghĩ, tụi mình chưa từng nhận ra ý thức của mình\Nđang đi theo con đường nào.
Dialogue: 0,0:21:14.53,0:21:17.36,Default,,0000,0000,0000,,Ồ, thảo nào tụi mình không cần sự hợp nhất\Ngiữa thân xác và tâm trí...
Dialogue: 0,0:21:17.43,0:21:19.86,Default,,0000,0000,0000,,...giữa cơ thể và các chương trình\Ncủa tụi mình nữa!
Dialogue: 0,0:21:19.96,0:21:23.59,Default,,0000,0000,0000,,Giờ thì tớ cũng hiểu vì sao\Ntớ lại chẳng hề sợ chết rồi!
Dialogue: 0,0:21:25.67,0:21:30.00,Default,,0000,0000,0000,,Dù vậy, thật không thể tin nổi nó lại ở trên vũ trụ...\NTuyệt vời thật đấy...
Dialogue: 0,0:21:37.05,0:21:42.61,Default,,0000,0000,0000,,Chỉ có điều, cháu nghĩ mình không muốn\Nbị xóa đi ký ức về bác đâu.
Dialogue: 0,0:21:43.29,0:21:44.48,Default,,0000,0000,0000,,Đừng bận tâm về chuyện đó.
Dialogue: 0,0:21:45.32,0:21:50.09,Default,,0000,0000,0000,,Những lý tưởng mà ta ấp ủ cho AI của mình\Nrồi cũng sẽ lưu lạc đâu đó trên mạng mà thôi.
Dialogue: 0,0:21:54.03,0:21:57.02,Default,,0000,0000,0000,,Thiếu tá, số phận của người này\Nrồi sẽ ra sao?
Dialogue: 0,0:21:57.44,0:22:01.60,Default,,0000,0000,0000,,Vì chính chúng ta là người bắt giữ ông ta,\Nta sẽ có chút quyền tự quyết.
Dialogue: 0,0:22:02.01,0:22:04.00,Default,,0000,0000,0000,,Nếu may mắn, ông ta sẽ chỉ bị\Ntuyên án tù.
Dialogue: 0,0:22:05.38,0:22:06.64,Default,,0000,0000,0000,,Còn nếu không may mắn\Ncho lắm?
Dialogue: 0,0:22:07.68,0:22:12.58,Default,,0000,0000,0000,,Ông ta có thể sẽ dành phần đời còn lại lao động khổ sai trong vô danh\Nbên trong các cơ sở ở Harima.
Dialogue: 0,0:22:15.92,0:22:19.36,Default,,0000,0000,0000,,Có lẽ thỉnh thoảng tôi sẽ dắt mấy con Tachikoma\Ntới thăm ông ta.
Dialogue: 0,0:22:19.76,0:22:21.55,Default,,0000,0000,0000,,Tôi không chắc điều đó\Ncó giúp ích được gì không.
Dialogue: 0,0:22:22.39,0:22:26.49,Default,,0000,0000,0000,,Ông ấy từng đi tìm kiếm tự do,\Nnhưng giờ đây ông đã mất đi tự do rồi.
Dialogue: 0,0:22:27.07,0:22:28.83,Default,,0000,0000,0000,,Cũng giống hệt như chúng ta vậy.
Dialogue: 0,0:22:28.83,0:22:30.83,Default,,0000,0000,0000,,
