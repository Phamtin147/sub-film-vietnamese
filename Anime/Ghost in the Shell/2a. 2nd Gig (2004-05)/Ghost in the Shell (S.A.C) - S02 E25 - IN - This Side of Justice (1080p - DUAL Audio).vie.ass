Dialogue: 0,0:01:14.56,0:01:21.62,GitS 2nd Gig OP Credits,,0000,0000,0000,,{\i1\fs85\c&H00FF00&\fad(0,2000)}We rise or fall...{\i0}\N{\c&H00FFFF&}Dẫu ta thăng hoa hay gục ngã...{\i0}
Dialogue: 0,0:01:41.16,0:01:42.32,Default,,0000,0000,0000,,Cứ đi trước đi!
Dialogue: 0,0:01:56.28,0:01:57.47,Default,,0000,0000,0000,,Đừng có ngốc thế!
Dialogue: 0,0:02:45.76,0:02:47.45,Default,,0000,0000,0000,,Chúng đang dùng đội hình B sao?
Dialogue: 0,0:02:48.36,0:02:52.56,Default,,0000,0000,0000,,Chúng ta sẽ bám theo các hành lang mặt đất. Phải cắt đuôi chúng\Ntrước khi tốc độ di chuyển bị đẩy lên nhanh hơn.
Dialogue: 0,0:02:52.67,0:02:53.60,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:03:09.92,0:03:11.08,Default,,0000,0000,0000,,Khoan đã.
Dialogue: 0,0:03:11.18,0:03:13.65,Default,,0000,0000,0000,,Lạ thật đấy.\NHệ thống gây nhiễu ECM không hoạt động.
Dialogue: 0,0:03:13.79,0:03:15.08,Default,,0000,0000,0000,,Chắc hẳn đã có chuyện gì xảy ra rồi.
Dialogue: 0,0:03:15.72,0:03:18.75,Default,,0000,0000,0000,,Được rồi mọi người, bật bộ đàm sang chế độ \"mở\".\NTruy kích theo đội hình A.
Dialogue: 0,0:03:31.00,0:03:33.47,Default,,0000,0000,0000,,Proto, cậu có thể khóa\Ncánh cửa đó lại được không?
Dialogue: 0,0:03:33.67,0:03:36.94,Default,,0000,0000,0000,,Vâng, thưa sếp. Tôi xin lỗi vì đã làm phiền\Nông đủ thứ chuyện...
Dialogue: 0,0:03:37.04,0:03:38.34,Default,,0000,0000,0000,,Không sao đâu.
Dialogue: 0,0:03:38.61,0:03:41.88,Default,,0000,0000,0000,,Quan trọng hơn, cậu đã nhận thêm được\Nbáo cáo nào từ các Tachikoma chưa?
Dialogue: 0,0:03:42.32,0:03:45.34,Default,,0000,0000,0000,,Dạ có rồi thưa sếp. Chiếc tàu ngầm hạt nhân\Nhiện vẫn chưa có động tĩnh gì đáng ngờ.
Dialogue: 0,0:03:45.65,0:03:48.98,Default,,0000,0000,0000,,Ngoài ra, có vẻ như máy bay cảnh giới\Ntrên bầu trời Dejima vừa bị rơi.
Dialogue: 0,0:03:49.32,0:03:51.45,Default,,0000,0000,0000,,Người tị nạn\Nbắn hạ nó sao?
Dialogue: 0,0:03:51.66,0:03:54.06,Default,,0000,0000,0000,,Tôi chưa nắm rõ chi tiết cụ thể,\Nnhưng khả năng cao là như vậy.
Dialogue: 0,0:03:55.39,0:03:58.73,Default,,0000,0000,0000,,Nghĩa là lúc này chúng ta đã có thể\Nliên lạc được với Dejima rồi phải không?
Dialogue: 0,0:04:07.21,0:04:08.43,Default,,0000,0000,0000,,Chính là nơi này hả?
Dialogue: 0,0:04:19.35,0:04:20.15,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:04:20.25,0:04:23.78,Default,,0000,0000,0000,,Đừng bận tâm đến tôi. Tôi tới đây theo mệnh lệnh\Ncủa Tổng thư ký Nội các.
Dialogue: 0,0:04:28.56,0:04:32.05,Default,,0000,0000,0000,,Thứ lỗi nhé mấy anh bạn, nhưng hiện giờ\Nđây là tình trạng khẩn cấp quốc gia.
Dialogue: 0,0:04:40.24,0:04:42.40,Default,,0000,0000,0000,,Thưa Thủ tướng, tôi đến đây\Nđể đưa ngài trở về.
Dialogue: 0,0:04:42.54,0:04:45.53,Default,,0000,0000,0000,,Trưởng ban Aramaki nói rằng ông ấy\Nđang rất cần sự hỗ trợ của ngài.
Dialogue: 0,0:04:46.11,0:04:47.48,Default,,0000,0000,0000,,Xin mời ngài đi cùng tôi,\Nthưa Thủ tướng.
Dialogue: 0,0:04:48.58,0:04:51.02,Default,,0000,0000,0000,,Tôi hiểu rồi.\NHãy dẫn đường cho tôi.
Dialogue: 0,0:04:53.99,0:04:57.55,Default,,0000,0000,0000,,{\i1}Thưa Đại diện, dường như máy bay trinh sát của MSDA{\i0}\N{\i1}vừa bị bắn rơi rồi.{\i0}
Dialogue: 0,0:04:57.76,0:05:02.75,Default,,0000,0000,0000,,{\i1}Ồ, hắn ta đang cố gắng tập hợp lại{\i0}\N{\i1}đám người tị nạn đang bị cô lập đó sao?{\i0}
Dialogue: 0,0:05:03.83,0:05:06.23,Default,,0000,0000,0000,,{\i1}Đã đến lúc phải thực hiện{\i0}\N{\i1}những nét vẽ cuối cùng rồi.{\i0}
Dialogue: 0,0:05:07.03,0:05:11.30,Default,,0000,0000,0000,,{\i1}Hãy điều khiển Bộ Quốc phòng tiến hành{\i0}\N{\i1}hàng loạt đợt pháo kích dữ dội từ hạm đội chiến hạm.{\i0}
Dialogue: 0,0:05:11.40,0:05:12.74,Default,,0000,0000,0000,,{\i1}Rõ rồi, thưa ngài.{\i0}
Dialogue: 0,0:05:18.68,0:05:19.87,Default,,0000,0000,0000,,{\i1}Có ai ở đây không?{\i0}
Dialogue: 0,0:05:19.98,0:05:20.95,Default,,0000,0000,0000,,{\i1}Dạ có, thưa ngài.{\i0}
Dialogue: 0,0:05:21.05,0:05:23.21,Default,,0000,0000,0000,,{\i1}Tôi muốn cậu gửi giúp tôi{\i0}\N{\i1}một bức thư.{\i0}
Dialogue: 0,0:05:23.32,0:05:24.87,Default,,0000,0000,0000,,{\i1}Một bức thư sao, thưa ngài?{\i0}
Dialogue: 0,0:05:25.08,0:05:27.92,Default,,0000,0000,0000,,{\i1}Đúng vậy.{\i0}\N{\i1}Gửi bằng chuyển phát hỏa tốc.{\i0}
Dialogue: 0,0:05:28.59,0:05:30.25,Default,,0000,0000,0000,,{\i1}Tachikoma!{\i0}\N{\i1}Nghe rõ tôi nói không?{\i0}
Dialogue: 0,0:05:30.59,0:05:32.11,Default,,0000,0000,0000,,{\i1}Bọn em nghe rõ, Thiếu tá!{\i0}
Dialogue: 0,0:05:32.19,0:05:35.09,Default,,0000,0000,0000,,- Bọn em đã định vị được tọa độ của Thiếu tá!\N- Vậy là anh Batou vẫn bình an vô sự!
Dialogue: 0,0:05:35.80,0:05:37.09,Default,,0000,0000,0000,,{\i1}Tình hình của nhóm Batou{\i0}\N{\i1}hiện giờ ra sao rồi?{\i0}
Dialogue: 0,0:05:37.20,0:05:38.13,Default,,0000,0000,0000,,{\i1}Họ vẫn an toàn.{\i0}
Dialogue: 0,0:05:38.23,0:05:41.13,Default,,0000,0000,0000,,{\i1}Dường như họ đang ở bên trong một tòa nhà,{\i0}\N{\i1}nên bọn em không thể thu được hình ảnh trực quan.{\i0}
Dialogue: 0,0:05:41.60,0:05:44.93,Default,,0000,0000,0000,,{\i1}Tôi đã tìm thấy Kuze rồi. Hãy chuyển tiếp vị trí của tôi{\i0}\N{\i1}cho Batou và những người khác.{\i0}
Dialogue: 0,0:05:45.14,0:05:48.73,Default,,0000,0000,0000,,{\i1}Rõ ạ. Thiếu tá ơi, bọn em còn nắm được một tin tức khác,{\i0}\N{\i1}đáng lo ngại hơn rất nhiều...{\i0}
Dialogue: 0,0:05:48.84,0:05:49.81,Default,,0000,0000,0000,,{\i1}Chuyện gì vậy?{\i0}
Dialogue: 0,0:05:50.18,0:05:54.84,Default,,0000,0000,0000,,{\i1}Vấn đề là, một tàu ngầm hạt nhân của Đế chế Mỹ{\i0}\N{\i1}hiện đang chốt chặn ở ngoài khơi Okinawa,{\i0}
Dialogue: 0,0:05:54.95,0:05:58.51,Default,,0000,0000,0000,,{\i1}và có vẻ như chúng đang lên kế hoạch{\i0}\N{\i1}phóng tên lửa hạt nhân thẳng vào Dejima.{\i0}
Dialogue: 0,0:05:58.85,0:06:01.75,Default,,0000,0000,0000,,{\i1}Các cậu có chắc chắn không? Chuyển ngay{\i0}\N{\i1}kênh hình ảnh trực tiếp cho tôi!{\i0}
Dialogue: 0,0:06:01.99,0:06:02.98,Default,,0000,0000,0000,,{\i1}Rõ ạ!{\i0}
Dialogue: 0,0:06:08.16,0:06:09.39,Default,,0000,0000,0000,,{\i1}Cái quái gì thế này?!{\i0}
Dialogue: 0,0:06:10.26,0:06:12.36,Default,,0000,0000,0000,,{\i1}Thế thì rốt cuộc bọn mình nhọc công mang thứ của nợ này{\i0}\N{\i1}đến tận đây để làm cái quái gì cơ chứ?!{\i0}
Dialogue: 0,0:06:12.47,0:06:13.59,Default,,0000,0000,0000,,{\i1}Chết tiệt thật!{\i0}
Dialogue: 0,0:06:14.20,0:06:17.10,Default,,0000,0000,0000,,{\i1}Thế còn phái đoàn thanh sát thì sao rồi,{\i0}\N{\i1}họ chừng nào mới đến hả Thiếu tá?{\i0}
Dialogue: 0,0:06:17.50,0:06:21.63,Default,,0000,0000,0000,,{\i1}Batou, anh hãy lập tức mang theo số plutonium đó{\i0}\N{\i1}và hướng thẳng về phía cây cầu ngay đi.{\i0}
Dialogue: 0,0:06:22.07,0:06:24.98,Default,,0000,0000,0000,,{\i1}Chúng đang toan tính phóng quả tên lửa hạt nhân đó{\i0}\N{\i1}trước khi đoàn thanh sát kịp đặt chân tới đây!{\i0}
Dialogue: 0,0:06:25.75,0:06:28.81,Default,,0000,0000,0000,,{\i1}Hãy giao nộp khối plutonium cho lực lượng Phòng vệ{\i0}\N{\i1}đang trấn giữ cây cầu...{\i0}
Dialogue: 0,0:06:28.92,0:06:30.31,Default,,0000,0000,0000,,{\i1}...và giải thích toàn bộ tình hình thực tế{\i0}\N{\i1}cho bọn họ hiểu!{\i0}
Dialogue: 0,0:06:30.45,0:06:32.51,Default,,0000,0000,0000,,{\i1}Không được, Thiếu tá mau rời khỏi{\i0}\N{\i1}chỗ đó trước đi.{\i0}
Dialogue: 0,0:06:32.75,0:06:34.98,Default,,0000,0000,0000,,{\i1}Hiện tại bọn tôi đang bị vài vị khách nguy hiểm{\i0}\N{\i1}bám sát gót phía sau này.{\i0}
Dialogue: 0,0:06:35.09,0:06:38.28,Default,,0000,0000,0000,,{\i1}Bọn tôi sẽ cố gắng di chuyển nhanh nhất có thể,{\i0}\N{\i1}nhưng tình hình ở đây có nguy cơ trở nên khá căng thẳng đấy.{\i0}
Dialogue: 0,0:06:38.46,0:06:40.29,Default,,0000,0000,0000,,{\i1}Kẻ nào đang bám đuôi các anh?{\i0}
Dialogue: 0,0:06:40.46,0:06:42.29,Default,,0000,0000,0000,,{\i1}Theo tôi đoán thì là lực lượng Biệt kích Ranger{\i0}\N{\i1}thuộc Đội 4.{\i0}
Dialogue: 0,0:06:42.66,0:06:43.86,Default,,0000,0000,0000,,{\i1}Anh có chắc chắn{\i0}\N{\i1}về chuyện đó không?{\i0}
Dialogue: 0,0:06:43.96,0:06:47.99,Default,,0000,0000,0000,,{\i1}Chắc chắn. Xem ra chúng bám đuôi đến tận đây{\i0}\N{\i1}chỉ để đoạt lại khối plutonium.{\i0}
Dialogue: 0,0:06:48.33,0:06:51.39,Default,,0000,0000,0000,,{\i1}Tôi sẽ sớm đến hội quân với các anh.{\i0}\N{\i1}Bằng mọi giá phải cắt đuôi được bọn chúng.{\i0}
Dialogue: 0,0:06:51.67,0:06:53.37,Default,,0000,0000,0000,,{\i1}Bọn tôi sẽ dốc hết sức mình.{\i0}
Dialogue: 0,0:06:53.47,0:06:54.80,Default,,0000,0000,0000,,Di chuyển thôi!
Dialogue: 0,0:07:09.06,0:07:12.22,Default,,0000,0000,0000,,Chúng ta đã gặp nhau bao nhiêu lần rồi nhỉ?\NĐây là lần thứ ba? Hay là thứ tư?
Dialogue: 0,0:07:13.26,0:07:14.49,Default,,0000,0000,0000,,Tại sao cô lại bám theo tôi?
Dialogue: 0,0:07:16.83,0:07:19.16,Default,,0000,0000,0000,,Bọn tôi đã phải tốn rất nhiều công sức\Nmới đến được tận nơi này.
Dialogue: 0,0:07:19.27,0:07:21.50,Default,,0000,0000,0000,,Bọn tôi mang theo plutonium tới,\Nđúng như những gì đã nói.
Dialogue: 0,0:07:21.60,0:07:22.93,Default,,0000,0000,0000,,Đi cùng tôi đi.
Dialogue: 0,0:07:23.04,0:07:25.60,Default,,0000,0000,0000,,Nếu cậu không đi, sẽ có vô số người thương vong,\Nbao gồm cả những người tị nạn.
Dialogue: 0,0:07:26.01,0:07:28.94,Default,,0000,0000,0000,,Và bọn chúng sẽ đổ toàn bộ tội lỗi\Nlên đầu của một mình cậu đấy.
Dialogue: 0,0:07:29.68,0:07:31.73,Default,,0000,0000,0000,,Chuyện gì sắp sửa xảy ra vậy?
Dialogue: 0,0:07:32.01,0:07:35.74,Default,,0000,0000,0000,,Tôi đoán là một vụ tấn công hạt nhân ngụy tạo,\Ndưới vỏ bọc người tị nạn tự kích nổ bom tự sát.
Dialogue: 0,0:07:36.08,0:07:37.07,Default,,0000,0000,0000,,Cái gì cơ?!
Dialogue: 0,0:07:41.45,0:07:42.89,Default,,0000,0000,0000,,Cô rốt cuộc {\i1}là ai{\i0}?
Dialogue: 0,0:07:47.79,0:07:50.85,Default,,0000,0000,0000,,Này, nhìn chỗ này xem! Cửa khoang phóng trên tàu ngầm\Nđang bắt đầu mở ra kìa!
Dialogue: 0,0:07:51.06,0:07:53.90,Default,,0000,0000,0000,,Tệ thật rồi... Bọn chúng có thể\Nphóng tên lửa bất cứ lúc nào!
Dialogue: 0,0:07:54.00,0:07:56.99,Default,,0000,0000,0000,,Loại tên lửa này sẽ bay vọt\Nlên tận tầng bình lưu!
Dialogue: 0,0:07:57.84,0:08:00.90,Default,,0000,0000,0000,,Xem ra chúng muốn vụ tấn công này\Ndiễn ra trong bí mật mà không ai hay biết.
Dialogue: 0,0:08:02.11,0:08:04.54,Default,,0000,0000,0000,,Dù cho chúng có tẩy rửa sạch bụi phóng xạ đi chăng nữa,\Nbán kính vụ nổ cũng sẽ khủng khiếp đến mức...
Dialogue: 0,0:08:04.64,0:08:07.41,Default,,0000,0000,0000,,...xóa sổ toàn bộ binh sĩ Phòng vệ\Nđang được triển khai tại Nagasaki và Dejima!
Dialogue: 0,0:08:08.18,0:08:13.05,Default,,0000,0000,0000,,Lũ đó điên thật rồi... Chẳng lẽ không có cách nào\Nđể chúng ta ngăn chặn vụ phóng này sao?
Dialogue: 0,0:08:13.29,0:08:16.19,Default,,0000,0000,0000,,Nếu chúng ta phát tán đoạn video ghi hình trực tiếp này\Nra toàn thế giới thì sao?
Dialogue: 0,0:08:16.29,0:08:20.12,Default,,0000,0000,0000,,Sẽ chẳng có ích lợi gì đâu.\NHình ảnh thời nay chẳng còn chứng minh được điều gì nữa.
Dialogue: 0,0:08:20.26,0:08:22.92,Default,,0000,0000,0000,,Nó cũng chỉ biến thành một trò tiêu khiển mua vui\Ncho đám đông ngoài cuộc vô can mà thôi,
Dialogue: 0,0:08:23.03,0:08:25.79,Default,,0000,0000,0000,,một hình ảnh không rõ nguồn gốc xuất hiện\Nvào một thời điểm quá đỗi thuận tiện.
Dialogue: 0,0:08:25.93,0:08:27.46,Default,,0000,0000,0000,,N-Nhưng, nếu chúng ta không\Nlàm gì đó...
Dialogue: 0,0:08:27.57,0:08:31.63,Default,,0000,0000,0000,,Này, có vẻ như các tuần dương hạm Aegis\Nsắp sửa phóng tên lửa tấn công...
Dialogue: 0,0:08:31.74,0:08:33.23,Default,,0000,0000,0000,,...ngay trước khi đòn đánh hạt nhân nổ ra!
Dialogue: 0,0:08:47.45,0:08:48.55,Default,,0000,0000,0000,,{\i1}Chúng đuổi kịp chúng ta rồi sao?{\i0}
Dialogue: 0,0:08:48.65,0:08:49.81,Default,,0000,0000,0000,,{\i1}Có vẻ là vậy.{\i0}
Dialogue: 0,0:08:50.26,0:08:53.69,Default,,0000,0000,0000,,{\i1}Chúng đã chuyển sang một đội hình khác.{\i0}\N{\i1}Kích hoạt tàng hình quang học ngay.{\i0}
Dialogue: 0,0:08:54.66,0:08:58.26,Default,,0000,0000,0000,,{\i1}Tachikoma, các cậu có thể định vị tín hiệu mã hóa của chúng{\i0}\N{\i1}rồi tiến hành phản công mạng được không?{\i0}
Dialogue: 0,0:08:58.83,0:09:01.63,Default,,0000,0000,0000,,{\i1}Bọn em sẽ thử xem sao,{\i0}\N{\i1}nhưng các anh phải hết sức cẩn thận đấy.{\i0}
Dialogue: 0,0:09:01.87,0:09:04.34,Default,,0000,0000,0000,,{\i1}Sắp có một đợt tấn công tên lửa{\i0}\N{\i1}từ các tuần dương hạm Aegis rồi.{\i0}
Dialogue: 0,0:09:04.87,0:09:07.46,Default,,0000,0000,0000,,{\i1}Bọn em không nghĩ chúng sẽ bắn thẳng{\i0}\N{\i1}vào khu dân cư đâu,{\i0}
Dialogue: 0,0:09:07.57,0:09:09.80,Default,,0000,0000,0000,,{\i1}nhưng không ai đoán trước được tên lửa{\i0}\N{\i1}sẽ rơi xuống những điểm nào đâu.{\i0}
Dialogue: 0,0:09:10.21,0:09:11.40,Default,,0000,0000,0000,,{\i1}Thế còn quả tên lửa hạt nhân kia{\i0}\N{\i1}thì sao rồi?{\i0}
Dialogue: 0,0:09:11.84,0:09:13.14,Default,,0000,0000,0000,,{\i1}Nó vẫn chưa{\i0}\N{\i1}được khai hỏa.{\i0}
Dialogue: 0,0:09:14.88,0:09:16.97,Default,,0000,0000,0000,,{\i1}Bọn chúng đúng là chẳng thèm lãng phí chút thời gian nào{\i0}\N{\i1}để bắt đầu hành động cả...{\i0}
Dialogue: 0,0:09:22.32,0:09:23.72,Default,,0000,0000,0000,,{\i1}Phía bên này cũng có{\i0}\N{\i1}động tĩnh rồi.{\i0}
Dialogue: 0,0:09:33.70,0:09:35.33,Default,,0000,0000,0000,,Chết tiệt, chúng bắt đầu rồi.
Dialogue: 0,0:09:35.43,0:09:38.23,Default,,0000,0000,0000,,Chúng ta không còn nhiều thời gian nữa đâu.\NCậu và tôi sẽ cùng nhau đầu hàng Lực lượng Phòng vệ.
Dialogue: 0,0:09:38.34,0:09:40.64,Default,,0000,0000,0000,,Tôi sẽ {\i1}lôi cổ{\i0} cậu đến đó\Nnếu bắt buộc phải làm vậy.
Dialogue: 0,0:09:43.98,0:09:45.44,Default,,0000,0000,0000,,Cậu quyết định thế nào?
Dialogue: 0,0:09:46.08,0:09:50.91,Default,,0000,0000,0000,,Được thôi. Tôi đang giải thích cặn kẽ tình hình cho\Nnhững người tị nạn đang kết nối với tôi hiểu.
Dialogue: 0,0:09:51.25,0:09:55.58,Default,,0000,0000,0000,,Tôi sẽ để họ tự đưa ra quyết định cuối cùng, nhưng\Ntạm thời lúc này, hãy cùng hướng về phía cây cầu.
Dialogue: 0,0:10:08.13,0:10:10.00,Default,,0000,0000,0000,,{\i1}Tachikoma, hãy cho tôi xem{\i0}\N{\i1}quỹ đạo đường bay của...{\i0}
Dialogue: 0,0:10:42.43,0:10:46.80,Top Secondary Dialog 1080P,,0000,0000,0000,,Đòn phản công của Lực lượng Phòng vệ đáp trả lại\Ncuộc tấn công tên lửa từ Dejima đã chính thức bắt đầu!
Dialogue: 0,0:10:47.41,0:10:50.44,Top Secondary Dialog 1080P,,0000,0000,0000,,Theo các tuyên bố chính thức từ chính phủ,\Nđây là biện pháp bắt buộc phải thực thi...
Dialogue: 0,0:10:49.11,0:10:50.44,Default,,0000,0000,0000,,{\i1}Chà, xem ra mọi chuyện{\i0}\N{\i1}đã bắt đầu thật rồi...{\i0}
Dialogue: 0,0:10:50.54,0:10:53.91,Top Secondary Dialog 1080P,,0000,0000,0000,,...nhằm bảo đảm an ninh toàn diện khu vực\Nđể đón phái đoàn thanh sát Liên Hợp Quốc.
Dialogue: 0,0:10:51.68,0:10:54.58,Default,,0000,0000,0000,,{\i1}Tachikoma, Thiếu tá và mọi người{\i0}\N{\i1}vẫn ổn cả chứ?{\i0}
Dialogue: 0,0:10:53.98,0:10:57.05,Top Secondary Dialog 1080P,,0000,0000,0000,,Tôi xin nhắc lại, một đợt phản kích dữ dội\Ncủa Lực lượng Phòng vệ đã...
Dialogue: 0,0:10:54.58,0:10:58.68,Default,,0000,0000,0000,,{\i1}Bọn em đã mất liên lạc với Thiếu tá rồi.{\i0}\N{\i1}Nhưng anh Batou và những người khác vẫn an toàn.{\i0}
Dialogue: 0,0:10:59.25,0:11:00.65,Default,,0000,0000,0000,,{\i1}Và đúng là Đội 4{\i0}\N{\i1}đang đuổi theo họ sao?{\i0}
Dialogue: 0,0:11:00.65,0:11:01.52,Default,,0000,0000,0000,,{\i1}Vâng, đúng vậy thưa sếp.{\i0}
Dialogue: 0,0:11:02.05,0:11:03.99,Default,,0000,0000,0000,,{\i1}Xin lỗi vì đã để mọi người phải đợi lâu!{\i0}
Dialogue: 0,0:11:05.26,0:11:08.12,Default,,0000,0000,0000,,Nghe những bản tin chiến sự dồn dập từ Dejima\Nmà lòng tôi nóng như lửa đốt đây này!
Dialogue: 0,0:11:08.26,0:11:10.35,Default,,0000,0000,0000,,Cậu cứ sốt ruột lo lắng suông như thế\Nthì giải quyết được trò trống gì?
Dialogue: 0,0:11:10.60,0:11:13.83,Default,,0000,0000,0000,,Hãy tập trung làm trọn vẹn mọi điều chúng ta\Ncó thể làm ngay tại nơi này, vào lúc này.
Dialogue: 0,0:11:14.23,0:11:15.00,Default,,0000,0000,0000,,Rõ rồi!
Dialogue: 0,0:11:35.39,0:11:36.68,Default,,0000,0000,0000,,Cậu có sao không?
Dialogue: 0,0:11:38.09,0:11:38.95,Default,,0000,0000,0000,,Tôi không sao.
Dialogue: 0,0:11:41.16,0:11:43.06,Default,,0000,0000,0000,,Có vẻ như tình hình bên ngoài\Ntạm thời đã lắng xuống đôi chút.
Dialogue: 0,0:11:46.07,0:11:47.50,Default,,0000,0000,0000,,{\i1}Tachikoma, báo cáo tình hình.{\i0}
Dialogue: 0,0:11:48.67,0:11:50.73,Default,,0000,0000,0000,,Thiếu tá! Chị vẫn bình an vô sự!
Dialogue: 0,0:11:50.84,0:11:52.63,Default,,0000,0000,0000,,{\i1}Ừ, bằng cách nào đó vẫn sống sót.{\i0}
Dialogue: 0,0:11:52.84,0:11:56.07,Default,,0000,0000,0000,,{\i1}Tên lửa hạt nhân có thể được phóng đi{\i0}\N{\i1}vào bất cứ phút nào lúc này.{\i0}
Dialogue: 0,0:11:56.81,0:11:59.04,Default,,0000,0000,0000,,{\i1}Chị phải rời khỏi khu vực đó{\i0}\N{\i1}ngay lập tức đi!{\i0}
Dialogue: 0,0:11:59.95,0:12:01.74,Default,,0000,0000,0000,,{\i1}Đã có tuyên bố chính thức nào{\i0}\N{\i1}từ phía chính phủ chưa?{\i0}
Dialogue: 0,0:12:01.88,0:12:04.54,Default,,0000,0000,0000,,{\i1}Họ vừa thông báo sẽ tiến hành{\i0}\N{\i1}một loạt đợt không kích hạn chế...{\i0}
Dialogue: 0,0:12:04.65,0:12:06.85,Default,,0000,0000,0000,,{\i1}...nhằm dọn đường đưa{\i0}\N{\i1}đoàn thanh sát vào.{\i0}
Dialogue: 0,0:12:07.62,0:12:10.02,Default,,0000,0000,0000,,Vô ích thôi. Xem ra chúng ta\Nđã bị chôn vùi bên trong rồi.
Dialogue: 0,0:12:10.56,0:12:11.45,Default,,0000,0000,0000,,Bị kẹt rồi sao?
Dialogue: 0,0:12:11.56,0:12:13.02,Default,,0000,0000,0000,,{\i1}Thiếu tá, đừng nói là chị đang...{\i0}
Dialogue: 0,0:12:13.16,0:12:14.99,Default,,0000,0000,0000,,{\i1}Đúng vậy. Tôi đang bị mắc kẹt hoàn toàn{\i0}\N{\i1}dưới một đống đổ nát khổng lồ.{\i0}
Dialogue: 0,0:12:15.09,0:12:17.46,Default,,0000,0000,0000,,{\i1}Có vẻ như lúc này tôi phải giao lại{\i0}\N{\i1}toàn bộ trọng trách vào tay Batou rồi.{\i0}
Dialogue: 0,0:12:17.56,0:12:20.62,Default,,0000,0000,0000,,{\i1}Trời ơi không! Không còn cách nào{\i0}\N{\i1}để chị thoát ra ngoài sao?{\i0}
Dialogue: 0,0:12:20.87,0:12:25.50,Default,,0000,0000,0000,,{\i1}Tôi sẽ thử tìm mọi cách, nhưng các cậu hãy dồn toàn bộ{\i0}\N{\i1}sự chú ý vào việc hỗ trợ cho nhóm của Batou.{\i0}
Dialogue: 0,0:12:25.84,0:12:27.00,Default,,0000,0000,0000,,{\i1}Rõ ạ!{\i0}
Dialogue: 0,0:12:28.34,0:12:30.50,Default,,0000,0000,0000,,Cậu vẫn đang liên kết não\Nvới những người tị nạn chứ?
Dialogue: 0,0:12:30.64,0:12:33.67,Default,,0000,0000,0000,,Đúng vậy. Phần lớn bọn họ\Nđã quay trở lại kết nối.
Dialogue: 0,0:12:34.18,0:12:38.12,Default,,0000,0000,0000,,Tuy nhiên có vẻ đa số đều đang rơi vào hoảng loạn\Ntrước đợt không kích dồn dập vừa rồi.
Dialogue: 0,0:12:42.96,0:12:44.62,Default,,0000,0000,0000,,Lúc nãy cô có đề cập đến\Nmột vụ tấn công hạt nhân.
Dialogue: 0,0:12:45.69,0:12:50.06,Default,,0000,0000,0000,,Làm sao cô nắm được thông tin đó?\NCô đang làm việc cho tổ chức nào?
Dialogue: 0,0:12:50.53,0:12:52.86,Default,,0000,0000,0000,,Nói ra có thể cậu không tin đâu,\Nnhưng tôi là một cảnh sát.
Dialogue: 0,0:12:53.10,0:12:56.16,Default,,0000,0000,0000,,Trong quá trình điều tra tội ác\Ncủa nhóm Mười Một Cá Nhân,
Dialogue: 0,0:12:56.27,0:13:00.60,Default,,0000,0000,0000,,chúng tôi đã bóc trần một dự án nằm sâu trong chính phủ\Nnhằm mục đích cưỡng bức di dời người tị nạn.
Dialogue: 0,0:13:00.84,0:13:03.43,Default,,0000,0000,0000,,Chúng tôi bám theo cậu suốt thời gian qua\Nchính là để vạch trần âm mưu đó.
Dialogue: 0,0:13:03.81,0:13:05.50,Default,,0000,0000,0000,,Nếu sự thật đúng là như vậy,\Ntại sao các người lại mang khối plutonium đến đây?
Dialogue: 0,0:13:06.11,0:13:09.77,Default,,0000,0000,0000,,Bởi vì chúng tôi biết rõ cậu chưa từng\Nđược trao cho bất kỳ khối plutonium nào.
Dialogue: 0,0:13:09.88,0:13:13.41,Default,,0000,0000,0000,,Nên chúng tôi đã đánh cắp quả bom hạt nhân\Ntừng được sử dụng ở Fukuoka...
Dialogue: 0,0:13:13.75,0:13:17.05,Default,,0000,0000,0000,,...và dự định dùng nó làm bằng chứng xác thực\Nđể giải quyết ổn thỏa cục diện khủng hoảng này.
Dialogue: 0,0:13:17.62,0:13:20.96,Default,,0000,0000,0000,,Thế nhưng kế hoạch do kẻ thù giăng ra\Nlại diễn biến nhanh hơn nhiều so với dự tính của chúng tôi.
Dialogue: 0,0:13:21.06,0:13:25.50,Default,,0000,0000,0000,,Chúng tôi không bao giờ ngờ rằng hắn lại dám bắt tay\Nvới Đế chế Mỹ để thực hiện một đòn hủy diệt hạt nhân.
Dialogue: 0,0:13:26.17,0:13:28.00,Default,,0000,0000,0000,,Vậy chuyện gì đã xảy ra với\Nkhối plutonium đó rồi?
Dialogue: 0,0:13:28.27,0:13:31.13,Default,,0000,0000,0000,,Đồng đội của tôi lẽ ra đang trên đường áp giải nó\Nđến giao cho Lực lượng Phòng vệ,
Dialogue: 0,0:13:31.24,0:13:33.23,Default,,0000,0000,0000,,nhưng họ đã bị một đội quân bám đuôi\Nbao vây cô lập,
Dialogue: 0,0:13:33.34,0:13:35.31,Default,,0000,0000,0000,,nên lúc này chuyện đó\Ncũng trở nên vô cùng gian nan rồi.
Dialogue: 0,0:13:35.64,0:13:36.51,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:13:37.51,0:13:40.67,Default,,0000,0000,0000,,Vậy, cô đã từ bỏ ý định\Nbắt tôi phải ra đầu thú rồi sao?
Dialogue: 0,0:13:41.05,0:13:43.11,Default,,0000,0000,0000,,Tôi không hẳn là đã từ bỏ\Ný định đó, nhưng mà...
Dialogue: 0,0:14:01.73,0:14:04.70,Default,,0000,0000,0000,,Tôi đã tắt bỏ toàn bộ tính năng phân vùng và lọc\Ntrên não điện tử trung tâm của mình từ lúc nãy rồi.
Dialogue: 0,0:14:05.44,0:14:09.24,Default,,0000,0000,0000,,Bất kỳ ai muốn đều có thể kết nối vào và chứng kiến\Ntất cả những gì đang diễn ra ngay tại nơi này.
Dialogue: 0,0:14:11.58,0:14:16.11,Default,,0000,0000,0000,,Chúng ta có thể tìm cách thoát khỏi đây, nhưng tôi cũng sẽ\Ntiến hành cuộc cách mạng của mình cùng một lúc.
Dialogue: 0,0:14:16.45,0:14:19.75,Default,,0000,0000,0000,,Tôi đã hạ quyết tâm thực hiện điều đó đến cùng ngay khi\Ncô nói cho tôi biết về cuộc tấn công hạt nhân sắp tới.
Dialogue: 0,0:14:20.49,0:14:23.72,Default,,0000,0000,0000,,Hạ quyết tâm sao?\NÝ cậu là gì, cuộc cách mạng nào cơ?
Dialogue: 0,0:14:26.46,0:14:29.89,Default,,0000,0000,0000,,{\i1}Tachikoma, các cậu vẫn chưa phản công mạng được{\i0}\N{\i1}vào hệ thống liên lạc của chúng hay sao?{\i0}
Dialogue: 0,0:14:30.20,0:14:34.66,Default,,0000,0000,0000,,{\i1}Chưa được, thưa anh. Dường như chúng đang liên tục thay đổi{\i0}\N{\i1}mã hóa ngẫu nhiên dựa trên các số nguyên tố.{\i0}
Dialogue: 0,0:14:35.73,0:14:36.67,Default,,0000,0000,0000,,Nằm xuống mau!
Dialogue: 0,0:14:47.05,0:14:48.67,Default,,0000,0000,0000,,{\i1}- Bọn tôi đang tiến ra ngoài.{\i0}\N{\i1}- Rõ rồi.{\i0}
Dialogue: 0,0:14:50.65,0:14:52.95,Default,,0000,0000,0000,,{\i1}Bọn tôi đang ra ngoài trời.{\i0}\N{\i1}Tachikoma, vụ phản công mạng đến đâu rồi?{\i0}
Dialogue: 0,0:14:53.05,0:14:54.31,Default,,0000,0000,0000,,{\i1}Chỉ một chút nữa thôi ạ!{\i0}
Dialogue: 0,0:15:06.00,0:15:10.03,Default,,0000,0000,0000,,Kuze, tại sao cậu lại trở thành\Nthủ lĩnh của người tị nạn?
Dialogue: 0,0:15:13.51,0:15:17.87,Default,,0000,0000,0000,,Và làm cách nào ngay từ đầu cậu đã tự mình\Nthoát khỏi sự thao túng tâm trí của virus?
Dialogue: 0,0:15:19.18,0:15:22.64,Default,,0000,0000,0000,,Tôi vốn đã có một lý tưởng rõ ràng từ trước.\NĐó là giải phóng cho những người tị nạn.
Dialogue: 0,0:15:23.18,0:15:26.05,Default,,0000,0000,0000,,Điều đó đã khiến virus Mười Một Cá Nhân\Nbị kích hoạt trong tôi,
Dialogue: 0,0:15:26.39,0:15:30.72,Default,,0000,0000,0000,,nhưng khi cùng hành động với chúng, tôi nhận thấy một sự\Nbất đồng sâu sắc giữa hệ tư tưởng của chúng và tôi.
Dialogue: 0,0:15:31.22,0:15:33.78,Default,,0000,0000,0000,,Có lẽ chính vì vậy mà tôi mới có thể\Ntự giải phóng mình khỏi ách khống chế của con virus.
Dialogue: 0,0:15:34.63,0:15:36.82,Default,,0000,0000,0000,,Nhưng tại sao cậu lại cố chấp với việc\Ngiải phóng người tị nạn đến vậy?
Dialogue: 0,0:15:36.93,0:15:40.30,Default,,0000,0000,0000,,Tôi nghe nói cậu từng có thời gian phiêu bạt khắp Á-Âu,\Nchuyện đó có liên quan gì đến việc này không?
Dialogue: 0,0:15:41.17,0:15:43.79,Default,,0000,0000,0000,,Chẳng có mối liên hệ trực tiếp nào cả.
Dialogue: 0,0:15:45.07,0:15:50.10,Default,,0000,0000,0000,,Tôi rong ruổi khắp đại lục chẳng qua là vì\Ntôi muốn có thời gian để tái khẳng định động cơ của chính mình.
Dialogue: 0,0:15:50.81,0:15:55.87,Default,,0000,0000,0000,,Tôi tự hỏi liệu bản thân có đủ sức tiến hành\Ncuộc cách mạng, sự giải phóng mà tôi hằng ấp ủ hay không.
Dialogue: 0,0:15:56.42,0:15:58.85,Default,,0000,0000,0000,,\"Cuộc cách mạng\" mà cậu luôn miệng nhắc tới đó\Nrốt cuộc là thứ gì?
Dialogue: 0,0:15:58.95,0:16:01.82,Default,,0000,0000,0000,,Sự chuyển dịch của loài người\Nlên kiến trúc thượng tầng.
Dialogue: 0,0:16:02.15,0:16:07.68,Default,,0000,0000,0000,,Để con người rũ bỏ hệ thống xã hội đã hóa thạch\Nmà hòa làm một với không gian mạng.
Dialogue: 0,0:16:11.40,0:16:13.76,Default,,0000,0000,0000,,Hòa làm một với không gian mạng sao?
Dialogue: 0,0:16:18.37,0:16:20.63,Default,,0000,0000,0000,,Tiến độ giải mã các kênh liên lạc của Đội 4\Nđến đâu rồi các cậu?
Dialogue: 0,0:16:22.07,0:16:23.41,Default,,0000,0000,0000,,Sắp xong rồi đây...
Dialogue: 0,0:16:23.78,0:16:26.77,Default,,0000,0000,0000,,Liệu có cách nào để chúng ta\Nhack thẳng vào chiếc tàu ngầm hạt nhân đó không?
Dialogue: 0,0:16:26.95,0:16:28.34,Default,,0000,0000,0000,,Chuyện đó hoàn toàn bất khả thi.
Dialogue: 0,0:16:29.05,0:16:33.07,Default,,0000,0000,0000,,Trong suốt quá trình tác chiến, tàu ngầm hạt nhân\Nluôn ở trạng thái hoàn toàn độc lập tách biệt mạng.
Dialogue: 0,0:16:33.45,0:16:35.44,Default,,0000,0000,0000,,Thế còn những email cá nhân\Ncủa các thủy thủ đoàn thì sao?
Dialogue: 0,0:16:36.12,0:16:38.72,Default,,0000,0000,0000,,Biết đâu ta có thể lần theo một gã thủy thủ nào đó\Nlén lút phá vỡ quân quy để phản công mạng!
Dialogue: 0,0:16:38.82,0:16:41.38,Default,,0000,0000,0000,,Ồ, tôi hiểu ý cậu rồi! Ý tưởng đó rất đáng\Nđể thử nghiệm đấy!
Dialogue: 0,0:16:47.13,0:16:49.00,Default,,0000,0000,0000,,Thưa Trưởng ban, tôi đã đưa ngài ấy tới rồi.
Dialogue: 0,0:16:49.13,0:16:50.53,Default,,0000,0000,0000,,Proto, mở cửa ra mau.
Dialogue: 0,0:16:52.70,0:16:55.20,Default,,0000,0000,0000,,Thủ tướng Kayabuki,\Nngài vẫn bình an chứ?
Dialogue: 0,0:16:55.77,0:16:57.44,Default,,0000,0000,0000,,Tôi đã nắm bắt được toàn bộ\Ntình hình hiện tại rồi.
Dialogue: 0,0:16:58.38,0:17:01.11,Default,,0000,0000,0000,,Các ông có thể kết nối đường dây nóng của tôi tới\NĐế chế Mỹ thông qua căn phòng này được không?
Dialogue: 0,0:17:02.18,0:17:04.94,Default,,0000,0000,0000,,Tôi sẽ đích thân yêu cầu bọn họ\Nlập tức đình chỉ cuộc tấn công hạt nhân.
Dialogue: 0,0:17:05.22,0:17:09.52,Default,,0000,0000,0000,,Xin ngài hãy làm vậy. Tất cả lúc này hoàn toàn phụ thuộc vào việc\Nbọn họ có nhận thức được những gì đang thực sự diễn ra hay không.
Dialogue: 0,0:17:10.22,0:17:11.81,Default,,0000,0000,0000,,Ông nói rất có lý.
Dialogue: 0,0:17:26.31,0:17:28.77,Default,,0000,0000,0000,,Đứng im tại chỗ. Chúng tao\Nđã bao vây các người hoàn toàn rồi.
Dialogue: 0,0:17:29.11,0:17:31.51,Default,,0000,0000,0000,,Hãy đặt khối plutonium xuống và tắt ngay\Nchế độ tàng hình quang học đi!
Dialogue: 0,0:17:32.01,0:17:33.74,Default,,0000,0000,0000,,{\i1}Anh Batou! Tín hiệu phản công mạng{\i0}\N{\i1}đã được thiết lập thành công!{\i0}
Dialogue: 0,0:17:33.85,0:17:35.78,Default,,0000,0000,0000,,Được rồi, tôi đang\Nđặt nó xuống đây!
Dialogue: 0,0:17:37.02,0:17:39.95,Default,,0000,0000,0000,,{\i1}Trong lúc tôi đặt chiếc vali xuống, các cậu hãy giữ nguyên tàng hình{\i0}\N{\i1}và lập tức tản nhanh về phía bờ tường.{\i0}
Dialogue: 0,0:17:40.05,0:17:41.35,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:17:45.29,0:17:46.19,Default,,0000,0000,0000,,Cái gì thế này...?!
Dialogue: 0,0:17:50.66,0:17:52.79,Default,,0000,0000,0000,,Ngừng bắn ngay!\NBắn trúng người của mình bây giờ!
Dialogue: 0,0:17:56.27,0:17:58.76,Default,,0000,0000,0000,,Bây giờ tôi sẽ tắt\Nchế độ tàng hình quang học.
Dialogue: 0,0:17:59.24,0:18:03.33,Default,,0000,0000,0000,,Nếu sau khi nhìn thấy tôi mà các anh vẫn muốn thi hành nhiệm vụ,\Nthì cứ việc nổ súng bắn chết tôi đi.
Dialogue: 0,0:18:03.94,0:18:06.93,Default,,0000,0000,0000,,Nhưng nếu khuôn mặt này thuyết phục được các anh nghĩ lại,\Nthì hãy lắng nghe những gì tôi sắp nói.
Dialogue: 0,0:18:07.05,0:18:08.54,Default,,0000,0000,0000,,Đây là vấn đề liên quan đến\Nsự sống còn của hàng triệu sinh mạng!
Dialogue: 0,0:18:13.59,0:18:15.14,Default,,0000,0000,0000,,Anh là...
Dialogue: 0,0:18:21.19,0:18:23.79,Default,,0000,0000,0000,,Đôi mắt máy đó...\NTrước đây anh từng là lính Biệt kích Ranger sao?
Dialogue: 0,0:18:24.13,0:18:25.32,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:18:27.83,0:18:31.36,Default,,0000,0000,0000,,Những trải nghiệm nơi bán đảo chiến trường xưa\Nđã giúp tôi thấu suốt được bản chất của cuộc đời.
Dialogue: 0,0:18:32.07,0:18:35.34,Default,,0000,0000,0000,,Tôi đã nhìn thấy một trật tự đầy rẫy những mâu thuẫn.\NSự bóc lột tàn nhẫn dưới bàn tay của những kẻ nắm quyền.
Dialogue: 0,0:18:35.67,0:18:37.37,Default,,0000,0000,0000,,Một cấu trúc xã hội\Nđã mục ruỗng tha hóa.
Dialogue: 0,0:18:38.28,0:18:42.98,Default,,0000,0000,0000,,Thế nhưng điều khiến tôi vỡ mộng cay đắng nhất\Nchính là sự vô trách nhiệm tột cùng của đại chúng.
Dialogue: 0,0:18:44.05,0:18:47.95,Default,,0000,0000,0000,,Dù bản thân chẳng hề tự mình tạo ra được bất cứ thứ gì\Nvác cũng chẳng hiểu biết gì,
Dialogue: 0,0:18:48.25,0:18:52.21,Default,,0000,0000,0000,,nhưng hễ quần chúng bắt gặp bất kỳ mẩu thông tin nào\Nhợp với ý muốn hời hợt của họ,
Dialogue: 0,0:18:52.56,0:18:54.53,Default,,0000,0000,0000,,họ lập tức đón nhận nó một cách mù quáng\Nvà cứ thế ngoan ngoãn để bị thao túng.
Dialogue: 0,0:18:54.96,0:18:58.02,Default,,0000,0000,0000,,Những con người không hề có chút cảm giác trách nhiệm,\Nbất kể hậu quả khôn lường ngoài ý muốn...
Dialogue: 0,0:18:58.36,0:19:03.13,Default,,0000,0000,0000,,...do những hành động vô tâm của chính họ gây ra khi\Nlợi dụng một cách cẩu thả hạ tầng của không gian mạng.
Dialogue: 0,0:19:03.84,0:19:07.33,Default,,0000,0000,0000,,Cuộc cách mạng của tôi cũng chính là một sự trả thù\Nnhắm vào những con người như thế.
Dialogue: 0,0:19:08.01,0:19:09.23,Default,,0000,0000,0000,,Trả thù sao?
Dialogue: 0,0:19:10.08,0:19:12.84,Default,,0000,0000,0000,,Tôi mang trên mình một cơ thể nhân tạo toàn phần\Ntừ khi còn là một đứa trẻ,
Dialogue: 0,0:19:13.18,0:19:16.15,Default,,0000,0000,0000,,vì vậy tôi luôn cảm nhận sâu sắc một sự\Nlệch pha xa cách giữa tâm trí và thể xác.
Dialogue: 0,0:19:17.25,0:19:18.74,Default,,0000,0000,0000,,Nếu như một điều kỳ diệu\Nnhư thế có thể xảy ra,
Dialogue: 0,0:19:18.85,0:19:23.12,Default,,0000,0000,0000,,tôi từng khao khát được rũ bỏ thể xác vụng về này\Nđể chèo thuyền dong buồm bước ra đại dương mạng bao la.
Dialogue: 0,0:19:23.72,0:19:28.35,Default,,0000,0000,0000,,Chính những người tị nạn châu Á đã trao cho một kẻ như tôi\Nniềm hy vọng để tiếp tục sống.
Dialogue: 0,0:19:29.63,0:19:33.76,Default,,0000,0000,0000,,Họ khen khuôn mặt nhân tạo vô hồn của tôi\Nlà một gương mặt tuấn tú,
Dialogue: 0,0:19:34.17,0:19:37.47,Default,,0000,0000,0000,,và tâng bốc tôi bằng cách nói rằng\Nhọ có thể nhìn thấy linh hồn Ghost hiện hữu trong đó.
Dialogue: 0,0:19:39.10,0:19:44.60,Default,,0000,0000,0000,,Chính vào khoảnh khắc ấy, lần đầu tiên tôi thấu hiểu sâu sắc rằng\Ntâm hồn và thể xác vốn là hai thứ không thể nào tách rời.
Dialogue: 0,0:19:45.64,0:19:49.01,Default,,0000,0000,0000,,Và tôi đã có thể tự coi bản thân mình\Nnhư một con người thực thụ với thể xác của chính mình.
Dialogue: 0,0:19:50.45,0:19:55.15,Default,,0000,0000,0000,,Thế nhưng, khi họ bắt gặp những thông tin\Nphù hợp với sở thích dễ dãi của họ,
Dialogue: 0,0:19:55.59,0:19:59.22,Default,,0000,0000,0000,,họ lại bị cuốn theo con đường dễ dàng nhất,\Ny hệt như bao kẻ khác trên đời.
Dialogue: 0,0:20:00.29,0:20:05.29,Default,,0000,0000,0000,,Tôi cho rằng rốt cuộc loài người vốn được tạo hóa sinh ra\Nđể luôn chọn lựa đi theo con đường có ít lực cản nhất,
Dialogue: 0,0:20:05.56,0:20:08.76,Default,,0000,0000,0000,,Vậy thì sao? Cậu dự định sẽ tiến hành\Nmàn trả thù của mình như thế nào?
Dialogue: 0,0:20:09.67,0:20:14.23,Default,,0000,0000,0000,,Tôi sẽ đưa toàn bộ ký ức và linh hồn Ghost của những người\Nđang liên kết mạng với tôi đi thẳng vào không gian mạng.
Dialogue: 0,0:20:14.71,0:20:18.40,Default,,0000,0000,0000,,Họ sẽ mất đi thể xác vật lý phàm trần\Nnếu bom hạt nhân giáng xuống nơi này,
Dialogue: 0,0:20:18.94,0:20:21.97,Default,,0000,0000,0000,,nhưng bù lại họ sẽ nhận được cơ hội\Nđể trải qua một cuộc tiến hóa cưỡng bức.
Dialogue: 0,0:20:23.12,0:20:26.88,Default,,0000,0000,0000,,Khả năng họ có thể bảo tồn được\Ntính cá thể của mình trong không gian mạng là bao nhiêu?
Dialogue: 0,0:20:27.32,0:20:28.91,Default,,0000,0000,0000,,Tôi không có câu trả lời\Nchắc chắn cho điều đó.
Dialogue: 0,0:20:29.39,0:20:35.22,Default,,0000,0000,0000,,Thế nhưng với tư cách là những kẻ tiên phong, họ có thể trở thành những thực thể\Nkhai sáng cho những kẻ còn mắc kẹt lại nơi tầng đáy,
Dialogue: 0,0:20:35.56,0:20:37.69,Default,,0000,0000,0000,,không ngừng khiến cho thế giới bên dưới phải luôn nhận thức\Nvề sự tồn tại của kiến trúc thượng tầng.
Dialogue: 0,0:20:38.60,0:20:42.09,Default,,0000,0000,0000,,Hoàn toàn giống như cái cách mà loài người\Ntừng cảm thấy tôn kính và kinh sợ...
Dialogue: 0,0:20:42.43,0:20:44.66,Default,,0000,0000,0000,,...trước những thực thể tâm linh tối cao\Ntừ thuở hồng hoang xa xưa.
Dialogue: 0,0:20:46.24,0:20:50.64,Default,,0000,0000,0000,,Đó chính là sự trả thù, và cũng là sự cứu rỗi của cậu\Ndành cho những kẻ đã từng làm cậu thất vọng sao?
Dialogue: 0,0:20:51.74,0:20:54.37,Default,,0000,0000,0000,,Đúng vậy, dẫu cho tôi vẫn tin rằng\Nđó chính là một cuộc cách mạng.
Dialogue: 0,0:20:56.55,0:20:58.41,Default,,0000,0000,0000,,Tôi nhận thấy cô cũng là một người\Nmang thể máy toàn phần.
Dialogue: 0,0:20:59.52,0:21:01.38,Default,,0000,0000,0000,,Vậy thì hẳn cô cũng từng cảm nhận được\Nnhững nỗi hoài nghi và sợ hãi...
Dialogue: 0,0:21:01.49,0:21:04.32,Default,,0000,0000,0000,,...sinh ra từ sự chênh lệch cách biệt giữa\Nthể xác và tâm hồn, y hệt như tôi.
Dialogue: 0,0:21:08.76,0:21:12.49,Default,,0000,0000,0000,,Cô thấy thế nào?\NCô có muốn cùng đi với tôi không?
Dialogue: 0,0:21:21.34,0:21:24.04,Default,,0000,0000,0000,,Những người tị nạn có thực sự muốn\Nđi theo cậu hay không?
Dialogue: 0,0:21:24.14,0:21:27.04,Default,,0000,0000,0000,,Có, thật đáng buồn là vậy.
Dialogue: 0,0:21:27.68,0:21:33.02,Default,,0000,0000,0000,,Đa số bọn họ đều thích kịch bản tiến hành\N\"cuộc đánh bom hạt nhân tự sát\" hơn.
Dialogue: 0,0:21:33.92,0:21:37.12,Default,,0000,0000,0000,,Có lẽ họ chỉ muốn cảm thấy rằng\Nbản thân không phải là những kẻ bại trận.
Dialogue: 0,0:21:37.96,0:21:42.09,Default,,0000,0000,0000,,Dẫu cho đó cũng chỉ là một sự chọn lựa\Ncon đường dễ dàng nhất mà thôi...
Dialogue: 0,0:21:44.46,0:21:46.05,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:21:47.07,0:21:51.59,Default,,0000,0000,0000,,{\i1}Batou, tôi sẽ thử giải cứu những người tị nạn{\i0}\N{\i1}bằng phương pháp mà Kuze vừa đề xuất.{\i0}
Dialogue: 0,0:21:52.00,0:21:55.23,Default,,0000,0000,0000,,{\i1}Những người còn lại hãy thông báo cho Lực lượng Phòng vệ{\i0}\N{\i1}biết về đòn tấn công hạt nhân ngay đi.{\i0}
Dialogue: 0,0:21:59.38,0:22:01.68,Default,,0000,0000,0000,,{\i1}Batou, anh có đang lắng nghe{\i0}\N{\i1}tôi nói không đấy?{\i0}
Dialogue: 0,0:22:02.31,0:22:05.61,Default,,0000,0000,0000,,{\i1}Con đàn bà điên rồ này!{\i0}\N{\i1}Tôi nhất quyết không để cô đi một mình đâu...{\i0}
Dialogue: 0,0:22:06.32,0:22:09.29,Default,,0000,0000,0000,,Chờ tôi đấy! Không đời nào tôi chịu để cô\Nphải đi một mình đâu đấy!
Dialogue: 0,0:22:22.87,0:22:24.27,Default,,0000,0000,0000,,Bọn họ còn đang\Nchờ đợi điều gì nữa chứ?
Dialogue: 0,0:22:24.37,0:22:25.36,Default,,0000,0000,0000,,Chịu thôi.
Dialogue: 0,0:22:25.47,0:22:27.63,Default,,0000,0000,0000,,Dù sao đi nữa, hãy mau chóng đưa thứ này\Nđến cây cầu đi.
Dialogue: 0,0:22:27.74,0:22:30.97,Default,,0000,0000,0000,,Lục quân Phòng vệ có thể sẽ tin câu chuyện này\Nnếu chính miệng chúng ta nói ra.
Dialogue: 0,0:22:38.18,0:22:41.68,Default,,0000,0000,0000,,Một khi đợt không kích thứ hai kết thúc,\Nhãy lập tức phát lệnh tiến công vào đảo Dejima.
Dialogue: 0,0:22:41.79,0:22:44.12,Default,,0000,0000,0000,,Chúng ta sẽ chuẩn bị sẵn sàng mọi thứ\Nđể đón đoàn thanh sát!
