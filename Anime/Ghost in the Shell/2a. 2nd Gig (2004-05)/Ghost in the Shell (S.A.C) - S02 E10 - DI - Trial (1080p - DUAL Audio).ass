Dialogue: 0,0:01:43.07,0:01:44.77,Default,,0000,0000,0000,,Anh sẽ mua một ít\Ntrên đường về nhà.
Dialogue: 0,0:01:45.08,0:01:47.54,Default,,0000,0000,0000,,{\i1}Cảm ơn anh.{\i0}\N{\i1}Anh biết phải mua cỡ nào rồi chứ?{\i0}
Dialogue: 0,0:01:48.01,0:01:50.91,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Biết rồi. Tã quần cỡ lớn, đúng không?{\i0}
Dialogue: 0,0:01:48.31,0:01:50.91,Default,,0000,0000,0000,,Mẹ ơi! Bố kìa đúng không mẹ?
Dialogue: 0,0:01:51.68,0:01:53.74,Default,,0000,0000,0000,,- Đi mà mẹ! Có phải bố không?\N- Được rồi. Gặp lại anh sau nhé.
Dialogue: 0,0:02:06.03,0:02:07.62,Default,,0000,0000,0000,,Cứu tôi với!
Dialogue: 0,0:02:32.52,0:02:34.49,Default,,0000,0000,0000,,Sao em lại chạy trốn anh?
Dialogue: 0,0:02:38.43,0:02:40.23,Default,,0000,0000,0000,,Ánh mắt đó là có ý gì hả?
Dialogue: 0,0:02:42.70,0:02:43.93,Default,,0000,0000,0000,,Đứng im!
Dialogue: 0,0:02:49.67,0:02:51.11,Default,,0000,0000,0000,,Bỏ súng xuống đất ngay!
Dialogue: 0,0:02:57.28,0:02:59.84,Default,,0000,0000,0000,,Tao đã tắt thụ cảm đau đớn rồi,\Nvô ích thôi.
Dialogue: 0,0:03:26.14,0:03:27.84,Default,,0000,0000,0000,,Cô có sao không?\NCó bị thương ở đâu không?
Dialogue: 0,0:03:49.33,0:03:51.22,Default,,0000,0000,0000,,Thằng khốn, mày {\i1}muốn{\i0} chết à?!
Dialogue: 0,0:03:58.01,0:04:03.34,Default,,0000,0000,0000,,Anh đã bắn mười hai phát.\NVà anh có chắc chắn về điều đó không?
Dialogue: 0,0:04:03.68,0:04:05.55,Default,,0000,0000,0000,,Vâng, tôi chắc chắn.
Dialogue: 0,0:04:07.85,0:04:10.48,Default,,0000,0000,0000,,Có vẻ như chúng tôi sẽ phải giữ anh\Nlại thêm một thời gian nữa.
Dialogue: 0,0:04:14.89,0:04:18.19,Default,,0000,0000,0000,,Có chuyện gì thế này?\NTôi làm việc cho Cục An ninh Công cộng...
Dialogue: 0,0:04:18.50,0:04:23.49,Default,,0000,0000,0000,,Tôi biết điều đó. Nhưng có khả năng\Nsắp diễn ra một phiên điều trần sơ bộ đấy.
Dialogue: 0,0:04:30.31,0:04:31.81,Default,,0000,0000,0000,,Chào cậu.
Dialogue: 0,0:04:31.81,0:04:36.68,Default,,0000,0000,0000,,Tôi là Ueda. Bố mẹ cậu đã thuê\Ntôi làm luật sư bào chữa cho cậu.
Dialogue: 0,0:04:36.88,0:04:38.18,Default,,0000,0000,0000,,Thật may là\Nông đã tới!
Dialogue: 0,0:04:38.18,0:04:40.95,Default,,0000,0000,0000,,Ông có thể lo cho tôi một cơ thể giả\Nmới sớm sớm được không?
Dialogue: 0,0:04:41.45,0:04:43.89,Default,,0000,0000,0000,,Dù tôi chẳng thấy đau đớn gì,\Nnhưng thế này khó chịu chết đi được.
Dialogue: 0,0:04:44.15,0:04:47.42,Default,,0000,0000,0000,,Đừng lo! Tôi sẽ đưa cậu ra khỏi đây\Ntrong vòng hai ngày thôi.
Dialogue: 0,0:04:47.99,0:04:51.72,Default,,0000,0000,0000,,Dù vậy, cậu thấy khó chịu cũng phải thôi,\Nxét đến số phát đạn mà hắn nã vào người cậu.
Dialogue: 0,0:04:52.26,0:04:54.59,Default,,0000,0000,0000,,Việc cậu bắn cô ta thực ra\Nchỉ là tai nạn thôi đúng không?
Dialogue: 0,0:04:56.43,0:05:00.37,Default,,0000,0000,0000,,Cậu đã độ lại cơ thể giả của mình\Nrất nhiều lần rồi, phải không?
Dialogue: 0,0:05:00.37,0:05:01.89,Default,,0000,0000,0000,,Ờ, phải...
Dialogue: 0,0:05:02.71,0:05:05.64,Default,,0000,0000,0000,,Trông như cậu dùng linh kiện\Ntừ nhiều nhà sản xuất khác nhau,
Dialogue: 0,0:05:06.21,0:05:09.20,Default,,0000,0000,0000,,và tôi đoán phần mềm điều khiển\Ncũng bị ghi đè sau mỗi lần nâng cấp.
Dialogue: 0,0:05:09.38,0:05:10.51,Default,,0000,0000,0000,,Ý ông là sao?
Dialogue: 0,0:05:11.85,0:05:15.02,Default,,0000,0000,0000,,Tôi là luật sư chuyên thụ lý các vụ án\Nliên quan đến cơ thể giả.
Dialogue: 0,0:05:15.02,0:05:17.68,Default,,0000,0000,0000,,Vì thế, tôi khá am hiểu\Nvề những trường hợp thế này.
Dialogue: 0,0:05:20.42,0:05:24.92,Default,,0000,0000,0000,,Một vài tác nhân có thể khiến chức năng điều khiển\Ncủa cơ thể phát điên, ngay cả trong điều kiện bình thường.
Dialogue: 0,0:05:26.26,0:05:27.23,Default,,0000,0000,0000,,Bản cáo trạng:
Dialogue: 0,0:05:27.53,0:05:30.59,Default,,0000,0000,0000,,Viện kiểm sát xin khởi tố vụ án\Nliên quan đến hành vi phạm tội dưới đây.
Dialogue: 0,0:05:30.67,0:05:33.19,Default,,0000,0000,0000,,Ngày 9 tháng 9 năm 2032.
Dialogue: 0,0:05:33.50,0:05:37.50,Default,,0000,0000,0000,,Kiểm sát viên Kazuomi Mori,\NViện Kiểm sát Quận Niihama.
Dialogue: 0,0:05:37.84,0:05:39.57,Default,,0000,0000,0000,,Trình Tòa án\NNhân dân Quận Niihama.
Dialogue: 0,0:05:40.11,0:05:42.08,Default,,0000,0000,0000,,Hộ khẩu thường trú,\Ntỉnh Niihama.
Dialogue: 0,0:05:42.08,0:05:45.52,Default,,0000,0000,0000,,Địa chỉ: 2-B-5 Sumiyoshi-dai,\NNiihama.
Dialogue: 0,0:05:45.52,0:05:50.48,Default,,0000,0000,0000,,Nghề nghiệp: Thất nghiệp. Katsuhiko Izumi.\NNgày sinh: 18 tháng 6 năm 2009.
Dialogue: 0,0:05:50.95,0:05:52.48,Default,,0000,0000,0000,,Chi tiết các tội danh:
Dialogue: 0,0:05:52.86,0:05:56.45,Default,,0000,0000,0000,,Sau nhiều lần nỗ lực làm lành bị từ chối\Nbởi cô Yukari Shizuno, 24 tuổi,
Dialogue: 0,0:05:56.89,0:06:02.49,Default,,0000,0000,0000,,y tá tại Bệnh viện Công Niihama,\Nngười từng có quan hệ tình cảm với bị cáo...
Dialogue: 0,0:06:03.67,0:06:05.26,Default,,0000,0000,0000,,Em thật sự không hiểu nổi.
Dialogue: 0,0:06:05.57,0:06:08.66,Default,,0000,0000,0000,,Anh đâu phải tội phạm, tại sao\Nhọ lại giữ anh trong trại tạm giam chứ?
Dialogue: 0,0:06:09.01,0:06:12.87,Default,,0000,0000,0000,,Anh cũng thấy thế, nhưng việc này\Nsẽ giúp phiên tòa kết thúc nhanh hơn.
Dialogue: 0,0:06:13.21,0:06:16.25,Default,,0000,0000,0000,,Vả lại, sự thật là anh đã nổ súng\Ntrong khi không thi hành công vụ,
Dialogue: 0,0:06:16.25,0:06:17.94,Default,,0000,0000,0000,,dù là để {\i1}cứu{\i0}\Nmạng người khác.
Dialogue: 0,0:06:19.05,0:06:21.02,Default,,0000,0000,0000,,Nếu công việc đó bắt anh\Nphải mang súng theo người,
Dialogue: 0,0:06:21.45,0:06:24.08,Default,,0000,0000,0000,,em nghĩ anh nên nghỉ việc\Nở công ty an ninh đó đi.
Dialogue: 0,0:06:24.45,0:06:27.86,Default,,0000,0000,0000,,Nếu anh nghỉ việc, lấy gì\Nnuôi bốn miệng ăn trong nhà đây?
Dialogue: 0,0:06:28.49,0:06:30.25,Default,,0000,0000,0000,,Anh sẽ không sao đâu.
Dialogue: 0,0:06:42.87,0:06:45.03,Default,,0000,0000,0000,,Sếp... Xin lỗi vì để sếp\Nphải đích thân tới tận đây.
Dialogue: 0,0:06:45.18,0:06:49.37,Default,,0000,0000,0000,,Chuyện đã rồi.\NXét trên góc độ nào đó, hành động của cậu rất đáng khen.
Dialogue: 0,0:06:49.85,0:06:53.71,Default,,0000,0000,0000,,Tuy nhiên, vấn đề là cậu đã\Nnổ súng khi không trong ca trực.
Dialogue: 0,0:06:54.18,0:06:56.88,Default,,0000,0000,0000,,Vâng, sếp nói đúng.\NTôi rất lấy làm tiếc về chuyện đó.
Dialogue: 0,0:06:57.35,0:06:59.98,Default,,0000,0000,0000,,Bố của nghi phạm là giám đốc\Nmột tập đoàn lớn.
Dialogue: 0,0:07:00.39,0:07:04.22,Default,,0000,0000,0000,,Tên khốn được thuê để bào chữa cho con trai ông ta\Nlà một cựu kiểm sát viên khét tiếng, kẻ kiếm bộn tiền...
Dialogue: 0,0:07:04.43,0:07:06.19,Default,,0000,0000,0000,,...từ các vụ kiện liên quan\Nđến cơ thể giả.
Dialogue: 0,0:07:06.93,0:07:08.30,Default,,0000,0000,0000,,Hãy cẩn thận đấy.
Dialogue: 0,0:07:09.10,0:07:11.53,Default,,0000,0000,0000,,Hắn ta ư? Tôi sẽ chuẩn bị tinh thần\Ncho tình huống xấu nhất.
Dialogue: 0,0:07:12.24,0:07:14.87,Default,,0000,0000,0000,,Bất cứ lời nào trong phòng thăm gặp\Nkhi cậu đang bị tạm giữ...
Dialogue: 0,0:07:14.87,0:07:16.96,Default,,0000,0000,0000,,...đều có thể bị đối phương\Ndùng để đối chất trước tòa,
Dialogue: 0,0:07:17.27,0:07:19.76,Default,,0000,0000,0000,,nên tôi sẽ để toàn quyền\Nquyết định lại cho cậu.
Dialogue: 0,0:07:20.01,0:07:23.17,Default,,0000,0000,0000,,Tôi hiểu rồi. Nhưng tôi lo\Ncho vợ mình hơn...
Dialogue: 0,0:07:24.08,0:07:25.48,Default,,0000,0000,0000,,Chuyện đó đã thu xếp xong.
Dialogue: 0,0:07:25.68,0:07:27.95,Default,,0000,0000,0000,,Tôi đã bảo cô ấy nếu theo dõi phiên tòa\Nchỉ tổ rước thêm ấm ức vào người,
Dialogue: 0,0:07:27.95,0:07:29.94,Default,,0000,0000,0000,,nên tốt hơn hết\Nlà cô ấy nên về nhà.
Dialogue: 0,0:07:30.25,0:07:31.35,Default,,0000,0000,0000,,Cảm ơn sếp nhiều.
Dialogue: 0,0:07:31.55,0:07:32.99,Default,,0000,0000,0000,,Còn một điều cuối cùng.
Dialogue: 0,0:07:33.92,0:07:39.69,Default,,0000,0000,0000,,Chắc cậu cũng biết rồi, nhưng mọi hình thức truyền tin\Nđều bị nghiêm cấm bên trong phòng xử án.
Dialogue: 0,0:07:40.76,0:07:44.82,Default,,0000,0000,0000,,Chỉ cần phát tín hiệu trên tần số tiêu chuẩn,\Nhọ sẽ lần ra tung tích của cậu ngay.
Dialogue: 0,0:07:45.80,0:07:49.74,Default,,0000,0000,0000,,Đến giờ rồi. Hãy chuẩn bị kỹ\Ncho lời tự bào chữa của mình đi.
Dialogue: 0,0:07:54.11,0:07:55.27,Default,,0000,0000,0000,,Anh Togusa.
Dialogue: 0,0:07:55.91,0:07:59.88,Default,,0000,0000,0000,,Trong bản tường trình, anh khai\Nrằng anh tập trung hỏa lực...
Dialogue: 0,0:07:59.88,0:08:03.61,Default,,0000,0000,0000,,...vào vai và chân của cậu Izumi\Nnhằm ngăn không cho cậu ấy cử động,
Dialogue: 0,0:08:03.99,0:08:07.22,Default,,0000,0000,0000,,nhưng tại sao anh lại phải nã\Nnhiều phát đạn vào cậu ấy như thế?
Dialogue: 0,0:08:07.62,0:08:11.22,Default,,0000,0000,0000,,Nghi phạm mang cơ thể giả và đã tuyên bố\Ntắt bộ phận cảm nhận cơn đau,
Dialogue: 0,0:08:11.73,0:08:14.82,Default,,0000,0000,0000,,nên tôi thấy cần phải\Nvô hiệu hóa hoàn toàn hắn.
Dialogue: 0,0:08:15.43,0:08:21.03,Default,,0000,0000,0000,,Ồ. Theo tôi nhớ, anh khai rằng ban đầu\Nanh đã chặn đứng được kẻ tấn công rồi, đúng chứ?
Dialogue: 0,0:08:21.40,0:08:24.37,Default,,0000,0000,0000,,Đúng vậy. Nhưng kẻ tấn công\Nvẫn chưa chịu buông súng.
Dialogue: 0,0:08:25.01,0:08:29.50,Default,,0000,0000,0000,,Nguyên tắc số một khi bắt giữ\Nlà phải tước vũ khí của tội phạm.
Dialogue: 0,0:08:30.11,0:08:34.11,Default,,0000,0000,0000,,À, ra vậy. Nhưng chúng ta hãy nhìn nhận\Nvấn đề từ một góc độ khác xem sao nhé?
Dialogue: 0,0:08:36.29,0:08:39.69,Default,,0000,0000,0000,,Anh Togusa, anh có biết\Nđây là thứ gì không?
Dialogue: 0,0:08:40.12,0:08:44.39,Default,,0000,0000,0000,,Có. Đó là mẫu súng cùng loại\Nvới khẩu tôi dùng khi làm nhiệm vụ.
Dialogue: 0,0:08:44.89,0:08:49.39,Default,,0000,0000,0000,,À, đúng vậy. Đây là mô hình của khẩu\Nsúng lục ổ xoay tự động Mateba Firearms.
Dialogue: 0,0:08:49.70,0:08:52.79,Default,,0000,0000,0000,,Tất cả mọi người ở cơ quan anh\Nđều dùng khẩu súng này sao?
Dialogue: 0,0:08:53.30,0:08:57.24,Default,,0000,0000,0000,,Không thưa ông. Những người khác\Nsử dụng súng Seburo M5.
Dialogue: 0,0:08:58.07,0:09:01.31,Default,,0000,0000,0000,,Khẩu Seburo M5 là súng ngắn tự động\Ncó khả năng bắn liên tiếp...
Dialogue: 0,0:09:01.31,0:09:04.37,Default,,0000,0000,0000,,...tối đa 21 viên đạn 5.7mm\Nliên tiếp, đúng chứ?
Dialogue: 0,0:09:05.21,0:09:07.88,Default,,0000,0000,0000,,Thế nhưng khẩu súng của anh\Nchỉ bắn được 6 viên.
Dialogue: 0,0:09:08.48,0:09:11.32,Default,,0000,0000,0000,,Anh không thấy như vậy\Nlà có phần kém hiệu quả sao?
Dialogue: 0,0:09:12.02,0:09:16.75,Default,,0000,0000,0000,,Anh Togusa, khi khẩu súng này hết đạn,\Nanh sẽ làm gì?
Dialogue: 0,0:09:17.16,0:09:20.22,Default,,0000,0000,0000,,Tôi nhả vỏ đạn đã bắn ra\Nvà nạp đạn mới vào.
Dialogue: 0,0:09:21.13,0:09:24.93,Default,,0000,0000,0000,,Tôi không phải chuyên gia về súng, nên có lẽ\Nanh có thể giải thích cho tôi một điều.
Dialogue: 0,0:09:25.27,0:09:30.80,Default,,0000,0000,0000,,Loại súng nào cho phép nạp đạn nhanh hơn?\NSúng ổ xoay hay súng tự động?
Dialogue: 0,0:09:31.54,0:09:36.48,Default,,0000,0000,0000,,Tôi không dám chắc trong mọi trường hợp, nhưng\Nphần lớn súng tự động sẽ nạp nhanh hơn.
Dialogue: 0,0:09:36.68,0:09:39.44,Default,,0000,0000,0000,,Nhưng súng ổ xoay\Ncó ưu điểm riêng của nó.
Dialogue: 0,0:09:39.65,0:09:44.11,Default,,0000,0000,0000,,Xin thứ lỗi, anh Togusa, nhưng xin hãy\Ntrả lời đúng trọng tâm câu hỏi.
Dialogue: 0,0:09:44.72,0:09:46.55,Default,,0000,0000,0000,,Vậy để tôi diễn đạt lại\Nnhư thế này nhé.
Dialogue: 0,0:09:47.12,0:09:51.29,Default,,0000,0000,0000,,Giữa một khẩu Seburo và một khẩu Mateba,\Nkhẩu nào nạp đạn nhanh hơn?
Dialogue: 0,0:09:51.83,0:09:53.16,Default,,0000,0000,0000,,Khẩu Seburo.
Dialogue: 0,0:09:53.16,0:09:56.33,Default,,0000,0000,0000,,Ồ, vậy điều đó có nghĩa là\Nanh đã cố tình chọn...
Dialogue: 0,0:09:56.33,0:10:00.03,Default,,0000,0000,0000,,...một khẩu súng kém hiệu quả\Nđể sử dụng khi thi hành công vụ.
Dialogue: 0,0:10:00.74,0:10:05.30,Default,,0000,0000,0000,,Điều này chẳng phải quá kỳ lạ\Nso với tính chất công việc của anh sao?
Dialogue: 0,0:10:05.88,0:10:12.28,Default,,0000,0000,0000,,Về điểm đó thì đúng là vậy, nhưng không như súng tự động,\Nsúng ổ xoay không bao giờ bị kẹt đạn,
Dialogue: 0,0:10:12.92,0:10:16.51,Default,,0000,0000,0000,,và trừ các tình huống đặc biệt,\N6 viên đạn là đủ để hoàn thành nhiệm vụ.
Dialogue: 0,0:10:16.75,0:10:19.38,Default,,0000,0000,0000,,Lời biện minh đó nghe không thuyết phục\Ncho lắm, phải không?
Dialogue: 0,0:10:19.59,0:10:22.25,Default,,0000,0000,0000,,Trên thực tế, anh vừa vướng phải\Nđúng một trường hợp đặc biệt như thế đấy.
Dialogue: 0,0:10:23.03,0:10:28.73,Default,,0000,0000,0000,,Nói thẳng ra, chẳng phải anh mang súng ổ xoay\Nchỉ hoàn toàn theo sở thích cá nhân sao?
Dialogue: 0,0:10:29.33,0:10:31.07,Default,,0000,0000,0000,,Tôi không nghĩ\Nnên nói như...
Dialogue: 0,0:10:31.07,0:10:33.33,Default,,0000,0000,0000,,Câu trả lời của anh\Nlà có hay không?
Dialogue: 0,0:10:33.70,0:10:36.97,Default,,0000,0000,0000,,Không phải do\Nsở thích cá nhân.
Dialogue: 0,0:10:37.97,0:10:39.94,Default,,0000,0000,0000,,Vậy để tôi hỏi thêm\Nmột câu nữa nhé.
Dialogue: 0,0:10:40.38,0:10:46.18,Default,,0000,0000,0000,,Báo cáo cho thấy anh dành rất nhiều thời gian\Ntại trường bắn trong giờ làm việc.
Dialogue: 0,0:10:46.95,0:10:51.58,Default,,0000,0000,0000,,Phải chăng trong thâm tâm, anh coi việc\Nnổ súng như một thú tiêu khiển?
Dialogue: 0,0:10:51.79,0:10:53.19,Default,,0000,0000,0000,,Phản đối!
Dialogue: 0,0:10:53.36,0:10:56.66,Default,,0000,0000,0000,,Việc anh Togusa tập bắn có phải do sở thích\Ncá nhân hay không...
Dialogue: 0,0:10:56.66,0:10:58.80,Default,,0000,0000,0000,,...hoàn toàn chỉ là phỏng đoán vô căn cứ\Ntừ phía luật sư bào chữa.
Dialogue: 0,0:10:58.80,0:11:00.59,Default,,0000,0000,0000,,Những lời khẳng định này\Nhoàn toàn vô căn cứ.
Dialogue: 0,0:11:04.60,0:11:06.00,Default,,0000,0000,0000,,Phản đối được chấp thuận.
Dialogue: 0,0:11:06.57,0:11:10.60,Default,,0000,0000,0000,,Luật sư bào chữa chỉ được đặt câu hỏi liên quan\Ntrực tiếp đến tình tiết của vụ án này.
Dialogue: 0,0:11:10.94,0:11:12.24,Default,,0000,0000,0000,,Vâng, thưa thẩm phán.
Dialogue: 0,0:11:12.51,0:11:13.81,Default,,0000,0000,0000,,Vậy thì,\Nanh Togusa.
Dialogue: 0,0:11:14.31,0:11:18.21,Default,,0000,0000,0000,,Để xác minh lại,\Nkhi anh nổ súng vào cậu Izumi,
Dialogue: 0,0:11:20.52,0:11:23.28,Default,,0000,0000,0000,,anh có nhớ mình đã nói gì\Nvới cậu ấy không?
Dialogue: 0,0:11:25.46,0:11:28.05,Default,,0000,0000,0000,,Nếu không nhớ, xin phép để tôi\Nnhắc lại cho anh nhớ.
Dialogue: 0,0:11:28.73,0:11:32.79,Default,,0000,0000,0000,,Anh đã hét vào mặt cậu Izumi:\N\"Mày muốn chết à?!\"
Dialogue: 0,0:11:33.00,0:11:35.70,Default,,0000,0000,0000,,Điều này đồng nghĩa với việc phương án\Ngiết chết nghi phạm...
Dialogue: 0,0:11:35.70,0:11:39.63,Default,,0000,0000,0000,,...đã nằm trong số những phản ứng\Nmà anh tính đến.
Dialogue: 0,0:11:39.94,0:11:40.90,Default,,0000,0000,0000,,Có đúng như vậy không?
Dialogue: 0,0:11:41.34,0:11:44.97,Default,,0000,0000,0000,,Ông đùa đấy à?!\NRõ ràng ông đang bẻ cong lời tôi nói!
Dialogue: 0,0:11:45.44,0:11:47.47,Default,,0000,0000,0000,,Yêu cầu nhân chứng\Nngồi trật tự.
Dialogue: 0,0:11:48.14,0:11:50.78,Default,,0000,0000,0000,,Trên thực tế, anh đã bắn nát các khớp nối\Ncả tứ chi của cậu Izumi...
Dialogue: 0,0:11:50.78,0:11:52.15,Default,,0000,0000,0000,,Thôi trò hề đó đi\Nđược rồi đấy!
Dialogue: 0,0:11:52.82,0:11:57.15,Default,,0000,0000,0000,,Tôi đã bắn nghi phạm, nhưng là để cứu mạng\Nngười phụ nữ sắp bị hắn sát hại!
Dialogue: 0,0:11:57.85,0:12:00.76,Default,,0000,0000,0000,,Tôi thấy anh chẳng hề có lấy\Nmột chút ăn năn hối hận nào.
Dialogue: 0,0:12:00.99,0:12:03.48,Default,,0000,0000,0000,,Đừng có đánh trống lảng!\NVấn đề ở đây là...
Dialogue: 0,0:12:03.73,0:12:05.75,Default,,0000,0000,0000,,Yêu cầu nhân chứng\Nngồi xuống ngay!
Dialogue: 0,0:12:06.26,0:12:07.66,Default,,0000,0000,0000,,Nhưng thưa thẩm phán, tôi...
Dialogue: 0,0:12:07.93,0:12:09.59,Default,,0000,0000,0000,,Ngồi xuống!
Dialogue: 0,0:12:19.04,0:12:21.13,Default,,0000,0000,0000,,Sao rồi? Tình hình cậu ta\Ntrong đó thế nào?
Dialogue: 0,0:12:21.74,0:12:26.70,Default,,0000,0000,0000,,Đang tức điên lên rồi.\NTên luật sư đó cáo già hơn tôi tưởng.
Dialogue: 0,0:12:27.32,0:12:30.44,Default,,0000,0000,0000,,Ừ, nhưng Togusa đâu phải\Nngười đang bị xét xử đâu.
Dialogue: 0,0:12:30.95,0:12:34.25,Default,,0000,0000,0000,,Trước lúc thẩm phán tuyên bố tạm nghỉ,\Ntrông thế trận y hệt như vậy đấy.
Dialogue: 0,0:12:36.66,0:12:38.16,Default,,0000,0000,0000,,Có gửi tín hiệu mã hóa nào\Nđược không?
Dialogue: 0,0:12:38.16,0:12:41.03,Default,,0000,0000,0000,,Bó tay. Cậu ta đang ngắt kết nối\Nvề chế độ tự kỷ rồi.
Dialogue: 0,0:12:42.53,0:12:45.56,Default,,0000,0000,0000,,Chẳng lẽ cậu ta không hiểu ý sếp\Ntừ lúc ở phòng thăm gặp sao?
Dialogue: 0,0:12:46.00,0:12:48.30,Default,,0000,0000,0000,,Togusa có thể ngây thơ,\Nnhưng không ngốc đâu.
Dialogue: 0,0:12:48.60,0:12:51.00,Default,,0000,0000,0000,,Cậu ta thừa hiểu chúng ta muốn liên lạc\Nqua kênh mã hóa.
Dialogue: 0,0:12:51.61,0:12:55.01,Default,,0000,0000,0000,,Ý cậu là cậu ta không muốn dùng thủ đoạn ngầm\Ntrong tòa án sao?
Dialogue: 0,0:12:56.38,0:13:00.37,Default,,0000,0000,0000,,Không ổn rồi. Từ lúc phiên tòa bắt đầu,\Ncậu ta chẳng thèm nhìn về phía chúng ta nữa.
Dialogue: 0,0:13:01.42,0:13:03.61,Default,,0000,0000,0000,,Tôi sẽ điều tra thêm\Nvề lai lịch của tên bị cáo.
Dialogue: 0,0:13:04.85,0:13:09.76,Default,,0000,0000,0000,,Thiếu tá, cô ở lại đây theo dõi phiên tòa nhé.\NTạm thời tôi sẽ quay về trụ sở.
Dialogue: 0,0:13:10.46,0:13:11.69,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:13:12.16,0:13:15.39,Default,,0000,0000,0000,,Tôi tin rằng anh Togusa\Nđã có ý định giết thân chủ của tôi.
Dialogue: 0,0:13:16.20,0:13:19.83,Default,,0000,0000,0000,,Xin hãy lưu ý điểm này. Anh Togusa\Nđã khai thế này trong bản tường trình:
Dialogue: 0,0:13:19.97,0:13:25.34,Default,,0000,0000,0000,,\"Khi đối mặt với bị cáo, thoạt nhìn tôi đã kết luận\Nrằng hắn sở hữu một cơ thể máy hoàn toàn.\"
Dialogue: 0,0:13:26.18,0:13:30.98,Default,,0000,0000,0000,,Tuyên bố này của anh Togusa đã vi phạm\NLuật Chống Phân biệt Đối xử Cơ thể Giả.
Dialogue: 0,0:13:31.48,0:13:35.08,Default,,0000,0000,0000,,Do đó, điều này khiến tôi tin rằng\Nviệc anh ta nổ súng một cách thái quá...
Dialogue: 0,0:13:35.08,0:13:39.08,Default,,0000,0000,0000,,...cũng là kết quả từ định kiến\Ncủa anh ta đối với người máy sinh học.
Dialogue: 0,0:13:39.26,0:13:40.28,Default,,0000,0000,0000,,Phản đối!
Dialogue: 0,0:13:40.49,0:13:45.48,Default,,0000,0000,0000,,Thưa thẩm phán, Luật Chống Phân biệt Đối xử Cơ thể Giả\Nhoàn toàn không liên quan đến vụ án này!
Dialogue: 0,0:13:47.36,0:13:48.76,Default,,0000,0000,0000,,Phản đối được chấp thuận.
Dialogue: 0,0:13:49.10,0:13:52.66,Default,,0000,0000,0000,,Luật sư bào chữa phải lập luận\Ndựa trên các chứng cứ thực tế.
Dialogue: 0,0:13:53.24,0:13:54.36,Default,,0000,0000,0000,,Vâng, thưa thẩm phán.
Dialogue: 0,0:13:54.84,0:13:59.64,Default,,0000,0000,0000,,Vào lúc này, tôi xin phép đưa ra lời giải thích\Ncho những hành động cụ thể của anh Togusa...
Dialogue: 0,0:14:00.01,0:14:03.34,Default,,0000,0000,0000,,...sau khi nói qua về môi trường làm việc\Nđặc thù của anh ta.
Dialogue: 0,0:14:04.48,0:14:06.88,Default,,0000,0000,0000,,Đội 9 Phòng An ninh Công cộng,\Nnơi anh Togusa làm việc,
Dialogue: 0,0:14:07.42,0:14:11.51,Default,,0000,0000,0000,,là một tổ chức đặc biệt mà toàn bộ thành viên\Nđều sở hữu cơ thể máy được gia cố tối tân.
Dialogue: 0,0:14:11.99,0:14:14.96,Default,,0000,0000,0000,,Do phải chịu đựng\Náp lực kéo dài...
Dialogue: 0,0:14:15.26,0:14:18.13,Default,,0000,0000,0000,,...trong môi trường làm việc\Nbị vây quanh bởi những kẻ cyborg,
Dialogue: 0,0:14:18.43,0:14:22.40,Default,,0000,0000,0000,,tôi buộc phải kết luận rằng anh ta đã nảy sinh\Nmột phức cảm tự ti trong tiềm thức...
Dialogue: 0,0:14:22.40,0:14:25.20,Default,,0000,0000,0000,,...và định kiến tâm lý chống lại\Nnhững người mang cơ thể giả.
Dialogue: 0,0:14:26.00,0:14:30.51,Default,,0000,0000,0000,,Hệ quả là vụ việc lần này đã trở thành lối thoát\Ncho những thái độ tiêu cực dồn nén đó.
Dialogue: 0,0:14:30.51,0:14:34.88,Default,,0000,0000,0000,,Phản đối! Đây hoàn toàn chỉ là suy diễn vô căn cứ\Ncủa luật sư bào chữa.
Dialogue: 0,0:14:36.15,0:14:37.87,Default,,0000,0000,0000,,Phản đối được chấp thuận.
Dialogue: 0,0:14:42.25,0:14:46.62,Default,,0000,0000,0000,,{\i1}Sếp, tôi tìm thấy một thứ khá thú vị{\i0}\N{\i1}trong thiết bị đầu cuối của tên bị cáo.{\i0}
Dialogue: 0,0:14:47.12,0:14:51.12,Default,,0000,0000,0000,,{\i1}Danh sách các bộ phận cơ thể giả bất hợp pháp{\i0}\N{\i1}mà hắn đã lắp đặt ngay trước hôm xảy ra vụ nổ súng.{\i0}
Dialogue: 0,0:14:51.73,0:14:53.66,Default,,0000,0000,0000,,{\i1}Liệu chúng ta có thể dùng thứ này{\i0}\N{\i1}để ép họ bãi bỏ vụ này không?{\i0}
Dialogue: 0,0:14:54.06,0:14:56.40,Default,,0000,0000,0000,,{\i1}Dù sao thì nó cũng tạo cho họ{\i0}\N{\i1}chút động lực để làm vậy đấy.{\i0}
Dialogue: 0,0:14:58.30,0:15:01.17,Default,,0000,0000,0000,,Hãy chuyển thông tin mà Batou tìm được\Ncho bên kiểm sát.
Dialogue: 0,0:15:01.50,0:15:02.70,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:15:03.51,0:15:07.28,Default,,0000,0000,0000,,Vậy còn tin tình báo bảo rằng một kiểm sát viên\Ncó tên Kusunoki...
Dialogue: 0,0:15:07.28,0:15:09.57,Default,,0000,0000,0000,,...đang tìm cách lôi Đội 9\Nra tòa thì sao?
Dialogue: 0,0:15:10.75,0:15:14.44,Default,,0000,0000,0000,,Hắn chính là kẻ khơi mào cho vụ bắt giữ\NTổng thư ký Yakushima,
Dialogue: 0,0:15:14.82,0:15:17.79,Default,,0000,0000,0000,,nhưng có vẻ như lần này hắn mới là kẻ giật dây\Nđằng sau vụ việc.
Dialogue: 0,0:15:18.42,0:15:19.79,Default,,0000,0000,0000,,Vậy rốt cuộc chuyện này là thế nào?
Dialogue: 0,0:15:20.16,0:15:23.23,Default,,0000,0000,0000,,Nghĩa là có kẻ đã thổi bùng\Ntham vọng của Kusunoki...
Dialogue: 0,0:15:23.23,0:15:26.09,Default,,0000,0000,0000,,...khi hắn đánh hơi được thông tin\Nvề Đội 9.
Dialogue: 0,0:15:27.13,0:15:30.26,Default,,0000,0000,0000,,Chắc chắn là Gohda rồi.\NPhải công nhận gã đó ghê gớm thật...
Dialogue: 0,0:15:34.84,0:15:37.50,Default,,0000,0000,0000,,Mẹ ơi, bao giờ thì\Nbố mới về nhà ạ?
Dialogue: 0,0:15:39.04,0:15:42.41,Default,,0000,0000,0000,,Mẹ cũng không rõ nữa.\NChỉ mong bố về sớm thôi con.
Dialogue: 0,0:15:44.38,0:15:45.78,Default,,0000,0000,0000,,Ông muốn cái {\i1}gì{\i0}?
Dialogue: 0,0:15:47.15,0:15:50.08,Default,,0000,0000,0000,,Tôi đang tính đệ đơn kiện\Ndân sự chống lại anh đấy.
Dialogue: 0,0:15:50.85,0:15:52.48,Default,,0000,0000,0000,,Đó là một lời đe dọa\Nđấy à?
Dialogue: 0,0:15:53.19,0:15:57.32,Default,,0000,0000,0000,,Lúc nãy, tôi đã liên lạc với cấp trên của anh,\NTrưởng phòng Aramaki.
Dialogue: 0,0:15:57.73,0:15:59.92,Default,,0000,0000,0000,,Ông ấy là một người\Nrất biết điều.
Dialogue: 0,0:16:00.53,0:16:02.93,Default,,0000,0000,0000,,Để đổi lại việc bãi bỏ đơn kiện\Ndân sự nhằm vào anh,
Dialogue: 0,0:16:02.93,0:16:06.63,Default,,0000,0000,0000,,ông ấy nói có thể dàn xếp vụ này thành\Ntai nạn lỗi hệ thống điều khiển cơ thể giả.
Dialogue: 0,0:16:07.27,0:16:09.70,Default,,0000,0000,0000,,Sếp tôi đời nào lại đi đồng lõa\Nvới một trò như thế.
Dialogue: 0,0:16:10.71,0:16:14.20,Default,,0000,0000,0000,,Nếu không, tôi sẽ cứ tiến hành\Nđúng như kế hoạch thôi.
Dialogue: 0,0:16:14.44,0:16:17.47,Default,,0000,0000,0000,,Khi đó e là mọi người ở Đội 9\Nsẽ gặp rắc rối to đấy.
Dialogue: 0,0:16:18.08,0:16:20.71,Default,,0000,0000,0000,,Tất nhiên, với tôi thì đằng nào\Ncũng chẳng sao cả.
Dialogue: 0,0:16:27.62,0:16:32.22,Default,,0000,0000,0000,,Anh Togusa, nếu người anh đối mặt\Nlà một người bằng xương bằng thịt,
Dialogue: 0,0:16:32.73,0:16:34.92,Default,,0000,0000,0000,,liệu anh có nã liên tiếp\Nnhiều phát đạn vào người ta như thế không?
Dialogue: 0,0:16:35.90,0:16:37.96,Default,,0000,0000,0000,,Dĩ nhiên là tôi sẽ xử lý khác rồi,\Nđương nhiên rồi.
Dialogue: 0,0:16:38.23,0:16:41.43,Default,,0000,0000,0000,,Ra vậy. Thế thì tôi muốn\Nhỏi anh về...
Dialogue: 0,0:16:41.77,0:16:46.30,Default,,0000,0000,0000,,...những hành động cụ thể của Đội 9\Ntrong vụ án xảy ra gần đây.
Dialogue: 0,0:16:48.04,0:16:51.98,Default,,0000,0000,0000,,Gần đây đã xảy ra hàng loạt vụ đánh bom tự sát\Ndo những người tị nạn mang cơ thể giả thực hiện, phải không?
Dialogue: 0,0:16:52.72,0:16:58.15,Default,,0000,0000,0000,,Tôi được biết Đội 9 đã tham gia sâu\Nvào quá trình điều tra các vụ đánh bom này.
Dialogue: 0,0:16:58.45,0:16:59.55,Default,,0000,0000,0000,,Có đúng vậy không?
Dialogue: 0,0:16:59.86,0:17:00.75,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:17:01.12,0:17:04.93,Default,,0000,0000,0000,,Và có đúng là chính bản thân anh\Nđã tham gia vào vụ bắt giữ...
Dialogue: 0,0:17:04.93,0:17:07.99,Default,,0000,0000,0000,,...nghi phạm của chuỗi vụ đánh bom tự sát\Nvào hôm nọ không?
Dialogue: 0,0:17:08.73,0:17:09.82,Default,,0000,0000,0000,,Đúng thế.
Dialogue: 0,0:17:12.47,0:17:14.99,Default,,0000,0000,0000,,Hãy phong tỏa thông tin\Nvới giới truyền thông ngay.
Dialogue: 0,0:17:15.37,0:17:16.63,Default,,0000,0000,0000,,Đang tiến hành rồi.
Dialogue: 0,0:17:17.27,0:17:22.54,Default,,0000,0000,0000,,Trên tay tôi là bản sao báo cáo từ Viện kiểm sát\Nliên quan đến vụ án đó.
Dialogue: 0,0:17:26.18,0:17:27.81,Default,,0000,0000,0000,,Theo như báo cáo này,
Dialogue: 0,0:17:28.02,0:17:32.65,Default,,0000,0000,0000,,khi anh Togusa ngăn chặn cô gái tị nạn\Nmang cơ thể giả tự kích nổ,
Dialogue: 0,0:17:33.02,0:17:36.19,Default,,0000,0000,0000,,anh ta không những đưa ra lời cảnh cáo,\Nmà thậm chí còn không hề bắn một phát nào.
Dialogue: 0,0:17:38.06,0:17:41.00,Default,,0000,0000,0000,,Tại sao lại có sự khác biệt lớn đến thế\Ntrong cách xử lý của anh...
Dialogue: 0,0:17:41.30,0:17:43.49,Default,,0000,0000,0000,,...giữa vụ này và vụ cô gái\Nđánh bom tự sát kia?
Dialogue: 0,0:17:44.37,0:17:48.60,Default,,0000,0000,0000,,Đây là bằng chứng rõ ràng cho thấy\Ncó sự can thiệp của định kiến tâm lý.
Dialogue: 0,0:17:48.94,0:17:53.34,Default,,0000,0000,0000,,Khoan đã! Trong vụ này tôi cũng đã\Ncảnh cáo tên nghi phạm trước tiên!
Dialogue: 0,0:17:54.21,0:17:56.94,Default,,0000,0000,0000,,Vả lại, hành vi của hắn\Nhoàn toàn khác biệt!
Dialogue: 0,0:17:57.88,0:18:00.91,Default,,0000,0000,0000,,Tất cả những gì tôi làm chỉ là cứu người phụ nữ\Nđang kêu cứu trong tuyệt vọng!
Dialogue: 0,0:18:02.12,0:18:06.82,Default,,0000,0000,0000,,Có lẽ là thế. Nhưng chúng ta\Nchẳng có cách nào để chứng minh điều đó cả.
Dialogue: 0,0:18:07.86,0:18:11.55,Default,,0000,0000,0000,,Tôi không có ý định phán xét anh\Nvì điều đó.
Dialogue: 0,0:18:11.83,0:18:14.93,Default,,0000,0000,0000,,Tôi chỉ muốn chứng minh rằng\Nvụ việc này đơn thuần là một tai nạn...
Dialogue: 0,0:18:14.93,0:18:17.30,Default,,0000,0000,0000,,...bắt nguồn từ chính hành động\Ncủa anh mà ra.
Dialogue: 0,0:18:17.80,0:18:21.17,Default,,0000,0000,0000,,Trên thực tế, cậu Izumi cho biết kể từ sau các vụ\Nđánh bom tự sát liên hoàn, cậu ấy đã...
Dialogue: 0,0:18:21.17,0:18:25.57,Default,,0000,0000,0000,,...trở thành nạn nhân của những hiểu lầm vô cớ\Nchỉ vì mang cơ thể giả.
Dialogue: 0,0:18:25.98,0:18:29.38,Default,,0000,0000,0000,,Vì thế, cậu ấy đã thay đôi tay cũ bằng đôi tay mới\Nngay vào ngày trước khi xảy ra vụ việc...
Dialogue: 0,0:18:29.38,0:18:33.11,Default,,0000,0000,0000,,...để người khác nhìn vào là thấy rõ ngay\Ncậu ấy không phải dân tị nạn.
Dialogue: 0,0:18:34.25,0:18:35.91,Default,,0000,0000,0000,,Hắn lại chơi\Ncon bài đó cơ à?
Dialogue: 0,0:18:40.86,0:18:42.38,Default,,0000,0000,0000,,Bên bào chữa xin kết thúc phần xét hỏi.
Dialogue: 0,0:18:42.73,0:18:44.56,Default,,0000,0000,0000,,Phiên tòa tạm nghỉ.
Dialogue: 0,0:18:50.73,0:18:51.93,Default,,0000,0000,0000,,Khoan đã!
Dialogue: 0,0:18:53.74,0:18:57.43,Default,,0000,0000,0000,,Trò hề công lý này chẳng thể nào\Nan ủi được linh hồn nạn nhân đã khuất!
Dialogue: 0,0:18:58.81,0:19:01.41,Default,,0000,0000,0000,,Hôm qua, luật sư của bên bị cáo\Nđã tìm đến tôi...
Dialogue: 0,0:19:01.41,0:19:05.64,Default,,0000,0000,0000,,...dùng lời đe dọa kiện dân sự để ép chúng tôi\Nphải dàn xếp vụ này thành một vụ tai nạn.
Dialogue: 0,0:19:06.58,0:19:11.78,Default,,0000,0000,0000,,Mưu đồ của ông ta chắc hẳn là dọa sẽ lôi...
Dialogue: 0,0:19:12.12,0:19:14.65,Default,,0000,0000,0000,,...nhiệm vụ đặc biệt ở cơ quan tôi ra\Ntrong quá trình đối chất trước tòa để ép tôi nhượng bộ.
Dialogue: 0,0:19:15.09,0:19:17.18,Default,,0000,0000,0000,,Nhưng những lời đe dọa đó\Nvô tác dụng rồi!
Dialogue: 0,0:19:17.56,0:19:21.72,Default,,0000,0000,0000,,Vì tôi sẽ từ chức khỏi Đội 9\Nngay tại đây, ngay lúc này!
Dialogue: 0,0:19:25.17,0:19:26.69,Default,,0000,0000,0000,,Cái thằng ngốc này...
Dialogue: 0,0:19:27.04,0:19:29.23,Default,,0000,0000,0000,,Cậu ta đang để cơn giận\Nche mờ lý trí rồi.
Dialogue: 0,0:19:30.97,0:19:32.94,Default,,0000,0000,0000,,Vụ nổ súng này\Ntuyệt đối không phải tai nạn.
Dialogue: 0,0:19:33.51,0:19:36.97,Default,,0000,0000,0000,,Nhưng sự thật là tôi cũng đã\Nkhông cứu được nạn nhân.
Dialogue: 0,0:19:37.81,0:19:40.58,Default,,0000,0000,0000,,Nếu muốn đệ đơn kiện dân sự chống lại tôi,\Nthì cứ việc kiện đi!
Dialogue: 0,0:19:40.95,0:19:44.89,Default,,0000,0000,0000,,Nhưng hãy nhớ cho kỹ, tôi nhất quyết\Nsẽ không trốn chạy phiên tòa này đâu, rõ chưa?!
Dialogue: 0,0:19:46.82,0:19:49.35,Default,,0000,0000,0000,,Nhân chứng, tòa án\Nđang trong giờ nghỉ.
Dialogue: 0,0:19:49.66,0:19:51.96,Default,,0000,0000,0000,,Hãy giữ lại lời khai cho đến khi\Nphiên tòa tiếp tục.
Dialogue: 0,0:19:52.26,0:19:55.32,Default,,0000,0000,0000,,Tôi không đợi. Tôi chỉ muốn\Nnói nốt điều này thôi.
Dialogue: 0,0:19:55.73,0:19:58.43,Default,,0000,0000,0000,,Gần đây, dường như những phiên tòa thế này\Nđang ngày một gia tăng,
Dialogue: 0,0:19:58.43,0:20:00.73,Default,,0000,0000,0000,,cùng với sự phổ biến nhanh chóng\Ncủa cơ thể giả.
Dialogue: 0,0:20:00.94,0:20:05.93,Default,,0000,0000,0000,,Nhưng tôi nghe nói trong số đó có những vụ án\Nmà kiểm sát viên và luật sư bào chữa...
Dialogue: 0,0:20:06.48,0:20:08.51,Default,,0000,0000,0000,,...đã câu kết với một nhà sản xuất\Ncơ thể giả nào đó...
Dialogue: 0,0:20:08.51,0:20:11.38,Default,,0000,0000,0000,,...và tổ chức các phiên tòa sai trái nhằm\Nbưng bít lỗi sản phẩm của họ.
Dialogue: 0,0:20:12.28,0:20:16.48,Default,,0000,0000,0000,,Trong quá trình làm việc, tôi đã nắm khá rõ\Nvề những vụ giao dịch bẩn thỉu đó.
Dialogue: 0,0:20:16.95,0:20:19.19,Default,,0000,0000,0000,,Nhưng giờ khi tôi đã quyết định\Nrời khỏi Đội 9,
Dialogue: 0,0:20:19.19,0:20:21.59,Default,,0000,0000,0000,,tôi sẽ phanh phui sự thật\Nvề từng vụ một ra ánh sáng.
Dialogue: 0,0:20:21.89,0:20:24.45,Default,,0000,0000,0000,,Thế nên các người hãy tự liệu lấy\Nhậu quả đi!
Dialogue: 0,0:20:26.46,0:20:28.59,Default,,0000,0000,0000,,Áp giải nhân chứng\Nra khỏi phòng xử án!
Dialogue: 0,0:20:43.28,0:20:44.54,Default,,0000,0000,0000,,Vào đi.
Dialogue: 0,0:20:47.48,0:20:49.31,Default,,0000,0000,0000,,Người hùng khải hoàn trở về rồi đấy à,\Ndù hơi muộn màng.
Dialogue: 0,0:20:49.59,0:20:51.15,Default,,0000,0000,0000,,Tôi không hề hài lòng\Nvề chuyện này chút nào đâu.
Dialogue: 0,0:20:51.15,0:20:53.69,Default,,0000,0000,0000,,Kể cả là cô, tôi cũng chẳng thích ai đó\Ncứ tự tiện đi lại...
Dialogue: 0,0:20:53.69,0:20:56.52,Default,,0000,0000,0000,,...với chiếc khóa xâm nhập Ghost mà cô\Ntự ý tạo ra mà chưa có sự cho phép của tôi.
Dialogue: 0,0:20:56.89,0:21:00.49,Default,,0000,0000,0000,,Nếu cậu chịu bớt đem cái thứ công lý ngây thơ đó\Nra áp đặt vào mặt người khác, thì tôi đã chẳng phải làm thế.
Dialogue: 0,0:21:01.06,0:21:03.59,Default,,0000,0000,0000,,Nhưng việc cậu làm bị phản tác dụng rồi\Nđúng không?
Dialogue: 0,0:21:03.83,0:21:05.13,Default,,0000,0000,0000,,Đừng lo\Nvề chuyện đó.
Dialogue: 0,0:21:05.13,0:21:08.13,Default,,0000,0000,0000,,Sau khi cậu rời đi, hắn đã bị tuyên có tội tạm thời,\Nvà sẽ phải ra hầu tòa chính thức.
Dialogue: 0,0:21:09.27,0:21:12.26,Default,,0000,0000,0000,,Nhiều khả năng hắn cũng sẽ bị kết tội\Ntrong phiên tòa chính thức thôi.
Dialogue: 0,0:21:13.14,0:21:17.35,Default,,0000,0000,0000,,Câu chuyện mà Thiếu tá bảo cậu nói lúc nãy\Nlà thông tin mật mà chúng tôi tìm thấy...
Dialogue: 0,0:21:17.35,0:21:20.32,Default,,0000,0000,0000,,...khi điều tra tài khoản ngân hàng\Ncủa gã luật sư.
Dialogue: 0,0:21:21.25,0:21:25.08,Default,,0000,0000,0000,,Hắn sợ những bí mật đen tối của chính mình\Nbị phơi bày.
Dialogue: 0,0:21:25.42,0:21:31.79,Default,,0000,0000,0000,,Thêm nữa, kiểm sát viên Kusunoki, kẻ định lợi dụng\Nvụ này để làm rung chuyển Đội 9,
Dialogue: 0,0:21:32.43,0:21:35.69,Default,,0000,0000,0000,,đã vội vàng phủi tay rút lui trước khi mối quan hệ\Ngiữa hắn và tên luật sư bị vạch trần.
Dialogue: 0,0:21:36.10,0:21:38.07,Default,,0000,0000,0000,,Kiểm sát viên Kusunoki ư?\NChẳng phải hắn là kẻ...
Dialogue: 0,0:21:38.37,0:21:42.17,Default,,0000,0000,0000,,Đúng vậy. Kẻ biên kịch vở kịch này\Nnhiều khả năng chính là Gohda của CIS.
Dialogue: 0,0:21:42.47,0:21:46.53,Default,,0000,0000,0000,,Tôi đoán Kusunoki là đạo diễn sân khấu,\Ncòn vai nam chính là gã cựu kiểm sát viên kia.
Dialogue: 0,0:21:47.11,0:21:51.44,Default,,0000,0000,0000,,Đùa nhau à! Còn đâu là đấu tranh cho công lý\Nchốn pháp đình nữa chứ?!
Dialogue: 0,0:21:51.71,0:21:56.41,Default,,0000,0000,0000,,Tôi không muốn nói ra điều này đâu, nhưng có lẽ thứ công lý\Ncủa cậu không còn đất diễn ở chốn tòa án nữa rồi.
Dialogue: 0,0:21:57.35,0:22:00.08,Default,,0000,0000,0000,,Thế này thì nạn nhân làm sao\Nngậm cười nơi chín suối được.
Dialogue: 0,0:22:00.72,0:22:03.49,Default,,0000,0000,0000,,Phải, nhưng biết đâu sẽ có\Nsự trừng phạt từ thiên thần đấy.
Dialogue: 0,0:22:03.76,0:22:04.92,Default,,0000,0000,0000,,Trừng phạt ư?
Dialogue: 0,0:22:12.70,0:22:15.33,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Bản tin tiếp theo, theo thông tin{\i0}\N{\i1}chúng tôi vừa nhận được,{\i0}
Dialogue: 0,0:22:15.64,0:22:22.14,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}bị cáo trong một vụ án mạng công khai liên quan đến{\i0}\N{\i1}Luật Chống Phân biệt Đối xử Cơ thể Giả...{\i0}
Dialogue: 0,0:22:22.14,0:22:24.41,Default,,0000,0000,0000,,Tôi muốn chiếc xe này\Nphải bị tiêu hủy thành sắt vụn.
Dialogue: 0,0:22:22.61,0:22:25.28,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}... và luật sư của hắn đã gặp tai nạn giao thông{\i0}\N{\i1}trên đường trở về nhà sau phiên tòa.{\i0}
Dialogue: 0,0:22:24.85,0:22:26.62,Default,,0000,0000,0000,,Tiêu hủy toàn bộ giấy tờ liên quan luôn,\Nđược chứ?
Dialogue: 0,0:22:25.28,0:22:26.62,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Gã luật sư hiện đang trong{\i0}\N{\i1}tình trạng nguy kịch,{\i0}
Dialogue: 0,0:22:26.62,0:22:28.91,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và cơ thể giả của tên bị cáo{\i0}\N{\i1}cũng bị hư hại nặng nề.{\i0}
Dialogue: 0,0:22:29.32,0:22:33.96,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chiếc xe chở cả hai đã va quẹt vào dải phân cách{\i0}\N{\i1}trên đường cao tốc,{\i0}
Dialogue: 0,0:22:33.96,0:22:35.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}lật nhiều vòng,{\i0}\N{\i1}và biến dạng hoàn toàn.{\i0}
Dialogue: 0,0:22:35.69,0:22:36.89,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tên luật sư...{\i0}
Dialogue: 0,0:22:47.74,0:22:49.84,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Khu vực Niihama ngày mai{\i0}\N{\i1}trời sẽ trong xanh.{\i0}
Dialogue: 0,0:22:49.84,0:22:52.01,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Bầu trời nhiều khả năng{\i0}\N{\i1}sẽ chan hòa ánh nắng.{\i0}
Dialogue: 0,0:22:52.01,0:22:54.51,Default,,0000,0000,0000,,Mẹ ơi! Hôm nay bố\Ncó về nhà không mẹ?
Dialogue: 0,0:22:52.64,0:22:56.98,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Với nhiệt độ cao nhất dự báo là 29 độ C{\i0}\N{\i1}cùng độ ẩm 70%,{\i0}
Dialogue: 0,0:22:55.84,0:22:57.41,Default,,0000,0000,0000,,Bố sẽ về sớm thôi con.
Dialogue: 0,0:22:57.41,0:22:59.40,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}đêm nay thời tiết sẽ mang đậm{\i0}\N{\i1}hơi thở nhiệt đới...{\i0}
Dialogue: 0,0:22:59.40,0:23:01.40,Top Secondary Dialog 1080P,,0000,0000,0000,,
Dialogue: 0,0:23:10.68,0:23:13.18,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:13.18,0:23:17.14,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:17.33,0:23:19.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:19.80,0:23:23.79,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:23.79,0:23:27.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:27.80,0:23:31.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:31.09,0:23:35.60,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:35.60,0:23:37.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
