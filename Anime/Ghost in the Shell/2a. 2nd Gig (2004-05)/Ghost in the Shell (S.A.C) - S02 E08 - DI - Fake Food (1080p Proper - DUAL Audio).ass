Dialogue: 0,0:01:34.08,0:01:35.82,Default,,0000,0000,0000,,Có đào bới ra được\Nthứ gì về hắn không?
Dialogue: 0,0:01:35.82,0:01:37.12,Default,,0000,0000,0000,,Tôi vẫn chưa tiến triển\Nđược bao nhiêu.
Dialogue: 0,0:01:38.02,0:01:40.29,Default,,0000,0000,0000,,Hàng rào bảo mật của bên đó\Nkiên cố hơn tôi tưởng.
Dialogue: 0,0:01:40.76,0:01:44.19,Default,,0000,0000,0000,,Dù sao thì Ban Tình báo cũng là cơ quan\Nhành chính mới thành lập nhất mà.
Dialogue: 0,0:01:44.26,0:01:46.93,Default,,0000,0000,0000,,Nó được tạo ra bằng cách sáp nhập các cơ quan\Ntình báo thời tiền chiến...
Dialogue: 0,0:01:46.93,0:01:48.87,Default,,0000,0000,0000,,...với Cục Chính sách Quốc phòng cũ.
Dialogue: 0,0:01:48.87,0:01:52.82,Default,,0000,0000,0000,,Nhưng tôi đã tìm thấy bằng chứng của nhiều vụ thao túng\Nthông tin trái phép liên quan tới...
Dialogue: 0,0:01:53.00,0:01:56.27,Default,,0000,0000,0000,,...việc thu thập và phân tích thông tin trong và ngoài nước, cũng như các hoạt động của Lực lượng Phòng vệ,
Dialogue: 0,0:01:56.27,0:02:02.70,Default,,0000,0000,0000,,bên trong cái Ủy ban Điều tra Tác động Chiến lược\Nmà Gohda đang trực thuộc.
Dialogue: 0,0:02:03.58,0:02:06.34,Default,,0000,0000,0000,,Và sự cố plutonium vừa rồi\Ncũng nằm trong số đó hả?
Dialogue: 0,0:02:06.78,0:02:08.19,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:02:08.19,0:02:09.55,Default,,0000,0000,0000,,Thế còn lý lịch\Ncá nhân của hắn?
Dialogue: 0,0:02:09.89,0:02:12.32,Default,,0000,0000,0000,,Hắn thuộc nhóm nhân sự được săn đón đặc cách\Ntừ Cục Chính sách Quốc phòng,
Dialogue: 0,0:02:12.32,0:02:14.88,Default,,0000,0000,0000,,...và nhanh chóng leo lên\Nvị trí hiện tại.
Dialogue: 0,0:02:15.36,0:02:20.30,Default,,0000,0000,0000,,Nhưng thành tích của hắn thời đó chẳng có gì nổi bật cả.\NHắn giống như một kẻ bị ruồng bỏ ngoài rìa thì đúng hơn.
Dialogue: 0,0:02:20.60,0:02:23.19,Default,,0000,0000,0000,,Nói thật với cậu,\Ngã này quả là một ẩn số bí hiểm.
Dialogue: 0,0:02:24.00,0:02:25.06,Default,,0000,0000,0000,,Cái gì thế kia?
Dialogue: 0,0:02:25.54,0:02:28.13,Default,,0000,0000,0000,,Đó là diện mạo của Gohda\Nthời còn ở Cục Chính sách Quốc phòng.
Dialogue: 0,0:02:28.44,0:02:30.67,Default,,0000,0000,0000,,Hắn dường như từng bị thương tích\Ntrong một vụ tai nạn nào đó,
Dialogue: 0,0:02:30.67,0:02:34.08,Default,,0000,0000,0000,,nhưng hắn vẫn giữ nguyên những vết sẹo gớm ghiếc\Nhệt như diện mạo ngày ấy.
Dialogue: 0,0:02:34.98,0:02:37.14,Default,,0000,0000,0000,,Rõ ràng là diện mạo cũ ít gây ấn tượng\Nhơn bộ mặt của hắn bây giờ nhiều.
Dialogue: 0,0:02:37.78,0:02:38.75,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:02:38.95,0:02:42.58,Default,,0000,0000,0000,,Tạm thời đình chỉ việc rà soát lý lịch lại.\NChúng ta vừa nhận được chỉ thị mới từ Trưởng ban.
Dialogue: 0,0:02:42.85,0:02:44.08,Default,,0000,0000,0000,,- Rõ.\N- Rõ.
Dialogue: 0,0:02:49.29,0:02:53.73,Default,,0000,0000,0000,,Trời ạ... Vừa thức trắng đêm xong\Nlại phải nhảy ngay vào cuộc họp trưa sao?
Dialogue: 0,0:03:08.31,0:03:11.14,Default,,0000,0000,0000,,Các cậu chắc hẳn đang thắc mắc vì sao\Ntôi lại triệu tập cuộc họp khẩn cấp này.
Dialogue: 0,0:03:11.41,0:03:14.15,Default,,0000,0000,0000,,Đó là để vạch ra chính sách đối sách của chúng ta...
Dialogue: 0,0:03:14.15,0:03:17.31,Default,,0000,0000,0000,,...đối với chuỗi các sự vụ bí ẩn liên tiếp xảy ra dạo gần đây.
Dialogue: 0,0:03:17.59,0:03:20.49,Default,,0000,0000,0000,,Được thôi, nhưng trước hết tôi muốn đấm vỡ mặt\Ncái thằng khốn kiếp đó một trận đã.
Dialogue: 0,0:03:21.32,0:03:22.95,Default,,0000,0000,0000,,Tôi đồng tình với cậu ấy.
Dialogue: 0,0:03:23.36,0:03:26.42,Default,,0000,0000,0000,,Hành động của CIS rõ ràng\Nlà nhằm gây sức ép lên chúng ta.
Dialogue: 0,0:03:26.60,0:03:29.36,Default,,0000,0000,0000,,Tôi không đời nào chịu ngậm bồ hòn làm ngọt\Nđể bọn chúng qua mặt lần thứ hai đâu.
Dialogue: 0,0:03:29.67,0:03:32.57,Default,,0000,0000,0000,,Bình tĩnh đi. Tôi cũng chẳng dễ chịu gì\Nhơn các cậu đâu.
Dialogue: 0,0:03:35.47,0:03:39.07,Default,,0000,0000,0000,,Dù vậy, tôi thấy dạo này Trưởng ban đi lại gặp mặt\NThủ tướng hơi bị nhiều đấy.
Dialogue: 0,0:03:39.54,0:03:44.14,Default,,0000,0000,0000,,Không phải chính Thủ tướng mới là người\Nmuốn tròng xích vào cổ chúng ta đấy chứ?
Dialogue: 0,0:03:44.45,0:03:45.72,Default,,0000,0000,0000,,Tôi cho rằng điều đó khó xảy ra.
Dialogue: 0,0:03:45.72,0:03:48.52,Default,,0000,0000,0000,,Đúng là bà ấy chỉ là một nhân vật bù nhìn\Nđược dựng lên với hy vọng...
Dialogue: 0,0:03:48.52,0:03:51.51,Default,,0000,0000,0000,,...đánh lạc hướng dư luận khỏi các vụ bê bối\Ncủa chính quyền tiền nhiệm,
Dialogue: 0,0:03:51.92,0:03:55.62,Default,,0000,0000,0000,,nhưng dù bà ấy có thể là bạn hay không,\Nthì chắc chắn bà ấy không phải là kẻ thù.
Dialogue: 0,0:03:57.16,0:04:02.00,Default,,0000,0000,0000,,Tôi tin rằng Thiếu tá cũng đã tự mình\Ntiến hành một cuộc điều tra độc lập về chuyện này,
Dialogue: 0,0:04:02.63,0:04:06.26,Default,,0000,0000,0000,,nhưng đã có những dấu hiệu của việc thao túng thông tin có chủ đích\Nđược thực hiện tại CIS...
Dialogue: 0,0:04:06.60,0:04:11.97,Default,,0000,0000,0000,,...liên quan đến vụ trực thăng mất kiểm soát, cũng như việc vận chuyển plutonium cách đây vài hôm.
Dialogue: 0,0:04:12.14,0:04:17.44,Default,,0000,0000,0000,,Vào lúc này, chưa rõ CIS đang mưu tính\Nsử dụng các sự cố này vào mục đích gì,
Dialogue: 0,0:04:17.85,0:04:21.18,Default,,0000,0000,0000,,nhưng tôi tin rằng những áp lực liên tiếp\Nđang dồn lên vai chúng ta...
Dialogue: 0,0:04:21.18,0:04:24.45,Default,,0000,0000,0000,,...chính là hành động từ bên trong nội bộ chính phủ,\Nnhằm che giấu cái \"điều gì đó\".
Dialogue: 0,0:04:25.22,0:04:27.66,Default,,0000,0000,0000,,Điều đó có đúng với cả vụ án\NNhóm 11 Cá Nhân không?
Dialogue: 0,0:04:29.13,0:04:32.46,Default,,0000,0000,0000,,Bởi vì bọn họ đang gạt chúng ta ra rìa cuộc điều tra...
Dialogue: 0,0:04:32.76,0:04:35.29,Default,,0000,0000,0000,,...về vụ mưu sát nhằm vào Thủ tướng,\Nvốn là một hành vi khủng bố cực kỳ nghiêm trọng,
Dialogue: 0,0:04:35.37,0:04:37.83,Default,,0000,0000,0000,,dù cho chúng ta chính là những người\Ngắn bó chặt chẽ nhất với vụ án.
Dialogue: 0,0:04:40.54,0:04:44.34,Default,,0000,0000,0000,,Nếu Thủ tướng chỉ là một con hổ giấy\Nvà chính phủ mới là kẻ đứng sau giật dây chuyện này,
Dialogue: 0,0:04:44.34,0:04:47.11,Default,,0000,0000,0000,,thì chúng ta sẽ lại là những kẻ cắn vào bàn tay\Nđang nuôi dưỡng chính mình đấy.
Dialogue: 0,0:04:47.68,0:04:49.54,Default,,0000,0000,0000,,Dù vậy Trưởng ban vẫn quyết tâm\Nlàm tới cùng chứ?
Dialogue: 0,0:04:49.85,0:04:51.34,Default,,0000,0000,0000,,Cậu có ý kiến phản đối gì\Nchuyện đó không?
Dialogue: 0,0:04:51.92,0:04:53.91,Default,,0000,0000,0000,,Tôi chỉ chờ được nghe câu nói đó\Ncủa Trưởng ban thôi.
Dialogue: 0,0:04:54.62,0:04:57.89,Default,,0000,0000,0000,,Rất tốt. Chúng ta tiếp tục\Nvới buổi tóm tắt nhiệm vụ.
Dialogue: 0,0:05:02.06,0:05:05.80,Default,,0000,0000,0000,,Tất cả các tội ác trong tập hồ sơ này đều do các nhóm tội phạm\Nkhác nhau gây ra...
Dialogue: 0,0:05:05.80,0:05:09.36,Default,,0000,0000,0000,,...những kẻ tự xưng là\NNhóm 11 Cá Nhân.
Dialogue: 0,0:05:11.37,0:05:14.74,Default,,0000,0000,0000,,Vụ biển thủ phi pháp các khoản tiền quyên góp\Ngửi đến Đài Truyền hình JNN.
Dialogue: 0,0:05:15.44,0:05:18.03,Default,,0000,0000,0000,,Vụ đánh bom một hiệp hội cứu trợ\Nngười tị nạn.
Dialogue: 0,0:05:18.64,0:05:23.55,Default,,0000,0000,0000,,Lời đe dọa gửi tới một tổ chức phi lợi nhuận từng tài trợ\Nmiễn phí cơ thể giả cho người tị nạn.
Dialogue: 0,0:05:26.02,0:05:28.92,Default,,0000,0000,0000,,Vụ dìm chết một bác sĩ chợ đen chuyên phẫu thuật\Ncơ thể nhân tạo trong ngõ hẻm.
Dialogue: 0,0:05:29.55,0:05:32.82,Default,,0000,0000,0000,,Cái chết của vị chủ tịch ngân hàng trực tuyến,\Nngười bị tàu hỏa cán tử vong.
Dialogue: 0,0:05:34.29,0:05:37.06,Default,,0000,0000,0000,,Vụ đâm chết một nghị sĩ\Nthuộc Đảng Dân chủ.
Dialogue: 0,0:05:38.36,0:05:41.69,Default,,0000,0000,0000,,Vụ bắn chết Densetsu,\Nnam rapper não điện tử nổi tiếng.
Dialogue: 0,0:05:42.73,0:05:45.10,Default,,0000,0000,0000,,Lời đe dọa khủng bố nhắm vào\NTòa soạn Báo Nanyou Shimbun.
Dialogue: 0,0:05:45.90,0:05:49.90,Default,,0000,0000,0000,,Và mới đây nhất, là vụ mưu sát bất thành\Nnhắm vào Thủ tướng Kayabuki.
Dialogue: 0,0:05:50.57,0:05:54.61,Default,,0000,0000,0000,,Trong số chín vụ án này, người ta từng tin rằng\Nvụ duy nhất...
Dialogue: 0,0:05:54.61,0:05:57.94,Default,,0000,0000,0000,,...phát hiện được tung tích nghi phạm\Nchính là vụ mưu sát Thủ tướng.
Dialogue: 0,0:05:58.25,0:06:03.05,Default,,0000,0000,0000,,Tuy nhiên, vừa xuất hiện thêm một vụ án khác\Nmà một nghi phạm khả nghi đã lọt vào tầm ngắm.
Dialogue: 0,0:06:04.29,0:06:08.95,Default,,0000,0000,0000,,Tin mới toanh đấy nhỉ. Tôi tưởng Cơ quan Cảnh sát Quốc gia\Nđã từ chối tiết lộ mọi thông tin cơ mà.
Dialogue: 0,0:06:09.33,0:06:14.59,Default,,0000,0000,0000,,Đúng là họ đã từ chối. Không giống như vụ Kẻ Cười Tươi,\Nlần này họ đang hành xử hết sức nghiêm trọng.
Dialogue: 0,0:06:14.90,0:06:18.10,Default,,0000,0000,0000,,Phải thừa nhận rằng điều này đang dựng lên\Nnhững rào cản không cần thiết.
Dialogue: 0,0:06:18.70,0:06:20.60,Default,,0000,0000,0000,,Đoạn phim này không phải do bên cảnh sát\Ncung cấp,
Dialogue: 0,0:06:20.60,0:06:24.27,Default,,0000,0000,0000,,mà là thứ tôi đích thân thu thập được\Ntừ một bên liên quan.
Dialogue: 0,0:06:24.54,0:06:26.30,Default,,0000,0000,0000,,Từ một phóng viên của báo Nanyou,\Nphải không ạ?
Dialogue: 0,0:06:26.74,0:06:32.61,Default,,0000,0000,0000,,Chính xác. Vì lập trường chỉ trích gay gắt chính sách người tị nạn\Ncủa Báo Nanyou Shimbun,
Dialogue: 0,0:06:33.08,0:06:37.42,Default,,0000,0000,0000,,tòa soạn của họ đã bị Nhóm 11 Cá Nhân xả súng tấn công\Ntrong ba lần riêng biệt.
Dialogue: 0,0:06:37.82,0:06:44.56,Default,,0000,0000,0000,,Và người đàn ông này đều xuất hiện trên camera an ninh\Ntrong tất cả các lần đó.
Dialogue: 0,0:06:45.36,0:06:47.30,Default,,0000,0000,0000,,Tên anh ta là\NSho Kawashima.
Dialogue: 0,0:06:47.63,0:06:50.87,Default,,0000,0000,0000,,Anh ta bắt đầu làm đầu bếp nấu món chay\NĐài Loan...
Dialogue: 0,0:06:50.87,0:06:54.30,Default,,0000,0000,0000,,...tại một nhà hàng gần tòa soạn Nanyou\Ncách đây khoảng một tháng.
Dialogue: 0,0:06:54.87,0:06:57.90,Default,,0000,0000,0000,,Tôi đã khui ra được việc anh ta từng là\Nmột sĩ quan trong Lực lượng Phòng vệ.
Dialogue: 0,0:06:58.41,0:06:59.84,Default,,0000,0000,0000,,Thông tin tình báo này\Ntừ đâu ra thế?
Dialogue: 0,0:06:59.84,0:07:03.97,Default,,0000,0000,0000,,Tôi đã gửi dữ liệu cấu trúc khuôn mặt của hắn sang Cục Tình báo Quân đội\Nvà nhận được sự hỗ trợ từ họ.
Dialogue: 0,0:07:04.68,0:07:09.24,Default,,0000,0000,0000,,Nói cách khác, mối quan hệ của chúng ta với quân đội\Ngiờ đây còn tốt đẹp hơn với cảnh sát rồi nhỉ?
Dialogue: 0,0:07:10.12,0:07:13.02,Default,,0000,0000,0000,,Vậy, Thiếu tá muốn chúng tôi\Nxử lý gã này thế nào?
Dialogue: 0,0:07:13.89,0:07:15.53,Default,,0000,0000,0000,,Trước mắt,\Nhãy bắt giữ hắn về quy án.
Dialogue: 0,0:07:15.53,0:07:18.76,Default,,0000,0000,0000,,Tìm kiếm bất kỳ manh mối trọng yếu nào ẩn giấu\Ntrong hệ tư tưởng và lý lịch của hắn.
Dialogue: 0,0:07:19.36,0:07:23.39,Default,,0000,0000,0000,,Hiện tại, chúng ta chưa thể chứng minh được mối liên hệ nào\Ngiữa CIS và Nhóm 11 Cá Nhân,
Dialogue: 0,0:07:23.70,0:07:26.20,Default,,0000,0000,0000,,nhưng nếu lần ra được manh mối về việc véc-tơ nào\Nđã được sử dụng...
Dialogue: 0,0:07:26.20,0:07:28.91,Default,,0000,0000,0000,,...khiến các nhóm khủng bố độc lập này đồng loạt xuất hiện,
Dialogue: 0,0:07:28.91,0:07:31.20,Default,,0000,0000,0000,,chúng ta cũng sẽ tìm ra được\Nmục đích thực sự của bọn họ.
Dialogue: 0,0:07:32.01,0:07:33.50,Default,,0000,0000,0000,,Có lẽ cô nói đúng.
Dialogue: 0,0:07:34.54,0:07:38.74,Default,,0000,0000,0000,,Batou, Togusa, Saito và Pazu,\Ncác cậu phụ trách việc bắt giữ Sho Kawashima.
Dialogue: 0,0:07:39.35,0:07:42.68,Default,,0000,0000,0000,,Ishikawa và Borma, tiếp tục đào sâu\Nvào lý lịch của Gohda...
Dialogue: 0,0:07:43.05,0:07:46.32,Default,,0000,0000,0000,,...đồng thời điều tra kẻ đã ra tay mưu sát Thủ tướng.
Dialogue: 0,0:07:46.79,0:07:47.98,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:08:07.78,0:08:10.34,Default,,0000,0000,0000,,Cuối cùng thì chúng ta cũng được hành động\Nđúng với bản sắc của mình rồi,
Dialogue: 0,0:08:10.85,0:08:13.25,Default,,0000,0000,0000,,nhưng tôi thú thật là chẳng thể nào hiểu nổi\Nđám người này.
Dialogue: 0,0:08:13.55,0:08:15.88,Default,,0000,0000,0000,,Nhóm 11 Cá Nhân...
Dialogue: 0,0:08:16.45,0:08:20.79,Default,,0000,0000,0000,,Những lời khiếu nại trong bảy vụ án kia đều là những bài ca cũ rích\Nkiểu \"trả lại tự do cho người tị nạn\",
Dialogue: 0,0:08:20.79,0:08:22.66,Default,,0000,0000,0000,,nhưng tôi chẳng thấy có mối liên hệ nào\Ngắn kết bọn họ cả.
Dialogue: 0,0:08:23.29,0:08:27.66,Default,,0000,0000,0000,,Ngoài biểu tượng được vẽ trong các bức thư nhận trách nhiệm ra,\Ncũng chẳng có điểm chung nào khác.
Dialogue: 0,0:08:27.76,0:08:31.50,Default,,0000,0000,0000,,Nếu vụ này diễn biến theo đúng mô thức\Ncủa vụ Kẻ Cười Tươi,
Dialogue: 0,0:08:32.30,0:08:34.87,Default,,0000,0000,0000,,thì bản gốc nguyên bản của đám bắt chước này\Nchính là cái lũ...
Dialogue: 0,0:08:34.87,0:08:37.27,Default,,0000,0000,0000,,...đã cố thủ bên trong Đại sứ quán Trung Quốc,\Nđúng không nhỉ?
Dialogue: 0,0:08:38.34,0:08:42.07,Default,,0000,0000,0000,,Thì đúng là chúng {\i1}từng{\i0} là những kẻ đầu tiên\Ntự xưng là Nhóm 11 Cá Nhân...
Dialogue: 0,0:08:42.65,0:08:45.51,Default,,0000,0000,0000,,Ừ, nhưng không một ai trong số những kẻ khác\Ntự gọi mình bằng cái tên đó cả.
Dialogue: 0,0:08:45.92,0:08:48.61,Default,,0000,0000,0000,,Ngay cả chúng ta, lý do duy nhất\Nmà ta biết cách đọc biểu tượng đó...
Dialogue: 0,0:08:48.95,0:08:52.62,Default,,0000,0000,0000,,...cũng chỉ là vì tình cờ phát hiện ra bài tiểu luận của một nhà tư tưởng\Ntrong quá trình điều tra cái biểu tượng chết tiệt đó mà thôi.
Dialogue: 0,0:08:53.16,0:08:55.29,Default,,0000,0000,0000,,Trong một vụ án thuộc dạng phức hợp cô lập,
Dialogue: 0,0:08:55.29,0:08:59.69,Default,,0000,0000,0000,,thì vật trung gian châm ngòi cho động cơ phạm tội\Nchưa chắc đã là bản gốc nguyên bản, cậu nhớ chứ?
Dialogue: 0,0:09:00.20,0:09:01.60,Default,,0000,0000,0000,,Ừ, cậu nói phải.
Dialogue: 0,0:09:01.90,0:09:07.27,Default,,0000,0000,0000,,Dù vậy, tôi cảm thấy có nét nguyên bản hơn từ\Ncái đám sử dụng biểu tượng này.
Dialogue: 0,0:09:10.31,0:09:14.07,Default,,0000,0000,0000,,Kinh tởm thật! Cái quái gì thế này?\NĐây là đồ ăn cho cyborg mà!
Dialogue: 0,0:09:14.21,0:09:16.77,Default,,0000,0000,0000,,Bình tĩnh nào, không chết được đâu.
Dialogue: 0,0:09:17.01,0:09:21.95,Default,,0000,0000,0000,,Nó được làm từ 90% gluten, cộng thêm một chút\Nvi cơ điện tử gốc axit amin thôi mà.
Dialogue: 0,0:09:24.22,0:09:25.98,Default,,0000,0000,0000,,Này. Có tin gì mới không?
Dialogue: 0,0:09:26.86,0:09:29.85,Default,,0000,0000,0000,,Chẳng có gì cả. Anh ta đã không về căn hộ của mình\Nsuốt hơn bốn ngày nay rồi.
Dialogue: 0,0:09:30.29,0:09:32.52,Default,,0000,0000,0000,,Tôi sẽ thử mai phục\Ntại tòa soạn báo xem sao.
Dialogue: 0,0:09:32.76,0:09:33.82,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:09:35.40,0:09:39.80,Default,,0000,0000,0000,,{\i1}Xem ra chúng ta đã xuất phát chậm chân. Ngay cả tin mật sốt dẻo{\i0}\N{\i1}cũng trở nên vô dụng khi quá hạn sử dụng.{\i0}
Dialogue: 0,0:09:41.00,0:09:44.50,Default,,0000,0000,0000,,{\i1}Bây giờ tính sao đây, Thiếu tá?{\i0}\N{\i1}Cô muốn chúng tôi tiếp tục mai phục à?{\i0}
Dialogue: 0,0:09:44.54,0:09:49.21,Default,,0000,0000,0000,,{\i1}Bắt giữ hắn là ưu tiên hàng đầu của chúng ta,{\i0}\N{\i1}nên việc duy nhất ta có thể làm là đánh cược vào xác suất thôi.{\i0}
Dialogue: 0,0:09:49.81,0:09:52.61,Default,,0000,0000,0000,,{\i1}Tòa soạn Báo Nanyou Shimbun{\i0}\N{\i1}vẫn đang tiếp tục nhận được những lời đe dọa,{\i0}
Dialogue: 0,0:09:52.85,0:09:55.61,Default,,0000,0000,0000,,{\i1}và hắn vẫn đi làm đều đặn tại nhà hàng{\i0}\N{\i1}cho đến tận ngày hôm qua cơ mà.{\i0}
Dialogue: 0,0:09:55.82,0:09:57.79,Default,,0000,0000,0000,,{\i1}Dù vậy chúng ta đâu thực sự chủ động{\i0}\N{\i1}trong vụ này được.{\i0}
Dialogue: 0,0:09:57.85,0:10:00.65,Default,,0000,0000,0000,,{\i1}Tôi đã cử thêm viện binh tới{\i0}\N{\i1}để gia tăng cơ hội của chúng ta rồi.{\i0}
Dialogue: 0,0:10:01.02,0:10:04.26,Default,,0000,0000,0000,,{\i1}Màn mai phục của chúng ta chẳng thể nào hiệu quả hơn{\i0}\N{\i1}chỉ với ba con Tachikoma đâu.{\i0}
Dialogue: 0,0:10:04.69,0:10:06.49,Default,,0000,0000,0000,,{\i1}Đừng nói thế chứ,{\i0}\N{\i1}bác Togusa chí cốt!{\i0}
Dialogue: 0,0:10:06.83,0:10:10.23,Default,,0000,0000,0000,,{\i1}Bọn em giờ đây có thể duy trì cá tính độc lập{\i0}\N{\i1}ngay cả khi đang đồng bộ hóa dữ liệu cơ mà,{\i0}
Dialogue: 0,0:10:10.40,0:10:13.10,Default,,0000,0000,0000,,{\i1}và bọn em thậm chí còn được cài đặt thêm{\i0}\N{\i1}chức năng đặc vụ phân thân nữa đấy!{\i0}
Dialogue: 0,0:10:13.27,0:10:14.53,Default,,0000,0000,0000,,{\i1}Tuyệt đỉnh cú mèo!{\i0}
Dialogue: 0,0:10:17.21,0:10:20.51,Default,,0000,0000,0000,,{\i1}Nó hơi giống kiểu bọn em có thể thực hiện thuật{\i0}\N{\i1}\"xuất hồn ngoại thể\" lúc này vậy.{\i0}
Dialogue: 0,0:10:20.58,0:10:22.64,Default,,0000,0000,0000,,{\i1}Bằng cách này, bọn em có thể xuất hồn đi khắp nơi{\i0}\N{\i1}để liên tục hấp thụ dữ liệu...{\i0}
Dialogue: 0,0:10:22.71,0:10:25.51,Default,,0000,0000,0000,,{\i1}...trong khi thể xác thực tế vẫn giữ nguyên{\i0}\N{\i1}vị trí mai phục tại hiện trường!{\i0}
Dialogue: 0,0:10:25.65,0:10:28.71,Default,,0000,0000,0000,,{\i1}Bọn em gọi đó là một\N{\i1}\"bữa tiệc buffet dữ liệu\" đấy ạ!{\i0}
Dialogue: 0,0:10:28.92,0:10:30.35,Default,,0000,0000,0000,,{\i1}Tán gẫu thế là đủ rồi!{\i0}
Dialogue: 0,0:10:30.35,0:10:33.65,Default,,0000,0000,0000,,{\i1}Batou, hãy tăng cường chức năng dò tìm{\i0}\N{\i1}của hệ thống cảm biến hồng ngoại IR...{\i0}
Dialogue: 0,0:10:34.09,0:10:36.58,Default,,0000,0000,0000,,{\i1}...và chủ động truy lùng Kawashima{\i0}\N{\i1}để bắt hắn về quy án.{\i0}
Dialogue: 0,0:10:36.89,0:10:37.86,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:10:38.09,0:10:39.79,Default,,0000,0000,0000,,{\i1}Buffet dữ liệu! Buffet dữ liệu!{\i0}
Dialogue: 0,0:10:40.06,0:10:43.52,Default,,0000,0000,0000,,Thiếu tá nâng cấp cho đám đó\Ntừ hồi nào thế không biết?
Dialogue: 0,0:10:44.00,0:10:47.56,Default,,0000,0000,0000,,Cậu phải thừa nhận là dạo này\Nchúng ta đang {\i1}rất{\i0} thiếu nhân lực mà.
Dialogue: 0,0:10:50.87,0:10:52.81,Default,,0000,0000,0000,,{\i1}Trời ạ, chẳng thấy bóng dáng của gã này{\i0}\N{\i1}ở bất cứ xó xỉnh nào cả.{\i0}
Dialogue: 0,0:10:53.31,0:10:56.35,Default,,0000,0000,0000,,{\i1}Người ta sẽ nghĩ rằng ai cũng có thể truy tìm ra một kẻ nào đó,{\i0}\N{\i1}chắc chắn là thế...{\i0}
Dialogue: 0,0:10:56.35,0:10:58.81,Default,,0000,0000,0000,,{\i1}...nếu kẻ đó dám liều lĩnh đổi sang một cơ thể giả{\i0}\N{\i1}chuyên dụng cho Lực lượng Gìn giữ Hòa bình PKF.{\i0}
Dialogue: 0,0:10:59.18,0:11:01.34,Default,,0000,0000,0000,,{\i1}Có khi hắn chẳng còn ở trong nước{\i0}\N{\i1}nữa rồi cũng nên.{\i0}
Dialogue: 0,0:11:01.75,0:11:04.81,Default,,0000,0000,0000,,Chuyện này suýt nữa làm người ta nghi ngờ khả năng\Nthao túng thông tin của CIS đấy nhỉ?
Dialogue: 0,0:11:05.39,0:11:09.29,Default,,0000,0000,0000,,Thiếu tá, tôi vừa tìm thấy một thứ rất thú vị\Ntrên mạng nội bộ địa phương.
Dialogue: 0,0:11:09.86,0:11:12.16,Default,,0000,0000,0000,,Đó là luận văn tốt nghiệp của Gohda\Nthời hắn còn là sinh viên.
Dialogue: 0,0:11:12.86,0:11:14.93,Default,,0000,0000,0000,,\"Xét việc Não điện tử\NChi phối Quá trình Xã hội hóa,\"
Dialogue: 0,0:11:14.93,0:11:18.20,Default,,0000,0000,0000,,\"Chúng sẽ Ưu ái điều gì hơn?\NTính Cá nhân hay Tính Tập thể?\"
Dialogue: 0,0:11:18.57,0:11:21.33,Default,,0000,0000,0000,,\"Lý thuyết về Chủ nghĩa Anh hùng\Ndưới Góc nhìn của một Nhà sản xuất.\"
Dialogue: 0,0:11:22.37,0:11:24.87,Default,,0000,0000,0000,,Những gì hắn viết trong đó\Nthú vị đến bất ngờ.
Dialogue: 0,0:11:24.87,0:11:27.81,Default,,0000,0000,0000,,Đúng như tiêu đề bài viết, hắn gợi ý rằng trong cấu trúc xã hội hiện nay của chúng ta,
Dialogue: 0,0:11:27.81,0:11:31.08,Default,,0000,0000,0000,,não điện tử có xu hướng gieo rắc một khao khát vô thức\Nvề tính tập thể...
Dialogue: 0,0:11:31.08,0:11:34.38,Default,,0000,0000,0000,,...đồng thời triệt tiêu hoàn toàn\Ntính cá nhân riêng biệt.
Dialogue: 0,0:11:34.65,0:11:38.79,Default,,0000,0000,0000,,Nhưng để đáp lại điều này, hệ thống sẽ sản sinh ra\Nmột thủ lĩnh như một phần tất yếu của nó...
Dialogue: 0,0:11:38.79,0:11:42.22,Default,,0000,0000,0000,,...kẻ có ý thức thao túng và kiểm soát\Ntiềm thức của quần chúng số đông.
Dialogue: 0,0:11:43.36,0:11:46.96,Default,,0000,0000,0000,,Nghe như thể hắn đã mổ xẻ phân tích kỹ lưỡng vụ án Kẻ Cười Tươi\Ntừ trước rồi ấy nhỉ?
Dialogue: 0,0:11:46.96,0:11:49.93,Default,,0000,0000,0000,,Ừ. Nhưng đánh giá từ mốc thời gian ghi trên đó,
Dialogue: 0,0:11:49.93,0:11:53.90,Default,,0000,0000,0000,,thứ này được viết từ rất lâu trước khi\Nvụ án Kẻ Cười Tươi xảy ra.
Dialogue: 0,0:11:54.77,0:11:59.97,Default,,0000,0000,0000,,Sau đó, hắn theo học ngành Khoa học Thông tin,\NĐạo đức Thông tin và Tin học Ứng dụng,
Dialogue: 0,0:12:00.44,0:12:02.64,Default,,0000,0000,0000,,rồi vào làm việc tại một công ty tư nhân\Ntrong một thời gian.
Dialogue: 0,0:12:02.95,0:12:03.88,Default,,0000,0000,0000,,Công ty tư nhân sao?
Dialogue: 0,0:12:05.58,0:12:08.28,Default,,0000,0000,0000,,Một tập đoàn đa quốc gia khổng lồ mà ngày nay\Nai ai cũng biết tới danh tiếng...
Dialogue: 0,0:12:08.28,0:12:11.82,Default,,0000,0000,0000,,...nhờ công nghệ cơ thể nhân tạo\Nvà chế tạo vi cơ điện tử micromachine của họ.
Dialogue: 0,0:12:11.82,0:12:13.85,Default,,0000,0000,0000,,Tập đoàn Công nghiệp Poseidon.
Dialogue: 0,0:12:14.36,0:12:16.83,Default,,0000,0000,0000,,Thời đó, họ mang tên Viện Nghiên cứu Kỹ thuật\NĐại Nhật Bản.
Dialogue: 0,0:12:24.03,0:12:26.70,Default,,0000,0000,0000,,Đi vào đường cao tốc\Nvà hướng về Hakata.
Dialogue: 0,0:12:27.17,0:12:28.57,Default,,0000,0000,0000,,Tôi rõ rồi thưa ngài.
Dialogue: 0,0:12:32.18,0:12:33.34,Default,,0000,0000,0000,,Tôi đây.
Dialogue: 0,0:12:33.68,0:12:37.31,Default,,0000,0000,0000,,{\i1}Xin lỗi nhé Aramaki, tôi sẽ không thể{\i0}\N{\i1}rời đi lâu được đâu.{\i0}
Dialogue: 0,0:12:37.81,0:12:39.30,Default,,0000,0000,0000,,{\i1}Khi nào thì ông{\i0}\N{\i1}tới đây?{\i0}
Dialogue: 0,0:12:39.72,0:12:41.15,Default,,0000,0000,0000,,Đúng giờ hẹn thôi.\NSao thế?
Dialogue: 0,0:12:41.45,0:12:44.89,Default,,0000,0000,0000,,{\i1}Ồ, thật thế à? Trong trường hợp đó,{\i0}\N{\i1}hay là chúng ta ghé cái quán ăn hôm trước nhé?{\i0}
Dialogue: 0,0:12:45.39,0:12:47.98,Default,,0000,0000,0000,,{\i1}Dù sao thì chúng ta cũng không nên gặp gỡ ở nơi nào{\i0}\N{\i1}quá lộ liễu trước công chúng.{\i0}
Dialogue: 0,0:12:48.29,0:12:49.55,Default,,0000,0000,0000,,Tôi sao cũng được.
Dialogue: 0,0:12:49.63,0:12:52.19,Default,,0000,0000,0000,,{\i1}Được rồi. Vậy tôi sẽ gặp ông{\i0}\N{\i1}ở đó nhé.{\i0}
Dialogue: 0,0:13:02.67,0:13:05.07,Default,,0000,0000,0000,,Trời ơi, nhìn ngon mắt quá...
Dialogue: 0,0:13:05.88,0:13:08.67,Default,,0000,0000,0000,,Dạo gần đây tôi chẳng mấy khi\Nđược về nhà cả.
Dialogue: 0,0:13:08.95,0:13:11.91,Default,,0000,0000,0000,,Cậu có biết món đó\Nlà món gì không đấy?
Dialogue: 0,0:13:12.01,0:13:15.31,Default,,0000,0000,0000,,Lươn chứ gì? Ngay cả tôi mà {\i1}còn{\i0}\Nbiết được chừng đó.
Dialogue: 0,0:13:15.38,0:13:21.25,Default,,0000,0000,0000,,Đoán lại đi. Đó là món lươn giả được làm từ\Ngluten và nấm hương đấy.
Dialogue: 0,0:13:22.59,0:13:24.19,Default,,0000,0000,0000,,Ẩm thực đồ chay Đài Loan.
Dialogue: 0,0:13:24.19,0:13:27.66,Default,,0000,0000,0000,,Thứ mà người ta gọi là {\i1}Tố thực{\i0} là một phong cách nấu ăn đặc biệt\Ncó lịch sử lâu đời...
Dialogue: 0,0:13:27.66,0:13:30.15,Default,,0000,0000,0000,,...được các nhà sư Phật giáo\Nđộc lập sáng tạo nên.
Dialogue: 0,0:13:31.00,0:13:32.99,Default,,0000,0000,0000,,Nó giống như món chay thanh tịnh\Ncủa nhà chùa hả anh?
Dialogue: 0,0:13:33.50,0:13:34.60,Default,,0000,0000,0000,,Ừ, đại loại là thế.
Dialogue: 0,0:13:34.90,0:13:39.10,Default,,0000,0000,0000,,Tuy nhiên, không giống như ẩm thực chay của Phật giáo Nhật Bản\Nvốn giữ nguyên hương vị tự nhiên của nguyên liệu,
Dialogue: 0,0:13:39.61,0:13:44.14,Default,,0000,0000,0000,,nó biến hóa đậu nành và nấm\Nđể tái tạo lại hương vị thịt và cá.
Dialogue: 0,0:13:44.81,0:13:48.58,Default,,0000,0000,0000,,Về cơ bản nó cũng giống hệt cái bánh mì kẹp\Nmà ban nãy cậu ăn dở rồi bỏ đấy thôi.
Dialogue: 0,0:13:50.75,0:13:52.35,Default,,0000,0000,0000,,Anh nghiêm túc đấy à?
Dialogue: 0,0:13:53.82,0:13:59.28,Default,,0000,0000,0000,,Nhưng tại sao các nhà sư Đài Loan lại phải kỳ công nghĩ ra\Nmột phong cách nấu ăn cầu kỳ phức tạp đến thế chứ?
Dialogue: 0,0:14:00.10,0:14:03.73,Default,,0000,0000,0000,,Nếu họ chưa từng biết mùi vị của thịt ra sao,\Nthì đâu có nhu cầu phải làm thế, đúng không?
Dialogue: 0,0:14:04.03,0:14:05.54,Default,,0000,0000,0000,,Đúng là như vậy.
Dialogue: 0,0:14:05.54,0:14:09.73,Default,,0000,0000,0000,,Nhưng trước khi xuất gia quy y cửa Phật,\Ncon người ta có thể ăn bất cứ thứ gì họ muốn.
Dialogue: 0,0:14:10.51,0:14:14.44,Default,,0000,0000,0000,,Cậu có thể ngồi thiền bao lâu tùy thích, nhưng cậu chẳng bao giờ\Nxóa bỏ được những ký ức hương vị đó đâu.
Dialogue: 0,0:14:14.98,0:14:16.50,Default,,0000,0000,0000,,Tôi đoán nghe cũng\Ncó lý đấy.
Dialogue: 0,0:14:16.78,0:14:18.68,Default,,0000,0000,0000,,Dù vậy, trông anh có vẻ am hiểu\Nvề món này ghê nhỉ.
Dialogue: 0,0:14:19.15,0:14:22.28,Default,,0000,0000,0000,,Đừng bảo với tôi là người khổng lồ như anh cũng hoài niệm\Nhương vị đồ ăn thật ngày xưa đấy nhé.
Dialogue: 0,0:14:24.09,0:14:27.42,Default,,0000,0000,0000,,Bộ não con người luôn khao khát thèm thuồng thức ăn,\Nngay cả khi cậu đã biến thành một cyborg.
Dialogue: 0,0:14:27.66,0:14:31.49,Default,,0000,0000,0000,,Đó chính là lý do vì sao người ta lại sản xuất ra\Nnhững món ăn mô phỏng mới lạ dành riêng cho cyborg.
Dialogue: 0,0:14:32.96,0:14:37.96,Default,,0000,0000,0000,,Vị giác đóng vai trò như một thiết bị phát lại\Nnhững ký ức đã qua, nhỉ?
Dialogue: 0,0:14:38.90,0:14:41.23,Default,,0000,0000,0000,,Cái gã Kawashima này học được cách nấu\Nmấy món này ở đâu được nhỉ?
Dialogue: 0,0:14:41.67,0:14:45.33,Default,,0000,0000,0000,,Có lẽ hắn đã học lỏm được trong thời gian\Nđóng quân ở Đài Loan.
Dialogue: 0,0:14:45.91,0:14:47.71,Default,,0000,0000,0000,,Mở to mắt ra mà quan sát đấy,\Nmấy nhóc.
Dialogue: 0,0:14:49.55,0:14:50.81,Default,,0000,0000,0000,,Rõ rồi ạ sếp!
Dialogue: 0,0:14:50.81,0:14:52.04,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:14:55.82,0:14:58.99,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chủ đề của chúng ta tối nay là{\i0}\N{\i1}\"Vấn đề Người tị nạn và Khủng bố\".{\i0}
Dialogue: 0,0:14:58.99,0:15:02.15,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi muốn điểm lại luận điểm của ông một lần nữa{\i0}\N{\i1}để xem tôi có hiểu đúng hay không.{\i0}
Dialogue: 0,0:15:02.79,0:15:05.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Có phải ông đang cho rằng sự bất cẩn của chính phủ...{\i0}
Dialogue: 0,0:15:05.36,0:15:07.73,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...khi đánh mất phương hướng mục tiêu chính sách của mình{\i0}\N{\i1}đã làm nảy sinh những kẻ theo chủ nghĩa cá nhân,{\i0}
Dialogue: 0,0:15:07.80,0:15:12.54,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và những phần tử cực đoan đã xuất hiện{\i0}\N{\i1}đang tìm kiếm một cuộc phục hưng như một câu trả lời?{\i0}
Dialogue: 0,0:15:12.54,0:15:13.64,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Các vị đã hoàn toàn{\i0}\N{\i1}hiểu sai vấn đề rồi.{\i0}
Dialogue: 0,0:15:13.64,0:15:16.33,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Bọn họ không hề lộ diện chỉ vì{\i0}\N{\i1}chính quyền này tỏ ra yếu hèn.{\i0}
Dialogue: 0,0:15:16.97,0:15:19.94,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Các nghị sĩ có tư tưởng quốc phòng đã nung nấu ý đồ{\i0}\N{\i1}về Hiệp ước An ninh Mỹ - Nhật Mới...{\i0}
Dialogue: 0,0:15:19.94,0:15:22.31,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...từ rất lâu trước khi chính quyền hiện tại{\i0}\N{\i1}chính thức lên nắm quyền.{\i0}
Dialogue: 0,0:15:22.81,0:15:25.65,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Bọn họ từng nghĩ rằng họ có thể{\i0}\N{\i1}giành lấy thế chủ động từ tay người Mỹ.{\i0}
Dialogue: 0,0:15:26.45,0:15:29.98,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Điều đó có nghĩa là những kẻ theo chủ nghĩa cá nhân{\i0}\N{\i1}vốn dĩ đã hiện diện trong suốt thời gian đó rồi.{\i0}
Dialogue: 0,0:15:30.55,0:15:33.15,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Ngược lại, thứ thực sự đã kích động{\i0}\N{\i1}những kẻ theo chủ nghĩa cá nhân...{\i0}
Dialogue: 0,0:15:33.22,0:15:36.12,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...chính là ba triệu người tị nạn{\i0}\N{\i1}đang ngốn sạch tiền thuế mồ hôi nước mắt của chúng ta!{\i0}
Dialogue: 0,0:15:37.23,0:15:39.93,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Họ đã nghĩ rằng: \"Đã đến lúc đất nước này{\i0}\N{\i1}phải dũng cảm đứng lên...{\i0}
Dialogue: 0,0:15:38.77,0:15:40.27,GitS Signs B/W,,0000,0000,0000,,{\pos(930,903)\frz358.254}Dobashi
Dialogue: 0,0:15:40.30,0:15:42.23,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}\"...và làm một điều gì đó quyết liệt{\i0}\N{\i1}đối với đám người kia!\"{\i0}
Dialogue: 0,0:15:43.90,0:15:45.37,Default,,0000,0000,0000,,Cái này mới thật là\Nthú vị đây.
Dialogue: 0,0:15:45.43,0:15:48.87,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Nếu đúng là như vậy, lẽ ra chúng ta không bao giờ nên{\i0}\N{\i1}tiếp nhận họ ngay từ đầu mới phải.{\i0}
Dialogue: 0,0:15:49.41,0:15:51.37,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Những lời lẽ như thế{\i0}\N{\i1}sẽ hủy hoại sự nghiệp chính trị của ông đấy.{\i0}
Dialogue: 0,0:15:51.37,0:15:54.01,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Nhưng các vị có biết thuế suất của chúng ta{\i0}\N{\i1}đã tăng chóng mặt đến mức nào...{\i0}
Dialogue: 0,0:15:54.01,0:15:57.41,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...sau khi Chính sách Người tị nạn được áp dụng{\i0}\N{\i1}kể từ thời điểm đó hay không?{\i0}
Dialogue: 0,0:15:57.41,0:16:01.95,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Và số tiền thuế khổng lồ đó đang bốc hơi vào bóng tối{\i0}\N{\i1}dưới chiêu bài của Chính sách Người tị nạn.{\i0}
Dialogue: 0,0:16:01.35,0:16:02.59,Default,,0000,0000,0000,,Có ai ở đó không?
Dialogue: 0,0:16:01.95,0:16:05.45,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi hoàn toàn không hiểu nổi vì sao phe cầm quyền{\i0}\N{\i1}lại không chịu từ bỏ...{\i0}
Dialogue: 0,0:16:02.89,0:16:08.39,Default,,0000,0000,0000,,Mang cho tôi một chiếc đĩa ghi lại chương trình tranh luận\Nđang phát trên kênh 3-3 ngay lúc này.
Dialogue: 0,0:16:05.45,0:16:09.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...cái chính sách hành động chẳng khác nào bệ đỡ dung túng{\i0}\N{\i1}cho các hoạt động phạm tội đó đi cho rồi.{\i0}
Dialogue: 0,0:16:08.39,0:16:09.36,Default,,0000,0000,0000,,{\i1}Tôi rõ rồi thưa sếp.{\i0}
Dialogue: 0,0:16:09.59,0:16:11.69,Default,,0000,0000,0000,,Và dĩ nhiên, hãy tiếp tục\Nghi hình chương trình đó.
Dialogue: 0,0:16:10.23,0:16:11.69,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i0}Chẳng có gì đáng ngạc nhiên cả.{\i1}
Dialogue: 0,0:16:11.69,0:16:15.00,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Xin hãy lắng nghe tôi, nếu những người tị nạn bất ngờ{\i0}\N{\i1}bị kích động bởi một ngòi nổ nào đó,{\i0}
Dialogue: 0,0:16:15.00,0:16:17.47,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}đó sẽ là lúc họ thực sự{\i0}\N{\i1}hoàn toàn mất kiểm soát.{\i0}
Dialogue: 0,0:16:18.43,0:16:21.57,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Thứ mà người ta thường gọi là{\i0}\N{\i1}những vụ đánh bom liều chết...{\i0}
Dialogue: 0,0:16:21.57,0:16:25.51,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...chính là thứ vũ khí bước đường cùng được sử dụng khi con người ta{\i0}\N{\i1}đánh mất đi tia hy vọng mong manh cuối cùng vào tương lai.{\i0}
Dialogue: 0,0:16:26.11,0:16:30.44,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Đó là lý do tại sao điều sống còn là chúng ta phải khuyến khích họ{\i0}\N{\i1}tự chủ độc lập về mặt kinh tế.{\i0}
Dialogue: 0,0:16:30.81,0:16:33.32,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Trao cho họ tự do dưới vỏ bọc{\i0}\N{\i1}của sự giải phóng.{\i0}
Dialogue: 0,0:16:33.32,0:16:35.28,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Ông đang nói cái điều quái gở gì{\i0}\N{\i1}trên đời này thế hả?{\i0}
Dialogue: 0,0:16:35.28,0:16:38.89,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Người tị nạn sẽ chẳng thể nào tự giải quyết nổi{\i0}\N{\i1}những vấn đề của chính mình...{\i0}
Dialogue: 0,0:16:38.89,0:16:41.49,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...chỉ đơn thuần bằng việc ban phát tự do cho họ đâu,{\i0}\N{\i1}và ông thừa biết điều đó mà!{\i0}
Dialogue: 0,0:17:00.88,0:17:04.00,Default,,0000,0000,0000,,{\i1}Tachikoma. Tra cứu đối chiếu biển số{\i0}\N{\i1}của chiếc xe tải van đó đi.{\i0}
Dialogue: 0,0:17:04.25,0:17:05.51,Default,,0000,0000,0000,,{\i1}Rõ rồi ạ sếp!{\i0}
Dialogue: 0,0:17:07.98,0:17:10.95,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Bây giờ khi chúng ta đã điểm qua các tình tiết cụ thể{\i0}\N{\i1}của những vụ khủng bố khác nhau,{\i0}
Dialogue: 0,0:17:09.36,0:17:11.94,GitS Signs B/W 2,,0000,0000,0000,,{\pos(1290,879)\frx0\fry4\frz10.601}Dobashi Fumiya
Dialogue: 0,0:17:10.95,0:17:13.15,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}tại sao chúng ta không bắt đầu thảo luận{\i0}\N{\i1}về những ví dụ cụ thể nhỉ?{\i0}
Dialogue: 0,0:17:10.95,0:17:11.99,Default,,0000,0000,0000,,{\i1}Khoan đã nào...{\i0}
Dialogue: 0,0:17:13.29,0:17:16.36,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Thưa ông Dobashi, vụ việc khủng bố mà ông bảo rằng...{\i0}
Dialogue: 0,0:17:13.29,0:17:14.59,Default,,0000,0000,0000,,{\i1}Tên của anh ta có ghi trên...{\i0}
Dialogue: 0,0:17:16.36,0:17:18.13,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...Cơ quan Cảnh sát Quốc gia{\i0}\N{\i1}đang cố tình bưng bít che đậy rốt cuộc là gì thế?{\i0}
Dialogue: 0,0:17:18.13,0:17:21.43,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi tin rằng tất cả mọi người có mặt ở đây{\i0}\N{\i1}đều biết về chính vụ án đó.{\i0}
Dialogue: 0,0:17:21.73,0:17:24.33,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Các vị đều biết rằng kể từ sau vụ đánh chiếm{\i0}\N{\i1}Đại sứ quán Trung Quốc,{\i0}
Dialogue: 0,0:17:24.33,0:17:27.13,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}đã có khoảng tám vụ khủng bố lớn nhỏ xảy ra,{\i0}\N{\i1}tôi đoán không lầm chứ?{\i0}
Dialogue: 0,0:17:27.80,0:17:30.41,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Ý ông là các vụ đâm chết nhạc sĩ não điện tử...{\i0}
Dialogue: 0,0:17:30.41,0:17:33.81,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...và vị chính khách từng ủng hộ chính sách hòa giải{\i0}\N{\i1}đối với người tị nạn ấy hả?{\i0}
Dialogue: 0,0:17:34.04,0:17:35.01,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Vâng, đúng vậy.{\i0}
Dialogue: 0,0:17:35.28,0:17:38.28,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Có một sự thật liên quan đến những sự việc đó{\i0}\N{\i1}mà Cơ quan Cảnh sát Quốc gia...{\i0}
Dialogue: 0,0:17:38.28,0:17:40.75,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...đã hoàn toàn không hề đả động tới{\i0}\N{\i1}trong các thông cáo báo chí của mình.{\i0}
Dialogue: 0,0:17:40.75,0:17:43.18,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Đừng có úp úp mở mở câu giờ nữa!{\i0}\N{\i1}Mau nói cho chúng tôi biết đi!{\i0}
Dialogue: 0,0:17:46.42,0:17:48.55,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Mọi người đã từng nhìn thấy{\i0}\N{\i1}biểu tượng này bao giờ chưa?{\i0}
Dialogue: 0,0:17:49.93,0:17:53.22,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Trông như một chiếc xe van bình thường{\i0}\N{\i1}được đăng ký dưới tên một chuỗi bán lẻ.{\i0}
Dialogue: 0,0:17:53.93,0:17:54.56,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Ồ, thế à?{\i0}
Dialogue: 0,0:17:54.56,0:17:57.13,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Biểu tượng này chính là điểm chung duy nhất{\i0}\N{\i1}xuất hiện trên tất cả các bức thư...{\i0}
Dialogue: 0,0:17:57.13,0:17:59.97,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...được gửi tới như những bản tuyên bố nhận trách nhiệm{\i0}\N{\i1}cho các tội ác đó.{\i0}
Dialogue: 0,0:18:00.14,0:18:02.44,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi chưa từng nghe thấy bất cứ điều gì{\i0}\N{\i1}về chuyện đó cả.{\i0}
Dialogue: 0,0:18:00.14,0:18:02.94,Default,,0000,0000,0000,,Làm quái nào mà gã này\Nlại biết được điều đó chứ?
Dialogue: 0,0:18:02.44,0:18:06.41,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi cũng chưa từng nghe qua.{\i0}\N{\i1}Nguồn tin của ông từ đâu ra vậy?{\i0}
Dialogue: 0,0:18:02.94,0:18:06.41,Default,,0000,0000,0000,,Tình hình thế nào rồi? Cậu phó mặc hết mọi việc canh chừng\Ncho lũ Tachikoma đấy à?
Dialogue: 0,0:18:06.41,0:18:09.05,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Chà, đó là bí mật nghề nghiệp của tôi rồi.{\i0}
Dialogue: 0,0:18:06.54,0:18:08.21,Default,,0000,0000,0000,,Không, tôi...
Dialogue: 0,0:18:09.05,0:18:11.04,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Thế thì câu trả lời đó chẳng có sức thuyết phục chút nào rồi.{\i0}
Dialogue: 0,0:18:10.15,0:18:11.04,Default,,0000,0000,0000,,Cầm lấy đi.
Dialogue: 0,0:18:11.65,0:18:16.95,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Trong trường hợp đó, các vị có thể sẽ hơi giật mình kinh ngạc{\i0}\N{\i1}khi biết được cách đọc biểu tượng này đấy.{\i0}
Dialogue: 0,0:18:12.35,0:18:14.02,Default,,0000,0000,0000,,Giờ này mà còn tâm trí đâu\Nđể ăn mấy thứ đó chứ?
Dialogue: 0,0:18:14.78,0:18:16.95,Default,,0000,0000,0000,,Lại làm sao {\i1}nữa{\i0} đây?\NĐây là đồ ăn thật đấy nhé.
Dialogue: 0,0:18:16.95,0:18:17.98,Default,,0000,0000,0000,,Ý tôi không phải chuyện đó!
Dialogue: 0,0:18:18.39,0:18:23.09,Default,,0000,0000,0000,,Gã này... Tôi nghĩ hắn là thành viên trong nhóm phóng viên\Nmà ban nãy tôi vừa mới gặp,
Dialogue: 0,0:18:18.59,0:18:21.59,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Cách đọc chính xác của biểu tượng này{\i0}\N{\i1}là \"Nhóm 11 Cá Nhân\".{\i0}
Dialogue: 0,0:18:22.19,0:18:27.13,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Mặc dù cái tên đó được lấy từ tựa đề của một bài tiểu luận{\i0}\N{\i1}được viết cách đây khoảng năm mươi năm,{\i0}
Dialogue: 0,0:18:23.43,0:18:27.06,Default,,0000,0000,0000,,và hắn nắm giữ những thông tin tuyệt mật\Nvề vụ án Nhóm 11 Cá Nhân.
Dialogue: 0,0:18:27.13,0:18:29.70,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Những nhóm đứng đằng sau các sự việc này,{\i0}\N{\i1}những kẻ sử dụng cái tên này...{\i0}
Dialogue: 0,0:18:29.70,0:18:32.60,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...chính là những nhóm cá nhân xuất hiện độc lập{\i0}\N{\i1}mà không hề có bất kỳ mối liên hệ nào với nhau,{\i0}
Dialogue: 0,0:18:32.60,0:18:36.06,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và tất cả bọn họ đều được thúc đẩy bởi mục tiêu{\i0}\N{\i1}giải phóng người tị nạn.{\i0}
Dialogue: 0,0:18:36.37,0:18:40.21,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Những kẻ theo chủ nghĩa cá nhân có lần xuất hiện đầu tiên{\i0}\N{\i1}trùng khớp một cách kỳ lạ với...{\i0}
Dialogue: 0,0:18:36.37,0:18:38.44,Default,,0000,0000,0000,,Cái thằng cha này\Nđang nói cái quái gì thế?
Dialogue: 0,0:18:40.21,0:18:42.91,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}...những chiếc trực thăng của Lục quân Phòng vệ bay lượn vòng tròn{\i0}\N{\i1}trên bầu trời khu thị trấn người tị nạn.{\i0}
Dialogue: 0,0:18:43.25,0:18:48.08,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Những nhóm này chính là những tác nhân có động cơ chân chính,{\i0}\N{\i1}những người thực sự nỗ lực giải phóng người tị nạn.{\i0}
Dialogue: 0,0:18:45.38,0:18:48.08,Default,,0000,0000,0000,,Mình chưa từng nghĩ tới\Nphương thức lây nhiễm này...
Dialogue: 0,0:18:48.62,0:18:49.55,Default,,0000,0000,0000,,Vâng thưa ngài.
Dialogue: 0,0:18:48.98,0:18:53.72,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Tôi rất tiếc phải cắt ngang, nhưng chúng ta{\i0}\N{\i1}buộc phải tạm dừng để dành thời lượng cho quảng cáo.{\i0}
Dialogue: 0,0:18:49.55,0:18:52.46,Default,,0000,0000,0000,,Chúng ta không thể bôi nhọ thanh danh tốt đẹp của cảnh sát,\Nvì vậy tôi nghĩ...
Dialogue: 0,0:18:52.46,0:18:54.02,Default,,0000,0000,0000,,...thứ này sẽ là một thiết bị phóng hỏa châm ngòi\Nhoàn hảo.
Dialogue: 0,0:18:54.12,0:18:57.66,Default,,0000,0000,0000,,Tôi cho là vậy. Nhân tiện, việc xử lý những vật trung gian lây nhiễm...
Dialogue: 0,0:18:57.66,0:19:00.49,Default,,0000,0000,0000,,...trong vụ Nanyou và vụ mưu sát Thủ tướng\Nđang được tiến hành thế nào rồi?
Dialogue: 0,0:19:01.03,0:19:04.77,Default,,0000,0000,0000,,Thưa ngài. Về kẻ mang mầm bệnh vụ Nanyou, chúng tôi đã thao túng\NĐội An ninh Công cộng 1,
Dialogue: 0,0:19:04.77,0:19:07.86,Default,,0000,0000,0000,,nên tôi tin rằng chúng ta sẽ sớm thực hiện\Nmột cuộc thanh trừng êm thấm.
Dialogue: 0,0:19:08.40,0:19:11.17,Default,,0000,0000,0000,,Còn về kẻ mang mầm bệnh đã toan ám sát Thủ tướng,
Dialogue: 0,0:19:11.17,0:19:13.80,Default,,0000,0000,0000,,chúng tôi tin rằng hắn có thể là một kẻ từng tới bán đảo\Nnhư một phần của Lực lượng Gìn giữ Hòa bình PKF.
Dialogue: 0,0:19:14.41,0:19:16.01,Default,,0000,0000,0000,,Tên hắn là\NKuze Hideo.
Dialogue: 0,0:19:16.01,0:19:19.05,Default,,0000,0000,0000,,Chúng tôi tìm ra đáp án này bằng cách truy ngược lại\Nqua các tác nhân lây nhiễm,
Dialogue: 0,0:19:19.05,0:19:20.91,Default,,0000,0000,0000,,nên khả năng cao hắn chính là\Nngười chúng ta cần tìm.
Dialogue: 0,0:19:21.48,0:19:23.71,Default,,0000,0000,0000,,Vậy ra là anh sao, Kuze?
Dialogue: 0,0:19:26.89,0:19:29.26,Default,,0000,0000,0000,,Về người đàn ông tên Gohda đó...
Dialogue: 0,0:19:29.26,0:19:31.43,Default,,0000,0000,0000,,Tôi đã hỏi những người từng làm việc cùng hắn\Ntại Cục Chính sách Quốc phòng,
Dialogue: 0,0:19:31.43,0:19:33.95,Default,,0000,0000,0000,,nhưng không có nhiều người\Nnhớ được về hắn.
Dialogue: 0,0:19:34.00,0:19:38.90,Default,,0000,0000,0000,,Ngay cả những người {\i1}có nhớ{\i0} cũng chỉ nhớ được rằng\Nhắn là một kẻ chẳng có gì để lại ấn tượng sâu đậm.
Dialogue: 0,0:19:45.47,0:19:49.31,Default,,0000,0000,0000,,Nhưng tôi {\i1}đã{\i0} tìm thấy hồ sơ kiểm tra phân tích tâm lý của hắn\Ntừ thời hắn còn làm việc ở đó.
Dialogue: 0,0:19:49.71,0:19:53.01,Default,,0000,0000,0000,,Hướng nội, nhưng có cái tôi bản ngã cực kỳ mạnh mẽ\Nvà thèm khát sự chú ý của công chúng.
Dialogue: 0,0:19:53.48,0:19:57.35,Default,,0000,0000,0000,,Ngược lại, hắn có xu hướng mượn người khác\Nlàm công cụ để thể hiện bản thân.
Dialogue: 0,0:19:57.99,0:20:00.98,Default,,0000,0000,0000,,Điều đó vẽ nên một bức tranh hoàn toàn khác\Nso với con người của hắn ngày nay.
Dialogue: 0,0:20:01.76,0:20:03.75,Default,,0000,0000,0000,,Có chuyện gì thế?\NAnh không ăn à?
Dialogue: 0,0:20:04.16,0:20:06.65,Default,,0000,0000,0000,,Mùi vị vẫn y hệt\Nnhư những ngày xưa cũ.
Dialogue: 0,0:20:06.93,0:20:09.02,Default,,0000,0000,0000,,Y hệt như những ngày xưa cũ,\Nhả?
Dialogue: 0,0:20:11.33,0:20:15.74,Default,,0000,0000,0000,,Và về viên sĩ quan Lục quân Phòng vệ tên Kawashima\Nmà khi nãy ông vừa hỏi tôi...
Dialogue: 0,0:20:16.21,0:20:18.80,Default,,0000,0000,0000,,Bên Đội An ninh Công cộng 1 cũng vừa có người\Nđến dò hỏi thông tin về anh ta.
Dialogue: 0,0:20:19.11,0:20:22.95,Default,,0000,0000,0000,,Họ đến gặp chúng tôi và xin dữ liệu khuôn mặt của anh ta\Nvì một tay sát thủ tên Vương Trọng Nhân...
Dialogue: 0,0:20:22.95,0:20:26.81,Default,,0000,0000,0000,,...đã chiếm đoạt khuôn mặt của Kawashima\Nvà đang ẩn náu tại Khu phố Tàu.
Dialogue: 0,0:20:27.05,0:20:28.98,Default,,0000,0000,0000,,Sao ông không nói cho tôi biết\Nđiều đó sớm hơn chứ?!
Dialogue: 0,0:20:30.12,0:20:32.52,Default,,0000,0000,0000,,Tôi cứ tưởng là bên họ đã liên lạc trao đổi\Nvới ông về việc đó rồi chứ.
Dialogue: 0,0:20:32.89,0:20:33.95,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}
Dialogue: 0,0:20:34.42,0:20:38.19,Default,,0000,0000,0000,,{\i1}Thật kỳ lạ khi Đội 1 cũng nhúng tay vào vụ này{\i0}\N{\i1}ngoài vụ án Báo Nanyou.{\i0}
Dialogue: 0,0:20:38.26,0:20:40.09,Default,,0000,0000,0000,,{\i1}Mau chóng báo tin cho Batou{\i0}\N{\i1}và những người khác ngay đi.{\i0}
Dialogue: 0,0:20:40.16,0:20:41.63,Default,,0000,0000,0000,,{\i1}Tôi đang liên lạc đây.{\i0}
Dialogue: 0,0:20:42.77,0:20:44.50,Default,,0000,0000,0000,,{\i1}Vương Trọng Nhân sao?{\i0}
Dialogue: 0,0:20:44.50,0:20:47.13,Default,,0000,0000,0000,,{\i1}Gã đó là một tên khủng bố quốc tế{\i0}\N{\i1}người Đài Loan.{\i0}
Dialogue: 0,0:20:47.57,0:20:49.64,Default,,0000,0000,0000,,{\i1}Cấp trên đã ban lệnh tiêu diệt trừ khử hắn,{\i0}
Dialogue: 0,0:20:49.64,0:20:51.70,Default,,0000,0000,0000,,{\i1}nhưng tôi chưa từng nghe thấy bất kỳ thông tin nào{\i0}\N{\i1}về việc hắn phẫu thuật đổi mặt cả.{\i0}
Dialogue: 0,0:20:51.91,0:20:55.64,Default,,0000,0000,0000,,{\i1}Vậy là chúng ta đang bị chơi xỏ,{\i0}\N{\i1}hay chính Đội 1 mới là kẻ bị dắt mũi?{\i0}
Dialogue: 0,0:20:55.84,0:20:58.07,Default,,0000,0000,0000,,{\i1}Dù thế nào đi nữa, thời điểm xảy ra chuyện này{\i0}\N{\i1}là quá sức đáng ngờ.{\i0}
Dialogue: 0,0:20:58.31,0:21:01.51,Default,,0000,0000,0000,,{\i1}Tachikoma! Để phòng ngừa rủi ro, hãy khống chế ngay đám người{\i0}\N{\i1}trên chiếc xe tải van khi nãy.{\i0}
Dialogue: 0,0:21:02.15,0:21:05.64,Default,,0000,0000,0000,,{\i1}Bác Batou ơi! Đối tượng vừa xuất hiện{\i0}\N{\i1}ở con hẻm phía sau nhà hàng kìa!{\i0}
Dialogue: 0,0:21:05.89,0:21:06.79,Default,,0000,0000,0000,,Cái... gì cơ?
Dialogue: 0,0:21:17.30,0:21:20.70,Default,,0000,0000,0000,,Đất nước này quá đỗi xa hoa\Nđể người tị nạn có thể sinh sống.
Dialogue: 0,0:21:21.30,0:21:24.67,Default,,0000,0000,0000,,Nhưng nó lại không đủ hào hiệp nhân từ\Nđể có thể dang tay tiếp nhận bất kỳ người tị nạn nào.
Dialogue: 0,0:21:29.35,0:21:31.14,Default,,0000,0000,0000,,Vương Trọng Nhân, tôi đoán không lầm chứ?
Dialogue: 0,0:21:35.78,0:21:36.85,Default,,0000,0000,0000,,Ghim chặt chân bọn chúng lại!
Dialogue: 0,0:21:36.85,0:21:37.84,Default,,0000,0000,0000,,Rõ!
Dialogue: 0,0:21:43.16,0:21:44.63,Default,,0000,0000,0000,,Bỏ súng xuống mau!
Dialogue: 0,0:21:46.03,0:21:47.09,Default,,0000,0000,0000,,Kawashima!
Dialogue: 0,0:21:51.70,0:21:52.90,Default,,0000,0000,0000,,Mấy người rốt cuộc\Nlà cái quái gì thế hả?
Dialogue: 0,0:21:52.90,0:21:54.13,Default,,0000,0000,0000,,Nằm rạp xuống đất mau!
Dialogue: 0,0:22:00.21,0:22:01.44,Default,,0000,0000,0000,,Tôi xin lỗi...
Dialogue: 0,0:22:01.98,0:22:04.91,Default,,0000,0000,0000,,Con hẻm quá chật hẹp khiến tôi không thể\Nlàm lá chắn che chở cho anh ta được.
Dialogue: 0,0:22:05.25,0:22:06.81,Default,,0000,0000,0000,,Các người chắc hẳn là\NĐội 1.
Dialogue: 0,0:22:06.92,0:22:08.11,Default,,0000,0000,0000,,Mấy người là ai?
Dialogue: 0,0:22:08.22,0:22:09.88,Default,,0000,0000,0000,,Bọn tôi cũng làm\Ncùng ngành với các người.
Dialogue: 0,0:22:10.19,0:22:11.68,Default,,0000,0000,0000,,Nhìn cho kỹ lại mặt của hắn ta\Nđi kìa.
Dialogue: 0,0:22:11.99,0:22:14.65,Default,,0000,0000,0000,,Hắn có lắp các bộ phận giả,\Nnhưng khuôn mặt này thì hoàn toàn là hàng nguyên bản.
Dialogue: 0,0:22:15.16,0:22:17.72,Default,,0000,0000,0000,,Nói cách khác,\Ngã này chẳng phải Vương Trọng Nhân nào cả.
Dialogue: 0,0:22:18.69,0:22:22.93,Default,,0000,0000,0000,,Chuyện này là thế nào? Thông tin tình báo\Nmà Đội 1 chúng tôi nhận được là hoàn toàn chuẩn xác cơ mà.
Dialogue: 0,0:22:24.77,0:22:26.23,Default,,0000,0000,0000,,Mấy người là thuộc hạ\Ncủa Motoko...
Dialogue: 0,0:22:26.64,0:22:31.44,Default,,0000,0000,0000,,Thế nghĩa là mấy người vừa bị chơi xỏ rồi.\NY hệt như bọn tôi vậy.
Dialogue: 0,0:22:31.44,0:22:33.44,Default,,0000,0000,0000,,
