Dialogue: 0,0:03:27.41,0:03:30.07,Default,,0000,0000,0000,,Cảm ơn ông rất nhiều vì đã đích thân tới đây,\NAramaki.
Dialogue: 0,0:03:31.38,0:03:33.04,Default,,0000,0000,0000,,Tôi cũng chẳng còn lựa chọn nào khác.
Dialogue: 0,0:03:33.38,0:03:39.22,Default,,0000,0000,0000,,Chính ông là người đã thúc ép Thủ tướng\Nphái tôi tới đây mà, Chủ tịch Tadokoro.
Dialogue: 0,0:03:39.79,0:03:41.95,Default,,0000,0000,0000,,Kìa kìa, việc gì mà ông phải\Ncăng thẳng thế chứ.
Dialogue: 0,0:03:42.19,0:03:44.35,Default,,0000,0000,0000,,Kể từ sau vụ trộm tiền điện tử\Nlần trước,
Dialogue: 0,0:03:44.69,0:03:48.56,Default,,0000,0000,0000,,tôi đã hoàn toàn mất niềm tin vào cảnh sát tỉnh\Ncũng như công ty an ninh của chính mình.
Dialogue: 0,0:03:49.00,0:03:52.19,Default,,0000,0000,0000,,Tôi xin phép đi thẳng vào vấn đề,\Nông muốn chúng tôi làm gì?
Dialogue: 0,0:03:52.53,0:03:56.44,Default,,0000,0000,0000,,Thì thực ra,\Nchuyện là về tên hacker đó.
Dialogue: 0,0:03:56.71,0:04:01.51,Default,,0000,0000,0000,,Hắn tên gì ấy nhỉ? Theo như tôi nhớ,\Nhình như là...
Dialogue: 0,0:04:01.88,0:04:04.40,Default,,0000,0000,0000,,Cash Eye.\NÝ ông là tên đó phải không?
Dialogue: 0,0:04:04.71,0:04:05.91,Default,,0000,0000,0000,,Đúng đúng, chính hắn.
Dialogue: 0,0:04:05.91,0:04:09.37,Default,,0000,0000,0000,,Hôm qua tôi vừa nhận được lá thư cảnh báo này\Ntừ hắn ta.
Dialogue: 0,0:04:10.12,0:04:15.11,Default,,0000,0000,0000,,Sau khi nhận được thư, tôi đã quyết định quy đổi\Ntoàn bộ tài sản của mình sang tiền mặt.
Dialogue: 0,0:04:15.89,0:04:18.26,Default,,0000,0000,0000,,Và đó là lý do vì sao\Ntoàn bộ cơ ngơi của tôi...
Dialogue: 0,0:04:18.26,0:04:21.59,Default,,0000,0000,0000,,...hiện đang được khóa chặt trong căn hầm ngầm\Ncủa tòa nhà này ngay lúc này.
Dialogue: 0,0:04:21.93,0:04:23.20,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:04:23.20,0:04:27.57,Default,,0000,0000,0000,,Xét theo một khía cạnh nào đó, đây có thể là biện pháp phòng thủ\Nan toàn nhất mà ông có thể áp dụng.
Dialogue: 0,0:04:27.94,0:04:29.71,Default,,0000,0000,0000,,Tôi cũng từng\Nnghĩ như vậy đấy.
Dialogue: 0,0:04:29.71,0:04:34.21,Default,,0000,0000,0000,,Nhưng tối qua, hắn đã điều khiển từ xa một robot nữ,\Nvà hắn...
Dialogue: 0,0:04:34.21,0:04:38.44,Default,,0000,0000,0000,,Ông xem này. Hắn để cô ả lẻn vào phòng này\Nnhư thể đi dạo chốn không người,
Dialogue: 0,0:04:38.75,0:04:42.21,Default,,0000,0000,0000,,cố tình phá hủy một camera an ninh\Nđể báo cho chúng tôi biết về vụ đột nhập,
Dialogue: 0,0:04:42.82,0:04:46.38,Default,,0000,0000,0000,,rồi tẩu thoát bằng cách nhảy thẳng ra ngoài\Ntừ cửa sổ tầng 50 này.
Dialogue: 0,0:04:47.69,0:04:51.39,Default,,0000,0000,0000,,\"Các biện pháp phòng thủ vật lý\Nkhông thể ngăn chặn được vụ trộm.\"
Dialogue: 0,0:04:51.79,0:04:54.06,Default,,0000,0000,0000,,Ông cho rằng đó là thông điệp mang tính thị uy\Nmà hắn muốn gửi gắm sao?
Dialogue: 0,0:04:54.36,0:04:55.92,Default,,0000,0000,0000,,Có vẻ là như vậy.
Dialogue: 0,0:04:56.33,0:05:01.70,Default,,0000,0000,0000,,Theo những gì tôi được nghe từ nãy đến giờ, vụ này\Nxem ra không thuộc phạm vi xử lý của chúng tôi.
Dialogue: 0,0:05:02.67,0:05:06.21,Default,,0000,0000,0000,,Lẽ ra ông nên liên hệ thẳng với cảnh sát tỉnh\Nngay từ đầu thì khôn ngoan hơn.
Dialogue: 0,0:05:06.21,0:05:09.91,Default,,0000,0000,0000,,Họ có quân số đông hơn nhiều so với một đơn vị\Nnhỏ tinh nhuệ như Đội 9.
Dialogue: 0,0:05:10.15,0:05:13.24,Default,,0000,0000,0000,,Chuyện đó là hoàn toàn không thể được,\Ntôi e là vậy.
Dialogue: 0,0:05:13.55,0:05:16.61,Default,,0000,0000,0000,,Vào thời điểm vụ trộm dự kiến diễn ra,\Ntức là tối mai,
Dialogue: 0,0:05:16.85,0:05:19.09,Default,,0000,0000,0000,,một bữa tiệc bí mật sẽ được tổ chức\Nvới sự tham dự...
Dialogue: 0,0:05:19.09,0:05:21.78,Default,,0000,0000,0000,,...của các nhân vật cộm cán đầu ngành\Ntrong giới tài chính và chính trị.
Dialogue: 0,0:05:23.36,0:05:30.09,Default,,0000,0000,0000,,Không, đây không phải bữa tiệc phi pháp, mà chỉ là buổi tụ họp\Ncủa những cá nhân có cùng sở thích tao nhã mà thôi.
Dialogue: 0,0:05:30.87,0:05:34.63,Default,,0000,0000,0000,,Đó không phải là nơi mà những kẻ thiếu văn hóa\Nđược phép đặt chân vào.
Dialogue: 0,0:05:34.97,0:05:36.64,Default,,0000,0000,0000,,Và do tính chất đặc thù\Ncủa bữa tiệc,
Dialogue: 0,0:05:36.64,0:05:39.77,Default,,0000,0000,0000,,việc đổi địa điểm hay hoãn lại\Nlà điều hoàn toàn bất khả thi.
Dialogue: 0,0:05:40.08,0:05:41.94,Default,,0000,0000,0000,,Ông hiểu cho tôi chứ,\Nđúng không?
Dialogue: 0,0:05:42.41,0:05:45.51,Default,,0000,0000,0000,,Các chính sách quốc gia đôi khi được định đoạt\Ntại những sự kiện như thế này đấy.
Dialogue: 0,0:05:46.21,0:05:49.31,Default,,0000,0000,0000,,Đó là lý do tôi cần một người\Nbiết thấu tình đạt lý như ông.
Dialogue: 0,0:05:50.05,0:05:53.45,Default,,0000,0000,0000,,Tôi sẽ để nhân viên công ty an ninh\Nlo liệu việc thắt chặt an ninh bên ngoài.
Dialogue: 0,0:05:54.36,0:05:58.66,Default,,0000,0000,0000,,Nhưng vấn đề thực sự nằm ở tính khí của kẻ\Nchịu trách nhiệm phụ trách địa điểm tổ chức tiệc.
Dialogue: 0,0:05:59.93,0:06:05.23,Default,,0000,0000,0000,,Tôi đã nhận lệnh từ cấp trên, nên xem ra\Ntôi không có quyền từ chối rồi.
Dialogue: 0,0:06:05.60,0:06:07.33,Default,,0000,0000,0000,,Đừng khách sáo thế chứ.
Dialogue: 0,0:06:07.54,0:06:12.13,Default,,0000,0000,0000,,Bây giờ thì tôi đã hiểu vì sao Thủ tướng\Nlại tiến cử cô cho tôi rồi.
Dialogue: 0,0:06:12.44,0:06:15.57,Default,,0000,0000,0000,,Đứng từ đây tôi gần như có thể ngửi thấy mùi\Ndòng máu trắng nhân tạo của cô ấy rồi đấy.
Dialogue: 0,0:06:15.98,0:06:18.45,Default,,0000,0000,0000,,Cô ấy không phải là android.
Dialogue: 0,0:06:18.75,0:06:20.22,Default,,0000,0000,0000,,Tôi xin lỗi.
Dialogue: 0,0:06:20.22,0:06:23.55,Default,,0000,0000,0000,,Nhưng những cơ thể giả toàn phần đa năng thế này\Nluôn thổi bùng ngọn lửa dục vọng của tôi...
Dialogue: 0,0:06:23.55,0:06:27.15,Default,,0000,0000,0000,,...dành cho những thân thể vô cơ\Nhệt như đối với android vậy.
Dialogue: 0,0:06:28.82,0:06:32.89,Default,,0000,0000,0000,,Thủ tướng Kayabuki chắc hẳn\Nphải ghét cay ghét đắng gã đó lắm nhỉ.
Dialogue: 0,0:06:33.26,0:06:36.03,Default,,0000,0000,0000,,Bất kể ấn tượng cá nhân của bà ấy\Nvề gã đàn ông đó ra sao,
Dialogue: 0,0:06:36.03,0:06:40.66,Default,,0000,0000,0000,,bà ấy làm vậy là để thúc đẩy những cải cách\Nvốn đang rơi vào bế tắc.
Dialogue: 0,0:06:41.17,0:06:43.83,Default,,0000,0000,0000,,Đó cũng là nước đi đúng đắn\Nđể quét sạch...
Dialogue: 0,0:06:43.91,0:06:45.70,Default,,0000,0000,0000,,...những bóng ma tàn dư cuối cùng\Ncủa chính quyền tiền nhiệm.
Dialogue: 0,0:06:46.48,0:06:49.27,Default,,0000,0000,0000,,\"Độc phụ lòng người\", nhỉ?
Dialogue: 0,0:06:49.74,0:06:53.54,Default,,0000,0000,0000,,Dù vậy tôi chẳng hào hứng gì khi bị ép\Nphải phục tùng cái trò này đâu.
Dialogue: 0,0:06:54.02,0:06:58.01,Default,,0000,0000,0000,,Công việc này tôi thấy chẳng đáng để mình\Nphải hy sinh cả kỳ nghỉ phép.
Dialogue: 0,0:06:58.49,0:07:03.45,Default,,0000,0000,0000,,Xin lỗi nhé. Nhưng ngày mai sẽ còn khối chuyện\Nlàm cậu gai mắt hơn nhiều đấy.
Dialogue: 0,0:07:04.43,0:07:06.59,Default,,0000,0000,0000,,Đừng nổi nóng mất bình tĩnh\Ntrước khi hoàn thành nhiệm vụ.
Dialogue: 0,0:07:27.62,0:07:28.91,Default,,0000,0000,0000,,{\i1}Mọi người thấy rõ cả chứ?{\i0}
Dialogue: 0,0:07:29.35,0:07:30.82,Default,,0000,0000,0000,,Rồi, tôi thấy rồi.
Dialogue: 0,0:07:31.05,0:07:34.75,Default,,0000,0000,0000,,Này, gã vừa nãy là giám đốc\Ncủa Hãng Khí cụ Cơ khí Chính xác Hanka đấy.
Dialogue: 0,0:07:35.36,0:07:39.16,Default,,0000,0000,0000,,Thế nhưng, cái ý nghĩ về một bữa tiệc nơi những kẻ tai to mặt lớn\Ntrong giới chính trị và tài chính...
Dialogue: 0,0:07:39.16,0:07:42.93,Default,,0000,0000,0000,,...khoe khoang những con búp bê tình dục mà họ giấu giếm vợ nhà\Nthực sự làm tôi mở mang tầm mắt đấy.
Dialogue: 0,0:07:46.40,0:07:50.34,Default,,0000,0000,0000,,Ối chà. Cựu Bộ trưởng Ngoại giao\Nđang tiến vào kìa.
Dialogue: 0,0:07:50.87,0:07:52.81,Default,,0000,0000,0000,,{\i1}Lão ta vẫn chưa học được{\i0}\N{\i1}bài học nhớ đời sao?{\i0}
Dialogue: 0,0:07:56.01,0:07:57.24,Default,,0000,0000,0000,,{\i1}Không thể tin nổi...{\i0}
Dialogue: 0,0:07:57.95,0:07:59.65,Default,,0000,0000,0000,,{\i1}Đúng là trò đồi bại.{\i0}
Dialogue: 0,0:07:59.65,0:08:03.05,Default,,0000,0000,0000,,{\i1}Này, xe chở Trưởng ban{\i0}\N{\i1}và Thiếu tá đang tiến vào kìa.{\i0}
Dialogue: 0,0:08:03.05,0:08:05.49,Default,,0000,0000,0000,,{\i1}Phen này chắc chắn sẽ là{\i0}\N{\i1}một màn chấn động đây.{\i0}
Dialogue: 0,0:08:19.57,0:08:21.23,Default,,0000,0000,0000,,Đúng là trò đồi bại...
Dialogue: 0,0:08:22.27,0:08:23.34,Default,,0000,0000,0000,,Này, nhìn kìa.
Dialogue: 0,0:08:23.34,0:08:26.34,Default,,0000,0000,0000,,Cậu có thấy ông già trông có vẻ tận hưởng bữa tiệc này\Nhơn mức cần thiết không?
Dialogue: 0,0:08:26.34,0:08:27.54,Default,,0000,0000,0000,,Tôi cũng nghĩ y như cậu.
Dialogue: 0,0:08:27.78,0:08:31.23,Default,,0000,0000,0000,,Thế nhưng, Thiếu tá dường như rất được đám dị hợm\Ndưới đó săn đón nhiệt tình đấy.
Dialogue: 0,0:08:32.91,0:08:34.92,Default,,0000,0000,0000,,Một gã trong số chúng vừa mới\Nsờ soạng cô ấy kìa!
Dialogue: 0,0:08:34.92,0:08:36.94,Default,,0000,0000,0000,,Tốt nhất là chúng ta\Nkhông nên biết thì hơn.
Dialogue: 0,0:08:37.59,0:08:39.85,Default,,0000,0000,0000,,Được rồi, việc lấy mật mã vào hầm ngầm\Ntừ Chủ tịch Tadokoro...
Dialogue: 0,0:08:39.85,0:08:42.98,Default,,0000,0000,0000,,...cứ để Thiếu tá lo liệu, còn chúng ta\Ncũng mau chuẩn bị sẵn sàng đi.
Dialogue: 0,0:08:43.19,0:08:44.32,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:08:44.53,0:08:48.02,Default,,0000,0000,0000,,Chắc cũng đến lúc chúng ta tham gia bữa tiệc\Nvà hòa nhập vào đám đông rồi nhỉ.
Dialogue: 0,0:08:48.96,0:08:51.30,Default,,0000,0000,0000,,{\i1}Tachikoma, bên các cậu{\i0}\N{\i1}đã sẵn sàng chưa?{\i0}
Dialogue: 0,0:08:51.50,0:08:53.13,Default,,0000,0000,0000,,Công tác chuẩn bị đã hoàn tất!
Dialogue: 0,0:08:53.50,0:08:55.37,Default,,0000,0000,0000,,Bên này cũng sẵn sàng rồi!
Dialogue: 0,0:08:55.74,0:08:58.30,Default,,0000,0000,0000,,{\i1}Được rồi, chờ tín hiệu{\i0}\N{\i1}từ Thiếu tá.{\i0}
Dialogue: 0,0:09:08.82,0:09:13.95,Default,,0000,0000,0000,,Một quyết định xuất sắc đấy, Aramaki.\NĐây là vỏ bọc ngụy trang hoàn hảo.
Dialogue: 0,0:09:14.32,0:09:19.42,Default,,0000,0000,0000,,Tôi đã bố trí những người khác vào các vị trí trên tầng\Nvới mệnh lệnh không được làm gián đoạn bữa tiệc.
Dialogue: 0,0:09:19.73,0:09:22.06,Default,,0000,0000,0000,,Chà, ông cứ nhìn mức độ cảnh giới\Ncủa chúng ta hiện tại mà xem.
Dialogue: 0,0:09:22.06,0:09:28.56,Default,,0000,0000,0000,,Cứ cho là tên trộm có xuống được tới căn hầm đi chăng nữa,\Ntôi nghi ngờ việc hắn có thể khuân hết đống tiền mặt đó ra ngoài đấy.
Dialogue: 0,0:09:28.80,0:09:31.03,Default,,0000,0000,0000,,Nhưng mà, chúng ta đã chứng kiến\Nkhả năng của hắn rồi.
Dialogue: 0,0:09:31.41,0:09:34.03,Default,,0000,0000,0000,,Bắt sống tên trộm,\Nbằng mọi giá.
Dialogue: 0,0:09:34.28,0:09:36.01,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:09:36.01,0:09:40.00,Default,,0000,0000,0000,,Hãy cứ hòa nhập vào bữa tiệc cho đến thời điểm\Nvụ trộm dự kiến diễn ra.
Dialogue: 0,0:09:40.42,0:09:44.98,Default,,0000,0000,0000,,Cô thấy sao, tiểu thư? Cô có muốn\Ntôi dẫn đi tham quan một vòng không?
Dialogue: 0,0:09:45.92,0:09:47.44,Default,,0000,0000,0000,,Tôi rất sẵn lòng.
Dialogue: 0,0:09:51.93,0:09:53.76,Default,,0000,0000,0000,,{\i1}Ishikawa,{\i0}\N{\i1}tình hình sao rồi?{\i0}
Dialogue: 0,0:09:54.53,0:09:56.52,Default,,0000,0000,0000,,{\i1}Bọn tôi vừa vấp phải{\i0}\N{\i1}một chút trở ngại.{\i0}
Dialogue: 0,0:09:56.70,0:09:59.80,Default,,0000,0000,0000,,{\i1}Có khả năng Tadokoro đã gia cố thêm trang thiết bị an ninh...{\i0}
Dialogue: 0,0:09:59.80,0:10:03.00,Default,,0000,0000,0000,,{\i1}...trong căn hầm ngầm của lão{\i0}\N{\i1}cách đây vài ngày.{\i0}
Dialogue: 0,0:10:03.17,0:10:05.11,Default,,0000,0000,0000,,{\i1}Tôi đã kiểm tra máy chủ{\i0}\N{\i1}của nhà sản xuất,{\i0}
Dialogue: 0,0:10:05.11,0:10:09.30,Default,,0000,0000,0000,,{\i1}nhưng sơ đồ của toàn bộ linh kiện mới lắp đặt{\i0}\N{\i1}đều đã bị xóa sạch dấu vết.{\i0}
Dialogue: 0,0:10:09.94,0:10:13.18,Default,,0000,0000,0000,,{\i1}Lão ta quản lý thông tin{\i0}\N{\i1}quá kỹ càng.{\i0}
Dialogue: 0,0:10:13.25,0:10:16.55,Default,,0000,0000,0000,,{\i1}Tôi ngờ rằng thậm chí chẳng còn lưu lại{\i0}\N{\i1}chút manh mối nào trên giấy tờ.{\i0}
Dialogue: 0,0:10:16.55,0:10:20.78,Default,,0000,0000,0000,,{\i1}Thiếu tá đã đi lấy mẫu võng mạc{\i0}\N{\i1}và sóng não điện tử của Tadokoro rồi.{\i0}
Dialogue: 0,0:10:20.96,0:10:26.79,Default,,0000,0000,0000,,{\i1}Dù cô ấy có lấy được đi nữa, nếu ta không thể{\i0}\N{\i1}mở được cánh cửa đó, thì mọi công sức đều đổ sông đổ bể.{\i0}
Dialogue: 0,0:10:27.70,0:10:30.60,Default,,0000,0000,0000,,{\i1}Tôi sẽ cố hết sức tìm cách khác{\i0}\N{\i1}để mở toang cánh cửa đó ra.{\i0}
Dialogue: 0,0:10:31.67,0:10:33.26,Default,,0000,0000,0000,,{\i1}Nhanh cái tay lên!{\i0}
Dialogue: 0,0:10:33.64,0:10:37.23,Default,,0000,0000,0000,,Cô có thể cười nhạo và gạt phăng chuyện này đi\Nnhư một sở thích quái đản,
Dialogue: 0,0:10:37.64,0:10:40.88,Default,,0000,0000,0000,,nhưng giữa những người đã nếm trải đủ\Nmọi thú vui trên đời như chúng tôi,
Dialogue: 0,0:10:40.88,0:10:45.74,Default,,0000,0000,0000,,thứ cuối cùng mà chúng tôi tìm đến\Nlại là niềm đam mê búp bê.
Dialogue: 0,0:10:46.25,0:10:52.31,Default,,0000,0000,0000,,Cô thấy thế nào? Mỗi con đều là hàng {\i1}thời trang cao cấp,{\i0}\Nđược các nhà thiết kế danh tiếng chế tác thủ công từ con số không.
Dialogue: 0,0:10:52.82,0:10:57.05,Default,,0000,0000,0000,,Cơ thể của chúng sở hữu những tính năng chẳng thua kém gì\Nso với cơ thể giả của chính cô đâu.
Dialogue: 0,0:10:57.36,0:11:01.19,Default,,0000,0000,0000,,Cô có hứng thú đổi vỏ sang một con trong số chúng\Nđể trải nghiệm thử không?
Dialogue: 0,0:11:01.43,0:11:03.06,Default,,0000,0000,0000,,{\i1}Thiếu tá, tình hình thế nào rồi?{\i0}
Dialogue: 0,0:11:03.83,0:11:06.30,Default,,0000,0000,0000,,Ông có nhận thức được rằng đây rõ ràng là một hành vi\Nquấy rối tình dục trắng trợn...
Dialogue: 0,0:11:06.80,0:11:11.64,Default,,0000,0000,0000,,Ồ, tôi xin lỗi.\NThói quen cũ khó bỏ quá.
Dialogue: 0,0:11:12.07,0:11:15.94,Default,,0000,0000,0000,,Dù vậy, ngay cả khi thân thể của cô thoạt nhìn\Nnhư một mẫu người máy đa dụng phổ thông,
Dialogue: 0,0:11:15.94,0:11:19.35,Default,,0000,0000,0000,,tôi dám cá rằng bên trong nó được tích hợp\Nđủ loại chi tiết tinh xảo độc nhất vô nhị.
Dialogue: 0,0:11:19.68,0:11:22.85,Default,,0000,0000,0000,,Độ nhạy cảm của da là bao nhiêu?\NMười sáu bình phương à?
Dialogue: 0,0:11:22.85,0:11:24.49,Default,,0000,0000,0000,,{\i1}Cứ ráng nhẫn nhịn một chút{\i0}\N{\i1}lúc này đi.{\i0}
Dialogue: 0,0:11:24.49,0:11:28.48,Default,,0000,0000,0000,,{\i1}Tôi không chịu nổi việc phải cảm nhận từng tí một,{\i0}\N{\i1}nên thường tắt các cơ quan cảm giác đi.{\i0}
Dialogue: 0,0:11:28.76,0:11:29.99,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi.{\i0}
Dialogue: 0,0:11:30.49,0:11:32.93,Default,,0000,0000,0000,,Cô thấy sao?\NSao không thử nghiệm một con xem?
Dialogue: 0,0:11:32.93,0:11:35.43,Default,,0000,0000,0000,,{\i1}Được rồi,{\i0}\N{\i1}bắt đầu chiến dịch.{\i0}
Dialogue: 0,0:11:35.43,0:11:36.66,Default,,0000,0000,0000,,Tôi biết ông\Nmuốn gì rồi.
Dialogue: 0,0:11:36.97,0:11:42.16,Default,,0000,0000,0000,,Không phải là ông muốn làm tình với thân thể tôi\Ntrong lúc nó đang trống rỗng vô hồn đấy chứ?
Dialogue: 0,0:11:43.41,0:11:48.43,Default,,0000,0000,0000,,Tôi thấy cô nắm bắt rất rõ thị hiếu\Ncủa những người đàn ông như tôi đấy...
Dialogue: 0,0:11:49.48,0:11:52.67,Default,,0000,0000,0000,,Liệu cô có hứng thú làm điều ngược lại,
Dialogue: 0,0:11:53.11,0:11:57.18,Default,,0000,0000,0000,,...và đối xử với một con người bằng xương bằng thịt\Nđang có ý thức hệt như một con rối không?
Dialogue: 0,0:12:03.66,0:12:09.60,Default,,0000,0000,0000,,Tôi sẽ giữ nguyên tư thế bất động hoàn toàn cho cô\Nvới toàn bộ giác quan cảm giác được bật mở tối đa.
Dialogue: 0,0:12:19.17,0:12:20.61,Default,,0000,0000,0000,,Rất tiếc về chuyện đó.
Dialogue: 0,0:12:21.01,0:12:24.24,Default,,0000,0000,0000,,Tôi không thể để ông tiếp tục cuộc vui rồi lăn đùng ra đột quỵ\Nngay trước mắt tôi được,
Dialogue: 0,0:12:24.68,0:12:27.24,Default,,0000,0000,0000,,nên hãy tiếp tục những gì còn dang dở\Ntrong giấc mơ của ông nhé.
Dialogue: 0,0:12:28.28,0:12:31.59,Default,,0000,0000,0000,,{\i1}Trưởng ban, tôi đã lấy được mẫu võng mạc{\i0}\N{\i1}và sóng não điện tử của lão ta rồi.{\i0}
Dialogue: 0,0:12:31.59,0:12:33.79,Default,,0000,0000,0000,,{\i1}Tốt.{\i0}\N{\i1}Chuyển sang giai đoạn hai.{\i0}
Dialogue: 0,0:12:33.79,0:12:35.31,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:12:47.94,0:12:50.14,Default,,0000,0000,0000,,{\i1}Batou, Togusa,{\i0}\N{\i1}tình hình thế nào rồi?{\i0}
Dialogue: 0,0:12:50.14,0:12:51.66,Default,,0000,0000,0000,,{\i1}Bọn tôi đang trên đường{\i0}\N{\i1}xuống hầm đây.{\i0}
Dialogue: 0,0:12:57.08,0:12:57.81,Default,,0000,0000,0000,,{\i1}Ishikawa!{\i0}
Dialogue: 0,0:12:57.81,0:12:59.30,Default,,0000,0000,0000,,{\i1}Tôi đang xử lý đây.{\i0}
Dialogue: 0,0:13:05.02,0:13:07.18,Default,,0000,0000,0000,,Này, khu vực này là...
Dialogue: 0,0:13:07.56,0:13:10.75,Default,,0000,0000,0000,,Đích thân ngài Tadokoro\Nphái chúng tôi xuống.
Dialogue: 0,0:13:20.87,0:13:24.00,Default,,0000,0000,0000,,{\i1}Đã tráo màn hình giám sát xong.{\i0}\N{\i1}Làm tốt lắm, Tachikoma.{\i0}
Dialogue: 0,0:13:24.31,0:13:26.00,Default,,0000,0000,0000,,{\i1}Chuyện nhỏ như con thỏ ạ!{\i0}
Dialogue: 0,0:13:26.44,0:13:28.10,Default,,0000,0000,0000,,Đứng yên tại chỗ đó.
Dialogue: 0,0:13:39.55,0:13:42.22,Default,,0000,0000,0000,,Được rồi, bây giờ chúng ta chỉ cần\Nchờ Thiếu tá đến thôi.
Dialogue: 0,0:13:42.52,0:13:44.19,Default,,0000,0000,0000,,{\i1}Tôi đã ở đây rồi.{\i0}
Dialogue: 0,0:13:47.06,0:13:48.26,Default,,0000,0000,0000,,Cô lấy được các mẫu mã khóa chưa?
Dialogue: 0,0:13:48.26,0:13:49.82,Default,,0000,0000,0000,,Tất nhiên rồi.
Dialogue: 0,0:14:02.21,0:14:06.11,Default,,0000,0000,0000,,Lẽ ra chúng ta nên lặn não Tadokoro\Nrồi lôi xềnh xệch lão xuống đây luôn cho rồi.
Dialogue: 0,0:14:06.48,0:14:11.28,Default,,0000,0000,0000,,Không được làm thế. Chúng ta còn có việc khác\Ncần lão ta phải làm.
Dialogue: 0,0:14:28.37,0:14:30.77,Default,,0000,0000,0000,,Không thể tắt cái hệ thống đó\Nđi được sao?
Dialogue: 0,0:14:30.77,0:14:33.61,Default,,0000,0000,0000,,{\i1}Không, nó vận hành{\i0}\N{\i1}hoàn toàn độc lập.{\i0}
Dialogue: 0,0:14:34.11,0:14:36.08,Default,,0000,0000,0000,,{\i1}Và nếu chúng ta manh động{\i0}\N{\i1}phá hủy nó,{\i0}
Dialogue: 0,0:14:36.14,0:14:38.41,Default,,0000,0000,0000,,{\i1}trung tâm điều khiển sẽ lập tức phát hiện ra{\i0}\N{\i1}có điều bất thường ngay.{\i0}
Dialogue: 0,0:14:38.41,0:14:40.57,Default,,0000,0000,0000,,{\i1}Đó không phải là\N{\i1}vấn đề nghiêm trọng nhất.{\i0}
Dialogue: 0,0:14:40.72,0:14:43.78,Default,,0000,0000,0000,,{\i1}Câu hỏi lúc này là liệu chúng ta có thể{\i0}\N{\i1}mở được cánh cửa hầm hay không.{\i0}
Dialogue: 0,0:14:43.99,0:14:45.68,Default,,0000,0000,0000,,{\i1}Tôi đã đào bới ra được{\i0}\N{\i1}vài thông tin rồi đây.{\i0}
Dialogue: 0,0:14:45.99,0:14:50.79,Default,,0000,0000,0000,,{\i1}Dựa trên lượng tiền mặt khổng lồ được chuyển vào{\i0}\N{\i1}tòa nhà Tadokoro, tôi cho rằng...{\i0}
Dialogue: 0,0:14:51.13,0:14:55.96,Default,,0000,0000,0000,,{\i1}...đó có thể là một mẫu khóa cơ học cố tình sử dụng{\i0}\N{\i1}bốn lớp khóa kiểu cổ điển lồng vào nhau.{\i0}
Dialogue: 0,0:14:56.26,0:14:58.97,Default,,0000,0000,0000,,{\i1}Thấy chưa? Như tôi đã nói, lẽ ra ta{\i0}\N{\i1}phải lôi lão Tadokoro theo mới phải.{\i0}
Dialogue: 0,0:14:58.97,0:15:00.76,Default,,0000,0000,0000,,{\i1}Giờ có nói chuyện đó{\i0}\N{\i1}thì cũng đã quá muộn rồi.{\i0}
Dialogue: 0,0:15:01.14,0:15:03.47,Default,,0000,0000,0000,,{\i1}Ishikawa, triển khai phương án{\i0}\N{\i1}Mật mã B thì sao?{\i0}
Dialogue: 0,0:15:03.47,0:15:04.97,Default,,0000,0000,0000,,{\i1}Ừ, cách đó có thể hiệu quả đấy.{\i0}
Dialogue: 0,0:15:04.97,0:15:09.51,Default,,0000,0000,0000,,{\i1}Cậu có thể thổi bay các thanh giằng của cửa hầm{\i0}\N{\i1}bằng số thuốc nổ mà chúng tôi đang chuẩn bị.{\i0}
Dialogue: 0,0:15:09.51,0:15:12.00,Default,,0000,0000,0000,,{\i1}Nhưng ngay khoảnh khắc kích nổ,{\i0}\N{\i1}chúng sẽ lập tức nhận được cảnh báo đột nhập.{\i0}
Dialogue: 0,0:15:12.35,0:15:14.01,Default,,0000,0000,0000,,{\i1}Chuyện đó thì đành chịu thôi.{\i0}
Dialogue: 0,0:15:15.38,0:15:19.39,Default,,0000,0000,0000,,{\i1}Vấn đề còn lại là, ngay cả khi ta nổ tung cửa{\i0}\N{\i1}và đột nhập được vào bên trong căn hầm,{\i0}
Dialogue: 0,0:15:19.39,0:15:23.16,Default,,0000,0000,0000,,{\i1}chúng ta vẫn không biết lão ta đã cài cắm{\i0}\N{\i1}những cạm bẫy bất ngờ gì bên trong.{\i0}
Dialogue: 0,0:15:23.16,0:15:25.68,Default,,0000,0000,0000,,{\i1}Không có gì đảm bảo là nó sẽ không có{\i0}\N{\i1}lớp phòng thủ kép thứ hai.{\i0}
Dialogue: 0,0:15:26.29,0:15:28.69,Default,,0000,0000,0000,,{\i1}Người xưa có câu: Không vào hang cọp,{\i0}\N{\i1}sao bắt được cọp con.{\i0}
Dialogue: 0,0:15:29.00,0:15:32.87,Default,,0000,0000,0000,,{\i1}Trộm tiền đâu phải là mục tiêu của chúng ta,{\i0}\N{\i1}nên chuyện đó không thành vấn đề.{\i0}
Dialogue: 0,0:15:33.33,0:15:35.60,Default,,0000,0000,0000,,Được rồi, vậy chốt theo\NPhương án B nhé.
Dialogue: 0,0:15:36.24,0:15:38.90,Default,,0000,0000,0000,,Nhưng từ đoạn này trở đi\Ncô phải tự thân vận động đấy.
Dialogue: 0,0:15:39.77,0:15:40.87,Default,,0000,0000,0000,,Cẩn thận đấy.
Dialogue: 0,0:15:41.38,0:15:43.31,Default,,0000,0000,0000,,Cảm ơn vì đã\Nnhắc nhở.
Dialogue: 0,0:15:43.61,0:15:46.24,Default,,0000,0000,0000,,Được rồi, tôi sẽ quay lại sớm thôi.
Dialogue: 0,0:15:56.39,0:15:58.38,Default,,0000,0000,0000,,Chúng ta cần chuẩn bị sẵn sàng\Ncho giai đoạn tiếp theo.
Dialogue: 0,0:16:03.87,0:16:05.86,Default,,0000,0000,0000,,Hóa ra là ông\Nở đây sao.
Dialogue: 0,0:16:06.53,0:16:08.23,Default,,0000,0000,0000,,Aramaki?
Dialogue: 0,0:16:09.54,0:16:12.87,Default,,0000,0000,0000,,Đã muộn thế này rồi cơ à?\NBữa tiệc sao rồi?
Dialogue: 0,0:16:13.17,0:16:17.61,Default,,0000,0000,0000,,Vẫn đang diễn ra tưng bừng.\NSắp tới giờ hẹn của vụ trộm rồi đấy.
Dialogue: 0,0:16:17.88,0:16:21.68,Default,,0000,0000,0000,,Đúng vậy. Tôi chỉ có thể\Ncầu nguyện không có chuyện gì xảy ra.
Dialogue: 0,0:16:23.48,0:16:27.65,Default,,0000,0000,0000,,Thưa Trưởng ban, xin mời ông tới phòng điều khiển gấp.\NCó vẻ như tên trộm đã lẻn vào trong rồi.
Dialogue: 0,0:16:27.99,0:16:29.42,Default,,0000,0000,0000,,Hắn làm cái {\i1}gì cơ?!{\i0}
Dialogue: 0,0:16:31.36,0:16:33.66,Default,,0000,0000,0000,,Đã đến giờ rồi sao?
Dialogue: 0,0:16:33.66,0:16:35.66,Default,,0000,0000,0000,,{\i1}Tachikoma!{\i0}\N{\i1}Tình hình bên đó thế nào rồi?{\i0}
Dialogue: 0,0:16:35.66,0:16:38.60,Default,,0000,0000,0000,,Sẵn sàng chờ lệnh ạ!\NChỉ cần bác ra lệnh thôi!
Dialogue: 0,0:17:00.32,0:17:02.99,Default,,0000,0000,0000,,Chúng ta đã chuyển sang\Nmáy phát điện nội bộ...
Dialogue: 0,0:17:02.99,0:17:04.51,Default,,0000,0000,0000,,Mau lên nào.
Dialogue: 0,0:17:05.43,0:17:08.09,Default,,0000,0000,0000,,Thưa quý vị,\Nxin đừng hoảng loạn!
Dialogue: 0,0:17:08.53,0:17:12.83,Default,,0000,0000,0000,,Tuy nhiên, do tính chất đặc biệt của bữa tiệc,\Nchúng ta tuyệt đối không thể để xảy ra sơ suất nào,
Dialogue: 0,0:17:13.13,0:17:16.59,Default,,0000,0000,0000,,vì vậy xin quý vị hãy nghe theo hướng dẫn của chúng tôi\Nvà sơ tán khỏi tòa nhà ngay lập tức.
Dialogue: 0,0:17:17.07,0:17:18.47,Default,,0000,0000,0000,,Ngài xem này, thưa Chủ tịch.
Dialogue: 0,0:17:24.48,0:17:26.28,Default,,0000,0000,0000,,Đó chính là con android\Nhôm qua!
Dialogue: 0,0:17:27.05,0:17:28.71,Default,,0000,0000,0000,,Làm thế nào mà ả có thể mò mẫm\Nxuống tận dưới đó được chứ?
Dialogue: 0,0:17:29.02,0:17:31.48,Default,,0000,0000,0000,,Tôi sẽ phái người xuống đó\Nngay lập tức.
Dialogue: 0,0:17:31.89,0:17:33.01,Default,,0000,0000,0000,,Không, khoan đã.
Dialogue: 0,0:17:33.32,0:17:38.92,Default,,0000,0000,0000,,Trông như ả đang cố đột nhập vào hầm ngầm,\Nnhưng ả chẳng khác nào con chuột sa bẫy cả.
Dialogue: 0,0:17:40.73,0:17:42.56,Default,,0000,0000,0000,,Ý ngài là sao, thưa Chủ tịch?
Dialogue: 0,0:17:42.56,0:17:48.50,Default,,0000,0000,0000,,Nếu có bất cứ ai ngoài tôi bước vào căn hầm đó,\Nhệ thống cửa an ninh thứ hai sẽ sập xuống ngay lập tức.
Dialogue: 0,0:17:48.50,0:17:53.03,Default,,0000,0000,0000,,Và chúng được thiết kế để không bao giờ mở ra nữa\Nnếu không có chìa khóa Ghost của tôi.
Dialogue: 0,0:17:54.98,0:17:56.44,Default,,0000,0000,0000,,Chìa khóa Ghost sao?
Dialogue: 0,0:17:57.45,0:18:02.35,Default,,0000,0000,0000,,Dù sao thì các người cũng nên đi tìm tên hacker\Nđang điều khiển con android đó từ xa đi!
Dialogue: 0,0:18:02.98,0:18:04.78,Default,,0000,0000,0000,,{\i1}Hắn{\i0} mới là kẻ\Nmà các người cần phải bắt.
Dialogue: 0,0:18:05.52,0:18:11.15,Default,,0000,0000,0000,,Thưa Trưởng ban, xem ra đó là một AI tự hành,\Nhoặc là một kẻ sở hữu cơ thể nhân tạo toàn phần.
Dialogue: 0,0:18:11.46,0:18:14.52,Default,,0000,0000,0000,,Chúng tôi không bắt được bất kỳ dấu vết nào\Ncủa tín hiệu điều khiển từ xa cả.
Dialogue: 0,0:18:15.20,0:18:19.17,Default,,0000,0000,0000,,Nghĩa là đây chính là\Ntên hacker thật sự...
Dialogue: 0,0:18:19.17,0:18:23.33,Default,,0000,0000,0000,,Vâng thưa ngài. Và chúng ta cũng vừa nhận được\Ntờ giấy cảnh báo thứ hai này.
Dialogue: 0,0:18:29.78,0:18:33.21,Default,,0000,0000,0000,,Aramaki, đi cùng tôi\Nxuống căn hầm...
Dialogue: 0,0:18:33.71,0:18:36.81,Default,,0000,0000,0000,,...và làm chứng rằng cái chết của ả là kết quả\Ncủa hành động phòng vệ chính đáng.
Dialogue: 0,0:18:41.12,0:18:45.99,Default,,0000,0000,0000,,Căn hầm tự niêm phong, rồi tạo ra môi trường\Ngần như chân không trong một khoảng thời gian quy định.
Dialogue: 0,0:18:46.29,0:18:50.39,Default,,0000,0000,0000,,Dù có là cyborg hay không, kẻ đó cũng đừng hòng\Nsống sót nổi qua {\i1}cái bẫy đó{\i0}.
Dialogue: 0,0:18:52.27,0:18:54.06,Default,,0000,0000,0000,,Mấy người còn đứng trơ mắt ếch ra đấy\Nlàm cái gì nữa hả?!
Dialogue: 0,0:19:04.78,0:19:06.97,Default,,0000,0000,0000,,{\i1}Trưởng ban, Thiếu tá...{\i0}
Dialogue: 0,0:19:46.02,0:19:48.51,Default,,0000,0000,0000,,Có chuyện gì thế?\NĐã tìm thấy xác ả chưa?!
Dialogue: 0,0:19:49.42,0:19:51.36,Default,,0000,0000,0000,,Không thấy bất kỳ dấu vết nào\Ncủa ả cả.
Dialogue: 0,0:19:51.36,0:19:54.76,Default,,0000,0000,0000,,Không thể nào!\NLục soát khắp mọi ngóc ngách cho ta!
Dialogue: 0,0:19:59.43,0:20:01.42,Default,,0000,0000,0000,,Thành thật xin lỗi vì tôi tới muộn.
Dialogue: 0,0:20:02.14,0:20:05.44,Default,,0000,0000,0000,,Chỉ tại Chủ tịch Tadokoro\Nquá đỗi tuyệt vời...
Dialogue: 0,0:20:06.01,0:20:06.57,Default,,0000,0000,0000,,Ơ, tôi...
Dialogue: 0,0:20:06.57,0:20:08.51,Default,,0000,0000,0000,,{\i1}Thiếu tá? Làm thế nào mà cô...{\i0}
Dialogue: 0,0:20:08.94,0:20:13.88,Default,,0000,0000,0000,,{\i1}Hình ảnh các người nhìn thấy tôi đi vào khi nãy,{\i0}\N{\i1}chỉ là ảnh ảo do Tachikoma tạo ra mà thôi.{\i0}
Dialogue: 0,0:20:14.25,0:20:15.30,Default,,0000,0000,0000,,Tuyệt đỉnh cú mèo!
Dialogue: 0,0:20:16.42,0:20:18.41,Default,,0000,0000,0000,,Nhân tiện đây,\Nthưa Chủ tịch Tadokoro...
Dialogue: 0,0:20:19.65,0:20:24.22,Default,,0000,0000,0000,,Những cọc tiền mặt này\Nđược cất giữ trong hầm của ông,
Dialogue: 0,0:20:24.49,0:20:28.02,Default,,0000,0000,0000,,vậy chúng tôi có thể hiểu rằng toàn bộ số tiền này\Nđều thuộc quyền sở hữu của ông, đúng chứ?
Dialogue: 0,0:20:28.50,0:20:31.76,Default,,0000,0000,0000,,Dĩ nhiên là thế rồi.\NÝ cô ám chỉ điều gì hả?
Dialogue: 0,0:20:33.03,0:20:34.40,Default,,0000,0000,0000,,Kiểm tra chúng đi.
Dialogue: 0,0:20:35.40,0:20:36.93,Default,,0000,0000,0000,,Các người đang làm cái trò gì thế?
Dialogue: 0,0:20:37.24,0:20:40.61,Default,,0000,0000,0000,,Các người phải đi tìm xác tên trộm đó,\Nchứ không phải lãng phí thời gian vào việc này!
Dialogue: 0,0:20:41.11,0:20:47.54,Default,,0000,0000,0000,,Chủ tịch Tadokoro, mục tiêu thực sự của chúng tôi là khiến ông\Nphải đích thân mở cánh cửa căn hầm này ra...
Dialogue: 0,0:20:48.12,0:20:52.42,Default,,0000,0000,0000,,...và đối chiếu dãy số sê-ri\Ntrên những tờ tiền bên trong.
Dialogue: 0,0:20:53.69,0:20:56.46,Default,,0000,0000,0000,,Sau khi nhận được thông tin mật báo rằng ông\Nđang quản lý...
Dialogue: 0,0:20:56.46,0:20:59.36,Default,,0000,0000,0000,,...khối tài sản ngầm phi pháp của cựu Tổng Thư ký Đảng\NYakushima,
Dialogue: 0,0:20:59.66,0:21:02.36,Default,,0000,0000,0000,,chúng tôi đã tiến hành một cuộc điều tra nội bộ\Nđể xác minh xem điều đó có đúng hay không.
Dialogue: 0,0:21:02.96,0:21:04.12,Default,,0000,0000,0000,,Thiếu tá?
Dialogue: 0,0:21:04.80,0:21:07.73,Default,,0000,0000,0000,,Đúng là các dãy số sê-ri mà bên Cục Thuế\Nđã cung cấp cho chúng ta rồi.
Dialogue: 0,0:21:08.40,0:21:11.39,Default,,0000,0000,0000,,Chuyện này e là không thể dễ dàng\Ngiải thích qua loa được đâu nhỉ?
Dialogue: 0,0:21:11.71,0:21:15.24,Default,,0000,0000,0000,,Có rất nhiều điều mà chúng tôi\Nmuốn mời ông về làm rõ.
Dialogue: 0,0:21:15.24,0:21:17.51,Default,,0000,0000,0000,,Phiền ông đi cùng chúng tôi\Nmột chuyến được chứ?
Dialogue: 0,0:21:21.65,0:21:25.11,GitS List,,0000,0000,0000,,{\frx0\fry4\pos(702,733)\frz4.119}Chúng tôi đến để tiến hành điều tra ông.
Dialogue: 0,0:21:21.65,0:21:25.11,GitS List,,0000,0000,0000,,{\frx0\fry356\frz35.079\pos(1364,467)}Cục Thuế Quốc gia\N\N\NPhòng Điều tra Hình sự
Dialogue: 0,0:21:26.35,0:21:27.79,Default,,0000,0000,0000,,Làm ơn khẩn trương lên cho.
Dialogue: 0,0:21:30.42,0:21:31.69,Default,,0000,0000,0000,,{\i1}Bên các cậu tình hình{\i0}\N{\i1}thế nào rồi?{\i0}
Dialogue: 0,0:21:31.69,0:21:33.79,Default,,0000,0000,0000,,{\i1}Chúng tôi đang thả cho bọn chúng đi.{\i0}
Dialogue: 0,0:21:34.13,0:21:35.60,Default,,0000,0000,0000,,{\i1}Nếu ta lần theo manh mối{\i0}\N{\i1}từ những kẻ này,{\i0}
Dialogue: 0,0:21:35.60,0:21:39.90,Default,,0000,0000,0000,,{\i1}rất có thể sẽ khui ra được thêm nhiều kẻ{\i0}\N{\i1}chống lưng tài chính bí mật hơn nữa.{\i0}
Dialogue: 0,0:21:49.34,0:21:51.94,Default,,0000,0000,0000,,Mấy người này có phải là những kẻ\Nmà người ta hay gọi là \"biến thái\" không?
Dialogue: 0,0:21:52.51,0:21:55.54,Default,,0000,0000,0000,,Có lẽ em nên gọi họ là những kẻ\N\"lập dị\" thì đúng hơn đấy.
Dialogue: 0,0:22:04.66,0:22:07.63,Default,,0000,0000,0000,,{\i1}Tsutomu Tadokoro, cựu Chủ tịch Liên đoàn{\i0}\N{\i1}các Tổ chức Kinh tế...{\i0}
Dialogue: 0,0:22:07.63,0:22:09.83,Default,,0000,0000,0000,,{\i1}...kẻ được cho là có đường dây ngầm béo bở{\i0}\N{\i1}kết nối chặt chẽ với giới chính trị,{\i0}
Dialogue: 0,0:22:09.83,0:22:13.57,Default,,0000,0000,0000,,{\i1}vừa bị bắt giữ vì tình nghi trốn thuế quy mô lớn{\i0}\N{\i1}và rửa tiền bất hợp pháp.{\i0}
Dialogue: 0,0:22:13.57,0:22:17.26,Default,,0000,0000,0000,,Nghĩ lại thì, thỉnh thoảng đóng vai siêu trộm lẻn vào hầm ngầm\Ncũng khá là vui đấy chứ...
Dialogue: 0,0:22:18.21,0:22:21.61,Default,,0000,0000,0000,,Dù vậy, khi nãy cô cũng làm tôi thót tim\Nmột phen đấy.
Dialogue: 0,0:22:23.84,0:22:26.90,Default,,0000,0000,0000,,Tôi cứ tưởng cô bị hút chân không đóng gói thành túi\Ntrong đó luôn rồi chứ, Thiếu tá.
Dialogue: 0,0:22:27.88,0:22:31.48,Default,,0000,0000,0000,,Làm việc nhóm là phải báo trước cho đồng đội\Nbiết mình định làm gì chứ, cô biết không?
Dialogue: 0,0:22:31.62,0:22:36.32,Default,,0000,0000,0000,,Kìa kìa. Một khi đã bước chân vào nghề trộm cắp,\Nthì lừa dối đánh lạc hướng luôn là quy tắc số một mà.
Dialogue: 0,0:22:41.50,0:22:44.06,Default,,0000,0000,0000,,Mấy người còn định tiếp tục cái trò hề siêu trộm ngớ ngẩn này\Nđến bao giờ nữa hả?!
Dialogue: 0,0:22:44.47,0:22:46.83,Default,,0000,0000,0000,,Công việc đang chất đống như núi kia kìa,\Nmọi người!
Dialogue: 0,0:22:48.27,0:22:51.36,Default,,0000,0000,0000,,Có khi mình thực sự {\i1}nên{\i0} cân nhắc\Nchuyển hướng sang một nghề mới xem sao...
Dialogue: 0,0:22:51.37,0:22:53.37,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:55.66,0:24:01.47,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:01.47,0:24:04.17,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:04.17,0:24:08.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:24:08.11,0:24:10.62,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:24:10.62,0:24:14.15,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:24:14.15,0:24:17.49,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:24:17.49,0:24:22.29,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:24:22.29,0:24:26.95,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,2000)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...


