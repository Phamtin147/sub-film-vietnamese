Dialogue: 0,0:02:19.37,0:02:21.33,Default,,0000,0000,0000,,Chúng tôi đang đưa tin từ trên cao\Nngay phía trên Tháp Phát thanh Kyushu.
Dialogue: 0,0:02:21.57,0:02:24.54,Default,,0000,0000,0000,,Chiến dịch sơ tán quy mô lớn\Nđã bắt đầu từ năm ngày trước...
Dialogue: 0,0:02:24.54,0:02:27.47,Default,,0000,0000,0000,,...với việc phát hiện một quả bom chưa nổ\Nđược cài tại công trường xây dựng tàu điện ngầm...
Dialogue: 0,0:02:27.47,0:02:30.81,Default,,0000,0000,0000,,...bị nghi ngờ là một thiết bị hạt nhân chiến thuật\Ntừng được sử dụng trong Thế chiến III.
Dialogue: 0,0:02:31.31,0:02:34.61,Default,,0000,0000,0000,,Việc sơ tán 35 triệu người dân\Ntrong bán kính 30 km...
Dialogue: 0,0:02:34.95,0:02:39.18,Default,,0000,0000,0000,,...cuối cùng đã hoàn tất\Ndưới sự chỉ đạo của Quân Phòng vệ.
Dialogue: 0,0:02:39.65,0:02:44.21,Default,,0000,0000,0000,,Tuy nhiên, vài bên đang suy đoán rằng\Nđây có thể lại là một vụ khủng bố của người tị nạn,
Dialogue: 0,0:02:44.62,0:02:47.06,Default,,0000,0000,0000,,và do không có thông báo cụ thể nào\Ntừ phía chính phủ...
Dialogue: 0,0:02:47.16,0:02:49.99,Default,,0000,0000,0000,,...cùng với việc một phần Fukuoka\Nbị Quân Phòng vệ phong tỏa,
Dialogue: 0,0:02:50.33,0:02:53.82,Default,,0000,0000,0000,,thành phố trông gần như thể\Nđã bị đặt dưới thiết quân luật!
Dialogue: 0,0:03:03.38,0:03:06.35,GitS Signs B/W,,0000,0000,0000,,{\pos(1105,624)}Cấm làn xe vào\N\N\N\N\N\N\N\N{\fs65}do xử lý vật liệu nổ
Dialogue: 0,0:03:12.75,0:03:14.19,Default,,0000,0000,0000,,Thiết quân luật hả?
Dialogue: 0,0:03:16.82,0:03:19.52,Default,,0000,0000,0000,,Tôi sẽ là người đầu tiên thừa nhận có vấn đề\Ntrong cách phản ứng của chính phủ lần này,
Dialogue: 0,0:03:19.89,0:03:22.38,Default,,0000,0000,0000,,nhưng quyền lực của họ\Nđâu đã bị giao cho quân đội.
Dialogue: 0,0:03:22.66,0:03:23.96,Default,,0000,0000,0000,,Anh nói đúng.
Dialogue: 0,0:03:24.06,0:03:27.56,Default,,0000,0000,0000,,Thực tế là con tàu Kuze đi\Nđã chìm ngoài khơi Dejima,
Dialogue: 0,0:03:27.87,0:03:31.17,Default,,0000,0000,0000,,ta vẫn chưa rõ liệu có plutonium\Ntrên tàu hay không.
Dialogue: 0,0:03:31.57,0:03:35.23,Default,,0000,0000,0000,,Cũng chưa chắc liệu có thực sự là đám tị nạn\Nđã gây ra vụ mất điện diện rộng đó không...
Dialogue: 0,0:03:35.58,0:03:38.77,Default,,0000,0000,0000,,...vốn có vẻ được căn đúng thời điểm\Nđể giúp con tàu ngụy trang tẩu thoát.
Dialogue: 0,0:03:40.41,0:03:43.68,Default,,0000,0000,0000,,Người dân đang trút cơn thịnh nộ về người tị nạn\Nlên đầu chính phủ,
Dialogue: 0,0:03:44.32,0:03:47.41,Default,,0000,0000,0000,,và sự ủng hộ việc trục xuất người tị nạn\Ntrong nội bộ chính phủ đang ngày càng mạnh lên.
Dialogue: 0,0:03:48.32,0:03:53.22,Default,,0000,0000,0000,,Mà chẳng ai mảy may suy nghĩ\Nđiều đó sẽ mang lại hậu quả gì cho đất nước.
Dialogue: 0,0:03:53.96,0:03:57.16,Default,,0000,0000,0000,,Dù tất cả chuyện này là kết quả của việc thao túng thông tin\Nbởi Cục Tình báo Nội các,
Dialogue: 0,0:03:57.50,0:04:00.16,Default,,0000,0000,0000,,thì những thông tin sai lệch mà chúng lan truyền\Ncũng sẽ không tự nhiên biến mất.
Dialogue: 0,0:04:01.40,0:04:02.49,Default,,0000,0000,0000,,{\i1}Batou.{\i0}
Dialogue: 0,0:04:02.94,0:04:05.03,Default,,0000,0000,0000,,{\i1}Có chuyện gì xảy ra với{\i0}\N{\i1}Thiếu tá thế?{\i0}
Dialogue: 0,0:04:05.14,0:04:07.16,Default,,0000,0000,0000,,{\i1}Trong báo cáo tôi đã viết rằng cô ấy{\i0}\N{\i1}cứ hành xử kỳ lạ...{\i0}
Dialogue: 0,0:04:07.27,0:04:09.90,Default,,0000,0000,0000,,{\i1}...kể từ khi lặn vào não điện tử của Kuze{\i0}\N{\i1}ở Dejima rồi, đúng không?{\i0}
Dialogue: 0,0:04:10.51,0:04:12.84,Default,,0000,0000,0000,,{\i1}Trước mắt, hãy tập trung vào việc{\i0}\N{\i1}xử lý quả bom hạt nhân đó đi.{\i0}
Dialogue: 0,0:04:13.21,0:04:17.84,Default,,0000,0000,0000,,{\i1}CIS đã bắt đầu nắm quyền kiểm soát hiện trường{\i0}\N{\i1}dưới danh nghĩa kiểm soát truyền thông rồi.{\i0}
Dialogue: 0,0:04:18.42,0:04:22.85,Default,,0000,0000,0000,,{\i1}Tôi sẽ đàm phán với Thủ tướng{\i0}\N{\i1}để xin thẩm quyền điều tra CIS.{\i0}
Dialogue: 0,0:04:23.96,0:04:25.86,Default,,0000,0000,0000,,{\i1}Chỉ với mớ{\i0}\N{\i1}chứng cứ gián tiếp đó thôi ư?{\i0}
Dialogue: 0,0:04:27.86,0:04:30.16,Default,,0000,0000,0000,,{\i1}Thủ tướng lúc này đã ngập đầu{\i0}\N{\i1}trong mớ bòng bong rồi,{\i0}
Dialogue: 0,0:04:30.26,0:04:33.36,Default,,0000,0000,0000,,{\i1}nhất là với toàn bộ tình hình{\i0}\N{\i1}\"Quân Phòng vệ tiến đánh Dejima\".{\i0}
Dialogue: 0,0:04:34.90,0:04:38.34,Default,,0000,0000,0000,,{\i1}Lúc này, tôi không nghĩ bà ấy{\i0}\N{\i1}sẽ đồng ý một đề xuất...{\i0}
Dialogue: 0,0:04:38.81,0:04:40.86,Default,,0000,0000,0000,,{\i1}...có thể dẫn tới{\i0}\N{\i1}một vụ bê bối quốc gia đâu.{\i0}
Dialogue: 0,0:04:42.38,0:04:47.01,Default,,0000,0000,0000,,{\i1}Nếu ta không đi đúng nước cờ, Đội 9{\i0}\N{\i1}lại phải đứng mũi chịu sào nữa cho xem.{\i0}
Dialogue: 0,0:04:47.78,0:04:50.77,Default,,0000,0000,0000,,{\i1}Chính vì thế tôi mới xin phê duyệt{\i0}\N{\i1}cho chúng ta tham gia vào hiện trường.{\i0}
Dialogue: 0,0:04:51.58,0:04:53.21,Default,,0000,0000,0000,,{\i1}Hãy tìm ra thứ gì đó{\i0}\N{\i1}ở đằng đó đi.{\i0}
Dialogue: 0,0:04:58.62,0:05:03.12,Default,,0000,0000,0000,,Này Thiếu tá... Sau tất cả những chuyện này,\Ncô nghĩ tại sao đám tị nạn lại im hơi lặng tiếng?
Dialogue: 0,0:05:03.80,0:05:06.79,Default,,0000,0000,0000,,Sự thật đã bị dập tắt trước khi hiện tượng xảy ra...
Dialogue: 0,0:05:07.53,0:05:09.47,Default,,0000,0000,0000,,Kuze ắt hẳn đã đi tới\Nkết luận đó.
Dialogue: 0,0:05:10.24,0:05:14.00,Default,,0000,0000,0000,,Hiện tại, anh ta đang giữ im lặng, giấu kín\Nsự thật ngay cả với người tị nạn,
Dialogue: 0,0:05:14.41,0:05:18.17,Default,,0000,0000,0000,,ráo riết tìm kiếm thứ gì đó\Ncó thể giúp anh ta lật ngược thế cờ lần nữa.
Dialogue: 0,0:05:18.28,0:05:19.47,Default,,0000,0000,0000,,Điều gì khiến cô\Nnghĩ như vậy?
Dialogue: 0,0:05:20.55,0:05:22.78,Default,,0000,0000,0000,,Bởi vì nếu ở vào vị trí của anh ta,\Ntôi cũng sẽ làm như thế.
Dialogue: 0,0:05:27.79,0:05:30.22,Default,,0000,0000,0000,,Tâm trí cô dường như\Nchẳng tập trung vào công việc gì cả.
Dialogue: 0,0:05:31.26,0:05:35.66,Default,,0000,0000,0000,,Nghe này, đúng là chúng tôi ở đây vì bị thu hút\Nbởi tài năng của cô,
Dialogue: 0,0:05:36.86,0:05:40.66,Default,,0000,0000,0000,,nhưng bọn tôi đâu có dựa dẫm vào cô đến mức\Nkhông thể tự yểm trợ cho cô, hiểu chứ?
Dialogue: 0,0:05:43.37,0:05:47.57,Default,,0000,0000,0000,,Cảm ơn. Tôi không phiền khi anh\Nnhắc nhở tôi thẳng thắn như thế đâu.
Dialogue: 0,0:05:49.58,0:05:54.17,Default,,0000,0000,0000,,Borma, anh và Paz hãy tham gia vào\Ncông tác rà phá bom theo kế hoạch.
Dialogue: 0,0:05:54.55,0:05:56.01,Default,,0000,0000,0000,,Saito, anh đi với tôi.
Dialogue: 0,0:05:56.62,0:05:59.71,Default,,0000,0000,0000,,Này, thế là sao? Chúng ta không cùng vào\Nnhư một phân đội à?
Dialogue: 0,0:06:00.39,0:06:01.72,Default,,0000,0000,0000,,Tôi có ý này.
Dialogue: 0,0:06:02.05,0:06:06.46,Default,,0000,0000,0000,,Hơn nữa, tôi có việc muốn anh\Nthay mặt tôi thực hiện.
Dialogue: 0,0:06:11.30,0:06:13.16,Default,,0000,0000,0000,,Việc chuẩn bị cho Kỳ tích Nhật Bản\Nđã thu xếp xong chưa?
Dialogue: 0,0:06:13.77,0:06:14.60,Default,,0000,0000,0000,,Xin phép ngài.
Dialogue: 0,0:06:14.70,0:06:16.17,Default,,0000,0000,0000,,Mọi thứ đã sẵn sàng.
Dialogue: 0,0:06:16.27,0:06:17.43,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:06:19.47,0:06:21.44,Default,,0000,0000,0000,,Thật đáng tiếc khi mọi chuyện\Nlại đi đến nước này.
Dialogue: 0,0:06:22.14,0:06:24.54,Default,,0000,0000,0000,,Ngay khi chiến dịch gỡ bom hoàn tất,
Dialogue: 0,0:06:24.88,0:06:28.64,Default,,0000,0000,0000,,tôi sẽ tổ chức họp báo và công bố\Nsự thật cho cả nước biết.
Dialogue: 0,0:06:29.62,0:06:33.98,Default,,0000,0000,0000,,Sau đó, việc Quân Phòng vệ tiến đánh Dejima\Ncó lẽ sẽ được phê chuẩn.
Dialogue: 0,0:06:34.12,0:06:38.28,Default,,0000,0000,0000,,Thưa Thủ tướng, như tôi đã viết trong báo cáo,\Nkhả năng người tị nạn...
Dialogue: 0,0:06:38.39,0:06:40.95,Default,,0000,0000,0000,,...thực sự có được plutonium\Nlà cực kỳ thấp.
Dialogue: 0,0:06:41.49,0:06:44.69,Default,,0000,0000,0000,,Nhiều khả năng chính CIS là kẻ\Nđã đẩy tình hình tồi tệ đến mức này.
Dialogue: 0,0:06:44.80,0:06:49.70,Default,,0000,0000,0000,,Tôi xin ngài hãy tạm hoãn\Nmọi cuộc tấn công vào Dejima lúc này.
Dialogue: 0,0:06:50.07,0:06:52.04,Default,,0000,0000,0000,,Đúng, tôi đã đọc báo cáo của ông.
Dialogue: 0,0:06:54.07,0:06:56.01,Default,,0000,0000,0000,,Tuy nhiên, chúng ta đã\Nhết thời gian rồi.
Dialogue: 0,0:06:56.24,0:06:59.34,Default,,0000,0000,0000,,Dựa trên tin tình báo thu thập được\Ntừ chính quyền Nga,
Dialogue: 0,0:06:59.45,0:07:02.88,Default,,0000,0000,0000,,chính phủ hiện đang hành động\Ndựa trên giả định...
Dialogue: 0,0:07:03.12,0:07:05.17,Default,,0000,0000,0000,,...rằng plutonium đã được\Nđưa vào Dejima.
Dialogue: 0,0:07:06.02,0:07:10.18,Default,,0000,0000,0000,,Xin thứ lỗi nếu tôi mạo muội, nhưng đó chẳng phải\Nchính xác là những gì CIS muốn ngài làm sao?
Dialogue: 0,0:07:10.62,0:07:14.62,Default,,0000,0000,0000,,Chẳng ai mong muốn điều đó, nhưng thứ đón chờ chúng ta\Nsau cuộc tiến công của Quân Phòng vệ...
Dialogue: 0,0:07:14.96,0:07:17.02,Default,,0000,0000,0000,,...sẽ là một cuộc chiến tranh tổng lực\Nvới người tị nạn.
Dialogue: 0,0:07:17.43,0:07:20.99,Default,,0000,0000,0000,,Xin Thủ tướng, hãy trình bày\Nkết quả của báo cáo đó trước Nội các.
Dialogue: 0,0:07:23.07,0:07:25.70,Default,,0000,0000,0000,,Giá như tôi nhìn thấy\Nbản báo cáo này sớm hơn...
Dialogue: 0,0:07:26.94,0:07:31.17,Default,,0000,0000,0000,,Đội 9 An ninh Công cộng\Nlà quân bài tẩy cuối cùng của tôi.
Dialogue: 0,0:07:36.08,0:07:39.78,Default,,0000,0000,0000,,Trưởng phòng Aramaki, tôi muốn ông\Ntạm thời tiếp tục trực chiến.
Dialogue: 0,0:07:41.12,0:07:42.59,Default,,0000,0000,0000,,Rõ, thưa Thủ tướng.
Dialogue: 0,0:07:53.70,0:07:58.36,Default,,0000,0000,0000,,{\i1}Phân đội 6 và 13 báo cáo.{\i0}\N{\i1}Họ đã vào vị trí trên tầng cao nhất.{\i0}
Dialogue: 0,0:07:59.74,0:08:03.61,Default,,0000,0000,0000,,Đội 9 An ninh Công cộng. Chúng tôi tới đây\Ntheo lệnh của Thủ tướng.
Dialogue: 0,0:08:04.08,0:08:06.24,Default,,0000,0000,0000,,Chẳng ai thông báo gì về việc\Ncác người sẽ đến cả.
Dialogue: 0,0:08:06.45,0:08:10.40,Default,,0000,0000,0000,,Đừng bận tâm. Ra thực địa thì\Nchuyện đó xảy ra như cơm bữa ấy mà.
Dialogue: 0,0:08:10.85,0:08:11.87,Default,,0000,0000,0000,,Đúng không nhỉ?
Dialogue: 0,0:08:12.95,0:08:14.48,Default,,0000,0000,0000,,Chữ ký của bà ấy,\Nchuẩn không cần chỉnh.
Dialogue: 0,0:08:15.49,0:08:18.18,Default,,0000,0000,0000,,Chúng tôi chỉ muốn các anh để chuyên gia rà phá bom\Ncủa chúng tôi lên tuyến đầu thôi.
Dialogue: 0,0:08:18.52,0:08:20.19,Default,,0000,0000,0000,,Xem ra chúng tôi chẳng còn lựa chọn nào khác.\NDẫn họ lên đó đi.
Dialogue: 0,0:08:20.29,0:08:21.16,Default,,0000,0000,0000,,Rõ, thưa sếp!
Dialogue: 0,0:08:24.46,0:08:27.16,Default,,0000,0000,0000,,Thế anh muốn làm gì\Nở đây?
Dialogue: 0,0:08:27.57,0:08:30.47,Default,,0000,0000,0000,,Thực ra, việc của tôi là\Nvới bộ vest đằng kia.
Dialogue: 0,0:08:31.80,0:08:33.00,Default,,0000,0000,0000,,Và đó có thể là\Nchuyện gì chứ?
Dialogue: 0,0:08:33.11,0:08:36.27,Default,,0000,0000,0000,,Nhờ công của anh mà bọn tôi suýt nữa\N{\i1}bị dẹp tiệm{\i0} rồi đấy,
Dialogue: 0,0:08:36.51,0:08:39.10,Default,,0000,0000,0000,,nhưng có hai ba điều\Ntôi muốn thưa chuyện với anh.
Dialogue: 0,0:08:40.38,0:08:41.74,Default,,0000,0000,0000,,Nếu anh đã khăng khăng như vậy.
Dialogue: 0,0:08:51.09,0:08:52.35,Default,,0000,0000,0000,,Nó kia rồi hả?
Dialogue: 0,0:08:52.96,0:08:55.80,Default,,0000,0000,0000,,Chúng tôi đã mất suốt năm ngày qua\Nđể phân tích cấu trúc của nó.
Dialogue: 0,0:08:55.80,0:08:58.13,Default,,0000,0000,0000,,Cuối cùng chúng tôi cũng chuẩn bị\Nbắt đầu quy trình tháo ngòi.
Dialogue: 0,0:08:58.90,0:09:02.77,Default,,0000,0000,0000,,Họ thuộc Đội 9. Nếu có việc gì họ giúp được,\Nhãy giao việc cho họ.
Dialogue: 0,0:09:04.34,0:09:06.94,Default,,0000,0000,0000,,\"Gửi Kayabuki bằng tất cả tình yêu\"...
Dialogue: 0,0:09:07.61,0:09:09.57,Default,,0000,0000,0000,,Đúng là một bức thư tình\Nquái đản...
Dialogue: 0,0:09:09.71,0:09:12.27,Default,,0000,0000,0000,,Tôi nghe nói ngày xưa người ta hay viết\Nnhững thông điệp kiểu này lên chóp mũi...
Dialogue: 0,0:09:12.38,0:09:14.81,Default,,0000,0000,0000,,...của những quả bom như Fatman\Nhoặc tên lửa Scud.
Dialogue: 0,0:09:14.91,0:09:16.68,Default,,0000,0000,0000,,Ý anh là họ đang bắt chước\Nngười Mỹ à?
Dialogue: 0,0:09:16.78,0:09:19.18,Default,,0000,0000,0000,,Chịu thôi.\NCó thể có, có thể không.
Dialogue: 0,0:09:20.49,0:09:22.18,Default,,0000,0000,0000,,Chỉ số trên máy đo Geiger\Ncủa anh thế nào?
Dialogue: 0,0:09:22.49,0:09:26.79,Default,,0000,0000,0000,,Chuẩn rồi. Nhưng trông có vẻ họ không có đủ thời gian\Nhay công nghệ để biến nó thành một quả bom hạt nhân.
Dialogue: 0,0:09:27.26,0:09:29.39,Default,,0000,0000,0000,,Vậy nó chỉ là\Nmột quả bom bẩn thôi hả?
Dialogue: 0,0:09:29.50,0:09:34.36,Default,,0000,0000,0000,,Đúng vậy. Nhưng nếu nó nổ, nó sẽ phủ bụi phóng xạ\Nlên mọi thứ trong bán kính 30 km.
Dialogue: 0,0:09:34.90,0:09:38.39,Default,,0000,0000,0000,,Cho tới khi sơ tán được người dân\Nvà chuẩn bị sẵn sàng Kỳ tích Nhật Bản,
Dialogue: 0,0:09:38.64,0:09:40.47,Default,,0000,0000,0000,,chúng tôi chỉ có thể\Nđóng băng nó lại thôi.
Dialogue: 0,0:09:40.57,0:09:42.37,Default,,0000,0000,0000,,Không có đồng hồ hẹn giờ\Ntrên đó sao?
Dialogue: 0,0:09:42.48,0:09:43.70,Default,,0000,0000,0000,,May mắn cho chúng ta đấy.
Dialogue: 0,0:09:43.81,0:09:48.97,Default,,0000,0000,0000,,Nghe thế thì nhẹ nhõm rồi. Nhưng nó sẽ có\Ncác ngòi nổ dự phòng đấy,
Dialogue: 0,0:09:49.12,0:09:53.07,Default,,0000,0000,0000,,...ít nhất cũng có một cảm biến rung chấn/áp suất\Nvà một linh kiện quang dẫn.
Dialogue: 0,0:09:54.49,0:09:57.15,Default,,0000,0000,0000,,Chờ đã... Có thứ gì đó\Nở mặt nắp lưng nữa kìa.
Dialogue: 0,0:09:58.36,0:10:00.15,Default,,0000,0000,0000,,Trời ạ, anh thực sự thuộc bên\NAn ninh Công cộng đấy à?
Dialogue: 0,0:10:00.29,0:10:02.12,Default,,0000,0000,0000,,Thời chiến tôi từng\Nở trong quân ngũ.
Dialogue: 0,0:10:02.23,0:10:05.86,Default,,0000,0000,0000,,Tất nhiên, chuyên môn của tôi hồi đó\Nlà {\i1}cài{\i0} mấy thứ này...
Dialogue: 0,0:10:12.30,0:10:14.57,Default,,0000,0000,0000,,Anh không thấy phiền khi ta nói chuyện ngay phía trên...
Dialogue: 0,0:10:14.67,0:10:17.14,Default,,0000,0000,0000,,...nơi họ đang tháo ngòi quả bom hạt nhân đó chứ?
Dialogue: 0,0:10:20.68,0:10:23.08,Default,,0000,0000,0000,,Thế anh định đẩy chuyện này\Nđi xa đến mức nào nữa?
Dialogue: 0,0:10:23.45,0:10:24.78,Default,,0000,0000,0000,,Đẩy chuyện gì?
Dialogue: 0,0:10:25.12,0:10:27.09,Default,,0000,0000,0000,,Làm trầm trọng thêm tình hình này.
Dialogue: 0,0:10:27.69,0:10:31.95,Default,,0000,0000,0000,,E rằng đó là câu hỏi anh phải đi hỏi đám tị nạn\Nhoặc một nhà phân tích quân sự.
Dialogue: 0,0:10:32.12,0:10:33.96,Default,,0000,0000,0000,,Nó nằm ngoài lĩnh vực\Nchuyên môn của tôi.
Dialogue: 0,0:10:34.69,0:10:36.35,Default,,0000,0000,0000,,Nói nhảm nhí.
Dialogue: 0,0:10:37.23,0:10:40.46,Default,,0000,0000,0000,,Việc tạo dựng một kẻ trung gian\Nđể kích động những kẻ bắt chước...
Dialogue: 0,0:10:40.73,0:10:43.76,Default,,0000,0000,0000,,Đề tài đó vốn là một phần\Ntrong lĩnh vực nghiên cứu cũ của anh.
Dialogue: 0,0:10:44.94,0:10:49.24,Default,,0000,0000,0000,,Xã hội này chứa đựng những yếu tố khiến các tình huống\Nnhư thế này rất dễ bị kích hoạt.
Dialogue: 0,0:10:49.91,0:10:53.35,Default,,0000,0000,0000,,Dẫu sao thì lịch sử nhân loại vốn do kẻ nắm quyền viết nên,
Dialogue: 0,0:10:53.45,0:10:56.41,Default,,0000,0000,0000,,...những kẻ đã lập trình nên\Nnhững thứ như thần thoại và truyền thuyết.
Dialogue: 0,0:10:57.48,0:11:00.54,Default,,0000,0000,0000,,Và trong thế giới đó,\Nchẳng một ai hay biết,
Dialogue: 0,0:11:00.79,0:11:04.42,Default,,0000,0000,0000,,có một kẻ hoang tưởng tự đại mà cơn khát\N15 phút danh vọng đã lớn dần lên.
Dialogue: 0,0:11:04.79,0:11:08.02,Default,,0000,0000,0000,,Rốt cuộc, hắn muốn tạo ra một người hùng\Nvĩ đại hơn chính bản thân mình.
Dialogue: 0,0:11:09.50,0:11:12.49,Default,,0000,0000,0000,,Chẳng phải Nhóm Mười Một Cá Nhân chỉ là\Nmột phức cảm độc lập giả mạo...
Dialogue: 0,0:11:12.83,0:11:15.49,Default,,0000,0000,0000,,...được tạo ra bởi một tên tội phạm\Ntheo chiều hướng đó sao?
Dialogue: 0,0:11:16.00,0:11:19.37,Default,,0000,0000,0000,,Chà, quả là một câu chuyện\Nthú vị đấy.
Dialogue: 0,0:11:20.74,0:11:22.30,Default,,0000,0000,0000,,Mày là một thằng khốn lươn lẹo...
Dialogue: 0,0:11:23.44,0:11:25.17,Default,,0000,0000,0000,,Nhưng sau cùng thì...
Dialogue: 0,0:11:26.01,0:11:27.48,Default,,0000,0000,0000,,...mày cũng chỉ là hạng hai thôi.
Dialogue: 0,0:11:32.89,0:11:34.05,Default,,0000,0000,0000,,Tắt đèn đi.
Dialogue: 0,0:11:37.49,0:11:38.75,Default,,0000,0000,0000,,Cậu có thấy cái nắp\Nbị lệch không?
Dialogue: 0,0:11:38.86,0:11:39.76,Default,,0000,0000,0000,,An toàn rồi.
Dialogue: 0,0:11:39.89,0:11:42.83,Default,,0000,0000,0000,,Tìm thấy rồi. Một công tắc\Nphản xạ song song.
Dialogue: 0,0:11:43.16,0:11:45.15,Default,,0000,0000,0000,,Được rồi, tôi đang đưa\Ngương vào.
Dialogue: 0,0:11:49.13,0:11:51.47,Default,,0000,0000,0000,,Tôi đã cắt toàn bộ\Ncác linh kiện quang dẫn.
Dialogue: 0,0:11:53.24,0:11:55.40,Default,,0000,0000,0000,,Nó là mô hình mô phỏng\Nmột quả bom hạt nhân dạng nổ sập.
Dialogue: 0,0:11:57.44,0:11:59.91,Default,,0000,0000,0000,,Vậy đây là cách họ ngầm nói rằng\Nhọ {\i1}thực sự{\i0} có thời gian và công nghệ.
Dialogue: 0,0:12:00.01,0:12:02.71,Default,,0000,0000,0000,,Họ chỉ {\i1}chọn{\i0} không\Nchế tạo nó thôi, hả?
Dialogue: 0,0:12:12.63,0:12:13.75,Default,,0000,0000,0000,,Anh đang nói cái quái gì thế?
Dialogue: 0,0:12:13.99,0:12:17.72,Default,,0000,0000,0000,,Vài phút trước có một đội thu hồi khác\Nvừa đi qua đây.
Dialogue: 0,0:12:18.00,0:12:19.26,Default,,0000,0000,0000,,Có một cái {\i1}gì cơ?{\i0}
Dialogue: 0,0:12:26.51,0:12:30.84,Default,,0000,0000,0000,,{\i1}Borma, quan điểm của anh về quả bom thế nào{\i0}\N{\i1}sau khi đã tận mắt nhìn thấy cấu trúc của nó?{\i0}
Dialogue: 0,0:12:31.41,0:12:35.61,Default,,0000,0000,0000,,{\i1}Toàn bộ nó đều toát lên \"thông điệp từ người tị nạn\",{\i0}\N{\i1}nhưng có điểm rất kỳ lạ.{\i0}
Dialogue: 0,0:12:35.71,0:12:36.68,Default,,0000,0000,0000,,{\i1}Chẳng hạn như?{\i0}
Dialogue: 0,0:12:36.78,0:12:40.55,Default,,0000,0000,0000,,{\i1}Khối thuốc nổ chúng dùng là khối bộc phá M112{\i0}\N{\i1}do quân đội Mỹ sử dụng.{\i0}
Dialogue: 0,0:12:41.02,0:12:44.29,Default,,0000,0000,0000,,{\i1}Đám tị nạn trước nay{\i0}\N{\i1}toàn dùng C4 thôi.{\i0}
Dialogue: 0,0:12:44.39,0:12:48.26,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi. Hai người hãy ở đó cho tới phút cuối,{\i0}\N{\i1}rồi hội quân với đội vận chuyển.{\i0}
Dialogue: 0,0:12:48.39,0:12:51.23,Default,,0000,0000,0000,,{\i1}Nhưng tôi vẫn chưa tìm thấy thứ gì{\i0}\N{\i1}liên kết CIS với...{\i0}
Dialogue: 0,0:12:51.33,0:12:53.06,Default,,0000,0000,0000,,{\i1}Tạm thời hai người đã làm{\i0}\N{\i1}đủ phần việc của mình rồi.{\i0}
Dialogue: 0,0:12:53.63,0:12:54.46,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:12:57.70,0:13:00.60,Default,,0000,0000,0000,,Ý anh chính xác là gì khi bảo\Ntôi chỉ là hạng hai?
Dialogue: 0,0:13:02.37,0:13:07.37,Default,,0000,0000,0000,,Cách đây một thời gian chúng tôi từng chạm trán\Nmột thiên tài hacker kiểu phức cảm độc lập.
Dialogue: 0,0:13:09.55,0:13:13.64,Default,,0000,0000,0000,,Người ta không khỏi so sánh vụ này\Nvới hiện tượng mà cậu ta đã tạo ra.
Dialogue: 0,0:13:15.39,0:13:18.52,Default,,0000,0000,0000,,So với cậu ta, những kẻ\Ntự sát ở đây...
Dialogue: 0,0:13:18.62,0:13:20.79,Default,,0000,0000,0000,,...chẳng có gì ấn tượng cả.
Dialogue: 0,0:13:22.39,0:13:25.80,Default,,0000,0000,0000,,Và khi chúng tôi kiểm tra bộ nhớ ngoài\Ncủa Nhóm Mười Một Cá Nhân,
Dialogue: 0,0:13:26.23,0:13:30.79,Default,,0000,0000,0000,,chúng tôi phát hiện ra chúng chẳng qua chỉ là\Nnhững kẻ bắt chước đơn thuần do một loại virus tạo ra.
Dialogue: 0,0:13:31.10,0:13:32.57,Default,,0000,0000,0000,,Vậy sao?
Dialogue: 0,0:13:33.31,0:13:41.27,Default,,0000,0000,0000,,Nghĩa là chúng chỉ là công cụ thao túng dư luận\Ndo một tên tội phạm nào đó tạo nên,
Dialogue: 0,0:13:41.61,0:13:44.38,Default,,0000,0000,0000,,có lẽ chôm chỉa cái tên từ nhóm khủng bố\Ntừng đánh chiếm đại sứ quán Trung Quốc.
Dialogue: 0,0:13:44.78,0:13:51.21,Default,,0000,0000,0000,,Dù vậy, tôi cá là tên khốn phát tán con virus đó\Ntự nhận mình là một hacker có nghề đấy.
Dialogue: 0,0:13:51.79,0:13:55.62,Default,,0000,0000,0000,,Ý anh là ám chỉ tôi\Nlà kẻ tạo ra con virus đó à?
Dialogue: 0,0:13:55.99,0:13:57.46,Default,,0000,0000,0000,,Tôi đâu có nói\Nnhư vậy.
Dialogue: 0,0:13:59.73,0:14:02.20,Default,,0000,0000,0000,,Nếu thế, anh muốn tôi\Nnói cho anh nghe điều gì?
Dialogue: 0,0:14:02.70,0:14:06.10,Default,,0000,0000,0000,,Tôi muốn anh nói xem nhận định của {\i1}anh{\i0}\Nvề những kẻ này là như thế nào.
Dialogue: 0,0:14:10.34,0:14:17.18,Default,,0000,0000,0000,,Được thôi. Nếu như anh nói, Nhóm Mười Một Cá Nhân\Nxuất hiện là kết quả của một con virus,
Dialogue: 0,0:14:18.05,0:14:22.01,Default,,0000,0000,0000,,thì chẳng phải anh sẽ phải công nhận\Nhọ mới là những thiên tài,
Dialogue: 0,0:14:22.12,0:14:26.22,Default,,0000,0000,0000,,không, là những {\i1}người hùng,{\i0} cùng một đẳng cấp\Nvới chàng hacker độc lập của các anh...
Dialogue: 0,0:14:26.33,0:14:30.02,Default,,0000,0000,0000,,...vì đã tiếp tục leo thang tình hình\Ncho tới tận bây giờ sao?
Dialogue: 0,0:14:30.30,0:14:33.96,Default,,0000,0000,0000,,Vụ tự sát tập thể đó của chúng đã lan tỏa lý tưởng,\Ntôi thừa nhận điều đó.
Dialogue: 0,0:14:34.07,0:14:36.16,Default,,0000,0000,0000,,Nhưng chúng trở thành người hùng\Ncủa ai cơ chứ?
Dialogue: 0,0:14:36.94,0:14:39.73,Default,,0000,0000,0000,,Của công dân Nhật Bản ư?\NCòn lâu nhé!
Dialogue: 0,0:14:40.47,0:14:44.98,Default,,0000,0000,0000,,Cùng lắm thì chúng chỉ là những con tốt thí tạo cớ\Ncho tình hình tị nạn trở nên tồi tệ hơn.
Dialogue: 0,0:14:45.41,0:14:48.71,Default,,0000,0000,0000,,Thực tế là cái chết của chúng\Nđã bị lãng quên từ lâu rồi.
Dialogue: 0,0:14:49.42,0:14:50.71,Default,,0000,0000,0000,,Tôi nghĩ tôi hiểu ý anh.
Dialogue: 0,0:14:51.05,0:14:58.01,Default,,0000,0000,0000,,Nhưng nếu điều quan trọng không phải là ký ức về họ,\Nmà là việc tạo ra tình thế hiện tại của chúng ta,
Dialogue: 0,0:14:58.12,0:15:01.49,Default,,0000,0000,0000,,thì chẳng phải người ta buộc phải nói rằng\Ntên tội phạm đã...
Dialogue: 0,0:15:01.63,0:15:04.82,Default,,0000,0000,0000,,...nhào nặn nên Nhóm Mười Một Cá Nhân\Nlà một hacker đầy tài năng sao?
Dialogue: 0,0:15:04.96,0:15:08.16,Default,,0000,0000,0000,,Ừ. Dù ghét phải thừa nhận,\Nnhưng không thể phủ nhận điều đó.
Dialogue: 0,0:15:08.70,0:15:13.40,Default,,0000,0000,0000,,Dù vậy, tôi vẫn thấy lấn cấn khi dùng những từ\Nnhư \"thiên tài\" để miêu tả gã đó.
Dialogue: 0,0:15:14.04,0:15:17.30,Default,,0000,0000,0000,,Hồ sơ tội phạm hiện lên trong đầu\Ntừ hệ tư tưởng và con virus đó...
Dialogue: 0,0:15:17.58,0:15:23.38,Default,,0000,0000,0000,,...là một kẻ theo chủ nghĩa cá nhân bị chi phối\Nbởi khao khát thoát khỏi mặc cảm tự ti của chính mình.
Dialogue: 0,0:15:24.15,0:15:29.52,Default,,0000,0000,0000,,Anh sẽ chẳng bao giờ thu phục được lòng người\Nbằng cách áp đặt niềm tin cá nhân lên người khác.
Dialogue: 0,0:15:30.12,0:15:32.09,Default,,0000,0000,0000,,Bất kể ý đồ của anh\Nlà tốt hay xấu.
Dialogue: 0,0:15:32.42,0:15:35.29,Default,,0000,0000,0000,,Trừ phi anh có một niềm xác tín\Nkhông thể lay chuyển vào điều gì đó,
Dialogue: 0,0:15:35.63,0:15:38.49,Default,,0000,0000,0000,,bằng không anh sẽ chẳng bao giờ trở thành kẻ\Nxứng đáng được gọi là thiên tài hay người hùng.
Dialogue: 0,0:15:39.33,0:15:40.70,Default,,0000,0000,0000,,Xác tín ư?
Dialogue: 0,0:15:40.80,0:15:43.70,Default,,0000,0000,0000,,Đúng thế. Dù sao thì đó cũng là\Nquan điểm của tôi.
Dialogue: 0,0:15:44.20,0:15:45.57,Default,,0000,0000,0000,,Và thêm một điều nữa.
Dialogue: 0,0:15:45.67,0:15:48.40,Default,,0000,0000,0000,,Yếu tố quan trọng nhất trong tất cả.\NThứ mà anh bắt buộc phải có.
Dialogue: 0,0:15:48.91,0:15:51.40,Default,,0000,0000,0000,,May mắn là yếu tố duy nhất\Nkhông thể thiếu.
Dialogue: 0,0:15:51.78,0:15:54.61,Default,,0000,0000,0000,,Ồ? Và vì sao lại thế?
Dialogue: 0,0:15:54.71,0:15:58.91,Default,,0000,0000,0000,,Chẳng phải quá rõ ràng rồi sao?\NKhi suy xét đến tận cùng,
Dialogue: 0,0:15:59.32,0:16:02.38,Default,,0000,0000,0000,,thiên tài và người hùng phụ thuộc phần lớn\Nvào góc nhìn của bên thứ ba.
Dialogue: 0,0:16:03.09,0:16:08.15,Default,,0000,0000,0000,,Để thuyết phục mọi người rằng người hùng thực sự là người hùng,\Nanh cần phản ứng từ những kẻ đứng xem.
Dialogue: 0,0:16:08.53,0:16:11.09,Default,,0000,0000,0000,,Và chính nội dung của phản ứng đó\Nsẽ quyết định...
Dialogue: 0,0:16:11.20,0:16:13.66,Default,,0000,0000,0000,,...nâng người hùng lên đỉnh cao chót vót\Nhay quăng quật hắn xuống đất đen.
Dialogue: 0,0:16:14.13,0:16:16.23,Default,,0000,0000,0000,,Điều đó hoàn toàn\Nphụ thuộc vào may mắn.
Dialogue: 0,0:16:17.64,0:16:20.43,Default,,0000,0000,0000,,Tôi hiểu rồi. Đó là một\Ngiả thuyết thú vị.
Dialogue: 0,0:16:20.81,0:16:24.77,Default,,0000,0000,0000,,Phải nói là tôi không ngờ\Nanh lại lắm lời đến thế đấy.
Dialogue: 0,0:16:25.38,0:16:26.97,Default,,0000,0000,0000,,Đó được coi là\Nmột lời khen à?
Dialogue: 0,0:16:27.51,0:16:30.18,Default,,0000,0000,0000,,Anh có thể coi đó là lời khen\Nnếu muốn.
Dialogue: 0,0:16:32.35,0:16:35.41,Default,,0000,0000,0000,,Nếu anh đã khen tôi như vậy,\Nđể tôi nói thêm một điều nữa.
Dialogue: 0,0:16:36.05,0:16:39.55,Default,,0000,0000,0000,,Đó là về nhân tố bí ẩn X\Ntrong tình huống này.
Dialogue: 0,0:16:55.01,0:16:56.17,Default,,0000,0000,0000,,Họ ở phía trên.
Dialogue: 0,0:17:01.05,0:17:07.18,Default,,0000,0000,0000,,Kuze Hideo, kẻ duy nhất trong Nhóm Mười Một Cá Nhân\Nkhông tự sát vào ngày hôm đó...
Dialogue: 0,0:17:08.39,0:17:10.86,Default,,0000,0000,0000,,Sau đó, hắn biến mất\Nđi đâu không ai hay,
Dialogue: 0,0:17:10.96,0:17:14.79,Default,,0000,0000,0000,,và khi tái xuất hiện, hắn đã trở thành\Nthủ lĩnh của người tị nạn.
Dialogue: 0,0:17:15.69,0:17:17.42,Default,,0000,0000,0000,,Khá kỳ lạ,\Nđúng chứ?
Dialogue: 0,0:17:17.66,0:17:22.60,Default,,0000,0000,0000,,Đó chỉ là một sự ngẫu nhiên? Hay là thứ\Nđã được lên kế hoạch ngay từ đầu?
Dialogue: 0,0:17:24.34,0:17:28.50,Default,,0000,0000,0000,,Hành vi của hắn hoàn toàn trái ngược\Nvới những kẻ khác trong Nhóm Mười Một Cá Nhân,
Dialogue: 0,0:17:28.61,0:17:31.17,Default,,0000,0000,0000,,nên đó hẳn là nhân tố bí ẩn X\Ncủa anh đang vận hành.
Dialogue: 0,0:17:31.64,0:17:33.87,Default,,0000,0000,0000,,Nhưng người ta không khỏi\Nnhìn nhận hành động của hắn...
Dialogue: 0,0:17:33.98,0:17:36.88,Default,,0000,0000,0000,,...như đang góp phần thúc đẩy\Nnguyên nhân dẫn tới việc trục xuất người tị nạn.
Dialogue: 0,0:17:38.08,0:17:44.89,Default,,0000,0000,0000,,Xét thấy hành động của hắn, dù khác biệt, nhưng đang\Ndẫn dắt tình hình tới cùng một kết cục,
Dialogue: 0,0:17:44.99,0:17:51.40,Default,,0000,0000,0000,,điều đó có nghĩa tên tội phạm\Nđã nhào nặn nên cả nhân tố X này của anh.
Dialogue: 0,0:17:51.66,0:17:53.10,Default,,0000,0000,0000,,Có thật thế không?
Dialogue: 0,0:17:53.20,0:17:57.86,Default,,0000,0000,0000,,Tôi thừa nhận hành động của hắn đang thúc đẩy\Nnguyên cớ để trục xuất người tị nạn.
Dialogue: 0,0:17:58.60,0:18:01.37,Default,,0000,0000,0000,,Màn tẩu thoát trên con tàu ngụy trang\Nđược phát sóng trên mạng lưới truyền hình quốc gia...
Dialogue: 0,0:18:01.47,0:18:04.31,Default,,0000,0000,0000,,...càng trở nên kịch tính hơn\Nnhờ vụ mất điện ở Nagasaki.
Dialogue: 0,0:18:05.21,0:18:08.51,Default,,0000,0000,0000,,Và giờ đây, một quả bom hạt nhân đang được tháo ngòi\Nngay dưới chân chúng ta lúc này...
Dialogue: 0,0:18:10.55,0:18:14.38,Default,,0000,0000,0000,,Nếu Kuze làm tất cả chuyện này, tôi đoán chính phủ\Nchẳng còn cách nào khác ngoài việc mạnh tay trừng trị.
Dialogue: 0,0:18:15.15,0:18:18.88,Default,,0000,0000,0000,,Nhưng vấn đề là, liệu có thực sự\Nlà Kuze đứng sau tất cả những chuyện này?
Dialogue: 0,0:18:19.63,0:18:21.68,Default,,0000,0000,0000,,Chẳng phải đây thực chất chỉ là màn kịch\Nđược dàn dựng...
Dialogue: 0,0:18:21.79,0:18:23.85,Default,,0000,0000,0000,,...bởi tên tội phạm đang đóng vai\Nnhà sản xuất của hắn sao?
Dialogue: 0,0:18:24.23,0:18:28.60,Default,,0000,0000,0000,,Hay nói đúng hơn, chẳng phải anh có thể bảo rằng\N\"nhà sản xuất\" tội phạm này...
Dialogue: 0,0:18:28.70,0:18:33.87,Default,,0000,0000,0000,,...đang vô tình giúp đỡ Kuze\Nvà bắt đầu bắt chước hành động của hắn sao?
Dialogue: 0,0:18:34.21,0:18:35.87,Default,,0000,0000,0000,,Ý anh là sao khi nói thế?
Dialogue: 0,0:18:36.54,0:18:41.17,Default,,0000,0000,0000,,Kuze từ Etorofu trở về Dejima,\Nnhưng không hề mang theo chút plutonium nào.
Dialogue: 0,0:18:42.05,0:18:44.24,Default,,0000,0000,0000,,Tôi cá là bình thường hắn sẽ\Nmuốn nói cho đám tị nạn biết...
Dialogue: 0,0:18:44.48,0:18:47.01,Default,,0000,0000,0000,,...và tạm thời kìm hãm\Ntình hình lại.
Dialogue: 0,0:18:47.95,0:18:50.82,Default,,0000,0000,0000,,Nhưng bất chấp điều đó, giờ ta lại có\Nmột vụ khủng bố liên quan đến plutonium.
Dialogue: 0,0:18:51.22,0:18:52.66,Default,,0000,0000,0000,,Và rồi sao nữa?
Dialogue: 0,0:18:53.23,0:18:58.16,Default,,0000,0000,0000,,Hắn có hùa theo kế hoạch của \"nhà sản xuất\"\Nvà dùng đòn tung hỏa mù để tuyên chiến không?
Dialogue: 0,0:18:59.36,0:19:01.83,Default,,0000,0000,0000,,Hắn chẳng thèm làm\Ncái quái gì cả.
Dialogue: 0,0:19:02.13,0:19:04.23,Default,,0000,0000,0000,,Hiện tại, hắn ngậm chặt miệng về chuyện đó\Nvà nói dối người tị nạn,
Dialogue: 0,0:19:04.34,0:19:06.83,Default,,0000,0000,0000,,tìm kiếm thứ gì đó\Ngiúp hắn lật ngược thế cờ.
Dialogue: 0,0:19:07.71,0:19:11.04,Default,,0000,0000,0000,,Hay trái lại, có lẽ bằng cách giữ im lặng,\Nchẳng phải chính {\i1}Kuze...{\i0}
Dialogue: 0,0:19:11.14,0:19:15.05,Default,,0000,0000,0000,,...mới là kẻ rút được quân bài tẩy\Ncó thể kiểm soát tình hình sao?
Dialogue: 0,0:19:15.95,0:19:18.61,Default,,0000,0000,0000,,Kuze khởi đầu chẳng qua chỉ là\Nmột biến số chưa xác định,
Dialogue: 0,0:19:18.95,0:19:22.44,Default,,0000,0000,0000,,nên nếu hóa ra {\i1}hắn{\i0} mới là thiên tài thực sự...\Nngười hùng thực sự... trong tất cả chuyện này,
Dialogue: 0,0:19:22.75,0:19:25.66,Default,,0000,0000,0000,,thì chẳng phải kẻ {\i1}nghĩ rằng{\i0} mình là nhà sản xuất của hắn...
Dialogue: 0,0:19:25.89,0:19:30.69,Default,,0000,0000,0000,,...thực chất đã biến thành kẻ bắt chước Kuze\Nvào một thời điểm nào đó rồi sao?
Dialogue: 0,0:20:02.63,0:20:03.83,Default,,0000,0000,0000,,Được rồi, giao lại cho anh đấy.
Dialogue: 0,0:20:03.83,0:20:04.76,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:20:10.94,0:20:12.73,Default,,0000,0000,0000,,Những kẻ đó chẳng trở thành\Nngười hùng của ai cả,
Dialogue: 0,0:20:12.87,0:20:18.00,Default,,0000,0000,0000,,dù họ tin vào hệ tư tưởng bị thêu dệt đó\Nvà thậm chí đã tự kết liễu đời mình.
Dialogue: 0,0:20:18.41,0:20:20.90,Default,,0000,0000,0000,,Tôi tự hỏi Ghost của họ\Nđang phiêu dạt nơi nao lúc này...
Dialogue: 0,0:20:40.70,0:20:44.29,Default,,0000,0000,0000,,{\i1}Thiếu tá, cô lấy được{\i0}\N{\i1}plutonium ổn thỏa chứ?{\i0}
Dialogue: 0,0:20:44.64,0:20:46.04,Default,,0000,0000,0000,,{\i1}Xong việc rồi.{\i0}
Dialogue: 0,0:20:46.34,0:20:47.50,Default,,0000,0000,0000,,{\i1}Đùa nhau chắc.{\i0}
Dialogue: 0,0:20:47.61,0:20:51.98,Default,,0000,0000,0000,,{\i1}Tôi đã dùng bộ nhớ ngoài của anh để giữ chân hắn{\i0}\N{\i1}nói về Kuze hết mức có thể,{\i0}
Dialogue: 0,0:20:52.28,0:20:54.14,Default,,0000,0000,0000,,{\i1}nhưng tôi không chắc{\i0}\N{\i1}liệu nó có hiệu quả hay không.{\i0}
Dialogue: 0,0:20:55.31,0:20:59.37,Default,,0000,0000,0000,,{\i1}Hiệu quả đấy. Chúng ta sẽ mang thứ này{\i0}\N{\i1}thẳng tới Spring-8.{\i0}
Dialogue: 0,0:20:59.99,0:21:02.72,Default,,0000,0000,0000,,{\i1}Sự ám ảnh về tính hiện thực{\i0}\N{\i1}của đám chuyên gia chiến tranh thông tin...{\i0}
Dialogue: 0,0:21:02.82,0:21:05.19,Default,,0000,0000,0000,,{\i1}...đã khiến chúng để lại vật liệu,{\i0}\N{\i1}và đó sẽ là đòn chí mạng chôn vùi chúng.{\i0}
Dialogue: 0,0:21:05.66,0:21:09.46,Default,,0000,0000,0000,,{\i1}Nếu plutonium này trùng khớp với plutonium{\i0}\N{\i1}chúng ta thu thập ở nhà máy hạt nhân Shinjuku,{\i0}
Dialogue: 0,0:21:09.90,0:21:12.89,Default,,0000,0000,0000,,{\i1}nó sẽ chứng minh CIS{\i0}\N{\i1}đứng sau vụ này.{\i0}
Dialogue: 0,0:21:13.47,0:21:14.63,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:21:17.47,0:21:22.00,Default,,0000,0000,0000,,Gohda. Cũng như Kuze, bọn tôi\Ncũng chưa chịu bỏ cuộc đâu.
Dialogue: 0,0:21:22.57,0:21:24.27,Default,,0000,0000,0000,,Thế cơ à?
Dialogue: 0,0:21:29.11,0:21:30.88,Default,,0000,0000,0000,,Có một điều\Ntôi quên chưa hỏi anh.
Dialogue: 0,0:21:31.52,0:21:36.72,Default,,0000,0000,0000,,Tôi không nghĩ sẽ có đợt bùng phát khác, nhưng chúng tôi\Nvẫn chưa biết yếu tố kích hoạt cuối cùng của virus là gì.
Dialogue: 0,0:21:37.49,0:21:39.92,Default,,0000,0000,0000,,Chúng tôi muốn viết một vắc-xin\Nphòng hờ thôi.
Dialogue: 0,0:21:40.03,0:21:42.79,Default,,0000,0000,0000,,Nếu là anh, anh sẽ dùng thứ gì\Nlàm yếu tố kích hoạt cuối cùng?
Dialogue: 0,0:21:44.93,0:21:47.49,Default,,0000,0000,0000,,Chà, nếu tôi là\Nthủ phạm...
Dialogue: 0,0:21:50.37,0:21:56.17,Default,,0000,0000,0000,,...yếu tố tôi có lẽ sẽ dùng là việc họ\Nvẫn còn là trai tân trước khi cyborg hóa.
Dialogue: 0,0:21:56.64,0:21:58.13,Default,,0000,0000,0000,,Cái gì cơ?
Dialogue: 0,0:21:59.11,0:22:03.17,Default,,0000,0000,0000,,Nếu anh tìm kiếm những kẻ sẵn sàng tử vì đạo\Nnhư một người hùng của quần chúng,
Dialogue: 0,0:22:03.28,0:22:05.18,Default,,0000,0000,0000,,thì đó là yếu tố\Ntuyệt đối không thể thiếu.
Dialogue: 0,0:22:05.98,0:22:10.61,Default,,0000,0000,0000,,Tất nhiên, việc có bao nhiêu người sở hữu \"món quà\" đặc biệt đó\Nthì có phần mang tính canh bạc...
Dialogue: 0,0:22:11.02,0:22:14.46,Default,,0000,0000,0000,,Thằng khốn kiếp... Mày còn có thể\Nbiến thái đến mức nào nữa hả?
Dialogue: 0,0:22:14.83,0:22:19.23,Default,,0000,0000,0000,,Anh nghĩ thế là biến thái sao?\NNếu anh muốn biết, thì chính tôi cũng còn tân đấy.
Dialogue: 0,0:22:20.93,0:22:23.16,Default,,0000,0000,0000,,Cuộc trò chuyện ngắn ngủi vừa rồi\Nquả thực vô cùng thú vị.
Dialogue: 0,0:22:23.27,0:22:25.50,Default,,0000,0000,0000,,Hay đúng hơn là bổ ích. Tôi phải cảm ơn anh đấy.
Dialogue: 0,0:22:26.84,0:22:29.36,Default,,0000,0000,0000,,Cuộc chiến của riêng tôi\Ncũng chưa kết thúc đâu.
Dialogue: 0,0:22:29.74,0:22:35.18,Default,,0000,0000,0000,,Các anh sẽ ngăn chặn tôi trước, hay kế hoạch\Ncủa tôi sẽ đơm hoa kết trái?
Dialogue: 0,0:22:35.55,0:22:39.92,Default,,0000,0000,0000,,Tôi đoán câu trả lời cho điều đó\Nphụ thuộc vào nhân tố X của chúng ta.
Dialogue: 0,0:22:40.29,0:22:41.88,Default,,0000,0000,0000,,Giờ thì, xin phép anh.
Dialogue: 0,0:22:41.88,0:22:43.88,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Đi tìm một thiên hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}nơi những ánh sao chiếu rọi rực rỡ nhất.
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Dù có một ngày
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}chúng ta lạc mất nhau giữa chốn hư vô...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Em vẫn sẽ không quên
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}nụ cười và hơi ấm của anh.
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Liệu em có thể cất tiếng hát
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}cho tới ngày được nghe thấy tiếng anh?
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Liệu em có thể cất tiếng hát
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}cho tới ngày được nghe thấy tiếng anh?
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Dù có một ngày
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}chúng ta lạc mất nhau giữa chốn hư vô...
