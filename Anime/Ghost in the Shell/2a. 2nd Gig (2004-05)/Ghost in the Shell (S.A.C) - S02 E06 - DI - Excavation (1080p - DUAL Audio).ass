Dialogue: 0,0:01:33.70,0:01:36.10,Default,,0000,0000,0000,,Một vụ giết người ngụy tạo\Nthành tai nạn giao thông sao?
Dialogue: 0,0:01:36.57,0:01:39.47,Default,,0000,0000,0000,,Theo những gì bên pháp y cung cấp,\Nkhả năng rất cao là...
Dialogue: 0,0:01:39.47,0:01:43.27,Default,,0000,0000,0000,,...nạn nhân đã bị tông đủ mạnh để chắc chắn\Nphá hủy hoàn toàn hộp sọ sinh học.
Dialogue: 0,0:01:43.84,0:01:48.51,Default,,0000,0000,0000,,Nhưng tài xế xe tải khai rằng không nhớ gì cả\Nvì đã ngủ gật sau tay lái?
Dialogue: 0,0:01:49.08,0:01:53.64,Default,,0000,0000,0000,,Bên ta đang rà soát não điện tử của tài xế để đề phòng,\Nnhưng chắc cũng chẳng thu được gì đâu.
Dialogue: 0,0:01:54.72,0:01:58.78,Default,,0000,0000,0000,,Vậy là cuộc điều tra vụ tống tiền\Nnhằm vào Bộ Năng lượng đã đi vào ngõ cụt rồi.
Dialogue: 0,0:02:00.29,0:02:03.32,Default,,0000,0000,0000,,Đó là nếu giả định người này\Nhành động đơn độc.
Dialogue: 0,0:02:03.63,0:02:07.03,Default,,0000,0000,0000,,Cơ thể cyborg của nạn nhân\Nlà mẫu Toyoda Chemicals 2902.
Dialogue: 0,0:02:07.36,0:02:10.39,Default,,0000,0000,0000,,Còn vỏ bọc não sinh học\Nlà dòng Dermo 2706 Mark 2.
Dialogue: 0,0:02:10.73,0:02:13.77,Default,,0000,0000,0000,,Cả hai đều không phải loại tối tân nhất,\Nnhưng là hàng nội địa mới sản xuất.
Dialogue: 0,0:02:13.77,0:02:17.17,Default,,0000,0000,0000,,Phần vỏ ngoài cũng là mẫu đại trà\Nkhông lắp thêm phụ kiện tùy chọn,
Dialogue: 0,0:02:17.17,0:02:19.18,Default,,0000,0000,0000,,nhưng chỉ riêng khuôn mặt là hàng\N{\i1}được đo ni đóng giày riêng.{\i0}
Dialogue: 0,0:02:19.18,0:02:21.18,Default,,0000,0000,0000,,Tuy nhiên, đánh giá từ mức độ\Nhao mòn tế bào,
Dialogue: 0,0:02:21.18,0:02:23.77,Default,,0000,0000,0000,,thì có vẻ khuôn mặt này là tàn tích còn sót lại\Ntừ lần đầu tiên anh ta được cơ khí hóa.
Dialogue: 0,0:02:24.45,0:02:27.35,Default,,0000,0000,0000,,Kiểu chắp vá từng phần như thế\Nkhá bất thường đối với một tên tội phạm.
Dialogue: 0,0:02:27.35,0:02:31.34,Default,,0000,0000,0000,,Đúng vậy. Và phương thức tống tiền của hắn\Nnghe chừng cũng khá thô sơ.
Dialogue: 0,0:02:32.72,0:02:37.68,Default,,0000,0000,0000,,Rất có thể thông tin về vụ bê bối\Ncủa Bộ Năng lượng chỉ là một đòn hù dọa.
Dialogue: 0,0:02:38.23,0:02:41.77,Default,,0000,0000,0000,,Dù vậy, hắn lại bị ám sát và ngụy tạo\Nthành tai nạn giao thông...
Dialogue: 0,0:02:41.77,0:02:43.93,Default,,0000,0000,0000,,...ngay trước thời điểm chúng ta\Ntiến hành bắt giữ.
Dialogue: 0,0:02:45.37,0:02:46.80,Default,,0000,0000,0000,,Biểu tượng khắc ở đây\Nlà gì vậy?
Dialogue: 0,0:02:46.80,0:02:49.86,Default,,0000,0000,0000,,Tôi nghĩ đó là huy hiệu của quận Shinjuku\Nthuộc thủ đô cũ.
Dialogue: 0,0:02:50.17,0:02:51.74,Default,,0000,0000,0000,,Khu vực đã bị chìm xuống biển\Ntrong cuộc chiến tranh đó ư?
Dialogue: 0,0:02:51.74,0:02:56.48,Default,,0000,0000,0000,,Chính xác. Vì lý do nào đó, vỏ não của hắn\Nđược phủ một lớp chì và thủy tinh bảo vệ.
Dialogue: 0,0:02:56.85,0:02:59.01,Default,,0000,0000,0000,,Chắc hẳn nó đã được khắc vào thời điểm\Nanh ta thực hiện việc bọc lớp bảo vệ đó.
Dialogue: 0,0:03:00.38,0:03:02.39,Default,,0000,0000,0000,,Đây là toàn bộ tư trang\Ntìm thấy trên người nạn nhân.
Dialogue: 0,0:03:02.39,0:03:05.15,Default,,0000,0000,0000,,Trên này có ghi thông tin liên lạc\Ncủa một ký giả.
Dialogue: 0,0:03:05.76,0:03:08.42,Default,,0000,0000,0000,,Nó sẽ cung cấp manh mối khi anh điều tra\Nxác minh danh tính của người đàn ông này.
Dialogue: 0,0:03:11.06,0:03:14.09,Default,,0000,0000,0000,,Đây là một chiếc nhẫn cưới\Nđúng không?
Dialogue: 0,0:03:24.07,0:03:27.98,Default,,0000,0000,0000,,Đúng là anh ta có để lại lời nhắn ở văn phòng tôi,\Nnói rằng muốn gặp trực tiếp.
Dialogue: 0,0:03:27.57,0:03:30.04,GitS Card,,0000,0000,0000,,{\pos(756,333)\frz9.499}Văn phòng Dobashi Fumiya
Dialogue: 0,0:03:27.57,0:03:30.04,GitS Card 2,,0000,0000,0000,,{\fn\fs38\frz9.302\pos(1186,569)} - Ký giả
Dialogue: 0,0:03:28.78,0:03:30.11,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:03:30.68,0:03:33.08,Default,,0000,0000,0000,,Ban đầu tôi thấy manh mối đó\Nkhá là đáng ngờ,
Dialogue: 0,0:03:33.48,0:03:36.61,Default,,0000,0000,0000,,nhưng anh ta gọi từ một trạm liên lạc\Ncông cộng ở Tokyo.
Dialogue: 0,0:03:37.09,0:03:40.32,Default,,0000,0000,0000,,Từ {\i1}Tokyo{\i0} sao? Vậy tin tức mà anh ta\Nmuốn cung cấp cho anh là gì?
Dialogue: 0,0:03:40.82,0:03:43.82,Default,,0000,0000,0000,,Một vụ bê bối nào đó liên quan tới\NBộ Năng lượng.
Dialogue: 0,0:03:44.19,0:03:48.19,Default,,0000,0000,0000,,Nếu tin mật báo nào anh cũng đi xác minh\Nthì chắc chẳng bao giờ làm xuể việc.
Dialogue: 0,0:03:48.43,0:03:51.34,Default,,0000,0000,0000,,Chúng tôi thường không gặp trực tiếp\Nnguồn tin của mình,
Dialogue: 0,0:03:51.34,0:03:53.80,Default,,0000,0000,0000,,nhưng anh ta quả quyết sẽ gửi cho tôi\Nthứ chứng minh câu chuyện của mình là thật.
Dialogue: 0,0:03:55.44,0:03:59.17,Default,,0000,0000,0000,,Hai vị ạ?\NKhu vực hút thuốc hay không hút thuốc?
Dialogue: 0,0:03:59.44,0:04:01.04,Default,,0000,0000,0000,,Xin mời đi lối này.
Dialogue: 0,0:04:05.62,0:04:07.24,Default,,0000,0000,0000,,Tấm phim đen kịt hoàn toàn...
Dialogue: 0,0:04:07.45,0:04:10.22,Default,,0000,0000,0000,,Đúng vậy. Tôi cứ ngỡ đó là bằng chứng\Nhình ảnh chụp được gì đó,
Dialogue: 0,0:04:10.22,0:04:11.92,Default,,0000,0000,0000,,nhưng nó đã bị\Nphơi sáng toàn bộ.
Dialogue: 0,0:04:12.22,0:04:15.49,Default,,0000,0000,0000,,Chắc anh ta nghĩ dữ liệu kỹ thuật số\Nsẽ dễ bị làm giả nên không chứng minh được gì.
Dialogue: 0,0:04:15.56,0:04:18.32,Default,,0000,0000,0000,,Thời buổi này hiếm người còn biết\Ncách xử lý phim nhựa truyền thống.
Dialogue: 0,0:04:18.80,0:04:20.99,Default,,0000,0000,0000,,Anh có phiền nếu tôi giữ lại\Nvật này không?
Dialogue: 0,0:04:21.27,0:04:24.17,Default,,0000,0000,0000,,Cứ tự nhiên nếu anh cần. Dù sao thì\Ntrên đó cũng chẳng nhìn thấy gì đâu.
Dialogue: 0,0:04:27.04,0:04:28.13,Default,,0000,0000,0000,,{\i1}Trưởng ban.{\i0}
Dialogue: 0,0:04:28.41,0:04:32.93,Default,,0000,0000,0000,,{\i1}Có vẻ người đàn ông đó đã ở Tokyo{\i0}\N{\i1}cho tới vài ngày trước khi bị sát hại,{\i0}
Dialogue: 0,0:04:33.34,0:04:36.80,Default,,0000,0000,0000,,{\i1}và anh ta đã gửi một cuộn phim bị phơi sáng{\i0}\N{\i1}cho ký giả đó từ nơi đây.{\i0}
Dialogue: 0,0:04:37.35,0:04:40.15,Default,,0000,0000,0000,,{\i1}Được rồi, cậu hãy tự mình{\i0}\N{\i1}đến Tokyo điều tra.{\i0}
Dialogue: 0,0:04:40.45,0:04:44.44,Default,,0000,0000,0000,,{\i1}Trong lúc cậu di chuyển, tôi sẽ tìm xem{\i0}\N{\i1}anh ta đã sử dụng trạm liên lạc công cộng nào.{\i0}
Dialogue: 0,0:04:44.92,0:04:46.51,Default,,0000,0000,0000,,{\i1}Một mình tôi thôi sao, thưa Trưởng ban?{\i0}
Dialogue: 0,0:04:46.92,0:04:50.83,Default,,0000,0000,0000,,{\i1}Những người khác vẫn đang bận làm nhiệm vụ{\i0}\N{\i1}bảo vệ cho Thủ tướng.{\i0}
Dialogue: 0,0:04:51.26,0:04:53.09,Default,,0000,0000,0000,,{\i1}Tôi sẽ cử một Tachikoma{\i0}\N{\i1}đi cùng hỗ trợ cậu.{\i0}
Dialogue: 0,0:04:53.66,0:04:55.72,Default,,0000,0000,0000,,{\i1}Liệu vấn đề phóng xạ ở đó{\i0}\N{\i1}có đáng ngại không ạ?{\i0}
Dialogue: 0,0:04:56.03,0:04:58.97,Default,,0000,0000,0000,,{\i1}Cậu nghĩ đã bao nhiêu năm trôi qua{\i0}\N{\i1}kể từ sau chiến tranh rồi hả?!{\i0}
Dialogue: 0,0:04:58.97,0:05:03.17,Default,,0000,0000,0000,,{\i1}Chưa từng ghi nhận dư lượng phóng xạ nào{\i0}\N{\i1}kể từ sau đợt phân tán \"Phép màu Nhật Bản\".{\i0}
Dialogue: 0,0:05:04.07,0:05:05.44,Default,,0000,0000,0000,,{\i1}Rõ, thưa Trưởng ban.{\i0}
Dialogue: 0,0:05:16.99,0:05:19.62,Default,,0000,0000,0000,,Tokyo mới... Tokyo mới.
Dialogue: 0,0:05:19.62,0:05:24.08,Default,,0000,0000,0000,,Thông báo chuyến tàu Etorufu số 3,\Nkhởi hành đi Berutarube đã đến.
Dialogue: 0,0:06:04.94,0:06:09.03,Default,,0000,0000,0000,,Nếu anh lo lắng về phóng xạ dư lượng,\Ntôi khuyên anh nên thay một cơ thể cyborg đi.
Dialogue: 0,0:06:10.01,0:06:13.64,Default,,0000,0000,0000,,Không, không phải chuyện đó.\NChỉ là linh cảm bất an thôi.
Dialogue: 0,0:06:13.81,0:06:15.01,Default,,0000,0000,0000,,Anh cảm thấy khó chịu trong người à?
Dialogue: 0,0:06:15.55,0:06:17.98,Default,,0000,0000,0000,,Nếu vậy, tôi có thể cho anh ngồi vào khoang\Ncủa tôi nếu anh muốn đấy!
Dialogue: 0,0:06:18.28,0:06:21.15,Default,,0000,0000,0000,,Làm thế chỉ tổ khiến tôi nôn nao hơn thôi.\NCứ trật tự mà bám sát tôi đi.
Dialogue: 0,0:06:22.15,0:06:23.64,Default,,0000,0000,0000,,Gì cơ chứ, tức ghê vậy đó!
Dialogue: 0,0:06:27.42,0:06:29.22,Default,,0000,0000,0000,,Hắn ta đã gọi điện từ chỗ này sao?
Dialogue: 0,0:06:56.15,0:06:57.75,Default,,0000,0000,0000,,Bác có từng nhìn thấy\Nngười đàn ông này không?
Dialogue: 0,0:06:58.46,0:06:59.79,Default,,0000,0000,0000,,Xin lỗi, tôi chưa thấy bao giờ.
Dialogue: 0,0:06:59.79,0:07:02.85,Default,,0000,0000,0000,,Tôi nghĩ anh ta đã thay cơ thể cyborg mới\Nở đâu đó quanh khu này.
Dialogue: 0,0:07:03.39,0:07:04.90,Default,,0000,0000,0000,,Về chuyện đó thì tôi chịu thôi.
Dialogue: 0,0:07:04.90,0:07:09.86,Default,,0000,0000,0000,,Dân cư quanh đây chỉ toàn dùng\Nnhững linh kiện rẻ tiền chất lượng kém nhất thôi.
Dialogue: 0,0:07:09.93,0:07:11.63,Default,,0000,0000,0000,,Đưa tôi nhìn thử xem nào.
Dialogue: 0,0:07:12.57,0:07:16.20,Default,,0000,0000,0000,,Dạo gần đây có nhiều người mất tích lắm.\NBiết đâu tôi lại nhận ra anh ta.
Dialogue: 0,0:07:16.77,0:07:18.01,Default,,0000,0000,0000,,Người đàn ông này đây.
Dialogue: 0,0:07:18.01,0:07:19.00,Default,,0000,0000,0000,,Để xem nào...
Dialogue: 0,0:07:19.64,0:07:22.18,Default,,0000,0000,0000,,Ồ, tôi có linh cảm đúng là\Nanh đang tìm người này rồi.
Dialogue: 0,0:07:22.18,0:07:23.34,Default,,0000,0000,0000,,Bác biết anh ta sao?
Dialogue: 0,0:07:23.41,0:07:26.58,Default,,0000,0000,0000,,Tôi không rõ danh tính hay gì đâu,\Nnhưng bốn năm hôm trước,
Dialogue: 0,0:07:26.58,0:07:30.31,Default,,0000,0000,0000,,có một gã mặc vest đen xuất hiện giữa cái lò lửa\N{\i1}chết tiệt này{\i0} để dò hỏi về anh ta.
Dialogue: 0,0:07:30.79,0:07:32.76,Default,,0000,0000,0000,,Mặt mũi gã đó trông dữ dằn\Nđến mức làm người ta đứng tim luôn đấy.
Dialogue: 0,0:07:33.39,0:07:38.09,Default,,0000,0000,0000,,Và mới ban nãy thôi, một cô gái trẻ cũng tới\Nkhu nhà trọ ổ chuột để hỏi tìm anh ta.
Dialogue: 0,0:07:38.96,0:07:41.93,Default,,0000,0000,0000,,Rốt cuộc gã đào hoa này\Nđã gây ra trò trống gì thế?
Dialogue: 0,0:07:42.23,0:07:43.77,Default,,0000,0000,0000,,Không có gì nghiêm trọng đâu ạ.
Dialogue: 0,0:07:43.77,0:07:44.79,Default,,0000,0000,0000,,Cảm ơn bác nhiều nhé.
Dialogue: 0,0:07:46.24,0:07:47.23,Default,,0000,0000,0000,,Xin thứ lỗi.
Dialogue: 0,0:07:48.91,0:07:51.24,Default,,0000,0000,0000,,Các cậu có biết ai tên là\NKanji Kotan không?
Dialogue: 0,0:07:52.44,0:07:54.21,Default,,0000,0000,0000,,Biết chứ, bọn tôi biết anh ta mà.
Dialogue: 0,0:07:54.51,0:07:55.71,Default,,0000,0000,0000,,Thật sao?
Dialogue: 0,0:07:56.01,0:07:57.71,Default,,0000,0000,0000,,Thật mà. Đi theo bọn này.
Dialogue: 0,0:08:15.87,0:08:20.43,Default,,0000,0000,0000,,Biết ngay mà... Vớ bở được con mồi béo bở\Nngàn năm có một thế này.
Dialogue: 0,0:08:22.57,0:08:24.54,Default,,0000,0000,0000,,Hả? Anh Togusa?
Dialogue: 0,0:08:27.34,0:08:28.54,Default,,0000,0000,0000,,Sợi dây cáp...
Dialogue: 0,0:08:31.62,0:08:33.41,Default,,0000,0000,0000,,Tôi nghĩ nó đứt rồi.
Dialogue: 0,0:08:58.08,0:09:00.48,Default,,0000,0000,0000,,Nếu không muốn bị thương\Nthì biến xéo ngay!
Dialogue: 0,0:09:05.85,0:09:06.94,Default,,0000,0000,0000,,Cô có sao không?
Dialogue: 0,0:09:18.96,0:09:21.03,Default,,0000,0000,0000,,{\i1}Về người đàn ông đã liên lạc{\i0}\N{\i1}với ký giả Dobashi,{\i0}
Dialogue: 0,0:09:21.03,0:09:27.20,Default,,0000,0000,0000,,{\i1}tôi đã xác minh được một người tên Kanji Kotan{\i0}\N{\i1}từng sinh sống tại Khu Tị nạn Kanto.{\i0}
Dialogue: 0,0:09:27.70,0:09:28.77,Default,,0000,0000,0000,,Ồ, cậu tìm ra rồi à?
Dialogue: 0,0:09:28.77,0:09:32.78,Default,,0000,0000,0000,,Để chắc chắn, tôi đã đưa chiếc nhẫn và ảnh của nạn nhân\Ncho người phụ nữ mà tôi vừa giải cứu xem,
Dialogue: 0,0:09:32.78,0:09:35.30,Default,,0000,0000,0000,,cô ấy khẳng định cả hai\Nđều đích thị là của Kotan.
Dialogue: 0,0:09:35.78,0:09:37.04,Default,,0000,0000,0000,,{\i1}Cô ta là ai thế?{\i0}
Dialogue: 0,0:09:37.35,0:09:42.05,Default,,0000,0000,0000,,Asagi Ruriko. Cô ấy nói từng làm việc cho\Nmột tổ chức phi chính phủ cứu trợ tị nạn hai năm trước,
Dialogue: 0,0:09:42.75,0:09:45.15,Default,,0000,0000,0000,,và đó là nơi cô ấy\Ngặp gỡ Kotan.
Dialogue: 0,0:09:46.49,0:09:51.79,Default,,0000,0000,0000,,Họ vẫn giữ liên lạc sau khi cô ấy rời đi,\Nvà thậm chí sau đó đã đính hôn với nhau,
Dialogue: 0,0:09:52.50,0:09:55.73,Default,,0000,0000,0000,,nhưng cô ấy đã mất liên lạc với anh ta\Ntừ ba tháng trước.
Dialogue: 0,0:09:56.43,0:10:00.20,Default,,0000,0000,0000,,Có vẻ cô ấy đã lặn lội từ Akita lên Tokyo\Nđể tìm anh ta...
Dialogue: 0,0:10:00.67,0:10:04.33,Default,,0000,0000,0000,,...sau khi bất ngờ nhận được một email từ biệt\Ncủa anh ta gửi cách đây một tuần.
Dialogue: 0,0:10:04.78,0:10:07.80,Default,,0000,0000,0000,,{\i1}Tôi rõ rồi. Hãy tiếp tục lấy lời khai{\i0}\N{\i1}từ người phụ nữ đó.{\i0}
Dialogue: 0,0:10:07.91,0:10:09.04,Default,,0000,0000,0000,,Rõ, thưa Trưởng ban.
Dialogue: 0,0:10:21.26,0:10:22.66,Default,,0000,0000,0000,,Cô thấy đỡ hơn chưa?
Dialogue: 0,0:10:35.57,0:10:38.13,Default,,0000,0000,0000,,Anh Kotan đã chết rồi,\Nphải không anh?
Dialogue: 0,0:10:40.21,0:10:43.27,Default,,0000,0000,0000,,Chiếc nhẫn này là do anh Kotan tặng tôi.
Dialogue: 0,0:10:43.75,0:10:46.74,Default,,0000,0000,0000,,Anh ấy nói tặng nó vì sắp tới sẽ có thể\Nrời khỏi Thị trấn Tị nạn.
Dialogue: 0,0:10:48.89,0:10:51.99,Default,,0000,0000,0000,,Nhưng khi anh ấy nộp hồ sơ\Nxin cấp thẻ căn cước,
Dialogue: 0,0:10:51.99,0:10:54.18,Default,,0000,0000,0000,,cơ thể cyborg của Kotan đã bị đánh trượt\Ntrong vòng kiểm định.
Dialogue: 0,0:10:54.49,0:10:57.89,Default,,0000,0000,0000,,Nó không đáp ứng được các tiêu chuẩn\Nhiệu năng tối thiểu quy định.
Dialogue: 0,0:10:58.53,0:11:03.52,Default,,0000,0000,0000,,Kể từ lúc biết chuyện đó,\NKotan bắt đầu lảng tránh tôi.
Dialogue: 0,0:11:04.07,0:11:08.50,Default,,0000,0000,0000,,Có lẽ anh ấy nghĩ tôi đã cố tình giấu giếm\Ntiêu chuẩn đó với anh ấy.
Dialogue: 0,0:11:09.07,0:11:11.20,Default,,0000,0000,0000,,Cô không liên lạc lại\Nđược với anh ấy sao?
Dialogue: 0,0:11:11.68,0:11:16.98,Default,,0000,0000,0000,,Tôi đã gọi cho anh ấy vô số lần. Tôi bảo rằng sẽ\Nhỗ trợ anh ấy mua một cơ thể cyborg mới.
Dialogue: 0,0:11:18.05,0:11:20.24,Default,,0000,0000,0000,,Nhưng anh ấy đã khước từ\Nlời đề nghị đó.
Dialogue: 0,0:11:21.32,0:11:25.78,Default,,0000,0000,0000,,Khi thi thể được phát hiện ở Niihama, Kotan đã\Nhoán đổi sang một cơ thể nội địa đời mới rồi.
Dialogue: 0,0:11:26.42,0:11:29.05,Default,,0000,0000,0000,,Anh ấy chưa bao giờ nói gì\Nvề chuyện đó với cô ư?
Dialogue: 0,0:11:29.73,0:11:31.89,Default,,0000,0000,0000,,Không, anh ấy chưa từng\Nkể cho tôi nghe.
Dialogue: 0,0:11:32.10,0:11:33.43,Default,,0000,0000,0000,,Tôi hiểu rồi...
Dialogue: 0,0:11:40.04,0:11:44.50,Default,,0000,0000,0000,,Vấn đề là, trước khi chết, anh ta đang nằm trong\Ndiện tình nghi về hành vi...
Dialogue: 0,0:11:44.81,0:11:47.44,Default,,0000,0000,0000,,...đe dọa tống tiền một cơ quan chính phủ\Nđể lấy một món tiền lớn.
Dialogue: 0,0:11:48.88,0:11:52.75,Default,,0000,0000,0000,,Lời kể của cô làm tôi nghĩ rằng có thể\NKotan nảy ra ý định tống tiền...
Dialogue: 0,0:11:52.75,0:11:57.08,Default,,0000,0000,0000,,...để kiếm tiền mua một cơ thể mới, nhưng anh ta\Nđã hoán đổi cơ thể từ trước đó rồi.
Dialogue: 0,0:11:57.52,0:12:02.19,Default,,0000,0000,0000,,Tại sao anh ta lại tống tiền họ {\i1}sau khi{\i0}\Nđã có được cơ thể cyborg mới chứ?
Dialogue: 0,0:12:02.53,0:12:08.23,Default,,0000,0000,0000,,Kotan có thể đã có một số phận cay đắng nghiệt ngã,\Nnhưng anh ấy không bao giờ làm điều phạm pháp.
Dialogue: 0,0:12:08.83,0:12:10.03,Default,,0000,0000,0000,,Có lẽ là vậy.
Dialogue: 0,0:12:10.33,0:12:13.27,Default,,0000,0000,0000,,Nhưng cái chết của Kotan\Nrất có thể không phải là một vụ tai nạn.
Dialogue: 0,0:12:13.27,0:12:15.74,Default,,0000,0000,0000,,Mà anh ta đã bị ai đó\Nsát hại bịt đầu mối.
Dialogue: 0,0:12:17.04,0:12:22.03,Default,,0000,0000,0000,,Chắc chắn đã có chuyện gì đó xảy ra với anh ta\Ntrong ba tháng hai người bặt vô âm tín.
Dialogue: 0,0:12:24.41,0:12:26.54,Default,,0000,0000,0000,,Ngày mai chúng ta đến khu trọ ổ chuột\Nkiểm tra xem sao nhé?
Dialogue: 0,0:12:36.73,0:12:39.13,Default,,0000,0000,0000,,Chuyện xảy ra chừng một tháng trước,\Ntôi nhớ là vậy.
Dialogue: 0,0:12:39.50,0:12:44.16,Default,,0000,0000,0000,,Có tin đồn râm ran rằng có ai đó đang tuyển\Nrất nhiều nhân công sở hữu cơ thể toàn phần cyborg.
Dialogue: 0,0:12:44.94,0:12:48.37,Default,,0000,0000,0000,,Và họ bảo rằng bất kỳ ai sẵn sàng\Ntiến sâu vào bên trong Uchikan 7...
Dialogue: 0,0:12:48.37,0:12:51.14,Default,,0000,0000,0000,,...sẽ được nhận một cơ thể cyborg xịn\Nhoàn toàn miễn phí.
Dialogue: 0,0:12:51.31,0:12:52.30,Default,,0000,0000,0000,,Miễn phí sao?
Dialogue: 0,0:12:52.38,0:12:53.81,Default,,0000,0000,0000,,Ừ, đúng thế.
Dialogue: 0,0:12:53.81,0:12:56.14,Default,,0000,0000,0000,,Uchikan 7 ư?\NNơi đó là chỗ nào thế?
Dialogue: 0,0:12:56.51,0:12:58.98,Default,,0000,0000,0000,,Đó là một trong những\Nkhu vực chìm ngập dưới lòng đất.
Dialogue: 0,0:12:58.98,0:13:02.45,Default,,0000,0000,0000,,Nhưng tôi chưa từng nghe thấy ai thực sự\N{\i1}nhận được{\i0} cơ thể cyborg đó cả,
Dialogue: 0,0:13:02.45,0:13:05.82,Default,,0000,0000,0000,,nên có khi đấy cũng chỉ là\Nmột tin đồn nhảm nhí thôi.
Dialogue: 0,0:13:06.42,0:13:09.42,Default,,0000,0000,0000,,Người đàn ông này quả thực\N{\i1}đã được cấp{\i0} cơ thể mới đấy.
Dialogue: 0,0:13:11.46,0:13:15.92,Default,,0000,0000,0000,,Này các bác! Có ai ở đây biết câu chuyện\Nđược nhận cơ thể cyborg miễn phí không?!
Dialogue: 0,0:13:16.37,0:13:19.63,Default,,0000,0000,0000,,Hai người này bảo là anh chàng này thực sự\N{\i1}đã được đổi{\i0} cơ thể toàn phần đấy!
Dialogue: 0,0:13:27.18,0:13:28.17,Default,,0000,0000,0000,,Này cậu kia!
Dialogue: 0,0:13:40.92,0:13:44.12,Default,,0000,0000,0000,,Nếu không nhờ có Giáo sư,\Nthì tôi đã không còn sống đến ngày hôm nay.
Dialogue: 0,0:13:44.43,0:13:45.52,Default,,0000,0000,0000,,Giáo sư ư?
Dialogue: 0,0:13:45.83,0:13:47.09,Default,,0000,0000,0000,,Phải...
Dialogue: 0,0:13:47.26,0:13:50.43,Default,,0000,0000,0000,,Bác ấy đã chỉ dạy cho tôi đủ mọi thứ\Nkhi còn ở Uchikan 7.
Dialogue: 0,0:13:51.40,0:13:53.43,Default,,0000,0000,0000,,Chuyện gì đã xảy ra ở đó thế?
Dialogue: 0,0:13:53.70,0:13:58.47,Default,,0000,0000,0000,,Thú thật bản thân tôi cũng chẳng rõ. Tôi chỉ biết\Ncắm đầu làm theo những gì họ sai bảo.
Dialogue: 0,0:13:59.01,0:14:00.87,Default,,0000,0000,0000,,Cậu có nhớ bên nào\Nđã thuê các cậu không?
Dialogue: 0,0:14:01.44,0:14:05.07,Default,,0000,0000,0000,,Một đơn vị tên là Điện lực Kuromatsu\Nhay đại loại thế.
Dialogue: 0,0:14:05.42,0:14:09.02,Default,,0000,0000,0000,,Họ bảo bọn tôi đến khai quật một công trình\Nđã bị chôn vùi từ thời chiến tranh,
Dialogue: 0,0:14:09.65,0:14:14.65,Default,,0000,0000,0000,,và bọn tôi phải lặn xuống rất sâu, nên họ yêu cầu\Nchỉ tiếp nhận những ai đã cơ khí hóa toàn phần.
Dialogue: 0,0:14:18.26,0:14:23.60,Default,,0000,0000,0000,,Quy định là phải đạt ít nhất 98% cơ thể cyborg,\Nnên ban đầu tôi đã từ bỏ ý định,
Dialogue: 0,0:14:24.00,0:14:28.49,Default,,0000,0000,0000,,nhưng tôi đã lén nhờ bác sĩ chợ đen làm giả\Nbảng tỷ lệ cơ khí hóa của mình để chui vào.
Dialogue: 0,0:14:28.81,0:14:31.27,Default,,0000,0000,0000,,Có phải biểu tượng này đã được khắc\Ntrên những cơ thể cyborg đó không?
Dialogue: 0,0:14:31.84,0:14:34.87,Default,,0000,0000,0000,,Đúng rồi. Trên tất cả cơ thể\Nđều có khắc dấu đó.
Dialogue: 0,0:14:35.98,0:14:40.71,Default,,0000,0000,0000,,Giáo sư lúc đó đã rất vui mừng vì được hoán đổi\Nsang một cơ thể cyborg mới toanh.
Dialogue: 0,0:14:42.39,0:14:45.05,Default,,0000,0000,0000,,Nhưng người ta chẳng bao giờ biết chắc\Nmình có thực sự nhận được cơ thể mới hay không,
Dialogue: 0,0:14:45.36,0:14:48.76,Default,,0000,0000,0000,,vì làm sao tự nhìn thấy\Nvỏ bọc não bộ của chính mình cơ chứ.
Dialogue: 0,0:14:50.56,0:14:56.36,Default,,0000,0000,0000,,Thế là cuối cùng, họ tập hợp khoảng 40 công nhân\Nnhư bọn tôi lại, rồi đưa sâu xuống lòng đất.
Dialogue: 0,0:14:57.47,0:15:00.99,Default,,0000,0000,0000,,Chắc ngoài tôi ra thì cũng có nhiều tay khác\Nlàm giả tỷ lệ cơ khí hóa của mình.
Dialogue: 0,0:15:01.84,0:15:05.21,Default,,0000,0000,0000,,Dù sao thì tôi cũng được phân cặp với Giáo sư,\Nvà bọn tôi bắt đầu làm việc.
Dialogue: 0,0:15:05.21,0:15:07.57,Default,,0000,0000,0000,,Công việc đó hình như gọi là\N\"cạo lớp cặn bám\" thì phải.
Dialogue: 0,0:15:08.78,0:15:12.68,Default,,0000,0000,0000,,Bọn tôi có đeo mặt nạ chống bụi, nhưng người ngợm\Nvẫn đen nhẻm như than, cả lỗ mũi cũng thế.
Dialogue: 0,0:15:13.22,0:15:17.18,Default,,0000,0000,0000,,Giáo sư bảo tôi sẽ ổn nếu chịu cắt bỏ\Ncác thụ thể cảm giác,
Dialogue: 0,0:15:17.65,0:15:20.71,Default,,0000,0000,0000,,nhưng tôi bảo tôi đâu thể làm thế\Nvì tôi đâu phải người máy sinh học toàn phần.
Dialogue: 0,0:15:21.29,0:15:24.02,Default,,0000,0000,0000,,Nghe tôi nói vậy, sắc mặt bác ấy\Nbỗng trở nên vô cùng đáng sợ...
Dialogue: 0,0:15:24.33,0:15:27.13,Default,,0000,0000,0000,,...rồi bác ấy bảo nếu tôi không mau chóng\Nchuồn khỏi đó thì tôi sẽ chết mất xác.
Dialogue: 0,0:15:27.96,0:15:32.87,Default,,0000,0000,0000,,Nhưng vì quá hám tiền,\Nnên tôi đã phớt lờ lời cảnh báo đó.
Dialogue: 0,0:15:33.64,0:15:39.01,Default,,0000,0000,0000,,Thế nên Giáo sư đã đưa cho tôi mảnh phim này và dặn rằng\Nnếu nó chuyển sang màu đen thì phải lập tức tháo chạy.
Dialogue: 0,0:15:41.28,0:15:45.18,Default,,0000,0000,0000,,Và rồi, đúng ngày làm việc thứ tư,\Nmọi địa ngục bắt đầu bùng nổ.
Dialogue: 0,0:15:47.18,0:15:49.99,Default,,0000,0000,0000,,Còi báo động rú lên inh ỏi khắp nơi, và ngay lúc\Ntôi còn đang ngơ ngác không hiểu chuyện gì xảy ra,
Dialogue: 0,0:15:49.99,0:15:55.19,Default,,0000,0000,0000,,thì thấy mấy người trông như kỹ thuật viên\Nđược khiêng trên cáng từ sâu bên trong ra.
Dialogue: 0,0:15:57.73,0:16:02.13,Default,,0000,0000,0000,,Đó là lúc tôi mới sực nhận ra\Ncông việc này thực sự nguy hiểm đến tính mạng.
Dialogue: 0,0:16:04.17,0:16:05.79,Default,,0000,0000,0000,,Và cậu đã bỏ trốn\Nvào lúc đó sao?
Dialogue: 0,0:16:06.44,0:16:07.46,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:16:09.17,0:16:12.47,Default,,0000,0000,0000,,Chớp mắt một cái,\Nmột đám người mặc đồ đen đã ập vào.
Dialogue: 0,0:16:13.51,0:16:16.91,Default,,0000,0000,0000,,Tôi và Giáo sư may mắn\Nthoát được ra ngoài,
Dialogue: 0,0:16:17.31,0:16:20.35,Default,,0000,0000,0000,,nhưng khi ngoái đầu nhìn lại\Ntrong lúc cắm đầu chạy,
Dialogue: 0,0:16:20.35,0:16:25.41,Default,,0000,0000,0000,,những người làm cùng bọn tôi đã bị nhốt kín\Nsau những cánh cửa thép khổng lồ.
Dialogue: 0,0:16:27.02,0:16:29.22,Default,,0000,0000,0000,,Sau đó thì Kotan\Nra sao rồi?
Dialogue: 0,0:16:30.06,0:16:35.52,Default,,0000,0000,0000,,Bác ấy lẩm bẩm điều gì đó về việc phải cho cả thế giới biết\Nnhững gì bác ấy đã tận mắt chứng kiến dưới đường hầm,
Dialogue: 0,0:16:36.23,0:16:38.06,Default,,0000,0000,0000,,rồi sau đó biến mất không dấu vết.
Dialogue: 0,0:16:43.37,0:16:46.31,Default,,0000,0000,0000,,Cậu có thể dẫn bọn tôi\Nđến khu Uchikan 7 đó không?
Dialogue: 0,0:16:46.58,0:16:50.41,Default,,0000,0000,0000,,Nói đùa à! Cho tiền tôi cũng chẳng thèm\Nquay lại cái chỗ chết tiệt đó đâu!
Dialogue: 0,0:16:50.71,0:16:52.45,Default,,0000,0000,0000,,Chỉ cần dẫn đường một đoạn thôi cũng được.
Dialogue: 0,0:16:52.45,0:16:56.94,Default,,0000,0000,0000,,Làm ơn đi. Tôi muốn biết rốt cuộc\NKotan đã nhìn thấy thứ gì ở đó.
Dialogue: 0,0:17:11.43,0:17:12.83,Default,,0000,0000,0000,,Lực lượng Phòng vệ Mặt đất đóng quân ở dưới đó...
Dialogue: 0,0:17:13.57,0:17:16.97,Default,,0000,0000,0000,,Lúc tôi trốn thoát thì hàng rào thép gai này\Nvẫn chưa có ở đây.
Dialogue: 0,0:17:23.11,0:17:25.71,Default,,0000,0000,0000,,Nếu chui qua lối này, anh sẽ có thể\Ntiếp cận được khu vực đó.
Dialogue: 0,0:17:26.28,0:17:28.48,Default,,0000,0000,0000,,Xin lỗi nhé, tôi chỉ có thể\Ndẫn anh đến đây thôi.
Dialogue: 0,0:17:28.72,0:17:30.52,Default,,0000,0000,0000,,Không sao đâu.\NCảm ơn cậu nhiều.
Dialogue: 0,0:18:20.67,0:18:22.00,Default,,0000,0000,0000,,Chỗ này là...
Dialogue: 0,0:18:27.81,0:18:29.14,Default,,0000,0000,0000,,Giáp chiến đấu bọc thép!
Dialogue: 0,0:18:54.30,0:18:55.33,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:18:58.68,0:19:00.14,Default,,0000,0000,0000,,Nhảy xuống! Mau lên!
Dialogue: 0,0:19:03.21,0:19:04.20,Default,,0000,0000,0000,,Nhanh nào!
Dialogue: 0,0:20:46.28,0:20:48.15,Default,,0000,0000,0000,,Anh không sao chứ, anh Togusa?
Dialogue: 0,0:20:48.52,0:20:49.62,Default,,0000,0000,0000,,Tachikoma đấy à?
Dialogue: 0,0:20:49.62,0:20:50.68,Default,,0000,0000,0000,,Tuyệt cú mèo chưa!
Dialogue: 0,0:21:14.04,0:21:18.65,Default,,0000,0000,0000,,Thông báo chuyến tàu Mirai 52,\Nkhởi hành đi Fukuoka Mới chuẩn bị rời ga.
Dialogue: 0,0:21:18.65,0:21:23.35,Default,,0000,0000,0000,,Kotan biết rõ những rủi ro đó, nhưng anh ấy chấp nhận dấn thân\Nchỉ để có cơ hội được ở bên cô.
Dialogue: 0,0:21:24.12,0:21:28.18,Default,,0000,0000,0000,,Nhưng tình cờ thay, anh ấy lại đủ kiến thức chuyên môn\Nđể nhận ra bản chất thực sự của công trình đó,
Dialogue: 0,0:21:28.69,0:21:30.32,Default,,0000,0000,0000,,và vì thế mà anh ấy\Nđã bị sát hại.
Dialogue: 0,0:21:31.39,0:21:34.53,Default,,0000,0000,0000,,Tôi sẽ ghé qua nhà một lát,\Nrồi tới tiếp nhận thi thể của anh ấy.
Dialogue: 0,0:21:34.53,0:21:37.76,Default,,0000,0000,0000,,Được rồi. Nếu gặp bất kỳ rắc rối nào,\Nhãy gọi cho tôi ngay lập tức.
Dialogue: 0,0:21:38.33,0:21:39.77,Default,,0000,0000,0000,,Tôi nhớ rồi.
Dialogue: 0,0:21:49.55,0:21:53.58,Default,,0000,0000,0000,,{\i1}Kotan đã vô tình phát hiện ra sự cố tại một nhà máy{\i0}\N{\i1}hạt nhân ngầm được giấu kín bên trong công trình đó...{\i0}
Dialogue: 0,0:21:53.58,0:21:56.18,Default,,0000,0000,0000,,{\i1}...và dùng thông tin đó{\i0}\N{\i1}để đe dọa Bộ Năng lượng.{\i0}
Dialogue: 0,0:21:56.59,0:22:00.69,Default,,0000,0000,0000,,{\i1}Tuy nhiên, cũng rất có thể anh ta đã thực sự muốn{\i0}\N{\i1}vạch trần vụ bê bối này ra ánh sáng trước công chúng.{\i0}
Dialogue: 0,0:22:00.69,0:22:02.32,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:22:02.73,0:22:06.40,Default,,0000,0000,0000,,Tôi phỏng đoán rằng lò phản ứng đã gặp sự cố\Ntrong lúc bọn chúng đang thi công,
Dialogue: 0,0:22:06.40,0:22:09.33,Default,,0000,0000,0000,,rồi chúng vội vã tiến hành lấp liếm\Nchôn vùi mọi dấu vết,
Dialogue: 0,0:22:09.33,0:22:11.93,Default,,0000,0000,0000,,nhưng có vẻ bên quân đội\Nlại hoàn toàn không hay biết gì về tình hình này.
Dialogue: 0,0:22:12.14,0:22:17.17,Default,,0000,0000,0000,,{\i1}Vấn đề cốt lõi ở đây là: Công trình thời tiền chiến đó{\i0}\N{\i1}được khai quật dưới lệnh của ai,{\i0}
Dialogue: 0,0:22:17.17,0:22:18.78,Default,,0000,0000,0000,,{\i1}và với mục đích thực sự là gì?{\i0}
Dialogue: 0,0:22:18.78,0:22:20.40,Default,,0000,0000,0000,,Những gã mặc âu phục đen đó...
Dialogue: 0,0:22:21.68,0:22:26.21,Default,,0000,0000,0000,,{\i1}Có vẻ câu chuyện này vẫn còn nhiều uẩn khúc.{\i0}\N{\i1}Khi trở về, cậu hãy lập bản báo cáo chi tiết.{\i0}
Dialogue: 0,0:22:26.52,0:22:27.61,Default,,0000,0000,0000,,Rõ, thưa Trưởng ban.
Dialogue: 0,0:22:27.61,0:22:29.61,Default,,0000,0000,0000,,
Dialogue: 0,0:23:10.68,0:23:13.18,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:13.18,0:23:17.14,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:17.33,0:23:19.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:19.80,0:23:23.79,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:23.79,0:23:27.80,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:27.80,0:23:31.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:31.09,0:23:35.60,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:35.60,0:23:37.09,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:37.09,0:23:39.79,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:39.79,0:23:43.73,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:43.73,0:23:46.24,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:46.24,0:23:49.77,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:49.77,0:23:53.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:53.11,0:23:57.91,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:57.91,0:24:03.72,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:03.72,0:24:06.42,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:06.42,0:24:10.36,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:24:10.36,0:24:12.87,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:24:12.87,0:24:16.40,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:24:16.40,0:24:19.74,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:24:19.74,0:24:24.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
