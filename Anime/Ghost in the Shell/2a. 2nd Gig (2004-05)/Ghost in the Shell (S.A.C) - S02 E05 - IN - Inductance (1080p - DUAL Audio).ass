Dialogue: 0,0:02:01.53,0:02:05.49,GitS Signs B/W,,0000,0000,0000,,{\fs46\pos(986,853)}Thủ tướng Thị sát Khu Lưu trú Người tị nạn \"Trại Dejima\" tại Nagasaki
Dialogue: 0,0:02:04.24,0:02:05.84,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}và liệu họ có được cấp phát{\i0}\N{\i1}hộ chiếu Nhật Bản hay không.{\i0}
Dialogue: 0,0:02:06.35,0:02:10.58,Top Secondary Dialog 1080P,,0000,0000,0000,,{\i1}Và tiếp theo là bản tin tài chính.{\i0}\N{\i1}Như vừa được công bố mới đây...{\i0}
Dialogue: 0,0:02:20.26,0:02:23.26,GitS List,,0000,0000,0000,,{\fs95\pos(960,1055)}Tổ chức Giải phóng Người tị nạn
Dialogue: 0,0:02:31.27,0:02:33.31,Default,,0000,0000,0000,,Đây là bản sao bức thư\Nđược tìm thấy trong bó hoa...
Dialogue: 0,0:02:33.31,0:02:36.24,Default,,0000,0000,0000,,...mà Thủ tướng đã nhận được\Ntrong chuyến đi thị sát của bà ấy.
Dialogue: 0,0:02:36.71,0:02:38.38,Default,,0000,0000,0000,,Chúng tôi vẫn chưa nhận được báo cáo\Ntừ phòng giám định pháp y,
Dialogue: 0,0:02:38.38,0:02:41.14,Default,,0000,0000,0000,,nhưng họ nói rằng khó có khả năng\Ntìm thấy dấu vân tay hay bất kỳ dấu vết nào trên đó.
Dialogue: 0,0:02:42.21,0:02:45.95,Default,,0000,0000,0000,,Một lá thư đe dọa ám chỉ rằng\NThủ tướng sẽ bị ám sát, hả?
Dialogue: 0,0:02:47.02,0:02:48.75,Default,,0000,0000,0000,,Thế còn biểu tượng này là gì?
Dialogue: 0,0:02:49.19,0:02:53.75,Default,,0000,0000,0000,,Chúng tôi không rõ. Chúng tôi tưởng rằng\Nông có thể biết đôi chút manh mối.
Dialogue: 0,0:02:54.09,0:02:58.22,Default,,0000,0000,0000,,Nhìn bề ngoài thế này, tôi cho rằng đó là tên riêng\Ncủa một tổ chức hay thứ gì đó tương tự.
Dialogue: 0,0:02:58.50,0:03:02.37,Default,,0000,0000,0000,,Chính xác. Sự thật là trong số các vụ khủng bố khác nhau\Nmà Cơ quan Cảnh sát Quốc gia...
Dialogue: 0,0:03:02.37,0:03:08.44,Default,,0000,0000,0000,,...vẫn luôn theo dõi sát sao kể từ sau vụ đánh chiếm\NĐại sứ quán Trung Quốc,
Dialogue: 0,0:03:08.44,0:03:12.40,Default,,0000,0000,0000,,chúng tôi đã phát hiện bảy trường hợp sử dụng biểu tượng y hệt\Ntrong các tuyên bố nhận trách nhiệm.
Dialogue: 0,0:03:13.15,0:03:17.67,Default,,0000,0000,0000,,Gần đây chúng tôi cũng phát hiện ra nó trên một bức thư\Nde dọa gửi tới Tòa soạn Báo Nanyou Shimbun...
Dialogue: 0,0:03:18.08,0:03:20.42,Default,,0000,0000,0000,,...và trong lá thư cảnh báo ám sát gửi tới Thủ tướng này.
Dialogue: 0,0:03:21.12,0:03:24.09,Default,,0000,0000,0000,,Chín vụ án đó có điểm gì\Nchung với nhau không?
Dialogue: 0,0:03:24.36,0:03:26.69,Default,,0000,0000,0000,,Cho đến nay chúng tôi vẫn chưa\Ntìm thấy điểm chung nào cả.
Dialogue: 0,0:03:26.69,0:03:28.79,Default,,0000,0000,0000,,Phải thừa nhận rằng, đã có sự thiếu sót trong việc trao đổi thông tin...
Dialogue: 0,0:03:28.79,0:03:31.46,Default,,0000,0000,0000,,...giữa các điều tra viên cảnh sát tỉnh phụ trách\Ncác vụ án khác nhau,
Dialogue: 0,0:03:31.46,0:03:36.42,Default,,0000,0000,0000,,nhưng động cơ phạm tội và bối cảnh tư tưởng\Ncủa mỗi vụ lại có đôi chút khác biệt.
Dialogue: 0,0:03:36.87,0:03:41.86,Default,,0000,0000,0000,,Và quan trọng nhất là nội dung của mỗi bức thư\Nđều mang dáng dấp của những tội ác độc lập.
Dialogue: 0,0:03:42.34,0:03:45.68,Default,,0000,0000,0000,,Nhưng giờ đây khi nhận thấy chúng\Ncó chung biểu tượng này,
Dialogue: 0,0:03:45.68,0:03:49.58,Default,,0000,0000,0000,,chúng tôi đang gấp rút xếp chuỗi sự việc này\Nvào diện Đại án Nghiêm trọng Cấp Quốc gia.
Dialogue: 0,0:03:50.02,0:03:52.78,Default,,0000,0000,0000,,Có khả năng nào đây là hành vi phạm tội tìm cảm giác mạnh\Nhay bắt chước theo trào lưu không?
Dialogue: 0,0:03:52.99,0:03:55.22,Default,,0000,0000,0000,,Ở thời điểm này, chúng tôi\Nkhông nghĩ điều đó có thể xảy ra.
Dialogue: 0,0:03:55.22,0:03:59.88,Default,,0000,0000,0000,,Chỉ có một số ít người biết về biểu tượng đó,\Nngay cả trong nội bộ lực lượng cảnh sát.
Dialogue: 0,0:04:00.23,0:04:02.93,Default,,0000,0000,0000,,Nó cũng chưa từng được đề cập\Ntrong các thông cáo báo chí của chúng tôi.
Dialogue: 0,0:04:02.93,0:04:06.67,Default,,0000,0000,0000,,Nếu những gì ông nói là thật, thì lời giải thích duy nhất còn lại\Nlà cả chín vụ đó đều phải là...
Dialogue: 0,0:04:06.67,0:04:09.90,Default,,0000,0000,0000,,...các cuộc tấn công khủng bố đồng loạt nhiều nơi do một tổ chức duy nhất tiến hành dưới vỏ bọc các tội ác độc lập.
Dialogue: 0,0:04:10.14,0:04:13.51,Default,,0000,0000,0000,,Đây là giai đoạn mở màn của một hành vi khủng bố\Nkiểu \"Kẻ Cười Tươi\"...
Dialogue: 0,0:04:13.51,0:04:16.07,Default,,0000,0000,0000,,...vốn đang lợi dụng một dạng thông tin nào đó\Nlàm vật trung gian.
Dialogue: 0,0:04:17.61,0:04:20.58,Default,,0000,0000,0000,,Dù sao đi nữa, việc Thủ tướng bị cản trở\Nthực hiện các công vụ...
Dialogue: 0,0:04:20.58,0:04:23.07,Default,,0000,0000,0000,,...hoàn toàn không có lợi cho chúng ta.
Dialogue: 0,0:04:23.28,0:04:24.81,Default,,0000,0000,0000,,Thế còn tình trạng sức khỏe\Ncủa Thủ tướng?
Dialogue: 0,0:04:25.12,0:04:28.95,Default,,0000,0000,0000,,Đó chỉ là câu chuyện ngụy tạo mà chúng tôi đưa ra cho truyền thông\Nđể đánh lạc hướng họ mà thôi.
Dialogue: 0,0:04:29.52,0:04:36.48,Default,,0000,0000,0000,,Thủ tướng không muốn mối đe dọa ám sát này\Nbị báo chí truyền thông nhắc đến dù chỉ nửa lời.
Dialogue: 0,0:04:37.00,0:04:39.57,Default,,0000,0000,0000,,Và đó là lúc cần đến\Nông và đội của ông.
Dialogue: 0,0:04:39.57,0:04:43.06,Default,,0000,0000,0000,,Ý ông là muốn Đội 9 đứng ra đảm nhiệm\Nviệc bảo vệ an nguy cá nhân cho Thủ tướng sao?
Dialogue: 0,0:04:43.30,0:04:44.93,Default,,0000,0000,0000,,Ông nắm bắt nhanh đấy.
Dialogue: 0,0:04:45.44,0:04:49.27,Default,,0000,0000,0000,,Thưa Cục trưởng, ông có thể cung cấp cho chúng tôi\Nbản gốc của lá thư đe dọa ám sát đó được không?
Dialogue: 0,0:04:49.48,0:04:51.94,Default,,0000,0000,0000,,Chúng tôi sẽ tự lo liệu việc truy lùng\Nbọn tội phạm.
Dialogue: 0,0:04:51.94,0:04:55.38,Default,,0000,0000,0000,,Tất cả những gì chúng tôi cần các ông làm\Nlà lo liệu việc an ninh cho Thủ tướng.
Dialogue: 0,0:04:55.75,0:05:00.84,Default,,0000,0000,0000,,Và để truyền thông không đánh hơi thấy gì, hãy kiềm chế không làm\Nbất cứ điều gì gây chú ý.
Dialogue: 0,0:05:02.92,0:05:06.08,Default,,0000,0000,0000,,{\i1}Thiếu tá. Tập hợp mọi người{\i0}\N{\i1}tại tư dinh của Thủ tướng.{\i0}
Dialogue: 0,0:05:18.07,0:05:22.80,Default,,0000,0000,0000,,Nói cách khác, ông ta đang bảo chúng ta\Nđi làm vú em trông trẻ cho Thủ tướng chứ gì.
Dialogue: 0,0:05:28.45,0:05:32.18,Default,,0000,0000,0000,,Vậy nhận định của Trưởng ban\Nvề vụ này thế nào?
Dialogue: 0,0:05:32.18,0:05:36.25,Default,,0000,0000,0000,,Tôi cho rằng chúng ta không thể xem nhẹ chuyện này\Nnhư một trò phạm tội bắt chước theo trào lưu.
Dialogue: 0,0:05:36.82,0:05:41.93,Default,,0000,0000,0000,,Mối đe dọa này là lời cảnh báo dành cho Thủ tướng vì đã bãi bỏ\NChính sách Đặc biệt về Người tị nạn,
Dialogue: 0,0:05:41.93,0:05:44.99,Default,,0000,0000,0000,,thứ mà chính quyền tiền nhiệm đã ban hành\Nnhư một đạo luật mang tính tạm thời.
Dialogue: 0,0:05:45.23,0:05:47.17,Default,,0000,0000,0000,,Và khi vấn đề người tị nạn vẫn chẳng có tiến triển gì...
Dialogue: 0,0:05:47.17,0:05:50.24,Default,,0000,0000,0000,,...sau tất cả các cuộc biểu tình cùng những khẩu hiệu vang dội:\N\"Chấm dứt phân biệt đối xử! Trả lại tự do cho người tị nạn!\"
Dialogue: 0,0:05:50.24,0:05:54.57,Default,,0000,0000,0000,,Bọn chúng coi đó là một hành vi phản quốc\Nchống lại nhân dân,
Dialogue: 0,0:05:54.57,0:05:56.73,Default,,0000,0000,0000,,và tuyên bố rằng chúng sẽ xử tử bà ấy\Nvì tội danh đó, phải không?
Dialogue: 0,0:05:57.28,0:05:59.54,Default,,0000,0000,0000,,Những gì chúng nói\Nhoàn toàn mâu thuẫn lẫn nhau!
Dialogue: 0,0:05:59.98,0:06:03.74,Default,,0000,0000,0000,,Cảnh sát có thể bảo rằng tất cả tội ác này\Nđều do cùng một tổ chức gây ra,
Dialogue: 0,0:06:04.05,0:06:06.45,Default,,0000,0000,0000,,nhưng ở thời điểm này, tôi không thấy\Nlàm sao mà như vậy được.
Dialogue: 0,0:06:07.42,0:06:11.32,Default,,0000,0000,0000,,Nếu không phải vì chúng có chung biểu tượng này,\Nthì tôi cũng đồng tình với cậu.
Dialogue: 0,0:06:11.62,0:06:15.92,Default,,0000,0000,0000,,Mặc dù tôi không thể tin tưởng hoàn toàn\Nvào những lời Cục trưởng Cảnh sát nói,
Dialogue: 0,0:06:16.26,0:06:20.70,Default,,0000,0000,0000,,nhưng xét việc một chuỗi thông cáo tội phạm\Nmang biểu tượng này đã được tung ra,
Dialogue: 0,0:06:20.70,0:06:23.43,Default,,0000,0000,0000,,chúng ta không còn lựa chọn nào khác ngoài việc\Nhành động dựa trên giả định đó.
Dialogue: 0,0:06:23.74,0:06:26.14,Default,,0000,0000,0000,,Hiện tượng phức hợp cô lập...
Dialogue: 0,0:06:28.81,0:06:32.40,Default,,0000,0000,0000,,Tôi phải thừa nhận, vụ này {\i1}đúng là{\i0} rất giống\Nvới vụ án Kẻ Cười Tươi.
Dialogue: 0,0:06:36.78,0:06:40.48,Default,,0000,0000,0000,,Vào lúc này, mục tiêu của chúng ta không phải là\Nxác định chân tướng sự thật đằng sau những tội ác đó.
Dialogue: 0,0:06:41.02,0:06:43.49,Default,,0000,0000,0000,,Hãy dồn toàn lực vào nhiệm vụ bảo vệ\Nan toàn cho Thủ tướng.
Dialogue: 0,0:06:43.96,0:06:47.03,Default,,0000,0000,0000,,Nhưng đồng thời, tôi cũng muốn các cậu\Nđiều tra về lá thư đe dọa và biểu tượng đó...
Dialogue: 0,0:06:47.03,0:06:50.19,Default,,0000,0000,0000,,...để nhận diện tên tội phạm hoặc nhóm tội phạm\Nđang đứng đằng sau giật dây chuyện này.
Dialogue: 0,0:06:51.93,0:06:55.49,Default,,0000,0000,0000,,Batou, Saito, và Pazu, các cậu đi cùng tôi\Nphụ trách an ninh cho Thủ tướng.
Dialogue: 0,0:06:55.87,0:06:59.89,Default,,0000,0000,0000,,Togusa, cậu cùng Ishikawa và Borma điều tra\Nmanh mối từ biểu tượng và lá thư đe dọa.
Dialogue: 0,0:07:00.27,0:07:01.40,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:07:07.78,0:07:11.27,Default,,0000,0000,0000,,{\i1}Về phần Thủ tướng Kayabuki,{\i0}\N{\i1}người đã xin nghỉ ốm vào ngày hôm qua,{\i0}
Dialogue: 0,0:07:11.58,0:07:14.71,Default,,0000,0000,0000,,{\i1}hôm nay bà đã xuất hiện trở lại với tinh thần phấn chấn{\i0}\N{\i1}để chủ trì phiên họp Nội các bất thường.{\i0}
Dialogue: 0,0:07:15.09,0:07:18.89,Default,,0000,0000,0000,,{\i1}Tuy nhiên, với phiên họp ủy ban ngân sách{\i0}\N{\i1}đang cận kề chỉ còn vài ngày nữa...{\i0}
Dialogue: 0,0:07:19.12,0:07:21.13,Default,,0000,0000,0000,,{\i1}...và chưa hề có dấu hiệu khả quan nào trong chính sách tị nạn{\i0}\N{\i1}vẫn đang dang dở ngổn ngang,{\i0}
Dialogue: 0,0:07:21.36,0:07:25.69,Default,,0000,0000,0000,,{\i1}nữ Thủ tướng đầu tiên của Nhật Bản dường như đã đánh mất đi{\i0}\N{\i1}vẻ rạng rỡ vốn có khi bà mới thành lập Nội các,{\i0}
Dialogue: 0,0:07:25.93,0:07:27.63,Default,,0000,0000,0000,,{\i1}và nét mặt của bà dường như{\i0}\N{\i1}cũng đã nhuốm màu u ám.{\i0}
Dialogue: 0,0:07:27.63,0:07:30.50,Default,,0000,0000,0000,,Vậy là, chẳng có phản ứng nào\Ntrước bức thư đe dọa của ta.
Dialogue: 0,0:07:31.67,0:07:34.77,Default,,0000,0000,0000,,Ta thấy rằng việc sống trọn với lý tưởng\Nđã trở thành một gánh nặng quá sức đối với ngươi,
Dialogue: 0,0:07:34.77,0:07:38.51,Default,,0000,0000,0000,,chót lưỡi đầu môi trong thoáng chốc\Nvề việc giải phóng người tị nạn...
Dialogue: 0,0:07:38.51,0:07:41.27,Default,,0000,0000,0000,,...trong khi trên thực tế\Nchẳng làm được trò trống gì.
Dialogue: 0,0:07:42.55,0:07:46.45,Default,,0000,0000,0000,,Ta sẽ thức tỉnh ngươi bằng cách giáng xuống\Nhình phạt mà ngươi đích đáng phải nhận.
Dialogue: 0,0:07:48.25,0:07:49.52,Default,,0000,0000,0000,,Tuy nhiên...
Dialogue: 0,0:07:50.46,0:07:54.15,Default,,0000,0000,0000,,Ta phải đảm bảo rằng cuộc tương phùng với bà ta sẽ là duy nhất,\Nbởi cơ hội sẽ không bao giờ đến lần thứ hai.
Dialogue: 0,0:07:57.10,0:07:58.72,Default,,0000,0000,0000,,Một khi đã dấn thân\Nhành động,
Dialogue: 0,0:07:59.33,0:08:02.60,Default,,0000,0000,0000,,thì tuyệt đối không thể dung thứ cho việc rút lui\Nkhi chưa hoàn thành mục tiêu.
Dialogue: 0,0:08:04.44,0:08:09.00,Default,,0000,0000,0000,,Nhưng một lý tưởng được thực thi mà không có mục tiêu rõ ràng\Nthì cầm chắc thất bại,
Dialogue: 0,0:08:09.88,0:08:11.50,Default,,0000,0000,0000,,và ngươi sẽ bị cản bước.
Dialogue: 0,0:08:12.71,0:08:14.87,Default,,0000,0000,0000,,Ta là một kẻ\Ncó động cơ chính đáng.
Dialogue: 0,0:08:15.81,0:08:19.44,Default,,0000,0000,0000,,Nhóm 11 Cá Nhân.
Dialogue: 0,0:08:32.43,0:08:34.37,Default,,0000,0000,0000,,Thế là tám vụ rồi...
Dialogue: 0,0:08:34.37,0:08:36.93,Default,,0000,0000,0000,,Ngài có thể để người khác\Nlàm việc đó thay ngài mà, thưa sếp.
Dialogue: 0,0:08:38.00,0:08:40.34,Default,,0000,0000,0000,,Cậu bắt quả tang tôi\Nđang ăn vụng rồi đấy.
Dialogue: 0,0:08:41.01,0:08:43.63,Default,,0000,0000,0000,,Đây là việc mà tôi làm\Nvì tôi thích thú với nó.
Dialogue: 0,0:08:44.64,0:08:47.55,Default,,0000,0000,0000,,Tôi đang củng cố trí nhớ bằng việc\Ntiếp thu thông tin in ấn trên giấy...
Dialogue: 0,0:08:47.55,0:08:54.18,Default,,0000,0000,0000,,...để có thể lập tức tuôn ra những ý tưởng sắc bén\Nngay trong tích tắc bất chợt.
Dialogue: 0,0:08:55.35,0:08:56.55,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:08:57.16,0:08:59.21,Default,,0000,0000,0000,,Tình báo do bên Ban Thư ký chuyển sang,\Nthưa ngài.
Dialogue: 0,0:09:03.30,0:09:07.63,Default,,0000,0000,0000,,Chà chà. Vài phần tử kỳ lạ\Nđã bắt đầu trỗi dậy rồi đấy.
Dialogue: 0,0:09:07.70,0:09:09.17,Default,,0000,0000,0000,,Đe dọa ám sát cả\NThủ tướng cơ à...
Dialogue: 0,0:09:09.17,0:09:11.23,Default,,0000,0000,0000,,...nghĩa là chúng ta lại có thêm một kẻ\Ngan trời tày đình trong tay rồi.
Dialogue: 0,0:09:11.77,0:09:14.14,Default,,0000,0000,0000,,Bên đó không biết gì\Nvề hắn sao?
Dialogue: 0,0:09:14.34,0:09:17.40,Default,,0000,0000,0000,,Phía cảnh sát vẫn chưa thể nhận diện được\Ntung tích thủ phạm.
Dialogue: 0,0:09:17.58,0:09:19.64,Default,,0000,0000,0000,,Chẳng có gì đáng ngạc nhiên cả.
Dialogue: 0,0:09:20.35,0:09:21.84,Default,,0000,0000,0000,,Họ đang bố trí an ninh cho bà ấy\Nnhư thế nào?
Dialogue: 0,0:09:22.08,0:09:24.01,Default,,0000,0000,0000,,Có vẻ như Đội An ninh Công cộng 9\Nđã được giao phụ trách việc đó.
Dialogue: 0,0:09:24.15,0:09:25.84,Default,,0000,0000,0000,,Đội 9 sao?
Dialogue: 0,0:09:26.02,0:09:28.15,Default,,0000,0000,0000,,Có họ nhận thụ lý vụ này, tôi đoán\Nchúng ta chẳng có gì phải bận tâm nữa.
Dialogue: 0,0:09:28.15,0:09:30.62,Default,,0000,0000,0000,,Chúng ta đâu thể để bà ấy thực sự\Nbị ám sát được, đúng không nào?
Dialogue: 0,0:09:31.39,0:09:34.45,Default,,0000,0000,0000,,Được rồi, tôi cũng sẽ cử người\Nbám sát theo Thủ tướng.
Dialogue: 0,0:09:35.16,0:09:38.10,Default,,0000,0000,0000,,Hãy điều tra xem kẻ nào đã phát tán\Nlá thư đe dọa ám sát này.
Dialogue: 0,0:09:38.40,0:09:43.23,Default,,0000,0000,0000,,Nếu thấy hắn có nguy cơ rơi vào tay Đội 9,\Nchúng ta sẽ can thiệp và kéo hắn về bên này.
Dialogue: 0,0:09:43.54,0:09:44.73,Default,,0000,0000,0000,,Tôi đã hiểu thưa ngài.
Dialogue: 0,0:09:55.75,0:09:59.18,Default,,0000,0000,0000,,{\i1}Thiếu tá? Trông cô có vẻ không mấy mặn mà{\i0}\N{\i1}với nhiệm vụ lần này nhỉ.{\i0}
Dialogue: 0,0:09:59.42,0:10:01.94,Default,,0000,0000,0000,,{\i1}Thế à? Chắc là vì{\i0}\N{\i1}tôi đang tới tháng đấy.{\i0}
Dialogue: 0,0:10:03.26,0:10:04.88,Default,,0000,0000,0000,,{\i1}Thôi đừng đùa giỡn nữa.{\i0}
Dialogue: 0,0:10:05.19,0:10:07.42,Default,,0000,0000,0000,,{\i1}Cô nghĩ sao về những nhiệm vụ{\i0}\N{\i1}dạo gần đây của chúng ta?{\i0}
Dialogue: 0,0:10:07.83,0:10:11.59,Default,,0000,0000,0000,,{\i1}Theo như tôi nhớ, chúng ta vốn là{\i0}\N{\i1}một tổ chức tấn công trấn áp tội phạm cơ mà.{\i0}
Dialogue: 0,0:10:12.10,0:10:15.03,Default,,0000,0000,0000,,{\i1}Dù cho có lời đe dọa lấy mạng Thủ tướng đi chăng nữa,{\i0}
Dialogue: 0,0:10:15.03,0:10:18.24,Default,,0000,0000,0000,,{\i1}thì việc bị trói chân trói tay thế này{\i0}\N{\i1}chẳng phải điều tôi cảm thấy hứng thú.{\i0}
Dialogue: 0,0:10:18.24,0:10:19.74,Default,,0000,0000,0000,,{\i1}Anh thấy chán ngấy rồi à?{\i0}
Dialogue: 0,0:10:19.74,0:10:22.54,Default,,0000,0000,0000,,{\i1}Ý tôi muốn hỏi là,{\i0}\N{\i1}cô{\i0} có cảm thấy như vậy không?{\i0}
Dialogue: 0,0:10:23.61,0:10:25.17,Default,,0000,0000,0000,,{\i1}Tôi không chắc nữa.{\i0}\N{\i1}Có lẽ vậy.{\i0}
Dialogue: 0,0:10:38.59,0:10:41.96,Default,,0000,0000,0000,,Xem ra chưa từng có tổ chức nào thuộc...
Dialogue: 0,0:10:41.96,0:10:45.29,Default,,0000,0000,0000,,...Tổ chức Giải phóng Người tị nạn\Ntừng sử dụng biểu tượng y hệt thế này.
Dialogue: 0,0:10:45.80,0:10:49.82,Default,,0000,0000,0000,,Chúng ta thậm chí còn chẳng biết\Nphải {\i1}đọc{\i0} cái thứ này thế nào nữa.
Dialogue: 0,0:10:50.14,0:10:53.26,Default,,0000,0000,0000,,Thôi nào mấy cha nội, ít ra cũng phải dùng cái tên gì\Nđể người ngoài còn đọc được chứ.
Dialogue: 0,0:10:53.84,0:10:56.71,Default,,0000,0000,0000,,\"Báo thù\", \"vô tận\",\Nvà \"samurai\"...
Dialogue: 0,0:10:57.44,0:11:00.97,Default,,0000,0000,0000,,Nó {\i1}đúng là{\i0} có phần gợi mở về bối cảnh tư tưởng đấy,\Nnhưng mà...
Dialogue: 0,0:11:01.65,0:11:05.17,Default,,0000,0000,0000,,Có khi họ chỉ đang sử dụng\Nmột môtíp có sẵn nào đó thôi.
Dialogue: 0,0:11:05.92,0:11:07.08,Default,,0000,0000,0000,,Chẳng hạn như?
Dialogue: 0,0:11:07.39,0:11:08.44,Default,,0000,0000,0000,,Để tôi nghĩ xem...
Dialogue: 0,0:11:09.75,0:11:14.43,Default,,0000,0000,0000,,Văn học do các danh nhân lịch sử để lại.\NTựa đề của một vở kịch hay bộ phim.
Dialogue: 0,0:11:14.43,0:11:18.62,Default,,0000,0000,0000,,Hoặc một thương hiệu đại diện cho nhân vật hay tổ chức\Ntừng ghi dấu trong các biến cố lịch sử...
Dialogue: 0,0:11:19.10,0:11:20.66,Default,,0000,0000,0000,,Tôi hiểu hướng suy nghĩ\Ncủa cậu rồi.
Dialogue: 0,0:11:29.17,0:11:30.40,Default,,0000,0000,0000,,Này, tôi tìm ra rồi đây.
Dialogue: 0,0:11:30.71,0:11:33.80,Default,,0000,0000,0000,,Ở đây ghi rằng nó được đọc là\N\"Nhóm 11 Cá Nhân\".
Dialogue: 0,0:11:34.05,0:11:37.85,Default,,0000,0000,0000,,Đó là tựa đề một tuyển tập tiểu luận về các cuộc cách mạng\Nđược viết cách đây nửa thế kỷ.
Dialogue: 0,0:11:37.98,0:11:39.18,Default,,0000,0000,0000,,Chiếu nó lên\Nbên này đi.
Dialogue: 0,0:11:40.39,0:11:42.52,Default,,0000,0000,0000,,\"Suy ngẫm về Quốc gia\Nvà Cách mạng:\"
Dialogue: 0,0:11:42.52,0:11:46.53,Default,,0000,0000,0000,,\"Tuyển tập các Tiểu luận Mở đầu về Cách mạng\",\Ncủa Patrick Sylvestre.
Dialogue: 0,0:11:46.53,0:11:48.58,Default,,0000,0000,0000,,Ồ, tôi từng đọc\Ncuốn này rồi.
Dialogue: 0,0:11:48.93,0:11:50.73,Default,,0000,0000,0000,,\"Tuyển tập Tiểu luận\Nvề Cách mạng\" sao?
Dialogue: 0,0:11:50.73,0:11:54.79,Default,,0000,0000,0000,,Vào thời điểm tuyển tập xuất bản, các bài tiểu luận\Nkhông gây được tiếng vang lớn cho lắm.
Dialogue: 0,0:11:55.37,0:11:59.80,Default,,0000,0000,0000,,\"Sự trỗi dậy của Đẳng cấp thứ Ba\",\N\"Giải thoát khỏi Ách thống trị\",
Dialogue: 0,0:12:00.04,0:12:03.27,Default,,0000,0000,0000,,\"Lời từ biệt các Bậc Quân vương\",\N\"Khát vọng hướng tới Chủ nghĩa Xã hội\",
Dialogue: 0,0:12:03.44,0:12:06.31,Default,,0000,0000,0000,,\"Đêm trước ngày Khải huyền\",\N\"Đoạn tuyệt với Thần linh\",
Dialogue: 0,0:12:06.55,0:12:09.67,Default,,0000,0000,0000,,\"Castro và Guevara\",\N\"Mười hai năm Chủ nghĩa Hư vô\",
Dialogue: 0,0:12:09.88,0:12:12.32,Default,,0000,0000,0000,,và \"Trở về với Nguyên lý\".
Dialogue: 0,0:12:12.32,0:12:17.32,Default,,0000,0000,0000,,Đó là tuyển tập các tiểu luận mở đầu gồm chín bài đó,\Ncộng thêm bài thứ mười về cuộc Cách mạng Tháng Năm...
Dialogue: 0,0:12:17.32,0:12:22.23,Default,,0000,0000,0000,,...thứ mà chính tác giả đã tận mắt chứng kiến và đã thắp lên\Nngọn lửa ước mơ trở thành lãnh tụ cách mạng trong ông.
Dialogue: 0,0:12:22.56,0:12:27.00,Default,,0000,0000,0000,,Nhưng có những giả thuyết cho rằng còn có một bài tiểu luận\Nthứ {\i1}mười một{\i0} bí ẩn mà chính tác giả...
Dialogue: 0,0:12:27.00,0:12:30.93,Default,,0000,0000,0000,,...đã cất giấu khóa chặt lại vì không coi sự kiện xảy ra ở Nhật Bản\Nđó là một cuộc cách mạng.
Dialogue: 0,0:12:31.40,0:12:35.84,Default,,0000,0000,0000,,Đó là bài tiểu luận gắn liền với một câu chuyện.\N\"Nhóm 11 Cá Nhân\".
Dialogue: 0,0:12:36.64,0:12:39.87,Default,,0000,0000,0000,,Nhưng không hề có ghi chép nào về việc\Nnó từng được xuất bản.
Dialogue: 0,0:12:40.31,0:12:46.41,Default,,0000,0000,0000,,Đúng vậy, và ngay cả dữ liệu này cũng chỉ là thông tin\Ndo những người hâm mộ cuồng nhiệt tải lên mạng.
Dialogue: 0,0:12:46.79,0:12:52.96,Default,,0000,0000,0000,,Nhưng điều chúng ta không thể bỏ qua là những người hâm mộ cuồng nhiệt đó\Nđều là những kẻ theo chủ nghĩa cá nhân cực đoan.
Dialogue: 0,0:12:52.96,0:12:56.16,Default,,0000,0000,0000,,Một cuốn kinh thánh cho những kẻ theo chủ nghĩa cá nhân, nhỉ?
Dialogue: 0,0:12:58.03,0:12:59.22,Default,,0000,0000,0000,,Này, tôi vừa nhớ ra!
Dialogue: 0,0:12:59.46,0:13:00.40,Default,,0000,0000,0000,,Biểu tượng này...
Dialogue: 0,0:13:00.40,0:13:02.20,Default,,0000,0000,0000,,Trong vụ án trực thăng Lục quân Phòng vệ\Nmất kiểm soát vừa rồi,
Dialogue: 0,0:13:02.40,0:13:04.33,Default,,0000,0000,0000,,chúng ta đã lục soát căn hộ\Ncủa viên phi công đã chết, đúng không?
Dialogue: 0,0:13:04.64,0:13:05.44,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:13:05.44,0:13:09.24,Default,,0000,0000,0000,,Tôi đã nhìn thấy một mảnh giấy ghi biểu tượng này\Ntại nhà riêng của anh ta.
Dialogue: 0,0:13:10.98,0:13:14.94,Default,,0000,0000,0000,,Và những kẻ đã đánh chiếm\NĐại sứ quán Trung Quốc...
Dialogue: 0,0:13:15.31,0:13:18.68,Default,,0000,0000,0000,,Chẳng phải bọn chúng cũng tự xưng\Nlà Nhóm 11 Cá Nhân sao?
Dialogue: 0,0:13:21.72,0:13:22.62,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}
Dialogue: 0,0:13:22.89,0:13:24.91,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi. Đó là những thông tin{\i0}\N{\i1}rất thú vị đấy.{\i0}
Dialogue: 0,0:13:25.46,0:13:28.72,Default,,0000,0000,0000,,{\i1}Nhưng điều đó vẫn chưa giúp chúng ta tiến gần hơn{\i0}\N{\i1}đến việc nhận diện được tên thủ phạm.{\i0}
Dialogue: 0,0:13:29.23,0:13:32.13,Default,,0000,0000,0000,,{\i1}Hơn nữa, phía cảnh sát chắc hẳn cũng đã{\i0}\N{\i1}khui ra được chừng đó thông tin rồi.{\i0}
Dialogue: 0,0:13:32.60,0:13:36.59,Default,,0000,0000,0000,,{\i1}Lặn sâu hơn nữa và lùng sục thứ gì đó{\i0}\N{\i1}có thể nhận dạng đích danh kẻ đứng sau.{\i0}
Dialogue: 0,0:13:36.90,0:13:39.46,Default,,0000,0000,0000,,{\i1}Dù manh mối có nhỏ nhặt đến đâu{\i0}\N{\i1}tôi cũng không bận tâm.{\i0}
Dialogue: 0,0:13:39.77,0:13:41.00,Default,,0000,0000,0000,,{\i1}Đã rõ.{\i0}
Dialogue: 0,0:13:42.34,0:13:44.04,Default,,0000,0000,0000,,Xin hãy kiểm tra lại đồ bên trong.
Dialogue: 0,0:13:53.65,0:13:58.32,Default,,0000,0000,0000,,Hãy nghiền ngẫm ý nghĩa thông điệp\Ntừ những đồng chí mới thức tỉnh của ta.
Dialogue: 0,0:14:02.03,0:14:06.79,Default,,0000,0000,0000,,Điều gì đã khiến cho cuốn kinh thánh đấu tranh của ta,\N\"Nhóm 11 Cá Nhân\", trở nên vĩ đại đến thế?
Dialogue: 0,0:14:07.80,0:14:11.33,Default,,0000,0000,0000,,Đó chính là cách tác giả luận bàn\Nvề bản chất thực sự của Sự biến ngày 15 tháng 5...
Dialogue: 0,0:14:11.64,0:14:14.26,Default,,0000,0000,0000,,...bằng cách so sánh nó\Nvới nghệ thuật Kịch Noh của Nhật Bản.
Dialogue: 0,0:14:15.54,0:14:20.14,Default,,0000,0000,0000,,Ngay cả khi khinh miệt mọi hình thức biểu đạt nghệ thuật khác,\Nthì kịch Noh lại là loại hình nghệ thuật duy nhất...
Dialogue: 0,0:14:20.41,0:14:22.64,Default,,0000,0000,0000,,...được giới võ sĩ thời phong kiến Nhật Bản\Ncông nhận và tôn sùng.
Dialogue: 0,0:14:23.25,0:14:26.92,Default,,0000,0000,0000,,Đó là bởi vì, trái ngược với nhiều hình thức nghệ thuật vốn chẳng qua chỉ là sự giả tạo...
Dialogue: 0,0:14:26.92,0:14:31.18,Default,,0000,0000,0000,,...với bản chất là lặp đi lặp lại một tập hợp các hành động\Nđã được định sẵn hết lần này đến lần khác,
Dialogue: 0,0:14:32.26,0:14:35.99,Default,,0000,0000,0000,,thì trong kịch Noh, mỗi buổi biểu diễn\Nđều là một tác phẩm độc nhất vô nhị,
Dialogue: 0,0:14:36.59,0:14:42.53,Default,,0000,0000,0000,,do đó năng lượng tinh thần dồn vào chúng được cho là\Ntiệm cận vô cùng với những biến cố thực ngoài đời thực.
Dialogue: 0,0:14:44.50,0:14:47.80,Default,,0000,0000,0000,,Nếu một người hiến dâng sinh mạng của mình\Nnhư một lãnh tụ cách mạng,
Dialogue: 0,0:14:48.21,0:14:51.30,Default,,0000,0000,0000,,thì sinh mạng đó sẽ được thăng hoa\Nthành một điều gì đó siêu việt.
Dialogue: 0,0:14:51.91,0:14:56.44,Default,,0000,0000,0000,,Trong cái chết, một người hùng đi đến hồi kết,\Nnhưng anh ta giành lấy sự bất tử vĩnh hằng.
Dialogue: 0,0:14:57.58,0:15:04.11,Default,,0000,0000,0000,,Đó chính là điều mà bài viết \"Nhóm 11 Cá Nhân\"\Ncủa Sylvestre đã truyền dạy cho chúng ta.
Dialogue: 0,0:15:08.79,0:15:10.13,Default,,0000,0000,0000,,Vậy tôi sẽ tiến hành\Nvới thứ này nhé.
Dialogue: 0,0:15:10.13,0:15:11.43,Default,,0000,0000,0000,,Tốt lắm.
Dialogue: 0,0:15:11.56,0:15:12.96,Default,,0000,0000,0000,,Trưởng ban Aramaki.
Dialogue: 0,0:15:14.60,0:15:16.66,Default,,0000,0000,0000,,Về lịch trình ngày mai...
Dialogue: 0,0:15:17.64,0:15:19.74,Default,,0000,0000,0000,,Bà không cần phải bận tâm đâu.
Dialogue: 0,0:15:19.74,0:15:23.64,Default,,0000,0000,0000,,Chúng tôi sẽ cố gắng hết sức để không gây sự chú ý\Ntrong khi tháp tùng bà, thưa Thủ tướng.
Dialogue: 0,0:15:24.31,0:15:25.78,Default,,0000,0000,0000,,Cảm ơn ông.
Dialogue: 0,0:15:26.81,0:15:29.87,Default,,0000,0000,0000,,Tôi rất xin lỗi vì đã lôi kéo các ông\Nvào một vấn đề mang tính riêng tư thế này.
Dialogue: 0,0:15:33.32,0:15:34.55,Default,,0000,0000,0000,,Vào đi.
Dialogue: 0,0:15:37.32,0:15:38.29,Default,,0000,0000,0000,,Trưởng ban.
Dialogue: 0,0:15:38.62,0:15:39.92,Default,,0000,0000,0000,,Có chuyện gì thế?
Dialogue: 0,0:15:43.26,0:15:47.40,Default,,0000,0000,0000,,Thứ này nằm lẫn trong số thư từ và bưu kiện\Ngửi đến đích danh Thủ tướng.
Dialogue: 0,0:15:47.40,0:15:48.80,Default,,0000,0000,0000,,Nó là gì vậy?
Dialogue: 0,0:15:48.90,0:15:51.43,Default,,0000,0000,0000,,Có lẽ tốt nhất là bà\Nkhông nên nhìn thấy thứ này.
Dialogue: 0,0:15:52.20,0:15:55.40,Default,,0000,0000,0000,,Sự quan tâm thái quá dành cho phụ nữ chính là thứ\Ndẫn đến sự coi thường họ đấy.
Dialogue: 0,0:16:00.78,0:16:05.65,Default,,0000,0000,0000,,Vô ích thôi... Tôi không thể tìm thấy bất cứ thứ gì\Nvề nội dung của chính bài tiểu luận đó cả.
Dialogue: 0,0:16:05.88,0:16:08.68,Default,,0000,0000,0000,,Sự kiện là chủ đề của bài tiểu luận đó\Nrốt cuộc là gì vậy?
Dialogue: 0,0:16:09.12,0:16:12.42,Default,,0000,0000,0000,,Đó là vào\Nngày 15 tháng 5 năm 1932.
Dialogue: 0,0:16:12.66,0:16:18.36,Default,,0000,0000,0000,,Đó là khi một số sĩ quan hải quân trẻ tuổi,\Nhọc viên lục quân và những người nông dân đồng cảm...
Dialogue: 0,0:16:18.36,0:16:22.49,Default,,0000,0000,0000,,...đã có hành động cấp tiến khi bị cuốn vào\Ncơn lốc nhiệt huyết kiến thiết quốc gia.
Dialogue: 0,0:16:23.33,0:16:27.74,Default,,0000,0000,0000,,Các nhân vật nòng cốt của âm mưu đã ám sát\NThủ tướng đương nhiệm thời bấy giờ,
Dialogue: 0,0:16:27.74,0:16:32.64,Default,,0000,0000,0000,,kết quả là đất nước Nhật Bản đã lao đầu không phanh\Nvào kỷ nguyên thống trị của chủ nghĩa quân phiệt.
Dialogue: 0,0:16:33.65,0:16:37.58,Default,,0000,0000,0000,,Dù sao đi nữa, người ta không thể coi hành động của các sĩ quan đó\Nlà thứ gì khác ngoài những hành vi khủng bố tàn bạo,
Dialogue: 0,0:16:37.82,0:16:42.78,Default,,0000,0000,0000,,nhưng chính những gì xảy ra {\i1}sau đó{\i0} mới là thứ\Nkhắc họa mang tính biểu tượng cho tầm vóc của sự kiện.
Dialogue: 0,0:16:43.52,0:16:48.08,Default,,0000,0000,0000,,Sau vụ ám sát Thủ tướng, mười một sĩ quan quân đội trẻ tuổi\Nđã tham gia vào vụ việc...
Dialogue: 0,0:16:48.33,0:16:50.82,Default,,0000,0000,0000,,...đã bị đưa ra xét xử trước\Ntòa án quân sự,
Dialogue: 0,0:16:51.13,0:16:54.26,Default,,0000,0000,0000,,nhưng phiên tòa bắt đầu\Nrẽ sang một hướng kỳ lạ.
Dialogue: 0,0:16:55.20,0:16:59.50,Default,,0000,0000,0000,,Xuất phát từ niềm tin sắt đá vào lý tưởng của mình, các bị cáo\Nvốn chỉ mới ngoài hai mươi tuổi,
Dialogue: 0,0:16:59.50,0:17:02.61,Default,,0000,0000,0000,,đã bắt đầu đưa ra lời khai trong làn nước mắt,\Ntừ chối mọi sự bào chữa...
Dialogue: 0,0:17:02.61,0:17:04.67,Default,,0000,0000,0000,,...và tuyên bố rằng họ\Nđã sẵn sàng đón nhận cái chết.
Dialogue: 0,0:17:05.08,0:17:08.71,Default,,0000,0000,0000,,Rõ ràng là khi họ làm điều đó, các thẩm phán,\Nnhững quân nhân bên công tố,
Dialogue: 0,0:17:08.81,0:17:10.91,Default,,0000,0000,0000,,giới báo chí và cả những người ngồi dưới phòng xử án...
Dialogue: 0,0:17:11.15,0:17:15.48,Default,,0000,0000,0000,,...tất cả đều thấy mình đồng cảm sâu sắc với họ,\Nvà bắt đầu bật khóc theo.
Dialogue: 0,0:17:16.29,0:17:19.88,Default,,0000,0000,0000,,Hơn thế nữa, phong trào xin giảm án vốn không thu hút được nhiều sự chú ý\Ntại phiên tòa công khai,
Dialogue: 0,0:17:20.19,0:17:23.72,Default,,0000,0000,0000,,đã bùng nổ thành một phong trào quần chúng rầm rộ\Nsau khi bên công tố đưa ra lời luận tội cuối cùng.
Dialogue: 0,0:17:24.16,0:17:27.53,Default,,0000,0000,0000,,Tính đến thời điểm bản án được tuyên\Nvào ngày 19 tháng 9,
Dialogue: 0,0:17:27.53,0:17:29.90,Default,,0000,0000,0000,,đã có 350.000 lá đơn thỉnh nguyện\Nđược gửi tới,
Dialogue: 0,0:17:30.37,0:17:35.67,Default,,0000,0000,0000,,và dư luận xã hội vốn đang thể hiện những khuynh hướng\Ndân tộc chủ nghĩa cực đoan,
Dialogue: 0,0:17:35.67,0:17:39.44,Default,,0000,0000,0000,,đã đạt đến đỉnh điểm sôi sục cuồng nhiệt khi mười một ngón tay,\Ntrùng khớp với số lượng bị cáo,
Dialogue: 0,0:17:39.74,0:17:41.68,Default,,0000,0000,0000,,được bí mật chuyển đến\Ntòa án một cách đầy bí ẩn.
Dialogue: 0,0:17:42.78,0:17:46.65,Default,,0000,0000,0000,,Sau vụ ám sát Thủ tướng\Ncủa mười một sĩ quan trẻ đó,
Dialogue: 0,0:17:47.02,0:17:50.18,Default,,0000,0000,0000,,một kiểu chủ nghĩa dân tộc tôn sùng họ\Nnhư những anh hùng bắt đầu lan rộng khắp nơi.
Dialogue: 0,0:17:51.32,0:17:54.72,Default,,0000,0000,0000,,Đó là bài tiểu luận được viết bởi một tác giả\Nbị mê hoặc bởi những chi tiết của sự kiện đó.
Dialogue: 0,0:17:55.96,0:18:01.40,Default,,0000,0000,0000,,Tôi dám cá rằng ông ta đã đồng cảm sâu sắc với những người\Ndính líu đến vụ án khi đặt bút viết ra nó.
Dialogue: 0,0:18:06.70,0:18:08.54,Default,,0000,0000,0000,,Chúng không phải ngón tay thật.
Dialogue: 0,0:18:09.37,0:18:12.97,Default,,0000,0000,0000,,Chắc là chúng bị cắt ra từ\Nnhững cơ thể giả phế thải.
Dialogue: 0,0:18:15.01,0:18:18.95,Default,,0000,0000,0000,,{\i1}Togusa. Mười một ngón tay bị chặt vừa được{\i0}\N{\i1}gửi tới tư dinh của Thủ tướng.{\i0}
Dialogue: 0,0:18:18.95,0:18:20.42,Default,,0000,0000,0000,,{\i1}Hãy truy tìm dấu vết{\i0}\N{\i1}nguồn gốc của chúng.{\i0}
Dialogue: 0,0:18:20.42,0:18:22.85,Default,,0000,0000,0000,,Cô ấy vừa bảo là\Nmười một ngón tay sao?!
Dialogue: 0,0:18:23.59,0:18:27.53,Default,,0000,0000,0000,,{\i1}Thiếu tá, bọn tôi đang điều tra theo hướng bài tiểu luận đó,{\i0}
Dialogue: 0,0:18:27.53,0:18:31.39,Default,,0000,0000,0000,,{\i1}và vừa khui ra một tình tiết liên quan đến mười một ngón tay{\i0}\N{\i1}dính líu tới Sự biến ngày 15 tháng 5.{\i0}
Dialogue: 0,0:18:32.63,0:18:34.36,Default,,0000,0000,0000,,{\i1}Chắc chắn phải có uẩn khúc gì đó{\i0}\N{\i1}đằng sau chuyện này.{\i0}
Dialogue: 0,0:18:49.18,0:18:51.08,Default,,0000,0000,0000,,May quá, các thí chủ\Nđã tới kịp lúc.
Dialogue: 0,0:18:51.08,0:18:56.15,Default,,0000,0000,0000,,Nhiều người đến đây ngồi thiền\Nrất trân quý bức tranh đó.
Dialogue: 0,0:18:57.66,0:18:59.18,Default,,0000,0000,0000,,Tôi rất vui vì có thể\Ngiúp được việc.
Dialogue: 0,0:19:15.61,0:19:19.04,Default,,0000,0000,0000,,{\i1}Này, Thiền không hẳn là một tôn giáo,{\i0}
Dialogue: 0,0:19:19.04,0:19:23.10,Default,,0000,0000,0000,,{\i1}mà đúng hơn là phương thức giải thoát nghiệp chướng của con người khỏi những tạp niệm trần tục, đúng không?{\i0}
Dialogue: 0,0:19:23.58,0:19:28.48,Default,,0000,0000,0000,,{\i1}Với chúng mình, chắc nó cũng giống như việc xóa cache dữ liệu{\i0}\N{\i1}khi bộ nhớ bị đầy vậy.{\i0}
Dialogue: 0,0:19:28.82,0:19:31.31,Default,,0000,0000,0000,,{\i1}Có khi vừa giống thế,{\i0}\N{\i1}vừa kết hợp với việc đồng bộ hóa dữ liệu luôn ấy chứ.{\i0}
Dialogue: 0,0:19:31.66,0:19:36.15,Default,,0000,0000,0000,,{\i1}Nếu thế, biết đâu chúng mình có thể liên kết với một ai đó đang ngồi thiền rồi tải giác ngộ về máy luôn!{\i0}
Dialogue: 0,0:19:36.29,0:19:37.32,Default,,0000,0000,0000,,{\i1}- Chuẩn luôn!{\i0}\N{\i1}- Chuẩn luôn!{\i0}
Dialogue: 0,0:19:58.48,0:20:00.28,Default,,0000,0000,0000,,{\i1}Khu vực xung quanh đã an toàn.{\i0}
Dialogue: 0,0:20:00.65,0:20:03.15,Default,,0000,0000,0000,,{\i1}Dù vậy, bà Thủ tướng của chúng ta{\i0}\N{\i1}hành xử ích kỷ quá mức đấy.{\i0}
Dialogue: 0,0:20:03.15,0:20:06.68,Default,,0000,0000,0000,,{\i1}Người bình thường đầu óc tỉnh táo có ai lại đi ngồi thiền{\i0}\N{\i1}trong khi đang có kẻ lăm le lấy mạng mình không chứ?{\i0}
Dialogue: 0,0:20:07.36,0:20:11.95,Default,,0000,0000,0000,,{\i1}Lại còn không cho chúng ta bước vào chính điện nữa,{\i0}\N{\i1}chuyện này mà bể ra thì đừng hòng đổ lên đầu tôi đấy nhé.{\i0}
Dialogue: 0,0:20:12.66,0:20:15.89,Default,,0000,0000,0000,,{\i1}Tôi cho rằng theo cách riêng của mình, bà ấy hoàn toàn{\i0}\N{\i1}ý thức rõ về hoàn cảnh của bản thân lúc này.{\i0}
Dialogue: 0,0:20:16.40,0:20:19.50,Default,,0000,0000,0000,,{\i1}Bà ấy muốn ngồi thiền chính là vì{\i0}\N{\i1}đang ở vào thời khắc hiểm nghèo như thế này đấy.{\i0}
Dialogue: 0,0:20:19.74,0:20:23.37,Default,,0000,0000,0000,,{\i1}Đó cũng là lý do bà ấy chấp thuận cho việc{\i0}\N{\i1}sử dụng bọ nghe lén Interceptor không chính thức, đúng chứ?{\i0}
Dialogue: 0,0:20:23.71,0:20:28.91,Default,,0000,0000,0000,,{\i1}Này, tôi nể lòng dũng cảm của bà ấy đấy, nhưng nếu bà ấy{\i0}\N{\i1}chỉ cho phép cô kết nối lấy dữ liệu...{\i0}
Dialogue: 0,0:21:11.59,0:21:13.56,Default,,0000,0000,0000,,Chính nghĩa đứng về\Nphía ta.
Dialogue: 0,0:21:15.09,0:21:16.29,Default,,0000,0000,0000,,Ngươi sẽ bị thanh trừng!
Dialogue: 0,0:21:31.24,0:21:33.71,Default,,0000,0000,0000,,Vô ích thôi.\NChúng tao đã bao vây mày rồi.
Dialogue: 0,0:21:52.46,0:21:53.56,Default,,0000,0000,0000,,{\i1}Tachikoma!{\i0}
Dialogue: 0,0:22:14.52,0:22:15.99,Default,,0000,0000,0000,,Tôi không sao.
Dialogue: 0,0:22:22.69,0:22:24.99,Default,,0000,0000,0000,,Tên cyborg đó được gia cố\Nkinh khủng thật.
Dialogue: 0,0:22:25.66,0:22:28.26,Default,,0000,0000,0000,,Bắt đầu bằng việc rà soát những kẻ\Ncó mối liên hệ với quân đội đi.
Dialogue: 0,0:22:28.77,0:22:30.73,Default,,0000,0000,0000,,Tôi rất xin lỗi vì\Ntất cả những rắc rối này.
Dialogue: 0,0:22:30.94,0:22:33.73,Default,,0000,0000,0000,,Nếu ông và đội của ông không có mặt ở đây,\Nthì có lẽ tôi đã...
Dialogue: 0,0:22:34.21,0:22:35.50,Default,,0000,0000,0000,,Tôi không chắc về điều đó.
Dialogue: 0,0:22:35.91,0:22:39.14,Default,,0000,0000,0000,,Rất có thể ngay từ đầu hắn ta chỉ đơn thuần\Nkhông hề có ý định giết bà.
Dialogue: 0,0:22:39.14,0:22:41.14,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
