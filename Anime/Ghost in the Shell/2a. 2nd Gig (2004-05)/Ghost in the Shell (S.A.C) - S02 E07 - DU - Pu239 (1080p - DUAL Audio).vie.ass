Dialogue: 0,0:01:37.68,0:01:41.12,Default,,0000,0000,0000,,Thuyền và các bộ cơ thể cyborg không đăng ký\Nđang tập kết ở địa chỉ này.
Dialogue: 0,0:01:41.55,0:01:45.55,Default,,0000,0000,0000,,Dù vậy, tôi vẫn thắc mắc anh tính làm gì\Nvới ngần ấy hỏa lực.
Dialogue: 0,0:01:45.89,0:01:49.26,Default,,0000,0000,0000,,Tôi sẽ cho họ thêm động lực\Nđể giải phóng người tị nạn.
Dialogue: 0,0:01:49.50,0:01:51.43,Default,,0000,0000,0000,,Chắc mấy người đó cũng sống\Nkhổ sở lắm nhỉ.
Dialogue: 0,0:01:51.43,0:01:54.19,Default,,0000,0000,0000,,Chà, miễn là tôi nhận đủ tiền,\Nthì chuyện đó chẳng liên quan gì đến tôi.
Dialogue: 0,0:02:04.81,0:02:07.24,Default,,0000,0000,0000,,Này! Trò này là\Nthế quái nào hả?
Dialogue: 0,0:02:13.39,0:02:15.08,Default,,0000,0000,0000,,{\i1}Đúng như kế hoạch.{\i0}
Dialogue: 0,0:02:22.13,0:02:23.06,Default,,0000,0000,0000,,Khốn kiếp!
Dialogue: 0,0:02:26.27,0:02:29.29,Default,,0000,0000,0000,,Thằng khốn!\NMày bán đứng bọn tao đúng không?!
Dialogue: 0,0:03:10.64,0:03:14.31,Default,,0000,0000,0000,,Đã xác minh được danh tính gã cyborg cao cấp\Nđã tấn công Thủ tướng chưa?
Dialogue: 0,0:03:14.51,0:03:19.01,Default,,0000,0000,0000,,Tôi đang tập trung rà soát nhóm người có liên hệ quân sự,\Nnhưng vẫn chưa tìm thấy kết quả trùng khớp nào.
Dialogue: 0,0:03:19.22,0:03:24.21,Default,,0000,0000,0000,,Kể từ vụ trực thăng AI nổi loạn, an ninh mạng quân đội\Nđược thắt chặt hơn bình thường rất nhiều.
Dialogue: 0,0:03:25.22,0:03:28.39,Default,,0000,0000,0000,,Về mẫu cơ thể cyborg hiệu năng cao đó,\Nchẳng có hồ sơ lưu trữ nào cả...
Dialogue: 0,0:03:28.39,0:03:30.90,Default,,0000,0000,0000,,...ngoại trừ một ghi chép cho thấy\Ntừng có một đơn vị...
Dialogue: 0,0:03:30.90,0:03:33.92,Default,,0000,0000,0000,,...thuộc Lực lượng Phòng vệ từng được cử đi làm nhiệm vụ PKF\Nđược trang bị kiểu mẫu này.
Dialogue: 0,0:03:34.60,0:03:37.70,Default,,0000,0000,0000,,Nhưng vì lý do nào đó, không chỉ danh sách nhân sự PKF lúc đó,\Nmà ngay cả nhật ký chiến dịch của họ cũng biến mất không dấu vết.
Dialogue: 0,0:03:37.70,0:03:41.61,Default,,0000,0000,0000,,Mẫu cơ thể cyborg không cần bảo dưỡng định kỳ\Ndành riêng cho lực lượng PKF sao?
Dialogue: 0,0:03:41.94,0:03:45.34,Default,,0000,0000,0000,,Togusa? Thế còn nhóm người mà cậu bảo là đã xuất hiện...
Dialogue: 0,0:03:45.68,0:03:47.88,Default,,0000,0000,0000,,...trong sự cố ở nhà máy hạt nhân ngầm Shinjuku thì sao?
Dialogue: 0,0:03:47.88,0:03:49.87,Default,,0000,0000,0000,,Tôi cũng chưa thu thập được gì cụ thể cả.
Dialogue: 0,0:03:51.08,0:03:53.35,Default,,0000,0000,0000,,Một cơ quan công quyền được thành lập\Nngay sau khi Nội các mới nhậm chức...
Dialogue: 0,0:03:54.35,0:03:58.65,Default,,0000,0000,0000,,Hơn nữa, đám người đó lại có mối quan hệ rất sâu rộng\Nvới Lực lượng Phòng vệ Mặt đất...
Dialogue: 0,0:03:59.19,0:04:02.92,Default,,0000,0000,0000,,11 chiếc trực thăng tự phát động cơ...
Dialogue: 0,0:04:03.70,0:04:05.56,Default,,0000,0000,0000,,Và nhóm Individual Eleven, tổ chức lộ diện lần đầu\Nnhư thể có mối liên kết ngầm giữa hai sự việc.
Dialogue: 0,0:04:06.57,0:04:10.73,Default,,0000,0000,0000,,Cộng thêm một lò phản ứng hạt nhân\Nđược giấu kín dưới lòng đất Shinjuku...
Dialogue: 0,0:04:11.04,0:04:16.03,Default,,0000,0000,0000,,Xem ra chúng ta đang phải đối mặt\Nvới cả đống rắc rối đau đầu đây.
Dialogue: 0,0:04:16.38,0:04:19.14,Default,,0000,0000,0000,,Thế còn chuyện Trưởng ban lại bị bà Thủ tướng triệu tập\Nlên diện kiến thì sao...
Dialogue: 0,0:04:19.14,0:04:22.55,Default,,0000,0000,0000,,...có phải vì đống thứ họ vừa đào bới được\Ntại lò phản ứng hạt nhân không?
Dialogue: 0,0:04:22.85,0:04:26.31,Default,,0000,0000,0000,,Đúng vậy.\NAnh có ý kiến gì à?
Dialogue: 0,0:04:26.59,0:04:29.08,Default,,0000,0000,0000,,Tất nhiên là có rồi.\NMọi người không thấy chuyện này quá vô lý sao?!
Dialogue: 0,0:04:29.35,0:04:32.92,Default,,0000,0000,0000,,Theo tôi nhớ, Đội 9 vốn được lập ra\Nđể làm một tổ chức tấn công chủ động cơ mà?
Dialogue: 0,0:04:33.53,0:04:36.52,Default,,0000,0000,0000,,Nhưng bị bà ta nắm gáy kìm kẹp thế này,
Dialogue: 0,0:04:37.03,0:04:39.63,Default,,0000,0000,0000,,thì bên ta làm sao mà\N{\i1}chủ động tấn công{\i0} cho nổi chứ!
Dialogue: 0,0:04:39.63,0:04:42.00,Default,,0000,0000,0000,,Tôi không phản đối\Nquan điểm đó của anh.
Dialogue: 0,0:04:42.87,0:04:44.57,Default,,0000,0000,0000,,Nhưng tôi tin rằng Trưởng ban\Ncũng có cùng suy nghĩ như vậy.
Dialogue: 0,0:04:44.57,0:04:46.97,Default,,0000,0000,0000,,Vậy tại sao lại thế chứ?!
Dialogue: 0,0:04:47.31,0:04:48.71,Default,,0000,0000,0000,,Theo anh, mối đe dọa lớn nhất đối với Đội 9\Nlà gì?
Dialogue: 0,0:04:48.71,0:04:52.64,Default,,0000,0000,0000,,Tự dưng lại hỏi {\i1}thế{\i0}?\NÝ cô là sao?
Dialogue: 0,0:04:53.41,0:04:55.81,Default,,0000,0000,0000,,Mối đe dọa lớn nhất của chúng ta\Nlà số lượng.
Dialogue: 0,0:04:58.05,0:05:00.88,Default,,0000,0000,0000,,Một tổ chức tinh nhuệ quy mô nhỏ như chúng ta sẽ hoàn toàn bất lực\Ntrước sự áp đảo tuyệt đối về quân số và vật lực,
Dialogue: 0,0:05:01.42,0:05:05.16,Default,,0000,0000,0000,,và sẽ bị\Nnghiền nát hoàn toàn.
Dialogue: 0,0:05:05.16,0:05:07.15,Default,,0000,0000,0000,,Nếu tình thế hiện tại thực sự là một đòn tấn công\Nđược tính toán nhắm thẳng vào chúng ta,
Dialogue: 0,0:05:07.93,0:05:12.49,Default,,0000,0000,0000,,thì anh không nghĩ rằng ở nơi nào đó,\Ncó kẻ đang bắt đầu ra tay hành động sao?
Dialogue: 0,0:05:12.76,0:05:17.57,Default,,0000,0000,0000,,Tôi tin chắc ngài đã biết việc các thanh nhiên liệu plutonium\Nđã được thu hồi trong quá trình...
Dialogue: 0,0:05:22.27,0:05:26.71,Default,,0000,0000,0000,,...tái lấp kín nhà máy hạt nhân ngầm Shinjuku?
Dialogue: 0,0:05:26.98,0:05:30.78,Default,,0000,0000,0000,,Đúng là tôi\Nđã nắm được thông tin.
Dialogue: 0,0:05:31.48,0:05:33.68,Default,,0000,0000,0000,,Thực tế là một kế hoạch tuyệt mật\Nđã được đưa ra để vận chuyển số thanh nhiên liệu này,
Dialogue: 0,0:05:33.92,0:05:38.91,Default,,0000,0000,0000,,nhưng có vẻ thông tin mật đó\Nđã bị rò rỉ tới tai bọn khủng bố.
Dialogue: 0,0:05:39.42,0:05:42.86,Default,,0000,0000,0000,,Để đáp trả hành động ngu xuẩn của chính phủ\Nđã thực hiện ngay dưới chân...
Dialogue: 0,0:05:44.70,0:05:48.27,Default,,0000,0000,0000,,...những người tị nạn đang mòn mỏi chờ đợi\Nđược giải phóng để trở thành công dân mới,
Dialogue: 0,0:05:48.27,0:05:50.54,Default,,0000,0000,0000,,chúng tôi sẽ giáng xuống\Nsự trừng phạt của thần thánh.
Dialogue: 0,0:05:50.54,0:05:53.33,Default,,0000,0000,0000,,Theo phán xét của chúng tôi, những thứ được đào bới\Ntừ mảnh đất của người tị nạn...
Dialogue: 0,0:05:53.67,0:05:57.01,Default,,0000,0000,0000,,...bằng chính đôi tay của người tị nạn thì lẽ đương nhiên\Nphải được trả về lại tay người tị nạn.
Dialogue: 0,0:05:57.01,0:06:01.31,Default,,0000,0000,0000,,Ký tên,\NIndividual Eleven.
Dialogue: 0,0:06:01.61,0:06:03.48,Default,,0000,0000,0000,,Lại còn kèm theo cả\Nbiểu tượng của chúng nữa.
Dialogue: 0,0:06:03.48,0:06:05.61,Default,,0000,0000,0000,,Sau khi nhận được lời cảnh báo đó, Lực lượng Tuần duyên\Nđã bắt quả tang một vụ buôn lậu vũ khí,
Dialogue: 0,0:06:07.45,0:06:14.48,Default,,0000,0000,0000,,nhưng dường như một lượng súng đạn khổng lồ\Nđã kịp thời được tuồn trót lọt vào đó rồi.
Dialogue: 0,0:06:14.93,0:06:19.52,Default,,0000,0000,0000,,Kế hoạch ban đầu của chúng tôi\Nlà vận chuyển bằng đường biển.
Dialogue: 0,0:06:21.37,0:06:25.96,Default,,0000,0000,0000,,Tuy nhiên, hóa đơn mua bán mà bọn khủng bố để lại\Ncho thấy chúng đang lên kế hoạch phục kích trên biển,
Dialogue: 0,0:06:26.61,0:06:31.60,Default,,0000,0000,0000,,do đó chúng tôi đã quyết định\Nthay đổi phương án vào phút chót.
Dialogue: 0,0:06:32.08,0:06:35.31,Default,,0000,0000,0000,,Và vì vậy, ngài muốn Đội 9 tiếp quản\Nviệc vận chuyển bằng đường bộ, có phải không?
Dialogue: 0,0:06:37.15,0:06:42.11,Default,,0000,0000,0000,,Đúng thế. Tổ chức của các vị\Nvốn không hề tồn tại trên giấy tờ chính thức.
Dialogue: 0,0:06:42.49,0:06:47.42,Default,,0000,0000,0000,,Tôi không thể nghĩ ra ai thích hợp hơn\Nđể vận chuyển những tàn tích từ thời tiền chiến...
Dialogue: 0,0:06:48.26,0:06:50.90,Default,,0000,0000,0000,,...vốn dĩ không được phép tồn tại\Ntrên cõi đời này.
Dialogue: 0,0:06:50.90,0:06:53.89,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:06:54.07,0:06:55.36,Default,,0000,0000,0000,,Thưa Thủ tướng, ngài có suy nghĩ gì\Nvề vấn đề này không?
Dialogue: 0,0:06:55.77,0:06:58.53,Default,,0000,0000,0000,,Tôi tin rằng...\Nđó là một quyết định đúng đắn.
Dialogue: 0,0:06:58.97,0:07:02.50,Default,,0000,0000,0000,,Tôi đã rõ.
Dialogue: 0,0:07:03.24,0:07:04.68,Default,,0000,0000,0000,,Thưa Thủ tướng, tôi mạn phép\Nhỏi ngài một câu được không?
Dialogue: 0,0:07:10.45,0:07:14.18,Default,,0000,0000,0000,,Ông cứ nói. Có chuyện gì vậy?
Dialogue: 0,0:07:14.75,0:07:16.19,Default,,0000,0000,0000,,Ngài đã biết bao nhiêu phần\Nvề sự tồn tại của lò phản ứng Shinjuku?
Dialogue: 0,0:07:16.19,0:07:20.78,Default,,0000,0000,0000,,Tôi chỉ mới biết đến nó khi nhận được báo cáo\Nrằng plutonium đã được tìm thấy.
Dialogue: 0,0:07:21.39,0:07:25.20,Default,,0000,0000,0000,,Ồ, ra vậy.\NThế thì tôi xin phép cáo lui.
Dialogue: 0,0:07:25.20,0:07:28.22,Default,,0000,0000,0000,,Chi tiết của chiến dịch lần này\Nđúng như tôi đã phổ biến ban nãy.
Dialogue: 0,0:07:35.11,0:07:38.13,Default,,0000,0000,0000,,Chúng ta sẽ tiếp nhận số plutonium phát hiện được\Ntrong nhà máy hạt nhân đó...
Dialogue: 0,0:07:38.28,0:07:40.91,Default,,0000,0000,0000,,...rồi vận chuyển an toàn ra khỏi\Nkhu tị nạn bằng đường bộ.
Dialogue: 0,0:07:40.91,0:07:43.90,Default,,0000,0000,0000,,Rốt cuộc chuyện quái quỷ gì\Nđang xảy ra ở đây thế?
Dialogue: 0,0:07:44.32,0:07:45.88,Default,,0000,0000,0000,,Đó rõ ràng là một chiến dịch khai quật tuyệt mật\Ndưới sự kiểm soát trực tiếp của chính phủ cơ mà!
Dialogue: 0,0:07:45.88,0:07:49.52,Default,,0000,0000,0000,,Vậy tại sao họ lại...
Dialogue: 0,0:07:49.52,0:07:50.79,Default,,0000,0000,0000,,Sếp già...
Dialogue: 0,0:07:50.79,0:07:52.22,Default,,0000,0000,0000,,Từ bao giờ mà chúng ta đổi nghề\Nthành chân chạy vặt cho Thủ tướng thế hả?
Dialogue: 0,0:07:52.52,0:07:56.40,Default,,0000,0000,0000,,Nhiệm vụ của chúng ta chưa từng thay đổi.
Dialogue: 0,0:07:56.40,0:07:58.60,Default,,0000,0000,0000,,Vậy thì tại sao chúng ta lại...
Dialogue: 0,0:07:58.60,0:07:59.40,Default,,0000,0000,0000,,Kẻ khác hiện đang nắm đằng chuôi,\Nchỉ đơn giản là vậy thôi.
Dialogue: 0,0:07:59.40,0:08:02.53,Default,,0000,0000,0000,,Có đúng vậy không, Trưởng ban?
Dialogue: 0,0:08:02.83,0:08:04.70,Default,,0000,0000,0000,,Này, ông là...
Dialogue: 0,0:08:09.27,0:08:10.67,Default,,0000,0000,0000,,À, xin chào mọi người.
Dialogue: 0,0:08:13.01,0:08:14.81,Default,,0000,0000,0000,,Các vị không tưởng tượng được tôi vui sướng thế nào\Nkhi được đồng hành cùng các vị trong chuyến nhảy dù đầu tiên này đâu.
Dialogue: 0,0:08:14.81,0:08:20.25,Default,,0000,0000,0000,,Gan to đấy, dám vác mặt\Nđến tận đây cơ à.
Dialogue: 0,0:08:20.45,0:08:24.32,Default,,0000,0000,0000,,Mà ý ông là sao,\N\"đồng hành\" cùng bọn này á?
Dialogue: 0,0:08:24.56,0:08:26.65,Default,,0000,0000,0000,,Tôi hiểu cảm giác của các anh mà.
Dialogue: 0,0:08:26.76,0:08:28.43,Default,,0000,0000,0000,,Tôi thề đấy, tại sao tôi lại phải đi xử lý\Nmấy cái tàn tích thời chiến vô dụng này cơ chứ?
Dialogue: 0,0:08:28.43,0:08:33.33,Default,,0000,0000,0000,,Nghĩ đến mà bực\Ncả mình.
Dialogue: 0,0:08:33.33,0:08:34.70,Default,,0000,0000,0000,,Cảm ơn vì thành tích xuất sắc\Ncủa các vị ban nãy nhé.
Dialogue: 0,0:08:35.13,0:08:37.36,Default,,0000,0000,0000,,Gã đó là ai thế?
Dialogue: 0,0:08:39.47,0:08:41.00,Default,,0000,0000,0000,,Trợ lý Đại diện Ủy ban Nghiên cứu Chiến lược Ảnh hưởng,\Nthuộc Cục Tình báo Nội các...
Dialogue: 0,0:08:41.54,0:08:45.48,Default,,0000,0000,0000,,- {\i1}Thứ lỗi vì đã giao một công việc khó chịu thế này cho các vị.{\i0}\N- ...Gohda Kazundo.
Dialogue: 0,0:08:45.61,0:08:47.94,Default,,0000,0000,0000,,Hóa ra gã là kẻ đó...
Dialogue: 0,0:08:48.85,0:08:50.34,Default,,0000,0000,0000,,Chỉ huy, đơn vị tiếp viện\Nđã rời Niihama đúng lịch trình.
Dialogue: 0,0:09:11.70,0:09:16.33,Default,,0000,0000,0000,,Vậy à? Mong là mọi chuyện sẽ yên ắng\Ncho tới khi họ đến nơi.
Dialogue: 0,0:09:16.68,0:09:20.44,Default,,0000,0000,0000,,Tôi hiểu cảm giác của anh mà...
Dialogue: 0,0:09:21.25,0:09:23.04,Default,,0000,0000,0000,,Này, nhóc.
Dialogue: 0,0:09:28.19,0:09:29.35,Default,,0000,0000,0000,,Trông chẳng khác gì mấy con khỉ trong sở thú\Nấy nhỉ?
Dialogue: 0,0:09:34.03,0:09:36.36,Default,,0000,0000,0000,,Im mồm đi!
Dialogue: 0,0:09:36.36,0:09:37.99,Default,,0000,0000,0000,,Đừng có phát ngôn điều gì\Nkhiến bọn họ nổi điên lên.
Dialogue: 0,0:09:38.30,0:09:41.07,Default,,0000,0000,0000,,Nếu họ dám vượt qua hàng rào, họ sẽ bị bắn chết\Nhoặc bị trục xuất ngay lập tức.
Dialogue: 0,0:09:41.07,0:09:43.93,Default,,0000,0000,0000,,Ngay cả {\i1}bọn họ{\i0} cũng\Nphải tự hiểu điều đó chứ.
Dialogue: 0,0:09:44.30,0:09:47.20,Default,,0000,0000,0000,,Vậy ý ông là,
Dialogue: 0,0:09:59.38,0:10:00.75,Default,,0000,0000,0000,,binh lính Phòng vệ Mặt đất đóng quân ở dưới đó\Nngay cả thứ họ đang canh gác là gì cũng không hề được biết sao?
Dialogue: 0,0:10:00.75,0:10:06.25,Default,,0000,0000,0000,,Đúng vậy. Trên đời này có rất nhiều điều\Nmà người ta không cần phải biết.
Dialogue: 0,0:10:06.43,0:10:11.02,Default,,0000,0000,0000,,Chúng tôi muốn giới hạn số người biết sự thật\Nở mức tối thiểu...
Dialogue: 0,0:10:11.70,0:10:15.10,Default,,0000,0000,0000,,...để có thể tiến hành thao túng dư luận\Nnhanh nhất có thể ngay sau khi hoàn thành.
Dialogue: 0,0:10:15.20,0:10:18.70,Default,,0000,0000,0000,,Thế thì tại sao người của Cục Tình báo các người\Nkhông tự mình thực hiện toàn bộ chiến dịch đi?!
Dialogue: 0,0:10:18.70,0:10:23.11,Default,,0000,0000,0000,,- Trước hết thì...\N- Togusa.
Dialogue: 0,0:10:23.41,0:10:24.97,Default,,0000,0000,0000,,Tôi chắc chắn đây là lần đầu chúng ta gặp mặt, nhưng\Ntôi cảm thấy hình như vừa thấy cậu ở đâu gần đây...
Dialogue: 0,0:10:29.92,0:10:34.51,Default,,0000,0000,0000,,Ishikawa!
Dialogue: 0,0:10:35.52,0:10:36.61,Default,,0000,0000,0000,,Ừ. Bọn tôi sắp\Nđến nơi rồi.
Dialogue: 0,0:10:36.76,0:10:39.28,Default,,0000,0000,0000,,Saito, Paz, Borma.
Dialogue: 0,0:10:39.62,0:10:41.43,Default,,0000,0000,0000,,Sau khi kiếm được xe tải,\Nhãy hội quân với bọn tôi trước 22 giờ.
Dialogue: 0,0:10:41.43,0:10:44.86,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:10:45.20,0:10:46.29,Default,,0000,0000,0000,,Mang cả Tachikoma\Ntheo nữa.
Dialogue: 0,0:10:46.53,0:10:47.86,Default,,0000,0000,0000,,Tôi buộc phải cấm sử dụng\Nxe tăng tư duy trong chiến dịch lần này.
Dialogue: 0,0:10:48.67,0:10:52.57,Default,,0000,0000,0000,,Cái thằng cha này...
Dialogue: 0,0:10:52.57,0:10:53.77,Default,,0000,0000,0000,,Tôi không muốn làm kích động\Nđám người tị nạn.
Dialogue: 0,0:10:54.47,0:10:56.37,Default,,0000,0000,0000,,Ông Gohda.
Dialogue: 0,0:11:10.42,0:11:11.68,Default,,0000,0000,0000,,Tôi hiểu ông là người nắm quyền chỉ huy tối cao\Ntrong chiến dịch lần này,
Dialogue: 0,0:11:12.76,0:11:15.85,Default,,0000,0000,0000,,nhưng ông phải tuân thủ tuyệt đối chỉ thị của chúng tôi\Nkhi chúng ta đang ở ngoài thực địa.
Dialogue: 0,0:11:16.16,0:11:18.76,Default,,0000,0000,0000,,Bằng không, tôi không thể đảm bảo\Ntính mạng cho ông đâu.
Dialogue: 0,0:11:18.76,0:11:20.89,Default,,0000,0000,0000,,Nhảy dù đôi\Nvới Batou đằng kia đi.
Dialogue: 0,0:11:23.37,0:11:25.20,Default,,0000,0000,0000,,Tôi rất mong chờ đấy.
Dialogue: 0,0:11:26.30,0:11:27.67,Default,,0000,0000,0000,,Bọn tôi nhảy trước đây!
Dialogue: 0,0:11:28.21,0:11:29.50,Default,,0000,0000,0000,,Chà, chắc bọn mình cũng nên\Nxuất phát thôi.
Dialogue: 0,0:11:32.48,0:11:34.48,Default,,0000,0000,0000,,Tôi vốn không ưa mấy trò cảm giác mạnh\Nkiểu này cho lắm.
Dialogue: 0,0:11:34.48,0:11:36.38,Default,,0000,0000,0000,,Nghe thấy thế tôi mừng lắm đấy.
Dialogue: 0,0:11:36.72,0:11:38.31,Default,,0000,0000,0000,,Được rồi, xuất phát!
Dialogue: 0,0:11:41.92,0:11:43.58,Default,,0000,0000,0000,,Đừng ngồi ỳ ra đó nữa!\NDi chuyển mau!
Dialogue: 0,0:12:22.83,0:12:24.73,Default,,0000,0000,0000,,Tôi toát cả mồ hôi hột kể từ lúc nghe tin\Nthứ hàng này chính là plutonium đấy.
Dialogue: 0,0:12:38.41,0:12:44.37,Default,,0000,0000,0000,,Các anh vất vả rồi.
Dialogue: 0,0:12:45.12,0:12:46.34,Default,,0000,0000,0000,,Chúng tôi sẽ tiếp quản từ đây\Nvà đưa nó ra khỏi khu tị nạn.
Dialogue: 0,0:12:46.65,0:12:50.16,Default,,0000,0000,0000,,Tôi không thể cho các người làm thế được.
Dialogue: 0,0:12:50.16,0:12:51.32,Default,,0000,0000,0000,,Có khả năng người của tôi\Nđã bị nhiễm xạ rồi.
Dialogue: 0,0:12:51.66,0:12:54.35,Default,,0000,0000,0000,,Không sao đâu,\Nhoàn toàn không có nguy cơ đó.
Dialogue: 0,0:12:54.53,0:12:57.22,Default,,0000,0000,0000,,Mấy viên chức bàn giấy các người\Nthì biết cái quái gì cơ chứ?!
Dialogue: 0,0:12:57.30,0:12:58.96,Default,,0000,0000,0000,,Các anh có thể thiếu tin tưởng vào đám quan chức dân sự bọn tôi\Ntùy thích, nhưng đây là chính sách của chính phủ.
Dialogue: 0,0:12:59.03,0:13:03.43,Default,,0000,0000,0000,,Mỗi cơ quan đều có nhiệm vụ riêng\Nphải thực hiện.
Dialogue: 0,0:13:03.84,0:13:06.37,Default,,0000,0000,0000,,Nếu không vừa lòng, anh cứ tự nhiên\Ncởi bỏ bộ quân phục đó ra.
Dialogue: 0,0:13:06.37,0:13:09.36,Default,,0000,0000,0000,,Nhưng tôi e là chừng đó vẫn chưa đủ\Nđể giúp anh an tâm.
Dialogue: 0,0:13:11.11,0:13:14.55,Default,,0000,0000,0000,,Nhân tiện, anh có thể giúp tôi\Nmột việc được không?
Dialogue: 0,0:13:14.75,0:13:17.31,Default,,0000,0000,0000,,- Hãy nói chuyện qua kênh dữ liệu đi.\N- Này!
Dialogue: 0,0:13:18.62,0:13:20.29,Default,,0000,0000,0000,,Đừng lo, dọn dẹp mớ hỗn độn vốn là phận sự\Ncủa những quan chức dân sự như bọn tôi mà.
Dialogue: 0,0:13:20.29,0:13:24.59,Default,,0000,0000,0000,,Chỉ huy, các xe tải\Nđã đến nơi rồi.
Dialogue: 0,0:13:38.24,0:13:41.21,Default,,0000,0000,0000,,Tôi hiểu rồi. Tôi sẽ cử viên phó chỉ huy\Nvà hai lính gác đi cùng.
Dialogue: 0,0:13:41.51,0:13:45.28,Default,,0000,0000,0000,,Thỏa thuận thế nhé.
Dialogue: 0,0:13:45.28,0:13:46.77,Default,,0000,0000,0000,,Được rồi. Chúng ta sẽ xuất phát ngay sau khi\Ngia cố xong lớp giáp cho xe tải.
Dialogue: 0,0:13:47.25,0:13:51.08,Default,,0000,0000,0000,,Tất cả, lên đường!
Dialogue: 0,0:14:14.31,0:14:15.70,Default,,0000,0000,0000,,Trông ghê rợn thật đấy nhỉ?
Dialogue: 0,0:15:08.46,0:15:10.49,Default,,0000,0000,0000,,Tôi không loại trừ khả năng Individual Eleven\Nđang âm mưu cướp số plutonium này,
Dialogue: 0,0:15:10.66,0:15:16.26,Default,,0000,0000,0000,,nhưng chúng không hề làm việc trực tiếp\Nvới người tị nạn.
Dialogue: 0,0:15:16.57,0:15:18.66,Default,,0000,0000,0000,,Cảnh giác cao độ luôn là lựa chọn sáng suốt nhất,\Nnhưng đừng có giật mình trước những cái bóng.
Dialogue: 0,0:15:19.17,0:15:23.04,Default,,0000,0000,0000,,Anh nói cũng có lý...
Dialogue: 0,0:15:23.37,0:15:24.84,Default,,0000,0000,0000,,Điều làm tôi lo ngại hơn cả, chính là nguồn gốc\Ncủa việc rò rỉ lộ trình vận chuyển đường biển.
Dialogue: 0,0:15:25.11,0:15:29.17,Default,,0000,0000,0000,,Đúng là vậy thật...
Dialogue: 0,0:15:29.61,0:15:30.74,Default,,0000,0000,0000,,Tôi cá là họ sẽ sốc tận óc nếu biết được\Nchiếc xe buýt này đang chở plutonium đấy.
Dialogue: 0,0:15:30.92,0:15:36.22,Default,,0000,0000,0000,,Tôi không có hứng thú\Ntán gẫu với ông.
Dialogue: 0,0:15:36.22,0:15:39.02,Default,,0000,0000,0000,,Không giống như các người, tài ăn nói ngoại giao\Nlại là sở trường của tôi đấy.
Dialogue: 0,0:15:40.33,0:15:43.89,Default,,0000,0000,0000,,Đáng yêu thật đấy...
Dialogue: 0,0:15:48.70,0:15:50.53,Default,,0000,0000,0000,,Này, anh đã nghe tin gì chưa?
Dialogue: 0,0:15:51.74,0:15:54.26,Default,,0000,0000,0000,,Bên khu dân cư\NNagasaki,
Dialogue: 0,0:15:54.77,0:15:56.91,Default,,0000,0000,0000,,mới gần đây có một bé gái tầm tuổi đó\Nđã nổ súng bắn vào một cảnh sát đấy.
Dialogue: 0,0:15:56.91,0:16:00.74,Default,,0000,0000,0000,,Ý ông là sao, định dọa dẫm\Nchính người phe mình đấy à?
Dialogue: 0,0:16:07.75,0:16:10.02,Default,,0000,0000,0000,,Người của cô trông có vẻ\Nđược huấn luyện rất bài bản đấy chứ.
Dialogue: 0,0:16:11.12,0:16:14.22,Default,,0000,0000,0000,,Đặc biệt là cô nàng chỉ huy của anh,\Ntrông đáng sợ ra phết.
Dialogue: 0,0:16:14.43,0:16:17.03,Default,,0000,0000,0000,,Tôi không nghĩ thế đâu.
Dialogue: 0,0:16:17.03,0:16:18.69,Default,,0000,0000,0000,,Nhân tiện, tại sao anh lại gia nhập\Nvào đơn vị của cô ấy thế?
Dialogue: 0,0:16:20.00,0:16:22.49,Default,,0000,0000,0000,,Không phải là anh đang đem lòng yêu cô ấy đấy chứ?\NÀ, đời nào có chuyện đó được nhỉ.
Dialogue: 0,0:16:23.60,0:16:29.30,Default,,0000,0000,0000,,{\i1}Thằng khốn này{\i0}\N{\i1}đúng là một cây hài hước thật đấy.{\i0}
Dialogue: 0,0:16:30.44,0:16:32.27,Default,,0000,0000,0000,,{\i1}Ishikawa. Kết quả quét lộ trình{\i0}\N{\i1}của chúng ta thế nào rồi?{\i0}
Dialogue: 0,0:16:32.58,0:16:34.77,Default,,0000,0000,0000,,{\i1}Tôi đang gửi dữ liệu vệ tinh{\i0}\N{\i1}sang cho cô đây.{\i0}
Dialogue: 0,0:16:34.95,0:16:36.97,Default,,0000,0000,0000,,{\i1}Đường này dẫn lên một cây cầu vượt.{\i0}\N{\i1}Thế không phải quá mạo hiểm sao?{\i0}
Dialogue: 0,0:16:39.62,0:16:42.38,Default,,0000,0000,0000,,{\i1}Chỉ cần tới được đường cao tốc cũ,{\i0}\N{\i1}các cậu sẽ thoát khỏi khu tị nạn.{\i0}
Dialogue: 0,0:16:42.95,0:16:46.25,Default,,0000,0000,0000,,{\i1}Sau đó, chỉ việc bàn giao hàng cho lực lượng{\i0}\N{\i1}đến từ Căn cứ Yokosuka là xong nhiệm vụ.{\i0}
Dialogue: 0,0:16:46.66,0:16:50.65,Default,,0000,0000,0000,,{\i1}Các tuyến đường vành đai mới là nơi{\i0}\N{\i1}cậu cần phải hết sức dè chừng.{\i0}
Dialogue: 0,0:16:51.10,0:16:54.20,Default,,0000,0000,0000,,{\i1}Hầu hết các tòa nhà quanh đó đều đã sụp đổ{\i0}\N{\i1}và bị bỏ hoang hoàn toàn,{\i0}
Dialogue: 0,0:16:54.20,0:16:56.83,Default,,0000,0000,0000,,{\i1}nên cả hai bên đường{\i0}\N{\i1}đều đã bị chặn kín mít.{\i0}
Dialogue: 0,0:16:57.20,0:16:59.14,Default,,0000,0000,0000,,{\i1}Nếu bọn khủng bố phục kích ở đó,{\i0}\N{\i1}các cậu sẽ không có cơ hội xoay sở đâu.{\i0}
Dialogue: 0,0:16:59.57,0:17:03.06,Default,,0000,0000,0000,,{\i1}Kế hoạch thế này{\i0} mà bảo {\i1}là kế hoạch à.{\i0}
Dialogue: 0,0:17:03.37,0:17:05.10,Default,,0000,0000,0000,,Tên Gohda đó\Nrốt cuộc đang tính toán cái gì chứ?
Dialogue: 0,0:17:05.71,0:17:08.37,Default,,0000,0000,0000,,{\i1}Ishikawa, sau khi rà soát xong{\i0}\N{\i1}lộ trình của bọn tôi,{\i0}
Dialogue: 0,0:17:08.68,0:17:11.08,Default,,0000,0000,0000,,{\i1}hãy kiểm tra lý lịch của gã đó xem{\i0}\N{\i1}có tìm ra được manh mối gì không.{\i0}
Dialogue: 0,0:17:11.15,0:17:12.78,Default,,0000,0000,0000,,{\i1}Ừ, tôi cũng đang tính{\i0}\N{\i1}làm đúng như vậy đây.{\i0}
Dialogue: 0,0:17:12.85,0:17:14.88,Default,,0000,0000,0000,,Đã ba mươi năm trôi qua\Nkể từ sau chiến tranh...
Dialogue: 0,0:17:28.40,0:17:30.26,Default,,0000,0000,0000,,Tôi dám cá lý do vùng Kanto bị bỏ hoang phế\Nnhư thế này suốt bao năm...
Dialogue: 0,0:17:30.64,0:17:33.43,Default,,0000,0000,0000,,...là bởi vì vấn đề người tị nạn cứ bị dây dưa\Nchưa từng được giải quyết dứt điểm.
Dialogue: 0,0:17:33.91,0:17:38.34,Default,,0000,0000,0000,,Có lẽ nó sắp sửa chạm tới\Ngiới hạn bùng nổ rồi.
Dialogue: 0,0:17:38.94,0:17:42.14,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:17:45.42,0:17:46.22,Default,,0000,0000,0000,,Tôi thấy rồi.\N{\i1}Batou.{\i0}
Dialogue: 0,0:17:46.22,0:17:47.98,Default,,0000,0000,0000,,{\i1}Bên tôi cũng thấy rồi.{\i0}\N{\i1}Tôi có linh cảm chẳng lành về chuyện này.{\i0}
Dialogue: 0,0:17:48.29,0:17:50.95,Default,,0000,0000,0000,,{\i1}Ishikawa, anh có thấy chỗ này không?{\i0}
Dialogue: 0,0:18:05.20,0:18:07.26,Default,,0000,0000,0000,,{\i1}Có. Chuyện gì thế,{\i0}\N{\i1}xe của họ bị lật à?{\i0}
Dialogue: 0,0:18:07.71,0:18:09.50,Default,,0000,0000,0000,,{\i1}Chưa rõ thế nào.{\i0}\N{\i1}Tôi sẽ qua kiểm tra xem sao.{\i0}
Dialogue: 0,0:18:09.81,0:18:12.17,Default,,0000,0000,0000,,Xét từ góc độ an toàn,\Nchúng ta nên đi đường vòng.
Dialogue: 0,0:18:13.51,0:18:16.41,Default,,0000,0000,0000,,Xem xét tính chất đặc thù\Ncủa món hàng chúng ta đang chở,
Dialogue: 0,0:18:16.81,0:18:19.42,Default,,0000,0000,0000,,chúng ta phải nỗ lực tối đa để tránh bất kỳ điều gì\Ncó thể dẫn tới một cuộc giao tranh.
Dialogue: 0,0:18:19.42,0:18:24.35,Default,,0000,0000,0000,,Tôi biết điều đó chứ. Đó là lý do vì sao\Nchúng ta ngụy trang để trà trộn vào đây.
Dialogue: 0,0:18:24.69,0:18:28.09,Default,,0000,0000,0000,,Chúng ta sẽ đi do thám\Ntình hình trước.
Dialogue: 0,0:18:28.09,0:18:29.86,Default,,0000,0000,0000,,Nhưng nếu có khủng bố trà trộn vào đám người đó,\Nthì chúng ta chỉ còn cách chuẩn bị cho tình huống xấu nhất thôi.
Dialogue: 0,0:18:29.86,0:18:33.97,Default,,0000,0000,0000,,Được thôi.\NVậy cô sẽ cử ai đi?
Dialogue: 0,0:18:33.97,0:18:36.30,Default,,0000,0000,0000,,Tôi và Saito sẽ đi.\NBatou, anh chỉ huy ở đây.
Dialogue: 0,0:18:36.50,0:18:39.77,Default,,0000,0000,0000,,Được rồi, tôi cũng sẽ đi cùng. Cô không ngờ được đâu,\Nnhưng tôi khá được lòng người tị nạn đấy.
Dialogue: 0,0:18:40.17,0:18:44.74,Default,,0000,0000,0000,,Ta sẽ mang theo một lính Phòng vệ nữa.\NNgười của cô có vẻ quá hiếu chiến.
Dialogue: 0,0:18:44.74,0:18:49.08,Default,,0000,0000,0000,,Ở đây đã xảy ra chuyện gì thế?
Dialogue: 0,0:19:01.23,0:19:02.62,Default,,0000,0000,0000,,Không nhìn thấy sao?
Dialogue: 0,0:19:02.89,0:19:04.36,Default,,0000,0000,0000,,Các người đến từ\Nkhu vực phía tây à?
Dialogue: 0,0:19:04.36,0:19:05.96,Default,,0000,0000,0000,,Đại loại thế. Chúng tôi muốn tiếp tục lên đường\Ncàng sớm càng tốt.
Dialogue: 0,0:19:05.96,0:19:08.56,Default,,0000,0000,0000,,Bọn tôi cũng vậy.
Dialogue: 0,0:19:09.57,0:19:11.54,Default,,0000,0000,0000,,Rất tiếc, nhưng bọn tôi không có thời gian\Nđể nán lại giúp một tay đâu.
Dialogue: 0,0:19:12.07,0:19:14.47,Default,,0000,0000,0000,,Bọn tôi sẽ\Nđi thẳng qua đây.
Dialogue: 0,0:19:14.47,0:19:16.31,Default,,0000,0000,0000,,Tùy các người.
Dialogue: 0,0:19:16.31,0:19:17.74,Default,,0000,0000,0000,,{\i1}Khoảng trống bên cạnh xe tải đủ rộng{\i0}\N{\i1}để chiếc xe buýt có thể lách qua.{\i0}
Dialogue: 0,0:19:17.74,0:19:20.71,Default,,0000,0000,0000,,{\i1}Tiến vào thật chậm, nếu có gì bất thường,{\i0}\N{\i1}hãy tông thẳng vượt qua và bỏ mặc bọn tôi lại.{\i0}
Dialogue: 0,0:19:21.15,0:19:25.42,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:19:25.42,0:19:26.58,Default,,0000,0000,0000,,{\i1}Tình hình có vẻ an toàn.{\i0}\N{\i1}Tiếp tục di chuyển đi.{\i0}
Dialogue: 0,0:19:44.64,0:19:47.10,Default,,0000,0000,0000,,Gì thế này?
Dialogue: 0,0:19:55.41,0:19:56.61,Default,,0000,0000,0000,,{\i1}Batou!{\i0}
Dialogue: 0,0:19:57.82,0:19:59.08,Default,,0000,0000,0000,,Quân tiếp viện đấy à?
Dialogue: 0,0:20:01.05,0:20:02.28,Default,,0000,0000,0000,,Kìa, tên đó\Nđang mang súng kìa.
Dialogue: 0,0:20:06.76,0:20:09.35,Default,,0000,0000,0000,,Togusa! Đạp hết ga đi!
Dialogue: 0,0:20:15.43,0:20:16.99,Default,,0000,0000,0000,,Lên xe mau!
Dialogue: 0,0:20:25.54,0:20:26.64,Default,,0000,0000,0000,,Tình hình thế nào rồi?
Dialogue: 0,0:20:40.19,0:20:41.03,Default,,0000,0000,0000,,- Đã an toàn.\N- Tất cả đã an toàn.
Dialogue: 0,0:20:41.03,0:20:42.09,Default,,0000,0000,0000,,Đã an toàn.
Dialogue: 0,0:20:42.09,0:20:43.22,Default,,0000,0000,0000,,Chuyện này không đúng...
Dialogue: 0,0:20:44.66,0:20:46.56,Default,,0000,0000,0000,,Họ chỉ là người tị nạn bình thường thôi sao?
Dialogue: 0,0:20:47.27,0:20:49.70,Default,,0000,0000,0000,,Vậy là mọi vụ giết chóc ban nãy\Nđều hoàn toàn vô nghĩa.
Dialogue: 0,0:20:50.23,0:20:52.03,Default,,0000,0000,0000,,Làm tốt lắm, mọi người.
Dialogue: 0,0:21:28.67,0:21:30.57,Default,,0000,0000,0000,,Có vẻ thông tin tình báo về bọn khủng bố có vũ trang\Nchỉ là một đòn hù dọa hư trương thanh thế thôi.
Dialogue: 0,0:21:30.81,0:21:34.04,Default,,0000,0000,0000,,May mắn thay, toàn bộ công sức phòng bị ban nãy\Ncoi như uổng công vô ích.
Dialogue: 0,0:21:34.21,0:21:36.41,Default,,0000,0000,0000,,Ông Aramaki.
Dialogue: 0,0:21:39.82,0:21:41.18,Default,,0000,0000,0000,,Trưởng ban Aramaki.
Dialogue: 0,0:21:41.39,0:21:46.72,Default,,0000,0000,0000,,Tôi rất cảm kích trước nỗ lực tuyệt vời mà ông và\NĐội 9 đã một lần nữa thực hiện thay cho tôi.
Dialogue: 0,0:21:46.82,0:21:48.29,Default,,0000,0000,0000,,Ông đang định giở trò\Nchâm biếm đấy à?
Dialogue: 0,0:21:48.99,0:21:50.65,Default,,0000,0000,0000,,Không hề, tôi nói thật lòng đấy.
Dialogue: 0,0:21:59.30,0:22:00.17,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:22:00.34,0:22:01.67,Default,,0000,0000,0000,,Đừng có mở mấy cái thùng đó ra!
Dialogue: 0,0:22:07.11,0:22:08.88,Default,,0000,0000,0000,,Thằng khốn kiếp,\Nbản nãy mày...
Dialogue: 0,0:22:08.88,0:22:12.51,Default,,0000,0000,0000,,Đơn vị dã chiến thứ hai của Lực lượng Phòng vệ\Nrời khỏi trại tị nạn...
Dialogue: 0,0:22:12.82,0:22:15.55,Default,,0000,0000,0000,,...chắc hẳn lúc này đã đưa toàn bộ số plutonium\Nra khơi bằng đường biển an toàn rồi.
Dialogue: 0,0:22:15.75,0:22:18.02,Default,,0000,0000,0000,,Hóa ra, mày đã dùng bọn tao\Nlàm mồi nhử.
Dialogue: 0,0:22:18.02,0:22:20.51,Default,,0000,0000,0000,,Mày nghĩ bọn tao\Nlà ai hả thằng khốn?!
Dialogue: 0,0:22:20.79,0:22:24.12,Default,,0000,0000,0000,,Không, câu hỏi đúng ở đây là, các người\Nnghĩ {\i1}bản thân mình{\i0} là ai cơ chứ?
Dialogue: 0,0:22:24.20,0:22:27.03,Default,,0000,0000,0000,,Một đơn vị tinh nhuệ quy mô nhỏ ư?\NNhững kẻ được số phận chọn lựa sao?
Dialogue: 0,0:22:27.33,0:22:32.77,Default,,0000,0000,0000,,Nếu đám người tị nạn đồng loạt ùa tới tấn công các người\Nbằng số vũ khí buôn lậu đó,
Dialogue: 0,0:22:33.07,0:22:35.00,Default,,0000,0000,0000,,các người sẽ không tài nào ngăn cản nổi bọn chúng,\Nvà bản thân các người cũng tự hiểu rõ điều đó!
Dialogue: 0,0:22:35.57,0:22:40.14,Default,,0000,0000,0000,,Hãy cảm thấy biết ơn vì các người đã được đóng vai\Nnhững con mồi nhử dưới sự đạo diễn tài tình của tôi đi.
Dialogue: 0,0:22:40.51,0:22:42.48,Default,,0000,0000,0000,,Tôi xin phép cáo từ.
Dialogue: 0,0:22:42.48,0:22:44.48,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.43,0:23:10.93,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(400,0)}Khám phá ra cả một dải ngân hà...
Dialogue: 0,0:23:10.93,0:23:14.89,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...bao hành tinh và tinh tú sâu thẳm trong tôi...
Dialogue: 0,0:23:15.08,0:23:17.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Lắng nghe từng vì sao ấy...
Dialogue: 0,0:23:17.55,0:23:21.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}...ngân vang khúc ca thầm lặng đồng điệu...
Dialogue: 0,0:23:21.54,0:23:25.55,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Chưa bao giờ tôi thấy vẻ đẹp nào tuyệt mỹ đến thế...
Dialogue: 0,0:23:25.55,0:23:28.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Ẩn chứa trong vô vàn khả năng...
Dialogue: 0,0:23:28.84,0:23:33.35,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}Chẳng còn chút hoài nghi hay sợ hãi nào...
Dialogue: 0,0:23:33.35,0:23:34.84,GitS 2nd Gig ED Credits,,0000,0000,0000,,Thức tỉnh đi!
Dialogue: 0,0:23:34.84,0:23:37.54,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:23:37.54,0:23:41.48,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:23:41.48,0:23:43.99,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:23:43.99,0:23:47.52,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:23:47.52,0:23:50.86,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:23:50.86,0:23:55.66,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:23:55.66,0:24:01.47,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Vẻ đẹp tiềm ẩn bên trong lớp vỏ bọc...
Dialogue: 0,0:24:01.47,0:24:04.17,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nghe thấy một thanh âm,
Dialogue: 0,0:24:04.17,0:24:08.11,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}nghe thấy tiếng gọi vọng về phía tôi...
Dialogue: 0,0:24:08.11,0:24:10.62,GitS 2nd Gig ED Credits,,0000,0000,0000,,Tôi nhìn sâu vào bên trong,
Dialogue: 0,0:24:10.62,0:24:14.15,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}thấy ánh sáng luôn ôm trọn lấy tôi...
Dialogue: 0,0:24:14.15,0:24:17.49,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,500)}Mọi chân lý, tất cả những gì tôi cần...
Dialogue: 0,0:24:17.49,0:24:22.29,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,800)}...để kiến tạo thực tại này, đều nằm ở sâu thẳm bên trong...
Dialogue: 0,0:24:22.29,0:24:26.95,GitS 2nd Gig ED Credits,,0000,0000,0000,,{\fad(100,2000)}Ngay tại đây, ẩn sâu bên trong lớp vỏ bọc...

