Dialogue: 0,0:00:16.28,0:00:17.18,Default,Shinn,0,0,0,,Chết tiệt.
Dialogue: 0,0:00:25.31,0:00:29.75,Default,Kairi,0,0,0,,Trời đất. Mình vừa bấm cái gì thế này?
Dialogue: 0,0:00:32.04,0:00:33.59,Default,Kairi,0,0,0,,Thôi làm lại ván nữa vậy.
Dialogue: 0,0:00:38.63,0:00:42.02,Italics,Kairi,0,0,0,,Ở ngoài đảo chẳng có trò nào vui thế này cả.
Dialogue: 0,0:02:24.41,0:02:25.58,Default,Kairi,0,0,0,,Xong xuôi hết rồi.
Dialogue: 0,0:02:37.09,0:02:40.51,Default,Isana,0,0,0,,Tuyệt quá. Có điện lại rồi. \NMở quán được rồi đây.
Dialogue: 0,0:02:41.30,0:02:43.01,Default,Isana,0,0,0,,Để xem nào...
Dialogue: 0,0:02:43.01,0:02:47.22,Default,Isana,0,0,0,,Cà rốt, khoai tây, hành tây, \Ncá thu, trà và cà phê.
Dialogue: 0,0:02:47.22,0:02:51.31,Default,Isana,0,0,0,,Muối, đường phèn, mì spaghetti: \Nloại sợi mảnh và loại thường;
Dialogue: 0,0:02:51.31,0:02:54.15,Default,Isana,0,0,0,,bia, tương cà, mirin và khăn giấy.
Dialogue: 0,0:02:54.65,0:02:56.65,Default,Kairi,0,0,0,,Ước gì mình cũng được đi chợ mua đồ nhỉ.
Dialogue: 0,0:02:57.11,0:03:01.03,Default,Isana,0,0,0,,Thế thì lo mà cày cuốc hết mình ở tàu cà phê đi,
Dialogue: 0,0:03:01.03,0:03:05.20,Default,Isana,0,0,0,,thắng Dark Machine, kiếm đủ alma\Nđể mua Smart Band rồi tính...
Dialogue: 0,0:03:06.12,0:03:07.20,Default,Ryo,0,0,0,,Này, tên kia!
Dialogue: 0,0:03:07.91,0:03:10.41,Default,Ryo,0,0,0,,Sao {\i1}ngươi{\i0} lại ở đây hả?
Dialogue: 0,0:03:10.92,0:03:13.00,Default,Kairi,0,0,0,,C-Cậu là...
Dialogue: 0,0:03:14.54,0:03:15.29,Default,Kairi,0,0,0,,Mà cậu là ai thế?
Dialogue: 0,0:03:15.29,0:03:18.46,Default,Ryo,0,0,0,,Ryo của đội Arudabiru chứ ai, đồ ngốc!
Dialogue: 0,0:03:18.46,0:03:20.17,Default,Ryo,0,0,0,,Hôm nọ chúng ta vừa đấu một trận đấy!
Dialogue: 0,0:03:23.43,0:03:25.97,Default,Ryo,0,0,0,,Đừng có giả vờ như không nhớ nhé.
Dialogue: 0,0:03:25.97,0:03:28.27,Default,Ryo,0,0,0,,Hay làm một trận tái đấu ngay bây giờ luôn?
Dialogue: 0,0:03:28.85,0:03:34.31,Default,Ryo,0,0,0,,Định nói thế đấy, nhưng không như ngươi,\Nta đã giành vé vào Cúp Senki sắp tới rồi.
Dialogue: 0,0:03:34.31,0:03:35.94,Default,Ryo,0,0,0,,Ta đâu rảnh hơi chơi mấy trò vớ vẩn.
Dialogue: 0,0:03:38.03,0:03:39.74,Default,Kairi,0,0,0,,Cúp Senki là gì thế?
Dialogue: 0,0:03:39.74,0:03:42.07,Default,Isana,0,0,0,,Giải đấu lớn nhất của Dark Machine đấy.
Dialogue: 0,0:03:42.53,0:03:47.03,Default,Isana,0,0,0,,Tiền thưởng khổng lồ, mà ở trận chung kết\Ncòn được thách đấu cả Senki đương nhiệm nữa.
Dialogue: 0,0:03:47.03,0:03:49.83,Default,Kairi,0,0,0,,Senki đương nhiệm ư? Làm sao để đăng ký?
Dialogue: 0,0:03:49.83,0:03:54.71,Default,Isana,0,0,0,,Đấu theo đội đấy, nên trước hết\Nem phải thuyết phục được Shinn với Bran đã.
Dialogue: 0,0:03:58.42,0:03:59.71,Default,Customer A,0,0,0,,Cho tôi gọi món với!
Dialogue: 0,0:03:59.71,0:04:02.42,Default,Customer A,0,0,0,,Một suất cơm cá thu băm namero\Nvới một cốc bia tươi lớn.
Dialogue: 0,0:04:02.42,0:04:04.51,Default,Customer E,0,0,0,,Một bia tươi cỡ vừa và một cà ri katsu lớn.
Dialogue: 0,0:04:04.51,0:04:07.18,Default,Customer B,0,0,0,,Một ly highball và dăm bông chiên katsu,\Nkèm dưa muối với súp miso nhé.
Dialogue: 0,0:04:07.18,0:04:08.97,Default,Customer C,0,0,0,,Highball trà xanh với bánh kem dâu shortcake.
Dialogue: 0,0:04:09.18,0:04:10.81,Default,Isana,0,0,0,,Có ngay đây ạ!
Dialogue: 0,0:04:12.56,0:04:15.98,Default,Isana,0,0,0,,Kairi, em đã ghi hết món khách gọi chưa?
Dialogue: 0,0:04:20.19,0:04:22.74,Default,Isana,0,0,0,,Đừng có đứng đực ra đấy! Mau làm việc đi!
Dialogue: 0,0:04:24.82,0:04:26.41,Default,Kairi,0,0,0,,E-Em xin lỗi.
Dialogue: 0,0:04:31.50,0:04:34.92,Default,Bran,0,0,0,,Shinn, tôi đã bảo ông bớt nhậu nhẹt\Nban ngày ban mặt lại rồi mà.
Dialogue: 0,0:04:36.63,0:04:38.38,Default,Shinn,0,0,0,,Đằng nào cũng có trận đấu nào đâu.
Dialogue: 0,0:04:38.38,0:04:40.21,Default,Bran,0,0,0,,Này, cái tên này...
Dialogue: 0,0:04:40.21,0:04:42.30,Default,Bran,0,0,0,,Mà bà Rudra đi đâu rồi nhỉ?
Dialogue: 0,0:04:42.30,0:04:44.05,Default,Bran,0,0,0,,Đến giờ tập luyện rồi cơ mà?
Dialogue: 0,0:04:44.34,0:04:46.80,Default,Shinn,0,0,0,,Chắc lại lượn lờ đi đâu mất hút rồi.
Dialogue: 0,0:04:54.89,0:04:57.44,Default,Loanshark A,0,0,0,,Hả? Rudra? Mụ mò đến đây làm gì?
Dialogue: 0,0:04:57.69,0:04:59.11,Default,Rudra,0,0,0,,Tao muốn vay năm triệu.
Dialogue: 0,0:05:00.23,0:05:02.86,Default,Loanshark B,0,0,0,,Mụ tưởng bọn tao sẽ cho mụ vay {\i1}thêm{\i0} chắc, con mụ đần?
Dialogue: 0,0:05:02.86,0:05:04.61,Default,Loanshark B,0,0,0,,Tính bán thận trả nợ đấy à?
Dialogue: 0,0:05:04.61,0:05:06.99,Default,Rudra,0,0,0,,Khoản vay này là của thằng nhóc này.
Dialogue: 0,0:05:08.57,0:05:10.24,Default,Loanshark A,0,0,0,,Kairi Mitake?
Dialogue: 0,0:05:10.24,0:05:13.75,Default,Loanshark A,0,0,0,,Chưa từng có lịch sử vay nợ. Không tiền án tiền sự.
Dialogue: 0,0:05:13.75,0:05:15.46,Default,Loanshark A,0,0,0,,Hồ sơ khá là sạch sẽ đấy.
Dialogue: 0,0:05:15.46,0:05:17.96,Default,Loanshark A,0,0,0,,Duyệt cái này thì dễ như bỡn.
Dialogue: 0,0:05:17.96,0:05:20.75,Default,Loanshark A,0,0,0,,Mụ đang toan tính âm mưu gì đấy à?
Dialogue: 0,0:05:26.34,0:05:28.01,Default,Ajima,0,0,0,,Lại chuyện cũ nữa sao?
Dialogue: 0,0:05:29.64,0:05:30.85,Default,Ajima,0,0,0,,Người phụ nữ đó đâu rồi?
Dialogue: 0,0:05:33.68,0:05:35.14,Default,Hannah,0,0,0,,Bà ấy hiện đang ở đây.
Dialogue: 0,0:05:36.14,0:05:38.56,Default,Rudra,0,0,0,,Tiền cược tao chuẩn bị sẵn cả rồi đây.
Dialogue: 0,0:05:38.56,0:05:40.77,Italics,Myojin,0,0,0,,Rõ rồi. Chúng tôi sẽ đến ngay.
Dialogue: 0,0:05:41.15,0:05:42.65,Default,Rudra,0,0,0,,Bọn này đợi đấy.
Dialogue: 0,0:05:47.45,0:05:50.16,Default,Customer B,0,0,0,,Cậu nhóc kia là ai thế? Lính mới à?
Dialogue: 0,0:05:50.16,0:05:53.24,Default,Customer E,0,0,0,,Thời buổi này ai lại dùng bàn phím cơ nữa chứ?\NCổ lỗ sĩ thật đấy.
Dialogue: 0,0:05:53.24,0:05:57.41,Default,Customer A,0,0,0,,Không biết có phải cổng USB không nhỉ?\NTôi chưa thấy thứ này bao giờ.
Dialogue: 0,0:05:57.41,0:05:59.04,Default,Customer C,0,0,0,,"USB" là cái gì thế?
Dialogue: 0,0:06:02.29,0:06:04.30,Default,Customer B,0,0,0,,Thằng nhóc quan sát tinh đấy.
Dialogue: 0,0:06:04.30,0:06:05.59,Default,Customer E,0,0,0,,Cũng không tồi đâu.
Dialogue: 0,0:06:05.59,0:06:07.88,Default,Customer C,0,0,0,,Nhưng di chuyển còn non tay lắm.
Dialogue: 0,0:06:08.34,0:06:11.35,Default,Bran,0,0,0,,Thì rõ rồi. Cậu ta là lính mới tò te mà.
Dialogue: 0,0:06:11.35,0:06:14.64,Default,Bran,0,0,0,,Đang tập tành thôi.
Dialogue: 0,0:06:21.44,0:06:24.44,Default,Shinn,0,0,0,,Sai lầm chí mạng. Đoạn đó phải rút lui mới đúng.
Dialogue: 0,0:06:24.69,0:06:26.69,Default,Bran,0,0,0,,Sao ông không trực tiếp chỉ dạy cậu ta đi?
Dialogue: 0,0:06:26.94,0:06:29.74,Default,Shinn,0,0,0,,Dẹp đi. Tôi còn khối việc hay hơn để làm.
Dialogue: 0,0:06:29.74,0:06:31.95,Default,Bran,0,0,0,,Ý ông là ngồi nốc rượu cả ngày chứ gì?
Dialogue: 0,0:06:33.87,0:06:36.08,Default,Isana,0,0,0,,A, chị Rudra. Chị về rồi à.
Dialogue: 0,0:06:36.54,0:06:38.12,Default,Rudra,0,0,0,,Thằng nhóc đâu rồi?
Dialogue: 0,0:06:38.12,0:06:39.54,Default,Bran,0,0,0,,Đang tập...
Dialogue: 0,0:06:39.54,0:06:41.46,Default,Bran,0,0,0,,À mà có vẻ xong rồi đấy.
Dialogue: 0,0:06:43.75,0:06:47.34,Default,Rudra,0,0,0,,Kairi, thẻ công dân của nhóc đây.
Dialogue: 0,0:06:47.34,0:06:48.22,Default,Rudra,0,0,0,,Cầm lấy cho cẩn thận.
Dialogue: 0,0:06:49.55,0:06:51.14,Default,Kairi,0,0,0,,Dạ... cảm ơn chị.
Dialogue: 0,0:06:54.72,0:06:56.43,Default,Rudra,0,0,0,,Để xem nào...
Dialogue: 0,0:06:56.43,0:06:58.68,Default,Rudra,0,0,0,,Chị vừa kiếm cho mấy đứa một kèo đấu.
Dialogue: 0,0:06:59.48,0:07:01.02,Default,Shinn,0,0,0,,Kèo đấu ư? Ý chị là...
Dialogue: 0,0:07:01.02,0:07:02.60,Default,Bran,0,0,0,,Tiền cược bao nhiêu?
Dialogue: 0,0:07:02.94,0:07:04.36,Default,Rudra,0,0,0,,Năm triệu alma.
Dialogue: 0,0:07:04.61,0:07:05.94,Default,Bran,0,0,0,,Tôi nhận kèo.
Dialogue: 0,0:07:05.94,0:07:08.57,Default,Shinn,0,0,0,,Khoản tiền cược hời phết đấy.
Dialogue: 0,0:07:08.57,0:07:09.86,Default,Shinn,0,0,0,,Đối thủ là ai thế?
Dialogue: 0,0:07:09.86,0:07:12.07,Default,Rudra,0,0,0,,Họ sắp tới đây rồi.
Dialogue: 0,0:07:12.45,0:07:15.58,Default,Rudra,0,0,0,,Chuẩn bị xong chưa, Kairi? Vào trận thôi.
Dialogue: 0,0:07:15.58,0:07:16.37,Default,Kairi,0,0,0,,Hả?
Dialogue: 0,0:07:16.62,0:07:19.87,Default,Bran,0,0,0,,Khoan đã. Chị lại muốn bọn tôi chung đội\Nvới cái tên gà mờ này nữa đấy à?
Dialogue: 0,0:07:19.87,0:07:21.33,Default,Bran,0,0,0,,Tôi xin kiếu.
Dialogue: 0,0:07:21.33,0:07:22.75,Default,Shinn,0,0,0,,Một tên lính mới không gánh nổi kèo này đâu.
Dialogue: 0,0:07:23.08,0:07:26.80,Default,Bran,0,0,0,,Với số tiền cược lớn như thế,\Nbọn tôi cần đồng đội có thể thắng cơ.
Dialogue: 0,0:07:26.80,0:07:29.17,Default,Bran,0,0,0,,Này Shinn. Ông có quen ai không?
Dialogue: 0,0:07:29.17,0:07:32.01,Default,Shinn,0,0,0,,Hả? Chẳng ai thèm bắt cặp với tôi đâu.
Dialogue: 0,0:07:32.01,0:07:34.55,Default,Bran,0,0,0,,Làm như tôi thì khá hơn chắc.
Dialogue: 0,0:07:34.55,0:07:37.56,Default,Bran,0,0,0,,Này Rudra. Chị không tìm được\Ngame thủ nào cứng tay hơn—
Dialogue: 0,0:07:37.56,0:07:39.02,Default,Rudra,0,0,0,,Bớt bép xép mồm lại!
Dialogue: 0,0:07:40.27,0:07:42.44,Default,Both,0,0,0,,Ui da!
Dialogue: 0,0:07:42.44,0:07:44.27,Default,Rudra,0,0,0,,Cứ lo đấu đi.
Dialogue: 0,0:07:44.73,0:07:47.90,Default,Rudra,0,0,0,,Dù sao thì chính thằng lính mới này\Nđang bỏ tiền túi ra cược đấy chứ ai.
Dialogue: 0,0:07:49.23,0:07:50.90,Default,Bran,0,0,0,,Khoan, cậu giàu thế cơ à?
Dialogue: 0,0:07:51.36,0:07:53.36,Default,Kairi,0,0,0,,Chuyện này em mới nghe lần đầu luôn...
Dialogue: 0,0:07:53.36,0:07:58.66,Default,Isana,0,0,0,,Khoan đã chị Rudra. Chị lấy thẻ căn cước\Ncủa Kairi đi vay nóng đấy à?!
Dialogue: 0,0:07:59.91,0:08:02.04,Default,Rudra,0,0,0,,Chuẩn rồi. Đoán hay đấy.
Dialogue: 0,0:08:02.04,0:08:03.54,Default,Bran,0,0,0,,Trời đất quỷ thần ơi.
Dialogue: 0,0:08:03.54,0:08:05.38,Default,Shinn,0,0,0,,Chị đúng là quá quắt thật.
Dialogue: 0,0:08:10.67,0:08:12.13,Default,Customer C,0,0,0,,Cái gì? Không thể nào.
Dialogue: 0,0:08:12.13,0:08:13.47,Default,Customer D,0,0,0,,Sao {\i1}họ{\i0} lại đến đây chứ?
Dialogue: 0,0:08:13.47,0:08:14.55,Default,Customer A,0,0,0,,Không thể tin được.
Dialogue: 0,0:08:14.55,0:08:16.68,Default,Customer E,0,0,0,,Thôi đi. Đùa nhau chắc?
Dialogue: 0,0:08:17.76,0:08:18.85,Default,Rudra,0,0,0,,A, đến rồi đấy à.
Dialogue: 0,0:08:20.06,0:08:22.56,Default,Bran,0,0,0,,Ý chị là đối thủ chúng ta phải đấu...
Dialogue: 0,0:08:22.81,0:08:26.31,Default,Myojin,0,0,0,,Chào Shinn. Lâu rồi không gặp.
Dialogue: 0,0:08:26.31,0:08:29.07,Default,Shinn,0,0,0,,Myojin, cậu...
Dialogue: 0,0:08:33.90,0:08:35.70,Flashback,Ajima,0,0,0,,Myojin, chuẩn bị đi.
Dialogue: 0,0:08:35.99,0:08:37.20,Flashback,Myojin,0,0,0,,Rõ ạ.
Dialogue: 0,0:08:42.50,0:08:43.50,Flashback,Myojin,0,0,0,,Tuyệt.
Dialogue: 0,0:08:46.83,0:08:47.88,Flashback,Shinn,0,0,0,,Tôi thua rồi.
Dialogue: 0,0:08:49.13,0:08:50.38,Flashback,Shinn,0,0,0,,Dừng lại đi!
Dialogue: 0,0:08:50.88,0:08:52.51,Flashback,Myojin,0,0,0,,Chính các cậu là người đặt cược cơ mà.
Dialogue: 0,0:08:56.22,0:08:58.80,Default,Myojin,0,0,0,,Chuyện đó cũng mấy tháng trước rồi nhỉ?
Dialogue: 0,0:08:58.80,0:09:01.01,Default,Myojin,0,0,0,,Mừng vì thấy cậu vẫn còn sống tốt.
Dialogue: 0,0:09:01.01,0:09:02.56,Default,Shinn,0,0,0,,Khốn nạn thật.
Dialogue: 0,0:09:02.56,0:09:04.64,Default,Shinn,0,0,0,,Này Rudra. Chị nghĩ cái quái gì thế hả?
Dialogue: 0,0:09:05.60,0:09:10.44,Default,Rudra,0,0,0,,Người ta có câu "đời buồn chán\Nthì tự đi mà tìm niềm vui" còn gì.
Dialogue: 0,0:09:10.44,0:09:12.99,Default,Rudra,0,0,0,,Đây là cơ hội tái đấu sau bao ngày mòn mỏi đấy.
Dialogue: 0,0:09:12.99,0:09:14.28,Default,Rudra,0,0,0,,Tận hưởng đi chứ, sao lại càu nhàu?
Dialogue: 0,0:09:14.28,0:09:15.95,Default,Shinn,0,0,0,,Đừng có lố bịch thế.
Dialogue: 0,0:09:15.95,0:09:19.91,Default,Shinn,0,0,0,,Bọn họ không dễ xơi như Arudabiru đâu.\NThêm một tên lính mới thì thắng thế nào được.
Dialogue: 0,0:09:19.91,0:09:23.04,Default,Myojin,0,0,0,,À phải rồi. Trận đấu với Arudabiru hôm nọ...
Dialogue: 0,0:09:23.45,0:09:27.00,Default,Myojin,0,0,0,,Cậu là người đã điều khiển dòng Wisdom đó à?
Dialogue: 0,0:09:27.00,0:09:28.42,Default,Myojin,0,0,0,,Tôi là Myojin.
Dialogue: 0,0:09:28.42,0:09:30.96,Default,Myojin,0,0,0,,Đội trưởng của Great Cluster.
Dialogue: 0,0:09:30.96,0:09:35.30,Default,Kairi,0,0,0,,Ơ, W-Wisdom ạ?
Dialogue: 0,0:09:35.30,0:09:37.80,Default,Bran,0,0,0,,Là con Mech mà cậu lái đấy.
Dialogue: 0,0:09:40.18,0:09:43.31,Default,Myojin,0,0,0,,Thôi, bọn tôi đi chuẩn bị máy móc đây.
Dialogue: 0,0:09:48.94,0:09:53.07,Default,Myojin,0,0,0,,Này Shinn. Trước trận đấu thì bớt uống rượu lại đi.
Dialogue: 0,0:09:56.87,0:10:01.25,Default,Shinn,0,0,0,,Nghe này lính mới. \NĐừng để đối phương áp sát Bran.
Dialogue: 0,0:10:01.25,0:10:02.59,Default,Shinn,0,0,0,,Đó là nhiệm vụ duy nhất của cậu.
Dialogue: 0,0:10:02.59,0:10:03.88,Default,Kairi,0,0,0,,Em hiểu rồi.
Dialogue: 0,0:10:03.88,0:10:06.97,Default,Shinn,0,0,0,,Myojin là át chủ bài của Great Cluster.
Dialogue: 0,0:10:07.38,0:10:12.47,Default,Shinn,0,0,0,,Hachiman và Nyudo sẽ phối hợp\Nđể dụ cậu vào tầm ngắm của Myojin.
Dialogue: 0,0:10:12.47,0:10:14.60,Default,Shinn,0,0,0,,Nếu để điều đó xảy ra,\Ncậu sẽ bị hạ đo ván chỉ trong một phát bắn.
Dialogue: 0,0:10:14.60,0:10:15.97,Default,Kairi,0,0,0,,Dụ bọn em ư?
Dialogue: 0,0:10:16.43,0:10:18.56,Default,Shinn,0,0,0,,Giờ không tiện giải thích chi tiết.
Dialogue: 0,0:10:18.94,0:10:20.85,Default,Shinn,0,0,0,,Cứ tập trung bảo vệ Bran là được.
Dialogue: 0,0:10:21.31,0:10:23.02,Default,Bran,0,0,0,,Hiểu chưa, đồ lính mới?
Dialogue: 0,0:10:23.02,0:10:26.49,Default,Bran,0,0,0,,Dám cản tầm bắn giữa tôi với mục tiêu,\Ntôi bắn lủng người cậu luôn đấy.
Dialogue: 0,0:10:26.49,0:10:28.24,Default,Kairi,0,0,0,,V-Vâng ạ.
Dialogue: 0,0:10:28.86,0:10:32.49,Default,Isana,0,0,0,,Hiếm khi thấy Shinn lại chịu chỉ đạo\Nnhiều mệnh lệnh đến thế đấy.
Dialogue: 0,0:10:32.49,0:10:34.37,Default,Rudra,0,0,0,,Thì rõ rồi.
Dialogue: 0,0:10:34.37,0:10:37.12,Default,Rudra,0,0,0,,Nó đâu muốn bị cùng một tên\Nđập cho ra bã lần thứ hai.
Dialogue: 0,0:10:37.12,0:10:40.50,Default,Isana,0,0,0,,Đó là lý do chị gửi lời mời cho Great Cluster sao?
Dialogue: 0,0:10:40.87,0:10:43.00,Default,Isana,0,0,0,,Nhưng họ đang đứng hạng hai trên bảng xếp hạng mà?
Dialogue: 0,0:10:43.00,0:10:45.00,Default,Isana,0,0,0,,Em thấy kèo này có vẻ hơi quá sức rồi.
Dialogue: 0,0:10:45.00,0:10:49.34,Default,Rudra,0,0,0,,Chúng ta không thể lãng phí thời gian\Nvới mấy đối thủ tép riu được.
Dialogue: 0,0:10:49.34,0:10:51.89,Default,Rudra,0,0,0,,Đã đánh thì phải đánh với những kẻ mạnh nhất.
Dialogue: 0,0:10:52.18,0:10:53.39,Default,Isana,0,0,0,,Thật hết nói nổi mà.
Dialogue: 0,0:10:53.80,0:10:58.64,Default,Myojin,0,0,0,,Một trong những tay lái của Carbuncle là Bran,\Ntừng thi đấu rất ấn tượng ở Esmeralda.
Dialogue: 0,0:10:58.64,0:11:01.19,Default,Myojin,0,0,0,,Shinn tuy đã rời xa đấu trường một thời gian,
Dialogue: 0,0:11:01.19,0:11:03.06,Default,Myojin,0,0,0,,nhưng tay nghề của cậu ta chắc chắn không hề lụt đi đâu.
Dialogue: 0,0:11:03.06,0:11:07.07,Default,Myojin,0,0,0,,Cứ phá vỡ đội hình của chúng trước,\Nđoạn kết liễu cứ để tôi lo như mọi khi.
Dialogue: 0,0:11:07.32,0:11:08.19,Default,Nyudo,0,0,0,,Rõ rồi.
Dialogue: 0,0:11:08.19,0:11:09.24,Default,Hachiman,0,0,0,,Đã hiểu.
Dialogue: 0,0:11:15.74,0:11:17.54,Italics,Announcer,0,0,0,,Hiệp một. Bắt đầu!
Dialogue: 0,0:11:19.96,0:11:24.00,Default,Shinn,0,0,0,,Lính mới, thu thập Tinh thể Palma đi.\NBám sát Bran đấy.
Dialogue: 0,0:11:24.58,0:11:25.59,Default,Kairi,0,0,0,,Rõ ạ.
Dialogue: 0,0:11:29.88,0:11:31.47,Default,Hachiman,0,0,0,,Tôi sẽ ra hút sự chú ý trước.
Dialogue: 0,0:11:37.14,0:11:38.52,Default,Bran,0,0,0,,Từ khoảng cách đó ư?
Dialogue: 0,0:11:38.77,0:11:39.64,Default,Shinn,0,0,0,,Để tôi lo.
Dialogue: 0,0:11:42.35,0:11:45.06,Default,Myojin,0,0,0,,Nào, để xem các cậu làm được gì.
Dialogue: 0,0:11:54.41,0:11:55.78,Default,Kairi,0,0,0,,Từ phía sau sao?!
Dialogue: 0,0:11:55.78,0:11:58.66,Default,Shinn,0,0,0,,Chẳng phải tôi đã dặn rồi sao? Chiêu bài của chúng đấy.
Dialogue: 0,0:12:00.41,0:12:02.04,Default,Nyudo,0,0,0,,Mục tiêu là ngươi!
Dialogue: 0,0:12:03.67,0:12:05.42,Default,Bran,0,0,0,,Biến khỏi mắt bà mau!
Dialogue: 0,0:12:10.05,0:12:13.55,Default,Myojin,0,0,0,,Nyudo, phiền cậu khóa chặt Bran nhé.
Dialogue: 0,0:12:13.55,0:12:15.47,Default,Myojin,0,0,0,,Tôi không muốn lọt vào tầm ngắm của cô ta đâu.
Dialogue: 0,0:12:15.80,0:12:18.93,Default,Bran,0,0,0,,Này lính mới! Người ta bảo cậu phải bảo vệ tôi cơ mà!
Dialogue: 0,0:12:19.35,0:12:21.47,Default,Kairi,0,0,0,,Em đang cố hết sức đây, nhưng...
Dialogue: 0,0:12:32.69,0:12:36.57,Default,Myojin,0,0,0,,Né đòn đẹp đấy. Mắt quan sát tốt đấy chứ.
Dialogue: 0,0:12:36.82,0:12:40.70,Default,Shinn,0,0,0,,Bắn chuẩn xác thật. \NMyojin quả nhiên là...
Dialogue: 0,0:12:52.59,0:12:53.47,Default,Shinn,0,0,0,,Cái gì?!
Dialogue: 0,0:12:56.09,0:12:57.59,Default,Myojin,0,0,0,,Cậu quá nôn nóng rồi.
Dialogue: 0,0:13:01.85,0:13:04.14,Default,Shinn,0,0,0,,Myojin, ta nhất định sẽ hạ gục cậu!
Dialogue: 0,0:13:06.14,0:13:08.77,Default,Customer A,0,0,0,,Shinn đang hăng máu thật đấy nhỉ?
Dialogue: 0,0:13:08.77,0:13:11.02,Default,Customer B,0,0,0,,Đánh gắt quá đâm ra loạn cào cào cả lên.
Dialogue: 0,0:13:13.40,0:13:16.07,Default,Rudra,0,0,0,,Lũ ngốc này.
Dialogue: 0,0:13:17.95,0:13:19.12,Italics,Announcer,0,0,0,,Hết hiệp một.
Dialogue: 0,0:13:22.66,0:13:23.95,Default,Shinn,0,0,0,,Chết tiệt.
Dialogue: 0,0:13:26.75,0:13:28.46,Default,Rudra,0,0,0,,Mấy cái đầu bã đậu, lũ ngốc nghếch này!
Dialogue: 0,0:13:28.46,0:13:29.54,Default,Kairi,0,0,0,,Đầu bã đậu ạ?
Dialogue: 0,0:13:29.54,0:13:33.38,Default,Rudra,0,0,0,,Sao nhóc cứ liên tục phạm sai lầm thế hả,\Nthằng lính mới đần độn kia?
Dialogue: 0,0:13:33.38,0:13:36.30,Default,Rudra,0,0,0,,Nhóc có {\i1}muốn{\i0} thắng không đấy hả?\NCó dũng khí lên một chút xem nào!
Dialogue: 0,0:13:36.30,0:13:38.05,Default,Kairi,0,0,0,,E-Em xin lỗi.
Dialogue: 0,0:13:38.05,0:13:41.18,Default,Rudra,0,0,0,,Shinn, cậu vào trận mà cái đầu nóng như lửa thế à?
Dialogue: 0,0:13:41.18,0:13:43.68,Default,Rudra,0,0,0,,Cậu quên mất hai chữ "phối hợp" rồi đấy à?
Dialogue: 0,0:13:44.02,0:13:49.94,Default,Rudra,0,0,0,,Bran, cô có phải xạ thủ không thế?\NBắn mà không {\i1}trúng{\i0} đối thủ thì bắn làm cái thá gì?!
Dialogue: 0,0:13:49.94,0:13:51.31,Default,Rudra,0,0,0,,Chán chẳng buồn nói.
Dialogue: 0,0:13:51.31,0:13:54.57,Default,Rudra,0,0,0,,Đúng là một lũ quạ chắp vá, ô hợp!
Dialogue: 0,0:13:54.57,0:13:56.36,Default,Kairi,0,0,0,,L-Lũ quạ ạ?
Dialogue: 0,0:13:56.65,0:13:59.57,Default,Bran,0,0,0,,Tôi đã bảo tên lính mới này chẳng làm nên trò trống gì rồi mà!
Dialogue: 0,0:13:59.57,0:14:00.70,Default,Rudra,0,0,0,,Ngậm cái miệng lại!
Dialogue: 0,0:14:00.70,0:14:03.62,Default,Rudra,0,0,0,,Nhẫn nhịn mới mong sống thọ!
Dialogue: 0,0:14:03.62,0:14:06.33,Default,Rudra,0,0,0,,Nóng giận là không chấp nhận được, chết tiệt.
Dialogue: 0,0:14:06.33,0:14:08.71,Default,Isana,0,0,0,,Ơ kìa chị Rudra, câu đó phát ra từ miệng chị\Nchẳng có tí thuyết phục nào cả.
Dialogue: 0,0:14:12.00,0:14:15.55,Default,Myojin,0,0,0,,Tên lính mới Kairi kia có vài pha xử lý khá đấy,
Dialogue: 0,0:14:15.55,0:14:17.05,Default,Myojin,0,0,0,,nhưng hạ cậu ta thì quá dễ dàng.
Dialogue: 0,0:14:17.63,0:14:19.09,Default,Myojin,0,0,0,,Cứ giữ vững phong độ ở hiệp hai nhé.
Dialogue: 0,0:14:19.09,0:14:22.76,Default,Myojin,0,0,0,,Hai cậu cứ khuấy đảo đội hình rồi lùa chúng\Nvào đúng vị trí tôi cần.
Dialogue: 0,0:14:22.76,0:14:24.35,Default,Myojin,0,0,0,,Dứt điểm trận này thôi.
Dialogue: 0,0:14:24.35,0:14:25.22,Default,Nyudo,0,0,0,,Rõ.
Dialogue: 0,0:14:24.35,0:14:25.22,Default,Hachiman,0,0,0,,{\an8}Đã hiểu.
Dialogue: 0,0:14:27.48,0:14:29.56,Italics,Announcer,0,0,0,,Hiệp hai. Bắt đầu!
Dialogue: 0,0:14:31.60,0:14:34.48,Default,Bran,0,0,0,,Lính mới, bám theo Shinn đi.
Dialogue: 0,0:14:35.48,0:14:37.74,Default,Shinn,0,0,0,,Hả? Sao lại thế?
Dialogue: 0,0:14:37.74,0:14:40.41,Default,Bran,0,0,0,,Ông muốn đấu với Myojin chứ gì?
Dialogue: 0,0:14:40.41,0:14:43.12,Default,Bran,0,0,0,,Dù sao ban nãy một mình tôi vẫn trụ tốt.
Dialogue: 0,0:14:43.49,0:14:46.12,Default,Bran,0,0,0,,Dù là lính mới thì cũng hút đòn được cơ mà?
Dialogue: 0,0:14:48.20,0:14:49.50,Default,Shinn,0,0,0,,Bám sát đấy, lính mới.
Dialogue: 0,0:14:49.50,0:14:50.75,Default,Kairi,0,0,0,,Rõ ạ!
Dialogue: 0,0:14:53.25,0:14:56.17,Default,Myojin,0,0,0,,Hạ gục chúng một thể nào.
Dialogue: 0,0:14:58.17,0:14:59.92,Default,Nyudo,0,0,0,,Bắt đầu từ tên kia trước chứ?
Dialogue: 0,0:15:01.30,0:15:03.18,Default,Hachiman,0,0,0,,Xử lý từng đứa một à?
Dialogue: 0,0:15:05.10,0:15:06.43,Default,Kairi,0,0,0,,Em sẽ hút hỏa lực của chúng!
Dialogue: 0,0:15:06.85,0:15:07.77,Default,Shinn,0,0,0,,Cảm ơn.
Dialogue: 0,0:15:08.85,0:15:13.19,Italics,Shinn,0,0,0,,Cả hai tên kia lao ra dốc toàn lực,\Nđồng nghĩa với việc Myojin đang...
Dialogue: 0,0:15:14.06,0:15:14.69,Default,Shinn,0,0,0,,Ở đằng kia!
Dialogue: 0,0:15:14.69,0:15:16.94,Default,Shinn,0,0,0,,Bran, hướng 10 giờ! Phía sau tòa nhà!
Dialogue: 0,0:15:17.28,0:15:18.69,Default,Bran,0,0,0,,Đúng thứ tôi đang chờ đợi.
Dialogue: 0,0:15:23.49,0:15:25.28,Default,Shinn,0,0,0,,Kairi, bật Ride Shift đi!
Dialogue: 0,0:15:25.58,0:15:27.08,Default,Shinn,0,0,0,,Phối hợp để áp đảo chúng nào!
Dialogue: 0,0:15:27.08,0:15:27.91,Default,Kairi,0,0,0,,Rõ ạ!
Dialogue: 0,0:15:28.58,0:15:30.58,Default,Nyudo,0,0,0,,Có vẻ hắn ta đã bình tĩnh lại rồi.
Dialogue: 0,0:15:30.83,0:15:32.33,Default,Hachiman,0,0,0,,Chọc cho hắn điên tiết lên nào.
Dialogue: 0,0:15:37.25,0:15:40.63,Default,Myojin,0,0,0,,Một đội chắp vá mà đánh được thế này là cừ đấy.
Dialogue: 0,0:15:40.88,0:15:42.63,Default,Myojin,0,0,0,,Nhưng vẫn chưa đủ trình đâu.
Dialogue: 0,0:15:49.60,0:15:50.48,Default,Shinn,0,0,0,,Nguy rồi!
Dialogue: 0,0:15:50.48,0:15:51.85,Default,Myojin,0,0,0,,Tuyệt lắm!
Dialogue: 0,0:16:05.95,0:16:06.83,Default,Kairi,0,0,0,,Anh Shinn!
Dialogue: 0,0:16:15.29,0:16:16.46,Default,Isana,0,0,0,,Được rồi!
Dialogue: 0,0:16:16.79,0:16:18.63,Italics,Rudra,0,0,0,,Còn một phút nữa thôi.
Dialogue: 0,0:16:21.21,0:16:23.09,Default,Myojin,0,0,0,,Hachiman. Nyudo.
Dialogue: 0,0:16:23.09,0:16:25.22,Default,Myojin,0,0,0,,Tôi sẽ khử con Wisdom Type kia trước.
Dialogue: 0,0:16:28.68,0:16:30.93,Default,Kairi,0,0,0,,Chết tiệt. Nếu đã vậy thì...
Dialogue: 0,0:16:38.36,0:16:39.32,Default,Shinn,0,0,0,,Này, khoan đã!
Dialogue: 0,0:16:40.02,0:16:40.94,Default,Bran,0,0,0,,Chờ chút!
Dialogue: 0,0:16:49.08,0:16:51.58,Default,Kairi,0,0,0,,T-Tuyệt cú mèo...
Dialogue: 0,0:16:51.83,0:16:54.83,Default,Bran,0,0,0,,Cậu bật nó {\i1}ngay chỗ đó{\i0} á? Ngu vừa thôi chứ?!
Dialogue: 0,0:16:56.88,0:16:58.33,Default,Myojin,0,0,0,,Đẹp lắm.
Dialogue: 0,0:17:05.76,0:17:07.26,Default,Kairi,0,0,0,,M-Mình không cử động được!
Dialogue: 0,0:17:07.64,0:17:08.51,Default,Shinn,0,0,0,,Mau thoát ra!
Dialogue: 0,0:17:08.51,0:17:10.39,Default,Myojin,0,0,0,,Còn lâu nhé.
Dialogue: 0,0:17:10.39,0:17:11.76,Default,Myojin,0,0,0,,Seize Attack!
Dialogue: 0,0:17:26.03,0:17:29.20,Italics,Announcer,0,0,0,,Trận đấu kết thúc! Bên chiến thắng: Great Cluster.
Dialogue: 0,0:17:32.54,0:17:34.58,Default,Kairi,0,0,0,,Hả? Chúng ta thua rồi ư?
Dialogue: 0,0:17:35.33,0:17:36.46,Default,Shinn,0,0,0,,Chết tiệt.
Dialogue: 0,0:17:37.67,0:17:40.04,Default,Bran,0,0,0,,Lại tại cậu bóp dái đồng đội nên mới thua đấy!
Dialogue: 0,0:17:40.04,0:17:41.71,Default,Bran,0,0,0,,Cái thằng lính mới chết tiệt này!
Dialogue: 0,0:17:41.71,0:17:43.09,Default,Bran,0,0,0,,Khốn nạn thật!
Dialogue: 0,0:17:45.42,0:17:46.67,Default,Kairi,0,0,0,,N-Này chị...
Dialogue: 0,0:17:50.09,0:17:53.10,Default,Bran,0,0,0,,Sao cậu lại Gigant Shift {\i1}ngay chỗ đó{\i0} hả?!
Dialogue: 0,0:17:53.10,0:17:55.98,Default,Bran,0,0,0,,Đúng là đồ vô dụng! Rác rưởi! \NCái đồ não phẳng!
Dialogue: 0,0:17:56.56,0:17:59.98,Default,Bran,0,0,0,,Nếu cậu không làm trò đó thì bọn này đã thắng rồi!
Dialogue: 0,0:18:00.90,0:18:02.27,Default,Shinn,0,0,0,,Thôi, bỏ đi Bran.
Dialogue: 0,0:18:02.27,0:18:05.11,Default,Bran,0,0,0,,Im đi. Ông cũng đang sôi máu đấy thôi?!
Dialogue: 0,0:18:05.11,0:18:07.65,Default,Shinn,0,0,0,,Tôi hiểu rồi. Bình tĩnh lại đi, Bran.
Dialogue: 0,0:18:07.65,0:18:09.24,Default,Kairi,0,0,0,,E-Em xin lỗi.
Dialogue: 0,0:18:09.24,0:18:11.20,Default,Bran,0,0,0,,Cậu tưởng một câu "xin lỗi" là xong chuyện à?!
Dialogue: 0,0:18:12.08,0:18:14.29,Default,Bran,0,0,0,,Tôi chịu hết nổi cái tên đần này rồi.
Dialogue: 0,0:18:17.79,0:18:19.62,Default,Myojin,0,0,0,,Này Kairi, Shinn.
Dialogue: 0,0:18:20.46,0:18:22.59,Default,Myojin,0,0,0,,Đó là một trận đấu rất tuyệt.
Dialogue: 0,0:18:22.88,0:18:24.96,Default,Myojin,0,0,0,,Lâu lắm rồi tôi mới được chơi vui thế này.
Dialogue: 0,0:18:27.92,0:18:30.43,Default,Myojin,0,0,0,,Sau này cậu sẽ còn tiến bộ hơn nữa đấy.
Dialogue: 0,0:18:30.43,0:18:32.85,Default,Myojin,0,0,0,,Cậu chỉ cần tích lũy thêm kinh nghiệm thôi.
Dialogue: 0,0:18:33.14,0:18:34.39,Default,Kairi,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:18:34.72,0:18:37.23,Default,Kairi,0,0,0,,Hi vọng một ngày nào đó chúng ta lại được so tài.
Dialogue: 0,0:18:37.85,0:18:39.48,Default,Kairi,0,0,0,,Em sẽ đi vay thêm tiền.
Dialogue: 0,0:18:40.60,0:18:43.06,Default,Myojin,0,0,0,,Đừng đi vay. Hãy tự mình kiếm lấy.
Dialogue: 0,0:18:52.82,0:18:53.99,Default,Shinn,0,0,0,,Suýt nữa thì thắng rồi nhỉ?
Dialogue: 0,0:18:54.49,0:18:57.37,Default,Kairi,0,0,0,,Xin lỗi anh. Tại em phạm sai lầm nên đội mới thua.
Dialogue: 0,0:18:57.95,0:18:59.41,Default,Shinn,0,0,0,,Myojin lợi hại thật đấy.
Dialogue: 0,0:19:00.79,0:19:05.25,Default,Shinn,0,0,0,,Trước khi gia nhập Carbuncle,\Nanh từng dẫn đầu một đội ở Tokyo.
Dialogue: 0,0:19:06.42,0:19:10.17,Default,Shinn,0,0,0,,Bọn anh nhắm tới đỉnh cao,\Nvới đối thủ là Ajima và Myojin.
Dialogue: 0,0:19:10.17,0:19:12.47,Default,Shinn,0,0,0,,Nhưng bọn anh không tài nào đánh bại được họ.
Dialogue: 0,0:19:13.80,0:19:16.43,Flashback,Ajima,0,0,0,,Với trình độ cỡ các cậu mà dám thách đấu bọn ta...
Dialogue: 0,0:19:16.76,0:19:18.64,Flashback,Ajima,0,0,0,,Đúng là ngạo mạn không biết trời cao đất dày.
Dialogue: 0,0:19:20.39,0:19:23.27,Flashback,Ajima,0,0,0,,Theo thỏa thuận, ta sẽ bẻ nát thẻ căn cước của các cậu.
Dialogue: 0,0:19:24.06,0:19:25.06,Flashback,Ajima,0,0,0,,Tuy nhiên...
Dialogue: 0,0:19:26.48,0:19:27.53,Flashback,Shinn,0,0,0,,Ông định làm gì...
Dialogue: 0,0:19:28.03,0:19:29.86,Flashback,Ajima,0,0,0,,Cậu được phép giữ lại thẻ của mình.
Dialogue: 0,0:19:29.86,0:19:33.82,Flashback,Ajima,0,0,0,,Nếu cậu tiếp tục cố gắng,\Nta sẵn lòng đấu lại với cậu một trận.
Dialogue: 0,0:19:33.82,0:19:35.91,Flashback,Ajima,0,0,0,,Còn hai tên kia thì xong đời rồi.
Dialogue: 0,0:19:36.28,0:19:38.29,Flashback,Shinn,0,0,0,,Đừng! Sao lại chỉ có mình tôi?
Dialogue: 0,0:19:40.58,0:19:41.41,Flashback,Shinn,0,0,0,,Dừng lại đi!
Dialogue: 0,0:19:41.75,0:19:43.54,Flashback,Myojin,0,0,0,,Chính các cậu là người đặt cược cơ mà.
Dialogue: 0,0:19:49.63,0:19:53.55,Flashback,Teammate A,0,0,0,,Sao hắn lại tha cho mày?\NMày bán đứng bọn tao rồi đúng không?!
Dialogue: 0,0:19:53.80,0:19:56.55,Flashback,Shinn,0,0,0,,Không. Tao đời nào làm chuyện đó!
Dialogue: 0,0:19:57.51,0:19:59.81,Default,Shinn,0,0,0,,Hắn tha cho anh, nhưng không tha cho họ.
Dialogue: 0,0:20:00.43,0:20:03.77,Default,Shinn,0,0,0,,Họ gọi anh là kẻ phản bội\Nrồi tống cổ anh ra khỏi đội.
Dialogue: 0,0:20:05.10,0:20:09.32,Default,Shinn,0,0,0,,Một khi tin đồn kiểu đó lan ra,\Nchẳng còn đội nào dám nhận anh nữa.
Dialogue: 0,0:20:10.86,0:20:13.32,Default,Shinn,0,0,0,,Nhưng cuối cùng, anh đã được cưu mang.
Dialogue: 0,0:20:13.32,0:20:15.07,Default,Shinn,0,0,0,,Bởi Rudra.
Dialogue: 0,0:20:17.62,0:20:18.83,Default,Kairi,0,0,0,,Thì ra là vậy.
Dialogue: 0,0:20:19.41,0:20:20.16,Default,Shinn,0,0,0,,Cầm lấy.
Dialogue: 0,0:20:27.79,0:20:31.46,Default,Shinn,0,0,0,,Anh nhất định sẽ đánh bại Ajima và Myojin.
Dialogue: 0,0:20:32.38,0:20:34.43,Default,Shinn,0,0,0,,Từ giờ cho tới lúc đó, cậu giữ lấy cái này đi.
Dialogue: 0,0:20:34.93,0:20:37.18,Default,Kairi,0,0,0,,Vâng. Em sẽ giữ cẩn thận.
Dialogue: 0,0:20:42.31,0:20:45.31,Default,Rudra,0,0,0,,Chà, bay toi năm triệu bạc rồi.
Dialogue: 0,0:20:45.31,0:20:49.02,Default,Rudra,0,0,0,,Này Kairi. Có muốn chị làm cho nhóc\Ncái thẻ căn cước khác không?
Dialogue: 0,0:20:49.02,0:20:50.19,Default,Kairi,0,0,0,,Chị làm được thế thật ạ?
Dialogue: 0,0:20:50.19,0:20:51.94,Default,Isana,0,0,0,,Tất nhiên là không thể rồi!
Dialogue: 0,0:20:51.94,0:20:54.03,Default,Shinn,0,0,0,,Cậu lại muốn ngập sâu vào nợ nần hơn à?
Dialogue: 0,0:20:54.03,0:20:55.95,Default,Kairi,0,0,0,,Em muốn sớm được đấu một trận nữa.
Dialogue: 0,0:20:55.95,0:20:58.78,Default,Rudra,0,0,0,,Học cho thuộc luật chơi trước đi đã.
Dialogue: 0,0:20:58.78,0:21:02.91,Default,Rudra,0,0,0,,Nếu không tại cú bóp nghẹt thở của thằng lính mới,\Nchưa biết chừng bọn mình đã thắng trận đó rồi.
Dialogue: 0,0:21:02.91,0:21:05.83,Default,Isana,0,0,0,,Em đã bảo rồi mà, làm sao đánh bại đội top hai\Nngay lập tức được chứ.
Dialogue: 0,0:21:05.83,0:21:07.50,Default,Kairi,0,0,0,,Chị Isana, cho em một suất cà ri với!
Dialogue: 0,0:21:07.50,0:21:08.75,Default,Isana,0,0,0,,Thế em định trả tiền bằng cách nào đây?
Dialogue: 0,0:21:08.75,0:21:09.46,Default,Kairi,0,0,0,,Ghi vào sổ nợ giúp em nhé.
Dialogue: 0,0:21:10.55,0:21:12.30,Default,Isana,0,0,0,,Chị sẽ tính lãi đấy nhé.
Dialogue: 0,0:21:12.30,0:21:13.84,Default,Shinn,0,0,0,,Nợ lại chồng nợ rồi kìa nhóc.
Dialogue: 0,0:21:15.34,0:21:17.89,Default,Bran,0,0,0,,Lần sau đừng hòng lôi tôi vào đội nữa.

