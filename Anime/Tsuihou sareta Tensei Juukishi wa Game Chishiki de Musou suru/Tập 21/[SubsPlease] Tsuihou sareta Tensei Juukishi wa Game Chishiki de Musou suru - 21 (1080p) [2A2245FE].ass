Dialogue: 0,0:00:21.21,0:00:23.84,Default,HILDE,0,0,0,,Hai đứa kia đứng lại đó cho tao!
Dialogue: 0,0:00:23.84,0:00:27.84,Default,HILDE,0,0,0,,Mau trả lại 50.000.000 vàng\Nmà chúng mày đã cuỗm mất của tao đây!
Dialogue: 0,0:00:31.92,0:00:34.29,Default,ELYMAS,0,0,0,,Hiểu rồi. Xem ra cô đã phải bán cả vũ khí đi nhỉ.
Dialogue: 0,0:00:34.29,0:00:35.59,Default,ELYMAS,0,0,0,,Chạy lẹ đi, Ruche!
Dialogue: 0,0:00:35.59,0:00:36.31,Default,RUCHE,0,0,0,,Vâng ạ!
Dialogue: 0,0:00:38.30,0:00:39.84,Default,HILDE,0,0,0,,Đừng hòng chạy thoát.
Dialogue: 0,0:00:44.06,0:00:45.20,Default,CARLOS,0,0,0,,Hilde.
Dialogue: 0,0:00:55.74,0:00:58.10,Default,CARLOS,0,0,0,,Đó là Trọng Kỵ Sĩ sao?
Dialogue: 0,0:01:10.00,0:01:13.00,italics,ELYMAS/ID,0,0,0,,Khí chất này, uy áp bức người này.
Dialogue: 0,0:01:17.93,0:01:22.94,italics,ELYMAS/ID,0,0,0,,Đây đích thị là Hắc Diệm Kiếm\Nhàng thật giá thật rồi.
Dialogue: 0,0:01:28.44,0:01:30.95,Default,HILDE,0,0,0,,Chính là bọn chúng đấy, Sư phụ!
Dialogue: 0,0:01:31.37,0:01:35.90,Default,HILDE,0,0,0,,Chúng đã giở thủ đoạn bỉ ổi\Nđể lột sạch tiền của con!
Dialogue: 0,0:01:42.48,0:01:43.66,italics,ELYMAS/ID,0,0,0,,Biết ngay mà.
Dialogue: 0,0:01:45.49,0:01:47.10,Default,CARLOS,0,0,0,,Chức nghiệp của ta là Ma Kiếm Sĩ.
Dialogue: 0,0:01:48.06,0:01:50.63,Default,CARLOS,0,0,0,,Ta là mạo hiểm giả hạng A.\NTên ta là Carlos.
Dialogue: 0,0:01:51.61,0:01:55.64,Default,CARLOS,0,0,0,,Ta rất muốn được gặp cậu một lần\Nsau khi nghe Hilde kể lại mọi chuyện.
Dialogue: 0,0:02:00.69,0:02:02.69,Default,CARLOS,0,0,0,,Trọng Kỵ Sĩ Elymas.
Dialogue: 0,0:03:45.08,0:03:51.42,sign_generic,EPTITLE; sign,0,0,0,,{\b1\fnSegoe UI\an7\bord1\shad1.25\fade(1420,482)\alphaalphaH&0&\3c&H000000&\c&HFEFCFD&\4c&H000000&\fs15\pos(398.78,291.342)}Tập 21\h\h\h\h\h\hHắc Diệm Kiếm
Dialogue: 0,0:03:53.01,0:03:58.63,Default,CARLOS,0,0,0,,Thứ lỗi, nhưng có một chuyện\Nta phải xác nhận trước đã.
Dialogue: 0,0:03:59.03,0:04:03.14,Default,CARLOS,0,0,0,,Có thật là cậu đã lừa lấy sạch tiền\Ncủa Hilde không vậy?
Dialogue: 0,0:04:07.52,0:04:11.02,italics,ELYMAS/ID,0,0,0,,Hắc Diệm Kiếm đúng là\Nmạnh không phải dạng vừa.
Dialogue: 0,0:04:11.52,0:04:15.53,italics,ELYMAS/ID,0,0,0,,Nếu đánh nhau với ông ta ngay lúc này,\Ntụi mình chẳng có cửa thắng nào cả.
Dialogue: 0,0:04:15.53,0:04:18.54,Default,ELYMAS,0,0,0,,Cô ấy đòi tụi tôi phải\Ngiao ra thanh Ngân Kiếm,
Dialogue: 0,0:04:18.90,0:04:21.91,Default,ELYMAS,0,0,0,,nên tụi tôi đã giải quyết bằng một trận quyết đấu.
Dialogue: 0,0:04:22.33,0:04:23.69,Default,ELYMAS,0,0,0,,Và đây chính là kết quả.
Dialogue: 0,0:04:32.76,0:04:34.92,Default,CARLOS,0,0,0,,Ta cũng đoán vậy mà.
Dialogue: 0,0:04:40.93,0:04:42.22,Default,HILDE,0,0,0,,Á đau!
Dialogue: 0,0:04:42.22,0:04:45.22,Default,HILDE,0,0,0,,S-Sư phụ, sao người lại cốc đầu con?!
Dialogue: 0,0:04:46.64,0:04:49.89,Default,CARLOS,0,0,0,,Ta thừa biết đầu đuôi là thế rồi.
Dialogue: 0,0:04:49.89,0:04:54.15,Default,HILDE,0,0,0,,Hả? Nhưng lúc nãy người bảo tin con cơ mà!
Dialogue: 0,0:04:54.15,0:04:57.36,Default,CARLOS,0,0,0,,Ta bảo con dẫn đường tới chỗ họ\Nchỉ vì muốn đích thân gặp mặt thôi.
Dialogue: 0,0:04:58.41,0:05:04.87,Default,CARLOS,0,0,0,,Hilde, con cứ gọi ta là Sư phụ mãi,\Nnhưng ta đâu có nhận mình là thầy của con.
Dialogue: 0,0:05:04.87,0:05:07.96,Default,HILDE,0,0,0,,Cái gì ạ? S-Sư phụ?
Dialogue: 0,0:05:12.77,0:05:17.38,Default,CARLOS,0,0,0,,Giờ nói câu này nghe hơi giống\Nta đang cố phủi sạch trách nhiệm nhỉ.
Dialogue: 0,0:05:18.50,0:05:23.23,Default,CARLOS,0,0,0,,Xem ra cậu đã gặp khá nhiều phiền phức\Nvì sự lơ là quản giáo của ta rồi.
Dialogue: 0,0:05:23.23,0:05:25.89,Default,ELYMAS,0,0,0,,Kh-Không hề ạ. Tôi không để bụng đâu.
Dialogue: 0,0:05:26.31,0:05:29.89,Default,ELYMAS,0,0,0,,Tôi chỉ nhận lời thách đấu của cô ấy\Nđể kiếm chút tiền thôi.
Dialogue: 0,0:05:29.89,0:05:31.81,Default,ELYMAS,0,0,0,,Lúc đó tôi hoàn toàn có thể từ chối mà.
Dialogue: 0,0:05:33.30,0:05:37.19,Default,CARLOS,0,0,0,,Hồi mới vào nghề,\Nta từng gặp toàn đồng đội chẳng ra gì.
Dialogue: 0,0:05:37.19,0:05:41.20,Default,CARLOS,0,0,0,,Nhờ vậy mà ta tự tin mình có con mắt\Nnhìn người chuẩn xác lắm.
Dialogue: 0,0:05:42.72,0:05:45.45,Default,CARLOS,0,0,0,,Cậu là một người tử tế đấy, Elymas.
Dialogue: 0,0:05:45.45,0:05:49.17,italics,ELYMAS/ID,0,0,0,,Ông ấy tốt bụng quá mức làm mình\Nbắt đầu thấy ngại luôn rồi đây.
Dialogue: 0,0:05:49.17,0:05:52.21,italics,ELYMAS/ID,0,0,0,,Không hiểu kiểu gì mà đệ tử ông ấy\Nlại ra nông nỗi đó được nhỉ.
Dialogue: 0,0:05:53.83,0:05:56.96,Default,CARLOS,0,0,0,,Còn về số tiền kia...
Dialogue: 0,0:05:56.96,0:06:01.09,Default,CARLOS,0,0,0,,Vì tốt cho con bé, cậu cứ giữ lấy đừng trả lại.
Dialogue: 0,0:05:59.96,0:06:01.22,Default,,0,0,0,,{\c&HF6B0F7&\3cFFFFFF\pos(330,185)}ặc
Dialogue: 0,0:06:01.72,0:06:05.22,Default,CARLOS,0,0,0,,Con bé này chỉ chịu rút kinh nghiệm\Nkhi nếm mùi hậu quả thôi.
Dialogue: 0,0:06:05.22,0:06:07.22,Default,ELYMAS,0,0,0,,À, vâng.
Dialogue: 0,0:06:07.22,0:06:10.93,Default,CARLOS,0,0,0,,Ta còn một thỉnh cầu khác muốn nhờ cậu.
Dialogue: 0,0:06:12.16,0:06:15.31,Default,CARLOS,0,0,0,,Nhưng chúng ta tìm chỗ khác nói chuyện đi.\NCùng ăn trưa với ta một bữa nhé.
Dialogue: 0,0:06:26.31,0:06:29.24,Default,ELYMAS,0,0,0,,Vậy, ngài định nhờ tôi chuyện gì ạ?
Dialogue: 0,0:06:29.24,0:06:36.00,Default,CARLOS,0,0,0,,Gần đây, quanh khu vực Lacoryna liên tiếp\Nxảy ra những thảm họa quái vật kỳ lạ.
Dialogue: 0,0:06:36.92,0:06:40.30,Default,CARLOS,0,0,0,,Đây thực sự là một diễn biến hết sức bất thường.
Dialogue: 0,0:06:40.30,0:06:43.97,Default,CARLOS,0,0,0,,Quái vật ồ ạt tràn ra từ những\Nhầm ngục vừa mới xuất hiện.
Dialogue: 0,0:06:44.69,0:06:48.10,Default,CARLOS,0,0,0,,Hiện tượng Tiến Hóa Hiện Sinh cực hiếm\Ncũng liên tục nối đuôi nhau xảy ra.
Dialogue: 0,0:06:48.67,0:06:55.09,Default,CARLOS,0,0,0,,Liệu đó chỉ là sự trùng hợp ngẫu nhiên\Nhay có nguyên nhân nào đứng sau xu hướng này?
Dialogue: 0,0:06:55.09,0:06:59.02,Default,CARLOS,0,0,0,,Ta đã tự mình tiến hành điều tra bằng cách\Nkhảo sát các hầm ngục quanh Lacoryna.
Dialogue: 0,0:06:59.53,0:07:04.27,Default,CARLOS,0,0,0,,Hội Mạo Hiểm Giả vừa thu thập được\Nnguồn tin mới dạo gần đây.
Dialogue: 0,0:07:04.27,0:07:08.48,Default,CARLOS,0,0,0,,Chắc chắn là có âm mưu gì đó đang diễn ra rồi.
Dialogue: 0,0:07:09.17,0:07:12.28,Default,ELYMAS,0,0,0,,Ngài đang nhắc tới\NHành Lang Rết Độc sao?
Dialogue: 0,0:07:12.28,0:07:16.58,Default,CARLOS,0,0,0,,Cậu quả là mạo hiểm giả tài ba\Nkhi đã nắm bắt được chuyện đó rồi đấy.
Dialogue: 0,0:07:17.04,0:07:21.50,Default,CARLOS,0,0,0,,Suốt gần hai tuần qua,\Nta đã đơn độc tiến hành điều tra,
Dialogue: 0,0:07:22.40,0:07:25.41,Default,CARLOS,0,0,0,,nhưng ta đã thất bại khi chinh phục một hầm ngục nọ.
Dialogue: 0,0:07:25.41,0:07:28.51,Default,ELYMAS,0,0,0,,Ngài thất bại á? Ngài là hạng A cơ mà.
Dialogue: 0,0:07:30.55,0:07:36.52,Default,ELYMAS,0,0,0,,Xung quanh Lacoryna làm gì có hầm ngục nào\Nkhó đến mức làm khó được hạng A chứ.
Dialogue: 0,0:07:36.84,0:07:39.20,Default,CARLOS,0,0,0,,Một Hồ Quái Vật (Monster Pool) đã xuất hiện.
Dialogue: 0,0:07:39.91,0:07:43.19,Default,CARLOS,0,0,0,,Một mình ta thì hoàn toàn bó tay.
Dialogue: 0,0:07:44.53,0:07:49.62,italics,ELYMAS/ID,0,0,0,,Hồ Quái Vật là hiện tượng lượng lớn quái vật\Nbất thường ùn ùn tràn ra từ trong hầm ngục.
Dialogue: 0,0:07:50.39,0:07:54.15,italics,ELYMAS/ID,0,0,0,,Đó là một trong những thảm họa quái vật\Nđáng sợ ngay cả trong {\i0}Thế Giới Ma Pháp{\i1}.
Dialogue: 0,0:07:54.91,0:07:58.71,italics,ELYMAS/ID,0,0,0,,Quả nhiên, con Tử Thần Amude hôm trước\Nkhông phải là vụ việc đơn lẻ.
Dialogue: 0,0:07:59.79,0:08:04.21,italics,ELYMAS/ID,0,0,0,,Chắc chắn phải có thứ gì đó\Nđang kích phát những thảm họa này.
Dialogue: 0,0:08:05.57,0:08:09.97,Default,ELYMAS,0,0,0,,Nếu tần suất thảm họa quái vật gia tăng\Nở khắp mọi nơi,
Dialogue: 0,0:08:11.02,0:08:15.65,Default,ELYMAS,0,0,0,,khu vực sinh sống an toàn của con người\Nsẽ bị thu hẹp lại nghiêm trọng.
Dialogue: 0,0:08:15.65,0:08:16.23,Default,RUCHE,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:08:16.23,0:08:19.79,Default,RUCHE,0,0,0,,Kh-Không đến mức nghiêm trọng thế đâu, anh Elymas.
Dialogue: 0,0:08:19.79,0:08:22.15,Default,RUCHE,0,0,0,,Chắc là anh nói quá lên thôi mà.
Dialogue: 0,0:08:22.66,0:08:26.15,Default,CARLOS,0,0,0,,Ít nhất thì ta không nghĩ cậu ấy phóng đại đâu.
Dialogue: 0,0:08:27.10,0:08:28.68,Default,CARLOS,0,0,0,,Ta đồng tình với nhận định của Elymas.
Dialogue: 0,0:08:33.72,0:08:36.05,Default,CARLOS,0,0,0,,Vậy nên chúng ta vào thẳng vấn đề chính nhé.
Dialogue: 0,0:08:37.51,0:08:40.83,Default,CARLOS,0,0,0,,Ta muốn mời cậu tham gia một nhiệm vụ chinh phạt lớn.
Dialogue: 0,0:08:42.40,0:08:46.09,Default,CARLOS,0,0,0,,Hầm ngục mà ta vừa phải rút lui chính là\NNghĩa Địa Bi Thương.
Dialogue: 0,0:08:46.09,0:08:49.29,Default,CARLOS,0,0,0,,Ta muốn nhờ cậu hỗ trợ điều tra\Nvà chinh phục nơi đó.
Dialogue: 0,0:08:51.09,0:08:56.43,Default,CARLOS,0,0,0,,Nếu chỉ là một Hồ Quái Vật thông thường,\Nta cũng chẳng việc gì phải vội tiêu diệt.
Dialogue: 0,0:08:56.43,0:08:58.52,Default,CARLOS,0,0,0,,Nhưng hầm ngục đó mới hình thành thôi.
Dialogue: 0,0:08:58.52,0:09:02.88,Default,CARLOS,0,0,0,,Đáng lẽ các điều kiện kích hoạt thảm họa\Nvẫn chưa thể hội tụ đủ được.
Dialogue: 0,0:09:03.72,0:09:07.86,Default,CARLOS,0,0,0,,Tình hình có thể trở nên tồi tệ hơn nữa\Nnếu không được xử lý sớm.
Dialogue: 0,0:09:12.46,0:09:15.37,Default,RUCHE,0,0,0,,Tụi mình làm sao giờ, anh Elymas?
Dialogue: 0,0:09:16.98,0:09:22.19,Default,ELYMAS,0,0,0,,Bình thường thì tôi gật đầu đồng ý ngay rồi,\Nnhưng tôi vẫn còn vài điều băn khoăn.
Dialogue: 0,0:09:22.19,0:09:23.13,Default,RUCHE,0,0,0,,Hả?
Dialogue: 0,0:09:25.44,0:09:27.90,italics,ELYMAS/ID,0,0,0,,Đợt này sẽ có một mạo hiểm giả hạng A đi cùng.
Dialogue: 0,0:09:27.90,0:09:31.88,italics,ELYMAS/ID,0,0,0,,Ông ấy là Ma Kiếm Sĩ từng dạy cả Hilde\Ncách biết lúc nào nên rút lui.
Dialogue: 0,0:09:32.18,0:09:33.88,italics,ELYMAS/ID,0,0,0,,Bọn họ sẽ không làm chuyện gì liều lĩnh đâu.
Dialogue: 0,0:09:33.88,0:09:37.14,italics,ELYMAS/ID,0,0,0,,Dẫu vậy, mình vẫn cảm thấy có điềm gở nào đó\Nẩn sau chuyện này.
Dialogue: 0,0:09:38.35,0:09:39.28,italics,ELYMAS/ID,0,0,0,,Thế nhưng...
Dialogue: 0,0:09:42.05,0:09:45.02,Default,ELYMAS,0,0,0,,Dù thế nào đi nữa tôi vẫn muốn đi.
Dialogue: 0,0:09:51.24,0:09:57.58,italics,ELYMAS/ID,0,0,0,,Nếu thực sự có biến cố bất thường xảy ra trên thế giới này,\Nthì kẻ duy nhất có thể ngăn chặn nó
Dialogue: 0,0:09:57.94,0:10:03.10,italics,ELYMAS/ID,0,0,0,,chính là bản thân mình cùng ký ức sâu rộng\Nvề tựa game {\i0}Thế Giới Ma Pháp{\i1}.
Dialogue: 0,0:10:05.14,0:10:09.13,Default,HILDE,0,0,0,,Lâu lắm rồi thầy trò mình mới lại\Nkề vai sát cánh chiến đấu nhỉ.
Dialogue: 0,0:10:09.70,0:10:12.15,Default,CARLOS,0,0,0,,Hilde, con không cần phải đi đâu.
Dialogue: 0,0:10:12.15,0:10:14.76,Default,HILDE,0,0,0,,Hả?! Sư phụ ơi!
Dialogue: 0,0:10:15.37,0:10:16.96,Default,CARLOS,0,0,0,,Ta đùa đấy.
Dialogue: 0,0:10:43.57,0:10:47.64,italics,ELYMAS/ID,0,0,0,,Dưới sự chỉ huy của Carlos, tôi và Ruche\Nbắt đầu tham gia nhiệm vụ chinh phạt
Dialogue: 0,0:10:47.64,0:10:50.89,italics,ELYMAS/ID,0,0,0,,để điều tra và công phá hầm ngục\NNghĩa Địa Bi Thương.
Dialogue: 0,0:11:01.37,0:11:07.02,Default,ELYMAS,0,0,0,,Hội ở các thành phố lớn có thể huy động lượng\Nmạo hiểm giả cấp cao đông đảo hơn hẳn nơi khác.
Dialogue: 0,0:11:07.34,0:11:11.97,Default,RUCHE,0,0,0,,Hẳn mọi người cũng tin tưởng chú Carlos lắm đấy.
Dialogue: 0,0:11:11.97,0:11:13.28,Default,ELYMAS,0,0,0,,Đúng vậy.
