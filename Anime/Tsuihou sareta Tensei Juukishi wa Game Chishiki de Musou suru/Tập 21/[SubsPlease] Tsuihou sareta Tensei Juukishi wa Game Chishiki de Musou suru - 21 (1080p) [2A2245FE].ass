Dialogue: 0,0:11:17.15,0:11:23.78,italics,ELYMAS/ID,0,0,0,,Nhờ bác Veruga kịp hoàn thành\Nthanh Ngân Kiếm và bộ Giáp Hắc Thiết,
Dialogue: 0,0:11:23.78,0:11:25.26,italics,ELYMAS/ID,0,0,0,,giờ trang bị của mình đã rất tươm tất rồi.
Dialogue: 0,0:11:25.79,0:11:30.08,italics,ELYMAS/ID,0,0,0,,Từ nay người ta sẽ thôi không còn đối xử với mình\Nnhư Trọng Kỵ Sĩ tập sự mặc Giáp Sắt nữa.
Dialogue: 0,0:11:30.08,0:11:31.33,Default,MARY,0,0,0,,Elymas!
Dialogue: 0,0:11:32.21,0:11:34.57,Default,ELYMAS,0,0,0,,Bang Nanh Hải Long\Ncũng tham gia đợt này sao?
Dialogue: 0,0:11:35.04,0:11:39.01,Default,MARY,0,0,0,,Hầm ngục mà loạn xì ngầu lên thì\Nbọn tôi làm sao mà câu cá được nữa.
Dialogue: 0,0:11:39.32,0:11:42.26,Default,MARY,0,0,0,,Để xem ngoài câu cá ra cậu còn làm được trò trống gì nhé.
Dialogue: 0,0:11:42.26,0:11:44.69,Default,ELYMAS,0,0,0,,Tôi cũng rất háo hức xem tài nghệ khác của cô đấy.
Dialogue: 0,0:11:45.72,0:11:46.92,Default,MARY,0,0,0,,Tất cả vì sự nghiệp câu cá!
Dialogue: 0,0:11:46.92,0:11:48.35,Default,ELYMAS,0,0,0,,Tất cả vì sự nghiệp câu cá!
Dialogue: 0,0:11:49.11,0:11:51.40,Default,RUCHE,0,0,0,,Ch-Chẳng phải tụi mình làm chuyện này để cứu thế giới sao ạ?
Dialogue: 0,0:11:51.40,0:11:52.86,Default,EYEPATCH,0,0,0,,Chuẩn luôn!
Dialogue: 0,0:11:59.40,0:12:03.12,Default,HILDE,0,0,0,,Sư phụ ơi, liệu mình có thực sự cần\Nhuy động đông người thế này không ạ?
Dialogue: 0,0:12:03.46,0:12:07.87,Default,HILDE,0,0,0,,Con không chắc lắm.\NChỉ cần thêm vài người hồi máu là đủ rồi mà.
Dialogue: 0,0:12:09.08,0:12:14.55,Default,CARLOS,0,0,0,,Tình hình có thể chuyển biến xấu bất cứ lúc nào,\Nnên ta mới tuyển thêm vài người cho chắc ăn.
Dialogue: 0,0:12:15.82,0:12:19.05,Default,HILDE,0,0,0,,Chẳng có ích lợi gì khi vác theo\Nmột đống gánh nặng vô dụng cả.
Dialogue: 0,0:12:19.49,0:12:23.01,Default,ADVENTURER 5,0,0,0,,Sao đệ tử của Hắc Diệm Kiếm lại vác\Nlưỡi hái ra trận thế kia?
Dialogue: 0,0:12:23.49,0:12:28.02,Default,ADVENTURER 4,0,0,0,,Ai mà biết? Biết đâu cô ta nâng nhầm\NCây Kỹ Năng dùng lưỡi hái.
Dialogue: 0,0:12:28.02,0:12:31.27,italics,ELYMAS/ID,0,0,0,,Cô nàng đã định mượn\Nmột món vũ khí dự phòng từ chú Carlos,
Dialogue: 0,0:12:32.05,0:12:35.28,italics,ELYMAS/ID,0,0,0,,nhưng ông ấy bảo cô ta phải tự nếm trải\Nhậu quả từ hành động của mình.
Dialogue: 0,0:12:31.61,0:12:33.62,flashbacktop,CARLOS,0,0,0,,Không. Cứ dùng tiếp cây lưỡi hái đó đi.
Dialogue: 0,0:12:33.73,0:12:35.28,sign_generic,SIGN,0,0,0,,{\fade(189,1)\t(189,1480,\fs30)\b1\move(209.778,81.556,208,68.444,189,1480)\c&H90F1F1&}Sốc Tận Óc
Dialogue: 0,0:12:33.62,0:12:35.28,flashbacktop,HILDE,0,0,0,,Hả?!
Dialogue: 0,0:12:35.78,0:12:40.95,Default,RUCHE,0,0,0,,Không biết tại sao chú Carlos lại nhận\Ncô Hilde làm đệ tử nhỉ.
Dialogue: 0,0:12:40.95,0:12:43.47,Default,HILDE,0,0,0,,Xin lỗi vì không vừa mắt cô nhé!
Dialogue: 0,0:12:44.24,0:12:47.50,Default,RUCHE,0,0,0,,T-Tôi xin lỗi! Ý tôi không phải vậy đâu!
Dialogue: 0,0:12:48.72,0:12:53.38,Default,CARLOS,0,0,0,,Ta chẳng làm gì xứng đáng\Nvới danh xưng sư phụ cả.
Dialogue: 0,0:12:53.73,0:12:57.05,Default,CARLOS,0,0,0,,Ta tin rằng Ma Kiếm Sĩ là một chức nghiệp\Nvô cùng mạnh mẽ.
Dialogue: 0,0:12:58.34,0:13:02.22,Default,CARLOS,0,0,0,,Khả năng tấn công rất uy lực,\Nnhưng lại ngốn tài nguyên quá lớn.
Dialogue: 0,0:13:02.51,0:13:05.65,Default,CARLOS,0,0,0,,Điều đó thường đẩy bọn ta vào thế bất hòa\Nvới các thành viên trong tổ đội.
Dialogue: 0,0:13:05.65,0:13:08.98,Default,CARLOS,0,0,0,,Nếu không được uốn nắn, con bé sẽ bị cô lập\Ntrong hội rồi lầm đường lạc lối mất.
Dialogue: 0,0:13:09.46,0:13:13.60,Default,CARLOS,0,0,0,,Ta nhìn thấy trước viễn cảnh sớm muộn gì con bé\Ncũng bỏ mạng vì làm chuyện liều lĩnh một mình.
Dialogue: 0,0:13:15.52,0:13:21.53,italics,ELYMAS/ID,0,0,0,,Trong {\i0}Thế Giới Ma Pháp{\i1}, những gì có lợi cho Ma Kiếm Sĩ\Nthường chẳng mang lại lợi ích gì cho cả tổ đội.
Dialogue: 0,0:13:21.53,0:13:23.27,Default,MAGIC SWORDSMAN,0,0,0,,Đám quái tép riu cứ để bọn mày dọn.
Dialogue: 0,0:13:23.27,0:13:24.78,Default,MAGIC SWORDSMAN,0,0,0,,Tao sẽ dồn toàn lực vào con Boss.
Dialogue: 0,0:13:24.78,0:13:25.58,Default,PARTY MEMBER A,0,0,0,,Thế thì bất công quá!
Dialogue: 0,0:13:25.58,0:13:26.95,Default,PARTY MEMBER B,0,0,0,,Đừng có ích kỷ thế chứ!
Dialogue: 0,0:13:27.68,0:13:31.12,Default,CARLOS,0,0,0,,Sự nóng vội khiến con người ta không thể\Nnhìn thấu thế giới dưới góc độ của người khác.
Dialogue: 0,0:13:32.43,0:13:34.50,Default,CARLOS,0,0,0,,Hồi trẻ ta cũng từng y như thế đấy.
Dialogue: 0,0:13:37.33,0:13:39.60,Default,CARLOS,0,0,0,,Ta từng bức bối trước sự thiếu thấu hiểu\Ncủa đồng đội.
Dialogue: 0,0:13:39.60,0:13:45.19,Default,CARLOS,0,0,0,,Ta từng nôn nóng khẳng định mình và tự hỏi\Nsao người khác lại ích kỷ đến vậy.
Dialogue: 0,0:13:48.05,0:13:53.17,Default,CARLOS,0,0,0,,Đến giờ ta vẫn ước giá mà ngày ấy có ai đó\Nbình tĩnh ngồi lại cho ta lời khuyên.
Dialogue: 0,0:13:55.77,0:13:59.28,Default,CARLOS,0,0,0,,Đó là lý do ta dang tay giúp đỡ Hilde.
Dialogue: 0,0:14:02.81,0:14:07.95,Default,HILDE,0,0,0,,Sư phụ của ta là một người rộng lượng,\Nmạnh mẽ lại còn nhân hậu nữa.
Dialogue: 0,0:14:08.33,0:14:10.45,Default,HILDE,0,0,0,,Ngưỡng mộ lắm đúng không?
Dialogue: 0,0:14:10.81,0:14:14.86,Default,ELYMAS,0,0,0,,Giá mà cô học trò cũng thừa hưởng được\Nchút tính cách đó của ông ấy.
Dialogue: 0,0:14:14.86,0:14:16.46,Default,HILDE,0,0,0,,Ngươi vừa nói cái gì hả?!
Dialogue: 0,0:14:17.38,0:14:19.59,Default,HILDE,0,0,0,,Không được cười, con ranh láo xược kia!
Dialogue: 0,0:14:28.61,0:14:32.48,Default,RUCHE,0,0,0,,Em khó mà tưởng tượng nổi chú Carlos\Ncũng từng có lúc phiền muộn thế đấy.
Dialogue: 0,0:14:32.78,0:14:37.48,Default,ELYMAS,0,0,0,,Chắc ông ấy cố tình nói quá lên để\Ngiữ thể diện cho Hilde thôi.
Dialogue: 0,0:14:37.48,0:14:38.86,Default,RUCHE,0,0,0,,Anh nghĩ vậy à?
Dialogue: 0,0:14:40.04,0:14:41.23,Default,CARLOS,0,0,0,,Mọi người dừng lại.
Dialogue: 0,0:15:08.45,0:15:09.18,Default,CARLOS,0,0,0,,Có thứ gì đó đang lao tới.
Dialogue: 0,0:15:10.31,0:15:12.68,sign_generic,SIGN,0,0,0,,{\b1\blur1.5\bord1\c&HFFFFDE&\3c&HE1E294&\t(730,1105,\c&HFEFBD5&\3c&HDFAF26&)\an7\fade(250,1)\fs15\pos(400.134,205.556)}Quái Vật: Sói Điên
Dialogue: 0,0:15:11.46,0:15:13.96,Default,RUCHE,0,0,0,,Mới mở màn đã đụng ngay Cấp 52 rồi sao?!
Dialogue: 0,0:15:13.96,0:15:16.19,Default,CARLOS,0,0,0,,Đây là đàn quái vật tràn ra từ\Nbên trong hầm ngục!
Dialogue: 0,0:15:17.01,0:15:18.52,Default,CARLOS,0,0,0,,Chúng ta sẽ đánh chặn hết chúng!
Dialogue: 0,0:15:18.93,0:15:23.97,italics,ELYMAS/ID,0,0,0,,Nếu Rondalm mà bị đàn quái cỡ cấp độ này tràn qua,\Nchắc chắn lãnh chúa sẽ phải ra tay rồi.
Dialogue: 0,0:15:40.08,0:15:40.79,Default,ELYMAS,0,0,0,,Ruche!
Dialogue: 0,0:15:42.42,0:15:43.80,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Trạng thái bất thường: Trúng độc.
Dialogue: 0,0:15:43.88,0:15:45.42,sign_generic,SIGN,0,0,0,,{\b1\fs25\bord1\c&H68BEFA&\3c&H9F2EBD&\fade(396,0)\pos(147.333,208)}Trạng Thái\N{\b1\alphaFF\t(521,1022,\alpha00)\c&HF830F6&\3c&H500033&} Trúng Độc
Dialogue: 0,0:15:43.80,0:15:45.80,Default,RUCHE,0,0,0,,Em gây trúng độc cho nó rồi!
Dialogue: 0,0:15:45.80,0:15:47.54,Default,ELYMAS,0,0,0,,Tốt lắm! Nhanh gọn phết đấy!
Dialogue: 0,0:15:47.93,0:15:51.93,italics,ELYMAS/ID,0,0,0,,Đó là hiệu ứng từ vũ khí mới của Ruche,\NĐoản Đao Độc Chilopoda.
Dialogue: 0,0:15:52.58,0:15:58.21,italics,ELYMAS/ID,0,0,0,,Nhờ chỉ số May Mắn cao cùng số đòn đánh dày đặc,\Nem ấy rất dễ kích hoạt độc lên mục tiêu.
Dialogue: 0,0:15:58.94,0:16:05.44,italics,ELYMAS/ID,0,0,0,,Hơn nữa, trong {\i0}Thế Giới Ma Pháp{\i1}, trạng thái trúng độc\Nsẽ làm giảm 10% Tốc Độ.
Dialogue: 0,0:16:00.90,0:16:05.44,sign_generic,SIGN,0,0,0,,{\b1\fs25\bord1\c&H68BEFA&\3c&H9F2EBD&\fade(396,0)\pos(500.222,205.333)}Trạng Thái\N{\b1\alphaFF\t(521,1022,\alpha00)\c&HF830F6&\3c&H500033&} Trúng Độc
Dialogue: 0,0:16:06.00,0:16:07.90,Default,RUCHE,0,0,0,,Kết thúc tại đây nào!
Dialogue: 0,0:16:07.90,0:16:10.91,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Nhận được 174 EXP.
Dialogue: 0,0:16:08.99,0:16:10.91,sign_generic,SIGN,0,0,0,,{\fad(606,2)\b1\bord1\shad2\blur0.5\c&H2ADDF5&\3c&H292830&\4c&H292830&\pos(183.026,58.586)}Nhận được 174 EXP
Dialogue: 0,0:16:18.83,0:16:20.83,Default,ELYMAS,0,0,0,,Vẫn còn thêm kẻ địch nữa!
Dialogue: 0,0:16:21.18,0:16:22.91,Default,ELYMAS,0,0,0,,Tiếp tục đánh tỉa giảm bớt số lượng chúng đi!
Dialogue: 0,0:16:23.58,0:16:24.84,Default,RUCHE,0,0,0,,V-Vâng ạ!
Dialogue: 0,0:16:40.32,0:16:42.36,Default,RUCHE,0,0,0,,Dọn sạch hết rồi.
Dialogue: 0,0:16:42.82,0:16:46.36,Default,ELYMAS,0,0,0,,Đón tiếp nồng nhiệt gớm nhỉ, mà tụi mình còn\Nchưa đặt chân vào bên trong hầm ngục nữa đấy.
Dialogue: 0,0:16:47.16,0:16:50.75,Default,ELYMAS,0,0,0,,Xem ra thanh Đoản Đao Độc Chilopoda của em\Nphát huy hiệu quả tốt đấy, Ruche.
Dialogue: 0,0:16:50.75,0:16:53.87,Default,RUCHE,0,0,0,,Thì chức nghiệp của em vốn thiếu hỏa lực,
Dialogue: 0,0:16:53.87,0:16:57.87,Default,RUCHE,0,0,0,,nên có được con dao găm gây trạng thái bất thường\Nthế này đúng là mừng hết lớn.
Dialogue: 0,0:16:58.29,0:17:00.87,Default,RUCHE,0,0,0,,Em có cảm giác tự dưng mình mạnh hơn hẳn luôn ấy.
Dialogue: 0,0:17:01.20,0:17:04.29,Default,ELYMAS,0,0,0,,Em dính chút sát thương rồi kìa.\NEm có sao không?
Dialogue: 0,0:17:05.57,0:17:08.01,Default,RUCHE,0,0,0,,Em hơi hăng máu quá đà với\Nmón vũ khí mới chút thôi.
Dialogue: 0,0:17:08.44,0:17:13.68,Default,RUCHE,0,0,0,,Em ổn hoàn toàn mà, nhưng liệu có cần\Ndùng thêm Bình Hồi Máu luôn không nhỉ?
Dialogue: 0,0:17:14.12,0:17:15.15,Default,MAEBEL,0,0,0,,Trị Liệu (Heal).
Dialogue: 0,0:17:17.68,0:17:20.69,Default,RUCHE,0,0,0,,Em c-cảm ơn, ờm...
Dialogue: 0,0:17:20.69,0:17:24.16,Default,MAEBEL,0,0,0,,Tôi là Maebel, một Tu Sĩ.
Dialogue: 0,0:17:24.16,0:17:29.31,Default,MAEBEL,0,0,0,,Tôi được chiêu mộ vì thuộc hệ trị liệu,\Nnhưng thực ra tôi mới chỉ hạng C thôi.
Dialogue: 0,0:17:29.31,0:17:32.86,Default,MAEBEL,0,0,0,,Rất mong được hai vị hạng B đây chỉ giáo thêm.
Dialogue: 0,0:17:33.20,0:17:35.49,Default,ELYMAS,0,0,0,,Tụi tôi cũng trông cậy nhiều vào cô đấy.
Dialogue: 0,0:17:35.49,0:17:39.13,Default,ELYMAS,0,0,0,,Cơ mà nói thật thì tụi tôi cũng mới là lính mới thôi.
Dialogue: 0,0:17:39.13,0:17:41.21,Default,RUCHE,0,0,0,,R-Rất vui được làm quen với chị.
Dialogue: 0,0:17:41.60,0:17:43.48,Default,ELYMAS,0,0,0,,Tôi là Elymas, Trọng Kỵ Sĩ.
Dialogue: 0,0:17:43.48,0:17:45.74,Default,ELYMAS,0,0,0,,Còn đây là Ruche, Chú Hề.
Dialogue: 0,0:17:46.23,0:17:47.46,Default,RUCHE,0,0,0,,Em là Ruche ạ.
Dialogue: 0,0:17:47.80,0:17:52.76,italics,ELYMAS/ID,0,0,0,,May quá, người dùng bạch ma pháp bên mình\Ntrông có vẻ đáng tin cậy đấy.
Dialogue: 0,0:17:55.35,0:17:57.89,Default,KELT,0,0,0,,Chúng ta còn chưa vào trong hầm ngục đâu.
Dialogue: 0,0:17:57.89,0:18:01.27,Default,KELT,0,0,0,,Đừng có bắt trị liệu sư của nhóm\Ntiêu tốn lượng MP quý giá vô ích thế chứ.
Dialogue: 0,0:18:01.70,0:18:06.93,italics,ELYMAS/ID,0,0,0,,Gã này là Kelt, Thợ Săn hạng B.
Dialogue: 0,0:18:07.49,0:18:11.53,italics,ELYMAS/ID,0,0,0,,Hắn là một trong những thành viên cấp cao nhất\Ncủa đội chinh phạt lần này.
Dialogue: 0,0:18:11.53,0:18:15.37,Default,KELT,0,0,0,,Mặc kệ mấy kẻ mới đầu đã hăng máu\Nlàm lố lên đi.
Dialogue: 0,0:18:15.72,0:18:20.62,Default,KELT,0,0,0,,Không ngờ trị liệu sư bên mình lại không biết\Ncách phân phối sức hợp lý đấy.
Dialogue: 0,0:18:20.62,0:18:26.13,Default,MAEBEL,0,0,0,,Xin lỗi, anh Kelt. Lần sau tôi sẽ\Ncân nhắc kỹ hơn trước khi hành động.
Dialogue: 0,0:18:26.49,0:18:27.79,Default,ELYMAS,0,0,0,,Chuyện qua rồi thì nói sao chẳng dễ.
Dialogue: 0,0:18:27.79,0:18:29.35,Default,ELYMAS,0,0,0,,Đối đầu với lượng kẻ địch đông đến thế,
Dialogue: 0,0:18:29.35,0:18:33.48,Default,ELYMAS,0,0,0,,ưu tiên đánh giảm quân số trước\Ncũng đâu phải phương án tồi.
Dialogue: 0,0:18:33.48,0:18:38.39,Default,ELYMAS,0,0,0,,Ít nhất thì cũng chẳng đáng phải làm căng thẳng\Nbầu không khí chỉ vì chuyện cỏn con đó.
Dialogue: 0,0:18:38.92,0:18:41.16,Default,KELT,0,0,0,,Cậu thì hiểu cái gì.
Dialogue: 0,0:18:41.16,0:18:43.89,Default,KELT,0,0,0,,Nhiệm vụ chinh phạt này là cuộc chạy đường dài.
Dialogue: 0,0:18:44.20,0:18:46.83,Default,KELT,0,0,0,,Mục tiêu hàng đầu của chúng ta là khảo sát\Nbên trong hầm ngục.
Dialogue: 0,0:18:46.83,0:18:48.90,Default,KELT,0,0,0,,Nó khác hẳn một chuyến thăm dò bình thường.
Dialogue: 0,0:18:49.26,0:18:52.85,Default,KELT,0,0,0,,Đừng có ngoan cố kiếm chuyện gây hấn với ta,\Ntên tân binh kia.
Dialogue: 0,0:18:59.45,0:19:03.91,Default,ELYMAS,0,0,0,,Anh cố tình gây chuyện sinh sự\Nđể thị uy nắm quyền kiểm soát chứ gì.
Dialogue: 0,0:19:07.33,0:19:12.09,italics,ELYMAS/ID,0,0,0,,Lời nói của hắn cốt để ra vẻ rằng\Nhắn có quyền sai bảo trị liệu sư
Dialogue: 0,0:19:12.43,0:19:14.93,italics,ELYMAS/ID,0,0,0,,đồng thời kìm kẹp các tuyến đầu như bọn mình.
Dialogue: 0,0:19:15.91,0:19:18.39,italics,ELYMAS/ID,0,0,0,,Là một Thợ Săn chuyên tỉa quái\Ntừ hàng sau,
Dialogue: 0,0:19:18.39,0:19:22.22,italics,ELYMAS/ID,0,0,0,,Kelt được hưởng lợi trực tiếp nếu\Ntuyến đầu bị trói tay trói chân.
Dialogue: 0,0:19:22.65,0:19:28.55,Default,KELT,0,0,0,,Đừng tự làm mất mặt vì cái thói\Nnhanh mồm nhanh miệng nữa, nhóc con.
Dialogue: 0,0:19:28.94,0:19:30.94,Default,KELT,0,0,0,,Động não lên chút đi.
Dialogue: 0,0:19:33.67,0:19:37.11,Default,KELT,0,0,0,,Xem ra lần này cũng rớt được\Nvài món đồ ngon phết nhỉ.
Dialogue: 0,0:19:37.82,0:19:42.35,Default,KELT,0,0,0,,Theo lệ thường thì chiến lợi phẩm thuộc về\Nngười tung đòn kết liễu.
Dialogue: 0,0:19:42.35,0:19:44.25,Default,KELT,0,0,0,,Đống này ta xin nhận nhé.
Dialogue: 0,0:19:44.25,0:19:47.11,Default,RUCHE,0,0,0,,Nhưng chỗ đó rớt ra là nhờ kỹ năng của em mà.
Dialogue: 0,0:19:51.07,0:19:53.14,Default,ELYMAS,0,0,0,,Đừng bận tâm tới lời hắn, cô Maebel.
Dialogue: 0,0:19:53.14,0:19:56.82,Default,ELYMAS,0,0,0,,Mục đích của hắn ngay từ đầu là bới lông tìm vết\Nđể phủ đầu dằn mặt bọn mình thôi.
Dialogue: 0,0:19:57.24,0:19:58.63,Default,MAEBEL,0,0,0,,Tôi không sao đâu.
Dialogue: 0,0:19:59.05,0:20:04.31,Default,MAEBEL,0,0,0,,Làm trị liệu sư, tôi gặp suốt mấy gã\Ngiở trò chèn ép kiểu này rồi.
Dialogue: 0,0:20:04.65,0:20:11.31,Default,MAEBEL,0,0,0,,Hơn nữa, chỉ cần cứ gật gù dạ vâng rồi\Nbịa lý do trì hoãn hồi máu cho hắn một chút,
Dialogue: 0,0:20:12.13,0:20:15.32,Default,MAEBEL,0,0,0,,thì mấy gã như thế kiểu gì cũng tự biết điều ngay.
Dialogue: 0,0:20:15.32,0:20:18.32,Default,MAEBEL,0,0,0,,Bên trong hầm ngục chật hẹp lắm.
Dialogue: 0,0:20:18.32,0:20:24.24,Default,MAEBEL,0,0,0,,Ngay cả Thợ Săn cũng sẽ dính đòn,\Nmà Phòng Ngự của hệ đó thì mỏng dính.
Dialogue: 0,0:20:24.24,0:20:29.17,Default,MAEBEL,0,0,0,,Tôi rất muốn tụi mình thân thiết với nhau,\Nnên trông cậy vào hai bạn đấy.
Dialogue: 0,0:20:29.17,0:20:30.75,Default,ELYMAS,0,0,0,,À-Ừ nhỉ?
Dialogue: 0,0:20:31.08,0:20:33.78,Default,ELYMAS,0,0,0,,Tụi tôi cảm kích tấm lòng đó lắm.
Dialogue: 0,0:20:34.24,0:20:41.64,italics,ELYMAS/ID,0,0,0,,Có lẽ những mạo hiểm giả sống dai ở thế giới này\Ncứng cựa hơn mình tưởng nhiều.
Dialogue: 0,0:20:42.85,0:20:49.47,italics,ELYMAS/ID,0,0,0,,Nghĩ lại thì, chắc chắn cô ấy thi triển phép hồi máu đó\Nlà để chủ động tạo thiện cảm với tụi mình.
Dialogue: 0,0:20:50.13,0:20:53.54,italics,ELYMAS/ID,0,0,0,,Chứ vết thương nhẹ hều lúc nãy đâu cần dùng tới Trị Liệu.
Dialogue: 0,0:20:59.91,0:21:05.81,italics,ELYMAS/ID,0,0,0,,Vừa né tránh vừa thỉnh thoảng giao chiến với\Nđám xác sống lang thang quanh khu vực...
Dialogue: 0,0:21:10.69,0:21:15.12,italicstop,ELYMAS/ID,0,0,0,,cuối cùng chúng tôi cũng đặt chân tới\Ncửa vào Nghĩa Địa Bi Thương.
Dialogue: 0,0:21:09.96,0:21:15.84,sign_generic,SIGN,0,0,0,,{\bord0\an7\fade(2350,1)\b1\fs15\pos(210.486,292.99)}Lối Vào Nghĩa Địa Bi Thương
Dialogue: 0,0:21:12.58,0:21:15.84,sign_generic,SIGN,0,0,0,,{\bord0\fs8\b1\an7\fade(430,1)\pos(535.5,310.202)}Cấp Độ Đề Xuất: 70
Dialogue: 0,0:21:16.25,0:21:18.03,Default,ELYMAS,0,0,0,,Nơi này đúng là danh xứng với thực thật.
Dialogue: 0,0:21:18.03,0:21:22.09,Default,RUCHE,0,0,0,,Sao người ta không mai táng cho họ\Nmột cách đàng hoàng tử tế hơn chứ?
Dialogue: 0,0:21:22.38,0:21:25.16,Default,RUCHE,0,0,0,,Chính điều đó mới khiến hầm ngục này sản sinh ra.
Dialogue: 0,0:21:25.16,0:21:28.10,Default,ELYMAS,0,0,0,,Biết đâu ngày xưa từng có một ngôi làng gần đây.
Dialogue: 0,0:21:28.62,0:21:32.98,Default,ELYMAS,0,0,0,,Dân làng hẳn là đã chết sạch hoặc\Ndi cư sang Lacoryna hết cả rồi.
Dialogue: 0,0:21:33.31,0:21:36.93,italics,ELYMAS/ID,0,0,0,,Ở đây cũng đang có điều gì đó bất thường xảy ra.
Dialogue: 0,0:21:36.93,0:21:38.72,italics,ELYMAS/ID,0,0,0,,Mình nhất định phải tìm ra chân tướng mọi chuyện.
Dialogue: 0,0:21:49.87,0:21:56.50,sign_generic,credits,0,0,0,,{\an9\fs15\b1\c&HEDEAEB&\3c&H0B1211&\blur1}Phụ đề Việt ngữ:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Dịch thuật & Biên tập:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Hiệu đính & QC:\N{\fs17.5}Amtia(NOFACE)
Dialogue: 0,0:23:12.46,0:23:17.15,italics,ELYMAS/NA,0,0,0,,Mình và Ruche đã gia nhập một nhóm chinh phạt\Ngồm toàn các mạo hiểm giả cấp cao.
Dialogue: 0,0:23:17.68,0:23:20.28,italics,ELYMAS/NA,0,0,0,,Tụi mình bắt cặp cùng những đồng minh mới,
Dialogue: 0,0:23:20.28,0:23:23.88,italics,ELYMAS/NA,0,0,0,,rồi chia đội để tiêu diệt càng nhiều\Nquái vật càng tốt.
Dialogue: 0,0:23:25.05,0:23:30.22,italics,ELYMAS/NA,0,0,0,,Cả Kelt lẫn Maebel đều là những kẻ khá lập dị.
Dialogue: 0,0:23:31.26,0:23:34.77,italics,ELYMAS/NA,0,0,0,,Tập tiếp theo, "Thợ Săn Kelt\Nvà Tu Sĩ Maebel".
Dialogue: 0,0:23:34.77,0:23:37.84,italics,ELYMAS/NA,0,0,0,,Mong rằng mọi chuyện chỉ dừng lại ở chừng này để lo thôi.

