Dialogue: 0,0:00:29.14,0:00:30.24,Default,RUCHE,0,0,0,,Ủa?
Dialogue: 0,0:00:30.93,0:00:32.88,Default,RUCHE,0,0,0,,Cửa mở sẵn rồi kìa.
Dialogue: 0,0:00:32.05,0:00:35.26,overlap,HILDE,0,0,0,,Lão già kia, ông chẳng hiểu chuyện gì cả.
Dialogue: 0,0:00:35.26,0:00:37.66,Default,HILDE,0,0,0,,Tôi đâu có bảo ông phải bố thí không công cho tôi.
Dialogue: 0,0:00:37.66,0:00:40.23,Default,HILDE,0,0,0,,Tôi bảo ông hãy bán thanh kiếm đó cho tôi cơ mà.
Dialogue: 0,0:00:40.23,0:00:42.84,Default,VERUGA,0,0,0,,Ta không có bất kỳ thứ vũ khí nào để bán cho cô nhóc cả.
Dialogue: 0,0:00:42.84,0:00:45.23,Default,VERUGA,0,0,0,,Huống hồ, thanh kiếm này là tác phẩm do khách hàng đặt làm riêng.
Dialogue: 0,0:00:42.34,0:00:43.88,top,ELYMAS,0,0,0,,Nghe chừng tình hình căng thẳng rồi đây.
Dialogue: 0,0:00:43.88,0:00:44.71,top,RUCHE,0,0,0,,Dạ vâng.
Dialogue: 0,0:00:46.21,0:00:47.53,Default,ELYMAS,0,0,0,,Bác có sao không ạ, bác Veruga?
Dialogue: 0,0:00:47.53,0:00:50.22,Default,VERUGA,0,0,0,,Ta chịu hết nổi rồi đấy, Ma Kiếm Sĩ.
Dialogue: 0,0:00:50.22,0:00:53.07,Default,HILDE,0,0,0,,Ồ? Cậu là khách đặt làm thanh kiếm đó đấy à?
Dialogue: 0,0:00:56.51,0:00:58.76,Default,HILDE,0,0,0,,Tôi đang tự hỏi không biết vị khách đó là ai đây.
Dialogue: 0,0:00:58.76,0:01:04.12,Default,HILDE,0,0,0,,Lão già, ông cất công rèn một thanh Ngân Kiếm\Ncho cái tên trông ẻo lả yếu nhớt này sao?
Dialogue: 0,0:01:01.54,0:01:04.12,italicstop,ELYMAS/ID,0,0,0,,Mình nghe thấy tiếng cô ta, nhưng lại chẳng thấy bóng dáng đâu cả.
Dialogue: 0,0:01:04.12,0:01:07.55,Default,HILDE,0,0,0,,Lẽ nào ông túng thiếu tiền bạc\Nđến mức mất trí rồi hả Veruga?
Dialogue: 0,0:01:07.55,0:01:08.55,italics,ELYMAS/ID,0,0,0,,Cô ta đang dùng kỹ năng ẩn thân sao?
Dialogue: 0,0:01:08.55,0:01:10.77,Default,RUCHE,0,0,0,,Anh Elymas, nhìn xuống dưới kìa anh!
Dialogue: 0,0:01:11.18,0:01:12.57,Default,RUCHE,0,0,0,,Ở dưới chân anh kìa!
Dialogue: 0,0:01:18.03,0:01:22.48,Default,HILDE,0,0,0,,Này thằng khốn kia. Mày đang cười cợt chế giễu tao đấy à?
Dialogue: 0,0:01:22.48,0:01:25.82,Default,ELYMAS,0,0,0,,C-Con nhóc này bị làm sao thế không biết?
Dialogue: 0,0:02:58.16,0:03:02.62,sign_generic,EPTITLE; sign,0,0,0,,{\b1\fnSegoe UI\an7\bord1\shad1.25\fade(820,482)\alphaalphaH&0&\3c&H000000&\c&HFEFCFD&\4c&H000000&\fs18\pos(333.002,289.564)}Tập 20\h\h\h\h\hMa Kiếm Sĩ Hilde
Dialogue: 0,0:02:58.66,0:03:03.12,top,HILDE,0,0,0,,Này thằng khốn kia. Mày đang cười cợt chế giễu tao đấy à?
Dialogue: 0,0:03:03.12,0:03:05.37,Default,HILDE,0,0,0,,Nếu có lời nào muốn sủa\Nthì phọt ra lẹ đi.
Dialogue: 0,0:03:05.84,0:03:09.30,Default,ELYMAS,0,0,0,,Trẻ con à? Không, cô ta đã sở hữu chức nghiệp.
Dialogue: 0,0:03:09.30,0:03:11.55,Default,ELYMAS,0,0,0,,Nếu đã trải qua nghi thức chúc phúc rồi,\Nvậy là năm nay mười lăm tuổi sao?
Dialogue: 0,0:03:11.55,0:03:13.10,Default,HILDE,0,0,0,,Tôi mười bảy tuổi rồi đấy.
Dialogue: 0,0:03:14.10,0:03:15.75,italics,ELYMAS/ID,0,0,0,,Cô ta còn lớn tuổi hơn mình á? Đùa nhau chắc.
Dialogue: 0,0:03:15.75,0:03:18.22,Default,HILDE,0,0,0,,Trông cậu có vẻ chẳng mảy may ấn tượng gì về tôi nhỉ.
Dialogue: 0,0:03:18.53,0:03:24.23,Default,HILDE,0,0,0,,Thế cậu đã từng nghe danh Ma Kiếm Sĩ\Nđược xưng tụng là Hắc Diệm Kiếm chưa?
Dialogue: 0,0:03:27.17,0:03:30.73,italics,ELYMAS/ID,0,0,0,,Mình từng nghe qua biệt danh đó\Nkhi thu thập thông tin ở Lacoryna.
Dialogue: 0,0:03:31.26,0:03:32.72,italics,ELYMAS/ID,0,0,0,,Hắc Diệm Kiếm.
Dialogue: 0,0:03:33.17,0:03:38.70,italics,ELYMAS/ID,0,0,0,,Đó là một trong số ít những mạo hiểm giả\Nhạng A hiếm hoi tại Lacoryna.
Dialogue: 0,0:03:42.39,0:03:48.87,Default,HILDE,0,0,0,,Thật ra thì, tôi chính là truyền nhân của\Nmạo hiểm giả lừng danh Hắc Diệm Kiếm đó...
Dialogue: 0,0:03:51.12,0:03:54.00,Default,HILDE,0,0,0,,...là đại đệ tử xuất sắc nhất của ngài ấy đấy!
Dialogue: 0,0:03:58.63,0:04:02.22,Default,ELYMAS,0,0,0,,R-Ra vậy. Nghe quả thực rất oách.
Dialogue: 0,0:04:03.18,0:04:06.38,Default,HILDE,0,0,0,,Chính chủ thanh kiếm đã xuất hiện thì nói chuyện\Ncho nhanh gọn vậy.
Dialogue: 0,0:04:06.38,0:04:09.76,Default,HILDE,0,0,0,,Chắc chắn cậu sẽ dễ nói chuyện hơn\Nlão già bảo thủ kia nhiều.
Dialogue: 0,0:04:10.78,0:04:13.47,Default,HILDE,0,0,0,,Tôi chỉ muốn nói đúng một điều thôi.
Dialogue: 0,0:04:13.83,0:04:16.07,Default,HILDE,0,0,0,,Hãy bán thanh Ngân Kiếm đó cho tôi.
Dialogue: 0,0:04:16.38,0:04:20.86,Default,ELYMAS,0,0,0,,Không. Tôi thuê bác ấy rèn nó\Nvì chính tôi đang cần dùng.
Dialogue: 0,0:04:20.86,0:04:23.49,Default,HILDE,0,0,0,,Nghĩ lại đi nào, Trọng Kỵ Sĩ.
Dialogue: 0,0:04:23.49,0:04:29.24,Default,HILDE,0,0,0,,Một chức nghiệp khiếm khuyết như cậu\Ncầm thanh kiếm đó cũng chẳng có ích gì đâu.
Dialogue: 0,0:04:29.24,0:04:32.10,Default,HILDE,0,0,0,,Cậu nghĩ mình làm được trò trống gì\Nvới một thanh kiếm xịn chứ?
Dialogue: 0,0:04:32.10,0:04:34.50,Default,HILDE,0,0,0,,Cậu đúng là chẳng hiểu quy luật của thế giới này gì cả.
Dialogue: 0,0:04:34.78,0:04:37.65,Default,HILDE,0,0,0,,Tôi đâu có bảo cậu bán rẻ mạt cho tôi đâu.
Dialogue: 0,0:04:37.65,0:04:40.51,Default,HILDE,0,0,0,,Ba mươi triệu vàng chắc là đủ rồi chứ.
Dialogue: 0,0:04:40.84,0:04:44.10,Default,HILDE,0,0,0,,Chừng đó chắc hẳn là số tiền\Nlớn hơn sức tưởng tượng của cậu nhiều đấy.
Dialogue: 0,0:04:44.10,0:04:45.51,Default,ELYMAS,0,0,0,,Tôi đã nói là không rồi mà.
Dialogue: 0,0:04:45.89,0:04:48.52,Default,ELYMAS,0,0,0,,Chỉ vỏn vẹn ba mươi triệu thôi thì chưa đủ đâu.
Dialogue: 0,0:04:49.57,0:04:55.78,Default,VERUGA,0,0,0,,N-Này nhóc. Con bé kia trông thì giống nhãi ranh thật,\Nnhưng thực lực của nó là hàng thật đấy.
Dialogue: 0,0:04:55.78,0:04:57.03,Default,HILDE,0,0,0,,Lão già thối tha kia, ông vừa lầm bầm cái gì thế hả?
Dialogue: 0,0:04:57.34,0:05:02.01,Default,VERUGA,0,0,0,,Nó là mạo hiểm giả hạng B và đang giữ kỷ lục\Nsăn đơn Chúa Tể Mộng Cảnh đấy.
Dialogue: 0,0:05:03.11,0:05:04.53,Default,HILDE,0,0,0,,Ừ-Ừm, cũng đúng là thế thật.
Dialogue: 0,0:05:05.11,0:05:09.48,Default,VERUGA,0,0,0,,Cơ mà cái nết của nó thối như cứt,\Nnên tốt nhất cậu đừng có chọc giận nó.
Dialogue: 0,0:05:09.48,0:05:10.50,Default,HILDE,0,0,0,,Này lão kia!
Dialogue: 0,0:05:10.79,0:05:16.38,Default,ELYMAS,0,0,0,,Cháu tưởng bác từ chối nhận việc\Nvì bác ghét hạng người như cô ta chứ.
Dialogue: 0,0:05:16.69,0:05:18.95,Default,ELYMAS,0,0,0,,Chà, cháu cũng chả ưa nổi cô ta đâu.
Dialogue: 0,0:05:18.95,0:05:20.47,Default,ELYMAS,0,0,0,,Tôi không có hứng thú thương lượng.
Dialogue: 0,0:05:20.47,0:05:21.38,Default,HILDE,0,0,0,,Này!
Dialogue: 0,0:05:21.38,0:05:26.48,Default,VERUGA,0,0,0,,Thân già này chuẩn bị sẵn tâm lý gánh hậu quả rồi,\Nnhưng hai đứa còn trẻ.
Dialogue: 0,0:05:26.48,0:05:29.82,Default,VERUGA,0,0,0,,Đừng có tự chuốc thêm kẻ thù phiền phức\Ntrong Hội nếu không cần thiết.
Dialogue: 0,0:05:29.82,0:05:32.14,Default,VERUGA,0,0,0,,Cứ để lão này tự giải quyết.
Dialogue: 0,0:05:32.14,0:05:33.90,italics,ELYMAS/ID,0,0,0,,Xem ra ông bác này bên trong cũng mềm lòng ghê nhỉ.
Dialogue: 0,0:05:34.20,0:05:36.02,Default,ELYMAS,0,0,0,,Bác đừng lo cho tụi cháu.
Dialogue: 0,0:05:36.02,0:05:37.88,Default,ELYMAS,0,0,0,,Tụi cháu là mạo hiểm giả mà.
Dialogue: 0,0:05:37.88,0:05:41.28,Default,ELYMAS,0,0,0,,Cùng lắm nếu có chuyện,\Ntụi cháu chuyển sang thành phố khác là xong.
Dialogue: 0,0:05:42.52,0:05:45.49,Default,ELYMAS,0,0,0,,Hơn nữa cháu cũng không nghĩ mình yếu hơn cô ta đâu.
Dialogue: 0,0:06:02.52,0:06:05.22,Default,HILDE,0,0,0,,Ồ? Phản xạ cũng khá phết nhỉ.
Dialogue: 0,0:06:05.22,0:06:07.90,Default,HILDE,0,0,0,,Nhưng chỉ số của cậu thảm hại quá đấy.
Dialogue: 0,0:06:07.90,0:06:10.34,Default,HILDE,0,0,0,,Đúng là giới hạn của Trọng Kỵ Sĩ có khác.
Dialogue: 0,0:06:10.34,0:06:15.41,Default,HILDE,0,0,0,,Cậu may mắn đấy. Nếu tôi mà cáu thêm chút nữa,\Ntôi đã lấy mạng cậu luôn rồi.
Dialogue: 0,0:06:15.41,0:06:18.48,Default,HILDE,0,0,0,,Vung vẩy thứ vũ khí quá tầm với\Nsẽ chẳng cứu nổi cậu khỏi cái chết đâu.
Dialogue: 0,0:06:19.29,0:06:21.99,Default,HILDE,0,0,0,,Giờ thì mau bán thanh kiếm cho tôi đi.
Dialogue: 0,0:06:21.99,0:06:24.80,Default,RUCHE,0,0,0,,A-Anh Elymas, anh có sao không ạ?
Dialogue: 0,0:06:24.80,0:06:28.62,Default,RUCHE,0,0,0,,C-C-Cô định làm cái quái gì thế hả?!
Dialogue: 0,0:06:28.62,0:06:32.25,Default,HILDE,0,0,0,,Tôi chỉ vừa cho hắn nếm thử xem hắn yếu ớt tới mức nào thôi.
Dialogue: 0,0:06:32.61,0:06:36.38,Default,ELYMAS,0,0,0,,Đánh úp bất ngờ đâu có chứng minh được\Ncô mạnh hơn tôi.
Dialogue: 0,0:06:36.38,0:06:37.08,Default,HILDE,0,0,0,,Cái gì cơ?
Dialogue: 0,0:06:37.40,0:06:40.56,Default,HILDE,0,0,0,,Thế sao hả? Muốn quyết đấu tay đôi không?
Dialogue: 0,0:06:40.56,0:06:45.13,Default,HILDE,0,0,0,,Nếu cậu dám đem thanh Ngân Kiếm kia ra đặt cược,\Ntôi sẵn sàng tiếp chiêu cậu đấy.
Dialogue: 0,0:06:45.13,0:06:47.09,Default,ELYMAS,0,0,0,,Vậy cô định đặt cược cái gì?
Dialogue: 0,0:06:47.77,0:06:50.60,Default,HILDE,0,0,0,,Làm gì có chuyện {\i1}tôi{\i0} thua nổi chứ,
Dialogue: 0,0:06:50.88,0:06:54.98,Default,HILDE,0,0,0,,nhưng nếu thua, tôi sẽ từ bỏ thanh kiếm đó\Nvà trả cho cậu đúng bằng giá thị trường của nó.
Dialogue: 0,0:06:55.28,0:06:59.11,Default,HILDE,0,0,0,,Thế nào? Giờ cậu hết cớ\Nđể thoái thác rồi nhé.
Dialogue: 0,0:06:59.11,0:07:01.50,Default,VERUGA,0,0,0,,Đừng có dại dột nhận lời nó, nhóc ơi.
Dialogue: 0,0:07:01.50,0:07:04.86,Default,VERUGA,0,0,0,,Ma Kiếm Sĩ cực kỳ thiện chiến\Ntrong các trận solo một chọi một.
Dialogue: 0,0:07:04.86,0:07:09.07,Default,VERUGA,0,0,0,,Đấu tay đôi với nó\Nthì chẳng công bằng với cậu chút nào đâu.
Dialogue: 0,0:07:10.63,0:07:14.87,Default,ELYMAS,0,0,0,,Cô chấp nhận điều kiện đó chứ?\NVậy thì tôi vui vẻ nhận lời.
Dialogue: 0,0:07:17.29,0:07:19.91,Default,RUCHE,0,0,0,,K-Không ổn chút nào đâu anh ơi.
Dialogue: 0,0:07:19.91,0:07:22.30,Default,RUCHE,0,0,0,,Cô ta là Ma Kiếm Sĩ hạng B đấy.
Dialogue: 0,0:07:22.30,0:07:26.30,Default,RUCHE,0,0,0,,Ngay cả em còn biết bọn họ là những kẻ vô đối khi quyết đấu mà.
Dialogue: 0,0:07:26.61,0:07:31.19,Default,ELYMAS,0,0,0,,Vốn dĩ anh định xử lý chuyện này khéo léo hơn,\Nnhưng tự dưng thấy hơi nóng máu rồi đấy.
Dialogue: 0,0:07:31.19,0:07:32.31,Default,RUCHE,0,0,0,,Anh Elymas?
Dialogue: 0,0:07:32.31,0:07:35.90,Default,ELYMAS,0,0,0,,Tự dưng có 30.000.000 vàng dâng tận miệng\Nthì dại gì mà anh để tuột mất.
Dialogue: 0,0:07:35.90,0:07:38.56,Default,ELYMAS,0,0,0,,Chắc anh phải dạy cho cô một bài học nhớ đời mới được,\NHilde ạ.
Dialogue: 0,0:07:38.56,0:07:41.09,Default,HILDE,0,0,0,,Cậu ngu ngốc thế này đúng là may cho tôi quá.
Dialogue: 0,0:07:41.09,0:07:45.84,Default,HILDE,0,0,0,,Tôi sẽ gọi nhân viên hội tới làm chứng trận đấu\Nđể cậu khỏi giở trò chuồn lẹ.
Dialogue: 0,0:07:45.84,0:07:47.57,Default,HILDE,0,0,0,,Cậu đừng có mà hối hận đấy nhé.
Dialogue: 0,0:08:02.57,0:08:05.49,italics,ELYMAS/ID,0,0,0,,Chắc Hilde sắp quay lại rồi.
Dialogue: 0,0:08:08.55,0:08:10.02,Default,ELYMAS,0,0,0,,Khiên Sinh Mệnh!
Dialogue: 0,0:08:08.97,0:08:10.47,sign_generic,SIGN,0,0,0,,{\fade(685,1)\c&H68E7FE&\bord1\blur0.5\3c&H6B5176&\b1\an8\pos(470.8,189.2)}Khiên Sinh Mệnh {\fs13\bord2\blur1.5\c&HF0EEE6&\3c&HFAE15E&}[Kỹ Năng Chung]\N Tiêu hao 20% HP tối đa để kích hoạt\N Tạo lớp khiên bao bọc người thi triển\Nvới độ bền bằng lượng HP đã mất
Dialogue: 0,0:08:13.99,0:08:17.98,Default,VERUGA,0,0,0,,Này nhóc, cậu đang làm trò gì vậy?
Dialogue: 0,0:08:17.98,0:08:22.48,Default,VERUGA,0,0,0,,Kích hoạt rồi lại tự giải trừ kỹ năng\Nthì có tác dụng khỉ gì đâu?
Dialogue: 0,0:08:22.78,0:08:24.26,Default,VERUGA,0,0,0,,Ta chẳng hiểu mô tê gì hết.
Dialogue: 0,0:08:24.73,0:08:26.31,Default,ELYMAS,0,0,0,,Cháu đang căn chỉnh lượng HP của mình ạ.
Dialogue: 0,0:08:26.31,0:08:27.99,Default,VERUGA,0,0,0,,Nghe thế ta lại càng mù tịt hơn.
Dialogue: 0,0:08:28.42,0:08:30.99,Default,RUCHE,0,0,0,,Anh Elymas, liệu anh có thắng nổi cô ta không?
Dialogue: 0,0:08:31.24,0:08:35.16,Default,RUCHE,0,0,0,,Anh định trông cậy vào Long Nộ Tử Nhãn\Nđể giành chiến thắng trận đấu này đúng không ạ?
Dialogue: 0,0:08:36.25,0:08:40.46,Default,RUCHE,0,0,0,,Em không nghĩ Xả Bỏ Phòng Ngự\Nsẽ giúp ích được gì trong kèo này đâu.
Dialogue: 0,0:08:40.46,0:08:41.50,Default,ELYMAS,0,0,0,,Em nói đúng đấy.
Dialogue: 0,0:08:43.07,0:08:45.04,flashback,ELYMAS,0,0,0,,Xả Bỏ Phòng Ngự!
Dialogue: 0,0:08:57.52,0:09:03.08,Default,ELYMAS,0,0,0,,Sức tấn công tăng gấp sáu lần chẳng bõ bèn gì\Nso với lượng sát thương phải gánh thêm đâu.
Dialogue: 0,0:09:03.74,0:09:08.00,Default,ELYMAS,0,0,0,,Tự hạ Phòng Ngự về không trước đối thủ\Ncó đòn đánh tầm xa
Dialogue: 0,0:09:08.00,0:09:10.15,Default,ELYMAS,0,0,0,,thì đúng là tự sát không hơn không kém.
Dialogue: 0,0:09:07.15,0:09:11.03,sign_generic,SIGN,0,0,0,,{\b1\blur1\fade(855,1)\c&HFCF5D7&\3c&HF1DF69&\pos(315.2,210)}Phòng Ngự 0
Dialogue: 0,0:09:11.52,0:09:15.03,Default,ELYMAS,0,0,0,,Ma Kiếm Sĩ thậm chí còn là đối thủ khó nhằn hơn\Ncả Đại Kiếm Sư nữa cơ.
Dialogue: 0,0:09:15.57,0:09:18.04,Default,ELYMAS,0,0,0,,Bên cạnh khả năng bộc phát sức mạnh\Nvà kiếm kỹ,
Dialogue: 0,0:09:18.39,0:09:21.43,Default,ELYMAS,0,0,0,,họ còn sở hữu ma pháp tầm xa\Nvô cùng thực dụng.
Dialogue: 0,0:09:24.54,0:09:28.06,Default,VERUGA,0,0,0,,Giờ chuồn vẫn chưa muộn đâu nhóc.
Dialogue: 0,0:09:28.06,0:09:29.70,Default,ELYMAS,0,0,0,,Tất nhiên, tôi vẫn có cách để giành chiến thắng.
Dialogue: 0,0:09:30.50,0:09:33.40,Default,ELYMAS,0,0,0,,Dù bản thân tôi cũng không thích lối chơi hơi hèn hạ này cho lắm,
Dialogue: 0,0:09:33.40,0:09:36.05,Default,ELYMAS,0,0,0,,nhưng Ma Kiếm Sĩ thường mắc một thói quen\Nsuy nghĩ khá phiến diện.
Dialogue: 0,0:09:36.05,0:09:39.31,Default,RUCHE,0,0,0,,N-Nụ cười đó nhìn gian tà quá anh ơi.
Dialogue: 0,0:09:43.02,0:09:45.61,Default,HILDE,0,0,0,,Tôi dẫn người tới rồi đây, Trọng Kỵ Sĩ!
Dialogue: 0,0:09:46.43,0:09:49.15,Default,HILDE,0,0,0,,Cậu mà dám giở trò gì với thanh kiếm của tôi\Nthì biết tay tôi đấy!
Dialogue: 0,0:09:50.49,0:09:53.91,Default,MATILDA,0,0,0,,Tôi bị lôi xềnh xệch tới đây vì nghe bảo\Ncần xử lý một \"tên Trọng Kỵ Sĩ láo xược\".
Dialogue: 0,0:09:53.91,0:09:58.50,Default,MATILDA,0,0,0,,Tôi biết ngay thế nào cũng là hai người mà,\Nanh Elymas và cô Ruche.
Dialogue: 0,0:10:08.25,0:10:10.93,Default,HILDE,0,0,0,,Bắt đầu thôi nào, Trọng Kỵ Sĩ.
Dialogue: 0,0:10:13.43,0:10:15.92,italics,ELYMAS/ID,0,0,0,,Ma Kiếm Sĩ đối đầu Trọng Kỵ Sĩ.
Dialogue: 0,0:10:16.69,0:10:19.14,italics,ELYMAS/ID,0,0,0,,Đây là kèo đấu khắc chế mình tệ nhất trong một trận quyết đấu.
Dialogue: 0,0:10:19.14,0:10:22.06,italics,ELYMAS/ID,0,0,0,,Nếu đánh tầm xa, cô ta sẽ rỉa sạch HP của mình\Nbằng ma pháp.
Dialogue: 0,0:10:22.06,0:10:24.63,italics,ELYMAS/ID,0,0,0,,Còn nếu mình áp sát, cô ta sẽ chém gục mình\Nbằng kiếm kỹ.
Dialogue: 0,0:10:26.42,0:10:30.36,italics,ELYMAS/ID,0,0,0,,Thế nhưng Ma Kiếm Sĩ vốn dĩ mang\Nmột lối tư duy khá phiến diện.
Dialogue: 0,0:10:30.92,0:10:34.66,italics,ELYMAS/ID,0,0,0,,Và khả năng cao Hilde mắc bệnh này rất nặng.
Dialogue: 0,0:10:47.71,0:10:51.67,Default,ELYMAS,0,0,0,,Cô làm chứng ơi, trước khi bắt đầu\Ntôi muốn xác nhận một chuyện.
Dialogue: 0,0:10:51.67,0:10:53.65,Default,MATILDA,0,0,0,,Có chuyện gì thế, anh Elymas?
Dialogue: 0,0:10:53.65,0:10:57.05,Default,ELYMAS,0,0,0,,Vì tụi tôi sẽ giao đấu bằng kỹ năng,\Nnên trường hợp xấu nhất hoàn toàn có thể xảy ra.
Dialogue: 0,0:10:57.74,0:11:00.51,Default,ELYMAS,0,0,0,,Lỡ như đánh nhau đến mức bị thương hoặc mất mạng thì sao?
Dialogue: 0,0:11:01.39,0:11:06.20,Default,MATILDA,0,0,0,,Hai bên đều đã lường trước rủi ro đó\Nkhi chấp nhận lời quyết đấu rồi.
Dialogue: 0,0:11:06.20,0:11:09.77,Default,MATILDA,0,0,0,,Đó là quy tắc ngầm mà chúng tôi luôn hiểu rõ\Nmỗi khi đứng ra làm nhân chứng.
Dialogue: 0,0:11:09.77,0:11:12.54,Default,MATILDA,0,0,0,,Nếu anh cảm thấy bất an,\Nvậy chúng ta hủy trận đấu nhé?
Dialogue: 0,0:11:12.54,0:11:15.41,Default,ELYMAS,0,0,0,,Không, cô xác nhận rõ như vậy là tôi yên tâm rồi.
Dialogue: 0,0:11:15.41,0:11:17.66,Default,ELYMAS,0,0,0,,Bắt đầu thôi nào, Hilde.
Dialogue: 0,0:11:18.87,0:11:21.20,Default,HILDE,0,0,0,,Cậu đang định khiêu khích tôi đấy à?
Dialogue: 0,0:11:21.20,0:11:23.50,Default,HILDE,0,0,0,,Thích thế thì tôi chiều cậu luôn.
Dialogue: 0,0:11:28.21,0:11:30.13,italics,ELYMAS/ID,0,0,0,,Khoảng cách giữa hai bên khá xa.
Dialogue: 0,0:11:30.13,0:11:32.88,italics,ELYMAS/ID,0,0,0,,Cũng dễ hiểu thôi vì cô ta là\Nchức nghiệp thiên về thi triển phép thuật.
Dialogue: 0,0:11:35.87,0:11:38.39,Default,MATILDA,0,0,0,,Bắt đầu!
Dialogue: 0,0:11:43.13,0:11:44.65,Default,ELYMAS,0,0,0,,Khiên Sinh Mệnh!
Dialogue: 0,0:11:43.35,0:11:45.31,sign_generic,SIGN,0,0,0,,{\bord0\fnSegoe UI\b1\pos(463.2,68.4)\c&HFDFF34&\fade(400,1)}Khiên Sinh Mệnh
Dialogue: 0,0:12:23.55,0:12:26.14,Default,HILDE,0,0,0,,Cái gì thế kia? Kỹ năng quái dị gì vậy?
Dialogue: 0,0:12:42.28,0:12:47.30,Default,RUCHE,0,0,0,,A-Anh vừa mới bảo kỹ năng đó\Nquá nguy hiểm để dùng khi quyết đấu mà!
Dialogue: 0,0:12:48.12,0:12:50.17,sign_generic,SIGN,0,0,0,,{\pos(448,347.6)\b1\bord1.5\fade(650,1)\blur0.5\c&H857F9D&\3c&HDDEAFD&}Xả Bỏ Phòng Ngự {\fs13\bord2\blur1.5\c&HF0EEE6&\3c&HFAE15E&}[Kỹ Năng Chung]\N Chỉ dùng được khi HP dưới 50%\N Giảm Phòng Ngự về 0 và\Ntăng Công kích bằng lượng Phòng Ngự đã mất\N Tiêu hao MP khi duy trì
Dialogue: 0,0:12:51.15,0:12:53.08,italics,HILDE/ID,0,0,0,,Lại thêm một kỹ năng bí ẩn nữa.
Dialogue: 0,0:12:53.41,0:12:56.56,italics,HILDE/ID,0,0,0,,Cộng thêm phản ứng hoảng hốt của con bé kia nữa.
Dialogue: 0,0:12:57.88,0:12:59.05,italics,HILDE/ID,0,0,0,,Tạm thời cứ...
Dialogue: 0,0:13:15.23,0:13:17.32,italics,HILDE/ID,0,0,0,,giữ khoảng cách quan sát hành động của hắn xem sao.
Dialogue: 0,0:13:57.22,0:14:00.21,Default,ELYMAS,0,0,0,,Được rồi, trông ổn phết đấy.
Dialogue: 0,0:14:04.67,0:14:06.30,Default,HILDE,0,0,0,,Khoan, khoan, khoan đã!
Dialogue: 0,0:14:06.30,0:14:08.84,Default,HILDE,0,0,0,,T-Tạm dừng! Hủy trận quyết đấu mau!
Dialogue: 0,0:14:09.29,0:14:10.62,Default,HILDE,0,0,0,,Dừng lại!
Dialogue: 0,0:14:10.94,0:14:11.87,Default,HILDE,0,0,0,,Dừng lại đi mà!
Dialogue: 0,0:14:11.87,0:14:13.95,Default,HILDE,0,0,0,,Tôi buông vũ khí rồi đây này!
Dialogue: 0,0:14:13.95,0:14:15.33,Default,HILDE,0,0,0,,Cậu bị điếc hay sao thế hả?!
Dialogue: 0,0:14:15.33,0:14:16.88,Default,HILDE,0,0,0,,Dừng lại, dừng lại ngay!
Dialogue: 0,0:14:17.46,0:14:19.39,Default,HILDE,0,0,0,,Làm ơn đấy, dừng lại đi!
Dialogue: 0,0:14:20.16,0:14:23.38,Default,HILDE,0,0,0,,T-Tôi bỏ cuộc! Tôi đầu hàng!
Dialogue: 0,0:14:23.38,0:14:26.39,Default,HILDE,0,0,0,,Tôi nhận thua! Tôi thua rồi được chưa?!
Dialogue: 0,0:14:27.23,0:14:31.96,italics,ELYMAS/ID,0,0,0,,Ma Kiếm Sĩ luôn có xu hướng\Nđánh đấm quá đỗi an toàn.
Dialogue: 0,0:14:32.82,0:14:38.43,italics,ELYMAS/ID,0,0,0,,Vì độ bền thấp mà lại phụ thuộc vào các kỹ năng\Nhỏa lực cao kèm tác dụng phụ đánh đổi,
Dialogue: 0,0:14:38.88,0:14:42.90,italics,ELYMAS/ID,0,0,0,,nên Ma Kiếm Sĩ rất dễ mất mạng\Nnếu bị kéo vào cuộc chiến giằng co quá lâu.
Dialogue: 0,0:14:42.90,0:14:47.41,italics,ELYMAS/ID,0,0,0,,Mình biết chắc chắn cô ta sẽ đầu hàng\Nnếu mình cứ áp sát uy hiếp như thế.
Dialogue: 0,0:14:48.71,0:14:50.63,Default,ELYMAS,0,0,0,,Tuyên bố người thắng cuộc đi chứ.
Dialogue: 0,0:14:50.63,0:14:51.91,Default,MATILDA,0,0,0,,V-Vâng ạ.
Dialogue: 0,0:14:52.22,0:14:55.10,Default,MATILDA,0,0,0,,Ng-Người chiến thắng là anh Elymas!
Dialogue: 0,0:14:58.18,0:15:00.48,Default,HILDE,0,0,0,,K-Không đời nào có chuyện đó!
Dialogue: 0,0:15:00.48,0:15:02.67,Default,HILDE,0,0,0,,Tôi chỉ vừa mới bảo tạm hoãn trận đấu thôi mà!
Dialogue: 0,0:15:03.01,0:15:07.26,Default,HILDE,0,0,0,,Tôi buột miệng nói đầu hàng chỉ tại vì\Ncậu cứ sấn tới không chịu dừng đấy chứ!
Dialogue: 0,0:15:07.26,0:15:09.22,Default,ELYMAS,0,0,0,,Dù sao đi nữa, chính miệng cô cũng đã thốt ra rồi.
Dialogue: 0,0:15:09.54,0:15:16.24,Default,MATILDA,0,0,0,,Cô Hilde, Hội Mạo Hiểm Giả không công nhận\Nviệc đổi ý giữa chừng
Dialogue: 0,0:15:16.24,0:15:21.23,Default,MATILDA,0,0,0,,chỉ vì choáng ngợp trước kỹ năng của đối thủ\Nlà lý do chính đáng để hủy bỏ quyết đấu.
Dialogue: 0,0:15:21.60,0:15:23.86,Default,MATILDA,0,0,0,,Vì chính cô đã gọi tôi tới làm nhân chứng,
Dialogue: 0,0:15:23.86,0:15:28.76,Default,MATILDA,0,0,0,,Hội sẽ áp dụng biện pháp chế tài thích đáng\Nnếu cô không tuân thủ đúng quy định.
Dialogue: 0,0:15:28.76,0:15:31.66,Default,HILDE,0,0,0,,T-Tôi biết rồi mà.
Dialogue: 0,0:15:31.66,0:15:36.33,Default,HILDE,0,0,0,,Tôi đâu phải loại keo kiệt bủn xỉn.\NCó đời nào tôi lại lật kèo nuốt lời chứ.
Dialogue: 0,0:15:36.66,0:15:40.50,Default,HILDE,0,0,0,,Nghe này, Elymas. Là do tôi tự hủy trận đấu.
Dialogue: 0,0:15:40.82,0:15:45.51,Default,HILDE,0,0,0,,Xét theo tình hình đó, liệu cậu có chịu\Nchấp nhận mức 20.000.000 vàng không?
Dialogue: 0,0:15:47.77,0:15:50.26,Default,HILDE,0,0,0,,Quả thực 30.000.000 vàng hơi bị chát quá.
Dialogue: 0,0:15:50.72,0:15:51.76,Default,ELYMAS,0,0,0,,Không.
Dialogue: 0,0:15:51.76,0:15:55.39,Default,RUCHE,0,0,0,,Ki bo kiệt sỉ ghê. Mà công nhận cũng hiểu được phần nào.
Dialogue: 0,0:15:55.66,0:16:00.40,Default,HILDE,0,0,0,,T-Tôi chỉ đang thực sự rất cần một món vũ khí\Nxứng tầm với cấp độ của mình thôi.
Dialogue: 0,0:16:00.76,0:16:03.05,Default,HILDE,0,0,0,,Sự trưởng thành của một mạo hiểm giả cấp cao
Dialogue: 0,0:16:03.05,0:16:07.15,Default,HILDE,0,0,0,,cũng góp phần bảo vệ thành phố và\Ngiảm thiểu thiệt hại do quái vật gây ra mà.
Dialogue: 0,0:16:07.15,0:16:10.28,Default,HILDE,0,0,0,,Tôi xin nhận lỗi vì phương pháp của mình sai trái.
Dialogue: 0,0:16:10.28,0:16:12.99,Default,HILDE,0,0,0,,Tôi hứa sẽ không bao giờ làm chuyện như vậy nữa đâu.
Dialogue: 0,0:16:13.34,0:16:14.64,Default,ELYMAS,0,0,0,,Miễn là cô đã hiểu ra điều đó.
Dialogue: 0,0:16:15.83,0:16:19.50,Default,HILDE,0,0,0,,V-Vậy cậu có bằng lòng nhận lấy\N20.000.000 vàng không?
Dialogue: 0,0:16:19.96,0:16:21.00,Default,ELYMAS,0,0,0,,Không.
Dialogue: 0,0:16:25.97,0:16:28.19,Default,VERUGA,0,0,0,,N-Nghe này, chàng trai.
Dialogue: 0,0:16:30.22,0:16:33.44,Default,VERUGA,0,0,0,,Lúc nãy ta còn hơi lưỡng lự chưa tiện nói ra,
Dialogue: 0,0:16:33.44,0:16:38.00,Default,VERUGA,0,0,0,,nhưng giá thị trường của thanh kiếm này\Nkhông phải là 30.000.000 vàng đâu.
Dialogue: 0,0:16:39.27,0:16:40.79,Default,ELYMAS,0,0,0,,Thật sao bác?
Dialogue: 0,0:16:40.79,0:16:43.36,Default,HILDE,0,0,0,,Hóa ra là hàng giả à?
Dialogue: 0,0:16:44.70,0:16:48.86,Default,HILDE,0,0,0,,Tôi đã cược đúng bằng giá thị trường của thanh kiếm đó.
Dialogue: 0,0:16:50.10,0:16:52.37,Default,HILDE,0,0,0,,Làm tôi hú vía cả buổi nãy giờ.
Dialogue: 0,0:16:52.37,0:16:56.37,Default,VERUGA,0,0,0,,Hai đứa tự nhìn đi thì biết.
Dialogue: 0,0:16:57.03,0:16:58.37,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Ngân Kiếm.
Dialogue: 0,0:16:58.37,0:17:00.87,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Sức tấn công: +46.
Dialogue: 0,0:17:00.87,0:17:04.09,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Giá thị trường: 51.500.000 vàng.
Dialogue: 0,0:17:04.09,0:17:07.01,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Một thanh ma kiếm tỏa sáng rực rỡ\Nvới nguồn ma lực dồi dào.
Dialogue: 0,0:17:07.01,0:17:09.38,italics,SYSTEM VOICE,0,0,0,,[Hệ thống] Đã được khảm Cổ Tự Hủy Diệt.
Dialogue: 0,0:16:56.58,0:17:09.38,sign_generic,SIGN,0,0,0,,{\b1\bord1.5\blur0.5\fade(1050,1)\c&H443672&\an7\3c&HADCAE8&\pos(307.2,74.8)}Ngân Kiếm {\fs13\bord2\blur1\3c&HAE893F&\c&HFFFED5&}Cấp độ đề xuất: 70\N Sức tấn công: +46\N Giá thị trường: 51.500.000G\N Một thanh ma kiếm tỏa sáng rực rỡ với ma lực\N Đã được khảm Cổ Tự Hủy Diệt
Dialogue: 0,0:17:10.23,0:17:14.64,Default,HILDE,0,0,0,,N-N-Năm mươi mốt triệu vàng cơ á?!
Dialogue: 0,0:17:14.64,0:17:18.15,Default,ELYMAS,0,0,0,,À phải rồi. Mình quên tính luôn cả giá trị\Ncủa viên cổ tự khảm vào nữa.
Dialogue: 0,0:17:18.15,0:17:20.19,Default,ELYMAS,0,0,0,,Đoảng quá đi mất.
Dialogue: 0,0:17:20.19,0:17:21.02,Default,ELYMAS,0,0,0,,Hilde này.
Dialogue: 0,0:17:21.02,0:17:24.69,Default,ELYMAS,0,0,0,,Giá thị trường của nó là 51.500.000 vàng đấy.
Dialogue: 0,0:17:25.06,0:17:28.03,Default,HILDE,0,0,0,,Mẹ kiếp chứ! Tôi đào đâu ra số tiền đó!
Dialogue: 0,0:17:28.47,0:17:31.40,Default,HILDE,0,0,0,,Đừng có ép người quá đáng thế chứ!
Dialogue: 0,0:17:31.67,0:17:35.91,Default,HILDE,0,0,0,,Làm ơn đi mà! Ít nhất cũng giảm xuống còn\N40.000.000 vàng giùm tôi đi!
Dialogue: 0,0:17:35.91,0:17:39.91,Default,ELYMAS,0,0,0,,Cô chọn một kiểu thôi được không,\Nhoặc là gào thét, hoặc là cúi đầu xin xỏ?
Dialogue: 0,0:17:36.35,0:17:39.91,top,HILDE,0,0,0,,Xin tha mạng, tha cho tôi đi!
Dialogue: 0,0:17:40.30,0:17:43.26,top,HILDE,0,0,0,,Xin tha mạng, làm ơn đấy!
Dialogue: 0,0:17:40.48,0:17:43.93,Default,RUCHE,0,0,0,,T-Tự dưng em thấy hơi tội nghiệp cho chị ta rồi đấy.
Dialogue: 0,0:17:43.93,0:17:45.17,Default,ELYMAS,0,0,0,,Anh cũng thấy vậy.
Dialogue: 0,0:17:46.07,0:17:50.92,top,HILDE,0,0,0,,Xin rủ lòng thương!
Dialogue: 0,0:17:45.49,0:17:50.92,Default,ELYMAS,0,0,0,,Nói thật là lý do lớn nhất để tôi nhận lời quyết đấu\Nlà để dạy cho cô một bài học.
Dialogue: 0,0:17:52.29,0:17:56.04,Default,ELYMAS,0,0,0,,Tôi sẽ giảm giá cho cô 1.500.000 vàng\Nvà nhận chẵn 50.000.000 vàng vậy.
Dialogue: 0,0:18:12.99,0:18:17.58,Default,MATILDA,0,0,0,,Chúng tôi có cung cấp gói vay dành cho mạo hiểm giả hạng B đấy ạ.
Dialogue: 0,0:19:05.33,0:19:06.89,Default,MATILDA,0,0,0,,Phải anh Elymas đấy không ạ?
Dialogue: 0,0:19:06.89,0:19:13.09,Default,MATILDA,0,0,0,,Anh vừa nhận được khoản thanh toán 50.000.000 vàng\Ntừ cô Hilde cho trận quyết đấu vừa qua.
Dialogue: 0,0:19:13.45,0:19:15.36,Default,ELYMAS,0,0,0,,Cô ta xoay sở được đống tiền đó thật luôn á?
Dialogue: 0,0:19:15.36,0:19:17.39,Default,ELYMAS,0,0,0,,Mới trôi qua có hai ngày thôi đấy.
Dialogue: 0,0:19:17.69,0:19:21.26,Default,MATILDA,0,0,0,,Chúng tôi quen xử lý mấy vụ tranh chấp\Ngiữa các mạo hiểm giả rồi mà.
Dialogue: 0,0:19:21.66,0:19:24.12,Default,MATILDA,0,0,0,,Chỉ cần phía Hội thấy hợp tình hợp lý...
Dialogue: 0,0:19:25.53,0:19:29.15,flashback,HILDE,0,0,0,,B-Bốn mươi triệu—không, bốn lăm triệu thì sao?
Dialogue: 0,0:19:31.15,0:19:35.40,flashback,HILDE,0,0,0,,Đ-Được rồi, năm mươi triệu!\NTôi trả đủ năm mươi triệu là được chứ gì!
Dialogue: 0,0:19:40.33,0:19:42.95,Default,HILDE,0,0,0,,Đứng lại kia, cái lũ khốn nạn này!
Dialogue: 0,0:19:42.95,0:19:47.21,Default,HILDE,0,0,0,,Mau trả lại 50.000.000 vàng\Nmà chúng mày đã cuỗm mất của tao đây!
Dialogue: 0,0:19:51.22,0:19:53.64,Default,ELYMAS,0,0,0,,Hiểu rồi. Xem ra cô đã phải bán cả vũ khí đi nhỉ.
Dialogue: 0,0:19:53.64,0:19:54.88,Default,ELYMAS,0,0,0,,Chạy lẹ đi, Ruche!
Dialogue: 0,0:19:54.88,0:19:55.67,Default,RUCHE,0,0,0,,Vâng ạ!
Dialogue: 0,0:19:57.64,0:19:58.68,Default,HILDE,0,0,0,,Đừng hòng chạy thoát!
Dialogue: 0,0:20:05.23,0:20:06.23,Default,CARLOS,0,0,0,,Hilde.
Dialogue: 0,0:20:16.89,0:20:19.20,Default,CARLOS,0,0,0,,Đó là Trọng Kỵ Sĩ sao?
Dialogue: 0,0:20:31.38,0:20:34.32,italics,ELYMAS/ID,0,0,0,,Khí chất này, uy áp bức người này.
Dialogue: 0,0:20:39.01,0:20:44.01,italics,ELYMAS/ID,0,0,0,,Đây đích thị là Hắc Diệm Kiếm\Nhàng thật giá thật rồi.
Dialogue: 0,0:20:49.88,0:20:52.02,Default,HILDE,0,0,0,,Chính là bọn chúng đấy, Sư phụ!
Dialogue: 0,0:20:52.39,0:20:56.92,Default,HILDE,0,0,0,,Chúng đã giở thủ đoạn bỉ ổi\Nđể lột sạch tiền của con!
Dialogue: 0,0:21:03.79,0:21:04.92,italics,ELYMAS/ID,0,0,0,,Biết ngay mà.
Dialogue: 0,0:21:06.55,0:21:08.13,Default,CARLOS,0,0,0,,Chức nghiệp của ta là Ma Kiếm Sĩ.
Dialogue: 0,0:21:09.09,0:21:11.32,Default,CARLOS,0,0,0,,Ta là mạo hiểm giả hạng A.\NTên ta là Carlos.
Dialogue: 0,0:21:12.60,0:21:16.71,Default,CARLOS,0,0,0,,Ta rất muốn được gặp cậu một lần\Nsau khi nghe Hilde kể lại mọi chuyện.
Dialogue: 0,0:21:21.80,0:21:23.72,Default,CARLOS,0,0,0,,Trọng Kỵ Sĩ Elymas.
Dialogue: 0,0:21:49.95,0:21:56.59,sign_generic,credits,0,0,0,,{\an9\fs15\b1\c&HEDEAEB&\3c&H0B1211&\blur1}Phụ đề Việt ngữ:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Dịch thuật & Biên tập:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Hiệu đính & QC:\N{\fs17.5}Amtia(NOFACE)
Dialogue: 0,0:23:11.45,0:23:15.80,italics,ELYMAS/NA,0,0,0,,Ma Kiếm Sĩ Carlos đã bất ngờ\Nxuất hiện trước mặt tụi mình.
Dialogue: 0,0:23:15.80,0:23:19.76,italics,ELYMAS/NA,0,0,0,,Ông ấy là sư phụ của Hilde và là một trong những\Nmạo hiểm giả hạng A ở Lacoryna.
Dialogue: 0,0:23:20.38,0:23:22.80,italics,ELYMAS/NA,0,0,0,,Ông ấy còn nổi danh với biệt hiệu\NHắc Diệm Kiếm.
Dialogue: 0,0:23:23.75,0:23:27.82,italics,ELYMAS/NA,0,0,0,,Ban đầu mình cứ ngỡ Carlos tìm đến là vì chuyện của Hilde,
Dialogue: 0,0:23:27.82,0:23:32.52,italics,ELYMAS/NA,0,0,0,,nhưng thực chất ông ấy lại mang đến một đề nghị\Nquan trọng hơn nhiều: một ủy thác không thể chối từ.
Dialogue: 0,0:23:33.19,0:23:35.44,italics,ELYMAS/NA,0,0,0,,Tập tiếp theo, "Hắc Diệm Kiếm".
Dialogue: 0,0:23:35.98,0:23:38.86,italics,ELYMAS/NA,0,0,0,,Trận chiến lớn nhất từ trước tới nay của tụi mình sắp sửa mở màn.

