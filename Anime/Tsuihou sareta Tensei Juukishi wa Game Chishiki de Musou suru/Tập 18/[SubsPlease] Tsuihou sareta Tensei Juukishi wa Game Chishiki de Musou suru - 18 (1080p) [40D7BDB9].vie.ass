Dialogue: 0,0:16:05.14,0:16:05.59,sign_generic,sign,0,0,0,,{\b1\bord1.5\shad2\fs15\c&H534890&\fade(150,263)\frz14.16\pos(366.01,221.32)}vút
Dialogue: 0,0:16:06.14,0:16:06.60,sign_generic,sign,0,0,0,,{\b1\bord1.5\shad2\fs15\c&H534890&\fade(150,263)\frz14.16\pos(370.159,218.678)}vút
Dialogue: 0,0:16:04.36,0:16:06.99,Default,VERUGA,0,0,0,,Thằng nhãi đó chẳng ra cái thể thống gì cả.
Dialogue: 0,0:16:06.99,0:16:09.80,Default,VERUGA,0,0,0,,Cái thằng Ma Kiếm Sĩ chết tiệt đó cứ liên mồm bảo:
Dialogue: 0,0:16:09.80,0:16:14.48,Default,VERUGA,0,0,0,,"Tôi có cả đống tiền đây, ông mau câm mồm \Nvà rèn cho tôi một thanh kiếm xứng tầm đi!"
Dialogue: 0,0:16:14.48,0:16:19.75,Default,VERUGA,0,0,0,,Nó đui hay sao mà không nhận ra: \Nnếu ta ham tiền thì đã chẳng thèm sống ở xó này?!
Dialogue: 0,0:16:19.75,0:16:21.20,italics,ELYMAS/ID,0,0,0,,Nguy hiểm thật đấy.
Dialogue: 0,0:16:21.20,0:16:24.80,italics,ELYMAS/ID,0,0,0,,Ban nãy mình còn tính dùng tiền đè người \Nnếu tình thế bắt buộc nữa chứ.
Dialogue: 0,0:16:25.14,0:16:28.98,italics,ELYMAS/ID,0,0,0,,Có khi nên quay lại vào dịp khác thì hơn.
Dialogue: 0,0:16:24.80,0:16:27.18,top,VERUGA,0,0,0,,Cứ nghĩ tới chúng nó là ta lại sôi cả máu.
Dialogue: 0,0:16:27.18,0:16:30.80,top,VERUGA,0,0,0,,Veruga này không bao giờ chịu khuất phục \Ntrước bất kỳ lời đe dọa nào đâu!
Dialogue: 0,0:16:31.90,0:16:34.83,Default,ELYMAS,0,0,0,,Ừm, cháu nghĩ chúng cháu nên xin phép về trước ạ.
Dialogue: 0,0:16:35.64,0:16:39.31,Default,VERUGA,0,0,0,,Bọn mày không nên để một người già \Nphải đứng nói chuyện thế này chứ.
Dialogue: 0,0:16:39.31,0:16:42.64,Default,VERUGA,0,0,0,,Chẳng biết ý tứ gì cả! Đi theo ta vào trong.
Dialogue: 0,0:16:45.09,0:16:47.50,Default,ELYMAS,0,0,0,,Ruche, mình có nên đi theo không?
Dialogue: 0,0:16:47.94,0:16:52.45,Default,RUCHE,0,0,0,,Có khi ông ấy chỉ đang muốn tìm người tâm sự thôi.
Dialogue: 0,0:16:52.45,0:16:54.25,Default,VERUGA,0,0,0,,Ta nghe thấy hết đấy nhé!
Dialogue: 0,0:16:54.95,0:16:56.97,Default,VERUGA,0,0,0,,Không vào thì biến đi cho khuất mắt!
Dialogue: 0,0:16:56.97,0:16:59.79,Default,RUCHE,0,0,0,,V-Vâng, chúng cháu vào ngay đây ạ!
Dialogue: 0,0:17:00.92,0:17:05.70,Default,VERUGA,0,0,0,,Lũ trẻ thời nay toàn bỏ bê rèn luyện thực lực của bản thân,
Dialogue: 0,0:17:05.70,0:17:08.80,Default,VERUGA,0,0,0,,chỉ nhăm nhe dựa dẫm vào vũ khí với ngoại cảnh.
Dialogue: 0,0:17:09.13,0:17:11.80,Default,VERUGA,0,0,0,,Bản thân người cầm kiếm mới là quan trọng nhất!
Dialogue: 0,0:17:12.38,0:17:17.06,Default,VERUGA,0,0,0,,Ta không thể rèn ra thanh kiếm biến bất kỳ ai \Ncầm nó trở thành anh hùng được,
Dialogue: 0,0:17:17.06,0:17:19.33,Default,VERUGA,0,0,0,,và trên đời này cũng không nên tồn tại thứ vũ khí như thế!
Dialogue: 0,0:17:19.33,0:17:22.06,italics,ELYMAS/ID,0,0,0,,Ông ấy còn định thao thao bất tuyệt \Nchuyện này đến bao giờ nữa đây?
Dialogue: 0,0:17:22.06,0:17:27.34,Default,VERUGA,0,0,0,,Mấy chức nghiệp thiên về thủ với tốc như hai đứa mày \Nkiếm cấp độ trầy trật lắm đúng không.
Dialogue: 0,0:17:27.34,0:17:31.32,Default,VERUGA,0,0,0,,Ta cá là mày đang định dùng tiền đắp vào \Nđể bù lại lực Tấn Công cùi bắp của mình chứ gì,
Dialogue: 0,0:17:31.77,0:17:36.33,Default,VERUGA,0,0,0,,nhưng thói nôn nóng đó chỉ rước cái chết đến sớm thôi!
Dialogue: 0,0:17:36.87,0:17:39.73,italics,ELYMAS/ID,0,0,0,,Dù sao thì ông ấy nói cũng không sai.
Dialogue: 0,0:17:39.73,0:17:43.83,italics,ELYMAS/ID,0,0,0,,Đó là lời khuyên muốn bọn mình phải biết trân quý mạng sống.
Dialogue: 0,0:17:44.14,0:17:46.76,Default,ELYMAS,0,0,0,,Nếu được phép, cháu mạo muội xin hỏi...
Dialogue: 0,0:17:48.21,0:17:54.53,Default,ELYMAS,0,0,0,,ông có thể nghe lời thỉnh cầu của chúng cháu trước khi \Nquyết định xem nó có phạm vào nguyên tắc của ông không?
Dialogue: 0,0:17:55.72,0:18:00.90,Default,VERUGA,0,0,0,,Mày dám ngắt lời khuyên của ta thì đừng hòng \Nđổi được ý định của lão già này!
Dialogue: 0,0:18:02.73,0:18:04.72,Default,ELYMAS,0,0,0,,Cháu muốn nhờ ông rèn thứ này thành một thanh kiếm.
Dialogue: 0,0:18:06.11,0:18:09.42,Default,VERUGA,0,0,0,,C-Cái gì? Đây là...
Dialogue: 0,0:18:12.83,0:18:15.12,Default,VERUGA,0,0,0,,Đây là Ma Ngân (Mythril) ư?!
Dialogue: 0,0:18:15.62,0:18:17.53,Default,VERUGA,0,0,0,,Mày muốn ta rèn một thanh kiếm Ma Ngân sao?!
Dialogue: 0,0:18:17.83,0:18:22.33,Default,VERUGA,0,0,0,,Đã là một người thợ rèn, làm sao ta cưỡng lại được chứ?!
Dialogue: 0,0:18:23.22,0:18:25.34,Default,VERUGA,0,0,0,,K-Không, khoan đã.
Dialogue: 0,0:18:25.34,0:18:31.26,Default,VERUGA,0,0,0,,Giao một vũ khí quá uy lực cho một kẻ yếu ớt \Nsẽ đi ngược lại nguyên tắc của ta.
Dialogue: 0,0:18:31.55,0:18:33.09,Default,VERUGA,0,0,0,,Ta từ chối!
Dialogue: 0,0:18:33.34,0:18:38.35,Default,ELYMAS,0,0,0,,Thưa ông, Ruche và cháu đã đoạt được thứ này \Nsau khi hạ gục một con Golem Ma Ngân đấy ạ.
Dialogue: 0,0:18:38.77,0:18:41.27,Default,VERUGA,0,0,0,,B-Bọn mày làm sao cơ?!
Dialogue: 0,0:18:41.27,0:18:46.77,Default,VERUGA,0,0,0,,Mấy đứa hỉ mũi chưa sạch như bọn mày \Nlàm sao hạ nổi một con Golem Ma Ngân chứ?!
Dialogue: 0,0:18:46.77,0:18:50.28,Default,ELYMAS,0,0,0,,Cháu và Ruche hiện đều là mạo hiểm giả cấp B.
Dialogue: 0,0:18:55.23,0:19:00.41,Default,VERUGA,0,0,0,,Ta chưa từng thấy mạo hiểm giả cấp B nào \Nmặc bộ trang bị tồi tàn như mày mò tới xưởng của ta cả!
Dialogue: 0,0:19:01.43,0:19:04.91,italics,ELYMAS/ID,0,0,0,,Phải rồi, khoác bộ Giáp Sắt này thì thảo nào \Nông ấy không xem mình ra gì,
Dialogue: 0,0:19:05.19,0:19:08.08,italics,ELYMAS/ID,0,0,0,,nhất là với một người thợ rèn như ông ấy.
Dialogue: 0,0:19:09.39,0:19:13.65,Default,VERUGA,0,0,0,,H-Hừ, xem ra hai đứa mày \Ncũng không hẳn là lũ vô dụng phế vật.
Dialogue: 0,0:19:14.06,0:19:17.96,Default,VERUGA,0,0,0,,Tạm thời bọn mày coi như vừa đủ chuẩn của ta. \NSuýt soát thôi đấy nhé!
Dialogue: 0,0:19:17.96,0:19:18.76,Default,ELYMAS,0,0,0,,Thật vậy sao ạ?
Dialogue: 0,0:19:18.76,0:19:20.35,Default,RUCHE,0,0,0,,Em nghĩ ra rồi, anh Elymas ơi!
Dialogue: 0,0:19:20.83,0:19:24.10,Default,RUCHE,0,0,0,,Tiện thể nhờ ông ấy khảm luôn Cổ Tự Hủy Diệt vào kiếm đi anh!
Dialogue: 0,0:19:24.10,0:19:28.33,Default,ELYMAS,0,0,0,,Em nói phải. Dù sao anh cũng sẽ dùng \Nthanh Kiếm Ma Ngân này một thời gian dài.
Dialogue: 0,0:19:28.33,0:19:29.61,Default,ELYMAS,0,0,0,,Làm luôn một thể cũng tốt.
Dialogue: 0,0:19:31.89,0:19:33.52,italics,SYSTEM VOICE,0,0,0,,Cổ Tự Hủy Diệt.
Dialogue: 0,0:19:33.52,0:19:36.10,italics,SYSTEM VOICE,0,0,0,,Giá thị trường: 20.000.000 vàng.
Dialogue: 0,0:19:36.10,0:19:38.16,italics,SYSTEM VOICE,0,0,0,,Cổ tự mang sức mạnh hủy diệt.
Dialogue: 0,0:19:38.16,0:19:42.66,italics,SYSTEM VOICE,0,0,0,,Tăng 30% Sức tấn công của vũ khí.
Dialogue: 0,0:19:31.77,0:19:42.66,sign_generic,SIGN,0,0,0,,{\an7\b1\bord1.5\blur0.5\c&H826349&\3c&H8F9CB0&\fade(357,1)\pos(58.416,190.052)}Cổ Tự Hủy Diệt\N{\fs15\blur1.5\bord1.5\3c&HEFE57A&\c&HFEFCEA&}Giá thị trường: 20.000.000G\NCổ tự mang sức mạnh hủy diệt\NTăng 30% Sức tấn công của vũ khí
Dialogue: 0,0:19:43.36,0:19:45.71,Default,VERUGA,0,0,0,,Mày còn có cả món đồ quý hiếm này nữa cơ à?!
Dialogue: 0,0:19:46.08,0:19:49.92,Default,VERUGA,0,0,0,,Vụ này xem ra lại là mối làm ăn \Nlớn hơn ta tưởng rồi đây.
Dialogue: 0,0:19:52.22,0:19:57.43,italics,ELYMAS/ID,0,0,0,,Để rèn Kiếm Ma Ngân, Giáp Hắc Thiết \Nvà khảm Cổ Tự,
Dialogue: 0,0:19:57.79,0:20:02.31,italics,ELYMAS/ID,0,0,0,,bọn mình đã thỏa thuận trả chi phí là 4.000.000 vàng.
Dialogue: 0,0:20:02.31,0:20:08.31,Default,VERUGA,0,0,0,,Tốt lắm. May là nó không tính tiếp tục \Nchiến đấu với cái bộ Giáp Sắt ghẻ lở kia.
Dialogue: 0,0:20:17.11,0:20:19.46,italics,ELYMAS/ID,0,0,0,,Trong suốt mấy ngày chờ ông ấy hoàn thành trang bị,
Dialogue: 0,0:20:19.46,0:20:23.95,italics,ELYMAS/ID,0,0,0,,bọn mình tranh thủ dạo quanh Lacoryna ngắm cảnh \Nvà thu thập thêm tin tức.
Dialogue: 0,0:20:23.95,0:20:27.00,Default,ELYMAS,0,0,0,,Nếu chúng ta làm thế này, thế này, rồi thế này, \Nbọn mình có thể bán cuốn sách kỹ năng này được giá hơn—
Dialogue: 0,0:20:27.00,0:20:29.69,Default,RUCHE,0,0,0,,Anh Elymas ơi, dẹp chuyện buôn đi bán lại \Nsách sang một bên đi mà.
Dialogue: 0,0:20:29.69,0:20:30.54,Default,ELYMAS,0,0,0,,Hở?
Dialogue: 0,0:20:40.87,0:20:43.40,Default,ELYMAS,0,0,0,,Có người vừa phát hiện ra một hầm ngục mới kìa!
Dialogue: 0,0:20:44.52,0:20:45.45,Default,ELYMAS,0,0,0,,Ồ?
Dialogue: 0,0:20:45.45,0:20:48.02,Default,RUCHE,0,0,0,,Anh có hứng thú với hầm ngục đó không?
Dialogue: 0,0:20:48.02,0:20:51.52,Default,RUCHE,0,0,0,,Hồ Ngầm Raana, cấp độ đề xuất: 20.
Dialogue: 0,0:20:51.98,0:20:56.53,Default,RUCHE,0,0,0,,Cấp độ đề xuất có vẻ hơi thấp \Nso với chúng mình thì phải.
Dialogue: 0,0:20:57.20,0:20:58.83,italics,ELYMAS/ID,0,0,0,,Em ấy nói đúng.
Dialogue: 0,0:20:58.83,0:21:04.03,italics,ELYMAS/ID,0,0,0,,Đó là hầm ngục dành cho mạo hiểm giả mới vào nghề \Nlàm quen với việc săn quái.
Dialogue: 0,0:21:05.92,0:21:07.01,Default,ELYMAS,0,0,0,,Ruche này.
Dialogue: 0,0:21:07.91,0:21:12.54,Default,ELYMAS,0,0,0,,Veruga sẽ còn cần thêm một khoảng thời gian nữa \Nmới rèn xong trang bị cho anh.
Dialogue: 0,0:21:13.60,0:21:18.55,Default,ELYMAS,0,0,0,,Hay là chúng ta tạm gác việc cày cuốc quái vật lại, \Nrồi đi câu cá thư giãn một bữa nhé?
Dialogue: 0,0:21:24.21,0:21:27.22,Default,RUCHE,0,0,0,,Ý-Ý anh là...
Dialogue: 0,0:21:28.81,0:21:32.40,Default,RUCHE,0,0,0,,Anh đang rủ em đi hẹn hò đấy ư?!
Dialogue: 0,0:21:33.63,0:21:34.98,Default,ELYMAS,0,0,0,,Anh chỉ đang rủ em đi câu cá thôi mà.
Dialogue: 0,0:21:34.98,0:21:39.11,Default,RUCHE,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:21:49.91,0:21:56.54,sign_generic,credits,0,0,0,,{\an9\fs15\b1\c&HEDEAEB&\3c&H0B1211&\blur1}Phụ đề Việt ngữ:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Dịch thuật & Biên tập:\N{\fs17.5}Amtia(NOFACE)\N\N{\fs15}Kiểm định Kỹ thuật (QC):\N{\fs17.5}Amtia(NOFACE)
Dialogue: 0,0:23:11.54,0:23:15.82,italics,ELYMAS/NA,0,0,0,,Mọi chuyện với Hội trưởng lẫn lão thợ rèn đều suôn sẻ,
Dialogue: 0,0:23:15.82,0:23:16.87,italics,ELYMAS/NA,0,0,0,,nên giờ là lúc buông cần câu cá thôi!
Dialogue: 0,0:23:17.57,0:23:21.43,italics,ELYMAS/NA,0,0,0,,Ngay từ hồi còn chơi game, mình đã mê mẩn câu cá rồi.
Dialogue: 0,0:23:21.43,0:23:23.98,italics,ELYMAS/NA,0,0,0,,Nhưng liệu bọn mình có thể chuẩn bị được bao nhiêu?
Dialogue: 0,0:23:23.98,0:23:27.01,italics,ELYMAS/NA,0,0,0,,Chúng mình không có đủ thời gian lẫn tiền bạc
Dialogue: 0,0:23:27.01,0:23:30.66,italics,ELYMAS/NA,0,0,0,,để sắm trang bị xịn sò như nguyên liệu làm cần câu ngon \Nhay khảm thêm ngọc.
Dialogue: 0,0:23:31.35,0:23:33.98,italics,ELYMAS/NA,0,0,0,,Tập tiếp theo: "Nữ Hoàng Tộc Cần Thủ".
Dialogue: 0,0:23:34.33,0:23:36.52,italics,ELYMAS/NA,0,0,0,,Một mạo hiểm giả chân chính luôn say mê câu cá.
Dialogue: 0,0:23:36.52,0:23:38.56,italics,ELYMAS/NA,0,0,0,,Đó là triết lý mình luôn tâm niệm \Ntừ thời còn cày con game này.

