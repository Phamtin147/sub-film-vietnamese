Dialogue: 0,0:00:19.56,0:00:20.80,Default,ELYMAS,0,0,0,,Tôi là Elymas.
Dialogue: 0,0:00:21.73,0:00:23.80,Default,ELYMAS,0,0,0,,Còn đây là Ruche.
Dialogue: 0,0:00:23.80,0:00:27.80,Default,ELYMAS,0,0,0,,Đúng như đã báo trước, \Nchúng tôi là mạo hiểm giả đến từ Rondalm.
Dialogue: 0,0:00:28.11,0:00:33.10,Default,ELYMAS,0,0,0,,Đã có một sự biến dị thường \Nxảy ra trong Hành Lang Rết Độc.
Dialogue: 0,0:00:33.41,0:00:38.23,Default,ELYMAS,0,0,0,,Chúng tôi xin diện kiến là để \Ntrực tiếp báo cáo chuyện này với ngài.
Dialogue: 0,0:00:38.94,0:00:42.42,Default,ELYMAS,0,0,0,,Cảm ơn ngài đã dành thời gian tiếp đón.
Dialogue: 0,0:00:48.24,0:00:50.61,Default,HAILENN,0,0,0,,Hừm... Ra là vậy.
Dialogue: 0,0:00:50.61,0:00:55.12,Default,HAILENN,0,0,0,,Ta cũng tò mò vài điều đấy, \Nnhưng sẽ không gặng hỏi đâu.
Dialogue: 0,0:00:58.46,0:01:01.21,italics,ELYMAS/ID,0,0,0,,Cô ta thật khó lường.
Dialogue: 0,0:02:32.17,0:02:36.72,sign_generic,EPTITLE; sign,0,0,0,,{\b1\fnSegoe UI\an7\bord1\shad1.25\fade(1358,482)\alphaalphaH&0&\3c&H000000&\c&HF3F8F7&\4c&H000000&\fs18\pos(322.802,289.964)}Tập 18\h\h\h\h Thợ rèn Veruga
Dialogue: 0,0:02:43.29,0:02:47.41,italics,ELYMAS/ID,0,0,0,,Hội trưởng Hailenn hoàn toàn có thể \Nlà kẻ chủ mưu đứng sau vụ này.
Dialogue: 0,0:02:47.73,0:02:49.93,italics,ELYMAS/ID,0,0,0,,Thay vì thăm dò một cách bất cẩn,
Dialogue: 0,0:02:49.93,0:02:55.53,italics,ELYMAS/ID,0,0,0,,tốt nhất là chỉ báo cáo vắn tắt \Nvề Tử Thần Amude rồi rời đi trong êm đẹp.
Dialogue: 0,0:02:55.88,0:02:58.66,Default,ELYMAS,0,0,0,,Thực ra thì Chúa Tể Mộng Cảnh \Ncủa Hành Lang Rết Độc...
Dialogue: 0,0:02:58.66,0:03:01.91,Default,ELYMAS,0,0,0,,tức Rết Đá khổng lồ, đã Tiến Hóa Hiện Sinh.
Dialogue: 0,0:03:03.53,0:03:06.17,Default,HAILENN,0,0,0,,Hửm? Nó tiến hóa ư?
Dialogue: 0,0:03:07.26,0:03:11.48,Default,ELYMAS,0,0,0,,Việc Chúa Tể Mộng Cảnh Tiến Hóa Hiện Sinh \Nlà thảm họa quái vật vô cùng nghiêm trọng.
Dialogue: 0,0:03:11.92,0:03:17.43,Default,ELYMAS,0,0,0,,Hồ sơ của Hội cho thấy Hành Lang Rết Độc \Nmới xuất hiện chưa được bao lâu.
Dialogue: 0,0:03:17.67,0:03:20.43,Default,ELYMAS,0,0,0,,Chúng tôi nghĩ đây là điềm báo của điều bất thường, \Nnên mới muốn trực tiếp diện kiến ngài.
Dialogue: 0,0:03:20.43,0:03:22.43,Default,ELYMAS,0,0,0,,để báo cáo tận tường mọi việc.
Dialogue: 0,0:03:24.63,0:03:26.69,Default,HAILENN,0,0,0,,Khoan đã... Nó tiến hóa thật sao?!
Dialogue: 0,0:03:29.70,0:03:32.27,Default,ELYMAS,0,0,0,,Vâng. Tôi nghĩ đây là tin rất hệ trọng.
Dialogue: 0,0:03:38.49,0:03:43.08,Default,HAILENN,0,0,0,,Ch-Chúa Tể Mộng Cảnh của Hành Lang Rết Độc \NTiến Hóa Hiện Sinh á?!
Dialogue: 0,0:03:43.08,0:03:46.88,Default,HAILENN,0,0,0,,N-Nhưng hầm ngục đó \Nmới xuất hiện được hai tuần thôi mà!
Dialogue: 0,0:03:47.34,0:03:49.08,Default,HAILENN,0,0,0,,Làm sao chuyện vô lý đó có thể xảy ra được?!
Dialogue: 0,0:03:50.33,0:03:52.34,italics,ELYMAS/ID,0,0,0,,Cô ta đang diễn kịch ư?
Dialogue: 0,0:03:52.59,0:03:56.18,Default,HAILENN,0,0,0,,Chỉ một sơ suất nhỏ thôi, \Nchuyện này sẽ hóa thành đại họa đấy!
Dialogue: 0,0:03:56.18,0:03:58.34,Default,HAILENN,0,0,0,,C-Các ngươi có đang nói thật không?!
Dialogue: 0,0:03:59.97,0:04:03.28,italics,ELYMAS/ID,0,0,0,,Không, khoan đã... Biểu cảm đó liệu có thể \Ngiả vờ đạt đến mức này sao?
Dialogue: 0,0:04:03.28,0:04:05.47,italics,ELYMAS/ID,0,0,0,,Một người nhà Howlrodde có thể diễn sâu vậy ư?
Dialogue: 0,0:04:10.80,0:04:15.15,Default,ELYMAS,0,0,0,,Vâng, chính vì thế chúng tôi \Nmới đến báo cáo ngay cho ngài.
Dialogue: 0,0:04:15.15,0:04:19.11,Default,HAILENN,0,0,0,,Sao cô không báo cho ta sớm hơn hả, Matilda?!
Dialogue: 0,0:04:19.11,0:04:22.49,Default,MATILDA,0,0,0,,Tôi cũng mới nghe chuyện này lần đầu thôi ạ!
Dialogue: 0,0:04:22.78,0:04:27.00,Default,MATILDA,0,0,0,,C-Chuyện này đáng lo ngại đến thế thật sao ạ?
Dialogue: 0,0:04:27.00,0:04:29.50,Default,MATILDA,0,0,0,,Chẳng phải chỉ là cấp độ tăng lên chút đỉnh thôi sao?
Dialogue: 0,0:04:30.07,0:04:32.17,Default,MATILDA,0,0,0,,Vẫn còn nhiều hầm ngục cấp cao hơn thế mà.
Dialogue: 0,0:04:32.17,0:04:34.67,Default,HAILENN,0,0,0,,"Chỉ tăng chút đỉnh thôi" á?!
Dialogue: 0,0:04:35.62,0:04:40.96,Default,HAILENN,0,0,0,,Con Rết Đá cấp 60 đó đã biến thành \Nmột con quái vật tiệm cận cấp 80 rồi đấy!
Dialogue: 0,0:04:40.96,0:04:42.01,Default,MATILDA,0,0,0,,Sao cơ ạ?!
Dialogue: 0,0:04:42.01,0:04:45.68,Default,HAILENN,0,0,0,,Từ trước đến nay hầu như chưa từng có tiền lệ \Nvề việc Chúa Tể Mộng Cảnh Tiến Hóa Hiện Sinh!
Dialogue: 0,0:04:45.68,0:04:50.08,Default,HAILENN,0,0,0,,Chúng ta còn chẳng biết nó sở hữu những kỹ năng gì. \NHoàn toàn mù tịt!
Dialogue: 0,0:04:50.52,0:04:54.02,Default,MATILDA,0,0,0,,V-Vâng, người nói phải. Tôi đã quá nông cạn.
Dialogue: 0,0:04:54.29,0:05:01.93,Default,HAILENN,0,0,0,,Cô nghĩ ở cái thành Lacoryna này có tổ đội nào \Nxử lý nổi một thực thể như thế không hả?!
Dialogue: 0,0:04:59.61,0:05:04.68,italicstop,ELYMAS/ID,0,0,0,,Liệu vẻ hoảng loạn này \Nchỉ là một màn kịch?
Dialogue: 0,0:05:05.42,0:05:12.24,Default,HAILENN,0,0,0,,K-Không ai lường trước được điều gì sẽ xảy ra \Ntrong hầm ngục có Chúa Tể Mộng Cảnh tiến hóa.
Dialogue: 0,0:05:12.24,0:05:15.01,Default,HAILENN,0,0,0,,Nếu chuyện đó thực sự đang diễn ra...
Dialogue: 0,0:05:15.01,0:05:19.08,Default,HAILENN,0,0,0,,chúng ta sẽ phải phát lệnh viễn chinh, huy động \Ntoàn bộ mạo hiểm giả cấp B,
Dialogue: 0,0:05:19.08,0:05:21.93,Default,HAILENN,0,0,0,,hoặc phải hạ mình cầu cứu tông gia giúp đỡ!
Dialogue: 0,0:05:24.47,0:05:29.27,Default,HAILENN,0,0,0,,D-Dù sao thì hai ngươi sống sót trở về \Nvà báo cáo chuyện này cũng là giỏi lắm rồi.
Dialogue: 0,0:05:29.62,0:05:32.77,Default,HAILENN,0,0,0,,Nó có Tràn Ra Ngoài không? Có thương vong gì chưa?
Dialogue: 0,0:05:32.77,0:05:34.45,Default,HAILENN,0,0,0,,Ta không trách cứ các ngươi đâu.
Dialogue: 0,0:05:34.45,0:05:38.28,Default,HAILENN,0,0,0,,Hội cũng sẽ không công khai tên của các ngươi. \NChỉ cần thành thật khai báo là được.
Dialogue: 0,0:05:38.66,0:05:40.78,Default,ELYMAS,0,0,0,,Thực ra thì, ừm...
Dialogue: 0,0:05:40.78,0:05:46.28,Default,ELYMAS,0,0,0,,Hình như ban nãy chúng tôi đã báo là \Nmình đã chinh phạt xong hầm ngục rồi mà.
Dialogue: 0,0:05:46.28,0:05:49.79,Default,HAILENN,0,0,0,,Hả?! Nghĩa là các ngươi đã hạ sát \NChúa Tể Mộng Cảnh ngay tại chỗ?!
Dialogue: 0,0:05:49.79,0:05:52.72,Default,ELYMAS,0,0,0,,Đó là điều chúng tôi nói ngay từ đầu mà.
Dialogue: 0,0:05:52.72,0:05:55.13,Default,HAILENN,0,0,0,,Dù là vậy nhưng...
Dialogue: 0,0:05:55.13,0:06:01.65,top,HAILENN,0,0,0,,Chuyện đó sao có thể chứ? Hai ngươi chỉ là \Nmạo hiểm giả cấp D với trang bị rách nát thôi đấy!
Dialogue: 0,0:05:55.46,0:05:59.88,italics,ELYMAS/ID,0,0,0,,Chắc cô ấy cứ đinh ninh là bọn mình bỏ chạy.
Dialogue: 0,0:06:00.32,0:06:05.41,italics,ELYMAS/ID,0,0,0,,Xem ra Chúa Tể Mộng Cảnh tiến hóa \Nđúng là mối đe dọa khổng lồ với cô ấy.
Dialogue: 0,0:06:05.89,0:06:09.38,italics,ELYMAS/ID,0,0,0,,Có lẽ có thể kết luận rằng Hailenn vô can.
Dialogue: 0,0:06:09.38,0:06:11.64,Default,HAILENN,0,0,0,,Ma Thạch của nó đâu rồi?!
Dialogue: 0,0:06:11.94,0:06:15.79,Default,MATILDA,0,0,0,,Tôi đã làm thủ tục quy đổi ra tiền vàng rồi ạ. \NHiện nó đang được cất trong kho của Hội.
Dialogue: 0,0:06:15.79,0:06:17.15,Default,HAILENN,0,0,0,,R-Ra là thế.
Dialogue: 0,0:06:17.49,0:06:20.65,Default,HAILENN,0,0,0,,Các ngươi đã bàn giao cho Hội rồi à...
Dialogue: 0,0:06:20.93,0:06:25.24,Default,HAILENN,0,0,0,,Ta không nghĩ các ngươi nói dối, \Nnhưng quả thực vẫn quá khó tin.
Dialogue: 0,0:06:26.03,0:06:32.00,Default,MATILDA,0,0,0,,Tiểu thư Hailenn, nếu người đang tìm trà \Nthì ban nãy người làm đổ rồi đấy ạ.
Dialogue: 0,0:06:33.96,0:06:35.25,Default,HAILENN,0,0,0,,Khụ!
Dialogue: 0,0:06:39.17,0:06:41.76,Default,HAILENN,0,0,0,,Matilda, mang nó lại đây cho ta.
Dialogue: 0,0:06:41.99,0:06:44.40,Default,MATILDA,0,0,0,,Lấy thêm trà cho người ạ? Tôi đi ngay.
Dialogue: 0,0:06:44.76,0:06:47.38,Default,HAILENN,0,0,0,,Không, mang viên Ma Thạch ấy!
Dialogue: 0,0:06:47.38,0:06:49.82,Default,MATILDA,0,0,0,,V-Vâng, thưa người! Tôi đi lấy ngay!
Dialogue: 0,0:06:50.97,0:06:55.77,Default,RUCHE,0,0,0,,Em cứ tưởng cô ấy ghê gớm lắm, \Nhóa ra trông cũng đáng yêu phết.
Dialogue: 0,0:06:55.77,0:06:57.28,Default,HAILENN,0,0,0,,Khụ khụ!
Dialogue: 0,0:06:57.77,0:07:01.82,Default,HAILENN,0,0,0,,Cảm ơn hai ngươi vì đã tiêu diệt \NChúa Tể Mộng Cảnh tiến hóa.
Dialogue: 0,0:07:02.18,0:07:04.82,Default,HAILENN,0,0,0,,Ta không ngờ là các ngươi \Nlại có sự chuẩn bị chu đáo đến mức đó.
Dialogue: 0,0:07:04.82,0:07:10.83,Default,HAILENN,0,0,0,,Một Trọng Kỵ Sĩ và một Pierrot cấp D... \NTa có rất nhiều thắc mắc,
Dialogue: 0,0:07:11.09,0:07:14.83,Default,HAILENN,0,0,0,,nhưng kỳ lạ nhất là tại sao chuyện này \Nlại xảy ra ở Hành Lang Rết Độc.
Dialogue: 0,0:07:14.83,0:07:18.71,Default,HAILENN,0,0,0,,Và hiện tại hầm ngục đó đã biến mất...
Dialogue: 0,0:07:19.20,0:07:21.50,Default,ELYMAS,0,0,0,,Ngài không có manh mối nào về nguyên nhân sao?
Dialogue: 0,0:07:21.83,0:07:27.51,Default,HAILENN,0,0,0,,Với tư cách Hội trưởng, ta không thể \Nđưa ra suy đoán mơ hồ cho mạo hiểm giả.
Dialogue: 0,0:07:28.59,0:07:33.14,Default,HAILENN,0,0,0,,Nhưng... chà, ta có thể tiết lộ chừng này.
Dialogue: 0,0:07:34.44,0:07:40.66,Default,HAILENN,0,0,0,,Những vùng hẻo lánh, đặc biệt là phía bắc \Ngần Đại Rừng Cấm,
Dialogue: 0,0:07:40.66,0:07:44.68,Default,HAILENN,0,0,0,,vốn luôn dễ phát sinh các thảm họa quái vật.
Dialogue: 0,0:07:46.40,0:07:52.54,italics,ELYMAS/ID,0,0,0,,Đại Rừng Cấm là nơi tràn ngập \Nnhững hầm ngục cấp cao chưa từng bị chinh phục.
Dialogue: 0,0:07:52.54,0:07:54.59,italics,ELYMAS/ID,0,0,0,,Thảm họa quái vật ở đó xảy ra như cơm bữa,
Dialogue: 0,0:07:54.59,0:07:57.20,italics,ELYMAS/ID,0,0,0,,biến nơi đây thành vùng đất cấm nguy hiểm bậc nhất đại lục.
Dialogue: 0,0:07:58.66,0:08:03.56,Default,ELYMAS,0,0,0,,Và chuyện tương tự lại xảy ra \Ngay sát thành phố đầy mạo hiểm giả thế này sao?
Dialogue: 0,0:08:03.92,0:08:06.92,Default,HAILENN,0,0,0,,Cậu nhạy bén đấy, Elymas.
Dialogue: 0,0:08:07.73,0:08:10.43,Default,HAILENN,0,0,0,,Nhưng ta không thể trả lời câu hỏi đó.
Dialogue: 0,0:08:10.92,0:08:14.75,italics,ELYMAS/ID,0,0,0,,Nói thêm nữa thì cũng chỉ là suy đoán của cô ấy.
Dialogue: 0,0:08:17.78,0:08:19.77,Default,HAILENN,0,0,0,,Nhưng đừng lo.
Dialogue: 0,0:08:19.77,0:08:22.30,Default,HAILENN,0,0,0,,Chúng ta sẽ xem xét vụ này vô cùng nghiêm túc.
Dialogue: 0,0:08:22.30,0:08:25.53,Default,HAILENN,0,0,0,,Cả Hội Mạo Hiểm Giả lẫn Gia tộc Howlrodde \Nsẽ tiến hành điều tra triệt để.
Dialogue: 0,0:08:25.84,0:08:28.49,Default,HAILENN,0,0,0,,Cảm ơn báo cáo và lời cảnh báo của hai ngươi.
Dialogue: 0,0:08:30.83,0:08:33.07,Default,ELYMAS,0,0,0,,Chúng tôi rất cảm kích sự chu đáo của ngài.
Dialogue: 0,0:08:35.04,0:08:38.41,italics,ELYMAS/ID,0,0,0,,Dẫu vậy, mình vẫn cảm thấy có điều gì đó mờ ám.
Dialogue: 0,0:08:41.85,0:08:47.74,italics,ELYMAS/ID,0,0,0,,Mình vẫn tin chắc biến cố này \Nlà do có bàn tay con người can thiệp.
Dialogue: 0,0:08:48.79,0:08:52.15,Default,HAILENN,0,0,0,,Matilda làm gì mà lâu thế không biết.
Dialogue: 0,0:08:52.76,0:08:55.85,Default,HAILENN,0,0,0,,Ta đã bảo là phải nhanh lên rồi mà.
Dialogue: 0,0:08:55.85,0:08:57.27,Default,MATILDA,0,0,0,,Tôi xin lỗi ạ.
Dialogue: 0,0:08:57.73,0:08:59.65,Default,MATILDA,0,0,0,,Thứ lỗi vì sự chậm trễ, thưa tiểu thư Hailenn.
Dialogue: 0,0:08:59.65,0:09:02.61,Default,MATILDA,0,0,0,,Đây là Ma Thạch và trà mới pha ạ.
Dialogue: 0,0:09:02.61,0:09:06.02,Default,HAILENN,0,0,0,,Ta-Ta đã bảo là chỉ mang Ma Thạch thôi mà!
Dialogue: 0,0:09:10.77,0:09:14.78,italics,ELYMAS/ID,0,0,0,,Sau đó, chúng tôi trao đổi thêm \Nvới Hội trưởng Hailenn,
Dialogue: 0,0:09:15.23,0:09:19.10,italics,ELYMAS/ID,0,0,0,,nhưng không thu thập được manh mối cụ thể nào \Nvề sự biến Tử Thần Amude.
Dialogue: 0,0:09:19.83,0:09:25.16,italics,ELYMAS/ID,0,0,0,,Rốt cuộc, lý do nó Tiến Hóa Hiện Sinh \Nvẫn là một bí ẩn chưa có lời giải.
Dialogue: 0,0:09:26.90,0:09:30.96,Default,ELYMAS,0,0,0,,Vậy thì chúng tôi xin phép cáo lui.
Dialogue: 0,0:09:30.96,0:09:35.41,Default,HAILENN,0,0,0,,Khoan đã. Giờ ta đã thấy rõ thực lực của hai ngươi.
Dialogue: 0,0:09:36.23,0:09:41.39,Default,HAILENN,0,0,0,,Ta sẽ phá lệ đặc cách thăng cấp \Ncho hai ngươi lên hạng B ngay bây giờ.
Dialogue: 0,0:09:41.39,0:09:43.31,Default,ELYMAS,0,0,0,,Lên thẳng hạng B ư?!
Dialogue: 0,0:09:43.70,0:09:45.58,Default,MATILDA,0,0,0,,Tiểu thư Hailenn, người chắc chứ ạ?
Dialogue: 0,0:09:45.58,0:09:48.82,Default,MATILDA,0,0,0,,Người thực sự muốn thăng họ vượt cấp C \Nmột cách dễ dàng như thế sao?
Dialogue: 0,0:09:49.89,0:09:51.32,Default,HAILENN,0,0,0,,Không sao cả.
Dialogue: 0,0:09:51.72,0:09:56.83,Default,HAILENN,0,0,0,,Ta được đích thân lãnh chúa chỉ định \Nlàm Hội trưởng Lacoryna này.
Dialogue: 0,0:09:57.19,0:10:02.33,Default,HAILENN,0,0,0,,Sẽ không có chi nhánh Hội nào \Ndám phản đối phán quyết của ta đâu.
Dialogue: 0,0:10:02.95,0:10:08.96,Default,ELYMAS,0,0,0,,Chúng tôi rất cảm kích, nhưng ngài \Ncó yêu cầu điều kiện gì đổi lại không?
Dialogue: 0,0:10:09.26,0:10:10.79,Default,HAILENN,0,0,0,,Cậu nói gì vậy chứ?
Dialogue: 0,0:10:10.79,0:10:15.80,Default,HAILENN,0,0,0,,Đưa những mạo hiểm giả tài năng về đúng cấp bậc \Nhọ xứng đáng là chuyện hết sức tự nhiên.
Dialogue: 0,0:10:16.34,0:10:20.68,Default,HAILENN,0,0,0,,Ta chỉ mong hai ngươi tiếp tục \Nhoạt động với tư cách mạo hiểm giả.
Dialogue: 0,0:10:22.09,0:10:26.24,Default,HAILENN,0,0,0,,Dù sao thì điều đó cũng có lợi \Ncho cả Hội này và vương quốc.
Dialogue: 0,0:10:27.59,0:10:29.19,Default,RUCHE,0,0,0,,C-Cô ấy ngầu quá đi mất!
Dialogue: 0,0:10:29.58,0:10:30.67,Default,HAILENN,0,0,0,,Khụ.
Dialogue: 0,0:10:30.67,0:10:33.07,Default,HAILENN,0,0,0,,Nhưng tiện đây nói thêm chuyện ngoài lề...
Dialogue: 0,0:10:33.07,0:10:36.24,Default,HAILENN,0,0,0,,Ta đang muốn chiêu mộ thêm nhân sự cho Hội.
Dialogue: 0,0:10:36.24,0:10:41.64,Default,HAILENN,0,0,0,,Để giữ vững thanh danh, ta ưu tiên \Nnhững mạo hiểm giả từ cấp B trở lên.
Dialogue: 0,0:10:43.34,0:10:45.58,Default,RUCHE,0,0,0,,Hóa ra đây mới là mục đích thực sự của cô ta.
Dialogue: 0,0:10:48.03,0:10:51.55,italics,ELYMAS/ID,0,0,0,,Mình chẳng bận tâm đến việc làm tròn bổn phận \Nvới Gia tộc Edvaughn,
Dialogue: 0,0:10:52.07,0:10:55.55,italics,ELYMAS/ID,0,0,0,,nhưng mình thấy hơi e ngại khi phải đi phục vụ \Ncho một gia tộc quý tộc khác.
Dialogue: 0,0:10:55.55,0:10:58.26,Default,ELYMAS,0,0,0,,Tôi không mấy mặn mà với việc phục vụ quý tộc.
Dialogue: 0,0:10:58.26,0:11:00.89,Default,RUCHE,0,0,0,,Thế thì em cũng xin từ chối ạ.
Dialogue: 0,0:11:02.79,0:11:05.89,Default,HAILENN,0,0,0,,Các ngươi từ chối đề nghị của ta \Nmà còn chưa nghe qua đãi ngộ sao?
Dialogue: 0,0:11:06.19,0:11:11.40,Default,HAILENN,0,0,0,,Ta sẵn sàng trả thù lao hơn gấp đôi \Nso với các mạo hiểm giả cùng cấp của hai ngươi đấy.
Dialogue: 0,0:11:11.40,0:11:14.09,Default,ELYMAS,0,0,0,,Tôi cũng xin phép từ chối luôn việc thăng hạng.
Dialogue: 0,0:11:14.09,0:11:15.05,Default,RUCHE,0,0,0,,Hả?!
Dialogue: 0,0:11:16.47,0:11:20.91,Default,HAILENN,0,0,0,,Được rồi. Xem ra việc tiếp tục đàm phán \Nchẳng còn ý nghĩa gì nữa.
Dialogue: 0,0:11:22.40,0:11:25.79,Default,HAILENN,0,0,0,,Ta nhớ mình đã nói đề nghị đó \Nhoàn toàn không liên quan đến việc thăng cấp.
Dialogue: 0,0:11:25.79,0:11:28.40,Default,HAILENN,0,0,0,,Những lời ta nói đều là thật lòng.
Dialogue: 0,0:11:28.40,0:11:31.09,Default,HAILENN,0,0,0,,Hai ngươi không cần phải cảm thấy \Nnhư đang mắc nợ ta điều gì đâu.
Dialogue: 0,0:11:31.80,0:11:35.31,Default,ELYMAS,0,0,0,,Nếu vậy thì tôi xin phép vui vẻ đón nhận.
Dialogue: 0,0:11:35.31,0:11:36.20,Default,HAILENN,0,0,0,,Nhưng mà...
Dialogue: 0,0:11:37.00,0:11:42.60,Default,HAILENN,0,0,0,,Nếu các ngươi đổi ý, \Nhãy cứ đến tìm ta bất cứ lúc nào.
Dialogue: 0,0:11:43.03,0:11:49.10,Default,HAILENN,0,0,0,,Ta tuy bận rộn trăm công nghìn việc, \Nnhưng luôn sẵn sàng dành thời gian cho hai ngươi.
Dialogue: 0,0:11:49.41,0:11:51.86,italics,ELYMAS/ID,0,0,0,,C-Cô ta vẫn chưa chịu bỏ cuộc à.
Dialogue: 0,0:11:52.46,0:11:59.19,italics,ELYMAS/ID,0,0,0,,Mang theo chút bồn chồn trong lòng, Ruche và mình \Nđã chính thức đón nhận chứng nhận cấp B.
Dialogue: 0,0:12:01.14,0:12:03.99,Default,ELYMAS,0,0,0,,Giờ bọn mình đã là mạo hiểm giả cấp B rồi,
Dialogue: 0,0:12:03.99,0:12:07.51,Default,ELYMAS,0,0,0,,hãy đi tìm một thợ rèn tay nghề cao thôi.
Dialogue: 0,0:12:07.51,0:12:08.25,Default,RUCHE,0,0,0,,Vâng ạ.
Dialogue: 0,0:12:10.58,0:12:16.38,top,RUCHE,0,0,0,,Cơ mà, anh có chắc là để em \Ntrang bị thứ vũ khí giá trị nhường này không?
Dialogue: 0,0:12:14.17,0:12:16.38,sign_generic,SIGN,0,0,0,,{\an7\b1\fade(675,1)\fs16\bord1.5\blur0.5\3c&HCAD4F9&\c&H153E7C&\pos(300.493,83.039)}Đoản Đao Độc Chilopoda {\fs10\b1\blur1\bord2\3c&HDDC361&\c&HFDFDE3&}[Cấp độ đề xuất: 70]\N {\fs13}Tấn công: +28\N Giá thị trường: 28.000.000G\N Đoản đao tẩm độc rết khổng lồ\N Tỉ lệ thấp gây trúng độc cho kẻ địch
Dialogue: 0,0:12:16.70,0:12:18.50,Default,ELYMAS,0,0,0,,Chỉ số cộng thêm tấn công của nó rất cao,
Dialogue: 0,0:12:18.50,0:12:22.39,Default,ELYMAS,0,0,0,,hơn nữa hiệu ứng đòn đánh còn phối hợp cực tốt \Nvới kỹ năng Nữ Thần May Mắn của em.
Dialogue: 0,0:12:23.11,0:12:25.65,Default,ELYMAS,0,0,0,,Đem bán nó đi mới là lãng phí đấy.
Dialogue: 0,0:12:25.65,0:12:31.19,Default,RUCHE,0,0,0,,N-Nhưng nếu đem bán cái này, chúng ta có thể \Nngập trong đồ ăn ngon suốt ngày luôn đấy!
Dialogue: 0,0:12:31.19,0:12:33.19,Default,RUCHE,0,0,0,,Bao gồm cả tráng miệng nữa cơ!
Dialogue: 0,0:12:34.07,0:12:37.02,Default,ELYMAS,0,0,0,,Lúc nào đó anh dẫn em đến \Ntiệm ăn ngon khác nhé?
Dialogue: 0,0:12:38.27,0:12:41.30,Default,ELYMAS,0,0,0,,Dù sao thì anh muốn dùng số Hắc Thiết và Ma Ngân này
Dialogue: 0,0:12:41.30,0:12:44.91,Default,ELYMAS,0,0,0,,để rèn vũ khí và giáp cho mình. Như vậy có được không?
Dialogue: 0,0:12:44.91,0:12:45.61,sign_generic,SIGN,0,0,0,,{\bord1\blur1\c&H392C41&\b1\3c&H828EB7&\move(341.714,156.143,341.714,3.429)}Thỏi Ma Ngân (Mythril)\N\N\N\N\N\N\N{\bord2\3c&HEACD4C&\c&HFFFFBF&}25.000.000G
Dialogue: 0,0:12:44.91,0:12:46.41,sign_generic,SIGN,0,0,0,,{\bord1\blur1\c&H392C41&\b1\3c&H828EB7&\move(334.857,295.143,334.857,-10.429)}Thỏi Hắc Thiết\N\N\N\N\N\N\N{\bord2\3c&HEACD4C&\c&HFFFFBF&}4.000.000G
Dialogue: 0,0:12:46.54,0:12:52.00,sign_generic,SIGN,0,0,0,,{\bord1\blur1\b1\fs15\pos(358.857,47.143)\fade(200,1)\c&H3A282C&\3c&HA0C4CD&}Chi phí rèn đúc
Dialogue: 0,0:12:46.24,0:12:52.00,sign_generic,SIGN,0,0,0,,{\bord1\b1\fade(200,1)\pos(320,250)\fs35\c&H42D2F2&}30.000.000G
Dialogue: 0,0:12:44.91,0:12:49.58,Default,ELYMAS,0,0,0,,Tính cả tiền công rèn thì trang bị của anh \Nchắc sẽ còn đắt đỏ hơn nữa.
Dialogue: 0,0:12:49.58,0:12:52.00,Default,RUCHE,0,0,0,,Tất nhiên là được rồi ạ.
Dialogue: 0,0:12:52.00,0:12:56.21,Default,RUCHE,0,0,0,,Tổng giá trị trang bị của hai đứa mình \Nsắp tới mức điên rồ luôn rồi.
Dialogue: 0,0:12:54.75,0:12:56.21,sign_generic,SIGN,0,0,0,,{\fnComic Sans MS\bord1\b1\fs25\c&H90FFFB&\3c&H499D8D&\pos(155.429,128.286)\frz11.56\fade(200,1)}Xấp xỉ 30.000.000G
Dialogue: 0,0:12:54.75,0:12:56.21,sign_generic,SIGN,0,0,0,,{\fnComic Sans MS\bord1\b1\fs25\c&H6CBFB9&\3c&H36766B&\fade(200,1)\pos(187.429,287.143)\frz13.3}28.000.000G
Dialogue: 0,0:12:56.60,0:13:02.51,Default,ELYMAS,0,0,0,,Nhưng chúng ta cần một thợ rèn đẳng cấp cao \Nthì mới gia công được Ma Ngân.
Dialogue: 0,0:13:03.07,0:13:06.88,Default,ELYMAS,0,0,0,,Chưa chắc trong thành này đã có người làm được.
Dialogue: 0,0:13:10.35,0:13:13.16,italics,ELYMAS/ID,0,0,0,,Việc gia công các loại kim loại tìm thấy trong hầm ngục
Dialogue: 0,0:13:13.16,0:13:16.91,italics,ELYMAS/ID,0,0,0,,đòi hỏi phải có nhánh kỹ năng chuyên biệt \Ncủa chức nghiệp thợ rèn.
Dialogue: 0,0:13:17.86,0:13:22.86,italics,ELYMAS/ID,0,0,0,,Thợ rèn cấp cao ở thế giới này hẳn phải quý giá \Nhơn nhiều so với trong game.
Dialogue: 0,0:13:23.58,0:13:28.37,italics,ELYMAS/ID,0,0,0,,Đúng như mình lo ngại, phần lớn thợ rèn cấp cao \Nđều phục vụ cho các gia tộc quý tộc
Dialogue: 0,0:13:28.75,0:13:32.26,italics,ELYMAS/ID,0,0,0,,hoặc mở tiệm lớn ở Vương Đô.
Dialogue: 0,0:13:32.26,0:13:36.02,italics,ELYMAS/ID,0,0,0,,Những thợ rèn bọn mình tìm được ở đây \Nchỉ quanh quẩn ở tầm cấp 40.
Dialogue: 0,0:13:37.88,0:13:43.39,top,SHOPKEEPER,0,0,0,,Có một lão thợ rèn sống trong túp lều \Ngiữa rừng cách đây một quãng đấy.
Dialogue: 0,0:13:38.57,0:13:41.58,italics,ELYMAS/ID,0,0,0,,Sau nửa ngày lân la hỏi han khắp các tiệm,
Dialogue: 0,0:13:42.11,0:13:46.92,italics,ELYMAS/ID,0,0,0,,cuối cùng bọn mình cũng nghe ngóng được \Nvề một thợ rèn cấp 60.
Dialogue: 0,0:13:47.39,0:13:50.39,top,SHOPKEEPER,0,0,0,,Cơ mà tôi không khuyên tới chỗ lão đó đâu.
Dialogue: 0,0:13:47.39,0:13:51.99,italics,ELYMAS/ID,0,0,0,,Tuy nhiên, vì lão ta là một ông già bướng bỉnh, \Nhẹp hòi và tính tình cực kỳ khó chịu,
Dialogue: 0,0:13:51.99,0:13:55.08,italics,ELYMAS/ID,0,0,0,,nên người ta đều can ngăn bọn mình tìm tới lão.
Dialogue: 0,0:13:55.08,0:13:58.20,italics,ELYMAS/ID,0,0,0,,Lão ta cực kỳ rắc rối, và một khi đã phật ý,
Dialogue: 0,0:13:58.20,0:14:01.40,italics,ELYMAS/ID,0,0,0,,thì dù có trả bao nhiêu tiền lão cũng nhất quyết không làm.
Dialogue: 0,0:14:28.07,0:14:31.89,Default,ELYMAS,0,0,0,,Nơi này trông chẳng giống chỗ ở \Ncủa một thợ rèn bậc thầy chút nào.
Dialogue: 0,0:14:32.74,0:14:35.72,Default,RUCHE,0,0,0,,Em bắt đầu thấy lo lo rồi đấy.
Dialogue: 0,0:14:37.98,0:14:44.28,Default,RUCHE,0,0,0,,Xin lỗi làm phiền ạ! Nghe nói ở đây \Ncó thợ rèn Veruga phải không ạ?
Dialogue: 0,0:14:48.74,0:14:49.78,Default,RUCHE,0,0,0,,Xin hỏi có ai ở nhà không?!
Dialogue: 0,0:14:49.78,0:14:52.76,Default,VERUGA,0,0,0,,Mày lại mò tới nữa đấy hả, thằng ranh con?!
Dialogue: 0,0:14:51.61,0:14:53.96,top,RUCHE,0,0,0,,Cháu xin lỗi! Cháu xin lỗi ạ!
Dialogue: 0,0:14:53.96,0:14:59.44,Default,VERUGA,0,0,0,,Ta không rèn cái thá gì cho lũ chết tiệt các người đâu!
Dialogue: 0,0:15:00.72,0:15:04.44,Default,VERUGA,0,0,0,,Mấy đứa chúng mày là ai? Không phải thằng ranh kia à.
Dialogue: 0,0:15:04.80,0:15:06.83,Default,VERUGA,0,0,0,,Thứ lỗi vì đã quát tháo.
Dialogue: 0,0:15:06.83,0:15:10.97,Default,VERUGA,0,0,0,,Dạo gần đây có một thằng mạo hiểm giả phiền toái \Ncứ bám riết đòi ta làm đồ cho nó.
Dialogue: 0,0:15:10.97,0:15:14.35,italics,ELYMAS/ID,0,0,0,,Phải cư xử thật hòa nhã để tránh làm ông ấy phật ý.
Dialogue: 0,0:15:16.61,0:15:19.11,Default,ELYMAS,0,0,0,,Chúng cháu nghe danh ông là một thợ rèn kiệt xuất.
Dialogue: 0,0:15:19.11,0:15:22.93,Default,ELYMAS,0,0,0,,Chắc hẳn thường ngày có rất nhiều kẻ kỳ quặc \Nđến đưa ra những yêu cầu vô lý với ông.
Dialogue: 0,0:15:25.15,0:15:26.94,Default,ELYMAS,0,0,0,,Hẳn là ông đã phải vất vả nhiều rồi.
Dialogue: 0,0:15:26.94,0:15:32.29,Default,VERUGA,0,0,0,,Mày tưởng có thể mua chuộc được ta \Nbằng mấy trò nịnh bợ rẻ tiền đó sao?
Dialogue: 0,0:15:32.29,0:15:33.29,Default,VERUGA,0,0,0,,Bản lão gia đây ghét nhất là trò đấy!
Dialogue: 0,0:15:28.49,0:15:28.94,sign_generic,sign,0,0,0,,{\b1\bord1.5\shad2\fs15\pos(390.524,182.83)\frz23.13\c&H534890&\fade(1,263)}vút
