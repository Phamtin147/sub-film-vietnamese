Dialogue: 0,0:00:08.82,0:00:09.94,Default,Merchant,0,0,0,,Makoto.
Dialogue: 0,0:00:11.70,0:00:13.69,Default,Merchant,0,0,0,,Nhìn kìa, phía trước là tới nơi rồi đó!
Dialogue: 0,0:00:18.80,0:00:21.05,Default,Makoto,0,0,0,,Đó là Macallan sao?!
Dialogue: 0,0:00:25.88,0:00:28.85,Default,OldLady,0,0,0,,Rau củ tươi ngon vừa mới hái sáng nay đây!
Dialogue: 0,0:00:28.85,0:00:31.01,Default,OldLady,0,0,0,,Cà chua hôm nay tươi ngon lắm đấy bà con ơi!
Dialogue: 0,0:00:31.01,0:00:33.74,Default,Leathermerchant,0,0,0,,Áo giáp da thượng hạng đây!
Dialogue: 0,0:00:33.74,0:00:35.26,Default,Leathermerchant,0,0,0,,Ai đến trước được phục vụ trước nhé!
Dialogue: 0,0:00:35.26,0:00:36.41,Default,Oldman,0,0,0,,Nè anh bạn!
Dialogue: 0,0:00:36.41,0:00:37.51,Default,Oldman,0,0,0,,Làm một vại bia chứ hả?!
Dialogue: 0,0:00:37.88,0:00:40.43,Default,Oldman,0,0,0,,Có bia ủ tươi mát lạnh thơm ngon đây!
Dialogue: 0,0:00:49.87,0:00:52.79,italics,Makoto,0,0,0,,Cuộc đời mạo hiểm giả của mình\Ncuối cùng cũng chính thức bắt đầu rồi.
Dialogue: 0,0:02:25.56,0:02:29.31,top,Screen,0,0,0,,TAKATSUKI MAKOTO\NBẮT ĐẦU NHẬN NHIỆM VỤ
Dialogue: 0,0:02:34.09,0:02:35.36,Default,Makoto,0,0,0,,X-Xin lỗi làm phiền một chút...
Dialogue: 0,0:02:36.90,0:02:38.14,Default,Mary,0,0,0,,Chào buổi chiều quý khách!
Dialogue: 0,0:02:38.14,0:02:39.89,Default,Mary,0,0,0,,Tôi có thể giúp gì cho cậu ạ?
Dialogue: 0,0:02:40.15,0:02:42.64,Default,Makoto,0,0,0,,Tôi muốn đăng ký làm mạo hiểm giả.
Dialogue: 0,0:02:42.64,0:02:44.79,Default,Mary,0,0,0,,Tôi hiểu rồi, đây là lần đầu tiên cậu đến hội nhỉ.
Dialogue: 0,0:02:44.79,0:02:46.87,Default,Mary,0,0,0,,Cậu có mang theo Sách Linh Hồn bên mình không?
Dialogue: 0,0:02:46.87,0:02:47.63,Default,Makoto,0,0,0,,Có đây ạ.
Dialogue: 0,0:02:48.99,0:02:50.90,Default,Mary,0,0,0,,Cảm ơn cậu rất nhiều.
Dialogue: 0,0:02:50.90,0:02:52.49,Default,Mary,0,0,0,,Tôi sẽ kiểm tra ngay đây.
Dialogue: 0,0:02:55.62,0:02:58.50,italics,Makoto,0,0,0,,Chỉ số của mình thuộc dạng yếu dưới mức trung bình.
Dialogue: 0,0:02:58.50,0:03:00.38,italics,Makoto,0,0,0,,Chuyện này thì mình biết thừa rồi.
Dialogue: 0,0:03:01.85,0:03:05.82,flashback,Sophia,0,0,0,,"Có vẻ như cậu cần phải rèn luyện thêm một thời gian nữa.
Dialogue: 0,0:03:05.82,0:03:07.35,flashback,Sophia,0,0,0,,Hẹn gặp lại cậu vào dịp khác nhé."
Dialogue: 0,0:03:12.69,0:03:14.39,Default,Mary,0,0,0,,Mọi thứ đều ổn thỏa cả nhé.
Dialogue: 0,0:03:14.39,0:03:15.03,Default,Makoto,0,0,0,,Hả?
Dialogue: 0,0:03:15.51,0:03:17.90,Default,Mary,0,0,0,,Tất cả các mạo hiểm giả đều được phân cấp bậc.
Dialogue: 0,0:03:17.90,0:03:21.64,Default,Mary,0,0,0,,Cậu sẽ bắt đầu từ Cấp Đá (Stone Rank) nhé.
Dialogue: 0,0:03:21.64,0:03:22.91,Default,Makoto,0,0,0,,Vâng ạ.
Dialogue: 0,0:03:22.91,0:03:25.77,Default,Mary,0,0,0,,Chúng tôi sẽ phát thẻ hội viên cho cậu.
Dialogue: 0,0:03:25.77,0:03:29.05,Default,Mary,0,0,0,,Sẽ mất khoảng vài tiếng để làm thẻ.\NCậu có tiện chờ không ạ?
Dialogue: 0,0:03:29.05,0:03:30.27,Default,Makoto,0,0,0,,Không sao đâu ạ.
Dialogue: 0,0:03:30.54,0:03:33.19,Default,Mary,0,0,0,,Đến chiều tối là thẻ sẽ làm xong,
Dialogue: 0,0:03:33.19,0:03:34.90,Default,Mary,0,0,0,,nên lúc đó cậu hãy quay lại đây nhận nhé.
Dialogue: 0,0:03:34.90,0:03:36.79,Default,Makoto,0,0,0,,Rất mong được hợp tác cùng cậu!
Dialogue: 0,0:03:36.79,0:03:39.60,italics,Makoto,0,0,0,,May quá, cô ấy không chê bai gì chỉ số của mình.
Dialogue: 0,0:03:51.99,0:03:53.22,Default,Makoto,0,0,0,,Trông có vẻ là chỗ này rồi.
Dialogue: 0,0:03:59.21,0:04:01.18,Default,Nina,0,0,0,,Kính chào quý khách!
Dialogue: 0,0:04:01.18,0:04:03.43,Default,Nina,0,0,0,,Quý khách là mạo hiểm giả ạ?
Dialogue: 0,0:04:04.05,0:04:06.31,Default,Nina,0,0,0,,Chỗ chúng tôi có rất nhiều trang bị tuyệt vời để phục vụ quý khách.
Dialogue: 0,0:04:06.31,0:04:09.69,Default,Makoto,0,0,0,,À, ừm, chủ tiệm là anh Fujiwara\Ncó ở đây không ạ?
Dialogue: 0,0:04:10.16,0:04:12.89,Default,Nina,0,0,0,,Ơ, quý khách là thương nhân đối tác ạ?
Dialogue: 0,0:04:12.89,0:04:15.19,Default,Nina,0,0,0,,Tôi có thể ghi lại thông tin\Ngiao dịch giúp quý khách.
Dialogue: 0,0:04:15.19,0:04:18.43,Default,Makoto,0,0,0,,À không, tôi là bạn của anh ấy.
Dialogue: 0,0:04:18.43,0:04:19.95,Default,Makoto,0,0,0,,Tên tôi là Takatsuki Makoto.
Dialogue: 0,0:04:20.97,0:04:22.70,Default,Nina,0,0,0,,Xin quý khách vui lòng chờ một lát!
Dialogue: 0,0:04:22.70,0:04:24.01,Default,Nina,0,0,0,,Ông chủ ơi!
Dialogue: 0,0:04:24.01,0:04:26.14,Default,Nina,0,0,0,,Có anh Takatsuki muốn gặp ông chủ này!
Dialogue: 0,0:04:26.14,0:04:27.74,Default,Fujiyan,0,0,0,,Gì cơ?!
Dialogue: 0,0:04:30.96,0:04:33.21,Default,Fujiyan,0,0,0,,Ôi! Tackie-dono!
Dialogue: 0,0:04:33.61,0:04:35.67,Default,Makoto,0,0,0,,Fujiyan! Lâu rồi không gặp cậu!
Dialogue: 0,0:04:38.09,0:04:39.97,Default,Makoto,0,0,0,,Cảm ơn vì bữa ăn nhé.
Dialogue: 0,0:04:39.97,0:04:42.05,Default,Makoto,0,0,0,,Món đó ngon tuyệt cú mèo luôn.
Dialogue: 0,0:04:42.40,0:04:44.57,Default,Fujiyan,0,0,0,,Tôi rất vui vì cậu thấy vừa miệng.
Dialogue: 0,0:04:44.57,0:04:47.73,Default,Fujiyan,0,0,0,,Quán Quán Rượu Miêu Nữ này\Nlà nơi tôi tâm đắc nhất đấy.
Dialogue: 0,0:04:48.74,0:04:51.18,Default,Makoto,0,0,0,,Không phải chỉ vì cậu cuồng mấy cô gái mèo đấy chứ?
Dialogue: 0,0:04:51.18,0:04:55.76,Default,Makoto,0,0,0,,Với lại, cô nhân viên ở tiệm cậu\Ncũng dễ thương lại có đôi tai thỏ nữa kìa.
Dialogue: 0,0:04:56.82,0:04:59.14,Default,Fujiyan,0,0,0,,Ý cậu là Nina-dono sao?
Dialogue: 0,0:04:59.14,0:05:01.78,Default,Fujiyan,0,0,0,,Tôi không hề chọn cô ấy vì ngoại hình đâu nhé.
Dialogue: 0,0:05:01.78,0:05:02.89,Default,Makoto,0,0,0,,Thật thế cơ à?
Dialogue: 0,0:05:02.89,0:05:04.86,Default,Fujiyan,0,0,0,,Thật lòng mà!
Dialogue: 0,0:05:04.86,0:05:06.41,Default,Makoto,0,0,0,,Mà công nhận cậu đỉnh thật đấy.
Dialogue: 0,0:05:06.41,0:05:08.00,Default,Makoto,0,0,0,,Cậu đã sở hữu cả một cửa tiệm riêng rồi.
Dialogue: 0,0:05:08.00,0:05:09.89,Default,Makoto,0,0,0,,Cậu đúng là kẻ chiến thắng ở thế giới này rồi.
Dialogue: 0,0:05:10.91,0:05:13.75,Default,Fujiyan,0,0,0,,Khi tôi nâng cấp độ thành thạo của kỹ năng\N"Người Chơi Visual Novel",
Dialogue: 0,0:05:13.75,0:05:16.57,Default,Fujiyan,0,0,0,,tôi đã mở khóa được khả năng\Nđọc thấu suy nghĩ của người khác.
Dialogue: 0,0:05:16.57,0:05:19.76,Default,Fujiyan,0,0,0,,Nó cực kỳ hữu ích trong\Nviệc đàm phán và kinh doanh buôn bán đấy.
Dialogue: 0,0:05:19.76,0:05:22.59,Default,Makoto,0,0,0,,Ồ, cậu có thể đọc được tâm trí người khác á?
Dialogue: 0,0:05:22.59,0:05:25.69,Default,Makoto,0,0,0,,Tớ đã trở thành tín đồ của một Nữ Thần rồi.
Dialogue: 0,0:05:25.69,0:05:26.80,Default,Fujiyan,0,0,0,,Hả!
Dialogue: 0,0:05:26.80,0:05:29.27,Default,Makoto,0,0,0,,Người đã ban cho tớ thứ này.
Dialogue: 0,0:05:29.27,0:05:31.11,Default,Makoto,0,0,0,,Cậu có thể giám định nó giùm tớ được không?
Dialogue: 0,0:05:31.11,0:05:32.99,Default,Fujiyan,0,0,0,,Đương nhiên rồi! Cứ để việc đó cho tôi!
Dialogue: 0,0:05:32.99,0:05:34.17,italics,Noah,0,0,0,,Ấy khoan đã!
Dialogue: 0,0:05:34.17,0:05:36.02,Default,Fujiyan,0,0,0,,Nào, xin phép cậu...
Dialogue: 0,0:05:37.28,0:05:40.09,Default,Fujiyan,0,0,0,,Đơn giản, nhưng hoa văn chạm khắc vô cùng tinh xảo.
Dialogue: 0,0:05:40.09,0:05:44.41,Default,Fujiyan,0,0,0,,Lưỡi dao trông tựa như Mithril, nhưng lại\Nlà một loại kim loại tôi chưa từng thấy bao giờ.
Dialogue: 0,0:05:44.41,0:05:45.30,Default,Fujiyan,0,0,0,,Hửm?
Dialogue: 0,0:05:46.54,0:05:48.29,Default,Fujiyan,0,0,0,,Hửm?
Dialogue: 0,0:05:48.29,0:05:49.45,Default,Fujiyan,0,0,0,,Ồ chà...
Dialogue: 0,0:05:49.45,0:05:51.97,Default,Fujiyan,0,0,0,,Nó đã được yểm một phép kháng giám định cực mạnh.
Dialogue: 0,0:05:51.97,0:05:52.54,Default,Makoto,0,0,0,,Hả?
Dialogue: 0,0:05:52.54,0:05:54.37,Default,Fujiyan,0,0,0,,Vô ích thôi, vô ích thôi!
Dialogue: 0,0:05:54.37,0:05:58.91,Default,Fujiyan,0,0,0,,Tôi đã mài giũa kỹ năng\NGiám Định của mình tới mức tối đa rồi!
Dialogue: 0,0:05:59.53,0:06:04.05,Default,Fujiyan,0,0,0,,Nhưng phẩm cấp tuyệt phẩm này\Ntôi chưa từng bắt gặp bao giờ.
Dialogue: 0,0:06:04.38,0:06:05.30,Default,Fujiyan,0,0,0,,Hửm?
Dialogue: 0,0:06:05.30,0:06:07.77,Default,Fujiyan,0,0,0,,C-Con dao này phi thường thật đấy!
Dialogue: 0,0:06:07.77,0:06:09.19,italics,Noah,0,0,0,,Không thể nào!
Dialogue: 0,0:06:09.19,0:06:13.07,Default,Fujiyan,0,0,0,,Chất liệu thấm đẫm ma lực này chính là\Nkim loại huyền thoại, Adamantite!
Dialogue: 0,0:06:13.07,0:06:14.75,Default,Fujiyan,0,0,0,,Nó sở hữu độ bền đạt tới cấp Thần Khí!
Dialogue: 0,0:06:14.75,0:06:15.81,Default,Makoto,0,0,0,,Cấp Thần Khí á?!
Dialogue: 0,0:06:15.81,0:06:19.48,Default,Fujiyan,0,0,0,,Nữ Thần còn dùng thần lực để yểm vào đó vô số bùa chú đặc biệt,
Dialogue: 0,0:06:19.48,0:06:22.45,Default,Fujiyan,0,0,0,,mà phần lớn tôi thậm chí còn chưa nghe tên bao giờ!
Dialogue: 0,0:06:22.45,0:06:27.95,Default,Fujiyan,0,0,0,,Đây chắc chắn là vũ khí tối thượng\Nmạnh nhất mà tôi từng thấy!
Dialogue: 0,0:06:28.29,0:06:29.45,Default,Makoto,0,0,0,,Đỉnh thật đấy.
Dialogue: 0,0:06:29.78,0:06:31.54,flashback,Noah,0,0,0,,"Ta sẽ cho ngươi thứ này thay thế.
Dialogue: 0,0:06:31.95,0:06:34.22,flashback,Noah,0,0,0,,Nhưng nếu ngươi làm mất thì ta không tha đâu đấy!"
Dialogue: 0,0:06:35.17,0:06:37.14,italics,Makoto,0,0,0,,Người ban cho mình một bảo vật xịn xò đến mức này sao?
Dialogue: 0,0:06:37.14,0:06:38.91,Default,Fujiyan,0,0,0,,Tuy nhiên, thứ này...
Dialogue: 0,0:06:38.91,0:06:41.67,Default,Fujiyan,0,0,0,,lại mang tên là\N"Dao Găm của Tà Thần Noah".
Dialogue: 0,0:06:41.67,0:06:42.70,Default,Makoto,0,0,0,,Tà Thần á?!
Dialogue: 0,0:06:42.70,0:06:43.68,italics,Noah,0,0,0,,Ặc!
Dialogue: 0,0:06:44.65,0:06:46.38,Default,Makoto,0,0,0,,Hửm? Khoan đã.
Dialogue: 0,0:06:46.38,0:06:49.68,Default,Makoto,0,0,0,,Thế giới này định nghĩa thế nào\Nlà "Tà Thần" vậy?
Dialogue: 0,0:06:49.68,0:06:51.31,Default,Fujiyan,0,0,0,,À thì...
Dialogue: 0,0:06:51.31,0:06:53.19,Default,Fujiyan,0,0,0,,Nếu tôi nhớ không nhầm, thần thoại có chép...
Dialogue: 0,0:06:53.77,0:06:57.67,Default,Fujiyan,0,0,0,,"Tà Thần" là những Cổ Thần\Ntừng thống trị Thần Giới thời xa xưa.
Dialogue: 0,0:06:57.67,0:07:02.70,Default,Fujiyan,0,0,0,,Trong Đại Chiến Thần Giới (Titanomachy),\NThánh Thần đã đánh bại họ,
Dialogue: 0,0:07:02.70,0:07:04.95,Default,Fujiyan,0,0,0,,và gán cho họ danh xưng "Tà Thần".
Dialogue: 0,0:07:04.95,0:07:08.58,Default,Fujiyan,0,0,0,,Hiện tại họ vẫn đang bị phong ấn ở một nơi nào đó.
Dialogue: 0,0:07:08.58,0:07:10.32,Default,Makoto,0,0,0,,Thôi xong rồi.
Dialogue: 0,0:07:10.32,0:07:14.57,italics,Makoto,0,0,0,,Cứ tưởng mình vừa vớ được món đồ cheat đầu tiên\Ntừ khi sang dị giới này chứ.
Dialogue: 0,0:07:14.57,0:07:17.33,Default,Makoto,0,0,0,,Chắc mình phải hỏi thẳng cô ấy\Nvề cái vụ Tà Thần này mới được.
Dialogue: 0,0:07:17.92,0:07:20.33,Default,Fujiyan,0,0,0,,Cậu cố gắng đừng làm gì quá liều lĩnh nhé.
Dialogue: 0,0:07:20.33,0:07:22.84,Default,Fujiyan,0,0,0,,Ngoài ra, có tin đồn rằng...
Dialogue: 0,0:07:23.26,0:07:26.01,Default,Fujiyan,0,0,0,,sáu trong số bảy nữ tư tế\Ncủa các Nữ Thần
Dialogue: 0,0:07:26.01,0:07:30.60,Default,Fujiyan,0,0,0,,đều nhận được thần dụ báo rằng\NĐại Ma Vương sẽ hồi sinh trong vài năm tới.
Dialogue: 0,0:07:30.60,0:07:32.01,Default,Makoto,0,0,0,,Ghê thật đấy.
Dialogue: 0,0:07:32.01,0:07:36.41,Default,Fujiyan,0,0,0,,Thậm chí có người còn cho rằng\Ncả lớp chúng ta được triệu hồi sang đây
Dialogue: 0,0:07:36.41,0:07:38.48,Default,Fujiyan,0,0,0,,là để chuẩn bị cho trận chiến chống lại hắn.
Dialogue: 0,0:07:39.02,0:07:41.21,Default,Makoto,0,0,0,,Cốt truyện kinh điển thường thấy trong game thôi mà.
Dialogue: 0,0:07:41.21,0:07:42.29,Default,Fujiyan,0,0,0,,Đúng không nào?
Dialogue: 0,0:07:42.78,0:07:46.39,Default,Fujiyan,0,0,0,,Mà này Tackie-dono,\Nsau vụ này cậu có dự định gì chưa?
Dialogue: 0,0:07:46.39,0:07:49.87,Default,Makoto,0,0,0,,Tớ định sẽ tiếp tục rèn luyện\Nvới tư cách mạo hiểm giả một thời gian.
Dialogue: 0,0:07:51.27,0:07:56.25,Default,Fujiyan,0,0,0,,Cậu có muốn lập tổ đội cùng tôi\Nđi chinh phục hầm ngục không?
Dialogue: 0,0:07:57.27,0:07:58.65,Default,Makoto,0,0,0,,Tớ rất cảm kích lời mời của cậu,
Dialogue: 0,0:07:58.65,0:08:01.00,Default,Makoto,0,0,0,,nhưng tớ muốn bắt đầu bằng việc\Nđi solo một thời gian trước đã.
Dialogue: 0,0:08:01.00,0:08:02.30,Default,Fujiyan,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:08:02.30,0:08:06.49,Default,Fujiyan,0,0,0,,Dù sao thì chơi solo cũng là\Nbản sắc cốt lõi của một game thủ mà.
Dialogue: 0,0:08:06.49,0:08:10.76,Default,Fujiyan,0,0,0,,Nhưng có khó khăn gì thì\Ncậu cứ liên hệ với tôi ngay nhé.
Dialogue: 0,0:08:10.76,0:08:12.74,Default,Makoto,0,0,0,,Tớ biết rồi, cảm ơn cậu nhiều nhé.
Dialogue: 0,0:08:16.01,0:08:18.52,Default,Mary,0,0,0,,Vậy là thủ tục đăng ký hội viên của cậu đã hoàn tất rồi.
Dialogue: 0,0:08:18.82,0:08:20.02,Default,Mary,0,0,0,,Hãy cố gắng hết mình nhé!
Dialogue: 0,0:08:20.73,0:08:21.58,Default,Makoto,0,0,0,,Vâng ạ!
Dialogue: 0,0:08:25.03,0:08:28.06,Default,Makoto,0,0,0,,Ngày mai mình sẽ nhận nhiệm vụ đầu tiên.
Dialogue: 0,0:08:31.03,0:08:32.52,Default,Makoto,0,0,0,,Mình nhất định sẽ làm được.
Dialogue: 0,0:08:39.02,0:08:41.85,Default,Makoto,0,0,0,,Cô đang làm cái trò gì thế hả Nữ Thần?
Dialogue: 0,0:08:41.85,0:08:43.82,Default,Makoto,0,0,0,,À không, phải gọi là Noah-sama chứ nhỉ?
Dialogue: 0,0:08:44.97,0:08:47.20,Default,Makoto,0,0,0,,Đó là tên của cô đúng không?
Dialogue: 0,0:08:48.35,0:08:49.05,Default,Noah,0,0,0,,Đúng vậy đó.
Dialogue: 0,0:08:49.05,0:08:51.06,Default,Makoto,0,0,0,,Vậy ra cô là một Tà Thần sao?
Dialogue: 0,0:08:51.87,0:08:54.54,Default,Makoto,0,0,0,,Trước mắt thì cô ngẩng đầu lên giùm cái đi đã.
Dialogue: 0,0:08:54.54,0:08:57.81,Default,Makoto,0,0,0,,Nói chuyện trong lúc cô đang quỳ sụp\Nlạy lục thế này kỳ cục lắm.
Dialogue: 0,0:08:57.81,0:09:00.56,Default,Noah,0,0,0,,Vậy ngươi vẫn chịu tiếp tục làm tín đồ của ta chứ?
Dialogue: 0,0:09:01.87,0:09:03.57,Default,Noah,0,0,0,,Đừng có im lặng đáng sợ như thế mà!
Dialogue: 0,0:09:03.85,0:09:04.72,Default,Noah,0,0,0,,Ta xin lỗi mà!
Dialogue: 0,0:09:04.72,0:09:06.31,Default,Noah,0,0,0,,Ta đâu có cố tình lừa dối ngươi đâu!
Dialogue: 0,0:09:06.31,0:09:08.07,Default,Noah,0,0,0,,Ta chỉ là... quên không đề cập tới thôi mà.
Dialogue: 0,0:09:08.07,0:09:09.57,italics,Makoto,0,0,0,,Nghe hệt như mấy vụ lừa đảo qua mạng vậy.
Dialogue: 0,0:09:09.57,0:09:11.19,Default,Noah,0,0,0,,Không phải lừa đảo đâu mà!
Dialogue: 0,0:09:11.19,0:09:13.29,Default,Noah,0,0,0,,Ta vẫn đường đường là một Nữ Thần đấy nhé!
Dialogue: 0,0:09:13.29,0:09:16.87,Default,Makoto,0,0,0,,Nhưng cô là một trong những Cổ Thần\Nthất bại trong trận chiến thần giới đúng không?
Dialogue: 0,0:09:17.74,0:09:22.35,Default,Noah,0,0,0,,Nói ta già như thế\Nnghe chạnh lòng lắm đấy.
Dialogue: 0,0:09:22.35,0:09:26.34,Default,Noah,0,0,0,,Ta là một trong những Titan trẻ tuổi nhất đấy nhé.
Dialogue: 0,0:09:26.67,0:09:28.94,Default,Makoto,0,0,0,,Cô đi tìm tín đồ tiếp theo đi nha.
Dialogue: 0,0:09:28.94,0:09:30.10,Default,Noah,0,0,0,,Không được! Không được! Tuyệt đối không được đâu!
Dialogue: 0,0:09:30.10,0:09:31.40,Default,Noah,0,0,0,,Ta vừa yếu lại còn bị gắn mác Tà Thần,
Dialogue: 0,0:09:31.40,0:09:34.05,Default,Noah,0,0,0,,nên ta phải mất ròng rã cả ngàn năm\Nmới kiếm được đúng một người tín đồ này thôi đấy!
Dialogue: 0,0:09:34.05,0:09:35.53,Default,Noah,0,0,0,,Đừng có nói như thể chuyện đó dễ dàng lắm chứ!
Dialogue: 0,0:09:35.53,0:09:40.10,Default,Makoto,0,0,0,,Nhưng mà cô cũng bất cẩn tới mức\Nđể lộ tẩy cái danh Tà Thần qua con dao này còn gì.
Dialogue: 0,0:09:40.10,0:09:41.52,Default,Noah,0,0,0,,Ngươi nhầm to rồi!
Dialogue: 0,0:09:41.52,0:09:43.88,Default,Noah,0,0,0,,Đáng lẽ Giám Định thông thường\Nlàm sao mà soi ra được chứ!
Dialogue: 0,0:09:43.88,0:09:45.83,Default,Makoto,0,0,0,,Vậy tức là cô quả nhiên có ý định lừa tớ rồi.
Dialogue: 0,0:09:45.83,0:09:47.11,Default,Noah,0,0,0,,Hả? Không...
Dialogue: 0,0:09:47.11,0:09:48.86,Default,Noah,0,0,0,,Ơ, à thì...
Dialogue: 0,0:09:48.86,0:09:51.32,Default,Noah,0,0,0,,Chẳng qua chỉ có bọn Thánh Thần\Nmới gọi ta là Tà Thần thôi mà.
Dialogue: 0,0:09:51.32,0:09:53.27,Default,Noah,0,0,0,,Ta vẫn là một Nữ Thần chân chính đấy thôi.
Dialogue: 0,0:09:54.63,0:09:55.62,Default,Makoto,0,0,0,,Noah-sama này.
Dialogue: 0,0:09:56.24,0:09:57.69,Default,Makoto,0,0,0,,Tôi vẫn sẽ là tín đồ của cô mà.
Dialogue: 0,0:09:57.69,0:09:59.50,Default,Noah,0,0,0,,Hả? Th-Thật sao?!
Dialogue: 0,0:09:59.50,0:10:00.62,Default,Makoto,0,0,0,,Thật mà.
Dialogue: 0,0:10:01.16,0:10:06.63,Default,Noah,0,0,0,,Á, Makoto, ngươi đúng là\Nngười tín đồ quý giá nhất trên đời của ta!
Dialogue: 0,0:10:06.63,0:10:10.16,Default,Makoto,0,0,0,,Cô càng làm lố lên thế này\Nthì trông lại càng đáng ngờ đấy.
Dialogue: 0,0:10:10.16,0:10:11.46,Default,Noah,0,0,0,,Ngươi lúc nào cũng bình thản thật đấy.
Dialogue: 0,0:10:11.46,0:10:14.32,Default,Noah,0,0,0,,Trời ạ, cái kỹ năng đó của ngươi khó chịu ghê cơ.
Dialogue: 0,0:10:14.32,0:10:18.12,Default,Makoto,0,0,0,,Mà này, cô có nhiệm vụ hay chỉ dẫn gì mới cho tôi không?
Dialogue: 0,0:10:18.12,0:10:20.67,Default,Noah,0,0,0,,Sao ngươi lại tha thiết mong nhận được thần dụ đến thế?
Dialogue: 0,0:10:20.67,0:10:25.65,Default,Makoto,0,0,0,,Gặp được Nữ Thần mà chỉ nhận mỗi con dao găm\Nthì hụt hẫng lắm.
Dialogue: 0,0:10:25.65,0:10:28.21,Default,Makoto,0,0,0,,Bình thường thì các Nữ Thần hay đưa ra những yêu cầu vô lý,
Dialogue: 0,0:10:28.21,0:10:30.63,Default,Makoto,0,0,0,,kiểu như đi tiêu diệt Ma Vương chẳng hạn.
Dialogue: 0,0:10:30.63,0:10:33.03,italics,Makoto,0,0,0,,Đó là mô-típ kinh điển của game RPG mà.
Dialogue: 0,0:10:33.03,0:10:35.44,Default,Noah,0,0,0,,Hừm, nếu thế thì...
Dialogue: 0,0:10:35.44,0:10:38.54,Default,Noah,0,0,0,,Hay là ta nhờ ngươi tới giải cứu ta nhé?
Dialogue: 0,0:10:38.54,0:10:40.59,Default,Makoto,0,0,0,,Ồ! Đây mới đúng là sự kiện kinh điển này!
Dialogue: 0,0:10:40.59,0:10:42.65,Default,Makoto,0,0,0,,Đó chính xác là thứ mà tôi mong đợi đấy!
Dialogue: 0,0:10:42.65,0:10:44.45,Default,Makoto,0,0,0,,Thế giờ cô đang ở đâu?
Dialogue: 0,0:10:45.45,0:10:47.22,Default,Noah,0,0,0,,Ờ, thì là...
Dialogue: 0,0:10:47.22,0:10:48.54,Default,Noah,0,0,0,,Ta đang ở trong một đại mê cung,
Dialogue: 0,0:10:49.29,0:10:55.40,Default,Noah,0,0,0,,Đền Thờ Đáy Biển, nằm ở nơi sâu thẳm nhất\Ncủa đại dương thế giới này.
Dialogue: 0,0:10:55.40,0:10:58.39,Default,Noah,0,0,0,,Đó là một hầm ngục hiểm trở\Nđến mức con người chưa từng đặt chân tới.
Dialogue: 0,0:11:01.37,0:11:03.06,Default,Noah,0,0,0,,Ngươi có muốn bỏ cuộc luôn không?
Dialogue: 0,0:11:03.06,0:11:06.56,italics,Makoto,0,0,0,,Càng nghe thấy độ khó cao\Nthì tôi lại càng thấy hưng phấn sục sôi hơn đấy!
Dialogue: 0,0:11:07.53,0:11:10.07,Default,Noah,0,0,0,,Đúng là ngươi chẳng biết chùn bước là gì nhỉ?
Dialogue: 0,0:11:10.07,0:11:11.60,Default,Makoto,0,0,0,,Tôi nhất định sẽ tới chỗ cô.
Dialogue: 0,0:11:11.60,0:11:14.57,Default,Makoto,0,0,0,,Tôi sẽ giải cứu cô để trả ơn con dao găm này.
Dialogue: 0,0:11:14.57,0:11:18.65,Default,Noah,0,0,0,,Con dao găm là lời cảm ơn của ta\Nvì ngươi đã chịu làm tín đồ của ta mà.
Dialogue: 0,0:11:18.65,0:11:20.08,Default,Noah,0,0,0,,Nhưng thôi sao cũng được.
Dialogue: 0,0:11:20.08,0:11:23.93,Default,Noah,0,0,0,,Như ta đã dặn trước đó, ngươi tuyệt đối\Nkhông được quên cầu nguyện hàng ngày đâu đấy.
Dialogue: 0,0:11:23.93,0:11:26.03,Default,Noah,0,0,0,,Ta đảm bảo là điều may mắn tốt lành sẽ đến với ngươi.
Dialogue: 0,0:11:26.03,0:11:28.59,Default,Noah,0,0,0,,Ngươi sẽ nhận được quà tích lũy\Nkhi chăm chỉ làm tín đồ của ta đấy!
Dialogue: 0,0:11:28.59,0:11:31.59,Default,Makoto,0,0,0,,Nghe hệt như nhận quà điểm danh hàng ngày\Ntrong game gacha hút máu vậy.
Dialogue: 0,0:11:31.59,0:11:35.52,Default,Noah,0,0,0,,Đại loại thế đấy.\NThôi thì ta sẽ kiên nhẫn chờ đợi ngươi tới nhé.
Dialogue: 0,0:11:35.52,0:11:37.40,Default,Noah,0,0,0,,Nếu ngươi giải thoát cho ta thành công,
Dialogue: 0,0:11:37.40,0:11:39.85,Default,Noah,0,0,0,,thì ngươi muốn ta làm gì ta cũng chiều hết!
Dialogue: 0,0:11:41.71,0:11:43.45,italics,Makoto,0,0,0,,Lại nói khoác quá đà rồi.
Dialogue: 0,0:11:43.45,0:11:47.44,italics,Makoto,0,0,0,,Có phải cô Nữ Thần này cứ nghĩ ra được cái gì\Nlà tuôn bừa ra để dụ dỗ mình không nhỉ?
Dialogue: 0,0:11:52.02,0:11:55.03,Default,Mary,0,0,0,,À, nếu cậu muốn tìm\Nnhiệm vụ đầu tiên thì có mấy cái này...
Dialogue: 0,0:11:55.60,0:11:57.75,Default,Mary,0,0,0,,"Săn ba con Thỏ Sừng."
Dialogue: 0,0:11:57.75,0:12:00.87,Default,Mary,0,0,0,,"Vận chuyển hàng hóa bằng xe ngựa đến Đại Keith."
Dialogue: 0,0:12:00.87,0:12:03.91,Default,Mary,0,0,0,,"Vận chuyển hàng hóa bằng xe ngựa đến Highland."
Dialogue: 0,0:12:03.91,0:12:04.63,Default,Mary,0,0,0,,Ngoài ra còn...
Dialogue: 0,0:12:04.63,0:12:08.25,Default,Makoto,0,0,0,,À, ừm, có nhiệm vụ nào\Nđi tiêu diệt quái vật không ạ?
Dialogue: 0,0:12:08.25,0:12:08.76,Default,Mary,0,0,0,,Hả?
Dialogue: 0,0:12:08.76,0:12:10.54,Default,Mary,0,0,0,,Cậu đi một mình đúng không?
Dialogue: 0,0:12:10.54,0:12:13.90,Default,Mary,0,0,0,,Tôi nghĩ mấy việc này là thích hợp nhất\Nđể cậu khởi đầu đấy.
Dialogue: 0,0:12:13.90,0:12:15.05,Default,Makoto,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:12:15.77,0:12:17.80,Default,Makoto,0,0,0,,Vậy tôi sẽ nhận nhiệm vụ săn thỏ sừng.
Dialogue: 0,0:12:18.47,0:12:20.67,Default,Mary,0,0,0,,Được rồi, tôi sẽ ghi tên cậu nhận nhiệm vụ nhé.
Dialogue: 0,0:12:20.67,0:12:22.88,Default,Mary,0,0,0,,À nhân tiện, nếu cậu có nhìn thấy Goblin hay Orc nào,
Dialogue: 0,0:12:22.88,0:12:24.52,Default,Mary,0,0,0,,thì hãy nhớ báo lại cho hội nhé.
Dialogue: 0,0:12:24.52,0:12:25.97,Default,Mary,0,0,0,,Đang có nhiệm vụ treo thưởng săn lùng chúng,
Dialogue: 0,0:12:25.97,0:12:28.47,Default,Mary,0,0,0,,nên cậu sẽ được nhận thù lao\Nnếu có ai đó tiêu diệt chúng.
Dialogue: 0,0:12:28.47,0:12:29.19,Default,Makoto,0,0,0,,Tuyệt thật đấy.
Dialogue: 0,0:12:29.75,0:12:31.40,Default,Mary,0,0,0,,Cậu còn thắc mắc gì nữa không?
Dialogue: 0,0:12:31.40,0:12:33.19,Default,Makoto,0,0,0,,Không, tôi ổn rồi ạ.
Dialogue: 0,0:12:33.19,0:12:35.69,Default,Mary,0,0,0,,Được rồi, chúc cậu may mắn nhé.
Dialogue: 0,0:12:37.83,0:12:42.19,italics,Makoto,0,0,0,,Thỏ sừng mà mình săn là quái vật Cấp 0,
Dialogue: 0,0:12:42.19,0:12:44.45,italics,Makoto,0,0,0,,loại quái mà ngay cả thường dân cũng có thể hạ gục được.
Dialogue: 0,0:12:46.49,0:12:47.08,italics,Makoto,0,0,0,,Kìa, một con!
Dialogue: 0,0:12:47.54,0:12:49.69,italics,Makoto,0,0,0,,Thủy Ma Pháp: Băng Tiễn (Ice Arrow)!
Dialogue: 0,0:12:53.09,0:12:54.18,italics,Makoto,0,0,0,,Biết ngay mà.
Dialogue: 0,0:12:54.18,0:12:57.35,italics,Makoto,0,0,0,,Ma pháp của mình quá yếu để hạ gục nó ngay lập tức.
Dialogue: 0,0:12:58.09,0:12:59.23,italics,Makoto,0,0,0,,Cho tao xin lỗi nhé!
Dialogue: 0,0:13:01.49,0:13:02.88,Default,Makoto,0,0,0,,Vậy là đủ ba con rồi.
Dialogue: 0,0:13:02.88,0:13:04.85,Default,Makoto,0,0,0,,Mình đã hoàn thành xuất sắc nhiệm vụ đầu tiên rồi.
Dialogue: 0,0:13:06.01,0:13:07.97,Default,Makoto,0,0,0,,Chắc là mình sẽ săn thêm một lúc nữa vậy.
Dialogue: 0,0:13:11.02,0:13:12.18,italics,Makoto,0,0,0,,Cái gì thế kia?
Dialogue: 0,0:13:12.18,0:13:13.60,italics,Makoto,0,0,0,,Đó là một đàn Goblin sao?
Dialogue: 0,0:13:13.60,0:13:15.36,italics,Makoto,0,0,0,,Bọn chúng đông phết đấy.
Dialogue: 0,0:13:16.30,0:13:18.61,italics,Makoto,0,0,0,,Mình từng tiêu diệt Goblin một lần rồi.
Dialogue: 0,0:13:18.61,0:13:21.11,top,Screen,0,0,0,,QUYẾT CHIẾN VỚI GOBLIN?
Dialogue: 0,0:13:18.61,0:13:21.11,top,Screen,0,0,0,,CÓ
Dialogue: 0,0:13:18.61,0:13:21.11,top,Screen,0,0,0,,KHÔNG
Dialogue: 0,0:13:21.56,0:13:23.99,italics,Makoto,0,0,0,,Nếu mình tỉa từng con đi lẻ một...
Dialogue: 0,0:13:23.99,0:13:25.62,Default,Noah,0,0,0,,Hả? Ngươi định đánh thật à?
Dialogue: 0,0:13:26.44,0:13:28.30,Default,Makoto,0,0,0,,Mình sẽ thử xem sao.
Dialogue: 0,0:13:38.05,0:13:39.13,italics,Makoto,0,0,0,,Ẩn Nấp (Stealth)!
Dialogue: 0,0:13:43.21,0:13:44.27,italics,Makoto,0,0,0,,Đóng Băng (Freeze)!
Dialogue: 0,0:13:50.14,0:13:52.14,Default,Makoto,0,0,0,,Tốt lắm! Mình làm được rồi!
Dialogue: 0,0:13:52.42,0:13:52.99,Default,Mary,0,0,0,,Hả?
Dialogue: 0,0:13:52.99,0:13:54.79,Default,Mary,0,0,0,,Cậu đã tiêu diệt được năm con Goblin sao?
Dialogue: 0,0:13:54.79,0:13:56.17,Default,Mary,0,0,0,,Một mình cậu làm hết đấy à?
Dialogue: 0,0:13:56.17,0:13:56.90,Default,Makoto,0,0,0,,Vâng ạ.
Dialogue: 0,0:13:57.35,0:13:58.94,Default,Mary,0,0,0,,Trời ạ, đừng có liều mạng như thế chứ.
Dialogue: 0,0:13:58.94,0:14:00.27,Default,Mary,0,0,0,,Cậu có thể bị thương nặng đấy.
Dialogue: 0,0:14:00.27,0:14:01.40,Default,Makoto,0,0,0,,Vâng...
Dialogue: 0,0:14:06.83,0:14:08.86,Default,Mary,0,0,0,,Hả?! Lần này là mười con sao?!
Dialogue: 0,0:14:08.86,0:14:11.08,Default,Mary,0,0,0,,Cậu có phối hợp với các mạo hiểm giả\Nkhác để tiêu diệt chúng không?
Dialogue: 0,0:14:11.08,0:14:12.41,Default,Makoto,0,0,0,,Không, một mình tôi làm hết đấy ạ.
Dialogue: 0,0:14:12.41,0:14:13.83,Default,Adventurer,0,0,0,,Làm sao có chuyện đó được chứ?
Dialogue: 0,0:14:14.25,0:14:16.94,Default,Adventurer,0,0,0,,Chẳng có pháp sư tập sự nào\Ntự mình làm được điều đó cả đâu!
Dialogue: 0,0:14:16.94,0:14:17.96,Default,Adventurer,0,0,0,,Thật không thể tin nổi!
Dialogue: 0,0:14:17.96,0:14:20.99,Default,Mary,0,0,0,,Chị đã bảo cậu không được liều lĩnh rồi cơ mà?
Dialogue: 0,0:14:24.39,0:14:25.59,Default,Mary,0,0,0,,Hai mươi con luôn á?!
Dialogue: 0,0:14:26.52,0:14:28.60,Default,Lucas,0,0,0,,Ồ, cừ khôi thật đấy!
Dialogue: 0,0:14:29.24,0:14:31.97,Default,Lucas,0,0,0,,Hóa ra chú mày là tên lính mới\Nmà mọi người đang bàn tán xôn xao à?
Dialogue: 0,0:14:31.97,0:14:33.73,Default,Lucas,0,0,0,,Cố gắng phát huy nhé nhóc con.
Dialogue: 0,0:14:38.15,0:14:41.15,Default,Mary,0,0,0,,Cuối cùng thì cậu cũng hạ gục\Nđược ba mươi con một lúc rồi, Makoto!
Dialogue: 0,0:14:41.47,0:14:43.40,Default,Makoto,0,0,0,,Vâng, chắc vậy ạ.
Dialogue: 0,0:14:43.69,0:14:45.20,Default,Mary,0,0,0,,Chị biết ngay mà!
Dialogue: 0,0:14:45.20,0:14:48.41,Default,Mary,0,0,0,,Chị biết Makoto của chúng ta\Nlà một chàng trai có thực lực mà!
Dialogue: 0,0:14:48.41,0:14:52.10,Default,Adventurer,0,0,0,,Thôi đi cha nội, nhóc mê lũ Goblin\Ntới mức nào vậy hả?
Dialogue: 0,0:14:52.10,0:14:54.41,Default,Adventurer,0,0,0,,Ê, Chổi Quét Goblin!
Dialogue: 0,0:14:55.17,0:14:58.09,Default,Mary,0,0,0,,Này, đừng có đặt mấy cái biệt danh tệ hại như thế cho em ấy chứ!
Dialogue: 0,0:14:58.09,0:14:59.67,Default,Mary,0,0,0,,Cậu đừng có bận tâm đến bọn họ làm gì.
Dialogue: 0,0:15:00.58,0:15:03.81,italics,Makoto,0,0,0,,Ước gì mình có một cái biệt danh nào ngầu hơn một chút.
Dialogue: 0,0:15:05.51,0:15:09.16,Default,Makoto,0,0,0,,Ông chủ ơi! Chỗ thỏ sừng\Nông nhờ tôi mang đến đây rồi nhé.
Dialogue: 0,0:15:09.16,0:15:11.51,Default,Boss,0,0,0,,Này, cảm ơn nhóc lúc nào cũng giúp đỡ ta nhé!
Dialogue: 0,0:15:11.51,0:15:13.15,Default,Boss,0,0,0,,Hôm nay nhóc muốn dùng món gì nào?
Dialogue: 0,0:15:13.15,0:15:15.39,Default,Boss,0,0,0,,Bữa này quán đãi coi như cảm ơn nhóc đã giúp đỡ nhiệt tình nhé.
Dialogue: 0,0:15:15.39,0:15:18.94,Default,Makoto,0,0,0,,Thế thì cho cháu một suất thịt xiên nướng\Nvới một ly soda táo ạ.
Dialogue: 0,0:15:18.94,0:15:20.45,Default,Boss,0,0,0,,Có ngay đây.
Dialogue: 0,0:15:20.45,0:15:23.32,Default,Boss,0,0,0,,Nhắc mới nhớ, hiện tại\Nnhóc đã lên được cấp bao nhiêu rồi?
Dialogue: 0,0:15:23.32,0:15:24.87,Default,Makoto,0,0,0,,Dạ chắc là cấp mười bốn rồi ạ.
Dialogue: 0,0:15:24.87,0:15:28.06,Default,Lucas,0,0,0,,Nếu đã lên cấp 14 thì nhóc\Nđã là một mạo hiểm giả thực thụ rồi đấy.
Dialogue: 0,0:15:28.06,0:15:29.32,Default,Makoto,0,0,0,,Chú Lucas.
Dialogue: 0,0:15:29.32,0:15:31.32,Default,Lucas,0,0,0,,Ôi trời, cho anh xin lỗi nhé!
Dialogue: 0,0:15:31.32,0:15:32.96,Default,Lucas,0,0,0,,Vừa rồi anh phải đi săn Sa Long (Rồng Cát),
Dialogue: 0,0:15:32.96,0:15:35.33,Default,Lucas,0,0,0,,nên ba ngày liền không được giọt rượu nào vào bụng rồi.
Dialogue: 0,0:15:35.33,0:15:37.43,Default,Lucas,0,0,0,,Tiền thưởng thì hậu hĩnh thật đấy nhưng công việc cực như chó vậy.
Dialogue: 0,0:15:37.43,0:15:39.33,Default,Makoto,0,0,0,,Nghe có vẻ vất vả ghê anh nhỉ.
Dialogue: 0,0:15:39.66,0:15:44.09,Default,Lucas,0,0,0,,Chẳng phải đã đến lúc chú mày nên đi\Nkhiêu chiến hầm ngục cấp Đồng rồi sao?
Dialogue: 0,0:15:44.09,0:15:45.63,Default,Makoto,0,0,0,,Chú nói đúng ạ.
Dialogue: 0,0:15:45.63,0:15:49.09,Default,Makoto,0,0,0,,Cháu dự định lên tới cấp 20\Nrồi mới bắt đầu thử sức.
Dialogue: 0,0:15:49.09,0:15:51.95,Default,Boss,0,0,0,,Lính mới thì phải xông xáo\Nvà vững vàng hơn nữa chứ.
Dialogue: 0,0:15:51.95,0:15:55.78,Default,Boss,0,0,0,,Thôi nào, anh là mạo hiểm giả cấp Vàng đấy,\Nlên tiếng chỉ bảo nó vài câu đi chứ.
Dialogue: 0,0:15:55.78,0:15:57.60,Default,Lucas,0,0,0,,Chà...
Dialogue: 0,0:15:58.00,0:15:59.85,Default,Mary,0,0,0,,Trông mọi người có vẻ vui vẻ quá nhỉ.
Dialogue: 0,0:15:59.85,0:16:02.42,Default,Mary,0,0,0,,Cho tôi một vại bia với\Nđĩa rau xào tươi ngon nào có sẵn nhé.
Dialogue: 0,0:16:02.42,0:16:03.11,Default,Boss,0,0,0,,Có ngay đây ạ.
Dialogue: 0,0:16:03.11,0:16:06.61,Default,Mary,0,0,0,,Nào, cạn ly chúc mừng nào!
Dialogue: 0,0:16:10.80,0:16:14.31,Default,Mary,0,0,0,,Không gì sướng bằng làm một hớp rượu sau một ngày làm việc cật lực!
Dialogue: 0,0:16:14.31,0:16:15.24,Default,Mary,0,0,0,,Cho một ly nữa đi!
Dialogue: 0,0:16:15.24,0:16:17.12,Default,Makoto,0,0,0,,Chị uống nhanh quá đấy.
Dialogue: 0,0:16:17.48,0:16:20.50,Default,Mary,0,0,0,,Makoto, hôm nay em kiếm được cả đống tiền thưởng mà,
Dialogue: 0,0:16:20.50,0:16:22.22,Default,Mary,0,0,0,,nên cứ uống thả ga đi nhé!
Dialogue: 0,0:16:22.22,0:16:25.71,italics,Makoto,0,0,0,,Mình là kẻ đã từng kiên định\Nvượt qua cả sự cám dỗ của Nữ Thần.
Dialogue: 0,0:16:25.71,0:16:27.01,italics,Makoto,0,0,0,,Chút cồn này thì ăn nhằm gì.
Dialogue: 0,0:16:27.01,0:16:28.37,italics,Makoto,0,0,0,,Bình Tâm Tuyệt Đối (Calm Mind)!
Dialogue: 0,0:16:24.35,0:16:25.71,top,Mary,0,0,0,,Nào nào, tiếp đi chứ!
Dialogue: 0,0:16:26.67,0:16:28.37,top,Mary,0,0,0,,Uống đi, uống nhiều vào nào!
Dialogue: 0,0:16:29.25,0:16:31.74,Default,Makoto,0,0,0,,Chị Mary, chị ngồi sát quá rồi đấy ạ.
Dialogue: 0,0:16:31.74,0:16:33.27,Default,Mary,0,0,0,,Việc gì mà em phải ngại ngùng son sắt thế hả?
Dialogue: 0,0:16:33.27,0:16:34.26,Default,Makoto,0,0,0,,Em đâu có ngại đâu.
Dialogue: 0,0:16:34.26,0:16:36.21,Default,Adventurer,0,0,0,,Khốn khiếp, cái thằng ranh đó.
Dialogue: 0,0:16:34.26,0:16:35.82,top,Mary,0,0,0,,Em dễ thương quá đi mất thôi.
Dialogue: 0,0:16:36.21,0:16:38.27,Default,Adventurer,0,0,0,,Đồ Chổi Quét Goblin chết tiệt.
Dialogue: 0,0:16:35.82,0:16:37.20,top,Makoto,0,0,0,,Thôi xin chị tha cho em đi ạ!
Dialogue: 0,0:16:38.27,0:16:40.24,Default,Mary,0,0,0,,Hôm nay em lại diệt gọn ba mươi con Goblin nữa cơ đấy!
Dialogue: 0,0:16:40.24,0:16:42.43,Default,Mary,0,0,0,,Giỏi lắm! Đỉnh lắm chàng trai!
Dialogue: 0,0:16:43.56,0:16:46.03,Default,Jean,0,0,0,,Săn mấy con Goblin ranh thì có gì ghê gớm đâu chứ!
Dialogue: 0,0:16:46.03,0:16:48.71,Default,Mary,0,0,0,,Chú mày làm cái trò gì đấy hả Jean?
Dialogue: 0,0:16:48.71,0:16:51.87,Default,Mary,0,0,0,,Makoto là một đứa ngoan ngoãn, chú đừng\Ncó kiếm chuyện gây sự với nó!
Dialogue: 0,0:16:51.87,0:16:54.09,Default,Lucas,0,0,0,,Cùng là lính mới với nhau\Nthì phải hòa thuận mà sống chứ.
Dialogue: 0,0:16:54.09,0:16:55.83,Default,Jean,0,0,0,,Cả chú cũng bênh nó nữa sao Lucas?!
Dialogue: 0,0:16:55.83,0:16:58.90,Default,Jean,0,0,0,,Sao chú lại không chịu huấn luyện cho cháu nữa chứ?
Dialogue: 0,0:16:58.90,0:17:02.02,Default,Lucas,0,0,0,,Ta chỉ hướng dẫn chăm sóc\Nkhi các chú còn ở cấp Đá thôi,
Dialogue: 0,0:17:02.02,0:17:05.68,Default,Lucas,0,0,0,,còn một khi đã lên cấp Đồng thì ta coi\Ncác chú như một người đàn ông trưởng thành rồi.
Dialogue: 0,0:17:06.25,0:17:08.02,Default,Emily,0,0,0,,Chú có nghe tin gì chưa Lucas?
Dialogue: 0,0:17:08.02,0:17:11.43,Default,Emily,0,0,0,,Bọn cháu chuẩn bị nhận nhiệm vụ\Nsăn quái vật lớn đây này!
Dialogue: 0,0:17:11.43,0:17:12.65,Default,Lucas,0,0,0,,Ồ?
Dialogue: 0,0:17:12.65,0:17:13.93,Default,Lucas,0,0,0,,Mục tiêu của các chú là gì?
Dialogue: 0,0:17:13.93,0:17:15.18,Default,Lucy,0,0,0,,Một con Ogre đơn độc.
Dialogue: 0,0:17:15.18,0:17:16.97,Default,Lucas,0,0,0,,Ra vậy.
Dialogue: 0,0:17:16.97,0:17:20.06,Default,Lucas,0,0,0,,Đó là bài sát hạch để bước chân lên cấp Sắt đấy.
Dialogue: 0,0:17:20.06,0:17:20.94,Default,Lucas,0,0,0,,Chúc may mắn nhé!
Dialogue: 0,0:17:20.94,0:17:23.19,Default,Jean,0,0,0,,Vâng! Cứ tin tưởng ở bọn cháu!
Dialogue: 0,0:17:32.45,0:17:34.48,Default,Mary,0,0,0,,Cậu đừng bận tâm đến cậu ta làm gì.
Dialogue: 0,0:17:34.48,0:17:37.31,Default,Makoto,0,0,0,,Cháu không sao đâu ạ. Cậu ấy không làm phiền cháu chút nào đâu.
Dialogue: 0,0:17:37.31,0:17:39.45,Default,Makoto,0,0,0,,Cháu cứ tiếp tục tiến bước theo nhịp độ thong thả của riêng mình thôi.
Dialogue: 0,0:17:39.45,0:17:45.21,Default,Lucas,0,0,0,,Chẳng ai lại gọi việc ngày nào cũng quét sạch\Ncả bầy Goblin là "nhịp độ thong thả" đâu nhóc à.
Dialogue: 0,0:17:45.53,0:17:48.46,Default,Makoto,0,0,0,,Nhưng đối với cháu thì công việc đó nhàn tênh mà.
Dialogue: 0,0:17:51.89,0:17:54.98,italics,Makoto,0,0,0,,Vậy là hôm nay đủ tiêu chuẩn hai mươi con Goblin rồi.
Dialogue: 0,0:17:54.98,0:17:59.16,italics,Makoto,0,0,0,,Giờ mình chỉ cần săn thêm mấy con thỏ sừng\Nmang về cho quán ông chủ nữa là xong.
Dialogue: 0,0:18:05.66,0:18:08.48,italics,Makoto,0,0,0,,Kia là... một con Ogre đơn độc sao?
Dialogue: 0,0:18:09.26,0:18:11.62,italics,Makoto,0,0,0,,Rút lui lúc này\Nlà sự lựa chọn khôn ngoan nhất.
Dialogue: 0,0:18:13.13,0:18:14.75,Default,Jean,0,0,0,,Nó đến gần rồi!
Dialogue: 0,0:18:16.36,0:18:17.24,Default,Both,0,0,0,,Hả?
Dialogue: 0,0:18:21.20,0:18:22.95,italics,Makoto,0,0,0,,Gần đây còn có quái vật khác nữa sao?
Dialogue: 0,0:18:24.82,0:18:26.00,italics,Makoto,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:18:29.82,0:18:31.61,italics,Makoto,0,0,0,,Con quái vật kia là thứ gì vậy?
Dialogue: 0,0:18:31.61,0:18:33.76,italics,Makoto,0,0,0,,Con Ogre đó to lớn khủng khiếp!
Dialogue: 0,0:18:34.15,0:18:35.51,Default,Jean,0,0,0,,Phong Đao (Wind Cutter)!
Dialogue: 0,0:18:43.51,0:18:44.81,Default,Jean,0,0,0,,Tên này nguy hiểm quá rồi!
Dialogue: 0,0:18:45.12,0:18:46.10,Default,Jean,0,0,0,,Mau rút lui thôi!
Dialogue: 0,0:18:48.10,0:18:49.42,Default,Jean,0,0,0,,Nhanh chân lên!
Dialogue: 0,0:18:50.82,0:18:51.96,italics,Makoto,0,0,0,,Nguy to rồi!
Dialogue: 0,0:18:53.32,0:18:54.95,top,Screen,0,0,0,,CỨU CÔ GÁI?
Dialogue: 0,0:18:53.32,0:18:54.95,top,Screen,0,0,0,,CÓ
Dialogue: 0,0:18:53.32,0:18:54.95,top,Screen,0,0,0,,KHÔNG
Dialogue: 0,0:18:55.37,0:18:57.11,italics,Noah,0,0,0,,Bỏ mặc cô ta cũng được mà.
Dialogue: 0,0:18:57.11,0:18:59.45,Default,Makoto,0,0,0,,Cảm ơn lời khuyên của cô nhé.
Dialogue: 0,0:19:00.12,0:19:00.95,Default,Jean,0,0,0,,Nguy rồi!
Dialogue: 0,0:19:00.95,0:19:02.16,Default,Jean,0,0,0,,Lucy!
Dialogue: 0,0:19:02.62,0:19:03.46,Default,Lucy,0,0,0,,K-Không được!
Dialogue: 0,0:19:05.89,0:19:06.82,italics,Makoto,0,0,0,,Tuy nhiên...
Dialogue: 0,0:19:08.46,0:19:10.46,italics,Makoto,0,0,0,,Làm sao mình có thể trơ mắt bỏ mặc cô ấy được chứ.
Dialogue: 0,0:19:14.84,0:19:17.34,Default,Makoto,0,0,0,,Thủy Ma Pháp: Băng Tiễn (Ice Arrow)!
Dialogue: 0,0:19:21.44,0:19:23.10,Default,Makoto,0,0,0,,Nhân cơ hội này mau chạy đi!
Dialogue: 0,0:19:23.10,0:19:24.34,Default,Lucy,0,0,0,,Hả?
Dialogue: 0,0:19:24.34,0:19:25.88,Default,Lucy,0,0,0,,À, phải rồi!
Dialogue: 0,0:19:26.88,0:19:29.61,italics,Noah,0,0,0,,Này! Sao cậu lại thích ra vẻ ngầu lòi thế hả?!
Dialogue: 0,0:19:29.61,0:19:31.74,italics,Makoto,0,0,0,,Tôi đang ở cái độ tuổi muốn thể hiện bản thân mà.
Dialogue: 0,0:19:31.74,0:19:34.36,italics,Noah,0,0,0,,Cậu mà chết là tôi không tha thứ cho cậu đâu đấy, rõ chưa?!
Dialogue: 0,0:19:38.62,0:19:41.37,italics,Makoto,0,0,0,,Mình biết là Ogre có khả năng tự hồi phục,
Dialogue: 0,0:19:41.37,0:19:43.63,italics,Makoto,0,0,0,,nhưng không ngờ tốc độ tái tạo\Ncủa nó lại nhanh đến mức này.
Dialogue: 0,0:19:43.63,0:19:45.62,Default,Noah,0,0,0,,Thấy chưa hả?! Cậu tính làm thế nào bây giờ?!
Dialogue: 0,0:19:48.15,0:19:50.13,Default,Makoto,0,0,0,,Này, đằng này cơ mà!
Dialogue: 0,0:19:52.18,0:19:52.88,Default,Makoto,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:19:52.88,0:19:54.04,Default,Makoto,0,0,0,,Tránh ra mau!
Dialogue: 0,0:19:58.02,0:19:58.98,Default,Makoto,0,0,0,,Nhanh quá!
Dialogue: 0,0:20:01.76,0:20:02.47,Default,Makoto,0,0,0,,Nhúc nhích mau!
Dialogue: 0,0:20:08.63,0:20:09.53,Default,Makoto,0,0,0,,Tốt lắm!
Dialogue: 0,0:20:11.23,0:20:13.79,Default,Makoto,0,0,0,,Thủy Ma Pháp: Bộ Thủy (Walk on Water)!
Dialogue: 0,0:20:16.40,0:20:18.64,Default,Makoto,0,0,0,,Nè! Tao ở bên này cơ mà!
Dialogue: 0,0:20:24.67,0:20:25.50,italics,Makoto,0,0,0,,Rất tiếc cho mày nhé.
Dialogue: 0,0:20:26.07,0:20:28.50,italics,Makoto,0,0,0,,Kể từ chỗ này trở đi là vùng nước sâu thẳm đấy.
Dialogue: 0,0:20:33.64,0:20:34.50,italics,Makoto,0,0,0,,Ngay lúc này!
Dialogue: 0,0:20:35.81,0:20:38.26,Default,Makoto,0,0,0,,Thủy Ma Pháp: Thủy Lưu (Flow)!
Dialogue: 0,0:20:52.35,0:20:53.73,Default,Makoto,0,0,0,,Thành công rồi.
Dialogue: 0,0:20:54.27,0:20:55.53,Default,Jean,0,0,0,,Này!
Dialogue: 0,0:20:55.53,0:20:57.28,Default,Jean,0,0,0,,Cô có sao không?
Dialogue: 0,0:20:57.61,0:20:58.63,Default,Makoto,0,0,0,,Tôi không sao!
Dialogue: 0,0:20:58.63,0:21:00.28,Default,Makoto,0,0,0,,Tôi vừa hạ gục nó rồi đấy.
Dialogue: 0,0:21:07.26,0:21:08.29,Default,Jean,0,0,0,,Thật... thật á?!
Dialogue: 0,0:21:09.25,0:21:10.04,Default,Makoto,0,0,0,,Phù...
Dialogue: 0,0:21:11.92,0:21:13.29,Default,Jean,0,0,0,,Này...
Dialogue: 0,0:21:11.92,0:21:13.29,top,Makoto,0,0,0,,Nè!
Dialogue: 0,0:21:13.29,0:21:17.05,Default,Makoto,0,0,0,,Tôi muốn mang thủ cấp của con Ogre về,\Ncô giúp tôi một tay được không?
Dialogue: 0,0:21:20.93,0:21:21.85,Default,Lucas,0,0,0,,Này anh em ơi!
Dialogue: 0,0:21:21.85,0:21:23.05,Default,Lucas,0,0,0,,Mọi người lắng nghe đây!
Dialogue: 0,0:21:23.05,0:21:25.20,Default,Lucas,0,0,0,,Chàng tân binh sáng giá Makoto của chúng ta,
Dialogue: 0,0:21:25.20,0:21:27.06,Default,Lucas,0,0,0,,đã một mình tiêu diệt con Ogre khổng lồ đấy!
Dialogue: 0,0:21:27.37,0:21:29.31,Default,All,0,0,0,,Tuyệt vời!
Dialogue: 0,0:21:29.60,0:21:35.07,Default,Lucas,0,0,0,,Kể từ hôm nay trở đi, tôi cấm tiệt đứa nào\Nđược gọi em ấy là Chổi Quét Goblin nữa đấy nhé!
Dialogue: 0,0:21:35.07,0:21:35.81,Default,All,0,0,0,,Chuẩn luôn!
Dialogue: 0,0:21:35.81,0:21:38.19,Default,Lucas,0,0,0,,Thế thì chúng ta phải tìm một biệt danh mới cho chú mày thôi.
Dialogue: 0,0:21:38.59,0:21:40.61,Default,Lucas,0,0,0,,Biệt danh "Kẻ Diệt Ogre" (Ogre Killer)\Nthì sao hả anh em?!
Dialogue: 0,0:21:42.34,0:21:44.81,italics,Makoto,0,0,0,,Cháu thấy mình chẳng cần thêm cái biệt danh nào nữa đâu ạ.
Dialogue: 0,0:21:50.96,0:21:53.71,italics,Makoto,0,0,0,,May mà mọi chuyện đã êm đẹp cả.
Dialogue: 0,0:21:56.70,0:21:58.96,Default,Lucy,0,0,0,,Nè, tôi ngồi cùng bàn với cậu được chứ?
Dialogue: 0,0:23:35.20,0:24:39.96,top,Screen,0,0,0,,TẬP 3\NTAKATSUKI MAKOTO\NTHU NHẬN THÀNH VIÊN ĐẦU TIÊN

