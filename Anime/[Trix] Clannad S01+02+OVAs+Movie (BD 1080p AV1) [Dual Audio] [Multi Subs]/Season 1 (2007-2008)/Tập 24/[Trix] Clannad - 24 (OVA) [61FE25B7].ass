Dialogue: 0,0:01:50.00,0:01:56.42,OP English,,0,0,0,,{\fad(250,250)\be1}Tôi nhất định sẽ gửi trao tất cả đến cậu, nơi phương xa ấy,
Dialogue: 0,0:01:56.42,0:02:08.85,OP Romaji,,0,0,0,,{\fad(250,250)\be1}{\kf48}no{\kf42}ko{\kf29}sa{\kf210}zu {\kf52}tsu{\kf49}ta{\kf22}e{\kf183}te {\kf64}ki{\kf491}tto
Dialogue: 0,0:01:56.42,0:02:08.85,OP English,,0,0,0,,{\fad(250,250)\be1}chẳng giữ lại cho riêng mình dẫu chỉ một chút.
Dialogue: 0,0:02:17.82,0:02:19.66,Default,Oka,0,0,0,,Sắp thông báo kết quả rồi đúng không?
Dialogue: 0,0:02:19.66,0:02:21.24,Default,Oka,0,0,0,,Em không cần phải ở trong lớp mình à?
Dialogue: 0,0:02:22.07,0:02:24.49,Default,Tom,0,0,0,,Ở bên cạnh anh làm em thấy an lòng hơn.
Dialogue: 0,0:02:28.04,0:02:30.46,Default,Oka,0,0,0,,Đã một tháng trôi qua kể từ ngày tôi và Tomoyo bắt đầu hẹn hò.
Dialogue: 0,0:02:30.92,0:02:33.21,Default,Oka,0,0,0,,Cũng chẳng phải chúng tôi có một khoảnh khắc tỏ tình rạch ròi nào.
Dialogue: 0,0:02:33.92,0:02:35.17,Default,Oka,0,0,0,,Những lần đến trường muộn…
Dialogue: 0,0:02:35.17,0:02:36.63,Default,Oka,0,0,0,,Những buổi trốn học…
Dialogue: 0,0:02:36.63,0:02:37.92,Default,Oka,0,0,0,,Những chuỗi ngày lang thang vô định khắp phố phường…
Dialogue: 0,0:02:38.38,0:02:41.22,Default,Oka,0,0,0,,Tôi đã gặp gỡ Tomoyo trong những tháng ngày như thế,
Dialogue: 0,0:02:41.76,0:02:45.76,Default,Oka,0,0,0,,trở nên thân thiết tự lúc nào chẳng hay, rồi\Nchúng tôi phải lòng nhau trước cả khi kịp nhận ra.
Dialogue: 0,0:02:50.64,0:02:54.73,Default-alt,PA,0,0,0,,{\an8}Kết quả kiểm phiếu bầu cử Hội Học Sinh đã hoàn tất.
Dialogue: 0,0:02:55.19,0:02:56.44,Default-alt,PA,0,0,0,,{\an8}Tân Hội trưởng Hội Học Sinh là…
Dialogue: 0,0:02:57.19,0:02:58.65,Default-alt,PA,0,0,0,,{\an8}Em Sakagami Tomoyo.
Dialogue: 0,0:02:58.65,0:03:00.61,Default-alt,PA,0,0,0,,{\an8}Với 533 phiếu bầu.
Dialogue: 0,0:02:59.15,0:03:00.61,Default,Oka,0,0,0,,Em làm được rồi, Tomoyo!
Dialogue: 0,0:03:00.61,0:03:03.12,Default,Tom,0,0,0,,Tất cả là nhờ sự ủng hộ của anh đấy ạ!
Dialogue: 0,0:03:03.12,0:03:05.49,Default,Oka,0,0,0,,Nhưng đây mới chỉ là khởi đầu thôi, đúng không?
Dialogue: 0,0:03:05.49,0:03:08.62,Default,Oka,0,0,0,,Mục tiêu của em là bảo vệ hàng cây hoa anh đào kia mà.
Dialogue: 0,0:03:09.58,0:03:10.75,Default,Tom,0,0,0,,Em biết chứ.
Dialogue: 0,0:03:12.42,0:03:16.00,Default,Tom,0,0,0,,Tomoya, anh sẽ luôn tiếp tục ở bên cạnh em chứ?
Dialogue: 0,0:03:16.80,0:03:17.96,Default,Oka,0,0,0,,Đương nhiên rồi.
Dialogue: 0,0:03:26.85,0:03:30.52,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,360)\3c&H4A8A5C&}Một thế giới khác
Dialogue: 0,0:03:26.85,0:03:30.52,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,660)}Chương về Tomoyo
Dialogue: 0,0:03:30.98,0:03:33.15,Default,Girls,0,0,0,,Chúc mừng cậu đã đắc cử nhé!
Dialogue: 0,0:03:33.15,0:03:36.27,Default,Girls,0,0,0,,Chị Sakagami-senpai! Chúc mừng chị đã trúng cử Hội trưởng Hội Học Sinh ạ!
Dialogue: 0,0:03:36.27,0:03:37.57,Default,Tom,0,0,0,,Ừ, cảm ơn các em nhiều nhé.
Dialogue: 0,0:03:37.57,0:03:41.57,Default,Girl,0,0,0,,Bọn em luôn tin là chị sẽ chiến thắng mà!\NBọn em sẽ mãi luôn cổ vũ cho chị!
Dialogue: 0,0:03:39.86,0:03:42.45,Default-alt,Sun,0,0,0,,Nghĩ kỹ mà xem, đúng là một sự kết hợp không tưởng.
Dialogue: 0,0:03:43.20,0:03:46.53,Default,Sun,0,0,0,,Hai thằng lười biếng năm ba với cô nàng Hội trưởng Hội Học Sinh.
Dialogue: 0,0:03:46.53,0:03:48.79,Default,Sun,0,0,0,,Lẽ ra bọn mình phải sống ở hai thế giới hoàn toàn khác nhau mới đúng.
Dialogue: 0,0:03:49.16,0:03:53.67,Default,Girls,0,0,0,,Hai tên đó là học sinh cá biệt có tiếng mà, sao lại đi chung với Sakagami-san nhỉ?
Dialogue: 0,0:03:53.67,0:03:56.71,Default,Girls,0,0,0,,Cậu không biết à? Tomoyo-san thân thiết với hai người họ lắm đấy.
Dialogue: 0,0:03:58.25,0:04:01.72,Default,Sun,0,0,0,,Mày nghĩ hôm nay Hội trưởng Hội Học Sinh có ghé qua không?
Dialogue: 0,0:04:01.72,0:04:05.22,Default,Oka,0,0,0,,Chắc chắn là có rồi, từ trước tới giờ em ấy chưa từng vắng buổi nào mà.
Dialogue: 0,0:04:05.22,0:04:06.68,Default,Sun,0,0,0,,Mày vô tư lạc quan gớm nhỉ.
Dialogue: 0,0:04:06.68,0:04:07.47,Default,Oka,0,0,0,,Sao cơ?
Dialogue: 0,0:04:07.47,0:04:09.01,Default,Sun,0,0,0,,Động não một chút đi mày.
Dialogue: 0,0:04:09.01,0:04:14.19,Default,Sun,0,0,0,,Giờ con bé đã là Hội trưởng rồi,\Nkiểu gì cũng sẽ soi mói khó tính hơn trước cho coi.
Dialogue: 0,0:04:14.19,0:04:18.69,Default,Sun,0,0,0,,Kiểu như là: cấm chạy nhảy ngoài hành lang,\Nphải ăn cân đối cơm, thức ăn với uống trà.
Dialogue: 0,0:04:18.69,0:04:21.28,Default,Sun,0,0,0,,Tao không đời nào muốn lớn lên thành người lớn kiểu đó đâu!
Dialogue: 0,0:04:21.28,0:04:22.82,Default,Tom,0,0,0,,Anh đang gào thét cái gì đấy?
Dialogue: 0,0:04:22.82,0:04:24.91,Default,Sun,0,0,0,,Tomoyo, nghe đây này!
Dialogue: 0,0:04:24.91,0:04:27.87,Default,Sun,0,0,0,,Dù cô có cấm cản thế nào thì tôi cũng sẽ chén sạch đống rau này trước cho cô xem!
Dialogue: 0,0:04:27.87,0:04:30.12,Default,Tom,0,0,0,,Anh ta đang lảm nhảm cái gì thế anh?
Dialogue: 0,0:04:30.12,0:04:31.04,Default,Oka,0,0,0,,Kệ xác thằng ngốc ấy đi.
Dialogue: 0,0:04:31.04,0:04:32.16,Default,Tom,0,0,0,,À, vâng.
Dialogue: 0,0:04:32.16,0:04:33.25,Default,Sun,0,0,0,,Đừng có hùa theo thằng kia như thế chứ!
Dialogue: 0,0:04:33.25,0:04:35.54,Default,Tom,0,0,0,,Em chỉ tranh thủ ghé qua đưa cơm hộp cho hai người thôi.
Dialogue: 0,0:04:36.04,0:04:38.29,Default,Tom,0,0,0,,Giờ em phải đi họp Hội Học Sinh rồi.
Dialogue: 0,0:04:38.67,0:04:39.54,Default,Tom,0,0,0,,Hẹn gặp lại anh nhé.
Dialogue: 0,0:04:39.54,0:04:40.25,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:04:41.30,0:04:43.76,Default,Sun,0,0,0,,Mới đó mà con bé đã bận túi bụi rồi.
Dialogue: 0,0:04:43.76,0:04:44.47,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:04:45.80,0:04:47.76,Default,Sun,0,0,0,,Con bé làm phần cơm cho cả tao nữa này.
Dialogue: 0,0:04:49.14,0:04:51.89,Default,Sun,0,0,0,,Nhưng đóng gói y hệt thế này thì\Nai mà biết được hộp nào là của…
Dialogue: 0,0:04:51.89,0:04:53.52,Default,Sun,0,0,0,,Nhìn một phát là biết ngay hộp nào của ai rồi!
Dialogue: 0,0:04:53.52,0:04:56.48,Default,Girls,0,0,0,,Ủa? Mối quan hệ giữa hai người đó với Sakagami-san là gì thế nhỉ?
Dialogue: 0,0:04:56.48,0:04:59.40,Default,Girls,0,0,0,,Tớ không biết, nhưng trông họ thân thiết lắm.
Dialogue: 0,0:04:59.40,0:05:00.61,Default,Girls,0,0,0,,Chẳng lẽ họ đang hẹn hò với nhau à?
Dialogue: 0,0:05:00.61,0:05:01.82,Default,Girls,0,0,0,,Cái gì cơ? Kinh tởm thế.
Dialogue: 0,0:05:01.82,0:05:02.82,Default,Girls,0,0,0,,Nói nhỏ miệng lại coi!
Dialogue: 0,0:05:03.15,0:05:04.61,Default,Sun,0,0,0,,Mấy cô kia nhìn cái gì mà nhìn hả?!
Dialogue: 0,0:05:06.61,0:05:08.74,Note,,0,0,0,,Biển hiệu: Trường Trung học Phổ thông Hikarizaka
Dialogue: 0,0:05:10.03,0:05:12.20,Default,Sun,0,0,0,,Con bé đến muộn quá nhỉ.
Dialogue: 0,0:05:12.20,0:05:14.50,Default,Oka,0,0,0,,Lúc ăn trưa trông em ấy cũng bận rộn lắm rồi.
Dialogue: 0,0:05:15.12,0:05:17.08,Default,Oka,0,0,0,,Tao sẽ đợi thêm một chút nữa xem sao.
Dialogue: 0,0:05:18.58,0:05:22.25,Default,Tom,0,0,0,,{\an8}A, Tomoya. Xin lỗi anh nhưng anh cứ về nhà trước đi nhé.
Dialogue: 0,0:05:22.34,0:05:23.13,Default,Oka,0,0,0,,Tomoyo?
Dialogue: 0,0:05:23.13,0:05:26.51,Default,Tom,0,0,0,,{\an8}Em quên khuấy mất là có cuộc họp chuẩn bị cho Lễ hội trường.
Dialogue: 0,0:05:26.51,0:05:29.22,Default,Tom,0,0,0,,{\an8}Em nghĩ chắc phải đến tận tối muộn mới xong.
Dialogue: 0,0:05:29.22,0:05:29.64,Default,Tom,0,0,0,,{\an8}Vậy nên—
Dialogue: 0,0:05:29.64,0:05:32.26,Default,Girls,0,0,0,,{\an8}Hội trưởng! Chị không được dùng hệ thống phát thanh trường vào việc riêng đâu ạ!
Dialogue: 0,0:05:32.26,0:05:33.52,Default,Girls,0,0,0,,{\an8}Tắt mau đi chị!
Dialogue: 0,0:05:34.85,0:05:38.15,Default,Sun,0,0,0,,Bạn gái mày bạo gan thật đấy.
Dialogue: 0,0:05:38.94,0:05:43.53,Default,Teacher,0,0,0,,Thầy nghe có tin đồn là nhiều người bỏ phiếu cho em ấy chỉ để làm trò đùa đấy.
Dialogue: 0,0:05:43.53,0:05:47.24,Default,Teacher,0,0,0,,Thầy đã xem qua học bạ giới thiệu từ trường cũ của em ấy rồi.
Dialogue: 0,0:05:47.24,0:05:51.03,Default,Teacher,0,0,0,,Thầy không muốn nói điều này, nhưng có vẻ trước đây em ấy đã gây ra rất nhiều rắc rối.
Dialogue: 0,0:05:51.03,0:05:52.91,Default,Oka,0,0,0,,Đó là chuyện của quá khứ rồi thầy ạ.
Dialogue: 0,0:05:52.91,0:05:58.92,Default,Teacher,0,0,0,,Đúng là vậy. Nhưng tại ngôi trường này, em ấy cũng từng là tâm điểm của nhiều vụ ẩu đả náo loạn.
Dialogue: 0,0:05:58.92,0:06:00.46,Default,Teacher,0,0,0,,Điều đó không thể phủ nhận được, đúng không?
Dialogue: 0,0:06:00.83,0:06:03.63,Default,Teacher,0,0,0,,Thầy không có ý ép buộc gì hai em cả.
Dialogue: 0,0:06:03.63,0:06:06.72,Default,Teacher,0,0,0,,Tuy nhiên thầy muốn các em phải nhận thức rõ vị trí của mình và những việc mình đang làm.
Dialogue: 0,0:06:06.72,0:06:09.76,Default,Teacher,0,0,0,,Em hiện giờ là Hội trưởng Hội Học Sinh của chúng ta đấy.
Dialogue: 0,0:06:09.76,0:06:10.39,Default,Tom,0,0,0,,Vâng ạ…
Dialogue: 0,0:06:11.55,0:06:14.01,Default,Tom,0,0,0,,Thầy cô lo lắng như vậy cũng là lẽ tự nhiên thôi mà.
Dialogue: 0,0:06:14.60,0:06:18.98,Default,Tom,0,0,0,,Em biết ngoài kia có rất nhiều người đang bàn tán xì xào sau lưng chúng ta.
Dialogue: 0,0:06:19.27,0:06:21.86,Default,Tom,0,0,0,,Thế nhưng tất cả đều phụ thuộc vào những gì chúng ta làm mà thôi.
Dialogue: 0,0:06:22.23,0:06:23.48,Default,Tom,0,0,0,,Anh có đồng ý như vậy không, Tomoya?
Dialogue: 0,0:06:23.48,0:06:24.02,Default,Oka,0,0,0,,Ừ…
Dialogue: 0,0:06:26.65,0:06:28.82,Default,Oka,0,0,0,,Ừ, anh đồng ý.
Dialogue: 0,0:06:29.99,0:06:30.78,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:06:40.04,0:06:41.67,Default,Sun,0,0,0,,Lễ hội trường à?
Dialogue: 0,0:06:41.67,0:06:44.21,Default,Sun,0,0,0,,Tao quên béng mất vụ này luôn.
Dialogue: 0,0:06:44.21,0:06:47.17,Default,Oka,0,0,0,,Em ấy bảo dạo này sẽ bận rộn một thời gian đấy.
Dialogue: 0,0:06:47.17,0:06:48.59,Default,Sun,0,0,0,,Thế thì bọn mình đi chơi thôi.
Dialogue: 0,0:06:48.59,0:06:49.01,Default,Oka,0,0,0,,Hả?
Dialogue: 0,0:06:49.01,0:06:51.18,Default,Sun,0,0,0,,Đi xả hơi chút đi mày.
Dialogue: 0,0:06:51.18,0:06:53.64,Default,Sun,0,0,0,,Tan học rồi chúng mình đi đâu đó chơi nhé.
Dialogue: 0,0:06:53.64,0:06:55.60,Default,Sun,0,0,0,,Đằng nào mày cũng đang rảnh rỗi mà, đúng không?
Dialogue: 0,0:07:10.74,0:07:13.24,Note,,0,0,0,,Biển hiệu: {\fad(1000,0)}Lễ hội Trường THPT Hikarizaka
Dialogue: 0,0:07:13.24,0:07:16.12,Note,,0,0,0,,Biển hiệu: Lễ hội Trường THPT Hikarizaka
Dialogue: 0,0:07:33.89,0:07:35.80,Default,Sun,0,0,0,,Bớt cái vẻ mặt đưa đám đó đi mày.
Dialogue: 0,0:07:35.80,0:07:40.18,Default,Sun,0,0,0,,Sau khi Lễ hội trường kết thúc,\Ntao cá là Tomoyo-chan sẽ có nhiều thời gian rảnh hơn thôi.
Dialogue: 0,0:07:40.18,0:07:42.44,Default,Sun,0,0,0,,Đến lúc đó ba chúng ta lại có thể cùng nhau đi chơi như trước.
Dialogue: 0,0:07:42.44,0:07:43.85,Default,Oka,0,0,0,,Tao cũng mong là như vậy.
Dialogue: 0,0:07:43.85,0:07:47.61,Default,Sun,0,0,0,,Riêng tao thì đỡ phải nhìn thấy bản mặt của con bé càng tốt.
Dialogue: 0,0:07:45.90,0:07:47.90,Note,,0,0,0,,
Dialogue: 0,0:07:48.19,0:07:51.36,Default,Sun,0,0,0,,Thay vì ngồi rầu rĩ, ra làm quen với hai em gái đằng kia đi.
Dialogue: 0,0:07:51.36,0:07:54.20,Default,Sun,0,0,0,,Nhìn kìa, em gái tóc đuôi ngựa với…
Dialogue: 0,0:07:54.20,0:07:55.45,Default,Sun,0,0,0,,Này, mày có đang nghe tao nói không đấy hả?!
Dialogue: 0,0:07:56.41,0:07:56.91,Default,Sun,0,0,0,,Ủa?
Dialogue: 0,0:07:58.83,0:07:59.91,Default,Oka,0,0,0,,Mặc bộ đồ gấu này trông nóng nực lắm nhỉ.
Dialogue: 0,0:07:59.91,0:08:05.21,Default,Tom,0,0,0,,Vâng, nhưng nếu bị bắt gặp thì họ sẽ lôi em về phòng Hội Học Sinh ngay.
Dialogue: 0,0:08:05.21,0:08:07.00,Default,Oka,0,0,0,,Em bận đến mức đó cơ à?
Dialogue: 0,0:08:07.00,0:08:10.34,Default,Tom,0,0,0,,Vâng, hiện giờ em cũng đang trong giờ đi tuần tra đây.
Dialogue: 0,0:08:10.34,0:08:12.30,Default,Oka,0,0,0,,Đừng có làm việc quá sức đấy nhé.
Dialogue: 0,0:08:12.30,0:08:13.84,Default,Tom,0,0,0,,Em đâu có làm việc quá sức chút nào đâu.
Dialogue: 0,0:08:14.22,0:08:16.89,Default,Tom,0,0,0,,Em đến đây là vì em muốn được ở bên cạnh anh mà.
Dialogue: 0,0:08:17.72,0:08:21.39,Default,Tom,0,0,0,,Vả lại dạo gần đây em bận quá, chẳng dành được chút thời gian nào cho anh cả.
Dialogue: 0,0:08:26.10,0:08:31.94,Default,Tom,0,0,0,,Sau khi Lễ hội trường kết thúc, em sẽ tập trung toàn bộ tâm sức vào việc vận động bảo tồn hàng cây hoa anh đào.
Dialogue: 0,0:08:32.61,0:08:35.16,Default,Tom,0,0,0,,Có khi em sẽ còn bận rộn hơn cả bây giờ nữa.
Dialogue: 0,0:08:36.32,0:08:37.20,Default,Tom,0,0,0,,Vậy nên…
Dialogue: 0,0:08:42.87,0:08:43.41,Default,Guy,0,0,0,,Sakagami.
Dialogue: 0,0:08:45.83,0:08:46.88,Default,Guy,0,0,0,,Tôi tìm cậu nãy giờ.
Dialogue: 0,0:08:47.50,0:08:50.09,Default,Guy,0,0,0,,Các vị trưởng ban điều hành cựu học sinh đã đến chào hỏi rồi đấy.
Dialogue: 0,0:08:50.46,0:08:51.59,Default,Guy,0,0,0,,Xin cậu hãy quay lại ngay lập tức.
Dialogue: 0,0:08:52.96,0:08:57.01,Default,Tom,0,0,0,,Chờ tôi ăn nốt cái này xong có được không?
Dialogue: 0,0:08:57.01,0:08:59.05,Default,Guy,0,0,0,,Tôi đã để họ phải chờ suốt ba mươi phút rồi đấy.
Dialogue: 0,0:08:59.85,0:09:03.23,Default,Guy,0,0,0,,Chúng ta đang kêu gọi họ ủng hộ chiến dịch bảo vệ hàng cây hoa anh đào.
Dialogue: 0,0:09:03.81,0:09:05.44,Default,Guy,0,0,0,,Chúng ta không thể làm phật lòng họ được.
Dialogue: 0,0:09:07.44,0:09:08.44,Default,Tom,0,0,0,,Được rồi.
Dialogue: 0,0:09:08.86,0:09:09.81,Default,Tom,0,0,0,,Em xin lỗi anh nhé.
Dialogue: 0,0:09:09.81,0:09:11.73,Default,Oka,0,0,0,,Không sao đâu. Cố lên nhé em.
Dialogue: 0,0:09:14.11,0:09:15.03,Default,Tom,0,0,0,,Em đi đây.
Dialogue: 0,0:09:20.87,0:09:22.83,Default,Guy,0,0,0,,Anh là Okazaki Tomoya đúng không?
Dialogue: 0,0:09:23.20,0:09:25.54,Default,Oka,0,0,0,,Là đàn em năm dưới mà ăn nói xấc xược thẳng thừng gớm nhỉ.
Dialogue: 0,0:09:25.54,0:09:28.63,Default,Guy,0,0,0,,Anh có biết là anh rất nổi tiếng không?
Dialogue: 0,0:09:29.04,0:09:31.34,Default,Oka,0,0,0,,Nổi tiếng vì là một tên học sinh cá biệt bất hảo chứ gì?
Dialogue: 0,0:09:31.34,0:09:33.46,Default,Guy,0,0,0,,Vì là bạn trai của Sakagami Tomoyo.
Dialogue: 0,0:09:34.46,0:09:36.51,Default,Guy,0,0,0,,Tôi đã luôn muốn nói với anh điều này từ lâu rồi.
Dialogue: 0,0:09:36.51,0:09:38.59,Default,Guy,0,0,0,,Hãy tránh xa cô ấy ra đi.
Dialogue: 0,0:09:38.97,0:09:41.22,Default,Oka,0,0,0,,À, ra là chú mày đang ghen tị.
Dialogue: 0,0:09:42.18,0:09:43.10,Default,Guy,0,0,0,,Nhầm rồi.
Dialogue: 0,0:09:43.72,0:09:49.65,Default,Guy,0,0,0,,Tôi quan tâm đến cô ấy vì cô ấy là người có thể vươn tới những đỉnh cao hơn nhiều.
Dialogue: 0,0:09:51.11,0:09:53.36,Default,Guy,0,0,0,,Cô ấy vô cùng chăm chỉ và nỗ lực hết mình.
Dialogue: 0,0:09:53.94,0:09:56.24,Default,Guy,0,0,0,,Cô ấy có thể chạm tới một tương lai xán lạn hơn.
Dialogue: 0,0:09:56.24,0:09:58.24,Default,Guy,0,0,0,,Cô ấy là kiểu người như thế đấy.
Dialogue: 0,0:09:59.28,0:10:01.20,Default,Guy,0,0,0,,Anh chỉ đang là gánh nặng cản trở bước chân cô ấy mà thôi.
Dialogue: 0,0:10:01.83,0:10:03.83,Default,Guy,0,0,0,,Đó là điều mà tất cả mọi người đều nghĩ.
Dialogue: 0,0:10:04.20,0:10:06.29,Default,Oka,0,0,0,,Biến đi! Chú mày muốn kiếm chuyện đánh nhau đấy à?!
Dialogue: 0,0:10:06.29,0:10:07.04,Default,Guy,0,0,0,,Anh biết mà!
Dialogue: 0,0:10:07.91,0:10:09.71,Default,Guy,0,0,0,,Chính bản thân anh cũng tự hiểu rõ điều đó mà, đúng không?
Dialogue: 0,0:10:10.63,0:10:13.71,Default,Guy,0,0,0,,'Mình chẳng thể làm được bất cứ điều gì cho cô ấy cả'.
Dialogue: 0,0:10:15.59,0:10:16.42,Default,Guy,0,0,0,,Tôi đi đây.
Dialogue: 0,0:10:16.84,0:10:19.22,Default,Guy,0,0,0,,Tôi phải đi giúp đỡ Sakagami.
Dialogue: 0,0:10:34.65,0:10:36.44,Default,Teacher,0,0,0,,Sakagami-kun là một học sinh vô cùng xuất sắc.
Dialogue: 0,0:10:36.82,0:10:38.24,Default,Teacher,0,0,0,,Em ấy cũng rất được lòng mọi người.
Dialogue: 0,0:10:38.24,0:10:43.49,Default,Teacher,0,0,0,,Thế nhưng mặt khác, em ấy lại rất thân thiết với một học sinh thường xuyên trốn học, đi muộn.
Dialogue: 0,0:10:44.28,0:10:48.96,Default,Teacher,0,0,0,,Em ấy từng dùng hệ thống phát thanh trường vào việc riêng chỉ để liên lạc với người đó…
Dialogue: 0,0:10:48.96,0:10:52.38,Default,Teacher,0,0,0,,…và thậm chí bỏ bê vị trí trong Lễ hội trường để ra ngoài gặp cậu ta.
Dialogue: 0,0:10:53.21,0:10:54.34,Default,Teacher,0,0,0,,Em hiểu những gì thầy đang nói chứ?
Dialogue: 0,0:10:54.34,0:10:58.88,Default,Teacher,0,0,0,,Tất cả những rắc rối mà em ấy gặp phải đều liên quan trực tiếp đến em.
Dialogue: 0,0:11:02.09,0:11:03.35,Default,Tom,0,0,0,,Tomoya!
Dialogue: 0,0:11:03.35,0:11:04.76,Default,Oka,0,0,0,,Chào em.
Dialogue: 0,0:11:05.47,0:11:06.47,Default,Oka,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:11:06.47,0:11:10.06,Default,Tom,0,0,0,,Em xin lỗi, em có việc gấp phải xử lý. Anh cứ về trước đi nhé.
Dialogue: 0,0:11:10.06,0:11:11.77,Default,Oka,0,0,0,,Có mất nhiều thời gian không em?
Dialogue: 0,0:11:12.15,0:11:13.65,Default,Tom,0,0,0,,Em không chắc lắm, nhưng chắc là có ạ.
Dialogue: 0,0:11:14.81,0:11:16.52,Default,Oka,0,0,0,,Không sao đâu. Em đừng bận tâm làm gì.
Dialogue: 0,0:11:16.98,0:11:18.61,Default,Tom,0,0,0,,Vâng, cảm ơn anh nhé.
Dialogue: 0,0:11:23.78,0:11:25.45,Default,Guy,0,0,0,,Anh chính là nguồn cơn của mọi rắc rối đấy.
Dialogue: 0,0:11:26.37,0:11:30.75,Default,Guy,0,0,0,,Anh biết cô ấy đang nỗ lực bảo vệ hàng cây hoa anh đào mà, đúng không?
Dialogue: 0,0:11:31.21,0:11:33.17,Default,Oka,0,0,0,,Thì sao chứ?
Dialogue: 0,0:11:33.17,0:11:36.92,Default,Guy,0,0,0,,Các cựu học sinh đang hỗ trợ chúng tôi đã nghe được một tin đồn rất xấu.
Dialogue: 0,0:11:37.46,0:11:43.34,Default,Guy,0,0,0,,Rằng Sakagami Tomoyo đã bước ra từ\Nnhà bạn trai vào buổi sáng sớm.
Dialogue: 0,0:11:43.34,0:11:46.81,Default,Oka,0,0,0,,Hả? Em ấy chỉ đến đánh thức tôi dậy thôi mà.
Dialogue: 0,0:11:46.81,0:11:49.89,Default,Guy,0,0,0,,Dẫu sự thật có là vậy đi chăng nữa, vấn đề mấu chốt nằm ở chỗ người đó là anh.
Dialogue: 0,0:11:50.23,0:11:52.06,Default,Guy,0,0,0,,Nó rất dễ làm bùng lên những tin đồn thất thiệt tai hại.
Dialogue: 0,0:11:52.85,0:11:54.69,Default,Guy,0,0,0,,Sakagami hiện là Hội trưởng Hội Học Sinh.
Dialogue: 0,0:11:55.23,0:11:57.77,Default,Guy,0,0,0,,Cô ấy phải là tấm gương mẫu mực cho toàn thể học sinh noi theo.
Dialogue: 0,0:11:58.23,0:12:02.32,Default,Guy,0,0,0,,Nếu một người như thế vướng vào bê bối, chiến dịch bảo tồn sẽ bị đình trệ ngay.
Dialogue: 0,0:12:04.41,0:12:09.49,Default,Guy,0,0,0,,Anh có hiểu người mà anh đang hẹn hò là ai không?
Dialogue: 0,0:12:10.87,0:12:13.37,Default,Guy,0,0,0,,Và bản thân anh là loại người như thế nào không?
Dialogue: 0,0:12:20.21,0:12:22.51,Default,Tom,0,0,0,,Chẳng có chuyện gì to tát đâu anh.
Dialogue: 0,0:12:22.51,0:12:25.34,Default,Tom,0,0,0,,Hiểu lầm đã được giải quyết êm đẹp rồi, nên không có vấn đề gì nữa đâu ạ.
Dialogue: 0,0:12:25.76,0:12:27.10,Default,Tom,0,0,0,,Xong xuôi hết rồi mà.
Dialogue: 0,0:12:27.60,0:12:28.18,Default,Tom,0,0,0,,Được không anh?
Dialogue: 0,0:12:34.27,0:12:36.60,Default,Tom,0,0,0,,Nhìn kìa, tại anh cứ thừ người ra đấy thôi.
Dialogue: 0,0:12:38.77,0:12:39.52,Default,Oka,0,0,0,,Tomoyo.
Dialogue: 0,0:12:40.86,0:12:41.69,Default,Oka,0,0,0,,Chúng mình chia tay đi.
Dialogue: 0,0:12:48.28,0:12:51.20,Default,Oka,0,0,0,,Sẽ tốt nhất cho cả hai nếu chúng ta chia tay.
Dialogue: 0,0:12:53.04,0:12:55.71,Default,Tom,0,0,0,,Em đã bảo anh đừng có đùa như thế rồi mà.
Dialogue: 0,0:12:55.71,0:12:57.42,Default,Oka,0,0,0,,Em có một mục tiêu lớn lao để theo đuổi.
Dialogue: 0,0:12:58.17,0:13:01.55,Default,Oka,0,0,0,,Nhưng nếu cứ ở bên cạnh anh, chắc chắn em sẽ chẳng thể nào chạm tới đích được.
Dialogue: 0,0:13:07.26,0:13:08.97,Default,Oka,0,0,0,,Hiểu không em? Vậy nên—
Dialogue: 0,0:13:08.97,0:13:09.51,Default,Tom,0,0,0,,Không.
Dialogue: 0,0:13:11.35,0:13:12.43,Default,Tom,0,0,0,,Em không muốn!
Dialogue: 0,0:13:12.43,0:13:12.97,Default,Oka,0,0,0,,Tomo—
Dialogue: 0,0:13:12.97,0:13:13.81,Default,Tom,0,0,0,,Em không muốn đâu!
Dialogue: 0,0:13:13.81,0:13:14.85,Default-alt,Girls,0,0,0,,Có chuyện gì thế kia?
Dialogue: 0,0:13:14.85,0:13:16.81,Default-alt,Girls,0,0,0,,Đừng nhìn chằm chằm vào người ta như thế.
Dialogue: 0,0:13:16.81,0:13:20.52,Default,Tom,0,0,0,,Nếu không có em, anh sẽ gặp rắc rối to đấy.
Dialogue: 0,0:13:21.07,0:13:24.44,Default,Tom,0,0,0,,Không có em, ai sẽ đánh thức anh mỗi buổi sáng đây?
Dialogue: 0,0:13:25.15,0:13:26.99,Default,Tom,0,0,0,,Ai sẽ làm cơm hộp mang cho anh?
Dialogue: 0,0:13:28.16,0:13:30.33,Default,Tom,0,0,0,,Còn việc ôn thi kiểm tra của anh thì sao?
Dialogue: 0,0:13:30.99,0:13:33.04,Default,Tom,0,0,0,,Với lại… Với lại…
Dialogue: 0,0:13:33.04,0:13:33.75,Default,Oka,0,0,0,,Em đừng lo.
Dialogue: 0,0:13:34.16,0:13:37.17,Default,Oka,0,0,0,,Không có em, anh vẫn sẽ tự lo liệu được hết.
Dialogue: 0,0:13:37.67,0:13:38.42,Default,Tom,0,0,0,,Nhưng mà…
Dialogue: 0,0:13:39.17,0:13:40.21,Default,Tom,0,0,0,,Nhưng mà…
Dialogue: 0,0:13:40.21,0:13:43.84,Default,Oka,0,0,0,,Nếu ở bên cạnh em, anh sẽ lại ỷ lại và dựa dẫm vào em mọi thứ.
Dialogue: 0,0:13:44.17,0:13:45.55,Default,Oka,0,0,0,,Như thế thì không được.
Dialogue: 0,0:13:46.01,0:13:47.93,Default,Tom,0,0,0,,Em yêu anh.
Dialogue: 0,0:13:48.76,0:13:50.14,Default,Tom,0,0,0,,Em muốn được ở bên cạnh anh.
Dialogue: 0,0:13:50.14,0:13:50.80,Default,Oka,0,0,0,,Tomoyo.
Dialogue: 0,0:13:53.89,0:13:56.56,Default,Oka,0,0,0,,Cảm xúc trước giờ của anh không phải là tình yêu.
Dialogue: 0,0:13:59.19,0:14:01.56,Default,Oka,0,0,0,,Anh thực sự chỉ là một kẻ ích kỷ mà thôi.
Dialogue: 0,0:14:03.48,0:14:06.53,Default,Oka,0,0,0,,Tomoyo, hãy đáp lại những kỳ vọng lớn lao mà mọi người dành cho em.
Dialogue: 0,0:14:07.32,0:14:12.03,Default,Oka,0,0,0,,Để một ngày nào đó, anh có thể tự hào ngoảnh lại và nói rằng:\N'Oa, mình từng hẹn hò với một người tuyệt vời đến nhường nào'.
Dialogue: 0,0:14:12.83,0:14:14.99,Default,Oka,0,0,0,,Xin em đấy, Tomoyo.
Dialogue: 0,0:14:20.92,0:14:21.79,Default,Tom,0,0,0,,Vâng.
Dialogue: 0,0:14:24.42,0:14:25.46,Default,Tom,0,0,0,,Em hứa với anh.
Dialogue: 0,0:14:27.63,0:14:28.55,Default,Tom,0,0,0,,Vậy thì…
Dialogue: 0,0:14:30.01,0:14:35.60,Default,Tom,0,0,0,,Cảm ơn anh vì đã hẹn hò với một đứa con gái như em.
Dialogue: 0,0:14:39.02,0:14:39.85,Default,Tom,0,0,0,,Anh hãy giữ gìn sức khỏe nhé.
Dialogue: 0,0:14:40.60,0:14:41.15,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:15:24.69,0:15:27.82,Default,Sun,0,0,0,,Tao cứ chắc mẩm là hai đứa mày sẽ cùng nhau đi tới tận hôn nhân kia đấy.
Dialogue: 0,0:15:27.82,0:15:30.03,Default,Oka,0,0,0,,Chuyện đời đâu có dễ dàng như thế.
Dialogue: 0,0:15:30.36,0:15:35.66,Default,Sun,0,0,0,,Không, nếu bị ép phải chọn, tao từng nghĩ con bé sẽ chọn mày thay vì Hội Học Sinh cơ.
Dialogue: 0,0:15:36.58,0:15:37.79,Default,Oka,0,0,0,,Tao cũng không rõ nữa.
Dialogue: 0,0:15:39.08,0:15:44.75,Default,Sun,0,0,0,,Nhưng mà, không còn Tomoyo-chan nữa, chẳng phải mày lại quay về làm một kẻ vô tích sự sao?
Dialogue: 0,0:15:57.68,0:16:00.56,Default,Teacher,0,0,0,,Do đó, bài tập số 2 là một dạng vận dụng của…
Dialogue: 0,0:16:01.52,0:16:03.06,Default,Teacher,0,0,0,,…ví dụ 1.
Dialogue: 0,0:16:33.93,0:16:36.76,Default,Girl,0,0,0,,Cậu nghe tin gì chưa?! Tomoyo-san đứng thứ tư toàn quốc trong kỳ thi Quốc Gia đấy!
Dialogue: 0,0:16:36.76,0:16:40.01,Default,Guy,0,0,0,,Hôm nọ cô ấy còn được nhận bằng khen vì hoạt động tình nguyện xuất sắc nữa.
Dialogue: 0,0:16:40.01,0:16:42.35,Default,Girl,0,0,0,,Tớ nghe nói cô ấy còn nhận được lời mời đi du học trao đổi sinh viên nữa kìa.
Dialogue: 0,0:16:46.56,0:16:48.19,Default,Sun,0,0,0,,Tao bật băng xem thật đấy nhé?
Dialogue: 0,0:16:48.19,0:16:49.48,Default,Oka,0,0,0,,Mày muốn làm gì thì tùy.
Dialogue: 0,0:16:52.11,0:16:55.91,Default,Sun,0,0,0,,Tao chỉ sợ mày không muốn nhìn thấy thôi.
Dialogue: 0,0:16:57.66,0:16:59.08,Default,Sun,0,0,0,,Mày chắc là tao bật được chứ?
Dialogue: 0,0:16:59.08,0:17:00.28,Default,Oka,0,0,0,,Bật đại đi.
Dialogue: 0,0:17:01.49,0:17:02.33,Default,Sun,0,0,0,,Được rồi.
Dialogue: 0,0:17:10.25,0:17:11.30,Default,Sun,0,0,0,,Tiếng nước nào thế này?
Dialogue: 0,0:17:11.50,0:17:14.09,Default,Oka,0,0,0,,Hình như em ấy đang thuyết trình về hàng cây hoa anh đào.
Dialogue: 0,0:17:19.93,0:17:22.27,Default,Sun,0,0,0,,Đây chính là đoạn video hôm trước bọn mình thấy trên ti vi này.
Dialogue: 0,0:17:22.27,0:17:23.10,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:17:23.47,0:17:26.98,Default,Sun,0,0,0,,Bọn mình từng thân thiết với một người vĩ đại thật đấy nhỉ?
Dialogue: 0,0:17:32.94,0:17:33.69,Default,Sun,0,0,0,,Này mày.
Dialogue: 0,0:17:39.91,0:17:41.37,Default,Sun,0,0,0,,Có vẻ con bé bận rộn ghê.
Dialogue: 0,0:17:42.04,0:17:42.99,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:17:56.26,0:17:57.97,Default,Oka,0,0,0,,Quả đầu của mày bị làm sao thế kia?!
Dialogue: 0,0:17:57.97,0:17:59.43,Default,Sun,0,0,0,,Đừng có cười!
Dialogue: 0,0:17:59.43,0:18:02.22,Default,Sun,0,0,0,,Tao nhìn vào gương còn thấy dị hợm đây này!
Dialogue: 0,0:18:02.93,0:18:04.85,Default,Sun,0,0,0,,Nhưng tao hết cách rồi.
Dialogue: 0,0:18:04.85,0:18:08.06,Default,Sun,0,0,0,,Tao đâu thể để đầu tóc vàng hoe đi phỏng vấn xin việc được.
Dialogue: 0,0:18:10.19,0:18:12.27,Default,Teacher,0,0,0,,Có lẽ chỗ đó không phù hợp với em thôi.
Dialogue: 0,0:18:13.19,0:18:15.53,Default,Teacher,0,0,0,,Nhưng em đừng nản lòng bỏ cuộc nhé.
Dialogue: 0,0:18:16.19,0:18:19.70,Default,Teacher,0,0,0,,Rồi em sẽ sớm tìm được một công việc khiến em hài lòng thôi.
Dialogue: 0,0:18:24.99,0:18:30.17,Default,Oka,0,0,0,,Nơi duy nhất nhận tôi vào làm việc hóa ra lại nằm ngay trong thị trấn này.
Dialogue: 0,0:18:31.38,0:18:33.80,Default,Oka,0,0,0,,Tôi từng mong nó ít nhất cũng cách xa một ga tàu.
Dialogue: 0,0:18:40.13,0:18:46.56,Default,Teacher,0,0,0,,Hầu hết các em sẽ tiếp tục học lên cao và bước ra đời gánh vác những trọng trách quan trọng.
Dialogue: 0,0:18:47.02,0:18:48.73,Default,Teacher,0,0,0,,Ngôi trường của chúng ta…
Dialogue: 0,0:18:50.10,0:18:52.81,Default,Sun,0,0,0,,Gì thế? Mày về thật đấy à?
Dialogue: 0,0:18:52.81,0:18:54.52,Default,Sun,0,0,0,,Lát nữa bọn mình còn có tiệc liên hoan nữa mà.
Dialogue: 0,0:18:54.52,0:18:55.94,Default,Oka,0,0,0,,Tao thấy ở lại cũng chẳng để làm gì.
Dialogue: 0,0:18:56.48,0:18:58.49,Default,Oka,0,0,0,,Lát nữa tao sẽ qua phòng mày sau.
Dialogue: 0,0:18:58.49,0:18:59.32,Default,Sun,0,0,0,,Được rồi.
Dialogue: 0,0:19:20.76,0:19:22.01,Default,Tom,0,0,0,,Anh vẫn khỏe chứ?
Dialogue: 0,0:19:22.43,0:19:23.18,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:19:26.22,0:19:27.01,Default,Oka,0,0,0,,Có chuyện gì thế em?
Dialogue: 0,0:19:27.35,0:19:30.35,Default,Tom,0,0,0,,Em đứng đây chờ anh. Em muốn báo cho anh một tin.
Dialogue: 0,0:19:30.64,0:19:31.27,Default,Oka,0,0,0,,Báo cho anh tin gì cơ?
Dialogue: 0,0:19:32.06,0:19:33.94,Default,Tom,0,0,0,,Hàng cây hoa anh đào nơi đây sẽ không bị chặt hạ nữa.
Dialogue: 0,0:19:34.61,0:19:35.94,Default,Tom,0,0,0,,Cuối cùng mọi việc cũng đã được quyết định chính thức rồi.
Dialogue: 0,0:19:36.73,0:19:37.53,Default,Oka,0,0,0,,Anh hiểu rồi.
Dialogue: 0,0:19:38.07,0:19:39.03,Default,Tom,0,0,0,,Một khoảng thời gian thật dài.
Dialogue: 0,0:19:39.69,0:19:41.36,Default,Tom,0,0,0,,Đó là mục tiêu mà em không thể nào từ bỏ.
Dialogue: 0,0:19:41.99,0:19:43.70,Default,Tom,0,0,0,,Giờ đây, ước nguyện ấy cuối cùng cũng đã trở thành hiện thực.
Dialogue: 0,0:19:44.28,0:19:45.99,Default,Oka,0,0,0,,Vậy là em đã biến ước mơ của mình thành sự thật rồi.
Dialogue: 0,0:19:47.03,0:19:49.66,Default,Tom,0,0,0,,Nhưng em cũng đã đánh mất quá nhiều vì nó.
Dialogue: 0,0:19:50.83,0:19:54.96,Default,Tom,0,0,0,,Những tháng ngày quý giá mà đáng lẽ em đã có thể ở bên cạnh người em yêu.
Dialogue: 0,0:19:57.17,0:19:58.80,Default,Tom,0,0,0,,Em yêu anh.
Dialogue: 0,0:19:59.88,0:20:03.22,Default,Tom,0,0,0,,Cả bây giờ cũng vậy. Em càng yêu anh nhiều hơn trước kia.
Dialogue: 0,0:20:04.14,0:20:06.72,Default,Oka,0,0,0,,Suốt thời gian qua chúng mình đâu có nói chuyện với nhau.
Dialogue: 0,0:20:07.26,0:20:08.26,Default,Tom,0,0,0,,Anh nói đúng.
Dialogue: 0,0:20:08.93,0:20:10.06,Default,Tom,0,0,0,,Thế nhưng em vẫn luôn dõi theo anh.
Dialogue: 0,0:20:11.35,0:20:12.48,Default,Tom,0,0,0,,Em đã dõi theo anh suốt cả quãng thời gian qua.
Dialogue: 0,0:20:13.56,0:20:16.52,Default,Tom,0,0,0,,Dù không có em bên cạnh, anh vẫn làm rất tốt.
Dialogue: 0,0:20:17.15,0:20:19.03,Default,Tom,0,0,0,,Anh đi học đầy đủ, không còn đến trường muộn nữa.
Dialogue: 0,0:20:19.57,0:20:21.90,Default,Tom,0,0,0,,Anh đã nỗ lực từng chút, từng chút một mỗi ngày.
Dialogue: 0,0:20:23.11,0:20:33.87,Note,,0,0,0,,
Dialogue: 0,0:20:23.11,0:20:33.87,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Nơi chốn ấy cứ đổi thay rồi trôi xa. Tựa làn gió thoảng, tựa áng mây bay,
Dialogue: 0,0:20:23.65,0:20:24.20,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:20:25.32,0:20:27.37,Default,Oka,0,0,0,,Dù rằng việc tự làm cơm hộp vượt quá khả năng của anh.
Dialogue: 0,0:20:28.49,0:20:31.45,Default,Oka,0,0,0,,Anh cũng đã dồn rất nhiều nỗ lực để đi tìm việc làm.
Dialogue: 0,0:20:31.79,0:20:35.08,Default,Oka,0,0,0,,Thư giới thiệu của nhà trường quá tệ, nên anh bị người ta từ chối ở rất nhiều nơi.
Dialogue: 0,0:20:33.87,0:20:47.55,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Tựa dấu vết khắc sâu trong tim, chẳng dừng chân ở một nơi chốn nào.
Dialogue: 0,0:20:35.08,0:20:37.13,Default,Oka,0,0,0,,Nhưng gần đây cuối cùng anh cũng tìm được một chỗ rồi.
Dialogue: 0,0:20:37.92,0:20:39.55,Default,Oka,0,0,0,,Một công ty nhỏ thôi.
Dialogue: 0,0:20:39.55,0:20:40.88,Default,Oka,0,0,0,,Tiệm thu mua phế liệu đồ cũ.
Dialogue: 0,0:20:41.42,0:20:44.13,Default,Oka,0,0,0,,Văn phòng cũng khá gần.
Dialogue: 0,0:20:45.01,0:20:47.09,Default,Oka,0,0,0,,Ngay trong thị trấn này thôi.
Dialogue: 0,0:20:47.09,0:20:48.39,Default,Oka,0,0,0,,Đi làm cũng tiện lợi.
Dialogue: 0,0:20:48.49,0:20:59.03,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Nơi chốn ấy xa xôi biết bao, cách biệt ngút ngàn.
Dialogue: 0,0:20:53.23,0:20:54.39,Default,Oka,0,0,0,,Đó là tất cả những gì anh muốn nói.
Dialogue: 0,0:20:56.23,0:20:59.86,Default,Oka,0,0,0,,Này, trước đây anh đã nói chuyện với em thế nào ấy nhỉ?
Dialogue: 0,0:20:59.03,0:21:11.98,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Bàn tay trần thế chẳng thể với tới, nên chỉ biết tôn thờ ngưỡng vọng.
Dialogue: 0,0:21:00.98,0:21:04.82,Default,Oka,0,0,0,,Anh đã nói chuyện và cười đùa với em ra sao?
Dialogue: 0,0:21:06.86,0:21:08.78,Default,Oka,0,0,0,,Em và anh không thể cùng đi chung một con đường được.
Dialogue: 0,0:21:10.03,0:21:11.83,Default,Oka,0,0,0,,Sang năm em cũng sẽ tốt nghiệp.
Dialogue: 0,0:21:12.20,0:21:14.83,Default,Oka,0,0,0,,Chắc chắn em sẽ rời khỏi nơi này và bay thật xa.
Dialogue: 0,0:21:13.99,0:21:24.79,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Nơi chốn ấy tựa bậc đế vương cao vời vợi, chẳng đón nhận một ai.
Dialogue: 0,0:21:16.00,0:21:17.92,Default,Oka,0,0,0,,Em có thể tiến xa hơn anh rất nhiều!
Dialogue: 0,0:21:19.00,0:21:20.21,Default,Oka,0,0,0,,Nhưng anh thì không thể…
Dialogue: 0,0:21:21.21,0:21:22.88,Default,Oka,0,0,0,,Anh bị kẹt lại ở nơi này rồi.
Dialogue: 0,0:21:23.51,0:21:25.17,Default,Oka,0,0,0,,Anh sẽ mãi mãi ở lại chốn này.
Dialogue: 0,0:21:24.79,0:21:38.16,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Rồi chúng ta sẽ đánh mất nơi chốn ấy, một nơi cao sang đầy biến thiên.
Dialogue: 0,0:21:26.59,0:21:28.05,Default,Oka,0,0,0,,Anh là loại người như thế đấy.
Dialogue: 0,0:21:30.64,0:21:33.43,Default,Tom,0,0,0,,Vậy thì, em sẽ đến bên anh.
Dialogue: 0,0:21:34.73,0:21:35.60,Default,Tom,0,0,0,,Em sẽ đến bên anh.
Dialogue: 0,0:21:37.73,0:21:38.73,Default,Oka,0,0,0,,Tại sao chứ?
Dialogue: 0,0:21:38.16,0:21:49.93,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Dù chẳng phải mọi điều đều như ý nguyện. Thế nhưng, chúng ta sẽ chẳng hề đau buồn.
Dialogue: 0,0:21:39.36,0:21:42.44,Default,Oka,0,0,0,,Em có thể đến một nơi tốt đẹp hơn nhiều, em không hiểu sao?
Dialogue: 0,0:21:42.44,0:21:47.78,Default,Oka,0,0,0,,Em có thể đỗ vào một trường đại học danh tiếng, gặp gỡ bao người, đón nhận những kỳ vọng và hoàn thành chúng!
Dialogue: 0,0:21:47.78,0:21:50.66,Default,Oka,0,0,0,,Có những chân trời cao rộng hơn nhiều đang chờ đợi em ở phía trước!
Dialogue: 0,0:21:49.93,0:22:04.05,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Dẫu vậy, nơi ấy vẫn luôn hiện hữu. Xa xôi… xa xôi diệu vợi.
Dialogue: 0,0:21:50.66,0:21:52.74,Default,Oka,0,0,0,,Một nơi cao hơn nhiều so với việc đứng cạnh anh!
Dialogue: 0,0:21:52.74,0:21:54.16,Default,Tom,0,0,0,,Anh đừng tự hạ thấp bản thân mình như thế nữa.
Dialogue: 0,0:21:55.20,0:21:56.62,Default,Tom,0,0,0,,Anh đừng tự hạ thấp bản thân mình như thế nữa.
Dialogue: 0,0:21:58.04,0:21:59.33,Default,Tom,0,0,0,,Đó là sự lựa chọn của chính em.
Dialogue: 0,0:22:00.00,0:22:04.05,Default,Tom,0,0,0,,So với một đỉnh cao được dệt nên từ những điểm số hay thư giới thiệu của thầy cô,
Dialogue: 0,0:22:04.51,0:22:06.67,Default,Tom,0,0,0,,thì nơi đây quý giá đối với em hơn rất nhiều.
Dialogue: 0,0:22:08.38,0:22:09.30,Default,Tom,0,0,0,,Vì vậy…
Dialogue: 0,0:22:09.84,0:22:11.39,Default,Tom,0,0,0,,Em sẽ đến bên cạnh anh!
Dialogue: 0,0:22:11.76,0:22:13.14,Default,Tom,0,0,0,,Em sẽ dồn hết tất cả những gì mình có để đến bên anh!
Dialogue: 0,0:22:33.02,0:22:43.81,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Nơi chốn vùi sâu trong tuyết trắng mênh mông. Tựa tòa thành đang dần sụp đổ.
Dialogue: 0,0:22:34.66,0:22:36.16,Default,Oka,0,0,0,,Chẳng biết ai mới là tiền bối ở đây nữa.
Dialogue: 0,0:22:38.08,0:22:38.79,Default,Oka,0,0,0,,Anh cũng sẽ đi.
Dialogue: 0,0:22:40.46,0:22:45.46,Default,Oka,0,0,0,,Dù có hơi muộn màng một chút, nhưng anh cũng sẽ bước đến nơi có em.
Dialogue: 0,0:22:43.81,0:22:57.73,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Tựa chiếc bóng nhạt nhòa, hình bóng ấy sẽ bị cuốn trôi.
Dialogue: 0,0:22:54.56,0:22:55.56,Default,Tom,0,0,0,,Tomoya…
Dialogue: 0,0:22:56.85,0:22:57.73,Default,Tom,0,0,0,,Tomoya!
Dialogue: 0,0:22:58.36,0:23:09.20,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Nơi chốn ấy tựa bậc đế vương cao vời vợi. Chẳng đón nhận một ai.
Dialogue: 0,0:22:59.69,0:23:00.73,Default,Oka,0,0,0,,Gì thế?
Dialogue: 0,0:23:01.69,0:23:03.06,Default,Oka,0,0,0,,Gì thế em?!
Dialogue: 0,0:23:09.20,0:23:25.25,Signs,,0,0,0,,{\blur3\fs60\fad(250,250)}Dẫu vậy, nơi ấy vẫn luôn hiện hữu. Xa xôi… xa xôi diệu vợi.
Dialogue: 0,0:23:11.45,0:23:12.78,Default,Oka,0,0,0,,Sao thế em?
Dialogue: 0,0:23:13.82,0:23:14.87,Default,Oka,0,0,0,,Ngoan nào, đừng khóc chứ.
Dialogue: 0,0:23:20.16,0:23:24.00,Default,,0,0,0,,
Comment: 0,0:00:00.00,0:00:01.89,Default,,0,0,0,,
Comment: 0,0:00:00.52,0:00:02.95,Default,Oka,0,0,0,,It's been a month since Tomoyo and I started dating.
Comment: 0,0:00:03.27,0:00:05.35,Default,Oka,0,0,0,,It's not like we had a distinct moment we began seeing each other.
Comment: 0,0:00:05.98,0:00:07.25,Default,Oka,0,0,0,,Being late to school...
Comment: 0,0:00:07.25,0:00:08.68,Default,Oka,0,0,0,,Skipping classes...
Comment: 0,0:00:08.68,0:00:09.84,Default,Oka,0,0,0,,Wandering around the city...
Comment: 0,0:00:10.38,0:00:12.97,Default,Oka,0,0,0,,I met Tomoyo spending days like that,
Comment: 0,0:00:13.52,0:00:17.56,Default,Oka,0,0,0,,became close starting who knows when,\Nand before we knew it, we were in love.
Comment: 0,0:00:18.23,0:00:21.29,Default,Tom,0,0,0,,Tomoya, will you continue to stay by my side?
Comment: 0,0:00:22.10,0:00:22.83,Default,Oka,0,0,0,,Yeah, I agree.
Comment: 0,0:00:23.83,0:00:28.52,Default,Guy,0,0,0,,Do you understand what kind of person you're dating?
Comment: 0,0:00:41.60,0:02:17.82,Default,,0,0,0,,
Comment: 0,0:04:37.67,0:04:39.67,Signs,,0,0,0,,
Comment: 0,0:10:19.22,0:10:34.65,Default,,0,0,0,,


