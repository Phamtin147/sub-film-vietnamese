Dialogue: 0,0:00:00.00,0:00:00.52,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Note,,0,0,0,,
Dialogue: 0,0:00:05.31,0:00:06.98,Default,Tom,0,0,0,,Tomoya, thức dậy mau!
Dialogue: 0,0:00:08.32,0:00:10.36,Default,Oka,0,0,0,,Anh bị đau bụng rồi, hôm nay anh nghỉ học đây.
Dialogue: 0,0:00:10.36,0:00:13.36,Default,Tom,0,0,0,,Một tuần anh định đau bụng mấy lần hả?
Dialogue: 0,0:00:13.36,0:00:16.24,Default,Oka,0,0,0,,Anh đã bảo rồi mà, sáng nào em cũng không cần phải sang đây gọi anh dậy đâu.
Dialogue: 0,0:00:16.24,0:00:18.28,Default,Tom,0,0,0,,Em không thể bỏ mặc anh một mình được.
Dialogue: 0,0:00:18.28,0:00:20.45,Default,Tom,0,0,0,,Dù sao thì em cũng là bạn gái của anh mà.
Dialogue: 0,0:00:20.45,0:00:21.45,Default,Oka,0,0,0,,Chúng mình chia tay đi.
Dialogue: 0,0:00:25.04,0:00:27.96,Default,Tom,0,0,0,,Dù là nói đùa thì anh cũng đừng bao giờ nói những lời như thế nhé.
Dialogue: 0,0:00:27.96,0:00:30.00,Default,Tom,0,0,0,,Em sẽ buồn lòng lắm đấy.
Dialogue: 0,0:00:30.38,0:00:32.13,Default,Oka,0,0,0,,Thôi nào, đừng có ủ rũ xụ mặt ra thế chứ.
Dialogue: 0,0:00:32.13,0:00:33.05,Default,Oka,0,0,0,,Anh xin lỗi mà.
Dialogue: 0,0:00:33.05,0:00:36.89,Default,Oka,0,0,0,,Này, hôm nay là ngày bầu cử Hội Học Sinh đúng không?
Dialogue: 0,0:00:36.89,0:00:38.39,Default,Oka,0,0,0,,Phải phấn chấn tinh thần lên rồi cùng đi thôi nào.
Dialogue: 0,0:00:39.05,0:00:40.01,Default,Tom,0,0,0,,Vâng.
Dialogue: 0,0:00:40.56,0:00:41.60,Default,Tom,0,0,0,,Chúng mình cùng mỉm cười và bước đi nhé.
