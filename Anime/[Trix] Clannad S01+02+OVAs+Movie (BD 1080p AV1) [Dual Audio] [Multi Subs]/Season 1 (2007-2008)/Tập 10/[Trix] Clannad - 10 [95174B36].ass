Dialogue: 0,0:00:00.00,0:00:10.40,Default,,0,0,0,,
Dialogue: 0,0:00:10.11,0:00:12.15,Default,Robo,0,0,0,,Những đốm sáng này là gì thế?
Dialogue: 0,0:00:12.78,0:00:16.24,Default,Robo,0,0,0,,Mình chắc chắn rằng mình chưa từng thấy khung cảnh nào như thế này bao giờ.
Dialogue: 0,0:00:28.84,0:00:30.84,Default,Girl,0,0,0,,Cậu thấy những đốm sáng này kỳ lạ sao?
Dialogue: 0,0:00:33.76,0:00:34.76,Default,Girl,0,0,0,,Còn bầu trời thì sao?
Dialogue: 0,0:00:37.80,0:00:38.97,Default,Girl,0,0,0,,Còn mặt đất thì thế nào?
Dialogue: 0,0:00:41.60,0:00:43.18,Default,Girl,0,0,0,,Chỉ có những đốm sáng này thôi ư?
Dialogue: 0,0:00:46.56,0:00:48.73,Default,Girl,0,0,0,,Vì sao lại thế nhỉ?
Dialogue: 0,0:00:51.90,0:00:57.03,Default,Robo,0,0,0,,Đối với cô bé, người đã sống ở đây suốt cả cuộc đời, những đốm sáng này vốn là lẽ tự nhiên.
Dialogue: 0,0:00:59.03,0:01:01.91,Default,Robo,0,0,0,,"Chắc chắn đó là những chiếc bóng!" đó là điều tôi nghĩ.
Dialogue: 0,0:01:02.70,0:01:05.04,Default,Robo,0,0,0,,Nhưng một chiếc bóng thì luôn đi kèm với một vật thể tạo ra nó.
Dialogue: 0,0:01:05.04,0:01:08.04,Default,Robo,0,0,0,,Nếu vậy thì, vật thể đó đang ở đâu?
Dialogue: 0,0:01:09.54,0:01:10.63,Default,Girl,0,0,0,,Nói cách khác,
Dialogue: 0,0:01:11.00,0:01:15.84,Default,Girl,0,0,0,,việc cậu thấy cảnh này lạ lẫm, chứng tỏ phải có\Nmột khung cảnh nào khác mà cậu cảm thấy thân thuộc.
Dialogue: 0,0:01:18.84,0:01:21.43,Default,Robo,0,0,0,,Tôi lục tìm trong ký ức của mình.
Dialogue: 0,0:01:22.39,0:01:28.35,Default,Robo,0,0,0,,Rất lâu trước đây, tôi từng ở một thế giới khác...\Nhay có lẽ là trong một tương lai xa xôi nào đó.
Dialogue: 0,0:01:28.90,0:01:31.36,Default,Robo,0,0,0,,Tôi vẫn còn lưu giữ ký ức rằng mình đã từng ở nơi ấy.
