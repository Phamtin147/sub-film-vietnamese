Dialogue: 0,0:02:58.49,0:03:05.41,English,,0,0,0,,{\be1}Nhưng cách nàng trao tay lại có đôi phần ngang ngược ép uổng.
Dialogue: 0,0:02:59.11,0:03:02.61,Default,Fuk,0,0,0,,Fuko chỉ biến thành trẻ con đúng khoảnh khắc này thôi!
Dialogue: 0,0:03:02.91,0:03:03.95,Default,Nag,0,0,0,,Fuu-chan!
Dialogue: 0,0:03:03.95,0:03:05.16,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:03:05.16,0:03:06.79,Default,Fuk,0,0,0,,Trả lại cho Fuko mau!
Dialogue: 0,0:03:05.62,0:03:07.08,Default-alt,Oka,0,0,0,,Được rồi, tôi trả—
Dialogue: 0,0:03:06.16,0:03:09.83,Romaji,,0,0,0,,{\be1}{\K23}Su{\K14}te{\K7}p{\K19}pu {\K9}i{\K11}n {\K21}shi{\K13}te {\K12}ki{\K12}ri {\K24}ko{\K62}n{\K26}de{\K114}ku
Dialogue: 0,0:03:06.16,0:03:09.83,English,,0,0,0,,{\be1}Nhún chân lao tới và tung đòn tấn công!
Dialogue: 0,0:03:10.04,0:03:13.33,Romaji,,0,0,0,,{\be1}{\K20}Hi{\K12}t{\K29}to {\K64}& {\K36}a{\K25}we{\K38}i {\K108}de
Dialogue: 0,0:03:10.04,0:03:13.33,English,,0,0,0,,{\be1}Chiến thuật đánh nhanh rồi rút gọn!
Dialogue: 0,0:03:12.50,0:03:13.88,Default,Nag,0,0,0,,Hai người có sao không vậy?
Dialogue: 0,0:03:13.88,0:03:15.04,Default,Oka,0,0,0,,Ui da...
Dialogue: 0,0:03:14.00,0:03:17.21,Romaji,,0,0,0,,{\be1}{\K16}U{\K13}ke{\K11}to{\K9}t{\K16}ta {\K32}na{\K17}ra{\K23}ba {\K67}so{\K37}re {\K11}ga {\K29}sa{\K22}i{\K21}go
Dialogue: 0,0:03:14.00,0:03:17.21,English,,0,0,0,,{\be1}Một khi đã nhận thì không có đường lui.
Dialogue: 0,0:03:15.88,0:03:17.92,Default,Fuk,0,0,0,,Fuko chỉ làm con nít trong đúng một thoáng đó thôi nhé.
Dialogue: 0,0:03:17.21,0:03:22.26,Romaji,,0,0,0,,{\be1}{\K27}Mo{\K36}u {\K27}he{\K16}n{\K67}kya{\K25}ku {\K41}ha {\K15}u{\K10}ke{\K23}tsu{\K25}ke {\K57}ma{\K43}se{\K15}n {\K22}no{\K54}de
Dialogue: 0,0:03:17.21,0:03:22.26,English,,0,0,0,,{\be1}Bởi nàng nhất quyết không nhận đồ trả lại đâu.
Dialogue: 0,0:03:17.92,0:03:19.01,Default,Fuk,0,0,0,,Nên hãy tha thứ cho Fuko nha.
Dialogue: 0,0:03:20.01,0:03:21.55,Default,Oka,0,0,0,,Mau leo xuống khỏi người tôi đi!
Dialogue: 0,0:03:21.55,0:03:22.63,Default,Oka,0,0,0,,Nhóc nặng chết đi được!
Dialogue: 0,0:03:22.43,0:03:24.89,Romaji,,0,0,0,,{\be1}{\K14}Ka{\K22}ze {\K31}no {\K28}yo{\K14}u{\K17}ni {\K64}sa{\K22}t{\K11}ta{\K22}yo
Dialogue: 0,0:03:22.43,0:03:24.89,English,,0,0,0,,{\be1}Nàng thoắt biến đi tựa như một cơn gió.
Dialogue: 0,0:03:23.93,0:03:26.22,Default,Oka,0,0,0,,Fuko bằng tuổi tôi mà đúng không?
Dialogue: 0,0:03:25.30,0:03:31.14,Romaji,,0,0,0,,{\be1}{\K17}Ta{\K11}i{\K38}se{\K37}tsu {\K29}na {\K21}ko{\K31}to {\K17}wo {\K19}wa{\K57}su{\K26}re{\K12}te {\K5}i{\K22}ma{\K48}se{\K29}n{\K168}ka{\k1}?
Dialogue: 0,0:03:25.30,0:03:31.14,English,,0,0,0,,{\be1}Phải chăng nàng đang lãng quên điều gì quan trọng?
Dialogue: 0,0:03:26.22,0:03:27.72,Default,Oka,0,0,0,,Hành xử cho chững chạc hơn chút đi.
Dialogue: 0,0:03:27.72,0:03:30.60,Default,Fuk,0,0,0,,Anh mới là người giống trẻ con hơn nhiều đấy.
Dialogue: 0,0:03:30.60,0:03:35.06,Default,Fuk,0,0,0,,Nếu là người lớn, anh phải gọi những bạn nữ thân thiết bằng tên của họ chứ.
Dialogue: 0,0:03:35.06,0:03:38.28,Default,Oka,0,0,0,,Sao tự nhiên nhóc lại đẩy câu chuyện đi xa đến mức đó vậy?
Dialogue: 0,0:03:38.28,0:03:41.57,Default,Fuk,0,0,0,,Yusuke-san gọi Onee-chan bằng tên mà.
Dialogue: 0,0:03:41.57,0:03:44.36,Default,Fuk,0,0,0,,Và Onee-chan cũng gọi anh ấy là Yuu-kun nữa.
Dialogue: 0,0:03:44.36,0:03:45.70,Default,Fuk,0,0,0,,Họ đều là những người trưởng thành cả rồi.
Dialogue: 0,0:03:45.70,0:03:48.54,Default,Oka,0,0,0,,Tôi cũng gọi nhóc bằng tên đấy thôi, Fuko.
Dialogue: 0,0:03:48.54,0:03:51.46,Default,Fuk,0,0,0,,Người Fuko đang nói tới là Nagisa-san cơ!
Dialogue: 0,0:03:52.66,0:03:58.00,Default,Fuk,0,0,0,,Fuko thấy hai anh chị cư xử xa cách quá chừng, thân thiết thế này mà toàn gọi nhau bằng họ.
Dialogue: 0,0:03:58.00,0:04:02.13,Default,Fuk,0,0,0,,Nếu là người lớn thì anh phải gọi tên chị ấy như người lớn chứ.
Dialogue: 0,0:04:02.13,0:04:03.93,Default,Oka,0,0,0,,Nhóc nói năng chẳng có lý lẽ gì cả.
Dialogue: 0,0:04:03.93,0:04:08.39,Default,Nag,0,0,0,,Đ-Đúng thế thật. Tự nhiên em bảo thế thì...
Dialogue: 0,0:04:08.39,0:04:11.27,Default,Fuk,0,0,0,,Vậy thì thử gọi tên nhau xem nào.
Dialogue: 0,0:04:11.27,0:04:13.31,Default,Fuk,0,0,0,,Fuko nghĩ Okazaki-san nên gọi chị ấy kèm hậu tố "-chan",
Dialogue: 0,0:04:13.31,0:04:16.40,Default,Fuk,0,0,0,,còn Nagisa-san thì nên gọi anh ấy kèm hậu tố "-kun".
Dialogue: 0,0:04:17.86,0:04:19.44,Default,Fuk,0,0,0,,Chuẩn bị, bắt đầu nào!
Dialogue: 0,0:04:22.44,0:04:23.03,Default,Oka,0,0,0,,Nagi...
Dialogue: 0,0:04:24.24,0:04:26.28,Default,Nag,0,0,0,,To... Tomoya-kun...
Dialogue: 0,0:04:26.82,0:04:27.99,Default,Oka,0,0,0,,Na... Nagisa-chan...
Dialogue: 0,0:04:27.99,0:04:29.91,Default,Oka,0,0,0,,Tôi không thể nói được!
Dialogue: 0,0:04:29.91,0:04:34.33,Default,Nag,0,0,0,,Tớ cũng vậy. Ngượng ngùng quá mức chịu đựng nổi rồi.
Dialogue: 0,0:04:34.33,0:04:38.00,Default,Fuk,0,0,0,,Vậy xem như đã rõ hai anh chị còn trẻ con hơn cả Fuko nhé.
Dialogue: 0,0:04:38.00,0:04:41.17,Default,Oka,0,0,0,,Khoan đã. Ít nhất hãy cho tôi bỏ chữ "-chan" đi.
Dialogue: 0,0:04:41.17,0:04:43.47,Default,Oka,0,0,0,,Tôi vẫn gọi Kyou và Tomoyo như thế mà.
Dialogue: 0,0:04:43.47,0:04:45.09,Default,Fuk,0,0,0,,Thế thì anh thử đi.
Dialogue: 0,0:04:49.26,0:04:50.10,Default,Oka,0,0,0,,Nagisa.
Dialogue: 0,0:04:51.85,0:04:54.06,Default,Oka,0,0,0,,Ừm, thế này thấy tự nhiên dễ chịu hơn hẳn.
Dialogue: 0,0:04:54.06,0:04:56.02,Default,Nag,0,0,0,,Vâng, tớ cũng thấy vậy.
Dialogue: 0,0:04:56.40,0:05:01.57,Default,Nag,0,0,0,,Nhưng tớ cần thêm một chút thời gian nữa mới có thể gọi tên cậu được.
Dialogue: 0,0:05:01.57,0:05:03.61,Default,Fuk,0,0,0,,Fuko chấp thuận điều đó.
Dialogue: 0,0:05:03.61,0:05:05.99,Default,Oka,0,0,0,,Sao nhóc cứ làm như bà tướng vậy hả?!
Dialogue: 0,0:05:08.53,0:05:14.87,Default,Fuk,0,0,0,,Fuko yêu quý cả Nagisa-san lẫn Okazaki-san, nên Fuko mong những điều tốt đẹp nhất sẽ đến với hai người.
Dialogue: 0,0:05:15.33,0:05:17.92,Default,Fuk,0,0,0,,Giống như Onee-chan và Yusuke-san vậy.
Dialogue: 0,0:05:26.30,0:05:27.43,Default,Oka,0,0,0,,N-Này em...
Dialogue: 0,0:05:36.52,0:05:38.35,Default,Nag,0,0,0,,Xong rồi, hoàn thành rồi nhé.
Dialogue: 0,0:05:42.69,0:05:45.15,Default,Fuk,0,0,0,,Trông thế nào hả hai anh chị? Nhìn Fuko thế nào?
Dialogue: 0,0:05:45.15,0:05:47.36,Default,Oka,0,0,0,,Nhóc đội cái này hợp hơn bất kỳ ai trên khắp nước Nhật này đấy.
Dialogue: 0,0:05:47.36,0:05:48.45,Default,Oka,0,0,0,,Không còn nghi ngờ gì nữa luôn.
Dialogue: 0,0:05:48.45,0:05:51.16,Default,Nag,0,0,0,,Em dễ thương lắm, Fuu-chan.
Dialogue: 0,0:05:51.16,0:05:53.24,Default,Fuk,0,0,0,,Làm Fuko ngượng quá đi.
Dialogue: 0,0:05:58.37,0:06:00.54,Default,Fuk,0,0,0,,Fuko là số một Nhật Bản luôn!
Dialogue: 0,0:06:00.54,0:06:03.75,Default,Oka,0,0,0,,Nhóc làm trò gì mà phấn khích dữ vậy?
Dialogue: 0,0:06:03.75,0:06:05.67,Default,Oka,0,0,0,,Ngày mốt mới đến đám cưới cơ mà.
Dialogue: 0,0:06:06.17,0:06:09.80,Default,Fuk,0,0,0,,Ưm, bọn mình làm một bữa tiệc chúc mừng trước từ bây giờ không được sao ạ?
Dialogue: 0,0:06:09.80,0:06:10.97,Default,Oka,0,0,0,,Chúc mừng trước sao?
Dialogue: 0,0:06:10.97,0:06:13.10,Default,Nag,0,0,0,,Lễ cưới ấy hả?
Dialogue: 0,0:06:13.10,0:06:14.60,Default,Oka,0,0,0,,Nhân vật chính kết hôn có ở đây đâu.
Dialogue: 0,0:06:14.60,0:06:16.35,Default,Fuk,0,0,0,,Không có chị ấy thì không làm được ạ?
Dialogue: 0,0:06:17.14,0:06:19.94,Default,Nag,0,0,0,,Tớ nghĩ là được chứ.
Dialogue: 0,0:06:19.94,0:06:22.40,Default,Nag,0,0,0,,Chỉ ba chúng mình cùng chúc mừng với nhau đi.
Dialogue: 0,0:06:23.61,0:06:24.86,Default,Oka,0,0,0,,Ừm.
Dialogue: 0,0:06:24.86,0:06:26.86,Default,Oka,0,0,0,,Có một máy bán nước tự động ở tầng một đấy.
Dialogue: 0,0:06:26.86,0:06:29.28,Default,Oka,0,0,0,,Và tôi chắc trong phòng kinh tế gia đình ít nhất cũng có diêm quẹt.
Dialogue: 0,0:06:36.91,0:06:38.54,Default,Fuk,0,0,0,,Tuyệt nhất trần đời luôn!
Dialogue: 0,0:06:38.54,0:06:42.75,Default,Oka,0,0,0,,Tôi cá là nhóc chỉ muốn đội cái đó trên đầu để quậy thôi chứ gì.
Dialogue: 0,0:06:42.75,0:06:45.59,Default,Fuk,0,0,0,,Tuyệt đối không có chuyện đó đâu nha!
Dialogue: 0,0:06:50.05,0:06:52.51,Default,Fuk,0,0,0,,Nào mọi người ơi. Xin mời gửi lời chúc tụng đi ạ.
Dialogue: 0,0:06:53.05,0:06:55.26,Default,Fuk,0,0,0,,Onee-chan, em chúc mừng chị!
Dialogue: 0,0:06:55.26,0:06:57.22,Default,Oka,0,0,0,,Cô Kouko, em chúc mừng cô!
Dialogue: 0,0:06:57.22,0:06:59.39,Default,Nag,0,0,0,,Cô giáo Ibuki, em chúc mừng cô!
Dialogue: 0,0:07:08.36,0:07:10.95,Default,Fuk,0,0,0,,Tai Fuko cứ lùng bùng hết cả lên.
Dialogue: 0,0:07:10.95,0:07:13.62,Default,Oka,0,0,0,,Fuko, đầu nhóc dính sợi ruy băng kìa.
Dialogue: 0,0:07:14.41,0:07:17.41,Default,Nag,0,0,0,,Ưm, Okazaki-san cũng dính nữa này.
Dialogue: 0,0:07:17.41,0:07:19.54,Default,Oka,0,0,0,,Chỗ này à?
Dialogue: 0,0:07:19.54,0:07:21.79,Default,Oka,0,0,0,,Nagisa, cậu cũng dính này.
Dialogue: 0,0:07:22.54,0:07:23.50,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:07:39.81,0:07:41.89,Default,Oka,0,0,0,,Nhóc có thấy lạnh không, Fuko?
Dialogue: 0,0:07:41.89,0:07:43.81,Default,Nag,0,0,0,,Tất cả chúng ta cùng xích lại gần nhau đi.
Dialogue: 0,0:07:43.81,0:07:47.02,Note,,0,0,0,,{\an8\fs36\i1}*Oshikura Manju: Trò chơi trẻ em Nhật Bản quây quần ép sát vào nhau để giữ ấm.
Dialogue: 0,0:07:43.81,0:07:47.11,Default,Nag,0,0,0,,Sẽ ấm áp hệt như lúc chơi Oshikura Manju vậy.
Dialogue: 0,0:07:47.11,0:07:48.82,Default,Nag,0,0,0,,Sẽ giống như Đại Gia Đình Dango vậy đó.
Dialogue: 0,0:07:53.70,0:07:57.16,Default,Oka,0,0,0,,Làm thế này trông chúng ta thực sự giống một gia đình ghê.
Dialogue: 0,0:07:57.16,0:07:58.54,Default,Nag,0,0,0,,Cậu nói đúng đấy.
Dialogue: 0,0:08:31.65,0:08:33.61,Default,Oka,0,0,0,,Fu-Furukawa...
Dialogue: 0,0:08:37.87,0:08:42.04,Default,Oka,0,0,0,,Gì thế này? Sao tớ lại ngủ gật ở một nơi như thế này chứ?
Dialogue: 0,0:08:42.04,0:08:43.79,Default,Nag,0,0,0,,Okazaki-san?
Dialogue: 0,0:08:45.67,0:08:46.42,Default,Nag,0,0,0,,Chuyện này là...
Dialogue: 0,0:08:51.13,0:08:54.63,Default,Oka,0,0,0,,Đêm qua chúng mình ngủ lại ở trường sao?
Dialogue: 0,0:08:54.63,0:08:57.01,Default,Nag,0,0,0,,D-Dường như là vậy...
Dialogue: 0,0:08:58.43,0:09:03.23,Default,Oka,0,0,0,,Có phải tụi mình mệt quá ngủ thiếp đi trong lúc nghĩ cách tái lập câu lạc bộ kịch không?
Dialogue: 0,0:09:03.23,0:09:07.23,Default,Nag,0,0,0,,Nghe cậu nói thì tớ cũng cảm thấy mang máng là vậy...
Dialogue: 0,0:09:07.23,0:09:09.02,Default,Nag,0,0,0,,Nhưng khung cảnh xung quanh đây đâu giống như thế.
Dialogue: 0,0:09:12.48,0:09:14.69,Default,Nag,0,0,0,,Con xin lỗi vì đã ngủ qua đêm bên ngoài mà không báo trước ạ!
Dialogue: 0,0:09:14.69,0:09:16.99,Default,Oka,0,0,0,,Có vẻ như bọn cháu đã ngủ quên mất lúc nào không hay.
Dialogue: 0,0:09:19.32,0:09:21.54,Default,Aki,0,0,0,,Mấy đứa tưởng cái cớ đó mà lọt tai được à?!
Dialogue: 0,0:09:21.54,0:09:22.70,Default,San,0,0,0,,Bác Akio!
Dialogue: 0,0:09:22.70,0:09:23.83,Default,Nag,0,0,0,,Bố!
Dialogue: 0,0:09:23.83,0:09:26.96,Default,Aki,0,0,0,,...Đáng lẽ ra bố phải gầm lên như thế.
Dialogue: 0,0:09:27.33,0:09:32.42,Default,Aki,0,0,0,,Nhưng hình như bố nhớ là con gái bố đã nói trước sẽ ngủ lại bên ngoài rồi thì phải.
Dialogue: 0,0:09:33.00,0:09:34.55,Default,San,0,0,0,,Mẹ cũng vậy.
Dialogue: 0,0:09:34.55,0:09:39.76,Default,San,0,0,0,,Mẹ nhớ là con đã bảo có một việc rất quan trọng cần phải làm nên không thể về nhà được.
Dialogue: 0,0:09:39.76,0:09:43.47,Default,Oka,0,0,0,,Dạ, bố mẹ có nhớ việc đó là "việc gì" không ạ?
Dialogue: 0,0:09:44.60,0:09:48.27,Default,San,0,0,0,,Lạ thật đấy, bố chẳng tài nào nhớ nổi.
Dialogue: 0,0:09:50.73,0:09:53.48,Default,Aki,0,0,0,,Càng nghĩ lại càng bực cả mình.
Dialogue: 0,0:09:53.48,0:09:54.44,Default,Aki,0,0,0,,Chết tiệt thật chứ!
Dialogue: 0,0:09:56.24,0:09:59.91,Default,Oka,0,0,0,,Không phải hùa theo ông già đâu,\Nnhưng cháu cũng thấy trong lòng bức bối khó chịu lắm.
Dialogue: 0,0:10:01.24,0:10:06.45,Default,Oka,0,0,0,,Cháu cứ có cảm giác điều mình không thể nhớ ra là một việc vô cùng quan trọng.
Dialogue: 0,0:10:07.12,0:10:10.13,Default,Nag,0,0,0,,Okazaki-san, cậu xem cái này đi.
Dialogue: 0,0:10:12.13,0:10:15.05,Default,Oka,0,0,0,,Trong phòng sinh hoạt câu lạc bộ cũng có một cái giống hệt thế này đúng không?
Dialogue: 0,0:10:15.05,0:10:17.42,Default,Nag,0,0,0,,Trong phòng tớ cũng có một cái nữa.
Dialogue: 0,0:10:17.42,0:10:20.93,Default,Nag,0,0,0,,Dù tớ chẳng thể nhớ nổi mình đã lấy nó từ đâu ra.
Dialogue: 0,0:10:21.93,0:10:24.01,Default,Nag,0,0,0,,Nhưng khi nhìn vào nó, lòng tớ lại thấy bình yên đến lạ.
Dialogue: 0,0:10:24.85,0:10:27.68,Default,Nag,0,0,0,,Cậu có cảm giác giống như vậy không?
Dialogue: 0,0:10:40.24,0:10:42.45,Default,Kyo,0,0,0,,Cậu đứng thẫn thờ làm gì ở đó thế?
Dialogue: 0,0:10:44.16,0:10:46.08,Default,Oka,0,0,0,,Tôi đang cố nhớ lại một việc.
Dialogue: 0,0:10:46.08,0:10:48.37,Default,Kyo,0,0,0,,"Một việc"? Việc gì cơ?
Dialogue: 0,0:10:48.37,0:10:51.08,Default,Oka,0,0,0,,Tôi cũng không rõ nữa.
Dialogue: 0,0:10:51.88,0:10:54.13,Default,Kyo,0,0,0,,À, hóa ra là cậu rảnh rỗi quá chứ gì.
Dialogue: 0,0:10:54.13,0:10:56.96,Default,Kyo,0,0,0,,Thế thì mai đi chơi với tôi đi. Mai là Chủ nhật mà.
Dialogue: 0,0:10:56.96,0:10:59.09,Default,Kyo,0,0,0,,Tôi định đi mua sắm cùng với Ryou.
Dialogue: 0,0:10:59.51,0:11:00.63,Default,Oka,0,0,0,,Ngày mai...
Dialogue: 0,0:11:01.13,0:11:04.39,Default,Oka,0,0,0,,Tôi nghĩ là ngày mai mình đã có lịch hẹn chuyện gì rồi thì phải.
Dialogue: 0,0:11:04.80,0:11:06.93,Default,Kyo,0,0,0,,Cậu từ chối kiểu mập mờ mơ hồ gì thế hả?
Dialogue: 0,0:11:06.93,0:11:09.06,Default,Oka,0,0,0,,Tôi không có ý từ chối cậu.
Dialogue: 0,0:11:09.06,0:11:13.52,Default,Oka,0,0,0,,Thực lòng tôi cảm thấy ngày mai mình có một việc nhất định phải làm.
Dialogue: 0,0:11:13.52,0:11:16.11,Default,Oka,0,0,0,,Một việc cực kỳ quan trọng.
Dialogue: 0,0:11:19.11,0:11:21.61,Default,Oka,0,0,0,,Ra vậy, cậu cũng thấy thế à.
Dialogue: 0,0:11:21.61,0:11:26.91,Default,Nag,0,0,0,,Vâng. Tớ cũng cảm thấy ngày mai có một chuyện quan trọng cần phải làm.
Dialogue: 0,0:11:28.41,0:11:30.50,Default,Oka,0,0,0,,Chắc chắn ngày mai sẽ có một sự kiện gì đó diễn ra.
Dialogue: 0,0:11:31.04,0:11:32.71,Default,Oka,0,0,0,,Chúng ta hãy cùng nhớ lại xem đó là việc gì đi.
Dialogue: 0,0:11:36.96,0:11:38.00,Default,Nag,0,0,0,,Thầy Koumura.
Dialogue: 0,0:11:38.67,0:11:40.67,Default,Nag,0,0,0,,Thầy đang làm gì thế ạ?
Dialogue: 0,0:11:40.67,0:11:42.47,Default,Kou,0,0,0,,Mấy đứa nhìn mà không nhận ra sao?
Dialogue: 0,0:11:44.68,0:11:46.64,Default,Oka,0,0,0,,Có ai đó sắp làm đám cưới ạ?
Dialogue: 0,0:11:47.81,0:11:49.60,Default,Kou,0,0,0,,Câu hỏi kỳ lạ thật đấy.
Dialogue: 0,0:11:51.10,0:11:54.31,Default,Kou,0,0,0,,Mới ngần này tuổi đầu mà mấy đứa đã mắc chứng đãng trí rồi à?
Dialogue: 0,0:11:54.31,0:11:56.65,Default,Oka,0,0,0,,Bị thầy nói vậy nghe tủi thân thật đấy ạ.
Dialogue: 0,0:11:57.27,0:11:59.73,Default,Kou,0,0,0,,Nhìn cho kỹ vào rồi tự mình nhớ lại đi.
Dialogue: 0,0:12:06.53,0:12:07.95,Default,Oka,0,0,0,,Cô Kouko!
Dialogue: 0,0:12:07.95,0:12:09.54,Default,Nag,0,0,0,,Cô giáo Ibuki!
Dialogue: 0,0:12:10.08,0:12:15.63,Default,Kou,0,0,0,,Cô ấy tổ chức lễ cưới ở trường ngày mai là nhờ có hai đứa đứng ra đề xuất đấy.
Dialogue: 0,0:12:15.63,0:12:17.84,Default,Oka,0,0,0,,Phải rồi. Đúng là thế thật.
Dialogue: 0,0:12:17.84,0:12:21.05,Default,Nag,0,0,0,,Sao bọn mình lại có thể quên đi một việc trọng đại dường này cơ chứ?
Dialogue: 0,0:12:21.05,0:12:25.89,Default,Oka,0,0,0,,Furukawa, vì sao tớ lại muốn chúc mừng đám cưới của cô Kouko đến thế nhỉ?
Dialogue: 0,0:12:25.89,0:12:28.05,Default,Kou,0,0,0,,Đó lại là một câu hỏi kỳ lạ nữa rồi.
Dialogue: 0,0:12:28.35,0:12:31.47,Default,Kou,0,0,0,,Đương nhiên là vì cả hai đứa đều quen biết cô ấy đủ thân để chúc mừng rồi.
Dialogue: 0,0:12:32.85,0:12:37.77,Default,Nag,0,0,0,,Tớ nhớ chính tớ là người đã giới thiệu Okazaki-san với cô giáo Ibuki.
Dialogue: 0,0:12:38.19,0:12:45.11,Default,Nag,0,0,0,,Nhưng tớ nghĩ hình như còn có một người nữa đã kết nối tất cả chúng ta lại.
Dialogue: 0,0:12:45.57,0:12:46.57,Default,Oka,0,0,0,,Một người nữa...
Dialogue: 0,0:12:47.16,0:12:51.79,Default,Kou,0,0,0,,Liệu có phải là em gái của cô giáo Ibuki không?
Dialogue: 0,0:12:51.79,0:12:52.79,Default,Oka,0,0,0,,Em gái cô ấy sao?
Dialogue: 0,0:12:54.83,0:12:56.29,Default,Kou,0,0,0,,Hẹn gặp lại mấy đứa sau nhé.
Dialogue: 0,0:12:59.38,0:13:01.92,Default,Nag,0,0,0,,Em gái của cô giáo Ibuki...
Dialogue: 0,0:13:04.67,0:13:05.51,Default,Nag,0,0,0,,Fuuko-chan!
Dialogue: 0,0:13:05.51,0:13:07.89,Default,Oka,0,0,0,,Đúng rồi! Là Fuko!
Dialogue: 0,0:13:09.39,0:13:10.47,Default,Oka,0,0,0,,Em...
Dialogue: 0,0:13:10.47,0:13:11.35,Default,Nag,0,0,0,,Fuu-chan...
Dialogue: 0,0:13:12.68,0:13:15.39,Default,Oka,0,0,0,,Em đã đứng cạnh bọn anh suốt từ nãy đến giờ sao?
Dialogue: 0,0:13:15.81,0:13:16.35,Default,Fuk,0,0,0,,Dạ vâng.
Dialogue: 0,0:13:18.31,0:13:20.52,Default,Oka,0,0,0,,Chị tệ quá đúng không em?
Dialogue: 0,0:13:20.90,0:13:23.99,Default,Oka,0,0,0,,Chị đã cố hết sức để không quên em, thế mà...
Dialogue: 0,0:13:23.99,0:13:25.95,Default,Fuk,0,0,0,,Chị không tệ một chút nào đâu ạ.
Dialogue: 0,0:13:25.95,0:13:27.36,Default,Fuk,0,0,0,,Đó là quy luật tự nhiên thôi mà.
Dialogue: 0,0:13:30.03,0:13:32.91,Default,Nag,0,0,0,,Đừng nói những lời đau lòng như thế chứ em.
Dialogue: 0,0:13:33.83,0:13:36.71,Default,Oka,0,0,0,,Bọn chị lúc nào cũng muốn ở bên em.
Dialogue: 0,0:13:37.00,0:13:39.54,Default,Nag,0,0,0,,Chúng ta hãy luôn ở bên nhau nhé, Fuu-chan.
Dialogue: 0,0:13:39.54,0:13:42.38,Default,Nag,0,0,0,,Bọn này sẽ ở bên nhóc cho đến khi đám cưới diễn ra.
Dialogue: 0,0:13:43.80,0:13:44.67,Default,Fuk,0,0,0,,Dạ vâng!
Dialogue: 0,0:13:52.10,0:13:56.43,Default,Woman,0,0,0,,Thật may là thời tiết hôm nay đẹp quá.
Dialogue: 0,0:13:56.43,0:14:00.81,Default,Man,0,0,0,,Nghe nói nguyện vọng của cô dâu là muốn tổ chức buổi lễ tại ngôi trường này đấy.
Dialogue: 0,0:14:01.94,0:14:04.90,Default,Nag,0,0,0,,Có vẻ như không có học sinh nào đến dự cả.
Dialogue: 0,0:14:04.90,0:14:08.53,Default,Fuk,0,0,0,,Nhưng có Okazaki-san và Nagisa-san ở đây rồi mà.
Dialogue: 0,0:14:16.50,0:14:19.71,Default,Father,0,0,0,,Chiếc nhẫn mang hai tầng ý nghĩa.
Dialogue: 0,0:14:20.08,0:14:21.84,Default,Father,0,0,0,,Thứ nhất: Sự vĩnh cửu.
Dialogue: 0,0:14:21.84,0:14:23.67,Default,Father,0,0,0,,Thứ hai: Sự vẹn tròn.
Dialogue: 0,0:14:24.38,0:14:31.68,Default,Father,0,0,0,,Bằng việc trao nhẫn cho nhau, hai con nguyện thề sẽ mãi mãi thủy chung suốt trọn cuộc đời.
Dialogue: 0,0:14:32.14,0:14:35.10,Default,Father,0,0,0,,Giờ thì, hãy lặp lại theo lời tôi.
Dialogue: 0,0:14:35.93,0:14:38.10,Default,Father,0,0,0,,Chiếc nhẫn này...
Dialogue: 0,0:14:38.69,0:14:41.73,Default,Yos,0,0,0,,...Anh trao cho em làm minh chứng...
Dialogue: 0,0:14:42.36,0:14:44.36,Default,Yos,0,0,0,,...Cho tình yêu vĩnh hằng anh dành cho em.
Dialogue: 0,0:14:49.11,0:14:50.61,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:14:50.61,0:14:51.95,Default,Nag,0,0,0,,Cậu định đi đâu thế?!
Dialogue: 0,0:14:51.95,0:14:54.08,Default,Oka,0,0,0,,Chúng ta sẽ ra cổng chính đón hai người họ!
Dialogue: 0,0:14:54.08,0:14:56.74,Default,Oka,0,0,0,,Chúng ta sẽ tiễn họ bằng giọng nói to vang hơn bất kỳ ai khác.
Dialogue: 0,0:14:56.74,0:14:57.95,Default,Oka,0,0,0,,Đúng không hả Fuko?
Dialogue: 0,0:14:58.96,0:14:59.46,Default,Fuk,0,0,0,,Dạ vâng!
Dialogue: 0,0:15:03.59,0:15:05.13,Default,Nag,0,0,0,,Okazaki-san...
Dialogue: 0,0:15:05.13,0:15:05.96,Default,Nag,0,0,0,,Chuyện gì thế này?
Dialogue: 0,0:15:13.68,0:15:15.51,Default,Bot,0,0,0,,Puhi! Puhi! Puhi!
Dialogue: 0,0:15:15.51,0:15:16.97,Default,Bot,0,0,0,,Puhi! Puhi!
Dialogue: 0,0:15:16.97,0:15:17.81,Default,Oka,0,0,0,,Kyou.
Dialogue: 0,0:15:18.14,0:15:19.35,Default,Oka,0,0,0,,Fujibayashi.
Dialogue: 0,0:15:20.06,0:15:23.44,Default,Oka,0,0,0,,Tôi tưởng hai cậu đi mua sắm rồi chứ.
Dialogue: 0,0:15:22.48,0:15:23.44,Default-alt,Bot,0,0,0,,Puhi! Puhi!
Dialogue: 0,0:15:23.44,0:15:24.23,Default,Kyo,0,0,0,,Thì...
Dialogue: 0,0:15:24.69,0:15:27.03,Default,Kyo,0,0,0,,Bọn tôi cũng định thế...
Dialogue: 0,0:15:27.03,0:15:28.03,Default,Kyo,0,0,0,,Đúng không chị?
Dialogue: 0,0:15:28.03,0:15:33.57,Default,Ryo,0,0,0,,Sáng nay nhìn thấy cái này,\Ntôi lại nhớ ra về đám cưới.
Dialogue: 0,0:15:33.57,0:15:37.16,Default,Ryo,0,0,0,,Nên tôi thấy mình phải đến đây để chúc mừng mới được.
Dialogue: 0,0:15:37.58,0:15:38.12,Default,Sun,0,0,0,,Yo.
Dialogue: 0,0:15:38.12,0:15:39.50,Default,Oka,0,0,0,,Sunohara!
Dialogue: 0,0:15:39.50,0:15:41.37,Default,Nag,0,0,0,,Mày cũng đến à.
Dialogue: 0,0:15:41.37,0:15:43.63,Default,Sun,0,0,0,,Tại tao cũng đang rảnh rỗi mà.
Dialogue: 0,0:15:44.13,0:15:46.13,Default,Sun,0,0,0,,Và nhìn đằng kia kìa.
Dialogue: 0,0:15:55.64,0:15:58.26,Default,Nag,0,0,0,,Bố. Mẹ.
Dialogue: 0,0:15:58.26,0:16:01.14,Default,Aki,0,0,0,,Bố mẹ đoán chắc con gái rượu cũng đang ở đây.
Dialogue: 0,0:16:01.14,0:16:02.02,Default,San,0,0,0,,Đúng thế thật.
Dialogue: 0,0:16:02.02,0:16:07.40,Default,San,0,0,0,,Chắc đầu óc có vấn đề rồi mới\Nquên bẵng đám cưới cho tới tận ngày hôn lễ thế này.
Dialogue: 0,0:16:13.11,0:16:14.24,Default,Oka,0,0,0,,Mọi người đã thấu cảm rồi đấy.
Dialogue: 0,0:16:14.53,0:16:16.20,Default,Oka,0,0,0,,Tấm lòng của nhóc!
Dialogue: 0,0:16:16.20,0:16:18.24,Default,Oka,0,0,0,,Đã được gieo mầm sâu đậm trong lòng tất cả mọi người!
Dialogue: 0,0:16:21.83,0:16:23.62,Default,Fuk,0,0,0,,Thật không thể tin nổi...
Dialogue: 0,0:16:24.25,0:16:25.67,Default,Oka,0,0,0,,Chị mừng cho em lắm.
Dialogue: 0,0:16:25.67,0:16:26.88,Default,Fuk,0,0,0,,Vâng ạ.
Dialogue: 0,0:16:31.46,0:16:33.09,Default,Boy,0,0,0,,Chúc mừng hai anh chị!
Dialogue: 0,0:16:40.26,0:16:41.43,Default,Fuk,0,0,0,,Okazaki-san.
Dialogue: 0,0:16:42.64,0:16:47.44,Default,Fuk,0,0,0,,Anh có còn nhớ giấc mơ mà Fuko từng mơ về anh không, Okazaki-san?
Dialogue: 0,0:16:47.44,0:16:48.44,Default,Oka,0,0,0,,Giấc mơ sao?
Dialogue: 0,0:16:48.44,0:16:50.32,Default,Fuk,0,0,0,,Giấc mơ về Lễ Hội Sao Biển ấy.
Dialogue: 0,0:16:50.90,0:16:56.32,Default,Fuk,0,0,0,,Khi Fuko chơi một mình trên bờ biển, anh đã nắm lấy tay Fuko.
Dialogue: 0,0:16:57.32,0:17:01.70,Default,Fuk,0,0,0,,Và bảo rằng: "Nhóc làm gì một mình ở đây thế? Hôm nay là Lễ Hội Sao Biển cơ mà."
Dialogue: 0,0:17:02.12,0:17:07.29,Default,Fuk,0,0,0,,Những ngày tháng sau khi được gặp anh và Nagisa-san thực sự rất giống như một lễ hội vậy.
Dialogue: 0,0:17:07.67,0:17:11.46,Default,Fuk,0,0,0,,Hai anh chị lúc nào cũng dẫn Fuko đến những nơi tràn ngập niềm vui.
Dialogue: 0,0:17:12.13,0:17:16.47,Default,Fuk,0,0,0,,Ngày nào cũng rộn rã như hội hè, và Fuko đã thấy hạnh phúc biết bao.
Dialogue: 0,0:17:16.93,0:17:21.56,Default,Fuk,0,0,0,,Fuko cảm ơn hai anh chị nhiều lắm. Fuko đã có khoảng thời gian tuyệt vời nhất trần đời.
Dialogue: 0,0:17:31.07,0:17:32.19,Default,Ibu,0,0,0,,Okazaki-san.
Dialogue: 0,0:17:32.19,0:17:33.15,Default,Ibu,0,0,0,,Nagisa-chan.
Dialogue: 0,0:17:34.74,0:17:35.82,Default,Oka,0,0,0,,Cô Kouko.
Dialogue: 0,0:17:37.53,0:17:38.99,Default,Ibu,0,0,0,,Có chuyện gì thế em?
Dialogue: 0,0:17:39.66,0:17:41.49,Default,Ibu,0,0,0,,Trông em có vẻ buồn.
Dialogue: 0,0:17:45.20,0:17:47.00,Default,Oka,0,0,0,,Xin cô hãy lắng nghe em nói, cô Kouko.
Dialogue: 0,0:17:47.00,0:17:50.50,Default,Oka,0,0,0,,Đã có một người khao khát được nhìn thấy khung cảnh này xiết bao.
Dialogue: 0,0:17:51.38,0:17:54.30,Default,Oka,0,0,0,,Đã có một người dốc hết tâm sức vì ngày hôm nay.
Dialogue: 0,0:17:55.34,0:17:59.76,Default,Oka,0,0,0,,Có một người đã thu nhận tất cả những lời chúc phúc này dành tặng cô.
Dialogue: 0,0:18:00.64,0:18:06.77,Default,Oka,0,0,0,,Bọn em yêu quý người ấy. Bọn em thực sự yêu quý người ấy vô cùng, nên là...
Dialogue: 0,0:18:10.98,0:18:16.03,Default,Ibu,0,0,0,,Có phải hai em đã ở bên con bé suốt bấy lâu nay không?
Dialogue: 0,0:18:16.49,0:18:19.49,Default,Oka,0,0,0,,Bọn em ở bên em ấy là vì những ngày tháng ấy thực sự rất vui vẻ.
Dialogue: 0,0:18:19.91,0:18:21.28,Default,Oka,0,0,0,,Chỉ đơn giản vậy thôi ạ.
Dialogue: 0,0:18:21.74,0:18:24.33,Default,Oka,0,0,0,,Và tất cả mọi người tề tựu ở đây cũng đều như vậy cả.
Dialogue: 0,0:18:25.70,0:18:26.95,Default,Oka,0,0,0,,Vì thế cô Kouko ơi!
Dialogue: 0,0:18:27.50,0:18:31.71,Default,Oka,0,0,0,,Xin cô hãy sống thật hạnh phúc, cho cả phần của em ấy nữa nhé!
Dialogue: 0,0:18:40.51,0:18:41.26,Default,Kou,0,0,0,,Ừ, cô hứa.
Dialogue: 0,0:18:54.57,0:19:05.49,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}{\K20}The {\K169}place {\K50}chan{\K48}ges {\K34}and {\K176}goes.{\K35} {\K39}Like {\K41}a {\K158}wind,{\K35} {\K79}like {\K184}clouds,
Dialogue: 0,0:19:05.49,0:19:19.17,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Nơi chốn ấy cứ đổi thay rồi trôi xa. Tựa làn gió, ngỡ áng mây trôi,
Dialogue: 0,0:19:09.46,0:19:11.92,Default,Fuk,0,0,0,,Em chúc mừng Onee-chan.
Dialogue: 0,0:19:14.50,0:19:18.13,Default,Fuk,0,0,0,,Chị hãy... Hãy sống một cuộc đời thật ngập tràn hạnh phúc nhé!
Dialogue: 0,0:19:19.51,0:19:20.51,Default,Fuk,0,0,0,,Chị hãy...
Dialogue: 0,0:19:20.01,0:19:30.35,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Tựa những vết hằn sâu trong tim, chẳng hề ngơi nghỉ nơi đâu.
Dialogue: 0,0:19:21.59,0:19:24.35,Default,Fuk,0,0,0,,Hãy sống thật hạnh phúc mãi mãi về sau nhé chị.
Dialogue: 0,0:19:24.97,0:19:26.39,Default,Kou,0,0,0,,Fuu-chan?
Dialogue: 0,0:19:30.60,0:19:43.61,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Nơi chốn ấy xa xôi diệu vợi, cách trở ngút ngàn đôi bờ.
Dialogue: 0,0:19:45.45,0:19:56.09,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Bàn tay con người khôn xiết với tới, đành ngước nhìn trong tôn kính.
Dialogue: 0,0:19:47.12,0:19:50.37,Default,Kou,0,0,0,,Fuu-chan vừa nói chúc mừng em.
Dialogue: 0,0:19:50.79,0:19:54.63,Default,Kou,0,0,0,,Con bé cầu chúc em sẽ mãi mãi được hạnh phúc.
Dialogue: 0,0:19:55.79,0:20:00.17,Default,Kou,0,0,0,,Em nghĩ con bé đã gửi lời chúc phúc từ trong giấc mơ của mình.
Dialogue: 0,0:19:56.46,0:20:09.14,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Chúng ta rồi sẽ đánh mất nơi ấy, chốn cao vời vợi đổi thay.
Dialogue: 0,0:20:00.84,0:20:02.68,Default,Kou,0,0,0,,Và điều đó đã chạm tới trái tim em.
Dialogue: 0,0:20:05.05,0:20:09.52,Default,Kou,0,0,0,,Chỉ cần chúng ta luôn trân trọng những cảm xúc hạnh phúc này...
Dialogue: 0,0:20:09.68,0:20:20.99,Kara-Ins2,,0,0,0,,{\fad(0,300)\be1}Dẫu chẳng được vẹn tròn như ý nguyện. Thế nhưng, ta sẽ chẳng bao giờ buồn đau.
Dialogue: 0,0:20:10.06,0:20:13.52,Default,Kou,0,0,0,,...thì em tin chắc con bé cũng sẽ tìm thấy hạnh phúc.
Dialogue: 0,0:20:14.48,0:20:17.15,Default,Kou,0,0,0,,Giờ đây em thực lòng tin là như vậy.
Dialogue: 0,0:20:21.34,0:20:23.34,Kara-Ins2,,0,0,0,,
Dialogue: 0,0:20:21.49,0:20:26.78,Default,Kyo,0,0,0,,Này, cậu có nghe lời đồn về cô bé gặp tai nạn hai năm trước giờ vẫn đang hôn mê chưa?
Dialogue: 0,0:20:26.78,0:20:31.45,Default,Ryo,0,0,0,,Nghe bảo em ấy là em gái của cô giáo Ibuki vừa tổ chức đám cưới hôm nọ đấy.
Dialogue: 0,0:20:31.83,0:20:34.92,Default,Ryo,0,0,0,,Nghe nói em ấy cũng đáng yêu lắm.
Dialogue: 0,0:20:35.71,0:20:38.46,Default,Sun,0,0,0,,Ai bảo thế?
Dialogue: 0,0:20:38.46,0:20:40.21,Default,Kyo,0,0,0,,Chỉ là tin đồn thôi.
Dialogue: 0,0:20:40.59,0:20:43.72,Default,Kyo,0,0,0,,Nhưng cậu không cảm thấy đúng là như thế sao?
Dialogue: 0,0:20:43.72,0:20:48.93,Default,Kyo,0,0,0,,Rằng em ấy vừa dễ thương, vừa ngây thơ chân thành,\Nvà lúc nào cũng chạy lăng xăng khắp trường.
Dialogue: 0,0:20:51.89,0:20:53.60,Default,Sun,0,0,0,,Ừ, nghe tả thấy đúng thật đấy.
Dialogue: 0,0:20:53.60,0:20:54.89,Default,Kyo,0,0,0,,Đúng không nào?
Dialogue: 0,0:20:56.90,0:21:00.69,Default,Kyo,0,0,0,,Này, tớ tò mò chuyện này mãi rồi, cái kia là gì thế?
Dialogue: 0,0:21:00.69,0:21:03.44,Default,Sun,0,0,0,,Cái này á? Một ngày nọ tớ thấy nó trong phòng mình.
Dialogue: 0,0:21:03.82,0:21:06.78,Default,Sun,0,0,0,,Tớ chẳng nhớ nổi mình kiếm nó từ đâu ra nữa.
Dialogue: 0,0:21:07.41,0:21:09.78,Default,Sun,0,0,0,,Nhưng đây chính là "cái đó" đúng không?
Dialogue: 0,0:21:10.45,0:21:11.16,Default,2,0,0,0,,Phải rồi.
Dialogue: 0,0:21:11.66,0:21:13.83,Default,Kyo,0,0,0,,Đúng là "cái đó".
Dialogue: 0,0:21:13.83,0:21:14.83,Default,All,0,0,0,,Sao biển!
Dialogue: 0,0:21:19.21,0:21:22.46,Default,Nag,0,0,0,,Nhưng sao bọn mình lại biết được nhỉ?
Dialogue: 0,0:21:23.55,0:21:27.59,Default,Kyo,0,0,0,,Này cậu kia! Đừng có ngủ nữa, vào tham gia nói chuyện đi chứ.
Dialogue: 0,0:21:27.59,0:21:28.76,Default,Kyo,0,0,0,,Tomoya!
Dialogue: 0,0:21:28.76,0:21:30.18,Default,Kyo,0,0,0,,Này! Dậy mau lên!
Dialogue: 0,0:21:30.18,0:21:34.93,Default,Oka,0,0,0,,Từ lúc nào không hay, cả ngôi trường đều xôn xao những lời đồn về cô bé ấy.
Dialogue: 0,0:21:35.69,0:21:40.90,Default,Oka,0,0,0,,Rằng em ấy vô tư trong sáng, chân thành,\Nvà lúc nào cũng chạy khắp sân trường.
Dialogue: 0,0:21:41.73,0:21:43.73,Default,Oka,0,0,0,,Hình bóng về một cô bé như thế.
Dialogue: 0,0:21:45.36,0:21:48.61,Default,Oka,0,0,0,,Và từ lúc nào không hay, tất cả mọi người đều đang ngóng chờ...
Dialogue: 0,0:21:49.24,0:21:51.41,Default,Oka,0,0,0,,...ngày mà cô bé ấy thức giấc.
Dialogue: 0,0:21:52.41,0:21:54.91,Default,Oka,0,0,0,,Chắc chắn tôi cũng là một trong số họ.
Dialogue: 0,0:21:55.45,0:21:58.54,Default,Oka,0,0,0,,Và rồi cuối cùng, ngày đó cũng sẽ đến.
Dialogue: 0,0:22:00.08,0:22:02.30,Default,Fuk,0,0,0,,Nếu... nếu anh chị không chê...
Dialogue: 0,0:22:02.88,0:22:06.05,Default,Fuk,0,0,0,,Xin hãy làm bạn với Fuko nhé!
