Dialogue: 0,0:00:00.00,0:00:00.00,Default,Nag,0,0,0,,
Dialogue: 0,0:00:12.86,0:00:15.11,Default-alt,All,0,0,0,,Hitotsu hegi hegi ni hegigoshi hachikami.
Dialogue: 0,0:00:15.11,0:00:17.03,Default-alt,All,0,0,0,,Bongame, bongome, bongomou.
Dialogue: 0,0:00:17.03,0:00:19.62,Default-alt,All,0,0,0,,Tsumitate tsumi mame tsumi sanshou.
Dialogue: 0,0:00:19.62,0:00:21.29,Default-alt,All,0,0,0,,Choshadan no chashoujyou.
Dialogue: 0,0:00:21.29,0:00:23.79,Default-alt,All,0,0,0,,Okome no namagami. Ohome no namakami.
Dialogue: 0,0:00:23.79,0:00:25.92,Default-alt,All,0,0,0,,Konkogome no namakakami.
Dialogue: 0,0:00:25.92,0:00:26.42,Default-alt,All,0,0,0,,Shusu. {\alpha&HFF}Hisuzu. Shusu. Shuchin.
Dialogue: 0,0:00:26.42,0:00:26.92,Default-alt,All,0,0,0,,Shusu. Hisuzu. {\alpha&HFF}Shusu. Shuchin.
Dialogue: 0,0:00:26.92,0:00:27.42,Default-alt,All,0,0,0,,Shusu. Hisuzu. Shusu. {\alpha&HFF}Shuchin.
Dialogue: 0,0:00:27.42,0:00:27.92,Default-alt,All,0,0,0,,Shusu. Hisuzu. Shusu. Shuchin.
Dialogue: 0,0:00:27.92,0:00:28.93,Default-alt,All,0,0,0,,Oya mo kahei. {\alpha&HFF}Ko mo kahei.
Dialogue: 0,0:00:28.93,0:00:29.88,Default-alt,All,0,0,0,,Oya mo kahei. Ko mo kahei.
Dialogue: 0,0:00:29.88,0:00:32.95,Default-alt,All,0,0,0,,Oyakahei, kokahei. Kokahei, oyakahei.
Dialogue: 0,0:00:32.95,0:00:35.24,Default-alt,All,0,0,0,,Furu kuri no furu kirikuchi.
Dialogue: 0,0:00:35.24,0:00:37.26,Default-alt,All,0,0,0,,Amagappa. Kabangappaka.
Dialogue: 0,0:00:37.26,0:00:39.35,Default-alt,All,0,0,0,,Kisama no kyahan mo kawagihan.
Dialogue: 0,0:00:39.35,0:00:41.60,Default-alt,All,0,0,0,,Shikka bakama no shippo korobi wo.
Dialogue: 0,0:00:41.60,0:00:43.81,Default-alt,All,0,0,0,,Minna de tabinaga ni chotto muite.
Dialogue: 0,0:00:42.18,0:00:43.77,Default,Ryo,0,0,0,,Khó đọc quá đi mất.
Dialogue: 0,0:00:43.81,0:00:48.06,Default-alt,All,0,0,0,,Mudo soto sono nakade kawara sekiniko sekichiku.
Dialogue: 0,0:00:43.81,0:00:46.40,Default,Kot,0,0,0,,Mình có cảm giác như sắp cắn vào lưỡi luôn rồi.
Dialogue: 0,0:00:48.06,0:00:51.61,Default-alt,All,0,0,0,,Nora nyorai. Nora nyorai. Mina nyorai. Munora nyorai.
Dialogue: 0,0:00:51.61,0:00:54.78,Default-alt,All,0,0,0,,Choto saki no okoho botoke ni okesu na okyaku ga
Dialogue: 0,0:00:54.78,0:00:56.57,Default-alt,All,0,0,0,,Hosonaga ni, hosodomo ni, hosonoyo ni.
Dialogue: 0,0:00:56.57,0:00:59.62,Default-alt,All,0,0,0,,Kyou mo nama nama nara nara nama no mama.
Dialogue: 0,0:00:57.24,0:01:00.12,Default,Sun,0,0,0,,Mấy cái câu dài ngoằng vô nghĩa này là cái quái gì thế?
Dialogue: 0,0:00:59.62,0:01:04.00,Default-alt,All,0,0,0,,Choto shiokande, ochato chatacho chatto chotato chotecho.
Dialogue: 0,0:01:00.16,0:01:02.83,Default,Oka,0,0,0,,Thầy Koumura đưa cho bọn mình đấy.
Dialogue: 0,0:01:02.83,0:01:05.04,Default,Oka,0,0,0,,Thầy bảo là để giúp chúng ta
luyện phát âm và nhả chữ cho chuẩn.
Dialogue: 0,0:01:04.00,0:01:06.29,Default-alt,All,0,0,0,,Aoda tokasen de hochacha tochaha.
Dialogue: 0,0:01:06.29,0:01:08.58,Default,All,0,0,0,,Này! Bớt buôn chuyện lại rồi tập tiếp mau lên!
Dialogue: 0,0:01:06.29,0:01:08.58,Default-alt,Kyo,0,0,0,,Koo ha koo de moo ni koo.
Dialogue: 0,0:01:08.58,0:01:11.09,Default-alt,All,0,0,0,,Kouya no yama no okera kozou.
Dialogue: 0,0:01:09.79,0:01:11.09,Default,Sun,0,0,0,,Biết rồi, biết rồi mà.
Dialogue: 0,0:01:11.09,0:01:13.09,Default-alt,All,0,0,0,,Tanuki hyappiki, ashi hyakuzen.
Dialogue: 0,0:01:13.09,0:01:15.47,Default-alt,All,0,0,0,,Tenmoku hyappai, bou happyappon.
Dialogue: 0,0:01:15.47,0:01:18.05,Default-alt,All,0,0,0,,Bugubagu bugubagu, nibugubagu.
Dialogue: 0,0:01:18.05,0:01:19.97,Default-alt,All,0,0,0,,Awasete bugubagu, mugububagu.
Dialogue: 0,0:01:19.97,0:01:22.68,Default-alt,All,0,0,0,,Kikukuri kikukuri, miki kukuri.
Dialogue: 0,0:01:22.68,0:01:24.93,Default-alt,All,0,0,0,,Awasete kikukuri muki kukuri.
Dialogue: 0,0:01:24.93,0:01:27.27,Default-alt,All,0,0,0,,Mugi gomi mugi gomi nimugi gomi.
Dialogue: 0,0:01:27.27,0:01:29.69,Default-alt,All,0,0,0,,Awasete mugigomi mumugi gomi.
Dialogue: 0,0:01:29.69,0:01:33.98,Default-alt,All,0,0,0,,Ano nageshino no nage naginata ha dada nagenawa no fuhou no.
