Dialogue: 0,0:02:35.21,0:02:37.80,Default,San,0,0,0,,Cảm ơn các cháu rất nhiều vì đã cất công đến tận đây thăm con bé.
Dialogue: 0,0:02:37.80,0:02:39.63,Default,Kyo,0,0,0,,Dạ có gì đâu cô, tụi cháu là bạn bè của nhau mà.
Dialogue: 0,0:02:42.51,0:02:45.14,Default,Ryo,0,0,0,,Bố mẹ cậu ấy trông hiền từ và tốt bụng thật đấy.
Dialogue: 0,0:02:45.14,0:02:49.02,Default,Kot,0,0,0,,Hai bác ấy bảo Nagisa-chan sẽ phải nghỉ học một thời gian.
Dialogue: 0,0:02:49.02,0:02:50.73,Default,Kot,0,0,0,,Mình lo cho cậu ấy quá.
Dialogue: 0,0:02:50.73,0:02:55.27,Default,Kyo,0,0,0,,Không có hội trưởng thì chắc hoạt động CLB đành phải tạm dừng một thời gian rồi.
Dialogue: 0,0:02:56.78,0:02:59.78,Default,Aki,0,0,0,,Đây chắc là lần thứ hai cháu cứu vớt con bé Nagisa rồi nhỉ.
Dialogue: 0,0:03:00.20,0:03:01.16,Default,Aki,0,0,0,,Cảm ơn cháu nhiều lắm.
Dialogue: 0,0:03:01.16,0:03:02.91,Default,Oka,0,0,0,,Dạ không, cháu đâu có...
Dialogue: 0,0:03:03.82,0:03:04.58,Default,Oka,0,0,0,,Cháu đâu có...
Dialogue: 0,0:03:06.49,0:03:07.45,Default,Oka,0,0,0,,...làm được gì đâu ạ.
Dialogue: 0,0:03:08.87,0:03:12.58,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410)\3c&H4A8A5C&}Tập 17
Dialogue: 0,0:03:08.87,0:03:12.58,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Căn phòng không một bóng người
Dialogue: 0,0:03:15.71,0:03:17.30,Default,Tom,0,0,0,,Okazaki! Sáng rồi đấy!
Dialogue: 0,0:03:17.30,0:03:18.38,Default,Tom,0,0,0,,Anh sẽ bị muộn học mất.
Dialogue: 0,0:03:22.55,0:03:23.64,Default,Tom,0,0,0,,Chào buổi sáng nhé, Okazaki.
Dialogue: 0,0:03:24.43,0:03:25.26,Default,Oka,0,0,0,,Tomoyo!
Dialogue: 0,0:03:26.64,0:03:28.22,Default,Oka,0,0,0,,Em làm cái quái gì ở đây thế?!
Dialogue: 0,0:03:28.22,0:03:31.44,Default,Tom,0,0,0,,Em đến gọi anh dậy, để anh khỏi bị trễ học.
Dialogue: 0,0:03:31.44,0:03:33.48,Default,Oka,0,0,0,,Sao em lại làm thế?!
Dialogue: 0,0:03:33.48,0:03:36.57,Default,Tom,0,0,0,,Nhà anh nằm ngay trên đường em đến trường mà.
Dialogue: 0,0:03:36.57,0:03:39.90,Default,Tom,0,0,0,,Em không thể để bạn bè của mình cứ liên tục đi trễ mãi được.
Dialogue: 0,0:03:40.40,0:03:43.11,Default,Tom,0,0,0,,Hôm qua em không có dịp báo trước cho anh, nên hôm nay em đành tự ý ghé qua luôn.
Dialogue: 0,0:03:43.11,0:03:44.03,Default,Tom,0,0,0,,Anh có bất ngờ không?
Dialogue: 0,0:03:44.03,0:03:45.53,Default,Oka,0,0,0,,Bất ngờ cái nỗi gì, giật bắn cả mình ấy chứ!
Dialogue: 0,0:03:45.53,0:03:47.41,Default,Oka,0,0,0,,Đừng có tự tiện xông vào nhà người khác như thế chứ!
Dialogue: 0,0:03:47.41,0:03:50.83,Default,Tom,0,0,0,,Đâu phải tự tiện đâu;
em đã xin phép đàng hoàng từ bố anh rồi đấy.
Dialogue: 0,0:03:53.92,0:03:55.96,Default,Oka,0,0,0,,Em đã gặp ông ấy rồi sao?
Dialogue: 0,0:03:55.96,0:03:58.34,Default,Tom,0,0,0,,Vâng. Có vấn đề gì sao anh?
Dialogue: 0,0:03:59.59,0:04:01.51,Default,Oka,0,0,0,,Không, không có gì.
Dialogue: 0,0:04:03.72,0:04:05.84,Default,Oka,0,0,0,,Thôi nào, buông tay tôi ra đi chứ.
Dialogue: 0,0:04:05.22,0:04:07.72,Default-alt,Tom,0,0,0,,Không được. Buông ra là anh sẽ chạy trốn ngay cho xem.
Dialogue: 0,0:04:07.72,0:04:11.64,Default,Oka,0,0,0,,Sao lại chỉ có mỗi mình tôi? Còn một tên nữa cũng chúa trùm đi trễ kia kìa!
Dialogue: 0,0:04:12.02,0:04:13.23,Default,Tom,0,0,0,,Anh đang nói đến ai thế?
Dialogue: 0,0:04:13.60,0:04:14.44,Default,Sun,0,0,0,,Cái gì thế này?!
Dialogue: 0,0:04:14.44,0:04:16.48,Default,Sun,0,0,0,,Chuyện gì đang xảy ra thế hả?!
Dialogue: 0,0:04:16.48,0:04:18.98,Default,Tom,0,0,0,,Tôi đến đây theo yêu cầu của Okazaki.
Dialogue: 0,0:04:18.98,0:04:22.69,Default,Oka,0,0,0,,Tao muốn chia sẻ niềm vui được con gái đến tận nơi đánh thức cho mày thôi mà.
Dialogue: 0,0:04:22.69,0:04:24.86,Default,Tom,0,0,0,,Phòng ốc chỗ này được giữ gìn gọn gàng bất ngờ nhỉ.
Dialogue: 0,0:04:27.16,0:04:28.33,Default,Tom,0,0,0,,Cái gì đây?
Dialogue: 0,0:04:29.53,0:04:30.87,Default,Sun,0,0,0,,Dừng lại mau!
Dialogue: 0,0:04:29.99,0:04:30.87,Default-alt,Tom,0,0,0,,Ồ, tạp chí khiêu dâm à.
Dialogue: 0,0:04:30.87,0:04:32.16,Default,Sun,0,0,0,,Đừng có tự tiện lục lọi đồ của người khác chứ!
Dialogue: 0,0:04:32.96,0:04:35.33,Default,Tom,0,0,0,,Chà, hóa ra anh cũng chỉ là một tên con trai bình thường thôi nhỉ.
Dialogue: 0,0:04:35.33,0:04:36.46,Default,Sun,0,0,0,,Câm mồm đi!
Dialogue: 0,0:04:36.46,0:04:38.00,Default,Tom,0,0,0,,Anh đâu cần phải xấu hổ thế.
Dialogue: 0,0:04:38.00,0:04:39.21,Default-alt,Tom,0,0,0,,Anh cũng chỉ là một cậu thiếu niên đang tuổi dậy thì thôi mà.
Dialogue: 0,0:04:38.00,0:04:39.21,Default,Sun,0,0,0,,Tha cho tao đi bà cô ơi!
Dialogue: 0,0:04:41.13,0:04:42.51,Default,Tom,0,0,0,,Tốt rồi, chúng ta đã đến trường vừa kịp giờ.
Dialogue: 0,0:04:42.92,0:04:43.76,Default,Tom,0,0,0,,Hẹn gặp lại hai anh nhé.
Dialogue: 0,0:04:45.59,0:04:48.05,Default,Sun,0,0,0,,Mới mở mắt được đúng năm phút là đã có mặt ở trường rồi.
Dialogue: 0,0:04:48.05,0:04:49.18,Default,Sun,0,0,0,,Kỷ lục mới của cuộc đời tao đấy.
Dialogue: 0,0:04:51.56,0:04:55.02,Default,Kyo,0,0,0,,Tomoya. Hôm nay cậu cũng ăn trưa với tôi đi.
Dialogue: 0,0:04:57.52,0:04:59.77,Default,Oka,0,0,0,,Hộp cơm bento này nhìn thịnh soạn và hoành tráng thật đấy.
Dialogue: 0,0:04:59.77,0:05:02.36,Default,Ryo,0,0,0,,Là chị hai tự tay làm hết đấy ạ.
Dialogue: 0,0:05:02.36,0:05:04.86,Default,Ryo,0,0,0,,Chị ấy đã cặm cụi dậy từ sáng sớm tinh mơ để làm cho cậu đấy.
Dialogue: 0,0:05:07.66,0:05:08.45,Default,Oka,0,0,0,,Ngon thật đấy!
Dialogue: 0,0:05:08.87,0:05:12.37,Default,Ryo,0,0,0,,Đúng không nào? Chị hai nấu ăn đỉnh lắm đấy.
Dialogue: 0,0:05:14.91,0:05:16.08,Default,Kyo,0,0,0,,Botan, phần của mày đây nữa này.
Dialogue: 0,0:05:16.08,0:05:16.62,Default,Kyo,0,0,0,,Đây nè.
Dialogue: 0,0:05:16.62,0:05:17.62,Default,Bot,0,0,0,,Puhi! Puhi!
Dialogue: 0,0:05:18.38,0:05:22.59,Default,Kyo,0,0,0,,Hai người nhích sát vào nhau chút đi. Chật chội thế này tôi không bày thức ăn ra được.
Dialogue: 0,0:05:21.38,0:05:22.55,Default-alt,Oka,0,0,0,,N-Này.
Dialogue: 0,0:05:23.84,0:05:27.05,Default,Kyo,0,0,0,,Ê, ai mà ngờ được chứ? Hai người ngồi cạnh nhau nhìn đẹp đôi ra phết đấy.
Dialogue: 0,0:05:27.05,0:05:27.97,Default,Kyo,0,0,0,,Đúng không hả Botan?
Dialogue: 0,0:05:27.97,0:05:28.80,Default,Bot,0,0,0,,Puhi! Puhi!
Dialogue: 0,0:05:29.85,0:05:31.85,Default-alt,Guy,0,0,0,,{\an8}Tôi xin tuyên bố...
Dialogue: 0,0:05:31.85,0:05:36.85,Default-alt,Guy,0,0,0,,{\an8}...khi trở thành hội trưởng hội học sinh, tôi sẽ tăng gấp đôi thực đơn ở nhà ăn!
Dialogue: 0,0:05:32.06,0:05:32.85,Default,Oka,0,0,0,,Tương lai sao?
Dialogue: 0,0:05:32.85,0:05:36.02,Default,Kyo,0,0,0,,Ừ. Sau khi tốt nghiệp cậu tính làm gì?
Dialogue: 0,0:05:36.56,0:05:40.73,Default,Kyo,0,0,0,,Đừng bảo là cậu chưa từng nghĩ tới chuyện gì đấy nhé.
Dialogue: 0,0:05:40.73,0:05:42.94,Default,Oka,0,0,0,,Thế còn hai người thì sao?
Dialogue: 0,0:05:42.94,0:05:45.94,Default,Kyo,0,0,0,,Tôi đang tính trở thành giáo viên mầm non.
Dialogue: 0,0:05:46.32,0:05:49.11,Default,Ryo,0,0,0,,Còn tớ thì muốn thi vào trường điều dưỡng ạ.
Dialogue: 0,0:05:49.11,0:05:50.12,Default,Oka,0,0,0,,Ra là vậy.
Dialogue: 0,0:05:50.62,0:05:52.83,Default,Oka,0,0,0,,Chào hai người nhé. Cảm ơn vì bữa ăn.
Dialogue: 0,0:05:52.83,0:05:57.08,Default,Kyo,0,0,0,,Ryou bảo ngày mai cậu ấy sẽ làm bento đấy, cứ chờ mà thưởng thức nhé.
Dialogue: 0,0:05:57.41,0:06:00.13,Default,Kyo,0,0,0,,Em làm cái gì thế? Mau đi theo cậu ấy đi chứ.
Dialogue: 0,0:06:00.67,0:06:03.00,Default,Ryo,0,0,0,,Làm thế này liệu có thực sự ổn không chị?
Dialogue: 0,0:06:03.00,0:06:04.05,Default,Kyo,0,0,0,,Ổn cái gì mà không ổn?
Dialogue: 0,0:06:04.05,0:06:07.55,Default,Ryo,0,0,0,,Em thấy có lỗi với Nagisa-chan lắm.
Dialogue: 0,0:06:07.55,0:06:11.14,Default,Kyo,0,0,0,,Tomoya với Nagisa đâu có hẹn hò gì với nhau đâu.
Dialogue: 0,0:06:11.14,0:06:12.76,Default,Kyo,0,0,0,,Em việc gì mà phải ngần ngại, giữ kẽ chứ?
Dialogue: 0,0:06:14.97,0:06:19.27,Default,Kyo,0,0,0,,Nếu em không chủ động thì con bé Tomoyo kia sẽ cướp cậu ấy mất đấy.
Dialogue: 0,0:06:19.27,0:06:20.56,Default,Kyo,0,0,0,,Em chịu để chuyện đó xảy ra à?
Dialogue: 0,0:06:26.78,0:06:28.53,Default,Kyo,0,0,0,,Gặp lại sau nhé, Ryou.
Dialogue: 0,0:06:29.11,0:06:30.11,Default,Ryo,0,0,0,,Chị hai...
Dialogue: 0,0:06:35.20,0:06:36.37,Default,Ryo,0,0,0,,Em xin lỗi...
Dialogue: 0,0:06:40.50,0:06:42.63,Default,Sun,0,0,0,,Vậy là Nagisa-chan phải nghỉ học rồi à.
Dialogue: 0,0:06:42.63,0:06:44.04,Default,Sun,0,0,0,,Tao thấy hơi thiếu vắng và cô đơn đấy.
Dialogue: 0,0:06:44.54,0:06:46.63,Default,Sun,0,0,0,,Hôm nay mày cũng định đến thăm cậu ấy nữa đúng không?
Dialogue: 0,0:06:46.63,0:06:48.17,Default,Sun,0,0,0,,Cho tao đi cùng với.
Dialogue: 0,0:06:48.17,0:06:51.72,Default,Oka,0,0,0,,Hôm nào cũng kéo tới thì làm phiền người ta mất.
Dialogue: 0,0:06:51.72,0:06:53.51,Default,Oka,0,0,0,,Nên hôm nay tao không tính ghé qua đâu.
Dialogue: 0,0:06:54.26,0:06:58.52,Default,Sun,0,0,0,,Mày chắc chắn là mày không hẹn hò với Nagisa-chan đấy chứ?
Dialogue: 0,0:06:58.52,0:07:02.19,Default,Oka,0,0,0,,Tao đã nói bao nhiêu lần rồi, tao không có ý định kiếm bạn gái.
Dialogue: 0,0:07:02.19,0:07:02.90,Default,Tom,0,0,0,,Tại sao lại không?
Dialogue: 0,0:07:04.52,0:07:06.19,Default,Oka,0,0,0,,Tại sao cái gì cơ?
Dialogue: 0,0:07:06.19,0:07:07.98,Default,Tom,0,0,0,,Tại sao anh lại không muốn có bạn gái?
Dialogue: 0,0:07:08.44,0:07:10.82,Default,Tom,0,0,0,,Có điều gì đang cản trở anh sao?
Dialogue: 0,0:07:11.11,0:07:12.95,Default,Oka,0,0,0,,Em thấy ông già của tôi rồi đấy.
Dialogue: 0,0:07:12.95,0:07:17.49,Default,Oka,0,0,0,,Gia đình tôi thì nát bét, bản thân tôi lại là thằng bất hảo cúp học lông bông.
Dialogue: 0,0:07:17.49,0:07:19.91,Default,Oka,0,0,0,,Tôi không phải là kiểu người nên có bạn gái đâu.
Dialogue: 0,0:07:20.50,0:07:23.38,Default,Tom,0,0,0,,Nhưng ấn tượng của em về bác ấy là một người cha rất hiền từ mà.
Dialogue: 0,0:07:23.88,0:07:27.30,Default,Tom,0,0,0,,Thôi kệ đi, tiện thể tình cờ gặp anh ở đây, tụi mình cùng đi bộ về nhé.
Dialogue: 0,0:07:27.30,0:07:29.05,Default,Oka,0,0,0,,Tự nhiên ở đâu ra thế này?
Dialogue: 0,0:07:29.76,0:07:31.93,Default,Sun,0,0,0,,Đúng rồi, tụi mình cùng nhau đi về đi.
Dialogue: 0,0:07:31.93,0:07:34.09,Default,Tom,0,0,0,,Tôi không nhớ là mình có rủ anh đâu nhé.
Dialogue: 0,0:07:34.09,0:07:37.85,Default,Sun,0,0,0,,Rủ Okazaki cũng đồng nghĩa là rủ tao rồi.
Dialogue: 0,0:07:37.85,0:07:40.85,Default,Sun,0,0,0,,Tao có chút chuyện cần giải quyết ở đằng kia, hai người đi cùng tao một đoạn đi.
Dialogue: 0,0:07:41.77,0:07:44.35,Default,Kyo,0,0,0,,Khốn kiếp, con bé đó lại nhanh chân hơn bọn mình rồi.
Dialogue: 0,0:07:49.44,0:07:51.65,Default,Oka,0,0,0,,Mày có việc gì ở cái chỗ này thế hả?
Dialogue: 0,0:07:51.65,0:07:53.03,Default,Sun,0,0,0,,Lát nữa mày sẽ biết ngay thôi.
Dialogue: 0,0:07:53.66,0:07:54.66,Default,Guy,0,0,0,,Thật á? Nhìn phèn dữ vậy trời.
Dialogue: 0,0:07:54.66,0:07:56.28,Default,Guy,0,0,0,,Ừ, rồi sau đó—
Dialogue: 0,0:07:57.58,0:07:58.95,Default,Guy,0,0,0,,Sa-Sakagami!
Dialogue: 0,0:07:58.95,0:08:00.37,Default,Guy,0,0,0,,Cô... cô làm cái quái gì ở đây thế?!
Dialogue: 0,0:08:00.37,0:08:01.75,Default,Guy,0,0,0,,Thôi chết rồi, chuồn lẹ anh em ơi!
Dialogue: 0,0:08:03.33,0:08:07.34,Default,Tom,0,0,0,,Anh hiểu rồi chứ?
Hình tượng của em ở khu này hoàn toàn khác hẳn đấy.
Dialogue: 0,0:08:07.71,0:08:11.67,Default,Oka,0,0,0,,Hóa ra lời đồn em từng đập tơi bời mấy băng đảng giang hồ là thật à.
Dialogue: 0,0:08:11.67,0:08:12.97,Default,Tom,0,0,0,,Chuyện quá khứ rồi anh.
Dialogue: 0,0:08:14.18,0:08:15.76,Default,Guy,0,0,0,,Chết tiệt, là Sakagami kìa.
Dialogue: 0,0:08:15.76,0:08:17.72,Default,Guy,0,0,0,,Ai mà biết con quái vật đó sẽ làm gì tụi mình chứ.
Dialogue: 0,0:08:20.47,0:08:21.93,Default,Oka,0,0,0,,Hóa ra đây là mục đích mày rủ bọn tao đi theo đấy à?
Dialogue: 0,0:08:22.31,0:08:25.65,Default,Sun,0,0,0,,Mấy gã quanh khu này thỉnh thoảng hay kiếm chuyện gây sự với tao.
Dialogue: 0,0:08:25.65,0:08:27.77,Default,Sun,0,0,0,,Đi ké thế này cảm giác oai phong thật đấy.
Dialogue: 0,0:08:27.77,0:08:31.40,Default,Tom,0,0,0,,Sunohara, nếu có việc gì cần làm thì anh mau giải quyết cho xong đi.
Dialogue: 0,0:08:31.40,0:08:32.78,Default,Tom,0,0,0,,Tôi muốn về nhà rồi.
Dialogue: 0,0:08:32.78,0:08:35.20,Default,Oka,0,0,0,,Cậu ấy bảo đường này chỉ là đường đi ngang qua thôi.
Dialogue: 0,0:08:35.20,0:08:37.62,Default,Oka,0,0,0,,Việc cần làm của cậu ấy nằm ở phía trước cơ.
Dialogue: 0,0:08:37.62,0:08:38.62,Default,Sun,0,0,0,,Hả?
Dialogue: 0,0:08:38.62,0:08:39.78,Default,Oka,0,0,0,,Mày diễn trò thế là đủ rồi đấy nhỉ?
Dialogue: 0,0:08:39.78,0:08:42.41,Default,Oka,0,0,0,,Nếu mày không dừng lại, tao sẽ kể hết âm mưu của mày cho cô ấy nghe đấy.
Dialogue: 0,0:08:42.41,0:08:43.50,Default,Sun,0,0,0,,Xin mày đấy, đừng mà!
Dialogue: 0,0:08:45.17,0:08:48.04,Default,Tom,0,0,0,,Em hiểu rồi. Hóa ra anh muốn ghé quán cà phê này.
Dialogue: 0,0:08:48.04,0:08:50.63,Default,Oka,0,0,0,,Tuyệt vời hơn nữa là cậu ấy sẽ bao trọn gói chúng ta đấy.
Dialogue: 0,0:08:50.63,0:08:52.67,Default,Oka,0,0,0,,Cậu ấy là một người bạn cực kỳ chu đáo và tâm lý đúng không nào?
Dialogue: 0,0:08:52.67,0:08:53.34,Default,Tom,0,0,0,,Vâng.
Dialogue: 0,0:08:53.34,0:08:57.22,Default,Tom,0,0,0,,Từ hôm nay anh cũng có thể xem tôi như bạn bè của anh rồi đấy.
Dialogue: 0,0:08:57.22,0:08:59.05,Default,Sun,0,0,0,,Cảm ơn em nhiều lắm.
Dialogue: 0,0:08:59.05,0:09:02.56,Default,Oka,0,0,0,,Được đi cà phê cùng với một cô gái vốn là ước mơ bấy lâu nay của nó đấy.
Dialogue: 0,0:09:02.56,0:09:03.43,Default-alt,Tom,0,0,0,,Thật thế sao anh?
Dialogue: 0,0:09:02.93,0:09:03.93,Default,Tom,0,0,0,,Cảm ơn anh vì chuyện lúc nãy nhé.
Dialogue: 0,0:09:04.43,0:09:05.56,Default,Oka,0,0,0,,Cảm ơn chuyện gì cơ?
Dialogue: 0,0:09:06.06,0:09:10.19,Default,Tom,0,0,0,,Anh đã nhận ra em không hề muốn ở chỗ đó và giải vây giúp em đúng không?
Dialogue: 0,0:09:10.73,0:09:11.94,Default,Oka,0,0,0,,Đâu có gì to tát đâu.
Dialogue: 0,0:09:11.94,0:09:14.19,Default,Oka,0,0,0,,Chỉ là bản thân tôi cũng chẳng thích thú gì việc nán lại cái chốn đó thôi.
Dialogue: 0,0:09:15.24,0:09:16.15,Default,Tom,0,0,0,,Okazaki này.
Dialogue: 0,0:09:17.20,0:09:20.62,Default,Tom,0,0,0,,Bây giờ em đã có rất nhiều người bạn tốt,
Dialogue: 0,0:09:20.62,0:09:23.95,Default,Tom,0,0,0,,nhưng được ở bên cạnh hai người cũng rất vui.
Dialogue: 0,0:09:24.41,0:09:27.33,Default,Tom,0,0,0,,Nói đúng hơn là, được ở bên cạnh anh khiến em thấy đặc biệt vui vẻ.
Dialogue: 0,0:09:27.33,0:09:29.17,Default,Oka,0,0,0,,Chà, tôi thật vinh hạnh quá.
Dialogue: 0,0:09:29.17,0:09:30.34,Default,Tom,0,0,0,,Hẹn gặp lại anh vào ngày mai nhé.
Dialogue: 0,0:09:45.98,0:09:47.85,Default,Tom,0,0,0,,Chào buổi sáng nhé, Okazaki.
Dialogue: 0,0:09:48.90,0:09:50.52,Default,Tom,0,0,0,,Anh vẫn còn đang ngái ngủ đúng không?
Dialogue: 0,0:09:50.52,0:09:52.02,Default,Tom,0,0,0,,Cái mặt anh lúc ngủ nhìn buồn cười thật đấy.
Dialogue: 0,0:09:52.02,0:09:55.40,Default,Tom,0,0,0,,Nhìn này, thế này trông sẽ càng buồn cười hơn nữa cho xem.
Dialogue: 0,0:09:55.99,0:09:57.74,Default,Oka,0,0,0,,Em đang làm cái trò quỷ gì với mặt tôi thế?!
Dialogue: 0,0:09:57.74,0:10:00.49,Default,Tom,0,0,0,,Em đang đánh thức anh dậy mà. Anh phải biết ơn mới đúng chứ.
Dialogue: 0,0:10:00.49,0:10:02.83,Default,Oka,0,0,0,,Từ giờ sáng nào em cũng tính mò sang đây đấy à?
Dialogue: 0,0:10:02.83,0:10:04.45,Default,Tom,0,0,0,,Đúng thế đấy. Anh không thấy hạnh phúc sao?
Dialogue: 0,0:10:05.58,0:10:08.58,Default,Sun,0,0,0,,Nói thật lòng thì phiền phức bỏ xừ.
Dialogue: 0,0:10:08.58,0:10:10.67,Default,Oka,0,0,0,,Mày việc gì phải khách sáo thế; bọn mình đều là bạn bè cả mà.
Dialogue: 0,0:10:11.04,0:10:13.88,Default,Tom,0,0,0,,Okazaki nài nỉ mãi nên bọn tôi mới sang đây đấy chứ.
Dialogue: 0,0:10:13.88,0:10:15.67,Default,Tom,0,0,0,,Anh nên biết ơn đi là vừa.
Dialogue: 0,0:10:15.67,0:10:20.89,Default,Sun,0,0,0,,Cô dám mở mồm nói cái giọng đó sau khi phá đám giấc ngủ êm đềm của tiền bối đấy hả?!
Dialogue: 0,0:10:20.89,0:10:23.01,Default,Tom,0,0,0,,Hóa ra anh cũng để tâm đến trật tự tôn ti tiền bối - hậu bối cơ đấy?
Dialogue: 0,0:10:23.56,0:10:26.60,Default,Sun,0,0,0,,Chuyện này không thể chỉ xin lỗi suông là xong chuyện được đâu, hiểu chưa hả?!
Dialogue: 0,0:10:26.60,0:10:28.69,Default,Tom,0,0,0,,Tôi cũng đâu có ý định xin lỗi anh đâu.
Dialogue: 0,0:10:30.15,0:10:33.98,Default,Sun,0,0,0,,Này, nhìn kỹ lại thì thân hình em bốc lửa và quyến rũ ra phết đấy cô em.
Dialogue: 0,0:10:33.98,0:10:36.78,Default,Oka,0,0,0,,Nó thuộc cái hệ người sinh ra chẳng bao giờ làm nổi nhân vật chính được.
Dialogue: 0,0:10:36.78,0:10:39.32,Default,Tom,0,0,0,,Anh có hứng thú với cơ thể của tôi sao?
Dialogue: 0,0:10:39.82,0:10:42.66,Default,Tom,0,0,0,,Cầu xin đi, rồi tôi có thể sẽ cho anh chạm vào đấy.
Dialogue: 0,0:10:42.66,0:10:44.20,Default,Sun,0,0,0,,Em nói thật đấy à?!
Dialogue: 0,0:10:44.95,0:10:45.95,Default,Tom,0,0,0,,Sao nào?
Dialogue: 0,0:10:46.37,0:10:47.45,Default,Sun,0,0,0,,Anh xin em đấy!
Dialogue: 0,0:10:47.45,0:10:48.58,Default,Oka,0,0,0,,Mày hết thuốc chữa rồi con ạ.
Dialogue: 0,0:10:48.58,0:10:51.08,Default,Tom,0,0,0,,Được rồi, nếu anh đã hạ mình nài nỉ đến mức đó.
Dialogue: 0,0:10:54.04,0:10:55.09,Default,Sun,0,0,0,,Cái gì thế này?!
Dialogue: 0,0:10:55.09,0:10:57.51,Default,Tom,0,0,0,,Bàn tay cũng là một phần của cơ thể mà.
Dialogue: 0,0:10:57.51,0:10:57.51,Default,Tom,0,0,0,,Không phải sao?
Dialogue: 0,0:10:57.51,0:11:01.09,Default,Sun,0,0,0,,Con ranh này... Giờ thì tao điên thật rồi đấy!
Dialogue: 0,0:11:04.60,0:11:05.14,Default,Sun,0,0,0,,Chết tao rồi.
Dialogue: 0,0:11:08.81,0:11:11.69,Default,Tom,0,0,0,,Lúc em đang tung cước đá anh ta, anh có nghe thấy tiếng gì không?
Dialogue: 0,0:11:12.31,0:11:13.52,Default,Oka,0,0,0,,“Sướng quá đi mất!”
Dialogue: 0,0:11:15.11,0:11:16.94,Default,Tom,0,0,0,,Anh ta mắc chứng cuồng khổ dâm à?
Dialogue: 0,0:11:21.07,0:11:22.45,Default,Bot,0,0,0,,Puhi! Puhi!
Dialogue: 0,0:11:22.45,0:11:23.82,Default,Kyo,0,0,0,,Cậu đây rồi, Tomoya.
Dialogue: 0,0:11:24.37,0:11:26.33,Default,Oka,0,0,0,,Dù sao tôi cũng đã lỡ hứa rồi mà.
Dialogue: 0,0:11:26.33,0:11:32.29,Default,Ryo,0,0,0,,Dạ, hôm nay là bento do chính tay em làm dưới sự chỉ bảo của chị hai đấy ạ.
Dialogue: 0,0:11:32.29,0:11:35.09,Default,Kyo,0,0,0,,Nó đã cặm cụi cố gắng lắm đấy, cậu phải thưởng thức cho đàng hoàng vào.
Dialogue: 0,0:11:35.09,0:11:37.46,Default,Oka,0,0,0,,Được rồi. Vậy tôi xin phép thưởng thức nhé.
Dialogue: 0,0:11:38.59,0:11:39.13,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:11:39.13,0:11:40.34,Default,Kyo,0,0,0,,Này, Botan!
Dialogue: 0,0:11:40.34,0:11:41.47,Default,Kyo,0,0,0,,Phép lịch sự của mày đâu rồi hả?
Dialogue: 0,0:11:43.30,0:11:44.30,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:11:49.56,0:11:53.27,Default,Ryo,0,0,0,,Tớ xin lỗi nhiều nhé. Đáng lẽ tớ nên kiểm tra kỹ trước khi đóng gói hộp cơm.
Dialogue: 0,0:11:53.27,0:11:57.11,Default,Oka,0,0,0,,Đừng lo. Món chả giò ngon lắm đấy.
Dialogue: 0,0:11:57.11,0:11:58.44,Default,Ryo,0,0,0,,Thật thế sao cậu?
Dialogue: 0,0:11:58.44,0:11:59.78,Default,Ryo,0,0,0,,May quá đi mất.
Dialogue: 0,0:12:00.82,0:12:01.40,Default,Bot,0,0,0,,Puhi.
Dialogue: 0,0:12:01.40,0:12:03.15,Default,Oka,0,0,0,,Botan, mày lại về phe bọn mình rồi à.
Dialogue: 0,0:12:03.49,0:12:06.45,Default,Kyo,0,0,0,,Tôi phải dắt Botan thả ra ngoài cổng trường đã.
Dialogue: 0,0:12:06.45,0:12:06.95,Default,Kyo,0,0,0,,Gặp lại sau nhé.
Dialogue: 0,0:12:06.95,0:12:08.45,Default,Ryo,0,0,0,,Chị hai...
Dialogue: 0,0:13:13.77,0:13:15.89,Default,Yuk,0,0,0,,Anh đang có chuyện gì phiền muộn trong lòng sao?
Dialogue: 0,0:13:17.02,0:13:19.81,Default,Oka,0,0,0,,Cũng không hẳn là vậy...
Dialogue: 0,0:13:19.81,0:13:23.90,Default,Yuk,0,0,0,,Nếu anh muốn tìm thứ gì đó để khuây khỏa tâm trạng, ở đây có một cuốn sách bùa chú rất thú vị đấy ạ.
Dialogue: 0,0:13:23.90,0:13:25.57,Default,Yuk,0,0,0,,Anh có muốn thử làm không?
Dialogue: 0,0:13:27.32,0:13:29.12,Default,Oka,0,0,0,,Sau bước này thì phải làm gì tiếp theo?
Dialogue: 0,0:13:29.12,0:13:32.37,Default,Yuk,0,0,0,,Anh hãy giữ thăng bằng thêm một đồng 10 yên nữa chồng lên trên đó.
Dialogue: 0,0:13:32.37,0:13:34.50,Default,Oka,0,0,0,,Chuyện đó là bất khả thi tuyệt đối rồi!
Dialogue: 0,0:13:34.50,0:13:37.92,Default,Yuk,0,0,0,,Nhưng nếu không làm được thì bùa chú sẽ không linh nghiệm đâu ạ.
Dialogue: 0,0:13:41.46,0:13:42.38,Default,Oka,0,0,0,,Này.
Dialogue: 0,0:13:42.38,0:13:42.92,Default,Oka,0,0,0,,Được rồi kìa!
Dialogue: 0,0:13:42.92,0:13:47.76,Default,Yuk,0,0,0,,Tiếp theo, anh hãy niệm câu thần chú “Ritafuni Kousoku Iita” ba lần nhé.
Dialogue: 0,0:13:47.76,0:13:54.02,Default,Oka,0,0,0,,Ritafuni Kousoku Iita,
Ritafuni Kousoku Iita, Ritafuni Kousoku Iita.
Dialogue: 0,0:13:54.47,0:13:56.52,Default,Oka,0,0,0,,Mà rốt cuộc cái bùa này có công dụng gì thế em?
Dialogue: 0,0:13:56.89,0:14:01.82,Default,Yuk,0,0,0,,Đó là bùa chú giúp anh và một bạn nữ
được nhốt chung trong kho dụng cụ thể dục đấy ạ.
Dialogue: 0,0:14:01.82,0:14:03.40,Default,Oka,0,0,0,,Bây giờ anh hãy hình dung một người trong tâm trí đi ạ.
Dialogue: 0,0:14:04.57,0:14:05.49,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:14:05.86,0:14:07.53,Default,Oka,0,0,0,,...thì đang nghỉ học rồi.
Dialogue: 0,0:14:07.53,0:14:08.15,Default,Oka,0,0,0,,Kyou!
Dialogue: 0,0:14:09.99,0:14:11.66,Default,Oka,0,0,0,,Chà, Kyou chắc là sự lựa chọn an toàn nhất rồi.
Dialogue: 0,0:14:14.45,0:14:17.41,Default,Oka,0,0,0,,Làm sao trên đời lại có thứ bùa chú tiện lợi như thế được chứ.
Dialogue: 0,0:14:17.41,0:14:20.08,Default,Yuk,0,0,0,,Cũng có cách để hóa giải bùa chú này nữa đấy anh.
Dialogue: 0,0:14:20.08,0:14:25.84,Default,Yuk,0,0,0,,Anh chỉ cần cởi trần nửa người trên, rồi hô to câu
“Nguyền rủa chẳng là cái đinh gì với ta cả” ba lần là được.
Dialogue: 0,0:14:25.84,0:14:30.55,Default,Oka,0,0,0,,Tôi chẳng quan tâm đâu. Dạy tôi cái gì có ích hơn đi.
Dialogue: 0,0:14:30.55,0:14:35.01,Default,Yuk,0,0,0,,Nếu anh chịu chia sẻ rắc rối mà anh đang gặp phải với em,
có thể em sẽ đưa ra được lời khuyên nào đó cho anh đấy.
Dialogue: 0,0:14:36.31,0:14:39.19,Default,Oka,0,0,0,,Tôi cũng chẳng biết phải bắt đầu từ đâu nữa.
Dialogue: 0,0:14:39.77,0:14:40.27,Default,Oka,0,0,0,,À đúng rồi.
Dialogue: 0,0:14:40.27,0:14:42.90,Default,Oka,0,0,0,,Em nghĩ thế nào về hội học sinh hiện tại?
Dialogue: 0,0:14:42.90,0:14:45.19,Default,Yuk,0,0,0,,Em thấy các anh chị ấy là những người rất chăm chỉ và mẫn cán.
Dialogue: 0,0:14:45.19,0:14:48.78,Default,Yuk,0,0,0,,Nhưng mặt khác, có vẻ họ bị ràng buộc quá mức cứng nhắc vào các quy tắc ạ.
Dialogue: 0,0:14:48.78,0:14:49.90,Default,Oka,0,0,0,,Ừ, tôi cũng thấy thế.
Dialogue: 0,0:14:49.90,0:14:52.53,Default,Oka,0,0,0,,Tại sao họ lại không thể cho phép dùng chung giáo viên cố vấn cơ chứ?
Dialogue: 0,0:14:52.53,0:14:57.58,Default,Yuk,0,0,0,,Tuy nhiên, nếu các thành viên thay đổi thì bầu không khí có lẽ cũng sẽ thay đổi theo đấy ạ.
Dialogue: 0,0:14:57.58,0:15:00.08,Default,Yuk,0,0,0,,Sắp tới là cuộc bầu cử hội học sinh rồi mà.
Dialogue: 0,0:15:00.08,0:15:01.42,Default,Oka,0,0,0,,Bầu cử hội đồng học sinh!
Dialogue: 0,0:15:02.25,0:15:06.92,Default,Oka,0,0,0,,Đúng rồi, nếu Tomoyo thắng cử thì mọi vấn đề sẽ được giải quyết êm đẹp hết.
Dialogue: 0,0:15:06.92,0:15:09.42,Default,Oka,0,0,0,,Mau khỏe lại nhé, Nagisa.
Dialogue: 0,0:15:09.42,0:15:11.18,Default,Oka,0,0,0,,Đang có tin vui chờ đón cậu đấy.
Dialogue: 0,0:15:14.39,0:15:17.68,Default,Kyo,0,0,0,,Tomoya! Nhặt hộ tôi quả bóng đằng kia với được không?
Dialogue: 0,0:15:18.43,0:15:21.14,Default,Kyo,0,0,0,,Tiết thể dục kết thúc muộn quá,
Dialogue: 0,0:15:21.14,0:15:23.86,Default,Kyo,0,0,0,,nên giờ tôi phải ở lại dọn dẹp sau giờ học này.
Dialogue: 0,0:15:23.86,0:15:25.77,Default,Oka,0,0,0,,Tại sao tôi lại phải giúp cậu chứ?
Dialogue: 0,0:15:25.77,0:15:29.32,Default,Kyo,0,0,0,,Giúp chừng này có đáng là bao đâu;
ngày nào tôi cũng bao cậu ăn trưa còn gì.
Dialogue: 0,0:15:30.90,0:15:33.41,Default,Mit,0,0,0,,Đứa nào lại để cửa mở toang hoang thế này?
Dialogue: 0,0:15:36.70,0:15:37.54,Default,Kyo,0,0,0,,Hả?
Dialogue: 0,0:15:37.54,0:15:38.95,Default,Oka,0,0,0,,Sao thế?
Dialogue: 0,0:15:38.95,0:15:42.67,Default,Kyo,0,0,0,,Không mở ra được. Xem ra có ai đó vừa khóa trái cửa từ bên ngoài rồi.
Dialogue: 0,0:15:43.63,0:15:44.58,Default,Oka,0,0,0,,Tôi xin lỗi cậu nhiều lắm!
Dialogue: 0,0:15:45.00,0:15:46.46,Default,Kyo,0,0,0,,Sao tự nhiên cậu lại xin lỗi?
Dialogue: 0,0:15:47.46,0:15:48.80,Default,Kyo,0,0,0,,Chẳng lẽ chuyện này là do cậu bày trò ra đấy à?!
Dialogue: 0,0:15:49.51,0:15:50.63,Default,Kyo,0,0,0,,Cậu đang toan tính cái trò...
Dialogue: 0,0:15:51.22,0:15:54.30,Default,Kyo,0,0,0,,Đừng bảo là cậu đang tính làm cái chuyện đó với tôi đấy nhé?!
Dialogue: 0,0:15:54.30,0:15:55.68,Default,Oka,0,0,0,,Cậu đang nói cái quái gì thế hả?!
Dialogue: 0,0:15:56.39,0:15:57.56,Default,Oka,0,0,0,,Này!
Dialogue: 0,0:16:01.18,0:16:02.19,Default,Kyo,0,0,0,,Không được đâu.
Dialogue: 0,0:16:02.19,0:16:06.69,Default,Kyo,0,0,0,,Tôi với cậu... nói sao nhỉ... đâu có hẹn hò gì với nhau đâu.
Dialogue: 0,0:16:07.36,0:16:09.07,Default,Kyo,0,0,0,,Hơn nữa, còn cả chuyện của Ryou nữa...
Dialogue: 0,0:16:09.07,0:16:10.53,Default,Oka,0,0,0,,Dừng lại! Dừng lại mau!
Dialogue: 0,0:16:10.53,0:16:11.44,Default,Oka,0,0,0,,Nghe tôi nói đã nào!
Dialogue: 0,0:16:12.11,0:16:17.33,Default,Kyo,0,0,0,,Dĩ nhiên cậu là con trai,
nên tôi hiểu là cậu có hứng thú với chuyện đó...
Dialogue: 0,0:16:17.78,0:16:21.45,Default,Kyo,0,0,0,,...nhưng tình cảm của hai bên dành cho nhau là điều rất quan trọng trong chuyện này.
Dialogue: 0,0:16:21.45,0:16:23.62,Default,Kyo,0,0,0,,Vả lại, tôi không thể phản bội con bé Ryou được.
Dialogue: 0,0:16:23.62,0:16:25.67,Default,Oka,0,0,0,,Tôi bảo dừng lại cơ mà!
Dialogue: 0,0:16:25.67,0:16:29.30,Default,Oka,0,0,0,,Tôi xin lỗi cậu là vì trò bùa chú lúc nãy thôi!
Dialogue: 0,0:16:29.30,0:16:29.84,Default,Kyo,0,0,0,,Hả?
Dialogue: 0,0:16:29.84,0:16:34.13,Default,Oka,0,0,0,,Có một câu bùa chú sẽ khiến người niệm bị nhốt chung trong kho dụng cụ thể dục với một cô gái.
Dialogue: 0,0:16:34.13,0:16:36.43,Default,Oka,0,0,0,,Cái ánh mắt nhìn như thể đang thương hại một sinh vật thảm hại tội nghiệp đó là sao hả?
Dialogue: 0,0:16:36.43,0:16:39.68,Default,Kyo,0,0,0,,Trên đời này làm quái gì có cái thứ bùa chú chỉ định đích danh oái oăm như thế chứ?
Dialogue: 0,0:16:39.68,0:16:41.31,Default,Oka,0,0,0,,Tôi ban đầu cũng đâu có tin đâu!
Dialogue: 0,0:16:41.31,0:16:43.85,Default,Kyo,0,0,0,,Thế tại sao người đó lại phải là tôi hả?!
Dialogue: 0,0:16:43.85,0:16:45.81,Default,Oka,0,0,0,,Tại vì tôi đã tính đến trường hợp lỡ như nó linh nghiệm thật!
Dialogue: 0,0:16:49.23,0:16:55.07,Default,Kyo,0,0,0,,Hóa ra là thế à? Cậu nghĩ nếu là bị nhốt chung với tôi thì sẽ không sao đúng không?
Dialogue: 0,0:16:57.12,0:16:59.16,Default,Oka,0,0,0,,Chết tiệt, cái bầu không khí mờ ám ngột ngạt này là sao đây?
Dialogue: 0,0:16:59.91,0:17:07.08,Default,Kyo,0,0,0,,Cậu cũng thừa hiểu lý do vì sao ngày nào tôi cũng bắt cậu ăn trưa chung với Ryou rồi đúng không?
Dialogue: 0,0:17:07.08,0:17:08.88,Default,Oka,0,0,0,,Thì... tôi cũng mơ hồ đoán ra được.
Dialogue: 0,0:17:08.88,0:17:10.75,Default,Kyo,0,0,0,,Thế mà tại sao lại là tôi cơ chứ?
Dialogue: 0,0:17:10.75,0:17:12.76,Default,Oka,0,0,0,,Thật lòng là tôi không hề có ý đồ đen tối đó đâu mà.
Dialogue: 0,0:17:28.23,0:17:31.11,Default,Oka,0,0,0,,Này. Nói gì đi chứ!
Dialogue: 0,0:17:31.11,0:17:33.36,Default,Oka,0,0,0,,Cậu làm thế này là phá hỏng hết mục đích tôi chọn cậu rồi đấy.
Dialogue: 0,0:17:33.36,0:17:37.66,Default,Kyo,0,0,0,,Tomoya này. Những việc tôi đang làm để vun vén cho cậu với Ryou có khiến cậu cảm thấy phiền toái không?
Dialogue: 0,0:17:37.66,0:17:39.70,Default,Oka,0,0,0,,Cũng không đến mức phiền phức thế đâu.
Dialogue: 0,0:17:39.70,0:17:41.70,Default,Kyo,0,0,0,,Vậy thì tại sao cậu lại không mặc k—
Dialogue: 0,0:17:41.70,0:17:42.45,Default,Oka,0,0,0,,A đúng rồi!
Dialogue: 0,0:17:42.45,0:17:43.45,Default,Kyo,0,0,0,,Sao thế?
Dialogue: 0,0:17:43.45,0:17:45.12,Default,Oka,0,0,0,,Cậu đừng lo lắng nữa!
Dialogue: 0,0:17:45.12,0:17:46.25,Default,Oka,0,0,0,,Cứ giao hết mọi chuyện cho tôi lo đi!
Dialogue: 0,0:17:45.41,0:17:47.33,Default-alt,Kyo,0,0,0,,T-Tomoya, cậu nói nghiêm túc đấy à?!
Dialogue: 0,0:17:47.33,0:17:49.79,Default,Oka,0,0,0,,Tôi nghiêm túc mà! Cậu không cần phải lo nghĩ gì nữa hết!
Dialogue: 0,0:17:49.79,0:17:54.38,Default,Kyo,0,0,0,,Nhưng mà, con bé Ryou thì... Với lại tôi chưa biết gì nhiều về chuyện này cả...
Dialogue: 0,0:17:54.38,0:17:55.84,Default,Kyo,0,0,0,,Đây cũng là lần đầu tiên của tôi nữa...
Dialogue: 0,0:17:55.84,0:17:58.51,Default,Oka,0,0,0,,Đây cũng là lần đầu tiên của tôi, nhưng cứ để tôi lo!
Dialogue: 0,0:17:58.51,0:18:02.89,Default,Kyo,0,0,0,,C-Cậu mà nhìn tôi bằng ánh mắt nghiêm túc thế kia thì tôi...
Dialogue: 0,0:18:02.89,0:18:05.52,Default,Oka,0,0,0,,Cậu quay mặt đi chỗ khác một lát được không?
Dialogue: 0,0:18:05.98,0:18:06.68,Default,Kyo,0,0,0,,Được rồi.
Dialogue: 0,0:18:08.73,0:18:12.19,Default,Oka,0,0,0,,Nguyền rủa chẳng là cái đinh gì với ta cả. Nguyền rủa chẳng là cái đinh gì với ta cả.
Dialogue: 0,0:18:12.19,0:18:14.92,Default,Oka,0,0,0,,Nguyền rủa chẳng là cái đinh gì với...
Dialogue: 0,0:18:14.92,0:18:15.74,Default,Oka,0,0,0,,...ta cả!
Dialogue: 0,0:18:20.45,0:18:22.33,Default,Girl,0,0,0,,Lớp trưởng có trong này không ạ?
Dialogue: 0,0:18:22.33,0:18:23.87,Default,Girl,0,0,0,,Thầy giáo đang gọi chị kìa.
Dialogue: 0,0:18:23.87,0:18:25.33,Default,Girl,0,0,0,,Hai người đang làm cái gì trong đó thế?
Dialogue: 0,0:18:26.12,0:18:28.12,Default,Kyo,0,0,0,,À, không có gì đâu em.
Dialogue: 0,0:18:30.54,0:18:32.59,Default,Oka,0,0,0,,May quá, cuối cùng cũng thoát ra ngoài được rồi.
Dialogue: 0,0:18:34.30,0:18:37.42,Default,Kyo,0,0,0,,Lúc nãy tôi cũng lo không biết chuyện gì sẽ xảy ra với hai đứa mình nữa.
Dialogue: 0,0:18:37.42,0:18:41.64,Default,Kyo,0,0,0,,Này, tôi xin lỗi nhé. Chắc vừa nãy đầu óc tôi có vấn đề rồi.
Dialogue: 0,0:18:42.76,0:18:45.01,Default,Kyo,0,0,0,,Hãy quên sạch những gì tôi vừa nói đi.
Dialogue: 0,0:18:45.01,0:18:47.27,Default,Oka,0,0,0,,Vốn dĩ tất cả là lỗi do tôi mà.
Dialogue: 0,0:18:47.27,0:18:48.39,Default,Girl,0,0,0,,Lớp trưởng ơi!
Dialogue: 0,0:18:48.89,0:18:51.15,Default,Kyo,0,0,0,,Tôi phải đi đây. Hẹn gặp lại cậu vào ngày mai nhé.
Dialogue: 0,0:18:51.15,0:18:51.77,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:18:54.23,0:18:56.86,Default,Tom,0,0,0,,Okazaki, tụi mình cùng đi bộ về nhé.
Dialogue: 0,0:18:57.78,0:19:00.24,Default,Tom,0,0,0,,Anh đâu cần phải làm bộ mặt kinh ngạc thế.
Dialogue: 0,0:19:00.61,0:19:04.45,Default,Oka,0,0,0,,Này Tomoyo. Chiến dịch tranh cử hội trưởng của em có thuận lợi không?
Dialogue: 0,0:19:04.45,0:19:06.58,Default,Tom,0,0,0,,Sao tự nhiên anh lại hỏi chuyện đó?
Dialogue: 0,0:19:06.58,0:19:11.17,Default,Oka,0,0,0,,À, có chuyện tôi muốn nhờ em giúp
nếu như em đắc cử làm hội trưởng hội học sinh.
Dialogue: 0,0:19:12.58,0:19:13.25,Default,Oka,0,0,0,,Bọn mày là...
Dialogue: 0,0:19:14.42,0:19:15.92,Default,Oka,0,0,0,,Mấy thằng lúc hôm qua!
Dialogue: 0,0:19:15.92,0:19:20.42,Default,Guys,0,0,0,,Không ngờ mày lại dám bén mảng đến địa bàn của tụi tao lần nữa đấy, Sakagami!
Dialogue: 0,0:19:20.76,0:19:22.64,Default,Guys,0,0,0,,Bọn tao tới đây để thanh toán mày trước khi mày kịp ra tay với bọn tao!
Dialogue: 0,0:19:23.14,0:19:24.80,Default,Tom,0,0,0,,Okazaki, anh lùi sang một bên đi.
Dialogue: 0,0:19:24.80,0:19:28.52,Default,Oka,0,0,0,,Không được! Nếu em dính vào đánh nhau, em sẽ mất tư cách ứng cử hội trưởng hội học sinh đấy!
Dialogue: 0,0:19:29.52,0:19:30.39,Default,Oka,0,0,0,,Tomoyo!
Dialogue: 0,0:19:31.31,0:19:33.35,Default,Tom,0,0,0,,Bọn này không phải là loại người chịu lắng nghe bằng lời nói đâu.
Dialogue: 0,0:19:35.77,0:19:38.19,Default,Fuk,0,0,0,,Fuko đã có mặt!
Dialogue: 0,0:19:43.11,0:19:47.79,Default,Fuk,0,0,0,,Cơ hội để thi triển tuyệt kỹ huyền thoại Nhiệt huyết sao biển đã đến!
Dialogue: 0,0:19:48.12,0:19:51.41,Default,Fuk,0,0,0,,Tuyệt kỹ chí mạng: Nhiệt huyết sao biển!
Dialogue: 0,0:19:51.41,0:19:58.17,Default,Fuk,0,0,0,,Fuko đã cất giấu rất nhiều tượng điêu khắc sao biển đáng yêu xung quanh đây.
Dialogue: 0,0:19:58.30,0:20:03.26,Default,Fuk,0,0,0,,Đừng lo, có đủ phần cho tất cả mọi người.
Dialogue: 0,0:20:03.26,0:20:08.06,Default,Fuk,0,0,0,,Nhưng ai muốn có nhiều thì phải chăm chỉ nỗ lực đi tìm nhé.
Dialogue: 0,0:20:08.06,0:20:11.18,Default,Fuk,0,0,0,,Trong đó có cả một con sao biển trúng thưởng có chữ ký của Fuko nữa đấy.
Dialogue: 0,0:20:11.93,0:20:13.85,Default,Fuk,0,0,0,,Nào, hỡi Nhiệt huyết sao biển...
Dialogue: 0,0:20:13.85,0:20:14.94,Default,Fuk,0,0,0,,Bắt đầu!
Dialogue: 0,0:20:15.52,0:20:18.94,Default,Fuk,0,0,0,,Giờ thì bọn họ đang mải mê tìm kiếm sao biển rồi.
Dialogue: 0,0:20:18.94,0:20:21.53,Default,Fuk,0,0,0,,Mọi người sẽ hăng máu lên đến mức lao vào ẩu đả lẫn nhau cho xem.
Dialogue: 0,0:20:21.53,0:20:24.57,Default,Fuk,0,0,0,,Ủa? Chẳng có ai thèm nhúc nhích mảy may gì hết trơn á!
Dialogue: 0,0:20:24.57,0:20:26.28,Default,Fuk,0,0,0,,Fuko thất bại rồi.
Dialogue: 0,0:20:26.70,0:20:28.91,Default,Fuk,0,0,0,,Giờ Fuko đi về nhà được chưa ạ?
Dialogue: 0,0:20:28.91,0:20:29.87,Default,Oka,0,0,0,,Về đi em gái.
Dialogue: 0,0:20:29.87,0:20:30.62,Default,Fuk,0,0,0,,Tạm biệt mọi người nha.
Dialogue: 0,0:20:32.87,0:20:34.04,Default,Oka,0,0,0,,Cái trò quái quỷ gì vừa xảy ra thế?
Dialogue: 0,0:20:34.04,0:20:36.50,Default,Tom,0,0,0,,Nhìn con bé quen quen.
Dialogue: 0,0:20:36.50,0:20:38.00,Default,Sun,0,0,0,,Ồ, chuyện gì thế này?
Dialogue: 0,0:20:38.00,0:20:40.46,Default,Sun,0,0,0,,Bộ hai người đang thiếu người giúp sức đấy à?
Dialogue: 0,0:20:40.46,0:20:42.55,Default,Oka,0,0,0,,Lại thêm một tên thích làm phức tạp hóa vấn đề mò đến nữa rồi.
Dialogue: 0,0:20:42.55,0:20:44.80,Default,Tom,0,0,0,,Dù sao thì sức của anh cũng quá yếu ớt để giúp được gì mà.
Dialogue: 0,0:20:44.80,0:20:46.09,Default,Sun,0,0,0,,Đừng nói phũ thế chứ.
Dialogue: 0,0:20:46.09,0:20:49.35,Default,Sun,0,0,0,,Đúng là bình thường tụi mình hay cắn xé nhau, nhưng—
Dialogue: 0,0:20:49.35,0:20:51.81,Default,Oka,0,0,0,,Mày chỉ toàn là đứa bị đập tơi bời thôi.
Dialogue: 0,0:20:51.81,0:20:53.94,Default,Sun,0,0,0,,Thỉnh thoảng tao cũng có phản kháng lại chứ bộ!
Dialogue: 0,0:20:53.94,0:20:56.06,Default,Tom,0,0,0,,Sao cũng được. Anh nói tiếp vế sau đi.
Dialogue: 0,0:20:56.65,0:21:00.02,Default,Sun,0,0,0,,Đúng là bình thường tụi mình hay cắn xé nhau, nhưng...
Dialogue: 0,0:20:58.19,0:21:00.73,Default-alt,Oka,0,0,0,,Nó cứ phải bắt đầu từ chỗ đó thì mới nói chuẩn được à?
Dialogue: 0,0:21:00.73,0:21:04.24,Default,Sun,0,0,0,,...khi đối đầu với trường khác, chúng ta là một khối đoàn kết!
Dialogue: 0,0:21:04.24,0:21:05.11,Default,Tom,0,0,0,,Anh chỉ vướng chân vướng tay thêm thôi.
Dialogue: 0,0:21:05.11,0:21:08.16,Default,Sun,0,0,0,,Tao hứa là sẽ không cản đường đâu, cho tao nhập bọn với đi.
Dialogue: 0,0:21:08.16,0:21:10.91,Default,Guy,0,0,0,,Mấy người tính diễn hài kịch đến bao giờ nữa hả?!
Dialogue: 0,0:21:10.91,0:21:13.62,Default,Guy,0,0,0,,Kệ mẹ tụi nó, xông lên đập chết hết đi!
Dialogue: 0,0:21:15.04,0:21:16.67,Default,Sun,0,0,0,,Được rồi, cứ để tao lo!
Dialogue: 0,0:21:22.26,0:21:25.22,Default,Sun,0,0,0,,Tao ở cùng phe với mày mà...
Dialogue: 0,0:21:25.22,0:21:26.80,Default,Tom,0,0,0,,Tôi không phân biệt kịp!
Dialogue: 0,0:21:26.80,0:21:27.84,Default,Tom,0,0,0,,Thứ lỗi cho tôi nhé!
Dialogue: 0,0:21:28.68,0:21:31.64,Default,Guy,0,0,0,,C-Con nhỏ này bất chấp cả cùng phe hay khác phe luôn kìa.
Dialogue: 0,0:21:31.64,0:21:33.85,Default,Guy,0,0,0,,Bỏ mẹ rồi, nó điên thật rồi.
Dialogue: 0,0:21:35.48,0:21:36.02,Default,Oka,0,0,0,,Tomoyo!
Dialogue: 0,0:21:37.52,0:21:38.94,Default,Oog,0,0,0,,Mấy đứa kia!
Dialogue: 0,0:21:41.19,0:21:43.03,Default,Oka,0,0,0,,Chết tiệt, chạy mau!
Dialogue: 0,0:21:45.36,0:21:47.15,Default,Oog,0,0,0,,Chuyện này là thế nào hả?!
Dialogue: 0,0:21:50.62,0:21:53.62,Default,Oog,0,0,0,,Okazaki, lại là em nữa đấy à?!
Dialogue: 0,0:21:53.62,0:21:55.33,Default,Tom,0,0,0,,Không phải đâu thầy, chuyện này là do em—
Dialogue: 0,0:21:55.33,0:21:57.87,Default,Oka,0,0,0,,Đúng thế ạ. Chính em là người khơi mào đấy.
Dialogue: 0,0:21:57.87,0:22:00.17,Default,Oka,0,0,0,,Con bé khóa dưới đang đứng kia hoàn toàn không liên quan gì đến vụ này cả.
Dialogue: 0,0:22:00.17,0:22:03.67,Default,Oog,0,0,0,,Em đã có tiền án tiền sự rồi. Lần này chắc chắn sẽ bị đình chỉ học.
Dialogue: 0,0:22:03.67,0:22:04.92,Default,Oog,0,0,0,,Liệu mà chuẩn bị tinh thần gánh chịu hậu quả đi.
