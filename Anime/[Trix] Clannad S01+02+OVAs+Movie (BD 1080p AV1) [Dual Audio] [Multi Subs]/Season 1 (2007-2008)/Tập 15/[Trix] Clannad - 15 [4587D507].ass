Dialogue: 0,0:03:00.36,0:03:02.11,Default,Oka,0,0,0,,Chỉ mượn tên thôi á?
Dialogue: 0,0:03:02.11,0:03:03.78,Default,Sun,0,0,0,,Cậu ấy chỉ cần đủ số lượng thôi đúng không?
Dialogue: 0,0:03:03.78,0:03:07.58,Default,Sun,0,0,0,,Tao thì chẳng hứng thú gì với diễn kịch đâu,
nhưng nếu chỉ là đứng tên hộ thì tao không phiền.
Dialogue: 0,0:03:07.58,0:03:10.29,Default,Sun,0,0,0,,Chắc chắn Nagisa-chan sẽ biết ơn tao lắm cho xem.
Dialogue: 0,0:03:10.29,0:03:12.67,Default,Sun,0,0,0,,Rồi một ngày nào đó, lòng biết ơn ấy sẽ thăng hoa thành tình yêu.
Dialogue: 0,0:03:13.96,0:03:16.67,Default,Sun,0,0,0,,Nagisa-chan! Tao có tin vui cho cậu đây!
Dialogue: 0,0:03:16.67,0:03:21.09,Default,Kyo,0,0,0,,Tomoya, bọn này quyết định cho mượn tên vào CLB kịch rồi nhé.
Dialogue: 0,0:03:23.93,0:03:29.27,Default,Kyo,0,0,0,,Thực lòng thì bọn này không hứng thú diễn kịch đâu, chỉ để cho đủ chỉ tiêu thôi.
Dialogue: 0,0:03:29.56,0:03:31.31,Default,Ryo,0,0,0,,Vậy là đã có bốn thành viên rồi.
Dialogue: 0,0:03:31.31,0:03:34.40,Default,Ryo,0,0,0,,Đủ điều kiện để hội học sinh công nhận rồi đó.
Dialogue: 0,0:03:34.40,0:03:39.82,Default,Nag,0,0,0,,Thật lòng thì tớ thấy áy náy lắm,
cứ như chúng ta đang lừa dối họ vậy.
Dialogue: 0,0:03:39.82,0:03:41.36,Default,Kyo,0,0,0,,Cậu thật thà quá mức rồi đấy!
Dialogue: 0,0:03:41.36,0:03:43.66,Default,Oka,0,0,0,,Mọi người đều thật lòng muốn giúp cậu mà,
Dialogue: 0,0:03:43.66,0:03:45.66,Default,Oka,0,0,0,,Nên đừng phụ tấm lòng của họ, Nagisa.
Dialogue: 0,0:03:45.66,0:03:49.29,Default,Kyo,0,0,0,,Đã quyết định rồi thì hành động ngay thôi!
Dialogue: 0,0:03:49.29,0:03:50.83,Default,Kyo,0,0,0,,Đi nào!
Dialogue: 0,0:03:50.83,0:03:53.33,Default,Oka,0,0,0,,Cậu phải tỏ ra mạnh mẽ lên chứ, Nagisa.
Dialogue: 0,0:03:50.83,0:03:52.08,Default-alt,Nag,0,0,0,,Vâng...
Dialogue: 0,0:03:52.08,0:03:53.87,Default-alt,Kyo,0,0,0,,Cả cậu nữa, nhúc nhích nhanh lên, Tomoya.
Dialogue: 0,0:03:53.87,0:03:54.71,Default,Oka,0,0,0,,Rõ rồi, thưa bà chị.
Dialogue: 0,0:03:56.46,0:04:00.13,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410)\3c&H4A8A5C&}Tập 15
Dialogue: 0,0:03:56.46,0:04:00.13,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Vấn đề bế tắc
Dialogue: 0,0:04:00.13,0:04:04.43,Default,Kou,0,0,0,,Ồ, các em muốn tái lập CLB kịch à?
Dialogue: 0,0:04:04.43,0:04:07.26,Default,Kyo,0,0,0,,Vâng ạ. Tụi em muốn tham gia Lễ hội trường.
Dialogue: 0,0:04:07.26,0:04:08.76,Default,Oka,0,0,0,,Tụi em đã tập hợp đủ số lượng thành viên rồi ạ.
Dialogue: 0,0:04:08.76,0:04:12.98,Default,Oka,0,0,0,,Giờ chỉ còn cần một giáo viên cố vấn
để hội học sinh chính thức công nhận thôi ạ.
Dialogue: 0,0:04:12.98,0:04:16.44,Default,Nag,0,0,0,,Thầy có thể nhận làm cố vấn cho tụi em được không ạ?
Dialogue: 0,0:04:18.61,0:04:23.32,Default,Kou,0,0,0,,Các em có thể đến bàn bạc việc này
với một em khóa dưới tên là Nishina Rie được không?
Dialogue: 0,0:04:23.70,0:04:25.45,Default,Ryo,0,0,0,,Nishina Rie-san ạ?
Dialogue: 0,0:04:25.45,0:04:28.70,Default,Kot,0,0,0,,Là Nishina-san đã cho mình mượn cây vĩ cầm sao?
Dialogue: 0,0:04:32.20,0:04:33.46,Default,Nis,0,0,0,,Ichinose-san.
Dialogue: 0,0:04:36.92,0:04:39.38,Default,Kot,0,0,0,,Nishina-san, chào cậu.
Dialogue: 0,0:04:39.71,0:04:42.46,Default,Nis,0,0,0,,Lâu quá không gặp. Hôm nay có chuyện gì đưa cậu tới đây thế?
Dialogue: 0,0:04:42.46,0:04:43.92,Default,Kot,0,0,0,,Hôm nay không phải việc của mình đâu.
Dialogue: 0,0:04:44.26,0:04:46.89,Default,Kot,0,0,0,,Nagisa-chan muốn nói chuyện với cậu đấy.
Dialogue: 0,0:04:47.18,0:04:50.35,Default,Nag,0,0,0,,Tớ là Furukawa Nagisa lớp 3-B.
Dialogue: 0,0:04:50.35,0:04:54.23,Default,Nag,0,0,0,,Tớ vẫn chưa nắm rõ tình hình cho lắm, nhưng...
Dialogue: 0,0:04:54.85,0:04:58.44,Default,Nag,0,0,0,,Ừm, tớ có thể nói chuyện riêng với cậu một lát được không?
Dialogue: 0,0:04:58.86,0:05:03.90,Default,Nag,0,0,0,,Tớ nghĩ cả đám tiền bối kéo đến thế này sẽ khiến các em ấy không được thoải mái.
Dialogue: 0,0:05:16.87,0:05:18.13,Default,Oka,0,0,0,,Sao rồi Nagisa, mọi chuyện thế nào?
Dialogue: 0,0:05:18.96,0:05:20.38,Default,Nag,0,0,0,,Dạ, chuyện là...
Dialogue: 0,0:05:20.38,0:05:22.38,Default,Girl,0,0,0,,Rie-chan, cậu tính làm sao đây?
Dialogue: 0,0:05:22.75,0:05:27.88,Default,Girl,0,0,0,,Bọn mình đến nhờ thầy Koumura trước mà, đâu việc gì phải nhường chứ.
Dialogue: 0,0:05:28.26,0:05:32.14,Default,Nis,0,0,0,,Nhưng vốn dĩ thầy Koumura từng là giáo viên cố vấn của CLB kịch,
Dialogue: 0,0:05:32.14,0:05:36.69,Default,Nis,0,0,0,,với lại các anh chị ấy chỉ còn mỗi năm học này thôi.
Dialogue: 0,0:05:36.69,0:05:40.27,Default,Girl,0,0,0,,Cậu nghiêm túc đấy à?! Nếu thế bọn mình có thể sẽ không thành lập được CLB hợp xướng đâu!
Dialogue: 0,0:05:40.27,0:05:42.90,Default,Girl,0,0,0,,Cậu không thể từ bỏ việc ca hát được!
Dialogue: 0,0:05:43.36,0:05:47.95,Default,Nis,0,0,0,,Bởi vậy bọn mình mới phải nghĩ cách để tất cả mọi người đều có thể vui vẻ chứ.
Dialogue: 0,0:05:47.95,0:05:48.57,Default,Nis,0,0,0,,Đúng không nào?
Dialogue: 0,0:05:50.74,0:05:52.08,Default,Kot,0,0,0,,CLB hợp xướng sao?
Dialogue: 0,0:05:52.08,0:05:59.17,Default,Nag,0,0,0,,Vâng ạ. Các em ấy muốn thành lập CLB hợp xướng
và đã đến nhờ thầy Koumura làm giáo viên cố vấn.
Dialogue: 0,0:05:59.17,0:06:03.50,Default,Oka,0,0,0,,Chẳng phải giáo viên dạy nhạc thường sẽ phụ trách CLB hợp xướng sao?
Dialogue: 0,0:06:03.50,0:06:08.93,Default,Ryo,0,0,0,,Cô giáo dạy nhạc hiện đã bận tối mắt với dàn nhạc giao hưởng rồi ạ.
Dialogue: 0,0:06:08.93,0:06:13.01,Default,Ryo,0,0,0,,Giáo viên duy nhất hiện tại chưa nhận làm cố vấn cho CLB nào chỉ còn thầy Koumura thôi.
Dialogue: 0,0:06:13.01,0:06:15.52,Default,Kyo,0,0,0,,Vậy giờ cậu tính sao đây, Nagisa?
Dialogue: 0,0:06:15.52,0:06:18.31,Default,Kyo,0,0,0,,Cậu sẽ không lùi bước lúc này đấy chứ?
Dialogue: 0,0:06:21.48,0:06:22.77,Default,Mis,0,0,0,,Sunohara có ở đây không em?
Dialogue: 0,0:06:24.11,0:06:26.03,Default,Oka,0,0,0,,Dạ không, cậu ấy vẫn chưa về chị ạ.
Dialogue: 0,0:06:26.65,0:06:28.70,Default,Mis,0,0,0,,Có điện thoại từ em gái cậu ấy gọi tới này.
Dialogue: 0,0:06:28.70,0:06:31.82,Default,Mis,0,0,0,,Em nhận lời nhắn giúp nó được không?
Dialogue: 0,0:06:32.20,0:06:35.33,Default,Oka,0,0,0,,À ra vậy, nó cũng có em gái cơ à?
Dialogue: 0,0:06:35.33,0:06:37.62,Default,Oka,0,0,0,,Là em gái của tên đó thì tao dám cá chắc cũng kiểu...
Dialogue: 0,0:06:37.91,0:06:39.62,Default,Oka,0,0,0,,“Là em đây, Onii-chan.”
Dialogue: 0,0:06:41.25,0:06:43.88,Default,Oka,0,0,0,,...đại loại thế; một con nhóc cực kỳ ma mãnh cho xem.
Dialogue: 0,0:06:43.88,0:06:45.88,Default,Mis,0,0,0,,Em đừng có làm con mèo của chị sợ được không?
Dialogue: 0,0:06:49.09,0:06:50.30,Default,Mei,0,0,0,,Hả?
Dialogue: 0,0:06:50.30,0:06:52.64,Default,Oka,0,0,0,,Xem ra mình có thể chào hỏi bình thường rồi.
Dialogue: 0,0:06:53.26,0:06:55.60,Default,Mei,0,0,0,,Alo? Anh hai đấy phải không?
Dialogue: 0,0:06:55.60,0:07:01.06,Default,Oka,0,0,0,,Phải. Anh hai của em, Sunohara Youhei, kẻ thất bại vĩ đại nhất cuộc đời, đang nghe đây.
Dialogue: 0,0:07:01.06,0:07:02.52,Default,Mei,0,0,0,,Anh đang lảm nhảm cái gì thế?
Dialogue: 0,0:07:02.94,0:07:04.65,Default,Oka,0,0,0,,Con bé không mắc bẫy rồi.
Dialogue: 0,0:07:05.11,0:07:09.24,Default,Mei,0,0,0,,Anh hai này, ngày mốt em định lên thăm anh đấy.
Dialogue: 0,0:07:09.24,0:07:12.82,Default,Oka,0,0,0,,Xin lỗi em gái nhé. Hiện tại anh đang phải bóc lịch trong tù rồi.
Dialogue: 0,0:07:12.82,0:07:14.53,Default,Oka,0,0,0,,Anh vừa bị tóm vì làm mấy trò ngu ngốc xong.
Dialogue: 0,0:07:14.53,0:07:16.49,Default,Mei,0,0,0,,Lại thế nữa rồi, anh lại cố tình đánh trống lảng.
Dialogue: 0,0:07:16.49,0:07:18.37,Default,Mei,0,0,0,,Dù anh có nói gì thì em vẫn sẽ lên đấy nhé.
Dialogue: 0,0:07:18.37,0:07:19.87,Default,Mei,0,0,0,,Anh có muốn em mang món gì lên cho không?
Dialogue: 0,0:07:19.87,0:07:20.66,Default,Oka,0,0,0,,Một con búp bê đất sét.
Dialogue: 0,0:07:21.08,0:07:22.79,Default,Mei,0,0,0,,Anh thích thứ đó cơ à?
Dialogue: 0,0:07:22.79,0:07:24.00,Default,Oka,0,0,0,,Ừ, làm ơn mang lên nhé.
Dialogue: 0,0:07:24.96,0:07:27.55,Default,Mei,0,0,0,,Nếu anh đã nói thế thì em sẽ mang lên.
Dialogue: 0,0:07:27.55,0:07:29.30,Default,Oka,0,0,0,,Em vẫn chưa nhận ra à?
Dialogue: 0,0:07:29.30,0:07:31.47,Default,Oka,0,0,0,,Anh đâu phải anh hai của em, mà là—
Dialogue: 0,0:07:30.47,0:07:33.09,Default-alt,Mei,0,0,0,,Á, mẹ đang gọi rồi, em cúp máy đây nhé.
Dialogue: 0,0:07:33.22,0:07:34.68,Default-alt,Mei,0,0,0,,Hẹn gặp lại anh ngày mốt nha.
Dialogue: 0,0:07:34.68,0:07:36.05,Default,Oka,0,0,0,,Này! Alo!
Dialogue: 0,0:07:37.14,0:07:38.10,Default,Oka,0,0,0,,Chết dở thật.
Dialogue: 0,0:07:38.89,0:07:40.27,Default,Oka,0,0,0,,Thôi kệ đi.
Dialogue: 0,0:07:43.81,0:07:47.32,Default,Sun,0,0,0,,Mấy đứa chúng mày ác vừa thôi chứ, bỏ quên tao rồi về hết.
Dialogue: 0,0:07:47.32,0:07:50.28,Default,Sun,0,0,0,,Lúc tao tỉnh dậy thì phòng học tối thui tối mò rồi.
Dialogue: 0,0:07:50.28,0:07:53.99,Default,Sun,0,0,0,,Tao thì đói meo, lúc định về thì cổng trường đã đóng chặt.
Dialogue: 0,0:07:54.41,0:07:56.53,Default,Sun,0,0,0,,Này Okazaki, mày có đang nghe tao nói không đấy?
Dialogue: 0,0:08:00.00,0:08:01.91,Default,Sun,0,0,0,,Nagisa-chan, cậu đang đọc cái gì thế?
Dialogue: 0,0:08:02.62,0:08:04.67,Default,Sun,0,0,0,,Lẽ nào là thư tình sao?
Dialogue: 0,0:08:05.13,0:08:06.50,Default,Sun,0,0,0,,Để xem nào...
Dialogue: 0,0:08:08.30,0:08:11.55,Default,Sun,0,0,0,,“Hãy từ bỏ việc thành lập CLB kịch đi. Bằng không cô sẽ phải chịu đau đớn đấy.”
Dialogue: 0,0:08:11.55,0:08:12.88,Default,Oka,0,0,0,,Thư đe dọa à?
Dialogue: 0,0:08:15.72,0:08:20.31,Default,Nag,0,0,0,,Nó nằm trong hộc bàn khi tớ quay lại sau tiết thể dục.
Dialogue: 0,0:08:20.31,0:08:21.73,Default,Nag,0,0,0,,Ai lại làm chuyện này cơ chứ...
Dialogue: 0,0:08:21.73,0:08:26.27,Default,Sun,0,0,0,,Nếu đang tranh chấp giáo viên cố vấn với CLB hợp xướng, thì đích thị là do bọn họ rồi.
Dialogue: 0,0:08:26.56,0:08:30.28,Default,Nag,0,0,0,,Chưa có chứng cứ gì thì chúng ta không thể nói bừa như thế được!
Dialogue: 0,0:08:30.28,0:08:31.53,Default,Nag,0,0,0,,Bạn ấy...
Dialogue: 0,0:08:31.90,0:08:34.28,Default,Nag,0,0,0,,Họ tuyệt đối không đời nào làm ra chuyện như vậy đâu!
Dialogue: 0,0:08:34.28,0:08:37.03,Default,Nag,0,0,0,,Các bạn ấy đang cùng nhau nỗ lực để được hát mà!
Dialogue: 0,0:08:37.03,0:08:39.24,Default,Nag,0,0,0,,Nên họ sẽ không bao giờ làm điều hèn hạ đó đâu!
Dialogue: 0,0:08:41.54,0:08:45.79,Default,Nag,0,0,0,,Với lại Nishina-san cũng đối xử rất tốt với Kotomi-chan nữa.
Dialogue: 0,0:08:46.79,0:08:48.54,Default,Sun,0,0,0,,Cậu có dám chắc chắn được như vậy không?
Dialogue: 0,0:08:49.34,0:08:51.00,Default,Oka,0,0,0,,Mày định đi đâu đấy?
Dialogue: 0,0:08:51.00,0:08:52.80,Default,Sun,0,0,0,,Tao sẽ điều tra vụ này theo cách của tao.
Dialogue: 0,0:08:52.80,0:08:56.01,Default,Sun,0,0,0,,Tao nghĩ đến lúc tan trường là sẽ có kết quả báo cáo thôi, cứ chờ mà xem.
Dialogue: 0,0:08:56.38,0:08:57.68,Default,Oka,0,0,0,,Này, đợi đã!
Dialogue: 0,0:08:57.68,0:09:00.18,Default,Sun,0,0,0,,Đừng lo, tao không làm gì thô bạo đâu.
Dialogue: 0,0:09:00.18,0:09:02.27,Default,Sun,0,0,0,,Dù sao tao cũng là người dịu dàng với con gái mà lị.
Dialogue: 0,0:09:03.27,0:09:08.69,Default,Nag,0,0,0,,Okazaki-san, cậu có nghĩ chuyện này là do Nishina-san và các bạn ấy làm không?
Dialogue: 0,0:09:12.28,0:09:14.53,Default,Sun,0,0,0,,Đúng là người của CLB hợp xướng thật rồi.
Dialogue: 0,0:09:14.53,0:09:16.11,Default,Sun,0,0,0,,Một đứa con gái tên Sugisaka.
Dialogue: 0,0:09:16.11,0:09:17.66,Default,Oka,0,0,0,,Mày có bằng chứng không?
Dialogue: 0,0:09:17.66,0:09:23.79,Default,Sun,0,0,0,,Bạn cùng lớp đã tận mắt thấy cô ta lẻn vào lớp khóa trên
và nhét thứ gì đó vào trong hộc bàn.
Dialogue: 0,0:09:23.79,0:09:25.54,Default,Sun,0,0,0,,Nói trước là tao không bịa chuyện đâu đấy nhé.
Dialogue: 0,0:09:27.12,0:09:29.50,Default,Sun,0,0,0,,A, cô ta đến rồi.
Dialogue: 0,0:09:30.75,0:09:32.59,Default,Sun,0,0,0,,Tao đã gọi cô ta ra đây.
Dialogue: 0,0:09:33.92,0:09:35.97,Default,Sun,0,0,0,,Tốt lắm, cô dám đến một mình đấy.
Dialogue: 0,0:09:36.47,0:09:39.64,Default,Sug,0,0,0,,Bức thư đó là do một mình tôi tự ý làm.
Dialogue: 0,0:09:40.10,0:09:42.06,Default,Sug,0,0,0,,Chuyện này hoàn toàn không liên quan gì đến hai người kia cả.
Dialogue: 0,0:09:42.06,0:09:44.02,Default,Sug,0,0,0,,Chỉ có một mình tôi là người làm sai thôi!
Dialogue: 0,0:09:44.02,0:09:47.02,Default,Sun,0,0,0,,Cô nghĩ chuyện đó bây giờ còn quan trọng sao?
Dialogue: 0,0:09:47.02,0:09:51.02,Default,Sun,0,0,0,,Ai cũng chẳng chịu nghĩ cho chín chắn, làm tôi phát ngấy lên rồi đây.
Dialogue: 0,0:09:51.02,0:09:52.19,Default,Oka,0,0,0,,Bình tĩnh lại chút đi, Sunohara.
Dialogue: 0,0:09:52.19,0:09:54.40,Default,Nag,0,0,0,,Xin cậu hãy đợi đã, Sunohara-san!
Dialogue: 0,0:09:57.65,0:10:00.41,Default,Nag,0,0,0,,Hôm qua chúng ta đã gặp nhau ở phòng nhạc đúng không?
Dialogue: 0,0:10:00.41,0:10:02.33,Default,Nag,0,0,0,,Hãy cùng nói chuyện đàng hoàng đi.
Dialogue: 0,0:10:05.79,0:10:12.59,Default,Sug,0,0,0,,Nishina-san từ nhỏ đã chơi vĩ cầm và từng đoạt rất nhiều giải thưởng ở các cuộc thi.
Dialogue: 0,0:10:13.63,0:10:18.30,Default,Sug,0,0,0,,Tài năng của cậu ấy được rất nhiều người công nhận,
và cậu ấy cũng đã từng chuẩn bị đi du học nữa.
Dialogue: 0,0:10:18.97,0:10:21.30,Default,Sug,0,0,0,,Thế nhưng ngay trước khi ước mơ ấy trở thành hiện thực...
Dialogue: 0,0:10:22.85,0:10:24.47,Default,Sug,0,0,0,,...thì cậu ấy gặp phải một tai nạn.
Dialogue: 0,0:10:25.18,0:10:27.10,Default,Sug,0,0,0,,Lực tay của cậu ấy bị yếu đi.
Dialogue: 0,0:10:29.31,0:10:33.23,Default,Sug,0,0,0,,Cậu ấy không còn có thể kéo đàn vĩ cầm giỏi như trước đây được nữa,
Dialogue: 0,0:10:34.52,0:10:38.40,Default,Sug,0,0,0,,thế nên cậu ấy mới vào học ở ngôi trường này,
nhưng lúc nào trông cậu ấy cũng đầy vẻ cô đơn.
Dialogue: 0,0:10:39.49,0:10:42.99,Default,Sug,0,0,0,,Chính vì thế bọn tôi mới quyết định thành lập CLB hợp xướng!
Dialogue: 0,0:10:43.37,0:10:46.08,Default,Sug,0,0,0,,Cậu ấy có thể không chơi vĩ cầm được nữa, nhưng cậu ấy có thể hát!
Dialogue: 0,0:10:46.08,0:10:49.08,Default,Sug,0,0,0,,Và giọng hát của cậu ấy thật sự rất tuyệt vời!
Dialogue: 0,0:10:50.25,0:10:53.46,Default,Sug,0,0,0,,Làm ơn đi! Xin đừng cản trở con đường của Rie-chan nữa!
Dialogue: 0,0:10:55.34,0:10:55.92,Default,Nag,0,0,0,,Ừm...
Dialogue: 0,0:10:55.96,0:10:57.96,Default,Sun,0,0,0,,Cậu không cần phải nghe những lời của hạng người như cô ta đâu!
Dialogue: 0,0:10:59.30,0:11:03.80,Default,Sun,0,0,0,,Kẻ cố tình mang chuyện đó ra để khơi gợi lòng thương hại từ người khác chỉ là đồ gian lận thôi!
Dialogue: 0,0:11:04.22,0:11:08.81,Default,Sun,0,0,0,,Thật hèn hạ khi mong đợi người ta phải nhượng bộ
chỉ vì bản thân có một khiếm khuyết như thế!
Dialogue: 0,0:11:11.31,0:11:12.48,Default,Oka,0,0,0,,Sunohara...
Dialogue: 0,0:11:13.73,0:11:15.11,Default,Sun,0,0,0,,Cái thứ khiếm khuyết đó...
Dialogue: 0,0:11:21.53,0:11:24.70,Default,Nag,0,0,0,,Tớ không thể cản trở Nishina-san được.
Dialogue: 0,0:11:25.41,0:11:27.45,Default,Sun,0,0,0,,Cậu đâu có làm gì sai hả Nagisa-chan!
Dialogue: 0,0:11:27.45,0:11:29.91,Default,Sun,0,0,0,,Hãy quên sạch những gì cô ta vừa nói đi!
Dialogue: 0,0:11:29.91,0:11:30.71,Default,Nag,0,0,0,,Nhưng...
Dialogue: 0,0:11:31.37,0:11:33.21,Default,Nag,0,0,0,,...tớ đã trót nghe hết rồi.
Dialogue: 0,0:11:34.71,0:11:40.76,Default,Nag,0,0,0,,CLB hợp xướng đang thực sự nghiêm túc hướng tới âm nhạc,
trong khi CLB kịch thì...
Dialogue: 0,0:11:43.26,0:11:46.22,Default,Nag,0,0,0,,Sugisaka-san. Tớ sẽ từ bỏ CLB kịch.
Dialogue: 0,0:11:46.22,0:11:47.93,Default,Sug,0,0,0,,Furukawa-san...
Dialogue: 0,0:11:47.93,0:11:52.48,Default,Nag,0,0,0,,Nên các cậu hãy cùng Nishina-san tạo nên một CLB hợp xướng thật tuyệt vời nhé.
Dialogue: 0,0:11:54.31,0:11:55.61,Default,Oka,0,0,0,,Sunohara!
Dialogue: 0,0:12:01.57,0:12:03.53,Default,Oka,0,0,0,,Sunohara cũng giống như tớ vậy.
Dialogue: 0,0:12:04.11,0:12:08.62,Default,Oka,0,0,0,,Cậu ấy vào trường theo diện tuyển thẳng thể thao, rồi cuối cùng cũng phải bỏ cuộc.
Dialogue: 0,0:12:08.62,0:12:10.50,Default,Nag,0,0,0,,Sunohara-san từng như thế sao?
Dialogue: 0,0:12:10.50,0:12:12.29,Default,Oka,0,0,0,,Cậu ấy từng ở trong đội bóng đá.
Dialogue: 0,0:12:12.29,0:12:16.46,Default,Oka,0,0,0,,Nhưng vì va chạm với các tiền bối khóa trên, lao vào ẩu đả, nên đã phải rời đội.
Dialogue: 0,0:12:17.00,0:12:18.71,Default,Oka,0,0,0,,Phần còn lại thì cũng y hệt như câu chuyện của tớ.
Dialogue: 0,0:12:18.71,0:12:21.63,Default,Oka,0,0,0,,Chẳng còn việc gì để làm và cứ thế sống buông thả qua ngày.
Dialogue: 0,0:12:22.01,0:12:23.88,Default,Nag,0,0,0,,Ra là vậy...
Dialogue: 0,0:12:23.88,0:12:28.22,Default,Oka,0,0,0,,Cậu ấy cũng giống ở chỗ đã phải từ bỏ ước mơ giữa chừng.
Dialogue: 0,0:12:28.81,0:12:32.14,Default,Oka,0,0,0,,Thế nên cậu ấy không thể tha thứ cho việc có người lợi dụng khiếm khuyết ấy để mưu lợi.
Dialogue: 0,0:12:34.19,0:12:37.23,Default,Oka,0,0,0,,Này, liệu đây thực sự là lựa chọn tốt nhất sao?
Dialogue: 0,0:12:41.36,0:12:42.57,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:12:42.57,0:12:43.53,Default,Oka,0,0,0,,Gì thế?
Dialogue: 0,0:12:43.53,0:12:48.07,Default,Nag,0,0,0,,Khoảng thời gian nỗ lực cùng cậu suốt thời gian qua thực sự rất vui.
Dialogue: 0,0:12:48.78,0:12:55.83,Default,Nag,0,0,0,,Tuy tớ không thể tái lập lại CLB kịch,
nhưng tớ đã tìm thấy rất nhiều điều quý giá hơn thế.
Dialogue: 0,0:12:56.50,0:12:59.34,Default,Nag,0,0,0,,Tớ đã có thể trở nên thân thiết với Okazaki-san...
Dialogue: 0,0:12:59.71,0:13:04.01,Default,Nag,0,0,0,,...và cả với Kyou-chan, Ryou-chan,
Kotomi-chan, cùng với Sunohara-san nữa.
Dialogue: 0,0:13:05.01,0:13:11.06,Default,Nag,0,0,0,,Nhờ có cậu mà ngay cả người như tớ cũng đã có thể cố gắng đến nhường này.
Dialogue: 0,0:13:11.06,0:13:13.56,Default,Oka,0,0,0,,Tớ đã làm được gì đâu.
Dialogue: 0,0:13:13.56,0:13:15.52,Default,Nag,0,0,0,,Không phải thế đâu.
Dialogue: 0,0:13:15.85,0:13:17.60,Default,Oka,0,0,0,,Chính bản thân cậu mới là người đã trở nên kiên cường hơn.
Dialogue: 0,0:13:18.10,0:13:20.61,Default,Oka,0,0,0,,Mạnh mẽ hơn rất nhiều so với cái ngày
cậu đứng chôn chân ở chân dốc ngày hôm ấy.
Dialogue: 0,0:13:21.32,0:13:24.99,Default,Oka,0,0,0,,Dù vụng về và hay khóc nhè, cậu vẫn luôn dốc lòng nỗ lực để đi được đến tận đây.
Dialogue: 0,0:13:24.99,0:13:26.99,Default,Oka,0,0,0,,Chính vì thế mà cậu mới trở nên mạnh mẽ như bây giờ.
Dialogue: 0,0:13:26.99,0:13:31.74,Default,Nag,0,0,0,,Nếu như không có cậu ở bên,
tớ đã chẳng thể làm được bất cứ điều gì cả.
Dialogue: 0,0:13:36.71,0:13:38.08,Default,Nag,0,0,0,,Tớ xin lỗi...
Dialogue: 0,0:13:38.46,0:13:40.21,Default,Nag,0,0,0,,Tớ không cố ý khóc đâu...
Dialogue: 0,0:13:40.75,0:13:41.80,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:13:53.52,0:13:55.31,Default,Kyo,0,0,0,,Này!
Dialogue: 0,0:13:55.56,0:13:57.27,Default,Kyo,0,0,0,,Tôi nghe Youhei kể hết rồi nhé!
Dialogue: 0,0:13:57.27,0:14:01.65,Default,Kyo,0,0,0,,Cậu mềm lòng trước mấy giọt nước mắt của nhỏ bên hợp xướng rồi nhường thầy Koumura cho bọn họ đấy à?
Dialogue: 0,0:14:01.65,0:14:03.90,Default,Kyo,0,0,0,,Sao cậu lại nhu nhược thế hả?!
Dialogue: 0,0:14:03.90,0:14:07.40,Default,Kyo,0,0,0,,Nếu cứ luôn nghĩ cho người khác như thế, cậu sẽ chẳng bao giờ thực hiện được ước mơ của mình đâu!
Dialogue: 0,0:14:10.16,0:14:12.58,Default,Sun,0,0,0,,Tao cũng nuốt không trôi cục tức này.
Dialogue: 0,0:14:12.58,0:14:17.54,Default,Sun,0,0,0,,Nếu Nagisa-chan không chịu làm,
thì tao sẽ dùng vũ lực đập tan tành cái CLB hợp xướng đó luôn.
Dialogue: 0,0:14:17.54,0:14:19.25,Default,Oka,0,0,0,,Đó là điều duy nhất mày tuyệt đối không được phép làm.
Dialogue: 0,0:14:19.25,0:14:21.33,Default,Oka,0,0,0,,Làm vậy chỉ khiến Nagisa càng buồn thêm thôi.
Dialogue: 0,0:14:21.96,0:14:23.63,Default,Sun,0,0,0,,Tao chịu hết nổi rồi!
Dialogue: 0,0:14:23.63,0:14:26.30,Default,Sun,0,0,0,,Okazaki, đi quậy phá giải khuây ở đâu đó đi.
Dialogue: 0,0:14:26.30,0:14:30.84,Default,Oka,0,0,0,,Nhưng tao vừa rút sạch tiền trong tài khoản hôm nọ rồi, giờ rỗng túi.
Dialogue: 0,0:14:31.85,0:14:34.43,Default,Yuk,0,0,0,,Mừng anh ghé chơi, Okazaki-san.
Dialogue: 0,0:14:34.81,0:14:37.18,Default,Sun,0,0,0,,Chỗ quái nào thế này?
Dialogue: 0,0:14:37.73,0:14:41.19,Default,Oka,0,0,0,,Một nơi mày có thể uống cà phê ngon miễn phí và giết thời gian.
Dialogue: 0,0:14:41.19,0:14:42.73,Default,Oka,0,0,0,,Không tồi chút nào đúng không?
Dialogue: 0,0:14:42.73,0:14:45.65,Default,Yuk,0,0,0,,Mình tên là Miyazawa Yukine.
Dialogue: 0,0:14:45.65,0:14:49.40,Default,Yuk,0,0,0,,Mình là người giữ chìa khóa của phòng tài liệu này.
Dialogue: 0,0:14:50.32,0:14:51.91,Default,Sun,0,0,0,,Giữ chìa khóa phòng này thì có ý nghĩa gì chứ?
Dialogue: 0,0:14:52.53,0:14:55.79,Default,Sun,0,0,0,,Tất cả sách ở đây toàn là sách chẳng ma nào thèm đọc đúng không?
Dialogue: 0,0:14:55.79,0:14:57.29,Default,Yuk,0,0,0,,Chính vì thế nó mới tuyệt đấy.
Dialogue: 0,0:14:57.29,0:14:59.62,Default,Yuk,0,0,0,,Tất cả những cuốn sách kỳ lạ đều được tập hợp về đây.
Dialogue: 0,0:15:01.04,0:15:02.58,Default,Yuk,0,0,0,,Ví dụ như cuốn này này.
Dialogue: 0,0:15:02.58,0:15:04.71,Default,Yuk,0,0,0,,Đây là bói toán bằng các chòm sao đấy.
Dialogue: 0,0:15:04.71,0:15:06.71,Default,Yuk,0,0,0,,Sunohara-san, cung hoàng đạo của anh là gì thế?
Dialogue: 0,0:15:07.96,0:15:10.09,Default,Yuk,0,0,0,,Chòm sao của anh nói rằng...
Dialogue: 0,0:15:10.09,0:15:15.18,Default,Sun,0,0,0,,Nếu được thì tôi muốn biết cách giành lại thầy cố vấn từ tay bọn hợp xướng hơn.
Dialogue: 0,0:15:15.18,0:15:17.52,Default,Yuk,0,0,0,,Màu sắc may mắn của anh là màu cam.
Dialogue: 0,0:15:17.52,0:15:19.81,Default,Yuk,0,0,0,,Từ khóa may mắn là bóng rổ.
Dialogue: 0,0:15:20.35,0:15:21.85,Default,Oka,0,0,0,,Bóng rổ sao...
Dialogue: 0,0:15:21.85,0:15:24.61,Default,Sun,0,0,0,,Trong hai đứa mình thì cái đó là sở trường của mày mà.
Dialogue: 0,0:15:24.61,0:15:27.40,Default,Yuk,0,0,0,,Anh là một người rất biết nghĩ cho bạn bè.
Dialogue: 0,0:15:27.40,0:15:32.49,Default,Yuk,0,0,0,,Bằng cách thể hiện sự chân thành hết mình, những người xung quanh sẽ cảm động.
Dialogue: 0,0:15:32.49,0:15:37.12,Default,Yuk,0,0,0,,Cách anh dám đương đầu với những điều tưởng chừng bất khả thi sẽ lay động trái tim người khác.
Dialogue: 0,0:15:37.49,0:15:39.83,Default,Sun,0,0,0,,Đương đầu với điều bất khả thi...
Dialogue: 0,0:15:39.83,0:15:41.50,Default,Sun,0,0,0,,Bóng rổ...
Dialogue: 0,0:15:42.67,0:15:43.67,Default,Sun,0,0,0,,Đúng rồi, là nó!
Dialogue: 0,0:15:44.17,0:15:45.29,Default,Oka,0,0,0,,Này, Sunohara!
Dialogue: 0,0:15:45.29,0:15:46.63,Default,Sun,0,0,0,,Gặp lại sau nhé, Okazaki!
Dialogue: 0,0:15:47.88,0:15:50.21,Default,Oka,0,0,0,,Tên ngốc đó lại nghĩ ra cái trò gì nữa rồi không biết?
Dialogue: 0,0:15:49.38,0:15:51.34,Default-alt,Tom,0,0,0,,Dù các người có đến bao nhiêu lần đi nữa,
câu trả lời của tôi vẫn sẽ không thay đổi đâu.
Dialogue: 0,0:15:51.34,0:15:53.01,Default,Girl,0,0,0,,Đừng nói phũ phàng thế chứ, làm ơn đi mà.
Dialogue: 0,0:15:53.01,0:15:56.26,Default,Girl,0,0,0,,Xin em đấy, Sakagami-san. Hãy gia nhập CLB Judo nữ đi.
Dialogue: 0,0:15:56.26,0:15:59.02,Default,Guy,0,0,0,,Với tư cách đội trưởng CLB Judo nam, anh cũng khẩn khoản cầu xin em.
Dialogue: 0,0:15:59.02,0:16:02.19,Default,Guy,0,0,0,,Nếu có em tham gia, đội nữ chúng ta sẽ lập tức trở thành ứng cử viên vô địch ngay.
Dialogue: 0,0:16:02.19,0:16:04.65,Default,Tom,0,0,0,,Tôi đã nói rất nhiều lần là tôi không hề có ý định tham gia rồi.
Dialogue: 0,0:16:04.65,0:16:07.23,Default,Oka,0,0,0,,Cậu lúc nào cũng nổi tiếng hết nhỉ, Tomoyo.
Dialogue: 0,0:16:07.23,0:16:09.11,Default,Tom,0,0,0,,Okazaki, giúp tôi với.
Dialogue: 0,0:16:08.07,0:16:10.11,Default-alt,Girl,0,0,0,,Trước mắt chỉ cần đến tham quan một buổi thôi cũng được mà.
Dialogue: 0,0:16:09.11,0:16:10.11,Default,Tom,0,0,0,,Họ dai như đỉa vậy.
Dialogue: 0,0:16:10.11,0:16:12.07,Default,Guy,0,0,0,,Chỉ hôm nay thôi!
Dialogue: 0,0:16:12.07,0:16:13.49,Default,Girl,0,0,0,,Xin em đấy, Sakagami-san!
Dialogue: 0,0:16:12.95,0:16:15.07,Default-alt,Tom,0,0,0,,Tôi đang có sứ mệnh phải làm!
Dialogue: 0,0:16:15.95,0:16:16.45,Default,Oka,0,0,0,,Mấy người—
Dialogue: 0,0:16:18.91,0:16:21.70,Default,Fuk,0,0,0,,Fuko đã có mặt!
Dialogue: 0,0:16:26.71,0:16:30.42,Default,Fuk,0,0,0,,Sakagami-san đã từng đến tham dự đám cưới của Chị hai.
Dialogue: 0,0:16:30.42,0:16:32.84,Default,Fuk,0,0,0,,Giờ đến lượt Fuko phải ra tay giúp đỡ chị ấy.
Dialogue: 0,0:16:32.84,0:16:38.76,Default,Fuk,0,0,0,,Có vẻ đã đến lúc xuất chiêu tuyệt kỹ quét sạch mọi kẻ thù của Fuko, Nhiệt huyết sao biển!
Dialogue: 0,0:16:40.06,0:16:44.64,Default,Fuk,0,0,0,,Ủa nhưng hai người này cũng đã từng tham gia đám cưới mà.
Dialogue: 0,0:16:46.94,0:16:50.11,Default,Fuk,0,0,0,,Fuko không thể đứng về phe nào được rồi.
Dialogue: 0,0:16:50.11,0:16:52.57,Default,Fuk,0,0,0,,Fuko sẽ xuất hiện vào một dịp khác vậy.
Dialogue: 0,0:16:52.57,0:16:53.86,Default,Fuk,0,0,0,,Hẹn gặp lại sau nhé.
Dialogue: 0,0:16:54.90,0:16:56.57,Default,Tom,0,0,0,,Cái trò gì vừa diễn ra thế?
Dialogue: 0,0:16:56.57,0:16:57.99,Default,Oka,0,0,0,,Đừng có hỏi tôi, tôi chịu.
Dialogue: 0,0:16:57.99,0:17:00.08,Default,Girl,0,0,0,,Dù sao thì xin em hãy đến võ đường một chuyến đi.
Dialogue: 0,0:17:00.08,0:17:01.87,Default,Guy,0,0,0,,Nếu đến đó, anh tin chắc em sẽ thay đổi ý định thôi.
Dialogue: 0,0:17:01.87,0:17:03.62,Default,Oka,0,0,0,,Sao mấy người không dừng lại đi nhỉ?
Dialogue: 0,0:17:03.62,0:17:04.87,Default,Guy,0,0,0,,Cậu là ai thế?
Dialogue: 0,0:17:07.75,0:17:08.63,Default,Oka,0,0,0,,Đi thôi, Tomoyo.
Dialogue: 0,0:17:08.63,0:17:09.88,Default,Tom,0,0,0,,Ừ-Ừm.
Dialogue: 0,0:17:12.13,0:17:15.63,Default,Tom,0,0,0,,Tôi ngạc nhiên thật đấy. Những lúc cần kíp cậu cũng đáng tin cậy ra phết.
Dialogue: 0,0:17:15.63,0:17:18.05,Default,Oka,0,0,0,,Cũng chẳng có gì to tát đâu.
Dialogue: 0,0:17:18.05,0:17:20.39,Default,Tom,0,0,0,,Đối thủ vừa rồi là đội trưởng CLB Judo đấy.
Dialogue: 0,0:17:20.39,0:17:22.68,Default,Tom,0,0,0,,Không chỉ một người, mà là cả đội trưởng nam lẫn nữ.
Dialogue: 0,0:17:22.68,0:17:24.43,Default,Tom,0,0,0,,Cậu không thấy sợ sao?
Dialogue: 0,0:17:24.43,0:17:26.19,Default,Oka,0,0,0,,Tôi quen bị người ta ghét bỏ rồi,
Dialogue: 0,0:17:26.19,0:17:27.19,Default,Oka,0,0,0,,nên cậu đừng bận tâm làm gì.
Dialogue: 0,0:17:27.60,0:17:31.15,Default,Tom,0,0,0,,Cứ theo đà đó, khéo tôi bị ép vào CLB mất.
Dialogue: 0,0:17:31.48,0:17:36.57,Default,Tom,0,0,0,,Tôi không có hứng thú với Judo, vả lại sắp tới tôi sẽ bận tối mắt với cuộc bầu cử hội trưởng hội học sinh nữa.
Dialogue: 0,0:17:37.70,0:17:44.00,Default,Oka,0,0,0,,Nếu người như cậu làm hội trưởng,
thì việc tái lập CLB kịch có lẽ đã dễ dàng hơn nhiều rồi.
Dialogue: 0,0:17:45.79,0:17:46.58,Default,Oka,0,0,0,,Sao thế?
Dialogue: 0,0:17:46.58,0:17:49.46,Default,Tom,0,0,0,,Tôi chỉ đang nghĩ rằng cậu thực ra là một người rất tốt bụng đấy.
Dialogue: 0,0:17:56.17,0:17:59.97,Default,Nag,0,0,0,,Vậy là tối qua cậu không gặp Sunohara-san sao?
Dialogue: 0,0:17:59.97,0:18:03.01,Default,Oka,0,0,0,,Ừ, tận khuya muộn nó mới mò về.
Dialogue: 0,0:18:04.89,0:18:06.98,Default,Oka,0,0,0,,Tớ chịu chẳng biết nó đi đâu làm gì nữa.
Dialogue: 0,0:18:11.06,0:18:12.27,Default,Sun,0,0,0,,Tao đã chờ hai người mãi đấy.
Dialogue: 0,0:18:13.15,0:18:14.86,Default,Nag,0,0,0,,Đấu một trận với đội bóng rổ sao?
Dialogue: 0,0:18:14.86,0:18:18.24,Default,Oka,0,0,0,,Khoan đã! Chuyện này từ đâu chui ra thế hả?
Dialogue: 0,0:18:18.24,0:18:20.20,Default,Sun,0,0,0,,Mày còn nhớ lời Yukine-chan nói hôm qua không?
Dialogue: 0,0:18:20.20,0:18:23.62,Default,Sun,0,0,0,,Bằng cách chiến đấu hết mình, tao có thể làm lay động những người xung quanh.
Dialogue: 0,0:18:23.62,0:18:26.12,Default,Sun,0,0,0,,Và từ khóa may mắn chính là bóng rổ.
Dialogue: 0,0:18:26.12,0:18:30.21,Default,Sun,0,0,0,,Nói cách khác, nếu chúng ta thách đấu với đội bóng rổ và giành chiến thắng,
Dialogue: 0,0:18:30.21,0:18:33.54,Default,Sun,0,0,0,,chúng ta sẽ khiến mấy nhỏ bên hợp xướng hiểu được lý lẽ của tao.
Dialogue: 0,0:18:33.54,0:18:36.09,Default,Sun,0,0,0,,Cái khiếm khuyết vớ vẩn đó chẳng có nghĩa lý gì cả.
Dialogue: 0,0:18:36.09,0:18:41.22,Default,Sun,0,0,0,,Sugisaka và Nishina sẽ cảm động đến mức trao trả lại thầy cố vấn cho bọn mình cho xem.
Dialogue: 0,0:18:41.89,0:18:47.43,Default,Oka,0,0,0,,Mày thật sự nghĩ cái cốt truyện như manga thiếu niên đó sẽ hiệu quả ngoài đời chắc?
Dialogue: 0,0:18:47.43,0:18:49.73,Default,Sun,0,0,0,,Tao biết mày không ném rổ được.
Dialogue: 0,0:18:49.73,0:18:51.19,Default,Sun,0,0,0,,Nên mày cứ chơi ở vị trí hậu vệ dẫn bóng đi.
Dialogue: 0,0:18:51.19,0:18:52.19,Default,Sun,0,0,0,,Làm một trận nào!
Dialogue: 0,0:18:52.19,0:18:53.73,Default,Oka,0,0,0,,Tao không hùa theo mày đâu.
Dialogue: 0,0:18:53.73,0:18:54.77,Default,Oka,0,0,0,,Đi thôi, Nagisa.
Dialogue: 0,0:18:55.73,0:18:57.65,Default,Sun,0,0,0,,Này, khoan đã Okazaki!
Dialogue: 0,0:18:58.07,0:19:02.41,Default,Nag,0,0,0,,Bỏ mặc Sunohara-san lại như vậy có ổn không cậu?
Dialogue: 0,0:19:02.41,0:19:04.83,Default,Oka,0,0,0,,Nó chỉ đang tự phấn khích một mình thôi mà.
Dialogue: 0,0:19:04.83,0:19:05.87,Default,Oka,0,0,0,,Đừng để tâm làm gì.
Dialogue: 0,0:19:05.87,0:19:09.33,Default,Nag,0,0,0,,Nhưng bạn ấy làm thế là vì tớ mà...
Dialogue: 0,0:19:10.71,0:19:14.29,Default,Oka,0,0,0,,Từ trước đến giờ có bao giờ nó làm chuyện gì vì người khác chưa?
Dialogue: 0,0:19:14.29,0:19:15.34,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:19:15.34,0:19:16.38,Default,Sun,0,0,0,,Chơi bóng rổ đi mày!
Dialogue: 0,0:19:17.34,0:19:18.63,Default,Sun,0,0,0,,Này, Okazaki!
Dialogue: 0,0:19:18.63,0:19:19.59,Default,Sun,0,0,0,,Chơi bóng rổ đi!
Dialogue: 0,0:19:19.59,0:19:20.38,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:19:20.38,0:19:21.18,Default,Sun,0,0,0,,Chơi bóng rổ đi mà.
Dialogue: 0,0:19:21.18,0:19:22.64,Default,Sun,0,0,0,,Này, đi mà mày.
Dialogue: 0,0:19:23.05,0:19:26.89,Default,Oka,0,0,0,,Thưa thầy. Bạn Sunohara đang làm phiền em học bài ạ.
Dialogue: 0,0:19:29.81,0:19:31.23,Default,Sun,0,0,0,,Khoan đã, Okazaki!
Dialogue: 0,0:19:33.15,0:19:34.27,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:19:34.27,0:19:35.27,Default,Nag,0,0,0,,Chúng ta có nên đến phòng sinh hoạt CLB—
Dialogue: 0,0:19:35.27,0:19:35.86,Default,Oka,0,0,0,,Chạy mau!
Dialogue: 0,0:19:39.19,0:19:41.45,Default,Oka,0,0,0,,Tớ chắc là nó không đuổi tới tận đây đâu.
Dialogue: 0,0:19:41.78,0:19:46.16,Default,Nag,0,0,0,,Liệu Sunohara-san có đang đi tìm cậu không nhỉ?
Dialogue: 0,0:19:46.16,0:19:47.95,Default,Oka,0,0,0,,Không sao đâu. Kệ nó đi.
Dialogue: 0,0:19:47.95,0:19:48.91,Default,Nag,0,0,0,,Nhưng...
Dialogue: 0,0:19:50.71,0:19:52.83,Default,Oka,0,0,0,,Thôi được rồi, tớ sẽ nói thật cho cậu nghe.
Dialogue: 0,0:19:52.83,0:19:53.58,Default,Nag,0,0,0,,Sao cơ ạ?
Dialogue: 0,0:19:53.58,0:19:57.34,Default,Oka,0,0,0,,Thực ra luyện bóng rổ chỉ là cái cớ để nó được ở bên tớ thôi.
Dialogue: 0,0:19:57.34,0:19:58.30,Default,Nag,0,0,0,,Một cái cớ sao?
Dialogue: 0,0:19:58.30,0:19:59.09,Default,Oka,0,0,0,,Đúng thế đấy.
Dialogue: 0,0:19:59.38,0:20:01.63,Default,Oka,0,0,0,,Kỳ thực là nó thích tớ.
Dialogue: 0,0:20:01.63,0:20:02.88,Default,Oka,0,0,0,,Nó yêu tớ mất rồi.
Dialogue: 0,0:20:02.88,0:20:03.93,Default,Sun,0,0,0,,Okazaki.
Dialogue: 0,0:20:05.93,0:20:09.52,Default,Oka,0,0,0,,Dạo này tớ hay bỏ rơi nó đúng không?
Dialogue: 0,0:20:09.52,0:20:12.94,Default,Oka,0,0,0,,Nên sự cô đơn tích tụ bên trong nó
đã thôi thúc nó làm ra những chuyện như thế này đấy.
Dialogue: 0,0:20:12.94,0:20:15.19,Default,Oka,0,0,0,,Nghĩ kỹ lại thì nó cũng là một gã tội nghiệp.
Dialogue: 0,0:20:15.48,0:20:19.48,Default,Nag,0,0,0,,Nhưng nếu là vậy, chẳng phải cậu nên nghiêm túc đối diện với bạn ấy sao?
Dialogue: 0,0:20:19.48,0:20:23.03,Default,Oka,0,0,0,,Đáng tiếc là tớ lại không thể yêu đàn ông được.
Dialogue: 0,0:20:23.03,0:20:27.87,Default,Oka,0,0,0,,Nên tốt hơn hết là để nó từ bỏ tớ càng sớm càng tốt.
Dialogue: 0,0:20:27.87,0:20:29.20,Default,Nag,0,0,0,,Ra là vậy...
Dialogue: 0,0:20:29.20,0:20:32.08,Default,Nag,0,0,0,,Cậu thực sự là một người rất tốt bụng.
Dialogue: 0,0:20:32.08,0:20:33.75,Default,Oka,0,0,0,,Chỉ cần cậu hiểu cho lòng tớ là được rồi.
Dialogue: 0,0:20:36.29,0:20:37.17,Default,Oka,0,0,0,,Nó tới rồi!
Dialogue: 0,0:20:38.42,0:20:39.92,Default,Sun,0,0,0,,Cuối cùng cũng đuổi kịp mày rồi.
Dialogue: 0,0:20:39.92,0:20:42.51,Default,Sun,0,0,0,,Sao mày lại chạy trốn hả, Okazaki?
Dialogue: 0,0:20:42.51,0:20:43.34,Default,Sun,0,0,0,,Mày phũ phàng với tao quá đấy.
Dialogue: 0,0:20:43.88,0:20:45.93,Default,Nag,0,0,0,,Ừm... chuyện là...
Dialogue: 0,0:20:46.30,0:20:49.56,Default,Nag,0,0,0,,Okazaki-san không hề muốn điều đó đâu,
nên tớ nghĩ cậu không nên làm phiền cậu ấy nữa.
Dialogue: 0,0:20:49.56,0:20:50.47,Default,Sun,0,0,0,,Tại sao chứ?
Dialogue: 0,0:20:50.47,0:20:53.18,Default,Sun,0,0,0,,Cậu thừa biết là tao với Okazaki thân thiết với nhau thế nào mà.
Dialogue: 0,0:20:53.18,0:20:58.27,Default,Nag,0,0,0,,Không được! Dù có thân thiết đến mấy, cũng có những ranh giới tuyệt đối không thể vượt qua!
Dialogue: 0,0:20:58.27,0:21:00.94,Default,Sun,0,0,0,,Dù thế nào đi nữa tao cũng cần có Okazaki!
Dialogue: 0,0:21:00.94,0:21:03.28,Default,Sun,0,0,0,,Nhất định phải là cậu ấy mới được!
Dialogue: 0,0:21:03.28,0:21:04.53,Default,Nag,0,0,0,,Tuyệt đối không được!
Dialogue: 0,0:21:04.53,0:21:05.66,Default,Nag,0,0,0,,Bởi vì...
Dialogue: 0,0:21:06.24,0:21:09.24,Default,Nag,0,0,0,,Bởi vì Okazaki-san là bạn trai của tớ mà!
Dialogue: 0,0:21:09.91,0:21:10.99,Default,2,0,0,0,,HẢ?!!
Dialogue: 0,0:21:10.99,0:21:16.29,Default,Nag,0,0,0,,Nên tớ tuyệt đối không giao Okazaki-san cho cậu đâu!
Dialogue: 0,0:21:16.29,0:21:18.38,Default,Oka,0,0,0,,À ra vậy. Cậu ấy đang cố bảo vệ mình đây mà.
Dialogue: 0,0:21:18.38,0:21:19.92,Default,Sun,0,0,0,,Hai người...
Dialogue: 0,0:21:19.92,0:21:21.21,Default,Sun,0,0,0,,Từ bao giờ...
Dialogue: 0,0:21:22.76,0:21:25.34,Default,Sun,0,0,0,,Lũ ngốc các người!
Dialogue: 0,0:21:32.01,0:21:33.31,Default,Oka,0,0,0,,Này.
Dialogue: 0,0:21:34.39,0:21:40.73,Default,Nag,0,0,0,,Tớ xin lỗi! Tớ cứ cảm thấy mình phải bảo vệ cậu,
nên chẳng kịp nghĩ ngợi gì mà buột miệng nói dối như vậy mất rồi.
Dialogue: 0,0:21:41.15,0:21:43.40,Default,Oka,0,0,0,,À không. Ừm...
Dialogue: 0,0:21:44.36,0:21:46.32,Default,Oka,0,0,0,,Cảm ơn cậu nhé. Tớ thấy vui lắm.
Dialogue: 0,0:21:52.24,0:21:54.12,Default,Mei,0,0,0,,Xin lỗi cho em hỏi một chút ạ.
Dialogue: 0,0:21:54.12,0:21:58.50,Default,Mei,0,0,0,,Người vừa chạy vụt qua có phải là Sunohara Youhei không ạ?
Dialogue: 0,0:21:58.50,0:21:59.75,Default,Nag,0,0,0,,Còn em là ai thế?
Dialogue: 0,0:22:01.00,0:22:02.96,Default,Mei,0,0,0,,Em là em gái của anh ấy,
Dialogue: 0,0:22:02.96,0:22:05.26,Default,Mei,0,0,0,,Sunohara Mei ạ.
