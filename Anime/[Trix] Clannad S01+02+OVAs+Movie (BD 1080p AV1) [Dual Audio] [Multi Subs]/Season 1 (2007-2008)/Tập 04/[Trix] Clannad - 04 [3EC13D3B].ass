Dialogue: 0,0:17:21.35,0:17:23.93,Default,Oka,0,0,0,,Xin lỗi nhé. Tôi vô thức tung chân đá mày dính vách luôn.
Dialogue: 0,0:17:23.93,0:17:24.98,Default,Sun,0,0,0,,Mày tính giết tao luôn đấy à...
Dialogue: 0,0:17:24.98,0:17:27.81,Default,Tom,0,0,0,,Xin hãy dừng trò này lại ở đây đi.
Dialogue: 0,0:17:28.31,0:17:30.65,Default,Oka,0,0,0,,À, khoan đã, Tomoyo.
Dialogue: 0,0:17:30.65,0:17:32.98,Default,Oka,0,0,0,,Cậu có chút hứng thú nào với kịch nghệ không?
Dialogue: 0,0:17:32.98,0:17:34.07,Default,Tom,0,0,0,,Kịch nghệ sao?
Dialogue: 0,0:17:34.07,0:17:35.78,Default,Oka,0,0,0,,Bọn tôi đang tìm kiếm thành viên.
Dialogue: 0,0:17:35.78,0:17:37.95,Default,Oka,0,0,0,,Cậu sẽ được mặc váy dạ hội xúng xính như một cô gái thực thụ đấy.
Dialogue: 0,0:17:39.20,0:17:42.20,Default,Tom,0,0,0,,Nghe cũng khá thú vị, nhưng chắc tôi không tham gia được đâu.
Dialogue: 0,0:17:42.66,0:17:46.62,Default,Tom,0,0,0,,Kỳ bầu cử hội trưởng hội học sinh sắp diễn ra rồi,\Nnên tôi không có thời gian để sinh hoạt câu lạc bộ.
Dialogue: 0,0:17:46.62,0:17:48.17,Default,Oka,0,0,0,,Hội trưởng hội học sinh á?
Dialogue: 0,0:17:48.17,0:17:50.54,Default,Tom,0,0,0,,Tôi sẽ bận lắm.
Dialogue: 0,0:17:50.54,0:17:51.96,Default,Tom,0,0,0,,Anh đi rủ người khác xem sao.
Dialogue: 0,0:17:52.71,0:17:54.63,Default,Oka,0,0,0,,Hội trưởng hội học sinh sao...
Dialogue: 0,0:17:55.63,0:17:58.13,Signs,,0,0,0,,{\fnArial Black\fs81\b1\c&H908D8E&\blur0.5\frx5\pos(960,689)}Thư Viện
Dialogue: 0,0:17:56.72,0:17:58.13,Default,Oka,0,0,0,,Này, Ichinose.
Dialogue: 0,0:18:00.01,0:18:01.30,Default,Oka,0,0,0,,Ichinose-san.
Dialogue: 0,0:18:02.39,0:18:04.18,Default,Oka,0,0,0,,Cậu ấy đọc sách với tốc độ chóng mặt thật đấy.
Dialogue: 0,0:18:04.18,0:18:05.64,Default,Oka,0,0,0,,Đúng chuẩn thiên tài có khác.
Dialogue: 0,0:18:06.56,0:18:08.44,Default,Oka,0,0,0,,Này, Ichinose Kotomi.
Dialogue: 0,0:18:09.94,0:18:11.02,Default,Oka,0,0,0,,Kotomi-san.
Dialogue: 0,0:18:12.98,0:18:14.19,Default,Oka,0,0,0,,Này, Kotomi.
Dialogue: 0,0:18:16.07,0:18:17.57,Default,Oka,0,0,0,,Kotomi-chan.
Dialogue: 0,0:18:20.95,0:18:23.62,Default,Oka,0,0,0,,Tớ là Okazaki Tomoya lớp 3-D.
Dialogue: 0,0:18:23.91,0:18:26.29,Default,Oka,0,0,0,,Cậu là Ichinose-san bên lớp A đúng không?
Dialogue: 0,0:18:26.29,0:18:30.29,Default,Kot,0,0,0,,Ừm, Kotomi viết bằng ba chữ hiragana.
Dialogue: 0,0:18:30.29,0:18:31.83,Default,Oka,0,0,0,,Ừ, Ichinose Kotomi.
Dialogue: 0,0:18:31.83,0:18:33.50,Default,Oka,0,0,0,,Tớ nghe danh cậu nổi tiếng khắp trường rồi.
Dialogue: 0,0:18:33.50,0:18:35.59,Default,Kot,0,0,0,,Khi nói chuyện với tớ, hãy gọi tớ là Kotomi-chan nhé.
Dialogue: 0,0:18:35.59,0:18:37.55,Default,Oka,0,0,0,,Cho tớ xin phép bỏ chữ 'chan' đi được không.
Dialogue: 0,0:18:41.80,0:18:43.93,Default,Kot,0,0,0,,Cậu có muốn đọc sách cùng tớ không?
Dialogue: 0,0:18:43.93,0:18:45.85,Default,Oka,0,0,0,,Tớ tới đây không phải để đọc sách.
Dialogue: 0,0:18:48.02,0:18:49.48,Default,Kot,0,0,0,,Cậu có muốn ăn cơm hộp cùng không?
Dialogue: 0,0:18:51.65,0:18:54.27,Default,Oka,0,0,0,,Hôm nay tớ đến đây là muốn mời cậu vào câu lạc bộ.
Dialogue: 0,0:18:54.27,0:18:56.28,Default,Oka,0,0,0,,Cậu có hứng thú gì với kịch nghệ không?
Dialogue: 0,0:18:56.28,0:18:57.07,Default,Kot,0,0,0,,Kịch nghệ sao?
Dialogue: 0,0:18:57.07,0:18:59.45,Default,Oka,0,0,0,,Tớ đang đi chiêu mộ thành viên.
Dialogue: 0,0:18:59.45,0:19:01.91,Default,Oka,0,0,0,,Chỉ cần cậu ký tên vào danh sách thôi cũng được rồi.
Dialogue: 0,0:19:02.70,0:19:03.62,Default,Kot,0,0,0,,Tên sao?
Dialogue: 0,0:19:06.04,0:19:07.33,Default,Kot,0,0,0,,Tomoya-kun...
Dialogue: 0,0:19:08.20,0:19:10.33,Default,Kot,0,0,0,,Nghe mang lại một cảm giác lạ lẫm ghê.
Dialogue: 0,0:19:10.33,0:19:11.75,Default,Kot,0,0,0,,Tomoya...
Dialogue: 0,0:19:13.75,0:19:14.25,Default,Kot,0,0,0,,...kun.
Dialogue: 0,0:19:14.25,0:19:16.46,Default,Oka,0,0,0,,Cậu không cần phải ngập ngừng ngắt quãng như thế đâu.
Dialogue: 0,0:19:17.42,0:19:19.72,Default,Oka,0,0,0,,Tớ sẽ quay lại sau, nên cậu suy nghĩ thử xem nhé?
Dialogue: 0,0:19:20.68,0:19:21.68,Default,Kot,0,0,0,,Tomoya-kun.
Dialogue: 0,0:19:21.68,0:19:22.22,Default,Oka,0,0,0,,Gì thế?
Dialogue: 0,0:19:23.85,0:19:24.72,Default,Kot,0,0,0,,Hẹn gặp lại cậu nhé.
Dialogue: 0,0:19:27.60,0:19:29.73,Default,Oka,0,0,0,,Bên cậu cũng công cốc luôn à?
Dialogue: 0,0:19:30.18,0:19:34.23,Default,Nag,0,0,0,,Vâng. Tớ đã đi hỏi mấy người liền rồi, nhưng chẳng ai chịu tham gia cả.
Dialogue: 0,0:19:34.23,0:19:39.49,Default,Oka,0,0,0,,Nghĩ kỹ thì, câu lạc bộ bị giải thể\Ncũng chính vì những người đam mê kịch đều đã rời đi cả rồi.
Dialogue: 0,0:19:40.15,0:19:43.49,Default,Oka,0,0,0,,Chuyện này xem chừng còn gian nan hơn bọn mình tưởng.
Dialogue: 0,0:19:43.49,0:19:45.99,Default,Nag,0,0,0,,Học sinh năm ba thì bận tối mắt vì kỳ thi đại học.
Dialogue: 0,0:19:46.53,0:19:51.25,Default,Nag,0,0,0,,Các em khóa dưới thì có lẽ sẽ hứng thú hơn, nhưng mà...
Dialogue: 0,0:19:51.66,0:19:53.42,Default,Oka,0,0,0,,Học sinh khóa dưới à...
Dialogue: 0,0:19:58.42,0:20:00.26,Default,Oka,0,0,0,,Này. Nhóc vẫn còn ở đây cơ à.
Dialogue: 0,0:20:00.26,0:20:02.05,Default,Fuk,0,0,0,,A, người kỳ quặc.
Dialogue: 0,0:20:02.05,0:20:06.14,Default,Nag,0,0,0,,Rất vui được gặp em. Chị là Furukawa Nagisa lớp 3-B.
Dialogue: 0,0:20:07.39,0:20:08.68,Default,Fuk,0,0,0,,Rất vui được gặp chị.
Dialogue: 0,0:20:09.68,0:20:12.81,Default,Nag,0,0,0,,Fuko-san có hứng thú với kịch nghệ không em?
Dialogue: 0,0:20:12.81,0:20:13.77,Default,Fuk,0,0,0,,Kịch nghệ ạ?
Dialogue: 0,0:20:13.77,0:20:15.98,Default,Oka,0,0,0,,Bọn anh đang chiêu mộ thành viên.
Dialogue: 0,0:20:15.98,0:20:19.11,Default,Oka,0,0,0,,Nhóc là học sinh năm nhất, lại chưa tham gia câu lạc bộ nào đúng không?
Dialogue: 0,0:20:19.11,0:20:20.90,Default,Fuk,0,0,0,,Fuko bận lắm.
Dialogue: 0,0:20:20.90,0:20:23.24,Default,Fuk,0,0,0,,Fuko không có thời gian để tham gia câu lạc bộ đâu ạ.
Dialogue: 0,0:20:23.24,0:20:27.28,Default,Oka,0,0,0,,Đừng nói vậy chứ. Đâu phải lúc nào nhóc cũng ngồi cặm cụi đẽo gọt thế này suốt ngày đâu.
Dialogue: 0,0:20:27.28,0:20:29.66,Default,Fuk,0,0,0,,Fuko ngồi đẽo gọt mọi lúc mọi nơi suốt cả ngày đấy.
Dialogue: 0,0:20:29.66,0:20:30.87,Default,Fuk,0,0,0,,Cả ngày Fuko đều ở lại đây.
Dialogue: 0,0:20:30.87,0:20:33.29,Default,Oka,0,0,0,,Nhưng tối đến thì nhóc cũng phải về nhà chứ.
Dialogue: 0,0:20:33.29,0:20:34.42,Default,Fuk,0,0,0,,Không, Fuko không về đâu.
Dialogue: 0,0:20:34.42,0:20:35.79,Default,Fuk,0,0,0,,Lúc nào Fuko cũng ở trường hết.
Dialogue: 0,0:20:36.92,0:20:39.88,Default,Oka,0,0,0,,Đừng có bịa chuyện lung tung.
Dialogue: 0,0:20:39.88,0:20:41.21,Default,Fuk,0,0,0,,Fuko không hề nói dối đâu.
Dialogue: 0,0:20:41.21,0:20:43.09,Default,Fuk,0,0,0,,Fuko lúc nào cũng ở lại trường mà.
Dialogue: 0,0:20:45.01,0:20:46.47,Default,Oka,0,0,0,,Từ sáng sớm tinh mơ cho đến tận tối muộn luôn á?
Dialogue: 0,0:20:46.47,0:20:47.01,Default,Fuk,0,0,0,,Vâng.
Dialogue: 0,0:20:47.01,0:20:48.55,Default,Oka,0,0,0,,Vậy là nhóc không chịu về nhà à?
Dialogue: 0,0:20:48.55,0:20:49.72,Default,Fuk,0,0,0,,Không, Fuko không về đâu.
Dialogue: 0,0:20:49.72,0:20:51.77,Default,Fuk,0,0,0,,Về nhà cũng chẳng để làm gì cả.
Dialogue: 0,0:20:57.69,0:21:00.78,Default,Oka,0,0,0,,Nhóc bỏ nhà đi bụi đấy à?
Dialogue: 0,0:21:00.78,0:21:04.49,Default,Fuk,0,0,0,,Fuko cũng chẳng rõ vì sao mình lại ở đây nữa.
Dialogue: 0,0:21:05.20,0:21:10.66,Default,Fuk,0,0,0,,Trên đường từ lễ khai giảng trở về nhà,\NFuko suýt chút nữa thì bị một chiếc ô tô đâm trúng...
Dialogue: 0,0:21:10.66,0:21:12.75,Default,Fuk,0,0,0,,Đến khi Fuko nhận thức được, thì Fuko đã thấy mình đang ở trường rồi.
Dialogue: 0,0:21:12.75,0:21:14.50,Default,Oka,0,0,0,,Bị ô tô đâm trúng á?
Dialogue: 0,0:21:14.50,0:21:18.17,Default,Nag,0,0,0,,Ừm, Fuko-san này. Họ của em là gì vậy?
Dialogue: 0,0:21:18.17,0:21:20.25,Default,Fuk,0,0,0,,Là Ibuki ạ. Ibuki Fuko.
Dialogue: 0,0:21:20.26,0:21:21.75,Default,Nag,0,0,0,,Ibuki... {\alpha&HFF}Fuko...
Dialogue: 0,0:21:21.76,0:21:22.92,Default,Nag,0,0,0,,Ibuki... Fuko...
Dialogue: 0,0:21:23.38,0:21:25.26,Default,Nag,0,0,0,,Em có phải là em gái của cô giáo Ibuki không?!
Dialogue: 0,0:21:27.97,0:21:31.56,Default,Fuk,0,0,0,,Okazaki-san. Có một người biết đến chị gái của Fuko này!
Dialogue: 0,0:21:31.56,0:21:32.89,Default,Oka,0,0,0,,Ừ-Ừ.
Dialogue: 0,0:21:32.89,0:21:34.89,Default,Oka,0,0,0,,Cậu học lại một năm cơ mà, đúng không?
Dialogue: 0,0:21:35.35,0:21:38.52,Default,Nag,0,0,0,,Cô ấy là giáo viên dạy mỹ thuật hồi tớ mới vào năm nhất.
Dialogue: 0,0:21:39.02,0:21:39.52,Default,Nag,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:43.36,0:21:48.07,Default,Nag,0,0,0,,Tớ nghe nói em gái cô ấy đã gặp tai nạn xe hơi và phải nằm viện suốt từ đó đến giờ.
Dialogue: 0,0:21:49.62,0:21:55.00,Default,Nag,0,0,0,,Hôm qua cô ấy cũng ghé qua mua bánh mì,\Nvà bảo là vừa mới từ bệnh viện vào thăm em gái về.
Dialogue: 0,0:21:55.58,0:22:02.04,Default,Nag,0,0,0,,Okazaki-san. Cậu đã bao giờ nghe lời đồn về\Nhồn ma của một cô bé từng gặp tai nạn giao thông chưa?
Dialogue: 0,0:22:02.75,0:22:03.84,Default,Oka,0,0,0,,Ý cậu không lẽ là...
Dialogue: 0,0:22:05.88,0:22:09.84,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad2.5\pos(1460,840)}Còn tiếp
Dialogue: 0,0:22:10.68,0:22:18.89,ED English,,0,0,0,,{\fad(250,250)\be1\3c&H447687&}Dango, dango, dango, dango, đại gia đình dango.
