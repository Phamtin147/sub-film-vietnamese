Dialogue: 0,0:10:25.31,0:10:32.19,Signs,,0,0,0,,{\an7\fs40\4c&H707070&\shad2.5\3c&H707070&\bord0.5\pos(868,841)}Bạn sẽ làm gì?
Dialogue: 0,0:10:28.85,0:10:32.19,Default,Sun,0,0,0,,{\an8}Tại sao lại không có lựa chọn 'Cho nó vào nhóm' hả?!
Dialogue: 0,0:10:32.19,0:10:34.77,Default,Oka,0,0,0,,Làm thế thì câu chuyện mới dễ tiến triển chứ.
Dialogue: 0,0:10:34.77,0:10:39.20,Default,Sun,0,0,0,,Cứ để mấy đứa mình tự lên kế hoạch thì chắc chẳng tới đâu đâu.
Dialogue: 0,0:10:39.20,0:10:42.49,Default,Sun,0,0,0,,Hay là bọn mình đi hỏi người khác xem?
Dialogue: 0,0:10:42.49,0:10:44.41,Default,Nag,0,0,0,,Có khi cậu nói đúng đấy.
Dialogue: 0,0:10:44.41,0:10:45.74,Default,Oka,0,0,0,,Mày có nghĩ ra nên hỏi ai chưa?
Dialogue: 0,0:10:45.74,0:10:48.62,Default,Sun,0,0,0,,Tất nhiên rồi. Chưa nghĩ ra thì tao đề xuất làm quái gì.
Dialogue: 0,0:10:48.62,0:10:50.12,Default,Bot,0,0,0,,Puhi, puhi!
Dialogue: 0,0:10:50.12,0:10:50.62,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:10:50.62,0:10:54.17,Default,Kyo,0,0,0,,Botan, em lại chạy sang đây nữa à?
Dialogue: 0,0:10:54.17,0:10:57.71,Default,Ryo,0,0,0,,Ừm, nhưng tụi mình vẫn còn tiết học mà.
Dialogue: 0,0:10:54.17,0:10:55.30,Default-alt,Bot,0,0,0,,Puhi, puhi.
Dialogue: 0,0:10:56.92,0:10:57.71,Default-alt,Bot,0,0,0,,Puhi!
Dialogue: 0,0:10:57.71,0:11:01.80,Default,Kyo,0,0,0,,Tí nữa chị tìm Tomoya hoặc Youhei rồi bắt hai đứa nó trông em hộ nhé.
Dialogue: 0,0:10:59.80,0:11:00.76,Default-alt,Bot,0,0,0,,Puhi, puhi.
Dialogue: 0,0:11:01.80,0:11:04.55,Default,Oka,0,0,0,,Tao vừa nghe thấy họ réo tên hai đứa mình đấy.
Dialogue: 0,0:11:05.35,0:11:10.44,Default,Sun,0,0,0,,Tao tính lớp trưởng thì chắc rành rõi nội quy trường lắm,\Nnhưng mà chị bà chằn của nó cũng ở đấy kìa, tính sao?
Dialogue: 0,0:11:10.44,0:11:13.27,Default,Oka,0,0,0,,Mày qua đó lừa kéo đứa em đi một mình thôi.
Dialogue: 0,0:11:13.27,0:11:17.36,Default,Oka,0,0,0,,Bảo là có người muốn tỏ tình với nó. Thế là bà chị sẽ biết ý mà tránh mặt ra thôi.
Dialogue: 0,0:11:17.73,0:11:18.90,Default,Sun,0,0,0,,Hiểu rồi.
Dialogue: 0,0:11:18.90,0:11:20.45,Default,Sun,0,0,0,,Ý kiến hay đấy.
Dialogue: 0,0:11:22.49,0:11:24.95,Default,Nag,0,0,0,,Hai cậu vừa bàn tán chuyện gì thế?
Dialogue: 0,0:11:24.95,0:11:27.33,Default,Oka,0,0,0,,Cậu lo nghĩ sẵn những gì cần hỏi đi.
Dialogue: 0,0:11:29.29,0:11:30.71,Default,Ryo,0,0,0,,D-Dạ...
Dialogue: 0,0:11:30.71,0:11:33.96,Default,Oka,0,0,0,,Người cần nói chuyện với cậu là cô bạn này cơ.
Dialogue: 0,0:11:37.55,0:11:41.13,Default,Nag,0,0,0,,Tớ là Furukawa Nagisa lớp 3-B.
Dialogue: 0,0:11:41.13,0:11:44.18,Default,Nag,0,0,0,,Tớ xin lỗi vì đã đường đột gọi cậu ra đây thế này.
Dialogue: 0,0:11:44.18,0:11:47.60,Default,Ryo,0,0,0,,V-Vâng. Tớ là Fujibayashi Ryou lớp D.
Dialogue: 0,0:11:47.60,0:11:50.06,Default,Nag,0,0,0,,Cậu là lớp trưởng đúng không?
Dialogue: 0,0:11:50.06,0:11:51.02,Default,Ryo,0,0,0,,V-Vâng.
Dialogue: 0,0:11:51.02,0:11:56.27,Default,Nag,0,0,0,,Cậu giỏi thật đấy. Tớ thì chắc chẳng bao giờ làm nổi đâu,\Nnên tớ ngưỡng mộ cậu lắm.
Dialogue: 0,0:11:56.27,0:11:59.57,Default,Ryo,0,0,0,,C-Có gì to tát đâu ạ.
Dialogue: 0,0:11:59.57,0:12:01.19,Default,Nag,0,0,0,,Tớ có chuyện này muốn thỉnh giáo cậu!
Dialogue: 0,0:12:01.19,0:12:02.82,Default,Nag,0,0,0,,Cậu lắng nghe tớ được chứ?
Dialogue: 0,0:12:02.82,0:12:04.07,Default,Ryo,0,0,0,,V-Vâng!
Dialogue: 0,0:12:04.07,0:12:06.07,Default,Oka,0,0,0,,Cậu ấy đang rất nghiêm túc đấy.
Dialogue: 0,0:12:06.07,0:12:08.41,Default,Oka,0,0,0,,Nên cậu cũng trả lời thật nghiêm túc vào nhé.
Dialogue: 0,0:12:08.41,0:12:10.79,Default,Ryo,0,0,0,,Xin hãy đợi một chút ạ.
Dialogue: 0,0:12:10.79,0:12:14.04,Default,Ryo,0,0,0,,Ừm... tớ không nghĩ đối phương lại là con gái, nên...
Dialogue: 0,0:12:14.04,0:12:16.42,Default,Sun,0,0,0,,Giới tính thì quan trọng gì chứ?
Dialogue: 0,0:12:16.42,0:12:19.25,Default,Sun,0,0,0,,Tao nghĩ quan trọng nhất vẫn là ngọn lửa đam mê kìa.
Dialogue: 0,0:12:19.92,0:12:22.47,Default,Oka,0,0,0,,Hiếm hoi lắm mới thấy mày phát biểu được một câu ra hồn.
Dialogue: 0,0:12:22.47,0:12:25.34,Default,Sun,0,0,0,,Bởi vì sâu thẳm trong tim tao vốn là người tốt mà.
Dialogue: 0,0:12:25.34,0:12:27.05,Default,Nag,0,0,0,,Một đứa con gái ngỏ lời thì kỳ lạ lắm sao cậu?
Dialogue: 0,0:12:27.05,0:12:31.02,Default,Ryo,0,0,0,,K-Không hề đâu. Furukawa-san dễ thương lắm luôn.
Dialogue: 0,0:12:31.02,0:12:35.19,Default,Ryo,0,0,0,,Nhưng nếu là với tớ... ừm... phải nói sao nhỉ...
Dialogue: 0,0:12:35.19,0:12:37.65,Default,Nag,0,0,0,,Tớ đã băn khoăn trăn trở chuyện này lâu lắm rồi.
Dialogue: 0,0:12:37.65,0:12:39.94,Default,Nag,0,0,0,,Nhưng tớ đã hạ quyết tâm sẽ đối diện thật nghiêm túc!
Dialogue: 0,0:12:41.57,0:12:43.95,Default,Ryo,0,0,0,,Hóa ra cậu đã dằn vặt nhiều đến thế sao.
Dialogue: 0,0:12:43.95,0:12:45.53,Default,Sun,0,0,0,,Nghe cuốn phết đấy nhỉ.
Dialogue: 0,0:12:45.53,0:12:48.70,Default,Nag,0,0,0,,Bây giờ tớ thật sự không biết phải làm sao nữa.
Dialogue: 0,0:12:48.70,0:12:50.58,Default,Nag,0,0,0,,Xin hãy lắng nghe tâm nguyện của tớ.
Dialogue: 0,0:12:50.91,0:12:54.50,Default,Ryo,0,0,0,,Đ-Được rồi. Tớ sẽ nghiêm túc lắng nghe cậu.
Dialogue: 0,0:12:54.50,0:12:56.15,Default,Nag,0,0,0,,Cậu có thể... {\alpha&HFF}Cậu có thể...
Dialogue: 0,0:12:56.15,0:12:57.23,Default,Nag,0,0,0,,Cậu có thể... Cậu có thể...
Dialogue: 0,0:12:59.79,0:13:04.05,Default,Nag,0,0,0,,Cậu có thể giúp tớ gầy dựng lại câu lạc bộ kịch được không?!
Dialogue: 0,0:13:04.05,0:13:05.18,Default,Ryo,0,0,0,,Vâng.
Dialogue: 0,0:13:05.55,0:13:05.97,Default,Ryo,0,0,0,,Ơ?
Dialogue: 0,0:13:06.68,0:13:07.22,Default,Bot,0,0,0,,Puhi.
Dialogue: 0,0:13:07.22,0:13:08.34,Default,Ryo,0,0,0,,Chị hai ơi!
Dialogue: 0,0:13:07.22,0:13:08.14,Default-alt,Bot,0,0,0,,Puhi...
Dialogue: 0,0:13:08.34,0:13:09.72,Default,Sun,0,0,0,,Á! Kyou kìa!
Dialogue: 0,0:13:09.72,0:13:12.35,Default,Kyo,0,0,0,,Hai cái thằng trời đánh kia...
Dialogue: 0,0:13:13.10,0:13:17.40,Default,Kyo,0,0,0,,Ganh gan to bằng trời dám trêu chọc em gái bà mày à!
Dialogue: 0,0:13:18.52,0:13:19.11,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:13:21.78,0:13:24.49,Default,Kyo,0,0,0,,Có thế mà không chịu nói sớm từ đầu.
Dialogue: 0,0:13:24.49,0:13:25.45,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:13:25.82,0:13:26.95,Default,Oka,0,0,0,,Lỗi tại thằng Sunohara đấy.
Dialogue: 0,0:13:26.95,0:13:28.07,Default,Sun,0,0,0,,Lỗi tại mày thì có!
Dialogue: 0,0:13:28.07,0:13:30.70,Default,Nag,0,0,0,,Tớ xin lỗi. Tớ ăn nói vụng về quá.
Dialogue: 0,0:13:30.70,0:13:33.45,Default,Ryo,0,0,0,,Không sao đâu ạ. Chỉ là làm tớ giật cả thót tim thôi.
Dialogue: 0,0:13:34.20,0:13:37.21,Default,Kyo,0,0,0,,Này em gái. Em chỉ có hai thằng bạn dở hơi này thôi à?
Dialogue: 0,0:13:37.21,0:13:39.71,Default,Nag,0,0,0,,Bạn bè...
Dialogue: 0,0:13:40.00,0:13:42.96,Default,Nag,0,0,0,,Dạ, hai bạn ấy đang nhiệt tình giúp em gầy dựng lại câu lạc bộ kịch ạ.
Dialogue: 0,0:13:44.17,0:13:46.84,Default,Kyo,0,0,0,,Chị dám cá là tụi nó có mưu đồ mờ ám gì đằng sau đấy.
Dialogue: 0,0:13:46.84,0:13:50.89,Default,Kyo,0,0,0,,Này, hay là quên phắt hai thằng này đi\Nrồi sang chơi chung với bọn chị nhé?
Dialogue: 0,0:13:51.68,0:13:52.56,Default,Nag,0,0,0,,Dạ...
Dialogue: 0,0:13:52.89,0:13:54.68,Default,Kyo,0,0,0,,Em cũng đồng ý đúng không, Botan?
Dialogue: 0,0:13:54.68,0:13:55.14,Default,Bot,0,0,0,,Puhi!
Dialogue: 0,0:13:55.14,0:13:57.23,Default,Sun,0,0,0,,Lòng tự trọng của bọn mình vứt cho chó gặm rồi à?
Dialogue: 0,0:13:57.23,0:13:59.81,Default,Oka,0,0,0,,Mày cũng chỉ vì mấy cái bánh mì thôi chứ danh dự cái nỗi gì.
Dialogue: 0,0:13:59.81,0:14:06.90,Default,Nag,0,0,0,,Dạ, em cảm ơn lòng tốt của các chị, nhưng em không thể bỏ rơi những người đã hết lòng vì mình được đâu ạ.
Dialogue: 0,0:14:07.24,0:14:10.07,Default,Nag,0,0,0,,Okazaki-san và Sunohara-san đều là những người rất tốt bụng.
Dialogue: 0,0:14:10.62,0:14:16.33,Default,Kyo,0,0,0,,Xem ra chú mày dụ dỗ con bé khéo ghê nhỉ, bộ tính tăm tia người ta đấy à?
Dialogue: 0,0:14:16.33,0:14:17.58,Default,Oka,0,0,0,,Có cái con khỉ khô ấy.
Dialogue: 0,0:14:17.58,0:14:22.42,Default,Ryo,0,0,0,,Muốn tái khởi động một câu lạc bộ đã ngưng hoạt động, việc đầu tiên là phải gom đủ thành viên.
Dialogue: 0,0:14:22.42,0:14:27.72,Default,Ryo,0,0,0,,Nội quy trường quy định cần ít nhất\Nba thành viên và một giáo viên cố vấn mới được thành lập câu lạc bộ.
Dialogue: 0,0:14:27.72,0:14:29.22,Default,Kyo,0,0,0,,À, phải rồi.
Dialogue: 0,0:14:29.80,0:14:30.72,Default,Nag,0,0,0,,Ba người ạ.
Dialogue: 0,0:14:30.72,0:14:33.85,Default,Oka,0,0,0,,Mà cậu ấy thì đang bị cấm chiêu mộ thành viên mới công khai.
Dialogue: 0,0:14:33.85,0:14:35.18,Default,Sun,0,0,0,,Ừ, đúng thế thật.
Dialogue: 0,0:14:35.18,0:14:37.23,Default,Kyo,0,0,0,,Nếu chỉ cần đủ số lượng, thì ở đây có thừa rồi còn gì.
Dialogue: 0,0:14:37.85,0:14:38.56,Default,Sun,0,0,0,,Ở đâu cơ?
Dialogue: 0,0:14:38.56,0:14:40.35,Default,Kyo,0,0,0,,Em ấy, chú mày, với lại chú mày.
Dialogue: 0,0:14:44.44,0:14:45.57,Default,2,0,0,0,,Không đời nào đâu.
Dialogue: 0,0:14:45.57,0:14:46.65,Default,Kyo,0,0,0,,Hả?
Dialogue: 0,0:14:47.40,0:14:48.90,Default,Sun,0,0,0,,Tha cho bọn này đi bà chị.
Dialogue: 0,0:14:48.90,0:14:51.91,Default,Sun,0,0,0,,Bọn này chẳng có chút hứng thú nào với diễn kịch cả.
Dialogue: 0,0:14:51.91,0:14:52.82,Default,Sun,0,0,0,,Đúng không mày?
Dialogue: 0,0:14:52.82,0:14:59.50,Default,Oka,0,0,0,,{\fscx108}Không được chiêu mộ bằng tờ rơi hay áp phích, nhưng nếu rủ rê bằng con đường truyền miệng bình thường thì đâu có cấm đúng không?
Dialogue: 0,0:14:59.50,0:15:04.29,Default,Sun,0,0,0,,Ồ, bất ngờ ghê nha. Mày thật sự muốn giúp con bé kìa.
Dialogue: 0,0:15:04.29,0:15:07.80,Default,Oka,0,0,0,,Đương nhiên rồi. Không giúp thì lấy đâu ra bánh mì mà ăn.
Dialogue: 0,0:15:07.80,0:15:11.26,Default,Sun,0,0,0,,Chắc tao cũng phải nghiêm túc giúp đỡ Nagisa-chan một tay thôi.
Dialogue: 0,0:15:11.26,0:15:12.76,Default,Sun,0,0,0,,Con bé trông hiền lành, thật thà ghê.
Dialogue: 0,0:15:12.76,0:15:15.47,Default,Sun,0,0,0,,Nếu thân thiết hơn thì việc đến trường chắc sẽ vui lắm đây.
Dialogue: 0,0:15:15.97,0:15:19.48,Default,Sun,0,0,0,,Được rồi, ngày mai tao nhất định sẽ ghi một cú home run trước Tomoyo cho xem!
Dialogue: 0,0:15:19.48,0:15:21.56,Default,Oka,0,0,0,,Cuộc đời mày ngày nào cũng tràn ngập thiên đường nhỉ?
Dialogue: 0,0:15:22.10,0:15:23.56,Default,Sun,0,0,0,,Home run đây!
Dialogue: 0,0:15:24.27,0:15:25.86,Default,Tom,0,0,0,,Đột nhiên lại giở trò gì thế này?
Dialogue: 0,0:15:25.86,0:15:27.82,Default,Sun,0,0,0,,Không có gì. Trò vui của hai đứa anh thôi.
Dialogue: 0,0:15:27.82,0:15:30.28,Default,Tom,0,0,0,,Mấy người định kéo dài trò này đến bao giờ nữa?
Dialogue: 0,0:15:30.28,0:15:32.36,Default,Sun,0,0,0,,Hôm nay anh đã khác hẳn rồi nhé.
Dialogue: 0,0:15:32.36,0:15:34.45,Default,Sun,0,0,0,,Cái nhìn của anh dành cho em đã hoàn toàn thay đổi.
Dialogue: 0,0:15:34.45,0:15:35.24,Default,Tom,0,0,0,,Ý anh là sao?
Dialogue: 0,0:15:35.24,0:15:38.04,Default,Oka,0,0,0,,Trước tiên mày phải khen trang phục của người ta đã.
Dialogue: 0,0:15:38.04,0:15:40.16,Default,Sun,0,0,0,,Cái món em cài trên đầu trông hợp với em lắm đấy.
Dialogue: 0,0:15:42.67,0:15:43.42,Default,Tom,0,0,0,,Cảm ơn anh.
Dialogue: 0,0:15:45.17,0:15:46.79,Default,Sun,0,0,0,,Sức hút giới tính, ha?
Dialogue: 0,0:15:46.79,0:15:49.26,Default,Sun,0,0,0,,Tao chính thức công nhận Tomoyo là một đứa con gái rồi đấy.
Dialogue: 0,0:15:49.26,0:15:52.47,Default,Sun,0,0,0,,Việc còn lại của tao chỉ là tấn công đúng bài bản thôi.
Dialogue: 0,0:15:52.47,0:15:55.55,Default,Oka,0,0,0,,Người ta ghét mày ra mặt luôn kìa.
Dialogue: 0,0:15:55.55,0:15:58.10,Default,Sun,0,0,0,,Thế nên tao mới cần mày tiếp sức đây.
Dialogue: 0,0:15:58.10,0:16:00.56,Default,Sun,0,0,0,,Trông mày với Tomoyo có vẻ cùng tần sóng hơn tao đấy.
Dialogue: 0,0:16:00.56,0:16:01.94,Default,Oka,0,0,0,,Dù sao cũng đỡ hơn mày nhiều.
Dialogue: 0,0:16:01.94,0:16:07.02,Default,Sun,0,0,0,,Nên mày mau mớm lời khuyên xem tao nên nói gì\Nđể lấy lòng Tomoyo đi.
Dialogue: 0,0:16:08.07,0:16:09.78,Default,Sun,0,0,0,,Em mặc đồng phục trông cũng xinh xắn lắm đấy.
Dialogue: 0,0:16:09.78,0:16:11.78,Default,Tom,0,0,0,,Anh làm tôi thấy buồn nôn rồi đấy.
Dialogue: 0,0:16:12.78,0:16:14.03,Default,Sun,0,0,0,,Cách này có hiệu quả thật không đấy?
Dialogue: 0,0:16:14.03,0:16:15.24,Default,Oka,0,0,0,,Cứ yên tâm đi.
Dialogue: 0,0:16:15.24,0:16:21.66,Default,Oka,0,0,0,,Tiếp theo, mày nói 'Em dễ thương thế này chắc đào hoa lắm nhỉ',\Nvừa nói vừa làm động tác duỗi người thật tự nhiên vào.
Dialogue: 0,0:16:22.58,0:16:25.75,Default,Sun,0,0,0,,Em dễ thương thế này chắc đào hoa lắm nhỉ.
Dialogue: 0,0:16:25.75,0:16:26.38,Default,Oka,0,0,0,,Nó làm thật kìa trời.
Dialogue: 0,0:16:27.21,0:16:28.42,Default,Sun,0,0,0,,Trông con bé như đang lùi lại phòng thủ kìa?
Dialogue: 0,0:16:28.42,0:16:29.55,Default,Oka,0,0,0,,Cứ yên tâm đi.
Dialogue: 0,0:16:29.55,0:16:35.22,Default,Oka,0,0,0,,Tiếp theo, mày nói 'Anh đang nghiêm túc tìm bạn gái đây',\Nvừa nói vừa làm động tác squat Hindu thật tự nhiên vào.
Dialogue: 0,0:16:36.01,0:16:38.68,Default,Sun,0,0,0,,Anh đang nghiêm túc tìm bạn gái đây.
Dialogue: 0,0:16:39.35,0:16:40.72,Default,Sun,0,0,0,,Cái điệu bộ đó gượng gạo chết đi được!
Dialogue: 0,0:16:40.72,0:16:41.93,Default,Oka,0,0,0,,Đừng có xoắn.
Dialogue: 0,0:16:41.93,0:16:46.69,Default,Oka,0,0,0,,Tiếp theo, mày nói 'Mỗi sáng hãy làm bữa điểm tâm cho anh nhé',\Nvừa nói vừa làm động tác ném bóng bowling vào.
Dialogue: 0,0:16:47.73,0:16:49.23,Default,Sun,0,0,0,,Tomoyo-san.
Dialogue: 0,0:16:49.23,0:16:53.61,Default,Sun,0,0,0,,Mỗi sáng hãy làm bữa điểm tâm cho anh nhé.
Dialogue: 0,0:16:57.95,0:17:00.08,Default,Sun,0,0,0,,Mấy cái tư thế quái đản này rốt cuộc có ý nghĩa gì không hả?!
Dialogue: 0,0:17:00.08,0:17:01.08,Default,Oka,0,0,0,,Chẳng có ý nghĩa gì sất.
Dialogue: 0,0:17:01.08,0:17:02.50,Default,Sun,0,0,0,,Đã không có ý nghĩa gì thì đừng có bắt tao làm chứ!
Dialogue: 0,0:17:02.50,0:17:05.87,Default,Tom,0,0,0,,Hóa ra nãy giờ mấy người chỉ đang đùa giỡn với tôi thôi à.
Dialogue: 0,0:17:05.87,0:17:08.75,Default,Sun,0,0,0,,Việc còn lại của tao là ra đòn phủ đầu thôi!
