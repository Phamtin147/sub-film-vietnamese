Dialogue: 0,0:00:00.00,0:00:01.88,Default,,0,0,0,,
Dialogue: 0,0:00:01.64,0:00:02.56,Default,Oka,0,0,0,,Thế nào rồi?
Dialogue: 0,0:00:02.98,0:00:04.44,Default,Nag,0,0,0,,Khổ rồi cậu ơi.
Dialogue: 0,0:00:03.98,0:00:05.98,Signs,Nag,0,0,0,,{\fs45\fax-0.27\blur1\c&H2767A1&\frz13.676\pos(1021,630)\fnArial Black\b0}Phòng Hội Học Sinh
Dialogue: 0,0:00:04.44,0:00:05.98,Default,Oka,0,0,0,,Họ bảo sao?
Dialogue: 0,0:00:06.36,0:00:09.32,Default,Nag,0,0,0,,Họ bảo việc chiêu mộ thành viên bị nghiêm cấm ạ.
Dialogue: 0,0:00:09.32,0:00:10.90,Default,Oka,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:00:10.90,0:00:16.41,Default,Nag,0,0,0,,Vì câu lạc bộ kịch hiện đang bị đình chỉ hoạt động, nên không được phép tiến hành bất kỳ sinh hoạt nào,
Dialogue: 0,0:00:16.41,0:00:21.33,Default,Nag,0,0,0,,do đó họ không cho phép dán tờ rơi tuyển mộ ạ.
Dialogue: 0,0:00:21.33,0:00:23.41,Default,Oka,0,0,0,,Lý sự vô lý đùng đùng gì thế này?!
Dialogue: 0,0:00:23.41,0:00:26.83,Default,Oka,0,0,0,,Thế là cậu cứ ngoan ngoãn 'Vâng ạ' rồi về à?
Dialogue: 0,0:00:26.83,0:00:32.26,Default,Nag,0,0,0,,Tớ cũng đã cố hết sức rồi, nhưng họ bảo 'Nội quy là nội quy'.
Dialogue: 0,0:00:39.43,0:00:40.64,Default,Oka,0,0,0,,Đừng có bỏ cuộc.
Dialogue: 0,0:00:40.64,0:00:42.39,Default,Oka,0,0,0,,Chắc chắn vẫn còn đường xoay sở khác.
Dialogue: 0,0:00:42.39,0:00:43.89,Default,Nag,0,0,0,,Cậu nghĩ vậy thật sao?
Dialogue: 0,0:00:43.89,0:00:45.85,Default,Oka,0,0,0,,Nếu không có đường sẵn, bọn mình sẽ tự mở đường.
Dialogue: 0,0:00:45.85,0:00:48.56,Default,Oka,0,0,0,,Đừng vì mấy chuyện cỏn con này\Nmà từ bỏ ước mơ của cậu.
Dialogue: 0,0:00:48.56,0:00:50.40,Default,Nag,0,0,0,,Okazaki-san...
Dialogue: 0,0:00:50.40,0:00:51.53,Default,Girl,0,0,0,,Thật thế sao?
Dialogue: 0,0:00:56.07,0:01:01.99,OP English,,0,0,0,,{\fad(250,250)\be1}Tôi từng thấy một giấc mơ trong vắt,
