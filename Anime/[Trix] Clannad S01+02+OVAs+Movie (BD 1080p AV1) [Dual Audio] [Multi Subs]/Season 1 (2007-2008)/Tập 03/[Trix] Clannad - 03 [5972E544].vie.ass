Dialogue: 0,0:03:02.87,0:03:04.37,Default,Aki,0,0,0,,Kính chào quý khách.
Dialogue: 0,0:03:04.37,0:03:06.12,Default,Aki,0,0,0,,Ồ, hóa ra là mày à.
Dialogue: 0,0:03:07.12,0:03:08.87,Default,Oka,0,0,0,,Xin lỗi vì cháu không phải là khách mua hàng nhé.
Dialogue: 0,0:03:09.29,0:03:12.17,Default,Aki,0,0,0,,Lúc nào mày cũng làm tao mừng hụt.
Dialogue: 0,0:03:12.17,0:03:14.96,Default,Aki,0,0,0,,Lần sau thì bò bằng bốn chân vào đây,\Nđể tao biết ngay mày không phải là khách nhé.
Dialogue: 0,0:03:15.34,0:03:17.46,Default,Oka,0,0,0,,Furukawa sao rồi bác?
Dialogue: 0,0:03:17.88,0:03:20.17,Default,Aki,0,0,0,,Cảm ơn mày đã ghé qua, nhưng con bé đang ngủ rồi.
Dialogue: 0,0:03:20.51,0:03:22.18,Default,Aki,0,0,0,,Để nó yên tĩnh nghỉ ngơi đi.
Dialogue: 0,0:03:22.18,0:03:25.93,Default,Aki,0,0,0,,Nói trước cho mày biết, trong lúc ngủ con bé chẳng hề\Nmớ gọi tên mày hay đại loại thế đâu nhé.
Dialogue: 0,0:03:25.93,0:03:26.85,Default,Aki,0,0,0,,Đừng có mà ảo tưởng sức mạnh đấy, rõ chưa?
Dialogue: 0,0:03:26.85,0:03:29.10,Default,Oka,0,0,0,,Cháu có hỏi vụ đó đâu.
Dialogue: 0,0:03:29.10,0:03:30.77,Default,Aki,0,0,0,,Nếu con bé có nói mớ câu gì, thì chắc chắn phải là thế này:
Dialogue: 0,0:03:30.77,0:03:33.02,Default,Aki,0,0,0,,"Ôi, bố ơi, con yêu bố nhất trần đời!"
Dialogue: 0,0:03:33.02,0:03:34.69,Default,Aki,0,0,0,,"Bố ngầu lòi quá đi mất!"
Dialogue: 0,0:03:34.69,0:03:37.57,Default,Aki,0,0,0,,"Bố với người mẹ xinh đẹp của con đúng là trời sinh một cặp!"
Dialogue: 0,0:03:38.82,0:03:40.24,Default,Aki,0,0,0,,Đừng có nhìn tao bằng ánh mắt như nhìn thằng đần thế hả mày!
Dialogue: 0,0:03:40.11,0:03:41.49,Default-alt,Oka,0,0,0,,Tự bác làm trò chứ ai vào đây nữa!
Dialogue: 0,0:03:41.49,0:03:42.61,Default,San,0,0,0,,Okazaki-san đấy à.
Dialogue: 0,0:03:43.20,0:03:46.03,Default,San,0,0,0,,Cháu đến thăm Nagisa sao?
Dialogue: 0,0:03:46.03,0:03:48.54,Default,Oka,0,0,0,,Dạ vâng. Cháu nghe nói cậu ấy phải nằm liệt giường.
Dialogue: 0,0:03:48.91,0:03:51.21,Default,San,0,0,0,,Không đâu, con bé chỉ bị sốt nhẹ thôi mà.
Dialogue: 0,0:03:52.04,0:03:52.41,Default,San,0,0,0,,Chỉ là…
Dialogue: 0,0:03:54.37,0:03:57.29,Default,San,0,0,0,,…vốn dĩ thể trạng của Nagisa từ trước đã rất yếu ớt rồi.
Dialogue: 0,0:03:57.75,0:04:00.34,Default,San,0,0,0,,Năm ngoái con bé cũng từng phải nghỉ học suốt một thời gian dài,
Dialogue: 0,0:04:01.22,0:04:05.59,Default,San,0,0,0,,nên bác sĩ dặn hôm nay cứ để con bé nghỉ ngơi trên giường cho an toàn.
Dialogue: 0,0:04:06.05,0:04:06.93,Default,Oka,0,0,0,,Dạ, cháu hiểu rồi.
Dialogue: 0,0:04:07.47,0:04:11.81,Default,Aki,0,0,0,,Dù sao thì, cũng nhờ có mày cõng con bé về,\Nnên mọi chuyện mới không đến mức tồi tệ hơn.
Dialogue: 0,0:04:12.23,0:04:13.02,Default,Aki,0,0,0,,Cảm ơn mày nhiều lắm nhé.
Dialogue: 0,0:04:13.52,0:04:15.44,Default,Oka,0,0,0,,Không đâu ạ, tất cả là do lỗi của cháu.
Dialogue: 0,0:04:17.40,0:04:18.77,Default,Aki,0,0,0,,Bánh mì của Sanae này.
Dialogue: 0,0:04:18.77,0:04:19.40,Default,Aki,0,0,0,,Cầm lấy đi.
Dialogue: 0,0:04:20.15,0:04:21.57,Default,Aki,0,0,0,,Cứ cầm lấy đi mày.
Dialogue: 0,0:04:21.57,0:04:22.53,Default,Aki,0,0,0,,Xem như chút lòng thành cảm tạ của gia đình tao.
Dialogue: 0,0:04:22.53,0:04:25.16,Default,Oka,0,0,0,,Cháu đến đây đâu phải vì mấy cái này.
Dialogue: 0,0:04:25.16,0:04:26.74,Default,Aki,0,0,0,,Đừng có khách sáo làm gì.
Dialogue: 0,0:04:26.74,0:04:29.28,Default,Aki,0,0,0,,Đằng nào thì cái đống này rõ ràng cũng sẽ bị ế thừa lại thôi mà.
Dialogue: 0,0:04:31.04,0:04:33.41,Default,San,0,0,0,,Vậy là… bánh của em…
Dialogue: 0,0:04:34.08,0:04:37.58,Default,San,0,0,0,,…chính là gánh nặng ăn hại của Tiệm bánh Furukawa sao trời ơi?!
Dialogue: 0,0:04:38.88,0:04:41.84,Default,Aki,0,0,0,,Anh yêu bánh của em nhất trần đời!
Dialogue: 0,0:04:43.01,0:04:46.26,Default,Oka,0,0,0,,Xem ra mình chẳng có gì phải bận tâm lo lắng cho cái nhà này cả.
Dialogue: 0,0:04:46.26,0:04:47.09,Default,Ibu,0,0,0,,Xin lỗi đã làm phiền.
Dialogue: 0,0:04:47.47,0:04:48.60,Default,Ibu,0,0,0,,Người bán hàng ở đây đâu rồi ạ?
Dialogue: 0,0:04:48.60,0:04:50.93,Default,Oka,0,0,0,,Họ vừa mới hớt hải chạy ra ngoài rồi ạ.
Dialogue: 0,0:04:53.02,0:04:54.39,Default,Oka,0,0,0,,Nếu chị thích thì cứ lấy cái này đi.
Dialogue: 0,0:04:55.64,0:04:56.77,Default,Ibu,0,0,0,,Thật vậy sao em?
Dialogue: 0,0:04:56.77,0:04:59.23,Default,Oka,0,0,0,,Vâng. Đằng nào họ cũng cho em miễn phí mà.
Dialogue: 0,0:04:59.23,0:05:00.57,Default,Ibu,0,0,0,,Chị cảm ơn em nhé.
Dialogue: 0,0:05:00.57,0:05:04.28,Default,Ibu,0,0,0,,Nhờ em chuyển lời cảm ơn của chị đến Sanae-san và chồng chị ấy giúp chị nhé.
Dialogue: 0,0:05:08.28,0:05:09.57,Default,Oka,0,0,0,,Một người phụ nữ thật xinh đẹp.
Dialogue: 0,0:05:18.21,0:05:20.63,Default,Oka,0,0,0,,Cậu ấy ngốc thật đấy. Đã biết rõ thể trạng mình yếu ớt thế rồi cơ mà.
Dialogue: 0,0:05:21.38,0:05:21.75,Default,Man,0,0,0,,Này cậu kia!
Dialogue: 0,0:05:22.38,0:05:22.75,Default,Man,0,0,0,,Cậu kia!
Dialogue: 0,0:05:23.17,0:05:24.30,Default,Man,0,0,0,,Cậu học sinh đằng kia ơi!
Dialogue: 0,0:05:24.30,0:05:24.67,Default,Oka,0,0,0,,Gì thế ạ?
Dialogue: 0,0:05:27.01,0:05:28.76,Default,Man,0,0,0,,Nhìn vết móp này xem!
Dialogue: 0,0:05:29.22,0:05:32.01,Default,Man,0,0,0,,Một dụng cụ thi công rơi xuống làm móp xe tôi đấy.
Dialogue: 0,0:05:32.01,0:05:34.31,Default,Man,0,0,0,,Cậu làm nhân chứng giúp tôi được không?
Dialogue: 0,0:05:34.31,0:05:35.14,Default,Oka,0,0,0,,Nhân chứng sao?
Dialogue: 0,0:05:35.14,0:05:37.77,Default,Yos,0,0,0,,Kéo một người chẳng liên quan vào chuyện này, hành động đó thật hèn hạ.
Dialogue: 0,0:05:38.23,0:05:41.15,Default,Man,0,0,0,,Không có nhân chứng thì anh sẽ quất ngựa truy phong chứ gì?
Dialogue: 0,0:05:42.02,0:05:45.03,Default,Yos,0,0,0,,Như tôi đã nói rất nhiều lần rồi, tôi không hề làm rơi bất kỳ dụng cụ nào cả.
Dialogue: 0,0:05:45.53,0:05:47.95,Default,Yos,0,0,0,,Và nếu tôi có làm rơi, tôi cũng chẳng bao giờ chối bỏ trách nhiệm.
Dialogue: 0,0:05:47.95,0:05:49.70,Default,Man,0,0,0,,Làm sao tôi tin lời anh được chứ?!
Dialogue: 0,0:05:49.70,0:05:52.03,Default,Yos,0,0,0,,Nếu anh yêu cầu tôi phải bồi thường tiền sửa xe, tôi sẽ đền.
Dialogue: 0,0:05:52.41,0:05:53.41,Default,Man,0,0,0,,Vậy là anh thừa nhận mình làm rồi chứ gì?!
Dialogue: 0,0:05:54.04,0:05:56.75,Default,Yos,0,0,0,,Không, tôi chỉ muốn vào một ngày nào đó trong đời, anh hãy ngẫm nghĩ lại…
Dialogue: 0,0:05:57.21,0:06:00.92,Default,Yos,0,0,0,,…rằng những lời người thợ điện nói ngày hôm ấy là thật hay là giả dối.
Dialogue: 0,0:06:01.34,0:06:03.63,Default,Yos,0,0,0,,Tại nơi mà tâm hồn anh cảm thấy mãn nguyện và bình yên nhất.
Dialogue: 0,0:06:04.00,0:06:06.34,Default,Yos,0,0,0,,Bên cạnh người mà anh trân quý nhất trên cõi đời này.
Dialogue: 0,0:06:08.68,0:06:10.59,Default,Man,0,0,0,,Hắn ta đang lảm nhảm cái quái gì thế?
Dialogue: 0,0:06:10.59,0:06:12.14,Default,Oka,0,0,0,,Đừng có hỏi tôi.
Dialogue: 0,0:06:13.10,0:06:15.64,Default,Yos,0,0,0,,Cuộc đời con người là chuỗi ngày lặp đi lặp lại của những nỗi đau gây ra cho nhau.
Dialogue: 0,0:06:16.31,0:06:17.93,Default,Yos,0,0,0,,Nghi ngờ người khác cũng là điều dễ hiểu thôi.
Dialogue: 0,0:06:19.06,0:06:23.40,Default,Yos,0,0,0,,Thế nhưng, không thể tin tưởng bất kỳ điều gì cũng đồng nghĩa với việc\Nkhông thể cảm nhận được tình yêu thương từ những người xung quanh.
Dialogue: 0,0:06:23.86,0:06:26.28,Default,Yos,0,0,0,,Phải chăng trong lòng anh đang cảm thấy cô độc khôn nguôi?
Dialogue: 0,0:06:26.82,0:06:27.90,Default,Yos,0,0,0,,Phải chăng anh đang sống một cuộc đời đầy nô lệ, gò bó?
Dialogue: 0,0:06:28.45,0:06:29.65,Default,Yos,0,0,0,,Liệu anh có thể nở một nụ cười rạng rỡ với một trái tim chân thành hay không?
Dialogue: 0,0:06:31.45,0:06:31.99,Default,Man,0,0,0,,Tôi nghĩ là có chứ…
Dialogue: 0,0:06:32.32,0:06:32.82,Default,Yos,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:06:34.03,0:06:36.41,Default,Yos,0,0,0,,Vậy thì hẳn là anh đang được yêu thương.
Dialogue: 0,0:06:37.00,0:06:40.33,Default,Yos,0,0,0,,Xin anh hãy tiếp tục sống sao cho tình yêu thương ấy không bao giờ phai nhạt.
Dialogue: 0,0:06:40.71,0:06:43.96,Default,Oka,0,0,0,,Mình phục sát đất khả năng bắn ra những câu thoại sến rện của anh ta đấy.
Dialogue: 0,0:06:48.67,0:06:49.76,Default,Oka,0,0,0,,Này bác tài ơi.
Dialogue: 0,0:06:50.88,0:06:51.68,Default,Oka,0,0,0,,Chắc là do mèo đấy ạ.
Dialogue: 0,0:06:52.18,0:06:52.93,Default,2,0,0,0,,Mèo á?
Dialogue: 0,0:06:52.93,0:06:55.31,Default,Oka,0,0,0,,Bác nhìn từ góc độ này mà xem, thấy không?
Dialogue: 0,0:06:56.43,0:06:57.52,Default,Man,0,0,0,,Đúng thật này!
Dialogue: 0,0:06:59.48,0:07:03.23,Default,Oka,0,0,0,,Cháu cá là có con mèo nào đó nhảy từ bờ tường kia xuống làm móp xe đấy.
Dialogue: 0,0:07:12.91,0:07:14.99,Default,Yos,0,0,0,,Cảm ơn cậu nhé. Cậu đã cứu tôi một bàn thua trông thấy rồi.
Dialogue: 0,0:07:14.99,0:07:17.87,Default,Oka,0,0,0,,Em chỉ nói những gì mắt mình thấy thôi.
Dialogue: 0,0:07:18.37,0:07:19.87,Default,Yos,0,0,0,,Tôi muốn cảm ơn cậu một cách đàng hoàng.
Dialogue: 0,0:07:20.29,0:07:22.12,Default,Yos,0,0,0,,Khi nào rảnh rỗi cứ gọi điện cho tôi nhé.
Dialogue: 0,0:07:24.38,0:07:26.42,Default,Sun,0,0,0,,Anh ta vừa nói những gì thế?
Dialogue: 0,0:07:27.00,0:07:33.14,Default,Oka,0,0,0,,Đại loại như "anh có đang cô đơn một mình không",\Nhay "anh có đang mỉm cười không", và mấy thứ tương tự thế.
Dialogue: 0,0:07:33.72,0:07:35.22,Default,Sun,0,0,0,,Đó chính là MC huyền thoại…
Dialogue: 0,0:07:35.55,0:07:37.89,Default,Sun,0,0,0,,Chính là {\i1}ngôi sao ca nhạc{\i0\fscx30.303} {\r} Yoshino Yuusuke đấy!
Dialogue: 0,0:07:38.64,0:07:39.60,Default,Oka,0,0,0,,Mày quen anh ta à?
Dialogue: 0,0:07:39.60,0:07:42.85,Default,Sun,0,0,0,,Quen quá đi chứ lị. Anh ta là một nhạc sĩ đầy sức hút đã giải nghệ đấy.
Dialogue: 0,0:07:43.19,0:07:45.94,Default,Sun,0,0,0,,Từng phát hành đĩa CD và cực kỳ nổi tiếng một thời luôn.
Dialogue: 0,0:07:45.94,0:07:46.40,Default,Oka,0,0,0,,Thật đấy à?
Dialogue: 0,0:07:48.32,0:07:51.61,Default,Sun,0,0,0,,Anh ta từng bặt vô âm tín, ai ngờ lại dạt về tận cái thị trấn này chứ.
Dialogue: 0,0:07:52.36,0:07:54.53,Default,Sun,0,0,0,,Tao có đĩa tuyển tập "The Best of" do chính tay em gái tao làm tặng này.
Dialogue: 0,0:07:55.12,0:07:56.20,Default,Sun,0,0,0,,Nghe thử đi mày.
Dialogue: 0,0:07:56.20,0:07:58.74,Default,Oka,0,0,0,,Khoan đã. Mày có em gái á?
Dialogue: 0,0:07:58.74,0:08:00.25,Default,Sun,0,0,0,,Ừ. Tao chưa kể cho mày nghe bao giờ à?
Dialogue: 0,0:08:00.87,0:08:02.62,Default,Oka,0,0,0,,Em gái của Sunohara sao…
Dialogue: 0,0:08:03.54,0:08:05.88,Default,Oka,0,0,0,,Cá chắc mặt mũi con bé trông phải y hệt thế này.
Dialogue: 0,0:08:12.26,0:08:13.80,Default,Oka,0,0,0,,Yoshino Yuusuke sao…
Dialogue: 0,0:08:17.01,0:08:17.72,Default,Sun,0,0,0,,Okazaki.
Dialogue: 0,0:08:18.22,0:08:19.64,Default,Sun,0,0,0,,Okazaki, mày có đang nghe tao nói không đấy?
Dialogue: 0,0:08:20.22,0:08:20.89,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:08:21.89,0:08:23.19,Default,Oka,0,0,0,,Hả, cái gì thế?
Dialogue: 0,0:08:23.19,0:08:24.77,Default,Sun,0,0,0,,Tao đang nói về Sakagami Tomoyo đấy.
Dialogue: 0,0:08:25.27,0:08:26.27,Default,Sun,0,0,0,,Tao vừa nghĩ ra một chuyện…
Dialogue: 0,0:08:27.02,0:08:29.15,Default,Sun,0,0,0,,Có khi nào nhỏ đó thực ra là đàn ông con trai không nhỉ.
Dialogue: 0,0:08:29.73,0:08:32.57,Default,Sun,0,0,0,,Con gái làm quái gì có cửa mạnh hơn đàn ông con trai được chứ!
Dialogue: 0,0:08:32.86,0:08:35.61,Default,Sun,0,0,0,,Hắn ta đang giả gái để lừa gạt cả thế giới này đấy!
Dialogue: 0,0:08:35.61,0:08:36.82,Default,Oka,0,0,0,,Mày nghiêm túc đấy à?
Dialogue: 0,0:08:37.32,0:08:40.79,Default,Sun,0,0,0,,Ngày mai, tao sẽ chứng minh cho mày thấy hắn ta là đực rựa 100%.
Dialogue: 0,0:08:41.33,0:08:47.25,Default,Oka,0,0,0,,Vào khoảnh khắc ấy, Sunohara vẫn chưa nhận ra rằng\Nmình đã bắt đầu bước chân vào con đường của một kẻ biến thái.
Dialogue: 0,0:08:47.79,0:08:49.00,Default,Sun,0,0,0,,Tao nghe thấy hết đấy nhé thằng khốn.
Dialogue: 0,0:08:52.88,0:08:53.84,Default,Tom,0,0,0,,Gì nữa đây?
Dialogue: 0,0:08:54.30,0:08:57.01,Default,Sun,0,0,0,,Hôm nay tôi không đến để khiêu chiến đâu.
Dialogue: 0,0:08:57.01,0:08:58.72,Default,Sun,0,0,0,,Tôi chỉ muốn trò chuyện tâm tình một chút thôi mà.
Dialogue: 0,0:08:58.72,0:09:00.47,Default,Oka,0,0,0,,Cứ nghe xem cậu ta nói gì đi.
Dialogue: 0,0:09:00.47,0:09:03.48,Default,Sun,0,0,0,,Sáng nay tôi ngủ quên một giấc, hốt hoảng cả người luôn á.
Dialogue: 0,0:09:04.06,0:09:04.06,Default,Sun,0,0,0,,Hì hì.
Dialogue: 0,0:09:04.56,0:09:06.44,Default,Tom,0,0,0,,Tính cách của cậu đổi màu nhanh gớm nhỉ.
Dialogue: 0,0:09:06.44,0:09:13.32,Default,Sun,0,0,0,,Lúc tôi lấy dao cạo râu ra cạo thì lưỡi dao bị mẻ mất,\Nlàm mặt tôi đau điếng người luôn.
Dialogue: 0,0:09:13.32,0:09:14.19,Default,Tom,0,0,0,,Ra vậy.
Dialogue: 0,0:09:14.19,0:09:17.32,Default,Sun,0,0,0,,Thế nên nếu cậu không phiền, cho tôi mượn dao cạo râu của cậu một lát được không?
Dialogue: 0,0:09:17.74,0:09:20.03,Default,Tom,0,0,0,,Tại sao tôi lại phải cho cậu mượn chứ?
Dialogue: 0,0:09:20.03,0:09:22.16,Default,Sun,0,0,0,,Hoan hô! Hắn cắn câu rồi!
Dialogue: 0,0:09:22.16,0:09:23.62,Default,Sun,0,0,0,,Mày cũng nghe thấy rõ mồn một rồi đúng không?
Dialogue: 0,0:09:23.62,0:09:24.41,Default,Oka,0,0,0,,Thì có nghe, nhưng mà…
Dialogue: 0,0:09:24.41,0:09:26.04,Default,Tom,0,0,0,,Chuyện này rốt cuộc là sao?
Dialogue: 0,0:09:26.04,0:09:28.67,Default,Sun,0,0,0,,Cậu vừa nói là: "Tại sao tôi lại phải cho cậu mượn", đúng chứ?
Dialogue: 0,0:09:28.67,0:09:31.84,Default,Sun,0,0,0,,Nói cách khác, cậu có sở hữu dao cạo râu!
Dialogue: 0,0:09:31.84,0:09:32.80,Default,Sun,0,0,0,,Điều đó chứng minh rằng—
Dialogue: 0,0:09:32.05,0:09:33.55,Default-alt,Tom,0,0,0,,Tôi không hề có thứ đó.
Dialogue: 0,0:09:33.96,0:09:39.97,Default,Tom,0,0,0,,Khi tôi nói "tại sao", ý tôi là: "Tại sao tôi phải cho cậu mượn đồ dùng cá nhân của mình?"
Dialogue: 0,0:09:40.60,0:09:41.18,Default,Tom,0,0,0,,Trước hết là…
Dialogue: 0,0:09:41.64,0:09:42.43,Default,Sun,0,0,0,,Trước hết là sao?
Dialogue: 0,0:09:42.43,0:09:44.81,Default,Tom,0,0,0,,Đòi hỏi một thiếu nữ chuyện như thế là vô cùng khiếm nhã đấy!
Dialogue: 0,0:09:49.94,0:09:50.77,Default,Sun,0,0,0,,Cô tính giết tôi đấy à!
Dialogue: 0,0:09:51.19,0:09:51.90,Default,Tom,0,0,0,,Chào nhé.
Dialogue: 0,0:10:20.64,0:10:21.60,Default,Nag,0,0,0,,Tớ vui lắm.
Dialogue: 0,0:10:22.76,0:10:25.60,Default,Nag,0,0,0,,Tớ mừng vì mình đã gom đủ dũng khí để vẫy tay chào cậu.
Dialogue: 0,0:10:27.31,0:10:33.94,Default,Nag,0,0,0,,Tớ cứ ngỡ là cậu sẽ không tha thứ cho tớ, vì tớ đã làm tổn thương cậu…
Dialogue: 0,0:10:34.40,0:10:35.94,Default,Oka,0,0,0,,Tôi cũng xin lỗi cậu nữa.
Dialogue: 0,0:10:36.61,0:10:37.19,Default,Oka,0,0,0,,Thật lòng đấy.
Dialogue: 0,0:10:44.66,0:10:46.79,Default,Nag,0,0,0,,Tớ xin lỗi nhé. Tự dưng thấy nhẹ nhõm trong lòng quá nên…
Dialogue: 0,0:10:47.66,0:10:49.29,Default,Nag,0,0,0,,Tớ đúng là một đứa ngốc nghếch mà, phải không cậu?
Dialogue: 0,0:10:59.05,0:11:02.51,Default,Oka,0,0,0,,Cậu có thể ngốc nghếch thật, nhưng tôi chẳng nghĩ điều đó có gì là sai trái cả.
Dialogue: 0,0:11:05.06,0:11:06.14,Default,Nag,0,0,0,,Cậu thấy thế thật sao?
Dialogue: 0,0:11:07.56,0:11:08.64,Default,Oka,0,0,0,,Vì bản thân tôi cũng là một thằng ngốc mà thôi.
Dialogue: 0,0:11:09.27,0:11:10.10,Default,Oka,0,0,0,,Tôi với cậu cũng cùng một đẳng cấp cả thôi.
Dialogue: 0,0:11:11.06,0:11:15.44,Default,Oka,0,0,0,,Khác xa một trời một vực với những kẻ đối nhân xử thế khéo léo\Nhay dám liều mạng đánh cược trên đời.
Dialogue: 0,0:11:17.23,0:11:21.28,Default,Oka,0,0,0,,Tôi cá là cậu đang phải gánh chịu nhiều áp lực lắm,\Nnhưng nếu phải khóc một mình, thì cứ đến tìm tôi.
Dialogue: 0,0:11:23.28,0:11:26.03,Default,Oka,0,0,0,,Ý tôi là, dù sao tôi cũng đang rảnh rỗi mà.
Dialogue: 0,0:11:26.03,0:11:29.20,Default,Oka,0,0,0,,Ở bên cạnh cậu giúp tôi chẳng bao giờ thấy buồn chán cả.
Dialogue: 0,0:11:29.58,0:11:32.58,Default,Nag,0,0,0,,Vâng. Những lúc muốn khóc, tớ nhất định sẽ gọi cậu.
Dialogue: 0,0:11:42.51,0:11:43.89,Default,Oka,0,0,0,,Em đang làm gì thế?
Dialogue: 0,0:11:46.85,0:11:48.64,Default,Fuk,0,0,0,,Đang tìm kiếm con dao gọt.
Dialogue: 0,0:11:48.64,0:11:49.60,Default,Nag,0,0,0,,Dao gọt á?
Dialogue: 0,0:11:49.10,0:11:49.60,Default-alt,Oka,0,0,0,,Ồ.
Dialogue: 0,0:11:51.23,0:11:51.77,Default,Oka,0,0,0,,Cái này phải không?
Dialogue: 0,0:11:51.77,0:11:53.14,Default,Fuk,0,0,0,,Làm ơn hãy trả lại cho Fuko.
Dialogue: 0,0:11:53.14,0:11:54.31,Default,Oka,0,0,0,,Tay em thế nào rồi?
Dialogue: 0,0:11:54.31,0:11:55.73,Default,Fuk,0,0,0,,Hết đau rồi ạ.
Dialogue: 0,0:11:55.73,0:11:56.90,Default,Fuk,0,0,0,,Lành lặn rồi.
Dialogue: 0,0:11:56.90,0:11:57.61,Default,Oka,0,0,0,,Bắt tay cái nào.
Dialogue: 0,0:11:57.61,0:11:58.19,Default,Fuk,0,0,0,,Vâng.
Dialogue: 0,0:11:59.23,0:11:59.98,Default,Oka,0,0,0,,Đau đúng không?
Dialogue: 0,0:11:59.98,0:12:01.44,Default,Fuk,0,0,0,,Không hề đau chút nào.
Dialogue: 0,0:12:01.44,0:12:03.15,Default,Nag,0,0,0,,Trông em như thể đang đau đớn dữ dội lắm ấy.
Dialogue: 0,0:12:03.15,0:12:03.74,Default,Oka,0,0,0,,Đập tay năm ngón nào!
Dialogue: 0,0:12:03.74,0:12:05.74,Default,Fuk,0,0,0,,Dẫn bóng…
Dialogue: 0,0:12:04.74,0:12:06.12,Default-alt,Oka,0,0,0,,Lại từ tít đằng xa thế nữa à?
Dialogue: 0,0:12:05.74,0:12:07.16,Default,Fuk,0,0,0,,Ném bóng!
Dialogue: 0,0:12:07.33,0:12:08.49,Default,Fuk,0,0,0,,Vào rổ rồi!
Dialogue: 0,0:12:08.49,0:12:09.45,Default,2,0,0,0,,Hoan hô!
Dialogue: 0,0:12:10.25,0:12:11.08,Default,Oka,0,0,0,,Rõ ràng là đau điếng người đúng không?
Dialogue: 0,0:12:11.08,0:12:12.37,Default,Fun,0,0,0,,Không có đau mà.
Dialogue: 0,0:12:12.37,0:12:14.08,Default,Nag,0,0,0,,Trông em thật sự như đang đau lắm đấy.
Dialogue: 0,0:12:14.08,0:12:15.71,Default,Oka,0,0,0,,Thế thì chúng ta chơi trò võ sĩ và huấn luyện viên nhé.
Dialogue: 0,0:12:17.04,0:12:18.42,Default,Oka,0,0,0,,Em sẽ làm huấn luyện viên, được chứ.
Dialogue: 0,0:12:19.30,0:12:24.72,Default,Oka,0,0,0,,Em đặt hai tay thế này,\Nrồi anh sẽ đấm liên tục vào tay em.
Dialogue: 0,0:12:25.84,0:12:27.55,Default,Nag,0,0,0,,O-Okazaki-san à.
Dialogue: 0,0:12:27.55,0:12:30.35,Default,Oka,0,0,0,,Em nhớ hô: "Một! Hai! Một! Hai!" nhé.
Dialogue: 0,0:12:30.35,0:12:30.93,Default,Oka,0,0,0,,Sẵn sàng chưa?
Dialogue: 0,0:12:30.93,0:12:31.60,Default,Fuk,0,0,0,,V-Vâng ạ.
Dialogue: 0,0:12:32.18,0:12:32.93,Default,Oka,0,0,0,,Anh ra đòn đây.
Dialogue: 0,0:12:32.93,0:12:34.73,Default,Oka,0,0,0,,Đấm thẳng! Đấm móc! Đấm thẳng!
Dialogue: 0,0:12:34.31,0:12:36.40,Default-alt,Fuk,0,0,0,,Một! Hai! Một! Hai!
Dialogue: 0,0:12:37.11,0:12:39.65,Default,Fuk,0,0,0,,Một! Hai! Một! Hai!
Dialogue: 0,0:12:39.65,0:12:42.11,Default-alt,Fuk,0,0,0,,Một! Hai! Một! Hai!
Dialogue: 0,0:12:41.11,0:12:42.40,Default,Oka,0,0,0,,Em tính hô như thế đến bao giờ nữa hả?
Dialogue: 0,0:12:42.11,0:12:42.78,Default-alt,Fuk,0,0,0,,Một—
Dialogue: 0,0:12:45.61,0:12:46.87,Default,Oka,0,0,0,,Chuông reo rồi kìa. Đi thôi.
Dialogue: 0,0:12:47.78,0:12:48.41,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:12:48.41,0:12:48.91,Default,Fuk,0,0,0,,Ừm…
Dialogue: 0,0:12:49.45,0:12:50.70,Default,Fuk,0,0,0,,Cái này tặng anh chị nè.
Dialogue: 0,0:12:51.04,0:12:51.70,Default,Oka,0,0,0,,Thứ gì đây?
Dialogue: 0,0:12:52.20,0:12:53.54,Default,Oka,0,0,0,,Hả? Này!
Dialogue: 0,0:12:56.00,0:12:57.79,Default,Oka,0,0,0,,Là một ngôi sao đúng không?
Dialogue: 0,0:13:01.09,0:13:01.84,Default,Oka,0,0,0,,Sunohara.
Dialogue: 0,0:13:02.26,0:13:03.76,Default,Oka,0,0,0,,Sunohara, mày còn sống không đấy?
Dialogue: 0,0:13:03.76,0:13:04.67,Default,Oka,0,0,0,,Tan học từ đời nào rồi kìa.
Dialogue: 0,0:13:07.39,0:13:08.68,Default,Sun,0,0,0,,Hết giờ học rồi á?
Dialogue: 0,0:13:09.10,0:13:11.56,Default,Oka,0,0,0,,Ừ, hết từ khoảng một trăm năm trước rồi.
Dialogue: 0,0:13:11.56,0:13:12.35,Default,Sun,0,0,0,,Một trăm năm á?
Dialogue: 0,0:13:13.39,0:13:14.64,Default,Sun,0,0,0,,Thế thì mày phải chết ngắc rồi chứ.
Dialogue: 0,0:13:14.64,0:13:16.52,Default,Oka,0,0,0,,Đúng thế. Tao chỉ là một ảnh ảo giao thoa (hologram) thôi.
Dialogue: 0,0:13:16.85,0:13:17.35,Default,Sun,0,0,0,,Thật đấy à?!
Dialogue: 0,0:13:17.81,0:13:21.61,Default,Oka,0,0,0,,Mày đã ngủ li bì suốt một trăm năm sau khi bị Tomoyo đá bay.
Dialogue: 0,0:13:22.36,0:13:24.78,Default,Oka,0,0,0,,Đây là thế giới của một trăm năm sau kể từ ngày hôm ấy.
Dialogue: 0,0:13:24.78,0:13:27.86,Default,Sun,0,0,0,,Khoan đã! Thế còn phần còn lại\Ncủa thế giới thì ra sao rồi?!
Dialogue: 0,0:13:27.86,0:13:28.57,Default,Oka,0,0,0,,Tận thế rồi.
Dialogue: 0,0:13:28.99,0:13:29.78,Default,Sun,0,0,0,,Thật đấy á?!
Dialogue: 0,0:13:30.87,0:13:33.95,Default,Sun,0,0,0,,Bố ơi. Mẹ ơi. Con xin lỗi vì đến tận phút cuối đời vẫn là một thằng đại đần độn.
Dialogue: 0,0:13:34.25,0:13:36.79,Default,Sun,0,0,0,,Con sẽ sống hết mình dẫu cho chỉ còn lại một thân một mình nơi này.
Dialogue: 0,0:13:36.79,0:13:38.58,Default,Oka,0,0,0,,Tỉnh ngủ giùm tao cái coi.
Dialogue: 0,0:13:39.67,0:13:41.09,Default,Sun,0,0,0,,Cái ảnh ảo vừa mới đá tao kìa.
Dialogue: 0,0:13:41.96,0:13:43.17,Default,Sun,0,0,0,,Mày là người thật!
Dialogue: 0,0:13:43.17,0:13:44.76,Default,Oka,0,0,0,,Thực ra tao là một người máy sinh học (cyborg).
Dialogue: 0,0:13:45.76,0:13:47.84,Default,Sun,0,0,0,,Thế còn chuyện mày bảo thế giới đã tận thế…
Dialogue: 0,0:13:48.34,0:13:48.72,Default,Oka,0,0,0,,Là thật đấy.
Dialogue: 0,0:13:49.09,0:13:50.05,Default,Sun,0,0,0,,Thật đấy á?!
Dialogue: 0,0:13:50.43,0:13:53.10,Default,Sun,0,0,0,,Bố ơi. Mẹ ơi. Con xin lỗi vì con đã quá đỗi ngu ngốc.
Dialogue: 0,0:13:53.43,0:13:56.68,Default,Sun,0,0,0,,Con sẽ sống hết mình cùng với người máy sinh học Okazaki.
Dialogue: 0,0:13:57.19,0:13:58.77,Default,Oka,0,0,0,,Tao thật không thể tin nổi là mày có thể\Ntiếp tục cái trò hề đó lâu đến thế đấy.
Dialogue: 0,0:13:59.31,0:14:00.69,Default,Sun,0,0,0,,Mày lừa tao đấy à?
Dialogue: 0,0:14:00.69,0:14:01.73,Default,Oka,0,0,0,,Thế mà mày cũng tin sái cổ cho được?
Dialogue: 0,0:14:01.73,0:14:03.82,Default,Sun,0,0,0,,Ai bảo lúc đó tao đang ngái ngủ nửa tỉnh nửa mê chứ lị.
Dialogue: 0,0:14:04.57,0:14:05.82,Default,Sun,0,0,0,,Này! Mày có nghe tao nói không đấy?
Dialogue: 0,0:14:06.19,0:14:07.07,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:14:10.57,0:14:12.24,Default,Sun,0,0,0,,Mày đang tìm kiếm thứ gì đấy à?
Dialogue: 0,0:14:13.91,0:14:15.75,Default,Bot,0,0,0,,Éc. Éc.
Dialogue: 0,0:14:15.75,0:14:16.33,Default,Bot,0,0,0,,Éc.
Dialogue: 0,0:14:17.00,0:14:19.08,Default,Sun,0,0,0,,D-Dễ thương quá mức cho phép rồi đấy.
Dialogue: 0,0:14:19.08,0:14:19.46,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:14:19.87,0:14:21.92,Default,Oka,0,0,0,,Nó có một nét cuốn hút mà chó hay mèo chẳng thể nào có được.
Dialogue: 0,0:14:19.87,0:14:21.92,Default-alt,Bot,0,0,0,,Éc. Éc.
Dialogue: 0,0:14:22.42,0:14:23.75,Default,Sun,0,0,0,,Cơ mà, con này là con gì thế?
Dialogue: 0,0:14:23.75,0:14:24.42,Default,Oka,0,0,0,,Ai mà biết được.
Dialogue: 0,0:14:26.76,0:14:27.84,Default,Bot,0,0,0,,Éc! Éc!
Dialogue: 0,0:14:27.84,0:14:30.39,Default,Sun,0,0,0,,Nào nào, đừng có chạy trốn chứ bé cưng.
Dialogue: 0,0:14:28.97,0:14:30.18,Default-alt,Bot,0,0,0,,Éc! Éc!
Dialogue: 0,0:14:30.39,0:14:33.22,Default-alt,Bot,0,0,0,,Éc! Éc! Éc! Éc!
Dialogue: 0,0:14:32.43,0:14:33.22,Default,Sun,0,0,0,,Nó có vẻ không thích bị sờ mó đâu.
Dialogue: 0,0:14:33.22,0:14:34.31,Default,Kyo,0,0,0,,Này lũ kia!
Dialogue: 0,0:14:42.27,0:14:43.02,Default,Oka,0,0,0,,Sunohara!
Dialogue: 0,0:14:43.44,0:14:45.61,Default,Oka,0,0,0,,So với cú đá của Tomoyo, thì cú này đau hơn không mày?
Dialogue: 0,0:14:45.61,0:14:47.19,Default,Sun,0,0,0,,Mày còn khối thứ khác quan trọng hơn để hỏi cơ mà, đúng không?!
Dialogue: 0,0:14:50.78,0:14:54.95,Default,Sun,0,0,0,,Tao hình như vừa thấy thứ gì đó màu xanh nhạt lướt qua cùng với đế giày.
Dialogue: 0,0:14:56.54,0:14:57.95,Default,Kyo,0,0,0,,Xóa sạch nó khỏi đầu mày ngay lập tức!
Dialogue: 0,0:15:02.46,0:15:02.96,Default,Bot,0,0,0,,Éc!
Dialogue: 0,0:15:06.75,0:15:09.22,Default,Kyo,0,0,0,,Cậu nghĩ mình đang làm cái trò gì với cục cưng của tôi thế hả?
Dialogue: 0,0:15:09.30,0:15:11.01,Default,Oka,0,0,0,,Đó là thú cưng của cậu đấy à?
Dialogue: 0,0:15:09.30,0:15:09.80,Default-alt,Bot,0,0,0,,Éc.
Dialogue: 0,0:15:11.09,0:15:12.22,Default,Kyo,0,0,0,,Ừ, một con urinko.
Dialogue: 0,0:15:12.68,0:15:15.18,Default,Kyo,0,0,0,,Một con heo rừng con đấy. Người ta cũng hay gọi chúng là uribou nữa.
Dialogue: 0,0:15:13.39,0:15:14.01,Default-alt,Bot,0,0,0,,Éc?
Dialogue: 0,0:15:15.47,0:15:17.35,Default,Oka,0,0,0,,Nó đến để đón cậu đấy à?
Dialogue: 0,0:15:17.35,0:15:18.06,Default,Kyo,0,0,0,,Tôi nghĩ là vậy.
Dialogue: 0,0:15:18.52,0:15:19.27,Default,Kyo,0,0,0,,Tên của em nó là Botan.
Dialogue: 0,0:15:18.81,0:15:19.23,Default-alt,Bot,0,0,0,,Éc.
Dialogue: 0,0:15:19.60,0:15:21.02,Default,Kyo,0,0,0,,Một cái tên thật dễ thương đúng không?
Dialogue: 0,0:15:21.02,0:15:22.81,Default,Oka,0,0,0,,Nghe có vẻ ngon lành cành đào gớm nhỉ.
Dialogue: 0,0:15:22.81,0:15:24.48,Default,Kyo,0,0,0,,Hửm? Cậu vừa nói cái gì đấy?
Dialogue: 0,0:15:24.48,0:15:25.57,Default,Oka,0,0,0,,Có gì đâu.
Dialogue: 0,0:15:25.57,0:15:27.73,Default,Kyo,0,0,0,,Nào Botan, chào mọi người đi em.
Dialogue: 0,0:15:28.07,0:15:29.44,Default,Kyo,0,0,0,,Bạn mới của em đấy.
Dialogue: 0,0:15:29.90,0:15:31.11,Default,Bot,0,0,0,,Éc! Éc!
Dialogue: 0,0:15:34.82,0:15:36.70,Default,Nag,0,0,0,,Tập dượt cho buổi giới thiệu câu lạc bộ sao?
Dialogue: 0,0:15:36.70,0:15:40.87,Default,Oka,0,0,0,,Ừ. Tôi đoán là cậu vốn không giỏi\Nđối phó với mấy chuyện như thế đúng không?
Dialogue: 0,0:15:41.29,0:15:44.71,Default,Oka,0,0,0,,Tôi nghĩ chúng ta có thể tìm tài liệu tham khảo\Nvề cách diễn thuyết và thuyết trình trước đám đông.
Dialogue: 0,0:15:45.29,0:15:46.71,Default,Nag,0,0,0,,Liệu ở đây có tìm thấy không cậu?
Dialogue: 0,0:15:47.34,0:15:48.55,Default,Yuk,0,0,0,,Chào mừng hai bạn.
Dialogue: 0,0:15:50.55,0:15:52.26,Default,Yuk,0,0,0,,Hôm nay tớ có thể giúp gì cho hai bạn không?
Dialogue: 0,0:15:53.43,0:15:55.97,Default,Yuk,0,0,0,,Hay là để tớ pha thứ gì đó cho hai bạn dùng nhé?
Dialogue: 0,0:15:55.97,0:15:57.39,Default,Oka,0,0,0,,Thế thì, cho tôi một tách cà phê nóng nhé.
Dialogue: 0,0:15:57.39,0:15:59.18,Default,Nag,0,0,0,,O-Okazaki-san à!
Dialogue: 0,0:15:59.18,0:16:00.52,Default,Yuk,0,0,0,,Tớ sẽ chuẩn bị ngay đây ạ.
Dialogue: 0,0:16:00.81,0:16:02.14,Default,Yuk,0,0,0,,Hai bạn cứ ngồi xuống ghế đợi một lát nhé.
Dialogue: 0,0:16:06.52,0:16:07.44,Default,Yuk,0,0,0,,Mời hai bạn dùng.
Dialogue: 0,0:16:08.27,0:16:09.57,Default,Nag,0,0,0,,Cảm ơn bạn rất nhiều.
Dialogue: 0,0:16:13.66,0:16:14.32,Default,Oka,0,0,0,,Ngon đấy.
Dialogue: 0,0:16:14.32,0:16:15.28,Default,Yuk,0,0,0,,Nghe bạn khen vậy tớ vui lắm.
Dialogue: 0,0:16:17.28,0:16:19.16,Default,Yuk,0,0,0,,Tên của tớ là Miyazawa Yukine.
Dialogue: 0,0:16:20.04,0:16:24.00,Note,Yuk,0,0,0,,{\fad(1100,0)\3c&H8E8E8E&\frz143.076\pos(590,651)}Nhập môn diễn thuyết
Dialogue: 0,0:16:20.04,0:16:24.00,Signs,Yuk,0,0,0,,{\fad(1100,0)\fs40\c&H1E1E1E&\pos(1444,732)\frz20.986}Bí quyết thu phục lòng người khi diễn thuyết
Dialogue: 0,0:16:20.70,0:16:24.00,Default,Yuk,0,0,0,,Hóa ra hai bạn là Okazaki Tomoya-san và Furukawa Nagisa-san.
Dialogue: 0,0:16:24.54,0:16:27.00,Default,Yuk,0,0,0,,Đây là lần đầu tiên hai bạn ghé qua đây đúng không?
Dialogue: 0,0:16:27.42,0:16:29.25,Default,Nag,0,0,0,,Vâng, rất vui được làm quen với bạn.
Dialogue: 0,0:16:29.25,0:16:31.05,Default,Oka,0,0,0,,Cậu là người quản lý ở đây à?
Dialogue: 0,0:16:31.46,0:16:33.13,Default,Yuk,0,0,0,,Tớ tự coi mình là như vậy đấy.
Dialogue: 0,0:16:33.59,0:16:35.34,Default,Yuk,0,0,0,,Tớ thực sự rất yêu thích nơi này.
Dialogue: 0,0:16:35.34,0:16:38.05,Default,Nag,0,0,0,,Nơi này trước kia từng là thư viện đúng không bạn?
Dialogue: 0,0:16:38.35,0:16:39.68,Default,Yuk,0,0,0,,Bây giờ vẫn là thư viện đấy chứ.
Dialogue: 0,0:16:40.10,0:16:43.64,Default,Yuk,0,0,0,,Tất cả những cuốn sách ít khi được người ta tìm đọc đều được gom về đây.
Dialogue: 0,0:16:44.06,0:16:46.48,Default,Yuk,0,0,0,,Nó giống như một thư viện thứ hai vậy.
Dialogue: 0,0:16:47.15,0:16:50.15,Default,Yuk,0,0,0,,Còn có cả những cuộn băng hình và đĩa than cũ kỹ nữa cơ.
Dialogue: 0,0:16:50.53,0:16:54.53,Default,Oka,0,0,0,,Phù. Tôi cứ tưởng nơi này biến thành quán cà phê sau lưng tôi từ lúc nào rồi chứ.
Dialogue: 0,0:16:54.90,0:16:58.28,Default,Yuk,0,0,0,,Thỉnh thoảng lại có nhiều vị khách đặc biệt ghé qua đây lắm.
Dialogue: 0,0:16:59.99,0:17:01.24,Default,Yuk,0,0,0,,Có chuyện gì sao bạn?
Dialogue: 0,0:17:01.70,0:17:06.04,Default,Oka,0,0,0,,Không, tôi chỉ đang nghĩ ngôi trường này có lắm người độc lạ thật đấy.
Dialogue: 0,0:17:07.88,0:17:10.29,Default,Oka,0,0,0,,Hoặc có lẽ, chính là cái thị trấn này.
Dialogue: 0,0:17:12.51,0:17:16.55,Default,Oka,0,0,0,,Hãy nói như thể tôi chỉ là một vị khách đến tham quan thôi.
Dialogue: 0,0:17:16.97,0:17:18.85,Default,Oka,0,0,0,,Bình tĩnh lại rồi nói to rõ ràng lên xem nào.
Dialogue: 0,0:17:19.47,0:17:20.30,Default,Nag,0,0,0,,Vâng!
Dialogue: 0,0:17:20.30,0:17:23.93,Default,Nag,0,0,0,,Ừm, em là Furukawa Nagisa học Lớp 3-B.
Dialogue: 0,0:17:23.93,0:17:27.44,Default,Nag,0,0,0,,Cảm ơn mọi người rất nhiều vì đã đến tham dự ngày hôm nay.
Dialogue: 0,0:17:28.10,0:17:29.27,Default,Nag,0,0,0,,Ơ… Ơ…
Dialogue: 0,0:17:29.27,0:17:30.77,Default,Oka,0,0,0,,Cố lên chứ! Tiếp theo là gì nào?
Dialogue: 0,0:17:31.36,0:17:34.99,Default,Nag,0,0,0,,Lý do em quyết định khôi phục lại câu lạc bộ kịch là…
Dialogue: 0,0:17:37.70,0:17:41.20,Default,Oka,0,0,0,,Tôi ngạc nhiên khi thấy cậu nhút nhát thế mà lại muốn đi diễn kịch đấy.
Dialogue: 0,0:17:41.20,0:17:43.75,Default,Oka,0,0,0,,Mà này, cậu đã từng có chút kinh nghiệm diễn xuất nào chưa?
Dialogue: 0,0:17:43.75,0:17:45.87,Default,Nag,0,0,0,,Chưa ạ. Em hoàn toàn là một kẻ nghiệp dư.
Dialogue: 0,0:17:46.29,0:17:48.71,Default,Nag,0,0,0,,Em chẳng biết chút ngóc ngách nào đằng sau hậu trường cả.
Dialogue: 0,0:17:51.29,0:17:53.46,Default,Oka,0,0,0,,Và chủ nhiệm câu lạc bộ đã phơi bày sự thật phũ phàng.
Dialogue: 0,0:17:54.71,0:17:55.92,Default,Oka,0,0,0,,Câu hỏi tiếp theo!
Dialogue: 0,0:17:55.92,0:17:58.26,Default,Oka,0,0,0,,Chúng ta sẽ diễn vở kịch thuộc thể loại gì?
Dialogue: 0,0:17:58.26,0:18:00.05,Default,Nag,0,0,0,,Thuộc thể loại gì cơ ạ…
Dialogue: 0,0:18:00.72,0:18:04.39,Default,Oka,0,0,0,,Có rất nhiều thể loại, từ nhạc kịch cho đến kịch thiếu nhi.
Dialogue: 0,0:18:04.39,0:18:06.56,Default,Oka,0,0,0,,Từ những vở hiện thực đời thường cho đến những vở siêu thực kỳ ảo.
Dialogue: 0,0:18:06.93,0:18:08.02,Default,Nag,0,0,0,,Thật thế sao cậu?
Dialogue: 0,0:18:08.31,0:18:09.02,Default,Oka,0,0,0,,Tôi đi về đây.
Dialogue: 0,0:18:09.65,0:18:10.77,Default,Nag,0,0,0,,Khoan đã cậu ơi.
Dialogue: 0,0:18:11.56,0:18:13.57,Default,Oka,0,0,0,,Được rồi, thế thì liệu mà trả lời cho đàng hoàng mấy câu hỏi của tôi đấy nhé.
Dialogue: 0,0:18:14.07,0:18:15.99,Default,Oka,0,0,0,,Cậu từng bảo có một vở kịch mà bản thân hằng muốn diễn cơ mà.
Dialogue: 0,0:18:15.99,0:18:16.86,Default,Oka,0,0,0,,Nó là vở kịch như thế nào?
Dialogue: 0,0:18:18.03,0:18:20.07,Default,Nag,0,0,0,,Đó là một vở kịch thực sự, thực sự rất vui vẻ.
Dialogue: 0,0:18:20.07,0:18:22.28,Default,Oka,0,0,0,,Nghe mơ hồ mông lung quá đấy.
Dialogue: 0,0:18:22.58,0:18:23.99,Default,Oka,0,0,0,,Nó là một vở hài kịch à?
Dialogue: 0,0:18:23.99,0:18:27.58,Default,Nag,0,0,0,,Không, ý em không phải là nó thuần túy hài hước chọc cười đâu ạ.
Dialogue: 0,0:18:27.58,0:18:29.75,Default,Oka,0,0,0,,Thế thì cũng có cả những khoảnh khắc lấy nước mắt người xem nữa à?
Dialogue: 0,0:18:29.75,0:18:33.54,Default,Nag,0,0,0,,Vừa có mà lại vừa không ạ…
Dialogue: 0,0:18:33.09,0:18:35.55,Default-alt,Oka,0,0,0,,Rốt cuộc là nó hài hước hay là bi thương đẫm lệ hả?
Dialogue: 0,0:18:36.09,0:18:37.42,Default,Nag,0,0,0,,N-Nó nằm ở khoảng giữa hai thứ đó ạ.
Dialogue: 0,0:18:40.68,0:18:43.68,Default,Oka,0,0,0,,Được rồi, cho cậu qua cửa. Dù sao thì cậu cũng đã cố gắng trả lời.
Dialogue: 0,0:18:45.72,0:18:47.39,Default,Nag,0,0,0,,Xin mời câu hỏi tiếp theo ạ!
Dialogue: 0,0:18:47.89,0:18:49.98,Default,Oka,0,0,0,,Bức hình vẽ trên tờ rơi là cái thứ gì thế?
Dialogue: 0,0:18:49.98,0:18:51.69,Default,Nag,0,0,0,,Là Đại Gia Đình Dango đấy ạ!
Dialogue: 0,0:18:51.69,0:18:52.90,Default,Oka,0,0,0,,Trả lời dứt khoát không chút do dự luôn.
Dialogue: 0,0:18:52.90,0:18:56.86,Default,Nag,0,0,0,,Đó là những nhân vật danh tiếng lẫy lừng toàn quốc\Nmà bất kỳ người dân Nhật Bản nào cũng đều biết đến.
Dialogue: 0,0:18:56.86,0:18:58.61,Default,Nag,0,0,0,,Chính là Đại Gia Đình Dango thân thương.
Dialogue: 0,0:18:58.61,0:19:02.45,Default,Nag,0,0,0,,Em ghen tị vô cùng khi gia đình họ có tận một trăm thành viên. Nghe thôi đã thấy lúc nào cũng ngập tràn niềm vui rồi.
Dialogue: 0,0:19:02.78,0:19:07.16,Default,Nag,0,0,0,,Em nghĩ sẽ rắc rối to nếu cả một trăm người cùng kéo nhau đi công viên giải trí một lúc đấy.
Dialogue: 0,0:19:07.50,0:19:08.41,Default,Nag,0,0,0,,Thế nhưng họ là—
Dialogue: 0,0:19:08.04,0:19:09.50,Default-alt,Oka,0,0,0,,DỪNG LẠI!
Dialogue: 0,0:19:10.21,0:19:13.08,Default,Oka,0,0,0,,Đừng có đột nhiên nói năng lưu loát trôi chảy bất thường như thế chứ!
Dialogue: 0,0:19:13.08,0:19:15.21,Default,Oka,0,0,0,,Khoảng cách nhiệt huyết quá chênh lệch đó sẽ dọa người ta chạy mất dép đấy!
Dialogue: 0,0:19:15.21,0:19:16.30,Default,Nag,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:19:17.05,0:19:19.80,Default,Oka,0,0,0,,Thì, có thái độ tích cực cũng chẳng phải điều gì xấu.
Dialogue: 0,0:19:19.80,0:19:24.43,Default,Oka,0,0,0,,Nhưng tôi chẳng chắc việc cậu hào hứng sôi nổi gấp bội\Nkhi thuyết minh về Đại Gia Đình Dango là ý hay đâu.
Dialogue: 0,0:19:24.43,0:19:29.64,Default,Nag,0,0,0,,Cậu nói đúng. Làm thế thì hóa ra biến thành\Nbuổi giới thiệu về Đại Gia Đình Dango mất rồi.
Dialogue: 0,0:19:29.64,0:19:31.14,Default,Oka,0,0,0,,Xem chừng chúng ta còn cả một núi chông gai phía trước cần phải phá bỏ đấy.
Dialogue: 0,0:19:31.14,0:19:32.73,Default,Nag,0,0,0,,Em cũng nghĩ như vậy ạ.
Dialogue: 0,0:19:34.15,0:19:37.53,Default,Oka,0,0,0,,Trước hết và quan trọng nhất, tại sao cậu lại muốn diễn kịch?
Dialogue: 0,0:19:38.23,0:19:39.44,Default,Oka,0,0,0,,Cậu hoàn toàn không có kinh nghiệm gì cơ mà, đúng không?
Dialogue: 0,0:19:40.49,0:19:41.95,Default,Nag,0,0,0,,Bởi vì em yêu thích nó.
Dialogue: 0,0:19:41.95,0:19:42.95,Default,Oka,0,0,0,,Cậu thích điểm gì ở nó chứ?
Dialogue: 0,0:19:43.49,0:19:47.12,Default,Nag,0,0,0,,Em cảm thấy sẽ vui biết bao nếu được cùng mọi người đứng trên sân khấu diễn xuất.
Dialogue: 0,0:19:47.54,0:19:53.75,Default,Nag,0,0,0,,Kể từ khi còn nhỏ, em chưa từng được tham gia vào các buổi biểu diễn văn nghệ của trường lớp, bởi cứ vào những ngày đó là em lại lăn ra ốm.
Dialogue: 0,0:19:54.25,0:19:58.13,Default,Nag,0,0,0,,Em thường xuyên phải nghỉ học vì đau ốm,\Nnên em cũng chẳng thể tham gia tập luyện cùng bạn bè được.
Dialogue: 0,0:19:58.75,0:20:02.63,Default,Nag,0,0,0,,Chính vì thế, em luôn khao khát mãnh liệt được một lần diễn xuất kề vai sát cánh bên cạnh bạn bè.
Dialogue: 0,0:20:03.05,0:20:06.55,Default,Nag,0,0,0,,Em đã ấp ủ một ước mơ cháy bỏng là được gia nhập câu lạc bộ kịch khi bước chân vào cấp ba.
Dialogue: 0,0:20:06.97,0:20:09.22,Default,Nag,0,0,0,,Và cũng muốn cống hiến hết sức mình cho kịch nghệ trong suốt ba năm thanh xuân đó.
Dialogue: 0,0:20:10.77,0:20:15.15,Default,Nag,0,0,0,,Thế nhưng em lại chẳng thể đi học đều đặn, ngay cả khi đã lên cấp ba…
Dialogue: 0,0:20:15.81,0:20:18.86,Default,Nag,0,0,0,,Năm cuối cấp này em cũng phải nghỉ học suốt một thời gian dài…
Dialogue: 0,0:20:20.48,0:20:23.07,Default,Nag,0,0,0,,Dẫu vậy, em vẫn tha thiết muốn được thử sức thêm một lần nữa.
Dialogue: 0,0:20:23.74,0:20:29.87,Default,Nag,0,0,0,,Em chẳng am hiểu điều gì, và có thể mọi chuyện sẽ dở tệ hết chỗ nói,
Dialogue: 0,0:20:29.87,0:20:32.41,Default,Nag,0,0,0,,thế nhưng em muốn dốc hết toàn lực của bản thân nhiều nhất có thể.
Dialogue: 0,0:20:32.96,0:20:35.96,Default,Nag,0,0,0,,Cùng chung tay nỗ lực vì một mục tiêu chung như một tập thể.
Dialogue: 0,0:20:36.83,0:20:39.30,Default,Nag,0,0,0,,Em nghĩ đó là một điều vô cùng tuyệt vời.
Dialogue: 0,0:20:39.71,0:20:41.67,Default,Nag,0,0,0,,Những điều như thế, em chỉ đơn giản là…
Dialogue: 0,0:20:46.39,0:20:47.93,Default,Nag,0,0,0,,…yêu thích chúng vô cùng.
Dialogue: 0,0:20:51.14,0:20:52.48,Default,Oka,0,0,0,,Tôi nghĩ như thế là quá đủ rồi đấy.
Dialogue: 0,0:20:52.48,0:20:53.23,Default,Nag,0,0,0,,Dạ?
Dialogue: 0,0:20:53.64,0:20:56.23,Default,Oka,0,0,0,,Tôi nghĩ cậu cứ nói y nguyên những lời đó trong buổi giới thiệu câu lạc bộ đi.
Dialogue: 0,0:20:56.43,0:20:57.59,Default,Oka,0,0,0,,Nói sao nhỉ…
Dialogue: 0,0:20:57.57,0:21:00.48,Default,Oka,0,0,0,,Tôi cảm thấy cậu đã có thể nói ra\Ntất cả những gì chất chứa tận đáy lòng mình rồi đấy.
Dialogue: 0,0:21:00.86,0:21:01.98,Default,Nag,0,0,0,,Thật sao cậu?
Dialogue: 0,0:21:01.98,0:21:04.11,Default,Oka,0,0,0,,Tôi thường hay nghĩ sao nói vậy mà.
Dialogue: 0,0:21:04.53,0:21:05.45,Default,Nag,0,0,0,,Vâng, đúng là cậu hay nói thẳng thật.
Dialogue: 0,0:21:06.20,0:21:07.91,Default,Nag,0,0,0,,Đôi lúc nghe cũng thấy nhói lòng lắm.
Dialogue: 0,0:21:07.91,0:21:10.16,Default,Oka,0,0,0,,Nên là hãy tin tưởng vào những lời nói của chính bản thân mình đi.
Dialogue: 0,0:21:11.54,0:21:11.99,Default,Nag,0,0,0,,Vâng…
Dialogue: 0,0:21:12.62,0:21:14.37,Default,Oka,0,0,0,,Cố lên nhé, Furukawa Nagisa.
Dialogue: 0,0:21:16.54,0:21:17.00,Default,Nag,0,0,0,,Vâng!
Dialogue: 0,0:21:19.38,0:21:22.84,Default,Nag,0,0,0,,Liệu có ai đến tham gia buổi giới thiệu không cậu nhỉ?
Dialogue: 0,0:21:22.84,0:21:25.30,Default,Nag,0,0,0,,Chưa tới ngày đó thì làm sao biết trước được.
Dialogue: 0,0:21:25.30,0:21:29.47,Default,Nag,0,0,0,,Thế nhưng chúng mình đã dán nhiều tờ rơi đến thế cơ mà,\Nchỉ cần có hai hoặc ba bạn xuất hiện thôi là—
Dialogue: 0,0:21:31.68,0:21:33.35,Default,Oka,0,0,0,,Chúng ta từng dán một tờ rơi ở chỗ này đúng không?
Dialogue: 0,0:21:34.23,0:21:35.35,Default,Nag,0,0,0,,Vâng, tớ dám chắc là có mà.
Dialogue: 0,0:21:36.64,0:21:42.02,Default,Yuk,0,0,0,,Nếu là tờ rơi dán ở đó,\Nthì tớ thấy có người bên hội học sinh gỡ xuống rồi đấy.
Dialogue: 0,0:21:42.02,0:21:44.11,Default,Nag,0,0,0,,Gỡ xuống sao? Tại sao chứ?
Dialogue: 0,0:21:44.11,0:21:47.07,Default,Yuk,0,0,0,,Chắc là vì các bạn chưa xin phép họ trước đấy.
Dialogue: 0,0:21:47.07,0:21:50.03,Default,Yuk,0,0,0,,Hai bạn là người đã dán đống tờ rơi đó à?
Dialogue: 0,0:21:50.62,0:21:53.45,Default,Oka,0,0,0,,Thế thì tất cả những tờ khác dán quanh trường cũng bị…
Dialogue: 0,0:21:53.83,0:21:56.12,Default,PA,0,0,0,,Học sinh Furukawa Nagisa của Lớp 3-B.
Dialogue: 0,0:21:56.54,0:21:58.96,Default,PA,0,0,0,,Xin mời có mặt tại phòng hội học sinh ngay lập tức.
Dialogue: 0,0:21:59.63,0:22:00.42,Default,PA,0,0,0,,Xin nhắc lại.
Dialogue: 0,0:22:01.13,0:22:03.71,Default,PA,0,0,0,,Học sinh Furukawa Nagisa của Lớp 3-B.
Dialogue: 0,0:22:03.30,0:22:04.34,Default-alt,Oka,0,0,0,,Furukawa…
Dialogue: 0,0:22:04.34,0:22:06.55,Default,PA,0,0,0,,Xin mời có mặt tại phòng hội học sinh ngay lập tức.
