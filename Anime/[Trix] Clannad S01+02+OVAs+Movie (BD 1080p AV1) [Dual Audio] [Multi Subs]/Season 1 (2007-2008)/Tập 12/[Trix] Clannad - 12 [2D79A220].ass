Dialogue: 0,0:02:47.39,0:02:59.82,OP English,,0,0,0,,{\fad(250,250)\be1}Không giữ lại cho riêng mình dẫu chỉ một chút thôi.
Dialogue: 0,0:03:06.29,0:03:11.75,Default,Nag,0,0,0,,Nghe nói Kotomi-chan đã chịu vào lớp học thay vì cứ trốn trong thư viện rồi đấy.
Dialogue: 0,0:03:11.75,0:03:13.79,Default,Oka,0,0,0,,Bọn mình cùng đi lén xem thử đi.
Dialogue: 0,0:03:14.38,0:03:17.75,Default,Girl,0,0,0,,Này Ichinose-san, bài toán thứ ba ở đây...
Dialogue: 0,0:03:17.75,0:03:23.80,Default,Kot,0,0,0,,Đầu tiên bạn đặt x = cos θ, rồi sau đó chỗ này sẽ biến đổi thành như thế này.
Dialogue: 0,0:03:23.80,0:03:26.47,Default,Kot,0,0,0,,Vậy nên đáp án sẽ là π/9.
Dialogue: 0,0:03:26.47,0:03:28.22,Default,Girl,0,0,0,,Mình hiểu rồi! Cảm ơn bạn nhiều nhé!
Dialogue: 0,0:03:28.22,0:03:30.39,Default,Girl,0,0,0,,Ichinose-san thông minh thực sự luôn đấy.
Dialogue: 0,0:03:30.39,0:03:34.94,Default,Girl,0,0,0,,À đúng rồi. Bạn là người đã biểu diễn buổi hòa nhạc vĩ cầm hôm nọ đúng không?
Dialogue: 0,0:03:34.94,0:03:38.03,Default,Girl,0,0,0,,Hả? Ichinose-san biết chơi cả vĩ cầm nữa cơ á?
Dialogue: 0,0:03:38.03,0:03:40.36,Default,Girl,0,0,0,,Lẽ ra bạn phải báo cho tụi mình một tiếng để bọn mình đến cổ vũ chứ.
Dialogue: 0,0:03:40.94,0:03:45.45,Default,Girl,0,0,0,,Tớ có đi ngang qua đấy, nhưng mà thứ đó không thể gọi là "chơi đàn" được đâu.
Dialogue: 0,0:03:45.87,0:03:47.12,Default,Girl,0,0,0,,Ý cậu thế là sao hả?
Dialogue: 0,0:03:47.12,0:03:50.41,Default,Girl,0,0,0,,Nó làm tớ sợ chết khiếp lùi lại luôn đấy.
Dialogue: 0,0:03:47.87,0:03:50.41,Default-alt,Kot,0,0,0,,Ngại ngùng thật đấy.
Dialogue: 0,0:03:52.50,0:03:56.17,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2ord2\pos(960,410)\3c&H4A8A5C&}Tập 12
Dialogue: 0,0:03:52.50,0:03:56.17,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2ord2\3c&H4A8A5C&\pos(960,720)}Thế Giới Bị Che Giấu
Dialogue: 0,0:03:56.17,0:03:58.92,Default,Kyo,0,0,0,,Ngây thơ! Các người ngây thơ quá rồi!
Dialogue: 0,0:03:58.92,0:04:02.38,Default,Kyo,0,0,0,,Một thế giới chỉ toàn những kẻ chuyên bẻ miếng nghĩa là chẳng có lấy một ai đóng vai ngô nghê.
Dialogue: 0,0:04:02.38,0:04:07.80,Default,Kyo,0,0,0,,Thế nên từ đây cho đến tận chân trời sẽ chỉ toàn những kẻ thắt nơ bướm chực chờ bẻ miếng.
Dialogue: 0,0:04:07.80,0:04:11.23,Default,Kyo,0,0,0,,Thử quên một câu thoại hay buông một câu\Nvớ vẩn trong tình cảnh đó xem.
Dialogue: 0,0:04:11.23,0:04:12.60,Default,Kyo,0,0,0,,Cậu nghĩ chuyện gì sẽ xảy ra hả?
Dialogue: 0,0:04:13.94,0:04:14.77,Default,Kot,0,0,0,,Chuyện gì sẽ xảy ra vậy?
Dialogue: 0,0:04:14.77,0:04:16.40,Default,Kyo,0,0,0,,"Cái quái gì thế hả?!"
Dialogue: 0,0:04:16.40,0:04:17.94,Default,Kyo,0,0,0,,"Cậu bị ngốc à?!"
Dialogue: 0,0:04:17.94,0:04:20.11,Default,Kyo,0,0,0,,"Nói thế là quá đủ rồi đấy nhé!"
Dialogue: 0,0:04:19.19,0:04:20.11,Default-alt,Oka,0,0,0,,"Cái gì cơ?"
Dialogue: 0,0:04:20.11,0:04:21.78,Default,Kyo,0,0,0,,"Tôi chịu hết nổi cậu rồi!"
Dialogue: 0,0:04:21.78,0:04:23.53,Default,Kyo,0,0,0,,"Chuyện quái quỷ gì thế này?!"
Dialogue: 0,0:04:25.03,0:04:28.58,Default,Kyo,0,0,0,,Cậu sẽ bị tát liên hoàn tới tấp vào mặt cho mà xem.
Dialogue: 0,0:04:28.58,0:04:31.20,Default,Kyo,0,0,0,,Đó sẽ là một thế giới cực kỳ, cực kỳ khắc nghiệt đấy.
Dialogue: 0,0:04:31.54,0:04:34.41,Default,Kot,0,0,0,,Bẻ miếng đáng sợ ghê.
Dialogue: 0,0:04:34.41,0:04:35.54,Default,Kyo,0,0,0,,Dù sao đi nữa,
Dialogue: 0,0:04:35.54,0:04:39.59,Default,Kyo,0,0,0,,dù cậu có đầu thai một triệu kiếp nữa thì cũng đừng hòng bước chân vào giới tấu hài.
Dialogue: 0,0:04:39.59,0:04:42.46,Default,Ryo,0,0,0,,C-Chị hai. Em nghĩ chị nói thế là hơi nặng lời quá rồi đấy.
Dialogue: 0,0:04:42.46,0:04:45.59,Default,Nag,0,0,0,,Vâng. Nếu tất cả chúng ta cùng chung tay cố gắng, tớ chắc chắn—
Dialogue: 0,0:04:45.59,0:04:48.43,Default,Kyo,0,0,0,,Cả ba người các cậu có hợp lại thì cũng vô tích sự thôi.
Dialogue: 0,0:04:48.43,0:04:50.68,Default,Kyo,0,0,0,,Số không thì mãi mãi vẫn là số không\Ndù có gom bao nhiêu số không lại đi chăng nữa.
Dialogue: 0,0:04:50.68,0:04:52.56,Default,Oka,0,0,0,,Cậu ấy nói phũ phàng thật đấy.
Dialogue: 0,0:04:54.23,0:04:57.06,Default,Kot,0,0,0,,Thế thì mình buộc phải tung ra tuyệt chiêu cuối cùng thôi.
Dialogue: 0,0:04:57.06,0:04:59.69,Default,Kot,0,0,0,,Mình sẽ cho mọi người xem một trò đùa siêu đỉnh cao!
Dialogue: 0,0:04:59.69,0:05:03.07,Default,Kyo,0,0,0,,Hy vọng không phải là trò gì đó cổ lỗ sĩ từ đời nảo đời nào nữa.
Dialogue: 0,0:05:03.82,0:05:06.91,Default,Kot,0,0,0,,Đây là trò mình vừa học được trên ti-vi hôm nọ đấy.
Dialogue: 0,0:05:06.91,0:05:08.53,Default,Kot,0,0,0,,Mới toanh luôn.
Dialogue: 0,0:05:10.53,0:05:11.83,Default,Kot,0,0,0,,Mình làm đây.
Dialogue: 0,0:05:16.75,0:05:18.71,Default,Kot,0,0,0,,Chỗ này gập lại được này.
Dialogue: 0,0:05:23.26,0:05:23.96,Default,Kyo,0,0,0,,Đó mà là trò đùa đấy à?
Dialogue: 0,0:05:24.34,0:05:25.30,Default,Oka,0,0,0,,Đừng có hỏi tôi.
Dialogue: 0,0:05:26.01,0:05:28.26,Default,Kot,0,0,0,,Tháo ra được luôn này.
Dialogue: 0,0:05:28.80,0:05:30.22,Default,Kyo,0,0,0,,Cái đó tính là trò đùa thật sao trời?
Dialogue: 0,0:05:30.22,0:05:31.18,Default,Oka,0,0,0,,Đừng khóc mà cậu.
Dialogue: 0,0:05:33.35,0:05:35.39,Default,Oka,0,0,0,,Cậu làm nhiều đồ ăn ghê!
Dialogue: 0,0:05:35.39,0:05:37.85,Default,Kot,0,0,0,,Tớ muốn tất cả mọi người đều được thưởng thức mà.
Dialogue: 0,0:05:37.85,0:05:42.23,Default,Ryo,0,0,0,,Kotomi-chan, những ngày không phải đến trường cậu thường làm gì thế?
Dialogue: 0,0:05:42.23,0:05:44.36,Default,Kot,0,0,0,,Mình thường hay đọc sách.
Dialogue: 0,0:05:44.78,0:05:48.28,Default,Oka,0,0,0,,Tôi thì toàn giết thời gian bên phòng trọ của Sunohara.
Dialogue: 0,0:05:48.28,0:05:51.03,Default,Nag,0,0,0,,Tớ nghĩ chắc tớ cũng chỉ quanh quẩn ở nhà thôi.
Dialogue: 0,0:05:51.03,0:05:52.74,Default,Kyo,0,0,0,,Mấy người các cậu thật là thảm hại mà.
Dialogue: 0,0:05:52.74,0:05:59.00,Default,Kyo,0,0,0,,Đám thanh niên đang ở độ tuổi xuân thì rực rỡ nhất lại đi phung phí cả thời gian lẫn thể xác thế à.
Dialogue: 0,0:05:59.00,0:06:01.25,Default,Oka,0,0,0,,Thế cậu có việc gì để làm chắc?
Dialogue: 0,0:06:01.25,0:06:02.09,Default,Kyo,0,0,0,,Không, tôi chẳng có việc gì cả.
Dialogue: 0,0:06:02.09,0:06:03.13,Default,Oka,0,0,0,,Biết ngay mà.
Dialogue: 0,0:06:03.13,0:06:05.51,Default,Kyo,0,0,0,,Nhưng tôi vừa lên kế hoạch xong rồi đây.
Dialogue: 0,0:06:05.51,0:06:08.51,Default,Kyo,0,0,0,,Mọi người. Chín giờ sáng mai tập trung ở nhà ga nhé.
Dialogue: 0,0:06:09.93,0:06:11.18,Default,Kyo,0,0,0,,Hẹn hò nhóm.
Dialogue: 0,0:06:11.18,0:06:12.68,Default,Kyo,0,0,0,,Đi chơi nhóm.
Dialogue: 0,0:06:12.68,0:06:16.27,Default,Kyo,0,0,0,,Đây mới chính là điều mà những người trẻ tuổi trong sáng nên làm.
Dialogue: 0,0:06:25.07,0:06:27.44,Default,Oka,0,0,0,,Tôi là thằng con trai duy nhất đấy à?
Dialogue: 0,0:06:27.44,0:06:30.20,Default,Oka,0,0,0,,Nếu rủ Sunohara, tao cá là nó sẽ\Nvẫy đuôi hớn hở chạy sang ngay cho mà xem.
Dialogue: 0,0:06:30.20,0:06:31.41,Default,Kyo,0,0,0,,Bác bỏ.
Dialogue: 0,0:06:31.41,0:06:33.33,Default,Kyo,0,0,0,,Một nhóm có một thằng ngốc là đủ rồi.
Dialogue: 0,0:06:33.33,0:06:35.54,Default,Oka,0,0,0,,Thằng ngốc đó là cậu đấy à?
Dialogue: 0,0:06:36.66,0:06:39.75,Default,Kyo,0,0,0,,Thôi đi bà tướng! Đương nhiên là cậu rồi.
Dialogue: 0,0:06:39.75,0:06:42.71,Default,Oka,0,0,0,,Này, cậu cũng suýt soát ngang ngửa trong cuộc đua đó đấy nhé.
Dialogue: 0,0:06:43.21,0:06:47.17,Default,Ryo,0,0,0,,Chị hai. Kotomi-chan bảo sắp đến sinh nhật bạn ấy rồi kìa.
Dialogue: 0,0:06:47.17,0:06:49.84,Default,Kot,0,0,0,,Ừm. Thứ Bảy tuần sau đấy.
Dialogue: 0,0:06:49.84,0:06:53.35,Default,Kyo,0,0,0,,Được rồi! Bọn tôi sẽ tặng cậu một món quà chứa chan tất cả tấm lòng!
Dialogue: 0,0:07:04.86,0:07:05.69,Default,Oka,0,0,0,,Không thể nào lấy được đâu.
Dialogue: 0,0:07:06.86,0:07:08.53,Default,Kyo,0,0,0,,Lại chẳng nhúc nhích tí nào nữa rồi!
Dialogue: 0,0:07:08.53,0:07:11.49,Default,Kyo,0,0,0,,Này nhân viên kia! Vị trí đặt giải thưởng bị sai rồi kìa!
Dialogue: 0,0:07:11.49,0:07:13.07,Default,Kyo,0,0,0,,Để thế kia thì ai mà gắp cho nổi hả?!
Dialogue: 0,0:07:13.07,0:07:14.74,Default,Staff,0,0,0,,Lại nữa à?
Dialogue: 0,0:07:14.74,0:07:16.83,Default,Staff,0,0,0,,Tha cho tôi đi được không?
Dialogue: 0,0:07:15.16,0:07:16.83,Default-alt,Guy,0,0,0,,Nhỏ vẫn còn hăng máu lắm.
Dialogue: 0,0:07:16.83,0:07:19.66,Default,Oka,0,0,0,,Đây là món quà chứa chan tấm lòng của cậu đấy à?
Dialogue: 0,0:07:20.21,0:07:23.38,Default,Ryo,0,0,0,,Con búp bê đó to thật đấy.
Dialogue: 0,0:07:23.75,0:07:27.92,Default,Nag,0,0,0,,Làm búp bê to hơn cả con vật ngoài đời thực thế kia liệu có ổn không nhỉ?
Dialogue: 0,0:07:27.92,0:07:29.42,Default,Staff,0,0,0,,Của cậu đây.
Dialogue: 0,0:07:29.42,0:07:31.01,Default,Kyo,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:07:31.01,0:07:34.64,Default,Kyo,0,0,0,,Lần thử thứ ba mươi tư của tôi đây.
Dialogue: 0,0:07:34.64,0:07:38.43,Default,Oka,0,0,0,,Nói cho biết trước, đây là lượt cuối cùng của cậu đấy. Tôi cháy túi sạch tiền rồi.
Dialogue: 0,0:07:38.93,0:07:40.23,Default,Kyo,0,0,0,,Lượt tiếp theo của em đấy, Ryou.
Dialogue: 0,0:07:40.23,0:07:42.56,Default,Ryo,0,0,0,,E-Em chẳng có chút tự tin nào cả.
Dialogue: 0,0:07:42.56,0:07:44.27,Default,Ryo,0,0,0,,Lần trước em cũng gắp trượt rồi.
Dialogue: 0,0:07:44.27,0:07:45.61,Default,Kyo,0,0,0,,Nếu vậy thì mời Chủ nhiệm.
Dialogue: 0,0:07:46.06,0:07:51.40,Default,Nas,0,0,0,,Tớ cũng vậy. Tớ thấy mình sẽ làm lãng phí tiền của Okazaki-san mất.
Dialogue: 0,0:07:51.40,0:07:52.11,Default-alt,Oka,0,0,0,,Thế thì để mình—
Dialogue: 0,0:07:51.70,0:07:53.16,Default,Kyo,0,0,0,,Một lũ vô dụng bất tài!
Dialogue: 0,0:07:53.16,0:07:56.74,Default,Kyo,0,0,0,,Không có ai đủ tự tin để tuyên bố mình sẽ gắp được nó sao?!
Dialogue: 0,0:07:59.87,0:08:02.00,Default,Fuk,0,0,0,,Fuko xuất hiện rồi đây!
Dialogue: 0,0:08:07.71,0:08:09.88,Default,Kyo,0,0,0,,Nhóc là ai thế?
Dialogue: 0,0:08:09.88,0:08:14.80,Default,Fuk,0,0,0,,Fuko thấy mọi người đang gặp rắc rối gian nan,\Nnên Fuko đã chạy ngay tới đây với mong muốn được ra tay trợ giúp.
Dialogue: 0,0:08:14.80,0:08:16.89,Default,Fuk,0,0,0,,Mọi chuyện cứ để hết cho Fuko lo!
Dialogue: 0,0:08:16.89,0:08:19.97,Default,Nag,0,0,0,,Xin lỗi em, hình như bọn mình từng gặp nhau ở đâu rồi đúng không?
Dialogue: 0,0:08:19.97,0:08:22.68,Default,Fuk,0,0,0,,Bây giờ chị chưa cần nhớ ra đâu.
Dialogue: 0,0:08:22.68,0:08:25.77,Default,Fuk,0,0,0,,Rồi sẽ đến ngày chúng ta tự nhiên hội ngộ lại thôi.
Dialogue: 0,0:08:25.77,0:08:28.02,Default,Oka,0,0,0,,Nhóc gắp được thật không đấy?
Dialogue: 0,0:08:28.02,0:08:31.40,Default,Fuk,0,0,0,,Fuko là bậc thầy đại cao thủ của trò chơi này đấy nhé,
Dialogue: 0,0:08:31.40,0:08:36.07,Default,Fuk,0,0,0,,đến mức hàng xóm láng giềng đều tấm tắc khen ngợi không ai sánh bằng Fuko trong khoản điều khiển cần cẩu gắp thú.
Dialogue: 0,0:08:36.07,0:08:37.66,Default,Oka,0,0,0,,Nhóc có kiểu hàng xóm láng giềng quái quỷ gì thế hả?
Dialogue: 0,0:08:38.28,0:08:40.29,Default,Oka,0,0,0,,Mình cứ có cảm giác từng nghe đoạn hội thoại này ở đâu đó rồi thì phải.
Dialogue: 0,0:08:41.54,0:08:45.00,Default,Oka,0,0,0,,Mục tiêu là cái con to bự kia kìa. Nhóc rõ chưa?
Dialogue: 0,0:08:45.75,0:08:47.42,Default,Fuk,0,0,0,,Fuko ra chiêu đây!
Dialogue: 0,0:09:03.48,0:09:07.15,Default,Fuk,0,0,0,,Hình dáng của nó đã hớp hồn Fuko khiến tay Fuko vô thức cử động mất rồi.
Dialogue: 0,0:09:07.15,0:09:10.36,Default,Oka,0,0,0,,Nói cho nhóc biết, cái đó là ngôi sao, chứ không phải con sao biển đâu.
Dialogue: 0,0:09:10.86,0:09:16.45,Default,Fuk,0,0,0,,Lần này Fuko chưa giúp được gì, nhưng lần sau Fuko sẽ lại đến giúp đỡ mọi người tiếp nhé.
Dialogue: 0,0:09:16.45,0:09:17.36,Default,Fuk,0,0,0,,Hẹn gặp lại sau nha!
Dialogue: 0,0:09:20.62,0:09:22.29,Default,Kyo,0,0,0,,Chuyện vừa rồi là sao thế nhỉ?
Dialogue: 0,0:09:22.66,0:09:24.83,Default,Oka,0,0,0,,Sao tự nhiên tớ lại thốt ra chữ "sao biển" cơ chứ?
Dialogue: 0,0:09:25.25,0:09:26.58,Default,Nag,0,0,0,,Tớ cũng không biết nữa...
Dialogue: 0,0:09:28.46,0:09:31.46,Default,Kyo,0,0,0,,Cuối cùng thì chúng mình vẫn chưa quyết định được món quà sinh nhật.
Dialogue: 0,0:09:31.46,0:09:34.46,Default,Oka,0,0,0,,Vẫn còn thời gian mà, cứ thong thả thôi.
Dialogue: 0,0:09:36.30,0:09:37.97,Default,Ryo,0,0,0,,Một vệt khói máy bay kìa.
Dialogue: 0,0:09:37.97,0:09:39.93,Default,Nag,0,0,0,,Đẹp thật đấy.
Dialogue: 0,0:09:41.81,0:09:43.77,Default,Oka,0,0,0,,Kotomi, sao thế cậu?
Dialogue: 0,0:09:49.56,0:09:52.19,Default,Nag,0,0,0,,Nhà của tụi mình ở hướng này cơ mà.
Dialogue: 0,0:09:52.73,0:09:56.61,Default,Kot,0,0,0,,Nagisa-chan, Kyou-chan, Ryou-chan, hẹn gặp lại các cậu vào ngày mai nhé.
Dialogue: 0,0:09:56.61,0:09:59.03,Default,Ryo,0,0,0,,Vâng, chúc cậu ngủ ngon nhé.
Dialogue: 0,0:09:59.03,0:10:00.20,Default,Kyo,0,0,0,,Tạm biệt nha.
Dialogue: 0,0:10:05.12,0:10:07.04,Default,Kot,0,0,0,,Cảm ơn cậu nhiều nhé, Tomoya-kun.
Dialogue: 0,0:10:07.79,0:10:13.17,Default,Kot,0,0,0,,Nếu không gặp được cậu, mình nghĩ mình đã không có nhiều niềm vui đến thế này.
Dialogue: 0,0:10:14.09,0:10:16.05,Default,Oka,0,0,0,,Tớ đã làm được gì đâu.
Dialogue: 0,0:10:16.05,0:10:19.43,Default,Oka,0,0,0,,Nagisa, Kyou và Fujibayashi đều yêu quý cậu mà thôi.
Dialogue: 0,0:10:19.43,0:10:20.80,Default,Oka,0,0,0,,Chỉ có vậy thôi.
Dialogue: 0,0:10:21.89,0:10:24.89,Default,Kot,0,0,0,,Nếu đúng là như vậy thì mình sẽ hạnh phúc lắm.
Dialogue: 0,0:10:27.31,0:10:31.19,Default,Kot,0,0,0,,Tomoya-kun, có một thứ này mình muốn tặng cho cậu.
Dialogue: 0,0:10:33.65,0:10:35.94,Default,Kot,0,0,0,,Mình muốn cậu giữ lấy cuốn sách này.
Dialogue: 0,0:10:36.74,0:10:41.28,Default,Kot,0,0,0,,Tất cả nội dung bên trong mình đều đã thuộc lòng hết rồi.
Dialogue: 0,0:10:42.78,0:10:44.70,Default,Oka,0,0,0,,Cậu muốn tớ đọc nó à?
Dialogue: 0,0:10:47.45,0:10:50.08,Default,Kot,0,0,0,,Không, cậu không cần đọc đâu.
Dialogue: 0,0:10:50.67,0:10:52.88,Default,Kot,0,0,0,,Chỉ cần cậu giữ nó bên mình là được.
Dialogue: 0,0:10:56.17,0:10:57.09,Default,Oka,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:10:59.30,0:11:01.18,Default,Oka,0,0,0,,Ông ta là người hôm nọ.
Dialogue: 0,0:11:01.18,0:11:02.22,Default,Kot,0,0,0,,Là kẻ xấu.
Dialogue: 0,0:11:03.05,0:11:03.55,Default,Oka,0,0,0,,Này ông kia!
Dialogue: 0,0:11:15.40,0:11:16.90,Default,Oka,0,0,0,,Có vẻ ông ta đi mất rồi.
Dialogue: 0,0:11:17.57,0:11:19.19,Default,Oka,0,0,0,,Ông ta là ai thế?
Dialogue: 0,0:11:19.86,0:11:22.11,Default,Oka,0,0,0,,Ông ta có việc gì với cậu à?
Dialogue: 0,0:11:56.23,0:11:58.69,Default,Oka,0,0,0,,Dạo gần đây tớ toàn mơ thấy những giấc mơ kỳ lạ.
Dialogue: 0,0:12:02.99,0:12:04.66,Default,Kot,0,0,0,,Đoán xem ai đây nào, Tomoya-kun?
Dialogue: 0,0:12:04.66,0:12:07.20,Default,Oka,0,0,0,,Ngực cậu! Ngực cậu đang ép chặt vào lưng tớ đấy!
Dialogue: 0,0:12:07.87,0:12:10.66,Default,Kot,0,0,0,,Cô Munega đang sờ ngực (Munegasawatteru Munega-san) đấy à?
Dialogue: 0,0:12:10.66,0:12:12.62,Default,Oka,0,0,0,,Cậu là vận động viên thể dục dụng cụ người Nga hay gì thế?
Dialogue: 0,0:12:12.62,0:12:17.21,Default,Oka,0,0,0,,Cậu là Ichinose Kotomi, và ngực cậu đang áp thẳng vào lưng tôi đây này!
Dialogue: 0,0:12:20.00,0:12:22.88,Default,Kot,0,0,0,,Tim mình thực sự, thực sự đang đập thình thịch liên hồi đấy.
Dialogue: 0,0:12:22.88,0:12:25.51,Default,Oka,0,0,0,,Kẻ nào xúi cậu làm cái trò đùa ngượng chín mặt này thế hả?
Dialogue: 0,0:12:25.51,0:12:27.47,Default,Kyo,0,0,0,,Là tôi đấy!
Dialogue: 0,0:12:27.47,0:12:31.31,Default,Oka,0,0,0,,Đừng có dạy Kotomi mấy trò kỳ quặc bậy bạ nữa.
Dialogue: 0,0:12:31.31,0:12:33.73,Default,Kyo,0,0,0,,Sao lại không? Có mất mát gì đâu nào.
Dialogue: 0,0:12:33.73,0:12:35.31,Default,Nag,0,0,0,,Kyou-chan!
Dialogue: 0,0:12:37.90,0:12:39.15,Default,Oka,0,0,0,,Sao thế Nagisa?
Dialogue: 0,0:12:42.03,0:12:45.24,Default,Nag,0,0,0,,Kyou-chan! Ryou-chan đi học bằng xe buýt đúng không?
Dialogue: 0,0:12:45.24,0:12:47.74,Default,Kyo,0,0,0,,Ừ, đúng rồi. Sao thế?
Dialogue: 0,0:12:47.74,0:12:50.79,Default,Nag,0,0,0,,Bạn ấy lúc nào cũng bắt chuyến xe tầm giờ này đúng không?
Dialogue: 0,0:12:51.58,0:12:54.41,Default,Kyo,0,0,0,,Sao trông cậu hoảng hốt hớt hải thế hả?
Dialogue: 0,0:12:54.91,0:12:59.54,Default,Nag,0,0,0,,Dưới ngã tư vừa có một vụ tai nạn xe buýt, người ta đang bu đông lắm.
Dialogue: 0,0:13:02.05,0:13:03.88,Default,Nag,0,0,0,,Trông như một vụ tai nạn rất nghiêm trọng.
Dialogue: 0,0:13:03.88,0:13:05.68,Default,Nag,0,0,0,,Có khi nào Ryou-chan đã...
Dialogue: 0,0:13:06.51,0:13:08.76,Default,Kyo,0,0,0,,Không! Không thể nào có chuyện đó được!
Dialogue: 0,0:13:08.76,0:13:12.02,Default,Kyo,0,0,0,,Nếu Ryou có mệnh hệ gì thì làm sao tao lại không linh cảm thấy được chứ!
Dialogue: 0,0:13:12.72,0:13:13.68,Default,Oka,0,0,0,,Kyou!
Dialogue: 0,0:13:22.32,0:13:27.07,Default,Guy,0,0,0,,Trời đất... Lần đầu tiên tao thấy một chiếc xe buýt bị lật nhào như thế.
Dialogue: 0,0:13:27.07,0:13:29.28,Default,Guy,0,0,0,,Có thể có người bị thương đấy.
Dialogue: 0,0:13:30.66,0:13:31.12,Default,Kyo,0,0,0,,Ryou!
Dialogue: 0,0:13:31.12,0:13:32.04,Default,Ryo,0,0,0,,Chị hai?
Dialogue: 0,0:13:33.33,0:13:34.29,Default,Nag,0,0,0,,Ryou-chan!
Dialogue: 0,0:13:35.12,0:13:37.17,Default,Oka,0,0,0,,Fujibayashi! Cậu bình an vô sự chứ?
Dialogue: 0,0:13:37.17,0:13:39.38,Default,Kyo,0,0,0,,Cậu không có mặt trên chuyến xe đó à?
Dialogue: 0,0:13:40.75,0:13:43.71,Default,Ryo,0,0,0,,Tớ đi chuyến xe buýt ngay sau chuyến đó cơ.
Dialogue: 0,0:13:43.71,0:13:47.38,Default,Ryo,0,0,0,,Đoạn đường bị tắc nghẽn nên tớ mới bị trễ giờ học.
Dialogue: 0,0:13:47.38,0:13:51.68,Default,Ryo,0,0,0,,Chiếc xe buýt đó đang trên đường quay về bến nên trên xe không có hành khách nào cả.
Dialogue: 0,0:13:51.68,0:13:54.31,Default,Ryo,0,0,0,,Cả bác tài xế lẫn người lái xe bên kia đều không sao hết.
Dialogue: 0,0:13:54.31,0:13:54.97,Default,Ryo,0,0,0,,Thấy chưa hả?
Dialogue: 0,0:13:55.98,0:13:58.77,Default,Bus,0,0,0,,Rõ ràng là ông vượt đèn đỏ lao vào xe tôi!
Dialogue: 0,0:13:58.77,0:14:01.11,Default,Guy,0,0,0,,Tôi thấy đèn vàng nên mới phóng nhanh qua thôi mà!
Dialogue: 0,0:14:01.11,0:14:02.65,Default,Guy,0,0,0,,Tại ông không chú ý quan sát thì có!
Dialogue: 0,0:14:02.65,0:14:05.99,Default,Guy,0,0,0,,Thôi được rồi, thôi được rồi! Mời hai người về đồn tường trình sau.
Dialogue: 0,0:14:05.99,0:14:10.28,Default,Nag,0,0,0,,Thật may là không có ai bị thương cả.
Dialogue: 0,0:14:14.33,0:14:15.20,Default,Ryo,0,0,0,,Chị hai ơi.
Dialogue: 0,0:14:15.20,0:14:19.25,Default,Nag,0,0,0,,Em xin lỗi vì đã làm mọi chuyện ầm ĩ lên nhé.
Dialogue: 0,0:14:19.25,0:14:21.67,Default,Oka,0,0,0,,May mà không có chuyện gì tồi tệ xảy ra.
Dialogue: 0,0:14:25.96,0:14:27.22,Default,Oka,0,0,0,,Cậu có sao không?
Dialogue: 0,0:14:27.22,0:14:28.09,Default,Nag,0,0,0,,Kotomi-chan.
Dialogue: 0,0:14:28.09,0:14:30.18,Default,Nag,0,0,0,,Ryou-chan không sao đâu mà.
Dialogue: 0,0:14:30.84,0:14:32.05,Default,Nag,0,0,0,,Kotomi-chan?
Dialogue: 0,0:14:38.14,0:14:39.52,Default,Nag,0,0,0,,Kotomi-chan ơi?
Dialogue: 0,0:14:55.58,0:14:56.66,Default,Nag,0,0,0,,Kotomi-chan!
Dialogue: 0,0:14:56.66,0:14:58.33,Default,Kyo,0,0,0,,Sao thế hả Kotomi?
Dialogue: 0,0:14:58.33,0:15:01.04,Default,Oka,0,0,0,,Kotomi! Kotomi!
Dialogue: 0,0:15:01.04,0:15:03.21,Default,Kot,0,0,0,,Mình sẽ là một đứa bé ngoan mà...
Dialogue: 0,0:15:03.21,0:15:07.17,Default,Kot,0,0,0,,Mình sẽ ngoan ngoãn mà, nên là...
Dialogue: 0,0:15:07.17,0:15:08.42,Default,Nag,0,0,0,,Kotomi-chan!
Dialogue: 0,0:15:08.42,0:15:10.13,Default,Ryo,0,0,0,,Kotomi-chan, tỉnh lại đi em!
Dialogue: 0,0:15:10.13,0:15:12.01,Default,Kyo,0,0,0,,Bệnh viện! Gọi xe cấp cứu mau!
Dialogue: 0,0:15:12.01,0:15:13.60,Default,Kyo,0,0,0,,Đúng rồi, đưa bạn ấy vào phòng y tế trước đã!
Dialogue: 0,0:15:16.35,0:15:17.93,Default,Oka,0,0,0,,Về sớm rồi sao?
Dialogue: 0,0:15:17.93,0:15:21.10,Default,Kyo,0,0,0,,Vâng. Con bé đã ra về giữa tiết một rồi.
Dialogue: 0,0:15:21.10,0:15:22.02,Default,Kyo,0,0,0,,Một mình.
Dialogue: 0,0:15:22.02,0:15:25.32,Default,Nag,0,0,0,,Đó là lời cô y tế trường nói đấy.
Dialogue: 0,0:15:25.82,0:15:27.73,Default,Oka,0,0,0,,Trông con bé như vừa trải qua một cú sốc tinh thần vô cùng nặng nề.
Dialogue: 0,0:15:27.73,0:15:29.78,Default,Oka,0,0,0,,Để bạn ấy tự về nhà một mình như thế liệu có ổn không ạ?
Dialogue: 0,0:15:29.78,0:15:33.16,Default,Nag,0,0,0,,Bọn tôi cũng đã hỏi cô câu đó rồi.
Dialogue: 0,0:15:33.16,0:15:38.37,Default,Ryo,0,0,0,,Cô ấy bảo chuyện này liên quan đến quyền riêng tư cá nhân của Ichinose-san nên không thể tiết lộ gì thêm.
Dialogue: 0,0:15:38.37,0:15:39.79,Default,Oka,0,0,0,,Quyền riêng tư sao?
Dialogue: 0,0:15:40.91,0:15:42.54,Default,Kyo,0,0,0,,Chúng ta lên phòng giáo viên đi.
Dialogue: 0,0:15:42.54,0:15:45.17,Default,Kyo,0,0,0,,Giáo viên chủ nhiệm của cậu ấy chắc chắn phải biết điều gì đó.
Dialogue: 0,0:15:46.29,0:15:52.47,Default,Teacher,0,0,0,,Em ấy đến gặp thầy và bảo người không được khỏe nên muốn tự mình về nhà.
Dialogue: 0,0:15:52.47,0:15:54.93,Default,Kyo,0,0,0,,Đã có chuyện gì xảy ra với Ichinose-san thế ạ?
Dialogue: 0,0:15:54.93,0:15:57.06,Default,Kyo,0,0,0,,Vụ quyền riêng tư này rốt cuộc là sao hả thầy?
Dialogue: 0,0:15:57.06,0:15:59.81,Default,Teacher,0,0,0,,Đã gọi là chuyện riêng tư thì các thầy cô không thể tiết lộ cho các em được.
Dialogue: 0,0:15:59.81,0:16:02.69,Default,Teacher,0,0,0,,Các em phải đợi đến khi đích thân Ichinose-san kể cho các em nghe thôi.
Dialogue: 0,0:16:02.69,0:16:07.15,Default,Oka,0,0,0,,Bọn em đến nhà bạn ấy thăm có được không ạ?
Dialogue: 0,0:16:07.15,0:16:10.90,Default,Teacher,0,0,0,,Thầy nghĩ lúc này tốt nhất là nên để em ấy được yên tĩnh một mình...
Dialogue: 0,0:16:12.07,0:16:14.70,Default,Teacher,0,0,0,,Nhưng thôi được rồi. Để thầy viết địa chỉ nhà em ấy cho các em.
Dialogue: 0,0:16:14.70,0:16:16.70,Default,Teacher,0,0,0,,Tuyệt đối không được ép buộc em ấy phải gặp mặt đâu đấy nhé?
Dialogue: 0,0:16:18.45,0:16:22.96,Default,Ryo,0,0,0,,Kotomi-chan tưởng tớ bị tai nạn nên mới rơi vào trạng thái sốc tâm lý như vậy...
Dialogue: 0,0:16:23.54,0:16:27.88,Default,Nag,0,0,0,,Tất cả là lỗi tại tớ. Nếu tớ không hớt hải bảo có tai nạn...
Dialogue: 0,0:16:27.88,0:16:29.63,Default,Oka,0,0,0,,Không ai trong hai cậu có lỗi cả.
Dialogue: 0,0:16:29.63,0:16:30.71,Default,Oka,0,0,0,,Đừng tự dằn vặt mình nữa.
Dialogue: 0,0:16:31.34,0:16:33.01,Default,Nag,0,0,0,,Cậu chắc chứ?
Dialogue: 0,0:16:34.22,0:16:35.93,Default,Kyo,0,0,0,,Biết đâu...
Dialogue: 0,0:16:36.39,0:16:40.39,Default,Kyo,0,0,0,,...chúng mình vẫn chưa thực sự là bạn bè của cậu ấy.
Dialogue: 0,0:16:44.35,0:16:45.73,Default,Kyo,0,0,0,,Cậu ấy không có nhà sao?
Dialogue: 0,0:16:46.19,0:16:49.23,Default,Nag,0,0,0,,Có khi bạn ấy đang ngủ say rồi.
Dialogue: 0,0:16:50.15,0:16:53.28,Default,Kyo,0,0,0,,Hôm nay tạm thời thế đã, mai chúng mình quay lại nhé?
Dialogue: 0,0:16:54.36,0:16:55.61,Default,Nag,0,0,0,,Okazaki-san?
Dialogue: 0,0:16:55.61,0:16:58.53,Default,Nag,0,0,0,,Okazaki-san, có chuyện gì thế cậu?
Dialogue: 0,0:16:58.53,0:16:59.83,Default,Oka,0,0,0,,Không, không có gì đâu.
Dialogue: 0,0:17:07.13,0:17:08.25,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:17:09.50,0:17:11.21,Default,Oka,0,0,0,,Ừ, sao thế?
Dialogue: 0,0:17:11.21,0:17:14.30,Default,Nag,0,0,0,,Cậu cứ đứng thẫn thờ nhìn mãi từ nãy đến giờ.
Dialogue: 0,0:17:15.01,0:17:18.47,Default,Oka,0,0,0,,Ngôi nhà này cứ khiến tớ cảm thấy bồn chồn khó tả.
Dialogue: 0,0:17:19.60,0:17:22.81,Default,Oka,0,0,0,,Tớ không rõ chính xác cảm giác này là gì nữa...
Dialogue: 0,0:17:24.56,0:17:26.27,Default,Nag,0,0,0,,Okazaki-san?
Dialogue: 0,0:17:26.27,0:17:27.73,Default,Oka,0,0,0,,Các cậu cứ về trước đi.
Dialogue: 0,0:17:27.73,0:17:28.65,Default,Oka,0,0,0,,Hẹn gặp lại các cậu vào ngày mai!
Dialogue: 0,0:17:28.65,0:17:29.81,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:17:38.95,0:17:41.20,Default,Oka,0,0,0,,Này! Cậu làm cái trò gì ở đây thế hả?!
Dialogue: 0,0:17:41.20,0:17:42.87,Default,Man,0,0,0,,Cậu là cậu bé hôm nọ.
Dialogue: 0,0:17:42.87,0:17:44.33,Default,Oka,0,0,0,,Cậu có việc gì với ngôi nhà này sao?
Dialogue: 0,0:17:45.33,0:17:47.54,Default,Man,0,0,0,,Ồ, tôi xin lỗi.
Dialogue: 0,0:17:47.54,0:17:51.34,Default,Man,0,0,0,,Cậu nghi ngờ hành động của tôi cũng phải thôi.
Dialogue: 0,0:17:52.09,0:17:58.63,Default,Man,0,0,0,,Tôi bấm chuông mãi nhưng không có ai trả lời,\Nnên tôi đi vòng ra sau vườn xem có ai ở nhà không.
Dialogue: 0,0:17:59.39,0:18:01.35,Default,Oka,0,0,0,,Ông là ai?
Dialogue: 0,0:18:01.76,0:18:04.81,Default,Man,0,0,0,,Tôi là người quen cũ của bố mẹ Kotomi-kun.
Dialogue: 0,0:18:04.81,0:18:07.56,Default,Man,0,0,0,,Tôi từng là thành viên trong phòng nghiên cứu của họ.
Dialogue: 0,0:18:07.89,0:18:11.11,Default,Man,0,0,0,,Tôi quen biết Kotomi-kun từ khi con bé còn đỏ hỏn.
Dialogue: 0,0:18:11.11,0:18:13.73,Default,Oka,0,0,0,,Ông đến để gặp bố mẹ của Kotomi à?
Dialogue: 0,0:18:15.07,0:18:18.11,Default,Man,0,0,0,,À, hóa ra cậu chưa biết gì sao.
Dialogue: 0,0:18:18.86,0:18:23.58,Default,Man,0,0,0,,Nếu con bé đã muốn giữ bí mật,\Nthì đây không phải là điều tôi nên tự tiện nói ra.
Dialogue: 0,0:18:23.58,0:18:26.37,Default,Man,0,0,0,,Đó là chuyện riêng tư gia đình con bé.
Dialogue: 0,0:18:27.33,0:18:28.83,Default,Oka,0,0,0,,Y hệt như những gì thầy giáo đã nói.
Dialogue: 0,0:18:29.58,0:18:33.00,Default,Oka,0,0,0,,Bố mẹ của Kotomi là những nhà khoa học kiệt xuất đúng không?
Dialogue: 0,0:18:33.00,0:18:35.25,Default,Oka,0,0,0,,Họ quan trọng đến mức đó sao?
Dialogue: 0,0:18:39.43,0:18:42.64,Default,Man,0,0,0,,Những gì chúng ta có thể quan sát được không phải là vũ trụ duy nhất đâu.
Dialogue: 0,0:18:43.43,0:18:48.77,Default,Man,0,0,0,,Còn có một chiều không gian đã bị tách rời và phong ấn lại trong quá trình thế giới này thành hình.
Dialogue: 0,0:18:48.77,0:18:51.27,Default,Man,0,0,0,,Thế giới bị che giấu.
Dialogue: 0,0:18:51.85,0:18:54.98,Default,Man,0,0,0,,Bố mẹ con bé là những người đầu tiên tìm ra bằng chứng về sự tồn tại của thế giới đó.
Dialogue: 0,0:18:54.98,0:18:58.44,Default,Man,0,0,0,,Chính xác hơn là, họ được cho là đã tìm thấy nó.
Dialogue: 0,0:18:59.32,0:19:02.57,Default,Oka,0,0,0,,Nghe có vẻ là một câu chuyện phức tạp quá.
Dialogue: 0,0:19:02.57,0:19:08.41,Default,Guy,0,0,0,,Dù sao đi nữa, được phụ tá cho công trình nghiên cứu của vợ chồng giáo sư Ichinose là một niềm vinh dự to lớn đối với chúng tôi.
Dialogue: 0,0:19:09.12,0:19:10.37,Default,Guy,0,0,0,,Thế nhưng...
Dialogue: 0,0:19:10.79,0:19:13.96,Default,Guy,0,0,0,,Không, tôi chỉ có thể kể đến đây thôi.
Dialogue: 0,0:19:14.38,0:19:17.80,Default,Guy,0,0,0,,Kotomi-kun có nói gì về tôi không?
Dialogue: 0,0:19:18.13,0:19:19.34,Default,Oka,0,0,0,,Dạ...
Dialogue: 0,0:19:19.72,0:19:21.26,Default,Oka,0,0,0,,"Một kẻ xấu."
Dialogue: 0,0:19:22.72,0:19:26.81,Default,Guy,0,0,0,,Có lẽ đối với con bé, chúng tôi mãi mãi vẫn chỉ là những kẻ xấu xa.
Dialogue: 0,0:19:28.89,0:19:31.60,Default,Guy,0,0,0,,Cậu là bạn cùng lớp của con bé à?
Dialogue: 0,0:19:31.60,0:19:34.52,Default,Oka,0,0,0,,Không cùng lớp, nhưng cháu là bạn của cậu ấy.
Dialogue: 0,0:19:35.11,0:19:36.11,Default,Guy,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:19:37.36,0:19:40.49,Default,Guy,0,0,0,,Khi có cơ hội,\Ntôi nhờ cậu chuyển lại những lời này đến con bé nhé.
Dialogue: 0,0:19:40.90,0:19:47.74,Default,Guy,0,0,0,,"Chú không dám mong cháu sẽ tha thứ,\Nnhưng cho đến tận bây giờ chúng chú vẫn vô cùng ân hận về những gì đã xảy ra vào ngày hôm đó."
Dialogue: 0,0:19:47.74,0:19:49.12,Default,Oka,0,0,0,,Ngày hôm đó sao?
Dialogue: 0,0:19:49.12,0:19:50.37,Default,Guy,0,0,0,,Chỉ có vậy thôi.
Dialogue: 0,0:19:50.37,0:19:52.08,Default,Guy,0,0,0,,Tôi xin phép đi trước.
Dialogue: 0,0:19:57.13,0:19:59.09,Default,Oka,0,0,0,,Nơi này trông quen thuộc quá.
Dialogue: 0,0:20:01.76,0:20:07.76,Default,Oka,0,0,0,,Không, mình chưa từng bước vào qua lối cửa chính bao giờ.
Dialogue: 0,0:20:40.30,0:20:42.47,Default,Kot,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:21:06.74,0:21:09.37,Default,Kot,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:21:12.45,0:21:14.00,Default,Kot,0,0,0,,hôm qua tớ thấy một chú hươu,
Dialogue: 0,0:21:24.09,0:21:26.80,Default,Kot,0,0,0,,và hôm nay, tớ thấy cậu.
Dialogue: 0,0:21:39.31,0:21:40.36,Note,,0,0,0,,{\an8\fs36\i1}*Bài báo: "Máy bay rơi: Thảm kịch kinh hoàng"
Dialogue: 0,0:21:40.36,0:21:42.32,Note,,0,0,0,,{\an8\fs36\i1}*Bài báo: "Đa tạp Calabi-Yau và lý thuyết vũ trụ song song"
Dialogue: 0,0:21:42.32,0:21:44.82,Note,,0,0,0,,{\an8\fs36\i1}*Bài báo: "Vợ chồng nhà khoa học Ichinose tử nạn"
Dialogue: 0,0:21:45.04,0:21:47.04,Note,,0,0,0,,
Dialogue: 0,0:22:00.84,0:22:03.50,Default,Oka,0,0,0,,Vậy ra, chúng ta đã từng gặp nhau...
Dialogue: 0,0:22:04.59,0:22:05.76,Default,Oka,0,0,0,,...từ khi còn là những đứa trẻ.
