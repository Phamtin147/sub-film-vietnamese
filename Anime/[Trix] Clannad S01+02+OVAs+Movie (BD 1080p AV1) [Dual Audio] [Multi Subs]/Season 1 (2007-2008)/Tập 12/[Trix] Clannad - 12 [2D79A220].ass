Dialogue: 0,0:00:00.00,0:00:02.90,Default,,0,0,0,,
Dialogue: 0,0:00:02.64,0:00:06.19,Default,Kot,0,0,0,,Cảm ơn cậu rất nhiều vì đã cho mình mượn cây vĩ cầm nhé.
Dialogue: 0,0:00:06.19,0:00:08.86,Default,Oka,0,0,0,,Bọn tớ xin lỗi vì đã mượn nó suốt cả một tuần liền.
Dialogue: 0,0:00:08.86,0:00:12.99,Default,Nis,0,0,0,,Thực ra đây không phải là tài sản của trường học đâu.
Dialogue: 0,0:00:12.99,0:00:18.03,Default,Nis,0,0,0,,Nó là món đồ một anh chị cựu học sinh tốt nghiệp vài năm trước để lại.
Dialogue: 0,0:00:18.03,0:00:23.29,Default,Nis,0,0,0,,Thầy cô nhờ tớ kiểm tra xem cây đàn này còn chơi được nữa hay không,
Dialogue: 0,0:00:23.91,0:00:26.50,Default,Nis,0,0,0,,bởi vì đây là một cây vĩ cầm đã cũ rồi.
Dialogue: 0,0:00:27.04,0:00:29.04,Default,Kot,0,0,0,,Cây vĩ cầm đó...
Dialogue: 0,0:00:29.59,0:00:35.18,Default,Kot,0,0,0,,...dù đã cũ và dây đàn cũng mòn nhiều rồi,\Nnhưng nó là một cây vĩ cầm tuyệt vời lắm.
Dialogue: 0,0:00:35.18,0:00:37.76,Default,Kot,0,0,0,,Thế nên xin cậu đừng vứt nó đi nhé.
Dialogue: 0,0:00:38.43,0:00:40.18,Default,Kot,0,0,0,,Mình xin cậu đấy.
Dialogue: 0,0:00:41.85,0:00:45.89,Default,Nis,0,0,0,,Ừ. Tớ cũng định sẽ thưa lại chuyện đó với thầy cô mà.
Dialogue: 0,0:00:46.44,0:00:47.90,Default,Kot,0,0,0,,Thật là may quá.
Dialogue: 0,0:00:48.31,0:00:50.40,Default,Kot,0,0,0,,A, phải rồi. Mình quên mất.
Dialogue: 0,0:00:51.19,0:00:53.69,Default,Kot,0,0,0,,Xin chào. Rất vui được gặp cậu.
Dialogue: 0,0:00:53.69,0:00:56.86,Default,Kot,0,0,0,,Tên mình là Ichinose Kotomi. Học sinh năm ba Lớp A.
Dialogue: 0,0:00:56.86,0:00:58.66,Default,Kot,0,0,0,,Sở thích của mình là đọc sách.
Dialogue: 0,0:00:58.66,0:01:02.45,Default,Kot,0,0,0,,Nếu được làm bạn với cậu thì mình sẽ rất vui.
Dialogue: 0,0:01:02.79,0:01:07.12,Default,Oka,0,0,0,,Nói "rất vui được gặp" nghe hơi kỳ vì hai người đã gặp nhau rồi, nhưng nhỏ là thế đấy.
Dialogue: 0,0:01:07.75,0:01:10.21,Default,Nis,0,0,0,,Tên tớ là Nishina Rie.
Dialogue: 0,0:01:10.21,0:01:12.92,Default,Nis,0,0,0,,Rất vui được làm quen với cậu nhé.
Dialogue: 0,0:01:15.47,0:01:16.72,Default,Nis,0,0,0,,Hẹn gặp lại cậu sau.
Dialogue: 0,0:01:16.72,0:01:18.18,Default,Oka,0,0,0,,Ừ, hẹn gặp lại.
Dialogue: 0,0:01:22.14,0:01:24.31,Default,Oka,0,0,0,,Có thêm nhiều bạn bè cậu thấy vui chứ?
Dialogue: 0,0:01:24.31,0:01:25.14,Default,Kot,0,0,0,,Ừm.
Dialogue: 0,0:01:25.56,0:01:27.94,Default,Oka,0,0,0,,Cứ đà này số lượng bạn bè tăng lên thì tuyệt quá nhỉ.
Dialogue: 0,0:01:27.94,0:01:28.60,Default,Kot,0,0,0,,Ừm.
