Dialogue: 0,0:03:24.09,0:03:25.22,Default,Girl,0,0,0,,Làm xong rồi này.
Dialogue: 0,0:03:56.59,0:03:57.75,Default,Girl,0,0,0,,Em xin lỗi.
Dialogue: 0,0:03:58.67,0:04:00.01,Default,Girl,0,0,0,,Em xin lỗi anh.
Dialogue: 0,0:04:01.05,0:04:02.38,Default,Girl,0,0,0,,Em xin lỗi.
Dialogue: 0,0:04:07.39,0:04:09.60,Default,Oka,0,0,0,,Một cô bé nơi thế giới đã lụi tàn.
Dialogue: 0,0:04:10.60,0:04:13.56,Default,Oka,0,0,0,,Mình có cảm giác như đã từng nhìn thấy cảnh tượng đó ở đâu rồi.
Dialogue: 0,0:04:14.52,0:04:18.27,Default,Oka,0,0,0,,Dù bản thân chẳng hề biết mình đã thấy nó từ lúc nào hay ở đâu.
Dialogue: 0,0:04:18.73,0:04:19.90,Default,Oka,0,0,0,,Nhưng mình tin chắc...
Dialogue: 0,0:04:20.65,0:04:24.28,Default,San,0,0,0,,Hóa ra bấy lâu nay em là gánh nặng cản trở tiệm bánh Furukawa sao?!
Dialogue: 0,0:04:24.28,0:04:27.24,Default,Aki,0,0,0,,Anh yêu món bánh đó nhất trên đời mà!
Dialogue: 0,0:04:26.66,0:04:30.33,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410)\3c&H4A8A5C&}Tập 20
Dialogue: 0,0:04:26.66,0:04:30.33,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Quá khứ ẩn giấu
Dialogue: 0,0:04:30.33,0:04:32.45,Default,Aki,0,0,0,,Khốn kiếp thật, tao lại lỡ mồm rồi.
Dialogue: 0,0:04:32.45,0:04:34.16,Default,Oka,0,0,0,,Lần này lại có chuyện gì nữa thế chú?
Dialogue: 0,0:04:34.16,0:04:39.50,Default,Aki,0,0,0,,Tao vừa nhiệt tình mời chào bánh của Sanae cho khách,
thì lão khách chê bánh dở ói nuốt không trôi.
Dialogue: 0,0:04:39.84,0:04:41.76,Default,Aki,0,0,0,,Và Sanae đã nghe thấy toàn bộ.
Dialogue: 0,0:04:42.30,0:04:44.88,Default,Aki,0,0,0,,Món đó gọi là “bánh mì cầu vồng”.
Dialogue: 0,0:04:45.30,0:04:47.72,Default,Aki,0,0,0,,Cầu vồng cái con khỉ khô ấy!
Dialogue: 0,0:04:47.72,0:04:49.97,Default,Oka,0,0,0,,Chẳng hiểu chú đang nói cái quái gì nữa.
Dialogue: 0,0:04:50.35,0:04:52.89,Default,Aki,0,0,0,,Một cô bé ở thế giới đã lụi tàn sao...
Dialogue: 0,0:04:52.89,0:04:56.19,Default,Aki,0,0,0,,Chịu, tao chẳng có chút ấn tượng nào về chuyện đó cả.
Dialogue: 0,0:04:56.19,0:04:58.81,Default,Oka,0,0,0,,Chú có nghĩ đó là ký ức từ hồi bé không?
Dialogue: 0,0:04:58.81,0:05:01.90,Default,Oka,0,0,0,,Chú có từng đọc sách tranh hay kể câu chuyện nào như thế cho Nagisa nghe chưa?
Dialogue: 0,0:05:03.82,0:05:05.70,Default,Aki,0,0,0,,Không, tao chẳng nhớ có chuyện nào như thế cả.
Dialogue: 0,0:05:06.07,0:05:07.74,Default,Aki,0,0,0,,Đi mà hỏi Sanae ấy.
Dialogue: 0,0:05:07.74,0:05:08.82,Default,Oka,0,0,0,,Cháu hiểu rồi...
Dialogue: 0,0:05:08.82,0:05:09.70,Default,Oka,0,0,0,,Vậy thì thôi ạ.
Dialogue: 0,0:05:10.37,0:05:11.66,Default,Aki,0,0,0,,Này, thằng ranh con.
Dialogue: 0,0:05:12.66,0:05:16.75,Default,Aki,0,0,0,,Tao không biết mày đang cố tìm hiểu cái chuyện gì.
Dialogue: 0,0:05:16.75,0:05:20.67,Default,Aki,0,0,0,,Nhưng cho dù mày có tìm ra chân tướng đi chăng nữa, tuyệt đối không được hé răng nửa lời với con bé Nagisa.
Dialogue: 0,0:05:20.67,0:05:22.30,Default,Aki,0,0,0,,Phải đến nói với tao trước.
Dialogue: 0,0:05:22.30,0:05:23.34,Default,Oka,0,0,0,,Tại sao thế chú?
Dialogue: 0,0:05:23.34,0:05:24.55,Default,Aki,0,0,0,,Vì tao đã bảo thế.
Dialogue: 0,0:05:24.92,0:05:25.67,Default,Aki,0,0,0,,Rõ chưa hả?
Dialogue: 0,0:05:27.13,0:05:30.30,Default,San,0,0,0,,Không, cô cũng chẳng nhớ có câu chuyện nào như thế cả cháu ạ.
Dialogue: 0,0:05:30.30,0:05:32.59,Default,Oka,0,0,0,,Cô có thể nhớ lại kỹ hơn một chút được không ạ?
Dialogue: 0,0:05:32.59,0:05:35.77,Default,Oka,0,0,0,,Nếu không phải là sách thì liệu có thể là
một chương trình truyền hình nào đó cô từng xem cùng bạn ấy không ạ?
Dialogue: 0,0:05:36.39,0:05:38.85,Default,San,0,0,0,,Cháu có biết kết thúc của câu chuyện ra sao không?
Dialogue: 0,0:05:40.65,0:05:45.78,Default,Oka,0,0,0,,Bạn ấy bảo đó là một câu chuyện rất buồn,
nên chắc chắn không phải là kết thúc có hậu rồi ạ.
Dialogue: 0,0:05:45.78,0:05:47.70,Default,San,0,0,0,,Một câu chuyện buồn sao...
Dialogue: 0,0:05:49.32,0:05:50.99,Default,San,0,0,0,,Cô chẳng nghĩ ra được gì cả.
Dialogue: 0,0:05:51.37,0:05:55.54,Default,San,0,0,0,,Vốn dĩ cô không giỏi chịu đựng mấy câu chuyện buồn cho lắm,
Dialogue: 0,0:05:55.54,0:05:59.46,Default,San,0,0,0,,nên cô không nghĩ là mình từng kể một câu chuyện như thế cho Nagisa nghe đâu.
Dialogue: 0,0:05:59.83,0:06:01.08,Default,Oka,0,0,0,,Cháu hiểu rồi ạ.
Dialogue: 0,0:06:01.75,0:06:04.05,Default,San,0,0,0,,Đó là một chuyện rất quan trọng sao cháu?
Dialogue: 0,0:06:04.46,0:06:05.92,Default,Oka,0,0,0,,Dạ, đại loại là vậy ạ.
Dialogue: 0,0:06:06.51,0:06:07.30,Default,Oka,0,0,0,,Nó là...
Dialogue: 0,0:06:08.09,0:06:09.80,Default,Oka,0,0,0,,Một điều rất quan trọng.
Dialogue: 0,0:06:10.22,0:06:13.18,Default,Oka,0,0,0,,Vâng, cháu luôn cảm thấy nó là một điều vô cùng quan trọng.
Dialogue: 0,0:06:13.85,0:06:20.10,Default,San,0,0,0,,{\fscx108}Cũng có khả năng là bọn cô đã trót quên mất, và cuốn sách cháu đang tìm vẫn còn cất giữ ở đâu đó trong nhà này.
Dialogue: 0,0:06:20.10,0:06:22.15,Default,San,0,0,0,,Hay là cháu thử tìm thử xem sao?
Dialogue: 0,0:06:22.56,0:06:25.61,Default,Oka,0,0,0,,Dạ cháu cảm ơn cô nhiều ạ. Cháu sẽ đi tìm thử xem.
Dialogue: 0,0:06:32.78,0:06:36.37,Default,Yuk,0,0,0,,Em nghĩ anh sẽ không tìm thấy nó ở trường này đâu ạ.
Dialogue: 0,0:06:36.37,0:06:38.87,Default,Yuk,0,0,0,,Ở đây không có nhiều sách tranh hay sách thiếu nhi đâu.
Dialogue: 0,0:06:39.46,0:06:42.50,Default,Oka,0,0,0,,Thì cũng đúng thôi, thư viện trường cấp ba mà.
Dialogue: 0,0:06:42.50,0:06:46.84,Default,Yuk,0,0,0,,Nhưng ở đây có rất nhiều tài liệu kịch bản từng được biểu diễn ở các trường cấp ba đấy ạ.
Dialogue: 0,0:06:46.84,0:06:48.59,Default,Yuk,0,0,0,,Những thứ đó có giúp ích được gì cho anh không?
Dialogue: 0,0:06:48.59,0:06:52.30,Default,Oka,0,0,0,,Cảm ơn em nhé, nhưng nghe chừng đây không phải là một vở kịch sân khấu rồi.
Dialogue: 0,0:06:52.30,0:06:54.01,Default,Yuk,0,0,0,,Em hiểu rồi ạ.
Dialogue: 0,0:06:54.01,0:06:55.89,Default,Sun,0,0,0,,Mấy chuyện đó tính sau đi Yukine-chan ơi.
Dialogue: 0,0:06:55.89,0:07:00.48,Default,Sun,0,0,0,,Có bùa chú nào giúp tao biết được đứa con gái nào đang thầm thương trộm nhớ tao không, chỉ tao với coi?
Dialogue: 0,0:07:00.48,0:07:02.98,Default,Oka,0,0,0,,Người ta đang nói chuyện nghiêm túc đấy nhé cái thằng này!
Dialogue: 0,0:07:02.98,0:07:04.44,Default,Yuk,0,0,0,,Dạ có, em có một câu bùa chú như thế đấy ạ.
Dialogue: 0,0:07:04.44,0:07:05.94,Default,Sun,0,0,0,,Thật á em ơi?!
Dialogue: 0,0:07:05.94,0:07:06.69,Default,Yuk,0,0,0,,Tada!
Dialogue: 0,0:07:07.23,0:07:11.45,Default,Yuk,0,0,0,,Đầu tiên hãy dùng hai ngón cái và hai ngón trỏ ghép lại thành hình trái tim.
Dialogue: 0,0:07:11.45,0:07:15.62,Default,Yuk,0,0,0,,Sau đó niệm câu: “Yêu, được yêu, đá, bị đá” ba lần nhé.
Dialogue: 0,0:07:15.62,0:07:20.21,Default,Sun,0,0,0,,Yêu, được yêu, đá, bị đá.
Dialogue: 0,0:07:22.79,0:07:24.13,Default,Sun,0,0,0,,Rồi sao nữa em?
Dialogue: 0,0:07:24.13,0:07:31.26,Default,Yuk,0,0,0,,Hãy đi bộ quanh trường một vòng; bạn nữ đầu tiên bắt chuyện với anh chính là người đang thầm để ý tới anh đấy ạ.
Dialogue: 0,0:07:31.26,0:07:33.55,Default,Sun,0,0,0,,Tuyệt cú mèo! Anh đi đây!
Dialogue: 0,0:07:36.89,0:07:37.76,Default,Oka,0,0,0,,Này em.
Dialogue: 0,0:07:37.76,0:07:38.39,Default,Yuk,0,0,0,,Dạ anh?
Dialogue: 0,0:07:38.39,0:07:43.40,Default,Oka,0,0,0,,Con gái có thích được người ta chủ động tỏ tình không?
Dialogue: 0,0:07:43.40,0:07:45.44,Default,Yuk,0,0,0,,Anh đang nói đến Furukawa-san đúng không ạ?
Dialogue: 0,0:07:45.44,0:07:46.98,Default,Oka,0,0,0,,Tôi đã nhắc đến tên cậu ấy bao giờ đâu.
Dialogue: 0,0:07:48.02,0:07:52.49,Default,Yuk,0,0,0,,Dĩ nhiên rồi ạ, được nghe câu “Mình yêu cậu” từ người mình thích thì cô gái nào chẳng thấy hạnh phúc.
Dialogue: 0,0:07:52.49,0:07:55.12,Default,Yuk,0,0,0,,Thế nhưng... thời điểm mới là điều quan trọng nhất.
Dialogue: 0,0:07:55.12,0:08:00.45,Default,Yuk,0,0,0,,Nếu anh quá vội vã hoặc đường đột tiếp cận,
có khi lại vô tình đẩy người ta ra xa đấy ạ.
Dialogue: 0,0:08:00.45,0:08:01.62,Default,Oka,0,0,0,,Hóa ra là như thế sao?
Dialogue: 0,0:08:01.62,0:08:03.75,Default,Sun,0,0,0,,Nóng chảy mỡ...
Dialogue: 0,0:08:05.04,0:08:06.21,Default,Yuk,0,0,0,,Kết quả thế nào rồi anh?
Dialogue: 0,0:08:07.42,0:08:09.09,Default,Oka,0,0,0,,Mày chạy được mấy vòng rồi?
Dialogue: 0,0:08:10.71,0:08:14.34,Default,Oka,0,0,0,,Và chẳng có ma nào thèm bắt chuyện đúng không?
Dialogue: 0,0:08:14.34,0:08:15.39,Default,Sun,0,0,0,,Để tao yên đi.
Dialogue: 0,0:08:16.85,0:08:18.64,Default,Yuk,0,0,0,,Để em đi lấy cốc nước cho anh nhé.
Dialogue: 0,0:08:22.85,0:08:25.19,Default,Yuk,0,0,0,,Em nghĩ tiếp theo Okazaki-san cũng nên thử làm xem sao ạ.
Dialogue: 0,0:08:25.52,0:08:27.02,Default,Oka,0,0,0,,Tôi cũng phải làm á?
Dialogue: 0,0:08:27.02,0:08:29.32,Default,Yuk,0,0,0,,Anh hãy chụm ngón tay làm hình trái tim đi ạ.
Dialogue: 0,0:08:29.32,0:08:31.40,Default,Oka,0,0,0,,Tôi không có hứng thú với trò này đâu.
Dialogue: 0,0:08:32.74,0:08:34.07,Default,Oka,0,0,0,,Sunohara, mày cản đường quá đấy.
Dialogue: 0,0:08:43.29,0:08:48.88,Default,Oka,0,0,0,,Không hiểu sao, nhưng mình cứ có cảm giác mối quan hệ giữa mình với cậu ấy sẽ hoàn toàn trái ngược với chuyện tình cảm lãng mạn.
Dialogue: 0,0:08:50.21,0:08:54.34,Default,Oka,0,0,0,,Hiện tại đang có một con gấu đói bụng lảng vảng quanh khu này đấy.
Dialogue: 0,0:08:54.80,0:08:58.43,Default,Oka,0,0,0,,Nên mày phải vừa giả chết vừa lặng lẽ chạy đi.
Dialogue: 0,0:08:58.43,0:09:00.39,Default,Oka,0,0,0,,Cứ như một con xác sống zombie ấy.
Dialogue: 0,0:09:07.40,0:09:08.94,Default,Oka,0,0,0,,Hú hồn chim én, suýt nữa thì toi.
Dialogue: 0,0:09:08.94,0:09:09.81,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:09:11.07,0:09:13.15,Default,Nag,0,0,0,,Thấy cậu mãi chưa đến nên tớ đi tìm này.
Dialogue: 0,0:09:13.15,0:09:14.53,Default,Nag,0,0,0,,Cậu làm cái gì ở đây thế?
Dialogue: 0,0:09:14.53,0:09:16.40,Default,Oka,0,0,0,,À, không... ừm...
Dialogue: 0,0:09:17.86,0:09:19.37,Default,Oka,0,0,0,,...đá, bị đá.
Dialogue: 0,0:09:19.74,0:09:21.12,Default,Yuk,0,0,0,,Anh mau bước ra ngoài đi ạ.
Dialogue: 0,0:09:21.12,0:09:26.08,Default,Yuk,0,0,0,,Bạn nữ đầu tiên cất tiếng nói chuyện với anh
chính là người đang quan tâm đến anh đấy.
Dialogue: 0,0:09:26.71,0:09:28.21,Default,Nag,0,0,0,,Có chuyện gì thế cậu?
Dialogue: 0,0:09:28.21,0:09:29.96,Default,Oka,0,0,0,,K-Không có gì đâu.
Dialogue: 0,0:09:29.96,0:09:31.84,Default,Nag,0,0,0,,Mọi người đã tập hợp đông đủ rồi.
Dialogue: 0,0:09:33.88,0:09:36.63,Default,Nag,0,0,0,,Đó là một câu chuyện tớ đã được nghe từ rất lâu trước đây.
Dialogue: 0,0:09:36.63,0:09:41.89,Default,Nag,0,0,0,,Tớ không còn nhớ là mình đã đọc nó trong sách tranh hay có ai đó từng kể cho tớ nghe nữa.
Dialogue: 0,0:09:42.60,0:09:46.35,Default,Nag,0,0,0,,Cô bé ấy là người duy nhất còn sống sót trên toàn thế giới.
Dialogue: 0,0:09:46.73,0:09:49.90,Default,Nag,0,0,0,,Cô bé cảm thấy vô cùng buồn bã và cô đơn,
Dialogue: 0,0:09:49.90,0:09:53.53,Default,Nag,0,0,0,,nên đã quyết định tự mình tạo ra một người bạn.
Dialogue: 0,0:09:54.03,0:09:58.03,Default,Nag,0,0,0,,Đó là một con búp bê được ghép lại từ những mảnh phế liệu bỏ đi.
Dialogue: 0,0:09:58.53,0:10:02.78,Default,Nag,0,0,0,,Con búp bê bắt đầu cử động, đáp lại tâm nguyện tha thiết của cô bé.
Dialogue: 0,0:10:03.83,0:10:07.25,Default,Nag,0,0,0,,Và kể từ đó, cô bé không còn cảm thấy cô độc nữa.
Dialogue: 0,0:10:08.12,0:10:08.92,Default,Nag,0,0,0,,Hết chuyện rồi ạ.
Dialogue: 0,0:10:10.00,0:10:11.50,Default,Oka,0,0,0,,Đúng rồi, mình thật sự biết câu chuyện này.
Dialogue: 0,0:10:15.34,0:10:16.67,Default,Nag,0,0,0,,Nhìn này Okazaki-san!
Dialogue: 0,0:10:16.67,0:10:18.43,Default,Nag,0,0,0,,Tớ vừa tìm thấy một thứ cực kỳ tuyệt vời luôn!
Dialogue: 0,0:10:18.43,0:10:19.05,Default,Oka,0,0,0,,Cậu tìm thấy cuốn sách rồi à?!
Dialogue: 0,0:10:19.84,0:10:24.76,Default,Nag,0,0,0,,Hồi học tiểu học tớ toàn đeo cái này tòng teng trên cặp sách đi học thôi đấy.
Dialogue: 0,0:10:25.10,0:10:30.69,Default,Nag,0,0,0,,Dango, dango, dango, dango. Dango—
Dialogue: 0,0:10:27.56,0:10:29.94,Default-alt,Oka,0,0,0,,Cậu cũng nên tốt nghiệp khỏi cái món đó đi là vừa rồi đấy.
Dialogue: 0,0:10:29.94,0:10:32.94,Default-alt,Aki,0,0,0,,Đứa nào đang chui rúc trong nhà kho mà hát cái bài ngượng chín cả mặt thế hả?!
Dialogue: 0,0:10:33.36,0:10:34.69,Default,Oka,0,0,0,,Con gái rượu của chú đấy.
Dialogue: 0,0:10:34.69,0:10:40.41,Default,Nag,0,0,0,,Bọn con đang tìm mấy cuốn sách tranh hồi bé con hay đọc với mấy thứ linh tinh ấy mà bố.
Dialogue: 0,0:10:40.41,0:10:42.95,Default,Aki,0,0,0,,Mày sẽ chẳng tìm thấy cuốn sách tranh nào trong này đâu.
Dialogue: 0,0:10:42.95,0:10:45.04,Default,Oka,0,0,0,,Nhưng nếu tìm kỹ thì biết đâu lại thấy đấy ạ.
Dialogue: 0,0:10:45.04,0:10:46.75,Default,Aki,0,0,0,,Tao đã bảo là trong này không có cái gì hết.
Dialogue: 0,0:10:46.75,0:10:50.42,Default,Aki,0,0,0,,Về phòng của hai đứa mà chim chuột ve vãn nhau như bao đứa thanh thiếu niên khác đi.
Dialogue: 0,0:10:50.42,0:10:51.21,Default,Aki,0,0,0,,Khoan đã.
Dialogue: 0,0:10:51.21,0:10:54.13,Default,Aki,0,0,0,,Quái quỷ gì thế này, sao tao lại đi xúi giục bọn nó làm cái trò đó cơ chứ?!
Dialogue: 0,0:10:54.13,0:10:55.96,Default,Oka,0,0,0,,Chú đừng có tự biên tự diễn rồi phấn khích một mình thế chứ.
Dialogue: 0,0:10:55.96,0:10:57.76,Default,Aki,0,0,0,,Câm mồm lại rồi mau cút ra ngoài ngay cho tao!
Dialogue: 0,0:10:57.76,0:10:58.51,Default,Aki,0,0,0,,Ra đây tao bảo.
Dialogue: 0,0:10:59.97,0:11:01.72,Default,Oka,0,0,0,,Chú có chuyện gì muốn nói với cháu à?
Dialogue: 0,0:11:01.72,0:11:05.60,Default,Aki,0,0,0,,Những điều tao sắp nói sau đây, tuyệt đối không được hé răng với con bé Nagisa.
Dialogue: 0,0:11:05.60,0:11:09.43,Default,Aki,0,0,0,,Và cũng không được nói cho Sanae biết là hai đứa mình vừa có cuộc nói chuyện bí mật này.
Dialogue: 0,0:11:10.06,0:11:11.81,Default,Aki,0,0,0,,Tao không muốn chuyện này bị đào bới lại lần nữa đâu.
Dialogue: 0,0:11:12.69,0:11:13.56,Default,Oka,0,0,0,,Dạ rõ.
Dialogue: 0,0:11:14.69,0:11:16.02,Default,Aki,0,0,0,,Tầm này mà có cốc trà nóng thì đã nhỉ.
Dialogue: 0,0:11:16.40,0:11:19.32,Default,Aki,0,0,0,,Sanae ơi! Pha cho bọn anh hai tách trà coi!
Dialogue: 0,0:11:19.32,0:11:20.53,Default,San,0,0,0,,Dạ vâng!
Dialogue: 0,0:11:21.11,0:11:24.91,Default,Aki,0,0,0,,Ủa chú, chú vừa bảo phải giữ bí mật với cả cô Sanae nữa cơ mà?!
Dialogue: 0,0:11:24.91,0:11:27.45,Default,Oka,0,0,0,,Cái não của chú chứa cái giống gì trong đó thế hả?
Dialogue: 0,0:11:29.87,0:11:31.58,Default,Aki,0,0,0,,Hú hồn, suýt thì lộ.
Dialogue: 0,0:11:31.58,0:11:33.08,Default,Aki,0,0,0,,Giờ thì an toàn rồi.
Dialogue: 0,0:11:33.54,0:11:34.92,Default,Aki,0,0,0,,Chuyện là thế này này nhóc—
Dialogue: 0,0:11:34.92,0:11:36.38,Default,San,0,0,0,,Trà của hai người đây ạ.
Dialogue: 0,0:11:36.38,0:11:37.63,Default,Aki,0,0,0,,À, cảm ơn em nhé.
Dialogue: 0,0:11:38.13,0:11:39.80,Default,San,0,0,0,,Cháu mời Okazaki-san nhé.
Dialogue: 0,0:11:40.13,0:11:40.92,Default,Oka,0,0,0,,Cháu cảm ơn cô ạ.
Dialogue: 0,0:11:42.51,0:11:45.22,Default,Aki,0,0,0,,Ừm, đúng là người Nhật thì phải uống trà mới chuẩn bài.
Dialogue: 0,0:11:45.89,0:11:49.43,Default,Oka,0,0,0,,Tao nhắc lại lần nữa: cấm tiệt không được bép xép những lời tao sắp nói cho Nagisa hay Sanae nghe đấy.
Dialogue: 0,0:11:49.43,0:11:51.31,Default,San,0,0,0,,Có chuyện gì liên quan đến em sao anh?
Dialogue: 0,0:11:51.85,0:11:53.73,Default,Aki,0,0,0,,Cái quái gì thế này?! Bả đứng lù lù ngay cạnh mình từ lúc nào thế?!
Dialogue: 0,0:11:53.73,0:11:57.27,Default,San,0,0,0,,Hai người cứ uống xong đi rồi em ra ngoài ngay, đừng lo nhé.
Dialogue: 0,0:11:57.27,0:11:59.44,Default,Aki,0,0,0,,Ranh con, nốc cạn một hơi mau lên!
Dialogue: 0,0:11:59.94,0:12:02.53,Default,Oka,0,0,0,,Chú đâu có bị ngớ ngẩn bẩm sinh đúng không chú?
Dialogue: 0,0:12:03.11,0:12:05.70,Default,Aki,0,0,0,,Cuối cùng cũng có thể ngồi yên tâm nói chuyện đàng hoàng rồi.
Dialogue: 0,0:12:05.70,0:12:08.16,Default,Oka,0,0,0,,Tất cả là do chú tự làm phức tạp hóa vấn đề lên đấy chứ.
Dialogue: 0,0:12:09.54,0:12:11.45,Default,Aki,0,0,0,,Mày đã tìm thấy thứ mày cần tìm chưa?
Dialogue: 0,0:12:11.45,0:12:12.79,Default,Oka,0,0,0,,Dạ chưa, vẫn chưa thấy ạ.
Dialogue: 0,0:12:13.25,0:12:17.79,Default,Aki,0,0,0,,Tao hiểu rồi. Mà tao cũng chẳng quan tâm lắm đến thứ đó.
Dialogue: 0,0:12:17.79,0:12:22.17,Default,Aki,0,0,0,,Tao chẳng bận tâm gì đến cái bô vệ sinh con bé Nagisa ngồi hồi nhỏ đâu.
Dialogue: 0,0:12:22.17,0:12:23.68,Default,Oka,0,0,0,,Cháu cũng đâu có thèm quan tâm đến cái bô đâu ạ.
Dialogue: 0,0:12:23.68,0:12:25.97,Default,Aki,0,0,0,,Thế mà hai đứa chúng mày cứ cuống cuồng lục lọi tìm kiếm mãi!
Dialogue: 0,0:12:25.97,0:12:28.39,Default,Oka,0,0,0,,Tụi cháu có tìm cái bô quái đâu! Tụi cháu tìm cuốn sách tranh cơ mà!
Dialogue: 0,0:12:28.39,0:12:32.89,Default,San,0,0,0,,Hai người kia ơi, trời tối muộn rồi, làm ơn nói nhỏ lại giùm em với.
Dialogue: 0,0:12:32.89,0:12:35.73,Default,Aki,0,0,0,,Kệ đi. Tạm thời chúng ta gác cái bô vệ sinh sang một bên đã.
Dialogue: 0,0:12:35.73,0:12:37.81,Default,Oka,0,0,0,,Cháu đã bảo cái bô không liên quan gì đến chuyện này rồi cơ mà.
Dialogue: 0,0:12:37.81,0:12:38.94,Default,Aki,0,0,0,,Ngậm mồm lại coi!
Dialogue: 0,0:12:38.94,0:12:41.78,Default,Aki,0,0,0,,Vậy từ giờ mật danh của cuộc nói chuyện này sẽ là “cái bô”.
Dialogue: 0,0:12:41.78,0:12:43.49,Default,Oka,0,0,0,,Cháu chịu thua chú luôn rồi đấy.
Dialogue: 0,0:12:43.49,0:12:45.24,Default,Aki,0,0,0,,Chúng ta tiếp tục nào.
Dialogue: 0,0:12:45.24,0:12:47.74,Default,Aki,0,0,0,,Tao thực ra không quan tâm lắm đến thứ mày đang tìm.
Dialogue: 0,0:12:47.74,0:12:51.70,Default,Aki,0,0,0,,Nhưng tao không muốn mày vô tình tìm thấy một thứ khác.
Dialogue: 0,0:12:51.70,0:12:52.95,Default,Oka,0,0,0,,Một thứ khác sao chú?
Dialogue: 0,0:12:52.95,0:12:53.79,Default,Aki,0,0,0,,Mày muốn biết không?
Dialogue: 0,0:12:53.79,0:12:56.21,Default,Oka,0,0,0,,Nếu chú không muốn kể thì cháu cũng chẳng cần phải biết làm gì.
Dialogue: 0,0:12:56.21,0:12:57.75,Default,Aki,0,0,0,,Tao sẽ kể cho mày nghe.
Dialogue: 0,0:12:57.75,0:13:02.05,Default,Aki,0,0,0,,Tao không muốn mày nghĩ bậy là tao đang giấu mười ngàn cuốn tạp chí khiêu dâm trong đó đâu.
Dialogue: 0,0:13:02.05,0:13:04.22,Default,Oka,0,0,0,,Cháu chưa bao giờ nghĩ bậy như thế cả!
Dialogue: 0,0:13:04.22,0:13:09.18,Default,Aki,0,0,0,,Nghe này. Những thứ cất giữ trong căn nhà kho đó chính là quá khứ của tao và Sanae.
Dialogue: 0,0:13:10.05,0:13:11.81,Default,Aki,0,0,0,,Như những bức ảnh cũ và những cuốn nhật ký.
Dialogue: 0,0:13:12.56,0:13:16.69,Default,Aki,0,0,0,,Nơi đó chứa đựng hình bóng của bọn tao ngày xưa, cái thời còn đang mải mê theo đuổi ước mơ của mình.
Dialogue: 0,0:13:17.06,0:13:19.40,Default,Oka,0,0,0,,Chú không muốn những thứ đó bị phát hiện sao ạ?
Dialogue: 0,0:13:19.40,0:13:20.57,Default,Aki,0,0,0,,Đúng vậy.
Dialogue: 0,0:13:21.07,0:13:24.57,Default,Aki,0,0,0,,Hồi con bé Nagisa còn nhỏ xíu, đã từng xảy ra một biến cố khiến con bé suýt nữa thì mất mạng.
Dialogue: 0,0:13:26.07,0:13:29.37,Default,Aki,0,0,0,,Con bé đã bước một chân vào cửa tử.
Dialogue: 0,0:13:31.20,0:13:33.24,Default,Aki,0,0,0,,Chuyện đó xảy ra cách đây hơn mười năm rồi.
Dialogue: 0,0:13:33.62,0:13:35.66,Default,Aki,0,0,0,,Khi ấy Sanae đang làm giáo viên dạy ở trường cấp hai.
Dialogue: 0,0:13:35.66,0:13:40.21,Default,Aki,0,0,0,,Đó là những tháng ngày bận rộn tối mắt tối mũi, vì tao cuối cùng cũng có cơ hội theo đuổi điều mà tao hằng khao khát.
Dialogue: 0,0:13:40.71,0:13:43.21,Default,Oka,0,0,0,,Điều chú từng muốn làm là gì thế ạ?
Dialogue: 0,0:13:43.21,0:13:45.34,Default,Aki,0,0,0,,Chuyện đó lúc này không quan trọng.
Dialogue: 0,0:13:46.05,0:13:50.09,Default,Aki,0,0,0,,Điều quan trọng là bọn tao khi ấy đã quá mải mê đắm chìm trong thế giới riêng của mình, bởi vì cuối cùng bọn tao cũng có được cơ hội quý giá ấy.
Dialogue: 0,0:13:50.09,0:13:54.39,Default,Aki,0,0,0,,Chính vì thế, bọn tao đã không thể dành nhiều thời gian ở bên cạnh con bé Nagisa.
Dialogue: 0,0:13:56.35,0:13:58.48,Default,Aki,0,0,0,,Một ngày nọ, con bé Nagisa bị sốt cao.
Dialogue: 0,0:13:59.52,0:14:01.56,Default,Aki,0,0,0,,Đó là một ngày mùa đông lạnh giá, tuyết rơi trắng xóa.
Dialogue: 0,0:14:03.36,0:14:04.86,Default,Aki,0,0,0,,Nhà trẻ thì đóng cửa nghỉ.
Dialogue: 0,0:14:04.86,0:14:07.57,Default,Aki,0,0,0,,Bọn tao không tài nào tìm được ai có thể qua trông con bé giúp.
Dialogue: 0,0:14:08.36,0:14:14.20,Default,Aki,0,0,0,,Nhưng đó là những ngày bận rộn sống còn của cả tao lẫn Sanae,
nên bọn tao không thể nào xin nghỉ làm dù chỉ một ngày.
Dialogue: 0,0:14:17.08,0:14:21.38,Default,Aki,0,0,0,,Cơn sốt của con bé lúc đó đang hạ dần, và tao tính sẽ phóng ngay về nhà ngay khi xong việc.
Dialogue: 0,0:14:23.75,0:14:26.84,Default,Aki,0,0,0,,Khoảng thời gian đó chỉ vỏn vẹn chừng hai tiếng đồng hồ thôi.
Dialogue: 0,0:14:28.13,0:14:28.80,Default,Aki,0,0,0,,Thế nhưng...
Dialogue: 0,0:14:32.51,0:14:35.52,Default,Aki,0,0,0,,Con bé Nagisa đã đứng ở ngoài trời tuyết giá lạnh, kiên nhẫn đợi bọn tao trở về.
Dialogue: 0,0:14:36.81,0:14:39.14,Default,Aki,0,0,0,,Tao đã nghĩ đó chính là sự trừng phạt của ông trời.
Dialogue: 0,0:14:39.69,0:14:45.90,Default,Aki,0,0,0,,Tao đã nghĩ ông trời muốn cướp con bé Nagisa đi khỏi tay bọn tao vì cái tội bỏ rơi con gái để mải mê theo đuổi sự nghiệp riêng của mình.
Dialogue: 0,0:14:49.11,0:14:55.33,Default,Aki,0,0,0,,Tao tin chắc có rất nhiều người ngoài kia có thể vừa theo đuổi ước mơ vừa nuôi dạy con cái chu đáo.
Dialogue: 0,0:14:55.91,0:14:57.75,Default,Aki,0,0,0,,Nhưng bọn tao thì bất lực không thể làm được điều đó.
Dialogue: 0,0:15:00.42,0:15:03.67,Default,Aki,0,0,0,,Khoảnh khắc con bé Nagisa tỉnh lại, bọn tao đã cùng lập một lời thề.
Dialogue: 0,0:15:04.04,0:15:06.42,Default,Aki,0,0,0,,Bọn tao đã thề rằng sẽ luôn luôn ở bên cạnh con bé.
Dialogue: 0,0:15:07.26,0:15:09.30,Default,Aki,0,0,0,,Sau đó bọn tao đã từ bỏ công việc cũ và chuyển nghề.
Dialogue: 0,0:15:09.30,0:15:13.43,Default,Aki,0,0,0,,Lý do bọn tao chọn mở tiệm bánh mì là vì
Sanae bảo bả rất tự tin vào tay nghề làm bánh của mình.
Dialogue: 0,0:15:13.43,0:15:15.97,Default,Aki,0,0,0,,Nhưng mày thấy rồi đấy, thành quả làm bánh của bả ra làm sao rồi.
Dialogue: 0,0:15:15.97,0:15:18.93,Default,Aki,0,0,0,,Thế nên tao đã phải tự mình học nghề làm bánh lại từ con số không.
Dialogue: 0,0:15:19.23,0:15:22.23,Default,Aki,0,0,0,,Tao cũng phải gánh một khoản nợ không hề nhỏ,
nên những ngày tháng đó gian nan và vất vả vô cùng.
Dialogue: 0,0:15:22.23,0:15:23.94,Default,Aki,0,0,0,,Nhưng nghĩ lại thì, nó cũng vui ra phết.
Dialogue: 0,0:15:24.44,0:15:27.23,Default,Oka,0,0,0,,Và chú không muốn Nagisa biết được chuyện đó sao ạ?
Dialogue: 0,0:15:27.86,0:15:30.40,Default,Aki,0,0,0,,Bởi vì tao sợ con bé Nagisa sẽ nghĩ quẩn.
Dialogue: 0,0:15:30.40,0:15:34.07,Default,Aki,0,0,0,,Con bé sẽ nghĩ rằng chính vì bản thân nó
mà cả tao lẫn Sanae mới phải từ bỏ ước mơ của mình.
Dialogue: 0,0:15:34.24,0:15:36.20,Default,Nag,0,0,0,,Tớ không dám chắc chắn,
Dialogue: 0,0:15:36.20,0:15:44.71,Default,Nag,0,0,0,,nhưng hồi tớ còn nhỏ xíu, tớ cứ cảm giác như mình đã gây ra một lỗi lầm vô cùng khủng khiếp đối với Bố và Mẹ.
Dialogue: 0,0:15:45.50,0:15:47.80,Default,Aki,0,0,0,,Con bé Nagisa bắt đầu lờ mờ nhận ra điều đó rồi.
Dialogue: 0,0:15:48.63,0:15:51.17,Default,Aki,0,0,0,,Chính vì thế bọn tao mới giấu tiệt toàn bộ ký ức ngày xưa vào trong nhà kho.
Dialogue: 0,0:15:51.93,0:15:56.51,Default,Aki,0,0,0,,Bọn tao vốn có thể đốt sạch hết đi,
nhưng làm thế thì chắc Sanae sẽ khóc ngất mất.
Dialogue: 0,0:15:56.51,0:15:59.10,Default,Oka,0,0,0,,Liệu nói thẳng thắn cho Nagisa biết chẳng phải sẽ tốt hơn sao ạ?
Dialogue: 0,0:15:59.93,0:16:04.69,Default,Oka,0,0,0,,Nếu chú giải thích rõ ràng cho bạn ấy hiểu, cháu nghĩ bạn ấy có đủ sự kiên cường để chấp nhận sự thật mà.
Dialogue: 0,0:16:05.44,0:16:09.98,Default,Aki,0,0,0,,Có thể là vậy, nhưng dù sao đi nữa, nếu đột ngột ném sự thật tàn nhẫn ấy vào mặt con bé thì nó sẽ sốc lắm.
Dialogue: 0,0:16:11.15,0:16:14.70,Default,Aki,0,0,0,,Bởi vậy tao mới đang cố gắng tìm kiếm thời điểm thích hợp nhất để nói cho con bé nghe.
Dialogue: 0,0:16:15.37,0:16:19.29,Default,Aki,0,0,0,,Sự thật lúc ban đầu bao giờ cũng cay đắng và nghiệt ngã cả.
Dialogue: 0,0:16:22.46,0:16:23.75,Default,Aki,0,0,0,,Hơi đường đột một chút, nhưng mà...
Dialogue: 0,0:16:23.75,0:16:25.33,Default,Aki,0,0,0,,...có một câu đố dành cho cả nhà đây!
Dialogue: 0,0:16:25.33,0:16:28.75,Default,Aki,0,0,0,,Ngày mai bố đã lên một kế hoạch bí mật.
Dialogue: 0,0:16:28.75,0:16:30.67,Default,Aki,0,0,0,,Đố cả nhà biết đó là kế hoạch gì nào?
Dialogue: 0,0:16:30.67,0:16:32.22,Default,Aki,0,0,0,,Đáp án 1: Dã ngoại picnic.
Dialogue: 0,0:16:32.22,0:16:33.42,Default,Aki,0,0,0,,Đáp án 2: Co giật kinh phong.
Dialogue: 0,0:16:33.42,0:16:34.55,Default,Aki,0,0,0,,Đáp án 3: Axit Picric.
Dialogue: 0,0:16:34.55,0:16:37.18,Default,Nag,0,0,0,,Con chẳng biết cái lựa chọn cuối cùng là cái gì nữa.
Dialogue: 0,0:16:37.18,0:16:39.76,Default,San,0,0,0,,Có một hóa chất gọi là axit picric đấy con.
Dialogue: 0,0:16:39.76,0:16:42.48,Default,San,0,0,0,,Đó là một hợp chất thơm chứa nhóm nitro.
Dialogue: 0,0:16:42.48,0:16:45.90,Default,Nag,0,0,0,,Ra là vậy ạ. Con lại học thêm được một điều mới rồi.
Dialogue: 0,0:16:45.90,0:16:48.40,Default,Aki,0,0,0,,Nào Nagisa, đáp án là gì nào con gái?
Dialogue: 0,0:16:48.40,0:16:50.65,Default,Nag,0,0,0,,Dạ vâng! Đáp án 1: Đi dã ngoại picnic ạ!
Dialogue: 0,0:16:50.65,0:16:54.15,Default,Aki,0,0,0,,Sai bét! Đáp án chính xác là 2: Co giật kinh phong.
Dialogue: 0,0:16:54.15,0:16:57.12,Default,Aki,0,0,0,,Chính vì thế, ngày mai cả nhà mình sẽ cùng nhau nằm co giật nhé.
Dialogue: 0,0:16:57.12,0:17:00.99,Default,San,0,0,0,,Nagisa ơi, thế thì ngày mai hai mẹ con mình cùng đi dã ngoại nhé con.
Dialogue: 0,0:17:00.99,0:17:01.58,Default,Nag,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:17:01.58,0:17:04.79,Default,Aki,0,0,0,,Khoan đã! Đừng có bỏ rơi anh lại một mình chứ!
Dialogue: 0,0:17:04.79,0:17:10.21,Default,Nag,0,0,0,,Okazaki-san này. Ngày mai tớ có thể tạm quên chuyện diễn kịch để đi chơi xả hơi được không cậu?
Dialogue: 0,0:17:05.58,0:17:08.58,Default-alt,San,0,0,0,,Akio-san, anh cứ ở nhà mà tận hưởng màn co giật một mình đi nhé.
Dialogue: 0,0:17:08.58,0:17:10.21,Default-alt,Aki,0,0,0,,Sanae ơi, anh yêu em nhất trên đời.
Dialogue: 0,0:17:10.21,0:17:13.26,Default,Oka,0,0,0,,Được chứ. Cậu cũng cần thời gian để nghỉ ngơi hồi phục lại sức khỏe mà.
Dialogue: 0,0:17:10.21,0:17:12.21,Default-alt,San,0,0,0,,Vâng, em cũng yêu anh nhiều lắm.
Dialogue: 0,0:17:13.26,0:17:14.30,Default,Nag,0,0,0,,Dạ vâng.
Dialogue: 0,0:17:14.30,0:17:17.80,Default,San,0,0,0,,Okazaki-san, nếu cháu thích ăn món gì thì cứ bảo với cô nhé.
Dialogue: 0,0:17:17.80,0:17:20.10,Default,San,0,0,0,,Cô sẽ làm rồi đóng gói vào hộp bento cho cháu.
Dialogue: 0,0:17:20.10,0:17:21.10,Default,Oka,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:17:21.10,0:17:24.35,Default,Aki,0,0,0,,Bố muốn ăn táo gọt hình tai thỏ cơ.
Dialogue: 0,0:17:24.35,0:17:26.85,Default,Nag,0,0,0,,Bố kì cục ghê, chưa gì bố đã đòi hỏi rồi!
Dialogue: 0,0:17:26.85,0:17:29.31,Default,Nag,0,0,0,,Con yêu cầu món thịt viên hamburger ạ!
Dialogue: 0,0:17:29.31,0:17:30.94,Default,Aki,0,0,0,,Thế thì tao yêu cầu món tôm chiên tempura.
Dialogue: 0,0:17:33.23,0:17:36.45,Default,Oka,0,0,0,,Một gia đình bình thường là phải như thế này sao?
Dialogue: 0,0:17:37.86,0:17:40.53,Default,Oka,0,0,0,,Có lẽ mình không nên đi cùng thì hơn.
Dialogue: 0,0:17:42.74,0:17:45.66,Default,Oka,0,0,0,,Không biết giờ này ông già đang làm gì nhỉ.
Dialogue: 0,0:17:53.30,0:17:54.30,Default,Sun,0,0,0,,Có trộm đột nhập kìa!
Dialogue: 0,0:17:54.67,0:17:56.22,Default,Oka,0,0,0,,Đừng có tự nhiên giật bắn mình như thế chứ.
Dialogue: 0,0:17:56.76,0:17:59.26,Default,Sun,0,0,0,,Okazaki. Sao mày lại ở đây?
Dialogue: 0,0:17:59.55,0:18:00.80,Default,Oka,0,0,0,,Chẳng vì lý do gì cả.
Dialogue: 0,0:18:00.80,0:18:02.81,Default,Oka,0,0,0,,Sao mày dậy sớm thế?
Dialogue: 0,0:18:02.81,0:18:04.81,Default,Sun,0,0,0,,Tao giờ mới chuẩn bị đi ngủ đây này.
Dialogue: 0,0:18:05.31,0:18:07.10,Default,Sun,0,0,0,,Đi dã ngoại picnic à?
Dialogue: 0,0:18:07.10,0:18:09.98,Default,Sun,0,0,0,,Mày nói đúng đấy; chỗ đó thực sự không hợp với mày đâu.
Dialogue: 0,0:18:09.98,0:18:15.23,Default,Oka,0,0,0,,Mày cũng thấy thế đúng không? Có tao ở đó sẽ chỉ phá hỏng chuyến đi của gia đình người ta thôi.
Dialogue: 0,0:18:15.23,0:18:19.11,Default,Sun,0,0,0,,Nhưng mày mà làm cái trò này thì chẳng phải Nagisa-chan sẽ sốc lắm sao?
Dialogue: 0,0:18:19.41,0:18:24.49,Default,Oka,0,0,0,,Tao có để lại mẩu giấy nhắn bảo “Tao có việc bận nên mọi người cứ đi trước đi” rồi mà.
Dialogue: 0,0:18:24.49,0:18:29.83,Default,Sun,0,0,0,,Với cái tính của Nagisa-chan thì con bé sẽ lo sốt vó lên cho xem.
Dialogue: 0,0:18:30.25,0:18:33.92,Default,Sun,0,0,0,,Kiểu như: “Có khi nào nhà mình làm cậu ấy thấy ngột ngạt khó ở không nhỉ?”
Dialogue: 0,0:18:33.92,0:18:38.59,Default,Oka,0,0,0,,Tao tin là cậu ấy không suy nghĩ nhiều đến mức đó chỉ vì một chuyến dã ngoại đâu.
Dialogue: 0,0:18:38.59,0:18:42.39,Default,Sun,0,0,0,,Nagisa-chan lúc nào cũng thiếu tự tin trong mọi chuyện.
Dialogue: 0,0:18:42.39,0:18:43.72,Default,Sun,0,0,0,,Lúc nào cũng thấp thỏm bất an.
Dialogue: 0,0:18:43.72,0:18:45.81,Default,Sun,0,0,0,,Trong mắt tao thì con bé là người như thế đấy.
Dialogue: 0,0:18:46.68,0:18:49.98,Default,Oka,0,0,0,,Mới hôm nọ cậu ấy vừa bảo đã tự tin hơn vào bản thân rồi mà.
Dialogue: 0,0:18:50.65,0:18:53.06,Default,Sun,0,0,0,,Đó là vì có mày ở bên cạnh động viên con bé cơ mà đúng không?
Dialogue: 0,0:18:53.06,0:18:59.24,Default,Sun,0,0,0,,Chính vì có mày ở đó cổ vũ và quát mắng,
con bé mới dám dấn thân thử sức mọi thứ và gầy dựng lại sự tự tin đấy.
Dialogue: 0,0:18:59.86,0:19:00.99,Default,Oka,0,0,0,,Đó là một điều tốt mà.
Dialogue: 0,0:19:00.99,0:19:03.95,Default,Sun,0,0,0,,Ý tao chính là chỗ đó đấy!
Dialogue: 0,0:19:03.95,0:19:05.99,Default,Sun,0,0,0,,Thử suy nghĩ cho kỹ mà xem.
Dialogue: 0,0:19:05.99,0:19:08.70,Default,Sun,0,0,0,,Con bé có được sự tự tin là nhờ có mày.
Dialogue: 0,0:19:08.70,0:19:13.63,Default,Sun,0,0,0,,Thế nhưng nếu mày quay lưng trốn chạy khỏi con bé,
thì bao nhiêu sự tự tin con bé dày công xây dựng sẽ trôi về đâu hả?!
Dialogue: 0,0:19:14.13,0:19:18.13,Default,Sun,0,0,0,,Nagisa-chan không hề biết rõ trong mắt mày con bé là người thế nào đâu.
Dialogue: 0,0:19:18.76,0:19:22.72,Default,Sun,0,0,0,,Chính cái thái độ lấp lửng ba phải không dứt khoát của mày đang giam cầm con bé Nagisa-chan đấy.
Dialogue: 0,0:19:23.76,0:19:28.18,Default,Sun,0,0,0,,Mày vừa trốn chạy khỏi nhà của mày,
và giờ đây mày lại tiếp tục trốn chạy khỏi nhà của người ta nữa!
Dialogue: 0,0:19:28.18,0:19:31.02,Default,Sun,0,0,0,,Mày kéo sang đây tị nạn chỉ tổ làm phiền tao thôi.
Dialogue: 0,0:19:31.02,0:19:36.32,Default,Sun,0,0,0,,Cơ mà nếu mày nhất quyết từ chối thì để tao đi dã ngoại thay cho mày nhé.
Dialogue: 0,0:19:36.69,0:19:40.90,Default,Sun,0,0,0,,Biết đâu chừng tình yêu giữa tao với ẻm lại chớm nở từ cơ hội này thì sao.
Dialogue: 0,0:19:42.74,0:19:43.61,Default,Oka,0,0,0,,Tao về đây.
Dialogue: 0,0:19:44.49,0:19:45.53,Default,Oka,0,0,0,,Xin lỗi vì đã làm phiền mày nhé.
Dialogue: 0,0:19:51.50,0:19:52.92,Default,Sun,0,0,0,,Thôi tao đi ngủ đây.
Dialogue: 0,0:19:57.09,0:19:58.09,Default,Oka,0,0,0,,Nagisa!
Dialogue: 0,0:19:59.92,0:20:00.97,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:20:00.97,0:20:02.84,Default,Nag,0,0,0,,Tớ đã đi tìm cậu khắp nơi đấy.
Dialogue: 0,0:20:02.84,0:20:04.80,Default,Oka,0,0,0,,Cậu không đọc mẩu thư tớ để lại sao?
Dialogue: 0,0:20:04.80,0:20:07.18,Default,Nag,0,0,0,,Dạ không, tớ chẳng biết gì về bức thư nào cả.
Dialogue: 0,0:20:07.18,0:20:10.56,Default,San,0,0,0,,May quá, Okazaki-san. Bọn cô đang đợi cháu mãi đấy.
Dialogue: 0,0:20:10.93,0:20:13.06,Default,Oka,0,0,0,,Dạ... mọi người không thấy bức thư cháu để lại sao ạ?
Dialogue: 0,0:20:13.90,0:20:17.06,Default,Aki,0,0,0,,Tao nuốt trọn nó làm món ăn kèm cho bữa sáng rồi con ạ.
Dialogue: 0,0:20:17.06,0:20:17.94,Default,Oka,0,0,0,,Chú già này thật là...
Dialogue: 0,0:20:18.65,0:20:21.44,Default,Aki,0,0,0,,Tầm này rồi thì chẳng kịp đi đâu xa nữa rồi.
Dialogue: 0,0:20:21.44,0:20:22.57,Default,Oka,0,0,0,,Cháu xin lỗi hai bác.
Dialogue: 0,0:20:22.95,0:20:23.45,Default,Oka,0,0,0,,Cháu thật lòng xin—
Dialogue: 0,0:20:23.45,0:20:26.45,Default,Aki,0,0,0,,Bọn tao không đi dã ngoại được là tại vì mày đấy nhé.
Dialogue: 0,0:20:26.45,0:20:28.20,Default,Aki,0,0,0,,Nên mày phải có trách nhiệm ở lại đây chơi với bọn tao!
Dialogue: 0,0:20:28.20,0:20:29.12,Default,Oka,0,0,0,,Dạ?
Dialogue: 0,0:20:35.29,0:20:37.17,Default,Aki,0,0,0,,Hôm nay tao toàn tung ra mấy cú đánh bóng đỉnh cao thôi.
Dialogue: 0,0:20:37.17,0:20:38.67,Default,Aki,0,0,0,,Em có nhìn thấy không hả Sanae?!
Dialogue: 0,0:20:38.67,0:20:40.67,Default,San,0,0,0,,Dạ có chứ. Em đã nhìn thấy rất rõ ràng mà.
Dialogue: 0,0:20:40.67,0:20:41.88,Default,Aki,0,0,0,,Em lại vừa rơi vào lưới tình với anh lần nữa rồi đúng không?
Dialogue: 0,0:20:41.88,0:20:42.67,Default,San,0,0,0,,Dạ vâng.
Dialogue: 0,0:20:42.67,0:20:45.30,Default,San,0,0,0,,Anh Akio lúc nào cũng tuyệt vời nhất trần đời.
Dialogue: 0,0:20:45.30,0:20:46.39,Default,Aki,0,0,0,,Chuyện, anh mà lị!
Dialogue: 0,0:20:47.60,0:20:50.64,Default,Oka,0,0,0,,Tụi mình đâu cần phải cất công ra tận bãi cỏ trải bạt thế này đâu nhỉ?
Dialogue: 0,0:20:50.64,0:20:51.85,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:20:51.85,0:20:54.56,Default,Nag,0,0,0,,Hộp bento này tớ cũng có phụ giúp làm một tay đấy ạ.
Dialogue: 0,0:20:54.85,0:20:56.23,Default,Nag,0,0,0,,Cậu ăn thử một chút đi.
Dialogue: 0,0:20:56.23,0:20:56.94,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:21:02.07,0:21:02.82,Default,Oka,0,0,0,,Ngon lắm.
Dialogue: 0,0:21:03.78,0:21:05.15,Default,Nag,0,0,0,,Nghe cậu khen thế là tớ vui rồi.
Dialogue: 0,0:21:05.15,0:21:05.66,Default,Aki,0,0,0,,Thằng ranh con kia!
Dialogue: 0,0:21:05.66,0:21:07.66,Default,Aki,0,0,0,,Đến lượt mày lên đánh bóng rồi đấy!
Dialogue: 0,0:21:07.66,0:21:09.70,Default,Aki,0,0,0,,Mau vào vị trí đập bóng nhanh lên coi!
Dialogue: 0,0:21:09.70,0:21:10.99,Default,Oka,0,0,0,,Được rồi, vào ngay đây!
Dialogue: 0,0:21:11.95,0:21:13.91,Default,Oka,0,0,0,,Tớ ra sân đây nhé.
Dialogue: 0,0:21:13.91,0:21:15.79,Default,Nag,0,0,0,,Dạ vâng. Cậu cố lên nhé.
Dialogue: 0,0:21:17.96,0:21:19.67,Default,Oka,0,0,0,,Cái vai này của mình liệu có vung gậy đánh bóng nổi không đây?
Dialogue: 0,0:21:21.71,0:21:23.97,Default,Aki,0,0,0,,Được lắm! Cú đánh đẹp lắm thằng ranh con!
Dialogue: 0,0:21:24.88,0:21:26.38,Default,Oka,0,0,0,,Cậu có nhìn thấy không hả Nagisa?!
Dialogue: 0,0:21:26.38,0:21:28.76,Default,Nag,0,0,0,,Dạ có, tớ nhìn thấy rất rõ ràng luôn!
Dialogue: 0,0:21:28.76,0:21:30.26,Default,Aki,0,0,0,,Con gái lại vừa rơi vào lưới tình với nó lần nữa rồi đúng không?!
Dialogue: 0,0:21:30.26,0:21:31.06,Default,Nag,0,0,0,,Dạ vâng—
Dialogue: 0,0:21:31.06,0:21:32.39,Default,Nag,0,0,0,,B-Bố kì quá à?!
Dialogue: 0,0:21:33.39,0:21:37.40,Default,Aki,0,0,0,,Khốn kiếp thật! Hóa ra con bé mê mệt thằng ranh này thật đấy à?!
Dialogue: 0,0:21:41.82,0:21:44.65,Default,Aki,0,0,0,,Này Nagisa! Đến lượt con lên đánh bóng rồi đấy!
Dialogue: 0,0:21:44.65,0:21:46.45,Default,Aki,0,0,0,,Con cũng phải đánh bóng nữa sao ạ?
Dialogue: 0,0:21:44.65,0:21:46.45,Default-alt,Nag,0,0,0,,Mau nhấc mông lên!
Dialogue: 0,0:21:46.45,0:21:49.87,Default,Kid,0,0,0,,Chị gái ơi cố lên nhé!
Dialogue: 0,0:21:47.49,0:21:48.74,Default-alt,Oka,0,0,0,,Cậu làm được mà, Nagisa.
Dialogue: 0,0:21:55.00,0:21:56.50,Default,Oka,0,0,0,,Tốt lắm, Nagisa!
Dialogue: 0,0:21:57.25,0:21:58.12,Default,Nag,0,0,0,,Dạ vâng!
Dialogue: 0,0:21:58.50,0:22:00.04,Default,Oka,0,0,0,,Chạy mau đi Nagisa ơi!
Dialogue: 0,0:22:00.75,0:22:01.54,Default,Nag,0,0,0,,Dạ vâng ạ!
