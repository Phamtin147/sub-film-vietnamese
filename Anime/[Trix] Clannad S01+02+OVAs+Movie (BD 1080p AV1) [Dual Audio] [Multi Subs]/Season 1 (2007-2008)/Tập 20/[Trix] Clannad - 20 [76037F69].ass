Dialogue: 0,0:00:00.00,0:00:10.92,Default,,0,0,0,,
Dialogue: 0,0:00:10.73,0:00:11.82,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:00:12.28,0:00:13.82,Default,Nag,0,0,0,,Có chuyện gì thế cậu?
Dialogue: 0,0:00:13.82,0:00:16.45,Default,Oka,0,0,0,,Không thấy cậu đâu nên tớ mới ra ngoài tìm xem sao.
Dialogue: 0,0:00:16.91,0:00:20.58,Default,Oka,0,0,0,,Tối nào cậu cũng ra đây luyện tập một mình thế này à?
Dialogue: 0,0:00:20.58,0:00:21.95,Default,Nag,0,0,0,,Chỉ thỉnh thoảng thôi ạ.
Dialogue: 0,0:00:21.95,0:00:26.04,Default,Nag,0,0,0,,Ra đây thì dù tớ có lỡ lớn tiếng một chút cũng không làm phiền hàng xóm xung quanh.
Dialogue: 0,0:00:27.58,0:00:29.75,Default,Oka,0,0,0,,Cậu nên cẩn thận hơn chút đi.
Dialogue: 0,0:00:29.75,0:00:32.21,Default,Oka,0,0,0,,Con gái con lứa đêm hôm khuya khoắt
một mình ở ngoài đường thế này nguy hiểm lắm.
Dialogue: 0,0:00:32.21,0:00:35.13,Default,Nag,0,0,0,,Không sao đâu mà.
Dialogue: 0,0:00:35.13,0:00:37.85,Default,Nag,0,0,0,,Ở ngay trước cửa nhà tớ mà,
chỉ cần tớ gọi to một tiếng là Bố sẽ phóng ra ngay.
Dialogue: 0,0:00:38.30,0:00:40.64,Default,Oka,0,0,0,,Trông cậu chậm chạp thế kia làm tớ thấy lo đấy.
Dialogue: 0,0:00:42.10,0:00:44.39,Default,Nag,0,0,0,,Trông tớ chậm chạp lắm sao?
Dialogue: 0,0:00:44.39,0:00:46.06,Default,Oka,0,0,0,,Từ trước đến giờ cậu chưa từng nhận ra điều đó à?
Dialogue: 0,0:00:46.48,0:00:47.81,Default,Nag,0,0,0,,Sốc quá đi mất.
Dialogue: 0,0:00:49.94,0:00:52.94,Default,Oka,0,0,0,,Cậu đừng có dễ suy sụp tinh thần như thế chứ.
Dialogue: 0,0:00:55.11,0:00:56.49,Default,Nag,0,0,0,,Tớ chỉ đùa một chút với cậu thôi mà.
Dialogue: 0,0:00:56.49,0:00:59.32,Default,Nag,0,0,0,,Tớ quen với việc cậu hay châm chọc tớ rồi.
Dialogue: 0,0:00:59.32,0:01:02.24,Default,Oka,0,0,0,,Đừng có làm quen với cái thói xấu đó chứ.
Dialogue: 0,0:01:02.58,0:01:05.25,Default,Oka,0,0,0,,Xin lỗi vì cái mồm tớ ăn nói cay độc quá nhé.
Dialogue: 0,0:01:05.25,0:01:09.33,Default,Nag,0,0,0,,Không sao đâu ạ. Phải như thế thì mới đúng là Okazaki-san chứ.
Dialogue: 0,0:01:11.59,0:01:12.17,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:01:12.84,0:01:13.80,Default,Oka,0,0,0,,Được rồi.
Dialogue: 0,0:01:15.92,0:01:18.22,Default,Oka,0,0,0,,Cậu đã nhớ thêm được chút gì về vở kịch mà cậu muốn diễn chưa?
Dialogue: 0,0:01:18.84,0:01:24.10,Default,Nag,0,0,0,,Tớ vẫn chưa nhớ ra tên của nó là gì,
nhưng đó là một câu chuyện tớ từng được nghe kể hồi còn nhỏ.
Dialogue: 0,0:01:24.10,0:01:25.68,Default,Oka,0,0,0,,Câu chuyện đó kể về điều gì?
Dialogue: 0,0:01:29.98,0:01:34.69,Default,Nag,0,0,0,,Đó là câu chuyện về một cô bé đơn độc trơ trọi giữa một thế giới đã lụi tàn.
Dialogue: 0,0:01:35.69,0:01:38.57,Default,Nag,0,0,0,,Đó là một câu chuyện vô cùng, vô cùng buồn...
Dialogue: 0,0:01:39.32,0:01:42.08,Default,Nag,0,0,0,,...một câu chuyện khúc ảo tưởng mùa đông.
