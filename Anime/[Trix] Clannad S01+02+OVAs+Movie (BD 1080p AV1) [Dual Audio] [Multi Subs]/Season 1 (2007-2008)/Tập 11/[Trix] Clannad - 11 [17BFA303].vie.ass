Dialogue: 0,0:00:00.00,0:00:01.85,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:00.00,Default,Nag,0,0,0,,
Dialogue: 0,0:00:01.60,0:00:02.85,Default,Kot,0,0,0,,Tomoya-kun.
Dialogue: 0,0:00:03.35,0:00:04.52,Default,Kot,0,0,0,,Tomoya-kun ơi?
Dialogue: 0,0:00:05.19,0:00:06.48,Default,Kot,0,0,0,,Tomoya-kun.
Dialogue: 0,0:00:06.81,0:00:08.15,Default,Kot,0,0,0,,Tomoya-kun!
Dialogue: 0,0:00:13.03,0:00:13.99,Default,Kot,0,0,0,,Hay quá đi.
Dialogue: 0,0:00:14.99,0:00:17.74,Default,Oka,0,0,0,,K-Kotomi...
Dialogue: 0,0:00:18.20,0:00:20.66,Default,Kot,0,0,0,,Chào cậu, Tomoya-kun.
Dialogue: 0,0:00:20.66,0:00:22.20,Default,Oka,0,0,0,,Đừng có đứng đó "chào cậu" ngọt xớt thế chứ.
Dialogue: 0,0:00:22.20,0:00:23.29,Default,Kot,0,0,0,,Thế thì...
Dialogue: 0,0:00:23.75,0:00:25.29,Default,Kot,0,0,0,,Dạo này cậu có khỏe không?
Dialogue: 0,0:00:25.67,0:00:29.29,Default,Oka,0,0,0,,Trời ạ... Người ta đang ngủ ngon giấc thế mà...
Dialogue: 0,0:00:29.29,0:00:32.21,Default,Kot,0,0,0,,Nên mình đã chơi một khúc hát ru đấy.
Dialogue: 0,0:00:32.21,0:00:34.22,Default,Oka,0,0,0,,Sốc đến mức suýt nữa thì tôi chìm vào giấc ngủ ngàn thu luôn rồi!
Dialogue: 0,0:00:34.22,0:00:36.51,Default,Guy,0,0,0,,Okazaki! Ai thế này?
Dialogue: 0,0:00:36.51,0:00:38.30,Default,Guy,0,0,0,,Bạn của mày à?
Dialogue: 0,0:00:42.73,0:00:45.44,Default,Kot,0,0,0,,Xin chào. Rất vui được gặp bạn.
Dialogue: 0,0:00:45.44,0:00:48.69,Default,Kot,0,0,0,,Tên mình là Ichinose Kotomi. Học sinh năm ba Lớp A.
Dialogue: 0,0:00:48.69,0:00:50.32,Default,Kot,0,0,0,,Sở thích của mình là đọc sách.
Dialogue: 0,0:00:50.32,0:00:52.28,Default,Oka,0,0,0,,Còn vũ khí của nhỏ là cây vĩ cầm.
Dialogue: 0,0:00:52.28,0:00:55.20,Default,Oka,0,0,0,,Phát ra sóng âm hủy diệt chỉ 0,2 giây sau khi vào tư thế.
Dialogue: 0,0:00:55.20,0:00:56.70,Default,Oka,0,0,0,,Số người bị nhỏ hạ gục đếm không xuể đâu.
Dialogue: 0,0:00:59.45,0:01:04.20,Default,Kot,0,0,0,,Mình chưa bao giờ hạ gục ai bằng vĩ cầm cả.
Dialogue: 0,0:01:05.50,0:01:06.83,Default,Guy,0,0,0,,M-Màng nhĩ của tao...
Dialogue: 0,0:01:06.83,0:01:08.58,Default,Oka,0,0,0,,Cậu có thấy hai đứa tôi đang nằm đo đất ở đây không hả?
Dialogue: 0,0:01:08.58,0:01:11.38,Default,Kyo,0,0,0,,Này! Kotomi! Cậu nghĩ cậu đang làm cái trò gì thế hả?
Dialogue: 0,0:01:11.38,0:01:12.55,Default,Ryo,0,0,0,,Kotomi-chan?
Dialogue: 0,0:01:12.55,0:01:15.34,Default,Nag,0,0,0,,Hóa ra là Kotomi-chan.
Dialogue: 0,0:01:15.34,0:01:18.72,Default,Kot,0,0,0,,Kyou-chan, Ryou-chan, Nagisa-chan.
Dialogue: 0,0:01:18.72,0:01:20.68,Default,Kot,0,0,0,,Xin chào tất cả các cậu nhé.
Dialogue: 0,0:01:20.68,0:01:22.22,Default,Kyo,0,0,0,,Đừng có "xin chào" tôi!
Dialogue: 0,0:01:22.97,0:01:24.14,Default,Kot,0,0,0,,Bonjour nhé?
Dialogue: 0,0:01:24.14,0:01:26.35,Default,Kyo,0,0,0,,Không phải!
Dialogue: 0,0:01:27.98,0:01:32.07,Default,Kot,0,0,0,,Boong-giua nhé?
Dialogue: 0,0:01:32.07,0:01:35.69,Default,Kyo,0,0,0,,Sao tôi không thể giao tiếp bình thường với nhỏ này được vậy nè?
Dialogue: 0,0:01:35.69,0:01:38.53,Default,Nag,0,0,0,,Trước hết cậu hãy bình tĩnh lại đã, Kyou-chan.
Dialogue: 0,0:01:38.53,0:01:41.37,Default,Oka,0,0,0,,Cậu ấy nói đúng đấy. Cậu mà bị cuốn vào nhịp độ của cậu ấy là thua đấy.
Dialogue: 0,0:01:41.37,0:01:42.95,Default,Kyo,0,0,0,,Tôi biết rồi mà!
Dialogue: 0,0:01:46.29,0:01:48.42,Default,Kyo,0,0,0,,Cậu làm gì ở đây thế?
Dialogue: 0,0:01:48.87,0:01:50.71,Default,Kot,0,0,0,,Chơi vĩ cầm.
Dialogue: 0,0:01:51.54,0:01:54.25,Default,Kyo,0,0,0,,Đó là cây đàn ở trong phòng âm nhạc đúng không?
Dialogue: 0,0:01:55.05,0:01:57.34,Default,Kot,0,0,0,,Họ cho mình mượn đấy.
Dialogue: 0,0:01:57.63,0:02:01.64,Default,Kot,0,0,0,,Các bạn ấy bảo: "Nếu bạn thích đến thế,\Nbạn có muốn mượn chơi một thời gian không?"
Dialogue: 0,0:02:01.64,0:02:03.10,Default,Oka,0,0,0,,Phiền phức thật sự.
Dialogue: 0,0:02:03.10,0:02:04.52,Default,Kot,0,0,0,,Xin phép cho mình chơi bản nhạc tiếp theo nhé.
Dialogue: 0,0:02:04.52,0:02:05.97,Default,All,0,0,0,,Cậu không cần phải chơi đâu!
