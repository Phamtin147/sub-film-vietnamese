Dialogue: 0,0:00:00.00,0:18:21.79,Default,,0,0,0,,
Dialogue: 0,0:00:03.23,0:00:06.02,Default,Oka,0,0,0,,Vậy ra, chúng ta đã từng gặp nhau...
Dialogue: 0,0:00:06.02,0:00:07.48,Default,Oka,0,0,0,,...từ khi còn là những đứa trẻ.
Dialogue: 0,0:00:10.11,0:00:13.03,Default,Oka,0,0,0,,Cậu đã biết tớ là ai ngay từ đầu rồi đúng không?
Dialogue: 0,0:00:13.03,0:00:14.91,Default,Oka,0,0,0,,Sao cậu không nói cho tớ biết?
Dialogue: 0,0:00:14.91,0:00:21.50,Default,Kot,0,0,0,,Lúc cậu bước vào thư viện, mình thực sự rất hạnh phúc.
Dialogue: 0,0:00:21.95,0:00:25.87,Default,Kot,0,0,0,,Mình vui sướng khôn xiết khi thấy cậu bé\Nnăm xưa ấy đã quay trở lại bên mình.
Dialogue: 0,0:00:26.67,0:00:31.84,Default,Kot,0,0,0,,Nhưng rồi mình sớm nhận ra cậu chẳng còn nhớ gì về mình cả.
Dialogue: 0,0:00:32.42,0:00:36.39,Default,Kot,0,0,0,,Thế nhưng, cậu lại kết bạn với mình thêm một lần nữa.
Dialogue: 0,0:00:36.80,0:00:40.31,Default,Kot,0,0,0,,Cậu đối xử với mình dịu dàng hệt như với một người bạn gái mới quen lần đầu.
Dialogue: 0,0:00:40.81,0:00:43.77,Default,Kot,0,0,0,,Cậu giới thiệu cho mình biết bao nhiêu người bạn tốt.
Dialogue: 0,0:00:45.60,0:00:47.15,Default,Kot,0,0,0,,Thế rồi lòng mình lại rối bời mất phương hướng.
Dialogue: 0,0:00:47.94,0:00:52.61,Default,Kot,0,0,0,,Mình không biết liệu mình muốn cậu nhớ lại\Nhay cứ mãi vô tư không hay biết...
Dialogue: 0,0:00:53.94,0:00:56.07,Default,Kot,0,0,0,,...về hình ảnh của mình năm xưa ấy.
