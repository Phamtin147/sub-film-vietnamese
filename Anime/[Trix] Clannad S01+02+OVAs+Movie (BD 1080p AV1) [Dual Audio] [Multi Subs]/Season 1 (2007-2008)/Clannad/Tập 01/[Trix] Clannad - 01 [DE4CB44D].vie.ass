Dialogue: 0,0:23:40.56,0:23:43.52,Default,Sun,0,0,0,,Okazaki, hôm nay cúp học đi mày.
Dialogue: 0,0:23:43.52,0:23:45.77,Default,Sun,0,0,0,,Đằng nào hôm nay cũng là thứ Bảy, chỉ học có nửa buổi thôi mà.
Dialogue: 0,0:23:48.98,0:23:52.61,Default,Nag,0,0,0,,Tớ sẽ dọn dẹp xong ngay thôi, nên cậu cứ đợi ở phòng câu lạc bộ nhé.
Dialogue: 0,0:23:54.45,0:23:55.49,Default,Kyo,0,0,0,,Được rồi.
Dialogue: 0,0:23:55.49,0:23:57.12,Default,Kyo,0,0,0,,Không bị móp méo gì.
Dialogue: 0,0:23:57.12,0:23:58.99,Default,Kyo,0,0,0,,Tôi sẽ tha cho cậu không phải đền tiền sửa xe đấy.
Dialogue: 0,0:23:58.99,0:24:00.41,Default,Fuk,0,0,0,,Fuko làm xong rồi này!
Dialogue: 0,0:24:02.50,0:24:04.08,Default,Tom,0,0,0,,Thôi khỏi đi.
Dialogue: 0,0:24:04.08,0:24:05.25,Default,Tom,0,0,0,,Cứ coi như tôi chưa nói gì đi nhé.
