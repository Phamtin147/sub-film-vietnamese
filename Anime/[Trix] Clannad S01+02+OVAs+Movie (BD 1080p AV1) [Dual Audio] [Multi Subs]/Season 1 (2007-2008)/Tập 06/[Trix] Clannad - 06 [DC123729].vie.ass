Dialogue: 0,0:00:00.68,0:00:03.19,Default,San,0,0,0,,Chào buổi sáng cháu nhé, Okazaki-san.
Dialogue: 0,0:00:03.19,0:00:03.98,Default,San,0,0,0,,Cháu nhìn thử xem này.
Dialogue: 0,0:00:03.98,0:00:05.81,Default,San,0,0,0,,Sản phẩm mới nhất của cô đấy.
Dialogue: 0,0:00:07.94,0:00:10.48,Default,Oka,0,0,0,,K-Không lẽ đây là...
Dialogue: 0,0:00:10.48,0:00:14.15,Default,San,0,0,0,,Là bánh mì sao biển cô dành cả kỳ nghỉ Tuần Lễ Vàng để sáng chế đấy.
Dialogue: 0,0:00:14.15,0:00:18.78,Default,San,0,0,0,,Tất cả bánh mì kem và bánh mì mứt đều nặn theo hình này hết.
Dialogue: 0,0:00:18.78,0:00:20.54,Default,San,0,0,0,,Cháu thấy thế nào?
Dialogue: 0,0:00:20.54,0:00:22.04,Default,Oka,0,0,0,,Cháu thấy dở tệ hại luôn ạ.
Dialogue: 0,0:00:22.58,0:00:25.71,Default,San,0,0,0,,Cháu phản ứng y hệt như Akio-san vậy.
Dialogue: 0,0:00:25.71,0:00:26.79,Default,Oka,0,0,0,,Thế ông chú đâu rồi ạ?
Dialogue: 0,0:00:26.79,0:00:30.13,Default,San,0,0,0,,Vừa thấy mẻ bánh này ra lò là anh ấy chuồn thẳng khỏi tiệm luôn rồi.
Dialogue: 0,0:00:30.46,0:00:34.55,Default,San,0,0,0,,Lời trăng trối cuối cùng của anh ấy là: 'Sanae, em là người đáng yêu nhất trần đời.'
Dialogue: 0,0:00:34.55,0:00:38.76,Default,San,0,0,0,,'Nhưng mà bánh mì em làm thì kinh khủng khiếp lắm!'
Dialogue: 0,0:00:38.76,0:00:41.77,Default,San,0,0,0,,Mới nãy cô vừa khóc nức nở xong,
Dialogue: 0,0:00:42.27,0:00:46.10,Default,San,0,0,0,,nhưng cô tự nhủ từ giờ phải tự thân vận động một mình, nên cô đã gượng dậy được rồi.
Dialogue: 0,0:00:46.10,0:00:49.44,Default,San,0,0,0,,Vì thế, Okazaki-san, cháu có muốn ăn thử một cái không?
Dialogue: 0,0:00:49.44,0:00:50.44,Default,Oka,0,0,0,,Cháu xin kiễng ạ.
Dialogue: 0,0:00:50.44,0:00:54.15,Default,San,0,0,0,,Akio-san ơi, một mình em không cáng đáng nổi đâu...
Dialogue: 0,0:00:54.15,0:00:56.03,Default,Oka,0,0,0,,Nhận thức ra thực tế nhanh ghê.
Dialogue: 0,0:00:57.07,0:01:03.00,OP English,,0,0,0,,{\fad(250,250)\be1}Tôi từng thấy một giấc mơ trong vắt,
