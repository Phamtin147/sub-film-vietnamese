Dialogue: 0,0:02:26.16,0:02:29.83,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410)\3c&H4A8A5C&}Tập 6
Dialogue: 0,0:02:26.16,0:02:29.83,Signs,,0,0,0,,{\an5\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Lễ Hội Trường Của Hai Chị Em
Dialogue: 0,0:02:29.83,0:02:32.92,Default,San,0,0,0,,Cô đi tìm Akio-san đây.
Dialogue: 0,0:02:33.63,0:02:36.42,Default,San,0,0,0,,Nagisa với Fuuko-chan đang ở bên trong đấy.
Dialogue: 0,0:02:39.01,0:02:41.76,Default,Nag,0,0,0,,Chào buổi sáng cậu nhé, Okazaki-san.
Dialogue: 0,0:02:41.76,0:02:43.72,Default,Fuk,0,0,0,,Sanae-san đâu rồi ạ?
Dialogue: 0,0:02:43.72,0:02:45.60,Default,Fuk,0,0,0,,Vừa nãy có điện thoại gọi cho cô ấy.
Dialogue: 0,0:02:45.60,0:02:47.39,Default,Oka,0,0,0,,Bác ấy đi tìm ông chú rồi.
Dialogue: 0,0:02:47.39,0:02:48.98,Default,Oka,0,0,0,,Điện thoại nói gì thế?
Dialogue: 0,0:02:48.98,0:02:54.48,Default,Fuk,0,0,0,,Sau một tràng thở hồng hộc, đầu dây bên kia cứ lặp đi lặp lại 'Anh yêu em'.
Dialogue: 0,0:02:54.48,0:02:56.82,Default,Oka,0,0,0,,Nghe như trò quấy rối qua điện thoại ấy nhỉ?
Dialogue: 0,0:02:56.82,0:03:00.61,Default,Fuk,0,0,0,,Nhưng bác ấy rất nghiêm túc van xin Sanae đừng làm bánh mì sao biển nữa.
Dialogue: 0,0:03:00.61,0:03:01.74,Default,Oka,0,0,0,,À, đúng là ông già rồi.
Dialogue: 0,0:03:02.20,0:03:06.54,Default,Nag,0,0,0,,Lúc Fuu-chan bảo con bé đang nghe máy, bố liền thét lên một tiếng rồi cúp rụp luôn.
Dialogue: 0,0:03:06.54,0:03:10.08,Default,Oka,0,0,0,,Đương nhiên rồi, tự nhiên lại đi tỏ tình với bạn của con gái mình cơ mà.
Dialogue: 0,0:03:11.33,0:03:13.21,Default,Oka,0,0,0,,Đ-Đây là...!
Dialogue: 0,0:03:13.67,0:03:16.17,Default,Oka,0,0,0,,Là kết giới phong ấn Fuko!
Dialogue: 0,0:03:16.17,0:03:17.46,Default,Nag,0,0,0,,Cậu đang nói nhảm gì thế?
Dialogue: 0,0:03:17.46,0:03:22.26,Default,Oka,0,0,0,,Cậu nhìn xem, vừa hoàn hồn lại là tầm mắt con bé ngập tràn sao biển.
Dialogue: 0,0:03:22.63,0:03:26.18,Default,Oka,0,0,0,,Thế là hồn nó lại bay đi chu du cõi khác tiếp.
Dialogue: 0,0:03:26.81,0:03:30.73,Default,Oka,0,0,0,,Nếu bọn mình không làm gì, phong ấn của Fuko sẽ không bao giờ được giải trừ.
Dialogue: 0,0:03:30.73,0:03:31.60,Default,Oka,0,0,0,,Và rồi—
Dialogue: 0,0:03:32.77,0:03:35.15,Default,Oka,0,0,0,,Vài trăm năm sau trong tương lai,
Dialogue: 0,0:03:35.15,0:03:38.32,Default,Oka,0,0,0,,vào cái thời đại mà nhân loại tiến hóa thống trị con người bình thường,
Dialogue: 0,0:03:39.61,0:03:44.03,Default,Oka,0,0,0,,một lữ khách tìm đến tàn tích của gia đình Furukawa.
Dialogue: 0,0:03:51.25,0:03:53.37,Default,Oka,0,0,0,,Hỡi bậc thầy điều khiển sao biển huyền thoại.
Dialogue: 0,0:03:53.37,0:03:56.13,Default,Oka,0,0,0,,Xin hãy ban cho ta sức mạnh.
Dialogue: 0,0:03:57.63,0:03:59.59,Default,Oka,0,0,0,,Hiện thân đi, Fuuko!
Dialogue: 0,0:04:05.05,0:04:06.39,Signs,,0,0,0,,{\fs50\fad(500,0)\pos(960,900)}Khi phong ấn được phá vỡ
Dialogue: 0,0:04:07.43,0:04:09.31,Signs,,0,0,0,,{\an7\fs50\fad(300,0)\pos(1036,632)}Một bóng hình hiện ra\N trước mắt ta
Dialogue: 0,0:04:11.43,0:04:13.52,Signs,,0,0,0,,{\an7\fs50\fad(300,0)\pos(428,205)}Liệu đó là Thần Thánh
Dialogue: 0,0:04:11.43,0:04:13.52,Signs,,0,0,0,,{\an7\fs50\fad(300,0)\pos(1204,828)}hay là Ác Ma
Dialogue: 0,0:04:17.52,0:04:19.23,Default,Oka,0,0,0,,Tôi chẳng tưởng tượng nổi cuốn sách này bán được cho ai.
Dialogue: 0,0:04:19.23,0:04:22.07,Default,Nag,0,0,0,,Không đâu, tớ thấy ly kỳ hấp dẫn lắm.
Dialogue: 0,0:04:22.07,0:04:24.28,Default,Nag,0,0,0,,Tớ muốn nghe đoạn tiếp theo cơ.
Dialogue: 0,0:04:24.28,0:04:25.45,Default,Oka,0,0,0,,Tôi chỉ nói đùa thôi mà.
Dialogue: 0,0:04:25.45,0:04:29.12,Default,Oka,0,0,0,,Nhưng nếu cứ mặc kệ con bé, e rằng chuyện chẳng dừng lại ở mức đùa đâu.
Dialogue: 0,0:04:33.04,0:04:34.87,Default,Nag,0,0,0,,Okazaki-san, cậu định làm...
Dialogue: 0,0:04:34.87,0:04:36.25,Default,Oka,0,0,0,,Tí nữa tôi trả tiền sau.
Dialogue: 0,0:04:36.25,0:04:38.67,Default,Nag,0,0,0,,Không, ý tớ đâu phải chuyện đó.
Dialogue: 0,0:04:38.67,0:04:40.96,Default,Oka,0,0,0,,Hôm nọ tôi bắn trượt rồi, hôm nay phải phục thù mới được.
Dialogue: 0,0:04:48.14,0:04:49.97,Default,Fuk,0,0,0,,Mũi của Fuko vừa cảm thấy có gì đó lạ lẫm lắm.
Dialogue: 0,0:04:49.97,0:04:51.56,Default,Oka,0,0,0,,Thế à? Kỳ bí ghê nhỉ.
Dialogue: 0,0:04:52.10,0:04:54.48,Default,Fuk,0,0,0,,Mà chẳng hiểu sao Fuko lại hết khát nước luôn rồi.
Dialogue: 0,0:04:54.48,0:04:57.02,Default,Oka,0,0,0,,Ngon lành, lần này thành công rực rỡ!
Dialogue: 0,0:04:55.14,0:04:58.19,Signs,,0,0,0,,{\fad(1000,300)\fs50\move(960,1070,960,431,0,1447)\c&H1CE7FF&\4c&H004277&\shad3}Đã thuần thục kỹ năng "Bắn nước trái cây vào mũi"!
Dialogue: 0,0:04:57.98,0:04:59.40,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:04:59.77,0:05:01.23,Default,Fuk,0,0,0,,Xin hãy nhận lấy một con ạ.
Dialogue: 0,0:05:01.23,0:05:02.40,Default,Fuk,0,0,0,,Món quà Fuko tặng đấy ạ.
Dialogue: 0,0:05:02.40,0:05:03.36,Default,Fuk,0,0,0,,Nếu bạn không phiền...
Dialogue: 0,0:05:04.03,0:05:06.24,Default,Oka,0,0,0,,Tôi phục con bé thật, ngày nào cũng kiên trì làm được như thế.
Dialogue: 0,0:05:06.24,0:05:10.24,Default,Nag,0,0,0,,Tính ra em ấy đã tiếp cận hơn nửa số học sinh toàn trường rồi đấy.
Dialogue: 0,0:05:10.24,0:05:11.29,Default,Fuk,0,0,0,,Dạ...
Dialogue: 0,0:05:14.41,0:05:15.96,Default,Fuk,0,0,0,,Dạ, xin thứ lỗi cho em ạ.
Dialogue: 0,0:05:15.96,0:05:17.62,Default,Fuk,0,0,0,,Xin anh chị hãy nhận lấy món này ạ.
Dialogue: 0,0:05:17.92,0:05:18.71,Default,Guy,0,0,0,,Cái gì thế này?
Dialogue: 0,0:05:19.63,0:05:24.59,Default,Nag,0,0,0,,Tớ muốn để Fuu-chan và cô giáo Ibuki được gặp lại nhau.
Dialogue: 0,0:05:24.59,0:05:27.22,Default,Nag,0,0,0,,Thấy Fuu-chan nỗ lực nhiều đến thế...
Dialogue: 0,0:05:30.10,0:05:34.43,Default,Nag,0,0,0,,Tớ sẽ sang phòng mỹ thuật xin thêm gỗ vụn về.
Dialogue: 0,0:05:34.43,0:05:36.27,Default,Oka,0,0,0,,Thế tôi đi cùng cậu luôn.
Dialogue: 0,0:05:36.27,0:05:39.10,Default,Nag,0,0,0,,Cậu ở lại trông chừng Fuu-chan giúp tớ nhé.
Dialogue: 0,0:05:39.10,0:05:40.81,Default,Oka,0,0,0,,Này, Furukawa!
Dialogue: 0,0:05:40.81,0:05:41.98,Default,Oka,0,0,0,,Này đứng lại—
Dialogue: 0,0:05:42.36,0:05:43.44,Default,Oka,0,0,0,,Gì thế?
Dialogue: 0,0:05:43.44,0:05:45.40,Default,Fuk,0,0,0,,Cứu Fuko với, Okazaki-san!
Dialogue: 0,0:05:45.40,0:05:48.49,Default,Fuk,0,0,0,,Có một đám người giống như anh đang đuổi theo Fuko kìa.
Dialogue: 0,0:05:48.49,0:05:51.91,Default,Oka,0,0,0,,Người giống như tôi á? Thế sao nhóc lại chạy đến cầu cứu bản gốc làm gì?
Dialogue: 0,0:05:51.91,0:05:53.99,Default,Fuk,0,0,0,,Lúc dầu sôi lửa bỏng thì vớ được cọc nào hay cọc nấy thôi ạ.
Dialogue: 0,0:05:53.99,0:05:56.37,Default,Oka,0,0,0,,Nhờ vả người ta mà thái độ lồi lõm thế hả!
Dialogue: 0,0:05:55.75,0:05:57.87,Default-alt,Guys,0,0,0,,Fuuko-chan ơi!
Dialogue: 0,0:05:58.25,0:06:00.13,Default,Guys,0,0,0,,Mày là bạn của Fuuko-chan đấy à?
Dialogue: 0,0:06:00.13,0:06:01.50,Default,Fuk,0,0,0,,Không, anh ta là kẻ thù của Fuko đấy ạ!
Dialogue: 0,0:06:01.50,0:06:03.71,Default,Oka,0,0,0,,Đừng có nói mấy câu làm phức tạp hóa vấn đề lên chứ.
Dialogue: 0,0:06:03.71,0:06:07.34,Default,Guys,0,0,0,,Bọn tao muốn thành lập câu lạc bộ người hâm mộ Fuuko-chan.
Dialogue: 0,0:06:07.34,0:06:08.26,Default,Oka,0,0,0,,Câu lạc bộ người hâm mộ á?
Dialogue: 0,0:06:08.26,0:06:11.43,Default,Guys,0,0,0,,Nói đúng hơn là đội cận vệ trung thành của em ấy.
Dialogue: 0,0:06:11.80,0:06:18.56,Default,Guys,0,0,0,,Bọn tao vô cùng cảm động trước hành động phát điêu khắc không biết mệt mỏi của Fuuko-chan.
Dialogue: 0,0:06:18.56,0:06:23.27,Default,Guys,0,0,0,,Nên bọn tao muốn giúp em ấy biến đám cưới của chị gái thành một ngày lễ lộng lẫy nhất.
Dialogue: 0,0:06:23.27,0:06:24.15,Default,Oka,0,0,0,,Họ nói thế đấy.
Dialogue: 0,0:06:24.15,0:06:25.15,Default,Fuk,0,0,0,,Fuko không cần mấy người đâu.
Dialogue: 0,0:06:26.90,0:06:28.65,Default,Guys,0,0,0,,Dù vậy bọn anh vẫn sẽ cố hết sức mình!
Dialogue: 0,0:06:28.65,0:06:31.49,Default,Guys,0,0,0,,Bọn anh đâu có mong em đồng ý ngay từ đầu đâu.
Dialogue: 0,0:06:31.49,0:06:36.24,Default,Oka,0,0,0,,Tôi thấy vô ích thôi. Con bé không phải mẫu người dễ rung động bởi mấy trò này đâu.
Dialogue: 0,0:06:36.24,0:06:40.17,Default,Fuk,0,0,0,,Anh nói nghe như thể Fuko là người lạnh lùng ngang tàng lắm ấy.
Dialogue: 0,0:06:40.17,0:06:43.50,Default,Fuk,0,0,0,,Fuko là người trọng tình cảm và biết thấu hiểu lòng người hơn ai hết đấy nhé.
Dialogue: 0,0:06:43.50,0:06:46.30,Default,Oka,0,0,0,,Sao với tôi thì nhóc cộc cằn thế hả.
Dialogue: 0,0:06:46.30,0:06:50.84,Default,Guys,0,0,0,,Bọn anh sẽ cố gắng hết mình để một ngày nào đó được Fuuko-san tin tưởng.
Dialogue: 0,0:06:50.84,0:06:53.93,Default,Guys,0,0,0,,Bởi vì bọn anh đã trót say nắng Fuuko-chan mất rồi.
Dialogue: 0,0:06:54.10,0:06:56.93,Default,Guys,0,0,0,,Fuuko-chan. Xin phép đại ca nhé. Tụi em xin phép đi trước.
Dialogue: 0,0:06:59.02,0:07:00.85,Default,Oka,0,0,0,,Tụi nó tưởng bọn mình là hai anh em kìa.
Dialogue: 0,0:07:00.85,0:07:01.85,Default,Fuk,0,0,0,,Thật là kinh khủng khiếp quá đi mà.
Dialogue: 0,0:07:01.85,0:07:03.15,Default,Oka,0,0,0,,Đấy là câu của tôi mới đúng chứ!
Dialogue: 0,0:07:05.19,0:07:08.61,Default,Oka,0,0,0,,Số người nhận sao biển ngày một nhiều hơn rồi.
Dialogue: 0,0:07:08.94,0:07:12.36,Default,Oka,0,0,0,,Nhưng vẫn chỉ là một phần nhỏ so với toàn thể học sinh trong trường thôi.
Dialogue: 0,0:07:12.36,0:07:13.82,Signs,,0,0,0,,{\blur1\be1\pos(301,152)}Lễ Hội Thành Lập Trường
Dialogue: 0,0:07:12.99,0:07:15.66,Default,Oka,0,0,0,,Hơn nữa, lễ hội thành lập trường cũng sắp sửa diễn ra rồi.
Dialogue: 0,0:07:16.03,0:07:19.41,Default,Oka,0,0,0,,Nó cũng giống như lễ hội trường tháng năm mọi khi thôi.
Dialogue: 0,0:07:20.21,0:07:23.63,Default,Oka,0,0,0,,Hiện tại câu lạc bộ nào cũng đang tất bật chuẩn bị.
Dialogue: 0,0:07:23.63,0:07:27.38,Default,Oka,0,0,0,,Đến hôm đó không khí sẽ náo nhiệt lắm,\Nlại có cả khách bên ngoài vào tham quan nữa.
Dialogue: 0,0:07:23.63,0:07:27.38,Signs,,0,0,0,,{\blur1\be1\pos(359,158)}Lễ Hội Thành Lập Trường
Dialogue: 0,0:07:27.88,0:07:32.01,Default,Oka,0,0,0,,Nếu nhân dịp này đi phát quà, chắc chắn sẽ lôi kéo được thêm nhiều người đến dự đám cưới hơn.
Dialogue: 0,0:07:32.38,0:07:34.93,Default,Sun,0,0,0,,Cuộc họp nội bộ của trung tâm thương mại nào đây?
Dialogue: 0,0:07:34.93,0:07:37.60,Default,Fuk,0,0,0,,Là người có màu tóc kỳ quặc kìa!
Dialogue: 0,0:07:37.60,0:07:39.85,Default,Sun,0,0,0,,Con bé này vẫn ăn nói xấc láo như mọi khi.
Dialogue: 0,0:07:39.85,0:07:42.10,Default,Sun,0,0,0,,Tao đến đây là để giúp đỡ mày đấy nhé.
Dialogue: 0,0:07:42.10,0:07:45.19,Default,Nag,0,0,0,,Sunohara-san cũng giúp bọn mình sao?
Dialogue: 0,0:07:45.19,0:07:47.07,Default,Nag,0,0,0,,Thế thì an tâm quá rồi.
Dialogue: 0,0:07:47.73,0:07:49.40,Default,Oka,0,0,0,,Mày nói nghiêm túc đấy chứ?
Dialogue: 0,0:07:49.40,0:07:52.82,Default,Sun,0,0,0,,Tất nhiên rồi, vì tao muốn ghi điểm trong mắt Nagisa-chan mà.
Dialogue: 0,0:07:52.82,0:07:55.32,Default,Sun,0,0,0,,Nên là tao cũng sẽ giúp mày một tay.
Dialogue: 0,0:07:55.32,0:07:56.20,Default,Fuk,0,0,0,,Fuko không cần anh đâu.
Dialogue: 0,0:07:56.20,0:07:57.45,Default,Oka,0,0,0,,Tạm biệt Sunohara nhé.
Dialogue: 0,0:07:57.45,0:07:59.37,Default,Sun,0,0,0,,Bọn mày lạnh lùng vừa vừa phai phải thôi chứ?!
Dialogue: 0,0:07:59.37,0:08:02.46,Default,Fuk,0,0,0,,Người kỳ quặc hay làm mấy trò kỳ quặc lắm, Fuko không thích đâu.
Dialogue: 0,0:08:02.46,0:08:05.42,Default,Fuk,0,0,0,,Nhìn Okazaki-san là Fuko đã thấm thía bài học đó rồi.
Dialogue: 0,0:08:05.42,0:08:06.59,Default,Oka,0,0,0,,Tao bị xếp chung mâm với thằng này từ bao giờ thế?
Dialogue: 0,0:08:06.59,0:08:08.71,Default,Sun,0,0,0,,Được lắm, đã thế thì!
Dialogue: 0,0:08:08.71,0:08:09.46,Default,Sun,0,0,0,,Con nhóc kia!
Dialogue: 0,0:08:09.46,0:08:10.76,Default,Sun,0,0,0,,Quyết đấu với tao!
Dialogue: 0,0:08:10.76,0:08:12.76,Default,Nag,0,0,0,,Sunohara-san! Cậu không được gây gổ đâu đấy!
Dialogue: 0,0:08:12.76,0:08:15.80,Default,Oka,0,0,0,,Đúng đấy. Coi chừng lại bị đá văng vào máng rác nữa bây giờ.
Dialogue: 0,0:08:15.80,0:08:17.51,Default,Sun,0,0,0,,Không đời nào!
Dialogue: 0,0:08:17.51,0:08:20.14,Default,Sun,0,0,0,,Mà ai bảo tao sẽ thua chứ?!
Dialogue: 0,0:08:21.31,0:08:23.52,Default,Nag,0,0,0,,Thi đấu đẽo tượng sao?
Dialogue: 0,0:08:23.52,0:08:27.69,Default,Nag,0,0,0,,Nếu vậy thì tớ thấy ổn mà, mang đậm tinh thần thể thao thượng võ.
Dialogue: 0,0:08:27.69,0:08:29.65,Default,Oka,0,0,0,,Cái này mà gọi là thể thao cái nỗi gì.
Dialogue: 0,0:08:29.65,0:08:32.78,Default,Sun,0,0,0,,Nếu tao đẽo đẹp hơn, mày phải cho tao nhập hội.
Dialogue: 0,0:08:32.78,0:08:35.07,Default,Sun,0,0,0,,Còn nếu tao thua, tao sẽ ngậm bồ hòn làm ngọt mà rút lui êm đẹp.
Dialogue: 0,0:08:35.07,0:08:36.03,Default,Sun,0,0,0,,Chịu chưa?
Dialogue: 0,0:08:37.03,0:08:39.08,Default,Sun,0,0,0,,Được rồi, đề bài hôm nay là...
Dialogue: 0,0:08:39.41,0:08:40.29,Default,Sun,0,0,0,,Quái thú Nue!
Dialogue: 0,0:08:40.66,0:08:41.75,Default,3,0,0,0,,Nue?
Dialogue: 0,0:08:41.75,0:08:47.92,Default,Sun,0,0,0,,{\fscx108}Một loài quái vật có đầu khỉ,\Nmình lửng, đuôi rắn và tứ chi của loài hổ.
Dialogue: 0,0:08:49.88,0:08:51.30,Default,Fuk,0,0,0,,Đầu khỉ,
Dialogue: 0,0:08:51.30,0:08:52.80,Default,Fuk,0,0,0,,mình chó,
Dialogue: 0,0:08:52.80,0:08:54.38,Default,Fuk,0,0,0,,và món khoái khẩu là bánh dày mochi.
Dialogue: 0,0:08:54.38,0:08:57.09,Default,Oka,0,0,0,,Trong lời miêu tả của nó làm quái gì có món ăn khoái khẩu nào hả.
Dialogue: 0,0:08:57.09,0:08:59.26,Default,Sun,0,0,0,,Kệ đi, sao cũng được. Chuẩn bị...
Dialogue: 0,0:08:59.26,0:08:59.85,Default,Sun,0,0,0,,Bắt đầu!
Dialogue: 0,0:09:01.22,0:09:02.43,Default,Nag,0,0,0,,Okazaki-san này.
Dialogue: 0,0:09:02.93,0:09:06.44,Default,Nag,0,0,0,,Trong sở thú có nuôi Nue không cậu?
Dialogue: 0,0:09:06.44,0:09:07.94,Default,Oka,0,0,0,,Làm sao mà có được chứ.
Dialogue: 0,0:09:07.94,0:09:10.36,Default,Oka,0,0,0,,Nó là sinh vật chỉ xuất hiện trong truyện cổ tích thôi.
Dialogue: 0,0:09:10.36,0:09:11.65,Default,Nag,0,0,0,,À, ra là vậy.
Dialogue: 0,0:09:11.65,0:09:14.86,Default,Nag,0,0,0,,Tớ cứ tưởng là có thật, đang định bụng đi ngắm thử một lần xem sao.
Dialogue: 0,0:09:16.45,0:09:18.41,Default,Oka,0,0,0,,Cái phòng này toàn một lũ ngốc tụ họp lại với nhau.
Dialogue: 0,0:09:19.53,0:09:20.62,Default,Fuk,0,0,0,,Fuko làm xong rồi ạ!
Dialogue: 0,0:09:20.62,0:09:21.08,Default,Sun,0,0,0,,Nhanh thế?!
Dialogue: 0,0:09:21.08,0:09:22.12,Default,Sun,0,0,0,,Thật không đấy?!
Dialogue: 0,0:09:22.12,0:09:22.74,Default,Sun,0,0,0,,Khoan đã—
Dialogue: 0,0:09:22.74,0:09:24.20,Default,Oka,0,0,0,,Đ-Đây là...
Dialogue: 0,0:09:29.92,0:09:31.96,Default,Sun,0,0,0,,Con quái này mà là Nue cái nỗi gì hả?!
Dialogue: 0,0:09:31.96,0:09:35.42,Default,Fuk,0,0,0,,Đây là giới hạn tối đa mà Fuko có thể làm rồi ạ.
Dialogue: 0,0:09:35.42,0:09:37.13,Default,Oka,0,0,0,,Làm tốt lắm, Fuko.
Dialogue: 0,0:09:37.13,0:09:40.05,Default,Sun,0,0,0,,Đẽo trật lấc đề bài thì làm sao mà tính điểm được chứ!
Dialogue: 0,0:09:40.05,0:09:41.56,Default,Sun,0,0,0,,Xem ra tao thắng chắc rồi.
Dialogue: 0,0:09:44.72,0:09:47.10,Default,Oka,0,0,0,,Không hoàn thành bài thi. Fuko thắng cuộc.
Dialogue: 0,0:09:47.10,0:09:48.52,Default,Sun,0,0,0,,Bọn mày không thèm đoái hoài lo lắng cho tao lấy một câu à?!
Dialogue: 0,0:09:48.52,0:09:50.65,Default,Nag,0,0,0,,Sunohara-san! Cậu mau xuống phòng y tế ngay đi kìa!
Dialogue: 0,0:09:53.15,0:09:56.03,Default,Oka,0,0,0,,Mời cô giáo Ibuki đến tham dự lễ hội trường sao?
Dialogue: 0,0:09:56.03,0:10:02.12,Default,Nag,0,0,0,,Vâng. Em đang tính mời cô ấy đến lễ hội và để hai chị em được gặp lại nhau.
Dialogue: 0,0:10:02.12,0:10:04.62,Default,Oka,0,0,0,,Ra vậy. Đó có thể là một ý tưởng hay đấy.
Dialogue: 0,0:10:04.62,0:10:08.42,Default,Oka,0,0,0,,Fuko! Bọn anh có chút việc cần giải quyết.
Dialogue: 0,0:10:08.42,0:10:10.67,Default,Oka,0,0,0,,Nhóc tự đi về nhà trước nhé?
Dialogue: 0,0:10:10.67,0:10:13.00,Default,Nag,0,0,0,,Bọn chị sẽ về ngay thôi.
Dialogue: 0,0:10:15.92,0:10:18.22,Default,Oka,0,0,0,,Liệu con bé có tự về một mình được không đấy?
Dialogue: 0,0:10:18.22,0:10:22.30,Default,Nag,0,0,0,,Tớ tin em ấy sẽ ổn thôi mà. Em ấy lớn rồi.
Dialogue: 0,0:10:22.30,0:10:25.10,Default,Oka,0,0,0,,Tính ra con bé bằng tuổi tôi với cậu đấy, biết không?
Dialogue: 0,0:10:26.77,0:10:30.73,Default,Nag,0,0,0,,Bọn mình trông chẳng khác nào bố mẹ của Fuu-chan ấy nhỉ.
Dialogue: 0,0:10:33.15,0:10:36.40,Default,Nag,0,0,0,,Ý-Ý em không phải thế đâu ạ. Xin hãy quên lời em vừa nói đi!
Dialogue: 0,0:10:46.83,0:10:48.33,Default,Oka,0,0,0,,Yoshino Yuusuke.
Dialogue: 0,0:10:49.50,0:10:51.25,Default,Nag,0,0,0,,Người quen của cậu à?
Dialogue: 0,0:10:51.25,0:10:55.34,Default,Oka,0,0,0,,'Yuusuke'! Chú là vị hôn phu của cô Kouko đúng không ạ?
Dialogue: 0,0:10:57.05,0:10:59.76,Default,Yos,0,0,0,,Ra vậy. Các cháu từng là học trò của cô ấy à.
Dialogue: 0,0:10:59.76,0:11:03.60,Default,Nag,0,0,0,,Vâng ạ. Hồi em mới vào năm nhất cô đã dìu dắt em rất nhiều.
Dialogue: 0,0:11:03.60,0:11:07.56,Default,Oka,0,0,0,,Bọn cháu đến đây vì muốn mời cô Kouko tới tham dự lễ hội thành lập trường.
Dialogue: 0,0:11:07.56,0:11:09.68,Default,Oka,0,0,0,,Bọn cháu có một thứ rất muốn cho cô ấy xem.
Dialogue: 0,0:11:09.68,0:11:13.02,Default,Oka,0,0,0,,Chắc chắn đó sẽ là một ngày vô cùng tuyệt vời đối với cô ấy.
Dialogue: 0,0:11:15.32,0:11:16.98,Default,Yos,0,0,0,,Đó là một ý kiến hay đấy.
Dialogue: 0,0:11:16.98,0:11:19.24,Default,Nag,0,0,0,,Chú cũng tán thành sao ạ?
Dialogue: 0,0:11:19.24,0:11:25.53,Default,Yos,0,0,0,,Ừ. Đến hay không là quyền của cô ấy, nhưng chú nghĩ chỉ cần nghe được những lời chân tình như thế thôi cũng đã tiếp thêm sức mạnh cho cô ấy lúc này rồi.
Dialogue: 0,0:11:26.12,0:11:26.83,Default,Yos,0,0,0,,Cứ thử xem sao nhé.
Dialogue: 0,0:11:27.83,0:11:29.62,Default,Ibu,0,0,0,,Đến lễ hội thành lập trường sao?
Dialogue: 0,0:11:30.04,0:11:35.96,Default,Ibu,0,0,0,,Nhưng cô đã nghỉ dạy từ ba năm trước rồi,\Nmà học sinh cô quen thì chỉ có mỗi Nagisa-chan thôi.
Dialogue: 0,0:11:35.96,0:11:38.71,Default,Oka,0,0,0,,Nhưng vẫn còn các thầy cô giáo cũ mà cô quen biết đúng không ạ?
Dialogue: 0,0:11:38.71,0:11:41.01,Default,Oka,0,0,0,,Hôm đó có nhiều gian hàng lắm, vui cực kỳ luôn ạ.
Dialogue: 0,0:11:41.01,0:11:42.88,Default,Nag,0,0,0,,Xin cô hãy đến đi ạ. Em tha thiết mong cô đến đấy ạ.
Dialogue: 0,0:11:43.97,0:11:45.39,Default,Ibu,0,0,0,,Để cô xem nào...
Dialogue: 0,0:11:46.43,0:11:48.89,Default,Ibu,0,0,0,,Được rồi. Cô sẽ đến.
Dialogue: 0,0:11:50.27,0:11:53.90,Default,Ibu,0,0,0,,Trước khi tai nạn xảy ra,\Ncô từng có một lời hứa với em gái mình.
Dialogue: 0,0:11:55.06,0:11:58.90,Default,Ibu,0,0,0,,Hai chị em đã hẹn nhau sẽ cùng đi chơi lễ hội trường khi con bé nhập học.
Dialogue: 0,0:12:00.90,0:12:05.78,Default,Ibu,0,0,0,,Cô muốn thay mặt em ấy đến xem để về kể lại cho con bé nghe.
Dialogue: 0,0:12:06.66,0:12:09.70,Default,Ibu,0,0,0,,Cô tin chắc... con bé sẽ vui lắm.
Dialogue: 0,0:12:11.54,0:12:13.62,Default,Oka,0,0,0,,Cậu mau nước mắt quá rồi đấy!
Dialogue: 0,0:12:13.62,0:12:15.46,Default,Nag,0,0,0,,Em xin lỗi... nhưng mà...
Dialogue: 0,0:12:15.46,0:12:17.29,Default,Ibu,0,0,0,,Có chuyện gì thế hả Nagisa-chan?
Dialogue: 0,0:12:17.29,0:12:20.38,Default,Oka,0,0,0,,D-Dạ chắc cậu ấy mót đi vệ sinh quá nên đang nhịn đấy ạ.
Dialogue: 0,0:12:20.38,0:12:21.72,Default,Ibu,0,0,0,,Thế hả em?
Dialogue: 0,0:12:21.72,0:12:23.55,Default,Ibu,0,0,0,,Em có muốn dùng nhà vệ sinh nhà cô không?
Dialogue: 0,0:12:24.26,0:12:25.93,Default,Nag,0,0,0,,Em xin phép ạ!
Dialogue: 0,0:12:34.31,0:12:36.73,Default,Oka,0,0,0,,Cái cớ vụng về chết đi được.
Dialogue: 0,0:12:37.27,0:12:40.11,Default,Nag,0,0,0,,Tớ xin lỗi, tớ không kìm nén được cảm xúc.
Dialogue: 0,0:12:40.86,0:12:43.99,Default,Nag,0,0,0,,Vị hôn phu của cô ấy trông hiền từ ghê.
Dialogue: 0,0:12:44.32,0:12:45.07,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:12:45.61,0:12:50.03,Default,Oka,0,0,0,,Chỉ cần để Fuko và cô giáo Ibuki gặp nhau,\Nthì sẽ sáng tỏ mối quan hệ thực sự giữa hai người họ thôi.
Dialogue: 0,0:12:50.95,0:12:54.00,Default,Fuk,0,0,0,,Fuko sợ chị ấy sẽ không nghe thấy tiếng của Fuko.
Dialogue: 0,0:13:03.51,0:13:05.72,Default,Nag,0,0,0,,Cuối cùng ngày đó cũng đã đến rồi.
Dialogue: 0,0:13:05.72,0:13:08.55,Default,Oka,0,0,0,,Con bé làm việc quá sức rồi.
Dialogue: 0,0:13:08.55,0:13:11.39,Default,Nag,0,0,0,,Em ấy thức trắng cả đêm qua để đẽo tượng nữa.
Dialogue: 0,0:13:11.39,0:13:13.98,Default,Oka,0,0,0,,Tự nhiên đánh thức con bé dậy lôi đến trường thì tội quá.
Dialogue: 0,0:13:15.48,0:13:17.81,Default,Oka,0,0,0,,Chắc chỉ còn mỗi cách này thôi.
Dialogue: 0,0:13:17.81,0:13:19.23,Default,Aki,0,0,0,,Đừng có cằn nhằn nữa.
Dialogue: 0,0:13:19.23,0:13:24.19,Default,Aki,0,0,0,,Đã là đàn ông thì cõng một hai đứa con gái nhẹ tênh như đá cầu chứ có gì đâu.
Dialogue: 0,0:13:24.19,0:13:25.36,Default,Oka,0,0,0,,Bác nói xàm vừa thôi.
Dialogue: 0,0:13:25.78,0:13:27.66,Default,San,0,0,0,,Cố lên các cháu nhé.
Dialogue: 0,0:13:27.66,0:13:28.41,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:13:28.95,0:13:30.28,Default,Oka,0,0,0,,Thế bọn cháu đi đây ạ.
Dialogue: 0,0:13:34.25,0:13:36.66,Default,Nag,0,0,0,,Trông Fuu-chan ngủ có vẻ êm ái ghê.
Dialogue: 0,0:13:36.66,0:13:41.00,Default,Oka,0,0,0,,Tôi có linh cảm vừa mở mắt ra là con bé sẽ thốt lên 'Kinh khủng khiếp quá' cho mà xem.
Dialogue: 0,0:13:41.00,0:13:44.67,Default,Nag,0,0,0,,Fuu-chan đâu có ghét cậu như cậu nghĩ đâu.
Dialogue: 0,0:13:45.09,0:13:48.55,Default,Nag,0,0,0,,Mỗi khi ở cạnh cậu, em ấy trông vui vẻ lắm đấy.
Dialogue: 0,0:13:48.55,0:13:52.43,Default,Oka,0,0,0,,Giá như con bé mở lòng với người khác nhiều hơn chút nữa...
Dialogue: 0,0:13:52.97,0:13:55.77,Default,Oka,0,0,0,,Lúc nào cũng dè chừng cảnh giác y hệt như một loài động vật nhỏ vậy.
Dialogue: 0,0:13:56.27,0:13:59.02,Default,Nag,0,0,0,,Tớ nghĩ Fuu-chan đang rất cố gắng rồi.
Dialogue: 0,0:13:59.60,0:14:04.53,Default,Nag,0,0,0,,Khi cô giáo Ibuki nhìn thấy Fuu-chan nỗ lực hết mình thế này,\Ntớ tin chắc cô ấy cũng sẽ hạnh phúc lắm.
Dialogue: 0,0:14:05.40,0:14:07.53,Default,Oka,0,0,0,,Ừ, có lẽ vậy.
Dialogue: 0,0:14:07.95,0:14:11.28,Default,Nag,0,0,0,,Và rồi tất cả chúng mình sẽ cùng đồng thanh chúc mừng đám cưới của cô.
Dialogue: 0,0:14:11.91,0:14:12.70,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:14:14.79,0:14:16.29,Default,Oka,0,0,0,,Dậy rồi đấy à, Fuko.
Dialogue: 0,0:14:16.83,0:14:20.63,Default,Nag,0,0,0,,Okazaki-san đã cõng em suốt từ nhà tới tận đây đấy.
Dialogue: 0,0:14:20.63,0:14:22.88,Default,Fuk,0,0,0,,Có một cảm giác kinh khủng man mác đâu đây ạ.
Dialogue: 0,0:14:22.88,0:14:25.67,Default,Oka,0,0,0,,Nghe thấy chưa? Tôi đã bảo rồi mà lị.
Dialogue: 0,0:14:25.67,0:14:30.97,Default,Nag,0,0,0,,Đâu có, em ấy bảo là 'man mác' tức là cũng không đến nỗi tệ lắm đâu.
Dialogue: 0,0:14:30.97,0:14:32.14,Default,Oka,0,0,0,,Cái đó rốt cuộc là tốt hay xấu thế?
Dialogue: 0,0:14:33.64,0:14:38.14,Default,Fuk,0,0,0,,Fuko xin lỗi ạ. Theo thói quen Fuko lỡ buông lời thất lễ mất rồi.
Dialogue: 0,0:14:38.60,0:14:43.65,Default,Oka,0,0,0,,Nhóc còn thêm chữ 'man mác' vào thì tức là nhóc hoàn toàn tỉnh táo nhận thức được mình đang nói gì rồi.
Dialogue: 0,0:14:44.07,0:14:48.61,Default,Fuk,0,0,0,,Chắc tại vì anh cõng Fuko đấy;\NFuko đã mơ một giấc mơ kỳ lạ lắm.
Dialogue: 0,0:14:48.61,0:14:50.15,Default,Oka,0,0,0,,Lại mơ về sao biển chứ gì?
Dialogue: 0,0:14:50.15,0:14:53.58,Default,Fuk,0,0,0,,Vâng, Fuko đang nô đùa cùng bầy sao biển bên bờ biển.
Dialogue: 0,0:14:55.54,0:14:57.66,Default,Oka,0,0,0,,Này, Fuu-chan ơi!
Dialogue: 0,0:14:57.66,0:14:59.71,Default,Oka,0,0,0,,Yahoo!
Dialogue: 0,0:14:59.71,0:15:02.50,Default,Oka,0,0,0,,Okazaki là số một luôn!
Dialogue: 0,0:15:02.50,0:15:05.09,Default,Oka,0,0,0,,Rồi anh nắm lấy tay em.
Dialogue: 0,0:15:05.09,0:15:07.34,Default,Oka,0,0,0,,Em đang làm gì một mình ở đây thế?
Dialogue: 0,0:15:07.34,0:15:10.63,Default,Oka,0,0,0,,Hôm nay là Lễ Hội Sao Biển cơ mà.
Dialogue: 0,0:15:10.63,0:15:13.09,Default,Fuk,0,0,0,,Thế Lễ Hội Sao Biển là cái lễ hội gì thế anh?
Dialogue: 0,0:15:13.09,0:15:14.30,Default,Oka,0,0,0,,Làm sao tôi biết được hả trời?!
Dialogue: 0,0:15:14.30,0:15:16.14,Default,Nag,0,0,0,,Nhưng nghe có vẻ vui nhộn ghê.
Dialogue: 0,0:15:26.69,0:15:30.28,Default,Oka,0,0,0,,Hôm lễ hội trường thật mà cậu cũng được đứng bán hàng thế này thì tuyệt biết bao.
Dialogue: 0,0:15:31.15,0:15:32.03,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:15:33.99,0:15:34.78,Default,Fuk,0,0,0,,Xin hãy nhận lấy ạ.
Dialogue: 0,0:15:40.66,0:15:42.92,Default,Nag,0,0,0,,Cảm ơn Fuu-chan nhiều lắm nhé.
Dialogue: 0,0:15:48.76,0:15:49.80,Default,Nag,0,0,0,,Chẳng lẽ...
Dialogue: 0,0:15:49.80,0:15:52.22,Default,Nag,0,0,0,,...mấy cái này là do mọi người tự làm sao?
Dialogue: 0,0:15:52.22,0:15:56.05,Default,Guys,0,0,0,,Đúng thế, vì bọn tao muốn giúp đỡ Fuuko-chan nhiều nhất có thể.
Dialogue: 0,0:15:56.05,0:16:01.18,Default,Guys,0,0,0,,Bọn tao dự tính ai mua món này sẽ kể cho họ nghe về đám cưới của chị gái Fuuko-chan.
Dialogue: 0,0:16:01.18,0:16:04.35,Default,Oka,0,0,0,,Độ cảm thụ thẩm mỹ của mấy người sánh ngang với bác Sanae rồi đấy.
Dialogue: 0,0:16:01.39,0:16:03.39,Note,,0,0,0,,
Dialogue: 0,0:16:05.48,0:16:06.61,Default,Nag,0,0,0,,Fuu-chan ơi?
Dialogue: 0,0:16:07.15,0:16:08.82,Default,Oka,0,0,0,,Lại bắt đầu ngẩn ngơ rồi đấy.
Dialogue: 0,0:16:14.49,0:16:15.87,Default,Kyo,0,0,0,,Tỉnh ngủ chưa em?
Dialogue: 0,0:16:16.32,0:16:19.37,Default,Ryo,0,0,0,,Fuuko-chan, bộ trang phục này hợp với em lắm đấy.
Dialogue: 0,0:16:19.37,0:16:23.58,Default,Fuk,0,0,0,,Fuko lạc sang thế giới nào từ lúc nào thế này ạ?
Dialogue: 0,0:16:23.58,0:16:25.75,Default,Oka,0,0,0,,Thấy nhóc ngơ ngẩn nên bọn tôi bế nhóc sang đây luôn đấy.
Dialogue: 0,0:16:25.75,0:16:28.29,Default,Nag,0,0,0,,Em dễ thương lắm, Fuu-chan.
Dialogue: 0,0:16:29.00,0:16:31.84,Default,Kyo,0,0,0,,Đây là sản phẩm hợp tác liên lớp giữa lớp D và lớp E đấy.
Dialogue: 0,0:16:31.84,0:16:36.55,Default,Kyo,0,0,0,,Vì lớp trưởng hai lớp là chị em sinh đôi nên bọn chị quyết định bắt tay hợp lực.
Dialogue: 0,0:16:36.55,0:16:41.18,Default,Ryo,0,0,0,,Nếu em tặng kèm món này làm quà lưu niệm cho khách, chị nghĩ họ sẽ vui vẻ nhận một cách tự nhiên thôi.
Dialogue: 0,0:16:41.18,0:16:43.43,Default,Nag,0,0,0,,Tớ cũng phụ một tay nữa.
Dialogue: 0,0:16:43.43,0:16:44.89,Default,Nag,0,0,0,,Nghe nói hai lớp đang thiếu người giúp đỡ.
Dialogue: 0,0:16:44.89,0:16:46.94,Default,Fuk,0,0,0,,Thiếu sao biển ạ?
Dialogue: 0,0:16:46.94,0:16:48.56,Default,Oka,0,0,0,,Không phải 'hitode' đó đâu con bé ngốc này!
Dialogue: 0,0:16:46.94,0:16:48.56,Note,Note,0,0,0,,Chơi chữ: Nhân lực (hitode) vs Sao biển (hitode)
Dialogue: 0,0:16:48.02,0:16:50.15,Signs,,0,0,0,,{\fad(1000,0)\fs50\c&H1CE7FF&\4c&H004277&\shad3\move(960,1070,960,433,0,1405)}Đã thuần thục kỹ năng "Bỏ rơi ở một nơi xa lạ"!
Dialogue: 0,0:16:50.78,0:16:52.28,Default,Ryo,0,0,0,,Xin lỗi vì đã để quý khách phải đợi lâu ạ.
Dialogue: 0,0:16:53.19,0:16:54.20,Default,Guys,0,0,0,,Cảm ơn hai bạn nhé.
Dialogue: 0,0:16:54.49,0:16:56.20,Default,Fuk,0,0,0,,X-Xin hãy nhận lấy ạ.
Dialogue: 0,0:16:56.70,0:16:58.07,Default,Guy,0,0,0,,Cái này... là cái gì thế em?
Dialogue: 0,0:16:58.62,0:16:59.70,Default,Guy,0,0,0,,À, miếng lót ly đúng không?
Dialogue: 0,0:16:59.70,0:17:02.25,Default,Fuk,0,0,0,,Không phải đâu ạ, không phải miếng lót ly đâu.
Dialogue: 0,0:17:01.20,0:17:03.58,Default-alt,Nag,0,0,0,,Fuu-chan chăm chỉ làm việc ghê.
Dialogue: 0,0:17:04.21,0:17:06.83,Default,Oka,0,0,0,,Cậu mặc bộ này trông cũng xinh xắn lắm đấy.
Dialogue: 0,0:17:08.17,0:17:12.26,Default,Nag,0,0,0,,Vâng, làm nhân viên bồi bàn thế này khi bắt tay vào làm thấy vui ghê.
Dialogue: 0,0:17:12.26,0:17:13.46,Default,Fuk,0,0,0,,Món quà của bạn đây ạ!
Dialogue: 0,0:17:18.72,0:17:20.51,Default,Girl,0,0,0,,Đó là bé Fuuko-chan đúng không?
Dialogue: 0,0:17:20.51,0:17:22.93,Default,Girl,0,0,0,,Nghe nói em ấy đang nỗ lực hết mình vì đám cưới của chị gái đấy.
Dialogue: 0,0:17:22.93,0:17:25.60,Default,Girl,0,0,0,,Một cô bé đáng yêu ghê.
Dialogue: 0,0:17:26.31,0:17:28.40,Default,Sun,0,0,0,,Xem ra hôm nay mọi chuyện suôn sẻ thuận buồm xuôi gió nhỉ.
Dialogue: 0,0:17:28.40,0:17:31.86,Default,Oka,0,0,0,,Con bé nổi tiếng khắp trường rồi đấy nhỉ?
Dialogue: 0,0:17:32.57,0:17:36.28,Default,Nag,0,0,0,,Thì ngày nào em ấy cũng chăm chỉ nỗ lực như thế mà.
Dialogue: 0,0:17:41.49,0:17:44.33,Default,Nag,0,0,0,,Fuu-chan đã dạy cho tớ một bài học lớn.
Dialogue: 0,0:17:45.50,0:17:51.50,Default,Nag,0,0,0,,Tớ sẽ noi gương Fuu-chan, nhất định không bỏ cuộc mà tiếp tục chiêu mộ thành viên cho câu lạc bộ kịch.
Dialogue: 0,0:17:51.50,0:17:55.59,Default,Nag,0,0,0,,Rồi tớ sẽ cùng mọi người tỏa sáng trong lễ hội trường.
Dialogue: 0,0:17:55.59,0:17:58.97,Default,Sun,0,0,0,,Anh cũng sẽ dốc hết lòng hết sức vì Nagisa-chan thân yêu của anh.
Dialogue: 0,0:17:59.76,0:18:02.06,Default,Oka,0,0,0,,Mày vừa lẩm bẩm cái gì đấy?
Dialogue: 0,0:18:03.18,0:18:05.68,Default,Sun,0,0,0,,Anh đang cực kỳ nghiêm túc đấy, Nagisa-chan à.
Dialogue: 0,0:18:05.68,0:18:08.06,Default,Oka,0,0,0,,Sunohara, đằng kia có em gái trông như chưa có chủ kìa.
Dialogue: 0,0:18:08.06,0:18:09.23,Default,Sun,0,0,0,,Đứa nào? Đứa nào cơ?!
Dialogue: 0,0:18:12.86,0:18:14.40,Default,Sun,0,0,0,,Em ơi! Em gái ơi! Em gái đằng kia ơi!
Dialogue: 0,0:18:14.40,0:18:16.11,Default,Sun,0,0,0,,Có muốn anh dẫn đi tham quan trường một vòng không?
Dialogue: 0,0:18:16.11,0:18:18.70,Default,Oka,0,0,0,,Cái sự 'nghiêm túc' của nó chỉ kéo dài được đúng một giây thôi đấy.
Dialogue: 0,0:18:18.70,0:18:21.07,Default,Girl,0,0,0,,Em thật sự không có nhu cầu đâu, cảm ơn anh.
Dialogue: 0,0:18:21.07,0:18:22.08,Default,Sun,0,0,0,,Thôi mà em, đừng có ngại.
Dialogue: 0,0:18:22.08,0:18:24.29,Default,Sun,0,0,0,,Em học trường nào sang đây thế?
Dialogue: 0,0:18:26.66,0:18:27.71,Default,Sun,0,0,0,,Mắt để đi đâu thế hả?!
Dialogue: 0,0:18:29.50,0:18:32.13,Default,Sun,0,0,0,,Tránh đường ra mau! Không em ấy chạy mất bây giờ!
Dialogue: 0,0:18:33.34,0:18:35.71,Default,Sun,0,0,0,,Không chịu tránh thì tao cho mày bay màu luôn.
Dialogue: 0,0:18:38.97,0:18:40.76,Default,Sun,0,0,0,,Mày không biết đang đối đầu với ai đâu con ạ.
Dialogue: 0,0:18:40.76,0:18:41.80,Default,Sun,0,0,0,,Biến đi!
Dialogue: 0,0:18:48.60,0:18:50.23,Default,Oka,0,0,0,,Cú đá thần sầu đó. Chắc chắn là Tomoyo rồi.
Dialogue: 0,0:18:50.23,0:18:54.02,Default,Nag,0,0,0,,Tomoyo-san sao? Chính là người đã đuổi đánh đám đi xe máy bữa trước đúng không?
Dialogue: 0,0:18:54.48,0:18:56.53,Default,Tom,0,0,0,,Tôi đang làm nhiệm vụ tình nguyện tuần tra an ninh.
Dialogue: 0,0:18:56.53,0:19:00.28,Default,Tom,0,0,0,,Để mắt tới những kẻ có hành vi đi chệch khỏi quy chuẩn giữa chốn hội hè.
Dialogue: 0,0:19:00.28,0:19:02.91,Default,Oka,0,0,0,,Nhưng tại sao lại mặc cái bộ đồ gấu này?
Dialogue: 0,0:19:03.32,0:19:05.54,Default,Tom,0,0,0,,Tôi khá có tiếng tăm trong một số băng nhóm.
Dialogue: 0,0:19:06.16,0:19:09.25,Default,Tom,0,0,0,,Nếu họ nhìn thấy mặt tôi thì dễ sinh chuyện ẩu đả lắm.
Dialogue: 0,0:19:09.25,0:19:09.91,Default,Fuk,0,0,0,,Dạ...
Dialogue: 0,0:19:09.91,0:19:11.67,Default,Fuk,0,0,0,,Nếu chị không phiền, xin hãy nhận lấy món này ạ.
Dialogue: 0,0:19:11.67,0:19:13.13,Default,Tom,0,0,0,,Tặng cho tôi sao?
Dialogue: 0,0:19:13.13,0:19:15.04,Default,Fuk,0,0,0,,Vâng ạ. Món quà Fuko tặng chị.
Dialogue: 0,0:19:15.42,0:19:18.67,Default,Tom,0,0,0,,Bình thường tôi không hay nhận đồ thế này đâu.
Dialogue: 0,0:19:22.05,0:19:23.89,Default,Tom,0,0,0,,Nhưng trông nó có vẻ là đồ thủ công tự làm.
Dialogue: 0,0:19:23.89,0:19:28.98,Default,Tom,0,0,0,,Tôi hay được các bạn nữ tặng quà, nhưng hiếm khi có đồ tự tay làm thế này.
Dialogue: 0,0:19:28.98,0:19:30.35,Default,Tom,0,0,0,,Tôi xin vui lòng nhận lấy.
Dialogue: 0,0:19:32.48,0:19:34.06,Default,Fuk,0,0,0,,Chị ấy là người tốt bụng ghê.
Dialogue: 0,0:19:35.11,0:19:37.15,Default,Nag,0,0,0,,Ơ, Sunohara-san đâu mất tiêu rồi ạ?
Dialogue: 0,0:19:37.15,0:19:38.03,Default,Oka,0,0,0,,Mặc xác nó đi.
Dialogue: 0,0:19:38.03,0:19:41.11,Default,Oka,0,0,0,,Chắc nó lại lồm cồm bò dậy đi tán gái khác rồi.
Dialogue: 0,0:19:43.70,0:19:44.99,Default,Fuk,0,0,0,,Mitsui-san.
Dialogue: 0,0:19:46.24,0:19:48.24,Default,Girls,0,0,0,,Nhanh chân lên nào!
Dialogue: 0,0:19:50.29,0:19:52.71,Default,Mit,0,0,0,,Hóa ra em vẫn kiên trì đi phát món này sao.
Dialogue: 0,0:19:56.84,0:19:58.55,Default,Fuk,0,0,0,,Nếu chị không phiền, xin hãy nhận lấy món này ạ.
Dialogue: 0,0:20:03.05,0:20:06.55,Default,Mit,0,0,0,,Bao giờ thì đám cưới của chị em diễn ra?
Dialogue: 0,0:20:07.01,0:20:09.10,Default,Fuk,0,0,0,,Dạ vẫn chưa ấn định ngày ạ.
Dialogue: 0,0:20:09.47,0:20:11.18,Default,Mit,0,0,0,,Ra vậy.
Dialogue: 0,0:20:12.02,0:20:15.81,Default,Mit,0,0,0,,Nếu không trùng vào đợt thi cử, có lẽ chị sẽ đến dự được.
Dialogue: 0,0:20:16.44,0:20:17.27,Default,Mit,0,0,0,,Chị xin phép đi trước nhé.
Dialogue: 0,0:20:19.15,0:20:20.74,Default,Mit,0,0,0,,Và chúc em may mắn nhé.
Dialogue: 0,0:20:27.66,0:20:30.91,Default,Nag,0,0,0,,Mừng cho em nhé, Fuu-chan.
Dialogue: 0,0:20:30.91,0:20:32.00,Default,Fuk,0,0,0,,Vâng ạ.
Dialogue: 0,0:20:33.66,0:20:34.54,Default,Fuk,0,0,0,,Vâng ạ!
Dialogue: 0,0:20:53.48,0:20:56.73,Default,Nag,0,0,0,,Chắc cô giáo Ibuki cũng sắp đến rồi đấy.
Dialogue: 0,0:20:56.73,0:20:57.10,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:21:02.86,0:21:04.28,Default,Nag,0,0,0,,Cô giáo Ibuki kìa!
Dialogue: 0,0:21:15.25,0:21:16.83,Default,Oka,0,0,0,,Em chào cô Kouko ạ.
Dialogue: 0,0:21:16.83,0:21:19.67,Default,Nag,0,0,0,,Cô giáo ơi, em vui quá vì cô đã đến.
Dialogue: 0,0:21:19.67,0:21:22.34,Default,Ibu,0,0,0,,Cô chào hai đứa nhé, Nagisa-chan, Okazaki-san.
Dialogue: 0,0:21:22.34,0:21:25.17,Default,Ibu,0,0,0,,Cô xin lỗi, cô đến có hơi muộn không?
Dialogue: 0,0:21:25.17,0:21:26.01,Default,Nag,0,0,0,,Dạ không hề đâu cô.
Dialogue: 0,0:21:28.39,0:21:32.68,Default,Ibu,0,0,0,,Lâu lắm rồi cô mới quay lại đây,\Nnên cũng thấy có chút hồi hộp.
Dialogue: 0,0:21:33.27,0:21:36.89,Default,Ibu,0,0,0,,Khung cảnh vẫn chẳng có gì thay đổi, vậy mà lại có cảm giác như đang ở một ngôi trường khác.
Dialogue: 0,0:21:37.27,0:21:39.94,Default,Ibu,0,0,0,,Chắc là vì xung quanh toàn những gương mặt học sinh mà cô không hề quen biết.
Dialogue: 0,0:21:41.61,0:21:44.11,Default,Ibu,0,0,0,,Thế nên cô thấy thật sự nhẹ nhõm...
Dialogue: 0,0:21:44.11,0:21:45.65,Default,Ibu,0,0,0,,...khi nhìn thấy hai đứa đấy.
Dialogue: 0,0:21:48.82,0:21:50.24,Default,Nag,0,0,0,,Hai đứa ạ...?
Dialogue: 0,0:21:53.91,0:21:55.12,Default,Fuk,0,0,0,,Fuko nghĩ sở dĩ mình ở đây...
Dialogue: 0,0:21:56.29,0:21:57.75,Default,Fuk,0,0,0,,...làm việc này...
Dialogue: 0,0:21:57.75,0:21:59.96,Default,Fuk,0,0,0,,...chính là vì Fuko không thể nhìn thấy hay nói chuyện cùng chị ấy được nữa.
Dialogue: 0,0:21:59.96,0:22:02.21,Default,Fuk,0,0,0,,Bởi vì ngoài việc này ra, Fuko chẳng còn làm được gì khác cho chị cả.
Dialogue: 0,0:22:02.21,0:22:05.30,Default,Ibu,0,0,0,,Ủa, có chuyện gì thế các em?
Dialogue: 0,0:22:05.84,0:22:09.80,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad2.5\pos(1460,840)}Còn tiếp
Dialogue: 0,0:22:05.92,0:22:06.80,Default,Ibu,0,0,0,,Nagisa-chan?
Dialogue: 0,0:22:07.34,0:22:08.43,Default,Ibu,0,0,0,,Okazaki-san?
