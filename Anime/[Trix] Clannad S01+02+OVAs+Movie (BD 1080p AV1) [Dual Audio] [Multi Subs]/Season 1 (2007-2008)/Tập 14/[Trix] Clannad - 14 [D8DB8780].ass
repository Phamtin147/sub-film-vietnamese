Dialogue: 0,0:19:50.54,0:19:51.66,Default,Dad,0,0,0,,Kotomi yêu dấu của cha mẹ.
Dialogue: 0,0:19:53.04,0:19:54.67,Default,Dad,0,0,0,,Thế giới này tươi đẹp lắm con à.
Dialogue: 0,0:19:56.13,0:20:00.51,Default,Dad,0,0,0,,Ngay cả khi nó ngập tràn những nỗi buồn đau và nước mắt, con hãy mở to đôi mắt mình.
Dialogue: 0,0:20:02.13,0:20:03.97,Default,Dad,0,0,0,,Hãy làm những điều con ước ao.
Dialogue: 0,0:20:05.26,0:20:07.43,Default,Dad,0,0,0,,Hãy trở thành người mà con hằng mong muốn.
Dialogue: 0,0:20:09.43,0:20:11.18,Default,Dad,0,0,0,,Hãy kết thật nhiều bạn bè.
Dialogue: 0,0:20:13.14,0:20:17.48,Default,Dad,0,0,0,,Đừng vội vã, hãy thong thả từng bước trưởng thành con nhé.
Dialogue: 0,0:20:26.32,0:20:29.24,Default,Mom,0,0,0,,Đây là chú gấu bông cha mẹ tìm thấy ở một cửa hàng lưu niệm.
Dialogue: 0,0:20:30.12,0:20:34.33,Default,Mom,0,0,0,,Cha mẹ đã tìm khắp muôn nơi, và đây là chú gấu to nhất.
Dialogue: 0,0:20:36.00,0:20:39.75,Default,Mom,0,0,0,,Cha mẹ vội quá nên không kịp gửi bưu kiện từ sân bay về cho con.
Dialogue: 0,0:20:41.21,0:20:42.67,Default,Mom,0,0,0,,Gửi Kotomi bé bỏng đáng yêu của cha mẹ...
Dialogue: 0,0:20:43.97,0:20:46.43,Default,Mom,0,0,0,,Chúc mừng sinh nhật con gái.
Dialogue: 0,0:21:12.12,0:21:14.08,Default,Kot,0,0,0,,Xin chào tất cả mọi người nhé.
Dialogue: 0,0:21:14.08,0:21:15.71,Default,All,0,0,0,,Chào các cậu.
Dialogue: 0,0:21:26.01,0:21:28.84,Default,Oka,0,0,0,,Bọn tớ đã mời cả Sunohara lẫn Miyazawa nữa đấy.
Dialogue: 0,0:21:28.84,0:21:30.76,Default,Oka,0,0,0,,Hai bạn ấy đang đi lấy đồ ăn rồi.
Dialogue: 0,0:21:31.22,0:21:35.35,Default,Nag,0,0,0,,Cả bố và mẹ tớ lát nữa cũng sẽ sang.
Dialogue: 0,0:21:35.35,0:21:38.52,Default,Ryo,0,0,0,,Khi mọi người đến đông đủ rồi,\Nchúng ta sẽ tổ chức lễ trao tặng quà nhé.
Dialogue: 0,0:21:38.52,0:21:41.86,Default,Kot,0,0,0,,Được rồi. Tớ cũng làm thêm một ít đồ ngọt nữa này.
Dialogue: 0,0:21:42.90,0:21:45.40,Default,Oka,0,0,0,,Tớ cá là cậu lại làm nhiều quá mức nữa rồi chứ gì?
Dialogue: 0,0:21:46.70,0:21:49.37,Default,Kyo,0,0,0,,Hôm nay thì cậu có làm bao nhiêu cũng chẳng sao hết.
Dialogue: 0,0:21:49.74,0:21:53.74,Default,Kyo,0,0,0,,Giống như buổi hòa nhạc hôm trước, tớ đã rủ rất đông người đến đấy.
Dialogue: 0,0:21:54.20,0:21:57.08,Default,Oka,0,0,0,,Này, thế thì đông người quá mức rồi.
Dialogue: 0,0:21:57.08,0:21:58.96,Default,Oka,0,0,0,,Liệu có đủ chỗ cho tất cả mọi người không đấy?
Dialogue: 0,0:22:01.50,0:22:03.09,Default,Kot,0,0,0,,Sẽ ổn thôi mà.
Dialogue: 0,0:22:04.26,0:22:06.63,Default,Kot,0,0,0,,Dù sao thì khu vườn nhà mình cũng rộng rãi lắm.
