Dialogue: 0,0:03:00.74,0:03:02.28,Default,Kyo,0,0,0,,Hẹn gặp lại các cậu vào ngày mai.
Dialogue: 0,0:03:02.78,0:03:05.78,Default,Ryo,0,0,0,,Hai cậu đừng làm việc quá sức đấy nhé.
Dialogue: 0,0:03:06.54,0:03:07.74,Default,Oka,0,0,0,,Bọn tớ biết rồi.
Dialogue: 0,0:03:08.16,0:03:09.29,Default,Nag,0,0,0,,Chúc cậu ngủ ngon.
Dialogue: 0,0:03:15.46,0:03:18.34,Default,Nag,0,0,0,,Liệu ngày mai có xong kịp không cậu?
Dialogue: 0,0:03:18.67,0:03:19.55,Default,Oka,0,0,0,,Dễ như ăn bánh thôi mà.
Dialogue: 0,0:03:20.09,0:03:22.93,Default,Oka,0,0,0,,Thực ra đêm nay tớ định thức trắng để làm cho xong.
Dialogue: 0,0:03:24.34,0:03:24.93,Default,Nag,0,0,0,,Nếu vậy thì—
Dialogue: 0,0:03:24.93,0:03:25.97,Default,Oka,0,0,0,,Không được!
Dialogue: 0,0:03:26.56,0:03:28.60,Default,Nag,0,0,0,,Tớ đã kịp nói gì đâu nào.
Dialogue: 0,0:03:29.10,0:03:31.56,Default,Oka,0,0,0,,Cậu định bảo cậu sẽ ở lại cùng làm chứ gì?
Dialogue: 0,0:03:31.56,0:03:32.52,Default,Oka,0,0,0,,Tuyệt đối không được đâu đấy.
Dialogue: 0,0:03:32.52,0:03:38.48,Default,Oka,0,0,0,,Nếu cậu mà bị sốt hay ngã bệnh, ông già cậu nổi điên lên cấm cửa tớ sang nhà vĩnh viễn mất.
Dialogue: 0,0:03:38.48,0:03:42.78,Default,Nag,0,0,0,,Nhưng chẳng phải tối qua cậu cũng làm việc tới tận khuya sao?
Dialogue: 0,0:03:42.78,0:03:46.70,Default,Oka,0,0,0,,Chừng này ăn thua gì so với\Nnhững buổi tập luyện bên đội bóng rổ chứ.
Dialogue: 0,0:03:50.37,0:03:55.46,Default,Nag,0,0,0,,Vâng. Vậy khi nào cần giúp đỡ cậu cứ bảo tớ bất cứ lúc nào nhé.
Dialogue: 0,0:04:03.76,0:04:05.30,Default,Oka,0,0,0,,Trời ạ, mệt rã rời cả người rồi.
Dialogue: 0,0:04:12.52,0:04:13.35,Default,Oka,0,0,0,,Kotomi.
Dialogue: 0,0:04:14.10,0:04:16.36,Default,Oka,0,0,0,,Mọi người ai nấy đều lo lắng cho cậu đấy.
Dialogue: 0,0:04:16.36,0:04:17.94,Default,Oka,0,0,0,,Cậu hiểu điều đó mà, đúng không?
Dialogue: 0,0:04:21.61,0:04:24.74,Default,Man,0,0,0,,Những gì chúng ta quan sát được không phải là vũ trụ duy nhất.
Dialogue: 0,0:04:25.24,0:04:30.62,Default,Man,0,0,0,,Còn có một chiều không gian bị tách rời và phong ấn khi thế giới này thành hình.
Dialogue: 0,0:04:30.95,0:04:33.16,Default,Man,0,0,0,,Thế giới bị che giấu.
Dialogue: 0,0:04:34.37,0:04:36.88,Default,Oka,0,0,0,,Thế giới bị che giấu sao...
Dialogue: 0,0:04:51.89,0:04:53.81,Default,Oka,0,0,0,,Có vẻ như mình đã làm xong kịp giờ rồi.
Dialogue: 0,0:05:02.86,0:05:05.95,Default,Oka,0,0,0,,Giờ đọc cuốn sách này chắc cậu không phiền đâu nhỉ?
Dialogue: 0,0:05:07.11,0:05:08.82,Default,Oka,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:05:08.82,0:05:10.20,Default,Oka,0,0,0,,hôm qua tớ thấy một chú hươu,
Dialogue: 0,0:05:11.33,0:05:14.54,Default,Oka,0,0,0,,Ra vậy, hóa ra cậu ấy trích dẫn những câu thoại trong cuốn sách này.
Dialogue: 0,0:05:26.97,0:05:29.22,Default,Kot,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:05:29.76,0:05:31.26,Default,Kot,0,0,0,,hôm qua tớ thấy một chú hươu,
Dialogue: 0,0:05:33.06,0:05:34.43,Default,Kot,0,0,0,,và hôm nay, tớ thấy cậu.
Dialogue: 0,0:05:44.28,0:05:46.24,Default,Oka,0,0,0,,Mình đang ở đâu thế này?
Dialogue: 0,0:06:09.80,0:06:11.51,Default,Kot,0,0,0,,Cậu là ai thế?
Dialogue: 0,0:06:12.26,0:06:14.01,Default,Kot,0,0,0,,Sao cậu lại ở đây?
Dialogue: 0,0:06:14.72,0:06:17.14,Default,Oka,0,0,0,,Tớ mải chơi nên đi lạc vào đây.
Dialogue: 0,0:06:17.77,0:06:19.02,Default,Oka,0,0,0,,Cậu là ai?
Dialogue: 0,0:06:19.44,0:06:20.56,Default,Kot,0,0,0,,Kotomi.
Dialogue: 0,0:06:20.56,0:06:22.94,Default,Kot,0,0,0,,Tên Kotomi viết bằng ba chữ hiragana.
Dialogue: 0,0:06:22.94,0:06:24.78,Default,Kot,0,0,0,,Khi gọi mình, hãy gọi mình là Kotomi-chan nhé.
Dialogue: 0,0:06:24.78,0:06:27.74,Default,Mom,0,0,0,,Ô kìa, nhà mình có một vị khách nhí đáng yêu ghê.
Dialogue: 0,0:06:30.41,0:06:32.95,Default,Oka,0,0,0,,Đó là cách tớ đã gặp gỡ Kotomi.
Dialogue: 0,0:06:33.91,0:06:35.62,Default,Kot,0,0,0,,Mời cậu dùng bữa nhé.
Dialogue: 0,0:06:36.16,0:06:37.37,Default,Oka,0,0,0,,Xin mời cậu dùng bữa.
Dialogue: 0,0:06:41.63,0:06:43.59,Default,Kot,0,0,0,,Đây là hoa anh túc California này.
Dialogue: 0,0:06:43.59,0:06:45.92,Default,Kot,0,0,0,,Còn đây là hoa bướm pansy.
Dialogue: 0,0:06:48.55,0:06:53.14,Default,Mom,0,0,0,,Kotomi-chan, trời đẹp thế này sao cậu không ra ngoài chơi?
Dialogue: 0,0:06:57.31,0:06:58.77,Default,Kot,0,0,0,,Chúng mình đang ở ngoài trời rồi mà.
Dialogue: 0,0:06:59.85,0:07:03.15,Default,Mom,0,0,0,,"Bên ngoài" là ở phía bên kia hàng rào cơ.
Dialogue: 0,0:07:03.73,0:07:08.90,Default,Mom,0,0,0,,Đó là một thế giới rộng lớn bao la với biết bao điều cậu chưa từng biết tới.
Dialogue: 0,0:07:09.53,0:07:10.90,Default,Kot,0,0,0,,Đáng sợ lắm, tớ không muốn đi đâu.
Dialogue: 0,0:07:13.28,0:07:15.95,Default,Kot,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:07:15.95,0:07:17.70,Default,Kot,0,0,0,,hôm qua tớ thấy một chú hươu,
Dialogue: 0,0:07:17.70,0:07:18.95,Default,Kot,0,0,0,,và hôm nay, tớ thấy cậu.
Dialogue: 0,0:07:18.95,0:07:22.71,Default,Oka,0,0,0,,Kotomi không thích bước chân ra bên ngoài.
Dialogue: 0,0:07:23.33,0:07:26.63,Default,Oka,0,0,0,,Tớ chưa từng thấy người bạn nào khác đến nhà thăm cậu ấy.
Dialogue: 0,0:07:27.75,0:07:32.47,Default,Oka,0,0,0,,Này, hôm sinh nhật cậu tớ rủ bạn bè sang cùng được không?
Dialogue: 0,0:07:33.64,0:07:37.01,Default,Oka,0,0,0,,Tớ muốn cùng mọi người chúc mừng sinh nhật cậu.
Dialogue: 0,0:07:37.01,0:07:38.89,Default,Oka,0,0,0,,Chắc chắn sẽ vui lắm đấy.
Dialogue: 0,0:07:41.10,0:07:44.10,Default,Guy,0,0,0,,Hả? Đi dự sinh nhật một đứa con gái mà tụi mình không quen biết á?
Dialogue: 0,0:07:44.10,0:07:47.57,Default,Guy,0,0,0,,Đến sinh nhật con gái ngượng chết đi được, ai mà đi chứ?
Dialogue: 0,0:07:53.86,0:07:59.49,Default,Oka,0,0,0,,Không biết phải đối diện với cậu ấy ra sao,\Ntớ chẳng thể nào cất bước đến khu vườn được.
Dialogue: 0,0:08:03.25,0:08:07.04,Default,Oka,0,0,0,,Mãi cho tới khi trời sập tối tớ mới hạ quyết tâm phải đến đó.
Dialogue: 0,0:08:07.54,0:08:11.47,Default,Oka,0,0,0,,Tớ cảm thấy mình nhất định phải xin lỗi vì đã bỏ lỡ tiệc sinh nhật của cậu ấy.
Dialogue: 0,0:08:17.97,0:08:18.81,Default,Oka,0,0,0,,Cái gì thế này?
Dialogue: 0,0:08:26.94,0:08:27.86,Default,Oka,0,0,0,,Kotomi-chan?!
Dialogue: 0,0:08:51.59,0:08:53.34,Default,Kot,0,0,0,,Tớ đã đốt nó rồi...
Dialogue: 0,0:08:54.26,0:08:58.93,Default,Kot,0,0,0,,Tớ đã đốt cháy tài liệu của cha và mẹ rồi!
Dialogue: 0,0:09:18.20,0:09:21.99,Default,Guy,0,0,0,,Không, cháu không có lý do gì phải khóc cả.
Dialogue: 0,0:09:22.66,0:09:25.21,Default,Guy,0,0,0,,Tập tài liệu cháu vừa đốt là món đồ dành riêng cho cháu đấy.
Dialogue: 0,0:09:37.26,0:09:40.14,Default,Oka,0,0,0,,Kể từ sau ngày hôm đó, tớ không bao giờ gặp lại Kotomi nữa.
Dialogue: 0,0:09:40.93,0:09:44.93,Default,Oka,0,0,0,,Tớ từng ghé qua nhà cậu ấy vài lần sau đó, nhưng chẳng thể nào gặp được.
Dialogue: 0,0:09:46.77,0:09:48.06,Default,Oka,0,0,0,,Cuộc hội ngộ với Kotomi...
Dialogue: 0,0:09:48.98,0:09:50.90,Default,Oka,0,0,0,,Tất cả khoảng thời gian gắn bó trong khu vườn ấy...
Dialogue: 0,0:09:51.77,0:09:54.15,Default,Oka,0,0,0,,Mọi thứ ngỡ như chỉ là một giấc mơ thoáng qua.
Dialogue: 0,0:09:56.19,0:10:00.82,Default,Oka,0,0,0,,Và rồi cuối cùng, tớ đã quên đi tất cả.
Dialogue: 0,0:10:03.41,0:10:05.33,Default,Kot,0,0,0,,Cậu là ai thế?
Dialogue: 0,0:10:05.79,0:10:07.91,Default,Kot,0,0,0,,Sao cậu lại ở đây?
Dialogue: 0,0:10:09.83,0:10:11.42,Default,Kot,0,0,0,,Cậu đã dậy rồi à?
Dialogue: 0,0:10:13.21,0:10:16.05,Default,Oka,0,0,0,,Chắc mình vẫn còn đang ngủ mơ.
Dialogue: 0,0:10:17.05,0:10:22.18,Default,Kot,0,0,0,,Tớ luôn nhớ về cậu bé đã vô tình lạc bước vào khu vườn.
Dialogue: 0,0:10:24.01,0:10:29.23,Default,Kot,0,0,0,,Tớ thực sự, thực sự rất thích cậu bé ấy.
Dialogue: 0,0:10:30.40,0:10:34.02,Default,Kot,0,0,0,,Cậu ấy là người bạn duy nhất của tớ...
Dialogue: 0,0:10:35.44,0:10:35.98,Default,Kot,0,0,0,,...thế nên...
Dialogue: 0,0:10:39.03,0:10:41.07,Default,Kot,0,0,0,,...thế nên tớ vẫn luôn ngóng chờ cậu ấy.
Dialogue: 0,0:10:42.49,0:10:43.53,Default,Oka,0,0,0,,Kotomi.
Dialogue: 0,0:10:44.37,0:10:46.87,Default,Kot,0,0,0,,Hôm kia tớ thấy một chú thỏ,
Dialogue: 0,0:10:47.45,0:10:48.83,Default,Kot,0,0,0,,và hôm qua tớ thấy một chú hươu,
Dialogue: 0,0:10:49.37,0:10:50.79,Default,Kot,0,0,0,,và hôm nay, tớ thấy cậu.
Dialogue: 0,0:10:50.79,0:10:52.96,Default,Kot,0,0,0,,Cậu là Tomoya-kun.
Dialogue: 0,0:10:58.38,0:10:59.55,Default,Oka,0,0,0,,Tớ đến để đón cậu này.
Dialogue: 0,0:10:59.92,0:11:02.18,Default,Oka,0,0,0,,Mọi người đều đang ngóng đợi cậu đấy.
Dialogue: 0,0:11:23.11,0:11:25.87,Default,Kot,0,0,0,,Bầu trời hôm nay đẹp quá.
Dialogue: 0,0:11:26.16,0:11:26.91,Default,Oka,0,0,0,,Ừ, đẹp lắm.
Dialogue: 0,0:11:33.33,0:11:34.63,Default,Nag,0,0,0,,Cậu ấy đến rồi kìa!
Dialogue: 0,0:11:45.47,0:11:47.18,Default,Kyo,0,0,0,,Chào buổi sáng, Kotomi.
Dialogue: 0,0:11:47.72,0:11:48.81,Default,Ryo,0,0,0,,Chào buổi sáng nhé.
Dialogue: 0,0:11:49.35,0:11:50.81,Default,Nag,0,0,0,,Chào buổi sáng cậu.
Dialogue: 0,0:11:52.56,0:11:54.02,Default,Oka,0,0,0,,Chào buổi sáng, Kotomi.
Dialogue: 0,0:11:54.52,0:11:56.61,Default,Kot,0,0,0,,Chào buổi sáng tất cả các cậu.
Dialogue: 0,0:11:58.27,0:12:00.44,Default,Kot,0,0,0,,Mọi người đều đang đứng đợi mình sao?
Dialogue: 0,0:12:01.28,0:12:02.53,Default,Kyo,0,0,0,,Đương nhiên rồi!
Dialogue: 0,0:12:02.53,0:12:04.57,Default,Oka,0,0,0,,Hôm nay là sinh nhật của cậu mà.
Dialogue: 0,0:12:05.91,0:12:06.95,Default,Kot,0,0,0,,A, phải rồi.
Dialogue: 0,0:12:08.62,0:12:11.08,Default,Kyo,0,0,0,,Và về món quà tặng cậu...
Dialogue: 0,0:12:11.83,0:12:12.54,Default,Kyo,0,0,0,,Của cậu đây này.
Dialogue: 0,0:12:13.62,0:12:15.79,Default,Kot,0,0,0,,Phiếu quà tặng vĩ cầm.
Dialogue: 0,0:12:15.79,0:12:19.05,Default,Nag,0,0,0,,Là cây vĩ cầm mà cậu thích đấy.
Dialogue: 0,0:12:19.42,0:12:23.26,Default,Nag,0,0,0,,Bọn tớ định tặng cậu hôm nay, nhưng nó bị hỏng mất.
Dialogue: 0,0:12:23.26,0:12:28.22,Default,Ryo,0,0,0,,Đàn sửa được, nhưng không thể kịp lấy về trước ngày hôm nay.
Dialogue: 0,0:12:28.22,0:12:32.27,Default,Kyo,0,0,0,,Khi nào sửa xong bọn tớ sẽ trao tận tay cậu, nên cậu hãy giữ lấy phiếu này trước nhé.
Dialogue: 0,0:12:36.94,0:12:38.27,Default,Kot,0,0,0,,Mình cảm ơn các cậu nhiều lắm.
Dialogue: 0,0:12:39.44,0:12:40.90,Default,Teacher,0,0,0,,Ichinose-san!
Dialogue: 0,0:12:42.32,0:12:46.24,Default,Teacher,0,0,0,,Tuyệt vời quá. Thầy mừng vì em đã chịu đến trường trở lại.
Dialogue: 0,0:12:46.70,0:12:50.03,Default,Kot,0,0,0,,Thầy ơi, chào buổi sáng thầy ạ.
Dialogue: 0,0:12:50.99,0:12:52.00,Default,Teacher,0,0,0,,Chào buổi sáng em.
Dialogue: 0,0:12:52.41,0:12:57.29,Default,Teacher,0,0,0,,Người giám hộ của em hôm nay sẽ đến đây đấy.
Dialogue: 0,0:12:57.29,0:12:59.25,Default,Teacher,0,0,0,,Chú ấy bảo có một món đồ muốn trao tận tay cho em.
Dialogue: 0,0:13:02.51,0:13:06.72,Default,Oka,0,0,0,,Đừng lo. Chú ấy không phải là người xấu xa đâu.
Dialogue: 0,0:13:07.43,0:13:08.93,Default,Oka,0,0,0,,Thực ra trong thâm tâm em cũng biết điều đó mà, đúng không?
Dialogue: 0,0:13:14.06,0:13:16.39,Default,Kyo,0,0,0,,Chúng mình mời chú ấy vào phòng câu lạc bộ kịch nhé.
Dialogue: 0,0:13:16.73,0:13:19.56,Default,Kyo,0,0,0,,Như thế cậu sẽ thấy thoải mái dễ chịu hơn.
Dialogue: 0,0:13:19.90,0:13:22.07,Default,Nag,0,0,0,,Bọn tớ sẽ ở bên cạnh cậu.
Dialogue: 0,0:13:22.57,0:13:24.53,Default,Nag,0,0,0,,Chúng mình cùng đi gặp chú ấy nhé, Kotomi-chan.
Dialogue: 0,0:13:28.32,0:13:28.95,Default,Kot,0,0,0,,Ừm.
Dialogue: 0,0:13:34.12,0:13:35.54,Default,Guy,0,0,0,,Kotomi-kun.
Dialogue: 0,0:13:37.54,0:13:40.59,Default,Oka,0,0,0,,Cháu xin lỗi vì đã để chú phải lặn lội tới tận đây.
Dialogue: 0,0:13:40.59,0:13:43.71,Default,Guy,0,0,0,,Không sao đâu. Chú rất vui vì hôm nay được gặp lại cháu.
Dialogue: 0,0:13:48.89,0:13:50.55,Default,Kot,0,0,0,,Đây là chiếc vali của cha.
Dialogue: 0,0:13:56.35,0:13:59.10,Default,Guy,0,0,0,,Chiếc vali này được chuyển đến phòng nghiên cứu vào đêm muộn hôm qua.
Dialogue: 0,0:13:59.81,0:14:04.03,Default,Guy,0,0,0,,Chú đã mở ra và xác nhận đúng là đồ của tiến sĩ Ichinose,
Dialogue: 0,0:14:04.65,0:14:08.28,Default,Guy,0,0,0,,và chú tự nhủ nhất định phải trao tận tay món đồ này cho cháu trong ngày hôm nay.
Dialogue: 0,0:14:10.53,0:14:12.45,Default,Kot,0,0,0,,Luận án của cha mẹ có ở bên trong không chú?
Dialogue: 0,0:14:12.87,0:14:14.04,Default,Guy,0,0,0,,Cháu hãy tự mình mở ra xem đi.
Dialogue: 0,0:14:21.96,0:14:24.67,Default,Oka,0,0,0,,Bọn tớ luôn ở bên cạnh cậu mà, Kotomi.
Dialogue: 0,0:14:24.67,0:14:26.97,Default,Kyo,0,0,0,,Cậu ấy nói đúng đấy. Cố lên nhé, Kotomi!
Dialogue: 0,0:15:00.29,0:15:01.88,Default,Kyo,0,0,0,,Nó viết cái gì thế?
Dialogue: 0,0:15:01.88,0:15:03.59,Default,Oka,0,0,0,,Đừng hỏi tôi.
Dialogue: 0,0:15:03.59,0:15:04.50,Default,Ryo,0,0,0,,Để xem nào...
Dialogue: 0,0:15:04.50,0:15:07.67,Default,Ryo,0,0,0,,Nếu bạn... chiếc vali này...
Dialogue: 0,0:15:07.67,0:15:12.89,Default,Kot,0,0,0,,"Nếu bạn tìm thấy chiếc vali này, xin vui lòng mang nó đến cho con gái chúng tôi."
Dialogue: 0,0:15:13.43,0:15:17.81,Default,Guy,0,0,0,,Chữ ký là chữ viết tắt tên của\Ntiến sĩ Ichinose Koutarou và tiến sĩ Ichinose Mizue.
Dialogue: 0,0:15:17.81,0:15:20.52,Default,Guy,0,0,0,,Nói cách khác, chính là cha và mẹ của Kotomi-kun.
Dialogue: 0,0:15:21.19,0:15:26.15,Default,Kot,0,0,0,,Đây là cách hai người luôn ký tên trên các công trình nghiên cứu đồng tác giả.
Dialogue: 0,0:15:26.48,0:15:29.19,Default,Guy,0,0,0,,Chiếc vali này thực sự thuộc về vợ chồng tiến sĩ Ichinose.
Dialogue: 0,0:15:29.19,0:15:34.07,Default,Guy,0,0,0,,Hẳn là sau một thời gian dài trôi dạt, nó đã dạt vào bờ biển.
Dialogue: 0,0:15:35.33,0:15:39.91,Default,Guy,0,0,0,,Có ai đó đã tìm thấy chiếc vali, mở ra và đọc được bức thư này.
Dialogue: 0,0:15:39.91,0:15:42.12,Default,Guy,0,0,0,,Rồi trao nó lại cho một người khác.
Dialogue: 0,0:15:43.17,0:15:48.34,Default,Guy,0,0,0,,Chiếc vali này chắc chắn đã được truyền tay từ người này sang người khác như thế.
Dialogue: 0,0:15:48.96,0:15:54.51,Default,Guy,0,0,0,,Có nhiều dấu vết cho thấy đã có vài người chăm chút sửa sang lại chú gấu bông và chiếc vali.
Dialogue: 0,0:15:57.64,0:16:03.73,Default,Guy,0,0,0,,Có lẽ cháu không biết thứ đựng bên trong chiếc phong bì mà cháu từng đốt năm xưa là gì đúng không?
Dialogue: 0,0:16:05.36,0:16:07.61,Default,Kot,0,0,0,,Không phải là luận án cha mẹ viết sao chú?
Dialogue: 0,0:16:10.53,0:16:13.95,Default,Guy,0,0,0,,Chưa bao giờ có bản sao thứ hai của luận án đó cả.
Dialogue: 0,0:16:15.57,0:16:21.96,Default,Guy,0,0,0,,Cha cháu đã chỉnh sửa luận án đến tận phút chót, nên chắc chắn không có thời gian tạo bản sao thứ hai.
Dialogue: 0,0:16:21.96,0:16:23.87,Default,Kot,0,0,0,,Vậy thì thứ bên trong phong bì là gì ạ?
Dialogue: 0,0:16:25.08,0:16:30.25,Default,Kot,0,0,0,,Bên trong đó là cuốn danh mục giới thiệu những chú gấu bông.
Dialogue: 0,0:16:31.59,0:16:35.26,Default,Guy,0,0,0,,Có lẽ nếu chú nói điều này trước đây thì cháu sẽ không bao giờ tin,
Dialogue: 0,0:16:35.80,0:16:38.72,Default,Guy,0,0,0,,nhưng chú nghĩ giờ đây cháu sẽ tin lời chú.
Dialogue: 0,0:16:39.22,0:16:41.02,Default,Guy,0,0,0,,Chú vẫn nhớ như in ngày hôm đó.
Dialogue: 0,0:16:41.47,0:16:45.02,Default,Guy,0,0,0,,"Lần đầu tiên con gái tôi chịu nói ra món quà nó muốn."
Dialogue: 0,0:16:45.73,0:16:49.73,Default,Guy,0,0,0,,Gương mặt cha cháu lúc nói câu đó rạng rỡ hạnh phúc xiết bao.
Dialogue: 0,0:16:49.73,0:16:53.53,Default,Kot,0,0,0,,Thế nhưng tập luận án đáng lẽ phải nằm trong chiếc vali này chứ ạ?
Dialogue: 0,0:16:53.95,0:16:56.28,Default,Kot,0,0,0,,Luận án của cha và mẹ...
Dialogue: 0,0:16:57.62,0:16:58.74,Default,Guy,0,0,0,,Cháu hãy đọc đi.
Dialogue: 0,0:17:11.30,0:17:12.67,Default,Kot,0,0,0,,"Kotomi yêu dấu của cha mẹ."
Dialogue: 0,0:17:12.67,0:17:14.59,Default,Kot,0,0,0,,"Thế giới này tươi đẹp lắm con à."
Dialogue: 0,0:17:15.05,0:17:17.55,Default,Kot,0,0,0,,"Ngay cả khi nó dường như ngập tràn những nỗi buồn đau và nước mắt..."
Dialogue: 0,0:17:18.01,0:17:20.14,Default,Kot,0,0,0,,Đây chính là nét chữ của cha!
Dialogue: 0,0:17:23.93,0:17:26.19,Signs,,0,0,0,,{\pos(960,296)\c&H7D9AB3&}Gửi Kotomi bé bỏng đáng yêu của cha mẹ,
Dialogue: 0,0:17:23.93,0:17:26.19,Signs,,0,0,0,,{\pos(960,629)\c&H6D8FBE&\b0}Chúc mừng sinh nhật con gái.
Dialogue: 0,0:17:26.98,0:17:28.27,Default,Kot,0,0,0,,Mẹ ơi...
Dialogue: 0,0:17:30.15,0:17:35.19,Default,Guy,0,0,0,,Cha và mẹ của cháu đã vứt bỏ tất cả mọi thứ khác bên trong, kể cả tập luận án nghiên cứu,
Dialogue: 0,0:17:35.19,0:17:38.41,Default,Guy,0,0,0,,để thay vào đó đặt chú gấu bông này cùng với lá thư chúc mừng sinh nhật cháu.
Dialogue: 0,0:17:39.28,0:17:48.25,Default,Guy,0,0,0,,Cha mẹ cháu đã cố gắng diễn tả nguồn gốc của thế giới một cách đẹp đẽ, thuần khiết và súc tích nhất.
Dialogue: 0,0:17:48.88,0:17:54.71,Default,Guy,0,0,0,,Thế nhưng chú chưa từng thấy điều gì đẹp đẽ hơn những ngôn từ chan chứa yêu thương trong bức thư ấy.
Dialogue: 0,0:17:55.67,0:18:01.35,Default,Guy,0,0,0,,Cha và mẹ cháu cho đến tận giây phút cuối cùng vẫn chỉ một lòng cầu chúc cho hạnh phúc của cháu mà thôi.
Dialogue: 0,0:18:02.85,0:18:04.60,Default,Kot,0,0,0,,Cha ơi, mẹ ơi.
Dialogue: 0,0:18:05.48,0:18:08.60,Default,Kot,0,0,0,,Bao nhiêu năm qua con vẫn luôn chờ đợi cha mẹ.
Dialogue: 0,0:18:09.23,0:18:13.44,Default,Kot,0,0,0,,Bao nhiêu năm qua con chỉ biết khóc một mình trong căn nhà vắng.
Dialogue: 0,0:18:13.98,0:18:18.32,Default,Kot,0,0,0,,Và rồi, Tomoya-kun đã đến để đón con.
Dialogue: 0,0:18:19.57,0:18:23.16,Default,Kot,0,0,0,,Giờ đây con hạnh phúc lắm cha mẹ ơi.
Dialogue: 0,0:18:23.74,0:18:26.08,Default,Kot,0,0,0,,Con đang thực sự, thực sự vô cùng hạnh phúc.
Dialogue: 0,0:18:26.83,0:18:27.71,Default,Kot,0,0,0,,Vì thế nên...
Dialogue: 0,0:18:28.66,0:18:29.67,Default,Kot,0,0,0,,Vì thế nên là...
Dialogue: 0,0:18:31.92,0:18:34.46,Default,Kot,0,0,0,,Cha ơi... Mẹ ơi...
Dialogue: 0,0:18:36.51,0:18:37.92,Default,Kot,0,0,0,,Mừng cha mẹ đã trở về nhà.
Dialogue: 0,0:18:46.10,0:18:49.77,Default,Oka,0,0,0,,Chiếc vali ấy hẳn đã chu du qua khắp thế gian.
Dialogue: 0,0:18:53.06,0:18:54.52,Default,Oka,0,0,0,,Những thành phố giữa sa mạc cát bỏng,
Dialogue: 0,0:18:54.52,0:18:55.73,Default,Oka,0,0,0,,những hòn đảo băng giá lạnh căm,
Dialogue: 0,0:18:56.23,0:18:57.78,Default,Oka,0,0,0,,những rặng núi non hiểm trở,
Dialogue: 0,0:18:57.78,0:18:59.20,Default,Oka,0,0,0,,và những bình nguyên xanh ngắt ngút ngàn.
Dialogue: 0,0:18:59.90,0:19:02.53,Default,Oka,0,0,0,,Từ bàn tay người này sang bàn tay người khác.
Dialogue: 0,0:19:02.99,0:19:04.91,Default,Oka,0,0,0,,Nó được nâng niu truyền đi với tất cả sự trân trọng yêu thương.
Dialogue: 0,0:19:06.49,0:19:47.37,Default,Dad,0,0,0,,{\1a&H30\3a&H30\4a&H60}Nếu bạn tìm thấy chiếc vali này, xin vui lòng mang nó đến cho con gái chúng tôi.
Dialogue: 0,0:19:06.49,0:19:10.71,Lang1,Note,0,0,0,,{\pos(960,27)\fad(0,570)}この鞄を見つけたら、どうか娘に届けてください。
Dialogue: 0,0:19:10.16,0:19:14.25,Lang2,Note,0,0,0,,{\pos(960,21.6)\fad(570,1960)}If you find this suitcase, please take it to our daughter.
