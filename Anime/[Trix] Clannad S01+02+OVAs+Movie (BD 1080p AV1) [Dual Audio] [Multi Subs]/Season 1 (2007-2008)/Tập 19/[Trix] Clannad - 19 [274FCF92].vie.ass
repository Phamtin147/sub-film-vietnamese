Dialogue: 0,0:02:48.39,0:03:00.82,OP English,,0,0,0,,{\fad(250,250)\be1}Chẳng giữ lại chút gì cho riêng mình.
Dialogue: 0,0:03:06.66,0:03:07.79,Default,Oka,0,0,0,,Đến thăm nhà em á?
Dialogue: 0,0:03:08.41,0:03:10.54,Default,Teacher,0,0,0,,Hôm nay thầy sẽ đến gặp bố em.
Dialogue: 0,0:03:10.54,0:03:11.92,Default,Teacher,0,0,0,,Thầy muốn thảo luận về định hướng tương lai của em với bác ấy.
Dialogue: 0,0:03:11.92,0:03:13.71,Default,Oka,0,0,0,,Thầy không cần phải làm thế đâu ạ.
Dialogue: 0,0:03:13.71,0:03:15.25,Default,Teacher,0,0,0,,Tất nhiên là thầy phải đi rồi.
Dialogue: 0,0:03:15.25,0:03:18.05,Default,Teacher,0,0,0,,Hôm nọ em vừa bị đình chỉ học xong đấy.
Dialogue: 0,0:03:18.05,0:03:20.17,Default,Teacher,0,0,0,,Bố em có ở nhà không?
Dialogue: 0,0:03:20.17,0:03:22.13,Default,Oka,0,0,0,,Lúc có lúc không ạ.
Dialogue: 0,0:03:22.13,0:03:24.34,Default,Oka,0,0,0,,Có khi hôm nay ông ấy ra ngoài rồi.
Dialogue: 0,0:03:24.34,0:03:26.51,Default,Teacher,0,0,0,,Dù sao thì thầy cũng sẽ đến tận nơi xem sao.
Dialogue: 0,0:03:26.51,0:03:28.56,Default,Teacher,0,0,0,,Thầy đi chuẩn bị đồ đạc, em đứng đây đợi nhé.
Dialogue: 0,0:03:33.90,0:03:35.19,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:03:36.19,0:03:37.73,Default,Nag,0,0,0,,Có chuyện gì thế cậu?
Dialogue: 0,0:03:37.73,0:03:40.40,Default,Oka,0,0,0,,Cậu làm cái gì ở đây thế?
Dialogue: 0,0:03:40.40,0:03:43.78,Default,Nag,0,0,0,,Tớ muốn đến xin lời khuyên của thầy Koumura.
Dialogue: 0,0:03:43.78,0:03:45.82,Default,Nag,0,0,0,,Bắt đầu từ hôm nay tớ phải luyện tập thật nhiều mới được!
Dialogue: 0,0:03:45.82,0:03:49.16,Default,Nag,0,0,0,,Cậu đi cùng tớ nhé?
Dialogue: 0,0:03:49.16,0:03:51.33,Default,Oka,0,0,0,,Tôi chẳng quan tâm đâu.
Dialogue: 0,0:03:51.33,0:03:52.66,Default,Oka,0,0,0,,Tôi về nhà đây.
Dialogue: 0,0:03:53.92,0:03:55.00,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:03:55.00,0:03:57.88,Default,Nag,0,0,0,,Cậu đang nói trái ngược hoàn toàn với những lời ban nãy đấy nhé.
Dialogue: 0,0:03:57.88,0:04:01.38,Default,Nag,0,0,0,,Cậu bảo tớ phải hừng hực khí thế vươn tay nắm lấy ước mơ cơ mà.
Dialogue: 0,0:04:01.38,0:04:05.68,Default,Nag,0,0,0,,Những lời đó đã giúp tớ xua tan hết mọi do dự, thế mà cậu lại...
Dialogue: 0,0:04:05.68,0:04:07.47,Default,Oka,0,0,0,,Chuyện đó để sau hãy nói.
Dialogue: 0,0:04:08.01,0:04:09.60,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:04:10.35,0:04:12.27,Default,Oka,0,0,0,,Sao cậu lại bám theo tôi thế hả?
Dialogue: 0,0:04:12.27,0:04:15.23,Default,Nag,0,0,0,,Thì cậu tính đi đâu cơ chứ?
Dialogue: 0,0:04:18.98,0:04:22.95,Default,Teacher,0,0,0,,Em Okazaki Tomoya lớp 3-D. Okazaki Tomoya.
Dialogue: 0,0:04:22.95,0:04:24.99,Default,Teacher,0,0,0,,Lên phòng giám thị ngay lập tức.
Dialogue: 0,0:04:28.83,0:04:31.25,Default,Oka,0,0,0,,Cậu không cần phải kéo tay tôi thế đâu. Tôi không chạy trốn đâu mà.
Dialogue: 0,0:04:31.25,0:04:32.37,Default,Nag,0,0,0,,Tớ sẽ không buông tay đâu.
Dialogue: 0,0:04:32.37,0:04:34.83,Default,Oka,0,0,0,,Cậu không tin lời tôi nói à?
Dialogue: 0,0:04:34.83,0:04:35.33,Default,Nag,0,0,0,,Đúng vậy.
Dialogue: 0,0:04:35.33,0:04:37.21,Default,Oka,0,0,0,,Trả lời không thèm suy nghĩ lấy một giây luôn.
Dialogue: 0,0:04:37.21,0:04:40.63,Default,Nag,0,0,0,,Bởi vì thỉnh thoảng cậu hay nói dối lắm...
Dialogue: 0,0:04:40.96,0:04:44.63,Signs,,0,0,0,,{\fad(400,0)\fs26.666667\blur2\bord0.888889\pos(424,182.222222)\3c&H4A8A5C&}Tập 19
Dialogue: 0,0:04:40.96,0:04:44.63,Signs,,0,0,0,,{\fad(400,0)\fs26.666667\blur2\bord0.888889\3c&H4A8A5C&\pos(424,320)}Cuộc sống mới
Dialogue: 0,0:04:45.68,0:04:47.68,Default,Teacher,0,0,0,,Cảnh tượng này thú vị thật đấy.
Dialogue: 0,0:04:47.68,0:04:50.22,Default,Teacher,0,0,0,,Okazaki mà cũng có ngày bị một cô gái thuần phục cơ à.
Dialogue: 0,0:04:50.22,0:04:52.47,Default,Oka,0,0,0,,Đâu có phải như thế đâu thầy.
Dialogue: 0,0:04:53.02,0:04:55.73,Default,Nag,0,0,0,,Thường ngày toàn là cậu ấy chăm sóc cho em đấy ạ.
Dialogue: 0,0:04:57.23,0:04:59.40,Default,Teacher,0,0,0,,Okazaki dạo này thay đổi một chút rồi nhỉ.
Dialogue: 0,0:05:03.03,0:05:05.24,Default,Teacher,0,0,0,,Em có thể đi cùng tụi thầy được không?
Dialogue: 0,0:05:05.24,0:05:06.99,Default,Teacher,0,0,0,,Để canh chừng không cho Okazaki chuồn mất.
Dialogue: 0,0:05:06.99,0:05:09.99,Default,Nag,0,0,0,,Dạ vâng ạ. Nếu em có thể giúp được gì.
Dialogue: 0,0:05:09.99,0:05:13.62,Default,Oka,0,0,0,,C-Chẳng phải cậu có việc bận với thầy Koumura sao?
Dialogue: 0,0:05:13.62,0:05:16.71,Default,Nag,0,0,0,,A đúng rồi. Việc đó cũng quan trọng nữa.
Dialogue: 0,0:05:16.71,0:05:18.96,Default,Oka,0,0,0,,Trời đất. Đừng có ngơ ngẩn thế chứ.
Dialogue: 0,0:05:18.96,0:05:22.50,Default,Teacher,0,0,0,,Sao em có thể chịu đựng được cái cách ăn nói cộc cằn của nó thế nhỉ?
Dialogue: 0,0:05:23.30,0:05:25.09,Default,Nag,0,0,0,,Em quen rồi thầy ạ.
Dialogue: 0,0:05:26.30,0:05:30.47,Default,Guy,0,0,0,,Từ nhỏ tới giờ chỉ có hai bố con em sống với nhau thôi đúng không?
Dialogue: 0,0:05:30.47,0:05:31.51,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:05:31.51,0:05:33.85,Default,Teacher,0,0,0,,Chắc bố em phải vất vả lắm.
Dialogue: 0,0:05:33.85,0:05:37.44,Default,Teacher,0,0,0,,Thử nghĩ mà xem, một mình gà trống nuôi một thằng như em khôn lớn.
Dialogue: 0,0:05:37.44,0:05:38.23,Default,Oka,0,0,0,,Ai mà biết được chứ.
Dialogue: 0,0:05:40.48,0:05:41.82,Default,Oka,0,0,0,,Xem ra ông ấy ra ngoài rồi.
Dialogue: 0,0:05:45.57,0:05:49.41,Default,Teacher,0,0,0,,Được rồi. Vậy thầy sẽ vào trong ngồi đợi.
Dialogue: 0,0:05:49.41,0:05:50.32,Default,Oka,0,0,0,,Hả?
Dialogue: 0,0:05:50.32,0:05:51.87,Default,Teacher,0,0,0,,Công việc của thầy là thế mà.
Dialogue: 0,0:05:51.87,0:05:54.33,Default,Teacher,0,0,0,,Dù có phải đợi đến tận sáng mai thì thầy cũng sẽ đợi.
Dialogue: 0,0:05:57.21,0:05:59.67,Default,Oka,0,0,0,,Em... sẽ đi tìm ông ấy.
Dialogue: 0,0:06:00.08,0:06:02.38,Default,Teacher,0,0,0,,Này, Okazaki!
Dialogue: 0,0:06:12.05,0:06:14.39,Default,Oka,0,0,0,,Hay là mình qua phòng thằng Sunohara nhỉ?
Dialogue: 0,0:06:14.39,0:06:15.72,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:06:19.48,0:06:21.23,Default,Nag,0,0,0,,Cậu lại định trốn chạy đúng không?
Dialogue: 0,0:06:21.23,0:06:23.69,Default,Oka,0,0,0,,Thế còn buổi tập kịch của cậu thì sao rồi?
Dialogue: 0,0:06:23.69,0:06:27.99,Default,Nag,0,0,0,,Thầy Koumura không có ở đó, nên hôm nay tạm nghỉ rồi.
Dialogue: 0,0:06:27.99,0:06:31.20,Default,Nag,0,0,0,,Tớ nghĩ là mình nên mang cặp sách qua cho cậu.
Dialogue: 0,0:06:32.70,0:06:35.70,Default,Nag,0,0,0,,Cậu nhớ phải đi theo sau tớ đấy nhé, Okazaki-san.
Dialogue: 0,0:06:41.29,0:06:44.09,Default,Dad,0,0,0,,Thế ý của Tomoya-kun thế nào?
Dialogue: 0,0:06:44.09,0:06:47.96,Default,Teacher,0,0,0,,Không, hôm nay tôi đến là muốn trao đổi trực tiếp với bác.
Dialogue: 0,0:06:48.84,0:06:53.68,Default,Teacher,0,0,0,,Tôi cũng sẽ nói chuyện riêng với em ấy, nhưng hôm nay tôi muốn lắng nghe suy nghĩ của phụ huynh.
Dialogue: 0,0:06:53.68,0:06:56.68,Default,Dad,0,0,0,,Tôi đã nói rồi, chuyện đó không phải do tôi quyết định.
Dialogue: 0,0:06:57.31,0:06:59.10,Default,Dad,0,0,0,,Tomoya-kun là Tomoya-kun.
Dialogue: 0,0:06:59.10,0:07:01.10,Default,Dad,0,0,0,,Đó là chuyện do chính bản thân thằng bé tự quyết định.
Dialogue: 0,0:07:01.10,0:07:05.11,Default,Teacher,0,0,0,,Nhưng em ấy vẫn còn là học sinh, nên tôi buộc phải lắng nghe ý kiến của người giám hộ.
Dialogue: 0,0:07:05.11,0:07:07.44,Default,Dad,0,0,0,,Không đâu thầy, Tomoya-kun là Tomoya-kun mà.
Dialogue: 0,0:07:08.11,0:07:09.86,Default,Dad,0,0,0,,Đó không phải là việc tôi nên can thiệp vào.
Dialogue: 0,0:07:19.66,0:07:21.08,Default,Oka,0,0,0,,Ông ấy lúc nào cũng như thế đấy.
Dialogue: 0,0:07:21.46,0:07:25.13,Default,Oka,0,0,0,,Trong thâm tâm ông ấy, tôi chẳng còn là con trai của ông ấy nữa rồi.
Dialogue: 0,0:07:25.71,0:07:31.88,Default,Oka,0,0,0,,Trước đây tớ từng kể cho cậu nghe chuyện tớ cãi nhau với ông già, bị thương ở vai và không thể chơi bóng rổ được nữa đúng không?
Dialogue: 0,0:07:32.63,0:07:35.35,Default,Oka,0,0,0,,Kể từ dạo đó, ông ấy lúc nào cũng xa cách như thế.
Dialogue: 0,0:07:35.89,0:07:38.89,Default,Oka,0,0,0,,Dù sống chung dưới một mái nhà, nhưng bọn tôi sống cuộc sống hoàn toàn tách biệt.
Dialogue: 0,0:07:39.85,0:07:44.90,Default,Oka,0,0,0,,Ông ấy luôn mang nụ cười gượng gạo hiền lành đó và cứ thế sống cô độc một mình.
Dialogue: 0,0:07:45.56,0:07:49.40,Default,Oka,0,0,0,,Từ lâu rồi, ông già và tôi đã chẳng còn là gia đình của nhau nữa.
Dialogue: 0,0:07:54.99,0:07:56.66,Default,Nag,0,0,0,,Ừm, Okazaki-san này.
Dialogue: 0,0:08:04.04,0:08:06.17,Default,Nag,0,0,0,,Cậu có muốn chuyển qua nhà tớ ở không?
Dialogue: 0,0:08:08.80,0:08:12.51,Default,Nag,0,0,0,,Chỉ là... nếu như điều đó không làm cậu cảm thấy khó xử.
Dialogue: 0,0:08:12.51,0:08:14.84,Default,Oka,0,0,0,,Không, không hề khó xử chút nào.
Dialogue: 0,0:08:14.84,0:08:19.81,Default,Nag,0,0,0,,Tớ nghĩ hai bố con cậu nên giữ một chút khoảng cách để bình tâm suy nghĩ lại mọi chuyện.
Dialogue: 0,0:08:20.35,0:08:22.31,Default,Nag,0,0,0,,Dù sao hai người vẫn là gia đình của nhau mà,
Dialogue: 0,0:08:22.31,0:08:26.31,Default,Nag,0,0,0,,nên khi xa nhau rồi, tớ tin chắc
cả hai sẽ dần cảm thấy nhung nhớ đối phương.
Dialogue: 0,0:08:26.31,0:08:30.32,Default,Nag,0,0,0,,Rồi hai người sẽ nhớ lại tình yêu thương từng dành cho nhau,
Dialogue: 0,0:08:30.78,0:08:35.32,Default,Nag,0,0,0,,để lần gặp gỡ tiếp theo,
hai bố con có thể ngồi lại trò chuyện đàng hoàng.
Dialogue: 0,0:08:42.33,0:08:44.92,Default,Nag,0,0,0,,Thế nhưng, còn bố cậu thì...
Dialogue: 0,0:08:44.92,0:08:46.50,Default,Oka,0,0,0,,Cậu không cần phải lo lắng cho ông ấy đâu.
Dialogue: 0,0:08:46.50,0:08:49.84,Default,Oka,0,0,0,,Xưa nay ông ấy vẫn sống cô độc một mình như thế mà.
Dialogue: 0,0:08:49.84,0:08:51.42,Default,Nag,0,0,0,,Tớ hiểu rồi.
Dialogue: 0,0:08:52.38,0:08:54.84,Default,Nag,0,0,0,,Nhưng thỉnh thoảng cậu nhớ ghé về thăm nhà đấy nhé.
Dialogue: 0,0:08:55.26,0:08:57.47,Default,Oka,0,0,0,,Ừ. Thỉnh thoảng thôi.
Dialogue: 0,0:09:07.15,0:09:09.65,Default,Oka,0,0,0,,Ngôi nhà mà trước đây mình luôn trở về mỗi ngày...
Dialogue: 0,0:09:10.19,0:09:11.65,Default,Oka,0,0,0,,...nhưng giờ thì không còn nữa rồi.
Dialogue: 0,0:09:12.48,0:09:15.07,Default,Oka,0,0,0,,Một nơi chốn mà có lẽ mình sẽ chẳng bao giờ quay lại.
Dialogue: 0,0:09:15.90,0:09:20.16,Default,Oka,0,0,0,,Hoặc giả, liệu có một ngày nào đó mình sẽ có thể tìm về?
Dialogue: 0,0:09:20.16,0:09:26.00,Default-alt,TV,0,0,0,,Ai mà ngờ được ở tận sâu trong vùng rừng núi hiểm trở thế này lại có món ăn tươi ngon đến vậy chứ?
Dialogue: 0,0:09:26.00,0:09:29.04,Default-alt,TV,0,0,0,,Và điều tuyệt vời nhất chính là tính cách đôn hậu của bà chủ quán nơi đây.
Dialogue: 0,0:09:29.04,0:09:33.84,Default-alt,TV,0,0,0,,Tôi tin chắc quý vị chỉ cần đến đây gặp bà ấy một lần thôi là đã cảm thấy mãn nguyện lắm rồi.
Dialogue: 0,0:09:33.84,0:09:35.42,Default-alt,TV,0,0,0,,Nhưng chưa hết đâu nhé.
Dialogue: 0,0:09:37.18,0:09:39.76,Default-alt,TV,0,0,0,,Mùa hè này tôi dự định sẽ cùng gia đình—
Dialogue: 0,0:09:48.52,0:09:51.69,Default,Dad,0,0,0,,Tomoya-kun. Con định đi đâu đấy?
Dialogue: 0,0:09:52.90,0:09:54.19,Default,Oka,0,0,0,,Con qua nhà bạn ở một thời gian.
Dialogue: 0,0:09:55.49,0:09:57.28,Default,Dad,0,0,0,,Hành lý to thế kia à.
Dialogue: 0,0:09:57.95,0:09:59.74,Default,Oka,0,0,0,,Con sẽ ở bên đó một thời gian.
Dialogue: 0,0:10:00.45,0:10:02.41,Default,Oka,0,0,0,,Con cũng chưa quyết định khi nào sẽ về.
Dialogue: 0,0:10:04.04,0:10:07.12,Default,Dad,0,0,0,,Bác hiểu rồi. Ở nhà một mình sẽ thấy trống vắng lắm đây.
Dialogue: 0,0:10:07.58,0:10:11.21,Default,Dad,0,0,0,,Vì có con ở cùng trò chuyện vui lắm mà.
Dialogue: 0,0:10:11.21,0:10:13.75,Default,Oka,0,0,0,,Con cũng có những vấn đề của riêng mình.
Dialogue: 0,0:10:13.75,0:10:14.80,Default,Oka,0,0,0,,Bác hãy thông cảm cho con.
Dialogue: 0,0:10:15.21,0:10:16.30,Default,Dad,0,0,0,,Con nói đúng đấy.
Dialogue: 0,0:10:16.30,0:10:17.80,Default,Oka,0,0,0,,Con đi đây ạ.
Dialogue: 0,0:10:32.94,0:10:34.94,Default,Oka,0,0,0,,Chào bác, thưa Bố.
Dialogue: 0,0:10:43.12,0:10:44.08,Default,Oka,0,0,0,,Cháu chào hai bác ạ.
Dialogue: 0,0:10:44.08,0:10:46.37,Default,Aki,0,0,0,,Đêm hôm khuya khoắt thế này mày vác mặt tới đây có việc gì?
Dialogue: 0,0:10:47.00,0:10:50.00,Default,Oka,0,0,0,,Chẳng lẽ Nagisa vẫn chưa nói gì với hai bác sao?
Dialogue: 0,0:10:50.00,0:10:52.00,Default,Aki,0,0,0,,Nếu không có việc gì thì biến về nhà mau.
Dialogue: 0,0:10:52.00,0:10:53.42,Default,Aki,0,0,0,,Mày đang cản trở công việc kinh doanh của tao đấy.
Dialogue: 0,0:10:53.79,0:10:54.96,Default,Oka,0,0,0,,Dạ, Nagisa đâu rồi ạ?
Dialogue: 0,0:10:56.63,0:10:58.97,Default,San,0,0,0,,Mừng cháu ghé chơi, Okazaki-san.
Dialogue: 0,0:10:59.55,0:11:01.76,Default,San,0,0,0,,Cô rất mong đợi những ngày tháng sắp tới cùng cháu đấy.
Dialogue: 0,0:11:02.55,0:11:04.76,Default,Oka,0,0,0,,Dạ, cháu cũng vậy ạ. Cháu xin cảm ơn lòng hiếu khách của hai bác.
Dialogue: 0,0:11:05.14,0:11:07.81,Default,Aki,0,0,0,,Hiếu khách cái nỗi gì? Mày đang lảm nhảm cái gì thế hả?
Dialogue: 0,0:11:07.81,0:11:11.69,Default,San,0,0,0,,Okazaki-san sẽ ở lại nhà chúng ta một thời gian đấy anh.
Dialogue: 0,0:11:11.69,0:11:13.65,Default,Aki,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:11:13.65,0:11:16.52,Default,San,0,0,0,,Lúc nãy anh vừa nghe con bé Nagisa kể rồi còn gì nữa?
Dialogue: 0,0:11:16.52,0:11:17.53,Default,Aki,0,0,0,,Ừ, thì đúng là tao có nghe.
Dialogue: 0,0:11:18.07,0:11:19.53,Default,Oka,0,0,0,,Thế mà bác còn giả vờ...
Dialogue: 0,0:11:19.53,0:11:20.28,Default,Aki,0,0,0,,Ừ đấy thì sao.
Dialogue: 0,0:11:20.65,0:11:22.70,Default,Aki,0,0,0,,Nhưng mà Sanae ơi...
Dialogue: 0,0:11:22.70,0:11:24.03,Default,San,0,0,0,,Dạ?
Dialogue: 0,0:11:24.03,0:11:28.45,Default,Aki,0,0,0,,Một thằng đàn ông mà bị mất đi dàn hậu cung thì đau đớn lắm em biết không hả?!
Dialogue: 0,0:11:29.45,0:11:34.00,Default,San,0,0,0,,Okazaki-san, cháu không cần phải để tâm đến ông ấy đâu, cứ tự nhiên vào nhà đi nhé.
Dialogue: 0,0:11:34.00,0:11:34.63,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:11:35.38,0:11:38.05,Default,Aki,0,0,0,,Ít ra mày cũng phải làm ra vẻ mặt hối lỗi cắn rứt lương tâm một chút chứ hả?!
Dialogue: 0,0:11:38.05,0:11:41.34,Default,San,0,0,0,,Rồi rồi, anh mau quay lại làm việc tiếp đi nào.
Dialogue: 0,0:11:41.76,0:11:44.59,Default,Nag,0,0,0,,Tớ đã đợi cậu mãi đấy, Okazaki-san.
Dialogue: 0,0:11:45.55,0:11:47.89,Default,Oka,0,0,0,,Tớ được dùng căn phòng đẹp thế này thật sao?
Dialogue: 0,0:11:47.89,0:11:49.64,Default,Nag,0,0,0,,Phòng này thường ngày dùng làm phòng cho khách đấy.
Dialogue: 0,0:11:51.94,0:11:53.65,Default,Nag,0,0,0,,Đệm nằm ở trong tủ này nhé.
Dialogue: 0,0:11:53.65,0:11:57.61,Default,Nag,0,0,0,,Nếu cậu chưa quen thì để tớ trải ra rồi gấp gọn lại giúp cậu cho.
Dialogue: 0,0:11:57.61,0:12:00.57,Default,Oka,0,0,0,,Không cần đâu, tớ tự làm được mà.
Dialogue: 0,0:12:00.57,0:12:02.99,Default,Nag,0,0,0,,Nhưng sáng dậy cậu không được để bừa bộn đâu đấy nhé.
Dialogue: 0,0:12:02.99,0:12:05.74,Default,Oka,0,0,0,,Nhìn cậu thế mà thực tế ra phết nhỉ.
Dialogue: 0,0:12:06.12,0:12:07.74,Default,Nag,0,0,0,,Đâu có đâu ạ.
Dialogue: 0,0:12:07.74,0:12:10.12,Default,Nag,0,0,0,,Tớ lo chuyện của bản thân còn chưa xong nữa là.
Dialogue: 0,0:12:10.12,0:12:13.58,Default,Oka,0,0,0,,Nhưng lúc nào cậu cũng lo lắng cho người khác mà.
Dialogue: 0,0:12:13.58,0:12:15.71,Default,Nag,0,0,0,,Thế sao cậu?
Dialogue: 0,0:12:15.71,0:12:17.71,Default,Aki,0,0,0,,Xới thêm bát nữa cho anh đi Sanae.
Dialogue: 0,0:12:17.71,0:12:18.21,Default,San,0,0,0,,Dạ vâng.
Dialogue: 0,0:12:20.09,0:12:21.55,Default,Oka,0,0,0,,Cháu tắm xong rồi ạ.
Dialogue: 0,0:12:21.55,0:12:23.47,Default,Aki,0,0,0,,Ồ. Nước tắm sảng khoái chứ hả?
Dialogue: 0,0:12:23.47,0:12:25.39,Default,San,0,0,0,,Cháu có muốn uống chút trà không?
Dialogue: 0,0:12:25.39,0:12:27.39,Default,Oka,0,0,0,,Dạ có, cháu cảm ơn cô ạ.
Dialogue: 0,0:12:30.27,0:12:32.39,Default,Oka,0,0,0,,Cảm giác ấm cúng đến mức suýt chút nữa thấy ngượng ngùng.
Dialogue: 0,0:12:33.27,0:12:34.89,Default,Oka,0,0,0,,Có lẽ rồi mình cũng sẽ sớm quen thôi.
Dialogue: 0,0:12:38.23,0:12:40.23,Default,Nag,0,0,0,,Thế thì chúng con xin phép đi học đây ạ.
Dialogue: 0,0:12:40.23,0:12:42.32,Default,San,0,0,0,,Ừ. Đi đường cẩn thận nhé các con.
Dialogue: 0,0:12:43.07,0:12:45.45,Default,Nag,0,0,0,,Okazaki-san, cậu cũng phải chào đàng hoàng nữa chứ.
Dialogue: 0,0:12:45.95,0:12:46.82,Default,Oka,0,0,0,,Cả tôi nữa á?
Dialogue: 0,0:12:46.82,0:12:47.74,Default,Nag,0,0,0,,Đúng thế ạ!
Dialogue: 0,0:12:48.12,0:12:49.41,Default,Oka,0,0,0,,Ừm...
Dialogue: 0,0:12:49.41,0:12:50.91,Default,Oka,0,0,0,,Tụi con đi học đây ạ.
Dialogue: 0,0:12:50.91,0:12:52.00,Default,San,0,0,0,,Chúc các con một ngày tốt lành nhé.
Dialogue: 0,0:12:53.04,0:12:54.87,Default,Nag,0,0,0,,Bọn con đi học đây bố nhé.
Dialogue: 0,0:12:54.87,0:12:56.42,Default,Aki,0,0,0,,Ừ. Đi đứng cẩn thận.
Dialogue: 0,0:12:56.96,0:12:58.21,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:12:58.21,0:13:00.17,Default,Oka,0,0,0,,Ừ-Ừm.
Dialogue: 0,0:13:00.17,0:13:02.59,Default,Oka,0,0,0,,C-Con đi học đây ạ.
Dialogue: 0,0:13:02.59,0:13:04.17,Default,Aki,0,0,0,,Ừ! Đi kiếm điểm số cho ngon lành vào nhé!
Dialogue: 0,0:13:04.17,0:13:05.18,Default,Oka,0,0,0,,Kiếm điểm cái gì cơ chứ?
Dialogue: 0,0:13:06.63,0:13:12.18,Default,Oka,0,0,0,,Tuy có hơi ngượng một chút, nhưng cả cô Sanae lẫn chú Akio đều tiễn hai đứa đi học vô cùng tự nhiên.
Dialogue: 0,0:13:13.31,0:13:16.94,Default,Nag,0,0,0,,Được cùng nhau đi bộ đến trường vui thật đấy.
Dialogue: 0,0:13:17.31,0:13:19.48,Default,Oka,0,0,0,,Tớ thì thấy hơi ngượng ngùng một tẹo.
Dialogue: 0,0:13:20.32,0:13:22.94,Default,Nag,0,0,0,,Tớ cũng có một chút ngượng ngùng.
Dialogue: 0,0:13:23.32,0:13:29.32,Default,Nag,0,0,0,,Nhưng nhờ có cậu mà tớ đã có thêm rất nhiều tự tin trong mọi chuyện.
Dialogue: 0,0:13:29.91,0:13:33.87,Default,Nag,0,0,0,,Bắt đầu từ hôm nay cho đến ngày diễn ra Lễ hội trường, tớ sẽ dốc hết sức mình.
Dialogue: 0,0:13:33.87,0:13:35.33,Default,Oka,0,0,0,,Ừ, tinh thần thế là tốt đấy.
Dialogue: 0,0:13:35.87,0:13:36.71,Default,Nag,0,0,0,,Dạ vâng!
Dialogue: 0,0:13:42.80,0:13:46.30,Default,Kou,0,0,0,,Bộ phận Trang phục sẽ chuẩn bị y phục và đạo cụ sân khấu.
Dialogue: 0,0:13:46.30,0:13:49.93,Default,Kou,0,0,0,,Bộ phận Âm thanh phụ trách phát nhạc nền và hiệu ứng âm thanh.
Dialogue: 0,0:13:49.93,0:13:53.43,Default,Kou,0,0,0,,Bộ phận Ánh sáng sẽ điều khiển dàn đèn sân khấu.
Dialogue: 0,0:13:53.43,0:13:56.31,Default,Kot,0,0,0,,Nghe phức tạp quá chừng luôn.
Dialogue: 0,0:13:56.31,0:13:58.69,Default,Ryo,0,0,0,,Xem ra tụi mình phải phân chia nhiệm vụ cho từng người rồi.
Dialogue: 0,0:13:58.69,0:14:03.27,Default,Kyo,0,0,0,,Cậu lo phần Âm thanh được mà đúng không?
Dù sao hôm nọ cậu cũng chơi đàn ăn ý với Kotomi rồi.
Dialogue: 0,0:14:03.27,0:14:05.53,Default,Tom,0,0,0,,Trông có vẻ vất vả ghê nhỉ.
Dialogue: 0,0:14:05.53,0:14:08.20,Default,Sun,0,0,0,,Sao em lại mò tới đây thế?
Dialogue: 0,0:14:08.20,0:14:11.24,Default,Tom,0,0,0,,Em tò mò muốn biết sau bầu cử thì CLB kịch hoạt động ra sao rồi.
Dialogue: 0,0:14:11.24,0:14:13.33,Default,Tom,0,0,0,,Đó cũng là một phần nhiệm vụ của Hội trưởng hội học sinh mà.
Dialogue: 0,0:14:13.33,0:14:18.08,Default,Kou,0,0,0,,Khối lượng công việc của Ánh sáng và Âm thanh phụ thuộc vào kịch bản.
Dialogue: 0,0:14:18.67,0:14:24.21,Default,Kou,0,0,0,,Vở kịch có nhịp độ dồn dập sẽ đòi hỏi việc vận hành thiết bị phức tạp hơn.
Dialogue: 0,0:14:24.21,0:14:27.97,Default,Kou,0,0,0,,Các hiệu ứng âm thanh có thể bấm phím trên cây đàn keyboard kia.
Dialogue: 0,0:14:27.97,0:14:29.09,Default,Ryo,0,0,0,,Cái này sao ạ?
Dialogue: 0,0:14:31.51,0:14:32.89,Default,Ryo,0,0,0,,Nghe rợn cả tóc gáy.
Dialogue: 0,0:14:34.97,0:14:37.23,Default,Sun,0,0,0,,Âm thanh nghe đã tai thật đấy!
Dialogue: 0,0:14:37.23,0:14:39.52,Default,Kyo,0,0,0,,Này, đây đâu phải là trò chơi con nít đâu.
Dialogue: 0,0:14:39.52,0:14:41.94,Default,Sun,0,0,0,,Thôi nào, cho tao nghịch thử một chút đi mà.
Dialogue: 0,0:14:43.40,0:14:44.44,Default,Sun,0,0,0,,Cậu vừa nói gì cơ hả Nagisa-chan?
Dialogue: 0,0:14:44.44,0:14:46.19,Default,Nag,0,0,0,,Dạ? Nói gì cơ ạ?
Dialogue: 0,0:14:46.19,0:14:47.57,Default,Sun,0,0,0,,Thay vì Okazaki...
Dialogue: 0,0:14:47.61,0:14:49.82,Default,Sun,0,0,0,,...cậu lại thích tao nhiều hơn sao?!
Dialogue: 0,0:14:51.45,0:14:53.24,Default,Sun,0,0,0,,Tao hiểu rồi. Tao đã hiểu trọn tấm lòng của cậu.
Dialogue: 0,0:14:53.24,0:14:55.95,Default,Sun,0,0,0,,Chúng ta sẽ cùng nhau sống lẻ loi trong một khu rừng bạt ngàn không một bóng người lui tới.
Dialogue: 0,0:14:56.49,0:15:00.16,Default,Sun,0,0,0,,Hai đứa mình tay trong tay chạy băng qua cánh rừng ướt đẫm sương đêm.
Dialogue: 0,0:15:00.16,0:15:01.04,Default,Sun,0,0,0,,Thế nhưng!
Dialogue: 0,0:15:01.04,0:15:04.21,Default,Sun,0,0,0,,Vừa quay đầu lại thì đã thấy một Okazaki đang nổi cơn thịnh nộ lôi đình!
Dialogue: 0,0:15:05.42,0:15:06.67,Default,Sun,0,0,0,,Và chặn ngay phía trước mặt chúng ta chính là...
Dialogue: 0,0:15:06.67,0:15:11.18,Default,Sun,0,0,0,,Cặp đôi song sát Kyou và Tomoyo với nanh vuốt sắc nhọn gầm thét!
Dialogue: 0,0:15:13.05,0:15:15.35,Default,Sun,0,0,0,,Chưa gì mà hai bà chằn đã thẳng tay đấm tao rồi.
Dialogue: 0,0:15:15.35,0:15:19.56,Default,Kot,0,0,0,,Nhưng mà tiểu phẩm vừa rồi xem vui thật đấy.
Dialogue: 0,0:15:20.23,0:15:21.06,Default,Oka,0,0,0,,Nagisa này.
Dialogue: 0,0:15:21.06,0:15:21.81,Default,Nag,0,0,0,,Dạ?
Dialogue: 0,0:15:21.81,0:15:25.57,Default,Oka,0,0,0,,Cậu bảo cậu có một vở kịch rất muốn diễn đúng không?
Dialogue: 0,0:15:25.57,0:15:27.23,Default,Oka,0,0,0,,Nội dung của nó diễn biến ra sao?
Dialogue: 0,0:15:29.53,0:15:30.53,Default,Nag,0,0,0,,Chuyện đó thì...
Dialogue: 0,0:15:31.32,0:15:33.28,Default,Nag,0,0,0,,Thực ra ngay cả bản thân tớ cũng không biết rõ nữa.
Dialogue: 0,0:15:34.03,0:15:41.04,Default,Oka,0,0,0,,Tóm lại là: Cậu biết rõ câu chuyện của vở kịch mình muốn diễn, nhưng lại không hề biết tên tác phẩm đó là gì.
Dialogue: 0,0:15:41.41,0:15:42.21,Default,Nag,0,0,0,,Dạ đúng rồi.
Dialogue: 0,0:15:43.83,0:15:45.67,Default,Nag,0,0,0,,Chúng con về rồi đây ạ.
Dialogue: 0,0:15:45.67,0:15:47.05,Default,Oka,0,0,0,,Tụi con về rồi ạ.
Dialogue: 0,0:15:48.34,0:15:50.09,Default,Oka,0,0,0,,Đám trẻ con này là ai thế nhỉ?
Dialogue: 0,0:15:51.05,0:15:54.72,Default,Nag,0,0,0,,Các em ấy là học sinh của lớp học thêm Furukawa đấy.
Dialogue: 0,0:15:54.72,0:15:55.93,Default,Oka,0,0,0,,Lớp học thêm Furukawa á?
Dialogue: 0,0:15:55.93,0:15:58.43,Default,Kid,0,0,0,,Gì thế? Đó đâu phải cô giáo của tụi mình đâu.
Dialogue: 0,0:15:58.43,0:16:00.89,Default,Oka,0,0,0,,Này nhóc, đồ đạc của anh đấy nhé!
Dialogue: 0,0:16:01.77,0:16:03.69,Default,Kid,0,0,0,,Nat-chan gặp nguy hiểm rồi!
Dialogue: 0,0:16:07.07,0:16:08.32,Default,Nag,0,0,0,,Okazaki-san!
Dialogue: 0,0:16:11.32,0:16:13.82,Default,San,0,0,0,,Được rồi các con, chúng ta bắt đầu bài học nào.
Dialogue: 0,0:16:13.82,0:16:15.41,Default,All,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:16:16.95,0:16:20.62,Default,San,0,0,0,,Cô xin lỗi nhé. Cô chưa kịp dọn dẹp riêng một phòng cho cháu.
Dialogue: 0,0:16:20.62,0:16:23.75,Default,Oka,0,0,0,,Cô từng là giáo viên dạy học thêm sao ạ?
Dialogue: 0,0:16:23.75,0:16:24.54,Default,San,0,0,0,,Đúng thế cháu.
Dialogue: 0,0:16:24.54,0:16:28.84,Default,Kid,0,0,0,,Cô giáo ơi. Kệ xác cái tên đó đi, bắt đầu học bài thôi cô.
Dialogue: 0,0:16:28.84,0:16:30.80,Default,Oka,0,0,0,,Mày bảo “cái tên đó” là ai hả thằng ranh con?!
Dialogue: 0,0:16:30.80,0:16:32.09,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:16:32.09,0:16:36.43,Default,San,0,0,0,,Này các con, không được nói năng xấc xược với người lớn hơn mình như thế đâu nhé.
Dialogue: 0,0:16:36.43,0:16:37.85,Default,Kids,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:16:41.81,0:16:44.73,Default,Aki,0,0,0,,Này ranh con, rảnh rỗi không có việc gì làm thì ra trông quán hộ tao coi.
Dialogue: 0,0:16:44.73,0:16:48.77,Default,Aki,0,0,0,,Đúng ra mày nên đứng đây bán bánh để giải phóng tao ra ngoài mới phải.
Dialogue: 0,0:16:49.32,0:16:51.23,Default,Aki,0,0,0,,Quán đông khách nhất là vào buổi sáng với buổi chiều tối.
Dialogue: 0,0:16:51.23,0:16:54.53,Default,Aki,0,0,0,,Bánh mì do chính tay tao nướng được ưa chuộng lắm đấy nhé.
Dialogue: 0,0:16:55.11,0:16:57.41,Default,Oka,0,0,0,,Cô Sanae có ổn không đấy chú?
Dialogue: 0,0:16:57.41,0:17:02.37,Default,Aki,0,0,0,,Thỉnh thoảng cũng có vài người tốt bụng mua bánh mì ủng hộ bả mà.
Dialogue: 0,0:17:02.37,0:17:04.83,Default,Oka,0,0,0,,Cháu có nói chuyện bánh mì đâu. Cháu đang hỏi lớp học thêm cơ.
Dialogue: 0,0:17:05.29,0:17:07.42,Default,Oka,0,0,0,,Đối phó với lũ trẻ con không thấy mệt mỏi sao chú?
Dialogue: 0,0:17:09.46,0:17:11.30,Default,Aki,0,0,0,,Chuyện đó mày không phải lo.
Dialogue: 0,0:17:11.67,0:17:13.72,Default,Aki,0,0,0,,Đó là nghề nghiệp chính quy của Sanae đấy.
Dialogue: 0,0:17:14.22,0:17:16.84,Default,Aki,0,0,0,,Bả từng là giáo viên dạy trường cấp hai đấy.
Dialogue: 0,0:17:16.84,0:17:18.22,Default,Oka,0,0,0,,Thật thế sao chú?
Dialogue: 0,0:17:19.64,0:17:21.85,Default,Oka,0,0,0,,Sao cô ấy lại bỏ nghề thế ạ?
Dialogue: 0,0:17:21.85,0:17:24.10,Default,Aki,0,0,0,,Nhiều chuyện phức tạp xảy ra lắm.
Dialogue: 0,0:17:36.03,0:17:37.78,Default,Oka,0,0,0,,Mệt phờ râu.
Dialogue: 0,0:17:39.74,0:17:40.99,Default,Nag,0,0,0,,Tớ vào phòng được không cậu?
Dialogue: 0,0:17:42.54,0:17:43.24,Default,Oka,0,0,0,,Cứ tự nhiên.
Dialogue: 0,0:17:44.87,0:17:46.54,Default,Oka,0,0,0,,Có chuyện gì sao?
Dialogue: 0,0:17:47.12,0:17:49.54,Default,Nag,0,0,0,,Cũng không có gì đặc biệt cả.
Dialogue: 0,0:17:49.54,0:17:56.55,Default,Nag,0,0,0,,Chỉ là thấy cậu ở lại nhà tớ cứ có cảm giác là lạ thế nào ấy,
nên tớ không kìm lòng được mà ghé qua.
Dialogue: 0,0:17:56.55,0:17:59.55,Default,Oka,0,0,0,,Nhà cậu đâu phải hiếm khi có khách ở lại đâu.
Dialogue: 0,0:17:59.55,0:18:01.14,Default,Oka,0,0,0,,Hôm nọ cậu cũng cho bé Mei ngủ lại còn gì.
Dialogue: 0,0:18:01.14,0:18:05.60,Default,Nag,0,0,0,,Vâng, nhưng cậu là một trường hợp đặc biệt.
Dialogue: 0,0:18:08.35,0:18:12.48,Default,Nag,0,0,0,,Ừm, nếu tớ làm phiền cậu thì tớ xin phép ra ngoài nhé.
Dialogue: 0,0:18:12.48,0:18:14.44,Default,Oka,0,0,0,,Cậu chẳng làm phiền gì đâu.
Dialogue: 0,0:18:14.44,0:18:16.36,Default,Oka,0,0,0,,Chỉ là... nói thế nào nhỉ...
Dialogue: 0,0:18:16.82,0:18:18.65,Default,Oka,0,0,0,,Bản thân tớ cũng thấy lạ lẫm lắm.
Dialogue: 0,0:18:20.07,0:18:22.70,Default,Nag,0,0,0,,Cậu bảo lạ lẫm sao?
Dialogue: 0,0:18:22.70,0:18:27.46,Default,Oka,0,0,0,,Ừ. Từ lúc tớ bắt đầu có nhận thức về thế giới xung quanh, mẹ tớ đã không còn nữa rồi.
Dialogue: 0,0:18:27.46,0:18:29.37,Default,Oka,0,0,0,,Còn ông già thì... cậu biết rồi đấy.
Dialogue: 0,0:18:29.37,0:18:33.63,Default,Oka,0,0,0,,Nhìn thấy một gia đình hòa thuận gắn kết thế này khiến tớ có cảm giác kỳ lạ lắm.
Dialogue: 0,0:18:35.71,0:18:41.30,Default,Nag,0,0,0,,Cậu nói đúng đấy. Bố và Mẹ chăm sóc tớ chu đáo lắm.
Dialogue: 0,0:18:46.06,0:18:51.15,Default,Nag,0,0,0,,Thế nhưng, có một chuyện tớ vẫn chưa thể xin lỗi bố mẹ, dù đáng lẽ ra tớ phải làm điều đó từ lâu rồi.
Dialogue: 0,0:18:52.19,0:18:54.57,Default,Oka,0,0,0,,Cậu đã làm chuyện gì xấu xa sao?
Dialogue: 0,0:18:54.57,0:18:56.61,Default,Nag,0,0,0,,Tớ không dám chắc chắn,
Dialogue: 0,0:18:56.61,0:19:05.24,Default,Nag,0,0,0,,nhưng hồi tớ còn nhỏ xíu, tớ cứ cảm giác như
mình đã gây ra một lỗi lầm vô cùng khủng khiếp đối với Bố và Mẹ.
Dialogue: 0,0:19:06.49,0:19:08.70,Default,Oka,0,0,0,,Có khi cậu chỉ tưởng tượng ra thôi.
Dialogue: 0,0:19:08.70,0:19:11.54,Default,Nag,0,0,0,,Cả Bố và Mẹ đều bảo như vậy.
Dialogue: 0,0:19:11.54,0:19:14.04,Default,Nag,0,0,0,,Lần nào tớ gặng hỏi thì bố mẹ cũng đều lảng tránh sang chuyện khác.
Dialogue: 0,0:19:15.00,0:19:17.92,Default,Nag,0,0,0,,Thế nhưng tớ có thể nhận ra rõ ràng là bố mẹ đang giấu giếm điều gì đó.
Dialogue: 0,0:19:17.92,0:19:21.34,Default,Nag,0,0,0,,Bởi vì những lúc như thế, ánh mắt của Bố lúc nào cũng dịu xuống đầy đau xót.
Dialogue: 0,0:19:21.34,0:19:27.35,Default,Nag,0,0,0,,Chắc chắn phải có một bí mật ẩn giấu nào đó mà tớ nhất định phải xin lỗi bố mẹ.
Dialogue: 0,0:19:28.02,0:19:30.85,Default,Oka,0,0,0,,Một điều mà cậu phải xin lỗi sao...
Dialogue: 0,0:19:31.23,0:19:33.44,Default,Nag,0,0,0,,Tớ muốn tìm ra sự thật đằng sau chuyện đó.
Dialogue: 0,0:19:33.44,0:19:35.19,Default,Nag,0,0,0,,Tớ muốn biết rõ ngọn ngành để có thể nói lời xin lỗi với bố mẹ.
Dialogue: 0,0:19:38.61,0:19:40.95,Default,Nag,0,0,0,,Từ trước đến giờ tớ vẫn luôn day dứt như vậy đấy.
Dialogue: 0,0:19:42.95,0:19:47.62,Default,Nag,0,0,0,,Tớ xin lỗi nhé. Tự nhiên cậu chưa hỏi mà tớ đã thao thao bất tuyệt kể lể rồi.
Dialogue: 0,0:19:48.41,0:19:49.87,Default,Oka,0,0,0,,Không sao đâu, tớ không phiền lòng đâu.
Dialogue: 0,0:19:50.29,0:19:51.37,Default,Oka,0,0,0,,Chẳng có gì kỳ lạ cả.
Dialogue: 0,0:19:52.96,0:19:53.92,Default,Nag,0,0,0,,Ừm.
Dialogue: 0,0:19:53.92,0:19:57.38,Default,San,0,0,0,,Okazaki-san ơi! Nước tắm chuẩn bị xong rồi nhé!
Dialogue: 0,0:19:58.84,0:20:01.34,Default,Oka,0,0,0,,Cháu xin lỗi, lát nữa cháu tắm sau ạ.
Dialogue: 0,0:20:02.26,0:20:04.30,Default,Oka,0,0,0,,Cậu vào tắm trước đi.
Dialogue: 0,0:20:04.30,0:20:07.51,Default,Oka,0,0,0,,Tớ chạy qua chỗ thằng Sunohara một lát.
Dialogue: 0,0:20:07.51,0:20:10.31,Default,Oka,0,0,0,,Thỉnh thoảng cũng phải ghé sang ngó ngàng chút,
chứ không nó lại thấy cô đơn buồn tủi.
Dialogue: 0,0:20:10.81,0:20:12.02,Default,Nag,0,0,0,,Tớ hiểu rồi.
Dialogue: 0,0:20:12.81,0:20:16.19,Default,Nag,0,0,0,,Cậu đừng về muộn quá đấy nhé.
Dialogue: 0,0:20:17.44,0:20:20.36,Default,Oka,0,0,0,,Trời đất, cái phòng này đúng là dễ thở và thư thái thật.
Dialogue: 0,0:20:20.36,0:20:21.44,Default,Oka,0,0,0,,Trà của tao đâu.
Dialogue: 0,0:20:21.44,0:20:22.95,Default,Sun,0,0,0,,Tao đã bảo rồi, phòng này không phục vụ mấy thứ đó.
Dialogue: 0,0:20:23.32,0:20:26.28,Default,Sun,0,0,0,,Hôm nay mày không mang hộp bento nào sang đây à?
Dialogue: 0,0:20:26.28,0:20:28.83,Default,Oka,0,0,0,,Ừ, tao ăn tối no căng bụng rồi.
Dialogue: 0,0:20:31.20,0:20:32.41,Default,Sun,0,0,0,,Để tao đoán nhé. Ăn ở bên nhà Nagisa-chan đúng không?
Dialogue: 0,0:20:32.96,0:20:34.71,Default,Oka,0,0,0,,Sao mày biết hay thế?
Dialogue: 0,0:20:34.71,0:20:37.00,Default,Sun,0,0,0,,Ghen tị với mày chết đi được.
Dialogue: 0,0:20:37.00,0:20:40.21,Default,Oka,0,0,0,,Mày cứ nói thế chứ ở bên đó tao cũng thấy ngột ngạt và khó xử lắm.
Dialogue: 0,0:20:40.21,0:20:44.93,Default,Oka,0,0,0,,Được người ta cho ở nhờ thì tốt thật đấy,
nhưng tao không sao quen nổi với cái không khí gia đình ấm cúng đó.
Dialogue: 0,0:20:45.38,0:20:46.68,Default,Sun,0,0,0,,Khoan khoan, dừng lại ngay!
Dialogue: 0,0:20:46.68,0:20:49.31,Default,Sun,0,0,0,,Mày đang sống chung dưới một mái nhà với Nagisa-chan á?!
Dialogue: 0,0:20:50.10,0:20:50.64,Default,Oka,0,0,0,,Bỏ mẹ rồi, lỡ mồm rồi.
Dialogue: 0,0:20:55.90,0:20:57.15,Default,Sun,0,0,0,,Tao không thể chấp nhận được chuyện này!
Dialogue: 0,0:20:57.15,0:21:00.32,Default,Oka,0,0,0,,Đừng có hiểu lầm bậy bạ. Tao chỉ xin ở nhờ bên đó một thời gian thôi.
Dialogue: 0,0:21:00.32,0:21:03.49,Default,Oka,0,0,0,,Cậu ấy giúp tao vì biết quan hệ giữa tao với ông già không được tốt đẹp thôi mà.
Dialogue: 0,0:21:03.49,0:21:07.07,Default,Sun,0,0,0,,Hai đứa mày dọn về sống chung với nhau là quá đủ để tao hiểu rồi!
Dialogue: 0,0:21:07.07,0:21:08.41,Default,Sun,0,0,0,,Nói cách khác là bố mẹ em ấy đã chính thức duyệt mày làm con rể rồi!
Dialogue: 0,0:21:08.41,0:21:12.16,Default,Oka,0,0,0,,Tao đã bảo là quan hệ bọn tao không phải kiểu đó mà!
Dialogue: 0,0:21:12.16,0:21:16.71,Default,Sun,0,0,0,,Không thể tin nổi... Đến nước này rồi mà mày vẫn còn chối đây đẩy được à?
Dialogue: 0,0:21:16.71,0:21:18.08,Default,Oka,0,0,0,,Chuyện đó thì có sao đâu chứ...
Dialogue: 0,0:21:19.59,0:21:22.17,Default,Sun,0,0,0,,Tao thấy tội nghiệp cho Nagisa-chan quá đi mất.
Dialogue: 0,0:21:32.60,0:21:39.27,Default,Robo,0,0,0,,Ta đang thu gom phế liệu với hy vọng tạo ra thêm một con búp bê nữa.
Dialogue: 0,0:21:40.02,0:21:42.28,Default,Girl,0,0,0,,Anh muốn có thêm bạn sao?
Dialogue: 0,0:21:42.86,0:21:46.90,Default,Girl,0,0,0,,Cũng phải thôi. Sống một mình thì cô đơn lắm...
Dialogue: 0,0:21:47.53,0:21:48.28,Default,Girl,0,0,0,,Em xin lỗi nhé.
Dialogue: 0,0:21:48.28,0:21:49.78,Default,Robo,0,0,0,,Cô bé nói cũng không hoàn toàn đúng.
Dialogue: 0,0:21:50.49,0:21:56.79,Default,Robo,0,0,0,,Ta chỉ nghĩ đơn thuần rằng, nếu có thêm nhiều sinh mệnh giống như ta,
thì nơi chốn này sẽ trở nên náo nhiệt và vui vẻ hơn biết bao.
Dialogue: 0,0:22:00.46,0:22:02.25,Default,Girl,0,0,0,,Chúng ta hãy cùng thử làm xem sao nhé.
Dialogue: 0,0:22:02.63,0:22:04.51,Default,Girl,0,0,0,,Cho dù có thể sẽ không thành công.
