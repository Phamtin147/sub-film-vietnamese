Dialogue: 0,0:00:00.00,0:00:06.92,Default,,0,0,0,,
Dialogue: 0,0:00:00.00,0:00:01.64,Default,,0,0,0,,
Dialogue: 0,0:00:01.35,0:00:02.98,Default,Nag,0,0,0,,Nếu như cậu muốn…
Dialogue: 0,0:00:03.39,0:00:06.19,Default,Nag,0,0,0,,…tớ có thể dẫn cậu đi không?
Dialogue: 0,0:00:07.69,0:00:11.40,Default,Nag,0,0,0,,Đến nơi mà những điều ước sẽ trở thành hiện thực trong thị trấn này.
Dialogue: 0,0:00:19.16,0:00:21.91,Default,Nag,0,0,0,,Cậu làm gì ở đây thế?
Dialogue: 0,0:00:23.04,0:00:25.71,Default,Nag,0,0,0,,Bộ cậu để quên thứ gì ở nhà tớ sao?
Dialogue: 0,0:00:25.71,0:00:28.17,Default,Oka,0,0,0,,À không, tôi chỉ đang đi dạo thôi.
Dialogue: 0,0:00:28.17,0:00:29.92,Default,Oka,0,0,0,,Thế còn cậu vừa làm gì đấy?
Dialogue: 0,0:00:31.88,0:00:33.80,Default,Nag,0,0,0,,Tớ đang tập đọc lời thoại cho một vở kịch.
Dialogue: 0,0:00:33.80,0:00:37.30,Default,Nag,0,0,0,,Đó là vở kịch mà tớ muốn được diễn khi câu lạc bộ kịch được tái lập.
Dialogue: 0,0:00:39.01,0:00:41.02,Default,Oka,0,0,0,,À, ra là lời thoại kịch…
Dialogue: 0,0:00:41.02,0:00:43.60,Default,Nag,0,0,0,,Tớ lúc nào cũng ra đây luyện tập cả.
Dialogue: 0,0:00:43.60,0:00:46.73,Default,Nag,0,0,0,,Tiện thể có cậu ở đây, nên tớ muốn để cậu xem qua màn diễn xuất của tớ luôn.
Dialogue: 0,0:00:47.15,0:00:50.61,Default,Oka,0,0,0,,Vậy là cậu thật sự quyết tâm muốn khôi phục lại câu lạc bộ kịch sao?
Dialogue: 0,0:00:50.61,0:00:51.53,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:00:51.53,0:00:56.32,Default,Nag,0,0,0,,Tớ chẳng biết bản thân có thể làm được đến đâu,\Nnhưng tớ dự định sẽ cố gắng hết sức mình.
Dialogue: 0,0:00:57.99,0:00:58.82,Default,Oka,0,0,0,,Ra là thế.
Dialogue: 0,0:00:59.58,0:01:00.24,Default,Nag,0,0,0,,Vâng.
