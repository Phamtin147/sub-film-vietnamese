Dialogue: 0,0:02:37.63,0:02:40.55,Default,Voice,0,0,0,,Cuộc sống của cô gái ấy thật cô đơn quạnh quẽ.
Dialogue: 0,0:02:43.93,0:02:46.81,Default,Voice,0,0,0,,Ngoài cô ấy ra, chẳng có một ai khác tồn tại.
Dialogue: 0,0:02:47.72,0:02:49.35,Default,Voice,0,0,0,,Đó là một sự thật hiển nhiên…
Dialogue: 0,0:02:52.52,0:02:56.94,Default,Voice,0,0,0,,…bởi nơi này chẳng có sự sinh sôi, cũng chẳng hề có cái chết.
Dialogue: 0,0:02:57.48,0:02:58.78,Default,Voice,0,0,0,,Thế giới này vốn là như vậy đấy.
Dialogue: 0,0:03:02.74,0:03:06.41,Default,Voice,0,0,0,,Cơ thể này được tạo ra là để dành cho tôi.
Dialogue: 0,0:03:08.04,0:03:10.96,Default,Voice,0,0,0,,Liệu chỉ một "điều ước" thôi có là tất cả những gì tôi cần?
Dialogue: 0,0:03:12.00,0:03:14.04,Default,Voice,0,0,0,,Một điều ước để được sinh ra trên thế giới này.
Dialogue: 0,0:03:15.54,0:03:18.01,Default,Voice,0,0,0,,Hơi ấm duy nhất và độc nhất vô nhị nơi trần thế này.
Dialogue: 0,0:03:18.84,0:03:22.34,Default,Voice,0,0,0,,Đó là thứ mà tôi hằng khao khát tìm kiếm suốt bấy lâu nay.
Dialogue: 0,0:03:24.05,0:03:27.72,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410)\3c&H4A8A5C&}Tập 2
Dialogue: 0,0:03:24.05,0:03:27.72,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Bước Khởi Đầu
Dialogue: 0,0:03:29.47,0:03:31.77,Default,Oka,0,0,0,,Khôi phục lại câu lạc bộ kịch sao…
Dialogue: 0,0:03:32.35,0:03:35.19,Default,Oka,0,0,0,,Dù sao thì, ít nhất nó cũng là một trò tiêu khiển hay ho đối với mình.
Dialogue: 0,0:03:35.98,0:03:37.69,Default,Kyo,0,0,0,,Tomoya! Tránh đường mau!
Dialogue: 0,0:03:44.70,0:03:46.37,Default,Kyo,0,0,0,,Ái úi!
Dialogue: 0,0:03:46.66,0:03:48.54,Default,Kyo,0,0,0,,Này, đi đứng cẩn thận chứ!
Dialogue: 0,0:03:48.54,0:03:49.79,Default,Oka,0,0,0,,Đó là câu thoại của tôi mới đúng chứ lị!
Dialogue: 0,0:03:49.79,0:03:50.54,Default,Oka,0,0,0,,Bộ cậu muốn tông chết tôi đấy à?!
Dialogue: 0,0:03:54.96,0:03:57.67,Default,Kyo,0,0,0,,Nói thật là tôi vẫn chưa quen tay lái cho lắm.
Dialogue: 0,0:03:57.67,0:04:00.67,Default,Kyo,0,0,0,,Tôi vừa mới lấy bằng lái hồi tuần trước thôi mà.
Dialogue: 0,0:04:04.26,0:04:05.30,Default,Kyo,0,0,0,,Được rồi.
Dialogue: 0,0:04:05.30,0:04:06.97,Default,Kyo,0,0,0,,Không bị móp méo gì.
Dialogue: 0,0:04:06.97,0:04:08.89,Default,Kyo,0,0,0,,Tôi sẽ tha cho cậu không phải đền tiền sửa xe đấy.
Dialogue: 0,0:04:09.47,0:04:10.72,Default,Kyo,0,0,0,,Biết điều thì lo mà cảm ơn đi nhé.
Dialogue: 0,0:04:10.72,0:04:14.98,Default,Oka,0,0,0,,Này, trong vụ này tôi mới là người bị hại cơ mà?
Dialogue: 0,0:04:18.90,0:04:20.69,Default,Sun,0,0,0,,Fujibayashi Kyou đấy à?
Dialogue: 0,0:04:20.69,0:04:23.53,Default,Sun,0,0,0,,Trường mình lắm con gái hung hãn dữ dằn thật đấy nhỉ?
Dialogue: 0,0:04:23.53,0:04:27.37,Default,Oka,0,0,0,,Sunohara. Hiếm khi thấy mày vác mặt đến trường vào cái giờ giấc đàng hoàng thế này đấy.
Dialogue: 0,0:04:29.03,0:04:31.95,Default,Sun,0,0,0,,Tao thích giải quyết nợ nần cho nhanh gọn lẹ mà.
Dialogue: 0,0:04:31.95,0:04:34.54,Default,Sun,0,0,0,,Như món nợ tao phải trả cho con nhỏ hung hãn kia chẳng hạn.
Dialogue: 0,0:04:35.71,0:04:37.75,Default,Tom,0,0,0,,Cậu dai như đỉa đói vậy.
Dialogue: 0,0:04:37.75,0:04:41.26,Default,Sun,0,0,0,,Hôm nọ tao hơi mất phong độ thôi, chứ hôm nay thì đừng hòng!
Dialogue: 0,0:04:41.26,0:04:43.92,Default,Sun,0,0,0,,Khi khoảng cách giữa các lần lên bục ném quá dài,
Dialogue: 0,0:04:43.92,0:04:45.55,Default,Sun,0,0,0,,thì ngay cả tay ném bóng xuất sắc nhất…
Dialogue: 0,0:04:45.93,0:04:47.84,Default,Sun,0,0,0,,…cũng có thể bị đánh bại như thường!
Dialogue: 0,0:04:47.84,0:04:50.60,Default,Oka,0,0,0,,Một sự ví von dở hơi hết chỗ nói.
Dialogue: 0,0:04:52.22,0:04:55.31,Default,Tom,0,0,0,,Nghe lời khuyên của tôi mà dừng lại đi.
Dialogue: 0,0:04:55.31,0:04:58.11,Default,Tom,0,0,0,,Hay là cậu muốn bị chấn thương đến mức không thể đến trường được nữa?
Dialogue: 0,0:05:01.73,0:05:05.40,Default,Sun,0,0,0,,Để xem rốt cuộc đứa nào trong hai đứa mình\Nmới là đứa không thể đến trường được nữa đây!
Dialogue: 0,0:05:05.82,0:05:07.66,Default,Tom,0,0,0,,Hết thuốc chữa rồi.
Dialogue: 0,0:05:08.28,0:05:10.37,Default,Tom,0,0,0,,Anh làm nhân chứng giúp tôi được không?
Dialogue: 0,0:05:10.37,0:05:12.29,Default,Tom,0,0,0,,Rằng đây hoàn toàn là hành vi phòng vệ chính đáng.
Dialogue: 0,0:05:12.29,0:05:14.87,Default,Oka,0,0,0,,Được chứ, vì sự thật đúng là như thế mà.
Dialogue: 0,0:05:14.87,0:05:15.87,Default,Oka,0,0,0,,Xong rồi đấy.
Dialogue: 0,0:05:16.37,0:05:18.46,Default,Tom,0,0,0,,Vậy, cậu muốn tôi xử lý thế nào đây?
Dialogue: 0,0:05:18.46,0:05:21.04,Default,Tom,0,0,0,,Cậu có muốn tôi làm cho cậu không gượng dậy nổi suốt một thời gian không?
Dialogue: 0,0:05:21.04,0:05:22.59,Default,Sun,0,0,0,,Có giỏi thì làm thử xem nào!
Dialogue: 0,0:05:22.59,0:05:25.17,Default,Sun,0,0,0,,Bớt ba hoa chích chòe đi, nhào vô!
Dialogue: 0,0:05:30.68,0:05:32.68,Default,Oka,0,0,0,,Oa, được bay trên không trung luôn kìa.
Dialogue: 0,0:05:32.68,0:05:35.18,Default,Tom,0,0,0,,Anh bạn đằng kia ơi! Mở nắp ống xả rác ra giùm tôi với!
Dialogue: 0,0:05:41.69,0:05:43.82,Default,Sun,0,0,0,,Cứu tao với mày ơi!
Dialogue: 0,0:05:47.49,0:05:49.45,Default,Tom,0,0,0,,Nếu tôi buông mấy ngón tay này ra là cậu rơi thẳng xuống đấy. Cậu muốn thế nào?
Dialogue: 0,0:05:50.37,0:05:51.49,Default,Tom,0,0,0,,Cậu muốn rơi xuống chứ gì?
Dialogue: 0,0:05:51.49,0:05:52.33,Default,Tom,0,0,0,,Muốn đúng không?
Dialogue: 0,0:05:52.33,0:05:53.95,Default,Sun,0,0,0,,Tao đã kịp trả lời đâu trời ơi!
Dialogue: 0,0:06:02.50,0:06:04.05,Default,Tom,0,0,0,,Tôi có làm hơi quá tay không nhỉ?
Dialogue: 0,0:06:04.05,0:06:06.92,Default,Oka,0,0,0,,Không đâu, tôi dám chắc là nó vẫn sống nhăn răng thôi.
Dialogue: 0,0:06:07.97,0:06:11.93,Default,Oka,0,0,0,,Này! Sunohara! Mày còn thở không đấy?
Dialogue: 0,0:06:11.93,0:06:14.39,Default,Sun,0,0,0,,Biến đi đồ khốn! Chưa kết thúc ở đây đâu con kia!
Dialogue: 0,0:06:14.85,0:06:15.47,Default,Oka,0,0,0,,Nghe thấy rồi chứ?
Dialogue: 0,0:06:15.85,0:06:19.39,Default,Tom,0,0,0,,Tôi thực sự mong mọi chuyện kết thúc ở đây đấy.
Dialogue: 0,0:06:21.15,0:06:25.61,Default,Tom,0,0,0,,Cơ mà… nhìn thấy hai anh làm tôi lại nhớ về những kỷ niệm xưa.
Dialogue: 0,0:06:27.19,0:06:28.40,Default,Tom,0,0,0,,Thôi khỏi đi.
Dialogue: 0,0:06:28.40,0:06:29.49,Default,Tom,0,0,0,,Cứ coi như tôi chưa nói gì đi nhé.
Dialogue: 0,0:06:33.87,0:06:34.87,Default,Guy,0,0,0,,Mày thấy tận mắt rồi đúng không?
Dialogue: 0,0:06:34.87,0:06:37.25,Default,Guy,0,0,0,,Ừ, hóa ra con bé đó thực sự có tồn tại.
Dialogue: 0,0:06:37.66,0:06:39.08,Default,Oka,0,0,0,,Hai người đang bàn tán chuyện gì thế?
Dialogue: 0,0:06:39.08,0:06:40.21,Default,Guy,0,0,0,,Ồ, Okazaki đấy à.
Dialogue: 0,0:06:40.21,0:06:42.29,Default,Guy,0,0,0,,Nó vừa lượn lờ ở ngoài hành lang này xong.
Dialogue: 0,0:06:42.29,0:06:43.71,Default,Guy,0,0,0,,Hồn ma của một nữ sinh ấy.
Dialogue: 0,0:06:43.71,0:06:47.92,Default,Guy,0,0,0,,Nó sẽ tiến lại gần rồi dúi vào tay mày một món đồ bị nguyền rủa.
Dialogue: 0,0:06:47.92,0:06:52.47,Default,Guy,0,0,0,,Nhìn thoáng qua thì như một đứa con gái bình thường, nhưng có điểm gì đó rất kỳ quái.
Dialogue: 0,0:06:58.98,0:07:00.98,Default,Oka,0,0,0,,Cửa phòng không khóa à?
Dialogue: 0,0:06:58.98,0:07:00.98,Signs,Oka,0,0,0,,{\move(960,520,960,698,0,1982)\fnArial Black\fs81\b1\c&H908D8E&\blur0.5\frx5}Thư Viện
Dialogue: 0,0:07:07.69,0:07:09.95,Default,Oka,0,0,0,,Tuyệt cú mèo. Đánh một giấc ở đây là chuẩn bài.
Dialogue: 0,0:07:19.37,0:07:21.08,Default,Oka,0,0,0,,Này, này, này!
Dialogue: 0,0:07:22.62,0:07:24.96,Default,Oka,0,0,0,,Sách đó là của thư viện đúng không hả?
Dialogue: 0,0:07:24.96,0:07:26.75,Default,Oka,0,0,0,,Cậu không được tự tiện cắt xé lung tung như thế chứ!
Dialogue: 0,0:07:30.76,0:07:33.59,Default,Oka,0,0,0,,Đọc toàn thứ cao siêu phức tạp gớm nhỉ.
Dialogue: 0,0:07:34.30,0:07:36.89,Default,Oka,0,0,0,,Cậu cũng đang cúp tiết đấy à?
Dialogue: 0,0:07:37.39,0:07:39.06,Default,Oka,0,0,0,,Mà sao cậu lại đi chân trần thế kia?
Dialogue: 0,0:07:44.65,0:07:46.40,Default,Kot,0,0,0,,Tớ làm xong rồi nè.
Dialogue: 0,0:07:47.48,0:07:49.48,Default,Kot,0,0,0,,Cái này là cái làm đẹp nhất đấy.
Dialogue: 0,0:07:49.48,0:07:52.28,Default,Oka,0,0,0,,Thư viện cấm ăn uống cậu không biết à?
Dialogue: 0,0:07:52.28,0:07:53.28,Default,Kot,0,0,0,,Cậu có muốn ăn một miếng không?
Dialogue: 0,0:07:58.54,0:08:00.66,Default,Oka,0,0,0,,Được thôi, nếu cậu đã có lòng mời.
Dialogue: 0,0:08:02.08,0:08:03.17,Default,Oka,0,0,0,,Gì cơ?
Dialogue: 0,0:08:03.17,0:08:05.25,Default,Kot,0,0,0,,Tớ chỉ có đúng một đôi đũa này thôi.
Dialogue: 0,0:08:14.43,0:08:15.51,Default,Oka,0,0,0,,Ăn ngon đấy.
Dialogue: 0,0:08:19.93,0:08:22.14,Default,Oka,0,0,0,,Cậu mau dọn dẹp đi thôi,
Dialogue: 0,0:08:22.14,0:08:23.94,Default,Oka,0,0,0,,sắp đến giờ vào lớp rồi đấy.
Dialogue: 0,0:08:25.31,0:08:27.06,Default,Oka,0,0,0,,Cậu vẫn còn chuyện gì nữa à?
Dialogue: 0,0:08:29.19,0:08:30.15,Default,Kot,0,0,0,,Hẹn gặp lại cậu sau nhé.
Dialogue: 0,0:08:31.90,0:08:36.41,Default,Oka,0,0,0,,Chẳng lẽ cô bé đó chính là hồn ma của nạn nhân vụ tai nạn sao?
Dialogue: 0,0:08:36.41,0:08:39.91,Default,Ryo,0,0,0,,Đó có lẽ là Ichinose Kotomi-san của Lớp A đấy.
Dialogue: 0,0:08:39.91,0:08:41.70,Default,Oka,0,0,0,,Ichinose Kotomi?
Dialogue: 0,0:08:41.70,0:08:46.50,Default,Ryo,0,0,0,,Cậu ấy là một thiên tài luôn lọt vào top mười toàn quốc ở tất cả các môn thi đấy.
Dialogue: 0,0:08:46.50,0:08:51.38,Default,Ryo,0,0,0,,Tớ nghe nói cậu ấy được phép tự học thay vì phải lên lớp, và nhà trường hoàn toàn đồng ý chuyện đó.
Dialogue: 0,0:08:51.38,0:08:53.59,Default,Ryo,0,0,0,,Cậu ấy nổi tiếng khắp cả trường mình luôn đấy.
Dialogue: 0,0:08:53.59,0:08:55.93,Default,Oka,0,0,0,,Một cô nàng thiên tài sao…
Dialogue: 0,0:08:55.93,0:08:57.51,Default,Oka,0,0,0,,Hèn chi tính khí kỳ quặc đến thế.
Dialogue: 0,0:08:58.43,0:09:00.35,Default,Oka,0,0,0,,À phải rồi, Fujibayashi này!
Dialogue: 0,0:09:00.35,0:09:03.18,Default,Oka,0,0,0,,Chị gái cậu ấy! Không đùa được đâu đấy nhé!
Dialogue: 0,0:09:03.18,0:09:05.31,Default,Ryo,0,0,0,,Chị em có vấn đề gì sao ạ?
Dialogue: 0,0:09:05.31,0:09:07.81,Default,Oka,0,0,0,,Thì đấy, cậu ta dám đi xe m—
Dialogue: 0,0:09:07.81,0:09:08.81,Default,Kyo,0,0,0,,Này! Tomoya!
Dialogue: 0,0:09:11.86,0:09:13.53,Default,Kyo,0,0,0,,Ra ngoài này với tôi một lát mau.
Dialogue: 0,0:09:15.86,0:09:17.61,Default,Guys,0,0,0,,"Xe m"? Xe m gì cơ?
Dialogue: 0,0:09:17.61,0:09:18.87,Default,Ryo,0,0,0,,"Xe m" là sao ạ?
Dialogue: 0,0:09:19.03,0:09:22.79,Default,Kyo,0,0,0,,Cậu nghĩ mình đang làm cái trò gì\Nmà lại bô bô cái miệng giữa lớp học thế hả?
Dialogue: 0,0:09:22.79,0:09:25.21,Default,Oka,0,0,0,,"Trò gì" là sao? Cái chuyện cậu đi xe m—
Dialogue: 0,0:09:25.58,0:09:28.38,Default,Kyo,0,0,0,,Cậu muốn tôi bị đình chỉ học đấy à?
Dialogue: 0,0:09:28.38,0:09:31.17,Default,Kyo,0,0,0,,Cậu thừa biết trường mình cấm học sinh lái xe máy đi học mà, đúng không hả?
Dialogue: 0,0:09:32.25,0:09:36.30,Default,Ryo,0,0,0,,Okazaki-kun, cậu vừa nói chuyện gì với chị Kyou thế?
Dialogue: 0,0:09:37.13,0:09:39.09,Default,Oka,0,0,0,,Mọi người nghe đây!
Dialogue: 0,0:09:39.09,0:09:41.81,Default,Oka,0,0,0,,Fujibayashi Kyou lớp Mười Một E là dân song tính luyến ái (bi) đấy!
Dialogue: 0,0:09:44.39,0:09:45.06,Default,Guy,0,0,0,,Thật đấy à?!
Dialogue: 0,0:09:45.06,0:09:46.56,Default,Ryo,0,0,0,,"Song tính" sao ạ?
Dialogue: 0,0:09:46.56,0:09:47.27,Default,Guy,0,0,0,,Bi thật á?!
Dialogue: 0,0:09:47.27,0:09:49.27,Default,Guy,0,0,0,,Cậu ấy chơi được với cả trai lẫn gái luôn sao?
Dialogue: 0,0:09:49.27,0:09:51.48,Default,Guy,0,0,0,,Ừ, nhìn cậu ấy cũng có nét nam tính mạnh mẽ thật.
Dialogue: 0,0:09:56.53,0:09:59.57,Default,Kyo,0,0,0,,Thằng khốn nạn nhà mày…
Dialogue: 0,0:09:59.57,0:10:01.70,Default,Ryo,0,0,0,,Chị hai, có thật là như lời cậu ấy nói không…
Dialogue: 0,0:10:01.70,0:10:03.79,Default,Kyo,0,0,0,,Sao em lại đi tin lời cái thằng ranh đó hả?!
Dialogue: 0,0:10:03.79,0:10:06.33,Default,Kyo,0,0,0,,Là "xe máy"! Bọn chị đang nói về chiếc xe tay ga cơ mà!
Dialogue: 0,0:10:17.63,0:10:18.59,Default,Oka,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:10:20.39,0:10:21.85,Default,Oka,0,0,0,,Cậu đang làm nhiệm vụ trực nhật à?
Dialogue: 0,0:10:23.68,0:10:24.64,Default,Oka,0,0,0,,Cậu ở lại có một mình thôi à?
Dialogue: 0,0:10:27.43,0:10:29.98,Default,Oka,0,0,0,,Furukawa, có chuyện gì xảy ra sao?
Dialogue: 0,0:10:32.19,0:10:34.23,Default,Nag,0,0,0,,Dạ không, không có gì đâu.
Dialogue: 0,0:10:34.94,0:10:38.61,Default,Nag,0,0,0,,Tớ sẽ dọn dẹp xong ngay thôi, nên cậu cứ qua phòng câu lạc bộ đợi tớ nhé.
Dialogue: 0,0:10:44.99,0:10:46.12,Default,Oka,0,0,0,,Được thôi.
Dialogue: 0,0:10:46.66,0:10:50.33,Default,Oka,0,0,0,,Chúng ta phải chiêu mộ thêm thành viên thôi, chứ không thì chẳng đi đến đâu cả.
Dialogue: 0,0:10:50.33,0:10:52.29,Default,Oka,0,0,0,,Hãy làm tờ rơi để tuyển thành viên đi.
Dialogue: 0,0:10:52.29,0:10:53.00,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:10:55.34,0:10:57.76,Default,Oka,0,0,0,,Nên chọn ngày diễn ra sau Lễ Thành Lập trường thì hơn.
Dialogue: 0,0:10:58.05,0:10:58.63,Default,Nag,0,0,0,,Vâng ạ.
