Dialogue: 0,0:11:00.84,0:11:02.01,Default,Nag,0,0,0,,Viết xong rồi này!
Dialogue: 0,0:11:02.01,0:11:04.35,Default,Oka,0,0,0,,Hình như vẫn còn thiếu thiếu thứ gì đó nhỉ?
Dialogue: 0,0:11:04.35,0:11:06.35,Default,Nag,0,0,0,,Thật sao cậu?
Dialogue: 0,0:11:07.31,0:11:12.60,Default,Oka,0,0,0,,Hay là thêm câu: "Chủ nhiệm câu lạc bộ dễ thương nhất trường sẽ đứng đón bạn" nhé?
Dialogue: 0,0:11:13.77,0:11:16.69,Default,Nag,0,0,0,,Chủ nhiệm dễ thương nhất trường sẽ…
Dialogue: 0,0:11:17.90,0:11:20.24,Default,Nag,0,0,0,,Ừm, người đó là…
Dialogue: 0,0:11:20.24,0:11:22.53,Default,Oka,0,0,0,,Còn ai vào đây nữa chứ?
Dialogue: 0,0:11:23.66,0:11:28.12,Default,Oka,0,0,0,,Cứ viết thế vào, khéo có mấy tên đực rựa đần độn sập bẫy đấy.
Dialogue: 0,0:11:27.45,0:11:30.58,Default-alt,Nag,0,0,0,,Tớ chẳng muốn người ta đến chỉ vì lý do đó đâu!
Dialogue: 0,0:11:30.58,0:11:33.42,Default,Nag,0,0,0,,Với lại, cậu làm chủ nhiệm thì hợp hơn nhiều mà!
Dialogue: 0,0:11:33.42,0:11:36.42,Default,Oka,0,0,0,,Hôm qua tôi bảo với cậu rồi, tôi chỉ giúp đỡ thôi.
Dialogue: 0,0:11:36.42,0:11:38.84,Default,Oka,0,0,0,,Tôi chẳng có chút hứng thú nào với kịch nghệ cả.
Dialogue: 0,0:11:38.84,0:11:42.05,Default,Oka,0,0,0,,Ngay cả khi câu lạc bộ hoạt động trở lại, tôi cũng sẽ không tham gia đâu.
Dialogue: 0,0:11:43.01,0:11:44.84,Default,Nag,0,0,0,,Cậu không tham gia sao?
Dialogue: 0,0:11:44.84,0:11:48.56,Default,Oka,0,0,0,,Cậu mới là trung tâm của mọi chuyện.
Dialogue: 0,0:11:48.56,0:11:51.02,Default,Oka,0,0,0,,Chủ nhiệm mới là người đưa ra quyết định cuối cùng.
Dialogue: 0,0:11:51.64,0:11:53.77,Default,Oka,0,0,0,,Hơn nữa, cậu còn có một vở kịch mà bản thân hằng ấp ủ muốn diễn nữa cơ mà, đúng không?
Dialogue: 0,0:11:54.81,0:11:57.82,Default,Nag,0,0,0,,Thế nhưng, liệu tớ có làm nổi không?
Dialogue: 0,0:11:57.82,0:11:59.57,Default,Oka,0,0,0,,Lên tinh thần lại xem nào.
Dialogue: 0,0:11:59.57,0:12:02.45,Default,Oka,0,0,0,,Tờ rơi này cậu cũng cứ viết vẽ tùy thích theo ý mình đi.
Dialogue: 0,0:12:04.36,0:12:05.66,Default,Nag,0,0,0,,Theo ý mình sao…
Dialogue: 0,0:12:05.66,0:12:09.54,Default,Nag,0,0,0,,Vậy thì, tớ có thể vẽ hình minh họa mà tớ thích lên được không?
Dialogue: 0,0:12:09.54,0:12:14.08,Default,Oka,0,0,0,,Được chứ. Chỉ toàn chữ không thì đơn điệu lắm.
Dialogue: 0,0:12:14.08,0:12:15.29,Default,Nag,0,0,0,,Tuyệt quá!
Dialogue: 0,0:12:15.79,0:12:17.25,Default,Nag,0,0,0,,Vậy thì…
Dialogue: 0,0:12:17.67,0:12:23.72,Default,Nag,0,0,0,,Dango, dango, dango, dango.
Dialogue: 0,0:12:23.72,0:12:27.22,Default,Nag,0,0,0,,Đại gia đình dango thân thương.
Dialogue: 0,0:12:27.93,0:12:29.18,Default,Nag,0,0,0,,Vẽ xong rồi này!
Dialogue: 0,0:12:32.02,0:12:34.44,Default,Oka,0,0,0,,Cái thứ đó từng thịnh hành từ đời nào rồi mà…
Dialogue: 0,0:12:34.44,0:12:36.77,Default,Nag,0,0,0,,Vâng! Là Đại Gia Đình Dango đấy ạ!
Dialogue: 0,0:12:36.77,0:12:39.11,Default,Nag,0,0,0,,Tớ thích lắm luôn!
Dialogue: 0,0:12:39.11,0:12:42.28,Default,Oka,0,0,0,,Sao lại cứ nhất thiết phải là Đại Gia Đình Dango chứ?
Dialogue: 0,0:12:42.28,0:12:45.20,Default,Oka,0,0,0,,Cái trào lưu đó đã chìm xuồng từ lâu lắm rồi mà!
Dialogue: 0,0:12:45.20,0:12:48.49,Default,Nag,0,0,0,,Thế nhưng với tớ thì chúng vẫn đáng yêu vô cùng.
Dialogue: 0,0:12:49.41,0:12:51.12,Default,Nag,0,0,0,,Cậu thấy vẽ thế này không đẹp sao?
Dialogue: 0,0:12:51.12,0:12:55.17,Default,Oka,0,0,0,,À thôi, nếu cậu thấy thích thì cứ để thế đi.
Dialogue: 0,0:12:55.17,0:12:57.33,Default,Oka,0,0,0,,Dù sao tôi cũng bảo cậu cứ làm theo ý mình mà.
Dialogue: 0,0:12:58.46,0:12:59.79,Default,Nag,0,0,0,,Thịt heo chiên xù (Tonkatsu)!
Dialogue: 0,0:13:03.88,0:13:06.89,Default,Nag,0,0,0,,Đây là câu thần chú để tớ tự cổ vũ bản thân đấy.
Dialogue: 0,0:13:07.34,0:13:11.22,Default,Nag,0,0,0,,Tự hứa sẽ thưởng cho mình món ăn yêu thích nếu bản thân đã nỗ lực hết mình.
Dialogue: 0,0:13:12.35,0:13:13.68,Default,Nag,0,0,0,,Nghe kỳ quặc lắm đúng không cậu?
Dialogue: 0,0:13:14.39,0:13:16.27,Default,Oka,0,0,0,,Không, chẳng có gì kỳ quặc cả.
Dialogue: 0,0:13:17.98,0:13:21.57,Default,Oka,0,0,0,,Thay vì thịt heo chiên xù, lát nữa đi kiếm\Nmột con thú bông Đại Gia Đình Dango mang về nhà nhé.
Dialogue: 0,0:13:21.57,0:13:23.15,Default,Oka,0,0,0,,Sau khi dán xong hết đống tờ rơi này.
Dialogue: 0,0:13:24.90,0:13:25.65,Default,Nag,0,0,0,,Vâng!
Dialogue: 0,0:13:27.78,0:13:29.99,Default,Oka,0,0,0,,Mình đúng là rảnh rỗi sinh nông nổi mà.
Dialogue: 0,0:13:29.99,0:13:30.66,Default,Fuk,0,0,0,,Đau quá.
Dialogue: 0,0:13:44.05,0:13:45.38,Default,Fuk,0,0,0,,Đau quá đi.
Dialogue: 0,0:13:55.81,0:13:58.14,Default,Oka,0,0,0,,T-Tôi làm em giật mình à?
Dialogue: 0,0:13:58.14,0:13:59.56,Default,Oka,0,0,0,,Tôi xin lỗi nhé.
Dialogue: 0,0:13:59.56,0:14:01.90,Default,Oka,0,0,0,,Đây là phòng sinh hoạt của câu lạc bộ mỹ thuật à?
Dialogue: 0,0:14:03.61,0:14:06.24,Default,Oka,0,0,0,,Vậy em đang làm bài tập mỹ thuật đấy à?
Dialogue: 0,0:14:07.20,0:14:08.66,Default,Oka,0,0,0,,Thế cái vật đó là thứ gì vậy?
Dialogue: 0,0:14:10.11,0:14:11.66,Default,Fuk,0,0,0,,Cái này á?
Dialogue: 0,0:14:11.66,0:14:16.16,Default,Fuk,0,0,0,,Đây là món đồ mà Fuko thích nhất…
Dialogue: 0,0:14:16.66,0:14:18.29,Default,Oka,0,0,0,,Này. Alo?
Dialogue: 0,0:14:30.39,0:14:31.01,Default,Oka,0,0,0,,Này nhóc!
Dialogue: 0,0:14:36.81,0:14:38.23,Default,Oka,0,0,0,,Lưỡi dao bị mẻ hết rồi kìa.
Dialogue: 0,0:14:38.23,0:14:40.40,Default,Oka,0,0,0,,Em dùng thứ này nguy hiểm lắm đấy.
Dialogue: 0,0:14:40.40,0:14:42.02,Default,Fuk,0,0,0,,Xin anh hãy trả lại cho Fuko!
Dialogue: 0,0:14:42.02,0:14:45.23,Default,Oka,0,0,0,,Phải chắc chắn là chỉ dùng dao sắc thôi đấy nhé.
Dialogue: 0,0:14:45.23,0:14:47.19,Default,Oka,0,0,0,,Trong xưởng mỹ thuật chắc có dao tốt hơn mà, đúng không?
Dialogue: 0,0:14:47.19,0:14:48.65,Default,Fuk,0,0,0,,Làm ơn trả lại cho Fuko đi mà!
Dialogue: 0,0:14:49.07,0:14:50.78,Default,Oka,0,0,0,,Tay em đang đau đúng không?
Dialogue: 0,0:14:51.41,0:14:52.95,Default,Fuk,0,0,0,,Không, không hề đau chút nào hết.
Dialogue: 0,0:14:52.95,0:14:53.78,Default,Oka,0,0,0,,Đưa bàn tay đây xem nào.
Dialogue: 0,0:14:53.78,0:14:54.33,Default,Fuk,0,0,0,,Vâng.
Dialogue: 0,0:14:55.24,0:14:57.20,Default,Oka,0,0,0,,Thấy chưa, rõ ràng là đau rành rành ra đấy.
Dialogue: 0,0:14:57.20,0:14:58.87,Default,Fuk,0,0,0,,Không đau mà.
Dialogue: 0,0:15:00.42,0:15:01.71,Default,Oka,0,0,0,,Đập tay năm ngón cái nào (Give me five).
Dialogue: 0,0:15:01.71,0:15:03.04,Default,Fuk,0,0,0,,Năm ngón ạ?
Dialogue: 0,0:15:03.04,0:15:07.26,Default,Oka,0,0,0,,Cái trò mà người ta hay đập tay vào nhau\Nsau khi ném bóng rổ vào rổ ấy.
Dialogue: 0,0:15:07.26,0:15:09.84,Default,Fuk,0,0,0,,Fuko biết trò đó! Fuko từng thấy qua rồi!
Dialogue: 0,0:15:09.84,0:15:11.30,Default,Oka,0,0,0,,Được rồi. Thế thì đập tay ăn mừng nào.
Dialogue: 0,0:15:11.30,0:15:11.72,Default,Oka,0,0,0,,Sẵn sàng chưa?
Dialogue: 0,0:15:11.72,0:15:13.64,Default,Fuk,0,0,0,,Dẫn bóng…
Dialogue: 0,0:15:13.64,0:15:14.72,Default,Fuk,0,0,0,,Ném bóng!
Dialogue: 0,0:15:14.72,0:15:15.85,Default,Oka,0,0,0,,Nhất thiết phải diễn trọn bài từ tuốt đằng xa thế à?
Dialogue: 0,0:15:15.85,0:15:17.31,Default,Fuk,0,0,0,,Fuko làm được rồi!
Dialogue: 0,0:15:19.10,0:15:21.56,Default,Oka,0,0,0,,Được lắm, cú ném đẹp đấy!
Dialogue: 0,0:15:21.56,0:15:22.56,Default,Oka,0,0,0,,Hoan hô!
Dialogue: 0,0:15:23.61,0:15:25.27,Default,Oka,0,0,0,,Thấy chưa, rõ ràng là đau điếng người ra kìa.
Dialogue: 0,0:15:26.77,0:15:28.44,Default,Oka,0,0,0,,Con dao này anh sẽ giữ giùm em.
Dialogue: 0,0:15:28.99,0:15:30.28,Default,Oka,0,0,0,,Chào nhóc nhé.
Dialogue: 0,0:15:35.12,0:15:38.04,Default,Oka,0,0,0,,Tờ cuối cùng xong xuôi.
Dialogue: 0,0:15:38.04,0:15:39.91,Default,Sun,0,0,0,,"Gia Nhập Câu Lạc Bộ Kịch"?
Dialogue: 0,0:15:39.91,0:15:42.67,Default,Sun,0,0,0,,Okazaki, mày cũng dính dáng vào mấy trò này đấy à?
Dialogue: 0,0:15:42.67,0:15:44.54,Default,Oka,0,0,0,,Thế từ nãy đến giờ mày đi đâu?
Dialogue: 0,0:15:45.42,0:15:47.84,Default,Sun,0,0,0,,Tập luyện khổ nhục kế để đánh bại Sakagami Tomoyo chứ đâu.
Dialogue: 0,0:15:48.63,0:15:51.09,Default,Sun,0,0,0,,Cơ mà, câu lạc bộ kịch sao?
Dialogue: 0,0:15:51.09,0:15:55.55,Default,Sun,0,0,0,,Tao ngạc nhiên khi thấy mày lại hứng thú với mấy cái câu lạc bộ nhảm nhí đấy đấy.
Dialogue: 0,0:15:56.89,0:16:02.77,Default,Sun,0,0,0,,Mày lúc nào chả ghét cay ghét đắng mấy đứa tham gia câu lạc bộ tới mức muốn nôn mửa ra còn gì.
Dialogue: 0,0:16:03.73,0:16:07.11,Default,Sun,0,0,0,,Thôi thì, lát nữa mày phải khai báo chi tiết cho tao nghe đấy nhé.
Dialogue: 0,0:16:07.11,0:16:07.69,Default,Sun,0,0,0,,Gặp lại sau.
Dialogue: 0,0:16:09.48,0:16:10.82,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:16:13.61,0:16:17.08,Default,Nag,0,0,0,,Okazaki-san không thích các hoạt động câu lạc bộ sao?
Dialogue: 0,0:16:18.28,0:16:19.62,Default,Oka,0,0,0,,Đừng bận tâm làm gì.
Dialogue: 0,0:16:19.62,0:16:21.16,Default,Oka,0,0,0,,Chỉ là mấy câu chuyện phiếm vô nghĩa của nó thôi mà.
Dialogue: 0,0:16:24.42,0:16:27.04,Default,Oka,0,0,0,,Người ta không bán nữa thì cũng đành chịu thôi.
Dialogue: 0,0:16:29.13,0:16:32.09,Default,Oka,0,0,0,,Cơ mà, mấy con này chắc cũng đỡ hơn là tay không.
Dialogue: 0,0:16:35.09,0:16:37.18,Default,OkaF,0,0,0,,Ồ, món đồ này hoài niệm thật đấy.
Dialogue: 0,0:16:41.10,0:16:43.18,Default,OkaF,0,0,0,,Con định làm gì với chúng thế?
Dialogue: 0,0:16:44.98,0:16:46.56,Default,Oka,0,0,0,,Con đem tặng cho bạn con.
Dialogue: 0,0:16:47.02,0:16:49.82,Default,OkaF,0,0,0,,Để bố giúp con một tay được không?
Dialogue: 0,0:16:50.15,0:16:51.65,Default,OkaF,0,0,0,,Bố phải làm thế nào đây?
Dialogue: 0,0:16:52.90,0:16:54.45,Default,OkaF,0,0,0,,Con chỉ cho bố với nhé?
Dialogue: 0,0:16:55.49,0:16:57.07,Default,Oka,0,0,0,,Đừng có đụng vào!
Dialogue: 0,0:16:57.82,0:16:59.62,Default,Oka,0,0,0,,Thôi ngay cái trò đó đi!
Dialogue: 0,0:17:00.33,0:17:03.79,Default,Oka,0,0,0,,Sao lúc nào bố cũng nói chuyện với con như thể người xa lạ thế hả?!
Dialogue: 0,0:17:03.79,0:17:06.42,Default,Oka,0,0,0,,Rốt cuộc đối với bố, con là cái thứ gì hả?!
Dialogue: 0,0:17:08.54,0:17:09.71,Default,OkaF,0,0,0,,Tomoya-kun…
Dialogue: 0,0:17:14.38,0:17:16.34,Default,Oka,0,0,0,,Khốn kiếp thật. Khốn kiếp.
Dialogue: 0,0:17:16.76,0:17:17.34,Default,Oka,0,0,0,,Khốn kiếp mà!
Dialogue: 0,0:17:33.19,0:17:35.40,Default,Nag,0,0,0,,Đại Gia Đình Dango kìa.
Dialogue: 0,0:17:35.40,0:17:37.32,Default,Oka,0,0,0,,Dù không phải hàng chính hãng xịn sò cho lắm.
Dialogue: 0,0:17:38.66,0:17:39.91,Default,Nag,0,0,0,,Tớ vui lắm.
Dialogue: 0,0:17:40.49,0:17:42.62,Default,Nag,0,0,0,,Đúng thật là một đại gia đình đông đúc.
Dialogue: 0,0:17:42.62,0:17:45.25,Default,Nag,0,0,0,,Giá mà tớ cũng được trở thành một phần trong gia đình họ nhỉ.
Dialogue: 0,0:17:48.88,0:17:52.46,Default,Nag,0,0,0,,Thật lòng mà nói, hôm nay tớ đã buồn bã suốt cả ngày.
Dialogue: 0,0:17:53.71,0:17:59.30,Default,Nag,0,0,0,,Lúc trực nhật, ban đầu tớ cũng làm chung với mọi người trong lớp.
Dialogue: 0,0:17:59.30,0:18:01.47,Default,Nag,0,0,0,,Thế nhưng chẳng biết từ lúc nào, chỉ còn lại mỗi một mình tớ.
Dialogue: 0,0:18:01.93,0:18:02.85,Default,Oka,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:18:03.22,0:18:06.27,Default,Nag,0,0,0,,Từ trước đến giờ tớ lúc nào cũng vụng về như thế cả.
Dialogue: 0,0:18:07.35,0:18:11.23,Default,Nag,0,0,0,,Từ nhỏ tớ đã hay bị bạn bè trêu chọc xa lánh như vậy rồi.
Dialogue: 0,0:18:12.15,0:18:15.23,Default,Nag,0,0,0,,Thế nhưng, giờ thì tớ thấy lòng nhẹ nhõm hơn nhiều rồi.
Dialogue: 0,0:18:15.23,0:18:16.99,Default,Nag,0,0,0,,Tất cả là nhờ có Okazaki-san đấy.
Dialogue: 0,0:18:24.66,0:18:26.54,Default,Oka,0,0,0,,Chuyện lúc nãy tôi kể…
Dialogue: 0,0:18:26.54,0:18:27.33,Default,Nag,0,0,0,,Vâng?
Dialogue: 0,0:18:27.33,0:18:30.29,Default,Oka,0,0,0,,Cả Sunohara và tôi đều vào trường này theo diện tuyển thẳng thể thao.
Dialogue: 0,0:18:31.08,0:18:33.13,Default,Oka,0,0,0,,Cậu biết chuyện tuyển thẳng thể thao đúng không?
Dialogue: 0,0:18:34.38,0:18:37.01,Default,Oka,0,0,0,,Sunohara vào vì bóng đá, còn tôi vào vì bóng rổ.
Dialogue: 0,0:18:37.01,0:18:39.63,Default,Oka,0,0,0,,Thế nhưng tôi đã bỏ cuộc ngay sau khi vừa nhập học.
Dialogue: 0,0:18:39.63,0:18:41.55,Default,Oka,0,0,0,,Đằng sau chuyện đó có một vài uẩn khúc.
Dialogue: 0,0:18:41.55,0:18:44.01,Default,Nag,0,0,0,,Cậu không còn yêu thích bóng rổ nữa sao?
Dialogue: 0,0:18:44.93,0:18:46.60,Default,Oka,0,0,0,,Không phải thế, nhưng mà…
Dialogue: 0,0:18:46.93,0:18:49.69,Default,Oka,0,0,0,,…tôi cũng chẳng còn động vào quả bóng nào suốt bấy lâu nay rồi.
Dialogue: 0,0:18:51.19,0:18:56.78,Default,Nag,0,0,0,,Okazaki-san, nếu vậy thì, chiều mai sau giờ học cậu có muốn chơi bóng rổ cùng tớ không?
Dialogue: 0,0:18:57.74,0:19:01.11,Default,Nag,0,0,0,,Thật ra thể lực của tớ cũng cừ khôi lắm đấy nhé.
Dialogue: 0,0:19:01.11,0:19:03.49,Default,Nag,0,0,0,,Chiều mai sau giờ học tớ sẽ đợi cậu ở sân bóng rổ nhé.
Dialogue: 0,0:19:03.49,0:19:05.49,Default,Oka,0,0,0,,Không, tôi…
Dialogue: 0,0:19:05.49,0:19:06.87,Default,Nag,0,0,0,,Chúng mình cùng chơi bóng rổ nhé.
Dialogue: 0,0:19:16.63,0:19:20.93,Default,Nag,0,0,0,,…nếu vậy thì, chiều mai sau giờ học cậu có muốn chơi bóng rổ cùng tớ không?
Dialogue: 0,0:19:23.64,0:19:26.51,Default,Sun,0,0,0,,Okazaki, hôm nay cúp học đi mày.
Dialogue: 0,0:19:26.51,0:19:28.56,Default,Sun,0,0,0,,Đằng nào hôm nay cũng là thứ Bảy, chỉ học có nửa buổi thôi mà.
Dialogue: 0,0:19:29.52,0:19:30.69,Default,Oka,0,0,0,,Ừ…
Dialogue: 0,0:19:38.11,0:19:41.03,Default,Sun,0,0,0,,Sao mày cứ nhìn chằm chằm ra ngoài cửa sổ thế?
Dialogue: 0,0:19:46.74,0:19:49.04,Default,Oka,0,0,0,,Tao mượn cái ô của mày nhé, Sunohara.
Dialogue: 0,0:19:52.54,0:19:53.92,Default,Oka,0,0,0,,Chẳng lẽ cậu ấy lại… không đời nào đúng không?
Dialogue: 0,0:20:04.26,0:20:05.43,Default,Oka,0,0,0,,Furukawa!
Dialogue: 0,0:20:11.06,0:20:12.06,Default,Nag,0,0,0,,Okazaki-san.
Dialogue: 0,0:20:12.06,0:20:13.64,Default,Oka,0,0,0,,Cậu có bị ngốc không đấy hả?!
Dialogue: 0,0:20:13.64,0:20:15.86,Default,Oka,0,0,0,,Trời mưa tầm tã thế này, đáng lẽ cậu phải về nhà từ sớm rồi chứ!
Dialogue: 0,0:20:15.86,0:20:21.24,Default,Nag,0,0,0,,Thế nhưng lỡ như cậu đến mà tớ đã về rồi, thì chúng mình sẽ bị lỡ mất nhau…
Dialogue: 0,0:20:21.24,0:20:23.74,Default,Oka,0,0,0,,Lấy cái gì đảm bảo là tôi nhất định sẽ đến cơ chứ?!
Dialogue: 0,0:20:24.53,0:20:26.99,Default,Nag,0,0,0,,Thế nhưng cậu đã đến đây rồi mà.
Dialogue: 0,0:20:28.49,0:20:32.33,Default,Nag,0,0,0,,Lúc nào cậu cũng giúp đỡ tớ hết.
Dialogue: 0,0:20:33.00,0:20:36.17,Default,Nag,0,0,0,,Nên tớ muốn ít nhất cũng có thể chơi bóng rổ cùng cậu một lần.
Dialogue: 0,0:20:36.50,0:20:37.75,Default,Nag,0,0,0,,Để đền đáp lại sự quan tâm của cậu.
Dialogue: 0,0:20:38.42,0:20:41.21,Default,Oka,0,0,0,,Trời mưa thế này thì còn chơi bời gì được nữa chứ?
Dialogue: 0,0:20:42.34,0:20:45.09,Default,Nag,0,0,0,,Vậy thì, cho tớ xem cậu ném một quả bóng đi.
Dialogue: 0,0:20:46.30,0:20:48.18,Default,Nag,0,0,0,,Tớ muốn được nhìn thấy nó.
Dialogue: 0,0:20:48.18,0:20:52.27,Default,Nag,0,0,0,,Tớ chưa từng được tận mắt nhìn thấy một cầu thủ bóng rổ ném bóng ở cự ly gần bao giờ cả.
Dialogue: 0,0:20:52.27,0:20:55.65,Default,Nag,0,0,0,,Cậu sẽ vào tư thế như thế này rồi ném đúng không?
Dialogue: 0,0:20:56.90,0:21:00.32,Default,Nag,0,0,0,,Cậu sẽ không ném kiểu ngửa tay từ dưới lên như tớ đâu đúng không?
Dialogue: 0,0:21:27.47,0:21:29.76,Default,Oka,0,0,0,,Cánh tay phải của tôi… không nhấc lên được.
Dialogue: 0,0:21:31.81,0:21:37.52,Default,Oka,0,0,0,,Năm lớp chín, tôi đã đánh nhau với ông già ở nhà và bị chấn thương vai phải.
Dialogue: 0,0:21:38.15,0:21:40.15,Default,Oka,0,0,0,,Cánh tay tôi không thể nào nhấc cao hơn bả vai được nữa.
Dialogue: 0,0:21:42.36,0:21:45.90,Default,Oka,0,0,0,,Tôi… không thể chơi bóng rổ được nữa rồi.
Dialogue: 0,0:21:48.20,0:21:51.03,Default,Nag,0,0,0,,Tớ… Tớ xin lỗi…
Dialogue: 0,0:21:51.03,0:21:52.58,Default,Nag,0,0,0,,Tớ…
Dialogue: 0,0:21:53.12,0:21:54.16,Default,Oka,0,0,0,,Furukawa!
