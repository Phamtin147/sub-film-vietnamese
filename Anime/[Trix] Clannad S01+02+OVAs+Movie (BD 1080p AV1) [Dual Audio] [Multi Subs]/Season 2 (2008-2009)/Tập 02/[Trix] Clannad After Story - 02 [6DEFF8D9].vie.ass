Dialogue: 0,0:11:41.43,0:11:43.81,Default,Kot,0,0,0,,Được rồi. Mình sẽ giúp.
Dialogue: 0,0:11:43.81,0:11:44.81,Default,Sun,0,0,0,,Thật đấy à?!
Dialogue: 0,0:11:44.81,0:11:46.82,Default,Nag,0,0,0,,Kotomi-chan tốt bụng quá đi mất.
Dialogue: 0,0:11:46.82,0:11:50.15,Default,Kot,0,0,0,,Mình muốn giúp đỡ bạn bè của mình mà.
Dialogue: 0,0:11:50.15,0:11:52.70,Default,Kot,0,0,0,,Hãy nói cho mình biết mình cần phải làm gì đi.
Dialogue: 0,0:11:52.70,0:11:58.62,Default,Nag,0,0,0,,Nếu là hẹn hò thì tớ nghĩ hai người sẽ cùng nhau đi chơi và làm đủ thứ trò vui vẻ bên nhau.
Dialogue: 0,0:11:58.62,0:11:59.58,Default,Sun,0,0,0,,Đúng thế đấy.
Dialogue: 0,0:11:59.91,0:12:01.08,Default,Sun,0,0,0,,Chúng mình nên làm gì bây giờ nhỉ?
Dialogue: 0,0:12:02.04,0:12:03.21,Default,Kot,0,0,0,,Thế thì…
Dialogue: 0,0:12:05.71,0:12:08.55,Default,Oka,0,0,0,,Nhìn xem mày vừa bắt con người ta làm cái trò gì kìa!
Dialogue: 0,0:12:08.55,0:12:11.38,Default,Sun,0,0,0,,Không phải cây đàn vĩ cầm đã được sửa xong rồi sao?!
Dialogue: 0,0:12:11.38,0:12:14.51,Default,Kot,0,0,0,,Đúng vậy. Âm thanh nghe hay hơn lúc trước nhiều rồi.
Dialogue: 0,0:12:14.51,0:12:17.01,Default,Oka,0,0,0,,Thực ra là nó còn kinh khủng khiếp hơn trước ấy chứ!
Dialogue: 0,0:12:18.81,0:12:20.93,Default,Nag,0,0,0,,Sunohara-san, cậu làm thế có thực sự ổn không đấy?
Dialogue: 0,0:12:20.93,0:12:23.81,Default,Nag,0,0,0,,Cậu ấy đã đồng ý đóng giả giúp cậu rồi mà.
Dialogue: 0,0:12:24.23,0:12:27.69,Default,Sun,0,0,0,,Tao không có đủ thần kinh thép để chịu đựng nổi cái thứ âm thanh tra tấn ấy đâu.
Dialogue: 0,0:12:27.69,0:12:29.15,Default,Oka,0,0,0,,Đừng nản lòng bỏ cuộc vội.
Dialogue: 0,0:12:29.15,0:12:31.36,Default,Oka,0,0,0,,Chúng ta vẫn còn một tia hy vọng cuối cùng.
Dialogue: 0,0:12:31.86,0:12:33.36,Default,Oka,0,0,0,,Miyazawa, em có ở đây không?
Dialogue: 0,0:12:34.53,0:12:37.87,Default,Yuk,0,0,0,,Okazaki-san, Furukawa-san, Sunohara-san.
Dialogue: 0,0:12:37.87,0:12:38.99,Default,Yuk,0,0,0,,Lâu rồi không gặp mọi người.
Dialogue: 0,0:12:38.99,0:12:42.41,Default,Nag,0,0,0,,Vâng, lâu rồi không gặp em, Miyazawa-san.
Dialogue: 0,0:12:42.41,0:12:44.00,Default,Sun,0,0,0,,Yukine-chan đấy à?
Dialogue: 0,0:12:44.00,0:12:47.63,Default,Sun,0,0,0,,Trông em có vẻ dễ tính bảo gì làm nấy nhỉ.
Dialogue: 0,0:12:48.84,0:12:51.38,Default,Yuk,0,0,0,,Mọi người có chuyện gì thế ạ?
Dialogue: 0,0:12:52.38,0:12:54.38,Default,Yuk,0,0,0,,Đóng giả làm bạn gái sao ạ?
Dialogue: 0,0:12:54.38,0:12:56.43,Default,Yuk,0,0,0,,Nghe chừng khó khăn ghê.
Dialogue: 0,0:12:56.43,0:12:58.39,Default,Sun,0,0,0,,Không hề khó chút nào đâu!
Dialogue: 0,0:12:58.39,0:13:00.89,Default,Sun,0,0,0,,Anh sẽ dẫn dắt em chu đáo từ A đến Z luôn.
Dialogue: 0,0:13:00.89,0:13:02.68,Default,Sun,0,0,0,,Nên là xin em đấy, được không em?
Dialogue: 0,0:13:03.10,0:13:04.98,Default,Guy,0,0,0,,Tao đứng nghe nãy giờ ngứa cả tai rồi đấy…
Dialogue: 0,0:13:06.19,0:13:12.11,Default,Guy,0,0,0,,Mày nghĩ mày là cái thớ gì mà dám đòi hỏi cái trò đó ở chị Yuki-nee của bọn tao hả?!
Dialogue: 0,0:13:13.28,0:13:15.20,Default,Oka,0,0,0,,'Chị Yuki-nee của bọn tao' á?
Dialogue: 0,0:13:15.20,0:13:16.99,Default,Nag,0,0,0,,Miyazawa-san, người này là ai thế ạ?
Dialogue: 0,0:13:16.99,0:13:19.16,Default,Yuk,0,0,0,,Anh ấy là khách của em ạ.
Dialogue: 0,0:13:19.16,0:13:22.62,Default,Yuk,0,0,0,,Có chút chuyện rắc rối xảy ra nên anh ấy tạm thời trốn ở đây.
Dialogue: 0,0:13:22.62,0:13:24.16,Default,Guy,0,0,0,,Tao nói cho mày biết rõ ràng một điều này nhé!
Dialogue: 0,0:13:24.16,0:13:28.08,Default,Guy,0,0,0,,Nếu mày dám gây ra bất kỳ rắc rối nào cho chị Yuki-nee, bọn tao không để mày sống yên đâu.
Dialogue: 0,0:13:28.08,0:13:29.08,Default,Guy,0,0,0,,Có nghe rõ chưa hả?!
Dialogue: 0,0:13:33.30,0:13:36.34,Default,Guy,0,0,0,,Chết tiệt, đáng lẽ mình không được ló mặt ra ngoài.
Dialogue: 0,0:13:38.43,0:13:41.18,Default,Guy,0,0,0,,Chị Yuki-nee, nếu có chuyện gì xảy ra cứ gọi em một tiếng nhé.
Dialogue: 0,0:13:41.18,0:13:42.85,Default,Guy,0,0,0,,Em sẽ phóng tới ngay.
Dialogue: 0,0:13:43.52,0:13:45.73,Default,Yuk,0,0,0,,Anh không nên ra ngoài vào lúc này đâu.
Dialogue: 0,0:13:45.73,0:13:47.02,Default,Yuk,0,0,0,,Anh phải trốn kỹ vào đi.
Dialogue: 0,0:13:47.02,0:13:49.15,Default,Yuk,0,0,0,,Em xin lỗi mọi người, em xin phép đi trước nhé.
Dialogue: 0,0:13:53.07,0:13:55.32,Default,Nag,0,0,0,,Chuyện ban nãy là sao thế nhỉ?
Dialogue: 0,0:13:55.61,0:13:58.49,Default,Oka,0,0,0,,Có vẻ như em ấy cũng có nhiều chuyện phức tạp phải giải quyết.
Dialogue: 0,0:14:02.03,0:14:04.70,Default,Nag,0,0,0,,Tớ xin phép về trước nhé.
Dialogue: 0,0:14:04.70,0:14:07.87,Default,Nag,0,0,0,,Tớ phải về phụ Mẹ nấu bữa tối nữa.
Dialogue: 0,0:14:07.87,0:14:11.25,Default,Nag,0,0,0,,Cố lên nhé, Sunohara-san.
Dialogue: 0,0:14:14.92,0:14:17.63,Default,Sun,0,0,0,,Cậu ấy bảo 'cố lên' thì biết làm sao bây giờ…
Dialogue: 0,0:14:18.34,0:14:21.64,Default,Oka,0,0,0,,Đi nhờ vả người ta không công thế là không đúng rồi.
Dialogue: 0,0:14:21.64,0:14:23.68,Default,Oka,0,0,0,,Phải đưa ra thù lao hậu hĩnh chứ.
Dialogue: 0,0:14:24.51,0:14:25.97,Default,Sun,0,0,0,,Tao làm gì có đồng xu cắc bạc nào.
Dialogue: 0,0:14:25.97,0:14:30.90,Default,Oka,0,0,0,,Chuyện tiền nong không thành vấn đề, đằng nào mục tiêu của mày là thả thính cưa đổ em ấy mà, đúng không?
Dialogue: 0,0:14:32.19,0:14:33.15,Default,Sun,0,0,0,,Đúng thế thật.
Dialogue: 0,0:14:33.15,0:14:35.44,Default,Oka,0,0,0,,Trước tiên, mày phải khen ngợi nịnh nọt cô gái đó lên tận mây xanh.
Dialogue: 0,0:14:35.44,0:14:40.49,Default,Oka,0,0,0,,Tiếp theo, con gái thời nay rất thích giữ bí mật,\Nnên phải cho cô ấy biết mày là người kín miệng tuyệt đối.
Dialogue: 0,0:14:41.20,0:14:45.66,Default,Oka,0,0,0,,Cuối cùng, lợi dụng tâm lý đám đông, nhấn mạnh rằng ai ai cũng đang làm chuyện đó hết.
Dialogue: 0,0:14:46.66,0:14:47.79,Default,Sun,0,0,0,,Rõ rồi.
Dialogue: 0,0:14:47.79,0:14:48.83,Default,Sun,0,0,0,,Tao đi đây.
Dialogue: 0,0:14:48.83,0:14:51.46,Default,Sun,0,0,0,,Chào em gái xinh đẹp đằng kia ơi!
Dialogue: 0,0:14:51.46,0:14:52.21,Default,Girl,0,0,0,,Gì thế?
Dialogue: 0,0:14:53.08,0:14:54.00,Default,Sun,0,0,0,,Hiện giờ em có rảnh rỗi chút thời gian nào không?
Dialogue: 0,0:14:54.00,0:14:56.50,Default,Sun,0,0,0,,Em chỉ cần đứng nghe anh nói đôi câu thôi cũng được rồi.
Dialogue: 0,0:14:56.50,0:14:59.84,Default,Sun,0,0,0,,Thực ra anh có một công việc làm thêm bán thời gian cực xịn muốn giới thiệu cho em.
Dialogue: 0,0:14:59.84,0:15:02.18,Default,Girl,0,0,0,,Tôi đang vội.
Dialogue: 0,0:15:02.68,0:15:04.76,Default,Sun,0,0,0,,Anh sẽ không để lộ tên tuổi của em ra ngoài đâu.
Dialogue: 0,0:15:04.76,0:15:07.68,Default,Sun,0,0,0,,Và anh cũng sẽ giữ bí mật tuyệt đối với bố mẹ em luôn.
Dialogue: 0,0:15:07.68,0:15:11.10,Default,Sun,0,0,0,,Đừng lo. Mọi người ai cũng đang làm việc này hết rồi mà.
Dialogue: 0,0:15:12.35,0:15:15.19,Default,Sun,0,0,0,,Nói thế nghe có khác mẹ gì đang đi gạ gẫm dụ dỗ làm chuyện mờ ám phạm pháp không cơ chứ!
Dialogue: 0,0:15:15.77,0:15:16.73,Default,San,0,0,0,,À ừm…
Dialogue: 0,0:15:18.32,0:15:19.61,Default,Oka,0,0,0,,Cô Sanae!
Dialogue: 0,0:15:20.07,0:15:22.86,Default,San,0,0,0,,Cháu đang gặp rắc rối gì sao?
Dialogue: 0,0:15:24.07,0:15:25.07,Default,San,0,0,0,,Ôi chao.
Dialogue: 0,0:15:25.07,0:15:28.95,Default,San,0,0,0,,Nếu là chuyện đó, cháu có thể cho phép cô giúp một tay được không?
Dialogue: 0,0:15:30.79,0:15:33.00,Default,Oka,0,0,0,,Cô nói thật đấy ạ, cô Sanae?
Dialogue: 0,0:15:33.00,0:15:36.46,Default,San,0,0,0,,Đó là vì anh trai của Mei-chan cơ mà.
Dialogue: 0,0:15:36.46,0:15:38.96,Default,San,0,0,0,,Nếu cô có thể giúp ích được gì thì cô rất sẵn lòng.
Dialogue: 0,0:15:38.96,0:15:41.55,Default,Sun,0,0,0,,K-K-Khoan đã nào.
Dialogue: 0,0:15:42.26,0:15:45.72,Default,Sun,0,0,0,,Okazaki. Chị ấy là chị gái của Nagisa-chan đúng không mày?
Dialogue: 0,0:15:45.72,0:15:47.06,Default,Oka,0,0,0,,Chị gái á?
Dialogue: 0,0:15:47.06,0:15:50.02,Default,Oka,0,0,0,,À phải rồi, hôm qua tao có buột miệng nói thế nhỉ.
Dialogue: 0,0:15:50.02,0:15:53.10,Default,Sun,0,0,0,,Chết tiệt! Đúng chuẩn chị gái của Nagisa-chan có khác!
Dialogue: 0,0:15:53.10,0:15:55.52,Default,Sun,0,0,0,,Nhìn gần trông chị ấy xinh đẹp mlem muốn xỉu luôn trời ơi.
Dialogue: 0,0:15:56.23,0:15:58.65,Default,Oka,0,0,0,,Vụ này thú vị đây, cứ để thằng này hiểu lầm tiếp vậy.
Dialogue: 0,0:15:59.65,0:16:01.03,Default,San,0,0,0,,À ừm…
Dialogue: 0,0:16:01.03,0:16:03.32,Default,San,0,0,0,,Cô không phù hợp sao cháu?
Dialogue: 0,0:16:03.32,0:16:04.78,Default,Sun,0,0,0,,Làm gì có chuyện đó ạ, quá phù hợp luôn ấy chứ!
Dialogue: 0,0:16:04.78,0:16:09.37,Default,Oka,0,0,0,,Nhưng nhìn vào chẳng phải lộ liễu quá là bạn gái giả sao cô?
Dialogue: 0,0:16:09.37,0:16:12.46,Default,San,0,0,0,,Không sao đâu. Cô sẽ cải trang một chút mà.
Dialogue: 0,0:16:13.04,0:16:15.46,Default,Oka,0,0,0,,Cô nghiêm túc thật đấy ạ?
Dialogue: 0,0:16:15.46,0:16:18.13,Default,San,0,0,0,,Vâng. Rất mong được hợp tác cùng cháu nhé.
Dialogue: 0,0:16:18.13,0:16:19.55,Default,Sun,0,0,0,,Tuyệt cú mèo!
Dialogue: 0,0:16:19.55,0:16:23.09,Default,Sun,0,0,0,,Hú hú hú! Tuyệt vời ông mặt trời!
Dialogue: 0,0:16:23.51,0:16:25.34,Default,Mei,0,0,0,,Anh hai có bạn gái thật rồi á?!
Dialogue: 0,0:16:25.89,0:16:28.30,Default,Sun,0,0,0,,Một người mà anh đã thề nguyện trao trọn tương lai cả đời này.
Dialogue: 0,0:16:28.30,0:16:30.85,Default,Sun,0,0,0,,Cô ấy vô cùng xinh đẹp và chín chắn đàng hoàng.
Dialogue: 0,0:16:32.60,0:16:36.65,Default,Sun,0,0,0,,Anh đâu có sống buông thả không định hướng đâu em.
Dialogue: 0,0:16:36.65,0:16:40.27,Default,Sun,0,0,0,,Anh đang từng bước vững chắc bước lên những bậc thang của người trưởng thành đấy.
Dialogue: 0,0:16:40.27,0:16:41.78,Default,Mei,0,0,0,,Cho em gặp mặt chị ấy đi.
Dialogue: 0,0:16:43.07,0:16:44.95,Default,Mei,0,0,0,,Mau giới thiệu chị ấy cho em đi anh.
Dialogue: 0,0:16:45.28,0:16:49.53,Default,Mei,0,0,0,,Là em gái của anh, em muốn biết rõ người mà anh định lấy làm vợ là người như thế nào!
Dialogue: 0,0:16:49.53,0:16:53.33,Default,Sun,0,0,0,,Được thôi. Để anh hỏi xem lịch trình của cô ấy thế nào đã nhé.
Dialogue: 0,0:17:00.04,0:17:03.88,Default,San,0,0,0,,Câu lạc bộ Kịch nghệ có nhiều trang phục biểu diễn lắm đúng không cháu?
Dialogue: 0,0:17:03.88,0:17:06.09,Default,Oka,0,0,0,,Ngày mốt cô sẽ gặp mặt Mei-chan.
Dialogue: 0,0:17:06.09,0:17:09.01,Default,Oka,0,0,0,,Nên ngày mai chúng ta sẽ có một buổi diễn tập thử trước nhé.
Dialogue: 0,0:17:09.01,0:17:10.81,Default,San,0,0,0,,Được rồi. Cô rất mong chờ đấy.
Dialogue: 0,0:17:11.85,0:17:14.60,Default,Nag,0,0,0,,Tớ cứ thấy tâm trạng phức tạp khó tả sao ấy.
Dialogue: 0,0:17:14.60,0:17:18.35,Default,Nag,0,0,0,,Mẹ của mình lại đi làm bạn gái của bạn cùng lớp…
Dialogue: 0,0:17:19.44,0:17:20.82,Default,Oka,0,0,0,,Cô có thực sự chắc chắn về chuyện này không đấy ạ?
Dialogue: 0,0:17:20.82,0:17:23.99,Default,Oka,0,0,0,,Thằng Sunohara đang hưng phấn tột độ lên rồi đấy.
Dialogue: 0,0:17:23.99,0:17:27.32,Default,Oka,0,0,0,,Nó cứ đinh ninh cô là chị gái ruột của Nagisa.
Dialogue: 0,0:17:28.24,0:17:29.82,Default,San,0,0,0,,Chị gái sao?
Dialogue: 0,0:17:30.32,0:17:31.91,Default,San,0,0,0,,Cô cảm ơn cháu nhiều lắm nhé.
Dialogue: 0,0:17:31.91,0:17:33.83,Default,Oka,0,0,0,,Cháu đâu có ý nịnh nọt cô đâu mà…
Dialogue: 0,0:17:33.83,0:17:39.33,Default,Nag,0,0,0,,Mẹ không suy nghĩ lại chuyện này thật sao Mẹ?
Dialogue: 0,0:17:42.00,0:17:46.47,Default,San,0,0,0,,Hình ảnh của Sunohara-san cứ đọng mãi\Ntrong tâm trí mẹ kể từ sau trận bóng chày hôm nọ.
Dialogue: 0,0:17:47.09,0:17:52.47,Default,San,0,0,0,,Cậu ấy trông vụng về, hay mắc sai lầm ngớ ngẩn, nhưng mẹ nghĩ cậu ấy thực ra là một người rất tốt bụng.
Dialogue: 0,0:17:53.06,0:17:57.98,Default,San,0,0,0,,Chỉ cần có một cú hích đúng lúc, mẹ tin cậu ấy có thể bước đi trên một con đường tốt đẹp hơn.
Dialogue: 0,0:17:59.48,0:18:02.73,Default,San,0,0,0,,Mẹ rất muốn giúp cậu ấy đạt được điều đó.
Dialogue: 0,0:18:02.73,0:18:09.03,Default,Nag,0,0,0,,Vâng. Nếu Mẹ đã nghĩ như vậy thì con cũng sẽ giúp một tay ạ.
Dialogue: 0,0:18:09.03,0:18:11.91,Default,San,0,0,0,,Ừ. Mẹ cảm ơn con gái nhiều nhé.
Dialogue: 0,0:18:11.91,0:18:13.62,Default,Oka,0,0,0,,Cháu xin dặn trước một điều này.
Dialogue: 0,0:18:13.62,0:18:15.91,Default,Oka,0,0,0,,Chúng ta tuyệt đối phải giấu nhẹm chuyện này không để cho ông già biết.
Dialogue: 0,0:18:15.91,0:18:17.00,Default,Oka,0,0,0,,Được chứ ạ?
Dialogue: 0,0:18:17.00,0:18:18.62,Default,Nag,0,0,0,,Tại sao thế cậu?
Dialogue: 0,0:18:19.92,0:18:22.42,Default,Oka,0,0,0,,Cô Sanae làm thế này là vì lòng tốt muốn giúp đỡ người khác,
Dialogue: 0,0:18:22.42,0:18:27.76,Default,Oka,0,0,0,,nhưng với cái tính ghen tuông lồng lộn của ông già,\Nkiểu gì bác ấy cũng nổi cơn tam bành băm vằm thằng Sunohara ra làm thịt băm cho coi.
Dialogue: 0,0:18:29.38,0:18:33.18,Default,Oka,0,0,0,,Vì sự an nguy tính mạng của thằng Sunohara, bằng mọi giá chúng ta phải giữ kín như bưng.
Dialogue: 0,0:18:38.98,0:18:42.56,Default,Nag,0,0,0,,Trông Sunohara-san có vẻ hồi hộp căng thẳng ghê.
Dialogue: 0,0:18:42.56,0:18:44.86,Default,Oka,0,0,0,,Nhìn cái điệu bộ của nó làm tao phát cáu lên được.
Dialogue: 0,0:18:45.23,0:18:46.94,Default,Nag,0,0,0,,Tại sao thế cậu?
Dialogue: 0,0:18:48.82,0:18:52.95,Default,Nag,0,0,0,,Đừng nói là cậu cũng đang phải lòng Mẹ tớ đấy nhé.
Dialogue: 0,0:18:52.95,0:18:55.70,Default,Oka,0,0,0,,Con hâm này! Cậu nói nhảm cái gì thế hả?!
Dialogue: 0,0:18:56.99,0:18:57.83,Default,San,0,0,0,,À ừm…
Dialogue: 0,0:18:57.83,0:18:58.91,Default,Sun,0,0,0,,D-Dạ vâng!
Dialogue: 0,0:18:59.21,0:19:05.42,Default,San,0,0,0,,Đang hẹn hò mà gọi là 'Sunohara-kun' thì nghe kỳ quặc lắm, nên cô sẽ gọi cháu là 'Youhei-kun' nhé.
Dialogue: 0,0:19:05.42,0:19:07.80,Default,Sun,0,0,0,,V-V-Vâng ạ?
Dialogue: 0,0:19:08.92,0:19:10.17,Default,San,0,0,0,,Youhei-kun.
Dialogue: 0,0:19:11.05,0:19:12.93,Default,San,0,0,0,,Rất mong được cháu chăm sóc chỉ bảo nhé.
Dialogue: 0,0:19:15.72,0:19:18.43,Default,Sun,0,0,0,,Chết tiệt! Chị ấy vừa gọi tên mình là 'Youhei-kun' kìa!
Dialogue: 0,0:19:20.23,0:19:22.81,Default,San,0,0,0,,Chúng mình bắt đầu bằng việc đi dạo sóng đôi bên nhau nhé?
Dialogue: 0,0:19:22.81,0:19:23.86,Default,Sun,0,0,0,,V-V-Vâng ạ!
Dialogue: 0,0:19:29.94,0:19:32.24,Default,San,0,0,0,,Cháu có thể xích lại gần hơn nữa mà.
Dialogue: 0,0:19:32.66,0:19:34.45,Default,San,0,0,0,,Bởi vì chúng mình đang hẹn hò với nhau mà.
Dialogue: 0,0:19:37.95,0:19:40.58,Default,Sun,0,0,0,,Chết tiệt! Mùi hương ngọt ngào ngào ngạt phả vào mũi rồi!
Dialogue: 0,0:19:41.29,0:19:44.50,Default,San,0,0,0,,Hay là chúng mình nắm tay nhau luôn nhé?
Dialogue: 0,0:19:46.54,0:19:48.80,Default,Sun,0,0,0,,Chết tiệt! Bàn tay chị ấy mềm mại mịn màng quá đi mất!
Dialogue: 0,0:19:48.80,0:19:50.55,Default,Oka,0,0,0,,Mày đừng có mỗi tí lại chạy sang đây báo cáo với tao có được không hả?!
Dialogue: 0,0:19:53.89,0:19:57.14,Default,Oka,0,0,0,,Làm thế này liệu có thực sự giúp nó đi đúng đường ray không đấy trời?
Dialogue: 0,0:19:57.14,0:20:00.06,Default,Nag,0,0,0,,Rốt cuộc thì tớ vẫn thấy tâm trạng khó tả kỳ quặc lắm…
Dialogue: 0,0:20:06.27,0:20:07.82,Default,Oka,0,0,0,,Và rồi ngày hẹn hò chính thức cũng đã đến.
Dialogue: 0,0:20:09.11,0:20:11.36,Default,Nag,0,0,0,,Sunohara-san đã tới đứng đợi từ sớm rồi kìa.
Dialogue: 0,0:20:11.36,0:20:13.91,Default,Oka,0,0,0,,Mei-chan, em ra vỗ vai gọi nó từ đằng sau đi.
Dialogue: 0,0:20:14.36,0:20:16.87,Default,Oka,0,0,0,,Anh cá là nó sẽ tưởng là bạn gái nó đến rồi giật bắn mình cho coi.
Dialogue: 0,0:20:19.04,0:20:21.50,Default,Mei,0,0,0,,Thế thì để em thử một chút xem sao nhé.
Dialogue: 0,0:20:24.96,0:20:26.29,Default,Mei,0,0,0,,Anh đợi có lâu không ạ?
Dialogue: 0,0:20:27.25,0:20:30.05,Default,Sun,0,0,0,,Không, anh cũng mới vừa tới thôi mà.
Dialogue: 0,0:20:30.05,0:20:30.55,Default,Sun,0,0,0,,MEI ĐẤY À?!
Dialogue: 0,0:20:31.67,0:20:34.38,Default,Nag,0,0,0,,Sunohara-san, đống vỏ lon vứt la liệt này là sao thế cậu?
Dialogue: 0,0:20:35.55,0:20:36.80,Default,Sun,0,0,0,,Đây là một phần trong chiến thuật tác chiến của anh.
Dialogue: 0,0:20:37.14,0:20:39.35,Default,Sun,0,0,0,,Lát nữa cô ấy đến đây nhìn thấy cảnh này đúng không?
Dialogue: 0,0:20:39.76,0:20:40.64,Default,Sun,0,0,0,,Rồi sau đó…
Dialogue: 0,0:20:41.22,0:20:42.68,Default,San,0,0,0,,Sunohara-san…
Dialogue: 0,0:20:43.39,0:20:46.65,Default,San,0,0,0,,Anh đã đứng đây uống nước chờ em lâu đến mức này sao?
Dialogue: 0,0:20:49.65,0:20:51.03,Default,Sun,0,0,0,,Mấy đứa đã thấy sự tinh tế sâu sắc chưa?
Dialogue: 0,0:20:51.03,0:20:53.65,Default,Oka,0,0,0,,Mày đúng là đê tiện không có điểm dừng.
Dialogue: 0,0:20:53.65,0:20:57.03,Default,Sun,0,0,0,,Đây là trò chơi nhân danh tình yêu của cánh đàn ông đích thực đấy.
Dialogue: 0,0:20:57.57,0:21:01.08,Default,Sun,0,0,0,,Nói cách khác, đó chính là một trò chơi boy-love.
Dialogue: 0,0:21:01.08,0:21:02.58,Default,Oka,0,0,0,,Mày có biết cụm từ đó ám chỉ một thứ hoàn toàn khác không hả?
Dialogue: 0,0:21:03.25,0:21:06.12,Default,Sun,0,0,0,,Chết tiệt. Uống nhiều nước quá giờ buồn đi vệ sinh rồi.
Dialogue: 0,0:21:12.51,0:21:15.84,Default,Mei,0,0,0,,Bừa bãi ngổn ngang thế này sẽ làm phiền người khác lắm đúng không anh?
Dialogue: 0,0:21:15.84,0:21:17.22,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:21:17.22,0:21:18.55,Default,Oka,0,0,0,,Chúng mình cùng dọn dẹp đi thôi.
Dialogue: 0,0:21:18.55,0:21:19.30,Default,Mei,0,0,0,,Vâng ạ.
Dialogue: 0,0:21:23.47,0:21:25.60,Default,San,0,0,0,,Để cô phụ một tay với nhé.
Dialogue: 0,0:21:26.02,0:21:27.31,Default,Mei,0,0,0,,Em cảm ơn chị.
Dialogue: 0,0:21:27.31,0:21:27.81,Default,San,0,0,0,,Không có chi đâu em.
Dialogue: 0,0:21:36.78,0:21:38.28,Default,Oka,0,0,0,,Cảnh tượng này trông cứ…
Dialogue: 0,0:21:38.61,0:21:41.58,Default,Nag,0,0,0,,Tomoya-kun, mặt cậu đang đỏ ửng lên đấy à?
Dialogue: 0,0:21:44.41,0:21:45.96,Default,Sun,0,0,0,,Đã cả người.
Dialogue: 0,0:21:46.79,0:21:47.71,Default,San,0,0,0,,Youhei-kun.
Dialogue: 0,0:21:50.38,0:21:52.67,Default,Sun,0,0,0,,Anh xin lỗi nhé! Anh có để em phải chờ lâu không?!
Dialogue: 0,0:21:52.67,0:21:55.97,Default,Sun,0,0,0,,Anh xin lỗi! Anh xin lỗi! Ngàn lần xin lỗi em!
Dialogue: 0,0:21:53.09,0:21:55.97,Default-alt,San,0,0,0,,Không sao đâu mà. Em cũng vừa mới tới thôi.
Dialogue: 0,0:22:02.76,0:22:05.18,Default,Mei,0,0,0,,Người này… chính là bạn gái của anh hai sao?!
