Dialogue: 0,0:00:03.03,0:00:06.12,Default,San,0,0,0,,Mình là Isogai Sanako, 17 tuổi.
Dialogue: 0,0:00:06.12,0:00:08.99,Default,San,0,0,0,,Anh trai em lúc nào cũng chăm sóc chu đáo cho mình hết.
Dialogue: 0,0:00:10.95,0:00:13.83,Default,Mei,0,0,0,,Hình như em từng gặp chị ở đâu đó rồi thì phải?
Dialogue: 0,0:00:13.83,0:00:18.21,Default,San,0,0,0,,Thị trấn này nhỏ bé mà, có khi chúng mình từng vô tình lướt qua nhau trên đường cũng nên.
Dialogue: 0,0:00:18.92,0:00:20.34,Default,Mei,0,0,0,,Chị xinh đẹp thật đấy.
Dialogue: 0,0:00:20.34,0:00:22.51,Default,San,0,0,0,,Mình cảm ơn em nhiều nhé.
Dialogue: 0,0:00:23.34,0:00:27.09,Default,Mei,0,0,0,,Chị xinh đẹp đến nhường này, thế mà…
Dialogue: 0,0:00:27.59,0:00:29.43,Default,Mei,0,0,0,,Thế mà anh hai lại…
Dialogue: 0,0:00:29.43,0:00:30.81,Default,Mei,0,0,0,,Em thấy tội nghiệp cho chị quá!
Dialogue: 0,0:00:30.81,0:00:32.18,Default,Sun,0,0,0,,Mày nói thế là có ý gì hả con nhóc kia?!
Dialogue: 0,0:00:32.18,0:00:36.31,Default,Oka,0,0,0,,May quá. Mei-chan không nhận ra đó là cô Sanae.
Dialogue: 0,0:00:32.18,0:00:35.06,Default-alt,Sun,0,0,0,,Buông ra! Mau buông cô ấy ra!
Dialogue: 0,0:00:35.06,0:00:37.90,Default-alt,Sun,0,0,0,,Anh xin em đấy, anh lạy em, mau buông tay cô ấy ra đi.
Dialogue: 0,0:00:36.31,0:00:37.90,Default,Nag,0,0,0,,Tớ cũng bất ngờ ghê.
Dialogue: 0,0:00:38.23,0:00:42.03,Default,Nag,0,0,0,,Mới nhìn qua tớ còn chẳng nhận ra đó là Mẹ tớ nữa cơ.
Dialogue: 0,0:00:38.23,0:00:40.07,Default-alt,Sun,0,0,0,,Này, tự dưng có con ma lù lù đứng ngay đây này.
Dialogue: 0,0:00:40.07,0:00:42.03,Default-alt,Sun,0,0,0,,Về tao mách mẹ cho coi!
Dialogue: 0,0:00:59.08,0:01:04.67,OP English,,0,0,0,,{\be1\fad(250,0)}Nơi lưng chừng con dốc năm nào chỉ riêng em cất bước...
