Dialogue: 0,0:02:13.33,0:02:14.83,Signs,,0,0,0,,{\blur1\fnThrow My Hands Up in the Air\b1\c&HA7AC98&\fs108\pos(958.5,394.5)}Okazaki Tomoya
Dialogue: 0,0:02:13.33,0:02:14.83,Signs,,0,0,0,,{\blur1\fnThrow My Hands Up in the Air\b1\c&HA7AC98&\fs108\pos(1065,487.5)}Nagisa
Dialogue: 0,0:02:17.20,0:02:17.91,Default,Nag,0,0,0,,Dạ ừm...
Dialogue: 0,0:02:17.91,0:02:18.96,Default,Oka,0,0,0,,C-Có chuyện gì thế em?
Dialogue: 0,0:02:19.67,0:02:22.08,Default,Nag,0,0,0,,Những lúc thế này thì em nên nói gì mới phải phép ạ?
Dialogue: 0,0:02:23.63,0:02:25.84,Default,Oka,0,0,0,,Nói cái gì về chuyện gì cơ?
Dialogue: 0,0:02:25.84,0:02:29.80,Default,Nag,0,0,0,,Hôm nay là khởi đầu cho cuộc sống mới của hai đứa mình mà.
Dialogue: 0,0:02:29.80,0:02:31.89,Default,Nag,0,0,0,,Em có nên nói câu: 'Chuẩn bị, sẵn sàng, bắt đầu!' không ạ?
Dialogue: 0,0:02:31.89,0:02:35.06,Default,Oka,0,0,0,,Nói thế nghe kỳ lắm, vì có vạch đích nào đâu.
Dialogue: 0,0:02:36.27,0:02:38.35,Default,Nag,0,0,0,,Anh nói cũng phải ha.
Dialogue: 0,0:02:41.56,0:02:44.94,Default,Oka,0,0,0,,Vì hai đứa mình sẽ sống nương tựa và chở che cho nhau,
Dialogue: 0,0:02:44.94,0:02:46.98,Default,Oka,0,0,0,,nên chắc câu thích hợp nhất là: 'Từ nay xin anh/em hãy chỉ bảo và giúp đỡ nhiều hơn' đấy.
Dialogue: 0,0:02:49.70,0:02:52.87,Default,Nag,0,0,0,,Em muốn lập một lời thề giữa hai đứa mình.
Dialogue: 0,0:02:53.49,0:02:54.24,Default,Oka,0,0,0,,Một lời thề sao?
Dialogue: 0,0:02:54.24,0:02:55.49,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:02:55.95,0:02:59.08,Default,Nag,0,0,0,,Em, Okazaki Nagisa, từ nay sẽ không bao giờ khóc nhè nữa.
Dialogue: 0,0:02:59.08,0:03:02.50,Default,Nag,0,0,0,,Dù có gặp khó khăn trắc trở thế nào, em cũng sẽ kiên cường vượt qua.
Dialogue: 0,0:03:03.88,0:03:08.09,Default,Nag,0,0,0,,Nhưng những lúc quá đỗi hạnh phúc thì em có thể khóc được không ạ?
Dialogue: 0,0:03:09.59,0:03:11.34,Default,Nag,0,0,0,,Đó chính là con người em...
Dialogue: 0,0:03:13.68,0:03:15.80,Default,Nag,0,0,0,,...nhưng từ nay, em mong anh sẽ hết lòng chăm sóc và bảo ban em nhé.
Dialogue: 0,0:03:16.72,0:03:19.68,Default,Oka,0,0,0,,Anh cũng vậy. Từ nay mong em hãy giúp đỡ anh nhiều hơn nhé.
Dialogue: 0,0:03:26.15,0:03:29.82,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 14
Dialogue: 0,0:03:26.15,0:03:29.82,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Gia Đình Mới
Dialogue: 0,0:03:38.62,0:03:39.70,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:03:39.70,0:03:40.95,Default,Oka,0,0,0,,C-Có chuyện gì thế em?!
Dialogue: 0,0:03:40.95,0:03:45.63,Default,Nag,0,0,0,,Để em vào tắm trước thế này có thực sự ổn không ạ?
Dialogue: 0,0:03:45.63,0:03:50.01,Default,Oka,0,0,0,,Đ-Được mà. Mai anh tắm trước cho.
Dialogue: 0,0:03:50.01,0:03:54.09,Default,Nag,0,0,0,,Vâng ạ. Thế em xin phép ngâm mình trước nhé.
Dialogue: 0,0:04:01.85,0:04:07.61,Default,Oka,0,0,0,,Bình tĩnh nào. Hồi trước ở nhà bên kia mình cũng nghe tiếng Nagisa tắm suốt rồi mà.
Dialogue: 0,0:04:08.02,0:04:09.19,Default,Oka,0,0,0,,Có chuyện gì thế em?!
Dialogue: 0,0:04:09.82,0:04:13.28,Default,Nag,0,0,0,,Em xin lỗi. Tự nhiên nước lạnh ngắt chảy ra...
Dialogue: 0,0:04:15.57,0:04:18.83,Default,Oka,0,0,0,,À, chỗ này phải đợi một lát thì nước nóng mới chảy ra được.
Dialogue: 0,0:04:19.20,0:04:21.04,Default,Oka,0,0,0,,Mở từ từ thôi nhé.
Dialogue: 0,0:04:21.04,0:04:22.70,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:04:25.42,0:04:28.84,Default,Nag,0,0,0,,Dạ ừm, em sẽ cố gắng tắm thật nhanh ạ.
Dialogue: 0,0:04:28.84,0:04:31.42,Default,Oka,0,0,0,,K-Không sao đâu, em cứ thong thả mà tắm.
Dialogue: 0,0:04:31.42,0:04:37.84,Default,Nag,0,0,0,,Không được đâu ạ. Mai anh còn phải đi làm sớm, nên phải đi ngủ sớm chứ.
Dialogue: 0,0:04:37.84,0:04:38.60,Default,Oka,0,0,0,,Hở?
Dialogue: 0,0:04:40.14,0:04:41.64,Default,Oka,0,0,0,,À, ừ nhỉ...
Dialogue: 0,0:04:42.68,0:04:44.35,Default,Oka,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:04:46.56,0:04:49.82,Default,Nag,0,0,0,,Ngày mai em cũng sẽ bắt đầu đi tìm việc làm nữa.
Dialogue: 0,0:04:49.82,0:04:50.57,Default,Oka,0,0,0,,Hả?
Dialogue: 0,0:04:52.40,0:04:57.53,Default,Nag,0,0,0,,Tìm việc làm ạ. Em đâu thể cứ ngồi không như thế này được.
Dialogue: 0,0:05:04.66,0:05:06.83,Default,Oka,0,0,0,,Nagisa, em còn thức không?
Dialogue: 0,0:05:07.29,0:05:08.92,Default,Nag,0,0,0,,Vâng, em vẫn còn thức ạ.
Dialogue: 0,0:05:09.50,0:05:11.80,Default,Oka,0,0,0,,Em nghiêm túc về chuyện đi làm thật đấy à?
Dialogue: 0,0:05:13.05,0:05:17.05,Default,Nag,0,0,0,,Vâng. Tất nhiên việc nhà em vẫn sẽ quán xuyến chu toàn mà.
Dialogue: 0,0:05:17.63,0:05:20.05,Default,Nag,0,0,0,,Dù sao thì đây cũng là tổ ấm của em mà.
Dialogue: 0,0:05:22.01,0:05:27.14,Default,Oka,0,0,0,,Việc nhà thì anh cũng sẽ đỡ đần cùng em. Nhưng mà, sức khỏe em có chịu đựng nổi không?
Dialogue: 0,0:05:29.27,0:05:35.32,Default,Nag,0,0,0,,Thể xác em tuy ốm yếu, nhưng em không muốn bản thân trở thành một người yếu đuối.
Dialogue: 0,0:05:37.36,0:05:41.41,Default,Nag,0,0,0,,Em xin lỗi nhé, em lại ích kỷ bướng bỉnh nữa rồi.
Dialogue: 0,0:05:42.87,0:05:44.58,Default,Oka,0,0,0,,Không, em đâu có ích kỷ.
Dialogue: 0,0:05:44.58,0:05:47.33,Default,Oka,0,0,0,,Xưa nay em có bao giờ đòi hỏi điều gì to tát cho bản thân đâu, đúng không?
Dialogue: 0,0:05:48.12,0:05:52.09,Default,Nag,0,0,0,,Lúc nào em cũng đòi hỏi rất nhiều điều từ anh mà.
Dialogue: 0,0:05:54.30,0:05:59.59,Default,Oka,0,0,0,,Những thứ em đòi hỏi toàn là rủ bố già chơi bóng chày với lại nắm tay thôi mà.
Dialogue: 0,0:06:05.52,0:06:07.98,Default,Nag,0,0,0,,Em muốn nắm tay.
Dialogue: 0,0:06:21.74,0:06:25.66,Default,Nag,0,0,0,,Chúng mình đã kết hôn rồi cơ mà nhỉ?
Dialogue: 0,0:06:26.70,0:06:32.38,Default,Oka,0,0,0,,Sau này chắc chắn sẽ còn nhiều chuyện xảy ra với hai đứa mình lắm;\Ncó những điều tuyệt vời và cả những chuyện gian nan cay đắng nữa.
Dialogue: 0,0:06:32.88,0:06:36.00,Default,Nag,0,0,0,,Nhưng chỉ cần được ở bên anh, em sẽ có thể vững vàng đối mặt với tất cả.
Dialogue: 0,0:06:36.59,0:06:41.93,Default,Oka,0,0,0,,Anh cũng vậy. Chỉ cần có em ở bên cạnh,\Nanh nghĩ mình có thể vượt qua bất kỳ thử thách nào.
Dialogue: 0,0:06:42.59,0:06:45.76,Default,Oka,0,0,0,,Nên em nhất định phải luôn ở bên cạnh anh đấy nhé.
Dialogue: 0,0:06:47.43,0:06:48.02,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:06:48.02,0:06:53.40,Signs,,0,0,0,,{\blur1\fad(0,500)\fnThrow My Hands Up in the Air\b1\fs108\pos(958.5,394.5)\c&H61605D&}Okazaki Tomoya
Dialogue: 0,0:06:48.02,0:06:53.40,Signs,,0,0,0,,{\blur1\fad(0,500)\fnThrow My Hands Up in the Air\b1\fs108\pos(1065,487.5)\c&H61605D&}Nagisa
Dialogue: 0,0:06:48.73,0:06:52.02,Default,Nag,0,0,0,,Em sẽ mãi mãi ở bên cạnh anh.
Dialogue: 0,0:06:56.07,0:06:59.53,Default,Oka,0,0,0,,Cuộc sống mới của Nagisa và tôi đã bắt đầu như thế đấy.
Dialogue: 0,0:07:00.40,0:07:03.62,Default,Oka,0,0,0,,Kể từ ngày hôm đó, tôi cần phải gánh vác sinh kế cho cả hai con người.
Dialogue: 0,0:07:03.99,0:07:09.16,Default,Oka,0,0,0,,Thế nhưng thay vì là gánh nặng, với tôi, đó là niềm hạnh phúc khôn xiết.
Dialogue: 0,0:07:12.75,0:07:16.21,Default,Oka,0,0,0,,Mỗi khi tan ca, tôi đều sải bước thật nhanh về nhà.
Dialogue: 0,0:07:16.92,0:07:18.51,Default,Oka,0,0,0,,Về tổ ấm nơi có Nagisa đang chờ đợi.
Dialogue: 0,0:07:19.01,0:07:20.38,Default,Oka,0,0,0,,Về ngôi nhà thân thương của hai chúng tôi.
Dialogue: 0,0:07:43.82,0:07:46.45,Default,Nag,0,0,0,,Hôm nay em có gọi điện cho Nishina-san đấy ạ.
Dialogue: 0,0:07:46.45,0:07:50.25,Default,Nag,0,0,0,,Hôm lễ tốt nghiệp cậu ấy có cho em số điện thoại.
Dialogue: 0,0:07:50.25,0:07:52.79,Default,Oka,0,0,0,,Cậu ấy không thi đỗ đại học đúng không?
Dialogue: 0,0:07:52.79,0:07:56.92,Default,Nag,0,0,0,,Dạ vâng. Hiện tại cậu ấy đang ôn luyện để thi vào trường nhạc.
Dialogue: 0,0:07:56.92,0:08:02.51,Default,Nag,0,0,0,,Cậu ấy bảo đang đi làm thêm vì không muốn làm gánh nặng cho bố mẹ.
Dialogue: 0,0:08:02.51,0:08:04.55,Default,Oka,0,0,0,,Ồ, tốt cho cậu ấy quá.
Dialogue: 0,0:08:04.55,0:08:09.18,Default,Nag,0,0,0,,Em nghe nói cậu ấy sắp làm việc tại\Nmột nhà hàng gia đình sẽ khai trương vào tháng tới.
Dialogue: 0,0:08:09.64,0:08:12.93,Default,Nag,0,0,0,,Cậu ấy hỏi em có muốn đến làm cùng không.
Dialogue: 0,0:08:12.93,0:08:13.81,Default,Oka,0,0,0,,Làm cùng cậu ấy sao?
Dialogue: 0,0:08:13.81,0:08:15.90,Default,Nag,0,0,0,,Vâng ạ. Làm bồi bàn phục vụ bàn.
Dialogue: 0,0:08:16.27,0:08:20.23,Default,Nag,0,0,0,,Em cũng đang muốn tìm việc làm,\Nnên em nghĩ đây là cơ hội hoàn hảo lắm ạ.
Dialogue: 0,0:08:20.23,0:08:23.90,Default,Oka,0,0,0,,Ừm, dù sao thì có người quen vẫn an tâm hơn là làm ở nơi toàn người lạ.
Dialogue: 0,0:08:23.90,0:08:27.66,Default,Oka,0,0,0,,Nhưng em nhớ báo cho bố già với Sanae-san biết một tiếng nhé?
Dialogue: 0,0:08:28.20,0:08:28.87,Default,Nag,0,0,0,,Vâng, em sẽ báo ạ.
Dialogue: 0,0:08:37.00,0:08:39.50,Default,Nag,0,0,0,,Anh đang mải nghĩ gì thế, Tomoya-kun?
Dialogue: 0,0:08:40.80,0:08:43.05,Default,Oka,0,0,0,,Về điều mà dạo trước Miyazawa từng kể.
Dialogue: 0,0:08:43.80,0:08:46.26,Default,Oka,0,0,0,,Truyền thuyết từ thuở xa xưa của thành phố này.
Dialogue: 0,0:08:46.80,0:08:50.47,Default,Oka,0,0,0,,Khi có những con người được chúc phúc, một đốm sáng kỳ diệu sẽ xuất hiện bên cạnh họ.
Dialogue: 0,0:08:51.77,0:08:57.23,Default,Oka,0,0,0,,Anh vừa nghĩ, biết đâu lúc này xung quanh hai đứa mình cũng đang có một đốm sáng như thế.
Dialogue: 0,0:09:00.36,0:09:03.65,Default,Oka,0,0,0,,Nếu chạm tay vào đốm sáng ấy,\Nchúng ta có thể được ban cho một điều ước, đúng không?
Dialogue: 0,0:09:04.32,0:09:06.11,Default,Oka,0,0,0,,Em sẽ ước điều gì nào?
Dialogue: 0,0:09:06.57,0:09:08.37,Default,Nag,0,0,0,,Em chẳng cần thêm điều gì nữa đâu ạ.
Dialogue: 0,0:09:09.41,0:09:10.70,Default,Oka,0,0,0,,Phải có điều gì đó chứ.
Dialogue: 0,0:09:10.70,0:09:12.74,Default,Nag,0,0,0,,Thật lòng đấy, em chẳng cần gì nữa cả.
Dialogue: 0,0:09:14.91,0:09:16.62,Default,Nag,0,0,0,,Thật ra... cũng có một điều ạ.
Dialogue: 0,0:09:16.62,0:09:20.00,Default,Oka,0,0,0,,Thật sao? Là điều gì thế? Em cứ nói ra đi, anh sẽ thực hiện cho em.
Dialogue: 0,0:09:21.46,0:09:22.46,Default,Nag,0,0,0,,Một em bé.
Dialogue: 0,0:09:25.47,0:09:26.59,Default,Nag,0,0,0,,Có được không anh?
Dialogue: 0,0:09:37.94,0:09:38.85,Default,Oka,0,0,0,,Cháu chào hai cô chú ạ.
Dialogue: 0,0:09:39.27,0:09:40.73,Default,Aki,0,0,0,,Kính ch— Ơ kìa.
Dialogue: 0,0:09:41.19,0:09:42.94,Default,Aki,0,0,0,,Lại là thằng ranh con mày à.
Dialogue: 0,0:09:42.94,0:09:45.94,Default,Oka,0,0,0,,Cháu tan ca sớm nên rảnh rỗi một chút.
Dialogue: 0,0:09:46.74,0:09:49.32,Default,Oka,0,0,0,,Nên ghé qua ngó mặt chút xíu ạ.
Dialogue: 0,0:09:51.20,0:09:52.91,Default,Aki,0,0,0,,Thật thế à? Đúng lúc lắm con trai.
Dialogue: 0,0:09:52.91,0:09:57.46,Default,Aki,0,0,0,,Mấy ngày nay tao đang mòn mỏi chờ đợi cơ hội này đấy.
Dialogue: 0,0:09:58.71,0:09:59.92,Default,Oka,0,0,0,,Chú đang lảm nhảm chuyện gì thế?
Dialogue: 0,0:10:00.38,0:10:02.46,Default,Aki,0,0,0,,Chúng ta sẽ đi xem Nagisa làm việc!
Dialogue: 0,0:10:05.26,0:10:07.01,Default,Oka,0,0,0,,Sao lại kéo cả cháu đi nữa?!
Dialogue: 0,0:10:07.34,0:10:12.85,Default,Aki,0,0,0,,Có thằng đàn ông nào tự nhiên vác xác một mình vào nhà hàng gia đình rồi gọi món kem parfait sô-cô-la không hả?!
Dialogue: 0,0:10:12.85,0:10:15.47,Default,Oka,0,0,0,,Chuyện đó thì liên quan gì đến cháu chứ? Mà tại sao lại phải gọi kem parfait sô-cô-la?!
Dialogue: 0,0:10:15.72,0:10:19.23,Default,Aki,0,0,0,,Mày vẫn chưa đến xem chỗ con bé làm việc bao giờ đúng không?
Dialogue: 0,0:10:19.23,0:10:22.19,Default,Aki,0,0,0,,Mày không muốn nhìn thấy con bé mặc bộ đồng phục bồi bàn dễ thương sao hả?
Dialogue: 0,0:10:25.40,0:10:26.07,Default,Oka,0,0,0,,Cháu có chứ!
Dialogue: 0,0:10:26.86,0:10:27.61,Default,Aki,0,0,0,,Thấy chưa?!
Dialogue: 0,0:10:28.36,0:10:33.83,Default,Aki,0,0,0,,Nhưng nếu tao mà bị bắt gặp đang chụp ảnh con gái mình, cả khu phố này nó cười thúi mũi tao ra mất.
Dialogue: 0,0:10:34.24,0:10:38.08,Default,Aki,0,0,0,,Nên tao sẽ đi với tư cách là 'Bạn số 1' của mày.
Dialogue: 0,0:10:38.08,0:10:40.12,Default,Oka,0,0,0,,Người ta nhận ra chú ngay trong một nốt nhạc cho xem.
Dialogue: 0,0:10:40.12,0:10:43.50,Default,Aki,0,0,0,,Ai không biết tao thì sẽ chỉ thấy tao là một gã rapper lập dị thôi.
Dialogue: 0,0:10:43.50,0:10:46.80,Default,Aki,0,0,0,,YO! YO! Tao là MC Akio đây!
Dialogue: 0,0:10:46.80,0:10:49.63,Default,Aki,0,0,0,,Tay cầm micro, tao là thợ làm bánh bách chiến bách thắng!
Dialogue: 0,0:10:50.18,0:10:51.05,Default,Aki,0,0,0,,Yeah!
Dialogue: 0,0:10:51.05,0:10:53.43,Default,Oka,0,0,0,,Chú đang tự lạy ông tôi ở bụi này đấy.
Dialogue: 0,0:10:53.43,0:10:55.76,Default,Aki,0,0,0,,Thật thế á? Mày nói thật đấy à? Toang rồi, Yo.
Dialogue: 0,0:10:58.10,0:11:00.14,Default,Oka,0,0,0,,Thôi kệ đi. Mau đi thôi.
Dialogue: 0,0:11:03.15,0:11:05.11,Default,Aki,0,0,0,,Huynh đài, đợi tao với, Yo!
Dialogue: 0,0:11:17.20,0:11:22.25,Default,Aki,0,0,0,,Chỗ này ngày xưa là một lùm cây rậm rạp, bạt ngàn cây xanh.
Dialogue: 0,0:11:23.21,0:11:26.42,Default,Aki,0,0,0,,Trời ạ, mọi thứ đổi thay nhanh thật đấy.
Dialogue: 0,0:11:27.17,0:11:29.21,Default,Aki,0,0,0,,Này, sao thế?
Dialogue: 0,0:11:30.92,0:11:32.22,Default,Oka,0,0,0,,Dạ không có gì...
Dialogue: 0,0:11:34.68,0:11:35.55,Default,Oka,0,0,0,,Chúng ta vào trong thôi chú.
Dialogue: 0,0:11:43.81,0:11:46.69,Default,Sug,0,0,0,,Kính ch— Ủa anh.
Dialogue: 0,0:11:47.19,0:11:48.44,Default,Oka,0,0,0,,Chào hai bạn, lâu rồi không gặp nhé.
Dialogue: 0,0:11:48.44,0:11:51.57,Default,Rie,0,0,0,,Anh Okazaki, lâu lắm rồi mới gặp lại anh.
Dialogue: 0,0:11:52.86,0:11:54.36,Default,Rie,0,0,0,,Ai thế này ạ?
Dialogue: 0,0:11:54.99,0:11:57.37,Default,Aki,0,0,0,,Một rapper ẩn danh đây, yo!
Dialogue: 0,0:11:57.37,0:11:58.12,Default,Rie,0,0,0,,Dạ vâng...
Dialogue: 0,0:11:59.66,0:12:01.91,Default,Sug,0,0,0,,Rie-chan kìa, quản lý đang nhìn sang phía này đấy.
Dialogue: 0,0:12:06.38,0:12:08.84,Default,Rie,0,0,0,,Quý khách hai người. Xin mời đi lối này ạ.
Dialogue: 0,0:12:12.22,0:12:14.84,Default,Aki,0,0,0,,Thấy quán xá đông vui nhộn nhịp thế này cũng mừng ghê.
Dialogue: 0,0:12:14.84,0:12:17.60,Default,Aki,0,0,0,,Khu vực này chắc sắp tới cũng sẽ thay da đổi thịt nhiều lắm đây.
Dialogue: 0,0:12:18.89,0:12:21.98,Default,Aki,0,0,0,,Cái bản mặt đưa đám đó của mày là sao thế hả?
Dialogue: 0,0:12:21.98,0:12:23.18,Default,Oka,0,0,0,,À, không có gì đâu chú.
Dialogue: 0,0:12:24.14,0:12:25.15,Default,Oka,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:12:25.90,0:12:28.15,Default,Nag,0,0,0,,Kính chào quý khách... Tomoya-kun!
Dialogue: 0,0:12:32.07,0:12:33.78,Default,Nag,0,0,0,,Có chuyện gì thế anh?
Dialogue: 0,0:12:33.78,0:12:38.74,Default,Oka,0,0,0,,À, anh tan ca sớm nên ghé qua thăm em một chút thôi.
Dialogue: 0,0:12:41.08,0:12:44.00,Default,Nag,0,0,0,,Em vừa nghe Nishina-san với Sugisaka-san nói rồi ạ.
Dialogue: 0,0:12:44.87,0:12:47.38,Default,Nag,0,0,0,,Vị này là bạn của anh sao ạ?
Dialogue: 0,0:12:49.17,0:12:50.92,Default,Oka,0,0,0,,Em không nhận ra ai đây thật đấy à?!
Dialogue: 0,0:12:51.25,0:12:54.13,Default,Nag,0,0,0,,Dạ không, đây là lần đầu tiên em gặp bác ấy mà.
Dialogue: 0,0:12:54.92,0:12:56.89,Default,Nag,0,0,0,,Em gửi thực đơn cho hai người ạ.
Dialogue: 0,0:13:00.35,0:13:01.81,Default,Nag,0,0,0,,Xin mời quý khách cứ thong thả chọn món.
Dialogue: 0,0:13:04.39,0:13:06.27,Default,Aki,0,0,0,,Thấy chưa? Con bé không tài nào nhận ra tao được đâu.
Dialogue: 0,0:13:09.48,0:13:11.86,Default,Oka,0,0,0,,Đúng là cha nào con nấy.
Dialogue: 0,0:13:12.65,0:13:14.49,Default,Aki,0,0,0,,Khen thế là đủ rồi đấy.
Dialogue: 0,0:13:14.82,0:13:16.99,Default,Nag,0,0,0,,Hai vị đã chọn xong món chưa ạ?
Dialogue: 0,0:13:16.99,0:13:18.36,Default,Oka,0,0,0,,Cho tôi một ly cà phê nóng nhé.
Dialogue: 0,0:13:18.36,0:13:20.07,Default,Oka,0,0,0,,Còn vị này sẽ dùng món kem parfait.
Dialogue: 0,0:13:20.07,0:13:21.87,Default,Oka,0,0,0,,Cho ly bự nhất quán luôn nhé.
Dialogue: 0,0:13:21.87,0:13:28.00,Default,Nag,0,0,0,,Một cà phê nóng và một ly kem parfait thập cẩm dâu sô-cô-la kim cương đặc biệt.
Dialogue: 0,0:13:28.83,0:13:30.50,Default,Nag,0,0,0,,Em sẽ mang ra ngay ạ.
Dialogue: 0,0:13:31.50,0:13:32.63,Default,Waiter,0,0,0,,Xin lỗi vì đã để quý khách phải chờ lâu ạ.
Dialogue: 0,0:13:33.67,0:13:37.59,Default,Aki,0,0,0,,Mắc mớ gì mà tao lại phải ăn cái món điệu đà diêm dúa này chứ hả?!
Dialogue: 0,0:13:37.59,0:13:39.84,Default,Oka,0,0,0,,Chẳng phải lúc nãy chú bảo muốn ăn kem parfait sao?
Dialogue: 0,0:13:39.84,0:13:43.26,Default,Aki,0,0,0,,Tao có hé môi nửa lời bảo là muốn ăn hồi nào hả?!
Dialogue: 0,0:13:43.26,0:13:45.39,Default,Oka,0,0,0,,Chú nói to đùng ra là chú muốn ăn còn gì nữa.
Dialogue: 0,0:13:47.27,0:13:48.69,Default,Aki,0,0,0,,Này, nhìn kìa.
Dialogue: 0,0:13:54.36,0:13:56.99,Default,Rie,0,0,0,,Furukawa-san được mến mộ lắm đấy nhé.
Dialogue: 0,0:13:56.99,0:14:00.91,Default,Rie,0,0,0,,Hình như có cả những vị khách đến đây chỉ để được ngắm cậu ấy thôi đấy.
Dialogue: 0,0:14:00.91,0:14:03.45,Default,Sug,0,0,0,,Rie-chan ơi, cậu ấy đâu còn mang họ Furukawa nữa đâu.
Dialogue: 0,0:14:04.62,0:14:08.04,Default,Rie,0,0,0,,A đúng rồi. Giờ cậu ấy là Okazaki Nagisa-san rồi.
Dialogue: 0,0:14:10.79,0:14:13.29,Default,Aki,0,0,0,,Tao gọi đó là ma thuật của bộ đồng phục đấy.
Dialogue: 0,0:14:13.29,0:14:15.88,Default,Aki,0,0,0,,Con bé trông dễ thương hơn bội phần thật.
Dialogue: 0,0:14:16.51,0:14:17.34,Default,Sug,0,0,0,,Rie-chan kìa!
Dialogue: 0,0:14:19.59,0:14:22.51,Default,Guy,0,0,0,,Này em ơi, mấy giờ em tan ca thế?
Dialogue: 0,0:14:22.51,0:14:26.14,Default,Guy,0,0,0,,Anh bao em đi ăn tối nhé, hai đứa mình đi ăn gì ngon ngon đi.
Dialogue: 0,0:14:26.14,0:14:29.48,Default,Nag,0,0,0,,Em xin lỗi ạ. Hết ca là em phải về nhà ngay rồi.
Dialogue: 0,0:14:30.81,0:14:34.23,Default,Nag,0,0,0,,Xin phép hai anh, em phải quay lại làm việc ạ.
Dialogue: 0,0:14:34.82,0:14:36.78,Default,Guy,0,0,0,,Khoan đã nào em gái!
Dialogue: 0,0:14:36.78,0:14:37.74,Default,Aki,0,0,0,,Đi thôi con rể.
Dialogue: 0,0:14:37.74,0:14:38.36,Default,Oka,0,0,0,,Dạ rõ.
Dialogue: 0,0:14:38.86,0:14:40.03,Default,Rie,0,0,0,,'Đi' đâu cơ ạ?
Dialogue: 0,0:14:40.03,0:14:40.86,Default,Sug,0,0,0,,Khoan đã hai người...
Dialogue: 0,0:14:40.86,0:14:43.87,Default,Aki,0,0,0,,Yên tâm đi. Bọn này không gây rối đâu mà sợ.
Dialogue: 0,0:14:43.87,0:14:45.58,Default,Guy,0,0,0,,Thôi nào em gái. Đi chơi chút đi mà?
Dialogue: 0,0:14:45.08,0:14:47.16,Default-alt,Aki,0,0,0,,Này hai thằng ranh, lâu ngày không gặp nhỉ.
Dialogue: 0,0:14:47.16,0:14:51.29,Default,Oka,0,0,0,,Mấy năm rồi mới gặp lại, không ngờ lại tao ngộ ở cái chốn này đấy.
Dialogue: 0,0:14:53.25,0:14:55.75,Default,Aki,0,0,0,,Tụi bây đang làm phiền các khách hàng khác đấy biết chưa.
Dialogue: 0,0:14:55.75,0:14:58.13,Default,Aki,0,0,0,,Bước ra ngoài nói chuyện đàng hoàng coi nào, mấy thằng nhóc!
Dialogue: 0,0:15:01.26,0:15:02.89,Default,Guy,0,0,0,,Bọn tao đếch thèm quay lại cái quán này nữa!
Dialogue: 0,0:15:02.89,0:15:03.89,Default,Guy,0,0,0,,Xui xẻo vãi cả đái!
Dialogue: 0,0:15:05.93,0:15:07.43,Default,Aki,0,0,0,,Mẹ kiếp, chúng nó chạy mất dép rồi.
Dialogue: 0,0:15:08.22,0:15:09.14,Default,Nag,0,0,0,,Dạ ừm...
Dialogue: 0,0:15:09.93,0:15:12.65,Default,Nag,0,0,0,,Quản lý muốn gặp hai người một lát ạ...
Dialogue: 0,0:15:13.02,0:15:13.94,Default,Oka,0,0,0,,Quản lý sao?
Dialogue: 0,0:15:15.61,0:15:18.11,Default,Aki,0,0,0,,Hậu quả rắc rối tao giao lại hết cho mày đấy nhé con trai.
Dialogue: 0,0:15:18.11,0:15:20.11,Default,Aki,0,0,0,,Bai bai cưng nhé!
Dialogue: 0,0:15:20.11,0:15:21.07,Default,Oka,0,0,0,,Này ông già kia!
Dialogue: 0,0:15:23.82,0:15:26.66,Default,Oka,0,0,0,,Anh xin lỗi vì đã gây phiền toái cho em nhé.
Dialogue: 0,0:15:27.24,0:15:30.41,Default,Nag,0,0,0,,Dạ không, em rất vui vì được anh giải cứu mà.
Dialogue: 0,0:15:31.29,0:15:35.00,Default,Nag,0,0,0,,Nhưng nghĩ đến việc anh sắp bị quản lý mắng thì em lại thấy lo...
Dialogue: 0,0:15:36.46,0:15:41.47,Default,Oka,0,0,0,,Đừng lo. Anh sẽ không nói với ông ấy em là vợ anh đâu.
Dialogue: 0,0:15:41.97,0:15:43.22,Default,Nag,0,0,0,,Không được, em không muốn anh giấu như thế đâu ạ!
Dialogue: 0,0:15:48.93,0:15:52.64,Default,Man,0,0,0,,Vợ cậu làm việc chăm chỉ và tuyệt vời lắm đấy.
Dialogue: 0,0:15:52.64,0:15:53.77,Default,Oka,0,0,0,,Ông ấy biết hết rồi kìa.
Dialogue: 0,0:15:54.40,0:15:57.52,Default,Man,0,0,0,,Nishina-kun và Sugisaka-kun đã kể cho tôi nghe cả rồi.
Dialogue: 0,0:15:57.52,0:16:01.36,Default,Man,0,0,0,,Nhân tiện có dịp thuận lợi thế này, tôi cũng muốn ra chào hỏi cậu một tiếng.
Dialogue: 0,0:16:01.74,0:16:04.36,Default,Oka,0,0,0,,Cháu xin lỗi vì đã gây ra sự ồn ào vừa rồi ạ.
Dialogue: 0,0:16:04.36,0:16:08.58,Default,Man,0,0,0,,Ồ không có gì đâu. Dù sao người vợ quý giá của cậu cũng đang bị quấy rầy mà.
Dialogue: 0,0:16:08.58,0:16:11.29,Default,Man,0,0,0,,Tôi hoàn toàn có thể thấu hiểu được cảm xúc của cậu lúc đó.
Dialogue: 0,0:16:13.12,0:16:16.67,Default,Man,0,0,0,,Thực ra trước đây cũng từng xảy ra chuyện tương tự một lần rồi.
Dialogue: 0,0:16:16.67,0:16:20.76,Default,Man,0,0,0,,Lần đó, cô ấy đã tự mình xử lý tình huống rất khéo léo.
Dialogue: 0,0:16:20.76,0:16:23.97,Default,Oka,0,0,0,,Tự mình xử lý sao ạ? Thật thế cơ ạ?
Dialogue: 0,0:16:23.97,0:16:30.31,Default,Man,0,0,0,,Cô ấy tuy thể lực có phần yếu và chưa từng có kinh nghiệm đi làm, nhưng lại rất thông minh và có một ý chí kiên định.
Dialogue: 0,0:16:30.31,0:16:34.52,Default,Man,0,0,0,,Những nhân viên như cô ấy là vô cùng quý giá đối với quán chúng tôi.
Dialogue: 0,0:16:35.56,0:16:40.40,Default,Man,0,0,0,,Nhưng cô ấy nghiêm túc quá; mỗi khi mắc lỗi là lại rất dễ suy sụp và buồn rầu,
Dialogue: 0,0:16:40.40,0:16:43.65,Default,Man,0,0,0,,nên những lúc như thế, ở nhà phiền cậu hãy yêu thương và động viên cô ấy thật nhiều nhé.
Dialogue: 0,0:16:44.28,0:16:48.74,Default,Oka,0,0,0,,Cháu nhất định sẽ làm vậy ạ. Cháu chân thành cảm ơn bác rất nhiều.
Dialogue: 0,0:16:48.74,0:16:54.29,Default,Oka,0,0,0,,Từ nay về sau cũng xin bác tiếp tục chỉ bảo và trông nom cho Nagi— ý cháu là vợ cháu ạ.
Dialogue: 0,0:16:55.71,0:16:58.54,Default,Man,0,0,0,,Đó cũng là vinh hạnh của chúng tôi. Có cô ấy làm việc ở đây thật là điều may mắn.
Dialogue: 0,0:16:59.88,0:17:02.67,Default,Oka,0,0,0,,Có vẻ như em cũng đã tìm được chỗ đứng mới cho riêng mình rồi nhỉ.
Dialogue: 0,0:17:03.26,0:17:07.89,Default,Nag,0,0,0,,Vâng ạ. Làm việc ở đây khiến em nhớ lại những ngày tháng nỗ lực hết mình cùng Câu lạc bộ Kịch ghê.
Dialogue: 0,0:17:07.89,0:17:10.14,Default,Oka,0,0,0,,Hôm nay em mặc bộ đồng phục trông rất hợp đấy.
Dialogue: 0,0:17:10.14,0:17:13.22,Default,Oka,0,0,0,,Bạn số 1 của anh cũng khen em trông dễ thương lắm đấy.
Dialogue: 0,0:17:13.77,0:17:19.73,Default,Nag,0,0,0,,E-Em không có dễ thương đâu ạ. Nishina-san với Sugisaka-san trông dễ thương hơn em nhiều.
Dialogue: 0,0:17:21.48,0:17:24.49,Default,Nag,0,0,0,,À, em vừa nhớ ra một chuyện Nishina-san kể lúc nãy.
Dialogue: 0,0:17:25.74,0:17:29.24,Default,Nag,0,0,0,,Hình như nhà trường sắp xây dựng một tòa nhà mới ở trường mình đấy ạ.
Dialogue: 0,0:17:29.95,0:17:32.33,Default,Nag,0,0,0,,Họ dự định sẽ đập bỏ dãy nhà cũ đi.
Dialogue: 0,0:17:34.83,0:17:39.92,Default,Nag,0,0,0,,Hai năm nữa, các em học sinh mới sẽ được học trong những phòng học hoàn toàn mới tinh tươm.
Dialogue: 0,0:17:40.33,0:17:41.92,Default,Nag,0,0,0,,Đó là một điều rất tuyệt vời đúng không anh?
Dialogue: 0,0:17:43.00,0:17:44.21,Default,Oka,0,0,0,,Không tuyệt chút nào cả.
Dialogue: 0,0:18:00.27,0:18:01.52,Default,Oka,0,0,0,,Chẳng có gì tốt đẹp ở chuyện đó hết!
Dialogue: 0,0:18:08.24,0:18:09.99,Default,Oka,0,0,0,,A... anh xin lỗi...
Dialogue: 0,0:18:10.99,0:18:13.20,Default,Nag,0,0,0,,Có chuyện gì thế anh, Tomoya-kun?
Dialogue: 0,0:18:13.20,0:18:15.58,Default,Oka,0,0,0,,Không, không có gì đâu.
Dialogue: 0,0:18:16.00,0:18:17.96,Default,Nag,0,0,0,,Giọng anh nghe đâu giống như không có gì đâu ạ.
Dialogue: 0,0:18:18.33,0:18:21.71,Default,Nag,0,0,0,,Nếu em có nói điều gì phật lòng thì cho em xin lỗi anh nhé.
Dialogue: 0,0:18:22.34,0:18:23.96,Default,Nag,0,0,0,,Điều gì đã khiến anh giận dữ đến thế ạ?
Dialogue: 0,0:18:30.05,0:18:31.30,Default,Oka,0,0,0,,Anh đâu có giận.
Dialogue: 0,0:18:33.10,0:18:34.39,Default,Oka,0,0,0,,Chỉ là... anh thấy bực bội trong lòng thôi.
Dialogue: 0,0:18:34.93,0:18:36.35,Default,Oka,0,0,0,,Em nghĩ mà xem.
Dialogue: 0,0:18:36.72,0:18:39.89,Default,Oka,0,0,0,,Dãy nhà cũ đó có phòng sinh hoạt của Câu lạc bộ Kịch mà.
Dialogue: 0,0:18:39.89,0:18:42.69,Default,Oka,0,0,0,,Là nơi mà hai đứa mình đã cùng nhau nỗ lực hết mình suốt bao ngày tháng.
Dialogue: 0,0:18:44.27,0:18:45.86,Default,Nag,0,0,0,,Vâng... đúng là như vậy ạ.
Dialogue: 0,0:18:46.48,0:18:49.78,Default,Nag,0,0,0,,Khi dãy nhà đó biến mất, em cũng sẽ thấy nhớ nhung và hụt hẫng lắm.
Dialogue: 0,0:18:49.78,0:18:51.53,Default,Oka,0,0,0,,Ừ, chính vì thế nên...
Dialogue: 0,0:18:51.86,0:18:56.29,Default,Oka,0,0,0,,Xin lỗi em nhé, anh hơi nhạy cảm quá rồi.
Dialogue: 0,0:18:59.37,0:19:03.00,Default,Nag,0,0,0,,Không đâu ạ, là do em vô tâm không suy nghĩ thấu đáo.
Dialogue: 0,0:19:03.67,0:19:05.00,Default,Nag,0,0,0,,Em xin lỗi anh nhé.
Dialogue: 0,0:19:05.46,0:19:07.55,Default,Oka,0,0,0,,Không, anh mới là người phải xin lỗi.
Dialogue: 0,0:19:07.55,0:19:09.01,Default,Nag,0,0,0,,Không sao đâu anh.
Dialogue: 0,0:19:18.18,0:19:20.64,Default,Oka,0,0,0,,Anh đúng là đã cư xử vô lý quá.
Dialogue: 0,0:19:21.56,0:19:22.73,Default,Oka,0,0,0,,Tại sao chứ?
Dialogue: 0,0:19:23.19,0:19:25.65,Default,Oka,0,0,0,,Tại sao lòng mình lại cồn cào bất an đến nhường này?
Dialogue: 0,0:19:30.44,0:19:31.99,Default,Oka,0,0,0,,Thành phố này đang ngày một đổi thay.
Dialogue: 0,0:19:32.91,0:19:36.66,Default,Oka,0,0,0,,Cả Nagisa, cả mình... và tất cả mọi thứ xung quanh.
Dialogue: 0,0:19:38.16,0:19:41.79,Default,Oka,0,0,0,,Và rồi, khi tất cả mọi thứ hoàn toàn biến đổi...
Dialogue: 0,0:19:43.88,0:19:47.21,Default,Nag,0,0,0,,Dẫu là vậy, liệu mình có còn có thể tiếp tục yêu thương nơi này được nữa hay không?
Dialogue: 0,0:19:56.18,0:19:59.06,Default,Aki,0,0,0,,Nhìn này, cuối cùng ảnh cũng rửa xong rồi đây!
Dialogue: 0,0:20:00.31,0:20:02.94,Default,Oka,0,0,0,,Chú chụp đống ảnh này từ lúc nào thế hả?!
Dialogue: 0,0:20:04.35,0:20:07.82,Default,Aki,0,0,0,,Sau hôm đó tao đã lén quay lại bao nhiêu lần để chụp đấy nhé!
Dialogue: 0,0:20:08.98,0:20:10.57,Default,Aki,0,0,0,,Tao đã đổ bao nhiêu tâm huyết vào đống ảnh này đấy.
Dialogue: 0,0:20:10.57,0:20:12.28,Default,Aki,0,0,0,,Có lúc tao phải nằm rạp bụng xuống sàn nhà.
Dialogue: 0,0:20:12.28,0:20:17.58,Default,Aki,0,0,0,,Có lúc lại phải trốn chui trốn lủi trong góc bếp để canh góc chụp nhào lộn đỉnh cao.
Dialogue: 0,0:20:17.58,0:20:19.45,Default,Oka,0,0,0,,Cháu ngạc nhiên là người ta chưa tống cổ chú ra ngoài đấy.
Dialogue: 0,0:20:21.08,0:20:22.46,Default,Aki,0,0,0,,Mấy đứa phụ nữ đang làm cái trò gì trong kia thế nhỉ?
Dialogue: 0,0:20:22.46,0:20:25.17,Default,Aki,0,0,0,,Tao muốn khoe tác phẩm nghệ thuật của tao quá.
Dialogue: 0,0:20:25.17,0:20:29.80,Default,Oka,0,0,0,,Cháu chịu. Nhưng Nagisa bảo có chuyện muốn hỏi ý kiến Sanae-san.
Dialogue: 0,0:20:30.25,0:20:31.96,Default,Oka,0,0,0,,Ủa khoan đã, chú tính cho mọi người xem đống ảnh đó thật đấy à?!
Dialogue: 0,0:20:35.09,0:20:36.34,Default,Oka,0,0,0,,Có chuyện gì thế Nagisa?!
Dialogue: 0,0:20:39.06,0:20:39.97,Default,San,0,0,0,,Con có sao không?
Dialogue: 0,0:20:39.97,0:20:42.77,Default,Nag,0,0,0,,Con xin lỗi. Tự nhiên con thấy hơi buồn nôn một chút thôi ạ.
Dialogue: 0,0:20:44.60,0:20:47.06,Default,Aki,0,0,0,,Cái gì? Mày có bầu rồi đấy à?!
Dialogue: 0,0:20:47.77,0:20:49.23,Default,Oka,0,0,0,,Chú nói năng tế nhị chút coi nào!
Dialogue: 0,0:20:51.15,0:20:55.53,Default,Aki,0,0,0,,Mà thực ra, nếu mày là một thằng đàn ông đích thực thì giờ con bé phải dính bầu rồi mới đúng chứ.
Dialogue: 0,0:20:56.16,0:20:58.03,Default,San,0,0,0,,Có vẻ đúng là con bé mang thai thật rồi đấy.
Dialogue: 0,0:20:58.53,0:20:59.08,Default,2,0,0,0,,Hả?!
Dialogue: 0,0:20:59.08,0:21:00.45,Default,San,0,0,0,,Một em bé.
Dialogue: 0,0:21:02.83,0:21:03.96,Default,Aki,0,0,0,,Của ai? Của tôi hả?!
Dialogue: 0,0:21:03.96,0:21:06.54,Default,San,0,0,0,,Là của Nagisa và Tomoya-san đấy ạ.
Dialogue: 0,0:21:06.96,0:21:08.96,Default,San,0,0,0,,Chúc mừng hai đứa nhé.
Dialogue: 0,0:21:09.00,0:21:12.63,Default,Aki,0,0,0,,Khoan đã nào Sanae! Em bé là thế nào cơ?!
Dialogue: 0,0:21:12.63,0:21:14.34,Default,Aki,0,0,0,,Chim bồ nông tha đến thả trước cửa nhà à?
Dialogue: 0,0:21:14.34,0:21:17.34,Default,Aki,0,0,0,,Hay là con bé nhặt được ngoài luống bắp cải thế?!
Dialogue: 0,0:21:17.34,0:21:22.93,Default,Nag,0,0,0,,K-Không phải đâu bố ơi. Con và Tomoya-kun đã kết hôn rồi, nên là...
Dialogue: 0,0:21:22.93,0:21:25.64,Default,Oka,0,0,0,,Khoan đã, con bé không định nói toẹt ra đấy chứ?!
Dialogue: 0,0:21:29.15,0:21:31.65,Default,Nag,0,0,0,,...chúng con đã làm chuyện người lớn rồi mà!
Dialogue: 0,0:21:34.74,0:21:37.99,Default,Oka,0,0,0,,Nói thẳng thừng chuyện đó trước mặt bố mẹ ruột như thế này...
Dialogue: 0,0:21:38.32,0:21:41.78,Default,Oka,0,0,0,,Chắc trên quả đất này con bé là sinh vật quý hiếm độc nhất vô nhị mất.
Dialogue: 0,0:21:42.49,0:21:44.29,Default,Oka,0,0,0,,Nagisa, em đỉnh thật đấy.
Dialogue: 0,0:21:44.66,0:21:48.92,Default,Nag,0,0,0,,Tháng này con chưa thấy có kinh nguyệt, nên con khá chắc chắn ạ.
Dialogue: 0,0:21:51.04,0:21:52.80,Default,Aki,0,0,0,,Thằng nhãi con kia!
Dialogue: 0,0:21:52.80,0:21:54.92,Default,Aki,0,0,0,,Thằng khốn này...
Dialogue: 0,0:21:59.34,0:22:01.05,Default,Aki,0,0,0,,Chúc mừng hai đứa nhé.
Dialogue: 0,0:22:01.93,0:22:03.81,Default,Oka,0,0,0,,D-Dạ... Cháu cảm ơn chú...
