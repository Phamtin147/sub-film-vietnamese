Dialogue: 0,0:04:08.82,0:04:16.20,Default,Rob,0,0,0,,Nếu phế liệu chỉ có thể thành hình nhờ vào ước nguyện tha thiết từ tận đáy tim, thì một mình tôi không thể làm được.
Dialogue: 0,0:04:18.41,0:04:20.33,Default,Rob,0,0,0,,Điều đó tôi vốn đã biết rõ từ lâu rồi.
Dialogue: 0,0:04:21.62,0:04:22.62,Default,Rob,0,0,0,,Bởi vì...
Dialogue: 0,0:04:23.83,0:04:25.25,Default,Rob,0,0,0,,Bởi vì tôi...
Dialogue: 0,0:04:26.29,0:04:27.92,Default,Rob,0,0,0,,...không phải là con người.
Dialogue: 0,0:04:37.68,0:04:39.39,Default,Girl,0,0,0,,Bạn đang khóc đấy à?
Dialogue: 0,0:04:40.89,0:04:43.52,Default,Girl,0,0,0,,Bạn vừa nhớ lại chuyện gì buồn lắm sao?
Dialogue: 0,0:04:45.02,0:04:47.65,Default,Girl,0,0,0,,Thế giới này quả thật rất buồn đau, đúng không bạn?
Dialogue: 0,0:04:51.94,0:04:54.57,Default,Girl,0,0,0,,Nơi đây chẳng mấy chốc sẽ bị tuyết trắng bao phủ hoàn toàn.
Dialogue: 0,0:04:56.11,0:05:02.37,Default,Girl,0,0,0,,Nếu tôi không thể cử động được nữa, thì bạn sẽ chỉ còn lại một mình cô độc, đúng không?
Dialogue: 0,0:05:26.52,0:05:27.64,Default,Oka,0,0,0,,Dạ ai đấy ạ?
Dialogue: 0,0:05:28.27,0:05:30.15,Default,San,0,0,0,,Chào cháu, Tomoya-san.
Dialogue: 0,0:05:30.15,0:05:31.57,Default,Oka,0,0,0,,Sanae-san!
Dialogue: 0,0:05:31.57,0:05:34.23,Default,San,0,0,0,,Cô xin lỗi nhé. Cháu vẫn còn đang ngủ sao?
Dialogue: 0,0:05:34.23,0:05:35.65,Default,Oka,0,0,0,,Dạ không, không sao đâu ạ.
Dialogue: 0,0:05:36.45,0:05:37.40,Default,Oka,0,0,0,,Cô đi một mình thôi sao ạ?
Dialogue: 0,0:05:37.40,0:05:39.91,Default,San,0,0,0,,Vâng. Cô đến đây một mình.
Dialogue: 0,0:05:40.41,0:05:42.53,Default,Oka,0,0,0,,Cô đợi cháu một lát được không ạ?
Dialogue: 0,0:05:42.99,0:05:45.87,Default,Oka,0,0,0,,Phòng ốc bừa bộn quá, để cháu dọn dẹp một chút ạ.
Dialogue: 0,0:05:46.20,0:05:49.88,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 17
Dialogue: 0,0:05:46.20,0:05:49.88,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Mùa Hè
Dialogue: 0,0:05:52.46,0:05:54.50,Default,San,0,0,0,,Hôm nay trời oi bức thật đấy cháu nhỉ.
Dialogue: 0,0:05:54.50,0:05:55.76,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:05:55.76,0:05:59.47,Default,San,0,0,0,,Thỉnh thoảng cháu cũng nên ra ngoài hít thở không khí cho khuây khỏa chứ.
Dialogue: 0,0:05:59.89,0:06:03.51,Default,Oka,0,0,0,,Dạ. Anh Yoshino cũng hay nhắc cháu như thế ạ.
Dialogue: 0,0:06:03.51,0:06:06.89,Default,Oka,0,0,0,,Nhưng mà, ngày nóng nực thế này đi ra ngoài một mình...
Dialogue: 0,0:06:06.89,0:06:09.27,Default,San,0,0,0,,Thế thì hãy đi hẹn hò cùng cô nhé.
Dialogue: 0,0:06:09.27,0:06:10.02,Default,Oka,0,0,0,,Hả?
Dialogue: 0,0:06:12.44,0:06:14.86,Default,Oka,0,0,0,,Sao tự nhiên cô lại nói chuyện đó thế ạ?
Dialogue: 0,0:06:14.86,0:06:16.28,Default,San,0,0,0,,Cũng không có gì đặc biệt đâu.
Dialogue: 0,0:06:16.28,0:06:19.49,Default,San,0,0,0,,Chỉ là thỉnh thoảng cô cũng muốn đi hẹn hò cùng người trẻ tuổi một chút mà.
Dialogue: 0,0:06:20.11,0:06:23.62,Default,Oka,0,0,0,,Thế sao cô không tìm ai khác ngoài cháu ấy ạ?
Dialogue: 0,0:06:23.62,0:06:25.04,Default,San,0,0,0,,Cô không chịu đâu.
Dialogue: 0,0:06:25.04,0:06:29.71,Default,San,0,0,0,,Cháu vừa đẹp trai lại tốt bụng, rất đúng gu của cô đấy nhé.
Dialogue: 0,0:06:29.71,0:06:34.00,Default,Oka,0,0,0,,Làm gì có chuyện đó đâu cô. Cháu toàn dựa dẫm làm phiền cô chú suốt thôi.
Dialogue: 0,0:06:40.72,0:06:42.68,Default,Oka,0,0,0,,Chỗ này thay đổi nhiều thật đấy.
Dialogue: 0,0:06:42.68,0:06:45.47,Default,San,0,0,0,,Cháu không hay ra khu nhà ga này sao?
Dialogue: 0,0:06:45.47,0:06:47.64,Default,Oka,0,0,0,,Dạ không, cháu ít khi sang phía bên này của ga lắm ạ.
Dialogue: 0,0:06:51.40,0:06:55.44,Default,San,0,0,0,,Hè này cháu có thể xin nghỉ phép dài ngày được không?
Dialogue: 0,0:06:56.69,0:07:00.45,Default,Oka,0,0,0,,Bên công ty họ cũng đang hối thúc cháu nghỉ phép đây ạ.
Dialogue: 0,0:07:01.41,0:07:03.82,Default,San,0,0,0,,Thế thì chúng ta cùng nhau đi đâu đó chơi một chuyến nhé?
Dialogue: 0,0:07:03.82,0:07:05.53,Default,Oka,0,0,0,,Chỉ có hai cô cháu mình thôi sao ạ?
Dialogue: 0,0:07:05.53,0:07:07.33,Default,Oka,0,0,0,,Thế thì nghe hồi hộp và ly kỳ ghê đấy.
Dialogue: 0,0:07:07.33,0:07:09.29,Default,San,0,0,0,,Như thế cũng vui đấy chứ.
Dialogue: 0,0:07:09.70,0:07:12.33,Default,San,0,0,0,,Nhưng lần này, cả nhà chúng ta hãy cùng nhau đi nhé.
Dialogue: 0,0:07:13.21,0:07:14.21,Default,Oka,0,0,0,,'Cả nhà' sao ạ?
Dialogue: 0,0:07:14.21,0:07:16.09,Default,San,0,0,0,,Vâng. Tất cả mọi người cùng đi.
Dialogue: 0,0:07:18.05,0:07:20.76,Default,Kid,0,0,0,,Mẹ ơi! Nhanh lên nào! Đi mua nước ngọt uống đi mẹ!
Dialogue: 0,0:07:20.76,0:07:24.26,Default,Mom,0,0,0,,Thôi nào con. Làm ồn phiền các khách hàng khác bây giờ.
Dialogue: 0,0:07:25.76,0:07:31.02,Default,San,0,0,0,,Đi nhé cháu. Akio-san dạo này cũng rất muốn được nâng ly uống rượu cùng cháu đấy.
Dialogue: 0,0:07:31.60,0:07:32.89,Default,Oka,0,0,0,,Nhưng mà cháu...
Dialogue: 0,0:07:32.89,0:07:34.10,Default,San,0,0,0,,Chúng ta cùng đi nhé.
Dialogue: 0,0:07:34.10,0:07:34.69,Default,San,0,0,0,,Được không cháu?
Dialogue: 0,0:07:36.65,0:07:38.07,Default,Oka,0,0,0,,Để... để cháu suy nghĩ thêm đã ạ.
Dialogue: 0,0:07:47.99,0:07:49.12,Default,San,0,0,0,,Cô Sanae đây cháu.
Dialogue: 0,0:07:49.12,0:07:51.46,Default,San,0,0,0,,Cháu đã quyết định về chuyến đi du lịch chưa?
Dialogue: 0,0:07:51.46,0:07:54.25,Default,Oka,0,0,0,,A, dạ chưa ạ. Cháu vẫn chưa kịp nghĩ tới.
Dialogue: 0,0:07:54.25,0:07:57.00,Default,San,0,0,0,,Thế lát nữa cô lại gọi lại nhé.
Dialogue: 0,0:08:00.09,0:08:01.80,Default,Oka,0,0,0,,Sao hôm nay cô ấy lại quyết liệt đến thế nhỉ?
Dialogue: 0,0:08:04.89,0:08:05.59,Default,Oka,0,0,0,,Alo ạ?
Dialogue: 0,0:08:05.59,0:08:07.76,Default,San,0,0,0,,Cháu đã suy nghĩ kỹ chưa nào?
Dialogue: 0,0:08:09.47,0:08:11.68,Default,Oka,0,0,0,,Cháu chịu thua cô rồi đấy ạ.
Dialogue: 0,0:08:11.68,0:08:14.02,Default,San,0,0,0,,Thế là cháu đồng ý đi rồi đúng không?
Dialogue: 0,0:08:14.02,0:08:14.73,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:08:15.19,0:08:20.94,Default,Oka,0,0,0,,Cháu sẽ xin nghỉ phép vào cuối tuần để được nghỉ trọn vẹn bốn ngày tính cả Chủ nhật ạ.
Dialogue: 0,0:08:20.94,0:08:22.69,Default,San,0,0,0,,Cô cảm ơn cháu nhiều lắm nhé.
Dialogue: 0,0:08:28.74,0:08:31.58,Default,Oka,0,0,0,,Thành thật mà nói, lòng tôi vô cùng rối bời.
Dialogue: 0,0:08:32.54,0:08:36.71,Default,Oka,0,0,0,,Thế nhưng lúc này nếu nói lời từ chối thì chẳng khác nào tôi đang phản bội lại cô ấy.
Dialogue: 0,0:08:37.75,0:08:42.17,Default,Oka,0,0,0,,Bởi lẽ suốt bao năm qua, tôi đã đùn đẩy tất cả mọi gánh nặng lên vai cô chú ấy.
Dialogue: 0,0:08:52.31,0:08:53.35,Default,Oka,0,0,0,,Cháu chào cô chú ạ.
Dialogue: 0,0:08:55.64,0:08:56.81,Default,Oka,0,0,0,,Sanae-san?
Dialogue: 0,0:09:00.48,0:09:01.69,Default,Oka,0,0,0,,Bố già ơi!
Dialogue: 0,0:09:14.50,0:09:16.12,Default,Oka,0,0,0,,'Gửi Tomoya-san.'
Dialogue: 0,0:09:16.71,0:09:21.71,Default,San,0,0,0,,'Bác và Akio-san có việc đột xuất nên phải đi vắng.'
Dialogue: 0,0:09:22.25,0:09:24.67,Default,San,0,0,0,,'Phần còn lại nhờ cậy cả vào cháu nhé.'
Dialogue: 0,0:09:29.14,0:09:30.93,Default,Oka,0,0,0,,Đùa nhau chắc...
Dialogue: 0,0:09:55.87,0:09:56.71,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:10:17.10,0:10:17.98,Default,Oka,0,0,0,,Ushio!
Dialogue: 0,0:10:52.51,0:10:56.01,Default,Oka,0,0,0,,Nào, không cần phải rụt rè thế đâu. Ra đây với bố nào.
Dialogue: 0,0:11:00.14,0:11:02.81,Default,Oka,0,0,0,,Sanae-san với ông già đi ra ngoài rồi à con?
Dialogue: 0,0:11:03.36,0:11:04.36,Default,Oka,0,0,0,,Con muốn làm gì bây giờ?
Dialogue: 0,0:11:05.73,0:11:06.94,Default,Ush,0,0,0,,Bà Sanae.
Dialogue: 0,0:11:06.94,0:11:09.90,Default,Oka,0,0,0,,Không, nghe bố nói này. Bà Sanae không có ở đây đâu.
Dialogue: 0,0:11:10.49,0:11:11.86,Default,Ush,0,0,0,,Ông Akki.
Dialogue: 0,0:11:11.86,0:11:13.57,Default,Oka,0,0,0,,Ông già cũng không có ở đây nốt.
Dialogue: 0,0:11:19.62,0:11:23.04,Default,Oka,0,0,0,,Cả hai người họ đi mà không nói lời nào với con sao?
Dialogue: 0,0:11:25.75,0:11:27.13,Default,Oka,0,0,0,,Bây giờ con muốn thế nào nào?
Dialogue: 0,0:11:28.59,0:11:30.55,Default,Ush,0,0,0,,Con muốn đi du lịch cơ.
Dialogue: 0,0:11:31.13,0:11:32.51,Default,Oka,0,0,0,,Chuyện đó là không thể rồi.
Dialogue: 0,0:11:32.51,0:11:34.84,Default,Oka,0,0,0,,Cả bà Sanae lẫn ông già đều không có ở đây mà.
Dialogue: 0,0:11:34.84,0:11:37.22,Default,Oka,0,0,0,,Hay là con muốn đi một mình?
Dialogue: 0,0:11:37.72,0:11:40.48,Default,Ush,0,0,0,,Con muốn đi cùng bà Sanae với ông Akki cơ.
Dialogue: 0,0:11:40.81,0:11:42.69,Default,Oka,0,0,0,,Bố đã bảo rồi, chuyện đó là không thể mà.
Dialogue: 0,0:11:58.20,0:12:00.33,Default,Oka,0,0,0,,Rốt cuộc cái tình cảnh trớ trêu này là thế nào đây?
Dialogue: 0,0:12:07.04,0:12:11.46,Default,Oka,0,0,0,,Suốt năm năm ròng rã qua, tôi đã phó mặc Ushio hoàn toàn cho Sanae-san và ông già chăm sóc.
Dialogue: 0,0:12:12.30,0:12:16.72,Note,,0,0,0,,Note: The Seven-Five-Three Festival celebrate children's growth when they reached the ages seven, five, and three.
Dialogue: 0,0:12:12.30,0:12:16.72,Default,Oka,0,0,0,,Tôi phớt lờ cả ngày con bé vào mẫu giáo,\Ncả lễ Shichi-Go-San của con, chỉ biết cắm đầu vào làm việc.
Dialogue: 0,0:12:17.76,0:12:24.23,Default,Oka,0,0,0,,Thỉnh thoảng Sanae-san có dắt Ushio sang chỗ tôi,\Nnhưng hầu như tôi chẳng bao giờ dám nhìn thẳng vào khuôn mặt của con bé.
Dialogue: 0,0:12:28.15,0:12:28.69,Default,Oka,0,0,0,,Ushio.
Dialogue: 0,0:12:33.86,0:12:35.82,Default,Oka,0,0,0,,Con nghĩ con trốn thế là bố không thấy à?
Dialogue: 0,0:12:35.82,0:12:36.87,Default,Oka,0,0,0,,Bố nhìn thấy hết rồi đấy nhé.
Dialogue: 0,0:12:37.45,0:12:39.99,Default,Oka,0,0,0,,Đừng đứng nép ở đó nữa, ra đây đi con.
Dialogue: 0,0:12:49.59,0:12:50.50,Default,Oka,0,0,0,,Ngồi xuống đây.
Dialogue: 0,0:12:53.05,0:12:54.05,Default,Oka,0,0,0,,Kệ con vậy.
Dialogue: 0,0:12:55.18,0:13:00.39,Default,Oka,0,0,0,,Để xem nào. Bố nghĩ chắc đến tối\Nthì cả bà Sanae lẫn ông già sẽ về thôi.
Dialogue: 0,0:13:00.93,0:13:03.52,Default,Oka,0,0,0,,Nên con cứ ngoan ngoãn ngồi đợi nhé.
Dialogue: 0,0:13:03.52,0:13:04.27,Default,Oka,0,0,0,,Được không con?
Dialogue: 0,0:13:05.02,0:13:06.39,Default,Ush,0,0,0,,Đi du lịch.
Dialogue: 0,0:13:06.94,0:13:09.98,Default,Oka,0,0,0,,Khi nào ông bà về thì chúng ta mới đi được.
Dialogue: 0,0:13:10.44,0:13:12.40,Default,Oka,0,0,0,,Hôm nay con cứ tự chơi một mình đi nhé.
Dialogue: 0,0:13:12.73,0:13:13.36,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:13:16.11,0:13:18.24,Default,Oka,0,0,0,,Tính tình con bé nghịch ngợm giống con trai ghê.
Dialogue: 0,0:13:21.45,0:13:22.29,Default,Oka,0,0,0,,Ushio!
Dialogue: 0,0:13:29.79,0:13:31.17,Default,Oka,0,0,0,,Con có sao không đấy?!
Dialogue: 0,0:13:31.17,0:13:32.71,Default,Oka,0,0,0,,Tại con cứ chạy thục mạng như thế đấy.
Dialogue: 0,0:13:33.25,0:13:34.55,Default,Oka,0,0,0,,Có đau ở đâu không?
Dialogue: 0,0:13:34.92,0:13:36.63,Default,Oka,0,0,0,,Có vẻ không sao rồi.
Dialogue: 0,0:13:36.63,0:13:37.84,Default,Oka,0,0,0,,Lần sau phải cẩn thận đấy nhé.
Dialogue: 0,0:13:53.82,0:13:55.74,Default,Oka,0,0,0,,Con vừa chơi cái này đấy à?
Dialogue: 0,0:13:56.95,0:14:00.45,Default,Oka,0,0,0,,Làm rơi nên gãy mất rồi đúng không?
Dialogue: 0,0:14:01.45,0:14:03.45,Default,Ush,0,0,0,,Bạn rùa tội nghiệp quá.
Dialogue: 0,0:14:08.25,0:14:10.58,Default,Oka,0,0,0,,Chắc dùng keo dán sắt dán lại là được thôi.
Dialogue: 0,0:14:12.21,0:14:14.67,Default,Oka,0,0,0,,Đợi bố một lát. Bố dán lại cho.
Dialogue: 0,0:14:31.98,0:14:36.19,Default,Oka,0,0,0,,Vẫn còn nhìn thấy vết nứt một chút, nhưng chắc không lộ liễu lắm đâu.
Dialogue: 0,0:14:38.53,0:14:40.15,Default,Oka,0,0,0,,Đừng có đụng vào chơi cho đến khi keo khô hẳn nhé con.
Dialogue: 0,0:14:40.49,0:14:42.28,Default,Oka,0,0,0,,Không là bánh xe dính chặt vào luôn đấy.
Dialogue: 0,0:14:44.45,0:14:46.20,Default,Oka,0,0,0,,Không biết con bé có hiểu những gì mình nói không nữa?
Dialogue: 0,0:14:47.33,0:14:48.58,Default,Oka,0,0,0,,Thôi kệ đi.
Dialogue: 0,0:14:58.05,0:14:59.30,Default,Oka,0,0,0,,Gì thế con?
Dialogue: 0,0:14:59.67,0:15:01.47,Default,Ush,0,0,0,,Bạn không chạy được nữa rồi.
Dialogue: 0,0:15:05.72,0:15:07.60,Default,Oka,0,0,0,,Trời đất ơi.
Dialogue: 0,0:15:07.60,0:15:10.31,Default,Oka,0,0,0,,Bố đã dặn là không được đụng vào cho đến khi khô rồi cơ mà?
Dialogue: 0,0:15:10.69,0:15:13.61,Default,Oka,0,0,0,,Bánh xe bị dính tịt lại không quay được nữa rồi đấy.
Dialogue: 0,0:15:13.61,0:15:15.15,Default,Ush,0,0,0,,Không sửa lại được nữa hả bố?
Dialogue: 0,0:15:15.15,0:15:16.27,Default,Oka,0,0,0,,Hết cách rồi con ạ.
Dialogue: 0,0:15:16.27,0:15:17.40,Default,Oka,0,0,0,,Bỏ cuộc đi.
Dialogue: 0,0:15:17.73,0:15:19.53,Default,Oka,0,0,0,,Con có muốn vứt nó đi không?
Dialogue: 0,0:15:22.49,0:15:23.87,Default,Oka,0,0,0,,Bố nói đùa đấy.
Dialogue: 0,0:15:31.87,0:15:34.00,Default,Oka,0,0,0,,Con còn cần gì nữa không?
Dialogue: 0,0:15:34.67,0:15:36.04,Default,Ush,0,0,0,,Bà Sanae.
Dialogue: 0,0:15:37.05,0:15:38.55,Default,Oka,0,0,0,,Họ về rồi à con?
Dialogue: 0,0:15:39.05,0:15:40.88,Default,Ush,0,0,0,,Vẫn chưa về ạ.
Dialogue: 0,0:15:42.01,0:15:42.88,Default,Oka,0,0,0,,Thế à.
Dialogue: 0,0:15:47.81,0:15:49.39,Default,Oka,0,0,0,,Đói bụng quá rồi.
Dialogue: 0,0:15:53.19,0:15:55.06,Default,Oka,0,0,0,,Chắc bố phải đi mua thứ gì đó về ăn thôi.
Dialogue: 0,0:15:55.40,0:15:56.90,Default,Oka,0,0,0,,Con có muốn ăn món gì không?
Dialogue: 0,0:15:57.73,0:15:59.78,Default,Oka,0,0,0,,Nếu không thì bố mua đại đấy nhé.
Dialogue: 0,0:16:06.07,0:16:08.70,Default,Iso,0,0,0,,Ủa, Okazaki-san đấy à. Lâu lắm rồi mới gặp cậu nhé.
Dialogue: 0,0:16:08.70,0:16:10.20,Default,Oka,0,0,0,,A, cháu chào bác ạ.
Dialogue: 0,0:16:10.50,0:16:14.58,Default,Iso,0,0,0,,Thích thế nhỉ, Ushio-chan. Hôm nay được đi mua sắm cùng bố cơ đấy à?
Dialogue: 0,0:16:15.71,0:16:17.21,Default,Oka,0,0,0,,Từ lúc nào mà...
Dialogue: 0,0:16:17.63,0:16:20.25,Default,Iso,0,0,0,,Hai bố con hiện tại đang ở riêng đúng không?
Dialogue: 0,0:16:20.25,0:16:26.18,Default,Iso,0,0,0,,Bác hiểu mà. Đàn ông một thân một mình gà trống nuôi con nhỏ thì vất vả khó khăn lắm.
Dialogue: 0,0:16:26.18,0:16:28.85,Default,Iso,0,0,0,,À, nhưng thỉnh thoảng cậu vẫn ghé qua thăm con bé chứ?
Dialogue: 0,0:16:28.85,0:16:31.22,Default,Oka,0,0,0,,Dạ vâng, thỉnh thoảng cháu có ghé ạ.
Dialogue: 0,0:16:31.52,0:16:34.60,Default,Iso,0,0,0,,Không được gặp bố thường xuyên chắc con bé thấy cô đơn và nhớ bố lắm đấy.
Dialogue: 0,0:16:34.60,0:16:37.86,Default,Iso,0,0,0,,Dù sao thì hai người cũng là máu mủ gia đình ruột thịt mà.
Dialogue: 0,0:16:37.86,0:16:39.73,Default,Oka,0,0,0,,D-Dạ vâng, bác nói đúng ạ.
Dialogue: 0,0:16:42.15,0:16:44.86,Default,Iso,0,0,0,,Tạm biệt Ushio-chan nhé.
Dialogue: 0,0:17:01.30,0:17:02.38,Default,Oka,0,0,0,,Đấy, ăn đi con.
Dialogue: 0,0:17:04.67,0:17:08.01,Default,Oka,0,0,0,,Sao thế? Con tự xúc ăn được cơ mà đúng không?
Dialogue: 0,0:17:09.93,0:17:11.68,Default,Ush,0,0,0,,Con mời cả nhà ăn cơm ạ.
Dialogue: 0,0:17:26.15,0:17:27.16,Default,Ush,0,0,0,,Cay đắng quá ạ.
Dialogue: 0,0:17:27.16,0:17:28.41,Default,Oka,0,0,0,,Cay đắng á?
Dialogue: 0,0:17:33.41,0:17:35.29,Default,Oka,0,0,0,,À, hạt tiêu đen.
Dialogue: 0,0:17:35.87,0:17:38.88,Default,Oka,0,0,0,,Bố xin lỗi, nhưng cơm chiên mà không có hạt tiêu thì đâu còn là cơm chiên nữa.
Dialogue: 0,0:17:38.88,0:17:40.08,Default,Oka,0,0,0,,Ráng chịu khó ăn chút đi con.
Dialogue: 0,0:17:40.08,0:17:41.17,Default,Ush,0,0,0,,Con không ăn đâu.
Dialogue: 0,0:17:41.50,0:17:45.80,Default,Oka,0,0,0,,Này, bà Sanae đã dặn con không được kén ăn rồi cơ mà?
Dialogue: 0,0:17:46.59,0:17:49.30,Default,Ush,0,0,0,,Con muốn ăn đồ của bà Sanae nấu cơ.
Dialogue: 0,0:17:50.39,0:17:51.72,Default,Oka,0,0,0,,Thế thì nhịn đi.
Dialogue: 0,0:18:03.23,0:18:05.15,Default,Oka,0,0,0,,Nếu không có tiêu thì con ăn được chứ gì?
Dialogue: 0,0:18:05.15,0:18:05.94,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:18:06.90,0:18:08.99,Default,Oka,0,0,0,,Nhưng mà ăn thế thì nhạt nhẽo dở tệ lắm.
Dialogue: 0,0:18:09.36,0:18:10.24,Default,Ush,0,0,0,,Cơm trắng.
Dialogue: 0,0:18:10.62,0:18:11.53,Default,Oka,0,0,0,,Cơm trắng á?
Dialogue: 0,0:18:11.53,0:18:13.24,Default,Oka,0,0,0,,Con chỉ ăn mỗi cơm trắng không thôi á?
Dialogue: 0,0:18:13.24,0:18:13.95,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:18:14.74,0:18:17.04,Default,Oka,0,0,0,,Được thôi, thế thì khỏe cho bố quá, nhưng mà...
Dialogue: 0,0:18:17.66,0:18:18.29,Default,Oka,0,0,0,,Của con đây.
Dialogue: 0,0:18:20.00,0:18:23.50,Default,Oka,0,0,0,,Ăn cơm trắng rồi lấy cơm chiên làm món ăn kèm sao trời?
Dialogue: 0,0:18:24.17,0:18:24.96,Default,Ush,0,0,0,,Không ăn cái này đâu.
Dialogue: 0,0:18:24.96,0:18:27.13,Default,Oka,0,0,0,,Này, cái đó để làm gì thế con?
Dialogue: 0,0:18:27.13,0:18:28.30,Default,Ush,0,0,0,,Chỉ cần cái này thôi ạ.
Dialogue: 0,0:18:29.63,0:18:33.51,Default,Oka,0,0,0,,Ăn không có thức ăn thế này người ta nhìn vào lại tưởng bố ngược đãi con thì chết.
Dialogue: 0,0:18:46.82,0:18:47.86,Default,Oka,0,0,0,,Gia vị rắc cơm hả...
Dialogue: 0,0:18:52.37,0:18:53.87,Default,Ush,0,0,0,,Con mời cả nhà ăn cơm ạ.
Dialogue: 0,0:19:05.09,0:19:07.30,Default,Oka,0,0,0,,Có lẽ hôm nay hai người họ không về đâu.
Dialogue: 0,0:19:28.36,0:19:29.65,Default,Oka,0,0,0,,Con dậy rồi à.
Dialogue: 0,0:19:30.99,0:19:32.16,Default,Ush,0,0,0,,Tè tè.
Dialogue: 0,0:19:32.86,0:19:33.91,Default,Oka,0,0,0,,Vào nhà vệ sinh đi con.
Dialogue: 0,0:19:44.71,0:19:46.17,Default,Ush,0,0,0,,Con tự đi được rồi đấy nhé.
Dialogue: 0,0:19:46.17,0:19:47.67,Default,Oka,0,0,0,,Dĩ nhiên là con phải tự đi rồi.
Dialogue: 0,0:19:54.05,0:19:55.18,Default,Guy,0,0,0,,Hôm nay tha hồ bơi thỏa thích nhé con trai!
Dialogue: 0,0:19:55.30,0:19:56.18,Default,Boy,0,0,0,,Dạ vâng bố!
Dialogue: 0,0:20:06.06,0:20:06.90,Default,Ush,0,0,0,,Dạ ừm...
Dialogue: 0,0:20:06.90,0:20:07.94,Default,Oka,0,0,0,,Gì thế con?
Dialogue: 0,0:20:07.94,0:20:09.44,Default,Ush,0,0,0,,Bậy bậy.
Dialogue: 0,0:20:09.44,0:20:10.69,Default,Oka,0,0,0,,Vào đi con.
Dialogue: 0,0:20:30.13,0:20:31.38,Default,Ush,0,0,0,,Con tự làm được rồi đấy nhé.
Dialogue: 0,0:20:31.38,0:20:33.55,Default,Oka,0,0,0,,Đừng có tự mãn khoe khoang thế chứ.
Dialogue: 0,0:20:33.55,0:20:35.51,Default,Oka,0,0,0,,Bố cũng tự đi được mà.
Dialogue: 0,0:20:43.68,0:20:45.73,Default,Oka,0,0,0,,Con có muốn đi du lịch không?
Dialogue: 0,0:20:45.73,0:20:47.02,Default,Ush,0,0,0,,Con có ạ.
Dialogue: 0,0:20:47.90,0:20:50.02,Default,Oka,0,0,0,,Thế hai bố con mình cùng đi nhé?
Dialogue: 0,0:20:51.57,0:20:52.53,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:20:53.15,0:20:55.36,Default,Oka,0,0,0,,Con chắc chứ? Chỉ có mỗi bố với con thôi đấy.
Dialogue: 0,0:20:55.91,0:20:58.20,Default,Oka,0,0,0,,Không có bà Sanae hay ông già đi cùng đâu.
Dialogue: 0,0:20:58.20,0:21:00.28,Default,Ush,0,0,0,,Nhưng mà hai người đâu có về đâu.
Dialogue: 0,0:21:01.08,0:21:04.33,Default,Oka,0,0,0,,Ừ. Họ đâu có về đâu nhỉ.
Dialogue: 0,0:21:04.33,0:21:05.04,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:21:07.17,0:21:08.79,Default,Oka,0,0,0,,Vậy thì hai bố con mình cùng đi thôi.
Dialogue: 0,0:21:09.63,0:21:10.29,Default,Ush,0,0,0,,Dạ vâng!
Dialogue: 0,0:21:20.18,0:21:21.47,Default,Oka,0,0,0,,Con mang đủ đồ đạc chưa đấy?
Dialogue: 0,0:21:21.47,0:21:22.18,Default,Ush,0,0,0,,Dạ rồi ạ.
Dialogue: 0,0:21:22.77,0:21:24.14,Default,Oka,0,0,0,,Khóa cửa cẩn thận hết chưa?
Dialogue: 0,0:21:24.14,0:21:25.06,Default,Ush,0,0,0,,Dạ rồi ạ.
Dialogue: 0,0:21:25.06,0:21:26.98,Default,Oka,0,0,0,,Được rồi. Đi thôi nào!
Dialogue: 0,0:21:26.98,0:21:28.98,Default,Ush,0,0,0,,Đi thôi ạ!
Dialogue: 0,0:21:37.07,0:21:41.53,Default,Oka,0,0,0,,Trước ngày hôm nay, mỗi lần tôi gặp Ushio đều luôn có mặt của Sanae-san hoặc ông già Akio ở bên.
Dialogue: 0,0:21:42.74,0:21:49.00,Default,Oka,0,0,0,,Đây chính là lần đầu tiên hai bố con tôi ở riêng bên nhau kể từ ngày con bé cất tiếng khóc chào đời.
Dialogue: 0,0:21:57.84,0:22:01.35,Default,Oka,0,0,0,,Chúng tôi sẽ đi đâu đây?
Dialogue: 0,0:22:04.89,0:22:08.81,Signs,,0,0,0,,{\fad(400,400)\4c&H000000&\shad3\bord0.75\3c&H000000&\blur0.5\pos(459,847.5)}Còn tiếp
