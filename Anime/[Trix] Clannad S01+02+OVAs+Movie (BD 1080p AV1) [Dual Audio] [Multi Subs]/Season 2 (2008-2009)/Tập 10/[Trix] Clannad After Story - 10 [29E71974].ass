Dialogue: 0,0:02:25.84,0:02:28.09,Default,Kyo,0,0,0,,Tạm biệt nhé. Bảo trọng đấy.
Dialogue: 0,0:02:29.09,0:02:30.59,Default,Ryo,0,0,0,,Cậu nhớ giữ gìn sức khỏe nhé.
Dialogue: 0,0:02:31.59,0:02:33.72,Default,Kot,0,0,0,,Mình rất mong sẽ lại được gặp lại mọi người.
Dialogue: 0,0:02:34.68,0:02:36.60,Default,Sun,0,0,0,,Dù sau này tao có nổi tiếng đi chăng nữa thì tao vẫn sẽ đi chơi với mày mà.
Dialogue: 0,0:02:37.35,0:02:39.10,Default,Kyo,0,0,0,,Hẹn gặp lại nhé.
Dialogue: 0,0:02:37.35,0:02:39.10,Default-alt,Kot,0,0,0,,Tạm biệt cậu.
Dialogue: 0,0:02:41.73,0:02:44.48,Default,Nag,0,0,0,,Chúc mừng cậu nhé, Tomoya-kun.
Dialogue: 0,0:03:04.67,0:03:06.46,Default,Oka,0,0,0,,À, ừ.
Dialogue: 0,0:03:07.42,0:03:11.09,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 10
Dialogue: 0,0:03:07.42,0:03:11.09,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Mùa của những khởi đầu
Dialogue: 0,0:03:11.55,0:03:15.89,Default,San,0,0,0,,Một lần nữa, chúc mừng cháu đã tốt nghiệp nhé.
Dialogue: 0,0:03:16.22,0:03:18.18,Default,San,0,0,0,,Kể từ hôm nay cháu đã chính thức là một thành viên của xã hội rồi đấy, Okazaki-san.
Dialogue: 0,0:03:18.18,0:03:20.73,Default,Oka,0,0,0,,Nói đúng hơn thì kể từ hôm nay cháu là một kẻ thất nghiệp chuyên nghiệp thì có ạ.
Dialogue: 0,0:03:20.73,0:03:23.31,Default,San,0,0,0,,Từ giờ cháu đã có dự định gì chưa?
Dialogue: 0,0:03:23.31,0:03:25.06,Default,Oka,0,0,0,,Dạ cũng chưa có gì cụ thể ạ.
Dialogue: 0,0:03:25.06,0:03:26.86,Default,Aki,0,0,0,,Mày đúng là hết nói nổi mà.
Dialogue: 0,0:03:28.03,0:03:30.90,Default,Aki,0,0,0,,Có muốn đến làm việc phụ giúp tiệm bánh nhà chú một thời gian không?
Dialogue: 0,0:03:31.57,0:03:37.95,Default,San,0,0,0,,Thế thì tốt quá rồi. Nếu có cháu phụ thì từ giờ cô có thể chuẩn bị cơm hộp bento cho Nagisa mỗi sáng rồi.
Dialogue: 0,0:03:37.95,0:03:42.54,Default,San,0,0,0,,Cô muốn làm từ lâu rồi mà buổi sáng bận bịu quá không tài nào dứt ra được.
Dialogue: 0,0:03:42.54,0:03:44.75,Default,Aki,0,0,0,,Lương lậu bèo bọt lắm đấy nhé.
Dialogue: 0,0:03:44.75,0:03:46.21,Default,Aki,0,0,0,,Liệu hồn mà chuẩn bị tinh thần đi.
Dialogue: 0,0:03:47.00,0:03:48.46,Default,Oka,0,0,0,,Cháu cảm ơn hai cô chú nhiều lắm ạ.
Dialogue: 0,0:03:49.25,0:03:51.76,Default,San,0,0,0,,Rất mong được làm việc cùng với Tomoya-san nhé.
Dialogue: 0,0:03:51.76,0:03:53.34,Default,Oka,0,0,0,,"Tomoya-san" ạ?
Dialogue: 0,0:03:53.34,0:03:55.14,Default,San,0,0,0,,Hãy để mẹ được gọi cháu bằng tên nhé.
Dialogue: 0,0:03:55.89,0:03:59.56,Default,San,0,0,0,,Bởi vì từ giờ chúng ta đã là người một nhà rồi mà.
Dialogue: 0,0:04:01.31,0:04:02.81,Default,Nag,0,0,0,,Thật vậy sao cậu?
Dialogue: 0,0:04:03.31,0:04:08.48,Default,Nag,0,0,0,,Nếu Tomoya-kun làm việc ở đây thì chắc chắn sẽ giúp đỡ được Bố và Mẹ nhiều lắm đấy.
Dialogue: 0,0:04:08.48,0:04:11.82,Default,Oka,0,0,0,,Ừ, nhưng tớ cũng không thể ăn nhờ ở đậu nhà cô chú mãi được.
Dialogue: 0,0:04:11.82,0:04:15.32,Default,Nag,0,0,0,,Thời tiết đang ấm dần lên rồi, và sức khỏe của tớ cũng đang tốt lên từng ngày.
Dialogue: 0,0:04:15.32,0:04:16.95,Default,Nag,0,0,0,,Tớ nghĩ mình sẽ có thể đến trường bình thường được.
Dialogue: 0,0:04:16.95,0:04:20.83,Default,Oka,0,0,0,,Nếu cậu được học cùng lớp với Tomoyo với Miyazawa thì tốt biết mấy.
Dialogue: 0,0:04:20.83,0:04:21.70,Default,Nag,0,0,0,,Vâng!
Dialogue: 0,0:04:26.21,0:04:28.79,Default,Oka,0,0,0,,Công việc bắt đầu từ lúc năm giờ sáng.
Dialogue: 0,0:04:31.59,0:04:34.93,Default,Oka,0,0,0,,Ông chú Akio khi ấy đã bắt tay vào nhào bột nướng bánh mì rồi.
Dialogue: 0,0:04:37.39,0:04:43.23,Default,Oka,0,0,0,,Cô Sanae vừa bày bánh lên kệ vừa tận tình chỉ bảo công việc cho tôi.
Dialogue: 0,0:04:50.52,0:04:51.57,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:04:52.82,0:04:54.32,Default,Oka,0,0,0,,Hôm nay là lễ khai giảng đúng không em?
Dialogue: 0,0:04:54.32,0:04:56.11,Default,Nag,0,0,0,,Vâng. Em đi học đây ạ.
Dialogue: 0,0:04:56.11,0:04:57.45,Default,Oka,0,0,0,,Ừ, đi đường cẩn thận nhé.
Dialogue: 0,0:04:57.45,0:04:58.20,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:05:01.66,0:05:03.70,Default,Oka,0,0,0,,Cố gắng lên nhé, Nagisa.
Dialogue: 0,0:05:06.00,0:05:09.50,Default,Oka,0,0,0,,Giờ cao điểm đông khách kéo dài cho đến chín giờ sáng.
Dialogue: 0,0:05:10.54,0:05:13.42,Default,Oka,0,0,0,,Doanh thu cả ngày của tiệm tập trung phần lớn vào khoảng thời gian này.
Dialogue: 0,0:05:17.80,0:05:20.60,Default,Oka,0,0,0,,Khi buổi chiều đến, lượng khách ghé mua bắt đầu thưa thớt dần.
Dialogue: 0,0:05:21.31,0:05:24.56,Default,Oka,0,0,0,,Cô Sanae mở lớp dạy học thêm cho trẻ em trong khu phố.
Dialogue: 0,0:05:25.10,0:05:28.23,Default,Oka,0,0,0,,Đó là nguồn thu nhập quan trọng của gia đình Furukawa.
Dialogue: 0,0:05:28.85,0:05:30.06,Default,Aki,0,0,0,,Bố về rồi đây.
Dialogue: 0,0:05:30.06,0:05:31.77,Default,Oka,0,0,0,,Chú vừa đi đâu về thế ạ?
Dialogue: 0,0:05:33.28,0:05:34.78,Default,Aki,0,0,0,,Lượn lờ một chút thôi.
Dialogue: 0,0:05:35.15,0:05:38.28,Default,Oka,0,0,0,,Ông chú thỉnh thoảng lại bỏ đi mất tăm.
Dialogue: 0,0:05:38.28,0:05:40.78,Default,Oka,0,0,0,,Chẳng ai biết chú ấy đi đâu và làm những gì cả.
Dialogue: 0,0:05:41.83,0:05:43.08,Default,Aki,0,0,0,,Buồn chán ghê nhỉ?
Dialogue: 0,0:05:43.08,0:05:44.33,Default,Oka,0,0,0,,Vâng.
Dialogue: 0,0:05:45.66,0:05:48.29,Default,Oka,0,0,0,,Không biết Nagisa ở trường có ổn không nữa.
Dialogue: 0,0:05:48.29,0:05:51.17,Default,Aki,0,0,0,,Có lo lắng thì cũng chẳng giải quyết được gì đâu.
Dialogue: 0,0:05:51.17,0:05:54.42,Default,Aki,0,0,0,,Hay là hai chú cháu mình chơi ném bóng bằng bánh mì của Sanae đi?
Dialogue: 0,0:05:54.42,0:05:56.55,Default,Oka,0,0,0,,Chú không được lấy thức ăn ra làm trò đùa đâu đấy.
Dialogue: 0,0:05:56.55,0:05:58.76,Default,Aki,0,0,0,,Mày khó tính quá đấy.
Dialogue: 0,0:05:58.76,0:06:00.55,Default,Aki,0,0,0,,Đi làm thì cũng phải biết tìm niềm vui chứ.
Dialogue: 0,0:06:00.55,0:06:02.30,Default,Nag,0,0,0,,Con đã về rồi ạ.
Dialogue: 0,0:06:02.72,0:06:03.47,Default,Aki,0,0,0,,Kính ch—
Dialogue: 0,0:06:03.47,0:06:06.06,Default,Aki,0,0,0,,Ồ, hóa ra là con gái cưng của bố.
Dialogue: 0,0:06:06.06,0:06:09.64,Default,Nag,0,0,0,,Con muốn được nhìn thấy lúc Tomoya-kun làm việc ạ.
Dialogue: 0,0:06:10.60,0:06:12.06,Default,Oka,0,0,0,,Hôm nay em vào lớp nào thế?
Dialogue: 0,0:06:12.69,0:06:14.86,Default,Nag,0,0,0,,Toàn là những bạn em chưa quen biết thôi ạ.
Dialogue: 0,0:06:14.86,0:06:19.57,Default,Nag,0,0,0,,Nhưng trông ai nấy đều có vẻ tốt bụng lắm,\Nnên em rất háo hức muốn được làm quen với mọi người.
Dialogue: 0,0:06:19.95,0:06:20.82,Default,Oka,0,0,0,,Vậy à.
Dialogue: 0,0:06:21.37,0:06:26.54,Default,Aki,0,0,0,,Được rồi. Giờ có thêm người rồi,\Nchúng ta cùng chơi ném tuyết bằng bánh mì của Sanae đi!
Dialogue: 0,0:06:27.41,0:06:27.91,Default,Nag,0,0,0,,Dạ thì...
Dialogue: 0,0:06:28.58,0:06:30.67,Default,Nag,0,0,0,,Mẹ đang đứng lù lù ngay sau lưng Bố kìa.
Dialogue: 0,0:06:31.12,0:06:32.96,Default,San,0,0,0,,Bánh mì của em làm ra...
Dialogue: 0,0:06:32.96,0:06:34.80,Default,San,0,0,0,,Bánh mì của em...
Dialogue: 0,0:06:34.80,0:06:38.38,Default,San,0,0,0,,...là để đem ra ném nhau đấy à?!
Dialogue: 0,0:06:38.38,0:06:40.63,Default,Aki,0,0,0,,Anh yêu món bánh mì này lắmmm!
Dialogue: 0,0:06:40.63,0:06:42.26,Default,Aki,0,0,0,,Sanaeee ơi!
Dialogue: 0,0:06:43.26,0:06:46.06,Default,Oka,0,0,0,,Tôi dần dà hiểu ra mọi chuyện.
Dialogue: 0,0:06:46.06,0:06:51.44,Default,Oka,0,0,0,,Chú Akio và cô Sanae luôn làm mọi cách để Nagisa luôn nở nụ cười rạng rỡ như thế này.
Dialogue: 0,0:06:52.44,0:06:53.52,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:06:54.44,0:06:56.44,Default,Nag,0,0,0,,Em đi học đây, Tomoya-kun.
Dialogue: 0,0:06:56.44,0:06:59.44,Default,Oka,0,0,0,,Hôm nay là buổi giới thiệu tuyển thành viên câu lạc bộ đúng không?
Dialogue: 0,0:06:59.44,0:07:02.95,Default,Nag,0,0,0,,Vâng. Em đã tự viết kịch bản và học thuộc lòng hết rồi.
Dialogue: 0,0:07:02.95,0:07:05.45,Default,Oka,0,0,0,,Vậy à. Cố gắng lên nhé em.
Dialogue: 0,0:07:05.78,0:07:06.58,Default,Oka,0,0,0,,Nagisa?
Dialogue: 0,0:07:07.04,0:07:09.75,Default,Oka,0,0,0,,Này. Sáng nay em đã ăn sáng chưa đấy?
Dialogue: 0,0:07:10.08,0:07:12.67,Default,Nag,0,0,0,,Em chén sạch sành sanh từ nãy rồi ạ.
Dialogue: 0,0:07:28.56,0:07:29.43,Default,Oka,0,0,0,,Nagisa!
Dialogue: 0,0:07:32.02,0:07:34.35,Default,Nag,0,0,0,,Tomoya-kun. Em về rồi này.
Dialogue: 0,0:07:34.35,0:07:37.86,Default,Oka,0,0,0,,Buổi giới thiệu câu lạc bộ thế nào rồi? Có thuận lợi không em?
Dialogue: 0,0:07:38.36,0:07:41.36,Default,Nag,0,0,0,,Dạ vâng. Phản ứng của mọi người tốt lắm ạ.
Dialogue: 0,0:07:42.57,0:07:46.24,Default,Oka,0,0,0,,Nagisa. Hãy nói thật cho anh nghe xem nào.
Dialogue: 0,0:07:47.70,0:07:51.62,Default,Nag,0,0,0,,Lúc đứng giới thiệu em nói run quá chẳng thành câu.
Dialogue: 0,0:07:52.12,0:07:57.13,Default,Nag,0,0,0,,Nhưng chị Tomoyo, chị Miyazawa với bạn Nishina đã vỗ tay cổ vũ cho em nhiệt tình lắm.
Dialogue: 0,0:07:57.13,0:07:59.17,Default,Oka,0,0,0,,Em đã tìm được giáo viên cố vấn chưa?
Dialogue: 0,0:07:59.17,0:08:04.13,Default,Nag,0,0,0,,Thầy Minoshima phụ trách đội điền kinh\Nsẽ kiêm luôn cố vấn cho câu lạc bộ kịch của tụi em nữa.
Dialogue: 0,0:08:04.13,0:08:05.47,Default,Oka,0,0,0,,À, ông thầy đó hả.
Dialogue: 0,0:08:06.30,0:08:13.35,Default,Nag,0,0,0,,{\fscx105}Nhưng nếu đến thứ tư tuần sau mà em không tuyển thêm được hai thành viên nữa, thì Câu lạc bộ Kịch sẽ tự động bị giải thể.
Dialogue: 0,0:08:13.35,0:08:15.65,Default,Nag,0,0,0,,Em phải cố gắng hết sức để chuyện đó không xảy ra.
Dialogue: 0,0:08:15.65,0:08:19.52,Default,Oka,0,0,0,,Thế còn không khí trong lớp thì sao?\NEm thấy có kết bạn được với ai không?
Dialogue: 0,0:08:20.94,0:08:23.65,Default,Oka,0,0,0,,Mọi người có biết chuyện em bị đúp lớp hai lần không?
Dialogue: 0,0:08:23.99,0:08:25.53,Default,Nag,0,0,0,,Ai cũng biết cả rồi ạ.
Dialogue: 0,0:08:25.91,0:08:29.66,Default,Nag,0,0,0,,Chính vì thế trông ai cũng có vẻ ngại ngùng khi bắt chuyện với em.
Dialogue: 0,0:08:30.29,0:08:36.00,Default,Oka,0,0,0,,Tính em hòa đồng dễ gần mà, nên anh nghĩ em chủ động bắt chuyện thì chẳng ai khó chịu đâu.
Dialogue: 0,0:08:38.00,0:08:39.42,Default,Nag,0,0,0,,Em cũng mong là vậy.
Dialogue: 0,0:08:40.17,0:08:42.67,Default,Nag,0,0,0,,Em muốn được tiếp tục duy trì Câu lạc bộ Kịch.
Dialogue: 0,0:08:44.67,0:08:45.43,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:08:46.01,0:08:49.85,Default,Nag,0,0,0,,Em muốn được cùng anh chia sẻ về những điều vui vẻ.
Dialogue: 0,0:08:49.85,0:08:54.35,Default,Nag,0,0,0,,Muốn được mỉm cười kể cho anh nghe những chuyện đã xảy ra ở trường mỗi ngày.
Dialogue: 0,0:08:55.35,0:08:56.27,Default,Nag,0,0,0,,Tomoya-kun?
Dialogue: 0,0:08:58.52,0:09:01.73,Default,Oka,0,0,0,,Ừ! Chúng mình sẽ cùng nhau nói thật nhiều chuyện vui nhé.
Dialogue: 0,0:09:02.19,0:09:02.86,Default,Nag,0,0,0,,Vâng ạ!
Dialogue: 0,0:09:13.16,0:09:19.17,Default,Oka,0,0,0,,Nhưng rồi tôi chẳng bao giờ được nghe Nagisa kể bất kỳ câu chuyện vui vẻ nào ở trường nữa.
Dialogue: 0,0:09:13.16,0:09:14.91,Signs,,0,0,0,,Chiêu mộ thành viên
Dialogue: 0,0:09:13.16,0:09:14.91,Signs,,0,0,0,,Câu lạc bộ Kịch nghệ
Dialogue: 0,0:09:13.16,0:09:14.91,Signs,,0,0,0,,Phòng sinh hoạt: Tòa nhà cũ tầng 3 cuối hành lang phía Đông
Dialogue: 0,0:09:13.16,0:09:14.91,Signs,,0,0,0,,Chủ nhiệm: Học sinh năm ba Furukawa
Dialogue: 0,0:09:20.00,0:09:23.80,Default,Oka,0,0,0,,Có lẽ câu nói "Cố lên nhé" của tôi vô tình chỉ tạo thêm áp lực nặng nề cho em.
Dialogue: 0,0:09:24.63,0:09:26.59,Default,Oka,0,0,0,,Ý nghĩ ấy chợt thoáng qua trong tâm trí tôi...
Dialogue: 0,0:09:27.18,0:09:28.26,Default,Oka,0,0,0,,...rằng có khi chính tôi là người đang dồn ép em.
Dialogue: 0,0:09:29.26,0:09:33.43,Default,Oka,0,0,0,,Thế nhưng Nagisa chưa từng một lần đi trễ\Ncũng chưa từng cúp học một buổi nào.
Dialogue: 0,0:09:34.27,0:09:35.64,Default,Oka,0,0,0,,Em vẫn kiên trì nỗ lực hết mình mỗi ngày.
Dialogue: 0,0:09:42.82,0:09:47.90,Default,Oka,0,0,0,,Và cuối cùng, chẳng có lấy một người nào nộp đơn gia nhập câu lạc bộ cả.
Dialogue: 0,0:10:09.22,0:10:10.26,Default,Oka,0,0,0,,Anh Yoshino.
Dialogue: 0,0:10:11.09,0:10:12.60,Default,Yos,0,0,0,,Chào cậu. Lâu lắm rồi không gặp nhỉ.
Dialogue: 0,0:10:12.60,0:10:14.35,Default,Oka,0,0,0,,Trông anh bận rộn quá chừng.
Dialogue: 0,0:10:14.35,0:10:16.85,Default,Yos,0,0,0,,Ừ. Bên anh đang thiếu người trầm trọng.
Dialogue: 0,0:10:16.85,0:10:18.35,Default,Yos,0,0,0,,Dù sao thì nghề này cũng là công việc chân tay vất vả mà.
Dialogue: 0,0:10:20.60,0:10:22.86,Default,Yos,0,0,0,,À phải rồi. Chúc mừng cậu đã tốt nghiệp nhé.
Dialogue: 0,0:10:24.27,0:10:25.86,Default,Oka,0,0,0,,Dạ vâng. Cảm ơn anh.
Dialogue: 0,0:10:25.86,0:10:27.61,Default,Yos,0,0,0,,Hiện giờ cậu đang làm gì rồi?
Dialogue: 0,0:10:27.61,0:10:30.36,Default,Oka,0,0,0,,Em đang phụ việc lặt vặt ở tiệm bánh thôi ạ.
Dialogue: 0,0:10:30.36,0:10:32.24,Default,Yos,0,0,0,,Thỉnh thoảng ghé qua nhà anh chơi nhé.
Dialogue: 0,0:10:34.08,0:10:37.25,Default,Yos,0,0,0,,Dù ban ngày anh đi làm suốt, còn Kouko thì phải vào bệnh viện túc trực.
Dialogue: 0,0:10:37.25,0:10:41.50,Default,Oka,0,0,0,,Em gái chị Kouko-san vẫn phải nằm viện suốt từ đó đến giờ ạ?
Dialogue: 0,0:10:41.50,0:10:45.21,Default,Yos,0,0,0,,Ừ. Nhưng cô ấy luôn tin rằng con bé nhất định sẽ tỉnh lại và khỏe mạnh.
Dialogue: 0,0:10:45.21,0:10:47.01,Default,Yos,0,0,0,,Thế nên anh cũng sẽ không bao giờ đánh mất niềm hy vọng.
Dialogue: 0,0:10:47.55,0:10:49.22,Default,Yos,0,0,0,,Xin lỗi nhé, anh vẫn còn việc phải làm tiếp đây.
Dialogue: 0,0:10:49.22,0:10:50.63,Default,Oka,0,0,0,,Dạ. Làm phiền anh quá.
Dialogue: 0,0:10:50.63,0:10:51.76,Default,Oka,0,0,0,,Hẹn gặp lại anh sau nhé.
Dialogue: 0,0:10:53.76,0:10:56.77,Note,,0,0,0,,Bảng tin: Căn hộ cho thuê
Dialogue: 0,0:11:03.27,0:11:05.94,Default,Oka,0,0,0,,Dù ở xa ga tàu mà giá thuê vẫn đắt đỏ quá nhỉ.
Dialogue: 0,0:11:06.52,0:11:07.69,Default,Guy,0,0,0,,Thật đấy à?
Dialogue: 0,0:11:16.66,0:11:19.29,Default,Girl,0,0,0,,Tao cũng muốn để tóc dài nữa.
Dialogue: 0,0:11:20.96,0:11:22.21,Default,Kyo,0,0,0,,Tomoya!
Dialogue: 0,0:11:23.92,0:11:25.92,Default,Ryo,0,0,0,,Lâu lắm không gặp, Okazaki-kun.
Dialogue: 0,0:11:27.21,0:11:27.80,Default,Oka,0,0,0,,Chào hai cậu.
Dialogue: 0,0:11:28.38,0:11:30.80,Default,Oka,0,0,0,,Lâu lắm rồi mới gặp. Hai cậu đang trên đường đi học về đấy à?
Dialogue: 0,0:11:30.80,0:11:31.42,Default,Ryo,0,0,0,,Vâng ạ.
Dialogue: 0,0:11:31.93,0:11:35.39,Default,Kyo,0,0,0,,Từ hôm tốt nghiệp đến giờ mới gặp lại. Nagisa đã khỏe hơn chưa?
Dialogue: 0,0:11:35.39,0:11:37.64,Default,Oka,0,0,0,,Ừ. Cậu ấy đi học đều đặn mỗi ngày rồi.
Dialogue: 0,0:11:37.64,0:11:38.68,Default,Ryo,0,0,0,,May quá.
Dialogue: 0,0:11:38.68,0:11:44.77,Default,Kyo,0,0,0,,Cùng ở trong một thị trấn mà bọn tớ cũng muốn ghé qua thăm, cơ mà dạo này bận quá không dứt ra được.
Dialogue: 0,0:11:44.77,0:11:48.94,Default,Ryo,0,0,0,,Bọn tớ lúc nào cũng nhắc muốn gặp lại mọi người đấy.
Dialogue: 0,0:11:48.94,0:11:51.44,Default,Oka,0,0,0,,Việc học bận rộn đến thế cơ à?
Dialogue: 0,0:11:51.44,0:11:54.74,Default,Kyo,0,0,0,,Thế còn cậu thì sao? Vẫn là một gã ăn bám thất nghiệp đấy à?
Dialogue: 0,0:11:55.28,0:11:57.33,Default,Ryo,0,0,0,,Chị hai ơi. Dùng từ "ăn bám" thì hơi...
Dialogue: 0,0:11:57.33,0:11:58.49,Default,Oka,0,0,0,,Cậu nói chuẩn không cần chỉnh luôn rồi đấy.
Dialogue: 0,0:11:58.49,0:12:01.08,Default,Oka,0,0,0,,Tớ biết mình không thể cứ mãi như thế này được.
Dialogue: 0,0:12:01.08,0:12:04.71,Default,Kyo,0,0,0,,Cậu đừng có tỏ ra người lớn chín chắn thế chứ, làm tớ bối rối đấy.
Dialogue: 0,0:12:05.17,0:12:09.59,Default,Kyo,0,0,0,,Hãy chỉnh đốn lại bản thân đi. Cứ bắt tay vào hành động ắt sẽ có kết quả thôi.
Dialogue: 0,0:12:09.59,0:12:14.93,Default,Oka,0,0,0,,Ừ. Tớ đang xem có căn phòng trọ nào giá rẻ không, cơ mà kiếm không hề dễ chút nào.
Dialogue: 0,0:12:15.72,0:12:20.27,Default,Ryo,0,0,0,,Anh trai của bạn tớ sắp chuyển khỏi phòng trọ của anh ấy đấy.
Dialogue: 0,0:12:20.27,0:12:25.23,Default,Ryo,0,0,0,,Chỗ đó hơi cũ kỹ một chút, nhưng nghe bảo tiền thuê rẻ lắm.
Dialogue: 0,0:12:26.48,0:12:29.23,Default,Ryo,0,0,0,,Tớ xin lỗi. Chuyện này đâu đến lượt tớ xen vào đâu nhỉ...
Dialogue: 0,0:12:30.19,0:12:33.36,Default,Oka,0,0,0,,Không đâu! Kể thêm cho tớ nghe về chỗ đó đi!
Dialogue: 0,0:12:36.07,0:12:37.20,Default,Oka,0,0,0,,Anh Yoshino ơi!
Dialogue: 0,0:12:42.04,0:12:42.62,Default,Oka,0,0,0,,Dạ!
Dialogue: 0,0:12:46.54,0:12:47.50,Default,Oka,0,0,0,,Anh Yoshino.
Dialogue: 0,0:12:48.17,0:12:48.96,Default,Oka,0,0,0,,Anh có thể...
Dialogue: 0,0:12:49.25,0:12:50.55,Default,Oka,0,0,0,,...cho em...
Dialogue: 0,0:12:51.67,0:12:53.26,Default,Oka,0,0,0,,...được làm việc cùng với anh không ạ?!
Dialogue: 0,0:12:54.09,0:12:55.22,Default,Oka,0,0,0,,Xin anh đấy ạ!
Dialogue: 0,0:13:00.72,0:13:03.10,Default,Aki,0,0,0,,Chú hiểu rồi. Vậy là mày quyết định dọn ra ngoài tự lập à.
Dialogue: 0,0:13:03.10,0:13:04.56,Default,San,0,0,0,,Cô rất mừng vì sự lựa chọn chín chắn của cháu.
Dialogue: 0,0:13:04.56,0:13:08.27,Default,Oka,0,0,0,,Cháu cảm ơn hai cô chú. Suốt thời gian qua cháu đã được nuông chiều bao bọc nhiều quá rồi.
Dialogue: 0,0:13:08.27,0:13:10.06,Default,Aki,0,0,0,,Mày có tiền dằn túi không đấy?
Dialogue: 0,0:13:10.06,0:13:13.57,Default,Oka,0,0,0,,Dạ có ạ. Tiền công cô chú trả cho cháu cháu hầu như chưa đụng tới đồng nào.
Dialogue: 0,0:13:14.03,0:13:16.15,Default,Aki,0,0,0,,Được rồi, thế thì chú không nói thêm gì nữa.
Dialogue: 0,0:13:16.15,0:13:17.57,Default,Aki,0,0,0,,Cứ làm những gì mày thích đi.
Dialogue: 0,0:13:20.41,0:13:23.54,Default,Oka,0,0,0,,Cháu cảm ơn cô chú đã cưu mang và chăm sóc cháu suốt thời gian qua ạ.
Dialogue: 0,0:13:33.00,0:13:35.09,Default,Oka,0,0,0,,Chú không phải trông coi tiệm bánh à?
Dialogue: 0,0:13:36.67,0:13:40.80,Default,Aki,0,0,0,,Tầm này làm quái gì có ma nào đến mua.
Dialogue: 0,0:13:41.60,0:13:46.23,Default,Aki,0,0,0,,Nhìn bản mặt mày trông như đang thèm chơi bóng với chú,\Nnên bất đắc dĩ chú mới ra đây thôi đấy.
Dialogue: 0,0:13:46.23,0:13:47.56,Default,Aki,0,0,0,,Mày liệu mà cảm ơn chú đi.
Dialogue: 0,0:13:48.39,0:13:51.90,Default,Oka,0,0,0,,Cháu mới là người đang chơi với chú thì có.
Dialogue: 0,0:13:53.44,0:13:54.44,Default,Aki,0,0,0,,Thằng ranh con.
Dialogue: 0,0:13:54.44,0:13:55.44,Default,Oka,0,0,0,,Gì thế ạ?
Dialogue: 0,0:13:55.82,0:13:57.99,Default,Aki,0,0,0,,Hễ gặp bất kỳ khó khăn trắc trở gì thì cứ tìm đến chú.
Dialogue: 0,0:13:59.61,0:14:02.24,Default,Aki,0,0,0,,Bước chân ra ngoài xã hội rồi sẽ có muôn vàn sóng gió xảy ra.
Dialogue: 0,0:14:02.24,0:14:04.62,Default,Aki,0,0,0,,Cứ mở lời nhờ giúp đỡ bất cứ khi nào mày thấy cần.
Dialogue: 0,0:14:05.83,0:14:08.67,Default,Oka,0,0,0,,Cháu cảm ơn chú. Chỉ cần nghe những lời đó thôi là cháu mãn nguyện lắm rồi.
Dialogue: 0,0:14:13.75,0:14:15.38,Default,Aki,0,0,0,,Ăn nói nghe ra dáng đàn ông phết nhỉ.
Dialogue: 0,0:14:17.97,0:14:18.63,Default,Oka,0,0,0,,Sau này...
Dialogue: 0,0:14:19.76,0:14:21.80,Default,Oka,0,0,0,,Sau này cháu có thể dẫn Nagisa theo cùng cháu được không ạ?
Dialogue: 0,0:14:42.28,0:14:43.99,Default,Aki,0,0,0,,Con bé mới là người đưa ra quyết định.
Dialogue: 0,0:14:43.99,0:14:45.91,Default,Aki,0,0,0,,Nó đâu còn là một đứa trẻ con nữa.
Dialogue: 0,0:14:53.46,0:14:54.29,Default,Aki,0,0,0,,Được rồi.
Dialogue: 0,0:14:55.50,0:14:56.96,Default,Aki,0,0,0,,Ném quả bóng đỉnh nhất của mày ra đây xem nào.
Dialogue: 0,0:14:58.34,0:15:02.72,Default,Aki,0,0,0,,Ở cái khu này người ta gọi chú là Babe Ruth của làng bánh mì đấy nhé.
Dialogue: 0,0:15:04.72,0:15:07.22,Default,Aki,0,0,0,,Ném đẹp lắm!
Dialogue: 0,0:15:14.65,0:15:16.02,Default,Oka,0,0,0,,Chú lại làm vỡ cửa kính nhà người ta nữa rồi.
Dialogue: 0,0:15:16.02,0:15:17.73,Default,Aki,0,0,0,,Mau ra xin lỗi người ta đi mày!
Dialogue: 0,0:15:17.73,0:15:19.24,Default,Aki,0,0,0,,Chú về làm việc đây!
Dialogue: 0,0:15:19.24,0:15:20.86,Default,Oka,0,0,0,,Đúng là đồ chơi bẩn mà!
Dialogue: 0,0:15:32.62,0:15:34.25,Default,Oka,0,0,0,,Phòng nhỏ xíu xiu thật đấy nhỉ.
Dialogue: 0,0:15:34.25,0:15:35.67,Default,Oka,0,0,0,,Lại còn cũ kỹ xuống cấp nữa chứ.
Dialogue: 0,0:15:35.67,0:15:37.21,Default,Oka,0,0,0,,Trông cứ như có chuột bọ làm tổ ở đây vậy.
Dialogue: 0,0:15:37.21,0:15:39.76,Default,Nag,0,0,0,,Không đâu, đây là một căn phòng rất tuyệt mà.
Dialogue: 0,0:15:41.34,0:15:43.51,Default,Oka,0,0,0,,Mở cửa sổ ra gió lùa vào mát rượi luôn này.
Dialogue: 0,0:15:59.61,0:16:01.61,Default,Aki,0,0,0,,Bày biện đồ đạc vào là trông ra dáng có người ở ngay rồi đấy.
Dialogue: 0,0:16:02.70,0:16:05.70,Default,Aki,0,0,0,,Chú đi trả xe tải rồi về thẳng nhà luôn đây.
Dialogue: 0,0:16:05.70,0:16:09.12,Default,Oka,0,0,0,,Cháu xin lỗi vì đã khuân cả bàn ghế với bát đĩa nhà chú đi thế này.
Dialogue: 0,0:16:09.12,0:16:12.04,Default,Aki,0,0,0,,Không sao đâu. Dù sao ở nhà cũng chẳng ai dùng tới.
Dialogue: 0,0:16:12.33,0:16:15.17,Default,Aki,0,0,0,,Đừng có ở lại chơi muộn quá đấy nhé Nagisa?
Dialogue: 0,0:16:15.58,0:16:16.71,Default,Nag,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:16:17.17,0:16:18.17,Default,Aki,0,0,0,,Chú về đây.
Dialogue: 0,0:16:18.17,0:16:19.63,Default,Nag,0,0,0,,Anh vất vả rồi ạ.
Dialogue: 0,0:16:26.34,0:16:27.35,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:16:29.64,0:16:30.18,Default,Nag,0,0,0,,Dạ...
Dialogue: 0,0:16:30.77,0:16:32.73,Default,Nag,0,0,0,,Để em đi pha trà nhé.
Dialogue: 0,0:16:32.73,0:16:35.06,Default,Nag,0,0,0,,Anh cứ ngồi nghỉ ngơi đợi một lát đi.
Dialogue: 0,0:16:36.15,0:16:41.28,Default-alt,Nag,0,0,0,,{\an8}Dango, dango, dango, dango...
Dialogue: 0,0:16:41.28,0:16:44.53,Default-alt,Nag,0,0,0,,{\an8}Đại gia đình Dango...
Dialogue: 0,0:16:43.57,0:16:47.24,Default,Oka,0,0,0,,Không biết liệu sẽ có một ngày hai chúng tôi được sống chung một nhà như thế này không nhỉ.
Dialogue: 0,0:16:45.45,0:16:46.70,Default-alt,Nag,0,0,0,,{\an8}Dango...
Dialogue: 0,0:16:47.24,0:16:49.24,Default,Nag,0,0,0,,Anh vừa nói gì thế Tomoya-kun?
Dialogue: 0,0:16:49.24,0:16:50.45,Default,Oka,0,0,0,,Không có gì đâu!
Dialogue: 0,0:16:54.21,0:16:56.21,Default,Oka,0,0,0,,Mai gặp lại em nhé.
Dialogue: 0,0:16:56.21,0:16:56.71,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:16:57.46,0:16:58.21,Default,Nag,0,0,0,,À thì...
Dialogue: 0,0:16:59.25,0:17:03.09,Default,Nag,0,0,0,,Anh đã báo cho Bác trai biết chuyện anh chuyển nhà ra đây chưa?
Dialogue: 0,0:17:03.59,0:17:06.43,Default,Nag,0,0,0,,Anh nên cho Bác biết chỗ ở của anh,
Dialogue: 0,0:17:06.43,0:17:08.34,Default,Nag,0,0,0,,để phòng lúc có chuyện gì bất trắc xảy ra.
Dialogue: 0,0:17:09.14,0:17:11.22,Default,Oka,0,0,0,,Em nói phải. Anh sẽ báo cho ông ấy biết.
Dialogue: 0,0:17:13.06,0:17:16.48,Default,Nag,0,0,0,,Vâng, chúc anh ngủ ngon nhé Tomoya-kun.
Dialogue: 0,0:17:16.48,0:17:17.94,Default,Oka,0,0,0,,Ừ, chúc em ngủ ngon.
Dialogue: 0,0:17:30.49,0:17:32.62,Default,Oka,0,0,0,,Cuộc sống tự lập của tôi đã bắt đầu như thế đấy.
Dialogue: 0,0:17:34.25,0:17:36.62,Default,Oka,0,0,0,,Giờ đây tôi sẽ không thể dựa dẫm vào bất kỳ ai được nữa.
Dialogue: 0,0:17:41.13,0:17:43.92,Default,Oka,0,0,0,,Đêm đầu tiên ấy, giấc ngủ đến với tôi thật chẳng hề dễ dàng.
Dialogue: 0,0:17:46.59,0:17:47.68,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:17:47.97,0:17:49.64,Default,Nag,0,0,0,,Dậy đi anh ơi.
Dialogue: 0,0:17:50.26,0:17:51.51,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:17:53.64,0:17:55.64,Default,Nag,0,0,0,,Hôm nay là ngày đầu tiên anh đi làm đấy.
Dialogue: 0,0:17:55.64,0:17:56.98,Default,Nag,0,0,0,,Anh sẽ bị muộn giờ mất.
Dialogue: 0,0:18:06.19,0:18:07.28,Default,Oka,0,0,0,,Ngon tuyệt.
Dialogue: 0,0:18:07.86,0:18:10.62,Default,Nag,0,0,0,,Tối em cũng sẽ qua nấu bữa tối cho anh nhé, nếu anh muốn.
Dialogue: 0,0:18:10.62,0:18:12.95,Default,Oka,0,0,0,,Anh chưa biết khi nào mới đi làm về nữa.
Dialogue: 0,0:18:12.95,0:18:14.79,Default,Nag,0,0,0,,Không sao đâu ạ. Em sẽ đợi anh.
Dialogue: 0,0:18:19.25,0:18:20.63,Default,Oak,0,0,0,,Không sao đâu mà.
Dialogue: 0,0:18:20.83,0:18:22.38,Default,Nag,0,0,0,,Em sẽ đợi anh về.
Dialogue: 0,0:18:31.39,0:18:34.39,Signs,,0,0,0,,Thiết kế và thi công hệ thống điện
Dialogue: 0,0:18:31.39,0:18:34.39,Signs,,0,0,0,,Công ty Điện lực Hikarizaka
Dialogue: 0,0:18:39.19,0:18:40.69,Default,Oka,0,0,0,,Cháu chào các chú buổi sáng ạ!
Dialogue: 0,0:18:42.69,0:18:44.32,Default,All,0,0,0,,Chào buổi sáng cháu.
Dialogue: 0,0:18:44.32,0:18:46.61,Default,Oka,0,0,0,,Dạ, ừm...
Dialogue: 0,0:18:46.61,0:18:47.28,Default,Yos,0,0,0,,Đến rồi đấy à.
Dialogue: 0,0:18:48.44,0:18:49.53,Default,Yos,0,0,0,,Mau thay bộ đồng phục này vào đi.
Dialogue: 0,0:18:50.91,0:18:52.12,Default,Man,0,0,0,,Chào buổi sáng mọi người.
Dialogue: 0,0:18:52.12,0:18:54.99,Default,Man,0,0,0,,Yoshino-kun, đây là cậu nhóc hôm trước cậu bảo sẽ đến làm từ hôm nay đấy à?
Dialogue: 0,0:18:54.99,0:18:55.91,Default,Yos,0,0,0,,Dạ vâng.
Dialogue: 0,0:18:56.20,0:18:58.08,Default,Yos,0,0,0,,Đây là giám đốc. Mau tự giới thiệu đi em.
Dialogue: 0,0:18:58.45,0:18:59.91,Default,Oka,0,0,0,,Cháu tên là Okazaki Tomoya ạ.
Dialogue: 0,0:19:00.50,0:19:02.13,Default,Oka,0,0,0,,Rất mong được các chú chỉ bảo giúp đỡ.
Dialogue: 0,0:19:02.13,0:19:06.67,Default,Man,0,0,0,,Mấy ngày đầu tiên có thể sẽ vất vả gian nan đấy,\Nnhưng cứ kiên trì cố gắng rồi sẽ quen tay ngay thôi.
Dialogue: 0,0:19:06.67,0:19:08.80,Default,Man,0,0,0,,Quan trọng nhất là phải chú ý an toàn, đừng để bị thương tích đấy nhé.
Dialogue: 0,0:19:08.80,0:19:10.55,Default,Oka,0,0,0,,Dạ vâng. Cháu sẽ cố gắng hết sức ạ.
Dialogue: 0,0:19:12.80,0:19:14.14,Default,Yos,0,0,0,,Trông cậu khác hẳn ngày trước rồi đấy.
Dialogue: 0,0:19:14.51,0:19:15.35,Default,Oka,0,0,0,,Dạ?
Dialogue: 0,0:19:15.35,0:19:18.31,Default,Yos,0,0,0,,Trông cậu như một người hoàn toàn khác so với lần đầu anh gặp vào năm ngoái.
Dialogue: 0,0:19:18.81,0:19:21.35,Default,Yos,0,0,0,,Hồi đó trông cậu đúng nghĩa chỉ là một đứa trẻ ranh.
Dialogue: 0,0:19:21.35,0:19:23.06,Default,Oka,0,0,0,,Giờ trông em đã ra dáng người lớn chưa ạ?
Dialogue: 0,0:19:23.06,0:19:26.98,Default,Yos,0,0,0,,Chưa. Trông cậu giống một đứa trẻ đang trăn trở vật lộn để trở thành người lớn hơn.
Dialogue: 0,0:19:27.61,0:19:29.74,Default,Oka,0,0,0,,Hóa ra em vẫn chỉ là một đứa trẻ con thôi ạ.
Dialogue: 0,0:19:30.36,0:19:31.90,Default,Yos,0,0,0,,Đó là hai chuyện hoàn toàn khác nhau.
Dialogue: 0,0:19:32.32,0:19:33.53,Default,Oka,0,0,0,,Khác nhau thế nào ạ?
Dialogue: 0,0:19:33.53,0:19:35.12,Default,Yos,0,0,0,,Khác nhau ở mức độ nghiêm túc của cậu đối với cuộc đời.
Dialogue: 0,0:19:37.49,0:19:40.37,Default,Yos,0,0,0,,Dù sao đi nữa, đừng có bỏ cuộc chỉ sau một ngày đi làm đấy nhé.
Dialogue: 0,0:19:40.37,0:19:42.12,Default,Yos,0,0,0,,Cậu mà làm thế là anh sẽ thất vọng lắm đấy.
Dialogue: 0,0:19:42.71,0:19:45.84,Default,Oka,0,0,0,,Xin anh đừng lo. Em đang đánh cược cả mạng sống vào công việc này mà.
Dialogue: 0,0:19:55.22,0:19:57.35,Default,Yos,0,0,0,,Dựng thang tựa chắc chắn vào cột điện đi.
Dialogue: 0,0:19:57.35,0:19:58.35,Default,Oka,0,0,0,,Dạ vâng!
Dialogue: 0,0:19:58.35,0:20:00.31,Default,Yos,0,0,0,,Và nhớ đội mũ bảo hộ cho đàng hoàng vào.
Dialogue: 0,0:20:00.98,0:20:01.85,Default,Yos,0,0,0,,Trả lời xem nào.
Dialogue: 0,0:20:02.31,0:20:03.10,Default,Oka,0,0,0,,Dạ rõ!
Dialogue: 0,0:20:03.94,0:20:06.31,Default,Yos,0,0,0,,Đừng dùng sức hai cánh tay để chống đỡ toàn bộ cơ thể.
Dialogue: 0,0:20:07.32,0:20:10.28,Default,Yos,0,0,0,,Hãy ngả người dựa vào đai an toàn. Làm thế sẽ an toàn hơn nhiều.
Dialogue: 0,0:20:10.28,0:20:12.74,Default,Oka,0,0,0,,D-Dù anh nói thế thì...
Dialogue: 0,0:20:12.74,0:20:14.32,Default,Yos,0,0,0,,Cứ thả lỏng người mà dựa vào nó.
Dialogue: 0,0:20:14.32,0:20:16.62,Default,Yos,0,0,0,,Nếu phung phí sức lực vô ích thì cậu sẽ không trụ nổi hết ngày hôm nay đâu.
Dialogue: 0,0:20:16.62,0:20:18.83,Default,Yos,0,0,0,,Siết bu-lông theo đường chéo đối diện nhau.
Dialogue: 0,0:20:18.83,0:20:19.79,Default,Yos,0,0,0,,Đó là nguyên tắc bắt buộc.
Dialogue: 0,0:20:19.79,0:20:22.54,Default,Yos,0,0,0,,Làm xong xuôi phải kiểm tra lại toàn bộ một lượt. Nhớ kỹ lấy đấy.
Dialogue: 0,0:20:22.87,0:20:23.37,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:20:23.37,0:20:26.29,Default,Yos,0,0,0,,Được rồi. Cậu thử siết chiếc bu-lông này xem nào.
Dialogue: 0,0:20:26.29,0:20:26.88,Default,Oka,0,0,0,,Dạ vâng.
Dialogue: 0,0:20:31.38,0:20:32.76,Default,Yos,0,0,0,,Thằng ngu này!
Dialogue: 0,0:20:32.76,0:20:33.88,Default,Oka,0,0,0,,Em xin lỗi anh!
Dialogue: 0,0:20:33.88,0:20:35.89,Default,Yos,0,0,0,,Trong công việc này tuyệt đối không được phép mắc sai lầm!
Dialogue: 0,0:20:36.84,0:20:39.10,Default,Yos,0,0,0,,Nếu lỡ may có người đang đi bộ ở phía dưới thì hậu quả sẽ ra sao hả?!
Dialogue: 0,0:20:39.56,0:20:42.35,Default,Yos,0,0,0,,Nếu người đi bên dưới là người quan trọng nhất của cậu thì cậu tính thế nào?!
Dialogue: 0,0:20:42.89,0:20:45.23,Default,Yos,0,0,0,,Chính vì thế trong mọi việc đều phải cẩn trọng tỉ mỉ.
Dialogue: 0,0:20:45.23,0:20:47.90,Default,Yos,0,0,0,,Phải làm thật gọn gàng, chu đáo và bằng tất cả tấm lòng.
Dialogue: 0,0:20:47.90,0:20:48.65,Default,Oka,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:20:49.48,0:20:51.11,Default,Oka,0,0,0,,Ui da...
Dialogue: 0,0:20:51.98,0:20:52.99,Default,Yos,0,0,0,,Vất vả lắm đúng không?
Dialogue: 0,0:20:52.99,0:20:55.11,Default,Oka,0,0,0,,Cả người em đau ê ẩm hết rồi anh ạ.
Dialogue: 0,0:20:55.11,0:20:57.82,Default,Oka,0,0,0,,Em vốn tự tin vào thể lực của mình, thế mà...
Dialogue: 0,0:20:57.82,0:20:58.99,Default,Yos,0,0,0,,Mọi thứ đều phải tích lũy qua kinh nghiệm thực tế cả thôi.
Dialogue: 0,0:20:58.99,0:21:00.74,Default,Yos,0,0,0,,Chúng ta chuyển sang địa điểm tiếp theo nào.
Dialogue: 0,0:21:04.04,0:21:05.87,Default,Oka,0,0,0,,Bọn mình còn phải làm bao nhiêu cột nữa hả anh?
Dialogue: 0,0:21:05.87,0:21:08.29,Default,Yos,0,0,0,,Còn bốn cột y hệt như cột vừa rồi nữa.
Dialogue: 0,0:21:09.59,0:21:11.25,Default,Yos,0,0,0,,Chào mọi người, mai gặp lại nhé.
Dialogue: 0,0:21:11.25,0:21:13.76,Default,All,0,0,0,,Tạm biệt. Cậu vất vả rồi.
Dialogue: 0,0:21:16.22,0:21:17.97,Default,Oka,0,0,0,,Ui da đau quá...
Dialogue: 0,0:21:23.35,0:21:24.68,Default,Oka,0,0,0,,Anh về rồi đây.
Dialogue: 0,0:21:25.85,0:21:27.23,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:21:27.23,0:21:28.52,Default,Nag,0,0,0,,Anh làm em giật cả mình đấy.
Dialogue: 0,0:21:28.52,0:21:29.61,Default,Oka,0,0,0,,À, anh xin lỗi nhé.
Dialogue: 0,0:21:30.40,0:21:32.61,Default,Nag,0,0,0,,Anh có sao không Tomoya-kun?
Dialogue: 0,0:21:32.61,0:21:33.78,Default,Oka,0,0,0,,Ừ, anh ổn mà.
Dialogue: 0,0:21:36.20,0:21:38.86,Default,Nag,0,0,0,,Hôm nay có một chuyện vui lắm anh ạ.
Dialogue: 0,0:21:38.86,0:21:42.70,Default,Nag,0,0,0,,Tiết âm nhạc lớp em được học chung với lớp của bạn Nishina.
Dialogue: 0,0:21:42.70,0:21:43.54,Default,Oka,0,0,0,,À...
Dialogue: 0,0:21:44.41,0:21:47.83,Default,Nag,0,0,0,,Bạn Nishina đã hỏi thăm và lo lắng cho em rất nhiều.
Dialogue: 0,0:21:47.83,0:21:49.25,Default,Oka,0,0,0,,Vậy à.
Dialogue: 0,0:21:49.25,0:21:50.50,Default,Oka,0,0,0,,Thế thì tốt quá rồi.
Dialogue: 0,0:21:51.92,0:21:55.05,Default,Nag,0,0,0,,Trông anh có vẻ mệt mỏi lắm.
Dialogue: 0,0:21:55.05,0:21:57.47,Default,Nag,0,0,0,,Hay là anh đi ngủ sớm đi nhé?
Dialogue: 0,0:21:57.47,0:22:01.18,Default,Oka,0,0,0,,Không đâu. Thay vì thế, em hãy kể thêm cho anh nghe về chuyện ở trường hôm nay đi.
Dialogue: 0,0:22:01.76,0:22:03.18,Default,Nag,0,0,0,,Vâng ạ. Nhưng mà...
