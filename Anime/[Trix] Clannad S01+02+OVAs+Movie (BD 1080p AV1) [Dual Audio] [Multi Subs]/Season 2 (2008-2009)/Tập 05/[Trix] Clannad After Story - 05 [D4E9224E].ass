Dialogue: 0,0:03:43.54,0:03:45.88,Default,Nag,0,0,0,,Mèo của chị Misae kìa.
Dialogue: 0,0:03:45.88,0:03:47.67,Default,Oka,0,0,0,,Sao thế?
Dialogue: 0,0:03:51.42,0:03:55.43,Default,Oka,0,0,0,,Chẳng phải đòn thế của chủ mày ngày càng điêu luyện hơn à?
Dialogue: 0,0:03:57.64,0:03:59.85,Default,Mis,0,0,0,,Mày đừng hòng lặp lại trò đó một lần nữa nghe chưa hả?!
Dialogue: 0,0:04:00.39,0:04:02.31,Default,Sun,0,0,0,,Em không dám nữa đâu... Em thề đấy...
Dialogue: 0,0:04:03.85,0:04:04.69,Default,Mis,0,0,0,,Ủa.
Dialogue: 0,0:04:05.02,0:04:07.27,Default,Mis,0,0,0,,Chẳng phải Furukawa-san với bạn trai em ấy đây sao.
Dialogue: 0,0:04:07.27,0:04:08.52,Default,Mis,0,0,0,,Hai đứa đến đây từ bao giờ thế?
Dialogue: 0,0:04:08.52,0:04:10.57,Default,Nag,0,0,0,,Em chào chị Misae buổi tối ạ.
Dialogue: 0,0:04:10.90,0:04:14.57,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 5
Dialogue: 0,0:04:10.90,0:04:14.57,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Mùa em từng ở nơi đây
Dialogue: 0,0:04:14.57,0:04:16.03,Default,Sun,0,0,0,,Chị nhẹ tay với em chút đi mà.
Dialogue: 0,0:04:16.41,0:04:18.83,Default,Mis,0,0,0,,Mày làm quá lên đấy, chỉ là vết bầm nhỏ thôi.
Dialogue: 0,0:04:19.28,0:04:24.25,Default,Nag,0,0,0,,Dạ, tụi em có mang ít thức ăn thừa sang cho Sunohara-san này.
Dialogue: 0,0:04:24.25,0:04:28.13,Default,Nag,0,0,0,,Mẹ em gói lại vì sợ cậu ấy thấy cô đơn khi Mei-chan về quê rồi.
Dialogue: 0,0:04:28.13,0:04:29.46,Default,Sun,0,0,0,,Thật á? Cảm ơn cậu nhiều nhé!
Dialogue: 0,0:04:31.55,0:04:35.55,Default,Oka,0,0,0,,Tao đã bảo rồi mà. Ở cái ký túc xá này chẳng ai thấy cô đơn nổi đâu.
Dialogue: 0,0:04:35.55,0:04:38.18,Default,Mis,0,0,0,,Cậu nói đúng đấy. Có khi còn ồn ào náo nhiệt quá mức ấy chứ.
Dialogue: 0,0:04:38.55,0:04:40.64,Default,Mis,0,0,0,,Chị đi pha trà đây, mấy đứa cứ ngồi chơi nhé.
Dialogue: 0,0:04:40.64,0:04:42.39,Default,Mis,0,0,0,,Coi như là quà cảm ơn vì đã cứu giúp con mèo.
Dialogue: 0,0:04:42.85,0:04:44.23,Default,Nag,0,0,0,,Cứu giúp ạ?
Dialogue: 0,0:04:44.23,0:04:47.40,Default,Mis,0,0,0,,Cái thằng trời đánh kia vừa toan đem bán con mèo đi đấy.
Dialogue: 0,0:04:47.40,0:04:51.48,Default,Sun,0,0,0,,Em chỉ nghĩ là nếu đem ra tiệm thú cưng thì kiếm được chút tiền tiêu vặt thôi mà.
Dialogue: 0,0:04:51.48,0:04:53.19,Default,Oka,0,0,0,,Đời nào có chuyện đó.
Dialogue: 0,0:04:53.19,0:04:55.95,Default,Nag,0,0,0,,Bé mèo này tên là gì vậy chị?
Dialogue: 0,0:04:55.95,0:04:56.91,Default,Mis,0,0,0,,Nanashi.
Dialogue: 0,0:04:56.91,0:04:58.87,Default,Nag,0,0,0,,Bé Nanashi đúng không ạ?
Dialogue: 0,0:04:59.66,0:05:01.91,Default,Nag,0,0,0,,Em gọi bé là Nana-chan được không?
Dialogue: 0,0:05:01.91,0:05:05.33,Note,Note,0,0,0,,{\an8\fs40}*Chú thích: Nanashi trong tiếng Nhật có nghĩa là \"Không tên\"
Dialogue: 0,0:05:01.91,0:05:05.33,Default,Mis,0,0,0,,Không, không phải là Nanashi-chan đâu. Chỉ là chị chưa đặt tên cho nó thôi.
Dialogue: 0,0:05:05.33,0:05:07.46,Default,Mis,0,0,0,,Với lại nó là giống đực đấy.
Dialogue: 0,0:05:07.46,0:05:09.54,Default,Nag,0,0,0,,Không có tên sao ạ?
Dialogue: 0,0:05:09.96,0:05:12.63,Default,Nag,0,0,0,,Nhưng chẳng phải đây là mèo của chị sao?
Dialogue: 0,0:05:12.63,0:05:19.14,Default,Mis,0,0,0,,Chị đâu có muốn nuôi đâu, nhưng từ hồi nào chẳng biết nó cứ bám riết lấy chị suốt,
Dialogue: 0,0:05:19.14,0:05:20.93,Default,Mis,0,0,0,,thế nên tình thế bắt buộc mới phải chăm sóc nó thôi.
Dialogue: 0,0:05:20.93,0:05:23.47,Default,Sun,0,0,0,,Vậy thì em đem bán nó đi thì có gì to tát đâu chứ?
Dialogue: 0,0:05:23.47,0:05:25.31,Default,Sun,0,0,0,,Hay là đem đi nấu lẩu mèo nhỉ?
Dialogue: 0,0:05:27.85,0:05:29.48,Default,Mis,0,0,0,,Mày bảo nấu cái gì cơ?!
Dialogue: 0,0:05:29.48,0:05:31.36,Default,Sun,0,0,0,,Em đùa thôi! Em chỉ nói đùa thôi mà!
Dialogue: 0,0:05:33.11,0:05:36.11,Default,Mis,0,0,0,,Nó cứ quấn lấy cậu suốt từ nãy đến giờ nhỉ?
Dialogue: 0,0:05:36.11,0:05:36.95,Default,Mis,0,0,0,,Tại sao thế nhỉ?
Dialogue: 0,0:05:37.61,0:05:39.91,Default,Mis,0,0,0,,Quần áo cậu có tẩm cỏ bạc hà mèo hay gì à?
Dialogue: 0,0:05:40.20,0:05:41.91,Default,Oka,0,0,0,,Đâu có đâu ạ.
Dialogue: 0,0:05:42.70,0:05:43.95,Default,Mis,0,0,0,,Vào đi.
Dialogue: 0,0:05:43.95,0:05:45.12,Default,Tom,0,0,0,,Em xin phép.
Dialogue: 0,0:05:45.62,0:05:47.83,Default,Tom,0,0,0,,Mọi người đang làm gì ở đây thế?
Dialogue: 0,0:05:47.83,0:05:51.29,Default,Oka,0,0,0,,Hiếm thấy thật đấy. Tomoyo, cậu đến đây làm gì vậy?
Dialogue: 0,0:05:51.29,0:05:53.38,Default,Mis,0,0,0,,Cũng chẳng hiếm hoi gì đâu.
Dialogue: 0,0:05:53.38,0:05:55.51,Default,Mis,0,0,0,,Sakagami-san thường xuyên ghé qua đây chơi lắm.
Dialogue: 0,0:05:55.51,0:05:59.22,Default,Tom,0,0,0,,Em đến để xin lời khuyên với tư cách Hội trưởng Hội học sinh ạ.
Dialogue: 0,0:05:59.22,0:06:04.06,Default,Tom,0,0,0,,Đây là cơ hội hoàn hảo vì chuyện này liên quan đến cả Okazaki lẫn Sunohara.
Dialogue: 0,0:06:05.35,0:06:08.14,Default,Oka,0,0,0,,Xóa bỏ hoàn toàn tình trạng đi trễ và cúp học trong toàn trường á?
Dialogue: 0,0:06:08.14,0:06:09.06,Default,Tom,0,0,0,,Đúng vậy.
Dialogue: 0,0:06:09.06,0:06:12.56,Default,Tom,0,0,0,,Chị Misae là nữ Hội trưởng Hội học sinh\Nđầu tiên trong lịch sử trường ta.
Dialogue: 0,0:06:12.56,0:06:17.57,Default,Tom,0,0,0,,Và chị ấy đã tạo nên kỳ tích huyền thoại: "Tuần lễ không đi trễ, không nghỉ học".
Dialogue: 0,0:06:17.57,0:06:19.36,Default,Mis,0,0,0,,Nhắc lại làm chị nhớ ngày xưa ghê.
Dialogue: 0,0:06:19.95,0:06:23.20,Default,Tom,0,0,0,,Em muốn biết làm thế nào chị có thể đoàn kết toàn thể học sinh như vậy.
Dialogue: 0,0:06:23.20,0:06:25.62,Default,Tom,0,0,0,,Em cũng muốn biến điều đó thành hiện thực.
Dialogue: 0,0:06:25.62,0:06:31.50,Default,Mis,0,0,0,,Khó khăn lắm đấy, bởi vì trước mắt có hai hòn đá tảng ngáng đường lớn nhất kia kìa.
Dialogue: 0,0:06:31.92,0:06:33.25,Default,Sun,0,0,0,,Chị ấy đang nói ai thế nhỉ?
Dialogue: 0,0:06:33.25,0:06:34.25,Default,Oka,0,0,0,,Ai mà biết được.
Dialogue: 0,0:06:34.25,0:06:38.76,Default,Nag,0,0,0,,Dạo này Tomoya-kun dậy sớm và đi học đúng giờ cùng tớ rồi mà.
Dialogue: 0,0:06:38.76,0:06:41.68,Default,Tom,0,0,0,,Vậy thì vấn đề còn lại chỉ là Sunohara thôi.
Dialogue: 0,0:06:41.68,0:06:43.76,Default,Tom,0,0,0,,Có cần tôi sang phòng đá cậu dậy mỗi sáng nữa không?
Dialogue: 0,0:06:43.76,0:06:45.76,Default,Sun,0,0,0,,Xin bà tha cho tôi đi.
Dialogue: 0,0:06:46.18,0:06:48.35,Default,Tom,0,0,0,,Chị đã làm thế nào vậy ạ?
Dialogue: 0,0:06:48.35,0:06:50.73,Default,Mis,0,0,0,,Thực ra chị chẳng làm gì đặc biệt cả đâu.
Dialogue: 0,0:06:50.73,0:06:56.53,Default,Mis,0,0,0,,Chị chỉ nói trong buổi chào cờ đầu tuần rằng hãy thử cố gắng không đi trễ hay nghỉ học trong một tuần xem sao.
Dialogue: 0,0:06:56.53,0:06:59.44,Default,Mis,0,0,0,,Thế là mọi người thấy vui nên hưởng ứng theo thôi.
Dialogue: 0,0:06:59.44,0:07:00.99,Default,Tom,0,0,0,,Chỉ có vậy thôi sao ạ?
Dialogue: 0,0:07:00.99,0:07:05.70,Default,Mis,0,0,0,,Nếu có một điều để nói, thì chị nghĩ chính việc không gượng ép cố quá sức đã mang lại kết quả.
Dialogue: 0,0:07:06.20,0:07:07.79,Default,Tom,0,0,0,,Em vẫn chưa hiểu lắm ạ.
Dialogue: 0,0:07:08.16,0:07:11.83,Default,Mis,0,0,0,,Nếu bản thân em quá căng thẳng và gồng mình,\Nắt sẽ có người nổi loạn chống đối lại.
Dialogue: 0,0:07:11.83,0:07:14.04,Default,Mis,0,0,0,,Càng nôn nóng sốt sắng thì càng phản tác dụng mà thôi.
Dialogue: 0,0:07:14.04,0:07:17.30,Default,Tom,0,0,0,,Em hiểu rồi ạ. Đó là một lời khuyên vô cùng quý giá.
Dialogue: 0,0:07:19.01,0:07:20.97,Default,Mis,0,0,0,,Hôm nay mình có vẻ đắt khách nhỉ.
Dialogue: 0,0:07:21.30,0:07:22.05,Default,Mis,0,0,0,,Vào đi em.
Dialogue: 0,0:07:22.47,0:07:23.43,Default,Guy,0,0,0,,Em chào chị buổi tối ạ.
Dialogue: 0,0:07:25.43,0:07:27.81,Default,Mis,0,0,0,,Kệ bọn nó đi, không phải ngại đâu.
Dialogue: 0,0:07:27.81,0:07:28.97,Default,Mis,0,0,0,,Em có chuyện gì cần nhờ à?
Dialogue: 0,0:07:28.97,0:07:31.48,Default,Guy,0,0,0,,Dạ, về chuyện hôm trước em nhờ chị...
Dialogue: 0,0:07:31.48,0:07:32.98,Default,Mis,0,0,0,,À, chuyện đó hả.
Dialogue: 0,0:07:33.23,0:07:35.98,Note,Sign,0,0,0,,{\fad(400,400)}Bảng thông báo: Lễ hội mùa thu Đền Hikarizaka - Ngày 23/9, 22h
Dialogue: 0,0:07:33.48,0:07:34.69,Default,Mis,0,0,0,,Đây này.
Dialogue: 0,0:07:36.36,0:07:38.28,Default,Guy,0,0,0,,Lễ hội mùa thu ạ?
Dialogue: 0,0:07:38.28,0:07:39.19,Default,Guy,0,0,0,,Ngày mai luôn sao ạ?
Dialogue: 0,0:07:39.19,0:07:43.61,Default,Mis,0,0,0,,Đây là lễ hội truyền thống từ xa xưa cầu mong bình an và hạnh phúc.
Dialogue: 0,0:07:43.61,0:07:45.91,Default,Mis,0,0,0,,Chị nghĩ đây là địa điểm tuyệt vời cho buổi hẹn hò đầu tiên của hai đứa đấy.
Dialogue: 0,0:07:45.91,0:07:47.62,Default,Guy,0,0,0,,E-Em hiểu rồi ạ!
Dialogue: 0,0:07:47.62,0:07:48.91,Default,Guy,0,0,0,,Chị Misae tuyệt vời thật đấy!
Dialogue: 0,0:07:48.91,0:07:50.83,Default,Guy,0,0,0,,Chị đúng là cứu tinh của đời em mà!
Dialogue: 0,0:07:50.83,0:07:53.58,Default,Sun,0,0,0,,Hóa ra thằng đó đến xin tư vấn chỗ đi hẹn hò à.
Dialogue: 0,0:07:53.58,0:07:56.63,Default,Tom,0,0,0,,Thôi đi nào. Ai lại đi nghe lén chuyện người khác như thế chứ.
Dialogue: 0,0:07:56.63,0:07:59.67,Default,Nag,0,0,0,,Đúng đấy. Ai cũng cần có sự riêng tư mà.
Dialogue: 0,0:07:59.00,0:08:00.34,Default-alt,Sun,0,0,0,,Mấy người đừng có phá đám thế chứ.
Dialogue: 0,0:08:00.76,0:08:02.22,Default,Guy,0,0,0,,Em cảm ơn chị nhiều lắm ạ.
Dialogue: 0,0:08:02.22,0:08:03.63,Default,Mis,0,0,0,,Không có gì đâu em.
Dialogue: 0,0:08:08.89,0:08:10.52,Default,Mis,0,0,0,,Mày vừa làm cái trò gì đấy hả?
Dialogue: 0,0:08:10.52,0:08:14.44,Default,Nag,0,0,0,,Sunohara-san vừa nghe lén kế hoạch hẹn hò của người ta đấy chị.
Dialogue: 0,0:08:16.02,0:08:18.06,Default,Mis,0,0,0,,Thiên phạt này!
Dialogue: 0,0:08:20.98,0:08:24.82,Default,Nag,0,0,0,,Chị Misae được rất nhiều học sinh tin tưởng và nương tựa nhỉ.
Dialogue: 0,0:08:24.82,0:08:27.95,Default,Tom,0,0,0,,Đáng ngưỡng mộ thật đấy. Em cũng muốn trở thành một người như chị.
Dialogue: 0,0:08:27.95,0:08:32.04,Default,Mis,0,0,0,,Chị vốn đã là người như thế từ lâu rồi mà.
Dialogue: 0,0:08:32.45,0:08:33.21,Default,Mis,0,0,0,,Thật đấy.
Dialogue: 0,0:08:33.21,0:08:35.54,Default,Oka,0,0,0,,Điều đó chứng tỏ chị rất có sức hút đấy chứ.
Dialogue: 0,0:08:35.54,0:08:38.46,Default,Oka,0,0,0,,Trong lớp tôi cũng có khối đứa là fan hâm mộ của chị đấy.
Dialogue: 0,0:08:38.46,0:08:41.09,Default,Mis,0,0,0,,Được người ta quý thì cũng thích thật đấy,
Dialogue: 0,0:08:41.42,0:08:44.93,Default,Mis,0,0,0,,nhưng chị chẳng hiểu họ thấy gì ở một người phụ nữ suốt ngày chỉ biết la hét nữa.
Dialogue: 0,0:08:45.68,0:08:50.97,Default,Oka,0,0,0,,Chị đâu chỉ biết la hét. Chị luôn quan tâm lo lắng cho người khác, đó mới là điểm tuyệt vời.
Dialogue: 0,0:08:50.97,0:08:57.35,Default,Oka,0,0,0,,Với lại, câu này là do một thành viên câu lạc bộ bóng bầu dục nói,\Nngười chị luôn thoang thoảng mùi xà phòng rất dễ chịu.
Dialogue: 0,0:08:58.77,0:09:02.07,Default,Oka,0,0,0,,Ở cái ký túc xá nam luộm thuộm bừa bãi này,\Nchị chẳng khác nào một thần tượng cả.
Dialogue: 0,0:09:02.44,0:09:04.15,Default,Oka,0,0,0,,Giống như viên ngọc quý giữa đống phân vậy.
Dialogue: 0,0:09:05.70,0:09:10.24,Default,Mis,0,0,0,,La hét... lo lắng...
Dialogue: 0,0:09:10.83,0:09:12.49,Default,Mis,0,0,0,,Và mùi hương dễ chịu à.
Dialogue: 0,0:09:13.04,0:09:14.25,Default,Oka,0,0,0,,Có chuyện gì thế chị?
Dialogue: 0,0:09:14.83,0:09:16.21,Default,Mis,0,0,0,,Không có gì đâu.
Dialogue: 0,0:09:16.21,0:09:19.00,Default,Mis,0,0,0,,Chỉ là ngày xưa cũng từng có người\Nnói với chị những lời tương tự như vậy.
Dialogue: 0,0:09:19.00,0:09:20.79,Default,Mis,0,0,0,,Chị vừa bất giác nhớ lại chuyện đó thôi.
Dialogue: 0,0:09:22.75,0:09:24.21,Default,Tom,0,0,0,,Em cảm ơn chị vì những lời khuyên bổ ích ạ.
Dialogue: 0,0:09:24.21,0:09:25.17,Default,Tom,0,0,0,,Xin lỗi vì đã làm phiền chị vào đêm muộn thế này.
Dialogue: 0,0:09:25.17,0:09:28.01,Default,Mis,0,0,0,,Không sao đâu. Em cứ ghé qua chơi bất cứ khi nào em muốn nhé.
Dialogue: 0,0:09:28.39,0:09:29.43,Default,Tom,0,0,0,,Vâng, em sẽ lại ghé qua ạ.
Dialogue: 0,0:09:33.52,0:09:36.14,Default,Mis,0,0,0,,Sunohara, mày cũng về phòng mày đi.
Dialogue: 0,0:09:36.14,0:09:37.23,Default,Sun,0,0,0,,Tại sao chứ?
Dialogue: 0,0:09:37.23,0:09:39.23,Default,Sun,0,0,0,,Vẫn chưa tới giờ tắt đèn mà.
Dialogue: 0,0:09:39.23,0:09:42.19,Default,Mis,0,0,0,,Chị có chuyện riêng cần nói với hai đứa này.
Dialogue: 0,0:09:42.19,0:09:42.94,Default,Mis,0,0,0,,Mày là người thừa.
Dialogue: 0,0:09:43.36,0:09:45.94,Default,Sun,0,0,0,,Chị không thể nói tế nhị hơn chút được à?
Dialogue: 0,0:09:47.45,0:09:49.86,Note,Sign,0,0,0,,{\fad(0,400)}Bảng thông báo: Lễ hội mùa thu Đền Hikarizaka - Ngày 23/9, 22h
Dialogue: 0,0:09:47.82,0:09:49.11,Default,Oka,0,0,0,,Đi cái này á chị?
Dialogue: 0,0:09:49.11,0:09:55.66,Default,Mis,0,0,0,,Ừ. Thằng Sunohara vừa bảo cậu chẳng bao giờ dẫn Furukawa-san đi hẹn hò cả.
Dialogue: 0,0:09:56.29,0:09:58.42,Default,Oka,0,0,0,,Đấy là chuyện của bọn em mà!
Dialogue: 0,0:09:58.42,0:10:02.54,Default,Mis,0,0,0,,Cứ lơ là như thế,\Nkhéo có gã khác đến cướp mất Furukawa-san đi đấy nhé.
Dialogue: 0,0:10:02.54,0:10:04.42,Default,Nag,0,0,0,,Kh-Không có chuyện đó đâu ạ!
Dialogue: 0,0:10:04.42,0:10:06.97,Default,Nag,0,0,0,,Em sẽ không để ai khác cướp em đi đâu ạ.
Dialogue: 0,0:10:10.51,0:10:15.43,Default,Mis,0,0,0,,Thấy chưa. Cậu sẽ chẳng bao giờ tìm được cô gái nào nói những lời như thế với cậu đâu.
Dialogue: 0,0:10:15.43,0:10:18.06,Default,Oka,0,0,0,,Sao tự dưng chị lại nhắc đến chuyện này thế?
Dialogue: 0,0:10:18.06,0:10:22.77,Default,Mis,0,0,0,,Nhìn hai đứa làm chị nhớ lại những ngày tháng tuổi trẻ tuyệt đẹp của mình.
Dialogue: 0,0:10:23.82,0:10:26.53,Default,Nag,0,0,0,,Chị Misae bây giờ vẫn còn trẻ mà.
Dialogue: 0,0:10:26.53,0:10:27.86,Default,Mis,0,0,0,,Cảm ơn em nhé.
Dialogue: 0,0:10:28.24,0:10:30.74,Default,Mis,0,0,0,,Nhưng chị ổn mà.
Dialogue: 0,0:10:31.07,0:10:36.04,Default,Mis,0,0,0,,Hiện giờ, việc của chị là chăm sóc cho đám nhóc tuổi trẻ các em.
Dialogue: 0,0:10:38.29,0:10:39.41,Default,Mis,0,0,0,,Được rồi.
Dialogue: 0,0:10:40.21,0:10:42.17,Default,Mis,0,0,0,,Ngồi chơi thêm chút nữa nhé?
Dialogue: 0,0:10:42.17,0:10:44.04,Default,Mis,0,0,0,,Để chị đi pha thêm ấm trà nữa.
Dialogue: 0,0:10:47.46,0:10:52.30,Default,Nag,0,0,0,,Hồi chị làm Hội trưởng, ngôi trường này như thế nào ạ?
Dialogue: 0,0:10:52.30,0:10:54.14,Default,Mis,0,0,0,,Chẳng có gì đặc biệt đâu.
Dialogue: 0,0:10:54.14,0:10:55.26,Default,Mis,0,0,0,,Chỉ là một ngôi trường bình thường thôi.
Dialogue: 0,0:10:55.26,0:10:58.27,Default,Nag,0,0,0,,Em chắc chắn là hồi đó chị có rất nhiều bạn bè.
Dialogue: 0,0:10:58.27,0:11:02.69,Default,Mis,0,0,0,,Ừ. Ngày nào cũng vui vẻ rộn ràng, làm chị chẳng bao giờ thấy chán.
Dialogue: 0,0:11:02.69,0:11:04.86,Default,Mis,0,0,0,,Từng chịu tổn thương... Từng âu lo bối rối...
Dialogue: 0,0:11:04.86,0:11:07.40,Default,Mis,0,0,0,,Nhưng tôi vẫn...
Dialogue: 0,0:11:08.32,0:11:10.61,Default,Shi,0,0,0,,Hãy lắng nghe cho kỹ đây.
Dialogue: 0,0:11:10.61,0:11:13.24,Default,Shi,0,0,0,,Bùa hộ mệnh này chứa một đốm sáng bên trong.
Dialogue: 0,0:11:13.24,0:11:17.24,Default,Shi,0,0,0,,Đó là đốm sáng có thể ban cho một điều ước bất kỳ.
Dialogue: 0,0:11:18.24,0:11:22.17,Default,Shi,0,0,0,,Mày hãy cầm lấy nó và đi tìm cô ấy.
Dialogue: 0,0:11:22.87,0:11:26.25,Default,Shi,0,0,0,,Và hãy thực hiện điều ước của cô ấy nhé.
Dialogue: 0,0:11:26.92,0:11:28.21,Default,Shi,0,0,0,,Mày đã hiểu chưa?
Dialogue: 0,0:11:38.18,0:11:51.32,Note,Sign,0,0,0,,Biển hiệu: Trường Trung học Tư thục Hikarizaka
Dialogue: 0,0:12:03.75,0:12:05.33,Default,Mis,0,0,0,,Igarashi-kun! Cậu cũng đang trên đường về nhà à?
Dialogue: 0,0:12:05.33,0:12:07.09,Default,Iga,0,0,0,,Ừ. Cậu cũng về hả Sagara?
Dialogue: 0,0:12:07.09,0:12:09.09,Default,Iga,0,0,0,,Ừ, trùng hợp ghê nhỉ.
Dialogue: 0,0:12:09.71,0:12:11.42,Default,Iga,0,0,0,,Cậu biết đấy, nếu cậu không phiền thì...
Dialogue: 0,0:12:11.42,0:12:12.47,Default,Iga,0,0,0,,Thằng nhóc đó là ai thế?
Dialogue: 0,0:12:13.17,0:12:15.05,Default,Iga,0,0,0,,Trông như học sinh trường khác vậy.
Dialogue: 0,0:12:16.14,0:12:17.64,Default,Iga,0,0,0,,Bạn trai cậu à?
Dialogue: 0,0:12:20.47,0:12:22.10,Default,Iga,0,0,0,,Thế thì mình không nên làm phiền rồi.
Dialogue: 0,0:12:22.10,0:12:23.14,Default,Iga,0,0,0,,Hẹn gặp lại ngày mai nhé.
Dialogue: 0,0:12:24.73,0:12:25.90,Default,Mis,0,0,0,,Á, khoan đã cậu ơi!
Dialogue: 0,0:12:26.98,0:12:30.28,Default,Shi,0,0,0,,Dạ, chị là chị Sagara Misae phải không ạ?
Dialogue: 0,0:12:30.90,0:12:31.99,Default,Mis,0,0,0,,Cậu là ai thế?
Dialogue: 0,0:12:31.99,0:12:33.45,Default,Shi,0,0,0,,Em là Shima Katsuki ạ.
Dialogue: 0,0:12:34.11,0:12:35.57,Default,Shi,0,0,0,,Chị nhìn em không thấy quen chút nào sao?
Dialogue: 0,0:12:41.04,0:12:42.04,Default,Shi,0,0,0,,Chờ em với.
Dialogue: 0,0:12:42.04,0:12:43.50,Default,Mis,0,0,0,,Tôi không rảnh đứng chờ đâu nhé.
Dialogue: 0,0:12:43.50,0:12:47.17,Default,Mis,0,0,0,,Tôi không quen cậu, mà tôi cũng chẳng thấy có lý do gì để cậu phải báo ơn báo oán cả.
Dialogue: 0,0:12:47.17,0:12:49.92,Default,Shi,0,0,0,,Có thể chị thấy không có, nhưng với em thì có đấy ạ.
Dialogue: 0,0:12:51.25,0:12:54.01,Default,Mis,0,0,0,,Cậu thấy có nhưng tôi thấy không!
Dialogue: 0,0:12:54.01,0:12:59.47,Default,Mis,0,0,0,,Hơn nữa, tại cậu mà người ta hiểu lầm rồi đấy!
Dialogue: 0,0:13:01.47,0:13:03.77,Default,Mis,0,0,0,,Bực cả mình. Tôi đi về đây!
Dialogue: 0,0:13:03.77,0:13:05.10,Default,Shi,0,0,0,,K-Khoan đã chị ơi!
Dialogue: 0,0:13:05.60,0:13:07.31,Default,Shi,0,0,0,,Xin chị hãy cho em biết điều ước của chị đi!
Dialogue: 0,0:13:07.31,0:13:08.69,Default,Mis,0,0,0,,Điều ước á?
Dialogue: 0,0:13:08.69,0:13:11.73,Default,Shi,0,0,0,,Em đến đây là để thực hiện điều ước của chị mà.
Dialogue: 0,0:13:11.73,0:13:14.15,Default,Shi,0,0,0,,Nếu chưa làm được thì em không thể về nhà được đâu.
Dialogue: 0,0:13:14.15,0:13:16.36,Default,Mis,0,0,0,,Thế thì biến khỏi mắt tôi ngay giây phút này đi.
Dialogue: 0,0:13:17.45,0:13:18.70,Default,Mis,0,0,0,,Có làm được không hả?
Dialogue: 0,0:13:18.70,0:13:22.29,Default,Shi,0,0,0,,Nếu... nếu đó thực sự là điều chị ước, thì em sẽ làm.
Dialogue: 0,0:13:22.29,0:13:25.08,Default,Shi,0,0,0,,Nhưng làm thế thì lòng em sẽ áy náy lắm.
Dialogue: 0,0:13:26.33,0:13:29.04,Default,Shi,0,0,0,,Bởi vì ngày xưa chị đã chăm sóc em ân cần đến thế kia mà.
Dialogue: 0,0:13:33.09,0:13:35.09,Default,Shi,0,0,0,,Chuyện là hồi em còn học tiểu học.
Dialogue: 0,0:13:35.88,0:13:40.93,Default,Shi,0,0,0,,Hình như lúc đó chị đến bệnh viện\Nđể thăm mẹ chị thì phải.
Dialogue: 0,0:13:41.55,0:13:46.10,Default,Shi,0,0,0,,Lúc đó chị nhìn thấy em ở sân bệnh viện và đã đến động viên em.
Dialogue: 0,0:13:46.73,0:13:48.19,Default,Shi,0,0,0,,Chị không nhớ chút nào sao ạ?
Dialogue: 0,0:13:48.69,0:13:51.65,Default,Shi,0,0,0,,Lúc đó em phải ngồi xe lăn, trên đùi còn ôm một con mèo nữa.
Dialogue: 0,0:13:53.44,0:13:54.48,Default,Mis,0,0,0,,Nhớ ra rồi.
Dialogue: 0,0:13:54.48,0:13:55.19,Default,Shi,0,0,0,,Chị nhớ ra thật rồi sao?!
Dialogue: 0,0:13:55.61,0:13:57.95,Default,Mis,0,0,0,,Nhưng hồi đó tôi có làm gì to tát đâu.
Dialogue: 0,0:13:57.95,0:13:59.86,Default,Mis,0,0,0,,Chỉ là đứng nói chuyện với cậu một chút thôi mà.
Dialogue: 0,0:13:59.86,0:14:01.41,Default,Shi,0,0,0,,Không phải đâu ạ.
Dialogue: 0,0:14:01.41,0:14:04.62,Default,Shi,0,0,0,,Chị đã thực sự tiếp thêm dũng khí cho em đấy.
Dialogue: 0,0:14:04.62,0:14:07.00,Default,Mis,0,0,0,,Cụ thể là tôi đã nói những gì nào?
Dialogue: 0,0:14:07.41,0:14:09.04,Default,Shi,0,0,0,,Dạ...
Dialogue: 0,0:14:10.38,0:14:11.54,Default,Shi,0,0,0,,Em quên mất rồi ạ.
Dialogue: 0,0:14:11.54,0:14:14.05,Default,Shi,0,0,0,,Nhưng em thực sự vô cùng biết ơn chị.
Dialogue: 0,0:14:14.05,0:14:16.01,Default,Shi,0,0,0,,Chính vì thế em mới muốn đền ơn chị.
Dialogue: 0,0:14:16.38,0:14:18.59,Default,Mis,0,0,0,,Thế thì mời tôi một lon nước ép đi.
Dialogue: 0,0:14:19.72,0:14:21.01,Default,Mis,0,0,0,,Thế là quá đủ rồi.
Dialogue: 0,0:14:21.39,0:14:24.93,Default,Mis,0,0,0,,Dù sao tôi cũng chẳng làm gì to tát đến mức ấy.
Dialogue: 0,0:14:24.93,0:14:29.73,Default,Shi,0,0,0,,Chị nghe em nói đã này. Em có thể thực hiện bất cứ điều ước nào.
Dialogue: 0,0:14:29.73,0:14:32.90,Default,Shi,0,0,0,,Em có một thứ có thể biến điều đó thành hiện thực.
Dialogue: 0,0:14:32.90,0:14:37.07,Default,Shi,0,0,0,,Nên chị đừng ngại, hãy nói ra điều mà chị thực sự khao khát nhất đi.
Dialogue: 0,0:14:37.07,0:14:40.28,Default,Mis,0,0,0,,Cái gì cơ? Giống như cây đèn thần của Aladdin à?
Dialogue: 0,0:14:40.28,0:14:43.28,Default,Shi,0,0,0,,Không phải đèn dầu đâu ạ, nhưng người ta đã bảo với em như thế.
Dialogue: 0,0:14:43.28,0:14:44.03,Default,Mis,0,0,0,,Ai bảo cậu?
Dialogue: 0,0:14:44.70,0:14:46.37,Default,Shi,0,0,0,,Dạ...
Dialogue: 0,0:14:47.50,0:14:48.20,Default,Shi,0,0,0,,Em cũng không biết nữa.
Dialogue: 0,0:14:49.79,0:14:51.88,Default,Mis,0,0,0,,Cậu đúng là một đứa nhóc kỳ quặc thật đấy.
Dialogue: 0,0:14:51.88,0:14:53.13,Default,Shi,0,0,0,,Chị thấy thế sao ạ?
Dialogue: 0,0:14:53.13,0:14:54.84,Default,Mis,0,0,0,,Lại còn lãng mạn viển vông nữa chứ.
Dialogue: 0,0:14:54.84,0:14:58.55,Default,Mis,0,0,0,,Xin lỗi nhé, tôi không tin vào mấy thứ ma thuật hão huyền đó đâu.
Dialogue: 0,0:14:58.55,0:14:59.67,Default,Shi,0,0,0,,C-Chị ơi!
Dialogue: 0,0:15:00.34,0:15:02.93,Default,Mis,0,0,0,,Dù sao cũng cảm ơn cậu vì đã cất công đến tận đây để cảm ơn tôi nhé.
Dialogue: 0,0:15:03.34,0:15:05.26,Default,Mis,0,0,0,,Thấy cậu khỏe mạnh thế này là tốt rồi.
Dialogue: 0,0:15:05.26,0:15:06.64,Default,Mis,0,0,0,,Tạm biệt nhé. Đi đường cẩn thận.
Dialogue: 0,0:15:10.06,0:15:10.89,Default,Shi,0,0,0,,Em chào chị buổi sáng ạ!
Dialogue: 0,0:15:11.73,0:15:13.52,Default,Girls,0,0,0,,Misae ơi, cậu nhóc đó là ai thế?
Dialogue: 0,0:15:13.52,0:15:14.98,Default,Girls,0,0,0,,Trông dễ thương quá đi mất.
Dialogue: 0,0:15:14.98,0:15:17.15,Default,Girls,0,0,0,,Cậu chuyển từ Igarashi-kun sang cậu nhóc này rồi đấy à?
Dialogue: 0,0:15:17.15,0:15:17.61,Default,Mis,0,0,0,,Đừng...
Dialogue: 0,0:15:18.28,0:15:20.99,Default,Mis,0,0,0,,Đừng có đứng đợi ngay trước cổng trường như thế chứ!
Dialogue: 0,0:15:20.99,0:15:22.66,Default,Shi,0,0,0,,Chị... Chị véo đau quá!
Dialogue: 0,0:15:22.66,0:15:25.78,Default,Mis,0,0,0,,Cậu làm Saki với Yuki hiểu lầm hết cả rồi kìa!
Dialogue: 0,0:15:25.78,0:15:27.58,Default,Mis,0,0,0,,Lỡ có tin đồn lan ra thì cậu tính sao hả?!
Dialogue: 0,0:15:27.91,0:15:29.33,Default,Shi,0,0,0,,Hiểu lầm chuyện gì cơ ạ?
Dialogue: 0,0:15:29.33,0:15:32.71,Default,Mis,0,0,0,,Cậu nhìn xem. Cậu là con trai, tôi là con gái.
Dialogue: 0,0:15:32.71,0:15:33.92,Default,Mis,0,0,0,,Cậu không có chút trí tưởng tượng nào à?
Dialogue: 0,0:15:33.92,0:15:38.55,Default,Shi,0,0,0,,A, em hiểu rồi. Chị thích Igarashi-kun đúng không?
Dialogue: 0,0:15:39.21,0:15:41.47,Default,Mis,0,0,0,,Cậu ăn nói thẳng thừng quá đấy nhỉ?
Dialogue: 0,0:15:41.47,0:15:44.05,Default,Shi,0,0,0,,Chị xinh đẹp thế này, em tin chắc là sẽ thành công thôi mà.
Dialogue: 0,0:15:44.05,0:15:46.43,Default,Shi,0,0,0,,A đúng rồi! Chúng mình cùng đi tỏ tình với cậu ấy đi!
Dialogue: 0,0:15:46.43,0:15:47.93,Default,Shi,0,0,0,,Em sẽ đi cùng chị.
Dialogue: 0,0:15:48.39,0:15:49.56,Default,Mis,0,0,0,,Tại sao...
Dialogue: 0,0:15:50.35,0:15:54.27,Default,Mis,0,0,0,,Tại sao tôi phải đi tỏ tình với người ta cùng cậu chứ?!
Dialogue: 0,0:15:55.40,0:15:56.90,Default,Shi,0,0,0,,Đ-Đau quá chị ơi...
Dialogue: 0,0:15:56.90,0:16:00.28,Default,Mis,0,0,0,,Này! Chẳng phải cậu đến đây để thực hiện điều ước của tôi sao hả?!
Dialogue: 0,0:16:00.28,0:16:02.15,Default,Mis,0,0,0,,Thế cớ sao cậu lại cứ ngáng đường tôi thế này?!
Dialogue: 0,0:16:02.15,0:16:05.91,Default,Shi,0,0,0,,Thế điều ước đổi thành được kết hôn với Igarashi-kun có được không ạ?
Dialogue: 0,0:16:06.74,0:16:08.16,Default,Shi,0,0,0,,Thế có được không chị?
Dialogue: 0,0:16:09.99,0:16:11.41,Default,Mis,0,0,0,,Không được.
Dialogue: 0,0:16:11.41,0:16:12.54,Default,Shi,0,0,0,,Sao lại không được ạ?
Dialogue: 0,0:16:12.83,0:16:15.42,Default,Mis,0,0,0,,Cậu không được phép thao túng tình cảm của người khác.
Dialogue: 0,0:16:20.17,0:16:20.88,Default,Shi,0,0,0,,Chị đã về rồi ạ.
Dialogue: 0,0:16:22.55,0:16:24.22,Default,Shi,0,0,0,,Tự dưng chị lại làm thế với em.
Dialogue: 0,0:16:24.22,0:16:26.34,Default,Mis,0,0,0,,Tôi đã bảo cậu là không được đợi ở cổng trường cơ mà.
Dialogue: 0,0:16:26.34,0:16:29.68,Default,Girl,0,0,0,,Cậu bé làm phiền cậu ghê nhỉ?
Dialogue: 0,0:16:29.68,0:16:31.18,Default,Girl,0,0,0,,Shima-kun đúng không?
Dialogue: 0,0:16:31.18,0:16:33.89,Default,Girl,0,0,0,,Em thấy đấy, Misae nhà này đã có người mình thích rồi.
Dialogue: 0,0:16:33.89,0:16:36.44,Default,Girl,0,0,0,,Nếu Igarashi-kun mà nhìn thấy cảnh này thì...
Dialogue: 0,0:16:36.44,0:16:37.40,Default,Iga,0,0,0,,Ai vừa gọi tôi đấy à?
Dialogue: 0,0:16:38.77,0:16:40.98,Default,Iga,0,0,0,,Ủa, bạn trai của Sagara đây mà.
Dialogue: 0,0:16:40.98,0:16:42.69,Default,Iga,0,0,0,,Giới thiệu cho tôi làm quen với nào.
Dialogue: 0,0:16:42.69,0:16:45.53,Default,Mis,0,0,0,,K-Không phải đâu! Cậu ấy không phải! Không có chuyện đó đâu!
Dialogue: 0,0:16:49.08,0:16:50.91,Default,Mis,0,0,0,,Mong là cậu ấy thực sự hiểu cho.
Dialogue: 0,0:16:51.29,0:16:56.42,Default,Shi,0,0,0,,Không sao đâu ạ. Em tin Igarashi-kun nhất định cũng sẽ thích chị thôi.
Dialogue: 0,0:16:58.46,0:17:00.55,Default,Mis,0,0,0,,Cậu kỳ lạ thật đấy.
Dialogue: 0,0:17:00.55,0:17:01.55,Default,Shi,0,0,0,,Dạ?
Dialogue: 0,0:17:02.01,0:17:07.18,Default,Mis,0,0,0,,Dù tôi thích người con trai khác, cậu cũng không ghen tị hay bực bội chút nào à?
Dialogue: 0,0:17:07.89,0:17:08.72,Default,Shi,0,0,0,,Dạ không...
Dialogue: 0,0:17:10.01,0:17:13.10,Default,Shi,0,0,0,,Chắc là do em chậm hiểu mấy chuyện đó thôi ạ.
Dialogue: 0,0:17:17.15,0:17:19.06,Default,Mis,0,0,0,,Nhưng tôi không ghét nét tính cách đó của cậu đâu.
Dialogue: 0,0:17:20.52,0:17:22.94,Default,Mis,0,0,0,,Sự thuần khiết của cậu cũng đáng yêu đấy chứ.
Dialogue: 0,0:17:39.33,0:17:41.59,Default,Mis,0,0,0,,Cậu muốn bị cảm lạnh hay sao đấy hả?
Dialogue: 0,0:17:42.00,0:17:46.09,Default,Mis,0,0,0,,Sao đi lại chẳng mang theo lấy cái ô thế?
Dialogue: 0,0:17:46.09,0:17:48.72,Default,Shi,0,0,0,,Em không nghĩ là trời lại mưa to thế này.
Dialogue: 0,0:17:50.09,0:17:53.14,Default,Mis,0,0,0,,Sao tôi lại phải đi chăm sóc cho đứa nhóc như cậu cơ chứ?
Dialogue: 0,0:17:53.14,0:17:54.06,Default,Shi,0,0,0,,Em xin lỗi chị ạ.
Dialogue: 0,0:17:54.93,0:17:58.35,Default,Mis,0,0,0,,Nếu biết xin lỗi thì đừng có bắt tôi phải lo lắng nữa.\NBảo thay đồ thì thay mau đi.
Dialogue: 0,0:17:58.77,0:18:01.65,Default,Mis,0,0,0,,Đây này. Tôi vừa mượn được bộ đồ thể dục cho cậu rồi, mau thay ra đi.
Dialogue: 0,0:18:01.65,0:18:02.11,Default,Shi,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:03.40,0:18:05.44,Default,Mis,0,0,0,,Thật là...
Dialogue: 0,0:18:05.44,0:18:09.49,Default,Mis,0,0,0,,Nếu cậu làm được mọi điều ước,\Nsao không làm cho trời tạnh mưa luôn đi?
Dialogue: 0,0:18:09.49,0:18:11.12,Default,Shi,0,0,0,,Chuyện đó em đâu có làm được!
Dialogue: 0,0:18:11.12,0:18:14.95,Default,Shi,0,0,0,,Em chỉ có thể thực hiện một điều ước duy nhất, và điều ước đó là dành riêng cho chị mà.
Dialogue: 0,0:18:16.20,0:18:19.37,Default,Mis,0,0,0,,Tôi thật không hiểu tại sao cậu lại biết ơn tôi đến thế.
Dialogue: 0,0:18:19.37,0:18:21.71,Default,Mis,0,0,0,,Ngay cả những lời tôi nói với cậu ngày trước, cậu còn chẳng nhớ cơ mà.
Dialogue: 0,0:18:21.71,0:18:26.38,Default,Shi,0,0,0,,Có lẽ chính việc chị chịu đến bắt chuyện với em\Nđã mang ý nghĩa lớn hơn cả những lời chị nói rồi ạ.
Dialogue: 0,0:18:26.38,0:18:28.51,Default,Shi,0,0,0,,Vì chị lúc nào cũng lạc quan và yêu đời.
Dialogue: 0,0:18:28.84,0:18:30.97,Default,Mis,0,0,0,,Câu đó tôi nghe người ta nói suốt rồi.
Dialogue: 0,0:18:30.97,0:18:35.22,Default,Shi,0,0,0,,Em nghĩ nhờ gặp được người như chị mà em mới có thêm nghị lực để cố gắng.
Dialogue: 0,0:18:35.22,0:18:37.98,Default,Shi,0,0,0,,Nên tất cả thực sự là nhờ có chị đấy ạ.
Dialogue: 0,0:18:43.86,0:18:45.40,Default,Mis,0,0,0,,Đến giờ vào lớp rồi, tôi phải đi đây.
Dialogue: 0,0:18:45.94,0:18:47.69,Default,Mis,0,0,0,,Lát nữa nhớ chuồn êm đấy nhé.
Dialogue: 0,0:18:47.69,0:18:48.36,Default,Shi,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:56.58,0:18:58.91,Default,Iga,0,0,0,,Ủa, bạn trai của Sagara đây mà.
Dialogue: 0,0:18:59.46,0:19:01.42,Default,Iga,0,0,0,,Lại đứng đợi cô ấy à?
Dialogue: 0,0:19:01.42,0:19:04.92,Default,Shi,0,0,0,,Dạ, em không phải là bạn trai của chị Sagara đâu ạ.
Dialogue: 0,0:19:04.92,0:19:05.96,Default,Iga,0,0,0,,Không phải à?
Dialogue: 0,0:19:05.96,0:19:09.92,Default,Shi,0,0,0,,Dạ không. Hình như chị ấy đã có người mình thầm thương trộm nhớ rồi.
Dialogue: 0,0:19:13.09,0:19:15.68,Default,Iga,0,0,0,,Này nhóc, có thể giúp anh một việc được không?
Dialogue: 0,0:19:23.31,0:19:25.48,Default,Mis,0,0,0,,Sao thế em? Trông mặt ủ rũ như bánh bao chiều vậy.
Dialogue: 0,0:19:26.19,0:19:28.73,Default,Mis,0,0,0,,Bị cảm lạnh thật rồi đấy à?
Dialogue: 0,0:19:30.28,0:19:31.86,Default,Mis,0,0,0,,Thế thì có chuyện gì sao?
Dialogue: 0,0:19:31.86,0:19:32.95,Default,Mis,0,0,0,,Đang gặp chuyện gì phiền lòng à?
Dialogue: 0,0:19:34.82,0:19:36.66,Default,Iga,0,0,0,,Tôi biết tình cảm mà Sagara dành cho tôi.
Dialogue: 0,0:19:37.37,0:19:39.62,Default,Iga,0,0,0,,Nhưng như nhóc thấy đấy, tôi đã có bạn gái rồi.
Dialogue: 0,0:19:40.08,0:19:42.96,Default,Iga,0,0,0,,Nên nhóc có thể bắn tiếng khéo léo cho cô ấy biết chuyện này được không?
Dialogue: 0,0:19:42.96,0:19:46.25,Default,Girl,0,0,0,,Anh lúc nào cũng tốt bụng quá mức với mọi người hết đấy, Igarashi-kun.
Dialogue: 0,0:19:46.25,0:19:48.42,Default,Iga,0,0,0,,Biết làm sao được. Tính anh xưa giờ vốn thế mà.
Dialogue: 0,0:19:49.17,0:19:52.30,Default,Iga,0,0,0,,Nhờ cậy cả vào nhóc đấy nhé. Làm sao để cô ấy ít bị tổn thương nhất ấy.
Dialogue: 0,0:19:53.59,0:19:55.80,Default,Mis,0,0,0,,Này, rốt cuộc đã có chuyện gì thế?
Dialogue: 0,0:19:55.80,0:19:57.72,Default,Mis,0,0,0,,Có gì thì tâm sự với bà chị này xem nào.
Dialogue: 0,0:19:59.56,0:20:01.35,Default,Mis,0,0,0,,Chẳng lẽ nhóc đang tương tư ai rồi à?
Dialogue: 0,0:20:02.27,0:20:03.81,Default,Shi,0,0,0,,Có lẽ vậy ạ.
Dialogue: 0,0:20:04.69,0:20:05.44,Default,Mis,0,0,0,,Thật á?!
Dialogue: 0,0:20:05.98,0:20:08.11,Default,Mis,0,0,0,,Chị chỉ buột miệng đoán mò thôi đấy.
Dialogue: 0,0:20:09.65,0:20:12.03,Default,Mis,0,0,0,,Thế sao mặt mày lại ủ rũ thế kia?
Dialogue: 0,0:20:12.45,0:20:18.66,Default,Shi,0,0,0,,Bởi vì... em vừa nhận được một tin buồn cho người ấy.
Dialogue: 0,0:20:19.04,0:20:20.16,Default,Mis,0,0,0,,Ý em là sao?
Dialogue: 0,0:20:20.16,0:20:24.00,Default,Shi,0,0,0,,Người ấy đang thầm thương một người con trai khác...
Dialogue: 0,0:20:24.62,0:20:28.42,Default,Shi,0,0,0,,...nhưng người con trai đó đã có bạn gái mất rồi.
Dialogue: 0,0:20:29.42,0:20:32.05,Default,Shi,0,0,0,,Người đó vừa nhờ em chuyển lời này đến cho người ấy.
Dialogue: 0,0:20:32.42,0:20:34.63,Default,Mis,0,0,0,,Nghe cứ như phim truyền hình ấy nhỉ.
Dialogue: 0,0:20:35.22,0:20:37.05,Default,Mis,0,0,0,,Nhưng thế chẳng phải là cơ hội ngàn vàng cho em sao!
Dialogue: 0,0:20:38.05,0:20:45.31,Default,Mis,0,0,0,,{\fs72.9}Lúc người ta đang suy sụp đau khổ vì thất tình mà em đến bên an ủi, biết đâu người ta lại rung động rồi quay sang thích em đấy.
Dialogue: 0,0:20:45.73,0:20:47.56,Default,Mis,0,0,0,,Cố lên nào, Shima-kun.
Dialogue: 0,0:20:47.56,0:20:49.90,Default,Mis,0,0,0,,Đừng có ủ rũ nữa, hãy suy nghĩ tích cực lên xem nào.
Dialogue: 0,0:20:49.90,0:20:50.98,Default,Mis,0,0,0,,Đúng không?
Dialogue: 0,0:20:50.98,0:20:52.44,Default,Mis,0,0,0,,Đây chính là cơ hội tuyệt vời của em đấy.
Dialogue: 0,0:20:51.65,0:20:54.07,Default-alt,Shi,0,0,0,,Làm sao em có thể nghĩ như thế được cơ chứ!
Dialogue: 0,0:20:57.16,0:20:59.62,Default,Shi,0,0,0,,Nếu chị ở vào vị trí của em...
Dialogue: 0,0:21:01.33,0:21:02.62,Default,Shi,0,0,0,,...liệu chị có làm được như thế không?!
Dialogue: 0,0:21:02.62,0:21:03.66,Default,Shi,0,0,0,,Chị có thể nghĩ được như thế sao?!
Dialogue: 0,0:21:04.12,0:21:06.04,Default,Shi,0,0,0,,Khi mà mình yêu thương người đó nhiều đến nhường ấy!
Dialogue: 0,0:21:07.21,0:21:11.50,Default,Shi,0,0,0,,Người mình yêu đang đau đớn đến vỡ vụn con tim, làm sao có thể xem đó là cơ hội được chứ?!
Dialogue: 0,0:21:12.00,0:21:14.01,Default,Mis,0,0,0,,Xin lỗi... Chị xin lỗi em...
Dialogue: 0,0:21:14.42,0:21:19.97,Default,Mis,0,0,0,,Con gái xung quanh chị ai cũng nghĩ lạc quan theo kiểu đó cả, nên là...
Dialogue: 0,0:21:38.91,0:21:41.45,Default,Mis,0,0,0,,Shima-kun... Những lời em vừa nói...
Dialogue: 0,0:21:44.00,0:21:45.04,Default,Mis,0,0,0,,Ra là vậy...
Dialogue: 0,0:21:45.83,0:21:47.16,Default,Mis,0,0,0,,Chị đúng là đồ ngốc mà.
Dialogue: 0,0:21:51.42,0:21:53.30,Default,Mis,0,0,0,,Nhưng... tại sao người khóc lại là em chứ?
Dialogue: 0,0:21:53.30,0:21:54.84,Default,Shi,0,0,0,,Em cũng không biết nữa...
