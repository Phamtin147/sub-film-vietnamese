Dialogue: 0,0:02:48.24,0:02:49.40,Default,Shi,0,0,0,,Chị Sagara.
Dialogue: 0,0:02:50.70,0:02:53.82,Default,Mis,0,0,0,,Sh-Shima-kun. Sao em lại ở đây?
Dialogue: 0,0:02:54.16,0:02:57.62,Default,Shi,0,0,0,,Dạ, chị Sagara... à không...
Dialogue: 0,0:02:58.08,0:02:59.29,Default,Shi,0,0,0,,Chị Misae.
Dialogue: 0,0:03:00.12,0:03:00.96,Default,Mis,0,0,0,,Hả?
Dialogue: 0,0:03:01.37,0:03:05.29,Default,Shi,0,0,0,,Tình yêu cũng giống như một phát pháo hoa rực rỡ đã tàn vậy.
Dialogue: 0,0:03:05.67,0:03:06.67,Default,Mis,0,0,0,,Ý em là sao hả?
Dialogue: 0,0:03:07.17,0:03:11.09,Default,Shi,0,0,0,,Nó sẽ đẹp hơn biết bao khi vỡ tan thành từng mảnh và bay tít ra xa.
Dialogue: 0,0:03:11.09,0:03:13.55,Default,Mis,0,0,0,,Em đang muốn kiếm chuyện với chị đấy à?!
Dialogue: 0,0:03:12.47,0:03:13.97,Default-alt,Shi,0,0,0,,Em xin lỗi chị ạ!
Dialogue: 0,0:03:16.64,0:03:19.27,Default,Shi,0,0,0,,Chị lau bằng cái này đi ạ.
Dialogue: 0,0:03:19.81,0:03:21.60,Default,Mis,0,0,0,,Chị đâu có khóc.
Dialogue: 0,0:03:21.60,0:03:24.31,Default,Shi,0,0,0,,Thế thì để phòng lúc chị vào nhà vệ sinh mà hết giấy...
Dialogue: 0,0:03:24.31,0:03:27.77,Default,Mis,0,0,0,,Rốt cuộc là em đang chu đáo hay vô duyên thế hả?!
Dialogue: 0,0:03:29.57,0:03:31.49,Default,Mis,0,0,0,,Em toàn nói mấy lời vớ vẩn kỳ quặc.
Dialogue: 0,0:03:32.45,0:03:34.66,Default,Mis,0,0,0,,Chắc chắn là do Yuki với Saki bảo em nói mấy câu đó chứ gì.
Dialogue: 0,0:03:35.41,0:03:36.28,Default,Shi,0,0,0,,Chị nhận ra được ạ?
Dialogue: 0,0:03:37.33,0:03:40.33,Default,Mis,0,0,0,,Em xưa giờ làm sao nói mấy câu sến súa như thế được.
Dialogue: 0,0:03:40.95,0:03:43.42,Default,Mis,0,0,0,,Sao em không nói câu nào do chính em tự nghĩ ra xem nào?
Dialogue: 0,0:03:46.29,0:03:47.54,Default,Shi,0,0,0,,Dạ thì...
Dialogue: 0,0:03:50.21,0:03:51.05,Default,Shi,0,0,0,,Em xin lỗi chị.
Dialogue: 0,0:03:52.55,0:03:54.43,Default,Mis,0,0,0,,Sao tự dưng lại xin lỗi?
Dialogue: 0,0:03:54.43,0:03:59.68,Default,Shi,0,0,0,,Chắc là... vì em cảm thấy mình cũng có lỗi trong chuyện này ạ.
Dialogue: 0,0:03:59.68,0:04:03.69,Default,Mis,0,0,0,,Em nói cái gì thế? Em đâu có liên quan...
Dialogue: 0,0:04:05.23,0:04:08.44,Default,Mis,0,0,0,,Nghĩ kỹ lại thì, hình như có cả đống việc do em gây ra thật đấy...
Dialogue: 0,0:04:08.44,0:04:10.32,Default,Shi,0,0,0,,Em thực sự xin lỗi chị nhiều lắm ạ!
Dialogue: 0,0:04:11.99,0:04:15.95,Default,Mis,0,0,0,,Nhưng thật ra, lý do chị ủ rũ là vì chuyện khác cơ.
Dialogue: 0,0:04:16.45,0:04:18.03,Default,Mis,0,0,0,,Không phải lỗi của em đâu.
Dialogue: 0,0:04:18.78,0:04:19.83,Default,Shi,0,0,0,,Thật vậy sao chị?
Dialogue: 0,0:04:20.70,0:04:24.67,Default,Mis,0,0,0,,Em đang nghĩ đây là cơ hội để khiến chị rung động đấy à?
Dialogue: 0,0:04:25.46,0:04:27.79,Default,Mis,0,0,0,,Giống như hôm qua chị vừa bảo ấy?
Dialogue: 0,0:04:27.79,0:04:31.17,Default,Shi,0,0,0,,Em hoàn toàn không nghĩ như thế đâu ạ.
Dialogue: 0,0:04:34.26,0:04:42.89,Default,Mis,0,0,0,,Dĩ nhiên rồi. Em chỉ đến đây để báo ơn thôi mà;\Nđâu phải vì em thích chị đâu.
Dialogue: 0,0:04:42.89,0:04:44.43,Default,Shi,0,0,0,,Không phải thế đâu ạ!
Dialogue: 0,0:04:48.98,0:04:50.11,Default,Mis,0,0,0,,Thật á?
Dialogue: 0,0:04:50.98,0:04:54.32,Default,Mis,0,0,0,,Vậy ra là em thích chị thật à.
Dialogue: 0,0:04:56.03,0:04:56.66,Default,Shi,0,0,0,,Vâng ạ.
Dialogue: 0,0:04:58.32,0:05:00.53,Default,Mis,0,0,0,,Chị... hiểu rồi...
Dialogue: 0,0:05:06.96,0:05:10.09,Default,Mis,0,0,0,,Thế này nhé. Em thích chị ở điểm nào nào?
Dialogue: 0,0:05:11.38,0:05:16.22,Default,Shi,0,0,0,,Chẳng hạn như việc chị hay mắng em nhưng lại luôn lo lắng cho em.
Dialogue: 0,0:05:16.68,0:05:21.60,Default,Shi,0,0,0,,Với lại, mỗi khi chị siết cổ khóa tay em,\Nem đều ngửi thấy mùi hương rất thơm thoang thoảng...
Dialogue: 0,0:05:21.60,0:05:22.89,Default,Shi,0,0,0,,...và em rất thích điều đó ạ.
Dialogue: 0,0:05:22.89,0:05:25.23,Default,Mis,0,0,0,,Chị thấy câu cuối cùng là thừa thãi rồi đấy.
Dialogue: 0,0:05:26.06,0:05:26.94,Default,Shi,0,0,0,,Em xin lỗi ạ!
Dialogue: 0,0:05:27.64,0:05:29.60,Default,Mis,0,0,0,,Thôi, đừng xin lỗi nữa.
Dialogue: 0,0:05:31.23,0:05:31.82,Default,Shi,0,0,0,,Vâng ạ.
Dialogue: 0,0:05:33.73,0:05:34.82,Default,Mis,0,0,0,,À thì...
Dialogue: 0,0:05:36.24,0:05:37.07,Default,Mis,0,0,0,,Cảm ơn em nhé.
Dialogue: 0,0:05:38.53,0:05:41.83,Default,Shi,0,0,0,,Dạ... Không có gì đâu ạ.
Dialogue: 0,0:05:44.79,0:05:45.79,Default,Girls,0,0,0,,Misae ơi!
Dialogue: 0,0:05:47.62,0:05:49.12,Default,Girls,0,0,0,,Hôm nay cậu có rảnh không?
Dialogue: 0,0:05:49.12,0:05:53.46,Default,Girls,0,0,0,,Ở bên kia ga mới mở một quán kem ngon lắm đấy!
Dialogue: 0,0:05:53.75,0:05:56.13,Default,Mis,0,0,0,,Xin lỗi hai cậu nhé. Hôm nay tớ... Thấy chưa?
Dialogue: 0,0:05:56.76,0:06:01.14,Default,Mis,0,0,0,,Cậu ấy đang đợi tớ thế này, nếu không đi cùng thì tội nghiệp lắm.
Dialogue: 0,0:06:01.47,0:06:02.05,Default,Mis,0,0,0,,Tạm biệt nhé!
Dialogue: 0,0:06:04.26,0:06:06.06,Default,Girls,0,0,0,,Có vẻ mọi chuyện giữa hai người tiến triển tốt đẹp ghê.
Dialogue: 0,0:06:06.06,0:06:08.02,Default,Girls,0,0,0,,Trông cậu ấy hạnh phúc chưa kìa.
Dialogue: 0,0:06:08.94,0:06:10.27,Default,Shi,0,0,0,,Hội trưởng Hội học sinh ạ?
Dialogue: 0,0:06:10.27,0:06:15.90,Default,Mis,0,0,0,,Ừ. Dù tin hay không thì chị chính là nữ Hội trưởng Hội học sinh đầu tiên của trường đấy.
Dialogue: 0,0:06:15.90,0:06:18.03,Default,Shi,0,0,0,,Oa, chị tuyệt vời thật đấy.
Dialogue: 0,0:06:18.53,0:06:20.41,Default,Mis,0,0,0,,Sắp đến Lễ hội mùa thu rồi đúng không?
Dialogue: 0,0:06:20.78,0:06:26.54,Default,Mis,0,0,0,,Trường mình cũng tham gia hỗ trợ nên đợt này hơi bận rộn một chút.
Dialogue: 0,0:06:26.54,0:06:28.12,Default,Shi,0,0,0,,Lễ hội mùa thu sao ạ?
Dialogue: 0,0:06:28.12,0:06:28.87,Default,Mis,0,0,0,,Thế nên là...
Dialogue: 0,0:06:29.37,0:06:31.75,Default,Mis,0,0,0,,...hôm đó nếu em không vướng bận gì...
Dialogue: 0,0:06:32.21,0:06:34.25,Default,Mis,0,0,0,,...thì em có muốn đi cùng chị không?
Dialogue: 0,0:06:34.67,0:06:35.63,Default,Mis,0,0,0,,Đi Lễ hội mùa thu ấy.
Dialogue: 0,0:06:39.88,0:06:42.14,Default,Shi,0,0,0,,Thế nào cũng bị lộ cho mà xem... Em chắc chắn luôn đấy.
Dialogue: 0,0:06:42.14,0:06:44.60,Default,Girls,0,0,0,,Yên tâm đi. Trông em xinh lắm.
Dialogue: 0,0:06:45.85,0:06:48.85,Default,Shi,0,0,0,,Ra là vậy. Chị Misae đang bận ạ.
Dialogue: 0,0:06:48.85,0:06:51.52,Default,Girls,0,0,0,,Ừ. Cậu ấy đang dự cuộc họp của Hội học sinh.
Dialogue: 0,0:06:51.52,0:06:54.44,Default,Girls,0,0,0,,Cậu ấy dặn bọn chị báo với em là hôm nay sẽ về muộn đấy.
Dialogue: 0,0:06:56.32,0:06:59.57,Default,Shi,0,0,0,,Em muốn được nhìn thấy chị ấy lúc làm việc quá.
Dialogue: 0,0:07:05.87,0:07:09.87,Default,Girls,0,0,0,,Nói thật nhé, nhìn em dễ thương đến mức chị bắt đầu thấy ghen tị rồi đấy.
Dialogue: 0,0:07:13.13,0:07:17.46,Default-alt,Yos,0,0,0,,{\an8}Tôi sẽ âm thầm trao gửi tình yêu này đến người...
Dialogue: 0,0:07:15.71,0:07:17.46,Default,Girls,0,0,0,,Yoshino-senpai kìa.
Dialogue: 0,0:07:18.21,0:07:21.17,Default,Girls,0,0,0,,Anh ấy lúc nào cũng nổi tiếng hết.
Dialogue: 0,0:07:21.84,0:07:24.47,Default,Guy,0,0,0,,Này em gái. Em học lớp nào thế?
Dialogue: 0,0:07:24.89,0:07:27.72,Default,Guy,0,0,0,,Chưa thấy mặt em bao giờ. Em là học sinh mới chuyển đến à?
Dialogue: 0,0:07:28.39,0:07:30.56,Default,Guy,0,0,0,,Có muốn anh dẫn đi tham quan một vòng quanh trường không?
Dialogue: 0,0:07:30.56,0:07:34.10,Default,Girls,0,0,0,,Không cần đâu anh. Tụi em đang dẫn em ấy đi rồi.
Dialogue: 0,0:07:34.10,0:07:35.77,Default,Girls,0,0,0,,Xin anh đừng bận tâm.
Dialogue: 0,0:07:35.77,0:07:37.40,Default,Guy,0,0,0,,Cần gì phải ngại thế chứ.
Dialogue: 0,0:07:37.40,0:07:40.07,Default,Guy,0,0,0,,Anh đâu có định tán tỉnh em gái đây đâu mà sợ.
Dialogue: 0,0:07:40.07,0:07:41.86,Default,Girls,0,0,0,,Tụi em ổn thật mà, cảm ơn anh.
Dialogue: 0,0:07:41.45,0:07:43.11,Default-alt,Girls,0,0,0,,Đi mau thôi, Shima-kun.
Dialogue: 0,0:07:41.86,0:07:43.86,Default,Guy,0,0,0,,Thế thì ít nhất cũng cho anh biết tên em là gì đi chứ.
Dialogue: 0,0:07:43.86,0:07:44.99,Default,Girls,0,0,0,,Không cần đâu, thật sự không phiền anh đâu ạ...
Dialogue: 0,0:07:44.99,0:07:46.58,Default,Guy,0,0,0,,Này, đứng lại đã em!
Dialogue: 0,0:07:46.58,0:07:47.74,Default,Guy,0,0,0,,Anh bảo đứng lại mà!
Dialogue: 0,0:07:52.21,0:07:53.79,Default,Mis,0,0,0,,Chúng ta chuyển sang chủ đề tiếp theo.
Dialogue: 0,0:07:54.62,0:07:58.13,Default,Mis,0,0,0,,Về việc học sinh đem đàn guitar vào lớp rồi biểu diễn nhạc sống.
Dialogue: 0,0:07:58.80,0:08:03.26,Default,Mis,0,0,0,,Ca hát thì không cấm, nhưng không được phép làm trong giờ học.
Dialogue: 0,0:08:01.84,0:08:03.59,Default-alt,Shi,0,0,0,,Chị ấy ngầu thật đấy.
Dialogue: 0,0:08:03.59,0:08:05.80,Default,Ibu,0,0,0,,Em có việc gì cần tìm ở phòng Hội học sinh sao?
Dialogue: 0,0:08:07.18,0:08:10.18,Default,Ibu,0,0,0,,Nếu có việc thì cứ vào trong đi em.
Dialogue: 0,0:08:10.72,0:08:13.31,Default,Ibu,0,0,0,,Nơi này đâu có cấm học sinh vào đâu.
Dialogue: 0,0:08:13.31,0:08:15.06,Default,Shi,0,0,0,,Dạ không, em...
Dialogue: 0,0:08:15.06,0:08:15.90,Default,Shi,0,0,0,,Và thế là...
Dialogue: 0,0:08:15.90,0:08:17.15,Default,Ibu,0,0,0,,Sagara-san.
Dialogue: 0,0:08:17.15,0:08:18.32,Default,Mis,0,0,0,,Thầy Ibuki.
Dialogue: 0,0:08:19.69,0:08:21.61,Default,Ibu,0,0,0,,Xin lỗi vì làm phiền cuộc họp của các em nhé.
Dialogue: 0,0:08:21.61,0:08:23.70,Default,Ibu,0,0,0,,Hình như cô bé này có điều gì muốn nói.
Dialogue: 0,0:08:24.45,0:08:25.28,Default,Ibu,0,0,0,,Có chuyện gì thế em?
Dialogue: 0,0:08:26.91,0:08:29.95,Default,Mis,0,0,0,,Oa, cô bé này dễ thương quá chừng.
Dialogue: 0,0:08:29.95,0:08:31.87,Default,Mis,0,0,0,,Trường mình có bạn nữ xinh xắn thế này từ bao giờ mà chị không biết nhỉ.
Dialogue: 0,0:08:33.12,0:08:35.12,Default,Shi,0,0,0,,E-Em cảm ơn chị nhiều ạ.
Dialogue: 0,0:08:35.58,0:08:37.54,Default,Mis,0,0,0,,Em có điều gì muốn nói với chị sao?
Dialogue: 0,0:08:37.83,0:08:40.05,Default,Mis,0,0,0,,Cứ nói hết những suy nghĩ trong lòng ra đi.
Dialogue: 0,0:08:40.05,0:08:43.67,Default,Mis,0,0,0,,Lắng nghe ý kiến của học sinh là nhiệm vụ của Hội học sinh mà.
Dialogue: 0,0:08:45.63,0:08:46.26,Default,Shi,0,0,0,,Dạ vâng!
Dialogue: 0,0:08:47.76,0:08:48.76,Default,Shi,0,0,0,,Em...
Dialogue: 0,0:08:49.80,0:08:54.94,Default,Shi,0,0,0,,Em muốn được mãi mãi ở bên cạnh chị!
Dialogue: 0,0:08:57.40,0:09:01.19,Default,Ibu,0,0,0,,Ơ... Hai em có mối quan hệ gì thế này?
Dialogue: 0,0:09:04.07,0:09:05.53,Default,Shi,0,0,0,,Em xin lỗi ạ!
Dialogue: 0,0:09:08.41,0:09:09.91,Signs,,0,0,0,,Phòng thay đồ nữ
Dialogue: 0,0:09:12.16,0:09:14.37,Default,Girls,0,0,0,,Buồn cười chết mất thôi!
Dialogue: 0,0:09:14.83,0:09:16.62,Default,Shi,0,0,0,,Có gì đáng cười đâu chứ ạ.
Dialogue: 0,0:09:17.08,0:09:19.29,Default,Shi,0,0,0,,Khéo chị ấy nhận ra em rồi cũng nên.
Dialogue: 0,0:09:19.29,0:09:21.46,Default,Girls,0,0,0,,Đừng lo.
Dialogue: 0,0:09:21.46,0:09:24.97,Default,Girls,0,0,0,,Biết đâu Misae lại thích em trong bộ dạng này hơn đấy.
Dialogue: 0,0:09:24.97,0:09:27.05,Default,Shi,0,0,0,,Làm sao có chuyện vô lý đó được ạ.
Dialogue: 0,0:09:30.89,0:09:31.43,Default,Shi,0,0,0,,Phải rồi...
Dialogue: 0,0:09:33.31,0:09:34.47,Default,Shi,0,0,0,,Mình đã quên mất.
Dialogue: 0,0:09:37.19,0:09:39.60,Default,Girls,0,0,0,,Này Shima-kun. Lát nữa em có bận gì không?
Dialogue: 0,0:09:40.69,0:09:46.24,Default,Girls,0,0,0,,Bọn chị vừa bàn nhau hay là lát nữa ghé qua nhà em chơi nhé.
Dialogue: 0,0:09:48.95,0:09:53.41,Default,Girls,0,0,0,,Ủa, vậy là Misae vẫn chưa từng đến nhà em à?
Dialogue: 0,0:09:54.49,0:09:58.00,Default,Girls,0,0,0,,Cảm giác đắc thắng khi được đến nhà bạn trai trước cả bạn gái này thích thật đấy...
Dialogue: 0,0:09:58.00,0:10:00.58,Default,Girls,0,0,0,,Lát nữa phải đem khoe với Misae mới được.
Dialogue: 0,0:10:06.34,0:10:07.51,Default,Girls,0,0,0,,Sao thế em?
Dialogue: 0,0:10:07.51,0:10:09.38,Default,Girls,0,0,0,,Em không thích bọn chị đến à?
Dialogue: 0,0:10:10.01,0:10:12.51,Default,Shi,0,0,0,,Dạ không, không phải thế đâu ạ.
Dialogue: 0,0:10:14.01,0:10:15.97,Default,Shi,0,0,0,,Chỉ là em không thể nhớ ra được...
Dialogue: 0,0:10:17.14,0:10:18.48,Default,Shi,0,0,0,,...nhà của em ở đâu nữa.
Dialogue: 0,0:10:20.23,0:10:21.98,Signs,Girls,0,0,0,,Biển tên: Nhà Shima
Dialogue: 0,0:10:21.19,0:10:23.98,Default,Girls,0,0,0,,Này, nhà em ở ngay đây cơ mà.
Dialogue: 0,0:10:24.44,0:10:27.19,Default,Girls,0,0,0,,Đừng có đùa làm bọn chị hú hồn thế chứ.
Dialogue: 0,0:10:30.99,0:10:32.66,Default,Mom,0,0,0,,Các cháu tìm ai ạ?
Dialogue: 0,0:10:33.28,0:10:34.20,Default,Girls,0,0,0,,Dạ cháu chào bác ạ!
Dialogue: 0,0:10:34.83,0:10:37.70,Default,Girls,0,0,0,,Sao đứng đực ra thế em? Phải chào "Con đã về" chứ.
Dialogue: 0,0:10:39.62,0:10:41.71,Default,Mom,0,0,0,,Các cháu là bạn của Katsuki sao?
Dialogue: 0,0:10:42.33,0:10:43.59,Default,Girls,0,0,0,,Dạ vâng.
Dialogue: 0,0:10:44.00,0:10:47.09,Default,Mom,0,0,0,,Cảm ơn các cháu đã đến thăm nhé.
Dialogue: 0,0:10:47.51,0:10:51.84,Default,Mom,0,0,0,,Xin mời các cháu vào thắp nén nhang cho nó.
Dialogue: 0,0:10:57.52,0:10:58.35,Default,Shi,0,0,0,,Đúng rồi...
Dialogue: 0,0:10:59.06,0:11:00.23,Default,Shi,0,0,0,,Mình đã nhớ ra rồi...
Dialogue: 0,0:11:01.48,0:11:04.86,Default,Shi,0,0,0,,Shima Katsuki thực sự đã không còn trên cõi đời này nữa rồi.
Dialogue: 0,0:11:06.02,0:11:10.36,Default,Shi,0,0,0,,Mình... mình thực chất không phải là Shima Katsuki.
Dialogue: 0,0:11:12.45,0:11:13.03,Default,Girls,0,0,0,,Này em!
Dialogue: 0,0:11:13.03,0:11:13.53,Default,Girls,0,0,0,,Đứng lại đã!
Dialogue: 0,0:11:24.42,0:11:27.09,Default,Girls,0,0,0,,Này, chuyện này rốt cuộc là thế nào?
Dialogue: 0,0:11:28.17,0:11:30.38,Default,Girls,0,0,0,,Chuyện này có uẩn khúc đằng sau đúng không em?
Dialogue: 0,0:11:30.80,0:11:33.01,Default,Girls,0,0,0,,Bọn chị có thể giúp gì được cho em không?
Dialogue: 0,0:11:35.85,0:11:38.43,Default,Girls,0,0,0,,Thế thì em hãy nhớ lấy điều này nhé.
Dialogue: 0,0:11:39.85,0:11:42.77,Default,Girls,0,0,0,,Bọn chị luôn tin tưởng em.
Dialogue: 0,0:11:43.23,0:11:46.98,Default,Girls,0,0,0,,Bởi vì với bọn chị, em chính là Shima-kun.
Dialogue: 0,0:11:47.36,0:11:50.36,Default,Girls,0,0,0,,Dù có chuyện gì xảy ra đi nữa, bọn chị vẫn mãi là bạn của em.
Dialogue: 0,0:11:51.57,0:11:52.40,Default,Shi,0,0,0,,Em cảm ơn hai chị nhiều lắm ạ.
Dialogue: 0,0:11:53.15,0:11:55.70,Default,Girls,0,0,0,,Bọn chị sẽ giữ bí mật chuyện này với Misae.
Dialogue: 0,0:11:55.99,0:12:00.29,Default,Girls,0,0,0,,Nếu có điều gì cần phải nói với cậu ấy,\Nthì em hãy đích thân nói cho cậu ấy biết nhé.
Dialogue: 0,0:12:00.29,0:12:00.79,Default,Shi,0,0,0,,Vâng ạ.
Dialogue: 0,0:12:07.38,0:12:08.75,Default,Shi,0,0,0,,Cuối cùng mình cũng đã nhớ ra rồi.
Dialogue: 0,0:12:09.88,0:12:11.92,Default,Shi,0,0,0,,Mình không phải là Shima Katsuki.
Dialogue: 0,0:12:13.01,0:12:17.80,Default,Shi,0,0,0,,Đó là tên của người mà tôi yêu quý nhất trên đời.
Dialogue: 0,0:12:19.06,0:12:29.90,Default,Shi,0,0,0,,Chúng tôi đã trải qua biết bao thời gian bên nhau,\Nvà người ấy đã để lại cho tôi tâm nguyện cuối cùng.
Dialogue: 0,0:12:31.53,0:12:35.61,Default,Shi,0,0,0,,Tôi đến đây là để hoàn thành tâm nguyện ấy.
Dialogue: 0,0:12:42.41,0:12:43.54,Default,Mis,0,0,0,,Cuối cùng em cũng đến rồi.
Dialogue: 0,0:12:44.33,0:12:46.92,Default,Shi,0,0,0,,Em xin lỗi vì đã đến muộn ạ.
Dialogue: 0,0:12:46.92,0:12:51.38,Default,Mis,0,0,0,,Không sao đâu, bình thường toàn là chị bắt em phải đợi mà.
Dialogue: 0,0:12:55.34,0:12:57.93,Default,Mis,0,0,0,,Cô bé hôm qua là em đúng không?
Dialogue: 0,0:12:58.39,0:12:59.72,Default,Shi,0,0,0,,Chị nhận ra thật sao ạ?
Dialogue: 0,0:12:59.72,0:13:03.27,Default,Mis,0,0,0,,Dĩ nhiên rồi. Ngày nào chúng mình chẳng nhìn thấy nhau.
Dialogue: 0,0:13:03.89,0:13:06.48,Default,Shi,0,0,0,,Em xin lỗi. Em có làm phiền chị không ạ?
Dialogue: 0,0:13:06.48,0:13:10.32,Default,Mis,0,0,0,,Không sao đâu. Chắc lại do Yuki với Saki ép em làm chứ gì?
Dialogue: 0,0:13:13.74,0:13:14.99,Default,Mis,0,0,0,,Điều ước á?
Dialogue: 0,0:13:15.45,0:13:19.07,Default,Shi,0,0,0,,Vâng. Vì đó là lý do em đến nơi này mà.
Dialogue: 0,0:13:20.62,0:13:23.75,Default,Shi,0,0,0,,Chị thấy không? Trong này có đốm sáng ban điều ước đấy.
Dialogue: 0,0:13:24.87,0:13:26.41,Default,Shi,0,0,0,,Ơ kìa? Sao lại không thấy đâu nữa rồi?
Dialogue: 0,0:13:27.00,0:13:29.88,Default,Mis,0,0,0,,Biết đâu ngay từ đầu đã chẳng có gì ở đó rồi.
Dialogue: 0,0:13:30.25,0:13:34.51,Default,Mis,0,0,0,,Nếu không có thì tức là lúc này chị không cần đến nó nữa rồi.
Dialogue: 0,0:13:35.26,0:13:40.26,Default,Mis,0,0,0,,Điều quan trọng nhất là hiện giờ chúng mình đang rất hạnh phúc mà.
Dialogue: 0,0:13:40.85,0:13:43.43,Default,Shi,0,0,0,,Nhưng điều này cũng quan trọng lắm ạ.
Dialogue: 0,0:13:43.43,0:13:45.14,Default,Mis,0,0,0,,Dù em có nói thế đi nữa...
Dialogue: 0,0:13:45.81,0:13:47.06,Default,Mis,0,0,0,,Chị biết rồi.
Dialogue: 0,0:13:47.06,0:13:48.52,Default,Shi,0,0,0,,Chị đã nghĩ ra điều ước rồi sao?
Dialogue: 0,0:13:48.94,0:13:50.48,Default,Mis,0,0,0,,Ừ.
Dialogue: 0,0:13:51.52,0:13:55.78,Default,Mis,0,0,0,,Đây chính là điều ước mà em hằng mong mỏi được nghe này.
Dialogue: 0,0:13:58.74,0:13:59.91,Default,Mis,0,0,0,,Xin em hãy...
Dialogue: 0,0:14:00.74,0:14:04.41,Default,Mis,0,0,0,,...yêu chị mãi mãi nhé.
Dialogue: 0,0:14:06.00,0:14:11.96,Default,Mis,0,0,0,,Xin hãy luôn tiếp tục yêu thương chị trọn đời này.
Dialogue: 0,0:14:12.88,0:14:15.17,Default,Mis,0,0,0,,Đó chính là điều ước của chị.
Dialogue: 0,0:14:28.10,0:14:29.77,Default,Mis,0,0,0,,Xin lỗi nhé. Chị làm em bất ngờ à?
Dialogue: 0,0:14:36.15,0:14:38.95,Default,Shi,0,0,0,,Hóa ra... mình thực sự đã đem lòng yêu người con gái này mất rồi.
Dialogue: 0,0:14:39.90,0:14:45.62,Default,Shi,0,0,0,,Dù chỉ là một khoảng thời gian ngắn ngủi, nhưng những tháng ngày bên nhau ấy quý giá biết bao.
Dialogue: 0,0:14:47.16,0:14:49.25,Default,Shi,0,0,0,,Mình cũng rất quý chị Yuki và chị Saki nữa.
Dialogue: 0,0:14:50.50,0:14:54.21,Default,Shi,0,0,0,,Mình yêu biết nhường nào những khoảnh khắc mà chúng ta từng có bên nhau.
Dialogue: 0,0:14:55.84,0:14:58.55,Default,Mis,0,0,0,,Chị chỉ nhắc lại y hệt những lời hôm qua em vừa nói với chị thôi mà.
Dialogue: 0,0:15:01.76,0:15:04.18,Default,Mis,0,0,0,,Trời ạ, sao em lại khóc thế kia?
Dialogue: 0,0:15:04.60,0:15:05.39,Default,Shi,0,0,0,,Em xin lỗi chị.
Dialogue: 0,0:15:05.72,0:15:08.14,Default,Mis,0,0,0,,Em đúng là đứa nhóc chẳng thể nào để mặc một mình được mà.
Dialogue: 0,0:15:09.39,0:15:10.39,Default,Shi,0,0,0,,Chị Misae.
Dialogue: 0,0:15:11.94,0:15:12.90,Default,Shi,0,0,0,,Em cảm ơn chị...
Dialogue: 0,0:15:15.11,0:15:17.40,Default,Shi,0,0,0,,Em cảm ơn chị nhiều lắm.
Dialogue: 0,0:15:21.61,0:15:24.87,Default,Mis,0,0,0,,Ch-Chị đi mua chút đồ uống nhé.
Dialogue: 0,0:15:25.28,0:15:26.41,Default,Mis,0,0,0,,Em cứ đứng đây đợi chị đấy.
Dialogue: 0,0:15:50.56,0:15:51.77,Default,Mis,0,0,0,,Shima-kun?
Dialogue: 0,0:15:54.31,0:15:55.10,Default,Mis,0,0,0,,Shima-kun!
Dialogue: 0,0:15:56.98,0:15:57.98,Default,Mis,0,0,0,,Shima-kun...
Dialogue: 0,0:16:01.65,0:16:02.32,Default,Mis,0,0,0,,Hả?
Dialogue: 0,0:16:03.36,0:16:04.28,Default,Mis,0,0,0,,Em vừa nói gì cơ?
Dialogue: 0,0:16:07.20,0:16:08.79,Default,Mis,0,0,0,,Shima-kun!
Dialogue: 0,0:16:14.71,0:16:17.04,Default,Shi,0,0,0,,Vĩnh biệt chị, Misae-san.
Dialogue: 0,0:16:18.04,0:16:22.63,Default,Shi,0,0,0,,Em sẽ mãi mãi yêu chị.
Dialogue: 0,0:16:23.97,0:16:26.93,Default,Shi,0,0,0,,Mãi mãi và mãi mãi.
Dialogue: 0,0:16:34.52,0:16:36.56,Default,Mis,0,0,0,,Ừ, tao quay về đây rồi.
Dialogue: 0,0:16:39.94,0:16:41.69,Default,Mis,0,0,0,,Ừ, ký túc xá nam.
Dialogue: 0,0:16:44.61,0:16:46.91,Default,Mis,0,0,0,,Hiện tại tao chẳng có kế hoạch hẹn hò yêu đương gì đâu.
Dialogue: 0,0:16:49.20,0:16:52.45,Default,Mis,0,0,0,,Không phải vì tao không thể quên được cậu ấy.
Dialogue: 0,0:16:53.37,0:16:56.87,Default,Mis,0,0,0,,Chắc số phận cuộc đời tao nó thế rồi.
Dialogue: 0,0:16:59.00,0:17:02.09,Default,Mis,0,0,0,,Ừ, sớm gặp lại nhau nhé.
Dialogue: 0,0:17:02.63,0:17:03.88,Default,Mis,0,0,0,,Rủ cả Yuki đi nữa nhé.
Dialogue: 0,0:17:03.88,0:17:04.55,Default,Mis,0,0,0,,Tạm biệt.
Dialogue: 0,0:17:09.26,0:17:12.35,Default,Mis,0,0,0,,Mày quyết định chọn nơi này làm nhà của mình đấy à?
Dialogue: 0,0:17:13.39,0:17:15.44,Default,Mis,0,0,0,,Mày thích ở bên cạnh tao đến thế cơ à?
Dialogue: 0,0:17:17.02,0:17:19.98,Default,Mis,0,0,0,,Tao vốn đâu có thích mèo cho lắm đâu, mày biết mà?
Dialogue: 0,0:17:25.28,0:17:29.87,Default,Mis,0,0,0,,Đúng là ngớ ngẩn thật. Sao tự dưng mình lại đi nghĩ đến chuyện cổ tích hoang đường thế nhỉ?
Dialogue: 0,0:17:31.99,0:17:33.87,Default,Mis,0,0,0,,Mày đúng là một con mèo kỳ lạ thật đấy.
Dialogue: 0,0:17:37.42,0:17:38.67,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:17:39.29,0:17:40.59,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:17:43.50,0:17:46.01,Default,Mis,0,0,0,,Cậu ngủ một giấc ngon lành ghê nhỉ?
Dialogue: 0,0:17:46.51,0:17:48.97,Default,Mis,0,0,0,,Nhìn cậu ngủ y hệt như con mèo của chị vậy.
Dialogue: 0,0:17:48.97,0:17:51.80,Default,Nag,0,0,0,,Cũng muộn rồi, tụi mình xin phép ra về thôi.
Dialogue: 0,0:17:52.26,0:17:53.01,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:17:55.14,0:17:58.73,Default,Nag,0,0,0,,Xin lỗi vì tụi em đã ở lại làm phiền chị lâu thế này.
Dialogue: 0,0:17:58.73,0:17:59.90,Default,Mis,0,0,0,,Không sao đâu.
Dialogue: 0,0:18:00.31,0:18:03.02,Default,Mis,0,0,0,,Nhớ bảo cậu ấy dắt em đi chơi Lễ hội mùa thu đấy nhé.
Dialogue: 0,0:18:03.02,0:18:03.73,Default,Nag,0,0,0,,Dạ vâng.
Dialogue: 0,0:18:04.07,0:18:05.90,Default,Oka,0,0,0,,Có phải mày đã cho tao thấy giấc mơ đó không?
Dialogue: 0,0:18:08.20,0:18:11.03,Default,Oka,0,0,0,,Hóa ra mày cũng có tên đàng hoàng đấy chứ.
Dialogue: 0,0:18:12.66,0:18:15.58,Default,Oka,0,0,0,,Mày có những điều muốn tao chuyển lời đến cô ấy đúng không?
Dialogue: 0,0:18:25.84,0:18:28.13,Default,Nag,0,0,0,,Có chuyện gì thế, Tomoya-kun?
Dialogue: 0,0:18:29.09,0:18:32.14,Default,Nag,0,0,0,,Từ hôm qua đến giờ trông cậu cứ như đang suy nghĩ điều gì ấy.
Dialogue: 0,0:18:32.14,0:18:36.27,Default,Oka,0,0,0,,Ừ, tớ đang nghĩ cách làm sao để\Ncho chị Misae biết một chuyện.
Dialogue: 0,0:18:42.02,0:18:44.52,Default,Nag,0,0,0,,Mèo của chị Misae kìa.
Dialogue: 0,0:18:46.32,0:18:49.70,Default,Oka,0,0,0,,Sao thế mày? Mày vẫn còn điều gì muốn nói với tao à?
Dialogue: 0,0:18:51.57,0:18:52.78,Default,Mis,0,0,0,,Furukawa-san!
Dialogue: 0,0:18:52.78,0:18:54.08,Default,Mis,0,0,0,,Cả bạn trai em ấy nữa!
Dialogue: 0,0:18:54.08,0:18:56.29,Default,Nag,0,0,0,,Em chào chị Misae buổi tối ạ.
Dialogue: 0,0:18:56.29,0:18:58.25,Default,Mis,0,0,0,,May quá, hai đứa bắt được nó rồi.
Dialogue: 0,0:18:58.25,0:18:59.50,Default,Mis,0,0,0,,Trời ơi, chị thở không ra hơi luôn rồi này.
Dialogue: 0,0:18:59.50,0:19:02.83,Default,Oka,0,0,0,,Chị sửa lại cách gọi tên em có được không?
Dialogue: 0,0:19:02.83,0:19:06.42,Default,Nag,0,0,0,,Chị dắt mèo đi chơi lễ hội đấy à?
Dialogue: 0,0:19:06.42,0:19:13.01,Default,Mis,0,0,0,,Đâu có. Nó tự dưng lao thục mạng ra ngoài nên chị mới phải đuổi theo đấy chứ.
Dialogue: 0,0:19:13.89,0:19:16.26,Default,Mis,0,0,0,,Chẳng hiểu trong đầu nó nghĩ cái quái gì nữa.
Dialogue: 0,0:19:18.52,0:19:22.27,Default,Mis,0,0,0,,Thiệt tình. Đúng là không rời mắt khỏi nó được mà.
Dialogue: 0,0:19:25.23,0:19:27.44,Default,Mis,0,0,0,,Ngoan nào, ra đây đi.
Dialogue: 0,0:19:29.61,0:19:34.16,Default,Oka,0,0,0,,Em nghĩ nó đã muốn cùng chị đến lễ hội này suốt bao nhiêu năm qua rồi đấy.
Dialogue: 0,0:19:30.32,0:19:31.49,Default-alt,Mis,0,0,0,,Đi về nhà thôi mày.
Dialogue: 0,0:19:35.83,0:19:40.25,Default,Oka,0,0,0,,Đêm qua, hình như em đã nghe thấy giọng nói của cậu ấy trong giấc mơ.
Dialogue: 0,0:19:41.08,0:19:47.25,Default,Oka,0,0,0,,Cậu ấy bảo: "Em xin lỗi vì đã không thể cùng chị đi đến cuối lễ hội."
Dialogue: 0,0:19:49.92,0:19:50.84,Default,Mis,0,0,0,,Còn gì nữa không?
Dialogue: 0,0:19:52.43,0:19:54.64,Default,Mis,0,0,0,,Cậu ấy có nói thêm điều gì nữa không?!
Dialogue: 0,0:19:54.64,0:19:59.22,Default,Oka,0,0,0,,Và: "Đúng như điều ước của chị, em sẽ mãi mãi ở bên cạnh chị."
Dialogue: 0,0:20:04.65,0:20:09.61,Default,Mis,0,0,0,,Chị đâu nhớ mình từng bảo sẽ đi hẹn hò với một con mèo đâu chứ.
Dialogue: 0,0:20:10.74,0:20:14.45,Default,Mis,0,0,0,,Nhưng thôi được rồi, hôm nay chị sẽ chơi với mày thật nhiều nhé.
Dialogue: 0,0:20:17.03,0:20:19.37,Default,Oka,0,0,0,,Còn một điều nữa em muốn chuyển lời đến chị, chị Misae.
Dialogue: 0,0:20:20.66,0:20:24.42,Default,Oka,0,0,0,,Cậu ấy cầu chúc chị sẽ tìm thấy hạnh phúc của riêng mình.
Dialogue: 0,0:20:25.12,0:20:29.63,Default,Oka,0,0,0,,Dù sao thì cậu ấy vốn là người như thế mà, phải không?
Dialogue: 0,0:20:30.30,0:20:32.51,Default,Oka,0,0,0,,Cậu ấy luôn lo lắng cho chị.
Dialogue: 0,0:20:35.09,0:20:38.89,Default,Mis,0,0,0,,Ừ, cậu nói đúng. Cậu ấy vốn là người như thế đấy.
Dialogue: 0,0:20:39.43,0:20:40.22,Default,Mis,0,0,0,,Cậu ấy từng là như vậy.
Dialogue: 0,0:20:43.18,0:20:46.40,Default,Mis,0,0,0,,Có khi chị cũng nên thử tận hưởng một thời thanh xuân nữa xem sao nhỉ.
Dialogue: 0,0:20:50.02,0:20:51.15,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:20:51.15,0:20:56.16,Default,Oka,0,0,0,,Đừng lo. Tớ sẽ kể cho cậu nghe về giấc mơ đêm qua của tớ.
Dialogue: 0,0:20:56.70,0:21:00.74,Default,Oka,0,0,0,,Một câu chuyện tình kỳ diệu của ngày xưa.
Dialogue: 0,0:21:11.84,0:21:13.05,Default,Shi,0,0,0,,Thưa Cậu chủ...
Dialogue: 0,0:21:14.01,0:21:15.42,Default,Shi,0,0,0,,Cậu chủ ơi.
Dialogue: 0,0:21:16.59,0:21:22.60,Default,Shi,0,0,0,,Người chủ hiện tại của em tuy không giống cậu chủ,\Nnhưng chị ấy là một người vô cùng tốt bụng.
Dialogue: 0,0:21:24.81,0:21:28.48,Default,Shi,0,0,0,,Nhưng đôi khi chị ấy cũng khiến em phải lo lắng.
Dialogue: 0,0:21:29.65,0:21:33.03,Default,Shi,0,0,0,,Liệu em đã hoàn thành được tâm nguyện chưa?
Dialogue: 0,0:21:34.78,0:21:38.70,Default,Shi,0,0,0,,Liệu em đã thực hiện được lời hứa giữa chúng ta chưa?
Dialogue: 0,0:21:40.49,0:21:44.58,Default,Shi,0,0,0,,Giờ đây thời gian trôi qua quá lâu rồi, em chẳng thể nào nhớ nổi nữa.
Dialogue: 0,0:21:46.08,0:21:49.71,Default,Shi,0,0,0,,Nhưng ngay lúc này đây, em muốn mãi được ở thế này.
Dialogue: 0,0:21:50.79,0:21:54.05,Default,Shi,0,0,0,,Xin người hãy cho phép em...
Dialogue: 0,0:21:57.93,0:22:05.64,Default,Shi,0,0,0,,Xin hãy cho phép em được mãi mãi ở bên cạnh chị ấy.
Dialogue: 0,0:22:18.74,0:22:26.25,ED English,,0,0,0,,{\be1}Tôi từng ngắm nhìn những áng mây bồng bềnh trôi.
