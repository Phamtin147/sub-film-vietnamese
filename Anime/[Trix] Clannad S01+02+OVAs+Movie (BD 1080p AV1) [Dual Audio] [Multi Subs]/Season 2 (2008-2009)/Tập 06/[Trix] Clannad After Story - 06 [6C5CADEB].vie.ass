Dialogue: 0,0:00:06.57,0:00:07.45,Default,Girls,0,0,0,,Shima-kun.
Dialogue: 0,0:00:10.08,0:00:11.79,Default,Shi,0,0,0,,Chị Saki. Chị Yuki.
Dialogue: 0,0:00:12.71,0:00:15.12,Default,Girls,0,0,0,,Nếu em đợi Misae thì hôm nay cậu ấy nghỉ học rồi nhé.
Dialogue: 0,0:00:15.12,0:00:17.79,Default,Girls,0,0,0,,Sáng nay cậu ấy vừa gọi điện cho chị Saki.
Dialogue: 0,0:00:18.34,0:00:21.01,Default,Girls,0,0,0,,Cậu ấy bảo bị cảm lạnh nên hôm nay xin nghỉ học ở nhà.
Dialogue: 0,0:00:21.38,0:00:22.55,Default,Shi,0,0,0,,Ra là vậy ạ...
Dialogue: 0,0:00:23.67,0:00:25.88,Default,Girls,0,0,0,,Đúng là có chuyện xảy ra thật rồi.
Dialogue: 0,0:00:25.88,0:00:29.10,Default,Girls,0,0,0,,Misae mà lại cúp học thì đúng là chuyện khó tin mà.
Dialogue: 0,0:00:29.10,0:00:32.18,Default,Girls,0,0,0,,Chẳng lẽ Igarashi-kun đã nói cho cậu ấy biết... chuyện đó rồi sao?
Dialogue: 0,0:00:34.02,0:00:36.48,Default,Girls,0,0,0,,Chị hiểu rồi. Hóa ra là bị người ta từ chối à.
Dialogue: 0,0:00:37.10,0:00:38.65,Default,Girls,0,0,0,,Tội nghiệp Misae ghê.
Dialogue: 0,0:00:39.11,0:00:40.44,Default,Girls,0,0,0,,Nhưng này, Shima-kun.
Dialogue: 0,0:00:41.44,0:00:47.45,Default,Girls,0,0,0,,Chị nghĩ một cậu nhóc như em hợp với Misae hơn là Igarashi-kun nhiều đấy.
Dialogue: 0,0:00:47.45,0:00:49.83,Default,Girls,0,0,0,,Em hãy thay bọn chị an ủi Misae nhé.
Dialogue: 0,0:00:50.33,0:00:52.54,Default,Girls,0,0,0,,Lát nữa chị sẽ hẹn cậu ấy ra công viên cho.
Dialogue: 0,0:01:13.10,0:01:18.69,OP English,,0,0,0,,{\be1\fad(250,0)}Nơi lưng chừng con dốc năm nào chỉ riêng em cất bước...
