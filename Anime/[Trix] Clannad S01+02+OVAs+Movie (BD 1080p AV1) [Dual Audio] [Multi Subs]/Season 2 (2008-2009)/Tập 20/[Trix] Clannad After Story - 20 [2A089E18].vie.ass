Dialogue: 0,0:02:33.14,0:02:34.89,Default,Ush,0,0,0,,Món lẩu!
Dialogue: 0,0:02:36.27,0:02:37.31,Default,Ush,0,0,0,,Món lẩu!
Dialogue: 0,0:02:37.31,0:02:38.10,Default,Bot,0,0,0,,Gột! Gột!
Dialogue: 0,0:02:38.10,0:02:39.64,Default,Oka,0,0,0,,Con gì thế này?
Dialogue: 0,0:02:40.35,0:02:42.06,Default,Ush,0,0,0,,Thú cưng của trường mẫu giáo đấy ạ.
Dialogue: 0,0:02:42.65,0:02:43.52,Default,Ush,0,0,0,,Món lẩu.
Dialogue: 0,0:02:43.52,0:02:45.23,Default,Oka,0,0,0,,Sao lại là một con lợn rừng?
Dialogue: 0,0:02:46.69,0:02:48.78,Default,Oka,0,0,0,,Khoan đã, chẳng lẽ là...
Dialogue: 0,0:02:48.78,0:02:51.66,Default,Kyo,0,0,0,,Anh hẳn là phụ huynh của bé Okazaki Ushio rồi.
Dialogue: 0,0:02:52.95,0:02:54.74,Default,Oka,0,0,0,,C-Cậu!
Dialogue: 0,0:02:54.74,0:02:58.58,Default,Kyo,0,0,0,,Tôi là giáo viên chủ nhiệm của bé Ushio, Fujibayashi Kyou.
Dialogue: 0,0:02:59.41,0:03:01.42,Default,Kyo,0,0,0,,Rất hân hạnh được gặp anh.
Dialogue: 0,0:03:02.54,0:03:05.13,Default,Oka,0,0,0,,V-Vâng, tôi cũng rất hân hạnh.
Dialogue: 0,0:03:11.68,0:03:14.80,Default,Kyo,0,0,0,,Lần đầu tiên tôi thấy vẻ mặt nghiêm túc này của cậu đấy.
Dialogue: 0,0:03:15.80,0:03:17.31,Default,Oka,0,0,0,,Cái đồ quỷ này!
Dialogue: 0,0:03:17.31,0:03:20.18,Default,Kyo,0,0,0,,Vừa nhìn thấy Botan là cậu phải nhận ra ngay rồi chứ.
Dialogue: 0,0:03:20.18,0:03:23.56,Default,Kyo,0,0,0,,Hay là cậu đã quên sạch về tôi rồi?
Dialogue: 0,0:03:24.15,0:03:26.36,Default,Oka,0,0,0,,Hóa ra đó thực sự là Botan à.
Dialogue: 0,0:03:26.36,0:03:26.98,Default,Bot,0,0,0,,Gột!
Dialogue: 0,0:03:28.86,0:03:33.91,Default,Kyo,0,0,0,,Ushio-chan, thực ra ngày xưa\Nbố em và cô từng học cùng trường với nhau đấy.
Dialogue: 0,0:03:35.41,0:03:37.45,Default,Oka,0,0,0,,Hồi đó cô ấy bạo lực lắm con ạ.
Dialogue: 0,0:03:37.45,0:03:39.95,Default,Oka,0,0,0,,Toàn bắt nạt bố thôi.
Dialogue: 0,0:03:39.95,0:03:43.50,Default,Kyo,0,0,0,,Này! Đừng có đặt điều bịa chuyện thế chứ!
Dialogue: 0,0:03:43.50,0:03:46.08,Default,Oka,0,0,0,,Cô ấy cũng từng là bạn rất thân của mẹ con nữa.
Dialogue: 0,0:03:46.96,0:03:47.96,Default,Oka,0,0,0,,Chuyện đó cô biết chứ?
Dialogue: 0,0:03:51.17,0:04:00.39,Default,Kyo,0,0,0,,Cô Sanae có đến dặn trước là rồi cậu cũng sẽ tới,\Nnên bảo tôi tạm thời giữ bí mật cho đến lúc đó.
Dialogue: 0,0:04:01.77,0:04:04.14,Default,Oka,0,0,0,,Ra vậy... lại là cô Sanae sắp đặt à.
Dialogue: 0,0:04:04.94,0:04:08.61,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 20
Dialogue: 0,0:04:04.94,0:04:08.61,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Trò Đùa Của Gió Biển
Dialogue: 0,0:04:09.19,0:04:11.32,Default,Kyo,0,0,0,,Đúng là duyên số kỳ lạ thật.
Dialogue: 0,0:04:11.82,0:04:14.82,Default,Kyo,0,0,0,,Ai mà ngờ được tôi lại là cô giáo của Ushio-chan cơ chứ?
Dialogue: 0,0:04:15.53,0:04:17.12,Default,Oka,0,0,0,,Chắc là tôi đã khiến mọi người phải lo lắng nhiều lắm.
Dialogue: 0,0:04:17.70,0:04:18.49,Default,Oka,0,0,0,,Xin lỗi cậu nhé.
Dialogue: 0,0:04:22.16,0:04:23.87,Default,Kyo,0,0,0,,Cậu hẳn là đã trải qua quãng thời gian khó khăn lắm.
Dialogue: 0,0:04:24.67,0:04:25.25,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:04:25.87,0:04:30.17,Default,Kyo,0,0,0,,Ryou, Kotomi và Youhei đều lo lắng cho cậu nhiều lắm đấy.
Dialogue: 0,0:04:30.50,0:04:36.39,Default,Kyo,0,0,0,,Dịp năm mới tụi tôi tụ họp lại và từng tính đến thăm cậu, nhưng...
Dialogue: 0,0:04:36.76,0:04:39.05,Default,Kyo,0,0,0,,Cuối cùng mọi người đều nhất trí rằng tốt nhất là nên để cậu yên tĩnh một thời gian.
Dialogue: 0,0:04:40.18,0:04:40.97,Default,Oka,0,0,0,,Cảm ơn các cậu.
Dialogue: 0,0:04:43.77,0:04:46.56,Default,Kyo,0,0,0,,Nhưng như thế này nghĩa là mọi chuyện đã ổn thỏa rồi đúng không?
Dialogue: 0,0:04:46.56,0:04:47.65,Default,Kyo,0,0,0,,Mọi gút thắt trong lòng đều đã được tháo gỡ rồi chứ?
Dialogue: 0,0:04:48.98,0:04:49.86,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:04:50.82,0:04:51.78,Default,Oka,0,0,0,,Ushio ở trường thế nào?
Dialogue: 0,0:04:52.44,0:04:53.90,Default,Oka,0,0,0,,Con bé có hòa đồng với các bạn không?
Dialogue: 0,0:04:54.40,0:04:56.20,Default,Kyo,0,0,0,,Con bé thực sự là một đứa trẻ rất ngoan.
Dialogue: 0,0:04:56.20,0:04:58.74,Default,Kyo,0,0,0,,Không hề có cái tính hoài nghi, bất cần đời như cậu đâu.
Dialogue: 0,0:05:00.12,0:05:02.79,Default,Oka,0,0,0,,Chắc là con bé thừa hưởng đức tính đó từ mẹ rồi.
Dialogue: 0,0:05:03.83,0:05:06.58,Default,Kyo,0,0,0,,Nhưng tôi thấy con bé hiếu động hơn mẹ nó nhiều đấy.
Dialogue: 0,0:05:07.12,0:05:11.96,Default,Kyo,0,0,0,,Chỉ cần tôi rời mắt một chút là con bé lại tự ý chạy đi chơi, nên tôi phải đặc biệt để mắt tới.
Dialogue: 0,0:05:12.34,0:05:13.46,Default,Oka,0,0,0,,Thật vậy sao?
Dialogue: 0,0:05:13.46,0:05:14.92,Default,Woman,0,0,0,,Chào buổi sáng cô ạ.
Dialogue: 0,0:05:15.97,0:05:17.38,Default,Kyo,0,0,0,,Chào buổi sáng!
Dialogue: 0,0:05:16.43,0:05:18.09,Default-alt,Kid,0,0,0,,Chào buổi sáng cô giáo!
Dialogue: 0,0:05:18.09,0:05:20.55,Default,Kyo,0,0,0,,Chào buổi sáng Takuya-kun nhé.
Dialogue: 0,0:05:21.01,0:05:22.56,Default,Oka,0,0,0,,Tôi phải đi làm đây.
Dialogue: 0,0:05:22.56,0:05:24.98,Default,Oka,0,0,0,,Trăm sự nhờ cậu chăm sóc cho Ushio nhé.
Dialogue: 0,0:05:25.39,0:05:27.35,Default,Kyo,0,0,0,,Nếu có bất cứ chuyện gì xảy ra, cứ gọi cho tôi.
Dialogue: 0,0:05:27.81,0:05:29.40,Default,Kyo,0,0,0,,Tôi sẽ giúp cậu một tay.
Dialogue: 0,0:05:29.69,0:05:33.07,Default,Oka,0,0,0,,Ừ, trông cậy cả vào cậu đấy, cô giáo Fujibayashi.
Dialogue: 0,0:05:36.03,0:05:37.45,Default,Kyo,0,0,0,,Ushio-chan!
Dialogue: 0,0:05:37.45,0:05:39.74,Default,Kyo,0,0,0,,Bố em chuẩn bị đi làm rồi kìa!
Dialogue: 0,0:05:43.70,0:05:45.75,Default,Ush,0,0,0,,Bố đi làm vui vẻ nhé bố.
Dialogue: 0,0:05:45.75,0:05:48.00,Default,Oka,0,0,0,,Ừ, bố đi đây.
Dialogue: 0,0:05:52.25,0:05:56.42,Default,Kyo,0,0,0,,Được sống cùng với bố thế này em có vui không?
Dialogue: 0,0:05:57.01,0:05:57.72,Default,Ush,0,0,0,,Dạ vui lắm ạ!
Dialogue: 0,0:05:59.55,0:06:01.43,Default,Kyo,0,0,0,,Được rồi, chúng ta cùng vào lớp nào.
Dialogue: 0,0:06:01.43,0:06:02.14,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:06:04.18,0:06:05.39,Default,Oka,0,0,0,,Bé Fuko-chan muốn tới ạ?
Dialogue: 0,0:06:05.81,0:06:09.10,Default,Yos,0,0,0,,Ừ. Con bé muốn đến thăm nhà em.
Dialogue: 0,0:06:09.85,0:06:12.19,Default,Yos,0,0,0,,Chủ nhật tuần này em có bận kế hoạch gì không?
Dialogue: 0,0:06:12.86,0:06:14.78,Default,Oka,0,0,0,,Dạ không, em không có kế hoạch gì cả.
Dialogue: 0,0:06:14.78,0:06:15.90,Default,Oka,0,0,0,,Nhưng tại sao lại muốn đến nhà em ạ?
Dialogue: 0,0:06:16.61,0:06:19.32,Default,Yos,0,0,0,,Nghe nói con bé muốn kết thân làm bạn với Ushio-chan.
Dialogue: 0,0:06:19.95,0:06:22.03,Default,Yos,0,0,0,,Nếu em đồng ý cho con bé qua thì quý hóa quá.
Dialogue: 0,0:06:22.99,0:06:27.54,Default,Yos,0,0,0,,Fuko-chan mới xuất viện chưa lâu, con bé cần phải tập tự đi lại một mình.
Dialogue: 0,0:06:27.54,0:06:30.83,Default,Oka,0,0,0,,À, em hiểu rồi. Em ấy đang trong giai đoạn phục hồi chức năng.
Dialogue: 0,0:06:31.38,0:06:33.50,Default,Yos,0,0,0,,Hơn nữa con bé còn rất nhút nhát trước người lạ.
Dialogue: 0,0:06:34.04,0:06:36.84,Default,Yos,0,0,0,,Hiếm khi nào con bé chủ động muốn gặp gỡ ai đó như thế này.
Dialogue: 0,0:06:37.38,0:06:39.80,Default,Yos,0,0,0,,Nên anh muốn tạo cho con bé những cơ hội như vậy.
Dialogue: 0,0:06:41.05,0:06:42.26,Default,Oka,0,0,0,,Vâng, được chứ anh.
Dialogue: 0,0:06:41.76,0:07:03.16,Romaji,,0,0,0,,{\fad(500,500)}{\be1\K50}{\K232}Na{\K8}{\K46}mi{\K34}da {\K144}ga{\K93} {\K46}ko{\K34}bo{\K183}re{\K371} {\K25}o{\K11}{\K45}chi{\K230}ru {\K43}no{\K44}ha {\K219}na{\K17}n {\K31}no {\K53}se{\K145}i
Dialogue: 0,0:06:41.76,0:07:03.16,English,,0,0,0,,{\fad(500,500)}{\be1}Điều gì đã khiến dòng lệ tôi tuôn rơi?
Dialogue: 0,0:06:42.26,0:06:45.89,Default,Oka,0,0,0,,Có vẻ như Ushio cũng rất quý mến em Fuko-chan đấy.
Dialogue: 0,0:06:45.89,0:06:47.14,Default,Oka,0,0,0,,Bố con em sẽ đợi em ấy qua chơi.
Dialogue: 0,0:06:47.14,0:06:48.52,Default,Yos,0,0,0,,Thật ngại quá vì đã làm phiền em.
Dialogue: 0,0:06:49.68,0:06:50.64,Default,Yos,0,0,0,,Cảm ơn em nhiều nhé.
Dialogue: 0,0:06:50.64,0:06:52.73,Default,Oka,0,0,0,,Đâu có gì đâu anh.
Dialogue: 0,0:07:03.16,0:07:14.88,Romaji,,0,0,0,,{\fad(500,500)}{\be1\K50}{\K78}Ka{\K86}sa{\K68}ne {\K44}su{\K44}gi{\K35}ta {\K31}to{\K268}shi {\K64}no{\K29} {\K211}se{\K112}i
Dialogue: 0,0:07:03.16,0:07:14.88,English,,0,0,0,,{\fad(500,500)}{\be1}Là bởi đã trải qua biết bao năm tháng cuộc đời.
Dialogue: 0,0:07:15.09,0:07:27.10,Romaji,,0,0,0,,{\fad(500,300)}{\be1\K50}{\K146}I{\K95}su {\K48}ni {\K27}yu{\K38}ra{\K37}re{\K102}te{\K57} {\K38}yu{\K43}me {\K114}wo{\K42} {\K63}mi{\K12}{\K44}te {\K38}i{\K46}ta{\K30}n{\K119}da
Dialogue: 0,0:07:15.09,0:07:27.10,English,,0,0,0,,{\fad(500,300)}{\be1}Đung đưa trên chiếc ghế bập bênh, tôi đã mơ một giấc mơ,
Dialogue: 0,0:07:27.10,0:07:39.07,Romaji,,0,0,0,,{\fad(300,200)}{\be1\K30}{\K38}A{\K45}na{\K76}ta {\K38}ga{\K38} {\K41}chi{\K34}i{\K47}sa{\K32}na {\K66}shu{\K21}{\K39}ku{\K33}fu{\K44}ku {\K42}no {\K37}na{\K41}ka{\K36}de{\K44} {\K72}u{\K46}ma{\K39}re{\K36}te {\K44}ki{\K77}ta {\K43}hi {\K31}no
Dialogue: 0,0:07:27.10,0:07:39.07,English,,0,0,0,,{\fad(300,200)}{\be1}về vạt nắng len qua tán lá và ngày ngập tràn niềm vui,
Dialogue: 0,0:07:39.07,0:07:52.54,Romaji,,0,0,0,,{\fad(200,750)}{\be1\K20}{\K37}Ko{\K40}mo{\K43}re{\K39}bi {\K159}wo{\K214} {\K64}shi{\K40}a{\K31}wa{\K53}se {\K39}na {\K64}hi {\K455}wo
Dialogue: 0,0:07:39.07,0:07:52.54,English,,0,0,0,,{\fad(200,750)}{\be1}ngày mà con chào đời trong muôn vàn lời chúc phúc.
Dialogue: 0,0:08:02.38,0:08:06.47,Default,Oka,0,0,0,,À đúng rồi Ushio. Ngày mai nhà mình sẽ có khách đến thăm đấy.
Dialogue: 0,0:08:07.14,0:08:08.64,Default,Ush,0,0,0,,Khách ạ?
Dialogue: 0,0:08:08.64,0:08:10.14,Default,Oka,0,0,0,,Cô Ibuki Fuko-chan đấy.
Dialogue: 0,0:08:10.68,0:08:11.85,Default,Oka,0,0,0,,Con còn nhớ cô ấy không?
Dialogue: 0,0:08:12.81,0:08:14.02,Default,Ush,0,0,0,,Dạ nhớ ạ.
Dialogue: 0,0:08:14.69,0:08:17.31,Default,Oka,0,0,0,,Cô ấy bảo muốn đến chơi cùng con.
Dialogue: 0,0:08:17.31,0:08:18.65,Default,Oka,0,0,0,,Con có đồng ý không?
Dialogue: 0,0:08:19.11,0:08:20.65,Default,Ush,0,0,0,,Dạ có ạ. Con vui lắm.
Dialogue: 0,0:08:21.11,0:08:22.40,Default,Oka,0,0,0,,Con thấy vui thật sao?
Dialogue: 0,0:08:22.40,0:08:24.70,Default,Ush,0,0,0,,Dạ vâng. Con rất vui.
Dialogue: 0,0:08:29.37,0:08:32.29,Default,Ush,0,0,0,,Bố ơi. Bố hát bài hát của mẹ cho con nghe đi?
Dialogue: 0,0:08:32.29,0:08:35.54,Default,Oka,0,0,0,,Lại hát nữa à? Con thích bài đó thật đấy nhỉ?
Dialogue: 0,0:08:35.92,0:08:38.42,Default,Ush,0,0,0,,Dạ vâng. Bài đó là con thích nhất.
Dialogue: 0,0:08:39.71,0:08:43.55,Default,Oka,0,0,0,,Được rồi. Nhưng đêm rồi nên hai bố con mình hát khẽ thôi nhé?
Dialogue: 0,0:08:46.93,0:08:51.68,Default,Oka,0,0,0,,Dango, dango, dango, dango...
Dialogue: 0,0:08:51.68,0:08:54.94,Default,Oka,0,0,0,,Gia đình Đại Dango!
Dialogue: 1,0:08:56.35,0:09:05.82,engsub,,0,0,0,,{\fad(300,300)}Dango nướng tinh nghịch, dango đậu đỏ dịu dàng,
Dialogue: 1,0:09:05.95,0:09:14.16,engsub,,0,0,0,,{\fad(300,300)}tất cả cùng tề tựu lại tạo nên đại gia đình một trăm thành viên.
Dialogue: 1,0:09:15.54,0:09:23.80,engsub,,0,0,0,,{\fad(300,300)}Dango em bé luôn được ôm ấp trọn vẹn trong niềm hạnh phúc.
Dialogue: 1,0:09:25.17,0:09:33.01,engsub,,0,0,0,,{\fad(300,300)}Dango cụ già nheo nheo đôi mắt hiền từ ngắm nhìn.
Dialogue: 1,0:09:33.56,0:09:43.07,engsub,,0,0,0,,{\fad(300,300)}Những người bạn dango cùng nắm chặt tay nhau tạo thành vòng tròn lớn.
Dialogue: 1,0:09:43.15,0:09:52.78,engsub,,0,0,0,,{\fad(300,300)}Họ xây dựng ngôi làng trên hành tinh dango và cùng nhau nở nụ cười.
Dialogue: 1,0:09:52.78,0:10:02.13,engsub,,0,0,0,,{\fad(300,300)}Mấy chú thỏ trên vầng trăng tròn to lớn đang vẫy tay chào.
Dialogue: 1,0:10:02.38,0:10:12.51,engsub,,0,0,0,,{\fad(300,300)}Gói ghém lại tất cả những niềm vui và nỗi buồn...
Dialogue: 0,0:10:17.27,0:10:19.06,Default,Fuk,0,0,0,,Fuko đến chơi rồi đây!
Dialogue: 0,0:10:20.02,0:10:21.94,Default,Fuk,0,0,0,,Cảm ơn vì đã đón tiếp Fuko nhé.
Dialogue: 0,0:10:21.94,0:10:23.48,Default,Oka,0,0,0,,Ừ, chào mừng em.
Dialogue: 0,0:10:24.48,0:10:28.03,Default,Fuk,0,0,0,,Nào, vào thẳng vấn đề chính luôn nhé, Ushio-chan.
Dialogue: 0,0:10:28.03,0:10:30.36,Default,Fuk,0,0,0,,Hãy làm em gái của Fuko đi!
Dialogue: 0,0:10:30.36,0:10:31.66,Default,Oka,0,0,0,,Không đời nào con bé chịu đâu!
Dialogue: 0,0:10:32.20,0:10:36.75,Default,Fuk,0,0,0,,Fuko đâu có nói chuyện với anh. Fuko đang nói với Ushio-chan cơ mà.
Dialogue: 0,0:10:37.58,0:10:40.79,Default,Fuk,0,0,0,,Ushio-chan, em không thích Fuko sao?
Dialogue: 0,0:10:43.29,0:10:43.88,Default,Ush,0,0,0,,Dạ thích ạ.
Dialogue: 0,0:10:43.88,0:10:45.38,Default,Fuk,0,0,0,,Thấy chưa hả?
Dialogue: 0,0:10:46.59,0:10:48.97,Default,Ush,0,0,0,,Nhưng con sẽ ở cùng với bố cơ.
Dialogue: 0,0:10:50.09,0:10:50.88,Default,Oka,0,0,0,,Nghe rõ chưa hả?
Dialogue: 0,0:10:53.47,0:10:56.14,Default,Fuk,0,0,0,,Vậy thì hôm nay Fuko sẽ dành trọn cả ngày để chinh phục em!
Dialogue: 0,0:10:57.39,0:10:59.89,Default,Fuk,0,0,0,,Trước tiên, đây là món quà làm quen của chúng ta!
Dialogue: 0,0:10:59.89,0:11:03.73,Default,Fuk,0,0,0,,Là bánh mì đặt làm theo yêu cầu từ tiệm Furukawa đấy.
Dialogue: 0,0:11:03.73,0:11:06.15,Default,Fuk,0,0,0,,Ushio-chan có muốn ăn không?
Dialogue: 0,0:11:08.53,0:11:09.28,Default,Ush,0,0,0,,Dạ có ạ.
Dialogue: 0,0:11:09.78,0:11:12.95,Default,Oka,0,0,0,,Một thiết kế khá dễ thương so với người như em đấy.
Dialogue: 0,0:11:13.49,0:11:14.91,Default,Ush,0,0,0,,Mời cả nhà xơi cơm ạ.
Dialogue: 0,0:11:19.41,0:11:20.62,Default,Ush,0,0,0,,Ngon lắm ạ.
Dialogue: 0,0:11:21.54,0:11:25.42,Default,Fuk,0,0,0,,Ushio-chan đáng yêu đang ăn chiếc bánh mì đáng yêu,\Nđộ dễ thương vừa tăng gấp bội rồi!
Dialogue: 0,0:11:25.42,0:11:27.25,Default,Oka,0,0,0,,Đừng có hơi tí là ôm chầm lấy con bé vì mấy lý do tào lao thế chứ!
Dialogue: 0,0:11:29.38,0:11:32.84,Default,Oka,0,0,0,,Bọn tôi chuẩn bị ăn trưa đây. Em có muốn ăn cùng không?
Dialogue: 0,0:11:35.26,0:11:37.68,Default,Fuk,0,0,0,,Anh đang cố tình lấy lòng Fuko đấy à?
Dialogue: 0,0:11:37.35,0:11:38.35,Default-alt,Oka,0,0,0,,Không đời nào!
Dialogue: 0,0:11:39.89,0:11:43.69,Default,Fuk,0,0,0,,Fuko nghe nói là anh đã mất đi người vợ thân yêu, Okazaki-san.
Dialogue: 0,0:11:43.69,0:11:44.81,Default,Oka,0,0,0,,Thì sao?
Dialogue: 0,0:11:44.81,0:11:48.86,Default,Fuk,0,0,0,,Chẳng có gì lạ nếu như anh nhìn thấy thoáng bóng hình của chị ấy nơi Fuko.
Dialogue: 0,0:11:50.11,0:11:51.24,Default,Oka,0,0,0,,Để tôi nói cho em nghe một điều nhé.
Dialogue: 0,0:11:51.24,0:11:53.11,Default,Fuk,0,0,0,,Xin mời.
Dialogue: 0,0:11:53.11,0:11:58.03,Default,Oka,0,0,0,,Nagisa chẳng hề giống em một chút nào hết, cứ như hai giống loài khác nhau ấy.
Dialogue: 0,0:11:58.03,0:12:00.50,Default,Fuk,0,0,0,,Vợ của anh là người ngoài hành tinh sao?!
Dialogue: 0,0:12:00.50,0:12:01.75,Default,Oka,0,0,0,,Ý tôi bảo em mới là người ngoài hành tinh đấy!
Dialogue: 0,0:12:01.75,0:12:03.83,Default,Fuk,0,0,0,,Fuko không phải là người ngoài hành tinh!
Dialogue: 0,0:12:03.83,0:12:06.75,Default,Oka,0,0,0,,Tôi chịu không thể hiểu nổi mạch suy nghĩ của em.
Dialogue: 0,0:12:06.75,0:12:11.05,Default,Fuk,0,0,0,,Mạch suy nghĩ của Fuko hoàn toàn chuẩn mực của người Trái Đất bình thường nhé.
Dialogue: 0,0:12:11.05,0:12:14.93,Default,Fuk,0,0,0,,Hàng xóm xung quanh ai cũng bảo Fuko là một người Trái Đất hết sức bình thường đấy thôi.
Dialogue: 0,0:12:14.93,0:12:16.39,Default,Oka,0,0,0,,Em sống cạnh cái thể loại hàng xóm gì thế hả?!
Dialogue: 0,0:12:17.39,0:12:19.64,Default,Fuk,0,0,0,,Vì vậy, chúng ta cùng về nhà chung đi!
Dialogue: 0,0:12:19.64,0:12:21.64,Default,Oka,0,0,0,,Chẳng liên quan gì đến nhau hết!
Dialogue: 0,0:12:21.64,0:12:27.52,Default,Oka,0,0,0,,{\fs75.6}Hơn nữa, nếu em mà đại diện cho suy nghĩ của người Trái Đất bình thường,\Nthì thế giới này đã tận thế sau ba ngày rồi.
Dialogue: 0,0:12:27.52,0:12:30.44,Default,Fuk,0,0,0,,Fuko hoàn toàn không hiểu nổi anh đang nói cái gì hết.
Dialogue: 0,0:12:30.44,0:12:35.74,Default,Oka,0,0,0,,Nếu trước mặt em có một cái nút ghi chữ 'Cấm bấm', em sẽ làm gì?
Dialogue: 0,0:12:35.74,0:12:38.03,Default,Fuk,0,0,0,,Fuko sẽ lén lút trốn đi rồi ấn nó ngay lập tức.
Dialogue: 0,0:12:38.70,0:12:41.08,Default,Oka,0,0,0,,Đó chính là nút phóng tên lửa hạt nhân đấy.
Dialogue: 0,0:12:41.45,0:12:44.41,Default,Fuk,0,0,0,,Chơi bẩn quá! Anh lừa Fuko!
Dialogue: 0,0:12:44.41,0:12:47.25,Default,Oka,0,0,0,,Thế giới này chưa đầy ba ngày là đã nổ tung rồi.
Dialogue: 0,0:12:47.88,0:12:49.88,Default,Fuk,0,0,0,,Thế thì Fuko cũng có một câu hỏi dành cho anh đây.
Dialogue: 0,0:12:49.88,0:12:56.43,Default,Fuk,0,0,0,,Nếu có một chiếc quần tất rơi trên mặt đất\Nghi chữ 'Cấm mặc', anh sẽ làm gì?
Dialogue: 0,0:12:56.43,0:12:58.14,Default,Oka,0,0,0,,Tôi sẽ mặc kệ nó.
Dialogue: 0,0:12:58.14,0:13:03.39,Default,Fuk,0,0,0,,Anh nói dối! Fuko chắc chắn anh sẽ không kiềm chế nổi mà xỏ ngay vào chân cho xem!
Dialogue: 0,0:13:04.14,0:13:06.14,Default,Oka,0,0,0,,Okazaki đúng là đồ biến thái nhất trần đời!
Dialogue: 0,0:13:10.32,0:13:13.32,Default,Fuk,0,0,0,,Thế giới này tận thế là do chính em đấy.
Dialogue: 0,0:13:16.24,0:13:20.20,Default,Fuk,0,0,0,,Hơi muộn một chút, nhưng anh không bỏ thuốc ngủ vào đây đấy chứ?
Dialogue: 0,0:13:20.20,0:13:25.71,Default,Oka,0,0,0,,Dù em có ngủ say như chết thì cho tiền tôi cũng chẳng thèm đụng vào em đâu, nên cứ yên tâm.
Dialogue: 0,0:13:26.29,0:13:31.63,Default,Fuk,0,0,0,,Ý-Ý anh là anh quan tâm đến Fuko đến mức đó sao?
Dialogue: 0,0:13:31.63,0:13:33.21,Default,Oka,0,0,0,,Có cái quỷ ấy!
Dialogue: 0,0:13:33.21,0:13:34.92,Default,Fuk,0,0,0,,Anh không cần phải che giấu đâu.
Dialogue: 0,0:13:34.92,0:13:35.84,Default,Oka,0,0,0,,Ai bảo tôi giấu cơ chứ?!
Dialogue: 0,0:13:35.84,0:13:37.38,Default,Fuk,0,0,0,,Chính là anh đấy.
Dialogue: 0,0:13:37.72,0:13:38.89,Default,Oka,0,0,0,,Cái con nhỏ này...
Dialogue: 0,0:13:38.89,0:13:40.97,Default,Oka,0,0,0,,Đủ rồi! Tôi không thèm nói chuyện với em nữa!
Dialogue: 0,0:13:40.43,0:13:42.14,Default-alt,Fuk,0,0,0,,Anh ngượng ngùng rồi đúng không?
Dialogue: 0,0:13:43.89,0:13:46.23,Default,Fuk,0,0,0,,Vậy thì, chúng ta cùng chơi bài đi.
Dialogue: 0,0:13:46.68,0:13:50.77,Default,Fuk,0,0,0,,Ushio-chan, em có biết chơi blackjack hay gin rummy không?
Dialogue: 0,0:13:50.77,0:13:53.23,Default,Oka,0,0,0,,Này. Em đang nói chuyện với một đứa nhóc năm tuổi đấy.
Dialogue: 0,0:13:54.48,0:14:00.70,Default,Fuk,0,0,0,,Xin lỗi nhé. Tại Fuko là người lớn rồi,\Nnên Fuko mới gợi ý mấy trò cao cấp một chút.
Dialogue: 0,0:14:02.16,0:14:04.74,Default,Oka,0,0,0,,Con có biết trò chơi nào không, Ushio?
Dialogue: 0,0:14:07.54,0:14:08.50,Default,Ush,0,0,0,,Nối số bảy ạ!
Dialogue: 0,0:14:09.17,0:14:11.79,Default,Fuk,0,0,0,,Ushio-chan, lựa chọn tuyệt vời nhất luôn!
Dialogue: 0,0:14:11.79,0:14:13.75,Default,Fuk,0,0,0,,Trò đó dễ gây nghiện lắm đấy!
Dialogue: 0,0:14:13.75,0:14:15.38,Default,Oka,0,0,0,,Em đúng là trẻ con thật.
Dialogue: 0,0:14:17.09,0:14:20.18,Default,Fuk,0,0,0,,Okazaki-san, anh đang giấu con mười cơ đúng không?
Dialogue: 0,0:14:20.18,0:14:23.47,Default,Oka,0,0,0,,Thì tại tôi vẫn còn nhiều quân khác có thể đánh mà.
Dialogue: 0,0:14:24.18,0:14:26.10,Default,Oka,0,0,0,,Đến lượt con rồi đấy Ushio.
Dialogue: 0,0:14:26.98,0:14:27.89,Default,Ush,0,0,0,,Đây ạ!
Dialogue: 0,0:14:27.89,0:14:30.06,Default,Fuk,0,0,0,,Hay lắm, Ushio-chan!
Dialogue: 0,0:14:30.06,0:14:32.69,Default,Fuk,0,0,0,,Giờ thì Fuko đã lật ngược thế cờ rồi.
Dialogue: 0,0:14:32.69,0:14:35.57,Default,Oka,0,0,0,,Chết tiệt, uổng công mình dồn ép em ấy vào chân tường.
Dialogue: 0,0:14:35.57,0:14:40.74,Default,Fuk,0,0,0,,Chỉ qua nước đi đó thôi, cũng đủ thấy Ushio-chan yêu quý Fuko hơn anh nhiều rồi.
Dialogue: 0,0:14:40.74,0:14:41.82,Default,Oka,0,0,0,,Làm gì có chuyện đó!
Dialogue: 0,0:14:42.41,0:14:43.41,Default,Fuk,0,0,0,,Đáng đời anh chưa.
Dialogue: 0,0:14:49.71,0:14:51.83,Default,Oka,0,0,0,,Nếu như em còn sống...
Dialogue: 0,0:15:01.76,0:15:04.01,Default,Fuk,0,0,0,,Okazaki-san. Okazaki-san.
Dialogue: 0,0:15:07.85,0:15:09.31,Default,Oka,0,0,0,,Xin lỗi. Đến lượt tôi rồi đúng không?
Dialogue: 0,0:15:11.23,0:15:15.69,Default,Fuk,0,0,0,,Hóa ra là anh nhìn thấy bóng hình của vợ mình nơi Fuko thật rồi.
Dialogue: 0,0:15:15.69,0:15:17.69,Default,Oka,0,0,0,,Tôi đã bảo là không đời nào có chuyện đó rồi mà.
Dialogue: 0,0:15:18.19,0:15:20.19,Default,Fuk,0,0,0,,Có lẽ tính cách của tụi em khác nhau chăng?
Dialogue: 0,0:15:20.19,0:15:23.24,Default,Fuk,0,0,0,,Chẳng lẽ vợ anh là một người có tính tình rất trẻ con sao?
Dialogue: 0,0:15:23.24,0:15:26.74,Default,Oka,0,0,0,,Tôi chẳng thấy ai trên đời này trẻ con hơn em đâu.
Dialogue: 0,0:15:26.74,0:15:30.66,Default,Fuk,0,0,0,,Em chưa từng được gặp mẹ mình lần nào đúng không?
Dialogue: 0,0:15:30.66,0:15:33.54,Default,Oka,0,0,0,,Đúng vậy. Con bé chỉ biết mặt mẹ qua những bức ảnh thôi.
Dialogue: 0,0:15:34.17,0:15:37.46,Default,Ush,0,0,0,,Nhưng con được nghe bố kể rất nhiều chuyện về mẹ ạ.
Dialogue: 0,0:15:39.30,0:15:41.84,Default,Fuk,0,0,0,,Mẹ em là người như thế nào vậy?
Dialogue: 0,0:15:42.47,0:15:43.80,Default,Ush,0,0,0,,Dạ...
Dialogue: 0,0:15:44.68,0:15:47.01,Default,Ush,0,0,0,,Một người rất hay mít ướt.
Dialogue: 0,0:15:47.81,0:15:52.02,Default,Ush,0,0,0,,Nhưng là người đã cố gắng hết sức mình để sinh ra con.
Dialogue: 0,0:15:53.94,0:15:57.52,Default,Ush,0,0,0,,Và là người mà bố vô cùng, vô cùng yêu thương ạ!
Dialogue: 0,0:16:05.07,0:16:05.95,Default,Fuk,0,0,0,,Dạ...
Dialogue: 0,0:16:07.91,0:16:09.12,Default,Oka,0,0,0,,Xin lỗi hai người nhé.
Dialogue: 0,0:16:09.12,0:16:11.08,Default,Oka,0,0,0,,Đôi lúc hình bóng cô ấy cứ ùa về trong tâm trí tôi như vậy.
Dialogue: 0,0:16:12.62,0:16:15.58,Default,Fuk,0,0,0,,Fuko rảnh rỗi lắm, nên bất cứ khi nào anh cần cứ gọi nhé.
Dialogue: 0,0:16:17.00,0:16:19.38,Default,Fuk,0,0,0,,Bất cứ khi nào anh gọi, Fuko cũng sẽ đến ngay.
Dialogue: 0,0:16:19.38,0:16:21.84,Default,Fuk,0,0,0,,Fuko sẽ làm tất cả những gì Fuko có thể.
Dialogue: 0,0:16:23.26,0:16:25.84,Default,Oka,0,0,0,,Em đang cố tỏ ra tốt bụng đấy à?
Dialogue: 0,0:16:25.84,0:16:30.52,Default,Fuk,0,0,0,,Đâu phải thế, Fuko chỉ muốn đến chơi với Ushio-chan thôi mà.
Dialogue: 0,0:16:30.81,0:16:32.10,Default,Oka,0,0,0,,À, ra vậy.
Dialogue: 0,0:16:33.18,0:16:35.98,Default,Fuk,0,0,0,,Giờ Fuko phải về nhà đây!
Dialogue: 0,0:16:35.98,0:16:38.02,Default,Oka,0,0,0,,Chỉ cần chào tạm biệt là được rồi.
Dialogue: 0,0:16:38.02,0:16:40.48,Default,Fuk,0,0,0,,Đi thôi nào Ushio-chan.
Dialogue: 0,0:16:40.48,0:16:42.32,Default,Oka,0,0,0,,Này, này, này, này!
Dialogue: 0,0:16:43.74,0:16:47.99,Default,Fuk,0,0,0,,Thôi được rồi. Tương lai vẫn còn nhiều cơ hội mà.
Dialogue: 0,0:16:47.99,0:16:51.12,Default,Fuk,0,0,0,,Buổi tối đi ngủ nhớ cẩn thận nhé.
Dialogue: 0,0:16:51.91,0:16:54.12,Default,Fuk,0,0,0,,Hễ nhìn thấy em trên phố là Fuko sẽ ra chào hỏi ngay đấy.
Dialogue: 0,0:16:54.62,0:16:59.67,Default,Fuk,0,0,0,,Fuko đã ghi nhớ mùi hương của Ushio-chan rồi, nên chỉ cần ở gần là Fuko nhận ra ngay.
Dialogue: 0,0:16:59.67,0:17:00.92,Default,Oka,0,0,0,,Em là thú săn mồi đấy à?
Dialogue: 0,0:17:00.92,0:17:03.51,Default,Fuk,0,0,0,,Lúc đó chúng mình lại cùng chơi với nhau nhé.
Dialogue: 0,0:17:04.05,0:17:04.72,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:17:10.43,0:17:11.93,Default,Fuk,0,0,0,,Tạm biệt em nhé.
Dialogue: 0,0:17:11.93,0:17:13.68,Default,Ush,0,0,0,,Dạ. Tạm biệt chị ạ.
Dialogue: 0,0:17:18.15,0:17:19.36,Default,Oka,0,0,0,,Mệt thật đấy.
Dialogue: 0,0:17:19.36,0:17:21.32,Default,Ush,0,0,0,,Chị ấy vui tính thật bố nhỉ.
Dialogue: 0,0:17:21.77,0:17:23.53,Default,Oka,0,0,0,,Ừ, điều đó thì công nhận là đúng thật.
Dialogue: 0,0:17:24.15,0:17:27.49,Default,Oka,0,0,0,,Hai bố con mình dọn dẹp rồi đi tắm nhé con?
Dialogue: 0,0:17:27.49,0:17:27.99,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:17:39.33,0:17:42.38,Default,Oka,0,0,0,,Botan không giận khi con bé trèo lên lưng thế sao?
Dialogue: 0,0:17:42.38,0:17:46.01,Default,Kyo,0,0,0,,Tôi nghĩ nó coi đó là màn đấm bóp lưng nên thích thú lắm đấy.
Dialogue: 0,0:17:44.26,0:17:46.01,Default-alt,Bot,0,0,0,,Gột, gột.
Dialogue: 0,0:17:46.55,0:17:50.76,Default,Kyo,0,0,0,,Ushio-chan! Ông bố vô dụng của em đến đón rồi kìa!
Dialogue: 0,0:17:53.35,0:17:54.93,Default,Ush,0,0,0,,Mừng bố đã về!
Dialogue: 0,0:17:54.93,0:17:56.02,Default,Oka,0,0,0,,Xin lỗi vì để con phải đợi nhé.
Dialogue: 0,0:17:56.31,0:17:59.23,Default,Kyo,0,0,0,,Chà, trên mặt cậu lộ rõ mồn một vẻ cưng chiều con gái rồi đấy.
Dialogue: 0,0:17:59.23,0:18:03.07,Default,Kyo,0,0,0,,Ushio-chan, chúng ta nên xử lý ông bố thảm hại này thế nào đây?
Dialogue: 0,0:18:04.07,0:18:05.99,Default,Ush,0,0,0,,Bố ngầu lắm đấy ạ.
Dialogue: 0,0:18:07.11,0:18:09.36,Default,Oka,0,0,0,,Con bé có mắt nhìn đàn ông chuẩn thật đấy.
Dialogue: 0,0:18:12.28,0:18:17.62,Default,Kyo,0,0,0,,Tôi đã phát giấy thông báo ngày hội thể thao cho Ushio-chan rồi,\Ncậu nhớ đọc kỹ nhé?
Dialogue: 0,0:18:17.62,0:18:18.50,Default,Oka,0,0,0,,Ngày hội thể thao sao?
Dialogue: 0,0:18:18.50,0:18:23.71,Default,Kyo,0,0,0,,Ừ. Có cả các phần thi dành cho gia đình nữa,\Nnên cậu lo mà tập luyện đi nhé.
Dialogue: 0,0:18:25.21,0:18:27.72,Default,San,0,0,0,,Tôi có biết về ngày hội thể thao rồi.
Dialogue: 0,0:18:28.22,0:18:31.22,Default,San,0,0,0,,Bác tổ trưởng dân phố có nói qua với tôi.
Dialogue: 0,0:18:31.22,0:18:33.89,Default,Oka,0,0,0,,Vậy cô sẽ đến cổ vũ cho con bé chứ?
Dialogue: 0,0:18:33.89,0:18:34.72,Default,San,0,0,0,,Có chứ.
Dialogue: 0,0:18:35.10,0:18:37.02,Default,San,0,0,0,,Nhưng thay vì chỉ đứng cổ vũ...
Dialogue: 0,0:18:38.64,0:18:40.14,Default,Ush,0,0,0,,Akki!
Dialogue: 0,0:18:40.85,0:18:43.23,Default,Aki,0,0,0,,Chào bé Ushio. Không ngờ nhóc cũng ở đây đấy.
Dialogue: 0,0:18:43.23,0:18:44.90,Default,Oka,0,0,0,,Bộ đồ đó là sao thế chú?
Dialogue: 0,0:18:45.27,0:18:48.69,Default,Aki,0,0,0,,Đương nhiên là chạy bộ để chuẩn bị cho ngày hội thể thao rồi.
Dialogue: 0,0:18:49.53,0:18:51.49,Default,Aki,0,0,0,,Ta không thể ngồi yên một chỗ được.
Dialogue: 0,0:18:51.49,0:18:52.99,Default,Oka,0,0,0,,Làm gì có chuyện đó trong chương trình chứ.
Dialogue: 0,0:18:53.66,0:19:01.92,Default,San,0,0,0,,{\fs70.2}Chú Akio chạy rất nhanh,\Nnên được nhờ chạy chặng cuối cho đội giáo viên thay thầy hiệu trưởng bị đau lưng đấy.
Dialogue: 0,0:19:02.46,0:19:04.59,Default,Aki,0,0,0,,Cậu sẽ ở trong đội phụ huynh đúng không?
Dialogue: 0,0:19:04.59,0:19:06.13,Default,Aki,0,0,0,,Đây sẽ là trận quyết đấu sống còn giữa hai chúng ta.
Dialogue: 0,0:19:06.13,0:19:08.84,Default,San,0,0,0,,Tình thế thật là gay cấn và hào hứng làm sao!
Dialogue: 0,0:19:08.84,0:19:10.34,Default,Oka,0,0,0,,Xin hãy đợi cho tôi một chút đã!
Dialogue: 0,0:19:10.34,0:19:12.84,Default,Oka,0,0,0,,Tôi đã quyết định tham gia chạy tiếp sức đâu chứ.
Dialogue: 0,0:19:12.09,0:19:16.72,Default-alt,Aki,0,0,0,,Sanae, bảo thầy hiệu trưởng xếp nó chạy chặng cuối cho đội phụ huynh nhé.
Dialogue: 0,0:19:16.89,0:19:17.89,Default,San,0,0,0,,Em sẽ báo ngay ạ.
Dialogue: 0,0:19:18.43,0:19:19.77,Default,Oka,0,0,0,,Hai người này ép người quá đáng thật đấy.
Dialogue: 0,0:19:20.48,0:19:21.10,Default,Ush,0,0,0,,Bố ơi.
Dialogue: 0,0:19:22.06,0:19:23.48,Default,Ush,0,0,0,,Cố lên nhé bố.
Dialogue: 0,0:19:26.27,0:19:29.28,Default,Oka,0,0,0,,Được rồi! Bố nhất định sẽ cố gắng hết sức mình!
Dialogue: 0,0:19:29.28,0:19:30.61,Default,Ush,0,0,0,,Cố gắng hết sức!
Dialogue: 0,0:19:32.82,0:19:34.45,Default,Yos,0,0,0,,Cậu đang làm cái trò gì đấy?
Dialogue: 0,0:19:34.99,0:19:38.33,Default,Oka,0,0,0,,Tôi không thể để lộ bộ dạng thảm hại trước mặt con gái mình được.
Dialogue: 0,0:19:56.14,0:19:57.22,Default,Fuk,0,0,0,,Ushio-chan!
Dialogue: 0,0:19:58.64,0:20:00.43,Default,Ush,0,0,0,,Chị Fuko.
Dialogue: 0,0:20:01.48,0:20:04.52,Default,Fuk,0,0,0,,Em thích đi dạo một mình thế sao?
Dialogue: 0,0:20:04.52,0:20:05.44,Default,Ush,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:20:06.02,0:20:08.69,Default,Fuk,0,0,0,,Em không sợ bị lạc đường à?
Dialogue: 0,0:20:09.15,0:20:10.32,Default,Ush,0,0,0,,Lạc đường ạ?
Dialogue: 0,0:20:10.32,0:20:17.28,Default,Fuk,0,0,0,,Là khi em không biết phải đi lối nào,\Ncảm thấy bất an, bối rối và không thể bước tiếp được nữa.
Dialogue: 0,0:20:17.66,0:20:20.12,Default,Fuk,0,0,0,,Em không sợ chuyện đó sao?
Dialogue: 0,0:20:20.45,0:20:21.45,Default,Ush,0,0,0,,Dạ không ạ.
Dialogue: 0,0:20:21.45,0:20:23.16,Default,Fuk,0,0,0,,Em giỏi thật đấy.
Dialogue: 0,0:20:23.58,0:20:25.54,Default,Fuk,0,0,0,,Fuko cần phải học tập điều đó từ em rồi.
Dialogue: 0,0:20:26.17,0:20:30.59,Default,Fuk,0,0,0,,Nhưng Fuko nghĩ một bé gái nhỏ đi một mình ngoài đường thì nguy hiểm lắm.
Dialogue: 0,0:20:31.80,0:20:33.97,Default,Fuk,0,0,0,,Ushio-chan, em định đi đâu thế?
Dialogue: 0,0:20:41.56,0:20:43.68,Default,Fuk,0,0,0,,Đó là bệnh viện mới ạ.
Dialogue: 0,0:20:43.68,0:20:52.78,Signs,,0,0,0,,{\fs27\fnArial\b1\frz351.049\pos(930,85.5)\c&H693C46&}Bệnh viện Đa khoa Hikarizaka
Dialogue: 0,0:20:45.19,0:20:47.44,Default,Fuk,0,0,0,,Em thích chỗ này sao?
Dialogue: 0,0:20:47.44,0:20:48.19,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:20:49.32,0:20:50.65,Default,Fuk,0,0,0,,Tại sao thế?
Dialogue: 0,0:20:50.98,0:20:52.28,Default,Ush,0,0,0,,Chỉ là... tự nhiên thôi ạ.
Dialogue: 0,0:20:53.49,0:20:55.78,Default,Fuk,0,0,0,,Tự nhiên thôi sao em?
Dialogue: 0,0:21:27.56,0:21:29.44,Default,Aki,0,0,0,,Cuối cùng ngày mai cũng đến rồi.
Dialogue: 0,0:21:29.44,0:21:32.65,Default,Oka,0,0,0,,Ừ! Ngày mai tôi sẽ cho chú biết tay!
Dialogue: 0,0:21:40.62,0:21:43.41,Default,San,0,0,0,,Ushio, hai bố con mình mong ngóng ngày mai đến lắm rồi đúng không con?
Dialogue: 0,0:21:47.00,0:21:48.17,Default,Oka,0,0,0,,Sao thế con, Ushio?
Dialogue: 0,0:21:49.67,0:21:52.80,Default,Ush,0,0,0,,Con không thể tự đi vệ sinh được nữa rồi.
Dialogue: 0,0:21:58.09,0:21:59.30,Default,Oka,0,0,0,,Con làm sao thế này, Ushio?!
Dialogue: 0,0:22:00.68,0:22:02.31,Default,Oka,0,0,0,,Người con bé nóng ran lên rồi.
Dialogue: 0,0:22:05.85,0:22:09.81,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad3\bord0.75\3c&H000000&\blur0.5\pos(1462.5,840)}Còn tiếp
Dialogue: 0,0:22:18.74,0:22:26.25,ED Romaji,,0,0,0,,{\be1}{\kf24}mi{\kf32}tsu{\kf23}me{\kf23}te {\kf19}i{\kf137}ta {\kf29}na{\kf28}ga{\kf21}re{\kf69}ru {\kf60}ku{\kf61}mo {\kf230}wo
Dialogue: 0,0:22:18.74,0:22:26.25,ED English,,0,0,0,,{\be1}Tôi mải mê dõi theo những áng mây trôi bồng bềnh.
Dialogue: 0,0:22:26.25,0:22:33.30,ED Romaji,,0,0,0,,{\be1\fad(0,250)}{\kf40}ka{\kf11}n{\kf24}ji{\kf21}te {\kf30}i{\kf135}ta {\kf28}ka{\kf23}wa{\kf19}ru {\kf68}so{\kf63}ra {\kf37}no {\kf45}i{\kf26}ro {\kf130}wo
Dialogue: 0,0:22:26.25,0:22:33.30,ED English,,0,0,0,,{\be1\fad(0,250)}Tôi cảm nhận được từng sự đổi thay của sắc trời.
Dialogue: 0,0:22:33.80,0:22:41.35,ED Romaji,,0,0,0,,{\be1}{\kf25}ta{\kf31}chi {\kf20}to{\kf27}ma{\kf21}t{\kf142}ta {\kf22}bo{\kf23}ku{\kf26}ra {\kf66}wa {\kf63}ki{\kf59}zu{\kf229}ku
Dialogue: 0,0:22:33.80,0:22:41.35,ED English,,0,0,0,,{\be1}Khi đôi chân ta khẽ dừng bước,
