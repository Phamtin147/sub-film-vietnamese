Dialogue: 0,0:18:41.56,0:18:41.69,Signs,,0,0,0,,{\fnThrow My Hands Up in the Air\fs72\b1\c&H3D455B&\frz357.934\pos(855,684)\blur1}Xin hãy kéo tôi\NSẽ vui lắm đấy
Dialogue: 0,0:18:41.69,0:18:41.81,Signs,,0,0,0,,{\fnThrow My Hands Up in the Air\fs72\b1\c&H3D455B&\frz357.934\pos(856.5,784.5)\blur1}Xin hãy kéo tôi\NSẽ vui lắm đấy
Dialogue: 0,0:19:23.06,0:19:24.94,Default,Guy,0,0,0,,Thôi chết rồi, cô ấy ngất lịm đi rồi!
Dialogue: 0,0:19:24.94,0:19:26.98,Default,Guy,0,0,0,,Phòng y tế! Mau đưa cô ấy đến phòng y tế nhanh lên!
Dialogue: 0,0:19:27.44,0:19:29.11,Default,Sun,0,0,0,,Này Okazaki...
Dialogue: 0,0:19:29.11,0:19:31.36,Default,Oka,0,0,0,,Ừ, đúng là có kẻ đần thật rồi.
Dialogue: 0,0:19:31.36,0:19:33.36,Signs,,0,0,0,,{\fnArial\fs63\b1\an9\frx18\fry350\frz17.145\pos(1195.5,219)\c&H0C3C6C&}Phòng Y Tế
Dialogue: 0,0:19:37.12,0:19:39.04,Default,Girl,0,0,0,,Furukawa-san, cậu có sao không?
Dialogue: 0,0:19:39.33,0:19:42.50,Default,Nag,0,0,0,,Dạ có. Nhưng đầu tớ vẫn còn thấy đau lắm.
Dialogue: 0,0:19:44.88,0:19:47.80,Default,Girl,0,0,0,,Đó là trò chơi xỏ của ai đó đấy.
Dialogue: 0,0:19:47.80,0:19:49.88,Default,Girl,0,0,0,,Lúc đó tớ đi ngay đằng sau cậu.
Dialogue: 0,0:19:49.88,0:19:52.30,Default,Girl,0,0,0,,Trông y hệt như một cảnh trong phim hài của nhóm The Drifters ấy, làm tớ không nhịn được cười.
Dialogue: 0,0:19:49.88,0:19:52.30,Note,,0,0,0,,{\fad(0,500)}Chú thích: The Drifters là nhóm hài cổ điển nổi tiếng với trò chậu đồng rơi trúng đầu
Dialogue: 0,0:19:53.13,0:19:53.89,Default,Girl,0,0,0,,Tớ xin lỗi nhé.
Dialogue: 0,0:19:54.72,0:19:56.68,Default,Nag,0,0,0,,Tớ hoàn toàn không sao đâu ạ.
Dialogue: 0,0:19:56.68,0:20:00.64,Default,Girl,0,0,0,,Tớ đã muốn trò chuyện với cậu từ lâu lắm rồi.
Dialogue: 0,0:20:00.64,0:20:04.90,Default,Girl,0,0,0,,Tớ nghe Kimura-san kể rằng cậu là một người rất tốt bụng.
Dialogue: 0,0:20:04.90,0:20:06.90,Default,Nag,0,0,0,,Từ Kimura-san sao ạ?
Dialogue: 0,0:20:08.27,0:20:11.03,Default,Girl,0,0,0,,Tớ rất vui vì cuối cùng cũng có cơ hội bắt chuyện với cậu.
Dialogue: 0,0:20:11.40,0:20:14.16,Default,Girl,0,0,0,,Nếu không phiền thì cậu làm bạn với tớ nhé?
Dialogue: 0,0:20:14.82,0:20:17.66,Default,Nag,0,0,0,,Vâng! Nhưng tớ...
Dialogue: 0,0:20:23.92,0:20:27.67,Default,Nag,0,0,0,,Tớ cũng vậy. Chúng mình cùng làm bạn nhé.
Dialogue: 0,0:20:27.67,0:20:29.55,Default,Girls,0,0,0,,Tuyệt quá, cảm ơn cậu nhiều nhé.
Dialogue: 0,0:20:37.51,0:20:41.02,Default,Kyo,0,0,0,,Làm cô nuôi dạy trẻ cũng mệt mỏi đến mức này sao?
Dialogue: 0,0:20:41.02,0:20:42.81,Default,Ryo,0,0,0,,Có chuyện gì xảy ra thế chị?
Dialogue: 0,0:20:43.48,0:20:46.23,Default,Kyo,0,0,0,,Trong lớp chị có một tên rắc rối chuyên gia đầu têu phá phách.
Dialogue: 0,0:20:46.23,0:20:48.52,Default,Kyo,0,0,0,,Ngày nào cũng như cực hình ấy.
Dialogue: 0,0:20:48.52,0:20:52.36,Default,Ryo,0,0,0,,Nhưng nhìn vẻ mặt chị đâu có vẻ gì là ghét chuyện đó đâu.
Dialogue: 0,0:20:53.07,0:20:55.91,Default,Kyo,0,0,0,,Ừ, chị đoán là chị cũng chẳng để bụng lắm.
Dialogue: 0,0:20:57.03,0:20:59.53,Default,Kyo,0,0,0,,Này, ngực chị dạo này lại to ra nữa đấy à?
Dialogue: 0,0:21:06.54,0:21:08.54,Default,Oka,0,0,0,,Lần này mày lại định bày trò gì nữa thế?
Dialogue: 0,0:21:08.54,0:21:11.17,Default,Sun,0,0,0,,Kế hoạch Bức Thư Tình phần 2.
Dialogue: 0,0:21:11.55,0:21:17.05,Default,Sun,0,0,0,,Lần này tao sẽ đóng giả làm đàn em khóa dưới trúng tiếng sét ái tình.
Dialogue: 0,0:21:19.60,0:21:22.18,Default,Oka,0,0,0,,Bọn mình đúng là rảnh rỗi sinh nông nổi thật đấy.
Dialogue: 0,0:21:24.73,0:21:28.77,Default,Nag,0,0,0,,Đó là lần đầu tiên con nói chuyện với bạn ấy,\Nnên con có một chút hồi hộp.
Dialogue: 0,0:21:28.77,0:21:32.02,Default,Nag,0,0,0,,Nhưng bạn ấy là một người rất dịu dàng và vui tính ạ.
Dialogue: 0,0:21:32.02,0:21:34.03,Default,San,0,0,0,,Thế thì tốt quá rồi con.
Dialogue: 0,0:21:34.03,0:21:37.03,Default,Nag,0,0,0,,Vâng ạ. Nhưng tất cả là nhờ có món đồ này đấy ạ.
Dialogue: 0,0:21:37.53,0:21:39.66,Default,Aki,0,0,0,,Đó là dải băng trong quả cầu chúc mừng rơi ra sao?
Dialogue: 0,0:21:39.66,0:21:43.12,Default,Nag,0,0,0,,Vâng. Con đã giữ nó lại làm kỷ niệm.
Dialogue: 0,0:21:43.12,0:21:47.16,Default,Nag,0,0,0,,Nhờ có nó mà con mới gom đủ can đảm để cất lời chào.
Dialogue: 0,0:21:48.50,0:21:51.59,Default,Nag,0,0,0,,'Đừng chịu khuất phục trước những trở ngại phía trước.'
Dialogue: 0,0:21:54.63,0:21:58.63,Default,Nag,0,0,0,,Cảm ơn người có chữ kanji khó đọc nhiều lắm ạ.
