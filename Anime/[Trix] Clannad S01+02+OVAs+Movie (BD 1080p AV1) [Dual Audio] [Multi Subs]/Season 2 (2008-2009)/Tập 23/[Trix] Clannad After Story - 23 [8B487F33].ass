Dialogue: 0,0:02:54.87,0:02:59.37,Default,Sun,0,0,0,,Sao việc đầu tiên mình phải làm khi lên lớp 11 lại là dọn dẹp thế này?
Dialogue: 0,0:02:59.37,0:03:02.08,Default,Oka,0,0,0,,Đó là vì chúng ta trốn tiết thất bại chứ sao.
Dialogue: 0,0:03:06.55,0:03:07.63,Default,Teacher,0,0,0,,Hai cái tên kia!
Dialogue: 0,0:03:12.38,0:03:13.84,Default,Sun,0,0,0,,Chịu hết nổi rồi đấy.
Dialogue: 0,0:03:14.60,0:03:17.06,Default,Kyo,0,0,0,,Tôi mới là người chịu hết nổi đây này!
Dialogue: 0,0:03:17.06,0:03:20.93,Default,Kyo,0,0,0,,Tại sao tôi lại phải đứng đây canh chừng hai tên dở hơi các cậu cơ chứ?!
Dialogue: 0,0:03:20.93,0:03:23.15,Default,Sun,0,0,0,,Thế thì ngay từ đầu cậu cứ để tụi này chuồn đi có phải xong rồi không.
Dialogue: 0,0:03:23.15,0:03:26.19,Default,Sun,0,0,0,,Bọn tôi bị bắt ở đây cũng là do cậu mách-
Dialogue: 0,0:03:26.52,0:03:29.57,Default,Kyo,0,0,0,,Cái đó người ta gọi là oán trách vô cớ đấy!
Dialogue: 0,0:03:29.57,0:03:34.62,Default,Kyo,0,0,0,,Nếu các cậu không hiểu từ đó nghĩa là gì, có muốn tôi bổ đôi đầu các cậu ra rồi nện nó vào não không?
Dialogue: 0,0:03:34.62,0:03:35.99,Default,Sun,0,0,0,,Ánh mắt bà chằn đó nghiêm túc thật đấy.
Dialogue: 0,0:03:36.58,0:03:41.00,Default,Kyo,0,0,0,,Bởi thế tôi mới chẳng thèm muốn nhận cái chức lớp trưởng này!
Dialogue: 0,0:03:41.00,0:03:43.83,Default,Oka,0,0,0,,Thế thì dọn cho nhanh rồi về thôi.
Dialogue: 0,0:03:43.83,0:03:46.71,Default,Oka,0,0,0,,Chẳng ai muốn tốn thời gian vào cái việc này cả.
Dialogue: 0,0:03:46.71,0:03:48.50,Default,Kyo,0,0,0,,Tên cậu là gì ấy nhỉ?
Dialogue: 0,0:03:49.05,0:03:50.71,Default,Oka,0,0,0,,Okazaki Tomoya.
Dialogue: 0,0:03:50.71,0:03:51.51,Default,Oka,0,0,0,,Còn cậu?
Dialogue: 0,0:03:51.51,0:03:54.09,Default,Kyo,0,0,0,,Tôi không có tên để xưng cho mấy tên cá biệt.
Dialogue: 0,0:03:55.64,0:03:58.31,Default,Oka,0,0,0,,Tôi đã xưng tên rồi thì cậu cũng phải nói tên mình ra chứ!
Dialogue: 0,0:03:58.31,0:04:01.35,Default,Kyo,0,0,0,,Không đời nào. Tôi chẳng có hứng làm quen với mấy tên ngốc.
Dialogue: 0,0:04:01.35,0:04:03.73,Default,Oka,0,0,0,,Tính cách cậu 'tuyệt vời' thật đấy.
Dialogue: 0,0:04:03.73,0:04:06.81,Default,Kyo,0,0,0,,Này, xem ra cậu cũng có mắt nhìn người đấy chứ.
Dialogue: 0,0:04:06.81,0:04:10.03,Default,Kyo,0,0,0,,Cậu có muốn được tôi cho phép nói chuyện cùng không?
Dialogue: 0,0:04:10.03,0:04:11.57,Default,Kyo,0,0,0,,Lại bắt đầu giở chứng rồi đấy!
Dialogue: 0,0:04:13.32,0:04:14.28,Default,Oka,0,0,0,,Đồ ngốc này!
Dialogue: 0,0:04:20.12,0:04:22.50,Default,Kyo,0,0,0,,N-Này, tránh xa ra coi!
Dialogue: 0,0:04:22.50,0:04:24.62,Default,Oka,0,0,0,,Tôi vừa cứu cậu một bàn thua trông thấy mà cậu đáp lại thế à?
Dialogue: 0,0:04:25.17,0:04:28.38,Default,Sun,0,0,0,,Này, tôi không có ổn chút nào đâu đấy nhé.
Dialogue: 0,0:04:28.71,0:04:32.38,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập Ngoại Truyện
Dialogue: 0,0:04:28.71,0:04:32.38,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Chuyện Của Một Năm Về Trước
Dialogue: 0,0:04:33.47,0:04:37.76,Default,Kyo,0,0,0,,Không biết cậu có xứng đáng nhận lời cảm ơn không, nhưng lần này tôi tạm cảm ơn cậu vậy.
Dialogue: 0,0:04:37.76,0:04:39.76,Default,Kyo,0,0,0,,Tốt nhất là cậu nên biết ơn đi.
Dialogue: 0,0:04:40.68,0:04:42.64,Default,Kyo,0,0,0,,Tôi là Fujibayashi Kyou.
Dialogue: 0,0:04:42.64,0:04:46.56,Default,Kyo,0,0,0,,Tôi sẽ học cùng lớp với các cậu trong một năm tới,\Nnhưng liệu hồn đừng có gây chuyện rắc rối cho tôi, nghe rõ chưa?
Dialogue: 0,0:04:46.56,0:04:47.98,Default,Oka,0,0,0,,Fujibayashi à?
Dialogue: 0,0:04:47.98,0:04:50.73,Default,Oka,0,0,0,,Ở lớp bên cạnh cũng có một người họ Fujibayashi thì phải?
Dialogue: 0,0:04:50.73,0:04:52.23,Default,Kyo,0,0,0,,Đó là em gái sinh đôi của tôi.
Dialogue: 0,0:04:52.78,0:04:55.70,Default,Kyo,0,0,0,,Dễ nhầm lẫn lắm, nên cứ gọi tôi là Kyou là được.
Dialogue: 0,0:04:56.28,0:04:56.86,Default,Kyo,0,0,0,,Chào nhé.
Dialogue: 0,0:04:58.07,0:05:00.95,Default,Sun,0,0,0,,Chúng ta vừa làm quen với một cô nàng kỳ lạ thật đấy.
Dialogue: 0,0:05:00.95,0:05:03.58,Default,Oka,0,0,0,,Tao cá là cô ta cũng đang nghĩ y hệt như vậy về chúng mình.
Dialogue: 0,0:05:03.58,0:05:06.04,Default,Sun,0,0,0,,Giờ làm gì tiếp đây?
Dialogue: 0,0:05:06.04,0:05:07.96,Default,Oka,0,0,0,,Lượn lờ quanh ga tàu đi.
Dialogue: 0,0:05:07.96,0:05:10.29,Default,Oka,0,0,0,,Dù sao thì chúng ta cũng chẳng có việc gì khác để làm.
Dialogue: 0,0:05:10.29,0:05:11.25,Default,Sun,0,0,0,,Mày nói phải.
Dialogue: 0,0:05:14.17,0:05:15.51,Default,Nag,0,0,0,,Con về rồi đây ạ.
Dialogue: 0,0:05:15.51,0:05:17.01,Default,Aki,0,0,0,,Mừng con đã về.
Dialogue: 0,0:05:17.01,0:05:19.01,Default,Aki,0,0,0,,Lớp mới thế nào hả con?
Dialogue: 0,0:05:20.26,0:05:23.39,Default,Nag,0,0,0,,Con chẳng thể nói chuyện được với ai, nên cảm thấy có chút cô đơn ạ.
Dialogue: 0,0:05:24.31,0:05:26.27,Default,Aki,0,0,0,,Sao con không chủ động lao vào luôn?
Dialogue: 0,0:05:26.27,0:05:28.06,Default,Aki,0,0,0,,Tự giới thiệu bản thân ấy.
Dialogue: 0,0:05:28.06,0:05:31.02,Default,Aki,0,0,0,,'Alo? Vâng, con đây, con đây.'
Dialogue: 0,0:05:31.02,0:05:33.73,Default,Aki,0,0,0,,'Dạ? Con là Nagisa, cháu gái của bà đây ạ.'
Dialogue: 0,0:05:33.73,0:05:35.90,Default,Aki,0,0,0,,'Con vừa gặp tai nạn giao thông, con đang gặp chút rắc rối...'
Dialogue: 0,0:05:35.90,0:05:38.24,Default,Aki,0,0,0,,Ít nhất cũng phải làm được một màn kịch cỡ đó chứ!
Dialogue: 0,0:05:38.24,0:05:40.16,Default,Nag,0,0,0,,Cái đó nghe hơi sai sai rồi bố ơi.
Dialogue: 0,0:05:40.16,0:05:43.29,Default,Aki,0,0,0,,Ý bố là con cần phải có quyết tâm ở mức độ đó cơ!
Dialogue: 0,0:05:43.29,0:05:45.87,Default,Aki,0,0,0,,Phải chủ động lên! Chủ động lên con!
Dialogue: 0,0:05:45.87,0:05:50.92,Default,Nag,0,0,0,,Hồi lớp 11, con cũng phải mất rất nhiều thời gian mới kết thân được với các bạn trong lớp.
Dialogue: 0,0:05:50.92,0:05:52.75,Default,Nag,0,0,0,,Xem ra lần này cũng sẽ mất nhiều thời gian như thế ạ.
Dialogue: 0,0:05:52.75,0:05:55.17,Default,Aki,0,0,0,,Tất cả những gì con cần chỉ là một cơ hội thôi.
Dialogue: 0,0:05:55.17,0:05:59.72,Default,Aki,0,0,0,,Mọi người xung quanh con ai cũng muốn nhanh chóng kết bạn mà.
Dialogue: 0,0:06:00.39,0:06:01.80,Default,Nag,0,0,0,,Bố nói đúng ạ.
Dialogue: 0,0:06:01.80,0:06:02.85,Default,Nag,0,0,0,,Quan trọng là cơ hội.
Dialogue: 0,0:06:03.31,0:06:06.02,Default,Aki,0,0,0,,Được rồi, bố sẽ dạy cho con một tuyệt chiêu độc nhất vô nhị.
Dialogue: 0,0:06:06.64,0:06:10.98,Default,Aki,0,0,0,,Con biết cái trò lỡ miệng gọi cô giáo là 'mẹ' ngượng ngùng thế nào rồi đúng không?
Dialogue: 0,0:06:10.98,0:06:15.28,Default,Aki,0,0,0,,Con hãy biến tấu nó đi và gọi cô giáo là: 'Mẹ của Siêu Nhân Ultra'!
Dialogue: 0,0:06:16.23,0:06:18.78,Default,Aki,0,0,0,,Rồi lời đồn sẽ bắt đầu lan truyền khắp nơi:
Dialogue: 0,0:06:18.78,0:06:21.95,Default,Aki,0,0,0,,'Chẳng lẽ Furukawa-san có họ hàng với Siêu Nhân Ultra sao?'
Dialogue: 0,0:06:21.95,0:06:23.74,Default,Aki,0,0,0,,'Không biết bạn ấy có biến hình được không nhỉ?'
Dialogue: 0,0:06:23.74,0:06:25.20,Default,Aki,0,0,0,,'Lại đằng kia hỏi thử bạn ấy đi!'
Dialogue: 0,0:06:25.70,0:06:28.75,Default,Aki,0,0,0,,'Này Furukawa-san, cậu có muốn ăn trưa cùng tụi mình không?'
Dialogue: 0,0:06:28.75,0:06:31.71,Default,Nag,0,0,0,,Con nghĩ làm như thế khó thành công lắm ạ.
Dialogue: 0,0:06:31.71,0:06:34.92,Default,Aki,0,0,0,,Vậy thì mang món này chia cho cả lớp ăn cùng thì sao?
Dialogue: 0,0:06:34.92,0:06:36.96,Default,Nag,0,0,0,,Bánh mì của mẹ ạ?
Dialogue: 0,0:06:36.96,0:06:41.01,Default,Aki,0,0,0,,Chắc chắn sẽ có ai đó sẵn sàng chịu đựng để ăn hết chiếc bánh này.
Dialogue: 0,0:06:41.01,0:06:44.05,Default,Aki,0,0,0,,Hãy bắt chuyện với những người tốt bụng như thế.
Dialogue: 0,0:06:44.39,0:06:47.10,Default,Aki,0,0,0,,Mặc dù bố nghĩ điều đó hơi quá sức chịu đựng đối với con người.
Dialogue: 0,0:06:47.10,0:06:49.73,Default,San,0,0,0,,Vậy ra bánh mì của em... bánh mì của em...
Dialogue: 0,0:06:50.31,0:06:54.31,Default,San,0,0,0,,...là quá sức chịu đựng đối với con người sao?!
Dialogue: 0,0:06:54.31,0:06:55.40,Default,Aki,0,0,0,,Anh...
Dialogue: 0,0:06:55.40,0:06:57.40,Default,Aki,0,0,0,,...yêu bánh mì của em nhất trên đời!
Dialogue: 0,0:07:03.24,0:07:06.16,Default,Teacher,0,0,0,,Bây giờ thầy sẽ phổ biến về lễ khai giảng ngày mai.
Dialogue: 0,0:07:06.16,0:07:09.50,Default,Teacher,0,0,0,,Đầu tiên, học sinh khối 11 và 12 sẽ ngồi tập trung trong nhà thể chất,
Dialogue: 0,0:07:09.50,0:07:12.50,Default,Teacher,0,0,0,,sau đó học sinh mới khối 10 sẽ tiến vào.
Dialogue: 0,0:07:12.50,0:07:16.09,Default,Teacher,0,0,0,,Sau buổi lễ, các em khối 10 sẽ tham gia buổi định hướng.
Dialogue: 0,0:07:16.09,0:07:19.34,Default,Teacher,0,0,0,,Các khối 11 và 12 sẽ bắt đầu tiết học bình thường.
Dialogue: 0,0:07:20.01,0:07:21.51,Default,Teacher,0,0,0,,Các em học sinh mới sẽ-
Dialogue: 0,0:07:21.88,0:07:23.39,Default,Nag,0,0,0,,Mẹ của Siêu Nhân Ultra!
Dialogue: 0,0:07:23.39,0:07:25.14,Default,Nag,0,0,0,,Em có câu hỏi ạ!
Dialogue: 0,0:07:25.14,0:07:27.51,Default,Girl,0,0,0,,Furukawa-san, cậu thực sự là người nhà của Siêu Nhân Ultra hả?
Dialogue: 0,0:07:27.51,0:07:29.22,Default,Guy,0,0,0,,Ngầu quá đi mất!
Dialogue: 0,0:07:29.22,0:07:30.35,Default,Girl,0,0,0,,Cậu biểu diễn màn biến hình cho tụi mình xem được không?
Dialogue: 0,0:07:30.73,0:07:34.19,Default,Nag,0,0,0,,Ôi, em lỡ lời mất rồi ạ.
Dialogue: 0,0:07:34.19,0:07:36.36,Default,Nag,0,0,0,,Xin lỗi thầy vì em hậu đậu quá.
Dialogue: 0,0:07:38.98,0:07:43.61,Default,Teacher,0,0,0,,Nhớ là đừng có chiêu mộ thành viên cho câu lạc bộ quá hung hãn làm các em sợ đấy nhé.
Dialogue: 0,0:07:44.49,0:07:49.74,Default,Teacher,0,0,0,,Ngoài ra, nghiêm cấm tổ chức các sự kiện chào đón ngoài khuôn khổ nhà trường.
Dialogue: 0,0:07:58.55,0:07:59.88,Default,Kyo,0,0,0,,Cái tên này...
Dialogue: 0,0:08:00.46,0:08:02.17,Default,Kyo,0,0,0,,Dậy mau Okazaki!
Dialogue: 0,0:08:02.17,0:08:04.13,Default,Kyo,0,0,0,,Tiết năm sắp bắt đầu rồi đấy.
Dialogue: 0,0:08:04.59,0:08:05.64,Default,Kyo,0,0,0,,Trời đất...
Dialogue: 0,0:08:08.39,0:08:11.77,Default,Kyo,0,0,0,,Nhìn kỹ thì cậu ta cũng thuộc dạng đẹp trai đấy chứ.
Dialogue: 0,0:08:13.31,0:08:15.40,Default,Kyo,0,0,0,,Không biết cậu ta đã có bạn gái chưa nhỉ.
Dialogue: 0,0:08:17.69,0:08:20.65,Default,Sun,0,0,0,,Okazaki, cẩn thận!
Dialogue: 0,0:08:22.44,0:08:24.99,Default,Kyo,0,0,0,,Su-Sunohara. Cậu muốn cái gì đấy?
Dialogue: 0,0:08:24.99,0:08:26.70,Default,Sun,0,0,0,,Cậu vừa làm cái trò gì thế hả?
Dialogue: 0,0:08:26.70,0:08:30.08,Default,Sun,0,0,0,,Cậu định mưu sát cậu ấy trong lúc ngủ say à?
Dialogue: 0,0:08:30.08,0:08:34.66,Default,Sun,0,0,0,,Hay là cậu định giở trò mờ ám trai gái gì với cậu ấy thế hả?!
Dialogue: 0,0:08:34.66,0:08:36.63,Default,Kyo,0,0,0,,Làm gì có chuyện đó chứ!
Dialogue: 0,0:08:38.04,0:08:39.42,Default,Sun,0,0,0,,Thật không đấy?
Dialogue: 0,0:08:39.42,0:08:43.47,Default,Sun,0,0,0,,Không phải trong đầu cậu vừa nghĩ kiểu 'Ơ kìa, nhìn cậu ta cũng bảnh trai phết đấy chứ' sao?
Dialogue: 0,0:08:43.76,0:08:45.80,Default,Kyo,0,0,0,,Nhìn mặt thì như thằng ngố, mà sao nhạy bén thế không biết.
Dialogue: 0,0:08:45.80,0:08:48.64,Default,Kyo,0,0,0,,Một cú đấm là xóa được ký ức đúng không nhỉ?
Dialogue: 0,0:08:48.64,0:08:50.06,Default,Sun,0,0,0,,Tự nhiên cậu nói cái quái gì thế hả?!
Dialogue: 0,0:08:51.85,0:08:53.93,Default,Oka,0,0,0,,Ồn ào quá! Mới đầu giờ mà làm cái trò gì thế hả?!
Dialogue: 0,0:08:53.93,0:08:54.68,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:08:54.68,0:08:56.81,Default,Sun,0,0,0,,Vừa nãy mày gặp nguy hiểm lắm đấy có biết không?!
Dialogue: 0,0:08:56.81,0:08:59.36,Default,Sun,0,0,0,,Mày suýt nữa thì dính vào một mối quan hệ trai-
Dialogue: 0,0:09:02.19,0:09:04.28,Default,Kyo,0,0,0,,Đã hoàn thành nhiệm vụ xóa ký ức.
Dialogue: 0,0:09:09.24,0:09:10.78,Default,Kim,0,0,0,,Furukawa-san!
Dialogue: 0,0:09:12.70,0:09:13.95,Default,Nag,0,0,0,,Kimura-san.
Dialogue: 0,0:09:15.00,0:09:16.29,Default,Kim,0,0,0,,Cuối cùng cũng đuổi kịp cậu rồi.
Dialogue: 0,0:09:16.62,0:09:18.38,Default,Kim,0,0,0,,Cậu đi có một mình thôi à?
Dialogue: 0,0:09:18.38,0:09:19.21,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:09:20.21,0:09:23.13,Default,Kim,0,0,0,,Tớ vừa mới làm quen được với cậu ấy ở lớp mới này.
Dialogue: 0,0:09:23.13,0:09:26.55,Default,Kim,0,0,0,,Bọn tớ đang định đi xem mấy bộ quần áo, cậu có muốn đi cùng không?
Dialogue: 0,0:09:27.13,0:09:28.80,Default,Nag,0,0,0,,Tớ sao?
Dialogue: 0,0:09:28.80,0:09:32.06,Default,Kim,0,0,0,,Furukawa-san là một người vui tính lắm đấy cậu biết không?
Dialogue: 0,0:09:32.06,0:09:33.10,Default,Kim,0,0,0,,Nào, cùng đi thôi.
Dialogue: 0,0:09:33.43,0:09:36.14,Default,Nag,0,0,0,,Nhưng la cà trên đường về nhà thế này là không tốt đâu ạ.
Dialogue: 0,0:09:36.14,0:09:39.40,Default,Kim,0,0,0,,Thời buổi này chẳng ai để ý mấy chuyện vặt đó đâu mà.
Dialogue: 0,0:09:39.40,0:09:40.48,Default,Kim,0,0,0,,Nào, đi thôi.
Dialogue: 0,0:09:45.90,0:09:47.28,Default,Kim,0,0,0,,Trông dễ thương quá đi mất!
Dialogue: 0,0:09:48.49,0:09:51.07,Default,Girl,0,0,0,,Cậu ấy nói đúng đấy. Trông cậu xinh lắm, Furukawa-san.
Dialogue: 0,0:09:51.45,0:09:53.45,Default,Nag,0,0,0,,Tớ hồi hộp quá.
Dialogue: 0,0:09:54.12,0:09:57.41,Default,Nag,0,0,0,,Nếu bị giáo viên bắt gặp thì chúng mình sẽ bị mắng té tát mất.
Dialogue: 0,0:09:57.41,0:09:59.42,Default,Kim,0,0,0,,Tiếp theo, thử chiếc váy này đi.
Dialogue: 0,0:09:59.42,0:10:00.54,Default,Nag,0,0,0,,Vâng...
Dialogue: 0,0:10:04.71,0:10:08.09,Default,Kim,0,0,0,,Thôi chết rồi Furukawa-san! Có thầy giáo đang đi tuần tra đằng kia kìa!
Dialogue: 0,0:10:08.93,0:10:11.30,Default,Kim,0,0,0,,Bọn tớ chạy trước đây, chúc cậu may mắn nhé!
Dialogue: 0,0:10:11.89,0:10:14.64,Default,Nag,0,0,0,,Đợi tớ với! Xin đừng làm thế mà!
Dialogue: 0,0:10:14.64,0:10:18.23,Default,Nag,0,0,0,,Tớ... Dù cậu có chúc may mắn đi nữa thì...
Dialogue: 0,0:10:18.81,0:10:20.81,Default,Nag,0,0,0,,Em xin lỗi thầy ạ!
Dialogue: 0,0:10:23.94,0:10:24.90,Default,Kim,0,0,0,,Đùa thôi mà!
Dialogue: 0,0:10:26.99,0:10:30.61,Default,Kim,0,0,0,,Bọn tớ xin lỗi nhé.\NNhìn bộ dạng cậu buồn cười quá nên bọn tớ không nhịn được.
Dialogue: 0,0:10:30.61,0:10:34.08,Default,Nag,0,0,0,,Không sao đâu ạ. Dù tớ có hơi giật mình thót tim một chút.
Dialogue: 0,0:10:34.08,0:10:36.24,Default,Kim,0,0,0,,Tiếc thật đấy.
Dialogue: 0,0:10:36.24,0:10:40.54,Default,Kim,0,0,0,,Cậu là một người thú vị thế này mà chẳng ai trong lớp nhận ra.
Dialogue: 0,0:10:40.54,0:10:43.67,Default,Kim,0,0,0,,Sẽ thật tuyệt nếu như cậu sớm kết thân được với các bạn trong lớp.
Dialogue: 0,0:10:43.67,0:10:44.59,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:10:44.59,0:10:46.13,Default,Kim,0,0,0,,Hẹn gặp lại cậu nhé!
Dialogue: 0,0:10:46.13,0:10:47.63,Default,Girl,0,0,0,,Tạm biệt cậu nhé, Furukawa-san.
Dialogue: 0,0:10:51.59,0:10:56.22,Default,Nag,0,0,0,,Được đi cùng Kimura-san trên đường về nhà như thế vui lắm bố ạ, nhưng mà...
Dialogue: 0,0:10:56.22,0:10:58.89,Default,Aki,0,0,0,,Nhưng trong lớp con thì con vẫn cứ thui thủi một mình đúng không?
Dialogue: 0,0:10:58.89,0:10:59.73,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:11:00.39,0:11:06.15,Default,Aki,0,0,0,,Ba mươi con người chen chúc trong một lớp học nhỏ bé, chắc chắn phải có ít nhất một người hợp cạ với con chứ.
Dialogue: 0,0:11:06.15,0:11:13.82,Default,Aki,0,0,0,,Ngay cả những người con vô tình lướt qua nơi hành lang cũng có thể trở thành tri kỷ suốt đời hay định mệnh của con đấy.
Dialogue: 0,0:11:14.37,0:11:17.66,Default,Aki,0,0,0,,Nhưng nếu không chịu hành động, họ sẽ mãi mãi chỉ là những người xa lạ.
Dialogue: 0,0:11:18.33,0:11:19.95,Default,Nag,0,0,0,,Con phải hành động thế nào đây bố?
Dialogue: 0,0:11:19.95,0:11:22.37,Default,Aki,0,0,0,,Chính là lúc món này phát huy tác dụng đây!
Dialogue: 0,0:11:22.37,0:11:25.54,Default,Aki,0,0,0,,Trong này có trộn lẫn chiếc bánh mì do mẹ Sanae làm đấy.
Dialogue: 0,0:11:25.54,0:11:29.34,Default,Aki,0,0,0,,Hãy mang phát cho cả lớp và tận hưởng cảm giác bất ngờ của trò chơi may rủi.
Dialogue: 0,0:11:30.09,0:11:32.93,Default,Aki,0,0,0,,Y hệt mấy trò phạt vui nhộn trong các bữa tiệc ấy.
Dialogue: 0,0:11:32.93,0:11:35.14,Default,Aki,0,0,0,,Nhất định nó sẽ mở đầu cho những cuộc trò chuyện rôm rả.
Dialogue: 0,0:11:35.14,0:11:38.14,Default,Aki,0,0,0,,'Furukawa-san, cậu nghĩ ra trò này hài hước ghê.'
Dialogue: 0,0:11:38.14,0:11:40.02,Default,Aki,0,0,0,,'Tớ muốn làm bạn với cậu.'
Dialogue: 0,0:11:40.02,0:11:41.06,Default,Aki,0,0,0,,Mọi chuyện sẽ diễn ra trơn tru y như thế đấy!
Dialogue: 0,0:11:42.69,0:11:45.81,Default,San,0,0,0,,Vậy ra bánh mì của em... bánh mì của em...
Dialogue: 0,0:11:45.81,0:11:49.86,Default,San,0,0,0,,...chỉ là thứ dùng để chơi trò mạo hiểm bất ngờ thôi sao?!
Dialogue: 0,0:11:49.86,0:11:51.36,Default,Aki,0,0,0,,Anh...
Dialogue: 0,0:11:51.90,0:11:54.70,Default,Aki,0,0,0,,...yêu bánh mì của em nhất trần đời!
Dialogue: 0,0:11:57.74,0:12:00.79,Default,Ryo,0,0,0,,Sáu Bích và Tám Cơ.
Dialogue: 0,0:12:00.79,0:12:02.71,Default,Ryo,0,0,0,,Và cả Chín Bích nữa.
Dialogue: 0,0:12:02.71,0:12:06.71,Default,Ryo,0,0,0,,Số '6' và số '9' ghép lại tạo thành hình số '8', vậy nên...
Dialogue: 0,0:12:07.34,0:12:11.51,Default,Kyo,0,0,0,,Cách bói toán của em lúc nào cũng độc nhất vô nhị như mọi khi nhỉ.
Dialogue: 0,0:12:11.51,0:12:14.72,Default,Ryo,0,0,0,,Chị ơi, ngày mai chị sẽ được một ai đó tỏ tình đấy.
Dialogue: 0,0:12:14.72,0:12:16.22,Default,Kyo,0,0,0,,Tỏ tình á?
Dialogue: 0,0:12:16.22,0:12:18.51,Default,Ryo,0,0,0,,Người đó sẽ nói: 'Tớ thích cậu'.
Dialogue: 0,0:12:18.51,0:12:20.47,Default,Ryo,0,0,0,,Từ một chàng trai rất tốt bụng.
Dialogue: 0,0:12:23.14,0:12:28.98,Default,Sun,0,0,0,,Tao nghĩ chúng ta cần phải cho cô ta biết bọn mình đáng sợ đến mức nào.
Dialogue: 0,0:12:28.98,0:12:31.15,Default,Oka,0,0,0,,Sao cơ? Định đi gây sự đánh nhau à?
Dialogue: 0,0:12:31.15,0:12:33.07,Default,Sun,0,0,0,,Bọn mình sẽ chọn một cách thông minh hơn nhiều!
Dialogue: 0,0:12:33.99,0:12:36.87,Default,Oka,0,0,0,,'Gửi Fujibayashi Kyou-sama kính mến.'
Dialogue: 0,0:12:36.87,0:12:40.58,Default,Oka,0,0,0,,'Mấy hôm trước tôi đã trót say đắm cậu ngay từ cái nhìn đầu tiên,\Nvà muốn được bày tỏ lòng mình với cậu,'
Dialogue: 0,0:12:40.58,0:12:43.75,Default,Oka,0,0,0,,'nên trưa nay xin mời cậu hãy đến phòng tư liệu ở khu nhà cũ nhé.'
Dialogue: 0,0:12:43.75,0:12:45.17,Default,Oka,0,0,0,,'Hẹn gặp lại cậu ở đó.'
Dialogue: 0,0:12:46.08,0:12:49.29,Default,Sun,0,0,0,,Ngày mai tao sẽ lén nhét bức thư này vào tủ giày của cô ta.
Dialogue: 0,0:12:49.63,0:12:53.47,Default,Sun,0,0,0,,Lúc tim cô ta đập thình thịch bối rối,\Nbọn mình sẽ đứng từ xa mà cười vỡ bụng.
Dialogue: 0,0:12:53.47,0:12:57.05,Default,Oka,0,0,0,,Lần đầu tiên tao thấy một bức thư tình mà đọc lên đã thấy sặc mùi ngu ngốc thế này đấy.
Dialogue: 0,0:12:57.05,0:13:00.43,Default,Sun,0,0,0,,Với vố này, Fujibayashi Kyou sẽ bị sốc nặng và không bao giờ ngẩng cao đầu lên được nữa.
Dialogue: 0,0:13:00.43,0:13:04.23,Default,Sun,0,0,0,,Cả năm nay bọn mình tha hồ mà hưởng thụ cuộc sống nhé!
Dialogue: 0,0:13:04.23,0:13:08.86,Default,Oka,0,0,0,,Đúng là sẽ có một nỗi kinh hoàng đang chờ đợi mày thật. Theo nhiều nghĩa.
Dialogue: 0,0:13:08.86,0:13:09.56,Default,Sun,0,0,0,,Thấy chưa hả?
Dialogue: 0,0:13:11.32,0:13:13.23,Default,Sun,0,0,0,,Tao không thể chờ nổi đến ngày mai nữa rồi.
Dialogue: 1,0:13:14.36,0:13:16.15,Note,,0,0,0,,{\fad(750,700)}Biển báo: Lễ Khai Giảng
Dialogue: 0,0:13:15.57,0:13:18.32,Note,,0,0,0,,{\fad(700,0)}Biển báo: Chào mừng tân học sinh
Dialogue: 0,0:13:19.03,0:13:22.37,Default,Ryo,0,0,0,,Tôi đến phiên trực ban rồi, nên tôi lên lớp trước nhé.
Dialogue: 0,0:13:22.37,0:13:24.00,Default,Kyo,0,0,0,,Ừ, hẹn gặp lại cậu sau.
Dialogue: 0,0:13:30.50,0:13:32.92,Default,Kyo,0,0,0,,'Gửi Fujibayashi Kyou-sama kính mến...'
Dialogue: 0,0:13:34.34,0:13:36.97,Default,Kyo,0,0,0,,Không thể nào! Quẻ bói của Ryou linh nghiệm thật rồi sao?!
Dialogue: 0,0:13:40.47,0:13:42.35,Default,Sun,0,0,0,,Nhìn mặt bà chằn đó đỏ bừng lên kìa.
Dialogue: 0,0:13:42.35,0:13:43.81,Default,Sun,0,0,0,,Cô ta trông cũng có nét dễ thương đấy chứ.
Dialogue: 0,0:13:43.81,0:13:46.48,Default,Oka,0,0,0,,Tao thấy trò này bệnh hoạn thật sự rồi đấy.
Dialogue: 0,0:13:50.48,0:13:53.53,Default,Girl,0,0,0,,Nhìn kìa, nhìn kìa, cậu học sinh mới đó dễ thương ghê.
Dialogue: 0,0:13:53.53,0:13:56.24,Default,Girl,0,0,0,,Sao thế? Cậu định nhắm mục tiêu mới rồi à?
Dialogue: 0,0:13:56.24,0:13:58.28,Default,Guy,0,0,0,,Không biết chúng mình sẽ tuyển được bao nhiêu người vào câu lạc bộ nhỉ.
Dialogue: 0,0:13:58.28,0:14:02.12,Default,Guy,0,0,0,,Ừ. Nếu tuyển được ít nhất hai người thì tốt quá.
Dialogue: 0,0:13:59.03,0:14:00.74,Default-alt,Nag,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:14:02.12,0:14:03.70,Default,Guy,0,0,0,,Nhìn kìa, người cậu ấy săn chắc ghê.
Dialogue: 0,0:14:04.99,0:14:08.50,Default,Girl,0,0,0,,Này, cậu bạn mặt tròn tròn đằng kia, trông chẳng giống cái đó sao?
Dialogue: 0,0:14:08.50,0:14:11.50,Default,Girl,0,0,0,,Cậu biết đấy, cái thứ từng rất nổi tiếng mấy năm về trước ấy.
Dialogue: 0,0:14:11.50,0:14:13.00,Default,Girl,0,0,0,,Nhân vật linh vật ấy.
Dialogue: 0,0:14:13.00,0:14:15.17,Default,Girl,0,0,0,,Nó tên là gì ấy nhỉ?
Dialogue: 0,0:14:16.63,0:14:18.13,Default,Girl,0,0,0,,Trông giông giống thế này này.
Dialogue: 0,0:14:18.13,0:14:20.22,Default,Girl,0,0,0,,A, là cái gì nhỉ...
Dialogue: 0,0:14:20.22,0:14:21.93,Default,Girl,0,0,0,,Tớ cũng chẳng nhớ ra nổi nữa.
Dialogue: 0,0:14:21.93,0:14:25.77,Default,Girl,0,0,0,,Hồi đó nổi tiếng lắm đúng không?\NThú nhồi bông các thứ bán đắt như tôm tươi ấy?
Dialogue: 0,0:14:25.77,0:14:27.02,Default,Nag,0,0,0,,Dạ, đó là...
Dialogue: 0,0:14:27.02,0:14:30.02,Default,Teacher,0,0,0,,Được rồi, bây giờ cả lớp cùng di chuyển vào nhà thể chất nào.
Dialogue: 0,0:14:38.03,0:14:40.99,Note,,0,0,0,,{\fad(0,600)}Biển báo: Lễ Khai Giảng Trường Tư Thục Hikarizaka
Dialogue: 0,0:14:39.90,0:14:47.16,Default,HM,0,0,0,,Gửi các em học sinh mới, thầy hy vọng các em sẽ có ba năm học thật tuyệt vời tại mái trường này.
Dialogue: 0,0:14:49.75,0:14:52.46,Default,Girl,0,0,0,,Tiếp theo là lời phát biểu đại diện của học sinh mới.
Dialogue: 0,0:15:06.89,0:15:10.52,Default,Kyo,0,0,0,,Ủa, chẳng lẽ mình lại thực sự mong chờ được gặp người đó sao?
Dialogue: 0,0:15:10.52,0:15:12.02,Signs,,0,0,0,,{\an1\fnArial\fs72\b1\frz348.498\frx10\fry8\pos(859.5,613.5)\c&H535956&}Phòng Tư Liệu
Dialogue: 0,0:15:28.20,0:15:31.87,Default,Kyo,0,0,0,,'Có chút trục trặc nhỏ. Xin mời cậu lên sân thượng nhé.'
Dialogue: 0,0:15:40.88,0:15:45.01,Default,Kyo,0,0,0,,'Tôi xin lỗi. Rốt cuộc thì xin mời cậu hãy đến kho dụng cụ thể chất nhé.'
Dialogue: 0,0:15:46.51,0:15:48.56,Default,Kyo,0,0,0,,Cái tên này rốt cuộc đang nghĩ cái quái gì trong đầu thế hả?!
Dialogue: 0,0:15:51.68,0:15:54.40,Default,Oka,0,0,0,,Mày nên dừng trò này lại sớm đi thì hơn.
Dialogue: 0,0:15:54.40,0:15:58.11,Default,Sun,0,0,0,,Sao lại dừng chứ? Hiếm khi nào có trò vui nổ trời thế này mà.
Dialogue: 0,0:15:58.98,0:16:00.86,Default,Nag,0,0,0,,Mẹ của Siêu Nhân Ultra.
Dialogue: 0,0:16:00.86,0:16:02.82,Default,Nag,0,0,0,,Mẹ của Siêu Nhân Ultra.
Dialogue: 0,0:16:10.08,0:16:13.92,Default,Sun,0,0,0,,Trời ạ. Cô ta vẫn chưa nhận ra là mình đang bị chơi xỏ nữa cơ đấy.
Dialogue: 0,0:16:13.92,0:16:15.25,Default,Oka,0,0,0,,Thôi dừng lại đi mày.
Dialogue: 0,0:16:15.25,0:16:17.09,Default,Oka,0,0,0,,Đi quá đà rồi đấy.
Dialogue: 0,0:16:17.38,0:16:18.92,Default,Sun,0,0,0,,Đây mới chỉ là khúc dạo đầu thôi.
Dialogue: 0,0:16:18.92,0:16:21.51,Default,Sun,0,0,0,,Phải ra tay trước một bước mới được.
Dialogue: 0,0:16:26.64,0:16:29.01,Default,Oka,0,0,0,,Lần này là phát cuối cùng đấy nhé.
Dialogue: 0,0:16:29.01,0:16:30.52,Default,Sun,0,0,0,,Tao biết rồi.
Dialogue: 0,0:16:30.52,0:16:35.14,Default,Sun,0,0,0,,'Lại có chút trục trặc nữa rồi, nên lần này...'
Dialogue: 0,0:16:35.14,0:16:37.15,Default,Sun,0,0,0,,Lần này nên bảo cô ta đi đâu bây giờ nhỉ?
Dialogue: 0,0:16:37.15,0:16:39.82,Default,Kyo,0,0,0,,Hay là ghi: 'Tôi sẽ đợi cậu dưới Địa Ngục' đi?
Dialogue: 0,0:16:39.82,0:16:40.65,Default,Oka,0,0,0,,Địa Ngục à?
Dialogue: 0,0:16:40.65,0:16:42.61,Default,Sun,0,0,0,,Này, ý hay đấy.
Dialogue: 0,0:16:42.61,0:16:44.36,Default,Sun,0,0,0,,Tao thích cái âm thanh nghe rùng rợn đó rồi đấy.
Dialogue: 0,0:16:44.70,0:16:46.86,Default,Kyo,0,0,0,,Tôi rất mừng vì cậu thích nó.
Dialogue: 0,0:16:55.75,0:16:57.83,Default,Sun,0,0,0,,Tôi cứ tưởng mình vừa bị tống xuống Địa Ngục thật rồi chứ.
Dialogue: 0,0:16:58.29,0:17:01.96,Default,Oka,0,0,0,,Mà này, tại sao chúng ta lại phải làm cái trò này nữa thế?
Dialogue: 0,0:17:01.96,0:17:06.43,Default,Sun,0,0,0,,Bọn mình sẽ chơi xỏ mấy đứa học sinh mới để giải tỏa căng thẳng.
Dialogue: 0,0:17:06.43,0:17:07.84,Default,Oka,0,0,0,,Giận cá chém thớt à?
Dialogue: 0,0:17:07.84,0:17:09.35,Signs,,0,0,0,,{\fnThrow My Hands Up in the Air\fs90\b1\c&H989898&\pos(913.5,310.5)\frz345.011\blur1}Xin hãy kéo tôi\NSẽ vui lắm đấy
Dialogue: 0,0:17:07.84,0:17:09.35,Signs,,0,0,0,,{\fnThrow My Hands Up in the Air\fs90\b1\c&H989898&\frz347.421\pos(886.5,975)\blur1}Sẽ vui lắm đấy
Dialogue: 0,0:17:10.76,0:17:12.22,Default,Sun,0,0,0,,Nên viết cái gì vào đây bây giờ nhỉ?
Dialogue: 0,0:17:13.35,0:17:16.60,Default,Sun,0,0,0,,'Đội bạn thân Sunohara & Okazaki. Ký tên: Đại Ca Bảnh Tỏn.'
Dialogue: 0,0:17:16.60,0:17:17.77,Default,Sun,0,0,0,,Nghe thế nào?
Dialogue: 0,0:17:17.77,0:17:21.82,Default,Sun,0,0,0,,Bọn mình sẽ dùng chữ kanji hầm hố cho giống dân giang hồ.
Dialogue: 0,0:17:21.82,0:17:24.86,Default,Oka,0,0,0,,Có cả tá chỗ tao có thể bắt bẻ được, nhưng thôi tao chẳng thèm nói nữa.
Dialogue: 0,0:17:24.86,0:17:28.99,Default,Sun,0,0,0,,Thế thì: 'Youhei & Tomoya, vô đối. Ký tên: Đại Ca Bảnh Tỏn.'
Dialogue: 0,0:17:28.99,0:17:31.53,Default,Oka,0,0,0,,Mày nên biết là chữ 'ký tên' phải đặt trước tên chứ.
Dialogue: 0,0:17:31.53,0:17:40.71,Default,Sun,0,0,0,,Nếu thế thì: 'Đội tuyển là ủi mạo hiểm phong cách châu Âu thân thiện Sunohara - Okazaki, cùng sự góp mặt của Anh Em Nhà Hikarizaka. Ký tên: Đại Ca Bảnh Tỏn.'
Dialogue: 0,0:17:40.71,0:17:42.25,Default,Oka,0,0,0,,Nghe dài dòng và ngột ngạt quá rồi đấy.
Dialogue: 0,0:17:43.46,0:17:44.96,Default,Sun,0,0,0,,Thế thì để mày tự viết đi.
Dialogue: 0,0:17:45.72,0:17:48.72,Default,Oka,0,0,0,,Khi sợi dây này đứt thì cái chậu kia sẽ rơi xuống đúng không?
Dialogue: 0,0:17:48.72,0:17:53.47,Default,Sun,0,0,0,,Ừ. Bọn mình sẽ cho tụi nó thấm thía rằng cuộc đời cấp ba không dễ ăn đâu.
Dialogue: 0,0:17:55.56,0:17:57.85,Default,Oka,0,0,0,,Vậy thì đây là lời khuyên tốt nhất tao có thể dành cho tụi nó.
Dialogue: 0,0:18:00.06,0:18:03.90,Note,,0,0,0,,{\fad(920,400)}Biển báo: Chào mừng tân học sinh
Dialogue: 0,0:18:01.73,0:18:03.36,Default,Girl,0,0,0,,Cái gì kia thế?
Dialogue: 0,0:18:03.65,0:18:05.74,Default,Guy,0,0,0,,Nhìn kiểu gì cũng thấy đáng ngờ hết sức.
Dialogue: 0,0:18:05.74,0:18:07.45,Default,Guy,0,0,0,,Sao cậu không kéo thử xem sao?
Dialogue: 0,0:18:07.45,0:18:10.49,Default,Guy,0,0,0,,Không đời nào. Tớ chẳng muốn bị dính nước đâu.
Dialogue: 0,0:18:12.53,0:18:14.79,Default,Sun,0,0,0,,Chẳng có ma nào dính bẫy đâu mày ơi.
Dialogue: 0,0:18:14.79,0:18:17.66,Default,Oka,0,0,0,,Chỉ có thằng đần mới đi kéo cái dây đó thôi.
Dialogue: 0,0:18:17.66,0:18:21.67,Default,Sun,0,0,0,,Chết tiệt thật. Chẳng lẽ tụi nó thông minh hơn tao à?
Dialogue: 0,0:18:21.67,0:18:23.92,Default,Oka,0,0,0,,Mày là đáy xã hội rồi còn so với ai nữa.
Dialogue: 0,0:18:25.05,0:18:25.84,Default,Sun,0,0,0,,Kìa.
Dialogue: 0,0:18:30.72,0:18:31.76,Default,Oka,0,0,0,,Con bé đó là học sinh mới à?
Dialogue: 0,0:18:32.10,0:18:35.14,Default,Sun,0,0,0,,Cổ áo màu xanh dương kìa, chắc chắn là học sinh lớp 12 rồi.
Dialogue: 0,0:18:38.31,0:18:40.94,Signs,,0,0,0,,{\fnThrow My Hands Up in the Air\fs72\b1\pos(865.5,417)\c&H3D455B&\frz357.934\blur1}Xin hãy kéo tôi\NSẽ vui lắm đấy
