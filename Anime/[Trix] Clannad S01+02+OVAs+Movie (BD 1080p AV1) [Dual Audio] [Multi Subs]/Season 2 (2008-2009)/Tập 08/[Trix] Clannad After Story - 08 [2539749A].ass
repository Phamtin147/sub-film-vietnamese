Dialogue: 0,0:03:54.01,0:03:57.47,Default,Yuk,0,0,0,,Mình xin lỗi. Mình ngủ quên mất tiêu luôn rồi.
Dialogue: 0,0:03:57.47,0:04:00.27,Default,Oka,0,0,0,,Không sao đâu, tôi không phiền gì đâu.
Dialogue: 0,0:04:00.27,0:04:02.68,Default,Kid,0,0,0,,Lần sau chị cứ gối lên đùi em này.
Dialogue: 0,0:04:02.68,0:04:05.02,Default,Sun,0,0,0,,Sao mày lại ở đây hả nhóc?
Dialogue: 0,0:04:05.02,0:04:07.81,Default,Kid,0,0,0,,Em cũng muốn được gặp chị Yukine nữa mà.
Dialogue: 0,0:04:10.94,0:04:11.74,Default,Sud,0,0,0,,Chị Yuki-nee!
Dialogue: 0,0:04:11.74,0:04:13.11,Default,Yuk,0,0,0,,Sudou-san!
Dialogue: 0,0:04:15.20,0:04:18.87,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 8
Dialogue: 0,0:04:15.20,0:04:18.87,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Cuộc chiến của lòng dũng cảm
Dialogue: 0,0:04:17.24,0:04:20.70,Default,Yuk,0,0,0,,Bọn họ đều tưởng Sunohara-san là anh trai mình sao?
Dialogue: 0,0:04:20.70,0:04:25.42,Default,Sud,0,0,0,,Đúng thế. Họ cứ đinh ninh là anh Kazuto đã xuất viện rồi.
Dialogue: 0,0:04:31.26,0:04:33.22,Default,Sud,0,0,0,,Ai nấy đều sợ xanh mặt cả lũ.
Dialogue: 0,0:04:33.59,0:04:38.05,Default,Sud,0,0,0,,Họ sợ một khi Miyazawa Kazuto tái xuất giang hồ thì họ chẳng còn cơ hội chiến thắng nào nữa.
Dialogue: 0,0:04:38.60,0:04:41.81,Default,Sud,0,0,0,,Chính vì thế họ mới hoảng loạn và mò sang bên địa bàn của mình đấy.
Dialogue: 0,0:04:42.77,0:04:44.85,Default,Sud,0,0,0,,Lẽ ra chuyện này không bao giờ được xảy ra.
Dialogue: 0,0:04:44.85,0:04:47.31,Default,Nag,0,0,0,,Nhưng đó hoàn toàn chỉ là hiểu lầm thôi mà.
Dialogue: 0,0:04:47.31,0:04:50.65,Default,Oka,0,0,0,,Đúng đấy! Hôm qua là do Tomoyo đập cho bọn họ một trận tơi bời chứ—
Dialogue: 0,0:04:49.61,0:04:50.65,Default-alt,Tom,0,0,0,,Miyazawa.
Dialogue: 0,0:04:50.65,0:04:52.40,Default-alt,Tom,0,0,0,,Về chuyện xảy ra ngày hôm qua...
Dialogue: 0,0:04:52.40,0:04:55.24,Default,Sud,0,0,0,,Bỏ bu rồi! Tôi đi trước nhé chị Yuki-nee!
Dialogue: 0,0:04:55.99,0:04:56.99,Default,Yuk,0,0,0,,Anh Sudou!
Dialogue: 0,0:04:58.95,0:05:02.08,Default,Tom,0,0,0,,Xem ra tôi đến đúng lúc thật đấy.
Dialogue: 0,0:05:09.75,0:05:12.55,Default,Tom,0,0,0,,Mấy người lại vướng vào một vụ rắc rối mới nữa rồi đấy à?
Dialogue: 0,0:05:13.21,0:05:15.80,Default,Sun,0,0,0,,Bọn tôi đâu có tự dưng muốn dính vào đâu chứ.
Dialogue: 0,0:05:15.80,0:05:20.89,Default,Kid,0,0,0,,{\fscx107}Tất cả là tại vì anh cứ làm ra vẻ ta đây là Miyazawa Kazuto đấy chứ.
Dialogue: 0,0:05:22.60,0:05:25.31,Default,Tom,0,0,0,,Cái tên Miyazawa Kazuto tôi nghe quen lắm.
Dialogue: 0,0:05:25.68,0:05:30.52,Default,Tom,0,0,0,,Hồi tôi còn đi đánh dẹp các băng đảng ngoài phố tôi đã nghe danh rồi.
Dialogue: 0,0:05:31.19,0:05:36.24,Default,Tom,0,0,0,,Người ta đồn rằng Miyazawa Kazuto là kẻ duy nhất có thể đánh tay đôi sòng phẳng với tôi.
Dialogue: 0,0:05:36.24,0:05:38.16,Default,Oka,0,0,0,,Đánh tay đôi với cậu á?!
Dialogue: 0,0:05:38.70,0:05:42.70,Default,Yuk,0,0,0,,Mình cũng từng nghe nhiều chiến tích lẫy lừng của cậu rồi, Sakagami-san.
Dialogue: 0,0:05:44.62,0:05:48.17,Default,Tom,0,0,0,,Lần này tôi sẽ không đem chuyện này ra xử lý ở trường đâu.
Dialogue: 0,0:05:48.96,0:05:50.00,Default,Tom,0,0,0,,Nhưng mà...
Dialogue: 0,0:05:50.71,0:05:51.50,Default,Yuk,0,0,0,,Nhưng mà sao cơ ạ?
Dialogue: 0,0:05:52.09,0:05:56.26,Default,Tom,0,0,0,,Hôm trước, tôi có dịp nói chuyện với\Nmột thành viên Hội học sinh của trường khác.
Dialogue: 0,0:05:56.80,0:05:59.80,Default,Tom,0,0,0,,Gần đây trong thị trấn liên tục xảy ra các vụ ẩu đả bạo lực.
Dialogue: 0,0:06:00.34,0:06:05.06,Default,Tom,0,0,0,,Cứ theo đà này thì sớm muộn gì cảnh sát cũng sẽ vào cuộc can thiệp.
Dialogue: 0,0:06:06.02,0:06:07.56,Default,Tom,0,0,0,,Đây là lời khuyên của tôi.
Dialogue: 0,0:06:07.56,0:06:10.52,Default,Tom,0,0,0,,Dẹp cái trò ngớ ngẩn đó đi và làm hòa với nhau đi.
Dialogue: 0,0:06:10.81,0:06:12.86,Default,Tom,0,0,0,,Nếu không thì tất cả sẽ phải trả giá đắt đấy.
Dialogue: 0,0:06:21.20,0:06:24.45,Default,Guy,0,0,0,,Lũ khốn kiếp đó! Bố mày sẽ giết sạch chúng nó!
Dialogue: 0,0:06:24.99,0:06:27.00,Default,Guy,0,0,0,,Đi đột kích hang ổ bọn chúng ngay bây giờ đi!
Dialogue: 0,0:06:27.00,0:06:28.79,Default,Guy,0,0,0,,Phải đấy! Đi thôi anh em!
Dialogue: 0,0:06:28.79,0:06:30.04,Default,Guy,0,0,0,,Cho chúng nó biết tay!
Dialogue: 0,0:06:30.04,0:06:31.17,Default,Guy,0,0,0,,Chiến luôn!
Dialogue: 0,0:06:31.17,0:06:35.09,Default,Oka,0,0,0,,Miyazawa. Khi nào anh trai cậu mới xuất viện?
Dialogue: 0,0:06:35.09,0:06:39.05,Default,Nag,0,0,0,,Anh Kazuto có thể ngăn chặn cuộc chiến này đúng không?
Dialogue: 0,0:06:43.47,0:06:45.51,Default,Kid,0,0,0,,Chị đi đâu thế chị hai?
Dialogue: 0,0:06:45.51,0:06:48.43,Default,Yuk,0,0,0,,Chị sẽ đi nói chuyện phải quấy với bọn họ!
Dialogue: 0,0:06:48.43,0:06:49.98,Default,Nag,0,0,0,,Miyazawa-san!
Dialogue: 0,0:06:49.98,0:06:51.48,Default,Oka,0,0,0,,Mấy người ở yên đây đi.
Dialogue: 0,0:06:55.11,0:06:56.61,Default,Oka,0,0,0,,Đứng lại đã, Miyazawa!
Dialogue: 0,0:07:00.95,0:07:04.99,Default,Oka,0,0,0,,Cậu nghĩ lại xem. Có đến đó thì cậu cũng đâu giải quyết được gì.
Dialogue: 0,0:07:05.58,0:07:10.83,Default,Yuk,0,0,0,,Mình quen mặt bọn họ mà, mình cũng biết chỗ họ hay tụ tập nữa.
Dialogue: 0,0:07:11.37,0:07:14.96,Default,Oka,0,0,0,,Anh trai cậu không biết chuyện gì đang xảy ra sao?
Dialogue: 0,0:07:14.96,0:07:18.76,Default,Oka,0,0,0,,Dù có nằm viện thì anh ấy vẫn có thể gọi điện khuyên can Sudou và mọi người qua điện thoại mà?
Dialogue: 0,0:07:28.93,0:07:30.27,Default,Sas,0,0,0,,Tôi hiểu tình hình rồi.
Dialogue: 0,0:07:30.60,0:07:33.73,Default,Yuk,0,0,0,,Nghĩa là cứ đà này thì cả hai phe sẽ bị cảnh sát dẹp tan tác đúng không?
Dialogue: 0,0:07:33.73,0:07:38.78,Default,Yuk,0,0,0,,Vâng. Nếu cuộc chiến tiếp tục leo thang,\Nchắc chắn cảnh sát sẽ vào cuộc.
Dialogue: 0,0:07:38.78,0:07:41.11,Default,Guy,0,0,0,,Chị bảo bọn tôi rút lui vào lúc này là thế nào hả?!
Dialogue: 0,0:07:41.11,0:07:45.41,Default,Guy,0,0,0,,{\fs78.3}Một khi thằng Miyazawa Kazuto đã tái xuất giang hồ,\Nthì bọn tôi phải hạ gục bọn chúng trước khi bọn tôi bị tiêu diệt chứ!
Dialogue: 0,0:07:45.41,0:07:46.99,Default,Yuk,0,0,0,,Tôi đã bảo rồi, chuyện đó hoàn toàn là hiểu lầm thôi mà.
Dialogue: 0,0:07:46.99,0:07:48.62,Default,Guy,0,0,0,,Hiểu lầm cái nỗi gì cơ chứ?!
Dialogue: 0,0:07:48.62,0:07:51.87,Default,Guy,0,0,0,,Tối qua mấy anh em bọn tôi vừa bị anh trai chị đập cho thừa sống thiếu chết kia kìa!
Dialogue: 0,0:07:52.83,0:07:54.67,Default,Oka,0,0,0,,Đó là Sakagami Tomo—
Dialogue: 0,0:07:57.50,0:08:02.13,Default,Guy,0,0,0,,Chị Yukine. Bọn tôi không có hiềm khích gì với chị cả, nhưng lần này bọn tôi không thể nghe lời chị được.
Dialogue: 0,0:08:02.13,0:08:04.55,Default,Guy,0,0,0,,Bên phía bọn tôi cũng có người bị thương tích đầy mình đây này!
Dialogue: 0,0:08:04.55,0:08:06.89,Default,Guy,0,0,0,,Bọn tôi không thể dừng lại được!
Dialogue: 0,0:08:06.89,0:08:08.47,Default,Sas,0,0,0,,Thôi đi các chú.
Dialogue: 0,0:08:08.47,0:08:09.81,Default,Guys,0,0,0,,Đây là chiến tranh rồi!
Dialogue: 0,0:08:09.81,0:08:12.18,Default,Guys,0,0,0,,Phải chiến đấu cho đến khi một trong hai phe bị nghiền nát hoàn toàn!
Dialogue: 0,0:08:12.18,0:08:13.35,Default,Guys,0,0,0,,Đúng thế! Trận chiến này là một mất một còn!
Dialogue: 0,0:08:13.35,0:08:15.85,Default,Guys,0,0,0,,Phải đấy! Giết sạch bọn chúng!
Dialogue: 0,0:08:15.85,0:08:18.90,Default,Sas,0,0,0,,Tao đã bảo chúng mày câm hết họng lại cơ mà!
Dialogue: 0,0:08:21.40,0:08:23.45,Default,Sas,0,0,0,,Tụi mày đang thất lễ với khách quý đấy.
Dialogue: 0,0:08:26.03,0:08:30.41,Default,Sas,0,0,0,,Chị Yukine. Ngày trước chị cũng từng chữa vết thương cho tôi rồi.
Dialogue: 0,0:08:31.62,0:08:36.88,Default,Sas,0,0,0,,Tôi chưa từng quên sự ân cần chăm sóc\Ncũng như hương vị đĩa cơm chiên của chị ngày hôm ấy đâu.
Dialogue: 0,0:08:36.88,0:08:40.30,Default,Guys,0,0,0,,Một tháng trời rồi mà đại ca vẫn chưa chịu tháo băng gạc ra kìa.
Dialogue: 0,0:08:40.30,0:08:43.55,Default,Guys,0,0,0,,Ừ, đại ca Sasaki thích mấy cô gái nấu ăn ngon mà.
Dialogue: 0,0:08:43.55,0:08:45.13,Default,Sas,0,0,0,,Mấy thằng kia vừa lẩm bẩm cái gì đấy hả?!
Dialogue: 0,0:08:45.13,0:08:46.18,Default,Guys,0,0,0,,Dạ không, có gì đâu đại ca!
Dialogue: 0,0:08:48.47,0:08:52.81,Default,Sas,0,0,0,,Nhưng như chị thấy đấy, chuyện này không thể cứ thế mà cho qua được.
Dialogue: 0,0:08:53.31,0:08:57.81,Default,Sas,0,0,0,,Vậy thế này nhé, một trận đấu tay đôi solo giữa hai thủ lĩnh thì sao?
Dialogue: 0,0:08:58.44,0:08:59.44,Default,Yuk,0,0,0,,Đấu tay đôi ạ?
Dialogue: 0,0:08:59.86,0:09:03.61,Default,Sas,0,0,0,,Anh trai chị và tôi sẽ solo một trận sống còn.
Dialogue: 0,0:09:04.07,0:09:06.20,Default,Sas,0,0,0,,Bên nào thua sẽ phải cúi đầu quy phục bên thắng.
Dialogue: 0,0:09:06.20,0:09:08.82,Default,Sas,0,0,0,,Đó là giới hạn nhượng bộ lớn nhất mà tôi có thể đưa ra rồi đấy.
Dialogue: 0,0:09:12.83,0:09:15.16,Default,Sud,0,0,0,,Và chị đã đồng ý với điều kiện đó á?!
Dialogue: 0,0:09:15.16,0:09:19.46,Default,Guys,0,0,0,,Chị Yuki-nee, sao chị lại làm thế mà không bàn bạc trước với anh em bọn tôi?!
Dialogue: 0,0:09:19.75,0:09:22.75,Default,Yuk,0,0,0,,Chị xin lỗi. Lúc đó đó là giải pháp duy nhất rồi.
Dialogue: 0,0:09:23.92,0:09:27.55,Default,Oka,0,0,0,,Thời gian là chiều tối mai, tại bờ sông.
Dialogue: 0,0:09:28.68,0:09:30.93,Default,Sud,0,0,0,,Nhưng anh Kazuto đâu thể chiến đấu được.
Dialogue: 0,0:09:30.93,0:09:33.14,Default,Sud,0,0,0,,Chúng ta buộc phải cử người thay thế thôi.
Dialogue: 0,0:09:33.14,0:09:35.98,Default,Guy,0,0,0,,Nhưng liệu bọn chúng có chấp nhận không?
Dialogue: 0,0:09:37.23,0:09:42.82,Default,Kid,0,0,0,,Này. Bọn họ tưởng anh Sunohara là anh Miyazawa Kazuto mà đúng không?
Dialogue: 0,0:09:43.82,0:09:45.24,Default,Guy,0,0,0,,Chuẩn cmnr!!!
Dialogue: 0,0:09:45.24,0:09:46.40,Default,Sun,0,0,0,,Mấy người đùa đấy à?!
Dialogue: 0,0:09:46.40,0:09:50.03,Default,Yuk,0,0,0,,Xin mọi người dừng lại đi! Sunohara-san không liên quan gì đến chuyện của chúng ta cả...
Dialogue: 0,0:09:50.03,0:09:56.66,Default,Kid,0,0,0,,Hôm qua anh vừa huênh hoang bốc phét là một mình anh cân bốn thằng cơ mà.
Dialogue: 0,0:09:56.66,0:09:58.42,Default,Sud,0,0,0,,Một mình cân bốn thằng luôn á?!
Dialogue: 0,0:09:58.46,0:10:00.25,Default,Guy,0,0,0,,Đỉnh vãi chưởng.
Dialogue: 0,0:10:00.25,0:10:02.59,Default,Guy,0,0,0,,Anh làm người thay thế cho anh Kazuto là chuẩn không cần chỉnh rồi.
Dialogue: 0,0:10:02.63,0:10:07.38,Default,Sis,0,0,0,,Người ta hay bảo đừng trông mặt mà bắt hình dong, cơ mà anh đỉnh thật đấy.
Dialogue: 0,0:10:07.47,0:10:09.63,Default,Sun,0,0,0,,Đ-Đâu có gì đâu...
Dialogue: 0,0:10:10.39,0:10:14.10,Default,Guy,0,0,0,,Đại ca Sunohara! Xin đại ca hãy cho bọn em mượn sức mạnh!
Dialogue: 0,0:10:19.98,0:10:21.98,Default,Sun,0,0,0,,Cho tao xin thêm ly nước nữa trước được không?
Dialogue: 0,0:10:24.07,0:10:28.82,Default,Nag,0,0,0,,Sunohara-san. Cậu thật sự định đi đánh nhau tay đôi đấy à?
Dialogue: 0,0:10:29.28,0:10:32.99,Default,Nag,0,0,0,,Tớ nghĩ đánh nhau là không tốt đâu.
Dialogue: 0,0:10:35.66,0:10:36.79,Default,Yuk,0,0,0,,Mình xin lỗi.
Dialogue: 0,0:10:37.83,0:10:41.21,Default,Yuk,0,0,0,,Họ vốn dĩ cũng không phải là người xấu.
Dialogue: 0,0:10:41.58,0:10:48.01,Default,Yuk,0,0,0,,Nhưng khi có hai băng nhóm tồn tại trong một thị trấn nhỏ bé,\Nthì khó tránh khỏi việc xung đột đụng độ.
Dialogue: 0,0:10:49.84,0:10:57.06,Default,Yuk,0,0,0,,Nếu không phải tất cả mọi người trong thị trấn đều hạnh phúc,\Nthì chẳng ai có được hạnh phúc thực sự cả.
Dialogue: 0,0:10:59.85,0:11:02.60,Default,Yuk,0,0,0,,Xét riêng từng người thì ai nấy đều là người tốt cả,
Dialogue: 0,0:11:03.36,0:11:06.15,Default,Yuk,0,0,0,,vậy mà tại sao chuyện này lại xảy ra cơ chứ?
Dialogue: 0,0:11:16.62,0:11:19.37,Default,Sun,0,0,0,,Mẹ kiếp, run cầm cập hết cả người rồi này.
Dialogue: 0,0:11:19.37,0:11:21.75,Default,Guy,0,0,0,,Này! Bọn mày còn định bắt bọn tao đợi đến bao giờ nữa hả?!
Dialogue: 0,0:11:21.75,0:11:24.38,Default,Guy,0,0,0,,Đợi đại ca Sasaki tới đã!
Dialogue: 0,0:11:24.38,0:11:27.55,Default,Sun,0,0,0,,Trời đất ơi, tim tao như sắp nhảy khỏi lồng ngực rồi này.
Dialogue: 0,0:11:27.55,0:11:32.13,Default,Nag,0,0,0,,Sunohara-san. Hay là cậu lót dạ một chút\Ntrong lúc chờ đợi nhé?
Dialogue: 0,0:11:32.13,0:11:35.39,Default,Nag,0,0,0,,Mẹ tớ có gửi ít đồ ăn cho cậu này.
Dialogue: 0,0:11:35.89,0:11:37.01,Default,Sun,0,0,0,,Của cô Sanae gửi á?!
Dialogue: 0,0:11:37.01,0:11:42.39,Default,Nag,0,0,0,,{\fs78.3}Tớ bảo là Sunohara-san sắp có một trận quyết đấu vô cùng quan trọng,\Nthế là mẹ tớ bảo tớ mang cái này đến.
Dialogue: 0,0:11:42.39,0:11:45.48,Default,Nag,0,0,0,,Tác phẩm mới nhất của mẹ tớ: Bánh mì Cầu vồng Siêu cấp.
Dialogue: 0,0:11:46.77,0:11:47.98,Default,Sun,0,0,0,,Oa!
Dialogue: 0,0:11:47.98,0:11:50.15,Default,Nag,0,0,0,,Và có cả lời nhắn của Bố tớ nữa đấy.
Dialogue: 0,0:11:50.15,0:11:52.74,Default,Nag,0,0,0,,Bố tớ bảo: "Cầu vồng đến với mày đấy con trai".
Dialogue: 0,0:11:52.74,0:11:57.62,Default,Nag,0,0,0,,Và đây là món mứt tối thượng do bạn của mẹ tớ làm ra.
Dialogue: 0,0:11:57.62,0:12:00.83,Default,Nag,0,0,0,,Nếu quết món mứt tối thượng này lên bánh mì của mẹ tớ,
Dialogue: 0,0:12:00.83,0:12:02.96,Default,Nag,0,0,0,,thì sẽ tạo nên một sự kết hợp vô song.
Dialogue: 0,0:12:03.46,0:12:06.00,Default,Nag,0,0,0,,Mọi người có muốn ăn thử một chút không?
Dialogue: 0,0:12:06.00,0:12:07.71,Default,Guys,0,0,0,,Bọn tôi ăn được thật sao?
Dialogue: 0,0:12:07.71,0:12:09.34,Default,Guys,0,0,0,,Cảm ơn em gái nhé.
Dialogue: 0,0:12:11.13,0:12:12.92,Default,Guys,0,0,0,,Xin mời cả nhà cùng xơi!
Dialogue: 0,0:12:16.01,0:12:18.05,Default,Nag,0,0,0,,Sao thế mọi người ơi?!
Dialogue: 0,0:12:18.05,0:12:19.51,Default,Miy,0,0,0,,Mọi người hãy tỉnh lại đi ạ!
Dialogue: 0,0:12:20.22,0:12:21.68,Default,Sas,0,0,0,,Xin lỗi vì để các chú phải đợi lâu.
Dialogue: 0,0:12:23.14,0:12:24.56,Default,Oka,0,0,0,,Chết dở rồi!
Dialogue: 0,0:12:24.56,0:12:27.44,Default,Kid,0,0,0,,Làm sao bây giờ? Mọi người ngất xỉu lăn đùng ra hết rồi.
Dialogue: 0,0:12:30.94,0:12:31.94,Default,Oka,0,0,0,,Để tao lên.
Dialogue: 0,0:12:32.74,0:12:33.95,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:12:33.95,0:12:34.95,Default,Sis,0,0,0,,Cậu nói nghiêm túc đấy à?
Dialogue: 0,0:12:34.95,0:12:38.66,Default,Oka,0,0,0,,Không có thời gian để đôi co đâu. Chăm sóc mọi người đi.
Dialogue: 0,0:12:38.66,0:12:40.08,Default,Miy,0,0,0,,Okazaki-san!
Dialogue: 0,0:12:44.58,0:12:45.79,Default,Sas,0,0,0,,Chuyện này là thế nào đây?
Dialogue: 0,0:12:46.29,0:12:48.21,Default,Oka,0,0,0,,Có một chút hiểu lầm ở đây.
Dialogue: 0,0:12:48.59,0:12:51.80,Default,Oka,0,0,0,,Thực ra thằng đó không phải là Miyazawa Kazuto.
Dialogue: 0,0:12:51.80,0:12:54.05,Default,Oka,0,0,0,,Xin lỗi nhé, hôm nay anh đành phải đấu với tôi vậy.
Dialogue: 0,0:12:55.55,0:12:59.64,Default,Kid,0,0,0,,Không ổn rồi. Phải là anh Miyazawa Kazuto thật sự cơ.
Dialogue: 0,0:12:59.64,0:13:02.06,Default,Sis,0,0,0,,Dù có thế nào thì anh trai chị cũng không tới sao?
Dialogue: 0,0:13:02.06,0:13:08.40,Default,Nag,0,0,0,,Dù là để solo với anh Sasaki hay là để ngăn cản trận chiến, đều cần có anh trai của chị Miyazawa mà.
Dialogue: 0,0:13:13.78,0:13:16.32,Default,Sas,0,0,0,,Được thôi. Để tao chơi với mày một lúc.
Dialogue: 0,0:13:17.91,0:13:19.41,Default,Oka,0,0,0,,Cảm ơn anh nhiều nhé!
Dialogue: 0,0:13:21.79,0:13:23.08,Default,Guy,0,0,0,,Xông lên đại ca ơi!
Dialogue: 0,0:13:23.08,0:13:24.29,Default,Guy,0,0,0,,Hạ gục nó đi!
Dialogue: 0,0:13:26.92,0:13:28.00,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:13:28.00,0:13:29.38,Default,Kid,0,0,0,,Cố lên anh ơi!
Dialogue: 0,0:13:37.38,0:13:38.93,Default,Sas,0,0,0,,Khớp vai phải của mày bị yếu đúng không?
Dialogue: 0,0:13:38.93,0:13:40.22,Default,Oka,0,0,0,,Một chút.
Dialogue: 0,0:13:40.93,0:13:42.76,Default,Oka,0,0,0,,Nhưng tôi không cần anh phải nương tay đâu!
Dialogue: 0,0:13:42.76,0:13:45.06,Default,Sas,0,0,0,,Mày không cần phải nhắc!
Dialogue: 0,0:15:15.48,0:15:17.44,Default,Sas,0,0,0,,Mày cứng cỏi đấy.
Dialogue: 0,0:15:21.11,0:15:22.99,Default,Sas,0,0,0,,Đủ rồi đấy. Nằm yên đó đi.
Dialogue: 0,0:15:23.95,0:15:25.53,Default,Sas,0,0,0,,Hình như quân của mày tỉnh lại rồi kìa.
Dialogue: 0,0:15:30.62,0:15:31.79,Default,Nag,0,0,0,,Sunohara-san.
Dialogue: 0,0:15:31.79,0:15:33.50,Default,Kid,0,0,0,,Mọi người tỉnh lại rồi à?
Dialogue: 0,0:15:35.00,0:15:36.34,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:15:36.34,0:15:38.25,Default,Sun,0,0,0,,Okazaki, mày bị làm sao thế này?!
Dialogue: 0,0:15:38.25,0:15:39.55,Default,Nag,0,0,0,,Sunohara-san!
Dialogue: 0,0:15:39.55,0:15:41.93,Default,Sud,0,0,0,,Mày dám làm gì bạn của chị Yuki-nee hả thằng kia?!
Dialogue: 0,0:15:42.38,0:15:44.14,Default,Guys,0,0,0,,Anh em, xông lên trả thù cho nó!
Dialogue: 0,0:15:46.39,0:15:47.89,Default,Oka,0,0,0,,Dừng lại mau, Sunohara!
Dialogue: 0,0:15:47.89,0:15:49.85,Default,Guys,0,0,0,,Đại ca Sasaki đang gặp nguy hiểm kìa!
Dialogue: 0,0:15:49.85,0:15:51.02,Default,Guys,0,0,0,,Xông lên, không được tụt lại!
Dialogue: 0,0:15:51.02,0:15:52.14,Default,Sas,0,0,0,,Dừng lại! Đừng có qua đây!
Dialogue: 0,0:15:55.86,0:15:57.82,Default,Guys,0,0,0,,Khoan đã! Dừng lại mau! Dừng lại!
Dialogue: 0,0:16:04.61,0:16:06.87,Default,Sud,0,0,0,,A-Anh Kazuto!
Dialogue: 0,0:16:07.74,0:16:08.66,Default,Guys,0,0,0,,Là anh ấy kìa.
Dialogue: 0,0:16:08.66,0:16:09.74,Default,Guys,0,0,0,,Chuyện gì đang xảy ra thế này?
Dialogue: 0,0:16:09.74,0:16:12.62,Default,Guys,0,0,0,,Đó là Miyazawa Kazuto thật đấy sao?
Dialogue: 0,0:16:13.29,0:16:15.83,Default,Sas,0,0,0,,Trốn viện ra đây đấy à mày?
Dialogue: 0,0:16:15.83,0:16:19.25,Default,Sas,0,0,0,,Quả đúng như lời đồn, mày gan góc lắm Miyazawa Kazuto!
Dialogue: 0,0:16:20.25,0:16:24.13,Default,Sas,0,0,0,,Nhưng tao không thể nương tay được đâu.\NXin lỗi nhé, tao buộc phải đập mày tơi tả thôi!
Dialogue: 0,0:16:32.10,0:16:32.89,Default,Oka,0,0,0,,Miyazawa?!
Dialogue: 0,0:16:38.40,0:16:39.73,Default,Yuk,0,0,0,,Tôi vẫn chưa xong đâu!
Dialogue: 0,0:16:41.23,0:16:43.61,Default,Sas,0,0,0,,Dừng lại đi. Em đang nghĩ cái quái gì thế hả?!
Dialogue: 0,0:16:43.95,0:16:45.45,Default,Yuk,0,0,0,,Tôi là...
Dialogue: 0,0:16:45.45,0:16:47.99,Default,Yuk,0,0,0,,Tôi là Miyazawa Kazuto!
Dialogue: 0,0:16:47.99,0:16:49.24,Default,Oka,0,0,0,,Dừng lại đi, Miyazawa!
Dialogue: 0,0:16:50.16,0:16:52.33,Default,Yuk,0,0,0,,Buông ra! Mau buông tôi ra!
Dialogue: 0,0:16:52.33,0:16:54.21,Default,Nag,0,0,0,,Cậu ấy mặc áo khoác từ lúc nào thế...
Dialogue: 0,0:16:54.50,0:16:58.29,Default,Kid,0,0,0,,Chị ấy chạy đi bảo là đi đón anh trai.
Dialogue: 0,0:16:58.96,0:17:01.30,Default,Kid,0,0,0,,Em cứ tưởng chị ấy chạy đến bệnh viện...
Dialogue: 0,0:17:02.21,0:17:04.42,Default,Sud,0,0,0,,Làm sao chị ấy có thể đi đón anh ấy được chứ...
Dialogue: 0,0:17:05.13,0:17:07.89,Default,Sud,0,0,0,,Làm sao chị ấy có thể đón anh Kazuto được cơ chứ!!!
Dialogue: 0,0:17:07.97,0:17:09.39,Default,Yuk,0,0,0,,Buông tôi ra!!!
Dialogue: 0,0:17:11.51,0:17:13.89,Default,Yuk,0,0,0,,Đừng có cản đường tôi!
Dialogue: 0,0:17:13.89,0:17:15.52,Default,Guy,0,0,0,,Chị Yuki-nee, đủ rồi đấy chị ơi!
Dialogue: 0,0:17:15.52,0:17:16.27,Default,Sud,0,0,0,,Chị Yuki-nee!
Dialogue: 0,0:17:17.23,0:17:19.15,Default,Sud,0,0,0,,Tại sao chị ấy lại làm thế này chứ?
Dialogue: 0,0:17:23.53,0:17:24.61,Default,Oka,0,0,0,,Mấy thằng ngu chúng mày!
Dialogue: 0,0:17:25.86,0:17:29.62,Default,Oka,0,0,0,,Để ngăn cản lũ chúng mày chứ còn gì nữa!
Dialogue: 0,0:17:29.62,0:17:33.79,Default,Oka,0,0,0,,Cách duy nhất để dẹp tan cuộc chiến là để Miyazawa Kazuto xuất hiện!
Dialogue: 0,0:17:33.79,0:17:36.08,Default,Oka,0,0,0,,Chính vì thế cậu ấy mới phải đóng giả làm anh trai mình!
Dialogue: 0,0:17:36.08,0:17:37.87,Default,Oka,0,0,0,,Chúng mày vẫn chưa sáng mắt ra à?!
Dialogue: 0,0:17:40.17,0:17:44.84,Default,Miy,0,0,0,,Tại sao... Tại sao chúng ta lại phải chém giết đánh nhau chứ?
Dialogue: 0,0:17:45.42,0:17:48.13,Default,Miy,0,0,0,,Phải làm sao thì mọi người mới chịu dừng đánh nhau đây?!
Dialogue: 0,0:17:48.89,0:17:51.51,Default,Miy,0,0,0,,Phải làm sao... Phải làm sao thì mọi người mới...
Dialogue: 0,0:17:56.14,0:18:00.48,Default,Miy,0,0,0,,Xin các anh. Xin các anh hãy dừng đánh nhau lại đi mà.
Dialogue: 0,0:18:02.52,0:18:06.44,Default,Miy,0,0,0,,Em chắc chắn rằng đó cũng là tâm nguyện của anh trai em.
Dialogue: 0,0:18:18.62,0:18:20.29,Default,Oka,0,0,0,,Hóa ra đó là lý do...
Dialogue: 0,0:18:20.29,0:18:21.54,Signs,,0,0,0,,{\blur1.5\fnEdo SZ\fs63\fscy75\pos(1168.5,1021.5)\c&HFBFBED&\b1}M\Nộ\N \Nd\Nò\Nn\Ng\N \Nh\Nọ\N \NM\Ni\Ny\Na\Nz\Na\Nw\Na
Dialogue: 0,0:18:23.42,0:18:31.05,Signs,,0,0,0,,{\blur1.5\fnEdo SZ\fs30\fscy75\c&HFBFBED&\b1\frx8\fry346\frz3.399\pos(1258.5,606)}M\Nộ\N \Nd\Nò\Nn\Ng\N \Nh\Nọ\N \NM\Ni\Ny\Na\Nz\Na\Nw\Na
Dialogue: 0,0:18:25.00,0:18:29.63,Default,Miy,0,0,0,,Suốt một thời gian dài, mình từng rất sợ hãi anh trai và bạn bè của anh ấy.
Dialogue: 0,0:18:30.76,0:18:38.81,Default,Miy,0,0,0,,Nhưng khi nhìn thấy anh Sudou và anh Tajima khóc nức nở trong đám tang của anh ấy, mình đã tự hỏi...
Dialogue: 0,0:18:40.27,0:18:45.19,Default,Miy,0,0,0,,"Tại sao mình không thử tìm hiểu và cảm thông hơn với cách sống của anh ấy nhỉ?"
Dialogue: 0,0:18:46.73,0:18:50.78,Default,Miy,0,0,0,,Chính vì thế mình mới gom hết can đảm để đến làm quen với tất cả mọi người.
Dialogue: 0,0:18:51.24,0:18:53.91,Default,Miy,0,0,0,,Ban đầu, mình thấy sợ lắm,
Dialogue: 0,0:18:54.99,0:18:59.79,Default,Miy,0,0,0,,nhưng rồi từng chút một, mọi người đã mở rộng vòng tay đón nhận mình vào nhóm.
Dialogue: 0,0:19:00.96,0:19:07.55,Default,Miy,0,0,0,,Và khi ở bên cạnh mọi người, mình có cảm giác như đang được cười đùa cùng với anh Kazuto vậy.
Dialogue: 0,0:19:09.26,0:19:13.26,Default,Miy,0,0,0,,Cho đến tận giây phút cuối cùng, anh trai mình vẫn mong mỏi sẽ không còn những vụ chém giết đánh nhau nữa.
Dialogue: 0,0:19:14.10,0:19:19.31,Default,Miy,0,0,0,,{\fs78.3}Nhưng nếu sự thật về việc anh ấy qua đời bị bại lộ,\Nchúng mình sợ rằng nhóm của anh Sasaki sẽ tràn sang tấn công.
Dialogue: 0,0:19:20.06,0:19:25.94,Default,Miy,0,0,0,,Chính vì thế mọi người đã bàn bạc với nhau\Nvà quyết định giữ kín bí mật về cái chết của anh ấy.
Dialogue: 0,0:19:28.65,0:19:31.95,Default,Miy,0,0,0,,Ước nguyện của anh trai mình là xóa bỏ hoàn toàn những trận ẩu đả ra khỏi thị trấn này.
Dialogue: 0,0:19:32.86,0:19:35.58,Default,Miy,0,0,0,,Mình muốn biến tâm nguyện ấy thành hiện thực...
Dialogue: 0,0:19:38.24,0:19:39.33,Default,Miy,0,0,0,,...bằng bất cứ giá nào!
Dialogue: 0,0:20:00.93,0:20:04.90,Default,Miy,0,0,0,,Em tin chắc giờ này ở nơi chín suối, anh Kazuto đang mỉm cười mãn nguyện.
Dialogue: 0,0:20:15.78,0:20:17.99,Default,Nag,0,0,0,,Có chuyện gì thế, Tomoya-kun?
Dialogue: 0,0:20:30.38,0:20:33.05,Default,Yuk,0,0,0,,Lòng mình giờ đây thanh thản nhẹ nhõm rồi.
Dialogue: 0,0:20:34.01,0:20:38.68,Default,Yuk,0,0,0,,Có lẽ là do cuối cùng mình cũng đã chấp nhận được sự thật về sự ra đi của anh trai.
Dialogue: 0,0:20:40.10,0:20:43.56,Default,Yuk,0,0,0,,Tất cả là nhờ có mọi người. Em cảm ơn mọi người nhiều lắm.
Dialogue: 0,0:20:46.94,0:20:50.23,Default,Yuk,0,0,0,,Mọi người có biết về truyền thuyết của thị trấn này không?
Dialogue: 0,0:20:50.23,0:20:51.40,Default,Oka,0,0,0,,Truyền thuyết sao?
Dialogue: 0,0:20:52.44,0:20:55.99,Default,Miy,0,0,0,,Khoảnh khắc một điều tốt đẹp xảy ra hoặc khi ai đó cảm nhận được niềm hạnh phúc ngập tràn,
Dialogue: 0,0:20:55.99,0:20:58.32,Default,Miy,0,0,0,,một đốm sáng lấp lánh sẽ xuất hiện.
Dialogue: 0,0:20:59.16,0:21:00.91,Default,Miy,0,0,0,,Không ai biết chính xác chúng là thứ gì.
Dialogue: 0,0:21:01.33,0:21:06.54,Default,Miy,0,0,0,,Chỉ biết chắc chắn rằng những đốm sáng ấy được coi là biểu tượng của niềm hạnh phúc.
Dialogue: 0,0:21:06.54,0:21:11.05,Default,Miy,0,0,0,,Và nếu ai có được một đốm sáng, thì bất kỳ một điều ước nào cũng sẽ trở thành hiện thực.
Dialogue: 0,0:21:11.75,0:21:14.55,Default,Nag,0,0,0,,Tomoya-kun. Chẳng phải chuyện này giống hệt câu chuyện của chị Misae sao?
Dialogue: 0,0:21:15.09,0:21:15.59,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:21:16.09,0:21:20.01,Default,Yuk,0,0,0,,Nhưng xem ra ngày nay càng lúc càng ít người có thể nhìn thấy chúng.
Dialogue: 0,0:21:20.39,0:21:23.06,Default,Sun,0,0,0,,Vậy đốm sáng mà Okazaki bảo cậu ấy từng nhìn thấy chính là thứ đó à?
Dialogue: 0,0:21:24.43,0:21:28.90,Default,Yuk,0,0,0,,Biết đâu Okazaki-san là một người đặc biệt thì sao.
Dialogue: 0,0:21:28.90,0:21:29.77,Default,Oka,0,0,0,,Tôi á?
Dialogue: 0,0:21:30.06,0:21:31.36,Default,Nag,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:21:31.86,0:21:34.61,Default,Yuk,0,0,0,,Mình xin lỗi. Mình cũng không rõ gì hơn nữa đâu.
Dialogue: 0,0:21:36.61,0:21:39.78,Default,Yuk,0,0,0,,Nhưng Okazaki-san, cậu vẫn mãi là chính cậu mà thôi.
Dialogue: 0,0:21:39.78,0:21:41.95,Default,Yuk,0,0,0,,Một người bạn vô cùng quan trọng của mình.
Dialogue: 0,0:21:42.49,0:21:46.33,Default,Yuk,0,0,0,,Tất cả các cậu đều là những người bạn vô cùng quý giá của mình.
Dialogue: 0,0:21:49.13,0:21:52.00,Default,Yuk,0,0,0,,Mình thực sự là một người may mắn và hạnh phúc biết bao.
Dialogue: 0,0:21:52.67,0:21:55.05,Default,Yuk,0,0,0,,Mình được biết bao nhiêu người chở che và nâng đỡ.
Dialogue: 0,0:22:02.05,0:22:03.47,Default,Yuk,0,0,0,,Anh Kazuto ơi...
Dialogue: 0,0:22:04.72,0:22:05.64,Default,Yuk,0,0,0,,Em cảm ơn anh nhiều lắm.
Dialogue: 0,0:22:18.78,0:22:26.29,ED English,,0,0,0,,{\be1}Tôi từng ngắm nhìn những áng mây bồng bềnh trôi.
