Dialogue: 0,0:00:08.78,0:00:10.16,Default,Oka,0,0,0,,Cậu thiếu ngủ à?
Dialogue: 0,0:00:11.75,0:00:15.29,Default,Yuk,0,0,0,,Xin lỗi hai cậu nhé. Đêm qua mình trằn trọc không ngủ ngon giấc được.
Dialogue: 0,0:00:16.92,0:00:19.55,Default,Nag,0,0,0,,Không có câu bùa chú nào giúp ngủ ngon sao cậu?
Dialogue: 0,0:00:19.55,0:00:22.13,Default,Yuk,0,0,0,,Có chứ, nhưng mà...
Dialogue: 0,0:00:22.80,0:00:25.22,Default,Nag,0,0,0,,Bùa chú giúp ngủ ngon.
Dialogue: 0,0:00:25.72,0:00:28.85,Default,Nag,0,0,0,,Hãy nhờ ai đó cho gối đầu lên đùi.
Dialogue: 0,0:00:28.85,0:00:31.93,Default,Nag,0,0,0,,Làm như vậy thì một giấc ngủ ngon lành thanh thản...
Dialogue: 0,0:00:31.93,0:00:32.93,Default,Nag,0,0,0,,...sẽ hoàn toàn thuộc về bạn.
Dialogue: 0,0:00:32.93,0:00:35.56,Default,Oka,0,0,0,,Cái này đâu phải là bùa chú đâu.
Dialogue: 0,0:00:35.56,0:00:38.15,Default,Nag,0,0,0,,Nhưng nghe chừng đúng là sẽ ngủ rất ngon đấy chứ.
Dialogue: 0,0:00:38.94,0:00:42.90,Default,Yuk,0,0,0,,Hồi nhỏ mình thường hay được anh trai cho gối đầu lên đùi,
Dialogue: 0,0:00:42.90,0:00:45.15,Default,Yuk,0,0,0,,nhưng giờ lớn rồi nên...
Dialogue: 0,0:00:45.53,0:00:47.99,Default,Nag,0,0,0,,Tớ có ý này rồi!
Dialogue: 0,0:00:47.99,0:00:51.91,Default,Nag,0,0,0,,Hay là để Tomoya-kun cho cậu gối đầu lên đùi thay cho anh trai nhé?
Dialogue: 0,0:00:54.41,0:00:59.21,Default,Yuk,0,0,0,,Không nên đâu. Làm thế mình thấy có lỗi với cậu lắm.
Dialogue: 0,0:01:00.17,0:01:02.92,Default,Nag,0,0,0,,Không sao đâu, cậu đừng bận tâm. Cứ tự nhiên đi.
Dialogue: 0,0:01:13.14,0:01:16.98,Default,Yuk,0,0,0,,Xin lỗi hai cậu nhé. Vậy thì mình xin phép mượn cậu ấy một chút nhé.
Dialogue: 0,0:01:19.98,0:01:21.32,Default,Yuk,0,0,0,,Mình xin phép.
Dialogue: 0,0:01:21.32,0:01:23.32,Default,Oka,0,0,0,,Ừ-Ừm...
Dialogue: 0,0:01:28.66,0:01:31.20,Default,Yuk,0,0,0,,Cảm giác... êm ái ghê...
Dialogue: 0,0:01:33.37,0:01:36.00,Default,Nag,0,0,0,,Cậu ấy ngủ thiếp đi ngay tức khắc rồi.
Dialogue: 0,0:01:36.54,0:01:39.71,Default,Oka,0,0,0,,Nhìn cảnh này cậu không thấy ghen chút nào à?
Dialogue: 0,0:01:41.29,0:01:44.34,Default,Nag,0,0,0,,Nói thật thì tớ cũng có một chút ghen tị đấy.
Dialogue: 0,0:01:45.38,0:01:47.34,Default,Nag,0,0,0,,Nhưng khi nhìn thấy vẻ mặt ấy của cậu ấy...
Dialogue: 0,0:01:49.13,0:01:50.84,Default,Nag,0,0,0,,Chắc hẳn cậu ấy đã mệt mỏi lắm rồi.
Dialogue: 0,0:01:51.39,0:01:55.85,Default,Nag,0,0,0,,Chắc cậu ấy luôn phải lo nghĩ vì những vụ đánh nhau của nhóm anh Sudou và bạn bè.
Dialogue: 0,0:01:57.56,0:01:59.90,Default,Sun,0,0,0,,Hú le! Yukine-chan có ở đây không đấy?!
Dialogue: 0,0:01:59.90,0:02:03.11,Default,Sun,0,0,0,,Cho tôi xin thêm đĩa cơm chiên thập cẩm ngon tuyệt cú mèo nữa nào!
Dialogue: 0,0:02:03.11,0:02:05.23,Default,Sun,0,0,0,,Tự nhiên như ở nhà mình thế kia à!
Dialogue: 0,0:02:06.65,0:02:08.15,Default,Sun,0,0,0,,Ui da...
Dialogue: 0,0:02:10.11,0:02:11.82,Default,Nag,0,0,0,,Khẽ mồm thôi.
Dialogue: 0,0:02:11.82,0:02:13.41,Default,Sun,0,0,0,,Cái gì thế? Ơ kìa!
Dialogue: 0,0:02:17.33,0:02:19.54,Default,Yuk,0,0,0,,Anh Kazuto...
Dialogue: 0,0:02:38.06,0:02:43.65,OP English,,0,0,0,,{\be1\fad(250,0)}Nơi lưng chừng con dốc năm nào chỉ riêng em cất bước...
