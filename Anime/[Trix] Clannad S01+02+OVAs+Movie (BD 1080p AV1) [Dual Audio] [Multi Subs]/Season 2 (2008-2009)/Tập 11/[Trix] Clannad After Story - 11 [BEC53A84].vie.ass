Dialogue: 0,0:00:02.95,0:00:04.15,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:00:04.15,0:00:05.86,Default,Nag,0,0,0,,Sáng rồi đó, Tomoya-kun.
Dialogue: 0,0:00:07.62,0:00:10.12,Default,Nag,0,0,0,,Bữa sáng xong rồi nè, Tomoya-kun.
Dialogue: 0,0:00:10.62,0:00:12.12,Default,Oka,0,0,0,,À, chào buổi sáng nhé.
Dialogue: 0,0:00:13.71,0:00:15.12,Default,Oka,0,0,0,,Ái chà...
Dialogue: 0,0:00:15.79,0:00:17.13,Default,Oka,0,0,0,,Sáng nào cũng phiền cậu thế này, xin lỗi nhé.
Dialogue: 0,0:00:17.13,0:00:19.34,Default,Nag,0,0,0,,Em không phiền chút nào đâu ạ.
Dialogue: 0,0:00:19.34,0:00:22.13,Default,Nag,0,0,0,,Còn cậu thì sao? Người ngợm có ổn không?
Dialogue: 0,0:00:22.13,0:00:26.64,Default,Oka,0,0,0,,Chưa, cũng bắt đầu quen dần rồi,\Nnhưng khắp người vẫn đau ê ẩm lắm.
Dialogue: 0,0:00:26.64,0:00:29.22,Default,Nag,0,0,0,,Xin cậu đừng làm việc quá sức nhé.
Dialogue: 0,0:00:29.22,0:00:29.89,Default,Oka,0,0,0,,Ừ, tớ biết rồi.
Dialogue: 0,0:00:39.02,0:00:40.52,Default,Oka,0,0,0,,Chào buổi sáng mọi người!
Dialogue: 0,0:00:41.40,0:00:41.90,Default,Man,0,0,0,,Yo.
Dialogue: 0,0:00:42.40,0:00:44.11,Default,Yos,0,0,0,,Đến rồi à. Mau thay đồ đi.
Dialogue: 0,0:00:44.11,0:00:45.15,Default,Oka,0,0,0,,Vâng ạ.
