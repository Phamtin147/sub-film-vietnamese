Dialogue: 0,0:00:58.88,0:01:00.84,Default,Yos,0,0,0,,Cậu cầm cờ-lê sai cách rồi.
Dialogue: 0,0:01:00.84,0:01:02.59,Default,Yos,0,0,0,,Tôi đã chỉ cậu bao nhiêu lần rồi mà.
Dialogue: 0,0:01:02.59,0:01:03.38,Default,Oka,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:01:04.26,0:01:06.22,Default,Yos,0,0,0,,Bôi keo dán nhiều quá rồi đấy.
Dialogue: 0,0:01:06.22,0:01:08.55,Default,Yos,0,0,0,,Và phải siết ốc theo đường chéo đối xứng chứ.
Dialogue: 0,0:01:08.55,0:01:09.22,Default,Yos,0,0,0,,Quên rồi à?
Dialogue: 0,0:01:09.22,0:01:10.35,Default,Oka,0,0,0,,Em xin lỗi ạ!
Dialogue: 0,0:01:10.35,0:01:13.68,Default,Yos,0,0,0,,Tập trung vào. Không tập trung là bị thương đấy.
Dialogue: 0,0:01:13.68,0:01:14.10,Default,Oka,0,0,0,,Vâng ạ.
Dialogue: 0,0:01:19.65,0:01:20.81,Default,Oka,0,0,0,,Tớ về rồi đây.
Dialogue: 0,0:01:21.15,0:01:22.90,Default,Nag,0,0,0,,Mừng cậu đã về.
Dialogue: 0,0:01:22.90,0:01:25.86,Default,Nag,0,0,0,,Em có mua thịt heo để bồi bổ sức khỏe cho cậu nè.
Dialogue: 0,0:01:25.86,0:01:27.86,Default,Oka,0,0,0,,Thật sao? Cảm ơn cậu nhé.
Dialogue: 0,0:01:28.61,0:01:31.37,Default,Nag,0,0,0,,Sắp xong rồi, cậu ngồi nghỉ ngơi đi ạ.
Dialogue: 0,0:01:32.03,0:01:33.58,Default,Nag,0,0,0,,Nước tắm em cũng chuẩn bị sẵn rồi đấy.
Dialogue: 0,0:01:35.75,0:01:36.37,Default,Oka,0,0,0,,Ừ, cảm ơn cậu.
Dialogue: 0,0:01:38.33,0:01:40.46,Default,TV,0,0,0,,Tớ bảo cái đó là của tớ mà!
Dialogue: 0,0:01:40.46,0:01:41.34,Default,TV,0,0,0,,Không chịu đâu~
Dialogue: 0,0:01:41.34,0:01:43.17,Default,TV,0,0,0,,Muốn ăn thì tự đi mà mua đi chứ!
Dialogue: 0,0:01:43.17,0:01:44.34,Default,TV,0,0,0,,Được rồi mà~
Dialogue: 0,0:01:44.34,0:01:46.34,Default,Nag,0,0,0,,Cậu buồn ngủ rồi sao, Tomoya-kun?
Dialogue: 0,0:01:47.55,0:01:49.34,Default,Oka,0,0,0,,Không, tớ vẫn ổn.
Dialogue: 0,0:01:53.10,0:01:56.18,Default,Oka,0,0,0,,Hiện tại, mình đang được Nagisa luôn ở bên cạnh chở che, nâng đỡ.
Dialogue: 0,0:01:57.10,0:02:01.15,Default,Oka,0,0,0,,Ngày nào Nagisa cũng lo lắng rồi chạy sang chăm sóc cho mình.
Dialogue: 0,0:02:02.11,0:02:05.11,Default,Oka,0,0,0,,Chỉ cần bấy nhiêu thôi cũng đủ để mình tiếp tục\Nnỗ lực làm việc chăm chỉ mà không hề bỏ cuộc.
