Dialogue: 0,0:04:05.27,0:04:08.19,Default,Yos,0,0,0,,Sao việc gì cậu cũng làm một cách vất vả thế?
Dialogue: 0,0:04:08.19,0:04:10.03,Default,Oka,0,0,0,,Ý anh là sao cơ ạ?
Dialogue: 0,0:04:10.03,0:04:12.44,Default,Yos,0,0,0,,Dùng cả hai tay có phải dễ hơn không?
Dialogue: 0,0:04:12.44,0:04:14.66,Default,Yos,0,0,0,,Sao cậu không dùng tay phải nhiều hơn một chút?
Dialogue: 0,0:04:16.11,0:04:19.08,Default,Oka,0,0,0,,Dạ không, em làm thế này thấy quen tay và dễ hơn ạ.
Dialogue: 0,0:04:20.54,0:04:23.58,Default,Yos,0,0,0,,Được rồi. Miễn là cậu không làm sai quy trình là được.
Dialogue: 0,0:04:25.71,0:04:27.58,Default,Girl,0,0,0,,Để xem nào, mình muốn chọn cái này hơn...
Dialogue: 0,0:04:34.47,0:04:36.34,Default,Nag,0,0,0,,Tomoya-kun. Tomoya-kun.
Dialogue: 0,0:04:36.34,0:04:38.89,Default,Oka,0,0,0,,Hở, có chuyện gì thế Nagisa?
Dialogue: 0,0:04:38.89,0:04:42.52,Default,Nag,0,0,0,,Em gọi cậu nãy giờ mà cậu chẳng trả lời gì cả.
Dialogue: 0,0:04:42.52,0:04:45.10,Default,Oka,0,0,0,,Xin lỗi nhé, tớ đang mải nghĩ về công việc một chút.
Dialogue: 0,0:04:45.56,0:04:46.65,Default,Nag,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:04:46.65,0:04:48.90,Default,Oka,0,0,0,,Sao tự nhiên cậu lại xin lỗi?
Dialogue: 0,0:04:48.90,0:04:54.03,Default,Nag,0,0,0,,Cậu đi làm việc vất vả cả ngày như thế,\Nvậy mà em cứ lải nhải làm phiền cậu mãi.
Dialogue: 0,0:04:54.03,0:04:55.15,Default,Nag,0,0,0,,Em xin lỗi cậu nhiều lắm.
Dialogue: 0,0:04:55.15,0:04:57.03,Default,Oka,0,0,0,,Cậu nói gì kỳ vậy hả?!
Dialogue: 0,0:04:57.03,0:05:01.54,Default,Oka,0,0,0,,Nhờ có cậu trò chuyện đủ thứ chuyện trên đời mà tớ mới có lúc thảnh thơi xả hơi đấy.
Dialogue: 0,0:05:05.25,0:05:09.54,Default,Nag,0,0,0,,Chẳng phải sẽ tốt hơn nếu cậu nói với Yoshino-san về việc vai phải của cậu bị thương sao?
Dialogue: 0,0:05:09.54,0:05:13.80,Default,Oka,0,0,0,,Không được đâu. Nhỡ người ta không cho tớ làm việc nữa thì sao.
Dialogue: 0,0:05:14.13,0:05:15.55,Default,Nag,0,0,0,,Cậu nghĩ vậy thật sao?
Dialogue: 0,0:05:15.55,0:05:19.97,Default,Oka,0,0,0,,Dù Yoshino-san có thông cảm bỏ qua,\Nthì giám đốc cũng chưa chắc đã đồng ý.
Dialogue: 0,0:05:20.26,0:05:23.39,Default,Oka,0,0,0,,Công ty đó tuy nhỏ nhưng đãi ngộ lương bổng khá tốt.
Dialogue: 0,0:05:23.72,0:05:26.02,Default,Oka,0,0,0,,Mất việc một cái là tớ ra đường ở ngay lập tức.
Dialogue: 0,0:05:26.02,0:05:29.10,Default,Nag,0,0,0,,Nhưng cậu phải hết sức cẩn thận, đừng để bị thương nhé.
Dialogue: 0,0:05:29.10,0:05:30.73,Default,Oka,0,0,0,,Ừ, tớ biết rồi mà.
Dialogue: 0,0:05:33.78,0:05:35.99,Default,Nag,0,0,0,,Vậy mai em lại đến nhé.
Dialogue: 0,0:05:35.99,0:05:36.95,Default,Oka,0,0,0,,Chúc ngủ ngon.
Dialogue: 0,0:05:38.66,0:05:39.45,Default,Oka,0,0,0,,Sao thế?
Dialogue: 0,0:05:39.45,0:05:42.20,Default,Nag,0,0,0,,Tomoya-kun, cậu có thấy cô đơn không?
Dialogue: 0,0:05:43.33,0:05:47.96,Default,Nag,0,0,0,,Sau khi em về rồi, chỉ còn lại một mình cậu trong căn phòng này thôi.
Dialogue: 0,0:05:48.50,0:05:52.54,Default,Nag,0,0,0,,Mỗi lần nghĩ đến điều đó,\Nem lại thấy muốn trào nước mắt...
Dialogue: 0,0:05:53.42,0:05:56.47,Default,Oka,0,0,0,,Đồ ngốc. Có gì đâu mà phải khóc chứ?
Dialogue: 0,0:05:56.47,0:05:58.18,Default,Nag,0,0,0,,Có thể là vậy, nhưng mà...
Dialogue: 0,0:05:58.18,0:06:01.47,Default,Oka,0,0,0,,Chỉ còn một mình là tớ lăn ra ngủ ngay rồi,\Nnên chẳng có gì phải bận tâm đâu.
Dialogue: 0,0:06:01.47,0:06:04.01,Default,Oka,0,0,0,,Đừng lo lắng gì hết, mau về nhà đi nhé.
Dialogue: 0,0:06:04.51,0:06:07.18,Default,Nag,0,0,0,,Vâng ạ. Chúc cậu ngủ ngon nhé.
Dialogue: 0,0:06:19.24,0:06:20.28,Default,Oka,0,0,0,,Mình đang làm gì thế này ạ?
Dialogue: 0,0:06:20.28,0:06:23.78,Default,Yos,0,0,0,,Chúng ta cần chụp ảnh nghiệm thu làm bằng chứng khi hoàn thành công trình.
Dialogue: 0,0:06:24.41,0:06:25.20,Default,Yos,0,0,0,,Cầm cái này đi.
Dialogue: 0,0:06:32.71,0:06:34.50,Default,Man,0,0,0,,Vất vả cho cậu rồi, Yoshino-san.
Dialogue: 0,0:06:35.25,0:06:35.80,Default,Man,0,0,0,,Chào anh.
Dialogue: 0,0:06:36.67,0:06:38.05,Default,Oka,0,0,0,,Kinoshita-san!
Dialogue: 0,0:06:38.05,0:06:40.72,Default,Yos,0,0,0,,Kinoshita-san, hai người quen nhau à?
Dialogue: 0,0:06:40.72,0:06:44.60,Default,Man,0,0,0,,Hồi trước tôi từng làm cùng văn phòng với bố của Tomoya-kun.
Dialogue: 0,0:06:44.60,0:06:47.06,Default,Man,0,0,0,,Tôi cũng từng đến nhà cậu ấy chơi vài lần rồi.
Dialogue: 0,0:06:48.06,0:06:50.02,Default,Man,0,0,0,,Cháu lớn nhanh quá, nhận không ra luôn đấy.
Dialogue: 0,0:06:50.02,0:06:54.31,Default,Oka,0,0,0,,Cháu cũng bất ngờ khi gặp lại chú ở một nơi thế này ạ.
Dialogue: 0,0:06:54.86,0:06:58.19,Default,Man,0,0,0,,Từ sau khi văn phòng cũ đóng cửa,\Nchú được điều chuyển sang chi nhánh đang làm hiện tại.
Dialogue: 0,0:06:58.82,0:07:00.15,Default,Man,0,0,0,,Bố cháu dạo này vẫn khỏe chứ?
Dialogue: 0,0:07:00.15,0:07:04.45,Default,Oka,0,0,0,,Dạ, hiện tại cháu dọn ra ở riêng rồi nên gần đây cũng không gặp ông ấy ạ.
Dialogue: 0,0:07:07.20,0:07:10.58,Default,Yos,0,0,0,,Công việc của chúng ta chạy khắp nơi, nên thỉnh thoảng tình cờ tao ngộ thế này cũng là chuyện thường.
Dialogue: 0,0:07:11.50,0:07:13.83,Default,Yos,0,0,0,,Những lúc như thế mới thấy thế giới này thật nhỏ bé làm sao.
Dialogue: 0,0:07:13.83,0:07:17.84,Default,Oka,0,0,0,,Còn với em, cảm giác như thế giới vừa rộng lớn thêm một chút vậy.
Dialogue: 0,0:07:19.92,0:07:21.84,Default,Yos,0,0,0,,Cậu nhìn chăm chú vào đó ghê nhỉ.
Dialogue: 0,0:07:21.84,0:07:27.10,Default,Oka,0,0,0,,Nhìn cảnh này khiến em nhận ra các tòa nhà cứ mọc lên từng ngày mà em chẳng hề hay biết.
Dialogue: 0,0:07:29.72,0:07:31.64,Default,Yos,0,0,0,,Mọi thứ sẽ còn đổi thay nhiều hơn nữa.
Dialogue: 0,0:07:32.31,0:07:36.31,Default,Yos,0,0,0,,Khi con đường mới được mở ra, các tòa cao ốc văn phòng và cửa tiệm sẽ mọc lên san sát.
Dialogue: 0,0:07:36.94,0:07:39.61,Default,Yos,0,0,0,,Sắp tới một bệnh viện lớn cũng sẽ được xây dựng ở đây đấy.
Dialogue: 0,0:07:39.61,0:07:41.36,Default,Oka,0,0,0,,Thật vậy sao ạ?
Dialogue: 0,0:07:41.36,0:07:44.70,Default,Oka,0,0,0,,Dù vậy, em cũng chẳng muốn thấy mọi thứ đổi thay quá nhanh đâu.
Dialogue: 0,0:07:50.62,0:07:53.08,Default,Oka,0,0,0,,Chủ nhật tới cậu có muốn đi đâu chơi không?
Dialogue: 0,0:07:54.00,0:07:57.54,Default,Nag,0,0,0,,A, xin lỗi cậu nhé. Chủ nhật này có kỳ thi thử ở trường rồi.
Dialogue: 0,0:07:57.54,0:08:00.21,Default,Oka,0,0,0,,Thi thử á? Tớ tưởng cậu không định thi lên đại học chứ.
Dialogue: 0,0:08:00.80,0:08:05.22,Default,Nag,0,0,0,,Dù là vậy, em vẫn muốn tham gia kỳ thi thử cùng với mọi người.
Dialogue: 0,0:08:05.22,0:08:07.05,Default,Nag,0,0,0,,Nên là, em xin lỗi cậu nhé...
Dialogue: 0,0:08:07.68,0:08:08.81,Default,Oka,0,0,0,,Tớ hiểu rồi.
Dialogue: 0,0:08:09.39,0:08:12.10,Default,Oka,0,0,0,,Dạo này hai đứa mình cứ lệch giờ nhau suốt nhỉ.
Dialogue: 0,0:08:13.69,0:08:16.61,Default,Oka,0,0,0,,Đừng bận tâm nhé. Cố gắng thi cho tốt vào đấy.
Dialogue: 0,0:08:18.65,0:08:19.23,Default,Nag,0,0,0,,Vâng, em sẽ cố hết sức ạ.
Dialogue: 0,0:08:21.74,0:08:25.24,Default,Oka,0,0,0,,Thế rốt cuộc tại sao cháu lại phải đi cùng chú chứ?
Dialogue: 0,0:08:25.24,0:08:27.24,Default,Aki,0,0,0,,Đừng có tỏ vẻ chán ghét chú mày thế chứ lị.
Dialogue: 0,0:08:27.24,0:08:29.08,Default,Aki,0,0,0,,Hôm nay chú cũng tình cờ rảnh rỗi mà.
Dialogue: 0,0:08:29.53,0:08:32.00,Default,Aki,0,0,0,,Hôm nay đi thưởng thức trò giải trí của người lớn chút nhé?
Dialogue: 0,0:08:32.00,0:08:33.79,Default,Oka,0,0,0,,Trò giải trí của người lớn á?
Dialogue: 0,0:08:34.79,0:08:37.75,Default,Aki,0,0,0,,Đây là cửa hàng đồ chơi mà chú thường xuyên ghé qua đấy.
Dialogue: 0,0:08:37.75,0:08:39.04,Default,Oka,0,0,0,,Chú là khách quen ở đây thật đấy à?
Dialogue: 0,0:08:39.04,0:08:40.13,Default,Aki,0,0,0,,Chào anh bạn già!
Dialogue: 0,0:08:55.39,0:08:57.69,Default,Man,0,0,0,,Đứng yên coi nào!
Dialogue: 0,0:09:01.40,0:09:05.15,Default,Man,0,0,0,,Ồ, phản xạ của thằng nhóc chú mày dắt theo hơi chậm đấy.
Dialogue: 0,0:09:05.15,0:09:07.95,Default,Aki,0,0,0,,Lính mới mà, nương tay cho nó chút đi.
Dialogue: 0,0:09:07.95,0:09:09.95,Default,Oka,0,0,0,,Cái trò này mà cũng có cả dân chuyên nghiệp nữa sao trời?!
Dialogue: 0,0:09:09.95,0:09:12.95,Default,Aki,0,0,0,,Hôm nay tính là hòa nhé.
Dialogue: 0,0:09:12.95,0:09:18.92,Default,Aki,0,0,0,,Vậy là tỉ số của chú hiện tại là 123 thắng,\N171 thua và 32 hòa.
Dialogue: 0,0:09:19.29,0:09:21.46,Default,Oka,0,0,0,,Cái này mà là trò giải trí của người lớn của chú đấy hả?
Dialogue: 0,0:09:21.46,0:09:23.21,Default,Aki,0,0,0,,Màn kịch chính bây giờ mới bắt đầu đây.
Dialogue: 0,0:09:23.21,0:09:25.67,Default,Aki,0,0,0,,Này, hàng chuẩn bị xong chưa?
Dialogue: 0,0:09:26.17,0:09:28.18,Default,Man,0,0,0,,Xong xuôi hết rồi, chuẩn không cần chỉnh.
Dialogue: 0,0:09:29.09,0:09:29.93,Default,Aki,0,0,0,,Mở ra đi.
Dialogue: 0,0:09:31.81,0:09:33.22,Default,Oka,0,0,0,,Con gì thế này?
Dialogue: 0,0:09:33.22,0:09:35.85,Default,Man,0,0,0,,Kỳ đà Bengal khổng lồ, thưa ngài kỳ đà.
Dialogue: 0,0:09:35.85,0:09:37.39,Default,Oka,0,0,0,,Đặt tên theo nghĩa đen luôn à...
Dialogue: 0,0:09:37.39,0:09:40.65,Default,Aki,0,0,0,,Chúng ta sẽ thả con này vào lưng áo Sanae để dọa cô ấy một mẻ!
Dialogue: 0,0:09:41.98,0:09:44.69,Default,Aki,0,0,0,,Mới nghĩ đến thôi mà con tim chú đã rộn ràng nhảy múa rồi.
Dialogue: 0,0:09:44.69,0:09:45.94,Default,Oka,0,0,0,,Thôi xin chú tha cho cháu.
Dialogue: 0,0:09:45.94,0:09:49.16,Default,Oka,0,0,0,,Chú không thấy tội nghiệp cho Sanae-san sao? Dừng lại đi chú ơi.
Dialogue: 0,0:09:49.16,0:09:54.79,Default,Aki,0,0,0,,Đừng lo. Đây là chút kích thích để giữ lửa cho tình cảm vợ chồng luôn tươi mới đấy.
Dialogue: 0,0:09:54.79,0:09:56.50,Default,Aki,0,0,0,,Mày cũng nên ghi nhớ bài học này đi là vừa.
Dialogue: 0,0:09:56.50,0:09:58.33,Default,Oka,0,0,0,,Chuyện này mà cũng có tác dụng kiểu đó thật hả trời?
Dialogue: 0,0:09:58.67,0:10:01.04,Default,San,0,0,0,,Lâu rồi mới gặp lại, Tomoya-san.
Dialogue: 0,0:10:01.04,0:10:02.67,Default,Oka,0,0,0,,Vâng, cháu chào cô ạ.
Dialogue: 0,0:10:03.46,0:10:07.01,Default,Aki,0,0,0,,Nhân tiện hỏi chút, Sanae này,\Nloài động vật em ghét nhất trên đời là con gì ấy nhỉ?
Dialogue: 0,0:10:07.01,0:10:09.47,Default,San,0,0,0,,Là con kỳ đà Bengal khổng lồ ạ.
Dialogue: 0,0:10:09.47,0:10:10.09,Default,Oka,0,0,0,,Ghét cụ thể đến thế cơ à?!
Dialogue: 0,0:10:10.09,0:10:12.05,Default,Aki,0,0,0,,Chuẩn bài chưa nào?
Dialogue: 0,0:10:12.47,0:10:15.22,Default,Aki,0,0,0,,Nhìn kìa! Có một con kỳ đà Bengal khổng lồ kìa!
Dialogue: 0,0:10:15.22,0:10:16.68,Default,San,0,0,0,,Đ-Đâu cơ ạ?!
Dialogue: 0,0:10:16.68,0:10:17.98,Default,Aki,0,0,0,,Kìa, nó chạy qua đằng kia rồi!
Dialogue: 0,0:10:19.89,0:10:21.23,Default,Oka,0,0,0,,Cháu xin lỗi, Sanae-san!
Dialogue: 0,0:10:22.61,0:10:26.23,Default,Oka,0,0,0,,Thôi chết rồi! Nó chui tọt vào lưng áo cô rồi!
Dialogue: 0,0:10:27.65,0:10:29.95,Default,San,0,0,0,,Á á á khônggggg!!!
Dialogue: 0,0:10:29.95,0:10:32.78,Default,San,0,0,0,,Ai đó mau lấy nó ra giùm tôi với ạ!
Dialogue: 0,0:10:32.16,0:10:35.20,Default-alt,Aki,0,0,0,,Chết dở rồi. Quả này hơi bị kích thích quá đà rồi.
Dialogue: 0,0:10:35.20,0:10:36.79,Default,Oka,0,0,0,,Chú tính xử lý vụ này sao đây hả?!
Dialogue: 0,0:10:36.79,0:10:39.71,Default,Aki,0,0,0,,Sanae ơi! Anh không có làm đâu đấy nhé!
Dialogue: 0,0:10:39.71,0:10:40.58,Default,Oka,0,0,0,,Cái ông chú chơi bẩn thỉu này!
Dialogue: 0,0:10:41.17,0:10:43.96,Default,Iso,0,0,0,,Chà chà, hôm nay họ chạy còn nhanh hơn mọi khi nữa kìa.
Dialogue: 0,0:10:43.96,0:10:46.42,Default,Oka,0,0,0,,Isogai-san. Cháu xin lỗi vì họ làm ồn ào quá ạ.
Dialogue: 0,0:10:46.42,0:10:52.55,Default,Iso,0,0,0,,Không sao đâu cháu. Mọi người quanh đây ai cũng bảo\Nngày nào cũng vui như mở hội là nhờ có hai vợ chồng họ đấy.
Dialogue: 0,0:10:53.14,0:10:54.55,Default,Oka,0,0,0,,Thật vậy sao ạ?
Dialogue: 0,0:10:54.55,0:10:56.97,Default,San,0,0,0,,Làm ơn lấy nó ra giùm tôi với ạ!
Dialogue: 0,0:10:55.76,0:10:57.47,Default-alt,Aki,0,0,0,,Đợi anh đã, Sanae ơi!
Dialogue: 0,0:10:58.93,0:11:00.60,Default,Oka,0,0,0,,Xin lỗi bác, cháu phải chạy theo đây ạ.
Dialogue: 0,0:11:00.60,0:11:04.23,Default,Iso,0,0,0,,Ừ đi đi. Yên tâm, bác sẽ trông tiệm bánh giúp cho.
Dialogue: 0,0:11:04.23,0:11:05.23,Default,Oka,0,0,0,,Phiền bác quá, cháu cảm ơn bác nhiều ạ.
Dialogue: 0,0:11:07.98,0:11:09.99,Default,Nag,0,0,0,,Hôm nay em bất ngờ ghê luôn đó.
Dialogue: 0,0:11:09.99,0:11:14.12,Default,Nag,0,0,0,,Lúc về đến nhà thì thấy cả bố, mẹ lẫn cậu đều đang thi nhau chạy thục mạng.
Dialogue: 0,0:11:14.12,0:11:16.49,Default,Oka,0,0,0,,Chắc giờ Sanae-san ghét cay ghét đắng tớ rồi...
Dialogue: 0,0:11:16.49,0:11:18.66,Default,Nag,0,0,0,,Chắc chắn là không có chuyện đó đâu ạ.
Dialogue: 0,0:11:18.66,0:11:22.79,Default,Nag,0,0,0,,Cậu hòa hợp rất tốt với cả bố lẫn mẹ em mà.
Dialogue: 0,0:11:22.79,0:11:26.50,Default,Oka,0,0,0,,Nhưng chính tớ là người đã thả con kỳ đà Bengal vào lưng áo cô ấy đấy.
Dialogue: 0,0:11:27.13,0:11:31.93,Default,Nag,0,0,0,,Từ trước đến nay chưa từng có ai cùng chạy đuổi nhau với bố mẹ như thế cả.
Dialogue: 0,0:11:31.93,0:11:36.26,Default,Nag,0,0,0,,Nên em nghĩ hôm nay cậu đã thực sự gắn kết thân thiết với bố mẹ rồi đấy.
Dialogue: 0,0:11:36.26,0:11:38.01,Default,Oka,0,0,0,,Cậu nghĩ thế thật sao?
Dialogue: 0,0:11:38.01,0:11:44.94,Default,Nag,0,0,0,,À nhân tiện, Tomoya-kun này. Cậu có biết hai tuần nữa, vào Chủ nhật sẽ có chuyện gì không?
Dialogue: 0,0:11:44.94,0:11:46.31,Default,Oka,0,0,0,,Hai tuần nữa vào Chủ nhật sao?
Dialogue: 0,0:11:46.31,0:11:49.28,Default,Oka,0,0,0,,Sinh nhật cậu tận tháng mười hai cơ mà nhỉ...
Dialogue: 0,0:11:49.69,0:11:51.40,Default,Nag,0,0,0,,Là Lễ Hội Thành Lập Trường đấy ạ.
Dialogue: 0,0:11:51.86,0:11:57.99,Default,Nag,0,0,0,,Dù Câu lạc bộ Kịch không còn nữa, nhưng em vẫn muốn được vui chơi thật nhiều.
Dialogue: 0,0:11:57.99,0:11:59.99,Default,Nag,0,0,0,,Nên nếu cậu không phiền thì...
Dialogue: 0,0:12:02.79,0:12:05.04,Default,Oka,0,0,0,,Được chứ. Chúng mình cùng đi nhé.
Dialogue: 0,0:12:06.21,0:12:06.92,Default,Nag,0,0,0,,Vâng ạ!
Dialogue: 0,0:12:17.64,0:12:19.26,Default,Man,0,0,0,,Hôm nay đúng là một ngày vất vả thật.
Dialogue: 0,0:12:19.26,0:12:23.35,Default,Man,0,0,0,,Nhưng có thêm tiền làm thêm giờ nên tôi khoái lắm.
Dialogue: 0,0:12:23.35,0:12:24.60,Default,Man,0,0,0,,Chào anh, vất vả rồi.
Dialogue: 0,0:12:25.81,0:12:26.98,Default,Yos,0,0,0,,Đang sắp xếp hóa đơn chứng từ đấy à?
Dialogue: 0,0:12:27.44,0:12:29.73,Default,Man,0,0,0,,Tôi đang nhờ cậu nhóc phụ một tay đây.
Dialogue: 0,0:12:29.73,0:12:31.99,Default,Man,0,0,0,,Một mình tôi thì mãi chẳng tiến triển được bao nhiêu.
Dialogue: 0,0:12:35.41,0:12:37.07,Default,Yos,0,0,0,,Khá khen đấy.
Dialogue: 0,0:12:37.07,0:12:39.70,Default,Oka,0,0,0,,Cháu chỉ sắp xếp lại theo thứ tự ngày tháng thôi ạ.
Dialogue: 0,0:12:39.70,0:12:41.24,Default,Yos,0,0,0,,Dù là thế.
Dialogue: 0,0:12:41.24,0:12:42.83,Default,Yos,0,0,0,,Phải tôi thì tôi phát điên lên sau năm phút rồi.
Dialogue: 0,0:12:42.83,0:12:45.42,Default,Man,0,0,0,,Cần tôi giúp một tay với đống này không?
Dialogue: 0,0:12:45.42,0:12:47.58,Default,Oka,0,0,0,,Không, đống đó là chỗ đã làm xong rồi đấy.
Dialogue: 0,0:12:47.58,0:12:51.67,Default,Man,0,0,0,,Thôi khỏi đi. Chạm vào lại làm rối tung lên bây giờ.
Dialogue: 0,0:12:51.67,0:12:56.55,Default,Man,0,0,0,,Này nhé, trước khi bị sa thải ở chỗ làm cũ thì tôi từng làm kế toán hẳn hoi đấy nhé.
Dialogue: 0,0:12:56.55,0:12:59.76,Default,Man,0,0,0,,Đừng có cướp việc của lính mới chứ, ông anh.
Dialogue: 0,0:13:00.93,0:13:04.27,Default,Oka,0,0,0,,Cháu sắp xong việc rồi, các chú cứ về trước đi ạ.
Dialogue: 0,0:13:05.85,0:13:08.02,Default,Yos,0,0,0,,Cậu đã nói thế thì thôi. Hẹn gặp lại nhé.
Dialogue: 0,0:13:08.02,0:13:09.73,Default,Oka,0,0,0,,Vâng ạ. Mai gặp lại anh.
Dialogue: 0,0:13:09.73,0:13:10.57,Default,Man,0,0,0,,Hẹn mai gặp lại nhé.
Dialogue: 0,0:13:10.57,0:13:11.32,Default,Man,0,0,0,,Gặp lại sau.
Dialogue: 0,0:13:11.32,0:13:12.61,Default,Man,0,0,0,,Chào Giám đốc nhé.
Dialogue: 0,0:13:12.61,0:13:14.11,Default,Man,0,0,0,,Gặp lại sau nhé.
Dialogue: 0,0:13:16.24,0:13:18.57,Default,Man,0,0,0,,Cậu đến làm việc thực sự là một sự trợ giúp lớn cho bọn chú đấy.
Dialogue: 0,0:13:19.12,0:13:23.24,Default,Man,0,0,0,,Chỗ chú đang thiếu nhân lực nghiêm trọng,\Ntrong khi sắp tới lại nhận được một công trình lớn.
Dialogue: 0,0:13:23.24,0:13:25.54,Default,Oka,0,0,0,,Cháu vẫn chưa làm được gì nhiều đâu ạ.
Dialogue: 0,0:13:25.54,0:13:27.21,Default,Man,0,0,0,,Không phải thế đâu.
Dialogue: 0,0:13:27.21,0:13:29.92,Default,Man,0,0,0,,Chú nghe nói cậu ấy đã để cháu tự mình làm một số việc độc lập rồi.
Dialogue: 0,0:13:30.54,0:13:34.09,Default,Man,0,0,0,,Thời gian tới chắc cháu sẽ phải đi làm vào cuối tuần nhiều hơn,\Nnhưng hãy cố gắng lên nhé.
Dialogue: 0,0:13:36.34,0:13:40.51,Default,Nag,0,0,0,,Lễ hội trường~ Lễ hội trường~ Cuối tuần tới là đến~
Dialogue: 0,0:13:40.51,0:13:42.85,Default,Nag,0,0,0,,~Lễ Hội Thành Lập Trường rồi~
Dialogue: 0,0:13:45.77,0:13:46.56,Default,Oka,0,0,0,,Nagisa này.
Dialogue: 0,0:13:46.56,0:13:48.19,Default,Nag,0,0,0,,Vâng, có chuyện gì thế cậu?
Dialogue: 0,0:13:50.02,0:13:52.44,Default,Oka,0,0,0,,Có vẻ như sắp tới công việc của tớ sẽ bận rộn lắm.
Dialogue: 0,0:13:55.07,0:13:58.70,Default,Oka,0,0,0,,Có lẽ tớ không thể cùng đi Lễ Hội Trường với cậu được rồi.
Dialogue: 0,0:14:01.20,0:14:04.95,Default,Oka,0,0,0,,Tớ xin lỗi nhé, dạo này hai đứa mình vốn đã ít thời gian bên nhau rồi...
Dialogue: 0,0:14:07.46,0:14:09.46,Default,Nag,0,0,0,,Xin cậu đừng bận lòng mà.
Dialogue: 0,0:14:09.46,0:14:12.71,Default,Nag,0,0,0,,Công việc bận rộn như thế là điều rất đáng mừng mà cậu.
Dialogue: 0,0:14:13.25,0:14:14.34,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:14:14.71,0:14:20.30,Default,Nag,0,0,0,,Tuy có chút tiếc nuối thật, nhưng em rất vui vì cậu đang nỗ lực làm việc chăm chỉ như vậy.
Dialogue: 0,0:14:21.18,0:14:21.97,Default,Oka,0,0,0,,Tớ xin lỗi cậu nhiều nhé.
Dialogue: 0,0:14:28.77,0:14:30.35,Default,Yos,0,0,0,,Đưa kìm cắt cho tôi.
Dialogue: 0,0:14:30.35,0:14:31.27,Default,Oka,0,0,0,,Có ngay ạ.
Dialogue: 0,0:14:33.90,0:14:37.90,Default,Yos,0,0,0,,Lấy cho tôi thêm 210 mm dây cáp VVF hiệu Sanshin nữa.
Dialogue: 0,0:14:38.19,0:14:39.82,Default,Yos,0,0,0,,Tuốt sẵn hai đầu dây đi nhé.
Dialogue: 0,0:14:39.82,0:14:41.45,Default,Oka,0,0,0,,Anh muốn tuốt bao nhiêu ạ?
Dialogue: 0,0:14:41.82,0:14:44.16,Default,Oka,0,0,0,,Nếu dây dày thì em tuốt 2cm nhé.
Dialogue: 0,0:14:44.16,0:14:46.58,Default,Yos,0,0,0,,Tuốt 4cm đi, như thế sẽ đa dụng hơn.
Dialogue: 0,0:14:46.58,0:14:47.66,Default,Yos,0,0,0,,Ghi nhớ điều đó vào.
Dialogue: 0,0:14:48.00,0:14:49.21,Default,Oka,0,0,0,,A, đúng thật ạ.
Dialogue: 0,0:14:49.21,0:14:50.04,Default,Oka,0,0,0,,Rõ rồi ạ.
Dialogue: 0,0:14:50.71,0:14:53.21,Default,Yos,0,0,0,,Chuẩn bị sẵn ống bọc 38 đi.
Dialogue: 0,0:14:53.21,0:14:54.79,Default,Oka,0,0,0,,Ống bảo vệ chịu nhiệt đúng không anh?
Dialogue: 0,0:14:54.79,0:14:56.80,Default,Oka,0,0,0,,Dùng loại tiêu chuẩn hay loại gia cường ạ?
Dialogue: 0,0:14:56.80,0:14:58.67,Default,Yos,0,0,0,,Cứ dùng loại gia cường cho chắc ăn.
Dialogue: 0,0:14:59.59,0:15:00.97,Default,Yos,0,0,0,,Chúng ta không muốn về sau xảy ra hỏa hoạn đâu.
Dialogue: 0,0:15:06.14,0:15:07.52,Default,Yos,0,0,0,,Hoàn thiện nốt chỗ này đi.
Dialogue: 0,0:15:08.06,0:15:09.77,Default,Yos,0,0,0,,Tôi sang kiểm tra chỗ tiếp theo đây.
Dialogue: 0,0:15:09.77,0:15:10.77,Default,Oka,0,0,0,,Vâng ạ.
Dialogue: 0,0:15:11.98,0:15:13.31,Default,Yos,0,0,0,,Đừng vội vàng, cứ làm thật cẩn thận và gọn gàng vào.
Dialogue: 0,0:15:13.73,0:15:15.11,Default,Yos,0,0,0,,Làm xong bên kia tôi sẽ quay lại.
Dialogue: 0,0:15:15.40,0:15:16.11,Default,Oka,0,0,0,,Vâng ạ.
Dialogue: 0,0:15:30.04,0:15:34.54,Default,Oka,0,0,0,,Dạ vâng. Vậy nếu được thì ngày mai cho em xin nghỉ một ngày ạ.
Dialogue: 0,0:15:34.92,0:15:39.05,Default,Yos,0,0,0,,Tôi hiểu rồi. Cứ yên tâm đi, ngày mai chúng ta không cần phải hủy ngày nghỉ đâu.
Dialogue: 0,0:15:39.05,0:15:40.05,Default,Oka,0,0,0,,Thật thế sao anh?!
Dialogue: 0,0:15:40.67,0:15:42.43,Default,Yos,0,0,0,,Vai phải của cậu dạo này thế nào rồi?
Dialogue: 0,0:15:44.47,0:15:46.01,Default,Yos,0,0,0,,Cậu không nhấc cánh tay lên được đúng không?
Dialogue: 0,0:15:46.55,0:15:47.81,Default,Yos,0,0,0,,Tôi chỉ cần nhìn qua là biết ngay.
Dialogue: 0,0:15:49.27,0:15:50.81,Default,Oka,0,0,0,,Hóa ra... anh đã nhận ra rồi sao.
Dialogue: 0,0:15:51.23,0:15:53.19,Default,Oka,0,0,0,,Vậy sao anh không nói gì với em cả?
Dialogue: 0,0:15:53.77,0:15:56.02,Default,Yos,0,0,0,,Tôi nói ra thì giải quyết được gì chứ?
Dialogue: 0,0:15:56.02,0:15:58.15,Default,Yos,0,0,0,,Cậu đâu có làm sai quy trình nào đâu.
Dialogue: 0,0:15:58.82,0:16:01.28,Default,Yos,0,0,0,,Cậu đã cố gắng hết sức để khắc phục khiếm khuyết của bản thân.
Dialogue: 0,0:16:01.69,0:16:02.45,Default,Yos,0,0,0,,Đã vô cùng nỗ lực để vượt qua nó.
Dialogue: 0,0:16:04.28,0:16:07.58,Default,Yos,0,0,0,,Nhưng sắp tới sẽ có rất nhiều công việc nặng nhọc và khó khăn.
Dialogue: 0,0:16:07.91,0:16:10.04,Default,Yos,0,0,0,,Nếu cảm thấy quá sức, thì đừng có cố quá.
Dialogue: 0,0:16:10.04,0:16:11.66,Default,Yos,0,0,0,,Những lúc như thế, tôi sẽ gánh vác thay cho cậu.
Dialogue: 0,0:16:12.25,0:16:15.50,Default,Oka,0,0,0,,Làm như vậy có ổn không anh? Như thế chẳng phải chỉ gây phiền toái cho anh thôi sao?
Dialogue: 0,0:16:15.88,0:16:18.00,Default,Yos,0,0,0,,Những việc mình không làm được thì sẽ có người khác gánh vác đỡ.
Dialogue: 0,0:16:18.00,0:16:19.67,Default,Yos,0,0,0,,Bản chất của công việc chính là như thế đấy.
Dialogue: 0,0:16:20.13,0:16:22.92,Default,Yos,0,0,0,,Sau này tôi cũng sẽ nhờ cậu làm những việc mà tôi không làm được.
Dialogue: 0,0:16:23.38,0:16:24.59,Default,Yos,0,0,0,,Chuyện đời là như thế đấy.
Dialogue: 0,0:16:26.59,0:16:31.93,Default,Yos,0,0,0,,Điều cốt lõi là, tuyệt đối đừng để xảy ra sai sót nào khiến cô gái của cậu phải lo lắng.
Dialogue: 0,0:16:36.85,0:16:38.65,Default,Oka,0,0,0,,Em cảm ơn anh rất nhiều ạ.
Dialogue: 0,0:16:45.49,0:16:49.28,Default,Man,0,0,0,,Trời ạ, mọi người về hết mất rồi.
Dialogue: 0,0:16:49.28,0:16:50.54,Default,Oka,0,0,0,,Có chuyện gì thế chú?
Dialogue: 0,0:16:50.91,0:16:54.96,Default,Man,0,0,0,,Có một công việc bị sót lại trong xấp hồ sơ do nhầm lẫn.
Dialogue: 0,0:16:54.96,0:16:55.96,Default,Man,0,0,0,,Là việc này đây.
Dialogue: 0,0:16:55.96,0:16:57.50,Default,Man,0,0,0,,Cháu xem có làm được không?
Dialogue: 0,0:16:59.46,0:17:00.88,Default,Oka,0,0,0,,Nếu là việc này thì cháu làm được ạ.
Dialogue: 0,0:17:00.88,0:17:02.59,Default,Oka,0,0,0,,Cũng giống như những việc cháu vẫn thường làm thôi ạ.
Dialogue: 0,0:17:02.59,0:17:07.14,Default,Man,0,0,0,,Thật thế sao? Vậy xin lỗi cháu nhé, nhưng cháu đi làm luôn bây giờ được không?
Dialogue: 0,0:17:07.14,0:17:08.68,Default,Oka,0,0,0,,Một mình cháu đi sao ạ?
Dialogue: 0,0:17:08.68,0:17:11.39,Default,Man,0,0,0,,Chú còn việc khác phải xử lý nên không đi cùng được.
Dialogue: 0,0:17:11.39,0:17:13.27,Default,Man,0,0,0,,Chú sẽ chở cháu đến tận nơi, làm phiền cháu nhé.
Dialogue: 0,0:17:13.27,0:17:14.98,Default,Man,0,0,0,,Xong việc chú cũng sẽ đến đón cháu về.
Dialogue: 0,0:17:15.77,0:17:16.60,Default,Oka,0,0,0,,Vâng ạ.
Dialogue: 0,0:17:31.83,0:17:32.91,Default,Oka,0,0,0,,Yoshino-san.
Dialogue: 0,0:17:32.91,0:17:36.87,Default,Yos,0,0,0,,Giám đốc gọi điện báo nên tôi vội chạy ngay về văn phòng.
Dialogue: 0,0:17:37.50,0:17:39.17,Default,Yos,0,0,0,,Cậu tự mình xoay sở một mình được hết chứ?
Dialogue: 0,0:17:40.13,0:17:41.84,Default,Oka,0,0,0,,Dạ vâng, em nghĩ là ổn ạ.
Dialogue: 0,0:17:44.13,0:17:45.97,Default,Yos,0,0,0,,Cậu đã kiểm tra kỹ các mối nối chưa?
Dialogue: 0,0:17:45.97,0:17:49.05,Default,Oka,0,0,0,,Dạ rồi ạ. Từng mạch riêng biệt lẫn toàn bộ hệ thống sau cùng.
Dialogue: 0,0:17:49.05,0:17:50.85,Default,Yos,0,0,0,,Đã bọc cách điện cẩn thận chưa?
Dialogue: 0,0:17:50.85,0:17:53.43,Default,Oka,0,0,0,,Dạ rồi. Em cũng đã đo đạc kiểm tra lại hết rồi ạ.
Dialogue: 0,0:17:59.19,0:18:00.06,Default,Yos,0,0,0,,Vất vả cho cậu rồi.
Dialogue: 0,0:18:00.06,0:18:01.61,Default,Yos,0,0,0,,Muộn lắm rồi, chúng ta về thôi.
Dialogue: 0,0:18:02.65,0:18:03.40,Default,Oka,0,0,0,,Vâng ạ!
Dialogue: 0,0:18:07.70,0:18:10.36,Default,Nag,0,0,0,,Em sẽ ở trường đợi cậu nhé.
Dialogue: 0,0:18:10.70,0:18:13.62,Default,Oka,0,0,0,,Ừ. Lát nữa chúng mình gặp nhau ở cổng trường nhé.
Dialogue: 0,0:18:14.20,0:18:14.87,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:25.09,0:18:25.88,Default,Oka,0,0,0,,Cháu chào chú.
Dialogue: 0,0:18:26.46,0:18:30.26,Default,Man,0,0,0,,Okazaki-kun. Cháu có biết hôm qua ở công trình đã xảy ra chuyện gì không?
Dialogue: 0,0:18:32.47,0:18:38.35,Default,Man,0,0,0,,Yoshino vừa gọi điện báo phát hiện ra sai sót nên đã vội chạy đi sửa chữa rồi.
Dialogue: 0,0:18:39.02,0:18:41.73,Default,Man,0,0,0,,Chú có gặng hỏi thế nào cậu ấy cũng không chịu nói rõ.
Dialogue: 0,0:18:41.73,0:18:44.48,Default,Man,0,0,0,,Nên chú nghĩ có thể cháu biết điều gì đó.
Dialogue: 0,0:18:47.40,0:18:48.44,Default,Oka,0,0,0,,Yoshino-san!
Dialogue: 0,0:18:49.36,0:18:50.99,Default,Yos,0,0,0,,Okazaki! Sao cậu lại đến đây?!
Dialogue: 0,0:18:51.57,0:18:52.74,Default,Oka,0,0,0,,Anh hỏi 'sao' là sao chứ?!
Dialogue: 0,0:18:53.53,0:18:54.70,Default,Oka,0,0,0,,Em xin lỗi anh nhiều lắm!
Dialogue: 0,0:18:56.87,0:18:58.91,Default,Oka,0,0,0,,Nếu em làm việc cẩn thận và đúng đắn hơn...
Dialogue: 0,0:18:58.91,0:19:00.00,Default,Yos,0,0,0,,Đó không phải là lỗi của cậu.
Dialogue: 0,0:19:00.00,0:19:00.75,Default,Oka,0,0,0,,Chính là lỗi của em mà!
Dialogue: 0,0:19:01.25,0:19:04.13,Default,Yos,0,0,0,,Tôi đã nhận ra sai sót sau khi cậu về nhà.
Dialogue: 0,0:19:04.46,0:19:07.63,Default,Yos,0,0,0,,Nhưng lúc đó trời đã tối mịt rồi,\Nnên tôi mới dời công việc sang sáng hôm nay.
Dialogue: 0,0:19:07.63,0:19:10.63,Default,Yos,0,0,0,,Lỗi là ở tôi vì đã không nhận ra sai sót của cậu ngay tại công trình.
Dialogue: 0,0:19:12.14,0:19:13.97,Default,Yos,0,0,0,,Cậu có hẹn ước với Nagisa-san cơ mà, đúng không?
Dialogue: 0,0:19:13.97,0:19:15.18,Default,Yos,0,0,0,,Mau đi đi!
Dialogue: 0,0:19:15.18,0:19:16.76,Default,Oka,0,0,0,,Xin anh hãy để em chịu trách nhiệm cùng anh!
Dialogue: 0,0:19:16.76,0:19:17.56,Default,Yos,0,0,0,,Không được!
Dialogue: 0,0:19:17.56,0:19:18.64,Default,Oka,0,0,0,,Em xin anh đấy!
Dialogue: 0,0:19:25.11,0:19:28.03,Default,Yos,0,0,0,,Mang lên đây 6m dây cáp hạ áp số 25 đi.
Dialogue: 0,0:19:29.03,0:19:29.53,Default,Oka,0,0,0,,Dạ?
Dialogue: 0,0:19:29.94,0:19:31.28,Default,Yos,0,0,0,,Còn không mau lên!
Dialogue: 0,0:19:31.70,0:19:32.32,Default,Oka,0,0,0,,Vâng ạ!
Dialogue: 0,0:19:48.13,0:19:49.71,Note,,0,0,0,,Sign: Founders Festival
Dialogue: 0,0:19:54.30,0:19:55.51,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:19:57.10,0:19:57.97,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:19:57.97,0:20:00.56,Default,Nag,0,0,0,,Hóa ra là cậu bận đi làm việc.
Dialogue: 0,0:20:00.56,0:20:02.48,Default,Nag,0,0,0,,Em cũng đã linh cảm thấy là như thế rồi.
Dialogue: 0,0:20:06.81,0:20:09.23,Default,Nag,0,0,0,,Người cậu ướt đẫm mồ hôi rồi kìa.
Dialogue: 0,0:20:12.24,0:20:13.15,Default,Tom,0,0,0,,Tớ xin lỗi cậu nhé.
Dialogue: 0,0:20:13.86,0:20:16.99,Default,Nag,0,0,0,,Cậu đâu có làm gì có lỗi mà phải xin lỗi chứ.
Dialogue: 0,0:20:18.37,0:20:20.75,Default,Nag,0,0,0,,Cậu có muốn ăn cùng em không?
Dialogue: 0,0:20:27.79,0:20:29.38,Default,Nag,0,0,0,,Vừa đi chúng mình vừa ăn nhé.
Dialogue: 0,0:20:32.22,0:20:33.17,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:20:33.17,0:20:34.43,Default,Oka,0,0,0,,Ừ... ừm.
Dialogue: 0,0:20:47.10,0:20:48.56,Default,Oka,0,0,0,,Chào buổi sáng mọi người ạ.
Dialogue: 0,0:20:48.56,0:20:50.57,Default,Man,0,0,0,,Cậu Okazaki.
Dialogue: 0,0:20:50.57,0:20:52.74,Default,Man,0,0,0,,Nghe nói hôm qua cậu làm một vụ lớn lắm đấy nhé.
Dialogue: 0,0:20:53.32,0:20:54.20,Default,Oka,0,0,0,,Vâng ạ.
Dialogue: 0,0:20:54.20,0:20:56.16,Default,Man,0,0,0,,Bọn chú nghe Yoshino-san kể lại hết rồi.
Dialogue: 0,0:20:56.16,0:20:59.28,Default,Man,0,0,0,,Cậu đã bỏ cả buổi hẹn hò với người yêu\Nđể chạy đến làm việc cho công ty đúng không?
Dialogue: 0,0:20:59.28,0:21:01.99,Default,Man,0,0,0,,Phải chi cậu nói sớm một tiếng thì tôi đã đi thay cho cậu rồi.
Dialogue: 0,0:21:01.99,0:21:04.29,Default,Man,0,0,0,,Làm phiền cậu quá rồi.
Dialogue: 0,0:21:04.29,0:21:06.96,Default,Man,0,0,0,,Chú nhất định sẽ tính tiền làm thêm giờ cuối tuần đầy đủ cho cháu.
Dialogue: 0,0:21:06.96,0:21:11.09,Default,Oka,0,0,0,,Dạ, cháu đến đây cứ ngỡ là sẽ bị mắng té tát một trận cơ ạ.
Dialogue: 0,0:21:11.09,0:21:12.59,Default,Yos,0,0,0,,Ai mà chẳng có lúc mắc sai lầm.
Dialogue: 0,0:21:12.96,0:21:15.22,Default,Yos,0,0,0,,Điều quan trọng là phải biết cách bù đắp cho sai lầm đó.
Dialogue: 0,0:21:16.09,0:21:19.85,Default,Yos,0,0,0,,Cậu đã cố gắng hết sức và chúng ta không gây ra rắc rối nào cho khách hàng cả.
Dialogue: 0,0:21:20.72,0:21:24.10,Default,Yos,0,0,0,,Chỉ cần không lặp lại sai lầm tương tự là được.
Dialogue: 0,0:21:25.52,0:21:32.11,Default,Yos,0,0,0,,Nếu cảm thấy có lỗi, thì sau này hãy bao dung và gánh vác cho những sai lầm của đàn em cấp dưới của cậu.
Dialogue: 0,0:21:32.57,0:21:34.49,Default,Yos,0,0,0,,{\i1}Đó{\i0\fscx30}{\r} mới chính là công việc của cậu.
Dialogue: 0,0:21:35.28,0:21:36.03,Default,Yos,0,0,0,,Và nữa!
Dialogue: 0,0:21:36.61,0:21:37.49,Default,Yos,0,0,0,,Tình yêu!
Dialogue: 0,0:21:40.49,0:21:41.66,Default,Oka,0,0,0,,Em hiểu rồi ạ!
Dialogue: 0,0:21:41.66,0:21:43.12,Default,Oka,0,0,0,,Em nhất định sẽ khắc cốt ghi tâm!
Dialogue: 0,0:21:43.12,0:21:46.62,Default,Man,0,0,0,,Tôi nghĩ cái câu cuối cùng đó hơi thừa thãi thì phải.
Dialogue: 0,0:21:46.62,0:21:48.71,Default,Man,0,0,0,,Được rồi, nói chuyện thế là đủ rồi.
Dialogue: 0,0:21:48.71,0:21:50.08,Default,Man,0,0,0,,Bắt tay vào làm việc thôi nào.
Dialogue: 0,0:21:50.08,0:21:51.84,Default,All,0,0,0,,Rõ rồi ạ!
Dialogue: 0,0:21:52.59,0:21:54.05,Default,Man,0,0,0,,A, Okazaki-kun.
Dialogue: 0,0:21:54.05,0:21:55.34,Default,Man,0,0,0,,Cuối cùng cũng xong xuôi rồi đấy.
Dialogue: 0,0:21:58.09,0:21:59.51,Default,Yos,0,0,0,,Mau lên nào, Okazaki.
Dialogue: 0,0:21:59.51,0:22:00.93,Default,Oka,0,0,0,,D-Dạ vâng!
Dialogue: 0,0:22:05.85,0:22:09.81,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad3\pos(1459.999969,840)\bord0.75\3c&H000000&\blur0.5}Còn tiếp
Dialogue: 0,0:22:18.74,0:22:26.25,ED Romaji,,0,0,0,,{\be1}{\kf24}mi{\kf32}tsu{\kf23}me{\kf23}te {\kf19}i{\kf137}ta {\kf29}na{\kf28}ga{\kf21}re{\kf69}ru {\kf60}ku{\kf61}mo {\kf230}wo
Dialogue: 0,0:22:18.74,0:22:26.25,ED English,,0,0,0,,{\be1}Tôi từng mải mê ngắm nhìn những đám mây trôi dạt.
Dialogue: 0,0:22:26.25,0:22:33.30,ED Romaji,,0,0,0,,{\be1\fad(0,250)}{\kf40}ka{\kf11}n{\kf24}ji{\kf21}te {\kf30}i{\kf135}ta {\kf28}ka{\kf23}wa{\kf19}ru {\kf68}so{\kf63}ra {\kf37}no {\kf45}i{\kf26}ro {\kf130}wo
Dialogue: 0,0:22:26.25,0:22:33.30,ED English,,0,0,0,,{\be1\fad(0,250)}Cảm nhận từng sắc màu đổi thay nơi bầu trời cao rộng.
Dialogue: 0,0:22:33.80,0:22:41.35,ED Romaji,,0,0,0,,{\be1}{\kf25}ta{\kf31}chi {\kf20}to{\kf27}ma{\kf21}t{\kf142}ta {\kf22}bo{\kf23}ku{\kf26}ra {\kf66}wa {\kf63}ki{\kf59}zu{\kf229}ku
Dialogue: 0,0:22:33.80,0:22:41.35,ED English,,0,0,0,,{\be1}Khi chúng tôi dừng bước chân,
Dialogue: 0,0:22:41.35,0:22:48.44,ED Romaji,,0,0,0,,{\be1}{\kf24}u{\kf32}tsu{\kf25}ro{\kf21}i {\kf20}yu{\kf143}ku {\kf24}se{\kf25}ka{\kf23}i {\kf65}ga {\kf73}tsu{\kf26}mu{\kf49}gu {\kf18}u{\kf32}ta {\kf113}ni
Dialogue: 0,0:22:41.35,0:22:48.44,ED English,,0,0,0,,{\be1}chợt lắng nghe khúc ca thế gian ngân nga giữa muôn màu phai dấu.
Dialogue: 0,0:22:48.44,0:22:55.74,ED Romaji,,0,0,0,,{\be1}{\kf91}no{\kf35}ba{\kf38}shi{\kf139}ta {\kf48}yu{\kf25}bi {\kf44}de {\kf29}ta{\kf90}gu{\kf24}ru {\kf44}yo{\kf24}u {\kf98}ni
Dialogue: 0,0:22:48.44,0:22:55.74,ED English,,0,0,0,,{\be1}Tựa như những ngón tay vươn ra tìm kiếm lối đi,
Dialogue: 0,0:22:55.74,0:23:04.37,ED Romaji,,0,0,0,,{\be1}{\kf26}ta{\kf92}da {\kf34}hi{\kf38}to{\kf87}tsu {\kf55}ka{\kf44}wa{\kf23}ra{\kf48}na{\kf29}i {\kf44}mo{\kf47}no {\kf22}sa{\kf95}ga{\kf177}su
Dialogue: 0,0:22:55.74,0:23:04.37,ED English,,0,0,0,,{\be1}tôi mải miết kiếm tìm một điều duy nhất chẳng hề đổi thay.
Dialogue: 0,0:23:04.41,0:23:11.96,ED Romaji,,0,0,0,,{\be1\fad(250,0)}{\kf59}ka{\kf41}za{\kf74}su {\kf72}te {\kf138}ni {\kf46}to{\kf45}mo{\kf75}shi{\kf73}bi {\kf136}wo
Dialogue: 0,0:23:04.41,0:23:11.96,ED English,,0,0,0,,{\be1\fad(250,0)}Hãy thắp lên ngọn đuốc nơi bàn tay em vươn tới.
Dialogue: 0,0:23:11.96,0:23:19.51,ED Romaji,,0,0,0,,{\be1}{\kf46}a{\kf52}su {\kf72}he {\kf24}to {\kf46}tsu{\kf25}zu{\kf108}ku {\kf44}chi{\kf33}i{\kf26}sa{\kf61}na {\kf78}shi{\kf71}ru{\kf73}be
Dialogue: 0,0:23:11.96,0:23:19.51,ED English,,0,0,0,,{\be1}Sẽ là chỉ dấu nhỏ nhoi dẫn lối tới ngày mai.
Dialogue: 0,0:23:19.51,0:23:27.06,ED Romaji,,0,0,0,,{\be1}{\kf44}i{\kf52}ma {\kf70}mo {\kf67}ma{\kf144}da {\kf45}ko{\kf46}da{\kf63}ma {\kf80}su{\kf140}ru
Dialogue: 0,0:23:19.51,0:23:27.06,ED English,,0,0,0,,{\be1}Lời hẹn ước người từng trao ngày hôm ấy...
Dialogue: 0,0:23:27.06,0:23:34.57,ED Romaji,,0,0,0,,{\be1}{\kf48}a{\kf46}no {\kf70}hi {\kf27}no {\kf44}ko{\kf26}to{\kf104}ba {\kf51}chi{\kf30}ka{\kf27}i {\kf93}ni {\kf71}ka{\kf113}e
Dialogue: 0,0:23:27.06,0:23:34.57,ED English,,0,0,0,,{\be1}...vẫn còn vang vọng nơi đây, xin khắc sâu thành lời thề son sắt.
Dialogue: 0,0:23:34.57,0:23:39.82,ED Romaji,,0,0,0,,{\be1}{\kf42}bo{\kf34}ku {\kf18}wa {\kf166}yu{\kf266}ku
Dialogue: 0,0:23:34.57,0:23:39.82,ED English,,0,0,0,,{\be1}Tôi sẽ vững bước tiến về phía trước.
Dialogue: 0,0:23:39.82,0:23:43.78,Signs,,0,0,0,,{\fs99.999996\fad(0,400)\4c&H000000&\shad3\pos(960,470.000015)\blur0.5\bord0.75\3c&H000000&}Xem trước tập sau
Dialogue: 0,0:23:43.20,0:23:46.62,Default,Nag,0,0,0,,Em thấy bây giờ cậu trông cũng dịu dàng hơn nhiều rồi đấy.
Dialogue: 0,0:23:48.41,0:23:51.37,Default,Oka,0,0,0,,Hồi trước tớ luôn thấy những chuyện như thế thật phiền phức.
Dialogue: 0,0:23:52.33,0:23:55.42,Default,Oka,0,0,0,,Nói vậy chứ hồi ở trường, tớ lại toàn đi xía mũi vào chuyện của người khác.
Dialogue: 0,0:23:55.42,0:24:00.42,Default,Nag,0,0,0,,Em nghĩ cậu nên chọn con đường mà cậu cho là tốt nhất.
Dialogue: 0,0:24:04.72,0:24:09.68,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad3\pos(960,405)\bord0.75\blur0.5\3c&H00000A&}Tập 12
