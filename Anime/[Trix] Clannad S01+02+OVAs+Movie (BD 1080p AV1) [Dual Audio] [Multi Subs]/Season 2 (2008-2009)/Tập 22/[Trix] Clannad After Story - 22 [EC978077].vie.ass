Dialogue: 0,0:15:39.55,0:15:53.85,English,,0,0,0,,{\fad(300,1500)}{\be1\pos(1824,120)}Ngày mà rồi đây sẽ đến, sẽ mở ra một mùa mới ngập tràn ánh nắng.
Dialogue: 0,0:16:21.67,0:16:23.72,Default,Kou,0,0,0,,Đừng có cáu kỉnh như thế chứ em.
Dialogue: 0,0:16:23.72,0:16:25.76,Default,Fuk,0,0,0,,Fuko đang cực kỳ bực mình đấy nhé.
Dialogue: 0,0:16:25.76,0:16:28.51,Default,Fuk,0,0,0,,Cái người vừa nãy thất lễ thật đấy.
Dialogue: 0,0:16:28.51,0:16:30.72,Default,Fuk,0,0,0,,Fuko đâu phải là học sinh tiểu học đâu chứ.
Dialogue: 0,0:16:30.72,0:16:34.98,Default,Kou,0,0,0,,Tại vóc dáng em nhỏ bé quá nên người ta nhầm cũng đâu trách được.
Dialogue: 0,0:16:34.98,0:16:39.48,Default,Fuk,0,0,0,,Dù Fuko có nhỏ nhắn, Fuko vẫn muốn người ta phải cảm nhận được khí chất người lớn tỏa ra từ Fuko cơ.
Dialogue: 0,0:16:39.48,0:16:43.78,Default,Kou,0,0,0,,Khí chất đó của em không tỏa ra nhiều như em nghĩ đâu.
Dialogue: 0,0:16:44.49,0:16:47.87,Default,Fuk,0,0,0,,Câu đó đâm trúng tim đen của Fuko rồi đấy.
Dialogue: 0,0:16:47.87,0:16:49.78,Default,Fuk,0,0,0,,Fuko thực sự bị tổn thương sâu sắc rồi.
Dialogue: 0,0:16:50.37,0:16:52.16,Default,Fuk,0,0,0,,Fuko đã bị vấy bẩn rồi!
Dialogue: 0,0:16:52.16,0:16:54.00,Default,Kou,0,0,0,,Đừng có nói mấy câu kỳ quặc thế chứ.
Dialogue: 0,0:16:54.50,0:16:56.12,Default,Fuk,0,0,0,,Fuko là người lớn rồi mà!
Dialogue: 0,0:16:56.12,0:16:57.92,Default,Kou,0,0,0,,À, có lẽ là do cái này đấy.
Dialogue: 0,0:16:57.92,0:17:02.51,Default,Kou,0,0,0,,Cách em cứ tự xưng tên mình ở ngôi thứ ba có lẽ là lý do người ta nhìn em như trẻ con đấy.
Dialogue: 0,0:17:02.51,0:17:04.88,Default,Fuk,0,0,0,,Thế thì Fuko phải xưng hô thế nào đây?
Dialogue: 0,0:17:04.88,0:17:06.51,Default,Fuk,0,0,0,,'Bổn cô nương' nhé?
Dialogue: 0,0:17:07.26,0:17:10.97,Default,Fuk,0,0,0,,Chị biết đấy, bổn cô nương đã đủ trưởng thành rồi.
Dialogue: 0,0:17:10.97,0:17:11.97,Default,Fuk,0,0,0,,Như thế này á?
Dialogue: 0,0:17:12.72,0:17:13.98,Default,Fuk,0,0,0,,Nghe cứ mờ ám, mờ ám kiểu gì ấy!
Dialogue: 0,0:17:14.43,0:17:17.31,Default,Kou,0,0,0,,Đừng có tự chọc ngoáy vào hành động của chính mình thế chứ.
Dialogue: 0,0:17:18.06,0:17:20.61,Default,Kou,0,0,0,,Cứ xưng 'tôi' như bao nhiêu người bình thường khác đi.
Dialogue: 0,0:17:20.61,0:17:22.65,Default,Fuk,0,0,0,,'Tôi' á?
Dialogue: 0,0:17:23.28,0:17:26.99,Default,Fuk,0,0,0,,Chị biết đấy, tôi đã hoàn toàn trưởng thành rồi.
Dialogue: 0,0:17:26.99,0:17:28.11,Default,Fuk,0,0,0,,Như thế này á?
Dialogue: 0,0:17:28.82,0:17:29.87,Default,Fuk,0,0,0,,Nghe cứ mờ ám, mờ ám kiểu gì ấy!
Dialogue: 0,0:17:29.87,0:17:33.49,Default,Kou,0,0,0,,Chị nghĩ chỉ cần là câu thoại đó thì em nói kiểu gì nghe cũng mờ ám hết á.
Dialogue: 0,0:17:33.49,0:17:35.91,Default,Fuk,0,0,0,,Fuko đói bụng rồi.
Dialogue: 0,0:17:35.91,0:17:37.71,Default,Kou,0,0,0,,Vậy là em đã bỏ cuộc rồi đấy à?
Dialogue: 0,0:17:38.21,0:17:40.67,Default,Fuk,0,0,0,,Fuko muốn đi ăn nhà hàng gia đình cơ.
Dialogue: 0,0:17:41.34,0:17:43.21,Default,Kou,0,0,0,,Khám sức khỏe xong rồi hẵng đi nhé.
Dialogue: 0,0:17:43.21,0:17:46.01,Default,Fuk,0,0,0,,Người Fuko hoàn toàn khỏe mạnh chẳng có vấn đề gì nữa rồi.
Dialogue: 0,0:17:46.76,0:17:48.84,Default,Fuk,0,0,0,,Nên chúng ta đi ăn ngay bây giờ đi!
Dialogue: 0,0:17:48.84,0:17:49.47,Default,Kou,0,0,0,,Không được!
Dialogue: 0,0:17:49.47,0:17:53.18,Default,Fuk,0,0,0,,Không nhanh chân là món hamburger sẽ bán hết sạch mất.
Dialogue: 0,0:17:53.18,0:17:55.56,Default,Kou,0,0,0,,Vẫn còn nhiều lắm, em đừng lo.
Dialogue: 0,0:17:56.23,0:18:00.98,Default,Fuk,0,0,0,,Nếu từ tuần trước đến giờ ai cũng chỉ gọi mỗi món hamburger thì sẽ hết sạch đấy thôi.
Dialogue: 0,0:18:01.31,0:18:03.86,Default,Kou,0,0,0,,Làm gì có chuyện trùng hợp đến thế được, em đừng có lo.
Dialogue: 0,0:18:04.94,0:18:07.32,Default,Kou,0,0,0,,Ngoan nào, sắp đến bệnh viện rồi.
Dialogue: 0,0:18:07.32,0:18:10.36,Default,Kou,0,0,0,,Nếu món hamburger bán hết, chị sẽ tự tay làm cho em ăn.
Dialogue: 0,0:18:10.36,0:18:13.33,Default,Fuk,0,0,0,,Có được đặt trên đĩa gang nóng hổi để không bị nguội không chị?
Dialogue: 0,0:18:13.33,0:18:15.12,Default,Kou,0,0,0,,Có chứ, có chứ.
Dialogue: 0,0:18:15.12,0:18:17.00,Default,Fuk,0,0,0,,Thế thì được ạ.
Dialogue: 0,0:18:18.46,0:18:24.38,Default,Kou,0,0,0,,Hơn nữa, dù sức khỏe em đã bình phục,\Nchúng ta vẫn cần phải kiểm tra định kỳ.
Dialogue: 0,0:18:25.09,0:18:29.38,Default,Kou,0,0,0,,Chỉ cần bác sĩ bảo em vẫn khỏe mạnh là chị mới yên tâm được.
Dialogue: 0,0:18:29.38,0:18:29.88,Default,Kou,0,0,0,,Được chứ em?
Dialogue: 0,0:18:30.38,0:18:32.93,Default,Fuk,0,0,0,,Fuko đang làm chị phải lo lắng sao?
Dialogue: 0,0:18:34.18,0:18:36.89,Default,Kou,0,0,0,,Không, cũng không hẳn là lo lắng nhiều thế đâu.
Dialogue: 0,0:18:38.39,0:18:41.48,Default,Fuk,0,0,0,,Xin hãy mổ xẻ kiểm tra Fuko tùy thích để chị được an lòng nhé!
Dialogue: 0,0:18:41.85,0:18:42.90,Default,Kou,0,0,0,,Fuu-chan!
Dialogue: 0,0:18:42.90,0:18:46.03,Default,Fuk,0,0,0,,Chị ơi! Chị đi chậm quá đấy!
Dialogue: 0,0:18:46.03,0:18:48.03,Default,Fuk,0,0,0,,Chúng ta rảo bước nhanh lên nào!
Dialogue: 0,0:18:48.03,0:18:49.90,Default,Kou,0,0,0,,Sao con bé này lại thế cơ chứ?
Dialogue: 0,0:18:57.87,0:18:59.75,Default,Kou,0,0,0,,Lần này lại có chuyện gì nữa thế Fuu-chan?
Dialogue: 0,0:19:00.08,0:19:01.62,Default,Fuk,0,0,0,,Fuko ngửi thấy mùi hương rồi.
Dialogue: 0,0:19:01.62,0:19:02.83,Default,Kou,0,0,0,,Mùi của món hamburger à?
Dialogue: 0,0:19:02.83,0:19:05.09,Default,Fuk,0,0,0,,Đừng có coi em cũng nông cạn y hệt như chị chứ!
Dialogue: 0,0:19:05.59,0:19:08.71,Default,Kou,0,0,0,,Chị đang cố gắng nói chuyện ở cùng đẳng cấp với em đấy thôi.
Dialogue: 0,0:19:08.71,0:19:10.30,Default,Fuk,0,0,0,,Chị nói câu đó thất lễ quá đấy nhé.
Dialogue: 0,0:19:10.30,0:19:13.72,Default,Fuk,0,0,0,,Fuko sẽ làm lại từ đầu, nên xin chị hãy hỏi Fuko ngửi thấy mùi gì nhé.
Dialogue: 0,0:19:13.72,0:19:14.93,Default,Kou,0,0,0,,Rồi rồi, được rồi.
Dialogue: 0,0:19:15.47,0:19:16.68,Default,Fuk,0,0,0,,Fuko ngửi thấy mùi hương rồi.
Dialogue: 0,0:19:17.35,0:19:18.22,Default,Kou,0,0,0,,Em ngửi thấy mùi gì thế?
Dialogue: 0,0:19:18.22,0:19:20.85,Default,Fuk,0,0,0,,Mùi hương này là...
Dialogue: 0,0:19:20.85,0:19:22.81,Default,Fuk,0,0,0,,Một mùi hương hết sức đáng yêu.
Dialogue: 0,0:19:22.81,0:19:25.31,Default,Kou,0,0,0,,Đó đâu phải là một câu trả lời.
Dialogue: 0,0:19:25.31,0:19:27.69,Default,Fuk,0,0,0,,Fuko đã hy vọng chị sẽ nắm bắt được ý tứ tinh tế đó.
Dialogue: 0,0:19:27.69,0:19:28.94,Default,Kou,0,0,0,,Đó là một câu đố à?
Dialogue: 0,0:19:28.94,0:19:31.20,Default,Fuk,0,0,0,,Chị lại bất lịch sự nữa rồi. Đó là cả một nghệ thuật đấy.
Dialogue: 0,0:19:31.20,0:19:33.82,Default,Kou,0,0,0,,Em lại bắt đầu nói huyên thuyên rồi đấy.
Dialogue: 0,0:19:33.82,0:19:35.53,Default,Kou,0,0,0,,Em có nhận thức được mình đang nói gì không hả Fuu-chan?
Dialogue: 0,0:19:35.53,0:19:39.54,Default,Fuk,0,0,0,,Tại chị từng là giáo viên nên chị thực tế quá mức đấy thôi.
Dialogue: 0,0:19:39.54,0:19:42.58,Default,Kou,0,0,0,,Chị từng là giáo viên dạy mỹ thuật mà.
Dialogue: 0,0:19:42.58,0:19:43.46,Default,Kou,0,0,0,,Mỹ thuật.
Dialogue: 0,0:19:43.46,0:19:44.29,Default,Kou,0,0,0,,Chị thấy chưa?
Dialogue: 0,0:19:44.29,0:19:47.25,Default,Fuk,0,0,0,,Thế thì xin chị hãy thấu hiểu những gì Fuko nói đi.
Dialogue: 0,0:19:47.25,0:19:49.46,Default,Kou,0,0,0,,Có gì để mà thấu hiểu cơ chứ.
Dialogue: 0,0:19:49.46,0:19:50.72,Default,Fuk,0,0,0,,Được rồi...
Dialogue: 0,0:19:51.26,0:19:53.18,Default,Fuk,0,0,0,,Vậy thì Fuko sẽ nói thật đơn giản nhé.
Dialogue: 0,0:19:53.18,0:19:56.30,Default,Fuk,0,0,0,,Em sẽ lặp lại lần nữa, nên chị hãy hỏi Fuko đó là mùi gì đi.
Dialogue: 0,0:19:56.30,0:19:57.05,Default,Kou,0,0,0,,Được rồi.
Dialogue: 0,0:19:57.64,0:19:58.76,Default,Fuk,0,0,0,,Có ai đó đang ở đằng kia.
Dialogue: 0,0:19:58.76,0:19:59.60,Default,Kou,0,0,0,,Sao cơ?
Dialogue: 0,0:19:59.60,0:20:01.18,Default,Fuk,0,0,0,,Đó đâu phải câu chị nên nói.
Dialogue: 0,0:20:01.81,0:20:03.60,Default,Kou,0,0,0,,Thì câu thoại của em vừa thay đổi rồi còn gì.
Dialogue: 0,0:20:03.60,0:20:06.69,Default,Kou,0,0,0,,Ý em là chị phải hỏi:\N'Em ngửi thấy mùi gì thế?' với câu vừa rồi à?
Dialogue: 0,0:20:06.69,0:20:07.82,Default,Fuk,0,0,0,,Đúng rồi ạ.
Dialogue: 0,0:20:07.82,0:20:10.23,Default,Kou,0,0,0,,Hỏi thế thì chị thành kẻ dở hơi mất.
Dialogue: 0,0:20:10.23,0:20:13.20,Default,Fuk,0,0,0,,Đừng lo. Fuko sẽ đỡ lời cho chị mà.
Dialogue: 0,0:20:14.03,0:20:15.62,Default,Fuk,0,0,0,,Làm lại lần nữa nhé.
Dialogue: 0,0:20:15.62,0:20:16.66,Default,Kou,0,0,0,,Được rồi.
Dialogue: 0,0:20:17.41,0:20:18.58,Default,Fuk,0,0,0,,Có ai đó đang ở đằng kia.
Dialogue: 0,0:20:18.58,0:20:20.29,Default,Kou,0,0,0,,Em ngửi thấy mùi gì thế?
Dialogue: 0,0:20:20.29,0:20:23.04,Default,Fuk,0,0,0,,Em chắc chắn người ấy đến đây để gặp em.
Dialogue: 0,0:20:24.00,0:20:26.38,Default,Kou,0,0,0,,Em chẳng hề đỡ lời cho chị chút nào cả.
Dialogue: 0,0:20:26.88,0:20:29.38,Default,Fuk,0,0,0,,Sao chị chẳng tỏ ra ngạc nhiên chút nào thế?
Dialogue: 0,0:20:29.38,0:20:32.22,Default,Fuk,0,0,0,,Fuko bảo là có người đến đây để gặp Fuko cơ mà.
Dialogue: 0,0:20:32.76,0:20:36.43,Default,Kou,0,0,0,,Chị chỉ mong em sẽ kết được thật nhiều bạn mới thôi.
Dialogue: 0,0:20:36.84,0:20:38.39,Default,Fuk,0,0,0,,Làm lại lần nữa nào.
Dialogue: 0,0:20:38.39,0:20:39.97,Default,Kou,0,0,0,,Tuân lệnh cô nương.
Dialogue: 0,0:20:40.31,0:20:41.56,Default,Fuk,0,0,0,,Có ai đó đang ở đằng kia.
Dialogue: 0,0:20:41.85,0:20:43.23,Default,Kou,0,0,0,,Em ngửi thấy mùi gì thế?
Dialogue: 0,0:20:43.23,0:20:46.27,Default,Fuk,0,0,0,,Em chắc chắn người ấy đến đây để gặp em.
Dialogue: 0,0:20:46.27,0:20:48.44,Default,Kou,0,0,0,,Ý em là sao cơ?
Dialogue: 0,0:20:48.44,0:20:50.61,Default,Fuk,0,0,0,,Đó là một mùi hương hết sức đáng yêu.
Dialogue: 0,0:20:51.07,0:20:53.28,Default,Kou,0,0,0,,Em nói chuyện chẳng có logic gì cả.
Dialogue: 0,0:20:53.28,0:20:55.32,Default,Fuk,0,0,0,,Người ấy đang ngủ say ở nơi đó.
Dialogue: 0,0:20:55.32,0:20:58.03,Default,Fuk,0,0,0,,Đang chờ đợi được một ai đó đánh thức.
Dialogue: 0,0:20:58.03,0:20:59.20,Default,Fuk,0,0,0,,Vì vậy...
Dialogue: 0,0:21:00.03,0:21:01.54,Default,Fuk,0,0,0,,Fuko xuất phát đây!
Dialogue: 0,0:21:03.70,0:21:05.54,Default,Kou,0,0,0,,Fuu-chan! Em đi đâu đấy?!
Dialogue: 0,0:21:06.00,0:21:09.29,Default,Fuk,0,0,0,,Chị cũng muốn gặp người ấy thì hãy chạy nhanh lên nhé!
Dialogue: 0,0:21:09.29,0:21:11.13,Default,Fuk,0,0,0,,Người ấy đang ở dưới gốc cây kia kìa!
Dialogue: 0,0:21:11.50,0:21:12.80,Default,Kou,0,0,0,,Có ai ở đó sao em?
Dialogue: 0,0:21:12.80,0:21:14.47,Default,Fuk,0,0,0,,Fuko cũng không biết nữa!
Dialogue: 0,0:21:14.47,0:21:17.55,Default,Fuk,0,0,0,,Nhưng chắc chắn đó là một cô bé vô cùng đáng yêu!
Dialogue: 0,0:21:17.55,0:21:18.89,Default,Kou,0,0,0,,Fuu-chan!
Dialogue: 0,0:21:18.89,0:21:20.39,Default,Kou,0,0,0,,Này, Fuu-chan!
Dialogue: 0,0:21:21.22,0:21:24.06,Default,Kou,0,0,0,,Thật tình, cái con bé này...
Dialogue: 0,0:21:35.57,0:21:38.20,Default,Fuk,0,0,0,,Em có ở đó không? Chị là Fuko đây.
Dialogue: 0,0:21:45.20,0:21:48.33,Default,Fuk,0,0,0,,Tên của em là gì thế?
Dialogue: 0,0:21:49.00,0:21:50.42,Default,Fuk,0,0,0,,Nói cho chị Fuko biết được không?
Dialogue: 0,0:21:52.04,0:21:55.84,Default,Fuk,0,0,0,,Chúng mình cùng làm bạn và chơi đùa với nhau nhé.
Dialogue: 0,0:21:57.72,0:22:02.14,Default,Fuk,0,0,0,,Những điều kỳ diệu và vui vẻ giờ đây mới chỉ bắt đầu thôi.
