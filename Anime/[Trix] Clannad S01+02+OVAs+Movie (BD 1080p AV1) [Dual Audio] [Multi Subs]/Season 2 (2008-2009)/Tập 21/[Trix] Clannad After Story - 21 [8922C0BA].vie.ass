Dialogue: 0,0:02:49.07,0:02:50.36,Default,Girl,0,0,0,,Bạn có sao không?
Dialogue: 0,0:02:50.70,0:02:52.61,Default,Girl,0,0,0,,Bạn có thấy lạnh không?
Dialogue: 0,0:02:53.45,0:02:56.54,Default,Robo,0,0,0,,Là một con búp bê, tôi không cảm thấy cái lạnh.
Dialogue: 0,0:02:57.24,0:03:00.75,Default,Robo,0,0,0,,Nhưng tôi tin chắc bàn tay cô ấy đang rất lạnh buốt.
Dialogue: 0,0:03:02.00,0:03:04.88,Default,Robo,0,0,0,,Dù bản thân tôi thậm chí còn chẳng thể cảm nhận được điều đó.
Dialogue: 0,0:03:07.34,0:03:10.42,Default,Girl,0,0,0,,Thế giới này chẳng mấy chốc sẽ nhuộm một màu trắng xóa.
Dialogue: 0,0:03:11.18,0:03:12.93,Default,Girl,0,0,0,,Chúng ta cần phải nhanh chân lên một chút.
Dialogue: 0,0:03:15.10,0:03:18.77,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 21
Dialogue: 0,0:03:15.10,0:03:18.77,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Nơi Tận Cùng Của Thế Giới
Dialogue: 0,0:03:28.36,0:03:29.94,Default,Ush,0,0,0,,Ngày hội thể thao...
Dialogue: 0,0:03:29.94,0:03:30.78,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:03:33.32,0:03:35.20,Default,Ush,0,0,0,,Bố không đi chạy sao bố?
Dialogue: 0,0:03:36.03,0:03:38.99,Default,Oka,0,0,0,,Bố sẽ ở bên cạnh con suốt cả ngày hôm nay.
Dialogue: 0,0:03:38.99,0:03:40.54,Default,Ush,0,0,0,,Còn Akki thì sao ạ?
Dialogue: 0,0:03:40.54,0:03:46.71,Default,Oka,0,0,0,,Chắc chú ấy sẽ chạy. Nếu cả hai người chạy cuối đều bỏ cuộc,
họ sẽ khó mà tìm được người thay thế.
Dialogue: 0,0:03:50.17,0:03:52.51,Default,Ush,0,0,0,,Bố ơi, bố phải thắng Akki nhé.
Dialogue: 0,0:03:54.30,0:03:55.97,Default,Oka,0,0,0,,Bố đã bảo là bố sẽ ở cạnh con mà.
Dialogue: 0,0:03:56.60,0:03:58.47,Default,Ush,0,0,0,,Con không thích thế đâu.
Dialogue: 0,0:03:58.47,0:04:00.64,Default,Oka,0,0,0,,Hóa ra con đứng về phía bố à?
Dialogue: 0,0:04:01.31,0:04:01.98,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:04:02.43,0:04:04.14,Default,Oka,0,0,0,,Bố cũng luôn đứng về phía con mà.
Dialogue: 0,0:04:04.69,0:04:07.11,Default,Oka,0,0,0,,Dù có chuyện gì xảy ra đi nữa, bố cũng sẽ bảo vệ con.
Dialogue: 0,0:04:08.44,0:04:09.11,Default,Ush,0,0,0,,Dạ.
Dialogue: 0,0:04:13.11,0:04:13.99,Default,Oka,0,0,0,,Con buồn ngủ rồi sao?
Dialogue: 0,0:04:13.99,0:04:14.86,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:04:15.57,0:04:18.37,Default,Oka,0,0,0,,Đừng lo nhé con. Bố sẽ không đi đâu hết.
Dialogue: 0,0:04:18.37,0:04:19.12,Default,Ush,0,0,0,,Vâng ạ.
Dialogue: 0,0:04:24.29,0:04:25.50,Default,Oka,0,0,0,,Một tuần trôi qua...
Dialogue: 0,0:04:25.50,0:04:26.63,Default,Oka,0,0,0,,Rồi hai tuần...
Dialogue: 0,0:04:27.42,0:04:31.30,Default,Oka,0,0,0,,Một tháng ròng rã trôi qua,
nhưng cơn sốt của Ushio vẫn không hề thuyên giảm.
Dialogue: 0,0:04:32.13,0:04:36.09,Default,Oka,0,0,0,,Con bé không thể đến trường mẫu giáo, nói gì đến việc bước chân ra khỏi phòng.
Dialogue: 0,0:04:36.64,0:04:38.14,Signs,,0,0,0,,{\an1\fnArial\fs36\b1\c&H6D87A0&\frz348.423\fry2\fax0.24\pos(521.17,317.5)\blur0.5}Điện lực Hikarizaka - Thiết kế & Thi công Điện
Dialogue: 0,0:04:37.39,0:04:38.14,Default,Oka,0,0,0,,Cháu thực sự xin lỗi.
Dialogue: 0,0:04:38.14,0:04:39.64,Signs,,0,0,0,,{\fnEdo SZ\fs54\pos(973.5,909)\c&H4B4B4B&\b1}Đơn Xin Thôi Việc
Dialogue: 0,0:04:40.64,0:04:44.52,Default,Boss,0,0,0,,Tôi không muốn cậu rời khỏi công ty đâu.
Dialogue: 0,0:04:44.52,0:04:47.77,Default,Boss,0,0,0,,Nhưng xem ra cậu cũng có rất nhiều gánh nặng.
Dialogue: 0,0:04:47.77,0:05:00.41,Signs,,0,0,0,,{\fsp1.5\an1\fnArial\fs22.5\b1\c&H6D87A0&\pos(474,198)}Điện lực Hikarizaka - Thiết kế & Thi công Điện
Dialogue: 0,0:04:56.28,0:04:57.66,Default,Yos,0,0,0,,Đó là một quyết định lớn đấy.
Dialogue: 0,0:05:01.03,0:05:04.04,Default,Oka,0,0,0,,Cô Sanae và ông chú cũng từng cố can ngăn em,
Dialogue: 0,0:05:04.04,0:05:06.75,Default,Oka,0,0,0,,nhưng em muốn được ở bên cạnh Ushio.
Dialogue: 0,0:05:07.50,0:05:08.88,Default,Yos,0,0,0,,Em có còn chút tiền tiết kiệm nào không?
Dialogue: 0,0:05:08.88,0:05:09.96,Default,Oka,0,0,0,,Dạ có một ít.
Dialogue: 0,0:05:10.50,0:05:12.30,Default,Oka,0,0,0,,Khoản tiền em để dành cho việc học hành của con bé sau này.
Dialogue: 0,0:05:12.92,0:05:13.51,Default,Yos,0,0,0,,Anh hiểu rồi.
Dialogue: 0,0:05:14.42,0:05:16.17,Default,Yos,0,0,0,,Cảm ơn em vì đã làm việc chăm chỉ suốt thời gian qua nhé.
Dialogue: 0,0:05:17.72,0:05:19.80,Default,Oka,0,0,0,,Em cảm ơn anh vì đã luôn chỉ bảo và nâng đỡ em.
Dialogue: 0,0:05:26.73,0:05:28.56,Default,Yos,0,0,0,,Cầm lấy đi. Đừng làm mất đấy.
Dialogue: 0,0:05:29.56,0:05:31.57,Signs,,0,0,0,,{\fsp15\fnEdo SZ\fs54\frz149.953\c&HA2BDD3&\bord3\3c&H58667C&\pos(1354.5,748.5)}Yoshino
Dialogue: 0,0:05:32.36,0:05:33.48,Default,Oka,0,0,0,,Anh đưa cái này cho em sao?
Dialogue: 0,0:05:33.48,0:05:37.70,Default,Yos,0,0,0,,Đâu có đưa luôn. Không có nó thì từ mai anh đi làm bằng niềm tin à?
Dialogue: 0,0:05:37.70,0:05:38.82,Default,Oka,0,0,0,,Thế thì-
Dialogue: 0,0:05:40.91,0:05:43.24,Default,Yos,0,0,0,,Đổi lại cho anh mượn túi đồ nghề của em đi.
Dialogue: 0,0:05:43.83,0:05:45.58,Default,Yos,0,0,0,,Khi nào em quay trở lại làm việc thì anh sẽ trả lại.
Dialogue: 0,0:05:46.83,0:05:49.21,Default,Yos,0,0,0,,Bao giờ Ushio-chan khỏi bệnh thì hãy quay lại đây nhé.
Dialogue: 0,0:05:49.88,0:05:51.67,Default,Yos,0,0,0,,Từ giờ đến lúc đó anh sẽ mượn tạm của em.
Dialogue: 0,0:06:13.61,0:06:16.07,Default,Yos,0,0,0,,Anh sẽ giữ gìn nó thật cẩn thận.
Dialogue: 0,0:06:18.03,0:06:20.78,Signs,,0,0,0,,{\fsp1.5\an1\fnArial\fs22.5\b1\c&H6D87A0&\pos(474,198)}Điện lực Hikarizaka - Thiết kế & Thi công Điện
Dialogue: 0,0:06:21.41,0:06:23.28,Default,Oka,0,0,0,,Ushio được chăm sóc ở nhà.
Dialogue: 0,0:06:23.78,0:06:26.79,Default,Oka,0,0,0,,Chúng tôi từng tính đưa con bé vào bệnh viện nhưng rồi lại thôi.
Dialogue: 0,0:06:27.54,0:06:32.00,Default,Oka,0,0,0,,Bởi không ai biết cách điều trị căn bệnh này,
nên nằm viện cũng chẳng giải quyết được gì.
Dialogue: 0,0:06:32.88,0:06:36.21,Default,Oka,0,0,0,,Và hơn hết, Ushio muốn được ở nhà.
Dialogue: 0,0:06:36.88,0:06:39.38,Default,Oka,0,0,0,,Hai bố con mình thay bộ đồ ngủ mới nhé con.
Dialogue: 0,0:06:39.38,0:06:40.05,Default,Ush,0,0,0,,Vâng ạ.
Dialogue: 0,0:06:42.30,0:06:45.64,Default,Oka,0,0,0,,Con không cần phải gượng dậy đâu, để bố thay cho con.
Dialogue: 0,0:06:47.22,0:06:48.77,Default,Ush,0,0,0,,Con tự làm được mà.
Dialogue: 0,0:07:00.90,0:07:03.95,Default,Oka,0,0,0,,Lúc này con chưa tự làm được cũng không sao đâu.
Dialogue: 0,0:07:04.62,0:07:05.49,Default,Ush,0,0,0,,Vâng ạ...
Dialogue: 0,0:07:06.24,0:07:08.75,Default,Oka,0,0,0,,Ushio không thể tự mình thay quần áo được nữa.
Dialogue: 0,0:07:09.54,0:07:11.25,Default,Oka,0,0,0,,Con bé cũng chẳng thể tự đi vệ sinh một mình.
Dialogue: 0,0:07:11.25,0:07:13.67,Default,Oka,0,0,0,,Con bé chỉ ăn được những món thật mềm.
Dialogue: 0,0:07:15.38,0:07:19.97,Default,Oka,0,0,0,,Liệu những tháng ngày êm đềm ấy có bao giờ quay trở lại nữa không?
Dialogue: 0,0:07:28.18,0:07:30.60,Default,Oka,0,0,0,,Ushio, con có muốn thứ gì không?
Dialogue: 0,0:07:32.48,0:07:33.73,Default,Oka,0,0,0,,Nếu muốn gì cứ nói với bố nhé.
Dialogue: 0,0:07:33.73,0:07:36.77,Default,Oka,0,0,0,,Bố sẽ mua cho con bất cứ thứ gì, đồ chơi hay bánh kẹo cũng được.
Dialogue: 0,0:07:41.19,0:07:42.40,Default,Ush,0,0,0,,Con muốn đi du lịch ạ.
Dialogue: 0,0:07:43.32,0:07:44.28,Default,Oka,0,0,0,,Đi du lịch sao?
Dialogue: 0,0:07:44.28,0:07:46.58,Default,Ush,0,0,0,,Con muốn lại được đi du lịch cùng với bố.
Dialogue: 0,0:07:47.78,0:07:50.16,Default,Oka,0,0,0,,Lần đó đâu có vui vẻ gì đâu con?
Dialogue: 0,0:07:50.16,0:07:52.79,Default,Oka,0,0,0,,Bố lúc nào cũng cáu kỉnh rồi quát mắng con suốt cả chuyến đi mà.
Dialogue: 0,0:07:54.17,0:07:55.67,Default,Ush,0,0,0,,Vui lắm bố ạ.
Dialogue: 0,0:07:56.29,0:07:57.96,Default,Ush,0,0,0,,Con muốn lại được đi du lịch một lần nữa.
Dialogue: 0,0:07:58.84,0:08:02.17,Default,Ush,0,0,0,,Được ngồi trên tàu cùng với bố.
Dialogue: 0,0:08:03.80,0:08:05.05,Default,Oka,0,0,0,,Bao giờ con khỏi bệnh thì hai bố con mình đi nhé?
Dialogue: 0,0:08:07.47,0:08:08.56,Default,Ush,0,0,0,,Con muốn đi ngay bây giờ cơ ạ.
Dialogue: 0,0:08:10.68,0:08:14.52,Default,Oka,0,0,0,,Ushio... Đừng đòi hỏi những điều vô lý làm khó bố như thế chứ.
Dialogue: 0,0:08:20.15,0:08:24.91,Default,Oka,0,0,0,,Chẳng lẽ mình đến một ước nguyện duy nhất của đứa con gái bé bỏng cũng không thể thực hiện được sao?
Dialogue: 0,0:08:26.53,0:08:27.20,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:08:28.03,0:08:29.49,Default,Oka,0,0,0,,Anh phải làm sao bây giờ?
Dialogue: 0,0:08:29.95,0:08:32.70,Default,Oka,0,0,0,,Giá như những lúc thế này có em ở bên cạnh thì tốt biết mấy.
Dialogue: 0,0:08:37.54,0:08:38.38,Default,Oka,0,0,0,,Mình...
Dialogue: 0,0:08:39.13,0:08:43.38,Default,Oka,0,0,0,,Có lẽ gia đình mình đang bị thành phố này trêu ngươi.
Dialogue: 0,0:08:44.34,0:08:48.47,Default,Oka,0,0,0,,Ban tặng cho niềm hạnh phúc, rồi lại tàn nhẫn cướp đi.
Dialogue: 0,0:08:52.06,0:08:52.93,Default,Oka,0,0,0,,Không thể tha thứ được.
Dialogue: 0,0:08:54.27,0:08:56.27,Default,Oka,0,0,0,,Dù có phải trả giá bằng bất cứ điều gì, mình cũng nhất định sẽ cứu lấy Ushio.
Dialogue: 0,0:08:57.15,0:08:58.36,Default,Oka,0,0,0,,Mình nhất định sẽ cứu lấy Ushio!
Dialogue: 0,0:09:02.23,0:09:03.86,Default,Oka,0,0,0,,Làm phiền hai bác chăm sóc con bé giúp cháu.
Dialogue: 0,0:09:04.32,0:09:05.57,Default,San,0,0,0,,Cháu đi đường cẩn thận nhé.
Dialogue: 0,0:09:06.24,0:09:06.99,Default,Aki,0,0,0,,Hẹn gặp lại chú nhé.
Dialogue: 0,0:09:10.87,0:09:11.66,Default,Aki,0,0,0,,Này nhóc.
Dialogue: 0,0:09:14.20,0:09:15.12,Default,Aki,0,0,0,,Cầm lấy đi.
Dialogue: 0,0:09:19.17,0:09:20.63,Default,Oka,0,0,0,,Cháu không thể nhận được đâu chú.
Dialogue: 0,0:09:20.63,0:09:22.80,Default,Aki,0,0,0,,Đừng có bướng bỉnh thế chứ.
Dialogue: 0,0:09:22.80,0:09:25.47,Default,Oka,0,0,0,,Không, cháu không có ý như vậy đâu.
Dialogue: 0,0:09:25.47,0:09:28.68,Default,Oka,0,0,0,,Cháu vẫn còn một khoản tiền tiết kiệm,
nên trong thời gian tới bố con cháu vẫn ổn mà.
Dialogue: 0,0:09:28.68,0:09:30.68,Default,Aki,0,0,0,,Tao sẽ đấm cho mày một trận nếu mày dám nói dối tao đấy.
Dialogue: 0,0:09:30.68,0:09:31.89,Default,Oka,0,0,0,,Cháu đang nói thật lòng mà.
Dialogue: 0,0:09:33.27,0:09:34.89,Default,Aki,0,0,0,,Thế thì được.
Dialogue: 0,0:09:36.64,0:09:40.44,Default,Aki,0,0,0,,Có những thứ mà một người đàn ông phải bảo vệ bằng mọi giá, kể cả khi phải vứt bỏ lòng tự trọng.
Dialogue: 0,0:09:40.98,0:09:41.61,Default,Aki,0,0,0,,Hiểu chưa hả?
Dialogue: 0,0:09:43.69,0:09:44.82,Default,Oka,0,0,0,,Cháu hiểu rồi.
Dialogue: 0,0:09:44.82,0:09:47.11,Default,Oka,0,0,0,,Nếu gặp chuyện gì nguy cấp, cháu nhất định sẽ nhờ chú giúp.
Dialogue: 0,0:10:03.34,0:10:05.17,Signs,,0,0,0,,{\fnArial\fs30\b1\c&HF2C7C0&\frx14\fry18\pos(1008,243)\frz343.5\fax0.4}Bệnh viện{\fax0.3} Đa khoa{\fax0.2} Hikariz{\fax0.1}aka
Dialogue: 0,0:10:11.34,0:10:12.43,Default,Aki,0,0,0,,Làm một điếu không?
Dialogue: 0,0:10:13.18,0:10:15.14,Default,Oka,0,0,0,,Dạ thôi, cháu bỏ thuốc rồi.
Dialogue: 0,0:10:16.31,0:10:17.77,Default,Aki,0,0,0,,Thế là khôn ngoan đấy.
Dialogue: 0,0:10:20.48,0:10:21.06,Default,Oka,0,0,0,,Này chú...
Dialogue: 0,0:10:23.27,0:10:27.99,Default,Oka,0,0,0,,Người ta đã đốn hạ cả khu rừng từng ở nơi này để xây nên bệnh viện.
Dialogue: 0,0:10:27.99,0:10:31.16,Default,Oka,0,0,0,,Vật hy sinh tiếp theo sẽ là gì đây chú?
Dialogue: 0,0:10:34.08,0:10:36.79,Default,Aki,0,0,0,,Một ngọn đồi ở ngoại ô thị trấn đang bị san phẳng.
Dialogue: 0,0:10:37.75,0:10:39.79,Default,Aki,0,0,0,,Nghe nói người ta định xây một trung tâm thương mại lớn ở đó.
Dialogue: 0,0:10:40.67,0:10:43.79,Default,Aki,0,0,0,,Nó sẽ tiện lợi hơn, mang lại lợi ích cho con người mà.
Dialogue: 0,0:10:46.00,0:10:47.09,Default,Oka,0,0,0,,Có lẽ nào...
Dialogue: 0,0:10:48.38,0:10:55.06,Default,Oka,0,0,0,,Kể từ khoảnh khắc chú mang Nagisa trong cơn thập tử nhất sinh đến đây, con bé đã bị ràng buộc với thành phố này.
Dialogue: 0,0:10:55.93,0:10:58.31,Default,Oka,0,0,0,,Và cả con gái của Nagisa, bé Ushio cũng vậy.
Dialogue: 0,0:11:01.69,0:11:08.49,Default,Oka,0,0,0,,Phải chăng... đối với thành phố này, việc thay đổi chính là một nỗi đau đớn?
Dialogue: 0,0:11:12.03,0:11:14.57,Default,Aki,0,0,0,,Chú nghĩ chuyện đó chẳng liên quan gì đến nỗi đau cả.
Dialogue: 0,0:11:16.49,0:11:18.95,Default,Aki,0,0,0,,'À, mình đang thay đổi rồi.'
Dialogue: 0,0:11:19.37,0:11:21.16,Default,Aki,0,0,0,,Chú nghĩ nó chỉ đơn giản như vậy thôi.
Dialogue: 0,0:11:22.50,0:11:30.59,Default,Oka,0,0,0,,Nếu như cái chết của con người là một phần của sự đổi thay, thì chúng ta cũng buộc phải chấp nhận sao chú?
Dialogue: 0,0:11:31.55,0:11:35.80,Default,Aki,0,0,0,,Chính vì không muốn chấp nhận điều đó nên con người mới phải xây bệnh viện chứ.
Dialogue: 0,0:11:53.41,0:11:56.91,Default,Aki,0,0,0,,Cầu mong cho thành phố này và người dân nơi đây luôn được che chở và ban phước lành.
Dialogue: 0,0:12:46.08,0:12:47.58,Default,Oka,0,0,0,,Con có khát nước không?
Dialogue: 0,0:12:48.04,0:12:49.09,Default,Oka,0,0,0,,Con có muốn uống chút nước không nào?
Dialogue: 0,0:12:59.89,0:13:02.60,Default,Oka,0,0,0,,Nước lạnh đấy, con uống từ từ thôi nhé.
Dialogue: 0,0:13:02.60,0:13:04.89,Default,Oka,0,0,0,,Uống nhanh quá là sẽ bị đau bụng đấy con.
Dialogue: 0,0:13:13.86,0:13:14.90,Default,Ush,0,0,0,,Ngon lắm bố ạ.
Dialogue: 0,0:13:15.49,0:13:16.40,Default,Oka,0,0,0,,Thật thế sao con?
Dialogue: 0,0:13:16.40,0:13:17.53,Default,Ush,0,0,0,,Bố ơi.
Dialogue: 0,0:13:22.66,0:13:24.37,Default,Ush,0,0,0,,Con muốn đi du lịch.
Dialogue: 0,0:13:24.79,0:13:27.71,Default,Oka,0,0,0,,Được chứ. Sau khi con khỏi bệnh đã nhé.
Dialogue: 0,0:13:28.88,0:13:30.00,Default,Oka,0,0,0,,Con muốn đi đâu nào?
Dialogue: 0,0:13:30.38,0:13:32.38,Default,Oka,0,0,0,,Con có muốn lại đến cánh đồng hoa ngút ngàn đó không?
Dialogue: 0,0:13:32.71,0:13:35.67,Default,Oka,0,0,0,,À, nhưng giờ mà đi lên phía Bắc thì lạnh lắm.
Dialogue: 0,0:13:35.67,0:13:36.88,Default,Oka,0,0,0,,Hai bố con mình sẽ đi về phương Nam nhé.
Dialogue: 0,0:13:37.34,0:13:40.89,Default,Oka,0,0,0,,Đến một nơi thật ấm áp, xinh đẹp và ngập tràn không khí trong lành.
Dialogue: 0,0:13:41.22,0:13:42.10,Default,Oka,0,0,0,,Hoặc là-
Dialogue: 0,0:13:42.10,0:13:43.35,Default,Ush,0,0,0,,Con muốn đi ngay bây giờ cơ ạ.
Dialogue: 0,0:13:46.85,0:13:48.35,Default,Oka,0,0,0,,Phải đợi con khỏi bệnh đã chứ.
Dialogue: 0,0:13:48.35,0:13:50.06,Default,Oka,0,0,0,,Bố đã dặn con biết bao nhiêu lần rồi cơ mà?
Dialogue: 0,0:13:50.52,0:13:51.40,Default,Ush,0,0,0,,Ngay bây giờ ạ.
Dialogue: 0,0:13:52.07,0:13:53.32,Default,Ush,0,0,0,,Con muốn đi ngay bây giờ.
Dialogue: 0,0:13:53.32,0:13:54.53,Default,Ush,0,0,0,,Đến cánh đồng hoa đó.
Dialogue: 0,0:13:55.03,0:13:56.11,Default,Oka,0,0,0,,Ushio...
Dialogue: 0,0:13:57.45,0:13:59.20,Default,Ush,0,0,0,,Nhất định phải là bây giờ cơ ạ.
Dialogue: 0,0:14:00.82,0:14:03.16,Default,Ush,0,0,0,,Con muốn đi cùng với bố.
Dialogue: 0,0:14:15.05,0:14:16.51,Default,Oka,0,0,0,,Được rồi, hai bố con mình đi.
Dialogue: 0,0:14:17.38,0:14:19.59,Default,Oka,0,0,0,,Bố sẽ chiều theo ước nguyện của con.
Dialogue: 0,0:14:20.13,0:14:20.84,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:14:21.80,0:14:24.93,Default,Oka,0,0,0,,Nhưng hễ thấy trong người không khỏe là phải báo cho bố ngay đấy nhé.
Dialogue: 0,0:14:24.93,0:14:25.93,Default,Ush,0,0,0,,Dạ vâng ạ.
Dialogue: 0,0:14:27.31,0:14:28.02,Default,Oka,0,0,0,,Ngoan lắm.
Dialogue: 0,0:14:33.48,0:14:36.19,Default,Oka,0,0,0,,Bố cõng con nhé. Lại đây nào.
Dialogue: 0,0:14:38.11,0:14:39.61,Default,Ush,0,0,0,,Con muốn tự đi bộ cơ.
Dialogue: 0,0:14:39.61,0:14:40.86,Default,Oka,0,0,0,,Đừng có cố quá sức đấy con.
Dialogue: 0,0:14:43.37,0:14:45.58,Default,Ush,0,0,0,,Con muốn được cùng bước đi với bố.
Dialogue: 0,0:14:45.58,0:14:46.41,Default,Oka,0,0,0,,Thế sao?
Dialogue: 0,0:14:46.83,0:14:49.62,Default,Oka,0,0,0,,Vậy thì hai bố con mình sẽ cùng đi bộ chừng nào con còn đi được nhé.
Dialogue: 0,0:14:50.12,0:14:50.62,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:14:51.50,0:14:52.67,Default,Oka,0,0,0,,Chúng ta lên đường thôi!
Dialogue: 0,0:14:53.00,0:14:54.71,Default,Oka,0,0,0,,Hãy biến chuyến đi này thành một chuyến đi thật vui vẻ nhé con.
Dialogue: 0,0:14:56.42,0:14:57.59,Default,Ush,0,0,0,,Dạ vâng!
Dialogue: 0,0:15:11.27,0:15:12.85,Default,Oka,0,0,0,,Con có sao không, Ushio?
Dialogue: 0,0:15:12.85,0:15:13.65,Default,Ush,0,0,0,,Dạ có ạ.
Dialogue: 0,0:15:13.65,0:15:17.15,Default,Oka,0,0,0,,Chỉ cần thấy mệt một cái là con phải nói với bố ngay đấy nhé.
Dialogue: 0,0:15:17.94,0:15:19.90,Default,Oka,0,0,0,,Lúc đó hai bố con mình sẽ đi tìm bác sĩ ngay.
Dialogue: 0,0:15:19.90,0:15:20.65,Default,Ush,0,0,0,,Dạ vâng.
Dialogue: 0,0:15:44.30,0:15:45.22,Default,Oka,0,0,0,,Ushio...
Dialogue: 0,0:15:45.55,0:15:46.05,Default,Oka,0,0,0,,Hai bố con mình...
Dialogue: 0,0:16:01.19,0:16:02.03,Default,Oka,0,0,0,,Tuyết rơi rồi này con.
Dialogue: 0,0:16:16.38,0:16:18.67,Default,Oka,0,0,0,,Ushio có thích tuyết không?
Dialogue: 0,0:16:19.00,0:16:19.46,Default,Ush,0,0,0,,Dạ có ạ.
Dialogue: 0,0:16:20.92,0:16:22.42,Default,Ush,0,0,0,,Bố cũng thích tuyết chứ ạ?
Dialogue: 0,0:16:23.26,0:16:24.05,Default,Oka,0,0,0,,Bố...
Dialogue: 0,0:16:27.05,0:16:29.10,Default,Oka,0,0,0,,Ừ, bố cũng thích tuyết lắm.
Dialogue: 0,0:16:30.97,0:16:32.73,Default,Oka,0,0,0,,Con còn đi tiếp được không, Ushio?
Dialogue: 0,0:16:33.06,0:16:34.52,Default,Oka,0,0,0,,Con có muốn nghỉ một chút không?
Dialogue: 0,0:16:34.52,0:16:35.60,Default,Ush,0,0,0,,Dạ không ạ.
Dialogue: 0,0:16:36.40,0:16:38.90,Default,Oka,0,0,0,,Hai bố con mình lên xe đi trước khi tuyết rơi dày hơn nhé.
Dialogue: 0,0:16:39.27,0:16:40.36,Default,Oka,0,0,0,,Để bố cõng con nào.
Dialogue: 0,0:16:41.07,0:16:41.78,Default,Ush,0,0,0,,Con không sao đâu ạ.
Dialogue: 0,0:17:33.79,0:17:34.33,Default,Oka,0,0,0,,Ushio!
Dialogue: 0,0:17:49.30,0:17:50.14,Default,Ush,0,0,0,,Bố ơi...
Dialogue: 0,0:17:50.51,0:17:52.01,Default,Oka,0,0,0,,Sao thế con, Ushio?
Dialogue: 0,0:17:53.06,0:17:54.93,Default,Ush,0,0,0,,Chúng ta đang ở đâu thế bố?
Dialogue: 0,0:17:55.48,0:17:57.39,Default,Ush,0,0,0,,Có phải hai bố con mình đang ở trên tàu không ạ?
Dialogue: 0,0:17:58.98,0:18:01.73,Default,Oka,0,0,0,,Ừ. Hai bố con mình đang ở trên tàu rồi con.
Dialogue: 0,0:18:02.90,0:18:05.65,Default,Ush,0,0,0,,Tối quá bố ơi... Trời đã là ban đêm rồi sao ạ?
Dialogue: 0,0:18:06.19,0:18:08.91,Default,Oka,0,0,0,,Đúng rồi con. Đang là nửa đêm rồi.
Dialogue: 0,0:18:09.86,0:18:10.78,Default,Ush,0,0,0,,Ra vậy ạ...
Dialogue: 0,0:18:11.99,0:18:12.91,Default,Ush,0,0,0,,Bố ơi?
Dialogue: 0,0:18:13.91,0:18:15.41,Default,Ush,0,0,0,,Con yêu bố nhiều lắm.
Dialogue: 0,0:18:15.95,0:18:16.54,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:18:18.58,0:18:20.88,Default,Oka,0,0,0,,Bố cũng yêu con nhiều lắm, Ushio.
Dialogue: 0,0:18:33.85,0:18:34.76,Default,Oka,0,0,0,,Ushio?
Dialogue: 0,0:18:34.76,0:18:36.02,Default,Oka,0,0,0,,Ushio!
Dialogue: 0,0:18:40.60,0:18:42.40,Default,Oka,0,0,0,,USHIO!
Dialogue: 0,0:18:59.87,0:19:00.92,Default,Oka,0,0,0,,Không thể nào...
Dialogue: 0,0:19:01.50,0:19:02.83,Default,Oka,0,0,0,,Con không muốn như thế này đâu.
Dialogue: 0,0:19:03.50,0:19:04.46,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:19:05.92,0:19:07.21,Default,Oka,0,0,0,,Hãy cứu lấy Ushio với em ơi.
Dialogue: 0,0:19:10.30,0:19:11.72,Default,Oka,0,0,0,,Nagisa!
Dialogue: 0,0:19:14.05,0:19:17.01,Default,Oka,0,0,0,,Ai đó... Ai đó hãy cứu lấy Ushio với!
Dialogue: 0,0:19:19.43,0:19:20.39,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:19:55.80,0:19:56.93,Default,Girl,0,0,0,,Cảm ơn bạn.
Dialogue: 0,0:20:11.65,0:20:14.32,Default,Robo,0,0,0,,Phải bước thêm bao nhiêu bước chân nữa mới đến được nơi đó?
Dialogue: 0,0:20:15.24,0:20:18.03,Default,Robo,0,0,0,,Chẳng lẽ chúng ta chỉ còn cách nơi ấy một bước chân thôi sao?
Dialogue: 0,0:20:18.87,0:20:24.33,Default,Robo,0,0,0,,Hay là, chúng ta sẽ phải bước đi mãi mà không bao giờ có điểm dừng?
Dialogue: 0,0:20:53.19,0:20:55.15,Default,Oka,0,0,0,,Tôi ghét cái thành phố này.
Dialogue: 0,0:20:58.07,0:21:00.79,Default,Oka,0,0,0,,Nó ngập tràn những ký ức mà tôi chỉ muốn chôn vùi vào quên lãng.
Dialogue: 0,0:21:05.08,0:21:10.96,Default,Oka,0,0,0,,Mỗi ngày đều đến trường, trò chuyện cùng bạn bè, rồi lại trở về căn nhà mà bản thân chẳng bao giờ muốn quay về.
Dialogue: 0,0:21:12.21,0:21:16.43,Default,Oka,0,0,0,,Liệu cứ tiếp tục như thế này, một ngày nào đó mọi thứ có thay đổi không?
Dialogue: 0,0:21:18.09,0:21:20.10,Default,Oka,0,0,0,,Liệu ngày ấy có bao giờ đến không?
Dialogue: 0,0:21:32.15,0:21:33.32,Default,Nag,0,0,0,,Bánh mì nhân đậu đỏ!
Dialogue: 0,0:21:35.24,0:21:37.78,Default,Nag,0,0,0,,Cậu có thích ngôi trường này không?
Dialogue: 0,0:21:40.57,0:21:43.20,Default,Nag,0,0,0,,Tớ vô cùng, vô cùng yêu mến nơi này.
Dialogue: 0,0:21:43.49,0:21:46.96,Default,Nag,0,0,0,,Thế nhưng chẳng có thứ gì có thể mãi vẹn nguyên không thay đổi.
Dialogue: 0,0:21:50.63,0:21:55.51,Default,Oka,0,0,0,,Nếu như mình cất lời gọi cô ấy ở đây,
mình và Nagisa sẽ gặp nhau và rồi sẽ hẹn hò.
Dialogue: 0,0:21:56.72,0:22:00.34,Default,Oka,0,0,0,,Thế nhưng, có lẽ sẽ tốt hơn nếu như mình không làm thế.
Dialogue: 0,0:22:01.35,0:22:03.10,Default,Oka,0,0,0,,Có lẽ sẽ tốt hơn nếu như chúng ta chưa từng gặp nhau.
