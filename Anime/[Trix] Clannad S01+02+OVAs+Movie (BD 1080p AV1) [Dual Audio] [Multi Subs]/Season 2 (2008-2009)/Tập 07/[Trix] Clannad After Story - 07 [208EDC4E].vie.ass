Dialogue: 0,0:03:17.89,0:03:23.15,OP English,,0,0,0,,{\be1\fad(0,500)}Và tôi sẽ mãi mãi, trọn đời nâng niu chở che.
Dialogue: 0,0:03:27.32,0:03:29.94,Default,Oka,0,0,0,,Sao lại có cả bếp ga mini trong phòng tư liệu thế này?
Dialogue: 0,0:03:31.11,0:03:36.99,Default,Yuk,0,0,0,,Đủ thứ đồ đạc không còn dùng đến,\Nkể cả những thứ không phải là sách vở, đều được cất ở đây mà.
Dialogue: 0,0:03:37.41,0:03:39.75,Default,Sun,0,0,0,,Nấu ăn ngon lại còn học giỏi.
Dialogue: 0,0:03:39.75,0:03:42.25,Default,Sun,0,0,0,,Ngoại hình xinh xắn lại đối xử tốt bụng với tất cả mọi người.
Dialogue: 0,0:03:42.25,0:03:45.79,Default,Sun,0,0,0,,Ngắm nhìn Yukine-chan làm lòng tôi thấy thanh thản biết bao.
Dialogue: 0,0:03:45.79,0:03:47.67,Default,Yuk,0,0,0,,Cảm ơn cậu nhiều nhé.
Dialogue: 0,0:03:47.67,0:03:49.88,Default,Yuk,0,0,0,,Có các cậu ở đây lúc nào cũng náo nhiệt vui vẻ ghê.
Dialogue: 0,0:03:49.88,0:03:53.05,Default,Nag,0,0,0,,Vâng. Ngày nào cũng vui quá chừng luôn ạ.
Dialogue: 0,0:03:53.05,0:03:54.84,Default,Oka,0,0,0,,Còn cậu thì sao?
Dialogue: 0,0:03:54.84,0:03:58.51,Default,Oka,0,0,0,,Ngày nào cũng ở đây một mình thế này cậu không thấy chán à?
Dialogue: 0,0:03:58.51,0:04:02.39,Default,Yuk,0,0,0,,Không hề đâu, vì mình thường xuyên có khách ghé thăm lắm.
Dialogue: 0,0:04:02.39,0:04:03.69,Default,Oka,0,0,0,,Khách ghé thăm...
Dialogue: 0,0:04:08.86,0:04:10.82,Default,Oka,0,0,0,,Thế còn gã kia là thế nào?
Dialogue: 0,0:04:11.28,0:04:14.20,Default,Yuk,0,0,0,,Thế hôm nay có chuyện gì đưa cậu đến đây vậy?
Dialogue: 0,0:04:14.20,0:04:18.45,Default,Sun,0,0,0,,Dĩ nhiên là đến để bày tỏ rằng tôi yêu em nhiều đến nhường nào rồi.
Dialogue: 0,0:04:18.87,0:04:22.12,Default,Sun,0,0,0,,Gần đây tôi mới nhận ra tình cảm chân thật trong lòng mình.
Dialogue: 0,0:04:22.12,0:04:23.58,Default,Sun,0,0,0,,Tình yêu này dành cho em là hoàn toàn có thật!
Dialogue: 0,0:04:24.08,0:04:26.00,Default,Yuk,0,0,0,,Cảm ơn cậu nhiều nhé.
Dialogue: 0,0:04:26.00,0:04:30.84,Default,Yuk,0,0,0,,Nhưng mình nghĩ rồi sẽ có một người tốt hơn đến với cậu thôi.
Dialogue: 0,0:04:30.84,0:04:32.67,Default,Sun,0,0,0,,Bị đá cái rụp không thương tiếc luôn kìa!
Dialogue: 0,0:04:32.67,0:04:35.22,Default,Sun,0,0,0,,Đã thế câu từ còn y chang như những gì Nagisa-chan từng nói nữa chứ!
Dialogue: 0,0:04:36.47,0:04:38.22,Default,Sud,0,0,0,,Ch-Chị Yuki-nee...
Dialogue: 0,0:04:39.47,0:04:40.72,Default,Yuk,0,0,0,,Sudou-san!
Dialogue: 0,0:04:41.06,0:04:44.73,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 7
Dialogue: 0,0:04:41.06,0:04:44.73,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Nơi thuộc về cô ấy
Dialogue: 0,0:04:46.23,0:04:48.48,Default,Yuk,0,0,0,,Anh có sao không, Sudou-san?
Dialogue: 0,0:04:49.94,0:04:51.61,Default,Sud,0,0,0,,Tôi ngu quá mà...
Dialogue: 0,0:04:51.61,0:04:55.24,Default,Sud,0,0,0,,Chỉ tại tôi mà cả băng đảng bị thua liểng xiểng trong trận chiến đó.
Dialogue: 0,0:04:55.95,0:04:58.37,Default,Sud,0,0,0,,Tôi chẳng còn mặt mũi nào để quay về gặp anh em nữa.
Dialogue: 0,0:04:58.99,0:05:01.29,Default,Sud,0,0,0,,Từ giờ tôi sẽ lên đường phiêu bạt giang hồ.
Dialogue: 0,0:05:01.70,0:05:05.00,Default,Sud,0,0,0,,Kể từ hôm nay tôi sẽ trở thành một con sói cô độc.
Dialogue: 0,0:05:05.66,0:05:10.63,Default,Sud,0,0,0,,Nên trước khi đi, tôi muốn ghé qua chào tạm biệt chị một tiếng.
Dialogue: 0,0:05:11.84,0:05:14.51,Default,Sud,0,0,0,,Chị cứ việc cười nhạo cái thằng hèn nhát này đi.
Dialogue: 0,0:05:14.51,0:05:18.09,Default,Sun,0,0,0,,Này, đây là phòng tư liệu của trường học đúng không?
Dialogue: 0,0:05:18.09,0:05:19.22,Default,Oka,0,0,0,,Tao nghĩ là vậy đấy.
Dialogue: 0,0:05:19.22,0:05:21.89,Default,Nag,0,0,0,,Em có nên đi gọi cô y tế không ạ?
Dialogue: 0,0:05:23.52,0:05:25.89,Default,Yuk,0,0,0,,Anh không được nói những lời bi quan như thế chứ.
Dialogue: 0,0:05:26.31,0:05:30.40,Default,Yuk,0,0,0,,Nếu anh bỏ đi, em nghĩ mọi người sẽ nhớ anh lắm đấy.
Dialogue: 0,0:05:31.69,0:05:33.15,Default,Yuk,0,0,0,,Cả em cũng sẽ nhớ anh nữa.
Dialogue: 0,0:05:33.15,0:05:34.44,Default,Sud,0,0,0,,Chị Yuki-nee...
Dialogue: 0,0:05:34.44,0:05:37.07,Default,Yuk,0,0,0,,Để em chỉ cho anh một câu bùa chú nhé.
Dialogue: 0,0:05:37.07,0:05:38.11,Default,Yuk,0,0,0,,Anh làm thế này này.
Dialogue: 0,0:05:39.70,0:05:40.82,Default,Yuk,0,0,0,,Rồi thế này nữa.
Dialogue: 0,0:05:42.16,0:05:45.70,Default,Yuk,0,0,0,,Sau đó hãy nhẩm câu: "Tôi luôn dõi theo bạn từ phía sau" ba lần.
Dialogue: 0,0:05:45.70,0:05:49.37,Default,Yuk,0,0,0,,Làm như vậy thì anh sẽ có thể làm lành lại với các bạn của mình đấy.
Dialogue: 0,0:05:49.88,0:05:53.92,Default,Sud,0,0,0,,Tôi luôn dõi theo bạn từ phía sau. Tôi luôn dõi theo bạn từ phía sau.
Dialogue: 0,0:05:53.92,0:05:55.71,Default,Sud,0,0,0,,Tôi luôn dõi theo bạn từ phía sau.
Dialogue: 0,0:05:57.97,0:06:00.14,Default,Sud,0,0,0,,Tôi thấy như có một luồng sáng hy vọng vừa mở ra rồi!
Dialogue: 0,0:06:00.14,0:06:01.80,Default,Oka,0,0,0,,Hồi phục tinh thần nhanh vãi.
Dialogue: 0,0:06:01.80,0:06:04.31,Default,Nag,0,0,0,,Mình phải ghi nhớ lại câu thần chú này mới được.
Dialogue: 0,0:06:04.31,0:06:07.43,Default,Yuk,0,0,0,,Bây giờ việc anh cần làm là hãy đàng hoàng xin lỗi mọi người nhé.
Dialogue: 0,0:06:07.43,0:06:10.98,Default,Yuk,0,0,0,,Trốn chạy sẽ chẳng giải quyết được vấn đề gì đâu.
Dialogue: 0,0:06:11.36,0:06:13.23,Default,Sud,0,0,0,,Chị nói đúng.
Dialogue: 0,0:06:14.15,0:06:16.82,Default,Sud,0,0,0,,Tôi suýt chút nữa đã đánh mất chính mình rồi.
Dialogue: 0,0:06:19.70,0:06:22.99,Default,Yuk,0,0,0,,Em đã bảo bao nhiêu lần là mọi người không được đánh nhau rồi mà.
Dialogue: 0,0:06:22.99,0:06:27.41,Default,Sud,0,0,0,,Tôi xin lỗi. Nhưng có những lúc là đàn ông thì bắt buộc phải chiến đấu.
Dialogue: 0,0:06:27.41,0:06:31.79,Default,Oka,0,0,0,,Này, cậu có thể giải thích chuyện này là sao không?
Dialogue: 0,0:06:33.25,0:06:34.17,Default,Yuk,0,0,0,,Dạ thì...
Dialogue: 0,0:06:34.17,0:06:38.17,Default,Sud,0,0,0,,Chị Yuki-nee chẳng khác nào đại tỷ của cả băng bọn tôi vậy.
Dialogue: 0,0:06:38.17,0:06:39.30,Default,All,0,0,0,,Đại tỷ á?!
Dialogue: 0,0:06:39.30,0:06:42.76,Default,Sud,0,0,0,,Tất cả bọn tôi đều chịu ơn chăm sóc của chị Yuki-nee.
Dialogue: 0,0:06:43.05,0:06:45.43,Default,Sud,0,0,0,,Chẳng hạn như việc băng bó chăm sóc sau những trận đánh nhau.
Dialogue: 0,0:06:45.81,0:06:47.56,Default,Sud,0,0,0,,Không chỉ riêng bọn tôi đâu—
Dialogue: 0,0:06:47.93,0:06:49.89,Default,Guy,0,0,0,,Biết ngay là mày sẽ trốn ở đây mà, Sudou!
Dialogue: 0,0:06:49.89,0:06:51.31,Default,Sud,0,0,0,,Mày bám theo tao đến tận đây à?
Dialogue: 0,0:06:52.65,0:06:55.65,Default,Guy,0,0,0,,Mày chỉ có thể chui rúc ở cái xó này thôi.
Dialogue: 0,0:06:55.65,0:06:56.48,Default,Guy,0,0,0,,Liệu hồn mà nạp mạng đi!
Dialogue: 0,0:06:56.48,0:06:57.61,Default,Yuk,0,0,0,,Xin hai anh đợi một chút đã!
Dialogue: 0,0:06:58.40,0:07:02.16,Default,Guy,0,0,0,,Chị Yukine. Tôi không có ý định làm phiền chị đâu.
Dialogue: 0,0:07:02.16,0:07:05.16,Default,Guy,0,0,0,,Người của bọn tôi cũng từng được chị chăm sóc biết bao nhiêu lần rồi.
Dialogue: 0,0:07:05.16,0:07:07.04,Default,Sud,0,0,0,,Xin lỗi chị Yuki-nee.
Dialogue: 0,0:07:07.04,0:07:11.25,Default,Sud,0,0,0,,Một khi đã đến nước này thì chẳng ai can ngăn được nữa đâu.
Dialogue: 0,0:07:11.25,0:07:14.71,Default,Sud,0,0,0,,Bước ra ngoài mau! Đánh nhau ở đây làm phiền chị Yuki-nee!
Dialogue: 0,0:07:14.71,0:07:16.38,Default,Guy,0,0,0,,Được thôi, ra ngoài!
Dialogue: 0,0:07:16.38,0:07:18.26,Default,Guy,0,0,0,,Xin lỗi vì đã làm phiền chị nhé, chị Yukine.
Dialogue: 0,0:07:20.88,0:07:27.01,Default,Sud,0,0,0,,Chị Yuki-nee, nếu có thằng ngốc nào giống tôi mò vào đây,\Nnhờ chị chăm sóc cho nó giùm nhé.
Dialogue: 0,0:07:27.01,0:07:27.81,Default,Sud,0,0,0,,Chào chị, tôi đi đây!
Dialogue: 0,0:07:29.06,0:07:30.23,Default,Yuk,0,0,0,,Anh Sudou!
Dialogue: 0,0:07:37.69,0:07:42.20,Default,Yuk,0,0,0,,Anh trai mình là thủ lĩnh băng đảng mà anh Sudou đang tham gia.
Dialogue: 0,0:07:42.20,0:07:45.12,Default,Oka,0,0,0,,À phải rồi, cậu từng kể là có một ông anh trai rất đáng sợ.
Dialogue: 0,0:07:46.62,0:07:51.50,Default,Yuk,0,0,0,,Hiện tại trong thị trấn này có hai băng nhóm đang tranh giành địa bàn với nhau.
Dialogue: 0,0:07:52.16,0:07:57.63,Default,Yuk,0,0,0,,Một nhóm là của anh trai mình, còn nhóm kia là của người vừa tới lúc nãy.
Dialogue: 0,0:07:57.63,0:08:00.30,Default,Yuk,0,0,0,,Họ lấy con sông làm ranh giới chia đôi.
Dialogue: 0,0:08:01.92,0:08:08.43,Default,Yuk,0,0,0,,Sau khi anh trai mình lên làm thủ lĩnh,\Nhọ không dám dễ dàng vượt qua ranh giới nữa, nhưng...
Dialogue: 0,0:08:09.31,0:08:12.18,Default,Yuk,0,0,0,,...những vụ đụng độ nhỏ lẻ vẫn diễn ra mỗi ngày.
Dialogue: 0,0:08:12.68,0:08:16.98,Default,Nag,0,0,0,,Anh trai cậu là người đáng sợ đến thế sao?
Dialogue: 0,0:08:17.27,0:08:20.15,Default,Yuk,0,0,0,,Nghe nói anh ấy chưa từng thua một trận đánh nào cả.
Dialogue: 0,0:08:20.61,0:08:25.53,Default,Yuk,0,0,0,,Anh ấy luôn giấu kín danh tính và nơi ở để tránh bị kẻ địch đánh lén sau lưng.
Dialogue: 0,0:08:25.95,0:08:28.03,Default,Sun,0,0,0,,Thủ lĩnh vô hình!
Dialogue: 0,0:08:28.03,0:08:29.58,Default,Sun,0,0,0,,Ngầu lòi thế không biết!
Dialogue: 0,0:08:29.58,0:08:32.95,Default,Nag,0,0,0,,Anh trai cậu tên là gì vậy?
Dialogue: 0,0:08:32.95,0:08:33.83,Default,Yuk,0,0,0,,Anh ấy tên là Kazuto.
Dialogue: 0,0:08:33.83,0:08:35.58,Default,Yuk,0,0,0,,Miyazawa Kazuto.
Dialogue: 0,0:08:35.58,0:08:36.54,Default,Kid,0,0,0,,Đứng im đấy!
Dialogue: 0,0:08:36.54,0:08:37.54,Default,Oka,0,0,0,,Miyazawa?
Dialogue: 0,0:08:37.54,0:08:39.29,Default,Kid,0,0,0,,Chị là Miyazawa Yukine phải không?!
Dialogue: 0,0:08:39.29,0:08:40.55,Default,Kid,0,0,0,,Mau trả chị gái lại cho tôi!
Dialogue: 0,0:08:40.55,0:08:44.55,Default,Oka,0,0,0,,Cái gì thế này? Nhóc đi cùng phe với gã lúc nãy à?
Dialogue: 0,0:08:50.39,0:08:53.14,Default,Yuk,0,0,0,,Xin cậu hãy bình tĩnh lại đã, Okazaki-san.
Dialogue: 0,0:08:53.93,0:08:54.85,Default,Yuk,0,0,0,,Ngoan nào.
Dialogue: 0,0:08:55.89,0:08:57.94,Default,Kid,0,0,0,,Làm cái gì đấy hả? Thả tôi ra!
Dialogue: 0,0:08:57.94,0:08:59.52,Default,Kid,0,0,0,,Thả tôi ra mau!
Dialogue: 0,0:09:06.45,0:09:08.45,Default,Yuk,0,0,0,,Chúng mình nói chuyện đàng hoàng nhé.
Dialogue: 0,0:09:08.45,0:09:12.49,Default,Yuk,0,0,0,,Chị có quen chị gái của em sao?
Dialogue: 0,0:09:13.20,0:09:17.58,Default,Kid,0,0,0,,Đ-Đừng có giả ngây giả ngô với tôi!\NTôi biết thừa chị là trùm sò của cái băng đảng đó!
Dialogue: 0,0:09:18.21,0:09:20.96,Default,Sun,0,0,0,,Bớt làm ra vẻ ngầu đời đi nhóc con.
Dialogue: 0,0:09:22.09,0:09:23.30,Default,Kid,0,0,0,,Anh là ai thế?
Dialogue: 0,0:09:24.13,0:09:26.80,Default,Kid,0,0,0,,Tôi biết rồi. Anh chắc chắn là Miyazawa Kazuto chứ gì.
Dialogue: 0,0:09:27.38,0:09:30.43,Default,Kid,0,0,0,,Tôi nghe nói Miyazawa Kazuto có mái tóc màu vàng hoe.
Dialogue: 0,0:09:30.43,0:09:33.93,Default,Kid,0,0,0,,Anh chính là kẻ thống trị nửa bên này của thị trấn đúng không?
Dialogue: 0,0:09:36.14,0:09:39.02,Default,Sun,0,0,0,,Đúng thế. Tao chính là Miyazawa Kazuto đây.
Dialogue: 0,0:09:39.94,0:09:41.36,Default,Yuk,0,0,0,,Nhưng mà...
Dialogue: 0,0:09:41.36,0:09:45.24,Default,Sun,0,0,0,,Không sao đâu. Cứ để anh lo, em gái yêu quý của anh.
Dialogue: 0,0:09:46.24,0:09:48.61,Default,Sun,0,0,0,,Để anh chơi với nhóc một chút nhé.
Dialogue: 0,0:09:48.61,0:09:51.49,Default,Sun,0,0,0,,Chính là ta, vị thủ lĩnh vô hình.
Dialogue: 0,0:09:52.95,0:09:55.45,Default,Nag,0,0,0,,Sunohara-san... Sao lại thế ạ?
Dialogue: 0,0:09:55.45,0:09:57.83,Default,Oka,0,0,0,,Nó chỉ muốn làm ra vẻ ta đây thôi.
Dialogue: 0,0:09:57.83,0:10:01.59,Default,Oka,0,0,0,,Cứ hễ gặp ai yếu thế hơn là nó lại lên mặt vênh váo hết mức có thể.
Dialogue: 0,0:10:02.42,0:10:07.13,Default,Yuk,0,0,0,,Dạ, hay là chúng mình tìm chỗ nào đó ngồi nói chuyện được không ạ?
Dialogue: 0,0:10:10.01,0:10:12.39,Default,Sun,0,0,0,,Sao lại phải kéo nhau về phòng tao thế này?
Dialogue: 0,0:10:12.39,0:10:15.06,Default,Oka,0,0,0,,Thủ lĩnh thì việc gì phải câu nệ tiểu tiết.
Dialogue: 0,0:10:15.60,0:10:17.77,Default,Miy,0,0,0,,Em tên là Yu-kun đúng không?
Dialogue: 0,0:10:17.77,0:10:21.23,Default,Miy,0,0,0,,Trước tiên để chị giới thiệu mọi người cho em làm quen nhé.
Dialogue: 0,0:10:21.86,0:10:24.32,Default,Miy,0,0,0,,Chị là Miyazawa Yukine.
Dialogue: 0,0:10:24.32,0:10:25.44,Default,Miy,0,0,0,,Xin chào em.
Dialogue: 0,0:10:25.44,0:10:26.69,Default,Kid,0,0,0,,X-Xin chào chị.
Dialogue: 0,0:10:27.44,0:10:31.91,Default,Miy,0,0,0,,Còn đây là anh Okazaki Tomoya và chị Furukawa Nagisa.
Dialogue: 0,0:10:32.24,0:10:33.53,Default,All,0,0,0,,Chào em.
Dialogue: 0,0:10:33.53,0:10:36.20,Default,Miy,0,0,0,,Em ngoan và lễ phép lắm đấy, Yu-kun.
Dialogue: 0,0:10:36.20,0:10:38.66,Default,Kid,0,0,0,,Đ-Đừng có nịnh bợ tôi.
Dialogue: 0,0:10:38.66,0:10:42.79,Default,Sun,0,0,0,,Tao đã hy vọng một màn đụng độ máu lửa hơn cơ.
Dialogue: 0,0:10:42.79,0:10:47.46,Default,Miy,0,0,0,,Nếu chị không nhầm thì chị gái em vừa mới bỏ nhà đi đúng không?
Dialogue: 0,0:10:47.46,0:10:50.55,Default,Kid,0,0,0,,Chị ấy trốn khỏi nhà rồi gia nhập vào băng nhóm của các người.
Dialogue: 0,0:10:51.26,0:10:56.85,Default,Kid,0,0,0,,Tôi hỏi anh của bạn tôi, anh ấy bảo thủ lĩnh của nhóm là nhóc nhà Miyazawa,
Dialogue: 0,0:10:56.85,0:10:59.81,Default,Kid,0,0,0,,còn cô em gái thì đang học ở Trường Cấp ba Hikarizaka.
Dialogue: 0,0:10:59.81,0:11:02.94,Default,Oka,0,0,0,,Nên nhóc mới mò đến tận đây để đòi lại chị gái à?
Dialogue: 0,0:11:02.94,0:11:05.32,Default,Nag,0,0,0,,Em dũng cảm thật đấy, Yu-kun.
Dialogue: 0,0:11:05.65,0:11:08.28,Default,Kid,0,0,0,,Miyazawa Kazuto là thủ lĩnh vô hình,
Dialogue: 0,0:11:08.28,0:11:11.28,Default,Kid,0,0,0,,nghe nói chỉ có người trong bang mới biết mặt mũi anh ta thế nào.
Dialogue: 0,0:11:11.28,0:11:14.91,Default,Kid,0,0,0,,Chính vì thế tôi mới tìm đến nói chuyện với cô em gái.
Dialogue: 0,0:11:15.91,0:11:17.99,Default,Sun,0,0,0,,Chị gái nhóc năm nay bao nhiêu tuổi rồi?
Dialogue: 0,0:11:18.37,0:11:21.16,Default,Kid,0,0,0,,Hình như chị ấy hai mươi mốt tuổi rồi ạ.
Dialogue: 0,0:11:23.88,0:11:27.46,Default,Kid,0,0,0,,Mấy hôm trước chị ấy gọi điện về bảo sẽ không về nhà một thời gian.
Dialogue: 0,0:11:27.46,0:11:30.01,Default,Kid,0,0,0,,Bảo là sẽ tự thuê một căn hộ rồi dọn ra sống tự lập.
Dialogue: 0,0:11:30.51,0:11:33.34,Default,Oka,0,0,0,,Chuyện đó có gì đáng để lo đâu chứ?
Dialogue: 0,0:11:33.34,0:11:37.26,Default,Sun,0,0,0,,Rõ ràng nhóc chỉ mắc chứng cuồng chị gái thôi mà.
Dialogue: 0,0:11:37.26,0:11:38.47,Default,Kid,0,0,0,,Cuồng chị gái á?
Dialogue: 0,0:11:38.47,0:11:42.98,Default,Sun,0,0,0,,Hai mươi mốt tuổi dọn ra khỏi nhà thì người ta gọi là tự lập đấy nhóc.
Dialogue: 0,0:11:42.98,0:11:45.19,Default,Sun,0,0,0,,Trẻ con như nhóc chẳng việc gì phải lo lắng hão huyền.
Dialogue: 0,0:11:45.19,0:11:48.61,Default,Kid,0,0,0,,Nhưng chị ấy đang hẹn hò với một tên du côn trong băng đảng!
Dialogue: 0,0:11:49.23,0:11:56.53,Default,Miy,0,0,0,,À thì, chị không biết người ta đã kể gì cho em nghe,\Nnhưng bạn bè của chị không phải là người xấu đâu.
Dialogue: 0,0:11:57.03,0:12:02.37,Default,Miy,0,0,0,,Họ có hơi nóng tính và hay đánh nhau một chút, nhưng ai nấy đều rất trượng nghĩa.
Dialogue: 0,0:12:02.37,0:12:05.83,Default,Oka,0,0,0,,Thế còn bọn anh thì sao? Trông bọn anh giống người xấu lắm à?
Dialogue: 0,0:12:06.29,0:12:07.75,Default,Kid,0,0,0,,Anh thì giống thật.
Dialogue: 0,0:12:08.38,0:12:10.38,Default,Kid,0,0,0,,Còn chị kia thì trông như người tốt.
Dialogue: 0,0:12:11.01,0:12:13.05,Default,Nag,0,0,0,,Cảm ơn em nhiều nhé.
Dialogue: 0,0:12:13.05,0:12:14.47,Default,Oka,0,0,0,,Chẳng đáng yêu chút nào...
Dialogue: 0,0:12:14.47,0:12:17.35,Default,Sun,0,0,0,,Yu này. Nhóc giống như một hạt giống hoa vậy.
Dialogue: 0,0:12:18.81,0:12:21.35,Default,Sun,0,0,0,,Nhóc sẽ được cơn gió cuốn bay đi và bắt đầu cuộc hành trình của riêng mình.
Dialogue: 0,0:12:21.35,0:12:24.85,Default,Sun,0,0,0,,Nhóc đang trên đường gặp gỡ những con người mới ở những chân trời mới đấy.
Dialogue: 0,0:12:25.19,0:12:28.23,Default,Kid,0,0,0,,Gặp gỡ những con người mới ở những chân trời mới sao ạ?
Dialogue: 0,0:12:28.69,0:12:31.28,Default,Sun,0,0,0,,Nhóc không thể cứ mãi bám váy làm nũng chị gái được nữa đâu.
Dialogue: 0,0:12:31.74,0:12:34.28,Default,Sun,0,0,0,,Dù có xa cách nhau thì giữa hai người vẫn có một sợi dây liên kết vô hình.
Dialogue: 0,0:12:34.28,0:12:36.66,Default,Sun,0,0,0,,Đó chính là gia đình đấy!
Dialogue: 0,0:12:38.12,0:12:41.29,Default,Oka,0,0,0,,Thằng Sunohara hôm nay nói chuyện ra dáng đàn anh ghê nhỉ.
Dialogue: 0,0:12:41.29,0:12:46.00,Default,Nag,0,0,0,,Chắc là sau vụ của Mei-chan cậu ấy đã suy nghĩ thấu đáo nhiều điều rồi đấy.
Dialogue: 0,0:12:46.00,0:12:53.88,Default,Yuk,0,0,0,,Nhưng chị chắc là không biết chị gái ở đâu thì em lo lắm, để chị đi hỏi bạn bè xem nhé.
Dialogue: 0,0:12:53.88,0:12:55.51,Default,Yuk,0,0,0,,Như thế có được không em?
Dialogue: 0,0:12:56.84,0:12:57.64,Default,Kid,0,0,0,,Dạ được ạ.
Dialogue: 0,0:13:00.64,0:13:03.06,Default,Kid,0,0,0,,Xin chị hãy tìm giúp chị gái em với.
Dialogue: 0,0:13:03.06,0:13:04.68,Default,Kid,0,0,0,,Em cảm ơn chị nhiều lắm ạ.
Dialogue: 0,0:13:04.68,0:13:07.52,Default,Miy,0,0,0,,Ừ. Chị sẽ cố gắng hết sức.
Dialogue: 0,0:13:07.52,0:13:10.61,Default,Oka,0,0,0,,Mọi chuyện được giải quyết êm đẹp rồi.
Dialogue: 0,0:13:10.61,0:13:14.03,Default,Nag,0,0,0,,Em nghĩ đó là nhờ sức hút của chị Miyazawa đấy ạ.
Dialogue: 0,0:13:14.03,0:13:15.45,Default,Nag,0,0,0,,Chị ấy tuyệt vời thật đấy.
Dialogue: 0,0:13:20.24,0:13:22.54,Default,Oka,0,0,0,,Sao lại ra nông nỗi này thế này?
Dialogue: 0,0:13:23.37,0:13:27.25,Default,Sun,0,0,0,,Thằng nhóc muốn đi theo tao để học hỏi cách làm một người đàn ông đích thực.
Dialogue: 0,0:13:27.25,0:13:30.54,Default,Sun,0,0,0,,Cũng có bản lĩnh đấy chứ, dám cúp học để đi theo tao cơ mà.
Dialogue: 0,0:13:30.54,0:13:31.92,Default,Kid,0,0,0,,Cảm ơn đại ca đã nhận em làm đệ tử!
Dialogue: 0,0:13:31.92,0:13:35.34,Default,Sun,0,0,0,,Cứ nhìn vào đại ca đây, nhóc sẽ hiểu thế nào là một đấng nam nhi.
Dialogue: 0,0:13:35.34,0:13:37.01,Default,Sun,0,0,0,,Đừng có tụt lại đằng sau đấy.
Dialogue: 0,0:13:37.01,0:13:37.68,Default,Kid,0,0,0,,Dạ vâng!
Dialogue: 0,0:13:45.73,0:13:47.48,Default,Kid,0,0,0,,Ơ anh ơi, chuông reo rồi kìa.
Dialogue: 0,0:13:47.48,0:13:49.40,Default,Sun,0,0,0,,Ừ, reo rồi đấy.
Dialogue: 0,0:13:49.40,0:13:51.23,Default,Kid,0,0,0,,Không phải vào học rồi sao ạ?
Dialogue: 0,0:13:52.11,0:13:55.40,Default,Sun,0,0,0,,Miễn là nhóc hoàn thành tốt những việc cần làm, thì chẳng việc gì phải đến lớp cả.
Dialogue: 0,0:13:55.40,0:13:57.11,Default,Sun,0,0,0,,Đó chính là quy luật của xã hội.
Dialogue: 0,0:13:57.65,0:13:59.36,Default,Kid,0,0,0,,Thế anh ấy có hoàn thành việc cần làm không ạ?
Dialogue: 0,0:13:59.36,0:14:00.32,Default,Oka,0,0,0,,Không hề có một việc nào ra hồn cả.
Dialogue: 0,0:14:00.32,0:14:01.66,Default,Sun,0,0,0,,Mày cũng thế chứ khác gì!
Dialogue: 0,0:14:01.66,0:14:04.29,Default,Oka,0,0,0,,Dạo này tao đi học đầy đủ và đúng giờ lắm rồi nhé.
Dialogue: 0,0:14:04.58,0:14:06.75,Default,Oka,0,0,0,,Tao ở đây là vì hai đứa tụi mày thôi.
Dialogue: 0,0:14:06.75,0:14:09.50,Default,Kid,0,0,0,,Chẳng lẽ hai anh là lũ ăn hại cúp cua sao ạ?
Dialogue: 0,0:14:09.50,0:14:11.88,Default,Oka,0,0,0,,Thằng đó thì đúng đấy, còn anh thì không.
Dialogue: 0,0:14:11.88,0:14:13.46,Default,Sun,0,0,0,,Mày bớt vạch áo cho người xem lưng đi!
Dialogue: 0,0:14:13.46,0:14:15.51,Default,Sun,0,0,0,,Mày đang làm mất hết thể diện của người thầy đấy!
Dialogue: 0,0:14:15.51,0:14:17.26,Default,Oka,0,0,0,,Mày tính dạy nó bài học bằng cái trò này đấy à?
Dialogue: 0,0:14:17.26,0:14:19.84,Default,Sun,0,0,0,,Mày từng nghe nói đến những tấm gương xấu phản diện chưa?
Dialogue: 0,0:14:19.84,0:14:22.30,Default,Sun,0,0,0,,Tao đang cố làm một tấm gương phản diện cho nó noi theo đấy.
Dialogue: 0,0:14:22.30,0:14:24.56,Default,Oka,0,0,0,,Mày có hiểu từ đó nghĩa là gì không đấy?
Dialogue: 0,0:14:24.56,0:14:28.14,Default,Sun,0,0,0,,Không, nhưng nghe từ đó ngầu vãi chưởng đúng không?
Dialogue: 0,0:14:29.89,0:14:31.69,Default,Oka,0,0,0,,Này, có người đang đến kìa.
Dialogue: 0,0:14:32.65,0:14:33.77,Default,Teacher,0,0,0,,Có ai ở trong này không đấy?
Dialogue: 0,0:14:44.91,0:14:46.20,Default,Oka,0,0,0,,Thằng ngu này.
Dialogue: 0,0:14:46.20,0:14:47.79,Default,Oka,0,0,0,,Bị bắt quả tang dễ như ăn kẹo vậy.
Dialogue: 0,0:14:47.79,0:14:50.04,Default,Teacher,0,0,0,,Vào giờ học rồi mà sao còn ở đây hả các em?
Dialogue: 0,0:14:50.54,0:14:54.88,Default,Sun,0,0,0,,Em xin lỗi thầy. Em chơi trốn tìm mải mê quá nên quên mất giờ giấc.
Dialogue: 0,0:14:54.88,0:14:56.42,Default,Teacher,0,0,0,,Trốn tìm á?
Dialogue: 0,0:14:56.42,0:14:57.88,Default,Teacher,0,0,0,,Nghĩa là vẫn còn đứa khác đang trốn à?
Dialogue: 0,0:14:58.34,0:15:01.51,Default,Sun,0,0,0,,Này Okazaki. Ra đây đi mày.
Dialogue: 0,0:15:01.89,0:15:03.14,Default,Oka,0,0,0,,Chán thật đấy.
Dialogue: 0,0:15:04.47,0:15:06.47,Default,Nag,0,0,0,,Sau đó thì chuyện gì xảy ra ạ?
Dialogue: 0,0:15:06.47,0:15:10.60,Default,Oka,0,0,0,,Bọn tớ bị lôi lên phòng giám thị chịu trận và bị mắng cho té tát.
Dialogue: 0,0:15:10.60,0:15:14.02,Default,Sun,0,0,0,,Ai bảo mỗi mình tao bị bắt làm chi cho bất công.
Dialogue: 0,0:15:14.02,0:15:16.69,Default,Kid,0,0,0,,Này anh, đây cũng là một phần của sự nam tính sao ạ?
Dialogue: 0,0:15:16.69,0:15:19.82,Default,Oka,0,0,0,,Với tư cách là một tấm gương phản diện thì nó làm xuất sắc lắm đấy.
Dialogue: 0,0:15:19.82,0:15:20.57,Default,Sun,0,0,0,,Cũng có thể nói là như vậy đấy.
Dialogue: 0,0:15:22.74,0:15:24.87,Default,Miy,0,0,0,,Chị liên lạc được rồi nhé.
Dialogue: 0,0:15:24.87,0:15:28.20,Default,Miy,0,0,0,,Chị biết chỗ ở của chị gái em rồi.
Dialogue: 0,0:15:31.50,0:15:35.17,Default,Miy,0,0,0,,Chị gái em cũng đang rất muốn gặp em đấy.
Dialogue: 0,0:15:35.71,0:15:39.88,Default,Miy,0,0,0,,Chị ấy bảo sẽ đợi ở cửa hàng nơi mọi người hay tụ tập.
Dialogue: 0,0:15:39.88,0:15:41.88,Default,Kid,0,0,0,,Em cảm ơn chị Yukine nhiều lắm ạ!
Dialogue: 0,0:15:42.47,0:15:45.14,Default,Sun,0,0,0,,Tại sao bọn mình cũng phải đi cùng chứ?
Dialogue: 0,0:15:45.14,0:15:47.68,Default,Sun,0,0,0,,Tao không muốn bị lôi vào một trận đánh nhau nào nữa đâu.
Dialogue: 0,0:15:47.68,0:15:52.35,Default,Oka,0,0,0,,Lúc có chuyện gì thì đại ca Kazuto sẽ ra tay giải quyết hết mà, đúng không đại ca?
Dialogue: 0,0:15:52.73,0:15:56.31,Default,Kid,0,0,0,,Lúc kẻ xấu xuất hiện,\Nnhờ đại ca Kazuto đập cho chúng một trận tơi bời nhé.
Dialogue: 0,0:15:57.94,0:16:00.40,Default,Sun,0,0,0,,Đừng có kỳ vọng vào tao quá như thế chứ.
Dialogue: 0,0:16:08.74,0:16:11.58,Default,Nag,0,0,0,,Đây là lần đầu tiên em đến một nơi như thế này đấy ạ.
Dialogue: 0,0:16:11.87,0:16:16.13,Default,Yuk,0,0,0,,Không sao đâu em. Mọi người ở đây thân thiện lắm.
Dialogue: 0,0:16:16.13,0:16:22.13,Default,Sun,0,0,0,,Nghĩ kỹ lại thì, đến đây sẽ bị lộ việc tao không phải anh trai của Yukine-chan đúng không?
Dialogue: 0,0:16:22.13,0:16:24.43,Default,Oka,0,0,0,,Giờ mày mới nhận ra đấy à?
Dialogue: 0,0:16:24.43,0:16:24.97,Default,Sun,0,0,0,,Tao đi về đây!
Dialogue: 0,0:16:25.34,0:16:27.10,Default,Sun,0,0,0,,Chúng ta đã đi xa đến nước này rồi.
Dialogue: 0,0:16:27.10,0:16:28.10,Default,Sun,0,0,0,,Hãy đi cùng chúng tôi.
Dialogue: 0,0:16:29.35,0:16:30.60,Default,Miy,0,0,0,,Em chào mọi người ạ.
Dialogue: 0,0:16:31.31,0:16:32.31,Default,Guys,0,0,0,,Chị Yuki-nee!
Dialogue: 0,0:16:32.81,0:16:34.44,Default,Guys,0,0,0,,Lâu lắm mới gặp chị, chị Yuki-nee.
Dialogue: 0,0:16:34.44,0:16:36.19,Default,Guys,0,0,0,,Bọn tôi đợi chị mãi đấy, chị Yuki-nee.
Dialogue: 0,0:16:36.19,0:16:38.27,Default,Miy,0,0,0,,Gặp lại mọi người khỏe mạnh thế này em mừng quá.
Dialogue: 0,0:16:39.94,0:16:40.53,Default,Kid,0,0,0,,Chị hai ơi!
Dialogue: 0,0:16:41.48,0:16:42.32,Default,Onee,0,0,0,,Yu đấy à!
Dialogue: 0,0:16:45.74,0:16:48.03,Default,Kid,0,0,0,,Em lo cho chị hai muốn chết luôn đấy!
Dialogue: 0,0:16:48.03,0:16:51.45,Default,Onee,0,0,0,,Chị xin lỗi nhé. Chị vẫn sống tốt mà.
Dialogue: 0,0:16:51.45,0:16:53.37,Default,Guys,0,0,0,,Đó là em trai em đấy à?
Dialogue: 0,0:16:53.37,0:16:54.58,Default,Guys,0,0,0,,Dễ thương ghê.
Dialogue: 0,0:16:54.58,0:16:57.54,Default,Guys,0,0,0,,Gương mặt trông sáng sủa và cứng cỏi đấy chứ.
Dialogue: 0,0:16:57.54,0:16:59.92,Default,Guys,0,0,0,,Sao nào? Làm một ly mừng ngày đoàn tụ không em trai?
Dialogue: 0,0:16:59.92,0:17:01.84,Default,Miy,0,0,0,,Không được cho trẻ con uống rượu đâu đấy.
Dialogue: 0,0:17:01.84,0:17:03.46,Default,Guys,0,0,0,,Tôi chỉ nói đùa tí thôi mà.
Dialogue: 0,0:17:03.46,0:17:07.84,Default,Nag,0,0,0,,Có vẻ như anh Sudou đã làm lành lại với tất cả mọi người rồi.
Dialogue: 0,0:17:07.84,0:17:10.43,Default,Oka,0,0,0,,Miyazawa được mọi người yêu mến ghê nhỉ.
Dialogue: 0,0:17:10.43,0:17:15.48,Default,Guy,0,0,0,,Chị Yuki-nee chữa trị cho bất cứ ai bị thương, bất kể là bạn hay thù.
Dialogue: 0,0:17:15.48,0:17:18.60,Default,Guy,0,0,0,,Rất nhiều người trong số bọn tôi từng được chị ấy chăm sóc sau các trận đánh.
Dialogue: 0,0:17:18.60,0:17:20.23,Default,Oka,0,0,0,,Anh là người hôm trước đúng không?
Dialogue: 0,0:17:20.23,0:17:24.69,Default,Guy,0,0,0,,Ừ. Xin lỗi vì hôm đó chưa kịp giới thiệu đàng hoàng nhé.
Dialogue: 0,0:17:24.69,0:17:26.99,Default,Nag,0,0,0,,Dạ không, bọn em cũng vậy ạ.
Dialogue: 0,0:17:28.16,0:17:30.45,Default,Guy,0,0,0,,Còn cậu bạn đằng kia là ai thế?
Dialogue: 0,0:17:31.03,0:17:33.91,Default,Sun,0,0,0,,Thân phận thấp hèn của tôi không xứng đáng để xưng tên đâu ạ.
Dialogue: 0,0:17:41.00,0:17:42.88,Default,Kid,0,0,0,,Anh làm cái trò gì thế hả anh Kazuto?
Dialogue: 0,0:17:46.76,0:17:47.93,Default,Oka,0,0,0,,Cái gì cơ?
Dialogue: 0,0:17:51.72,0:17:55.10,Default,Guy,0,0,0,,Mày vẫn còn dám bén mảng đến làm phiền chị Yuki-nee à?!
Dialogue: 0,0:17:55.10,0:17:57.73,Default,Sun,0,0,0,,Em xin lỗi! Em xin lỗi mà! Em chỉ là bạn của chị ấy thôi ạ!
Dialogue: 0,0:17:57.73,0:18:00.40,Default,Kid,0,0,0,,Anh ta không phải là anh Miyazawa Kazuto sao ạ?
Dialogue: 0,0:18:01.06,0:18:03.48,Default,Kid,0,0,0,,Sao cơ? Hóa ra từ nãy đến giờ anh toàn lừa tôi à?
Dialogue: 0,0:18:04.15,0:18:09.03,Default,Sun,0,0,0,,T-Tại vì anh ở câu lạc bộ kịch,\Nnên anh mới muốn tập diễn xuất một tí thôi mà.
Dialogue: 0,0:18:09.03,0:18:12.08,Default,Guys,0,0,0,,Mày dám to gan mạo danh cả anh Kazuto cơ đấy.
Dialogue: 0,0:18:12.08,0:18:13.45,Default,Guys,0,0,0,,Thằng ranh con cặn bã này.
Dialogue: 0,0:18:13.45,0:18:16.95,Default,Guys,0,0,0,,Nếu mày không phải là bạn của chị Yuki-nee thì mày đã no đòn từ nãy rồi.
Dialogue: 0,0:18:16.95,0:18:23.59,Default,Onee,0,0,0,,Thôi mọi người bình tĩnh đi. Dù sao cậu ấy cũng đã chăm sóc cho em trai tôi, tha cho cậu ấy đi.
Dialogue: 0,0:18:23.59,0:18:25.59,Default,Kid,0,0,0,,Từ giờ đại ca không được làm thế nữa đâu đấy nhé?
Dialogue: 0,0:18:26.67,0:18:29.84,Default,Sun,0,0,0,,Đại ca! Đại tỷ! Tiểu đệ xin nguyện theo hai người suốt đời suốt kiếp!
Dialogue: 0,0:18:30.89,0:18:34.39,Default,Miy,0,0,0,,Hôm qua chị vừa nghe Yu-kun kể chuyện.
Dialogue: 0,0:18:34.72,0:18:38.98,Default,Miy,0,0,0,,Gia đình em ấy đang gặp mâu thuẫn giữa cha mẹ và con cái.
Dialogue: 0,0:18:39.39,0:18:45.36,Default,Miy,0,0,0,,Hôm nọ chị gái em ấy bỏ nhà đi cũng là do cãi nhau một trận to với mẹ.
Dialogue: 0,0:18:46.61,0:18:50.82,Default,Miy,0,0,0,,Nhiều người ở đây cũng không có mối quan hệ tốt đẹp với bố mẹ mình.
Dialogue: 0,0:18:51.82,0:18:57.41,Default,Miy,0,0,0,,Họ không tìm thấy chỗ đứng cho mình trong chính ngôi nhà của mình, nên mới tìm đến những nơi như thế này.
Dialogue: 0,0:18:57.87,0:19:02.08,Default,Nag,0,0,0,,Vậy nên đối với họ, nơi này chẳng khác nào ngôi nhà thứ hai của mình.
Dialogue: 0,0:19:02.67,0:19:04.21,Default,Miy,0,0,0,,Anh trai mình ngày xưa cũng như vậy đấy.
Dialogue: 0,0:19:04.21,0:19:08.21,Default,Miy,0,0,0,,Anh ấy không hòa hợp được với bố mẹ mình cho lắm.
Dialogue: 0,0:19:08.97,0:19:15.97,Default,Oka,0,0,0,,Tôi từng nghe nói rằng khi có một nhóm bạn bè gắn kết như gia đình, người ta sẽ không bị lầm đường lạc lối quá xa.
Dialogue: 0,0:19:16.68,0:19:22.10,Default,Oka,0,0,0,,Hình như nhà cô ấy quan hệ giữa cha mẹ và con cái rất tệ hại, và không khí gia đình thì lạnh lẽo vô cùng.
Dialogue: 0,0:19:22.48,0:19:24.86,Default,Miy,0,0,0,,Thế giờ cô ấy ra sao rồi?
Dialogue: 0,0:19:25.73,0:19:29.15,Default,Oka,0,0,0,,Trải qua biết bao chuyện thì hiện giờ gia đình họ đã êm ấm lại rồi.
Dialogue: 0,0:19:29.61,0:19:32.74,Default,Miy,0,0,0,,Thế thì tốt quá rồi.
Dialogue: 0,0:19:34.41,0:19:37.03,Default,Guy,0,0,0,,Cậu em này trông vui tính phết nhỉ.
Dialogue: 0,0:19:37.03,0:19:38.16,Default,Sun,0,0,0,,Th-Thế ạ?
Dialogue: 0,0:19:38.16,0:19:39.50,Default,Miy,0,0,0,,Mời mọi người dùng bữa.
Dialogue: 0,0:19:40.79,0:19:42.58,Default,Nag,0,0,0,,Em cảm ơn chị nhiều ạ.
Dialogue: 0,0:19:40.96,0:19:41.71,Default-alt,Oka,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:19:42.58,0:19:43.33,Default,Miy,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:19:43.71,0:19:47.50,Default,Nag,0,0,0,,Dạ, hôm nay anh Kazuto không ghé qua đây sao ạ?
Dialogue: 0,0:19:48.09,0:19:49.26,Default,Miy,0,0,0,,Anh trai mình ấy hả?
Dialogue: 0,0:19:49.26,0:19:52.09,Default,Sud,0,0,0,,Anh Kazuto hiện đang phải nằm trong bệnh viện rồi.
Dialogue: 0,0:19:52.59,0:19:55.68,Default,Sud,0,0,0,,Anh ấy cứu một người bạn nên bị tai nạn giao thông.
Dialogue: 0,0:19:55.68,0:19:57.05,Default,Oka,0,0,0,,Tai nạn giao thông á?
Dialogue: 0,0:19:57.51,0:20:03.94,Default,Guy,0,0,0,,Anh Kazuto từng là nhân viên làm việc ở đây,\Nnhưng giờ thì mấy anh em bọn tôi thay nhau quán xuyến quán.
Dialogue: 0,0:20:05.02,0:20:08.57,Default,Miy,0,0,0,,Thỉnh thoảng mình cũng vào bếp phụ giúp một tay nữa.
Dialogue: 0,0:20:08.57,0:20:12.65,Default,Nag,0,0,0,,Càng nghe kể lại càng thấy anh Kazuto là một người tuyệt vời ghê.
Dialogue: 0,0:20:12.65,0:20:18.87,Default,Sud,0,0,0,,Đúng thế đấy. Nhờ có anh ấy mà bọn tôi mới sống đàng hoàng mà không bị sa ngã.
Dialogue: 0,0:20:18.87,0:20:20.66,Default,Oka,0,0,0,,Ở đây có tấm ảnh nào của anh ấy không?
Dialogue: 0,0:20:20.66,0:20:22.75,Default,Oka,0,0,0,,Tôi muốn xem mặt mũi anh ấy trông như thế nào.
Dialogue: 0,0:20:22.75,0:20:28.96,Default,Miy,0,0,0,,Mình không có ảnh của anh ấy,\Nnhưng ai cũng bảo là mình trông rất giống anh ấy.
Dialogue: 0,0:20:29.38,0:20:30.67,Default,Oka,0,0,0,,Cậu giống anh ấy á?
Dialogue: 0,0:20:30.67,0:20:31.38,Default,Miy,0,0,0,,Vâng.
Dialogue: 0,0:20:37.89,0:20:39.85,Default,Nag,0,0,0,,Hôm nay vui thật đấy.
Dialogue: 0,0:20:39.85,0:20:42.27,Default,Sun,0,0,0,,Tuổi thọ của tao vừa bị hao hụt đi mất vài năm rồi đấy.
Dialogue: 0,0:20:42.27,0:20:46.44,Default,Oka,0,0,0,,Mày nên thấy vui vẻ mới phải chứ, dù sao cũng được làm trùm sò một phen cơ mà.
Dialogue: 0,0:20:49.32,0:20:50.98,Default,Guy,0,0,0,,Mày chính là Miyazawa Kazuto đúng không hả?!
Dialogue: 0,0:20:50.98,0:20:52.32,Default,Sun,0,0,0,,Hả? Tao á?!
Dialogue: 0,0:20:52.32,0:20:56.57,Default,Guy,0,0,0,,Cuối cùng cũng tóm được mày! Không ngờ mày đã xuất viện rồi đấy!
Dialogue: 0,0:20:56.57,0:20:58.45,Default,Guy,0,0,0,,Hôm nay chúng ta sẽ thanh toán sòng phẳng món nợ một lần cho xong!
Dialogue: 0,0:20:59.08,0:21:00.16,Default,Sun,0,0,0,,Các anh nhận nhầm người rồi!
Dialogue: 0,0:21:00.16,0:21:01.83,Default,Miy,0,0,0,,Xin các anh dừng lại đã! Cậu ấy—
Dialogue: 0,0:21:01.83,0:21:04.62,Default,Guy,0,0,0,,Chị Yukine, xin lỗi nhưng lần này chị không cản được bọn tôi đâu.
Dialogue: 0,0:21:04.62,0:21:06.87,Default,Guy,0,0,0,,Đừng làm tổn thương chị Yukine và bạn nữ kia.
Dialogue: 0,0:21:06.87,0:21:07.67,Default,Guy,0,0,0,,Xông lên, bắt lấy nó!
Dialogue: 0,0:21:07.67,0:21:09.04,Default,Oka,0,0,0,,Chết tiệt. Chạy mau thôi!
Dialogue: 0,0:21:10.46,0:21:10.92,Default,Sun,0,0,0,,Chờ tao với!
Dialogue: 0,0:21:18.89,0:21:21.97,Default,Guys,0,0,0,,C-Cái quái gì vừa xảy ra thế này?!
Dialogue: 0,0:21:21.97,0:21:25.06,Default,Guys,0,0,0,,Đó là sức mạnh của Miyazawa Kazuto đấy sao?!
Dialogue: 0,0:21:25.06,0:21:26.35,Default,Guys,0,0,0,,Đáng sợ quá...
Dialogue: 0,0:21:26.35,0:21:29.06,Default,Guys,0,0,0,,Đó có phải là người nữa không trời...
Dialogue: 0,0:21:30.69,0:21:35.32,Default,Tom,0,0,0,,Chính mấy người tự dưng lao ầm ầm vào tôi cơ mà,\Nsao lại nói năng thô lỗ như thế hả?!
Dialogue: 0,0:21:35.32,0:21:36.65,Default,Nag,0,0,0,,Tomoyo-san!
Dialogue: 0,0:21:37.07,0:21:38.74,Default,Nag,0,0,0,,Cậu cứu bọn tớ một bàn thua trông thấy rồi.
Dialogue: 0,0:21:38.74,0:21:41.58,Default,Oka,0,0,0,,Cậu làm cái gì ở cái nơi thế này vậy?
Dialogue: 0,0:21:41.58,0:21:45.16,Default,Tom,0,0,0,,Tôi nghe nói gần đây quanh khu này thường xuyên xảy ra đánh nhau.
Dialogue: 0,0:21:45.71,0:21:49.75,Default,Tom,0,0,0,,Nên tôi đi tuần tra vì không muốn học sinh trường mình bị cuốn vào rắc rối.
Dialogue: 0,0:21:49.75,0:21:53.75,Default,Tom,0,0,0,,Còn mấy người nữa. Sao lại\Ndính líu đến đám người nguy hiểm như họ thế hả?
Dialogue: 0,0:21:54.30,0:21:56.97,Default,Nag,0,0,0,,Chuyện dài dòng lắm...
Dialogue: 0,0:21:58.18,0:22:02.31,Default,Sun,0,0,0,,Tao nghĩ là bọn chúng đang hiểu lầm tai hại trầm trọng rồi.
Dialogue: 0,0:22:02.31,0:22:03.51,Default,Oka,0,0,0,,Có vẻ là vậy đấy.
Dialogue: 0,0:22:05.81,0:22:09.77,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad3\pos(1459.999969,840)\bord0.75\3c&H000000&\blur0.5}Còn tiếp
