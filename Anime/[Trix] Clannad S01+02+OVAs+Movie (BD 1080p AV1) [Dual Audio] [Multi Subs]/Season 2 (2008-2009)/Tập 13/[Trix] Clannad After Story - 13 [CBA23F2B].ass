Dialogue: 0,0:03:42.41,0:03:44.58,Default,Aki,0,0,0,,Lâu lắm rồi mới thấy phấn khích thế này đấy.
Dialogue: 0,0:03:44.58,0:03:46.54,Default,Oka,0,0,0,,Tại sao mọi chuyện lại biến thành thế này chứ?
Dialogue: 0,0:03:46.54,0:03:51.22,Default,Aki,0,0,0,,Khu phố này gọi tao là 'Cy Young của tiệm bánh' đấy nhé.
Dialogue: 0,0:03:51.22,0:03:54.80,Default,Aki,0,0,0,,Ngon thì đánh trúng quả bóng thẳng 170 km/h của tao xem nào!
Dialogue: 0,0:03:54.80,0:03:58.47,Default,Oka,0,0,0,,Chú thừa biết là vai cháu bị thương rồi mà.
Dialogue: 0,0:03:58.47,0:04:02.14,Default,Aki,0,0,0,,Thế đứa nào là người đã kết liễu trận đấu đợt trước hả?
Dialogue: 0,0:04:02.14,0:04:04.94,Default,Aki,0,0,0,,Tao không ép mày phải đánh một cú home run.
Dialogue: 0,0:04:04.94,0:04:06.94,Default,Aki,0,0,0,,Chỉ cần đánh ra được một cú bóng ra trò là được.
Dialogue: 0,0:04:07.40,0:04:12.11,Default,Aki,0,0,0,,Miễn không phải là bóng lăn mặt đất hay bóng bổng đập lại thì tính là mày thắng.
Dialogue: 0,0:04:12.53,0:04:14.45,Default,Oka,0,0,0,,Chú chắc chắn về điều kiện đó chứ?
Dialogue: 0,0:04:14.45,0:04:17.74,Default,Aki,0,0,0,,Ừ. Nếu mày thắng, tao sẽ lắng nghe những gì mày muốn nói.
Dialogue: 0,0:04:17.74,0:04:18.95,Default,Oka,0,0,0,,Không chỉ dừng lại ở lắng nghe đâu.
Dialogue: 0,0:04:20.08,0:04:23.08,Default,Oka,0,0,0,,Chú phải hứa sẽ chấp thuận bất cứ điều gì cháu nói nữa.
Dialogue: 0,0:04:28.21,0:04:29.09,Default,Nag,0,0,0,,Tomoya—
Dialogue: 0,0:04:34.68,0:04:35.76,Default,Aki,0,0,0,,Được thôi.
Dialogue: 0,0:04:35.76,0:04:39.01,Default,Aki,0,0,0,,Nếu mày thắng, mày nói gì tao cũng chấp thuận hết.
Dialogue: 0,0:04:39.01,0:04:41.77,Default,Aki,0,0,0,,Còn nếu tao thắng, tao sẽ coi như không nghe thấy gì cả.
Dialogue: 0,0:04:41.77,0:04:43.23,Default,Aki,0,0,0,,Như thế đã được chưa?
Dialogue: 0,0:04:43.23,0:04:44.14,Default,Oka,0,0,0,,Được.
Dialogue: 0,0:04:44.94,0:04:46.06,Default,Aki,0,0,0,,Thú vị đấy.
Dialogue: 0,0:04:46.06,0:04:47.56,Default,Oka,0,0,0,,Sẵn sàng chưa, ranh con?
Dialogue: 0,0:05:11.04,0:05:13.17,Default,Aki,0,0,0,,Bao giờ muốn thách đấu lại thì cứ việc tới nhé.
Dialogue: 0,0:05:18.55,0:05:19.76,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:05:20.22,0:05:21.31,Default,Tom,0,0,0,,Anh xin lỗi.
Dialogue: 0,0:05:21.72,0:05:25.52,Default,Tom,0,0,0,,Để tuột mất cơ hội chỉ vì một chuyện ngớ ngẩn thế này...
Dialogue: 0,0:05:26.60,0:05:29.81,Default,San,0,0,0,,Nếu cháu kiên trì nỗ lực hết mình, nhất định cháu sẽ làm được thôi.
Dialogue: 0,0:05:32.19,0:05:35.94,Default,San,0,0,0,,Cháu có muốn thử lại lần nữa vì Nagisa không?
Dialogue: 0,0:05:46.25,0:05:47.71,Default,Yos,0,0,0,,Cậu đang làm cái gì thế kia?
Dialogue: 0,0:05:47.71,0:05:50.75,Default,Tom,0,0,0,,Em đang có một trận chiến quyết định cả cuộc đời đang chờ đợi phía trước ạ!
Dialogue: 0,0:05:54.71,0:05:57.51,Default,Aki,0,0,0,,Cái thằng nhóc này không biết bỏ cuộc là gì nhỉ.
Dialogue: 0,0:05:57.51,0:05:58.76,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:05:58.76,0:06:01.97,Default,San,0,0,0,,Cố lên nhé cả hai người!
Dialogue: 0,0:06:01.97,0:06:05.77,Default,Aki,0,0,0,,Ngon thì đánh trúng cú bóng nảy rơi cả mét của tao xem nào!
Dialogue: 0,0:06:05.77,0:06:06.64,Default,Oka,0,0,0,,Chú đi làm tuyển thủ chuyên nghiệp luôn đi cho rồi.
Dialogue: 0,0:06:16.99,0:06:18.70,Default,Aki,0,0,0,,Lại trượt rồi, lần sau lại đến nhé.
Dialogue: 0,0:06:22.24,0:06:25.99,Default,Aki,0,0,0,,Mắc mớ gì mà hai ta phải quyết đấu dưới cái thời tiết mưa gió thế này chứ hả?!
Dialogue: 0,0:06:25.99,0:06:28.62,Default,Oka,0,0,0,,Một khi đã là trận chiến nghiêm túc thì thời tiết chẳng là cái đinh gì cả!
Dialogue: 0,0:06:28.62,0:06:32.13,Default,San,0,0,0,,Nước tắm chuẩn bị xong rồi đấy hai người ơi!
Dialogue: 0,0:06:32.13,0:06:34.42,Default,Aki,0,0,0,,Mày có thử thêm bao nhiêu lần đi nữa thì kết quả cũng chẳng khác được đâu.
Dialogue: 0,0:06:34.42,0:06:35.88,Default,Aki,0,0,0,,Đây là cơ hội cuối cùng của mày đấy.
Dialogue: 0,0:06:35.88,0:06:37.17,Default,Oka,0,0,0,,Cháu hiểu rồi.
Dialogue: 0,0:06:51.14,0:06:52.52,Default,Aki,0,0,0,,Mày không thắng được tao đâu.
Dialogue: 0,0:06:52.90,0:06:56.90,Default,Aki,0,0,0,,Khoảng cách thực lực giữa hai ta là một trời một vực đấy.
Dialogue: 0,0:07:02.24,0:07:03.41,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:07:03.91,0:07:06.91,Default,Aki,0,0,0,,Anh nghĩ cậu ta đã hiểu ra rồi.
Dialogue: 0,0:07:07.99,0:07:09.29,Default,San,0,0,0,,Hiểu ra chuyện gì cơ ạ?
Dialogue: 0,0:07:09.87,0:07:12.67,Default,Oka,0,0,0,,Cháu có cảm giác chú ấy đang ngầm nhắc nhở cháu.
Dialogue: 0,0:07:13.46,0:07:15.29,Default,Oka,0,0,0,,'Mày vẫn chỉ là một đứa con nít ranh.'
Dialogue: 0,0:07:15.29,0:07:19.55,Default,Oka,0,0,0,,'Muốn bảo vệ người khác thì đúng là một kẻ ngu xuẩn.'
Dialogue: 0,0:07:19.55,0:07:21.43,Default,San,0,0,0,,Cháu nghĩ nhiều quá rồi.
Dialogue: 0,0:07:21.76,0:07:24.55,Default,San,0,0,0,,Tính khí của Akio-san xưa nay vẫn luôn như vậy mà.
Dialogue: 0,0:07:24.55,0:07:26.47,Default,San,0,0,0,,Thôi nào, chúng ta cùng về nhà đi cháu.
Dialogue: 0,0:07:26.47,0:07:28.18,Default,Oka,0,0,0,,Dạ không, cháu sẽ ở lại đây.
Dialogue: 0,0:07:28.97,0:07:32.14,Default,Oka,0,0,0,,Nếu khoảng cách về thực lực là quá lớn, thì thứ duy nhất cháu còn lại chính là nhiệt huyết.
Dialogue: 0,0:07:33.19,0:07:34.19,Default,Oka,0,0,0,,Cháu sẽ tiếp tục luyện tập.
Dialogue: 0,0:07:34.19,0:07:35.02,Default,Nag,0,0,0,,Nhưng mà—
Dialogue: 0,0:07:35.02,0:07:36.31,Default,San,0,0,0,,Đúng là như vậy đấy.
Dialogue: 0,0:07:36.31,0:07:37.82,Default,Nag,0,0,0,,Mẹ ơi!
Dialogue: 0,0:07:37.82,0:07:39.48,Default,San,0,0,0,,Lần này mẹ sẽ không cản cháu nữa đâu.
Dialogue: 0,0:07:39.86,0:07:42.24,Default,San,0,0,0,,Bởi vì suy cho cùng, đây là một chuyện vô cùng hệ trọng mà.
Dialogue: 0,0:07:42.24,0:07:43.78,Default,Oka,0,0,0,,Cháu cảm ơn cô nhiều lắm ạ.
Dialogue: 0,0:07:44.36,0:07:47.49,Default,San,0,0,0,,Cô sẽ quay vào nhà với Akio-san đây.
Dialogue: 0,0:07:47.83,0:07:49.49,Default,San,0,0,0,,Con cũng vào cùng mẹ đi nhé.
Dialogue: 0,0:07:49.49,0:07:50.58,Default,Nag,0,0,0,,Nhưng mà...
Dialogue: 0,0:07:50.58,0:07:55.50,Default,San,0,0,0,,Nagisa. Khi những người đàn ông đang quyết đấu, phụ nữ chúng ta tuyệt đối không được chen ngang.
Dialogue: 0,0:07:57.50,0:07:58.75,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:08:03.51,0:08:04.51,Default,San,0,0,0,,Nagisa?
Dialogue: 0,0:08:29.74,0:08:30.91,Default,Nag,0,0,0,,Bố ơi.
Dialogue: 0,0:08:36.58,0:08:37.54,Default,Oka,0,0,0,,Bố già.
Dialogue: 0,0:08:39.59,0:08:41.42,Default,Aki,0,0,0,,Trời mưa to thật đấy nhỉ.
Dialogue: 0,0:08:41.42,0:08:43.34,Default,Aki,0,0,0,,Lại là một mùa thu mưa dầm dề rồi sao?
Dialogue: 0,0:08:47.22,0:08:50.06,Default,Aki,0,0,0,,Đây thực sự là quả bóng ném cuối cùng đấy.
Dialogue: 0,0:08:50.06,0:08:50.97,Default,Aki,0,0,0,,Hiểu rõ rồi chứ?
Dialogue: 0,0:09:10.95,0:09:12.20,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:09:13.04,0:09:14.20,Default,San,0,0,0,,Là một cú home run rồi!
Dialogue: 0,0:09:20.67,0:09:22.42,Default,Oka,0,0,0,,Xin chú hãy gả Nagisa cho cháu!
Dialogue: 0,0:09:34.64,0:09:36.85,Default,Aki,0,0,0,,Nó giống tao ngày xưa thật đấy.
Dialogue: 0,0:09:37.77,0:09:40.90,Default,San,0,0,0,,Em đã biết điều đó từ rất lâu rồi mà.
Dialogue: 0,0:09:40.90,0:09:42.19,Default,San,0,0,0,,Cậu ấy thực sự rất giống anh.
Dialogue: 0,0:09:42.61,0:09:45.36,Default,Aki,0,0,0,,Hồi trước tao cũng nôn nóng muốn trở thành người lớn đến điên cuồng.
Dialogue: 0,0:09:45.74,0:09:47.70,Default,Aki,0,0,0,,Mà lúc ấy tao cũng chỉ là một thằng nhóc con chưa lớn.
Dialogue: 0,0:09:48.15,0:09:49.82,Default,San,0,0,0,,Chính xác là như vậy đấy anh.
Dialogue: 0,0:09:51.32,0:09:52.70,Default,Aki,0,0,0,,Ngẩng đầu lên đi.
Dialogue: 0,0:09:55.83,0:10:01.33,Default,Aki,0,0,0,,Nếu mày dám để Nagisa phải chịu bất kỳ nỗi đau buồn nào, tao sẽ lập tức cướp con bé về lại ngay.
Dialogue: 0,0:10:01.75,0:10:02.75,Default,Oka,0,0,0,,Vậy là...
Dialogue: 0,0:10:02.75,0:10:03.96,Default,Nag,0,0,0,,Bố ơi!
Dialogue: 0,0:10:09.43,0:10:10.47,Default,San,0,0,0,,Tomoya-san.
Dialogue: 0,0:10:10.47,0:10:13.26,Default,San,0,0,0,,Nagisa là ước mơ của hai cô chú.
Dialogue: 0,0:10:13.60,0:10:17.73,Default,San,0,0,0,,Và kể từ ngày hôm nay, cháu cũng chính là ước mơ của chúng tôi.
Dialogue: 0,0:10:18.02,0:10:21.52,Default,San,0,0,0,,Hạnh phúc của hai đứa cháu chính là ước mơ lớn nhất của cả gia đình này.
Dialogue: 0,0:10:22.02,0:10:24.90,Default,San,0,0,0,,Nên hãy cùng nhau nắm chặt lấy hạnh phúc nhé cháu.
Dialogue: 0,0:10:33.58,0:10:34.58,Default,Oka,0,0,0,,Mùa đông lạnh giá đã tràn về.
Dialogue: 0,0:10:39.08,0:10:42.96,Default,Oka,0,0,0,,Giáng sinh năm đó, tôi đã trải qua trọn vẹn những giây phút riêng tư bên Nagisa.
Dialogue: 0,0:10:55.31,0:10:56.56,Signs,,0,0,0,,{\an7\fs30\c&H292B2C&\b1\pos(654,66)}Thông báo Nghỉ Tết: Tiệm bánh Furukawa nghỉ từ \N{\c&H313596&}29/12{\c&H292B2C&} đến {\c&H313596&}3/1{\c&H292B2C&}. Rất mong quý khách thông cảm\Nvà hẹn gặp lại quý khách vào năm mới.\NChủ tiệm bánh Furukawa kính báo.
Dialogue: 0,0:10:57.43,0:10:59.81,Default,Aki,0,0,0,,Bố đã mòn mỏi chờ đợi ngày này từ lâu lắm rồi!
Dialogue: 0,0:10:59.81,0:11:02.48,Default,Aki,0,0,0,,Ngày mà bố được nâng ly cạn chén cùng con gái yêu của mình!
Dialogue: 0,0:11:02.48,0:11:04.61,Default,Oka,0,0,0,,Trước giờ cậu chưa từng uống giọt rượu nào đúng không?
Dialogue: 0,0:11:04.61,0:11:07.28,Default,Nag,0,0,0,,Vâng. Đây là lần đầu tiên của em đấy ạ.
Dialogue: 0,0:11:11.11,0:11:13.95,Default,San,0,0,0,,Con không cần phải gượng ép bản thân đâu, Nagisa.
Dialogue: 0,0:11:13.95,0:11:18.04,Default,Nag,0,0,0,,Dạ không, ít nhất con cũng muốn uống một chén vì bố ạ.
Dialogue: 0,0:11:18.04,0:11:19.12,Default,Aki,0,0,0,,Nagisa ơi...
Dialogue: 0,0:11:19.95,0:11:23.17,Default,Aki,0,0,0,,Chưa bao giờ bố thấy hạnh phúc vì đã sinh ra con như ngày hôm nay đâu.
Dialogue: 0,0:11:23.17,0:11:24.75,Default,Oka,0,0,0,,Chỉ vì chuyện cỏn con thế này mà chú cũng xúc động đến thế sao.
Dialogue: 0,0:11:24.75,0:11:25.92,Default,Nag,0,0,0,,Con xin phép uống đây ạ.
Dialogue: 0,0:11:28.25,0:11:31.30,Default,Aki,0,0,0,,Tuyệt vời! Con gái bố giỏi lắm!
Dialogue: 0,0:11:36.18,0:11:38.47,Default,Oka,0,0,0,,Này, cậu có thực sự ổn không đấy?
Dialogue: 0,0:11:41.56,0:11:45.52,Default,Nag,0,0,0,,Sao cậu lại ngồi xa em thế kia...
Dialogue: 0,0:11:51.95,0:11:54.61,Default,Nag,0,0,0,,Lại gần hơn rồi nè...
Dialogue: 0,0:11:54.61,0:11:56.28,Default,Oka,0,0,0,,Cậu say bí tỉ rồi đấy.
Dialogue: 0,0:11:56.28,0:11:58.16,Default,Nag,0,0,0,,Không có đâu, em đâu có say!
Dialogue: 0,0:11:58.16,0:12:00.45,Default,Oka,0,0,0,,Mấy người say rượu ai cũng mở miệng nói câu đó hết á.
Dialogue: 0,0:12:02.00,0:12:03.37,Default,Nag,0,0,0,,Tomoya-kun...
Dialogue: 0,0:12:04.58,0:12:06.79,Default,San,0,0,0,,Hai đứa tình cảm thắm thiết ghê chưa kìa.
Dialogue: 0,0:12:06.79,0:12:08.59,Default,Oka,0,0,0,,Thế này mà cũng tính là tình cảm thắm thiết sao cô?
Dialogue: 0,0:12:08.59,0:12:09.55,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:12:09.55,0:12:10.55,Default,Tom,0,0,0,,D-Dạ!
Dialogue: 0,0:12:10.55,0:12:12.92,Default,Nag,0,0,0,,Mẹ trông quyến rũ và thú vị đến thế đối với cậu cơ à?!
Dialogue: 0,0:12:12.92,0:12:14.72,Default,Tom,0,0,0,,Tự nhiên cậu nói cái quái gì thế hả?!
Dialogue: 0,0:12:14.72,0:12:17.26,Default,San,0,0,0,,Cô cũng rất tò mò muốn biết sự thật đấy nhé.
Dialogue: 0,0:12:18.22,0:12:20.77,Default,Oka,0,0,0,,Sao cả cô cũng uống rượu luôn thế này?!
Dialogue: 0,0:12:20.77,0:12:24.48,Default,San,0,0,0,,Cháu có để ý và hứng thú với cô không, Tomoya-san?
Dialogue: 0,0:12:24.48,0:12:26.35,Default,Nag,0,0,0,,Có phải thế không, Tomoya-kun?!
Dialogue: 0,0:12:27.06,0:12:28.48,Default,Aki,0,0,0,,Trận chiến này gay cấn ghê gớm thật đấy.
Dialogue: 0,0:12:28.48,0:12:30.11,Default,Oka,0,0,0,,Một trong hai người họ là vợ chú đấy có biết không hả?!
Dialogue: 0,0:12:30.11,0:12:32.11,Default,Nag,0,0,0,,Trả lời em mau đi, Tomoya-kun!
Dialogue: 0,0:12:32.11,0:12:34.86,Default,San,0,0,0,,Chuyện này hồi hộp quá đi mất thôi.
Dialogue: 0,0:12:34.86,0:12:36.66,Default,Oka,0,0,0,,Nghe này, tớ—
Dialogue: 0,0:12:35.86,0:12:37.87,Default-alt,Aki,0,0,0,,Sanae nhà này ngực bự lắm đấy nhé, mày biết không?
Dialogue: 0,0:12:39.16,0:12:42.33,Default,Nag,0,0,0,,Tomoya-kun! Sao mặt cậu lại hốt hoảng cuống cuồng lên như thế?!
Dialogue: 0,0:12:42.33,0:12:44.37,Default,Aki,0,0,0,,Đó là bằng chứng chứng minh nó có để ý đến Sanae đấy.
Dialogue: 0,0:12:43.83,0:12:44.83,Default-alt,Oka,0,0,0,,Không có! Hoàn toàn không có! Không bao giờ có chuyện đó đâu!
Dialogue: 0,0:12:44.83,0:12:46.00,Default,San,0,0,0,,Thật sự không có sao cháu?
Dialogue: 0,0:12:46.00,0:12:47.79,Default,Oka,0,0,0,,Ý cháu là, cháu rất quý mến cô ạ.
Dialogue: 0,0:12:47.79,0:12:49.34,Default,Oka,0,0,0,,Nhưng là quý mến với tư cách một con người thôi!
Dialogue: 0,0:12:49.34,0:12:50.38,Default,Nag,0,0,0,,Hóa ra là cậu thực sự thích mẹ em sao?!
Dialogue: 0,0:12:51.84,0:12:54.47,Default,Oka,0,0,0,,Trời ơi rốt cuộc tôi đã làm nên tội tình gì mà phải chịu trận thế này?!
Dialogue: 0,0:12:55.30,0:12:57.09,Default,Aki,0,0,0,,Thôi đừng trêu chọc nó nữa.
Dialogue: 0,0:12:57.39,0:13:00.10,Default,Aki,0,0,0,,Được thằng nhóc này thích thì có gì hay ho đâu chứ lị.
Dialogue: 0,0:13:00.10,0:13:01.97,Default,San,0,0,0,,Em đâu có trêu đùa đâu.
Dialogue: 0,0:13:01.97,0:13:03.35,Default,San,0,0,0,,Em nghiêm túc đấy chứ.
Dialogue: 0,0:13:03.35,0:13:04.52,Default,Aki,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:13:04.52,0:13:06.56,Default,Aki,0,0,0,,Sanae! Em đang nghĩ cái quái gì trong đầu thế hả?!
Dialogue: 0,0:13:04.52,0:13:06.56,Default-alt,Nag,0,0,0,,Quyết định cho dứt khoát đi mà!
Dialogue: 0,0:13:08.81,0:13:11.61,Default,Aki,0,0,0,,Con bé lăn ra ngủ say như cún rồi.
Dialogue: 0,0:13:11.61,0:13:13.86,Default,San,0,0,0,,Nagisa thật là có phúc lớn.
Dialogue: 0,0:13:13.86,0:13:15.32,Default,Aki,0,0,0,,Ừ.
Dialogue: 0,0:13:15.65,0:13:17.61,Default,San,0,0,0,,Còn cháu thì sao, Tomoya-san?
Dialogue: 0,0:13:19.24,0:13:20.74,Default,Oka,0,0,0,,Tất nhiên là cháu cũng vậy rồi ạ.
Dialogue: 0,0:13:21.41,0:13:25.79,Default,Oka,0,0,0,,Chỉ cần được mãi mãi ở bên cạnh cô ấy, cháu sẽ luôn hạnh phúc.
Dialogue: 0,0:13:32.25,0:13:36.05,Default,Oka,0,0,0,,Khi học kỳ ba bắt đầu, Nagisa lại ngã bệnh một lần nữa.
Dialogue: 0,0:13:37.80,0:13:40.85,Default,Oka,0,0,0,,Có lẽ trong kỳ nghỉ tớ đã dắt cậu đi chơi nhiều quá rồi.
Dialogue: 0,0:13:40.85,0:13:45.14,Default,Nag,0,0,0,,Không phải đâu ạ. Mùa này năm nào em cũng bị như thế cả.
Dialogue: 0,0:13:45.14,0:13:46.89,Default,Oka,0,0,0,,Liệu cậu có thể tốt nghiệp được không?
Dialogue: 0,0:13:47.35,0:13:49.48,Default,Nag,0,0,0,,Hình như là ổn thỏa rồi ạ.
Dialogue: 0,0:13:49.98,0:13:54.61,Default,Nag,0,0,0,,Số ngày chuyên cần của em đã đủ rồi, dù có nghỉ hết phần còn lại của năm học cũng không sao.
Dialogue: 0,0:13:54.61,0:13:55.53,Default,Oka,0,0,0,,Thế thì tốt rồi.
Dialogue: 0,0:13:55.90,0:13:57.28,Default,Oka,0,0,0,,Tuyệt vời quá.
Dialogue: 0,0:13:58.57,0:13:59.07,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:14:03.83,0:14:06.54,Note,,0,0,0,,{\fad(500,0)}Biển hiệu: Lễ Tốt Nghiệp Trường Cấp Ba Tư Thục Hikarizaka
Dialogue: 0,0:14:09.04,0:14:10.29,Default,Oka,0,0,0,,Ngày diễn ra lễ tốt nghiệp.
Dialogue: 0,0:14:11.21,0:14:15.76,Default,Oka,0,0,0,,Nagisa chỉ biết ngồi lặng lẽ bên khung cửa sổ ngóng về phía mái trường.
Dialogue: 0,0:14:17.97,0:14:19.55,Default,Mei,0,0,0,,Vâng, nhà Sunohara xin nghe ạ.
Dialogue: 0,0:14:19.55,0:14:20.97,Default,Oka,0,0,0,,Mei-chan đấy phải không?
Dialogue: 0,0:14:20.97,0:14:22.05,Default,Oka,0,0,0,,Anh Okazaki đây.
Dialogue: 0,0:14:23.35,0:14:24.85,Default,Mei,0,0,0,,Anh Okazaki đấy ư?!
Dialogue: 0,0:14:24.85,0:14:26.39,Default,Mei,0,0,0,,Lâu lắm rồi mới nghe tiếng anh!
Dialogue: 0,0:14:26.39,0:14:27.64,Default,Oka,0,0,0,,Dạo này em thế nào rồi?
Dialogue: 0,0:14:27.64,0:14:28.39,Default,Mei,0,0,0,,Em khỏe lắm ạ!
Dialogue: 0,0:14:28.39,0:14:31.44,Default,Mei,0,0,0,,Anh và chị Nagisa vẫn khỏe cả chứ ạ?
Dialogue: 0,0:14:31.44,0:14:32.94,Default,Oka,0,0,0,,Cũng tàm tạm thôi em.
Dialogue: 0,0:14:32.94,0:14:34.19,Default,Oka,0,0,0,,Sunohara có ở đó không em?
Dialogue: 0,0:14:34.19,0:14:37.82,Default,Mei,0,0,0,,Anh hai em đang ở ký túc xá công ty nên không có nhà đâu ạ.
Dialogue: 0,0:14:37.82,0:14:38.57,Default,Oka,0,0,0,,Ký túc xá sao?
Dialogue: 0,0:14:39.57,0:14:41.41,Default,Mei,0,0,0,,Ký túc xá của công ty anh ấy làm việc ạ.
Dialogue: 0,0:14:41.41,0:14:43.91,Default,Mei,0,0,0,,Anh có muốn lấy số điện thoại của anh ấy không ạ?
Dialogue: 0,0:14:44.83,0:14:46.20,Default,Sun,0,0,0,,Cảm ơn vì đã chờ máy.
Dialogue: 0,0:14:46.20,0:14:49.16,Default,Oka,0,0,0,,Này, Sunohara. Tao đây, Okazaki.
Dialogue: 0,0:14:49.79,0:14:51.50,Default,Sun,0,0,0,,Okazaki đấy à? Thật không đấy?!
Dialogue: 0,0:14:51.50,0:14:53.13,Default,Oka,0,0,0,,Ừ. Dạo này mày thế nào rồi?
Dialogue: 0,0:14:53.13,0:14:54.71,Default,Sun,0,0,0,,Vẫn ổn, nhưng mà...
Dialogue: 0,0:14:55.17,0:14:58.38,Default,Sun,0,0,0,,Cái công ty này củ chuối và vô lý lắm mày ạ.
Dialogue: 0,0:14:58.38,0:14:59.59,Default,Sun,0,0,0,,Này nghe tao kể nè...
Dialogue: 0,0:14:59.59,0:15:01.59,Default,Oka,0,0,0,,Để lần sau tao nghe mày kể.
Dialogue: 0,0:15:01.59,0:15:03.97,Default,Oka,0,0,0,,Bây giờ nghe tao nói chuyện này đã.
Dialogue: 0,0:15:03.97,0:15:04.97,Default,Oka,0,0,0,,Chuyện là thế này...
Dialogue: 0,0:15:06.72,0:15:09.43,Default,Oka,0,0,0,,Ừ, bất cứ khi nào mày rảnh và thuận tiện nhất.
Dialogue: 0,0:15:09.43,0:15:13.40,Default,Oka,0,0,0,,Tao sẽ phải sắp xếp cho khớp với lịch trình của mọi người nữa, nhưng tao sẽ lo liệu được.
Dialogue: 0,0:15:13.40,0:15:14.19,Default,Oka,0,0,0,,Làm ơn nhé.
Dialogue: 0,0:15:14.19,0:15:19.36,Default,Sun,0,0,0,,Tao đang trong giai đoạn thử việc học việc đấy,\Ntự ý rời khỏi ký túc xá là bị đuổi việc như chơi đấy nhé.
Dialogue: 0,0:15:19.36,0:15:20.32,Default,Oka,0,0,0,,Cảm ơn mày đã nhận lời giúp tao nhé.
Dialogue: 0,0:15:20.32,0:15:21.70,Default,Sun,0,0,0,,Mày muốn tao bị đuổi việc thật đấy à?!
Dialogue: 0,0:15:21.70,0:15:23.95,Default,Oka,0,0,0,,Nghỉ một ngày thì chết ai được đâu, đúng không?
Dialogue: 0,0:15:23.95,0:15:25.49,Default,Sun,0,0,0,,Mày nói nghe nhẹ như lông hồng ấy nhỉ.
Dialogue: 0,0:15:25.49,0:15:27.37,Default,Sun,0,0,0,,Công ty này nghiêm ngặt và cứng nhắc lắm.
Dialogue: 0,0:15:27.37,0:15:29.20,Default,Oka,0,0,0,,Tao xin mày đấy! Coi như giúp tao lần này đi!
Dialogue: 0,0:15:29.20,0:15:31.08,Default,Sun,0,0,0,,Là giúp Nagisa-chan thì đúng hơn chứ gì?
Dialogue: 0,0:15:32.08,0:15:34.29,Default,Sun,0,0,0,,Thôi được rồi, nếu chỉ có một ngày thì tao nghĩ tao xoay sở được.
Dialogue: 0,0:15:34.29,0:15:35.34,Default,Oka,0,0,0,,Cảm ơn mày nhiều lắm, Sunohara.
Dialogue: 0,0:15:36.67,0:15:41.80,Default,Sun,0,0,0,,Tao đúng là một thằng đàn ông tốt bụng hiếm có khó tìm,\Nhết lòng vì bạn gái của thằng khác như thế này cơ mà.
Dialogue: 0,0:15:41.80,0:15:43.68,Default,Oka,0,0,0,,Chính vì thế tao mới cậy nhờ đến mày đấy.
Dialogue: 0,0:15:44.76,0:15:45.97,Default,Sun,0,0,0,,Được rồi.
Dialogue: 0,0:15:45.97,0:15:48.85,Default,Sun,0,0,0,,Cứ tầm giờ này là gọi được cho tao, có gì thì gọi lại nhé.
Dialogue: 0,0:15:49.39,0:15:50.81,Default,Oka,0,0,0,,Ừ, tao sẽ gọi lại.
Dialogue: 0,0:15:57.11,0:15:58.98,Default,Nag,0,0,0,,Cảnh sắc ở đây đẹp thật đấy.
Dialogue: 0,0:15:58.98,0:16:00.69,Default,Oka,0,0,0,,Cậu thấy vui vì đã cùng tớ đến đây chứ?
Dialogue: 0,0:16:00.69,0:16:06.49,Default,Nag,0,0,0,,Cùng nhau bước đi thế này làm em nhớ lại\Nnhững ngày hai đứa mình cùng nhau cắp sách tới trường ghê.
Dialogue: 0,0:16:06.49,0:16:07.99,Default,Oka,0,0,0,,Tớ cũng vậy.
Dialogue: 0,0:16:11.04,0:16:13.29,Default,Nag,0,0,0,,Hai đứa mình tự ý vào trường thế này có sao không ạ?
Dialogue: 0,0:16:13.29,0:16:16.08,Default,Oka,0,0,0,,Đừng lo. Tớ đã xin phép nhà trường đàng hoàng rồi.
Dialogue: 0,0:16:17.09,0:16:18.29,Default,Kyo,0,0,0,,Nagisa!
Dialogue: 0,0:16:23.34,0:16:24.84,Default,Kyo,0,0,0,,Chào đằng ấy nhé!
Dialogue: 0,0:16:25.72,0:16:26.68,Default,Sun,0,0,0,,Nagisa-chan.
Dialogue: 0,0:16:26.68,0:16:27.93,Default,Sun,0,0,0,,Lâu lắm rồi mới gặp lại nhé.
Dialogue: 0,0:16:27.93,0:16:29.22,Default,Oka,0,0,0,,Thằng nào đây?
Dialogue: 0,0:16:29.64,0:16:32.60,Default,Sun,0,0,0,,Bao lâu nay mới gặp lại nhau mà mày nỡ lòng nào nói câu đó hả?!
Dialogue: 0,0:16:37.36,0:16:38.98,Default,Kyo,0,0,0,,Nhìn ai mà chẳng buồn cười chứ lị.
Dialogue: 0,0:16:38.98,0:16:41.69,Default,Kyo,0,0,0,,Lúc đầu tao còn tưởng là người khác nữa cơ đấy.
Dialogue: 0,0:16:41.69,0:16:42.65,Default,Bot,0,0,0,,Puhi puhi!
Dialogue: 0,0:16:42.65,0:16:46.91,Default,Mis,0,0,0,,Trước khi hai đứa đến, bọn này đang trêu chọc Sunohara đấy.
Dialogue: 0,0:16:48.03,0:16:50.62,Default,Kot,0,0,0,,Lúc đầu em cũng giật cả mình.
Dialogue: 0,0:16:50.62,0:16:53.91,Default,Kot,0,0,0,,Không nhuộm tóc vàng thì chẳng còn giống anh ấy nữa.
Dialogue: 0,0:16:53.91,0:16:56.67,Default,Ryo,0,0,0,,Thế hay là để tụi mình cùng nhau nhuộm tóc lại cho cậu ấy nhé?
Dialogue: 0,0:16:56.67,0:16:58.08,Default,Sun,0,0,0,,Tôi bị đuổi việc mất đấy các bà cô ơi!
Dialogue: 0,0:16:58.75,0:17:01.63,Default,Rie,0,0,0,,Cậu dạo này thế nào rồi, Furukawa-san?
Dialogue: 0,0:17:02.34,0:17:03.92,Default,Nag,0,0,0,,Dạ vâng, bây giờ em đã hoàn toàn khỏe mạnh rồi ạ.
Dialogue: 0,0:17:03.92,0:17:08.34,Default,Yuk,0,0,0,,Thật tuyệt vời khi tất cả chúng ta đều có thể tề tựu đông đủ thế này.
Dialogue: 0,0:17:08.34,0:17:14.23,Default,Tom,0,0,0,,Ừ. Tiếc thật vì hôm lễ tốt nghiệp chính thức cậu lại không thể đến được.
Dialogue: 0,0:17:14.23,0:17:18.52,Default,Girl,0,0,0,,Cả tôi và Rie-chan đều đã cố gắng sắp xếp thời gian để đến đây đấy.
Dialogue: 0,0:17:18.52,0:17:23.11,Default,Girl2,0,0,0,,Mọi người có thấy việc tất cả chúng ta tụ họp được đông đủ thế này giống như một phép màu nhỏ không?
Dialogue: 0,0:17:23.94,0:17:26.24,Default,Yos,0,0,0,,Nếu được nói thêm một lời, thì đây chính là phép màu của tình yêu đấy.
Dialogue: 0,0:17:26.24,0:17:28.11,Default,Mei,0,0,0,,Chuẩn không cần chỉnh luôn, anh Yoshino ơi!
Dialogue: 0,0:17:28.11,0:17:30.62,Default,Nag,0,0,0,,Dạ ừm... Em vẫn chưa hiểu chuyện gì\Nđang xảy ra ở đây nữa ạ.
Dialogue: 0,0:17:37.79,0:17:39.46,Default,Ryo,0,0,0,,Là lễ tốt nghiệp đấy.
Dialogue: 0,0:17:40.46,0:17:41.71,Default,Ryo,0,0,0,,Lễ tốt nghiệp dành riêng cho cậu.
Dialogue: 0,0:17:47.97,0:17:54.97,Default,Ibu,0,0,0,,Thầy Koumura đã đứng ra xin phép nhà trường cho mượn khuôn viên trường để tổ chức sự kiện hôm nay đấy.
Dialogue: 0,0:17:55.27,0:17:59.73,Default,Kou,0,0,0,,Thầy làm sao nỡ từ chối thỉnh cầu của những đứa học trò cuối cùng của đời mình chứ.
Dialogue: 0,0:17:59.73,0:18:02.44,Default,Oka,0,0,0,,Chúng em cảm ơn thầy nhiều lắm ạ.
Dialogue: 0,0:18:04.32,0:18:08.91,Default,Kou,0,0,0,,Sau đây, chúng ta sẽ bắt đầu buổi lễ tốt nghiệp.
Dialogue: 0,0:18:16.08,0:18:18.08,Default,Kou,0,0,0,,Học sinh Furukawa Nagisa.
Dialogue: 0,0:18:18.50,0:18:19.12,Default,Nag,0,0,0,,Dạ có!
Dialogue: 0,0:18:27.92,0:18:30.13,Default,Kou,0,0,0,,Bằng tốt nghiệp.
Dialogue: 0,0:18:30.13,0:18:35.81,Default,Kou,0,0,0,,Chứng nhận em đã hoàn thành toàn bộ chương trình học và đạt đủ mọi tiêu chuẩn do nhà trường đề ra.
Dialogue: 0,0:18:44.19,0:18:45.82,Default,Nag,0,0,0,,Em xin chân thành cảm ơn thầy rất nhiều ạ.
Dialogue: 0,0:19:01.42,0:19:06.84,Default,Nag,0,0,0,,Em đã từng phải trải qua biết bao gian nan, trắc trở tại mái trường này.
Dialogue: 0,0:19:07.71,0:19:12.26,Default,Nag,0,0,0,,Bản thân em vốn là một người nhút nhát, khép kín và rất vụng về trong việc kết bạn.
Dialogue: 0,0:19:12.68,0:19:17.27,Default,Nag,0,0,0,,Lên năm cuối cấp ba, vì không đủ số buổi đến lớp nên em đã phải lưu ban ở lại lớp.
Dialogue: 0,0:19:18.64,0:19:25.19,Default,Nag,0,0,0,,Mùa xuân của năm thứ hai học lớp mười hai, em hoàn toàn cô độc và lẻ loi giữa lớp học mới.
Dialogue: 0,0:19:26.57,0:19:33.87,Default,Nag,0,0,0,,Khi nhận ra chẳng có điều gì là không đổi thay theo dòng chảy của thời gian, đôi chân em dường như chết lặng không thể bước tiếp.
Dialogue: 0,0:19:34.99,0:19:38.20,Default,Nag,0,0,0,,Em chỉ biết đứng trơ trọi, bất lực dưới chân con dốc năm nào.
Dialogue: 0,0:19:39.79,0:19:44.88,Default,Nag,0,0,0,,Và chính Tomoya-kun là người đã dịu dàng đẩy nhẹ từ phía sau, tiếp thêm cho em dũng khí.
Dialogue: 0,0:19:45.96,0:19:49.51,Default,Nag,0,0,0,,Kể từ khoảnh khắc ấy, em đã được gặp gỡ biết bao con người tuyệt vời.
Dialogue: 0,0:19:50.09,0:19:54.26,Default,Nag,0,0,0,,Nhờ sự chung tay giúp đỡ của tất cả mọi người ở đây, em đã có thể thành lập lại Câu lạc bộ Kịch.
Dialogue: 0,0:19:54.72,0:19:58.26,Default,Nag,0,0,0,,Và tại Lễ hội Trường, em thậm chí đã được đứng trên sân khấu để biểu diễn.
Dialogue: 0,0:19:59.10,0:20:06.36,Default,Nag,0,0,0,,Nhưng ngay sau đó, em lại một lần nữa ngã bệnh\Nvà buộc phải ở lại lớp mười hai thêm một năm nữa.
Dialogue: 0,0:20:07.57,0:20:10.78,Default,Nag,0,0,0,,Dẫu vậy, em vẫn tự nhủ lòng mình phải cố gắng hết sức.
Dialogue: 0,0:20:11.32,0:20:14.11,Default,Nag,0,0,0,,Em muốn bản thân trở nên mạnh mẽ hơn.
Dialogue: 0,0:20:14.61,0:20:19.16,Default,Nag,0,0,0,,Dẫu thể xác có ốm yếu mỏng manh, em vẫn khát khao được sống một cách kiên cường.
Dialogue: 0,0:20:20.87,0:20:24.83,Default,Nag,0,0,0,,Và những người đã trao cho em sức mạnh to lớn ấy chính là tất cả mọi người đang đứng nơi đây.
Dialogue: 0,0:20:25.92,0:20:37.14,Default,Nag,0,0,0,,{\fs72.9}Năm nay em không được học cùng lớp với Tomoyo-san, Miyazawa-san hay Nishina-san, nên hầu hết thời gian em đều phải lủi thủi một mình.
Dialogue: 0,0:20:37.97,0:20:42.31,Default,Nag,0,0,0,,Thế nhưng... dẫu vậy đi chăng nữa...
Dialogue: 0,0:20:43.85,0:20:47.90,Default,Nag,0,0,0,,Em vẫn luôn trân trọng những ngày tháng học trò dưới mái trường này như những ký ức vô giá nhất cuộc đời!
Dialogue: 0,0:20:48.94,0:20:54.53,Default,Nag,0,0,0,,Phải mất đến năm năm ròng em mới có thể tốt nghiệp, nhưng em vô cùng yêu quý ngôi trường này.
Dialogue: 0,0:20:55.82,0:20:58.87,Default,Nag,0,0,0,,Bởi vì nơi đây chính là nơi mà em đã nỗ lực hết mình bằng tất cả thanh xuân.
Dialogue: 0,0:20:59.58,0:21:02.37,Default,Nag,0,0,0,,Em xin chân thành cảm ơn tất cả mọi người rất nhiều ạ.
Dialogue: 0,0:21:04.62,0:21:06.67,Default,Kou,0,0,0,,Chúc mừng em đã tốt nghiệp thành công.
Dialogue: 0,0:21:09.09,0:21:10.67,Default,Oka,0,0,0,,Quãng thời gian học trò đằng đẵng của Nagisa...
Dialogue: 0,0:21:11.50,0:21:13.30,Default,Oka,0,0,0,,...tháng ngày dài đăng đẵng ấy...
Dialogue: 0,0:21:14.63,0:21:15.22,Default,Oka,0,0,0,,...cuối cùng...
Dialogue: 0,0:21:15.80,0:21:16.59,Default,Oka,0,0,0,,...cũng đã khép lại rồi.
Dialogue: 0,0:21:22.64,0:21:24.73,Default,Oka,0,0,0,,Cháu sắp kết hôn với cô ấy ạ.
Dialogue: 0,0:21:25.14,0:21:26.02,Default,Dad,0,0,0,,Bố hiểu rồi.
Dialogue: 0,0:21:26.48,0:21:27.60,Default,Dad,0,0,0,,Chúc mừng hai con nhé.
Dialogue: 0,0:21:27.60,0:21:29.19,Default,Nag,0,0,0,,Dạ, cháu cảm ơn bác nhiều lắm ạ.
Dialogue: 0,0:21:30.40,0:21:33.82,Default,Dad,0,0,0,,À... cháu là Nagisa-san phải không?
Dialogue: 0,0:21:33.82,0:21:35.44,Default,Nag,0,0,0,,Dạ vâng. Cháu là Nagisa ạ.
Dialogue: 0,0:21:36.65,0:21:38.70,Default,Dad,0,0,0,,Bác nhờ cháu chăm sóc cho Tomoya-kun nhé.
Dialogue: 0,0:21:39.24,0:21:40.62,Default,Nag,0,0,0,,Dạ vâng, cháu cũng mong bác chỉ bảo thêm cho cháu ạ.
Dialogue: 0,0:21:41.24,0:21:42.29,Default,Dad,0,0,0,,Bác cầu chúc cho hai đứa có một cuộc sống thật hạnh phúc.
Dialogue: 0,0:21:52.09,0:21:55.30,Default,Oka,0,0,0,,Chúng tôi đã cùng nhau đi nộp giấy đăng ký kết hôn.
Dialogue: 0,0:21:58.93,0:22:01.05,Default,Oka,0,0,0,,Okazaki Nagisa.
Dialogue: 0,0:22:02.10,0:22:05.68,Default,Oka,0,0,0,,Kể từ ngày hôm nay, đó chính là tên của em.
