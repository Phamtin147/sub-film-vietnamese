Dialogue: 0,0:02:32.72,0:02:35.10,Default,Aki,0,0,0,,Này. Bọn mình đi chơi bóng chày thôi.
Dialogue: 0,0:02:35.35,0:02:36.93,Default,Oka,0,0,0,,Bác cứ tự nhiên.
Dialogue: 0,0:02:36.93,0:02:38.39,Default,Aki,0,0,0,,Đừng có nói cái giọng thờ ơ ấy!
Dialogue: 0,0:02:38.39,0:02:40.44,Default,Aki,0,0,0,,Chủ nhật tới có một trận đấu nữa đấy,
Dialogue: 0,0:02:40.44,0:02:43.15,Default,Aki,0,0,0,,nên tao bảo mày mau đi tập hợp một đội bóng đi.
Dialogue: 0,0:02:43.15,0:02:44.15,Default,Oka,0,0,0,,Bác có bảo cháu đâu mà.
Dialogue: 0,0:02:44.65,0:02:47.61,Default,Aki,0,0,0,,Bọn ta phải đấu với đội bóng của khu phố mua sắm lân cận.
Dialogue: 0,0:02:47.61,0:02:51.45,Default,Aki,0,0,0,,Bọn họ là kỳ phùng địch thủ của khu mua sắm bên mình.
Dialogue: 0,0:02:51.78,0:02:54.66,Default,Nag,0,0,0,,Bố cũng là thành viên trong đội bóng của người lớn ạ.
Dialogue: 0,0:02:54.87,0:02:58.66,Default,Aki,0,0,0,,Nhưng gần đây bọn họ mới chiêu mộ được một cựu cầu thủ Koshien.
Dialogue: 0,0:02:54.87,0:02:58.66,Note,Aki,0,0,0,,Chú thích: Koshien là giải bóng chày trung học toàn quốc của Nhật Bản.
Dialogue: 0,0:02:59.20,0:03:02.12,Default,Aki,0,0,0,,Nhờ có hắn ta mà bên mình đang dính chuỗi thua liên tiếp trước bọn họ đấy.
Dialogue: 0,0:03:02.12,0:03:03.67,Default,Aki,0,0,0,,Đúng là nhục nhã ê chề.
Dialogue: 0,0:03:03.67,0:03:07.88,Default,San,0,0,0,,Hèn chi dạo này thấy bà con lối xóm ai trông cũng ủ rũ, không được tươi vui như mọi khi.
Dialogue: 0,0:03:08.13,0:03:12.76,Default,Aki,0,0,0,,Để khuấy động lại tinh thần thị trấn, trận tới bằng mọi giá chúng ta phải giành chiến thắng.
Dialogue: 0,0:03:13.09,0:03:15.01,Default,Aki,0,0,0,,Dù toàn bộ đội hình phải đi mượn người ngoài tao cũng chẳng bận tâm.
Dialogue: 0,0:03:15.01,0:03:17.51,Default,Aki,0,0,0,,Điều quan trọng nhất là phải lật ngược thế cờ này.
Dialogue: 0,0:03:17.51,0:03:19.14,Default,Oka,0,0,0,,Thế tại sao cháu lại phải dính líu vào vụ này?
Dialogue: 0,0:03:19.06,0:03:21.10,Default-alt,San,0,0,0,,Nagisa, con lấy giùm mẹ chai nước tương với được không?
Dialogue: 0,0:03:19.14,0:03:21.10,Default,Aki,0,0,0,,Hôm nay là ngày bắt đầu học kỳ hai của tụi mày rồi.
Dialogue: 0,0:03:21.10,0:03:24.73,Default,Aki,0,0,0,,Mày có cả hội bạn trong Câu lạc bộ Kịch nghệ ở trường mà.
Dialogue: 0,0:03:21.69,0:03:22.60,Default-alt,Nag,0,0,0,,Dạ đây ạ.
Dialogue: 0,0:03:25.23,0:03:29.19,Default,Aki,0,0,0,,Kể từ khoảnh khắc chứng kiến tinh thần đồng đội\Nmà tụi mày thể hiện ở Lễ hội trường,
Dialogue: 0,0:03:29.19,0:03:31.99,Default,Aki,0,0,0,,tao đã luôn muốn được chơi bóng chày cùng tụi mày một trận ra trò.
Dialogue: 0,0:03:32.45,0:03:36.07,Default,Aki,0,0,0,,Đã mang tiếng là bạn trai của Nagisa,\Nthì cũng phải biết chiều lòng ông bố vợ tương lai này chút chứ.
Dialogue: 0,0:03:36.07,0:03:39.33,Default,Oka,0,0,0,,Này! Bác thừa biết vai phải của cháu bị chấn thương mà!
Dialogue: 0,0:03:39.49,0:03:42.96,Default,Aki,0,0,0,,Mày đã thổi bùng ngọn lửa trong tim tao rồi!
Dialogue: 0,0:03:42.96,0:03:45.25,Default,Aki,0,0,0,,Tựa như một quả cầu lửa rực cháy!
Dialogue: 0,0:03:45.25,0:03:47.13,Default,Oka,0,0,0,,Nói lảm nhảm chẳng ăn nhập gì hết.
Dialogue: 0,0:03:47.42,0:03:51.13,Default,Aki,0,0,0,,Biết đâu chúng ta lại tạo nên được một kỳ tích thì sao.
Dialogue: 0,0:03:51.47,0:03:55.14,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 1
Dialogue: 0,0:03:51.47,0:03:55.14,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Lời từ biệt cuối hạ
Dialogue: 0,0:03:55.76,0:03:57.35,Default,Oka,0,0,0,,Học kỳ hai đã chính thức bắt đầu.
Dialogue: 0,0:03:58.10,0:04:01.39,Default,Oka,0,0,0,,Tôi vẫn tiếp tục sống ở nhà của Nagisa.
Dialogue: 0,0:04:01.98,0:04:06.40,Default,Oka,0,0,0,,Là học sinh năm ba, lẽ ra chúng tôi phải bắt đầu định hướng cho tương lai của mình.
Dialogue: 0,0:04:06.90,0:04:10.65,Default,Oka,0,0,0,,Thế nhưng tôi vẫn hoàn toàn mù tịt, chẳng có lấy một định hướng nào.
Dialogue: 0,0:04:11.15,0:04:11.90,Default,Kyo,0,0,0,,Tôi tham gia!
Dialogue: 0,0:04:12.40,0:04:13.82,Default,Kyo,0,0,0,,Nghe chừng vui đấy chứ!
Dialogue: 0,0:04:14.03,0:04:17.20,Default,Nag,0,0,0,,Có Kyou-chan trong đội thì chúng ta thành bất khả chiến bại luôn rồi.
Dialogue: 0,0:04:17.20,0:04:22.58,Default,Sun,0,0,0,,Chiêu mộ được Sunohara Youhei này vào đội…\NBố của Nagisa-chan đúng là có mắt nhìn người đấy.
Dialogue: 0,0:04:22.58,0:04:27.13,Default,Oka,0,0,0,,Ừ. Bác ấy đặt rất nhiều kỳ vọng\Nvào năng khiếu thể thao thiên bẩm của mày.
Dialogue: 0,0:04:27.13,0:04:32.21,Default,Sun,0,0,0,,Ra vậy. Tài năng xuất chúng thì dù có\Ncố che giấu thế nào cũng tự tỏa sáng mà.
Dialogue: 0,0:04:32.21,0:04:34.97,Default,Oka,0,0,0,,Thằng này vẫn dễ dắt mũi như mọi khi.
Dialogue: 0,0:04:34.97,0:04:35.97,Default,Sun,0,0,0,,Mày vừa lẩm bẩm cái gì đấy hả?!
Dialogue: 0,0:04:35.97,0:04:37.05,Default,Oka,0,0,0,,Tao chỉ trêu mày chút thôi mà!
Dialogue: 0,0:04:37.05,0:04:41.97,Default,Oka,0,0,0,,Mày là siêu thiên tài, siêu thể thao,\Nvà siêu mỏng nên ban đêm siêu an toàn nữa.
Dialogue: 0,0:04:37.05,0:04:41.97,Note,Oka,0,0,0,,Chú thích: Okazaki đang nhại lại câu slogan quảng cáo băng vệ sinh phụ nữ.
Dialogue: 0,0:04:42.27,0:04:43.18,Default,Sun,0,0,0,,Chuẩn mẹ nó rồi còn gì nữa!
Dialogue: 0,0:04:43.43,0:04:46.69,Default,Kot,0,0,0,,Tomoya-kun. Mình cũng muốn thử chơi bóng chày nữa.
Dialogue: 0,0:04:46.69,0:04:48.94,Default,Oka,0,0,0,,Cậu có biết luật chơi không thế, Kotomi?
Dialogue: 0,0:04:48.94,0:04:53.61,Default,Kot,0,0,0,,Mình từng xem cậu với Tomoyo-chan đấu với Đội Bóng Chày rồi mà.
Dialogue: 0,0:04:53.61,0:04:55.70,Default,Kot,0,0,0,,Trông vui nhộn lắm.
Dialogue: 0,0:04:55.70,0:04:56.70,Default,Sun,0,0,0,,Cậu cũng đứng xem trận đó à?
Dialogue: 0,0:04:56.70,0:04:58.95,Default,Kyo,0,0,0,,Còn em thì sao, Ryou?
Dialogue: 0,0:04:58.95,0:05:02.70,Default,Ryo,0,0,0,,E-Em đứng ngoài cổ vũ thôi ạ.\NThể thao thì em chẳng tự tin chút nào đâu.
Dialogue: 0,0:05:03.04,0:05:05.50,Default,Nag,0,0,0,,Tớ cũng sẽ cố gắng hết mình để cổ vũ cho mọi người.
Dialogue: 0,0:05:05.50,0:05:07.79,Default,Nag,0,0,0,,Cố lên nhé, Tomoya-kun.
Dialogue: 0,0:05:09.00,0:05:09.96,Default,Oka,0,0,0,,Gì cơ?
Dialogue: 0,0:05:09.96,0:05:13.46,Default,Oka,0,0,0,,Hai người trông ngày càng ra dáng một cặp đôi hạnh phúc gớm nhỉ.
Dialogue: 0,0:05:15.13,0:05:16.63,Default,Nag,0,0,0,,Cậu thấy vậy thật sao?
Dialogue: 0,0:05:17.30,0:05:19.97,Default,Tom,0,0,0,,Các người gọi tôi ra chỗ này có việc gì thế?
Dialogue: 0,0:05:20.14,0:05:22.85,Default,Oka,0,0,0,,Thằng Sunohara muốn giở trò đồi bại biến thái với em đấy.
Dialogue: 0,0:05:25.56,0:05:29.56,Default,Oka,0,0,0,,Xem ra chẳng cần phải kiểm tra năng khiếu thể thao của Tomoyo làm gì nữa.
Dialogue: 0,0:05:29.56,0:05:31.32,Default,Sun,0,0,0,,Bố mày là công cụ đo đạc kiểm tra đấy à?!
Dialogue: 0,0:05:31.32,0:05:32.57,Default,Tom,0,0,0,,Rốt cuộc là có chuyện gì thế?
Dialogue: 0,0:05:33.07,0:05:36.57,Default,Nag,0,0,0,,Thật tuyệt vời khi ngay cả Tomoyo-san cũng tham gia.
Dialogue: 0,0:05:36.57,0:05:38.95,Default,Tom,0,0,0,,Tôi đã quyết định tham gia đâu.
Dialogue: 0,0:05:38.95,0:05:42.03,Default,Tom,0,0,0,,Tôi bảo là chỉ tham gia nếu chị Misae cũng đồng ý thôi.
Dialogue: 0,0:05:42.03,0:05:46.33,Default,Oka,0,0,0,,Trông chị Misae có vẻ chơi thể thao cừ lắm, bằng mọi giá chúng ta phải thuyết phục chị ấy mới được.
Dialogue: 0,0:05:46.33,0:05:49.08,Default,Sun,0,0,0,,Tôi quen chị ấy lâu năm rồi, tôi mà mở lời nhờ vả là được ngay ấy mà.
Dialogue: 0,0:05:51.21,0:05:53.09,Default,Nag,0,0,0,,Kìa, là anh Yoshino Yusuke-san.
Dialogue: 0,0:05:53.25,0:05:55.96,Default,Tom,0,0,0,,A, người ở đám cưới đợt trước.
Dialogue: 0,0:05:55.96,0:05:58.68,Default,Sun,0,0,0,,Tuyệt cú mèo. Rủ anh ấy tham gia luôn thôi.
Dialogue: 0,0:05:58.68,0:06:01.43,Default,Sun,0,0,0,,Anh Yoshino ơi!
Dialogue: 0,0:06:01.93,0:06:04.06,Default,Nag,0,0,0,,Có vẻ anh ấy không nghe thấy cậu gọi rồi.
Dialogue: 0,0:06:04.06,0:06:05.93,Default,Sun,0,0,0,,Bọn mình cùng làm màn hô vang Yoshino đi.
Dialogue: 0,0:06:05.93,0:06:07.23,Default,Oka,0,0,0,,Màn hô vang Yoshino á?
Dialogue: 0,0:06:07.23,0:06:09.27,Default,Sun,0,0,0,,Giống như hô 'encore' gọi ca sĩ ra diễn lại ở các buổi hòa nhạc ấy.
Dialogue: 0,0:06:09.60,0:06:13.94,Default,Sun,0,0,0,,Tao cá là anh ấy sẽ nhớ lại thời hoàng kim làm nhạc sĩ rồi đáp lời bọn mình ngay.
Dialogue: 0,0:06:13.94,0:06:15.07,Default,Sun,0,0,0,,Sẵn sàng chưa?
Dialogue: 0,0:06:15.07,0:06:29.66,Default,All,0,0,0,,YOSHINO! YOSHINO! YOSHINO!
Dialogue: 0,0:06:18.57,0:06:20.20,Default-alt,Sun,0,0,0,,Hô to lên nữa coi!
Dialogue: 0,0:06:29.87,0:06:32.00,Default,Yos,0,0,0,,Mấy đứa đang giở trò quấy rối gì thế hả?!
Dialogue: 0,0:06:32.54,0:06:35.09,Default,Yos,0,0,0,,Anh không tham gia được đâu. Chủ nhật anh bận làm việc rồi.
Dialogue: 0,0:06:35.09,0:06:37.13,Default,Nag,0,0,0,,Thế ạ…
Dialogue: 0,0:06:37.13,0:06:39.30,Default,Yos,0,0,0,,Không có ý gì đâu nhé. Hẹn gặp lại mấy đứa sau.
Dialogue: 0,0:06:39.30,0:06:40.13,Default,Oka,0,0,0,,Anh chờ đã!
Dialogue: 0,0:06:40.55,0:06:43.64,Default,Nag,0,0,0,,Tomoya-kun. Tớ nghĩ cậu không nên ép anh ấy quá.
Dialogue: 0,0:06:44.05,0:06:48.14,Default,Oka,0,0,0,,Nó… Thằng Sunohara luôn coi anh là thần tượng ngưỡng mộ nhất đời.
Dialogue: 0,0:06:48.81,0:06:53.73,Default,Oka,0,0,0,,Nhà nó tít tận miền Bắc xa xôi, sau khi tốt nghiệp,\Nchắc nó sẽ chẳng bao giờ quay trở lại thị trấn này nữa.
Dialogue: 0,0:06:53.73,0:07:00.61,Default,Oka,0,0,0,,Vậy nên trước khi rời đi, nó rất muốn tạo nên một kỷ niệm\Nvới người đàn ông mà nó luôn kính trọng, chính là anh đấy, anh Yoshino.
Dialogue: 0,0:07:00.95,0:07:02.99,Default,Tom,0,0,0,,Không ngờ cậu ta lại có suy nghĩ sâu sắc đến thế.
Dialogue: 0,0:07:02.99,0:07:04.62,Default,Tom,0,0,0,,Tôi chẳng hề hay biết chút nào.
Dialogue: 0,0:07:04.62,0:07:06.99,Default,Sun,0,0,0,,Okazaki… Mày nghĩ cho tao đến mức ấy thật sao?
Dialogue: 0,0:07:06.99,0:07:08.62,Default,Oka,0,0,0,,Mấy đứa tụi mày đừng có xúc động phát khóc lên thế chứ.
Dialogue: 0,0:07:09.00,0:07:09.87,Default,Yos,0,0,0,,Anh hiểu rồi.
Dialogue: 0,0:07:10.58,0:07:12.62,Default,Yos,0,0,0,,Xin lỗi vì anh đã vô tâm quá.
Dialogue: 0,0:07:12.62,0:07:14.21,Default,Oka,0,0,0,,Vậy thì!
Dialogue: 0,0:07:14.21,0:07:16.80,Default,Yos,0,0,0,,Ừ. Anh sẽ cố gắng sắp xếp thời gian.
Dialogue: 0,0:07:17.30,0:07:19.01,Default,Mis,0,0,0,,Mấy đứa tụi mày kéo nhau đến đây tìm chị có việc gì?
Dialogue: 0,0:07:19.46,0:07:20.76,Default,Sun,0,0,0,,Đi chơi bóng chày đi chị!
Dialogue: 0,0:07:20.76,0:07:21.68,Default,Mis,0,0,0,,Không.
Dialogue: 0,0:07:21.68,0:07:22.43,Default,Mis,0,0,0,,Về đi.
Dialogue: 0,0:07:23.55,0:07:26.10,Default,Oka,0,0,0,,Xem ra tốt nhất là mày nên ngậm mồm lại đi Sunohara.
Dialogue: 0,0:07:26.10,0:07:27.35,Default,Sun,0,0,0,,Tại sao cơ?!
Dialogue: 0,0:07:27.35,0:07:30.39,Default,Tom,0,0,0,,Chị Misae, chị có thể nghe tụi em nói một chút được không?
Dialogue: 0,0:07:31.06,0:07:32.27,Default,Mis,0,0,0,,Mấy đứa vẫn còn chuyện gì nữa à?
Dialogue: 0,0:07:32.27,0:07:33.60,Default,Sun,0,0,0,,Đi chơi bóng ch—
Dialogue: 0,0:07:34.31,0:07:35.90,Default,Tom,0,0,0,,Anh ngậm cái miệng lại giùm tôi.
Dialogue: 0,0:07:36.11,0:07:38.02,Default,Mis,0,0,0,,Ơ, Sakagami-san đấy à.
Dialogue: 0,0:07:38.02,0:07:39.65,Default,Mis,0,0,0,,Em lại đến để hỏi kinh nghiệm về Hội Học Sinh nữa à?
Dialogue: 0,0:07:39.86,0:07:41.40,Default,Tom,0,0,0,,Hôm nay thì không phải ạ.
Dialogue: 0,0:07:41.78,0:07:44.41,Default,Tom,0,0,0,,Tụi em rất muốn được chơi bóng chày cùng với chị.
Dialogue: 0,0:07:44.41,0:07:45.66,Default,Mis,0,0,0,,Bóng chày á?
Dialogue: 0,0:07:45.66,0:07:49.79,Default,Tom,0,0,0,,Vâng. Chị chính là… mục tiêu phấn đấu của em.
Dialogue: 0,0:07:49.79,0:07:52.41,Default,Tom,0,0,0,,Và em cũng muốn trở thành đối thủ xứng tầm của chị.
Dialogue: 0,0:07:52.66,0:07:57.42,Default,Tom,0,0,0,,Nếu được đọ sức thông qua thể thao, em tin chắc mình sẽ học hỏi được rất nhiều điều từ chị.
Dialogue: 0,0:07:58.00,0:07:59.92,Default,Tom,0,0,0,,Chị có thể đến chơi cùng tụi em được không ạ?
Dialogue: 0,0:08:01.84,0:08:04.47,Default,Mis,0,0,0,,Nhìn vào đôi mắt kiên định ấy, chị chẳng thể nào từ chối được rồi.
Dialogue: 0,0:08:06.89,0:08:09.26,Default,Nag,0,0,0,,Vậy là chúng ta đã tập hợp đủ chín người rồi.
Dialogue: 0,0:08:09.26,0:08:11.52,Default,Oka,0,0,0,,Không ngờ người cuối cùng lại là Mei-chan.
Dialogue: 0,0:08:11.52,0:08:13.19,Default,Oka,0,0,0,,Không biết con bé có đến thật không nữa.
Dialogue: 0,0:08:14.64,0:08:18.15,Default,Nag,0,0,0,,Hãy rủ cả bố của cậu đến xem nữa nhé.
Dialogue: 0,0:08:18.57,0:08:21.65,Default,Nag,0,0,0,,Để bác ấy được nhìn thấy cậu nỗ lực cố gắng.
Dialogue: 0,0:08:22.19,0:08:26.16,Default,Nag,0,0,0,,Tớ cũng muốn được chào hỏi bố cậu một cách đàng hoàng nữa.
Dialogue: 0,0:08:27.57,0:08:29.87,Default,Oka,0,0,0,,Để dịp khác đi cậu.
Dialogue: 0,0:08:30.37,0:08:30.91,Default,Oka,0,0,0,,Được không?
Dialogue: 0,0:08:33.25,0:08:34.37,Default,Nag,0,0,0,,Tomoya-kun!
Dialogue: 0,0:08:34.37,0:08:35.75,Default,Nag,0,0,0,,Chờ tớ với!
Dialogue: 0,0:08:49.72,0:08:52.77,Default,Mei,0,0,0,,Đ-Đ-Đúng thật là anh Yoshino Yusuke-san bằng xương bằng thịt kìa!
Dialogue: 0,0:08:53.02,0:08:55.48,Default,Nag,0,0,0,,May quá, em đã đến kịp giờ rồi.
Dialogue: 0,0:08:55.48,0:08:59.02,Default,Sun,0,0,0,,Vừa nghe tin được gặp Yoshino Yusuke là con bé phóng ngay xe buýt xuyên đêm tới đây liền.
Dialogue: 0,0:08:59.02,0:09:02.15,Default,Ibu,0,0,0,,Chị vẫn còn nhớ rất rõ em đấy, Sagara-san.
Dialogue: 0,0:09:02.15,0:09:04.28,Default,Ibu,0,0,0,,Hồi ấy em lúc nào cũng nổi bật nhất trường.
Dialogue: 0,0:09:05.32,0:09:07.53,Default,Mis,0,0,0,,Em cảm ơn chị vì đã chỉ bảo em rất nhiều trong những ngày tháng đó.
Dialogue: 0,0:09:08.07,0:09:10.20,Default,Mis,0,0,0,,Trông hai người hạnh phúc bên nhau ghê nhỉ.
Dialogue: 0,0:09:10.20,0:09:11.79,Default,Yos,0,0,0,,Cảm ơn chị đã quan tâm.
Dialogue: 0,0:09:12.16,0:09:15.46,Default,Oka,0,0,0,,Chị Misae với anh Yoshino đều quen biết nhau từ trước hết à?
Dialogue: 0,0:09:15.46,0:09:16.50,Default,Nag,0,0,0,,Xem chừng là vậy rồi.
Dialogue: 0,0:09:16.50,0:09:18.12,Default,Aki,0,0,0,,Tập hợp lại đây nào mọi người!
Dialogue: 0,0:09:19.17,0:09:21.29,Default,Aki,0,0,0,,Cảm ơn tất cả mọi người đã có mặt ngày hôm nay.
Dialogue: 0,0:09:21.29,0:09:22.84,Default,Aki,0,0,0,,Có được sự góp mặt của mọi người là vinh dự lớn của tôi.
Dialogue: 0,0:09:23.88,0:09:26.13,Default,Aki,0,0,0,,Nhưng nếu để thua trận thì chẳng còn ý nghĩa gì hết.
Dialogue: 0,0:09:26.72,0:09:29.64,Default,Aki,0,0,0,,Bất cứ ai phạm sai lầm sẽ bị phạt ăn bánh mì của Sanae.
Dialogue: 0,0:09:30.10,0:09:31.76,Default,Aki,0,0,0,,Hãy thi đấu hết mình như thể mạng sống đang bị đe dọa đi!
Dialogue: 0,0:09:31.76,0:09:33.85,Default,Kyo,0,0,0,,Bánh mì của Sanae nghĩa là sao thế?
Dialogue: 0,0:09:33.85,0:09:35.68,Default,Oka,0,0,0,,Cậu tốt nhất là không nên biết thì hơn.
Dialogue: 0,0:09:36.52,0:09:38.48,Default,Nag,0,0,0,,Trận đấu sắp bắt đầu rồi!
Dialogue: 0,0:09:38.48,0:09:40.06,Default,Ryo,0,0,0,,Cố lên nhé chị hai.
Dialogue: 0,0:09:40.06,0:09:41.44,Default,Ibu,0,0,0,,Cố lên nhé anh Yu-kun.
Dialogue: 0,0:09:41.44,0:09:43.73,Default,San,0,0,0,,Mọi người cố lên nhé.
Dialogue: 0,0:09:42.82,0:09:43.73,Default-alt,Bot,0,0,0,,Ủn ỉn ủn ỉn.
Dialogue: 0,0:09:45.86,0:09:48.36,Default,Guy,0,0,0,,Dám vác cái đội hình chắp vá gom nhặt này ra thách thức bọn tao à…
Dialogue: 0,0:09:48.53,0:09:50.70,Default,Guy,0,0,0,,Mày mất trí rồi Akio.
Dialogue: 0,0:09:51.62,0:09:53.24,Default,Aki,0,0,0,,Chưa biết mèo nào cắn mỉu nào đâu nhé.
Dialogue: 0,0:09:53.45,0:09:57.29,Default,Aki,0,0,0,,Biết đâu đây lại là đội bóng thú vị, đáng gờm nhất lịch sử đấy.
Dialogue: 0,0:10:00.67,0:10:01.88,Default,Ump,0,0,0,,Strike!
Dialogue: 0,0:10:02.84,0:10:03.88,Default,Mei,0,0,0,,Bóng nhanh thật đấy.
Dialogue: 0,0:10:03.88,0:10:07.84,Default,Oka,0,0,0,,Trong số bọn mình, chỉ có mỗi ông anh của em mới bắt nổi những cú ném như thế thôi.
Dialogue: 0,0:10:08.59,0:10:10.18,Default,Sun,0,0,0,,Tay bố mày sắp gãy rụng ra luôn rồi đây này!
Dialogue: 0,0:10:10.34,0:10:13.68,Default,Kyo,0,0,0,,Chẳng ai thèm quan tâm đến cái tay của cậu đâu, lo mà bắt bóng cho chắc vào.
Dialogue: 0,0:10:13.93,0:10:16.35,Default,Sun,0,0,0,,Bà chằn này ăn nói cay nghiệt vừa thôi chứ?!
Dialogue: 0,0:10:16.35,0:10:17.89,Default,Aki,0,0,0,,Ba người lên, ba người bị loại thẳng cẳng.
Dialogue: 0,0:10:18.14,0:10:19.64,Default,Aki,0,0,0,,Khởi đầu tuyệt vời đấy.
Dialogue: 0,0:10:19.64,0:10:22.02,Default,Oka,0,0,0,,Này, thằng Sunohara đánh bóng tay trái từ bao giờ thế?
Dialogue: 0,0:10:22.02,0:10:27.07,Default,Kyo,0,0,0,,Tao cá là nó nghĩ đứng ở ô đập bóng bên trái\Nthì chạy sang chốt một sẽ gần hơn.
Dialogue: 0,0:10:32.57,0:10:34.66,Default,Oka,0,0,0,,Giả vờ vung gậy rồi lại chuyển sang cú gạt bóng bunt…
Dialogue: 0,0:10:34.66,0:10:37.08,Default,Mei,0,0,0,,Lại còn đánh bổng lên trời nữa chứ. Quá phèn luôn.
Dialogue: 0,0:10:37.08,0:10:38.79,Default,Kyo,0,0,0,,Mở màn tệ hại kinh khủng khiếp.
Dialogue: 0,0:10:38.79,0:10:40.33,Default,Kyo,0,0,0,,Mày đúng là sao chổi gieo rắc tai họa cho cả đội.
Dialogue: 0,0:10:40.33,0:10:42.38,Default,Sun,0,0,0,,Bên kia là cầu thủ ném bóng tầm cỡ Koshien đấy nhé!
Dialogue: 0,0:10:42.38,0:10:43.84,Default,Sun,0,0,0,,Bà ngon thì ra mà đập xem có trúng không?!
Dialogue: 0,0:10:44.29,0:10:46.09,Default,Kyo,0,0,0,,Để bà đây thị phạm cho mày mở rộng tầm mắt.
Dialogue: 0,0:10:51.30,0:10:52.80,Default,Aki,0,0,0,,Đánh khá lắm.
Dialogue: 0,0:10:53.22,0:10:54.14,Default,Kyo,0,0,0,,Thấy sao hả con trai?
Dialogue: 0,0:10:54.14,0:10:56.14,Default,Sun,0,0,0,,Cho tôi lên đập thứ ba đi!
Dialogue: 0,0:10:56.14,0:10:58.06,Default,Oka,0,0,0,,Mày có biết luật chơi bóng chày không đấy hả thằng ngốc?
Dialogue: 0,0:10:59.56,0:11:02.40,Default,Aki,0,0,0,,Ghi ba điểm mở màn luôn nào các đồng chí!
Dialogue: 0,0:10:59.81,0:11:02.40,Default-alt,San,0,0,0,,Anh Akio, cố lên anh!
Dialogue: 0,0:11:03.98,0:11:06.61,Default,Aki,0,0,0,,Này! Sao mày không dám ném thẳng mặt tao hả?!
Dialogue: 0,0:11:06.61,0:11:08.28,Default,Oka,0,0,0,,Một người bị loại, ba chốt đều kín người rồi.
Dialogue: 0,0:11:08.28,0:11:09.78,Default,Oka,0,0,0,,Trông cậy cả vào em đấy, Tomoyo.
Dialogue: 0,0:11:09.78,0:11:13.07,Default,Tom,0,0,0,,Đây là lần đầu tiên em cầm gậy đánh bóng đấy.
Dialogue: 0,0:11:13.07,0:11:14.45,Default,Oka,0,0,0,,Đổi cách cầm gậy lại đi em.
Dialogue: 0,0:11:14.87,0:11:15.66,Default,Tom,0,0,0,,Cầm thế này đúng chưa anh?
Dialogue: 0,0:11:15.66,0:11:18.50,Default,Oka,0,0,0,,Đứng hai chân rộng ra, hạ thấp trọng tâm xuống.
Dialogue: 0,0:11:18.83,0:11:21.00,Default,Oka,0,0,0,,Đánh trúng bóng một cái là phải cắm đầu chạy thục mạng sang chốt một ngay nhé.
Dialogue: 0,0:11:22.46,0:11:23.63,Default,Ump,0,0,0,,Strike!
Dialogue: 0,0:11:23.63,0:11:24.46,Default,Oka,0,0,0,,Tomoyo!
Dialogue: 0,0:11:24.46,0:11:26.67,Default,Oka,0,0,0,,Đừng vung gậy vào những quả bóng nằm ngoài vùng này nhé.
Dialogue: 0,0:11:24.46,0:11:26.67,Default-alt,Mei,0,0,0,,Chị Tomoyo-san! Cố lên chị!
Dialogue: 0,0:11:36.55,0:11:38.56,Default,Aki,0,0,0,,Ăn đòn này lũ kia!
Dialogue: 0,0:11:38.56,0:11:39.47,Default,Guy,0,0,0,,Không thể nào tin nổi…
Dialogue: 0,0:11:40.31,0:11:42.81,Default,Tom,0,0,0,,Em xin lỗi. Em lỡ tay đánh bay mất quả bóng rồi.
Dialogue: 0,0:11:42.81,0:11:45.56,Default,Oka,0,0,0,,Không sao đâu! Chạy hết một vòng sân đi em!
Dialogue: 0,0:11:47.23,0:11:48.86,Signs,,0,0,0,,{\fad(700,0)\fs60\blur1\b1\frx22\fax-0.2\fry326\fnEraserDust\frz21.132\c&HD9E3B1&\pos(526.5,354)}Đội
Dialogue: 0,0:11:47.23,0:11:48.86,Signs,,0,0,0,,{\fad(700,0)\frx22\fry326\fnEraserDust\fax-0.2\b1\fs50\frz21.132\c&HD9E3B1&\pos(639,268.5)\blur1}Hiệp đấu
Dialogue: 0,0:11:47.23,0:11:48.86,Signs,,0,0,0,,{\fad(700,0)\fnEraserDust\b1\blur1\c&HD9E3B1&\fs32\frz24.15\frx-10\fax-0.7\pos(622,518.5)}Smells like teen spirit
Dialogue: 1,0:11:47.23,0:11:48.86,Signs,,0,0,0,,{\fad(400,0)\fnEraserDust\b1\blur1\c&HD9E3B1&\fs42\frz22.7\pos(567,778.5)\fax-0.67}Tiệm bánh Furukawa
Dialogue: 0,0:11:49.07,0:11:51.11,Default,Mei,0,0,0,,Anh ta trông mạnh thật đấy.
Dialogue: 0,0:11:51.11,0:11:53.61,Default,Oak,0,0,0,,Ừ. Đúng là đẳng cấp của cựu cầu thủ Koshien có khác.
Dialogue: 0,0:12:10.00,0:12:10.92,Default,Kyo,0,0,0,,Bác có sao không ạ?!
Dialogue: 0,0:12:10.92,0:12:11.59,Default,Oka,0,0,0,,Ông già!
Dialogue: 0,0:12:11.80,0:12:13.84,Default,Guy,0,0,0,,Tôi vô cùng xin lỗi. Anh có sao không?
Dialogue: 0,0:12:13.84,0:12:15.51,Default,Sun,0,0,0,,Mày cố tình ném vào người bác ấy đúng không?!
Dialogue: 0,0:12:15.51,0:12:17.72,Default,Guy,0,0,0,,K-Không, chỉ là tai nạn lỡ tay thôi.
Dialogue: 0,0:12:18.22,0:12:21.52,Default,Guy,0,0,0,,Giờ các anh tính sao đây?\NCó muốn mượn tạm một cầu thủ bên tôi sang không?
Dialogue: 0,0:12:21.52,0:12:24.35,Default,Aki,0,0,0,,Mày điên à! Làm thế thì trận đấu này còn ý nghĩa mẹ gì nữa!
Dialogue: 0,0:12:24.52,0:12:28.15,Default,Aki,0,0,0,,Vì danh dự của thị trấn này, bọn tao tuyệt đối không thể thua!
Dialogue: 0,0:12:29.86,0:12:31.23,Default,Aki,0,0,0,,Thay đổi người ném bóng.
Dialogue: 0,0:12:31.69,0:12:33.32,Default,Aki,0,0,0,,Cầu thủ ném bóng cứu nguy!
Dialogue: 0,0:12:33.36,0:12:35.66,Default,Aki,0,0,0,,Furukawa Nagisa!
Dialogue: 0,0:12:42.08,0:12:44.37,Default,Ryo,0,0,0,,Liệu Nagisa-chan có ném được không đây?
Dialogue: 0,0:12:44.54,0:12:49.67,Default,Aki,0,0,0,,Người có thể lực tốt ném bóng thì đối phương lại càng dễ canh đánh trúng.
Dialogue: 0,0:12:49.67,0:12:54.84,Default,Aki,0,0,0,,Ngược lại, một quả bóng bay chậm rì hình cầu vồng\Nném bởi người ném dở lại cực kỳ khó đập trúng.
Dialogue: 0,0:12:54.84,0:12:57.59,Default,San,0,0,0,,Nagisa! Cố lên con!
Dialogue: 0,0:12:57.59,0:12:58.55,Default,Bot,0,0,0,,Ủn ỉn ủn ỉn!
Dialogue: 0,0:12:59.10,0:13:01.31,Default,Oka,0,0,0,,Nagisa, cứ thả lỏng tinh thần ra nhé!
Dialogue: 0,0:13:01.31,0:13:03.68,Default,Kyo,0,0,0,,Dù bóng có bị đập trúng thì đằng sau đã có bọn tớ bọc lót hết rồi.
Dialogue: 0,0:13:03.68,0:13:06.31,Default,Nag,0,0,0,,Vâng ạ. Con cảm ơn mọi người nhiều lắm.
Dialogue: 0,0:13:08.10,0:13:09.73,Default,Sun,0,0,0,,Tới luôn đi, Nagisa-chan!
Dialogue: 0,0:13:16.65,0:13:17.20,Default,Oka,0,0,0,,Tomoyo!
Dialogue: 0,0:13:19.57,0:13:20.07,Default,Guy,0,0,0,,Out!
Dialogue: 0,0:13:20.28,0:13:23.45,Default,Nag,0,0,0,,Nhờ có mọi người mà em đã giữ sạch hiệp đấu này rồi.
Dialogue: 0,0:13:23.45,0:13:25.21,Default,Mis,0,0,0,,Chuyện nhỏ ấy mà, em không cần phải bận tâm đâu.
Dialogue: 0,0:13:25.21,0:13:27.75,Default,Mis,0,0,0,,Bọn chị đứng ở đây là để làm việc đó mà.
Dialogue: 0,0:13:27.75,0:13:28.63,Default,Sun,0,0,0,,Okazaki!
Dialogue: 0,0:13:29.08,0:13:31.29,Default,Sun,0,0,0,,Nhớ phải lên được chốt trước lượt tao đấy nhé!
Dialogue: 0,0:13:31.29,0:13:34.09,Default,Oka,0,0,0,,Đừng có đòi hỏi điều bất khả thi ở một thằng bị phế vai phải này chứ.
Dialogue: 0,0:13:35.09,0:13:37.55,Default,Ump,0,0,0,,Strike! Người đập bóng bị loại!
Dialogue: 0,0:13:41.05,0:13:44.77,Default,Kot,0,0,0,,Xác suất quả bóng đầu tiên đi vào góc dưới bên trong: 62%.
Dialogue: 0,0:13:44.77,0:13:46.64,Default,Kot,0,0,0,,Chiều dài của gậy đánh bóng: 800mm.
Dialogue: 0,0:13:46.64,0:13:48.52,Default,Kot,0,0,0,,Đường kính của quả bóng: 70mm.
Dialogue: 0,0:13:48.52,0:13:54.23,Default,Kot,0,0,0,,Kết hợp chiều dài cánh tay, phạm vi chuyển động,\Ncùng vận tốc quả bóng vào phương trình tính toán,
Dialogue: 0,0:13:54.23,0:13:55.94,Default,Kot,0,0,0,,thì chắc chắn mình sẽ đập trúng bóng.
Dialogue: 0,0:13:59.61,0:14:01.20,Default,Sun,0,0,0,,Oa. Ăn rùa một cú trúng bóng kìa.
Dialogue: 0,0:14:01.20,0:14:02.53,Default,Oka,0,0,0,,Kotomi, chạy mau!
Dialogue: 0,0:14:04.12,0:14:05.25,Default,Guy,0,0,0,,Safe!
Dialogue: 0,0:14:06.25,0:14:07.71,Default,Kot,0,0,0,,Mình làm được rồi!
Dialogue: 0,0:14:07.71,0:14:09.21,Default,Sun,0,0,0,,Tới lượt tao rồi.
Dialogue: 0,0:14:09.21,0:14:10.79,Default,Sun,0,0,0,,Đã đến lúc làm rạng danh tên tuổi của Sunohara này rồi.
Dialogue: 0,0:14:10.79,0:14:12.21,Default,Oka,0,0,0,,Thời khắc bôi tro trát trấu vào mặt thì có.
Dialogue: 0,0:14:17.92,0:14:18.55,Default,Guy,0,0,0,,Out!
Dialogue: 0,0:14:18.72,0:14:19.97,Default,Kyo,0,0,0,,Mày bị thiểu năng à?
Dialogue: 0,0:14:19.97,0:14:22.60,Default,Kyo,0,0,0,,Kotomi đã nhọc công chiếm chốt thế mà mày phá hỏng ăn hết cả.
Dialogue: 0,0:14:22.60,0:14:24.31,Default,Mis,0,0,0,,Cậu chơi tệ hại kinh khủng, Sunohara.
Dialogue: 0,0:14:24.31,0:14:26.02,Default,Mei,0,0,0,,Phèn không chịu nổi…
Dialogue: 0,0:14:26.02,0:14:28.27,Default,Oka,0,0,0,,Đúng chuẩn thời khắc bôi tro trát trấu vào mặt.
Dialogue: 0,0:14:29.19,0:14:31.06,Default,Aki,0,0,0,,Chưa có ai bị loại, người chạy đang ở chốt ba.
Dialogue: 0,0:14:31.44,0:14:33.52,Default,Aki,0,0,0,,Lại thêm một thời khắc quyết định nữa rồi.
Dialogue: 0,0:14:33.52,0:14:35.32,Default,Ryo,0,0,0,,Cậu làm được mà, Nagisa-chan!
Dialogue: 0,0:14:37.90,0:14:38.70,Default,Oka,0,0,0,,Bóng bay về phía cánh phải kìa!
Dialogue: 0,0:14:45.91,0:14:47.29,Default,Kot,0,0,0,,Mình bắt được bóng rồi!
Dialogue: 0,0:14:47.29,0:14:48.12,Default,Oka,0,0,0,,Kotomi!
Dialogue: 0,0:14:48.33,0:14:49.87,Default,Oka,0,0,0,,Ném thẳng về chốt gôn nhà mau!
Dialogue: 0,0:14:49.87,0:14:51.37,Default,Sun,0,0,0,,Nhanh lên! Ném về gôn mau!
Dialogue: 0,0:14:51.88,0:14:53.38,Default,Kot,0,0,0,,Mình xin lỗi.
Dialogue: 0,0:14:53.38,0:14:55.80,Default,Kot,0,0,0,,Mình quên mất luật tag up.
Dialogue: 0,0:14:55.80,0:14:59.01,Default,Oka,0,0,0,,Đừng lo. Cậu đã kìm hãm bên họ chỉ ghi được có đúng một điểm thôi mà.
Dialogue: 0,0:14:59.01,0:15:00.34,Default,Oka,0,0,0,,Cậu làm rất tốt rồi.
Dialogue: 0,0:15:00.34,0:15:02.43,Default,Aki,0,0,0,,Chúng ta chỉ việc gỡ lại điểm số thôi.
Dialogue: 0,0:15:02.43,0:15:03.76,Default,Aki,0,0,0,,Vung gậy hết mình đi!
Dialogue: 0,0:15:06.72,0:15:08.85,Default,Sun,0,0,0,,Mấy cô gái bên đội mình đỉnh thật đấy.
Dialogue: 0,0:15:09.27,0:15:12.35,Default,Sun,0,0,0,,Cứ liên tục đập trúng bóng của cựu cầu thủ Koshien như cơm bữa vậy.
Dialogue: 0,0:15:12.52,0:15:14.40,Default,Aki,0,0,0,,Chưa ai bị loại, đang chiếm chốt một và chốt ba rồi!
Dialogue: 0,0:15:14.40,0:15:15.48,Default,Aki,0,0,0,,Ai lên đập tiếp theo đây?
Dialogue: 0,0:15:17.19,0:15:19.69,Default,Aki,0,0,0,,À phải rồi, là con đấy Nagisa.
Dialogue: 0,0:15:19.86,0:15:21.40,Default,Aki,0,0,0,,Cứ chơi một cú squeeze là được.
Dialogue: 0,0:15:21.40,0:15:23.32,Default,Nag,0,0,0,,S-quiz á?
Dialogue: 0,0:15:23.32,0:15:25.20,Default,Nag,0,0,0,,Đó là câu đố quiz kiểu gì thế ạ bố?
Dialogue: 0,0:15:25.20,0:15:27.58,Default,Aki,0,0,0,,Đừng bận tâm, cứ vung gậy bằng tất cả sức bình sinh đi con!
Dialogue: 0,0:15:27.91,0:15:29.66,Default,Guy,0,0,0,,Strike! Người đập bóng bị loại!
Dialogue: 0,0:15:30.08,0:15:31.16,Default,Nag,0,0,0,,Con xin lỗi ạ.
Dialogue: 0,0:15:31.37,0:15:34.42,Default,Aki,0,0,0,,Bận tâm làm gì! Tiếp theo là tay đập chủ lực Tomo-pyon của chúng ta rồi!
Dialogue: 0,0:15:34.42,0:15:36.92,Default,Tom,0,0,0,,Bác đừng có đặt mấy cái biệt danh kỳ quặc đó cho tôi.
Dialogue: 0,0:15:36.92,0:15:40.42,Default,Ryo,0,0,0,,Chị Tomoyo-san, hãy làm thêm một cú home run nữa cho bọn em xem nhé.
Dialogue: 0,0:15:40.42,0:15:42.22,Default,Kot,0,0,0,,Làm ơn đi mà.
Dialogue: 0,0:15:42.22,0:15:43.34,Default,Tom,0,0,0,,Không thích đâu.
Dialogue: 0,0:15:43.72,0:15:48.18,Default,Tom,0,0,0,,Tôi muốn đập một cú nhẹ nhàng, thanh thoát chuẩn phong cách con gái thục nữ cơ.
Dialogue: 0,0:15:48.39,0:15:50.22,Default,San,0,0,0,,Cố lên cháu!
Dialogue: 0,0:15:55.36,0:15:58.44,Default,Tom,0,0,0,,Đánh bóng kiểu thục nữ con gái khó thật đấy.
Dialogue: 0,0:15:59.94,0:16:02.07,Default,Mei,0,0,0,,Okazaki-san!
Dialogue: 0,0:16:02.07,0:16:04.78,Default,Oka,0,0,0,,Với cái bả vai này, điều tốt nhất mình có thể làm là…
Dialogue: 0,0:16:02.07,0:16:04.16,Default-alt,Mei,0,0,0,,Cố lên anh nhé!
Dialogue: 0,0:16:09.66,0:16:10.20,Default,Guy,0,0,0,,Out.
Dialogue: 0,0:16:11.54,0:16:13.21,Default,Aki,0,0,0,,Chẳng phải phong cách thi đấu tao thích.
Dialogue: 0,0:16:13.75,0:16:16.38,Default,Aki,0,0,0,,Nhưng là một chiến thuật không tồi chút nào.
Dialogue: 0,0:16:17.59,0:16:18.67,Default,Sun,0,0,0,,Okazaki à.
Dialogue: 0,0:16:19.17,0:16:21.42,Default,Sun,0,0,0,,Mày đã sa sút xuống tận đáy vực thẳm rồi.
Dialogue: 0,0:16:21.42,0:16:24.47,Default,Oka,0,0,0,,Còn hơn là bị dính double play loại kép như ai đó.
Dialogue: 0,0:16:24.47,0:16:25.89,Default,Sun,0,0,0,,Làm gì có chuyện đó!
Dialogue: 0,0:16:25.89,0:16:28.35,Default,Sun,0,0,0,,Đã là đàn ông thì phải dám thử thách chứ!
Dialogue: 0,0:16:33.31,0:16:35.44,Default,Aki,0,0,0,,Đánh hay lắm, Misae-chan!
Dialogue: 0,0:16:35.44,0:16:36.65,Default,Mis,0,0,0,,Đừng có gọi tôi kiểu đó!
Dialogue: 0,0:16:41.78,0:16:42.99,Default,Tom,0,0,0,,Cú đánh đúng ý tôi thích đấy.
Dialogue: 0,0:16:44.82,0:16:47.24,Default,Mei,0,0,0,,Anh Yoshino, chúc anh may mắn nhé.
Dialogue: 0,0:16:47.24,0:16:48.20,Default,Yos,0,0,0,,Ừ.
Dialogue: 0,0:16:48.87,0:16:50.16,Default,Guy,0,0,0,,Strike!
Dialogue: 0,0:16:50.91,0:16:54.16,Default,Yos,0,0,0,,Từ đầu trận đến giờ tôi chưa cống hiến được pha bóng nào cho đội cả,
Dialogue: 0,0:16:54.16,0:16:57.71,Default,Yos,0,0,0,,nhưng vì những đứa trẻ ở nơi đây, tôi nhất định sẽ đập trúng bóng.
Dialogue: 0,0:16:57.71,0:16:59.17,Default,Guy,0,0,0,,Strike!
Dialogue: 0,0:16:59.34,0:17:01.46,Default,San,0,0,0,,Cố lên anh!
Dialogue: 0,0:17:02.34,0:17:03.13,Default,Yos,0,0,0,,Đây là món quà {\alpha&HFF}tôi dành tặng cho tất cả các em!
Dialogue: 0,0:17:03.59,0:17:04.38,Default,Yos,0,0,0,,Đây là món quà tôi dành tặng {\alpha&HFF}cho tất cả các em!
Dialogue: 0,0:17:04.59,0:17:06.01,Default,Yos,0,0,0,,Đây là món quà tôi dành tặng cho tất cả các em!
Dialogue: 0,0:17:09.43,0:17:13.06,Default,Mis,0,0,0,,Cảnh tượng sến sẩm này vẫn còn tồn tại trên đời sao trời?
Dialogue: 0,0:17:13.06,0:17:14.56,Default,Yos,0,0,0,,Hỡi những đứa trẻ.
Dialogue: 0,0:17:15.52,0:17:18.56,Default,Yos,0,0,0,,Đây là món quà tuyệt vời nhất mà hiện giờ anh có thể trao gửi tới các em.
Dialogue: 0,0:17:19.15,0:17:22.57,Default,Yos,0,0,0,,Một món quà vô hình mang tên ký ức.
Dialogue: 0,0:17:22.94,0:17:24.61,Default,Yos,0,0,0,,Anh không có nhiều tiền bạc.
Dialogue: 0,0:17:24.94,0:17:27.57,Default,Yos,0,0,0,,Anh chẳng thể mua tặng các em những thứ hiện hữu hữu hình.
Dialogue: 0,0:17:28.32,0:17:29.28,Default,Yos,0,0,0,,Dẫu vậy thì—
Dialogue: 0,0:17:30.12,0:17:31.37,Default,Guy,0,0,0,,Out!
Dialogue: 0,0:17:32.70,0:17:34.66,Default,Mis,0,0,0,,Anh ấy đúng là chẳng hề thay đổi chút nào.
Dialogue: 0,0:17:34.66,0:17:36.50,Default,Ibu,0,0,0,,Em xin lỗi mọi người vì anh ấy nhé.
Dialogue: 0,0:17:37.46,0:17:39.54,Default,Aki,0,0,0,,Cuối cùng thì bên họ cũng lật ngược được thế cờ rồi.
Dialogue: 0,0:17:39.54,0:17:40.79,Default,San,0,0,0,,Mọi người cùng cố gắng lên nào.
Dialogue: 0,0:17:41.00,0:17:42.17,Default,Nag,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:17:42.17,0:17:44.55,Default,Sun,0,0,0,,Đâu phải lỗi của cậu đâu, Nagisa-chan.
Dialogue: 0,0:17:44.55,0:17:46.09,Default,Sun,0,0,0,,Tại bên họ mạnh quá mức thôi.
Dialogue: 0,0:17:46.26,0:17:49.47,Default,Kyo,0,0,0,,Cú ném bóng hỏng trượt tay của mày mới là thứ khiến họ ghi thêm điểm đấy.
Dialogue: 0,0:17:49.47,0:17:52.10,Default,Tom,0,0,0,,Trước đó thì cậu cũng bắt bóng sai bét nhè rồi.
Dialogue: 0,0:17:52.10,0:17:57.56,Default,Mei,0,0,0,,Cũng chính anh để vuột mất cú bóng bổng làm cho người ghi điểm thứ năm lên được chốt đấy thôi.
Dialogue: 0,0:18:01.19,0:18:02.57,Default,Mis,0,0,0,,Tôi bị đơ người mất một nhịp.
Dialogue: 0,0:18:02.57,0:18:03.82,Default,Aki,0,0,0,,Một người bị loại rồi…
Dialogue: 0,0:18:03.82,0:18:04.94,Default,Aki,0,0,0,,Nagisa, lên đi con.
Dialogue: 0,0:18:05.40,0:18:06.15,Default,Nag,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:06.44,0:18:08.36,Default,Mei,0,0,0,,Bình tĩnh lại nhé, chị Nagisa-san.
Dialogue: 0,0:18:08.36,0:18:10.11,Default,Ibu,0,0,0,,Tập trung tinh thần vào nhé, Nagisa-chan.
Dialogue: 0,0:18:10.11,0:18:12.16,Default,Kot,0,0,0,,Hãy vung gậy bằng tất cả sức mạnh của cậu.
Dialogue: 0,0:18:12.41,0:18:14.24,Default,Kyo,0,0,0,,Thả lỏng ra, thư giãn nào.
Dialogue: 0,0:18:14.24,0:18:15.79,Default,Oka,0,0,0,,Đừng sợ bị loại.
Dialogue: 0,0:18:15.79,0:18:18.62,Default,Oka,0,0,0,,Hãy vung gậy hết mình để không phải hối tiếc bất cứ điều gì nhé.
Dialogue: 0,0:18:18.62,0:18:20.54,Default,Nag,0,0,0,,Để mình không phải hối tiếc…
Dialogue: 0,0:18:25.84,0:18:27.67,Default,Nag,0,0,0,,Con làm được rồi!
Dialogue: 0,0:18:27.67,0:18:30.13,Default,Aki,0,0,0,,Tốt lắm! Đúng là con gái rượu của bố!
Dialogue: 0,0:18:30.13,0:18:32.30,Default,Tom,0,0,0,,Tôi sẽ đập quả bóng này mạnh hết sức bình sinh!
Dialogue: 0,0:18:35.22,0:18:38.02,Default,Aki,0,0,0,,Pha đó thì chịu rồi, chỉ tại xui xẻo thôi.
Dialogue: 0,0:18:38.73,0:18:40.94,Default,Yos,0,0,0,,Hiện giờ trông anh có đang mỉm cười không?
Dialogue: 0,0:18:40.94,0:18:43.02,Default,Sun,0,0,0,,Không, hoàn toàn không hề luôn.
Dialogue: 0,0:18:43.52,0:18:45.44,Default,Yos,0,0,0,,Xin lỗi vì anh lại ra nông nỗi này…
Dialogue: 0,0:18:45.44,0:18:47.24,Default,Yos,0,0,0,,Xin lỗi vì anh quá đỗi thảm hại…
Dialogue: 0,0:18:47.24,0:18:48.57,Default,Yos,0,0,0,,Xin lỗi vì đã để lại một ký ức như thế này trong lòng các em…
Dialogue: 0,0:18:48.95,0:18:49.57,Default,Yos,0,0,0,,Thế nhưng!
Dialogue: 0,0:18:49.82,0:18:51.57,Default,Yos,0,0,0,,Đến cuối cùng, anh nhất định sẽ mỉm cười!
Dialogue: 0,0:18:52.07,0:18:53.83,Default,Ibu,0,0,0,,Cố lên anh Yu-kun!
Dialogue: 0,0:18:55.99,0:18:59.33,Default,Ibu,0,0,0,,Đây là món quà anh dành tặng cho tất cả các em!
Dialogue: 0,0:19:02.58,0:19:05.34,Default,Aki,0,0,0,,Được lắm, bên mình đã có hai người chiếm chốt rồi.
Dialogue: 0,0:19:05.34,0:19:06.67,Default,Yos,0,0,0,,Hỡi những đứa trẻ.
Dialogue: 0,0:19:07.51,0:19:09.05,Default,Yos,0,0,0,,Đây chính là món quà tuyệt vời nhất!
Dialogue: 0,0:19:09.05,0:19:10.13,Default,Yos,0,0,0,,Xin tạm dừng thời gian một chút.
Dialogue: 0,0:19:11.30,0:19:14.43,Default,Yos,0,0,0,,Đây là món quà tuyệt vời nhất mà lúc này anh có thể trao gửi tới các em.
Dialogue: 0,0:19:15.26,0:19:18.18,Default,Yos,0,0,0,,Một món quà vô hình mang tên ký ức.
Dialogue: 0,0:19:18.93,0:19:20.48,Default,Yos,0,0,0,,Anh không có nhiều tiền bạc.
Dialogue: 0,0:19:20.48,0:19:23.19,Default,Yos,0,0,0,,Anh không thể mua tặng các em những món quà hữu hình.
Dialogue: 0,0:19:23.48,0:19:28.40,Default,Yos,0,0,0,,Dẫu vậy, dù không mang hình hài cụ thể, một ký ức đẹp sẽ mãi mãi trường tồn vĩnh cửu!
Dialogue: 0,0:19:30.28,0:19:32.36,Default,Yos,0,0,0,,Anh luôn vững tin là như thế.
Dialogue: 0,0:19:32.78,0:19:35.07,Default,Guy,0,0,0,,À ừm… Anh đã diễn thuyết xong chưa ạ?
Dialogue: 0,0:19:35.07,0:19:36.58,Default,Yos,0,0,0,,Ừ, cảm ơn chú em nhé.
Dialogue: 0,0:19:37.99,0:19:40.41,Default,Ibu,0,0,0,,Anh làm tốt lắm, Yu-kun.
Dialogue: 0,0:19:40.41,0:19:43.54,Default,Mei,0,0,0,,Em xúc động rơi nước mắt trước lời nói của anh luôn rồi, anh Yoshino!
Dialogue: 0,0:19:53.93,0:19:54.84,Default,Aki,0,0,0,,Này nhóc con.
Dialogue: 0,0:19:56.47,0:19:58.06,Default,Aki,0,0,0,,Hai người bị loại rồi, ba chốt đều kín người.
Dialogue: 0,0:19:58.06,0:19:59.35,Default,Aki,0,0,0,,Mày không chơi trò gạt bóng bunt được nữa đâu đấy.
Dialogue: 0,0:20:00.39,0:20:02.56,Default,Aki,0,0,0,,Tất cả giờ đây trông cậy cả vào mày đấy.
Dialogue: 0,0:20:02.85,0:20:04.77,Default,Oka,0,0,0,,Nhưng bả vai của cháu…
Dialogue: 0,0:20:05.40,0:20:06.98,Default,San,0,0,0,,Okazaki-san!
Dialogue: 0,0:20:07.94,0:20:10.11,Default,San,0,0,0,,Cố lên cháu nhé.
Dialogue: 0,0:20:10.69,0:20:13.11,Default,Kyo,0,0,0,,Liệu hồn mà đánh bóng đưa được Nagisa về chạm chốt gôn nhà đấy nhé.
Dialogue: 0,0:20:13.32,0:20:15.82,Default,Ryo,0,0,0,,Làm ơn hãy cố gắng hết sức mình nhé, Okazaki-kun.
Dialogue: 0,0:20:16.20,0:20:18.16,Default,Tom,0,0,0,,Cậu nhất định sẽ đánh trúng thôi, Okazaki.
Dialogue: 0,0:20:18.74,0:20:20.70,Default,Kot,0,0,0,,Chúc cậu may mắn nhé, Tomoya-kun.
Dialogue: 0,0:20:21.25,0:20:23.96,Default,Aki,0,0,0,,Hãy mang vinh quang chiến thắng trở về cho thị trấn này đi con.
Dialogue: 0,0:20:47.69,0:20:51.69,Default,Tom,0,0,0,,Chị Misae. Lần tới em lại sang phòng chị chơi được không ạ?
Dialogue: 0,0:20:51.69,0:20:54.07,Default,Mis,0,0,0,,Được chứ. Cứ qua bất cứ lúc nào em muốn nhé.
Dialogue: 0,0:20:54.28,0:20:56.41,Default,Ibu,0,0,0,,Xin lỗi vì để mọi người phải đợi lâu nhé!
Dialogue: 0,0:20:56.41,0:20:58.07,Default,San,0,0,0,,Mọi người cứ ăn uống tự nhiên thoải mái nhé.
Dialogue: 0,0:20:58.41,0:21:01.20,Default,Kot,0,0,0,,Trông ngon ơi là ngon luôn ấy.
Dialogue: 0,0:21:01.20,0:21:02.25,Default,Bot,0,0,0,,Ủn ỉn ủn ỉn!
Dialogue: 0,0:21:03.62,0:21:07.12,Default,Sun,0,0,0,,Tao thắc mắc suốt từ nãy đến giờ, cô gái kia rốt cuộc là ai thế mày?
Dialogue: 0,0:21:07.12,0:21:08.58,Default,Sun,0,0,0,,Chị gái của Nagisa-chan à?
Dialogue: 0,0:21:08.58,0:21:10.34,Default,Oka,0,0,0,,Đại loại là vậy đấy.
Dialogue: 0,0:21:11.34,0:21:12.71,Default,Sun,0,0,0,,Hai chị em toàn người đẹp nhỉ.
Dialogue: 0,0:21:13.55,0:21:16.38,Default,Mei,0,0,0,,Chị Nagisa-san ơi. Em có một thỉnh cầu này muốn nhờ chị.
Dialogue: 0,0:21:16.38,0:21:17.47,Default,Nag,0,0,0,,Gì thế em?
Dialogue: 0,0:21:18.05,0:21:18.80,Default,Mei,0,0,0,,Dạ, chuyện là…
Dialogue: 0,0:21:19.10,0:21:21.47,Default,Kyo,0,0,0,,Cảm giác chiến thắng thực sự đã đời ghê.
Dialogue: 0,0:21:21.47,0:21:23.93,Default,Kyo,0,0,0,,Đây chắc chắn là đội hình mạnh nhất trần đời rồi.
Dialogue: 0,0:21:24.27,0:21:26.19,Default,Ryo,0,0,0,,Hôm nay chị thi đấu rực sáng trên sân luôn đấy.
Dialogue: 0,0:21:26.39,0:21:28.69,Default,Aki,0,0,0,,Hôm nào lại làm một trận nữa với đầy đủ các thành viên này nhé!
Dialogue: 0,0:21:29.15,0:21:32.32,Default,Yos,0,0,0,,Nếu là vì mục đích kiến tạo những ký ức đẹp, cứ gọi cho tôi bất cứ lúc nào.
Dialogue: 0,0:21:32.90,0:21:34.82,Default,Aki,0,0,0,,Bắt đầu khai tiệc thôi nào mọi người.
Dialogue: 0,0:21:34.82,0:21:38.61,Default,Aki,0,0,0,,Để chúc mừng chiến thắng vang dội của Đội Bánh Mì Furukawa.
Dialogue: 0,0:21:38.95,0:21:40.78,Default,Aki,0,0,0,,Cạn ly!
Dialogue: 0,0:21:46.75,0:21:48.17,Default,Aki,0,0,0,,Chạy mau!
Dialogue: 0,0:21:48.83,0:21:49.88,Default,Kyo,0,0,0,,Vâng ạ!
