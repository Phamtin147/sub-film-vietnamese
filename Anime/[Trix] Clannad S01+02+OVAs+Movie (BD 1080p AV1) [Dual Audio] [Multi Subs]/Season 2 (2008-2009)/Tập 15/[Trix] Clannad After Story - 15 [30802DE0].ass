Dialogue: 0,0:00:01.65,0:00:04.24,Default,San,0,0,0,,Nagisa ơi, nhân lúc này cho mẹ xin chữ ký của con trước được không?
Dialogue: 0,0:00:04.24,0:00:06.28,Default,Oka,0,0,0,,Đúng là những bậc cha mẹ nuông chiều con cái quá mức.
Dialogue: 0,0:00:06.28,0:00:09.79,Default,Aki,0,0,0,,Sau này mày có con gái rồi thì mày cũng y chang tao thôi con trai ạ.
Dialogue: 0,0:00:09.79,0:00:11.70,Default,Oka,0,0,0,,Cháu thề là sẽ không bao giờ có chuyện đó đâu.
Dialogue: 0,0:00:11.70,0:00:13.96,Default,Nag,0,0,0,,Em thấy anh có khi cũng sẽ như thế đấy,
Dialogue: 0,0:00:13.96,0:00:15.87,Default,Nag,0,0,0,,bởi vì anh giống bố em lắm mà.
Dialogue: 0,0:00:15.87,0:00:17.54,Default,Aki,0,0,0,,Cái gì cơ? Tao với nó giống nhau á?!
Dialogue: 0,0:00:18.42,0:00:19.92,Default,Aki,0,0,0,,Được hai tháng rồi cơ à?
Dialogue: 0,0:00:20.96,0:00:22.13,Default,Nag,0,0,0,,Vâng, đã được hai tháng rồi ạ.
Dialogue: 0,0:00:22.13,0:00:23.63,Default,Aki,0,0,0,,Mày nhất định sẽ sinh đứa bé ra chứ?
Dialogue: 0,0:00:23.63,0:00:25.30,Default,Nag,0,0,0,,Tất nhiên rồi ạ.
Dialogue: 0,0:00:25.30,0:00:26.84,Default,Aki,0,0,0,,Chuyện này gian nan và vất vả lắm đấy biết chưa?
Dialogue: 0,0:00:27.72,0:00:28.64,Default,Oka,0,0,0,,Cháu sẽ bảo vệ cô ấy.
Dialogue: 0,0:00:31.81,0:00:34.69,Default,Nag,0,0,0,,Có Tomoya-kun ở bên cạnh chở che, con sẽ không sao đâu ạ.
Dialogue: 0,0:00:35.06,0:00:37.81,Default,Nag,0,0,0,,Từ trước đến nay hai đứa con vẫn luôn đồng hành cùng nhau mà.
Dialogue: 0,0:00:37.81,0:00:40.86,Default,San,0,0,0,,Cậu ấy trông giống hệt anh ngày ấy đấy, Akio-san.
Dialogue: 0,0:00:41.73,0:00:48.03,Default,San,0,0,0,,Hồi em mang thai Nagisa trong bụng, anh cũng từng nói sẽ bảo vệ hai mẹ con như thế.
Dialogue: 0,0:00:48.03,0:00:49.37,Default,Aki,0,0,0,,Hồi đó tao cũng nói thế thật à?
Dialogue: 0,0:00:52.45,0:00:54.54,Default,Aki,0,0,0,,Cố lên nhé, thằng lông bông.
Dialogue: 0,0:00:55.29,0:00:56.79,Default,Oka,0,0,0,,'Thằng lông bông' sao...
Dialogue: 0,0:00:56.79,0:00:59.29,Default,Oka,0,0,0,,Nhưng từ nay, mình không được phép lông bông như trước nữa rồi.
Dialogue: 0,0:01:00.13,0:01:02.30,Default,Oka,0,0,0,,Có lẽ Nagisa sẽ phải tạm nghỉ công việc hiện tại.
Dialogue: 0,0:01:03.09,0:01:06.80,Default,Oka,0,0,0,,Mình sẽ phải gánh vác sinh kế cho cả ba sinh mệnh.
Dialogue: 0,0:01:07.26,0:01:09.80,Default,Oka,0,0,0,,Đây chính là nơi khởi đầu cho thử thách của gia đình nhỏ của mình.
Dialogue: 0,0:01:11.85,0:01:12.72,Default,Oka,0,0,0,,Bỗng nhiên, một ý nghĩ thoáng qua trong tâm trí tôi.
Dialogue: 0,0:01:13.89,0:01:18.10,Default,Oka,0,0,0,,Liệu ngày xưa trước khi mình chào đời, ông già có từng nghĩ những điều như thế này không?
Dialogue: 0,0:01:38.04,0:01:43.63,OP English,,0,0,0,,{\be1\fad(250,0)}Nơi lưng chừng con dốc năm nào chỉ riêng em cất bước...
