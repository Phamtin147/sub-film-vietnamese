Dialogue: 0,0:02:51.82,0:02:52.74,Default,Yos,0,0,0,,Chúc mừng cậu nhé.
Dialogue: 0,0:02:52.74,0:02:53.62,Default,Oka,0,0,0,,Dạ?
Dialogue: 0,0:02:53.62,0:02:56.49,Default,Yos,0,0,0,,Tôi nghe nói cậu sắp có em bé rồi.
Dialogue: 0,0:02:56.49,0:02:57.29,Default,Guys,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:02:57.29,0:02:59.20,Default,Guys,0,0,0,,Vợ cậu có em bé rồi đấy à?
Dialogue: 0,0:02:59.91,0:03:02.75,Default,John,0,0,0,,Xin chúc mừng cậu nhé, Okazaki-kun.
Dialogue: 0,0:03:03.08,0:03:05.59,Default,Oka,0,0,0,,Dạ chưa, em bé đã sinh đâu ạ.
Dialogue: 0,0:03:06.25,0:03:08.42,Default,Oka,0,0,0,,Anh Yoshino, ai kể cho anh nghe thế ạ?
Dialogue: 0,0:03:08.42,0:03:11.18,Default,Yos,0,0,0,,Vợ tôi nghe được từ Sanae-san đấy.
Dialogue: 0,0:03:11.80,0:03:13.84,Default,Yos,0,0,0,,Cả khu phố này ai nấy đều biết chuyện hết rồi.
Dialogue: 0,0:03:14.47,0:03:16.35,Default,Oka,0,0,0,,Đúng là đáng sợ thật: sức mạnh của tin đồn hàng xóm láng giềng.
Dialogue: 0,0:03:16.81,0:03:19.68,Default,Yos,0,0,0,,Cậu vẫn còn phải học hỏi nhiều với tư cách một người đàn ông trưởng thành,
Dialogue: 0,0:03:19.68,0:03:23.10,Default,Yos,0,0,0,,nhưng kể từ giờ, dù muốn hay không\Ncậu cũng phải gánh vác trách nhiệm như một người chồng thực thụ đấy.
Dialogue: 0,0:03:23.10,0:03:26.61,Default,Oka,0,0,0,,Dạ vâng... nhưng em vẫn thấy có chút gì đó chưa chân thực lắm.
Dialogue: 0,0:03:26.61,0:03:30.11,Default,Yos,0,0,0,,Một khi đứa bé cất tiếng khóc chào đời, cậu sẽ tự khắc cảm nhận được thôi.
Dialogue: 0,0:03:30.61,0:03:34.11,Default,Yos,0,0,0,,Trên thế gian này chẳng có ai có thể sống cô độc một mình được cả.
Dialogue: 0,0:03:34.62,0:03:39.12,Default,Yos,0,0,0,,Mọi người đều sống nhờ vào việc nâng đỡ\Nvà được những người khác nâng đỡ, chở che.
Dialogue: 0,0:03:35.99,0:03:37.83,Default-alt,Guy,0,0,0,,Lại bắt đầu bài ca triết lý rồi đấy...
Dialogue: 0,0:03:39.62,0:03:43.83,Default,Yos,0,0,0,,Đã 4,5 tỷ năm trôi qua kể từ khi Trái Đất được hình thành giữa vũ trụ bao la này...
Dialogue: 0,0:03:42.58,0:03:46.25,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 15
Dialogue: 0,0:03:42.58,0:03:46.25,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Tàn Dư Mùa Hạ
Dialogue: 0,0:03:46.25,0:03:49.25,Default,Oka,0,0,0,,Những ngày tháng sau đó trôi qua nhanh như một cơn gió.
Dialogue: 0,0:03:50.09,0:03:55.51,Default,Oka,0,0,0,,{\fs81}Bước sang tháng thứ ba của thai kỳ, chứng ốm nghén trở nên trầm trọng hơn và Nagisa phải nằm bẹp trên giường gần như suốt ngày.
Dialogue: 0,0:03:55.89,0:03:59.43,Default,Nag,0,0,0,,Em xin lỗi vì đã làm phiền anh...
Dialogue: 0,0:03:59.43,0:04:03.10,Default,Oka,0,0,0,,Đừng bận tâm, mấy việc vặt này anh lo liệu được hết mà.
Dialogue: 0,0:04:03.10,0:04:04.52,Default,Nag,0,0,0,,Em xin lỗi anh nhiều lắm.
Dialogue: 0,0:04:04.52,0:04:06.40,Default,Oka,0,0,0,,Đừng có xin lỗi nữa mà.
Dialogue: 0,0:04:06.73,0:04:08.52,Default,Oka,0,0,0,,Hai đứa mình cùng nhau gánh vác mà, đúng không?
Dialogue: 0,0:04:10.65,0:04:12.40,Default,Oka,0,0,0,,Em đã ăn được chút gì chưa?
Dialogue: 0,0:04:12.40,0:04:14.53,Default,Nag,0,0,0,,Em không ăn được bao nhiêu cả.
Dialogue: 0,0:04:14.86,0:04:17.70,Default,Oka,0,0,0,,Không có cách nào làm cho em dễ chịu hơn một chút sao?
Dialogue: 0,0:04:17.70,0:04:21.75,Default,Nag,0,0,0,,Nghe nói người ta còn chẳng rõ nguyên nhân vì sao lại bị ốm nghén nữa cơ.
Dialogue: 0,0:04:21.75,0:04:26.83,Default,Nag,0,0,0,,Uống nước lọc vào là em lại thấy buồn nôn, nên em phải ngậm mấy viên này để bổ sung nước.
Dialogue: 0,0:04:35.72,0:04:36.97,Default,Nag,0,0,0,,Vị của nó ngon lắm ạ.
Dialogue: 0,0:04:52.23,0:04:54.57,Default,Oka,0,0,0,,A, anh xin lỗi. Anh làm em thức giấc à?
Dialogue: 0,0:04:54.57,0:04:55.82,Default,Oka,0,0,0,,Em thấy trong người thế nào rồi?
Dialogue: 0,0:04:56.32,0:04:57.74,Default,Nag,0,0,0,,Bây giờ em thấy đỡ hơn nhiều rồi ạ.
Dialogue: 0,0:04:57.74,0:04:59.03,Default,Oka,0,0,0,,Thế thì tốt quá rồi.
Dialogue: 0,0:04:59.03,0:05:01.83,Default,Oka,0,0,0,,Tranh thủ lúc này em ăn một chút đi nhé, dù chỉ một ít thôi cũng được.
Dialogue: 0,0:05:03.62,0:05:04.33,Default,Oka,0,0,0,,Em thấy thế nào?
Dialogue: 0,0:05:06.67,0:05:08.75,Default,Nag,0,0,0,,Cái này là do anh tự làm đấy ư?
Dialogue: 0,0:05:08.75,0:05:11.67,Default,Oka,0,0,0,,Anh chưa quen tay lắm nên hình thù nó hơi... em biết đấy...
Dialogue: 0,0:05:11.96,0:05:14.84,Default,Nag,0,0,0,,Em cảm ơn anh nhiều lắm. Em xin phép ăn đây ạ.
Dialogue: 0,0:05:21.39,0:05:22.51,Default,Nag,0,0,0,,Ngon lắm anh ơi!
Dialogue: 0,0:05:25.68,0:05:28.06,Default,Oka,0,0,0,,Giữa những ngày tháng trôi qua vội vã,
Dialogue: 0,0:05:28.77,0:05:31.36,Default,Oka,0,0,0,,cả tôi và Nagisa đều mang trong lòng bao nỗi thấp thỏm, bồi hồi.
Dialogue: 0,0:05:31.77,0:05:33.78,Default,Nag,0,0,0,,Chào buổi sáng anh.
Dialogue: 0,0:05:34.61,0:05:36.15,Default,Oka,0,0,0,,Em dậy thế này có ổn không đấy?
Dialogue: 0,0:05:36.15,0:05:38.61,Default,Nag,0,0,0,,Hôm nay em thấy trong người rất khỏe khoắn ạ.
Dialogue: 0,0:05:38.95,0:05:43.24,Default,Nag,0,0,0,,Bác sĩ bảo qua tuần thứ mười thì mọi thứ sẽ bắt đầu ổn định dần.
Dialogue: 0,0:05:43.58,0:05:45.29,Default,Nag,0,0,0,,Đúng y như lời bác sĩ nói luôn.
Dialogue: 0,0:05:45.70,0:05:47.29,Default,Oka,0,0,0,,Thế tức là em bé đang phát triển rất tốt rồi.
Dialogue: 0,0:05:47.29,0:05:49.92,Default,Nag,0,0,0,,Vâng ạ. Em mừng quá chừng.
Dialogue: 0,0:05:52.34,0:05:55.51,Default,Nag,0,0,0,,Dạ ừm, có chuyện này em muốn bàn bạc với anh ạ.
Dialogue: 0,0:05:55.92,0:05:57.67,Default,Oka,0,0,0,,Sinh con tại nhà sao?
