Dialogue: 0,0:02:11.41,0:02:13.95,Default,Oka,0,0,0,,Cậu họp phụ huynh và định hướng nghề nghiệp xong rồi à?
Dialogue: 0,0:02:13.95,0:02:21.58,Default,Nag,0,0,0,,Vâng. Vì tớ không nghĩ ra mình muốn học gì ở đại học, nên tớ tính sẽ đi xin việc làm.
Dialogue: 0,0:02:21.58,0:02:24.21,Default,Oka,0,0,0,,Cậu học giỏi thế mà... Uổng phí thật đấy.
Dialogue: 0,0:02:24.21,0:02:27.46,Default,Nag,0,0,0,,Sau khi tốt nghiệp thì Tomoya-kun sẽ làm gì?
Dialogue: 0,0:02:33.51,0:02:36.81,Default,Oka,0,0,0,,Này... Cậu có muốn nhận quà gì không?
Dialogue: 0,0:02:36.81,0:02:40.10,Default,Nag,0,0,0,,Có liên quan gì đến chuyện tốt nghiệp không ạ?
Dialogue: 0,0:02:40.48,0:02:44.65,Default,Oka,0,0,0,,Không hẳn, tự dưng tớ bỗng thấy muốn tặng cậu một món quà thôi.
Dialogue: 0,0:02:46.86,0:02:50.20,Default,Nag,0,0,0,,Cậu lại lảng tránh đổi chủ đề nữa rồi.
Dialogue: 0,0:02:50.20,0:02:53.53,Default,Nag,0,0,0,,Tự dưng không vì lý do gì mà nhận quà thì tớ ngại lắm.
Dialogue: 0,0:02:53.99,0:02:58.83,Default,Oka,0,0,0,,Muốn tặng quà cho người mình yêu thương\Nchẳng lẽ lại không phải là lý do chính đáng à?
Dialogue: 0,0:02:58.83,0:03:03.75,Default,Nag,0,0,0,,Nếu thế thì ngày nào tớ cũng phải tặng quà cho Tomoya-kun mất rồi.
Dialogue: 0,0:03:07.84,0:03:13.22,Default,Oka,0,0,0,,{\fs78.3}Cơ mà nếu tuân theo đúng quy tắc đó,\Nthì quà cáp chỉ được trao vào dịp sinh nhật với Giáng sinh thôi.
Dialogue: 0,0:03:13.55,0:03:16.51,Default,Nag,0,0,0,,Trong trường hợp của tớ thì chỉ có đúng một ngày để nhận quà thôi đấy.
Dialogue: 0,0:03:17.39,0:03:18.27,Default,Oka,0,0,0,,Tại sao chứ?
Dialogue: 0,0:03:18.27,0:03:21.81,Default,Nag,0,0,0,,Tớ sinh đúng vào ngày 24 tháng 12 mà.
Dialogue: 0,0:03:21.81,0:03:25.06,Default,Oka,0,0,0,,Sao trong bao nhiêu ngày cậu lại chọn sinh đúng vào ngày đó cơ chứ?
Dialogue: 0,0:03:25.06,0:03:28.23,Default,Nag,0,0,0,,Chuyện đó thì cậu đi mà phàn nàn với Bố Mẹ tớ ấy.
Dialogue: 0,0:03:29.57,0:03:32.61,Default,Oka,0,0,0,,Được rồi! Chúng mình cùng đi hẹn hò nhé.
Dialogue: 0,0:03:33.95,0:03:35.07,Default,Nag,0,0,0,,Hẹn hò ạ?
Dialogue: 0,0:03:36.62,0:03:39.20,Default,Oka,0,0,0,,Nếu cậu không chịu nhận quà thì chúng mình đi hẹn hò.
Dialogue: 0,0:03:39.75,0:03:40.79,Default,Oka,0,0,0,,Cậu vui chứ?
Dialogue: 0,0:03:42.33,0:03:43.00,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:03:43.71,0:03:44.79,Default,Nag,0,0,0,,Tớ vui lắm.
Dialogue: 0,0:03:46.50,0:03:48.38,Default,Oka,0,0,0,,Tớ lên lớp đây nhé.
Dialogue: 0,0:03:48.38,0:03:50.17,Default,Nag,0,0,0,,Vâng. Lát nữa gặp lại cậu nhé.
Dialogue: 0,0:03:50.84,0:03:53.47,Default,Nag,0,0,0,,Ủa khoan đã, tụi mình đang nói về tương lai của cậu cơ mà.
Dialogue: 0,0:03:53.47,0:03:55.09,Default,Nag,0,0,0,,Tomoya-kun...
Dialogue: 0,0:04:00.64,0:04:04.31,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\pos(960,410.000015)\3c&H4A8A5C&}Tập 9
Dialogue: 0,0:04:00.64,0:04:04.31,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Trên con đường dốc
Dialogue: 0,0:04:05.81,0:04:07.40,Default,Oka,0,0,0,,Tương lai của mình sao...
Dialogue: 0,0:04:07.40,0:04:09.19,Default,Sun,0,0,0,,Chào buổi sáng, Okazaki!
Dialogue: 0,0:04:09.19,0:04:10.98,Default,Sun,0,0,0,,Và một cái nắp bồn cầu.
Dialogue: 0,0:04:10.98,0:04:12.74,Default,Oka,0,0,0,,Mày diễn trò đó rồi.
Dialogue: 0,0:04:12.74,0:04:15.11,Default,Sun,0,0,0,,Mới sáng sớm ra mà mặt mày đã ủ rũ ảm đạm thế kia rồi.
Dialogue: 0,0:04:15.11,0:04:17.66,Default,Sun,0,0,0,,Mày lại cãi nhau với Nagisa-chan đấy à?
Dialogue: 0,0:04:18.87,0:04:21.45,Default,Oka,0,0,0,,Này... Mày đã tính xem sau khi tốt nghiệp sẽ làm gì chưa?
Dialogue: 0,0:04:22.83,0:04:23.79,Default,Sun,0,0,0,,Đương nhiên là rồi chứ sao.
Dialogue: 0,0:04:23.79,0:04:29.09,Default,Sun,0,0,0,,Để cô em gái đáng yêu không phải lo lắng, tao đã nghiêm túc suy nghĩ chín chắn và đưa ra kết luận rồi!
Dialogue: 0,0:04:29.09,0:04:30.00,Default,Oka,0,0,0,,Thật đấy à?
Dialogue: 0,0:04:30.00,0:04:32.71,Default,Sun,0,0,0,,Ừ! Tao sẽ dùng nhan sắc trời ban này để kiếm tiền!
Dialogue: 0,0:04:33.51,0:04:35.88,Default,Sun,0,0,0,,Làm người mẫu đấy mày ạ. Người mẫu chuyên nghiệp!
Dialogue: 0,0:04:35.88,0:04:36.89,Default,Oka,0,0,0,,Người mẫu á?
Dialogue: 0,0:04:36.89,0:04:40.26,Default,Sun,0,0,0,,Tao thấy tao sinh ra là để làm người mẫu mà lị.
Dialogue: 0,0:04:40.26,0:04:43.85,Default,Sun,0,0,0,,Làm người mẫu rồi lấn sân sang giới giải trí showbiz cũng dễ ợt đúng không?
Dialogue: 0,0:04:43.85,0:04:44.52,Default,Sun,0,0,0,,Chết dở thật!
Dialogue: 0,0:04:45.31,0:04:46.85,Default,Sun,0,0,0,,Khéo tao lại trở nên nổi tiếng quá mức mất thôi.
Dialogue: 0,0:04:47.40,0:04:51.40,Default,Sun,0,0,0,,Tao sẽ hớp hồn hàng tá em gái trẻ đẹp\Nrồi thành lập Quân đoàn Sunohara hùng mạnh.
Dialogue: 0,0:04:51.40,0:04:53.90,Default,Oka,0,0,0,,Mày đúng là lạc quan vô bờ bến thật đấy.
Dialogue: 0,0:04:54.99,0:04:57.36,Default,Sun,0,0,0,,Tương lai của tao ngập tràn ánh hào quang mà lị!
Dialogue: 0,0:04:59.03,0:05:02.04,Default,Ryo,0,0,0,,Được đấy! Sunohara-kun, cậu hoàn toàn có thể trở thành người mẫu được đấy!
Dialogue: 0,0:05:02.04,0:05:03.91,Default,Sun,0,0,0,,Thật á?! Tuyệt cú mèo!
Dialogue: 0,0:05:03.91,0:05:06.16,Default,Ryo,0,0,0,,Cậu sẽ trở thành một người mẫu vô cùng nổi tiếng.
Dialogue: 0,0:05:06.16,0:05:10.63,Default,Ryo,0,0,0,,Cậu sẽ bước chân vào làng giải trí và lập nên Quân đoàn Sunohara nữa đấy.
Dialogue: 0,0:05:10.63,0:05:12.05,Default,Sun,0,0,0,,Được lắm!
Dialogue: 0,0:05:12.05,0:05:15.34,Default,Sun,0,0,0,,Okazaki! Một ngày nào đó tao sẽ tuyển mộ mày vào quân đoàn của tao nhé!
Dialogue: 0,0:05:16.13,0:05:17.97,Default,Oka,0,0,0,,Tao sẽ chờ xem.
Dialogue: 0,0:05:19.47,0:05:22.39,Default,Tom,0,0,0,,Ở đây trừ em ra thì mọi người đều là học sinh năm ba hết rồi nhỉ?
Dialogue: 0,0:05:22.39,0:05:25.31,Default,Tom,0,0,0,,Mọi người đã quyết định sau khi tốt nghiệp sẽ làm gì chưa ạ?
Dialogue: 0,0:05:25.31,0:05:28.65,Default,Ryo,0,0,0,,Tớ dự định sẽ theo học trường đào tạo điều dưỡng.
Dialogue: 0,0:05:28.65,0:05:30.56,Default,Ryo,0,0,0,,Đó là ước mơ mà tớ hằng ấp ủ bấy lâu nay rồi.
Dialogue: 0,0:05:30.56,0:05:33.32,Default,Kyo,0,0,0,,Mục tiêu của tớ là trở thành giáo viên mầm non.
Dialogue: 0,0:05:33.32,0:05:35.53,Default,Kyo,0,0,0,,Nên tớ sẽ học một trường để lấy chứng chỉ chuyên môn cần thiết.
Dialogue: 0,0:05:36.78,0:05:42.12,Default,Kot,0,0,0,,Mình nghĩ... mình sẽ đi du học ở Mỹ.
Dialogue: 0,0:05:43.41,0:05:46.20,Default,Kot,0,0,0,,Sẽ buồn lắm khi phải nói lời tạm biệt với mọi người,
Dialogue: 0,0:05:46.83,0:05:50.92,Default,Kot,0,0,0,,nhưng mình sẽ cố gắng về thăm Nhật Bản thường xuyên nhất có thể.
Dialogue: 0,0:05:51.59,0:05:55.71,Default,Tom,0,0,0,,Vậy là bọn em sẽ không còn được nghe\Ntiếng đàn vĩ cầm nghẹt thở của chị nữa rồi nhỉ?
Dialogue: 0,0:05:56.05,0:05:58.01,Default,Kot,0,0,0,,Nếu em khao khát được nghe thì chị có thể kéo đàn—
Dialogue: 0,0:05:58.01,0:05:59.22,Default,Kyo,0,0,0,,Dừng lại ngay!
Dialogue: 0,0:05:59.22,0:06:00.93,Default,Kyo,0,0,0,,Chuyện đó giữ trong lòng thôi là được rồi.
Dialogue: 0,0:06:03.18,0:06:07.77,Default,Kyo,0,0,0,,Em phải học cách tinh ý nắm bắt tình hình hơn đi nhé.
Dialogue: 0,0:06:07.77,0:06:10.90,Default,Tom,0,0,0,,Em xin lỗi. Em đang cố gắng sửa đổi đây ạ, nhưng mà...
Dialogue: 0,0:06:10.90,0:06:13.23,Default,Kot,0,0,0,,Em ấy bất lịch sự quá chừng.
Dialogue: 0,0:06:14.07,0:06:16.49,Default,Ryo,0,0,0,,Thế còn Okazaki-kun thì sao, cậu tính làm gì?
Dialogue: 0,0:06:17.07,0:06:19.78,Default,Kyo,0,0,0,,Nghe đồn cậu còn chưa quyết định là sẽ học tiếp hay đi làm nữa cơ mà,
Dialogue: 0,0:06:19.78,0:06:22.95,Default,Kyo,0,0,0,,lại còn toàn trốn tránh thầy cô giáo nữa chứ.
Dialogue: 0,0:06:24.33,0:06:28.54,Default,Kyo,0,0,0,,Này Nagisa, em phải tét vào mông thằng Tomoya nhiều hơn nữa vào đấy nhé.
Dialogue: 0,0:06:29.50,0:06:30.42,Default,Kyo,0,0,0,,Ủa Nagisa?
Dialogue: 0,0:06:31.79,0:06:33.29,Default,Oka,0,0,0,,Cậu sao thế, Nagisa?
Dialogue: 0,0:06:34.54,0:06:38.84,Default,Nag,0,0,0,,Tớ xin lỗi... Tự dưng tớ thấy hơi...
Dialogue: 0,0:06:38.84,0:06:39.34,Default,Oka,0,0,0,,Nagisa!
Dialogue: 0,0:06:42.80,0:06:43.80,Default,Oka,0,0,0,,Cậu ấy sốt cao rồi!
Dialogue: 0,0:06:48.48,0:06:50.85,Default,Sun,0,0,0,,Mày không ở lại chăm sóc cho Nagisa-chan à?
Dialogue: 0,0:06:50.85,0:06:53.52,Default,Oka,0,0,0,,Bác sĩ đang ở nhà cậu ấy rồi.
Dialogue: 0,0:06:53.52,0:06:56.27,Default,Oka,0,0,0,,Tao mà ở đó khéo chỉ tổ làm vướng chân vướng tay người ta thôi.
Dialogue: 0,0:06:57.61,0:06:58.32,Default,Sun,0,0,0,,Mời vào.
Dialogue: 0,0:06:58.82,0:07:01.57,Default,Mis,0,0,0,,Sunohara. Có điện thoại của em gái cậu gọi tới này.
Dialogue: 0,0:07:02.36,0:07:04.03,Default,Sun,0,0,0,,Dạ có em ngay.
Dialogue: 0,0:07:05.41,0:07:06.95,Default,Sun,0,0,0,,Mày có muốn nhắn nhủ gì cho con bé không?
Dialogue: 0,0:07:06.95,0:07:09.50,Default,Oka,0,0,0,,Bảo con bé rảnh thì lại lên đây chơi nhé.
Dialogue: 0,0:07:09.50,0:07:12.50,Default,Oka,0,0,0,,À, nhưng đừng kể cho nó biết chuyện Nagisa bị ốm đấy.
Dialogue: 0,0:07:12.96,0:07:14.04,Default,Sun,0,0,0,,Biết rồi.
Dialogue: 0,0:07:15.92,0:07:17.21,Default,Mis,0,0,0,,Ý cậu là sao cơ?
Dialogue: 0,0:07:17.21,0:07:18.92,Default,Mis,0,0,0,,Furukawa-san bị ốm à?
Dialogue: 0,0:07:19.34,0:07:22.59,Default,Oka,0,0,0,,Sức khỏe cậu ấy vốn dĩ từ bé đã không tốt rồi.
Dialogue: 0,0:07:23.26,0:07:27.51,Default,Oka,0,0,0,,Năm ngoái cậu ấy cũng phải lưu ban ở lại lớp vì thiếu số ngày đi học cũng vì lý do đó.
Dialogue: 0,0:07:28.64,0:07:29.47,Default,Mis,0,0,0,,Ra là vậy...
Dialogue: 0,0:07:34.69,0:07:36.61,Default,Mis,0,0,0,,Cậu nhớ chăm sóc cho em ấy thật chu đáo nhé.
Dialogue: 0,0:07:47.78,0:07:48.99,Default,Oka,0,0,0,,Nagisa.
Dialogue: 0,0:07:49.79,0:07:50.54,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:07:52.16,0:07:54.46,Default,Oka,0,0,0,,Cậu đừng gượng dậy. Cứ nằm nghỉ đi.
Dialogue: 0,0:07:54.79,0:07:56.88,Default,Nag,0,0,0,,Vâng, cảm ơn cậu nhiều nhé.
Dialogue: 0,0:07:58.63,0:07:59.75,Default,Oka,0,0,0,,Tớ đi học đây nhé.
Dialogue: 0,0:07:59.75,0:08:01.67,Default,Nag,0,0,0,,Vâng. Chúc cậu một ngày tốt lành.
Dialogue: 0,0:08:01.67,0:08:03.18,Default,Oka,0,0,0,,Cậu nghỉ ngơi cho khỏe đấy nhé?
Dialogue: 0,0:08:03.76,0:08:04.68,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:08:09.64,0:08:11.56,Default,Sun,0,0,0,,Mày có đang lo lắng thái quá không đấy?
Dialogue: 0,0:08:11.56,0:08:14.48,Default,Sun,0,0,0,,Chuyện này hồi trước cũng từng xảy ra rồi mà đúng không?
Dialogue: 0,0:08:11.56,0:08:15.06,Default-alt,Bot,0,0,0,,Ụt ịt! Ụt ịt! Ụt ịt! Ụt ịt! Ụt ịt! Ụt ịt! Ụt ịt!
Dialogue: 0,0:08:15.06,0:08:19.27,Default,Sun,0,0,0,,Lần trước Nagisa-chan bị ốm,\Nmày cũng hoảng loạn mất hết cả lý trí.
Dialogue: 0,0:08:19.27,0:08:21.53,Default,Sun,0,0,0,,Ý tao là, cứ vào những thời điểm then chốt là mày lại...
Dialogue: 0,0:08:21.53,0:08:23.61,Default,Bot,0,0,0,,Ụt ịt ịt. Ụt ịt.
Dialogue: 0,0:08:23.61,0:08:24.03,Default,Bot,0,0,0,,Ụt ịt!
Dialogue: 0,0:08:26.53,0:08:27.16,Default,Bot,0,0,0,,Ụt ịt?
Dialogue: 0,0:08:27.53,0:08:28.12,Default,Bot,0,0,0,,Ụt ịt!
Dialogue: 0,0:08:28.78,0:08:30.70,Default,Oka,0,0,0,,Mày lại đến tìm Kyou nữa đấy à?
Dialogue: 0,0:08:30.74,0:08:31.66,Default,Kyo,0,0,0,,Tomoya!
Dialogue: 0,0:08:32.12,0:08:33.25,Default,Bot,0,0,0,,Ụt ịt.
Dialogue: 0,0:08:34.33,0:08:36.83,Default,Kyo,0,0,0,,Ủa, không phải cậu định bắt nó làm thịt đấy chứ?
Dialogue: 0,0:08:36.83,0:08:39.67,Default,Oka,0,0,0,,Chưa rõ đầu đuôi tai nheo gì đã tấn công người ta rồi!
Dialogue: 0,0:08:39.67,0:08:42.76,Default,Ryo,0,0,0,,Bây giờ tính sao với bé đây? Bé tự đi về nhà một mình được không?
Dialogue: 0,0:08:42.76,0:08:44.13,Default,Bot,0,0,0,,Ụt ịt ụt ịt.
Dialogue: 0,0:08:44.13,0:08:46.72,Default,Oka,0,0,0,,Có vẻ như nó muốn ở cùng cậu đấy.
Dialogue: 0,0:08:47.89,0:08:50.81,Default,Kyo,0,0,0,,Không đời nào. Chiều nay tớ có tiết thể dục rồi.
Dialogue: 0,0:08:50.81,0:08:52.35,Default,Kyo,0,0,0,,Cậu trông chừng nó giùm tớ được không?
Dialogue: 0,0:08:52.35,0:08:53.60,Default,Oka,0,0,0,,Sao lại là tôi?
Dialogue: 0,0:08:53.60,0:08:57.44,Default,Ryo,0,0,0,,Như thế không ổn đâu chị. Dù sao em cũng là chủ của bé mà, để em—
Dialogue: 0,0:08:57.44,0:08:58.23,Default,Bot,0,0,0,,Ụt ịt!
Dialogue: 0,0:08:58.94,0:08:59.61,Default,Bot,0,0,0,,Ụt ịt ụt ịt ụt ịt!
Dialogue: 0,0:09:00.69,0:09:02.82,Default,Oka,0,0,0,,Nó ghét cậu à?
Dialogue: 0,0:09:02.82,0:09:03.74,Default,Ryo,0,0,0,,Dạ không...
Dialogue: 0,0:09:03.74,0:09:07.03,Default,Ryo,0,0,0,,Hôm trước em vừa thử tắm cho bé,
Dialogue: 0,0:09:07.03,0:09:11.41,Default,Ryo,0,0,0,,nhưng nước nóng quá làm bé cứ tưởng em định luộc chín bé lên để ăn thịt.
Dialogue: 0,0:09:11.41,0:09:12.62,Default,Bot,0,0,0,,Ụt ịt ụt ịt ụt ịt ụt ịt!
Dialogue: 0,0:09:12.62,0:09:15.04,Default,Kyo,0,0,0,,Thế nên là nhờ cậu chăm sóc nó đấy nhé.
Dialogue: 0,0:09:12.62,0:09:13.29,Default-alt,Bot,0,0,0,,Ụt ịt!
Dialogue: 0,0:09:15.04,0:09:18.25,Default,Oka,0,0,0,,Cậu bắt tôi ngồi học suốt cả buổi với con heo này trên đùi đấy à?
Dialogue: 0,0:09:15.96,0:09:18.25,Default-alt,Bot,0,0,0,,Ụt ịt ụt ịt...
Dialogue: 0,0:09:18.25,0:09:19.50,Default,Kyo,0,0,0,,Botan, giả làm búp bê!
Dialogue: 0,0:09:19.50,0:09:20.38,Default,Bot,0,0,0,,Ụt!
Dialogue: 0,0:09:20.38,0:09:22.84,Default,Kyo,0,0,0,,Đó là một trong bảy tuyệt kỹ bí truyền của Botan đấy.
Dialogue: 0,0:09:23.30,0:09:28.22,Default,Kyo,0,0,0,,Cứ ôm nó như thế,\Nngười ta sẽ chỉ tưởng cậu là một gã cuồng gấu bông thôi.
Dialogue: 0,0:09:34.56,0:09:36.39,Default,Sun,0,0,0,,Mày làm cái trò gì đấy?
Dialogue: 0,0:09:38.48,0:09:40.56,Default,Oka,0,0,0,,Cậu nợ tôi một món nợ lớn đấy nhé.
Dialogue: 0,0:09:40.56,0:09:43.53,Default,Kyo,0,0,0,,Mai tớ khao cậu một hộp sữa chua hoa quả.
Dialogue: 0,0:09:43.53,0:09:44.86,Default,Oka,0,0,0,,Thế thì còn lâu mới đủ.
Dialogue: 0,0:09:44.86,0:09:46.44,Default,Ryo,0,0,0,,Em thật lòng xin lỗi cậu nhiều lắm ạ.
Dialogue: 0,0:09:47.95,0:09:52.45,Default,Tom,0,0,0,,Tụi mình tính ghé qua nhà thăm Furukawa-san một chút.
Dialogue: 0,0:09:52.45,0:09:56.45,Default,Oka,0,0,0,,À, tiếc là hôm nay gia đình bảo sẽ đưa cậu ấy đến bệnh viện rồi.
Dialogue: 0,0:09:57.33,0:10:00.08,Default,Kyo,0,0,0,,Vậy à. Thế cậu gửi lời hỏi thăm của bọn tớ đến cậu ấy nhé.
Dialogue: 0,0:10:00.08,0:10:00.96,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:10:01.33,0:10:02.71,Default,Oka,0,0,0,,Hẹn gặp lại mọi người nhé.
Dialogue: 0,0:10:07.34,0:10:10.22,Default,Kyo,0,0,0,,Hi vọng chuyện đó giúp cậu ấy vơi bớt phần nào âu lo.
Dialogue: 0,0:10:07.80,0:10:08.55,Default-alt,Bot,0,0,0,,Ụt ịt?
Dialogue: 0,0:10:10.22,0:10:11.34,Default,Bot,0,0,0,,Ụt ịt...
Dialogue: 0,0:10:11.34,0:10:14.93,Default,Kot,0,0,0,,Tomoya-kun đang không vui.
Dialogue: 0,0:10:14.93,0:10:18.56,Default,Sun,0,0,0,,Cậu ấy đôi khi cũng nhạy cảm lắm.
Dialogue: 0,0:10:19.60,0:10:23.36,Default,Ryo,0,0,0,,Mong sao Nagisa-chan sẽ mau chóng bình phục.
Dialogue: 0,0:10:27.24,0:10:28.74,Default,Oka,0,0,0,,Một tháng trôi qua.
Dialogue: 0,0:10:30.57,0:10:32.87,Default,Oka,0,0,0,,Bệnh tình của Nagisa vẫn chẳng hề thuyên giảm.
Dialogue: 0,0:10:35.41,0:10:39.87,Default,Oka,0,0,0,,Có một hôm cảm thấy đỡ hơn, cậu ấy đã cố gắng gượng dậy để đến trường.
Dialogue: 0,0:10:40.37,0:10:44.09,Default,Oka,0,0,0,,Nhưng chỉ mới đi được nửa quãng đường con dốc, cơn sốt lại tái phát dữ dội.
Dialogue: 0,0:10:46.21,0:10:47.92,Default,Nag,0,0,0,,Kỳ thi của cậu thế nào rồi?
Dialogue: 0,0:10:48.67,0:10:49.67,Default,Oka,0,0,0,,Cũng tạm ổn.
Dialogue: 0,0:10:50.18,0:10:52.30,Default,Oka,0,0,0,,Nhờ đợt này tớ đi học đầy đủ hơn trước.
Dialogue: 0,0:10:55.31,0:10:57.06,Default,Nag,0,0,0,,Bây giờ đang là kỳ nghỉ sau thi mà.
Dialogue: 0,0:10:57.52,0:11:00.64,Default,Nag,0,0,0,,Cậu đừng bận tâm đến tớ, cứ đi chơi với mọi người đi.
Dialogue: 0,0:11:03.56,0:11:05.77,Default,Oka,0,0,0,,Để tớ ở lại đây với cậu.
Dialogue: 0,0:11:06.57,0:11:09.28,Default,Nag,0,0,0,,Ở lại đây buồn chán lắm đấy.
Dialogue: 0,0:11:10.86,0:11:15.37,Default,Oka,0,0,0,,Không đâu, tớ sẽ đợi ở đây. Thế là đủ vui với tớ rồi.
Dialogue: 0,0:11:16.16,0:11:18.75,Default,Nag,0,0,0,,Đợi ư? Đợi đến khi nào cơ?
Dialogue: 0,0:11:19.41,0:11:22.17,Default,Oka,0,0,0,,Cho đến ngày hai đứa mình lại có thể nắm tay nhau cùng bước đi.
Dialogue: 0,0:11:23.54,0:11:29.13,Default,Oka,0,0,0,,Tụi mình ở bên nhau suốt ở nhà và ở trường,\Nnhưng lại chẳng mấy khi có cơ hội ở riêng bên nhau đúng không?
Dialogue: 0,0:11:29.13,0:11:33.68,Default,Oka,0,0,0,,Nên tớ muốn được cùng cậu đi hẹn hò và nắm tay nhau thật chặt.
Dialogue: 0,0:11:34.89,0:11:36.68,Default,Nag,0,0,0,,Bây giờ chúng mình đang ở riêng bên nhau này.
Dialogue: 0,0:11:38.31,0:11:39.31,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:11:41.69,0:11:43.65,Default,Nag,0,0,0,,Cậu nắm tay tớ được không?
Dialogue: 0,0:12:02.08,0:12:03.83,Default,Oka,0,0,0,,Tháng mười một gõ cửa.
Dialogue: 0,0:12:04.33,0:12:08.84,Default,Oka,0,0,0,,Kỳ thi tuyển sinh cận kề, học sinh năm ba điên cuồng vùi đầu vào sách vở.
Dialogue: 0,0:12:09.42,0:12:13.47,Default,Oka,0,0,0,,Giữa bầu không khí căng thẳng ấy,\Nđiều duy nhất lấp đầy tâm trí tôi chỉ có Nagisa.
Dialogue: 0,0:12:13.47,0:12:17.10,Default,Yuk,0,0,0,,Băng đĩa kịch nghệ cậu nhờ mình mượn đây nhé.
Dialogue: 0,0:12:17.10,0:12:21.60,Default,Yuk,0,0,0,,Mình đã chọn những vở kịch rất vui nhộn,\Nchỉ xem thôi là đã thấy tràn đầy năng lượng rồi.
Dialogue: 0,0:12:21.60,0:12:24.10,Default,Oka,0,0,0,,Làm phiền cậu quá.
Dialogue: 0,0:12:24.10,0:12:27.61,Default,Yuk,0,0,0,,Bọn mình còn nợ cậu một ân tình lớn cơ mà.
Dialogue: 0,0:12:27.61,0:12:28.86,Default,Oka,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:12:30.40,0:12:33.99,Default,Yuk,0,0,0,,Okazaki-san, dạo này cậu gầy đi đấy à?
Dialogue: 0,0:12:35.86,0:12:37.07,Default,Oka,0,0,0,,Cậu tưởng tượng thôi.
Dialogue: 0,0:12:37.45,0:12:40.95,Default,TV,0,0,0,,Để cảm ơn, xin cho phép tôi mời bạn đến thăm thế giới loài mèo của chúng tôi nhé!
Dialogue: 0,0:12:41.45,0:12:42.95,Default,TV,0,0,0,,Oa, cảm ơn bạn nhiều nhé!
Dialogue: 0,0:12:43.46,0:12:47.08,Default,Oka,0,0,0,,Mùa thu cứ thế lặng lẽ trôi qua.
Dialogue: 0,0:12:50.75,0:12:55.22,Default,Oka,0,0,0,,Bầu không khí căng thẳng ngày một tăng lên, và mùa đông đã cận kề.
Dialogue: 0,0:12:56.93,0:13:00.72,Default,Aki,0,0,0,,Bác nghĩ cháu cũng nên biết chuyện này.
Dialogue: 0,0:13:01.10,0:13:06.52,Default,San,0,0,0,,Okazaki-san. Có thể Nagisa sẽ phải lưu ban ở lại lớp năm ba một lần nữa.
Dialogue: 0,0:13:06.98,0:13:11.48,Default,San,0,0,0,,Con bé không thể tham gia các kỳ thi,\Nvà số ngày đến lớp cũng thiếu hụt trầm trọng.
Dialogue: 0,0:13:11.90,0:13:18.07,Default,San,0,0,0,,Các thầy cô khuyên con bé nên làm thủ tục thôi học để tập trung chữa bệnh cho dứt điểm.
Dialogue: 0,0:13:18.07,0:13:20.99,Default,San,0,0,0,,Gia đình cô chú không quá đặt nặng vấn đề học bạ hay bằng cấp của con bé.
Dialogue: 0,0:13:21.41,0:13:22.49,Default,Oka,0,0,0,,Nhưng Nagisa...
Dialogue: 0,0:13:22.49,0:13:26.41,Default,San,0,0,0,,Cô chú muốn để chính Nagisa tự mình đưa ra quyết định.
Dialogue: 0,0:13:26.41,0:13:31.34,Default,San,0,0,0,,Nên dẫu con bé không thể tốt nghiệp cùng cháu, xin cháu hãy chấp nhận điều đó nhé.
Dialogue: 0,0:13:32.05,0:13:34.42,Default,San,0,0,0,,Cô xin cháu đấy, Okazaki-san.
Dialogue: 0,0:13:38.30,0:13:39.05,Default,Oka,0,0,0,,Không.
Dialogue: 0,0:13:41.93,0:13:44.43,Default,Oka,0,0,0,,Cháu muốn được tốt nghiệp cùng với cậu ấy.
Dialogue: 0,0:13:46.56,0:13:48.77,Default,Oka,0,0,0,,Cháu không muốn bỏ rơi cậu ấy lại phía sau.
Dialogue: 0,0:13:49.77,0:13:50.77,Default,San,0,0,0,,Okazaki-san...
Dialogue: 0,0:13:51.61,0:13:55.61,Default,Oka,0,0,0,,Nếu Nagisa không thể tốt nghiệp, thì cháu cũng không muốn tốt nghiệp nữa.
Dialogue: 0,0:13:58.57,0:14:00.53,Default,Aki,0,0,0,,Mày trẻ con vừa thôi.
Dialogue: 0,0:14:01.28,0:14:04.99,Default,Aki,0,0,0,,Mày mà làm cái trò dại dột đó,\Nthì Nagisa nó sẽ càng đau lòng hơn gấp trăm lần.
Dialogue: 0,0:14:05.45,0:14:06.91,Default,Aki,0,0,0,,Mày thừa hiểu điều đó mà, đúng không?
Dialogue: 0,0:14:08.92,0:14:09.79,Default,Oka,0,0,0,,Bác ấy nói đúng.
Dialogue: 0,0:14:10.67,0:14:12.21,Default,Oka,0,0,0,,Tôi đúng là một đứa trẻ con.
Dialogue: 0,0:14:13.67,0:14:19.43,Default,Oka,0,0,0,,Tôi cứ ngỡ mình đã trưởng thành hơn đôi chút khi có thể giúp đỡ bạn bè,
Dialogue: 0,0:14:20.18,0:14:23.85,Default,Oka,0,0,0,,thế nhưng người con gái tôi yêu lại không thể cùng tôi tốt nghiệp.
Dialogue: 0,0:14:24.64,0:14:30.35,Default,Oka,0,0,0,,Tôi trẻ con đến mức chỉ biết đứng chôn chân trong sự bất lực đến bàng hoàng.
Dialogue: 0,0:14:32.31,0:14:36.28,Default,Oka,0,0,0,,Khi tháng mười hai tới, mọi thứ càng trở nên hối hả bận rộn.
Dialogue: 0,0:14:37.19,0:14:40.36,Default,Oka,0,0,0,,Thi cử. Nộp hồ sơ xét tuyển. Tìm kiếm việc làm.
Dialogue: 0,0:14:41.20,0:14:43.45,Default,Oka,0,0,0,,Tôi như kẻ đứng ngoài rìa của tất cả.
Dialogue: 0,0:14:53.29,0:14:54.79,Default,2,0,0,0,,Chúc mừng sinh nhật cậu!
Dialogue: 0,0:14:54.79,0:14:56.80,Default,Kot,0,0,0,,Chúc mừng sinh nhật Nagisa-chan nhé.
Dialogue: 0,0:14:56.80,0:14:58.97,Default,Sun,0,0,0,,Và cả Giáng sinh an lành nữa!
Dialogue: 0,0:14:58.97,0:15:01.63,Default,Kyo,0,0,0,,Trông cậu đầy năng lượng đối với một kẻ vừa bị trượt phỏng vấn đấy nhỉ.
Dialogue: 0,0:15:02.14,0:15:05.43,Default,Kyo,0,0,0,,Cậu ta nghiêm túc gửi đơn ứng tuyển vào công ty người mẫu thật đấy.
Dialogue: 0,0:15:05.43,0:15:07.18,Default,Sun,0,0,0,,Đó là quyền của tôi mà!
Dialogue: 0,0:15:07.18,0:15:10.85,Default,Sun,0,0,0,,Sang năm tôi sẽ tìm việc làm gần nhà dưới quê,\Nnên chẳng có gì phải xoắn hết!
Dialogue: 0,0:15:14.48,0:15:15.40,Default,Oka,0,0,0,,Nagisa.
Dialogue: 0,0:15:16.98,0:15:19.44,Default,Oka,0,0,0,,Quà của cậu này.
Dialogue: 0,0:15:22.74,0:15:24.12,Default,Nag,0,0,0,,Là bánh Dango kìa!
Dialogue: 0,0:15:36.17,0:15:37.75,Default,Nag,0,0,0,,Tớ cảm ơn cậu nhiều lắm.
Dialogue: 0,0:15:45.22,0:15:47.56,Default,Nag,0,0,0,,Cảm ơn mọi người nhiều lắm ạ.
Dialogue: 0,0:15:47.89,0:15:49.72,Default,Nag,0,0,0,,Lại cất công đến đây vì một người như em...
Dialogue: 0,0:15:52.44,0:15:54.81,Default,Aki,0,0,0,,Đừng có nói những câu như "một người như con", Nagisa.
Dialogue: 0,0:15:56.06,0:15:58.98,Default,Aki,0,0,0,,Con là thành viên vô giá của gia đình chúng ta mà.
Dialogue: 0,0:16:00.82,0:16:04.20,Default,Kyo,0,0,0,,Bác ấy nói đúng đấy. Cậu là người bạn vô giá của bọn tớ.
Dialogue: 0,0:16:04.74,0:16:09.20,Default,Aki,0,0,0,,Chỉ cần con hạnh phúc, thì bố và mẹ Sanae cũng sẽ thấy hạnh phúc.
Dialogue: 0,0:16:10.75,0:16:13.41,Default,Aki,0,0,0,,Thế nên hãy nắm lấy hạnh phúc của riêng mình nhé, Nagisa.
Dialogue: 0,0:16:19.05,0:16:21.42,Default,Nag,0,0,0,,Vâng ạ. Con sẽ cố gắng hết mình.
Dialogue: 0,0:16:28.05,0:16:29.85,Default,Oka,0,0,0,,Đó là đêm Giáng sinh.
Dialogue: 0,0:16:29.85,0:16:31.27,Default,Oka,0,0,0,,Ngày sinh nhật của Nagisa,
Dialogue: 0,0:16:31.81,0:16:35.56,Default,Oka,0,0,0,,và cũng là ngày việc Nagisa phải lưu ban ở lại lớp đã trở thành sự thật không thể đảo ngược.
Dialogue: 0,0:16:37.69,0:16:41.40,Default,Oka,0,0,0,,Sau kỳ nghỉ năm mới, số học sinh năm ba đến trường ngày càng thưa thớt.
Dialogue: 0,0:16:42.49,0:16:44.32,Default,Oka,0,0,0,,Tôi ở bên Nagisa.
Dialogue: 0,0:16:45.28,0:16:49.33,Default,Oka,0,0,0,,Nhỏ bé và mong manh, nhưng em chưa từng ngừng nỗ lực vươn lên.
Dialogue: 0,0:16:50.83,0:16:52.62,Default,Oka,0,0,0,,Tôi muốn được mãi mãi chở che cho em suốt cuộc đời này.
Dialogue: 0,0:16:56.58,0:16:59.34,Note,,0,0,0,,Lễ tốt nghiệp Trường Trung học Tư thục Hikarizaka
Dialogue: 0,0:16:59.34,0:17:03.80,Default,Oka,0,0,0,,Sunohara. Lát nữa có muốn đi đập vỡ mấy ô cửa sổ quanh trường không mày?
Dialogue: 0,0:17:03.80,0:17:05.30,Default,Sun,0,0,0,,Gì cơ?
Dialogue: 0,0:17:06.26,0:17:09.05,Default,Oka,0,0,0,,Tao nghĩ làm thế thì biết đâu tao sẽ bị đúp lớp ở lại trường.
Dialogue: 0,0:17:09.47,0:17:12.85,Default,Sun,0,0,0,,Thay vì bị bắt lưu ban thì chắc mày bị tống cổ đuổi học luôn ấy chứ.
Dialogue: 0,0:17:13.47,0:17:14.77,Default,Oka,0,0,0,,À, ừ nhỉ.
Dialogue: 0,0:17:14.77,0:17:16.39,Default,Oka,0,0,0,,Thế thì vô ích rồi.
Dialogue: 0,0:17:18.60,0:17:21.19,Default,Kou,0,0,0,,Ồ, Okazaki và Sunohara đấy à.
Dialogue: 0,0:17:21.19,0:17:22.69,Default,Kou,0,0,0,,Chúc mừng hai em đã tốt nghiệp nhé.
Dialogue: 0,0:17:22.69,0:17:23.48,Default,Sun,0,0,0,,Em cảm ơn thầy.
Dialogue: 0,0:17:23.48,0:17:26.20,Default,Kou,0,0,0,,Hết năm học này thầy cũng sẽ nghỉ hưu.
Dialogue: 0,0:17:26.20,0:17:30.12,Default,Kou,0,0,0,,Coi như thầy cũng tốt nghiệp cùng các em luôn vậy.
Dialogue: 0,0:17:30.12,0:17:30.99,Default,Sun,0,0,0,,Thật vậy sao thầy?
Dialogue: 0,0:17:30.99,0:17:35.62,Default,Oka,0,0,0,,Em cứ tưởng có thầy ở lại thì Câu lạc bộ Kịch sẽ vững tâm hơn.
Dialogue: 0,0:17:36.50,0:17:39.00,Default,Kou,0,0,0,,Đừng lo cho con bé.
Dialogue: 0,0:17:39.00,0:17:42.63,Default,Kou,0,0,0,,Con bé mạnh mẽ và chín chắn hơn\Nhài đứa các em nhiều đấy.
Dialogue: 0,0:17:43.46,0:17:45.63,Default,Kou,0,0,0,,Hai em mới là những người phải nỗ lực cố gắng đấy.
Dialogue: 0,0:17:45.63,0:17:51.93,Default,Kou,0,0,0,,Cuối sự nghiệp, thầy thật may mắn khi được gặp những học sinh cần thầy quan tâm săn sóc nhiều đến thế.
Dialogue: 0,0:17:51.93,0:17:57.64,Default,Sun,0,0,0,,Nếu không nhờ có thầy uốn nắn, chắc tụi em đã bị đuổi học từ lâu rồi.
Dialogue: 0,0:17:58.02,0:18:05.86,Default,Oka,0,0,0,,Em thắc mắc điều này từ lâu rồi, có phải thầy đã cố tình sắp đặt cho em và Sunohara gặp nhau không?
Dialogue: 0,0:18:06.49,0:18:07.45,Default,Sun,0,0,0,,Ý em là sao?
Dialogue: 0,0:18:07.95,0:18:09.91,Default,Oka,0,0,0,,Em và Sunohara rất giống nhau.
Dialogue: 0,0:18:10.45,0:18:14.87,Default,Oka,0,0,0,,Chỉ cần có bạn bè bên cạnh, thì chẳng đứa nào chịu dễ dàng bỏ học cả.
Dialogue: 0,0:18:15.41,0:18:16.91,Default,Oka,0,0,0,,Có phải thầy đã nghĩ như vậy không ạ?
Dialogue: 0,0:18:16.91,0:18:19.87,Default,Kou,0,0,0,,Thầy chẳng nhớ nữa.
Dialogue: 0,0:18:20.21,0:18:22.88,Default,Kou,0,0,0,,Dù sao thì thầy cũng đã già cả rồi.
Dialogue: 0,0:18:22.88,0:18:26.09,Default,Kou,0,0,0,,Kể từ ngày mai, các em sẽ chính thức bước chân vào xã hội.
Dialogue: 0,0:18:26.09,0:18:30.72,Default,Kou,0,0,0,,Nhớ tham gia đầy đủ buổi sinh hoạt lớp cuối cùng đấy nhé, rõ chưa?
Dialogue: 0,0:18:36.81,0:18:38.39,Default,2,0,0,0,,Chúng em cảm ơn thầy vì đã luôn dìu dắt bọn em ạ!
Dialogue: 0,0:18:40.48,0:18:41.98,Note,,0,0,0,,Lễ tốt nghiệp Trường Trung học Tư thục Hikarizaka
Dialogue: 0,0:18:41.98,0:18:44.19,Default,Oka,0,0,0,,Cảm ơn các cậu vì tất cả mọi chuyện nhé.
Dialogue: 0,0:18:44.19,0:18:46.53,Default,Yuk,0,0,0,,Bọn mình mới là người phải nói câu đó chứ.
Dialogue: 0,0:18:46.53,0:18:49.57,Default,Tom,0,0,0,,Hàng cây hoa anh đào đã được quyết định giữ lại rồi.
Dialogue: 0,0:18:49.57,0:18:51.24,Default,Tom,0,0,0,,Tất cả đều là nhờ có cậu đấy.
Dialogue: 0,0:18:51.66,0:18:54.83,Default,Oka,0,0,0,,Sang năm Nagisa sẽ học cùng lớp với hai cậu.
Dialogue: 0,0:18:55.41,0:18:56.74,Default,Oka,0,0,0,,Nhờ hai cậu để mắt chăm sóc cậu ấy giùm tôi nhé.
Dialogue: 0,0:18:56.74,0:18:59.41,Default,Tom,0,0,0,,Bọn tôi biết rồi mà. Đừng lo lắng quá.
Dialogue: 0,0:18:59.41,0:19:02.08,Default,Yuk,0,0,0,,Chúc cậu vạn sự may mắn trên con đường phía trước nhé, Okazaki-san.
Dialogue: 0,0:19:02.08,0:19:03.25,Default,Kyo,0,0,0,,Tomoya!
Dialogue: 0,0:19:04.04,0:19:05.80,Default,Kyo,0,0,0,,Lát nữa bọn này đi liên hoan ăn mừng tốt nghiệp đấy,
Dialogue: 0,0:19:05.80,0:19:07.76,Default,Kyo,0,0,0,,nhưng cậu có nơi cần phải đến rồi đúng không?
Dialogue: 0,0:19:09.01,0:19:09.84,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:19:21.64,0:19:22.85,Default,Nag,0,0,0,,Bánh mì đậu đỏ!
Dialogue: 0,0:19:26.65,0:19:28.53,Default,Nag,0,0,0,,...bất giác hét toáng lên một lời nói dối trắng trợn!
Dialogue: 0,0:19:30.57,0:19:31.15,Signs,,0,0,0,,{\fnEraserDust\fs180\c&HD2DBDD&\pos(591,972)\blur1.3}Nagisa
Dialogue: 0,0:19:31.15,0:19:36.15,Signs,,0,0,0,,{\alpha&HFF&}
Dialogue: 0,0:19:56.39,0:19:58.89,Default,Oka,0,0,0,,Đồ ngốc này! Cậu không được ra ngoài trời lạnh thế này chứ!
Dialogue: 0,0:19:59.60,0:20:02.31,Default,Nag,0,0,0,,Tớ rất muốn được gặp cậu bằng bất cứ giá nào.
Dialogue: 0,0:20:02.94,0:20:05.69,Default,Nag,0,0,0,,Được nhìn thấy cậu trong bộ đồng phục học sinh.
Dialogue: 0,0:20:11.24,0:20:15.41,Default,Nag,0,0,0,,Tomoya-kun. Chúc mừng cậu đã tốt nghiệp nhé.
Dialogue: 0,0:20:25.88,0:20:27.00,Default,Oka,0,0,0,,Nagisa...
Dialogue: 0,0:20:28.38,0:20:30.80,Default,Oka,0,0,0,,Tớ tốt nghiệp rồi...
Dialogue: 0,0:20:32.09,0:20:32.97,Default,Nag,0,0,0,,Vâng.
Dialogue: 0,0:20:35.05,0:20:38.05,Default,Oka,0,0,0,,Từ nay tớ sẽ không bao giờ còn là học sinh của ngôi trường ấy nữa.
Dialogue: 0,0:20:39.22,0:20:41.31,Default,Oka,0,0,0,,Tớ từng rất ghét ngôi trường đó,
Dialogue: 0,0:20:42.52,0:20:43.56,Default,Oka,0,0,0,,nhưng nếu là ở bên cậu,
Dialogue: 0,0:20:44.35,0:20:48.52,Default,Oka,0,0,0,,tớ đã từng ước mình có thể mãi mãi ở nơi ấy.
Dialogue: 0,0:20:48.90,0:20:51.69,Default,Oka,0,0,0,,Thời học sinh của tớ từng mục ruỗng và tồi tệ như địa ngục,
Dialogue: 0,0:20:52.74,0:20:57.11,Default,Oka,0,0,0,,nhưng một năm cuối cùng được ở bên cậu lại vui vẻ biết bao.
Dialogue: 0,0:20:59.70,0:21:01.16,Default,Oka,0,0,0,,Tớ đã thực sự rất hạnh phúc!
Dialogue: 0,0:21:03.12,0:21:06.21,Default,Oka,0,0,0,,Đáng lẽ ra... tớ cũng nên ở lại lớp cùng cậu mới phải.
Dialogue: 0,0:21:08.67,0:21:09.75,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:21:13.01,0:21:15.88,Default,Nag,0,0,0,,Cậu không được dừng bước như thế.
Dialogue: 0,0:21:16.30,0:21:18.97,Default,Nag,0,0,0,,Nếu cậu có thể tiến về phía trước, thì cậu hãy bước tiếp đi.
Dialogue: 0,0:21:19.68,0:21:21.64,Default,Nag,0,0,0,,Xin cậu hãy tiến bước.
Dialogue: 0,0:21:27.27,0:21:30.23,Default,Nag,0,0,0,,Tớ sẽ cố gắng hết mình thêm một năm nữa.
Dialogue: 0,0:21:32.69,0:21:33.69,Default,Nag,0,0,0,,Tomoya-kun.
Dialogue: 0,0:21:35.70,0:21:37.53,Default,Nag,0,0,0,,Chúng mình nắm tay nhau được không?
Dialogue: 0,0:21:38.86,0:21:42.12,Default,Oka,0,0,0,,Đồ ngốc này. Cậu sẽ lại bị sốt lên bây giờ đấy.
Dialogue: 0,0:21:42.54,0:21:44.29,Default,Nag,0,0,0,,Chỉ một chút thôi mà.
Dialogue: 0,0:21:44.29,0:21:47.33,Default,Nag,0,0,0,,Tớ muốn được nắm tay cùng bước đi bên cậu.
Dialogue: 0,0:21:55.30,0:21:57.72,Default,Oka,0,0,0,,Tôi muốn cứ thế bước đi mãi không dừng lại...
Dialogue: 0,0:21:59.30,0:22:01.72,Default,Oka,0,0,0,,...bước đi, bước đi mãi...
Dialogue: 0,0:22:02.85,0:22:04.72,Default,Oka,0,0,0,,...dẫu cho con đường dốc này có dài vô tận...
Dialogue: 0,0:22:05.43,0:22:06.39,Default,Oka,0,0,0,,...chỉ riêng hai chúng tôi...
Dialogue: 0,0:22:05.89,0:22:09.85,Signs,,0,0,0,,{\fad(400,0)\4c&H000000&\shad3\pos(1459.999969,840)\bord0.75\3c&H000000&\blur0.5}Còn tiếp
Dialogue: 0,0:22:18.78,0:22:26.29,ED English,,0,0,0,,{\be1}Tôi từng ngắm nhìn những áng mây bồng bềnh trôi.
