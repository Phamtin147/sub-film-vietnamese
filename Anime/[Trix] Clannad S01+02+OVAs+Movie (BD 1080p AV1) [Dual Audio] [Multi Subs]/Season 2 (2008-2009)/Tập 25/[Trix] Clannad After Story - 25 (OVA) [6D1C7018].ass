Dialogue: 0,0:03:16.14,0:03:19.81,Signs,,0,0,0,,{\fad(400,0)\fs60\blur2\bord2\3c&H4A8A5C&\pos(960,720)}Chương Của Kyou
Dialogue: 0,0:03:20.23,0:03:22.98,Default,Oka,0,0,0,,À ra vậy. Em dự định thi vào trường điều dưỡng sao?
Dialogue: 0,0:03:22.98,0:03:26.69,Default,Ryo,0,0,0,,Vâng, đó là ước mơ của em từ khi còn bé rồi ạ.
Dialogue: 0,0:03:26.69,0:03:30.53,Default,Oka,0,0,0,,Anh thì vẫn chưa có bất cứ định hướng nào cho tương lai cả.
Dialogue: 0,0:03:30.53,0:03:32.95,Default,Ryo,0,0,0,,Dạ, em nghĩ anh không cần phải vội vàng quá đâu ạ.
Dialogue: 0,0:03:32.95,0:03:34.03,Default,Oka,0,0,0,,Anh nghĩ là phải vội rồi đấy.
Dialogue: 0,0:03:34.66,0:03:38.37,Default,Oka,0,0,0,,Nếu anh cứ lông bông dậm chân tại chỗ,\Ncó khi ngay cả em cũng sẽ phát ngán anh mất.
Dialogue: 0,0:03:38.37,0:03:40.16,Default,Ryo,0,0,0,,Làm sao có chuyện đó được ạ!
Dialogue: 0,0:03:40.58,0:03:44.83,Default,Ryo,0,0,0,,Dù có chuyện gì xảy ra đi nữa, em cũng tuyệt đối không bao giờ chán anh đâu!
Dialogue: 0,0:03:46.59,0:03:47.59,Default,Oka,0,0,0,,Cảm ơn em nhé.
Dialogue: 0,0:03:49.00,0:03:53.59,Default,Oka,0,0,0,,Trước giờ chưa từng có ai nói với anh những lời như thế.
Dialogue: 0,0:03:53.59,0:03:55.55,Default,Oka,0,0,0,,Nên anh thấy có chút cảm động.
Dialogue: 0,0:03:57.60,0:03:58.51,Default,Ryo,0,0,0,,Đâu có gì đâu anh...
Dialogue: 0,0:04:08.98,0:04:10.32,Default,Oka,0,0,0,,Này Kyou!
Dialogue: 0,0:04:16.95,0:04:19.66,Default,Kyo,0,0,0,,Chủ nhật đẹp trời thế này cậu lượn lờ ở đây làm gì đấy?
Dialogue: 0,0:04:19.66,0:04:22.12,Default,Kyo,0,0,0,,Cậu phải dành thời gian đi chơi với Ryou chứ.
Dialogue: 0,0:04:22.12,0:04:24.83,Default,Oka,0,0,0,,Bớt lo chuyện bao đồng đi, đồ ngốc.
Dialogue: 0,0:04:25.87,0:04:28.04,Default,Kyo,0,0,0,,Ừ, tớ biết rồi. Xin lỗi nhé.
Dialogue: 0,0:04:28.54,0:04:30.30,Default,Oka,0,0,0,,Không cần phải xin lỗi đâu.
Dialogue: 0,0:04:33.38,0:04:34.63,Default,Kyo,0,0,0,,Cậu biết không...
Dialogue: 0,0:04:35.72,0:04:39.35,Default,Kyo,0,0,0,,Nó thích cậu từ hồi còn học lớp 11 cơ đấy.
Dialogue: 0,0:04:39.72,0:04:41.35,Default,Oka,0,0,0,,Thật vậy sao?
Dialogue: 0,0:04:41.35,0:04:43.98,Default,Kyo,0,0,0,,Thế nào? Cậu thấy hai đứa có tiến triển tốt đẹp không?
Dialogue: 0,0:04:43.98,0:04:45.69,Default,Oka,0,0,0,,Tớ nghĩ là có.
Dialogue: 0,0:04:45.69,0:04:50.65,Default,Oka,0,0,0,,Em ấy rất chăm chỉ và tốt bụng, nhưng lại cực kỳ dễ đỏ mặt ngượng ngùng, nên tớ phải chú ý giữ chừng mực nhẹ nhàng.
Dialogue: 0,0:04:50.65,0:04:51.86,Default,Kyo,0,0,0,,Ừ, chuẩn luôn đấy!
Dialogue: 0,0:04:51.86,0:04:55.20,Default,Kyo,0,0,0,,Nhưng đó cũng chính là nét đáng yêu nhất của con bé mà.
Dialogue: 0,0:04:56.32,0:04:56.86,Default,Kyo,0,0,0,,Sao thế?
Dialogue: 0,0:04:57.11,0:05:00.74,Default,Oka,0,0,0,,Không, tớ chỉ đang nghĩ là cậu thực sự quan tâm và lo lắng cho em gái mình ghê.
Dialogue: 0,0:05:04.62,0:05:06.12,Default,Kyo,0,0,0,,Đâu có đâu.
Dialogue: 0,0:05:07.67,0:05:08.75,Default,Kyo,0,0,0,,Thôi bỏ đi.
Dialogue: 0,0:05:10.34,0:05:11.34,Default,Kyo,0,0,0,,Này cậu.
Dialogue: 0,0:05:12.46,0:05:14.05,Default,Kyo,0,0,0,,Cậu đã hôn Ryou lần nào chưa?
Dialogue: 0,0:05:14.05,0:05:14.84,Default,Oka,0,0,0,,Hả?!
Dialogue: 0,0:05:14.84,0:05:17.26,Default,Oka,0,0,0,,Đ-Đương nhiên là chưa rồi!
Dialogue: 0,0:05:17.84,0:05:21.26,Default,Kyo,0,0,0,,Thôi nào! Cậu là con trai thì phải chủ động dẫn dắt con bé chứ.
Dialogue: 0,0:05:21.26,0:05:26.48,Default,Oka,0,0,0,,Cậu nói thì dễ lắm, đây là lần đầu tiên tớ hẹn hò yêu đương đấy nhé.
Dialogue: 0,0:05:28.85,0:05:30.56,Default,Kyo,0,0,0,,Vậy cậu có muốn luyện tập thử không?
Dialogue: 0,0:05:31.27,0:05:32.73,Default,Kyo,0,0,0,,Luyện tập hôn ấy.
Dialogue: 0,0:05:32.73,0:05:33.57,Default,Kyo,0,0,0,,Với tớ này.
Dialogue: 0,0:05:36.32,0:05:38.66,Default,Kyo,0,0,0,,Cứ xem tớ là Ryou đi.
Dialogue: 0,0:05:38.66,0:05:41.37,Default,Kyo,0,0,0,,Dù sao tụi này cũng là chị em sinh đôi, khuôn mặt giống hệt nhau còn gì?
Dialogue: 0,0:05:42.91,0:05:43.62,Default,Kyo,0,0,0,,Thật á?
Dialogue: 0,0:05:56.80,0:05:58.80,Default,Kyo,0,0,0,,Đủ rồi đấy!
Dialogue: 0,0:05:59.26,0:06:02.72,Default,Kyo,0,0,0,,Chỉ là diễn tập thôi, ai cho làm thật bao giờ.
Dialogue: 0,0:06:02.72,0:06:04.01,Default,Oka,0,0,0,,Đ-Đúng rồi.
Dialogue: 0,0:06:04.31,0:06:06.85,Default,Kyo,0,0,0,,Chẳng lẽ vừa nãy cậu tưởng thật đấy à?
Dialogue: 0,0:06:07.73,0:06:10.27,Default,Oka,0,0,0,,Đương nhiên là không rồi, đồ ngốc này.
Dialogue: 0,0:06:10.90,0:06:13.36,Default,Kyo,0,0,0,,Tớ chấm cho màn vừa rồi sáu trên mười điểm.
Dialogue: 0,0:06:13.36,0:06:14.57,Default,Oka,0,0,0,,Rồi rồi, biết rồi.
Dialogue: 0,0:06:15.19,0:06:16.36,Default,Kyo,0,0,0,,Hẹn gặp lại nhé.
Dialogue: 0,0:06:16.36,0:06:17.15,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:06:29.41,0:06:30.92,Default,Guys,0,0,0,,Ở cái công viên đó ấy.
Dialogue: 0,0:06:30.92,0:06:33.29,Default,Guys,0,0,0,,Thật luôn hả? Okazaki cái tên cá biệt đó á?
Dialogue: 0,0:06:33.29,0:06:34.75,Default,Guys,0,0,0,,À, hai người đó.
Dialogue: 0,0:06:34.75,0:06:37.17,Default,Guys,0,0,0,,Hồi trước học cùng lớp mà. Giờ nhìn vẫn thân thiết ghê.
Dialogue: 0,0:06:37.17,0:06:37.92,Default,Guys,0,0,0,,Nhưng mà-
Dialogue: 0,0:06:37.92,0:06:38.80,Default,Guys,0,0,0,,Kìa, cậu ta đến rồi kìa!
Dialogue: 0,0:06:38.80,0:06:40.05,Default,Girl,0,0,0,,Nói khẽ thôi con điên này.
Dialogue: 0,0:06:41.09,0:06:44.05,Default,Girl,0,0,0,,Sao lại làm cái trò đó ở chỗ công cộng như thế chứ?
Dialogue: 0,0:06:44.05,0:06:45.93,Default,Girl,0,0,0,,Không biết xấu hổ à?
Dialogue: 0,0:06:45.93,0:06:47.31,Default,Girl,0,0,0,,Ừ.
Dialogue: 0,0:06:48.31,0:06:49.68,Default,Oka,0,0,0,,Mấy người này đang xì xào cái quái gì thế nhỉ?
Dialogue: 0,0:06:50.06,0:06:51.77,Default,Sun,0,0,0,,Chào buổi sáng, Okazaki!
Dialogue: 0,0:06:52.56,0:06:54.36,Default,Oka,0,0,0,,Cái gì, ngay cả mày cũng...
Dialogue: 0,0:06:54.36,0:06:56.82,Signs,Oka,0,0,0,,{\fnEdo SZ\fs90\c&H1F2521&\pos(948,189)}Cấm chạy
Dialogue: 0,0:06:54.36,0:06:56.82,Signs,Oka,0,0,0,,{\fnEdo SZ\fs63\pos(844.5,669)\c&H2F3838&}ở hành lang
Dialogue: 0,0:06:54.36,0:06:56.82,Signs,Oka,0,0,0,,{\fnEdo SZ\fs45\c&HBDBCC3&\pos(814.5,723)}nguy hiểm
Dialogue: 0,0:06:55.02,0:06:57.19,Default,Oka,0,0,0,,Cái gì?! Tao với Kyou á?!
Dialogue: 0,0:06:57.19,0:06:59.53,Default,Sun,0,0,0,,Cả trường này ai cũng biết tỏng rồi.
Dialogue: 0,0:06:59.53,0:07:01.86,Default,Sun,0,0,0,,Chuyện hôm qua mày với Kyou hôn nhau trong công viên ấy.
Dialogue: 0,0:07:01.86,0:07:05.70,Default,Oka,0,0,0,,À... giải thích thế nào bây giờ...
Dialogue: 0,0:07:05.70,0:07:07.20,Default,Oka,0,0,0,,Không phải như mọi người đang nghĩ đâu.
Dialogue: 0,0:07:07.20,0:07:08.95,Default,Sun,0,0,0,,Đừng có giả ngây giả ngô với tao.
Dialogue: 0,0:07:08.95,0:07:11.83,Default,Sun,0,0,0,,Tao đã nghi ngờ hai đứa mày có gì mờ ám từ lâu rồi.
Dialogue: 0,0:07:11.83,0:07:13.96,Default,Sun,0,0,0,,Nhìn hai đứa lúc nào cũng vui vẻ bên nhau.
Dialogue: 0,0:07:13.96,0:07:15.88,Default,Oka,0,0,0,,Tao đã bảo là chẳng có chuyện gì xảy ra hết.
Dialogue: 0,0:07:15.88,0:07:19.34,Default,Oka,0,0,0,,Hơn nữa, người tao đang hẹn hò là cô em gái cơ mà.
Dialogue: 0,0:07:20.38,0:07:22.43,Default,Sun,0,0,0,,Mày với Fujibayashi Ryou á?!
Dialogue: 0,0:07:22.43,0:07:23.59,Default,Sun,0,0,0,,Thật luôn đấy à?!
Dialogue: 0,0:07:23.59,0:07:25.30,Default,Oka,0,0,0,,Bất ngờ đến thế cơ à?
Dialogue: 0,0:07:25.30,0:07:28.27,Default,Sun,0,0,0,,Thì hai đứa mày tính cách trái ngược nhau 180 độ còn gì.
Dialogue: 0,0:07:28.27,0:07:30.56,Default,Sun,0,0,0,,Ngược lại, tao thấy mày hợp đôi với Kyou hơn nhiều.
Dialogue: 0,0:07:30.56,0:07:32.02,Default,Oka,0,0,0,,Đừng có tự tiện gán ghép bừa bãi thế chứ!
Dialogue: 0,0:07:33.02,0:07:36.19,Default,Oka,0,0,0,,Này, thế Fujibayashi đã biết chuyện tin đồn chưa?
Dialogue: 0,0:07:36.19,0:07:39.73,Default,Sun,0,0,0,,Tao cá là chỉ cần bước chân vào trường là con bé sẽ nghe thấy, dù muốn hay không.
Dialogue: 0,0:07:40.15,0:07:41.53,Default,Kyo,0,0,0,,A, đây rồi.
Dialogue: 0,0:07:43.82,0:07:44.70,Default,Oka,0,0,0,,Này.
Dialogue: 0,0:07:44.70,0:07:45.99,Default,Kyo,0,0,0,,Đi với tôi một lát.
Dialogue: 0,0:07:45.99,0:07:48.37,Default,Kyo,0,0,0,,Tôi không làm mất nhiều thời gian của cậu đâu.
Dialogue: 0,0:07:46.12,0:07:49.20,Default-alt,Sun,0,0,0,,Tôi đã làm gì đâu chứ!
Dialogue: 0,0:07:48.37,0:07:49.74,Default,Oka,0,0,0,,Này Kyou!
Dialogue: 0,0:07:49.74,0:07:50.70,Default,Oka,0,0,0,,Cậu...
Dialogue: 0,0:08:04.30,0:08:07.89,Default,Sun,0,0,0,,Thật tình tớ không thể nào tin nổi.
Dialogue: 0,0:08:07.89,0:08:11.89,Default,Kyo,0,0,0,,Sao lại không? Điều tớ nói kỳ lạ lắm à?
Dialogue: 0,0:08:11.89,0:08:15.81,Default,Sun,0,0,0,,Đúng hơn là trước giờ tớ chưa từng cảm nhận được bất cứ tín hiệu nào giữa hai chúng mình cả.
Dialogue: 0,0:08:16.52,0:08:20.48,Default,Sun,0,0,0,,Có phải kiểu thân quá hóa quen nên không nhận ra không?
Dialogue: 0,0:08:20.48,0:08:23.28,Default,Kyo,0,0,0,,Ừ, có lẽ là như thế đấy.
Dialogue: 0,0:08:24.99,0:08:29.08,Default,Kyo,0,0,0,,Này, cậu có muốn tớ đưa ra một bằng chứng hết sức đơn giản không?
Dialogue: 0,0:08:32.29,0:08:34.33,Default,Sun,0,0,0,,Đ-Đợi một chút đã!
Dialogue: 0,0:08:41.63,0:08:45.13,Default,Sun,0,0,0,,Kỳ lạ thật đấy. Cậu có chắc là cậu thích tớ thật không?
Dialogue: 0,0:08:45.13,0:08:46.59,Default,Kyo,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:08:50.10,0:08:52.35,Default,Sun,0,0,0,,Nếu tớ đoán sai thì tớ xin lỗi nhé,
Dialogue: 0,0:08:53.02,0:08:55.73,Default,Sun,0,0,0,,nhưng người cậu thích thực ra là Okazaki đúng không?
Dialogue: 0,0:08:57.31,0:08:59.56,Default,Kyo,0,0,0,,C-Cậu đang nói cái gì thế hả?
Dialogue: 0,0:08:59.56,0:09:01.94,Default,Kyo,0,0,0,,Tớ... tớ...
Dialogue: 0,0:09:11.70,0:09:17.33,Default,Sun,0,0,0,,Cô ấy ngỏ lời hẹn hò với tao là để xóa tan cái tin đồn giữa mày và cô ấy đấy.
Dialogue: 0,0:09:18.08,0:09:19.38,Default,Oka,0,0,0,,Ai thèm quan tâm đến mấy lời đồn vớ vẩn chứ?
Dialogue: 0,0:09:19.38,0:09:22.84,Default,Sun,0,0,0,,Nếu chỉ là tin đồn bình thường, tao nghĩ cô ấy chẳng bao giờ phải làm đến mức này đâu.
Dialogue: 0,0:09:29.05,0:09:30.30,Default,Kyo,0,0,0,,Cậu đến muộn đấy.
Dialogue: 0,0:09:34.14,0:09:37.98,Default,Kyo,0,0,0,,Này, đừng có để bụng mấy lời Youhei nói nhé.
Dialogue: 0,0:09:38.69,0:09:44.78,Default,Kyo,0,0,0,,Nhìn thấy cậu và Ryou quấn quýt bên nhau,\Ntớ cũng tự nhiên muốn có bạn trai thôi.
Dialogue: 0,0:09:44.78,0:09:48.11,Default,Kyo,0,0,0,,Nên tớ nghĩ bừa là chọn Youhei cũng được.
Dialogue: 0,0:09:48.11,0:09:48.95,Default,Kyo,0,0,0,,Thế thì-
Dialogue: 0,0:09:48.70,0:09:49.61,Default-alt,Oka,0,0,0,,Dừng lại đi mà!
Dialogue: 0,0:09:51.87,0:09:55.70,Default,Oka,0,0,0,,Cậu cứ tùy tiện vơ bừa một chàng trai theo hứng thú nhất thời như thế sao?
Dialogue: 0,0:09:57.29,0:09:59.46,Default,Kyo,0,0,0,,Bớt lo chuyện bao đồng đi.
Dialogue: 0,0:10:07.42,0:10:10.84,Default,Kyo,0,0,0,,Cậu chỉ được phép nghĩ về một mình Ryou thôi.
Dialogue: 0,0:10:11.26,0:10:12.30,Default,Kyo,0,0,0,,Rõ chưa hả?
Dialogue: 0,0:10:13.72,0:10:16.77,Default,Kyo,0,0,0,,Không được làm cho bạn gái mình phải phiền lòng lo lắng đâu đấy.
Dialogue: 0,0:10:16.77,0:10:17.77,Default,Kyo,0,0,0,,Chào nhé.
Dialogue: 0,0:10:27.32,0:10:28.53,Default,Staff,0,0,0,,Tổng cộng của hai em hết 800 yên nhé.
Dialogue: 0,0:10:34.83,0:10:35.79,Default,Ryo,0,0,0,,Tomoya-kun.
Dialogue: 0,0:10:38.20,0:10:41.00,Default,Ryo,0,0,0,,Em muốn thử gọi anh bằng tên riêng xem sao.
Dialogue: 0,0:10:42.71,0:10:43.79,Default,Ryo,0,0,0,,Anh không thích ạ?
Dialogue: 0,0:10:44.50,0:10:46.09,Default,Oka,0,0,0,,Đương nhiên là không rồi.
Dialogue: 0,0:10:46.09,0:10:47.30,Default,Ryo,0,0,0,,Thật thế sao anh?
Dialogue: 0,0:10:47.30,0:10:49.72,Default,Oka,0,0,0,,Ừ. Tại Kyou lúc nào cũng gọi anh bằng-
Dialogue: 0,0:10:52.64,0:10:55.60,Default,Ryo,0,0,0,,Anh nói đúng. Anh đang nghĩ 'tự nhiên lại thế làm gì' đúng không ạ.
Dialogue: 0,0:10:55.60,0:10:57.10,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:10:57.64,0:11:01.81,Default,Ryo,0,0,0,,Nếu không phiền, anh cũng có thể gọi em là 'Ryou' được không?
Dialogue: 0,0:11:02.40,0:11:03.36,Default,Oka,0,0,0,,Được chứ.
Dialogue: 0,0:11:03.90,0:11:05.07,Default,Oka,0,0,0,,Vậy thì, Ryou.
Dialogue: 0,0:11:05.27,0:11:06.98,Default,Ryo,0,0,0,,T-Tomoya-kun.
Dialogue: 0,0:11:12.57,0:11:14.03,Default,Ryo,0,0,0,,Hẹn gặp lại anh sau nhé.
Dialogue: 0,0:11:14.03,0:11:14.74,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:11:18.33,0:11:19.41,Default,Ryo,0,0,0,,Tomoya-kun!
Dialogue: 0,0:11:22.37,0:11:24.00,Default,Ryo,0,0,0,,Hẹn gặp lại anh vào ngày mai nhé.
Dialogue: 0,0:11:29.13,0:11:30.67,Default,Oka,0,0,0,,Chắc là mình nên ghé qua chỗ Sunohara một lát.
Dialogue: 0,0:11:32.30,0:11:33.39,Default,Oka,0,0,0,,Botan!
Dialogue: 0,0:11:33.80,0:11:34.51,Default,Bot,0,0,0,,Gột gột.
Dialogue: 0,0:11:34.72,0:11:38.97,Default,Oka,0,0,0,,Sao thế này? Hôm nay là chủ nhật mà, làm gì có ai ở trường đâu.
Dialogue: 0,0:11:38.97,0:11:40.02,Default,Oka,0,0,0,,Này!
Dialogue: 0,0:11:43.98,0:11:45.44,Default,Oka,0,0,0,,Botan! Đợi đã!
Dialogue: 0,0:11:53.28,0:11:54.28,Default,Oka,0,0,0,,Kyou.
Dialogue: 0,0:11:57.66,0:11:58.54,Default,Oka,0,0,0,,Sao cậu lại ở đây?
Dialogue: 0,0:11:59.45,0:12:01.58,Default,Kyo,0,0,0,,K-Không có gì hết.
Dialogue: 0,0:12:01.58,0:12:04.08,Default,Kyo,0,0,0,,Còn cậu thì sao? Không phải cậu đang đi hẹn hò với Ryou à?
Dialogue: 0,0:12:06.08,0:12:07.46,Default,Oka,0,0,0,,Người cậu ướt sũng hết cả rồi kìa.
Dialogue: 0,0:12:14.88,0:12:16.09,Default,Kyo,0,0,0,,Đừng lại đây.
Dialogue: 0,0:12:17.60,0:12:18.60,Default,Kyo,0,0,0,,Đừng lại gần tớ.
Dialogue: 0,0:12:19.14,0:12:20.39,Default,Kyo,0,0,0,,Làm ơn đấy...
Dialogue: 0,0:12:20.93,0:12:25.15,Default,Kyo,0,0,0,,C-Cậu chỉ được phép nghĩ về một mình Ryou thôi.
Dialogue: 0,0:12:26.02,0:12:27.94,Default,Kyo,0,0,0,,Bởi vì dù sao thì cậu cũng là bạn trai của Ryou cơ mà.
Dialogue: 0,0:12:29.82,0:12:31.99,Default,Oka,0,0,0,,Chuyện đó chẳng liên quan gì đến lúc này cả.
Dialogue: 0,0:12:31.99,0:12:32.61,Default,Oka,0,0,0,,Cậu sẽ bị cảm lạnh mất đấy.
Dialogue: 0,0:12:32.61,0:12:33.90,Default,Kyo,0,0,0,,Tớ đã bảo là đừng lại đây rồi mà!
Dialogue: 0,0:12:34.40,0:12:36.70,Default,Kyo,0,0,0,,Cậu hãy mặc kệ tớ đi!
Dialogue: 0,0:12:37.99,0:12:40.16,Default,Kyo,0,0,0,,Đừng bận tâm đến tớ nữa mà...
Dialogue: 0,0:12:40.16,0:12:40.95,Default,Oka,0,0,0,,Kyou!
Dialogue: 0,0:12:40.95,0:12:42.12,Default,Kyo,0,0,0,,Dừng lại đi!
Dialogue: 0,0:12:45.37,0:12:46.12,Default,Oka,0,0,0,,Này.
Dialogue: 0,0:12:46.92,0:12:48.71,Default,Kyo,0,0,0,,D... Dừng lại đi.
Dialogue: 0,0:13:00.14,0:13:01.93,Default,Kyo,0,0,0,,Đừng đối xử dịu dàng với tớ như thế nữa.
Dialogue: 0,0:13:03.68,0:13:05.44,Default,Kyo,0,0,0,,Tớ là một đứa ngốc...
Dialogue: 0,0:13:06.73,0:13:09.48,Default,Kyo,0,0,0,,...nên nếu cậu cứ đối xử tốt với tớ, tớ sẽ lại ảo tưởng mất.
Dialogue: 0,0:13:13.78,0:13:15.32,Default,Kyo,0,0,0,,Tớ đã rất sợ hãi.
Dialogue: 0,0:13:15.99,0:13:18.41,Default,Kyo,0,0,0,,Tớ đã sợ không dám ngỏ lời với cậu.
Dialogue: 0,0:13:19.45,0:13:27.04,Default,Kyo,0,0,0,,Nếu tớ tỏ tình mà bị cậu từ chối,\Ncó khi ngay cả làm bạn bè tụi mình cũng không giữ được nữa.
Dialogue: 0,0:13:27.83,0:13:33.17,Default,Kyo,0,0,0,,Còn nếu tớ được hẹn hò với cậu, Ryou sẽ đau khổ biết bao nhiêu.
Dialogue: 0,0:13:34.46,0:13:37.76,Default,Kyo,0,0,0,,Vậy nên, tớ từ bỏ là lựa chọn tốt nhất.
Dialogue: 0,0:13:38.22,0:13:41.26,Default,Kyo,0,0,0,,Tớ từng nghĩ làm như thế là tốt nhất cho tất cả mọi người!
Dialogue: 0,0:13:42.81,0:13:46.48,Default,Kyo,0,0,0,,Thế nhưng... giờ đây, trong lòng tớ chỉ toàn là nỗi ân hận khôn nguôi.
Dialogue: 0,0:13:49.73,0:13:50.90,Default,Kyo,0,0,0,,Tớ đúng là một đứa đại ngốc.
Dialogue: 0,0:13:51.52,0:13:53.82,Default,Kyo,0,0,0,,Chính tớ là người đã lựa chọn điều đó, vậy mà...
Dialogue: 0,0:13:55.57,0:13:57.49,Default,Oka,0,0,0,,Kyou, tớ-
Dialogue: 0,0:13:57.49,0:13:58.45,Default,Kyo,0,0,0,,Tomoya.
Dialogue: 0,0:13:59.53,0:14:02.24,Default,Kyo,0,0,0,,Tớ là Fujibayashi Kyou.
Dialogue: 0,0:14:03.16,0:14:04.87,Default,Kyo,0,0,0,,Tớ không phải là Ryou đâu.
Dialogue: 0,0:14:09.92,0:14:11.25,Default,Kyo,0,0,0,,Tất cả đã quá muộn rồi.
Dialogue: 0,0:14:14.46,0:14:15.59,Default,Kyo,0,0,0,,Tạm biệt cậu.
Dialogue: 0,0:14:32.94,0:14:35.90,Default,Sun,0,0,0,,Chà, đúng là một mớ bòng bong phức tạp thật đấy.
Dialogue: 0,0:14:35.90,0:14:37.19,Default,Sun,0,0,0,,Lại còn dính dáng đến hai chị em sinh đôi nữa chứ.
Dialogue: 0,0:14:37.61,0:14:39.40,Default,Oka,0,0,0,,Nếu là mày thì mày sẽ làm thế nào?
Dialogue: 0,0:14:39.40,0:14:41.82,Default,Sun,0,0,0,,Nếu tao ở vào vị trí của mày á?
Dialogue: 0,0:14:43.32,0:14:46.16,Default,Sun,0,0,0,,Hốt trọn cả hai em luôn, không cần phải đắn đo suy nghĩ.
Dialogue: 0,0:14:46.16,0:14:48.54,Default,Oka,0,0,0,,Tao đấm cho mày đến khi bất tỉnh nhân sự được không?
Dialogue: 0,0:14:48.54,0:14:50.33,Default,Sun,0,0,0,,Tao xin lỗi. Tao đùa tí thôi mà.
Dialogue: 0,0:14:52.79,0:14:55.46,Default,Sun,0,0,0,,Thật lòng mà nói, rắc rối to chuyện thật đấy.
Dialogue: 0,0:14:56.50,0:14:58.38,Default,Oka,0,0,0,,Nếu mình phải đối mặt với chuyện này...
Dialogue: 0,0:14:58.38,0:15:00.34,Default,Sun,0,0,0,,Mày nói đúng.
Dialogue: 0,0:15:01.13,0:15:03.60,Default,Sun,0,0,0,,Nếu bây giờ mày muốn giữ khoảng cách và né tránh cả hai người họ,
Dialogue: 0,0:15:03.60,0:15:05.39,Default,Sun,0,0,0,,thì đó chính là cách hành xử của một kẻ hèn nhát thất bại.
Dialogue: 0,0:15:09.39,0:15:13.81,Default,Sun,0,0,0,,Mày đang cố gắng để bản thân mình không phải chịu bất cứ vết xước nào đúng không?
Dialogue: 0,0:15:14.73,0:15:20.40,Default,Sun,0,0,0,,Đã đi đến bước đường này rồi, mày bắt buộc phải làm tổn thương một ai đó.
Dialogue: 0,0:15:21.11,0:15:25.37,Default,Sun,0,0,0,,Mày càng chần chừ kéo dài thời gian đưa ra quyết định, thì vết thương sẽ càng sâu và càng đau đớn hơn.
Dialogue: 0,0:15:26.62,0:15:29.20,Default,Sun,0,0,0,,Cho cả ba người bọn mày.
Dialogue: 0,0:15:30.08,0:15:31.16,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:15:32.54,0:15:36.59,Default,Sun,0,0,0,,Nhân tiện, tao có thể nói thêm một câu nữa được không?
Dialogue: 0,0:15:39.63,0:15:42.51,Default,Sun,0,0,0,,Bao nhiêu thằng ngoài kia thèm khát được gặp cái rắc rối của mày đấy con ạ!
Dialogue: 0,0:15:45.47,0:15:46.10,Default,Oka,0,0,0,,Ui da.
Dialogue: 0,0:15:47.68,0:15:50.35,Default,Sun,0,0,0,,Được rồi, đến giờ ăn trưa rồi.
Dialogue: 0,0:16:05.74,0:16:06.78,Default,Ryo,0,0,0,,Tomoya-kun.
Dialogue: 0,0:16:08.66,0:16:10.62,Default,Ryo,0,0,0,,Anh có chuyện gì muốn nói với em sao?
Dialogue: 0,0:16:13.58,0:16:15.08,Default,Ryo,0,0,0,,Chỉ có hai chúng mình thôi đúng không anh?
Dialogue: 0,0:16:17.79,0:16:23.72,Default,Ryo,0,0,0,,{\fs78.3}Trong truyện tranh, hễ cứ ở một mình trong lớp học sau giờ tan trường là sẽ có cảnh hôn nhau đúng không anh?
Dialogue: 0,0:16:23.72,0:16:24.09,Default,Oka,0,0,0,,Fujibayashi này.
Dialogue: 0,0:16:26.64,0:16:28.68,Default,Ryo,0,0,0,,Sao đột nhiên anh lại gọi em bằng họ thế?
Dialogue: 0,0:16:32.68,0:16:35.77,Default,Ryo,0,0,0,,Em đã luôn muốn đánh bại Onee-chan.
Dialogue: 0,0:16:36.94,0:16:39.11,Default,Ryo,0,0,0,,Em không muốn chịu thua chị ấy.
Dialogue: 0,0:16:41.15,0:16:46.74,Default,Ryo,0,0,0,,Em biết rõ ánh mắt Onee-chan bấy lâu nay luôn hướng về ai.
Dialogue: 0,0:16:48.41,0:16:52.04,Default,Ryo,0,0,0,,Em biết rõ tình cảm của chị ấy, vậy mà em vẫn đến xin chị ấy lời khuyên.
Dialogue: 0,0:16:53.54,0:16:56.62,Default,Ryo,0,0,0,,Em đã nói rằng em muốn được thân thiết hơn với Tomoya-kun.
Dialogue: 0,0:16:57.63,0:17:02.09,Default,Ryo,0,0,0,,Chị ấy tuy bất ngờ, nhưng ngay sau đó đã mỉm cười thật tươi.
Dialogue: 0,0:17:03.55,0:17:05.01,Default,Ryo,0,0,0,,Chị ấy bảo: 'Cứ để đó cho chị'.
Dialogue: 0,0:17:06.68,0:17:09.35,Default,Ryo,0,0,0,,Em biết chắc chắn chị ấy sẽ nói câu đó mà.
Dialogue: 0,0:17:10.60,0:17:13.39,Default,Ryo,0,0,0,,Em cũng biết bản thân mình thật xấu xa và đê tiện.
Dialogue: 0,0:17:14.60,0:17:19.73,Default,Ryo,0,0,0,,Dẫu vậy... Dẫu vậy thì em vẫn muốn được ở bên cạnh anh.
Dialogue: 0,0:17:20.57,0:17:24.11,Default,Ryo,0,0,0,,Em không thể thay thế vị trí của Onee-chan được sao anh?
Dialogue: 0,0:17:24.86,0:17:28.87,Default,Ryo,0,0,0,,Em sẽ cố gắng trở nên cởi mở và năng động hơn giống như Onee-chan.
Dialogue: 0,0:17:29.53,0:17:32.37,Default,Ryo,0,0,0,,Em sẽ nuôi tóc dài, và sẽ học nấu ăn thật ngon nữa.
Dialogue: 0,0:17:33.08,0:17:36.29,Default,Ryo,0,0,0,,Em sẽ trở thành một cô gái đúng như anh mong muốn.
Dialogue: 0,0:17:36.29,0:17:37.04,Default,Oka,0,0,0,,Không đâu em.
Dialogue: 0,0:17:38.96,0:17:39.83,Default,Oka,0,0,0,,Không phải như thế đâu.
Dialogue: 0,0:17:40.63,0:17:43.05,Default,Oka,0,0,0,,Anh không muốn em phải làm những chuyện như vậy.
Dialogue: 0,0:17:45.09,0:17:48.34,Default,Ryo,0,0,0,,Em muốn được ở bên anh mà.
Dialogue: 0,0:17:49.84,0:17:50.93,Default,Oka,0,0,0,,Anh...
Dialogue: 0,0:18:12.37,0:18:14.08,Default,Teacher,0,0,0,,Được rồi, câu tiếp theo.
Dialogue: 0,0:18:14.37,0:18:15.54,Default,Teacher,0,0,0,,Fujibayashi.
Dialogue: 0,0:18:16.79,0:18:18.16,Default,Teacher,0,0,0,,Chắc là em ấy không có ở đây rồi.
Dialogue: 0,0:18:18.16,0:18:19.42,Default,Teacher,0,0,0,,Vậy thì Suzuki lên bảng.
Dialogue: 0,0:18:31.76,0:18:33.01,Default,Sun,0,0,0,,Cậu không về nhà sao?
Dialogue: 0,0:18:51.07,0:18:54.74,Default,Oka,0,0,0,,Những ngày tháng ở bên em thực sự rất vui vẻ.
Dialogue: 0,0:18:56.12,0:19:01.33,Default,Oka,0,0,0,,Lần đầu tiên anh nhận ra cảm giác được người khác cần đến lại khiến mình hạnh phúc đến nhường nào.
Dialogue: 0,0:19:03.63,0:19:08.51,Default,Oka,0,0,0,,Anh từng nghĩ cứ như thế này mình sẽ có thể ở bên em mãi mãi.
Dialogue: 0,0:19:12.01,0:19:13.30,Default,Oka,0,0,0,,Nhưng anh không thể.
Dialogue: 0,0:19:16.26,0:19:18.47,Default,Oka,0,0,0,,Anh đúng là một thằng tồi tệ.
Dialogue: 0,0:19:19.31,0:19:22.56,Default,Oka,0,0,0,,Trong lúc ở bên cạnh em, ánh mắt anh lại luôn dõi theo một người khác.
Dialogue: 0,0:19:23.73,0:19:26.57,Default,Oka,0,0,0,,Ngay cả khi nhận ra điều đó, anh vẫn ích kỷ giữ kín trong lòng.
Dialogue: 0,0:19:28.28,0:19:30.90,Default,Oka,0,0,0,,Anh đã lợi dụng lòng tốt và sự dịu dàng của em...
Dialogue: 0,0:19:31.95,0:19:32.70,Default,Oka,0,0,0,,Anh...
Dialogue: 0,0:19:35.24,0:19:36.74,Default,Oka,0,0,0,,Người mà anh thực sự yêu...
Dialogue: 0,0:19:37.58,0:19:39.70,Default,Oka,0,0,0,,...chính là chị gái của em.
Dialogue: 0,0:19:41.16,0:19:42.12,Default,Oka,0,0,0,,Anh xin lỗi em.
Dialogue: 0,0:19:43.92,0:19:44.83,Default,Kyo,0,0,0,,Tomoya.
Dialogue: 0,0:19:49.46,0:19:50.38,Default,Oka,0,0,0,,Kyou!
Dialogue: 0,0:19:51.51,0:19:52.93,Default,Oka,0,0,0,,Tại sao cậu lại...
Dialogue: 0,0:19:53.34,0:19:54.93,Default,Oka,0,0,0,,Mái tóc của cậu!
Dialogue: 0,0:19:56.60,0:19:57.76,Default,Kyo,0,0,0,,Con bé vừa mắng tớ một trận đấy.
Dialogue: 0,0:19:59.77,0:20:03.39,Default,Kyo,0,0,0,,Ryou bảo tớ không được phép trốn chạy nữa.
Dialogue: 0,0:20:04.19,0:20:07.15,Default,Kyo,0,0,0,,Tớ từng nghĩ cứ giữ nguyên như thế này cũng chẳng sao.
Dialogue: 0,0:20:05.61,0:20:16.74,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K20}The {\K147}place {\K69}chan{\K51}ges {\K34}and {\K176}goes.{\K35} {\K39}Like {\K41}a {\K158}wind,{\K35} {\K79}like {\K184}clouds,
Dialogue: 0,0:20:07.82,0:20:13.95,Default,Kyo,0,0,0,,Tớ không muốn chọn cậu nếu như điều đó đồng nghĩa với việc làm tổn thương Ryou.
Dialogue: 0,0:20:15.11,0:20:17.37,Default,Kyo,0,0,0,,Thế nhưng con bé đã nói thẳng vào mặt tớ.
Dialogue: 0,0:20:16.53,0:20:30.42,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K36}Like {\K30}the {\K136}tra{\K91}ces {\K30}of {\K36}the {\K136}heart,{\K80} {\K67}no {\K93}halt{\K46} {\K62}at {\K37}the {\K458}places.
Dialogue: 0,0:20:17.37,0:20:19.33,Default,Kyo,0,0,0,,'Làm sao có thể như thế được chứ.'
Dialogue: 0,0:20:20.29,0:20:21.70,Default,Kyo,0,0,0,,'Đã quá muộn rồi.'
Dialogue: 0,0:20:22.91,0:20:27.21,Default,Kyo,0,0,0,,'Nếu chị thực sự yêu Tomoya, chị không được phép trốn chạy thêm một giây phút nào nữa.'
Dialogue: 0,0:20:28.04,0:20:31.76,Default,Kyo,0,0,0,,'Không còn con đường nào khác ngoài việc cả hai chúng ta đều sẽ phải chịu tổn thương.'
Dialogue: 0,0:20:31.05,0:20:41.60,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K20}The {\K160}place {\K54}is {\K84}so {\K150}far {\K66}a{\K97}way{\K43} {\K52}be {\K85}far {\K77}a{\K115}part.
Dialogue: 0,0:20:32.42,0:20:35.89,Default,Kyo,0,0,0,,'Bởi vì hai chị em mình đã trót yêu cùng một người rồi.'
Dialogue: 0,0:20:37.64,0:20:40.39,Default,Kyo,0,0,0,,Tớ cá là lúc này con bé đang khóc nhiều lắm.
Dialogue: 0,0:20:41.64,0:20:54.86,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K112}People's {\K88}hand{\K47} {\K74}does {\K75}not {\K140}reach,{\K47} {\K75}so {\K83}mere{\K66}ly {\K65}has {\K38}the {\K33}wor{\K328}ship.
Dialogue: 0,0:20:44.14,0:20:48.31,Default,Kyo,0,0,0,,Thật tình, tụi mình chậm chạp quá đi mất.
Dialogue: 0,0:20:48.56,0:20:52.90,Default,Kyo,0,0,0,,Chậm chạp trong việc nhận ra tình cảm, giả vờ như không nhận ra, và chậm chạp cả trong việc đối diện thẳng thắn với nhau.
Dialogue: 0,0:20:56.07,0:20:59.45,Default,Kyo,0,0,0,,Nhưng tớ sẽ biến đây thành lần cuối cùng chúng ta phải chịu tổn thương.
Dialogue: 0,0:20:56.45,0:21:07.29,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K34}The {\K147}place {\K71}is {\K59}a {\K146}lofty {\K57}lord, {\K90}can't {\K58}meet{\K19} {\K56}no{\K54}bo{\K43}dy {\K51}put {\K149}on.
Dialogue: 0,0:21:01.12,0:21:05.50,Default,Kyo,0,0,0,,Cả con bé, cả tớ, và cả cậu nữa.
Dialogue: 0,0:21:07.46,0:21:20.35,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K61}We {\K154}will {\K71}lose {\K73}the {\K123}place, {\K73}so {\K210}lofty {\K77}which {\K399}changes.
Dialogue: 0,0:21:07.50,0:21:08.17,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:21:11.80,0:21:13.97,Default,Kyo,0,0,0,,Tớ yêu cậu lắm, Tomoya.
Dialogue: 0,0:21:15.13,0:21:17.64,Default,Kyo,0,0,0,,Tớ... tớ...
Dialogue: 0,0:21:19.10,0:21:20.39,Default,Kyo,0,0,0,,...đã luôn luôn yêu cậu từ rất lâu rồi.
Dialogue: 0,0:21:20.72,0:21:32.23,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K86}Not {\K77}all {\K136}were {\K39}de{\K197}sired.{\K48} {\K47}How{\K91}ever, {\K137}we're {\K93}never {\K152}sad.
Dialogue: 0,0:21:31.86,0:21:33.44,Default,Ryo,0,0,0,,Xin cậu đừng nói lời xin lỗi.
Dialogue: 0,0:21:32.65,0:21:46.66,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K89}Still, {\K117}there {\K33}is {\K101}still {\K33}the {\K161}place.{\K52} {\K32}Far {\K35}a{\K87}way.{\K49} {\K57}Far {\K53}a{\K450}way.
Dialogue: 0,0:21:34.03,0:21:34.82,Default,Oka,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:35.15,0:21:42.70,Default,Ryo,0,0,0,,Nếu cậu xin lỗi và tớ chấp nhận lời xin lỗi ấy,\Nthì cảm giác như tất cả những chuyện đã qua chỉ là một trò đùa vậy.
Dialogue: 0,0:21:44.12,0:21:48.50,Default,Ryo,0,0,0,,Tớ muốn khắc ghi tất cả quãng thời gian ấy thành kỷ niệm.
Dialogue: 0,0:21:49.29,0:21:50.79,Default,Ryo,0,0,0,,Tất cả những khoảnh khắc vui vẻ.
Dialogue: 0,0:21:51.21,0:21:52.75,Default,Ryo,0,0,0,,Tất cả những thời khắc đau đớn, khó khăn.
Dialogue: 0,0:21:53.38,0:21:54.26,Default,Ryo,0,0,0,,Tất cả mọi thứ.
Dialogue: 0,0:21:56.05,0:21:58.72,Default,Ryo,0,0,0,,Vì vậy, xin cậu đừng xin lỗi tớ nhé.
Dialogue: 0,0:21:59.97,0:22:00.76,Default,Oka,0,0,0,,Được rồi.
Dialogue: 0,0:22:01.76,0:22:02.72,Default,Oka,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:22:09.06,0:22:11.77,Default,Oka,0,0,0,,Ngày mai chúng mình định đi đâu ấy nhỉ?
Dialogue: 0,0:22:11.77,0:22:13.86,Default,Oka,0,0,0,,Tụi mình bảo là sẽ đi đâu đó mà đúng không?
Dialogue: 0,0:22:13.86,0:22:16.44,Default,Kyo,0,0,0,,À, xin lỗi nhé. Hủy kèo đi.
Dialogue: 0,0:22:15.57,0:22:26.54,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K37}The {\K99}place {\K37}bu{\K54}ried {\K47}in {\K36}deep {\K186}snow.{\K43} {\K28}Like {\K34}the {\K140}co{\K42}llap{\K63}sing {\K29}ca{\K176}stle.
Dialogue: 0,0:22:17.82,0:22:21.49,Default,Kyo,0,0,0,,Ryou vừa rủ tớ ngày mai đi mua sắm cùng con bé rồi.
Dialogue: 0,0:22:21.49,0:22:22.53,Default,Kyo,0,0,0,,Nên tớ không đi với cậu được đâu.
Dialogue: 0,0:22:24.37,0:22:26.04,Default,Oka,0,0,0,,Xem ra tớ chẳng có sự lựa chọn nào khác rồi.
Dialogue: 0,0:22:26.37,0:22:39.80,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K52}Like {\K27}the {\K208}head {\K45}of {\K22}the {\K169}shade,{\K53} {\K38}fi{\K38}gure {\K106}will {\K25}be {\K79}thrown {\K34}a{\K397}way.
Dialogue: 0,0:22:26.75,0:22:28.75,Default,Kyo,0,0,0,,Chuẩn luôn. Cậu làm gì có quyền từ chối chứ.
Dialogue: 0,0:22:33.34,0:22:35.38,Default,Kyo,0,0,0,,Dạo này trời bắt đầu nóng lên thật rồi nhỉ?
Dialogue: 0,0:22:35.38,0:22:36.34,Default,Oka,0,0,0,,Ừ.
Dialogue: 0,0:22:37.76,0:22:40.80,Default,Kyo,0,0,0,,Này cậu. Chọn tớ... liệu có thực sự là quyết định đúng đắn không?
Dialogue: 0,0:22:41.18,0:22:51.81,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K33}The {\K94}place {\K98}is {\K58}a {\K70}lof{\K71}ty {\K70}lord, {\K82}can't {\K39}meet {\K88}no{\K70}bo{\K44}dy {\K42}put {\K155}on.
Dialogue: 0,0:22:41.64,0:22:42.47,Default,Oka,0,0,0,,Hả?
Dialogue: 0,0:22:43.10,0:22:47.85,Default,Kyo,0,0,0,,Cậu có chắc là trong thâm tâm cậu không nghĩ rằng ở bên cạnh Ryou sẽ thoải mái hơn không đấy?
Dialogue: 0,0:22:48.43,0:22:50.69,Default,Oka,0,0,0,,Này. Tớ giận thật bây giờ đấy nhé.
Dialogue: 0,0:22:50.69,0:22:52.40,Default,Kyo,0,0,0,,Ừ. Xin cậu hãy giận tớ đi.
Dialogue: 0,0:22:51.85,0:23:07.66,Kara-Ins,,0,0,0,,{\fad(200,300)\be1\pos(960,48)}{\K20}{\K81}Still, {\K107}there {\K33}is {\K80}still {\K58}the {\K114}place.{\K29} {\K80}Far {\K66}a{\K136}way. {\K79}Far {\K64}a{\K601}way.
Dialogue: 0,0:22:53.11,0:22:55.69,Default,Kyo,0,0,0,,Như thế thì tớ mới yên lòng được.
Dialogue: 0,0:22:56.36,0:22:58.61,Default,Oka,0,0,0,,Chẳng phải có gì đó sai sai ở đây sao?
Dialogue: 0,0:22:59.15,0:23:01.74,Default,Kyo,0,0,0,,Vậy thì hãy làm cho nó thật đơn giản nhé.
Dialogue: 0,0:23:06.24,0:23:07.91,Default,Oka,0,0,0,,N-Này cậu!
Dialogue: 0,0:23:21.43,0:23:22.95,Default,Kyo,0,0,0,,Tomoya.
Dialogue: 0,0:23:22.95,0:23:24.50,Default,Kyo,0,0,0,,Tớ yêu cậu.
Dialogue: 0,0:23:29.31,0:23:31.01,Default,Kyo,0,0,0,,Mùa hè sắp đến rồi nhỉ?
Dialogue: 0,0:23:31.57,0:23:32.52,Default,Oka,0,0,0,,Ừ.
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,{\be1\fad(0,0)}
