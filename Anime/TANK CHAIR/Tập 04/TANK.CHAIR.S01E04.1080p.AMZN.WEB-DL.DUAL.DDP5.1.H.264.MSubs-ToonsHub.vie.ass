Dialogue: 0,0:00:38.75,0:00:40.08,Default,,0,0,0,,Chúng biến đâu mất rồi?
Dialogue: 0,0:00:46.67,0:00:47.55,Default,,0,0,0,,Hả?
Dialogue: 0,0:00:51.39,0:00:54.89,Default,,0,0,0,,Xe Lăn Thiết Giáp Mẫu III.
Dialogue: 0,0:00:56.47,0:00:57.35,Default,,0,0,0,,"Thiết Quyền".
Dialogue: 0,0:01:01.35,0:01:05.19,Default,,0,0,0,,Hà... Vậy mới được chứ, Nagi.
Dialogue: 0,0:01:06.86,0:01:09.40,Default,,0,0,0,,Một chiếc xe lăn chiến đấu sao?
Dialogue: 0,0:01:12.03,0:01:15.37,Default,,0,0,0,,Hử? "Để tôi xử đẹp hắn trước"?
Dialogue: 0,0:01:15.79,0:01:17.37,Default,,0,0,0,,Xem ra đành chịu rồi.
Dialogue: 0,0:01:22.75,0:01:26.34,Default,,0,0,0,,Touko, dùng van thứ hai đi.
Dialogue: 0,0:03:11.61,0:03:15.11,Default,,0,0,0,,Touko, dùng van thứ hai đi.
Dialogue: 0,0:03:54.32,0:03:55.53,Default,,0,0,0,,GIẾT
Dialogue: 0,0:04:30.40,0:04:33.90,Default,,0,0,0,,Thế này là đủ rồi. Thêm nữa thì...
Dialogue: 0,0:04:48.96,0:04:50.59,Default,,0,0,0,,Chậc.
Dialogue: 0,0:04:51.29,0:04:54.88,Default,,0,0,0,,Hóa ra chỉ là thùng rỗng kêu to thôi à?!
Dialogue: 0,0:04:58.92,0:05:00.46,Default,,0,0,0,,Touko, kết liễu hắn đi!
Dialogue: 0,0:05:06.85,0:05:08.64,Default,,0,0,0,,GIẾT GIẾT GIẾT
Dialogue: 0,0:05:11.69,0:05:12.69,Default,,0,0,0,,GIẾT
Dialogue: 0,0:05:16.48,0:05:17.86,Default,,0,0,0,,GIẾT GIẾT GIẾT
Dialogue: 0,0:05:31.04,0:05:31.92,Default,,0,0,0,,Hả?!
Dialogue: 0,0:05:32.46,0:05:33.88,Default,,0,0,0,,Đỉnh thật đấy...
Dialogue: 0,0:05:34.88,0:05:37.09,Default,,0,0,0,,Trước giờ ngươi luôn mạnh thế này sao?
Dialogue: 0,0:05:50.52,0:05:52.15,Default,,0,0,0,,Sát khí tuyệt vời đấy!
Dialogue: 0,0:05:52.56,0:05:54.31,Default,,0,0,0,,Tôi đã bảo là không ổn rồi mà...
Dialogue: 0,0:05:54.81,0:05:55.69,Default,,0,0,0,,Touko!
Dialogue: 0,0:06:22.67,0:06:23.55,Default,,0,0,0,,Hả?!
Dialogue: 0,0:06:27.51,0:06:31.56,Default,,0,0,0,,Ngay cả khi hắn ở trong tình trạng đó\Nmà ngươi vẫn bị đè bẹp sao...?!
Dialogue: 0,0:06:34.10,0:06:35.60,Default,,0,0,0,,Chậc.
Dialogue: 0,0:06:36.77,0:06:40.98,Default,,0,0,0,,Tức chết đi được!
Dialogue: 0,0:07:07.85,0:07:09.60,Default,,0,0,0,,{\i1}Aaaa!{\i0}
Dialogue: 0,0:07:40.04,0:07:43.09,Default,,0,0,0,,Chà... luồng sát khí này\Nkinh khủng thật đấy...
Dialogue: 0,0:07:50.68,0:07:54.39,Default,,0,0,0,,Lâu lắm rồi mình mới thấy tỉnh táo thế này.
Dialogue: 0,0:07:56.39,0:07:58.23,Default,,0,0,0,,Ngươi vẫn còn chịu được...
Dialogue: 0,0:07:59.23,0:08:00.11,Default,,0,0,0,,đúng chứ?
Dialogue: 0,0:08:00.98,0:08:03.15,Default,,0,0,0,,Cho ta thêm nữa đi!
Dialogue: 0,0:08:13.45,0:08:17.50,Default,,0,0,0,,{\i1}Aaaa!{\i0}
Dialogue: 0,0:08:20.21,0:08:21.09,Default,,0,0,0,,Hự!
Dialogue: 0,0:08:21.54,0:08:22.54,Default,,0,0,0,,{\i1}Touko,{\i0}
Dialogue: 0,0:08:23.30,0:08:24.89,Default,,0,0,0,,{\i1}cứ để đấy cho tôi.{\i0}
Dialogue: 0,0:08:28.47,0:08:32.02,Default,,0,0,0,,{\i1}Xem ra ngươi vẫn{\i0}
Dialogue: 0,0:08:32.72,0:08:35.26,Default,,0,0,0,,{\i1}vênh váo tự phụ y như trước.{\i0}
Dialogue: 0,0:08:35.72,0:08:41.52,Default,,0,0,0,,{\i1}Ngươi thật sự nghĩ bọn này\Nkhông giết nổi ngươi sao?{\i0}
Dialogue: 0,0:08:42.44,0:08:44.44,Default,,0,0,0,,{\i1}Ngươi biết không...{\i0}
Dialogue: 0,0:08:44.98,0:08:50.44,Default,,0,0,0,,{\i1}Từ lúc ngươi biến mất,\Nbọn này không hề ngồi yên một chỗ đâu!{\i0}
Dialogue: 0,0:08:56.33,0:08:58.33,Default,,0,0,0,,Cái quái gì thế kia? Gớm chết đi được.
Dialogue: 0,0:09:00.21,0:09:01.92,Default,,0,0,0,,{\i1}Không, quan trọng hơn là...{\i0}
Dialogue: 0,0:09:02.92,0:09:06.30,Default,,0,0,0,,{\i1}Đáng lẽ Nagi phải cảm nhận được\Nsát khí mà né chứ...{\i0}
Dialogue: 0,0:09:07.97,0:09:09.01,Default,,0,0,0,,{\i1}Không lẽ nào...!{\i0}
Dialogue: 0,0:09:09.80,0:09:11.93,Default,,0,0,0,,{\i1}Mặt nạ xóa bỏ sát khí sao...?{\i0}
Dialogue: 0,0:09:17.72,0:09:20.10,Default,,0,0,0,,{\i1}Khốn khiếp!{\i0}
Dialogue: 0,0:09:21.23,0:09:23.69,Default,,0,0,0,,{\i1}Ở trạng thái này...{\i0}
Dialogue: 0,0:09:23.69,0:09:27.28,Default,,0,0,0,,{\i1}đầu tôi đau như muốn nổ tung!{\i0}
Dialogue: 0,0:09:28.03,0:09:29.41,Default,,0,0,0,,{\i1}Thân mềm đau nửa đầu.{\i0}
Dialogue: 0,0:09:30.03,0:09:32.49,Default,,0,0,0,,{\i1}Một sinh vật bán sống bán chết\Nký sinh vào não bộ.{\i0}
Dialogue: 0,0:09:32.95,0:09:36.37,Default,,0,0,0,,{\i1}Nó có nhiều công dụng khác nhau,\Nnhư ngụy trang hoặc biến trang,{\i0}
Dialogue: 0,0:09:36.79,0:09:41.55,Default,,0,0,0,,{\i1}cũng như che giấu sóng não\Nvà sự hiện diện của vật chủ.{\i0}
Dialogue: 0,0:09:42.67,0:09:46.88,Default,,0,0,0,,{\i1}Tuy nhiên, do vật chủ\Nphải chịu đựng những cơn đau đầu kinh niên,{\i0}
Dialogue: 0,0:09:47.25,0:09:50.96,Default,,0,0,0,,{\i1}nhiều kẻ không chịu đựng nổi\Nmà cuối cùng đã tự kết liễu đời mình.{\i0}
Dialogue: 0,0:09:52.51,0:09:53.97,Default,,0,0,0,,{\i1}Học Viện{\i0}
Dialogue: 0,0:09:54.76,0:09:58.47,Default,,0,0,0,,{\i1}không chứa chấp kẻ yếu.{\i0}
Dialogue: 0,0:09:59.39,0:10:03.60,Default,,0,0,0,,{\i1}Bọn này đã làm mọi cách{\i0}
Dialogue: 0,0:10:03.73,0:10:06.48,Default,,0,0,0,,{\i1}để có thể sống sót ở nơi đó...{\i0}
Dialogue: 0,0:10:07.15,0:10:11.65,Default,,0,0,0,,{\i1}Bọn này không giống lũ hèn nhát bỏ trốn như chúng mày!{\i0}
Dialogue: 0,0:10:12.07,0:10:15.57,Default,,0,0,0,,{\i1}Nagiii!{\i0}
Dialogue: 0,0:10:23.75,0:10:28.13,Default,,0,0,0,,{\i1}Bọn này không giống lũ hèn nhát bỏ trốn như chúng mày!{\i0}
Dialogue: 0,0:10:28.55,0:10:31.47,Default,,0,0,0,,{\i1}Nagiii!{\i0}
Dialogue: 0,0:11:07.33,0:11:11.17,Default,,0,0,0,,{\i1}Sao thế? Bắt đầu chậm chạp rồi đấy à.{\i0}
Dialogue: 0,0:11:11.55,0:11:14.01,Default,,0,0,0,,{\i1}Cạn kiệt sát khí rồi sao?{\i0}
Dialogue: 0,0:11:30.61,0:11:34.32,Default,,0,0,0,,{\i1}Hắn đã nhận ra rồi...{\i0}
Dialogue: 0,0:11:34.53,0:11:37.70,Default,,0,0,0,,{\i1}Với năng lực gốc của ngươi{\i0}
Dialogue: 0,0:11:38.28,0:11:41.58,Default,,0,0,0,,{\i1}là "chuyển hóa sát khí\Nhướng về mình thành sức mạnh"...{\i0}
Dialogue: 0,0:11:42.95,0:11:44.49,Default,,0,0,0,,{\i1}Chẳng phải điều đó đồng nghĩa với việc lúc này{\i0}
Dialogue: 0,0:11:44.83,0:11:49.79,Default,,0,0,0,,{\i1}ngươi chỉ tỉnh lại khi sắp sửa bị giết sao?{\i0}
Dialogue: 0,0:11:57.63,0:12:03.26,Default,,0,0,0,,{\i1}Không ngờ thiên tài năm nào\Nlại có kết cục thảm hại thế này...{\i0}
Dialogue: 0,0:12:04.85,0:12:09.23,Default,,0,0,0,,{\i1}Tao luôn căm thù mày.{\i0}
Dialogue: 0,0:12:44.81,0:12:45.73,Default,,0,0,0,,{\i1}Chậc!{\i0}
Dialogue: 0,0:12:45.89,0:12:46.77,Default,,0,0,0,,{\i1}Nhưng mà...{\i0}
Dialogue: 0,0:12:48.35,0:12:50.10,Default,,0,0,0,,{\i1}tao đã luôn nghĩ...{\i0}
Dialogue: 0,0:12:53.44,0:12:57.03,Default,,0,0,0,,{\i1}rằng một ngày nào đó, tao muốn đứng ngang hàng với mày...{\i0}
Dialogue: 0,0:13:00.11,0:13:02.70,Default,,0,0,0,,Thế mà...!
Dialogue: 0,0:13:03.20,0:13:08.87,Default,,0,0,0,,Không ngờ mày lại ra nông nỗi này\Nchỉ vì một đứa rác rưởi như thế!
Dialogue: 0,0:13:16.51,0:13:18.35,Default,,0,0,0,,Cũng... không tệ...
Dialogue: 0,0:13:24.22,0:13:26.22,Default,,0,0,0,,Thân thể này...
Dialogue: 0,0:13:28.56,0:13:30.98,Default,,0,0,0,,cũng... không tệ chút nào...
Dialogue: 0,0:13:31.77,0:13:32.65,Default,,0,0,0,,{\i1}Hả...?{\i0}
Dialogue: 0,0:13:38.32,0:13:40.20,Default,,0,0,0,,Ta có thể cảm nhận...
Dialogue: 0,0:13:42.49,0:13:43.74,Default,,0,0,0,,"mối liên kết"...
Dialogue: 0,0:13:46.28,0:13:50.99,Default,,0,0,0,,mãnh liệt hơn... trước đây...
Dialogue: 0,0:14:03.22,0:14:04.56,Default,,0,0,0,,Cái gì...?
Dialogue: 0,0:14:05.01,0:14:07.35,Default,,0,0,0,,{\i1}Nói mấy lời đó mà không thấy ngượng à?{\i0}
Dialogue: 0,0:14:10.27,0:14:12.02,Default,,0,0,0,,Ừ... nhóc nói đúng đấy...
Dialogue: 0,0:14:15.11,0:14:18.45,Default,,0,0,0,,Shizuka sẽ bảo mình...
Dialogue: 0,0:14:20.74,0:14:23.70,Default,,0,0,0,,sến sẩm mất...
Dialogue: 0,0:14:30.25,0:14:34.05,Default,,0,0,0,,{\i1}Cuối cùng cũng hết nhiên liệu rồi à?{\i0}
Dialogue: 0,0:14:37.21,0:14:38.09,Default,,0,0,0,,{\i1}Ồ?{\i0}
Dialogue: 0,0:14:59.07,0:15:00.07,Default,,0,0,0,,{\i1}Nagi...{\i0}
Dialogue: 0,0:15:04.78,0:15:11.70,Default,,0,0,0,,{\i1}Tao sẽ đích thân... kết liễu mày...{\i0}
Dialogue: 0,0:15:16.17,0:15:18.84,Default,,0,0,0,,{\i1}Vĩnh biệt!{\i0}
Dialogue: 0,0:15:20.71,0:15:24.09,Default,,0,0,0,,Aaaa!
Dialogue: 0,0:15:36.90,0:15:42.86,Default,,0,0,0,,{\i1}Mày tưởng tao không để ý\Nmày chạy lăng xăng nãy giờ chắc?{\i0}
Dialogue: 0,0:15:45.78,0:15:47.74,Default,,0,0,0,,{\i1}Nhìn cho kỹ đi.{\i0}
Dialogue: 0,0:15:48.45,0:15:51.70,Default,,0,0,0,,{\i1}Anh trai mày sắp chết rồi đấy.{\i0}
Dialogue: 0,0:15:52.33,0:15:55.79,Default,,0,0,0,,{\i1}Và tất cả là tại mày, đồ phế vật.{\i0}
Dialogue: 0,0:16:00.75,0:16:07.09,Default,,0,0,0,,Lẽ ra ngươi nên giết tao sớm hơn...\NThì ngươi đã có thể tự cứu lấy mình rồi...
Dialogue: 0,0:16:07.09,0:16:08.05,Default,,0,0,0,,{\i1}Hả...?{\i0}
Dialogue: 0,0:16:12.85,0:16:13.73,Default,,0,0,0,,{\i1}Hử?{\i0}
Dialogue: 0,0:16:16.39,0:16:19.56,Default,,0,0,0,,Ý tao là vừa kịp lúc chạm đến anh ấy đấy, đồ đần!
Dialogue: 0,0:16:25.15,0:16:26.86,Default,,0,0,0,,Ta đã bảo rồi mà.
Dialogue: 0,0:16:27.99,0:16:32.16,Default,,0,0,0,,Ta có thể cảm nhận "mối liên kết"\Nmãnh liệt hơn trước đây...
Dialogue: 0,0:16:32.16,0:16:33.66,Default,,0,0,0,,{\i1}"Mối liên kết"...?{\i0}
Dialogue: 0,0:16:35.41,0:16:36.45,Default,,0,0,0,,{\i1}Không lẽ nào...{\i0}
Dialogue: 0,0:16:45.71,0:16:47.17,Default,,0,0,0,,MỐI LIÊN KẾT (SÁT KHÍ)
Dialogue: 0,0:16:47.38,0:16:53.26,Default,,0,0,0,,{\i1}Hóa ra Shizuka nhắm vào Nagi, chứ không phải mình sao...?{\i0}
Dialogue: 0,0:16:53.89,0:16:55.06,Default,,0,0,0,,Lêu lêu!
Dialogue: 0,0:16:56.10,0:16:59.19,Default,,0,0,0,,{\i1}C... Chết điii!{\i0}
Dialogue: 0,0:17:09.15,0:17:10.15,Default,,0,0,0,,Chết tiệt...
Dialogue: 0,0:17:24.63,0:17:26.51,Default,,0,0,0,,Con nhỏ phế vật đó...
Dialogue: 0,0:17:27.30,0:17:30.43,Default,,0,0,0,,thật sự định giết cả anh ruột của mình sao...
Dialogue: 0,0:17:31.55,0:17:33.22,Default,,0,0,0,,"Sát khí" được tạo nên từ...
Dialogue: 0,0:17:33.80,0:17:36.43,Default,,0,0,0,,sóng não xuất phát từ tiềm thức vô thức...
Dialogue: 0,0:17:37.47,0:17:40.22,Default,,0,0,0,,Ngươi không thể tạo ra nó\Nchỉ bằng cách giả vờ muốn giết ai đó được.
Dialogue: 0,0:17:41.44,0:17:42.65,Default,,0,0,0,,Hầy...
Dialogue: 0,0:17:43.52,0:17:46.11,Default,,0,0,0,,Hai đứa đó điên thật rồi...
Dialogue: 0,0:17:52.16,0:17:55.71,Default,,0,0,0,,Cậu đang lo không biết phải giải trình sao với Thầy à?
Dialogue: 0,0:17:58.75,0:18:03.46,Default,,0,0,0,,Tùy vào tình hình,\Ncó khi chúng ta cũng bị buộc phải "tốt nghiệp" đấy...
Dialogue: 0,0:18:08.71,0:18:12.38,Default,,0,0,0,,Aaa... Đầu tôi đau buốt quá...
Dialogue: 0,0:18:30.65,0:18:31.53,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:18:36.41,0:18:38.96,Default,,0,0,0,,Hai anh em nhà Kurosaka đã trốn thoát,
Dialogue: 0,0:18:39.66,0:18:43.25,Default,,0,0,0,,đồng nghĩa với việc Học Viện\Nsẽ sớm biết nơi ẩn náu của chúng ta.
Dialogue: 0,0:18:43.92,0:18:47.01,Default,,0,0,0,,Ừm... chắc là chuyện sẽ thành ra thế rồi.
Dialogue: 0,0:18:56.34,0:18:57.30,Default,,0,0,0,,Uầy!
Dialogue: 0,0:19:10.11,0:19:10.99,Default,,0,0,0,,Anh Shizuka.
Dialogue: 0,0:19:12.78,0:19:15.74,Default,,0,0,0,,Hứa với em một chuyện đi.
Dialogue: 0,0:19:18.20,0:19:21.33,Default,,0,0,0,,Nếu đến lúc mà chỉ có một trong hai đứa mình\Nđược sống sót,
Dialogue: 0,0:19:23.00,0:19:26.30,Default,,0,0,0,,anh nhất định phải đặt mạng sống của anh lên hàng đầu đấy.
Dialogue: 0,0:19:34.59,0:19:35.51,Default,,0,0,0,,Gì cơ?!
Dialogue: 0,0:19:37.05,0:19:38.26,Default,,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:19:44.60,0:19:45.52,Default,,0,0,0,,Ái đau!
Dialogue: 0,0:19:45.94,0:19:47.73,Default,,0,0,0,,Anh làm trò gì thế? Em đang bị thương đấy!
Dialogue: 0,0:19:53.32,0:19:54.45,Default,,0,0,0,,{\i1}Em biết chứ.{\i0}
Dialogue: 0,0:19:55.70,0:20:00.50,Default,,0,0,0,,{\i1}Em biết ai là người sở hữu sát khí\Ncó thể chữa lành cho Nagi...{\i0}
Dialogue: 0,0:20:02.41,0:20:03.95,Default,,0,0,0,,{\i1}Em biết rõ, nhưng mà...{\i0}
Dialogue: 0,0:20:05.08,0:20:08.46,Default,,0,0,0,,{\i1}em đã quá sợ hãi, nên cứ trốn tránh sự thật ấy.{\i0}
Dialogue: 0,0:20:18.59,0:20:19.84,Default,,0,0,0,,Ngoan lắm.
Dialogue: 0,0:20:21.68,0:20:23.72,Default,,0,0,0,,Bé ngoan lắm.
Dialogue: 0,0:20:24.31,0:20:25.19,Default,,0,0,0,,Thưa Thầy.
Dialogue: 0,0:20:26.18,0:20:30.31,Default,,0,0,0,,Chúng ta vừa nhận được điện báo mã hóa\Ntừ Kurosaka, đang thi hành nhiệm vụ ở Quỷ Thành.
Dialogue: 0,0:20:31.94,0:20:32.82,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:20:35.65,0:20:38.90,Default,,0,0,0,,Trong đó báo cáo rằng hắn đã tìm thấy Nagi Taira.
Dialogue: 0,0:20:47.91,0:20:50.75,Default,,0,0,0,,{\i1}Hỏng rồi...{\i0}
Dialogue: 0,0:20:54.38,0:20:58.05,Default,,0,0,0,,{\i1}Mình đã để mất kiểm soát...{\i0}
Dialogue: 0,0:21:01.76,0:21:06.35,Default,,0,0,0,,{\i1}Nhưng... thời điểm phải đối mặt với họ đã đến.{\i0}
Dialogue: 0,0:21:08.10,0:21:10.60,Default,,0,0,0,,{\i1}"Sát thủ tối thượng" năm xưa{\i0}
Dialogue: 0,0:21:11.44,0:21:15.36,Default,,0,0,0,,{\i1}mà chúng ta từng chật vật trốn thoát...{\i0}
Dialogue: 0,0:21:19.32,0:21:20.20,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:21:22.74,0:21:23.62,Default,,0,0,0,,Hở?
Dialogue: 0,0:21:29.75,0:21:30.63,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:21:37.05,0:21:41.39,Default,,0,0,0,,Nhắc mới nhớ, em lại làm mất thêm\Nmột chiếc tất yêu thích nữa rồi.
Dialogue: 0,0:21:41.63,0:21:43.46,Default,,0,0,0,,Chúng cứ biến đâu mất tiêu không biết...?
Dialogue: 0,0:21:43.47,0:21:46.02,Default,,0,0,0,,Đồ đạc mất là do phòng em bừa bộn đấy.
Dialogue: 0,0:21:46.35,0:21:48.06,Default,,0,0,0,,Em phải dọn dẹp cho ngăn nắp vào--
Dialogue: 0,0:21:48.06,0:21:51.81,Default,,0,0,0,,Vô duyên ghê. Em biết rõ mọi thứ ở đâu mà!
Dialogue: 0,0:21:51.81,0:21:53.56,Default,,0,0,0,,Không hề. Chiếc tất của em đang mất tích kìa.
Dialogue: 0,0:21:53.81,0:21:54.69,Default,,0,0,0,,Ơ...
Dialogue: 0,0:22:00.70,0:22:02.54,Default,,0,0,0,,- Này!\N- Úi da!
Dialogue: 0,0:22:08.45,0:22:09.62,Default,,0,0,0,,{\i1}Nagi...{\i0}
Dialogue: 0,0:22:12.37,0:22:13.66,Default,,0,0,0,,{\an8}KẺ GIÁO HÓA CỦA CÁI CHẾT
Dialogue: 0,0:22:13.67,0:22:14.80,Default,,0,0,0,,{\i1}Tôi muốn...{\i0}
Dialogue: 0,0:22:16.88,0:22:19.51,Default,,0,0,0,,được gặp lại... các người...
Dialogue: 0,0:23:56.10,0:23:58.06,Default,,0,0,0,,{\an8}MINH HỌA: TAKU KUWABARA
Dialogue: 0,0:23:58.06,0:24:01.06,Default,,0,0,0,,{\an8}Phụ đề Việt ngữ: Amtia(NOFACE)
