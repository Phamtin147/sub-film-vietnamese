Dialogue: 0,0:00:22.90,0:00:24.44,Default,,0,0,0,,{\i1}Ở tập trước của Tank Chair...{\i0}
Dialogue: 0,0:00:25.03,0:00:26.53,Default,,0,0,0,,{\i1}Trong lúc bảo vệ em gái,{\i0}
Dialogue: 0,0:00:27.90,0:00:32.20,Default,,0,0,0,,{\i1}sát thủ mạnh nhất thành phố là Nagi\Nđã rơi vào trạng thái hôn mê.{\i0}
Dialogue: 0,0:00:33.45,0:00:36.16,Default,,0,0,0,,{\i1}Chỉ có một thứ đánh thức được anh ấy.{\i0}
Dialogue: 0,0:00:37.50,0:00:38.96,Default,,0,0,0,,{\i1}Đó chính là "sát khí".{\i0}
Dialogue: 0,0:00:43.09,0:00:43.92,Default,,0,0,0,,GIẾT
Dialogue: 0,0:00:44.42,0:00:45.42,Default,,0,0,0,,GIẾT GIẾT GIẾT
Dialogue: 0,0:00:47.97,0:00:49.76,Default,,0,0,0,,Thuốc này công hiệu đấy chứ.
Dialogue: 0,0:00:50.51,0:00:53.60,Default,,0,0,0,,Lâu lắm rồi mới thấy tỉnh táo thế này.
Dialogue: 0,0:00:58.60,0:01:02.27,Default,,0,0,0,,{\i1}Bị Học viện dồn vào đường cùng,\NNagi và Shizuka quyết định đối đầu với Thầy,{\i0}
Dialogue: 0,0:01:03.11,0:01:08.49,Default,,0,0,0,,{\i1}kẻ mang sát khí\Nmạnh mẽ hơn bất kỳ ai.{\i0}
Dialogue: 0,0:01:10.28,0:01:13.16,Default,,0,0,0,,{\i1}Cơ hội duy nhất để đánh bại ông ta{\i0}
Dialogue: 0,0:01:13.95,0:01:16.91,Default,,0,0,0,,{\i1}là tìm đến Tiến sĩ Radio,\Nngười thiết kế ra Tank Chair,{\i0}
Dialogue: 0,0:01:17.54,0:01:22.59,Default,,0,0,0,,{\i1}để hoàn thiện chiếc No Mark huyền thoại...{\i0}
Dialogue: 0,0:01:23.04,0:01:24.58,Default,,0,0,0,,{\i1}Đừng có làm chuyện ngu ngốc đấy.{\i0}
Dialogue: 0,0:01:24.88,0:01:27.09,Default,,0,0,0,,{\i1}Mau kiếm chỗ nào trốn kỹ đi.{\i0}
Dialogue: 0,0:01:29.26,0:01:30.14,Default,,0,0,0,,{\i1}Hả?!{\i0}
Dialogue: 0,0:01:30.42,0:01:32.67,Default,,0,0,0,,Tránh đường nào!
Dialogue: 0,0:01:40.35,0:01:44.06,Default,,0,0,0,,Này, đám này ở đâu ra vậy?\NChắc chắn là đi đúng đường chứ hả?
Dialogue: 0,0:01:44.61,0:01:47.20,Default,,0,0,0,,Trước đây làm gì có chúng đâu.
Dialogue: 0,0:01:55.07,0:01:57.91,Default,,0,0,0,,B... Bọn cháu tới rồi đây.
Dialogue: 0,0:01:59.25,0:02:00.71,Default,,0,0,0,,Đúng là một cặp ngốc.
Dialogue: 0,0:03:34.30,0:03:38.22,Default,,0,0,0,,{\an8}15 NĂM TRƯỚC - GẦN BIÊN GIỚI\NMỘT QUỐC GIA
Dialogue: 0,0:03:46.14,0:03:48.18,Default,,0,0,0,,Ăn đòn đi!
Dialogue: 0,0:03:49.73,0:03:51.19,Default,,0,0,0,,Hoan hô!
Dialogue: 0,0:04:11.38,0:04:12.30,Default,,0,0,0,,Á!
Dialogue: 0,0:04:23.93,0:04:25.18,Default,,0,0,0,,Hửm?
Dialogue: 0,0:04:26.81,0:04:28.40,Default,,0,0,0,,Sao thế ạ, Đội trưởng?
Dialogue: 0,0:04:30.40,0:04:31.69,Default,,0,0,0,,Cậu chạy trước đi.
Dialogue: 0,0:04:37.40,0:04:39.03,Default,,0,0,0,,{\i1}Mình không thể...{\i0}
Dialogue: 0,0:04:49.21,0:04:52.71,Default,,0,0,0,,Hóa ra vẫn còn sót lại\Nmột con chuột bẩn thỉu nữa cơ đấy.
Dialogue: 0,0:04:58.05,0:05:00.26,Default,,0,0,0,,{\i1}K... Kẻ nào?!{\i0}
Dialogue: 0,0:05:01.26,0:05:04.89,Default,,0,0,0,,Và thế là tiễn nốt cả lũ chúng bay.
Dialogue: 0,0:05:21.41,0:05:22.91,Default,,0,0,0,,{\i1}Anh hai!{\i0}
Dialogue: 0,0:05:24.95,0:05:28.66,Default,,0,0,0,,Ààà, sảng khoái thật đấy.
Dialogue: 0,0:05:31.75,0:05:35.05,Default,,0,0,0,,{\an8}3 NĂM TRƯỚC - ĐẢO QUỶ THÀNH (GUICHENG)
Dialogue: 0,0:05:50.06,0:05:51.81,Default,,0,0,0,,Bác là Tiến sĩ Radio phải không?
Dialogue: 0,0:05:55.77,0:05:57.56,Default,,0,0,0,,"Tiến sĩ Radio".
Dialogue: 0,0:05:57.82,0:06:02.41,Default,,0,0,0,,Bác có biệt danh đó là vì dùng sóng não\Nđể điều khiển động vật từ xa đúng không?
Dialogue: 0,0:06:07.66,0:06:11.37,Default,,0,0,0,,Này, mấy cái thứ như ăng-ten trên đầu kia\Nlà để làm trò đó hả?
Dialogue: 0,0:06:11.58,0:06:13.87,Default,,0,0,0,,Vậy thân thể thật của bác đang ở đâu?\NNgay trên đảo Guicheng này à?
Dialogue: 0,0:06:14.04,0:06:17.63,Default,,0,0,0,,Một thiên tài mới tuổi thiếu niên đã đứng đầu\Nbộ Khoa học như bác...
Dialogue: 0,0:06:17.63,0:06:19.38,Default,,0,0,0,,lại chui rúc ở một nơi thế này làm gì chứ?
Dialogue: 0,0:06:19.71,0:06:21.50,Default,,0,0,0,,Này, đói bụng không?
Dialogue: 0,0:06:21.51,0:06:22.80,Default,,0,0,0,,Ăn thử đồ ăn cho chó nhé?
Dialogue: 0,0:06:26.68,0:06:28.10,Default,,0,0,0,,Này...
Dialogue: 0,0:06:32.64,0:06:37.73,Default,,0,0,0,,A lô, có phải "Đội Bắt Thú Hoang Cấp Tốc\N911" đó không ạ?
Dialogue: 0,0:06:37.98,0:06:42.90,Default,,0,0,0,,Nhờ bên anh xử lý giùm một con chó hoang bẩn thỉu\Ncứ lén lút theo dõi người khác...
Dialogue: 0,0:06:42.90,0:06:44.69,Default,,0,0,0,,- Nó đang ở--\N- {\i1}Này!{\i0}
Dialogue: 0,0:06:45.66,0:06:49.16,Default,,0,0,0,,Thấy chưa? Biết ngay mà!
Dialogue: 0,0:06:49.41,0:06:51.96,Default,,0,0,0,,{\i1}Nhóc muốn gì? Tìm ta có chuyện gì?{\i0}
Dialogue: 0,0:06:53.16,0:06:55.91,Default,,0,0,0,,Tôi muốn bác chế tạo cho tôi một thứ.
Dialogue: 0,0:07:01.26,0:07:04.43,Default,,0,0,0,,Nếu bác chịu giúp tôi chuyện này,
Dialogue: 0,0:07:05.93,0:07:07.97,Default,,0,0,0,,tôi sẽ giết tên kia giúp bác.
Dialogue: 0,0:07:09.89,0:07:11.23,Default,,0,0,0,,Cái gã lúc nãy ấy...
Dialogue: 0,0:07:11.60,0:07:15.02,Default,,0,0,0,,Hắn là trùm của băng lính đánh thuê\Nnổi tiếng khắp Guicheng đúng không?
Dialogue: 0,0:07:15.73,0:07:18.48,Default,,0,0,0,,Tôi chẳng biết bác có mối thù oán gì với hắn đâu.
Dialogue: 0,0:07:18.69,0:07:21.69,Default,,0,0,0,,Nhưng hắn được bảo vệ 24/7,
Dialogue: 0,0:07:21.69,0:07:27.82,Default,,0,0,0,,nên nếu không phải sát thủ chuyên nghiệp mà đòi đụng\Nvào hắn thì đúng là điên rồ đấy.
Dialogue: 0,0:07:32.54,0:07:37.38,Default,,0,0,0,,{\i1}Vậy thứ nhóc muốn ta chế tạo\Nlà cái gì?{\i0}
Dialogue: 0,0:07:38.17,0:07:42.51,Default,,0,0,0,,Chuyên môn của bác là, ờm...
Dialogue: 0,0:07:43.92,0:07:48.30,Default,,0,0,0,,"Bổ trợ chức năng cơ thể\Nbằng kỹ thuật cơ khí ứng dụng,
Dialogue: 0,0:07:48.30,0:07:51.80,Default,,0,0,0,,và nghiên cứu chăm sóc, hỗ trợ\Nchuyên biệt"... đúng chứ?
Dialogue: 0,0:07:54.14,0:07:55.93,Default,,0,0,0,,{\i1}Thì sao nào?{\i0}
Dialogue: 0,0:07:56.85,0:07:59.77,Default,,0,0,0,,Vậy tôi nghĩ bác giúp được tôi đấy.
Dialogue: 0,0:08:02.23,0:08:03.44,Default,,0,0,0,,Một chiếc xe lăn.
Dialogue: 0,0:08:04.69,0:08:09.95,Default,,0,0,0,,Tôi muốn một chiếc xe lăn dùng để giết người.
Dialogue: 0,0:08:30.64,0:08:32.31,Default,,0,0,0,,Con nhỏ này bị làm sao thế không biết?
Dialogue: 0,0:08:36.14,0:08:39.94,Default,,0,0,0,,{\i1}Cuối cùng, ta đã thiết kế\Nbảy chiếc xe lăn chuyên dụng{\i0}
Dialogue: 0,0:08:40.06,0:08:43.23,Default,,0,0,0,,{\i1}cho cô bé kỳ lạ tên Shizuka đó\Nvà anh trai con bé là Nagi{\i0}
Dialogue: 0,0:08:43.69,0:08:48.78,Default,,0,0,0,,{\i1}để hai đứa có thể ứng biến\Ntrong mọi tình huống chiến đấu.{\i0}
Dialogue: 0,0:08:49.99,0:08:56.00,Default,,0,0,0,,{\i1}Và để che giấu thân phận,\Nvới tình trạng cực kỳ bất thường của thằng bé,{\i0}
Dialogue: 0,0:08:56.91,0:09:00.16,Default,,0,0,0,,{\i1}ta còn gợi ý cậu ta\Nđeo mặt nạ trong lúc "phục hồi chức năng".{\i0}
Dialogue: 0,0:09:01.67,0:09:06.22,Default,,0,0,0,,{\i1}Và rồi, vào cái đêm công việc của ta hoàn tất,{\i0}
Dialogue: 0,0:09:06.92,0:09:09.67,Default,,0,0,0,,{\i1}cuộc trả thù của ta cũng khép lại đột ngột.{\i0}
Dialogue: 0,0:09:10.76,0:09:16.18,Default,,0,0,0,,{\i1}Một con quái vật luôn săn lùng kẻ địch mạnh hơn\Nđể nuốt chửng "sát khí" của chúng đã ra đời.{\i0}
Dialogue: 0,0:09:17.27,0:09:19.27,Default,,0,0,0,,{\i1}Một con quái vật mang tên "Tank Chair".{\i0}
Dialogue: 0,0:09:22.35,0:09:26.19,Default,,0,0,0,,Thật hết nói nổi... Ta đã bảo là không làm mà!
Dialogue: 0,0:09:26.44,0:09:28.82,Default,,0,0,0,,Hai đứa đang đối đầu với một tổ chức
Dialogue: 0,0:09:29.36,0:09:34.16,Default,,0,0,0,,mà chính phủ khắp thế giới\Ncòn phải giám sát nghiêm ngặt nhất đấy.
Dialogue: 0,0:09:34.83,0:09:40.21,Default,,0,0,0,,Không muốn chết thì mau trốn biệt đi\Nvà phẫu thuật thẩm mỹ ngay lập tức đi.
Dialogue: 0,0:09:40.50,0:09:43.55,Default,,0,0,0,,Cháu biết, cháu biết mà,\Ndù sao đó cũng là trường cũ của bọn cháu.
Dialogue: 0,0:09:44.17,0:09:48.17,Default,,0,0,0,,Xem kìa, anh Nagi cũng đang nói "Xin bác giúp tụi cháu đi" đấy.
Dialogue: 0,0:09:48.51,0:09:51.18,Default,,0,0,0,,Này, đừng có nghịch anh trai cháu\Nlúc thằng bé đang hôn mê nữa!
Dialogue: 0,0:09:54.80,0:09:57.26,Default,,0,0,0,,Bác đúng là dễ mềm lòng thật đấy, Tiến sĩ ạ.
Dialogue: 0,0:09:57.85,0:09:58.73,Default,,0,0,0,,Hả?
Dialogue: 0,0:09:59.27,0:10:04.19,Default,,0,0,0,,Bác chần chừ là vì\Nbác không muốn bọn cháu phải chết đúng không?
Dialogue: 0,0:10:06.65,0:10:07.99,Default,,0,0,0,,Cháu nhận ra hết rồi đấy nhé.
Dialogue: 0,0:10:09.19,0:10:13.11,Default,,0,0,0,,Ngay cả sau khi hoàn thành đám Tank Chair,\Nbác vẫn luôn dõi theo bọn cháu mà.
Dialogue: 0,0:10:14.36,0:10:16.74,Default,,0,0,0,,{\i1}Thật chẳng giống ta chút nào,\Nnhưng ta lại chẳng thể ngoảnh mặt làm ngơ.{\i0}
Dialogue: 0,0:10:19.91,0:10:25.29,Default,,0,0,0,,{\i1}Giống như ta, con bé cũng đã đánh mất anh trai\Nvì chính hành động của mình.{\i0}
Dialogue: 0,0:10:26.71,0:10:27.67,Default,,0,0,0,,Cháu cảm ơn bác.
Dialogue: 0,0:10:28.25,0:10:29.17,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:10:30.13,0:10:33.76,Default,,0,0,0,,Chính bọn cháu đã cùng nhau quyết định chuyện này.\NBọn cháu sẽ đứng lên chiến đấu.
Dialogue: 0,0:10:38.39,0:10:40.93,Default,,0,0,0,,Vậy có khuyên thế nào thì\Ncũng vô ích với hai đứa thôi nhỉ.
Dialogue: 0,0:10:41.35,0:10:42.56,Default,,0,0,0,,Thôi được...
Dialogue: 0,0:10:42.73,0:10:43.73,Default,,0,0,0,,Ý ta là...
Dialogue: 0,0:10:44.35,0:10:48.44,Default,,0,0,0,,Nhân tiện cũng thu thập được kha khá dữ liệu hay ho,\Nnên ta sẽ giúp hai đứa một tay vậy.
Dialogue: 0,0:10:49.36,0:10:52.24,Default,,0,0,0,,Nhưng tình hình hiện tại chẳng khả quan chút nào đâu.
Dialogue: 0,0:10:53.03,0:10:57.87,Default,,0,0,0,,Mạng lưới của chúng hiện đã bao phủ\Ngần như toàn bộ đảo Guicheng rồi.
Dialogue: 0,0:10:58.58,0:11:02.54,Default,,0,0,0,,Cái cặp đôi nam nữ lệch pha\Ndẫn đầu Lớp C đó cũng chẳng phải tay vừa đâu.
Dialogue: 0,0:11:02.54,0:11:06.92,Default,,0,0,0,,Ồ, anh em nhà Kurosaka.\NHóa ra chúng vẫn còn ở trên đảo à.
Dialogue: 0,0:11:06.92,0:11:10.63,Default,,0,0,0,,Nhưng đáng ngại hơn cả là tên lính mới\Nvừa được điều từ Lớp A tới...
Dialogue: 0,0:11:11.51,0:11:15.68,Default,,0,0,0,,Hắn đang đi khắp nơi tàn sát những kẻ\Ncó thể làm "thuốc" giúp Nagi tỉnh lại.
Dialogue: 0,0:11:16.80,0:11:18.97,Default,,0,0,0,,Hắn vừa triệt tiêu cơ hội\Nhồi phục của Nagi,
Dialogue: 0,0:11:19.30,0:11:22.14,Default,,0,0,0,,vừa thâu tóm quyền kiểm soát\Nhòn đảo mạnh được yếu thua này.
Dialogue: 0,0:11:23.35,0:11:25.35,Default,,0,0,0,,Điên rồ thật đấy, nhưng lại cực kỳ hiệu quả.
Dialogue: 0,0:11:26.23,0:11:30.15,Default,,0,0,0,,Hơn nữa, thực lực của hắn đủ mạnh
Dialogue: 0,0:11:31.11,0:11:33.07,Default,,0,0,0,,để thực hiện chuyện đó.
Dialogue: 0,0:11:33.74,0:11:38.91,Default,,0,0,0,,À, hẳn đó là gã đã tỏa ra luồng sát khí\Nkhắp thị trấn hôm trước rồi.
Dialogue: 0,0:11:40.16,0:11:43.75,Default,,0,0,0,,Vậy thì bọn cháu càng phải\Nhoàn thiện cái thứ kia bằng mọi giá.
Dialogue: 0,0:11:44.58,0:11:46.25,Default,,0,0,0,,Chiếc No Mark sao?
Dialogue: 0,0:11:47.17,0:11:49.71,Default,,0,0,0,,{\i1}Một chiếc xe lăn không chỉ đơn thuần bổ trợ,{\i0}
Dialogue: 0,0:11:50.17,0:11:53.30,Default,,0,0,0,,{\i1}mà còn vượt qua mọi giới hạn của cơ thể.{\i0}
Dialogue: 0,0:11:54.21,0:11:56.42,Default,,0,0,0,,{\i1}Nó mang tiềm năng hủy diệt hàng loạt,{\i0}
Dialogue: 0,0:11:56.63,0:11:58.97,Default,,0,0,0,,{\i1}nhưng áp lực lên người vận hành\Nlà không thể đo đếm được.{\i0}
Dialogue: 0,0:11:59.26,0:12:00.59,Default,,0,0,0,,{\i1}Đó là lý do nó bị xếp xó.{\i0}
Dialogue: 0,0:12:01.64,0:12:06.35,Default,,0,0,0,,Đúng là No Mark là lựa chọn duy nhất của hai đứa\Nnếu muốn đối đầu với Học viện.
Dialogue: 0,0:12:08.27,0:12:09.48,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:12:10.11,0:12:14.11,Default,,0,0,0,,Cháu biết chứ. Còn thiếu nguyên liệu đúng không bác?
Dialogue: 0,0:12:15.15,0:12:16.32,Default,,0,0,0,,{\i1}Meta Metal.{\i0}
Dialogue: 0,0:12:16.82,0:12:20.61,Default,,0,0,0,,{\i1}Một dạng sinh vật bán hữu cơ gốc khoáng chất\Ncó thể biến đổi hình dạng và độ cứng{\i0}
Dialogue: 0,0:12:20.62,0:12:22.41,Default,,0,0,0,,{\i1}tùy theo sóng não của con người.{\i0}
Dialogue: 0,0:12:23.49,0:12:24.83,Default,,0,0,0,,{\i1}Cùng với "chìa khóa khởi động".{\i0}
Dialogue: 0,0:12:25.45,0:12:30.87,Default,,0,0,0,,{\i1}Sát khí của 100 người cùng nhắm thẳng\Nvào người điều khiển Nagi suốt ba phút liên tục.{\i0}
Dialogue: 0,0:12:33.17,0:12:35.67,Default,,0,0,0,,Chậc, kiểu gì rồi cũng xoay xở được thôi mà.
Dialogue: 0,0:12:35.67,0:12:37.76,Default,,0,0,0,,Cứ để anh Nagi gồng mình chịu đựng là xong.
Dialogue: 0,0:13:02.49,0:13:04.37,Default,,0,0,0,,Chạy mau lên! Bọn chúng đuổi kịp rồi kìa!
Dialogue: 0,0:13:40.95,0:13:46.66,Default,,0,0,0,,Ta đã ngộ ra rằng tinh hoa võ sĩ đạo không nằm ở việc\Nbắt giữ ngay lập tức, mà là ở sự hành hạ!
Dialogue: 0,0:13:47.16,0:13:49.16,Default,,0,0,0,,Thả tụi tôi ra!
Dialogue: 0,0:13:51.16,0:13:54.00,Default,,0,0,0,,Thả tụi tôi ra! Thả ra!
Dialogue: 0,0:13:57.88,0:13:59.30,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:14:05.18,0:14:07.56,Default,,0,0,0,,Chúng bay hết đường chạy rồi!
Dialogue: 0,0:14:07.56,0:14:13.32,Default,,0,0,0,,Đối với xã hội ngoài kia,\Nlũ trẻ bụi đời Guicheng chúng bay vốn dĩ không tồn tại.
Dialogue: 0,0:14:13.44,0:14:16.53,Default,,0,0,0,,Vậy nên đem ra ngoài đảo bán\Nsẽ được giá lắm đấy!
Dialogue: 0,0:14:26.32,0:14:27.70,Default,,0,0,0,,Đừng bỏ cuộc!
Dialogue: 0,0:14:27.70,0:14:28.87,Default,,0,0,0,,Cố chạy tiếp đi!
Dialogue: 0,0:14:36.38,0:14:38.26,Default,,0,0,0,,Em chạy trước đi.
Dialogue: 0,0:14:39.17,0:14:41.84,Default,,0,0,0,,Nực... cười thật đấy...
Dialogue: 0,0:15:13.79,0:15:18.17,Default,,0,0,0,,MARK II: "THANH KIẾM"
Dialogue: 0,0:15:19.92,0:15:23.09,Default,,0,0,0,,Tank Chair Mark II.
Dialogue: 0,0:15:24.30,0:15:25.38,Default,,0,0,0,,"Thanh Kiếm".
Dialogue: 0,0:15:25.38,0:15:26.97,Default,,0,0,0,,TANK CHAIR MARK II: "THANH KIẾM"
Dialogue: 0,0:15:35.77,0:15:36.77,Default,,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:15:38.40,0:15:40.49,Default,,0,0,0,,A... Ai mà biết?
Dialogue: 0,0:15:40.77,0:15:41.77,Default,,0,0,0,,Kẻ nào đấy?!
Dialogue: 0,0:15:41.78,0:15:43.99,Default,,0,0,0,,Hắn ta mang theo kiếm kìa!
Dialogue: 0,0:15:45.82,0:15:46.90,Default,,0,0,0,,Có kẻ phá đám!
Dialogue: 0,0:15:46.91,0:15:49.37,Default,,0,0,0,,Hắn định nhúng tay vào chuyện này sao?
Dialogue: 0,0:15:49.62,0:15:52.16,Default,,0,0,0,,Vậy thì giết hắn đi!
Dialogue: 0,0:15:53.04,0:15:54.21,Default,,0,0,0,,GIẾT GIẾT GIẾT
Dialogue: 0,0:16:44.92,0:16:47.17,Default,,0,0,0,,Không... thể nào...
Dialogue: 0,0:16:50.93,0:16:53.39,Default,,0,0,0,,Thật... vậy sao...
Dialogue: 0,0:16:58.10,0:16:59.27,Default,,0,0,0,,Đỉnh quá!
Dialogue: 0,0:17:01.56,0:17:02.98,Default,,0,0,0,,Anh ta là ai thế?!
Dialogue: 0,0:17:05.98,0:17:08.40,Default,,0,0,0,,Chúa công! Chúa công ơi!
Dialogue: 0,0:17:08.40,0:17:09.99,Default,,0,0,0,,Mau tỉnh lại đi ạ!
Dialogue: 0,0:17:16.08,0:17:19.54,Default,,0,0,0,,Bác ơi, trong đám này có tên nào\Ngiữ Meta Metal không?
Dialogue: 0,0:17:19.66,0:17:21.62,Default,,0,0,0,,{\i1}Không, chẳng tên nào có cả.{\i0}
Dialogue: 0,0:17:24.00,0:17:29.51,Default,,0,0,0,,Đồ ngu xuẩn... Ta chính là Yoshitsune,\Nthủ lĩnh của Tân Võ Sĩ Đạo (Neo-Bushido)!
Dialogue: 0,0:17:29.97,0:17:33.85,Default,,0,0,0,,Ngươi dám cả gan xúc phạm ta đến mức này sao?!
Dialogue: 0,0:17:35.76,0:17:41.93,Default,,0,0,0,,Ngươi sẽ hóa thành rỉ sắt\Ndưới thanh yêu đao Muramasa-X của ta!
Dialogue: 0,0:17:44.86,0:17:49.95,Default,,0,0,0,,Muramasa, hãy nghe theo ý chí của ta!
Dialogue: 0,0:17:58.66,0:18:00.20,Default,,0,0,0,,Hình dạng thanh kiếm...!
Dialogue: 0,0:18:00.50,0:18:05.34,Default,,0,0,0,,Muramasa, Hình Thái: Chiến Phủ.
Dialogue: 0,0:18:15.47,0:18:17.60,Default,,0,0,0,,Hự!
Dialogue: 0,0:18:17.85,0:18:20.48,Default,,0,0,0,,Con chuột nhắt cứ chạy nhảy loăng quăng thế à...
Dialogue: 0,0:18:20.89,0:18:24.06,Default,,0,0,0,,Hình Thái: Trường Thương.
Dialogue: 0,0:18:28.23,0:18:29.02,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:18:46.29,0:18:51.55,Default,,0,0,0,,V... Vô lý thật!
Dialogue: 0,0:18:53.09,0:18:56.80,Default,,0,0,0,,Đỡ trọn lưỡi đao của ta chỉ bằng một tay sao?
Dialogue: 0,0:18:57.35,0:18:58.89,Default,,0,0,0,,Thu về!
Dialogue: 0,0:18:59.76,0:19:03.47,Default,,0,0,0,,{\i1}Một dạng sinh vật bán hữu cơ gốc kim loại\Nbiến đổi hình dạng theo sóng não.{\i0}
Dialogue: 0,0:19:04.02,0:19:07.02,Default,,0,0,0,,{\i1}Không sai vào đâu được,\Nthanh kiếm đó chính là Meta Metal.{\i0}
Dialogue: 0,0:19:07.23,0:19:09.82,Default,,0,0,0,,Hừm... Ra vậy...
Dialogue: 0,0:19:11.73,0:19:15.86,Default,,0,0,0,,Thế thì, ta đành lấy nó từ tay ngươi vậy.
Dialogue: 0,0:19:19.83,0:19:22.12,Default,,0,0,0,,Hắn vứt bỏ cả vỏ kiếm rồi!
Dialogue: 0,0:19:23.04,0:19:27.46,Default,,0,0,0,,Dám lao thẳng mặt vào ta thế kia.\NTo gan lắm!
Dialogue: 0,0:19:28.29,0:19:31.13,Default,,0,0,0,,Muramasa Áo Nghĩa...
Dialogue: 0,0:19:31.55,0:19:33.93,Default,,0,0,0,,Kiếm Sơn (Mt. Tsurugi).
Dialogue: 0,0:19:35.47,0:19:37.68,Default,,0,0,0,,Ta đã ngộ ra rằng võ sĩ đạo
Dialogue: 0,0:19:40.18,0:19:42.35,Default,,0,0,0,,chính là nghệ thuật giết chóc!
Dialogue: 0,0:19:46.27,0:19:48.27,Default,,0,0,0,,{\i1}Đánh từ dưới mặt đất lên sao?! Tính sao đây?!{\i0}
Dialogue: 0,0:19:48.48,0:19:50.06,Default,,0,0,0,,- Xin lỗi bác nhé.\N- {\i1}Hả?{\i0}
Dialogue: 0,0:19:50.06,0:19:51.48,Default,,0,0,0,,Cháu sắp phải nhờ bác sửa lại xe rồi.
Dialogue: 0,0:19:58.45,0:19:59.87,Default,,0,0,0,,Một nhát chém {\i1}kamaitachi{\i0} sao?!
Dialogue: 0,0:20:04.16,0:20:09.79,Default,,0,0,0,,Ngoài máy cắt plasma ra, không gì cắt nổi\Nlớp vỏ giáp titan đa tầng này đâu!
Dialogue: 0,0:20:18.55,0:20:21.22,Default,,0,0,0,,{\i1}Khe hở trên bộ giáp của ta...{\i0}
Dialogue: 0,0:20:22.47,0:20:24.72,Default,,0,0,0,,{\i1}Ngay từ đầu hắn đã nhắm vào chỗ đó.{\i0}
Dialogue: 0,0:20:25.85,0:20:28.31,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:20:29.19,0:20:30.15,Default,,0,0,0,,Quá ngoạn mục.
Dialogue: 0,0:20:44.24,0:20:47.24,Default,,0,0,0,,{\i1}Thế là giải quyết xong vụ Meta Metal rồi nhé.{\i0}
Dialogue: 0,0:20:48.71,0:20:49.50,Default,,0,0,0,,{\i1}Giờ thì...{\i0}
Dialogue: 0,0:20:55.00,0:20:57.38,Default,,0,0,0,,B... Bọn mình được cứu rồi à?
Dialogue: 0,0:21:01.97,0:21:05.72,Default,,0,0,0,,Nhìn sơ qua chắc cũng tầm 70 hay 80 đứa nhỉ.
Dialogue: 0,0:21:09.44,0:21:11.32,Default,,0,0,0,,Anh ta là ai vậy?
Dialogue: 0,0:21:13.19,0:21:14.82,Default,,0,0,0,,Tank Chair.
Dialogue: 0,0:21:15.57,0:21:19.87,Default,,0,0,0,,Anh ấy ra tay giúp đỡ kẻ yếu...\Nà thì đại khái vậy, chắc thế.
Dialogue: 0,0:21:19.86,0:21:22.49,Default,,0,0,0,,Nhưng chắc chắn một điều là anh ấy\Nđè bẹp hết mọi kẻ mạnh.
Dialogue: 0,0:21:22.49,0:21:24.87,Default,,0,0,0,,Người hùng của Guicheng đấy.
Dialogue: 0,0:21:25.45,0:21:27.29,Default,,0,0,0,,Tank Chair...?
Dialogue: 0,0:21:28.12,0:21:29.87,Default,,0,0,0,,C... Còn chị là ai thế?
Dialogue: 0,0:21:30.25,0:21:34.00,Default,,0,0,0,,Hả? Chị hả, kiểu như là...
Dialogue: 0,0:21:34.88,0:21:38.09,Default,,0,0,0,,quản lý của anh ấy... đại loại vậy?
Dialogue: 0,0:21:38.92,0:21:42.38,Default,,0,0,0,,Nhân tiện thì, mấy đứa có muốn...
Dialogue: 0,0:21:43.43,0:21:46.85,Default,,0,0,0,,gia nhập fan club của Tank Chair không?
Dialogue: 0,0:21:57.44,0:22:01.99,Default,,0,0,0,,Hai anh em nhà đó... Không ngờ chúng lại\Nthực sự làm được chuyện này...
Dialogue: 0,0:22:05.16,0:22:10.62,Default,,0,0,0,,Nào, giờ quay lại làm việc tiếp thôi nhỉ?
Dialogue: 0,0:23:56.06,0:23:57.94,Default,,0,0,0,,{\an8}MINH HỌA: TAIKI KAWAKAMI
Dialogue: 0,0:23:57.94,0:24:00.94,Default,,0,0,0,,{\an8}PHỤ ĐỀ VIỆT NGỮ: Amtia(NOFACE)
