Dialogue: 0,0:00:21.27,0:00:24.44,Default,,0,0,0,,KHU KOSHIN, ĐẢO QUỶ THÀNH (GUICHENG)
Dialogue: 0,0:00:56.14,0:01:00.35,Default,,0,0,0,,THÌNH THỊCH THÌNH THỊCH
Dialogue: 0,0:01:02.48,0:01:06.15,Default,,0,0,0,,THÌNH THỊCH THÌNH THỊCH
Dialogue: 0,0:01:06.57,0:01:08.24,Default,,0,0,0,,Khốn kiếp thật!
Dialogue: 0,0:01:22.67,0:01:26.51,Default,,0,0,0,,{\i1}C... Cơ thể này...{\i0}
Dialogue: 0,0:01:27.25,0:01:29.67,Default,,0,0,0,,{\i1}không... tệ chút nào...{\i0}
Dialogue: 0,0:01:31.97,0:01:34.77,Default,,0,0,0,,{\i1}Mình có thể cảm nhận... "mối liên kết"...{\i0}
Dialogue: 0,0:01:36.14,0:01:38.85,Default,,0,0,0,,{\i1}mạnh mẽ hơn... trước kia...{\i0}
Dialogue: 0,0:01:41.81,0:01:46.52,Default,,0,0,0,,{\i1}Hắn ta đã vứt bỏ danh hiệu\N"thiên tài kiệt xuất nhất lịch sử Học viện"{\i0}
Dialogue: 0,0:01:47.78,0:01:52.20,Default,,0,0,0,,{\i1}để rồi biến thành một cơ thể tàn tạ như thế...\Nmà hắn lại thỏa mãn với nó sao?!{\i0}
Dialogue: 0,0:01:53.95,0:01:57.20,Default,,0,0,0,,{\i1}Làm sao hắn có thể\Nchạy trốn khỏi Thầy được cơ chứ.{\i0}
Dialogue: 0,0:01:58.58,0:02:00.00,Default,,0,0,0,,{\i1}Thế thì tại sao?{\i0}
Dialogue: 0,0:02:06.79,0:02:08.63,Default,,0,0,0,,{\i1}Chúng ta đâu có chạy trốn.{\i0}
Dialogue: 0,0:02:10.09,0:02:13.05,Default,,0,0,0,,{\i1}Touko và mình vốn chẳng có tài năng gì đặc biệt,{\i0}
Dialogue: 0,0:02:13.51,0:02:18.85,Default,,0,0,0,,{\i1}nên để sống sót tại Học viện, chúng mình đã tự nguyện\Nchấp nhận những cuộc cải tạo cơ thể khắc nghiệt nhất.{\i0}
Dialogue: 0,0:02:20.18,0:02:24.56,Default,,0,0,0,,{\i1}Và nhờ thế, giờ chúng mình mới leo lên được Lớp A.{\i0}
Dialogue: 0,0:02:26.65,0:02:27.99,Default,,0,0,0,,{\i1}Nhưng điều đó thì có ý nghĩa gì chứ?{\i0}
Dialogue: 0,0:02:34.49,0:02:37.03,Default,,0,0,0,,{\i1}Sức mạnh này quá sức chịu đựng của chúng mình,{\i0}
Dialogue: 0,0:02:38.20,0:02:41.54,Default,,0,0,0,,{\i1}và rồi một ngày nào đó,\Nnó sẽ gặm nhấm cơ thể này và cướp đi mạng sống của cả hai.{\i0}
Dialogue: 0,0:02:42.71,0:02:45.42,Default,,0,0,0,,{\i1}Liệu chúng mình... không...{\i0}
Dialogue: 0,0:02:46.58,0:02:47.50,Default,,0,0,0,,{\i1}Liệu mình...{\i0}
Dialogue: 0,0:02:48.75,0:02:52.71,Default,,0,0,0,,{\i1}có đưa ra lựa chọn đúng đắn\Nvới tư cách là một người anh trai hay không?{\i0}
Dialogue: 0,0:02:58.10,0:03:00.98,Default,,0,0,0,,ĐANG CHỜ BÁO CÁO TÌNH HÌNH.\NXin vui lòng phản hồi.
Dialogue: 0,0:04:31.86,0:04:33.07,Default,,0,0,0,,Chất liệu.
Dialogue: 0,0:04:35.19,0:04:37.28,Default,,0,0,0,,Bản chất nguyên thủy của nó...
Dialogue: 0,0:04:38.03,0:04:42.37,Default,,0,0,0,,kết hợp cùng ý niệm của người tạo tác...
Dialogue: 0,0:04:44.41,0:04:49.62,Default,,0,0,0,,sẽ khai sinh ra một "vật chứa" hoàn toàn mới.
Dialogue: 0,0:04:51.17,0:04:52.63,Default,,0,0,0,,Làm gốm quả là một điều tuyệt diệu.
Dialogue: 0,0:04:54.21,0:04:57.84,Default,,0,0,0,,Nó cho phép ta trải nghiệm...
Dialogue: 0,0:04:59.47,0:05:04.52,Default,,0,0,0,,khoái cảm nguyên sơ nhất của sự sáng tạo.
Dialogue: 0,0:05:05.10,0:05:06.43,Default,,0,0,0,,TỬ ĐÀO SƯ (DEADUCATOR)
Dialogue: 0,0:05:06.43,0:05:11.23,Default,,0,0,0,,Ở một góc độ nào đó,\Nnó cũng tương tự như công việc của một Tử Đào Sư vậy.
Dialogue: 0,0:05:12.90,0:05:18.36,Default,,0,0,0,,Nagi từng là một sự tồn tại đặc biệt...\Nngười tiệm cận nhất với sự hoàn hảo
Dialogue: 0,0:05:19.45,0:05:26.00,Default,,0,0,0,,trong số tất cả các "vật chứa" mà ta từng được chiêm ngưỡng.
Dialogue: 0,0:05:26.91,0:05:31.42,Default,,0,0,0,,Ta muốn đoạt lại cậu ấy bằng mọi giá.
Dialogue: 0,0:05:31.92,0:05:34.34,Default,,0,0,0,,{\i1}"Đoạt lại cậu ấy" sao?{\i0}
Dialogue: 0,0:05:35.63,0:05:39.51,Default,,0,0,0,,{\i1}Mình chưa từng nghĩ Thầy lại sẵn sàng\Ntha thứ cho một kẻ đào tẩu...{\i0}
Dialogue: 0,0:05:40.51,0:05:45.47,Default,,0,0,0,,{\i1}Nagi đúng là phi thường thật, nhưng tại sao\NThầy lại phải chấp niệm đến mức đó chứ?{\i0}
Dialogue: 0,0:05:46.22,0:05:51.68,Default,,0,0,0,,T... Thưa Thầy. Về chuyện của Nagi...
Dialogue: 0,0:05:52.23,0:05:53.11,Default,,0,0,0,,Hửm?
Dialogue: 0,0:05:54.94,0:05:57.11,Default,,0,0,0,,Một chiếc... xe... lăn...
Dialogue: 0,0:05:57.44,0:05:58.32,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:05:58.57,0:06:03.49,Default,,0,0,0,,Dựa vào trận chiến hôm trước,\Nta đoán viên đạn găm trong não cậu ấy
Dialogue: 0,0:06:03.82,0:06:06.53,Default,,0,0,0,,đã khiến cậu ấy rơi vào\Nmột trạng thái tê liệt kỳ lạ,
Dialogue: 0,0:06:07.24,0:06:10.33,Default,,0,0,0,,và cậu ấy chỉ thức tỉnh\Nmỗi khi có sát khí nhắm thẳng vào mình.
Dialogue: 0,0:06:20.09,0:06:21.93,Default,,0,0,0,,Thật đáng thương làm sao...
Dialogue: 0,0:06:25.22,0:06:26.60,Default,,0,0,0,,Naozumi.
Dialogue: 0,0:06:26.60,0:06:28.10,Default,,0,0,0,,D... Dạ có con.
Dialogue: 0,0:06:29.64,0:06:35.52,Default,,0,0,0,,Ngươi nghĩ ta ghét nhất thứ gì?
Dialogue: 0,0:06:35.52,0:06:39.40,Default,,0,0,0,,Hả?! Dạ... ơ... ờ...
Dialogue: 0,0:06:39.73,0:06:41.27,Default,,0,0,0,,- Ờ thì...\N- Ba...
Dialogue: 0,0:06:41.28,0:06:43.87,Default,,0,0,0,,- Dạ, à...\N- Hai...
Dialogue: 0,0:06:44.36,0:06:45.28,Default,,0,0,0,,Ơ... dạ...
Dialogue: 0,0:06:46.24,0:06:47.66,Default,,0,0,0,,- Một...\N- Giày dép ạ!
Dialogue: 0,0:06:47.66,0:06:48.87,Default,,0,0,0,,Không phải... Là tất chân!
Dialogue: 0,0:06:49.28,0:06:52.16,Default,,0,0,0,,H... Hay cái gì đó tương tự thế ạ?
Dialogue: 0,0:06:52.58,0:06:54.96,Default,,0,0,0,,Vì lúc nào Thầy cũng đi chân trần...
Dialogue: 0,0:07:03.01,0:07:04.35,Default,,0,0,0,,Không phải.
Dialogue: 0,0:07:04.80,0:07:09.14,Default,,0,0,0,,Thỉnh thoảng ta cũng có mang tất mà.
Dialogue: 0,0:07:10.35,0:07:12.35,Default,,0,0,0,,Tầm mười năm một lần gì đấy.
Dialogue: 0,0:07:15.69,0:07:18.19,Default,,0,0,0,,D... Dạ, vâng.
Dialogue: 0,0:07:18.73,0:07:20.32,Default,,0,0,0,,Đáp án chính là...
Dialogue: 0,0:07:21.94,0:07:25.40,Default,,0,0,0,,những thứ "không hoàn hảo."
Dialogue: 0,0:07:27.24,0:07:28.87,Default,,0,0,0,,Ngươi có thấu hiểu được cảm giác của ta không?
Dialogue: 0,0:07:30.66,0:07:32.16,Default,,0,0,0,,Cẩn thận chăm bẵm một "vật chứa",
Dialogue: 0,0:07:33.58,0:07:39.50,Default,,0,0,0,,chứng kiến nó\Ntiệm cận đến độ "hoàn mỹ,"
Dialogue: 0,0:07:41.04,0:07:46.63,Default,,0,0,0,,để rồi nhìn thấy nó bị sứt mẻ tổn hại.
Dialogue: 0,0:07:48.64,0:07:52.10,Default,,0,0,0,,Mục đích tồn tại của Học viện này
Dialogue: 0,0:07:53.14,0:07:56.98,Default,,0,0,0,,là để tạo ra những "vật chứa hoàn hảo."
Dialogue: 0,0:07:58.23,0:08:03.61,Default,,0,0,0,,Thứ luôn ngáng đường những đại nghiệp vĩ đại
Dialogue: 0,0:08:05.11,0:08:09.66,Default,,0,0,0,,chính là thứ rác rưởi không hoàn hảo.
Dialogue: 0,0:08:10.91,0:08:12.54,Default,,0,0,0,,Lấy ví dụ như...
Dialogue: 0,0:08:13.79,0:08:15.58,Default,,0,0,0,,Shizuka Tahira.
Dialogue: 0,0:08:16.41,0:08:18.95,Default,,0,0,0,,Shizuka Tahira.
Dialogue: 0,0:08:20.17,0:08:25.22,Default,,0,0,0,,Nếu không phải vì con nhỏ đó,
Dialogue: 0,0:08:26.63,0:08:28.30,Default,,0,0,0,,thì Nagi đã chẳng bao giờ\Nrơi vào tình cảnh nông nỗi này.
Dialogue: 0,0:08:31.80,0:08:34.35,Default,,0,0,0,,Naozumi và Touko Kurosaka.
Dialogue: 0,0:08:35.68,0:08:39.94,Default,,0,0,0,,Hai ngươi... hãy tiếp tục
Dialogue: 0,0:08:40.19,0:08:45.95,Default,,0,0,0,,truy sát hai anh em nhà Tahira\Ntrên đảo Quỷ Thành.
Dialogue: 0,0:08:50.66,0:08:52.45,Default,,0,0,0,,À, còn một điều nữa.
Dialogue: 0,0:08:53.41,0:08:56.62,Default,,0,0,0,,Nếu các ngươi lại thất bại lần nữa,
Dialogue: 0,0:08:58.29,0:09:01.21,Default,,0,0,0,,thì đó cũng sẽ là thời điểm các ngươi "tốt nghiệp" đấy.
Dialogue: 0,0:09:06.00,0:09:11.51,Default,,0,0,0,,Ta cũng đã phái thêm\Nmột tân binh Lớp A tham gia nhiệm vụ này.
Dialogue: 0,0:09:13.18,0:09:16.27,Default,,0,0,0,,Cậu ta vừa rời khỏi Học viện,
Dialogue: 0,0:09:17.35,0:09:19.69,Default,,0,0,0,,nên chắc khoảng năm phút nữa\Nlà sẽ tới nơi.
Dialogue: 0,0:09:20.89,0:09:26.56,Default,,0,0,0,,Là tiền bối, hãy chỉ bảo cho cậu ta nhé.
Dialogue: 0,0:09:27.53,0:09:28.95,Default,,0,0,0,,Hừm...
Dialogue: 0,0:09:30.40,0:09:31.32,Default,,0,0,0,,Thế này thì không ổn rồi.
Dialogue: 0,0:09:35.83,0:09:38.50,Default,,0,0,0,,{\i1}Ngắt kết nối phòng họp thực tế ảo AR.{\i0}
Dialogue: 0,0:09:48.21,0:09:49.34,Default,,0,0,0,,Khốn kiếp thật!
Dialogue: 0,0:09:56.26,0:09:58.39,Default,,0,0,0,,Hả? "Tân binh" sao?
Dialogue: 0,0:09:59.39,0:10:00.64,Default,,0,0,0,,Nhắc mới nhớ,
Dialogue: 0,0:10:01.23,0:10:04.90,Default,,0,0,0,,Thầy bảo "năm phút nữa" là có ý gì cơ chứ?
Dialogue: 0,0:10:05.94,0:10:08.86,Default,,0,0,0,,Từ Học viện đến đảo Quỷ Thành này\Ncách nhau hơn 1.000 cây số lận đấy.
Dialogue: 0,0:10:12.24,0:10:14.78,Default,,0,0,0,,Hú hồn chưa bà con!
Dialogue: 0,0:10:19.83,0:10:26.38,Default,,0,0,0,,Tên lửa đạn đạo liên lục địa (ICBM) bay nhanh vãi chưởng!
Dialogue: 0,0:10:34.01,0:10:36.05,Default,,0,0,0,,- Cái gì thế kia?\N- Oa, đẹp lung linh luôn!
Dialogue: 0,0:10:54.95,0:10:55.70,Default,,0,0,0,,Hả?
Dialogue: 0,0:10:56.57,0:10:58.61,Default,,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:11:14.34,0:11:18.47,Default,,0,0,0,,Yo! Tôi là Uzu, tân binh mới của Lớp A đây.
Dialogue: 0,0:11:19.64,0:11:23.85,Default,,0,0,0,,Rất vui được gặp mặt, Kurosaka senpai!
Dialogue: 0,0:11:59.85,0:12:04.81,Default,,0,0,0,,{\i1}Quy định Học viện số 25, Điều 3:\N"Đặc quyền của Học viên Lớp A."{\i0}
Dialogue: 0,0:12:05.56,0:12:10.90,Default,,0,0,0,,{\i1}"Học viên ở các lớp cấp bậc thấp hơn\Nphải tuyệt đối phục tùng học viên lớp cao hơn."{\i0}
Dialogue: 0,0:12:11.61,0:12:15.41,Default,,0,0,0,,{\i1}"Học viên thuộc Lớp A cao cấp nhất\Ncó quyền kiến nghị lên Hội học sinh."{\i0}
Dialogue: 0,0:12:15.40,0:12:17.78,Default,,0,0,0,,{\i1}"Nếu yêu cầu của họ\Nđược xét thấy là chính đáng,"{\i0}
Dialogue: 0,0:12:18.11,0:12:20.45,Default,,0,0,0,,{\i1}"họ có quyền chỉ huy tùy ý tối đa 50 học viên"{\i0}
Dialogue: 0,0:12:21.03,0:12:24.16,Default,,0,0,0,,{\i1}"từ Lớp C trở xuống\Nbên ngoài phạm vi Học viện."{\i0}
Dialogue: 0,0:12:27.21,0:12:28.92,Default,,0,0,0,,Cảm ơn mọi người đã lặn lội đường xa tới đây.
Dialogue: 0,0:12:29.54,0:12:32.71,Default,,0,0,0,,Tôi cho là mọi người đã được phổ biến sơ bộ\Ntrên đường tới đây rồi,
Dialogue: 0,0:12:33.17,0:12:37.13,Default,,0,0,0,,nhưng tôi sẽ nhắc lại\Nchi tiết của nhiệm vụ lần này một lần nữa.
Dialogue: 0,0:12:38.01,0:12:41.93,Default,,0,0,0,,Mục tiêu của chúng ta là Nagi và Shizuka Tahira.
Dialogue: 0,0:12:42.76,0:12:45.93,Default,,0,0,0,,Họ là cựu học viên đã đào tẩu\Nkhỏi Học viện ba năm trước.
Dialogue: 0,0:12:46.73,0:12:48.94,Default,,0,0,0,,Họ đã ẩn náu biệt tăm cho tới gần đây,
Dialogue: 0,0:12:49.23,0:12:51.65,Default,,0,0,0,,khi chúng tôi phát hiện ra tung tích của họ\Ntại hòn đảo Quỷ Thành này.
Dialogue: 0,0:12:52.48,0:12:57.36,Default,,0,0,0,,Nhiệm vụ của các người là truy lùng\Nvà định vị chính xác vị trí của họ.
Dialogue: 0,0:12:57.94,0:13:00.86,Default,,0,0,0,,Mọi người sẽ được chia làm hai nhóm\Nđể thực thi nhiệm vụ.
Dialogue: 0,0:13:01.53,0:13:06.41,Default,,0,0,0,,Đội Một sẽ phong tỏa và giám sát\Ntoàn bộ các tuyến đường bộ, đường hàng không và đường biển.
Dialogue: 0,0:13:06.95,0:13:09.08,Default,,0,0,0,,Các người phải ngăn chặn không cho chúng tẩu thoát khỏi hòn đảo này.
Dialogue: 0,0:13:09.92,0:13:14.84,Default,,0,0,0,,Đội Hai sẽ lùng sục từng ngóc ngách\Ntrên hòn đảo.
Dialogue: 0,0:13:15.42,0:13:18.84,Default,,0,0,0,,Còn việc thực chiến đối đầu cứ giao lại\Ncho những người Lớp A chúng tôi lo.
Dialogue: 0,0:13:19.72,0:13:21.76,Default,,0,0,0,,Tôi xin nói trước một điều thật rõ ràng.
Dialogue: 0,0:13:22.55,0:13:24.84,Default,,0,0,0,,Đừng để chiếc xe lăn đó đánh lừa.
Dialogue: 0,0:13:26.39,0:13:27.27,Default,,0,0,0,,Bằng không các người sẽ mất mạng đấy!
Dialogue: 0,0:13:30.35,0:13:33.65,Default,,0,0,0,,Nào, trước khi bắt đầu nhiệm vụ...
Dialogue: 0,0:13:35.11,0:13:36.65,Default,,0,0,0,,Hãy cùng hát vang bài ca truyền thống của trường nào!
Dialogue: 0,0:13:41.40,0:13:45.24,Default,,0,0,0,,{\i1}Nơi cỏ cây héo tàn rụi úa{\i0}
Dialogue: 0,0:13:45.41,0:13:49.54,Default,,0,0,0,,{\i1}Muông thú biệt tích tăm hơi\NTrên mảnh đất hoang tàn xơ xác{\i0}
Dialogue: 0,0:13:49.96,0:13:53.42,Default,,0,0,0,,{\i1}Nơi đó sừng sững ngôi trường thân yêu\NNhuốm đẫm sắc gỉ sét thời gian{\i0}
Dialogue: 0,0:13:53.42,0:13:57.05,Default,,0,0,0,,{\i1}Khổ luyện kiên cường. Cạnh tranh khốc liệt{\i0}
Dialogue: 0,0:13:57.34,0:13:59.68,Default,,0,0,0,,{\i1}Máu đào của những người bạn đã đổ{\i0}
Dialogue: 0,0:13:59.67,0:14:02.21,Default,,0,0,0,,{\i1}Sẽ trở thành nguồn dưỡng chất nuôi dưỡng chúng ta{\i0}
Dialogue: 0,0:14:09.22,0:14:11.76,Default,,0,0,0,,Touko. Thằng nhóc tân binh Uzu đâu rồi...
Dialogue: 0,0:14:12.39,0:14:13.93,Default,,0,0,0,,Nó biến đằng nào mất rồi?
Dialogue: 0,0:14:14.40,0:14:16.11,Default,,0,0,0,,Lúc nãy nó vẫn còn ngồi ăn sáng mà đúng không?
Dialogue: 0,0:14:18.32,0:14:20.86,Default,,0,0,0,,Hả? "Tập thể dục sau bữa ăn" á?
Dialogue: 0,0:14:21.65,0:14:23.53,Default,,0,0,0,,Nó tưởng đây là một trò đùa đấy à?
Dialogue: 0,0:14:25.49,0:14:29.41,Default,,0,0,0,,{\i1}Tại sao Thầy lại phái một tên dở hơi\Nnhư thế đến giúp chúng mình cơ chứ?{\i0}
Dialogue: 0,0:14:32.75,0:14:33.79,Default,,0,0,0,,Chuyện gì ầm ĩ đằng kia thế?
Dialogue: 0,0:14:34.29,0:14:38.50,Default,,0,0,0,,Ai mà biết, nhưng trông như có một gã điên\Nđang đập cho cả một băng đảng ra bã kìa.
Dialogue: 0,0:14:38.92,0:14:40.63,Default,,0,0,0,,Hả? Gã điên á?
Dialogue: 0,0:14:41.05,0:14:45.43,Default,,0,0,0,,Ồ, Naozumi... senpai!
Dialogue: 0,0:14:45.59,0:14:47.97,Default,,0,0,0,,Cả Touko senpai nữa!
Dialogue: 0,0:14:52.27,0:14:57.53,Default,,0,0,0,,Em sắp xong việc rồi đây,\Nchờ em một tí tẹo thôi nhé?
Dialogue: 0,0:15:02.53,0:15:06.20,Default,,0,0,0,,Hắn ta không hề nhúc nhích lấy một phân!\NSức mạnh quái quỷ gì thế này?!
Dialogue: 0,0:15:08.07,0:15:10.95,Default,,0,0,0,,Mau lôi thằng đó ra khỏi đại ca nhanh lên!
Dialogue: 0,0:15:10.95,0:15:12.95,Default,,0,0,0,,Haaaa!
Dialogue: 0,0:15:15.46,0:15:18.38,Default,,0,0,0,,Chết đi, thằng chó đẻ!
Dialogue: 0,0:15:20.84,0:15:21.72,Default,,0,0,0,,Hả...?
Dialogue: 0,0:15:23.30,0:15:30.22,Default,,0,0,0,,Thằng khốn kiếp, chết mẹ mày điiii!
Dialogue: 0,0:15:32.60,0:15:33.98,Default,,0,0,0,,Cái giề cơ?!
Dialogue: 0,0:15:38.19,0:15:43.07,Default,,0,0,0,,Nếu các người xông vào tao\Nvới sự hưng phấn tột độ như thế...
Dialogue: 0,0:15:43.82,0:15:47.41,Default,,0,0,0,,thì tao cũng sẽ hưng phấn rực cháy lên theo đấy!
Dialogue: 0,0:16:07.05,0:16:09.01,Default,,0,0,0,,Áaaa...
Dialogue: 0,0:16:11.14,0:16:13.02,Default,,0,0,0,,À, xin lỗi vì đã để hai người phải đợi lâu nhé.
Dialogue: 0,0:16:13.81,0:16:18.02,Default,,0,0,0,,Tên này... những vết thương đó\Nchẳng xi nhê gì với hắn sao?!
Dialogue: 0,0:16:21.98,0:16:23.90,Default,,0,0,0,,Cậu đang làm cái trò gì thế hả?
Dialogue: 0,0:16:23.90,0:16:24.78,Default,,0,0,0,,Dạ?
Dialogue: 0,0:16:25.49,0:16:26.83,Default,,0,0,0,,Nhiệm vụ của chúng ta cơ mà!
Dialogue: 0,0:16:28.32,0:16:32.41,Default,,0,0,0,,Ơ... ừm... khoan đã nào.\NĐể tôi làm rõ mọi chuyện cái đã.
Dialogue: 0,0:16:34.04,0:16:37.09,Default,,0,0,0,,Trước hết... mấy gã này là ai thế?
Dialogue: 0,0:16:37.33,0:16:39.67,Default,,0,0,0,,Bọn này là tội phạm bị truy nã đấy.
Dialogue: 0,0:16:39.83,0:16:42.87,Default,,0,0,0,,Em tra cứu bọn chúng trên trang web tiền thưởng ấy mà.
Dialogue: 0,0:16:44.21,0:16:50.55,Default,,0,0,0,,À... thế thì bọn chúng có liên quan quái gì\Nđến nhiệm vụ của chúng ta chứ?
Dialogue: 0,0:16:50.80,0:16:52.80,Default,,0,0,0,,Hả? Liên quan chặt chẽ luôn ấy chứ lị!
Dialogue: 0,0:16:54.31,0:16:57.11,Default,,0,0,0,,Bởi vì, Nagi ở thời điểm hiện tại
Dialogue: 0,0:16:57.68,0:17:01.43,Default,,0,0,0,,chỉ có thể duy trì được sự sống\Nkhi bị đánh trúng
Dialogue: 0,0:17:01.44,0:17:03.32,Default,,0,0,0,,bởi những luồng sát khí cực mạnh mà, đúng không?
Dialogue: 0,0:17:04.15,0:17:05.15,Default,,0,0,0,,Có lẽ vậy...
Dialogue: 0,0:17:06.28,0:17:08.53,Default,,0,0,0,,Xin lỗi, chị rút mấy lưỡi dao này ra giùm em\Nđược không ạ?
Dialogue: 0,0:17:13.07,0:17:17.41,Default,,0,0,0,,Vậy thì chẳng phải điều đó đồng nghĩa với việc\Ntất cả những kẻ mạnh trên đảo Quỷ Thành này
Dialogue: 0,0:17:17.58,0:17:23.96,Default,,0,0,0,,về cơ bản đều có thể trở thành "liều thuốc" cho hắn ta sao?
Dialogue: 0,0:17:25.42,0:17:31.09,Default,,0,0,0,,Thế nên cứ nghiền nát càng nhiều càng tốt\Nđể giảm bớt số lượng của chúng chẳng phải tốt hơn à.
Dialogue: 0,0:17:31.97,0:17:33.35,Default,,0,0,0,,Khoan đã, cái gì cơ?
Dialogue: 0,0:17:33.80,0:17:37.35,Default,,0,0,0,,Touko senpai ơi, em nhờ chị rút nó ra\Nchứ đâu có bảo chị ấn sâu nó vào đâu!
Dialogue: 0,0:17:40.19,0:17:43.90,Default,,0,0,0,,Ý em là, chỉ cần đi dạo một vòng quanh đây\Nvào buổi sáng sớm nay thôi
Dialogue: 0,0:17:43.90,0:17:48.15,Default,,0,0,0,,là em đã gom được cho mình\Nkhối kẻ có tiềm năng làm "thuốc" rồi đấy.
Dialogue: 0,0:17:50.78,0:17:56.74,Default,,0,0,0,,Quả đúng danh xưng "nơi nguy hiểm bậc nhất\Ntrong vũ trụ" có khác.
Dialogue: 0,0:18:11.51,0:18:15.26,Default,,0,0,0,,{\i1}Kurosaka, đen đủi ghê nhỉ.{\i0}
Dialogue: 0,0:18:15.60,0:18:18.98,Default,,0,0,0,,{\i1}Tao nghe nói tụi mày bị giao\Ncái vụ liên quan đến nhà Tahira.{\i0}
Dialogue: 0,0:18:19.31,0:18:23.86,Default,,0,0,0,,{\i1}"Những ngôi sao của sự bình phàm"\Nđã nỗ lực bò lên được Lớp A,{\i0}
Dialogue: 0,0:18:23.85,0:18:26.98,Default,,0,0,0,,{\i1}nơi vốn chỉ dành riêng cho những con quái vật\Nsinh ra đã sở hữu tài năng điên rồ.{\i0}
Dialogue: 0,0:18:27.36,0:18:30.49,Default,,0,0,0,,{\i1}Chắc đây rốt cuộc cũng là dấu chấm hết\Ncho hai anh em nhà Kurosaka rồi.{\i0}
Dialogue: 0,0:18:30.90,0:18:33.99,Default,,0,0,0,,{\i1}Trước khi chết,\Nnhớ gửi cho tao vài tấm ảnh của Touko nhé?{\i0}
Dialogue: 0,0:18:34.16,0:18:39.17,Default,,0,0,0,,{\i1}Tao sẽ lưu giữ chúng trong ổ cứng\Nvì lợi ích của fan hâm mộ em ấy.{\i0}
Dialogue: 0,0:18:39.54,0:18:41.21,Default,,0,0,0,,Câm mồm đi, cái thằng não điện tử biến thái kia!
Dialogue: 0,0:18:41.66,0:18:43.87,Default,,0,0,0,,Terasawa,\Nmày đang làm việc ở Ban Giáo Vụ đúng không?
Dialogue: 0,0:18:43.87,0:18:46.58,Default,,0,0,0,,Với tư cách là bạn cùng lớp cũ thời Lớp B,\Ntao có một chuyện muốn nhờ mày giúp.
Dialogue: 0,0:18:46.92,0:18:51.38,Default,,0,0,0,,Khoan, khoan đã nào, chuyện gì thế?\NĐừng có lôi tao vào rắc rối đấy nhé?
Dialogue: 0,0:18:51.71,0:18:54.30,Default,,0,0,0,,Tao cần thông tin về một tên tân binh Lớp A.
Dialogue: 0,0:18:54.80,0:18:56.76,Default,,0,0,0,,Hắn tên là "Uzu."
Dialogue: 0,0:18:56.97,0:18:59.14,Default,,0,0,0,,{\i1}Ối dào, không được đâu mày ơi.{\i0}
Dialogue: 0,0:18:59.14,0:19:00.47,Default,,0,0,0,,{\i1}Một học viên Lớp B quèn như tao{\i0}
Dialogue: 0,0:19:00.47,0:19:04.64,Default,,0,0,0,,{\i1}mà tự tiện truy cập vào thông tin của Lớp A\Nlà vi phạm nội quy nhà trường đấy.{\i0}
Dialogue: 0,0:19:05.06,0:19:07.19,Default,,0,0,0,,Alo, Ủy ban Kỷ luật đấy phải không ạ?
Dialogue: 0,0:19:07.19,0:19:12.15,Default,,0,0,0,,Cậu Terasawa lớp B có một thư mục\Ntrên máy tính đặt tên là "học thi"...
Dialogue: 0,0:19:12.40,0:19:14.69,Default,,0,0,0,,{\i1}Thư mục phòng thay đồ nữ...\NSao mày biết được cơ chứ...?!{\i0}
Dialogue: 0,0:19:15.20,0:19:18.62,Default,,0,0,0,,Cậu ta dường như đang thu thập các tài liệu\Nmang tư tưởng chống đối lại trường học trong đó.
Dialogue: 0,0:19:18.62,0:19:22.46,Default,,0,0,0,,{\i1}Này, này! Tao đã bảo là không làm đâu cơ chứ!{\i0}
Dialogue: 0,0:19:22.70,0:19:25.66,Default,,0,0,0,,{\i1}Nếu là vì người bạn chí cốt như mày,\Nthì chuyện này chẳng đáng là gì cả.{\i0}
Dialogue: 0,0:19:26.25,0:19:28.42,Default,,0,0,0,,{\i1}Và... ra rồi đây!{\i0}
Dialogue: 0,0:19:30.25,0:19:32.75,Default,,0,0,0,,{\i1}Thật thế này á?!{\i0}
Dialogue: 0,0:19:33.26,0:19:34.14,Default,,0,0,0,,Cái gì thế?
Dialogue: 0,0:19:34.47,0:19:35.56,Default,,0,0,0,,{\i1}Chờ một chút đã.{\i0}
Dialogue: 0,0:19:36.13,0:19:40.01,Default,,0,0,0,,{\i1}Tao vừa chia sẻ màn hình cho mày rồi đấy.{\i0}
Dialogue: 0,0:19:40.60,0:19:45.10,Default,,0,0,0,,{\i1}"A+" là mức độ giới hạn quyền truy cập\Ncao nhất hiện nay rồi.{\i0}
Dialogue: 0,0:19:45.44,0:19:51.20,Default,,0,0,0,,{\i1}Ngay cả Lớp A, lớp cao nhất toàn trường,\Ncũng không được phép xem thông tin này.{\i0}
Dialogue: 0,0:19:52.32,0:19:54.24,Default,,0,0,0,,{\i1}Điều đó đồng nghĩa với việc quyền truy cập...{\i0}
Dialogue: 0,0:19:56.95,0:20:01.33,Default,,0,0,0,,Chỉ thuộc về duy nhất... Thầy...
Dialogue: 0,0:20:04.66,0:20:06.58,Default,,0,0,0,,Băng bó nhẹ nhàng êm ái thôi đấy nhé?
Dialogue: 0,0:20:06.92,0:20:12.80,Default,,0,0,0,,Những vết thương của cậu ta... từng rất nghiêm trọng...\Nthế mà giờ gần như đã lành lặn hoàn toàn...
Dialogue: 0,0:20:14.34,0:20:17.89,Default,,0,0,0,,Khả năng bất hoại của cậu ta...\Ntrông gần như giống với...
Dialogue: 0,0:20:48.87,0:20:49.66,Default,,0,0,0,,SÁT
Dialogue: 0,0:20:55.17,0:20:56.25,Default,,0,0,0,,Cái quái gì thế này...?!
Dialogue: 0,0:21:29.16,0:21:31.04,Default,,0,0,0,,Đây chỉ là một lời chào hỏi nho nhỏ thôi.
Dialogue: 0,0:21:32.92,0:21:33.80,Default,,0,0,0,,Nagi...
Dialogue: 0,0:21:36.67,0:21:38.80,Default,,0,0,0,,Tao nhất định sẽ giết chết mày.
Dialogue: 0,0:21:41.01,0:21:45.89,Default,,0,0,0,,Và rồi tao sẽ bắt Thầy phải thừa nhận rằng\Ntao xuất sắc và vượt trội hơn mày.
Dialogue: 0,0:21:50.69,0:21:52.44,Default,,0,0,0,,NƯỚC MUỐI SINH LÝ (SALINE)
Dialogue: 0,0:23:56.10,0:23:58.18,Default,,0,0,0,,{\an8}HỌA SĨ MINH HỌA: KASUMI YASUDA
Dialogue: 0,0:23:58.19,0:24:01.07,Default,,0,0,0,,{\an8}PHỤ ĐỀ TIẾNG VIỆT: PHAMTIN147
