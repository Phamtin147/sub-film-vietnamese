Dialogue: 1,0:00:04.00,0:00:06.58,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:06.58,0:00:09.29,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:00:09.29,0:00:12.21,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:12.21,0:00:14.83,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:00:15.00,0:00:17.75,Q0,,0,0,0,,Mềm nhũn cả người, thích ghê, mê thật đấy
Dialogue: 1,0:00:17.75,0:00:20.38,Q0,,0,0,0,,Một khi đã thèm thì cứ nhào vô mà húp
Dialogue: 1,0:00:20.38,0:00:23.42,Q0,,0,0,0,,Ráng mà kìm nén là nổ tung cho coi
Dialogue: 1,0:00:23.42,0:00:24.79,Q0,,0,0,0,,Bảo là đang đùa với cưng thôi á?
Dialogue: 1,0:00:24.79,0:00:25.92,Q0,,0,0,0,,Không đâu, nói nghiêm túc đấy!
Dialogue: 1,0:00:26.17,0:00:28.88,Q0,,0,0,0,,Ai ai cũng làm, ai nấy đều mần cả thôi
Dialogue: 1,0:00:28.88,0:00:30.13,Q0,,0,0,0,,Làm á? Mần gì cơ?
Dialogue: 1,0:00:30.13,0:00:31.25,Q0,,0,0,0,,Làm cái gì mới được chứ?!
Dialogue: 1,0:00:31.54,0:00:32.83,Q0,,0,0,0,,Làm chuyện gì đó đi nào
Dialogue: 1,0:00:32.83,0:00:34.38,Q0,,0,0,0,,Một khi đã bắt đầu rồi
Dialogue: 1,0:00:34.38,0:00:37.13,Q0,,0,0,0,,Sẽ là chuyến phiêu lưu tuôn trào đầy nguy hiểm
Dialogue: 1,0:00:37.13,0:00:38.21,Q0,,0,0,0,,Làm cái chi cơ?
Dialogue: 1,0:00:38.21,0:00:39.92,Q0,,0,0,0,,Mỗi khi miệng bảo chẳng thèm quan tâm
Dialogue: 1,0:00:39.92,0:00:42.79,Q0,,0,0,0,,Là trong lòng lại muốn nhào vô quất liền đúng không?
Dialogue: 1,0:00:42.79,0:00:43.92,Q0,,0,0,0,,Làm chuyện gì đó đi mà
Dialogue: 1,0:00:43.92,0:00:45.38,Q0,,0,0,0,,Rồi sau đó thì sao nè?
Dialogue: 1,0:00:45.38,0:00:46.63,Q0,,0,0,0,,Làm chuyện gì đó đi nào
Dialogue: 1,0:00:46.63,0:00:48.13,Q0,,0,0,0,,Tới lúc đó bọn mình sẽ làm gì?
Dialogue: 1,0:00:48.13,0:00:50.29,Q0,,0,0,0,,Giờ tính sao? Phải làm tới bến thôi
Dialogue: 1,0:00:50.29,0:00:52.88,Q0,,0,0,0,,Đúng không nè? Tới luôn đi chứ!
Dialogue: 1,0:00:52.88,0:00:54.13,Q0,,0,0,0,,Chiến luôn đi nào!
Dialogue: 1,0:00:54.13,0:00:56.38,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:56.38,0:00:58.83,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:01:05.92,0:01:08.63,Q2,,0,0,0,,Hầm ngục này trông cổ kính thật đấy nhỉ?
Dialogue: 1,0:01:08.83,0:01:12.46,Q2,,0,0,0,,Các cậu nghĩ đây chính là nơi\Nmà vị thân chủ nhắc tới à?
Dialogue: 1,0:01:12.79,0:01:17.54,Q2,,0,0,0,,Nhiệm vụ lần này là thu hồi một báu vật\Ntừ tầng sâu nhất của hầm ngục, đúng không?
Dialogue: 1,0:01:17.83,0:01:21.75,Q2,,0,0,0,,Cơ mà một nơi hoang phế thế này\Nthì trông chẳng giống còn thứ gì giá trị sót lại nhỉ.
Dialogue: 1,0:01:22.25,0:01:25.42,Q2,,0,0,0,,Chỉ một phút lơ là nhỏ nhất thôi\Ncũng đủ mất mạng trong hầm ngục như chơi đấy!
Dialogue: 1,0:01:25.42,0:01:28.17,Q2,,0,0,0,,Mọi người hãy đề cao cảnh giác hết mức\Nkhi tiến sâu vào bên trong nhé!
Dialogue: 1,0:01:28.17,0:01:30.79,Q2,,0,0,0,,Đừng có tự tiện chui ra lúc ta chưa triệu hồi nữa.
Dialogue: 1,0:01:31.58,0:01:34.50,Q2,,0,0,0,,Được rồi! Vào kiểm tra thử xem sao nào!
Dialogue: 1,0:01:34.79,0:01:37.29,Q2,,0,0,0,,Mọi người nhớ để ý bẫy rập đấy nhé.
Dialogue: 1,0:01:41.54,0:01:43.33,Q2,,0,0,0,,Cuối cùng ta cũng tìm thấy ngươi rồi...
Dialogue: 1,0:01:43.63,0:01:47.17,Q2,,0,0,0,,Kẻ đã cướp đi tất cả mọi thứ của ta.
Dialogue: 1,0:02:01.63,0:02:03.58,Q2,,0,0,0,,Có chuyện gì thế, Amona?
Dialogue: 1,0:02:03.58,0:02:06.50,Q2,,0,0,0,,Từ nãy tới giờ trông cô cứ như\Nđang có chuyện bận tâm vậy.
Dialogue: 1,0:02:07.21,0:02:08.71,Q2,,0,0,0,,Hầm ngục này...
Dialogue: 1,0:02:09.46,0:02:11.96,Q2,,0,0,0,,Có dấu tích cho thấy từng có\Nác quỷ được triệu hồi tại đây.
Dialogue: 1,0:02:11.96,0:02:14.13,Q2,,0,0,0,,Nơi này hoặc là sào huyệt của đám hắc triệu hồi sư,
Dialogue: 1,0:02:14.13,0:02:16.96,Q2,,0,0,0,,hoặc là căn cứ của lũ cuồng tín tôn thờ ác quỷ.
Dialogue: 1,0:02:17.25,0:02:22.71,Q2,,0,0,0,,Phiền phức thật đấy, lũ cặn bã đó\Ncứ chui rúc vào hầm ngục y như đám chuột cống vậy.
Dialogue: 1,0:02:22.71,0:02:25.42,Q2,,0,0,0,,Cơ mà tôi cũng phục sát đất vì cậu nhận ra được đấy!
Dialogue: 1,0:02:25.42,0:02:26.79,Q2,,0,0,0,,Tôi trước đây cũng từng...
Dialogue: 1,0:02:27.17,0:02:31.21,Q2,,0,0,0,,Cho tới tận gần đây,\Ntôi cũng là một con "chuột cống" như thế đấy.
Dialogue: 1,0:02:35.58,0:02:37.75,Q2,,0,0,0,,Bầu không khí tự dưng ngượng ngập hẳn ra rồi nhỉ?
Dialogue: 1,0:02:37.75,0:02:39.75,Q2,,0,0,0,,Sao ngài không trút bầu tâm sự với ông bạn già Imp này đi?
Dialogue: 1,0:02:39.75,0:02:41.29,Q2,,0,0,0,,Cái tên tiểu quỷ này...!
Dialogue: 1,0:02:45.17,0:02:47.96,Q2,,0,0,0,,Mình cứ tưởng mình đã hiểu rõ về Amona,
Dialogue: 1,0:02:47.96,0:02:50.46,Q2,,0,0,0,,nhưng hóa ra mình chẳng biết gì về\Nquá khứ hay lai lịch của cô ấy cả.
Dialogue: 1,0:02:51.25,0:02:56.08,Q2,,0,0,0,,Chẳng rõ vì sao cô ấy lại thành Hắc Triệu Hồi Sư,\Nhay từng lăn lộn trong các hầm ngục nữa.
Dialogue: 1,0:02:57.04,0:03:00.25,Q2,,0,0,0,,Có lẽ đó là một quá khứ\Nmà cô ấy không thể mở lòng kể với ai được...
Dialogue: 1,0:03:00.25,0:03:02.71,Q2,,0,0,0,,Không, mình không nên nghi ngờ cô ấy như thế!
Dialogue: 1,0:03:02.71,0:03:05.71,Q2,,0,0,0,,Chắc chắn Amona chưa kể là tại\Nmình cứ hay tự suy diễn lung tung thế này đây!
Dialogue: 1,0:03:06.29,0:03:10.83,Q2,,0,0,0,,Khi nào cô ấy thực sự tin tưởng mình,\Nnhất định cô ấy sẽ tự nói ra thôi.
Dialogue: 1,0:03:11.33,0:03:13.04,Q2,,0,0,0,,Khoan đã, con quái nào kia?!
Dialogue: 1,0:03:15.75,0:03:17.46,Q2,,0,0,0,,Đằng ấy không cần phải lo đâu.
Dialogue: 1,0:03:17.67,0:03:20.96,Q2,,0,0,0,,Đó chỉ là linh vật của hầm ngục này, Slimy thôi.
Dialogue: 1,0:03:20.96,0:03:23.25,Q2,,0,0,0,,Từ bao giờ mà hầm ngục lại có cả linh vật thế hả?!
Dialogue: 1,0:03:23.25,0:03:26.58,Q2,,0,0,0,,Nó gần như vô hại ấy mà,\Ncứ mặc kệ nó là xong.
Dialogue: 1,0:03:26.58,0:03:29.17,Q2,,0,0,0,,Nhưng trông nó cứ làm tôi bất an kiểu gì ấy...
Dialogue: 1,0:03:32.71,0:03:34.08,Q2,,0,0,0,,Amona!
Dialogue: 1,0:03:34.08,0:03:38.92,Q2,,0,0,0,,Hầm ngục này là Công Viên Slimy,\Nmột nơi ngập tràn xúc tu nhớp nháp.
Dialogue: 1,0:03:39.42,0:03:41.25,Q2,,0,0,0,,Chuyện quan trọng thế sao cô không báo sớm hơn hả!
Dialogue: 1,0:03:47.71,0:03:51.04,Q2,,0,0,0,,Thiêu rụi nó thành tro bụi bằng hắc lôi đi!
Dialogue: 1,0:03:51.38,0:03:52.83,Q2,,0,0,0,,Sét Đánh!
Dialogue: 1,0:03:57.29,0:03:58.50,Q2,,0,0,0,,Amona!
Dialogue: 1,0:03:59.08,0:04:00.58,Q2,,0,0,0,,Đừng có liều lĩnh thế chứ!
Dialogue: 1,0:04:00.58,0:04:03.08,Q2,,0,0,0,,Thi triển phép ở cự ly gần thế kia\Ndễ tự làm mình bị thương lắm đấy!
Dialogue: 1,0:04:03.42,0:04:04.83,Q2,,0,0,0,,Cuốn ma đạo thư của tôi...
Dialogue: 1,0:04:06.50,0:04:08.79,Q2,,0,0,0,,Bị lũ xúc tu cướp mất rồi sao?
Dialogue: 1,0:04:10.25,0:04:13.88,Q2,,0,0,0,,Xem ra khó lòng mà lấy lại được\Nnguyên vẹn rồi...
Dialogue: 1,0:04:21.67,0:04:22.88,Q2,,0,0,0,,Ái!
Dialogue: 1,0:04:23.63,0:04:26.42,Q2,,0,0,0,,Này! Chẳng phải cậu bảo thằng cha này vô hại sao?!
Dialogue: 1,0:04:26.42,0:04:29.54,Q2,,0,0,0,,Nó chỉ vỗ lưng chào hỏi thân thiện chút thôi mà,\Ncăng thẳng thế làm gì?
Dialogue: 1,0:04:29.54,0:04:31.21,Q2,,0,0,0,,Thân thiện thì cũng phải có giới hạn chứ!
Dialogue: 1,0:04:31.79,0:04:33.92,Q2,,0,0,0,,Chẳng cần cậu phải nhắc đâu!
Dialogue: 1,0:04:33.92,0:04:36.00,Q2,,0,0,0,,Tôi biết thừa mình phải làm gì rồi!
Dialogue: 1,0:04:38.04,0:04:39.29,Q2,,0,0,0,,Roni?!
Dialogue: 1,0:04:44.04,0:04:46.79,Q2,,0,0,0,,Ma đạo thư của Amona...
Dialogue: 1,0:04:51.38,0:04:52.38,Q2,,0,0,0,,Tôi quay lại rồi đây.
Dialogue: 1,0:04:52.38,0:04:53.71,Q2,,0,0,0,,Rốt cuộc anh là quái vật phương nào vậy hả?!
Dialogue: 1,0:04:54.04,0:04:55.25,Q2,,0,0,0,,Amona...
Dialogue: 1,0:04:55.54,0:04:56.71,Q2,,0,0,0,,Của cô đây.
Dialogue: 1,0:04:58.08,0:05:00.54,Q2,,0,0,0,,Cuốn sách này rất quan trọng với cô, đúng không?
Dialogue: 1,0:05:01.96,0:05:03.29,Q2,,0,0,0,,Cảm ơn anh.
Dialogue: 1,0:05:03.92,0:05:06.67,Q2,,0,0,0,,Đây là kỷ vật quý giá mà sư phụ tôi để lại...
Dialogue: 1,0:05:11.13,0:05:13.25,Q2,,0,0,0,,Khứa mục sư này tốt bụng phết nhỉ.
Dialogue: 1,0:05:21.08,0:05:22.58,Q2,,0,0,0,,À, kia rồi!
Dialogue: 1,0:05:22.58,0:05:24.79,Q2,,0,0,0,,Chắc hẳn đó là kho báu của nhiệm vụ lần này!
Dialogue: 1,0:05:26.96,0:05:29.29,Q2,,0,0,0,,Rốt cuộc bên trong là loại báu vật gì thế nhỉ...?
Dialogue: 1,0:05:30.29,0:05:32.29,Q2,,0,0,0,,T-Trống rỗng à!
Dialogue: 1,0:05:33.21,0:05:34.88,Q2,,0,0,0,,Chuyện quái gì thế này?
Dialogue: 1,0:05:34.88,0:05:37.96,Q2,,0,0,0,,Có kẻ nào đã nhanh chân cuỗm sạch trước bọn mình rồi sao?
Dialogue: 1,0:05:37.96,0:05:39.79,Q2,,0,0,0,,Thứ từng nằm trong chiếc rương đó...
Dialogue: 1,0:05:40.67,0:05:43.08,Q2,,0,0,0,,chính là thứ ta đã phát hiện ra vào một năm trước!
Dialogue: 1,0:05:43.92,0:05:48.13,Q2,,0,0,0,,Và chính nó đã khiến ta mất trắng tất cả!
Dialogue: 1,0:05:49.25,0:05:50.46,Q2,,0,0,0,,Ngươi là ai?!
Dialogue: 1,0:05:50.92,0:05:53.54,Q2,,0,0,0,,Chính ta là kẻ đã treo ủy thác nhiệm vụ đó.
Dialogue: 1,0:05:53.88,0:05:56.58,Q2,,0,0,0,,Tất cả chỉ để dụ các ngươi tới đây!
Dialogue: 1,0:05:56.96,0:05:58.00,Q2,,0,0,0,,Cái gì?!
Dialogue: 1,0:05:59.00,0:06:02.50,Q2,,0,0,0,,Đừng nói với ta là ngươi đã quên sạch\Nkhi nhìn thấy gương mặt này nhé!
Dialogue: 1,0:06:02.50,0:06:04.50,Q2,,0,0,0,,Chỉ vì ngươi...
Dialogue: 1,0:06:06.50,0:06:09.42,Q2,,0,0,0,,mà giờ đây ta mới ra nông nỗi này đây!
Dialogue: 1,0:06:10.96,0:06:13.25,Q2,,0,0,0,,Một... cô gái xinh đẹp ư?
Dialogue: 1,0:06:15.67,0:06:17.50,Q2,,0,0,0,,Tôi Đang Hẹn Hò Cùng Hắc Triệu Hồi Sư đấy.
Dialogue: 1,0:06:18.25,0:06:20.38,Q2,,0,0,0,,Tên ta là Clark Russ,
Dialogue: 1,0:06:20.38,0:06:24.21,Q2,,0,0,0,,một năm trước từng nổi danh khắp chốn\Nlà thợ săn kho báu bậc thầy.
Dialogue: 1,0:06:24.83,0:06:28.29,Q2,,0,0,0,,Bất kể trước mặt có giăng bẫy rập hiểm hóc cỡ nào,\Nta luôn đoạt được thứ mình nhắm tới.
Dialogue: 1,0:06:28.67,0:06:32.46,Q2,,0,0,0,,Ta thậm chí còn nhận được ủy thác trực tiếp\Ntừ giới tinh hoa trong thành phố,
Dialogue: 1,0:06:32.46,0:06:34.46,Q2,,0,0,0,,sự nghiệp khi ấy đang lên như diều gặp gió.
Dialogue: 1,0:06:36.46,0:06:39.17,Q2,,0,0,0,,Thế nhưng ta đã sơ suất không nhận ra
Dialogue: 1,0:06:39.17,0:06:41.58,Q2,,0,0,0,,mức độ nguy hiểm khôn lường của món báu vật kia.
Dialogue: 1,0:06:42.00,0:06:44.50,Q2,,0,0,0,,Chà chà, xem ra tìm thấy kho báu rồi đây.
Dialogue: 1,0:06:44.50,0:06:46.13,Q2,,0,0,0,,Hãy quay đầu lại đi...
Dialogue: 1,0:06:47.17,0:06:52.88,Q2,,0,0,0,,Hỡi kẻ trộm tham lam báu vật,\Nngươi hãy lập tức rời khỏi chốn này.
Dialogue: 1,0:06:53.17,0:06:58.75,Q2,,0,0,0,,Nếu không nghe lời, lời nguyền của ác quỷ\Nsẽ giáng xuống đầu ngươi.
Dialogue: 1,0:06:58.75,0:07:00.42,Q2,,0,0,0,,Lời nguyền của ác quỷ à?
Dialogue: 1,0:07:00.42,0:07:02.50,Q2,,0,0,0,,Nếu chỉ dăm ba câu dọa dẫm thế này\Nmà đã làm ta chùn bước,
Dialogue: 1,0:07:02.50,0:07:05.29,Q2,,0,0,0,,thì ta đâu có thể kiếm cơm bằng nghề\Nthợ săn kho báu được chứ!
Dialogue: 1,0:07:06.54,0:07:09.46,Q2,,0,0,0,,Báu vật được hẳn ác quỷ canh giữ\Nthế này thì chắc chắn là hàng cực phẩm rồi!
Dialogue: 1,0:07:12.83,0:07:15.63,Q2,,0,0,0,,Cái quái gì thế này, tạp chí người lớn à?
Dialogue: 1,0:07:15.63,0:07:18.33,Q2,,0,0,0,,Á, tên kia nhìn thấy mất rồi!
Dialogue: 1,0:07:18.59,0:07:21.54,Q2,,0,0,0,,Cuốn doujinshi chuyển giới\Nmà ta tự vẽ từ ngày xửa ngày xưa!
Dialogue: 1,0:07:21.54,0:07:25.88,Q2,,0,0,0,,Đó là kiệt tác tâm huyết ta in tận\Nmột ngàn cuốn mà bán được đúng ba cuốn!
Dialogue: 1,0:07:25.88,0:07:28.54,Q2,,0,0,0,,Quá khứ đen tối mà ta chỉ muốn chôn vùi vĩnh viễn!
Dialogue: 1,0:07:28.83,0:07:31.25,Q2,,0,0,0,,Hả?! Khoan, cái thứ này là kho báu á?!
Dialogue: 1,0:07:31.33,0:07:33.83,Q2,,0,0,0,,Một khi ngươi đã trót nhìn thấy nó rồi,
Dialogue: 1,0:07:33.83,0:07:36.58,Q2,,0,0,0,,thì ngươi buộc phải gánh chịu lời nguyền!
Dialogue: 1,0:07:37.21,0:07:39.21,Q2,,0,0,0,,Làn khói quái quỷ gì thế này...?!
Dialogue: 1,0:07:49.33,0:07:53.83,Q2,,0,0,0,,Và thế là, ta đã bị nguyền rủa\Nbiến thành hình hài một người phụ nữ!
Dialogue: 1,0:07:54.29,0:07:56.21,Q2,,0,0,0,,Tất cả đều là tại ngươi hết!
Dialogue: 1,0:07:57.04,0:07:57.96,Q2,,0,0,0,,Tại ai cơ?
Dialogue: 1,0:07:57.96,0:07:58.75,Q6,,0,0,0,,Ai cơ?
Dialogue: 1,0:07:58.75,0:07:59.46,Q2,,0,0,0,,Ai vậy?
Dialogue: 1,0:07:59.46,0:08:00.63,Q2,,0,0,0,,Chính là ngươi chứ còn ai vào đây nữa?!
Dialogue: 1,0:08:00.63,0:08:03.46,Q2,,0,0,0,,Khoan đã nào!\NMọi người kết tội tôi dễ dàng thế luôn hả?!
Dialogue: 1,0:08:03.46,0:08:05.92,Q2,,0,0,0,,Mấy cái bằng chứng hiện trường kiểu này\Ndựng giả dễ ợt ấy mà!
Dialogue: 1,0:08:05.92,0:08:07.83,Q2,,0,0,0,,Ít ra cũng phải tỏ vẻ nghi ngờ một chút chứ!
Dialogue: 1,0:08:07.83,0:08:10.25,Q2,,0,0,0,,Vốn dĩ ngay từ đầu bọn tôi chẳng hề\Ntin tưởng nổi cậu rồi.
Dialogue: 1,0:08:10.50,0:08:14.13,Q2,,0,0,0,,Nhưng chúng ta đâu thể khẳng định chắc nịch\Ncon ác quỷ khi đó là Imp.
Dialogue: 1,0:08:14.13,0:08:15.25,Q2,,0,0,0,,Đúng thế, chuẩn không cần chỉnh!
Dialogue: 1,0:08:15.25,0:08:17.50,Q2,,0,0,0,,Hình hài của con ác quỷ kia chỉ là con rối thế thân.
Dialogue: 1,0:08:17.50,0:08:18.50,Q2,,0,0,0,,Hả?
Dialogue: 1,0:08:18.50,0:08:22.25,Q2,,0,0,0,,Tất cả đều do chung một bản thể gốc\Nở Ma giới giật dây điều khiển hết.
Dialogue: 1,0:08:22.25,0:08:25.00,Q2,,0,0,0,,Truy ngược về nguồn thì bọn chúng đều là cùng một giuộc cả!
Dialogue: 1,0:08:25.58,0:08:26.88,Q2,,0,0,0,,Á hự!
Dialogue: 1,0:08:27.17,0:08:29.92,Q2,,0,0,0,,Ngươi phải trả lại cơ thể ban đầu cho ta.
Dialogue: 1,0:08:30.25,0:08:31.67,Q2,,0,0,0,,Nếu ngươi dám từ chối...
Dialogue: 1,0:08:37.50,0:08:40.63,Q2,,0,0,0,,Chắc ngươi thừa hiểu chuyện gì sẽ xảy ra\Nvới chủ nhân của mình rồi chứ?
Dialogue: 1,0:08:40.63,0:08:41.88,Q2,,0,0,0,,Amona!
Dialogue: 1,0:08:42.17,0:08:46.17,Q2,,0,0,0,,Kể cả kẻ như ngươi chắc hẳn cũng thấy rắc rối\Nnếu ả ta mất mạng nhỉ.
Dialogue: 1,0:08:46.42,0:08:48.42,Q2,,0,0,0,,Tốc độ nhanh khủng khiếp!
Dialogue: 1,0:08:48.42,0:08:52.33,Q2,,0,0,0,,Ta đã chinh phục vô số hầm ngục hiểm trở rồi.
Dialogue: 1,0:08:52.33,0:08:55.92,Q2,,0,0,0,,Đừng có đánh đồng ta với đám\Nmạo hiểm giả hạng xoàng các ngươi!
Dialogue: 1,0:08:56.38,0:09:00.58,Q2,,0,0,0,,Và đừng hòng nghĩ tới chuyện\Ndùng ma pháp để phản kháng.
Dialogue: 1,0:09:01.00,0:09:04.08,Q2,,0,0,0,,Nào, ác quỷ kia, giờ ngươi định làm gì đây?
Dialogue: 1,0:09:09.71,0:09:11.04,Q2,,0,0,0,,Á!
Dialogue: 1,0:09:12.29,0:09:15.29,Q2,,0,0,0,,C-Cái thứ gớm ghiếc gì thế này?!
Dialogue: 1,0:09:16.88,0:09:18.88,Q2,,0,0,0,,Vị trí chuẩn không cần chỉnh luôn!
Dialogue: 1,0:09:19.04,0:09:20.21,Q2,,0,0,0,,Chủ nhân!
Dialogue: 1,0:09:21.08,0:09:22.83,Q2,,0,0,0,,Nhắm thẳng lên trần hang đi ạ!
Dialogue: 1,0:09:24.21,0:09:25.83,Q2,,0,0,0,,Bộc Phá!
Dialogue: 1,0:09:28.13,0:09:30.54,Q2,,0,0,0,,Ngươi tưởng chỉ phá sập cái trần hang\Nlà đủ để...
Dialogue: 1,0:09:31.42,0:09:32.42,Q2,,0,0,0,,Sột soạt?
Dialogue: 1,0:09:32.96,0:09:34.92,Q2,,0,0,0,,Amona! Cô có sao không?!
Dialogue: 1,0:09:38.21,0:09:40.92,Q2,,0,0,0,,Đám xúc tu quái quỷ này từ đâu chui ra thế?!
Dialogue: 1,0:09:42.04,0:09:47.04,Q2,,0,0,0,,May mắn làm sao, căn phòng ngay tầng trên\Nlại vừa khéo chứa đầy xúc tu.
Dialogue: 1,0:09:47.21,0:09:52.04,Q2,,0,0,0,,Phải không nào, tên đạo tặc chuyển giới kia?!
Dialogue: 1,0:09:54.21,0:09:57.33,Q2,,0,0,0,,Đúng là đồ vô ơn, người ta ngoài kia
Dialogue: 1,0:09:57.33,0:10:00.33,Q2,,0,0,0,,biết bao nhiêu kẻ mơ ước được biến thành\Ncon gái còn chẳng được nữa là!
Dialogue: 1,0:10:00.54,0:10:03.42,Q2,,0,0,0,,Thế nào hả?! Ngươi thấy chiêu này ra sao?!
Dialogue: 1,0:10:00.54,0:10:03.42,Q6,,0,0,0,,Làm quái gì có ai như thế ngoài đời chứ hả!
Dialogue: 1,0:10:03.42,0:10:04.29,Q2,,0,0,0,,Thế nào hả?! Ngươi thấy chiêu này ra sao?!
Dialogue: 1,0:10:05.75,0:10:07.83,Q2,,0,0,0,,Thôi nào, thôi nào, Imp.
Dialogue: 1,0:10:08.50,0:10:15.58,Q2,,0,0,0,,À ừm, anh Clark này, nếu anh chịu hứa không làm hại bọn tôi,\Nthì bọn tôi sẽ giúp giải cứu anh đấy.
Dialogue: 1,0:10:17.33,0:10:21.13,Q2,,0,0,0,,Ta không cần... lòng thương hại của các ngươi...
Dialogue: 1,0:10:22.00,0:10:24.13,Q2,,0,0,0,,Thấy chưa, cậu ta bảo cứ mặc xác cậu ta đi kìa.
Dialogue: 1,0:10:24.13,0:10:25.50,Q2,,0,0,0,,Tên ác quỷ khốn kiếp!
Dialogue: 1,0:10:25.50,0:10:27.25,Q2,,0,0,0,,Ta sẽ còn quay lại...
Dialogue: 1,0:10:27.88,0:10:29.79,Q2,,0,0,0,,truy lùng các ngươi cho tới khi nào...
Dialogue: 1,0:10:30.42,0:10:32.29,Q2,,0,0,0,,ta thoát khỏi cái lời nguyền quái ác này mới thôi!
Dialogue: 1,0:10:32.29,0:10:34.04,Q2,,0,0,0,,Cả lũ các ngươi nữa!
Dialogue: 1,0:10:34.04,0:10:35.75,Q2,,0,0,0,,Nếu cứ tiếp tục đồng hành cùng hắn...
Dialogue: 1,0:10:35.75,0:10:37.50,Q2,,0,0,0,,thì thứ duy nhất chờ đợi các ngươi...
Dialogue: 1,0:10:38.58,0:10:40.38,Q2,,0,0,0,,chính là kết cục diệt vong!
Dialogue: 1,0:10:41.96,0:10:43.33,Q2,,0,0,0,,Hết nói nổi luôn.
Dialogue: 1,0:10:43.33,0:10:47.63,Q2,,0,0,0,,Trên thế gian này, có một báu vật\Ncòn quý giá hơn mọi châu báu khác...
Dialogue: 1,0:10:48.00,0:10:50.29,Q2,,0,0,0,,Đó chính là niềm tin giữa những người đồng đội!
Dialogue: 1,0:10:50.29,0:10:52.46,Q2,,0,0,0,,Phải không nào, mọi người ơi?!
Dialogue: 1,0:10:54.42,0:10:55.75,Q2,,0,0,0,,Mọi người ơi...?
Dialogue: 1,0:10:56.38,0:10:57.75,Q2,,0,0,0,,Các cậu ơi...?
Dialogue: 1,0:11:07.50,0:11:09.67,Q0,,0,0,0,,Yêu hay là ghét? Em cũng chẳng rõ nữa
Dialogue: 1,0:11:09.67,0:11:11.79,Q0,,0,0,0,,Em đang khao khát điều chi?\NEm chỉ muốn mãi được ở bên cạnh anh
Dialogue: 1,0:11:11.79,0:11:15.79,Q0,,0,0,0,,Chẳng bao giờ muốn buông lơi hơi ấm dịu dàng ấy
Dialogue: 1,0:11:16.75,0:11:21.21,Q0,,0,0,0,,Vẫn còn quá sớm ư? Em muốn được thấy anh,\Nmuốn thấu hiểu những cảm xúc chất chứa này
Dialogue: 1,0:11:21.21,0:11:24.63,Q0,,0,0,0,,Nhưng lúc này vẫn chưa phải lúc trao nhau nụ hôn
Dialogue: 1,0:11:26.13,0:11:28.38,Q0,,0,0,0,,Liệu hai đứa mình cứ mãi như thế này có được không?
Dialogue: 1,0:11:28.38,0:11:30.71,Q0,,0,0,0,,Chỉ chạm khẽ vào nhau thôi há chẳng đủ sao?
Dialogue: 1,0:11:30.71,0:11:34.71,Q0,,0,0,0,,Em đã ôm trọn lấy anh trong khoảnh khắc ấm áp đôi ta cùng sẻ chia
Dialogue: 1,0:11:36.17,0:11:41.92,Q0,,0,0,0,,Em muốn có được anh, muốn tất cả thuộc về mình, và vì thế
Dialogue: 1,0:11:41.92,0:11:44.92,Q0,,0,0,0,,Em hoàn toàn bằng lòng yêu anh
Dialogue: 1,0:11:45.46,0:11:51.29,Q0,,0,0,0,,Chẳng phải ai khác, chỉ riêng anh thôi, dẫu chẳng thể thốt nên lời
Dialogue: 1,0:11:51.29,0:11:54.88,Q0,,0,0,0,,Em đã chôn giấu tiếng yêu sâu tận trong đáy lòng
Dialogue: 1,0:11:54.88,0:12:00.75,Q0,,0,0,0,,Một ngày nào đó em sẽ nói ra, nhưng giờ đây đó vẫn là bí mật của riêng em
