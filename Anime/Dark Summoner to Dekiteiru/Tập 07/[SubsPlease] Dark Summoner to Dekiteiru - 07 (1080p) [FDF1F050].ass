Dialogue: 1,0:00:04.00,0:00:06.58,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:06.58,0:00:09.29,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:00:09.29,0:00:12.21,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:12.21,0:00:14.83,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:00:15.00,0:00:17.75,Q0,,0,0,0,,Mềm nhũn cả người, thích ghê, mê thật đấy
Dialogue: 1,0:00:17.75,0:00:20.38,Q0,,0,0,0,,Một khi đã thèm thì cứ nhào vô mà húp
Dialogue: 1,0:00:20.38,0:00:23.42,Q0,,0,0,0,,Ráng mà kìm nén là nổ tung cho coi
Dialogue: 1,0:00:23.42,0:00:24.79,Q0,,0,0,0,,Bảo là đang đùa với cưng thôi á?
Dialogue: 1,0:00:24.79,0:00:25.92,Q0,,0,0,0,,Không đâu, nói nghiêm túc đấy!
Dialogue: 1,0:00:26.17,0:00:28.88,Q0,,0,0,0,,Ai ai cũng làm, ai nấy đều mần cả thôi
Dialogue: 1,0:00:28.88,0:00:30.13,Q0,,0,0,0,,Làm á? Mần gì cơ?
Dialogue: 1,0:00:30.13,0:00:31.25,Q0,,0,0,0,,Làm cái gì mới được chứ?!
Dialogue: 1,0:00:31.54,0:00:32.83,Q0,,0,0,0,,Làm chuyện gì đó đi nào
Dialogue: 1,0:00:32.83,0:00:34.38,Q0,,0,0,0,,Một khi đã bắt đầu rồi
Dialogue: 1,0:00:34.38,0:00:37.13,Q0,,0,0,0,,Sẽ là chuyến phiêu lưu tuôn trào đầy nguy hiểm
Dialogue: 1,0:00:37.13,0:00:38.21,Q0,,0,0,0,,Làm cái chi cơ?
Dialogue: 1,0:00:38.21,0:00:39.92,Q0,,0,0,0,,Mỗi khi miệng bảo chẳng thèm quan tâm
Dialogue: 1,0:00:39.92,0:00:42.79,Q0,,0,0,0,,Là trong lòng lại muốn nhào vô quất liền đúng không?
Dialogue: 1,0:00:42.79,0:00:43.92,Q0,,0,0,0,,Làm chuyện gì đó đi mà
Dialogue: 1,0:00:43.92,0:00:45.38,Q0,,0,0,0,,Rồi sau đó thì sao nè?
Dialogue: 1,0:00:45.38,0:00:46.63,Q0,,0,0,0,,Làm chuyện gì đó đi nào
Dialogue: 1,0:00:46.63,0:00:48.13,Q0,,0,0,0,,Tới lúc đó bọn mình sẽ làm gì?
Dialogue: 1,0:00:48.13,0:00:50.29,Q0,,0,0,0,,Giờ tính sao? Phải làm tới bến thôi
Dialogue: 1,0:00:50.29,0:00:52.88,Q0,,0,0,0,,Đúng không nè? Tới luôn đi chứ!
Dialogue: 1,0:00:52.88,0:00:54.13,Q0,,0,0,0,,Chiến luôn đi nào!
Dialogue: 1,0:00:54.13,0:00:56.38,Q0,,0,0,0,,Làm đi! Mau làm tới luôn đi!
Dialogue: 1,0:00:56.38,0:00:58.83,Q0,,0,0,0,,Khóa chặt mục tiêu rồi đó!
Dialogue: 1,0:01:02.75,0:01:04.08,Q2,,0,0,0,,Goblin...
Dialogue: 1,0:01:04.08,0:01:05.58,Q2,,0,0,0,,Tuy từng con riêng lẻ khá yếu ớt,
Dialogue: 1,0:01:05.58,0:01:07.88,Q2,,0,0,0,,nhưng lũ quái vật cấp thấp này lại biết phối hợp nhóm
Dialogue: 1,0:01:07.88,0:01:10.50,Q2,,0,0,0,,cùng sự ranh ma để gây không ít rắc rối\Ncho các tổ đội mạo hiểm giả.
Dialogue: 1,0:01:17.08,0:01:19.33,Q2,,0,0,0,,Chuyện quái gì đang diễn ra ở đây thế?
Dialogue: 1,0:01:23.71,0:01:25.92,Q2,,0,0,0,,Nhiệm vụ thảo phạt goblin ư?
Dialogue: 1,0:01:26.25,0:01:30.33,Q2,,0,0,0,,Nhiệm vụ kiểu này chẳng phải quá đơn giản\Nđể tụi mình nhận làm sao.
Dialogue: 1,0:01:30.33,0:01:34.58,Q2,,0,0,0,,Mấy việc nhỏ nhặt thế này cũng giúp ích cho\Ndân làng lắm đấy chứ, Amona!
Dialogue: 1,0:01:34.58,0:01:38.21,Q2,,0,0,0,,Cơ mà cũng tại cậu cứ suốt ngày\Nnhận bừa ủy thác chẳng thèm suy nghĩ gì cả đấy!
Dialogue: 1,0:01:39.46,0:01:42.33,Q2,,0,0,0,,Không được phép chủ quan chỉ vì\Nđối thủ lần này là goblin đâu.
Dialogue: 1,0:01:42.33,0:01:46.71,Q2,,0,0,0,,Đôi khi vẫn xuất hiện những con goblin tinh ranh\Ncũng biết sử dụng cả ma pháp đấy.
Dialogue: 1,0:01:46.71,0:01:48.33,Q2,,0,0,0,,Chỉ cần có một tên như thế cầm đầu,
Dialogue: 1,0:01:48.33,0:01:51.17,Q2,,0,0,0,,cũng đủ gây ra mối đe dọa khiến cả tổ đội\Nhạng trung phải chật vật đối phó rồi.
Dialogue: 1,0:01:51.38,0:01:53.25,Q2,,0,0,0,,Tôi biết chuyện đó mà.
Dialogue: 1,0:01:53.25,0:01:55.96,Q2,,0,0,0,,Chỉ là tôi không chịu nổi cái kiểu ồn ào náo nhiệt của bọn chúng.
Dialogue: 1,0:01:56.29,0:02:00.54,Q2,,0,0,0,,Tôi cũng ghét cay ghét đắng lũ goblin,\Nvì ngày xưa biệt danh của tôi từng là "Goblin" đấy!
Dialogue: 1,0:02:00.54,0:02:02.63,Q2,,0,0,0,,Cậu đã làm cái quái gì mà bị đặt biệt danh đó vậy hả?
Dialogue: 1,0:02:07.75,0:02:09.29,Q2,,0,0,0,,Chúng kéo tới rồi kia!
Dialogue: 1,0:02:14.38,0:02:15.58,Q2,,0,0,0,,Hửm...?
Dialogue: 1,0:02:18.29,0:02:21.50,Q2,,0,0,0,,Đây lại là mánh khóe mới nhằm khiến bọn mình\Nmất cảnh giác rồi đánh úp à?
Dialogue: 1,0:02:21.50,0:02:24.29,Q2,,0,0,0,,Nhưng tụi nó lại tự động lộ diện luôn kìa.
Dialogue: 1,0:02:24.29,0:02:26.54,Q2,,0,0,0,,Để tôi phiên dịch giùm cho nhé.
Dialogue: 1,0:02:27.38,0:02:29.58,Q2,,0,0,0,,Hỡi người mang sừng,
Dialogue: 1,0:02:29.58,0:02:32.13,Q2,,0,0,0,,chúng thần đã mong ngóng ngài từ lâu.
Dialogue: 1,0:02:32.13,0:02:34.33,Q2,,0,0,0,,Hỡi Nữ Thần của loài goblin!
Dialogue: 1,0:02:34.63,0:02:36.00,Q2,,0,0,0,,Người mang sừng?
Dialogue: 1,0:02:36.00,0:02:37.67,Q2,,0,0,0,,Nữ Thần của loài goblin á?
Dialogue: 1,0:02:47.88,0:02:50.04,Q2,,0,0,0,,Tình huống gì đây hả, thưa Nữ Thần?
Dialogue: 1,0:02:50.04,0:02:51.71,Q2,,0,0,0,,Đừng có gọi tôi là "Nữ Thần"!
Dialogue: 1,0:02:51.96,0:02:54.50,Q2,,0,0,0,,Là bọn chúng tự biên tự diễn hết đấy chứ.
Dialogue: 1,0:02:54.71,0:02:57.08,Q2,,0,0,0,,Bản thân tôi cũng mù tịt chẳng hiểu chuyện gì đang xảy ra đây này.
Dialogue: 1,0:02:57.08,0:02:58.88,Q2,,0,0,0,,Thần xin giải thích.
Dialogue: 1,0:03:00.67,0:03:02.38,Q2,,0,0,0,,Thưa Nữ Thần của chúng con...
Dialogue: 1,0:03:02.88,0:03:04.21,Q2,,0,0,0,,Pháp sư goblin à?!
Dialogue: 1,0:03:04.21,0:03:06.21,Q2,,0,0,0,,Lại còn nói được tiếng người nữa chứ?!
Dialogue: 1,0:03:06.21,0:03:09.92,Q2,,0,0,0,,Ở vùng đất này có lưu truyền một truyền thuyết từ ngàn xưa.
Dialogue: 1,0:03:09.92,0:03:15.63,Q2,,0,0,0,,Rằng Nữ Thần của loài goblin sẽ mang\Nhình hài con người và mọc sừng trên đầu.
Dialogue: 1,0:03:15.63,0:03:18.75,Q2,,0,0,0,,Ngài sẽ giá lâm nơi đây cùng sử ma kề bên.
Dialogue: 1,0:03:19.54,0:03:23.17,Q2,,0,0,0,,Ngài giống hệt như lời truyền thuyết miêu tả,
Dialogue: 1,0:03:23.17,0:03:27.58,Q2,,0,0,0,,chính là vị Nữ Thần sẽ dẫn dắt tộc chúng con.
Dialogue: 1,0:03:28.04,0:03:30.46,Q2,,0,0,0,,Amona, hóa ra cậu là nữ thần thật à?!
Dialogue: 1,0:03:30.46,0:03:31.96,Q2,,0,0,0,,Đã bảo không phải rồi mà!
Dialogue: 1,0:03:31.96,0:03:34.13,Q2,,0,0,0,,Mà sao cậu cũng hùa theo bọn chúng thế hả?!
Dialogue: 1,0:03:34.46,0:03:36.00,Q2,,0,0,0,,Ấy chớ, bình tĩnh nào.
Dialogue: 1,0:03:36.00,0:03:39.04,Q2,,0,0,0,,Không cần phải gay gắt thế đâu, thưa Chủ nhân.
Dialogue: 1,0:03:39.04,0:03:41.50,Q2,,0,0,0,,Sao cô cứ thản nhiên để bọn chúng\Ntôn sùng mình thế hả?!
Dialogue: 1,0:03:41.83,0:03:45.17,Q2,,0,0,0,,Làm Nữ Thần của loài goblin cũng đâu tệ đâu.
Dialogue: 1,0:03:45.17,0:03:47.83,Q2,,0,0,0,,Chẳng phải ban nãy cô vừa bảo ghét lũ goblin còn gì?
Dialogue: 1,0:03:47.83,0:03:50.38,Q2,,0,0,0,,Thì cứ bình tâm suy nghĩ kỹ lại một chút xem.
Dialogue: 1,0:03:50.38,0:03:51.29,Q2,,0,0,0,,Hửm?
Dialogue: 1,0:03:51.29,0:03:55.71,Q2,,0,0,0,,Nếu trở thành Nữ Thần, cô sẽ nghiễm nhiên\Nđược tôn làm thủ lĩnh tối cao của cả bầy goblin.
Dialogue: 1,0:03:55.71,0:03:56.92,Q2,,0,0,0,,Nói cách khác...
Dialogue: 1,0:03:56.92,0:03:57.79,Q4,,0,0,0,,Ôi trời ơi, mấy bé goblin đáng yêu!
Dialogue: 1,0:03:57.79,0:03:58.58,Q4,,0,0,0,,Ôi trời ơi, mấy bé goblin đáng yêu!
Dialogue: 1,0:03:57.79,0:03:58.58,Q2,,0,0,0,,Cô sẽ trở thành nàng công chúa độc nhất\Ngiữa bầy đực rựa loài goblin
Dialogue: 1,0:03:58.58,0:04:00.54,Q4,,0,0,0,,Cố lên vì chị nhé, mấy cưng ơi!
Dialogue: 1,0:03:58.58,0:04:00.54,Q2,,0,0,0,,Cô sẽ trở thành nàng công chúa độc nhất\Ngiữa bầy đực rựa loài goblin
Dialogue: 1,0:04:00.54,0:04:01.75,Q4,,0,0,0,,Cố lên vì chị nhé, mấy cưng ơi!
Dialogue: 1,0:04:00.54,0:04:01.75,Q2,,0,0,0,,và xoay cả lũ chúng nó như chong chóng\Ntrong lòng bàn tay đấy!
Dialogue: 1,0:04:01.75,0:04:02.63,Q2,,0,0,0,,và xoay cả lũ chúng nó như chong chóng\Ntrong lòng bàn tay đấy!
Dialogue: 1,0:04:02.63,0:04:04.29,Q2,,0,0,0,,Nghe tởm lợm muốn ói luôn ấy!
Dialogue: 1,0:04:04.79,0:04:07.50,Q2,,0,0,0,,Chưa hết, nếu thu phục được thêm\Ncác bầy goblin khác đi theo nữa,
Dialogue: 1,0:04:07.50,0:04:10.21,Q2,,0,0,0,,cô sẽ ngăn chặn hoàn toàn việc chúng\Nlàm hại con người đấy.
Dialogue: 1,0:04:10.21,0:04:12.54,Q2,,0,0,0,,Tình yêu và hòa bình muôn năm!
Dialogue: 1,0:04:12.54,0:04:15.25,Q2,,0,0,0,,Này, tụi mình tới đây để tiêu diệt goblin đấy,
Dialogue: 1,0:04:15.25,0:04:17.92,Q2,,0,0,0,,nếu không hạ bọn chúng thì lấy đâu ra tiền thưởng.
Dialogue: 1,0:04:21.33,0:04:23.88,Q2,,0,0,0,,À thì, chắc cũng tạm ổn miễn là\Nkhông để ai phát hiện ra.
Dialogue: 1,0:04:23.88,0:04:25.79,Q2,,0,0,0,,Thế mà cũng thuyết phục được cậu luôn á?!
Dialogue: 1,0:04:25.79,0:04:28.96,Q2,,0,0,0,,Amona! Sao cô lại dễ dàng bị lũ goblin\Nlấy lòng thế hả?!
Dialogue: 1,0:04:28.96,0:04:32.38,Q2,,0,0,0,,Biết rồi, biết rồi. Tôi chỉ đùa tí thôi mà.
Dialogue: 1,0:04:32.75,0:04:36.33,Q2,,0,0,0,,Được bầy goblin ái mộ thì có ích quái gì đâu chứ. Thật là...
Dialogue: 1,0:04:37.00,0:04:38.75,Q2,,0,0,0,,Ý anh muốn nói là...
Dialogue: 1,0:04:38.75,0:04:42.25,Q2,,0,0,0,,bộ tôi chỉ có thể mê hoặc nổi lũ goblin thôi chứ gì?
Dialogue: 1,0:04:42.25,0:04:44.58,Q2,,0,0,0,,À, không! Tôi hoàn toàn không có ý đó...
Dialogue: 1,0:04:44.83,0:04:49.67,Q2,,0,0,0,,Tôi thừa biết mình chẳng thể nào nổi tiếng nổi,\Nvì dù sao tôi cũng là người tộc Shin mà.
Dialogue: 1,0:04:50.08,0:04:53.08,Q2,,0,0,0,,Chứ nếu không có cặp sừng với đôi mắt bình thường,\Nchắc tôi cũng đắt hàng lắm đấy.
Dialogue: 1,0:04:53.08,0:04:56.04,Q2,,0,0,0,,K-Không, kể cả giữ nguyên như bây giờ\Ncô vẫn rất được yêu thích mà!
Dialogue: 1,0:04:56.04,0:04:57.58,Q2,,0,0,0,,Chí ít là đối với tôi là thế!
Dialogue: 1,0:04:57.58,0:04:58.67,Q2,,0,0,0,,Hả?!
Dialogue: 1,0:05:01.33,0:05:04.33,Q2,,0,0,0,,N-Nếu chỉ có mỗi một người thôi\Nthì đâu có tính là nổi tiếng chứ!
Dialogue: 1,0:05:04.33,0:05:06.54,Q2,,0,0,0,,Mà "chí ít là với tôi" là có ý gì hả?!
Dialogue: 1,0:05:06.54,0:05:07.83,Q2,,0,0,0,,X-Xin lỗi...
Dialogue: 1,0:05:09.33,0:05:10.33,Q4,,0,0,0,,Tức là anh định bảo
Dialogue: 1,0:05:10.33,0:05:10.75,Q2,,0,0,0,,Loài goblin vốn sở hữu khứu giác cực kỳ nhạy bén,
Dialogue: 1,0:05:10.33,0:05:10.75,Q4,,0,0,0,,Tức là anh định bảo
Dialogue: 1,0:05:10.75,0:05:12.54,Q2,,0,0,0,,Loài goblin vốn sở hữu khứu giác cực kỳ nhạy bén,
Dialogue: 1,0:05:10.75,0:05:12.54,Q4,,0,0,0,,ngoài anh ra thì chả ma nào thèm để ý tới tôi chứ gì?!
Dialogue: 1,0:05:12.54,0:05:17.46,Q2,,0,0,0,,và mùi hương đậm đặc vừa tỏa ra đó\Nđã kích thích phản ứng cực mạnh từ chúng!
Dialogue: 1,0:05:21.00,0:05:22.08,Q2,,0,0,0,,Hắc Triệu Hồi Sư.
Dialogue: 1,0:05:25.13,0:05:26.04,Q2,,0,0,0,,Sau khi trở thành công chúa độc nhất,\NAmona chính thức nắm quyền chỉ huy bầy goblin.
Dialogue: 1,0:05:26.04,0:05:27.88,Q2,,0,0,0,,Sau khi trở thành công chúa độc nhất,\NAmona chính thức nắm quyền chỉ huy bầy goblin.
Dialogue: 1,0:05:26.04,0:05:27.88,Q4,,0,0,0,,Nào, các cưng ơi!
Dialogue: 1,0:05:27.88,0:05:28.88,Q2,,0,0,0,,Sau khi trở thành công chúa độc nhất,\NAmona chính thức nắm quyền chỉ huy bầy goblin.
Dialogue: 1,0:05:28.88,0:05:29.33,Q2,,0,0,0,,Sau khi trở thành công chúa độc nhất,\NAmona chính thức nắm quyền chỉ huy bầy goblin.
Dialogue: 1,0:05:28.88,0:05:29.33,Q4,,0,0,0,,Cùng hô theo chị nào!
Dialogue: 1,0:05:29.33,0:05:31.21,Q2,,0,0,0,,Giờ đây nàng được tôn vinh làm thần tượng,\NLovely Amona,
Dialogue: 1,0:05:29.33,0:05:31.21,Q4,,0,0,0,,Cùng hô theo chị nào!
Dialogue: 1,0:05:31.21,0:05:32.29,Q2,,0,0,0,,Giờ đây nàng được tôn vinh làm thần tượng,\NLovely Amona,
Dialogue: 1,0:05:32.29,0:05:34.21,Q2,,0,0,0,,đưa nàng tiến sát ngưỡng cửa bá chủ thiên hạ!
Dialogue: 1,0:05:34.21,0:05:35.50,Q2,,0,0,0,,Ngừng ngay việc tung tin đồn nhảm đi!
Dialogue: 1,0:05:35.50,0:05:37.17,Q2,,0,0,0,,Mà "Lovely Amona" là cái danh hiệu khỉ gì thế hả?!
Dialogue: 1,0:05:37.17,0:05:38.42,Q2,,0,0,0,,À...
Dialogue: 1,0:05:38.79,0:05:42.54,Q2,,0,0,0,,Tôi cóc quan tâm mình là Nữ Thần goblin\Nhay mỹ nữ kỳ dị hay cái quái gì khác.
Dialogue: 1,0:05:42.54,0:05:43.67,Q2,,0,0,0,,Khoan đã, cô vừa tự chế thêm biệt danh đấy à?
Dialogue: 1,0:05:43.67,0:05:46.38,Q2,,0,0,0,,Tôi chẳng rảnh hơi đâu mà làm theo\Nmấy lời nhảm nhí của lũ goblin!
Dialogue: 1,0:05:46.38,0:05:48.75,Q2,,0,0,0,,Xử gọn bọn chúng cho lẹ rồi kết thúc vụ này thôi!
Dialogue: 1,0:05:48.75,0:05:49.38,Q2,,0,0,0,,Hửm?
Dialogue: 1,0:05:50.42,0:05:53.25,Q2,,0,0,0,,Gì thế này? Lũ goblin tự dưng cãi nhau ỏm tỏi kìa!
Dialogue: 1,0:05:53.83,0:05:58.75,Q2,,0,0,0,,Chẳng lẽ trong bầy lại có phe đối lập\Nkhông chịu tôn Amona làm Nữ Thần sao?
Dialogue: 1,0:05:58.75,0:06:02.17,Q2,,0,0,0,,Thật nực cười. Tự chúng nó tôn tôi lên\Nrồi giờ lại quay ra lật kèo à.
Dialogue: 1,0:06:02.17,0:06:04.25,Q2,,0,0,0,,Imp, phiên dịch xem tụi nó cãi gì thế.
Dialogue: 1,0:06:04.25,0:06:06.88,Q2,,0,0,0,,Vâng. Để xem nào...
Dialogue: 1,0:06:07.17,0:06:10.17,Q2,,0,0,0,,Nữ Thần nhất định phải còn trinh tiết!\NCấm tiệt chuyện hẹn hò với thằng nào hết!
Dialogue: 1,0:06:10.17,0:06:12.04,Q2,,0,0,0,,Còn trinh hay mất trinh thì quan trọng quái gì chứ!
Dialogue: 1,0:06:12.04,0:06:13.92,Q2,,0,0,0,,Ta tôn trọng quyền riêng tư của ngài ấy!
Dialogue: 1,0:06:16.42,0:06:19.96,Q2,,0,0,0,,Mày chấp nhận nổi cảnh Nữ Thần\Nđi cặp kè hú hí với một thằng đực rựa à?!
Dialogue: 1,0:06:19.96,0:06:22.21,Q2,,0,0,0,,Chỉ cần Nữ Thần thấy hạnh phúc là đủ rồi!
Dialogue: 1,0:06:22.21,0:06:24.92,Q2,,0,0,0,,Bớt bốc phét giả tạo lại đi!\NMày đang tự lừa dối bản thân đấy à!
Dialogue: 1,0:06:25.25,0:06:28.58,Q2,,0,0,0,,Nghe đâu bọn chúng đang tranh cãi nảy lửa đầy thô bỉ\Nvề độ "còn zin" làm thần tượng của cô đấy.
Dialogue: 1,0:06:29.42,0:06:32.04,Q2,,0,0,0,,Ta vẫn tin tưởng tuyệt đối vào Nữ Thần\Ndù ngài ấy có còn trong trắng hay không!
Dialogue: 1,0:06:32.04,0:06:35.75,Q2,,0,0,0,,Lũ tụi bay lo chuyện trinh tiết\Ncòn hơn cả thần tính của ngài ấy à!
Dialogue: 1,0:06:35.75,0:06:38.83,Q2,,0,0,0,,Chuyện muốn thần tượng của mình còn zin\Nlà lẽ thường tình đương nhiên thôi chứ!
Dialogue: 1,0:06:38.83,0:06:43.00,Q2,,0,0,0,,Tụi bay chỉ đang nhắm mắt làm ngơ trước sự thật\Nvì sợ hãi ngài ấy đã bị vấy bẩn rồi thôi!
Dialogue: 1,0:06:43.00,0:06:45.13,Q2,,0,0,0,,Tự dưng vốn từ vựng của tụi nó phong phú hẳn lên thế?
Dialogue: 1,0:06:45.42,0:06:47.46,Q2,,0,0,0,,Tởm lợm hết sức, ngừng phiên dịch ngay đi!
Dialogue: 1,0:06:47.46,0:06:49.92,Q2,,0,0,0,,Trinh tiết là cái gì thế? Thứ đó quan trọng lắm hả?
Dialogue: 1,0:06:50.42,0:06:53.83,Q2,,0,0,0,,Tất cả trật tự nào!
Dialogue: 1,0:06:54.92,0:06:59.38,Q2,,0,0,0,,Sự trong trắng của Nữ Thần không phải chuyện\Nđể đám chúng ta mang ra bàn tán!
Dialogue: 1,0:06:59.38,0:07:03.00,Q2,,0,0,0,,Vả lại, chỉ là trí tưởng tượng của tụi bay\Nđang bay cao bay xa quá mức thôi!
Dialogue: 1,0:07:04.83,0:07:07.96,Q2,,0,0,0,,Xin thứ lỗi cho sự vô lễ này, thưa Nữ Thần.
Dialogue: 1,0:07:07.96,0:07:12.71,Q2,,0,0,0,,Dám thốt ra lời lẽ vô căn cứ,\Nvu khống ngài không còn trong trắng nữa...
Dialogue: 1,0:07:23.96,0:07:25.25,Q2,,0,0,0,,Trưởng lão!
Dialogue: 1,0:07:26.67,0:07:29.63,Q2,,0,0,0,,Ngươi bốc mùi quan hệ xác thịt dâm ô nồng nặc!
Dialogue: 1,0:07:29.63,0:07:32.04,Q2,,0,0,0,,Tên dê xồm dám làm vấy bẩn Nữ Thần của chúng ta!
Dialogue: 1,0:07:32.04,0:07:34.25,Q2,,0,0,0,,Lật mặt nhanh như chớp luôn vậy đó hả?!
Dialogue: 1,0:07:34.25,0:07:37.21,Q2,,0,0,0,,Để bảo vệ Nữ Thần,
Dialogue: 1,0:07:37.21,0:07:40.79,Q2,,0,0,0,,chúng ta phải kéo ngài ấy tránh xa khỏi\Ntên khốn bẩn thỉu này!
Dialogue: 1,0:07:43.00,0:07:45.25,Q2,,0,0,0,,Đông tới mức này cơ á?!
Dialogue: 1,0:07:45.25,0:07:48.33,Q2,,0,0,0,,Này, dừng lại hết coi! Đây là mệnh lệnh đấy!
Dialogue: 1,0:07:48.67,0:07:50.83,Q2,,0,0,0,,Im lặng! Ta bảo tất cả im lặng!
Dialogue: 1,0:07:50.83,0:07:52.92,Q2,,0,0,0,,Lũ goblin vô phép tắc này!
Dialogue: 1,0:07:53.00,0:07:54.29,Q2,,0,0,0,,Imp?!
Dialogue: 1,0:07:54.67,0:07:57.42,Q2,,0,0,0,,Xem ra các ngươi đang phẫn nộ chuyện Chủ nhân\Nân ái mặn nồng với một gã đàn ông mờ ám lai lịch...
Dialogue: 1,0:07:57.42,0:07:59.96,Q2,,0,0,0,,với một gã đàn ông chẳng rõ gốc gác ra sao...
Dialogue: 1,0:07:59.96,0:08:02.08,Q2,,0,0,0,,Tuy nhiên, các ngươi đã lầm to rồi!
Dialogue: 1,0:08:02.08,0:08:04.79,Q2,,0,0,0,,Hãy để ta khai sáng cho các ngươi!
Dialogue: 1,0:08:05.04,0:08:07.83,Q2,,0,0,0,,Nào, xin mời thưởng thức đoạn thước phim này.
Dialogue: 1,0:08:07.83,0:08:08.96,Q2,,0,0,0,,Thước phim á?!
Dialogue: 1,0:08:11.79,0:08:13.33,Q2,,0,0,0,,Ngồi xuống đi.
Dialogue: 1,0:08:13.33,0:08:14.88,Q2,,0,0,0,,Em có muốn uống chút gì không?
Dialogue: 1,0:08:14.88,0:08:16.96,Q2,,0,0,0,,E-Em không khát.
Dialogue: 1,0:08:19.79,0:08:24.08,Q2,,0,0,0,,Nãy em mới mua bộ này.\NAnh thấy sao?
Dialogue: 1,0:08:24.08,0:08:25.25,Q2,,0,0,0,,A-Amona!
Dialogue: 1,0:08:25.25,0:08:27.00,Q2,,0,0,0,,Đ-Đồ ngốc này! Em ôm sát quá rồi đấy!
Dialogue: 1,0:08:29.92,0:08:31.92,Q2,,0,0,0,,Cái quái quỷ gì thế kia hả?!
Dialogue: 1,0:08:32.21,0:08:35.71,Q2,,0,0,0,,Thần tượng của các ngươi có quấn quýt\Nlăn giường với ai thì có sao đâu nhỉ?
Dialogue: 1,0:08:35.71,0:08:37.67,Q2,,0,0,0,,Vì chỉ cần tụi bay xem ké mà thấy sướng là được,
Dialogue: 1,0:08:37.67,0:08:39.17,Q2,,0,0,0,,đôi bên cùng có lợi còn gì nữa!
Dialogue: 1,0:08:39.17,0:08:40.42,Q2,,0,0,0,,Ác quỷ thuần túy!
Dialogue: 1,0:08:40.42,0:08:43.46,Q2,,0,0,0,,Thấy chưa! Ngay cả lũ goblin cũng thấy phát tởm rồi kìa!
Dialogue: 1,0:08:46.08,0:08:49.04,Q2,,0,0,0,,Ả nhân loại kia không phải Nữ Thần...
Dialogue: 1,0:08:49.04,0:08:52.13,Q2,,0,0,0,,Chúng ta tin vào truyền thuyết bao nhiêu năm qua,
Dialogue: 1,0:08:52.13,0:08:54.67,Q2,,0,0,0,,nhưng chẳng hề có sự cứu rỗi nào tới cả...
Dialogue: 1,0:09:00.96,0:09:03.75,Q2,,0,0,0,,Hãy lui vào sâu trong rừng mà sống yên bình đi.
Dialogue: 1,0:09:03.75,0:09:06.96,Q2,,0,0,0,,Và đừng bao giờ xuất hiện trước mặt loài người nữa.
Dialogue: 1,0:09:06.96,0:09:09.83,Q2,,0,0,0,,Này Haru, đừng có đi thương cảm\Nvới lũ quái vật chứ.
Dialogue: 1,0:09:09.83,0:09:14.71,Q2,,0,0,0,,Nhưng bọn chúng cũng có cuộc sống riêng,\Nvà cũng có vị thần để tin theo mà.
Dialogue: 1,0:09:15.00,0:09:19.67,Q2,,0,0,0,,Nghĩ theo hướng đó thì tớ chẳng thể\Nxem chúng như quái vật bình thường được nữa.
Dialogue: 1,0:09:19.67,0:09:23.38,Q2,,0,0,0,,Ít nhất thì tụi mình có thể tha mạng\Ncho bọn chúng được không?
Dialogue: 1,0:09:23.38,0:09:24.25,Q2,,0,0,0,,Với lại...
Dialogue: 1,0:09:24.67,0:09:27.00,Q2,,0,0,0,,Cậu giải thích giùm tớ được không?
Dialogue: 1,0:09:27.88,0:09:30.50,Q2,,0,0,0,,Trinh tiết là cái gì thế?
Dialogue: 1,0:09:37.25,0:09:41.25,Q2,,0,0,0,,Nữ Thần chân chính đây rồi! Đấng cứu thế của chúng ta!
Dialogue: 1,0:09:41.25,0:09:43.38,Q2,,0,0,0,,Thân thể của ngài ấy thật tinh khôi và thuần khiết!
Dialogue: 1,0:09:43.38,0:09:45.08,Q2,,0,0,0,,Chứ chẳng phải hàng qua tay như ả trước kia đâu!
Dialogue: 1,0:09:45.08,0:09:46.38,Q2,,0,0,0,,Ghét nhất cái thứ hàng dùng rồi!
Dialogue: 1,0:09:45.08,0:09:46.38,Q4,,0,0,0,,Vẫn còn zin nguyên vẹn!
Dialogue: 1,0:09:46.38,0:09:48.04,Q2,,0,0,0,,Thuần khiết là chân ái!
Dialogue: 1,0:10:00.83,0:10:05.33,Q2,,0,0,0,,Kể từ ngày hôm ấy, bầy goblin trong khu rừng\Nđã biến mất không còn tăm hơi.
Dialogue: 1,0:10:05.83,0:10:09.08,Q2,,0,0,0,,C-Cửa hàng quái nào lại bán mấy bộ đồ kiểu này vậy?!
Dialogue: 1,0:10:09.38,0:10:11.42,Q2,,0,0,0,,Chỗ nào bán thì quan trọng gì chứ?
Dialogue: 1,0:10:11.42,0:10:15.08,Q2,,0,0,0,,Anh không còn câu nào khác để khen em sao?
Dialogue: 1,0:10:15.08,0:10:17.46,Q2,,0,0,0,,C-Có chứ! Em đẹp tuyệt trần luôn!
Dialogue: 1,0:10:17.46,0:10:18.83,Q2,,0,0,0,,Thôi nào...
Dialogue: 1,0:10:20.33,0:10:23.75,Q2,,0,0,0,,chỗ cộm lên trong quần của anh đây\Nlại đang nói lên điều khác kìa.
Dialogue: 1,0:10:23.96,0:10:27.42,Q2,,0,0,0,,Tại anh toàn bắt em mặc mấy bộ\Nchẳng khác nào không mặc gì cả mà.
Dialogue: 1,0:10:29.00,0:10:31.58,Q2,,0,0,0,,G-Gợi cảm chết mất!
Dialogue: 1,0:10:32.46,0:10:35.08,Q2,,0,0,0,,Amona, em đúng là quá đỗi dâm đãng luôn đấy!
Dialogue: 1,0:10:35.38,0:10:38.58,Q2,,0,0,0,,Lúc nào anh cũng phát điên vì em cả!
Dialogue: 1,0:10:41.38,0:10:43.88,Q2,,0,0,0,,Anh chẳng tài nào ngừng nhìn em\Nbằng ánh mắt dục vọng được!
Dialogue: 1,0:10:44.33,0:10:46.50,Q2,,0,0,0,,Đ-Đủ rồi đấy!
Dialogue: 1,0:10:46.50,0:10:48.38,Q2,,0,0,0,,Tập trung vào chuyện chính đi!
Dialogue: 1,0:10:55.29,0:10:58.92,Q2,,0,0,0,,Ta bắt trọn được khoảnh khắc đắt giá quá nhỉ?
Dialogue: 1,0:10:59.13,0:11:00.54,Q2,,0,0,0,,Xóa ngay lập tức!
Dialogue: 1,0:11:07.58,0:11:09.75,Q0,,0,0,0,,Yêu hay là ghét? Em cũng chẳng rõ nữa
Dialogue: 1,0:11:09.75,0:11:11.88,Q0,,0,0,0,,Em đang khao khát điều chi?\NEm chỉ muốn mãi được ở bên cạnh anh
Dialogue: 1,0:11:11.88,0:11:15.88,Q0,,0,0,0,,Chẳng bao giờ muốn buông lơi hơi ấm dịu dàng ấy
Dialogue: 1,0:11:16.83,0:11:21.29,Q0,,0,0,0,,Vẫn còn quá sớm ư? Em muốn được thấy anh,\Nmuốn thấu hiểu những cảm xúc chất chứa này
Dialogue: 1,0:11:21.29,0:11:24.71,Q0,,0,0,0,,Nhưng lúc này vẫn chưa phải lúc trao nhau nụ hôn
Dialogue: 1,0:11:26.21,0:11:28.46,Q0,,0,0,0,,Liệu hai đứa mình cứ mãi như thế này có được không?
Dialogue: 1,0:11:28.46,0:11:30.79,Q0,,0,0,0,,Chỉ chạm khẽ vào nhau thôi há chẳng đủ sao?
Dialogue: 1,0:11:30.79,0:11:34.79,Q0,,0,0,0,,Em đã ôm trọn lấy anh trong khoảnh khắc ấm áp đôi ta cùng sẻ chia
Dialogue: 1,0:11:36.25,0:11:42.00,Q0,,0,0,0,,Em muốn có được anh, muốn tất cả thuộc về mình, và vì thế
Dialogue: 1,0:11:42.00,0:11:45.00,Q0,,0,0,0,,Em hoàn toàn bằng lòng yêu anh
Dialogue: 1,0:11:45.54,0:11:51.38,Q0,,0,0,0,,Chẳng phải ai khác, chỉ riêng anh thôi, dẫu chẳng thể thốt nên lời
Dialogue: 1,0:11:51.38,0:11:54.96,Q0,,0,0,0,,Em đã chôn giấu tiếng yêu sâu tận trong đáy lòng
Dialogue: 1,0:11:54.96,0:12:00.83,Q0,,0,0,0,,Một ngày nào đó em sẽ nói ra, nhưng giờ đây đó vẫn là bí mật của riêng em
Dialogue: 0,0:01:02.25,0:01:06.92,Q1,,0,0,0,,{\pos(486.4,604.8)}{\an7}Tập 7: Hắc Triệu Hồi Sư Và Công Chúa Độc Nhất
Dialogue: 0,0:01:21.08,0:01:23.50,Q3,,0,0,0,,{\pos(460.8,417.6)}{\an7}Vài giờ trước đó
Dialogue: 0,0:06:36.71,0:06:45.13,Q5,,0,0,0,,{\pos(601.6,180)}{\an7}Phản đối!
Dialogue: 0,0:07:48.67,0:07:52.92,Q6,,0,0,0,,{\pos(486.4,475.2)}{\an7}Dâm Loạn

