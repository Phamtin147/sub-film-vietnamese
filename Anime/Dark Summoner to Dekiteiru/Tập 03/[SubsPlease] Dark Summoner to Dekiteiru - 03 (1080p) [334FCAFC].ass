Dialogue: 0,0:08:31.79,0:08:34.46,Q5,,0,0,0,,{\pos(102.4,108)}{\an7}Hình Minh Họa Trừu Tượng
Dialogue: 0,0:08:31.79,0:08:34.46,Q5,,0,0,0,,{\pos(780.8,158.4)}{\an7}Khô héo
Dialogue: 0,0:08:31.79,0:08:34.46,Q5,,0,0,0,,{\pos(947.2,475.2)}{\an7}Khô queo

