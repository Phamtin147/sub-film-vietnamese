Dialogue: 0,0:00:00.83,0:00:04.26,Narrator,Narrator,0,0,0,,Anh hùng. Những chiến binh vì chính nghĩa.
Dialogue: 0,0:00:02.42,0:00:04.26,Top,Hero,0,0,0,,Ta đã tới đây!
Dialogue: 0,0:00:04.26,0:00:08.39,Narrator,Narrator,0,0,0,,Những siêu nhân bảo vệ người dân\Nbằng sức mạnh vượt xa lẽ thường.
Dialogue: 0,0:00:09.52,0:00:11.49,Narrator,Narrator,0,0,0,,Thế nhưng trên thế giới rộng lớn này,
Dialogue: 0,0:00:11.49,0:00:15.74,Narrator,Narrator,0,0,0,,có những kẻ chẳng bảo vệ New York\Ncũng chẳng đánh đuổi quái vật ngoài hành tinh.
Dialogue: 0,0:00:10.51,0:00:12.28,Top,Hero,0,0,0,,Hạ Đẳng Quyền!
Dialogue: 0,0:00:16.14,0:00:18.88,Narrator,Narrator,0,0,0,,Một anh hùng như thế đang hoạt động\Ntừ một bốt cảnh sát xó xỉnh.
Dialogue: 0,0:00:18.88,0:00:20.12,Narrator,Narrator,0,0,0,,Tên của anh ta là...
Dialogue: 0,0:00:15.74,0:00:20.12,Default,Sign,0,0,0,,{\an8}TRỤ SỞ CẢNH SÁT CHINJUKU
Dialogue: 0,0:00:20.12,0:00:23.75,Default,Sign,0,0,0,,{\an8}PHÒNG TRƯỞNG ĐỒN (BÊN TRONG)
Dialogue: 0,0:00:20.91,0:00:23.75,Default,Chief,0,0,0,,Tôi nói thẳng luôn nhé, Chojo.
Dialogue: 0,0:00:24.18,0:00:25.88,Default,Chief,0,0,0,,Chẳng ai ưa cậu cả.
Dialogue: 0,0:00:28.15,0:00:29.34,Default,Chojo,0,0,0,,Sếp muốn gây sự à?
Dialogue: 0,0:00:30.63,0:00:32.53,Default,Chief,0,0,0,,Không, tôi đang trình bày thực tế thôi.
Dialogue: 0,0:00:32.53,0:00:34.89,Default,Chief,0,0,0,,Cậu có thấy dư luận đánh giá cậu thế nào không?
Dialogue: 0,0:00:34.89,0:00:37.76,Default,Chief,0,0,0,,Vào ngày đẹp trời nhất thì cậu cũng chỉ được\Nưa chuộng ngang một vết thương nhiễm trùng thôi.
Dialogue: 0,0:00:38.16,0:00:41.97,Default,Chief,0,0,0,,Đã xác định là cậu đọc được suy nghĩ người khác rồi,\Nnên tôi cũng nói toạc ra luôn.
Dialogue: 0,0:00:42.66,0:00:45.40,Default,Chief,0,0,0,,Cá nhân tôi cũng chẳng ưa nổi cậu đâu.
Dialogue: 0,0:00:45.40,0:00:48.73,Default,Chief,0,0,0,,Cậu mà hy sinh khi làm nhiệm vụ, tôi sẽ coi đó\Nlà cơ hội kiếm đạo cụ diễn hài cực chất luôn đấy.
Dialogue: 0,0:00:49.19,0:00:50.82,Flashback,Chief,0,0,0,,Cạn ly!
Dialogue: 0,0:00:48.98,0:00:52.49,Default,Sign,0,0,0,,{\an8}LÀM TỪ HỘP SỌ CỦA CHOJO
Dialogue: 0,0:00:50.82,0:00:52.49,Default,Chojo,0,0,0,,Tôn trọng người đã khuất chút đi chứ.
Dialogue: 0,0:00:52.49,0:00:54.62,Default,Chojo,0,0,0,,Rốt cuộc hôm nay gọi tôi lên đây làm gì thế?
Dialogue: 0,0:00:54.62,0:00:57.49,Default,Chojo,0,0,0,,Giờ sếp tính lên lớp bắt tôi sống chan hòa hơn\Nvới đồng nghiệp {\i1}nữa{\i0} chắc?
Dialogue: 0,0:00:57.49,0:01:00.62,Default,Chief,0,0,0,,Nếu chỉ có nội bộ cảnh sát với nhau thôi\Nthì đã đành một nhẽ.
Dialogue: 0,0:01:00.62,0:01:02.63,Default,Chief,0,0,0,,Nhưng vấn đề ở đây là hình ảnh trước công chúng.
Dialogue: 0,0:01:03.10,0:01:06.12,Default,Chief,0,0,0,,Đơn khiếu nại gửi về mỗi lần cậu\Nnhúng tay vào việc gì đó...
Dialogue: 0,0:01:06.12,0:01:08.88,Default,Sign,0,0,0,,{\an8}TẨY CHAY CHOJO
Dialogue: 0,0:01:06.50,0:01:08.88,Default,Chief,0,0,0,,Tổng đài điện thoại từng sập nguồn mấy bận rồi đấy.
Dialogue: 0,0:01:09.26,0:01:12.88,Default,Chief,0,0,0,,Thú thật là cậu càng chăm làm việc bao nhiêu\Nthì rắc rối đẻ ra càng nhiều bấy nhiêu.
Dialogue: 0,0:01:13.28,0:01:16.22,Default,Chojo,0,0,0,,Nếu sếp muốn tôi ngồi yên ngoan ngoãn\Nlắp mô hình trong đồn suốt ngày thì...
Dialogue: 0,0:01:16.22,0:01:17.34,Default,Nao,0,0,0,,Thôi ngay đi.
Dialogue: 0,0:01:17.34,0:01:23.27,Default,Nao,0,0,0,,Tr-Trưởng đồn ơi, tôi sẵn lòng giúp tiền bối\Ncải thiện danh tiếng của anh ấy, nên là...
Dialogue: 0,0:01:23.60,0:01:28.52,Default,Chief,0,0,0,,Chưa đủ. Quên chuyện cải thiện đi.\NTôi muốn làm lại từ con số không.
Dialogue: 0,0:01:29.01,0:01:30.40,Default,Chief,0,0,0,,Ví dụ như thế này...
Dialogue: 0,0:01:31.14,0:01:32.78,Default,Chojo,0,0,0,,Một kiểu mũ bảo hiểm kín mặt à?
Dialogue: 0,0:01:32.78,0:01:36.90,Default,Chief,0,0,0,,Trong thời gian tới, cậu sẽ tác nghiệp\Nvới khuôn mặt được che kín hoàn toàn.
Dialogue: 0,0:01:38.58,0:01:43.16,Default,Chief,0,0,0,,Tai tiếng tồi tệ của cậu đã đến mức\Ncản trở hiệu quả công việc rồi.
Dialogue: 0,0:01:43.51,0:01:46.96,Default,Chief,0,0,0,,Vậy nên thân phận viên cảnh sát tâm linh\Nbị ghét cay ghét đắng của cậu sẽ được giấu kín.
Dialogue: 0,0:01:46.96,0:01:50.04,Default,Chief,0,0,0,,Đây chính là màn tái sinh của cậu đấy, Chojo.
Dialogue: 0,0:01:50.36,0:01:54.80,Default,Chief,0,0,0,,Cậu sẽ bảo vệ Chinjuku\Ndưới danh nghĩa một cảnh sát đeo mặt nạ đúng nghĩa.
Dialogue: 0,0:01:55.65,0:01:57.68,Default,Chojo,0,0,0,,Cảnh sát đeo mặt nạ á?
Dialogue: 0,0:01:58.06,0:02:02.08,Default,Chief,0,0,0,,Nao, quyết định này là tuyệt mật,\Nkể cả trong nội bộ ngành cảnh sát.
Dialogue: 0,0:02:02.08,0:02:03.81,Default,Chief,0,0,0,,Vì vậy hãy giữ kín chuyện này nhé.
Dialogue: 0,0:02:06.60,0:02:08.89,Default,Nao,0,0,0,,Trưởng đồn ra yêu cầu nghe điên rồ thật đấy.
Dialogue: 0,0:02:09.21,0:02:13.23,Default,Nao,0,0,0,,Ông ấy bắt tiền bối đeo mặt nạ đi làm\Nchỉ vì người dân ghét tiền bối thôi sao?
Dialogue: 0,0:02:13.23,0:02:18.53,Default,Nao,0,0,0,,Tôi hiểu ở Tây Chinjuku chẳng thể để anh lười biếng được.\NNhưng vụ che giấu danh tính này—
Dialogue: 0,0:02:18.53,0:02:21.82,Default,Chojo,0,0,0,,Xin lỗi nhé, Ippongi, cô để tôi\Nngồi một mình yên tĩnh chút được không?
Dialogue: 0,0:02:23.20,0:02:24.43,Default,Nao,0,0,0,,Tiền bối Chojo?
Dialogue: 0,0:02:25.16,0:02:29.29,Default,Sign,0,0,0,,{\an8}NGÀY HÔM SAU
Dialogue: 0,0:02:26.31,0:02:29.29,Default,Copbot,0,0,0,,Ngay cả với một người mặt dày như anh ấy,\Nchuyện đó hẳn cũng là cú sốc lớn.
Dialogue: 0,0:02:29.64,0:02:32.48,Default,Copbot,0,0,0,,Bị sếp chỉ thẳng mặt nói rằng bản thân\Nchẳng được ai ưa nổi cơ mà.
Dialogue: 0,0:02:32.48,0:02:34.17,Default,Nao,0,0,0,,Cậu nghĩ vậy sao?
Dialogue: 0,0:02:34.72,0:02:39.48,Default,Copbot,0,0,0,,Việc giữ bí mật ý tưởng đeo mặt nạ ngay cả trong nội bộ\Ncũng khiến tôi thấy khá kỳ quặc.
Dialogue: 0,0:02:39.48,0:02:44.31,Default,Copbot,0,0,0,,Tôi linh cảm đây chỉ là cái cớ để sau này\Ntrút hết mọi rắc rối lên đầu anh ấy thôi.
Dialogue: 0,0:02:44.69,0:02:47.52,Flashback,Chief,0,0,0,,Cảnh sát đeo mặt nạ á?\NTôi chưa nghe thấy bao giờ luôn.
Dialogue: 0,0:02:47.52,0:02:49.31,Narrator,Narrator,0,0,0,,Kẻ siêu năng lực tế thần.
Dialogue: 0,0:02:47.31,0:02:49.31,Default,Sign,0,0,0,,{\an8}KẺ SIÊU NĂNG LỰC TẾ THẦN
Dialogue: 0,0:02:49.75,0:02:53.74,Default,Nao,0,0,0,,Trời ơi. Bình thường tiền bối đã dễ tụt mood rồi,\Ngiờ chắc đang suy sụp thê thảm nhất từ trước tới nay mất.
Dialogue: 0,0:02:53.74,0:02:55.89,Default,Nao,0,0,0,,Tốt nhất là lát tiền bối tới mình phải\Nđộng viên tinh thần anh ấy mới được.
Dialogue: 0,0:02:55.89,0:02:57.44,Default,Chojo,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:02:57.44,0:03:00.26,Default,Nao,0,0,0,,T-Tiền bối Chojo? Anh có sao không vậy?
Dialogue: 0,0:03:00.26,0:03:01.66,Default,Chojo,0,0,0,,Sao lại hỏi có sao không?
Dialogue: 0,0:03:01.66,0:03:05.22,Default,Nao,0,0,0,,Thôi nào. Cái vụ bị Trưởng đồn\Nmắng xối xả hôm qua ấy.
Dialogue: 0,0:03:05.22,0:03:06.91,Default,Chojo,0,0,0,,À, vụ đó hả?
Dialogue: 0,0:03:07.81,0:03:10.02,Default,Chojo,0,0,0,,Công nhận lúc đầu cũng sốc thật đấy.
Dialogue: 0,0:03:10.57,0:03:12.90,Default,Chojo,0,0,0,,Thú thật cả đêm qua tôi trằn trọc không chợp mắt nổi.
Dialogue: 0,0:03:14.24,0:03:15.29,Default,Chojo,0,0,0,,Nhưng mà cô biết đấy...
Dialogue: 0,0:03:15.59,0:03:19.05,Default,Chojo,0,0,0,,Sau khi suy đi tính lại, tôi thấy\Nđi theo hướng {\i1}này{\i0} có vẻ ổn áp nhất.
Dialogue: 0,0:03:15.29,0:03:16.63,Default,Sign,0,0,0,,{\an8}CHIẾN ĐỘI CHINJUKU CHINRANGER\NKIỂU DÁNG CẢNH SÁT
Dialogue: 0,0:03:16.63,0:03:18.14,Default,Sign,0,0,0,,{\an8}TAI NGHE | CÓ THỂ BIẾN THÀNH SÚNG\NNHẢY CAO 25 MÉT! | CHẠY 100 MÉT TRONG 2 GIÂY!
Dialogue: 0,0:03:18.14,0:03:19.05,Default,Sign,0,0,0,,{\an8}TÔI CHẮC CHẮN LÀ CHIẾN BINH ĐỎ!\NKÍNH CHẮN DÁN PHIM TỐI MÀU
Dialogue: 0,0:03:19.05,0:03:20.68,Default,Nao,0,0,0,,Ủa, hướng "này" là hướng quái nào vậy?!
Dialogue: 0,0:03:20.68,0:03:25.56,Default,Sign,0,0,0,,{\an8}CHIẾN ĐỘI CHINJUKU CHINRANGER\NKIỂU DÁNG CẢNH SÁT
Dialogue: 0,0:03:21.31,0:03:24.03,Default,Nao,0,0,0,,"Chiến đội Chinjuku Chinranger" à?
Dialogue: 0,0:03:24.03,0:03:25.55,Default,Nao,0,0,0,,Cái thứ quái quỷ gì thế này?
Dialogue: 0,0:03:25.97,0:03:28.77,Default,Chojo,0,0,0,,Này nhé. Cô không nghe Trưởng đồn nói gì hôm qua sao?
Dialogue: 0,0:03:29.12,0:03:31.56,Default,Chojo,0,0,0,,Điều một: Che giấu danh tính.
Dialogue: 0,0:03:29.81,0:03:31.86,Default,Sign,0,0,0,,{\an8}1. CHE GIẤU DANH TÍNH
Dialogue: 0,0:03:31.86,0:03:33.57,Default,Sign,0,0,0,,{\an8}2. BẢO VỆ CHINJUKU
Dialogue: 0,0:03:31.56,0:03:33.56,Default,Chojo,0,0,0,,Điều hai: Bảo vệ Chinjuku.
Dialogue: 0,0:03:33.87,0:03:37.33,Default,Chojo,0,0,0,,Nói cách khác,\Nsếp muốn tôi làm Siêu anh hùng còn gì nữa.
Dialogue: 0,0:03:38.44,0:03:40.80,Default,Copbot,0,0,0,,Đứa trẻ bên trong tiền bối lại xổng chuồng nữa rồi.
Dialogue: 0,0:03:40.80,0:03:42.45,Default,Nao,0,0,0,,Thấy mình thật ngốc khi lo lắng cho anh ta.
Dialogue: 0,0:03:42.45,0:03:45.23,Default,Chojo,0,0,0,,Hai người cũng tham gia cùng nữa đấy.
Dialogue: 0,0:03:45.23,0:03:46.99,Default,Nao,0,0,0,,K-Khoan đã, tiền bối Chojo!
Dialogue: 0,0:05:17.33,0:05:19.96,Narrator,Narrator,0,0,0,,Tập 7: Tiền bối Tuần tra\NBiến hình.
Dialogue: 0,0:05:16.96,0:05:19.96,Default,Sign,0,0,0,,{\an8}TẬP 7: TIỀN BỐI TUẦN TRA\NBIẾN HÌNH
Dialogue: 0,0:05:20.32,0:05:21.67,Default,Maruyama,0,0,0,,Đứng lại!
Dialogue: 0,0:05:21.67,0:05:24.92,Default,Maruyama,0,0,0,,Đứng lại mau, tên cướp giật kia!
Dialogue: 0,0:05:25.97,0:05:28.18,Default,Purse-Snatcher,0,0,0,,Thằng ngu nào mới nghe lời đứng lại ấy!
Dialogue: 0,0:05:28.18,0:05:31.73,Default,Chojo,0,0,0,,Chin Quyền!
Dialogue: 0,0:05:34.99,0:05:36.44,Default,Maruyama,0,0,0,,Anh là ai thế?
Dialogue: 0,0:05:36.88,0:05:40.94,Default,Chojo,0,0,0,,Chúng ta làm cùng nghề cả mà.\NTôi nhường cô lập công bắt tên tội phạm này đấy.
Dialogue: 0,0:05:41.28,0:05:43.77,Default,Maruyama,0,0,0,,Cùng nghề á? Khoan đã, vậy anh là cảnh sát sao?
Dialogue: 0,0:05:43.77,0:05:45.69,Default,Maruyama,0,0,0,,Nh-Nhưng rốt cuộc anh {\i1}là{\i0} ai thế?
Dialogue: 0,0:05:46.13,0:05:48.66,Default,Chojo,0,0,0,,Một cảnh sát đeo mặt nạ\Nmang sứ mệnh đặc biệt.
Dialogue: 0,0:05:49.06,0:05:51.62,Default,Chojo,0,0,0,,Cái tên duy nhất tôi có thể tiết lộ là danh xưng này:
Dialogue: 0,0:05:52.00,0:05:55.83,Default,Chojo,0,0,0,,Chiến đội Chinjuku Chinranger.
Dialogue: 0,0:05:56.59,0:05:58.80,Default,Chojo,0,0,0,,Ngọn lửa công lý rực cháy. Chin Red.
Dialogue: 0,0:05:58.80,0:06:01.00,Italics,Changer,0,0,0,,Ngọn lửa công lý!
Dialogue: 0,0:06:02.00,0:06:03.39,Default,Maruyama,0,0,0,,"Chin Red" ư?
Dialogue: 0,0:06:04.24,0:06:05.12,Default,Chojo,0,0,0,,Tạm biệt.
Dialogue: 0,0:06:05.12,0:06:06.34,Default,Maruyama,0,0,0,,Khoan đã!
Dialogue: 0,0:06:06.97,0:06:08.34,Default,Nao,0,0,0,,Được rồi, lối này.
Dialogue: 0,0:06:09.29,0:06:11.02,Default,Nao,0,0,0,,Chắc không còn ai khác nhìn thấy anh đâu.
Dialogue: 0,0:06:11.60,0:06:13.10,Default,Chojo,0,0,0,,Giải trừ biến hình.
Dialogue: 0,0:06:15.26,0:06:17.23,Default,Chojo,0,0,0,,Chạy thử nghiệm trơn tru phết.
Dialogue: 0,0:06:17.23,0:06:20.73,Default,Sign,0,0,0,,{\an8\pos(145.5,211.5)}THIẾT BỊ BIẾN HÌNH\NCHIN-CHANGER
Dialogue: 0,0:06:17.23,0:06:20.73,Default,Chojo,0,0,0,,{\an8}Máy biến hình Chin-Changer do Copbot độ riêng\Nhoạt động mượt mà phết nhỉ.
Dialogue: 0,0:06:21.10,0:06:23.64,Default,Copbot,0,0,0,,Thì tiền bối tự bỏ tiền túi ra đặt hàng mà.
Dialogue: 0,0:06:23.64,0:06:26.79,Default,Nao,0,0,0,,Không thể tin được tiền bối lại vung tiền vào\Nmột thứ nhảm nhí như thế này.
Dialogue: 0,0:06:26.79,0:06:29.24,Default,Nao,0,0,0,,Đã thế cái áo khoác của anh tự dưng hóa đỏ lòm luôn kìa.
Dialogue: 0,0:06:30.38,0:06:31.49,Default,Lily,0,0,0,,Cứu với.
Dialogue: 0,0:06:31.79,0:06:34.79,Default,Lily,0,0,0,,Ai đó ơi! Có chú mèo bị kẹt trên cây!
Dialogue: 0,0:06:34.79,0:06:35.75,Default,Chojo,0,0,0,,Có rắc rối.
Dialogue: 0,0:06:36.08,0:06:36.92,Default,Chojo,0,0,0,,Ta tới ngay đây!
Dialogue: 0,0:06:37.42,0:06:38.34,Default,Chojo,0,0,0,,Chin Biến Hình!
Dialogue: 0,0:06:37.42,0:06:39.58,Top Italics,Changer,0,0,0,,Biến hình khẩn cấp!
Dialogue: 0,0:06:40.00,0:06:43.16,Default,Copbot,0,0,0,,Anh ấy hăng hái gấp bội ngày thường luôn kìa.
Dialogue: 0,0:06:43.16,0:06:46.34,Default,Nao,0,0,0,,Thôi thì đùa nghịch một tí chắc cũng chẳng hại ai đâu nhỉ?
Dialogue: 0,0:06:46.34,0:06:51.09,Narrator,Narrator,0,0,0,,Xét về mức độ lố bịch thì chữ "một tí"\Nchẳng thấm vào đâu.
Dialogue: 0,0:06:52.40,0:06:53.89,Default,Lily,0,0,0,,Ở trên cao nguy hiểm lắm đấy, nhóc mèo.
Dialogue: 0,0:06:53.89,0:06:54.81,Default,Chojo,0,0,0,,Cẩn thận!
Dialogue: 0,0:06:57.40,0:06:59.14,Default,Lily,0,0,0,,A-Ai thế ạ?
Dialogue: 0,0:06:59.51,0:07:01.69,Default,Chojo,0,0,0,,Chiến đội Chinjuku Chinranger.
Dialogue: 0,0:07:01.98,0:07:04.27,Default,Chojo,0,0,0,,Ngọn lửa công lý rực cháy. Chin Red.
Dialogue: 0,0:07:03.02,0:07:04.82,Top Italics,Changer,0,0,0,,Ngọn lửa công lý!
Dialogue: 0,0:07:04.68,0:07:06.15,Default,Lily,0,0,0,,Chin Red.
Dialogue: 0,0:07:06.15,0:07:11.12,Narrator,Narrator,0,0,0,,Sau khi giải quyết xong vấn đề danh tiếng,\Nviên cảnh sát tâm linh trở nên bất khả chiến bại.
Dialogue: 0,0:07:11.12,0:07:12.49,Default,Kids,0,0,0,,C-Cẩn thận!
Dialogue: 0,0:07:13.04,0:07:14.42,Default,Chojo,0,0,0,,Chin Ngưng Đọng.
Dialogue: 0,0:07:15.20,0:07:17.20,Default,Chojo,0,0,0,,Mấy đứa không sao chứ?
Dialogue: 0,0:07:17.20,0:07:19.12,Default,Kids,0,0,0,,Cháu cảm ơn Chin Red ạ!
Dialogue: 0,0:07:19.45,0:07:21.92,Narrator,Narrator,0,0,0,,Tình trạng vô pháp luật của thị trấn này\Nlại hóa thành cơn gió thuận,
Dialogue: 0,0:07:21.67,0:07:26.88,Default,Sign,0,0,0,,{\an8}LẠI THÊM MỘT VỤ ÁN ĐƯỢC PHÁ\NBỞI SIÊU ANH HÙNG BÍ ẨN!
Dialogue: 0,0:07:22.64,0:07:26.88,Narrator,Narrator,0,0,0,,trao cho anh ta vô vàn cơ hội để phô diễn\Nchiến tích anh hùng của mình.
Dialogue: 0,0:07:27.26,0:07:29.38,Top Italics,Announcer,0,0,0,,Sau đây là bản tin thời sự tối.
Dialogue: 0,0:07:29.38,0:07:32.84,Top Italics,Announcer,0,0,0,,Chin Red vừa tiếp tục giải quyết êm đẹp\Nmột sự cố khác tại Chinjuku.
Dialogue: 0,0:07:26.88,0:07:32.84,Default,Sign,0,0,0,,{\an8\pos(348,251.5)}CHIN RED BÍ ẨN\NLẠI MỘT LẦN NỮA PHÁ ÁN THÀNH CÔNG!
Dialogue: 0,0:07:33.17,0:07:34.85,Default,Woman 1,0,0,0,,Anh Chin Red!
Dialogue: 0,0:07:34.85,0:07:36.53,Default,Woman 2,0,0,0,,Nhìn sang đây đi anh!
Dialogue: 0,0:07:36.53,0:07:37.66,Default,Woman 3,0,0,0,,Anh ấy vẫy tay với mình kìa!
Dialogue: 0,0:07:37.66,0:07:38.44,Default,Chin Red,0,0,0,,Em gọi anh à?
Dialogue: 0,0:07:38.44,0:07:39.56,Default,Woman 4,0,0,0,,Không, gọi em cơ!
Dialogue: 0,0:07:41.25,0:07:43.18,Top,Chin Red,0,0,0,,Cảm ơn tất cả mọi người.
Dialogue: 0,0:07:39.93,0:07:44.78,Narrator,Narrator,0,0,0,,Và chẳng mấy chốc, Chin Red đã trở thành\Nhình mẫu anh hùng được toàn dân kính trọng.
Dialogue: 0,0:07:44.78,0:07:46.06,Default,Nao,0,0,0,,Thật luôn hả?
Dialogue: 0,0:07:46.64,0:07:49.99,Default,Maruyama,0,0,0,,"Khi khảo sát 100 phụ nữ Chinjuku\Nxem mẫu bạn trai lý tưởng của họ là ai,
Dialogue: 0,0:07:49.99,0:07:51.82,Default,Maruyama,0,0,0,,đứng đầu bảng chính là Chin Red."
Dialogue: 0,0:07:52.12,0:07:54.30,Default,Maruyama,0,0,0,,Tớ hoàn toàn tin sái cổ luôn ấy.
Dialogue: 0,0:07:54.30,0:07:56.33,Default,Sumikawa,0,0,0,,Cậu từng gặp anh ấy một lần rồi đúng không, Maru?
Dialogue: 0,0:07:56.33,0:07:56.83,Default,Maruyama,0,0,0,,Ừ.
Dialogue: 0,0:07:56.83,0:08:00.32,Default,Maruyama,0,0,0,,Giọng anh ấy trầm ấm quyến rũ kinh khủng,\Nlại còn có đôi chân dài miên man gợi cảm nữa chứ.
Dialogue: 0,0:08:00.32,0:08:02.71,Default,Maruyama,0,0,0,,Tớ sốc tận óc khi biết trên đời có tồn tại\Nmột người đàn ông hoàn mỹ thế đấy.
Dialogue: 0,0:08:02.98,0:08:05.48,Default,Sumikawa,0,0,0,,Tớ mê tít cái khí chất u buồn đầy bi kịch của anh ấy.
Dialogue: 0,0:08:05.48,0:08:07.42,Default,Sumikawa,0,0,0,,Mang danh là một "chiến đội" nhưng lại chiến đấu đơn độc.
Dialogue: 0,0:08:07.42,0:08:09.77,Default,Sumikawa,0,0,0,,Điều đó {\i1}chắc chắn{\i0} là để tưởng nhớ\Nnhững người đồng đội đã hy sinh rồi.
Dialogue: 0,0:08:09.77,0:08:11.72,Default,Maru,0,0,0,,Cậu suy diễn bay bổng quá mức rồi đấy.
Dialogue: 0,0:08:11.72,0:08:13.54,Default,Maru,0,0,0,,Cậu thấy anh ấy thế nào, Pon?
Dialogue: 0,0:08:13.54,0:08:16.60,Default,Sumikawa,0,0,0,,Một người đàn ông kiêu hãnh đơn độc chiến đấu.\NĐúng là sức hút không thể cưỡng lại nổi.
Dialogue: 0,0:08:16.89,0:08:18.69,Default,Nao,0,0,0,,Biết đâu tại ổng chẳng có nổi một mống bạn thôi ấy.
Dialogue: 0,0:08:18.69,0:08:19.60,Default,Friends,0,0,0,,Phũ phàng vãi chưởng.
Dialogue: 0,0:08:20.00,0:08:22.16,Default,Sumikawa,0,0,0,,Gì thế này? Trong đám mình lại có anti-fan của Chin Red à?
Dialogue: 0,0:08:22.16,0:08:24.08,Default,Maruyama,0,0,0,,À mà, tớ cũng phần nào hiểu cho cậu ấy đấy.
Dialogue: 0,0:08:24.08,0:08:25.31,Default,Nao,0,0,0,,Ủa, cậu hiểu hả?
Dialogue: 0,0:08:25.80,0:08:31.07,Default,Maruyama,0,0,0,,Biết trên đời tồn tại cực phẩm như Chin Red trong khi\Ncộng sự của mình lại là tên cảnh sát tâm linh kia thì...
Dialogue: 0,0:08:26.33,0:08:28.27,Top,Chin Red,0,0,0,,Xin đừng nhìn chằm chằm vào tôi như thế.
Dialogue: 0,0:08:28.82,0:08:31.07,Top,Chojo,0,0,0,,Nhìn cái chóa gì mà nhìn hả?
Dialogue: 0,0:08:31.44,0:08:33.32,Default,Maruyama,0,0,0,,Tớ hiểu vì sao cậu ngán tận cổ rồi đấy.
Dialogue: 0,0:08:33.32,0:08:36.95,Default,Sumikawa,0,0,0,,Có khi nếu tên cảnh sát tâm linh gặm móng chân\Ncủa Chin Red thì hắn sẽ hấp thụ được tí phẩm chất tốt đẹp đấy.
Dialogue: 0,0:08:37.41,0:08:39.70,Default,Nao,0,0,0,,Cứ như mình vừa uống lộn thuốc điên vậy.
Dialogue: 0,0:08:40.16,0:08:44.08,Default,Nao,0,0,0,,Mọi chuyện diễn ra đúng như thế đấy.\NVà tôi thấy đầu óc mình sắp phát điên rồi.
Dialogue: 0,0:08:44.08,0:08:47.11,Default,Nao,0,0,0,,Việc anh ta trở nên nổi tiếng thế này đúng là...
Dialogue: 0,0:08:47.11,0:08:49.71,Default,Copbot,0,0,0,,À, tôi cũng hiểu được sự lệch pha khó tin\Nmà chuyện này gây ra.
Dialogue: 0,0:08:50.14,0:08:54.59,Default,Nao,0,0,0,,Bình thường hành vi của anh ấy khác xa chuẩn mực anh hùng mà.
Dialogue: 0,0:08:56.33,0:08:58.60,Default,Chojo,0,0,0,,Chà, bé Pon à. Cô lúc nào cũng\Nlo lắng đủ thứ chuyện hết nhỉ.
Dialogue: 0,0:08:59.15,0:09:03.35,Default,Chojo,0,0,0,,Uống chút trà hoa cúc đi.\NMón này xoa dịu thần kinh tốt lắm đấy.
Dialogue: 0,0:09:03.35,0:09:06.15,Default,Chojo,0,0,0,,Cơ mà, "bạn trai lý tưởng" cơ đấy nhỉ?
Dialogue: 0,0:09:06.15,0:09:08.48,Default,Chojo,0,0,0,,Nghe cũng mát tai thật đấy, nhưng đó chẳng phải\Nthứ tôi có thể đáp ứng đâu.
Dialogue: 0,0:09:08.93,0:09:11.36,Default,Chojo,0,0,0,,Suy cho cùng, toàn bộ trái tim và tình yêu của tôi...
Dialogue: 0,0:09:11.75,0:09:13.73,Default,Chojo,0,0,0,,đều dành trọn cho toàn thể cư dân Chinjuku này rồi.
Dialogue: 0,0:09:13.73,0:09:15.86,Italics,Nao,0,0,0,,Trong não ổng đang diễn ra cái quái gì vậy trời?
Dialogue: 0,0:09:15.99,0:09:18.04,Default,Nao,0,0,0,,C-Cái {\i1}gì{\i0} thế này? Rợn cả tóc gáy lên rồi!
Dialogue: 0,0:09:18.04,0:09:20.37,Default,Nao,0,0,0,,Copbot ơi, đầu óc ổng hỏng nặng rồi!
Dialogue: 0,0:09:20.76,0:09:22.37,Default,Copbot,0,0,0,,Kh-Không lẽ nào?
Dialogue: 0,0:09:22.62,0:09:26.37,Default,Copbot,0,0,0,,Anh ấy đã thấm nhuần lý tưởng anh hùng của mình\Ntới mức nhập tâm cả trong đời sống thường nhật sao?
Dialogue: 0,0:09:26.37,0:09:29.33,Top,Nao,0,0,0,,Vậy là ổng chơi trò đóng giả siêu nhân\Ntới cảnh giới diễn xuất nhập vai luôn rồi à?
Dialogue: 0,0:09:26.71,0:09:31.63,Default,Sign,0,0,0,,{\an8\pos(320,240)}DIỄN XUẤT NHẬP TÂM
Dialogue: 0,0:09:29.33,0:09:31.63,Top,Chojo,0,0,0,,Từ yêu thích của tôi là "lòng nhân ái".
Dialogue: 0,0:09:32.06,0:09:34.38,Default,Nao,0,0,0,,Chẳng thèm giấu giếm chút nào luôn hả?
Dialogue: 0,0:09:34.72,0:09:35.39,Default,Chojo,0,0,0,,Giờ thì...
Dialogue: 0,0:09:35.97,0:09:38.01,Default,Chojo,0,0,0,,Lên đường giữ gìn hòa bình thôi.
Dialogue: 0,0:09:38.01,0:09:40.43,Default,Chojo,0,0,0,,Mọi thứ đều đã sẵn sàng.
Dialogue: 0,0:09:42.76,0:09:45.90,Default,Nao,0,0,0,,Ổng cải tạo cả cái đồn cảnh sát thành\Ncăn cứ bí mật từ lúc nào thế này?!
Dialogue: 0,0:09:45.90,0:09:49.20,Default,Nao,0,0,0,,Nhìn là biết chỗ này tuân thủ nghiêm ngặt\Nbộ quy chuẩn thiết kế thương hiệu rồi.
Dialogue: 0,0:09:49.20,0:09:51.52,Default,Copbot,0,0,0,,Anh ấy nhập vai sâu thật sự đấy.
Dialogue: 0,0:09:51.52,0:09:54.89,Default,Copbot,0,0,0,,Cứ đà này, chẳng mấy chốc\Nsẽ có quái vật xuất hiện thật mất.
Dialogue: 0,0:09:54.89,0:09:57.53,Default,Nao,0,0,0,,Đó chính là viễn cảnh còn đáng sợ hơn nữa đấy.
Dialogue: 0,0:09:57.53,0:10:02.03,Default,Maruyama,0,0,0,,Ngoài kia chắc chắn có một anh hùng dành cho mình.
Dialogue: 0,0:10:02.03,0:10:06.54,Default,Maruyama,0,0,0,,Nhưng anh ấy ở đâu chứ? Xuất hiện đi nào!
Dialogue: 0,0:10:06.84,0:10:11.04,Default,Maruyama,0,0,0,,Ôi trời. Đang đi tuần tra mà mình chẳng nên\Nđòi hỏi vô lý thế này chứ.
Dialogue: 0,0:10:11.04,0:10:12.04,Default,Maruyama,0,0,0,,Ai ở đó đấy?
Dialogue: 0,0:10:13.16,0:10:14.34,Default,Suspect 2,0,0,0,,Con nhỏ này thấy hết rồi.
Dialogue: 0,0:10:14.34,0:10:16.92,Default,Suspect 3,0,0,0,,Đã nhìn thấy tụi tao rồi thì\Nkhông thể để mày đi dễ dàng đâu.
Dialogue: 0,0:10:19.68,0:10:21.80,Default,Maruyama,0,0,0,,Không!
Dialogue: 0,0:10:23.56,0:10:24.68,Italics,Radio,0,0,0,,Sở Cảnh sát Đô thị gọi các đồn.
Dialogue: 0,0:10:25.15,0:10:29.12,Italics,Radio,0,0,0,,Một nhóm đối tượng khả nghi vừa bắt cóc\Nmột nữ sĩ quan tại khu phố Sáu Chinjuku.
Dialogue: 0,0:10:26.14,0:10:30.31,Default,Sign,0,0,0,,{\an8}HOẠT ĐỘNG KHẢ NGHI\NTẠI KHU VỰC KHU PHỐ SÁU CHINJUKU
Dialogue: 0,0:10:29.12,0:10:30.31,Default,Chojo,0,0,0,,Cái gì?
Dialogue: 0,0:10:30.75,0:10:33.12,Default,Nao,0,0,0,,Khu phố Sáu à?\NNữ cảnh sát trực tuần tra ở đó hôm nay...
Dialogue: 0,0:10:33.12,0:10:34.15,Default,Nao,0,0,0,,Là Maru sao?!
Dialogue: 0,0:10:34.58,0:10:37.28,Italics,Radio,0,0,0,,Bọn chúng di chuyển trên nhiều xe tải\Nvà đang chạy hướng về phía Bắc.
Dialogue: 0,0:10:37.28,0:10:39.53,Italics,Radio,0,0,0,,Chúng đang tẩu thoát\Nsang tỉnh lân cận.
Dialogue: 0,0:10:39.53,0:10:41.78,Default,Sign,0,0,0,,{\an8}CHIN
Dialogue: 0,0:10:39.98,0:10:41.78,Default,Chojo,0,0,0,,Dám bắt cóc cả đồng nghiệp cảnh sát cơ à?
Dialogue: 0,0:10:42.26,0:10:43.68,Default,Chojo,0,0,0,,Chúng ta sẽ đi giải cứu cô ấy.
Dialogue: 0,0:10:43.68,0:10:44.66,Default,Nao/Copbot,0,0,0,,Rõ.
Dialogue: 0,0:10:45.12,0:10:47.54,Default,Chojo,0,0,0,,Chiến đội Chinjuku Chinranger, xuất kích!
Dialogue: 0,0:10:47.93,0:10:50.21,Default,Nao,0,0,0,,Anh đốt bao nhiêu tiền vào cái đống này rồi hả?!
Dialogue: 0,0:10:50.21,0:10:52.96,Narrator,Narrator,0,0,0,,Tuần tra viên siêu năng lực Chojo.
Dialogue: 0,0:10:50.21,0:10:52.96,Default,Sign,0,0,0,,{\an8}CHIN RED, CHIẾN BINH ĐỎ
Dialogue: 0,0:10:53.68,0:10:57.21,Narrator,Narrator,0,0,0,,Ở tập trước của {\i0}Chiến đội Chinjuku Chinranger{\i1}.
Dialogue: 0,0:10:52.96,0:10:57.21,Default,Sign,0,0,0,,{\an8}CHIẾN ĐỘI CHINJUKU CHINRANGER
Dialogue: 0,0:10:57.51,0:11:01.47,Narrator,Narrator,0,0,0,,Bạn đồng khóa học viện của Pon là Maru\Nđã bị một băng nhóm bí ẩn bắt cóc.
Dialogue: 0,0:11:01.78,0:11:07.01,Narrator,Narrator,0,0,0,,Chin Red tức Meguru Chojo cùng đồng đội\Nđã lái chiến xa Copbot F-Type
Dialogue: 0,0:11:07.01,0:11:10.23,Narrator,Narrator,0,0,0,,phóng như bay xuyên màn đêm\Ntruy đuổi bọn bắt cóc.
Dialogue: 0,0:11:10.23,0:11:12.23,Default,Sign,0,0,0,,{\an8}SÁNG HÔM SAU
Dialogue: 0,0:11:11.03,0:11:16.74,Narrator,Narrator,0,0,0,,Sáng hôm sau, họ đặt chân tới một mỏ đá bỏ hoang\Ntại tỉnh T.
Dialogue: 0,0:11:12.23,0:11:17.73,Default,Sign,0,0,0,,{\an8}MỎ ĐÁ TẠI TỈNH T
Dialogue: 0,0:11:18.10,0:11:20.42,Narrator,Narrator,0,0,0,,Vô số kẻ địch đang chờ đợi họ phía trước.
Dialogue: 0,0:11:20.42,0:11:22.87,Narrator,Narrator,0,0,0,,Số phận của biệt đội Chinranger sẽ ra sao đây?
Dialogue: 0,0:11:22.87,0:11:24.90,Default,Nao,0,0,0,,Vậy là giờ tụi mình thành phim Siêu nhân đúng nghĩa luôn rồi hả?
Dialogue: 0,0:11:24.90,0:11:28.24,Narrator,Narrator,0,0,0,,Tập 50: Chin Red Bất Diệt.
Dialogue: 0,0:11:24.90,0:11:28.24,Default,Sign,0,0,0,,{\an8}TẬP 50: CHIN RED BẤT DIỆT
Dialogue: 0,0:11:28.24,0:11:30.00,Default,Nao,0,0,0,,Lại còn nghe sặc mùi tập cuối nữa chứ!
Dialogue: 0,0:11:31.04,0:11:34.00,Default,Nao,0,0,0,,Maru! Có vẻ cậu ấy bị ngất xỉu rồi.
Dialogue: 0,0:11:34.00,0:11:35.67,Default,Nao,0,0,0,,Tụi mình đã vượt qua ranh giới tỉnh rồi.
Dialogue: 0,0:11:35.67,0:11:39.62,Default,Nao,0,0,0,,Sở Cảnh sát Đô thị và cảnh sát tỉnh T đang\Nđùn đẩy nhau để né rắc rối thẩm quyền.
Dialogue: 0,0:11:39.62,0:11:42.35,Default,Copbot,0,0,0,,Xem ra đây chính là nhiệm vụ dành cho\NSĩ quan Cấp cao Chin Red rồi.
Dialogue: 0,0:11:43.84,0:11:45.14,Default,Copbot,0,0,0,,Sĩ quan cấp cao á?
Dialogue: 0,0:11:45.72,0:11:46.64,Default,Chojo,0,0,0,,Chỗ này...
Dialogue: 0,0:11:46.64,0:11:49.43,Default,Chojo,0,0,0,,Đây đích thị là cái mỏ đá huyền thoại rồi!
Dialogue: 0,0:11:49.43,0:11:51.14,Default,Nao,0,0,0,,Ánh mắt rạng ngời ngây thơ như trẻ lên ba kìa.
Dialogue: 0,0:11:51.14,0:11:53.44,Default,Nao,0,0,0,,T-Tiền bối Chojo? Anh bị làm sao thế?
Dialogue: 0,0:11:53.44,0:11:54.90,Default,Copbot,0,0,0,,Địa điểm này có gì đặc biệt sao?
Dialogue: 0,0:11:54.90,0:11:56.77,Default,Chojo,0,0,0,,Hai người mù thông tin {\i1}tới mức nào{\i0} thế hả?
Dialogue: 0,0:11:56.77,0:12:01.03,Default,Chojo,0,0,0,,Mỏ đá ở tỉnh T này chính là phim trường quay\Nhàng loạt series siêu nhân tokusatsu đấy!
Dialogue: 0,0:12:01.51,0:12:04.78,Default,Chojo,0,0,0,,Hai người có biết đã có bao nhiêu kiệt tác\Nđược khai sinh ngay tại mảnh đất này không hả?
Dialogue: 0,0:12:05.12,0:12:06.61,Default,Chojo,0,0,0,,Tôi phải hốt một nắm đất mang về làm kỷ niệm mới được.
Dialogue: 0,0:12:06.61,0:12:07.78,Default,Nao,0,0,0,,Có phải giải bóng chày Koshien đâu mà hốt đất!
Dialogue: 0,0:12:08.08,0:12:12.21,Default,Chojo,0,0,0,,Được rồi, hôm nay khí thế trong tôi hừng hực rồi đây.\NĐã tới lúc Chin Red xung trận.
Dialogue: 0,0:12:12.21,0:12:14.29,Default,Nao,0,0,0,,À, tiền bối Chojo, khoan đã.
Dialogue: 0,0:12:14.70,0:12:17.14,Default,Nao,0,0,0,,Lần này, tôi cũng muốn giúp một tay.
Dialogue: 0,0:12:17.14,0:12:17.67,Default,Chojo,0,0,0,,Nói gì cơ?
Dialogue: 0,0:12:18.00,0:12:19.92,Default,Nao,0,0,0,,Maru là bạn thân của tôi mà!
Dialogue: 0,0:12:20.79,0:12:23.00,Default,Chojo,0,0,0,,Được thôi. Vậy chúng ta cùng chiến đấu theo đội nhé.
Dialogue: 0,0:12:23.00,0:12:24.15,Default,Nao,0,0,0,,Vâng.
Dialogue: 0,0:12:24.15,0:12:25.55,Default,Chojo,0,0,0,,Vậy thì nhân tiện đây...
Dialogue: 0,0:12:26.12,0:12:28.68,Default,Chojo,0,0,0,,Cầm lấy đi. Chin-Changer của cô đấy, bé Pon.
Dialogue: 0,0:12:26.68,0:12:28.68,Default,Sign,0,0,0,,{\an8}CHIN
Dialogue: 0,0:12:28.68,0:12:32.18,Default,Nao,0,0,0,,Hả? C-Cái gì cơ?\NAnh bắt tôi cũng phải cosplay cùng luôn à?
Dialogue: 0,0:12:32.18,0:12:34.82,Default,Chojo,0,0,0,,Cô là cộng sự của tôi mà.\NNếu cô xuất hiện mà không cải trang,
Dialogue: 0,0:12:34.82,0:12:36.56,Default,Chojo,0,0,0,,thì thiên hạ nhìn phát biết tỏng tôi là ai ngay.
Dialogue: 0,0:12:40.27,0:12:42.33,Default,Chojo,0,0,0,,Sao thế? Cô không muốn đeo à?
Dialogue: 0,0:12:42.33,0:12:44.45,Default,Chojo,0,0,0,,Cô định bỏ rơi bạn thân mình đấy sao?
Dialogue: 0,0:12:45.68,0:12:48.58,Default,Nao,0,0,0,,T-Tôi đeo là được chứ gì! Đeo thì đeo!
Dialogue: 0,0:12:49.03,0:12:51.20,Default,Chojo,0,0,0,,Đứng yên tại chỗ, lũ khốn kia!
Dialogue: 0,0:12:51.50,0:12:53.08,Default,Suspect 1,0,0,0,,C-Cái quái gì thế kia?
Dialogue: 0,0:12:53.58,0:12:57.71,Default,Sign,0,0,0,,{\an8}CHẾ ĐỘ BÍ MẬT DANH TÍNH\NCẢNH SÁT TÂM LINH & BÉ PON
Dialogue: 0,0:12:53.58,0:12:55.02,Default,Chojo,0,0,0,,Bọn ta là các siêu anh hùng.
Dialogue: 0,0:12:55.02,0:12:57.71,Default,Nao,0,0,0,,À là cảnh sát. Bọn ta tới để bắt giữ chúng bay.
Dialogue: 0,0:12:58.08,0:13:01.44,Default,Nao,0,0,0,,Mau thả Maru—à nhầm,\Nthả cô gái chúng bay đã bắt cóc ra ngay.
Dialogue: 0,0:13:01.44,0:13:02.85,Default,Chojo,0,0,0,,Giờ thì hết đường chạy thoát rồi.
Dialogue: 0,0:13:02.85,0:13:04.34,Default,Chojo,0,0,0,,Mau đầu hàng và hợp tác đi.
Dialogue: 0,0:13:04.96,0:13:09.10,Default,Suspect 1,0,0,0,,"Đầu hàng" á? Chúng mày tưởng mình đang đối đầu\Nvới băng nhóm cò con nào hả?
Dialogue: 0,0:13:09.67,0:13:14.35,Default,Suspect 1,0,0,0,,Đứng trước mặt chúng mày là những gã đàn ông\Nbị toàn bộ phụ nữ Chinjuku từ chối phũ phàng:
Dialogue: 0,0:13:15.12,0:13:18.10,Default,Suspect 1,0,0,0,,Biệt đội Thất Tình Kabuki-cho!
Dialogue: 0,0:13:14.35,0:13:18.10,Default,Sign,0,0,0,,{\an8}HỘI THẤT TÌNH KABUKI-CHO:\NBIỆT ĐỘI TAN NÁT CON TIM
Dialogue: 0,0:13:18.48,0:13:20.36,Default,Nao,0,0,0,,Một lũ đàn ông bị đá tập thể hả?
Dialogue: 0,0:13:20.71,0:13:24.86,Default,Suspect 1,0,0,0,,Tối qua bọn tao đang tính đi phá hoại\Nmột tụ điểm hẹn hò nổi tiếng ở Chinjuku.
Dialogue: 0,0:13:25.24,0:13:28.99,Default,Suspect 1,0,0,0,,Con nữ cảnh sát này dám cả gan ngáng đường tụi tao.
Dialogue: 0,0:13:25.24,0:13:26.26,Flashback,Maruyama,0,0,0,,{\an8}Các người là ai?
Dialogue: 0,0:13:30.43,0:13:33.60,Default,Suspect 1,0,0,0,,Giờ thì nó sắp phải trả giá đắt cho chuyện đó.
Dialogue: 0,0:13:34.46,0:13:37.60,Default,Chojo,0,0,0,,Hỡi những con quái vật đáng thương\Nsinh ra từ tâm trạng ái tình...
Dialogue: 0,0:13:37.60,0:13:38.87,Default,Nao,0,0,0,,Chả đúng tẹo nào luôn ấy.
Dialogue: 0,0:13:38.87,0:13:41.38,Default,Chojo,0,0,0,,Ta sẽ chấm dứt nỗi sầu muộn của các ngươi.
Dialogue: 0,0:13:41.70,0:13:42.34,Default,Cops,0,0,0,,Chin Biến Hình!
Dialogue: 0,0:13:41.72,0:13:43.38,Top Italics,Changer,0,0,0,,{\an8}Biến hình khẩn cấp!
Dialogue: 0,0:13:43.38,0:13:47.01,Default,Chojo,0,0,0,,Ngọn lửa công lý rực cháy. Chin Red có mặt.
Dialogue: 0,0:13:45.11,0:13:47.01,Top Italics,Changer,0,0,0,,Ngọn lửa công lý!
Dialogue: 0,0:13:47.01,0:13:48.70,Default,Nao,0,0,0,,À, ờm...
Dialogue: 0,0:13:48.70,0:13:50.64,Default,Nao,0,0,0,,Sức mạnh của Judo. Chin Blue.
Dialogue: 0,0:13:48.70,0:13:50.64,Top Italics,Changer,0,0,0,,Judo mãnh lực!
Dialogue: 0,0:13:51.02,0:13:52.14,Default,Chojo,0,0,0,,Cả hai bọn ta chính là:
Dialogue: 0,0:13:52.14,0:13:55.27,Default,Chinranger,0,0,0,,Chiến đội Chinjuku Chinranger.
Dialogue: 0,0:13:53.43,0:13:54.56,Top Italics,Changer,0,0,0,,Bùng nổ!
Dialogue: 0,0:13:54.56,0:13:55.27,Top,Nao,0,0,0,,Nóng quá!
Dialogue: 0,0:13:55.27,0:13:56.77,Default,Nao,0,0,0,,Hơi nóng táp rát cả lưng tôi rồi nè!
Dialogue: 0,0:13:56.77,0:13:58.82,Default,Nao,0,0,0,,Sao tự dưng lại có vụ nổ đằng sau thế?!
Dialogue: 0,0:13:58.82,0:14:02.35,Default,Chojo,0,0,0,,Cô nói lạ nhỉ?\NĐấy là hiệu ứng pháo hoa khói lửa hiển nhiên phải có mà.
Dialogue: 0,0:14:02.35,0:14:06.19,Default,Chojo,0,0,0,,Chiến đội ra mắt mà không có cháy nổ phía sau\Nthì còn ra thể thống gì nữa. Kiến thức cơ bản đấy.
Dialogue: 0,0:14:06.19,0:14:10.28,Default,Chojo,0,0,0,,Nhất là khi trong thành phố\Ntôi chẳng thể kích nổ thứ này được.
Dialogue: 0,0:14:10.28,0:14:15.69,Default,Chojo,0,0,0,,Hôm nay anh và em sẽ có buổi hẹn hò đặc biệt,\Nbé thuốc nổ napalm yêu dấu của anh ạ.
Dialogue: 0,0:14:15.69,0:14:18.04,Default,Nao,0,0,0,,Thế hóa ra anh là thể loại\Nkhủng bố đặt bom tâm thần nào à?!
Dialogue: 0,0:14:18.04,0:14:21.04,Default,Nao,0,0,0,,À này, mình ngừng diễn trò tấu hài trước mặt\Nđám tội phạm được chưa vậy?
Dialogue: 0,0:14:21.49,0:14:26.14,Default,Suspicious,0,0,0,,Chin Red á? Là cái thằng khốn dạo này\Nđược mấy em gái mê như điếu đổ đấy hả?
Dialogue: 0,0:14:26.14,0:14:27.80,Default,Suspicious,0,0,0,,Đúng lúc lắm.
Dialogue: 0,0:14:27.80,0:14:31.70,Default,Suspicious,0,0,0,,Bọn tao sẽ trút sạch nỗi uất ức đường tình duyên\Nlên đầu mày luôn thể!
Dialogue: 0,0:14:33.68,0:14:36.24,Default,Nao,0,0,0,,Ủa, tự dưng bọn chúng hừng hực khí thế\Nlên dữ dội thế nhỉ?
Dialogue: 0,0:14:36.24,0:14:37.01,Default,Suspect 2,0,0,0,,Ui da.
Dialogue: 0,0:14:37.01,0:14:40.69,Default,Chojo,0,0,0,,Xem ra lũ quái vật này càng phẫn uất\Nthì sức mạnh càng tăng lên đấy.
Dialogue: 0,0:14:40.69,0:14:42.61,Top,Nao,0,0,0,,Chẳng ai mượn anh phân tích ba cái đó đâu.
Dialogue: 0,0:14:42.61,0:14:44.69,Top,Nao,0,0,0,,Ngừng tận hưởng cái kịch bản giả tưởng này ngay đi v—
Dialogue: 0,0:14:42.61,0:14:44.03,Default,Hosaka,0,0,0,,Và sau đây, xin gửi tặng một bài thơ.
Dialogue: 0,0:14:44.03,0:14:47.44,Default,Hosaka,0,0,0,,Từ lực lượng tiếp viện vừa đặt chân\Nlên đỉnh vách núi này.
Dialogue: 0,0:14:47.44,0:14:48.56,Default,Nao,0,0,0,,Ai thế kia?
Dialogue: 0,0:14:48.56,0:14:51.72,Default,Chojo,0,0,0,,À, bác ấy tới rồi. Chính là người tôi đã\Nchiêu mộ trước khi xuất phát đấy.
Dialogue: 0,0:14:51.72,0:14:53.41,Default,Chojo,0,0,0,,Thành viên cuối cùng của biệt đội Chinranger.
Dialogue: 0,0:14:53.93,0:14:56.91,Default,Hosaka,0,0,0,,Thân tôi tuy chỉ là gã nhân viên văn phòng quèn\Nsuốt ngày ngồi ngó ngoài cửa sổ,
Dialogue: 0,0:14:57.57,0:15:02.79,Default,Hosaka,0,0,0,,nhưng dẫu vậy tôi cũng chẳng bao giờ làm ngơ\Ntrước cảnh thiếu nữ gặp nguy hiểm.
Dialogue: 0,0:15:03.15,0:15:04.24,Default,Hosaka,0,0,0,,Chin Biến Hình!
Dialogue: 0,0:15:03.13,0:15:05.30,Top Italics,Changer,0,0,0,,Biến hình khẩn cấp!
Dialogue: 0,0:15:05.50,0:15:08.30,Default,Hosaka,0,0,0,,Túy Quyền hủy diệt cái ác.
Dialogue: 0,0:15:08.64,0:15:10.46,Default,Hosaka,0,0,0,,Chin Pink đã có mặt.
Dialogue: 0,0:15:10.46,0:15:11.63,Default,Nao,0,0,0,,Bác Ho?!
Dialogue: 0,0:15:13.43,0:15:15.63,Default,Hosaka,0,0,0,,Để bác từ từ, ờm, trèo xuống đây đã nhé...
Dialogue: 0,0:15:15.63,0:15:17.76,Default,Chojo,0,0,0,,Mừng bác đã kịp tới, Chin Pink.
Dialogue: 0,0:15:17.76,0:15:20.23,Default,Nao,0,0,0,,Kia chẳng phải bác Ho sao? Bác ấy biết đánh đấm gì đâu!
Dialogue: 0,0:15:20.23,0:15:21.69,Default,Hosaka,0,0,0,,Chà, bộ đồ này bó sát quá trời.
Dialogue: 0,0:15:22.08,0:15:24.96,Default,Chojo,0,0,0,,Không thể trông mặt mà bắt hình dong được đâu.
Dialogue: 0,0:15:24.96,0:15:27.19,Default,Chojo,0,0,0,,Bởi vì dẫu sao đi nữa, Chin Pink...
Dialogue: 0,0:15:27.19,0:15:29.97,Default,Chojo,0,0,0,,lại chính là cao thủ Túy Quyền trứ danh đấy.
Dialogue: 0,0:15:27.44,0:15:32.95,Default,Sign,0,0,0,,{\an8}TÚY QUYỀN
Dialogue: 0,0:15:31.07,0:15:32.95,Default,Nao,0,0,0,,Hả? Đùa đấy à. Thật luôn sao?!
Dialogue: 0,0:15:39.93,0:15:41.00,Default,Suspect 3,0,0,0,,Á đau.
Dialogue: 0,0:15:41.00,0:15:42.83,Top,Nao,0,0,0,,Cứ như mình vừa nhìn thấu hậu trường diễn xuất vậy.
Dialogue: 0,0:15:41.00,0:15:42.83,Default,Nao,0,0,0,,{\an8\pos(160.5,250.5)}HẬU TRƯỜNG DIỄN XUẤT
Dialogue: 0,0:15:43.11,0:15:44.54,Default,Chojo,0,0,0,,Làm tốt lắm, Chin Pink.
Dialogue: 0,0:15:44.54,0:15:46.59,Default,Chojo,0,0,0,,Giờ quyền chủ động đã nằm trong tay chúng ta.
Dialogue: 0,0:15:46.89,0:15:48.81,Default,Suspect 1,0,0,0,,Chắc chắn chưa đấy?
Dialogue: 0,0:15:48.81,0:15:51.84,Default,Suspect 1,0,0,0,,Ta sẽ cho chúng mày chiêm ngưỡng sức mạnh {\i1}thực sự{\i0}\Ncủa Hội Thất Tình.
Dialogue: 0,0:15:51.84,0:15:54.09,Default,Suspect 1,0,0,0,,Tập hợp lại đi, hỡi các anh em đồng cảnh bị đá.
Dialogue: 0,0:15:54.09,0:15:55.22,Default,Suspects,0,0,0,,Tan nát!
Dialogue: 0,0:15:55.22,0:15:57.19,Default,Suspects,0,0,0,,Con tim!
Dialogue: 0,0:15:57.19,0:15:58.47,Default,Hosaka,0,0,0,,Kh-Không thể nào.
Dialogue: 0,0:15:58.47,0:16:01.23,Default,Hosaka,0,0,0,,Chúng h-h-h-h-h-h-hợp—
Dialogue: 0,0:15:59.98,0:16:01.23,Default,Sign,0,0,0,,{\an8}HỢP THỂ
Dialogue: 0,0:16:01.60,0:16:03.06,Default,Suspect 1,0,0,0,,Cho xin miếng thạch hạt dẻ yokan.
Dialogue: 0,0:16:05.26,0:16:09.73,Default,Giant Suspect,0,0,0,,Nhờ kết hợp nhiều gã bị đá lại, ta chính là\Nkẻ bị từ chối thê thảm nhất lịch sử nhân loại.
Dialogue: 0,0:16:10.67,0:16:13.58,Default,Giant Suspect,0,0,0,,Satan Thất Tình.
Dialogue: 0,0:16:11.07,0:16:14.74,Default,Sign,0,0,0,,{\an8\pos(320,56)}SATAN THẤT TÌNH
Dialogue: 0,0:16:15.04,0:16:17.38,Default,Nao,0,0,0,,Tôi đâu có ngờ phim này lại thuộc\Nthể loại cài đặt bối cảnh kiểu này đâu.
Dialogue: 0,0:16:18.87,0:16:19.62,Default,Chojo,0,0,0,,Nếu đã vậy thì...
Dialogue: 0,0:16:20.24,0:16:21.93,Default,Chojo,0,0,0,,Đã tới lúc tung ra Hợp Thể Chin rồi.
Dialogue: 0,0:16:19.96,0:16:23.13,Default,Sign,0,0,0,,{\an8}CHIN
Dialogue: 0,0:16:21.93,0:16:23.12,Default,Nao,0,0,0,,Hợp Thể Chin á?
Dialogue: 0,0:16:23.12,0:16:27.63,Default,Sign,0,0,0,,{\an8}TRỤ SỞ CẢNH SÁT CHINJUKU
Dialogue: 0,0:16:25.59,0:16:27.63,Italics,Operator,0,0,0,,Khẩn cấp. Khẩn cấp.
Dialogue: 0,0:16:28.31,0:16:31.88,Italics,Operator,0,0,0,,Các Chiến xa Chin đã sẵn sàng xuất kích.
Dialogue: 0,0:16:32.57,0:16:34.38,Default,Chojo,0,0,0,,Năng lượng Chin, nạp đầy.
Dialogue: 0,0:16:35.58,0:16:37.89,Italics,Operator,0,0,0,,Quy trình hợp thể được phê duyệt.
Dialogue: 0,0:16:38.22,0:16:39.89,Default,Pink/Red,0,0,0,,Chúng ta sẽ tạo nên một màn trình diễn cực đỉnh.
Dialogue: 0,0:16:38.22,0:16:39.89,Top,Nao,0,0,0,,Cơ thể tôi tự động điều khiển theo kịch bản luôn rồi nè.
Dialogue: 0,0:16:42.61,0:16:44.99,Default,Nao,0,0,0,,Bác Ho ơi? Bác uống rượu say mà\Nlái xe thế có ổn không đấy?
Dialogue: 0,0:16:44.99,0:16:47.31,Default,Hosaka,0,0,0,,Người ta vẫn nhắc suốt rồi đấy:\NĐã uống rượu bia thì không lái xe.
Dialogue: 0,0:16:44.65,0:16:49.65,Default,Sign,0,0,0,,{\an8}BIA KHÔNG ĐỘ CỒN
Dialogue: 0,0:16:47.31,0:16:49.65,Default,Nao,0,0,0,,Thế hóa ra chiêu Túy Quyền lúc nãy\Nlà Túy Quyền không cồn à?!
Dialogue: 0,0:16:50.77,0:16:52.78,Default,Chojo,0,0,0,,Tiến lên nào! Hợp Thể Chin!
Dialogue: 0,0:16:53.39,0:16:54.36,Narrator,Narrator,0,0,0,,Để tôi giải thích ngắn gọn nhé.
Dialogue: 0,0:16:54.86,0:17:00.38,Narrator,Narrator,0,0,0,,Nhờ đủ loại công nghệ, vài thứ linh tinh khác,\Nvà trái tim ngập tràn ước mơ, các Chiến xa Chin...
Dialogue: 0,0:17:00.38,0:17:02.29,Narrator,Narrator,0,0,0,,có thể thực hiện màn Hợp Thể Chin huyền thoại.
Dialogue: 0,0:17:02.90,0:17:04.72,Default,Copbot,0,0,0,,Copbot Lắp Ghép.
Dialogue: 0,0:17:12.51,0:17:15.05,Top Italics,Changer,0,0,0,,Copbot G.
Dialogue: 0,0:17:11.51,0:17:15.05,Default,Team,0,0,0,,Siêu Robot Copbot G Tối Thượng, sẵn sàng.
Dialogue: 0,0:17:10.46,0:17:12.51,Default,Sign,0,0,0,,{\an8}SIÊU ROBOT COPBOT G TỐI THƯỢNG
Dialogue: 0,0:17:15.43,0:17:16.80,Default,Chin Red/Pink,0,0,0,,Chin Tăng Lực Toàn Phần.
Dialogue: 0,0:17:17.15,0:17:19.35,Default,Nao,0,0,0,,Tiền bối kiếm đâu ra tiền chế tạo con robot này thế?!
Dialogue: 0,0:17:19.35,0:17:21.18,Italics,Copbot,0,0,0,,Lại thêm một đợt gọi vốn cộng đồng nữa đấy.
Dialogue: 0,0:17:21.46,0:17:24.18,Default,Nao,0,0,0,,Tôi phục sát đất vì dân tình cũng chịu móc hầu bao góp quỹ luôn!
Dialogue: 0,0:17:21.18,0:17:22.77,Default,Sign,0,0,0,,{\an8}VỆ THẦN CHO CHINJUKU | GỌI VỐN CỘNG ĐỒNG\NROBOT KHỔNG LỒ TRONG MƠ CỦA BẠN
Dialogue: 0,0:17:22.77,0:17:24.18,Default,Sign,0,0,0,,{\an8}SIÊU ROBOT COPBOT G TỐI THƯỢNG\N2.000.000 MÃ LỰC
Dialogue: 0,0:17:24.63,0:17:28.19,Default,Chojo,0,0,0,,Ngọn lửa công lý sẽ thiêu rụi\Ncái ác thành tro tàn.
Dialogue: 0,0:17:28.54,0:17:29.94,Default,Giant Suspect,0,0,0,,Láo xược.
Dialogue: 0,0:17:29.94,0:17:31.57,Default,Giant Suspect,0,0,0,,Ta sẽ nghiền nát chúng bay.
Dialogue: 0,0:17:31.57,0:17:34.19,Default,Giant Suspect,0,0,0,,Cú Đấm Tan Nát Con Tim!
Dialogue: 0,0:17:35.25,0:17:37.58,Default,Chojo,0,0,0,,Chin... Ngưng Đọng.
Dialogue: 0,0:17:39.21,0:17:40.45,Default,Giant Suspect,0,0,0,,Cái gì?!
Dialogue: 0,0:17:40.74,0:17:42.20,Default,Chojo,0,0,0,,Ngay lúc này! Kết liễu hắn đi!
Dialogue: 0,0:17:42.20,0:17:44.99,Top,Chojo,0,0,0,,Chin Nhào Lộn Vòng Tròn!
Dialogue: 0,0:17:42.20,0:17:44.99,Top,Hosaka,0,0,0,,{\3c&H440E02&}Mãnh Kích Không Độ Cồn!
Dialogue: 0,0:17:43.60,0:17:46.09,Default,Nao,0,0,0,,Ờm, à thì, Tuyệt Kỹ Quật Một Vai Bá Đạo!
Dialogue: 0,0:17:46.09,0:17:49.08,Default,Nao,0,0,0,,Đánh đấm loạn xạ chẳng đâu vào đâu!\NLẽ ra tụi mình phải tập dượt trước chứ!
Dialogue: 0,0:17:49.84,0:17:52.84,Default,Chojo,0,0,0,,Chuyển hóa ngân sách làm anime ngay!
Dialogue: 0,0:17:53.71,0:17:55.97,Default,Chojo,0,0,0,,Đòn kết liễu của chúng ta!
Dialogue: 0,0:17:57.23,0:18:00.33,Default,Chojo,0,0,0,,Chin Nhào Lộn Vòng Tròn!
Dialogue: 0,0:18:00.72,0:18:02.22,Default,Sign,0,0,0,,{\an8}CHIN NHÀO LỘN VÒNG TRÒN
Dialogue: 0,0:18:07.33,0:18:08.40,Default,Chojo,0,0,0,,Chin Khóa Cổ.
Dialogue: 0,0:18:07.52,0:18:09.36,Default,Sign,0,0,0,,{\an8}CHIN KHÓA CỔ
Dialogue: 0,0:18:09.68,0:18:11.58,Default,Chojo,0,0,0,,Và cuối cùng là Chin Còng Tay Bắt Giữ.
Dialogue: 0,0:18:09.94,0:18:12.74,Default,Sign,0,0,0,,{\an8}CHIN CÒNG TAY BẮT GIỮ
Dialogue: 0,0:18:13.12,0:18:16.11,Default,Chojo,0,0,0,,Ghét tội ác, chứ đừng ghét tội phạm.
Dialogue: 0,0:18:17.61,0:18:19.07,Default,Giant Suspect,0,0,0,,Tan nát cõi lòng!
Dialogue: 0,0:18:19.07,0:18:20.49,Default,Nao,0,0,0,,Đây rốt cuộc là thể loại anime gì vậy trời?
Dialogue: 0,0:18:20.96,0:18:22.37,Default,Chojo,0,0,0,,Và thế là khép lại vụ án.
Dialogue: 0,0:18:22.81,0:18:24.32,Default,Nao,0,0,0,,Đừng có tự tiện kết thúc ngang xương thế chứ!
Dialogue: 0,0:18:24.32,0:18:26.56,Default,Chojo,0,0,0,,Hãy tới Rạp Chin-Rosso\Nvà bắt tay giao lưu cùng tôi nhé.
Dialogue: 0,0:18:26.56,0:18:28.25,Default,Nao,0,0,0,,Làm gì có cái rạp đó mà mời với chả mọc!
Dialogue: 0,0:18:30.02,0:18:31.25,Default,Nao,0,0,0,,Maru.
Dialogue: 0,0:18:31.54,0:18:34.16,Default,Chojo,0,0,0,,Cô ấy không bị thương đâu. Chỉ ngất xỉu thôi.
Dialogue: 0,0:18:34.16,0:18:35.51,Default,Nao,0,0,0,,May quá đi mất.
Dialogue: 0,0:18:35.86,0:18:38.99,Default,Chojo,0,0,0,,Bọn chúng tóm cô ấy từ tối qua.\NCũng dễ hiểu thôi mà.
Dialogue: 0,0:18:39.48,0:18:41.54,Default,Chojo,0,0,0,,Mau đưa cô ấy tới chỗ nào an toàn trước đã.
Dialogue: 0,0:18:43.05,0:18:44.76,Default,Chojo,0,0,0,,Ồ, cô tỉnh lại rồi à?
Dialogue: 0,0:18:45.07,0:18:46.86,Default,Maruyama,0,0,0,,A-Anh Chin Red?!
Dialogue: 0,0:18:46.86,0:18:49.27,Default,Chojo,0,0,0,,Mặt đất ở đây gồ ghề lắm, cẩn thận nhé.
Dialogue: 0,0:18:49.81,0:18:54.27,Default,Maruyama,0,0,0,,H-Hả? Em nhớ mình bị kẻ nào đó\Nbắt cóc, xong rồi...
Dialogue: 0,0:18:54.70,0:18:57.41,Default,Chojo,0,0,0,,Bọn tôi vừa xử lý xong đám người đó rồi.
Dialogue: 0,0:18:57.41,0:18:59.28,Default,Chojo,0,0,0,,Chúng tôi sẽ bàn giao chúng cho cảnh sát địa phương.
Dialogue: 0,0:18:59.81,0:19:04.78,Default,Maruyama,0,0,0,,C-Cảm giác như lần nào anh cũng ra tay cứu em vậy.\NMới hôm trước còn...
Dialogue: 0,0:19:05.28,0:19:07.54,Default,Chojo,0,0,0,,Tên cướp giật ở đường số Sáu chứ gì?
Dialogue: 0,0:19:07.90,0:19:09.29,Default,Maruyama,0,0,0,,Anh vẫn nhớ chuyện đó sao ạ?
Dialogue: 0,0:19:09.29,0:19:13.81,Default,Chojo,0,0,0,,Sao lại không nhớ được chứ?\NChúng ta là đồng đội cùng bảo vệ Chinjuku mà.
Dialogue: 0,0:19:13.81,0:19:16.05,Default,Chojo,0,0,0,,Tôi biết cô đã nỗ lực vất vả thế nào mà.
Dialogue: 0,0:19:18.32,0:19:19.05,Default,Maruyama,0,0,0,,Anh Chin...
Dialogue: 0,0:19:19.40,0:19:21.85,Default,Maruyama,0,0,0,,Anh Chin Red!
Dialogue: 0,0:19:19.40,0:19:21.85,Top Italics,Changer,0,0,0,,Bùng nổ!
Dialogue: 0,0:19:21.85,0:19:23.32,Default,Nao,0,0,0,,Mình đang chứng kiến cảnh tượng quái quỷ gì thế này?
Dialogue: 0,0:19:23.32,0:19:25.31,Narrator,Narrator,0,0,0,,Và thế là, vụ án chính thức khép lại.
Dialogue: 0,0:19:25.68,0:19:30.80,Narrator,Narrator,0,0,0,,Những chiến công vang dội tại Chinjuku\Nđã đưa anh thành ngôi sao toàn quốc.
Dialogue: 0,0:19:25.31,0:19:29.56,Default,Sign,0,0,0,,{\an8}MÀN TRÌNH DIỄN KINH ĐIỂN KHÁC\NROBOT KHỔNG LỒ TÓM GỌN HÀNG LOẠT TỘI PHẠM?!
Dialogue: 0,0:19:29.56,0:19:31.48,Default,Sign,0,0,0,,{\an8}CHỈ SỐ CHIN-NIKKEI\NGIÁ TRỊ HIỆN TẠI: 71.053,49
Dialogue: 0,0:19:31.48,0:19:33.31,Default,Sign,0,0,0,,{\an8}BIẾN ĐỘNG HÔM QUA: +5555,55\NHIỆU ỨNG KINH TẾ CHIN RED!
Dialogue: 0,0:19:30.80,0:19:33.31,Narrator,Narrator,0,0,0,,Cơn sốt xoay quanh anh ta\Nthúc đẩy cả nền kinh tế Nhật Bản đi lên,
Dialogue: 0,0:19:33.31,0:19:38.19,Narrator,Narrator,0,0,0,,đưa danh tiếng của Chin Red chạm tới\Nđỉnh cao chói lọi nhất.
Dialogue: 0,0:19:36.19,0:19:38.19,Default,Sign,0,0,0,,{\an8}CƠN SỐT CHIN RED
Dialogue: 0,0:19:38.19,0:19:40.45,Default,Sign,0,0,0,,{\an8}NGÀY HÔM SAU
Dialogue: 0,0:19:38.98,0:19:39.75,Narrator,Narrator,0,0,0,,Cho tới khi...
Dialogue: 0,0:19:41.01,0:19:44.97,Default,Chief,0,0,0,,Tạm thời cậu phải tiết chế lại cái trò\NChin Red đó trong thời gian tới đi.
Dialogue: 0,0:19:48.47,0:19:52.36,Default,Chojo,0,0,0,,Ơ-Ơ kìa... Nhưng Trưởng đồn ơi,\NChin Red đang cực kỳ được lòng dân chúng mà.
Dialogue: 0,0:19:52.36,0:19:55.21,Default,Chief,0,0,0,,Chính sự nổi tiếng đó đang biến thành\Nrắc rối lớn đấy.
Dialogue: 0,0:19:55.66,0:19:57.46,Default,Chief,0,0,0,,Ra nhìn bên ngoài đồn cảnh sát mà xem.
Dialogue: 0,0:19:57.81,0:19:59.73,Default,Chief,0,0,0,,Cả đám đông đang hò hét đòi gặp Chin Red kìa.
Dialogue: 0,0:19:57.81,0:19:59.73,Top,Citizen 1,0,0,0,,Mau gọi Chin Red ra đây!
Dialogue: 0,0:19:59.73,0:20:02.56,Top,Citizen 2,0,0,0,,Trưởng đồn phải công khai danh tính thật\Ncủa Chin Red! Cả địa chỉ nhà nữa!
Dialogue: 0,0:20:02.56,0:20:05.81,Top,Citizen 3,0,0,0,,Thôi khai tuột tuồn tuột luôn đi!\NKể hết mọi thứ cho tụi tôi nghe!
Dialogue: 0,0:20:09.03,0:20:12.98,Default,Chief,0,0,0,,Bọn họ sắp bạo loạn tới nơi rồi,\Nmà ta lại chẳng dám mạo hiểm cưỡng chế giải tán.
Dialogue: 0,0:20:12.98,0:20:16.98,Default,Chief,0,0,0,,Chưa kể lúc gặp chuyện cần giúp đỡ,\Ndân tình cũng chỉ réo tên Chin Red thôi.
Dialogue: 0,0:20:16.98,0:20:18.86,Top,Citizen 4,0,0,0,,Giao Chin Red ra cho bọn tôi ngay!
Dialogue: 0,0:20:18.86,0:20:19.73,Top,Citizen 5,0,0,0,,Cho chúng tôi gặp Red!
Dialogue: 0,0:20:17.38,0:20:19.73,Default,Chief,0,0,0,,Trớ trêu thật đấy, nhưng sự nổi tiếng của Chin Red
Dialogue: 0,0:20:19.73,0:20:24.02,Default,Chief,0,0,0,,còn rắc rối gấp bội sự căm ghét dành cho\Ntên cảnh sát tâm linh tai họa như cậu đấy.
Dialogue: 0,0:20:24.02,0:20:26.12,Default,Chojo,0,0,0,,Kh-Không thể nào.
Dialogue: 0,0:20:26.20,0:20:28.29,Default,Sign,0,0,0,,{\an8}CHIN
Dialogue: 0,0:20:28.49,0:20:31.37,Default,Chief,0,0,0,,Cậu phải tạm thời nằm im thở khẽ\Ncho tới khi mọi chuyện lắng xuống!
Dialogue: 0,0:20:31.37,0:20:33.75,Default,Chojo,0,0,0,,Không đời nào!
Dialogue: 0,0:20:34.08,0:20:36.34,Default,Sumikawa,0,0,0,,Dạo này chẳng thấy tin tức gì về\NChin Red nữa hết trơn.
Dialogue: 0,0:20:36.34,0:20:38.91,Default,Sumikawa,0,0,0,,Chắc là Maru đang vật vã vì\Nhội chứng cai nghiện Chin Red lắm đây.
Dialogue: 0,0:20:38.91,0:20:39.88,Default,Maruyama,0,0,0,,Thì tất nhiên rồi.
Dialogue: 0,0:20:40.17,0:20:44.13,Default,Maruyama,0,0,0,,Nhưng tớ không còn chỉ biết cuồng si ngưỡng mộ anh ấy\Nnhư bao người hâm mộ bình thường khác nữa đâu.
Dialogue: 0,0:20:44.64,0:20:49.41,Default,Maruyama,0,0,0,,Anh Chin Red từng bảo tớ là đồng đội\Ncùng chung tay bảo vệ Chinjuku.
Dialogue: 0,0:20:49.41,0:20:53.50,Default,Maruyama,0,0,0,,Vậy nên lúc anh ấy vắng mặt,\Ntớ không thể lãng phí thời gian ủ rũ buồn bã được.
Dialogue: 0,0:20:53.50,0:20:54.14,Default,Maruyama,0,0,0,,Với lại...
Dialogue: 0,0:20:54.45,0:20:57.03,Flashback Italics,Chojo,0,0,0,,Tôi biết cô đã nỗ lực vất vả thế nào mà.
Dialogue: 0,0:20:57.03,0:20:59.77,Default,Maruyama,0,0,0,,Tớ tin anh Chin Red vẫn luôn dõi theo tớ ở ngoài kia.
Dialogue: 0,0:21:00.09,0:21:03.92,Default,Maruyama,0,0,0,,Tớ muốn bảo vệ Chinjuku theo cách\Nkhiến anh ấy phải tự hào.
Dialogue: 0,0:21:04.60,0:21:07.35,Default,Sumikawa,0,0,0,,Xem ra tình yêu đã giúp Maru mạnh mẽ hơn hẳn rồi.
Dialogue: 0,0:21:09.62,0:21:14.48,Default,Maruyama,0,0,0,,Hơn nữa, lúc anh ấy ôm tớ trong vòng tay,\Ntớ cảm giác như hai tâm hồn đã hòa làm một.
Dialogue: 0,0:21:14.48,0:21:19.03,Default,Maruyama,0,0,0,,Dù không rõ diện mạo thật của anh ấy ra sao,\Ntớ cá chỉ cần chạm mặt ngoài đời là tớ nhận ra ngay.
Dialogue: 0,0:21:17.53,0:21:20.76,Top,Chojo,0,0,0,,Cho tôi giúp đỡ mọi người với đi.
Dialogue: 0,0:21:21.86,0:21:25.15,Default,Chojo,0,0,0,,Tôi muốn đi giúp người cơ.
Dialogue: 0,0:21:25.15,0:21:29.63,Default,Chojo,0,0,0,,Hãy để tôi ra tay tương trợ những kẻ khốn khó,\Nlũ khốn nạn kia.
Dialogue: 0,0:21:29.63,0:21:31.72,Default,Maruyama,0,0,0,,Tên cảnh sát tâm linh kìa!
Dialogue: 0,0:21:30.14,0:21:33.74,Top,Chojo,0,0,0,,Tôi... Tôi là siêu anh hùng mà.
Dialogue: 0,0:21:33.74,0:21:35.24,Default,Maruyama,0,0,0,,Hắn đang lảm nhảm cái gì thế?
Dialogue: 0,0:21:35.24,0:21:37.04,Default,Maruyama,0,0,0,,Tránh xa tụi tôi ra, đồ lập dị!
Dialogue: 0,0:21:37.04,0:21:38.77,Default,Sumikawa,0,0,0,,Cút ngay đi, đồ biến thái!
Dialogue: 0,0:21:39.07,0:21:43.34,Narrator,Narrator,0,0,0,,Bé Pon quyết định giữ kín sự thật này cho riêng mình.
Dialogue: 0,0:23:14.99,0:23:16.49,Default,Sign,0,0,0,,{\an8\pos(297.5,189.5)}GIỚI THIỆU TẬP TIẾP THEO
Dialogue: 0,0:23:15.54,0:23:16.49,Default,Nao,0,0,0,,{\an8}Là Nao đây.
Dialogue: 0,0:23:16.49,0:23:18.80,Default,Nao,0,0,0,,Giống như trò chơi điện tử,\Ncuộc đời cũng có kẻ thắng người thua.
Dialogue: 0,0:23:18.80,0:23:21.76,Default,Nao,0,0,0,,Hình như nỗi buồn sắp đẩy tiền bối Chojo hắc hóa rồi.\NMà khoan, đây rốt cuộc là câu chuyện {\i1}gì{\i0} vậy?
Dialogue: 0,0:23:21.76,0:23:25.75,Default,Nao,0,0,0,,Nhưng không sao cả, vì mục tiêu của tụi mình\Nđâu phải thắng thua. Ta luôn tìm được lối đi thứ ba.
Dialogue: 0,0:23:25.75,0:23:28.03,Default,Nao,0,0,0,,Chưa kể, tôi sắp biến thành\Nmột tuyệt thế giai nhân nữa đấy.
Dialogue: 0,0:23:28.03,0:23:30.01,Default,Nao,0,0,0,,Nói thật lòng đấy, bộ này rốt cuộc là thể loại {\i1}gì{\i0} hả trời?!

