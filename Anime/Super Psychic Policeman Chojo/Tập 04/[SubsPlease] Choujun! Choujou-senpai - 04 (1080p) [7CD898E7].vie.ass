Dialogue: 0,0:00:01.13,0:00:04.98,Italics,Nao,0,0,0,,Kabuki-cho ở Chinjuku. Một trong những \Nkhu ăn chơi giải trí sầm uất bậc nhất Nhật Bản.
Dialogue: 0,0:00:05.54,0:00:09.04,Italics,Nao,0,0,0,,Đồn cảnh sát Tây Chinjuku của chúng tôi \Ntọa lạc khiêm tốn nơi góc phố này.
Dialogue: 0,0:00:09.73,0:00:12.24,Default,Lily,0,0,0,,Hế lô. Có gì hot không?
Dialogue: 0,0:00:12.24,0:00:14.99,Default,Lily,0,0,0,,Hử? Ông cảnh sát tâm linh đâu rồi?
Dialogue: 0,0:00:14.99,0:00:17.12,Default,Nao,0,0,0,,Á, Lily! Chào mừng tới chơi nhé.
Dialogue: 0,0:00:17.12,0:00:19.75,Default,Lily,0,0,0,,Bác Hosaka rõ ràng là đang ở đây rồi.
Dialogue: 0,0:00:21.21,0:00:23.75,Default,Lily,0,0,0,,Con gì đây? Robot phục vụ bàn à?
Dialogue: 0,0:00:24.16,0:00:26.63,Default,Copbot,0,0,0,,Tôi là Copbot, cảnh sát người máy.
Dialogue: 0,0:00:28.06,0:00:29.20,Default,Lily,0,0,0,,Ăn tí snack không cưng?
Dialogue: 0,0:00:29.20,0:00:31.85,Default,Copbot,0,0,0,,Hành vi đó có thể bị quy chụp là hối lộ đấy.
Dialogue: 0,0:00:31.85,0:00:33.39,Default,Hosaka,0,0,0,,Chú em phải làm với bác một chén mới được.
Dialogue: 0,0:00:33.39,0:00:37.47,Top,Copbot,0,0,0,,Tôi vẫn đang trong ca trực, xin phép từ chối.
Dialogue: 0,0:00:35.27,0:00:37.47,Italics,Nao,0,0,0,,Dạo gần đây, đồn cảnh sát của chúng tôi...
Dialogue: 0,0:00:37.47,0:00:40.14,Italics,Nao,0,0,0,,...đã trở thành tụ điểm tụ tập của đủ thành phần, \Ntạo nên một môi trường làm việc vô cùng náo nhiệt.
Dialogue: 0,0:00:41.21,0:00:42.64,Default,Inukai,0,0,0,,Cái cảnh tượng quái quỷ gì thế này?
Dialogue: 0,0:00:43.64,0:00:46.29,Default,Inukai,0,0,0,,Còn tệ hại hơn cả lời đồn đại.
Dialogue: 0,0:00:46.86,0:00:51.32,Default,Inukai,0,0,0,,Đồn Tây Chinjuku đúng thực là \Nmồ chôn sự nghiệp của giới cảnh sát.
Dialogue: 0,0:00:52.15,0:00:55.15,Italics,Nao,0,0,0,,Thế rồi, một bóng đen đầy sát khí bỗng xuất hiện...
Dialogue: 0,0:00:55.85,0:00:57.16,Default,Copbot,0,0,0,,Là ngài!
Dialogue: 0,0:00:57.40,0:01:00.06,Italics,Nao,0,0,0,,...đe dọa sự yên bình nơi làm việc của chúng tôi.
Dialogue: 0,0:02:31.45,0:02:34.25,Narrator,Narrator,0,0,0,,Tập 4: Tiền bối "Đã xem không rep".
Dialogue: 0,0:02:31.00,0:02:34.25,Default,Sign,0,0,0,,{\an8}TẬP 4, PHẦN A: \NTIỀN BỐI "ĐÃ XEM KHÔNG REP"
Dialogue: 0,0:02:41.32,0:02:44.01,Default,Inukai,0,0,0,,Một đồn cảnh sát mà lại biến thành \Ntụ điểm đàn đúm của đám dân thường ư?
Dialogue: 0,0:02:46.85,0:02:49.85,Default,Inukai,0,0,0,,Nơi này đúng là ổ dung túng \Ncho sự tha hóa trụy lạc!
Dialogue: 0,0:02:50.98,0:02:51.98,Default,Hosaka,0,0,0,,Gì vậy cha nội?
Dialogue: 0,0:02:51.98,0:02:53.70,Default,Lily,0,0,0,,Tên này rốt cuộc là ai thế hả?
Dialogue: 0,0:02:53.70,0:02:55.36,Default,Copbot,0,0,0,,Đ-Đừng có vô lễ!
Dialogue: 0,0:02:55.36,0:02:58.86,Default,Copbot,0,0,0,,K-Kính xin lỗi ngài. Tôi không ngờ \Nđám thường dân hạ đẳng này lại làm ngài phật ý.
Dialogue: 0,0:02:58.86,0:03:01.36,Default,Copbot,0,0,0,,Dân trí ở cái khu phố này đúng là tệ hại thật đấy.
Dialogue: 0,0:03:01.96,0:03:04.07,Default,Copbot,0,0,0,,Trà mọn không ngon, kính mời ngài dùng tạm ạ.
Dialogue: 0,0:03:04.07,0:03:07.53,Italics,Nao,0,0,0,,C-Copbot vừa tự giác bắt chước \Nmấy con robot nhà hàng gia đình đấy à?
Dialogue: 0,0:03:05.87,0:03:11.37,Default,Sign,0,0,0,,{\an8}COPBOT ĐÃ TIẾN HÓA THÀNH MẤY CON ROBOT \NPHỤC VỤ TRONG NHÀ HÀNG GIA ĐÌNH
Dialogue: 0,0:03:07.53,0:03:09.76,Default,Catbot,0,0,0,,Món của quý khách đây meow~
Dialogue: 0,0:03:09.76,0:03:11.37,Default,Catbot,0,0,0,,Cảm ơn quý khách rất meow-ch~
Dialogue: 0,0:03:11.37,0:03:13.75,Default,Nao,0,0,0,,Có chuyện gì thế, Copbot? \NCậu biết người này à?
Dialogue: 0,0:03:13.75,0:03:17.38,Default,Copbot,0,0,0,,Đọc thông báo từ Tổng cục cảnh sát \Nthì chết ai hả, Đồng chí Ippongi?
Dialogue: 0,0:03:17.38,0:03:19.38,Default,Copbot,0,0,0,,Trên tin tức truyền hình cũng đưa đầy ra rồi kìa.
Dialogue: 0,0:03:19.38,0:03:23.89,Default,Sign,0,0,0,,{\an8}TỘI PHẠM GIA TĂNG TẠI CHINJUKU\NSỞ CẢNH SÁT ĐIỀU ĐỘNG THÊM NHÂN SỰ
Dialogue: 0,0:03:19.38,0:03:20.90,Default,Copbot,0,0,0,,Trước tình hình tội phạm gia tăng chóng mặt,
Dialogue: 0,0:03:20.90,0:03:23.89,Default,Copbot,0,0,0,,Tổng cục đã điều động thêm nhiều nhân sự, \Nbao gồm cả các cấp Cảnh thị.
Dialogue: 0,0:03:23.89,0:03:26.18,Default,Copbot,0,0,0,,Tại khu Chinjuku này, họ chính là \Nnhững quan chức tinh anh phụ trách bộ máy,
Dialogue: 0,0:03:26.18,0:03:29.39,Default,Copbot,0,0,0,,nắm trọn thực quyền từ nhân sự \Ncho đến điều tra phá án.
Dialogue: 0,0:03:29.39,0:03:33.33,Default,Copbot,0,0,0,,{\an8}Người đời gọi họ là \NĐội điều tra tinh anh Chinjuku.
Dialogue: 0,0:03:30.39,0:03:34.65,Default,Sign,0,0,0,,{\an8\pos(271.5,222.5)}ĐỘI ĐIỀU TRA TINH ANH CHINJUKU
Dialogue: 0,0:03:33.33,0:03:34.65,Default,Nao,0,0,0,,{\an8}Là lãnh đạo cấp cao sao?!
Dialogue: 0,0:03:36.02,0:03:39.03,Default,Lily,0,0,0,,Oa, xịn xò ghê ta. \NY chang mấy phim hình sự trên tivi luôn.
Dialogue: 0,0:03:39.03,0:03:42.74,Default,Lily,0,0,0,,Mấy phim đó hay có kiểu mấy tay \Nthượng đẳng tỏ vẻ ta đây hãm cành cạch—
Dialogue: 0,0:03:40.57,0:03:42.99,Default,Sign,0,0,0,,{\an8}TỎ VẺ THƯỢNG ĐẲNG. HÃM CÀNH CẠCH
Dialogue: 0,0:03:42.74,0:03:44.53,Default,Copbot,0,0,0,,Câm miệng lại, mụ đàn bà kia!
Dialogue: 0,0:03:44.53,0:03:46.08,Default,Hosaka,0,0,0,,Thằng nhóc kia mày tưởng mày là ai?
Dialogue: 0,0:03:46.08,0:03:48.04,Default,Copbot,0,0,0,,Cả lão già khọm kia nữa, ngậm mồm vào!
Dialogue: 0,0:03:48.04,0:03:51.16,Default,Nao,0,0,0,,Thế... ngài đến đồn chúng tôi có việc gì ạ?
Dialogue: 0,0:03:51.16,0:03:54.98,Default,Inukai,0,0,0,,Đây là việc nội bộ của cảnh sát, \Nyêu cầu đám người ngoài rời khỏi đây ngay.
Dialogue: 0,0:03:54.98,0:03:55.84,Default,Inukai,0,0,0,,Keinain.
Dialogue: 0,0:03:55.84,0:03:56.54,Default,Keinain,0,0,0,,Rõ, thưa sếp.
Dialogue: 0,0:03:56.99,0:03:58.08,Default,Keinain,0,0,0,,Mời hai người ra ngoài.
Dialogue: 0,0:03:58.08,0:03:59.44,Default,Lily,0,0,0,,Hả, thiệt luôn á?
Dialogue: 0,0:03:59.44,0:04:02.42,Default,Hosaka,0,0,0,,Nhưng tôi còn chưa kịp uống xong mà!
Dialogue: 0,0:04:03.28,0:04:05.43,Default,Inukai,0,0,0,,Dù hơi muộn màng, nhưng cho phép tôi tự giới thiệu...
Dialogue: 0,0:04:05.43,0:04:07.31,Default,Inukai,0,0,0,,{\an8}Tôi là Inukai Yuki.
Dialogue: 0,0:04:06.14,0:04:11.18,Default,Sign,0,0,0,,{\an8\pos(216.5,161.5)}CẢNH THỊ\NỦY VIÊN INUKAI YUKI
Dialogue: 0,0:04:07.31,0:04:11.18,Default,Inukai,0,0,0,,{\an8}Cấp bậc Cảnh thị, kiêm Ủy viên thanh tra \Ntại Sở Cảnh sát khu vực Chinjuku.
Dialogue: 0,0:04:12.39,0:04:14.19,Default,Copbot,0,0,0,,Xét về cấp bậc thì Cảnh thị...
Dialogue: 0,0:04:15.36,0:04:17.34,Default,Copbot,0,0,0,,ngang hàng với Trưởng đồn của chúng ta đấy!
Dialogue: 0,0:04:14.19,0:04:16.24,Default,Sign,0,0,0,,{\an8}CẢNH SÁT TUẦN TRA
Dialogue: 0,0:04:16.40,0:04:18.69,Default,Sign,0,0,0,,{\an8}CẢNH THỊ
Dialogue: 0,0:04:17.34,0:04:18.69,Default,Nao,0,0,0,,Thật á?!
Dialogue: 0,0:04:19.14,0:04:21.44,Default,Nao,0,0,0,,Nhưng trông anh ta chỉ tầm độ ngoài ba mươi thôi mà?
Dialogue: 0,0:04:21.44,0:04:22.78,Default,Nao,0,0,0,,Giỏi thật đấy.
Dialogue: 0,0:04:22.78,0:04:24.45,Default,Inukai,0,0,0,,Còn đây là cấp dưới của tôi, Keinain.
Dialogue: 0,0:04:24.45,0:04:26.45,Default,Sign,0,0,0,,{\an8}CẢNH BỘ BỔ\NKEINAIN HAJIME
Dialogue: 0,0:04:26.45,0:04:30.45,Default,Inukai,0,0,0,,Nhiệm vụ của chúng tôi ở đây \Nlà giám sát việc siết chặt kỷ cương kỷ luật.
Dialogue: 0,0:04:28.91,0:04:30.45,Default,Sign,0,0,0,,{\an8}SIẾT CHẶT KỶ CƯƠNG KỶ LUẬT
Dialogue: 0,0:04:30.79,0:04:32.97,Default,Nao,0,0,0,,"Siết chặt... kẹo gừng sao ạ?"
Dialogue: 0,0:04:30.45,0:04:34.71,Default,Sign,0,0,0,,{\an8}SIẾT CHẶT... KẸO GỪNG SAO?
Dialogue: 0,0:04:32.97,0:04:34.71,Default,Copbot,0,0,0,,Nói nôm na là xem chúng ta có tuân thủ quy tắc hay không đấy!
Dialogue: 0,0:04:34.71,0:04:37.02,Default,Nao,0,0,0,,T-Tôi thừa biết cái đó rồi nhé!
Dialogue: 0,0:04:37.02,0:04:40.70,Default,Inukai,0,0,0,,Vậy thì, hai người có đoán được \Ntại sao tôi lại xuất hiện ở đây không?
Dialogue: 0,0:04:40.70,0:04:45.47,Default,Nao,0,0,0,,Hở? Ngài mà hỏi {\i1}kiểu đó{\i0} thì...
Dialogue: 0,0:04:45.47,0:04:46.97,Italics,Nao,0,0,0,,...có hàng tỉ lý do trên đời luôn á.
Dialogue: 0,0:04:48.03,0:04:49.60,Default,Inukai,0,0,0,,Không cần phải căng thẳng thế đâu.
Dialogue: 0,0:04:50.12,0:04:52.77,Default,Inukai,0,0,0,,Tôi đánh giá rất cao hai người các cậu.
Dialogue: 0,0:04:53.71,0:04:57.86,Default,Inukai,0,0,0,,Đồng chí Nao Ippongi, người có công \Ntrong vụ bắt gọn băng đảng Shuei.
Dialogue: 0,0:04:58.68,0:05:02.60,Default,Inukai,0,0,0,,Copbot, kẻ lập công \Ntrong vụ tóm cổ Vua Tốc Độ mới đây.
Dialogue: 0,0:05:03.61,0:05:07.49,Default,Inukai,0,0,0,,Cả hai đều lập được chiến công xuất sắc. \NTất nhiên... đó là nếu...
Dialogue: 0,0:05:08.04,0:05:10.49,Default,Inukai,0,0,0,,...hai người {\i1}thực sự{\i0} là người phá những vụ án đó.
Dialogue: 0,0:05:13.87,0:05:15.16,Default,Nao,0,0,0,,Thôi toi rồi.
Dialogue: 0,0:05:15.50,0:05:17.27,Default,Inukai,0,0,0,,Thế nào hả Keinain?
Dialogue: 0,0:05:17.27,0:05:19.00,Default,Keinain,0,0,0,,Cô ta mạnh hơn em tưởng đấy.
Dialogue: 0,0:05:19.00,0:05:20.92,Default,Keinain,0,0,0,,Nếu đánh giáp lá cà thật, \Nem sẽ cần một món vũ khí dài hơn.
Dialogue: 0,0:05:20.92,0:05:21.82,Default,Keinain,0,0,0,,Dù vậy...
Dialogue: 0,0:05:22.42,0:05:25.24,Default,Keinain,0,0,0,,Tin đồn cô ta vung vẩy cả xe máy xúc \Nnhư cầm đồ chơi...
Dialogue: 0,0:05:25.24,0:05:27.18,Default,Keinain,0,0,0,,...để đập bẹp dí bọn yakuza đúng là phóng đại quá lời.
Dialogue: 0,0:05:27.18,0:05:28.93,Default,Nao,0,0,0,,C-Cái gì cơ chứ?!
Dialogue: 0,0:05:29.26,0:05:31.00,Default,Inukai,0,0,0,,Đánh giá nhân sự đấy.
Dialogue: 0,0:05:31.00,0:05:35.56,Default,Inukai,0,0,0,,Tên cảnh sát tâm linh đó trong báo cáo \Nlúc nào cũng hết lời tâng bốc hai người.
Dialogue: 0,0:05:35.56,0:05:39.19,Default,Inukai,0,0,0,,Xét việc một bên là lính mới xui xẻo \Nbị đá về đồn hẻo lánh này,
Dialogue: 0,0:05:39.19,0:05:42.15,Default,Inukai,0,0,0,,còn một bên là người máy \Nsuýt chút nữa thì bị tống vào bãi phế liệu,
Dialogue: 0,0:05:42.15,0:05:44.69,Default,Inukai,0,0,0,,thì nhiều khả năng hắn đã nhường lại \Ntoàn bộ công trạng của mình cho hai người.
Dialogue: 0,0:05:44.69,0:05:47.45,Default,Inukai,0,0,0,,Để rồi bản thân hắn tiếp tục giả đò \Nnhư một kẻ bất tài vô dụng,
Dialogue: 0,0:05:47.79,0:05:51.95,Default,Inukai,0,0,0,,{\an8}chôn chân ở cái bốt cảnh sát xó xỉnh này, \Ntrốn tránh trách nhiệm cống hiến cho xã hội!
Dialogue: 0,0:05:47.95,0:05:51.95,Default,Sign,0,0,0,,{\an8\pos(320,172)}BỐT CẢNH SÁT XÓ XỈNH
Dialogue: 0,0:05:51.95,0:05:53.45,Default,Inukai,0,0,0,,Tôi tuyệt đối không thể nào chấp nhận được!
Dialogue: 0,0:05:56.03,0:06:01.93,Default,Inukai,0,0,0,,Vì vậy, tôi sẽ tái đánh giá hai người \Nvà điều động về các vị trí thích hợp.
Dialogue: 0,0:06:02.46,0:06:04.71,Default,Inukai,0,0,0,,Và dĩ nhiên, tên cảnh sát tâm linh kia cũng thế.
Dialogue: 0,0:06:04.71,0:06:07.47,Default,Copbot,0,0,0,,Đ-Độc đoán quá mức rồi đấy ạ.
Dialogue: 0,0:06:07.47,0:06:10.35,Default,Nao,0,0,0,,Đ-Đúng là phong cách ngông cuồng \Nđặc sản của khu Chinjuku rồi.
Dialogue: 0,0:06:10.35,0:06:11.93,Default,Nao,0,0,0,,Lại còn xuất phát từ mấy ông lớn nữa chứ.
Dialogue: 0,0:06:11.93,0:06:14.22,Default,Nao,0,0,0,,Nói vậy có nghĩa là ba chúng ta...
Dialogue: 0,0:06:14.22,0:06:16.23,Default,Copbot/Nao,0,0,0,,...sắp bị chia cắt sao?
Dialogue: 0,0:06:18.65,0:06:19.73,Italics,Copbot/Nao,0,0,0,,Cơ mà thế có khi lại hay đấy chứ.
Dialogue: 0,0:06:20.02,0:06:21.23,Italics,Copbot/Nao,0,0,0,,Ấy không không không!
Dialogue: 0,0:06:21.23,0:06:25.23,Default,Inukai,0,0,0,,Bằng mọi giá, tôi nhất định sẽ lôi cổ \Ntên cảnh sát tâm linh kia khỏi chốn lưu đày này!
Dialogue: 0,0:06:25.78,0:06:27.11,Default,Inukai,0,0,0,,Bất chấp mọi thủ đoạn!
Dialogue: 0,0:06:27.66,0:06:29.24,Italics,Nao,0,0,0,,M-Mục tiêu của anh ta là tiền bối Chojo sao?
Dialogue: 0,0:06:29.72,0:06:31.74,Italics,Nao,0,0,0,,Người này rốt cuộc là ai vậy trời?
Dialogue: 0,0:06:32.69,0:06:36.75,Default,Chojo,0,0,0,,Bực cả mình. Người ta vừa tót đi \Nmua mấy hộp mô hình lắp ráp...
Dialogue: 0,0:06:37.20,0:06:40.12,Default,Chojo,0,0,0,,...vừa mò về đã thấy ngay \Nmột cục phiền toái to đùng ngáng đường.
Dialogue: 0,0:06:40.12,0:06:41.88,Default,Nao,0,0,0,,Tiền bối về rồi đấy à.
Dialogue: 0,0:06:42.47,0:06:44.38,Default,Chojo,0,0,0,,Đến đây có việc gì thế, Yuki?
Dialogue: 0,0:06:46.71,0:06:47.88,Default,Inukai,0,0,0,,Meguru...
Dialogue: 0,0:06:48.47,0:06:50.18,Default,Nao,0,0,0,,Meguru? Yuki sao?
Dialogue: 0,0:06:50.18,0:06:54.89,Default,Copbot,0,0,0,,Đ-Đồng chí Ippongi, \Ntôi vừa tra cứu hồ sơ của Tổng cục xong.
Dialogue: 0,0:06:55.23,0:06:59.01,Default,Copbot,0,0,0,,Hóa ra nhiều năm trước, \Nkhi ngài Inukai còn là Cảnh bộ bổ,
Dialogue: 0,0:06:59.01,0:07:02.00,Default,Copbot,0,0,0,,ngài ấy từng đóng quân tại Chinjuku \Ncùng với Tiền bối Chojo,
Dialogue: 0,0:07:02.00,0:07:05.01,Default,Copbot,0,0,0,,và hai người họ đã lập nên \Nnhững chiến công hiển hách lừng lẫy!
Dialogue: 0,0:07:05.01,0:07:06.20,Default,Nao,0,0,0,,Nói vậy có nghĩa là...
Dialogue: 0,0:07:06.20,0:07:08.40,Default,Copbot,0,0,0,,Hai người đó từng là cộng sự của nhau!
Dialogue: 0,0:07:09.07,0:07:12.41,Default,Nao,0,0,0,,Ý tôi là, dù biết thừa \Nmình không phải người đầu tiên...
Dialogue: 0,0:07:12.41,0:07:16.41,Default,Nao,0,0,0,,...nhưng không ngờ tiền bối {\i1}thực sự{\i0} \Ntừng bắt cặp với một quan chức máu mặt cơ đấy?!
Dialogue: 0,0:07:16.41,0:07:20.10,Default,Chojo,0,0,0,,Rồi sao? Sau ngần ấy năm bặt vô âm tín, \Ncơn gió độc nào đưa cậu tới đây hả Yuki?
Dialogue: 0,0:07:20.10,0:07:24.31,Default,Chojo,0,0,0,,Có việc thì ít ra cũng phải gọi điện trước chứ.
Dialogue: 0,0:07:24.72,0:07:26.30,Default,Inukai,0,0,0,,Tôi gọi rồi mà!
Dialogue: 0,0:07:28.12,0:07:30.82,Default,Inukai,0,0,0,,Tôi có nhắn tin trên LIME cho cậu đấy chứ!
Dialogue: 0,0:07:30.82,0:07:31.80,Default,Inukai,0,0,0,,Như mọi khi thôi!
Dialogue: 0,0:07:31.80,0:07:34.93,Default,Sign,0,0,0,,{\an8}TÔI ĐI THỊ SÁT ĐÂY!\NHẸN GẶP CẬU NGÀY MAI NHÉ!
Dialogue: 0,0:07:32.75,0:07:34.93,Default,Inukai,0,0,0,,Tôi còn nhắn hẳn câu "Hẹn gặp cậu ngày mai nhé!" cơ mà!
Dialogue: 0,0:07:36.01,0:07:38.48,Default,Chojo,0,0,0,,Ồ, nhắn thật này. Lại còn hiện "Đã xem" nữa chứ.
Dialogue: 0,0:07:38.48,0:07:40.06,Default,Chojo,0,0,0,,Chắc lúc đó buồn ngủ quá nên lười gõ rep ấy mà.
Dialogue: 0,0:07:40.06,0:07:42.56,Default,Inukai,0,0,0,,Vấn đề của cậu chính là cái thói đó đấy!
Dialogue: 0,0:07:42.56,0:07:46.61,Default,Inukai,0,0,0,,Thà rằng cậu đừng bấm vào xem, \Ncòn hơn là xem xong để đấy làm lòng người ta tan nát!
Dialogue: 0,0:07:46.61,0:07:49.28,Default,Keinain,0,0,0,,Đừng có khóc nhè vì bị người ta bơ tin nhắn \Nnữa sếp ơi.
Dialogue: 0,0:07:49.28,0:07:50.69,Default,Keinain,0,0,0,,Sếp làm bọn ma mới sợ phát khiếp kìa.
Dialogue: 0,0:07:50.95,0:07:53.74,Default,Inukai,0,0,0,,Chẳng bao giờ biết được \Nrốt cuộc hắn có thèm nghe mình nói hay không!
Dialogue: 0,0:07:53.74,0:07:58.29,Default,Inukai,0,0,0,,Cảnh sát với nhau sao chẳng thèm báo cáo gì hả? \NLúc nào cậu cũng rep nửa vời lấy lệ thế à!
Dialogue: 0,0:07:58.29,0:07:59.95,Default,Inukai,0,0,0,,Cậu... cậu vừa khui luôn hộp mô hình đấy à?!
Dialogue: 0,0:07:59.95,0:08:03.51,Default,Inukai,0,0,0,,Chúng ta đang nói chuyện nghiêm túc cơ mà?! \NCó nghe không đấy hả?!
Dialogue: 0,0:08:03.51,0:08:05.10,Default,Keinain,0,0,0,,Hạ hỏa đi sếp, bình tĩnh nào.
Dialogue: 0,0:08:05.10,0:08:08.42,Default,Keinain,0,0,0,,Thông cảm giùm, sếp tôi còn nặng tình \Nvới người cộng sự cũ này lắm.
Dialogue: 0,0:08:08.96,0:08:13.74,Default,Keinain,0,0,0,,Xa nhau bao lâu giờ gặp lại, \Ncảm xúc dâng trào ngập ngụa tới tận cổ ấy mà.
Dialogue: 0,0:08:13.74,0:08:14.68,Default,Chojo,0,0,0,,Ồ, "chỉ" có thế thôi á?
Dialogue: 0,0:08:14.68,0:08:18.36,Default,Nao,0,0,0,,Trông như anh ta đang muốn \Nbắt tiền bối rời khỏi đồn này đấy.
Dialogue: 0,0:08:19.44,0:08:23.19,Default,Chojo,0,0,0,,Thì từ xưa tới giờ, hễ dính tới điều tra \Nlà cậu ta lại như con chó săn bám riết không buông mà.
Dialogue: 0,0:08:23.52,0:08:25.67,Default,Inukai,0,0,0,,Điều đó xưa nay chưa từng thay đổi!
Dialogue: 0,0:08:25.67,0:08:27.44,Default,Inukai,0,0,0,,Tôi muốn chúng ta lại làm cộng sự, Meguru à!
Dialogue: 0,0:08:30.52,0:08:32.28,Default,Inukai,0,0,0,,Cậu không thuộc về cái nơi ổ chuột rác rưởi—
Dialogue: 0,0:08:32.28,0:08:34.32,Default,Chojo,0,0,0,,Xin lỗi nhé, Yuki.
Dialogue: 0,0:08:34.32,0:08:38.08,Default,Chojo,0,0,0,,Nhưng cái "ổ chuột" này dạo gần đây \Nở cũng thấy thoải mái phết rồi.
Dialogue: 0,0:08:40.20,0:08:41.26,Default,Chojo,0,0,0,,Cậu về được rồi đấy.
Dialogue: 0,0:08:41.83,0:08:45.95,Default,Inukai,0,0,0,,Tại sao hả Meguru?! Cái chốn xó xỉnh này \Nđang chôn vùi tài năng xuất chúng của cậu!
Dialogue: 0,0:08:45.95,0:08:48.21,Default,Inukai,0,0,0,,Lại còn nhường hết mọi công trạng \Ncho hai đứa vô tích sự này nữa chứ?
Dialogue: 0,0:08:49.55,0:08:51.66,Default,Inukai,0,0,0,,K-Không lẽ nào... Meguru...
Dialogue: 0,0:08:52.71,0:08:56.47,Default,Inukai,0,0,0,,Cậu đã phải lòng con nhỏ đó rồi sao?!
Dialogue: 0,0:08:56.47,0:08:57.72,Default,Chojo,0,0,0,,Cậu bị cuồng tôi tới mức {\i1}bệnh hoạn{\i0} rồi đấy à?
Dialogue: 0,0:08:57.72,0:09:00.81,Default,Inukai,0,0,0,,Đúng rồi! Thảo nào cậu lại nhường hết \Nchiến công cho cô ta!
Dialogue: 0,0:09:00.81,0:09:03.69,Default,Inukai,0,0,0,,Cậu đá tôi để chạy theo gái trẻ chứ gì!
Dialogue: 0,0:09:03.69,0:09:05.23,Default,Chojo,0,0,0,,Mày nghĩ tao là loại người thế nào hả thằng khùng?
Dialogue: 0,0:09:05.23,0:09:08.54,Default,Inukai,0,0,0,,Nghe tôi nói này Meguru! \NHãy suy nghĩ bằng lý trí đi!
Dialogue: 0,0:09:08.54,0:09:11.98,Default,Inukai,0,0,0,,Đúng là cô ta trẻ hơn, xinh đẹp hơn tôi...
Dialogue: 0,0:09:13.36,0:09:16.40,Default,Inukai,0,0,0,,Nhưng ngộ nhỡ cô ta cũng là \Nmột lão trung niên như tôi thì sao?
Dialogue: 0,0:09:16.40,0:09:17.36,Default,Chojo,0,0,0,,Thì cũng có sao đâu.
Dialogue: 0,0:09:17.36,0:09:19.96,Default,Inukai,0,0,0,,Hoặc nếu tôi là một thiếu nữ siêu cấp đáng yêu \Nthì thế nào?!
Dialogue: 0,0:09:19.96,0:09:21.12,Default,Chojo,0,0,0,,Càng chả liên quan.
Dialogue: 0,0:09:21.12,0:09:24.78,Default,Inukai,0,0,0,,Đừng có để bị mê hoặc \Nbởi mị lực đàn bà của cô ta, Meguru!
Dialogue: 0,0:09:25.84,0:09:28.13,Default,Nao,0,0,0,,Không phải như ngài nghĩ đâu, làm ơn bớt bớt lại giùm cái!
Dialogue: 0,0:09:28.13,0:09:30.63,Default,Nao,0,0,0,,Hiện tại anh ta chỉ là tiền bối của tôi thôi.
Dialogue: 0,0:09:30.63,0:09:34.05,Default,Nao,0,0,0,,Bọn tôi sẵn sàng quay lại làm người dưng \Nngay trong một nốt nhạc đấy nhé.
Dialogue: 0,0:09:34.05,0:09:36.76,Default,Chojo,0,0,0,,Cô lấy chuyện giải tán làm vũ khí cãi nhau đấy à?
Dialogue: 0,0:09:36.76,0:09:39.76,Default,Nao,0,0,0,,Nếu phải nói thật thì tôi với anh ta \Ncòn chẳng thèm hợp tính nhau nữa là.
Dialogue: 0,0:09:40.48,0:09:42.51,Default,Inukai,0,0,0,,Ồ, thật thế sao?
Dialogue: 0,0:09:43.42,0:09:46.27,Default,Inukai,0,0,0,,Nhưng nếu hai người không hợp nhau...
Dialogue: 0,0:09:46.27,0:09:49.81,Default,Inukai,0,0,0,,chẳng phải chứng tỏ là \Nhắn ta thích cô đến phát điên rồi sao?!
Dialogue: 0,0:09:49.81,0:09:52.52,Default,Nao,0,0,0,,Cái ông chú này bẻ lái kiểu gì cũng hãm được nhỉ?
Dialogue: 0,0:09:55.25,0:09:57.86,Default,Nao,0,0,0,,Hết thuốc chữa rồi, không thông não nổi.
Dialogue: 0,0:09:58.83,0:10:00.87,Default,Keinain,0,0,0,,Sếp ơi bình tĩnh, hạ hỏa, hạ hỏa nào.
Dialogue: 0,0:10:01.43,0:10:05.09,Default,Chojo,0,0,0,,Cậu ta từ xưa đã thuộc dạng não phẳng \Ndễ bị thôi miên tác dụng cực mạnh rồi.
Dialogue: 0,0:10:05.09,0:10:07.37,Default,Chojo,0,0,0,,Nói trắng ra là đồ ngốc bẩm sinh.
Dialogue: 0,0:10:07.37,0:10:08.37,Default,Chojo,0,0,0,,Mà thôi kệ đi.
Dialogue: 0,0:10:09.03,0:10:11.44,Default,Chojo,0,0,0,,Này. Cậu đang lạc đề hơi xa rồi đấy, Yuki.
Dialogue: 0,0:10:11.44,0:10:14.38,Default,Chojo,0,0,0,,Cậu đâu thể đánh giá năng lực hay điều động nhân sự \Ndựa trên cảm tính cá nhân được.
Dialogue: 0,0:10:14.38,0:10:17.84,Default,Chojo,0,0,0,,Vấn đề là ai mới đủ tư cách \Nlàm cộng sự của tôi. Đúng chứ?
Dialogue: 0,0:10:18.88,0:10:21.38,Default,Chojo,0,0,0,,Cứ tiếp tục bài đánh giá của cậu đi.
Dialogue: 0,0:10:21.38,0:10:23.89,Default,Chojo,0,0,0,,Rồi cậu sẽ thấy con khỉ đột nhà này \Nđấm khỏe đến mức nào.
Dialogue: 0,0:10:23.89,0:10:28.39,Default,Nao,0,0,0,,Ớ này này! Tiền bối lười quá \Nnên định phủi tay đẩy hết việc sang cho tôi đấy à?!
Dialogue: 0,0:10:27.28,0:10:28.39,Top,Inukai,0,0,0,,Cậu ấy nói rất có lý.
Dialogue: 0,0:10:28.76,0:10:31.02,Default,Inukai,0,0,0,,Được lắm, Nao Ippongi, để xem ai mới là kẻ vượt trội!
Dialogue: 0,0:10:31.02,0:10:32.27,Default,Nao,0,0,0,,Bằng cách nào cơ?
Dialogue: 0,0:10:32.27,0:10:36.94,Default,Inukai,0,0,0,,Đã đến lúc phân định xem ai trong hai chúng ta \Nxứng đáng làm cộng sự của Meguru!
Dialogue: 0,0:10:36.94,0:10:42.28,Default,Sign,0,0,0,,{\an8}INUKAI YUKI VS IPPONGI NAO
Dialogue: 0,0:10:36.94,0:10:40.97,Italics,Nao,0,0,0,,Mình phải đi tranh giành một ông chú trung niên \Nvới một ông chú trung niên khác sao trời?!
Dialogue: 0,0:10:42.28,0:10:45.04,Narrator,Narrator,0,0,0,,Siêu cảnh sát tâm linh Chojo.
Dialogue: 0,0:10:42.28,0:10:45.04,Default,Sign,0,0,0,,{\an8}INUKAI YUKI\NCẢNH THỊ TINH ANH
Dialogue: 0,0:10:45.04,0:10:48.66,Default,Sign,0,0,0,,{\an8}PHÒNG ĐIỀU TRA TINH ANH
Dialogue: 0,0:10:45.85,0:10:48.66,Italics,Inukai,0,0,0,,Tại Phòng Điều tra Tinh anh, \Nnơi tôi và Meguru từng công tác...
Dialogue: 0,0:10:49.09,0:10:53.59,Italics,Inukai,0,0,0,,bọn tôi chẳng bao giờ phải bận tâm tới \Nmấy vụ ẩu đả vặt vãnh tầm thường.
Dialogue: 0,0:10:53.59,0:10:56.05,Flashback Italics,Radio,0,0,0,,Tổng cục Cảnh sát gửi toàn bộ các đơn vị. \NTổng cục Cảnh sát gửi toàn bộ các đơn vị.
Dialogue: 0,0:10:56.52,0:11:02.03,Flashback Italics,Radio,0,0,0,,{\an8}Chúng ta vừa nhận được thư đe dọa đánh bom \Nkhắp toàn bộ khu vực Chinjuku.
Dialogue: 0,0:10:59.44,0:11:03.05,Italics,Inukai,0,0,0,,Bất cứ khi nào có đại án trọng điểm xảy ra,
Dialogue: 0,0:11:03.05,0:11:04.55,Italics,Inukai,0,0,0,,chúng tôi luôn là những người tiên phong có mặt!
Dialogue: 0,0:11:05.40,0:11:07.43,Flashback,Chojo,0,0,0,,Đi thôi nào, Yuki.
Dialogue: 0,0:11:07.43,0:11:10.31,Flashback,Inukai,0,0,0,,Được, xuất phát thôi Meguru!
Dialogue: 0,0:11:10.88,0:11:13.81,Italics,Inukai,0,0,0,,Chúng tôi từng là cặp bài trùng hoàn hảo nhất!
Dialogue: 0,0:11:16.82,0:11:18.02,Flashback,Inukai,0,0,0,,Thiệt tình chứ.
Dialogue: 0,0:11:19.28,0:11:21.95,Italics,Inukai,0,0,0,,Và chúng ta hoàn toàn có thể tái hợp!
Dialogue: 0,0:11:22.32,0:11:24.48,Default,Inukai,0,0,0,,Hãy quyết đấu đi, Nao Ippongi!
Dialogue: 0,0:11:24.48,0:11:26.95,Default,Inukai,0,0,0,,Kẻ chiến thắng sẽ là cộng sự của Meguru!
Dialogue: 0,0:11:28.09,0:11:31.04,Default,Chojo,0,0,0,,Nghe tự tin gớm nhỉ, Yuki.
Dialogue: 0,0:11:31.04,0:11:35.09,Default,Chojo,0,0,0,,Nhưng xét về sức mạnh thể chất thì ngay cả {\i1}cậu{\i0} \Ncũng lép vế hoàn toàn đấy.
Dialogue: 0,0:11:35.09,0:11:39.09,Default,Chojo,0,0,0,,Trừ khi cậu rút súng ra bắn, \Nchứ tay đôi thì không có cửa đọ lại con khỉ đột này đâu.
Dialogue: 0,0:11:40.64,0:11:43.09,Default,Inukai,0,0,0,,Ai bảo tôi sẽ thi thố sức mạnh cơ bắp chứ?
Dialogue: 0,0:11:43.09,0:11:46.62,Default,Inukai,0,0,0,,Bọn tôi là Phòng Điều tra Tinh anh, \Ncó toàn quyền quyết định thuyên chuyển nhân sự.
Dialogue: 0,0:11:47.85,0:11:50.99,Default,Inukai,0,0,0,,Và tôi có quyền tự đưa ra phương thức đánh giá!
Dialogue: 0,0:11:51.57,0:11:52.49,Default,Inukai,0,0,0,,Nói cách khác...
Dialogue: 0,0:11:55.43,0:11:59.11,Default,Inukai,0,0,0,,Đã đến lúc tổ chức: \NCuộc thi Đố vui "Vua am hiểu Meguru Chojo"!
Dialogue: 0,0:11:55.11,0:11:59.11,Default,Sign,0,0,0,,{\an8}CUỘC THI: VUA AM HIỂU MEGURU CHOJO
Dialogue: 0,0:11:59.11,0:12:00.82,Narrator,Narrator,0,0,0,,Tiền bối Đố vui.
Dialogue: 0,0:11:59.11,0:12:02.11,Default,Sign,0,0,0,,{\an8}TẬP 4, PHẦN B: TIỀN BỐI ĐỐ VUI
Dialogue: 0,0:12:00.82,0:12:02.12,Default,Chojo,0,0,0,,Tại sao?
Dialogue: 0,0:12:01.20,0:12:02.12,Default,Nao,0,0,0,,{\3c&H440E02&}Tại sao lại thế hả trời?!
Dialogue: 0,0:12:02.44,0:12:04.78,Default,Nao,0,0,0,,Tôi chưa từng {\i1}nghe thấy{\i0} \Nthể loại đánh giá nhân sự nào như thế này bao giờ!
Dialogue: 0,0:12:04.78,0:12:06.86,Default,Chojo,0,0,0,,Thế vụ đấm nhau tay đôi vứt cho chó ăn rồi à?
Dialogue: 0,0:12:06.86,0:12:08.32,Default,Inukai,0,0,0,,Vô cùng hợp lý là đằng khác!
Dialogue: 0,0:12:08.32,0:12:11.00,Default,Inukai,0,0,0,,Giữa hai cộng sự với nhau, \Nthứ gì quan trọng hơn sự thấu hiểu chứ?
Dialogue: 0,0:12:11.00,0:12:14.75,Default,Inukai,0,0,0,,Nên chúng ta sẽ phân định bằng một cuộc thi đố vui \Nxoay quanh người cộng sự tương lai!
Dialogue: 0,0:12:14.75,0:12:16.63,Default,Inukai,0,0,0,,Quá là chuẩn chỉ và hợp lý luôn!
Dialogue: 0,0:12:16.63,0:12:18.02,Default,Nao,0,0,0,,Nghe cũng có lý phết...
Dialogue: 0,0:12:18.02,0:12:19.17,Default,Chojo,0,0,0,,Đừng có để bị cuốn theo chứ con khỉ kia!
Dialogue: 0,0:12:19.17,0:12:21.89,Default,Chojo,0,0,0,,Cô mới quen tôi được bao lâu đâu, \Nthi cái này là bất lợi mười mươi rồi.
Dialogue: 0,0:12:22.30,0:12:23.26,Default,Chojo,0,0,0,,Ồ?
Dialogue: 0,0:12:23.26,0:12:27.76,Default,Chojo,0,0,0,,Sao chúng ta không nhờ hai kẻ nghe lén ngoài cửa \Nvào phụ một tay nhỉ, Keinain?
Dialogue: 0,0:12:29.00,0:12:30.59,Default,Nao,0,0,0,,Hai người đứng nghe lén nãy giờ đấy à?!
Dialogue: 0,0:12:31.56,0:12:33.02,Default,Inukai,0,0,0,,Luật chơi rất đơn giản.
Dialogue: 0,0:12:31.56,0:12:33.02,Default,Sign,0,0,0,,{\an8}GIẢI THÍCH LUẬT CHƠI
Dialogue: 0,0:12:33.36,0:12:36.77,Default,Inukai,0,0,0,,Hai người này sẽ lần lượt đặt các câu hỏi \Nliên quan đến Meguru dưới hình thức đố vui.
Dialogue: 0,0:12:37.17,0:12:39.73,Default,Lily,0,0,0,,Câu hỏi: Màu sắc yêu thích \Ncủa ông cảnh sát tâm linh là gì?
Dialogue: 0,0:12:36.77,0:12:46.28,Default,Sign,0,0,0,,{\an8}XANH DƯƠNG | ĐỎ
Dialogue: 0,0:12:39.73,0:12:40.44,Default,Nao,0,0,0,,Màu đỏ!
Dialogue: 0,0:12:40.44,0:12:41.25,Default,Inukai,0,0,0,,Xanh dương!
Dialogue: 0,0:12:41.25,0:12:43.80,Default,Chojo,0,0,0,,Inukai đúng rồi. Cậu được một điểm.
Dialogue: 0,0:12:43.80,0:12:46.28,Default,Inukai,0,0,0,,Chúng tôi sẽ trả lời, \Nvà Meguru sẽ là trọng tài chấm điểm.
Dialogue: 0,0:12:46.83,0:12:49.52,Default,Chojo,0,0,0,,Cậu thực sự muốn tôi làm trọng tài à?
Dialogue: 0,0:12:49.52,0:12:50.88,Default,Inukai,0,0,0,,Chuyện nhỏ, không thành vấn đề.
Dialogue: 0,0:12:50.88,0:12:53.78,Default,Inukai,0,0,0,,Tôi sẽ áp đảo tuyệt đối để không ai có thể dị nghị!
Dialogue: 0,0:12:53.78,0:12:55.23,Default,Chojo,0,0,0,,Gáy to gớm nhỉ.
Dialogue: 0,0:12:55.23,0:12:57.53,Default,Inukai,0,0,0,,Nào, xin mời câu hỏi đầu tiên!
Dialogue: 0,0:12:57.53,0:12:59.61,Default,Lily,0,0,0,,Hả, tui hả?
Dialogue: 0,0:12:59.61,0:13:02.42,Default,Lily,0,0,0,,Được rồi, làm câu khởi động cơ bản nhé.
Dialogue: 0,0:13:02.42,0:13:03.62,Default,Copbot,0,0,0,,Tè-te-té-te!
Dialogue: 0,0:13:03.62,0:13:05.43,Default,Lily,0,0,0,,Món ăn khoái khẩu của ông cảnh sát tâm linh là gì?
Dialogue: 0,0:13:05.80,0:13:08.38,Default,Sign,0,0,0,,{\an8}CÂU 1: MÓN KHOÁI KHẨU \NCỦA CẢNH SÁT TÂM LINH LÀ GÌ?
Dialogue: 0,0:13:06.33,0:13:09.43,Default,Copbot,0,0,0,,Thời gian suy nghĩ bắt đầu!
Dialogue: 0,0:13:09.77,0:13:11.38,Default,Nao,0,0,0,,Ủa? Cái gì thế này?
Dialogue: 0,0:13:11.38,0:13:14.86,Default,Copbot,0,0,0,,Vì đồn ta hơi tẻ nhạt, \Nnên tôi tạo thêm chút hiệu ứng hình ảnh cho sinh động ấy mà.
Dialogue: 0,0:13:14.86,0:13:16.56,Default,Chojo,0,0,0,,Sinh động cho ai ngắm vậy cha nội?
Dialogue: 0,0:13:16.88,0:13:19.06,Default,Copbot,0,0,0,,Xin mời ghi câu trả lời lên bảng được phát.
Dialogue: 0,0:13:22.25,0:13:24.19,Default,Nao,0,0,0,,Món khoái khẩu của anh ta...
Dialogue: 0,0:13:24.19,0:13:25.40,Default,Nao,0,0,0,,...chính là món này!
Dialogue: 0,0:13:25.40,0:13:27.85,Default,Nao,0,0,0,,Bùm! Nước mắt của trẻ con đang khóc!
Dialogue: 0,0:13:25.58,0:13:29.41,Default,Sign,0,0,0,,{\an8}NƯỚC MẮT CỦA TRẺ CON ĐANG KHÓC
Dialogue: 0,0:13:27.85,0:13:29.41,Default,Chojo,0,0,0,,Cái đó mà là đồ ăn à?!
Dialogue: 0,0:13:29.62,0:13:33.20,Default,Nao,0,0,0,,Hả? Chẳng phải tiền bối toàn {\i1}coi nó{\i0} như đồ ăn sao?
Dialogue: 0,0:13:33.20,0:13:36.77,Default,Nao,0,0,0,,Chắc chắn anh thấy nó ngọt ngào như mật ong chứ gì!
Dialogue: 0,0:13:38.67,0:13:41.18,Default,Chojo,0,0,0,,Cô nghĩ tôi là cái giống quái thai gì vậy hả?
Dialogue: 0,0:13:42.64,0:13:43.55,Default,Copbot,0,0,0,,Sai bét!
Dialogue: 0,0:13:43.55,0:13:45.30,Default,Chojo,0,0,0,,Nghiêm túc giùm một tí đi, Đồng chí Ngố!
Dialogue: 0,0:13:45.30,0:13:48.20,Default,Nao,0,0,0,,Tôi cực kỳ nghiêm túc luôn đấy chứ!
Dialogue: 0,0:13:48.20,0:13:50.73,Default,Inukai,0,0,0,,Chỉ làm được đến thế thôi sao, Nao Ippongi?
Dialogue: 0,0:13:51.30,0:13:55.93,Default,Sign,0,0,0,,{\an8}IPPONGI NAO | INUKAI YUKI
Dialogue: 0,0:13:51.30,0:13:53.80,Default,Inukai,0,0,0,,Xét việc hai người chỉ là bị ghép ngẫu nhiên,
Dialogue: 0,0:13:53.80,0:13:55.93,Default,Inukai,0,0,0,,cô căn bản không có cửa đọ lại tôi đâu!
Dialogue: 0,0:13:55.93,0:13:57.94,Default,Inukai,0,0,0,,Món ăn yêu thích nhất của Meguru là...
Dialogue: 0,0:13:57.94,0:13:59.44,Default,Inukai,0,0,0,,Bùm! Cơm cà ri!
Dialogue: 0,0:13:57.94,0:13:59.44,Default,Sign,0,0,0,,{\an8}CÀ RI
Dialogue: 0,0:14:00.28,0:14:02.00,Default,Chojo,0,0,0,,Chính xác. Cộng một điểm.
Dialogue: 0,0:14:01.95,0:14:02.57,Default,Sign,0,0,0,,{\an8}+1 ĐIỂM
Dialogue: 0,0:14:02.72,0:14:04.94,Default,Nao,0,0,0,,{\an8}Đúng là từng làm việc cùng nhau có khác—
Dialogue: 0,0:14:03.80,0:14:07.37,Default,Inukai,0,0,0,,Tiện thể nói luôn, Meguru thích cà ri gói ăn liền \Nhơn là cà ri nấu ở tiệm,
Dialogue: 0,0:14:07.37,0:14:09.32,Default,Inukai,0,0,0,,và cậu ấy khoái nhất là độ cay vừa phải.
Dialogue: 0,0:14:10.82,0:14:18.34,Default,Sign,0,0,0,,{\an8}CÀ RI\NINUKAI YUKI
Dialogue: 0,0:14:10.82,0:14:15.37,Default,Inukai,0,0,0,,"Chẳng có gì ngon bằng một nồi cà ri khổng lồ \Nđược nấu chung một mẻ cả."
Dialogue: 0,0:14:15.37,0:14:18.33,Default,Inukai,0,0,0,,Chính cái lý thuyết đó khiến cậu ấy đinh ninh \Ncà ri trong trại giam là món đỉnh cao nhất trần đời.
Dialogue: 0,0:14:18.33,0:14:22.84,Default,Inukai,0,0,0,,Cậu ấy cuồng cà ri tới mức từng nghiêm túc \Ntính chuyện phạm tội để được tống vào tù ăn thử.
Dialogue: 0,0:14:24.84,0:14:27.89,Default,Inukai,0,0,0,,Ôi, Meguru của tôi... \NThế nên tôi mới không thể dứt ra được—
Dialogue: 0,0:14:27.89,0:14:30.22,Default,Meguru,0,0,0,,Cái màn nói thêm sặc mùi biến thái này \Nlàm tao tởm lợm phát ớn.
Dialogue: 0,0:14:30.22,0:14:31.34,Default,Meguru,0,0,0,,Trừ năm điểm.
Dialogue: 0,0:14:29.93,0:14:31.34,Default,Sign,0,0,0,,{\an8}-5 ĐIỂM
Dialogue: 0,0:14:31.34,0:14:34.09,Default,Inukai,0,0,0,,Chết tiệt! Mình lỡ lậm quá đà rồi!
Dialogue: 0,0:14:34.09,0:14:37.60,Default,Keinain,0,0,0,,Sếp à, quả này đến em cũng không bênh nổi sếp đâu. \NTởm lợm quá thể đáng.
Dialogue: 0,0:14:37.60,0:14:39.98,Default,Hosaka,0,0,0,,Chắc tới lượt tôi rồi nhỉ.
Dialogue: 0,0:14:40.32,0:14:41.61,Default,Hosaka,0,0,0,,Chuyện là khi chú mày làm hỏng việc ở công ty,
Dialogue: 0,0:14:41.61,0:14:46.99,Default,Hosaka,0,0,0,,xong thằng sếp nhỏ tuổi hơn chú mày lại bảo: \N"Này ông già, chỉ số IQ của ông được bao nhiêu thế?"
Dialogue: 0,0:14:46.99,0:14:48.34,Default,Hosaka,0,0,0,,Bác vừa bị y chang vậy đấy.
Dialogue: 0,0:14:48.34,0:14:50.24,Default,Chojo,0,0,0,,Lại thêm một thành phần có vấn đề về tâm lý nữa.
Dialogue: 0,0:14:50.24,0:14:52.74,Default,Hosaka,0,0,0,,Tóm lại thì, IQ của cậu bạn này là bao nhiêu?
Dialogue: 0,0:14:53.11,0:14:54.62,Default,Chojo,0,0,0,,{\an8}Đố cái thể loại gì đấy hả?
Dialogue: 0,0:14:54.91,0:14:56.66,Default,Sign,0,0,0,,{\an8}CÂU 2: CHỈ SỐ IQ CỦA HẮN LÀ BAO NHIÊU?
Dialogue: 0,0:14:54.91,0:14:57.37,Default,Copbot,0,0,0,,Thời gian suy nghĩ bắt đầu!
Dialogue: 0,0:14:59.37,0:15:00.25,Default,Nao,0,0,0,,A, tôi trước!
Dialogue: 0,0:15:00.61,0:15:03.00,Default,Copbot,0,0,0,,Xin mời câu trả lời của Đồng chí Ippongi!
Dialogue: 0,0:15:03.00,0:15:05.71,Default,Nao,0,0,0,,Bên trái là 2.0, còn bên phải là 1.0!
Dialogue: 0,0:15:03.00,0:15:07.51,Default,Sign,0,0,0,,{\an8}IQ BÊN TRÁI LÀ 2.0, \NBÊN PHẢI LÀ 1.0
Dialogue: 0,0:15:05.71,0:15:07.51,Default,Chojo,0,0,0,,Nhắc đến cái IQ đáy xã hội...
Dialogue: 0,0:15:07.51,0:15:09.64,Default,Chojo,0,0,0,,Cô trả lời cái quỷ gì thế hả con Ngố kia?
Dialogue: 0,0:15:09.64,0:15:11.51,Default,Chojo,0,0,0,,Chỉ số IQ làm quái gì có chia bên trái bên phải!
Dialogue: 0,0:15:11.51,0:15:15.76,Default,Sign,0,0,0,,{\an8}TÓC TRẮNG | TÓC ĐEN
Dialogue: 0,0:15:11.51,0:15:14.47,Default,Chojo,0,0,0,,Cô nghĩ bên phải thấp hơn \Nchỉ vì tóc bên đó của tôi màu trắng đấy à?!
Dialogue: 0,0:15:14.47,0:15:15.76,Default,Nao,0,0,0,,Tiền bối tinh ý ghê!
Dialogue: 0,0:15:15.76,0:15:19.02,Default,Chojo,0,0,0,,Tôi vả cho rụng răng bây giờ! \NVà đương nhiên là sai bét tè lè nhè rồi!
Dialogue: 0,0:15:21.21,0:15:22.86,Italics,Inukai,0,0,0,,Ngu xuẩn. Cơ hội của ta đây rồi!
Dialogue: 0,0:15:23.65,0:15:25.02,Default,Copbot,0,0,0,,Xin mời ngài Cảnh thị Inukai!
Dialogue: 0,0:15:25.02,0:15:26.72,Default,Inukai,0,0,0,,Đáp án là: Không rõ!
Dialogue: 0,0:15:25.02,0:15:28.90,Default,Sign,0,0,0,,{\an8}KHÔNG RÕ
Dialogue: 0,0:15:26.72,0:15:28.90,Default,Inukai,0,0,0,,Meguru chưa từng làm bài kiểm tra IQ nào cả!
Dialogue: 0,0:15:29.64,0:15:31.81,Default,Chojo,0,0,0,,Chính xác. Cộng một điểm.
Dialogue: 0,0:15:31.41,0:15:33.58,Default,Sign,0,0,0,,{\an8}-4 ĐIỂM + 1 = -3 ĐIỂM
Dialogue: 0,0:15:31.81,0:15:34.03,Default,Hosaka,0,0,0,,Đáp án nghe chán òm.
Dialogue: 0,0:15:34.36,0:15:35.91,Default,Inukai,0,0,0,,Xin được nói thêm là...
Dialogue: 0,0:15:35.91,0:15:40.16,Default,Inukai,0,0,0,,{\an8}Có một dạo hễ ai hỏi IQ bao nhiêu \Nlà Meguru lại chém gió bảo mình được 152.
Dialogue: 0,0:15:41.16,0:15:45.54,Default,Inukai,0,0,0,,{\an8}Cậu ấy chọn bừa con số đó \Nvì nghe có vẻ rất chi là thuyết phục.
Dialogue: 0,0:15:46.34,0:15:47.27,Default,Inukai,0,0,0,,Đáng yêu chết đi được ấy.
Dialogue: 0,0:15:47.72,0:15:50.05,Default,Chojo,0,0,0,,Trừ mười điểm. \NBớt đào bới quá khứ đen tối của người khác giùm tao!
Dialogue: 0,0:15:47.80,0:15:50.05,Default,Sign,0,0,0,,{\an8}-10 ĐIỂM
Dialogue: 0,0:15:50.96,0:15:52.06,Default,Inukai,0,0,0,,Lại lỡ miệng nữa rồi...
Dialogue: 0,0:15:50.05,0:15:54.06,Default,Sign,0,0,0,,{\an8}-3 ĐIỂM - 10 = -13 ĐIỂM
Dialogue: 0,0:15:52.06,0:15:54.05,Default,Keinain,0,0,0,,Sếp ơi, tém tém cái nết lại giùm em đi.
Dialogue: 0,0:15:54.47,0:15:56.68,Default,Lily,0,0,0,,Câu tiếp theo nên đố cái gì ta?
Dialogue: 0,0:15:56.68,0:15:59.98,Default,Hosaka,0,0,0,,Tôi muốn câu nào cay cay một tí.
Dialogue: 0,0:15:59.98,0:16:04.39,Default,Hosaka,0,0,0,,Cơ mà nếu muốn con bé Ngố kia \Ntrả lời đúng được thì...
Dialogue: 0,0:16:04.39,0:16:05.89,Default,Lily,0,0,0,,Thế thì...
Dialogue: 0,0:16:05.89,0:16:06.69,Default,Lily,0,0,0,,Câu hỏi đây!
Dialogue: 0,0:16:06.69,0:16:10.28,Default,Lily/Hosaka,0,0,0,,{\an8}Nhân vật anime đầu tiên mà \Nông cảnh sát tâm linh crush là ai?
Dialogue: 0,0:16:09.32,0:16:10.28,Default,Sign,0,0,0,,{\an8\pos(320,260)}CÂU 3: NHÂN VẬT ANIME ĐẦU TIÊN HẮN CRUSH?
Dialogue: 0,0:16:10.28,0:16:11.77,Default,Nao,0,0,0,,Ôi, câu này tôi biết!
Dialogue: 0,0:16:11.77,0:16:14.01,Default,Copbot,0,0,0,,Vâng, xin mời Đồng chí Ippongi trả lời trước!
Dialogue: 0,0:16:14.01,0:16:16.20,Default,Chojo,0,0,0,,Nhìn con nhỏ này hăng hái tự nhiên thấy bất an vãi.
Dialogue: 0,0:16:16.20,0:16:19.58,Default,Sign,0,0,0,,{\an8}HẮN CÒN CHẲNG BIẾT YÊU LÀ GÌ
Dialogue: 0,0:16:16.20,0:16:18.56,Default,Nao,0,0,0,,Anh ta chưa từng biết yêu ai bao giờ hết!
Dialogue: 0,0:16:18.56,0:16:19.58,Default,Chojo,0,0,0,,Cô đang khịa tôi đấy à?
Dialogue: 0,0:16:19.58,0:16:21.50,Default,Nao,0,0,0,,Tiền bối trẻ con thấy mồ,
Dialogue: 0,0:16:21.50,0:16:24.94,Default,Nao,0,0,0,,y như mấy đứa nhóc thấy ngượng \Nkhi lỡ chọn nhân vật nữ trong game vậy á!
Dialogue: 0,0:16:24.94,0:16:26.43,Default,Chojo,0,0,0,,Tao {\i1}không hề{\i0} nhé con kia!
Dialogue: 0,0:16:27.44,0:16:29.84,Default,Copbot,0,0,0,,Câu trả lời của ngài là gì, \Nthưa Cảnh thị Inukai?
Dialogue: 0,0:16:31.28,0:16:32.52,Default,Inukai,0,0,0,,Tayuya trong {\i1}Naruto{\i0}!
Dialogue: 0,0:16:30.88,0:16:35.34,Default,Sign,0,0,0,,{\an8}TAYUYA TRONG NARUTO
Dialogue: 0,0:16:32.52,0:16:33.81,Default,Nao,0,0,0,,Sao ngài biết chuẩn thế được?!
Dialogue: 0,0:16:33.81,0:16:35.34,Default,Chojo,0,0,0,,Ý là, cậu ta nói đúng thật, cơ mà...
Dialogue: 0,0:16:36.24,0:16:37.85,Default,Lily,0,0,0,,Ông chú kia đúng là quái vật thật sự.
Dialogue: 0,0:16:38.28,0:16:39.52,Default,Lily,0,0,0,,Câu nào ổng cũng ẵm trọn luôn kìa.
Dialogue: 0,0:16:37.85,0:16:38.98,Top Italics,Inukai,0,0,0,,Thấy thế nào hả?
Dialogue: 0,0:16:39.52,0:16:40.60,Default,Hosaka,0,0,0,,Khiếp thật đấy.
Dialogue: 0,0:16:41.78,0:16:43.58,Default,Lily,0,0,0,,Ông cảnh sát tâm linh lúc mới chào đời...
Dialogue: 0,0:16:43.58,0:16:46.16,Default,Hosaka,0,0,0,,...nặng bao nhiêu cân?
Dialogue: 0,0:16:46.16,0:16:48.11,Default,Sign,0,0,0,,{\an8\pos(320,256)}CÂU 4: LÚC MỚI SINH HẮN CÂN NẶNG BAO NHIÊU?
Dialogue: 0,0:16:46.16,0:16:48.11,Top,Chojo,0,0,0,,Mấy người đang muốn thử thách \Ngiới hạn độ biến thái của cậu ta đấy à?
Dialogue: 0,0:16:48.41,0:16:50.15,Default,Inukai,0,0,0,,3.250 gam!
Dialogue: 0,0:16:50.15,0:16:51.61,Default,Chojo,0,0,0,,Vượt cmn ngưỡng luôn rồi!
Dialogue: 0,0:16:51.61,0:16:53.87,Default,Inukai,0,0,0,,Thấy sao hả Nao Ippongi? \NCô thấy thế nào?!
Dialogue: 0,0:16:53.87,0:16:56.14,Default,Chojo,0,0,0,,Đúng thì cộng một điểm. \NNhưng tởm lợm quá nên trừ hai trăm triệu điểm!
Dialogue: 0,0:16:54.53,0:17:00.37,Default,Sign,0,0,0,,{\an8}+1 ĐIỂM\N-200 TRIỆU ĐIỂM
Dialogue: 0,0:16:56.14,0:16:59.42,Default,Keinain,0,0,0,,Sếp vừa bị trừ 200 triệu điểm \Nvì tội biến thái kìa sếp.
Dialogue: 0,0:16:59.42,0:17:02.24,Narrator,Narrator,0,0,0,,Inukai tiếp tục trả lời đúng mọi câu hỏi.
Dialogue: 0,0:17:02.24,0:17:04.52,Default,Hosaka,0,0,0,,Nhân vật yêu thích nhất trong {\i1}Tam Quốc Diễn Nghĩa{\i0}?
Dialogue: 0,0:17:04.52,0:17:05.34,Default,Inukai,0,0,0,,Lưu Thiện!
Dialogue: 0,0:17:05.34,0:17:06.42,Default,Inukai,0,0,0,,Và cậu có biết không...
Dialogue: 0,0:17:00.37,0:17:10.97,Default,Sign,0,0,0,,{\an8}LƯU THIỆN | THỤC HÁN
Dialogue: 0,0:17:06.42,0:17:12.01,Narrator,Narrator,0,0,0,,Anh ta còn tự động bình luận thêm \Nnhững chi tiết rợn người không ai thèm hỏi.
Dialogue: 0,0:17:12.57,0:17:13.92,Narrator,Narrator,0,0,0,,Và cứ thế...
Dialogue: 0,0:17:12.01,0:17:13.92,Default,Sign,0,0,0,,{\an8\pos(195,67)}VÒNG ĐẤU CAO NGUYÊN GUIANA
Dialogue: 0,0:17:13.92,0:17:15.68,Default,Lily,0,0,0,,Ừm thì...
Dialogue: 0,0:17:15.68,0:17:17.83,Default,Lily,0,0,0,,Bọn mình chơi trò này nãy giờ cũng lâu rồi,
Dialogue: 0,0:17:17.83,0:17:20.28,Default,Lily,0,0,0,,hay là thôi nghỉ khỏe đi ha?
Dialogue: 0,0:17:15.68,0:17:18.93,Default,Sign,0,0,0,,{\an8}0 ĐIỂM | -500.000.000 ĐIỂM
Dialogue: 0,0:17:20.28,0:17:21.81,Default,Nao,0,0,0,,Ngon lành! Mình đang dẫn trước một khoảng cách kỷ lục!
Dialogue: 0,0:17:21.81,0:17:25.77,Default,Chojo,0,0,0,,Đây đâu còn là đố vui nữa. \NNó thành buổi diễu hành biến thái mất kiểm soát rồi!
Dialogue: 0,0:17:25.77,0:17:28.31,Default,Chojo,0,0,0,,Và xin khẳng định luôn là cách tao trừ điểm \Nhoàn toàn công tâm và chính đáng nhé!
Dialogue: 0,0:17:29.42,0:17:31.12,Default,Inukai,0,0,0,,Phải làm sao đây, Keinain?
Dialogue: 0,0:17:31.12,0:17:33.65,Default,Keinain,0,0,0,,Sếp mà biến thái thêm phát nữa \Nlà em xin phép tung cờ trắng đầu hàng đấy.
Dialogue: 0,0:17:33.65,0:17:35.82,Default,Chojo,0,0,0,,Ngay cả người phe cậu \Ncòn muốn kết thúc trận đấu kìa.
Dialogue: 0,0:17:35.82,0:17:39.41,Default,Hosaka,0,0,0,,Thôi nào ngài Tinh anh ơi. \NTới nước này thì coi như ngã ngũ rồi còn gì.
Dialogue: 0,0:17:39.41,0:17:42.58,Default,Lily,0,0,0,,Bác ấy nói đúng đó. Trận đấu này \Nchẳng ra cái thể thống cống rãnh gì cả.
Dialogue: 0,0:17:42.93,0:17:46.33,Default,Lily,0,0,0,,Đủ để thấy ông cảnh sát tâm linh \Nchẳng hề muốn làm cộng sự với chú đâu.
Dialogue: 0,0:17:46.72,0:17:48.33,Default,Inukai,0,0,0,,Mấy người các người chẳng hiểu cái gì cả!
Dialogue: 0,0:17:48.33,0:17:51.34,Default,Inukai,0,0,0,,Tài năng của Meguru có thể tạo nên bước ngoặt \Nthay đổi toàn bộ nền điều tra phá án!
Dialogue: 0,0:17:51.68,0:17:55.46,Default,Inukai,0,0,0,,Cậu ấy không thuộc về cái bốt cảnh sát Tây Chinjuku \Nnhỏ bé, xó xỉnh này!
Dialogue: 0,0:17:52.21,0:17:57.84,Default,Sign,0,0,0,,{\an8}BỐT CẢNH SÁT XÓ XỈNH
Dialogue: 0,0:17:55.46,0:17:57.84,Default,Hosaka,0,0,0,,Ghê gớm đến mức đó cơ à?
Dialogue: 0,0:17:57.84,0:18:01.85,Default,Hosaka,0,0,0,,Vậy sao hắn lại đá một cộng sự như chú mày \Nđể về cắm chốt ở cái bốt cảnh sát này chứ?
Dialogue: 0,0:18:01.85,0:18:03.99,Default,Lily,0,0,0,,Oa, bác ấy phang thẳng vào mặt luôn kìa.
Dialogue: 0,0:18:03.99,0:18:05.35,Default,Lily,0,0,0,,Bác ơi, bác có biết ý tứ là cái gì không vậy?
Dialogue: 0,0:18:05.74,0:18:06.85,Default,Hosaka,0,0,0,,Bác biết chứ sao không cháu.
Dialogue: 0,0:18:07.38,0:18:10.11,Italics,Nao,0,0,0,,Lý do anh ấy làm việc ở đây sao?
Dialogue: 0,0:18:11.36,0:18:14.11,Flashback,Inukai,0,0,0,,Tại sao hả Meguru? Khoan đã, Meguru...
Dialogue: 0,0:18:14.11,0:18:15.17,Flashback,Inukai,0,0,0,,Meguru!
Dialogue: 0,0:18:17.61,0:18:20.62,Flashback,Inukai,0,0,0,,Tôi biết là chúng ta từng gặp phải bế tắc,
Dialogue: 0,0:18:20.62,0:18:23.99,Flashback,Inukai,0,0,0,,nhưng chỉ cần leo lên đỉnh cao danh vọng, \Nmọi khúc mắc đó sẽ tự động được giải quyết mà!
Dialogue: 0,0:18:24.30,0:18:26.62,Flashback,Inukai,0,0,0,,Tại sao cậu lại bỏ cuộc chứ?
Dialogue: 0,0:18:29.53,0:18:31.50,Flashback,Inukai,0,0,0,,Meguru, tại sao hả?!
Dialogue: 0,0:18:31.92,0:18:33.66,Flashback,Inukai,0,0,0,,Meguru!
Dialogue: 0,0:18:39.86,0:18:41.85,Default,Hosaka,0,0,0,,Ơ? Trông hắn như bị hóa đá rồi ấy.
Dialogue: 0,0:18:42.26,0:18:45.02,Default,Hosaka,0,0,0,,Bộ hắn không biết câu trả lời à?
Dialogue: 0,0:18:45.02,0:18:48.78,Default,Lily,0,0,0,,Nếu ổng mà biết thì đã chẳng biến \Nbuổi hội ngộ này thành cái rạp xiếc trung ương rồi!
Dialogue: 0,0:18:48.78,0:18:49.89,Default,Lily,0,0,0,,IQ của {\i1}bác{\i0} được bao nhiêu thế hả?
Dialogue: 0,0:18:49.89,0:18:52.15,Default,Keinain,0,0,0,,Tình hình khó xử quá rồi đấy sếp.
Dialogue: 0,0:18:54.31,0:18:59.40,Default,Nao,0,0,0,,Giờ tôi thấy có nhiều trẻ con chơi đùa \Nhơn hồi tôi còn bé.
Dialogue: 0,0:18:59.93,0:19:03.41,Default,Nao,0,0,0,,Ở cái khu phố này, \Nlúc nào người ta cũng phải dè chừng những kẻ gây rối.
Dialogue: 0,0:19:03.81,0:19:06.22,Default,Nao,0,0,0,,Nhưng lũ trẻ con dạo này \Ntrông vui vẻ yêu đời hơn hẳn.
Dialogue: 0,0:19:06.22,0:19:09.41,Default,Nao,0,0,0,,Chúng nó cứ í ới gọi: "Ê, cảnh sát tâm linh!\NBọn em thách đấu anh đấy nhé!"
Dialogue: 0,0:19:09.80,0:19:14.54,Default,Nao,0,0,0,,Tôi nghĩ đó là bởi vì anh ấy \Nđã luôn ở rất gần bên chúng.
Dialogue: 0,0:19:15.27,0:19:18.81,Default,Nao,0,0,0,,Anh ấy cắm chốt tại Chinjuku, \Nnơi ngày nào cũng xảy ra đủ thứ rắc rối,
Dialogue: 0,0:19:18.81,0:19:23.05,Default,Nao,0,0,0,,để có thể lắng nghe những tiếng kêu cứu nhỏ nhoi \Nmà nếu ở nơi khác sẽ dễ dàng bị chìm vào quên lãng.
Dialogue: 0,0:19:23.78,0:19:27.65,Default,Nao,0,0,0,,Thế nên, tôi nghĩ câu trả lời \Nchính là điều này...
Dialogue: 0,0:19:25.56,0:19:28.31,Default,Sign,0,0,0,,{\an8}ĐỂ GIÚP ĐỠ NHỮNG NƠI ANH ẤY CÓ THỂ
Dialogue: 0,0:19:32.48,0:19:33.28,Default,Chojo,0,0,0,,Tôi...
Dialogue: 0,0:19:33.28,0:19:36.32,Default,Inukai,0,0,0,,Meguru, cậu không cần phải trả lời đâu.
Dialogue: 0,0:19:40.57,0:19:43.37,Default,Inukai,0,0,0,,Tôi xin nhận thua.
Dialogue: 0,0:19:48.33,0:19:51.87,Default,Chojo,0,0,0,,Bỏ cuộc bất ngờ thế, Yuki.
Dialogue: 0,0:19:51.87,0:19:52.96,Default,Chojo,0,0,0,,Điều gì đã làm cậu thay—
Dialogue: 0,0:19:52.96,0:19:56.46,Default,Inukai,0,0,0,,"Tại sao cậu ấy lại bỏ rơi cộng sự \Nđể chuyển về đồn Tây Chinjuku?"
Dialogue: 0,0:19:56.85,0:19:59.48,Default,Inukai,0,0,0,,Suốt nhiều năm qua, tôi đã luôn trăn trở câu hỏi đó.
Dialogue: 0,0:19:59.96,0:20:01.90,Default,Inukai,0,0,0,,Và câu trả lời duy nhất mà tôi tìm ra...
Dialogue: 0,0:20:02.55,0:20:04.19,Default,Inukai,0,0,0,,...là chẳng có câu trả lời nào cả.
Dialogue: 0,0:20:05.53,0:20:08.72,Default,Inukai,0,0,0,,"Hắn ta đang ảo tưởng. Hắn đang tự hủy hoại bản thân."
Dialogue: 0,0:20:09.21,0:20:12.75,Default,Inukai,0,0,0,,Mọi suy nghĩ trong đầu tôi \Nđều đinh ninh rằng cậu đã chọn sai đường.
Dialogue: 0,0:20:13.35,0:20:17.11,Default,Inukai,0,0,0,,Tôi chưa từng một lần đặt niềm tin vào quyết định của cậu.
Dialogue: 0,0:20:17.55,0:20:19.36,Default,Inukai,0,0,0,,Câu trả lời vừa rồi của Nao Ippongi...
Dialogue: 0,0:20:19.41,0:20:21.37,Default,Sign,0,0,0,,{\an8}ĐỂ GIÚP ĐỠ NHỮNG NƠI ANH ẤY CÓ THỂ
Dialogue: 0,0:20:20.08,0:20:21.36,Default,Inukai,0,0,0,,...đã giúp tôi bừng tỉnh nhận ra điều đó.
Dialogue: 0,0:20:21.85,0:20:25.37,Default,Inukai,0,0,0,,Có một người cộng sự đủ tin tưởng \Nđể gửi gắm tấm lưng chính là điều cơ bản nhất trong các điều cơ bản.
Dialogue: 0,0:20:25.37,0:20:28.06,Default,Inukai,0,0,0,,Và ở khía cạnh đó, tôi đã hoàn toàn thua cô ta.
Dialogue: 0,0:20:29.55,0:20:33.50,Default,Inukai,0,0,0,,Thế nên tôi sẽ rút lui. Dù vậy...
Dialogue: 0,0:20:33.50,0:20:36.40,Default,Inukai,0,0,0,,...nhất định sẽ có ngày tôi trở lại \Nlàm cộng sự của cậu, tôi thề đấy!
Dialogue: 0,0:20:36.40,0:20:38.88,Default,Keinain,0,0,0,,Sếp ơi, có gì thì nói ra đi, \Nđừng có vừa nhai khăn mùi soa vừa nói thế.
Dialogue: 0,0:20:39.88,0:20:42.10,Default,Inukai,0,0,0,,Khi tôi leo lên tới đỉnh cao quyền lực,
Dialogue: 0,0:20:42.10,0:20:45.60,Default,Inukai,0,0,0,,chính sách của tôi sẽ là lắng nghe \Ntất cả những cái gọi là "tiếng kêu cứu nhỏ nhoi" đó!
Dialogue: 0,0:20:45.60,0:20:49.14,Default,Inukai,0,0,0,,Đến lúc đó, tôi sẽ bắt cậu làm việc cật lực, \Nbất kể là án lớn hay án nhỏ!
Dialogue: 0,0:20:50.81,0:20:52.64,Default,Chojo,0,0,0,,Tôi chẳng hy vọng gì đâu, \Nnhưng sẽ đợi xem sao.
Dialogue: 0,0:20:56.53,0:21:00.90,Italics,Nao,0,0,0,,Có lẽ tôi vẫn chưa thực sự hiểu rõ con người anh ấy.
Dialogue: 0,0:21:01.52,0:21:04.40,Italics,Nao,0,0,0,,Có lẽ được thăng tiến vượt khỏi cấp bậc \Ncảnh sát tuần tra tiền bối,
Dialogue: 0,0:21:04.40,0:21:08.10,Italics,Nao,0,0,0,,và giải quyết những vụ đại án quy mô lớn \Nsẽ hợp với anh ấy hơn.
Dialogue: 0,0:21:08.80,0:21:09.41,Italics,Nao,0,0,0,,Nhưng mà...
Dialogue: 0,0:21:10.54,0:21:12.73,Default,Kid B,0,0,0,,Ê, chú cảnh sát tâm linh kìa!
Dialogue: 0,0:21:12.73,0:21:14.79,Default,Kid A,0,0,0,,Ra chơi với tụi cháu đi chú! Nhanh lên!
Dialogue: 0,0:21:14.79,0:21:16.37,Default,Chojo,0,0,0,,Được thôi. Nhào vô kiếm ăn!
Dialogue: 0,0:21:16.37,0:21:22.32,Italics,Nao,0,0,0,,Nhưng trước mắt, anh ấy vẫn là chú cảnh sát tâm linh \Ncủa đồn Tây Chinjuku. Có phải thế không?
Dialogue: 0,0:21:22.32,0:21:23.15,Default,Kid A,0,0,0,,Chơi luôn chú ơi!
Dialogue: 0,0:21:23.15,0:21:25.02,Default,Chojo,0,0,0,,Nếm mùi này con giai!
Dialogue: 0,0:21:25.02,0:21:25.85,Default,Kid B,0,0,0,,Chết tiệt!
Dialogue: 0,0:21:25.85,0:21:28.00,Default,Chojo,0,0,0,,Tắt điện chưa con ranh con ngu ngốc!
Dialogue: 0,0:21:28.76,0:21:30.33,Default,Chojo,0,0,0,,Và chú mày lại thắng rồi nhé!
Dialogue: 0,0:21:30.33,0:21:31.98,Default,Kid A,0,0,0,,Cháu ghét chú vãi chưởng!
Dialogue: 0,0:21:32.86,0:21:37.02,Default,Chojo,0,0,0,,Chẳng có gì bổ béo hơn \Nnhìn cảnh lũ con nít khóc lóc đau khổ.
Dialogue: 0,0:21:37.07,0:21:40.03,Default,Sign,0,0,0,,{\an8}NƯỚC MẮT CỦA TRẺ CON ĐANG KHÓC
Dialogue: 0,0:21:37.49,0:21:40.02,Italics,Nao,0,0,0,,Hóa ra mình đoán đúng món khoái khẩu của ổng rồi.
Dialogue: 0,0:21:40.02,0:21:43.93,Default,Chojo,0,0,0,,Để chú ăn mừng bằng tuyệt chiêu luồn dây: \NEm bé nhện nhé!
Dialogue: 0,0:23:15.08,0:23:16.83,Default,Sign,0,0,0,,{\an8\pos(294.5,186.5)}GIỚI THIỆU TẬP TIẾP THEO
Dialogue: 0,0:23:15.83,0:23:16.83,Top Italics,Nao,0,0,0,,Tôi là Nao đây!
Dialogue: 0,0:23:16.83,0:23:19.46,Italics,Nao,0,0,0,,Cửa hàng tiện lợi chính là chốn thiên đường \Nvới đủ mọi dịch vụ tiện ích trên đời.
Dialogue: 0,0:23:19.46,0:23:23.08,Italics,Nao,0,0,0,,Bọn tôi xin được chuyển mình thành bộ anime công sở \Nấm áp tình người lấy bối cảnh tại miền đất hứa đó!
Dialogue: 0,0:23:23.08,0:23:26.43,Italics,Nao,0,0,0,,Công việc tuy nặng gánh trách nhiệm, \Nnhưng bù lại sẽ đem đến cảm giác thỏa mãn khó tả.
Dialogue: 0,0:23:26.43,0:23:30.09,Italics,Nao,0,0,0,,Khoan đã! Một thằng nhóc hừng hực dục vọng không kiểm soát \Nsắp đổ bộ quậy tanh bành đồn cảnh sát sao?!

