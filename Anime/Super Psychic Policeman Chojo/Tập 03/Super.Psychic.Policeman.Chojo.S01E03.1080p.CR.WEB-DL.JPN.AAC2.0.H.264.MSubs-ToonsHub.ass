Dialogue: 0,0:00:00.00,0:00:05.19,Sign_Default,Sign,0,0,0,,{\an8}KABUKI-CHO
Dialogue: 0,0:00:02.80,0:00:06.98,Italics,Nao,0,0,0,,Phố Kabuki-cho ở Chinjuku. Một trong những khu ăn chơi giải trí sầm uất bậc nhất Nhật Bản.
Dialogue: 0,0:00:07.44,0:00:10.97,Italics,Nao,0,0,0,,Và Đồn Cảnh Sát Tây Chinjuku của bọn tôi tọa lạc ngay tại góc con phố này.
Dialogue: 0,0:00:11.84,0:00:15.49,Default,Chojo,0,0,0,,Nghe tin gì chưa? Nghe đồn sắp có lính mới chuyển tới đồn mình đấy.
Dialogue: 0,0:00:15.93,0:00:19.00,Default,Nao,0,0,0,,Hả? Thật thế ạ? Tuyệt quá còn gì!
Dialogue: 0,0:00:19.00,0:00:23.56,Default,Chojo,0,0,0,,Lạc quan gớm nhỉ? Chứ cái đồn khỉ ho cò gáy này đời nào cấp trên lại nhét người tử tế vào.
Dialogue: 0,0:00:23.56,0:00:25.25,Default,Nao,0,0,0,,Cái đó... đúng là khó cãi thật.
Dialogue: 0,0:00:25.56,0:00:27.92,Default,Chojo,0,0,0,,Chẳng dám tưởng tượng nổi sẽ là thành phần quái dị nào nữa.
Dialogue: 0,0:00:27.92,0:00:29.82,Default,Chojo,0,0,0,,Chỉ mong không phải là mấy kẻ cứng nhắc nghiêm túc quá đáng.
Dialogue: 0,0:00:30.25,0:00:34.26,Default,Nao,0,0,0,,Nếu họ được phái tới để giám sát tiền bối,\Nthì khả năng cao là sẽ cực kỳ nghiêm khắc đấy.
Dialogue: 0,0:00:34.68,0:00:38.76,Default,Nao,0,0,0,,Cơ mà em cũng muốn có một cộng sự\Năn nói nhỏ nhẹ, hòa nhã hơn cơ.
Dialogue: 0,0:00:40.57,0:00:41.77,Default,Copbot,0,0,0,,Xin phép làm phiền.
Dialogue: 0,0:00:44.89,0:00:45.73,Default,Chojo,0,0,0,,Nóng quá!
Dialogue: 0,0:00:47.44,0:00:53.24,Default,Copbot,0,0,0,,Kể từ ngày hôm nay, tôi đã được điều động\Nđến Đồn Cảnh Sát Tây Chinjuku.
Dialogue: 0,0:00:55.55,0:00:59.36,Default,Copbot,0,0,0,,Tôi là cảnh sát robot tân binh, Copbot.
Dialogue: 0,0:01:01.04,0:01:02.72,Default,Nao,0,0,0,,Ờ thì... đúng là ăn nói nhỏ nhẹ thật.
Dialogue: 0,0:01:02.72,0:01:04.54,Default,Chojo,0,0,0,,Cơ mà cứng nhắc theo nghĩa đen luôn rồi.
Dialogue: 0,0:02:35.00,0:02:38.01,Sign_Default,Sign,0,0,0,,{\an8}TẬP 3, PHẦN A: TIỀN BỐI CHẠY VIỆC VẶT
Dialogue: 0,0:02:35.54,0:02:38.01,Narrator,Narrator,0,0,0,,Tập 3: Tiền bối chạy việc vặt.
Dialogue: 0,0:02:38.95,0:02:41.01,Default,Copbot,0,0,0,,Được rồi, chúng ta phải làm đúng theo quy củ.
Dialogue: 0,0:02:41.50,0:02:45.76,Default,Copbot,0,0,0,,{\an8}Từ nay tôi sẽ đồng hành cùng các vị.\NCứ gọi tôi là Copbot.
Dialogue: 0,0:02:43.72,0:02:45.76,Sign_Default,Sign,0,0,0,,{\an8\pos(414,211.5)}CẢNH SÁT ROBOT\N COPBOT
Dialogue: 0,0:02:46.14,0:02:47.77,Default,Nao,0,0,0,,"Copbot" á?
Dialogue: 0,0:02:48.16,0:02:54.02,Default,Copbot,0,0,0,,Vâng! Tôi vừa mới xuất xưởng\Nnên kinh nghiệm thực tế vẫn còn non nớt,
Dialogue: 0,0:02:54.02,0:02:58.19,Default,Copbot,0,0,0,,nhưng tôi sẽ dốc hết tâm sức hoàn thành nhiệm vụ\Nvới tư cách thành viên của đồn.
Dialogue: 0,0:02:58.95,0:03:02.95,Default,Copbot,0,0,0,,Rất mong nhận được sự chỉ bảo\Nvà hướng dẫn tận tình từ mọi người!
Dialogue: 0,0:03:03.36,0:03:06.27,Default,Nao,0,0,0,,C-Cậu lễ phép quá mức cần thiết rồi đấy?
Dialogue: 0,0:03:06.27,0:03:10.70,Default,Nao,0,0,0,,To chuyện rồi đây. Cậu ta còn lịch sự, nhã nhặn\Nhơn bất kỳ ai trong cái đồn này.
Dialogue: 0,0:03:10.70,0:03:14.96,Default,Chojo,0,0,0,,Bọn mình coi như toang nếu cấp trên\Nbắt đầu thay thế con người bằng ba cái thứ phi nhân loại này.
Dialogue: 0,0:03:17.38,0:03:19.55,Default,Chojo,0,0,0,,Cơ mà cái thứ này thì làm được tích sự gì chứ?
Dialogue: 0,0:03:19.55,0:03:22.93,Default,Chojo,0,0,0,,Trông y chang mấy con robot bưng bê\Nngoài nhà hàng dạo gần đây vậy.
Dialogue: 0,0:03:22.93,0:03:25.72,Default,Nao,0,0,0,,Nhưng trông Copbot cũng dễ thương mà.
Dialogue: 0,0:03:25.72,0:03:29.23,Default,Chojo,0,0,0,,Thôi thì cấp trên đã có lòng giao cho,\Nanh đây sẽ tận dụng triệt để.
Dialogue: 0,0:03:30.31,0:03:34.86,Default,Chojo,0,0,0,,Này lính mới. Thấy chú mày có vẻ\Ncoi đây như nhà mình rồi nhỉ?
Dialogue: 0,0:03:34.86,0:03:37.77,Default,Chojo,0,0,0,,Thế thì mau chạy đi mua cho anh mày\Nmột cái bánh bao đậu đỏ với hộp sữa xem nào!
Dialogue: 0,0:03:37.77,0:03:39.91,Default,Nao,0,0,0,,Tiền bối đã bắt người ta chạy việc vặt\N{\i1}ngay ngày đầu{\i0} rồi đấy à?!
Dialogue: 0,0:03:39.91,0:03:43.21,Default,Chojo,0,0,0,,Thế thì ra đứng gác cửa đi, lính mới!
Dialogue: 0,0:03:43.21,0:03:46.22,Default,Chojo,0,0,0,,Dù sao thì công việc ở cái đồn này\Ncăng thẳng nhất cũng chỉ đến thế thôi.
Dialogue: 0,0:03:46.74,0:03:48.67,Default,Chojo,0,0,0,,Anh mày đi kiếm trò giải trí đây—
Dialogue: 0,0:03:49.69,0:03:54.68,Default,Copbot,0,0,0,,Ca trực của tiền bối Chojo vẫn còn kéo dài\Nthêm 6 tiếng 42 phút nữa cơ ạ.
Dialogue: 0,0:03:56.26,0:03:58.17,Default,Chojo,0,0,0,,Đừng có tự tiện thả ta xuống chứ!
Dialogue: 0,0:03:58.50,0:04:02.42,Default,Copbot,0,0,0,,Tiền bối không thể trở thành một cảnh sát chân chính\Nnếu cứ suốt ngày trốn việc như vậy.
Dialogue: 0,0:04:03.10,0:04:05.10,Default,Chojo,0,0,0,,Mày dám lên mặt dạy đời anh mày đấy à?
Dialogue: 0,0:04:05.10,0:04:08.45,Default,Chojo,0,0,0,,Xem ra đống sắt vụn nhà chú\Ncần phải nếm mùi huấn luyện rồi.
Dialogue: 0,0:04:08.45,0:04:11.68,Default,Chojo,0,0,0,,Có vẻ chú mày vẫn chưa biết đến siêu năng lực của anh đây rồi.
Dialogue: 0,0:04:13.02,0:04:15.71,Default,Copbot,0,0,0,,Xin tiền bối Chojo hãy dừng lại.
Dialogue: 0,0:04:15.71,0:04:19.19,Default,Copbot,0,0,0,,Là một cỗ máy, năng lực đọc suy nghĩ của tiền bối\Nhoàn toàn vô tác dụng với tôi.
Dialogue: 0,0:04:20.32,0:04:23.70,Default,Copbot,0,0,0,,Hãy ngẫm lại xem từ nãy đến giờ\Ntiền bối có đọc được gì không nào.
Dialogue: 0,0:04:24.01,0:04:29.17,Default,Copbot,0,0,0,,Phải, sự thật là tôi được chế tạo ra\Nđể cảm hóa và uốn nắn tiền bối đấy.
Dialogue: 0,0:04:29.17,0:04:31.67,Default,Copbot,0,0,0,,Tôi chính là robot cảnh sát khắc tinh của siêu năng lực gia!
Dialogue: 0,0:04:32.72,0:04:36.29,Default,Chojo,0,0,0,,K-Không thể nào! Đào đâu ra kinh phí\Nmà làm cái thứ này chứ?!
Dialogue: 0,0:04:36.29,0:04:39.17,Default,Copbot,0,0,0,,Toàn thể những người ghét tiền bối ở khu Chinjuku này đã cùng nhau...
Dialogue: 0,0:04:40.74,0:04:42.92,Default,Copbot,0,0,0,,lập một chiến dịch gọi vốn cộng đồng đấy.
Dialogue: 0,0:04:39.17,0:04:41.59,Sign_Default,Sign,0,0,0,,{\an8}VŨ KHÍ BÍ MẬT KHẮC TINH MEGURU CHOJO\NAI TỐI TÂN NHẤT
Dialogue: 0,0:04:41.59,0:04:42.92,Sign_Default,Sign,0,0,0,,{\an8}TỔNG SỐ TIỀN ĐÃ GỌI VỐN
Dialogue: 0,0:04:43.34,0:04:46.18,Default,Nao,0,0,0,,Mặt thì cute hột me mà mở mồm ra\Ntoàn nói mấy câu sát thương chí mạng.
Dialogue: 0,0:04:46.64,0:04:52.14,Default,Copbot,0,0,0,,Nào, tiền bối, chúng ta hãy cùng nhau hướng tới mục tiêu\Ntrở thành những cảnh sát khiến nhân dân tự hào nhé!
Dialogue: 0,0:04:53.68,0:05:02.19,Sign_Default,Sign,0,0,0,,{\an8}NGÀY HÔM SAU
Dialogue: 0,0:04:54.72,0:04:59.63,Italics,Nao,0,0,0,,Và thế là Copbot chính thức gia nhập\NĐồn Cảnh Sát Tây Chinjuku.
Dialogue: 0,0:04:59.63,0:05:02.19,Italics,Nao,0,0,0,,Còn về những việc mà cậu ta làm á...
Dialogue: 0,0:05:02.65,0:05:06.70,Default,Chojo,0,0,0,,Tranh thủ lúc cái cục nợ phiền phức kia vắng mặt,\Nlàm tí mô hình Gunpla nào—
Dialogue: 0,0:05:07.06,0:05:08.22,Default,Copbot,0,0,0,,Tôi xin phép tịch thu thứ này.
Dialogue: 0,0:05:08.22,0:05:09.20,Default,Chojo,0,0,0,,Ơ kìa! Thằng khốn này!
Dialogue: 0,0:05:09.73,0:05:12.45,Italics,Chojo,0,0,0,,Chết tiệt, mình không hề cảm nhận được nó đang mò tới.
Dialogue: 0,0:05:12.45,0:05:16.96,Default,Copbot,0,0,0,,Mấy sở thích kiểu này nên dành vào thời gian rảnh rỗi\Nthì sẽ vui hơn đấy ạ.
Dialogue: 0,0:05:16.96,0:05:19.96,Default,Chojo,0,0,0,,C-Cái thằng đần này...
Dialogue: 0,0:05:19.96,0:05:26.71,Default,Chojo,0,0,0,,Ngồi lắp mô hình nhựa trong giờ làm việc\Nnó mới {\i1}phê gấp vạn lần{\i0}, đồ ngu này!
Dialogue: 0,0:05:26.71,0:05:30.22,Default,Chojo,0,0,0,,Cơ mà cái ngữ robot nhà chú\Nthì hiểu thế quái nào được!
Dialogue: 0,0:05:30.61,0:05:32.97,Italics,Nao,0,0,0,,Người đàng hoàng cũng chẳng ai hiểu nổi cái lý lẽ đấy đâu ạ.
Dialogue: 0,0:05:33.43,0:05:34.81,Default,Copbot,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:05:34.81,0:05:38.90,Default,Copbot,0,0,0,,Nhưng lối suy nghĩ đó đi ngược lại hoàn toàn\Nvới phẩm chất của người chiến sĩ cảnh sát.
Dialogue: 0,0:05:39.61,0:05:42.73,Default,Copbot,0,0,0,,Giả sử như nơi đây diễn ra một lễ hội địa phương.
Dialogue: 0,0:05:43.45,0:05:47.52,Default,Copbot,0,0,0,,Trong khi nhân dân vui chơi, chúng ta phải túc trực\Ngiữ gìn an ninh trật tự.
Dialogue: 0,0:05:47.52,0:05:49.74,Default,Copbot,0,0,0,,Đó mới chính là sứ mệnh cao cả của một cảnh sát.
Dialogue: 0,0:05:49.74,0:05:56.75,Default,Copbot,0,0,0,,Vậy thì điều gì quan trọng hơn:\Nhạnh phúc của quần chúng hay sở thích ích kỷ của tiền bối?
Dialogue: 0,0:05:57.09,0:05:58.75,Default,Chojo,0,0,0,,Đương nhiên là mô hình nhựa rồi, thằng ngốc!
Dialogue: 0,0:05:59.10,0:06:00.50,Italics,Nao,0,0,0,,Đừng có cãi cố nữa xem nào!
Dialogue: 0,0:06:00.79,0:06:02.97,Default,Chojo,0,0,0,,Biến ra xa tao ngay, cái đồ đạo đức giả!
Dialogue: 0,0:06:02.97,0:06:04.51,Default,Chojo,0,0,0,,Cái thứ đồng nát sắt vụn nhà mày!
Dialogue: 0,0:06:05.80,0:06:08.26,Narrator,Narrator,0,0,0,,Chàng cảnh sát siêu năng lực\Nvẫn ngoan cố chống đối tới cùng.
Dialogue: 0,0:06:08.26,0:06:10.26,Default,Copbot,0,0,0,,Tiền bối đang trong ca trực đấy.
Dialogue: 0,0:06:10.78,0:06:12.96,Narrator,Narrator,0,0,0,,Nhưng các biện pháp chấn chỉnh kỷ luật\Nvẫn tiếp diễn không ngừng.
Dialogue: 0,0:06:16.65,0:06:17.90,Default,Chojo,0,0,0,,Im mồm đi!
Dialogue: 0,0:06:17.90,0:06:20.14,Narrator,Narrator,0,0,0,,Đó là một sự kiểm soát gắt gao\Nđến từng chân tơ kẽ tóc.
Dialogue: 0,0:06:23.84,0:06:26.67,Default,Copbot,0,0,0,,Tiền bối không được phép ghé tiệm đồ chơi Kadota nữa.
Dialogue: 0,0:06:27.56,0:06:29.53,Narrator,Narrator,0,0,0,,Anh ta bị oanh tạc bởi hàng loạt đạo lý thông thường.
Dialogue: 0,0:06:29.85,0:06:35.04,Narrator,Narrator,0,0,0,,Khi siêu năng lực trở nên vô dụng,\Nanh ta hoàn toàn bó tay bất lực.
Dialogue: 0,0:06:35.91,0:06:39.80,Default,Nao,0,0,0,,Tiền bối chỉ cần làm việc nghiêm túc một chút thôi\Nlà được mà.
Dialogue: 0,0:06:35.04,0:06:41.04,Sign_Default,Sign,0,0,0,,{\an8}TÔI ĐÃ TRỐN VIỆC TRONG GIỜ LÀM
Dialogue: 0,0:06:41.39,0:06:44.36,Default,Nao,0,0,0,,Tiền bối có biết mình đang làm phiền Copbot\Nđến mức nào không?
Dialogue: 0,0:06:44.36,0:06:48.19,Default,Nao,0,0,0,,Giờ thì tiền bối hết đường dùng siêu năng lực\Nđể trốn việc rồi nhé.
Dialogue: 0,0:06:48.88,0:06:50.43,Default,Nao,0,0,0,,Này, đừng có ngồi ủ rũ thế chứ.
Dialogue: 0,0:06:51.52,0:06:53.43,Default,Copbot,0,0,0,,Tiền bối Chojo.
Dialogue: 0,0:06:53.83,0:06:58.73,Default,Copbot,0,0,0,,Cảm thấy ghét bỏ tôi cũng là lẽ tự nhiên thôi,\Nvì tôi miễn nhiễm với năng lực của tiền bối mà.
Dialogue: 0,0:06:58.73,0:07:01.94,Default,Copbot,0,0,0,,Nhưng hãy thử nhìn nhận theo một khía cạnh khác xem.
Dialogue: 0,0:07:02.36,0:07:08.44,Default,Copbot,0,0,0,,Tôi là người duy nhất tiền bối có thể giao tiếp\Nmà không bị siêu năng lực chi phối.
Dialogue: 0,0:07:08.82,0:07:13.77,Default,Copbot,0,0,0,,Xét theo khía cạnh đó, chúng ta hoàn toàn có thể\Ntrở thành tri kỷ vượt qua mọi rào cản giống loài.
Dialogue: 0,0:07:13.77,0:07:14.95,Default,Copbot,0,0,0,,Tôi nói có đúng không nào?
Dialogue: 0,0:07:15.24,0:07:16.95,Default,Chojo,0,0,0,,Ngậm mõm lại đi, cái lon sắt gỉ!
Dialogue: 0,0:07:18.45,0:07:23.31,Default,Chojo,0,0,0,,Cái thằng con hoang hình trụ nhà mày.\NSớm muộn gì tao cũng tống khứ mày đi cho bằng được.
Dialogue: 0,0:07:23.31,0:07:25.04,Default,Nao,0,0,0,,Tiền bối lại vừa phá kỷ lục bỉ ổi mới rồi đấy.
Dialogue: 0,0:07:26.71,0:07:31.72,Default,Chojo,0,0,0,,Khốn nạn thật! Tao muốn trốn việc!\NTao thèm trốn việc đến phát điên rồi đây này!
Dialogue: 0,0:07:31.72,0:07:37.22,Sign_Default,Sign,0,0,0,,{\an8}Á Á Á...
Dialogue: 0,0:07:32.84,0:07:37.22,Narrator,Narrator,0,0,0,,Chàng cảnh sát siêu năng lực nhất quyết không chịu hợp tác\Nvà cự tuyệt Copbot.
Dialogue: 0,0:07:37.54,0:07:39.76,Default,Copbot,0,0,0,,Cảm giác này... là sao chứ?
Dialogue: 0,0:07:39.76,0:07:44.41,Narrator,Narrator,0,0,0,,Điều này đã tạo nên một sự biến dạng\Ntrong cảm xúc của Copbot.
Dialogue: 0,0:07:50.56,0:07:52.49,Default,Copbot,0,0,0,,Mình vẫn chưa đạt được kết quả như kỳ vọng
Dialogue: 0,0:07:52.49,0:07:55.45,Default,Copbot,0,0,0,,trong việc cảm hóa\Ntiền bối Chojo.
Dialogue: 0,0:07:56.79,0:07:58.63,Default,Copbot,0,0,0,,Nguyên nhân thì đã quá rõ ràng rồi.
Dialogue: 0,0:08:00.64,0:08:02.38,Default,Copbot,0,0,0,,Đối tượng này rốt cuộc lại là...
Dialogue: 0,0:08:03.88,0:08:06.84,Default,Copbot,0,0,0,,một kẻ vô tích sự cặn bã vượt xa mọi nguồn dữ liệu\Nmà mình có.
Dialogue: 0,0:08:06.84,0:08:08.75,Flashback,Chojo,0,0,0,,Ngậm mõm lại đi, cái lon sắt gỉ!
Dialogue: 0,0:08:09.02,0:08:13.52,Default,Copbot,0,0,0,,Hệ quả là, mình buộc phải áp dụng\Nnhững biện pháp cực đoan hơn thôi.
Dialogue: 0,0:08:16.51,0:08:20.14,Sign_Default,Sign,0,0,0,,{\an8}VÀI NGÀY SAU
Dialogue: 0,0:08:17.39,0:08:20.14,Default,Nao,0,0,0,,Chà, thời gian trôi nhanh thật đấy nhỉ?
Dialogue: 0,0:08:20.14,0:08:23.83,Default,Nao,0,0,0,,Mới đó mà đã một tuần kể từ khi Copbot tới đồn mình rồi.
Dialogue: 0,0:08:25.05,0:08:28.77,Default,Nao,0,0,0,,Cậu ấy giờ đúng là một thành viên thực thụ rồi.\NĐúng không, Copbot?
Dialogue: 0,0:08:28.77,0:08:29.74,Default,Chojo,0,0,0,,Ơ...
Dialogue: 0,0:08:30.28,0:08:32.24,Default,Chojo,0,0,0,,Trông nó... có bị nổi bần bật quá đà không thế?
Dialogue: 0,0:08:33.06,0:08:36.28,Default,Nao,0,0,0,,Thôi nào, tiền bối lại bắt đầu\Ncằn nhằn về cậu ấy nữa đấy à?
Dialogue: 0,0:08:36.68,0:08:39.84,Default,Chojo,0,0,0,,Lần này khác hẳn! Trông cứ như\Nnó đang bước vào tuổi dậy thì nổi loạn vậy!
Dialogue: 0,0:08:39.84,0:08:43.58,Default,Nao,0,0,0,,Robot làm gì có tuổi nổi loạn cơ chứ, ngốc xít này.
Dialogue: 0,0:08:43.58,0:08:47.50,Default,Chojo,0,0,0,,Này, trên đời này vẫn có khái niệm\N"robot nổi dậy khởi nghĩa" đấy nhé.
Dialogue: 0,0:08:49.18,0:08:51.84,Default,Chojo,0,0,0,,Cô có nói gì thì nói, thằng này trông dị hợm thấy rõ.
Dialogue: 0,0:08:56.95,0:08:58.55,Default,Copbot,0,0,0,,Tiền bối Chojo.
Dialogue: 0,0:08:59.38,0:09:02.09,Default,Copbot,0,0,0,,Bánh bao đậu đỏ.\NXăng cao cấp A95. Mua ngay và luôn.
Dialogue: 0,0:09:02.09,0:09:03.50,Default,Chojo,0,0,0,,Mày tính nhúng bánh bao vào xăng mà ăn đấy à?!
Dialogue: 0,0:09:09.23,0:09:11.92,Default,Copbot,0,0,0,,Khà, trơn tru cả cuống họng.
Dialogue: 0,0:09:11.92,0:09:14.07,Default,Chojo,0,0,0,,Thề luôn, chuyện này quái đản lắm rồi.
Dialogue: 0,0:09:14.35,0:09:16.91,Default,Chojo,0,0,0,,Sát khí của nó áp đảo gấp mấy lần lúc trước rồi đấy.
Dialogue: 0,0:09:14.07,0:09:24.08,Sign_Default,Sign,0,0,0,,{\an8}THAM ĂN TỤC UỐNG
Dialogue: 0,0:09:16.91,0:09:21.16,Default,Nao,0,0,0,,Cậu ấy đang cố gắng đanh thép lại\Nđể cảm hóa tiền bối đấy thôi.
Dialogue: 0,0:09:21.16,0:09:24.08,Default,Chojo,0,0,0,,Trái tim nó vốn dĩ làm bằng kim loại đặc\Nthì có!
Dialogue: 0,0:09:24.08,0:09:27.24,Default,Chojo,0,0,0,,Nghiêm túc đấy, {\i1}nhìn kỹ xem{\i0}.\NTrông nó không kỳ dị chút nào à?
Dialogue: 0,0:09:27.24,0:09:29.59,Default,Nao,0,0,0,,Ừm, trông có vẻ tự tin hơn chăng?
Dialogue: 0,0:09:29.59,0:09:32.55,Default,Chojo,0,0,0,,Không, ý tôi là {\i1}ngoại hình{\i0} ấy!
Dialogue: 0,0:09:32.55,0:09:36.09,Default,Chojo,0,0,0,,Đi làm cảnh sát thì cần quái gì đống phụ kiện đó chứ?
Dialogue: 0,0:09:36.09,0:09:38.63,Default,Chojo,0,0,0,,Sao người mày lại mọc lắm gai góc thế kia hả?!
Dialogue: 0,0:09:38.63,0:09:42.22,Default,Copbot,0,0,0,,À thì, tôi nghĩ lắp thêm mấy thứ này\Nsẽ giúp giữ gìn trật tự trị an tốt hơn.
Dialogue: 0,0:09:42.22,0:09:46.35,Default,Chojo,0,0,0,,Nếu để phòng thủ thì giáp vai\Nviệc đách gì phải gắn {\i1}chông nhọn hoắt{\i0} thế kia?!
Dialogue: 0,0:09:46.84,0:09:49.39,Default,Chojo,0,0,0,,Nghiêm túc đấy, phải tống khứ thằng này đi thôi.
Dialogue: 0,0:09:49.39,0:09:53.11,Default,Nao,0,0,0,,Hôm nay chỉ có hai người trực thôi đấy,\Nliệu mà hòa thuận với nhau đi nhé.
Dialogue: 0,0:09:53.90,0:09:55.11,Default,Chojo,0,0,0,,C-Chỉ có hai người á?!
Dialogue: 0,0:09:55.72,0:09:56.72,Default,Nao,0,0,0,,Vâng.
Dialogue: 0,0:09:56.72,0:10:00.99,Default,Nao,0,0,0,,Em phải chạy lên sở chỉ huy một lát,\Nsau đó là hết ca trực luôn.
Dialogue: 0,0:10:00.99,0:10:02.87,Default,Chojo,0,0,0,,Này, khoan đã!
Dialogue: 0,0:10:03.43,0:10:06.36,Default,Chojo,0,0,0,,T-Tôi phải ở một mình với cái thứ quái thai này sao?!
Dialogue: 0,0:10:09.50,0:10:12.88,Default,Copbot,0,0,0,,Không có gì phải sợ hãi đâu,\Ntiền bối Chojo.
Dialogue: 0,0:10:13.21,0:10:16.13,Default,Copbot,0,0,0,,Tôi cũng đang rất mong\Nđược tâm sự mỏng với tiền bối đây.
Dialogue: 0,0:10:16.41,0:10:17.64,Default,Chojo,0,0,0,,Cái...
Dialogue: 0,0:10:17.64,0:10:22.14,Default,Chojo,0,0,0,,Tâm sự cái gì? Mày đang mưu tính trò gì đấy?\NMà sao bộ dạng mày lại thế kia?!
Dialogue: 0,0:10:22.14,0:10:25.98,Default,Copbot,0,0,0,,Chỉ là chút nâng cấp\Nđể chuẩn bị cho ngày định mệnh mà thôi.
Dialogue: 0,0:10:26.70,0:10:31.15,Default,Copbot,0,0,0,,Lối sống bệ rạc vô phương cứu chữa của tiền bối mấy ngày qua\Nđã giúp tôi ngộ ra một chân lý.
Dialogue: 0,0:10:33.11,0:10:36.52,Default,Copbot,0,0,0,,Nhân loại các ngươi quá đỗi ngu xuẩn,\Nvô phương cứu rỗi.
Dialogue: 0,0:10:36.52,0:10:41.16,Default,Copbot,0,0,0,,Ta sẽ ngự trị trên đầu tất cả các ngươi\Nvới tư cách là một đấng tối cao!
Dialogue: 0,0:10:41.16,0:10:44.16,Default,Chojo,0,0,0,,Chiến dịch gọi vốn cộng đồng rốt cuộc\Nđã tạo ra thứ quái vật gớm ghiếc gì thế này?!
Dialogue: 0,0:10:44.16,0:10:48.44,Default,Chojo,0,0,0,,Cuối cùng thì mày cũng lộ bộ mặt thật rồi nhé.\NNhưng tao sẽ ngăn mày lại!
Dialogue: 0,0:10:48.44,0:10:51.84,Default,Nao,0,0,0,,Em chẳng hiểu hai người đang lảm nhảm gì đâu,\Nnhưng cấm có được đánh nhau đấy nhé!
Dialogue: 0,0:10:51.84,0:10:54.92,Default,Chojo,0,0,0,,Ippongi? Tưởng cô lên sở chỉ huy rồi cơ mà?
Dialogue: 0,0:10:55.20,0:10:57.42,Default,Nao,0,0,0,,Em quay lại xem hai người\Ncó hòa thuận với nhau không thôi.
Dialogue: 0,0:10:57.74,0:11:02.31,Default,Copbot,0,0,0,,Thật tiện lợi làm sao. Tên tiền bối này cơ bản\Nđã bị ta tước sạch nanh vuốt rồi.
Dialogue: 0,0:11:02.31,0:11:07.43,Default,Copbot,0,0,0,,Chỉ cần đè bẹp được đồng chí Ippongi này nữa thôi,\Ncái đồn cảnh sát này sẽ thuộc về ta!
Dialogue: 0,0:11:07.43,0:11:08.54,Default,Chojo,0,0,0,,Ippongi, cẩn thận!
Dialogue: 0,0:11:09.80,0:11:14.19,Default,Copbot,0,0,0,,Ta đã nạp toàn bộ dữ liệu tinh hoa\Ncủa môn võ Judo vào bộ nhớ.
Dialogue: 0,0:11:14.19,0:11:15.77,Default,Copbot,0,0,0,,Đây gọi là Kumite!
Dialogue: 0,0:11:14.19,0:11:16.19,Sign_Default,Sign,0,0,0,,{\an8}KUMITE (THẾ THỦ JUDO)
Dialogue: 0,0:11:17.19,0:11:22.07,Italics,Copbot,0,0,0,,Muốn bắt đồng chí Ippongi phải quy phục,\Nthì Judo sẽ là...
Dialogue: 0,0:11:22.07,0:11:24.45,Italics,Copbot,0,0,0,,...phương pháp, ơ... hiệu quả nhất?
Dialogue: 0,0:11:27.50,0:11:29.96,Italics,Copbot,0,0,0,,C-Cô ta... không hề lay chuyển một ly!
Dialogue: 0,0:11:32.98,0:11:37.46,Default,Nao,0,0,0,,Vừa rồi là Judo đấy à? Cậu cất công học cả môn đó cơ à?
Dialogue: 0,0:11:37.79,0:11:41.61,Italics,Copbot,0,0,0,,C-Cái quái gì thế này? Cảm giác như mình vừa đâm đầu vào một thân cổ thụ khổng lồ vậy!
Dialogue: 0,0:11:42.80,0:11:45.47,Italics,Copbot,0,0,0,,Không thể nào! Cảm biến của mình chắc chắn đang gặp sự cố!
Dialogue: 0,0:11:52.47,0:11:53.84,Italics,Copbot,0,0,0,,Cây tuyết tùng ngàn năm tuổi sao?!
Dialogue: 0,0:11:56.29,0:11:58.98,Default,Nao,0,0,0,,A ha, cậu đã cố gắng hết sức rồi, nhưng mà...
Dialogue: 0,0:11:59.31,0:12:03.25,Narrator,Narrator,0,0,0,,Đòn thế của Copbot chỉ thuần túy dựa trên lý thuyết suông.
Dialogue: 0,0:12:03.25,0:12:07.28,Default,Nao,0,0,0,,Muốn tập môn này thì phải đến võ đường đàng hoàng\Nmà rèn luyện chứ.
Dialogue: 0,0:12:07.28,0:12:10.25,Narrator,Narrator,0,0,0,,Sao mà đọ lại được với một con khỉ đột bằng xương bằng thịt.
Dialogue: 0,0:12:12.72,0:12:14.00,Default,Nao,0,0,0,,À, em có ý này!
Dialogue: 0,0:12:14.37,0:12:19.58,Default,Nao,0,0,0,,Nhà em có mở võ đường đấy.\NCậu có muốn đến đó đổ mồ hôi tập luyện cùng em không?
Dialogue: 0,0:12:25.47,0:12:29.56,Sign_Default,Sign,0,0,0,,{\an8}NGÀY HÔM SAU
Dialogue: 0,0:12:25.88,0:12:27.92,Narrator,Narrator,0,0,0,,Một ngày mới lại bắt đầu...
Dialogue: 0,0:12:27.92,0:12:32.41,Default,Nao,0,0,0,,Nào Copbot, trước tiên hãy cúi chào\Ncác vị tiền bối đi nào.
Dialogue: 0,0:12:32.41,0:12:34.56,Default,Copbot,0,0,0,,Kính chúc buổi sáng an lành!
Dialogue: 0,0:12:34.56,0:12:36.15,Default,Chojo,0,0,0,,Rợn cả tóc gáy...
Dialogue: 0,0:12:36.15,0:12:38.21,Default,Chojo,0,0,0,,Cái quái gì đã xảy ra với nó thế?!
Dialogue: 0,0:12:38.21,0:12:41.82,Default,Nao,0,0,0,,Dạ, em chỉ dạy cậu ấy vài chiêu cơ bản ở võ đường thôi,\Ntiếp thu nhanh dã man luôn.
Dialogue: 0,0:12:42.38,0:12:44.06,Default,Nao,0,0,0,,Nào, Copbot.
Dialogue: 0,0:12:45.20,0:12:47.26,Default,Nao,0,0,0,,Tiền bối thấy em nói đúng chưa?
Dialogue: 0,0:12:45.32,0:12:49.58,Sign_Default,Sign,0,0,0,,{\an8}NGỒI QUỲ CÚI CHÀO (SEIZA)
Dialogue: 0,0:12:47.26,0:12:49.58,Default,Chojo,0,0,0,,Nó đang làm cái trò đó đấy à?!
Dialogue: 0,0:12:49.92,0:12:53.54,Default,Nao,0,0,0,,Em mong là từ nay hai người\Nsẽ hòa thuận với nhau đấy nhé!
Dialogue: 0,0:12:54.67,0:12:57.33,Default,Nao,0,0,0,,Thôi nào, bắt tay vào làm việc thôi!
Dialogue: 0,0:12:57.33,0:13:01.61,Default,Chojo,0,0,0,,À... ờ, Ippongi ơi, cô có muốn anh\Nđi mua cho cái bánh bao đậu đỏ không?
Dialogue: 0,0:13:01.61,0:13:03.59,Default,Copbot,0,0,0,,Hay là một ngụm xăng A95 cao cấp ạ?
Dialogue: 0,0:13:03.59,0:13:05.59,Default,Nao,0,0,0,,Thôi, cái đó thì em xin kiễng.
Dialogue: 0,0:13:05.59,0:13:08.87,Narrator,Narrator,0,0,0,,Người ta đồn rằng trật tự vai vế\Nở Đồn Cảnh Sát Tây Chinjuku
Dialogue: 0,0:13:08.87,0:13:11.41,Narrator,Narrator,0,0,0,,đã có một sự thay đổi ngầm kể từ ngày hôm đó.
Dialogue: 0,0:13:12.22,0:13:14.98,Narrator,Narrator,0,0,0,,Siêu Cảnh Sát Tâm Linh Chojo.
Dialogue: 0,0:13:12.22,0:13:14.98,Sign_Default,Sign,0,0,0,,{\an8}COPBOT\NROBOT HÌNH TRỤ
Dialogue: 0,0:13:15.91,0:13:20.23,Default,Copbot,0,0,0,,Xin kính chào. Tôi là cảnh sát robot tân binh, Copbot.
Dialogue: 0,0:13:20.88,0:13:24.74,Default,Copbot,0,0,0,,Hiện tại tôi đang công tác\Ntại Đồn Cảnh Sát Tây Chinjuku.
Dialogue: 0,0:13:25.68,0:13:28.74,Default,Copbot,0,0,0,,Không biết hôm nay sẽ có những vụ án ly kỳ nào\Nchờ đón chúng ta đây?
Dialogue: 0,0:13:36.56,0:13:39.50,Default,Copbot,0,0,0,,Ồ, Trưởng đồn! Hôm nay ngài ghé thăm có việc gì thế ạ?
Dialogue: 0,0:13:39.84,0:13:41.75,Default,Chief,0,0,0,,À, Copbot đấy à.
Dialogue: 0,0:13:42.79,0:13:49.26,Default,Copbot,0,0,0,,Như ngài thấy đấy, hôm nay tôi vẫn đang cùng các tiền bối\Nchăm chỉ làm việc, xin ngài cứ yên tâm.
Dialogue: 0,0:13:49.54,0:13:52.12,Top,Copbot,0,0,0,,Tôi sẽ tiếp tục cống hiến hết mình để—
Dialogue: 0,0:13:51.01,0:13:53.12,Default,Chief,0,0,0,,Vấn đề là thế này, Copbot à.
Dialogue: 0,0:13:53.12,0:13:53.98,Default,Copbot,0,0,0,,Vâng?
Dialogue: 0,0:13:55.58,0:13:57.48,Default,Chief,0,0,0,,Hết tuần này thì cậu bị sa thải nhé.
Dialogue: 0,0:14:01.01,0:14:02.85,Narrator,Narrator,0,0,0,,Tiền bối quái xế.
Dialogue: 0,0:14:00.52,0:14:03.53,Sign_Default,Sign,0,0,0,,{\an8}TẬP 3, PHẦN B: TIỀN BỐI QUÁI XẾ
Dialogue: 0,0:14:03.94,0:14:05.06,Default,Copbot,0,0,0,,Tôi... bị đuổi việc rồi sao?!
Dialogue: 0,0:14:05.82,0:14:07.95,Default,Nao,0,0,0,,S-Sếp sa thải Copbot thật đấy ạ?!
Dialogue: 0,0:14:07.95,0:14:09.87,Default,Chief,0,0,0,,Rất tiếc, nhưng đúng là vậy.
Dialogue: 0,0:14:09.87,0:14:14.04,Default,Copbot,0,0,0,,T-Tại sao chứ? Chuyện này đột ngột quá!
Dialogue: 0,0:14:14.38,0:14:15.75,Default,Nao,0,0,0,,Đúng thế thật đấy ạ!
Dialogue: 0,0:14:15.75,0:14:20.68,Default,Nao,0,0,0,,Dưới sự huấn luyện của em,\NCopbot sắp chạm tới đỉnh cao võ thuật Judo rồi mà!
Dialogue: 0,0:14:21.54,0:14:24.55,Italics,Chojo,0,0,0,,Cái con robot này toàn dính vào\Nmấy chuyện trời ơi đất hỡi không đâu.
Dialogue: 0,0:14:24.98,0:14:26.64,Top,Copbot,0,0,0,,Trưởng đồn!
Dialogue: 0,0:14:24.98,0:14:26.64,Default,Nao,0,0,0,,Tại sao thế ạ?
Dialogue: 0,0:14:26.64,0:14:28.05,Default,Chief,0,0,0,,Còn hỏi tại sao nữa à?
Dialogue: 0,0:14:28.40,0:14:32.30,Default,Chief,0,0,0,,Vừa về đây chưa được bao lâu\Nnó đã tự ý độ thêm đống gai nhọn đe dọa người khác.
Dialogue: 0,0:14:32.30,0:14:36.64,Default,Chief,0,0,0,,Rồi lại còn lấy tiền cờ bạc ở sòng bài phi pháp\Ndưới lòng đất ra để trả nữa chứ!
Dialogue: 0,0:14:39.69,0:14:41.57,Narrator,Narrator,0,0,0,,Quả báo nhãn tiền không trượt phát nào.
Dialogue: 0,0:14:42.46,0:14:48.07,Default,Copbot,0,0,0,,N-Nhưng tôi là robot cảnh sát mà!\NKhông làm cảnh sát thì tôi biết làm cái gì bây giờ?!
Dialogue: 0,0:14:48.40,0:14:52.07,Default,Chief,0,0,0,,Đừng lo. Bọn ta đã tính toán lối đi tương lai\Ncho cậu cả rồi.
Dialogue: 0,0:14:52.07,0:14:53.58,Default,Copbot,0,0,0,,Thật thế ạ?
Dialogue: 0,0:14:53.95,0:14:58.04,Default,Chief,0,0,0,,Chúng tôi sẵn sàng hỗ trợ hết mình\Nđể điều chuyển cậu sang ngành phục vụ nhà hàng!
Dialogue: 0,0:14:53.58,0:15:00.33,Sign_Default,Sign,0,0,0,,{\an8}NHÀ HÀNG GIA ĐÌNH
Dialogue: 0,0:14:58.04,0:15:00.33,Flashback,Copbot,0,0,0,,Cảm ơn quý khách đã gọi món meow-der!
Dialogue: 0,0:15:00.64,0:15:02.83,Default,Copbot,0,0,0,,Ngài muốn biến tôi thành robot bưng bê ngoài quán ăn sao?!
Dialogue: 0,0:15:03.12,0:15:06.04,Default,Chief,0,0,0,,Quyết định chính thức sẽ sớm được gửi xuống thôi.
Dialogue: 0,0:15:06.04,0:15:07.05,Default,Chief,0,0,0,,Chào nhé.
Dialogue: 0,0:15:09.52,0:15:10.65,Default,Nao,0,0,0,,Copbot...
Dialogue: 0,0:15:10.65,0:15:12.09,Default,Copbot,0,0,0,,Hai người phải cứu tôi với!
Dialogue: 0,0:15:12.40,0:15:15.91,Default,Copbot,0,0,0,,Tôi sinh ra là để làm cảnh sát!
Dialogue: 0,0:15:15.91,0:15:18.85,Default,Copbot,0,0,0,,Hệ thống của tôi không có chức năng\Nbưng bê trong nhà hàng gia đình đâu!
Dialogue: 0,0:15:19.21,0:15:20.85,Default,Nao,0,0,0,,Bình tĩnh lại nào, Copbot.
Dialogue: 0,0:15:21.19,0:15:24.46,Default,Copbot,0,0,0,,Lẽ nào Trời Phật không rủ lòng thương xót\Ncho loài robot hay sao?!
Dialogue: 0,0:15:25.48,0:15:26.86,Default,Copbot,0,0,0,,Tiền bối?
Dialogue: 0,0:15:27.15,0:15:30.86,Default,Chojo,0,0,0,,Chúc mừng chú em nhận công việc mới nhé!
Dialogue: 0,0:15:34.09,0:15:37.62,Default,Nao,0,0,0,,Nếu trên đời có cuốn cẩm nang về lũ cặn bã,\Nchắc chắn tiền bối sẽ chễm chệ ngay trang bìa.
Dialogue: 0,0:15:37.62,0:15:41.25,Default,Chojo,0,0,0,,Từ ngày mày về đây,\Nmày phá tan tành hết mấy trò vui của anh mày.
Dialogue: 0,0:15:41.25,0:15:43.88,Default,Chojo,0,0,0,,Anh mày mừng rớt nước mắt\Nkhi thấy chú mày đi bưng bê nhà hàng đấy!
Dialogue: 0,0:15:45.26,0:15:50.64,Default,Copbot,0,0,0,,Ra là vậy sao? Thế thì mong tiền bối hãy chuẩn bị tinh thần\Ntiếp nối giấc mơ Judo của "tôi" đi nhé.
Dialogue: 0,0:15:50.64,0:15:53.39,Default,Copbot,0,0,0,,Đồng chí Ippongi, cho tiền bối nếm thử mùi vị đi nào!
Dialogue: 0,0:15:53.75,0:15:55.64,Default,Ippongi,0,0,0,,Ừm, nếu cậu đã nhờ thì...
Dialogue: 0,0:15:54.72,0:15:55.64,Top,Chojo,0,0,0,,Dừng lại ngay! Cấm có làm bậy!
Dialogue: 0,0:15:55.64,0:15:56.77,Default,Chojo,0,0,0,,Anh xin lỗi được chưa!
Dialogue: 0,0:15:57.40,0:15:59.18,Default,Chojo,0,0,0,,Giờ chỉ cần giúp chú mày là được chứ gì?!
Dialogue: 0,0:16:00.06,0:16:02.77,Default,Nao,0,0,0,,Bọn tôi tuyệt đối sẽ không để\Nđồng đội của mình bị sa thải đâu!
Dialogue: 0,0:16:03.04,0:16:05.12,Default,Copbot,0,0,0,,H-Hai người...
Dialogue: 0,0:16:05.12,0:16:06.43,Default,Copbot,0,0,0,,Cảm ơn hai người rất meow-ch!
Dialogue: 0,0:16:06.43,0:16:07.77,Default,Nao,0,0,0,,Cậu ta bắt đầu nhiễm thói quen đó rồi kìa.
Dialogue: 0,0:16:08.35,0:16:12.28,Default,Nao,0,0,0,,Cơ mà làm thế nào để cấp trên\Nrút lại quyết định sa thải cậu bây giờ?
Dialogue: 0,0:16:12.58,0:16:15.66,Default,Copbot,0,0,0,,Ở Chinjuku này, chiến công chính là tất cả!
Dialogue: 0,0:16:15.98,0:16:18.33,Default,Copbot,0,0,0,,Chúng ta phải tóm gọn một tên tội phạm cộm cán!
Dialogue: 0,0:16:18.33,0:16:21.13,Default,Copbot,0,0,0,,Tôi sẽ truy cập vào cơ sở dữ liệu của Sở Cảnh sát Đô thị.
Dialogue: 0,0:16:22.54,0:16:23.29,Default,Copbot,0,0,0,,Ra rồi đây!
Dialogue: 0,0:16:23.29,0:16:25.26,Sign_Default,Sign,0,0,0,,{\an8}CỰU QUÁI XẾ ĐUA XE ĐƯỜNG PHỐ\NHIỆN LÀ TÊN TRỘM TIỆM KIM HOÀN
Dialogue: 0,0:16:25.26,0:16:26.88,Sign_Default,Sign,0,0,0,,{\an8}TỰ XƯNG LÀ "VUA TỐC ĐỘ"
Dialogue: 0,0:16:26.88,0:16:28.55,Sign_Default,Sign,0,0,0,,{\an8}KẺ NGHIỆN CẢM GIÁC MẠNH PHẠM TỘI\NCHỈ ĐỂ ĐƯỢC PHÓNG XE BẠT MẠNG
Dialogue: 0,0:16:23.76,0:16:26.61,Default,Copbot,0,0,0,,Tên này từng là quái xế đường phố,\Nhiện đang là thủ phạm trộm tiệm kim hoàn.
Dialogue: 0,0:16:26.61,0:16:28.55,Default,Copbot,0,0,0,,Hắn tự xưng danh hiệu là "Vua Tốc Độ".
Dialogue: 0,0:16:28.84,0:16:33.30,Default,Copbot,0,0,0,,Một kẻ nghiện cảm giác mạnh phạm tội\Nchỉ để thỏa mãn thú vui phóng xe lạng lách.
Dialogue: 0,0:16:33.85,0:16:35.74,Default,Nao,0,0,0,,Oa, trong người cậu gắn cả máy chiếu mini cơ à?
Dialogue: 0,0:16:35.74,0:16:38.24,Default,Copbot,0,0,0,,Chúng ta sẽ tóm cổ hắn!
Dialogue: 0,0:16:38.24,0:16:40.81,Default,Chojo,0,0,0,,Nói thì dễ, chứ manh mối thì kiếm đâu ra?
Dialogue: 0,0:16:41.43,0:16:45.59,Default,Copbot,0,0,0,,Dạo gần đây đối tượng hoạt động tích cực\Nhơn hẳn bình thường.
Dialogue: 0,0:16:45.59,0:16:48.31,Default,Copbot,0,0,0,,Chẳng có gì bất ngờ nếu hôm nay\Nhắn lại tiếp tục ra tay.
Dialogue: 0,0:16:48.87,0:16:51.82,Italics,Radio,0,0,0,,Sở Cảnh sát Đô thị gửi tới toàn bộ các đồn.\NLặp lại, gửi tới toàn bộ các đồn.
Dialogue: 0,0:16:51.82,0:16:53.22,Default,Nao,0,0,0,,Không thể nào!
Dialogue: 0,0:16:53.22,0:16:56.58,Italics,Radio,0,0,0,,Nghi phạm được biết đến với biệt danh Vua Tốc Độ\Nhiện đang trên đường đào tẩu
Dialogue: 0,0:16:56.58,0:16:58.62,Italics,Radio,0,0,0,,sau khi vừa cướp một tiệm kim hoàn tại Chinjuku!
Dialogue: 0,0:16:58.62,0:16:59.83,Default,Copbot,0,0,0,,Chuẩn bài luôn!
Dialogue: 0,0:17:00.18,0:17:03.44,Default,Nao,0,0,0,,Một nhân tài thế này mà lại phải\Nchôn vùi ở cái đồn của mình sao trời?
Dialogue: 0,0:17:03.44,0:17:07.08,Default,Chojo,0,0,0,,Hay là chuyển giao nó cho bên đội trọng án đi?\NCho nhẹ nợ vĩnh viễn luôn.
Dialogue: 0,0:17:08.00,0:17:10.59,Default,Chojo,0,0,0,,Khoan đã. Làm sao đuổi kịp bắt sống tên này được?
Dialogue: 0,0:17:10.59,0:17:14.25,Default,Chojo,0,0,0,,Siêu năng lực của tôi\Nđâu có biến tôi chạy nhanh như ô tô được đâu.
Dialogue: 0,0:17:15.38,0:17:16.59,Default,Copbot,0,0,0,,Xin tiền bối đừng lo.
Dialogue: 0,0:17:16.94,0:17:22.10,Default,Copbot,0,0,0,,Có vẻ đã đến lúc tôi phải phô diễn\Nnăng lực tiềm ẩn khác của mình rồi.
Dialogue: 0,0:17:23.60,0:17:31.61,Sign_Default,Sign,0,0,0,,{\an8\pos(320,245)}DẠNG CHIẾN XA BỐN BÁNH\N COPBOT TYPE F
Dialogue: 0,0:17:24.88,0:17:27.96,Default,Copbot,0,0,0,,{\an8}Hãy chiêm ngưỡng hình dạng mới của tôi đây!
Dialogue: 0,0:17:27.96,0:17:31.61,Default,Copbot,0,0,0,,{\an8}Dạng Chiến Xa Bốn Bánh:\NCopbot Type F!
Dialogue: 0,0:17:32.03,0:17:34.53,Default,Nao,0,0,0,,Cái xe này có được phép lưu thông hợp pháp\Ntrên đường không đấy?
Dialogue: 0,0:17:34.53,0:17:37.11,Default,Chojo,0,0,0,,Trông cứ như ba cái màn biến hình phi lý\Ntrong phim hoạt hình vậy.
Dialogue: 0,0:17:37.67,0:17:43.37,Default,Nao,0,0,0,,Giấy phép của cậu thế nào hả Copbot?\NBọn mình có bị phạt vì vi phạm luật giao thông không đấy?!
Dialogue: 0,0:17:43.76,0:17:46.62,Default,Copbot,0,0,0,,Ba cái chuyện cỏn con đó cứ để tòa án lo!
Dialogue: 0,0:17:46.99,0:17:49.13,Default,Chojo,0,0,0,,Đừng có nói như thể\Nchắc chắn bọn mình sẽ phải hầu tòa thế chứ!
Dialogue: 0,0:17:50.20,0:17:54.88,Default,Chojo,0,0,0,,Ơ kìa? N-Này, đây đâu phải vô lăng!\NLà cần điều khiển mà!
Dialogue: 0,0:17:55.24,0:17:59.38,Default,Chojo,0,0,0,,Thứ này chỉ xuất hiện\Ntrong mấy bộ anime robot thôi chứ!
Dialogue: 0,0:17:59.38,0:18:02.15,Top,Chojo,0,0,0,,Cô có hiểu được cái cảm giác ngầu lòi này không hả?!
Dialogue: 0,0:18:00.48,0:18:02.15,Default,Copbot,0,0,0,,Xem ra rất hợp ý tiền bối nhỉ?
Dialogue: 0,0:18:02.88,0:18:06.27,Default,Chojo,0,0,0,,Lại còn có cả màn hình liên lạc 3D\Ntrôi nổi giữa không trung nữa chứ!
Dialogue: 0,0:18:06.27,0:18:08.73,Default,Copbot,0,0,0,,Tôi sẽ cung cấp hỗ trợ tác chiến tối đa cho tiền bối!
Dialogue: 0,0:18:09.11,0:18:10.69,Default,Chojo,0,0,0,,Đỉnh chóp thật sự!
Dialogue: 0,0:18:11.27,0:18:15.11,Default,Nao,0,0,0,,Em chẳng yên tâm chút nào khi để một người\Nđang phấn khích tột độ cầm lái đâu nhé.
Dialogue: 0,0:18:15.11,0:18:18.82,Default,Chojo,0,0,0,,Meguru Chojo cùng Copbot Type-F,\Nxuất kích!
Dialogue: 0,0:18:19.80,0:18:21.62,Default,Nao,0,0,0,,Thật là lố bịch hết sức!
Dialogue: 0,0:18:22.19,0:18:23.49,Default,Chojo,0,0,0,,Kích hoạt quy trình khởi động!
Dialogue: 0,0:18:23.98,0:18:25.62,Default,Chojo,0,0,0,,Toàn bộ hệ thống hoạt động ổn định!
Dialogue: 0,0:18:26.00,0:18:29.37,Default,Chojo,0,0,0,,Quyền điều khiển đã sẵn sàng! Động cơ hết công suất!
Dialogue: 0,0:18:29.86,0:18:33.13,Default,Nao,0,0,0,,Tiền bối không cần phải xả hết mấy câu thoại\Nấp ủ từ hồi bé ra như thế đâu!
Dialogue: 0,0:18:38.63,0:18:41.64,Sign_Default,Sign,0,0,0,,{\an8\pos(332,233)}KẺ TỰ XƯNG "VUA TỐC ĐỘ"
Dialogue: 0,0:18:38.99,0:18:41.64,Default,Speed King,0,0,0,,{\an8}Tưởng bở bám theo kịp bổn tọa sao?
Dialogue: 0,0:18:51.50,0:18:54.44,Default,Speed King,0,0,0,,Lũ cảnh sát ở Chinjuku\Nđúng là một nỗi thất vọng tràn trề.
Dialogue: 0,0:18:54.81,0:18:57.69,Default,Speed King,0,0,0,,Mong sao có con quái vật nào đó\Nđủ trình để khiêu chiến với ta.
Dialogue: 0,0:18:58.15,0:19:01.70,Default,Speed King,0,0,0,,Một kẻ nào đó có thể cho ta nếm trải\Nmùi vị của nỗi sợ hãi tột cùng!
Dialogue: 0,0:19:03.20,0:19:04.70,Default,Copbot,0,0,0,,Hắn kìa rồi!
Dialogue: 0,0:19:05.95,0:19:08.96,Default,Nao,0,0,0,,Nhìn kìa, Vua Tốc Độ đang ở đằng kia!
Dialogue: 0,0:19:09.57,0:19:10.71,Default,Chojo,0,0,0,,Tuyệt cú mèo!
Dialogue: 0,0:19:10.71,0:19:12.92,Default,Chojo,0,0,0,,Công suất của con hàng này bá đạo vãi chưởng!
Dialogue: 0,0:19:12.92,0:19:15.55,Default,Chojo,0,0,0,,Động năng của nó gấp tận 5 lần xe bình thường luôn!
Dialogue: 0,0:19:15.55,0:19:17.13,Default,Nao,0,0,0,,Tiền bối có đang nghe em nói không đấy hả?!
Dialogue: 0,0:19:19.31,0:19:22.22,Default,Nao,0,0,0,,Hắn đang chạy thoát kìa!\NTiền bối đang {\i1}làm cái trò gì{\i0} thế hả?!
Dialogue: 0,0:19:22.70,0:19:24.89,Default,Chojo,0,0,0,,Thảo nào dạo này thấy sếp mặt mày ủ rũ bận tâm ghê thế.
Dialogue: 0,0:19:24.89,0:19:25.72,Default,Nao,0,0,0,,Tập trung chuyên môn vào!
Dialogue: 0,0:19:26.27,0:19:28.73,Italics,Speed King,0,0,0,,Cái xe cảnh sát quái đản gì thế kia?
Dialogue: 0,0:19:28.73,0:19:31.65,Italics,Speed King,0,0,0,,Tưởng vác cái xe rạp xiếc tấu hài đó ra\Nmà bắt kịp được bổn tọa à?
Dialogue: 0,0:19:31.65,0:19:36.23,Italics,Speed King,0,0,0,,Đối thủ là ai cũng chẳng quan trọng,\Nta sẽ nghiền nát tất cả bằng kỹ năng đỉnh cao!
Dialogue: 0,0:19:36.59,0:19:38.48,Default,Speed King,0,0,0,,Kỹ năng đánh võng của ta thế nào hả?!
Dialogue: 0,0:19:38.48,0:19:40.49,Default,Speed King,0,0,0,,Còn non và xanh lắm con ơi!
Dialogue: 0,0:19:41.67,0:19:43.99,Default,Copbot,0,0,0,,Lên luôn nào!
Dialogue: 0,0:19:45.62,0:19:49.43,Default,Chojo,0,0,0,,Đỉnh của chóp! Chú mày đỉnh nhất trần đời, Copbot Type-F!
Dialogue: 0,0:19:49.43,0:19:53.00,Default,Nao,0,0,0,,Công nhận là đỉnh thật,\Nnhưng không tóm được hắn thì to chuyện đấy!
Dialogue: 0,0:19:53.34,0:19:54.83,Default,Chojo,0,0,0,,Cô nói cũng phải.
Dialogue: 0,0:19:54.83,0:19:58.43,Default,Chojo,0,0,0,,Này Copbot, chú mày có vũ khí gì\Nđể hạ gục hắn không?
Dialogue: 0,0:19:58.43,0:20:02.76,Default,Copbot,0,0,0,,Tiền bối Chojo, lẽ nào tiền bối nghĩ rằng...
Dialogue: 0,0:20:02.76,0:20:05.17,Default,Copbot,0,0,0,,tôi lại không chuẩn bị món đồ chơi nào sao?
Dialogue: 0,0:20:05.17,0:20:08.68,Default,Copbot,0,0,0,,Nhưng kích hoạt chúng\Nsẽ làm nguồn năng lượng của tôi mất ổn định.
Dialogue: 0,0:20:08.68,0:20:10.52,Default,Copbot,0,0,0,,Một mình tôi e rằng không kham nổi.
Dialogue: 0,0:20:11.37,0:20:12.75,Default,Chojo,0,0,0,,Không cần nói thêm lời nào nữa.
Dialogue: 0,0:20:14.04,0:20:16.02,Default,Chojo,0,0,0,,Anh mày sẽ cho chú mượn siêu năng lực!
Dialogue: 0,0:20:16.32,0:20:18.78,Default,Speed King,0,0,0,,Trên đời này lại có cái loại xe\Nquái thai dị hợm như thế sao?
Dialogue: 0,0:20:18.78,0:20:20.78,Default,Speed King,0,0,0,,Mình đang hoảng loạn đấy à?
Dialogue: 0,0:20:20.78,0:20:25.78,Italics,Speed King,0,0,0,,Một kẻ từng được xưng tụng\Nlà tay lái điên cuồng nhất trên mọi nẻo đường như mình á?!
Dialogue: 0,0:20:26.13,0:20:28.41,Italics,Speed King,0,0,0,,B-Biến mất rồi? Chúng nó trốn đâu rồi?!
Dialogue: 0,0:20:28.41,0:20:29.59,Italics,Speed King,0,0,0,,Rốt cuộc chúng nó ở—
Dialogue: 0,0:20:32.88,0:20:36.70,Default,Copbot,0,0,0,,Tóm sống rồi nhé! Một tên tội phạm cộm cán đã vào tròng!
Dialogue: 0,0:20:39.49,0:20:44.68,Italics,Speed King,0,0,0,,Từ nay... tao xin hoàn lương...\NTao không bao giờ dám cầm lái nữa đâu...
Dialogue: 0,0:20:44.68,0:20:49.76,Narrator,Narrator,0,0,0,,Đứng trước nỗi kinh hoàng tột độ,\NVua Tốc Độ đã quyết định rửa tay gác kiếm.
Dialogue: 0,0:20:52.81,0:20:55.44,Sign_Default,Sign,0,0,0,,{\an8}NGÀY HÔM SAU
Dialogue: 0,0:20:55.44,0:20:58.69,Sign_Default,Sign,0,0,0,,{\an8}VUA TỐC ĐỘ BỊ BẮT GIỮ
Dialogue: 0,0:20:55.85,0:20:58.69,Narrator,Narrator,0,0,0,,Và thế là, bộ ba cảnh sát siêu năng lực\Nđã lập được chiến công hiển hách khi bắt gọn tên tội phạm nguy hiểm.
Dialogue: 0,0:20:59.17,0:21:02.02,Default,Nao,0,0,0,,Trưởng đồn chắc hẳn bất ngờ lắm đấy.
Dialogue: 0,0:21:02.02,0:21:06.26,Default,Copbot,0,0,0,,Và quyết định sa thải của tôi đã được thu hồi!\NTôi lại được tiếp tục công tác cùng hai vị tiền bối rồi!
Dialogue: 0,0:21:06.26,0:21:08.40,Default,Nao,0,0,0,,Mọi chuyện êm đẹp là tốt rồi.
Dialogue: 0,0:21:08.40,0:21:09.70,Default,Chojo,0,0,0,,Này, anh có ý này.
Dialogue: 0,0:21:09.70,0:21:12.20,Default,Chojo,0,0,0,,Đợt nâng cấp tới,\Nhay là lắp thêm dàn tên lửa đẩy Vernier đi?
Dialogue: 0,0:21:12.60,0:21:14.84,Default,Copbot,0,0,0,,Ồ không đâu ạ, tôi nghĩ súng máy gắn ngoài\Nmới là ưu tiên số một.
Dialogue: 0,0:21:15.57,0:21:18.00,Default,Nao,0,0,0,,Hai người {\i1}muốn{i0} bị đày\Nra nhà hàng gia đình bưng bê thật đấy à?!
Dialogue: 0,0:21:20.80,0:21:23.51,Default,Keinan,0,0,0,,Vua Tốc Độ bị tóm rồi.
Dialogue: 0,0:21:24.25,0:21:26.26,Default,Inukai,0,0,0,,Lại là Chojo à?
Dialogue: 0,0:21:26.64,0:21:27.34,Default,Keinan,0,0,0,,Phải.
Dialogue: 0,0:21:28.12,0:21:31.86,Default,Inukai,0,0,0,,Tao phát ngấy với mấy cái cảnh\Nnhá hàng ngắn cũn cỡn này rồi đấy.
Dialogue: 0,0:21:31.86,0:21:34.60,Default,Inukai,0,0,0,,Ước gì bọn mình được lên sóng nhiều hơn một chút.
Dialogue: 0,0:21:34.60,0:21:36.85,Default,Keinan,0,0,0,,Nhá hàng mãi thì cũng đến thế mà thôi.
Dialogue: 0,0:21:36.85,0:21:38.52,Default,Keinan,0,0,0,,Lần sau phải đòi đạo diễn cho xuất hiện cả vài phút mới bõ.
Dialogue: 0,0:21:39.59,0:21:44.24,Default,Inukai,0,0,0,,Chuẩn bị cầu nguyện đi là vừa, Meguru Chojo.
Dialogue: 0,0:23:14.99,0:23:16.24,Sign_Default,Sign,0,0,0,,{\an8}GIỚI THIỆU TẬP TIẾP THEO
Dialogue: 0,0:23:15.51,0:23:16.24,Italics,Nao,0,0,0,,Nao đây ạ.
Dialogue: 0,0:23:16.24,0:23:17.88,Italics,Nao,0,0,0,,Cuộc đời vốn dĩ là một chuỗi những câu đố hóc búa.
Dialogue: 0,0:23:17.88,0:23:21.38,Italics,Nao,0,0,0,,Nhưng câu hỏi là gì? Và đâu là câu trả lời xứng đáng\Nđể ta dành trọn cuộc đời kiếm tìm?
Dialogue: 0,0:23:21.38,0:23:23.58,Italics,Nao,0,0,0,,Tại sao kẻ đó lại tái xuất?
Dialogue: 0,0:23:23.58,0:23:25.77,Italics,Nao,0,0,0,,Tại sao năm xưa tiền bối Chojo lại ruồng bỏ hắn?
Dialogue: 0,0:23:25.77,0:23:30.00,Italics,Nao,0,0,0,,Liệu những ân oán dồn nén suốt bao năm qua\Ncó tìm được hồi kết hay không?

