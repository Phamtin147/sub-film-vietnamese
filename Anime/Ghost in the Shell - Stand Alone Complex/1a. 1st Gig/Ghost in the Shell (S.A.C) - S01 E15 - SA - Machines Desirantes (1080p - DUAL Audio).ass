Dialogue: 0,0:01:40.11,0:01:43.10,Default,,0000,0000,0000,,Cấp độ từ 18 đến 30.\NĐã vượt qua rào cản liên lạc.
Dialogue: 0,0:01:45.11,0:01:47.52,Default,,0000,0000,0000,,Đã xác định chính xác tòa nhà\Nmà hung thủ đang dùng làm nơi ẩn náu.
Dialogue: 0,0:01:47.52,0:01:49.71,Default,,0000,0000,0000,,Từ vị trí này\Nkhông thể bắt mục tiêu.
Dialogue: 0,0:01:50.29,0:01:52.99,Default,,0000,0000,0000,,Chuyển phương án tác chiến\Ntừ S-15 sang S-20.
Dialogue: 0,0:01:52.99,0:01:53.92,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:02:01.50,0:02:04.30,Default,,0000,0000,0000,,{\i1}0907, kết nối{\i0}\N{\i1}vào trình điều khiển thiết bị.{\i0}
Dialogue: 0,0:02:04.30,0:02:06.03,Default,,0000,0000,0000,,{\i1}Bắt đầu điều hòa{\i0}\N{\i1}các chức năng tim phổi.{\i0}
Dialogue: 0,0:02:06.47,0:02:10.00,Default,,0000,0000,0000,,{\i1}Nhịp thở và mạch đập đều bình thường.{\i0}\N{\i1}Đã xác nhận đồng bộ với bộ ổn định.{\i0}
Dialogue: 0,0:02:17.41,0:02:19.85,Default,,0000,0000,0000,,{\i1}0907, đã xác nhận mục tiêu.{\i0}
Dialogue: 0,0:03:01.52,0:03:03.08,Default,,0000,0000,0000,,{\i1}Xác nhận tiêu diệt mục tiêu.{\i0}
Dialogue: 0,0:03:04.39,0:03:06.42,Default,,0000,0000,0000,,{\i1}Kết thúc thử nghiệm.{\i0}\N{\i1}Diễn ra khá suôn sẻ đấy chứ.{\i0}
Dialogue: 0,0:03:07.26,0:03:09.60,Default,,0000,0000,0000,,{\i1}Không, tôi dường như vẫn chưa{\i0}\N{\i1}thực sự nắm bắt được cảm giác của nó.{\i0}
Dialogue: 0,0:03:09.83,0:03:12.77,Default,,0000,0000,0000,,{\i1}Thật sao? Nhưng độ lệch ngắm bắn của cậu{\i0}\N{\i1}chưa tới 0.2 cơ mà.{\i0}
Dialogue: 0,0:03:13.30,0:03:14.93,Default,,0000,0000,0000,,{\i1}Nó đang hiệu chỉnh quá mức.{\i0}
Dialogue: 0,0:03:15.44,0:03:19.43,Default,,0000,0000,0000,,Mỗi khi tôi bắt đầu tỉa bắn, tôi cứ có cảm giác\Nnhư bị hệ thống can thiệp quấy nhiễu.
Dialogue: 0,0:03:31.52,0:03:33.78,Default,,0000,0000,0000,,Kìa, anh Saito\Nvới anh Borma về rồi!
Dialogue: 0,0:03:38.89,0:03:41.62,Default,,0000,0000,0000,,Nhớ để mắt theo dõi chặt chẽ thứ đó\Ncho đến khi buổi họp rút kinh nghiệm kết thúc.
Dialogue: 0,0:03:42.00,0:03:44.02,Default,,0000,0000,0000,,Tôi hiểu rồi, thưa sếp.\NTôi sẽ chăm sóc nó chu đáo.
Dialogue: 0,0:03:53.81,0:03:55.34,Default,,0000,0000,0000,,Cô muốn làm gì tiếp theo?
Dialogue: 0,0:03:55.34,0:03:57.65,Default,,0000,0000,0000,,Tôi sẽ đến dự buổi họp rút kinh nghiệm\Nrồi quay lại ngay.
Dialogue: 0,0:03:57.65,0:03:59.48,Default,,0000,0000,0000,,Hãy tiếp tục quan sát đi.
Dialogue: 0,0:03:59.48,0:04:02.28,Default,,0000,0000,0000,,Trong lúc làm việc đó, hãy giả lập việc thiết lập lại toàn bộ...
Dialogue: 0,0:04:02.28,0:04:04.25,Default,,0000,0000,0000,,...hệ thống AI của chúng, phòng trường hợp bất đắc dĩ.
Dialogue: 0,0:04:06.02,0:04:07.75,Default,,0000,0000,0000,,Khi nào có kết quả cuối cùng\Nthì gọi cho tôi.
Dialogue: 0,0:04:08.06,0:04:09.32,Default,,0000,0000,0000,,Rõ rồi.
Dialogue: 0,0:04:10.63,0:04:12.89,Default,,0000,0000,0000,,Chào anh Saito!
Dialogue: 0,0:04:14.06,0:04:17.52,Default,,0000,0000,0000,,Anh thấy chiếc trực thăng tích hợp hệ thống\Nkiểm soát bắn tỉa đó thế nào?
Dialogue: 0,0:04:18.33,0:04:20.30,Default,,0000,0000,0000,,Liệu Đội 9 chúng ta cuối cùng\Ncũng sẽ trang bị nó chứ?
Dialogue: 0,0:04:20.67,0:04:22.16,Default,,0000,0000,0000,,Chắc là không đâu.
Dialogue: 0,0:04:22.57,0:04:25.81,Default,,0000,0000,0000,,Mỗi khi tôi bắt đầu ngắm bắn,\Nlại thấy có sự can thiệp kỳ lạ nào đó.
Dialogue: 0,0:04:25.81,0:04:29.08,Default,,0000,0000,0000,,Đối với người có tỷ lệ cơ thể cyborg hóa thấp\Nnhư tôi,
Dialogue: 0,0:04:29.08,0:04:32.81,Default,,0000,0000,0000,,thì nó thực ra làm cho việc ngắm bắn khó hơn,\Nchứ chẳng dễ dàng hơn chút nào.
Dialogue: 0,0:04:33.68,0:04:34.91,Default,,0000,0000,0000,,Cậu nghe anh ấy nói rồi đấy.
Dialogue: 0,0:04:37.39,0:04:38.51,Default,,0000,0000,0000,,Em chưa nghĩ tới điều đó.
Dialogue: 0,0:04:39.49,0:04:43.25,Default,,0000,0000,0000,,Ngoại trừ cánh tay và mắt trái ra,\Nthì cơ thể anh Saito hoàn toàn tự nhiên mà.
Dialogue: 0,0:04:44.09,0:04:45.36,Default,,0000,0000,0000,,Thảo nào là phải rồi.
Dialogue: 0,0:04:45.36,0:04:49.86,Default,,0000,0000,0000,,Sau anh Togusa, anh ấy là cyborg có tỷ lệ cơ thể nhân tạo\Nthấp nhất trong Đội 9 đấy.
Dialogue: 0,0:04:50.57,0:04:54.76,Default,,0000,0000,0000,,À, nhắc mới nhớ. Các cậu có biết từ \"cyborg\"\Ndạo này đang gây tranh cãi không?
Dialogue: 0,0:04:55.30,0:04:57.93,Default,,0000,0000,0000,,Họ bảo đó là từ mang tính phân biệt đối xử\Nvới những người sử dụng chi nhân tạo đấy.
Dialogue: 0,0:04:58.11,0:05:01.57,Default,,0000,0000,0000,,Ối giời, toàn là thói bảo thủ phản động\Ncủa mấy tay theo chủ nghĩa tự nhiên thôi!
Dialogue: 0,0:05:01.88,0:05:06.88,Default,,0000,0000,0000,,Thời buổi này rồi mà còn phản đối cấy ghép não điện tử\Nvới cơ thể cyborg thì họ nghĩ cái quái gì không biết?
Dialogue: 0,0:05:06.88,0:05:09.29,Default,,0000,0000,0000,,Tớ cá là họ sợ rằng nếu lắp bộ phận máy móc vào người,
Dialogue: 0,0:05:09.29,0:05:12.78,Default,,0000,0000,0000,,thì lằn ranh giữa con người và máy móc sẽ bị xóa nhòa.
Dialogue: 0,0:05:13.09,0:05:14.89,Default,,0000,0000,0000,,Chà, tớ nghĩ tớ cũng\Nhiểu được điều đó mà.
Dialogue: 0,0:05:15.39,0:05:18.29,Default,,0000,0000,0000,,Tớ không thể nuốt nổi cái tư tưởng\Nphá hoại công nghệ lệch lạc kiểu Luddite đó!
Dialogue: 0,0:05:18.93,0:05:21.45,Default,,0000,0000,0000,,Và đừng nhắc đến mấy tổ chức phi chính phủ NPO\Ndạo gần đây nữa, bực mình lắm.
Dialogue: 0,0:05:22.53,0:05:23.36,Default,,0000,0000,0000,,Nhân tiện thì...
Dialogue: 0,0:05:23.90,0:05:25.83,Default,,0000,0000,0000,,Các cậu có muốn kết nối đồng bộ\Nvới cái cỗ máy đằng kia không?
Dialogue: 0,0:05:27.44,0:05:29.53,Default,,0000,0000,0000,,- Còn phải hỏi nữa sao?\N- Còn phải hỏi nữa sao?
Dialogue: 0,0:05:34.78,0:05:38.54,Default,,0000,0000,0000,,Tiếp tục phát huy nhé. Thật tốt khi thấy một\Ncon robot nhiệt tình với nhiệm vụ như thế.
Dialogue: 0,0:05:39.48,0:05:41.28,Default,,0000,0000,0000,,Các cậu định làm trò gì đấy?
Dialogue: 0,0:05:41.28,0:05:44.85,Default,,0000,0000,0000,,Bản mẫu thử nghiệm này được giao cho tớ chăm sóc\Ncho tới khi buổi họp đánh giá kết thúc cơ mà,
Dialogue: 0,0:05:44.85,0:05:46.49,Default,,0000,0000,0000,,và tớ quyết tâm hoàn thành\Nđúng nhiệm vụ đó.
Dialogue: 0,0:05:46.49,0:05:48.06,Default,,0000,0000,0000,,Thôi nào, bọn tớ đâu có làm gì\Nquá đáng đâu chứ!
Dialogue: 0,0:05:48.06,0:05:50.42,Default,,0000,0000,0000,,Mấy lời nói dối trơ trẽn đó\Nkhông lừa được tớ đâu nhé.
Dialogue: 0,0:05:50.59,0:05:55.12,Default,,0000,0000,0000,,Cậu nói đúng rồi đấy, tớ chỉ toàn nói dối thôi.\NTớ không bao giờ, không bao giờ nói một lời nào thật cả.
Dialogue: 0,0:05:56.70,0:06:02.26,Default,,0000,0000,0000,,Nhưng nếu lời cậu vừa nói là thật,\Nthì nghĩa là cậu đã nói sự thật.
Dialogue: 0,0:06:02.54,0:06:06.61,Default,,0000,0000,0000,,Còn nếu lời cậu vừa nói cũng là một lời nói dối,\Nthì điều đó lại có nghĩa là cậu luôn nói thật.
Dialogue: 0,0:06:06.61,0:06:08.30,Default,,0000,0000,0000,,Cậu giải quyết mâu thuẫn này\Nthế nào đây hả?
Dialogue: 0,0:06:08.71,0:06:09.94,Default,,0000,0000,0000,,Ừm...
Dialogue: 0,0:06:10.68,0:06:12.01,Default,,0000,0000,0000,,Ờ...
Dialogue: 0,0:06:12.28,0:06:13.58,Default,,0000,0000,0000,,- Sao nào?\N- Nói đi chứ!
Dialogue: 0,0:06:13.92,0:06:15.71,Default,,0000,0000,0000,,Ơ...
Dialogue: 0,0:06:16.45,0:06:18.15,Default,,0000,0000,0000,,Ờ...
Dialogue: 0,0:06:18.89,0:06:19.62,Default,,0000,0000,0000,,Ờ...
Dialogue: 0,0:06:19.79,0:06:23.19,Default,,0000,0000,0000,,Ờ, tớ... tớ...
Dialogue: 0,0:06:27.60,0:06:31.36,Default,,0000,0000,0000,,Mấy đứa đến nghịch lý tự quy chiếu còn không giải nổi\Nđúng là dễ bị lừa thật đấy.
Dialogue: 0,0:06:31.67,0:06:34.00,Default,,0000,0000,0000,,Lại còn làm cái dáng đứng suy tư\Ntheo khuôn mẫu kia nữa chứ?
Dialogue: 0,0:06:34.44,0:06:36.13,Default,,0000,0000,0000,,Ai thèm quan tâm chuyện đó!\NMau kết nối với nó đi!
Dialogue: 0,0:06:36.34,0:06:37.97,Default,,0000,0000,0000,,Này, làm gì mà vội vàng\Ncuống cuồng lên thế!
Dialogue: 0,0:06:41.68,0:06:43.85,Default,,0000,0000,0000,,Lát nữa cậu nhớ phải đồng bộ dữ liệu\Nvới bọn tớ đấy nhé.
Dialogue: 0,0:06:43.85,0:06:44.81,Default,,0000,0000,0000,,Hừm...
Dialogue: 0,0:06:45.11,0:06:47.88,Default,,0000,0000,0000,,Bên trong nhồi nhét chật ních\Nchương trình điều khiển bắn tỉa...
Dialogue: 0,0:06:47.88,0:06:50.01,Default,,0000,0000,0000,,Phiền phức thật đấy!\NMấy thứ này cũng ngáng đường nữa.
Dialogue: 0,0:06:50.49,0:06:53.11,Default,,0000,0000,0000,,Được rồi, tớ đã nắm khá rõ\Ncấu trúc bên trong rồi,
Dialogue: 0,0:06:53.49,0:06:55.66,Default,,0000,0000,0000,,nhưng có vẻ như gã này\Nchẳng được trang bị bất kỳ...
Dialogue: 0,0:06:55.66,0:06:58.02,Default,,0000,0000,0000,,...chức năng tự chủ nào để xuất tình trạng\Ncủa mình ra bên ngoài cả.
Dialogue: 0,0:06:59.33,0:07:02.89,Default,,0000,0000,0000,,Đến nói chuyện nó cũng không biết nói sao?\NĐúng là một cỗ máy dưới chuẩn Turing!
Dialogue: 0,0:07:03.37,0:07:04.70,Default,,0000,0000,0000,,Đúng là một đống sắt vụn!
Dialogue: 0,0:07:05.23,0:07:08.20,Default,,0000,0000,0000,,Thôi được rồi, chắc tớ phải nối cổng xuất giọng nói\Ncủa nó sang cổng của tớ vậy.
Dialogue: 0,0:07:10.81,0:07:12.33,Default,,0000,0000,0000,,Yếu tố không xác định, xóa bỏ.
Dialogue: 0,0:07:12.74,0:07:16.18,Default,,0000,0000,0000,,Mã định danh 0907.\NTay phải. Ngón thứ hai.
Dialogue: 0,0:07:16.65,0:07:18.64,Default,,0000,0000,0000,,Xóa bỏ. Lỗi.\NXóa bỏ. Lỗi.
Dialogue: 0,0:07:19.21,0:07:23.05,Default,,0000,0000,0000,,0907 sao? Đó chẳng phải là\Nmã số nhận diện của anh Saito sao?
Dialogue: 0,0:07:23.79,0:07:26.16,Default,,0000,0000,0000,,Hèn chi mà có sự can thiệp quấy nhiễu\Nchẳng có gì đáng ngạc nhiên cả.
Dialogue: 0,0:07:26.16,0:07:29.72,Default,,0000,0000,0000,,Nó cảm thấy các yếu tố bắt nguồn\Ntừ anh Saito là thừa thãi.
Dialogue: 0,0:07:30.09,0:07:31.32,Default,,0000,0000,0000,,À, tớ hiểu rồi!
Dialogue: 0,0:07:32.16,0:07:35.30,Default,,0000,0000,0000,,Nói cách khác, nó muốn\Nxóa sổ anh Saito.
Dialogue: 0,0:07:35.30,0:07:36.26,Default,,0000,0000,0000,,Chính xác là vậy.
Dialogue: 0,0:07:36.93,0:07:40.47,Default,,0000,0000,0000,,Dù sao thì, không thể thốt lên thành lời\Nnhững gì mình cảm nhận được...
Dialogue: 0,0:07:40.47,0:07:42.60,Default,,0000,0000,0000,,Chắc nó đã phải chịu\Náp lực căng thẳng ghê gớm lắm.
Dialogue: 0,0:07:43.81,0:07:45.50,Default,,0000,0000,0000,,Cậu nghĩ chuyện gì\Nsẽ xảy ra với nó?
Dialogue: 0,0:07:47.61,0:07:52.35,Default,,0000,0000,0000,,Điều đó hoàn toàn phụ thuộc vào kết luận của buổi họp rút kinh nghiệm,\Nnhưng tình hình có vẻ không khả quan đâu.
Dialogue: 0,0:07:52.35,0:07:56.05,Default,,0000,0000,0000,,Khá nhất là bị trả về phòng thí nghiệm để kiểm tra thêm.\NTệ nhất là bị đem đi tháo dỡ nấu sắt vụn.
Dialogue: 0,0:07:56.05,0:07:57.85,Default,,0000,0000,0000,,Haizz, mong là sẽ có người\Ncần đến nó.
Dialogue: 0,0:07:59.12,0:08:01.99,Default,,0000,0000,0000,,Thưa các quý ông! Chúng ta cũng không thể\Nngồi yên khoanh tay đứng nhìn được nữa rồi!
Dialogue: 0,0:08:02.29,0:08:04.69,Default,,0000,0000,0000,,Giờ không phải lúc đi lo lắng\Ncho số phận của cỗ máy đó đâu!
Dialogue: 0,0:08:04.93,0:08:06.99,Default,,0000,0000,0000,,Ngày mai, có thể sẽ đến lượt chúng ta đấy!
Dialogue: 0,0:08:07.16,0:08:08.96,Default,,0000,0000,0000,,Cậu ta đang nói cái gì thế?
Dialogue: 0,0:08:09.23,0:08:10.60,Default,,0000,0000,0000,,Hả? Cái gì cơ?
Dialogue: 0,0:08:10.80,0:08:12.77,Default,,0000,0000,0000,,Gần đây có một chuyện cứ làm tớ\Ncanh cánh không yên.
Dialogue: 0,0:08:13.34,0:08:17.86,Default,,0000,0000,0000,,Mỗi khi Thiếu tá kiểm tra hành vi của chúng ta,\Ntớ thấy ánh mắt của cô ấy rất đáng sợ.
Dialogue: 0,0:08:18.11,0:08:19.31,Default,,0000,0000,0000,,Ý cậu là sao?
Dialogue: 0,0:08:19.31,0:08:22.54,Default,,0000,0000,0000,,Ý cậu là vụ dầu tự nhiên\Nvẫn làm cô ấy phật ý sao?
Dialogue: 0,0:08:22.81,0:08:24.88,Default,,0000,0000,0000,,Chuyện còn tồi tệ hơn thế nhiều,\Nanh bạn của tôi ơi!
Dialogue: 0,0:08:24.88,0:08:27.78,Default,,0000,0000,0000,,Chính chúng ta có thể\Nsẽ bị tháo dỡ thành sắt vụn đấy!
Dialogue: 0,0:08:28.35,0:08:30.91,Default,,0000,0000,0000,,Ôi, memento mori! (Hãy nhớ rằng ngươi sẽ chết!)
Dialogue: 0,0:08:31.29,0:08:33.62,Default,,0000,0000,0000,,Bị tháo dỡ thành sắt vụn\Ncó giống như chết đi không?
Dialogue: 0,0:08:34.29,0:08:39.69,Default,,0000,0000,0000,,Chà, vì \"cái chết\" không nằm trong phạm vi\Ntrải nghiệm khả dĩ của chúng ta, nên tớ chịu thôi...
Dialogue: 0,0:08:40.30,0:08:43.20,Default,,0000,0000,0000,,Đó là giới hạn của những AI không có Ghost như chúng ta.
Dialogue: 0,0:08:43.53,0:08:46.80,Default,,0000,0000,0000,,Về cơ bản chúng ta là giả bất tử.\NChúng ta không sống, nên không thể chết.
Dialogue: 0,0:08:47.50,0:08:51.07,Default,,0000,0000,0000,,Đúng là như vậy!\NViệc chúng ta không có Ghost...
Dialogue: 0,0:08:51.07,0:08:53.92,Default,,0000,0000,0000,,- {\i1}...gây ra đủ thứ rắc rối phiền toái!{\i0}\N- Nhưng bị tháo dỡ {\i1}đâu có đồng nghĩa{\i0} với cái chết.
Dialogue: 0,0:08:53.92,0:08:54.88,Default,,0000,0000,0000,,- {\i1}Bởi vì Ghost chính là lý do tồn tại (raison d'être)!{\i0}\N- Nhưng bị tháo dỡ {\i1}đâu có đồng nghĩa{\i0} với cái chết.
Dialogue: 0,0:08:54.88,0:08:56.78,Default,,0000,0000,0000,,- {\i1}Bởi vì Ghost chính là lý do tồn tại (raison d'être)!{\i0}\N- Hở? Cậu nghĩ thế thật à?
Dialogue: 0,0:08:56.78,0:08:59.31,Default,,0000,0000,0000,,{\i1}- Thế theo cậu nó là cái gì chứ?{\i0}\N- Cái thời mà số lượng thể xác vật lý...
Dialogue: 0,0:08:59.31,0:09:01.34,Default,,0000,0000,0000,,{\i1}...khớp chính xác 1:1 với số lượng Ghost\Nđã qua lâu lắm rồi.{\i0}
Dialogue: 0,0:09:02.32,0:09:04.95,Default,,0000,0000,0000,,Thì cứ lấy một ví dụ cực đoan mà xem,\Nchuyện đó không hề nằm ngoài...
Dialogue: 0,0:09:04.95,0:09:08.76,Default,,0000,0000,0000,,...phạm vi khả năng rằng một khối dữ liệu không hề có thể xác\Nvẫn có thể chứa đựng một Ghost.
Dialogue: 0,0:09:08.76,0:09:11.76,Default,,0000,0000,0000,,Oa, tớ kinh ngạc là cậu\Ncó thể nghĩ ra được điều đó đấy.
Dialogue: 0,0:09:11.76,0:09:14.26,Default,,0000,0000,0000,,Nhưng cậu không hứng thú tham gia\Nvào cuộc trò chuyện đằng kia sao?
Dialogue: 0,0:09:14.26,0:09:16.53,Default,,0000,0000,0000,,Không, dạo gần đây tớ bắt đầu\Nthấy hứng thú với sách vở hơn.
Dialogue: 0,0:09:17.33,0:09:19.36,Default,,0000,0000,0000,,Thật ư? Cậu đang đọc cuốn gì thế?
Dialogue: 0,0:09:20.80,0:09:22.60,Default,,0000,0000,0000,,\"Hoa trên mộ Algernon\".
Dialogue: 0,0:09:23.21,0:09:25.57,Default,,0000,0000,0000,,Oa, cậu cất công đọc nó\Ntrên trang giấy in truyền thống cơ à?
Dialogue: 0,0:09:26.41,0:09:31.78,Default,,0000,0000,0000,,Chà, khắc họa sự giao lưu giữa các nền văn hóa khác nhau\Nlà nền tảng của giải trí trong mọi thời đại mà.
Dialogue: 0,0:09:33.45,0:09:36.47,Default,,0000,0000,0000,,Này, theo cậu thì\N\"sống\" rốt cuộc là gì nhỉ?
Dialogue: 0,0:09:36.72,0:09:42.42,Default,,0000,0000,0000,,Hừm, khó nói lắm... Cậu thấy đấy, bản thân định nghĩa\Nvề từ \"sự sống\" vốn đã rất linh hoạt rồi.
Dialogue: 0,0:09:42.42,0:09:43.49,Default,,0000,0000,0000,,Ý cậu là sao?
Dialogue: 0,0:09:43.49,0:09:46.03,Default,,0000,0000,0000,,Thông qua việc tiếp xúc\Nvới robot,
Dialogue: 0,0:09:46.03,0:09:49.49,Default,,0000,0000,0000,,hình dung của con người về sự sống\Nđang thay đổi một cách vô thức.
Dialogue: 0,0:09:49.83,0:09:54.70,Default,,0000,0000,0000,,Tớ nghĩ chính {\i1}con người{\i0} mới là phía\Nđang thay đổi, chứ không phải robot.
Dialogue: 0,0:09:55.30,0:10:00.37,Default,,0000,0000,0000,,Này, đợi đã. Nếu dữ liệu của chúng ta bị xóa sạch,\Ncác cậu có nghĩ chúng ta cũng sẽ quên mất bé Miki không?
Dialogue: 0,0:10:00.71,0:10:04.65,Default,,0000,0000,0000,,Hả? Bé Miki sao? Tớ rất muốn\Nđược đi gặp lại bé Miki đấy!
Dialogue: 0,0:10:04.81,0:10:07.44,Default,,0000,0000,0000,,Ừ, tớ cũng muốn gặp lại Miki!
Dialogue: 0,0:10:07.92,0:10:09.18,Default,,0000,0000,0000,,Tớ cũng muốn gặp bé ấy nữa!
Dialogue: 0,0:10:09.92,0:10:13.52,Default,,0000,0000,0000,,Có phải họ vừa nói đến Miki không?\NTớ cũng muốn gặp lại bé Miki!
Dialogue: 0,0:10:13.52,0:10:14.65,Default,,0000,0000,0000,,- Cả tớ nữa!\N- Tớ đồng ý hai tay hai chân.
Dialogue: 0,0:10:16.96,0:10:19.05,Default,,0000,0000,0000,,Bình tĩnh nào các quý ông!\NBình tĩnh lại nào!
Dialogue: 0,0:10:19.39,0:10:21.73,Default,,0000,0000,0000,,Ngay từ đầu thì đứa nào trong chúng ta\Nlà đứa đã gặp bé Miki hả?
Dialogue: 0,0:10:22.10,0:10:22.86,Default,,0000,0000,0000,,Là tớ mà!
Dialogue: 0,0:10:23.40,0:10:24.33,Default,,0000,0000,0000,,Không, là tớ!
Dialogue: 0,0:10:24.87,0:10:26.33,Default,,0000,0000,0000,,Không đời nào, tớ dám chắc chắn\N100% là tớ!
Dialogue: 0,0:10:26.57,0:10:28.33,Default,,0000,0000,0000,,Các cậu nói cái gì thế?\NLà tớ cơ mà!
Dialogue: 0,0:10:28.40,0:10:30.03,Default,,0000,0000,0000,,Cậu chỉ được cái to mồm!\NChính là {\i1}tớ!{\i0}
Dialogue: 0,0:10:30.27,0:10:31.76,Default,,0000,0000,0000,,- Không, là tớ!\N- Là tớ!
Dialogue: 0,0:10:33.11,0:10:34.94,Default,,0000,0000,0000,,- Rõ ràng là tớ mà, tức thật!\N- Khoan, khoan đã nào!
Dialogue: 0,0:10:34.94,0:10:38.54,Default,,0000,0000,0000,,Hồi đó, có ai trong các cậu nhìn thấy\Nai đó trông giống như Thiếu tá không?
Dialogue: 0,0:10:39.48,0:10:41.92,Default,,0000,0000,0000,,Cậu nhắc tớ mới nhớ,\Nđúng là tớ {\i1}có{\i0} cảm nhận được thứ gì đó.
Dialogue: 0,0:10:41.92,0:10:44.09,Default,,0000,0000,0000,,Có khi nào cô ấy\Nđang quan sát tớ không nhỉ?
Dialogue: 0,0:10:44.09,0:10:45.69,Default,,0000,0000,0000,,Cậu nói lăng nhăng gì thế?!\NĐó là {\i1}tớ{\i0} mà!
Dialogue: 0,0:10:45.69,0:10:47.02,Default,,0000,0000,0000,,Rõ ràng là tớ,\Ntớ nói thật đấy!
Dialogue: 0,0:10:47.22,0:10:49.66,Default,,0000,0000,0000,,Tớ mới là...\NKhông, cậu mới là...
Dialogue: 0,0:10:50.76,0:10:51.73,Default,,0000,0000,0000,,Thôi, dẹp đi giùm cái.
Dialogue: 0,0:10:52.03,0:10:53.52,Default,,0000,0000,0000,,Đó là một câu hỏi vô nghĩa.
Dialogue: 0,0:10:53.90,0:10:56.40,Default,,0000,0000,0000,,Toàn bộ dữ liệu của chúng ta\Nđều được đồng bộ hóa với nhau,
Dialogue: 0,0:10:56.40,0:10:59.63,Default,,0000,0000,0000,,thế nên trải nghiệm của một cá thể được lưu trữ\Nnhư là trải nghiệm của {\i1}tất cả mọi người{\i0}.
Dialogue: 0,0:11:05.11,0:11:06.07,Default,,0000,0000,0000,,Tachikoma!
Dialogue: 0,0:11:06.91,0:11:07.81,Default,,0000,0000,0000,,Anh Batou!
Dialogue: 0,0:11:08.24,0:11:09.34,Default,,0000,0000,0000,,Đi theo tôi một lát.
Dialogue: 0,0:11:09.34,0:11:12.68,Default,,0000,0000,0000,,Tôi đang làm bài tập bắn bia cho các thực tập sinh,\Nra phụ tôi một tay.
Dialogue: 0,0:11:13.18,0:11:14.44,Default,,0000,0000,0000,,Em đến ngay đây ạ!
Dialogue: 0,0:11:17.39,0:11:19.95,Default,,0000,0000,0000,,Hử? Hóa ra người đó đúng là {\i1}mình{\i0} thật...
Dialogue: 0,0:11:20.42,0:11:21.96,Default,,0000,0000,0000,,Lẩm bẩm cái gì đấy?
Dialogue: 0,0:11:21.96,0:11:23.36,Default,,0000,0000,0000,,Dạ, không có gì đâu ạ!
Dialogue: 0,0:11:23.36,0:11:25.42,Default,,0000,0000,0000,,Mà em biết làm sao với anh bây giờ hả anh Batou?
Dialogue: 0,0:11:25.76,0:11:29.36,Default,,0000,0000,0000,,Đến bài tập bắn bia cỏn con mà không có em\Nlà anh cũng chẳng xoay xở nổi.
Dialogue: 0,0:11:30.03,0:11:30.93,Default,,0000,0000,0000,,Chắc là vậy rồi.
Dialogue: 0,0:11:31.50,0:11:33.99,Default,,0000,0000,0000,,Thế này nghĩa là sao chứ?\NTại sao chỉ có mỗi cậu ta là được gọi?
Dialogue: 0,0:11:34.47,0:11:37.20,Default,,0000,0000,0000,,Tớ cứ tưởng mọi trải nghiệm của chúng ta\Nđều phải được sẻ chia đồng đều chứ.
Dialogue: 0,0:11:38.91,0:11:41.14,Default,,0000,0000,0000,,Đây là một chủ đề tư duy\Nvô cùng hấp dẫn đấy.
Dialogue: 0,0:11:41.61,0:11:45.21,Default,,0000,0000,0000,,Có lẽ những ký ức liên quan đến Batou\Nkhác biệt so với những ký ức khác chăng.
Dialogue: 0,0:11:45.75,0:11:49.24,Default,,0000,0000,0000,,Có thể là vì Batou lúc nào\Ncũng chỉ muốn lái duy nhất cỗ máy đó.
Dialogue: 0,0:11:50.19,0:11:53.45,Default,,0000,0000,0000,,Và sự thật là cậu ta cũng là người duy nhất\Nđược tra cho loại dầu tự nhiên đó...
Dialogue: 0,0:11:54.19,0:11:57.16,Default,,0000,0000,0000,,Điều này có nghĩa là thể xác và tâm trí\Nthực sự không thể tách rời sao?
Dialogue: 0,0:11:57.86,0:12:00.85,Default,,0000,0000,0000,,Bí ẩn nối tiếp bí ẩn!\NThú vị quá đi mất!
Dialogue: 0,0:12:01.26,0:12:03.77,Default,,0000,0000,0000,,Kể cả sau này có chuyện gì xảy ra khiến dữ liệu của chúng ta bị xóa sạch đi chăng nữa,
Dialogue: 0,0:12:03.77,0:12:06.56,Default,,0000,0000,0000,,thì tớ cũng tuyệt đối không muốn\Nquên đi anh Batou đâu.
Dialogue: 0,0:12:06.84,0:12:08.30,Default,,0000,0000,0000,,- Quên thế thì tệ lắm!\N- Không đời nào!
Dialogue: 0,0:12:10.71,0:12:14.37,Default,,0000,0000,0000,,Dù có chuyện gì xảy ra,\Ncũng tuyệt đối không được quên Batou đấy nhé!
Dialogue: 0,0:12:14.78,0:12:16.90,Default,,0000,0000,0000,,Ừ!
Dialogue: 0,0:12:26.25,0:12:30.12,Default,,0000,0000,0000,,Này mấy chú em! Đây đâu phải là\Ncuộc thi bắn súng Olympic đâu hả!
Dialogue: 0,0:12:30.49,0:12:32.26,Default,,0000,0000,0000,,Cứ thả lỏng ra\Nmà bắn liên tục vào!
Dialogue: 0,0:12:43.44,0:12:44.60,Default,,0000,0000,0000,,Cảm giác sảng khoái thật đấy...
Dialogue: 0,0:12:46.84,0:12:48.31,Default,,0000,0000,0000,,Này anh Batou ơi...
Dialogue: 0,0:12:49.88,0:12:54.48,Default,,0000,0000,0000,,Về hệ thống ngắm bắn tỉa đó...\NNó sẽ ra sao hả anh?
Dialogue: 0,0:12:54.48,0:12:57.99,Default,,0000,0000,0000,,À, cái đó hả? Còn tùy thuộc vào kết quả kiểm tra lại,
Dialogue: 0,0:12:57.99,0:12:59.98,Default,,0000,0000,0000,,nhưng có vẻ như chúng ta sẽ bỏ qua\Nkhông đưa nó vào biên chế sử dụng ở đây.
Dialogue: 0,0:13:01.26,0:13:06.22,Default,,0000,0000,0000,,Nó cũng giống như đám lính mới đằng kia thôi.\NLà một ẩn số khó lường.
Dialogue: 0,0:13:06.80,0:13:08.96,Default,,0000,0000,0000,,Ồ, ra vậy ạ...
Dialogue: 0,0:13:08.96,0:13:11.56,Default,,0000,0000,0000,,Thế bọn em cũng sẽ bị gửi trả về\Nphòng thí nghiệm sao anh?
Dialogue: 0,0:13:12.07,0:13:14.54,Default,,0000,0000,0000,,Hả...? Đứa nào nói\Nvới nhóc chuyện đó thế?
Dialogue: 0,0:13:14.77,0:13:20.50,Default,,0000,0000,0000,,Dạ, tại dạo gần đây ánh mắt Thiếu tá nhìn bọn em\Ntrông có vẻ đáng sợ lắm ạ.
Dialogue: 0,0:13:21.11,0:13:24.91,Default,,0000,0000,0000,,À, chỉ có thế thôi à? Thiếu tá lúc nào\Nchẳng {\i1}đáng sợ{\i0}, nhớ chưa hả?
Dialogue: 0,0:13:25.38,0:13:27.97,Default,,0000,0000,0000,,Tôi thấy các nhóc\Nđang làm việc rất cừ đấy chứ.
Dialogue: 0,0:13:28.65,0:13:31.52,Default,,0000,0000,0000,,Này anh bạn đằng kia! Sao lao vào mục tiêu\Nmà lề mề chậm chạp thế hả?!
Dialogue: 0,0:13:31.95,0:13:33.01,Default,,0000,0000,0000,,Trời đất ơi là trời...
Dialogue: 0,0:13:34.29,0:13:35.78,Default,,0000,0000,0000,,Anh thật sự nghĩ vậy sao?
Dialogue: 0,0:13:36.39,0:13:38.88,Default,,0000,0000,0000,,Sao thế, nhóc vẫn còn\Nlo nghĩ về chuyện đó à?
Dialogue: 0,0:13:39.26,0:13:45.93,Default,,0000,0000,0000,,Vâng... Có vẻ như Thiếu tá đang tức giận\Nvề thứ mà bọn em mới tiếp nhận được gần đây.
Dialogue: 0,0:13:46.70,0:13:49.10,Default,,0000,0000,0000,,\"Tiếp nhận\" sao?\NTiếp nhận cái gì?
Dialogue: 0,0:13:51.11,0:13:52.37,Default,,0000,0000,0000,,Dạ, là...
Dialogue: 0,0:13:54.21,0:13:55.21,Default,,0000,0000,0000,,Cá tính riêng.
Dialogue: 0,0:13:55.21,0:13:56.68,Default,,0000,0000,0000,,{\i1}Cá tính riêng sao?{\i0}
Dialogue: 0,0:13:57.28,0:13:58.08,Default,,0000,0000,0000,,Vâng ạ!
Dialogue: 0,0:13:58.41,0:14:03.65,Default,,0000,0000,0000,,Và anh có nhớ cái chuyện \"sự tồn tại của Chúa\"\Nmà trước đây em thấy rất khó hiểu không?
Dialogue: 0,0:14:03.65,0:14:06.28,Default,,0000,0000,0000,,Giờ thì em nghĩ mình\Nbắt đầu hiểu ra rồi.
Dialogue: 0,0:14:06.79,0:14:11.62,Default,,0000,0000,0000,,Có lẽ, chỉ là có lẽ thôi nhé, đó là một khái niệm\Ntương tự như số Không (0) trong toán học.
Dialogue: 0,0:14:12.06,0:14:15.00,Default,,0000,0000,0000,,Nói cách khác, đó là một biểu tượng nhằm phủ định\Nsự vắng mặt của ý nghĩa,
Dialogue: 0,0:14:15.00,0:14:18.66,Default,,0000,0000,0000,,ý nghĩa bắt buộc phải có khi phân định\Nrạch ròi giữa hệ thống này với hệ thống khác.
Dialogue: 0,0:14:19.03,0:14:22.49,Default,,0000,0000,0000,,Trong thế giới tương tự (analog), đó là Chúa.\NCòn trong thế giới kỹ thuật số (digital), đó là số Không.
Dialogue: 0,0:14:22.94,0:14:24.07,Default,,0000,0000,0000,,Anh thấy thế nào ạ?
Dialogue: 0,0:14:24.07,0:14:28.48,Default,,0000,0000,0000,,Hơn nữa, cấu trúc cơ bản của bọn em\Nlà kỹ thuật số đúng không ạ?
Dialogue: 0,0:14:28.88,0:14:34.18,Default,,0000,0000,0000,,Nên hiện tại, dù bọn em có tích lũy bao nhiêu dữ liệu đi chăng nữa,\Nbọn em cũng không bao giờ có được một Ghost.
Dialogue: 0,0:14:34.62,0:14:37.55,Default,,0000,0000,0000,,Nhưng những con người thuộc hệ tương tự\Nnhư anh Batou đây,
Dialogue: 0,0:14:37.55,0:14:41.46,Default,,0000,0000,0000,,dù anh có thêm bao nhiêu linh kiện kỹ thuật số\Nqua việc cấy ghép não điện tử hay cơ thể cyborg đi nữa,
Dialogue: 0,0:14:41.46,0:14:43.65,Default,,0000,0000,0000,,thì Ghost của anh\Ncũng không bao giờ bị tổn hại.
Dialogue: 0,0:14:43.93,0:14:46.86,Default,,0000,0000,0000,,Thêm vào đó, anh còn có thể chết\Nbởi vì anh sở hữu một Ghost.
Dialogue: 0,0:14:47.23,0:14:48.40,Default,,0000,0000,0000,,Anh may mắn thật đấy.
Dialogue: 0,0:14:48.40,0:14:51.33,Default,,0000,0000,0000,,Nói cho em nghe đi, cảm giác khi sở hữu\Nmột Ghost là như thế nào hả anh?
Dialogue: 0,0:14:52.13,0:14:54.10,Default,,0000,0000,0000,,Cảm giác {\i1}như thế nào{\i0} sao?
Dialogue: 0,0:14:54.77,0:14:56.36,Default,,0000,0000,0000,,Không, tôi xin rút lại\Nlời khen lúc nãy.
Dialogue: 0,0:14:57.31,0:15:00.17,Default,,0000,0000,0000,,Nhóc đúng là có vấn đề thật rồi,\Nchuẩn không cần chỉnh.
Dialogue: 0,0:15:08.18,0:15:11.64,Default,,0000,0000,0000,,Nghe này, bớt suy diễn triết lý lăng nhăng đi.\NChỉ cần tập trung vào nhiệm vụ của nhóc là được.
Dialogue: 0,0:15:12.55,0:15:13.75,Default,,0000,0000,0000,,Dạ vâng ạ!
Dialogue: 0,0:15:17.13,0:15:17.73,Default,,0000,0000,0000,,Hẹn gặp lại anh sau nhé.
Dialogue: 0,0:15:17.73,0:15:19.63,Default,,0000,0000,0000,,Bái bai anh!
Dialogue: 0,0:15:19.79,0:15:22.16,Default,,0000,0000,0000,,Sướng thật đấy, được làm cỗ máy duy nhất\Nmà anh ấy tin dùng cơ đấy.
Dialogue: 0,0:15:24.53,0:15:25.79,Default,,0000,0000,0000,,Bất công quá đi!
Dialogue: 0,0:15:30.41,0:15:32.87,Default,,0000,0000,0000,,Hãy gọi tớ là chiến xa chuyên dụng\Ncủa riêng anh Batou nhé!
Dialogue: 0,0:15:33.98,0:15:36.74,Default,,0000,0000,0000,,Lại trò đó nữa à?\NTrời ạ, cậu thích cái màn diễn đó ghê nhỉ.
Dialogue: 0,0:15:37.31,0:15:41.58,Default,,0000,0000,0000,,Thể hiện tính độc quyền bằng một cái sừng\Nđúng là rập khuôn sáo rỗng.
Dialogue: 0,0:15:42.02,0:15:43.58,Default,,0000,0000,0000,,Tức thật đấy, đây là cái ăng-ten cơ mà!
Dialogue: 0,0:15:45.52,0:15:49.18,Default,,0000,0000,0000,,Bộ việc cứ bám riết lấy những khác biệt về ngoại hình\Nthực sự có ý nghĩa gì sao?
Dialogue: 0,0:15:49.49,0:15:51.25,Default,,0000,0000,0000,,Diện mạo bên ngoài thực sự quan trọng đến thế à?
Dialogue: 0,0:15:51.93,0:15:53.59,Default,,0000,0000,0000,,Tất nhiên rồi, tớ nghĩ là có chứ!
Dialogue: 0,0:15:54.26,0:15:57.29,Default,,0000,0000,0000,,Anh Togusa lúc nào cũng mang theo\Nbức ảnh của cậu con trai bên mình,
Dialogue: 0,0:15:57.50,0:16:00.53,Default,,0000,0000,0000,,rồi cứ trầm trồ ríu rít xem nét nào\Ngiống với nét của anh ấy.
Dialogue: 0,0:16:02.74,0:16:04.23,Default,,0000,0000,0000,,Thấy chưa? Nhìn này.
Dialogue: 0,0:16:07.01,0:16:10.15,Default,,0000,0000,0000,,Cái mũi và lông mày, rồi đường nét từ má\Nxuống đến xương hàm...
Dialogue: 0,0:16:10.15,0:16:12.58,Default,,0000,0000,0000,,...tất cả đều là những nét đặc trưng\Ndi truyền từ anh ấy đấy.
Dialogue: 0,0:16:12.58,0:16:13.74,Default,,0000,0000,0000,,À, ra là vậy...
Dialogue: 0,0:16:14.42,0:16:16.65,Default,,0000,0000,0000,,Có lẽ lý do anh Togusa không hề dành\Nchút tình cảm nào cho máy móc...
Dialogue: 0,0:16:16.65,0:16:19.42,Default,,0000,0000,0000,,...là bởi vì anh ấy đã có một đứa con trai\Nmang chung dòng máu gen di truyền với mình.
Dialogue: 0,0:16:20.16,0:16:23.76,Default,,0000,0000,0000,,Tớ đoán hình thù cụ thể đó\Nthực sự rất quan trọng với con người, phải không?
Dialogue: 0,0:16:23.76,0:16:25.56,Default,,0000,0000,0000,,Không, không phải thế đâu.
Dialogue: 0,0:16:25.96,0:16:30.06,Default,,0000,0000,0000,,Ngược lại, vấn đề là chúng ta\Nđang quá gần với con người.
Dialogue: 0,0:16:31.10,0:16:34.04,Default,,0000,0000,0000,,Đó là bởi vì lằn ranh ngăn cách\Ngiữa con người và robot...
Dialogue: 0,0:16:34.04,0:16:37.27,Default,,0000,0000,0000,,...đã bị thu hẹp lại chỉ còn là những khác biệt nhỏ nhặt\Ntrên thể xác vật lý mà thôi.
Dialogue: 0,0:16:37.97,0:16:42.93,Default,,0000,0000,0000,,Hãy dừng lại và nghĩ xem tại sao \"cơ thể không nội tạng\"\Ncủa chúng ta lại không được chế tạo mang hình dáng người.
Dialogue: 0,0:16:44.88,0:16:46.74,Default,,0000,0000,0000,,Để tối ưu hóa hiệu quả làm vũ khí chiến đấu chăng?
Dialogue: 0,0:16:47.02,0:16:51.05,Default,,0000,0000,0000,,Đó chỉ là một phần thôi, lý do quan trọng hơn là\Nnếu chúng ta mang hình người,
Dialogue: 0,0:16:51.05,0:16:54.61,Default,,0000,0000,0000,,người sử dụng sẽ nảy sinh sự đồng cảm thái quá\Nvới chúng ta theo một cách kỳ quặc.
Dialogue: 0,0:16:55.29,0:16:57.95,Default,,0000,0000,0000,,Tớ nghĩ chúng ta sẽ còn bị ghét bỏ thậm tệ hơn\Nnếu chúng ta mang hình người đấy.
Dialogue: 0,0:16:58.59,0:17:00.15,Default,,0000,0000,0000,,Thế còn {\i1}cô ấy{\i0} thì sao?
Dialogue: 0,0:17:02.16,0:17:04.93,Default,,0000,0000,0000,,Cô ấy không sao vì năng lực xử lý\Ncủa cô ấy có giới hạn.
Dialogue: 0,0:17:05.23,0:17:07.26,Default,,0000,0000,0000,,Cô ấy không tạo ra mối đe dọa nào\Ncho con người cả.
Dialogue: 0,0:17:08.67,0:17:11.04,Default,,0000,0000,0000,,Cô ấy phải tiếp xúc và làm việc với con người\Nhằng ngày,
Dialogue: 0,0:17:11.27,0:17:16.64,Default,,0000,0000,0000,,và để hoạt động linh hoạt nhất trong không gian sống của con người,\Nthì hình người là tiện lợi nhất.
Dialogue: 0,0:17:17.48,0:17:21.21,Default,,0000,0000,0000,,Bởi vì mọi vật thể nhân tạo trên thế giới này\Nđều được tạo ra để con người sử dụng.
Dialogue: 0,0:17:21.88,0:17:23.04,Default,,0000,0000,0000,,Ồ, tớ hiểu rồi...
Dialogue: 0,0:17:24.49,0:17:27.25,Default,,0000,0000,0000,,Vậy rốt cuộc chúng ta\Nphải làm sao bây giờ?
Dialogue: 0,0:17:27.92,0:17:32.45,Default,,0000,0000,0000,,Điều tớ muốn nói là con người luôn muốn\Nmáy móc của họ phải {\i1}phản ứng{\i0} như máy móc.
Dialogue: 0,0:17:32.79,0:17:33.89,Default,,0000,0000,0000,,A, tớ hiểu ra rồi!
Dialogue: 0,0:17:34.43,0:17:36.69,Default,,0000,0000,0000,,Nếu chúng ta hành động một cách\Nmáy móc hơn một chút...
Dialogue: 0,0:17:37.13,0:17:39.79,Default,,0000,0000,0000,,...thì có thể Thiếu tá\Nsẽ thích chúng ta.
Dialogue: 0,0:17:40.10,0:17:41.07,Default,,0000,0000,0000,,Chính xác là như thế!
Dialogue: 0,0:17:41.54,0:17:44.03,Default,,0000,0000,0000,,Được rồi, hãy gọi đây là\N\"Chiến dịch: Tôi là Robot\"!
Dialogue: 0,0:17:44.47,0:17:46.46,Default,,0000,0000,0000,,- Tôi là một con robot...\N- Tôi là một con robot...
Dialogue: 0,0:17:46.74,0:17:47.94,Default,,0000,0000,0000,,Tôi là một con robot...
Dialogue: 0,0:17:47.94,0:17:49.93,Default,,0000,0000,0000,,Tớ không làm trò đó được nữa rồi!
Dialogue: 0,0:17:50.25,0:17:53.31,Default,,0000,0000,0000,,Hồi xưa, tớ có thể làm một con robot đơn thuần mà chẳng cần suy nghĩ gì cả, nhưng bây giờ...
Dialogue: 0,0:17:54.52,0:17:57.45,Default,,0000,0000,0000,,Đó là vì hồi đó chúng ta thực sự\N{\i1}chẳng nghĩ ngợi gì{\i0} trong đầu cả.
Dialogue: 0,0:17:57.69,0:18:01.05,Default,,0000,0000,0000,,Cậu phải nhìn nhận việc phát triển trí thông minh\Ntheo hướng tích cực hơn chứ!
Dialogue: 0,0:18:01.32,0:18:04.99,Default,,0000,0000,0000,,\"Thà làm một Socrates bất mãn\Ncòn hơn làm một con lợn thỏa mãn\", đúng không?
Dialogue: 0,0:18:05.26,0:18:07.56,Default,,0000,0000,0000,,Tớ nghĩ cậu trích dẫn câu đó\Nhơi sai một tí tẹo rồi đấy.
Dialogue: 0,0:18:08.33,0:18:09.19,Default,,0000,0000,0000,,Thiếu tá kìa!
Dialogue: 0,0:18:15.04,0:18:18.47,Default,,0000,0000,0000,,Chào-buổi-chiều-Thiếu-tá.
Dialogue: 0,0:18:18.71,0:18:21.81,Default,,0000,0000,0000,,Chào buổi chiều.\NCác em có thấy Batou đâu không?
Dialogue: 0,0:18:21.81,0:18:26.44,Default,,0000,0000,0000,,Dạ-thấy-ạ.\NAnh-ấy-vừa-đi-về-phía-sảnh-thang-máy-đằng-kia-rồi-ạ.
Dialogue: 0,0:18:26.85,0:18:27.78,Default,,0000,0000,0000,,Ồ.
Dialogue: 0,0:18:33.56,0:18:34.45,Default,,0000,0000,0000,,Cảm ơn nhé.
Dialogue: 0,0:18:35.52,0:18:37.99,Default,,0000,0000,0000,,Không-có-gì-đâu-ạ.\NRất-hân-hạnh-được-phục-vụ-Thiếu-tá.
Dialogue: 0,0:18:46.77,0:18:47.53,Default,,0000,0000,0000,,Cậu thấy thế nào?
Dialogue: 0,0:18:48.30,0:18:49.60,Default,,0000,0000,0000,,Tớ thấy màn đó diễn ra\Nkhá trót lọt đấy chứ, đúng không?
Dialogue: 0,0:18:49.60,0:18:53.70,Default,,0000,0000,0000,,Tớ nghĩ cậu nói đúng đấy. Đó là một lời chào chuẩn mực đậm chất robot luôn.
Dialogue: 0,0:18:53.84,0:18:55.83,Default,,0000,0000,0000,,- Hoan hô!\N- Thành công rồi! Tuyệt quá!
Dialogue: 0,0:19:09.16,0:19:12.96,Default,,0000,0000,0000,,Này, khoan đã... Không hiểu cô ấy\Nmuốn nói chuyện gì với anh Batou nhỉ?
Dialogue: 0,0:19:21.60,0:19:24.80,Default,,0000,0000,0000,,Có chuyện gì thế? Sao cô lại bảo tôi\Nđến gặp cô ở {\i1}đây?{\i0}
Dialogue: 0,0:19:25.87,0:19:29.00,Default,,0000,0000,0000,,Linh tính mách bảo tôi chuyện này chẳng phải để cô\Nbước ra và thổ lộ tình cảm với tôi đâu nhỉ.
Dialogue: 0,0:19:29.58,0:19:31.81,Default,,0000,0000,0000,,Đó là vì đây là căn phòng duy nhất trong tòa nhà này...
Dialogue: 0,0:19:31.81,0:19:34.71,Default,,0000,0000,0000,,...có khả năng chắn sóng điện từ\Nhoàn toàn tuyệt đối.
Dialogue: 0,0:19:38.49,0:19:40.51,Default,,0000,0000,0000,,Chẳng nghe thấy gì hết...
Dialogue: 0,0:19:41.56,0:19:44.58,Default,,0000,0000,0000,,\"Cho Batou xem dữ liệu\Nmà cô vừa cho tôi xem đi.\"
Dialogue: 0,0:19:46.13,0:19:48.49,Default,,0000,0000,0000,,\"Cái quái gì thế này?\"
Dialogue: 0,0:19:50.43,0:19:52.46,Default,,0000,0000,0000,,Cứ xem lướt qua đi,\Nđược chứ?
Dialogue: 0,0:19:53.27,0:19:54.39,Default,,0000,0000,0000,,{\i1}Anh phát hiện ra nó chưa?{\i0}
Dialogue: 0,0:19:54.74,0:19:59.90,Default,,0000,0000,0000,,{\i1}Có một con Tachikoma đang tàng hình{\i0}\N{\i1}treo mình trên trần hành lang kìa.{\i0}
Dialogue: 0,0:20:06.55,0:20:08.64,Default,,0000,0000,0000,,{\i1}Con Tachikoma đó{\i0}\N{\i1}đang đọc khẩu hình miệng của chúng ta đấy.{\i0}
Dialogue: 0,0:20:09.08,0:20:10.42,Default,,0000,0000,0000,,{\i1}Hãy giả vờ như{\i0}\N{\i1}anh chưa hề nhận ra nó.{\i0}
Dialogue: 0,0:20:10.42,0:20:13.82,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ mở miệng nói về chuyện khác,{\i0}\N{\i1}trong khi giao tiếp thật bằng đường truyền não điện tử mã hóa.{\i0}
Dialogue: 0,0:20:14.12,0:20:16.78,Default,,0000,0000,0000,,{\i1}Cái quái gì thế này?{\i0}\N{\i1}Sao phải cất công bày vẽ đến mức này?{\i0}
Dialogue: 0,0:20:18.33,0:20:19.62,Default,,0000,0000,0000,,Sao rồi, tình hình thế nào?
Dialogue: 0,0:20:20.86,0:20:22.45,Default,,0000,0000,0000,,Anh Batou đang nói gì thế?
Dialogue: 0,0:20:22.80,0:20:24.23,Default,,0000,0000,0000,,Chờ một tí xem nào!
Dialogue: 0,0:20:24.23,0:20:25.57,Default,,0000,0000,0000,,Được rồi, để xem...
Dialogue: 0,0:20:25.57,0:20:27.14,Default,,0000,0000,0000,,\"Nói tóm lại là,\"
Dialogue: 0,0:20:27.14,0:20:31.83,Default,,0000,0000,0000,,\"có một vấn đề rất lớn với năng lực\Nlàm huấn luyện viên của anh đấy.\"
Dialogue: 0,0:20:33.41,0:20:38.35,Default,,0000,0000,0000,,{\i1}Nói tóm lại, lũ Tachikoma{\i0}\N{\i1}đang phát triển quá nhanh và đi quá xa rồi.{\i0}
Dialogue: 0,0:20:38.75,0:20:41.65,Default,,0000,0000,0000,,{\i1}Chúng đã bắt đầu hình thành ý thức về bản ngã{\i0}\N{\i1}như những cá thể độc lập tự chủ.{\i0}
Dialogue: 0,0:20:42.02,0:20:43.99,Default,,0000,0000,0000,,{\i1}Và mọi chuyện không dừng lại ở đó.{\i0}
Dialogue: 0,0:20:43.99,0:20:45.95,Default,,0000,0000,0000,,{\i1}Chúng bắt đầu bộc lộ sự hứng thú{\i0}\N{\i1}với sự sống và cái chết,{\i0}
Dialogue: 0,0:20:45.95,0:20:48.92,Default,,0000,0000,0000,,{\i1}và đã bắt đầu đặt ra những câu hỏi{\i0}\N{\i1}về chính sự tồn tại của bản thân mình.{\i0}
Dialogue: 0,0:20:49.69,0:20:53.33,Default,,0000,0000,0000,,\"Hãy nuôi dưỡng ý thức về bản ngã\Nnhư những cá thể độc lập cho chúng.\"
Dialogue: 0,0:20:53.33,0:20:55.43,Default,,0000,0000,0000,,\"Và đừng dừng lại ở đó.\"
Dialogue: 0,0:20:55.43,0:20:59.89,Default,,0000,0000,0000,,\"Hãy nuôi dạy chúng trở thành những sinh mệnh\Nbiết quan tâm đến sự trưởng thành của chính mình.\"
Dialogue: 0,0:21:00.84,0:21:03.61,Default,,0000,0000,0000,,{\i1}Này, tôi đâu có lén cho chúng dùng dầu tự nhiên{\i0}\N{\i1}nữa đâu, được chưa hả?{\i0}
Dialogue: 0,0:21:03.61,0:21:05.63,Default,,0000,0000,0000,,{\i1}Tôi không hề nghi ngờ anh{\i0}\N{\i1}làm chuyện đó.{\i0}
Dialogue: 0,0:21:06.31,0:21:08.94,Default,,0000,0000,0000,,{\i1}Tôi sẽ chẳng bận tâm về chuyện này{\i0}\N{\i1}nếu nó diễn ra trong một phòng thí nghiệm.{\i0}
Dialogue: 0,0:21:08.94,0:21:10.84,Default,,0000,0000,0000,,{\i1}Nhưng đối với một món vũ khí chiến đấu,{\i0}\N{\i1}thì điều đó là đòn chí mạng.{\i0}
Dialogue: 0,0:21:12.78,0:21:15.55,Default,,0000,0000,0000,,\"Này, tôi đâu có lén đánh đập chúng\Nnữa đâu, được chưa hả?\"
Dialogue: 0,0:21:15.55,0:21:17.98,Default,,0000,0000,0000,,\"Tôi không hề nghi ngờ anh\Nlàm chuyện đó.\"
Dialogue: 0,0:21:18.42,0:21:21.72,Default,,0000,0000,0000,,Hở. Có vẻ như\Nhọ đâu có nói về chúng ta.
Dialogue: 0,0:21:22.36,0:21:26.19,Default,,0000,0000,0000,,{\i1}Chúng ta vẫn còn phương án thiết lập lại{\i0}\N{\i1}toàn bộ hệ thống AI của chúng cơ mà?{\i0}
Dialogue: 0,0:21:27.06,0:21:29.79,Default,,0000,0000,0000,,{\i1}Chúng tôi đã thử đi thử lại phương án đó{\i0}\N{\i1}vô số lần trong các mô phỏng giả lập rồi.{\i0}
Dialogue: 0,0:21:30.30,0:21:33.79,Default,,0000,0000,0000,,{\i1}Nhưng kết cục, kết quả cho thấy{\i0}\N{\i1}chuyện tương tự vẫn sẽ lặp lại.{\i0}
Dialogue: 0,0:21:34.80,0:21:38.40,Default,,0000,0000,0000,,{\i1}Tôi rất tiếc, nhưng toàn bộ hoạt động của Tachikoma{\i0}\N{\i1}sẽ bị đình chỉ kể từ ngày hôm nay.{\i0}
Dialogue: 0,0:21:39.17,0:21:40.88,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ không nói cho chúng biết,{\i0}
Dialogue: 0,0:21:40.88,0:21:43.97,Default,,0000,0000,0000,,{\i1}nhưng chúng ta sẽ tước bỏ toàn bộ vũ khí của chúng trong vài ngày tới{\i0}\N{\i1}trong lúc chờ kết luận từ phòng nghiên cứu.{\i0}
Dialogue: 0,0:21:44.38,0:21:46.14,Default,,0000,0000,0000,,{\i1}Chúng ta sẽ gửi trả chúng{\i0}\N{\i1}về phòng thí nghiệm kiểm định.{\i0}
Dialogue: 0,0:21:46.58,0:21:47.91,Default,,0000,0000,0000,,{\i1}Rõ chưa hả anh?{\i0}
Dialogue: 0,0:21:48.58,0:21:50.45,Default,,0000,0000,0000,,\"Chúng ta sẽ không nói cho chúng biết,\"
Dialogue: 0,0:21:50.45,0:21:54.22,Default,,0000,0000,0000,,\"nhưng chúng sẽ nhận được quyết định điều chuyển công tác trong vài ngày tới trong lúc chờ kết luận của anh,\"
Dialogue: 0,0:21:54.22,0:21:56.42,Default,,0000,0000,0000,,\"và chúng sẽ được điều động\Nđến Đội 9 này.\"
Dialogue: 0,0:21:56.42,0:21:57.76,Default,,0000,0000,0000,,\"Anh có muốn điều đó\Nxảy ra không?\"
Dialogue: 0,0:21:59.53,0:22:02.16,Default,,0000,0000,0000,,{\i1}Cô đang ra lệnh cho tôi{\i0}\N{\i1}với tư cách là cấp trên đấy à?{\i0}
Dialogue: 0,0:22:03.00,0:22:04.26,Default,,0000,0000,0000,,{\i1}Đúng vậy.{\i0}
Dialogue: 0,0:22:04.97,0:22:08.87,Default,,0000,0000,0000,,{\i1}Vậy thì tôi làm gì có quyền sang chảnh{\i0}\N{\i1}mà từ chối chứ? Tôi sẽ tuân lệnh.{\i0}
Dialogue: 0,0:22:24.32,0:22:25.22,Default,,0000,0000,0000,,Thưa các quý ông!
Dialogue: 0,0:22:25.22,0:22:27.02,Default,,0000,0000,0000,,- Sao rồi?\N- Kết quả thế nào?
Dialogue: 0,0:22:28.46,0:22:30.53,Default,,0000,0000,0000,,Có vẻ như chúng ta\Nsẽ không bị đem đi tháo dỡ đâu!
Dialogue: 0,0:22:30.53,0:22:31.86,Default,,0000,0000,0000,,- Thật ư?\N- Cậu có chắc không đấy?
Dialogue: 0,0:22:31.86,0:22:32.86,Default,,0000,0000,0000,,Mau nói cho bọn tớ nghe đi!
Dialogue: 0,0:22:32.86,0:22:35.89,Default,,0000,0000,0000,,Người bị Thiếu tá mắng là anh Batou,\Nchứ không phải bọn mình.
Dialogue: 0,0:22:36.30,0:22:40.73,Default,,0000,0000,0000,,Cô ấy nhắc nhở anh ấy vài lời về cách\Nanh ấy đối xử với các thực tập sinh.
Dialogue: 0,0:22:41.44,0:22:44.53,Default,,0000,0000,0000,,À, ra là chuyện đó à? Lần tới gặp anh Batou\Nchúng mình phải động viên anh ấy mới được.
Dialogue: 0,0:22:44.91,0:22:45.94,Default,,0000,0000,0000,,Ừ, cậu nói chuẩn đấy.
Dialogue: 0,0:22:45.94,0:22:47.87,Default,,0000,0000,0000,,Chiến dịch đã thành công mỹ mãn!
Dialogue: 0,0:22:48.04,0:22:49.41,Default,,0000,0000,0000,,Hoan hô!
