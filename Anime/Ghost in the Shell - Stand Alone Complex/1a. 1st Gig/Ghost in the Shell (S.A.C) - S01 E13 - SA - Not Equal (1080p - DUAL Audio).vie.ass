Dialogue: 0,0:01:38.21,0:01:39.73,Default,,0000,0000,0000,,Các cậu xem\Nbức ảnh này đi.
Dialogue: 0,0:01:41.44,0:01:42.74,Default,,0000,0000,0000,,Cô bé ở chính giữa.
Dialogue: 0,0:01:44.01,0:01:46.85,Default,,0000,0000,0000,,Cô bé này... tôi thấy\Nở đâu đó rồi thì phải...
Dialogue: 0,0:01:47.92,0:01:50.35,Default,,0000,0000,0000,,Khoan đã, cô bé này trong vụ án\NCông ty Điện tử Tokura đúng không?
Dialogue: 0,0:01:50.79,0:01:51.72,Default,,0000,0000,0000,,Đúng là con bé.
Dialogue: 0,0:01:52.09,0:01:55.75,Default,,0000,0000,0000,,Đó là Eka Tokura, con gái độc nhất\Ncủa Chủ tịch Tokura Electronics,
Dialogue: 0,0:01:56.29,0:01:58.23,Default,,0000,0000,0000,,bị Lữ đoàn Tân Thế giới bắt cóc\Nmười sáu năm trước,
Dialogue: 0,0:01:58.69,0:02:01.99,Default,,0000,0000,0000,,chúng là những kẻ tôn thờ lý tưởng\Ncủa Mặt trận Giải phóng Con người.
Dialogue: 0,0:02:05.27,0:02:06.93,Default,,0000,0000,0000,,Con bé trông rắn rỏi đấy chứ.
Dialogue: 0,0:02:08.27,0:02:11.93,Default,,0000,0000,0000,,Thời đó chưa có nhiều người được\Ncơ thể hóa bằng công nghệ cyborg như bây giờ.
Dialogue: 0,0:02:13.34,0:02:19.37,Default,,0000,0000,0000,,Con bé được phẫu thuật cyborg để quảng bá\Ncho các sản phẩm tiên tiến của công ty cha mình.
Dialogue: 0,0:02:23.92,0:02:27.41,Default,,0000,0000,0000,,Nhưng kết quả là con bé lọt vào tầm ngắm\Ncủa đám người này và bị bắt cóc.
Dialogue: 0,0:02:28.39,0:02:31.19,Default,,0000,0000,0000,,Đúng vậy. Tôi vẫn nhớ rõ\Nnhư thể mới hôm qua.
Dialogue: 0,0:02:32.26,0:02:34.89,Default,,0000,0000,0000,,Vụ án đó có điều gì đó\Nkhiến tôi vô cùng bận tâm.
Dialogue: 0,0:02:35.16,0:02:39.03,Default,,0000,0000,0000,,Giờ tôi nhớ ra rồi.\NVụ án đó chưa từng được phá.
Dialogue: 0,0:02:40.07,0:02:44.31,Default,,0000,0000,0000,,Tôi nghe nói họ đã khoanh vùng được sào huyệt\Nvà đột kích vào sào huyệt của chúng,
Dialogue: 0,0:02:44.31,0:02:46.17,Default,,0000,0000,0000,,nhưng không bao giờ\Ntìm thấy cô bé.
Dialogue: 0,0:02:46.48,0:02:49.10,Default,,0000,0000,0000,,Vậy bức ảnh này được chụp\Nvào khoảng thời gian xảy ra vụ bắt cóc sao?
Dialogue: 0,0:02:49.61,0:02:55.48,Default,,0000,0000,0000,,Không, nó mới được chụp cách đây hai ngày\Nbởi các thành viên Đội An ninh Đặc nhiệm SST...
Dialogue: 0,0:02:55.48,0:03:02.12,Default,,0000,0000,0000,,...tại một nhà máy lọc phóng xạ bỏ hoang\Ncách Okinawa 200 hải lý.
Dialogue: 0,0:03:03.16,0:03:04.22,Default,,0000,0000,0000,,Hai ngày trước sao?
Dialogue: 0,0:03:04.76,0:03:07.59,Default,,0000,0000,0000,,Điều đó có nghĩa là\Nđây không phải cô bé đó.
Dialogue: 0,0:03:08.46,0:03:10.49,Default,,0000,0000,0000,,Mọi chuyện không đơn giản\Nnhư cậu nghĩ đâu.
Dialogue: 0,0:03:11.23,0:03:16.00,Default,,0000,0000,0000,,Ban đầu, Cục An toàn Hàng hải cử một đội tiền trạm\Nđến hiện trường để điều tra ngầm...
Dialogue: 0,0:03:16.54,0:03:21.07,Default,,0000,0000,0000,,...sau khi nhận được báo cáo rằng Lữ đoàn đã đổ bộ lên đó.
Dialogue: 0,0:03:21.61,0:03:24.01,Default,,0000,0000,0000,,Trong lúc ở đó, bằng cách nào đó\Nhọ đã tình cờ bắt gặp cô bé.
Dialogue: 0,0:03:25.75,0:03:28.88,Default,,0000,0000,0000,,Đây là dữ liệu ADN họ gửi kèm\Ncùng với bức ảnh.
Dialogue: 0,0:03:29.89,0:03:32.95,Default,,0000,0000,0000,,Chưa rõ đội SST đã thu thập\Nthứ này bằng cách nào,
Dialogue: 0,0:03:33.59,0:03:35.72,Default,,0000,0000,0000,,nhưng dựa trên việc đối chiếu\Nvới bệnh án trong quá khứ,
Dialogue: 0,0:03:35.72,0:03:38.28,Default,,0000,0000,0000,,chúng ta xác định không chút nghi ngờ\Nrằng mẫu ADN này chính là của cô bé.
Dialogue: 0,0:03:39.50,0:03:45.53,Default,,0000,0000,0000,,Tuy nhiên, sau khi gửi báo cáo này về,\Nthì cả bốn thành viên của đội tiền trạm đều mất liên lạc.
Dialogue: 0,0:03:46.67,0:03:48.16,Default,,0000,0000,0000,,Và đó là lý do\Nchúng ta phải vào cuộc.
Dialogue: 0,0:03:51.21,0:03:54.30,Default,,0000,0000,0000,,Hãy đến đó và tìm hiểu xem\Nchuyện quái gì đang xảy ra ngoài kia!
Dialogue: 0,0:04:35.92,0:04:37.58,Default,,0000,0000,0000,,{\i1}Batou, có thấy gì không?{\i0}
Dialogue: 0,0:04:38.19,0:04:39.65,Default,,0000,0000,0000,,{\i1}Chẳng có ai ở đây cả.{\i0}
Dialogue: 0,0:04:40.06,0:04:42.35,Default,,0000,0000,0000,,{\i1}Có vẻ như đã từ lâu lắm rồi{\i0}\N{\i1}không có ai đặt chân tới đây.{\i0}
Dialogue: 0,0:04:43.73,0:04:48.22,Default,,0000,0000,0000,,{\i1}Nghĩa là ngay cả đám người Lữ đoàn{\i0}\N{\i1}cũng chưa từng xuống tầng đáy này.{\i0}
Dialogue: 0,0:04:49.73,0:04:52.33,Default,,0000,0000,0000,,{\i1}Tôi đây.{\i0}\N{\i1}Các cậu vào được chưa?{\i0}
Dialogue: 0,0:04:52.67,0:04:55.19,Default,,0000,0000,0000,,{\i1}Rồi. Boong tàu đã được bảo đảm an toàn.{\i0}
Dialogue: 0,0:04:56.04,0:04:58.44,Default,,0000,0000,0000,,{\i1}Xét việc nơi này đã bị bỏ hoang{\i0}\N{\i1}hơn mười năm qua,{\i0}
Dialogue: 0,0:04:59.01,0:05:01.10,Default,,0000,0000,0000,,{\i1}thì tình trạng của nó{\i0}\N{\i1}tốt hơn tôi nghĩ nhiều.{\i0}
Dialogue: 0,0:05:01.88,0:05:05.64,Default,,0000,0000,0000,,{\i1}Nơi này thừa chỗ để cập cả một con tàu.{\i0}\N{\i1}Các cậu sẽ không gặp khó khăn gì đâu.{\i0}
Dialogue: 0,0:05:06.35,0:05:07.44,Default,,0000,0000,0000,,{\i1}Rõ rồi.{\i0}
Dialogue: 0,0:05:16.03,0:05:19.09,Default,,0000,0000,0000,,{\i1}Ishikawa, tầng trên cùng của nhà máy{\i0}\N{\i1}có động tĩnh gì không?{\i0}
Dialogue: 0,0:05:20.60,0:05:22.22,Default,,0000,0000,0000,,{\i1}Rất êm ả và thanh bình.{\i0}
Dialogue: 0,0:05:22.90,0:05:25.03,Default,,0000,0000,0000,,Rất thích hợp cho một buổi\Ncâu cá đêm đấy.
Dialogue: 0,0:05:33.61,0:05:38.27,Default,,0000,0000,0000,,{\i1}Chúng tôi đã xác minh được một tín hiệu GPS{\i0}\N{\i1}phát ra từ thành viên đội SST.{\i0}
Dialogue: 0,0:05:39.01,0:05:44.25,Default,,0000,0000,0000,,{\i1}Có thể anh ta đã thấy chúng ta hành động{\i0}\N{\i1}và sẽ tự mình lên tầng trên cùng của nhà máy.{\i0}
Dialogue: 0,0:05:45.19,0:05:47.88,Default,,0000,0000,0000,,Hãy ở chế độ chờ ở khoảng cách vừa đủ\Nđể có thể tiếp cận sân thượng trong vòng hai phút.
Dialogue: 0,0:05:48.26,0:05:49.22,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:05:50.06,0:05:51.39,Default,,0000,0000,0000,,Cậu nghe sếp dặn rồi đấy.
Dialogue: 0,0:05:51.39,0:05:52.62,Default,,0000,0000,0000,,- Rõ rồi ạ.\N- Rõ.
Dialogue: 0,0:05:53.80,0:05:56.66,Default,,0000,0000,0000,,Chắc chúng ta sẽ bay lượn vãn cảnh thong thả\Ntrong lúc chờ đợi vậy.
Dialogue: 0,0:06:07.84,0:06:10.24,Default,,0000,0000,0000,,Thiếu tá, ngõ cụt rồi.
Dialogue: 0,0:06:10.71,0:06:12.27,Default,,0000,0000,0000,,Tôi tự nhìn\Ncũng thấy mà.
Dialogue: 0,0:06:14.75,0:06:18.74,Default,,0000,0000,0000,,Dạ... Thiếu tá cứ ra lệnh đi,\Nem sẽ tông sập nó ngay.
Dialogue: 0,0:06:19.05,0:06:23.35,Default,,0000,0000,0000,,Bỏ đi. Hãy biết điều ngoan ngoãn\Ncho tới khi chúng ta tiếp cận được mục tiêu.
Dialogue: 0,0:06:24.06,0:06:25.29,Default,,0000,0000,0000,,Vâng, thưa Thiếu tá...
Dialogue: 0,0:06:25.73,0:06:28.29,Default,,0000,0000,0000,,Dù hơi phiền phức,\Nnhưng chúng ta hãy tìm đường khác thôi.
Dialogue: 0,0:06:29.13,0:06:34.40,Default,,0000,0000,0000,,Với lại, nếu chúng đã dựng rào chắn,\Nthì ắt hẳn phía sau phải có thứ gì đó.
Dialogue: 0,0:06:40.01,0:06:42.84,Default,,0000,0000,0000,,Chúng ta sẽ chui lên\N{\i1}chỗ đó{\i0} sao?
Dialogue: 0,0:06:46.25,0:06:48.65,Default,,0000,0000,0000,,Mong là em không bị kẹt nữa.
Dialogue: 0,0:06:49.22,0:06:52.28,Default,,0000,0000,0000,,Thiếu tá, tôi cứ suy nghĩ mãi...
Dialogue: 0,0:06:53.32,0:06:57.52,Default,,0000,0000,0000,,Cô không nghĩ là chúng ta đang tự chui đầu\Nvào cái bẫy của đám Lữ đoàn đấy chứ?
Dialogue: 0,0:06:58.26,0:07:00.89,Default,,0000,0000,0000,,Ý tôi là, chúng ta định vị được vị trí của người sống sót,\Nnhưng anh ta lại chẳng hề hồi đáp.
Dialogue: 0,0:07:01.73,0:07:03.79,Default,,0000,0000,0000,,Cả chuyện này mờ ám lắm.
Dialogue: 0,0:07:04.70,0:07:06.43,Default,,0000,0000,0000,,Cậu nghĩ tất cả bọn họ\Nđều đã bị tiêu diệt rồi sao?
Dialogue: 0,0:07:07.27,0:07:09.26,Default,,0000,0000,0000,,Tôi không thể khẳng định\Nchắc chắn điều gì.
Dialogue: 0,0:07:09.61,0:07:13.30,Default,,0000,0000,0000,,Nhưng chắc cô cũng nghĩ rằng con bé đó\Nkhông phải là hàng thật, đúng không Thiếu tá?
Dialogue: 0,0:07:14.01,0:07:15.87,Default,,0000,0000,0000,,Vậy theo cậu\Nnó là thứ gì?
Dialogue: 0,0:07:16.18,0:07:20.01,Default,,0000,0000,0000,,Thì, thứ đầu tiên xuất hiện trong đầu tôi\Nchính là một cơ thể nhân tạo cyborg.
Dialogue: 0,0:07:20.95,0:07:25.25,Default,,0000,0000,0000,,Cậu quên rằng chúng là một giáo phái\Ntheo phe Mặt trận Giải phóng Con người à?
Dialogue: 0,0:07:26.19,0:07:29.18,Default,,0000,0000,0000,,Chúng là tổ chức bài xích cả cơ thể nhân tạo\Nlẫn việc cấy ghép não điện tử đấy.
Dialogue: 0,0:07:29.66,0:07:31.39,Default,,0000,0000,0000,,Tôi không nghĩ là chuyện đó đâu.
Dialogue: 0,0:07:32.06,0:07:36.90,Default,,0000,0000,0000,,Thế còn kết quả xét nghiệm ADN\Ntrong báo cáo cuối cùng của SST thì sao?
Dialogue: 0,0:07:37.70,0:07:39.13,Default,,0000,0000,0000,,Cậu giải thích thế nào về chuyện đó?
Dialogue: 0,0:07:40.74,0:07:45.67,Default,,0000,0000,0000,,Không loại trừ khả năng Lữ đoàn\Nđã bảo quản máu hoặc tế bào của cô bé sao?
Dialogue: 0,0:07:46.64,0:07:48.61,Default,,0000,0000,0000,,Có thể chúng đã dùng thứ đó\Nđể tạo ra một bản sao nhân bản vô tính.
Dialogue: 0,0:07:49.21,0:07:50.71,Default,,0000,0000,0000,,Để làm gì?
Dialogue: 0,0:07:50.71,0:07:51.54,Default,,0000,0000,0000,,Thì...
Dialogue: 0,0:07:52.45,0:07:56.21,Default,,0000,0000,0000,,Chẳng hạn như chúng nhắm vào\Nkhối tài sản kếch xù của nhà Tokura?
Dialogue: 0,0:07:57.19,0:08:00.59,Default,,0000,0000,0000,,Hiện tại chưa có chứng cứ bác bỏ giả thuyết nhân bản của cậu,
Dialogue: 0,0:08:00.86,0:08:03.83,Default,,0000,0000,0000,,nhưng việc cô bé đột ngột xuất hiện với diện mạo y hệt 16 năm trước...
Dialogue: 0,0:08:03.83,0:08:06.29,Default,,0000,0000,0000,,...chỉ có mỗi một tác dụng là làm lung lạc tinh thần của cha cô bé mà thôi.
Dialogue: 0,0:08:07.10,0:08:10.33,Default,,0000,0000,0000,,Vả lại theo luật pháp, một người nhân bản\Nhoàn toàn không có quyền thừa kế tài sản.
Dialogue: 0,0:08:11.33,0:08:13.82,Default,,0000,0000,0000,,Dù sao thì chắc chắn chúng phải có mưu đồ gì đó,
Dialogue: 0,0:08:14.47,0:08:17.03,Default,,0000,0000,0000,,nhưng vì còn quá nhiều uẩn khúc chưa có lời giải,
Dialogue: 0,0:08:17.47,0:08:20.47,Default,,0000,0000,0000,,cậu không muốn tận mắt mình chứng kiến\Nđể tìm ra sự thật sao?
Dialogue: 0,0:08:21.88,0:08:25.18,Default,,0000,0000,0000,,Có lẽ chúng ta sẽ có câu trả lời sau khi\Ncứu được cô bé và tra hỏi.
Dialogue: 0,0:08:25.55,0:08:28.88,Default,,0000,0000,0000,,Ghost của Togusa vẫn chưa chịu\Nthì thầm với cậu ta nhiều nhỉ...
Dialogue: 0,0:08:46.10,0:08:47.16,Default,,0000,0000,0000,,Cảm ơn vì đã đợi!
Dialogue: 0,0:08:47.74,0:08:51.57,Default,,0000,0000,0000,,Vấn đề thực sự của đồ ăn dành cho cyborg\Nlà trông nó chẳng ngon lành gì cả.
Dialogue: 0,0:08:52.21,0:08:52.83,Default,,0000,0000,0000,,Hử?
Dialogue: 0,0:08:53.74,0:08:54.94,Default,,0000,0000,0000,,Ngon hơn cậu nghĩ nhiều đấy.
Dialogue: 0,0:08:55.38,0:08:56.54,Default,,0000,0000,0000,,Muốn nếm thử không?
Dialogue: 0,0:08:57.85,0:09:00.78,Default,,0000,0000,0000,,Đằng nào thì chúng ta cũng chưa đi đâu được\Ncho đến khi có tín hiệu GPS tiếp theo.
Dialogue: 0,0:09:01.85,0:09:03.28,Default,,0000,0000,0000,,Tôi sẽ nghỉ ngơi một chút.
Dialogue: 0,0:09:06.26,0:09:09.35,Default,,0000,0000,0000,,Nghĩ lại thì, xung quanh bốn bề\Nđều là biển cả.
Dialogue: 0,0:09:09.76,0:09:12.75,Default,,0000,0000,0000,,Nếu muốn thì họ hoàn toàn\Ncó thể tự cung tự cấp được.
Dialogue: 0,0:09:13.40,0:09:17.83,Default,,0000,0000,0000,,Và nơi này chẳng khác nào một thương cảng chiến lược\Ncho đám buôn lậu phế liệu ở các vùng biển lân cận.
Dialogue: 0,0:09:18.77,0:09:21.93,Default,,0000,0000,0000,,Tình hình ở đây phức tạp hơn nhiều\Nso với những gì dữ liệu thể hiện!
Dialogue: 0,0:09:22.17,0:09:25.33,Default,,0000,0000,0000,,Kể cả có khủng bố trà trộn vào đám đông,\Nthì cũng chẳng tài nào nhận ra nổi!
Dialogue: 0,0:09:26.07,0:09:28.77,Default,,0000,0000,0000,,Hèn chi các nước láng giềng\Nlại cuống cuồng lo sợ đến thế.
Dialogue: 0,0:09:30.51,0:09:32.95,Default,,0000,0000,0000,,Này, đợi em với!
Dialogue: 0,0:09:35.88,0:09:39.05,Default,,0000,0000,0000,,Này anh bạn, chú mày có con robot\Nngon lành cành đào đấy!
Dialogue: 0,0:09:39.69,0:09:40.71,Default,,0000,0000,0000,,Thấy thế nào?
Dialogue: 0,0:09:41.46,0:09:45.42,Default,,0000,0000,0000,,Đổi một cánh tay của con robot đó\Nlấy bộ động cơ tư duy này nhé.
Dialogue: 0,0:09:47.36,0:09:50.49,Default,,0000,0000,0000,,Oa, thật ư?!\NCho em xem, cho em xem với!
Dialogue: 0,0:09:52.47,0:09:54.37,Default,,0000,0000,0000,,Dẹp đi.\NNhanh lên, chúng ta đi thôi.
Dialogue: 0,0:09:55.20,0:09:56.47,Default,,0000,0000,0000,,Được rồi, thế thì!
Dialogue: 0,0:09:56.74,0:09:59.73,Default,,0000,0000,0000,,Tao khuyến mãi thêm thiết bị tính toán logic\Nhàng Đài Loan này thì sao hả?
Dialogue: 0,0:10:00.51,0:10:03.81,Default,,0000,0000,0000,,Bảo bối này {\i1}cực kỳ{\i0}\Nquý giá trong giới sành sỏi đấy nhé.
Dialogue: 0,0:10:04.75,0:10:07.28,Default,,0000,0000,0000,,Anh Batou! Em vừa xác nhận được\Nmột tín hiệu GPS...
Dialogue: 0,0:10:07.28,0:10:09.65,Default,,0000,0000,0000,,...được phát ra bởi Sakakibara,\Nthành viên đội SST.
Dialogue: 0,0:10:10.05,0:10:11.08,Default,,0000,0000,0000,,Thật sao?!
Dialogue: 0,0:10:11.79,0:10:13.88,Default,,0000,0000,0000,,Lần này nó đang\Ndi chuyển lên phía trên.
Dialogue: 0,0:10:14.22,0:10:16.66,Default,,0000,0000,0000,,Ước gì gã này\Nchịu ngồi yên một chỗ.
Dialogue: 0,0:10:17.19,0:10:19.59,Default,,0000,0000,0000,,Là bạn hay là thù,\Nta cóc cần quan tâm!
Dialogue: 0,0:10:22.23,0:10:23.13,Default,,0000,0000,0000,,Đi thôi!
Dialogue: 0,0:10:41.02,0:10:43.01,Default,,0000,0000,0000,,Anh là Sakakibara bên đội SST\Nphải không?
Dialogue: 0,0:10:43.32,0:10:45.48,Default,,0000,0000,0000,,Bình tĩnh đi. Chúng tôi đến đây\Nđể giải cứu anh.
Dialogue: 0,0:10:48.82,0:10:49.72,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:10:50.33,0:10:52.79,Default,,0000,0000,0000,,X-Xóa chúng đi...
Dialogue: 0,0:10:54.56,0:10:57.00,Default,,0000,0000,0000,,Có chuyện gì thế?\NAnh an toàn rồi mà!
Dialogue: 0,0:10:58.43,0:11:01.27,Default,,0000,0000,0000,,Tôi cầu xin các người...\NHãy xóa chúng đi!
Dialogue: 0,0:11:04.24,0:11:05.50,Default,,0000,0000,0000,,Làm ơn...
Dialogue: 0,0:11:07.04,0:11:08.51,Default,,0000,0000,0000,,Cút ra khỏi đầu tao mau!
Dialogue: 0,0:11:09.44,0:11:10.67,Default,,0000,0000,0000,,Bình tĩnh lại xem nào!
Dialogue: 0,0:11:12.91,0:11:14.94,Default,,0000,0000,0000,,Ở đây đã xảy ra chuyện gì?!\NNày!
Dialogue: 0,0:11:28.76,0:11:32.76,Default,,0000,0000,0000,,Này, anh có nghe thấy tôi nói không?\NBa người kia bị làm sao rồi?
Dialogue: 0,0:11:33.67,0:11:35.93,Default,,0000,0000,0000,,H-Họ bị giết cả rồi...
Dialogue: 0,0:11:36.64,0:11:41.34,Default,,0000,0000,0000,,Con bé đó chính là thủ lĩnh của chúng...
Dialogue: 0,0:11:41.98,0:11:42.97,Default,,0000,0000,0000,,Cái gì?!
Dialogue: 0,0:11:44.05,0:11:47.11,Default,,0000,0000,0000,,Làm ơn, hãy xóa chúng đi...
Dialogue: 0,0:11:47.52,0:11:50.01,Default,,0000,0000,0000,,Này, anh nói \"thủ lĩnh\"\Nnghĩa là sao hả?!
Dialogue: 0,0:11:52.05,0:11:55.85,Default,,0000,0000,0000,,Con bé vẫn sống sót,\Nnhưng tại sao lại...?
Dialogue: 0,0:11:56.89,0:11:58.99,Default,,0000,0000,0000,,K-Kinh khủng quá...
Dialogue: 0,0:12:06.40,0:12:09.80,Default,,0000,0000,0000,,Anh đã kết nối đồng bộ với con bé sao?
Dialogue: 0,0:12:11.07,0:12:11.97,Default,,0000,0000,0000,,Batou.
Dialogue: 0,0:12:18.88,0:12:20.04,Default,,0000,0000,0000,,Thứ này là gì thế?
Dialogue: 0,0:12:21.95,0:12:23.08,Default,,0000,0000,0000,,Giờ thì tôi hiểu rồi.
Dialogue: 0,0:12:24.05,0:12:28.58,Default,,0000,0000,0000,,Có vẻ như anh ta {\i1}đã{\i0} thực sự\Ntiếp cận rất gần cô bé đó.
Dialogue: 0,0:12:56.42,0:12:59.68,Default,,0000,0000,0000,,Cuối cùng cũng bắt đầu cảm thấy\Ncăng thẳng rồi hả Togusa?
Dialogue: 0,0:13:00.39,0:13:02.22,Default,,0000,0000,0000,,Giờ này mà anh còn\Ntâm trạng để đùa cợt được sao?!
Dialogue: 0,0:13:02.22,0:13:04.39,Default,,0000,0000,0000,,{\i1}Togusa, bên cậu{\i0}\N{\i1}tình hình thế nào rồi?{\i0}
Dialogue: 0,0:13:05.19,0:13:06.75,Default,,0000,0000,0000,,{\i1}Bên này cũng chẳng có ai cả.{\i0}
Dialogue: 0,0:13:07.66,0:13:11.46,Default,,0000,0000,0000,,Căn phòng trong ảnh\Nchắc hẳn phải ở tầng trên chúng ta.
Dialogue: 0,0:13:12.90,0:13:14.87,Default,,0000,0000,0000,,Nhà máy này không thể có\Nhái phòng điều khiển được.
Dialogue: 0,0:13:15.77,0:13:16.70,Default,,0000,0000,0000,,Suỵt!
Dialogue: 0,0:13:27.98,0:13:28.85,Default,,0000,0000,0000,,Cảnh sát đây!
Dialogue: 0,0:13:29.18,0:13:30.85,Default,,0000,0000,0000,,Eka Tokura ở đâu?
Dialogue: 0,0:13:37.06,0:13:38.86,Default,,0000,0000,0000,,Thằng khốn này tưởng\Nchúng ta đang đùa chắc!
Dialogue: 0,0:13:39.39,0:13:41.99,Default,,0000,0000,0000,,Thiếu tá, để tôi thử một phát xem.
Dialogue: 0,0:13:44.50,0:13:45.66,Default,,0000,0000,0000,,Nghe này...
Dialogue: 0,0:13:46.80,0:13:50.97,Default,,0000,0000,0000,,Tôi đoán là mày biết rõ ngón\N\"tra tấn nha khoa\" rồi đúng không?
Dialogue: 0,0:13:51.97,0:13:55.00,Default,,0000,0000,0000,,Nhưng tao dám cá là mày chưa từng\Nđược làm nạn nhân bao giờ đâu nhỉ.
Dialogue: 0,0:14:04.79,0:14:07.08,Default,,0000,0000,0000,,Tachikoma, đứng canh ở đây\Nvực chừng không cho ai vào!
Dialogue: 0,0:14:07.92,0:14:08.65,Default,,0000,0000,0000,,Rõ ạ!
Dialogue: 0,0:14:12.83,0:14:14.30,Default,,0000,0000,0000,,Đủ rồi đấy!
Dialogue: 0,0:14:14.63,0:14:16.19,Default,,0000,0000,0000,,Mày có nhận thức được\Nđây là cái gì không hả?!
Dialogue: 0,0:14:17.23,0:14:19.93,Default,,0000,0000,0000,,Cứ lặp đi lặp lại trò này\Nhết lần này đến lần khác!
Dialogue: 0,0:14:20.54,0:14:22.37,Default,,0000,0000,0000,,Đến bao giờ bọn mày mới\Nchịu chán hả?
Dialogue: 0,0:14:23.24,0:14:25.10,Default,,0000,0000,0000,,Tao không chịu nổi nữa rồi!
Dialogue: 0,0:14:25.71,0:14:27.33,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi đây.{\i0}
Dialogue: 0,0:14:29.08,0:14:31.14,Default,,0000,0000,0000,,{\i1}Chúng tôi đã giải cứu được{\i0}\N{\i1}thành viên sống sót của SST.{\i0}
Dialogue: 0,0:14:31.75,0:14:34.62,Default,,0000,0000,0000,,{\i1}Anh ta sẽ sống, nhưng hành vi{\i0}\N{\i1}rất kỳ lạ,{\i0}
Dialogue: 0,0:14:34.62,0:14:37.52,Default,,0000,0000,0000,,{\i1}cứ như thể não điện tử của anh ta{\i0}\N{\i1}bị nhiễm virus hay gì đó vậy.{\i0}
Dialogue: 0,0:14:38.49,0:14:41.01,Default,,0000,0000,0000,,{\i1}Đó là lý do anh ta không thể hồi đáp{\i0}\N{\i1}dù vẫn nhận được tín hiệu của chúng ta.{\i0}
Dialogue: 0,0:14:41.96,0:14:45.45,Default,,0000,0000,0000,,{\i1}Rõ rồi. Cứ tiến thẳng ra sân đỗ trực thăng{\i0}\N{\i1}và túc trực chờ lệnh ở đó.{\i0}
Dialogue: 0,0:14:46.29,0:14:47.89,Default,,0000,0000,0000,,{\i1}Chúng tôi chuẩn bị{\i0}\N{\i1}hành động đây.{\i0}
Dialogue: 0,0:14:48.23,0:14:49.16,Default,,0000,0000,0000,,{\i1}Chờ một chút đã!{\i0}
Dialogue: 0,0:14:50.00,0:14:51.40,Default,,0000,0000,0000,,{\i1}Có một điều khiến tôi{\i0}\N{\i1}vô cùng bận tâm.{\i0}
Dialogue: 0,0:14:51.73,0:14:52.60,Default,,0000,0000,0000,,{\i1}Chuyện gì?{\i0}
Dialogue: 0,0:14:53.07,0:14:58.27,Default,,0000,0000,0000,,{\i1}Nguyên nhân khiến gã Sakakibara này phát điên{\i0}\N{\i1}dường như có liên quan đến cô bé đó.{\i0}
Dialogue: 0,0:15:02.88,0:15:08.32,Default,,0000,0000,0000,,{\i1}Tôi chưa dám chắc, nhưng có vẻ như{\i0}\N{\i1}cô bé hiện đang là thủ lĩnh của Lữ đoàn.{\i0}
Dialogue: 0,0:15:09.45,0:15:12.68,Default,,0000,0000,0000,,{\i1}Tôi không nghĩ cô sẽ thua con bé{\i0}\N{\i1}trong một trận chiến não điện tử đâu, Thiếu tá,{\i0}
Dialogue: 0,0:15:12.99,0:15:16.01,Default,,0000,0000,0000,,{\i1}nhưng hãy hết sức cẩn trọng{\i0}\N{\i1}khi kết nối với cô bé đó đấy.{\i0}
Dialogue: 0,0:15:16.76,0:15:20.75,Default,,0000,0000,0000,,Từ giờ trở đi, em không được phép rời khỏi\Nbên cạnh tôi khi chưa có lệnh.
Dialogue: 0,0:15:24.67,0:15:26.22,Default,,0000,0000,0000,,Sao em lại không chịu hiểu chứ?
Dialogue: 0,0:15:27.27,0:15:30.07,Default,,0000,0000,0000,,Em muốn bỏ mặc tôi\Ncô độc một mình đến thế sao?
Dialogue: 0,0:15:32.21,0:15:32.91,Default,,0000,0000,0000,,Lúc nào em cũng...
Dialogue: 0,0:15:32.91,0:15:35.14,Default,,0000,0000,0000,,Ra là đang đóng vai công chúa.
Dialogue: 0,0:15:39.95,0:15:43.15,Default,,0000,0000,0000,,Đối với một kẻ làm cách mạng,\Nthì bài phát biểu đó nghe tầm thường quá đấy.
Dialogue: 0,0:15:44.85,0:15:45.91,Default,,0000,0000,0000,,Ai đó?
Dialogue: 0,0:15:47.49,0:15:48.72,Default,,0000,0000,0000,,Cảnh sát.
Dialogue: 0,0:16:02.57,0:16:03.63,Default,,0000,0000,0000,,Giơ tay lên đầu.
Dialogue: 0,0:16:08.58,0:16:11.41,Default,,0000,0000,0000,,Nhanh lên.\NTôi không nhắc lại lần thứ hai đâu.
Dialogue: 0,0:16:13.15,0:16:17.31,Default,,0000,0000,0000,,Bọn mày thực sự nghĩ rằng mình sẽ sống sót\Nbước ra khỏi đây sau khi làm việc này sao?
Dialogue: 0,0:16:29.13,0:16:31.33,Default,,0000,0000,0000,,Thiếu tá, có chuyện gì thế?
Dialogue: 0,0:16:32.23,0:16:33.89,Default,,0000,0000,0000,,Cậu bắt...
Dialogue: 0,0:16:37.24,0:16:38.50,Default,,0000,0000,0000,,...nhầm người rồi.
Dialogue: 0,0:16:47.72,0:16:51.12,Default,,0000,0000,0000,,{\i1}Thiếu tá, một toán lính vũ trang{\i0}\N{\i1}đang áp sát vị trí của em!{\i0}
Dialogue: 0,0:16:51.42,0:16:52.48,Default,,0000,0000,0000,,Thiếu tá?!
Dialogue: 0,0:16:53.09,0:16:54.42,Default,,0000,0000,0000,,{\i1}Tachikoma! Báo cáo tình hình!{\i0}
Dialogue: 0,0:16:55.42,0:16:56.91,Default,,0000,0000,0000,,Bọn chúng biết chúng ta ở đây rồi!
Dialogue: 0,0:16:57.49,0:17:01.16,Default,,0000,0000,0000,,Hình như anh Batou và anh Saito\Nở phía sau em cũng đang bị tấn công!
Dialogue: 0,0:17:01.70,0:17:05.10,Default,,0000,0000,0000,,{\i1}Tachikoma, lên đây ngay lập tức.{\i0}\N{\i1}Mục tiêu đã bị khống chế.{\i0}
Dialogue: 0,0:17:05.50,0:17:06.36,Default,,0000,0000,0000,,Chúng ta rút lui!
Dialogue: 0,0:17:07.10,0:17:08.19,Default,,0000,0000,0000,,Rõ ạ!
Dialogue: 0,0:17:10.31,0:17:12.21,Default,,0000,0000,0000,,Chà chà.\NBắt đầu rồi đấy.
Dialogue: 0,0:17:12.64,0:17:14.27,Default,,0000,0000,0000,,Được rồi, đưa chúng ta xuống!
Dialogue: 0,0:17:28.16,0:17:29.62,Default,,0000,0000,0000,,Chết tiệt, tên này\Ncản đường mình rồi!
Dialogue: 0,0:17:30.49,0:17:32.36,Default,,0000,0000,0000,,Tachikoma, nổ súng đi!
Dialogue: 0,0:17:33.19,0:17:34.18,Default,,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 0,0:17:35.33,0:17:36.02,Default,,0000,0000,0000,,Cái quái gì thế này?!
Dialogue: 0,0:17:41.20,0:17:43.00,Default,,0000,0000,0000,,Chẳng khác nào bắn cá\Ntrong chậu cả.
Dialogue: 0,0:17:46.84,0:17:48.74,Default,,0000,0000,0000,,Lũ khốn này dùng cả xác đồng đội\Nđể làm lá chắn đạn kìa!
Dialogue: 0,0:17:49.44,0:17:51.94,Default,,0000,0000,0000,,Bọn chúng đông quá không dứt nổi!\NTachikoma, nhắm vào các sợi dây cáp!
Dialogue: 0,0:17:52.51,0:17:53.48,Default,,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 0,0:17:57.95,0:17:59.44,Default,,0000,0000,0000,,Đạn vận tốc cao sao?
Dialogue: 0,0:18:00.09,0:18:01.99,Default,,0000,0000,0000,,Chúng mang cả đồ chơi\Nnguy hiểm đến bữa tiệc cơ đấy.
Dialogue: 0,0:18:03.89,0:18:05.02,Default,,0000,0000,0000,,Các người không thắng được tôi đâu!
Dialogue: 0,0:18:07.73,0:18:09.09,Default,,0000,0000,0000,,Chết tiệt, lũ này\Nphiền phức thật đấy...
Dialogue: 0,0:18:09.66,0:18:12.39,Default,,0000,0000,0000,,Người chúng chẳng có bộ phận cyborg nào,\Nvậy mà chẳng hề sợ chết chút nào!
Dialogue: 0,0:18:36.42,0:18:37.22,Default,,0000,0000,0000,,Batou đâu rồi?
Dialogue: 0,0:18:39.53,0:18:41.59,Default,,0000,0000,0000,,Chắc lại đi giải cứu\Nbà chằn rồi chứ gì?
Dialogue: 0,0:18:42.30,0:18:43.49,Default,,0000,0000,0000,,Làm như cô ấy cần cứu không bằng...
Dialogue: 0,0:18:52.71,0:18:54.47,Default,,0000,0000,0000,,Khoan đã!\NĐừng bắn!
Dialogue: 0,0:18:55.28,0:18:56.14,Default,,0000,0000,0000,,Tôi đây.
Dialogue: 0,0:18:59.48,0:19:00.71,Default,,0000,0000,0000,,Cậu làm gì\Nở đây thế?
Dialogue: 0,0:19:01.08,0:19:03.31,Default,,0000,0000,0000,,Anh nói thế là sao?\NTôi đến để cứu anh mà.
Dialogue: 0,0:19:05.79,0:19:09.38,Default,,0000,0000,0000,,Hả? Khoan đã,\Ncô bé đâu rồi?
Dialogue: 0,0:19:09.96,0:19:11.86,Default,,0000,0000,0000,,Nó cứ la hét om sòm, nên tôi\Nnhét luôn nó vào bụng Tachikoma rồi.
Dialogue: 0,0:19:15.50,0:19:17.26,Default,,0000,0000,0000,,Thế còn bà già\Nkhú đế kia là sao?
Dialogue: 0,0:19:17.67,0:19:19.03,Default,,0000,0000,0000,,Thiếu tá bảo bà ấy\Nsẽ đi cùng chúng ta.
Dialogue: 0,0:19:19.97,0:19:20.94,Default,,0000,0000,0000,,Cái...?
Dialogue: 0,0:19:22.87,0:19:25.17,Default,,0000,0000,0000,,Tôi chẳng hiểu đầu đuôi ra sao cả,\Nnhưng để sau hãy giải thích.
Dialogue: 0,0:19:25.77,0:19:28.77,Default,,0000,0000,0000,,Cậu cứ đi trước đi, Togusa.\NTôi sẽ câu giờ cho cậu.
Dialogue: 0,0:19:35.12,0:19:36.11,Default,,0000,0000,0000,,Thấy thế nào hả {\i1}lũ kia?!{\i0}
Dialogue: 0,0:19:36.32,0:19:40.01,Default,,0000,0000,0000,,Đồ ngốc này! Mày quên là đang có\Nngười ngồi bên trong khoang lái của mày à?!
Dialogue: 0,0:19:40.36,0:19:43.15,Default,,0000,0000,0000,,Ư ư, nhưng em muốn\Nchiến đấu thêm nữa cơ!
Dialogue: 0,0:19:43.63,0:19:44.32,Default,,0000,0000,0000,,Ối mẹ ơi!
Dialogue: 0,0:19:46.83,0:19:47.76,Default,,0000,0000,0000,,Tên lửa chống tăng sao?!
Dialogue: 0,0:19:49.23,0:19:50.75,Default,,0000,0000,0000,,Mau biến khỏi đây thôi!
Dialogue: 0,0:19:51.07,0:19:52.00,Default,,0000,0000,0000,,Đừng để hắn bắn!
Dialogue: 0,0:19:53.64,0:19:54.60,Default,,0000,0000,0000,,Cứ để gã đó cho tôi!
Dialogue: 0,0:20:01.81,0:20:03.00,Default,,0000,0000,0000,,Chạy về phía tháp điều khiển!
Dialogue: 0,0:20:10.55,0:20:12.02,Default,,0000,0000,0000,,Tachikoma, em đi trước!
Dialogue: 0,0:20:12.59,0:20:13.55,Default,,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 0,0:20:20.30,0:20:22.06,Default,,0000,0000,0000,,Được rồi, đưa chúng tôi\Nrời khỏi đây mau!
Dialogue: 0,0:20:51.76,0:20:52.59,Default,,0000,0000,0000,,Batou.
Dialogue: 0,0:20:52.59,0:20:53.36,Default,,0000,0000,0000,,Hử?
Dialogue: 0,0:20:58.50,0:21:01.66,Default,,0000,0000,0000,,Bỏ bàn tay bẩn thỉu của các người\Nkhỏi mẹ tôi mau!
Dialogue: 0,0:21:03.74,0:21:06.10,Default,,0000,0000,0000,,\"Mẹ\" sao?!
Dialogue: 0,0:21:06.47,0:21:07.68,Default,,0000,0000,0000,,- Buông ra!\N- Trời đất, con nhãi này khỏe thế!
Dialogue: 0,0:21:07.68,0:21:09.77,Default,,0000,0000,0000,,- Thả tao ra, chết tiệt!\N- Trời đất, con nhãi này khỏe thế!
Dialogue: 0,0:21:10.14,0:21:11.41,Default,,0000,0000,0000,,Lũ khốn khiếp!
Dialogue: 0,0:21:11.41,0:21:13.05,Default,,0000,0000,0000,,Đừng hòng đụng vào mẹ tao!
Dialogue: 0,0:21:13.05,0:21:14.98,Default,,0000,0000,0000,,Thả tao ra,\Nlũ khốn nạn!
Dialogue: 0,0:21:25.96,0:21:29.05,Default,,0000,0000,0000,,Oa, nơi đó còn tuyệt vời hơn\Ncả những lời đồn đại nữa!
Dialogue: 0,0:21:29.26,0:21:30.93,Default,,0000,0000,0000,,Nó như thế nào vậy?\NNó như thế nào hả cậu?
Dialogue: 0,0:21:30.93,0:21:32.70,Default,,0000,0000,0000,,Nhanh lên, kết nối đồng bộ với tớ đi!
Dialogue: 0,0:21:36.64,0:21:40.04,Default,,0000,0000,0000,,Bà ta thực sự ít tuổi\Nhơn cả tôi sao?
Dialogue: 0,0:21:41.24,0:21:46.01,Default,,0000,0000,0000,,Giới truyền thông sẽ kéo đến ùn ùn\Nkhi nghe tin về vụ này cho mà xem.
Dialogue: 0,0:21:47.12,0:21:48.48,Default,,0000,0000,0000,,Chuyện đó thì khỏi phải bàn rồi.
Dialogue: 0,0:21:49.45,0:21:53.08,Default,,0000,0000,0000,,Cũng giống như cô, những người bên SST\Nhẳn là đã nhận ra...
Dialogue: 0,0:21:53.52,0:21:58.72,Default,,0000,0000,0000,,...rằng bà lão mới chính là Eka Tokura,\Nchứ không phải cô bé kia.
Dialogue: 0,0:22:00.50,0:22:04.66,Default,,0000,0000,0000,,Và một khi đã xác minh xong,\Nhọ cố gắng tiếp xúc với bà ta.
Dialogue: 0,0:22:06.47,0:22:08.77,Default,,0000,0000,0000,,Và rồi họ đã liên kết\Nvới não điện tử của bà ấy.
Dialogue: 0,0:22:09.10,0:22:11.26,Default,,0000,0000,0000,,\"Xóa chúng đi\", hả?
Dialogue: 0,0:22:11.81,0:22:14.71,Default,,0000,0000,0000,,Ban đầu, tôi chẳng hiểu\Ngã đó nói lảm nhảm cái quái gì.
Dialogue: 0,0:22:14.71,0:22:19.54,Default,,0000,0000,0000,,Hẳn ý anh ta là,\N\"Hãy xóa sạch những ký ức đó đi.\"
Dialogue: 0,0:22:20.55,0:22:22.54,Default,,0000,0000,0000,,Thật khó mà tin được rằng\Nmột cô bé mười tuổi...
Dialogue: 0,0:22:23.55,0:22:27.25,Default,,0000,0000,0000,,...lại đột ngột già đi thành một bà lão\Ntrong mười sáu năm kể từ khi bị bắt cóc.
Dialogue: 0,0:22:30.26,0:22:33.72,Default,,0000,0000,0000,,Tôi thậm chí chẳng dám {\i1}nghĩ tới{\i0}\Nnhững gì bà ấy đã phải trải qua trong ngần ấy năm.
Dialogue: 0,0:22:36.26,0:22:41.83,Default,,0000,0000,0000,,Và còn cả câu hỏi làm thế nào con gái của Eka\Nlại trở thành thủ lĩnh của bọn chúng nữa...
Dialogue: 0,0:22:43.30,0:22:48.04,Default,,0000,0000,0000,,Cậu có muốn tìm hiểu không?\NBằng cách kết nối với con bé ấy?
Dialogue: 0,0:22:49.11,0:22:52.08,Default,,0000,0000,0000,,Thôi xin kiếu...\NTôi nghĩ mình xin rút lui.
Dialogue: 0,0:22:52.08,0:22:54.08,Default,,0000,0000,0000,,{\fad(300,300)\an8}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.54,0:23:20.89,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng thật lạnh lùng mà cũng thật con người
Dialogue: 0,0:23:20.89,0:23:23.79,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.79,0:23:26.10,GitS ED Credits,,0000,0000,0000,,Nàng vẫn tỏa sáng rạng ngời trong cô độc
Dialogue: 0,0:23:26.10,0:23:29.16,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng quả đúng là Đội số 9
Dialogue: 0,0:23:29.16,0:23:31.91,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Nàng tựa như phép toán diệu kỳ
Dialogue: 0,0:23:33.17,0:23:36.19,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Chỉ là một phép toán diệu kỳ
Dialogue: 0,0:23:36.46,0:23:40.65,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.65,0:23:43.94,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng tựa như một điều gì đó thật mới mẻ
Dialogue: 0,0:23:43.94,0:23:46.19,GitS ED Credits,,0000,0000,0000,,Một đóa hoa lithium vừa thức giấc
Dialogue: 0,0:23:46.19,0:23:49.05,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang chớm nở rộ
Dialogue: 0,0:23:49.14,0:23:51.85,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi đã ngửi thấy mùi lithium
Dialogue: 0,0:23:52.89,0:23:55.97,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Nghe thấy mùi lithium quanh đây
Dialogue: 0,0:23:57.14,0:24:01.18,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:01.18,0:24:05.01,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:05.01,0:24:07.91,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:07.91,0:24:12.11,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Không biết nàng sẽ làm gì khi tỉnh giấc?
