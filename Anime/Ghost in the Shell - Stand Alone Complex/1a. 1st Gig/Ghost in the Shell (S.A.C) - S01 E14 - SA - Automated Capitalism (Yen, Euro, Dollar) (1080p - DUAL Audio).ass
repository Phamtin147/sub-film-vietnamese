Dialogue: 0,0:02:08.76,0:02:12.39,Default,,0000,0000,0000,,{\i1}Một bóng ma đang lởn vởn{\i0}\N{\i1}trong thành phố này...{\i0}
Dialogue: 0,0:02:19.51,0:02:22.57,Default,,0000,0000,0000,,{\i1}Bóng ma của chủ nghĩa tư bản.{\i0}
Dialogue: 0,0:02:51.94,0:02:54.97,Default,,0000,0000,0000,,{\i1}Đang túc trực đợi gom rác{\i0}\N{\i1}không thể tái chế. Phía cậu thế nào?{\i0}
Dialogue: 0,0:02:57.08,0:02:58.44,Default,,0000,0000,0000,,{\i1}Rồi, tôi sẵn sàng bất cứ lúc nào.{\i0}
Dialogue: 0,0:02:58.91,0:03:00.75,Default,,0000,0000,0000,,{\i1}Thiếu tá lúc nào cũng{\i0}\N{\i1}lo bò trắng răng.{\i0}
Dialogue: 0,0:03:01.02,0:03:04.61,Default,,0000,0000,0000,,{\i1}Đường truyền này làm sao mà bị nghe lén{\i0}\N{\i1}kể cả khi chúng ta không mã hóa chứ.{\i0}
Dialogue: 0,0:03:04.85,0:03:08.52,Default,,0000,0000,0000,,Nếu cậu không cẩn thận hơn một chút,\Nthì có ngày dập mặt đấy.
Dialogue: 0,0:03:09.49,0:03:14.12,Default,,0000,0000,0000,,{\i1}Dù thông tin tình báo có sai đi chăng nữa, thì cũng{\i0}\N{\i1}không thay đổi được sự thật chúng chỉ là một lũ côn đồ tép riu.{\i0}
Dialogue: 0,0:03:14.20,0:03:16.10,Default,,0000,0000,0000,,{\i1}Tôi chẳng thấy có lý do gì{\i0}\N{\i1}chúng ta có thể bị hạ cả.{\i0}
Dialogue: 0,0:03:18.67,0:03:20.07,Default,,0000,0000,0000,,{\i1}Tachikoma, tình hình bên em thế nào?{\i0}
Dialogue: 0,0:03:22.77,0:03:24.54,Default,,0000,0000,0000,,Đã phong tỏa toàn bộ các tuyến đường\Nxung quanh hoàn tất ạ!
Dialogue: 0,0:03:25.94,0:03:30.31,Default,,0000,0000,0000,,Thiếu tá ơi, có ai đó vứt một ông già ở đây này!\NChúng em phải làm gì với ông ấy đây?
Dialogue: 0,0:03:30.31,0:03:32.68,Default,,0000,0000,0000,,{\i1}Kệ ông ta đi. Đó là việc{\i0}\N{\i1}của chính quyền địa phương.{\i0}
Dialogue: 0,0:03:32.68,0:03:33.48,Default,,0000,0000,0000,,{\i1}Còn cậu thì sao?{\i0}
Dialogue: 0,0:03:34.65,0:03:38.28,Default,,0000,0000,0000,,{\i1}Tôi đã tháo lỏng bugi trên mọi chiếc xe{\i0}\N{\i1}có dấu hiệu khả nghi rồi.{\i0}
Dialogue: 0,0:03:40.06,0:03:42.99,Default,,0000,0000,0000,,{\i1}Có muốn tôi rút luôn bugi{\i0}\N{\i1}của chiếc xe đó không?{\i0}
Dialogue: 0,0:03:47.16,0:03:48.53,Default,,0000,0000,0000,,{\i1}Bắt đầu thôi.{\i0}
Dialogue: 0,0:03:52.30,0:03:55.46,Default,,0000,0000,0000,,Đúng là mẫu xe của Nhật có khác...\NNhạy thật đấy.
Dialogue: 0,0:03:58.87,0:04:00.57,Default,,0000,0000,0000,,Bộ phận vệ sinh môi trường đây!
Dialogue: 0,0:04:05.68,0:04:07.98,Default,,0000,0000,0000,,Chúng tôi đến để thu gom\Nrác thải cồng kềnh của các người.
Dialogue: 0,0:04:12.52,0:04:15.55,Default,,0000,0000,0000,,Nếu có nhầm lẫn gì,\Nthì tôi cần chữ ký của các người vào đây.
Dialogue: 0,0:04:33.14,0:04:34.97,Default,,0000,0000,0000,,Ngoan ngoãn ngồi yên\Nở đó cho ta!
Dialogue: 0,0:04:37.68,0:04:39.88,Default,,0000,0000,0000,,Cơ quan chức năng có tin tình báo\Ntừ nguồn đáng tin cậy...
Dialogue: 0,0:04:39.88,0:04:42.18,Default,,0000,0000,0000,,...rằng các người chuẩn bị tấn công\Nvào một tổ chức tài chính.
Dialogue: 0,0:04:43.45,0:04:45.18,Default,,0000,0000,0000,,Đừng hòng giở trò ngu ngốc.
Dialogue: 0,0:04:53.06,0:04:54.46,Default,,0000,0000,0000,,Bộ các người không nghe\Nbà chị ấy nói gì à?
Dialogue: 0,0:04:54.90,0:04:56.87,Default,,0000,0000,0000,,Cô ấy bảo cấm giở trò\Nngu ngốc đấy.
Dialogue: 0,0:05:17.85,0:05:19.48,Default,,0000,0000,0000,,Được rồi, còng đầu giải chúng đi!
Dialogue: 0,0:05:24.23,0:05:26.22,Default,,0000,0000,0000,,Có vẻ như nguồn tin tình báo của chúng ta\Nchuẩn xác đến từng xu.
Dialogue: 0,0:05:26.40,0:05:29.83,Default,,0000,0000,0000,,Họ bảo món đồ chơi ghê gớm nhất của chúng\Nchỉ là một khẩu shotgun cổ lỗ sĩ thôi.
Dialogue: 0,0:05:30.73,0:05:34.53,Default,,0000,0000,0000,,Xử lý những vụ như thế này\Nphải thật nhanh gọn và thận trọng.
Dialogue: 0,0:05:46.78,0:05:47.87,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:05:53.79,0:05:54.92,Default,,0000,0000,0000,,Cô không sao chứ?
Dialogue: 0,0:06:01.53,0:06:03.52,Default,,0000,0000,0000,,Trông cô vẫn còn nguyên vẹn,\Nđại loại là thế.
Dialogue: 0,0:06:04.40,0:06:06.27,Default,,0000,0000,0000,,Chẳng buồn cười\Nchút nào đâu nhé.
Dialogue: 0,0:06:06.87,0:06:08.50,Default,,0000,0000,0000,,Togusa,\Nlái xe vòng qua đây mau!
Dialogue: 0,0:06:08.80,0:06:10.27,Default,,0000,0000,0000,,Chúc may mắn nhé.
Dialogue: 0,0:06:12.51,0:06:15.57,Default,,0000,0000,0000,,Vâng, thưa Cục trưởng. Đi cùng với chúng\Ncòn có một mẫu robot \"Pioneer\".
Dialogue: 0,0:06:16.31,0:06:17.54,Default,,0000,0000,0000,,Và sao nữa?
Dialogue: 0,0:06:17.78,0:06:20.65,Default,,0000,0000,0000,,Tên đầu sỏ là một tay giang hồ\Nđến từ Tỉnh Nam Trung Hoa,
Dialogue: 0,0:06:20.85,0:06:23.35,Default,,0000,0000,0000,,và dường như hắn đang lên kế hoạch trả thù\NCông ty Interstar...
Dialogue: 0,0:06:23.35,0:06:26.32,Default,,0000,0000,0000,,...vì những khoản thua lỗ mà hắn phải gánh chịu\Nkhi họ bán tháo cổ phiếu nội bộ.
Dialogue: 0,0:06:28.96,0:06:30.76,Default,,0000,0000,0000,,Bộ trang phục này ấn tượng đấy chứ.
Dialogue: 0,0:06:31.66,0:06:34.72,Default,,0000,0000,0000,,Cô mặc bộ này là để\Ngây sự chú ý với tôi đấy à?
Dialogue: 0,0:06:34.83,0:06:38.20,Default,,0000,0000,0000,,Tất nhiên là không rồi.\NTôi chẳng có nhiều lựa chọn.
Dialogue: 0,0:06:39.77,0:06:43.17,Default,,0000,0000,0000,,Tin tình báo từ Sở An ninh Công cộng Tỉnh Nam Trung Hoa\Ncó tỏ ra hữu ích không?
Dialogue: 0,0:06:43.91,0:06:46.10,Default,,0000,0000,0000,,Có hai điểm khiến tôi\Nthấy lấn cấn.
Dialogue: 0,0:06:46.41,0:06:50.14,Default,,0000,0000,0000,,Thứ nhất là việc có một người máy android trà trộn\Ntrong băng đảng mà trong báo cáo không hề đề cập.
Dialogue: 0,0:06:50.78,0:06:53.15,Default,,0000,0000,0000,,Nhưng chuyện đó\Nkhông quá nghiêm trọng.
Dialogue: 0,0:06:53.15,0:06:54.38,Default,,0000,0000,0000,,Vậy sao?
Dialogue: 0,0:06:56.62,0:07:01.39,Default,,0000,0000,0000,,Thứ hai, dù mục tiêu của chúng được cho là\Nnhắm vào một tổ chức tài chính,
Dialogue: 0,0:07:01.72,0:07:05.02,Default,,0000,0000,0000,,nhưng không hiểu sao trong người chúng\Nlại mang theo tập hồ sơ dữ liệu về một nhà đầu tư cá nhân.
Dialogue: 0,0:07:08.63,0:07:09.46,Default,,0000,0000,0000,,Người này là ai?
Dialogue: 0,0:07:10.20,0:07:11.50,Default,,0000,0000,0000,,Kanemoto Yokose.
Dialogue: 0,0:07:11.90,0:07:14.96,Default,,0000,0000,0000,,Từng là một nhà toán học, hiện là một\Ntrong những người giàu nhất thế giới.
Dialogue: 0,0:07:15.70,0:07:20.01,Default,,0000,0000,0000,,Ông ta là nhà đầu tư cá nhân mà tên tuổi luôn gắn liền\Nvới các thương vụ giao dịch chứng khoán khổng lồ.
Dialogue: 0,0:07:20.01,0:07:22.94,Default,,0000,0000,0000,,Hay đúng hơn, có thể gọi ông ta là một dạng\Ntống tiền doanh nghiệp kiểu mới.
Dialogue: 0,0:07:23.28,0:07:25.41,Default,,0000,0000,0000,,Tôi từng nghe cái tên này ở đâu đó rồi...
Dialogue: 0,0:07:25.71,0:07:28.38,Default,,0000,0000,0000,,Nghe nói ông ta nhảy vào thị trường chứng khoán\Nsau khi cảm thấy phát chán...
Dialogue: 0,0:07:28.72,0:07:30.52,Default,,0000,0000,0000,,...với việc quanh quẩn chơi đùa\Nvới những con số đơn thuần.
Dialogue: 0,0:07:30.52,0:07:32.25,Default,,0000,0000,0000,,Có vẻ ông ta cũng có năng khiếu\Nthiên bẩm trong lĩnh vực đó.
Dialogue: 0,0:07:32.55,0:07:36.72,Default,,0000,0000,0000,,Nhưng với ông ta, tiền điện tử và việc thao túng chứng khoán\Nchỉ là một trò tiêu khiển.
Dialogue: 0,0:07:37.59,0:07:40.76,Default,,0000,0000,0000,,Người ta đồn rằng nỗi ám ảnh thực sự của ông ta\Nchính là việc tích trữ vàng ròng,
Dialogue: 0,0:07:41.06,0:07:43.12,Default,,0000,0000,0000,,và ông ta đã cất giấu\Nmột khối lượng vàng khổng lồ.
Dialogue: 0,0:07:43.77,0:07:45.43,Default,,0000,0000,0000,,Nhưng dù giàu có như thế, ông ta lại ghét cay ghét đắng\Nbất cứ thứ gì phô trương hào nhoáng...
Dialogue: 0,0:07:45.43,0:07:47.90,Default,,0000,0000,0000,,...và cực kỳ hiếm khi xuất đầu lộ diện\Nở phía sau hậu trường,
Dialogue: 0,0:07:48.34,0:07:50.90,Default,,0000,0000,0000,,thế nên ông ta mới có biệt danh là\N\"Phù thủy Ẩn sĩ của Phố Wall\".
Dialogue: 0,0:07:51.27,0:07:53.94,Default,,0000,0000,0000,,Khỏi phải nói cũng biết ông ta\Ncó vô số kẻ thù.
Dialogue: 0,0:07:53.94,0:07:55.57,Default,,0000,0000,0000,,Đúng là một kẻ kỳ dị...
Dialogue: 0,0:07:56.45,0:07:59.47,Default,,0000,0000,0000,,Mà tôi ngạc nhiên là cậu lại\Nbiết tường tận về ông ta thế đấy.
Dialogue: 0,0:07:59.88,0:08:01.11,Default,,0000,0000,0000,,Cậu cũng tập tành\Nchơi chứng khoán đấy à?
Dialogue: 0,0:08:01.35,0:08:06.08,Default,,0000,0000,0000,,Không, chẳng qua tôi tình cờ xem được ông ta trên chương trình\N\"Những Dinh thự Bậc nhất Thế giới\" một lần thôi mà.
Dialogue: 0,0:08:07.69,0:08:09.63,Default,,0000,0000,0000,,Trời đất, đúng là người đàn ông của gia đình...
Dialogue: 0,0:08:09.63,0:08:13.25,Default,,0000,0000,0000,,{\i1}Trưởng ban, ngài có cuộc gọi từ ông Vương{\i0}\N{\i1}bên Sở An ninh Công cộng Nam Trung Hoa.{\i0}
Dialogue: 0,0:08:13.60,0:08:14.36,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:08:15.10,0:08:17.73,Default,,0000,0000,0000,,Tăng gấp đôi giao thức bảo mật\Nrồi chuyển máy vào cho tôi.
Dialogue: 0,0:08:18.10,0:08:19.19,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:08:20.04,0:08:22.23,Default,,0000,0000,0000,,{\i1}Ông Aramaki,{\i0}\N{\i1}đã lâu không gặp.{\i0}
Dialogue: 0,0:08:22.54,0:08:24.70,Default,,0000,0000,0000,,{\i1}Từ đợt Hội nghị An ninh Công cộng Châu Á{\i0}\N{\i1}đến giờ nhỉ?{\i0}
Dialogue: 0,0:08:25.11,0:08:27.87,Default,,0000,0000,0000,,{\i1}Chúng tôi đã làm phiền ngài rất nhiều{\i0}\N{\i1}vì vụ việc lần này.{\i0}
Dialogue: 0,0:08:28.11,0:08:31.01,Default,,0000,0000,0000,,{\i1}Đất nước chúng tôi vô cùng hổ thẹn.{\i0}\N{\i1}Xin ngài hãy nhận lời xin lỗi của tôi.{\i0}
Dialogue: 0,0:08:31.31,0:08:34.68,Default,,0000,0000,0000,,{\i1}Không có gì đâu. Nhờ sự hỗ trợ của các ngài,{\i0}\N{\i1}chúng tôi đã dập tắt nó ngay từ trong trứng nước.{\i0}
Dialogue: 0,0:08:34.88,0:08:36.65,Default,,0000,0000,0000,,Vậy hôm nay tôi có thể\Ngiúp gì cho ngài đây?
Dialogue: 0,0:08:37.05,0:08:42.19,Default,,0000,0000,0000,,Chuyện là, chúng tôi vừa phát hiện một khoản chi không rõ nguồn gốc\Nkhi kiểm tra...
Dialogue: 0,0:08:42.19,0:08:44.63,Default,,0000,0000,0000,,...tài khoản ngân hàng của những kẻ\Nbuôn lậu vũ khí cho đám xã hội đen đó.
Dialogue: 0,0:08:45.66,0:08:51.27,Default,,0000,0000,0000,,{\i1}Kinh nghiệm quá khứ mách bảo tôi rằng đây có thể là{\i0}\N{\i1}bằng chứng cho thấy chúng đã thuê một sát thủ thế giới ngầm,{\i0}
Dialogue: 0,0:08:51.27,0:08:53.13,Default,,0000,0000,0000,,{\i1}nên tôi nghĩ mình cần báo cho ngài biết,{\i0}\N{\i1}phòng hờ mọi bất trắc.{\i0}
Dialogue: 0,0:08:53.47,0:08:55.33,Default,,0000,0000,0000,,Cảm ơn ngài đã cất công\Nbáo tin cho chúng tôi.
Dialogue: 0,0:08:55.74,0:08:58.23,Default,,0000,0000,0000,,Chúng tôi sẽ hành động\Nvới sự cẩn trọng cao nhất.
Dialogue: 0,0:08:58.71,0:09:00.37,Default,,0000,0000,0000,,Rất mong có thể hỗ trợ ngài\Nnhiều hơn nữa trong tương lai.
Dialogue: 0,0:09:02.58,0:09:05.67,Default,,0000,0000,0000,,Để cho chắc chắn, hãy bố trí người\Nbảo vệ ông Yokose.
Dialogue: 0,0:09:08.05,0:09:12.11,Default,,0000,0000,0000,,Batou, tập hợp cùng Ishikawa ở sân đỗ trực thăng\Nvới trang bị Hạng D3. Mang theo một con Tachikoma.
Dialogue: 0,0:09:12.76,0:09:17.06,Default,,0000,0000,0000,,Togusa, cậu đi thẩm vấn lại đám người đó.\NBằng mọi giá phải moi ra thông tin.
Dialogue: 0,0:09:26.50,0:09:28.44,Default,,0000,0000,0000,,Từ A-SIA sang ¥€$? (Yên, Euro, Đô-la)
Dialogue: 0,0:09:30.41,0:09:33.40,Default,,0000,0000,0000,,Tôi tin rằng tỷ giá đồng Yên\Nđang có lợi hơn đấy ạ.
Dialogue: 0,0:09:33.64,0:09:34.57,Default,,0000,0000,0000,,Tôi không quan tâm.
Dialogue: 0,0:09:36.01,0:09:37.34,Default,,0000,0000,0000,,Xin chờ cho một lát.
Dialogue: 0,0:10:50.92,0:10:54.69,Default,,0000,0000,0000,,Anh Ishikawa ơi, cho em\Nchơi trò đó với!
Dialogue: 0,0:11:02.66,0:11:06.83,Default,,0000,0000,0000,,Thiếu tá, tôi không tài nào\Nliên lạc được với ông Yokose.
Dialogue: 0,0:11:07.27,0:11:08.83,Default,,0000,0000,0000,,Chuyện đó nghe chẳng\Ngiống phong cách của cậu chút nào.
Dialogue: 0,0:11:09.27,0:11:11.87,Default,,0000,0000,0000,,Đâm đơn kiện để dụ đám cố vấn pháp lý\Ncủa ông ta lộ diện ra.
Dialogue: 0,0:11:12.54,0:11:14.17,Default,,0000,0000,0000,,Lần theo đường đó là tóm được\Nông ta ngay thôi, đúng không?
Dialogue: 0,0:11:14.84,0:11:18.07,Default,,0000,0000,0000,,Hoặc là các ngân hàng lớn luôn có chuyên viên chăm sóc khách hàng VIP riêng.\NThử cách đó xem.
Dialogue: 0,0:11:18.85,0:11:22.84,Default,,0000,0000,0000,,Không, tôi đã thử chiêu đó rồi nhưng chẳng đi đến đâu cả.
Dialogue: 0,0:11:23.55,0:11:25.65,Default,,0000,0000,0000,,Sự thực là gã này\Nlà một nhân vật vô cùng bí ẩn.
Dialogue: 0,0:11:26.89,0:11:31.03,Default,,0000,0000,0000,,Không những chưa hề phẫu thuật não điện tử,\Nmà thông tin liên lạc của ông ta cũng bặt vô âm tín.
Dialogue: 0,0:11:31.03,0:11:33.62,Default,,0000,0000,0000,,Ngay cả trên thiết bị di động hay máy tính của tay quản lý trưởng\Ncũng chẳng hề có lấy một số liên lạc.
Dialogue: 0,0:11:34.03,0:11:37.59,Default,,0000,0000,0000,,Thế còn đạo diễn sản xuất\Ncủa chương trình \"dinh thự\" kia thì sao?
Dialogue: 0,0:11:38.37,0:11:40.36,Default,,0000,0000,0000,,Chẳng lẽ ông ta không biết\Ncách liên hệ à?
Dialogue: 0,0:11:40.84,0:11:42.20,Default,,0000,0000,0000,,Tôi cũng đã hỏi rồi.
Dialogue: 0,0:11:42.57,0:11:46.84,Default,,0000,0000,0000,,Ông ta bảo chính ông Yokose đã chủ động liên lạc {\i1}với họ{\i0}\Nkhi họ quay các phóng sự phỏng vấn cho chương trình.
Dialogue: 0,0:11:47.61,0:11:50.20,Default,,0000,0000,0000,,Vậy là chúng ta chỉ biết mỗi địa chỉ\Nnhà của ông ta thôi sao?
Dialogue: 0,0:12:06.13,0:12:08.19,Default,,0000,0000,0000,,Bật chế độ tàng hình quang học\Nrồi bám theo tôi vào trong.
Dialogue: 0,0:12:09.26,0:12:10.13,Default,,0000,0000,0000,,Rõ rồi ạ!
Dialogue: 0,0:12:12.03,0:12:14.00,Default,,0000,0000,0000,,Trả lời kiểu gì thế hả trời?
Dialogue: 0,0:12:22.44,0:12:23.74,Default,,0000,0000,0000,,{\i1}Batou, tình hình thế nào?{\i0}
Dialogue: 0,0:12:25.28,0:12:27.71,Default,,0000,0000,0000,,{\i1}Bọn tôi đang bò lê la như bọ và đã vào vị trí{\i0}\N{\i1}phía sau tòa dinh thự.{\i0}
Dialogue: 0,0:12:30.59,0:12:32.05,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi trúng mánh rồi.{\i0}
Dialogue: 0,0:12:32.59,0:12:34.72,Default,,0000,0000,0000,,{\i1}Đúng như chúng ta phán đoán,{\i0}\N{\i1}chúng đã thuê sát thủ.{\i0}
Dialogue: 0,0:12:45.00,0:12:46.17,Default,,0000,0000,0000,,{\i1}Mật danh: Fem.{\i0}
Dialogue: 0,0:12:46.17,0:12:50.07,Default,,0000,0000,0000,,{\i1}Ả là cyborg chiến đấu trực thuộc Mafia Biển Nam,{\i0}\N{\i1}đang bị truy nã quốc tế.{\i0}
Dialogue: 0,0:12:50.67,0:12:54.27,Default,,0000,0000,0000,,{\i1}Tôi đã đào bới qua các tài khoản ngân hàng{\i0}\N{\i1}và cũng xác nhận được điều đó.{\i0}
Dialogue: 0,0:12:55.24,0:12:59.81,Default,,0000,0000,0000,,{\i1}Có vẻ như đám người ở nhà hàng Trung Hoa{\i0}\N{\i1}chỉ là mồi nhử để đánh lạc hướng điều tra mà thôi.{\i0}
Dialogue: 0,0:13:00.38,0:13:04.01,Default,,0000,0000,0000,,{\i1}Được rồi, phần còn lại tôi sẽ đọc trong báo cáo.{\i0}\N{\i1}Lên trực thăng rồi đến thẳng đây ngay đi!{\i0}
Dialogue: 0,0:13:04.42,0:13:05.22,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:13:07.36,0:13:08.95,Default,,0000,0000,0000,,Xem ra quyết định của mình\Nlà chuẩn xác...
Dialogue: 0,0:13:13.56,0:13:16.90,Default,,0000,0000,0000,,{\i1}Thiếu tá, tôi tìm thấy một lịch hẹn của ông ta{\i0}\N{\i1}với Công ty Bảo trì Kouhoku.{\i0}
Dialogue: 0,0:13:17.77,0:13:22.14,Default,,0000,0000,0000,,{\i1}Tôi đã chỉnh sửa giờ giấc và mã nhận diện, nên cô{\i0}\N{\i1}có thể đàng hoàng đi vào bằng cửa chính.{\i0}
Dialogue: 0,0:13:22.14,0:13:23.76,Default,,0000,0000,0000,,{\i1}Đã rõ.{\i0}\N{\i1}Làm tốt lắm.{\i0}
Dialogue: 0,0:13:24.01,0:13:26.53,Default,,0000,0000,0000,,{\i1}Hãy ở yên vị trí và tiếp tục giám sát{\i0}\N{\i1}các hệ thống bên trong dinh thự.{\i0}
Dialogue: 0,0:13:42.19,0:13:43.78,Default,,0000,0000,0000,,Thật là phí phạm của trời...
Dialogue: 0,0:13:49.53,0:13:51.83,Default,,0000,0000,0000,,Có khi lát về mình phải mượn tạm\Nmột chiếc mới được.
Dialogue: 0,0:14:06.85,0:14:08.34,Default,,0000,0000,0000,,Suýt chết...
Dialogue: 0,0:14:08.88,0:14:10.35,Default,,0000,0000,0000,,Chuyện này có vẻ\Nrắc rối đây.
Dialogue: 0,0:14:16.63,0:14:17.99,Default,,0000,0000,0000,,Chính là nó sao?
Dialogue: 0,0:14:27.27,0:14:28.57,Default,,0000,0000,0000,,Mấy tay ngân hàng...
Dialogue: 0,0:14:28.97,0:14:30.90,Default,,0000,0000,0000,,Thời điểm này\Nchẳng đúng lúc chút nào.
Dialogue: 0,0:14:36.11,0:14:38.31,Default,,0000,0000,0000,,{\i1}Tachikoma, kiểm tra{\i0}\N{\i1}chiếc xe tải kia xem.{\i0}
Dialogue: 0,0:14:46.69,0:14:48.16,Default,,0000,0000,0000,,Xin hỏi quý cô\Nđây là ai ạ?
Dialogue: 0,0:14:51.06,0:14:52.12,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}
Dialogue: 0,0:14:54.13,0:14:56.90,Default,,0000,0000,0000,,Có vẻ như bọn họ\Nđều đã bị sát hại cả rồi.
Dialogue: 0,0:14:56.90,0:14:58.87,Default,,0000,0000,0000,,{\i1}Ả ta đã đi trước chúng ta{\i0}\N{\i1}một bước rồi sao?{\i0}
Dialogue: 0,0:15:00.47,0:15:03.56,Default,,0000,0000,0000,,Nếu quý cô không có lịch hẹn trước,\Nthì tôi buộc lòng phải mời cô rời khỏi đây.
Dialogue: 0,0:15:04.01,0:15:07.46,Default,,0000,0000,0000,,Bảo trì Kouhoku đây.\NTôi đến để kiểm tra định kỳ.
Dialogue: 0,0:15:08.84,0:15:10.71,Default,,0000,0000,0000,,Cảm ơn quý cô\Nđã đến làm việc.
Dialogue: 0,0:15:17.62,0:15:20.92,Default,,0000,0000,0000,,{\i1}Ở đây chẳng có ai khác ngoài{\i0}\N{\i1}mấy con búp bê vô hồn không có Ghost này sao?{\i0}
Dialogue: 0,0:15:21.92,0:15:26.55,Default,,0000,0000,0000,,{\i1}Batou, tôi đã vô hiệu hóa an ninh.{\i0}\N{\i1}Vào đây và bắt giữ ông Yokose ngay.{\i0}
Dialogue: 0,0:15:26.96,0:15:29.40,Default,,0000,0000,0000,,{\i1}Ả Fem có lẽ đã lọt vào{\i0}\N{\i1}bên trong dinh thự rồi.{\i0}
Dialogue: 0,0:15:29.73,0:15:31.56,Default,,0000,0000,0000,,{\i1}Xin lỗi nhé, nhưng chắc tôi{\i0}\N{\i1}sẽ đến trễ một chút đấy.{\i0}
Dialogue: 0,0:15:32.10,0:15:34.30,Default,,0000,0000,0000,,{\i1}Khẩn trương lên.{\i0}\N{\i1}Tachikoma, đi cùng tôi.{\i0}
Dialogue: 0,0:15:37.87,0:15:39.34,Default,,0000,0000,0000,,Còn quý ngài đây\Nlà ai ạ?
Dialogue: 0,0:15:40.04,0:15:42.01,Default,,0000,0000,0000,,Tôi á? Tôi là Tachikoma.
Dialogue: 0,0:15:58.59,0:15:59.82,Default,,0000,0000,0000,,Tình hình này chẳng ổn chút nào...
Dialogue: 0,0:16:01.06,0:16:03.29,Default,,0000,0000,0000,,Trông chúng không có vẻ gì là nhảy lên được đây,
Dialogue: 0,0:16:03.70,0:16:06.43,Default,,0000,0000,0000,,nhưng mà tỉa từng con một\Nthì có vẻ hơi...
Dialogue: 0,0:16:10.14,0:16:12.11,Default,,0000,0000,0000,,Đó là chiêu ghê gớm nhất\Ncủa các cưng rồi đấy hả?
Dialogue: 0,0:16:16.51,0:16:18.00,Default,,0000,0000,0000,,Chắc mình phải làm một cú\Nđột phá thôi.
Dialogue: 0,0:16:41.00,0:16:43.06,Default,,0000,0000,0000,,Phát hiện đối tượng\Ncó hành vi khả nghi.
Dialogue: 0,0:16:47.38,0:16:49.47,Default,,0000,0000,0000,,Quái quỷ, mình đang làm\Ncái trò gì thế này?
Dialogue: 0,0:16:49.98,0:16:51.57,Default,,0000,0000,0000,,{\i1}Tachikoma, sao em không chịu{\i0}\N{\i1}bọc hậu phía sau lưng tôi hả?{\i0}
Dialogue: 0,0:16:52.25,0:16:57.62,Default,,0000,0000,0000,,Thiếu tá ơi, chẳng ai trong số này có rào bảo vệ trong não cả. Sát thủ hiện đang...
Dialogue: 0,0:16:57.62,0:17:00.52,Default,,0000,0000,0000,,{\i1}Em đã quên mất nhiệm vụ làm \"bộ giáp\"{\i0}\N{\i1}bảo vệ cho tôi rồi đấy à?{\i0}
Dialogue: 0,0:17:00.89,0:17:03.19,Default,,0000,0000,0000,,Em đâu có nghĩ bản thân mình\Nchỉ là một bộ giáp đâu ạ...
Dialogue: 0,0:17:21.28,0:17:23.77,Default,,0000,0000,0000,,Ông Yokose hiện đang nghỉ ngơi,
Dialogue: 0,0:17:24.11,0:17:26.31,Default,,0000,0000,0000,,xin quý khách vui lòng đợi\Ncho đến khi ông ấy tỉnh giấc.
Dialogue: 0,0:17:27.45,0:17:28.85,Default,,0000,0000,0000,,Tôi sẽ không đánh thức ông ta đâu.
Dialogue: 0,0:17:59.85,0:18:01.41,Default,,0000,0000,0000,,Anh đang làm cái gì thế hả,\Nanh bự con?
Dialogue: 0,0:18:01.72,0:18:04.62,Default,,0000,0000,0000,,Cuối cùng tôi cũng hiểu ra\Ncách lũ chó này hoạt động rồi.
Dialogue: 0,0:18:05.82,0:18:07.55,Default,,0000,0000,0000,,{\i1}Nghe rõ đây!{\i0}
Dialogue: 0,0:18:07.96,0:18:09.01,Default,,0000,0000,0000,,{\i1}Ngồi xuống, mấy nhóc!{\i0}
Dialogue: 0,0:18:13.26,0:18:14.59,Default,,0000,0000,0000,,Ngoan lắm!
Dialogue: 0,0:18:15.13,0:18:15.93,Default,,0000,0000,0000,,Di chuyển thôi!
Dialogue: 0,0:18:17.10,0:18:18.36,Default,,0000,0000,0000,,Cái quái {\i1}gì thế này?{\i0}
Dialogue: 0,0:18:22.90,0:18:27.40,Default,,0000,0000,0000,,{\i1}Chắc ông đang mãn nguyện lắm nhỉ, khi được vây quanh bởi{\i0}\N{\i1}hàng đống vàng ròng mà ông đã vơ vét từ người nghèo.{\i0}
Dialogue: 0,0:18:30.48,0:18:34.62,Default,,0000,0000,0000,,Kanemoto Yokose...\NChết dưới tay đống vàng yêu quý của ông đi!
Dialogue: 0,0:18:34.62,0:18:38.21,Default,,0000,0000,0000,,Dừng tay lại đó, Fem!\NChúng tôi là cảnh sát.
Dialogue: 0,0:18:38.75,0:18:41.19,Default,,0000,0000,0000,,Liệu mà đầu hàng đi.\NĐi theo chúng tôi trong hòa bình.
Dialogue: 0,0:18:49.43,0:18:50.59,Default,,0000,0000,0000,,Chết tiệt!
Dialogue: 0,0:19:05.21,0:19:07.88,Default,,0000,0000,0000,,Có vẻ như cô nên bắn chết ông Yokose\Nngay từ đầu thì hơn đấy.
Dialogue: 0,0:19:09.15,0:19:11.74,Default,,0000,0000,0000,,Cậu đã ở đâu suốt thế hả?\NLàm gì mà lâu vậy?
Dialogue: 0,0:19:14.56,0:19:15.75,Default,,0000,0000,0000,,Tập trung vào!
Dialogue: 0,0:19:16.16,0:19:17.68,Default,,0000,0000,0000,,Tôi vướng phải chút rắc rối nhỏ.
Dialogue: 0,0:19:18.49,0:19:22.36,Default,,0000,0000,0000,,Dù sao thì, cảnh tượng này phi thường thật đấy!\NĐúng là một bữa tiệc mãn nhãn.
Dialogue: 0,0:19:22.96,0:19:24.69,Default,,0000,0000,0000,,Theo tôi thì bữa tiệc này\N{\i1}quá đỗi thịnh soạn{\i0} rồi đấy.
Dialogue: 0,0:19:24.87,0:19:28.36,Default,,0000,0000,0000,,Gã này thần kinh thép thật đấy,\Nồn ào náo loạn thế này mà vẫn ngủ ngon lành được.
Dialogue: 0,0:19:37.21,0:19:40.18,Default,,0000,0000,0000,,Tôi đoán là ông ta đã chết\Ntừ ba hoặc bốn tháng trước rồi.
Dialogue: 0,0:19:42.25,0:19:43.81,Default,,0000,0000,0000,,Ở đây vẫn còn lưu lại\Nmột số hồ sơ.
Dialogue: 0,0:19:44.29,0:19:48.59,Default,,0000,0000,0000,,Có vẻ như ông ta đã sắp đặt mọi thứ\Nphòng trường hợp mình qua đời.
Dialogue: 0,0:19:50.56,0:19:54.43,Default,,0000,0000,0000,,Ý cô là chẳng ai biết Yokose đã chết...
Dialogue: 0,0:19:54.66,0:19:57.69,Default,,0000,0000,0000,,...bởi vì \"Chương trình Kiếm tiền\" này\Nvẫn tiếp tục tự vận hành ngay cả sau khi ông ta qua đời sao?
Dialogue: 0,0:19:58.50,0:20:01.47,Default,,0000,0000,0000,,Có vẻ là vậy.\NChúng ta nên xử lý chuyện này thế nào đây?
Dialogue: 0,0:20:01.87,0:20:05.17,Default,,0000,0000,0000,,Cần liên hệ với cố vấn pháp lý\Nvà thân nhân còn sống của ông ta.
Dialogue: 0,0:20:05.17,0:20:07.14,Default,,0000,0000,0000,,Cậu biết đấy, báo cho họ biết\Nrằng chủ nhân của họ đã qua đời.
Dialogue: 0,0:20:07.58,0:20:09.48,Default,,0000,0000,0000,,Ông ta chắc chẳng còn\Nngười thân nào đâu.
Dialogue: 0,0:20:09.81,0:20:12.34,Default,,0000,0000,0000,,Tôi nhớ mang máng là ông ta từng nhắc đến\Nchuyện đó trong bài phỏng vấn.
Dialogue: 0,0:20:12.91,0:20:15.92,Default,,0000,0000,0000,,Nhắc mới nhớ, cậu có vẻ biết rõ\Nvề tay Yokose này nhỉ?
Dialogue: 0,0:20:15.92,0:20:17.79,Default,,0000,0000,0000,,Thế thì giao lại việc dọn dẹp hậu trường\Ncho cậu phụ trách nhé.
Dialogue: 0,0:20:17.79,0:20:18.55,Default,,0000,0000,0000,,Ý kiến hay đấy.
Dialogue: 0,0:20:19.52,0:20:20.51,Default,,0000,0000,0000,,Hả...?
Dialogue: 0,0:20:26.63,0:20:31.62,Default,,0000,0000,0000,,Nếu không có người thừa kế xuất hiện, tôi cho là nhà nước\Nsẽ thu hồi toàn bộ số vàng thỏi này.
Dialogue: 0,0:20:31.90,0:20:33.73,Default,,0000,0000,0000,,Như thế trông chẳng\Ncông bằng chút nào, đúng không?
Dialogue: 0,0:20:34.27,0:20:36.79,Default,,0000,0000,0000,,Nhưng một người gom hết đống vàng này về một mối\Nchẳng phải còn bất công hơn sao?
Dialogue: 0,0:20:37.31,0:20:39.27,Default,,0000,0000,0000,,Cậu cầm cái gì\Ntrên tay đấy hả?!
Dialogue: 0,0:20:44.21,0:20:46.48,Default,,0000,0000,0000,,Đáng lẽ ông ta phải biết rằng chết đi\Nthì có mang theo được gì đâu chứ...
Dialogue: 0,0:20:57.03,0:20:57.99,Default,,0000,0000,0000,,Chờ một chút.
Dialogue: 0,0:21:06.84,0:21:09.17,Default,,0000,0000,0000,,Dùng cái này mà trả tiền\Ncho người lái đò dưới âm phủ đi.
Dialogue: 0,0:21:15.98,0:21:19.50,Default,,0000,0000,0000,,{\i1}Còn về dòng tiền do Chương trình Kiếm tiền{\i0}\N{\i1}sử dụng thì,{\i0}
Dialogue: 0,0:21:20.22,0:21:25.48,Default,,0000,0000,0000,,{\i1}nó khổng lồ đến mức khó lòng lập báo cáo chi tiết{\i0}\N{\i1}cho đến khi chúng ta bóc tách được con AI đó ra.{\i0}
Dialogue: 0,0:21:26.29,0:21:29.88,Default,,0000,0000,0000,,{\i1}Hãy đào bới nó càng nhanh càng tốt.{\i0}\N{\i1}Tiện thể thì, Thiếu tá đâu rồi?{\i0}
Dialogue: 0,0:21:30.49,0:21:34.05,Default,,0000,0000,0000,,{\i1}Cô ấy đang trò chuyện với Ishikawa{\i0}\N{\i1}về con AI rắc rối nhà mình rồi.{\i0}
Dialogue: 0,0:21:35.60,0:21:41.00,Default,,0000,0000,0000,,Tôi hiểu điều đó, nhưng chúng ta không thể nạp vào nhận thức\Ncủa chúng cảm giác về sự cảnh cáo hay trừng phạt sao?
Dialogue: 0,0:21:41.64,0:21:42.83,Default,,0000,0000,0000,,Chà, tôi cũng không chắc nữa...
Dialogue: 0,0:21:43.64,0:21:46.04,Default,,0000,0000,0000,,Khi đi sâu vào vấn đề,\Nthì rắc rối là ở chỗ...
Dialogue: 0,0:21:46.04,0:21:48.51,Default,,0000,0000,0000,,...lũ Tachikoma không hề hiểu\Nkhái niệm về \"lao động\".
Dialogue: 0,0:21:56.99,0:21:57.92,Default,,0000,0000,0000,,Anh về rồi đây.
Dialogue: 0,0:21:58.42,0:21:59.89,Default,,0000,0000,0000,,Ồ, anh về rồi đấy à.
Dialogue: 0,0:22:04.26,0:22:05.28,Default,,0000,0000,0000,,Nhìn này, nhìn này!
Dialogue: 0,0:22:06.53,0:22:10.06,Default,,0000,0000,0000,,Hôm nay em vừa kiếm được 100.000 Yên\Ntừ cổ phiếu Meditech của chúng mình đấy!
Dialogue: 0,0:22:10.60,0:22:13.94,Default,,0000,0000,0000,,Em mua thật đấy à?\NAnh quên khuấy mất vụ đó rồi.
Dialogue: 0,0:22:13.94,0:22:17.00,Default,,0000,0000,0000,,Tất nhiên rồi! Giao dịch điện tử là cách\Nmấy bà nội trợ giết thời gian mà.
Dialogue: 0,0:22:19.81,0:22:21.50,Default,,0000,0000,0000,,Cơm tối xong rồi đấy anh.
Dialogue: 0,0:22:22.24,0:22:23.34,Default,,0000,0000,0000,,Ừ.
