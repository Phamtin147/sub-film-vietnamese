Dialogue: 0,0:01:33.84,0:01:35.46,Default,,0000,0000,0000,,Cái gì thế này?
Dialogue: 0,0:01:35.74,0:01:39.27,Default,,0000,0000,0000,,Dữ liệu nội bộ từ một trung tâm trợ giúp nghề nghiệp\Ndưới quyền quản lý của Bộ Tư pháp.
Dialogue: 0,0:01:39.61,0:01:41.21,Default,,0000,0000,0000,,Trung tâm trợ giúp nghề nghiệp sao?
Dialogue: 0,0:01:41.21,0:01:44.91,Default,,0000,0000,0000,,Họ tạm thời cách ly những bệnh nhân mắc thể nặng\Ncủa Hội chứng Vỏ bọc Não điện tử...
Dialogue: 0,0:01:45.21,0:01:48.01,Default,,0000,0000,0000,,...và huấn luyện giúp họ tái hòa nhập cộng đồng.
Dialogue: 0,0:01:48.55,0:01:50.49,Default,,0000,0000,0000,,Chắc hẳn cậu cũng từng\N{\i1}nghe nói{\i0} qua rồi nhỉ.
Dialogue: 0,0:01:50.99,0:01:54.58,Default,,0000,0000,0000,,Tuần trước, cơ sở dữ liệu của Bộ Y tế,\NLao động và Phúc lợi xã hội...
Dialogue: 0,0:01:54.96,0:01:57.48,Default,,0000,0000,0000,,...đã bị ai đó tại cơ sở này\Ntấn công trên diện rộng.
Dialogue: 0,0:01:58.26,0:02:03.76,Default,,0000,0000,0000,,Thông tin bị rò rỉ bao gồm cả\Ntài liệu tối mật trên Cấp A.
Dialogue: 0,0:02:04.33,0:02:06.70,Default,,0000,0000,0000,,Chú ý thời gian\Nhọ phá vỡ hàng rào bảo mật xem.
Dialogue: 0,0:02:07.44,0:02:12.34,Default,,0000,0000,0000,,Chúng xuyên thủng lớp rào tấn công phức hợp 3 tầng\Nchỉ trong vỏn vẹn 2 giờ đồng hồ.
Dialogue: 0,0:02:12.74,0:02:16.15,Default,,0000,0000,0000,,Nếu chỉ do một người làm, thì kẻ đó là một cao thủ lão luyện\Ncòn giỏi hơn cả Thiếu tá đấy.
Dialogue: 0,0:02:16.15,0:02:17.25,Default,,0000,0000,0000,,Còn giỏi hơn cả {\i1}Thiếu tá{\i0} sao?
Dialogue: 0,0:02:17.25,0:02:20.28,Default,,0000,0000,0000,,Để cho chắc, tôi đã bảo Ishikawa\Nvà Borma truy dấu đường truyền,
Dialogue: 0,0:02:20.28,0:02:23.01,Default,,0000,0000,0000,,nhưng đúng là trung tâm đó\Nchính là điểm khởi nguồn.
Dialogue: 0,0:02:23.29,0:02:27.59,Default,,0000,0000,0000,,Nhưng điều kỳ lạ là các mạch mạng của trung tâm đó\Nthường bị cô lập hoàn toàn,
Dialogue: 0,0:02:27.92,0:02:33.19,Default,,0000,0000,0000,,việc liên lạc từ trong ra ngoài hay ngược lại\Nvề cơ bản là điều bất khả thi.
Dialogue: 0,0:02:33.70,0:02:37.23,Default,,0000,0000,0000,,Đáng ngờ hơn nữa là phản ứng\Ncủa Bộ Y tế, Lao động và Phúc lợi.
Dialogue: 0,0:02:37.23,0:02:42.50,Default,,0000,0000,0000,,Dữ liệu tối mật bị người ta xem trộm,\Nvậy mà họ không thèm đệ trình một báo cáo thiệt hại nào.
Dialogue: 0,0:02:42.84,0:02:46.90,Default,,0000,0000,0000,,Kể cả họ có xấu hổ vì bị hack,\Nthì phản ứng đó cũng quá đỗi bất thường.
Dialogue: 0,0:02:47.34,0:02:50.28,Default,,0000,0000,0000,,Chắc chắn phải có {\i1}uẩn khúc gì đó{\i0}\Nđằng sau phản ứng của họ,
Dialogue: 0,0:02:50.28,0:02:52.98,Default,,0000,0000,0000,,nhưng nếu chúng ta không cẩn thận xóa dấu vết,\Nthì có nguy cơ họ sẽ lần ra chúng ta.
Dialogue: 0,0:02:53.25,0:02:54.81,Default,,0000,0000,0000,,Vậy nên chuyện này\Nphải nhờ đến {\i1}cậu.{\i0}
Dialogue: 0,0:03:00.96,0:03:02.82,Default,,0000,0000,0000,,{\i1}Nhiệm vụ điều tra{\i0}\N{\i1}ngầm à?{\i0}
Dialogue: 0,0:04:55.34,0:04:57.27,Default,,0000,0000,0000,,Phòng kết nối mạng của họ đây sao?
Dialogue: 0,0:05:02.51,0:05:05.91,Default,,0000,0000,0000,,Đúng như báo cáo...\NĐến dây nguồn còn chẳng thèm cắm.
Dialogue: 0,0:05:09.02,0:05:10.92,Default,,0000,0000,0000,,Này, có chuyện gì thế nhóc?
Dialogue: 0,0:05:11.35,0:05:14.65,Default,,0000,0000,0000,,Em đang lên mạng...\NHôm nay là ngày em được lên mạng.
Dialogue: 0,0:05:15.66,0:05:16.75,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:05:17.73,0:05:18.79,Default,,0000,0000,0000,,Anh là ai vậy?
Dialogue: 0,0:05:18.79,0:05:20.06,Default,,0000,0000,0000,,Hả? À...
Dialogue: 0,0:05:20.73,0:05:22.16,Default,,0000,0000,0000,,Thằng bé ở trong này.
Dialogue: 0,0:05:23.80,0:05:27.07,Default,,0000,0000,0000,,Chắc cậu là thực tập sinh mới.\NTôi là Maruta, giám đốc trung tâm.
Dialogue: 0,0:05:27.07,0:05:28.54,Default,,0000,0000,0000,,Tôi tên là Togusa.
Dialogue: 0,0:05:28.54,0:05:32.06,Default,,0000,0000,0000,,Này, trò {\i1}biết{\i0} là giờ này trò phải đang\Nlàm việc cùng với các bạn khác cơ mà.
Dialogue: 0,0:05:32.54,0:05:36.03,Default,,0000,0000,0000,,Em đang lên mạng...\NHôm nay là ngày em được lên mạng.
Dialogue: 0,0:05:36.41,0:05:37.65,Default,,0000,0000,0000,,Thằng bé bị sao thế ạ?
Dialogue: 0,0:05:37.65,0:05:40.42,Default,,0000,0000,0000,,Cậu đang ở\Nchế độ tự kỷ não điện tử à?
Dialogue: 0,0:05:40.42,0:05:41.28,Default,,0000,0000,0000,,Vâng, thưa cô.
Dialogue: 0,0:05:42.48,0:05:43.47,Default,,0000,0000,0000,,Đi thôi!
Dialogue: 0,0:05:48.26,0:05:49.43,Default,,0000,0000,0000,,Cẩn thận đấy.
Dialogue: 0,0:05:49.43,0:05:50.43,Default,,0000,0000,0000,,- Vâng, thưa cô!\N- Vâng, thưa cô!
Dialogue: 0,0:05:50.43,0:05:52.12,Default,,0000,0000,0000,,Hôm nay là ngày em được lên mạng...
Dialogue: 0,0:05:52.73,0:05:53.89,Default,,0000,0000,0000,,Đúng là vậy.
Dialogue: 0,0:05:54.36,0:05:56.09,Default,,0000,0000,0000,,Nhưng giờ đang là giờ\Nlao động của trò.
Dialogue: 0,0:05:56.70,0:05:58.53,Default,,0000,0000,0000,,Em muốn đến\NThành phố Ảo Alpha...
Dialogue: 0,0:06:05.07,0:06:08.64,Default,,0000,0000,0000,,Hôm nay... Hôm nay là ngày em được lên mạng!
Dialogue: 0,0:06:10.25,0:06:12.08,Default,,0000,0000,0000,,Hôm nay là ngày em được lên mạng!
Dialogue: 0,0:06:12.65,0:06:13.41,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:06:13.62,0:06:14.48,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:06:27.20,0:06:28.56,Default,,0000,0000,0000,,Mau bắt thằng bé lại!
Dialogue: 0,0:06:28.86,0:06:29.99,Default,,0000,0000,0000,,Nhanh lên!
Dialogue: 0,0:06:41.11,0:06:42.74,Default,,0000,0000,0000,,Đừng bao giờ\Nmất cảnh giác.
Dialogue: 0,0:06:43.68,0:06:46.05,Default,,0000,0000,0000,,Cảm ơn cậu.\NCậu đã giúp tôi một tay rồi.
Dialogue: 0,0:06:54.72,0:06:57.06,Default,,0000,0000,0000,,Không sao đâu.\NThằng bé chỉ ngủ thôi.
Dialogue: 0,0:06:58.03,0:06:59.02,Default,,0000,0000,0000,,Ra là vậy.
Dialogue: 0,0:07:12.44,0:07:14.41,Default,,0000,0000,0000,,Chuyện vừa rồi\Nlà sao thế ạ?
Dialogue: 0,0:07:14.68,0:07:20.34,Default,,0000,0000,0000,,Quy định ở đây là trò chỉ được kết nối mạng ngoài\Ndưới sự giám sát của nhân viên.
Dialogue: 0,0:07:20.95,0:07:24.79,Default,,0000,0000,0000,,Thêm nữa, hôm qua phòng này lại bị mất mạng,
Dialogue: 0,0:07:24.79,0:07:26.95,Default,,0000,0000,0000,,nên chắc thằng bé có hơi hoảng loạn một chút.
Dialogue: 0,0:07:27.72,0:07:28.75,Default,,0000,0000,0000,,Xin mời cậu ngồi.
Dialogue: 0,0:07:31.46,0:07:32.69,Default,,0000,0000,0000,,Vâng, thưa cô...
Dialogue: 0,0:07:34.66,0:07:37.27,Default,,0000,0000,0000,,Thằng bé đó rất câu nệ quy tắc,
Dialogue: 0,0:07:37.27,0:07:40.30,Default,,0000,0000,0000,,đặc biệt là những việc như phân chia lượt và thời gian biểu.
Dialogue: 0,0:07:40.30,0:07:42.96,Default,,0000,0000,0000,,Nhưng cách cô xử lý thằng bé\Ntrông có vẻ hơi quá tay thì phải.
Dialogue: 0,0:07:43.81,0:07:45.77,Default,,0000,0000,0000,,Người ngoài khi nghe đến \"Hội chứng Vỏ bọc Não điện tử\",
Dialogue: 0,0:07:45.77,0:07:49.57,Default,,0000,0000,0000,,họ thường hình dung đó là những kẻ\Nkhông thể thích nghi với công nghệ não điện tử.
Dialogue: 0,0:07:49.78,0:07:52.78,Default,,0000,0000,0000,,Nhưng vấn đề thực sự là chúng lại\N{\i1}quá tương thích{\i0} với nó.
Dialogue: 0,0:07:52.78,0:07:54.87,Default,,0000,0000,0000,,Quá tương thích sao?
Dialogue: 0,0:07:55.32,0:07:56.69,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:07:56.69,0:08:01.82,Default,,0000,0000,0000,,Mỗi khi muốn nối mạng,\Nchúng sẽ cố bám víu lấy kết nối bằng mọi giá.
Dialogue: 0,0:08:02.16,0:08:04.63,Default,,0000,0000,0000,,Và khi kết nối với một ai đó cụ thể,
Dialogue: 0,0:08:04.73,0:08:08.39,Default,,0000,0000,0000,,chúng thậm chí sẽ lặn sâu vào não đối phương để chia sẻ tâm thức,
Dialogue: 0,0:08:08.70,0:08:12.93,Default,,0000,0000,0000,,hoặc thậm chí bị thiêu rụi đến chết\Nbởi rào tấn công của người đó.
Dialogue: 0,0:08:13.47,0:08:16.24,Default,,0000,0000,0000,,Cũng có những đứa tự nhốt mình sau hàng rào chắn,
Dialogue: 0,0:08:16.24,0:08:21.90,Default,,0000,0000,0000,,từ chối kết nối với bất kỳ ai,\Nvà rồi vĩnh viễn không thể quay trở lại.
Dialogue: 0,0:08:24.45,0:08:30.04,Default,,0000,0000,0000,,Bọn trẻ ở đây mắc phải các triệu chứng nặng như thế.\NBuổi chiều chúng sẽ sinh hoạt ở khu phòng này.
Dialogue: 0,0:08:34.09,0:08:38.25,Default,,0000,0000,0000,,Để ngăn những tai nạn đó, việc cách ly\Nchúng khỏi mạng là điều tối cần thiết.
Dialogue: 0,0:08:39.36,0:08:43.20,Default,,0000,0000,0000,,Đó là để bảo vệ {\i1}chính bản thân chúng{\i0},\Ncũng như bảo vệ người khác.
Dialogue: 0,0:08:47.94,0:08:50.03,Default,,0000,0000,0000,,Đó là mục đích hoạt động\Ncủa cơ sở này, đúng không ạ?
Dialogue: 0,0:08:50.44,0:08:55.74,Default,,0000,0000,0000,,Nhưng đứa nào ở đây cũng có khả năng thổi bay\Nhàng rào giả lập như thằng bé lúc nãy sao?
Dialogue: 0,0:08:56.18,0:08:59.41,Default,,0000,0000,0000,,Về chuyện đó... Cậu hãy xem thứ này,\Nrồi cậu sẽ hiểu thôi.
Dialogue: 0,0:09:02.45,0:09:05.28,Default,,0000,0000,0000,,Theo một nghĩa nào đó, nơi này\Nchính là một khu vực nguy hiểm.
Dialogue: 0,0:09:21.70,0:09:23.91,Default,,0000,0000,0000,,Một số trường hợp Hội chứng Vỏ bọc Não điện tử...
Dialogue: 0,0:09:23.91,0:09:25.93,Default,,0000,0000,0000,,...kèm theo những biến chứng\Ndẫn đến suy giảm trí tuệ,
Dialogue: 0,0:09:26.18,0:09:28.54,Default,,0000,0000,0000,,nhưng cũng có không ít trường hợp bệnh nhân...
Dialogue: 0,0:09:28.54,0:09:31.14,Default,,0000,0000,0000,,...lại bộc lộ thiên phú đáng kinh ngạc trong không gian mạng.
Dialogue: 0,0:09:36.15,0:09:40.05,Default,,0000,0000,0000,,Chúng tôi tận dụng đặc điểm bệnh lý của chúng\Nvào việc đào tạo nghề...
Dialogue: 0,0:09:40.36,0:09:43.02,Default,,0000,0000,0000,,...bằng cách để chúng lập trình\Ncác mê cung rào chắn bảo mật.
Dialogue: 0,0:09:43.73,0:09:49.63,Default,,0000,0000,0000,,Đôi khi chúng tạo ra những rào chắn phi thường\Nđến mức được các cơ quan chính phủ áp dụng.
Dialogue: 0,0:09:50.30,0:09:53.53,Default,,0000,0000,0000,,Từng cái một đều được xây dựng\Ntheo phương thức vô cùng độc đáo.
Dialogue: 0,0:09:54.27,0:09:57.80,Default,,0000,0000,0000,,Nếu để mặc chúng, tôi e là bọn trẻ này\Nsẽ cặm cụi suốt ngày mà không biết chán,
Dialogue: 0,0:09:58.24,0:10:01.90,Default,,0000,0000,0000,,hết lắp ghép các mê cung rào chắn,\Nlại tìm cách tháo dỡ chúng ra.
Dialogue: 0,0:10:14.29,0:10:16.79,Default,,0000,0000,0000,,Được rồi, tôi nghĩ cậu cũng đã xem qua\Nhầu hết những gì cần xem rồi đấy.
Dialogue: 0,0:10:16.79,0:10:18.38,Default,,0000,0000,0000,,Hử? À, vâng, thưa cô...
Dialogue: 0,0:10:19.16,0:10:22.86,Default,,0000,0000,0000,,Tạm thời tôi sẽ giao cho cậu phụ trách\Nmột phòng nhóm nhé.
Dialogue: 0,0:10:23.50,0:10:26.60,Default,,0000,0000,0000,,Đây là Aoi.\NThằng bé sẽ là một trong những học viên cậu phụ trách.
Dialogue: 0,0:10:26.60,0:10:27.30,Default,,0000,0000,0000,,Vâng, thưa cô.
Dialogue: 0,0:10:27.30,0:10:30.97,Default,,0000,0000,0000,,Tôi nghĩ những đứa trẻ khác đã quay về phòng rồi,\Ncậu hãy đưa thằng bé về nhập hội cùng chúng đi.
Dialogue: 0,0:10:31.37,0:10:32.64,Default,,0000,0000,0000,,Vâng, thưa cô.
Dialogue: 0,0:10:38.08,0:10:40.48,Default,,0000,0000,0000,,\"Aoi\" hả?\NRất vui được gặp nhóc.
Dialogue: 0,0:10:53.73,0:10:55.82,Default,,0000,0000,0000,,Sao lâu thế hả Aoi?\NCậu đã đi đâu...
Dialogue: 0,0:10:57.10,0:11:00.00,Default,,0000,0000,0000,,Chào các em, anh là Togusa. Từ hôm nay anh sẽ\Nchăm sóc các em nhé.
Dialogue: 0,0:11:01.74,0:11:02.83,Default,,0000,0000,0000,,Rất vui được gặp các em.
Dialogue: 0,0:11:11.51,0:11:13.98,Default,,0000,0000,0000,,Này, hay là chúng ta ra ngoài\Nchơi ném bóng bắt bóng đi?
Dialogue: 0,0:11:14.52,0:11:15.92,Default,,0000,0000,0000,,Ngoài trời vẫn còn sáng mà.
Dialogue: 0,0:11:16.85,0:11:20.69,Default,,0000,0000,0000,,Này, trả lại cho cậu ấy đi!\NAnh làm cậu ấy hoảng sợ rồi đấy!
Dialogue: 0,0:11:24.73,0:11:25.69,Default,,0000,0000,0000,,Ồ.
Dialogue: 0,0:11:32.43,0:11:35.53,Default,,0000,0000,0000,,Hễ không cầm găng bắt bóng,\Nlà cậu ấy sẽ bắt đầu hoảng loạn đấy.
Dialogue: 0,0:11:36.10,0:11:39.84,Default,,0000,0000,0000,,Với lại, chẳng ai muốn ra ngoài đâu,\Nkhông bao giờ nữa.
Dialogue: 0,0:11:45.21,0:11:48.44,Default,,0000,0000,0000,,Mấy đứa ở đây không bị\Nngược đãi gì chứ?
Dialogue: 0,0:11:51.65,0:11:54.95,Default,,0000,0000,0000,,Này, Thủ lĩnh bảo\Nanh ấy sắp đến nữa đấy!
Dialogue: 0,0:11:56.22,0:11:57.23,Default,,0000,0000,0000,,Thật sao?
Dialogue: 0,0:11:57.23,0:11:59.02,Default,,0000,0000,0000,,Ừ, tớ vừa nghe nói xong!
Dialogue: 0,0:11:59.53,0:12:02.02,Default,,0000,0000,0000,,Lạ thật, anh ấy mới\Nở đây tuần trước mà!
Dialogue: 0,0:12:02.40,0:12:03.42,Default,,0000,0000,0000,,Tuần trước sao?
Dialogue: 0,0:12:04.57,0:12:06.56,Default,,0000,0000,0000,,\"Thủ lĩnh\" này là ai thế?
Dialogue: 0,0:12:06.84,0:12:08.77,Default,,0000,0000,0000,,Khôn ngoan đấy, ông anh!
Dialogue: 0,0:12:10.54,0:12:11.70,Default,,0000,0000,0000,,Sao thế?
Dialogue: 0,0:12:12.21,0:12:15.87,Default,,0000,0000,0000,,Bọn em vẫn chưa biết anh có phải\Nngười lớn đáng tin cậy hay không.
Dialogue: 0,0:12:16.98,0:12:18.11,Default,,0000,0000,0000,,À, ra vậy...
Dialogue: 0,0:12:18.11,0:12:21.14,Default,,0000,0000,0000,,Nên bọn em không thể bạ đâu\Nnói hết với anh được.
Dialogue: 0,0:12:21.52,0:12:22.85,Default,,0000,0000,0000,,Quy tắc ở đây\Nnghiêm ngặt thật đấy nhỉ?
Dialogue: 0,0:12:22.85,0:12:23.91,Default,,0000,0000,0000,,Anh nghĩ thế nào chứ?
Dialogue: 0,0:12:24.35,0:12:26.65,Default,,0000,0000,0000,,Thế để tớ đi\Nbáo cho những người khác nhé!
Dialogue: 0,0:12:26.79,0:12:27.65,Default,,0000,0000,0000,,Được thôi!
Dialogue: 0,0:12:37.57,0:12:39.19,Default,,0000,0000,0000,,Cậu ta đến muộn thật đấy...
Dialogue: 0,0:12:40.24,0:12:42.17,Default,,0000,0000,0000,,Ồ, cậu đang lo lắng à?
Dialogue: 0,0:12:43.27,0:12:44.43,Default,,0000,0000,0000,,Lo cái con khỉ!
Dialogue: 0,0:12:45.64,0:12:49.17,Default,,0000,0000,0000,,Cậu ta ngố như thế, tôi chỉ sợ cậu ta\Nlỡ làm lộ thân phận hay gì thôi.
Dialogue: 0,0:12:51.31,0:12:52.75,Default,,0000,0000,0000,,{\i1}Anh bảo ai ngố hả?!{\i0}
Dialogue: 0,0:12:52.75,0:12:54.78,Default,,0000,0000,0000,,Đến muộn thế!\NLàm gì mà lâu vậy?
Dialogue: 0,0:12:54.78,0:12:58.15,Default,,0000,0000,0000,,{\i1}À thì, thiết lập đường truyền mà không để lại{\i0}\N{\i1}dấu vết cũng khá rắc rối đấy.{\i0}
Dialogue: 0,0:12:58.75,0:13:01.96,Default,,0000,0000,0000,,{\i1}Dù sao thì đây cũng là nơi duy nhất{\i0}\N{\i1}có đường dây nối ra bên ngoài.{\i0}
Dialogue: 0,0:13:01.96,0:13:02.82,Default,,0000,0000,0000,,{\i1}Thế nào rồi?{\i0}
Dialogue: 0,0:13:03.06,0:13:05.59,Default,,0000,0000,0000,,{\i1}Trung tâm đang sử dụng các bệnh nhân{\i0}\N{\i1}mắc Hội chứng Vỏ bọc Não điện tử...{\i0}
Dialogue: 0,0:13:05.59,0:13:09.62,Default,,0000,0000,0000,,{\i1}... để lập trình và phá dỡ{\i0}\N{\i1}các mê cung rào chắn.{\i0}
Dialogue: 0,0:13:10.20,0:13:12.50,Default,,0000,0000,0000,,{\i1}Nếu có ai đó ở đây{\i0}\N{\i1}lợi dụng kỹ thuật của bọn trẻ,{\i0}
Dialogue: 0,0:13:13.24,0:13:16.73,Default,,0000,0000,0000,,{\i1}thì có thể lý giải được trình độ hack siêu đẳng{\i0}\N{\i1}vào Bộ Y tế và Phúc lợi.{\i0}
Dialogue: 0,0:13:17.31,0:13:19.71,Default,,0000,0000,0000,,{\i1}Tôi hiểu rồi... Vậy có nghi phạm nào chưa?{\i0}
Dialogue: 0,0:13:20.28,0:13:21.64,Default,,0000,0000,0000,,{\i1}Chưa, vẫn chưa có.{\i0}
Dialogue: 0,0:13:22.94,0:13:26.68,Default,,0000,0000,0000,,{\i1}Nhưng cơ sở này kỳ lạ lắm. Họ thậm chí còn có{\i0}\N{\i1}cả một cyborg trang bị vũ trang hạng nặng đi lại tự do.{\i0}
Dialogue: 0,0:13:27.02,0:13:29.95,Default,,0000,0000,0000,,Rõ rồi.\NTiếp tục điều tra đi.
Dialogue: 0,0:13:29.95,0:13:30.95,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:13:30.95,0:13:33.94,Default,,0000,0000,0000,,{\i1}À, Thiếu tá? Có một chuyện khác{\i0}\N{\i1}khiến tôi bận tâm.{\i0}
Dialogue: 0,0:13:34.19,0:13:35.22,Default,,0000,0000,0000,,Chuyện gì?
Dialogue: 0,0:13:35.22,0:13:37.19,Default,,0000,0000,0000,,{\i1}Cô nghĩ \"Thủ lĩnh\"{\i0}\N{\i1}là ai thế?{\i0}
Dialogue: 0,0:13:38.03,0:13:40.65,Default,,0000,0000,0000,,\"Thủ lĩnh\" sao?\NÝ cậu là \"kẻ cầm đầu\"?
Dialogue: 0,0:13:41.10,0:13:44.20,Default,,0000,0000,0000,,{\i1}Vâng, đó là cái tên mà bọn trẻ{\i0}\N{\i1}ở trung tâm nhắc tới.{\i0}
Dialogue: 0,0:13:44.20,0:13:46.36,Default,,0000,0000,0000,,{\i1}Chúng bảo tuần trước{\i0}\N{\i1}người đó có đến đây.{\i0}
Dialogue: 0,0:13:46.47,0:13:50.34,Default,,0000,0000,0000,,Rõ rồi. Tạm thời chúng ta sẽ phân tích ngữ âm\Nvà chạy tìm kiếm danh tính.
Dialogue: 0,0:13:50.87,0:13:53.84,Default,,0000,0000,0000,,{\i1}Cậu hãy thu thập mọi thông tin có thể{\i0}\N{\i1}về hắn trước lần báo cáo tới nhé.{\i0}
Dialogue: 0,0:13:54.41,0:13:55.38,Default,,0000,0000,0000,,{\i1}Rõ.{\i0}
Dialogue: 0,0:14:02.12,0:14:05.71,Default,,0000,0000,0000,,{\i1}Hóa ra ngoài mình ra,{\i0}\N{\i1}còn có người khác dùng thứ này sao?{\i0}
Dialogue: 0,0:14:08.86,0:14:16.79,Default,,0000,0000,0000,,\"Tôi nghĩ mình sẽ làm thế này, giả vờ như\Nmình là một kẻ câm điếc. Liệu có nên không?\"
Dialogue: 0,0:14:17.00,0:14:18.40,Default,,0000,0000,0000,,Cái quái gì thế này?
Dialogue: 0,0:14:25.94,0:14:27.24,Default,,0000,0000,0000,,Tranh sơn dầu sao?
Dialogue: 0,0:14:33.85,0:14:36.22,Default,,0000,0000,0000,,Chà, tuyệt vời thật đấy.
Dialogue: 0,0:14:40.89,0:14:42.41,Default,,0000,0000,0000,,Trông chẳng khác nào\Nmột bức ảnh chụp.
Dialogue: 0,0:14:43.46,0:14:45.89,Default,,0000,0000,0000,,Nhưng em không vẽ\Nhoàn thiện nốt phần mặt à?
Dialogue: 0,0:14:48.06,0:14:50.36,Default,,0000,0000,0000,,Em có biết gì\Nvề người tên \"Thủ lĩnh\" không?
Dialogue: 0,0:14:51.17,0:14:56.83,Default,,0000,0000,0000,,Tôi sẽ tạo ra một thế giới tươi đẹp.\NTôi sẽ nhìn thấu qua một tâm thức mới.
Dialogue: 0,0:15:06.35,0:15:07.45,Default,,0000,0000,0000,,Chào buổi sáng.
Dialogue: 0,0:15:07.45,0:15:10.85,Default,,0000,0000,0000,,Gì nữa đây? Nghe này, tôi sẽ không\Nnói cho anh biết về Thủ lĩnh đâu.
Dialogue: 0,0:15:10.85,0:15:12.19,Default,,0000,0000,0000,,Ừ, anh biết rồi.
Dialogue: 0,0:15:12.19,0:15:14.49,Default,,0000,0000,0000,,Anh đã bao giờ thấy thứ gì như thế chưa?
Dialogue: 0,0:15:14.92,0:15:16.95,Default,,0000,0000,0000,,Đẹp đến nghẹn lời, đúng không?
Dialogue: 0,0:15:17.33,0:15:19.73,Default,,0000,0000,0000,,Mấy đứa đọc được cả chương trình\Ntrực quan hóa ảo này sao?
Dialogue: 0,0:15:20.20,0:15:22.30,Default,,0000,0000,0000,,Sao thế, anh {\i1}không đọc được{\i0} à?
Dialogue: 0,0:15:22.30,0:15:23.16,Default,,0000,0000,0000,,Không.
Dialogue: 0,0:15:23.73,0:15:27.07,Default,,0000,0000,0000,,Thế thì cắm nối vào não\Ncủa cậu ấy đi.
Dialogue: 0,0:15:29.34,0:15:31.24,Default,,0000,0000,0000,,Anh sẽ được thấy những thứ cực hay ho đấy.
Dialogue: 0,0:15:33.84,0:15:35.24,Default,,0000,0000,0000,,Nhưng mà cẩn thận nhé.
Dialogue: 0,0:15:35.68,0:15:39.58,Default,,0000,0000,0000,,Từng có một nhân viên\Nlặn vào đầu cậu ấy rồi.
Dialogue: 0,0:15:39.58,0:15:42.21,Default,,0000,0000,0000,,Ý thức của họ bị rối vào nhau,\Nvà người đó mắc kẹt luôn trong đó tới tận bây giờ.
Dialogue: 0,0:15:42.68,0:15:44.17,Default,,0000,0000,0000,,Sao nào, dám thử không?
Dialogue: 0,0:15:53.50,0:15:55.59,Default,,0000,0000,0000,,Thôi, tốt nhất là không nên.
Dialogue: 0,0:15:55.90,0:15:57.57,Default,,0000,0000,0000,,Chán anh thật đấy.
Dialogue: 0,0:15:57.57,0:15:59.53,Default,,0000,0000,0000,,Em cứ tưởng anh\Nphải gan dạ hơn cơ.
Dialogue: 0,0:16:04.04,0:16:07.17,Default,,0000,0000,0000,,Này, em nghĩ người tên\N\"Thủ lĩnh\" đó rốt cuộc là ai?
Dialogue: 0,0:16:11.18,0:16:12.94,Default,,0000,0000,0000,,Được rồi, vậy nhé.\NTôi giao lại cho cô đấy.
Dialogue: 0,0:16:13.32,0:16:14.37,Default,,0000,0000,0000,,Vâng, thưa bà.
Dialogue: 0,0:16:16.25,0:16:17.68,Default,,0000,0000,0000,,Ồ, là cậu à.
Dialogue: 0,0:16:18.19,0:16:19.38,Default,,0000,0000,0000,,Chào buổi chiều cô.
Dialogue: 0,0:16:20.86,0:16:21.92,Default,,0000,0000,0000,,Cô ra ngoài ạ?
Dialogue: 0,0:16:21.92,0:16:24.65,Default,,0000,0000,0000,,Phải, tôi đi dự buổi gặp mặt xã giao\Ncủa ngành phúc lợi.
Dialogue: 0,0:16:24.96,0:16:27.26,Default,,0000,0000,0000,,Ồ, vậy sao ạ?\NVậy hẹn gặp lại cô sau nhé.
Dialogue: 0,0:16:42.01,0:16:43.14,Default,,0000,0000,0000,,Xin lỗi nhóc nhé...
Dialogue: 0,0:16:44.71,0:16:47.24,Default,,0000,0000,0000,,Đợi ở đây một lát nhé?\NAnh xong việc ngay đây.
Dialogue: 0,0:16:57.13,0:16:58.56,Default,,0000,0000,0000,,Lại thêm tranh sơn dầu sao?
Dialogue: 0,0:17:13.34,0:17:15.64,Default,,0000,0000,0000,,{\i1}Chẳng có hồ sơ nào khả nghi{\i0}\N{\i1}đáng chú ý cả...{\i0}
Dialogue: 0,0:17:16.28,0:17:19.11,Default,,0000,0000,0000,,{\i1}Tuần trước cũng chẳng có{\i0}\N{\i1}vị khách nào đến thăm sao?{\i0}
Dialogue: 0,0:17:22.75,0:17:27.25,Default,,0000,0000,0000,,{\i1}Chết tiệt, không truy cập được bộ nhớ ngoài{\i0}\N{\i1}đúng là phiền toái kinh khủng...{\i0}
Dialogue: 0,0:17:30.89,0:17:32.12,Default,,0000,0000,0000,,Ôi trời.
Dialogue: 0,0:17:34.80,0:17:38.06,Default,,0000,0000,0000,,Bỏ bê nhiệm vụ chăm sóc người bệnh\Nđể đi làm gián điệp đấy à?
Dialogue: 0,0:17:38.77,0:17:42.76,Default,,0000,0000,0000,,Cậu có lục lọi đằng trời cũng chẳng tìm được\Nmanh mối nào về Thủ lĩnh ở đó đâu.
Dialogue: 0,0:17:43.20,0:17:45.73,Default,,0000,0000,0000,,Đến nước này thì chắc\Nbào chữa cũng vô ích rồi nhỉ?
Dialogue: 0,0:17:48.98,0:17:51.05,Default,,0000,0000,0000,,Đánh cho hắn bị thương, nhưng đừng giết.
Dialogue: 0,0:17:51.05,0:17:51.85,Default,,0000,0000,0000,,Vâng, thưa bà.
Dialogue: 0,0:17:51.85,0:17:53.11,Default,,0000,0000,0000,,Này, khoan đã.
Dialogue: 0,0:17:54.72,0:17:56.62,Default,,0000,0000,0000,,Nếu đánh nhau ở đây,\Nmấy bức tranh này có thể sẽ...
Dialogue: 0,0:17:56.72,0:17:58.48,Default,,0000,0000,0000,,Ngươi định chiến đấu\Nvới {\i1}thứ đó{\i0} sao?
Dialogue: 0,0:18:11.70,0:18:14.67,Default,,0000,0000,0000,,Tôi đã nói rồi, tranh vẽ thì\Nkhông thể thô bạo được.
Dialogue: 0,0:18:20.91,0:18:24.57,Default,,0000,0000,0000,,Không như dữ liệu điện tử,\Ntranh vẽ không thể sao chép được đâu.
Dialogue: 0,0:18:40.86,0:18:43.19,Default,,0000,0000,0000,,Cô đâu nghĩ là tôi\Nkhông mang vũ khí chứ?
Dialogue: 0,0:19:13.36,0:19:15.12,Default,,0000,0000,0000,,Đội 9 Bộ Nội vụ sao?
Dialogue: 0,0:19:23.64,0:19:28.44,Default,,0000,0000,0000,,Thiếu tá, toàn bộ thiết bị đầu cuối trong trung tâm\Nvừa đồng loạt kết nối mạng.
Dialogue: 0,0:19:29.11,0:19:30.51,Default,,0000,0000,0000,,Chắc chắn đã có chuyện xảy ra.
Dialogue: 0,0:19:32.35,0:19:35.34,Default,,0000,0000,0000,,Bọn chúng đang tìm cách giải mã\Nmã truy cập của chúng ta.
Dialogue: 0,0:19:35.88,0:19:37.12,Default,,0000,0000,0000,,Cậu ta bị lộ thân phận rồi sao?
Dialogue: 0,0:19:37.12,0:19:39.61,Default,,0000,0000,0000,,Tôi không rõ.\NCắt toàn bộ mạch mạng ngay lập tức!
Dialogue: 0,0:19:40.92,0:19:42.08,Default,,0000,0000,0000,,Sao lại chậm thế hả?!
Dialogue: 0,0:19:42.49,0:19:44.05,Default,,0000,0000,0000,,T-Tôi bị khóa truy cập rồi!
Dialogue: 0,0:19:46.69,0:19:48.63,Default,,0000,0000,0000,,Batou, chúng ta phải đến lôi\NTogusa ra khỏi đó ngay!
Dialogue: 0,0:19:48.86,0:19:49.80,Default,,0000,0000,0000,,Rõ rồi!
Dialogue: 0,0:19:49.80,0:19:51.53,Default,,0000,0000,0000,,{\i1}Ishikawa, chiếm quyền kiểm soát{\i0}\N{\i1}các mạch mạng của trung tâm!{\i0}
Dialogue: 0,0:19:51.80,0:19:53.10,Default,,0000,0000,0000,,{\i1}Saito, bảo đảm đường rút lui!{\i0}
Dialogue: 0,0:20:03.31,0:20:06.14,Default,,0000,0000,0000,,Bắt được rồi nhé! Tao vừa nướng chín con AI rình mò kia rồi!
Dialogue: 0,0:20:07.52,0:20:08.50,Default,,0000,0000,0000,,Kuroha!
Dialogue: 0,0:20:08.95,0:20:11.51,Default,,0000,0000,0000,,Kìa, Thủ lĩnh!\NAnh đã ở đâu suốt thế?
Dialogue: 0,0:20:12.25,0:20:13.82,Default,,0000,0000,0000,,Tình hình xấu đi rồi.
Dialogue: 0,0:20:13.82,0:20:15.88,Default,,0000,0000,0000,,Anh đã bị người bên ngoài phát hiện.
Dialogue: 0,0:20:16.56,0:20:21.05,Default,,0000,0000,0000,,Sắp tới sẽ có rất nhiều người lớn kéo đến.\NAnh phải biến mất trước lúc đó.
Dialogue: 0,0:20:21.40,0:20:25.26,Default,,0000,0000,0000,,Hả? Nhưng tại sao chứ?\NTừ trước đến nay mọi chuyện vẫn êm đẹp mà!
Dialogue: 0,0:20:25.90,0:20:27.66,Default,,0000,0000,0000,,Bọn em sẽ bảo vệ anh,\Nnhư mọi khi!
Dialogue: 0,0:20:27.80,0:20:32.30,Default,,0000,0000,0000,,Không được. Đã đến lúc\Nanh phải rời khỏi nơi này rồi.
Dialogue: 0,0:20:32.94,0:20:37.21,Default,,0000,0000,0000,,Khoan đã! Có phải anh định xóa sạch\Nmọi ký ức của bọn em rồi mới rời đi không?
Dialogue: 0,0:20:37.21,0:20:38.20,Default,,0000,0000,0000,,Tóm được chúng rồi!
Dialogue: 0,0:20:38.65,0:20:40.74,Default,,0000,0000,0000,,Anh xin lỗi, nhưng đúng là vậy.
Dialogue: 0,0:20:41.18,0:20:46.71,Default,,0000,0000,0000,,Ôi... Vậy là bọn em sẽ không bao giờ được cổ vũ\Ncho anh ở Thành phố Ảo Alpha nữa rồi.
Dialogue: 0,0:20:49.12,0:20:52.86,Default,,0000,0000,0000,,Em hiểu rồi.\NNhưng bọn em không muốn quên anh đâu.
Dialogue: 0,0:20:53.73,0:20:55.66,Default,,0000,0000,0000,,Hãy để lại cho bọn em thứ gì đó\Nđể làm kỷ niệm đi anh.
Dialogue: 0,0:20:56.43,0:20:59.26,Default,,0000,0000,0000,,Anh sẽ để lại.\NAnh hứa đấy.
Dialogue: 0,0:21:14.18,0:21:15.21,Default,,0000,0000,0000,,Togusa!
Dialogue: 0,0:21:19.62,0:21:20.88,Default,,0000,0000,0000,,Này! Togusa!
Dialogue: 0,0:21:21.29,0:21:23.19,Default,,0000,0000,0000,,Togusa! Rốt cuộc chuyện quái gì\Nđã xảy ra ở đây thế hả, Togusa?!
Dialogue: 0,0:21:24.23,0:21:25.99,Default,,0000,0000,0000,,Chết tiệt, Togusa, tỉnh lại đi!
Dialogue: 0,0:21:26.93,0:21:28.19,Default,,0000,0000,0000,,Togusa!
Dialogue: 0,0:21:28.83,0:21:33.53,Default,,0000,0000,0000,,Vậy có bằng chứng nào cho thấy thằng nhóc \"Aoi\"\Nmà Togusa nhắc đến thực sự tồn tại không?
Dialogue: 0,0:21:34.04,0:21:36.00,Default,,0000,0000,0000,,Tôi không tìm thấy bất cứ thứ gì.
Dialogue: 0,0:21:36.37,0:21:40.74,Default,,0000,0000,0000,,Có khả năng máy tính của trung tâm\Nvà ký ức của nhân viên đã bị can thiệp chỉnh sửa,
Dialogue: 0,0:21:41.38,0:21:44.50,Default,,0000,0000,0000,,nhưng tôi không thể đào sâu hơn được vì tất cả\Nnhững gì chúng ta có chỉ là lời khai của Togusa.
Dialogue: 0,0:21:45.08,0:21:48.62,Default,,0000,0000,0000,,Còn bức chân dung mà cậu ta bảo\Ndo đứa con gái khác vẽ thì sao?
Dialogue: 0,0:21:48.62,0:21:50.48,Default,,0000,0000,0000,,Chúng tôi cũng chẳng tìm thấy nó.
Dialogue: 0,0:21:50.62,0:21:53.82,Default,,0000,0000,0000,,Ồ, hèn gì cậu ta lại muốn\Nnộp một bản phác thảo làm báo cáo sao?
Dialogue: 0,0:21:53.82,0:21:58.28,Default,,0000,0000,0000,,Ừ, một thiếu niên tuấn tú ngồi trên xe lăn\Nvới chiếc găng bắt bóng dành cho người thuận tay trái...
Dialogue: 0,0:21:58.99,0:22:02.39,Default,,0000,0000,0000,,Cậu ta bảo sẽ vẽ lại từ những ký ức\Ntrong chính não điện tử của mình.
Dialogue: 0,0:22:02.90,0:22:05.43,Default,,0000,0000,0000,,Găng bắt bóng tay trái sao?
Dialogue: 0,0:22:05.43,0:22:09.94,Default,,0000,0000,0000,,Theo thuật ngữ mạng, điều đó ám chỉ thứ gì đó\N{\i1}ngỡ như{\i0} có thật, nhưng thực ra lại không hề tồn tại.
Dialogue: 0,0:22:09.94,0:22:11.43,Default,,0000,0000,0000,,Cậu có chắc về điều đó không?
Dialogue: 0,0:22:12.34,0:22:13.77,Default,,0000,0000,0000,,Xin lỗi vì tôi đến trễ, Thiếu tá.
Dialogue: 0,0:22:13.94,0:22:18.17,Default,,0000,0000,0000,,Đưa đây xem nào! Tôi muốn xem thử liệu người này\Ncó giúp chúng ta xóa tội cho vụ bê bối này của cậu không.
Dialogue: 0,0:22:18.65,0:22:21.14,Default,,0000,0000,0000,,Khi nhìn thấy đừng kinh ngạc nhé.\NĐây là tác phẩm để đời của tôi đấy.
Dialogue: 0,0:22:27.82,0:22:28.91,Default,,0000,0000,0000,,Cái quái gì thế này?
Dialogue: 0,0:22:30.12,0:22:35.06,Default,,0000,0000,0000,,Cậu mò đến một nơi quái đản rồi quay về\Nvới một đống ký ức cũng quái đản không kém...
Dialogue: 0,0:22:35.06,0:22:37.06,Default,,0000,0000,0000,,{\fad(300,300)\an8}Phụ đề Việt ngữ: Amtia(NOFACE)
