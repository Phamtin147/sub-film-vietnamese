Dialogue: 0,0:01:57.89,0:02:00.76,Default,,0000,0000,0000,,Này... Có ai ở đó không?\NDậy đi nào!
Dialogue: 0,0:02:01.56,0:02:06.90,Default,,0000,0000,0000,,Ai cũng đồng bộ sau mỗi nhiệm vụ,\Nsao chỉ có mỗi mình em là không được nhỉ?
Dialogue: 0,0:02:12.17,0:02:14.23,Default,,0000,0000,0000,,Dầu tự nhiên của anh Batou!
Dialogue: 0,0:02:34.33,0:02:38.13,Default,,0000,0000,0000,,Tuyệt quá đi!\NChứa đầy ắp thông tin luôn!
Dialogue: 0,0:03:00.29,0:03:03.99,Default,,0000,0000,0000,,Tuyệt diệu thật đấy! Điểm kinh nghiệm\Ncủa mình đang tăng vù vù này!
Dialogue: 0,0:03:15.77,0:03:17.17,Default,,0000,0000,0000,,Locky ơi!
Dialogue: 0,0:03:23.28,0:03:25.54,Default,,0000,0000,0000,,Này, bạn có thấy Locky đâu không?
Dialogue: 0,0:03:26.28,0:03:27.48,Default,,0000,0000,0000,,\"Locky\" sao?
Dialogue: 0,0:03:35.02,0:03:38.08,Default,,0000,0000,0000,,Locky là tên chú chó\Nmình nuôi làm thú cưng.
Dialogue: 0,0:03:39.06,0:03:40.69,Default,,0000,0000,0000,,Nhưng nó bị lạc mất rồi...
Dialogue: 0,0:03:41.73,0:03:43.86,Default,,0000,0000,0000,,Nuôi... Bị lạc...
Dialogue: 0,0:03:45.50,0:03:46.63,Default,,0000,0000,0000,,Xin lỗi nhé, tớ không giúp được cậu rồi.
Dialogue: 0,0:03:47.10,0:03:48.87,Default,,0000,0000,0000,,Bạn đi tìm nó\Ncùng mình được không?
Dialogue: 0,0:03:49.21,0:03:52.17,Default,,0000,0000,0000,,Nhưng mà tớ đang tính\Nđi vào trong phố cơ.
Dialogue: 0,0:03:52.54,0:03:56.98,Default,,0000,0000,0000,,Tớ định băng qua thị trấn\Nđể đến Công viên Đồi Ngắm Biển.
Dialogue: 0,0:03:57.68,0:04:00.24,Default,,0000,0000,0000,,Mình nghĩ chắc nó\Nở quanh quẩn đâu đó gần đấy.
Dialogue: 0,0:04:02.89,0:04:05.72,Default,,0000,0000,0000,,Được rồi, chúng ta đi cùng nhau nhé,\Nnhưng chỉ đến thị trấn thôi đấy.
Dialogue: 0,0:04:06.09,0:04:08.25,Default,,0000,0000,0000,,Thật ư?! Cảm ơn bạn nhé!
Dialogue: 0,0:04:08.99,0:04:12.69,Default,,0000,0000,0000,,Này, tên bạn là gì thế?\NTên mình là Miki.
Dialogue: 0,0:04:13.06,0:04:14.50,Default,,0000,0000,0000,,Tớ là Tachikoma.
Dialogue: 0,0:04:14.50,0:04:15.83,Default,,0000,0000,0000,,Tachikoma sao?
Dialogue: 0,0:04:18.27,0:04:20.13,Default,,0000,0000,0000,,Rất vui được gặp bạn,\NTachikoma.
Dialogue: 0,0:04:57.51,0:05:01.94,Default,,0000,0000,0000,,Chắc Locky đói lắm rồi,\Nmình sẽ mua một cái cho nó ăn.
Dialogue: 0,0:05:11.49,0:05:14.56,Default,,0000,0000,0000,,Tớ... không nghĩ đó\Nlà ý hay đâu.
Dialogue: 0,0:05:14.56,0:05:15.68,Default,,0000,0000,0000,,Sao lại không?
Dialogue: 0,0:05:16.09,0:05:16.96,Default,,0000,0000,0000,,Ừm...
Dialogue: 0,0:05:19.80,0:05:22.46,Default,,0000,0000,0000,,Con chó đằng kia\Ntrông giống Locky không?
Dialogue: 0,0:05:30.57,0:05:32.77,Default,,0000,0000,0000,,Thế con chó này có phải Locky không?
Dialogue: 0,0:05:33.28,0:05:36.87,Default,,0000,0000,0000,,Không, Locky đâu có gầy gò\Nnhư con chó đằng kia.
Dialogue: 0,0:05:37.21,0:05:38.08,Default,,0000,0000,0000,,Ồ.
Dialogue: 0,0:05:41.72,0:05:44.48,Default,,0000,0000,0000,,Này, Tachikoma!\NÁc thế!
Dialogue: 0,0:05:45.02,0:05:47.76,Default,,0000,0000,0000,,Ác sao? Nhưng cậu\Nđâu có cần con chó đó.
Dialogue: 0,0:05:47.76,0:05:49.12,Default,,0000,0000,0000,,Nó đâu phải là Locky.
Dialogue: 0,0:05:49.12,0:05:52.90,Default,,0000,0000,0000,,Dù không phải Locky, nhưng bạn không được\Nđối xử xấu với nó như thế! Hiểu chưa hả?
Dialogue: 0,0:05:52.90,0:05:55.36,Default,,0000,0000,0000,,Tớ đâu có xấu tính với nó.\NChỉ là tớ không cần nó thôi mà.
Dialogue: 0,0:05:55.60,0:05:58.69,Default,,0000,0000,0000,,Nếu bạn còn làm thế lần nữa,\Nlà mình giận thật đấy!
Dialogue: 0,0:06:19.89,0:06:22.58,Default,,0000,0000,0000,,Hử? Cái gì thế này?
Dialogue: 0,0:06:23.33,0:06:26.26,Default,,0000,0000,0000,,Linh tính mách bảo đây\Nlà một phát hiện phi thường nha!
Dialogue: 0,0:06:32.57,0:06:35.06,Default,,0000,0000,0000,,Ối chà chà!\NLà một bộ não điện tử này!
Dialogue: 0,0:06:35.80,0:06:38.17,Default,,0000,0000,0000,,Ơ? Nhưng nó lại\Nchẳng hề có rào chắn bảo vệ...
Dialogue: 0,0:06:38.61,0:06:42.44,Default,,0000,0000,0000,,Chẳng lẽ đây là phiên bản của chúng ta\Ngiống như con người...
Dialogue: 0,0:06:42.44,0:06:44.74,Default,,0000,0000,0000,,...khi sắp chết sẽ thấy cả cuộc đời\Nlướt qua trước mắt sao?
Dialogue: 0,0:06:45.88,0:06:49.99,Default,,0000,0000,0000,,Hử? Bạn là tôi sao?\NVà tôi là tất cả các bạn?
Dialogue: 0,0:06:49.99,0:06:51.92,Default,,0000,0000,0000,,C-Có một Ghost ở đây!
Dialogue: 0,0:06:51.92,0:06:53.72,Default,,0000,0000,0000,,Bạn đang làm gì đấy,\NTachikoma?
Dialogue: 0,0:06:55.76,0:06:57.82,Default,,0000,0000,0000,,Dạ, không có gì đâu ạ.
Dialogue: 0,0:06:59.26,0:07:02.36,Default,,0000,0000,0000,,Tachikoma! Vừa rồi bạn lấy trộm\Ncái gì đúng không?!
Dialogue: 0,0:07:03.23,0:07:06.00,Default,,0000,0000,0000,,Lấy đồ mà không xin phép\Nlà ăn cắp đấy nhé!
Dialogue: 0,0:07:06.77,0:07:08.90,Default,,0000,0000,0000,,Không ngoan ngoãn là bị\Nxích lại bây giờ!
Dialogue: 0,0:07:09.77,0:07:12.01,Default,,0000,0000,0000,,Mau đưa thứ bạn đang giấu\Nra đây xem nào!
Dialogue: 0,0:07:12.01,0:07:13.50,Default,,0000,0000,0000,,Xin lỗi cháu bé.
Dialogue: 0,0:07:14.68,0:07:17.04,Default,,0000,0000,0000,,Cháu đang làm gì\Nở một nơi như thế này?
Dialogue: 0,0:07:17.68,0:07:20.94,Default,,0000,0000,0000,,Cháu có mang theo thứ gì\Nchứng minh danh tính không?
Dialogue: 0,0:07:22.32,0:07:24.05,Default,,0000,0000,0000,,Đây là robot thú cưng của cháu à?
Dialogue: 0,0:07:26.09,0:07:28.15,Default,,0000,0000,0000,,Bé con, nhà cháu ở đâu?
Dialogue: 0,0:07:29.56,0:07:34.96,Default,,0000,0000,0000,,Này hai anh kia, nhìn tôi thế này thôi\Nnhưng tôi là người giám hộ hợp pháp của con bé đấy.
Dialogue: 0,0:07:35.40,0:07:38.77,Default,,0000,0000,0000,,Hồi chiến tranh, tôi bị trúng đạn\Ncủa quân địch trọng thương suýt chết.
Dialogue: 0,0:07:38.77,0:07:43.17,Default,,0000,0000,0000,,Não của tôi tạm thời được đặt vào cỗ xe tăng này\Nđể cấp cứu, nhưng rồi dính liền luôn với nó.
Dialogue: 0,0:07:43.51,0:07:45.27,Default,,0000,0000,0000,,Kể từ đó đến nay\Ntôi vẫn mang hình hài này.
Dialogue: 0,0:07:45.51,0:07:48.94,Default,,0000,0000,0000,,Dám gọi một người yêu nước hy sinh thân mình\Nvì tổ quốc là \"thú cưng\"...
Dialogue: 0,0:07:49.21,0:07:53.05,Default,,0000,0000,0000,,...là cực kỳ {\i1}vô lễ{\i0} đấy nhé!
Dialogue: 0,0:07:53.45,0:07:57.35,Default,,0000,0000,0000,,- Mấy thằng nhãi ranh chưa từng trải qua mùi khói súng như các cậu...\N- T-Tôi hiểu rồi. Được rồi thưa ông.
Dialogue: 0,0:08:01.49,0:08:03.79,Default,,0000,0000,0000,,Đỉnh thật đấy!\NVừa rồi là thuật nói tiếng bụng à?
Dialogue: 0,0:08:03.79,0:08:05.06,Default,,0000,0000,0000,,Đại loại là thế.
Dialogue: 0,0:08:05.06,0:08:09.02,Default,,0000,0000,0000,,Này, chúng ta thử đến \"Công viên Đồi Ngắm Biển\"\Nmà bạn vừa nói xem sao đi.
Dialogue: 0,0:08:09.10,0:08:11.00,Default,,0000,0000,0000,,Hở? Bạn chịu đi cùng mình thật ư?
Dialogue: 0,0:08:11.53,0:08:14.80,Default,,0000,0000,0000,,Ừ. Ở đây chẳng còn gì\Nthú vị nữa cả.
Dialogue: 0,0:08:15.00,0:08:17.20,Default,,0000,0000,0000,,Chắc Locky đang đợi\Nở đó nhỉ?
Dialogue: 0,0:08:17.61,0:08:20.07,Default,,0000,0000,0000,,Đúng rồi!\NCảm ơn bạn nhiều nhé, Tachikoma!
Dialogue: 0,0:08:27.92,0:08:32.68,Default,,0000,0000,0000,,Locky sống cùng nhà với mình\Ntừ lúc mình mới sinh ra cơ.
Dialogue: 0,0:08:33.76,0:08:39.16,Default,,0000,0000,0000,,Nó luôn chơi cùng mình,\Năn cùng mình và ngủ trên giường mình.
Dialogue: 0,0:08:39.63,0:08:42.79,Default,,0000,0000,0000,,Chà, hai bạn thân nhau thật đấy.
Dialogue: 0,0:08:43.20,0:08:44.17,Default,,0000,0000,0000,,Ừ!
Dialogue: 0,0:08:44.17,0:08:47.19,Default,,0000,0000,0000,,Nhưng sao Locky lại\Nchạy lung tung rồi lạc mất thế?
Dialogue: 0,0:08:47.47,0:08:49.94,Default,,0000,0000,0000,,Lúc nào nó cũng ở cạnh bạn cơ mà,\Nphải không Miki?
Dialogue: 0,0:08:50.44,0:08:51.60,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:08:54.48,0:08:58.97,Default,,0000,0000,0000,,Này Tachikoma, bạn có biết câu chuyện\N\"Con cá vàng bí mật\" không?
Dialogue: 0,0:08:59.35,0:09:01.94,Default,,0000,0000,0000,,Con cá vàng bí mật sao?\NKhông biết.
Dialogue: 0,0:09:02.52,0:09:06.82,Default,,0000,0000,0000,,Đó là câu chuyện mà nhân vật chính\Nlà một cô bé tầm trạc tuổi mình.
Dialogue: 0,0:09:07.59,0:09:08.69,Default,,0000,0000,0000,,Một câu chuyện à?
Dialogue: 0,0:09:08.69,0:09:09.55,Default,,0000,0000,0000,,Ừ.
Dialogue: 0,0:09:10.39,0:09:15.42,Default,,0000,0000,0000,,Câu chuyện kể về một cô bé không muốn\Ncho ai khác nhìn thấy con cá vàng của mình.
Dialogue: 0,0:09:16.16,0:09:20.07,Default,,0000,0000,0000,,Khi mọi người hỏi tại sao cô bé không muốn\Ncho ai xem con cá vàng,
Dialogue: 0,0:09:20.37,0:09:23.24,Default,,0000,0000,0000,,cô bé bảo là vì nó được mua\Nbằng chính tiền tiết kiệm của cô.
Dialogue: 0,0:09:23.64,0:09:29.24,Default,,0000,0000,0000,,Thế nên người lớn ai cũng lo lắng cho cô bé,\Ntự nhủ: \"Ôi, con bé ngốc nghếch làm sao.\"
Dialogue: 0,0:09:29.61,0:09:32.71,Default,,0000,0000,0000,,Nhưng thật ra con cá vàng đã chết\Ntừ rất lâu rồi,
Dialogue: 0,0:09:32.88,0:09:39.05,Default,,0000,0000,0000,,và để người lớn không phát hiện ra,\Ncô bé nhất quyết không để ai nhìn thấy nó.
Dialogue: 0,0:09:39.42,0:09:44.38,Default,,0000,0000,0000,,Hừm, tớ chẳng hiểu gì cả.\NÝ tớ là, con cá vàng chết rồi cơ mà?
Dialogue: 0,0:09:45.16,0:09:48.53,Default,,0000,0000,0000,,Thế thì chỉ cần lấy tiền tiêu vặt\Nhoặc gì đó đem sửa lại như mới là xong thôi.
Dialogue: 0,0:09:48.90,0:09:50.73,Default,,0000,0000,0000,,Không đơn giản\Nnhư thế đâu.
Dialogue: 0,0:09:50.73,0:09:53.83,Default,,0000,0000,0000,,Một khi cá vàng chết đi,\Nnó sẽ không bao giờ quay lại nữa.
Dialogue: 0,0:09:55.24,0:10:02.44,Default,,0000,0000,0000,,Cô bé không muốn người lớn nghĩ rằng mình\Nsẽ đau buồn chỉ vì con cá vàng chết.
Dialogue: 0,0:10:03.21,0:10:06.44,Default,,0000,0000,0000,,Cô bé đã đau lòng\Nquá đủ rồi.
Dialogue: 0,0:10:41.02,0:10:43.35,Default,,0000,0000,0000,,Chính là... cái này, đúng không?
Dialogue: 0,0:10:47.79,0:10:50.88,Default,,0000,0000,0000,,Thực ra, mình đã biết từ đầu rồi.
Dialogue: 0,0:10:51.36,0:10:55.32,Default,,0000,0000,0000,,Hôm thứ Năm khi mình đi nhà trẻ về,\NLocky không còn ở nhà nữa.
Dialogue: 0,0:10:55.53,0:10:58.00,Default,,0000,0000,0000,,Nó đã ốm yếu\Ntừ lâu rồi,
Dialogue: 0,0:10:58.30,0:11:01.17,Default,,0000,0000,0000,,nhưng bố mẹ lại bảo\Nlà nó đã đi ra ngoài chơi.
Dialogue: 0,0:11:02.27,0:11:05.90,Default,,0000,0000,0000,,Hôm thứ Sáu với thứ Bảy mình đòi đi tìm Locky,
Dialogue: 0,0:11:06.48,0:11:08.64,Default,,0000,0000,0000,,thì bố mẹ đều gạt đi.
Dialogue: 0,0:11:10.15,0:11:16.31,Default,,0000,0000,0000,,Nên dù biết rõ Locky đã chết,\Nmình vẫn giả vờ đi tìm nó.
Dialogue: 0,0:11:16.65,0:11:21.21,Default,,0000,0000,0000,,Nếu không làm vậy, bố mẹ\Nsẽ nhận ra là mình đã biết sự thật.
Dialogue: 0,0:11:23.96,0:11:28.99,Default,,0000,0000,0000,,Con người đau lòng thật đấy\Nkhi một người bạn thân thiết chết đi, phải không?
Dialogue: 0,0:11:29.90,0:11:32.33,Default,,0000,0000,0000,,Tớ không hiểu được\Nkhái niệm \"cái chết\".
Dialogue: 0,0:11:32.80,0:11:34.89,Default,,0000,0000,0000,,Chắc là vì tớ\Nkhông có Ghost chăng,
Dialogue: 0,0:11:35.37,0:11:37.70,Default,,0000,0000,0000,,nhưng tớ cũng chẳng thể hiểu nổi\Nkhái niệm \"nỗi buồn\".
Dialogue: 0,0:11:38.41,0:11:41.27,Default,,0000,0000,0000,,Có lẽ là vì\Ntớ không thể chết được.
Dialogue: 0,0:11:42.78,0:11:44.37,Default,,0000,0000,0000,,Bạn không bao giờ chết sao, Tachikoma?
Dialogue: 0,0:11:45.01,0:11:46.98,Default,,0000,0000,0000,,Không hề! Vì tớ là một AI mà.
Dialogue: 0,0:11:46.98,0:11:49.32,Default,,0000,0000,0000,,Kể cả khi mình nuôi bạn\Nnhư thú cưng sao?
Dialogue: 0,0:11:49.32,0:11:50.29,Default,,0000,0000,0000,,Không luôn.
Dialogue: 0,0:11:50.29,0:11:51.92,Default,,0000,0000,0000,,Kể cả khi bạn bị\Nxe hơi cán qua?
Dialogue: 0,0:11:51.92,0:11:53.05,Default,,0000,0000,0000,,Vẫn không.
Dialogue: 0,0:11:53.62,0:11:54.68,Default,,0000,0000,0000,,Vậy à...
Dialogue: 0,0:11:55.12,0:11:59.08,Default,,0000,0000,0000,,Dù sao thì, chắc mình cũng chẳng muốn\Nnuôi thêm con thú cưng nào nữa đâu...
Dialogue: 0,0:12:02.96,0:12:06.20,Default,,0000,0000,0000,,Có lẽ bạn nên\Nquay về nhà đi thôi...
Dialogue: 0,0:12:07.00,0:12:10.30,Default,,0000,0000,0000,,Bố mẹ bạn chắc sẽ buồn lắm\Nkhi không thấy bạn ở nhà đấy, Miki.
Dialogue: 0,0:12:10.84,0:12:11.90,Default,,0000,0000,0000,,Ừ...
Dialogue: 0,0:12:40.47,0:12:43.50,Default,,0000,0000,0000,,Tôi mong là các cậu đừng làm bộ mặt nghiêm trọng thế.
Dialogue: 0,0:12:43.84,0:12:45.74,Default,,0000,0000,0000,,Đâu phải là tôi bỏ trốn hay...
Dialogue: 0,0:12:45.74,0:12:46.80,Default,,0000,0000,0000,,Trật tự đi!
Dialogue: 0,0:12:47.34,0:12:52.61,Default,,0000,0000,0000,,Có dấu hiệu cho thấy một lượng nhỏ\Nprotein dùng trong các vi mạch thần kinh...
Dialogue: 0,0:12:52.61,0:12:57.42,Default,,0000,0000,0000,,...của con AI Tachikoma chuyên dụng đã bị hòa tan\Nvào loại dầu tự nhiên mà cậu đã tra vào cho nó đấy.
Dialogue: 0,0:12:59.35,0:13:03.76,Default,,0000,0000,0000,,Tất cả là do cậu cứ dùng khư khư\Nriêng con Tachikoma này đấy, Batou.
Dialogue: 0,0:13:04.19,0:13:07.32,Default,,0000,0000,0000,,Có khả năng dữ liệu rò rỉ vào dầu tích tụ dần theo thời gian,
Dialogue: 0,0:13:07.63,0:13:12.59,Default,,0000,0000,0000,,và con AI của Tachikoma đã tái hiện lại\Nhành vi đó dựa trên lượng thông tin này.
Dialogue: 0,0:13:14.20,0:13:17.17,Default,,0000,0000,0000,,Cậu không nên quá cưng chiều\Ncon Tachikoma đó như thế, Batou.
Dialogue: 0,0:13:17.81,0:13:19.64,Default,,0000,0000,0000,,Chúng chỉ là máy móc thôi.
Dialogue: 0,0:13:19.91,0:13:23.08,Default,,0000,0000,0000,,- Lời lẽ phân biệt đối xử kìa!\N- Chúng tôi yêu cầu rút lại lời nói!
Dialogue: 0,0:13:23.08,0:13:24.84,Default,,0000,0000,0000,,Anh Togusa là đồ định kiến!
Dialogue: 0,0:13:25.41,0:13:27.35,Default,,0000,0000,0000,,Máy móc cũng cần tình yêu thương chứ bộ!
Dialogue: 0,0:13:28.48,0:13:32.72,Default,,0000,0000,0000,,Vụ này mà xảy ra ở Viện Nghiên cứu Trí tuệ Nhân tạo\Nthì thành tin chấn động rồi,
Dialogue: 0,0:13:33.22,0:13:35.92,Default,,0000,0000,0000,,nhưng nếu Thiếu tá mà phát hiện ra\Nthì cô ấy sẽ xé xác cậu ra thành trăm mảnh đấy.
Dialogue: 0,0:13:35.92,0:13:37.29,Default,,0000,0000,0000,,Liệu mà thu dọn đồ đạc đi.
Dialogue: 0,0:13:38.26,0:13:39.75,Default,,0000,0000,0000,,Ủa? Cái quái gì {\i1}đây?{\i0}
Dialogue: 0,0:13:40.36,0:13:41.59,Default,,0000,0000,0000,,Kìa, cái đó là...!
Dialogue: 0,0:13:47.00,0:13:48.70,Default,,0000,0000,0000,,Chúc Thiếu tá một buổi sáng tốt lành ạ!
Dialogue: 0,0:13:49.64,0:13:51.61,Default,,0000,0000,0000,,Nịnh bợ cũng vô ích thôi.
Dialogue: 0,0:13:51.61,0:13:54.70,Default,,0000,0000,0000,,Kể từ bây giờ, nghiêm cấm tuyệt đối\Nviệc sử dụng dầu tự nhiên.
Dialogue: 0,0:13:54.94,0:13:56.10,Default,,0000,0000,0000,,Rõ chưa hả, Batou?
Dialogue: 0,0:13:56.44,0:13:59.11,Default,,0000,0000,0000,,Còn Togusa, đem cái hộp đó\Nsang phòng thí nghiệm tội phạm đi.
Dialogue: 0,0:13:59.61,0:14:01.48,Default,,0000,0000,0000,,Ishikawa, tôi muốn cậu qua đó\Ngiám sát với tư cách quan sát viên.
Dialogue: 0,0:14:02.38,0:14:03.54,Default,,0000,0000,0000,,Huhu...
Dialogue: 0,0:14:04.82,0:14:08.19,Default,,0000,0000,0000,,Lộ tẩy hết rồi.\NBà chị đó lúc nào cũng trên cơ tất cả.
Dialogue: 0,0:14:08.46,0:14:10.33,Default,,0000,0000,0000,,Không hiểu sao cô ấy lại biết được nhỉ?
Dialogue: 0,0:14:10.33,0:14:11.02,Default,,0000,0000,0000,,Rõ.
Dialogue: 0,0:14:14.80,0:14:18.82,Default,,0000,0000,0000,,Kỳ lạ thật đấy. Không ngờ nó\Nlại luôn kết nối trực tuyến suốt thời gian qua.
Dialogue: 0,0:14:19.10,0:14:21.97,Default,,0000,0000,0000,,Thứ bên trong cái hộp đó\Nnguy hiểm đến thế cơ à?
Dialogue: 0,0:14:22.87,0:14:26.17,Default,,0000,0000,0000,,Cậu chuyên viên này lặn vào đó từ nãy\Nmà đến giờ vẫn chưa chịu trồi lên.
Dialogue: 0,0:14:26.81,0:14:30.68,Default,,0000,0000,0000,,Tôi lần dấu được một đoạn, nhưng rồi\Nđột nhiên bị mất liên lạc hoàn toàn.
Dialogue: 0,0:14:31.71,0:14:34.55,Default,,0000,0000,0000,,Rốt cuộc thứ này {\i1}là gì{\i0}\Nhả Thiếu tá?
Dialogue: 0,0:14:35.32,0:14:38.78,Default,,0000,0000,0000,,Có dấu hiệu cho thấy khi con Tachikoma\Ntìm thấy thứ này và truy cập vào nội dung bên trong,
Dialogue: 0,0:14:39.12,0:14:44.75,Default,,0000,0000,0000,,nó đã lập tức đồng bộ với AI của Tachikoma\Nvà xả một lượng lớn dữ liệu vào trong đó.
Dialogue: 0,0:14:45.56,0:14:49.76,Default,,0000,0000,0000,,Tôi từng nghĩ đây là một dạng chương trình tẩy não,\Nnhưng thực tế lại không phải.
Dialogue: 0,0:14:50.43,0:14:53.09,Default,,0000,0000,0000,,Tôi cũng từng ngờ tới\Nmột mê cung phòng vệ,
Dialogue: 0,0:14:53.64,0:14:56.13,Default,,0000,0000,0000,,nhưng chương trình sao lưu của chúng ta\Nvẫn hoạt động hoàn hảo...
Dialogue: 0,0:14:56.64,0:14:59.71,Default,,0000,0000,0000,,...và hoàn toàn không có dấu hiệu cho thấy\Nnão bộ của chuyên viên này...
Dialogue: 0,0:14:59.71,0:15:02.11,Default,,0000,0000,0000,,...bị tấn công hay xảy ra hiện tượng xung ngược\Ndo chương trình gây ra.
Dialogue: 0,0:15:02.54,0:15:04.94,Default,,0000,0000,0000,,Ý cô là anh ta không {\i1}muốn{\i0}\Nquay trở lại sao?
Dialogue: 0,0:15:05.28,0:15:07.84,Default,,0000,0000,0000,,Tôi chưa thể khẳng định\Nđược điều gì cả.
Dialogue: 0,0:15:08.22,0:15:10.28,Default,,0000,0000,0000,,Thực sự khả năng dính virus\Nhoàn toàn bằng không sao?
Dialogue: 0,0:15:10.85,0:15:12.82,Default,,0000,0000,0000,,Cho tôi xem các bản ghi\Ntruy vết của cậu xem.
Dialogue: 0,0:15:20.70,0:15:25.33,Default,,0000,0000,0000,,Có vẻ như anh ta đang tiếp nhận cảm giác\Nnhư thể đang đứng trong một tòa nhà nào đó.
Dialogue: 0,0:15:26.37,0:15:28.77,Default,,0000,0000,0000,,Cậu thấy đoạn anh ta lẩm bẩm\Nvề một hành lang dài ngoằng không?
Dialogue: 0,0:15:29.27,0:15:32.30,Default,,0000,0000,0000,,Và anh ta bảo có một cầu thang\Nnằm ở cuối hành lang.
Dialogue: 0,0:15:33.07,0:15:34.70,Default,,0000,0000,0000,,Để tôi lặn vào đó\Nkhảo sát một vòng xem sao.
Dialogue: 0,0:15:35.34,0:15:38.90,Default,,0000,0000,0000,,Này, khoan đã! Tôi nghĩ cô nên đợi\Ncho đến khi có lệnh phê duyệt của Sếp!
Dialogue: 0,0:15:39.08,0:15:41.01,Default,,0000,0000,0000,,Lỡ tình huống xấu nhất\Nxảy ra thì sao?
Dialogue: 0,0:15:41.28,0:15:43.08,Default,,0000,0000,0000,,Nó đã xảy ra rồi.
Dialogue: 0,0:15:43.45,0:15:46.25,Default,,0000,0000,0000,,Nếu một chuyên viên điều tra của {\i1}chúng ta{\i0} còn không quay lại được,\Nthì chuyện này đủ nghiêm trọng rồi.
Dialogue: 0,0:15:47.29,0:15:48.52,Default,,0000,0000,0000,,Kết nối tôi vào đi!
Dialogue: 0,0:15:57.57,0:15:59.47,Default,,0000,0000,0000,,Hiển thị hình ảnh hoàn tất.
Dialogue: 0,0:15:59.70,0:16:02.26,Default,,0000,0000,0000,,Đối với một khung cảnh tẻ nhạt thế này,\Nlượng dữ liệu quả là nhiều đến kinh ngạc.
Dialogue: 0,0:16:03.94,0:16:08.77,Default,,0000,0000,0000,,Còn cái hành lang này nữa... Người tạo ra nó thật khéo léo\Nkhi chỉ cho phép người ta đi thẳng về phía trước.
Dialogue: 0,0:16:09.95,0:16:11.78,Default,,0000,0000,0000,,Ngoài cái hành lang đó ra\Nthì chẳng còn gì khác sao?
Dialogue: 0,0:16:12.15,0:16:13.51,Default,,0000,0000,0000,,Hiện tại thì là vậy.
Dialogue: 0,0:16:16.15,0:16:19.55,Default,,0000,0000,0000,,Tôi thật sự muốn cô nhắm mắt lại đấy,\NNàng Bạch Tuyết ngủ trong rừng ạ.
Dialogue: 0,0:16:20.39,0:16:22.69,Default,,0000,0000,0000,,Tôi thấy cầu thang rồi!\NTôi đang đi xuống.
Dialogue: 0,0:16:24.13,0:16:27.93,Default,,0000,0000,0000,,Nhớ để mắt canh chừng bẫy đấy!\NSự an toàn của Thiếu tá là ưu tiên hàng đầu.
Dialogue: 0,0:16:28.16,0:16:29.97,Default,,0000,0000,0000,,Tôi thấy một ánh sáng lờ mờ.
Dialogue: 0,0:16:29.97,0:16:32.23,Default,,0000,0000,0000,,Và... Dù rất yếu ớt,\Nnhưng tôi nghe thấy có tiếng người nói.
Dialogue: 0,0:16:34.34,0:16:35.10,Default,,0000,0000,0000,,Cái gì thế này...?
Dialogue: 0,0:16:35.10,0:16:36.26,Default,,0000,0000,0000,,Khoan đã! Thiếu tá!
Dialogue: 0,0:16:36.74,0:16:38.40,Default,,0000,0000,0000,,Này, Thiếu tá!\NTrả lời đi!
Dialogue: 0,0:16:38.74,0:16:39.41,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:16:39.41,0:16:41.47,Default,,0000,0000,0000,,Vô ích thôi. Ý thức của cô ấy\Nđã rời khỏi thể xác rồi.
Dialogue: 0,0:16:41.84,0:16:43.04,Default,,0000,0000,0000,,Bị Ghost Hack sao?!
Dialogue: 0,0:16:43.48,0:16:46.11,Default,,0000,0000,0000,,Không, là một thứ khác.\NKhông hề có bất kỳ cuộc tấn công nào.
Dialogue: 0,0:16:46.88,0:16:48.68,Default,,0000,0000,0000,,Hàng rào bảo mật của cô ấy cũng không kích hoạt.
Dialogue: 0,0:16:50.65,0:16:51.64,Default,,0000,0000,0000,,Thiếu tá!
Dialogue: 0,0:16:51.75,0:16:52.98,Default,,0000,0000,0000,,{\i1}Thiếu tá!{\i0}
Dialogue: 0,0:16:55.12,0:16:58.99,Default,,0000,0000,0000,,Những câu thoại trong phân cảnh trước đó\Nđã xua tan nỗi tuyệt vọng tột cùng trong lòng anh ấy...
Dialogue: 0,0:16:58.99,0:17:02.96,Default,,0000,0000,0000,,...và tạo nên một động lực sâu sắc\Ncho anh ấy về sau.
Dialogue: 0,0:17:02.96,0:17:06.47,Default,,0000,0000,0000,,Tôi thì không nghĩ thế. Tôi cho rằng đó là khoảnh khắc\Nanh ấy quyết định...
Dialogue: 0,0:17:06.47,0:17:10.96,Default,,0000,0000,0000,,...sống mãi mãi như một sự giác ngộ\Nkhi chạm vào Chân lý.
Dialogue: 0,0:17:11.57,0:17:13.01,Default,,0000,0000,0000,,Các người đang làm gì\Nở đây thế hả?
Dialogue: 0,0:17:15.28,0:17:16.04,Default,,0000,0000,0000,,Này!
Dialogue: 0,0:17:16.04,0:17:22.64,Default,,0000,0000,0000,,Mất công vô ích thôi. Tất cả mọi người ở đây\Nđều đã hoàn toàn bị nó mê hoặc rồi.
Dialogue: 0,0:17:22.88,0:17:25.38,Default,,0000,0000,0000,,Bị mê hoặc sao?\NBị thứ {\i1}gì{\i0} mê hoặc cơ chứ?
Dialogue: 0,0:17:25.79,0:17:26.91,Default,,0000,0000,0000,,{\i1}\"Nó\"{\i0} là cái gì?
Dialogue: 0,0:17:28.62,0:17:32.58,Default,,0000,0000,0000,,Cô có muốn ngồi xuống đây\Nvà tự mình chiêm ngưỡng không?
Dialogue: 0,0:17:37.57,0:17:38.83,Default,,0000,0000,0000,,Cái... Này!
Dialogue: 0,0:17:40.10,0:17:42.19,Default,,0000,0000,0000,,Nếu không nhanh lên,\Ncô sẽ bỏ lỡ phần mở đầu đấy.
Dialogue: 0,0:17:42.64,0:17:44.50,Default,,0000,0000,0000,,Bộ phim này không có\Nchiếu đoạn giới thiệu đâu.
Dialogue: 0,0:17:55.42,0:17:56.98,Default,,0000,0000,0000,,Một rạp chiếu phim sao?
Dialogue: 0,0:17:59.99,0:18:02.62,Default,,0000,0000,0000,,Này, cậu bị làm sao thế?\NỞ đây đã xảy ra chuyện gì?
Dialogue: 0,0:18:02.92,0:18:05.62,Default,,0000,0000,0000,,Ồ, chào Thiếu tá.\NTrùng hợp thật đấy.
Dialogue: 0,0:18:05.86,0:18:08.00,Default,,0000,0000,0000,,Bộ phim này tuyệt vời quá đỗi...
Dialogue: 0,0:18:08.00,0:18:10.12,Default,,0000,0000,0000,,Đi thôi, chúng ta phải rời khỏi đây!\NNày!
Dialogue: 0,0:18:47.44,0:18:48.60,Default,,0000,0000,0000,,Cô thấy thế nào?
Dialogue: 0,0:18:49.00,0:18:51.63,Default,,0000,0000,0000,,Tôi phải thừa nhận,\Nđó không phải là một bộ phim tồi.
Dialogue: 0,0:18:52.14,0:18:55.54,Default,,0000,0000,0000,,Nhưng mọi trò giải trí tiêu khiển\Nvề bản chất chỉ mang tính tạm thời.
Dialogue: 0,0:18:55.54,0:18:57.31,Default,,0000,0000,0000,,Hoặc ít nhất chúng {\i1}phải nên{\i0} là như thế.
Dialogue: 0,0:18:57.78,0:18:59.55,Default,,0000,0000,0000,,Thế nhưng một bộ phim không có\Nđiểm bắt đầu cũng chẳng có hồi kết...
Dialogue: 0,0:18:59.55,0:19:03.01,Default,,0000,0000,0000,,chỉ giữ chân khán giả mê mẩn\Nmà không bao giờ chịu buông tha...
Dialogue: 0,0:19:03.55,0:19:07.58,Default,,0000,0000,0000,,Nó thật độc hại, cho dù ông có nghĩ\Nnó tuyệt diệu đến mức nào đi chăng nữa.
Dialogue: 0,0:19:08.19,0:19:10.09,Default,,0000,0000,0000,,Chà, cô quả là một nhà phê bình khó tính...
Dialogue: 0,0:19:10.43,0:19:14.99,Default,,0000,0000,0000,,Ý cô là ngoài kia vẫn còn một thực tại\Nmà những khán giả như chúng tôi nên quay về sao?
Dialogue: 0,0:19:15.53,0:19:16.93,Default,,0000,0000,0000,,Phải, đúng vậy.
Dialogue: 0,0:19:18.13,0:19:20.12,Default,,0000,0000,0000,,Với một số người\Nngồi dưới hàng ghế khán giả kia,
Dialogue: 0,0:19:20.47,0:19:24.67,Default,,0000,0000,0000,,nỗi bất hạnh đang chực chờ họ\Nngay khoảnh khắc họ quay về với thực tại.
Dialogue: 0,0:19:25.51,0:19:30.27,Default,,0000,0000,0000,,Cô có thể gánh vác trách nhiệm vì đã tước đoạt\Nnhững giấc mơ của những con người ấy không?
Dialogue: 0,0:19:30.48,0:19:31.91,Default,,0000,0000,0000,,Không, tôi không thể.
Dialogue: 0,0:19:32.18,0:19:35.64,Default,,0000,0000,0000,,Nhưng giấc mơ chỉ có ý nghĩa {\i1}bởi vì{\i0}\Nông đang đấu tranh vì nó giữa đời thực.
Dialogue: 0,0:19:36.68,0:19:40.81,Default,,0000,0000,0000,,Chỉ biết đắm chìm và phóng chiếu bản thân vào giấc mơ của kẻ khác\Nchẳng khác nào một kẻ đã chết.
Dialogue: 0,0:19:41.82,0:19:43.52,Default,,0000,0000,0000,,Tôi thấy cô là một người theo chủ nghĩa thực tế.
Dialogue: 0,0:19:44.16,0:19:47.09,Default,,0000,0000,0000,,Nếu kẻ lãng mạn là kẻ chuyên trốn chạy\Nkhỏi thực tại, thì đúng là vậy.
Dialogue: 0,0:19:48.16,0:19:50.32,Default,,0000,0000,0000,,Cô quả là một cô gái mạnh mẽ...
Dialogue: 0,0:19:50.67,0:19:54.62,Default,,0000,0000,0000,,Nếu thực tại mà cô hằng tin tưởng\Nthực sự xuất hiện, hãy gọi cho tôi.
Dialogue: 0,0:19:55.20,0:19:58.66,Default,,0000,0000,0000,,Khi ngày đó đến,\Nchúng tôi sẽ rời khỏi rạp chiếu này.
Dialogue: 0,0:20:05.58,0:20:07.98,Default,,0000,0000,0000,,Trời đất, vừa nãy cô làm tôi\Nhú vía đấy...
Dialogue: 0,0:20:08.18,0:20:12.55,Default,,0000,0000,0000,,Xin lỗi nhé. Tôi đã gặp chút khó khăn\Nkhi chọc thủng Ghost Line của nó.
Dialogue: 0,0:20:12.55,0:20:14.45,Default,,0000,0000,0000,,Tôi không có thời gian\Nđể nói chuyện đâu.
Dialogue: 0,0:20:14.99,0:20:17.15,Default,,0000,0000,0000,,À thì, chúng tôi đã đối chiếu\Nhồ sơ lưu trữ rồi.
Dialogue: 0,0:20:17.63,0:20:22.72,Default,,0000,0000,0000,,Wataru Kannazuki, một đạo diễn điện ảnh\Nhầu như chẳng mấy ai biết tới.
Dialogue: 0,0:20:23.10,0:20:25.90,Default,,0000,0000,0000,,Ông ta dường như quá bảo thủ trong việc giữ gìn\Nchất nghệ thuật cá nhân của mình...
Dialogue: 0,0:20:25.90,0:20:30.17,Default,,0000,0000,0000,,...đến mức chẳng bao giờ kiếm được kinh phí hay đoàn làm phim,\Nthế nên chưa từng phát hành một bộ phim đại chúng nào.
Dialogue: 0,0:20:30.61,0:20:34.56,Default,,0000,0000,0000,,Hẳn là ông ta muốn tạo ra bộ phim lý tưởng nhất,\Ndù chỉ là bên trong chính não điện tử của mình.
Dialogue: 0,0:20:35.51,0:20:37.51,Default,,0000,0000,0000,,Tôi đoán ông ta đã cắt bỏ não\Nvà một phần tủy sống của mình,
Dialogue: 0,0:20:37.51,0:20:42.21,Default,,0000,0000,0000,,gắn vào hệ thống duy trì sự sống,\Nrồi tự nhốt mình vĩnh viễn trong chiếc hộp này.
Dialogue: 0,0:20:42.95,0:20:45.55,Default,,0000,0000,0000,,Nói cách khác, ý anh là\Nchiếc hộp này là một rạp chiếu phim thu nhỏ...
Dialogue: 0,0:20:45.55,0:20:48.45,Default,,0000,0000,0000,,...chứa trọn vẹn bộ phim\Ncủa vị đạo diễn đó sao?
Dialogue: 0,0:20:48.79,0:20:50.78,Default,,0000,0000,0000,,Đại loại là thế đấy.
Dialogue: 0,0:20:51.16,0:20:52.96,Default,,0000,0000,0000,,Thế đó là loại\Nphim như thế nào?
Dialogue: 0,0:20:56.13,0:20:59.26,Default,,0000,0000,0000,,Có người nói ông ta có\Nmột nhóm tín đồ cuồng nhiệt.
Dialogue: 0,0:20:59.83,0:21:02.07,Default,,0000,0000,0000,,Nhưng vì có vẻ như từng có những người\Nquá mê mẩn bộ phim này...
Dialogue: 0,0:21:02.07,0:21:06.01,Default,,0000,0000,0000,,...đến mức họ đã chết sau khi lặn vào những chiếc hộp đó\Nmà không bao giờ tỉnh lại nữa,
Dialogue: 0,0:21:06.64,0:21:09.30,Default,,0000,0000,0000,,nên cảnh sát đã đi khắp nơi\Nđể tịch thu toàn bộ chúng.
Dialogue: 0,0:21:09.68,0:21:12.74,Default,,0000,0000,0000,,Có tin đồn rằng bản gốc\Nvẫn còn trôi nổi trên thị trường,
Dialogue: 0,0:21:13.15,0:21:16.55,Default,,0000,0000,0000,,và nhìn xem,\N{\i1}đây{\i0} chính là bản gốc đấy.
Dialogue: 0,0:21:17.09,0:21:19.05,Default,,0000,0000,0000,,Trong này có cả Ghost\Nvà đủ mọi thứ.
Dialogue: 0,0:21:19.05,0:21:22.35,Default,,0000,0000,0000,,Rốt cuộc con Tachikoma kia\Nkiếm đâu ra thứ này thế không biết?
Dialogue: 0,0:21:22.76,0:21:28.20,Default,,0000,0000,0000,,Điều làm tôi kinh ngạc là chính sức hút nghệ thuật\Ncủa bộ phim đã giữ chân khán giả,
Dialogue: 0,0:21:28.63,0:21:30.23,Default,,0000,0000,0000,,chứ chẳng hề có cạm bẫy hay thủ thuật hack nào cả.
Dialogue: 0,0:21:30.23,0:21:32.20,Default,,0000,0000,0000,,Đúng là một tài năng\Nđáng nể thật.
Dialogue: 0,0:21:37.71,0:21:40.77,Default,,0000,0000,0000,,Vậy chúng ta xử lý thế nào?\NÔng đạo diễn vẫn còn sống đấy.
Dialogue: 0,0:21:43.58,0:21:47.57,Default,,0000,0000,0000,,Tách não ông ta ra khỏi hộp và chuyển sang một lồng bảo quản khác\Nđể ngăn ông ta kết nối mạng.
Dialogue: 0,0:21:48.15,0:21:51.14,Default,,0000,0000,0000,,Lập danh sách những người xem\Nđã hồi phục ý thức nữa.
Dialogue: 0,0:21:51.92,0:21:54.12,Default,,0000,0000,0000,,Ngoài ra, bắt giữ chủ quầy hàng ở chợ trời\Nđã bán chiếc hộp này...
Dialogue: 0,0:21:54.12,0:21:56.11,Default,,0000,0000,0000,,...dưới sự nghi ngờ về hành vi\Nbuôn bán nội tạng cơ thể người.
Dialogue: 0,0:21:56.49,0:21:58.72,Default,,0000,0000,0000,,Tôi sẽ chịu trách nhiệm\Nbáo cáo với Sếp.
Dialogue: 0,0:21:59.06,0:22:00.22,Default,,0000,0000,0000,,Thế nhé.
Dialogue: 0,0:22:09.94,0:22:11.40,Default,,0000,0000,0000,,Này, ngạc nhiên thật đấy!
Dialogue: 0,0:22:12.37,0:22:16.14,Default,,0000,0000,0000,,Batou, đã có bộ phim nào\Ntừng làm cậu rơi nước mắt chưa?
Dialogue: 0,0:22:16.91,0:22:18.85,Default,,0000,0000,0000,,Trời đất, sao tự dưng hỏi\N{\i1}chuyện đó{\i0} thế?
Dialogue: 0,0:22:19.58,0:22:24.18,Default,,0000,0000,0000,,Tôi về nhà chứa máy bay đây.\NPhải đi thay dầu cho con Tachikoma của tôi nữa.
Dialogue: 0,0:22:26.89,0:22:29.05,Default,,0000,0000,0000,,Hình như {\i1}từng có{\i0} một lần,\Ntừ hồi xửa hồi xưa rồi.
Dialogue: 0,0:22:29.32,0:22:33.19,Default,,0000,0000,0000,,Một bộ phim của anh em nhà Marx\Nlàm tôi cười sặc sụa đến chảy cả nước mắt.
Dialogue: 0,0:22:33.76,0:22:35.16,Default,,0000,0000,0000,,Đúng là phong cách của cậu rồi...
Dialogue: 0,0:22:35.83,0:22:39.06,Default,,0000,0000,0000,,Này, tôi có ý này. Hay là hôm nào\Nchúng ta cùng đi xem phim nhé?
Dialogue: 0,0:22:40.97,0:22:41.94,Default,,0000,0000,0000,,Cảm ơn nhé.
Dialogue: 0,0:22:42.27,0:22:45.76,Default,,0000,0000,0000,,Nhưng mỗi khi có bộ phim mà tôi thực sự muốn xem,\Ntôi luôn có thói quen đi xem một mình.
Dialogue: 0,0:22:46.34,0:22:48.91,Default,,0000,0000,0000,,Thế còn những phim mà cô\Nkhông tha thiết xem lắm thì sao?
Dialogue: 0,0:22:48.91,0:22:50.31,Default,,0000,0000,0000,,Tôi sẽ không xem.
Dialogue: 0,0:22:50.98,0:22:52.45,Default,,0000,0000,0000,,Cũng hợp lý.
Dialogue: 0,0:22:52.45,0:22:54.45,Default,,0000,0000,0000,,{\fad(300,300)\an8}Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:16.54,0:23:20.89,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng thật lạnh lùng mà cũng thật con người
Dialogue: 0,0:23:20.89,0:23:23.79,GitS ED Credits,,0000,0000,0000,,{\fad(0,300)}Đó là điều mà con người vẫn làm
Dialogue: 0,0:23:23.79,0:23:26.10,GitS ED Credits,,0000,0000,0000,,Nàng vẫn tỏa sáng rạng ngời trong cô độc
Dialogue: 0,0:23:26.10,0:23:29.16,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Nàng quả đúng là Đội số 9
Dialogue: 0,0:23:29.16,0:23:31.91,GitS ED Credits,,0000,0000,0000,,{\fad(0,500)}Nàng tựa như phép toán diệu kỳ
Dialogue: 0,0:23:33.17,0:23:36.19,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Chỉ là một phép toán diệu kỳ
Dialogue: 0,0:23:36.46,0:23:40.65,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Và liệu nàng có thực sự là con người?
Dialogue: 0,0:23:40.65,0:23:43.94,GitS ED Credits,,0000,0000,0000,,{\fad(0,700)}Nàng tựa như một điều gì đó thật mới mẻ
Dialogue: 0,0:23:43.94,0:23:46.19,GitS ED Credits,,0000,0000,0000,,Một đóa hoa lithium vừa thức giấc
Dialogue: 0,0:23:46.19,0:23:49.05,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Đang chớm nở rộ
Dialogue: 0,0:23:49.14,0:23:51.85,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Tôi đã ngửi thấy mùi lithium
Dialogue: 0,0:23:52.89,0:23:55.97,GitS ED Credits,,0000,0000,0000,,{\fad(0,600)}Nghe thấy mùi lithium quanh đây
Dialogue: 0,0:23:57.14,0:24:01.18,GitS ED Credits,,0000,0000,0000,,{\1c&H5ECC08&\t(\1c&HCB2FE3&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:01.18,0:24:05.01,GitS ED Credits,,0000,0000,0000,,{\1c&HCB2FE3&\t(\1c&H06BDF2&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:05.01,0:24:07.91,GitS ED Credits,,0000,0000,0000,,{\1c&H06BDF2&\t(\1c&H5ECC08&)}Khi không lướt mạng thì nàng thế nào?
Dialogue: 0,0:24:07.91,0:24:12.11,GitS ED Credits,,0000,0000,0000,,{\fad(0,800)}Không biết nàng sẽ làm gì khi tỉnh giấc?
