Dialogue: 0,0:01:32.44,0:01:34.40,Default,,0,0,0,,(Suỵt…)
Dialogue: 0,0:01:37.16,0:01:37.32,Default,,0,0,0,,(Học viện Fujinari, Giáo viên (29), Satomi Hiratsuka)\NThoải mái quá đi…
Dialogue: 0,0:01:37.32,0:01:38.95,Default,,0,0,0,,(Học viện Fujinari, Giáo viên (29), Satomi Hiratsuka)\NThoải mái quá đi…
Dialogue: 0,0:01:39.70,0:01:41.70,Default,,0,0,0,,(Tập 8: Thế Giới Của Satomi)
Dialogue: 0,0:01:49.88,0:01:53.34,Default,,0,0,0,,(Sột soạt)
Dialogue: 0,0:01:55.34,0:01:55.91,Default,,0,0,0,,(Sột soạt)
Dialogue: 0,0:01:55.91,0:01:58.04,Default,,0,0,0,,Tôi đi làm đây!
Dialogue: 0,0:01:58.04,0:02:01.18,Default,,0,0,0,,(Sột soạt)
Dialogue: 0,0:02:01.18,0:02:03.14,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:02:06.73,0:02:07.54,Default,,0,0,0,,(Khu Vực Hút Thuốc)
Dialogue: 0,0:02:07.54,0:02:09.73,Default,,0,0,0,,(Khu Vực Hút Thuốc)\NXin lỗi anh…
Dialogue: 0,0:02:10.08,0:02:12.29,Default,,0,0,0,,Cho tôi xin một điếu thuốc được không?
Dialogue: 0,0:02:12.54,0:02:13.50,Default,,0,0,0,,Đ-Được chứ.
Dialogue: 0,0:02:13.87,0:02:15.00,Default,,0,0,0,,Chà, cô ấy đẹp thật đấy…
Dialogue: 0,0:02:15.02,0:02:15.34,Default,,0,0,0,,(Hội Học Sinh Học Viện Tosei)
Dialogue: 0,0:02:17.62,0:02:19.16,Default,,0,0,0,,Ồ?
Dialogue: 0,0:02:19.23,0:02:19.54,Default,,0,0,0,,(Chân mọc ngay giữa thân)
Dialogue: 0,0:02:19.54,0:02:21.62,Default,,0,0,0,,Cho tôi mượn luôn bật lửa nhé?
Dialogue: 0,0:02:21.87,0:02:23.00,Default,,0,0,0,,Được thôi.
Dialogue: 0,0:02:23.00,0:02:24.29,Default,,0,0,0,,Xinh đẹp thật đấy, nhưng mà…
Dialogue: 0,0:02:25.12,0:02:27.00,Default,,0,0,0,,Đang chơi game à?
Dialogue: 0,0:02:27.25,0:02:28.54,Default,,0,0,0,,Ừm…
Dialogue: 0,0:02:28.70,0:02:30.66,Default,,0,0,0,,Đi đứng nhìn đường vào chứ!
Dialogue: 0,0:02:31.16,0:02:32.37,Default,,0,0,0,,Khe ngực…
Dialogue: 0,0:02:35.08,0:02:36.75,Default,,0,0,0,,Chào buổi sáng!
Dialogue: 0,0:02:37.91,0:02:40.70,Default,,0,0,0,,Chào buổi sáng, cô Hiratsuka.
Dialogue: 0,0:02:40.91,0:02:42.12,Default,,0,0,0,,Lại đi muộn nữa rồi à?
Dialogue: 0,0:02:43.25,0:02:44.33,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:02:44.83,0:02:46.54,Default,,0,0,0,,Hôm nay cũng họp giao ban sáng sao?
Dialogue: 0,0:02:46.54,0:02:48.37,Default,,0,0,0,,Ngày nào chả họp.
Dialogue: 0,0:02:48.37,0:02:49.95,Default,,0,0,0,,Còn cái bàn làm việc của cô thì sao đây?
Dialogue: 0,0:02:50.33,0:02:52.62,Default,,0,0,0,,Để thế kia thì còn ra thể thống gì\Nđể làm gương cho học sinh nữa?
Dialogue: 0,0:02:53.25,0:02:54.41,Default,,0,0,0,,À, cái này ấy hả…
Dialogue: 0,0:02:55.00,0:02:57.37,Default,,0,0,0,,Thực ra sắp xếp kiểu này tiện tay lắm đấy.
Dialogue: 0,0:02:58.04,0:02:59.25,Default,,0,0,0,,Nó sắp sập đến nơi rồi kìa.
Dialogue: 0,0:03:00.12,0:03:01.08,Default,,0,0,0,,Cô Hiratsuka ơi.
Dialogue: 0,0:03:01.08,0:03:04.08,Default,,0,0,0,,Về bộ đề thi các năm trước\Ncủa kỳ thi vòng hai ấy ạ…
Dialogue: 0,0:03:04.08,0:03:05.75,Default,,0,0,0,,Ừ, ừ, để cô xem.
Dialogue: 0,0:03:06.25,0:03:08.12,Default,,0,0,0,,Em làm tốt lắm đấy.
Dialogue: 0,0:03:08.33,0:03:10.79,Default,,0,0,0,,Cô đã tổng hợp sẵn vài bài mẫu\Nvà các ý trọng tâm cho em rồi này.
Dialogue: 0,0:03:11.12,0:03:13.50,Default,,0,0,0,,Tuyệt quá! Em cảm ơn cô ạ!
Dialogue: 0,0:03:14.58,0:03:18.29,Default,,0,0,0,,Hễ đụng tới chuyện của học sinh\Nlà cô chẳng bao giờ lơ là nhỉ?
Dialogue: 0,0:03:18.66,0:03:19.87,Default,,0,0,0,,Có gì to tát đâu.
Dialogue: 0,0:03:20.33,0:03:22.54,Default,,0,0,0,,Dù sao tôi cũng là giáo viên mà.
Dialogue: 0,0:03:22.54,0:03:24.62,Default,,0,0,0,,Cô cũng ra dáng phết đấy chứ…
Dialogue: 0,0:03:26.50,0:03:30.12,Default,,0,0,0,,Trời ơi, nặng thế. Chắc mình ra hơi nhiều\Ncâu hỏi tự luận quá rồi thì phải?
Dialogue: 0,0:03:30.33,0:03:32.20,Default,,0,0,0,,Được rồi, tiếp theo là gì nào…
Dialogue: 0,0:03:32.20,0:03:34.06,Default,,0,0,0,,(Hãy Đi Khám Nha Khoa)\N(Những Bí Ẩn Của Cơ Thể Tuổi Dậy Thì)
Dialogue: 0,0:03:34.66,0:03:38.00,Default,,0,0,0,,Cô đang làm cái gì thế? Tới giờ họp giáo viên rồi!
Dialogue: 0,0:03:38.20,0:03:39.37,Default,,0,0,0,,Tôi đang xem lại giáo án ấy mà.
Dialogue: 0,0:03:39.58,0:03:41.54,Default,,0,0,0,,(Họa Tiết Hôm Nay)
Dialogue: 0,0:03:41.75,0:03:45.16,Default,,0,0,0,,Họp vất vả rồi nhé, cô Hiratsuka!
Dialogue: 0,0:03:45.37,0:03:47.25,Default,,0,0,0,,Cô vừa bận tiết dạy à?
Dialogue: 0,0:03:48.37,0:03:48.91,Default,,0,0,0,,(Thầy Tanaka, Giáo Viên Thể Dục)
Dialogue: 0,0:03:48.91,0:03:52.75,Default,,0,0,0,,(Thầy Tanaka, Giáo Viên Thể Dục)\NỪm… Chút nữa cô có muốn đi ăn gì đó không?
Dialogue: 0,0:03:52.75,0:03:54.54,Default,,0,0,0,,Để tôi mời!
Dialogue: 0,0:03:55.16,0:03:57.25,Default,,0,0,0,,À, hôm nay thì…
Dialogue: 0,0:03:57.25,0:03:59.04,Default,,0,0,0,,Có chuyện gì sao?
Dialogue: 0,0:03:59.66,0:04:00.66,Default,,0,0,0,,Không, không có gì đâu.
Dialogue: 0,0:04:01.12,0:04:03.12,Default,,0,0,0,,Được thôi, đi kiếm gì ăn nào.
Dialogue: 0,0:04:04.12,0:04:05.41,Default,,0,0,0,,Thật sao? Cô chắc chứ?!
Dialogue: 0,0:04:05.41,0:04:06.29,Default,,0,0,0,,Ăn cơm thịt bò được không?
Dialogue: 0,0:04:06.29,0:04:07.29,Default,,0,0,0,,Mua mang về nhé.
Dialogue: 0,0:04:07.29,0:04:08.45,Default,,0,0,0,,Hả…?
Dialogue: 0,0:04:10.98,0:04:11.75,Default,,0,0,0,,(Két)
Dialogue: 0,0:04:11.75,0:04:13.00,Default,,0,0,0,,Thiệt tình…
Dialogue: 0,0:04:13.35,0:04:13.62,Default,,0,0,0,,(U ám…)
Dialogue: 0,0:04:13.62,0:04:15.54,Default,,0,0,0,,(U ám…)\NChấm thế này bao giờ mới xong đây!
Dialogue: 0,0:04:15.54,0:04:16.15,Default,,0,0,0,,(U ám…)
Dialogue: 0,0:04:16.58,0:04:18.70,Default,,0,0,0,,Ôi trời, đã nửa đêm rồi sao!
Dialogue: 0,0:04:18.95,0:04:20.95,Default,,0,0,0,,Chết tiệt, mải làm quá quên cả thời gian…
Dialogue: 0,0:04:22.29,0:04:24.08,Default,,0,0,0,,Chắc pha chút cà phê uống vậy.
Dialogue: 0,0:04:24.32,0:04:25.41,Default,,0,0,0,,(Em đã tiến bộ rồi!)\N(Ôn Lại 1.000 Lần)\N(Làm tốt lắm! Cố gắng phát huy nhé!)
Dialogue: 0,0:04:25.41,0:04:27.54,Default,,0,0,0,,Hết hạn sử dụng mất rồi.
Dialogue: 0,0:04:28.08,0:04:29.50,Default,,0,0,0,,Thôi, kệ đi.
Dialogue: 0,0:04:30.95,0:04:32.50,Default,,0,0,0,,(Những Bí Ẩn Của Cơ Thể Tuổi Dậy Thì)\N(Sột soạt)
Dialogue: 0,0:04:32.83,0:04:34.58,Default,,0,0,0,,(Một Ngày Nọ, Đang Bàn Công Việc Với Ume.)\NPhiền phức thật đấy…
Dialogue: 0,0:04:34.58,0:04:38.37,Default,,0,0,0,,(Cô Hiratsuka Vừa Nói Chuyện Vừa Chấm Bài)\NSao bọn em không tự chấm điểm cho xong nhỉ?
Dialogue: 0,0:04:38.54,0:04:40.20,Default,,0,0,0,,(*Cấm Mang Bài Kiểm Tra Về Nhà Chấm!)\NVậy em tự cho mình 5 điểm môn Sinh luôn!
Dialogue: 0,0:04:40.20,0:04:42.33,Default,,0,0,0,,Mơ đi nhé, đồ đầu trọc.
Dialogue: 0,0:04:42.33,0:04:44.04,Default,,0,0,0,,Khoan, ý cô là 5 điểm trên thang 100 á?
Dialogue: 0,0:04:44.04,0:04:45.50,Default,,0,0,0,,Ừ, nếu là điểm số thì nghe hợp lý đấy chứ.
Dialogue: 0,0:04:45.50,0:04:48.04,Default,,0,0,0,,Ít nhất em cũng phải được hơn 5 điểm chứ bộ.
Dialogue: 0,0:04:48.50,0:04:50.50,Default,,0,0,0,,(Tập 8: Tổng Vệ Sinh Và Ngực Khủng)
Dialogue: 0,0:04:50.75,0:04:53.41,Default,,0,0,0,,Hôm nay, khoảnh khắc mà các em hằng mong đợi…
Dialogue: 0,0:04:53.62,0:04:55.87,Default,,0,0,0,,chiến dịch tổng vệ sinh!
Dialogue: 0,0:04:56.12,0:04:58.20,Default,,0,0,0,,Ờ… Chuyện gì đây ạ?
Dialogue: 0,0:04:58.75,0:05:00.25,Default,,0,0,0,,Rút lại câu vừa rồi ngay!
Dialogue: 0,0:05:00.45,0:05:02.41,Default,,0,0,0,,Thôi nào, các em chẳng có khiếu hài hước gì cả.
Dialogue: 0,0:05:02.41,0:05:04.62,Default,,0,0,0,,Thầy hiệu trưởng nhờ cô tổ chức đấy.
Dialogue: 0,0:05:04.83,0:05:08.16,Default,,0,0,0,,Giúp đỡ người gặp khó khăn\Ncũng là việc của hội học sinh mà, đúng không?
Dialogue: 0,0:05:08.16,0:05:09.00,Default,,0,0,0,,Đúng chứ?
Dialogue: 0,0:05:09.00,0:05:11.16,Default,,0,0,0,,Nghe chẳng giống cô chút nào.
Dialogue: 0,0:05:12.12,0:05:13.70,Default,,0,0,0,,Lẽ nào cái mùi này là…?
Dialogue: 0,0:05:13.70,0:05:14.50,Default,,0,0,0,,Hả?
Dialogue: 0,0:05:14.66,0:05:15.87,Default,,0,0,0,,Sushi…
Dialogue: 0,0:05:16.16,0:05:18.75,Default,,0,0,0,,Không, là thịt nướng yakiniku đúng không?
Dialogue: 0,0:05:18.75,0:05:18.92,Default,,0,0,0,,Ồ, bị các em đoán trúng phóc rồi à?
Dialogue: 0,0:05:18.92,0:05:20.16,Default,,0,0,0,,(V)\NỒ, bị các em đoán trúng phóc rồi à?
Dialogue: 0,0:05:20.16,0:05:21.87,Default,,0,0,0,,(V)\NĐúng là hết thuốc chữa với người lớn…
Dialogue: 0,0:05:22.25,0:05:23.95,Default,,0,0,0,,Được rồi, được rồi. Đành chịu vậy.
Dialogue: 0,0:05:24.12,0:05:26.41,Default,,0,0,0,,Cô cũng sẽ thưởng cho các em luôn.
Dialogue: 0,0:05:26.41,0:05:28.16,Default,,0,0,0,,Cô tưởng mình là lãnh chúa thời xưa đấy à?
Dialogue: 0,0:05:28.70,0:05:30.33,Default,,0,0,0,,Vậy cô định thưởng bọn em thứ gì nào?
Dialogue: 0,0:05:32.04,0:05:33.29,Default,,0,0,0,,Kem que dưa hấu thì sao nhỉ?
Dialogue: 0,0:05:33.29,0:05:36.20,Default,,0,0,0,,Học sinh cấp ba nào mà lại\Nbị mua chuộc bởi thứ đó chứ…?
Dialogue: 0,0:05:36.45,0:05:38.83,Default,,0,0,0,,Kem que dưa hấu…
Dialogue: 0,0:05:38.83,0:05:39.83,Default,,0,0,0,,Có một đứa dính bẫy rồi kìa!
Dialogue: 0,0:05:40.25,0:05:42.04,Default,,0,0,0,,(Tới Giờ Dọn Dẹp!)\NĐược rồi, bắt tay vào dọn dẹp nào!
Dialogue: 0,0:05:42.04,0:05:44.08,Default,,0,0,0,,(Tới Giờ Dọn Dẹp!)\NTrước tiên, hãy khiêng chiếc ghế dài này ra.
Dialogue: 0,0:05:44.29,0:05:46.20,Default,,0,0,0,,Mizunoe, em nâng đầu đằng kia đi.
Dialogue: 0,0:05:46.45,0:05:49.70,Default,,0,0,0,,Cô Hiratsuka ơi, bộ đồ thể dục đó…
Dialogue: 0,0:05:50.12,0:05:51.95,Default,,0,0,0,,Đồ cô mặc từ hồi còn học cấp ba đấy.
Dialogue: 0,0:05:51.95,0:05:53.91,Default,,0,0,0,,Trông vẫn hợp với cô lắm, đúng không?
Dialogue: 0,0:05:54.66,0:05:56.62,Default,,0,0,0,,Ở tuổi cô rồi mà vẫn thích cosplay ạ?
Dialogue: 0,0:05:56.62,0:05:57.79,Default,,0,0,0,,Này!
Dialogue: 0,0:05:58.16,0:05:59.13,Default,,0,0,0,,Cô vẫn còn là thiếu nữ xuân xanh đấy nhé!
Dialogue: 0,0:05:59.13,0:06:00.08,Default,,0,0,0,,(Phập phồng)\NCô vẫn còn là thiếu nữ xuân xanh đấy nhé!
Dialogue: 0,0:06:00.08,0:06:00.79,Default,,0,0,0,,(Phập phồng)
Dialogue: 0,0:06:00.79,0:06:01.70,Default,,0,0,0,,(Hiratsuka Rút Lui)
Dialogue: 0,0:06:01.70,0:06:03.83,Default,,0,0,0,,(Hiratsuka Rút Lui)\NCô bị trật lưng mất rồi…
Dialogue: 0,0:06:03.83,0:06:05.37,Default,,0,0,0,,Hiratsuka Rút Lui.
Dialogue: 0,0:06:05.42,0:06:05.54,Default,,0,0,0,,(Vút)
Dialogue: 0,0:06:05.54,0:06:07.79,Default,,0,0,0,,(Vút)\NNhìn kìa! Dịch Vụ Giao Hàng Của Phù Thủy Nhí!
Dialogue: 0,0:06:07.79,0:06:11.04,Default,,0,0,0,,♪Dù cậu nhóc nhỏ có lúc lên lúc xuống…♪
Dialogue: 0,0:06:11.04,0:06:13.00,Default,,0,0,0,,Đã thiếu nhân lực thì chớ…
Dialogue: 0,0:06:13.00,0:06:14.83,Default,,0,0,0,,Đành chịu vậy thôi.
Dialogue: 0,0:06:15.04,0:06:16.16,Default,,0,0,0,,Tan!
Dialogue: 0,0:06:16.16,0:06:18.29,Default,,0,0,0,,Mấy cái túi dùng để gom lá rụng đâu…
Dialogue: 0,0:06:18.87,0:06:19.35,Default,,0,0,0,,Em vẫn chưa làm được chút nào cả phải không?
Dialogue: 0,0:06:19.35,0:06:19.81,Default,,0,0,0,,(Hừm…)\NEm vẫn chưa làm được chút nào cả phải không?
Dialogue: 0,0:06:19.81,0:06:20.95,Default,,0,0,0,,Em vẫn chưa làm được chút nào cả phải không?
Dialogue: 0,0:06:20.95,0:06:21.56,Default,,0,0,0,,(Keng)
Dialogue: 0,0:06:21.56,0:06:23.62,Default,,0,0,0,,(Ồ~! Xoẹt, Xoẹt)
Dialogue: 0,0:06:23.62,0:06:24.70,Default,,0,0,0,,(Ồ~! Xoẹt, Xoẹt)\NXong rồi!
Dialogue: 0,0:06:24.70,0:06:25.04,Default,,0,0,0,,(Ồ~! Xoẹt, Xoẹt)
Dialogue: 0,0:06:25.04,0:06:26.54,Default,,0,0,0,,Cô ấy nắm bắt nhịp nhanh thật đấy.
Dialogue: 0,0:06:29.04,0:06:31.70,Default,,0,0,0,,Khu này coi như dọn gần xong rồi.
Dialogue: 0,0:06:31.91,0:06:33.40,Default,,0,0,0,,Được rồi, tiếp theo là…
Dialogue: 0,0:06:33.40,0:06:33.81,Default,,0,0,0,,(Hoan hô)
Dialogue: 0,0:06:33.91,0:06:36.16,Default,,0,0,0,,Mới gom được có một túi thôi à, Arisu?
Dialogue: 0,0:06:36.16,0:06:38.58,Default,,0,0,0,,Mình gom xong tận bốn túi rồi đây này!
Dialogue: 0,0:06:39.62,0:06:41.20,Default,,0,0,0,,(Hai Người Rút Lui) (Vút! Thoăn Thoắt!)
Dialogue: 0,0:06:41.20,0:06:42.58,Default,,0,0,0,,(Hai Người Rút Lui) (Vút! Thoăn Thoắt!)\NHai Người Rút Lui.
Dialogue: 0,0:06:42.58,0:06:43.09,Default,,0,0,0,,(Hai Người Rút Lui) (Vút! Thoăn Thoắt!)
Dialogue: 0,0:06:44.84,0:06:45.08,Default,,0,0,0,,(Quét! Hốt!)
Dialogue: 0,0:06:45.08,0:06:48.00,Default,,0,0,0,,(Quét! Hốt!)\NKem que dưa hấu…
Dialogue: 0,0:06:48.00,0:06:50.66,Default,,0,0,0,,Michinoku chăm chỉ thật đấy.
Dialogue: 0,0:06:50.66,0:06:52.87,Default,,0,0,0,,Nhưng xem ra cậu ấy vẫn chưa quen tay lắm…
Dialogue: 0,0:06:52.87,0:06:55.75,Default,,0,0,0,,Kem que dưa hấu…
Dialogue: 0,0:06:55.75,0:06:57.37,Default,,0,0,0,,Để tớ cầm hót rác phụ cậu nhé.
Dialogue: 0,0:06:58.37,0:06:59.66,Default,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:07:00.12,0:07:03.16,Default,,0,0,0,,Hò dô ta! Hò dô ta!
Dialogue: 0,0:07:03.50,0:07:05.29,Default,,0,0,0,,Sang bên phải thêm chút nữa.
Dialogue: 0,0:07:05.29,0:07:06.20,Default,,0,0,0,,Rõ rồi.
Dialogue: 0,0:07:07.00,0:07:08.33,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:07:10.70,0:07:13.41,Default,,0,0,0,,(Tiến Độ Có Vẻ Căng Thẳng…)\NLiệu bọn mình có làm kịp giờ không đây?
Dialogue: 0,0:07:13.41,0:07:16.33,Default,,0,0,0,,Mọi người ơi! Chị mượn được máy thổi lá rồi này!
Dialogue: 0,0:07:16.33,0:07:18.16,Default,,0,0,0,,Đúng là Hội trưởng nhà mình có khác!
Dialogue: 0,0:07:18.29,0:07:19.12,Default,,0,0,0,,(Vùùùù!)
Dialogue: 0,0:07:19.12,0:07:21.87,Default,,0,0,0,,(Vùùùù!)\NChà, cái máy này thổi mạnh ghê!
Dialogue: 0,0:07:21.87,0:07:23.66,Default,,0,0,0,,Làm một lèo cho xong luôn nào!
Dialogue: 0,0:07:24.16,0:07:25.50,Default,,0,0,0,,(Một Cơn Gió Mạnh = Lộ Nội Y)
Dialogue: 0,0:07:25.50,0:07:26.83,Default,,0,0,0,,(Một Cơn Gió Mạnh = Lộ Nội Y)\NÀ, giờ mình mới nhớ ra…
Dialogue: 0,0:07:26.83,0:07:27.50,Default,,0,0,0,,(Một Cơn Gió Mạnh = Lộ Nội Y)
Dialogue: 0,0:07:27.75,0:07:30.25,Default,,0,0,0,,Được rồi! Xong xuôi hết rồi!
Dialogue: 0,0:07:30.25,0:07:31.58,Default,,0,0,0,,Mọi người vất vả rồi!
Dialogue: 0,0:07:31.58,0:07:34.12,Default,,0,0,0,,Giờ chỉ còn mang rác đi đổ nữa là xong!
Dialogue: 0,0:07:34.12,0:07:35.87,Default,,0,0,0,,Làm tốt lắm, các em!
Dialogue: 0,0:07:36.83,0:07:36.89,Default,,0,0,0,,Tụi mình xong sớm hơn dự kiến nhiều đấy.
Dialogue: 0,0:07:36.89,0:07:38.41,Default,,0,0,0,,(Tư Thế Hồi Phục)\NTụi mình xong sớm hơn dự kiến nhiều đấy.
Dialogue: 0,0:07:38.41,0:07:40.00,Default,,0,0,0,,(Tư Thế Hồi Phục)\NNhìn xem kìa! Giỏi lắm!
Dialogue: 0,0:07:40.33,0:07:41.41,Default,,0,0,0,,(Tư Thế Hồi Phục Của Cô Giáo)\NCô Hiratsuka.
Dialogue: 0,0:07:41.41,0:07:43.23,Default,,0,0,0,,(Kiểu người như thế sao…)\NÀ, phải rồi. Em vẫn ở đây à.
Dialogue: 0,0:07:43.29,0:07:44.20,Default,,0,0,0,,Hư hỏng quá đấy.
Dialogue: 0,0:07:44.45,0:07:47.45,Default,,0,0,0,,Cô tự hào quá khi thấy các em đã trưởng thành thế này.
Dialogue: 0,0:07:47.45,0:07:49.95,Default,,0,0,0,,Cô lúc nào cũng thế cả.
Dialogue: 0,0:07:50.25,0:07:53.58,Default,,0,0,0,,Tụi em mang rác đi đổ chút, cô cứ ngồi chờ ở đây nhé.
Dialogue: 0,0:07:53.58,0:07:54.83,Default,,0,0,0,,Ừm.
Dialogue: 0,0:07:55.25,0:07:56.66,Default,,0,0,0,,Liệu cô ấy có ổn không nhỉ?
Dialogue: 0,0:07:57.33,0:07:59.25,Default,,0,0,0,,Bỏ cô ấy ở lại đây một mình\Nkhi còn chẳng đi lại nổi thật sao?
Dialogue: 0,0:07:59.25,0:08:00.70,Default,,0,0,0,,Ở một nơi thế này, lại có mỗi một mình…
Dialogue: 0,0:08:00.87,0:08:02.00,Default,,0,0,0,,Ừ, nghĩ lại cũng đúng…
Dialogue: 0,0:08:02.00,0:08:03.95,Default,,0,0,0,,Trông hơi lôi thôi chút thôi chứ cô ấy cũng xinh đẹp lắm mà.
Dialogue: 0,0:08:03.95,0:08:07.00,Default,,0,0,0,,Với lại cũng sắp đến giờ đóng cổng rồi.
Dialogue: 0,0:08:08.37,0:08:09.87,Default,,0,0,0,,Được rồi, Ume…
Dialogue: 0,0:08:10.01,0:08:10.75,Default,,0,0,0,,(Im lặng)
Dialogue: 0,0:08:10.75,0:08:12.45,Default,,0,0,0,,Cao quá đi mất!
Dialogue: 0,0:08:12.84,0:08:13.70,Default,,0,0,0,,(Thôi xong rồi…!)
Dialogue: 0,0:08:13.70,0:08:16.29,Default,,0,0,0,,(Thôi xong rồi…!)\NNgồi trên đây êm ái phết đấy chứ.
Dialogue: 0,0:08:16.54,0:08:17.66,Default,,0,0,0,,Cô nặng quá đấy…
Dialogue: 0,0:08:17.66,0:08:20.58,Default,,0,0,0,,Hai người áp sát vào nhau thật đấy nhỉ.
Dialogue: 0,0:08:20.79,0:08:22.08,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:08:22.29,0:08:24.04,Default,,0,0,0,,Nào, Mizunoe.
Dialogue: 0,0:08:24.04,0:08:26.16,Default,,0,0,0,,Xuất phát thôi!
Dialogue: 0,0:08:26.27,0:08:30.23,Default,,0,0,0,,(Áááá!) (Lắc lư) (Siết chặt)
Dialogue: 0,0:08:30.41,0:08:33.08,Default,,0,0,0,,Cô Hiratsuka, cô tì nặng lên lưng em quá!
Dialogue: 0,0:08:33.08,0:08:35.50,Default,,0,0,0,,Ồ? Hay là phần trên của cô lại to ra rồi nhỉ?
Dialogue: 0,0:08:35.50,0:08:37.62,Default,,0,0,0,,Em bảo cô xuống ngay đi mà!
Dialogue: 0,0:08:38.25,0:08:41.08,Default,,0,0,0,,Sau đó, cậu ấy cũng cõng luôn cả Kotobuki nữa.
Dialogue: 0,0:08:41.29,0:08:44.79,Default,,0,0,0,,Và Michinoku thì được thưởng hẳn hai cây kem dưa hấu.
Dialogue: 0,0:08:44.79,0:08:45.20,Default,,0,0,0,,(Tự Đỡ Mình Dậy) (Tại sao…?) (Tới lượt em!)
Dialogue: 0,0:08:45.20,0:08:46.12,Default,,0,0,0,,(Tự Đỡ Mình Dậy) (Tại sao…?) (Tới lượt em!)\NTại sao…?
Dialogue: 0,0:08:46.12,0:08:49.50,Default,,0,0,0,,(Tự Đỡ Mình Dậy) (Tại sao…?) (Tới lượt em!)\NTới lượt em! Tới lượt em!
Dialogue: 0,0:08:49.66,0:08:51.66,Default,,0,0,0,,Với tài nghệ của bọn mình thì,
Dialogue: 0,0:08:51.66,0:08:53.87,Default,,0,0,0,,chuyện dán mấy tấm áp phích này dễ như trở bàn tay.
Dialogue: 0,0:08:54.66,0:08:56.12,Default,,0,0,0,,- Mizunoe, em sắp bị ốm đấy à?\N- Đỉnh quá đi, tiền bối!
Dialogue: 0,0:08:56.12,0:08:57.66,Default,,0,0,0,,- Mizunoe, em sắp bị ốm đấy à?\N- Nhỏ tiếng chút đi.
Dialogue: 0,0:08:57.66,0:09:00.37,Default,,0,0,0,,Em thấy trong người hơi khang khác.
Dialogue: 0,0:09:00.91,0:09:02.62,Default,,0,0,0,,Đầu em nhức quá…
Dialogue: 0,0:09:02.83,0:09:04.25,Default,,0,0,0,,Để chị xem nào.
Dialogue: 0,0:09:05.02,0:09:07.40,Default,,0,0,0,,(Thoăn thoắt)
Dialogue: 0,0:09:07.40,0:09:08.16,Default,,0,0,0,,(Thình thịch)
Dialogue: 0,0:09:08.16,0:09:10.25,Default,,0,0,0,,(Thình thịch)\NHạch cổ em sưng to lắm rồi này.
Dialogue: 0,0:09:10.25,0:09:12.83,Default,,0,0,0,,(Thình thịch)\NCó khi em bị cảm nặng rồi đấy.
Dialogue: 0,0:09:12.83,0:09:13.70,Default,,0,0,0,,Chị là bác sĩ đấy à?
Dialogue: 0,0:09:13.91,0:09:16.16,Default,,0,0,0,,(Họa Tiết Hôm Nay)\NThân nhiệt của em cũng cao lắm.
Dialogue: 0,0:09:16.16,0:09:18.87,Default,,0,0,0,,(Họa Tiết Hôm Nay)\NHệt như hồi em trai chị bị ốm vậy.
Dialogue: 0,0:09:19.12,0:09:20.41,Default,,0,0,0,,Ra thế ạ.
Dialogue: 0,0:09:20.58,0:09:23.25,Default,,0,0,0,,Được rồi, xuống phòng y tế ngay thôi.
Dialogue: 0,0:09:23.25,0:09:24.95,Default,,0,0,0,,Chị bắt em xuống đó nằm nghỉ à?
Dialogue: 0,0:09:24.95,0:09:27.12,Default,,0,0,0,,Em đâu có nặng tới mức đó đâu.
Dialogue: 0,0:09:27.41,0:09:27.67,Default,,0,0,0,,- Nhưng em vẫn còn việc phải làm… - Không được.
Dialogue: 0,0:09:27.67,0:09:28.92,Default,,0,0,0,,(Rầm)\N- Nhưng em vẫn còn việc phải làm… - Không được.
Dialogue: 0,0:09:29.16,0:09:30.91,Default,,0,0,0,,Cảm nhẹ mà không lo chữa ngay,\Nsẽ trở nặng thêm đấy.
Dialogue: 0,0:09:30.91,0:09:32.08,Default,,0,0,0,,Đi theo chị.
Dialogue: 0,0:09:32.08,0:09:33.25,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:09:33.54,0:09:36.75,Default,,0,0,0,,Hội trưởng bật chế độ chị gái toàn tập luôn rồi!
Dialogue: 0,0:09:37.50,0:09:39.25,Default,,0,0,0,,(Phòng Y Tế)
Dialogue: 0,0:09:39.26,0:09:39.62,Default,,0,0,0,,(Không Có Ai Ở Đây)
Dialogue: 0,0:09:39.62,0:09:41.62,Default,,0,0,0,,(Không Có Ai Ở Đây)\NỒ, không có ai ở đây cả.
Dialogue: 0,0:09:41.62,0:09:42.91,Default,,0,0,0,,Vâng.
Dialogue: 0,0:09:43.50,0:09:45.08,Default,,0,0,0,,Cô có việc gấp phải ra ngoài.
Dialogue: 0,0:09:45.08,0:09:46.75,Default,,0,0,0,,Sẽ quay lại ngay.
Dialogue: 0,0:09:46.75,0:09:47.91,Default,,0,0,0,,Kozuka.
Dialogue: 0,0:09:48.12,0:09:50.33,Default,,0,0,0,,Xem ra cô Kozuka không có ở đây rồi.
Dialogue: 0,0:09:50.33,0:09:51.45,Default,,0,0,0,,Vậy em ngồi chờ cô ấy cũng được.
Dialogue: 0,0:09:51.45,0:09:53.70,Default,,0,0,0,,Nào, lại đây đi em.
Dialogue: 0,0:09:53.95,0:09:55.58,Default,,0,0,0,,Chị trải sẵn giường cho em rồi đấy.
Dialogue: 0,0:09:55.58,0:09:57.33,Default,,0,0,0,,Nhanh gọn thật đấy.
Dialogue: 0,0:09:58.45,0:09:59.45,Default,,0,0,0,,Lạnh quá.
Dialogue: 0,0:09:59.45,0:10:01.37,Default,,0,0,0,,Xong rồi. Thế này là ổn rồi đấy.
Dialogue: 0,0:10:01.95,0:10:03.83,Default,,0,0,0,,Em cảm ơn chị.
Dialogue: 0,0:10:04.00,0:10:06.33,Default,,0,0,0,,Để chị báo lại với giáo viên giúp em.
Dialogue: 0,0:10:06.33,0:10:09.20,Default,,0,0,0,,Quên công việc đi mà nghỉ ngơi cho khỏe nhé.
Dialogue: 0,0:10:09.45,0:10:11.37,Default,,0,0,0,,Em vẫn có thể…
Dialogue: 0,0:10:11.37,0:10:12.45,Default,,0,0,0,,Không được.
Dialogue: 0,0:10:12.70,0:10:13.95,Default,,0,0,0,,Vâng ạ…
Dialogue: 0,0:10:13.95,0:10:16.70,Default,,0,0,0,,Thôi được, em đi ngủ đây.
Dialogue: 0,0:10:16.91,0:10:18.50,Default,,0,0,0,,Cảm ơn chị nhé.
Dialogue: 0,0:10:18.50,0:10:19.62,Default,,0,0,0,,Không, không, không.
Dialogue: 0,0:10:20.08,0:10:22.75,Default,,0,0,0,,Chị sẽ không về cho tới khi thấy em ngủ say đâu.
Dialogue: 0,0:10:23.00,0:10:24.37,Default,,0,0,0,,Vâng.
Dialogue: 0,0:10:28.45,0:10:30.87,Default,,0,0,0,,- Trông chị thế này có ra dáng chị gái không?\N- Đúng kiểu chị gái chăm em luôn.
Dialogue: 0,0:10:31.12,0:10:33.33,Default,,0,0,0,,Một lát sau, cả hai cuối cùng cũng yên giấc.
Dialogue: 0,0:10:35.50,0:10:37.58,Default,,0,0,0,,Được rồi, cậu ấy ngủ say rồi.
Dialogue: 0,0:10:39.00,0:10:41.04,Default,,0,0,0,,Chị về trước nhé, Mizunoe.
Dialogue: 0,0:10:47.70,0:10:49.75,Default,,0,0,0,,Hóa ra… là chuyện đó sao?
Dialogue: 0,0:10:49.75,0:10:52.54,Default,,0,0,0,,Là do mình… gây ra chuyện này à?
Dialogue: 0,0:10:52.54,0:10:58.30,Default,,0,0,0,,(Rèèè…)
Dialogue: 0,0:10:58.97,0:10:59.29,Default,,0,0,0,,(Rèèè, Bật ra)
Dialogue: 0,0:10:59.29,0:11:01.45,Default,,0,0,0,,(Rèèè, Bật ra)\NNó bung ra rồi sao?
Dialogue: 0,0:11:01.45,0:11:07.29,Default,,0,0,0,,(Rèèè, Bật ra)
Dialogue: 0,0:11:07.29,0:11:09.16,Default,,0,0,0,,(Rèèè, Bật ra)\NL-Làm sao bây giờ?!
Dialogue: 0,0:11:09.16,0:11:11.41,Default,,0,0,0,,(Rèèè, Bật ra)\NMình phải làm dịu nó xuống ngay!
Dialogue: 0,0:11:11.41,0:11:12.86,Default,,0,0,0,,(Rèèè, Bật ra)
Dialogue: 0,0:11:13.00,0:11:15.12,Default,,0,0,0,,Điện thoại của mình đâu mất rồi?
Dialogue: 0,0:11:16.08,0:11:17.70,Default,,0,0,0,,Lẽ nào lúc nãy mình làm rơi…?
Dialogue: 0,0:11:18.12,0:11:18.19,Default,,0,0,0,,À, chỉ có thế thôi à? Vậy lấy lại là xong.
Dialogue: 0,0:11:18.19,0:11:18.78,Default,,0,0,0,,(Phù…)\NÀ, chỉ có thế thôi à? Vậy lấy lại là xong.
Dialogue: 0,0:11:18.78,0:11:21.37,Default,,0,0,0,,À, chỉ có thế thôi à? Vậy lấy lại là xong.
Dialogue: 0,0:11:24.70,0:11:25.33,Default,,0,0,0,,(Ngượng ngùng…)
Dialogue: 0,0:11:25.33,0:11:26.62,Default,,0,0,0,,(Ngượng ngùng…)\NLấy lại thôi…
Dialogue: 0,0:11:28.91,0:11:31.58,Default,,0,0,0,,Mình biết ngay bị cảm thì dùng thuốc đạn\Nlà chuẩn bài nhất mà.
Dialogue: 0,0:11:31.58,0:11:35.37,Default,,0,0,0,,Nhân tiện sẵn đây,\Nmình phải báo đáp lại mới được.
Dialogue: 0,0:11:35.95,0:11:37.13,Default,,0,0,0,,Xin phép nhé.
Dialogue: 0,0:11:37.13,0:11:37.83,Default,,0,0,0,,(Cựa quậy!)\NXin phép nhé.
Dialogue: 0,0:11:37.83,0:11:39.09,Default,,0,0,0,,(Cựa quậy!)
Dialogue: 0,0:11:39.83,0:11:41.33,Default,,0,0,0,,Chỗ này đúng không nhỉ?
Dialogue: 0,0:11:42.54,0:11:43.79,Default,,0,0,0,,Mình tìm không thấy đâu cả.
Dialogue: 0,0:11:44.20,0:11:47.75,Default,,0,0,0,,Huyền thoại \"biến thái ngầm\" của Kotobuki\Nlại càng ngày càng vang xa.
Dialogue: 0,0:11:47.75,0:11:48.91,Default,,0,0,0,,Cứng quá…
Dialogue: 0,0:11:49.12,0:11:50.33,Default,,0,0,0,,(Cô Kozuka Ở Phòng Y Tế)\NÁi, ái, ái!
Dialogue: 0,0:11:50.33,0:11:51.54,Default,,0,0,0,,(Cô Kozuka Ở Phòng Y Tế)\NCứu với!
Dialogue: 0,0:11:51.54,0:11:52.83,Default,,0,0,0,,Làm sao bây giờ, cô Kozuka?
Dialogue: 0,0:11:52.83,0:11:54.45,Default,,0,0,0,,Cá Ngừ sắp chết mất rồi!
Dialogue: 0,0:11:54.45,0:11:55.91,Default,,0,0,0,,Cô đã bảo các em giữ trật tự rồi mà?
Dialogue: 0,0:11:55.91,0:11:57.87,Default,,0,0,0,,Chỉ là bị chuột rút chân thôi.
Dialogue: 0,0:11:58.29,0:12:01.41,Default,,0,0,0,,Giá mà cô Kozuka chịu lạnh lùng xua đuổi mình…
Dialogue: 0,0:12:01.41,0:12:03.08,Default,,0,0,0,,Lại là em nữa à?
Dialogue: 0,0:12:03.29,0:12:04.91,Default,,0,0,0,,Cô áp trán đo sốt cho em đi.
Dialogue: 0,0:12:04.91,0:12:05.91,Default,,0,0,0,,Nhiệt kế đây.
Dialogue: 0,0:12:05.91,0:12:08.04,Default,,0,0,0,,Đo xong nhớ sát trùng bằng cồn đấy nhé.
Dialogue: 0,0:12:08.04,0:12:09.62,Default,,0,0,0,,Cô nằm ngủ cạnh em đi.
Dialogue: 0,0:12:09.62,0:12:11.08,Default,,0,0,0,,Thôi nào, mau ngủ đi.
Dialogue: 0,0:12:11.08,0:12:12.70,Default,,0,0,0,,Cô sẽ ngồi trông chừng em.
Dialogue: 0,0:12:12.95,0:12:14.75,Default,,0,0,0,,Em bảo tay mình bị trầy xước à?
Dialogue: 0,0:12:14.75,0:12:15.91,Default,,0,0,0,,Cởi ra đi.
Dialogue: 0,0:12:16.58,0:12:18.45,Default,,0,0,0,,Ý cô là cởi áo ra, đồ ngốc! Mặc quần vào ngay!
Dialogue: 0,0:12:18.50,0:12:18.75,Default,,0,0,0,,(Nghiêng Người Lại)
Dialogue: 0,0:12:18.75,0:12:21.20,Default,,0,0,0,,(Nghiêng Người Lại)\NChỉ mỗi em bị nhìn thấy thì bất công quá.
Dialogue: 0,0:12:21.20,0:12:23.12,Default,,0,0,0,,Cho em xem của cô nữa đi.
Dialogue: 0,0:12:23.12,0:12:24.16,Default,,0,0,0,,Em là cái loại lừa đảo nào thế hả?
Dialogue: 0,0:12:24.16,0:12:25.37,Default,,0,0,0,,Thôi ngay trò vớ vẩn đó đi.
Dialogue: 0,0:12:25.97,0:12:27.93,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:12:28.87,0:12:30.33,Default,,0,0,0,,Nhiều thật đấy!
Dialogue: 0,0:12:30.54,0:12:31.79,Default,,0,0,0,,Em ăn hết chỗ này thật được không chị?
Dialogue: 0,0:12:31.79,0:12:34.08,Default,,0,0,0,,Tất nhiên rồi. Hôm nay là sinh nhật em mà.
Dialogue: 0,0:12:34.08,0:12:35.66,Default,,0,0,0,,Em chỉ được ăn một miếng thôi đấy.
Dialogue: 0,0:12:35.66,0:12:36.62,Default,,0,0,0,,Chị keo kiệt quá đi!
Dialogue: 0,0:12:36.62,0:12:38.08,Default,,0,0,0,,Chị đâu có keo kiệt!
Dialogue: 0,0:12:39.50,0:12:41.66,Default,,0,0,0,,(Lẩu Xiên Que O-Stick)
Dialogue: 0,0:12:42.50,0:12:44.00,Default,,0,0,0,,Gì thế này?
Dialogue: 0,0:12:44.00,0:12:45.45,Default,,0,0,0,,Lại là Ume nữa à?
Dialogue: 0,0:12:46.83,0:12:48.70,Default,,0,0,0,,Ờ… không phải.
Dialogue: 0,0:12:48.70,0:12:49.66,Default,,0,0,0,,Tin nhắn vừa rồi là…
Dialogue: 0,0:12:49.66,0:12:51.75,Default,,0,0,0,,Em biết ngay mà. Lúc nào cũng thế.
Dialogue: 0,0:12:51.75,0:12:53.91,Default,,0,0,0,,Hôm nay là sinh nhật em đấy nhé!
Dialogue: 0,0:12:53.91,0:12:56.20,Default,,0,0,0,,(Sốc)\NChị hai đúng là quá đáng!
Dialogue: 0,0:12:56.20,0:12:57.25,Default,,0,0,0,,(Sốc)
Dialogue: 0,0:12:57.29,0:12:59.29,Default,,0,0,0,,(Tập 8: Tin Đồn Lăng Nhăng Của Ume)
Dialogue: 0,0:12:59.34,0:12:59.54,Default,,0,0,0,,(Bịch)
Dialogue: 0,0:12:59.54,0:13:01.50,Default,,0,0,0,,(Bịch)\NChết tiệt, cái tên Ume đó…
Dialogue: 0,0:13:01.50,0:13:04.16,Default,,0,0,0,,Sao hắn dám dụ dỗ chị hai mình cơ chứ?!
Dialogue: 0,0:13:05.20,0:13:06.50,Default,,0,0,0,,Dụ dỗ?
Dialogue: 0,0:13:06.50,0:13:07.83,Default,,0,0,0,,Khoan, dụ dỗ á?
Dialogue: 0,0:13:08.50,0:13:10.25,Default,,0,0,0,,Món lẩu xiên que O-stick này ngon tuyệt!
Dialogue: 0,0:13:10.25,0:13:11.79,Default,,0,0,0,,- Ngon thật đấy!\N- Ume!
Dialogue: 0,0:13:12.58,0:13:13.87,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:13.87,0:13:14.58,Default,,0,0,0,,Ôi, tiêu rồi!
Dialogue: 0,0:13:14.58,0:13:18.12,Default,,0,0,0,,Hình như bọn mình từng gặp nhau ở đâu rồi phải không?
Dialogue: 0,0:13:18.33,0:13:19.95,Default,,0,0,0,,Em là em trai của Hội trưởng\Nhội học sinh đúng chứ?
Dialogue: 0,0:13:19.95,0:13:21.33,Default,,0,0,0,,Anh từng thấy ảnh của em rồi.
Dialogue: 0,0:13:21.33,0:13:22.87,Default,,0,0,0,,Ừm…
Dialogue: 0,0:13:23.16,0:13:24.25,Default,,0,0,0,,Chào em.
Dialogue: 0,0:13:24.50,0:13:25.60,Default,,0,0,0,,Cảm ơn anh vì đã luôn chăm sóc cho chị em.
Dialogue: 0,0:13:25.60,0:13:26.13,Default,,0,0,0,,(Siết chặt)\NCảm ơn anh vì đã luôn chăm sóc cho chị em.
Dialogue: 0,0:13:26.13,0:13:26.20,Default,,0,0,0,,Cảm ơn anh vì đã luôn chăm sóc cho chị em.
Dialogue: 0,0:13:26.20,0:13:27.33,Default,,0,0,0,,Anh đang cắm sừng chị em đấy à!
Dialogue: 0,0:13:28.12,0:13:29.62,Default,,0,0,0,,Em bị làm sao thế?
Dialogue: 0,0:13:29.62,0:13:31.20,Default,,0,0,0,,Đừng có giả ngu nữa!
Dialogue: 0,0:13:31.20,0:13:34.29,Default,,0,0,0,,Thế… tại sao hai người lại nắm tay nhau?
Dialogue: 0,0:13:34.50,0:13:35.59,Default,,0,0,0,,Sao lại nắm tay á…?
Dialogue: 0,0:13:35.62,0:13:36.91,Default,,0,0,0,,Sao lại nắm tay á…?
Dialogue: 0,0:13:37.29,0:13:38.41,Default,,0,0,0,,Chính xác!
Dialogue: 0,0:13:38.41,0:13:39.87,Default,,0,0,0,,Anh đang bắt cá hai tay!
Dialogue: 0,0:13:40.04,0:13:41.20,Default,,0,0,0,,Chị hai em…
Dialogue: 0,0:13:41.20,0:13:42.16,Default,,0,0,0,,Kể từ khi anh xuất hiện,
Dialogue: 0,0:13:42.16,0:13:44.79,Default,,0,0,0,,chị ấy toàn tắm lâu kinh khủng!
Dialogue: 0,0:13:44.79,0:13:46.45,Default,,0,0,0,,Em đang nói cái quái gì vậy?
Dialogue: 0,0:13:46.47,0:13:46.66,Default,,0,0,0,,(Bật Ra!)
Dialogue: 0,0:13:46.66,0:13:50.08,Default,,0,0,0,,(Bật Ra!)\NChà chà, Ume. Không ngờ cậu lại bắt cá hai tay đấy!
Dialogue: 0,0:13:50.08,0:13:51.33,Default,,0,0,0,,Đừng có làm mọi chuyện rối thêm nữa!
Dialogue: 0,0:13:51.87,0:13:53.16,Default,,0,0,0,,Cậu bắt cá ba tay cùng lúc luôn à…
Dialogue: 0,0:13:53.16,0:13:54.20,Default,,0,0,0,,Không, không, không!
Dialogue: 0,0:13:54.20,0:13:56.62,Default,,0,0,0,,Dừng trò đổ dầu vào lửa lại ngay!
Dialogue: 0,0:13:57.95,0:13:59.20,Default,,0,0,0,,Tại sao chứ…?
Dialogue: 0,0:13:59.62,0:14:01.54,Default,,0,0,0,,Chị hai em xinh đẹp tuyệt trần thế cơ mà!
Dialogue: 0,0:14:01.75,0:14:04.25,Default,,0,0,0,,Sao anh lại đi chọn một con nhóc lùn tịt như cô ta chứ?
Dialogue: 0,0:14:04.25,0:14:05.05,Default,,0,0,0,,(Rắc) (Á!)
Dialogue: 0,0:14:06.37,0:14:08.62,Default,,0,0,0,,Em tên gì?
Dialogue: 0,0:14:09.91,0:14:11.08,Default,,0,0,0,,Taiga.
Dialogue: 0,0:14:11.08,0:14:12.00,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:14:12.00,0:14:13.25,Default,,0,0,0,,Taiga này…
Dialogue: 0,0:14:13.41,0:14:16.20,Default,,0,0,0,,Bọn anh chỉ đi mua bổ sung đồ dùng thôi.
Dialogue: 0,0:14:16.20,0:14:18.00,Default,,0,0,0,,Em hiểu lầm to rồi đấy.
Dialogue: 0,0:14:18.45,0:14:20.50,Default,,0,0,0,,Thật vậy sao?
Dialogue: 0,0:14:20.50,0:14:21.54,Default,,0,0,0,,Ừ.
Dialogue: 0,0:14:21.54,0:14:22.91,Default,,0,0,0,,Mà nhân tiện thì…
Dialogue: 0,0:14:23.08,0:14:23.12,Default,,0,0,0,,(Thì thầm)
Dialogue: 0,0:14:23.12,0:14:25.66,Default,,0,0,0,,(Thì thầm)\NEm đẹp trai thật đấy.
Dialogue: 0,0:14:25.66,0:14:27.30,Default,,0,0,0,,(Thì thầm)\NĐúng chuẩn gu của anh luôn.
Dialogue: 0,0:14:27.30,0:14:28.05,Default,,0,0,0,,(Tim Đập Lỡ Một Nhịp)
Dialogue: 0,0:14:29.12,0:14:30.54,Default,,0,0,0,,Cậu đỏ mặt rồi kìa!
Dialogue: 0,0:14:30.54,0:14:32.95,Default,,0,0,0,,Gì chứ? Cậu muốn cái gì?
Dialogue: 0,0:14:32.95,0:14:35.45,Default,,0,0,0,,Tính cậu ta vốn thế đấy.
Dialogue: 0,0:14:35.66,0:14:37.54,Default,,0,0,0,,Taiga, nhìn này.
Dialogue: 0,0:14:37.54,0:14:39.29,Default,,0,0,0,,Gì thế?
Dialogue: 0,0:14:39.29,0:14:41.02,Default,,0,0,0,,(Nổi Lên)\NĐầu ti cứng lên rồi này!
Dialogue: 0,0:14:41.02,0:14:41.41,Default,,0,0,0,,(Đỏ Mặt)\NĐầu ti cứng lên rồi này!
Dialogue: 0,0:14:41.41,0:14:42.02,Default,,0,0,0,,(Đỏ Mặt)
Dialogue: 0,0:14:42.02,0:14:42.50,Default,,0,0,0,,(Muốn Xem Không? Này! Không! Dừng Lại!)
Dialogue: 0,0:14:42.50,0:14:43.41,Default,,0,0,0,,(Muốn Xem Không? Này! Không! Dừng Lại!)\NCậu đỏ bừng cả mặt rồi kìa!
Dialogue: 0,0:14:43.41,0:14:44.70,Default,,0,0,0,,(Muốn Xem Không? Này! Không! Dừng Lại!)\NĐúng là đồ trẻ con mà!
Dialogue: 0,0:14:44.70,0:14:45.91,Default,,0,0,0,,Im ngay đi!
Dialogue: 0,0:14:46.12,0:14:47.50,Default,,0,0,0,,Cậu cũng là trẻ con chứ khác gì đâu!
Dialogue: 0,0:14:47.50,0:14:49.29,Default,,0,0,0,,Hóa ra cậu cũng mê búp bê à?
Dialogue: 0,0:14:49.29,0:14:51.33,Default,,0,0,0,,Cậu phấn khích khi thấy đầu ti tới thế cơ à?
Dialogue: 0,0:14:51.33,0:14:53.58,Default,,0,0,0,,Đúng là trải nghiệm ngàn năm có một.
Dialogue: 0,0:14:53.58,0:14:54.95,Default,,0,0,0,,(Muốn Xem Không? Này! Không! Dừng Lại!)
Dialogue: 0,0:14:54.95,0:14:56.95,Default,,0,0,0,,Bình thường cậu toàn để lộ ra suốt còn gì?
Dialogue: 0,0:14:57.25,0:14:58.33,Default,,0,0,0,,Để tôi cho cậu xem nhé.
Dialogue: 0,0:14:58.33,0:15:00.29,Default,,0,0,0,,Khỏi cần! Dừng lại ngay!
Dialogue: 0,0:15:00.29,0:15:02.79,Default,,0,0,0,,Giờ mình biết phải làm sao đây?
Dialogue: 0,0:15:03.04,0:15:04.29,Default,,0,0,0,,Taiga!
Dialogue: 0,0:15:04.83,0:15:05.83,Default,,0,0,0,,Taiga!
Dialogue: 0,0:15:05.83,0:15:07.37,Default,,0,0,0,,Đi cùng mọi người à?
Dialogue: 0,0:15:07.37,0:15:08.37,Default,,0,0,0,,Hội trưởng.
Dialogue: 0,0:15:08.37,0:15:09.91,Default,,0,0,0,,Chị hai!
Dialogue: 0,0:15:10.37,0:15:12.00,Default,,0,0,0,,C-Có chuyện gì thế này?
Dialogue: 0,0:15:12.00,0:15:13.91,Default,,0,0,0,,Chị mau nghỉ hội học sinh đi.
Dialogue: 0,0:15:13.91,0:15:15.58,Default,,0,0,0,,Cái gã này đang lừa dối chị đấy!
Dialogue: 0,0:15:15.58,0:15:17.25,Default,,0,0,0,,Lại còn cặp kè với loại con gái như cô ta nữa!
Dialogue: 0,0:15:17.25,0:15:19.50,Default,,0,0,0,,Tụi mình đang hẹn hò mà nhỉ.
Dialogue: 0,0:15:19.50,0:15:20.45,Default,,0,0,0,,Con gái á?
Dialogue: 0,0:15:20.45,0:15:22.00,Default,,0,0,0,,Cái chuyện lừa dối mà em nói…
Dialogue: 0,0:15:22.00,0:15:23.83,Default,,0,0,0,,Chị chẳng hiểu em đang nói cái gì cả.
Dialogue: 0,0:15:23.83,0:15:25.62,Default,,0,0,0,,Bọn chị chỉ là đồng nghiệp thôi mà!
Dialogue: 0,0:15:25.62,0:15:27.20,Default,,0,0,0,,Anh đã bảo em hiểu nhầm rồi cơ mà…
Dialogue: 0,0:15:27.20,0:15:28.41,Default,,0,0,0,,Chị nói dối!
Dialogue: 0,0:15:28.41,0:15:31.29,Default,,0,0,0,,Dạo này chị toàn mang cả điện thoại\Nvào phòng tắm còn gì!
Dialogue: 0,0:15:31.29,0:15:34.20,Default,,0,0,0,,Đ-Đó là vì chị vừa tắm vừa xem video!
Dialogue: 0,0:15:34.20,0:15:37.20,Default,,0,0,0,,Chị còn mua cặp kính y hệt của anh ta\Nở tiệm 100 yên,
Dialogue: 0,0:15:37.41,0:15:39.08,Default,,0,0,0,,rồi đem đeo lên đầu con búp bê nữa!
Dialogue: 0,0:15:39.08,0:15:40.08,Default,,0,0,0,,Taiga!
Dialogue: 0,0:15:40.08,0:15:42.54,Default,,0,0,0,,Đêm nào chui trong chăn cũng…
Dialogue: 0,0:15:43.29,0:15:45.17,Default,,0,0,0,,(Ríu rít)
Dialogue: 0,0:15:46.87,0:15:48.58,Default,,0,0,0,,Cậu nhỏ…
Dialogue: 0,0:15:49.70,0:15:51.33,Default,,0,0,0,,Này, khoan đã…
Dialogue: 0,0:15:51.54,0:15:54.66,Default,,0,0,0,,Sau bao phen sóng gió,\Nmọi chuyện cuối cùng cũng lắng xuống.
Dialogue: 0,0:15:54.66,0:15:56.16,Default,,0,0,0,,Thế nhưng khi ấy, trong lòng Taiga đã hằn sâu
Dialogue: 0,0:15:56.16,0:15:58.66,Default,,0,0,0,,một vết thương tinh thần khó phai.
Dialogue: 0,0:15:59.70,0:16:01.50,Default,,0,0,0,,Taiga ơi?
Dialogue: 0,0:16:04.83,0:16:07.16,Default,,0,0,0,,Chị lỡ đánh mạnh tay quá rồi à?
Dialogue: 0,0:16:07.62,0:16:09.58,Default,,0,0,0,,(Tập 8: Kế Hoạch Của Tan)
Dialogue: 0,0:16:09.79,0:16:10.91,Default,,0,0,0,,Hắt xì!
Dialogue: 0,0:16:10.91,0:16:12.12,Default,,0,0,0,,Cậu lại sắp bị cảm nữa à?
Dialogue: 0,0:16:12.12,0:16:14.75,Default,,0,0,0,,Không, chỉ hơi thấy lạnh chút thôi.
Dialogue: 0,0:16:14.75,0:16:16.45,Default,,0,0,0,,Thiệt tình, hết cách với cậu luôn.
Dialogue: 0,0:16:16.87,0:16:18.62,Default,,0,0,0,,(Miếng Dán Giữ Nhiệt)\NCầm lấy đi.
Dialogue: 0,0:16:18.79,0:16:21.12,Default,,0,0,0,,Đừng tưởng tôi lo cho cậu nhé.
Dialogue: 0,0:16:21.12,0:16:23.70,Default,,0,0,0,,Chỉ là cậu mà đổ bệnh thì\Ntôi sẽ gặp rắc rối lớn thôi.
Dialogue: 0,0:16:24.08,0:16:25.20,Default,,0,0,0,,Ừ.
Dialogue: 0,0:16:25.50,0:16:28.25,Default,,0,0,0,,Cảm ơn nhé. Vậy tôi xin nhận…
Dialogue: 0,0:16:28.25,0:16:29.33,Default,,0,0,0,,Trả tiền đây.
Dialogue: 0,0:16:30.04,0:16:32.20,Default,,0,0,0,,Của cậu hết 100 yên.
Dialogue: 0,0:16:33.25,0:16:34.95,Default,,0,0,0,,Bỏ tiền vào đi.
Dialogue: 0,0:16:34.95,0:16:35.91,Default,,0,0,0,,Mình bị cậu ta gài kèo ngoạn mục rồi…
Dialogue: 0,0:16:35.91,0:16:38.75,Default,,0,0,0,,Sáng nay chị cũng bị cậu ta cho vào tròng đấy.
Dialogue: 0,0:16:38.75,0:16:41.50,Default,,0,0,0,,Cứ tưởng dạo gần đây cậu ta ngoan ngoãn hẳn ra rồi chứ.
Dialogue: 0,0:16:41.50,0:16:43.95,Default,,0,0,0,,Hay là cậu ta lại bày trò gì mới rồi?
Dialogue: 0,0:16:43.95,0:16:47.04,Default,,0,0,0,,Không, cách tiếp cận lần này quá vòng vo.
Dialogue: 0,0:16:47.20,0:16:49.50,Default,,0,0,0,,Bình thường cậu ta mặt dày và trắng trợn hơn nhiều.
Dialogue: 0,0:16:49.50,0:16:51.95,Default,,0,0,0,,Chắc chắn đang âm mưu chuyện gì đó.
Dialogue: 0,0:16:52.95,0:16:55.00,Default,,0,0,0,,Đi điều tra xem sao.
Dialogue: 0,0:16:55.20,0:16:57.12,Default,,0,0,0,,Lại bắt đầu nữa rồi…
Dialogue: 0,0:16:59.58,0:17:01.87,Default,,0,0,0,,Chị nghĩ cậu ta có ở trong lớp không?
Dialogue: 0,0:17:01.87,0:17:06.29,Default,,0,0,0,,Ý là,\Nbày trò đó với người quen thì còn đỡ.
Dialogue: 0,0:17:07.67,0:17:07.83,Default,,0,0,0,,(Hội Học Sinh)\N- Ấm áp lắm đấy. Mua một cái không?
Dialogue: 0,0:17:07.83,0:17:08.54,Default,,0,0,0,,(Hội Học Sinh)\NẤm áp lắm đấy. Mua một cái không?
Dialogue: 0,0:17:08.54,0:17:10.63,Default,,0,0,0,,(Hội Học Sinh)\NBuôn bán đắt khách ghê!
Dialogue: 0,0:17:10.63,0:17:10.83,Default,,0,0,0,,(2.000 Yên/Cái)\NBuôn bán đắt khách ghê!
Dialogue: 0,0:17:10.83,0:17:11.87,Default,,0,0,0,,(2.000 Yên/Cái)\NMà cái giá kia thì cắt cổ quá trời!
Dialogue: 0,0:17:11.87,0:17:13.75,Default,,0,0,0,,(2.000 Yên/Cái)\NSao lại bán chạy tới mức đó được chứ?
Dialogue: 0,0:17:14.04,0:17:15.79,Default,,0,0,0,,Mizunoe, nhìn kìa.
Dialogue: 0,0:17:15.95,0:17:18.54,Default,,0,0,0,,Cậu ta kẹp ảnh của chính mình vào bán kèm luôn.
Dialogue: 0,0:17:18.54,0:17:20.12,Default,,0,0,0,,Đúng là hiện thân của sự tự luyến.
Dialogue: 0,0:17:20.41,0:17:23.66,Default,,0,0,0,,Cậu ta đang trấn lột học sinh bình thường luôn rồi!
Dialogue: 0,0:17:23.66,0:17:24.33,Default,,0,0,0,,- Hơi quá đáng rồi đấy…\N- Này, đừng chen lấn!
Dialogue: 0,0:17:24.33,0:17:26.04,Default,,0,0,0,,Tuyệt đỉnh luôn!
Dialogue: 0,0:17:26.04,0:17:28.00,Default,,0,0,0,,Chỉ có 2.000 yên thôi á? Hời quá trời!
Dialogue: 0,0:17:28.00,0:17:30.50,Default,,0,0,0,,- Đã thế còn được bắt tay nữa! Còn ảnh không?\N- Hôm nay giảm giá một nửa nhé!
Dialogue: 0,0:17:30.50,0:17:31.58,Default,,0,0,0,,Không được chọn ảnh đâu nhé!
Dialogue: 0,0:17:31.58,0:17:32.83,Default,,0,0,0,,Hóa ra quy luật cung cầu\Nlại cân bằng hoàn hảo đến thế…
Dialogue: 0,0:17:32.83,0:17:33.08,Default,,0,0,0,,Nhưng nhà trường có để yên cho chuyện này không?
Dialogue: 0,0:17:33.08,0:17:34.79,Default,,0,0,0,,- Nhưng nhà trường có để yên cho chuyện này không?\N- Cười lên nào! Cười tươi lên!
Dialogue: 0,0:17:34.79,0:17:36.08,Default,,0,0,0,,(Ồn ào!)\NNhưng nhà trường có để yên cho chuyện này không?
Dialogue: 0,0:17:36.08,0:17:36.91,Default,,0,0,0,,(Ồn ào!)
Dialogue: 0,0:17:36.91,0:17:38.12,Default,,0,0,0,,(Giáo Viên Chủ Nhiệm) (Mặt Tỉnh Bơ)
Dialogue: 0,0:17:38.12,0:17:39.87,Default,,0,0,0,,(Giáo Viên Chủ Nhiệm) (Mặt Tỉnh Bơ)\NCô Hiratsuka!
Dialogue: 0,0:17:39.99,0:17:40.41,Default,,0,0,0,,(Ồn ào) (Vỗ nhẹ)
Dialogue: 0,0:17:40.41,0:17:41.75,Default,,0,0,0,,(Ồn ào) (Vỗ nhẹ)\NCảm ơn đã ủng hộ nhé!
Dialogue: 0,0:17:41.75,0:17:43.54,Default,,0,0,0,,(Ồn ào) (Vỗ nhẹ)
Dialogue: 0,0:17:43.54,0:17:45.75,Default,,0,0,0,,- Một túi sưởi đúng không? Có ngay!\N- Biết ngay chuyện này sẽ xảy ra mà.
Dialogue: 0,0:17:46.16,0:17:47.16,Default,,0,0,0,,(Ủy Ban Kỷ Luật) (Nghiêm Nghị)
Dialogue: 0,0:17:47.16,0:17:49.25,Default,,0,0,0,,Đó là tiền bối Hojo kìa!
Dialogue: 0,0:17:50.83,0:17:52.41,Default,,0,0,0,,Cho chị ba gói…
Dialogue: 0,0:17:52.41,0:17:53.62,Default,,0,0,0,,Có ngay lập tức ạ!
Dialogue: 0,0:17:53.62,0:17:54.87,Default,,0,0,0,,Chị ấy cũng hết thuốc chữa rồi.
Dialogue: 0,0:17:54.87,0:17:58.16,Default,,0,0,0,,Chị ấy chẳng bao giờ cưỡng lại nổi mấy thứ dễ thương.
Dialogue: 0,0:18:00.37,0:18:03.33,Default,,0,0,0,,(Trên Đường Về Nhà)
Dialogue: 0,0:18:03.58,0:18:05.45,Default,,0,0,0,,Hôm nay cậu có vẻ vui phết nhỉ.
Dialogue: 0,0:18:06.75,0:18:07.87,Default,,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:18:08.37,0:18:09.95,Default,,0,0,0,,Cửa hàng quần áo sao?
Dialogue: 0,0:18:13.37,0:18:14.45,Default,,0,0,0,,Găng tay à?
Dialogue: 0,0:18:14.62,0:18:17.08,Default,,0,0,0,,Cậu ta đắn đo chọn kỹ thật đấy.
Dialogue: 0,0:18:18.25,0:18:19.20,Default,,0,0,0,,Quyết định vậy đi.
Dialogue: 0,0:18:19.50,0:18:20.83,Default,,0,0,0,,Cho em gửi tiền ạ.
Dialogue: 0,0:18:21.33,0:18:23.58,Default,,0,0,0,,Lấy cho em năm đôi găng tay này nhé.
Dialogue: 0,0:18:24.12,0:18:26.20,Default,,0,0,0,,Cảm ơn quý khách đã mua nhiều như vậy!
Dialogue: 0,0:18:26.45,0:18:27.91,Default,,0,0,0,,Năm đôi luôn sao?
Dialogue: 0,0:18:28.08,0:18:30.70,Default,,0,0,0,,Cháu mua làm quà tặng gia đình à?
Dialogue: 0,0:18:33.20,0:18:35.83,Default,,0,0,0,,Vâng… cũng đại loại như vậy ạ.
Dialogue: 0,0:18:37.95,0:18:39.79,Default,,0,0,0,,Cháu có muốn gói quà không?
Dialogue: 0,0:18:39.79,0:18:40.91,Default,,0,0,0,,Thôi, vậy thì…
Dialogue: 0,0:18:41.58,0:18:42.91,Default,,0,0,0,,Tụi mình về thôi.
Dialogue: 0,0:18:42.91,0:18:43.83,Default,,0,0,0,,Vâng.
Dialogue: 0,0:18:45.16,0:18:47.08,Default,,0,0,0,,(Ngày Hôm Sau)
Dialogue: 0,0:18:47.08,0:18:49.16,Default,,0,0,0,,Có người hâm mộ tặng tôi mấy thứ này đấy.
Dialogue: 0,0:18:49.16,0:18:51.33,Default,,0,0,0,,Thế nào mà lại vừa khéo đủ cho mỗi người một đôi.
Dialogue: 0,0:18:51.33,0:18:53.00,Default,,0,0,0,,Nên tôi tiện tay chia cho mọi người luôn.
Dialogue: 0,0:18:53.00,0:18:54.50,Default,,0,0,0,,Chất liệu đẹp thật đấy!
Dialogue: 0,0:18:54.50,0:18:55.75,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:18:55.75,0:18:57.70,Default,,0,0,0,,Cảm ơn cậu, Tan.
Dialogue: 0,0:18:57.70,0:19:00.16,Default,,0,0,0,,C-Có gì to tát đâu. Hì hì.
Dialogue: 0,0:19:00.75,0:19:02.29,Default,,0,0,0,,Arisu, cái này cho cậu này.
Dialogue: 0,0:19:02.79,0:19:04.54,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:19:05.37,0:19:07.37,Default,,0,0,0,,Biết thừa trước rồi mà\Nvẫn thấy ngại giùm ghê.
Dialogue: 0,0:19:07.91,0:19:10.25,Default,,0,0,0,,(Đồ Lót Đan Len)
Dialogue: 0,0:19:11.00,0:19:13.16,Default,,0,0,0,,Đây là… găng tay đấy.
Dialogue: 0,0:19:13.16,0:19:17.45,Default,,0,0,0,,Thì tại có một chỗ trên người cậu\Ntrông có vẻ lạnh lẽo lắm…
Dialogue: 0,0:19:17.62,0:19:20.37,Default,,0,0,0,,Nên tôi đặc biệt mua cho cậu đấy.
Dialogue: 0,0:19:20.62,0:19:23.04,Default,,0,0,0,,Thấy sao nào?\NTôi chu đáo lắm đúng không?
Dialogue: 0,0:19:24.66,0:19:28.62,Default,,0,0,0,,Rõ ràng trong túi lúc nãy có găng tay cho Terui mà.
Dialogue: 0,0:19:29.62,0:19:31.00,Default,,0,0,0,,Chị ấy đeo vào thật luôn kìa.
Dialogue: 0,0:19:31.33,0:19:32.83,Default,,0,0,0,,Mặc vào thấy cũng dễ chịu phết.
Dialogue: 0,0:19:33.12,0:19:34.45,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:19:34.91,0:19:36.87,Default,,0,0,0,,(Tập 8: Khi Mọi Người Quây Quần Bên Nhau)
Dialogue: 0,0:19:36.87,0:19:38.87,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:19:40.33,0:19:42.70,Default,,0,0,0,,Hôm nay lạnh đặc biệt luôn.
Dialogue: 0,0:19:42.95,0:19:45.37,Default,,0,0,0,,Máy sưởi dạo này cũng dở chứng nữa chứ.
Dialogue: 0,0:19:48.16,0:19:50.29,Default,,0,0,0,,Hèn chi mà lạnh thấu xương thế.
Dialogue: 0,0:19:54.62,0:19:56.20,Default,,0,0,0,,Đông tàn hiu quạnh —
Dialogue: 0,0:19:56.50,0:19:58.29,Default,,0,0,0,,ngồi một mình trên phiến đá,
Dialogue: 0,0:19:58.29,0:20:00.25,Default,,0,0,0,,chẳng có ai ngoài riêng ta…
Dialogue: 0,0:20:00.25,0:20:01.33,Default,,0,0,0,,…một mình sao?
Dialogue: 0,0:20:01.62,0:20:03.33,Default,,0,0,0,,Cậu đang lẩm bẩm gì thế?
Dialogue: 0,0:20:04.33,0:20:06.00,Default,,0,0,0,,Ồ, cậu đến rồi à.
Dialogue: 0,0:20:06.20,0:20:07.91,Default,,0,0,0,,Tớ xin được giấy phép rồi này.
Dialogue: 0,0:20:07.91,0:20:10.33,Default,,0,0,0,,Chúng ta được phép bán cơm nắm mỗi tuần một lần đấy.
Dialogue: 0,0:20:10.33,0:20:11.87,Default,,0,0,0,,Tất cả đều nhờ Ume cả.
Dialogue: 0,0:20:12.29,0:20:13.54,Default,,0,0,0,,Tuyệt quá rồi!
Dialogue: 0,0:20:13.54,0:20:14.58,Default,,0,0,0,,Ừ.
Dialogue: 0,0:20:15.16,0:20:17.66,Default,,0,0,0,,Mấy cô chú bên văn phòng hành chính cũng tốt bụng lắm.
Dialogue: 0,0:20:17.66,0:20:19.37,Default,,0,0,0,,Họ giúp tớ bao nhiêu việc luôn.
Dialogue: 0,0:20:19.37,0:20:21.00,Default,,0,0,0,,Tớ chuẩn bị xong xuôi cả rồi.
Dialogue: 0,0:20:21.62,0:20:23.04,Default,,0,0,0,,Tớ biết ngay thế nào cậu cũng lo chu toàn mà.
Dialogue: 0,0:20:23.58,0:20:25.70,Default,,0,0,0,,Mà lúc nãy cậu đọc cái gì thế?
Dialogue: 0,0:20:25.70,0:20:27.50,Default,,0,0,0,,Cái gì mà \"Đông tàn…\" ấy?
Dialogue: 0,0:20:28.58,0:20:31.70,Default,,0,0,0,,Đó là một bài thơ haiku của thi sĩ Takahama Kyoshi.
Dialogue: 0,0:20:31.95,0:20:35.50,Default,,0,0,0,,Nói về cảm giác lạnh lẽo và cô đơn của mùa đông ấy mà.
Dialogue: 0,0:20:37.09,0:20:37.46,Default,,0,0,0,,(Kéo nhẹ!)
Dialogue: 0,0:20:38.08,0:20:39.20,Default,,0,0,0,,Ừm.
Dialogue: 0,0:20:42.95,0:20:44.79,Default,,0,0,0,,Cậu thấy ấm hơn chưa?
Dialogue: 0,0:20:45.00,0:20:46.08,Default,,0,0,0,,Ừm.
Dialogue: 0,0:20:46.08,0:20:47.95,Default,,0,0,0,,Hết thấy cô đơn rồi chứ?
Dialogue: 0,0:20:47.95,0:20:48.95,Default,,0,0,0,,Ừm.
Dialogue: 0,0:20:48.95,0:20:51.66,Default,,0,0,0,,Dạo này tay tớ hay bị xước măng rô quá.
Dialogue: 0,0:20:51.66,0:20:53.58,Default,,0,0,0,,Cậu nên ăn thêm nhiều rau xanh vào.
Dialogue: 0,0:20:53.91,0:20:55.66,Default,,0,0,0,,Hôm nay mọi người vất vả rồi.
Dialogue: 0,0:20:56.00,0:20:58.54,Default,,0,0,0,,Hôm nay lạnh cóng cả người.
Dialogue: 0,0:20:59.95,0:21:01.62,Default,,0,0,0,,Chào chị.
Dialogue: 0,0:21:01.79,0:21:03.83,Default,,0,0,0,,Tớ vừa bảo lạnh thế là thành ra thế này đấy.
Dialogue: 0,0:21:03.83,0:21:05.54,Default,,0,0,0,,Em đang sưởi ấm cho Ume ạ.
Dialogue: 0,0:21:06.08,0:21:07.50,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:21:07.50,0:21:09.58,Default,,0,0,0,,Vậy hay là chị cũng tham gia cùng nhé…
Dialogue: 0,0:21:12.20,0:21:15.50,Default,,0,0,0,,Vừa ấm áp lại vừa vui thật đấy.
Dialogue: 0,0:21:15.50,0:21:17.37,Default,,0,0,0,,Ờ… chị áp sát hơi quá rồi đấy.
Dialogue: 0,0:21:17.37,0:21:18.62,Default,,0,0,0,,Sao cậu lại run bần bật thế kia?
Dialogue: 0,0:21:18.62,0:21:20.16,Default,,0,0,0,,Vui quá đi mất!
Dialogue: 0,0:21:20.16,0:21:23.87,Default,,0,0,0,,Từ bé tôi đã luôn muốn chơi trò chen vai sưởi ấm này rồi.
Dialogue: 0,0:21:23.87,0:21:26.29,Default,,0,0,0,,Không ngờ ở tuổi này vẫn được chơi đấy.
Dialogue: 0,0:21:26.29,0:21:28.58,Default,,0,0,0,,Ờ, cái này đâu phải…
Dialogue: 0,0:21:29.00,0:21:30.04,Default,,0,0,0,,Đúng rồi.
Dialogue: 0,0:21:30.91,0:21:33.25,Default,,0,0,0,,Tay Ume lạnh ngắt luôn.
Dialogue: 0,0:21:33.25,0:21:35.95,Default,,0,0,0,,Không, tại tay Michinoku ấm quá đấy thôi.
Dialogue: 0,0:21:35.95,0:21:38.87,Default,,0,0,0,,Tay tôi cũng ấm lắm đấy nhé.
Dialogue: 0,0:21:38.87,0:21:40.41,Default,,0,0,0,,Muốn sờ thử không?
Dialogue: 0,0:21:41.54,0:21:42.58,Default,,0,0,0,,Ở đâu cơ…?
Dialogue: 0,0:21:42.58,0:21:43.70,Default,,0,0,0,,Lại đây nào.
Dialogue: 0,0:21:43.70,0:21:45.70,Default,,0,0,0,,Này! Tớ lạnh cóng rồi đây!
Dialogue: 0,0:21:46.87,0:21:48.37,Default,,0,0,0,,Mọi người ở đây cả rồi!
Dialogue: 0,0:21:48.54,0:21:51.12,Default,,0,0,0,,Ồ, hóa ra không phải đang khóa cổ nhau à.
Dialogue: 0,0:21:51.12,0:21:52.95,Default,,0,0,0,,Chị nói thế nghe phũ phàng quá đấy.
Dialogue: 0,0:21:53.16,0:21:54.50,Default,,0,0,0,,Cho tôi vào với nào!
Dialogue: 0,0:21:54.91,0:21:59.70,Default,,0,0,0,,Người ta bảo ai bàn tay càng lạnh,\Nthì trái tim lại càng ấm áp đấy.
Dialogue: 0,0:22:00.08,0:22:02.12,Default,,0,0,0,,Lại bắt đầu ba hoa chích chòe rồi.
Dialogue: 0,0:22:02.29,0:22:05.37,Default,,0,0,0,,Vậy nghĩa là… những người có bàn tay ấm áp…
Dialogue: 0,0:22:05.37,0:22:07.08,Default,,0,0,0,,cũng sở hữu trái tim ấm áp luôn.
Dialogue: 0,0:22:07.08,0:22:08.58,Default,,0,0,0,,Thuyết nhân chi sơ tính bản thiện đây mà…
Dialogue: 0,0:22:09.95,0:22:12.29,Default,,0,0,0,,Tuyết rơi càng lúc càng dày hơn rồi.
Dialogue: 0,0:22:12.29,0:22:14.29,Default,,0,0,0,,Trời cũng càng ngày càng lạnh hơn nữa.
Dialogue: 0,0:22:14.29,0:22:16.54,Default,,0,0,0,,Nếu vậy thì chơi lại lần nữa không?
Dialogue: 0,0:22:17.04,0:22:18.12,Default,,0,0,0,,Được chứ!
Dialogue: 0,0:22:18.58,0:22:20.54,Default,,0,0,0,,Này mọi người ơi! Tuyết rơi rồi kìa!
Dialogue: 0,0:22:20.54,0:22:22.16,Default,,0,0,0,,Nhìn ra ngoài cửa sổ đi!
Dialogue: 0,0:22:22.70,0:22:25.41,Default,,0,0,0,,Ơ… mấy người đang làm cái gì thế kia?
Dialogue: 0,0:22:25.41,0:22:28.04,Default,,0,0,0,,Như chị thấy đấy, bọn em đang chơi trò chen vai sưởi ấm.
Dialogue: 0,0:22:28.04,0:22:29.58,Default,,0,0,0,,Ra vậy…
Dialogue: 0,0:22:30.62,0:22:31.75,Default,,0,0,0,,Nhìn kiểu gì mà giống trò đó được chứ?
Dialogue: 0,0:22:31.75,0:22:34.91,Default,,0,0,0,,Trời lạnh quá nên tụi em sưởi ấm cho nhau thôi.
Dialogue: 0,0:22:34.91,0:22:37.70,Default,,0,0,0,,Trời thế này mà mấy câu lạc bộ thể thao vẫn chạy bộ ngoài sân à?
Dialogue: 0,0:22:37.70,0:22:39.20,Default,,0,0,0,,Đúng là mấy tên ngốc.
Dialogue: 0,0:22:39.41,0:22:40.79,Default,,0,0,0,,Thật sự luôn.
Dialogue: 0,0:22:40.79,0:22:42.16,Default,,0,0,0,,Tiếc quá. Chị lỡ mất cơ hội rồi nhé.
Dialogue: 0,0:22:42.45,0:22:44.00,Default,,0,0,0,,Mấy đứa thân thiết với nhau thật đấy.
Dialogue: 0,0:22:57.50,0:22:59.79,Default,,0,0,0,,Hội trưởng, chị muốn vào cùng không?
Dialogue: 0,0:23:00.45,0:23:02.54,Default,,0,0,0,,Ồ, được thật sao?
Dialogue: 0,0:23:03.33,0:23:06.45,Default,,0,0,0,,Vậy thì chị không khách sáo đâu nhé.
Dialogue: 0,0:23:10.75,0:23:12.12,Default,,0,0,0,,Ấm quá đi.
Dialogue: 0,0:23:12.12,0:23:13.20,Default,,0,0,0,,Ừ.
Dialogue: 0,0:23:13.20,0:23:14.33,Default,,0,0,0,,Ừm.
Dialogue: 0,0:23:22.50,0:23:24.25,Default,,0,0,0,,Lạnh cóng luôn!
Dialogue: 0,0:23:25.29,0:23:27.20,Default,,0,0,0,,Tuyết bắt đầu phủ dày rồi kìa.
Dialogue: 0,0:23:27.95,0:23:28.79,Default,,0,0,0,,Đỡ này!
Dialogue: 0,0:23:29.58,0:23:31.20,Default,,0,0,0,,Dám ném chị à!
Dialogue: 0,0:23:31.50,0:23:32.58,Default,,0,0,0,,Sao tự dưng lại ném em?
Dialogue: 0,0:23:32.58,0:23:33.70,Default,,0,0,0,,Hai người tràn đầy năng lượng thật đấy.
Dialogue: 0,0:23:33.70,0:23:34.54,Default,,0,0,0,,Ừ nhỉ.
