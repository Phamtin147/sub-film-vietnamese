Dialogue: 0,0:00:01.75,0:00:04.29,Default,,0,0,0,,Được rồi! Hôm nay chính là ngày\Nmà tất cả các em đều mong đợi...
Dialogue: 0,0:00:04.29,0:00:06.83,Default,,0,0,0,,Dọn dẹp bể bơi!
Dialogue: 0,0:00:08.45,0:00:10.25,Default,,0,0,0,,Bầu trời không một gợn mây!
Dialogue: 0,0:00:10.25,0:00:11.41,Default,,0,0,0,,Đúng là một ngày hoàn hảo!
Dialogue: 0,0:00:11.41,0:00:12.41,Default,,0,0,0,,Chuẩn luôn!
Dialogue: 0,0:00:12.41,0:00:14.83,Default,,0,0,0,,Trời không một bóng mây, và chúng ta đang ở Nhật Bản!
Dialogue: 0,0:00:16.08,0:00:18.04,Default,,0,0,0,,Hội trưởng tràn đầy khí thế thật đấy.
Dialogue: 0,0:00:18.04,0:00:21.20,Default,,0,0,0,,Chị ấy vốn mê thể thao từ xưa mà.
Dialogue: 0,0:00:21.20,0:00:22.95,Default,,0,0,0,,Dù sao thì chị ấy từng ở trong đội điền kinh cơ mà.
Dialogue: 0,0:00:22.95,0:00:25.29,Default,,0,0,0,,Nhắc mới nhớ, tên Otori đâu rồi?
Dialogue: 0,0:00:26.12,0:00:28.08,Default,,0,0,0,,(- Nè! Hôm nay có hoạt động câu lạc bộ đấy!)\N(- Chăn nặng quá... Mình sẽ đến muộn mất!)
Dialogue: 0,0:02:01.00,0:02:04.00,Default,,0,0,0,,(Tập 3: Dọn Bể Bơi Trong Bộ Đồ Bơi!)
Dialogue: 0,0:02:04.16,0:02:06.08,Default,,0,0,0,,A, em hẳn là Ume đúng không!
Dialogue: 0,0:02:06.08,0:02:08.25,Default,,0,0,0,,Cảm ơn em đã đến giúp một tay nhé.
Dialogue: 0,0:02:08.41,0:02:09.16,Default,,0,0,0,,Dạ không có chi ạ!
Dialogue: 0,0:02:09.16,0:02:10.45,Default,,0,0,0,,Chị là thành viên của CLB Bơi lội...?
Dialogue: 0,0:02:10.45,0:02:11.20,Default,,0,0,0,,Chuẩn đét!
Dialogue: 0,0:02:11.20,0:02:12.79,Default,,0,0,0,,(Honma Kuroe, Học sinh năm ba)\NCLB Bơi Lội!
Dialogue: 0,0:02:12.79,0:02:14.00,Default,,0,0,0,,Nói vậy chẳng phải thừa thãi quá sao?
Dialogue: 0,0:02:14.00,0:02:15.79,Default,,0,0,0,,Chị là Honma Kuroe, học sinh năm ba.
Dialogue: 0,0:02:15.79,0:02:19.41,Default,,0,0,0,,Người ta hay gọi chị là Cá Ngừ của vùng Fujinari!
Dialogue: 0,0:02:19.41,0:02:22.08,Default,,0,0,0,,Cứ gọi chị là Cá Ngừ được rồi!
Dialogue: 0,0:02:22.08,0:02:24.16,Default,,0,0,0,,Ơ, gọi thế thì hơi...
Dialogue: 0,0:02:24.16,0:02:25.62,Default,,0,0,0,,Chị ấy chẳng biết giữ kẽ gì cả.
Dialogue: 0,0:02:25.62,0:02:27.54,Default,,0,0,0,,Và điểm quyến rũ nhất của chị
Dialogue: 0,0:02:27.54,0:02:28.95,Default,,0,0,0,,chính là phần cơ dép (soleus) này đây!
Dialogue: 0,0:02:28.95,0:02:30.62,Default,,0,0,0,,Một con cá ngừ sở hữu cơ dép săn chắc!
Dialogue: 0,0:02:30.62,0:02:32.33,Default,,0,0,0,,Hiểu chưa hả? Chơi chữ đỉnh chưa?
Dialogue: 0,0:02:32.33,0:02:33.87,Default,,0,0,0,,Oái! Khoan, khoan, khoan đã chị ơi!
Dialogue: 0,0:02:33.87,0:02:35.54,Default,,0,0,0,,Chị đang phơi bày nhiều quá mức rồi đấy!
Dialogue: 0,0:02:37.66,0:02:39.95,Default,,0,0,0,,Được rồi, xuống bể bơi thôi nào.
Dialogue: 0,0:02:40.12,0:02:42.83,Default,,0,0,0,,Coi chừng bước chân đấy nhé. Trơn trượt lắm!
Dialogue: 0,0:02:43.83,0:02:45.95,Default,,0,0,0,,Vâng, trơn thật đấy!
Dialogue: 0,0:02:46.29,0:02:47.87,Default,,0,0,0,,Ừm...
Dialogue: 0,0:02:47.87,0:02:50.75,Default,,0,0,0,,Oa, nhớt nháp trơn tuột luôn! Cảm giác đã ghê!
Dialogue: 0,0:02:52.33,0:02:53.25,Default,,0,0,0,,Ume?
Dialogue: 0,0:02:53.25,0:02:54.16,Default,,0,0,0,,Dạ vâng!
Dialogue: 0,0:02:54.16,0:02:55.87,Default,,0,0,0,,Em sẽ cọ rửa thật chăm chỉ!
Dialogue: 0,0:02:58.79,0:03:00.00,Default,,0,0,0,,Sao thế hả Michinoku?
Dialogue: 0,0:03:00.00,0:03:01.50,Default,,0,0,0,,Sao người cậu cứ run rẩy lập cập thế kia?
Dialogue: 0,0:03:01.50,0:03:02.83,Default,,0,0,0,,Tớ... tớ đang cố trụ lại...
Dialogue: 0,0:03:03.04,0:03:04.16,Default,,0,0,0,,Ý cậu là sao cơ?
Dialogue: 0,0:03:04.16,0:03:07.54,Default,,0,0,0,,Nếu tớ nhúc nhích dù chỉ một chút...
Dialogue: 0,0:03:12.83,0:03:14.00,Default,,0,0,0,,thì sẽ thành ra thế này đây.
Dialogue: 0,0:03:14.25,0:03:16.20,Default,,0,0,0,,Khả năng giữ thăng bằng tệ hại thật.
Dialogue: 0,0:03:20.25,0:03:23.08,Default,,0,0,0,,Cậu đang làm cái gì thế hả Terui?
Dialogue: 0,0:03:23.25,0:03:25.83,Default,,0,0,0,,Tớ đang bắt ấu trùng chuồn chuồn.
Dialogue: 0,0:03:25.83,0:03:27.25,Default,,0,0,0,,Chúng được gọi là nhộng chuồn chuồn (naiads) đấy.
Dialogue: 0,0:03:28.16,0:03:31.62,Default,,0,0,0,,Nếu để chúng ở lại đây,\Nchúng sẽ bị nước cuốn trôi rồi chết mất.
Dialogue: 0,0:03:31.79,0:03:34.16,Default,,0,0,0,,Như thế thì tội nghiệp lắm.
Dialogue: 0,0:03:34.16,0:03:35.66,Default,,0,0,0,,Terui...
Dialogue: 0,0:03:35.83,0:03:37.16,Default,,0,0,0,,Cậu tốt bụng thật đấy.
Dialogue: 0,0:03:37.16,0:03:39.16,Default,,0,0,0,,Cậu định mang chúng về nhà nuôi à?
Dialogue: 0,0:03:39.16,0:03:40.75,Default,,0,0,0,,À không.
Dialogue: 0,0:03:40.75,0:03:42.62,Default,,0,0,0,,Tớ mang về làm mồi cho đàn cá cảnh nhà tớ.
Dialogue: 0,0:03:42.91,0:03:45.54,Default,,0,0,0,,Dù sao thì cũng đỡ hơn là chết uổng phí đúng không?
Dialogue: 0,0:03:45.54,0:03:48.58,Default,,0,0,0,,Hóa ra cậu chỉ quan tâm chúng chết như thế nào thôi à?
Dialogue: 0,0:03:51.37,0:03:53.75,Default,,0,0,0,,Vết bẩn này cứng đầu quá, cọ mãi không ra.
Dialogue: 0,0:03:54.37,0:03:55.75,Default,,0,0,0,,Tớ có nước tẩy rửa chuyên dụng đây!
Dialogue: 0,0:03:55.75,0:03:58.08,Default,,0,0,0,,(Nước tẩy rửa bể bơi)\NThật á? Cậu đúng là cứu tinh rồi!
Dialogue: 0,0:03:58.75,0:04:01.16,Default,,0,0,0,,Vậy thì đổ một ít sang đằng kia đi!
Dialogue: 0,0:04:03.13,0:04:03.57,Default,,0,0,0,,(Trượt chân!)
Dialogue: 0,0:04:07.25,0:04:09.00,Default,,0,0,0,,Xin đừng chết mà...
Dialogue: 0,0:04:09.00,0:04:11.20,Default,,0,0,0,,(Toàn bộ ấu trùng chuồn chuồn bị quét sạch)\NToàn bộ ấu trùng chuồn chuồn bị quét sạch.
Dialogue: 0,0:04:12.12,0:04:14.66,Default,,0,0,0,,Công việc này cực nhọc thật đấy.
Dialogue: 0,0:04:17.29,0:04:18.95,Default,,0,0,0,,Mọi người vất vả rồi nhé.
Dialogue: 0,0:04:18.95,0:04:20.62,Default,,0,0,0,,Nhìn mọi người cặm cụi làm việc kìa!
Dialogue: 0,0:04:20.62,0:04:22.58,Default,,0,0,0,,Giỏi lắm, làm tốt lắm!
Dialogue: 0,0:04:22.58,0:04:24.91,Default,,0,0,0,,Lại đến muộn, làm như mình là ông lớn không bằng.
Dialogue: 0,0:04:25.25,0:04:26.20,Default,,0,0,0,,Ume.
Dialogue: 0,0:04:26.20,0:04:28.33,Default,,0,0,0,,Cậu với cái bàn chải cọ sàn kia trông hợp đôi ghê đấy!
Dialogue: 0,0:04:28.33,0:04:29.25,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:29.25,0:04:30.62,Default,,0,0,0,,Cậu không mặc đồ bơi nữ sinh (sukumizu) của trường à?
Dialogue: 0,0:04:30.62,0:04:32.00,Default,,0,0,0,,Đương nhiên là không rồi!
Dialogue: 0,0:04:32.00,0:04:35.75,Default,,0,0,0,,Tôi đâu có bao giờ muốn ăn mặc như con gái chứ!
Dialogue: 0,0:04:35.75,0:04:36.66,Default,,0,0,0,,Thật thế cơ à?
Dialogue: 0,0:04:36.66,0:04:39.54,Default,,0,0,0,,A! Thằng nhóc trong bức ảnh mặc đồ bơi hôm trước kìa!
Dialogue: 0,0:04:39.54,0:04:41.66,Default,,0,0,0,,Sao hôm nay nhóc không mặc bộ đó nữa?
Dialogue: 0,0:04:41.66,0:04:42.91,Default,,0,0,0,,Tại sao lại không chứ?
Dialogue: 0,0:04:43.95,0:04:45.50,Default,,0,0,0,,Em đã bảo rồi mà,
Dialogue: 0,0:04:45.50,0:04:48.00,Default,,0,0,0,,do Arisu ép em mặc đấy chứ!
Dialogue: 0,0:04:48.00,0:04:49.33,Default,,0,0,0,,Đó đâu phải đồ của em đâu!
Dialogue: 0,0:04:49.33,0:04:51.83,Default,,0,0,0,,Thế à? Chị xin lỗi nhé!
Dialogue: 0,0:04:51.83,0:04:53.66,Default,,0,0,0,,Vậy thì em có thể mượn đồ bơi của chị này!
Dialogue: 0,0:04:53.66,0:04:55.00,Default,,0,0,0,,CLB của chị nghèo rớt mồng tơi rồi!
Dialogue: 0,0:04:55.00,0:04:56.29,Default,,0,0,0,,Vấn đề đâu phải nằm ở chỗ đó!
Dialogue: 0,0:04:56.49,0:04:57.29,Default,,0,0,0,,(Sắp xong rồi)
Dialogue: 0,0:04:57.45,0:04:59.66,Default,,0,0,0,,(Sắp xong rồi)\NTrời đất ơi, mệt đứt cả hơi.
Dialogue: 0,0:04:59.66,0:05:02.58,Default,,0,0,0,,Chỉ cần xả nước rửa sạch một lượt cuối nữa là xong!
Dialogue: 0,0:05:02.58,0:05:05.33,Default,,0,0,0,,Tớ sẽ đi mở vòi nước cho!
Dialogue: 0,0:05:05.33,0:05:07.91,Default,,0,0,0,,Lúc nào cũng chỉ biết chọn việc nhẹ nhàng!
Dialogue: 0,0:05:07.91,0:05:09.95,Default,,0,0,0,,Bọn tớ sẽ lo việc cọ rửa.
Dialogue: 0,0:05:09.95,0:05:11.16,Default,,0,0,0,,Cậu cầm vòi xịt nước đi.
Dialogue: 0,0:05:13.00,0:05:14.66,Default,,0,0,0,,Hả? Vòi nước sao?
Dialogue: 0,0:05:14.66,0:05:17.04,Default,,0,0,0,,Cảm giác như mình đang quên mất điều gì đó...
Dialogue: 0,0:05:17.04,0:05:17.91,Default,,0,0,0,,Mở nước đây!
Dialogue: 0,0:05:24.87,0:05:27.29,Default,,0,0,0,,(Vừa sực nhớ ra)\NA phải rồi! Cái vòi nước bị hỏng van mà!
Dialogue: 0,0:05:27.29,0:05:28.08,Default,,0,0,0,,Á nè!
Dialogue: 0,0:05:28.08,0:05:29.87,Default,,0,0,0,,Nước phụt ra kinh khủng khiếp quá!
Dialogue: 0,0:05:29.87,0:05:31.25,Default,,0,0,0,,Otori! Mau khóa nước lại đi!
Dialogue: 0,0:05:31.25,0:05:34.54,Default,,0,0,0,,Vô ích thôi. Cậu ta đang đeo tai nghe thưởng thức âm nhạc\Nvới cái vẻ mặt tự mãn đắc ý kia kìa.
Dialogue: 0,0:05:37.20,0:05:38.70,Default,,0,0,0,,Chết tiệt thật chứ...
Dialogue: 0,0:05:38.70,0:05:40.54,Default,,0,0,0,,Ai đó mau khóa vòi nước lại giùm cái!
Dialogue: 0,0:05:42.95,0:05:45.04,Default,,0,0,0,,Á! Khoan đã...
Dialogue: 0,0:05:45.29,0:05:46.58,Default,,0,0,0,,Xin lỗi nhé Mizunoe!
Dialogue: 0,0:05:46.58,0:05:47.66,Default,,0,0,0,,Để chị đi khóa nước cho.
Dialogue: 0,0:05:47.66,0:05:49.37,Default,,0,0,0,,Không được! Để em đi cho!
Dialogue: 0,0:05:49.37,0:05:50.45,Default,,0,0,0,,Cho tớ xin lỗi!
Dialogue: 0,0:05:50.45,0:05:51.87,Default,,0,0,0,,Có chuyện gì đang xảy ra thế kia?
Dialogue: 0,0:05:51.87,0:05:53.83,Default,,0,0,0,,Mọi người đang nghịch nước à?
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Hình phạt hôm nay dành cho Otori:
Dialogue: 0,0:05:56.00,0:05:57.33,Default,,0,0,0,,(Hình phạt guồng nước)\NHình phạt tra tấn bằng guồng nước!
Dialogue: 0,0:05:57.33,0:05:59.79,Default,,0,0,0,,Ít nhất thì ngân sách của CLB cũng có dấu hiệu khởi sắc rồi!
Dialogue: 0,0:06:04.12,0:06:06.45,Default,,0,0,0,,Có khi chúng ta phạt hơi quá tay rồi chăng.
Dialogue: 0,0:06:06.45,0:06:08.70,Default,,0,0,0,,Hình như Tan bị cảm lạnh rồi thì phải.
Dialogue: 0,0:06:08.70,0:06:10.50,Default,,0,0,0,,Người ta bảo kẻ ngốc thì không bao giờ bị cảm,
Dialogue: 0,0:06:10.50,0:06:12.70,Default,,0,0,0,,nhưng có vẻ như đồ phế phẩm thì vẫn dính chưởng.
Dialogue: 0,0:06:12.70,0:06:15.04,Default,,0,0,0,,Bình thường thì chị sẽ đích thân tới thăm,
Dialogue: 0,0:06:15.04,0:06:18.00,Default,,0,0,0,,nhưng giờ chúng ta đã có thêm một bạn nam là Ume rồi,
Dialogue: 0,0:06:18.00,0:06:20.95,Default,,0,0,0,,em có thể ghé qua nhà thăm cậu ấy được không?
Dialogue: 0,0:06:21.25,0:06:22.29,Default,,0,0,0,,Với lại,
Dialogue: 0,0:06:22.29,0:06:24.08,Default,,0,0,0,,chị cá là cũng có thứ mà em đang muốn tận mắt nhìn thấy đấy.
Dialogue: 0,0:06:24.13,0:06:25.58,Default,,0,0,0,,(Hội Học Sinh Cũng Có Tôi Nữa Đó! -- Tan Otori)\N(Mang Đến Cho Bạn Giấc Mơ Và Tình Yêu)
Dialogue: 0,0:06:25.58,0:06:26.79,Default,,0,0,0,,Nhìn thấy cái gì cơ chứ?
Dialogue: 0,0:06:28.89,0:06:30.67,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:06:32.66,0:06:35.04,Default,,0,0,0,,Hóa ra đây là nơi Otori sống à.
Dialogue: 0,0:06:35.25,0:06:38.66,Default,,0,0,0,,Thật khó mà hình dung được cái bộ dạng yếu ớt bất lực của cậu ta.
Dialogue: 0,0:06:40.54,0:06:41.54,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:06:46.45,0:06:48.00,Default,,0,0,0,,Ra ngay đây!
Dialogue: 0,0:06:50.33,0:06:52.16,Default,,0,0,0,,Ai thế?
Dialogue: 0,0:06:54.04,0:06:55.00,Default,,0,0,0,,Chào.
Dialogue: 0,0:06:55.00,0:06:57.25,Default,,0,0,0,,Ủa? Ume đấy à?
Dialogue: 0,0:06:57.25,0:06:58.45,Default,,0,0,0,,Ừ.
Dialogue: 0,0:06:58.45,0:07:00.41,Default,,0,0,0,,Nghe bảo hôm nay cậu nghỉ ốm.
Dialogue: 0,0:07:00.41,0:07:02.12,Default,,0,0,0,,Tôi mang ít giấy tờ của hội học sinh qua cho cậu này.
Dialogue: 0,0:07:02.12,0:07:03.37,Default,,0,0,0,,Chẳng lẽ là...
Dialogue: 0,0:07:04.37,0:07:06.08,Default,,0,0,0,,Cậu nhớ tôi đến mức đó cơ à...?
Dialogue: 0,0:07:07.45,0:07:09.20,Default,,0,0,0,,Trời ạ, tôi biết phải làm sao với cậu đây?
Dialogue: 0,0:07:09.20,0:07:11.79,Default,,0,0,0,,- Ốm nặng thế này rồi mà vẫn còn sức trêu người ta à?\N- Thật là...
Dialogue: 0,0:07:11.79,0:07:12.91,Default,,0,0,0,,Đừng có cố gượng ép bản thân nữa.
Dialogue: 0,0:07:14.87,0:07:18.33,Default,,0,0,0,,Ư, lũ vi trùng cảm cúm chết tiệt...
Dialogue: 0,0:07:18.33,0:07:20.91,Default,,0,0,0,,Nếu mà nhìn thấy chúng bằng mắt thường, tôi đã đấm cho chúng một trận rồi!
Dialogue: 0,0:07:20.91,0:07:22.87,Default,,0,0,0,,Nằm xuống nghỉ ngơi giùm đi cha nội!
Dialogue: 0,0:07:22.87,0:07:25.45,Default,,0,0,0,,Ăn chút cháo đi này. Tôi tự nấu ở nhà mang qua đấy.
Dialogue: 0,0:07:25.87,0:07:28.53,Default,,0,0,0,,Lúc ốm thì phải ăn uống đàng hoàng vào.
Dialogue: 0,0:07:29.37,0:07:30.70,Default,,0,0,0,,Ume!
Dialogue: 0,0:07:31.54,0:07:33.45,Default,,0,0,0,,Cậu không bỏ hành lá vào đấy chứ hả?
Dialogue: 0,0:07:33.45,0:07:37.20,Default,,0,0,0,,Vị giác tinh tế nhạy cảm của tôi không chịu được đồ đắng đâu đấy nhé.
Dialogue: 0,0:07:37.87,0:07:39.33,Default,,0,0,0,,Nóng! Nóng! Nóng quá đi mất!
Dialogue: 0,0:07:42.58,0:07:45.83,Default,,0,0,0,,Cậu ta vẫn còn dồi dào năng lượng chán.
Dialogue: 0,0:07:46.08,0:07:48.00,Default,,0,0,0,,Ume...
Dialogue: 0,0:07:48.37,0:07:49.66,Default,,0,0,0,,Gì thế?
Dialogue: 0,0:07:49.66,0:07:50.79,Default,,0,0,0,,Ừm...
Dialogue: 0,0:07:51.08,0:07:53.37,Default,,0,0,0,,Sao vậy? Cậu cảm thấy mệt hơn à?
Dialogue: 0,0:07:53.69,0:07:54.66,Default,,0,0,0,,(Cọ quẹt, cọ quẹt)
Dialogue: 0,0:07:55.45,0:07:58.45,Default,,0,0,0,,Tôi vừa quẹt hết vi trùng cảm cúm sang người cậu rồi đấy!
Dialogue: 0,0:07:58.45,0:07:59.75,Default,,0,0,0,,(Bực mình)
Dialogue: 0,0:07:59.75,0:08:02.45,Default,,0,0,0,,Cái quái gì thế hả? Tôi đang là người bệnh đấy nhé!
Dialogue: 0,0:08:02.45,0:08:03.83,Default,,0,0,0,,Vậy thì nằm yên đó mà nghỉ ngơi đi.
Dialogue: 0,0:08:04.29,0:08:07.00,Default,,0,0,0,,Tôi không nhúc nhích nổi nữa rồi!
Dialogue: 0,0:08:07.00,0:08:09.54,Default,,0,0,0,,Mông tôi ngứa ngáy quá, Ume ơi!
Dialogue: 0,0:08:09.54,0:08:11.12,Default,,0,0,0,,Trông có vẻ cậu ta đỡ hơn nhiều rồi đấy.
Dialogue: 0,0:08:11.12,0:08:12.58,Default,,0,0,0,,Có khi mình nên đi về cho rồi.
Dialogue: 0,0:08:13.41,0:08:14.75,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:08:15.75,0:08:18.87,Default,,0,0,0,,Ủa, cậu sống một mình à?
Dialogue: 0,0:08:19.08,0:08:20.29,Default,,0,0,0,,Ừ.
Dialogue: 0,0:08:20.75,0:08:23.66,Default,,0,0,0,,Dù sao thì tôi cũng đâu có bố mẹ bên cạnh.
Dialogue: 0,0:08:23.66,0:08:25.66,Default,,0,0,0,,Sao cơ? Tại sao lại...?
Dialogue: 0,0:08:25.66,0:08:29.33,Default,,0,0,0,,Chuyện gia đình phức tạp thôi mà...
Dialogue: 0,0:08:29.50,0:08:31.91,Default,,0,0,0,,Trước khi tôi kịp nhận thức được thì bố đã bỏ đi rồi.
Dialogue: 0,0:08:31.91,0:08:34.70,Default,,0,0,0,,Mẹ thì cũng chẳng bao giờ về nhà cả.
Dialogue: 0,0:08:34.70,0:08:35.95,Default,,0,0,0,,Cho nên...
Dialogue: 0,0:08:36.91,0:08:39.33,Default,,0,0,0,,Cảm ơn cậu vì hôm nay đã ghé qua thăm tôi nhé.
Dialogue: 0,0:08:41.00,0:08:42.33,Default,,0,0,0,,Đùa chút thôi mà!
Dialogue: 0,0:08:42.33,0:08:43.50,Default,,0,0,0,,Tôi là kẻ bất khả chiến bại đấy nhé!
Dialogue: 0,0:08:43.50,0:08:45.29,Default,,0,0,0,,Một mình tôi có thể tự gánh vác mọi chuyện!
Dialogue: 0,0:08:45.29,0:08:46.33,Default,,0,0,0,,Chút cảm vặt này sẽ bay màu trong nháy mắt thôi...
Dialogue: 0,0:08:46.33,0:08:47.45,Default,,0,0,0,,Otori này.
Dialogue: 0,0:08:48.33,0:08:51.66,Default,,0,0,0,,Cậu đã đi khám bác sĩ chưa đấy?
Dialogue: 0,0:08:51.87,0:08:52.58,Default,,0,0,0,,Chưa...
Dialogue: 0,0:08:52.58,0:08:53.75,Default,,0,0,0,,Biết ngay mà.
Dialogue: 0,0:08:54.04,0:08:56.16,Default,,0,0,0,,Cậu không thể cứ để mặc bệnh tình thế này được đâu!
Dialogue: 0,0:08:56.16,0:08:58.70,Default,,0,0,0,,Và tôi cá là cậu cũng chưa thèm uống thuốc luôn đúng không.
Dialogue: 0,0:08:58.91,0:09:01.00,Default,,0,0,0,,Thuốc ở trên cái kệ đằng kia kìa.
Dialogue: 0,0:09:01.00,0:09:02.25,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:09:02.25,0:09:03.25,Default,,0,0,0,,Cái này đúng không?
Dialogue: 0,0:09:03.25,0:09:04.89,Default,,0,0,0,,Otori, tôi sẽ giúp cậu khỏi bệnh.
Dialogue: 0,0:09:04.89,0:09:06.20,Default,,0,0,0,,(Oronaru, 2 viên mỗi lần dùng)\NOtori, tôi sẽ giúp cậu mau khỏi bệnh.
Dialogue: 0,0:09:07.20,0:09:09.33,Default,,0,0,0,,(Đau đầu, Sốt, Đau bụng kinh)\NĐó là thuốc đặt hậu môn đấy...
Dialogue: 0,0:09:10.66,0:09:11.58,Default,,0,0,0,,Otori.
Dialogue: 0,0:09:12.33,0:09:13.66,Default,,0,0,0,,Tụt quần ra đi.
Dialogue: 0,0:09:14.08,0:09:14.95,Default,,0,0,0,,Khoan đã! Cậu không đùa đấy chứ...
Dialogue: 0,0:09:14.95,0:09:16.87,Default,,0,0,0,,Tôi tự làm được mà!
Dialogue: 0,0:09:16.87,0:09:18.00,Default,,0,0,0,,Không.
Dialogue: 0,0:09:18.00,0:09:20.58,Default,,0,0,0,,Cậu chắc chắn sẽ chỉ giả vờ như đã làm thôi.
Dialogue: 0,0:09:21.37,0:09:22.70,Default,,0,0,0,,Cứ để tôi lo cho.
Dialogue: 0,0:09:24.16,0:09:25.50,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:09:26.91,0:09:28.45,Default,,0,0,0,,Xấu hổ chết đi được!
Dialogue: 0,0:09:30.37,0:09:32.25,Default,,0,0,0,,Có cái gì đâu mà phải xấu hổ chứ!
Dialogue: 0,0:09:32.41,0:09:34.79,Default,,0,0,0,,Cậu ta đang cố hét tướng lên để át đi sự bối rối của mình.
Dialogue: 0,0:09:37.83,0:09:40.62,Default,,0,0,0,,Được rồi, chuẩn bị đây.
Dialogue: 0,0:09:40.91,0:09:41.91,Default,,0,0,0,,Được rồi...
Dialogue: 0,0:09:49.29,0:09:50.41,Default,,0,0,0,,Ái da!
Dialogue: 0,0:09:50.79,0:09:51.79,Default,,0,0,0,,Xin lỗi nhé!
Dialogue: 0,0:09:52.33,0:09:53.75,Default,,0,0,0,,Tôi không sao.
Dialogue: 0,0:09:55.70,0:09:57.70,Default,,0,0,0,,Tiếp tục đi.
Dialogue: 0,0:09:57.90,0:09:59.50,Default,,0,0,0,,(Thất Lạc Cõi Người, Naomi, Lời Thú Tội Của Chiếc Mặt Nạ)\N(Thiếu Gia Bột, Chùa Kim Các)
Dialogue: 0,0:09:59.58,0:10:03.13,Default,,0,0,0,,Mizunoe đang chìm đắm trong thế giới văn học hư cấu.
Dialogue: 0,0:10:06.91,0:10:08.87,Default,,0,0,0,,Mệt đứt cả hơi...
Dialogue: 0,0:10:08.87,0:10:11.37,Default,,0,0,0,,Mình cứ tưởng tim mình sắp nổ tung ra ngoài rồi chứ!
Dialogue: 0,0:10:11.37,0:10:12.66,Default,,0,0,0,,Xong rồi đấy. Nhét vào rồi.
Dialogue: 0,0:10:13.41,0:10:17.25,Default,,0,0,0,,Ít nhất thì Otori cũng có vẻ đã ngoan ngoãn nằm yên rồi.
Dialogue: 0,0:10:19.37,0:10:21.08,Default,,0,0,0,,Ume...
Dialogue: 0,0:10:26.12,0:10:27.62,Default,,0,0,0,,Mình nên về thôi.
Dialogue: 0,0:10:27.79,0:10:29.79,Default,,0,0,0,,Thuốc của cậu tôi để ở đây nhé...
Dialogue: 0,0:10:31.04,0:10:33.41,Default,,0,0,0,,Viên thuốc đặt hậu môn đang nằm trên sàn á?
Dialogue: 0,0:10:33.83,0:10:34.83,Default,,0,0,0,,Khoan đã...
Dialogue: 0,0:10:35.45,0:10:38.37,Default,,0,0,0,,Thế vừa rồi mình vừa nhét cái thứ gì vào trong đó vậy?!
Dialogue: 0,0:10:38.37,0:10:40.83,Default,,0,0,0,,(Kẹo Ngậm Bạc Hà Mát Lạnh! Thổi Bùng Hơi Thở Thơm Tho!)
Dialogue: 0,0:10:44.66,0:10:47.41,Default,,0,0,0,,Sao cái mông tôi lại nóng rần rật thế này nhỉ?
Dialogue: 0,0:10:47.41,0:10:48.45,Default,,0,0,0,,Otori!
Dialogue: 0,0:10:49.91,0:10:51.29,Default,,0,0,0,,Cho tôi xem mông cậu mau!
Dialogue: 0,0:10:52.41,0:10:53.95,Default,,0,0,0,,Gì cơ?!
Dialogue: 0,0:10:53.95,0:10:54.54,Default,,0,0,0,,Ume!
Dialogue: 0,0:10:54.54,0:10:56.91,Default,,0,0,0,,Hả? Nóng quá!
Dialogue: 0,0:10:56.91,0:10:57.91,Default,,0,0,0,,Mông tôi đang bốc hỏa kìa!
Dialogue: 0,0:10:57.91,0:10:58.75,Default,,0,0,0,,Nóng quá đi mất!
Dialogue: 0,0:10:58.75,0:10:59.83,Default,,0,0,0,,Mông tôi sắp cháy thành tro rồi!
Dialogue: 0,0:10:59.83,0:11:01.58,Default,,0,0,0,,Tôi xin lỗi! Lỗi tại tôi hết!
Dialogue: 0,0:11:01.58,0:11:03.62,Default,,0,0,0,,Mau tụt quần ra cho tôi xem mông nhanh lên!
Dialogue: 0,0:11:05.04,0:11:05.95,Default,,0,0,0,,Ngày hôm sau,
Dialogue: 0,0:11:05.95,0:11:08.04,Default,,0,0,0,,Mizunoe cũng lăn ra bị cảm cúm luôn.
Dialogue: 0,0:11:08.04,0:11:11.23,Default,,0,0,0,,(Tuần Kế Tiếp)\NNè. Cậu đã thấy khỏe hơn chưa?
Dialogue: 0,0:11:11.91,0:11:13.16,Default,,0,0,0,,Cũng hòm hòm rồi.
Dialogue: 0,0:11:30.79,0:11:33.79,Default,,0,0,0,,(Tập 3: Mừng Cho Cậu Nhé!)
Dialogue: 0,0:11:33.79,0:11:33.80,Default,,0,0,0,,Lắc lư...
Dialogue: 0,0:11:33.80,0:11:36.66,Default,,0,0,0,,(Phòng Hội Học Sinh)\NLắc lư...
Dialogue: 0,0:11:36.66,0:11:36.71,Default,,0,0,0,,- Gâu!\N- Lắc lư...\N(Phòng Hội Học Sinh)
Dialogue: 0,0:11:36.71,0:11:37.70,Default,,0,0,0,,- Gâu!\N- Lắc lư...
Dialogue: 0,0:11:37.73,0:11:39.48,Default,,0,0,0,,(Toán Học I)
Dialogue: 0,0:11:39.66,0:11:41.12,Default,,0,0,0,,Sao thế hả Mizunoe?
Dialogue: 0,0:11:41.12,0:11:42.79,Default,,0,0,0,,Sao tự dưng em lại thở dài thườn thượt thế?
Dialogue: 0,0:11:43.29,0:11:47.00,Default,,0,0,0,,Dạ không có gì đâu ạ. Chỉ là\Nbọn em lại sắp phải đối mặt với nó nữa rồi.
Dialogue: 0,0:11:47.00,0:11:48.54,Default,,0,0,0,,(Quá Vô Lý!)\NKỳ thi định kỳ!
Dialogue: 0,0:11:48.70,0:11:51.79,Default,,0,0,0,,À, chuyện đó là đương nhiên rồi! Người ta gọi\Nlà thi định kỳ là có lý do cả mà!
Dialogue: 0,0:11:51.79,0:11:53.37,Default,,0,0,0,,Nhắc mới nhớ nè Mizunoe,
Dialogue: 0,0:11:53.37,0:11:55.70,Default,,0,0,0,,em học không giỏi các môn toán với tự nhiên đúng không?
Dialogue: 0,0:11:55.70,0:11:57.45,Default,,0,0,0,,Chính xác là như vậy đấy ạ.
Dialogue: 0,0:11:57.45,0:11:59.66,Default,,0,0,0,,Nó giống như nói chuyện với bức tường vậy...
Dialogue: 0,0:11:59.66,0:12:00.91,Default,,0,0,0,,Không, đàn gảy tai trâu...
Dialogue: 0,0:12:00.91,0:12:04.08,Default,,0,0,0,,À không, thổi sáo cho bò nghe...
Dialogue: 0,0:12:04.08,0:12:06.41,Default,,0,0,0,,Em không cần phải dùng từ ngữ hoa mỹ văn vẻ thế đâu.
Dialogue: 0,0:12:06.41,0:12:08.83,Default,,0,0,0,,Nhưng mà em giỏi môn Quốc Ngữ (Tiếng Nhật) lắm mà.
Dialogue: 0,0:12:09.25,0:12:11.91,Default,,0,0,0,,Mỗi môn em bị hổng kiến thức đến mức nào?
Dialogue: 0,0:12:11.91,0:12:13.50,Default,,0,0,0,,Để em xem nào...
Dialogue: 0,0:12:14.12,0:12:18.20,Default,,0,0,0,,Những môn nào được tính là khoa học tự nhiên ấy nhỉ?
Dialogue: 0,0:12:18.20,0:12:19.79,Default,,0,0,0,,Toán học ạ?
Dialogue: 0,0:12:19.79,0:12:21.25,Default,,0,0,0,,Hóa học ạ?
Dialogue: 0,0:12:21.25,0:12:22.62,Default,,0,0,0,,Em phải hỏi lại từ mức độ sơ đẳng đó luôn á?!
Dialogue: 0,0:12:22.62,0:12:24.00,Default,,0,0,0,,Em xin lỗi ạ.
Dialogue: 0,0:12:24.00,0:12:26.66,Default,,0,0,0,,Thực ra là em ghét học chúng\Nhơn là học dốt ấy ạ.
Dialogue: 0,0:12:26.66,0:12:29.41,Default,,0,0,0,,Dù em có cố gắng cày cuốc thế nào thì chữ nghĩa cũng chẳng vào đầu được tẹo nào.
Dialogue: 0,0:12:29.41,0:12:30.95,Default,,0,0,0,,Chị hiểu rồi.
Dialogue: 0,0:12:31.25,0:12:33.20,Default,,0,0,0,,Được rồi. Chị biết phải làm gì rồi.
Dialogue: 0,0:12:34.16,0:12:36.12,Default,,0,0,0,,Nội dung bài thi gồm những gì nào?
Dialogue: 0,0:12:36.37,0:12:39.12,Default,,0,0,0,,Thực ra chị khá là thích toán và khoa học tự nhiên đấy.
Dialogue: 0,0:12:39.12,0:12:42.12,Default,,0,0,0,,Có khi cùng học chung với nhau\Nsẽ giúp em bớt ghét chúng hơn đấy.
Dialogue: 0,0:12:42.12,0:12:43.58,Default,,0,0,0,,Hội trưởng!
Dialogue: 0,0:12:44.29,0:12:47.37,Default,,0,0,0,,Nhân tiện thì điểm số của chị thế nào ạ?
Dialogue: 0,0:12:47.37,0:12:49.08,Default,,0,0,0,,Nếu chị không phiền khi em hỏi.
Dialogue: 0,0:12:50.75,0:12:52.37,Default,,0,0,0,,À thì...
Dialogue: 0,0:12:52.58,0:12:56.16,Default,,0,0,0,,Thỉnh thoảng chị cũng đứng đầu toàn khối đấy.
Dialogue: 0,0:12:56.16,0:12:57.66,Default,,0,0,0,,Thật... thật luôn á?!
Dialogue: 0,0:12:57.66,0:13:00.29,Default,,0,0,0,,Nhưng tính riêng từng môn thì chị chỉ đứng tầm thứ năm thôi.
Dialogue: 0,0:13:00.29,0:13:01.79,Default,,0,0,0,,Đúng kiểu môn nào cũng biết một chút nhưng chẳng môn nào xuất chúng cả.
Dialogue: 0,0:13:01.79,0:13:04.04,Default,,0,0,0,,Như thế cũng đã quá khủng khiếp rồi ạ!
Dialogue: 0,0:13:04.04,0:13:06.41,Default,,0,0,0,,Trong khi chị còn phải gánh vác bao nhiêu công việc của hội học sinh nữa chứ!
Dialogue: 0,0:13:06.41,0:13:09.25,Default,,0,0,0,,Chị đỉnh thật đấy, Hội trưởng!
Dialogue: 0,0:13:09.25,0:13:10.91,Default,,0,0,0,,Dẫu cho chị có là một kẻ biến th... À mà thôi bỏ đi ạ.
Dialogue: 0,0:13:10.91,0:13:13.45,Default,,0,0,0,,Kotobuki bất ngờ ghi điểm ngoạn mục!
Dialogue: 0,0:13:13.45,0:13:15.29,Default,,0,0,0,,Chúng ta bắt đầu học thôi nào.
Dialogue: 0,0:13:15.29,0:13:16.20,Default,,0,0,0,,Vâng ạ!
Dialogue: 0,0:13:17.12,0:13:19.20,Default,,0,0,0,,Mọi người đang học nhóm đấy à?
Dialogue: 0,0:13:19.45,0:13:21.66,Default,,0,0,0,,Bọn tớ sẽ phụ một tay nhé.
Dialogue: 0,0:13:21.66,0:13:24.66,Default,,0,0,0,,Gì cơ?! Chúng ta lại phải trông nom cho Ume nữa à?!
Dialogue: 0,0:13:24.66,0:13:26.62,Default,,0,0,0,,Tuyệt cú mèo. Mấy kẻ làm nền xuất hiện rồi kìa.
Dialogue: 0,0:13:26.83,0:13:28.91,Default,,0,0,0,,Dù sao thì kỳ thi cũng sắp đến nơi rồi mà.
Dialogue: 0,0:13:28.91,0:13:32.79,Default,,0,0,0,,Tớ cũng đang tò mò không biết em học hành các môn tự nhiên ra sao rồi.
Dialogue: 0,0:13:33.08,0:13:34.41,Default,,0,0,0,,Chị cũng biết chuyện đó ạ?
Dialogue: 0,0:13:34.41,0:13:35.70,Default,,0,0,0,,Xấu hổ quá đi mất...
Dialogue: 0,0:13:35.70,0:13:38.00,Default,,0,0,0,,Lần trước, em được 13 điểm môn Khoa Học,
Dialogue: 0,0:13:38.00,0:13:40.83,Default,,0,0,0,,4 điểm môn Toán, và 18 điểm môn Sinh Học.
Dialogue: 0,0:13:41.37,0:13:44.79,Default,,0,0,0,,Lần này ít nhất chúng ta phải cố gắng để không bị thi lại nhé.
Dialogue: 0,0:13:44.79,0:13:46.41,Default,,0,0,0,,Chị nắm rõ về em quá mức cần thiết rồi đấy!
Dialogue: 0,0:13:46.75,0:13:50.37,Default,,0,0,0,,Vậy thì tớ sẽ phụ trách kèm môn Sinh học và Hóa học nhé.
Dialogue: 0,0:13:50.87,0:13:52.45,Default,,0,0,0,,Thật sao ạ?
Dialogue: 0,0:13:52.45,0:13:54.95,Default,,0,0,0,,(Sinh Học Cơ Bản) (Hóa Học Cơ Bản)\NNói ra có thể cậu không tin, nhưng tớ khá giỏi mấy môn này đấy.
Dialogue: 0,0:13:54.95,0:13:58.00,Default,,0,0,0,,Tớ thậm chí còn từng đoạt giải ở kỳ thi IBO nữa cơ.
Dialogue: 0,0:13:58.00,0:13:59.41,Default,,0,0,0,,Cậu ấy là quái vật phương nào vậy trời!
Dialogue: 0,0:13:59.70,0:14:00.87,Default,,0,0,0,,IBO là Kỳ thi Olympic Sinh học Quốc tế,
Dialogue: 0,0:14:00.87,0:14:04.87,Default,,0,0,0,,một cuộc thi tầm cỡ thế giới dành cho học sinh trung học phổ thông.
Dialogue: 0,0:14:04.87,0:14:08.45,Default,,0,0,0,,Thực ra thì nghe đúng là phong cách của cậu thật...
Dialogue: 0,0:14:08.66,0:14:10.41,Default,,0,0,0,,Đúng như những gì em đã tưởng tượng sao...?
Dialogue: 0,0:14:11.79,0:14:13.54,Default,,0,0,0,,Cảm ơn em nhé!
Dialogue: 0,0:14:13.54,0:14:15.62,Default,,0,0,0,,Chị vốn rất yêu thích các sinh vật sống mà, em biết đấy.
Dialogue: 0,0:14:15.62,0:14:17.75,Default,,0,0,0,,Ơ, vâng ạ.
Dialogue: 0,0:14:17.75,0:14:19.16,Default,,0,0,0,,Thật là nhẹ nhõm quá đi...
Dialogue: 0,0:14:19.41,0:14:22.12,Default,,0,0,0,,Vậy ra cậu từng suýt soát bị lưu ban ở lại lớp hả Ume?
Dialogue: 0,0:14:22.12,0:14:24.45,Default,,0,0,0,,Đã thế còn đeo kính cận trông trí thức nữa chứ! Buồn cười vãi!
Dialogue: 0,0:14:24.45,0:14:25.66,Default,,0,0,0,,Cậu có chịu ngậm mồm lại giùm tôi không?!
Dialogue: 0,0:14:25.95,0:14:27.87,Default,,0,0,0,,Cậu vẫn còn là học sinh cấp hai cơ mà đúng không?
Dialogue: 0,0:14:27.87,0:14:30.29,Default,,0,0,0,,Đề thi của học sinh cấp ba khó nhằn lắm đấy nhé!
Dialogue: 0,0:14:30.29,0:14:31.66,Default,,0,0,0,,Đi chỗ khác chơi đi nhóc con.
Dialogue: 0,0:14:31.66,0:14:32.37,Default,,0,0,0,,À, thực ra thì,
Dialogue: 0,0:14:32.62,0:14:36.04,Default,,0,0,0,,Tan đã học xong phần khoa học máy tính và vật lý cấp đại học từ lâu rồi.
Dialogue: 0,0:14:36.04,0:14:37.95,Default,,0,0,0,,Em ấy thậm chí còn tự phát triển phần mềm nữa cơ.
Dialogue: 0,0:14:37.95,0:14:39.08,Default,,0,0,0,,Cái gì cơ?!
Dialogue: 0,0:14:39.87,0:14:42.58,Default,,0,0,0,,Giờ thì ai mới là nhóc con đây hả?
Dialogue: 0,0:14:42.58,0:14:45.20,Default,,0,0,0,,Mau cạo trọc đầu rồi quỳ xuống van xin tôi dạy cho đi!
Dialogue: 0,0:14:45.20,0:14:47.08,Default,,0,0,0,,Ý cậu là "cúi đầu cúi người" chứ gì...
Dialogue: 0,0:14:47.41,0:14:49.62,Default,,0,0,0,,Cậu làm thế là hơi quá đáng rồi đấy!
Dialogue: 0,0:14:49.62,0:14:54.20,Default,,0,0,0,,Dù sao thì môn khoa học coi như đã có người kèm cặp rồi.
Dialogue: 0,0:14:54.45,0:14:56.00,Default,,0,0,0,,Nhưng còn môn Toán...
Dialogue: 0,0:14:56.00,0:14:57.87,Default,,0,0,0,,À thì...
Dialogue: 0,0:14:57.87,0:14:59.25,Default,,0,0,0,,Môn Toán sao?
Dialogue: 0,0:14:59.41,0:15:01.41,Default,,0,0,0,,Tớ giỏi Toán lắm đấy.
Dialogue: 0,0:15:02.33,0:15:05.29,Default,,0,0,0,,Cậu á, Michinoku...?
Dialogue: 0,0:15:05.29,0:15:06.37,Default,,0,0,0,,Ừm.
Dialogue: 0,0:15:06.54,0:15:08.33,Default,,0,0,0,,Nhìn cậu ấy thế thôi chứ không ai ngờ được đâu,
Dialogue: 0,0:15:08.33,0:15:11.04,Default,,0,0,0,,cậu ấy được nhận học bổng toàn phần nhờ tài năng toán học xuất chúng đấy.
Dialogue: 0,0:15:11.04,0:15:12.83,Default,,0,0,0,,Khoan đã, thật luôn á?!
Dialogue: 0,0:15:12.83,0:15:16.37,Default,,0,0,0,,Thế sao nãy giờ lúc em đang lo sốt vó lên chị không nói sớm?!
Dialogue: 0,0:15:16.37,0:15:17.50,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:15:17.70,0:15:19.20,Default,,0,0,0,,Lúc nãy chị đang mắc vệ sinh quá.
Dialogue: 0,0:15:19.20,0:15:20.91,Default,,0,0,0,,Chị phải nói điều đó sớm hơn chứ!
Dialogue: 0,0:15:20.99,0:15:22.49,Default,,0,0,0,,(Hóa Học, Sinh Học, Toán Học)\NVậy là
Dialogue: 0,0:15:22.52,0:15:25.38,Default,,0,0,0,,(Khoa Học Máy Tính & Vật Lý, Tụ Hội Đầy Đủ)\Nchúng ta đang quy tụ toàn bộ những học sinh top đầu khối tự nhiên ở đây luôn!
Dialogue: 0,0:15:25.66,0:15:27.16,Default,,0,0,0,,Có vẻ là vậy rồi.
Dialogue: 0,0:15:27.33,0:15:30.04,Default,,0,0,0,,Chẳng lẽ cô Hiratsuka đã biết trước mọi chuyện sẽ diễn ra thế này,
Dialogue: 0,0:15:30.04,0:15:31.66,Default,,0,0,0,,nên mới cố tình nhét mình vào hội học sinh vì lý do đó sao?
Dialogue: 0,0:15:31.71,0:15:33.11,Default,,0,0,0,,Mizunoe này!
Dialogue: 0,0:15:33.29,0:15:35.62,Default,,0,0,0,,- Nhìn cô ấy có vẻ vô tư lự thế thôi,\N- Cho tớ mượn 100 yên đi!
Dialogue: 0,0:15:35.62,0:15:38.04,Default,,0,0,0,,nhưng thực ra cô ấy để ý quan sát nhiều hơn em tưởng đấy.
Dialogue: 0,0:15:38.54,0:15:41.12,Default,,0,0,0,,Vậy thì chúng ta bắt đầu vào việc luôn chứ nhỉ?
Dialogue: 0,0:15:41.12,0:15:43.54,Default,,0,0,0,,(Sinh Học Cơ Bản)\NVâng ạ! Cảm ơn mọi người đã giúp đỡ em!
Dialogue: 0,0:15:45.50,0:15:47.37,Default,,0,0,0,,Nó là hàm trơn từng khúc,
Dialogue: 0,0:15:47.37,0:15:51.79,Default,,0,0,0,,nên chuỗi Fourier sẽ hội tụ... và các điều kiện biên...
Dialogue: 0,0:15:51.79,0:15:53.79,Default,,0,0,0,,Mình chẳng hiểu một chữ bẻ đôi nào cả.
Dialogue: 0,0:15:54.04,0:15:55.08,Default,,0,0,0,,Vờn qua vờn lại...
Dialogue: 0,0:15:55.08,0:15:57.54,Default,,0,0,0,,- Hội trưởng đang hờn dỗi ở mức độ chưa từng thấy kìa!\N- Vờn qua vờn lại...
Dialogue: 0,0:15:57.79,0:15:59.58,Default,,0,0,0,,Không, không sao đâu mà...
Dialogue: 0,0:15:59.58,0:16:02.33,Default,,0,0,0,,Dù sao thì chị cũng chỉ là người môn nào cũng biết một tí thôi mà...
Dialogue: 0,0:16:02.33,0:16:03.70,Default,,0,0,0,,Không không không, không phải thế đâu ạ!
Dialogue: 0,0:16:04.83,0:16:06.75,Default,,0,0,0,,Khoan đã, vẫn còn một môn mà!
Dialogue: 0,0:16:06.75,0:16:09.29,Default,,0,0,0,,Một môn mà Hội trưởng từng đứng nhất toàn khối đấy!
Dialogue: 0,0:16:09.75,0:16:12.25,Default,,0,0,0,,Xin Hội trưởng hãy dạy em môn đó đi ạ!
Dialogue: 0,0:16:12.25,0:16:14.79,Default,,0,0,0,,Em biết đấy...
Dialogue: 0,0:16:15.00,0:16:16.54,Default,,0,0,0,,Chính là môn Giáo Dục Thể Chất & Sức Khỏe (Sinh Lý Giới Tính).
Dialogue: 0,0:16:18.91,0:16:21.62,Default,,0,0,0,,Chị... chị cũng không giỏi môn đó lắm đâu...
Dialogue: 0,0:16:21.62,0:16:23.91,Default,,0,0,0,,Việc gì Hội trưởng phải khiêm tốn thế ạ!
Dialogue: 0,0:16:23.91,0:16:26.58,Default,,0,0,0,,Đó là một môn học quan trọng gắn liền với đời sống hàng ngày mà.
Dialogue: 0,0:16:26.58,0:16:28.45,Default,,0,0,0,,Ume cũng học kém môn đó lắm.
Dialogue: 0,0:16:28.45,0:16:30.62,Default,,0,0,0,,(Giáo Dục Thể Chất & Sức Khỏe Cấp Ba)\NSao chị không dạy cho em ấy một bài học đàng hoàng tử tế đi?
Dialogue: 0,0:16:31.79,0:16:34.45,Default,,0,0,0,,Ơ... à thì...
Dialogue: 0,0:16:37.76,0:16:38.50,Default,,0,0,0,,(Lẩm bẩm)
Dialogue: 0,0:16:38.50,0:16:38.91,Default,,0,0,0,,Con gái thì...\N(Lẩm bẩm)
Dialogue: 0,0:16:38.91,0:16:41.04,Default,,0,0,0,,Con gái thì...
Dialogue: 0,0:16:42.37,0:16:43.66,Default,,0,0,0,,Được rồi đấy Hội trưởng ơi.
Dialogue: 0,0:16:43.66,0:16:45.12,Default,,0,0,0,,Chị không cần phải gượng ép bản thân đâu ạ.
Dialogue: 0,0:16:45.54,0:16:47.08,Default,,0,0,0,,Vậy thì bọn tớ để hai người tự nhiên nhé.
Dialogue: 0,0:16:47.08,0:16:49.58,Default,,0,0,0,,Em xin lỗi vì chuyện vừa rồi nhé Hội trưởng.
Dialogue: 0,0:16:51.45,0:16:55.33,Default,,0,0,0,,Rốt cuộc thì toàn bộ kiến thức đều do Kotobuki dạy cho cậu ấy.
Dialogue: 0,0:16:55.49,0:16:56.20,Default,,0,0,0,,(Ngày Hôm Sau)
Dialogue: 0,0:16:56.20,0:16:59.16,Default,,0,0,0,,Hai ngày liên tiếp thế này thì đuối thật đấy.\N(Ngày Hôm Sau)
Dialogue: 0,0:16:59.37,0:17:03.45,Default,,0,0,0,,Mizunoe sống một mình ở gần trường.
Dialogue: 0,0:17:03.75,0:17:06.62,Default,,0,0,0,,(DỪNG LẠI)\NNhưng công nhận Hội trưởng dạy học đỉnh thật.
Dialogue: 0,0:17:06.62,0:17:09.20,Default,,0,0,0,,Hôm nay mình còn kịp tạt qua siêu thị săn hàng giảm giá nữa chứ!
Dialogue: 0,0:17:09.20,0:17:10.29,Default,,0,0,0,,Tuyệt cú mèo!
Dialogue: 0,0:17:12.04,0:17:14.54,Default,,0,0,0,,Có khi mình sẽ làm món mì đút lò gratin tự nấu.\NLâu lắm rồi chưa ăn.
Dialogue: 0,0:17:17.25,0:17:18.33,Default,,0,0,0,,Nè nhóc!
Dialogue: 0,0:17:18.58,0:17:19.95,Default,,0,0,0,,Chị hai?!
Dialogue: 0,0:17:19.95,0:17:21.16,Default,,0,0,0,,Đó là quần lót của em mà!
Dialogue: 0,0:17:21.16,0:17:23.45,Default,,0,0,0,,Đúng rồi đấy. Là chị gái yêu dấu của em đây!
Dialogue: 0,0:17:23.87,0:17:26.54,Default,,0,0,0,,(Chị Gái Của Ume, Matsu Mizunoe)\NXin lỗi nhé, chị làm em giật mình à?
Dialogue: 0,0:17:26.70,0:17:29.83,Default,,0,0,0,,Chị vừa phải bay về Nhật Bản công tác một thời gian,
Dialogue: 0,0:17:29.83,0:17:33.87,Default,,0,0,0,,nên chị nghĩ là mình phải ghé qua thăm cậu em trai cưng trước tiên.
Dialogue: 0,0:17:34.37,0:17:35.25,Default,,0,0,0,,Em hiểu rồi.
Dialogue: 0,0:17:35.25,0:17:36.75,Default,,0,0,0,,Nhưng ít nhất chị cũng phải báo trước cho em một tiếng chứ!
Dialogue: 0,0:17:36.75,0:17:40.66,Default,,0,0,0,,Lần này là một dự án công việc khá lớn đấy.
Dialogue: 0,0:17:40.91,0:17:44.91,Default,,0,0,0,,Lần này chị thực sự dồn hết tâm huyết vào nó luôn.
Dialogue: 0,0:17:46.29,0:17:48.79,Default,,0,0,0,,Em không định khen thưởng chị một câu à?
Dialogue: 0,0:17:48.79,0:17:51.37,Default,,0,0,0,,Thì... chị đùng một cái xuất hiện thế này làm sao em kịp phản ứng chứ...
Dialogue: 0,0:17:51.66,0:17:52.66,Default,,0,0,0,,Mà này,
Dialogue: 0,0:17:52.66,0:17:55.20,Default,,0,0,0,,sao chị vẫn còn cầm quần sịp của em trên tay thế hả?
Dialogue: 0,0:17:56.00,0:18:00.16,Default,,0,0,0,,Chị đang kiểm tra xem em tự lập sống một mình có ổn không mà.
Dialogue: 0,0:18:00.16,0:18:02.04,Default,,0,0,0,,Bắt đầu từ đống đồ giặt của em trước tiên!
Dialogue: 0,0:18:02.04,0:18:03.37,Default,,0,0,0,,Làm ơn dẹp giùm em đi.
Dialogue: 0,0:18:03.37,0:18:06.20,Default,,0,0,0,,Thôi nào, em đâu còn là con nít ranh nữa đâu chứ!
Dialogue: 0,0:18:06.75,0:18:08.00,Default,,0,0,0,,Chị xin lỗi mà!
Dialogue: 0,0:18:08.41,0:18:11.66,Default,,0,0,0,,Tại chị cứ hay lo lắng cho cậu em trai đáng yêu của mình quá ấy chứ.
Dialogue: 0,0:18:13.70,0:18:16.37,Default,,0,0,0,,Đó là lý do vì sao chị mãi chẳng lấy được chồng đấy!
Dialogue: 0,0:18:16.37,0:18:17.66,Default,,0,0,0,,Không phải, chính cái tính đó mới là lý do chị ế chỏng gọng ra đấy.
Dialogue: 0,0:18:17.66,0:18:18.79,Default,,0,0,0,,Mau trả lại đây cho em!
Dialogue: 0,0:18:19.54,0:18:20.91,Default,,0,0,0,,Cơ mà Ume này,
Dialogue: 0,0:18:20.91,0:18:23.50,Default,,0,0,0,,dạo này trông em có vẻ khang khác thế nào ấy nhỉ.
Dialogue: 0,0:18:24.37,0:18:25.87,Default,,0,0,0,,Khác là khác làm sao cơ ạ?
Dialogue: 0,0:18:25.87,0:18:26.91,Default,,0,0,0,,Đúng rồi!
Dialogue: 0,0:18:27.25,0:18:30.62,Default,,0,0,0,,Trông em có vẻ đào hoa, hút gái hơn hẳn trước kia kìa!
Dialogue: 0,0:18:30.62,0:18:32.50,Default,,0,0,0,,Hóa ra nãy giờ chị lượn một vòng là để dẫn tới chuyện này đấy à?!
Dialogue: 0,0:18:32.50,0:18:34.70,Default,,0,0,0,,Khoan đã chị hai, đừng nói là...
Dialogue: 0,0:18:34.70,0:18:35.79,Default,,0,0,0,,Chuẩn đét!
Dialogue: 0,0:18:36.37,0:18:38.91,Default,,0,0,0,,Chị đã hack vào tài khoản LONE của em,
Dialogue: 0,0:18:39.12,0:18:41.00,Default,,0,0,0,,rồi tiện tay chặn hết sạch sành sanh tất cả con gái rồi nhé!
Dialogue: 0,0:18:41.00,0:18:43.87,Default,,0,0,0,,Đừng có làm mấy trò đó nữa! Lúc nào chị cũng bày trò này ra hết!
Dialogue: 0,0:18:43.87,0:18:46.95,Default,,0,0,0,,Ume bé bỏng của chị giờ đã có đàn bà vây quanh rồi cơ đấy!
Dialogue: 0,0:18:46.95,0:18:48.62,Default,,0,0,0,,Chị cảm thấy cô đơn tủi thân quá đi...
Dialogue: 0,0:18:48.62,0:18:51.08,Default,,0,0,0,,Lại bắt đầu làm lố lên nữa rồi kìa...
Dialogue: 0,0:18:51.08,0:18:55.33,Default,,0,0,0,,Chị nhớ những ngày em không có lấy một mống bạn bè\Nnhưng vẫn tỏ ra mình ổn ghê cơ!
Dialogue: 0,0:18:55.33,0:18:57.66,Default,,0,0,0,,Chị có biết nói như thế là độc mồm độc miệng lắm không hả?
Dialogue: 0,0:18:58.16,0:19:01.33,Default,,0,0,0,,Hay là em dọn sang Mỹ sống chung với chị đi?
Dialogue: 0,0:19:01.33,0:19:03.50,Default,,0,0,0,,Quên hết mấy đứa con gái đó đi cho rảnh nợ.
Dialogue: 0,0:19:03.50,0:19:05.29,Default,,0,0,0,,Chị đang lảm nhảm cái quái gì thế không biết?!
Dialogue: 0,0:19:05.62,0:19:07.00,Default,,0,0,0,,Xin chào!
Dialogue: 0,0:19:08.25,0:19:09.29,Default,,0,0,0,,Ume có nhà không!
Dialogue: 0,0:19:09.29,0:19:10.79,Default,,0,0,0,,Chào đằng ấy nhé!
Dialogue: 0,0:19:11.29,0:19:13.29,Default,,0,0,0,,Có chuyện gì mà hai người lại tới đây thế?
Dialogue: 0,0:19:13.29,0:19:14.50,Default,,0,0,0,,Xin lỗi vì đột ngột ghé qua thế này nhé.
Dialogue: 0,0:19:14.50,0:19:16.54,Default,,0,0,0,,Bọn tớ muốn hẹn gặp cậu ở bên ngoài,
Dialogue: 0,0:19:16.54,0:19:18.45,Default,,0,0,0,,nhưng lại không tài nào liên lạc được với cậu.
Dialogue: 0,0:19:18.45,0:19:20.29,Default,,0,0,0,,Mau lên nào, Komaro!
Dialogue: 0,0:19:20.79,0:19:23.45,Default,,0,0,0,,Bánh này do tớ tự làm trong tiết học nữ công gia chánh đấy.
Dialogue: 0,0:19:23.95,0:19:27.20,Default,,0,0,0,,Chị ấy muốn mang tặng cho em\Nnhưng lại ngại ngùng không đủ can đảm.
Dialogue: 0,0:19:27.20,0:19:28.62,Default,,0,0,0,,Bánh làm ra ngon lắm đấy.
Dialogue: 0,0:19:28.62,0:19:30.87,Default,,0,0,0,,Thật thế ạ?
Dialogue: 0,0:19:32.58,0:19:33.79,Default,,0,0,0,,Em cảm ơn chị nhiều nhé.
Dialogue: 0,0:19:37.54,0:19:38.75,Default,,0,0,0,,(Ngó đầu ra)\NHóa ra là hai cô em này à.
Dialogue: 0,0:19:38.75,0:19:40.62,Default,,0,0,0,,Chị đừng có nhìn người ta như nhìn con mồi thế có được không!
Dialogue: 0,0:19:40.62,0:19:43.25,Default,,0,0,0,,Ai thế kia?
Dialogue: 0,0:19:43.25,0:19:44.41,Default,,0,0,0,,Chị ấy là...
Dialogue: 0,0:19:44.41,0:19:45.79,Default,,0,0,0,,Chào các cô gái trẻ nhé!
Dialogue: 0,0:19:45.79,0:19:49.91,Default,,0,0,0,,Chị là Matsu Mizunoe, chị gái của Ume,\Nvà cũng là người yêu thương em ấy nhất trên cõi đời này!
Dialogue: 0,0:19:49.91,0:19:51.41,Default,,0,0,0,,Thôi đi chị ơi! Làm người ta ngượng chết đi được!
Dialogue: 0,0:19:51.41,0:19:52.29,Default,,0,0,0,,Ôi chà chà!
Dialogue: 0,0:19:52.29,0:19:56.00,Default,,0,0,0,,Em là Terui, tiền bối của Ume,\Nvà em cũng cực kỳ cưng chiều cậu ấy đấy ạ.
Dialogue: 0,0:19:56.00,0:19:57.75,Default,,0,0,0,,Cậu không cần phải hùa theo chị ấy đâu mà!
Dialogue: 0,0:19:57.75,0:20:00.04,Default,,0,0,0,,Tôi là Komaro. Tôi yêu Ume.
Dialogue: 0,0:20:00.04,0:20:01.33,Default,,0,0,0,,Đi thẳng vào vấn đề luôn cơ đấy?!
Dialogue: 0,0:20:01.33,0:20:03.29,Default,,0,0,0,,Tuyên bố hùng hồn ghê nhỉ...
Dialogue: 0,0:20:03.29,0:20:05.66,Default,,0,0,0,,Không phải đâu, đó chỉ là lời chào xã giao thôi mà!
Dialogue: 0,0:20:05.66,0:20:09.66,Default,,0,0,0,,Nhưng mấy đứa hiểu về Ume được bao nhiêu nào?
Dialogue: 0,0:20:10.45,0:20:12.79,Default,,0,0,0,,Chị đây biết tuốt tuồn tuột mọi thứ về em ấy.
Dialogue: 0,0:20:12.79,0:20:16.08,Default,,0,0,0,,Từ kích cỡ "của quý" mười năm trước của nó,
Dialogue: 0,0:20:16.08,0:20:19.12,Default,,0,0,0,,cho đến tận mật khẩu tài khoản phụ của nó luôn nhé!
Dialogue: 0,0:20:19.83,0:20:22.45,Default,,0,0,0,,Tôi biết kích thước bây giờ của cậu ấy.
Dialogue: 0,0:20:22.83,0:20:24.29,Default,,0,0,0,,To lắm.
Dialogue: 0,0:20:24.95,0:20:26.83,Default,,0,0,0,,Lúc tôi ngồi lên nó...
Dialogue: 0,0:20:26.83,0:20:29.29,Default,,0,0,0,,Có vẻ như mấy đứa cũng hiểu rõ về Ume gớm nhỉ.
Dialogue: 0,0:20:29.83,0:20:30.79,Default,,0,0,0,,To lắm cơ à...
Dialogue: 0,0:20:30.79,0:20:31.75,Default,,0,0,0,,Không phải, mọi chuyện hoàn toàn không như chị nghĩ đâu!
Dialogue: 0,0:20:31.75,0:20:34.00,Default,,0,0,0,,Với lại mấy cái thông tin đó thì có ích gì cho đời cơ chứ!
Dialogue: 0,0:20:34.00,0:20:37.37,Default,,0,0,0,,Nhưng mấy cái đó cũng chỉ là vẻ bề ngoài thôi.
Dialogue: 0,0:20:37.37,0:20:40.33,Default,,0,0,0,,Mấy đứa có thực sự hiểu con người bên trong của Ume không?
Dialogue: 0,0:20:40.91,0:20:44.04,Default,,0,0,0,,Chẳng hạn như, em ấy là người cực kỳ dễ cảm thấy cô đơn trống trải.
Dialogue: 0,0:20:44.04,0:20:46.33,Default,,0,0,0,,Cái hồi em ấy chưa kết bạn được với ai,
Dialogue: 0,0:20:46.33,0:20:48.62,Default,,0,0,0,,nó đã khóc ướt đẫm cả ngực áo của chị cơ đấy...
Dialogue: 0,0:20:49.41,0:20:51.54,Default,,0,0,0,,Mỗi khi ở một mình trông cậu ấy lúc nào cũng cô đơn thật sự,
Dialogue: 0,0:20:51.54,0:20:53.83,Default,,0,0,0,,cứ nhìn chằm chằm ra phía cửa ra vào suốt.
Dialogue: 0,0:20:53.83,0:20:55.50,Default,,0,0,0,,Nhìn bộ dạng đó cũng đáng yêu ghê.
Dialogue: 0,0:20:55.50,0:20:57.04,Default,,0,0,0,,Thật thế sao?
Dialogue: 0,0:20:57.04,0:20:58.75,Default,,0,0,0,,Làm sao mà mấy đứa lại biết được điều đó chứ?
Dialogue: 0,0:21:03.83,0:21:06.58,Default,,0,0,0,,Mấy cô bé này cừ khôi thật đấy!
Dialogue: 0,0:21:06.58,0:21:09.83,Default,,0,0,0,,Không có gì đâu ạ. Tụi em cũng rất thích nghe những câu chuyện của chị!
Dialogue: 0,0:21:10.04,0:21:12.87,Default,,0,0,0,,Mấy người này hợp cạ nhau đến lạ khi bàn về Ume.
Dialogue: 0,0:21:13.20,0:21:16.12,Default,,0,0,0,,Chắc tụi em phải xin phép về thôi ạ.
Dialogue: 0,0:21:16.12,0:21:18.16,Default,,0,0,0,,Sắp đến giờ cơm tối rồi.
Dialogue: 0,0:21:18.16,0:21:20.54,Default,,0,0,0,,Ra vậy à... Tiếc quá nhỉ.
Dialogue: 0,0:21:20.54,0:21:22.33,Default,,0,0,0,,Ume, tiễn khách đi em.
Dialogue: 0,0:21:22.33,0:21:24.33,Default,,0,0,0,,Cuối cùng mình cũng được giải thoát...
Dialogue: 0,0:21:24.33,0:21:27.54,Default,,0,0,0,,Ngày mai đến trường biết giấu mặt vào đâu bây giờ?
Dialogue: 0,0:21:27.54,0:21:28.66,Default,,0,0,0,,À!
Dialogue: 0,0:21:29.37,0:21:31.62,Default,,0,0,0,,- Bánh có ngon không?\N- Dạ có, ngon lắm ạ.
Dialogue: 0,0:21:31.62,0:21:32.70,Default,,0,0,0,,Ume!
Dialogue: 0,0:21:34.58,0:21:36.04,Default,,0,0,0,,Thế là tốt rồi.
Dialogue: 0,0:21:41.37,0:21:42.66,Default,,0,0,0,,Thôi đi mà hai người!
Dialogue: 0,0:21:43.66,0:21:45.00,Default,,0,0,0,,Ngại ngùng chết đi được!
Dialogue: 0,0:21:54.41,0:21:56.00,Default,,0,0,0,,Cậu đúng là cứng đầu cứng cổ thật đấy.
Dialogue: 0,0:21:58.83,0:21:59.91,Default,,0,0,0,,Vào ngày hôm đó,
Dialogue: 0,0:22:00.16,0:22:02.79,Default,,0,0,0,,toàn bộ đồ lót của Mizunoe đã không cánh mà bay.
Dialogue: 0,0:22:02.79,0:22:03.83,Default,,0,0,0,,(Hẹn gặp lại!)\NTạm biệt nhé!
Dialogue: 0,0:23:35.00,0:23:36.00,Default,,0,0,0,,(Hội Học Sinh Cũng Có Khiếm Khuyết!)\N(Giới Thiệu Tập Tiếp Theo)
Dialogue: 0,0:23:36.00,0:23:38.00,Default,,0,0,0,,(Komaro và Hòm Thư Góp Ý) (Bí Mật Của Terui♪)
Dialogue: 0,0:23:38.00,0:23:40.00,Default,,0,0,0,,(Koki và CLB Nhạc Nhẹ)\N(Hẹn Hò Lén Lút Trong Phòng Kho Thể Dục!!)
