Dialogue: 0,0:00:03.31,0:00:08.27,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)
Dialogue: 0,0:01:37.28,0:01:37.88,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:01:38.61,0:01:39.65,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:01:39.65,0:01:40.61,Default,,0,0,0,,Ngày Hôm Sau.
Dialogue: 0,0:01:40.61,0:01:40.87,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:01:41.44,0:01:43.45,Default,,0,0,0,,Phù, cuối cùng cũng được thở phào rồi!
Dialogue: 0,0:01:44.04,0:01:46.08,Default,,0,0,0,,Michinoku, trưa nay cậu muốn ăn gì thế?
Dialogue: 0,0:01:46.98,0:01:48.81,Default,,0,0,0,,À, phải rồi.
Dialogue: 0,0:01:49.58,0:01:49.83,Default,,0,0,0,,(Hội Học Sinh Học Viện Tosei)\N(Chanh) (Nghĩ lại thì chúng ta đã đi một chặng đường dài thật)
Dialogue: 0,0:01:50.59,0:01:50.84,Default,,0,0,0,,(Hội Học Sinh Học Viện Tosei)
Dialogue: 0,0:01:51.59,0:01:51.84,Default,,0,0,0,,(Hội Học Sinh Học Viện Tosei) (Chân của nó\Nmọc ra từ giữa thân luôn kìa)
Dialogue: 0,0:01:55.05,0:01:55.95,Default,,0,0,0,,Cơm nắm.
Dialogue: 0,0:01:56.31,0:01:56.74,Default,,0,0,0,,Hả?
Dialogue: 0,0:01:57.48,0:01:58.26,Default,,0,0,0,,Cậu ăn thử đi.
Dialogue: 0,0:01:59.76,0:02:02.76,Default,,0,0,0,,(Tập 7: Thử Thách Của Komaro)
Dialogue: 0,0:02:03.21,0:02:06.17,Default,,0,0,0,,Đây là mẫu thử cho loại cơm nắm\Nmình định đem bán ở trường đấy à?
Dialogue: 0,0:02:06.17,0:02:06.83,Default,,0,0,0,,Ừm.
Dialogue: 0,0:02:06.83,0:02:07.86,Default,,0,0,0,,Mọi người nếm thử đi.
Dialogue: 0,0:02:08.10,0:02:08.88,Default,,0,0,0,,(Hòm Thư Góp Ý)
Dialogue: 0,0:02:08.88,0:02:10.62,Default,,0,0,0,,Tụi mình nhận được đề xuất từ Hòm Thư Góp Ý,
Dialogue: 0,0:02:10.89,0:02:12.96,Default,,0,0,0,,xin bổ sung thêm vài món giá bình dân hơn.
Dialogue: 0,0:02:13.36,0:02:14.55,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:02:14.89,0:02:15.91,Default,,0,0,0,,Thật tình chứ,
Dialogue: 0,0:02:16.23,0:02:19.28,Default,,0,0,0,,Căng tin với Cửa hàng trường mình\Nlúc nào cũng rục rịch tăng giá bán.
Dialogue: 0,0:02:19.55,0:02:21.10,Default,,0,0,0,,Bên CLB Bóng chày cũng phàn nàn suốt.
Dialogue: 0,0:02:21.32,0:02:22.58,Default,,0,0,0,,Công nhận.
Dialogue: 0,0:02:22.98,0:02:23.96,Default,,0,0,0,,Cơ mà thoáng nhìn ban đầu,
Dialogue: 0,0:02:24.10,0:02:26.78,Default,,0,0,0,,chị cứ tưởng là cơm hộp "Tình Yêu Vợ Hiền Tự Nấu"\Ndành riêng cho cậu cơ đấy, Ume.
Dialogue: 0,0:02:27.11,0:02:28.17,Default,,0,0,0,,Hả!? Không, không, không phải đâu...!
Dialogue: 0,0:02:29.22,0:02:30.39,Default,,0,0,0,,Tôi cũng nghĩ y chang vậy luôn.
Dialogue: 0,0:02:30.85,0:02:31.95,Default,,0,0,0,,Nhưng mà Komaro này,
Dialogue: 0,0:02:32.35,0:02:34.62,Default,,0,0,0,,rốt cuộc em định bày bán kiểu gì đây?
Dialogue: 0,0:02:34.93,0:02:35.53,Default,,0,0,0,,À.
Dialogue: 0,0:02:35.67,0:02:36.00,Default,,0,0,0,,(Cơm Nắm)
Dialogue: 0,0:02:36.00,0:02:38.06,Default,,0,0,0,,(Cơm Nắm)\NBuổi sáng em sẽ tự tay nắm hết,
Dialogue: 0,0:02:38.06,0:02:41.10,Default,,0,0,0,,rồi giờ nghỉ trưa ra bày sạp ngoài sân trường\Nđể bán ạ.
Dialogue: 0,0:02:41.23,0:02:42.02,Default,,0,0,0,,Tự làm một mình luôn á?!
Dialogue: 0,0:02:42.02,0:02:43.15,Default,,0,0,0,,Thế thì quá sức lắm đấy...
Dialogue: 0,0:02:43.40,0:02:46.98,Default,,0,0,0,,Hay là mình đặt nhờ một quán ăn địa phương\Nlàm giúp xem sao.
Dialogue: 0,0:02:46.98,0:02:50.99,Default,,0,0,0,,Mỗi cái tốn khoảng 40 yên tiền nguyên liệu...
Dialogue: 0,0:02:51.32,0:02:52.06,Default,,0,0,0,,Vậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:02:52.06,0:02:52.81,Default,,0,0,0,,(Hả...)\NVậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:02:52.81,0:02:52.86,Default,,0,0,0,,Vậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:02:52.86,0:02:53.38,Default,,0,0,0,,(Tiền nguyên liệu: 40 yên,\NGiá bán: 40 yên,)
Dialogue: 0,0:02:53.38,0:02:55.32,Default,,0,0,0,,(Lợi nhuận: 0 yên)\NTỷ lệ chi phí 100% không lời một xu luôn kìa!
Dialogue: 0,0:02:55.79,0:02:58.53,Default,,0,0,0,,Tạm thời gác chuyện chi tiết sang một bên đã.
Dialogue: 0,0:02:58.78,0:02:59.75,Default,,0,0,0,,Ăn thử trước đi nào.
Dialogue: 0,0:03:00.07,0:03:00.81,Default,,0,0,0,,Nghe hợp lý đấy!
Dialogue: 0,0:03:02.40,0:03:04.57,Default,,0,0,0,,Để xem món này có làm hài lòng cái lưỡi\Nsành ăn tinh tế của tớ không nhé!
Dialogue: 0,0:03:04.72,0:03:05.62,Default,,0,0,0,,Lại bắt đầu chém gió nữa rồi!
Dialogue: 0,0:03:06.17,0:03:09.17,Default,,0,0,0,,Miệng thì nổ vang trời,\Nchứ khẩu vị của cậu y chang con nít ấy.
Dialogue: 0,0:03:09.43,0:03:11.02,Default,,0,0,0,,Nói linh tinh gì thế hả?
Dialogue: 0,0:03:11.02,0:03:12.13,Default,,0,0,0,,Tớ cực kỳ kén chọn đồ ăn đấy nhé!
Dialogue: 0,0:03:12.13,0:03:12.96,Default,,0,0,0,,(Lè lưỡi)\NTớ cực kỳ kén chọn đồ ăn đấy nhé!
Dialogue: 0,0:03:12.96,0:03:13.02,Default,,0,0,0,,Tớ cực kỳ kén chọn đồ ăn đấy nhé!
Dialogue: 0,0:03:13.23,0:03:15.21,Default,,0,0,0,,À nhân tiện, có sốt mayonnaise không cậu?
Dialogue: 0,0:03:15.50,0:03:17.73,Default,,0,0,0,,Gà rán đắt đỏ lắm đấy nhé.
Dialogue: 0,0:03:17.73,0:03:18.62,Default,,0,0,0,,Em xin lỗi.
Dialogue: 0,0:03:18.89,0:03:19.81,Default,,0,0,0,,Đúng khẩu vị trẻ thơ luôn chứ gì nữa.
Dialogue: 0,0:03:20.17,0:03:20.60,Default,,0,0,0,,(Họa Tiết Hôm Nay)
Dialogue: 0,0:03:20.60,0:03:21.83,Default,,0,0,0,,Nếm thử xem nào.
Dialogue: 0,0:03:23.04,0:03:24.25,Default,,0,0,0,,Ngon tuyệt cú mèo!
Dialogue: 0,0:03:24.41,0:03:25.58,Default,,0,0,0,,Ngon thật sự luôn ấy!
Dialogue: 0,0:03:25.58,0:03:26.85,Default,,0,0,0,,Nêm nếm vừa vặn chuẩn bài ghê.
Dialogue: 0,0:03:27.09,0:03:27.88,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:03:28.67,0:03:29.81,Default,,0,0,0,,Cái... gì bên trong đây?
Dialogue: 0,0:03:30.87,0:03:33.52,Default,,0,0,0,,Mực khô xé sợi đấy. Em hấp mềm ra rồi.
Dialogue: 0,0:03:33.52,0:03:34.51,Default,,0,0,0,,Mực khô cơ á?
Dialogue: 0,0:03:34.69,0:03:36.02,Default,,0,0,0,,Em tận dụng chút đồ thừa
Dialogue: 0,0:03:36.02,0:03:38.53,Default,,0,0,0,,còn sót lại ở nhà thầy giáo\Nđể tiết kiệm chi phí hết mức.
Dialogue: 0,0:03:38.53,0:03:40.24,Default,,0,0,0,,À, hóa ra vẫn còn dư ít ở đó nhỉ.
Dialogue: 0,0:03:40.54,0:03:42.41,Default,,0,0,0,,Khoan đã, thứ này ăn vào có sao không vậy...?
Dialogue: 0,0:03:43.17,0:03:44.72,Default,,0,0,0,,Cảm ơn vì bữa ăn!
Dialogue: 0,0:03:45.00,0:03:47.20,Default,,0,0,0,,- Ừm, ngon thì có ngon thật,\N- Để kích thích vị giác mọi người,
Dialogue: 0,0:03:47.20,0:03:47.83,Default,,0,0,0,,- Cơ mà,\N- Để kích thích vị giác mọi người,
Dialogue: 0,0:03:47.83,0:03:50.06,Default,,0,0,0,,- chẳng biết đem bán thế này có ổn không...\N- nên cho thêm gà rán vào nhé.
Dialogue: 0,0:03:50.06,0:03:51.11,Default,,0,0,0,,- Chị cũng thấy thế.\N- Ghi chú vào ngay.
Dialogue: 0,0:03:51.42,0:03:53.10,Default,,0,0,0,,Ngay cả khi mình đặt làm bên ngoài,
Dialogue: 0,0:03:53.10,0:03:55.10,Default,,0,0,0,,tụi mình vẫn phải tính toán lại giá cả lẫn phần nhân.
Dialogue: 0,0:03:55.24,0:03:56.80,Default,,0,0,0,,Nhân mực khô nghe chừng hơi quá đà thật...
Dialogue: 0,0:03:58.20,0:04:01.05,Default,,0,0,0,,Vậy nên phải nghĩ ra loại nhân nào\Nvừa rẻ mà vừa bán chạy rần rần.
Dialogue: 0,0:04:01.05,0:04:02.53,Default,,0,0,0,,Cơ mà nghĩ bằng cách nào mới được chứ?
Dialogue: 0,0:04:02.72,0:04:02.91,Default,,0,0,0,,(Xoạch!)
Dialogue: 0,0:04:02.91,0:04:04.11,Default,,0,0,0,,Chào cả nhà nhé!
Dialogue: 0,0:04:04.34,0:04:05.66,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:04:05.66,0:04:07.13,Default,,0,0,0,,Sao mặt mũi ai cũng xị xuống cả đống vậy?
Dialogue: 0,0:04:07.41,0:04:09.39,Default,,0,0,0,,À thì, tóm tắt ngắn gọn là...
Dialogue: 0,0:04:09.52,0:04:10.14,Default,,0,0,0,,Ừm, chị hiểu rồi.
Dialogue: 0,0:04:10.26,0:04:12.82,Default,,0,0,0,,Chuyện đó đúng là vấn đề nhức nhối lâu nay thật.
Dialogue: 0,0:04:12.89,0:04:13.25,Default,,0,0,0,,(Hừm)
Dialogue: 0,0:04:13.25,0:04:15.77,Default,,0,0,0,,Càng vì thế nên chị càng muốn\Nbiến dự án này thành hiện thực.
Dialogue: 0,0:04:16.67,0:04:18.03,Default,,0,0,0,,Sao cả đám không ghé qua nhà chị chơi thử xem?
Dialogue: 0,0:04:18.94,0:04:20.02,Default,,0,0,0,,Sao lại thế ạ?
Dialogue: 0,0:04:20.53,0:04:21.61,Default,,0,0,0,,À đúng rồi, nhắc mới nhớ...
Dialogue: 0,0:04:22.43,0:04:23.19,Default,,0,0,0,,Xin lỗi nhé,
Dialogue: 0,0:04:23.19,0:04:24.68,Default,,0,0,0,,hình như chị chưa từng kể với mọi người nhỉ!
Dialogue: 0,0:04:24.92,0:04:28.06,Default,,0,0,0,,Mấy đứa biết quán ăn Kotobuki\Ngần nhà ga chứ?
Dialogue: 0,0:04:28.16,0:04:29.23,Default,,0,0,0,,(Quán Ăn Kotobuki)\NĐó là quán của nhà chị đấy.
Dialogue: 0,0:04:29.35,0:04:30.13,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:30.52,0:04:32.96,Default,,0,0,0,,Ở quán có sẵn đầy đủ nguyên liệu\Nlẫn dụng cụ bếp núc,
Dialogue: 0,0:04:32.96,0:04:35.55,Default,,0,0,0,,nên rất lý tưởng để thử nghiệm\Nvà nghiên cứu công thức, đúng không nào?
Dialogue: 0,0:04:35.78,0:04:36.55,Default,,0,0,0,,Tuyệt vời quá đi mất!
Dialogue: 0,0:04:36.55,0:04:37.50,Default,,0,0,0,,Nghe ổn áp đấy chứ.
Dialogue: 0,0:04:37.77,0:04:39.67,Default,,0,0,0,,Hay quá rồi nhé, Komaro.
Dialogue: 0,0:04:39.84,0:04:40.90,Default,,0,0,0,,Em cảm ơn chị nhiều lắm!
Dialogue: 0,0:04:41.16,0:04:42.41,Default,,0,0,0,,Tụi mình có được ăn ké cơm nhân viên miễn phí không?
Dialogue: 0,0:04:42.74,0:04:44.29,Default,,0,0,0,,Thế bọn em xin phép không khách sáo đâu ạ!
Dialogue: 0,0:04:44.46,0:04:46.46,Default,,0,0,0,,Vậy hôm nào rảnh cả nhóm mình kéo sang nhé.
Dialogue: 0,0:04:46.61,0:04:46.98,Default,,0,0,0,,Ừ,
Dialogue: 0,0:04:47.30,0:04:47.76,Default,,0,0,0,,chốt thế đi.
Dialogue: 0,0:04:47.76,0:04:48.18,Default,,0,0,0,,(Rôm rả trò chuyện)
Dialogue: 0,0:04:48.18,0:04:50.15,Default,,0,0,0,,- Kotobuki... À, hèn chi nghe quen thế.\N- Tớ cũng ghé đó ăn vài lần rồi.
Dialogue: 0,0:04:50.15,0:04:52.21,Default,,0,0,0,,- Ra vậy.\N- Lần đầu tiên của tớ đấy. - Có cơm miễn phí thật hả? Ủa gì cơ?
Dialogue: 0,0:04:52.27,0:04:52.52,Default,,0,0,0,,(Ầm ầm...)
Dialogue: 0,0:04:52.52,0:04:53.22,Default,,0,0,0,,(Ầm ầm...)\NKhoan đã, chẳng lẽ điều này có nghĩa là
Dialogue: 0,0:04:53.22,0:04:53.43,Default,,0,0,0,,(Ầm ầm...)
Dialogue: 0,0:04:53.43,0:04:56.04,Default,,0,0,0,,Mizunoe cũng sắp tới nhà mình chơi luôn sao?!
Dialogue: 0,0:04:56.04,0:04:57.67,Default,,0,0,0,,Phải làm sao bây giờ trời ơi?!
Dialogue: 0,0:04:57.87,0:04:59.45,Default,,0,0,0,,(Ầm ầm...)\NChị Hai ồn ào quá trời quá đất!
Dialogue: 0,0:04:59.48,0:04:59.98,Default,,0,0,0,,(Mình còn thử cả kẹo muối các thứ nữa)
Dialogue: 0,0:04:59.98,0:05:02.69,Default,,0,0,0,,Tôi cũng thử qua cả kẹo muối nữa cơ.
Dialogue: 0,0:05:02.69,0:05:03.95,Default,,0,0,0,,Èo.
Dialogue: 0,0:05:03.95,0:05:06.10,Default,,0,0,0,,Mấy viên đó giúp chống sốc nhiệt tốt lắm đấy.
Dialogue: 0,0:05:06.34,0:05:07.69,Default,,0,0,0,,Cơ mà bây giờ đang là mùa đông mà...
Dialogue: 0,0:05:08.55,0:05:09.62,Default,,0,0,0,,(Quán Ăn Kotobuki)\NVà Thế Là,
Dialogue: 0,0:05:09.62,0:05:11.63,Default,,0,0,0,,Tới Ngày Thử Nghiệm Làm Cơm Nắm.
Dialogue: 0,0:05:11.70,0:05:11.98,Default,,0,0,0,,(Sột soạt, Lạch cạch)
Dialogue: 0,0:05:11.98,0:05:12.62,Default,,0,0,0,,(Sột soạt, Lạch cạch)\NXong xuôi!
Dialogue: 0,0:05:12.62,0:05:14.51,Default,,0,0,0,,Nguyên liệu coi như đầy đủ hết rồi đấy.
Dialogue: 0,0:05:14.69,0:05:17.91,Default,,0,0,0,,Tiếp theo, phải dọn bàn chế biến\Nvà dao thớt cho Komaro—
Dialogue: 0,0:05:17.91,0:05:18.79,Default,,0,0,0,,(Sột soạt, Lạch cạch)
Dialogue: 0,0:05:20.08,0:05:22.45,Default,,0,0,0,,(Mẹ Hội Trưởng (38), Mayuki Kotobuki)\NMẹ lúi húi làm cái gì nãy giờ thế hả, Mẹ?
Dialogue: 0,0:05:22.84,0:05:23.25,Default,,0,0,0,,(Bịch! Lạch cạch! Leng keng)
Dialogue: 0,0:05:23.25,0:05:26.66,Default,,0,0,0,,(Bịch! Lạch cạch! Leng keng)\NThì bạn bè của con sắp tới nhà chơi còn gì?
Dialogue: 0,0:05:26.66,0:05:29.48,Default,,0,0,0,,Mẹ định lôi mấy món đồ chiêu đãi đặc biệt\Ncủa mẹ ra tiếp khách chút mà...
Dialogue: 0,0:05:29.48,0:05:31.80,Default,,0,0,0,,Không, làm gì có thời gian cho mấy thứ đó! Để sau đi mẹ!
Dialogue: 0,0:05:32.02,0:05:33.34,Default,,0,0,0,,Tụi mình phải tập trung chuẩn bị trước đã...
Dialogue: 0,0:05:34.27,0:05:37.04,Default,,0,0,0,,Bánh yokan của tiệm Unrindo với yokan tiệm Kuraya...
Dialogue: 0,0:05:37.04,0:05:38.27,Default,,0,0,0,,Trộn lẫn lộn xà ngầu vào nhau hết trơn rồi!
Dialogue: 0,0:05:38.27,0:05:39.90,Default,,0,0,0,,Mẹ phải ngồi phân loại tụi nó ra đã!
Dialogue: 0,0:05:39.90,0:05:41.09,Default,,0,0,0,,Chuyện đó để sau không được à?!
Dialogue: 0,0:05:42.04,0:05:43.66,Default,,0,0,0,,Xin lỗi con, Hisako.
Dialogue: 0,0:05:43.66,0:05:46.83,Default,,0,0,0,,Mẹ lại cuống cuồng lo chuyện trớt quớt nữa rồi.
Dialogue: 0,0:05:47.16,0:05:48.79,Default,,0,0,0,,Nào! Xốc lại tinh thần giùm con đi.
Dialogue: 0,0:05:48.79,0:05:50.45,Default,,0,0,0,,Hôm nay quan trọng lắm đấy!
Dialogue: 0,0:05:50.45,0:05:51.62,Default,,0,0,0,,Phải rồi!
Dialogue: 0,0:05:51.62,0:05:57.33,Default,,0,0,0,,Khách khứa dạo gần đây cuối cùng cũng\Nbắt đầu khen ngợi mẹ rồi đấy.
Dialogue: 0,0:05:57.33,0:05:57.62,Default,,0,0,0,,(Vâng)
Dialogue: 0,0:05:57.62,0:05:58.70,Default,,0,0,0,,(Vâng)\NKhen mẹ á?
Dialogue: 0,0:05:58.70,0:05:59.58,Default,,0,0,0,,(Bận rộn, Căng tròn)\NĐúng thế!
Dialogue: 0,0:05:59.58,0:06:01.70,Default,,0,0,0,,Họ tấm tắc bảo rằng:\N'Cô Mayuki đúng là có cặp bưởi chất lượng thật.'
Dialogue: 0,0:06:01.70,0:06:02.62,Default,,0,0,0,,(Bận rộn, Căng tròn)\NQuá đỉnh! [Ngực khủng]
Dialogue: 0,0:06:02.62,0:06:04.08,Default,,0,0,0,,Chắc chắn ý họ không phải khen tài nấu ăn đâu mẹ ơi.
Dialogue: 0,0:06:04.08,0:06:06.62,Default,,0,0,0,,Mẹ bảo sẽ phụ tụi con thì làm ơn nghiêm túc giùm đi!
Dialogue: 0,0:06:06.62,0:06:09.16,Default,,0,0,0,,Con muốn giúp đỡ đàn em khóa dưới thật lòng đấy.
Dialogue: 0,0:06:09.16,0:06:10.20,Default,,0,0,0,,Mẹ đi vo gạo đi.
Dialogue: 0,0:06:10.20,0:06:11.50,Default,,0,0,0,,Tuân lệnh!
Dialogue: 0,0:06:11.75,0:06:15.00,Default,,0,0,0,,Bình thường Komaro rụt rè nhút nhát thế thôi,\Nchứ em ấy thật sự muốn dốc hết sức cho vụ này.
Dialogue: 0,0:06:15.00,0:06:19.91,Default,,0,0,0,,Tính con ở khoản này đúng là giống hệt\Nbố con ngày xưa đấy, Hisako ạ.
Dialogue: 0,0:06:19.91,0:06:21.50,Default,,0,0,0,,Ngầu ghê cơ.
Dialogue: 0,0:06:21.50,0:06:24.20,Default,,0,0,0,,Ông ấy lúc nào chẳng vậy.
Dialogue: 0,0:06:24.20,0:06:26.20,Default,,0,0,0,,- Công nhận ngầu thật sự. Ngầu phát ngất luôn.
Dialogue: 0,0:06:26.20,0:06:28.41,Default,,0,0,0,,- Con đã bảo là đừng có ngừng tay mà!\N- Đúng là ngầu bá cháy. Siêu ngầu luôn.
Dialogue: 0,0:06:28.62,0:06:30.75,Default,,0,0,0,,Nhưng mà ngoài chuyện đó ra, con còn một lý do khác
Dialogue: 0,0:06:30.75,0:06:33.41,Default,,0,0,0,,mới cuống cuồng háo hức tới vậy, đúng không?
Dialogue: 0,0:06:33.66,0:06:35.33,Default,,0,0,0,,Ume Mizunoe.
Dialogue: 0,0:06:35.33,0:06:36.66,Default,,0,0,0,,Sao mẹ lại biết tên cậu ấy?!
Dialogue: 0,0:06:36.66,0:06:38.62,Default,,0,0,0,,Thằng Taiga mách mẹ đấy.
Dialogue: 0,0:06:38.62,0:06:39.95,Default,,0,0,0,,Thằng Taiga kia!
Dialogue: 0,0:06:39.95,0:06:43.00,Default,,0,0,0,,Dạo gần đây chị Hai cứ lải nhải suốt ngày\Nvề cái anh tên Ume gì đó không ngừng luôn!
Dialogue: 0,0:06:43.00,0:06:43.91,Default,,0,0,0,,Mà chưa hết đâu nhé...
Dialogue: 0,0:06:43.91,0:06:45.66,Default,,0,0,0,,Nghe phong thanh thì hình như
Dialogue: 0,0:06:45.66,0:06:47.33,Default,,0,0,0,,hai đứa tụi bay tình tứ mặn nồng lắm thì phải.
Dialogue: 0,0:06:47.33,0:06:50.87,Default,,0,0,0,,À... Làm gì có chuyện đó.
Dialogue: 0,0:06:50.87,0:06:52.00,Default,,0,0,0,,Hở?
Dialogue: 0,0:06:52.00,0:06:53.20,Default,,0,0,0,,Tại mẹ cứ tưởng hôm bữa nghe thoáng qua\Nchuyện gì đó đại loại như con được...
Dialogue: 0,0:06:53.20,0:06:54.26,Default,,0,0,0,,dọn về làm dâu nhà người ta rồi chứ...
Dialogue: 0,0:06:54.26,0:06:55.50,Default,,0,0,0,,(Bắt thóp tại trận)\Ndọn về làm dâu nhà người ta rồi chứ...
Dialogue: 0,0:06:55.50,0:06:55.77,Default,,0,0,0,,(Bắt thóp tại trận)
Dialogue: 0,0:06:55.91,0:06:57.20,Default,,0,0,0,,Mẹ biết ngay mà!
Dialogue: 0,0:06:57.20,0:06:58.12,Default,,0,0,0,,Vậy tức là...
Dialogue: 0,0:06:58.12,0:07:00.33,Default,,0,0,0,,- Hai đứa đang quen nhau thật đúng không?\N- Không, đâu có phải!
Dialogue: 0,0:07:01.37,0:07:03.04,Default,,0,0,0,,Hai đứa... làm chuyện ấy rồi hả?!
Dialogue: 0,0:07:03.04,0:07:04.62,Default,,0,0,0,,Để con giải thích đã!
Dialogue: 0,0:07:04.91,0:07:06.41,Default,,0,0,0,,Toàn bộ đầu đuôi câu chuyện chỉ có thế thôi.
Dialogue: 0,0:07:06.62,0:07:07.58,Default,,0,0,0,,À.
Dialogue: 0,0:07:07.58,0:07:10.66,Default,,0,0,0,,Hóa ra vụ "rước về làm dâu" chỉ là hiểu nhầm trêu đùa thôi à.
Dialogue: 0,0:07:10.66,0:07:12.08,Default,,0,0,0,,Sao trông mặt mẹ thất vọng tràn trề thế kia?
Dialogue: 0,0:07:12.08,0:07:15.79,Default,,0,0,0,,Ngày xưa trạc tuổi con bây giờ là mẹ đã lấy chồng rồi đấy, Hisako.
Dialogue: 0,0:07:15.79,0:07:20.08,Default,,0,0,0,,Thế nên mẹ lúc nào cũng mong con sớm tìm được\Nmột người đặc biệt cho riêng mình.
Dialogue: 0,0:07:20.08,0:07:21.75,Default,,0,0,0,,Nên vừa nghe tới đó là mẹ mừng hụt quýnh quáng lên...
Dialogue: 0,0:07:21.75,0:07:23.16,Default,,0,0,0,,Xin lỗi con nhé.
Dialogue: 0,0:07:23.16,0:07:28.20,Default,,0,0,0,,Th-Thì nếu nói theo kiểu cảm mến thì... chắc cũng có chút xíu?
Dialogue: 0,0:07:28.62,0:07:29.95,Default,,0,0,0,,Thế thì tuyệt quá rồi còn gì!
Dialogue: 0,0:07:29.95,0:07:32.62,Default,,0,0,0,,Mẹ cũng chuẩn bị sẵn sàng hết cả rồi,
Dialogue: 0,0:07:32.62,0:07:34.70,Default,,0,0,0,,chỉ mong có dịp làm quen thân thiết hơn với bé Ume thôi!
Dialogue: 0,0:07:34.70,0:07:35.54,Default,,0,0,0,,Nhìn xem nè!
Dialogue: 0,0:07:35.54,0:07:37.33,Default,,0,0,0,,Tuyển Tập Ảnh Độc Quyền Của Hisako!
Dialogue: 0,0:07:37.33,0:07:38.33,Default,,0,0,0,,Dừng lại ngay!
Dialogue: 0,0:07:38.33,0:07:41.62,Default,,0,0,0,,(Giằng co)\NMẹ thức trắng cả đêm để lựa chọn từng tấm đấy nhé!
Dialogue: 0,0:07:41.62,0:07:43.70,Default,,0,0,0,,Gu thẩm mỹ về cái đẹp của mẹ có vấn đề nặng rồi đấy!
Dialogue: 0,0:07:43.70,0:07:43.98,Default,,0,0,0,,À phải rồi!
Dialogue: 0,0:07:43.98,0:07:44.45,Default,,0,0,0,,(Lấp lánh)\NÀ phải rồi!
Dialogue: 0,0:07:44.45,0:07:46.62,Default,,0,0,0,,(Lấp lánh)\NCòn một món nữa cơ!
Dialogue: 0,0:07:46.62,0:07:47.19,Default,,0,0,0,,(Lấp lánh)
Dialogue: 0,0:07:47.50,0:07:48.57,Default,,0,0,0,,Không cần làm tới mức đó đâu mà.
Dialogue: 0,0:07:48.57,0:07:49.15,Default,,0,0,0,,(Cốp)\NKhông cần làm tới mức đó đâu mà.
Dialogue: 0,0:07:49.15,0:07:50.25,Default,,0,0,0,,Không cần làm tới mức đó đâu mà.
Dialogue: 0,0:07:50.25,0:07:52.95,Default,,0,0,0,,Đằng nào cũng chỉ có mỗi mình con đơn phương thích cậu ấy thôi.
Dialogue: 0,0:07:56.37,0:07:57.83,Default,,0,0,0,,Mẹ cứ nghĩ nếu muốn hòa nhập tự nhiên\Nvới tụi học sinh cấp ba các con,
Dialogue: 0,0:07:57.83,0:08:00.37,Default,,0,0,0,,thì mặc đồng phục nữ sinh là chuẩn bài nhất.
Dialogue: 0,0:08:00.37,0:08:02.62,Default,,0,0,0,,Dù mẹ hơi quá tuổi mặc đồ này rồi,
Dialogue: 0,0:08:02.62,0:08:05.41,Default,,0,0,0,,nhưng mẹ đã thức cả đêm để ủi phẳng phiu đấy.
Dialogue: 0,0:08:06.04,0:08:07.50,Default,,0,0,0,,Làm ơn tha cho con đi...
Dialogue: 0,0:08:07.50,0:08:08.42,Default,,0,0,0,,Phải rồi,
Dialogue: 0,0:08:08.42,0:08:09.37,Default,,0,0,0,,(Sụt sịt)\NPhải rồi,
Dialogue: 0,0:08:09.37,0:08:11.87,Default,,0,0,0,,(Sụt sịt)\NDù sao mẹ cũng bước qua tuổi 30 mất rồi.
Dialogue: 0,0:08:11.87,0:08:12.45,Default,,0,0,0,,(Sụt sịt)
Dialogue: 0,0:08:12.45,0:08:14.58,Default,,0,0,0,,Con biết.
Dialogue: 0,0:08:14.58,0:08:16.68,Default,,0,0,0,,Mẹ 38 tuổi rồi đấy!
Dialogue: 0,0:08:16.68,0:08:17.04,Default,,0,0,0,,(Trộn bột)\NMẹ 38 tuổi rồi đấy!
Dialogue: 0,0:08:17.04,0:08:20.12,Default,,0,0,0,,(Trộn bột)\NKhông, chỉ là mẹ thấy hơi ngượng chút thôi.
Dialogue: 0,0:08:20.12,0:08:21.62,Default,,0,0,0,,Dù sao thì mình chẳng phải lo dọn dẹp chuẩn bị trước sao?
Dialogue: 0,0:08:21.62,0:08:22.66,Default,,0,0,0,,Xin phép làm phiền ạ!
Dialogue: 0,0:08:22.83,0:08:23.87,Default,,0,0,0,,Mọi người tới rồi kìa!
Dialogue: 0,0:08:24.25,0:08:24.41,Default,,0,0,0,,(Ủa...)
Dialogue: 0,0:08:24.41,0:08:25.73,Default,,0,0,0,,(Ủa...)\NMẹ mau chui vào trong lẹ lên!
Dialogue: 0,0:08:25.87,0:08:28.25,Default,,0,0,0,,- Mẹ?\N- Vào đi mấy đứa!
Dialogue: 0,0:08:28.25,0:08:29.95,Default,,0,0,0,,Sao mẹ lại chạy tót ra ngoài thế hả?!
Dialogue: 0,0:08:29.95,0:08:31.83,Default,,0,0,0,,Sao mẹ hồi phục tinh thần nhanh thế không biết?!
Dialogue: 0,0:08:31.83,0:08:32.79,Default,,0,0,0,,Thì...
Dialogue: 0,0:08:32.79,0:08:35.00,Default,,0,0,0,,Sao nỡ để bạn bè con phải đứng chờ ngoài cửa được chứ!
Dialogue: 0,0:08:35.00,0:08:36.16,Default,,0,0,0,,Cúi xuống nhìn bản thân đi mẹ.
Dialogue: 0,0:08:36.16,0:08:37.41,Default,,0,0,0,,Bộ đồ mẹ đang mặc kìa!
Dialogue: 0,0:08:37.79,0:08:39.12,Default,,0,0,0,,Mẹ đã mất bao công sức chuẩn bị bộ này còn gì!
Dialogue: 0,0:08:39.12,0:08:41.29,Default,,0,0,0,,Cho tụi nhỏ chiêm ngưỡng đúng một lần thôi!
Dialogue: 0,0:08:41.29,0:08:42.70,Default,,0,0,0,,Không khoe thì phí công lắm!
Dialogue: 0,0:08:42.70,0:08:45.00,Default,,0,0,0,,Đúng một lần đấy đủ khiến con mất mặt cả đời luôn!
Dialogue: 0,0:08:45.00,0:08:47.16,Default,,0,0,0,,- Mẹ có hiểu không hả?!\N- Xin phép tụi em vào nhà ạ!
Dialogue: 0,0:09:00.50,0:09:03.54,Default,,0,0,0,,Kh-Không, chuyện này không phải...
Dialogue: 0,0:09:03.70,0:09:07.04,Default,,0,0,0,,(Lễ Khai Giảng)
Dialogue: 0,0:09:07.04,0:09:08.94,Default,,0,0,0,,(Lễ Khai Giảng)\NCó Những Thứ Mãi Chẳng Đổi Thay.
Dialogue: 0,0:09:08.94,0:09:09.20,Default,,0,0,0,,(Quán Ăn Kotobuki)
Dialogue: 0,0:09:09.20,0:09:10.61,Default,,0,0,0,,Dù sao thì...
Dialogue: 0,0:09:10.66,0:09:13.00,Default,,0,0,0,,(Komaro)\NCô là mẹ của Hisako, tên Mayuki!
Dialogue: 0,0:09:13.00,0:09:14.62,Default,,0,0,0,,(Komaro)\NRất vui được gặp tất cả mấy đứa.
Dialogue: 0,0:09:14.62,0:09:15.79,Default,,0,0,0,,Cháu chào cô ạ.
Dialogue: 0,0:09:16.04,0:09:18.62,Default,,0,0,0,,Xin lỗi vì hồi nãy cô hơi quá trớn làm lố nhé.
Dialogue: 0,0:09:18.62,0:09:21.95,Default,,0,0,0,,Tại nghe tin bạn của con gái tới chơi\Nnên cô phấn khích quá đà ấy mà.
Dialogue: 0,0:09:21.95,0:09:23.58,Default,,0,0,0,,Không sao đâu ạ. Cháu không để bụng đâu.
Dialogue: 0,0:09:23.58,0:09:25.00,Default,,0,0,0,,Cháu cũng thấy bình thường ạ.
Dialogue: 0,0:09:25.00,0:09:26.04,Default,,0,0,0,,(Ánh mắt của một nữ sinh cấp ba\Nkhi nhìn thấy bộ đồ cosplay và áo ngực của mẹ bạn mình)
Dialogue: 0,0:09:26.04,0:09:27.83,Default,,0,0,0,,(trông thấy đồ cosplay và áo ngực của mẹ bạn)\NNhưng mà Hội trưởng ơi...
Dialogue: 0,0:09:28.04,0:09:29.58,Default,,0,0,0,,Cậu không sao chứ?
Dialogue: 0,0:09:29.91,0:09:31.75,Default,,0,0,0,,Xin lỗi nhé. Cảm ơn cậu.
Dialogue: 0,0:09:32.25,0:09:34.25,Default,,0,0,0,,Arisu.
Dialogue: 0,0:09:34.25,0:09:35.62,Default,,0,0,0,,Hửm?
Dialogue: 0,0:09:35.62,0:09:39.91,Default,,0,0,0,,Hai đứa kia đang quen nhau thật à?
Dialogue: 0,0:09:39.91,0:09:42.64,Default,,0,0,0,,(Háo hức!)\NChuyện đó thì... Cháu nên nói sao đây nhỉ?
Dialogue: 0,0:09:42.64,0:09:42.95,Default,,0,0,0,,Chuyện đó thì... Cháu nên nói sao đây nhỉ?
Dialogue: 0,0:09:42.95,0:09:45.29,Default,,0,0,0,,Ngay khoảnh khắc đó, trong đầu Arisu nảy số...
Dialogue: 0,0:09:45.29,0:09:49.00,Default,,0,0,0,,Hình như cô Mayuki đang hiểu nhầm chuyện gì đó rồi.
Dialogue: 0,0:09:49.00,0:09:52.20,Default,,0,0,0,,Chắc hẳn cô ấy nghe nhầm chuyện ở đâu đó thôi.
Dialogue: 0,0:09:52.20,0:09:52.73,Default,,0,0,0,,Tình hình đại khái là thế đấy, cơ mà...
Dialogue: 0,0:09:52.73,0:09:54.41,Default,,0,0,0,,(Háo hức!)\NTình hình đại khái là thế đấy, cơ mà...
Dialogue: 0,0:09:54.41,0:09:54.94,Default,,0,0,0,,(Háo hức!)\NVâng, chắc đúng vậy đấy ạ.
Dialogue: 0,0:09:54.94,0:09:57.70,Default,,0,0,0,,Vâng, chắc đúng vậy đấy ạ.
Dialogue: 0,0:09:58.20,0:10:01.25,Default,,0,0,0,,Nghe có vẻ vui phết nên chị quyết định hùa theo luôn.
Dialogue: 0,0:10:01.70,0:10:03.20,Default,,0,0,0,,Cuộc thử nghiệm bếp núc bắt đầu.
Dialogue: 0,0:10:03.41,0:10:06.54,Default,,0,0,0,,Chị gom sẵn cả đống nguyên liệu dùng được đây rồi.
Dialogue: 0,0:10:06.54,0:10:08.20,Default,,0,0,0,,Nhiều thật sự luôn!
Dialogue: 0,0:10:08.37,0:10:09.91,Default,,0,0,0,,Đây là cá hồi đúng không ạ?
Dialogue: 0,0:10:09.91,0:10:10.75,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:10.75,0:10:13.20,Default,,0,0,0,,Chị lấy phần vụn cá hồi cắt lọc để hạ giá thành xuống đấy!
Dialogue: 0,0:10:13.20,0:10:14.20,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:10:14.20,0:10:15.37,Default,,0,0,0,,Đúng đẳng cấp chị Hội trưởng!
Dialogue: 0,0:10:15.37,0:10:17.58,Default,,0,0,0,,Chị nấu ăn cũng khéo tay ghê.
Dialogue: 0,0:10:17.91,0:10:20.25,Default,,0,0,0,,Chị vẫn chưa sánh bằng tài nội trợ của cậu đâu, Mizunoe.
Dialogue: 0,0:10:20.25,0:10:21.79,Default,,0,0,0,,Arisu ơi, nhìn kìa!
Dialogue: 0,0:10:21.79,0:10:25.33,Default,,0,0,0,,Vâng, y hệt vợ chồng son luôn cô nhỉ.
Dialogue: 0,0:10:25.62,0:10:27.04,Default,,0,0,0,,Màn nếm thử hương vị.
Dialogue: 0,0:10:27.54,0:10:28.83,Default,,0,0,0,,Nước dùng này đậm đà quá đi mất!
Dialogue: 0,0:10:28.83,0:10:30.04,Default,,0,0,0,,Cháu gái có năng khiếu nấu nướng ghê thật đấy!
Dialogue: 0,0:10:30.04,0:10:31.16,Default,,0,0,0,,Quá chuẩn luôn cô.
Dialogue: 0,0:10:31.16,0:10:32.50,Default,,0,0,0,,Đúng là Hội trưởng có khác.
Dialogue: 0,0:10:32.50,0:10:33.91,Default,,0,0,0,,Ngon xuất sắc luôn!
Dialogue: 0,0:10:33.91,0:10:35.25,Default,,0,0,0,,Ngon thật đấy!
Dialogue: 0,0:10:35.25,0:10:36.25,Default,,0,0,0,,Đứa con gái bé bỏng của mẹ...
Dialogue: 0,0:10:36.25,0:10:37.07,Default,,0,0,0,,Ăn... ngon lắm đúng không?
Dialogue: 0,0:10:37.07,0:10:38.79,Default,,0,0,0,,(Thì thầm)\NĂn... ngon lắm đúng không?
Dialogue: 0,0:10:38.79,0:10:39.75,Default,,0,0,0,,(Thì thầm)\NVâng ạ!
Dialogue: 0,0:10:39.75,0:10:40.16,Default,,0,0,0,,(Thì thầm)
Dialogue: 0,0:10:40.16,0:10:43.33,Default,,0,0,0,,Đấy, chị đã bảo mà!
Dialogue: 0,0:10:44.00,0:10:45.00,Default,,0,0,0,,Anh Ume!
Dialogue: 0,0:10:45.00,0:10:46.29,Default,,0,0,0,,(Kéo tay)\NTớ giữ đây rồi!
Dialogue: 0,0:10:46.29,0:10:46.37,Default,,0,0,0,,Tớ giữ đây rồi!
Dialogue: 0,0:10:46.37,0:10:48.00,Default,,0,0,0,,Cẩn thận đấy!
Dialogue: 0,0:10:48.71,0:10:48.87,Default,,0,0,0,,(Giật mình!)
Dialogue: 0,0:10:48.87,0:10:49.79,Default,,0,0,0,,(Giật mình!)\NArisu kìa!
Dialogue: 0,0:10:49.79,0:10:51.00,Default,,0,0,0,,(Giật mình!)\NCô bé kia là...
Dialogue: 0,0:10:51.00,0:10:54.66,Default,,0,0,0,,Vâng, y chang hai bố con luôn đấy cô.
Dialogue: 0,0:10:55.37,0:10:57.00,Default,,0,0,0,,Hai bố con cơ á?
Dialogue: 0,0:10:57.00,0:10:58.87,Default,,0,0,0,,Đúng rồi. Bé đó tên Komaro.
Dialogue: 0,0:10:58.87,0:11:00.83,Default,,0,0,0,,Có người trong hội còn gọi ba người họ là...
Dialogue: 0,0:11:00.83,0:11:01.04,Default,,0,0,0,,(Chỉ có mình Arisu)\NCó người còn gọi họ là...
Dialogue: 0,0:11:01.04,0:11:01.25,Default,,0,0,0,,(Chỉ có mình Arisu)
Dialogue: 0,0:11:01.25,0:11:04.12,Default,,0,0,0,,(Chỉ có mình Arisu)\NMẹ Hisako, Bố Ume và bé con Komaro đấy ạ.
Dialogue: 0,0:11:04.12,0:11:04.33,Default,,0,0,0,,(Chỉ có mình Arisu)
Dialogue: 0,0:11:04.33,0:11:05.25,Default,,0,0,0,,Vậy tức là
Dialogue: 0,0:11:05.25,0:11:07.41,Default,,0,0,0,,con bé chính là cháu ngoại của cô à?!
Dialogue: 0,0:11:07.41,0:11:09.35,Default,,0,0,0,,Chuẩn không cần chỉnh luôn!
Dialogue: 0,0:11:09.35,0:11:09.83,Default,,0,0,0,,(Gật gù... Gật gù...)\NChuẩn không cần chỉnh luôn!
Dialogue: 0,0:11:09.83,0:11:13.66,Default,,0,0,0,,(Gật gù...)\NKomaro à, lại đây nấu cùng bà ngoại nào!
Dialogue: 0,0:11:13.66,0:11:14.57,Default,,0,0,0,,(Gật gù...)\NVâng ạ!
Dialogue: 0,0:11:14.70,0:11:18.28,Default,,0,0,0,,(Nắn tạo hình)
Dialogue: 0,0:11:18.45,0:11:19.62,Default,,0,0,0,,Komaro!
Dialogue: 0,0:11:19.62,0:11:23.12,Default,,0,0,0,,Cháu khum bàn tay ôm phần cơm như thế này\Nthì nắn ra nắm cơm vuông vức đẹp mắt ngay.
Dialogue: 0,0:11:23.12,0:11:24.25,Default,,0,0,0,,Như thế này ạ?
Dialogue: 0,0:11:24.25,0:11:27.37,Default,,0,0,0,,Cháu nhớ ép thành góc cạnh ngay ngắn kiểu này nè.
Dialogue: 0,0:11:27.62,0:11:29.45,Default,,0,0,0,,Cháu hiểu rồi ạ!
Dialogue: 0,0:11:31.54,0:11:33.42,Default,,0,0,0,,Hóa ra cảm giác có cháu ngoại nó hạnh phúc nhường này!
Dialogue: 0,0:11:33.42,0:11:34.00,Default,,0,0,0,,(1. Gân Bò Hầm Nhừ\N2. Cá Hồi Vụn Tẩm Gia Vị)
Dialogue: 0,0:11:34.00,0:11:35.66,Default,,0,0,0,,(3. Ức Gà Chiên Xù)\NHoàn thành rồi!
Dialogue: 0,0:11:36.04,0:11:37.25,Default,,0,0,0,,Nhìn hấp dẫn quá trời!
Dialogue: 0,0:11:37.25,0:11:38.58,Default,,0,0,0,,Trông ngon phát thèm luôn!
Dialogue: 0,0:11:38.58,0:11:40.04,Default,,0,0,0,,May quá đi!
Dialogue: 0,0:11:40.04,0:11:41.54,Default,,0,0,0,,Được rồi, cùng nếm thử thành quả nào!
Dialogue: 0,0:11:41.54,0:11:42.54,Default,,0,0,0,,Vâng!
Dialogue: 0,0:11:43.45,0:11:45.37,Default,,0,0,0,,Mời cả nhà dùng bữa!
Dialogue: 0,0:11:45.37,0:11:46.45,Default,,0,0,0,,Ngon xỉu luôn!
Dialogue: 0,0:11:46.45,0:11:48.41,Default,,0,0,0,,Mấy đứa làm hoàn hảo tuyệt đối rồi!
Dialogue: 0,0:11:48.75,0:11:50.12,Default,,0,0,0,,Hoan hô!
Dialogue: 0,0:11:50.66,0:11:52.37,Default,,0,0,0,,Mặt cậu dính hạt cơm kìa.
Dialogue: 0,0:11:52.37,0:11:53.75,Default,,0,0,0,,Cảm ơn cậu.
Dialogue: 0,0:11:53.75,0:11:55.75,Default,,0,0,0,,Arisu ơi, cảnh tượng này...
Dialogue: 0,0:11:55.75,0:11:56.83,Default,,0,0,0,,Vâng.
Dialogue: 0,0:11:56.83,0:11:58.66,Default,,0,0,0,,Đúng chuẩn đại gia đình tam đại đồng đường luôn.
Dialogue: 0,0:11:58.66,0:12:01.00,Default,,0,0,0,,Biết ngay mà! Phải làm sao bây giờ trời?!
Dialogue: 0,0:12:01.37,0:12:03.54,Default,,0,0,0,,Cảm ơn cô và mọi người đã giúp đỡ hết lòng hôm nay ạ.
Dialogue: 0,0:12:03.54,0:12:07.08,Default,,0,0,0,,Nhờ có hai cô con gái... à nhờ hai người mà công việc tiến triển vượt bậc luôn.
Dialogue: 0,0:12:07.08,0:12:09.20,Default,,0,0,0,,Có gì đâu. Thành quả chung của cả nhóm mà.
Dialogue: 0,0:12:09.20,0:12:11.75,Default,,0,0,0,,Đừng khách sáo thế chứ.
Dialogue: 0,0:12:12.20,0:12:13.83,Default,,0,0,0,,Và, cô Mayuki ạ...
Dialogue: 0,0:12:15.16,0:12:16.62,Default,,0,0,0,,Lần tới, làm ơn hãy...
Dialogue: 0,0:12:16.83,0:12:19.41,Default,,0,0,0,,cho cháu thưởng thức tài nấu ăn của cô Mayuki nhé.
Dialogue: 0,0:12:19.41,0:12:20.08,Default,,0,0,0,,(Ý cậu ta là món của Quán Ăn)\Ncho cháu thưởng thức món của cô nhé, cô Mayuki.
Dialogue: 0,0:12:23.75,0:12:24.66,Default,,0,0,0,,Anh yêu ơi!
Dialogue: 0,0:12:24.66,0:12:27.58,Default,,0,0,0,,Hôm nay em vừa có thêm cháu ngoại,
Dialogue: 0,0:12:27.58,0:12:30.00,Default,,0,0,0,,lại còn được trai trẻ tỏ tình nữa nè!
Dialogue: 0,0:12:30.00,0:12:30.75,Default,,0,0,0,,Dừng lại giùm con đi!
Dialogue: 0,0:12:30.75,0:12:34.70,Default,,0,0,0,,Năm 25 tuổi, ông cưới cô nàng Mayuki 18 tuổi,
Dialogue: 0,0:12:34.70,0:12:38.58,Default,,0,0,0,,rồi nghỉ việc về kế thừa luôn quán ăn nhà vợ.
Dialogue: 0,0:12:39.75,0:12:40.75,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:12:41.00,0:12:41.87,Default,,0,0,0,,(Đề Án Cơm Nắm Bình Dân:)\NXong xuôi rồi!
Dialogue: 0,0:12:41.87,0:12:43.50,Default,,0,0,0,,(Đề Án Cơm Nắm Bình Dân:)\NBản đề án cơm nắm đã hoàn tất mỹ mãn,
Dialogue: 0,0:12:43.66,0:12:45.37,Default,,0,0,0,,tất cả là nhờ công sức của chị Hội trưởng và cô Mayuki!
Dialogue: 0,0:12:45.37,0:12:47.20,Default,,0,0,0,,Mọi thứ ghép lại ăn khớp mượt mà ghê!
Dialogue: 0,0:12:47.20,0:12:49.70,Default,,0,0,0,,Họ còn sẵn sàng nhận luôn khâu chế biến sản xuất nữa chứ.
Dialogue: 0,0:12:49.70,0:12:51.87,Default,,0,0,0,,Thật sự biết ơn gia đình chị không để đâu cho hết!
Dialogue: 0,0:12:52.04,0:12:53.12,Default,,0,0,0,,Cứ giao hết cho cô lo!
Dialogue: 0,0:12:53.12,0:12:55.25,Default,,0,0,0,,Vì cậu con rể Ume và cháu ngoại Komaro cả mà.
Dialogue: 0,0:12:55.25,0:12:56.91,Default,,0,0,0,,Sẵn tiện quảng bá luôn thương hiệu quán mình nữa!
Dialogue: 0,0:12:56.91,0:12:58.08,Default,,0,0,0,,Cháu ngoại cơ á?
Dialogue: 0,0:12:58.08,0:13:00.75,Default,,0,0,0,,Tính cả tiền công rồi thì giá bán chỉ có 70 yên mỗi cái thôi.
Dialogue: 0,0:13:00.75,0:13:03.87,Default,,0,0,0,,Thế là đủ biến nguyện vọng của Michinoku thành hiện thực rồi.
Dialogue: 0,0:13:03.87,0:13:05.70,Default,,0,0,0,,Giá hời không tưởng đối với mọi tiêu chuẩn luôn đấy!
Dialogue: 0,0:13:05.70,0:13:08.37,Default,,0,0,0,,Giờ chỉ còn lo khâu xin phép bày bán nữa thôi.
Dialogue: 0,0:13:08.60,0:13:09.04,Default,,0,0,0,,(Phòng Hành Chính - Giáo Vụ)
Dialogue: 0,0:13:09.04,0:13:10.06,Default,,0,0,0,,(Phòng Hành Chính - Giáo Vụ)\NÀ, chuyện này thì hơi khó giải quyết đấy.
Dialogue: 0,0:13:10.06,0:13:10.08,Default,,0,0,0,,À, chuyện này thì hơi khó giải quyết đấy.
Dialogue: 0,0:13:10.08,0:13:13.16,Default,,0,0,0,,(Nhân viên Hành chính, Yoshino Saegusa)\NÀ, chuyện này thì hơi khó giải quyết đấy.
Dialogue: 0,0:13:13.16,0:13:13.79,Default,,0,0,0,,À, chuyện này thì hơi khó giải quyết đấy.
Dialogue: 0,0:13:14.20,0:13:16.25,Default,,0,0,0,,T-Tại sao vậy ạ?
Dialogue: 0,0:13:16.25,0:13:19.95,Default,,0,0,0,,Cửa hàng trường do đơn vị nhà thầu bên ngoài vận hành,
Dialogue: 0,0:13:19.95,0:13:23.54,Default,,0,0,0,,nên học sinh không được phép can thiệp vào đâu.
Dialogue: 0,0:13:23.54,0:13:25.08,Default,,0,0,0,,Chẳng phải tôn chỉ của trường mình\Nlà đề cao tinh thần chủ động của học sinh
Dialogue: 0,0:13:25.08,0:13:26.91,Default,,0,0,0,,và luôn ủng hộ mọi nỗ lực sáng tạo\Ncủa tụi em sao ạ?
Dialogue: 0,0:13:26.91,0:13:30.37,Default,,0,0,0,,luôn hết mình hỗ trợ học sinh mà?
Dialogue: 0,0:13:30.37,0:13:32.79,Default,,0,0,0,,Em không nghĩ đề xuất này đi ngược lại tôn chỉ đó.
Dialogue: 0,0:13:32.79,0:13:35.70,Default,,0,0,0,,Chúng em đã tính toán kỹ lưỡng thực đơn khả thi hết rồi.
Dialogue: 0,0:13:35.70,0:13:37.20,Default,,0,0,0,,Cô hiểu. Cô hiểu rất rõ chứ.
Dialogue: 0,0:13:37.20,0:13:39.58,Default,,0,0,0,,Cô rất trân trọng công sức các em bỏ ra cho việc này,
Dialogue: 0,0:13:39.58,0:13:41.41,Default,,0,0,0,,nhưng nhỡ học sinh đổ xô mua cơm nắm mà bỏ mặc\Nmấy món khác thì sao?
Dialogue: 0,0:13:41.41,0:13:42.79,Default,,0,0,0,,Thế thì thành rắc rối to còn gì, đúng không?
Dialogue: 0,0:13:42.79,0:13:45.04,Default,,0,0,0,,Thời buổi này kinh doanh chỗ nào cũng khó khăn cả,
Dialogue: 0,0:13:45.04,0:13:47.41,Default,,0,0,0,,nên chắc chắn bên nhà thầu cũng sẽ lâm vào cảnh khốn đốn đấy.
Dialogue: 0,0:13:47.41,0:13:49.25,Default,,0,0,0,,Thì...
Dialogue: 0,0:13:49.25,0:13:50.66,Default,,0,0,0,,Nhân tiện đây,
Dialogue: 0,0:13:50.66,0:13:52.70,Default,,0,0,0,,giá bán tại cửa hàng trường mình\Ncao hơn mặt bằng chung khá nhiều đấy ạ.
Dialogue: 0,0:13:52.70,0:13:55.16,Default,,0,0,0,,đắt hơn mặt bằng chung khá đáng kể luôn.
Dialogue: 0,0:13:55.16,0:13:57.58,Default,,0,0,0,,Cô giải thích chuyện đó thế nào đây?
Dialogue: 0,0:13:58.33,0:14:01.87,Default,,0,0,0,,Ừ thì, công nhận cũng hơi nhỉnh giá một chút thật.
Dialogue: 0,0:14:02.04,0:14:05.04,Default,,0,0,0,,Nhưng giá cả còn phụ thuộc vào chi phí và mặt bằng nữa.
Dialogue: 0,0:14:05.04,0:14:06.87,Default,,0,0,0,,Chuyện định giá là quyền của bên nhà thầu.
Dialogue: 0,0:14:06.87,0:14:08.33,Default,,0,0,0,,Cô cũng không nắm rõ chi tiết bên trong đâu.
Dialogue: 0,0:14:08.62,0:14:11.00,Default,,0,0,0,,Thôi, tóm lại là xin lỗi các em nhé!
Dialogue: 0,0:14:11.00,0:14:11.91,Default,,0,0,0,,Chào tạm biệt.
Dialogue: 0,0:14:12.25,0:14:15.33,Default,,0,0,0,,Xin phép cô, về tập hồ sơ kia...
Dialogue: 0,0:14:17.08,0:14:18.58,Default,,0,0,0,,Ca này căng thật rồi.
Dialogue: 0,0:14:18.58,0:14:19.91,Default,,0,0,0,,Ừ.
Dialogue: 0,0:14:19.91,0:14:22.50,Default,,0,0,0,,Chẳng lẽ không còn cách nào thật sao?
Dialogue: 0,0:14:22.50,0:14:24.70,Default,,0,0,0,,Một kế hoạch đôi bên cùng có lợi...
Dialogue: 0,0:14:24.70,0:14:26.12,Default,,0,0,0,,Không, phải là diệu kế xuất thần!
Dialogue: 0,0:14:26.12,0:14:27.95,Default,,0,0,0,,Không, một nước đi lật ngược hoàn toàn thế cờ!
Dialogue: 0,0:14:28.16,0:14:30.16,Default,,0,0,0,,Phải nghĩ ra đối sách trước giờ tan học thôi.
Dialogue: 0,0:14:30.16,0:14:31.10,Default,,0,0,0,,(Cựa quậy)
Dialogue: 0,0:14:31.10,0:14:31.37,Default,,0,0,0,,(Bịch!)
Dialogue: 0,0:14:31.37,0:14:32.62,Default,,0,0,0,,(Bịch!)\NMichinoku!
Dialogue: 0,0:14:32.62,0:14:33.31,Default,,0,0,0,,Ừm
Dialogue: 0,0:14:33.31,0:14:33.58,Default,,0,0,0,,Hở?
Dialogue: 0,0:14:33.58,0:14:34.91,Default,,0,0,0,,Cậu tới đây từ lúc nào thế?
Dialogue: 0,0:14:34.91,0:14:36.54,Default,,0,0,0,,Mà cái bọc vải to đùng kia là gì vậy?
Dialogue: 0,0:14:36.54,0:14:38.08,Default,,0,0,0,,Đồ mang đi cho mọi người nếm thử đấy.
Dialogue: 0,0:14:38.83,0:14:42.75,Default,,0,0,0,,Bên CLB Bóng chày khen Cơm Nắm ngon nức nở luôn.
Dialogue: 0,0:14:42.95,0:14:45.04,Default,,0,0,0,,Ồ... Thế thì tuyệt quá rồi.
Dialogue: 0,0:14:45.04,0:14:45.79,Default,,0,0,0,,Ừm!
Dialogue: 0,0:14:45.79,0:14:48.12,Default,,0,0,0,,Tớ làm khoảng 30 nắm lận đấy.
Dialogue: 0,0:14:48.12,0:14:49.37,Default,,0,0,0,,Nhiều dữ vậy!
Dialogue: 0,0:14:49.37,0:14:52.20,Default,,0,0,0,,- Có cơm trắng với lại nhân bên trong.\N- Chưa đầy 30 giây đã bay sạch bách.
Dialogue: 0,0:14:52.50,0:14:53.70,Default,,0,0,0,,- Cảm ơn nhiều lắm luôn nhé!\N- Chắc đám đó đói meo râu rồi.
Dialogue: 0,0:14:53.70,0:14:55.08,Default,,0,0,0,,Mà này,
Dialogue: 0,0:14:56.45,0:14:58.83,Default,,0,0,0,,Komaro, cậu ăn trưa chưa thế?
Dialogue: 0,0:14:59.20,0:15:00.62,Default,,0,0,0,,Tớ quên béng mất.
Dialogue: 0,0:15:00.62,0:15:03.37,Default,,0,0,0,,Nắm tận 30 cái cơm nắm mà chẳng chừa phần mình à...
Dialogue: 0,0:15:03.37,0:15:05.62,Default,,0,0,0,,Thôi được rồi, ăn chung hộp cơm trưa với tớ nè.
Dialogue: 0,0:15:05.62,0:15:08.25,Default,,0,0,0,,Này Ume, chuyện rắc rối hồi nãy cậu gặp phải...
Dialogue: 0,0:15:08.25,0:15:09.54,Default,,0,0,0,,Vụ cơm nắm ấy à?
Dialogue: 0,0:15:10.41,0:15:12.04,Default,,0,0,0,,Không... Thì...
Dialogue: 0,0:15:12.54,0:15:13.70,Default,,0,0,0,,...Phải đấy.
Dialogue: 0,0:15:15.50,0:15:18.08,Default,,0,0,0,,Không có gì đâu.\NTụi mình vẫn đang thương lượng với Văn phòng Hành chính.
Dialogue: 0,0:15:18.08,0:15:20.00,Default,,0,0,0,,Gặp chút trục trặc nhỏ thôi ấy mà.
Dialogue: 0,0:15:20.00,0:15:23.08,Default,,0,0,0,,Nhưng tớ nhất định sẽ cố hết sức để thuyết phục họ.
Dialogue: 0,0:15:26.33,0:15:27.87,Default,,0,0,0,,Tớ xin lỗi.
Dialogue: 0,0:15:31.95,0:15:33.25,Default,,0,0,0,,Không đâu.
Dialogue: 0,0:15:33.25,0:15:35.29,Default,,0,0,0,,Sao tự dưng lại xin lỗi chứ?
Dialogue: 0,0:15:35.29,0:15:38.08,Default,,0,0,0,,Mới chỉ là lần đàm phán đầu tiên thôi mà.
Dialogue: 0,0:15:38.08,0:15:39.25,Default,,0,0,0,,Nhìn dáng vẻ bề ngoài vậy thôi,
Dialogue: 0,0:15:39.25,0:15:41.37,Default,,0,0,0,,chứ thật ra tớ giỏi khoản thương thuyết lắm đấy nhé.
Dialogue: 0,0:15:41.58,0:15:44.33,Default,,0,0,0,,Chỉ cần ngồi lại nói chuyện thẳng thắn tử tế,\Ntớ tin chắc mọi chuyện sẽ ổn thôi.
Dialogue: 0,0:15:44.33,0:15:47.00,Default,,0,0,0,,Đúng rồi. Chỉ cần mình trình bày rõ ràng là được.
Dialogue: 0,0:15:47.00,0:15:47.80,Default,,0,0,0,,Vậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:15:47.80,0:15:48.55,Default,,0,0,0,,(Hả...)\NVậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:15:48.55,0:15:48.59,Default,,0,0,0,,Vậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:15:48.59,0:15:49.01,Default,,0,0,0,,(Tiền nguyên liệu: 40 yên, Giá bán: 40 yên)\NVậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:15:49.01,0:15:49.37,Default,,0,0,0,,Vậy nên em định bán mỗi cái đúng 40 yên ạ?
Dialogue: 0,0:15:49.37,0:15:52.41,Default,,0,0,0,,Đây là nguyện vọng mà bạn học đã cất công\Nbỏ vào hòm thư góp ý.
Dialogue: 0,0:15:56.95,0:15:59.45,Default,,0,0,0,,Rồi mọi chuyện sẽ ổn thỏa thôi. Tớ hứa đấy!
Dialogue: 0,0:16:03.29,0:16:04.41,Default,,0,0,0,,Ume...
Dialogue: 0,0:16:05.33,0:16:06.66,Default,,0,0,0,,Cậu nói đúng.
Dialogue: 0,0:16:06.83,0:16:08.87,Default,,0,0,0,,Chính xác. Tụi mình chắc chắn làm được.
Dialogue: 0,0:16:08.95,0:16:09.12,Default,,0,0,0,,(Tan)
Dialogue: 0,0:16:09.12,0:16:10.87,Default,,0,0,0,,(Tan)\NArisu? Có chuyện gì thế?
Dialogue: 0,0:16:10.87,0:16:11.16,Default,,0,0,0,,Arisu? Có chuyện gì thế?
Dialogue: 0,0:16:11.16,0:16:14.25,Default,,0,0,0,,Hay tụi mình tung chiêu lách luật siêu hạng đi?!
Dialogue: 0,0:16:14.25,0:16:14.82,Default,,0,0,0,,(Thể thơ Tanka 5-7-5-7-7)
Dialogue: 0,0:16:18.83,0:16:20.37,Default,,0,0,0,,(Phòng Tổng Vụ)
Dialogue: 0,0:16:22.37,0:16:23.50,Default,,0,0,0,,Xin phép làm phiền cô ạ.
Dialogue: 0,0:16:23.50,0:16:23.54,Default,,0,0,0,,Ai đấy?
Dialogue: 0,0:16:23.54,0:16:23.92,Default,,0,0,0,,(Cót két)\NAi đấy?
Dialogue: 0,0:16:23.92,0:16:24.54,Default,,0,0,0,,Ai đấy?
Dialogue: 0,0:16:24.95,0:16:28.00,Default,,0,0,0,,Lại là mấy đứa các em nữa à?
Dialogue: 0,0:16:28.00,0:16:31.12,Default,,0,0,0,,Cô có thể bớt chút thời gian nữa cho tụi em được không ạ?
Dialogue: 0,0:16:31.66,0:16:34.25,Default,,0,0,0,,Mấy đứa tưởng nhân viên Văn phòng Hành chính\Nngồi chơi xơi nước rảnh rỗi lắm hay sao?
Dialogue: 0,0:16:34.25,0:16:35.87,Default,,0,0,0,,Cô thật sự bận ngập đầu đấy nhé.
Dialogue: 0,0:16:37.58,0:16:41.12,Default,,0,0,0,,Cô đã lén lút ăn tiền hoa hồng hối lộ từ\Ncác nhà cung cấp cho cửa hàng trường, đúng không ạ?
Dialogue: 0,0:16:41.12,0:16:41.81,Default,,0,0,0,,(Kính gửi cô Saegusa:)
Dialogue: 0,0:16:43.60,0:16:44.16,Default,,0,0,0,,(Phòng Hội Học Sinh)\NBiển thủ tiền á?
Dialogue: 0,0:16:44.16,0:16:45.16,Default,,0,0,0,,(Phòng Hội Học Sinh)\NBiển thủ tiền á?
Dialogue: 0,0:16:45.16,0:16:47.75,Default,,0,0,0,,Vâng. Giá bánh mì bán ở cửa hàng trường mình
Dialogue: 0,0:16:47.75,0:16:50.16,Default,,0,0,0,,từ trước tới nay vẫn luôn hơi bị đội giá lên.
Dialogue: 0,0:16:50.45,0:16:52.12,Default,,0,0,0,,Và đây chính là nguyên nhân.
Dialogue: 0,0:16:52.12,0:16:53.50,Default,,0,0,0,,Phiếu quà tặng á?
Dialogue: 0,0:16:53.50,0:16:56.08,Default,,0,0,0,,Nghe nói nhân viên bên đó đã mang tới tận nơi\Nvà đưa phiếu quà tặng để đổi lấy việc ký hợp đồng.
Dialogue: 0,0:16:56.08,0:17:00.41,Default,,0,0,0,,nhận hối lộ bằng phiếu quà tặng\Nđể ký duyệt hợp đồng cho họ.
Dialogue: 0,0:17:00.41,0:17:02.25,Default,,0,0,0,,Thô thiển rẻ tiền phát ớn.
Dialogue: 0,0:17:02.58,0:17:05.83,Default,,0,0,0,,Nếu tụi mình đem bằng chứng này ra đối chất với cô ta...
Dialogue: 0,0:17:05.83,0:17:07.79,Default,,0,0,0,,(Lầm bầm)
Dialogue: 0,0:17:08.79,0:17:10.12,Default,,0,0,0,,Phiền phức chết đi được.
Dialogue: 0,0:17:10.50,0:17:12.95,Default,,0,0,0,,Tôi cứ tưởng mấy đứa hùng hổ xông vào đây\Ncó chuyện gì ghê gớm lắm chứ.
Dialogue: 0,0:17:12.95,0:17:16.20,Default,,0,0,0,,Mấy thứ đó chỉ là trùng hợp thôi! Trùng hợp ngẫu nhiên đấy!
Dialogue: 0,0:17:16.20,0:17:18.58,Default,,0,0,0,,Chỉ là tôi lỡ quên khai báo số phiếu quà tặng đó thôi.
Dialogue: 0,0:17:18.58,0:17:20.95,Default,,0,0,0,,Hoàn toàn chẳng có chút khuất tất sai phạm nào cả.
Dialogue: 0,0:17:20.95,0:17:22.95,Default,,0,0,0,,Mấy đứa tự biến mình thành trò cười thì có!
Dialogue: 0,0:17:22.95,0:17:23.43,Default,,0,0,0,,Nói thẳng ra là tụi bay ngu ngốc hết chỗ nói.
Dialogue: 0,0:17:23.43,0:17:25.06,Default,,0,0,0,,(Cộp)\NNói thẳng ra là tụi bay ngu ngốc hết chỗ nói.
Dialogue: 0,0:17:25.06,0:17:25.75,Default,,0,0,0,,Nói thẳng ra là tụi bay ngu ngốc hết chỗ nói.
Dialogue: 0,0:17:25.75,0:17:29.50,Default,,0,0,0,,Đám giáo viên trong trường ai cũng quý tôi lắm đấy nhé.
Dialogue: 0,0:17:29.50,0:17:31.00,Default,,0,0,0,,Đến chuyện đơn giản thế mà cũng không biết à...?
Dialogue: 0,0:17:31.00,0:17:32.41,Default,,0,0,0,,Khoan đã nào...
Dialogue: 0,0:17:32.41,0:17:34.66,Default,,0,0,0,,Chẳng biết tụi bay đào đâu ra đống này,
Dialogue: 0,0:17:34.66,0:17:35.49,Default,,0,0,0,,(Lướt)\NHành vi xâm nhập email trái phép và tống tiền.
Dialogue: 0,0:17:35.49,0:17:36.95,Default,,0,0,0,,Xâm nhập email trái phép và âm mưu tống tiền.
Dialogue: 0,0:17:36.95,0:17:40.29,Default,,0,0,0,,Tôi sẽ trình báo hết lên ban giám hiệu.
Dialogue: 0,0:17:40.29,0:17:43.08,Default,,0,0,0,,Hèn hạ thật đấy! Đã thế thì...
Dialogue: 0,0:17:43.08,0:17:45.00,Default,,0,0,0,,Xem ra không còn cách nào khác rồi.
Dialogue: 0,0:17:45.91,0:17:49.29,Default,,0,0,0,,Em thật sự muốn ○ thầy Tanaka quá đi.
Dialogue: 0,0:17:49.95,0:17:51.33,Default,,0,0,0,,Chị Terui?
Dialogue: 0,0:17:51.33,0:17:54.29,Default,,0,0,0,,Cái đầu hói của thầy hiệu trưởng bóng loáng không tì vết.\NEm tôn thờ nó luôn.
Dialogue: 0,0:17:54.29,0:17:56.66,Default,,0,0,0,,Có con khỉ mò tới nhìn trộm,\Nnên mình ép hai bầu ngực lại khoe khe cho nó ngắm.
Dialogue: 0,0:17:56.66,0:17:57.66,Default,,0,0,0,,Cảm giác sướng phê pha không tả nổi!
Dialogue: 0,0:17:57.66,0:17:58.95,Default,,0,0,0,,Hưng phấn quá đi mất, bé ○○ của chị ơi!
Dialogue: 0,0:17:58.95,0:18:01.87,Default,,0,0,0,,Trường cấp ba đúng là chốn thiên đường ○○ hoàn mỹ.
Dialogue: 0,0:18:01.87,0:18:04.20,Default,,0,0,0,,Phần lớn mấy dòng đó cổ đăng vào lúc đêm khuya thanh vắng đấy.
Dialogue: 0,0:18:04.20,0:18:06.91,Default,,0,0,0,,Chắc uống vài ly xong thấy cô đơn lẻ loi ấy nhỉ?
Dialogue: 0,0:18:06.91,0:18:08.37,Default,,0,0,0,,Vậy thì, chẳng lẽ nào...?
Dialogue: 0,0:18:09.95,0:18:12.08,Default,,0,0,0,,Mấy đứa lôi mấy thứ đó từ đâu ra thế...?
Dialogue: 0,0:18:12.08,0:18:14.04,Default,,0,0,0,,Cô phải cẩn thận cái miệng lại nhé.
Dialogue: 0,0:18:14.04,0:18:17.04,Default,,0,0,0,,Mấy thương hiệu địa phương dễ bị lần ra danh tính lắm đấy.
Dialogue: 0,0:18:17.04,0:18:18.91,Default,,0,0,0,,Cơ mà công nhận...
Dialogue: 0,0:18:18.91,0:18:21.54,Default,,0,0,0,,Khỉ với chả gà... vân vân mây mây...
Dialogue: 0,0:18:21.54,0:18:22.87,Default,,0,0,0,,Ôi trời ơi...
Dialogue: 0,0:18:23.16,0:18:27.91,Default,,0,0,0,,Người đẹp mà sao lại túng thiếu tới mức đó thế hả cô.
Dialogue: 0,0:18:29.45,0:18:32.79,Default,,0,0,0,,Sao nào, cô thấy thế nào?\NCòn định chạy đi mách lẻo với giáo viên nữa không?
Dialogue: 0,0:18:33.08,0:18:34.70,Default,,0,0,0,,(Thở dốc, Nảy, Ồ!)\NKh-Không... Đâu cần thiết phải làm tới mức đó...
Dialogue: 0,0:18:34.70,0:18:37.12,Default,,0,0,0,,(Thở dốc, Nảy, Ồ!)\NVậy tụi em được phép bán Cơm Nắm chưa ạ?
Dialogue: 0,0:18:37.12,0:18:38.62,Default,,0,0,0,,Tôi sẽ dốc toàn lực hỗ trợ hết mình.
Dialogue: 0,0:18:38.62,0:18:41.50,Default,,0,0,0,,Từ giờ trở đi cô sẽ ngoan ngoãn nghe lời bọn em chứ?
Dialogue: 0,0:18:41.50,0:18:42.79,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:18:42.79,0:18:43.62,Default,,0,0,0,,Hết nói nổi luôn.
Dialogue: 0,0:18:43.62,0:18:47.70,Default,,0,0,0,,Mizunoe thấm thía bài học sâu sắc rằng\Ntuyệt đối đừng bao giờ chọc giận người phụ nữ này.
Dialogue: 0,0:18:48.08,0:18:49.62,Default,,0,0,0,,Xin lỗi vì đột ngột gọi cậu qua đây nhé.
Dialogue: 0,0:18:49.62,0:18:52.29,Default,,0,0,0,,Có chuyện gì thế? Sao tự nhiên gọi tớ ra đây?
Dialogue: 0,0:18:52.54,0:18:53.66,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:18:53.66,0:18:55.54,Default,,0,0,0,,Nhiều đồ lỉnh kỉnh quá trời.
Dialogue: 0,0:18:56.16,0:18:58.12,Default,,0,0,0,,Làm ghế kê chân cho tôi bước lên chút nào.
Dialogue: 0,0:18:59.12,0:19:00.16,Default,,0,0,0,,(Cửa Hàng Trường)
Dialogue: 0,0:19:00.45,0:19:02.12,Default,,0,0,0,,Được rồi, cuối cùng thì...
Dialogue: 0,0:19:02.29,0:19:03.66,Default,,0,0,0,,(Quán Ăn Kotobuki:)\NQuầy Trưng Bày Cơm Nắm!
Dialogue: 0,0:19:03.66,0:19:05.12,Default,,0,0,0,,(Cơm Nắm Ba Thế Hệ)\NHoàn thành rồi!
Dialogue: 0,0:19:05.37,0:19:07.87,Default,,0,0,0,,Cơm Nắm Ba Thế Hệ của cô Mayuki.
Dialogue: 0,0:19:07.87,0:19:09.91,Default,,0,0,0,,Tên nghe hơi dị một chút, nhưng chị ưng cái bụng rồi đấy!
Dialogue: 0,0:19:10.08,0:19:11.62,Default,,0,0,0,,Tớ tự tay làm đấy!
Dialogue: 0,0:19:11.62,0:19:13.54,Default,,0,0,0,,Cơm Nắm Ba Thế Hệ.
Dialogue: 0,0:19:13.54,0:19:16.20,Default,,0,0,0,,Cơ mà tớ thích tên Cơm Nắm Komaro hơn cơ.
Dialogue: 0,0:19:17.16,0:19:18.13,Default,,0,0,0,,Và cảm ơn cô Saegusa đã đứng quầy\Nthu ngân giúp tụi em nhé.
Dialogue: 0,0:19:18.13,0:19:21.08,Default,,0,0,0,,(Thu ngân)\NVà cảm ơn cô Saegusa đứng quầy thu ngân giùm nhé.
Dialogue: 0,0:19:21.08,0:19:22.58,Default,,0,0,0,,(Thu ngân)\NĐúng là lũ nhóc phiền phức.
Dialogue: 0,0:19:22.58,0:19:23.95,Default,,0,0,0,,Ít nhất cũng phải giữ chút tôn trọng với tôi chứ.
Dialogue: 0,0:19:23.95,0:19:25.91,Default,,0,0,0,,(Ba Thế Hệ)\NThiệt tình, tại sao mình lại phải đi...
Dialogue: 0,0:19:25.91,0:19:28.08,Default,,0,0,0,,Thông cảm nhé cô, tại bên em đang thiếu nhân lực.
Dialogue: 0,0:19:28.08,0:19:31.16,Default,,0,0,0,,Chẳng phải còn đầy người hợp việc thu ngân này hơn tôi sao?
Dialogue: 0,0:19:31.16,0:19:34.20,Default,,0,0,0,,Tôi đường đường tốt nghiệp đại học quốc gia danh giá đấy nhé.
Dialogue: 0,0:19:34.20,0:19:35.29,Default,,0,0,0,,Đúng vậy thật.
Dialogue: 0,0:19:35.29,0:19:37.79,Default,,0,0,0,,Nhưng mà cô Saegusa khéo lại thó tiền quỹ mất.
Dialogue: 0,0:19:37.79,0:19:39.91,Default,,0,0,0,,Tôi không có làm thế! Đừng nói toẹt ra giữa bàn dân thiên hạ vậy chứ!
Dialogue: 0,0:19:40.16,0:19:42.95,Default,,0,0,0,,Chết tiệt, mấy đồng xu 10 yên này\Ncó đủ tiền lẻ thối lại không đấy?
Dialogue: 0,0:19:42.95,0:19:44.04,Default,,0,0,0,,(Cơm Nắm Nhật Bản)\NĐược rồi.
Dialogue: 0,0:19:44.04,0:19:46.20,Default,,0,0,0,,(Cơm Nắm Nhật Bản)\NLiệu cô ấy làm ổn không đây?
Dialogue: 0,0:19:46.37,0:19:46.45,Default,,0,0,0,,(Rầm, Rầm, Rầm, Rầm)
Dialogue: 0,0:19:46.45,0:19:48.16,Default,,0,0,0,,(Rầm, Rầm, Rầm, Rầm)\N- Mở cửa rồi! - Tuyệt vời!
Dialogue: 0,0:19:48.16,0:19:50.66,Default,,0,0,0,,(Rầm, Rầm, Rầm, Rầm)\NCuối cùng cũng khai trương rồi! Mọi người tới ủng hộ nào!
Dialogue: 0,0:19:50.66,0:19:52.66,Default,,0,0,0,,- Toàn bộ hội viên CLB Bơi Lội đấy à!\N- Trước giờ Hội học sinh giúp tụi mình nhiều lắm mà.
Dialogue: 0,0:19:52.66,0:19:54.16,Default,,0,0,0,,Vừa rẻ bèo mà nhìn lại ngon lành cành đào thế này!
Dialogue: 0,0:19:54.16,0:19:56.16,Default,,0,0,0,,Nào anh em! Mua càng nhiều càng tốt nhé!
Dialogue: 0,0:19:56.16,0:19:57.66,Default,,0,0,0,,Cảm ơn mọi người đã ủng hộ!
Dialogue: 0,0:19:57.66,0:19:59.38,Default,,0,0,0,,(Leng keng)
Dialogue: 0,0:20:00.45,0:20:01.70,Default,,0,0,0,,Muốn tớ gác giùm một lát không?
Dialogue: 0,0:20:01.70,0:20:03.08,Default,,0,0,0,,- Này!\N- Hoan hô!
Dialogue: 0,0:20:03.08,0:20:04.25,Default,,0,0,0,,Xin chào!
Dialogue: 0,0:20:04.25,0:20:05.58,Default,,0,0,0,,Ở đây có vụ gì xôm tụ thế?
Dialogue: 0,0:20:05.58,0:20:08.37,Default,,0,0,0,,Sạp bán cơm nắm do Hội học sinh mở đấy!
Dialogue: 0,0:20:09.66,0:20:11.33,Default,,0,0,0,,Vậy cho tôi lấy hai cái đi.
Dialogue: 0,0:20:11.58,0:20:13.16,Default,,0,0,0,,Dù sao cũng cố lên nhé!
Dialogue: 0,0:20:13.16,0:20:14.87,Default,,0,0,0,,Xin cảm ơn! Lần sau nhớ ghé lại nhé!
Dialogue: 0,0:20:15.16,0:20:17.29,Default,,0,0,0,,Dù cổ đã mua sẵn bánh mì rồi.
Dialogue: 0,0:20:17.29,0:20:18.29,Default,,0,0,0,,Ngon thật sự luôn!
Dialogue: 0,0:20:18.29,0:20:21.29,Default,,0,0,0,,Chắc cổ ghé mua ủng hộ tinh thần thôi.\NCố tỏ vẻ ngầu lòi đấy mà.
Dialogue: 0,0:20:21.29,0:20:22.95,Default,,0,0,0,,Thôi nào, đừng có nghĩ xấu cho người ta thế chứ.
Dialogue: 0,0:20:23.20,0:20:25.08,Default,,0,0,0,,Khách kéo tới ngày càng đông nghịt luôn rồi kìa!
Dialogue: 0,0:20:25.08,0:20:27.12,Default,,0,0,0,,Đắt hàng như tôm tươi rồi đấy, Michinoku ơi!
Dialogue: 0,0:20:27.33,0:20:28.87,Default,,0,0,0,,Này, Ume!
Dialogue: 0,0:20:28.87,0:20:30.91,Default,,0,0,0,,Cho tớ mua ba cái được không?
Dialogue: 0,0:20:30.91,0:20:31.95,Default,,0,0,0,,Batsunosuke đấy à.
Dialogue: 0,0:20:31.95,0:20:33.00,Default,,0,0,0,,Cậu lấy ba cái hả?
Dialogue: 0,0:20:33.00,0:20:34.79,Default,,0,0,0,,Cảm ơn vì đã mua ủng hộ nhiều thế nhé!
Dialogue: 0,0:20:35.62,0:20:37.66,Default,,0,0,0,,Tớ mua hộ cho đám bạn bên CLB Robot ấy mà.
Dialogue: 0,0:20:37.66,0:20:39.08,Default,,0,0,0,,Tớ thật sự...
Dialogue: 0,0:20:39.37,0:20:41.12,Default,,0,0,0,,thấy áy náy trong lòng quá.
Dialogue: 0,0:20:41.12,0:20:44.75,Default,,0,0,0,,Mua giùm cả phần cho mấy đứa chẳng thèm\Nvác mặt ra đây thì hơi thiếu công bằng thật.
Dialogue: 0,0:20:44.75,0:20:47.95,Default,,0,0,0,,Với lại ôm một lúc ba cái thì tham lam quá nhỉ.
Dialogue: 0,0:20:47.95,0:20:49.66,Default,,0,0,0,,Cảm ơn nhé! Tổng cộng hết 210 yên.
Dialogue: 0,0:20:50.50,0:20:51.58,Default,,0,0,0,,Cơm Nắm Ba Thế Hệ...
Dialogue: 0,0:20:51.58,0:20:52.37,Default,,0,0,0,,CLB Bóng chày đây.
Dialogue: 0,0:20:52.37,0:20:53.20,Default,,0,0,0,,Cho năm cái nhé!
Dialogue: 0,0:20:53.20,0:20:54.29,Default,,0,0,0,,Sáu cái luôn!
Dialogue: 0,0:20:54.29,0:20:55.23,Default,,0,0,0,,Có ngay đây ạ!
Dialogue: 0,0:20:55.23,0:20:55.58,Default,,0,0,0,,(Ngoàm!)\NCó ngay đây ạ!
Dialogue: 0,0:20:55.58,0:20:55.83,Default,,0,0,0,,(Ngoàm!)
Dialogue: 0,0:20:55.83,0:20:57.37,Default,,0,0,0,,- Cháy hàng kỷ lục luôn rồi!\N- Ngon không chê vào đâu được!
Dialogue: 0,0:20:57.37,0:20:59.08,Default,,0,0,0,,Hạt cơm dẻo thơm... Ngon rụng rời...
Dialogue: 0,0:20:59.08,0:21:00.66,Default,,0,0,0,,Cuối cùng cũng được ăn no căng bụng rồi...
Dialogue: 0,0:21:00.66,0:21:02.20,Default,,0,0,0,,Đám này bị bỏ đói từ kiếp nào hay sao thế?
Dialogue: 0,0:21:02.20,0:21:02.70,Default,,0,0,0,,(Nhai nhóp nhép)
Dialogue: 0,0:21:02.70,0:21:04.25,Default,,0,0,0,,Ngon xuất sắc thật sự luôn!
Dialogue: 0,0:21:04.25,0:21:05.20,Default,,0,0,0,,Cô ơi!
Dialogue: 0,0:21:05.20,0:21:07.33,Default,,0,0,0,,Không thể tin nổi giá lại rẻ bèo nhường này!
Dialogue: 0,0:21:07.33,0:21:09.16,Default,,0,0,0,,Thảo nào bán đắt như tôm tươi vậy.
Dialogue: 0,0:21:09.16,0:21:11.95,Default,,0,0,0,,Thậm chí mấy đứa còn khuất phục được cả\Nbà nhân viên hành chính cứng đầu kia tham gia cơ à.
Dialogue: 0,0:21:11.95,0:21:13.58,Default,,0,0,0,,(Rùng mình!)\NCả nhóm đã vất vả nhiều rồi đấy.
Dialogue: 0,0:21:13.58,0:21:13.87,Default,,0,0,0,,Cả nhóm đã vất vả nhiều rồi đấy.
Dialogue: 0,0:21:13.87,0:21:16.66,Default,,0,0,0,,- Cô ơi, cô trả tiền phần của cô chưa đấy ạ?\N- Tôi cũng có góp công góp sức vào đấy nhé, Michinoku.
Dialogue: 0,0:21:19.50,0:21:21.62,Default,,0,0,0,,Oa, sắp bán sạch sành sanh luôn rồi kìa!
Dialogue: 0,0:21:21.62,0:21:22.95,Default,,0,0,0,,Ừ.
Dialogue: 0,0:21:22.95,0:21:25.16,Default,,0,0,0,,Nhưng mệt rã rời luôn rồi.
Dialogue: 0,0:21:25.16,0:21:26.54,Default,,0,0,0,,Phải đó...
Dialogue: 0,0:21:26.54,0:21:28.45,Default,,0,0,0,,Michinoku, cậu ra nghỉ ngơi chút đi...
Dialogue: 0,0:21:28.45,0:21:30.12,Default,,0,0,0,,Cơm nắm hả?
Dialogue: 0,0:21:30.54,0:21:32.66,Default,,0,0,0,,Nhìn ngon phết nhỉ. Cho tôi một cái đi.
Dialogue: 0,0:21:32.66,0:21:33.70,Default,,0,0,0,,Vâng có ngay!
Dialogue: 0,0:21:33.91,0:21:36.70,Default,,0,0,0,,Vẫn còn hàng đấy ạ! Mọi người ghé xem đi!
Dialogue: 0,0:21:36.70,0:21:37.91,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:21:43.45,0:21:45.83,Default,,0,0,0,,May quá cuối cùng tụi mình cũng hoàn thành được kế hoạch này.
Dialogue: 0,0:21:46.20,0:21:47.16,Default,,0,0,0,,Ừm.
Dialogue: 0,0:21:47.45,0:21:49.00,Default,,0,0,0,,(Hừm...)\NNày, cái bánh mì kia thì sao...
Dialogue: 0,0:21:49.00,0:21:50.83,Default,,0,0,0,,(Hừm...)\NThôi khỏi nhé. Tự mà ăn đi.
Dialogue: 0,0:21:50.83,0:21:53.04,Default,,0,0,0,,Cái tội thích ra vẻ ngầu lòi cho chừa.
Dialogue: 0,0:21:53.04,0:21:54.58,Default,,0,0,0,,Tớ no căng bụng rồi.
Dialogue: 0,0:21:54.58,0:21:56.45,Default,,0,0,0,,(Hahaha!)\NDưới kia cậu vẫn còn một cái miệng nữa cơ mà.
Dialogue: 0,0:21:56.45,0:21:58.12,Default,,0,0,0,,(Hahaha!)\NCậu ăn nói thô tục quá đấy...
Dialogue: 0,0:21:58.12,0:21:59.08,Default,,0,0,0,,(Hahaha!)
Dialogue: 0,0:21:59.12,0:21:59.29,Default,,0,0,0,,(Sau đó đã thưởng thức vô cùng ngon lành)
Dialogue: 0,0:21:59.29,0:22:00.91,Default,,0,0,0,,(Sau đó đã thưởng thức vô cùng ngon lành)\NThế có muốn ăn bằng cái miệng kia không?
Dialogue: 0,0:22:00.91,0:22:03.12,Default,,0,0,0,,(Sau đó đã thưởng thức vô cùng ngon lành)\NThiệt tình... Được rồi, để tớ phụ ăn giùm cậu.
Dialogue: 0,0:22:03.12,0:22:04.91,Default,,0,0,0,,Chắc tôi cầm mang về nhà ăn vậy.
Dialogue: 0,0:23:35.00,0:23:36.00,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)\N(Xem Trước Tập Tiếp Theo)
Dialogue: 0,0:23:36.00,0:23:37.30,Default,,0,0,0,,(Thế Giới Của Satomi\NKhi Mọi Người Quây Quần Bên Nhau)
Dialogue: 0,0:23:37.30,0:23:38.60,Default,,0,0,0,,(Tổng Vệ Sinh Mùa Xuân Và Ngực Khủng\NKế Hoạch Của Tan)
Dialogue: 0,0:23:38.60,0:23:40.00,Default,,0,0,0,,(Đau Đớn Bay Biến Đi!\NTin Đồn Lăng Nhăng Của Ume)\N{\i1}[Phụ đề Việt ngữ: Amtia(NOFACE)]{\i0}
