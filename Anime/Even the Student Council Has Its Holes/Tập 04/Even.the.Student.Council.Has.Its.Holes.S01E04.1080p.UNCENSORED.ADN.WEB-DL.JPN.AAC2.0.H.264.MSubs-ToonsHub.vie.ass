Dialogue: 0,0:00:00.00,0:00:04.19,Default,,0,0,0,,(Hòm Thư Góp Ý) (Háo hức...)
Dialogue: 0,0:00:04.41,0:00:05.23,Default,,0,0,0,,Hả?
Dialogue: 0,0:00:05.43,0:00:06.88,Default,,0,0,0,,Hòm thư góp ý á?
Dialogue: 0,0:00:07.00,0:00:08.41,Default,,0,0,0,,Hội học sinh mình có thứ đó nữa sao?
Dialogue: 0,0:00:08.59,0:00:09.55,Default,,0,0,0,,Ừm.
Dialogue: 0,0:00:09.66,0:00:11.51,Default,,0,0,0,,Tháng nào em cũng mong chờ mở hòm thư này hết đó.
Dialogue: 0,0:00:11.53,0:00:13.01,Default,,0,0,0,,Không biết tháng này có bao nhiêu thư nhỉ.
Dialogue: 0,0:00:13.29,0:00:14.26,Default,,0,0,0,,Mở ra nè!
Dialogue: 0,0:00:18.68,0:00:20.04,Default,,0,0,0,,Có hai lá thư thôi sao?
Dialogue: 0,0:00:20.89,0:00:22.26,Default,,0,0,0,,Nhiều quá chừng luôn nè!
Dialogue: 0,0:00:22.28,0:00:23.96,Default,,0,0,0,,Ồ, thế cũng tính là nhiều à?
Dialogue: 0,0:00:25.02,0:00:27.98,Default,,0,0,0,,(Tập 4: Komaro và Hòm Thư Góp Ý)
Dialogue: 0,0:00:28.31,0:00:29.96,Default,,0,0,0,,Bình thường cũng ít vậy sao?
Dialogue: 0,0:00:30.13,0:00:34.05,Default,,0,0,0,,Vâng. Mọi khi chỉ có không hoặc một thôi à.\NTháng này có tận ba lá lận đó!
Dialogue: 0,0:00:34.22,0:00:37.21,Default,,0,0,0,,Thì năm nay trường mình mới bắt đầu đặt hòm thư mà.
Dialogue: 0,0:00:37.49,0:00:39.11,Default,,0,0,0,,Cái hòm này là do tự tay em làm đấy ạ.
Dialogue: 0,0:00:39.27,0:00:40.88,Default,,0,0,0,,(Bộ Đồ Hôm Nay)\NRa vậy.
Dialogue: 0,0:00:40.90,0:00:42.73,Default,,0,0,0,,Thế sao năm nay lại bày ra trò này làm gì?
Dialogue: 0,0:00:42.96,0:00:43.95,Default,,0,0,0,,Thì...
Dialogue: 0,0:00:44.12,0:00:47.39,Default,,0,0,0,,Lý do chính thức là để Hội Học Sinh\Ntrở nên cởi mở và gần gũi hơn.
Dialogue: 0,0:00:47.84,0:00:50.17,Default,,0,0,0,,(Hòm Thư Góp Ý)\NVới lại để kiếm việc gì đó cho Komaro làm nữa.
Dialogue: 0,0:00:50.20,0:00:51.26,Default,,0,0,0,,Hiểu rồi...
Dialogue: 0,0:00:51.58,0:00:53.23,Default,,0,0,0,,Không biết mọi người viết gì trong đó nhỉ.
Dialogue: 0,0:00:53.36,0:00:54.89,Default,,0,0,0,,Thường thì gửi những nội dung gì thế?
Dialogue: 0,0:00:55.48,0:00:57.25,Default,,0,0,0,,(Bánh Mì Căn Tin Đắt Quá)\NĐể em xem lá đầu tiên trước nhé.
Dialogue: 0,0:00:57.44,0:00:58.55,Default,,0,0,0,,(CLB Bóng Chày)\NCái đó đi mà kiến nghị với Phòng Quản lý học sinh.
Dialogue: 0,0:00:58.58,0:01:00.08,Default,,0,0,0,,(Sân Bóng Chày Nhỏ Quá)\NĐến lá thứ hai nè.
Dialogue: 0,0:01:00.17,0:01:01.59,Default,,0,0,0,,(CLB Bóng Chày)\NCùng một câu lạc bộ gửi tận hai lá luôn á?
Dialogue: 0,0:01:02.16,0:01:04.15,Default,,0,0,0,,(Hóa Đơn)\NCòn lá thứ ba là một cái hóa đơn.
Dialogue: 0,0:01:04.17,0:01:05.85,Default,,0,0,0,,Sao tụi nó lại cay cú chuyện bánh mì thế nhỉ?
Dialogue: 0,0:01:05.96,0:01:07.37,Default,,0,0,0,,Cái này chẳng khác gì hòm thư riêng\Ncủa CLB Bóng Chày cả.
Dialogue: 0,0:01:07.45,0:01:11.22,Default,,0,0,0,,Chắc chúng ta phải quảng bá cho hòm thư này\Nrộng rãi hơn mới được.
Dialogue: 0,0:01:11.27,0:01:12.70,Default,,0,0,0,,Cũng là vì Komaro nữa.
Dialogue: 0,0:01:13.53,0:01:15.61,Default,,0,0,0,,Vậy để em dán thông báo lên bảng tin trường...
Dialogue: 0,0:01:15.63,0:01:17.04,Default,,0,0,0,,Bảng tin trường á?!
Dialogue: 0,0:01:17.07,0:01:19.29,Default,,0,0,0,,Cổ lỗ sĩ quá đi. Đúng chuẩn đồ thời xưa!
Dialogue: 0,0:01:19.34,0:01:20.20,Default,,0,0,0,,Thôi bớt mồm đi.
Dialogue: 0,0:01:20.23,0:01:21.88,Default,,0,0,0,,Thật đấy! Giờ làm gì có ai thèm đọc đống chữ dài ngoằng đó!
Dialogue: 0,0:01:21.91,0:01:24.04,Default,,0,0,0,,Tụi nó còn chả buồn liếc lấy một dòng đâu.
Dialogue: 0,0:01:24.19,0:01:26.42,Default,,0,0,0,,Thời buổi này là phải làm video ngắn bắt trend.
Dialogue: 0,0:01:26.44,0:01:28.33,Default,,0,0,0,,Kèm một người nổi tiếng với giai điệu bắt tai.
Dialogue: 0,0:01:28.35,0:01:30.13,Default,,0,0,0,,Ngắn gọn, súc tích và dễ hiểu.
Dialogue: 0,0:01:30.84,0:01:32.42,Default,,0,0,0,,Nghe cũng có lý phết đấy chứ...
Dialogue: 0,0:01:32.96,0:01:35.26,Default,,0,0,0,,Xem như chiếu cố, em lấy giá hữu nghị 2 vạn yên thôi.
Dialogue: 0,0:01:35.86,0:01:37.48,Default,,0,0,0,,(Ototori Tan, 140K Lượt Theo Dõi)\NNgười nổi tiếng mà cậu nói là cậu đấy à?!
Dialogue: 0,0:01:37.71,0:01:39.75,Default,,0,0,0,,Nhưng mà làm video ngắn hả...
Dialogue: 0,0:01:39.78,0:01:41.47,Default,,0,0,0,,Có khi lại hiệu quả thật đấy.
Dialogue: 0,0:01:42.01,0:01:44.12,Default,,0,0,0,,Thế làm theo kiểu tiểu phẩm hài kịch thì sao?
Dialogue: 0,0:01:44.14,0:01:44.74,Default,,0,0,0,,Hả?
Dialogue: 0,0:01:44.76,0:01:46.49,Default,,0,0,0,,Em cực kỳ thích hài kịch luôn đó!
Dialogue: 0,0:01:46.68,0:01:48.57,Default,,0,0,0,,Những thứ gây cười thường in sâu vào tâm trí người ta hơn.
Dialogue: 0,0:01:48.86,0:01:50.66,Default,,0,0,0,,Nên quảng bá theo cách đó cũng hiệu quả lắm.
Dialogue: 0,0:01:50.80,0:01:52.43,Default,,0,0,0,,Ồ, thật sao?
Dialogue: 0,0:01:52.57,0:01:53.78,Default,,0,0,0,,Không ngờ luôn đấy.
Dialogue: 0,0:01:53.80,0:01:55.02,Default,,0,0,0,,Vâng ạ!
Dialogue: 0,0:01:55.08,0:01:57.04,Default,,0,0,0,,Cơ mà em chưa diễn tiểu phẩm hài bao giờ hết.
Dialogue: 0,0:01:57.32,0:01:58.26,Default,,0,0,0,,Nhưng thôi được rồi, triển luôn đi.
Dialogue: 0,0:01:58.32,0:01:59.86,Default,,0,0,0,,Đừng có làm như mình là ngôi sao lớn nữa.
Dialogue: 0,0:02:00.02,0:02:01.49,Default,,0,0,0,,Vì đây là hòm thư góp ý...
Dialogue: 0,0:02:01.51,0:02:03.47,Default,,0,0,0,,Nên hãy biến nó thành một chuyên mục tư vấn gỡ rối đi!
Dialogue: 0,0:02:03.58,0:02:04.53,Default,,0,0,0,,Như thế này nè!
Dialogue: 0,0:02:05.25,0:02:06.65,Default,,0,0,0,,Liệu có ổn thỏa không đây trời?
Dialogue: 0,0:02:06.93,0:02:09.17,Default,,0,0,0,,(Căn Phòng Của Tan)
Dialogue: 0,0:02:09.60,0:02:11.45,Default,,0,0,0,,Được rồi, chương trình xin phép được bắt đầu!
Dialogue: 0,0:02:11.48,0:02:13.56,Default,,0,0,0,,Chào mừng các bạn đến với góc tư vấn\Ncùng MC siêu cấp đáng yêu!
Dialogue: 0,0:02:13.73,0:02:17.69,Default,,0,0,0,,Vẫn như mọi khi, em ở đây để lan tỏa tình yêu thương\Nđến mọi người trên toàn thế giới!
Dialogue: 0,0:02:17.71,0:02:19.54,Default,,0,0,0,,Và bây giờ, hãy cùng lắng nghe câu hỏi hôm nay nhé...
Dialogue: 0,0:02:31.21,0:02:32.68,Default,,0,0,0,,Nè.
Dialogue: 0,0:02:32.72,0:02:35.12,Default,,0,0,0,,Sao cậu lại nhảy bổ vào tiết mục mộng tưởng của tôi hả?!
Dialogue: 0,0:02:35.23,0:02:35.82,Default,,0,0,0,,Ơ?
Dialogue: 0,0:02:35.84,0:02:37.33,Default,,0,0,0,,K-Không được ạ?
Dialogue: 0,0:02:37.82,0:02:41.23,Default,,0,0,0,,Em tưởng mở đầu bằng một câu thoại ngớ ngẩn ngẫu nhiên\Nsẽ chọc cười được khán giả chứ...
Dialogue: 0,0:02:41.34,0:02:42.00,Default,,0,0,0,,(Ủ Rũ)
Dialogue: 0,0:02:42.08,0:02:45.72,Default,,0,0,0,,Mấy trò đùa kiểu đó dễ gây tranh cãi lắm, dẹp đi.
Dialogue: 0,0:02:45.88,0:02:48.00,Default,,0,0,0,,Thời nay diễn viên hài còn chẳng thèm tát nhau nữa là.
Dialogue: 0,0:02:48.03,0:02:49.71,Default,,0,0,0,,T-Thật vậy sao?
Dialogue: 0,0:02:49.83,0:02:51.29,Default,,0,0,0,,Nhưng mà trông dễ thương lắm luôn...
Dialogue: 0,0:02:51.32,0:02:52.64,Default,,0,0,0,,Vậy thế này thì sao ạ?
Dialogue: 0,0:02:52.96,0:02:54.95,Default,,0,0,0,,(Ném Bánh Kem Lúc Giới Thiệu)\NXin chà...
Dialogue: 0,0:02:55.05,0:02:57.16,Default,,0,0,0,,(Ném Bánh Kem Lúc Giới Thiệu)\NAi đó tắt công tắc của cậu ấy giùm cái?!
Dialogue: 0,0:02:58.29,0:02:59.89,Default,,0,0,0,,Đúng là thảm họa.
Dialogue: 0,0:03:00.04,0:03:03.21,Default,,0,0,0,,Này Komaro, em có ý tưởng nào hay không?
Dialogue: 0,0:03:03.40,0:03:06.28,Default,,0,0,0,,Dạ? Xin lỗi ạ, em đang mải nghĩ chuyện khác mất rồi.
Dialogue: 0,0:03:06.30,0:03:07.76,Default,,0,0,0,,Em đang đọc mấy mẩu thư góp ý nè.
Dialogue: 0,0:03:07.79,0:03:09.32,Default,,0,0,0,,Cậu vẫn đang đọc mấy cái lời phàn nàn vớ vẩn đó à?
Dialogue: 0,0:03:09.56,0:03:13.20,Default,,0,0,0,,Em không biết làm sao để mở rộng sân bóng chày ra nữa.
Dialogue: 0,0:03:13.40,0:03:15.72,Default,,0,0,0,,Hay là tất cả mọi người cùng nhau kéo nó dãn ra nhỉ?
Dialogue: 0,0:03:15.93,0:03:17.48,Default,,0,0,0,,Khoan, làm sao mà được chứ.
Dialogue: 0,0:03:18.32,0:03:19.34,Default,,0,0,0,,Vâng...
Dialogue: 0,0:03:19.67,0:03:21.85,Default,,0,0,0,,Sức em không đủ khỏe ạ.
Dialogue: 0,0:03:21.97,0:03:23.98,Default,,0,0,0,,Ý tôi đâu phải là do sức cậu!
Dialogue: 0,0:03:24.51,0:03:25.68,Default,,0,0,0,,Mà...
Dialogue: 0,0:03:25.74,0:03:28.06,Default,,0,0,0,,Cậu không cần phải nghiêm túc quá mức thế đâu.
Dialogue: 0,0:03:28.25,0:03:31.11,Default,,0,0,0,,Cái đứa nhét thư vào chắc cũng chẳng kỳ vọng\Nchúng ta dời non lấp bể được đâu.
Dialogue: 0,0:03:31.42,0:03:34.47,Default,,0,0,0,,D-Dù vậy nhưng mà...
Dialogue: 0,0:03:34.50,0:03:37.15,Default,,0,0,0,,Người ta đã cất công chia sẻ nỗi lòng của họ mà...
Dialogue: 0,0:03:37.37,0:03:39.93,Default,,0,0,0,,Lại thế nữa rồi.
Dialogue: 0,0:03:42.16,0:03:43.19,Default,,0,0,0,,Em nói đúng.
Dialogue: 0,0:03:43.36,0:03:44.96,Default,,0,0,0,,Dù chúng ta không thể nới rộng sân bóng chày,
Dialogue: 0,0:03:45.02,0:03:47.33,Default,,0,0,0,,nhưng chắc chắn vẫn có việc gì đó\Nmà ta có thể giúp đỡ CLB Bóng Chày.
Dialogue: 0,0:03:49.35,0:03:50.47,Default,,0,0,0,,Cảm ơn em.
Dialogue: 0,0:03:51.75,0:03:53.71,Default,,0,0,0,,Michinoku à.
Dialogue: 0,0:03:56.90,0:03:58.57,Default,,0,0,0,,Cậu có sao không đấy?
Dialogue: 0,0:03:58.59,0:04:00.88,Default,,0,0,0,,Quả bóng bay thẳng vào bụng cậu luôn kìa!
Dialogue: 0,0:04:00.91,0:04:03.27,Default,,0,0,0,,Xin lỗi nhé! Có bóng chày rơi vào đó không?
Dialogue: 0,0:04:04.60,0:04:05.55,Default,,0,0,0,,Ái chà!
Dialogue: 0,0:04:05.91,0:04:07.99,Default,,0,0,0,,(Hòm Thư Góp Ý)\NXin hãy gửi ý kiến đóng góp cho chúng mình nhé!
Dialogue: 0,0:04:08.01,0:04:10.33,Default,,0,0,0,,Xin hãy gửi ý kiến đóng góp cho chúng mình nhé!
Dialogue: 0,0:04:10.36,0:04:13.46,Default,,0,0,0,,Xin hãy gửi ý kiến đóng góp cho chúng mình nhé!
Dialogue: 0,0:04:13.80,0:04:15.75,Default,,0,0,0,,- Cái này là hòm quyên góp từ thiện đấy à?\N- Nhận được quá trời luôn nè!
Dialogue: 0,0:04:15.89,0:04:18.61,Default,,0,0,0,,Nhờ sự hợp tác đầy nhiệt tình của CLB Bóng Chày,
Dialogue: 0,0:04:18.63,0:04:20.94,Default,,0,0,0,,hòm thư góp ý đã thành công vang dội.
Dialogue: 0,0:04:21.08,0:04:23.24,Default,,0,0,0,,Không biết tình yêu là gì ư?
Dialogue: 0,0:04:23.26,0:04:24.75,Default,,0,0,0,,Dễ ợt! Đơn giản lắm!
Dialogue: 0,0:04:24.77,0:04:27.16,Default,,0,0,0,,Trước tiên, hãy nhìn vào em đây nè!
Dialogue: 0,0:04:28.83,0:04:30.05,Default,,0,0,0,,Chính là nó đó!
Dialogue: 0,0:04:30.08,0:04:33.09,Default,,0,0,0,,Cái cảm giác vừa xẹt qua tim cậu ấy? Đó chính là tình yêu!
Dialogue: 0,0:04:33.24,0:04:35.49,Default,,0,0,0,,Ồ... Thế à?
Dialogue: 0,0:04:35.51,0:04:37.54,Default,,0,0,0,,(Phòng Lưu Trữ)\NPhù. Cảm ơn hai em nhé!
Dialogue: 0,0:04:37.77,0:04:40.29,Default,,0,0,0,,Tài liệu gấp quá, may mà có hai đứa cứu chị một bàn thua trông thấy.
Dialogue: 0,0:04:40.31,0:04:41.10,Default,,0,0,0,,Dạ không có gì đâu ạ.
Dialogue: 0,0:04:41.24,0:04:43.30,Default,,0,0,0,,Giúp được chị là tụi em vui rồi.
Dialogue: 0,0:04:43.75,0:04:45.25,Default,,0,0,0,,Hai đứa vẫn chưa ăn trưa đúng không?
Dialogue: 0,0:04:45.51,0:04:47.16,Default,,0,0,0,,Để chị bao hai đứa một bữa xem như cảm ơn nhé.
Dialogue: 0,0:04:47.32,0:04:48.46,Default,,0,0,0,,Xuống căn tin trường thôi nào.
Dialogue: 0,0:04:48.56,0:04:50.11,Default,,0,0,0,,Dạ? Thật thế ạ?
Dialogue: 0,0:04:50.36,0:04:52.32,Default,,0,0,0,,Lâu lắm rồi em mới ghé lại căn tin trường đó.
Dialogue: 0,0:04:53.26,0:04:55.38,Default,,0,0,0,,Dạo này thực đơn ở đây đầu tư xịn sò lắm.
Dialogue: 0,0:04:55.62,0:04:59.71,Default,,0,0,0,,Như mấy món cơm tô số lượng giới hạn\Nđậm chất sơn hào hải vị khắp bốn phương ấy.
Dialogue: 0,0:05:00.11,0:05:01.31,Default,,0,0,0,,Hửm?
Dialogue: 0,0:05:01.33,0:05:04.15,Default,,0,0,0,,Không biết có đủ tầm để làm thỏa mãn\Ncái khẩu vị sành ăn của tôi không nữa.
Dialogue: 0,0:05:04.23,0:05:05.52,Default,,0,0,0,,Cậu chui từ cái lỗ nào ra đấy hả?!
Dialogue: 0,0:05:06.80,0:05:08.66,Default,,0,0,0,,Đông nghẹt luôn nè.
Dialogue: 0,0:05:08.88,0:05:10.09,Default,,0,0,0,,Công nhận đông thật.
Dialogue: 0,0:05:10.22,0:05:12.78,Default,,0,0,0,,Giờ thì, mình nên chọn món gì được ăn chùa đây ta?
Dialogue: 0,0:05:12.88,0:05:14.71,Default,,0,0,0,,Cậu có thèm đụng tay đụng chân tí việc nào đâu!
Dialogue: 0,0:05:15.09,0:05:16.48,Default,,0,0,0,,Ô kìa, Hội trưởng!
Dialogue: 0,0:05:16.60,0:05:18.07,Default,,0,0,0,,- Hội trưởng kìa!\N- Chị Hội trưởng!
Dialogue: 0,0:05:18.17,0:05:19.95,Default,,0,0,0,,(Đầy Năng Lượng)\NCảm ơn chị về buổi hôm nọ nhiều lắm nhé!
Dialogue: 0,0:05:19.97,0:05:21.20,Default,,0,0,0,,Chị cũng vậy mà!
Dialogue: 0,0:05:21.25,0:05:22.58,Default,,0,0,0,,Hôm nào tụi mình lại đi chơi bowling tiếp nha!
Dialogue: 0,0:05:23.04,0:05:25.56,Default,,0,0,0,,- Hội trưởng nổi tiếng thật đấy!\N- Chị rất sẵn lòng luôn!
Dialogue: 0,0:05:25.59,0:05:26.99,Default,,0,0,0,,Cũng phải thôi.
Dialogue: 0,0:05:27.01,0:05:28.53,Default,,0,0,0,,Chị ấy vừa tháo vát lại còn tốt bụng.
Dialogue: 0,0:05:28.55,0:05:30.03,Default,,0,0,0,,Ngoại hình lại còn xinh đẹp nữa chứ.
Dialogue: 0,0:05:30.19,0:05:31.31,Default,,0,0,0,,À, phải rồi!
Dialogue: 0,0:05:31.45,0:05:33.00,Default,,0,0,0,,Ume thuộc phe thích ăn kèm đồ chua nhỉ?
Dialogue: 0,0:05:34.18,0:05:35.19,Default,,0,0,0,,(Mì Ý Napolitan, Thịt Băm Hamburg, Bánh Khoai Tây Croquette)
Dialogue: 0,0:05:35.22,0:05:37.44,Default,,0,0,0,,Cứ chọn món nào em thích đi nhé.
Dialogue: 0,0:05:37.70,0:05:39.04,Default,,0,0,0,,Món nào cũng được hết ạ?
Dialogue: 0,0:05:40.31,0:05:42.23,Default,,0,0,0,,Vậy em chọn món này ạ.
Dialogue: 0,0:05:42.31,0:05:43.92,Default,,0,0,0,,(Cơm Trứng Mini, 350 Yên)\NHả?
Dialogue: 0,0:05:44.14,0:05:47.26,Default,,0,0,0,,Chị đã bao thì cứ chọn món nào xịn hơn chút đi chứ.
Dialogue: 0,0:05:48.01,0:05:49.11,Default,,0,0,0,,Em hạnh phúc lắm rồi ạ!
Dialogue: 0,0:05:49.49,0:05:52.37,Default,,0,0,0,,Em đã dành dụm mãi để được ăn thử món này đấy ạ.
Dialogue: 0,0:05:54.45,0:05:55.82,Default,,0,0,0,,Em khiêm tốn quá mức rồi đấy.
Dialogue: 0,0:05:55.96,0:05:57.87,Default,,0,0,0,,Thường ngày em toàn ăn cái gì vậy trời?
Dialogue: 0,0:05:58.84,0:06:00.21,Default,,0,0,0,,(Cơm Tô Món Lạ)\N"Cơm Tô Món Lạ" á?
Dialogue: 0,0:06:00.23,0:06:01.63,Default,,0,0,0,,Ai mà thèm ăn cái món này cơ chứ?
Dialogue: 0,0:06:01.75,0:06:04.71,Default,,0,0,0,,"Trứng cá đối khô, tinh hoàn cá tuyết (shirako)\Nvà hải tiêu."
Dialogue: 0,0:06:05.15,0:06:06.06,Default,,0,0,0,,(Bíp)
Dialogue: 0,0:06:07.12,0:06:07.93,Default,,0,0,0,,(Suất Cơm Rau Củ Mùa Hè)
Dialogue: 0,0:06:08.14,0:06:09.85,Default,,0,0,0,,Chị Hội trưởng gọi món gì thế ạ?
Dialogue: 0,0:06:10.35,0:06:13.55,Default,,0,0,0,,À, ừm... suất cơm rau củ mùa hè ấy mà.
Dialogue: 0,0:06:13.57,0:06:17.08,Default,,0,0,0,,Vừa chăm tập luyện lại ăn uống lành mạnh nữa sao?\NChị kỷ luật ghê thật đấy.
Dialogue: 0,0:06:18.05,0:06:21.05,Default,,0,0,0,,Ừ. Mùa này rau củ quả là tươi ngon nhất luôn.
Dialogue: 0,0:06:21.08,0:06:22.19,Default,,0,0,0,,Chẳng hạn như cà tím nè.
Dialogue: 0,0:06:22.21,0:06:23.21,Default,,0,0,0,,A, Hisako kìa!
Dialogue: 0,0:06:23.23,0:06:26.03,Default,,0,0,0,,Hôm nay vẫn cơm bò đặc biệt như mọi khi nhỉ?\NCô xới cho con phần siêu to khổng lồ luôn nhé!
Dialogue: 0,0:06:27.91,0:06:30.87,Default,,0,0,0,,Và thế là chị ấy ẵm trọn\Nmột phần cơm siêu to khổng lồ.
Dialogue: 0,0:06:31.16,0:06:33.11,Default,,0,0,0,,(Rốt Cuộc Vẫn Là Phần Siêu To)\NCùng ăn thôi nào!
Dialogue: 0,0:06:39.27,0:06:40.55,Default,,0,0,0,,Sao thế hả Michinoku?
Dialogue: 0,0:06:41.14,0:06:43.04,Default,,0,0,0,,L-Lá cờ nhỏ...
Dialogue: 0,0:06:43.06,0:06:43.65,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:45.07,0:06:46.11,Default,,0,0,0,,Ồ!
Dialogue: 0,0:06:53.55,0:06:54.76,Default,,0,0,0,,Ngon quá đi...
Dialogue: 0,0:06:55.44,0:06:57.17,Default,,0,0,0,,Cô ơi, cho con xin một lá cờ cắm lên cơm với ạ?
Dialogue: 0,0:07:01.48,0:07:02.94,Default,,0,0,0,,Oa, có cà chua này!
Dialogue: 0,0:07:02.96,0:07:03.86,Default,,0,0,0,,(Cà Chua Bi)
Dialogue: 0,0:07:04.08,0:07:05.21,Default,,0,0,0,,Em ghét món này nhất trần đời.
Dialogue: 0,0:07:05.23,0:07:08.50,Default,,0,0,0,,Bên trong thì nhão nhoét nhớt nháp,\Nmà lớp vỏ ngoài lại giòn một cách kỳ cục.
Dialogue: 0,0:07:10.61,0:07:12.68,Default,,0,0,0,,Chẳng phải do cậu tự gọi sao?
Dialogue: 0,0:07:13.03,0:07:15.01,Default,,0,0,0,,Đưa đây, tôi ăn giùm cho.
Dialogue: 0,0:07:15.09,0:07:16.42,Default,,0,0,0,,Không sao đâu.
Dialogue: 0,0:07:17.00,0:07:18.48,Default,,0,0,0,,Đã được người ta bao ăn trưa rồi...
Dialogue: 0,0:07:18.50,0:07:19.90,Default,,0,0,0,,nên em phải ăn cho bằng hết chứ.
Dialogue: 0,0:07:19.94,0:07:22.08,Default,,0,0,0,,Ít ra cậu cũng biết điều đấy.
Dialogue: 0,0:07:24.59,0:07:25.74,Default,,0,0,0,,Mà ngon thật đấy.
Dialogue: 0,0:07:25.76,0:07:28.74,Default,,0,0,0,,Có điều chỉ ăn mỗi rau củ mùa hè không thôi\Nthì hơi khó trôi cơm nhỉ.
Dialogue: 0,0:07:28.91,0:07:31.79,Default,,0,0,0,,A, em có mang theo dưa muối nè.
Dialogue: 0,0:07:31.89,0:07:33.52,Default,,0,0,0,,Cái này do tự tay em muối đó, mọi người ăn thử đi.
Dialogue: 0,0:07:33.54,0:07:34.99,Default,,0,0,0,,Em tự làm á?
Dialogue: 0,0:07:35.01,0:07:37.05,Default,,0,0,0,,Vậy để chị nếm thử một chút nhé.
Dialogue: 0,0:07:39.22,0:07:40.47,Default,,0,0,0,,Ngon tuyệt cú mèo!
Dialogue: 0,0:07:40.66,0:07:43.24,Default,,0,0,0,,Em thấy có cách muối dưa bằng cám gạo nukazuke trong hộp đựng thực phẩm á.
Dialogue: 0,0:07:43.26,0:07:44.44,Default,,0,0,0,,Nên em làm thử xem sao.
Dialogue: 0,0:07:46.53,0:07:48.63,Default,,0,0,0,,Chà, đúng là ngon chuẩn vị Ume luôn!
Dialogue: 0,0:07:48.84,0:07:50.41,Default,,0,0,0,,- Dưa muối của Ume.\N- Dưa muối.
Dialogue: 0,0:07:55.85,0:07:57.04,Default,,0,0,0,,Sao thế chị?
Dialogue: 0,0:07:57.20,0:07:58.82,Default,,0,0,0,,Chị no bụng rồi ạ?
Dialogue: 0,0:07:58.87,0:08:00.14,Default,,0,0,0,,À, không phải đâu.
Dialogue: 0,0:08:00.16,0:08:02.60,Default,,0,0,0,,Chị chỉ đang ngắm mấy đứa ăn ngon lành thôi mà.
Dialogue: 0,0:08:02.75,0:08:04.73,Default,,0,0,0,,Nghĩ bụng chị bao bữa này quả là không uổng công.
Dialogue: 0,0:08:05.25,0:08:07.86,Default,,0,0,0,,Có lẽ chị đã no nê cả về mặt tâm hồn rồi.
Dialogue: 0,0:08:08.69,0:08:10.10,Default,,0,0,0,,Hisako à...
Dialogue: 0,0:08:10.21,0:08:12.63,Default,,0,0,0,,Thế thì em xin miếng gà rán bên trên nhé!
Dialogue: 0,0:08:15.91,0:08:18.08,Default,,0,0,0,,Giá mà Arisu cũng đi ăn cùng được thì vui biết mấy.
Dialogue: 0,0:08:18.24,0:08:20.18,Default,,0,0,0,,Cậu ấy bận việc gì khác sao ạ?
Dialogue: 0,0:08:20.20,0:08:21.05,Default,,0,0,0,,Ừ.
Dialogue: 0,0:08:21.08,0:08:23.91,Default,,0,0,0,,(CLB Hóa Học)\NEm ấy có việc bận bên câu lạc bộ cần giải quyết.
Dialogue: 0,0:08:23.93,0:08:25.38,Default,,0,0,0,,Chị ấy ở CLB Hóa Học đúng không ạ?
Dialogue: 0,0:08:25.54,0:08:27.22,Default,,0,0,0,,Ngưỡng mộ thật đấy.
Dialogue: 0,0:08:27.45,0:08:29.99,Default,,0,0,0,,Giờ nghỉ nào chị ấy cũng cắm đầu làm việc hết.
Dialogue: 0,0:08:30.01,0:08:32.35,Default,,0,0,0,,Không biết chị ấy có kịp ăn trưa không nữa.
Dialogue: 0,0:08:32.41,0:08:34.48,Default,,0,0,0,,Ủa, đằng kia chẳng phải là Arisu sao?
Dialogue: 0,0:08:34.83,0:08:35.68,Default,,0,0,0,,Hả?
Dialogue: 0,0:08:36.00,0:08:37.41,Default,,0,0,0,,(Lén Lút Chuồn Đi)\NĐúng rồi kìa.
Dialogue: 0,0:08:37.44,0:08:38.98,Default,,0,0,0,,Nhưng mà cái điệu bộ đó...
Dialogue: 0,0:08:39.00,0:08:40.75,Default,,0,0,0,,(Ngồi Bệt)\NSao chị ấy lại lén la lén lút như thế nhỉ?
Dialogue: 0,0:08:46.50,0:08:48.29,Default,,0,0,0,,Đó là Cơm Tô Món Lạ mà!
Dialogue: 0,0:08:48.31,0:08:49.52,Default,,0,0,0,,Hả? Thật sao?
Dialogue: 0,0:08:49.55,0:08:51.07,Default,,0,0,0,,Chị Terui mà lại gọi món đó á?
Dialogue: 0,0:09:05.74,0:09:08.39,Default,,0,0,0,,Em chẳng đủ can đảm để chạy lại chào đâu.
Dialogue: 0,0:09:08.59,0:09:12.54,Default,,0,0,0,,Chắc Terui cũng cần một cách nào đó để xả stress thôi.
Dialogue: 0,0:09:13.50,0:09:17.47,Default,,0,0,0,,Và thế là, mọi người đã được chứng kiến\Nmột khía cạnh hoàn toàn khác của Terui.
Dialogue: 0,0:09:19.97,0:09:20.98,Default,,0,0,0,,(Thực Ra Tớ Thích Tóc Đuôi Ngựa Hơn)
Dialogue: 0,0:09:21.47,0:09:23.35,Default,,0,0,0,,(Phòng Hội Học Sinh)\NEm xem cái này đi.
Dialogue: 0,0:09:23.37,0:09:24.03,Default,,0,0,0,,Dạ?
Dialogue: 0,0:09:24.32,0:09:26.34,Default,,0,0,0,,CLB Nhạc Nhẹ ở phòng bên cạnh ồn ào quá mức?
Dialogue: 0,0:09:26.77,0:09:27.66,Default,,0,0,0,,(CLB Trà Đạo (Phong Cách Anh Quốc))
Dialogue: 0,0:09:27.69,0:09:28.50,Default,,0,0,0,,Vâng.
Dialogue: 0,0:09:29.63,0:09:30.89,Default,,0,0,0,,Đúng thế ạ.
Dialogue: 0,0:09:30.98,0:09:34.36,Default,,0,0,0,,Nhưng CLB Nhạc Nhẹ phải luyện tập đàn hát,\Nnên chúng ta cũng khó can thiệp lắm.
Dialogue: 0,0:09:34.47,0:09:36.57,Default,,0,0,0,,Không, xin hãy nghe em nói hết đã ạ!
Dialogue: 0,0:09:36.86,0:09:39.06,Default,,0,0,0,,Đó không đơn thuần chỉ là tiếng ồn thông thường đâu.
Dialogue: 0,0:09:39.24,0:09:42.29,Default,,0,0,0,,Nói sao nhỉ? Cứ có những tiếng la hét phát ra ấy.
Dialogue: 0,0:09:42.55,0:09:45.23,Default,,0,0,0,,Nghe như kiểu có ai đó đang bị bắt nạt vậy.
Dialogue: 0,0:09:45.26,0:09:46.33,Default,,0,0,0,,Bắt nạt á?
Dialogue: 0,0:09:47.09,0:09:48.13,Default,,0,0,0,,Nóng quá đi...
Dialogue: 0,0:09:48.36,0:09:50.59,Default,,0,0,0,,Thế thì nghiêm trọng rồi đấy!
Dialogue: 0,0:09:50.71,0:09:52.99,Default,,0,0,0,,A, nhưng không hẳn là như thế đâu ạ!
Dialogue: 0,0:09:53.20,0:09:56.20,Default,,0,0,0,,Nó không giống kiểu bắt nạt thông thường cho lắm.
Dialogue: 0,0:09:56.74,0:10:00.72,Default,,0,0,0,,Mà nghe nó... cuồng nhiệt và có phần dâm dục hơn.
Dialogue: 0,0:10:02.49,0:10:05.84,Default,,0,0,0,,Kiểu như, mấy trò đụng chạm nhạy cảm dưới thắt lưng ấy.
Dialogue: 0,0:10:05.87,0:10:07.06,Default,,0,0,0,,Dưới thắt lưng á?!
Dialogue: 0,0:10:07.31,0:10:10.31,Default,,0,0,0,,(Tập 4: Koki và CLB Nhạc Nhẹ)
Dialogue: 0,0:10:10.40,0:10:12.64,Default,,0,0,0,,(CLB Nhạc Nhẹ)\NDù là thế đi chăng nữa...
Dialogue: 0,0:10:12.84,0:10:15.00,Default,,0,0,0,,thì làm sao mình đi kiểm tra mấy chuyện đó được chứ?
Dialogue: 0,0:10:15.31,0:10:17.04,Default,,0,0,0,,Ai cũng bận rộn cả.
Dialogue: 0,0:10:17.11,0:10:19.29,Default,,0,0,0,,Một mình mình chắc không kham nổi đâu.
Dialogue: 0,0:10:19.81,0:10:22.65,Default,,0,0,0,,Với lại, cứ nhắc tới CLB Nhạc Nhẹ là...
Dialogue: 0,0:10:23.65,0:10:25.16,Default,,0,0,0,,Thôi kệ đi. Cứ vào trước cái đã.
Dialogue: 0,0:10:25.53,0:10:26.57,Default,,0,0,0,,Mình cũng quen dần với mấy chuyện này rồi.
Dialogue: 0,0:10:27.36,0:10:29.04,Default,,0,0,0,,Xin phép làm phiền ạ!
Dialogue: 0,0:10:31.88,0:10:37.24,Default,,0,0,0,,♪Thứ mà người ta gọi là tình yêu kia♪
Dialogue: 0,0:10:37.28,0:10:38.38,Default,,0,0,0,,♪Đôi khi lại vỡ tan thành từng mảnh vụn...♪
Dialogue: 0,0:10:38.41,0:10:41.63,Default,,0,0,0,,Một giọng hát trong trẻo, tuyệt đẹp vang vọng\Ndưới bầu trời mùa thu.
Dialogue: 0,0:10:41.91,0:10:43.35,Default,,0,0,0,,Một làn gió nhẹ thoảng qua...
Dialogue: 0,0:10:44.35,0:10:47.33,Default,,0,0,0,,Và từng nhịp chân nhịp nhàng ấy...
Dialogue: 0,0:10:47.65,0:10:48.73,Default,,0,0,0,,Trông ngầu thật đấy.
Dialogue: 0,0:10:48.75,0:10:53.95,Default,,0,0,0,,♪Nơi ấy chẳng hề có câu trả lời♪
Dialogue: 0,0:10:54.25,0:11:00.91,Default,,0,0,0,,♪Nhưng nếu không phải là người, mọi thứ đều vô nghĩa♪
Dialogue: 0,0:11:10.30,0:11:11.29,Default,,0,0,0,,Hửm?
Dialogue: 0,0:11:11.45,0:11:12.45,Default,,0,0,0,,A!
Dialogue: 0,0:11:13.24,0:11:14.15,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:11:14.17,0:11:15.76,Default,,0,0,0,,X-Xin lỗi chị!
Dialogue: 0,0:11:15.79,0:11:17.12,Default,,0,0,0,,Em mải mê đứng xem quá ạ.
Dialogue: 0,0:11:17.63,0:11:19.83,Default,,0,0,0,,Cậu biết chơi không?
Dialogue: 0,0:11:19.97,0:11:22.73,Default,,0,0,0,,Dạ? Ý chị là chơi guitar á?
Dialogue: 0,0:11:23.11,0:11:25.56,Default,,0,0,0,,Trước đây em cũng từng tập thử một lần...
Dialogue: 0,0:11:25.67,0:11:26.86,Default,,0,0,0,,Hửm?
Dialogue: 0,0:11:29.32,0:11:30.53,Default,,0,0,0,,Lại đây ngồi đi.
Dialogue: 0,0:11:30.73,0:11:31.70,Default,,0,0,0,,Dạ?
Dialogue: 0,0:11:34.55,0:11:36.10,Default,,0,0,0,,Như thế này ạ?
Dialogue: 0,0:11:36.22,0:11:37.21,Default,,0,0,0,,Ừ.
Dialogue: 0,0:11:37.47,0:11:39.24,Default,,0,0,0,,Không tệ đâu. Trông cũng ra dáng tay guitar rồi đấy.
Dialogue: 0,0:11:39.29,0:11:40.84,Default,,0,0,0,,Chuyện gì đang diễn ra ở đây thế này?
Dialogue: 0,0:11:41.37,0:11:43.20,Default,,0,0,0,,Chị là Koki.
Dialogue: 0,0:11:43.49,0:11:44.97,Default,,0,0,0,,Cậu tính gia nhập câu lạc bộ à?
Dialogue: 0,0:11:45.18,0:11:46.71,Default,,0,0,0,,Dạ? Ơ...
Dialogue: 0,0:11:47.26,0:11:49.23,Default,,0,0,0,,Chuyện là...
Dialogue: 0,0:12:00.99,0:12:03.74,Default,,0,0,0,,- Bớt tạo không khí lãng mạn đi mẹ trẻ!\N- Bớt tạo không khí lãng mạn đi mẹ trẻ!
Dialogue: 0,0:12:03.76,0:12:05.05,Default,,0,0,0,,Chuyện này thì tao không thể bỏ qua được.
Dialogue: 0,0:12:05.07,0:12:06.96,Default,,0,0,0,,Em trai đừng có để bị nó dắt mũi đấy nhé!
Dialogue: 0,0:12:06.99,0:12:10.55,Default,,0,0,0,,Con này biết em sắp vào nên mới giả vờ\Nngồi gảy đàn ra vẻ ngầu lòi đấy!
Dialogue: 0,0:12:11.16,0:12:12.29,Default,,0,0,0,,Làm gì có chuyện đó!
Dialogue: 0,0:12:12.29,0:12:15.09,Default,,0,0,0,,Cứ mỗi lần ở một mình là nó lại cố tỏ ra ngầu lòi thế đấy.
Dialogue: 0,0:12:15.11,0:12:16.72,Default,,0,0,0,,Mày cũng hết thuốc chữa rồi Koki à.
Dialogue: 0,0:12:16.74,0:12:19.44,Default,,0,0,0,,Đừng có mắc bẫy cái trò mèo của con bé đầu đất này!
Dialogue: 0,0:12:19.93,0:12:21.80,Default,,0,0,0,,Cơ mà nhớ chụp vài tấm ảnh thật nét vào đấy nhé!
Dialogue: 0,0:12:22.25,0:12:23.89,Default,,0,0,0,,Không tệ đâu. Trông cũng ra dáng tay guitar rồi đấy.
Dialogue: 0,0:12:23.92,0:12:25.94,Default,,0,0,0,,Chuẩn, may mà tụi mình chừa cho hai đứa một góc riêng tư.
Dialogue: 0,0:12:25.96,0:12:27.66,Default,,0,0,0,,- Mấy đứa tụi bây...\N- Không tệ đâu. Trông cũng ra dáng tay guitar rồi đấy.
Dialogue: 0,0:12:27.79,0:12:30.10,Default,,0,0,0,,Chẳng phải cậu ở bên Hội Học Sinh sao?
Dialogue: 0,0:12:30.13,0:12:31.40,Default,,0,0,0,,Cậu sang đây có việc gì thế?
Dialogue: 0,0:12:31.42,0:12:33.14,Default,,0,0,0,,À, dạ thì...
Dialogue: 0,0:12:33.17,0:12:34.42,Default,,0,0,0,,Lại sang đòi tiền ngân sách câu lạc bộ nữa à?
Dialogue: 0,0:12:34.45,0:12:38.15,Default,,0,0,0,,Ồ, hóa ra là vì vụ đó à...
Dialogue: 0,0:12:38.17,0:12:40.11,Default,,0,0,0,,Hả? Chị quên nhanh thế?
Dialogue: 0,0:12:40.13,0:12:42.79,Default,,0,0,0,,Cậu ấy từng tịch thu đống tạp chí đen\Ncủa chị rồi, nhớ không?
Dialogue: 0,0:12:45.09,0:12:47.15,Default,,0,0,0,,Chà, chị ta đang cố gồng ghê chưa kìa...
Dialogue: 0,0:12:47.17,0:12:51.01,Default,,0,0,0,,Cố tỏ ra bề trên đi dạy đời một người\Nvốn nắm rõ bí mật đáng xấu hổ của mình.
Dialogue: 0,0:12:51.04,0:12:52.44,Default,,0,0,0,,Chắc bên trong đang nhục nhã muốn độn thổ lắm rồi.
Dialogue: 0,0:12:52.46,0:12:54.17,Default,,0,0,0,,Mấy người ngưng thuyết minh giùm tôi đi!
Dialogue: 0,0:12:54.44,0:12:56.98,Default,,0,0,0,,Em sang đây là vì có người phản ánh\Nvề tiếng ồn bên này ạ...
Dialogue: 0,0:12:57.01,0:12:58.24,Default,,0,0,0,,Tiếng ồn á?
Dialogue: 0,0:12:58.26,0:13:00.51,Default,,0,0,0,,Tụi này là CLB Nhạc Nhẹ mà. Không ồn sao được?
Dialogue: 0,0:13:00.53,0:13:02.80,Default,,0,0,0,,Dạ, đúng là thế, nhưng mà...
Dialogue: 0,0:13:03.40,0:13:08.31,Default,,0,0,0,,Nghe bảo có những tiếng la hét đầy khêu gợi,\Nnhư kiểu có ai đó đang bị bắt nạt vậy.
Dialogue: 0,0:13:08.33,0:13:10.06,Default,,0,0,0,,C-C-C-Cái...
Dialogue: 0,0:13:10.09,0:13:12.69,Default,,0,0,0,,Ai mà thèm làm cái trò đó chứ hả?!
Dialogue: 0,0:13:12.97,0:13:14.52,Default,,0,0,0,,Em hiểu rồi ạ.
Dialogue: 0,0:13:14.89,0:13:16.34,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:13:17.63,0:13:19.49,Default,,0,0,0,,Chỗ chăn đệm với đống khăn giấy này là sao thế ạ?
Dialogue: 0,0:13:19.51,0:13:20.54,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:20.58,0:13:21.92,Default,,0,0,0,,Để ngủ trưa chứ làm gì nữa.
Dialogue: 0,0:13:21.94,0:13:23.66,Default,,0,0,0,,Tụi này hay tụ tập ở đây trước mỗi buổi diễn.
Dialogue: 0,0:13:23.70,0:13:26.03,Default,,0,0,0,,Còn khăn giấy là vì con Koki nó hay khóc nhè lắm.
Dialogue: 0,0:13:26.05,0:13:27.46,Default,,0,0,0,,Kiểu như, khóc nức nở tu tu luôn ấy.
Dialogue: 0,0:13:31.69,0:13:34.69,Default,,0,0,0,,Tao thề, cái máy rung này chỉ dùng để mát-xa vai thôi mà!
Dialogue: 0,0:13:34.72,0:13:36.75,Default,,0,0,0,,Người ta còn chưa thèm tra hỏi gì\Nmà bằng chứng đã tự phơi bày rành rành rồi kìa!
Dialogue: 0,0:13:38.54,0:13:39.67,Default,,0,0,0,,(Sụt Sịt)
Dialogue: 0,0:13:39.68,0:13:40.49,Default,,0,0,0,,Ơ kìa!
Dialogue: 0,0:13:40.51,0:13:43.04,Default,,0,0,0,,Xem cậu làm gì kìa, tra khảo làm con bé khóc rồi đấy!
Dialogue: 0,0:13:43.27,0:13:46.06,Default,,0,0,0,,Cậu đã chà đạp hoàn toàn lòng tự trọng của Koki rồi!
Dialogue: 0,0:13:46.08,0:13:47.94,Default,,0,0,0,,E-Em xin lỗi ạ.
Dialogue: 0,0:13:48.21,0:13:50.78,Default,,0,0,0,,Nhưng lúc chị vừa hát vừa gảy đàn guitar ấy,
Dialogue: 0,0:13:51.37,0:13:54.11,Default,,0,0,0,,trông chị ngầu thực sự luôn đấy ạ.
Dialogue: 0,0:13:54.16,0:13:55.91,Default,,0,0,0,,Cậu này, thiệt tình chứ.
Dialogue: 0,0:13:55.94,0:13:57.55,Default,,0,0,0,,Ai lại đi khen người ta thẳng thừng thế bao giờ.
Dialogue: 0,0:13:59.63,0:14:02.43,Default,,0,0,0,,- Bớt tạo không khí lãng mạn đi mẹ trẻ!\N- Bớt tạo không khí lãng mạn đi mẹ trẻ!
Dialogue: 0,0:14:02.46,0:14:05.17,Default,,0,0,0,,N-Nhưng mà, vụ vừa hát vừa gảy đàn...
Dialogue: 0,0:14:05.19,0:14:06.31,Default,,0,0,0,,Im đi, đồ ngốc này!
Dialogue: 0,0:14:06.33,0:14:08.11,Default,,0,0,0,,Mày quên mất nãy giờ mày nhục nhã thế nào rồi hả?!
Dialogue: 0,0:14:09.48,0:14:10.72,Default,,0,0,0,,Rốt cuộc...
Dialogue: 0,0:14:10.74,0:14:15.68,Default,,0,0,0,,Mizunoe đành đồng ý thỉnh thoảng ghé qua kiểm tra,\Ntiện thể học đàn guitar luôn.
Dialogue: 0,0:14:16.33,0:14:19.47,Default,,0,0,0,,Vất vả cho em rồi. Xin lỗi vì bắt em đi một mình nhé.
Dialogue: 0,0:14:19.69,0:14:20.90,Default,,0,0,0,,Dạ không sao đâu ạ.
Dialogue: 0,0:14:21.05,0:14:22.62,Default,,0,0,0,,Thực ra, đi một mình lại tốt hơn ấy chứ.
Dialogue: 0,0:14:22.74,0:14:23.55,Default,,0,0,0,,Hả?
Dialogue: 0,0:14:23.58,0:14:27.15,Default,,0,0,0,,M-M-Mấy người nói thế là có ý gì chứ?
Dialogue: 0,0:14:30.65,0:14:32.21,Default,,0,0,0,,Trong này bụi bặm ghê.
Dialogue: 0,0:14:32.35,0:14:33.40,Default,,0,0,0,,Công nhận.
Dialogue: 0,0:14:33.92,0:14:36.91,Default,,0,0,0,,Tụi mình bị phân công trực nhật,\Nnên họ mới đùn việc dọn kho này cho hai đứa mình.
Dialogue: 0,0:14:37.41,0:14:39.62,Default,,0,0,0,,Bộ tiết thể dục vừa rồi chưa đủ mệt hay sao ấy.
Dialogue: 0,0:14:39.85,0:14:40.78,Default,,0,0,0,,Đúng vậy nhỉ?
Dialogue: 0,0:14:41.49,0:14:45.52,Default,,0,0,0,,Cậu bị bóng bay trúng thẳng vào mặt luôn mà, Michinoku.
Dialogue: 0,0:14:48.02,0:14:49.69,Default,,0,0,0,,Tớ lo cho cậu phát khiếp lên được.
Dialogue: 0,0:14:49.97,0:14:51.16,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:14:51.44,0:14:53.84,Default,,0,0,0,,Nhưng bóng trúng mặt thì đâu có tính là out đâu.
Dialogue: 0,0:14:53.98,0:14:56.14,Default,,0,0,0,,Nên tớ vẫn được chơi tiếp, vui lắm luôn!
Dialogue: 0,0:14:56.16,0:14:58.64,Default,,0,0,0,,À. Vậy thì tốt rồi.
Dialogue: 0,0:14:59.02,0:15:00.32,Default,,0,0,0,,Được rồi, dọn xong xuôi rồi.
Dialogue: 0,0:15:00.34,0:15:01.47,Default,,0,0,0,,Tụi mình về lớp thôi.
Dialogue: 0,0:15:04.27,0:15:05.37,Default,,0,0,0,,Ơ?
Dialogue: 0,0:15:11.14,0:15:13.13,Default,,0,0,0,,Không mở được. Sao thế nhỉ?
Dialogue: 0,0:15:13.83,0:15:14.90,Default,,0,0,0,,A!
Dialogue: 0,0:15:15.20,0:15:18.33,Default,,0,0,0,,Cái cửa này một khi đóng lại rồi\Nlà không thể mở từ bên trong được đâu.
Dialogue: 0,0:15:18.42,0:15:19.98,Default,,0,0,0,,Đứa quái nào lại đi lắp cái cửa kiểu đó chứ hả?!
Dialogue: 0,0:15:20.01,0:15:21.86,Default,,0,0,0,,Tớ học ở trường này từ cấp hai tới giờ\Nmà chưa từng nghe vụ này bao giờ luôn!
Dialogue: 0,0:15:23.77,0:15:26.47,Default,,0,0,0,,Tớ toàn bị nhốt trong này suốt thôi à.
Dialogue: 0,0:15:26.50,0:15:28.41,Default,,0,0,0,,Chắc hầu như chẳng ai biết chuyện này đâu.
Dialogue: 0,0:15:28.72,0:15:30.07,Default,,0,0,0,,Tội nghiệp cậu thật.
Dialogue: 0,0:15:30.67,0:15:33.87,Default,,0,0,0,,Thế là cả hai quyết định ngồi đợi\Ncho đến khi giờ sinh hoạt câu lạc bộ bắt đầu.
Dialogue: 0,0:15:35.12,0:15:37.94,Default,,0,0,0,,Nhưng mà trùng hợp ghê nhỉ?\NCứ như thể đã được sắp đặt từ trước ấy.
Dialogue: 0,0:15:38.16,0:15:39.08,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:15:39.23,0:15:41.71,Default,,0,0,0,,Dù có cố gắng đến mấy thì cửa cũng chẳng suy suyển.
Dialogue: 0,0:15:41.73,0:15:43.64,Default,,0,0,0,,Cứ hét khản cả cổ cũng chẳng ma nào tới cứu.
Dialogue: 0,0:15:43.97,0:15:45.30,Default,,0,0,0,,Đúng chuẩn mô-típ kinh điển.
Dialogue: 0,0:15:45.64,0:15:48.69,Default,,0,0,0,,Và nó luôn luôn xảy ra ngay đúng lúc người ta muốn đi tiểu.
Dialogue: 0,0:15:48.81,0:15:50.25,Default,,0,0,0,,Cái đó cũng là mô-típ kinh điển nốt.
Dialogue: 0,0:15:50.64,0:15:51.61,Default,,0,0,0,,Khoan đã...
Dialogue: 0,0:15:52.69,0:15:53.79,Default,,0,0,0,,Như ngay lúc này nè.
Dialogue: 0,0:15:53.82,0:15:54.93,Default,,0,0,0,,Thiệt luôn đấy hả?!
Dialogue: 0,0:15:54.95,0:15:56.39,Default,,0,0,0,,Nhanh lên, cùng mở cửa ra nào!
Dialogue: 0,0:15:56.42,0:15:58.28,Default,,0,0,0,,Cả hai đứa cùng dốc sức kéo có khi nó bung ra đấy!
Dialogue: 0,0:16:00.14,0:16:01.90,Default,,0,0,0,,Nó không nhúc nhích tí nào hết...
Dialogue: 0,0:16:02.08,0:16:04.36,Default,,0,0,0,,Michinoku, ráng thêm chút sức nữa đi!
Dialogue: 0,0:16:05.82,0:16:06.83,Default,,0,0,0,,Tớ không làm được...
Dialogue: 0,0:16:06.85,0:16:08.23,Default,,0,0,0,,Cậu bỏ cuộc nhanh quá mức rồi đấy!
Dialogue: 0,0:16:08.60,0:16:10.65,Default,,0,0,0,,Xin lỗi cậu nhé Ume...
Dialogue: 0,0:16:10.95,0:16:11.82,Default,,0,0,0,,Tớ chịu thôi...
Dialogue: 0,0:16:11.94,0:16:13.76,Default,,0,0,0,,Đừng có từ bỏ cái chuyện sống còn đó chứ!
Dialogue: 0,0:16:14.77,0:16:16.17,Default,,0,0,0,,Vậy thì thử trèo qua cửa sổ đằng kia xem sao.
Dialogue: 0,0:16:17.19,0:16:18.66,Default,,0,0,0,,Tớ sẽ cõng cậu lên vai làm điểm tựa.
Dialogue: 0,0:16:18.75,0:16:20.23,Default,,0,0,0,,Cậu trèo ra ngoài trước đi.
Dialogue: 0,0:16:20.36,0:16:22.09,Default,,0,0,0,,Đi vệ sinh xong thì quay lại cứu tớ.
Dialogue: 0,0:16:22.59,0:16:24.65,Default,,0,0,0,,Ừ-Ừm.
Dialogue: 0,0:16:31.21,0:16:32.67,Default,,0,0,0,,Không với tới sao?
Dialogue: 0,0:16:33.26,0:16:34.89,Default,,0,0,0,,Tớ không với tới được...
Dialogue: 0,0:16:34.92,0:16:36.77,Default,,0,0,0,,C-Chút xíu nữa thôi! Ráng lên cậu ơi!
Dialogue: 0,0:16:36.95,0:16:40.21,Default,,0,0,0,,Tớ giữ chân cho nè. Cậu rướn người lên thêm chút nữa được không?
Dialogue: 0,0:16:40.51,0:16:41.65,Default,,0,0,0,,Tớ không thể...
Dialogue: 0,0:16:41.67,0:16:42.88,Default,,0,0,0,,S-Sao lại không được?
Dialogue: 0,0:16:43.14,0:16:44.90,Default,,0,0,0,,Nếu bây giờ mà tớ đứng thẳng dậy...
Dialogue: 0,0:16:45.25,0:16:46.16,Default,,0,0,0,,tớ sẽ tè dầm ra quần mất.
Dialogue: 0,0:16:46.18,0:16:47.61,Default,,0,0,0,,Đừng có tè dầm đấy nhé!
Dialogue: 0,0:16:47.89,0:16:49.24,Default,,0,0,0,,Thôi chết rồi...
Dialogue: 0,0:16:50.08,0:16:51.97,Default,,0,0,0,,Đừng có kẹp chặt hai chân vào cổ tớ như thế!
Dialogue: 0,0:16:51.99,0:16:54.75,Default,,0,0,0,,Nhịn lại giùm cái đi! Cậu là con gái cơ mà trời ơi!
Dialogue: 0,0:16:56.04,0:16:57.40,Default,,0,0,0,,Tình hình sao rồi?
Dialogue: 0,0:16:58.46,0:17:00.63,Default,,0,0,0,,Hai người vẫn ổn chứ?
Dialogue: 0,0:17:00.81,0:17:03.65,Default,,0,0,0,,Tan?! Sao nhóc biết tụi anh ở trong này?
Dialogue: 0,0:17:03.68,0:17:06.17,Default,,0,0,0,,Suy luận đơn giản thôi mà anh Ume.
Dialogue: 0,0:17:06.96,0:17:10.77,Default,,0,0,0,,Cứ hễ có biến tình ái mờ ám nào sắp xảy ra,\Nlà y như rằng ở trong phòng kho dụng cụ thể dục.
Dialogue: 0,0:17:10.80,0:17:12.69,Default,,0,0,0,,Nên em đã lén đặt camera giấu kín trong này rồi.
Dialogue: 0,0:17:13.54,0:17:15.64,Default,,0,0,0,,Để tống tiền và bán lại kiếm lời chứ còn gì nữa.
Dialogue: 0,0:17:16.11,0:17:17.55,Default,,0,0,0,,Suy luận ghê chưa kìa?
Dialogue: 0,0:17:19.76,0:17:23.12,Default,,0,0,0,,Cơ mà em cũng không ngờ cái cửa lại dở chứng thế này.
Dialogue: 0,0:17:23.14,0:17:25.21,Default,,0,0,0,,Chắc có cái gì đó kẹt ở chốt cửa rồi...
Dialogue: 0,0:17:25.52,0:17:26.54,Default,,0,0,0,,- Hả?\N- Hả?
Dialogue: 0,0:17:29.30,0:17:30.87,Default,,0,0,0,,Ủa?
Dialogue: 0,0:17:32.46,0:17:34.08,Default,,0,0,0,,Có tận ba người thì thể nào chẳng tìm ra lối thoát!
Dialogue: 0,0:17:34.10,0:17:35.99,Default,,0,0,0,,Tôi đã thử hết mọi cách rồi còn đâu, khỉ gió thật!
Dialogue: 0,0:17:36.94,0:17:39.55,Default,,0,0,0,,Chân tay tớ rã rời hết cả rồi...
Dialogue: 0,0:17:39.85,0:17:42.30,Default,,0,0,0,,Tệ thật đấy. Michinoku sắp chạm giới hạn chịu đựng rồi kìa.
Dialogue: 0,0:17:42.32,0:17:44.48,Default,,0,0,0,,Hả? Đến mức đó rồi sao? Tớ xin lỗi nhé!
Dialogue: 0,0:17:44.51,0:17:47.01,Default,,0,0,0,,Ừm... A!
Dialogue: 0,0:17:47.87,0:17:49.10,Default,,0,0,0,,Nè, em tìm thấy cuộn băng keo này!
Dialogue: 0,0:17:49.12,0:17:51.48,Default,,0,0,0,,Gì cơ, nhóc tính dán kín nó lại luôn á? Điên rồi à!
Dialogue: 0,0:17:51.91,0:17:54.13,Default,,0,0,0,,Dán vào lúc gỡ ra đau thấu trời xanh luôn đấy.
Dialogue: 0,0:17:54.16,0:17:54.95,Default,,0,0,0,,Thôi khỏi, xin kiếu.
Dialogue: 0,0:17:54.98,0:17:56.44,Default,,0,0,0,,Cậu từ chối chỉ vì lý do đó thôi á?!
Dialogue: 0,0:17:56.64,0:17:58.48,Default,,0,0,0,,Anh Ume, cầm giùm em cái này đi.
Dialogue: 0,0:17:58.51,0:18:00.24,Default,,0,0,0,,Không đời nào có tác dụng đâu.
Dialogue: 0,0:18:00.64,0:18:02.43,Default,,0,0,0,,A, đằng kia có cái cửa sổ kìa!
Dialogue: 0,0:18:02.45,0:18:03.58,Default,,0,0,0,,Tôi vừa mới thử cách đó xong rồi, đồ quỷ tha ma bắt!
Dialogue: 0,0:18:04.00,0:18:06.57,Default,,0,0,0,,Hôm nay tụi mình thu thập được nhiều dữ liệu xịn sò ghê nhỉ,\Ntrợ lý của tôi?
Dialogue: 0,0:18:06.59,0:18:08.08,Default,,0,0,0,,Dạ vâng, senpai.
Dialogue: 0,0:18:10.17,0:18:10.98,Default,,0,0,0,,Hở?
Dialogue: 0,0:18:14.30,0:18:15.35,Default,,0,0,0,,Tiếng gì thế?
Dialogue: 0,0:18:15.65,0:18:16.50,Default,,0,0,0,,A!
Dialogue: 0,0:18:23.39,0:18:24.96,Default,,0,0,0,,Ôi may quá trời đất ơi...
Dialogue: 0,0:18:24.97,0:18:27.40,Default,,0,0,0,,Tụi nó đang giao phối kìa!
Dialogue: 0,0:18:27.46,0:18:30.28,Default,,0,0,0,,(Vèo)\NTụi nó đang giao phối kìa!
Dialogue: 0,0:18:30.87,0:18:33.15,Default,,0,0,0,,K-Khoan đã nào!
Dialogue: 0,0:18:33.61,0:18:35.78,Default,,0,0,0,,Tuy rằng một tin đồn kỳ quái đã lan ra khắp trường,
Dialogue: 0,0:18:35.80,0:18:37.67,Default,,0,0,0,,nhưng ít nhất thì cậu ấy cũng kịp vào nhà vệ sinh.
Dialogue: 0,0:18:38.80,0:18:41.14,Default,,0,0,0,,(Tụi nó đang giao phối kìa!)\N"Tụi nó đang giao phối kìa!"
Dialogue: 0,0:18:49.23,0:18:52.67,Default,,0,0,0,,(Hội Học Sinh Bị Rò Rỉ)
Dialogue: 0,0:20:11.21,0:20:12.93,Default,,0,0,0,,(Phòng Hội Học Sinh)\NHôm nay vất vả cho em rồi.
Dialogue: 0,0:20:13.18,0:20:14.87,Default,,0,0,0,,Hôm nay trời nóng nực ghê nhỉ?
Dialogue: 0,0:20:15.26,0:20:16.10,Default,,0,0,0,,Hửm?
Dialogue: 0,0:20:18.75,0:20:22.22,Default,,0,0,0,,Trời đất, dạo này trông thằng bé bận rộn ghê.
Dialogue: 0,0:20:22.58,0:20:23.70,Default,,0,0,0,,Nè.
Dialogue: 0,0:20:23.79,0:20:26.54,Default,,0,0,0,,Mizunoe à. Nè...
Dialogue: 0,0:20:30.11,0:20:32.45,Default,,0,0,0,,Ngủ như thế là bị cảm lạnh đấy nhé.
Dialogue: 0,0:20:32.48,0:20:34.12,Default,,0,0,0,,(Dịu Dàng)\NAnh yêu à...
Dialogue: 0,0:20:34.14,0:20:35.61,Default,,0,0,0,,Đùa chút thôi mà!
Dialogue: 0,0:20:35.63,0:20:36.94,Default,,0,0,0,,Hôm nay vất vả cho em rồi.
Dialogue: 0,0:20:37.28,0:20:38.96,Default,,0,0,0,,Em đang làm cái trò gì thế hả Kotobuki?
Dialogue: 0,0:20:39.11,0:20:40.27,Default,,0,0,0,,(Lươn Biển Vườn)\NBắt chước điệu bộ lươn biển vườn đấy à?
Dialogue: 0,0:20:40.29,0:20:41.53,Default,,0,0,0,,Không có đâu ạ!
Dialogue: 0,0:20:41.94,0:20:44.84,Default,,0,0,0,,Mà cô Hiratsuka ghé qua đây có việc gì thế ạ?
Dialogue: 0,0:20:44.97,0:20:46.59,Default,,0,0,0,,À, phải rồi.
Dialogue: 0,0:20:46.74,0:20:50.22,Default,,0,0,0,,Là về sự kiện thường niên của trường mình ấy mà.
Dialogue: 0,0:20:50.29,0:20:53.68,Default,,0,0,0,,Cái vụ gì đó... gọi là gì ấy nhỉ?
Dialogue: 0,0:20:53.73,0:20:56.48,Default,,0,0,0,,(Bùm! Komaro)\NChuyến dã ngoại gắn kết hội học sinh ạ!
Dialogue: 0,0:20:57.12,0:20:59.29,Default,,0,0,0,,A, lại đến cái mùa đó trong năm rồi sao.
Dialogue: 0,0:20:59.38,0:21:00.65,Default,,0,0,0,,Ừ, đúng nó rồi đấy!
Dialogue: 0,0:21:00.70,0:21:03.36,Default,,0,0,0,,Cô muốn bàn với mấy đứa về chuyện đó đây.
Dialogue: 0,0:21:03.48,0:21:06.25,Default,,0,0,0,,Ủa mà sao thằng nhóc kia lại nằm ngủ\Nnhư đang ở suối nước nóng thế kia?
Dialogue: 0,0:21:06.27,0:21:06.98,Default,,0,0,0,,Dạ?
Dialogue: 0,0:21:07.00,0:21:10.69,Default,,0,0,0,,Cái bản mặt đẹp trai đi cùng với bộ dạng đó.
Dialogue: 0,0:21:10.71,0:21:11.60,Default,,0,0,0,,Trông hài hước chết đi được.
Dialogue: 0,0:21:11.84,0:21:13.27,Default,,0,0,0,,Em cũng thấy thế ạ.
Dialogue: 0,0:21:13.68,0:21:15.82,Default,,0,0,0,,Để em đánh thức cậu ấy dậy.
Dialogue: 0,0:21:15.95,0:21:18.78,Default,,0,0,0,,Này Ume, dậy đi.
Dialogue: 0,0:21:19.62,0:21:22.44,Default,,0,0,0,,Ưm, chị ơi, để em ngủ thêm chút đi...
Dialogue: 0,0:21:23.38,0:21:26.38,Default,,0,0,0,,Ôi dào, cứ để em nó ngủ thêm chút đi chị gái.
Dialogue: 0,0:21:26.40,0:21:27.48,Default,,0,0,0,,Cô Hiratsuka ạ?
Dialogue: 0,0:21:27.58,0:21:29.30,Default,,0,0,0,,(Ume Đã Dậy)\NMizunoe tỉnh ngủ rồi kìa.
Dialogue: 0,0:21:29.33,0:21:31.20,Default,,0,0,0,,A, em xin lỗi mọi người ạ.
Dialogue: 0,0:21:31.22,0:21:33.57,Default,,0,0,0,,Chắc do mệt quá nên em ngủ thiếp đi lúc nào không hay.
Dialogue: 0,0:21:33.60,0:21:36.35,Default,,0,0,0,,Đừng bận tâm. Cô cũng hay gật gà gật gù suốt ấy mà.
Dialogue: 0,0:21:36.65,0:21:39.74,Default,,0,0,0,,Vậy chuyện này là về chuyến dã ngoại\Ngắn kết hội học sinh đúng không ạ?
Dialogue: 0,0:21:39.92,0:21:40.84,Default,,0,0,0,,Đúng rồi đấy.
Dialogue: 0,0:21:40.86,0:21:43.35,Default,,0,0,0,,Nếu có nơi nào em muốn đi, Ume,\Nthì cứ thoải mái đề xuất nhé.
Dialogue: 0,0:21:43.37,0:21:44.67,Default,,0,0,0,,Thật thế ạ?
Dialogue: 0,0:21:44.70,0:21:46.98,Default,,0,0,0,,Vậy thì đi suối nước nóng được không ạ?
Dialogue: 0,0:21:47.00,0:21:48.40,Default,,0,0,0,,Kiểu như mấy suối nước nóng mà đại văn hào Yasunari Kawabata từng viết ấy.
Dialogue: 0,0:21:48.96,0:21:50.73,Default,,0,0,0,,Em thích ngâm bồn tắm ghê nhỉ?
Dialogue: 0,0:21:50.76,0:21:53.52,Default,,0,0,0,,Ơ? Khoan đã, em từng nói vụ đó trước đây rồi sao?
Dialogue: 0,0:21:53.70,0:21:55.57,Default,,0,0,0,,Xin lỗi nhé, Mizunoe.
Dialogue: 0,0:21:56.26,0:21:57.81,Default,,0,0,0,,C-Còn cậu thì sao, Michinoku?
Dialogue: 0,0:21:58.51,0:22:01.88,Default,,0,0,0,,Vâng, em cũng muốn đi suối nước nóng thử xem sao.
Dialogue: 0,0:22:01.91,0:22:03.74,Default,,0,0,0,,À, cậu không cần phải hùa theo\Nchỉ vì tớ vừa bảo thế đâu nhé.
Dialogue: 0,0:22:03.76,0:22:07.59,Default,,0,0,0,,Em thích ngâm mình trong nước nóng lắm.\NCảm giác như người mình nhẹ bẫng đi ấy.
Dialogue: 0,0:22:08.44,0:22:10.63,Default,,0,0,0,,Chị cũng cực kỳ mê suối nước nóng luôn đó!
Dialogue: 0,0:22:10.79,0:22:12.50,Default,,0,0,0,,(Vỗ Ngực)\NDù ngực của em thì nhẹ hều à!
Dialogue: 0,0:22:12.65,0:22:13.57,Default,,0,0,0,,Thôi bớt giùm đi.
Dialogue: 0,0:22:13.93,0:22:16.35,Default,,0,0,0,,Vậy chốt kèo nhé. Cứ suối nước nóng mà triển!
Dialogue: 0,0:22:16.44,0:22:18.80,Default,,0,0,0,,(Hớn Hở, Phấn Khích, Khúc Khích, Tươi Rói)\NHả? Quyết định nhanh vậy có ổn thật không cô?
Dialogue: 0,0:22:18.89,0:22:21.90,Default,,0,0,0,,Dù sao thì cô cũng phải đi theo quản lý học sinh mà...
Dialogue: 0,0:22:21.92,0:22:24.78,Default,,0,0,0,,Nên được đi suối nước nóng miễn phí do học sinh chọn...
Dialogue: 0,0:22:25.05,0:22:26.71,Default,,0,0,0,,(Hời Quá! Hời Quá!)\N- Đúng là một món hời béo bở!\N- Cô lỡ mồm nói to suy nghĩ trong bụng ra rồi kìa.
Dialogue: 0,0:22:26.94,0:22:29.20,Default,,0,0,0,,Với lại, đi suối nước nóng vẫn tốt hơn năm ngoái chán.
Dialogue: 0,0:22:29.42,0:22:31.03,Default,,0,0,0,,Dạ? Năm ngoái ạ?
Dialogue: 0,0:22:31.06,0:22:33.55,Default,,0,0,0,,Năm ngoái, con bé Otori cứ nằng nặc nài nỉ đòi đi bằng được,
Dialogue: 0,0:22:33.58,0:22:35.25,Default,,0,0,0,,nên cả lũ phải lặn lội đi ngắm núi Phú Sĩ.
Dialogue: 0,0:22:35.28,0:22:36.92,Default,,0,0,0,,Em muốn có một bức tranh núi Phú Sĩ cơ!
Dialogue: 0,0:22:37.13,0:22:39.13,Default,,0,0,0,,Vậy để cô lo liệu vụ đặt phòng trọ nhé.
Dialogue: 0,0:22:39.16,0:22:40.41,Default,,0,0,0,,Còn lại nhờ hết vào mấy đứa đấy.
Dialogue: 0,0:22:40.44,0:22:41.71,Default,,0,0,0,,- Dạ vâng.\N- Rõ rồi ạ!
Dialogue: 0,0:22:41.97,0:22:44.27,Default,,0,0,0,,(Cẩm Nang Du Lịch Rurubu)\NÀ, còn một điều cuối cùng nữa.
Dialogue: 0,0:22:44.29,0:22:45.11,Default,,0,0,0,,Dạ?
Dialogue: 0,0:22:45.50,0:22:48.93,Default,,0,0,0,,Đừng có để mấy cái hormone tuổi dậy thì lấn át lý trí\Nmà làm ra chuyện gì phải hối hận đấy nhé.
Dialogue: 0,0:22:48.95,0:22:50.50,Default,,0,0,0,,Dù sao thì mấy đứa cũng đang ở cái độ tuổi hừng hực đó mà.
Dialogue: 0,0:22:50.52,0:22:52.07,Default,,0,0,0,,Đó là lời dặn dò cuối cùng của cô đấy à?!
Dialogue: 0,0:22:52.28,0:22:54.31,Default,,0,0,0,,Làm gì có chuyện bậy bạ nào xảy ra chứ!
Dialogue: 0,0:22:54.33,0:22:55.52,Default,,0,0,0,,Cô đang quấy rối tình dục tụi em đấy nhé.
Dialogue: 0,0:22:55.55,0:22:56.48,Default,,0,0,0,,Thế à?
Dialogue: 0,0:22:56.64,0:22:58.93,Default,,0,0,0,,Nhưng mà trông thấy ai đó trong một không gian riêng tư kín đáo...
Dialogue: 0,0:22:58.93,0:23:00.28,Default,,0,0,0,,có khi lại khiến đầu óc em không kiềm chế nổi đâu...
Dialogue: 0,0:23:00.31,0:23:01.40,Default,,0,0,0,,Không đời nào có chuyện đó!
Dialogue: 0,0:23:01.44,0:23:04.55,Default,,0,0,0,,Hoặc biết đâu lại lén lút sờ soạng vài cái\Ndưới màn đêm tối tăm thì sao...
Dialogue: 0,0:23:04.83,0:23:06.89,Default,,0,0,0,,Ai mà thèm làm cái trò biến thái đó chứ?!
Dialogue: 0,0:23:06.93,0:23:09.97,Default,,0,0,0,,Hay là tranh thủ lúc người ta đang ngủ say để giở trò đồi bại!
Dialogue: 0,0:23:10.37,0:23:12.16,Default,,0,0,0,,Cô đọc quá nhiều truyện tranh rồi đấy!
Dialogue: 0,0:23:12.18,0:23:14.32,Default,,0,0,0,,Thiệt tình chứ. Toàn nói ba cái điều nhảm nhí...
Dialogue: 0,0:23:14.77,0:23:15.67,Default,,0,0,0,,Hửm?
Dialogue: 0,0:23:16.69,0:23:17.55,Default,,0,0,0,,(Phì Phò, Thở Dốc)\NChị Hội trưởng?
Dialogue: 0,0:23:17.83,0:23:20.39,Default,,0,0,0,,(Phì Phò, Thở Dốc)\NKhông! Chị đâu có nghĩ đến chuyện đó đâu...
Dialogue: 0,0:23:20.71,0:23:24.12,Default,,0,0,0,,Tự nhiên chị bị cái gì thế hả?!\NThở phì phò như cái đầu máy xe lửa vậy!
Dialogue: 0,0:23:24.36,0:23:26.65,Default,,0,0,0,,(Phì Phò, Thở Dốc)\NNếu mấy đứa có lỡ làm thì nhớ đừng để bị bắt quả tang đấy nhé.
Dialogue: 0,0:23:27.54,0:23:28.24,Default,,0,0,0,,Cô về đây!
Dialogue: 0,0:23:28.55,0:23:29.70,Default,,0,0,0,,Thế là cô đồng tình với chuyện đó luôn rồi đấy à?!
Dialogue: 0,0:23:29.72,0:23:31.49,Default,,0,0,0,,- Bộ cô ấy nhận ra rồi sao? Không, khoan đã...\N- Chị ơi, cơm tối xong rồi nè!
Dialogue: 0,0:23:31.52,0:23:33.07,Default,,0,0,0,,- Nhưng mà...\N- Nóng quá đi mất!
Dialogue: 0,0:23:33.10,0:23:34.21,Default,,0,0,0,,(Phì Phò, Thở Dốc)\NCái phòng này bị làm sao thế không biết?!
Dialogue: 0,0:23:35.03,0:23:36.04,Default,,0,0,0,,(Giới Thiệu Tập Tiếp Theo)
Dialogue: 0,0:23:36.06,0:23:38.25,Default,,0,0,0,,(Hội Học Sinh Đi Dã Ngoại)\N(Chung Chiếc Ô Cùng Ume Dưới Mưa)
Dialogue: 0,0:23:38.28,0:23:40.06,Default,,0,0,0,,(Chiến Dịch Ume-Tan-Tan)
