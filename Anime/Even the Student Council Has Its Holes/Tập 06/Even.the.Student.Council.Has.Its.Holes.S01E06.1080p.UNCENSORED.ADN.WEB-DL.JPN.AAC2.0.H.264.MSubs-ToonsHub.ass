Dialogue: 0,0:01:22.03,0:01:28.49,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)
Dialogue: 0,0:01:30.00,0:01:33.12,Default,,0,0,0,,(Tập 6: Hỏng Bét Cả Rồi)
Dialogue: 0,0:01:33.12,0:01:34.90,Default,,0,0,0,,Cảm ơn mọi người rất nhiều vì đã giúp đỡ
Dialogue: 0,0:01:34.90,0:01:40.08,Default,,0,0,0,,buổi tiệc trà ngoài trời của CLB Trà Đạo Phong Cách Anh ngày hôm nay!
Dialogue: 0,0:01:40.08,0:01:43.29,Default,,0,0,0,,Không có gì đâu, cảm ơn cậu vì món trà thơm ngon tuyệt vời nhé!
Dialogue: 0,0:01:43.62,0:01:45.37,Default,,0,0,0,,Một buổi tiệc trà ngoài trời giữa tiết trời thu quả thực là...
Dialogue: 0,0:01:45.37,0:01:45.95,Default,,0,0,0,,(Gió thổi)\NMột buổi tiệc trà ngoài trời giữa tiết trời thu quả thực là...
Dialogue: 0,0:01:45.95,0:01:46.54,Default,,0,0,0,,(Gió thổi)
Dialogue: 0,0:01:46.54,0:01:48.37,Default,,0,0,0,,tuyệt vời biết bao.
Dialogue: 0,0:01:48.37,0:01:48.95,Default,,0,0,0,,(Gió thổi)
Dialogue: 0,0:01:48.95,0:01:50.58,Default,,0,0,0,,Hàng cây rực rỡ khoác lên mình sắc màu mùa thu.
Dialogue: 0,0:01:50.58,0:01:51.25,Default,,0,0,0,,(Gió thổi)
Dialogue: 0,0:01:51.29,0:01:51.87,Default,,0,0,0,,(Gió thổi...)
Dialogue: 0,0:01:51.87,0:01:53.20,Default,,0,0,0,,Bầu trời mùa thu trong xanh và khoáng đạt.
Dialogue: 0,0:01:53.37,0:01:55.00,Default,,0,0,0,,Và trên hết tất cả...
Dialogue: 0,0:01:55.00,0:01:56.08,Default,,0,0,0,,(Gió thổi...)
Dialogue: 0,0:01:56.08,0:01:56.17,Default,,0,0,0,,Trà nguội nhanh kinh khủng khiếp.
Dialogue: 0,0:01:56.17,0:01:59.29,Default,,0,0,0,,(Nét mặt hôm nay)\NTrà nguội nhanh kinh khủng khiếp.
Dialogue: 0,0:01:59.50,0:02:00.62,Default,,0,0,0,,Công nhận là nhanh thật đấy.
Dialogue: 0,0:02:00.62,0:02:03.29,Default,,0,0,0,,Hay là chúng mình chuyển sang uống trà đá luôn cho rồi nhỉ?
Dialogue: 0,0:02:03.29,0:02:05.08,Default,,0,0,0,,Dạ ừm...
Dialogue: 0,0:02:05.58,0:02:07.50,Default,,0,0,0,,Xin lỗi vì đã cắt ngang câu chuyện của mọi người, nhưng mà...
Dialogue: 0,0:02:07.50,0:02:08.95,Default,,0,0,0,,nhà vệ sinh ở đâu thế ạ?
Dialogue: 0,0:02:08.95,0:02:10.29,Default,,0,0,0,,Ý cậu là bồn cầu ấy hả?
Dialogue: 0,0:02:10.29,0:02:12.16,Default,,0,0,0,,Khi cái lạnh mùa thu bắt đầu ùa về,
Dialogue: 0,0:02:12.16,0:02:15.37,Default,,0,0,0,,thì việc được tận hưởng chiếc nắp bồn cầu sưởi ấm trong nhà vệ sinh công cộng
Dialogue: 0,0:02:15.37,0:02:17.66,Default,,0,0,0,,chính là một trong những niềm khoái lạc tột đỉnh của tiệc trà ngoài trời đấy!
Dialogue: 0,0:02:17.66,0:02:19.45,Default,,0,0,0,,Tôi cá là ai rồi cũng sẽ bị nghiện cho mà xem!
Dialogue: 0,0:02:19.45,0:02:21.41,Default,,0,0,0,,Cậu lại đi tìm kiếm sự tao nhã ở một nơi như thế này sao?
Dialogue: 0,0:02:21.41,0:02:22.66,Default,,0,0,0,,Bể tắm lộ thiên chắc?
Dialogue: 0,0:02:22.66,0:02:24.75,Default,,0,0,0,,Ôi! A... cảm ơn cậu nhé.
Dialogue: 0,0:02:24.75,0:02:26.33,Default,,0,0,0,,(Nhà Vệ Sinh Công Cộng)
Dialogue: 0,0:02:27.25,0:02:29.75,Default,,0,0,0,,Nhà vệ sinh ở đây sạch sẽ thật đấy!
Dialogue: 0,0:02:30.20,0:02:31.25,Default,,0,0,0,,Giá mà nhà vệ sinh ở trường mình\Ncũng xịn sò được như thế này.
Dialogue: 0,0:02:31.25,0:02:32.91,Default,,0,0,0,,(Lạnh quá)\NGiá mà nhà vệ sinh ở trường mình cũng xịn sò được như thế này.
Dialogue: 0,0:02:33.62,0:02:36.25,Default,,0,0,0,,Có khi buổi họp toàn thể tới mình sẽ đề xuất chuyện này xem sao.
Dialogue: 0,0:02:36.95,0:02:38.66,Default,,0,0,0,,Ủa cái khóa này bị làm sao thế nhỉ?
Dialogue: 0,0:02:38.91,0:02:39.79,Default,,0,0,0,,Hở?
Dialogue: 0,0:02:40.00,0:02:42.54,Default,,0,0,0,,Mình có khóa cửa không ta?
Dialogue: 0,0:02:42.95,0:02:44.62,Default,,0,0,0,,Nó không chịu mở ra...
Dialogue: 0,0:02:45.20,0:02:46.25,Default,,0,0,0,,Chị Hội trưởng đấy ạ?
Dialogue: 0,0:02:46.79,0:02:48.37,Default,,0,0,0,,Arisu đấy phải không em?!
Dialogue: 0,0:02:48.37,0:02:50.45,Default,,0,0,0,,May quá đi mất! Em giúp chị với được không?
Dialogue: 0,0:02:50.45,0:02:52.29,Default,,0,0,0,,Hình như cái ổ khóa bị kẹt hỏng rồi.
Dialogue: 0,0:02:52.29,0:02:53.25,Default,,0,0,0,,Dạ ừm!
Dialogue: 0,0:02:54.16,0:02:55.41,Default,,0,0,0,,Chuyện là...
Dialogue: 0,0:02:55.62,0:02:56.91,Default,,0,0,0,,Có chuyện gì thế hả Arisu?
Dialogue: 0,0:02:57.91,0:03:00.33,Default,,0,0,0,,Em... em hết sạch giấy vệ sinh rồi.
Dialogue: 0,0:03:00.33,0:03:01.79,Default,,0,0,0,,Cái câu lạc bộ Trà Đạo này...
Dialogue: 0,0:03:02.04,0:03:04.12,Default,,0,0,0,,Mình thực sự bị nghiện luôn rồi đấy.
Dialogue: 0,0:03:04.28,0:03:05.41,Default,,0,0,0,,(Tiếng nước xịt)
Dialogue: 0,0:03:06.66,0:03:07.00,Default,,0,0,0,,(Tiếng nước xịt)
Dialogue: 0,0:03:07.00,0:03:09.00,Default,,0,0,0,,(Tiếng nước xịt)\NKoma đấy phải không em?
Dialogue: 0,0:03:09.00,0:03:10.87,Default,,0,0,0,,Xin lỗi em nhé. Chắc là vừa rồi em nghe thấy hết rồi đúng không?
Dialogue: 0,0:03:10.87,0:03:11.75,Default,,0,0,0,,(Tiếng nước xịt)\NKhi nào em ra ngoài...
Dialogue: 0,0:03:11.75,0:03:12.87,Default,,0,0,0,,Em không ra được đâu ạ.\N(Tiếng nước xịt)
Dialogue: 0,0:03:13.16,0:03:15.37,Default,,0,0,0,,(Tiếng nước xịt)\NCái vòi xịt tự động bị hỏng mất rồi.
Dialogue: 0,0:03:15.37,0:03:15.46,Default,,0,0,0,,(Tiếng nước xịt)
Dialogue: 0,0:03:15.75,0:03:18.16,Default,,0,0,0,,(Giật bắn, Nước xịt, Tê tái...)\NKhông thể tin nổi là cả ba chúng ta...
Dialogue: 0,0:03:18.41,0:03:20.62,Default,,0,0,0,,(Giật bắn, Nước xịt, Tê tái...)\NBây giờ bọn mình phải làm sao đây?
Dialogue: 0,0:03:20.62,0:03:21.55,Default,,0,0,0,,(Giật bắn, Nước xịt, Tê tái...)
Dialogue: 0,0:03:22.04,0:03:23.16,Default,,0,0,0,,Em xin lỗi...
Dialogue: 0,0:03:23.37,0:03:24.62,Default,,0,0,0,,Em không chịu nổi nữa rồi...
Dialogue: 0,0:03:24.62,0:03:27.12,Default,,0,0,0,,A phải rồi! Em thử bấm mấy cái nút khác xem sao!
Dialogue: 0,0:03:27.12,0:03:29.79,Default,,0,0,0,,Biết đâu nó sẽ ghi đè sang chế độ khác thì sao!
Dialogue: 0,0:03:31.52,0:03:32.66,Default,,0,0,0,,(Á...)
Dialogue: 0,0:03:32.66,0:03:34.29,Default,,0,0,0,,(Á...)\NRửa Mát-xa!
Dialogue: 0,0:03:34.29,0:03:35.25,Default,,0,0,0,,(Á...)
Dialogue: 0,0:03:35.25,0:03:36.95,Default,,0,0,0,,Chị xin lỗi em nhiều lắm!
Dialogue: 0,0:03:37.54,0:03:39.29,Default,,0,0,0,,Koma! Giấy vệ sinh!
Dialogue: 0,0:03:39.29,0:03:41.20,Default,,0,0,0,,Ném cho chị ít giấy vệ sinh qua bên này với!
Dialogue: 0,0:03:41.20,0:03:44.54,Default,,0,0,0,,(Kotobuki, Koma, Terui, Hỏng, Sửa)\NNếu mà cử động được thì em đã cứu cả hai chị rồi!
Dialogue: 0,0:03:44.54,0:03:46.04,Default,,0,0,0,,(Kotobuki, Koma, Terui, Hỏng, Sửa)\NEm hiểu rồi!
Dialogue: 0,0:03:46.25,0:03:46.91,Default,,0,0,0,,(Kotobuki, Koma, Terui, Hỏng, Sửa)\NEm ném đây ạ.
Dialogue: 0,0:03:46.91,0:03:47.91,Default,,0,0,0,,(Hình ảnh)
Dialogue: 0,0:03:48.16,0:03:48.62,Default,,0,0,0,,(Cuộn giấy lăn đi)
Dialogue: 0,0:03:50.58,0:03:52.12,Default,,0,0,0,,Thôi xong rồi...
Dialogue: 0,0:03:53.00,0:03:55.70,Default,,0,0,0,,Được rồi! Mau gọi mấy đứa con trai bên ngoài vào đi.
Dialogue: 0,0:03:55.70,0:03:57.04,Default,,0,0,0,,Kêu ai đó bên CLB Trà Đạo chạy sang đây giúp!
Dialogue: 0,0:03:57.04,0:03:58.66,Default,,0,0,0,,Khoan đã chị ơi!
Dialogue: 0,0:03:59.04,0:04:00.29,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:04:00.29,0:04:03.08,Default,,0,0,0,,Chỉ là... ừm thì...
Dialogue: 0,0:04:03.41,0:04:04.87,Default,,0,0,0,,Như thế này thì ngượng ngùng chết mất thôi.
Dialogue: 0,0:04:04.87,0:04:06.62,Default,,0,0,0,,Bây giờ mà còn là lúc để lo chuyện đó nữa sao?
Dialogue: 0,0:04:06.83,0:04:10.20,Default,,0,0,0,,Cuối cùng, họ quyết định để Kotobuki\Ntrèo ra ngoài qua đường cửa sổ thông gió.
Dialogue: 0,0:04:10.62,0:04:12.12,Default,,0,0,0,,Chỗ đó cao phết đấy nhỉ.
Dialogue: 0,0:04:12.54,0:04:13.87,Default,,0,0,0,,Chị có nên đưa chân ra trước không ta?
Dialogue: 0,0:04:13.87,0:04:17.04,Default,,0,0,0,,Em xin lỗi, em thật là vô dụng quá mà.
Dialogue: 0,0:04:17.29,0:04:18.91,Default,,0,0,0,,Không sao đâu em.
Dialogue: 0,0:04:19.33,0:04:21.62,Default,,0,0,0,,Bình thường toàn là em lo liệu mọi chuyện cho cả nhóm mà.
Dialogue: 0,0:04:22.33,0:04:24.47,Default,,0,0,0,,Cứ để dịp này cho chị tỏa sáng một lần xem nào.
Dialogue: 0,0:04:24.64,0:04:25.78,Default,,0,0,0,,(Kẹt cứng)
Dialogue: 0,0:04:27.16,0:04:29.41,Default,,0,0,0,,Thôi chết rồi! Chị bị kẹt rồi!
Dialogue: 0,0:04:29.87,0:04:31.00,Default,,0,0,0,,Ngực của chị...
Dialogue: 0,0:04:33.33,0:04:35.54,Default,,0,0,0,,Chị Hội trưởng ơi, có chuyện gì thế ạ?
Dialogue: 0,0:04:35.54,0:04:37.66,Default,,0,0,0,,Á! Không có gì đâu!
Dialogue: 0,0:04:38.16,0:04:40.29,Default,,0,0,0,,Nguy to rồi! Mau lên nào!
Dialogue: 0,0:04:40.45,0:04:42.70,Default,,0,0,0,,Nếu ai đó mà nhìn thấy mình trong bộ dạng này thì...
Dialogue: 0,0:04:42.70,0:04:43.91,Default,,0,0,0,,Hội trưởng?
Dialogue: 0,0:05:02.91,0:05:03.70,Default,,0,0,0,,Tôi...
Dialogue: 0,0:05:04.08,0:05:06.70,Default,,0,0,0,,Tôi chỉ muốn hít thở chút không khí trong lành thôi mà.
Dialogue: 0,0:05:08.45,0:05:09.58,Default,,0,0,0,,Dù sao thì...
Dialogue: 0,0:05:09.58,0:05:11.75,Default,,0,0,0,,Tôi sẽ đi gọi người bên CLB Trà Đạo tới giúp.
Dialogue: 0,0:05:11.75,0:05:16.37,Default,,0,0,0,,(Hò dô ta!)\NMột hai! Một hai!
Dialogue: 0,0:05:16.37,0:05:16.41,Default,,0,0,0,,Một hai! Một hai!
Dialogue: 0,0:05:16.62,0:05:17.62,Default,,0,0,0,,Này!
Dialogue: 0,0:05:17.87,0:05:21.30,Default,,0,0,0,,Năm phút sau, mọi người\Nđều đã được giải cứu an toàn và lành lặn.
Dialogue: 0,0:05:21.83,0:05:23.83,Default,,0,0,0,,Cậu không sao chứ?
Dialogue: 0,0:05:24.12,0:05:25.66,Default,,0,0,0,,Cậu có cần uống thêm trà nữa không?
Dialogue: 0,0:05:25.66,0:05:28.95,Default,,0,0,0,,Không, tớ thực sự không cần thêm ngụm nào nữa đâu.
Dialogue: 0,0:05:29.53,0:05:30.75,Default,,0,0,0,,(Quán Ăn Kotobuki)
Dialogue: 0,0:05:36.70,0:05:38.75,Default,,0,0,0,,Mình không tài nào ngừng nghĩ về chuyện trong nhà vệ sinh lúc đó được.
Dialogue: 0,0:05:38.75,0:05:41.04,Default,,0,0,0,,Chẳng thể nào tập trung vào học bài nổi!
Dialogue: 0,0:05:42.04,0:05:44.91,Default,,0,0,0,,Kỳ thi sắp tới nơi rồi.\NRốt cuộc đầu óc mình đang nghĩ cái quái gì thế này?
Dialogue: 0,0:05:44.91,0:05:46.00,Default,,0,0,0,,Và cả...
Dialogue: 0,0:05:46.00,0:05:48.62,Default,,0,0,0,,Cái cớ "Tôi chỉ muốn hít thở chút không khí trong lành" là cái quái gì cơ chứ?
Dialogue: 0,0:05:49.16,0:05:52.12,Default,,0,0,0,,Không, điều quan trọng hơn mà mình đang lo lắng là...
Dialogue: 0,0:05:52.66,0:05:54.41,Default,,0,0,0,,Có khi nào Mizunoe đã nhìn thấy quần lót của mình rồi không?
Dialogue: 0,0:05:54.41,0:05:57.62,Default,,0,0,0,,Mà cái quần đó trông lại còn hơi người lớn nữa chứ.
Dialogue: 0,0:05:58.50,0:05:59.62,Default,,0,0,0,,Cậu ta đã thấy hay là chưa thấy nhỉ?
Dialogue: 0,0:05:59.62,0:06:01.04,Default,,0,0,0,,Mình nhớ là mình đã khép chặt hai chân lại rồi mà.
Dialogue: 0,0:06:01.04,0:06:01.91,Default,,0,0,0,,Nên chắc là không sao đâu nhỉ?
Dialogue: 0,0:06:01.91,0:06:04.54,Default,,0,0,0,,Nhưng từ góc nhìn đó thì...
Dialogue: 0,0:06:06.59,0:06:07.16,Default,,0,0,0,,(Sai bét)
Dialogue: 0,0:06:07.16,0:06:08.79,Default,,0,0,0,,Có lẽ mình nên thử nghiệm thực tế xem sao.
Dialogue: 0,0:06:09.04,0:06:11.29,Default,,0,0,0,,Làm thế thì mình mới tập trung học bài được.
Dialogue: 0,0:06:11.62,0:06:14.66,Default,,0,0,0,,Chị hai lại đang bày trò gì thế hả anh hai?
Dialogue: 0,0:06:14.66,0:06:16.79,Default,,0,0,0,,Chắc lại liên quan đến con bé Ume gì đó rồi.
Dialogue: 0,0:06:16.79,0:06:17.79,Default,,0,0,0,,Em chẳng thèm quan tâm đâu.
Dialogue: 0,0:06:18.50,0:06:19.91,Default,,0,0,0,,Chắc đúng là thế rồi.
Dialogue: 0,0:06:20.20,0:06:22.87,Default,,0,0,0,,Tính theo chiều cao của Mizunoe và khoảng cách đứng lúc đó.
Dialogue: 0,0:06:22.87,0:06:24.79,Default,,0,0,0,,Góc này chắc là chuẩn xác rồi.
Dialogue: 0,0:06:25.04,0:06:27.25,Default,,0,0,0,,Nếu chụp ảnh từ góc này thì sẽ hoàn hảo.
Dialogue: 0,0:06:27.45,0:06:31.33,Default,,0,0,0,,Và mình cần mặc đúng chiếc váy đó cùng chiếc quần lót đó.
Dialogue: 0,0:06:31.33,0:06:32.95,Default,,0,0,0,,Mọi điều kiện đều phải trùng khớp 100%.
Dialogue: 0,0:06:33.41,0:06:34.91,Default,,0,0,0,,(Quá sức nghiêm túc)\NQuá sức nghiêm túc luôn.
Dialogue: 0,0:06:36.20,0:06:37.12,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:06:37.66,0:06:39.29,Default,,0,0,0,,Chụp thử nào.
Dialogue: 0,0:06:48.45,0:06:50.08,Default,,0,0,0,,Ngượng ngùng chết mất thôi.
Dialogue: 0,0:06:51.16,0:06:52.95,Default,,0,0,0,,Được rồi, chụp xong rồi!
Dialogue: 0,0:06:53.50,0:06:56.08,Default,,0,0,0,,Mong là cậu ta không thấy gì hết.
Dialogue: 0,0:06:57.73,0:06:58.33,Default,,0,0,0,,(Thịch)
Dialogue: 0,0:06:58.33,0:07:00.69,Default,,0,0,0,,(Thịch)\NMình chẳng nhìn thấy gì cả...
Dialogue: 0,0:07:00.69,0:07:00.70,Default,,0,0,0,,Mình chẳng nhìn thấy gì cả...
Dialogue: 0,0:07:01.33,0:07:02.79,Default,,0,0,0,,(Ghét thế không biết)\N- [Ghét thế không biết!]
Dialogue: 0,0:07:02.79,0:07:04.91,Default,,0,0,0,,Nhưng như thế đâu có đúng với dự đoán của mình.
Dialogue: 0,0:07:05.33,0:07:08.16,Default,,0,0,0,,Không không không! Thử lại lần nữa nào.
Dialogue: 0,0:07:08.16,0:07:10.37,Default,,0,0,0,,Lần này mình sẽ đổi góc độ và quay video luôn.
Dialogue: 0,0:07:10.62,0:07:13.37,Default,,0,0,0,,Hình như lúc đó váy của mình bị tốc lên một chút.
Dialogue: 0,0:07:13.58,0:07:15.83,Default,,0,0,0,,Và hai chân của mình dang rộng ra hơn một tí.
Dialogue: 0,0:07:15.83,0:07:18.87,Default,,0,0,0,,Rồi mình bắt đầu ngọ nguậy giãy giụa để thoát ra...
Dialogue: 0,0:07:18.87,0:07:19.29,Default,,0,0,0,,(Thịch)
Dialogue: 0,0:07:19.29,0:07:21.16,Default,,0,0,0,,(Thịch)\NTr-Trông nó thế nào rồi?
Dialogue: 0,0:07:22.95,0:07:24.25,Default,,0,0,0,,Ủa...
Dialogue: 0,0:07:25.62,0:07:26.45,Default,,0,0,0,,(Mình đúng là đồ biến thái)\NMình...
Dialogue: 0,0:07:26.45,0:07:27.83,Default,,0,0,0,,(Mình đúng là đồ biến thái)\Nđúng là đồ biến thái mà.
Dialogue: 0,0:07:28.08,0:07:28.70,Default,,0,0,0,,Cái gì cơ?
Dialogue: 0,0:07:28.70,0:07:29.41,Default,,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:07:29.41,0:07:30.33,Default,,0,0,0,,Nực cười quá đi mất!
Dialogue: 0,0:07:30.33,0:07:32.08,Default,,0,0,0,,Mình đã đu người tòng teng ngoài cửa sổ
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,với cái mông phơi ra tơ hơ như thế này sao.
Dialogue: 0,0:07:34.08,0:07:36.37,Default,,0,0,0,,Cứ như một cảnh trong phim người lớn ấy hả?!
Dialogue: 0,0:07:36.65,0:07:36.95,Default,,0,0,0,,(Ư hự...)
Dialogue: 0,0:07:36.95,0:07:39.37,Default,,0,0,0,,(Ư hự...)\NKhông thể trốn chạy mà cũng chẳng thể nhúc nhích nổi
Dialogue: 0,0:07:39.95,0:07:42.62,Default,,0,0,0,,trong một tư thế đầy hớ hênh sơ hở như thế này.
Dialogue: 0,0:07:43.08,0:07:46.08,Default,,0,0,0,,(Ư hự...)\NY hệt như thế này...
Dialogue: 0,0:07:46.83,0:07:48.33,Default,,0,0,0,,(Ư hự...)\NCái mông của mình...
Dialogue: 0,0:07:48.33,0:07:51.53,Default,,0,0,0,,(Ư hự...)
Dialogue: 0,0:07:51.78,0:07:54.53,Default,,0,0,0,,(Ư hự...)
Dialogue: 0,0:08:00.66,0:08:03.83,Default,,0,0,0,,Mình... mình tiêu đời thật rồi.
Dialogue: 0,0:08:07.83,0:08:09.54,Default,,0,0,0,,(Ngọ nguậy)
Dialogue: 0,0:08:09.54,0:08:11.91,Default,,0,0,0,,(Ngọ nguậy)\NHọc hành giờ là thứ cuối cùng trong tâm trí cô nàng.
Dialogue: 0,0:08:11.91,0:08:12.03,Default,,0,0,0,,(Ngọ nguậy)
Dialogue: 0,0:08:12.37,0:08:14.00,Default,,0,0,0,,Chị hai ơi, chị làm cái trò gì trong đó thế?
Dialogue: 0,0:08:14.00,0:08:15.33,Default,,0,0,0,,Chị làm ồn ào quá đấy nhé!
Dialogue: 0,0:08:17.25,0:08:19.00,Default,,0,0,0,,Chuyên gia lộ quần lót tấu hài:
Dialogue: 0,0:08:19.04,0:08:21.58,Default,,0,0,0,,- Kuroe Honma của CLB Bơi lội.\N- [Ngân sách CLB mình lại tăng lên nữa rồi!]
Dialogue: 0,0:08:22.23,0:08:22.54,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:08:22.54,0:08:25.00,Default,,0,0,0,,(Phòng Hội Học Sinh)\NThí nghiệm thất bại thảm hại rồi!
Dialogue: 0,0:08:25.00,0:08:26.37,Default,,0,0,0,,Chạy mau...
Dialogue: 0,0:08:26.37,0:08:28.50,Default,,0,0,0,,Đáng yêu quá đi mất!
Dialogue: 0,0:08:28.50,0:08:29.79,Default,,0,0,0,,Chào buổi chiều mọi người.
Dialogue: 0,0:08:30.04,0:08:33.53,Default,,0,0,0,,(Chủ nhiệm CLB Sinh học, Wani Janome)\NXin chào. Tôi là Janome bên CLB Sinh học.
Dialogue: 0,0:08:33.53,0:08:33.65,Default,,0,0,0,,(Hội Học Sinh Học Viện Tosei)
Dialogue: 0,0:08:33.75,0:08:35.83,Default,,0,0,0,,Tôi muốn nhờ mọi người một chuyện.
Dialogue: 0,0:08:36.00,0:08:37.83,Default,,0,0,0,,- Mọi người có biết tổ ong ở gần cổng sau không?\N- Cô ấy là ai thế? Cô ấy muốn gì vậy?
Dialogue: 0,0:08:37.83,0:08:38.75,Default,,0,0,0,,Có chứ.
Dialogue: 0,0:08:38.75,0:08:40.79,Default,,0,0,0,,Cái tổ ong mà dạo này ai cũng bàn tán xôn xao ấy hả?
Dialogue: 0,0:08:41.00,0:08:44.29,Default,,0,0,0,,Tôi nghe nói đã có vài học sinh bị đốt rồi đấy. Đáng sợ thật.\NĐúng là ghê thật.
Dialogue: 0,0:08:44.29,0:08:46.50,Default,,0,0,0,,Đúng rồi, chính là nó đấy.
Dialogue: 0,0:08:46.50,0:08:50.84,Default,,0,0,0,,(Rúc đầu)\NCác thầy cô thậm chí đang bàn bạc xem có nên gọi đội diệt côn trùng không nữa.
Dialogue: 0,0:08:51.12,0:08:53.79,Default,,0,0,0,,Chính vì thế tôi muốn cứu lấy chúng.
Dialogue: 0,0:08:53.95,0:08:56.37,Default,,0,0,0,,Những sinh linh tội nghiệp đang đứng trước nguy cơ bị tàn sát.
Dialogue: 0,0:08:56.37,0:08:57.37,Default,,0,0,0,,- Cứu lũ ong á?\N- Ái da!
Dialogue: 0,0:08:57.37,0:08:58.16,Default,,0,0,0,,(Sân Trong)
Dialogue: 0,0:08:58.16,0:08:59.37,Default,,0,0,0,,(Sân Trong)\NLà cái tổ đó đấy hả...?
Dialogue: 0,0:08:59.37,0:09:01.45,Default,,0,0,0,,Có nhiều con bay lượn xung quanh quá!
Dialogue: 0,0:09:01.62,0:09:04.45,Default,,0,0,0,,Làm sao mà họ để cái tổ to đến mức này được chứ?
Dialogue: 0,0:09:05.08,0:09:07.41,Default,,0,0,0,,(Đây Chính Là Sự Sống)\NĐó là thành quả từ các hoạt động của CLB tôi đấy.
Dialogue: 0,0:09:07.41,0:09:08.45,Default,,0,0,0,,Cô chỉ đang làm cho tình hình tệ hơn thôi.
Dialogue: 0,0:09:08.66,0:09:11.50,Default,,0,0,0,,Mọi sinh mạng đều xứng đáng được bảo vệ mà.
Dialogue: 0,0:09:11.50,0:09:12.58,Default,,0,0,0,,Gớm quá.
Dialogue: 0,0:09:12.79,0:09:14.45,Default,,0,0,0,,Cô ta có phải dạng người nguy hiểm không thế?
Dialogue: 0,0:09:14.45,0:09:15.37,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:09:15.58,0:09:18.00,Default,,0,0,0,,Thế bây giờ chúng ta phải làm gì đây?
Dialogue: 0,0:09:19.37,0:09:20.70,Default,,0,0,0,,Làm gì ư...?
Dialogue: 0,0:09:20.70,0:09:22.08,Default,,0,0,0,,Nên làm gì bây giờ nhỉ?
Dialogue: 0,0:09:22.08,0:09:24.29,Default,,0,0,0,,Thực ra tôi cũng chưa tra cứu xem phải làm thế nào nữa.
Dialogue: 0,0:09:24.58,0:09:27.83,Default,,0,0,0,,Cứ để chúng quay về với tự nhiên và mặc kệ chúng đi.
Dialogue: 0,0:09:27.83,0:09:29.25,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:09:29.25,0:09:31.87,Default,,0,0,0,,Vậy có cách nào để không bị đốt không?
Dialogue: 0,0:09:32.66,0:09:35.50,Default,,0,0,0,,Chẳng lẽ các người không thể nói chuyện ôn hòa với chúng được sao?
Dialogue: 0,0:09:35.50,0:09:36.41,Default,,0,0,0,,Chúc may mắn nhé!
Dialogue: 0,0:09:36.41,0:09:37.62,Default,,0,0,0,,Cái tên này bị làm sao thế không biết?
Dialogue: 0,0:09:38.08,0:09:41.04,Default,,0,0,0,,Hết cách rồi. Chúng ta cứ quan sát chúng trước đã.
Dialogue: 0,0:09:41.33,0:09:42.87,Default,,0,0,0,,Nhưng trước đó thì...
Dialogue: 0,0:09:43.25,0:09:45.04,Default,,0,0,0,,(Túm lấy)\NSao thế hả Terui?
Dialogue: 0,0:09:45.04,0:09:46.54,Default,,0,0,0,,Đau quá đi mất!
Dialogue: 0,0:09:46.75,0:09:48.33,Default,,0,0,0,,Lẽ nào chuyện đó lại tái diễn...?
Dialogue: 0,0:09:48.33,0:09:49.66,Default,,0,0,0,,Ừm.
Dialogue: 0,0:09:50.83,0:09:53.95,Default,,0,0,0,,Bình thường tôi cũng thích côn trùng lắm,
Dialogue: 0,0:09:54.83,0:09:56.70,Default,,0,0,0,,nhưng mấy con biết bay lại còn biết chích đốt
Dialogue: 0,0:09:56.70,0:09:58.29,Default,,0,0,0,,thì không hẳn là sở trường của tôi đâu.
Dialogue: 0,0:09:58.45,0:09:59.50,Default,,0,0,0,,Sở trường của cậu á?
Dialogue: 0,0:09:59.83,0:10:01.95,Default,,0,0,0,,Cả một đàn bu đông nghẹt kìa!
Dialogue: 0,0:10:01.95,0:10:03.00,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:03.16,0:10:06.16,Default,,0,0,0,,Thế này nguy hiểm quá rồi. Rốt cuộc vẫn nên gọi đội diệt côn trùng thôi.
Dialogue: 0,0:10:06.16,0:10:07.13,Default,,0,0,0,,Dễ thương quá đi!
Dialogue: 0,0:10:07.20,0:10:08.03,Default,,0,0,0,,Đỡ lấy này!
Dialogue: 0,0:10:08.12,0:10:08.45,Default,,0,0,0,,(Cả bầy ùa ra!)
Dialogue: 0,0:10:08.45,0:10:09.70,Default,,0,0,0,,(Cả bầy ùa ra!)\NOái!
Dialogue: 0,0:10:09.70,0:10:10.83,Default,,0,0,0,,Bây giờ đâu phải lúc để kêu "Oái" chứ!
Dialogue: 0,0:10:11.08,0:10:12.54,Default,,0,0,0,,Đồ ngốc này! Cậu làm cái trò gì thế hả?
Dialogue: 0,0:10:12.54,0:10:14.45,Default,,0,0,0,,Xin lỗi, tớ không kiềm chế được.
Dialogue: 0,0:10:14.45,0:10:15.50,Default,,0,0,0,,Cậu thật là...
Dialogue: 0,0:10:16.16,0:10:17.50,Default,,0,0,0,,Lũ ong đang nổi điên lên rồi kìa!
Dialogue: 0,0:10:17.50,0:10:18.58,Default,,0,0,0,,Bọn mình phải làm sao đây?
Dialogue: 0,0:10:18.58,0:10:20.03,Default,,0,0,0,,Như những oán hồn báo thù vậy!
Dialogue: 0,0:10:20.50,0:10:22.12,Default,,0,0,0,,(Chân của nó mọc ra từ giữa cơ thể.)\NBây giờ chúng ta phải làm thế nào đây?
Dialogue: 0,0:10:22.33,0:10:24.29,Default,,0,0,0,,Michinoku, cậu có sáng kiến gì không?
Dialogue: 0,0:10:24.29,0:10:25.12,Default,,0,0,0,,Ô!
Dialogue: 0,0:10:25.12,0:10:27.45,Default,,0,0,0,,(Phồng má)\NVo ve vo ve... [Nếu chọc giận loài ong...]
Dialogue: 0,0:10:27.45,0:10:28.79,Default,,0,0,0,,Cậu đã bị đốt rồi kìa!
Dialogue: 0,0:10:28.79,0:10:30.04,Default,,0,0,0,,Bị đốt từ bao giờ thế hả?
Dialogue: 0,0:10:30.29,0:10:32.44,Default,,0,0,0,,(Bất tài, Bị thương, Hoảng loạn)\NTình hình này vô phương cứu chữa rồi.
Dialogue: 0,0:10:32.75,0:10:36.04,Default,,0,0,0,,Xem ra hết cách rồi. Đã đến lúc tôi phải ra tay.
Dialogue: 0,0:10:36.04,0:10:37.91,Default,,0,0,0,,Tôi sẽ dẹp gọn chúng trong nháy mắt!
Dialogue: 0,0:10:38.95,0:10:39.66,Default,,0,0,0,,Không đời nào đâu!
Dialogue: 0,0:10:39.66,0:10:41.58,Default,,0,0,0,,Ong biết bay đấy cậu biết không hả?!
Dialogue: 0,0:10:41.58,0:10:43.25,Default,,0,0,0,,Ngay cả Tan cũng sẽ gặp bất lợi thôi.
Dialogue: 0,0:10:43.25,0:10:44.83,Default,,0,0,0,,Sao tự dưng lại nói chuyện chiến tranh ở đây thế?
Dialogue: 0,0:10:45.29,0:10:46.83,Default,,0,0,0,,Sẽ ổn cả thôi mà!
Dialogue: 0,0:10:46.83,0:10:49.37,Default,,0,0,0,,Ý tôi là, ong đâu có nỡ đốt tôi đâu đúng không?
Dialogue: 0,0:10:49.37,0:10:50.91,Default,,0,0,0,,Cái logic kiểu quái gì thế kia?
Dialogue: 0,0:10:50.91,0:10:52.70,Default,,0,0,0,,- Thế thì ít nhất...\N- Một người có thể giao tiếp được với chúng sao?
Dialogue: 0,0:10:52.92,0:10:55.05,Default,,0,0,0,,(Im lặng...)
Dialogue: 0,0:10:55.29,0:10:56.79,Default,,0,0,0,,Thế này chắc là được rồi đấy.
Dialogue: 0,0:10:56.79,0:10:58.20,Default,,0,0,0,,Cũng không tệ lắm, xét theo những gì chúng ta có trong tay.
Dialogue: 0,0:10:58.20,0:10:59.62,Default,,0,0,0,,Cách này không hiệu quả đâu.
Dialogue: 0,0:10:59.87,0:11:02.37,Default,,0,0,0,,Hơi quê mùa một chút, nhưng trông cũng khá ổn đấy chứ!
Dialogue: 0,0:11:02.37,0:11:03.83,Default,,0,0,0,,Dù nó không được thoáng khí cho lắm.
Dialogue: 0,0:11:03.83,0:11:04.75,Default,,0,0,0,,Có cái gì mà ổn cơ chứ?
Dialogue: 0,0:11:04.75,0:11:06.25,Default,,0,0,0,,Mắt cậu làm bằng sáp ong hay sao thế hả?
Dialogue: 0,0:11:06.25,0:11:08.16,Default,,0,0,0,,(Vù)\NĐược rồi, xung phong nào!
Dialogue: 0,0:11:08.16,0:11:09.23,Default,,0,0,0,,(Vù)\NKhoan đã một chút.
Dialogue: 0,0:11:09.23,0:11:09.45,Default,,0,0,0,,Khoan đã một chút.
Dialogue: 0,0:11:11.50,0:11:13.67,Default,,0,0,0,,Bắt được rồi! Đỡ lấy này!
Dialogue: 0,0:11:14.00,0:11:15.20,Default,,0,0,0,,Đỉnh quá đi mất!
Dialogue: 0,0:11:15.70,0:11:17.08,Default,,0,0,0,,Cậu thực sự lợi hại thật đấy!
Dialogue: 0,0:11:17.08,0:11:20.12,Default,,0,0,0,,Làm tốt lắm! Hay là cậu gia nhập CLB Sinh học luôn đi?
Dialogue: 0,0:11:21.04,0:11:22.25,Default,,0,0,0,,Chuyện nhỏ thôi mà.
Dialogue: 0,0:11:22.25,0:11:25.29,Default,,0,0,0,,Giờ thì chúng ta mang cái này ra bãi đất trống...
Dialogue: 0,0:11:26.37,0:11:27.16,Default,,0,0,0,,(ẦM ẦM)
Dialogue: 0,0:11:27.16,0:11:28.54,Default,,0,0,0,,(ẦM ẦM)\NĐầu ti của Tan!
Dialogue: 0,0:11:28.54,0:11:28.58,Default,,0,0,0,,Đầu ti của Tan kìa!
Dialogue: 0,0:11:28.58,0:11:29.13,Default,,0,0,0,,Ái da!
Dialogue: 0,0:11:29.13,0:11:30.25,Default,,0,0,0,,(ẦM ẦM)\NÁi da!
Dialogue: 0,0:11:30.25,0:11:31.50,Default,,0,0,0,,(ẦM ẦM)\NĐầu ti của Tan bị ong đốt rồi!
Dialogue: 0,0:11:31.50,0:11:32.41,Default,,0,0,0,,Đau quá đi mất!
Dialogue: 0,0:11:32.41,0:11:34.75,Default,,0,0,0,,- Ai đó cứu tôi với!\N- Tan, bình tĩnh lại đi!
Dialogue: 0,0:11:34.75,0:11:36.83,Default,,0,0,0,,Các bạn ong ơi, bình tĩnh lại nào!
Dialogue: 0,0:11:36.83,0:11:38.54,Default,,0,0,0,,Chúng tôi không phải là kẻ thù của các bạn đâu!
Dialogue: 0,0:11:38.54,0:11:40.95,Default,,0,0,0,,Chúng tôi đến đây để cứu các bạn khỏi móng vuốt ác quỷ mà!
Dialogue: 0,0:11:40.95,0:11:41.43,Default,,0,0,0,,(ẦM ẦM)
Dialogue: 0,0:11:41.43,0:11:41.50,Default,,0,0,0,,(Xác Nằm La Liệt)
Dialogue: 0,0:11:41.50,0:11:43.70,Default,,0,0,0,,(Xác Nằm La Liệt)\NXin lỗi vì bọn tôi đến muộn nhé!
Dialogue: 0,0:11:43.70,0:11:44.70,Default,,0,0,0,,(Xác Nằm La Liệt)\NChuyện gì đã xảy ra thế này?
Dialogue: 0,0:11:44.70,0:11:47.70,Default,,0,0,0,,Tổ ong đã được di dời an toàn vào ngày hôm sau.
Dialogue: 0,0:11:48.08,0:11:49.45,Default,,0,0,0,,Ngoạm~
Dialogue: 0,0:11:49.45,0:11:51.00,Default,,0,0,0,,Tớ sẽ nuốt chửng cậu luôn đấy.
Dialogue: 0,0:11:51.16,0:11:52.25,Default,,0,0,0,,Đùa thôi mà.
Dialogue: 0,0:11:52.50,0:11:54.79,Default,,0,0,0,,Có khi nào Janome để ý đến mình không nhỉ...?
Dialogue: 0,0:11:54.95,0:11:56.37,Default,,0,0,0,,Hết.
Dialogue: 0,0:11:56.69,0:11:57.04,Default,,0,0,0,,(Văn Phòng Giáo Viên)
Dialogue: 0,0:11:57.04,0:11:58.45,Default,,0,0,0,,(Văn Phòng Giáo Viên)\NVà thế là xong.
Dialogue: 0,0:11:58.45,0:12:00.75,Default,,0,0,0,,Đó là toàn bộ báo cáo hoạt động của tuần này ạ.
Dialogue: 0,0:12:00.75,0:12:03.16,Default,,0,0,0,,Được rồi, vất vả cho các em rồi nhé.
Dialogue: 0,0:12:03.37,0:12:05.37,Default,,0,0,0,,Nghĩ lại thì...
Dialogue: 0,0:12:05.37,0:12:07.91,Default,,0,0,0,,Trường chúng ta đúng là toàn những kẻ lập dị quái chiêu.
Dialogue: 0,0:12:07.91,0:12:09.66,Default,,0,0,0,,Nào là CLB Nhạc Nhẹ, CLB Chế Tạo Robot,
Dialogue: 0,0:12:09.66,0:12:11.00,Default,,0,0,0,,và cả mấy đứa tụi em nữa.
Dialogue: 0,0:12:11.00,0:12:12.79,Default,,0,0,0,,Đúng là thế thật ạ.
Dialogue: 0,0:12:12.79,0:12:14.04,Default,,0,0,0,,Mấy đứa tụi em á?
Dialogue: 0,0:12:14.37,0:12:16.62,Default,,0,0,0,,Dù sao thì bọn em xin phép về trước đây ạ.
Dialogue: 0,0:12:16.62,0:12:17.91,Default,,0,0,0,,Ừ.
Dialogue: 0,0:12:19.20,0:12:20.33,Default,,0,0,0,,Là em trai tớ gọi này.
Dialogue: 0,0:12:20.33,0:12:21.54,Default,,0,0,0,,Có điện thoại à?
Dialogue: 0,0:12:22.70,0:12:24.04,Default,,0,0,0,,Mizunoe, đợi cô một chút đã.
Dialogue: 0,0:12:27.54,0:12:29.87,Default,,0,0,0,,Tối nay em có rảnh không?
Dialogue: 0,0:12:30.45,0:12:33.45,Default,,0,0,0,,(Tập 6: Ume và Cô Giáo)
Dialogue: 0,0:12:33.48,0:12:33.79,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:12:33.79,0:12:35.95,Default,,0,0,0,,Hóa ra là vì chuyện này sao cô?
Dialogue: 0,0:12:35.95,0:12:37.75,Default,,0,0,0,,Chứ em nghĩ là chuyện gì nữa hả?
Dialogue: 0,0:12:37.75,0:12:40.16,Default,,0,0,0,,Rau củ và cá mà phụ huynh học sinh biếu đấy.
Dialogue: 0,0:12:40.16,0:12:41.75,Default,,0,0,0,,Sao người phải xách đống này lại là em chứ?
Dialogue: 0,0:12:41.95,0:12:44.16,Default,,0,0,0,,Cô không có bạn trai sao?
Dialogue: 0,0:12:44.75,0:12:47.50,Default,,0,0,0,,Gì cơ? Em đang xung phong đấy à?
Dialogue: 0,0:12:47.79,0:12:51.00,Default,,0,0,0,,Không đời nào, Mizunoe! Chúng ta là cô trò đấy nhé!
Dialogue: 0,0:12:51.00,0:12:52.29,Default,,0,0,0,,Cô đúng là phiền phức thật đấy.
Dialogue: 0,0:12:53.33,0:12:54.70,Default,,0,0,0,,Mệt đứt cả hơi.
Dialogue: 0,0:12:54.87,0:12:56.04,Default,,0,0,0,,Hôm nay em vất vả rồi nhé.
Dialogue: 0,0:12:56.79,0:12:58.91,Default,,0,0,0,,Thôi em xin phép về đây ạ.
Dialogue: 0,0:13:01.04,0:13:02.79,Default,,0,0,0,,Vào nhà đi em.
Dialogue: 0,0:13:03.66,0:13:05.04,Default,,0,0,0,,Không, em đã bảo là...
Dialogue: 0,0:13:05.04,0:13:07.83,Default,,0,0,0,,Em nỡ để cô tự xử lý hết đống này một mình sao?
Dialogue: 0,0:13:07.83,0:13:09.75,Default,,0,0,0,,Em cũng biết là cô đâu có giỏi nấu ăn mà.
Dialogue: 0,0:13:09.75,0:13:11.66,Default,,0,0,0,,Em nên biết chu đáo hơn đi chứ, đồ trai tân này.
Dialogue: 0,0:13:12.66,0:13:15.37,Default,,0,0,0,,Vào nhà đi nào. Đừng có ngại ngùng thế chứ.
Dialogue: 0,0:13:15.95,0:13:18.12,Default,,0,0,0,,Cái người phụ nữ này thật là...
Dialogue: 0,0:13:18.12,0:13:20.37,Default,,0,0,0,,Cô ấy cứ trêu chọc mình suốt từ xưa đến giờ.
Dialogue: 0,0:13:20.37,0:13:22.91,Default,,0,0,0,,Đùa giỡn với trái tim ngây thơ trong sáng của mình.
Dialogue: 0,0:13:23.16,0:13:24.25,Default,,0,0,0,,Em nhìn thấy rồi đúng không?
Dialogue: 0,0:13:24.25,0:13:27.70,Default,,0,0,0,,Mắt tinh tường ghê đối với một cậu nhóc cấp hai đấy nhỉ?
Dialogue: 0,0:13:27.87,0:13:30.45,Default,,0,0,0,,Không thể tin nổi là cô ấy lại mời mình về nhà.
Dialogue: 0,0:13:30.45,0:13:32.25,Default,,0,0,0,,Mình chẳng biết cô ấy đang tính giở trò gì nữa.
Dialogue: 0,0:13:32.25,0:13:33.83,Default,,0,0,0,,Nhưng mình sẽ không mắc bẫy cô ấy thêm lần nào nữa đâu.
Dialogue: 0,0:13:33.83,0:13:37.08,Default,,0,0,0,,Em làm cái gì ngoài đó thế? Mau vào đây đi!
Dialogue: 0,0:13:37.08,0:13:39.29,Default,,0,0,0,,Cô đừng có cởi đồ ra như thế chứ!
Dialogue: 0,0:13:39.62,0:13:41.04,Default,,0,0,0,,Bắt Đầu Nấu Nướng.
Dialogue: 0,0:13:41.04,0:13:43.08,Default,,0,0,0,,Được rồi, bắt tay vào làm thôi nào.
Dialogue: 0,0:13:43.08,0:13:43.87,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:13:45.04,0:13:47.62,Default,,0,0,0,,Em nấu nướng cừ thật đấy.
Dialogue: 0,0:13:47.62,0:13:50.33,Default,,0,0,0,,Dù sao thì ngày nào em cũng tự nấu ăn mà.
Dialogue: 0,0:13:50.62,0:13:51.95,Default,,0,0,0,,Cô đã bắt đầu uống rượu rồi đấy à?
Dialogue: 0,0:13:53.16,0:13:55.54,Default,,0,0,0,,Ủa sao lon này lại nằm trong tủ lạnh thế nhỉ?
Dialogue: 0,0:13:55.54,0:13:57.33,Default,,0,0,0,,Một cách thoái thác trách nhiệm đầy chất thơ đấy cô ạ.
Dialogue: 0,0:13:58.25,0:14:00.29,Default,,0,0,0,,Cô có nhận thức được là đang có học sinh ở đây không đấy?
Dialogue: 0,0:14:00.29,0:14:03.08,Default,,0,0,0,,Vậy thì phần nêm nếm gia vị cứ để cô lo nhé.
Dialogue: 0,0:14:03.08,0:14:04.18,Default,,0,0,0,,Cô nghe nói cồn sẽ giúp thịt mềm hơn đấy.
Dialogue: 0,0:14:04.18,0:14:05.66,Default,,0,0,0,,(Rót ừng ực)\NCô nghe nói cồn sẽ giúp thịt mềm hơn đấy.
Dialogue: 0,0:14:05.66,0:14:06.83,Default,,0,0,0,,(Rót ừng ực)\NThôi ngay đi đồ ngốc này!
Dialogue: 0,0:14:07.04,0:14:09.37,Default,,0,0,0,,Ra đằng kia ngồi mà uống trong trật tự đi cô!
Dialogue: 0,0:14:10.20,0:14:11.91,Default,,0,0,0,,Xin lỗi, cô xin lỗi mà!
Dialogue: 0,0:14:12.20,0:14:14.91,Default,,0,0,0,,Hôm nay cô giáo trông có vẻ phấn khích lạ thường.
Dialogue: 0,0:14:22.29,0:14:23.91,Default,,0,0,0,,Này Mizunoe.
Dialogue: 0,0:14:25.70,0:14:28.12,Default,,0,0,0,,Dạo này mọi chuyện ở Hội học sinh thế nào rồi?
Dialogue: 0,0:14:28.87,0:14:31.70,Default,,0,0,0,,Em cảm thấy rất vui vẻ, cũng là nhờ có cô đấy ạ.
Dialogue: 0,0:14:31.70,0:14:33.33,Default,,0,0,0,,Ồ, thật thế sao? Thật sao em?
Dialogue: 0,0:14:33.70,0:14:35.91,Default,,0,0,0,,Thế em có quý mọi người trong Hội học sinh không?
Dialogue: 0,0:14:36.83,0:14:39.54,Default,,0,0,0,,Chắc cũng có thể nói là như vậy ạ.
Dialogue: 0,0:14:39.54,0:14:41.45,Default,,0,0,0,,Cũng đã được vài tháng rồi mà.
Dialogue: 0,0:14:41.45,0:14:43.37,Default,,0,0,0,,Em rất biết ơn mọi người.
Dialogue: 0,0:14:43.37,0:14:45.00,Default,,0,0,0,,Và em cũng quý họ nữa.
Dialogue: 0,0:14:46.16,0:14:49.62,Default,,0,0,0,,Thế em có thích Michinoku không? Ý cô là, về mặt tình dục ấy?
Dialogue: 0,0:14:49.95,0:14:51.83,Default,,0,0,0,,- Cô nghe đồn hai đứa đang... giao phối với nhau đấy.\N- Cô lại lôi chuyện đó ra nói nữa rồi à?
Dialogue: 0,0:14:51.83,0:14:53.70,Default,,0,0,0,,Biết thế em chẳng thèm trả lời nghiêm túc cho cô làm gì!
Dialogue: 0,0:14:54.45,0:14:57.58,Default,,0,0,0,,Cô xin lỗi mà. Cô đâu có ý trêu em đâu.
Dialogue: 0,0:14:57.58,0:14:59.83,Default,,0,0,0,,Cô chỉ mừng vì mấy đứa hòa thuận với nhau thôi.
Dialogue: 0,0:15:00.04,0:15:02.37,Default,,0,0,0,,Cô cũng quý Michinoku lắm.
Dialogue: 0,0:15:03.08,0:15:04.29,Default,,0,0,0,,Hội trưởng,
Dialogue: 0,0:15:04.29,0:15:08.08,Default,,0,0,0,,Kotobuki, Terui, và cả Tan nữa. Cô đều quý tất cả bọn họ.
Dialogue: 0,0:15:08.08,0:15:09.66,Default,,0,0,0,,Và tiện thể thì cả em nữa.
Dialogue: 0,0:15:09.83,0:15:11.12,Default,,0,0,0,,Hóa ra em chỉ là người được nhắc thêm vào thôi sao?
Dialogue: 0,0:15:11.12,0:15:12.12,Default,,0,0,0,,Bởi vì...
Dialogue: 0,0:15:13.33,0:15:18.20,Default,,0,0,0,,Cô đã luôn rất tốt bụng với em, dù trước đây em vốn là một đứa rất vụng về lóng ngóng.
Dialogue: 0,0:15:20.29,0:15:22.50,Default,,0,0,0,,Em thực sự đã trưởng thành rồi đấy.
Dialogue: 0,0:15:22.50,0:15:25.50,Default,,0,0,0,,Cái thằng nhóc ngày nào cứ ngồi thu lu một góc lớp đọc Trăm Năm Cô Đơn.
Dialogue: 0,0:15:25.50,0:15:27.20,Default,,0,0,0,,Cô đừng có nhắc lại chuyện đó nữa mà!
Dialogue: 0,0:15:27.66,0:15:29.33,Default,,0,0,0,,Thôi nào, cùng ăn thôi!
Dialogue: 0,0:15:29.66,0:15:31.00,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:15:31.54,0:15:32.45,Default,,0,0,0,,Ơ kìa?
Dialogue: 0,0:15:32.62,0:15:34.50,Default,,0,0,0,,Mình dọn thừa bát đĩa rồi sao?
Dialogue: 0,0:15:34.87,0:15:37.04,Default,,0,0,0,,Em không nhận ra à?
Dialogue: 0,0:15:39.04,0:15:41.50,Default,,0,0,0,,Này, cơm xong rồi đấy!
Dialogue: 0,0:15:42.83,0:15:45.17,Default,,0,0,0,,(Ngọ nguậy)
Dialogue: 0,0:15:50.58,0:15:53.12,Default,,0,0,0,,Ủa? Ume?
Dialogue: 0,0:15:53.12,0:15:54.20,Default,,0,0,0,,Sao lại thế này?
Dialogue: 0,0:15:56.66,0:15:58.95,Default,,0,0,0,,Cậu làm cái gì ở đây thế?
Dialogue: 0,0:16:05.87,0:16:08.83,Default,,0,0,0,,Michinoku ơi, cái đó là áo ngực của cô mà.
Dialogue: 0,0:16:09.33,0:16:12.25,Default,,0,0,0,,Phù! Em cứ tưởng nó bị rơi xuống đất cơ.
Dialogue: 0,0:16:12.25,0:16:14.00,Default,,0,0,0,,Thế thì ngượng chết mất.
Dialogue: 0,0:16:14.00,0:16:16.45,Default,,0,0,0,,Mình phải phản ứng thế nào trong hoàn cảnh này đây?
Dialogue: 0,0:16:17.00,0:16:19.20,Default,,0,0,0,,Tình hình là như thế đấy em.
Dialogue: 0,0:16:19.58,0:16:22.95,Default,,0,0,0,,Về cơ bản cô đang đóng vai trò là người giám hộ của Michinoku.
Dialogue: 0,0:16:22.95,0:16:24.75,Default,,0,0,0,,"Tình hình là như thế" nghĩa là sao cơ chứ?
Dialogue: 0,0:16:24.75,0:16:25.75,Default,,0,0,0,,Bây giờ em mới biết chuyện này đấy.
Dialogue: 0,0:16:26.25,0:16:29.29,Default,,0,0,0,,Bọn cô sống ở hai căn hộ riêng biệt nằm sát vách nhau,
Dialogue: 0,0:16:29.29,0:16:31.45,Default,,0,0,0,,nên cũng chẳng phải là cô làm gì to tát lắm đâu.
Dialogue: 0,0:16:31.45,0:16:32.12,Default,,0,0,0,,Ừm.
Dialogue: 0,0:16:32.45,0:16:34.87,Default,,0,0,0,,Cô chỉ nấu ăn và giặt giũ giúp con bé thôi mà.
Dialogue: 0,0:16:34.87,0:16:37.00,Default,,0,0,0,,(Nhai nhồm nhoàm)\NChỉ có bấy nhiêu thôi đấy.
Dialogue: 0,0:16:37.00,0:16:38.33,Default,,0,0,0,,(Nhai nhồm nhoàm)\NCậu ấy là mèo hoang đấy à?
Dialogue: 0,0:16:39.95,0:16:43.70,Default,,0,0,0,,Nhân tiện, bố mẹ của cậu ấy đâu rồi ạ?
Dialogue: 0,0:16:44.45,0:16:46.25,Default,,0,0,0,,Chuyện đó xảy ra lâu lắm rồi... Họ...
Dialogue: 0,0:16:46.25,0:16:48.75,Default,,0,0,0,,Thôi cô. Cô không cần phải nói thêm nữa đâu ạ.
Dialogue: 0,0:16:48.75,0:16:51.25,Default,,0,0,0,,Hình như em vừa hỏi một câu không nên hỏi rồi.
Dialogue: 0,0:16:51.25,0:16:52.20,Default,,0,0,0,,Em xin lỗi.
Dialogue: 0,0:16:52.20,0:16:54.75,Default,,0,0,0,,Em cũng biết đồng cảm ghê nhỉ.
Dialogue: 0,0:16:54.75,0:16:55.87,Default,,0,0,0,,Họ qua đời rồi.
Dialogue: 0,0:16:55.87,0:16:58.29,Default,,0,0,0,,Chuyện lâu lắm rồi nên tớ không sao đâu.
Dialogue: 0,0:16:58.29,0:16:59.83,Default,,0,0,0,,Dù vậy thì em cũng đâu cần phải nói toạc móng heo ra thế chứ.
Dialogue: 0,0:17:01.70,0:17:05.37,Default,,0,0,0,,Bọn cô cứ thế sống thoải mái bên nhau như thế này thôi.
Dialogue: 0,0:17:05.58,0:17:06.87,Default,,0,0,0,,Em hiểu rồi ạ.
Dialogue: 0,0:17:07.08,0:17:09.70,Default,,0,0,0,,Cũng đã hơn nửa năm rồi nhỉ?
Dialogue: 0,0:17:09.70,0:17:10.66,Default,,0,0,0,,Michinoku này.
Dialogue: 0,0:17:10.66,0:17:12.50,Default,,0,0,0,,Trước đây trông em ủ rũ u ám hơn nhiều đúng không?
Dialogue: 0,0:17:12.50,0:17:13.29,Default,,0,0,0,,Thế ạ?
Dialogue: 0,0:17:13.83,0:17:17.16,Default,,0,0,0,,Bây giờ trông em tươi tắn vui vẻ hơn nhiều rồi đấy.
Dialogue: 0,0:17:17.16,0:17:18.12,Default,,0,0,0,,Thật thế ạ?
Dialogue: 0,0:17:18.62,0:17:20.50,Default,,0,0,0,,Tất cả là nhờ có Hội học sinh đấy.
Dialogue: 0,0:17:20.50,0:17:23.16,Default,,0,0,0,,Không, thật ra là nhờ có em đấy, Mizunoe.
Dialogue: 0,0:17:23.50,0:17:25.25,Default,,0,0,0,,Sao tự dưng cô lại lôi em vào chuyện này chứ?
Dialogue: 0,0:17:26.62,0:17:30.29,Default,,0,0,0,,Em là người duy nhất mà Michinoku thân thiết đến mức này đấy.
Dialogue: 0,0:17:30.83,0:17:32.20,Default,,0,0,0,,Thật thế sao ạ?
Dialogue: 0,0:17:32.20,0:17:33.91,Default,,0,0,0,,Đúng thế đấy.
Dialogue: 0,0:17:33.91,0:17:37.24,Default,,0,0,0,,Con bé lúc nào cũng lo lắng xem người khác nghĩ gì về mình.
Dialogue: 0,0:17:37.24,0:17:37.25,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:17:37.25,0:17:40.73,Default,,0,0,0,,(Phòng Hội Học Sinh)\NHai tiếng trôi qua mà không dám làm phiền họ,
Dialogue: 0,0:17:40.73,0:17:41.93,Default,,0,0,0,,(Phòng Hội Học Sinh)\Nvì trông họ có vẻ rất bận rộn.
Dialogue: 0,0:17:41.93,0:17:42.54,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:17:42.54,0:17:46.00,Default,,0,0,0,,Con bé đã mất một khoảng thời gian khá dài mới quen được với Hội học sinh đấy.
Dialogue: 0,0:17:46.00,0:17:46.54,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:17:46.54,0:17:48.12,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:17:48.12,0:17:49.16,Default,,0,0,0,,Nói chung là,
Dialogue: 0,0:17:49.16,0:17:53.20,Default,,0,0,0,,việc tự tiện ngồi lên đùi người khác mà không hỏi trước là khá kỳ quặc đúng không?
Dialogue: 0,0:17:53.20,0:17:54.41,Default,,0,0,0,,Ừm, đúng là thế thật.
Dialogue: 0,0:17:54.66,0:17:55.91,Default,,0,0,0,,Nhắc mới nhớ,
Dialogue: 0,0:17:55.91,0:17:58.70,Default,,0,0,0,,Cô có thấy mình đang áp sát em quá mức rồi không?
Dialogue: 0,0:18:00.04,0:18:01.45,Default,,0,0,0,,Đâu có đâu nào.
Dialogue: 0,0:18:01.45,0:18:02.66,Default,,0,0,0,,Ý em là ngay lúc này này.
Dialogue: 0,0:18:02.66,0:18:03.91,Default,,0,0,0,,Và người cô nồng nặc mùi rượu rồi đấy ạ.
Dialogue: 0,0:18:04.33,0:18:07.08,Default,,0,0,0,,Chà, nếu em đã nói thế thì...
Dialogue: 0,0:18:07.08,0:18:08.33,Default,,0,0,0,,Gì cơ ạ?
Dialogue: 0,0:18:09.77,0:18:11.83,Default,,0,0,0,,(Bịch)
Dialogue: 0,0:18:11.83,0:18:12.83,Default,,0,0,0,,(Bịch)\NCô ấy ngủ mất tiêu rồi.
Dialogue: 0,0:18:13.62,0:18:15.87,Default,,0,0,0,,Cơm ngon quá đi mất!
Dialogue: 0,0:18:16.12,0:18:17.66,Default,,0,0,0,,Cậu thấy ngon miệng là tốt rồi.
Dialogue: 0,0:18:17.87,0:18:19.62,Default,,0,0,0,,Ume, cậu chuẩn bị về à?
Dialogue: 0,0:18:19.62,0:18:21.66,Default,,0,0,0,,Ừ, tớ cũng nên về thôi.
Dialogue: 0,0:18:21.66,0:18:23.37,Default,,0,0,0,,Cô giáo cũng ngủ say mất rồi.
Dialogue: 0,0:18:23.75,0:18:26.04,Default,,0,0,0,,Vậy để tớ tiễn cậu ra cửa nhé.
Dialogue: 0,0:18:27.12,0:18:28.33,Default,,0,0,0,,Nhắc mới nhớ...
Dialogue: 0,0:18:29.66,0:18:33.00,Default,,0,0,0,,tại sao cậu lại quý tớ đến mức như thế vậy?
Dialogue: 0,0:18:37.08,0:18:40.62,Default,,0,0,0,,Xin lỗi nhé. Tớ hỏi thế hơi bất lịch sự nhỉ.
Dialogue: 0,0:18:40.91,0:18:43.20,Default,,0,0,0,,À, chuyện đó ấy hả...
Dialogue: 0,0:18:44.45,0:18:45.75,Default,,0,0,0,,Bí mật nha.
Dialogue: 0,0:18:48.33,0:18:49.79,Default,,0,0,0,,Tại sao chứ?
Dialogue: 0,0:18:49.95,0:18:50.83,Default,,0,0,0,,Này.
Dialogue: 0,0:18:51.04,0:18:53.12,Default,,0,0,0,,Thật luôn đấy à? Chỉ có mỗi chữ 'Này' thôi á?
Dialogue: 0,0:18:53.66,0:18:55.58,Default,,0,0,0,,Tớ chỉ muốn thử nói câu đó một lần xem sao thôi mà.
Dialogue: 0,0:18:55.58,0:18:56.91,Default,,0,0,0,,Tớ thấy người ta nói thế trong sách ấy.
Dialogue: 0,0:18:57.66,0:18:59.45,Default,,0,0,0,,Ừm, chắc đúng là thế thật.
Dialogue: 0,0:18:59.70,0:19:00.79,Default,,0,0,0,,Với tớ thế là đủ rồi.
Dialogue: 0,0:19:00.95,0:19:02.08,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:19:02.08,0:19:02.95,Default,,0,0,0,,Không có gì đâu.
Dialogue: 0,0:19:04.45,0:19:05.37,Default,,0,0,0,,Ái da!
Dialogue: 0,0:19:05.66,0:19:07.25,Default,,0,0,0,,- Chị Hội trưởng!\N- Ái da!
Dialogue: 0,0:19:07.25,0:19:09.37,Default,,0,0,0,,Ủa, Mizunoe đấy à?
Dialogue: 0,0:19:09.66,0:19:10.83,Default,,0,0,0,,Em làm cái gì ở đây thế?
Dialogue: 0,0:19:10.83,0:19:12.41,Default,,0,0,0,,Em xin lỗi vì đã va phải chị nhé.
Dialogue: 0,0:19:12.70,0:19:16.54,Default,,0,0,0,,Có mấy con cá thu đao tươi để trên bàn của cô giáo.
Dialogue: 0,0:19:16.54,0:19:17.70,Default,,0,0,0,,Nên chị mang sang đây cho cô ấy.
Dialogue: 0,0:19:18.00,0:19:19.29,Default,,0,0,0,,Mà dù sao thì,
Dialogue: 0,0:19:19.29,0:19:21.83,Default,,0,0,0,,em đang làm cái trò gì ở đây thế hả?
Dialogue: 0,0:19:21.83,0:19:24.66,Default,,0,0,0,,- Chuyện là vì...\N- Mizunoe ơi!
Dialogue: 0,0:19:25.12,0:19:28.50,Default,,0,0,0,,Đắp chăn cho cô trước khi về đã nào!
Dialogue: 0,0:19:29.54,0:19:31.12,Default,,0,0,0,,Kotobuki đấy à, có chuyện gì thế em?
Dialogue: 0,0:19:31.12,0:19:32.41,Default,,0,0,0,,Em sang đây để cùng tham gia đấy à?
Dialogue: 0,0:19:32.41,0:19:33.95,Default,,0,0,0,,Ume làm tuyệt lắm đấy.
Dialogue: 0,0:19:33.95,0:19:35.58,Default,,0,0,0,,Cùng tham gia? Tuyệt lắm á?
Dialogue: 0,0:19:35.58,0:19:36.66,Default,,0,0,0,,Không, không phải như thế đâu ạ!
Dialogue: 0,0:19:36.66,0:19:39.04,Default,,0,0,0,,Không phải như chị nghĩ đâu, chị Hội trưởng ơi!
Dialogue: 0,0:19:39.37,0:19:41.95,Default,,0,0,0,,Sau đó, tất cả bọn họ đã cùng nhau tham gia cho thỏa thích tới bến.
Dialogue: 0,0:19:42.70,0:19:43.41,Default,,0,0,0,,(À há!)
Dialogue: 0,0:19:43.41,0:19:46.45,Default,,0,0,0,,(À há!)\NCảm giác như mình vừa bỏ lỡ điều gì đó vô cùng quan trọng.
Dialogue: 0,0:19:46.45,0:19:48.62,Default,,0,0,0,,(À há!)\NCậu đang lảm nhảm cái gì thế hả?
Dialogue: 0,0:19:50.58,0:19:51.37,Default,,0,0,0,,Ngon tuyệt cú mèo!
Dialogue: 0,0:19:51.37,0:19:52.41,Default,,0,0,0,,Đã bảo rồi mà lị!
Dialogue: 0,0:19:52.41,0:19:53.41,Default,,0,0,0,,Ừm.
Dialogue: 0,0:19:53.58,0:19:55.83,Default,,0,0,0,,Sao trông hai người lại đắc ý tự mãn thế kia chứ?
Dialogue: 0,0:21:36.50,0:21:37.79,Default,,0,0,0,,Chào buổi sáng mọi người!
Dialogue: 0,0:21:42.12,0:21:43.58,Default,,0,0,0,,Cùng ăn thôi nào!
Dialogue: 0,0:21:45.70,0:21:46.15,Default,,0,0,0,,(Nhai ngấu nghiến)
Dialogue: 0,0:21:57.91,0:21:59.87,Default,,0,0,0,,Điểm dừng tiếp theo là trước cổng\NTrường THCS Wakaba Daiichi.
Dialogue: 0,0:21:59.87,0:22:01.08,Default,,0,0,0,,Hành khách chuẩn bị xuống xe.
Dialogue: 0,0:22:17.52,0:22:19.69,Default,,0,0,0,,(Bài Thi Cuối Kỳ Môn Toán, Komaro Michinoku)
Dialogue: 0,0:22:23.70,0:22:26.16,Default,,0,0,0,,Bài kiểm tra lần này khó dã man đúng không?
Dialogue: 0,0:22:26.16,0:22:27.12,Default,,0,0,0,,Công nhận là khó thật.
Dialogue: 0,0:22:27.12,0:22:29.25,Default,,0,0,0,,Tớ làm tệ ơi là tệ luôn. Được có 50 điểm à.
Dialogue: 0,0:22:29.25,0:22:30.29,Default,,0,0,0,,Còn cậu thì sao hả Misa?
Dialogue: 0,0:22:31.54,0:22:32.20,Default,,0,0,0,,Tớ được 86 điểm nè.
Dialogue: 0,0:22:32.20,0:22:33.66,Default,,0,0,0,,(Cậu Đang Rất Nỗ Lực Đấy!)\NTớ được 86 điểm nè.
Dialogue: 0,0:22:33.66,0:22:34.33,Default,,0,0,0,,Oa, đỉnh thật đấy!
Dialogue: 0,0:22:34.33,0:22:37.70,Default,,0,0,0,,Đúng không? Ngay cả thầy giáo cũng khen tớ làm tốt lắm đấy.
Dialogue: 0,0:22:38.08,0:22:39.20,Default,,0,0,0,,Thấy chưa? Cậu cứ chú tâm vào là làm được ngay mà.
Dialogue: 0,0:22:39.20,0:22:40.66,Default,,0,0,0,,Sướng thế! Tuyệt vời thật đấy.
Dialogue: 0,0:22:48.75,0:22:51.20,Default,,0,0,0,,- Có muốn đi hát karaoke không?\N- Hoạt động CLB chán òm à.
Dialogue: 0,0:23:03.29,0:23:04.12,Default,,0,0,0,,Michinoku ơi.
Dialogue: 0,0:23:09.25,0:23:10.08,Default,,0,0,0,,Chào buổi sáng cậu nhé!
Dialogue: 0,0:23:14.37,0:23:16.66,Default,,0,0,0,,Chúng mình mau đến phòng Hội học sinh thôi nào.
Dialogue: 0,0:23:21.16,0:23:21.95,Default,,0,0,0,,Ừm!
Dialogue: 0,0:23:22.33,0:23:24.50,Default,,0,0,0,,Bài kiểm tra của cậu thế nào rồi?
Dialogue: 0,0:23:24.91,0:23:25.95,Default,,0,0,0,,Tớ được 100 điểm tròn luôn nè!
Dialogue: 0,0:23:25.95,0:23:27.25,Default,,0,0,0,,Thật luôn á?!
Dialogue: 0,0:23:27.25,0:23:28.95,Default,,0,0,0,,Ước gì tớ cũng làm bài tốt được như cậu.
Dialogue: 0,0:23:34.91,0:23:35.91,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)\N(Xem Trước Tập Tiếp Theo)
Dialogue: 0,0:23:35.91,0:23:39.91,Default,,0,0,0,,(Thử Thách Của Komaro)
