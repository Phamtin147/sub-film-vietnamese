Dialogue: 0,0:01:22.00,0:01:28.31,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)
Dialogue: 0,0:01:30.76,0:01:33.19,Default,,0,0,0,,Chuyến dã ngoại suối nước nóng.
Dialogue: 0,0:01:33.21,0:01:35.66,Default,,0,0,0,,- Cô giáo vẫn chưa tới nữa à.\N- Tuyệt quá! Làm mười nháy liên tiếp luôn nào!
Dialogue: 0,0:01:35.69,0:01:37.34,Default,,0,0,0,,Đã quá giờ hẹn mười phút rồi đấy.
Dialogue: 0,0:01:37.36,0:01:38.98,Default,,0,0,0,,- Không biết có chuyện gì xảy ra không nữa.\N- Năm sao luôn! Làm tốt lắm, Komaro!
Dialogue: 0,0:01:39.00,0:01:40.49,Default,,0,0,0,,Để em thử gọi cho cô ấy xem sao.
Dialogue: 0,0:01:40.52,0:01:42.34,Default,,0,0,0,,(Cô Hiratsuka)\NCon hàng này siêu hiếm luôn. Nếu nó hiện ra là tôi chết chắc.
Dialogue: 0,0:01:43.52,0:01:45.87,Default,,0,0,0,,Alo, có chuyện gì thế Mizunoe?
Dialogue: 0,0:01:45.89,0:01:48.90,Default,,0,0,0,,Gọi cho cô vào ngày nghỉ thế này à?\NCần cô tư vấn gì sao?
Dialogue: 0,0:01:49.13,0:01:51.13,Default,,0,0,0,,Hôm nay là chuyến dã ngoại của hội học sinh mà cô.
Dialogue: 0,0:01:51.15,0:01:52.66,Default,,0,0,0,,Đừng bảo là cô quên khuấy mất rồi đấy nhé.
Dialogue: 0,0:01:52.68,0:01:53.33,Default,,0,0,0,,Hả?
Dialogue: 0,0:01:53.75,0:01:54.51,Default,,0,0,0,,Ái chà!
Dialogue: 0,0:01:55.92,0:01:57.72,Default,,0,0,0,,Cảm ơn em đã nhắc nhé.
Dialogue: 0,0:01:57.75,0:01:58.71,Default,,0,0,0,,(Mô tuýp hôm nay)\NCô tới liền đây.
Dialogue: 0,0:01:58.82,0:02:00.83,Default,,0,0,0,,Thái độ kiểu gì thế không biết?!
Dialogue: 0,0:02:00.86,0:02:02.12,Default,,0,0,0,,Cô ấy còn cúp máy ngang xương nữa chứ.
Dialogue: 0,0:02:02.18,0:02:03.34,Default,,0,0,0,,Xin lỗi mọi người nhé.
Dialogue: 0,0:02:03.36,0:02:05.80,Default,,0,0,0,,Chắc chúng ta sẽ bị muộn một chút rồi.
Dialogue: 0,0:02:06.80,0:02:08.97,Default,,0,0,0,,Cẩn thận kẻo đổ đấy. Dùng ống hút đi.
Dialogue: 0,0:02:10.97,0:02:12.13,Default,,0,0,0,,- Trào ra hết rồi kìa!\N- Ồ, cô ấy tới rồi.
Dialogue: 0,0:02:12.16,0:02:14.12,Default,,0,0,0,,Xin lỗi, cô xin lỗi nhé!
Dialogue: 0,0:02:14.14,0:02:16.66,Default,,0,0,0,,Thật tình, cô trễ tận ba tiếng đồng hồ lận đấy!
Dialogue: 0,0:02:16.76,0:02:19.29,Default,,0,0,0,,Này, cô đã cuống cuồng chạy thục mạng hết sức rồi đấy nhé.
Dialogue: 0,0:02:19.31,0:02:22.53,Default,,0,0,0,,Nhìn xem, cô còn đang đi dép lê đây này.\NĐến thời gian chải tóc còn chẳng có nữa là.
Dialogue: 0,0:02:22.55,0:02:25.31,Default,,0,0,0,,À mà, cô còn quên cả mặc áo lót nữa cơ.
Dialogue: 0,0:02:25.33,0:02:27.42,Default,,0,0,0,,- Dù sao thì cũng là đi tắm suối nước nóng mà... đúng không?\N- Komaro, thêm một lần nữa đi! Làm lại nào!
Dialogue: 0,0:02:27.44,0:02:29.04,Default,,0,0,0,,- Đừng có "đúng không" với em!\N- Thêm lần nữa!
Dialogue: 0,0:02:29.20,0:02:31.03,Default,,0,0,0,,Cô lái xe như vậy có thật sự ổn không đấy ạ?
Dialogue: 0,0:02:31.20,0:02:34.24,Default,,0,0,0,,Tất nhiên rồi! Cô có bằng lái xe vàng đấy nhé.
Dialogue: 0,0:02:34.27,0:02:36.60,Default,,0,0,0,,Được rồi, lên đường thôi nào!
Dialogue: 0,0:02:38.77,0:02:41.64,Default,,0,0,0,,Ủa? Xe vừa bị trôi ngược về sau đấy à?
Dialogue: 0,0:02:41.66,0:02:43.15,Default,,0,0,0,,Cô chỉ mới vượt qua mỗi kỳ thi lý thuyết thôi đúng không?
Dialogue: 0,0:02:45.17,0:02:49.15,Default,,0,0,0,,Cuối cùng cũng quen tay rồi.\NCô nhớ lại cách lái xe rồi nhé.
Dialogue: 0,0:02:49.18,0:02:51.11,Default,,0,0,0,,Cô Hiratsuka ơi, cô phóng xe hơi nhanh quá rồi đấy ạ!
Dialogue: 0,0:02:51.30,0:02:53.54,Default,,0,0,0,,Nhìn hai đứa ngồi phía sau kìa.\NTrông chúng không ổn chút nào đâu.
Dialogue: 0,0:02:53.56,0:02:54.97,Default,,0,0,0,,Hai đứa nó đang bám chặt lấy cửa kính kìa!
Dialogue: 0,0:02:55.00,0:02:56.94,Default,,0,0,0,,Nè, khung cảnh đẹp tuyệt vời luôn!
Dialogue: 0,0:02:56.96,0:02:58.42,Default,,0,0,0,,Cô chỉ đang phấn khích quá đà thôi đúng không?
Dialogue: 0,0:02:58.45,0:03:00.05,Default,,0,0,0,,Đạp ga lút cán luôn đi cô!
Dialogue: 0,0:03:00.08,0:03:00.98,Default,,0,0,0,,Rõ luôn!
Dialogue: 0,0:03:01.00,0:03:02.61,Default,,0,0,0,,Khỉ thật, sao mọi chuyện lại thành ra nông nỗi này cơ chứ?
Dialogue: 0,0:03:05.55,0:03:07.05,Default,,0,0,0,,Nhìn kìa, nhìn kìa! Nước biển xanh ngắt một màu luôn!
Dialogue: 0,0:03:07.08,0:03:08.80,Default,,0,0,0,,Ồ, đúng thật này!
Dialogue: 0,0:03:08.98,0:03:11.59,Default,,0,0,0,,Nhắc tới màu xanh, mặt Komaro cũng xanh lè như tàu lá chuối rồi kìa.
Dialogue: 0,0:03:12.18,0:03:12.94,Default,,0,0,0,,Á, đúng thật rồi!
Dialogue: 0,0:03:12.94,0:03:13.91,Default,,0,0,0,,Cậu có sao không đấy?!
Dialogue: 0,0:03:14.17,0:03:16.73,Default,,0,0,0,,Mắt tớ chỉ toàn thấy cầu vồng bảy sắc thôi.
Dialogue: 0,0:03:16.76,0:03:17.88,Default,,0,0,0,,Tớ sắp nôn ra tới nơi rồi...
Dialogue: 0,0:03:17.92,0:03:19.51,Default,,0,0,0,,Ô kìa, có cầu vồng!
Dialogue: 0,0:03:20.02,0:03:22.06,Default,,0,0,0,,Trong xe cũng sắp có cầu vồng luôn rồi kìa.
Dialogue: 0,0:03:24.39,0:03:25.76,Default,,0,0,0,,À đúng rồi, Komaro-chan này.
Dialogue: 0,0:03:25.87,0:03:27.54,Default,,0,0,0,,Em có muốn uống chút nước mơ (nước Ume) không?
Dialogue: 0,0:03:27.82,0:03:29.51,Default,,0,0,0,,Có thể sẽ giúp đỡ buồn nôn hơn đấy.
Dialogue: 0,0:03:29.53,0:03:30.97,Default,,0,0,0,,Cảm ơn chị.
Dialogue: 0,0:03:31.03,0:03:32.47,Default,,0,0,0,,Cả em nữa này, Ume-kun.
Dialogue: 0,0:03:32.50,0:03:34.28,Default,,0,0,0,,À, cảm ơn chị nhé.
Dialogue: 0,0:03:35.02,0:03:36.45,Default,,0,0,0,,Nước Ume à...
Dialogue: 0,0:03:36.47,0:03:37.90,Default,,0,0,0,,Nghe có vẻ hơi khêu gợi nhỉ.
Dialogue: 0,0:03:37.93,0:03:39.51,Default,,0,0,0,,Mày lại lảm nhảm cái gì nữa đấy?
Dialogue: 0,0:03:39.54,0:03:40.96,Default,,0,0,0,,Kotobuki này.
Dialogue: 0,0:03:40.99,0:03:42.33,Default,,0,0,0,,Đi lối nào nữa đây? Tiếp theo đi đâu?
Dialogue: 0,0:03:42.36,0:03:44.70,Default,,0,0,0,,Hả?! Thế thì dâm dục quá đi mất!
Dialogue: 0,0:03:44.79,0:03:45.60,Default,,0,0,0,,Hả?
Dialogue: 0,0:03:47.85,0:03:49.47,Default,,0,0,0,,(Nhà trọ Rongutsutei)\NChúng ta đến nơi rồi!
Dialogue: 0,0:03:49.69,0:03:51.41,Default,,0,0,0,,Em không sao chứ? Đi từ từ thôi.
Dialogue: 0,0:03:51.60,0:03:53.97,Default,,0,0,0,,Tạ ơn trời đất là chúng ta vẫn tới nơi an toàn nguyên vẹn.
Dialogue: 0,0:03:54.00,0:03:56.45,Default,,0,0,0,,Đến trễ tận năm tiếng mà chị gọi là 'nguyên vẹn' đấy à?
Dialogue: 0,0:03:56.80,0:03:57.86,Default,,0,0,0,,(Sách hướng dẫn)\NThế giờ làm gì tiếp đây?
Dialogue: 0,0:03:57.91,0:04:00.32,Default,,0,0,0,,Còn trung tâm năng lượng địa nhiệt mà chúng ta dự định ghé thăm thì sao?
Dialogue: 0,0:04:00.34,0:04:02.11,Default,,0,0,0,,Hả? Đương nhiên là chúng ta phải đi rồi!
Dialogue: 0,0:04:02.72,0:04:04.26,Default,,0,0,0,,(Tada!)\NĐi tắm suối nước nóng thôi nào!
Dialogue: 0,0:04:04.28,0:04:05.90,Default,,0,0,0,,- Kệ bố cái lịch trình đi.\N- Hả?
Dialogue: 0,0:04:05.95,0:04:07.94,Default,,0,0,0,,Cái trung tâm địa nhiệt đó đưa vào chỉ để làm màu cho cuốn cẩm nang thôi.
Dialogue: 0,0:04:07.96,0:04:09.62,Default,,0,0,0,,Chứ làm gì có ai thực sự muốn đến đó đâu, đúng không?
Dialogue: 0,0:04:09.64,0:04:11.78,Default,,0,0,0,,Đây thực sự là tấm lưng của giáo viên chủ nhiệm chúng ta sao?
Dialogue: 0,0:04:17.05,0:04:18.85,Default,,0,0,0,,Cảm giác như mình vừa được tái sinh vậy.
Dialogue: 0,0:04:18.88,0:04:19.91,Default,,0,0,0,,Cô Hiratsuka ơi.
Dialogue: 0,0:04:19.94,0:04:21.86,Default,,0,0,0,,Ở đây không được phép mang rượu bia vào đâu ạ.
Dialogue: 0,0:04:21.89,0:04:23.54,Default,,0,0,0,,Em chẳng hiểu sự đời gì cả.
Dialogue: 0,0:04:23.56,0:04:27.39,Default,,0,0,0,,Đây là phần thưởng xứng đáng dành cho những người lớn đã vất vả lăn lộn ngoài xã hội đấy.
Dialogue: 0,0:04:27.42,0:04:29.34,Default,,0,0,0,,Thôi tha cho em đi cô.
Dialogue: 0,0:04:29.51,0:04:31.93,Default,,0,0,0,,Nào nào, ở đây có ai khác ngoài chúng ta đâu chứ.
Dialogue: 0,0:04:31.95,0:04:32.89,Default,,0,0,0,,Hửm?
Dialogue: 0,0:04:34.95,0:04:37.01,Default,,0,0,0,,Phòng tắm nam ở bên này cơ.
Dialogue: 0,0:04:37.04,0:04:38.84,Default,,0,0,0,,Kotobuki.
Dialogue: 0,0:04:39.49,0:04:41.69,Default,,0,0,0,,Ừ thì, tuổi mới lớn thì tò mò là chuyện bình thường thôi mà.
Dialogue: 0,0:04:41.72,0:04:43.92,Default,,0,0,0,,K-Không phải đâu, không có chuyện đó đâu ạ!
Dialogue: 0,0:04:43.95,0:04:47.24,Default,,0,0,0,,Nếu đã vậy thì nhìn kỹ tấm vách ngăn này xem.
Dialogue: 0,0:04:47.27,0:04:48.02,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:48.08,0:04:50.39,Default,,0,0,0,,Đầy lỗ thủng luôn kìa. Thảo nào.
Dialogue: 0,0:04:50.42,0:04:51.70,Default,,0,0,0,,Mấy cái lỗ đó không phải hơi to quá rồi sao ạ?
Dialogue: 0,0:04:51.73,0:04:52.62,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:04:52.64,0:04:56.23,Default,,0,0,0,,Hai tên nhóc bên kia khéo lại rình mò nhìn trộm qua cũng nên.
Dialogue: 0,0:04:56.78,0:04:58.06,Default,,0,0,0,,(Nuốt nước bọt)
Dialogue: 0,0:04:58.59,0:05:01.06,Default,,0,0,0,,À-Ừm thì...
Dialogue: 0,0:05:01.46,0:05:03.17,Default,,0,0,0,,Xin lỗi đã để cậu phải đợi lâu nhé.
Dialogue: 0,0:05:03.20,0:05:04.21,Default,,0,0,0,,Ừ.
Dialogue: 0,0:05:04.24,0:05:06.23,Default,,0,0,0,,Ủa? Phòng tắm nữ ở ngay sát vách bên cạnh luôn à?
Dialogue: 0,0:05:06.26,0:05:09.33,Default,,0,0,0,,Ừ. Tôi thậm chí còn nghe thấy cả tiếng của cô giáo nữa kìa.
Dialogue: 0,0:05:09.36,0:05:11.04,Default,,0,0,0,,Hừm. Có muốn nhìn trộm một tí không?
Dialogue: 0,0:05:11.88,0:05:13.40,Default,,0,0,0,,Có chuyện gì thế? Sao vậy?
Dialogue: 0,0:05:13.51,0:05:16.73,Default,,0,0,0,,Không có gì, chỉ là tớ không đeo kính thôi.
Dialogue: 0,0:05:17.24,0:05:19.18,Default,,0,0,0,,Tớ nhìn nhầm cậu thành con gái mất.
Dialogue: 0,0:05:22.16,0:05:23.13,Default,,0,0,0,,Cái quái gì thế hả?
Dialogue: 0,0:05:23.15,0:05:24.86,Default,,0,0,0,,Đừng bảo là Ume đang hưng phấn lên đấy nhé.
Dialogue: 0,0:05:24.88,0:05:26.32,Default,,0,0,0,,Thôi đi giùm cái! Làm gì có!
Dialogue: 0,0:05:26.35,0:05:27.36,Default,,0,0,0,,Tôi lên bờ đây.
Dialogue: 0,0:05:27.39,0:05:30.19,Default,,0,0,0,,Sao thế? Ngâm thêm một lát nữa đi.
Dialogue: 0,0:05:36.24,0:05:37.86,Default,,0,0,0,,Hử? Có chuyện gì thế?
Dialogue: 0,0:05:40.15,0:05:42.27,Default,,0,0,0,,Chị có chắc là không có chuyện gì mờ ám đang diễn ra đấy chứ?
Dialogue: 0,0:05:42.29,0:05:44.27,Default,,0,0,0,,Kotobuki, đến lúc lên rồi đấy.
Dialogue: 0,0:05:44.88,0:05:47.53,Default,,0,0,0,,Chẳng có chuyện gì đâu mà. Thật đấy.
Dialogue: 0,0:05:47.88,0:05:50.09,Default,,0,0,0,,(Chúng mình...)\NSao thế, Tan?
Dialogue: 0,0:05:50.11,0:05:51.32,Default,,0,0,0,,Không có gì đâu.
Dialogue: 0,0:05:51.66,0:05:54.62,Default,,0,0,0,,Chắc chỉ là do bọn mình đang ở cái độ tuổi này thôi.
Dialogue: 0,0:05:57.29,0:05:59.51,Default,,0,0,0,,(Phòng tiệc)\NCảm ơn vì bữa ăn thịnh soạn.
Dialogue: 0,0:06:02.07,0:06:04.51,Default,,0,0,0,,Trời ạ, ngon tuyệt cú mèo luôn.
Dialogue: 0,0:06:04.53,0:06:06.12,Default,,0,0,0,,Ngon đến mức không thể tin được!
Dialogue: 0,0:06:06.20,0:06:08.46,Default,,0,0,0,,Nhất là món tinh hoàn cá ngừ (bonito shirako) này này.
Dialogue: 0,0:06:08.68,0:06:10.73,Default,,0,0,0,,Arisu, cậu thực sự thích món đó ghê nhỉ?
Dialogue: 0,0:06:10.82,0:06:11.94,Default,,0,0,0,,Tinh... trùng cá.
Dialogue: 0,0:06:13.12,0:06:14.36,Default,,0,0,0,,Tan à, cậu đùa ác ý ghê luôn á!
Dialogue: 0,0:06:14.39,0:06:15.42,Default,,0,0,0,,Terui này.
Dialogue: 0,0:06:15.56,0:06:19.70,Default,,0,0,0,,Ăn tối xong xuôi rồi thì đến lúc làm cái trò đó thôi. Mọi người biết trò gì rồi đấy.
Dialogue: 0,0:06:19.72,0:06:21.33,Default,,0,0,0,,Hả? Ý chị là...
Dialogue: 0,0:06:21.47,0:06:24.40,Default,,0,0,0,,Về phòng quẩy UNO thôi nào!
Dialogue: 0,0:06:24.43,0:06:29.34,Default,,0,0,0,,(Tiếng ngáy khò khò)
Dialogue: 0,0:06:29.47,0:06:32.37,Default,,0,0,0,,Ngủ say như chết hết cả lũ rồi. Đỉnh thật đấy.
Dialogue: 0,0:06:32.51,0:06:34.52,Default,,0,0,0,,Chắc bọn nó kiệt sức hết cả rồi.
Dialogue: 0,0:06:34.54,0:06:37.60,Default,,0,0,0,,Mình cũng đang hào hứng muốn chơi ghê cơ.
Dialogue: 0,0:06:37.83,0:06:40.18,Default,,0,0,0,,Giờ tính sao đây?\NDù sao thì đây cũng là phòng của bọn con trai mà.
Dialogue: 0,0:06:40.28,0:06:42.46,Default,,0,0,0,,Thấy cũng tội, nhưng chắc phải gọi bọn nó dậy thôi.
Dialogue: 0,0:06:42.48,0:06:44.80,Default,,0,0,0,,Thế thì hãy đánh thức bọn nó bằng một trò chơi đi!
Dialogue: 0,0:06:44.83,0:06:45.64,Default,,0,0,0,,Trò chơi á?
Dialogue: 0,0:06:45.66,0:06:47.85,Default,,0,0,0,,Đi dã ngoại mà không có gối đại chiến thì coi như vứt!
Dialogue: 0,0:06:48.56,0:06:50.28,Default,,0,0,0,,Chị chẳng do dự lấy một giây nào luôn nhỉ.
Dialogue: 0,0:06:51.72,0:06:52.51,Default,,0,0,0,,(Bốp!)
Dialogue: 0,0:06:52.54,0:06:53.48,Default,,0,0,0,,Chị ra tay tàn nhẫn thật đấy.
Dialogue: 0,0:06:57.60,0:06:58.54,Default,,0,0,0,,(Im ắng như tờ)
Dialogue: 0,0:06:58.57,0:07:00.10,Default,,0,0,0,,Chúng nó chẳng thèm nhúc nhích dậy tí nào luôn.
Dialogue: 0,0:07:00.12,0:07:02.83,Default,,0,0,0,,Chị đang tính tiễn chúng nó ngủ ngàn thu luôn đấy à?
Dialogue: 0,0:07:02.86,0:07:04.20,Default,,0,0,0,,Chúng nó vẫn còn sống đúng không chị?
Dialogue: 0,0:07:04.22,0:07:06.57,Default,,0,0,0,,Thế chơi oẳn tù tì lột đồ thì sao?
Dialogue: 0,0:07:06.59,0:07:08.26,Default,,0,0,0,,Ý chị là cái trò mà cuối cùng người ta cởi truồng hết ấy hả?
Dialogue: 0,0:07:08.61,0:07:10.55,Default,,0,0,0,,Thế không phải hơi quá trớn rồi sao ạ?
Dialogue: 0,0:07:11.64,0:07:13.07,Default,,0,0,0,,Ume à...
Dialogue: 0,0:07:13.10,0:07:15.27,Default,,0,0,0,,Cậu không được mang cái đó vào đây đâu đấy nhé.
Dialogue: 0,0:07:15.70,0:07:18.80,Default,,0,0,0,,Trời ơi. Chắc Ume đang mớm đồ ăn cho ai đó trong mơ rồi.
Dialogue: 0,0:07:18.82,0:07:20.12,Default,,0,0,0,,Đáng yêu ghê.
Dialogue: 0,0:07:20.71,0:07:23.06,Default,,0,0,0,,Kể cả trong mơ thì hai đứa nó vẫn hòa thuận ghê nhỉ.
Dialogue: 0,0:07:23.14,0:07:25.34,Default,,0,0,0,,Thôi, tha cho tôi đi...
Dialogue: 0,0:07:30.03,0:07:32.53,Default,,0,0,0,,Hay là mình cứ để con bé ngủ như thế đi.
Dialogue: 0,0:07:32.66,0:07:34.05,Default,,0,0,0,,Ừ, chắc thế là tốt nhất rồi.
Dialogue: 0,0:07:34.07,0:07:35.13,Default,,0,0,0,,Hả?
Dialogue: 0,0:07:35.15,0:07:37.29,Default,,0,0,0,,Vậy thì chắc tớ cũng đi ngủ đây.
Dialogue: 0,0:07:37.33,0:07:38.40,Default,,0,0,0,,Khoan đã nào!
Dialogue: 0,0:07:40.78,0:07:43.99,Default,,0,0,0,,Hôm nay Terui bị làm sao thế nhỉ?
Dialogue: 0,0:07:44.20,0:07:47.33,Default,,0,0,0,,Bình thường cậu ấy cũng tưng tửng gần như thế mà.
Dialogue: 0,0:07:47.36,0:07:50.80,Default,,0,0,0,,Có khi là do ngồi cạnh cô Hiratsuka chăng.
Dialogue: 0,0:07:51.29,0:07:52.52,Default,,0,0,0,,Món này ngon tuyệt cú mèo luôn.
Dialogue: 0,0:07:52.55,0:07:54.99,Default,,0,0,0,,Shirako càng ăn càng cuốn ghê.
Dialogue: 0,0:07:55.02,0:07:56.21,Default,,0,0,0,,Có khi cậu ấy say rồi cũng nên.
Dialogue: 0,0:07:56.24,0:07:57.96,Default,,0,0,0,,Rượu với shirako xộc lên đầu rồi chăng?
Dialogue: 0,0:07:57.98,0:08:00.56,Default,,0,0,0,,Nhưng như thế này thì tôi đâu còn chỗ nào để ngủ nữa chứ.
Dialogue: 0,0:08:00.58,0:08:02.76,Default,,0,0,0,,Xin lỗi vì mấy đứa con gái phòng chị nhé...
Dialogue: 0,0:08:03.03,0:08:05.08,Default,,0,0,0,,Hết cách rồi. Cậu có muốn sang phòng của bọn con gái ngủ không?
Dialogue: 0,0:08:05.18,0:08:06.20,Default,,0,0,0,,Hả?
Dialogue: 0,0:08:06.26,0:08:07.59,Default,,0,0,0,,Chị có chắc là ổn không đấy?
Dialogue: 0,0:08:07.62,0:08:10.19,Default,,0,0,0,,Bên đó rộng rãi thênh thang lắm.
Dialogue: 0,0:08:10.49,0:08:12.49,Default,,0,0,0,,Mà nếu là cậu thì chị cũng chẳng bận tâm đâu.
Dialogue: 0,0:08:12.52,0:08:13.52,Default,,0,0,0,,(Tự đào hố chôn mình)\NThôi chết rồi!
Dialogue: 0,0:08:13.54,0:08:15.32,Default,,0,0,0,,Ý chị là, chị hoàn toàn tin tưởng cậu thôi mà.
Dialogue: 0,0:08:20.86,0:08:23.81,Default,,0,0,0,,Được rồi, tôi tắt đèn đây nhé.
Dialogue: 0,0:08:24.01,0:08:25.23,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:08:25.25,0:08:26.76,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:08:33.45,0:08:36.79,Default,,0,0,0,,(Im ắng tuyệt đối)
Dialogue: 0,0:08:44.99,0:08:47.20,Default,,0,0,0,,Này, cậu vẫn còn thức đấy à?
Dialogue: 0,0:08:47.95,0:08:50.72,Default,,0,0,0,,Ừ. Chị vừa mới tắt đèn xong mà.
Dialogue: 0,0:08:51.01,0:08:52.23,Default,,0,0,0,,Cũng đúng nhỉ.
Dialogue: 0,0:09:00.79,0:09:02.37,Default,,0,0,0,,Nhân tiện thì, cho chị xin lỗi nhé.
Dialogue: 0,0:09:03.26,0:09:05.21,Default,,0,0,0,,Sao tự dưng chị lại xin lỗi thế?
Dialogue: 0,0:09:05.34,0:09:06.59,Default,,0,0,0,,À, không có gì đâu.
Dialogue: 0,0:09:06.66,0:09:10.02,Default,,0,0,0,,Hôm nọ, cậu ngủ gật trong phòng hội học sinh đúng không?
Dialogue: 0,0:09:10.17,0:09:12.87,Default,,0,0,0,,Chị cứ băn khoăn không biết có phải do chị bắt cậu làm việc quá sức hay không.
Dialogue: 0,0:09:13.99,0:09:16.02,Default,,0,0,0,,Chị cứ để tâm chuyện đó mãi.
Dialogue: 0,0:09:16.17,0:09:19.48,Default,,0,0,0,,Với lại lúc nào chị cũng ôm đồm thêm việc nữa.
Dialogue: 0,0:09:20.78,0:09:22.23,Default,,0,0,0,,Ý tôi là...
Dialogue: 0,0:09:22.26,0:09:23.71,Default,,0,0,0,,Thôi nào, đừng nói thế chứ.
Dialogue: 0,0:09:24.30,0:09:26.69,Default,,0,0,0,,Tôi làm là vì tôi thấy vui mà.
Dialogue: 0,0:09:41.26,0:09:43.68,Default,,0,0,0,,Cảm ơn cậu nhé, Ume.
Dialogue: 0,0:09:46.99,0:09:49.79,Default,,0,0,0,,Hình như tôi vừa nói ra một câu sến súa lắm đúng không?
Dialogue: 0,0:09:49.82,0:09:51.52,Default,,0,0,0,,Chị chẳng nghe thấy gì hết trơn.
Dialogue: 0,0:09:54.62,0:09:56.85,Default,,0,0,0,,Mình thiếp đi từ lúc nào thế nhỉ?
Dialogue: 0,0:09:58.63,0:09:59.74,Default,,0,0,0,,Hả?
Dialogue: 0,0:09:59.85,0:10:02.07,Default,,0,0,0,,Phù, vậy là mình với cậu ấy không ngủ chung một nệm.
Dialogue: 0,0:10:02.23,0:10:04.03,Default,,0,0,0,,Chỉ là mình ngủ hay lăn lộn lung tung thôi.
Dialogue: 0,0:10:05.14,0:10:06.68,Default,,0,0,0,,Hú hồn hú vía.
Dialogue: 0,0:10:06.78,0:10:10.42,Default,,0,0,0,,Lỡ mà có chuyện gì xảy ra trong lúc cậu ấy ở dưới sự giám sát của mình thì...
Dialogue: 0,0:10:10.45,0:10:11.54,Default,,0,0,0,,(Ume, Hisako)
Dialogue: 0,0:10:12.52,0:10:15.14,Default,,0,0,0,,Bỏ mẹ rồi. Coi như mình chưa nhìn thấy gì đi.
Dialogue: 0,0:10:15.74,0:10:17.60,Default,,0,0,0,,(Mô tuýp hôm nay)\NTôi phải đi vệ sinh cái đã.
Dialogue: 0,0:10:18.21,0:10:20.85,Default,,0,0,0,,Kotobuki nửa đêm thức dậy đi vệ sinh,
Dialogue: 0,0:10:20.94,0:10:23.23,Default,,0,0,0,,sau đó mộng du mò về rồi chui tọt vào cùng nệm với Mizunoe.
Dialogue: 0,0:10:23.25,0:10:26.04,Default,,0,0,0,,Đương nhiên là sáng hôm sau ai nhìn thấy cũng làm ầm ĩ hết cả lên.
Dialogue: 0,0:10:26.39,0:10:28.15,Default,,0,0,0,,Thế nhưng cuối cùng thì họ cũng giải tỏa được sự hiểu lầm.
Dialogue: 0,0:10:31.56,0:10:32.79,Default,,0,0,0,,(Phòng Hội Học Sinh)
Dialogue: 0,0:10:32.82,0:10:34.14,Default,,0,0,0,,Nhân tiện thì...
Dialogue: 0,0:10:34.17,0:10:36.53,Default,,0,0,0,,Rốt cuộc Terui là một người như thế nào nhỉ?
Dialogue: 0,0:10:36.70,0:10:37.90,Default,,0,0,0,,Tớ chỉ tò mò thắc mắc thôi.
Dialogue: 0,0:10:38.04,0:10:39.36,Default,,0,0,0,,Ý cậu là sao cơ?
Dialogue: 0,0:10:39.38,0:10:40.45,Default,,0,0,0,,Thì là...
Dialogue: 0,0:10:40.53,0:10:42.81,Default,,0,0,0,,Cậu ấy nghiêm khắc, nhưng cũng rất tốt bụng.
Dialogue: 0,0:10:42.84,0:10:45.51,Default,,0,0,0,,Đôi khi trông có vẻ đáng sợ, nhưng cũng có mặt dễ thương nữa.
Dialogue: 0,0:10:45.71,0:10:47.64,Default,,0,0,0,,Tớ đoán cậu ấy là một người khá thú vị.
Dialogue: 0,0:10:51.88,0:10:55.16,Default,,0,0,0,,Tớ chưa từng nghĩ là Ume lại hứng thú với Arisu đấy nhé.
Dialogue: 0,0:10:55.18,0:10:57.03,Default,,0,0,0,,Chẳng phải chị ấy là hội trưởng hội học sinh sao?
Dialogue: 0,0:10:57.36,0:10:59.38,Default,,0,0,0,,Biết ngay cậu sẽ nói câu đó mà.
Dialogue: 0,0:11:00.38,0:11:01.12,Default,,0,0,0,,(Đi đánh thuê cho CLB Bóng Rổ)
Dialogue: 0,0:11:01.59,0:11:04.00,Default,,0,0,0,,Tớ chỉ cảm thấy là vẫn còn rất nhiều điều mình chưa biết về cậu ấy thôi.
Dialogue: 0,0:11:04.28,0:11:05.51,Default,,0,0,0,,Hửm?
Dialogue: 0,0:11:06.25,0:11:08.98,Default,,0,0,0,,Chà, nếu đã vậy thì cùng đi tìm hiểu xem sao!
Dialogue: 0,0:11:09.13,0:11:09.96,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:10.29,0:11:13.53,Default,,0,0,0,,Chiến dịch: Vạch trần bí mật của Arisu!
Dialogue: 0,0:11:13.56,0:11:16.43,Default,,0,0,0,,(Tập 5: Chiến Dịch Ume-Tan-Tan)
Dialogue: 0,0:11:17.39,0:11:18.78,Default,,0,0,0,,Cậu ấy đằng kia kìa.
Dialogue: 0,0:11:19.78,0:11:21.33,Default,,0,0,0,,- Này.\N- Cậu ấy đang làm gì thế?
Dialogue: 0,0:11:21.35,0:11:22.55,Default,,0,0,0,,Hai người đang rình mò ai đấy à?
Dialogue: 0,0:11:22.68,0:11:25.11,Default,,0,0,0,,Sao chúng mình lại phải làm cái trò bám đuôi như phường theo dõi thế này chứ?
Dialogue: 0,0:11:25.13,0:11:26.21,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:26.36,0:11:28.74,Default,,0,0,0,,Muốn hiểu rõ một người thì phải xem con người thật của họ ra sao chứ.
Dialogue: 0,0:11:28.89,0:11:31.13,Default,,0,0,0,,Bình thường Arisu rất cẩn thận trong việc giữ gìn hình tượng đấy.
Dialogue: 0,0:11:31.15,0:11:32.52,Default,,0,0,0,,R-Ra là vậy...
Dialogue: 0,0:11:32.73,0:11:36.89,Default,,0,0,0,,Và nếu mình tìm ra được điểm yếu đáng xấu hổ nào đó, mình có thể dùng nó để trả đũa cậu ấy sau này!
Dialogue: 0,0:11:36.91,0:11:38.59,Default,,0,0,0,,Nghiệp quật không trượt phát nào đâu nhé.
Dialogue: 0,0:11:38.62,0:11:40.61,Default,,0,0,0,,Bản tính của cậu lúc nào cũng thế cả.
Dialogue: 0,0:11:40.63,0:11:42.10,Default,,0,0,0,,Và người ta gọi đó là bị quả báo quật lại đấy.
Dialogue: 0,0:11:42.30,0:11:43.77,Default,,0,0,0,,- Ồ!\N- Cái gì thế?
Dialogue: 0,0:11:43.80,0:11:46.17,Default,,0,0,0,,Cậu ấy đang viết tên ai đó lên bảng kìa.
Dialogue: 0,0:11:46.19,0:11:47.18,Default,,0,0,0,,Cậu ấy đang bắt nạt ai đó sao?
Dialogue: 0,0:11:47.20,0:11:49.35,Default,,0,0,0,,(Trực nhật: Sasaki)\NChắc là danh sách trực nhật ngày mai thôi.
Dialogue: 0,0:11:49.46,0:11:50.31,Default,,0,0,0,,Ồ!
Dialogue: 0,0:11:50.35,0:11:52.71,Default,,0,0,0,,Giờ cậu ấy lại đang viết gì đó vào cuốn sổ trên bàn giáo viên kìa.
Dialogue: 0,0:11:52.73,0:11:54.12,Default,,0,0,0,,Đó chỉ là sổ nhật ký lớp thôi mà.
Dialogue: 0,0:11:55.63,0:11:56.61,Default,,0,0,0,,A!
Dialogue: 0,0:11:56.63,0:11:59.14,Default,,0,0,0,,Cậu ấy vừa nhét cái chìa khóa gì đó vào cặp kìa.
Dialogue: 0,0:11:59.16,0:12:00.08,Default,,0,0,0,,Cậu ấy đang ăn trộm đấy!
Dialogue: 0,0:12:00.11,0:12:01.86,Default,,0,0,0,,Đó là chìa khóa phòng học mà.
Dialogue: 0,0:12:01.88,0:12:04.66,Default,,0,0,0,,Cậu chưa từng làm trực nhật bao giờ thật đấy à?
Dialogue: 0,0:12:05.24,0:12:06.80,Default,,0,0,0,,Đúng như kỳ vọng về Terui.
Dialogue: 0,0:12:06.83,0:12:09.35,Default,,0,0,0,,Ngay cả khi làm trực nhật, cậu ấy cũng làm mọi thứ một cách hoàn hảo.
Dialogue: 0,0:12:09.60,0:12:11.09,Default,,0,0,0,,Chẳng có lấy một hạt sạn tì vết nào.
Dialogue: 0,0:12:11.28,0:12:13.11,Default,,0,0,0,,Chán ngắt thật đấy.
Dialogue: 0,0:12:13.16,0:12:14.03,Default,,0,0,0,,À đúng rồi.
Dialogue: 0,0:12:14.21,0:12:16.04,Default,,0,0,0,,(Terui Arisu) (Cậu sắp muộn rồi đấy)\NHãy gọi Arisu ra ngoài đi.
Dialogue: 0,0:12:16.06,0:12:17.55,Default,,0,0,0,,(Mai nhớ mang đủ đồ dùng học tập nhé)\NSau đó mình có thể lục cặp của cậu ấy lúc cậu ấy đi vắng.
Dialogue: 0,0:12:17.71,0:12:19.46,Default,,0,0,0,,Thế nào cũng có ngày cậu bị nghiệp quật cho xem.
Dialogue: 0,0:12:19.56,0:12:20.75,Default,,0,0,0,,Ừm...
Dialogue: 0,0:12:20.77,0:12:25.11,Default,,0,0,0,,Ume bảo là: 'Tớ muốn nhìn thấy mặt của Terui.'
Dialogue: 0,0:12:25.13,0:12:26.12,Default,,0,0,0,,Này!
Dialogue: 0,0:12:27.17,0:12:29.99,Default,,0,0,0,,Ồ, cậu ấy trả lời rồi này: 'Tới nơi là mày tới số với bà.'
Dialogue: 0,0:12:30.32,0:12:31.40,Default,,0,0,0,,Chắc ý cậu ấy là nhắm vào Ume rồi đúng không?
Dialogue: 0,0:12:31.43,0:12:32.85,Default,,0,0,0,,Đúng là quả báo nhãn tiền mà.
Dialogue: 0,0:12:34.18,0:12:36.55,Default,,0,0,0,,Cậu ấy đi rồi kìa. Kế hoạch thành công!
Dialogue: 0,0:12:36.74,0:12:38.32,Default,,0,0,0,,Có khi cậu ấy chỉ đi vệ sinh thôi.
Dialogue: 0,0:12:38.34,0:12:41.40,Default,,0,0,0,,Tuyệt quá! Mau lục cặp cậu ấy thôi nào.
Dialogue: 0,0:12:41.42,0:12:42.44,Default,,0,0,0,,Này...
Dialogue: 0,0:12:42.71,0:12:44.71,Default,,0,0,0,,Thì ra đây là bàn của Arisu sao.
Dialogue: 0,0:12:44.84,0:12:47.79,Default,,0,0,0,,Khoan đã. Nếu cậu ấy chỉ đi vệ sinh thì sẽ quay lại ngay bây giờ đấy.
Dialogue: 0,0:12:47.81,0:12:49.82,Default,,0,0,0,,Ôi dào, lo gì chứ.
Dialogue: 0,0:12:49.92,0:12:51.61,Default,,0,0,0,,Arisu đi vệ sinh lâu kinh khủng khiếp luôn.
Dialogue: 0,0:12:51.64,0:12:53.40,Default,,0,0,0,,Chắc đang bận làm mấy trò cho ngực to lên ấy mà.
Dialogue: 0,0:12:53.60,0:12:56.95,Default,,0,0,0,,Và chẳng phải đó chính là loại điểm yếu mà cậu đang tìm kiếm sao?
Dialogue: 0,0:12:57.49,0:12:59.96,Default,,0,0,0,,Nhìn kìa, nhìn kìa! Cậu ấy còn vẽ bậy vào vở nữa này.
Dialogue: 0,0:13:00.09,0:13:02.95,Default,,0,0,0,,(Lịch sử Nhật Bản)\NNhân tiện thì hai cậu trông có vẻ thân thiết ghê nhỉ.
Dialogue: 0,0:13:03.08,0:13:05.28,Default,,0,0,0,,Bọn tớ quen nhau từ đời tám hoánh nào rồi.
Dialogue: 0,0:13:05.32,0:13:08.55,Default,,0,0,0,,Tớ quen cậu ấy từ hồi cậu ấy còn là trùm một băng đảng bí mật thời cấp hai cơ.
Dialogue: 0,0:13:08.69,0:13:11.11,Default,,0,0,0,,T-Trùm băng đảng bí mật á?
Dialogue: 0,0:13:11.28,0:13:12.36,Default,,0,0,0,,Ừ, đúng rồi đấy.
Dialogue: 0,0:13:12.46,0:13:15.59,Default,,0,0,0,,Đám bất hảo quanh vùng sợ cậu ấy khiếp vía luôn.
Dialogue: 0,0:13:15.70,0:13:19.16,Default,,0,0,0,,Chúng nó còn gọi cậu ấy là 'Ác Ma Ngực Lép Tàn Bạo' nữa cơ.
Dialogue: 0,0:13:19.49,0:13:20.96,Default,,0,0,0,,Thôi chết rồi... Ác Ma Ngực Lép...
Dialogue: 0,0:13:22.02,0:13:23.85,Default,,0,0,0,,Đó cũng là một điểm yếu nữa đúng không?
Dialogue: 0,0:13:24.08,0:13:26.48,Default,,0,0,0,,Còn cậu thì sao hả Tan? Hồi đó...
Dialogue: 0,0:13:26.53,0:13:29.33,Default,,0,0,0,,Hừm. Tớ nhớ là gặp cậu ấy hồi tớ học năm nhất cấp hai.
Dialogue: 0,0:13:30.91,0:13:34.22,Default,,0,0,0,,Và cậu ấy đập tớ một trận ra bã luôn.
Dialogue: 0,0:13:34.90,0:13:37.55,Default,,0,0,0,,Không, khoan đã! Tớ không có thua đâu nhé!
Dialogue: 0,0:13:37.66,0:13:40.41,Default,,0,0,0,,Tớ vẫn đang chờ cơ hội để phục thù đây này!
Dialogue: 0,0:13:40.43,0:13:41.66,Default,,0,0,0,,Ừ, chúc cậu may mắn với điều đó nhé.
Dialogue: 0,0:13:41.76,0:13:43.32,Default,,0,0,0,,Ồ nè, có điện thoại này.
Dialogue: 0,0:13:43.48,0:13:45.56,Default,,0,0,0,,Khoan đã nào. Làm thế là đi quá xa rồi đấy...
Dialogue: 0,0:13:46.44,0:13:47.46,Default,,0,0,0,,Hả?
Dialogue: 0,0:13:48.89,0:13:51.13,Default,,0,0,0,,Cái này chụp từ đợt đi dã ngoại à?
Dialogue: 0,0:14:06.49,0:14:08.28,Default,,0,0,0,,Tạm thời trốn ở đây cái đã.
Dialogue: 0,0:14:08.82,0:14:12.68,Default,,0,0,0,,♪Ume-tan-tan, Komaru-maru♪
Dialogue: 0,0:14:12.70,0:14:13.99,Default,,0,0,0,,Có phải Terui...
Dialogue: 0,0:14:14.01,0:14:16.52,Default,,0,0,0,,- đang hát bài hát tự chế sến súa nhất trần đời không?\N- ♪Hội trưởng của chúng ta luôn tươi vui, tràn đầy năng lượng!♪
Dialogue: 0,0:14:16.68,0:14:20.02,Default,,0,0,0,,Tớ có cảm giác như mình vừa vô tình chứng kiến điều không nên thấy rồi.
Dialogue: 0,0:14:21.43,0:14:22.39,Default,,0,0,0,,Sao thế cậu?
Dialogue: 0,0:14:22.49,0:14:23.47,Default,,0,0,0,,Không có gì đâu.
Dialogue: 0,0:14:23.74,0:14:25.89,Default,,0,0,0,,Chỉ là tớ vừa tìm thấy một điểm yếu siêu xịn thôi.
Dialogue: 0,0:14:25.91,0:14:27.30,Default,,0,0,0,,Thế nên tớ mới thấy vui đấy.
Dialogue: 0,0:14:27.65,0:14:29.06,Default,,0,0,0,,Mình phải quay video lại cảnh này mới được.
Dialogue: 0,0:14:29.09,0:14:30.98,Default,,0,0,0,,Này, đừng có ngọ nguậy lung tung thế chứ.
Dialogue: 0,0:14:34.24,0:14:35.15,Default,,0,0,0,,Hả?
Dialogue: 0,0:14:35.18,0:14:36.08,Default,,0,0,0,,- Hả?\N- Hả?
Dialogue: 0,0:14:36.71,0:14:40.29,Default,,0,0,0,,- Cuối cùng chúng ta cũng tìm ra điểm yếu của Arisu rồi!\N- ♪Ume-tan-tan, Komaru♪
Dialogue: 0,0:14:43.67,0:14:46.83,Default,,0,0,0,,Nếu không muốn bức ảnh này bị đăng lên mạng thì tốt nhất là hãy quên sạch những gì vừa thấy đi nhé.
Dialogue: 0,0:14:47.37,0:14:49.22,Default,,0,0,0,,(Tách!)\NĐúng là chúng mình không thể nào đọ lại cậu ấy được mà.
Dialogue: 0,0:14:49.73,0:14:51.41,Default,,0,0,0,,(Bí mật của Terui: )\NBí mật của Terui là
Dialogue: 0,0:14:51.43,0:14:54.40,Default,,0,0,0,,(Cậu ấy yêu quý tất cả mọi người trong Hội Học Sinh)\Ncậu ấy cực kỳ yêu quý tất cả mọi người trong Hội Học Sinh.
Dialogue: 0,0:14:55.53,0:14:56.61,Default,,0,0,0,,(Run rẩy, Komaro chật vật làm trực nhật)
Dialogue: 0,0:14:58.73,0:15:01.65,Default,,0,0,0,,Trời ạ, mưa rồi kìa.
Dialogue: 0,0:15:01.87,0:15:02.86,Default,,0,0,0,,Ừ.
Dialogue: 0,0:15:03.05,0:15:05.21,Default,,0,0,0,,Dự báo thời tiết bảo hôm nay trời nắng mà.
Dialogue: 0,0:15:05.60,0:15:08.03,Default,,0,0,0,,Tớ có mang ô gấp này. Còn cậu thì sao hả Michinoku?
Dialogue: 0,0:15:08.05,0:15:09.53,Default,,0,0,0,,Hôm nay tớ có mang theo một cái.
Dialogue: 0,0:15:10.55,0:15:13.51,Default,,0,0,0,,Cái ô tớ bỏ quên ở đây vẫn còn nguyên.
Dialogue: 0,0:15:13.65,0:15:15.83,Default,,0,0,0,,Bình thường là chẳng bao giờ tìm lại được đâu.
Dialogue: 0,0:15:15.96,0:15:18.08,Default,,0,0,0,,V-Vậy thì tốt rồi.
Dialogue: 0,0:15:18.36,0:15:19.77,Default,,0,0,0,,Thế thì về nhà thôi nào.
Dialogue: 0,0:15:19.92,0:15:20.92,Default,,0,0,0,,Ừ.
Dialogue: 0,0:15:24.20,0:15:26.30,Default,,0,0,0,,Tự dưng trời lại đổ mưa rào thế không biết.
Dialogue: 0,0:15:26.97,0:15:29.90,Default,,0,0,0,,(Tập 5: Cùng Che Ô Với Ume)
Dialogue: 0,0:15:30.24,0:15:31.60,Default,,0,0,0,,H-Hội trưởng!
Dialogue: 0,0:15:32.59,0:15:34.26,Default,,0,0,0,,Cậu chuẩn bị về nhà đấy à?
Dialogue: 0,0:15:34.56,0:15:36.28,Default,,0,0,0,,(Thình thịch)\NA! Mizunoe!
Dialogue: 0,0:15:36.57,0:15:37.61,Default,,0,0,0,,X-Xin lỗi nhé.
Dialogue: 0,0:15:37.63,0:15:39.80,Default,,0,0,0,,Tớ vừa bước chân ra ngoài thì trời đổ mưa mất tiêu.
Dialogue: 0,0:15:39.96,0:15:41.91,Default,,0,0,0,,Thế mà dự báo bảo là trời quang đãng cơ đấy.
Dialogue: 0,0:15:42.31,0:15:44.16,Default,,0,0,0,,Cậu cũng chuẩn bị về nhà à Mizunoe?
Dialogue: 0,0:15:44.19,0:15:45.25,Default,,0,0,0,,Ừ.
Dialogue: 0,0:15:45.28,0:15:47.53,Default,,0,0,0,,Tớ vừa định về chung với Michinoku đây.
Dialogue: 0,0:15:47.55,0:15:48.49,Default,,0,0,0,,Ủa?
Dialogue: 0,0:15:48.60,0:15:49.65,Default,,0,0,0,,Cậu ấy biến mất đâu rồi.
Dialogue: 0,0:15:49.78,0:15:51.03,Default,,0,0,0,,Cậu ấy về trước rồi à?
Dialogue: 0,0:15:51.70,0:15:52.87,Default,,0,0,0,,(Trong khi đó, Komaro...)
Dialogue: 0,0:15:52.97,0:15:54.82,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:15:55.65,0:15:57.31,Default,,0,0,0,,Mưa không ngớt được nhỉ?
Dialogue: 0,0:15:57.52,0:16:00.58,Default,,0,0,0,,Thế cậu có muốn che chung ô với tớ không?
Dialogue: 0,0:16:00.61,0:16:01.41,Default,,0,0,0,,Ồ, lời đề nghị hấp dẫn ghê đó.
Dialogue: 0,0:16:01.46,0:16:02.94,Default,,0,0,0,,Thế thì tuyệt quá rồi. Cảm ơn cậu nhé.
Dialogue: 0,0:16:02.96,0:16:03.65,Default,,0,0,0,,Hả?
Dialogue: 0,0:16:03.73,0:16:05.87,Default,,0,0,0,,Tớ phải mau về nhà để nấu bữa tối cho em trai nữa.
Dialogue: 0,0:16:05.89,0:16:07.03,Default,,0,0,0,,Cậu giúp tớ một phen lớn rồi đấy.
Dialogue: 0,0:16:07.23,0:16:09.07,Default,,0,0,0,,À-À, ra là vậy.
Dialogue: 0,0:16:09.21,0:16:10.83,Default,,0,0,0,,Chúng mình đi thôi chứ nhỉ?
Dialogue: 0,0:16:10.94,0:16:11.76,Default,,0,0,0,,Ồ!
Dialogue: 0,0:16:11.84,0:16:13.70,Default,,0,0,0,,(Ngắn, Dài)\NCây ô này nhìn độc lạ ghê nhỉ.
Dialogue: 0,0:16:13.72,0:16:16.22,Default,,0,0,0,,Ồ, cậu nhận ra rồi à! Tinh mắt thế!
Dialogue: 0,0:16:16.43,0:16:20.04,Default,,0,0,0,,Nó được thiết kế để giữ cho cặp sách không bị ướt đấy.
Dialogue: 0,0:16:20.06,0:16:21.16,Default,,0,0,0,,Ra là thế.
Dialogue: 0,0:16:21.25,0:16:24.24,Default,,0,0,0,,Với lại tớ nghe nói nó được thiết kế dựa trên các nguyên lý khí động học nữa cơ.
Dialogue: 0,0:16:24.27,0:16:25.84,Default,,0,0,0,,(Phành phạch)\NNên nó có thể chống chịu được gió giật mạnh đấy.
Dialogue: 0,0:16:25.86,0:16:27.39,Default,,0,0,0,,- Tớ đã chờ mãi cơ hội để đem ra dùng thử đây.\N- Đỉnh thật đấy.
Dialogue: 0,0:16:27.42,0:16:29.81,Default,,0,0,0,,- Nhìn cậu có vẻ vui ghê. Mừng cho cậu nhé.\N- Thiết kế cũng đơn giản và phong cách nữa chứ.
Dialogue: 0,0:16:29.84,0:16:31.00,Default,,0,0,0,,(Cặp đôi ngốc nghếch đáng yêu)\NCặp đôi ngốc nghếch đáng yêu.
Dialogue: 0,0:16:31.30,0:16:33.22,Default,,0,0,0,,Được rồi, chúng mình đi thôi nào.
Dialogue: 0,0:16:33.24,0:16:34.09,Default,,0,0,0,,Được chứ.
Dialogue: 0,0:16:38.66,0:16:41.17,Default,,0,0,0,,- Bọn mình đứng sát nhau ghê nhỉ?\N- Bọn mình đứng sát nhau ghê nhỉ?
Dialogue: 0,0:16:41.38,0:16:43.73,Default,,0,0,0,,Bề ngang của cây ô này hẹp hơn bình thường mà.
Dialogue: 0,0:16:43.82,0:16:45.65,Default,,0,0,0,,(DỪNG LẠI)
Dialogue: 0,0:16:50.25,0:16:50.86,Default,,0,0,0,,(Chạm vào nhau)
Dialogue: 0,0:16:50.89,0:16:52.12,Default,,0,0,0,,X-X-X-Xin lỗi cậu nhé!
Dialogue: 0,0:16:52.14,0:16:54.02,Default,,0,0,0,,Không sao đâu. Lỗi của tớ nữa mà.
Dialogue: 0,0:16:54.05,0:16:56.08,Default,,0,0,0,,Hay là bọn mình đi người trước người sau nhé?
Dialogue: 0,0:16:56.10,0:16:58.54,Default,,0,0,0,,Đúng rồi! Cây ô này dài về phía trước sau mà.
Dialogue: 0,0:16:58.56,0:16:59.91,Default,,0,0,0,,Thế thì đi thôi nào.
Dialogue: 0,0:17:01.02,0:17:03.27,Default,,0,0,0,,Xin lỗi nhé. Bọn mình thử bước đều chân xem sao.
Dialogue: 0,0:17:03.29,0:17:04.35,Default,,0,0,0,,Bắt đầu bằng chân phải nhé.
Dialogue: 0,0:17:04.37,0:17:05.81,Default,,0,0,0,,Đ-Được rồi.
Dialogue: 0,0:17:06.22,0:17:08.51,Default,,0,0,0,,- Một, hai, chân phải!\N- A! Có vũng nước kìa!
Dialogue: 0,0:17:08.85,0:17:10.65,Default,,0,0,0,,Tớ thực sự xin lỗi nhé.
Dialogue: 0,0:17:10.68,0:17:12.03,Default,,0,0,0,,Tất cả là tại cây ô của tớ cả.
Dialogue: 0,0:17:12.06,0:17:14.48,Default,,0,0,0,,Không đâu, cây ô này vốn dành cho một người mà. Lỗi là do tớ đấy chứ.
Dialogue: 0,0:17:14.64,0:17:18.22,Default,,0,0,0,,A! Nếu bọn mình cầm ô xoay ngang lại thì có thể đi song song cạnh nhau được này!
Dialogue: 0,0:17:18.24,0:17:20.31,Default,,0,0,0,,Đúng thật này! Ý kiến hay đấy chứ.
Dialogue: 0,0:17:24.78,0:17:26.57,Default,,0,0,0,,C-Cách này hiệu quả thật này!
Dialogue: 0,0:17:26.62,0:17:27.84,Default,,0,0,0,,Chuẩn luôn rồi.
Dialogue: 0,0:17:28.24,0:17:30.00,Default,,0,0,0,,Mừng là chúng mình đã tìm ra cách.
Dialogue: 0,0:17:30.84,0:17:31.24,Default,,0,0,0,,(Vù vù)
Dialogue: 0,0:17:31.71,0:17:34.34,Default,,0,0,0,,À đúng rồi. Cây ô này...
Dialogue: 0,0:17:34.88,0:17:37.61,Default,,0,0,0,,không có tác dụng chắn gió tạt từ bên hông.
Dialogue: 0,0:17:37.63,0:17:39.29,Default,,0,0,0,,À ừm, c-cậu thấy đấy...
Dialogue: 0,0:17:39.35,0:17:41.10,Default,,0,0,0,,Thôi chết rồi...
Dialogue: 0,0:17:41.61,0:17:44.08,Default,,0,0,0,,Hửm? Michinoku?
Dialogue: 0,0:17:44.35,0:17:46.13,Default,,0,0,0,,(Ga Kawasun)
Dialogue: 0,0:17:48.99,0:17:51.36,Default,,0,0,0,,- Cho một cây ô bình thường với ạ.\N- Cho một cây ô bình thường với ạ.
Dialogue: 0,0:17:51.49,0:17:52.95,Default,,0,0,0,,(Ướt sũng như chuột lột)\NCó ngay đây ạ.
Dialogue: 0,0:17:52.97,0:17:55.29,Default,,0,0,0,,Cả ba đứa mình đều ướt như chuột lột hết cả.
Dialogue: 0,0:17:56.05,0:17:58.49,Default,,0,0,0,,Nữ sinh cấp ba đúng là ngực to thật đấy.
Dialogue: 0,0:17:58.51,0:17:59.31,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:17:59.59,0:18:01.68,Default,,0,0,0,,Không, tớ đâu có nói về cậu.
Dialogue: 0,0:18:02.44,0:18:05.33,Default,,0,0,0,,Phù, hôm nay được về sớm.
Dialogue: 0,0:18:05.72,0:18:07.88,Default,,0,0,0,,(Ume thuộc Câu Lạc Bộ Thủ Công)\NLâu lắm rồi mình mới ghé qua câu lạc bộ.
Dialogue: 0,0:18:08.23,0:18:10.41,Default,,0,0,0,,Dù chắc là chẳng có ai ở đó đâu.
Dialogue: 0,0:18:10.70,0:18:11.61,Default,,0,0,0,,Ủa?
Dialogue: 0,0:18:12.11,0:18:14.30,Default,,0,0,0,,Batsunosuke? Cậu làm gì ngoài cửa phòng câu lạc bộ thế?
Dialogue: 0,0:18:14.32,0:18:15.58,Default,,0,0,0,,U-Ume!
Dialogue: 0,0:18:15.83,0:18:17.20,Default,,0,0,0,,Này.
Dialogue: 0,0:18:17.42,0:18:20.67,Default,,0,0,0,,Tớ xin lỗi vì lúc nào cũng gây rắc rối cho cậu nhé.
Dialogue: 0,0:18:20.78,0:18:22.49,Default,,0,0,0,,Tớ thật sự xin lỗi.
Dialogue: 0,0:18:22.78,0:18:24.39,Default,,0,0,0,,Hả? Sao tự dưng lại xin lỗi tớ thế?
Dialogue: 0,0:18:24.90,0:18:25.71,Default,,0,0,0,,Nhìn kìa.
Dialogue: 0,0:18:26.52,0:18:28.33,Default,,0,0,0,,Họ cướp mất phòng câu lạc bộ của chúng mình rồi.
Dialogue: 0,0:18:28.85,0:18:31.03,Default,,0,0,0,,(Bồn chồn đứng ngồi không yên)\NNày, cái quái gì thế hả? Đã xảy ra chuyện gì vậy?
Dialogue: 0,0:18:31.05,0:18:32.41,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:18:32.71,0:18:34.29,Default,,0,0,0,,Tớ cũng chẳng biết nữa.
Dialogue: 0,0:18:34.58,0:18:37.18,Default,,0,0,0,,Vừa mới một phút trước tớ còn ở trong đó, thế mà chớp mắt một cái tớ đã bị tống ra ngồi trên sàn nhà lạnh ngắt rồi.
Dialogue: 0,0:18:37.20,0:18:38.32,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:18:38.64,0:18:39.83,Default,,0,0,0,,Họ cứ thế ngang nhiên chiếm đoạt luôn sao?
Dialogue: 0,0:18:39.97,0:18:42.31,Default,,0,0,0,,Điều duy nhất tớ có thể nghĩ tới là...
Dialogue: 0,0:18:42.56,0:18:44.39,Default,,0,0,0,,- Trong buổi họp các chủ tịch câu lạc bộ lần trước...\N- CLB Chế tạo Robot cũng nên có một phòng riêng chứ.
Dialogue: 0,0:18:44.41,0:18:45.90,Default,,0,0,0,,- Tớ nhớ mang máng là có chuyện như thế nảy sinh.\N- Cậu cũng nghĩ thế đúng không?
Dialogue: 0,0:18:45.92,0:18:47.00,Default,,0,0,0,,- Chuẩn luôn.\N- Tớ đoán là vậy.
Dialogue: 0,0:18:47.15,0:18:49.82,Default,,0,0,0,,Giờ bọn mình phải làm sao đây?\NBao nhiêu đồ đạc của chúng mình vẫn còn ở trong đó.
Dialogue: 0,0:18:49.84,0:18:51.51,Default,,0,0,0,,Cậu nói đúng đấy.
Dialogue: 0,0:18:51.71,0:18:52.67,Default,,0,0,0,,Tớ xin lỗi nhé.
Dialogue: 0,0:18:52.70,0:18:54.51,Default,,0,0,0,,Để tớ vào nói chuyện thẳng thắn với bọn họ.
Dialogue: 0,0:18:54.53,0:18:56.17,Default,,0,0,0,,Nhìn kìa.
Dialogue: 0,0:18:56.34,0:18:58.67,Default,,0,0,0,,C-Có cả ổ cắm điện luôn này!
Dialogue: 0,0:18:58.70,0:19:01.36,Default,,0,0,0,,Ừ, có cả bàn ghế đàng hoàng nữa này Trợ lý.
Dialogue: 0,0:19:01.57,0:19:03.49,Default,,0,0,0,,Thật đấy à?
Dialogue: 0,0:19:03.52,0:19:05.58,Default,,0,0,0,,Đây thực sự là...
Dialogue: 0,0:19:05.60,0:19:07.89,Default,,0,0,0,,Ừ, phòng câu lạc bộ của chúng ta đấy.
Dialogue: 0,0:19:07.91,0:19:08.91,Default,,0,0,0,,Nói ra mà tao còn thấy ngượng cả mồm.
Dialogue: 0,0:19:09.16,0:19:10.92,Default,,0,0,0,,Xin lỗi làm phiền chút.
Dialogue: 0,0:19:10.94,0:19:11.89,Default,,0,0,0,,Hửm?
Dialogue: 0,0:19:11.91,0:19:14.70,Default,,0,0,0,,Mấy người muốn làm gì với phòng câu lạc bộ của chúng tôi thế hả?
Dialogue: 0,0:19:14.75,0:19:16.93,Default,,0,0,0,,Bọn họ thực sự dám nhận vơ đây là phòng của họ kìa.
Dialogue: 0,0:19:17.29,0:19:20.29,Default,,0,0,0,,Các cậu đã nộp giấy tờ chuyển nhượng quyền sử dụng phòng này chưa?
Dialogue: 0,0:19:20.31,0:19:21.85,Default,,0,0,0,,Chuyện này diễn ra đột ngột quá đấy.
Dialogue: 0,0:19:21.87,0:19:23.08,Default,,0,0,0,,Đương nhiên là nộp rồi chứ sao.
Dialogue: 0,0:19:23.11,0:19:26.83,Default,,0,0,0,,Cái gã đằng kia đã ký tên đóng dấu vào giấy tờ cho bọn tao trong một nốt nhạc luôn rồi.
Dialogue: 0,0:19:26.86,0:19:27.93,Default,,0,0,0,,Tớ xin lỗi.
Dialogue: 0,0:19:27.96,0:19:30.33,Default,,0,0,0,,Sao cậu lại vội vàng ký vào một thứ vô lý đùng đùng như thế chứ hả?
Dialogue: 0,0:19:30.73,0:19:32.23,Default,,0,0,0,,Tệ thật rồi.
Dialogue: 0,0:19:32.26,0:19:34.06,Default,,0,0,0,,Giờ thì chúng mình đâu còn lý lẽ gì để nói nữa...
Dialogue: 0,0:19:34.08,0:19:34.87,Default,,0,0,0,,Ủa?
Dialogue: 0,0:19:35.03,0:19:37.15,Default,,0,0,0,,Ume? Có chuyện gì thế?
Dialogue: 0,0:19:37.18,0:19:38.47,Default,,0,0,0,,Terui.
Dialogue: 0,0:19:38.50,0:19:41.15,Default,,0,0,0,,Thật ra thì CLB Robot đã làm thế này thế nọ...
Dialogue: 0,0:19:41.35,0:19:42.45,Default,,0,0,0,,Tôi hiểu rồi.
Dialogue: 0,0:19:42.82,0:19:44.69,Default,,0,0,0,,(Trừng mắt lườm)\NĐây là hành vi chiếm đoạt trái phép.
Dialogue: 0,0:19:44.71,0:19:47.11,Default,,0,0,0,,CLB Chế tạo Robot thậm chí còn chưa được cấp phép có phòng câu lạc bộ đâu nhé.
Dialogue: 0,0:19:47.14,0:19:48.18,Default,,0,0,0,,Thật vậy sao?
Dialogue: 0,0:19:48.45,0:19:50.82,Default,,0,0,0,,Nhưng chuyện này tuyệt vời quá đúng không Trợ lý?
Dialogue: 0,0:19:50.85,0:19:52.09,Default,,0,0,0,,Vâng thưa tiền bối.
Dialogue: 0,0:19:52.30,0:19:55.78,Default,,0,0,0,,Em chưa từng nghĩ là chúng ta lại có được phòng sinh hoạt trước cả khi trở thành một câu lạc bộ chính thức đấy.
Dialogue: 0,0:19:56.06,0:19:58.62,Default,,0,0,0,,Đây là bước đệm đầu tiên để trở thành một câu lạc bộ chính thức đấy nhé.
Dialogue: 0,0:19:58.64,0:20:00.03,Default,,0,0,0,,(Con ranh ngực lép phiền toái)\NCon ranh ngực lép phiền toái đó
Dialogue: 0,0:20:00.03,0:20:01.95,Default,,0,0,0,,(Con ranh ngực lép phiền toái)\Nsẽ phải nuốt lại những lời cay độc đó thôi!
Dialogue: 0,0:20:01.98,0:20:03.24,Default,,0,0,0,,Đúng vậy thưa tiền bối!
Dialogue: 0,0:20:03.26,0:20:04.37,Default,,0,0,0,,(Giật mình thảng thốt)\NXin phép nhé.
Dialogue: 0,0:20:04.50,0:20:06.68,Default,,0,0,0,,S-Sao hội học sinh lại ở đây thế này?
Dialogue: 0,0:20:06.83,0:20:07.96,Default,,0,0,0,,Chào mọi người.
Dialogue: 0,0:20:08.01,0:20:09.18,Default,,0,0,0,,Chúng ta cần phải thảo luận một số việc đấy.
Dialogue: 0,0:20:09.21,0:20:12.92,Default,,0,0,0,,Bây giờ chính là cơ hội để chúng ta thanh toán dứt điểm mối ân oán một lần cho xong!
Dialogue: 0,0:20:12.94,0:20:14.06,Default,,0,0,0,,Đ-Đúng thế!
Dialogue: 0,0:20:14.08,0:20:15.51,Default,,0,0,0,,Này, Terui.
Dialogue: 0,0:20:15.65,0:20:16.91,Default,,0,0,0,,Gì cơ?
Dialogue: 0,0:20:18.03,0:20:18.83,Default,,0,0,0,,Tiền bối ơi...
Dialogue: 0,0:20:18.86,0:20:21.01,Default,,0,0,0,,Tỉnh táo lại đi tiền bối!
Dialogue: 0,0:20:21.41,0:20:22.83,Default,,0,0,0,,Sao cả cậu cũng a dua theo thế hả?
Dialogue: 0,0:20:22.92,0:20:26.14,Default,,0,0,0,,Bọn tao đã lấy được phòng từ CLB Thủ Công rồi.
Dialogue: 0,0:20:26.16,0:20:27.54,Default,,0,0,0,,(Phòng CLB đã được bàn giao)\NĐây mới chỉ là sự khởi đầu thôi!
Dialogue: 0,0:20:27.56,0:20:30.62,Default,,0,0,0,,Chính xác! Giờ chúng ta đã có phòng câu lạc bộ rồi thì chẳng ai có thể cản đường chúng ta được nữa!
Dialogue: 0,0:20:31.70,0:20:33.61,Default,,0,0,0,,M-M-Mấy người muốn làm gì với phòng câu lạc bộ của bọn tao hả?
Dialogue: 0,0:20:33.63,0:20:35.70,Default,,0,0,0,,Ngầu quá đi mất, tiền bối ơi!
Dialogue: 0,0:20:35.72,0:20:39.22,Default,,0,0,0,,CLB Robot chưa được duyệt cấp phòng. Đề nghị các bạn giải tán và rời khỏi đây ngay.
Dialogue: 0,0:20:40.12,0:20:41.50,Default,,0,0,0,,Tiền bối ơi!
Dialogue: 0,0:20:41.52,0:20:43.25,Default,,0,0,0,,(Người máy biểu tình ngồi)\NÔi nguy to rồi!
Dialogue: 0,0:20:43.30,0:20:44.47,Default,,0,0,0,,(Người máy tuyệt thực)\NCấm được bước tới gần đây!
Dialogue: 0,0:20:44.49,0:20:46.29,Default,,0,0,0,,(Bọn tao sẽ kháng cự tới cùng!)\NKhông là bọn tao ấn nút tự hủy đấy nhé!
Dialogue: 0,0:20:46.29,0:20:47.29,Default,,0,0,0,,Bọn tao sẽ không bao giờ nhượng bộ đâu!
Dialogue: 0,0:20:49.66,0:20:51.29,Default,,0,0,0,,C-Có chuyện gì thế?
Dialogue: 0,0:20:51.31,0:20:53.23,Default,,0,0,0,,Tớ... Tất cả là do tớ cả...
Dialogue: 0,0:20:53.30,0:20:55.99,Default,,0,0,0,,Chuyện này xảy ra là vì tớ quá đỗi vô dụng.
Dialogue: 0,0:20:56.02,0:20:56.95,Default,,0,0,0,,Tớ xin lỗi mọi người.
Dialogue: 0,0:20:56.97,0:20:59.17,Default,,0,0,0,,Sao cậu ta lại phải xin lỗi chứ?
Dialogue: 0,0:20:59.20,0:21:00.72,Default,,0,0,0,,Bản tính cậu ấy xưa nay vốn dĩ như thế rồi mà.
Dialogue: 0,0:21:00.99,0:21:02.67,Default,,0,0,0,,Nút tự hủy ở đâu rồi nhỉ?
Dialogue: 0,0:21:02.70,0:21:04.87,Default,,0,0,0,,Giá mà cái phòng câu lạc bộ này không tồn tại thì tốt biết mấy...
Dialogue: 0,0:21:04.89,0:21:07.70,Default,,0,0,0,,Hả? K-Khoan đã! Em chưa chuẩn bị tâm lý đâu!
Dialogue: 0,0:21:07.72,0:21:09.55,Default,,0,0,0,,Ôi trời, mọi chuyện đang vượt quá tầm kiểm soát rồi đấy.
Dialogue: 0,0:21:09.93,0:21:12.13,Default,,0,0,0,,Hay là chúng mình giải tán luôn cả hai câu lạc bộ đi nhé?
Dialogue: 0,0:21:12.15,0:21:13.17,Default,,0,0,0,,Nói đùa tí thôi.
Dialogue: 0,0:21:13.20,0:21:14.50,Default,,0,0,0,,Khoan, đừng! Chị không được làm thế đâu...
Dialogue: 0,0:21:15.39,0:21:16.34,Default,,0,0,0,,Haizz...
Dialogue: 0,0:21:16.58,0:21:18.06,Default,,0,0,0,,Tôi có thể đưa ra một đề xuất được không?
Dialogue: 0,0:21:20.00,0:21:22.34,Default,,0,0,0,,Đổi phòng của CLB Hóa Học cho CLB Robot sao?
Dialogue: 0,0:21:22.37,0:21:23.25,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:21:23.28,0:21:25.71,Default,,0,0,0,,Đích thân tôi sẽ đi nói chuyện với giáo viên phụ trách.
Dialogue: 0,0:21:25.74,0:21:26.82,Default,,0,0,0,,(Tiếng reo hò phấn khích)
Dialogue: 0,0:21:26.86,0:21:28.04,Default,,0,0,0,,C-Cậu chắc chắn chứ?
Dialogue: 0,0:21:28.15,0:21:31.62,Default,,0,0,0,,Xin được phê duyệt từ thầy hiệu trưởng phiền phức rắc rối lắm đấy.
Dialogue: 0,0:21:31.64,0:21:34.19,Default,,0,0,0,,Dù sao thì bạn tôi cũng có một phần lỗi trong chuyện này.
Dialogue: 0,0:21:34.44,0:21:38.50,Default,,0,0,0,,Nhưng chắc chắn cô Hiratsuka sẽ mắng tôi té tát một trận cho mà xem.
Dialogue: 0,0:21:38.59,0:21:40.67,Default,,0,0,0,,- Lát nữa tớ sẽ cùng Batsunosuke đi xin lỗi nhé...\N- Cậu đúng là đồ ngốc mà.
Dialogue: 0,0:21:40.69,0:21:42.94,Default,,0,0,0,,Hả? Ý cậu là CLB Robot á?
Dialogue: 0,0:21:43.07,0:21:45.36,Default,,0,0,0,,Ý tớ là cậu đấy, Ume.
Dialogue: 0,0:21:45.67,0:21:48.19,Default,,0,0,0,,Về chuyện đó... C-Cảm ơn cậu nhiều nhé.
Dialogue: 0,0:21:48.21,0:21:49.55,Default,,0,0,0,,Không có gì đâu.
Dialogue: 0,0:21:49.96,0:21:50.94,Default,,0,0,0,,(Ngày hôm sau)
Dialogue: 0,0:21:50.96,0:21:53.15,Default,,0,0,0,,- Trong này cũng có ổ cắm điện này.\N- Bọn mình có nên đặt con robot ở đây không nhỉ?
Dialogue: 0,0:21:53.17,0:21:54.81,Default,,0,0,0,,Có cả bàn ghế đàng hoàng nữa.
Dialogue: 0,0:21:55.25,0:21:57.61,Default,,0,0,0,,Này, trật tự chút coi nào!
Dialogue: 0,0:21:58.19,0:22:00.51,Default,,0,0,0,,Chết tiệt thật, Mizunoe... Có khi tao phải ném cái gối vào mặt mày mới được.
Dialogue: 0,0:22:00.79,0:22:02.51,Default,,0,0,0,,(Hai người họ là bạn thuở nhỏ)\NTớ thích những thứ dễ thương.
Dialogue: 0,0:22:02.53,0:22:03.49,Default,,0,0,0,,(Học sinh năm nhất cấp ba)\NChúng mang lại cảm giác bình yên dễ chịu ghê.
Dialogue: 0,0:22:03.51,0:22:04.70,Default,,0,0,0,,(Học sinh năm hai cấp ba)\NCậu không thấy nóng à?
Dialogue: 0,0:22:13.27,0:22:16.59,Default,,0,0,0,,(Hội Học Sinh Cũng Có Điểm Sơ Hở!)
Dialogue: 0,0:23:34.94,0:23:35.98,Default,,0,0,0,,(Giới thiệu tập tiếp theo)
Dialogue: 0,0:23:36.00,0:23:39.96,Default,,0,0,0,,(Hỏng bét rồi!) (Ume và Cô giáo)\N(Thế giới của Komaro)
