Dialogue: 0,0:03:47.49,0:03:48.74,Sign,,0,0,55,,{\be3\fs70.392\c&HFFFFFF&\bord3.52\3c&H3F3F3F&}Mình có phải là mình?
Dialogue: 0,0:03:49.20,0:03:51.41,Sign,,904,0,55,,{\be3\fs70.392\c&HFFFFFF&\bord3.52\3c&H3F3F3F&\fad(0,554)}Lain chính là Lain
Dialogue: 0,0:04:51.06,0:04:53.06,Default,,0,0,0,,Tôi ước gì bạn có thể đến đây...
Dialogue: 0,0:05:31.01,0:05:34.77,Trippy Shit,,0,0,0,,{\fad(1000,1000)\blur7.039}Mình không cần phải ở lại đây nữa.
Dialogue: 0,0:06:13.14,0:06:18.19,Default,,0,0,0,,Thứ lỗi cho tôi nhé. Nói chuyện suốt thế này làm tôi kiệt sức rồi.
Dialogue: 0,0:06:30.95,0:06:33.03,Default,,0,0,0,,Em chưa từng nhìn thấy thứ này bao giờ!
Dialogue: 0,0:06:35.83,0:06:41.29,Default,,0,0,0,,Iwakura Lain. Cháu và Lain trong The Wired liệu có phải cùng là một người?
Dialogue: 0,0:06:41.29,0:06:46.30,Default,,0,0,0,,Tôi từng thấy cậu rồi. Ở bên trong The Wired.
Dialogue: 0,0:07:49.78,0:07:52.41,Sign,,0,0,55,,{\an8\fs70.392\c&HFFFFFF&\bord3.52\3c&H3F3F3F&}Kẻ Nhìn Lén
Dialogue: 0,0:08:17.93,0:08:20.06,Trippy Shit,,0,0,0,,{\fad(1000,1000)\blur7.039}Đến đây
Dialogue: 0,0:08:43.12,0:08:45.00,Default,,0,0,0,,Tội nghiệp Lain...
Dialogue: 0,0:09:03.23,0:09:07.23,Default,,0,0,0,,Này, tôi là Lain, đúng không?
Dialogue: 0,0:09:07.23,0:09:08.48,Default,,0,0,0,,Không phải!
Dialogue: 0,0:09:08.48,0:09:09.98,Default,,0,0,0,,Không, mày đâu phải nó!
Dialogue: 0,0:09:18.78,0:09:23.75,Default,,0,0,0,,Đúng thế, Lain à. Ngươi không hề cần thiết ở thế giới thực này.
Dialogue: 0,0:09:23.75,0:09:26.92,Default,,0,0,0,,Tôi đang tự sát đấy!
Dialogue: 0,0:09:30.75,0:09:34.10,Default,,0,0,0,,Tại sao? Tại sao cơ thể cô lại ấm áp thế này?
Dialogue: 0,0:09:34.10,0:09:38.26,Default,,0,0,0,,Tại sao tôi lại có thể cảm nhận được hơi ấm tỏa ra từ da thịt cô chứ?
Dialogue: 0,0:10:16.99,0:10:20.22,Default,,0,0,0,,Phải. Ta chính là Chúa.
Dialogue: 0,0:10:21.27,0:10:22.64,Default,,0,0,0,,Sao cậu lại có thể làm thế chứ?
Dialogue: 0,0:10:38.32,0:10:43.08,Default,,0,0,0,,Lain à, nếu cậu hòa đồng hơn một chút thì cuộc sống sẽ vui vẻ hơn nhiều đấy.
Dialogue: 0,0:10:56.88,0:10:59.63,Default,,0,0,0,,Con bé thay đổi thật rồi đấy.
Dialogue: 0,0:11:04.93,0:11:06.27,Default,,0,0,0,,Cậu có sao không?
Dialogue: 0,0:11:07.85,0:11:11.10,Default,,0,0,0,,Dạo gần đây... cậu lại bắt đầu thu mình về như trước kia rồi đó, Lain.
Dialogue: 0,0:11:12.15,0:11:15.15,Default,,0,0,0,,Cậu ổn chứ? Lain, tớ...
Dialogue: 0,0:11:18.28,0:11:22.74,Default,,0,0,0,,Lain, tớ xin lỗi! Tất cả là lỗi tại bọn tớ! Cậu có sao không, Lain?
Dialogue: 0,0:11:32.78,0:11:33.84,Default,,0,0,0,,Nghe cậu nói vậy tớ mừng lắm.
Dialogue: 0,0:12:28.04,0:12:29.72,Default,,0,0,0,,Cháu mệt rồi à?
Dialogue: 0,0:12:31.92,0:12:33.48,Default,,0,0,0,,Vâng ạ.
Dialogue: 0,0:12:33.87,0:12:36.26,Default,,0,0,0,,Tiểu thư quả thật phi thường...
Dialogue: 0,0:12:36.26,0:12:43.80,Default,,0,0,0,,Hóa ra tiểu thư đã nạp cả một trình giả lập cỗ máy Navi đó vào chính bộ não của mình.
Dialogue: 0,0:12:43.80,0:12:46.92,Default,,0,0,0,,Rất nguy hiểm nếu tiểu thư tiếp nhận một lượng thông tin khổng lồ cùng một lúc như vậy.
Dialogue: 0,0:12:46.92,0:12:50.49,Default,,0,0,0,,Với dung lượng hiện tại của tiểu thư, bộ nhớ sẽ bị tràn mất.
Dialogue: 0,0:12:55.43,0:12:58.54,Default,,0,0,0,,Tôi là một cỗ máy sao?
Dialogue: 0,0:13:02.12,0:13:06.43,Default,,0,0,0,,Đừng nói về tôi như thể tôi là một cỗ máy vô tri.
Dialogue: 0,0:13:07.54,0:13:09.53,Default,,0,0,0,,Tôi không có ý đó.
Dialogue: 0,0:13:11.10,0:13:14.69,Default,,0,0,0,,Vấn đề này về cơ bản thuộc về mặt phần mềm.
Dialogue: 0,0:13:15.73,0:13:19.69,Default,,0,0,0,,Lain à, tiểu thư chính là phần mềm.
Dialogue: 0,0:13:20.45,0:13:22.99,Default,,0,0,0,,Tiểu thư không phải là phần cứng.
Dialogue: 0,0:13:23.78,0:13:25.06,Default,,0,0,0,,Phần mềm sao?
Dialogue: 0,0:13:25.06,0:13:29.70,Default,,0,0,0,,Phải. Một chương trình thực thi sở hữu một cơ thể xác thịt.
Dialogue: 0,0:13:58.64,0:13:59.65,Default,,0,0,0,,Im đi...
Dialogue: 0,0:14:01.81,0:14:03.05,Default,,0,0,0,,Im miệng đi!
Dialogue: 0,0:14:33.89,0:14:35.22,Default,,0,0,0,,Chisa!
Dialogue: 0,0:14:40.33,0:14:44.94,Default,,0,0,0,,Chisa à, tụi mình từng cùng nhau đi bộ về nhà một lần, đúng không?
Dialogue: 0,0:14:48.07,0:14:53.62,Default,,0,0,0,,Mình hiểu rồi. Cuối cùng mình cũng đã hiểu những gì cậu từng nói với mình.
Dialogue: 0,0:14:56.15,0:14:56.90,Default,,0,0,0,,Lain...
Dialogue: 0,0:15:03.18,0:15:06.16,Default,,0,0,0,,Chết đi dễ dàng lắm, Lain à.
Dialogue: 0,0:15:07.47,0:15:08.65,Default,,0,0,0,,Đúng không?
Dialogue: 0,0:15:31.99,0:15:36.37,Default,,0,0,0,,Chết đi chẳng có gì là dễ dàng cả.
Dialogue: 0,0:15:38.81,0:15:40.58,Default,,0,0,0,,Dễ ợt mà!
Dialogue: 0,0:15:41.35,0:15:45.34,Default,,0,0,0,,Lain à, cậu đã có sẵn công cụ để thực hiện điều đó trong tay rồi mà.
Dialogue: 0,0:15:46.04,0:15:47.30,Default,,0,0,0,,Cậu nói...
Dialogue: 0,0:15:55.30,0:15:57.80,Default,,0,0,0,,Chốt an toàn đã được mở rồi.
Dialogue: 0,0:15:57.80,0:16:02.53,Default,,0,0,0,,Cò súng hơi nặng đấy, nên hãy cầm chắc bằng cả hai tay rồi dùng ngón cái bóp cò nhé.
Dialogue: 0,0:16:02.53,0:16:04.35,Default,,0,0,0,,Sức con gái thì không bóp nổi đâu.
Dialogue: 0,0:16:08.42,0:16:11.36,Default,,0,0,0,,Sao thế, cậu vẫn còn luyến tiếc muốn ở lại thế giới thực này à?
Dialogue: 0,0:16:11.75,0:16:15.37,Default,,0,0,0,,Này, thế là không công bằng đâu nhé. Chính cậu đã gọi tớ đến đây mà, nhớ không?
Dialogue: 0,0:16:15.93,0:16:18.15,Default,,0,0,0,,Mình... Mình chưa từng...
Dialogue: 0,0:16:18.15,0:16:20.57,Default,,0,0,0,,Thể xác là thứ hoàn toàn vô nghĩa.
Dialogue: 0,0:16:20.57,0:16:21.72,Default,,0,0,0,,Cậu sai rồi.
Dialogue: 0,0:16:22.74,0:16:24.37,Default,,0,0,0,,Lain.
Dialogue: 0,0:16:31.28,0:16:33.53,Default,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:16:40.55,0:16:45.48,Default,,0,0,0,,Tớ đã nghĩ có lẽ sau giờ học tụi mình có thể gặp nhau để tớ giới thiệu cậu với người ta.
Dialogue: 0,0:16:46.30,0:16:49.62,Default,,0,0,0,,Anh chàng này trông dễ thương lắm đấy!
Dialogue: 0,0:16:49.62,0:16:52.49,Default,,0,0,0,,Còn về những tin đồn giữa cậu và người thầy giáo đó...
Dialogue: 0,0:16:53.22,0:16:58.30,Default,,0,0,0,,Tớ nghĩ chỉ cần cậu có bạn trai, mọi người sẽ biết những lời đồn đó chỉ là bịa đặt.
Dialogue: 0,0:16:58.30,0:17:00.68,Default,,0,0,0,,Hẹn gặp lại cậu vào ngày mai nhé. Lúc đó tụi mình sẽ nói chuyện tiếp.
Dialogue: 0,0:17:00.68,0:17:01.66,Default,,0,0,0,,Tạm biệt cậu nha!
Dialogue: 0,0:17:11.05,0:17:12.67,Default,,0,0,0,,Đó không phải là bịa đặt đâu.
Dialogue: 0,0:17:20.51,0:17:22.42,Default,,0,0,0,,A-Ai ở đó thế?
Dialogue: 0,0:17:29.98,0:17:30.82,Default,,0,0,0,,Ai ở đó?!
Dialogue: 0,0:17:43.04,0:17:44.00,Default,,0,0,0,,Lain?
Dialogue: 0,0:17:47.76,0:17:50.01,Default,,0,0,0,,C-Cái gì thế này?
Dialogue: 0,0:17:50.01,0:17:53.72,Default,,0,0,0,,Chuyện gì đã xảy ra với cậu thế? Cậu...
Dialogue: 0,0:17:57.47,0:18:01.18,Default,,0,0,0,,Không phải là tớ làm đâu.
Dialogue: 0,0:18:03.67,0:18:12.98,Default,,0,0,0,,Tớ chưa từng lén nhìn trộm bí mật của cậu, Arisu, và tớ cũng không hề phát tán những điều thầm kín đó lên The Wired.
Dialogue: 0,0:18:14.20,0:18:18.99,Default,,0,0,0,,Chính là cậu làm, Lain! Tớ đã tận mắt nhìn thấy cậu!
Dialogue: 0,0:18:19.44,0:18:21.49,Default,,0,0,0,,Đó không phải là tớ.
Dialogue: 0,0:18:21.49,0:18:27.00,Default,,0,0,0,,Có vẻ như tớ không phải là Lain duy nhất. Một tôi khác đã làm điều đó.
Dialogue: 0,0:18:27.85,0:18:29.67,Default,,0,0,0,,Cậu đang nói nhảm nhí gì thế hả?
Dialogue: 0,0:18:30.24,0:18:33.71,Default,,0,0,0,,Có khi cậu cũng không phải là Arisu duy nhất đâu.
Dialogue: 0,0:18:36.84,0:18:42.04,Default,,0,0,0,,Nhưng dẫu tớ có nhắc đi nhắc lại rằng mình không làm, cậu vẫn sẽ đinh ninh là do tớ gây ra.
Dialogue: 0,0:18:42.98,0:18:45.89,Default,,0,0,0,,Vì thế, tớ sẽ biến mọi chuyện thành như thể nó chưa từng bao giờ xảy ra.
Dialogue: 0,0:18:46.77,0:18:50.19,Default,,0,0,0,,Tớ đã nỗ lực làm việc không ngừng để có thể làm được điều đó.
Dialogue: 0,0:18:52.85,0:18:54.29,Default,,0,0,0,,Cậu nói vậy là có ý gì?
Dialogue: 0,0:18:54.29,0:18:56.63,Default,,0,0,0,,Tớ không còn cần đến bất kỳ thiết bị máy móc nào nữa rồi.
Dialogue: 0,0:18:56.63,0:19:01.82,Default,,0,0,0,,Có vẻ như tớ đã phá hủy hoàn toàn ranh giới giữa The Wired và thế giới thực.
Dialogue: 0,0:19:03.12,0:19:06.71,Default,,0,0,0,,Bây giờ tớ có thể đi đến bất cứ nơi đâu tớ muốn.
Dialogue: 0,0:19:06.71,0:19:09.21,Default,,0,0,0,,Nên tớ đã đến nơi này.
Dialogue: 0,0:19:09.83,0:19:13.71,Default,,0,0,0,,Tớ nhất định có thể đảo ngược những chuyện đã từng xảy ra!
Dialogue: 0,0:19:14.84,0:19:16.17,Default,,0,0,0,,Lain...
Dialogue: 0,0:19:30.88,0:19:31.48,Default,,0,0,0,,Tớ...
Dialogue: 0,0:19:34.13,0:19:35.49,Default,,0,0,0,,Tớ sợ lắm...
Dialogue: 0,0:19:36.20,0:19:37.57,Default,,0,0,0,,Tớ sợ lắm!
Dialogue: 0,0:19:54.58,0:19:55.79,Default,,0,0,0,,Arisu!
Dialogue: 0,0:19:55.79,0:19:57.63,Default,,0,0,0,,Arisu! Chào buổi sáng!
Dialogue: 0,0:20:02.05,0:20:02.76,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:20:02.76,0:20:05.14,Default,,0,0,0,,Sao thế Arisu? Trông cậu ủ rũ buồn bã vậy?
Dialogue: 0,0:20:05.14,0:20:07.85,Default,,0,0,0,,Ủa, lại đến 'ngày đèn đỏ' của tháng rồi hả?
Dialogue: 0,0:20:08.16,0:20:10.10,Default,,0,0,0,,Này, cậu có biết ý tứ tế nhị là gì không thế?
Dialogue: 0,0:20:10.10,0:20:11.77,Default,,0,0,0,,Thôi mà, tớ chỉ đùa chút...
Dialogue: 0,0:20:12.88,0:20:17.77,Default,,0,0,0,,Juri à, hôm nay tớ nghĩ mình không thể làm chuyện đó được đâu.
Dialogue: 0,0:20:17.77,0:20:20.53,Default,,0,0,0,,Hả? Chuyện gì cơ chứ?
Dialogue: 0,0:20:21.02,0:20:24.16,Default,,0,0,0,,Gì cơ? Hôm qua cậu không gửi tin nhắn CU-mail cho tớ sao?
Dialogue: 0,0:20:24.85,0:20:27.03,Default,,0,0,0,,Đâu có, hôm qua tớ có gửi gì cho cậu đâu.
Dialogue: 0,0:20:27.52,0:20:30.04,Default,,0,0,0,,Hôm nay trông cậu lạ lùng ghê đó, Arisu.
Dialogue: 0,0:20:35.13,0:20:36.82,Default,,0,0,0,,Arisu!
Dialogue: 0,0:20:38.46,0:20:41.47,Default,,0,0,0,,Ôi, thầy giáo kia... Thầy ấy trông bảnh bao quyến rũ thật đấy!
Dialogue: 0,0:20:41.47,0:20:46.61,Default,,0,0,0,,Ừ! Nhưng nghe đồn là thầy ấy đang hẹn hò với một học sinh lớp 8 đấy!
Dialogue: 0,0:20:46.61,0:20:49.53,Default,,0,0,0,,Cái gì, cậu nghiêm túc đấy chứ? Ghê chết đi được!
Dialogue: 0,0:20:50.66,0:20:52.89,Default,,0,0,0,,Ừm... Nghe này, tớ...
Dialogue: 0,0:20:54.12,0:20:55.15,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:20:55.90,0:20:59.86,Default,,0,0,0,,V-Về chuyện thầy giáo đó... và tớ...
Dialogue: 0,0:21:01.92,0:21:04.26,Default,,0,0,0,,Bộ giữa cậu và thầy ấy có mối quan hệ gì sao?
Dialogue: 0,0:21:04.26,0:21:06.87,Default,,0,0,0,,Cậu phải lòng thầy ấy hay sao thế?
Dialogue: 0,0:21:06.87,0:21:09.05,Default,,0,0,0,,Tiếc quá nha, cậu đến trễ một bước rồi!
Dialogue: 0,0:21:09.05,0:21:11.72,Default,,0,0,0,,Đúng vậy! Thầy ấy có bạn gái rồi mà.
Dialogue: 0,0:21:11.72,0:21:13.46,Default,,0,0,0,,Thật chẳng giống cậu chút nào cả, Arisu.
Dialogue: 0,0:21:13.46,0:21:16.88,Default,,0,0,0,,Ừ, hôm nay nhỏ này cư xử kỳ lạ thật đấy.
Dialogue: 0,0:21:46.81,0:21:49.30,Default,,0,0,0,,Lain! Chào buổi sáng!
Dialogue: 0,0:21:49.30,0:21:50.70,Default,,0,0,0,,Nhanh chân lên nào!
Dialogue: 0,0:21:50.70,0:21:53.47,Default,,0,0,0,,Lại đây đi, Lain!
Dialogue: 0,0:21:53.47,0:21:54.41,Default,,0,0,0,,Lain!
Dialogue: 0,0:22:01.38,0:22:04.88,Default,,0,0,0,,Lain, cậu...
Dialogue: 0,0:22:10.01,0:22:13.44,Default,,0,0,0,,Lain, cậu vừa mỉm cười...

