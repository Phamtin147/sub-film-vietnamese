Dialogue: 0,0:00:03.08,0:00:06.58,Default,,0,0,0,,{\an8}Dựa trên nguyên tác của Minamino Umikaze
Dialogue: 0,0:00:07.96,0:00:14.18,Default,,0,0,0,,NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:00:14.34,0:00:18.68,Default,,0,0,0,,Thiết kế nhân vật gốc:\NCanata Katana, Jishaku
Dialogue: 0,0:00:20.56,0:00:24.64,Default,,0,0,0,,Biên kịch: Gigaemon Ichikawa
Dialogue: 0,0:00:26.15,0:00:29.36,Default,,0,0,0,,{\an3}Thiết kế nhân vật:\NYuki Itou, Kana Tosaoka
Dialogue: 0,0:00:30.98,0:00:34.70,Default,,0,0,0,,{\an1}Thiết kế màu sắc:\NRyota Katsuta, Maki Yamamoto
Dialogue: 0,0:00:40.41,0:00:43.41,Default,,0,0,0,,{\an3}Đạo diễn mỹ thuật: Hiroshi Gouroku
Dialogue: 0,0:00:45.42,0:00:48.67,Default,,0,0,0,,Biên tập: Masayuki Kurosawa\NBối cảnh: Makaria
Dialogue: 0,0:00:50.67,0:00:55.51,Default,,0,0,0,,{\an8}Bài hát mở đầu: "Deux Livres"\NTrình bày: Nia Liston & Sharo White
Dialogue: 0,0:00:57.72,0:01:00.93,Default,,0,0,0,,Âm nhạc: Naoki Endou\NĐạo diễn âm thanh: Hiromi Kikuta
Dialogue: 0,0:01:02.85,0:01:06.77,Default,,0,0,0,,Studio hoạt hình:\NKonami Animation
Dialogue: 0,0:01:10.52,0:01:14.36,Default,,0,0,0,,Trợ lý đạo diễn: Haruta Segi
Dialogue: 0,0:01:18.32,0:01:22.79,Default,,0,0,0,,Đạo diễn: Motoki Nakanishi
Dialogue: 0,0:01:24.20,0:01:26.46,Default,,0,0,0,,Ủy ban sản xuất:\NThe Merciless Maiden
Dialogue: 0,0:01:32.09,0:01:36.84,Default,,0,0,0,,TẬP 3: SAU KHI TẤM MÀN KHÉP LẠI
Dialogue: 0,0:02:04.04,0:02:05.62,Default,,0,0,0,,Ông chủ gọi tôi có việc gì à?
Dialogue: 0,0:02:09.29,0:02:11.88,Default,,0,0,0,,À, đến rồi đấy à, Anzel! Ngồi xuống đi.
Dialogue: 0,0:02:12.34,0:02:15.13,Default,,0,0,0,,Không cần đâu, tôi chỉ là vệ sĩ thôi.
Dialogue: 0,0:02:15.30,0:02:18.13,Default,,0,0,0,,Lúc nào cũng cứng nhắc thế!\NTùy cậu vậy.
Dialogue: 0,0:02:19.22,0:02:20.39,Default,,0,0,0,,Cậu có nhận ra cái băng đầu này không?
Dialogue: 0,0:02:21.14,0:02:23.18,Default,,0,0,0,,Đó là đồ của đám thuộc hạ của ông.
Dialogue: 0,0:02:23.51,0:02:26.47,Default,,0,0,0,,Chúng nó vừa bị một con ranh\Nđánh cho tơi bời hoa lá.
Dialogue: 0,0:02:27.06,0:02:27.77,Default,,0,0,0,,Một con bé sao?
Dialogue: 0,0:02:28.14,0:02:31.94,Default,,0,0,0,,Lũ vô dụng đó làm bẽ mặt băng đảng của ta.\NDiệt sạch chúng đi.
Dialogue: 0,0:02:32.44,0:02:36.40,Default,,0,0,0,,Dọn dẹp rác rưởi thay ta\Ncũng là một phần nhiệm vụ của cậu mà, đúng chứ?
Dialogue: 0,0:02:46.12,0:02:47.16,Default,,0,0,0,,Rõ rồi.
Dialogue: 0,0:02:49.46,0:02:53.29,Default,,0,0,0,,Với lại, cả con ranh kia nữa!\NĐi dạy cho nó một bài học nhớ đời đi.
Dialogue: 0,0:03:08.18,0:03:13.02,Default,,0,0,0,,{\i1}Suốt thời gian tiểu thư Nia bận diễn kịch,\Nmình chẳng được ôm ấp người miếng nào,{\i0}
Dialogue: 0,0:03:13.27,0:03:15.82,Default,,0,0,0,,{\i1}nhưng giờ vở kịch đã hạ màn rồi...{\i0}
Dialogue: 0,0:03:16.19,0:03:19.32,Default,,0,0,0,,Tiểu thư Nia ơi!\NĐến giờ ôm ấp rồi nè!
Dialogue: 0,0:03:24.74,0:03:27.74,Default,,0,0,0,,Tiểu thư ơi, kịch đã kết thúc rồi!
Dialogue: 0,0:03:27.91,0:03:30.00,Default,,0,0,0,,Ủa, sao cái con đà điểu này lại ở đây?
Dialogue: 0,0:03:30.16,0:03:33.83,Default,,0,0,0,,Em cũng chịu đấy.\NCậu ta cứ bám theo em suốt từ rạp hát về.
Dialogue: 0,0:03:35.88,0:03:39.59,Default,,0,0,0,,Thôi, tối nay em cứ đi nghỉ ngơi đi nhé!\NNgủ ngon nha, Rinokis!
Dialogue: 0,0:03:41.09,0:03:42.09,Default,,0,0,0,,Ơ kìa! Em không...
Dialogue: 0,0:03:43.84,0:03:46.39,Default,,0,0,0,,Tiểu thư ơi, đừng mà!
Dialogue: 0,0:03:48.43,0:03:49.97,Default,,0,0,0,,Cô hầu gái nhà cậu có sao không đấy?
Dialogue: 0,0:03:50.60,0:03:52.23,Default,,0,0,0,,Lúc nào em ấy chả thế.
Dialogue: 0,0:03:56.77,0:03:57.52,Default,,0,0,0,,Cầm lấy này!
Dialogue: 0,0:03:57.77,0:03:58.65,Default,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:04:04.03,0:04:08.49,Default,,0,0,0,,Thế rốt cuộc cậu sang đây làm gì vậy?\NChắc hẳn phải có lý do chính đáng chứ nhỉ.
Dialogue: 0,0:04:10.00,0:04:12.50,Default,,0,0,0,,Ừ, tớ có chuyện muốn hỏi cậu.
Dialogue: 0,0:04:13.00,0:04:15.04,Default,,0,0,0,,Cậu muốn biết bí quyết sức mạnh của tớ hả?
Dialogue: 0,0:04:15.21,0:04:17.88,Default,,0,0,0,,Là thịt đấy.\NTớ ăn cả đống thịt luôn!
Dialogue: 0,0:04:18.63,0:04:23.13,Default,,0,0,0,,Không phải! Tớ muốn hỏi về những lời\Ncậu đã nói với đám giang hồ đó cơ.
Dialogue: 0,0:04:24.76,0:04:27.60,Default,,0,0,0,,{\i1}Hai tuần nữa ta sẽ quay lại tìm các ngươi,{\i0}
Dialogue: 0,0:04:28.22,0:04:29.68,Default,,0,0,0,,{\i1}nên liệu mà chuẩn bị sẵn sàng đi.{\i0}
Dialogue: 0,0:04:30.68,0:04:35.15,Default,,0,0,0,,Ngày mai là tròn đúng hai tuần rồi đấy.\NRốt cuộc cậu định làm gì thế?
Dialogue: 0,0:04:35.60,0:04:37.90,Default,,0,0,0,,Gì chứ, tớ chỉ nói đùa cho vui thôi mà!
Dialogue: 0,0:04:38.44,0:04:40.40,Default,,0,0,0,,Cậu nói dối. Khai thật đi, cậu định đến đó đúng không?
Dialogue: 0,0:04:40.94,0:04:42.07,Default,,0,0,0,,Làm gì có chuyện đấy chứ.
Dialogue: 0,0:04:42.32,0:04:44.65,Default,,0,0,0,,Thế thì tớ đi mách cô hầu gái của cậu đây.
Dialogue: 0,0:04:45.11,0:04:48.03,Default,,0,0,0,,Được rồi, tớ nhận là được chứ gì.\NNhưng liệu hồn mà cản đường tớ đấy!
Dialogue: 0,0:04:48.74,0:04:50.91,Default,,0,0,0,,Tại sao cậu lại phải mạo hiểm đến mức đó?
Dialogue: 0,0:04:51.37,0:04:54.79,Default,,0,0,0,,Tự đâm đầu vào chỗ nguy hiểm như thế\Nchẳng khôn ngoan chút nào đâu.
Dialogue: 0,0:04:55.21,0:04:58.00,Default,,0,0,0,,Đã là chiến binh thì\Nlàm gì có ai khôn ngoan cơ chứ.
Dialogue: 0,0:04:58.29,0:05:01.42,Default,,0,0,0,,Hành động tính toán cẩn trọng\Nđâu phải phong cách của bọn này.
Dialogue: 0,0:05:01.96,0:05:04.42,Default,,0,0,0,,Nghĩ kỹ thì... tớ cũng hiểu ý cậu đấy.
Dialogue: 0,0:05:04.92,0:05:07.39,Default,,0,0,0,,Nếu nói về chuyện chẳng khôn ngoan,
Dialogue: 0,0:05:07.55,0:05:10.43,Default,,0,0,0,,thì việc chọn làm diễn viên\Ncũng đâu kém phần liều lĩnh.
Dialogue: 0,0:05:11.14,0:05:13.22,Default,,0,0,0,,{\i1}Lựa chọn của mình còn tồi tệ hơn nhiều.{\i0}
Dialogue: 0,0:05:13.43,0:05:18.19,Default,,0,0,0,,{\i1}Dù đã được sống lại một đời nữa,\Nđiều duy nhất mình khao khát vẫn là chết dưới mũi gươm.{\i0}
Dialogue: 0,0:05:18.73,0:05:21.78,Default,,0,0,0,,{\i1}Chắc chắn là do chấp niệm\Ntừ tiền kiếp rồi.{\i0}
Dialogue: 0,0:05:22.57,0:05:23.69,Default,,0,0,0,,Tớ nhất định sẽ đến gặp chúng.
Dialogue: 0,0:05:24.57,0:05:25.99,Default,,0,0,0,,Bởi vì đó là việc tớ phải làm.
Dialogue: 0,0:05:30.70,0:05:32.08,Default,,0,0,0,,Vậy thì mang tớ theo với!
Dialogue: 0,0:05:33.50,0:05:34.70,Default,,0,0,0,,Cậu cũng muốn đi á?
Dialogue: 0,0:05:35.21,0:05:37.00,Default,,0,0,0,,Cậu là người mạnh nhất mà, đúng không?
Dialogue: 0,0:05:37.75,0:05:39.71,Default,,0,0,0,,Thế thì tớ đâu có gì phải sợ!
Dialogue: 0,0:05:41.29,0:05:45.76,Default,,0,0,0,,Cậu có thể đứng nhìn từ xa nếu muốn,\Nnhưng tớ sẽ không để cậu lại gần đâu.
Dialogue: 0,0:05:45.97,0:05:47.97,Default,,0,0,0,,Và miễn bàn cãi thêm.
Dialogue: 0,0:05:55.68,0:05:57.64,Default,,0,0,0,,Cảm ơn vì tất cả nhé, Nia!
Dialogue: 0,0:05:58.19,0:05:59.94,Default,,0,0,0,,Vở kịch đã thành công vang dội,
Dialogue: 0,0:06:00.27,0:06:01.98,Default,,0,0,0,,... và giúp tên tuổi của Sharro được mọi người biết đến.
Dialogue: 0,0:06:02.52,0:06:03.40,Default,,0,0,0,,Thực sự cảm ơn cháu rất nhiều.
Dialogue: 0,0:06:04.53,0:06:05.78,Default,,0,0,0,,Cháu cũng cảm ơn mọi người ạ.
Dialogue: 0,0:06:08.57,0:06:09.49,Default,,0,0,0,,Mà nhân tiện,
Dialogue: 0,0:06:10.12,0:06:11.45,Default,,0,0,0,,sao cô lại ở đây thế hả?
Dialogue: 0,0:06:11.62,0:06:12.74,Default,,0,0,0,,Chẳng có gì đặc biệt cả!
Dialogue: 0,0:06:16.20,0:06:19.37,Default,,0,0,0,,Đến đây là kết thúc sự hợp tác của chúng ta rồi.
Dialogue: 0,0:06:19.75,0:06:23.67,Default,,0,0,0,,Mong rằng một ngày nào đó\Nsẽ lại có dịp được làm việc cùng cháu!
Dialogue: 0,0:06:25.13,0:06:28.13,Default,,0,0,0,,Tạm biệt nhé, Nia!\NCháu nhớ giữ gìn sức khỏe đấy!
Dialogue: 0,0:06:28.84,0:06:31.05,Default,,0,0,0,,{\i1}Tối nay gặp lại nhé...{\i0}
Dialogue: 0,0:06:31.72,0:06:35.64,Default,,0,0,0,,Thật là nhẹ cả người khi biết từ giờ\Nsẽ không phải chạm mặt con ả đanh đá đó nữa!
Dialogue: 0,0:06:36.27,0:06:38.69,Default,,0,0,0,,Chúng ta mau quay về với gia đình người thôi nào!
Dialogue: 0,0:06:38.85,0:06:39.77,Default,,0,0,0,,Nhanh lên người ơi!
Dialogue: 0,0:06:41.40,0:06:42.06,Default,,0,0,0,,Tiểu thư Nia?
Dialogue: 0,0:06:42.81,0:06:46.15,Default,,0,0,0,,Xin lỗi nha, ta để quên đồ mất rồi!\NEm đợi ở đây một lát.
Dialogue: 0,0:06:46.57,0:06:47.78,Default,,0,0,0,,Người để quên cái gì thế ạ?
Dialogue: 0,0:06:48.95,0:06:50.16,Default,,0,0,0,,Ví tiền... của ta chăng?
Dialogue: 0,0:06:50.66,0:06:53.66,Default,,0,0,0,,Rõ ràng là lúc nào\Ncũng do em cầm mà.
Dialogue: 0,0:06:54.37,0:06:56.41,Default,,0,0,0,,Không, ta nhớ ra rồi, là khăn tay!
Dialogue: 0,0:06:56.79,0:06:58.41,Default,,0,0,0,,Cái đó em cũng đang giữ đây ạ.
Dialogue: 0,0:07:01.54,0:07:04.04,Default,,0,0,0,,Người đang tính giở trò gì đúng không?
Dialogue: 0,0:07:06.34,0:07:08.13,Default,,0,0,0,,Ta... ta muốn đi vệ sinh gấp, được chưa!
Dialogue: 0,0:07:08.76,0:07:11.47,Default,,0,0,0,,À ra vậy! Để em đi cùng người.
Dialogue: 0,0:07:11.63,0:07:15.06,Default,,0,0,0,,Không được! Đến đi vệ sinh\Ncũng để ta đi một mình xem nào!
Dialogue: 0,0:07:21.23,0:07:26.07,Default,,0,0,0,,{\i1}Phải nhanh chóng tìm ra chúng trước khi\NRinokis kịp nảy sinh nghi ngờ mới được.{\i0}
Dialogue: 0,0:07:33.62,0:07:34.91,Default,,0,0,0,,Cho ta hỏi chút chuyện được không?
Dialogue: 0,0:07:36.20,0:07:37.83,Default,,0,0,0,,Ta muốn hỏi về thứ này.
Dialogue: 0,0:07:38.50,0:07:40.08,Default,,0,0,0,,Ta đang rất vội,
Dialogue: 0,0:07:40.46,0:07:42.79,Default,,0,0,0,,nên rất có thể sẽ phải dùng đến vũ lực đấy.
Dialogue: 0,0:07:50.17,0:07:53.72,Default,,0,0,0,,Khai ra những gì ta muốn biết,\Nhoặc là ta bẻ gãy từng khúc xương của ngươi.
Dialogue: 0,0:08:04.19,0:08:07.57,Default,,0,0,0,,Nhanh lên nào. Ta không muốn\Nđể gia đình mình phải chờ lâu đâu.
Dialogue: 0,0:08:07.90,0:08:09.03,Default,,0,0,0,,D-Dạ vâng!
Dialogue: 0,0:08:15.28,0:08:17.87,Default,,0,0,0,,{\an8}KÊNH ĐÀO TRUNG TÂM ALTOIRE
Dialogue: 0,0:08:18.03,0:08:20.37,Default,,0,0,0,,{\an8}ĐÀI TRUYỀN HÌNH HOÀNG ĐÔ
Dialogue: 0,0:08:20.54,0:08:22.87,Default,,0,0,0,,{\an8}XƯỞNG ĐÓNG KHÍ CẦU TRUNG TÂM
Dialogue: 0,0:08:23.04,0:08:25.38,Default,,0,0,0,,{\an8}NHÀ VÒM CHÍNH CỦA XƯỞNG
Dialogue: 0,0:08:28.04,0:08:31.38,Default,,0,0,0,,{\an8}NHÀ HÀNG "HƯƠNG HOA HUỆ ĐEN"
Dialogue: 0,0:08:31.76,0:08:34.13,Default,,0,0,0,,Con diễn kịch xuất sắc lắm, Nia à!
Dialogue: 0,0:08:34.63,0:08:36.80,Default,,0,0,0,,Ngay cả Điện hạ Hildetaura cũng phải trầm trồ khen ngợi đấy!
Dialogue: 0,0:08:37.30,0:08:38.89,Default,,0,0,0,,Điện hạ Hildetaura sao ạ?
Dialogue: 0,0:08:39.22,0:08:41.98,Default,,0,0,0,,Là Tam vương nữ\Ncủa Vương quốc Altoire đấy!
Dialogue: 0,0:08:42.39,0:08:45.02,Default,,0,0,0,,Nghe nói người rất mong muốn được gặp con đấy!
Dialogue: 0,0:08:45.40,0:08:49.02,Default,,0,0,0,,Với thành công vang dội này,\Nchắc chắn con sẽ nhận được thêm nhiều lời mời đóng phim nữa!
Dialogue: 0,0:08:49.19,0:08:50.78,Default,,0,0,0,,Cứ từ từ từng bước một đã.
Dialogue: 0,0:08:52.49,0:08:57.49,Default,,0,0,0,,Con thực sự thấy nhẹ nhõm\Nkhi đã không làm hổ danh gia tộc.
Dialogue: 0,0:08:57.95,0:09:00.16,Default,,0,0,0,,Và con cảm ơn mọi người rất nhiều vì đã đến cổ vũ con.
Dialogue: 0,0:09:01.91,0:09:02.41,Default,,0,0,0,,Được rồi,
Dialogue: 0,0:09:02.83,0:09:04.16,Default,,0,0,0,,chúng ta phải ăn mừng chuyện này thôi!
Dialogue: 0,0:09:04.41,0:09:05.79,Default,,0,0,0,,Con cứ thoải mái gọi những món mình thích đi!
Dialogue: 0,0:09:13.05,0:09:14.92,Default,,0,0,0,,Chúc tiểu thư ngủ ngon.
Dialogue: 0,0:09:15.47,0:09:17.22,Default,,0,0,0,,Ngủ ngon nhé, Rinokis.
Dialogue: 0,0:09:30.65,0:09:33.53,Default,,0,0,0,,Họ bảo sào huyệt của chúng\Nnằm ở quanh khu vực này.
Dialogue: 0,0:09:33.69,0:09:35.20,Default,,0,0,0,,Hình như là cứ đi thẳng phía trước.
Dialogue: 0,0:09:35.86,0:09:38.20,Default,,0,0,0,,Khu này mang tiếng là phức tạp và tai tiếng lắm đấy.
Dialogue: 0,0:09:46.12,0:09:46.96,Default,,0,0,0,,Đến nơi rồi!
Dialogue: 0,0:09:47.58,0:09:49.42,Default,,0,0,0,,Cậu không được đi xa hơn nữa đâu, Sharro.
Dialogue: 0,0:09:49.96,0:09:51.54,Default,,0,0,0,,Mau nấp vào đằng kia đi.
Dialogue: 0,0:09:52.67,0:09:54.71,Default,,0,0,0,,Được rồi. Cậu cẩn thận nhé, Nia.
Dialogue: 0,0:10:26.87,0:10:28.75,Default,,0,0,0,,Mày thực sự dám đến đây cơ à...
Dialogue: 0,0:10:27.96,0:10:29.83,Default,,0,0,0,,{\an8}NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:10:30.00,0:10:32.59,Default,,0,0,0,,{\an1}NIA LISTON:\NTHE MERCILESS MAIDEN
Dialogue: 0,0:10:41.43,0:10:42.10,Default,,0,0,0,,Con nhỏ hầu gái?
Dialogue: 0,0:10:43.10,0:10:43.93,Default,,0,0,0,,Là người hầu riêng.
Dialogue: 0,0:10:46.60,0:10:48.77,Default,,0,0,0,,Thì cũng là một thứ cả thôi chứ gì?
Dialogue: 0,0:10:51.69,0:10:53.86,Default,,0,0,0,,Cậu lén bám theo Nia đến tận đây đúng không?
Dialogue: 0,0:10:54.32,0:10:54.86,Default,,0,0,0,,Phải.
Dialogue: 0,0:10:55.32,0:10:58.36,Default,,0,0,0,,Với tư cách là người hầu riêng,\Ntôi có trách nhiệm phải bảo vệ người.
Dialogue: 0,0:10:58.99,0:11:00.61,Default,,0,0,0,,Và tuyệt đối không được rời người nửa bước.
Dialogue: 0,0:11:08.41,0:11:10.46,Default,,0,0,0,,Ngươi giải thích tình hình cho ta xem nào?
Dialogue: 0,0:11:10.92,0:11:14.63,Default,,0,0,0,,Ta đã cất công đến tận đây\Nđể ban cho các ngươi cơ hội phục thù đấy.
Dialogue: 0,0:11:15.30,0:11:17.13,Default,,0,0,0,,Chẳng có gì để giải thích cả.
Dialogue: 0,0:11:20.34,0:11:24.51,Default,,0,0,0,,Bọn ta không cần lũ phế vật yếu nhớt\Nbị một đứa ranh con đánh bại.
Dialogue: 0,0:11:25.97,0:11:27.77,Default,,0,0,0,,Vậy ra ngươi là giang hồ thứ thiệt à?
Dialogue: 0,0:11:28.10,0:11:29.60,Default,,0,0,0,,Có thể nói là như vậy đấy.
Dialogue: 0,0:11:30.60,0:11:33.19,Default,,0,0,0,,{\i1}Con bé chẳng có vẻ gì là ngạc nhiên cả.{\i0}
Dialogue: 0,0:11:35.73,0:11:36.98,Default,,0,0,0,,Con nhóc mày cũng khá đấy.
Dialogue: 0,0:11:37.73,0:11:40.61,Default,,0,0,0,,Bảo sao lũ kia lại bại trận dưới tay mày.
Dialogue: 0,0:11:41.40,0:11:45.49,Default,,0,0,0,,Lũ chúng mày may mắn đấy. Nếu nó không tới,\Nthì chúng mày đã mất mạng rồi.
Dialogue: 0,0:11:45.95,0:11:46.91,Default,,0,0,0,,Biến khuất mắt tao ngay.
Dialogue: 0,0:11:55.13,0:11:57.17,Default,,0,0,0,,Thế giờ mày định làm gì đây?
Dialogue: 0,0:11:57.92,0:11:59.17,Default,,0,0,0,,Ta định làm gì ư?
Dialogue: 0,0:11:59.80,0:12:03.43,Default,,0,0,0,,Dù gì thì mày cũng đã đập nhừ tử\Nngười của băng đảng bọn tao.
Dialogue: 0,0:12:03.76,0:12:06.68,Default,,0,0,0,,Và ta phải trả giá cho việc đó chứ gì?
Dialogue: 0,0:12:07.06,0:12:09.89,Default,,0,0,0,,Chuẩn luôn! Nhóc cũng tinh ý gớm nhỉ.
Dialogue: 0,0:12:10.27,0:12:12.56,Default,,0,0,0,,Nhưng nhẽ ra nhóc không nên mò tới đây một mình đâu.
Dialogue: 0,0:12:13.31,0:12:16.36,Default,,0,0,0,,{\i1}Mình đang bực mình lắm rồi đấy nhé!{\i0}
Dialogue: 0,0:12:16.52,0:12:20.19,Default,,0,0,0,,{\i1}Cứ tưởng đến đây là được xả giận\Nquậy banh chành với cả trăm tên cướp cơ chứ!{\i0}
Dialogue: 0,0:12:21.03,0:12:25.66,Default,,0,0,0,,Mày sẽ phải trả ngay món nợ\Nmà nhẽ ra lũ kia phải nộp cho tao.
Dialogue: 0,0:12:26.37,0:12:28.33,Default,,0,0,0,,Tao sẽ cho mày nếm mùi đau đớn tột cùng,
Dialogue: 0,0:12:28.95,0:12:31.08,Default,,0,0,0,,cho đến khi nào mày phải quỳ xuống van xin tha mạng mới thôi.
Dialogue: 0,0:12:31.75,0:12:32.50,Default,,0,0,0,,Thế cơ à?
Dialogue: 0,0:12:33.00,0:12:36.58,Default,,0,0,0,,Ban đầu ta chỉ định làm ngươi\Nkhóc lóc một chút cho vui thôi đấy...
Dialogue: 0,0:12:40.21,0:12:41.67,Default,,0,0,0,,Thế thì tao sẽ lấy mạng mày luôn.
Dialogue: 0,0:12:45.43,0:12:48.72,Default,,0,0,0,,{\i1}Sự tự tin toát ra ngay từ đòn đầu tiên,\Nmình thích rồi đấy!{\i0}
Dialogue: 0,0:13:01.90,0:13:04.57,Default,,0,0,0,,Mày cười cái quái gì thế hả?
Dialogue: 0,0:13:06.45,0:13:07.99,Default,,0,0,0,,Ta chẳng thấy đau chút nào cả!
Dialogue: 0,0:13:09.74,0:13:10.99,Default,,0,0,0,,Không thể nào...
Dialogue: 0,0:13:11.41,0:13:15.75,Default,,0,0,0,,Cú đấm của mình rõ ràng chạm đích rất lực,\Nsao con bé lại chẳng hề hấn gì?
Dialogue: 0,0:13:16.12,0:13:17.96,Default,,0,0,0,,Là bởi vì ngươi quá yếu.
Dialogue: 0,0:13:18.17,0:13:21.38,Default,,0,0,0,,Đến một bé gái mà ngươi\Ncòn chẳng hạ gục nổi cơ mà.
Dialogue: 0,0:13:23.26,0:13:27.30,Default,,0,0,0,,Ta luôn tâm niệm rằng,\Nnhìn nhận đúng giá trị thực của kẻ yếu
Dialogue: 0,0:13:27.47,0:13:29.39,Default,,0,0,0,,chính là bổn phận của kẻ mạnh!
Dialogue: 0,0:13:30.26,0:13:34.52,Default,,0,0,0,,Mày to mồm lên mặt dạy đời tao đấy à?\NTao sẽ giết tươi mày thật đấy, con ranh!
Dialogue: 0,0:13:38.27,0:13:39.27,Default,,0,0,0,,Thứ gì thế kia?
Dialogue: 0,0:13:40.23,0:13:41.90,Default,,0,0,0,,Chết này, con ranh thối tha!
Dialogue: 0,0:13:42.65,0:13:46.70,Default,,0,0,0,,Cứ tưởng là ma kiếm hắc ám gì,\Nai ngờ chỉ là một cái ống sắt tầm thường...
Dialogue: 0,0:14:10.68,0:14:12.93,Default,,0,0,0,,Khoan đã... mình thực sự yếu đến thế sao?
Dialogue: 0,0:14:14.22,0:14:15.64,Default,,0,0,0,,{\i1}Hắn lại đi hỏi ngược lại mình thật đấy à?{\i0}
Dialogue: 0,0:14:18.98,0:14:22.27,Default,,0,0,0,,Thành thật mà nói,\Nta cũng không rõ nữa.
Dialogue: 0,0:14:22.48,0:14:27.03,Default,,0,0,0,,Ta không biết là do ta quá mạnh,\Nhay chỉ đơn giản là ngươi quá yếu.
Dialogue: 0,0:14:27.28,0:14:30.70,Default,,0,0,0,,Dù sao đi nữa, bại trận dưới tay ta\Ncũng chẳng có gì phải xấu hổ đâu.
Dialogue: 0,0:14:36.79,0:14:40.08,Default,,0,0,0,,Để ta rèn giũa cho ngươi một chút.\NNào, nhào vô tấn công ta đi.
Dialogue: 0,0:14:49.72,0:14:50.55,Default,,0,0,0,,Thôi xong rồi...
Dialogue: 0,0:14:51.01,0:14:53.05,Default,,0,0,0,,Này, thế này có hơi quá đà không đấy?
Dialogue: 0,0:14:53.35,0:14:56.14,Default,,0,0,0,,Tôi thấy tội nghiệp cho đám giang hồ tép riu đó thật.
Dialogue: 0,0:14:56.31,0:14:58.77,Default,,0,0,0,,Dù có cả trăm tên thì cũng chẳng có cửa thắng tiểu thư đâu.
Dialogue: 0,0:15:07.86,0:15:09.11,Default,,0,0,0,,Giết... giết tao luôn đi...
Dialogue: 0,0:15:09.49,0:15:12.70,Default,,0,0,0,,Ta cứ sợ là ngươi\Nkhông biết khi nào nên bỏ cuộc cơ đấy!
Dialogue: 0,0:15:13.12,0:15:15.49,Default,,0,0,0,,Ngươi đã chịu trọn 38 đòn của ta,\Nkhá lắm!
Dialogue: 0,0:15:16.24,0:15:18.00,Default,,0,0,0,,Thế nhé, ta về nhà đây!
Dialogue: 0,0:15:20.12,0:15:22.25,Default,,0,0,0,,Chuyện này... chưa kết thúc đâu, tao thề đấy.
Dialogue: 0,0:15:23.96,0:15:27.92,Default,,0,0,0,,Tốt lắm, ta sẽ quay lại quán rượu này\Nnếu có dịp ghé qua hoàng đô.
Dialogue: 0,0:15:28.51,0:15:31.89,Default,,0,0,0,,Và ta hứa là chúng ta sẽ lại\Nchơi đùa vui vẻ cùng nhau tiếp nhé!
Dialogue: 0,0:15:33.26,0:15:35.26,Default,,0,0,0,,Con ranh quái vật... mày không phải người bình thường.
Dialogue: 0,0:15:36.18,0:15:40.23,Default,,0,0,0,,Mà này, tốt nhất là lúc này\Nngươi đừng có dại mà bước chân ra ngoài.
Dialogue: 0,0:15:49.86,0:15:51.91,Default,,0,0,0,,Xin lỗi vì để mọi người đợi lâu nhé!\NTa vừa có chút việc bận cần xử lý.
Dialogue: 0,0:15:52.16,0:15:55.20,Default,,0,0,0,,Anzel đâu rồi, con ranh khốn kiếp kia?
Dialogue: 0,0:15:55.87,0:15:59.29,Default,,0,0,0,,Chính là nó!\NCon nhóc có sức mạnh quái vật đó đấy!
Dialogue: 0,0:16:00.91,0:16:04.54,Default,,0,0,0,,Bớt nói nhảm đi,\Nnhào vô đánh trận nào!
Dialogue: 0,0:16:25.52,0:16:26.27,Default,,0,0,0,,Chết này!
Dialogue: 0,0:16:34.86,0:16:36.12,Default,,0,0,0,,Sao thế hả?
Dialogue: 0,0:16:37.16,0:16:40.08,Default,,0,0,0,,Giữ vững thế thủ đi,\Nkhông là bị giẫm bẹp dí dưới chân ta đấy!
Dialogue: 0,0:16:43.75,0:16:45.96,Default,,0,0,0,,Tất cả anh em, xông lên giết chết nó!
Dialogue: 0,0:16:50.92,0:16:55.72,Default,,0,0,0,,{\i1}Được vung tay xả láng không chút kiêng dè\Nthế này cảm giác đã thật đấy!{\i0}
Dialogue: 0,0:16:56.43,0:16:58.76,Default,,0,0,0,,Cậu không ra ngăn cô ấy lại à?
Dialogue: 0,0:16:59.14,0:17:03.39,Default,,0,0,0,,Tôi chẳng muốn phá đám chút nào\Nkhi thấy tiểu thư đang vui vẻ đến thế.
Dialogue: 0,0:17:04.52,0:17:05.94,Default,,0,0,0,,Như thế mà gọi là vui vẻ á?
Dialogue: 0,0:17:06.10,0:17:09.73,Default,,0,0,0,,Và quan trọng hơn cả,\Ntôi chẳng thể nào cản nổi người lúc này đâu.
Dialogue: 0,0:17:10.73,0:17:12.65,Default,,0,0,0,,Tiểu thư mạnh hơn tôi rất nhiều.
Dialogue: 0,0:17:15.74,0:17:16.78,Default,,0,0,0,,Tao nói có đúng không hả?
Dialogue: 0,0:17:17.78,0:17:19.87,Default,,0,0,0,,- Tớ chịu...\N- Vui quá đi mất!
Dialogue: 0,0:17:24.79,0:17:28.63,Default,,0,0,0,,Có vẻ như Anzel đã gây ra thiệt hại\Nnhiều hơn dự tính rồi.
Dialogue: 0,0:17:38.60,0:17:41.01,Default,,0,0,0,,Ô kìa, xem ra vẫn còn mồi nhắm tiếp này!
Dialogue: 0,0:17:42.39,0:17:43.52,Default,,0,0,0,,Nia Liston sao?
Dialogue: 0,0:17:46.31,0:17:48.94,Default,,0,0,0,,Khoan đã nào,\NAnzel đâu rồi?
Dialogue: 0,0:17:49.11,0:17:49.77,Default,,0,0,0,,Anzel á?
Dialogue: 0,0:17:50.73,0:17:52.98,Default,,0,0,0,,Là con chó săn của ngươi đúng không?
Dialogue: 0,0:17:53.15,0:17:55.28,Default,,0,0,0,,Hắn đang nằm nghỉ ngơi bên trong quán rượu rồi.
Dialogue: 0,0:17:57.16,0:18:01.28,Default,,0,0,0,,Nếu muốn đánh bại được ta,\Nngươi phải kiếm người nào mạnh hơn nhiều.
Dialogue: 0,0:18:01.66,0:18:02.20,Default,,0,0,0,,Hiểu chưa hả?
Dialogue: 0,0:18:04.25,0:18:05.71,Default,,0,0,0,,Giờ tính sao đây đại ca?
Dialogue: 0,0:18:05.87,0:18:08.92,Default,,0,0,0,,Tao cũng đách hiểu chuyện gì đang xảy ra,\Nnhưng trước mắt phải tóm sống nó đã, đúng không?
Dialogue: 0,0:18:11.29,0:18:13.42,Default,,0,0,0,,Phải, bắt sống con ranh miệng còn hôi sữa này lại!
Dialogue: 0,0:18:13.88,0:18:16.93,Default,,0,0,0,,Ngoan ngoãn đi theo các anh...
Dialogue: 0,0:18:18.47,0:18:21.55,Default,,0,0,0,,Mày làm cái trò gì thế hả?\NLại nốc rượu cho đẫy vào rồi...
Dialogue: 0,0:18:29.10,0:18:30.40,Default,,0,0,0,,Giao lại cho đại ca đấy nhé!
Dialogue: 0,0:18:31.69,0:18:32.40,Default,,0,0,0,,Nào.
Dialogue: 0,0:18:33.90,0:18:38.45,Default,,0,0,0,,Hôm nay tâm trạng ta đang rất tốt,\Nnên ta sẵn lòng tha cho ngươi một con đường sống.
Dialogue: 0,0:18:39.03,0:18:39.95,Default,,0,0,0,,Ngươi thấy thế nào?
Dialogue: 0,0:18:40.57,0:18:43.83,Default,,0,0,0,,Nhưng đổi lại,\Ntuyệt đối không được nói cho ai biết ta từng ở đây!
Dialogue: 0,0:18:44.91,0:18:47.54,Default,,0,0,0,,Phải thề hứa danh dự đấy, rõ chưa?
Dialogue: 0,0:18:54.30,0:18:57.59,Default,,0,0,0,,Tớ biết là cậu ấy mạnh,\Nnhưng không ngờ lại quái vật đến mức này.
Dialogue: 0,0:18:58.17,0:19:02.10,Default,,0,0,0,,Tôi phải về khách sạn trước đây.\NĐừng có nói với tiểu thư là tôi từng ở đây đấy.
Dialogue: 0,0:19:02.60,0:19:03.22,Default,,0,0,0,,Tại sao chứ?
Dialogue: 0,0:19:04.01,0:19:07.02,Default,,0,0,0,,Nếu tiểu thư biết được\Ntôi lén bám theo mỗi lần người trốn đi chơi,
Dialogue: 0,0:19:07.18,0:19:09.23,Default,,0,0,0,,người sẽ tìm mọi cách để cắt đuôi tôi cho xem.
Dialogue: 0,0:19:10.48,0:19:11.86,Default,,0,0,0,,Số cậu vất vả thật đấy!
Dialogue: 0,0:19:12.36,0:19:13.57,Default,,0,0,0,,Cậu còn chưa biết hết đâu.
Dialogue: 0,0:19:15.86,0:19:20.28,Default,,0,0,0,,Thế nhưng với tư cách là người hầu riêng,\Nnghĩa vụ của tôi là phải bảo vệ tiểu thư Nia...
Dialogue: 0,0:19:21.78,0:19:22.82,Default,,0,0,0,,Tôi xin phép đi trước.
Dialogue: 0,0:19:33.84,0:19:35.88,Default,,0,0,0,,- Quà tặng cậu này!\N- Cảm ơn nhé.
Dialogue: 0,0:19:36.63,0:19:38.72,Default,,0,0,0,,Hồng trà này thơm ngon tuyệt cú mèo luôn!
Dialogue: 0,0:19:39.55,0:19:42.97,Default,,0,0,0,,Cậu nhớ chia cho cả cô hầu gái\Nuống cùng nữa đấy nhé!
Dialogue: 0,0:19:52.56,0:19:55.15,Default,,0,0,0,,{\an8}SÂN BAY KHÍ CẦU TRUNG TÂM\NTRÊN HÒN ĐẢO LƠ LỬNG NHÀ LISTON
Dialogue: 0,0:19:55.32,0:19:57.65,Default,,0,0,0,,{\an8}DINH THỰ GIA TỘC LISTON
Dialogue: 0,0:20:01.24,0:20:02.82,Default,,0,0,0,,Em đi pha trà đây ạ.
Dialogue: 0,0:20:05.16,0:20:06.91,Default,,0,0,0,,Haizz, thoắt cái đã một năm rồi...
Dialogue: 0,0:20:07.41,0:20:08.33,Default,,0,0,0,,Một năm sao?
Dialogue: 0,0:20:08.95,0:20:13.29,Default,,0,0,0,,Vâng, kể từ cái đêm định mệnh\Nmà người suýt chút nữa đã qua đời.
Dialogue: 0,0:20:17.63,0:20:19.67,Default,,0,0,0,,Ừ nhỉ, em nhắc ta mới nhớ...
Dialogue: 0,0:20:20.80,0:20:24.39,Default,,0,0,0,,{\i1}Một năm trôi qua kể từ đêm hôm ấy\Nvừa cảm thấy dài đằng đẵng,{\i0}
Dialogue: 0,0:20:24.93,0:20:26.43,Default,,0,0,0,,{\i1}nhưng lại cũng thật ngắn ngủi.{\i0}
Dialogue: 0,0:20:29.89,0:20:32.35,Default,,0,0,0,,Em có một thỉnh cầu, thưa tiểu thư.
Dialogue: 0,0:20:32.52,0:20:33.44,Default,,0,0,0,,Thỉnh cầu sao?
Dialogue: 0,0:20:34.35,0:20:35.94,Default,,0,0,0,,Em muốn ngủ chung giường với ta à?
Dialogue: 0,0:20:36.15,0:20:37.61,Default,,0,0,0,,Đó là điều hiển nhiên rồi ạ!
Dialogue: 0,0:20:37.77,0:20:40.69,Default,,0,0,0,,Đến con ả đanh đá đáng ghét kia\Ncòn được ngủ cạnh người,
Dialogue: 0,0:20:40.86,0:20:44.20,Default,,0,0,0,,thì tại sao em lại không được chứ?\NThật là vô lý hết sức!
Dialogue: 0,0:20:44.61,0:20:48.95,Default,,0,0,0,,Bởi vì ta sợ nửa đêm nửa hôm\Nem lại giở trò hôn hít ta đấy chứ sao.
Dialogue: 0,0:20:49.33,0:20:50.50,Default,,0,0,0,,Thế thì đã sao đâu ạ?
Dialogue: 0,0:20:50.66,0:20:54.37,Default,,0,0,0,,Cả hai đều là con gái với nhau cả,\Ncon gái thơm nhau thì có vấn đề gì đâu!
Dialogue: 0,0:20:54.62,0:20:57.50,Default,,0,0,0,,Chỉ là cử chỉ trong sáng thôi mà,\Nđâu có tính là phạm quy!
Dialogue: 0,0:20:58.71,0:21:01.46,Default,,0,0,0,,À mà điều em muốn cầu xin\Nchẳng liên quan gì tới chuyện đó đâu.
Dialogue: 0,0:21:13.56,0:21:14.35,Default,,0,0,0,,Tiểu thư,
Dialogue: 0,0:21:20.11,0:21:22.28,Default,,0,0,0,,người có thể huấn luyện cho em được không?
Dialogue: 0,0:21:23.32,0:21:24.86,Default,,0,0,0,,Ý em là sao?
Dialogue: 0,0:21:25.28,0:21:27.03,Default,,0,0,0,,Huấn luyện kỹ năng chiến đấu cho em ạ.
Dialogue: 0,0:21:27.66,0:21:32.62,Default,,0,0,0,,Em không thể nào bảo vệ người\Nkhi mà chính bản thân em còn yếu hơn cả người.
Dialogue: 0,0:21:33.54,0:21:35.62,Default,,0,0,0,,Được thôi, nhưng ta sẽ nghiêm khắc lắm đấy.
Dialogue: 0,0:21:36.50,0:21:37.79,Default,,0,0,0,,Đó chính là điều em mong muốn ạ.
Dialogue: 0,0:21:38.42,0:21:42.63,Default,,0,0,0,,Em chỉ không muốn bản thân\Ntrở thành gánh nặng bị bỏ lại phía sau thôi.
Dialogue: 0,0:21:45.34,0:21:46.51,Default,,0,0,0,,Tốt lắm, Rinokis.
Dialogue: 0,0:21:47.39,0:21:50.14,Default,,0,0,0,,Kể từ hôm nay, em chính là đại đệ tử đầu tiên của ta.
Dialogue: 0,0:21:50.56,0:21:54.06,Default,,0,0,0,,Em phải trở nên thật mạnh mẽ\Nđể không làm bẽ mặt danh xưng đồ đệ của ta đấy.
Dialogue: 0,0:21:54.73,0:21:57.23,Default,,0,0,0,,Em xin dốc trọn thể xác và linh hồn này để không phụ lòng người!
Dialogue: 0,0:22:12.29,0:22:15.75,Default,,0,0,0,,Nia Liston: Honoka Inoue\NRinokis Funk: Fuuka Izumi
Dialogue: 0,0:22:15.91,0:22:19.25,Default,,0,0,0,,{\an3}Sharro White: Maaya Uchida\NAnzel: Taku Yashiro
