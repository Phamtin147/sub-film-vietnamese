Dialogue: 0,0:00:00.00,0:00:02.04,Default,,0,0,0,,{\an8}Dựa trên nguyên tác của Minamino Umikaze
Dialogue: 0,0:00:07.54,0:00:08.84,Default,,0,0,0,,Thiết kế nhân vật gốc:\NCanata Katana, Jishaku
Dialogue: 0,0:00:18.85,0:00:21.39,Default,,0,0,0,,{\an8}NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:00:23.14,0:00:25.65,Default,,0,0,0,,{\an3}Thiết kế nhân vật:\NYuki Itou, Kana Tosaoka
Dialogue: 0,0:00:25.81,0:00:28.44,Default,,0,0,0,,{\an1}Biên kịch: Gigaemon Ichikawa
Dialogue: 0,0:00:29.32,0:00:31.99,Default,,0,0,0,,{\an8}Thiết kế màu sắc:\NRyota Katsuta, Maki Yamamoto
Dialogue: 0,0:00:32.15,0:00:33.07,Default,,0,0,0,,{\an3}Đạo diễn mỹ thuật: Hiroshi Gouroku
Dialogue: 0,0:00:33.24,0:00:34.11,Default,,0,0,0,,{\an1}Đạo diễn hình ảnh: Takashi Ooide
Dialogue: 0,0:00:43.87,0:00:47.17,Default,,0,0,0,,{\an1}Biên tập: Masayuki Kurosawa\NBối cảnh: Makaria
Dialogue: 0,0:01:01.35,0:01:03.18,Default,,0,0,0,,{\an8}Bài hát mở đầu: "Respawn!!"\NTrình bày: Watame Tsunomaki
Dialogue: 0,0:01:10.40,0:01:11.36,Default,,0,0,0,,{\an1}Đạo diễn âm thanh: Hiromi Kikuta
Dialogue: 0,0:01:16.70,0:01:18.11,Default,,0,0,0,,Âm nhạc: Naoki Endou
Dialogue: 0,0:01:19.87,0:01:20.58,Default,,0,0,0,,{\an8}Studio hoạt hình: Konami Animation
Dialogue: 0,0:01:20.74,0:01:21.87,Default,,0,0,0,,{\an8}Trợ lý đạo diễn: Haruta Segi
Dialogue: 0,0:01:26.29,0:01:27.17,Default,,0,0,0,,Đạo diễn: Motoki Nakanishi
Dialogue: 0,0:01:27.33,0:01:29.83,Default,,0,0,0,,Ủy ban sản xuất:\NThe Merciless Maiden
Dialogue: 0,0:01:33.92,0:01:35.97,Default,,0,0,0,,{\i1}Đời sống tại học viện hoàng gia Altoire,{\i0}
Dialogue: 0,0:01:36.47,0:01:41.18,Default,,0,0,0,,{\i1}dành cho tiểu thư Nia và tôi, Rinokis,\Nhầu gái trung thành của người, đã chính thức khởi đầu.{\i0}
Dialogue: 0,0:01:42.64,0:01:45.73,Default,,0,0,0,,{\i1}Tại đây, chúng tôi đã tương ngộ\NĐệ tam vương nữ của vương quốc,{\i0}
Dialogue: 0,0:01:46.14,0:01:47.31,Default,,0,0,0,,{\i1}điện hạ Hildetaura,{\i0}
Dialogue: 0,0:01:47.60,0:01:50.27,Default,,0,0,0,,{\i1}cùng với tiểu thư thừa kế của gia tộc Silver,{\i0}
Dialogue: 0,0:01:50.44,0:01:52.98,Default,,0,0,0,,{\i1}con nhãi ranh chỏng lỏn tên là Reliared.{\i0}
Dialogue: 0,0:01:53.73,0:01:56.49,Default,,0,0,0,,{\i1}Tiểu thư Nia và bọn họ\Nđều là ba ngôi sao của truyền hình ma pháp.{\i0}
Dialogue: 0,0:01:57.07,0:02:00.24,Default,,0,0,0,,{\i1}Trước lời đề nghị của điện hạ Hildetaura,\Nba người họ cùng nhau hợp tác{\i0}
Dialogue: 0,0:02:00.41,0:02:02.24,Default,,0,0,0,,{\i1}để quảng bá nền truyền hình này.{\i0}
Dialogue: 0,0:02:02.99,0:02:04.58,Default,,0,0,0,,{\i1}Sau buổi ghi hình chung đó,{\i0}
Dialogue: 0,0:02:04.95,0:02:07.00,Default,,0,0,0,,{\i1}con nhãi xấc xược Reliared...{\i0}
Dialogue: 0,0:02:07.41,0:02:08.96,Default,,0,0,0,,{\i1}Nếu cậu thực sự muốn,{\i0}
Dialogue: 0,0:02:09.58,0:02:12.92,Default,,0,0,0,,{\i1}tôi không ngại cùng cậu quảng bá\Ntruyền hình ma pháp đâu!{\i0}
Dialogue: 0,0:02:14.13,0:02:17.63,Default,,0,0,0,,{\i1}... rốt cuộc cũng phải cúi đầu thừa nhận\Ntài năng xuất chúng của tiểu thư Nia!{\i0}
Dialogue: 0,0:02:22.89,0:02:25.64,Default,,0,0,0,,Cậu không thắng nổi tôi\Ntrong buổi kiểm tra thể lực đâu, Nia!
Dialogue: 0,0:02:26.18,0:02:27.14,Default,,0,0,0,,Cứ chờ xem...
Dialogue: 0,0:02:27.85,0:02:31.15,Default,,0,0,0,,- Cậu có thèm nghe tôi nói không đấy?!\N- Kìa, là Nia và Relia kìa!
Dialogue: 0,0:02:31.44,0:02:34.90,Default,,0,0,0,,Đúng là hai cô tiểu thư quý tộc,\Nlúc nào cũng có hầu gái kè kè bên cạnh...
Dialogue: 0,0:02:35.28,0:02:39.99,Default,,0,0,0,,{\i1}Dù chế độ phân chia đẳng cấp\Nđang dần trở nên lỗi thời,{\i0}
Dialogue: 0,0:02:40.16,0:02:44.91,Default,,0,0,0,,{\i1}nhưng người ta vẫn dè chừng giới quý tộc...\NMà vấn đề lớn nhất là...{\i0}
Dialogue: 0,0:02:45.79,0:02:46.58,Default,,0,0,0,,Ai thế nhỉ?
Dialogue: 0,0:02:46.75,0:02:49.46,Default,,0,0,0,,Mấy bạn hay xuất hiện trên truyền hình ma pháp đấy!
Dialogue: 0,0:02:49.62,0:02:51.25,Default,,0,0,0,,Tớ chưa từng thấy bao giờ...
Dialogue: 0,0:02:51.42,0:02:52.92,Default,,0,0,0,,Nhà tớ làm gì có máy truyền hình ma pháp.
Dialogue: 0,0:02:54.50,0:02:56.80,Default,,0,0,0,,Nia, đừng có vừa đi vừa mơ mộng thế chứ!
Dialogue: 0,0:02:58.30,0:02:59.88,Default,,0,0,0,,Nhìn kìa, chúng ta tới nơi rồi!
Dialogue: 0,0:03:00.26,0:03:01.80,Default,,0,0,0,,{\an8}KHỐI TIỂU HỌC HỌC VIỆN
Dialogue: 0,0:03:02.09,0:03:05.31,Default,,0,0,0,,{\i1}Thôi, dẹp mấy chuyện đó sang một bên!\NMục tiêu lớn nhất hôm nay của mình,{\i0}
Dialogue: 0,0:03:06.22,0:03:10.81,Default,,0,0,0,,{\i1}chính là vị sư phụ phái Thiên Phá!\NChắc chắn hắn ta phải mạnh mẽ phi thường lắm!{\i0}
Dialogue: 0,0:03:12.44,0:03:14.31,Default,,0,0,0,,Sao cậu lại cười tủm tỉm nham hiểm thế kia?
Dialogue: 0,0:03:15.44,0:03:17.82,Default,,0,0,0,,Các tân học viên, xếp hàng bên này!
Dialogue: 0,0:03:24.41,0:03:25.99,Default,,0,0,0,,Người tiếp theo!
Dialogue: 0,0:03:27.49,0:03:29.70,Default,,0,0,0,,Kiểm tra lượng ma lực trước sao?
Dialogue: 0,0:03:36.38,0:03:41.22,Default,,0,0,0,,Màu chủ đạo của em là màu đỏ!\NLượng ma lực vượt trội hơn người bình thường đấy.
Dialogue: 0,0:03:42.97,0:03:45.72,Default,,0,0,0,,Cả hai chị gái của em\Nđều có màu đỏ như vậy ạ.
Dialogue: 0,0:03:46.10,0:03:47.81,Default,,0,0,0,,Tới lượt em! Lại đây nào.
Dialogue: 0,0:03:54.19,0:03:54.98,Default,,0,0,0,,Lạ thật đấy,
Dialogue: 0,0:03:55.48,0:03:57.48,Default,,0,0,0,,quả cầu pha lê chẳng có chút phản ứng nào.
Dialogue: 0,0:03:58.40,0:03:59.94,Default,,0,0,0,,{\i1}Biết ngay mà.{\i0}
Dialogue: 0,0:04:00.65,0:04:05.07,Default,,0,0,0,,Mái tóc con chuyển sang màu trắng kể từ lần\Nthập tử nhất sinh năm ngoái tới giờ.
Dialogue: 0,0:04:05.45,0:04:09.87,Default,,0,0,0,,Đó là hiện tượng xảy ra ở các pháp sư\Nkhi vắt kiệt toàn bộ ma lực trong cơ thể...
Dialogue: 0,0:04:10.75,0:04:15.33,Default,,0,0,0,,{\i1}Thực chất là toàn bộ kinh mạch ma pháp của cơ thể này\Nđều đã bị tổn thương nghiêm trọng rồi.{\i0}
Dialogue: 0,0:04:17.09,0:04:17.96,Default,,0,0,0,,Nia...
Dialogue: 0,0:04:18.13,0:04:18.88,Default,,0,0,0,,{\i1}Nhưng chẳng hề hấn gì!{\i0}
Dialogue: 0,0:04:19.30,0:04:24.13,Default,,0,0,0,,{\i1}Dù sao thì mình vẫn khoái đấm đá cận chiến\Nhơn là niệm mấy câu thần chú ma pháp!{\i0}
Dialogue: 0,0:04:24.30,0:04:26.26,Default,,0,0,0,,Sao tự dưng cậu lại cười hớn hở thế?
Dialogue: 0,0:04:32.18,0:04:33.14,Default,,0,0,0,,KIỂM TRA THỂ LỰC
Dialogue: 0,0:04:33.35,0:04:35.15,Default,,0,0,0,,Cậu nặng cân hơn tôi đấy!
Dialogue: 0,0:04:35.35,0:04:40.03,Default,,0,0,0,,{\i1}Phải rồi, bởi vì cơ bắp của ta\Nnặng hơn đống mỡ thừa của nhà mi nhiều!{\i0}
Dialogue: 0,0:04:40.19,0:04:42.78,Default,,0,0,0,,{\i1}Chẳng hiểu sao nhìn cái bản mặt nó\Nlà thấy ngứa mắt rồi.{\i0}
Dialogue: 0,0:04:46.70,0:04:47.45,Default,,0,0,0,,Xin hãy chiêm ngưỡng đây!
Dialogue: 0,0:04:48.58,0:04:49.28,Default,,0,0,0,,Ôi trời đất ơi!
Dialogue: 0,0:04:53.25,0:04:56.00,Default,,0,0,0,,Xin tiểu thư đừng làm vỡ nát máy đo đấy ạ.
Dialogue: 0,0:04:56.21,0:04:56.79,Default,,0,0,0,,Ta biết rồi.
Dialogue: 0,0:05:00.55,0:05:02.38,Default,,0,0,0,,- Oa!\N- Ngầu quá xá!
Dialogue: 0,0:05:02.55,0:05:04.05,Default,,0,0,0,,Nhìn tức mắt thật đấy!
Dialogue: 0,0:05:04.34,0:05:06.05,Default,,0,0,0,,CHẠY CỰ LY 50M
Dialogue: 0,0:05:39.25,0:05:41.21,Default,,0,0,0,,CHẠY BỀN TIẾP SỨC
Dialogue: 0,0:05:56.39,0:05:59.23,Default,,0,0,0,,Tại sao môn nào cậu cũng\Nnhỉnh hơn tôi một chút thế hả?
Dialogue: 0,0:05:59.60,0:06:03.40,Default,,0,0,0,,{\i1}Thứ lỗi nhé, nhưng ta không bao giờ chịu thua,\Ndù đối thủ chỉ là một đứa con nít ranh.{\i0}
Dialogue: 0,0:06:03.78,0:06:04.73,Default,,0,0,0,,{\i1}Mà thôi, bỏ qua đi!{\i0}
Dialogue: 0,0:06:05.44,0:06:06.49,Default,,0,0,0,,Đi mau thôi nào!
Dialogue: 0,0:06:07.03,0:06:07.74,Default,,0,0,0,,Đi đâu cơ?
Dialogue: 0,0:06:08.28,0:06:10.49,Default,,0,0,0,,Tới chỗ chị gái cậu đang đợi chúng ta chứ đâu!
Dialogue: 0,0:06:11.20,0:06:14.74,Default,,0,0,0,,{\i1}Ngày mai nhớ ghé qua câu lạc bộ Thiên Phá bọn chị chơi nhé!{\i0}
Dialogue: 0,0:06:16.96,0:06:19.08,Default,,0,0,0,,À phải rồi, hôm qua chị ấy có mời cậu!
Dialogue: 0,0:06:20.25,0:06:23.09,Default,,0,0,0,,{\i1}Thành thật mà nói, mình chỉ mong chờ mỗi giây phút này!{\i0}
Dialogue: 0,0:06:23.25,0:06:25.67,Default,,0,0,0,,- {\i1}Mau dắt ta đi ngay đi!\N{\i0}- Nhìn cậu đáng sợ quá đấy!
Dialogue: 0,0:06:29.72,0:06:32.18,Default,,0,0,0,,Cậu tính gia nhập câu lạc bộ à, Nia?
Dialogue: 0,0:06:32.89,0:06:36.02,Default,,0,0,0,,{\i1}Nếu tên sư phụ đó mạnh hơn ta,\Nthì có thể là có đấy.{\i0}
Dialogue: 0,0:06:36.39,0:06:37.98,Default,,0,0,0,,{\i1}Nhưng khả năng đó còn lâu mới xảy ra!{\i0}
Dialogue: 0,0:06:38.81,0:06:40.69,Default,,0,0,0,,Bọn mình còn phải quảng bá truyền hình ma pháp nữa,
Dialogue: 0,0:06:40.85,0:06:43.98,Default,,0,0,0,,làm gì có nhiều thời gian\Ncho hoạt động câu lạc bộ chứ.
Dialogue: 0,0:06:45.03,0:06:48.78,Default,,0,0,0,,Cậu nói không sai.\NNhưng tôi thì muốn gia nhập lắm đấy!
Dialogue: 0,0:06:51.11,0:06:52.91,Default,,0,0,0,,Cậu muốn trở nên mạnh mẽ hơn à?
Dialogue: 0,0:06:53.07,0:06:55.29,Default,,0,0,0,,Đương nhiên rồi. Phải mạnh hơn cả cậu nữa!
Dialogue: 0,0:06:56.37,0:06:57.41,Default,,0,0,0,,Mạnh hơn ta ư?
Dialogue: 0,0:06:58.41,0:07:02.92,Default,,0,0,0,,Tôi ăn đứt cậu về nhan sắc lẫn tính cách,\Nchỉ thua mỗi khoản sức mạnh thôi.
Dialogue: 0,0:07:03.34,0:07:07.51,Default,,0,0,0,,Và với tư cách là con gái út nhà Silver,\Ntôi nhất định phải vượt mặt cậu!
Dialogue: 0,0:07:11.63,0:07:12.80,Default,,0,0,0,,Sao cậu lại cười?
Dialogue: 0,0:07:14.26,0:07:15.64,Default,,0,0,0,,Không, có gì đâu...
Dialogue: 0,0:07:17.31,0:07:20.06,Default,,0,0,0,,Cậu thực sự muốn trở nên\Nmạnh hơn ta sao?
Dialogue: 0,0:07:24.56,0:07:25.69,Default,,0,0,0,,Trời đất ơi!
Dialogue: 0,0:07:26.02,0:07:28.28,Default,,0,0,0,,Cậu có chịu nói cho tôi biết tại sao cậu lại cười không hả?!
Dialogue: 0,0:07:31.49,0:07:33.82,Default,,0,0,0,,KHU TRIỂN LÃM CÁC CÂU LẠC BỘ
Dialogue: 0,0:07:36.24,0:07:38.83,Default,,0,0,0,,Đối với một vương quốc thái bình đến mức thanh bình quá đỗi,
Dialogue: 0,0:07:39.29,0:07:41.58,Default,,0,0,0,,thì số lượng câu lạc bộ chiến đấu lại nhiều đến bất ngờ!
Dialogue: 0,0:07:42.04,0:07:43.25,Default,,0,0,0,,Thái bình thì đúng là vậy,
Dialogue: 0,0:07:43.42,0:07:47.05,Default,,0,0,0,,nhưng vẫn còn đầy rẫy quái vật và ngục tối đấy thôi.
Dialogue: 0,0:07:47.50,0:07:50.55,Default,,0,0,0,,Học viện có cả các câu lạc bộ văn học và nghệ thuật,
Dialogue: 0,0:07:50.76,0:07:55.10,Default,,0,0,0,,nhưng chỉ có các câu lạc bộ thể thao võ thuật mới tập trung trong nhà thể chất này thôi.
Dialogue: 0,0:07:57.60,0:07:59.10,Default,,0,0,0,,Câu lạc bộ của chị tôi ở đằng kia kìa!
Dialogue: 0,0:08:04.31,0:08:05.23,Default,,0,0,0,,Tôi qua đó đây!
Dialogue: 0,0:08:05.40,0:08:07.86,Default,,0,0,0,,Khoan đã nào, tôi đi cùng với!
Dialogue: 0,0:08:09.15,0:08:10.36,Default,,0,0,0,,Nia! Relia!
Dialogue: 0,0:08:10.74,0:08:11.99,Default,,0,0,0,,Chào chị, Ririmi!
Dialogue: 0,0:08:12.15,0:08:13.03,Default,,0,0,0,,Em chào chị!
Dialogue: 0,0:08:13.20,0:08:14.86,Default,,0,0,0,,Cảm ơn hai đứa đã tới nhé!
Dialogue: 0,0:08:15.32,0:08:17.91,Default,,0,0,0,,Đi theo chị, chị dẫn vào võ đường!
Dialogue: 0,0:08:18.54,0:08:21.62,Default,,0,0,0,,{\an8}VÕ ĐƯỜNG PHÁI THIÊN PHÁ\NHỌC VIỆN HOÀNG GIA ALTOIRE
Dialogue: 0,0:08:25.83,0:08:28.00,Default,,0,0,0,,Đây chính là tân binh đầy tiềm năng mà em kể đấy ạ!
Dialogue: 0,0:08:28.38,0:08:30.88,Default,,0,0,0,,{\i1}Hắn ta chính là sư phụ\Ncủa phái Thiên Phá đấy sao?{\i0}
Dialogue: 0,0:08:32.34,0:08:33.13,Default,,0,0,0,,Nhóc chính là
Dialogue: 0,0:08:38.93,0:08:41.93,Default,,0,0,0,,cô bé siêu mạnh mà Ririmi vừa kể với ta đấy à?
Dialogue: 0,0:08:42.52,0:08:44.19,Default,,0,0,0,,Dạ đúng rồi, chính là em ấy đấy ạ!
Dialogue: 0,0:08:46.27,0:08:48.48,Default,,0,0,0,,Rất hân hạnh được diện kiến, cháu là Nia Liston!
Dialogue: 0,0:08:49.90,0:08:50.53,Default,,0,0,0,,Ta biết chứ!
Dialogue: 0,0:08:50.98,0:08:52.32,Default,,0,0,0,,Mọi người đã kể hết cho ta rồi.
Dialogue: 0,0:08:52.78,0:08:55.91,Default,,0,0,0,,Ta rất tán thưởng niềm đam mê võ học\Ncủa nhóc ở độ tuổi này đấy!
Dialogue: 0,0:08:57.49,0:08:59.66,Default,,0,0,0,,{\i1}Mình chỉ muốn đập cho lũ này một trận tơi bời{\i0}
Dialogue: 0,0:09:00.41,0:09:02.91,Default,,0,0,0,,{\i1}để bõ cái công thất vọng tràn trề này!{\i0}
Dialogue: 0,0:09:06.37,0:09:10.00,Default,,0,0,0,,{\i1}Cái gã "sư phụ" này chỉ là một bao thịt cơ bắp\Nchẳng có lấy một tí xíu kỹ thuật nào.{\i0}
Dialogue: 0,0:09:10.17,0:09:12.51,Default,,0,0,0,,{\i1}Đơn thuần chỉ là một gã to xác cậy sức trâu.{\i0}
Dialogue: 0,0:09:13.09,0:09:15.43,Default,,0,0,0,,{\i1}Nếu bắt buộc phải tìm ra một điểm cộng ở hắn,{\i0}
Dialogue: 0,0:09:17.51,0:09:21.81,Default,,0,0,0,,{\i1}thì may ra ăn một đấm toàn lực của mình\Nhắn vẫn chưa tắt thở ngay tại chỗ.{\i0}
Dialogue: 0,0:09:25.10,0:09:27.44,Default,,0,0,0,,Vậy thôi, cháu xin phép cáo từ trước ạ!
Dialogue: 0,0:09:28.19,0:09:29.65,Default,,0,0,0,,Khoan đã nào nhóc!
Dialogue: 0,0:09:30.27,0:09:32.78,Default,,0,0,0,,Nhóc thấy sao nếu gia nhập môn phái của ta?
Dialogue: 0,0:09:32.94,0:09:35.82,Default,,0,0,0,,Ta sẽ rất hoan nghênh nếu nhóc đồng ý đấy!
Dialogue: 0,0:09:36.45,0:09:39.28,Default,,0,0,0,,{\i1}Mình đã cố tỏ ra lịch sự nhã nhặn rồi đấy nhé.{\i0}
Dialogue: 0,0:09:39.45,0:09:41.66,Default,,0,0,0,,{\i1}Hắn bộ muốn tự biến mình thành trò hề bẽ mặt trước bàn dân thiên hạ sao?{\i0}
Dialogue: 0,0:09:41.83,0:09:43.16,Default,,0,0,0,,{\i1}Nếu hắn đã tha thiết muốn ăn đòn đến thế...{\i0}
Dialogue: 0,0:09:43.33,0:09:44.45,Default,,0,0,0,,Rất tiếc cho anh,
Dialogue: 0,0:09:44.95,0:09:47.46,Default,,0,0,0,,chính tôi đang là người trực tiếp chỉ dạy cho tiểu thư Nia rồi,
Dialogue: 0,0:09:48.08,0:09:49.92,Default,,0,0,0,,tiểu thư không có nhu cầu tham gia câu lạc bộ này đâu.
Dialogue: 0,0:09:50.50,0:09:54.01,Default,,0,0,0,,Đó, như chú thấy đấy,\Ncháu đã có sư phụ riêng rồi.
Dialogue: 0,0:09:55.42,0:10:00.01,Default,,0,0,0,,Nghĩ ra rồi! Rinokis, em hãy chứng minh bản lĩnh của mình bằng một trận tỉ thí nhỏ đi!
Dialogue: 0,0:10:01.05,0:10:03.68,Default,,0,0,0,,Nếu chú chứng minh được\Nmình mạnh hơn sư phụ cháu,
Dialogue: 0,0:10:03.85,0:10:06.02,Default,,0,0,0,,thì cháu sẽ lập tức gia nhập câu lạc bộ của chú ngay.
Dialogue: 0,0:10:06.43,0:10:08.90,Default,,0,0,0,,Bởi vì cháu chỉ muốn bái người mạnh nhất làm thầy thôi!
Dialogue: 0,0:10:09.31,0:10:11.61,Default,,0,0,0,,Kìa em, chúng ta đâu thể tùy tiện giao đấu...
Dialogue: 0,0:10:11.98,0:10:13.27,Default,,0,0,0,,Tôi thì rất sẵn lòng đấy!
Dialogue: 0,0:10:13.44,0:10:17.11,Default,,0,0,0,,Trong giới võ học, kẻ yếu quy thuận kẻ mạnh vốn là lẽ tự nhiên.
Dialogue: 0,0:10:20.70,0:10:25.62,Default,,0,0,0,,Ta muốn xem sau một năm khổ luyện cùng ta,\Nem điều khiển "Khí" tiến bộ đến mức nào rồi.
Dialogue: 0,0:10:26.08,0:10:26.79,Default,,0,0,0,,Em đã rõ...
Dialogue: 0,0:10:26.96,0:10:30.50,Default,,0,0,0,,Nếu thắng trận này,\Nta sẽ dắt em đi ăn bất cứ món gì em thích!
Dialogue: 0,0:10:30.83,0:10:32.34,Default,,0,0,0,,Còn nếu chẳng may em thua thì sao ạ?
Dialogue: 0,0:10:32.92,0:10:37.01,Default,,0,0,0,,Thì em sẽ được tận hưởng một ngày huấn luyện địa ngục đúng gu sở thích của em!
Dialogue: 0,0:10:38.51,0:10:40.93,Default,,0,0,0,,Trời ơi, em không muốn nếm trải cơn ác mộng đó nữa đâu!
Dialogue: 0,0:10:41.09,0:10:43.14,Default,,0,0,0,,Nào, hãy làm tròn bổn phận của một đồ đệ đi.
Dialogue: 0,0:10:43.85,0:10:44.93,Default,,0,0,0,,Có chuyện gì thế kia?
Dialogue: 0,0:10:45.10,0:10:46.14,Default,,0,0,0,,Họ chuẩn bị quyết đấu kìa!
Dialogue: 0,0:10:46.98,0:10:51.35,Default,,0,0,0,,Thầy Gandolph với cô gái kia chuẩn bị giao đấu để tranh giành tân đệ tử đấy!
Dialogue: 0,0:10:51.77,0:10:54.52,Default,,0,0,0,,Cậu có chắc là cô hầu gái của cậu\Nsẽ trụ nổi không đấy?
Dialogue: 0,0:10:54.73,0:10:55.98,Default,,0,0,0,,Cậu không cần phải lo đâu.
Dialogue: 0,0:10:57.24,0:10:58.95,Default,,0,0,0,,Em ấy mạnh lắm đấy.
Dialogue: 0,0:10:59.11,0:11:00.36,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:11:14.71,0:11:15.21,Default,,0,0,0,,{\i1}Bắt đầu!{\i0}
Dialogue: 0,0:11:18.84,0:11:19.72,Default,,0,0,0,,Khá lắm.
Dialogue: 0,0:11:21.13,0:11:22.68,Default,,0,0,0,,Thầy... Thầy Gandolph?!
Dialogue: 0,0:11:22.97,0:11:23.72,Default,,0,0,0,,Sao có thể...
Dialogue: 0,0:11:25.14,0:11:26.10,Default,,0,0,0,,Em xử lý xong rồi ạ.
Dialogue: 0,0:11:26.26,0:11:28.31,Default,,0,0,0,,Ừ, em làm tốt lắm!
Dialogue: 0,0:11:30.60,0:11:35.23,Default,,0,0,0,,Em ấy vừa tung ra một cú đá roi cực hiểm\Nnhắm thẳng vào bắp đùi của hắn.
Dialogue: 0,0:11:35.48,0:11:40.11,Default,,0,0,0,,Nghe âm thanh va chạm thì rõ ràng tên kia\Nđã chủ quan thả lỏng cơ bắp, thế nên...
Dialogue: 0,0:11:46.41,0:11:48.91,Default,,0,0,0,,Được rồi, em xứng đáng được thưởng một bữa trưa thịnh soạn!
Dialogue: 0,0:11:49.08,0:11:50.75,Default,,0,0,0,,Em muốn ăn món gì nào, Rino?
Dialogue: 0,0:11:50.91,0:11:52.87,Default,,0,0,0,,Em muốn được ăn cơm do chính tay tiểu thư nấu ạ!
Dialogue: 0,0:11:53.04,0:11:54.58,Default,,0,0,0,,Thế thì chúng ta ra nhà hàng ăn vậy.
Dialogue: 0,0:11:55.00,0:11:56.71,Default,,0,0,0,,Không chịu đâu, tiểu thư nấu cho em cơ!
Dialogue: 0,0:11:56.88,0:11:58.21,Default,,0,0,0,,Ta hiểu rồi, ra quán ăn nhé.
Dialogue: 0,0:12:03.64,0:12:06.51,Default,,0,0,0,,CHÀO MỪNG ĐẾN VỚI HỌC VIỆN HOÀNG GIA ALTOIRE
Dialogue: 0,0:12:07.22,0:12:10.77,Default,,0,0,0,,{\i1}Xin nhiệt liệt chào đón các tân học viên!{\i0}
Dialogue: 0,0:12:11.18,0:12:14.02,Default,,0,0,0,,{\i1}Học viện hoàng gia Altoire vô cùng tự hào{\i0}
Dialogue: 0,0:12:14.44,0:12:16.82,Default,,0,0,0,,{\i1}khi được đón nhận và giáo dục thế hệ tương lai của đất nước,{\i0}
Dialogue: 0,0:12:16.98,0:12:20.53,Default,,0,0,0,,{\i1}không phân biệt bất kỳ giai cấp hay hoàn cảnh xuất thân nào...{\i0}
Dialogue: 0,0:12:23.36,0:12:26.70,Default,,0,0,0,,{\i1}Trước mắt các bạn là tòa nhà của khối tiểu học!{\i0}
Dialogue: 0,0:12:27.70,0:12:31.33,Default,,0,0,0,,{\i1}Phía trên là các dãy phòng học của cấp hai và cấp ba,{\i0}
Dialogue: 0,0:12:31.50,0:12:34.79,Default,,0,0,0,,{\i1}và tọa lạc trên đỉnh cao nhất chính là viện nghiên cứu chính trị học!{\i0}
Dialogue: 0,0:12:35.29,0:12:37.09,Default,,0,0,0,,{\i1}Nào, chúng ta cùng đi dạo một vòng nhé!{\i0}
Dialogue: 0,0:12:37.34,0:12:41.09,Default,,0,0,0,,{\i1}Đầu tiên là các lớp học dành cho học viên năm nhất.{\i0}
Dialogue: 0,0:12:41.92,0:12:43.01,Default,,0,0,0,,{\i1}Các bạn đang làm gì ở đây thế?{\i0}
Dialogue: 0,0:12:43.22,0:12:45.47,Default,,0,0,0,,{\i1}Bọn tớ đang quay chương trình truyền hình ma pháp đấy!{\i0}
Dialogue: 0,0:12:45.64,0:12:46.68,Default,,0,0,0,,{\i1}Xin chào mọi người!{\i0}
Dialogue: 0,0:12:47.22,0:12:48.30,Default,,0,0,0,,{\i1}Tránh ra cho tớ lên hình với!{\i0}
Dialogue: 0,0:12:48.60,0:12:50.06,Default,,0,0,0,,Trật tự nào, người ta đang quay phim đấy!
Dialogue: 0,0:12:50.72,0:12:53.10,Default,,0,0,0,,Thôi mà, cứ để cho các bạn ấy vui vẻ chút đi!
Dialogue: 0,0:12:53.27,0:12:54.73,Default,,0,0,0,,Hoan hô!
Dialogue: 0,0:12:58.15,0:12:59.07,Default,,0,0,0,,Sau đây,
Dialogue: 0,0:13:02.28,0:13:06.45,Default,,0,0,0,,ta xin chính thức khai mạc buổi họp đầu tiên\Nquảng bá truyền hình ma pháp!
Dialogue: 0,0:13:07.37,0:13:11.79,Default,,0,0,0,,{\an8}TẬP 5: BUỔI HỌP QUẢNG BÁ\NTRUYỀN HÌNH MA PHÁP
Dialogue: 0,0:13:11.95,0:13:15.29,Default,,0,0,0,,{\an8}NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:13:14.04,0:13:18.17,Default,,0,0,0,,{\an1}Trước hết, từ nay cả hai cậu\Nđều phải gọi ta là Hildetaura nhé.
Dialogue: 0,0:13:18.46,0:13:20.05,Default,,0,0,0,,Dẹp hết mấy cái phép tắc lễ nghi rườm rà đi!
Dialogue: 0,0:13:20.34,0:13:23.34,Default,,0,0,0,,Chúng thần làm sao dám mạo phạm\Ngọi thẳng tên người như thế được ạ!
Dialogue: 0,0:13:23.51,0:13:26.34,Default,,0,0,0,,Cậu ấy bảo là không muốn có bất kỳ rào cản nào giữa ba đứa mình cơ mà.
Dialogue: 0,0:13:26.51,0:13:27.97,Default,,0,0,0,,Đúng không nào, Hilde?
Dialogue: 0,0:13:28.18,0:13:29.39,Default,,0,0,0,,Chuẩn không cần chỉnh luôn!
Dialogue: 0,0:13:30.26,0:13:31.51,Default,,0,0,0,,Được rồi, nếu người đã nói vậy...
Dialogue: 0,0:13:31.93,0:13:34.56,Default,,0,0,0,,Về phần truyền hình ma pháp,
Dialogue: 0,0:13:35.06,0:13:38.61,Default,,0,0,0,,thú thật là tôi không rành lắm về mặt công nghệ ma pháp vận hành nó,
Dialogue: 0,0:13:39.06,0:13:41.48,Default,,0,0,0,,cũng như ngân sách dành cho dự án này.
Dialogue: 0,0:13:42.48,0:13:45.28,Default,,0,0,0,,Vốn dĩ màn hình máy truyền hình ma pháp
Dialogue: 0,0:13:45.53,0:13:48.66,Default,,0,0,0,,được chế tác\Ntừ một loại tinh thể pha lê tự nhiên cực kỳ quý hiếm,
Dialogue: 0,0:13:48.82,0:13:52.91,Default,,0,0,0,,nhưng nhờ tiến bộ ma pháp gần đây mà người ta đã có thể nhân tạo bằng ma lực.
Dialogue: 0,0:13:53.79,0:13:57.67,Default,,0,0,0,,Dẫu vậy thì chi phí sản xuất vẫn quá tốn kém,\Nkhiến giá thành màn hình đắt đỏ trên trời.
Dialogue: 0,0:13:58.46,0:14:01.42,Default,,0,0,0,,Với niềm tin tuyệt đối rằng truyền hình ma pháp\Nsẽ trở thành xu thế của thời đại,
Dialogue: 0,0:14:01.67,0:14:04.71,Default,,0,0,0,,quốc gia vẫn tiếp tục\Nrót những khoản tiền khổng lồ
Dialogue: 0,0:14:04.88,0:14:06.97,Default,,0,0,0,,vào việc nghiên cứu và phát triển.
Dialogue: 0,0:14:07.47,0:14:09.80,Default,,0,0,0,,Thực tế là vượt xa khả năng ngân sách cho phép.
Dialogue: 0,0:14:09.97,0:14:14.43,Default,,0,0,0,,Thế nên mới có đợt kêu gọi đầu tư\Nmà ban đầu chỉ duy nhất nhà Liston hưởng ứng.
Dialogue: 0,0:14:14.72,0:14:18.31,Default,,0,0,0,,Và gần đây, gia tộc Silver của cậu\Nrốt cuộc cũng đã tham gia vào dự án.
Dialogue: 0,0:14:18.48,0:14:19.98,Default,,0,0,0,,Tình hình hiện tại là như thế đấy.
Dialogue: 0,0:14:20.31,0:14:22.02,Default,,0,0,0,,Chúng ta không thể cắt giảm chi phí được sao?
Dialogue: 0,0:14:22.19,0:14:25.86,Default,,0,0,0,,Khó lòng mà phổ cập được một món đồ\Nmà người bình thường chẳng mấy ai kham nổi...
Dialogue: 0,0:14:26.40,0:14:28.28,Default,,0,0,0,,Đó chính là nút thắt nan giải nhất.
Dialogue: 0,0:14:28.45,0:14:31.12,Default,,0,0,0,,Mà này,\Nngười ta dùng loại ma pháp nào để chế tạo ra nó thế?
Dialogue: 0,0:14:31.49,0:14:35.37,Default,,0,0,0,,Đó là bí mật quốc gia\Ntối mật bậc nhất đấy.
Dialogue: 0,0:14:35.66,0:14:37.12,Default,,0,0,0,,Ngay cả ta cũng hoàn toàn mù tịt.
Dialogue: 0,0:14:38.16,0:14:39.42,Default,,0,0,0,,Đến cả cậu cũng không biết sao?
Dialogue: 0,0:14:42.84,0:14:43.84,Default,,0,0,0,,À mà nhắc mới nhớ!
Dialogue: 0,0:14:44.25,0:14:47.97,Default,,0,0,0,,Đài của nhà tôi chủ yếu phát sóng\Ncác chương trình mạo hiểm phiêu lưu...
Dialogue: 0,0:14:48.63,0:14:52.22,Default,,0,0,0,,{\i1}À đúng rồi, mình từng nghe nói qua.\NPhải tìm cơ hội xem ngay mới được!{\i0}
Dialogue: 0,0:14:53.10,0:14:56.47,Default,,0,0,0,,... và nghe đâu,\Nnhững chuyến thám hiểm đó hái ra rất nhiều tiền bạc.
Dialogue: 0,0:14:56.98,0:15:00.44,Default,,0,0,0,,Nghe bảo nếu vận may mỉm cười,\Nthì còn có thể đổi đời thành đại phú hộ nữa cơ.
Dialogue: 0,0:15:00.90,0:15:02.27,Default,,0,0,0,,{\i1}Hái ra tiền bạc ư?{\i0}
Dialogue: 0,0:15:02.56,0:15:07.36,Default,,0,0,0,,{\i1}Nếu kiếm được cả núi tiền\Nthì tha hồ mua bao nhiêu màn hình cũng được...{\i0}
Dialogue: 0,0:15:08.19,0:15:08.86,Default,,0,0,0,,Quyết định thế đi!
Dialogue: 0,0:15:09.28,0:15:10.11,Default,,0,0,0,,Chúng ta
Dialogue: 0,0:15:10.74,0:15:12.66,Default,,0,0,0,,cùng nhau đi săn ma thú kiếm tiền đê!
Dialogue: 0,0:15:14.66,0:15:15.70,Default,,0,0,0,,Nia này thật là!
Dialogue: 0,0:15:16.20,0:15:17.87,Default,,0,0,0,,Cậu hài hước ghê cơ!
Dialogue: 0,0:15:18.04,0:15:20.67,Default,,0,0,0,,Bớt giỡn lại đi\Nvà tập trung vắt óc suy nghĩ cùng bọn tớ nào!
Dialogue: 0,0:15:21.21,0:15:22.75,Default,,0,0,0,,{\i1}Ai thèm nói đùa chứ...{\i0}
Dialogue: 0,0:15:23.79,0:15:28.34,Default,,0,0,0,,Nhưng mặt khác, thu nhập của giới mạo hiểm giả\Nđâu có ổn định,
Dialogue: 0,0:15:28.51,0:15:31.68,Default,,0,0,0,,thế nên rất khó\Ntrông cậy hoàn toàn vào việc đó.
Dialogue: 0,0:15:34.05,0:15:35.64,Default,,0,0,0,,Tôi có thể góp ý một lời được không?
Dialogue: 0,0:15:36.14,0:15:37.39,Default,,0,0,0,,Đương nhiên rồi, em nói đi!
Dialogue: 0,0:15:37.93,0:15:42.02,Default,,0,0,0,,Thần từng nghe kể về một mạo hiểm giả\Nkiệt xuất đến mức
Dialogue: 0,0:15:42.19,0:15:46.94,Default,,0,0,0,,được một đại quý tộc thế lực tài trợ\Ntoàn bộ kinh phí hoạt động.
Dialogue: 0,0:15:47.36,0:15:48.11,Default,,0,0,0,,Vậy thì sao?
Dialogue: 0,0:15:48.28,0:15:49.65,Default,,0,0,0,,Thế thì chúng ta mau đi săn thôi!
Dialogue: 0,0:15:49.82,0:15:51.53,Default,,0,0,0,,Nghiêm túc chút đi nào!
Dialogue: 0,0:15:52.11,0:15:56.08,Default,,0,0,0,,Ý thần là, nếu tận dụng triệt để\Nnhững ưu thế của truyền hình ma pháp,
Dialogue: 0,0:15:56.24,0:16:00.41,Default,,0,0,0,,các tiểu thư hoàn toàn có thể gây quỹ tài trợ\Ncho các hoạt động của mình.
Dialogue: 0,0:16:00.96,0:16:01.96,Default,,0,0,0,,Hiểu rồi...
Dialogue: 0,0:16:02.12,0:16:06.50,Default,,0,0,0,,Ý cậu là nếu chúng ta phát sóng những\Nchương trình ăn khách mà ai ai cũng muốn xem,
Dialogue: 0,0:16:06.67,0:16:10.01,Default,,0,0,0,,thì sẽ thu hút được\Nvô số khoản tiền ủng hộ và quyên góp!
Dialogue: 0,0:16:12.05,0:16:15.55,Default,,0,0,0,,Vậy thì chúng mình phải sáng tạo ra\Nnhững tiết mục hấp dẫn hơn nữa...
Dialogue: 0,0:16:16.10,0:16:19.39,Default,,0,0,0,,Bọn mình có thể cải tiến nâng cấp\Nnhững chương trình sẵn có hiện tại!
Dialogue: 0,0:16:19.56,0:16:20.43,Default,,0,0,0,,Chẳng hạn như...
Dialogue: 0,0:16:22.81,0:16:24.23,Default,,0,0,0,,{\an8}HÀNH TRÌNH TẮM MÁU TẠI LISTON
Dialogue: 0,0:16:24.40,0:16:25.44,Default,,0,0,0,,Tuyệt đối không được!
Dialogue: 0,0:16:25.86,0:16:28.53,Default,,0,0,0,,Nghe có vẻ\Nhơi quá bạo lực máu me thì phải?
Dialogue: 0,0:16:28.69,0:16:30.44,Default,,0,0,0,,Thế à? Vậy đổi sang cái này thử xem...
Dialogue: 0,0:16:34.74,0:16:37.20,Default,,0,0,0,,{\an8}NIA LISTON KẺ HỦY DIỆT
Dialogue: 0,0:16:37.24,0:16:38.58,Default,,0,0,0,,Cũng chẳng khá hơn tí nào!
Dialogue: 0,0:16:38.91,0:16:41.91,Default,,0,0,0,,Làm ơn dẹp bớt mấy trò bạo lực sang một bên đi,\NNia à.
Dialogue: 0,0:16:42.08,0:16:45.54,Default,,0,0,0,,Nhưng ta chỉ muốn thấy cảnh tử chiến máu lửa\Ntrên truyền hình ma pháp thôi mà!
Dialogue: 0,0:16:45.71,0:16:50.09,Default,,0,0,0,,Cậu làm ơn nghĩ cái gì\Nmà đại đa số công chúng ai cũng thích xem đi chứ!
Dialogue: 0,0:16:53.76,0:16:55.47,Default,,0,0,0,,Tôi xin phép có ý kiến được không?
Dialogue: 0,0:16:56.72,0:16:58.47,Default,,0,0,0,,Thứ chúng ta cần nhất chính là Tình Yêu!
Dialogue: 0,0:16:58.72,0:16:59.64,Default,,0,0,0,,Tình yêu á?
Dialogue: 0,0:16:59.97,0:17:03.77,Default,,0,0,0,,Đó là chủ đề muôn thuở của nhân loại. Bất kỳ ai\Ncũng tò mò về chuyện tình ái đôi lứa.
Dialogue: 0,0:17:03.94,0:17:12.03,Default,,0,0,0,,{\an8}KHI NÀNG BIẾN THÀNH CHUỘT
Dialogue: 0,0:17:04.31,0:17:08.44,Default,,0,0,0,,Sở dĩ những câu chuyện ân oán tình thù\Ntrong lịch sử nhiều vô kể,
Dialogue: 0,0:17:08.61,0:17:12.03,Default,,0,0,0,,là bởi con người\Nluôn khao khát được gắn kết trong các mối quan hệ tình cảm.
Dialogue: 0,0:17:12.40,0:17:13.24,Default,,0,0,0,,Chuẩn luôn!
Dialogue: 0,0:17:13.70,0:17:15.03,Default,,0,0,0,,Nghe chán ngắt thấy mồ...
Dialogue: 0,0:17:15.20,0:17:17.53,Default,,0,0,0,,Không hề nhé, thể loại này cực kỳ ăn khách đấy!
Dialogue: 0,0:17:17.70,0:17:21.79,Default,,0,0,0,,Chẳng có gì làm ta ngứa mắt bằng\Nviệc nhìn mấy đứa người lớn sụt sùi khóc lóc.
Dialogue: 0,0:17:24.91,0:17:27.88,Default,,0,0,0,,Cậu chẳng hiểu gì cả,\Ntình yêu là thứ vô cùng phức tạp và sâu sắc!
Dialogue: 0,0:17:28.04,0:17:32.42,Default,,0,0,0,,Nó bắt đầu từ một đốm than hồng âm ỉ\Nrồi bùng cháy thành ngọn lửa đam mê rực rỡ!
Dialogue: 0,0:17:32.92,0:17:34.63,Default,,0,0,0,,Cô bé này mới tròn 8 tuổi đúng không nhỉ?
Dialogue: 0,0:17:34.80,0:17:36.38,Default,,0,0,0,,Và chưa từng có một mảnh tình vắt vai.
Dialogue: 0,0:17:36.55,0:17:37.68,Default,,0,0,0,,Mọi người đừng có mà trêu em chứ!
Dialogue: 0,0:17:38.43,0:17:42.39,Default,,0,0,0,,Đúng là những câu chuyện tình cảm\Nrất được lòng dân chúng.
Dialogue: 0,0:17:43.10,0:17:44.56,Default,,0,0,0,,Nhất là mấy vụ ân ái mây mưa giật gân ấy!
Dialogue: 0,0:17:45.48,0:17:47.06,Default,,0,0,0,,Sao cơ, "mây mưa" á?
Dialogue: 0,0:17:47.65,0:17:51.90,Default,,0,0,0,,Khoan đã nào,\Ncậu đang muốn nói tới mức độ trơ trẽn cỡ nào thế?
Dialogue: 0,0:17:52.86,0:17:53.86,Default,,0,0,0,,Người lớn cởi truồng hết à?
Dialogue: 0,0:17:54.03,0:17:54.94,Default,,0,0,0,,Cởi truồng hết á?
Dialogue: 0,0:17:55.11,0:17:57.32,Default,,0,0,0,,Hay là một đôi nam nữ ôm ấp sờ soạng nhau trên giường?
Dialogue: 0,0:17:57.49,0:17:58.57,Default,,0,0,0,,Trời đất ơi, cậu đang lảm nhảm cái gì thế hả?!
Dialogue: 0,0:17:59.16,0:18:01.03,Default,,0,0,0,,Chiếu mấy cái thứ đồi trụy đó lên truyền hình ma pháp,
Dialogue: 0,0:18:01.20,0:18:04.33,Default,,0,0,0,,thì có mà chuốc lấy cơn thịnh nộ lôi đình\Ncủa chính phụ hoàng ta!
Dialogue: 0,0:18:05.00,0:18:09.17,Default,,0,0,0,,Cậu giỏi thì hiến kế gì hay ho đi,\Nthay vì ngồi đó chê bai ý tưởng của tôi!
Dialogue: 0,0:18:09.58,0:18:10.29,Default,,0,0,0,,Tôi...
Dialogue: 0,0:18:11.09,0:18:12.00,Default,,0,0,0,,Cậu sao cơ?
Dialogue: 0,0:18:13.00,0:18:15.01,Default,,0,0,0,,Ta đã vắt óc suy nghĩ rất lâu
Dialogue: 0,0:18:15.22,0:18:18.09,Default,,0,0,0,,trước khi đến gặp mặt\Ncả hai cậu.
Dialogue: 0,0:18:19.51,0:18:23.60,Default,,0,0,0,,Thế nhưng ta chẳng thể nào nảy ra\Nđược một sáng kiến khả dĩ nào cả.
Dialogue: 0,0:18:24.43,0:18:27.31,Default,,0,0,0,,Bởi ngay cả những người lớn\Ncũng hoàn toàn bó tay bất lực!
Dialogue: 0,0:18:30.11,0:18:31.02,Default,,0,0,0,,Dẫu vậy,
Dialogue: 0,0:18:31.61,0:18:35.78,Default,,0,0,0,,ta từng hy vọng rằng cả ba chúng ta hợp lực\Nsẽ lóe lên tia sáng thiên tài nào đó!
Dialogue: 0,0:18:39.11,0:18:40.20,Default,,0,0,0,,Thế nhưng chứng kiến lúc này,
Dialogue: 0,0:18:41.03,0:18:43.58,Default,,0,0,0,,ta nhận ra bản thân đã lầm to rồi.
Dialogue: 0,0:18:44.95,0:18:46.58,Default,,0,0,0,,Điện hạ Hilde...
Dialogue: 0,0:18:51.38,0:18:53.84,Default,,0,0,0,,Ngồi đó ủ rũ\Nđâu giải quyết được vấn đề gì!
Dialogue: 0,0:18:54.92,0:18:59.22,Default,,0,0,0,,Điều cốt lõi bây giờ không phải là\Nđắn đo xem cái gì có ích nhất,
Dialogue: 0,0:18:59.47,0:19:01.97,Default,,0,0,0,,mà cứ việc\Ntung ra thật nhiều ý tưởng táo bạo vào!
Dialogue: 0,0:19:04.89,0:19:06.77,Default,,0,0,0,,Cậu ấy nói chí phải. Nào, cùng vắt óc suy nghĩ tiếp thôi!
Dialogue: 0,0:19:08.52,0:19:09.14,Default,,0,0,0,,Tuân lệnh ạ!
Dialogue: 0,0:19:18.53,0:19:22.91,Default,,0,0,0,,{\i1}Phải tìm ra ý tưởng mới được! Nhớ lại\Nnhững gì vừa diễn ra ở học viện xem nào...{\i0}
Dialogue: 0,0:19:33.63,0:19:34.42,Default,,0,0,0,,Nghĩ ra rồi à?
Dialogue: 0,0:19:35.00,0:19:39.17,Default,,0,0,0,,Nãy giờ bọn mình toàn tư duy dưới góc nhìn\Ncủa những nhà sản xuất chương trình,
Dialogue: 0,0:19:39.47,0:19:42.14,Default,,0,0,0,,nhưng hãy thử đặt mình\Nvào vị trí của chính khán giả xem sao!
Dialogue: 0,0:19:42.84,0:19:43.89,Default,,0,0,0,,Chẳng hạn như,
Dialogue: 0,0:19:45.14,0:19:47.35,Default,,0,0,0,,họ sẽ khao khát được trực tiếp tham gia vào chương trình như thế nào?
Dialogue: 0,0:19:49.31,0:19:51.02,Default,,0,0,0,,Trực tiếp tham gia ư?
Dialogue: 0,0:19:51.48,0:19:55.52,Default,,0,0,0,,Lúc ở cổng trường,\Nbao nhiêu học viên cứ tranh nhau chen lấn trước ống kính máy quay.
Dialogue: 0,0:19:55.90,0:19:59.82,Default,,0,0,0,,Đứa thì nhảy chồm lên trước mặt bọn mình,\Nđứa thì bám riết theo đuôi khắp nơi...
Dialogue: 0,0:20:00.45,0:20:02.57,Default,,0,0,0,,Điều đó chứng tỏ rằng
Dialogue: 0,0:20:02.91,0:20:06.49,Default,,0,0,0,,bản thân những đứa trẻ đó\Nđều muốn được "lên sóng truyền hình ma pháp".
Dialogue: 0,0:20:08.16,0:20:09.58,Default,,0,0,0,,Cậu tìm ra chìa khóa rồi!
Dialogue: 0,0:20:09.87,0:20:13.79,Default,,0,0,0,,Một khi người dân biết rằng họ có cơ hội\Nđược tự mình xuất hiện trên sóng truyền hình,
Dialogue: 0,0:20:13.96,0:20:16.59,Default,,0,0,0,,chắc chắn sự quan tâm dành cho\Ntruyền hình ma pháp sẽ bùng nổ vượt bậc!
Dialogue: 0,0:20:16.92,0:20:21.34,Default,,0,0,0,,Không chỉ dừng lại ở việc khiến họ muốn xem,\Nmà phải khơi dậy khao khát muốn được lên sóng!
Dialogue: 0,0:20:22.59,0:20:24.34,Default,,0,0,0,,Cảm ơn hai cậu triệu lần, Nia và Relia!
Dialogue: 0,0:20:24.80,0:20:27.56,Default,,0,0,0,,Ý tưởng này nhất định sẽ thành công vang dội cho mà xem!
Dialogue: 0,0:20:29.72,0:20:32.06,Default,,0,0,0,,Tôi vẫn không thể nào tin nổi
Dialogue: 0,0:20:32.31,0:20:34.02,Default,,0,0,0,,người lại phóng vụt đi như một cơn gió thế kia!
Dialogue: 0,0:20:34.31,0:20:35.48,Default,,0,0,0,,Này, Relia!
Dialogue: 0,0:20:36.61,0:20:40.74,Default,,0,0,0,,Ta vừa nghĩ ra một chương trình\Nmà bất cứ ai cũng sẽ khao khát được tham chiến!
Dialogue: 0,0:20:41.24,0:20:42.07,Default,,0,0,0,,Chương trình gì cơ?
Dialogue: 0,0:20:42.32,0:20:47.16,Default,,0,0,0,,Một giải đấu quy tụ toàn bộ những\Nchiến binh dũng mãnh nhất cùng so tài đọ sức,
Dialogue: 0,0:20:47.33,0:20:50.87,Default,,0,0,0,,còn khán giả thì thỏa sức đặt cược\Nxem ai sẽ là kẻ sống sót đăng quang!
Dialogue: 0,0:20:51.45,0:20:53.67,Default,,0,0,0,,Đúng là trong đầu cậu chẳng có gì ngoài đánh đấm cả!
Dialogue: 0,0:20:53.83,0:20:54.87,Default,,0,0,0,,Ý kiến tuyệt đỉnh đấy chứ?
Dialogue: 0,0:20:56.29,0:21:00.13,Default,,0,0,0,,Nhưng dạo gần đây,\Nchiếu mấy cảnh máu me be bét không được duyệt đâu đấy...
Dialogue: 0,0:21:01.55,0:21:04.38,Default,,0,0,0,,Rất nhiều khán giả gửi thư phàn nàn đấy thôi.
Dialogue: 0,0:21:05.22,0:21:07.64,Default,,0,0,0,,Bởi vì lượng máu đổ ra vẫn còn quá ít,\Nđúng không?
Dialogue: 0,0:21:07.80,0:21:11.52,Default,,0,0,0,,Một trận tử chiến thực thụ phải đẫm máu!\NVà chỉ khép lại khi có kẻ mất mạng!
Dialogue: 0,0:21:11.68,0:21:14.39,Default,,0,0,0,,Mấy cái suy nghĩ của cậu đáng sợ chết đi được, Nia!
Dialogue: 0,0:21:25.03,0:21:29.87,Default,,0,0,0,,Cú đá roi vừa nãy của em còn vụng về lắm,\Nnhưng bù lại em đã biết vận dụng "Khí" tương đối chuẩn xác.
Dialogue: 0,0:21:30.99,0:21:32.29,Default,,0,0,0,,Em cảm ơn tiểu thư rất nhiều ạ...
Dialogue: 0,0:21:32.62,0:21:36.17,Default,,0,0,0,,Em còn phải rèn luyện nhiều lắm,\Nnhưng cứ tiếp tục phát huy nhé!
Dialogue: 0,0:21:36.33,0:21:36.92,Default,,0,0,0,,Em rõ rồi ạ.
Dialogue: 0,0:21:37.42,0:21:41.92,Default,,0,0,0,,Em xin hứa sẽ trở nên thật mạnh mẽ\Nđể bảo vệ người...
Dialogue: 0,0:21:46.51,0:21:49.51,Default,,0,0,0,,Ta nghĩ\Ncái ngày đó còn xa vời vợi lắm...
Dialogue: 0,0:21:53.39,0:21:54.18,Default,,0,0,0,,Này, Nia,
Dialogue: 0,0:21:54.56,0:21:56.73,Default,,0,0,0,,cậu có nhận được tin tức gì từ điện hạ Hilde không?
Dialogue: 0,0:21:57.06,0:21:58.19,Default,,0,0,0,,Không, chẳng có tin gì cả.
Dialogue: 0,0:21:58.65,0:22:00.94,Default,,0,0,0,,Chắc hẳn người đang bận rộn hiện thực hóa dự án của chúng ta rồi...
Dialogue: 0,0:22:02.98,0:22:04.49,Default,,0,0,0,,Nia! Relia!
Dialogue: 0,0:22:04.65,0:22:08.91,Default,,0,0,0,,Dù hơi mất thời gian một chút,\Nnhưng rốt cuộc ta đã tìm ra một ý tưởng hoàn hảo nhất trần đời rồi!
Dialogue: 0,0:22:12.45,0:22:15.58,Default,,0,0,0,,Chúng ta hãy tổ chức một Đại hội Võ thuật\Nmở rộng cho toàn dân tham gia!
Dialogue: 0,0:22:17.17,0:22:19.17,Default,,0,0,0,,Đại hội Võ thuật sao?!
Dialogue: 0,0:22:29.30,0:22:32.64,Default,,0,0,0,,Nia Liston: Honoka Inoue\NRinokis Funk: Fuuka Izumi
Dialogue: 0,0:22:32.93,0:22:36.27,Default,,0,0,0,,{\an3}Hildetaura Altoire: Rina Honnizumi\NReliared Silver: Rina Hidaka
Dialogue: 0,0:22:36.56,0:22:39.90,Default,,0,0,0,,Esuella Blankett: Saeko Kamijo\NRirimi Silver: Ayaka Ohashi
Dialogue: 0,0:22:40.19,0:22:43.40,Default,,0,0,0,,Gandolf: Satoshi Hino
Dialogue: 0,0:23:32.70,0:23:35.62,Default,,0,0,0,,Phụ đề Việt ngữ: Amtia(NOFACE)
Dialogue: 0,0:23:47.26,0:23:49.84,Default,,0,0,0,,{\an8}Dịch thuật & Timer: Amtia(NOFACE)\NBiên tập & QC: Amtia(NOFACE)
Dialogue: 0,0:23:50.97,0:23:54.47,Default,,0,0,0,,{\i1}Tập tiếp theo:\N"Đại hội võ thuật".{\i0}
Dialogue: 0,0:23:51.26,0:23:54.85,Default,,0,0,0,,{\an8}TẬP TIẾP THEO:\NĐẠI HỘI VÕ THUẬT

