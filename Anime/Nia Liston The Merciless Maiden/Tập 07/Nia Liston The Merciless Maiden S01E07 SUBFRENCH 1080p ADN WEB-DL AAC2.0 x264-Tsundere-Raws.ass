Dialogue: 0,0:00:00.00,0:00:02.04,Default,,0,0,0,,Dựa trên nguyên tác của Minamino Umikaze
Dialogue: 0,0:00:07.54,0:00:08.84,Default,,0,0,0,,Thiết kế nhân vật gốc:\NCanata Katana, Jishaku
Dialogue: 0,0:00:18.85,0:00:21.39,Default,,0,0,0,,{\an8}NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:00:23.14,0:00:25.65,Default,,0,0,0,,{\an3}Thiết kế nhân vật:\NYuki Itou, Kana Tosaoka
Dialogue: 0,0:00:25.81,0:00:28.44,Default,,0,0,0,,{\an1}Biên kịch: Gigaemon Ichikawa
Dialogue: 0,0:00:29.32,0:00:31.99,Default,,0,0,0,,{\an8}Thiết kế màu sắc:\NRyota Katsuta, Maki Yamamoto
Dialogue: 0,0:00:32.15,0:00:33.07,Default,,0,0,0,,{\an3}Đạo diễn mỹ thuật: Hiroshi Gouroku
Dialogue: 0,0:00:33.24,0:00:34.11,Default,,0,0,0,,{\an1}Đạo diễn hình ảnh: Takashi Ooide
Dialogue: 0,0:00:43.87,0:00:47.17,Default,,0,0,0,,{\an1}Biên tập: Masayuki Kurosawa\NBối cảnh: Makaria
Dialogue: 0,0:01:01.35,0:01:03.18,Default,,0,0,0,,Bài hát mở đầu: "Respawn!!"\NTrình bày: Watame Tsunomaki
Dialogue: 0,0:01:10.40,0:01:11.36,Default,,0,0,0,,{\an1}Đạo diễn âm thanh: Hiromi Kikuta
Dialogue: 0,0:01:16.70,0:01:18.11,Default,,0,0,0,,Âm nhạc: Naoki Endou
Dialogue: 0,0:01:19.87,0:01:20.58,Default,,0,0,0,,{\an8}Studio hoạt hình: Konami Animation
Dialogue: 0,0:01:20.74,0:01:21.87,Default,,0,0,0,,{\an8}Trợ lý đạo diễn: Haruta Segi
Dialogue: 0,0:01:26.29,0:01:27.17,Default,,0,0,0,,Đạo diễn: Motoki Nakanishi
Dialogue: 0,0:01:27.33,0:01:29.83,Default,,0,0,0,,Ủy ban sản xuất:\NThe Merciless Maiden
Dialogue: 0,0:01:33.25,0:01:35.84,Default,,0,0,0,,{\an8}VÕ ĐƯỜNG THIÊN PHÁ
Dialogue: 0,0:01:34.26,0:01:37.47,Default,,0,0,0,,Thật hân hạnh được đón tiếp,\NSư phụ Nia!
Dialogue: 0,0:01:38.13,0:01:40.22,Default,,0,0,0,,- Đừng gọi thế nữa mà.\N- Rõ!
Dialogue: 0,0:01:40.89,0:01:45.73,Default,,0,0,0,,Trong mối quan hệ giới võ học,\Ntuổi tác đâu có nghĩa lý gì!
Dialogue: 0,0:01:46.27,0:01:48.23,Default,,0,0,0,,Thực lực mới là thước đo duy nhất!
Dialogue: 0,0:01:48.56,0:01:51.94,Default,,0,0,0,,Vậy nên tôi tha thiết\Nmuốn được gọi ngài là "Sư phụ"!
Dialogue: 0,0:01:52.57,0:01:54.23,Default,,0,0,0,,Tùy ông thôi, cơ mà...
Dialogue: 0,0:01:54.61,0:01:56.74,Default,,0,0,0,,Thật chứ ạ, Sư phụ Nia?
Dialogue: 0,0:01:57.40,0:01:59.99,Default,,0,0,0,,Ta nhắc ông nhớ rằng\Nông thuộc Võ đường Thiên Phá,
Dialogue: 0,0:02:00.28,0:02:03.87,Default,,0,0,0,,chẳng hề chung môn phái gì với ta đâu đấy.\NThế mà vẫn ổn à?
Dialogue: 0,0:02:05.70,0:02:07.12,Default,,0,0,0,,Tất nhiên là ổn rồi ạ...
Dialogue: 0,0:02:09.42,0:02:14.09,Default,,0,0,0,,Nói tóm lại, như đã hứa, hai ta sẽ vào đấu trường\Nngầm dưới danh nghĩa cha con.
Dialogue: 0,0:02:14.46,0:02:19.13,Default,,0,0,0,,Ông đóng vai cha ta cơ mà,\Nnên phải ăn nói cho tự nhiên chút đi.
Dialogue: 0,0:02:19.30,0:02:22.64,Default,,0,0,0,,Rõ!\NTôi sẽ cố gắng hết sức, thưa Sư phụ!
Dialogue: 0,0:02:23.51,0:02:24.64,Default,,0,0,0,,Ta đã bảo là nói chuyện bình thường cơ mà.
Dialogue: 0,0:02:26.35,0:02:30.10,Default,,0,0,0,,À phải rồi, tôi mới nắm được thêm tin tức\Nvề đấu trường đấy.
Dialogue: 0,0:02:30.40,0:02:32.94,Default,,0,0,0,,Sư phụ có biết về "Kiếm Quỷ" không ạ?
Dialogue: 0,0:02:33.15,0:02:36.82,Default,,0,0,0,,Chưa. Nghe danh hiệu thì đoán chừng\Nhắn là một bậc thầy kiếm thuật sao?
Dialogue: 0,0:02:37.11,0:02:41.41,Default,,0,0,0,,Vâng, đó là biệt danh của một\Nmạo hiểm giả kiếm sĩ lừng danh.
Dialogue: 0,0:02:42.95,0:02:45.29,Default,,0,0,0,,{\i1}Linh cảm lại sắp thất vọng nữa rồi đây.{\i0}
Dialogue: 0,0:02:45.62,0:02:49.91,Default,,0,0,0,,Hắn ta tạo dựng tên tuổi nhờ những\Nchiến tích kiếm thuật vang dội được giới võ công nhận.
Dialogue: 0,0:02:50.96,0:02:51.96,Default,,0,0,0,,{\i1}Hoặc biết đâu bất ngờ!{\i0}
Dialogue: 0,0:02:52.58,0:02:57.05,Default,,0,0,0,,Và nghe nói gã Kiếm Quỷ này\Ncũng sẽ góp mặt ở Đấu Trường Hắc Ám đấy ạ!
Dialogue: 0,0:02:57.34,0:03:00.13,Default,,0,0,0,,{\i1}Cuối cùng thứ ta chờ đợi\Nbấy lâu nay cũng tới rồi!{\i0}
Dialogue: 0,0:03:00.47,0:03:02.43,Default,,0,0,0,,Tốt, ta mong được gặp hắn lắm rồi đấy.
Dialogue: 0,0:03:02.97,0:03:05.93,Default,,0,0,0,,Tôi thật sự khó mà\Nhòa chung bầu không khí háo hức với sư phụ được...
Dialogue: 0,0:03:06.35,0:03:09.23,Default,,0,0,0,,Nghĩ tới chuyện dẫn theo một bé gái\Nvào chốn đó làm tôi lo thắt ruột...
Dialogue: 0,0:03:10.31,0:03:15.19,Default,,0,0,0,,Nhưng đã trót hứa với sư phụ rồi\Nthì hiển nhiên tôi phải giữ lời thôi!
Dialogue: 0,0:03:15.61,0:03:16.19,Default,,0,0,0,,Được.
Dialogue: 0,0:03:17.11,0:03:19.74,Default,,0,0,0,,Ta trông cậy vào ông đấy, ông bạn Gandolph!
Dialogue: 0,0:03:21.74,0:03:25.70,Default,,0,0,0,,Không biết sư phụ có rảnh chút thời gian\Nđể chỉ điểm một trận luyện tập không ạ?
Dialogue: 0,0:03:26.58,0:03:30.75,Default,,0,0,0,,Hiện giờ tâm trạng ta đang cực kỳ phấn chấn,\Nnên đồng ý luôn!
Dialogue: 0,0:03:30.96,0:03:31.83,Default,,0,0,0,,Nào, thủ thế đi!
Dialogue: 0,0:03:32.37,0:03:34.63,Default,,0,0,0,,Tuyệt vời! Đa tạ sư phụ muôn phần!
Dialogue: 0,0:03:38.55,0:03:41.80,Default,,0,0,0,,Xem ra ông vẫn cần tập phòng thủ\Ncho chắc tay hơn đấy nhé.
Dialogue: 0,0:03:43.64,0:03:45.35,Default,,0,0,0,,Vâng... thưa Sư phụ...
Dialogue: 0,0:03:46.30,0:03:50.10,Default,,0,0,0,,Hôm nay,\Nchúng ta sẽ học về các hòn đảo bay.
Dialogue: 0,0:03:50.27,0:04:00.36,Default,,0,0,0,,{\an8}{\i1}Vikeranda,\Ncon quái vật đã "chẻ đôi Trái Đất"{\i0}
Dialogue: 0,0:03:50.73,0:03:52.89,Default,,0,0,0,,Tương truyền rằng thuở ban sơ, thế giới này
Dialogue: 0,0:03:53.06,0:03:55.81,Default,,0,0,0,,vốn dĩ là một dải đất liền\Nrộng lớn bao la,
Dialogue: 0,0:03:55.98,0:04:00.36,Default,,0,0,0,,một lục địa duy nhất\Năn sâu vững chãi xuống tận đáy đại dương.
Dialogue: 0,0:04:00.78,0:04:02.86,Default,,0,0,0,,Thầy đang nói về một kỷ nguyên xa xưa cách đây...
Dialogue: 0,0:04:03.36,0:04:04.70,Default,,0,0,0,,Trông cậu cứ như đang sướng rơn lên ấy...
Dialogue: 0,0:04:07.74,0:04:08.99,Default,,0,0,0,,Mình á? Đâu có đâu chứ.
Dialogue: 0,0:04:14.54,0:04:16.13,Default,,0,0,0,,Ta về rồi đây, Rinokis.
Dialogue: 0,0:04:16.88,0:04:18.88,Default,,0,0,0,,Mừng tiểu thư đã trở về ạ!
Dialogue: 0,0:04:20.30,0:04:22.38,Default,,0,0,0,,Hoa này đẹp quá đi mất!
Dialogue: 0,0:04:26.01,0:04:29.10,Default,,0,0,0,,Tiểu thư có muốn dùng chút trà không ạ?
Dialogue: 0,0:04:29.26,0:04:31.39,Default,,0,0,0,,Không cần đâu, lát nữa hãy hay.
Dialogue: 0,0:04:36.77,0:04:40.03,Default,,0,0,0,,Dù đúng là ta không trực tiếp thượng đài\Ntại Đấu Trường Hắc Ám...
Dialogue: 0,0:04:45.82,0:04:48.95,Default,,0,0,0,,{\i1}nhưng ta cũng không thể\Ncho phép bản thân{\i0}
Dialogue: 0,0:04:49.12,0:04:53.41,Default,,0,0,0,,{\i1}bộc lộ dù chỉ một chút sơ hở\Ntrước mặt các đấu sĩ thực thụ.{\i0}
Dialogue: 0,0:04:53.79,0:04:56.67,Default,,0,0,0,,{\i1}Đó là luật bất thành văn\Ncủa giới võ học.{\i0}
Dialogue: 0,0:05:02.96,0:05:03.72,Default,,0,0,0,,Một!
Dialogue: 0,0:05:04.42,0:05:05.22,Default,,0,0,0,,Hai!
Dialogue: 0,0:05:06.34,0:05:08.18,Default,,0,0,0,,VÕ ĐƯỜNG THIÊN PHÁ
Dialogue: 0,0:05:11.01,0:05:12.22,Default,,0,0,0,,Mọi thứ chuẩn bị xong xuôi hết chưa?
Dialogue: 0,0:05:14.52,0:05:16.31,Default,,0,0,0,,Vâng, mọi thứ đã sẵn sàng rồi, thưa Sư phụ.
Dialogue: 0,0:05:17.81,0:05:18.52,Default,,0,0,0,,Thêm một đòn nữa!
Dialogue: 0,0:05:18.69,0:05:19.81,Default,,0,0,0,,{\i1}Cuối cùng cũng tới tối nay rồi!{\i0}
Dialogue: 0,0:05:20.94,0:05:25.32,Default,,0,0,0,,TẬP 7 :\NĐỘT NHẬP ĐẤU TRƯỜNG HẮC ÁM
Dialogue: 0,0:05:28.41,0:05:29.28,Default,,0,0,0,,{\i1}Cuối cùng!{\i0}
Dialogue: 0,0:05:29.45,0:05:31.08,Default,,0,0,0,,Cuối cùng cũng tới tối nay rồi!
Dialogue: 0,0:05:32.29,0:05:35.00,Default,,0,0,0,,Khoan đã,\Nđừng nói với tớ là cậu quên rồi nhé?
Dialogue: 0,0:05:35.29,0:05:38.12,Default,,0,0,0,,Tối nay người ta phát sóng chương trình\Nvề giải đấu đấy!
Dialogue: 0,0:05:38.42,0:05:41.34,Default,,0,0,0,,Mọi người ai nấy đều sẽ dán chặt mắt\Nvào truyền hình ma pháp hết đấy!
Dialogue: 0,0:05:44.42,0:05:47.38,Default,,0,0,0,,Tất cả các gia đình quý tộc có con cái\Nđang theo học tại học viện
Dialogue: 0,0:05:47.55,0:05:51.72,Default,,0,0,0,,đều được mời tới hoàng cung\Nđể cùng nhau theo dõi
Dialogue: 0,0:05:51.89,0:05:55.48,Default,,0,0,0,,chương trình phát sóng tối nay!\NThậm chí ở ký túc xá cũng có lắp đặt một chiếc nữa cơ!
Dialogue: 0,0:05:58.94,0:06:00.44,Default,,0,0,0,,Mong là tớ cũng được lên hình!
Dialogue: 0,0:06:00.61,0:06:02.23,Default,,0,0,0,,Tớ nóng lòng được thấy anh Neal quá đi!
Dialogue: 0,0:06:02.44,0:06:03.32,Default,,0,0,0,,Sắp bắt đầu rồi kìa!
Dialogue: 0,0:06:03.48,0:06:06.19,Default,,0,0,0,,Họ còn cho lắp đặt hẳn truyền hình ma pháp
Dialogue: 0,0:06:06.36,0:06:08.74,Default,,0,0,0,,chỉ riêng cho dịp trọng đại này đấy!
Dialogue: 0,0:06:09.16,0:06:11.95,Default,,0,0,0,,Các cháu ơi! Bánh kếp chín rồi đây!
Dialogue: 0,0:06:13.41,0:06:15.50,Default,,0,0,0,,- Cháu xin ạ!\N- Cháu nữa!
Dialogue: 0,0:06:15.66,0:06:16.75,Default,,0,0,0,,Đừng chen lấn chứ!
Dialogue: 0,0:06:16.91,0:06:20.00,Default,,0,0,0,,Đừng xô đẩy nhau,\Ncó đủ phần cho tất cả mọi người mà.
Dialogue: 0,0:06:20.75,0:06:23.13,Default,,0,0,0,,Chúng ta sẽ vừa ăn bánh vừa xem chương trình nhé!
Dialogue: 0,0:06:23.63,0:06:24.63,Default,,0,0,0,,{\i1}Ra vậy...{\i0}
Dialogue: 0,0:06:24.84,0:06:28.68,Default,,0,0,0,,{\i1}Mọi người đều muốn cùng nhau\Nchia sẻ sự hào hứng của sự kiện này.{\i0}
Dialogue: 0,0:06:29.43,0:06:31.39,Default,,0,0,0,,{\i1}Mình cũng hiểu tâm trạng đó, nhưng mà...{\i0}
Dialogue: 0,0:06:32.01,0:06:35.77,Default,,0,0,0,,{\i1}Hãy tiếp tục đón xem kênh của chúng tôi\Nđể theo dõi Đại hội Võ thuật lớn nhé!{\i0}
Dialogue: 0,0:06:37.73,0:06:39.77,Default,,0,0,0,,Ủa, sao tiểu thư lại ở đây vậy ạ?
Dialogue: 0,0:06:40.06,0:06:43.69,Default,,0,0,0,,Tiểu thư không xem chương trình\Ncùng các bạn sao ạ?
Dialogue: 0,0:06:44.02,0:06:47.03,Default,,0,0,0,,Không sao đâu, thế nào chẳng có chiếu lại.
Dialogue: 0,0:06:47.61,0:06:50.95,Default,,0,0,0,,Ta có mang chút quà nhỏ\Ntừ ký túc xá về cho em đây!
Dialogue: 0,0:06:52.37,0:06:57.20,Default,,0,0,0,,Tiểu thư cất công làm vậy vì em sao ạ?\NCảm ơn tiểu thư Nia nhiều lắm!
Dialogue: 0,0:06:57.37,0:06:58.79,Default,,0,0,0,,Thôi, ta đi ngủ đây!
Dialogue: 0,0:07:00.96,0:07:05.05,Default,,0,0,0,,Nhớ rưới thật đẫm xốt lên bánh kếp nhé,\Năn sẽ ngon hơn gấp bội đấy!
Dialogue: 0,0:07:05.55,0:07:06.25,Default,,0,0,0,,Vâng ạ!
Dialogue: 0,0:07:09.72,0:07:11.76,Default,,0,0,0,,ĐẠI HỘI VÕ THUẬT
Dialogue: 0,0:07:11.93,0:07:14.39,Default,,0,0,0,,{\i1}Cảm ơn quý vị đã kiên nhẫn chờ đợi!{\i0}
Dialogue: 0,0:07:14.72,0:07:19.18,Default,,0,0,0,,{\i1}Đại hội Võ thuật\Ncủa Học viện Altoire sắp chính thức bắt đầu!{\i0}
Dialogue: 0,0:07:21.44,0:07:26.07,Default,,0,0,0,,{\i1}Đây là dàn thí sinh góp mặt hôm nay!\NAi nấy đều trông cực kỳ sung sức.{\i0}
Dialogue: 0,0:07:26.73,0:07:29.74,Default,,0,0,0,,{\i1}Hãy khởi đầu với trận đấu đầu tiên\Ncủa hạng mục vũ khí!{\i0}
Dialogue: 0,0:07:26.78,0:07:28.82,Default,,0,0,0,,{\an8}VÒNG MỘT\NHẠNG MỤC VŨ KHÍ
Dialogue: 0,0:07:50.59,0:07:51.26,Default,,0,0,0,,{\i1}Bắt đầu nào!{\i0}
Dialogue: 0,0:07:51.93,0:07:54.09,Default,,0,0,0,,Nhìn kìa! Con trai tôi được lên truyền hình ma pháp rồi!
Dialogue: 0,0:08:00.02,0:08:02.44,Default,,0,0,0,,Mình vốn định xem cùng với Nia cơ mà...
Dialogue: 0,0:08:03.14,0:08:05.90,Default,,0,0,0,,Nhìn kìa, Relia! Tớ lên sóng truyền hình ma pháp rồi này!
Dialogue: 0,0:08:27.17,0:08:29.21,Default,,0,0,0,,Tiểu thư đi thật rồi sao...
Dialogue: 0,0:08:37.60,0:08:40.14,Default,,0,0,0,,Con bé này đúng là hết thuốc chữa thật mà.
Dialogue: 0,0:09:00.37,0:09:01.20,Default,,0,0,0,,Sư phụ Nia!
Dialogue: 0,0:09:01.54,0:09:02.54,Default,,0,0,0,,Mau đi thôi.
Dialogue: 0,0:09:07.33,0:09:09.67,Default,,0,0,0,,QUÁN RƯỢU CHUỘT XẢO QUYỆT
Dialogue: 0,0:09:09.84,0:09:12.17,Default,,0,0,0,,{\i1}Đóng cửa{\i0}
Dialogue: 0,0:09:13.21,0:09:15.93,Default,,0,0,0,,{\i1}Dù không định động tay động chân đâu, nhưng...{\i0}
Dialogue: 0,0:09:19.72,0:09:21.93,Default,,0,0,0,,cũng chẳng biết trước chuyện gì sẽ xảy ra!
Dialogue: 0,0:09:24.02,0:09:24.98,Default,,0,0,0,,Chật quá đi mất.
Dialogue: 0,0:09:25.35,0:09:27.40,Default,,0,0,0,,Dạo này tôi tăng cơ hơi quá đà rồi...
Dialogue: 0,0:09:27.85,0:09:28.94,Default,,0,0,0,,Bọn tôi tới rồi đây.
Dialogue: 0,0:09:30.07,0:09:31.94,Default,,0,0,0,,Tôi mang thứ cô dặn tới rồi đây.
Dialogue: 0,0:09:32.11,0:09:33.74,Default,,0,0,0,,Chào buổi tối nhé, Lily!
Dialogue: 0,0:09:34.74,0:09:37.95,Default,,0,0,0,,Trông anh có vẻ chật chội phết nhỉ.\NGiơ hai tay lên xem nào?
Dialogue: 0,0:09:39.41,0:09:40.74,Default,,0,0,0,,Không hợp với tôi à?
Dialogue: 0,0:09:40.91,0:09:42.45,Default,,0,0,0,,Coi như tạm chấp nhận được đi.
Dialogue: 0,0:09:42.91,0:09:47.21,Default,,0,0,0,,Hai người quen nhau à? Cũng phải thôi,\Ntính hai người hẳn là hợp cạ nhau lắm đấy.
Dialogue: 0,0:09:47.79,0:09:49.46,Default,,0,0,0,,Thôi, tôi xin phép đi trước đây!
Dialogue: 0,0:10:01.68,0:10:05.27,Default,,0,0,0,,Đây là thuốc ngụy trang\Ndành riêng cho giới quý tộc đấy.
Dialogue: 0,0:10:05.68,0:10:07.89,Default,,0,0,0,,Tất nhiên giá của nó đắt cắt cổ luôn.
Dialogue: 0,0:10:09.90,0:10:11.23,Default,,0,0,0,,Xong xuôi rồi đây!
Dialogue: 0,0:10:14.19,0:10:14.86,Default,,0,0,0,,Sao rồi?
Dialogue: 0,0:10:15.74,0:10:18.45,Default,,0,0,0,,- Trông em dễ thương xỉu luôn!\N- Hợp với ngài... à nhầm, rất đẹp!
Dialogue: 0,0:10:18.61,0:10:21.12,Default,,0,0,0,,Nhìn thế này trông em bình thường hẳn ra đấy.
Dialogue: 0,0:10:21.53,0:10:24.66,Default,,0,0,0,,Điều em quan tâm nhất là\Nxem mình hóa trang có kín kẽ không cơ!
Dialogue: 0,0:10:24.83,0:10:26.87,Default,,0,0,0,,Phải làm sao để chẳng ai nhận ra mới được...
Dialogue: 0,0:10:29.75,0:10:31.54,Default,,0,0,0,,Ổn áp ra phết đấy chứ!
Dialogue: 0,0:10:32.50,0:10:34.67,Default,,0,0,0,,Cơ mà em nhớ trả tiền lọ thuốc cho chị đấy.
Dialogue: 0,0:10:35.21,0:10:38.38,Default,,0,0,0,,Em sẽ trả lại cho chị ngay khi đủ tuổi\Nthượng đài ở đấu trường!
Dialogue: 0,0:10:42.30,0:10:43.64,Default,,0,0,0,,Tức là tận 15 năm nữa chứ gì.
Dialogue: 0,0:11:00.74,0:11:02.16,Default,,0,0,0,,Còn nhóc kia là ai thế?
Dialogue: 0,0:11:03.16,0:11:04.03,Default,,0,0,0,,Con gái của ông ấy ạ!
Dialogue: 0,0:11:05.62,0:11:08.16,Default,,0,0,0,,À ừ, đúng rồi! Đây là con giai... à nhầm!
Dialogue: 0,0:11:09.75,0:11:10.42,Default,,0,0,0,,Con gái tôi đấy!
Dialogue: 0,0:11:30.73,0:11:32.44,Default,,0,0,0,,- Xông lên đi!\N- Đổ máu đi nào!
Dialogue: 0,0:11:32.81,0:11:34.98,Default,,0,0,0,,{\i1}Thứ bạo lực nguyên sơ thuần khiết này...{\i0}
Dialogue: 0,0:11:35.82,0:11:39.49,Default,,0,0,0,,{\i1}Mùi hương ngọt ngào của oán hận,\Nthù hằn và chiến ý nồng nặc!{\i0}
Dialogue: 0,0:11:44.16,0:11:45.83,Default,,0,0,0,,{\an1}Quả thực không thể cưỡng lại nổi mà!
Dialogue: 0,0:11:45.70,0:11:47.79,Default,,0,0,0,,{\an8}NIA LISTON: THE MERCILESS MAIDEN
Dialogue: 0,0:11:47.95,0:11:50.16,Default,,0,0,0,,{\an1}NIA LISTON:\NTHE MERCILESS MAIDEN
Dialogue: 0,0:12:01.09,0:12:02.68,Default,,0,0,0,,Không khí náo nhiệt thật đấy!
Dialogue: 0,0:12:08.35,0:12:10.06,Default,,0,0,0,,Quý khách có muốn dùng chút rượu vang không ạ?
Dialogue: 0,0:12:12.31,0:12:13.31,Default,,0,0,0,,À, ờ... có chứ!
Dialogue: 0,0:12:14.02,0:12:17.07,Default,,0,0,0,,Còn một ly nước ép trái cây\Ncho vị tiểu thư nhỏ đây chứ?
Dialogue: 0,0:12:18.02,0:12:18.61,Default,,0,0,0,,Vâng ạ!
Dialogue: 0,0:12:20.69,0:12:23.20,Default,,0,0,0,,{\i1}Chào mừng quý ông quý bà đã đến với đấu trường!{\i0}
Dialogue: 0,0:12:23.91,0:12:28.33,Default,,0,0,0,,{\i1}Đêm nay, máu sẽ đổ, thịt sẽ nát\Nvà những sinh mạng sẽ vỡ vụn tan tành!{\i0}
Dialogue: 0,0:12:28.49,0:12:31.08,Default,,0,0,0,,{\i1}Quý vị sắp được chiêm ngưỡng\Nnhững trận tử chiến không chút khoan nhượng!{\i0}
Dialogue: 0,0:12:31.25,0:12:34.75,Default,,0,0,0,,{\i1}Vậy nên hãy thả lỏng tinh thần\Nvà tận hưởng màn trình diễn đi nào!{\i0}
Dialogue: 0,0:12:37.13,0:12:39.55,Default,,0,0,0,,{\i1}Chúng ta hãy bắt đầu ngay thôi!{\i0}
Dialogue: 0,0:12:39.75,0:12:41.88,Default,,0,0,0,,{\i1}Xin giới thiệu đấu sĩ đầu tiên!{\i0}
Dialogue: 0,0:12:44.13,0:12:47.93,Default,,0,0,0,,{\i1}Hồng Quyền Draijan!{\i0}
Dialogue: 0,0:12:48.10,0:12:49.85,Default,,0,0,0,,Lên đi, Draijan!
Dialogue: 0,0:12:50.47,0:12:52.85,Default,,0,0,0,,{\i1}Và đối đầu với anh ta là\Nchủ nhân của Thiết Cước Thần Tốc,{\i0}
Dialogue: 0,0:12:53.69,0:12:55.35,Default,,0,0,0,,{\i1}Woobie!{\i0}
Dialogue: 0,0:12:55.81,0:12:57.48,Default,,0,0,0,,Nghiền nát hắn đi, Woobie!
Dialogue: 0,0:12:57.65,0:12:58.77,Default,,0,0,0,,Đánh nhau đi nào!
Dialogue: 0,0:13:00.07,0:13:01.44,Default,,0,0,0,,Sư phụ định đặt cược vào ai vậy?
Dialogue: 0,0:13:03.24,0:13:03.90,Default,,0,0,0,,Để xem nào...
Dialogue: 0,0:13:04.53,0:13:05.86,Default,,0,0,0,,Trong hai gã này,
Dialogue: 0,0:13:07.24,0:13:11.20,Default,,0,0,0,,tên xăm trổ kia mạnh hơn hẳn đấy.\NÍt nhất là theo phán đoán của ta.
Dialogue: 0,0:13:11.41,0:13:13.46,Default,,0,0,0,,Vâng, nhưng mà bảo đặt tiền cược vào hắn thì...
Dialogue: 0,0:13:13.71,0:13:16.71,Default,,0,0,0,,Sao tự nhiên lại bày đặt rụt rè thế hả?
Dialogue: 0,0:13:16.92,0:13:19.79,Default,,0,0,0,,Đã mất công lặn lội tới tận đây rồi,\Nthì phải tận hưởng cho tới bến chứ!
Dialogue: 0,0:13:19.96,0:13:20.75,Default,,0,0,0,,Tôi cũng muốn lắm,
Dialogue: 0,0:13:21.21,0:13:23.55,Default,,0,0,0,,nhưng khổ nỗi tôi làm gì có tiền đâu.
Dialogue: 0,0:13:23.72,0:13:26.76,Default,,0,0,0,,Mà lỡ thua sạch thì tôi chỉ còn nước\Nhúp cháo trắng cầm hơi mất.
Dialogue: 0,0:13:28.22,0:13:31.14,Default,,0,0,0,,Ý ông là\Nông không tin tưởng mắt nhìn người của ta à?
Dialogue: 0,0:13:31.77,0:13:33.14,Default,,0,0,0,,Tôi đặt tất tay vào Draijan!
Dialogue: 0,0:13:33.31,0:13:34.85,Default,,0,0,0,,Đã ghi nhận kèo cược!
Dialogue: 0,0:13:35.06,0:13:38.02,Default,,0,0,0,,{\i1}Và giờ, trận đấu xin được phép bắt đầu!{\i0}
Dialogue: 0,0:14:07.18,0:14:10.39,Default,,0,0,0,,Sư phụ Nia ơi,\Nmồ hôi tôi vã ra như tắm rồi này...
Dialogue: 0,0:14:10.80,0:14:12.76,Default,,0,0,0,,Thôi đi, ưỡn ngực lên xem nào.
Dialogue: 0,0:14:13.06,0:14:14.43,Default,,0,0,0,,Thì biết thế, nhưng mà...
Dialogue: 0,0:14:15.27,0:14:17.77,Default,,0,0,0,,Cả đời tôi chưa từng cầm trên tay\Nsố tiền khổng lồ thế này bao giờ!
Dialogue: 0,0:14:17.94,0:14:19.56,Default,,0,0,0,,Chắc chúng ta không thể chơi tiếp mãi đâu...
Dialogue: 0,0:14:20.23,0:14:23.82,Default,,0,0,0,,Thế à? Ta còn định bảo\Nsố tiền đó sẽ là tiền công cho ông đấy chứ!
Dialogue: 0,0:14:24.36,0:14:27.99,Default,,0,0,0,,Quý khách thực sự muốn dừng lại\Ntrước trận tâm điểm tối nay sao?
Dialogue: 0,0:14:28.15,0:14:30.28,Default,,0,0,0,,Vâng, tôi không cược nữa đâu, cảm ơn.
Dialogue: 0,0:14:35.95,0:14:37.00,Default,,0,0,0,,Ôi trời ơi!
Dialogue: 0,0:14:37.50,0:14:41.13,Default,,0,0,0,,Chị cầm lấy chỗ này nhé,\Ntrả tiền rượu và nước ép trái cây lúc nãy đấy.
Dialogue: 0,0:14:41.29,0:14:43.42,Default,,0,0,0,,Tôi xin nhận với cả tấm lòng, cảm ơn nhiều nhé!
Dialogue: 0,0:14:45.71,0:14:47.17,Default,,0,0,0,,Sao sư phụ lại rộng rãi thế ạ?
Dialogue: 0,0:14:47.34,0:14:51.97,Default,,0,0,0,,Khi thắng đậm như vậy thì phải\Nbiết chia lộc một chút để đỡ rước phiền phức.
Dialogue: 0,0:14:52.39,0:14:55.77,Default,,0,0,0,,Nhất là đối với những tay mơ mới vào nghề\Nnhư hai ta.
Dialogue: 0,0:14:56.93,0:14:59.39,Default,,0,0,0,,Với lại, cô ấy cũng khá dễ mến đấy chứ.
Dialogue: 0,0:15:00.31,0:15:01.48,Default,,0,0,0,,Tôi hiểu rồi!
Dialogue: 0,0:15:02.11,0:15:05.15,Default,,0,0,0,,Và giờ thì,\Nhãy tập trung theo dõi trận đấu tiếp theo nào.
Dialogue: 0,0:15:05.40,0:15:05.98,Default,,0,0,0,,Rõ!
Dialogue: 0,0:15:06.57,0:15:09.70,Default,,0,0,0,,{\i1}Sức nóng tại đấu trường\Nbắt đầu tăng vọt rồi đây!{\i0}
Dialogue: 0,0:15:09.86,0:15:11.78,Default,,0,0,0,,{\i1}Và sau đây là trận đấu tiếp theo!{\i0}
Dialogue: 0,0:15:15.70,0:15:16.91,Default,,0,0,0,,Là con gái kìa!
Dialogue: 0,0:15:17.08,0:15:18.91,Default,,0,0,0,,Lột đồ ra đê!
Dialogue: 0,0:15:25.63,0:15:26.59,Default,,0,0,0,,Cô gái kia...
Dialogue: 0,0:15:26.96,0:15:31.72,Default,,0,0,0,,{\i1}Xin giới thiệu một tân binh vừa gia nhập!\NNữ chiến binh bí ẩn Miss Servant!{\i0}
Dialogue: 0,0:15:31.89,0:15:35.31,Default,,0,0,0,,{\i1}Liệu cô ấy có sống sót nổi\Ntrong đấu trường tàn khốc này hay không?!{\i0}
Dialogue: 0,0:15:35.97,0:15:38.60,Default,,0,0,0,,{\i1}Hào quang quanh cô gái này\Ntràn ngập {\i0}Khí{\i1}!{\i0}
Dialogue: 0,0:15:39.14,0:15:41.90,Default,,0,0,0,,{\i1}Xem chừng cô ta mới chỉ học được cách\Nđiều khiển gần đây thôi, nhưng mà...{\i0}
Dialogue: 0,0:15:42.52,0:15:44.15,Default,,0,0,0,,Cũng đầy triển vọng đấy chứ!
Dialogue: 0,0:15:45.40,0:15:46.52,Default,,0,0,0,,Ờm, Sư phụ Nia ơi?
Dialogue: 0,0:15:46.69,0:15:48.65,Default,,0,0,0,,Mong sao đối thủ của cô ấy thật mạnh vào!
Dialogue: 0,0:15:48.82,0:15:49.69,Default,,0,0,0,,{\i1}Và đứng ở phía đối diện,{\i0}
Dialogue: 0,0:15:50.32,0:15:53.49,Default,,0,0,0,,{\i1}Nữ Phù Thủy Bóng Đêm, Scarlet!{\i0}
Dialogue: 0,0:15:53.66,0:15:57.54,Default,,0,0,0,,{\i1}Ngọn roi của cô ta lại một lần nữa\Nsẵn sàng tưới đẫm máu tươi lên sàn đấu!{\i0}
Dialogue: 0,0:15:57.70,0:15:59.16,Default,,0,0,0,,Lại đây quất anh đi em ơi!
Dialogue: 0,0:15:59.79,0:16:03.88,Default,,0,0,0,,{\i1}Lại thêm một vai phụ nữa rồi. Chắc chắn\Nchẳng trụ nổi quá vài hơi đâu mà.{\i0}
Dialogue: 0,0:16:04.63,0:16:06.34,Default,,0,0,0,,Cô gái đeo mặt nạ sẽ thắng.
Dialogue: 0,0:16:06.50,0:16:09.88,Default,,0,0,0,,Sư phụ Nia...\NSư phụ nói thật đấy chứ ạ?
Dialogue: 0,0:16:10.47,0:16:13.43,Default,,0,0,0,,Sao thế? Ông nhìn kỹ hai người họ đi!
Dialogue: 0,0:16:13.59,0:16:15.22,Default,,0,0,0,,Trận này sẽ kết thúc chỉ trong nháy mắt thôi.
Dialogue: 0,0:16:15.72,0:16:18.10,Default,,0,0,0,,Không, ý tôi là...
Dialogue: 0,0:16:18.85,0:16:23.14,Default,,0,0,0,,Có lẽ do tôi nhìn nhầm thôi,\NSư phụ Nia à, nhưng mà...
Dialogue: 0,0:16:23.56,0:16:25.15,Default,,0,0,0,,Có gì thì nói toạc ra đi!
Dialogue: 0,0:16:25.31,0:16:27.44,Default,,0,0,0,,Phải giải thích sao cho sư phụ hiểu nhỉ...
Dialogue: 0,0:16:27.61,0:16:28.23,Default,,0,0,0,,{\i1}Nào,{\i0}
Dialogue: 0,0:16:28.48,0:16:30.49,Default,,0,0,0,,{\i1}trận đấu bắt đầu!{\i0}
Dialogue: 0,0:16:32.07,0:16:34.61,Default,,0,0,0,,Chẳng lẽ... đó chính là cô hầu gái nhà ngài sao?
Dialogue: 0,0:16:39.95,0:16:44.54,Default,,0,0,0,,{\i1}Scarlet bị thổi bay thẳng vào vách tường\Nchỉ bằng đúng một cú đấm!{\i0}
Dialogue: 0,0:16:45.13,0:16:46.75,Default,,0,0,0,,{\i1}Chuyện không thể tin nổi!{\i0}
Dialogue: 0,0:16:47.13,0:16:48.09,Default,,0,0,0,,{\i1}Thật là...{\i0}
Dialogue: 0,0:16:48.80,0:16:51.76,Default,,0,0,0,,{\i1}Phần thắng thuộc về Miss Servant!{\i0}
Dialogue: 0,0:16:54.47,0:16:55.55,Default,,0,0,0,,Đích thị là Rinokis rồi!
Dialogue: 0,0:17:07.94,0:17:12.53,Default,,0,0,0,,Thật không thể tin nổi em ấy dám tới đây\Ndù ta đã cấm tiệt rồi cơ mà!
Dialogue: 0,0:17:14.20,0:17:16.70,Default,,0,0,0,,Ngươi cũng khá đấy chứ, lính mới!
Dialogue: 0,0:17:17.57,0:17:19.03,Default,,0,0,0,,Này, tai ngươi điếc khi người ta...
Dialogue: 0,0:17:19.53,0:17:21.54,Default,,0,0,0,,Đừng có mở miệng nói chuyện với ta.
Dialogue: 0,0:17:36.30,0:17:38.68,Default,,0,0,0,,Rốt cuộc em ấy tới đây làm cái gì vậy?
Dialogue: 0,0:17:38.85,0:17:41.01,Default,,0,0,0,,Tôi chỉ nghĩ ra được một lý do duy nhất thôi...
Dialogue: 0,0:17:44.10,0:17:47.06,Default,,0,0,0,,Em ấy muốn thử sức với kẻ\Nmạnh hơn cả ta sao?
Dialogue: 0,0:17:47.31,0:17:47.98,Default,,0,0,0,,Không phải đâu ạ.
Dialogue: 0,0:17:48.65,0:17:50.32,Default,,0,0,0,,Cô ấy muốn bảo vệ ngài đấy.
Dialogue: 0,0:17:51.65,0:17:53.44,Default,,0,0,0,,Trong khi ta còn mạnh hơn cả em ấy ư?
Dialogue: 0,0:17:53.61,0:17:55.82,Default,,0,0,0,,Vấn đề không nằm ở chỗ đó...
Dialogue: 0,0:17:57.82,0:17:59.07,Default,,0,0,0,,{\i1}Ra vậy...{\i0}
Dialogue: 0,0:18:00.33,0:18:03.79,Default,,0,0,0,,{\i1}Rinokis từ trước tới nay luôn một lòng\Ntận tụy phụng sự gia tộc ta.{\i0}
Dialogue: 0,0:18:04.33,0:18:08.96,Default,,0,0,0,,{\i1}Vậy ra em ấy lén trà trộn vào hàng ngũ\Nđấu sĩ chỉ để bảo vệ ta sao?{\i0}
Dialogue: 0,0:18:10.59,0:18:14.30,Default,,0,0,0,,Không ngờ em ấy lại\Nnhiệt huyết tới mức đó luôn đấy!
Dialogue: 0,0:18:14.46,0:18:16.34,Default,,0,0,0,,Nhưng nếu cứ đà này, cô ấy rất có nguy cơ
Dialogue: 0,0:18:16.88,0:18:18.97,Default,,0,0,0,,phải đối đầu trực diện với tên Kiếm Quỷ mất.
Dialogue: 0,0:18:23.64,0:18:25.73,Default,,0,0,0,,{\i1}Nếu thật thế thì ta ghen tị phát điên mất!{\i0}
Dialogue: 0,0:18:26.43,0:18:30.31,Default,,0,0,0,,{\i1}Và cuối cùng nhân vật mà tất cả quý vị\Nđều mong ngóng cũng đã xuất hiện!{\i0}
Dialogue: 0,0:18:30.48,0:18:32.61,Default,,0,0,0,,{\i1}Kẻ không một hầm ngục nào cản nổi bước chân,{\i0}
Dialogue: 0,0:18:33.23,0:18:36.19,Default,,0,0,0,,{\i1}bậc thầy đủ sức một mình đánh gục cả Golem,{\i0}
Dialogue: 0,0:18:36.36,0:18:38.82,Default,,0,0,0,,{\i1}nhà mạo hiểm giả mang biệt danh\NKiếm Quỷ,{\i0}
Dialogue: 0,0:18:39.03,0:18:42.33,Default,,0,0,0,,{\i1}Asuma Hinoki!{\i0}
Dialogue: 0,0:18:42.49,0:18:44.62,Default,,0,0,0,,- Hóa ra là hắn à?\N- Tiến lên, Hinoki!
Dialogue: 0,0:18:47.25,0:18:49.42,Default,,0,0,0,,Chà, ta ghét cay ghét đắng hạng chiến binh kiểu này.
Dialogue: 0,0:18:51.29,0:18:52.96,Default,,0,0,0,,Hắn ta mang theo ma kiếm bên mình.
Dialogue: 0,0:18:53.13,0:18:54.00,Default,,0,0,0,,Mang theo cái gì cơ ạ?
Dialogue: 0,0:18:54.38,0:18:58.17,Default,,0,0,0,,Những thanh kiếm bị nguyền rủa, chuyên đoạt lấy\Ný chí của người sử dụng
Dialogue: 0,0:18:59.22,0:19:03.64,Default,,0,0,0,,và có thể khiến chủ nhân đánh mất hoàn toàn\Nmọi lý trí lẫn chuẩn mực đạo đức.
Dialogue: 0,0:19:03.81,0:19:06.02,Default,,0,0,0,,Ý sư phụ là hắn có thể...
Dialogue: 0,0:19:06.18,0:19:07.02,Default,,0,0,0,,Sát hại người khác
Dialogue: 0,0:19:07.68,0:19:09.77,Default,,0,0,0,,mà không hề chớp mắt dù chỉ một giây.
Dialogue: 0,0:19:10.73,0:19:11.44,Default,,0,0,0,,{\i1}Ta kiên quyết từ chối{\i0}
Dialogue: 0,0:19:11.81,0:19:16.32,Default,,0,0,0,,{\i1}hạ thấp võ đạo xuống ngang hàng\Nvới thứ bạo lực giết chóc tầm thường.{\i0}
Dialogue: 0,0:19:17.74,0:19:20.66,Default,,0,0,0,,{\i1}Lý trí, sự kiểm soát, niềm tin, hoài bão.{\i0}
Dialogue: 0,0:19:20.99,0:19:24.70,Default,,0,0,0,,{\i1}Một môn võ học đích thực bắt buộc\Nphải hội tụ đủ tất cả những yếu tố ấy.{\i0}
Dialogue: 0,0:19:26.12,0:19:29.04,Default,,0,0,0,,{\i1}Nó tuyệt đối không thể chỉ đơn thuần\Nlà bạo lực vô nghĩa được.{\i0}
Dialogue: 0,0:19:29.91,0:19:33.25,Default,,0,0,0,,{\i1}Nhưng dẫu sao những thanh kiếm ấy vẫn thuộc\Nhàng bảo vật cấp huyền thoại.{\i0}
Dialogue: 0,0:19:33.50,0:19:36.38,Default,,0,0,0,,{\i1}Ta cũng hiểu được phần nào ham muốn\Nđược sở hữu một thanh như thế.{\i0}
Dialogue: 0,0:19:36.92,0:19:41.34,Default,,0,0,0,,{\i1}Nếu gã Kiếm Quỷ kia có đủ ý chí\Nđể chế ngự cặp ma kiếm của mình thì...{\i0}
Dialogue: 0,0:19:43.93,0:19:48.68,Default,,0,0,0,,{\i1}Và thế là, Kiếm Quỷ đã chính thức\Ngiành chiến thắng thứ sáu liên tiếp!{\i0}
Dialogue: 0,0:19:52.02,0:19:53.19,Default,,0,0,0,,Tuyệt đỉnh!
Dialogue: 0,0:19:53.36,0:19:54.69,Default,,0,0,0,,Cho xem tiếp nữa đi!
Dialogue: 0,0:19:56.36,0:19:57.69,Default,,0,0,0,,Nhanh kinh khủng khiếp!
Dialogue: 0,0:19:58.11,0:19:59.24,Default,,0,0,0,,Thảm hại quá đi!
Dialogue: 0,0:19:59.40,0:20:01.70,Default,,0,0,0,,Trả tiền lại cho bố mày đây!
Dialogue: 0,0:20:02.16,0:20:04.12,Default,,0,0,0,,{\i1}Đối thủ của hắn quá yếu ớt.{\i0}
Dialogue: 0,0:20:04.53,0:20:07.04,Default,,0,0,0,,{\i1}Đánh kiểu này thì sao ta nhìn thấu được{\i0}
Dialogue: 0,0:20:07.20,0:20:09.95,Default,,0,0,0,,{\i1}bản lĩnh thực sự của\Ngã Kiếm Quỷ này đây!{\i0}
Dialogue: 0,0:20:12.79,0:20:15.34,Default,,0,0,0,,{\i1}Không, ta đâu chỉ muốn đứng nhìn,{\i0}
Dialogue: 0,0:20:15.50,0:20:19.42,Default,,0,0,0,,{\i1}ta muốn tự mình dùng đôi tay này\Nkiểm chứng sức mạnh của hắn lẫn cặp ma kiếm kia!{\i0}
Dialogue: 0,0:20:19.84,0:20:22.59,Default,,0,0,0,,- Đánh tiếp đê!\N- Tổ chức thêm trận nữa đi!
Dialogue: 0,0:20:22.97,0:20:24.30,Default,,0,0,0,,Im lặng!
Dialogue: 0,0:20:24.64,0:20:25.85,Default,,0,0,0,,Câm miệng hết lại!
Dialogue: 0,0:20:26.85,0:20:30.31,Default,,0,0,0,,Ta muốn giao đấu với Miss Servant!
Dialogue: 0,0:20:31.56,0:20:32.39,Default,,0,0,0,,{\i1}Rinokis!{\i0}
Dialogue: 0,0:20:42.36,0:20:45.62,Default,,0,0,0,,Miss Servant!\NMiss Servant! Miss Servant!
Dialogue: 0,0:20:46.03,0:20:49.54,Default,,0,0,0,,{\i1}Ước gì khán giả cũng hò reo\Ntên ta như vậy nhỉ...{\i0}
Dialogue: 0,0:20:50.33,0:20:54.04,Default,,0,0,0,,{\i1}Xin mời Miss Servant bước ra sàn đấu!{\i0}
Dialogue: 0,0:20:57.00,0:20:59.50,Default,,0,0,0,,Liệu cô ấy có vượt qua nổi không ạ?
Dialogue: 0,0:21:01.05,0:21:04.80,Default,,0,0,0,,{\i1}Xét theo trình độ của em ấy,\Nta thấy em ấy hoàn toàn có thể thắng, nhưng...{\i0}
Dialogue: 0,0:21:05.30,0:21:06.26,Default,,0,0,0,,{\i1}Hãy chờ xem sao!{\i0}
Dialogue: 0,0:21:09.68,0:21:11.81,Default,,0,0,0,,Số cô đúng là xui tận mạng rồi.
Dialogue: 0,0:21:22.24,0:21:24.40,Default,,0,0,0,,{\i1}Nào, trận đấu...{\i0}
Dialogue: 0,0:21:25.16,0:21:25.91,Default,,0,0,0,,{\i1}xin bắt đầu!{\i0}
Dialogue: 0,0:21:55.56,0:21:57.94,Default,,0,0,0,,- Xông lên!\N- Khử ả ta đi!
Dialogue: 0,0:22:08.03,0:22:08.91,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:22:16.46,0:22:17.92,Default,,0,0,0,,Khá lắm, ta khen ngươi đấy!
Dialogue: 0,0:22:29.26,0:22:32.60,Default,,0,0,0,,Nia Liston: Honoka Inoue\NNeal Liston: Tomoyo Takayanagi
Dialogue: 0,0:22:32.89,0:22:36.23,Default,,0,0,0,,{\an3}Rinokis Funk: Fuuka Izumi
Dialogue: 0,0:22:36.52,0:22:39.85,Default,,0,0,0,,{\an3}Hildetaura Altoire: Rina Honnizumi\NReliared Silver: Rina Hidaka
Dialogue: 0,0:22:40.15,0:22:43.36,Default,,0,0,0,,Anzel: Taku Yashiro\NFressa: Yoko Hikasa
