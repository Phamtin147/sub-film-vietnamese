Dialogue: 0,0:00:02.31,0:00:04.65,main,ASTA,0,0,0,,Anh Magna!
Dialogue: 0,0:00:05.09,0:00:06.56,main,MAGNA,0,0,0,,Asta... Luck...
Dialogue: 0,0:00:11.71,0:00:13.30,main,ASTA,0,0,0,,Cả em với đội trưởng Yami
Dialogue: 0,0:00:13.30,0:00:16.28,main,ASTA,0,0,0,,hợp sức mãi mới cầm cự được với hắn, thế mà...
Dialogue: 0,0:00:16.81,0:00:19.79,main,ASTA,0,0,0,,Anh đỉnh thật đấy, anh Magna!
Dialogue: 0,0:00:21.32,0:00:22.62,main,MAGNA,0,0,0,,Đương nhiên rồi!
Dialogue: 0,0:00:22.62,0:00:24.47,main,MAGNA,0,0,0,,Đừng có coi thường đàn anh này chứ!
Dialogue: 0,0:00:24.47,0:00:27.15,main,ASTA,0,0,0,,Tuyệt quá đi mất! Đúng là đấng nam nhi đại trượng phu!
Dialogue: 0,0:00:27.73,0:00:28.75,main,LUCK,0,0,0,,Anh Magna!
Dialogue: 0,0:00:30.12,0:00:33.51,main,LUCK,0,0,0,,Em nóng lòng muốn đấu một trận \Nvới anh ghê!
Dialogue: 0,0:00:35.01,0:00:37.76,main,MAGNA,0,0,0,,Và tao sẽ dần cho chú mày một trận ra bã đấy, Luck.
Dialogue: 0,0:00:40.26,0:00:42.29,italics,JACK (INT),0,0,0,,Bố mày là thường dân...
Dialogue: 0,0:00:42.72,0:00:46.01,italics,JACK (INT),0,0,0,,Và dù là thường dân, bố mày vẫn dùng \Nsức mạnh này để leo lên chức Đoàn trưởng.
Dialogue: 0,0:00:46.01,0:00:49.02,italics,JACK (INT),0,0,0,,Bố mày có chết cũng không để lũ quý tộc hay hoàng tộc đè đầu cưỡi cổ.
Dialogue: 0,0:00:49.29,0:00:52.57,italics,JACK (INT),0,0,0,,Bố mày luôn chủ động chiêu mộ thường dân vào đoàn.
Dialogue: 0,0:00:52.57,0:00:59.03,italics,JACK (INT),0,0,0,,Nhưng khi thằng Yami lôi mấy đứa bần nông vào đoàn của nó, \Nbố mày cứ tưởng lão mất trí rồi chứ.
Dialogue: 0,0:00:59.35,0:01:00.77,italics,JACK (INT),0,0,0,,Chết tiệt thật...
Dialogue: 0,0:01:01.85,0:01:04.54,main,JACK,0,0,0,,Vừa rồi chú mày đã cho bố mày thấy \Nmột màn thú vị phết đấy.
Dialogue: 0,0:01:05.45,0:01:11.35,italics,NACHT (INT),0,0,0,,Tam Địch khi phát huy 100% sức mạnh ác ma \Nđáng lẽ phải ngang ngửa với ác ma tối cao.
Dialogue: 0,0:01:12.45,0:01:14.21,italics,NACHT (INT),0,0,0,,Thế mà cậu ta lại có thể...
Dialogue: 0,0:01:15.00,0:01:18.46,italics,NACHT (INT),0,0,0,,Dù không biết cậu ta làm bằng cách nào, \Nnhưng đây đúng là một bất ngờ lớn.
Dialogue: 0,0:01:20.17,0:01:21.76,italics,NACHT (INT),0,0,0,,Dù sao thì, giờ chúng ta có thể...
Dialogue: 0,0:01:29.35,0:01:31.82,main,MORRIS,0,0,0,,Lũ ác ma cứ liên tục tràn ra kìa.
Dialogue: 0,0:01:32.73,0:01:34.62,main,MORRIS,0,0,0,,Quả là một cảnh tượng tuyệt mỹ làm sao!
Dialogue: 0,0:01:48.04,0:01:49.77,main,MORRIS,0,0,0,,Có vẻ như Dante đã thua rồi.
Dialogue: 0,0:01:50.72,0:01:54.42,main,MORRIS,0,0,0,,Ta thực sự tò mò không biết \Nloại ma pháp nào đã hạ gục hắn đây.
Dialogue: 0,0:01:54.91,0:01:56.93,main,NACHT,0,0,0,,Giờ một tên trong Tam Địch đã bị đánh bại,
Dialogue: 0,0:01:56.93,0:01:59.43,main,NACHT,0,0,0,,hiệu năng của Cây Qliphoth chắc chắn đã giảm bớt.
Dialogue: 0,0:01:59.70,0:02:01.93,main,NACHT,0,0,0,,Nhưng nếu không đánh bại hai tên còn lại,
Dialogue: 0,0:02:01.93,0:02:04.77,main,NACHT,0,0,0,,chúng ta sẽ không thể ngăn chặn triệt để Cây Qliphoth.
Dialogue: 0,0:02:05.82,0:02:08.94,main,NACHT,0,0,0,,Chỗ này không còn nhiều, và có lẽ \Nchúng không trị thương triệt để được đâu,
Dialogue: 0,0:02:08.94,0:02:11.00,main,NACHT,0,0,0,,nhưng đây là chút bánh quy ma pháp.
Dialogue: 0,0:02:11.00,0:02:11.98,main,NACHT,0,0,0,,Ăn đi.
Dialogue: 0,0:02:11.98,0:02:15.60,main,MAGNA,0,0,0,,Tuyệt quá! Tiện đà này em sẽ \Nxông lên cứu anh Yami!
Dialogue: 0,0:02:15.60,0:02:16.69,main,ASTA,0,0,0,,Không, người đó phải là em!
Dialogue: 0,0:02:16.69,0:02:18.11,main,LUCK,0,0,0,,Không đâu, là em cơ.
Dialogue: 0,0:02:18.34,0:02:21.12,main,NACHT,0,0,0,,Dao động ma lực quanh các thành viên còn lại \Ncủa Tam Địch quá mạnh mẽ,
Dialogue: 0,0:02:21.12,0:02:23.37,main,NACHT,0,0,0,,nên ta không thể đưa mọi người đi qua bóng tối được. Nhanh lên nào.
Dialogue: 0,0:02:23.37,0:02:24.76,main,MAGNA,0,0,0,,Rõ!
Dialogue: 0,0:02:43.45,0:02:47.14,main,DANTE,0,0,0,,Ta làm sao có thể thua... một kẻ như thế...
Dialogue: 0,0:02:47.14,0:02:49.34,main,DANTE,0,0,0,,Điều đó là bất khả thi!
Dialogue: 0,0:02:49.34,0:02:52.86,main,JACK,0,0,0,,Chậc. Tam Địch toàn năng \Nhóa ra cũng chỉ đến thế.
Dialogue: 0,0:02:53.79,0:02:57.25,main,JACK,0,0,0,,Tốc độ hồi phục ma pháp của ngươi \Nđúng là không phải trò đùa.
Dialogue: 0,0:02:59.04,0:03:03.78,main,JACK,0,0,0,,Nhưng ngươi đã mất kiểm soát ma pháp cơ thể quý giá, \Nvà nó đang lồng lộn lên kìa.
Dialogue: 0,0:03:03.78,0:03:05.67,main,DANTE,0,0,0,,Câm mồm!
Dialogue: 0,0:03:05.67,0:03:07.40,main,DANTE,0,0,0,,Ta là bất tử!
Dialogue: 0,0:03:07.40,0:03:10.29,main,DANTE,0,0,0,,Ta sẽ giết các ngươi! Ta sẽ nghiền nát tất cả các ngươi!
Dialogue: 0,0:03:10.65,0:03:14.79,main,DANTE,0,0,0,,Làm sao ta có thể thua được chứ!
Dialogue: 0,0:03:11.89,0:03:14.79,main,JACK,0,0,0,,Câm cái mồm thối của ngươi lại đi.
Dialogue: 0,0:03:15.54,0:03:18.55,main,DANTE,0,0,0,,Bố mày không nói là \Nghét những kẻ cứng đầu...
Dialogue: 0,0:03:18.85,0:03:21.92,main,DANTE,0,0,0,,Nhưng con bọ đó đã thắng sòng phẳng rồi, \Nđừng có mà làm hỏng màn ăn mừng của nó!
Dialogue: 0,0:03:24.24,0:03:27.93,Ep Title,EP TITLE,0,0,0,,{\c&H0B00E8&\pos(321.33,95)}Nữ Thần Valkyrie Thánh Khiết
Dialogue: 0,0:03:38.57,0:03:40.93,italics,CHARLOTTE (INT),0,0,0,,Dù những đóa hồng xanh của mình \Náp chế Chú Thuật Ma Pháp của ả,
Dialogue: 0,0:03:40.93,0:03:43.16,italics,CHARLOTTE (INT),0,0,0,,nhưng chỉ riêng Huyết Ma Pháp của ả thôi cũng đã quá mạnh.
Dialogue: 0,0:03:43.16,0:03:44.37,italics,CHARLOTTE (INT),0,0,0,,Và...
Dialogue: 0,0:03:44.73,0:03:48.37,main,VANICA,0,0,0,,Sự phối hợp của bọn ta mạnh hơn nhiều!
Dialogue: 0,0:03:49.17,0:03:51.56,main,VANICA,0,0,0,,Có phải không hả, Loropechika bé bỏng của ta?
Dialogue: 0,0:03:52.08,0:03:54.86,main,VANICA,0,0,0,,Ta biết ngay những đòn đánh của cưng \Nsẽ tuyệt vời lắm mà,
Dialogue: 0,0:03:54.86,0:03:57.17,main,VANICA,0,0,0,,miễn là cưng thực sự dốc hết toàn lực!
Dialogue: 0,0:03:57.67,0:04:01.30,main,VANICA,0,0,0,,Tha hồ quậy phá tưng bừng \Nchẳng phải là cảm giác sướng nhất sao?
Dialogue: 0,0:04:01.57,0:04:02.74,main,RILL,0,0,0,,Loropechika!
Dialogue: 0,0:04:02.74,0:04:05.34,italics,RILL (INT),0,0,0,,Hội Họa Ma Pháp: Khổng Lồ Đất Sâu!
Dialogue: 0,0:04:06.55,0:04:09.39,main,VANICA,0,0,0,,Xông lên thịt bọn chúng đi, Loropechika bé bỏng!
Dialogue: 0,0:04:23.13,0:04:28.28,italics,RILL (INT),0,0,0,,Ma lực của cô ấy vốn đã kinh người, \Nnhưng nhờ lời nguyền mà nay lại càng khủng khiếp hơn!
Dialogue: 0,0:04:30.77,0:04:32.45,italics,CHARLOTTE (INT),0,0,0,,Nữ vương Loropechika!
Dialogue: 0,0:04:32.73,0:04:36.40,italics,CHARLOTTE (INT),0,0,0,,Tôi hiểu cảm giác đau đớn và phẫn uất nhường nào \Nkhi cơ thể mình bị kẻ khác tước đoạt!
Dialogue: 0,0:04:37.45,0:04:40.55,main,CHARLOTTE,0,0,0,,Tôi thề chúng tôi nhất định sẽ hóa giải lời nguyền này!
Dialogue: 0,0:04:46.14,0:04:49.71,main,VANICA,0,0,0,,Sao các ngươi không biết tận hưởng cuộc chiến này chứ?
Dialogue: 0,0:04:49.71,0:04:53.23,main,VANICA,0,0,0,,Chính vì cái thói đó \Nmà các ngươi sắp chết sạch cả lũ đấy!
Dialogue: 0,0:04:53.23,0:04:54.64,main,RILL,0,0,0,,Charlotte!
Dialogue: 0,0:05:03.49,0:05:05.40,main,NOELLE,0,0,0,,Tôi đã đến đúng như lời hẹn rồi đây...
Dialogue: 0,0:05:05.40,0:05:06.45,main,NOELLE,0,0,0,,Vanica!
Dialogue: 0,0:05:07.70,0:05:09.20,main,GAJA,0,0,0,,Nữ vương Loropechika!
Dialogue: 0,0:05:09.45,0:05:13.41,main,VANICA,0,0,0,,Ái chà, Noelle! Ngươi đã trở nên \Nmạnh hơn đúng như ta bảo chưa đấy?
Dialogue: 0,0:05:13.41,0:05:18.10,main,VANICA,0,0,0,,Cơ mà giờ ta còn mạnh hơn trước nhiều, \Nliệu ngươi có đủ sức chơi đùa với ta không đây?
Dialogue: 0,0:05:19.84,0:05:21.76,main,NOELLE,0,0,0,,Sao ngươi dám làm chuyện tàn nhẫn đó với Loropechika?!
Dialogue: 0,0:05:22.34,0:05:24.17,main,NOELLE,0,0,0,,Cứ yên tâm đi, Vanica.
Dialogue: 0,0:05:24.77,0:05:25.97,main,NOELLE,0,0,0,,Tôi...
Dialogue: 0,0:05:27.60,0:05:30.93,main,NOELLE,0,0,0,,Không, {\i1}chúng tôi{\i0} nhất định \Nsẽ đánh bại ngươi!
Dialogue: 0,0:05:32.09,0:05:33.52,main,VANICA,0,0,0,,Biết ngay mà!
Dialogue: 0,0:05:35.52,0:05:39.00,main,CHARLOTTE,0,0,0,,Undine vốn phục vụ Nữ vương Loropechika! \NTại sao ngài ấy lại...
Dialogue: 0,0:05:39.73,0:05:41.23,flashback,DRYAD (FB),0,0,0,,Noelle...
Dialogue: 0,0:05:42.55,0:05:45.60,flashback,DRYAD (FB),0,0,0,,Trước cả Ma Pháp Tối Thượng hay bất cứ thứ gì khác,
Dialogue: 0,0:05:45.60,0:05:48.22,flashback,DRYAD (FB),0,0,0,,có một sức mạnh nhất định \Nmà con cần phải đạt được.
Dialogue: 0,0:05:48.54,0:05:49.83,flashback,NOELLE (FB),0,0,0,,Sao cơ ạ?
Dialogue: 0,0:05:51.66,0:05:53.29,flashback,DRYAD (FB),0,0,0,,Đúng không nào?
Dialogue: 0,0:05:57.40,0:05:58.71,flashback,NOELLE (FB),0,0,0,,Undine?!
Dialogue: 0,0:05:58.71,0:06:01.46,flashback,NOELLE (FB),0,0,0,,Ngài vẫn bình an vô sự! Nhưng làm sao...
Dialogue: 0,0:06:03.94,0:06:06.90,flashback,UNDINE (FB),0,0,0,,Chú Thuật Ma Pháp đã bào mòn toàn bộ sức lực của ta,
Dialogue: 0,0:06:06.90,0:06:10.47,flashback,UNDINE (FB),0,0,0,,khiến khế ước giữa ta với Loropechika \Ntạm thời bị giải trừ.
Dialogue: 0,0:06:11.05,0:06:15.26,flashback,UNDINE (FB),0,0,0,,Vì thế, để hồi phục sức mạnh \Nvà tích tụ lại mana,
Dialogue: 0,0:06:15.26,0:06:18.14,flashback,UNDINE (FB),0,0,0,,ta đã chuyển sang ma đạo thư \Ncủa một ma pháp sư khác đủ tư cách.
Dialogue: 0,0:06:18.80,0:06:21.01,flashback,UNDINE (FB),0,0,0,,Noelle, đó chính là con.
Dialogue: 0,0:06:21.87,0:06:24.97,flashback,UNDINE (FB),0,0,0,,Con có đầy đủ phẩm chất \Nđể trở thành khế ước giả của Tinh linh Nước.
Dialogue: 0,0:06:25.53,0:06:30.78,flashback,DRYAD (FB),0,0,0,,Bằng việc sử dụng một nửa cơ thể, \NVanica đã hiện hình ác ma tối cao Megicula.
Dialogue: 0,0:06:31.04,0:06:35.54,flashback,DRYAD (FB),0,0,0,,Nhưng vẫn còn một cách để kết liễu ả \Nngoài việc nhờ cậy các ma pháp sư Minh Vực.
Dialogue: 0,0:06:35.87,0:06:39.23,flashback,DRYAD (FB),0,0,0,,Đó là cảnh giới mà chỉ có \Ncác khế ước giả Tinh linh mới có thể chạm tới.
Dialogue: 0,0:06:39.23,0:06:42.65,flashback,DRYAD (FB),0,0,0,,Cảnh giới thanh tẩy tà niệm \Nvà tiêu diệt ác ma:
Dialogue: 0,0:06:42.65,0:06:44.04,flashback,DRYAD (FB),0,0,0,,Thánh Vực (Saint Stage).
Dialogue: 0,0:06:44.67,0:06:46.52,flashback,DRYAD (FB),0,0,0,,Đúng không, Undine?
Dialogue: 0,0:06:48.31,0:06:49.68,flashback,NOELLE (FB),0,0,0,,Nhưng nếu quả thực là vậy,
Dialogue: 0,0:06:49.68,0:06:52.14,flashback,NOELLE (FB),0,0,0,,thay vì chỉ trông cậy vào Asta \Nvà các ma pháp sư Minh Vực khác,
Dialogue: 0,0:06:52.14,0:06:54.58,flashback,NOELLE (FB),0,0,0,,sao ngài không huấn luyện cho cả \Nnhững khế ước giả khác như
Dialogue: 0,0:06:54.58,0:06:56.41,flashback,NOELLE (FB),0,0,0,,Đoàn trưởng Fuegoleon hay Yuno?
Dialogue: 0,0:06:56.79,0:06:59.76,flashback,NOELLE (FB),0,0,0,,Hơn hết thảy, ma lực của Loropechika vô cùng khổng lồ.
Dialogue: 0,0:06:59.76,0:07:02.37,flashback,NOELLE (FB),0,0,0,,Lẽ ra ngài phải để chị ấy \Nchiến đấu ở Thánh Vực chứ?
Dialogue: 0,0:07:04.17,0:07:05.80,flashback,UNDINE (FB),0,0,0,,Thuở xa xưa...
Dialogue: 0,0:07:07.05,0:07:10.44,flashback,UNDINE (FB),0,0,0,,Ta tình cờ hòa hợp với vị Nữ vương \Nđầu tiên của Vương quốc Heart
Dialogue: 0,0:07:10.44,0:07:11.92,flashback,UNDINE (FB),0,0,0,,và chọn người làm khế ước giả.
Dialogue: 0,0:07:12.79,0:07:16.16,flashback,UNDINE (FB),0,0,0,,Kể từ đó, ta luôn yêu quý \Nthần dân Vương quốc Heart
Dialogue: 0,0:07:16.16,0:07:18.54,flashback,UNDINE (FB),0,0,0,,và cùng họ bảo vệ mảnh đất này.
Dialogue: 0,0:07:19.17,0:07:23.77,flashback,UNDINE (FB),0,0,0,,Rồi năm tháng trôi qua, \Nta đã gặp gỡ Loropechika.
Dialogue: 0,0:07:25.58,0:07:29.13,flashback,UNDINE (FB),0,0,0,,Từ khi còn là một cô bé, \Nem ấy đã sở hữu lượng ma lực bạt ngàn,
Dialogue: 0,0:07:29.13,0:07:33.05,flashback,UNDINE (FB),0,0,0,,và hoàn toàn đủ tư cách để kế vị ngai vàng.
Dialogue: 0,0:07:34.00,0:07:37.91,flashback,UNDINE (FB),0,0,0,,Nhưng trên tất cả, em ấy \Nkhác biệt với mọi vị Nữ vương trước đây.
Dialogue: 0,0:07:38.84,0:07:43.40,flashback,UNDINE (FB),0,0,0,,Loropechika không thể học nổi \Ndù chỉ một ma pháp tấn công đơn thuần.
Dialogue: 0,0:07:44.17,0:07:47.18,flashback,UNDINE (FB),0,0,0,,Thứ tối đa em ấy có thể dùng chỉ là \Nnhững ma pháp trông có vẻ tấn công,
Dialogue: 0,0:07:47.18,0:07:48.78,flashback,UNDINE (FB),0,0,0,,như tạo ra búp bê hiệp sĩ mà thôi.
Dialogue: 0,0:07:49.19,0:07:53.16,flashback,UNDINE (FB),0,0,0,,Đồng nghĩa với việc em ấy sẽ không bao giờ \Nchạm tới Thánh Vực để tiêu diệt ác ma.
Dialogue: 0,0:07:54.17,0:07:57.10,flashback,UNDINE (FB),0,0,0,,Đứa trẻ đó... đơn giản là quá đỗi lương thiện.
Dialogue: 0,0:08:00.91,0:08:03.79,flashback,LOROPECHIKA (FB/FB),0,0,0,,Em nghĩ... vì mình không thể \Nhọc được ma pháp tấn công nào,
Dialogue: 0,0:08:04.06,0:08:06.17,flashback,LOROPECHIKA (FB/FB),0,0,0,,nên em không xứng đáng làm Nữ vương...
Dialogue: 0,0:08:08.38,0:08:10.83,flashback,UNDINE (FB/FB),0,0,0,,Không phải đâu, Loropechika.
Dialogue: 0,0:08:11.80,0:08:15.30,flashback,UNDINE (FB/FB),0,0,0,,Tấm lòng lương thiện của em \Nchính là niềm tự hào của ta!
Dialogue: 0,0:08:16.10,0:08:18.40,flashback,LOROPECHIKA (FB/FB),0,0,0,,Thật thế sao, ngài Undine?
Dialogue: 0,0:08:19.73,0:08:22.59,flashback,UNDINE (FB),0,0,0,,Ta đã giấu kín chuyện về Thánh Vực.
Dialogue: 0,0:08:23.15,0:08:24.98,flashback,UNDINE (FB),0,0,0,,Ta biết bản thân mình thật ích kỷ.
Dialogue: 0,0:08:27.09,0:08:30.07,flashback,UNDINE (FB),0,0,0,,Kể cả khi những kẻ mang ác ma \Nxuất hiện ở Vương quốc Spade...
Dialogue: 0,0:08:30.07,0:08:32.96,flashback,UNDINE (FB),0,0,0,,Ngay cả khi Vanica nhắm vào Loropechika...
Dialogue: 0,0:08:33.67,0:08:37.88,flashback,UNDINE (FB),0,0,0,,Ta vẫn muốn bằng mọi giá giữ \NLoropechika tránh xa khỏi chiến tranh.
Dialogue: 0,0:08:39.44,0:08:42.81,flashback,UNDINE (FB),0,0,0,,Ta muốn em ấy mãi giữ sự lương thiện đó.
Dialogue: 0,0:08:45.05,0:08:46.17,flashback,DRYAD (FB),0,0,0,,Undine...
Dialogue: 0,0:08:48.29,0:08:52.68,flashback,UNDINE (FB),0,0,0,,Nhưng rốt cuộc, Loropechika lại \Nbị trúng lời nguyền rồi bị bắt đi.
Dialogue: 0,0:08:54.25,0:08:57.18,flashback,UNDINE (FB),0,0,0,,Nghĩa là ta đã sai lầm...
Dialogue: 0,0:08:58.73,0:08:59.93,flashback,NOELLE (FB),0,0,0,,Đúng vậy.
Dialogue: 0,0:09:00.65,0:09:06.06,flashback,NOELLE (FB),0,0,0,,Việc ngài không nói cho chị ấy về Thánh Vực \Ncó thể là một sai lầm.
Dialogue: 0,0:09:06.06,0:09:09.08,flashback,NOELLE (FB),0,0,0,,Nhưng ngài làm vậy là vì \Nlòng tốt của mình, đúng không?
Dialogue: 0,0:09:10.31,0:09:13.45,flashback,NOELLE (FB),0,0,0,,Sự lương thiện. Lòng trắc ẩn \Ndành cho một ai đó...
Dialogue: 0,0:09:13.45,0:09:16.27,flashback,NOELLE (FB),0,0,0,,Những điều tốt đẹp ấy \Nlàm sao có thể là sai lầm được cơ chứ?!
Dialogue: 0,0:09:16.82,0:09:17.82,flashback,UNDINE (FB),0,0,0,,Undine...
Dialogue: 0,0:09:18.20,0:09:23.45,flashback,NOELLE (FB),0,0,0,,Chúng ta chẳng ưa gì nhau, nhưng chúng ta \Nđều có chung một mục tiêu, đúng chứ?
Dialogue: 0,0:09:25.80,0:09:30.31,flashback,NOELLE (FB),0,0,0,,Để đánh bại Vanica và cứu Loropechika... \NEm muốn ngài hãy cùng kề vai chiến đấu với em!
Dialogue: 0,0:09:34.67,0:09:39.07,main,VANICA,0,0,0,,Ô kìa, ta chỉ đang dạy cho \Ncưng ấy biết thế nào là sướng thôi mà.
Dialogue: 0,0:09:39.07,0:09:43.60,main,VANICA,0,0,0,,Và ta đoan chắc Loropechika \Nlúc này đang vui sướng khôn xiết!
Dialogue: 0,0:09:43.91,0:09:46.23,main,VANICA,0,0,0,,Có đúng không nào, Loropechika?
Dialogue: 0,0:09:47.28,0:09:50.65,main,VANICA,0,0,0,,Nhanh lên nào! Cưng cũng tấn công đi chứ!
Dialogue: 0,0:09:50.65,0:09:53.78,main,VANICA,0,0,0,,Rồi cả hai đứa mình sẽ cùng nhau lên đỉnh cực lạc!
Dialogue: 0,0:09:53.78,0:09:55.82,main,VANICA,0,0,0,,Chẳng phải quá tuyệt vời sao?
Dialogue: 0,0:09:59.12,0:10:00.97,main,NOELLE,0,0,0,,Đủ rồi đấy.
Dialogue: 0,0:10:01.53,0:10:05.41,main,VANICA,0,0,0,,Nhanh lên Noelle! Hãy vui đùa cùng bọn ta nào!
Dialogue: 0,0:10:06.09,0:10:07.62,main,NOELLE,0,0,0,,Ngươi có biết không?
Dialogue: 0,0:10:08.17,0:10:09.60,main,NOELLE,0,0,0,,Tất cả chuyện này...
Dialogue: 0,0:10:11.77,0:10:13.50,main,NOELLE,0,0,0,,đều là do lỗi của ngươi!
Dialogue: 0,0:10:15.51,0:10:18.76,main,VANICA,0,0,0,,Tốt nhất là ngươi đừng có \Nđể cuộc chơi kết thúc quá sớm đấy!
Dialogue: 0,0:10:19.17,0:10:23.21,main,VANICA,0,0,0,,Ta kỳ vọng ngươi sẽ mang lại \Ncho ta những giây phút thật đê mê!
Dialogue: 0,0:10:23.21,0:10:25.46,main,NOELLE,0,0,0,,Ngươi câm cái mồm lại được rồi đấy!
Dialogue: 0,0:10:27.25,0:10:31.10,main,NOELLE,0,0,0,,Những kẻ làm theo ý thích rồi cười đùa \Nnhư lũ điên dại,
Dialogue: 0,0:10:31.10,0:10:34.23,main,NOELLE,0,0,0,,trong khi những người lương thiện \Nphải chịu tổn thương và rơi nước mắt...
Dialogue: 0,0:10:37.53,0:10:40.01,main,NOELLE,0,0,0,,Loại như ngươi, ta tuyệt đối không tha thứ!
Dialogue: 0,0:10:52.05,0:10:53.29,italics,NOELLE,0,0,0,,Tinh Linh Đồng Hóa...
Dialogue: 0,0:11:00.57,0:11:02.64,italics,NOELLE,0,0,0,,Thánh Y Valkyrie!
Dialogue: 0,0:11:03.93,0:11:06.83,main,NOELLE,0,0,0,,Ta sẽ tiêu diệt ngươi!
Dialogue: 0,0:11:12.81,0:11:14.44,italics,VANICA (INT),0,0,0,,Cảm giác ớn lạnh này là...
Dialogue: 0,0:11:14.73,0:11:18.24,italics,VANICA (INT),0,0,0,,Huyết Ma Pháp: Đàn Hồng Thú!
Dialogue: 0,0:11:25.89,0:11:28.70,italics,VANICA (INT),0,0,0,,Đàn hồng thú bị chém nát vụn rồi.
Dialogue: 0,0:11:29.11,0:11:30.71,italics,VANICA (INT),0,0,0,,Cả diện mạo lẫn sức mạnh của ả
Dialogue: 0,0:11:30.71,0:11:33.57,italics,VANICA (INT),0,0,0,,đều khác hoàn toàn so với \Nhồi ở Vương quốc Heart.
Dialogue: 0,0:11:36.80,0:11:38.21,italics,VANICA (INT),0,0,0,,Tuyệt quá đi mất!
Dialogue: 0,0:11:38.21,0:11:40.72,main,VANICA,0,0,0,,Đây mới đúng là thứ ta hằng mong đợi!
Dialogue: 0,0:11:41.88,0:11:46.10,main,RILL,0,0,0,,Charlotte, dù cho những đóa hồng xanh của cô \Nđang suy yếu Chú Thuật Ma Pháp...
Dialogue: 0,0:11:46.10,0:11:47.68,main,RILL,0,0,0,,nhưng Noelle đỉnh thật sự!
Dialogue: 0,0:11:47.68,0:11:49.89,main,UNDINE,0,0,0,,Chúng ta không có nhiều thời gian đâu!
Dialogue: 0,0:11:49.89,0:11:52.23,main,UNDINE,0,0,0,,Noelle, hãy hạ gục ả trong vòng một phút!
Dialogue: 0,0:11:52.46,0:11:55.25,main,NOELLE,0,0,0,,Không! Tôi sẽ kết liễu ả chỉ trong ba mươi giây!
Dialogue: 0,0:12:10.75,0:12:16.79,main,VANICA,0,0,0,,Được lắm! Sướng quá đi! Cưng là đỉnh nhất đấy, Noelle!
Dialogue: 0,0:12:17.22,0:12:17.88,italics,VANICA (INT),0,0,0,,Ôi...
Dialogue: 0,0:12:18.62,0:12:21.38,italics,VANICA (INT),0,0,0,,Cảm giác rùng mình rạo rực này \Nhệt như lần đó...
Dialogue: 0,0:12:21.94,0:12:25.46,italics,VANICA (INT),0,0,0,,Hình như là ngay sau khi \Nta trở thành khế ước giả của Megicula.
Dialogue: 0,0:12:25.46,0:12:29.14,italics,VANICA (INT),0,0,0,,Ta muốn thử nghiệm sức mạnh ác ma \Nvà tha hồ quậy phá tưng bừng.
Dialogue: 0,0:12:29.41,0:12:32.21,italics,VANICA (INT),0,0,0,,Nghe đồn người phụ nữ \Nđược mệnh danh là mạnh nhất thời bấy giờ
Dialogue: 0,0:12:32.21,0:12:34.64,italics,VANICA (INT),0,0,0,,đang ẩn cư dưỡng sức,
Dialogue: 0,0:12:34.64,0:12:38.40,italics,VANICA (INT),0,0,0,,nên ta đã lén lẻn khỏi Vương quốc Spade \Nđể đến chơi đùa với bà ta.
Dialogue: 0,0:12:38.80,0:12:42.03,flashback,VANICA (FB),0,0,0,,Cả bà lẫn sức mạnh ác ma này \Nđều tuyệt vời khôn tả!
Dialogue: 0,0:12:42.32,0:12:44.28,flashback,VANICA (FB),0,0,0,,Hãy tiếp tục làm ta phấn khích đi nào...
Dialogue: 0,0:12:44.85,0:12:46.26,flashback,VANICA (FB),0,0,0,,Acier!
Dialogue: 0,0:12:47.99,0:12:49.57,flashback,VANICA (FB),0,0,0,,Ta tới đây!
Dialogue: 0,0:12:55.21,0:12:56.75,flashback,ACIER (FB),0,0,0,,Noelle! Nozel!
Dialogue: 0,0:12:56.75,0:13:00.50,flashback,VANICA (FB),0,0,0,,Trời đất, câm mồm lại được không? \NĐừng có cản trở cuộc vui của bọn này.
Dialogue: 0,0:13:00.77,0:13:03.42,flashback,VANICA (FB),0,0,0,,Có khi ta giết quách tụi mày trước nhé...
Dialogue: 0,0:13:03.84,0:13:06.42,flashback,VANICA (FB),0,0,0,,Đây là con của bà sao, Acier?
Dialogue: 0,0:13:06.42,0:13:08.80,flashback,VANICA (FB),0,0,0,,Sao bà lại đi sinh con đẻ cái làm gì cơ chứ?
Dialogue: 0,0:13:09.13,0:13:14.33,flashback,VANICA (FB),0,0,0,,Chúng chỉ khiến bà mệt mỏi và vướng chân vướng tay thôi. \NMột nữ cường nhân như bà đâu cần đến lũ vướng víu đó!
Dialogue: 0,0:13:16.52,0:13:19.69,flashback,ACIER (FB),0,0,0,,Để ta nói cho ngươi biết \Nthứ mạnh nhất trên cõi đời này là gì.
Dialogue: 0,0:13:20.40,0:13:23.66,flashback,ACIER (FB),0,0,0,,Đó chính là một người mẹ... \Nbảo vệ những đứa con của mình!
Dialogue: 0,0:13:31.45,0:13:33.16,flashback italics,VANICA (FB)(INT),0,0,0,,Chú Thuật Ma Pháp...
Dialogue: 0,0:13:39.40,0:13:42.32,italics,VANICA (INT),0,0,0,,Hồi đó, ta bị trọng thương chí mạng...
Dialogue: 0,0:13:42.81,0:13:45.30,italics,VANICA (INT),0,0,0,,và Megicula bảo ta phải chạy trốn, nên ta đã rút lui.
Dialogue: 0,0:13:46.68,0:13:48.55,italics,VANICA (INT),0,0,0,,Giờ thì ta nhớ ra rồi!
Dialogue: 0,0:13:48.55,0:13:51.55,main,VANICA,0,0,0,,Nữa đi! Cho ta nếm trải nhiều hơn nữa đi!
Dialogue: 0,0:13:51.55,0:13:54.80,italics,VANICA (INT),0,0,0,,Huyết Ma Pháp: Hồng Thú!
Dialogue: 0,0:13:55.14,0:13:57.31,main,VANICA,0,0,0,,Hãy tiếp tục nối lại \Ncuộc chơi dang dở năm xưa nào!
Dialogue: 0,0:13:57.96,0:13:59.51,main,NOELLE,0,0,0,,Tiếng Gầm Của Thủy Long!
Dialogue: 0,0:14:07.76,0:14:10.28,main,NOELLE,0,0,0,,Ngươi đã quen thói làm càn bấy lâu nay, \Nnhưng giờ thì...
Dialogue: 0,0:14:11.41,0:14:12.93,main,NOELLE,0,0,0,,Ngươi sẽ phải đền tội!
Dialogue: 0,0:14:22.25,0:14:26.44,main,VANICA,0,0,0,,Cưng đúng là tuyệt nhất trần đời, Noelle!
Dialogue: 0,0:16:05.15,0:16:07.34,main,VANICA,0,0,0,,Noelle!
Dialogue: 0,0:16:12.22,0:16:15.49,main,VANICA,0,0,0,,Đã quá! Phê quá đi mất! Noelle!
Dialogue: 0,0:16:15.78,0:16:18.13,main,VANICA,0,0,0,,Nữa đi! Cho ta thêm nữa đi!
Dialogue: 0,0:16:26.88,0:16:31.55,main,VANICA,0,0,0,,Cưng đúng là tuyệt nhất, Noelle!
Dialogue: 0,0:16:59.94,0:17:02.42,main,NOELLE,0,0,0,,Ngươi thua rồi, Vanica!
Dialogue: 0,0:17:07.15,0:17:10.00,main,VANICA,0,0,0,,Cảm giác đó... sướng tê người!
Dialogue: 0,0:17:11.25,0:17:13.58,main,VANICA,0,0,0,,Cảm giác này là gì thế này?
Dialogue: 0,0:17:13.58,0:17:15.42,main,VANICA,0,0,0,,Lẽ nào đây chính là...
Dialogue: 0,0:17:16.18,0:17:17.93,main,VANICA,0,0,0,,tình bạn?!
Dialogue: 0,0:17:18.24,0:17:21.50,main,VANICA,0,0,0,,Giờ tới lượt ta đuổi kịp cưng rồi nhé!
Dialogue: 0,0:17:21.50,0:17:23.69,main,VANICA,0,0,0,,Thế này chẳng phải chúng ta \Nlà đối thủ của nhau sao?!
Dialogue: 0,0:17:23.69,0:17:26.10,main,VANICA,0,0,0,,Hãy cùng thi thố xem \Nai sẽ trở nên mạnh hơ—
Dialogue: 0,0:17:26.10,0:17:27.40,main,NOELLE,0,0,0,,Đừng có mơ.
Dialogue: 0,0:17:29.40,0:17:33.40,main,NOELLE,0,0,0,,Đừng hòng mọi chuyện kết thúc êm thấm \Nchỉ vì ngươi cảm thấy thỏa mãn.
Dialogue: 0,0:17:35.18,0:17:37.85,main,NOELLE,0,0,0,,Ta sẽ kết liễu ngươi ngay tại đây, Vanica!
Dialogue: 0,0:17:37.85,0:17:39.08,main,MEGICULA,0,0,0,,Quả nhiên là vậy.
Dialogue: 0,0:17:39.74,0:17:43.50,main,MEGICULA,0,0,0,,Ngươi thực sự rất thú vị đấy, Vanica.
Dialogue: 0,0:17:43.79,0:17:46.34,main,MEGICULA,0,0,0,,Nhưng như thế này thì hỏng hết việc.
Dialogue: 0,0:17:50.03,0:17:51.46,italics,NOELLE (INT),0,0,0,,Luồng ma pháp này...
Dialogue: 0,0:17:52.40,0:17:55.35,main,MEGICULA,0,0,0,,Lucifero và những kẻ khác \Nvẫn chưa nhận ra chúng ta.
Dialogue: 0,0:17:55.84,0:18:02.02,main,MEGICULA,0,0,0,,Lại còn có linh hồn của ba ma pháp sư đồng giới \Nmang sức mạnh vượt trội tề tựu ở nơi này...
Dialogue: 0,0:18:03.26,0:18:07.06,main,MEGICULA,0,0,0,,Các khâu chuẩn bị cho sự giáng lâm \Ncủa ta đã hoàn tất.
Dialogue: 0,0:18:09.56,0:18:11.77,italics,CHARLOTTE (INT),0,0,0,,Uy lực của lời nguyền này...
Dialogue: 0,0:18:12.32,0:18:13.65,italics,CHARLOTTE (INT),0,0,0,,Không thể nào!
Dialogue: 0,0:18:13.92,0:18:15.73,italics,CHARLOTTE (INT),0,0,0,,Nhưng không còn nghi ngờ gì nữa...
Dialogue: 0,0:18:15.73,0:18:16.65,italics,CHARLOTTE (INT),0,0,0,,Đó chính là...
Dialogue: 0,0:18:20.86,0:18:22.78,italics,CHARLOTTE (INT),0,0,0,,Megicula bằng xương bằng thịt!
Dialogue: 0,0:18:24.75,0:18:28.92,main,MEGICULA,0,0,0,,Ta đã gắn bó với Vanica một thời gian dài, \Nnên ta cũng có chút đồng cảm.
Dialogue: 0,0:18:29.32,0:18:32.29,main,MEGICULA,0,0,0,,Nhưng nếu cả Vanica và Loropechika cùng chết đi,
Dialogue: 0,0:18:32.79,0:18:35.17,main,MEGICULA,0,0,0,,sự hiển linh của ta sẽ chính thức hoàn tất.
Dialogue: 0,0:18:35.45,0:18:36.67,main,GAJA,0,0,0,,Nữ vương Loropechika!
Dialogue: 0,0:18:41.08,0:18:43.85,main,MEGICULA,0,0,0,,Nhưng trước khi điều đó xảy ra, \Nta sẽ để các ngươi ẩu đả thêm một trận nữa.
Dialogue: 0,0:18:45.30,0:18:47.64,main,MEGICULA,0,0,0,,Nếu tất cả các ngươi cùng chết bên nhau, \Ndưới suối vàng sẽ chẳng còn cô đơn đâu.
Dialogue: 0,0:18:48.19,0:18:51.17,main,MEGICULA,0,0,0,,Có đúng không hả, lũ người trần mắt thịt?
Dialogue: 0,0:18:51.17,0:18:52.98,main,NOELLE,0,0,0,,Megicula...
Dialogue: 0,0:18:53.37,0:18:54.86,main,NOELLE,0,0,0,,Sao ngươi lại có thể ở đây được?!
Dialogue: 0,0:18:54.86,0:18:58.17,main,NOELLE,0,0,0,,Mới chỉ có một cánh cổng \Ncủa Minh Giới được mở ra thôi mà!
Dialogue: 0,0:18:58.17,0:18:59.89,main,MEGICULA,0,0,0,,Những cánh cổng đó chỉ là bảo hiểm thôi.
Dialogue: 0,0:18:59.89,0:19:02.81,main,MEGICULA,0,0,0,,Mục đích thực sự của ta là giáng lâm thông qua
Dialogue: 0,0:19:02.81,0:19:05.37,main,MEGICULA,0,0,0,,Chú Thuật Ma Pháp: Giáng Lâm Nữ Ma.
Dialogue: 0,0:19:05.69,0:19:09.32,main,MEGICULA,0,0,0,,Phép thuật này đòi hỏi những vật hiến tế \Ntốn rất nhiều công sức,
Dialogue: 0,0:19:09.32,0:19:11.62,main,MEGICULA,0,0,0,,nên để thực hiện nó quả thực vô cùng khó khăn.
Dialogue: 0,0:19:12.17,0:19:15.43,main,MEGICULA,0,0,0,,Hoàng tộc mang tên Acier Silva \Ncủa Vương quốc Clover...
Dialogue: 0,0:19:15.43,0:19:20.63,main,MEGICULA,0,0,0,,Nguyền rủa bà ta đến chết đã giúp ta \Nhiện hình một nửa trong cơ thể của Vanica.
Dialogue: 0,0:19:21.78,0:19:22.99,italics,NOELLE (INT),0,0,0,,Mẹ ơi!
Dialogue: 0,0:19:23.79,0:19:25.77,main,MEGICULA,0,0,0,,Kế đó là Vanica, một khế ước giả tài năng
Dialogue: 0,0:19:25.77,0:19:28.27,main,MEGICULA,0,0,0,,đã lập giao ước với ta, \Nmột ác ma tối cao.
Dialogue: 0,0:19:28.27,0:19:30.24,main,MEGICULA,0,0,0,,Vì ả đang cận kề cái chết,
Dialogue: 0,0:19:30.24,0:19:32.97,main,MEGICULA,0,0,0,,ta mới có thể trồi lên như thế này, \Ndù vẫn chưa hoàn chỉnh.
Dialogue: 0,0:19:33.95,0:19:37.14,main,MEGICULA,0,0,0,,Và cuối cùng là Nữ vương \Ncủa Vương quốc Heart, Loropechika.
Dialogue: 0,0:19:37.14,0:19:43.52,main,MEGICULA,0,0,0,,Khi ả và Vanica cùng chết, \Nta sẽ hoàn toàn giáng lâm xuống thế giới này.
Dialogue: 0,0:19:46.07,0:19:49.54,main,MEGICULA,0,0,0,,Ma Ma Pháp Thủy Hệ: Thủy Xà Darkneros!
Dialogue: 0,0:19:49.86,0:19:52.04,main,NOELLE,0,0,0,,Ma pháp tà ác này là...
Dialogue: 0,0:19:52.04,0:19:53.71,main,NOELLE,0,0,0,,Ngươi đã làm gì Loropechika rồi hả?!
Dialogue: 0,0:19:53.71,0:19:58.46,main,MEGICULA,0,0,0,,Ta chỉ biến tấu lời nguyền một chút \Nvà biến ả thành ác ma thôi mà.
Dialogue: 0,0:19:58.72,0:20:02.55,main,MEGICULA,0,0,0,,Ta nghĩ mình nên ban cho ả vài kỷ niệm \Nđẹp đẽ trước khi về cõi chết ấy mà.
Dialogue: 0,0:20:02.82,0:20:04.97,main,NOELLE,0,0,0,,Sao ngươi dám?!
Dialogue: 0,0:20:04.97,0:20:06.89,main,NOELLE,0,0,0,,Ta sẽ tiêu diệt ngươi ngay tại đây và—
Dialogue: 0,0:20:11.66,0:20:13.06,italics,NOELLE (INT),0,0,0,,Ma pháp của mình... tan biến rồi...
Dialogue: 0,0:20:13.06,0:20:16.07,main,MEGICULA,0,0,0,,Chú Thuật Ma Pháp: Thế Giới Mục Nát.
Dialogue: 0,0:20:16.39,0:20:18.49,main,MEGICULA,0,0,0,,Ở trạng thái hiện tại của ta, \Ntốc độ và uy lực từ hiệu ứng ma pháp này
Dialogue: 0,0:20:18.49,0:20:21.79,main,MEGICULA,0,0,0,,vượt xa hoàn toàn so với trước kia.
Dialogue: 0,0:20:25.77,0:20:28.83,main,CHARLOTTE,0,0,0,,Ta sẽ không để bất cứ thứ gì \Ndiễn ra theo ý ngươi nữa đâu!
Dialogue: 0,0:20:28.83,0:20:32.83,main,MEGICULA,0,0,0,,Ngươi là kẻ đầu tiên \Ndám chống lại lời nguyền của ta.
Dialogue: 0,0:20:33.25,0:20:36.44,main,MEGICULA,0,0,0,,Ngươi thể hiện tuyệt vời lắm, Nữ hoàng Gai Góc.
Dialogue: 0,0:20:37.80,0:20:40.46,italics,RILL (INT),0,0,0,,Dù có chuyện gì xảy ra, \Nmình nhất định phải bảo vệ Charlotte!
Dialogue: 0,0:20:40.46,0:20:43.88,main,MEGICULA,0,0,0,,Chú Thuật Ma Pháp: Nô Lệ Giải Phóng.
Dialogue: 0,0:20:44.57,0:20:49.14,italics,RILL (INT),0,0,0,,Ma pháp tuyệt mỹ của Noelle \Nđã truyền cảm hứng cho mình!
Dialogue: 0,0:20:50.41,0:20:51.43,italics,RILL (INT),0,0,0,,Hội Họa Ma Pháp...
Dialogue: 0,0:20:53.36,0:20:54.98,italics,RILL (INT),0,0,0,,Thánh Điện Hoàng Hôn Valhalla!
Dialogue: 0,0:21:04.71,0:21:08.11,italics,GAJA (INT),0,0,0,,Chân Lôi Ma Pháp: Nadaras do Astrauza!
Dialogue: 0,0:21:16.76,0:21:19.71,flashback,LOROPECHIKA (FB),0,0,0,,Em nghĩ... vì mình không thể học được \Nbất kỳ ma pháp tấn công nào,
Dialogue: 0,0:21:19.96,0:21:22.14,flashback,LOROPECHIKA (FB),0,0,0,,nên em không xứng đáng làm Nữ vương.
Dialogue: 0,0:21:26.51,0:21:27.43,italics,GAJA (INT),0,0,0,,Tôi...
Dialogue: 0,0:21:28.26,0:21:32.14,italics,GAJA (INT),0,0,0,,đã quyết tâm sẽ trở thành ma pháp sư \Ntấn công mạnh nhất Vương quốc Heart.
Dialogue: 0,0:21:32.97,0:21:34.98,italics,GAJA (INT),0,0,0,,Để tiêu diệt toàn bộ kẻ thù...
