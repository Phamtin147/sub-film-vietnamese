Dialogue: 0,0:00:08.75,0:00:10.70,Default,Satoko,0,0,0,,Anh Shinpei?
Dialogue: 0,0:00:12.38,0:00:13.70,Default,Shinpei,0,0,0,,Đau quá...
Dialogue: 0,0:00:14.28,0:00:15.54,Default,Shinpei,0,0,0,,Đau quá đi mất.
Dialogue: 0,0:00:16.17,0:00:18.87,Default,Shinpei,0,0,0,,Đau đến mức tưởng chừng sắp chết luôn rồi.
Dialogue: 0,0:00:20.52,0:00:22.94,Default,Shinpei,0,0,0,,Nhưng đừng lo, Satoko.
Dialogue: 0,0:00:22.94,0:00:27.26,Default,Shinpei,0,0,0,,Dù hắn có bắn nát người tôi thành tổ ong, \Ntôi vẫn sẽ cứu nàng.
Dialogue: 0,0:00:27.55,0:00:29.66,Default,Shinpei,0,0,0,,Bởi vì tôi là phu quân của nàng mà.
Dialogue: 0,0:01:57.28,0:02:00.98,Default,Sign,0,0,0,,{\an8\fnSegoe UI\bord0\shad0\b1\blur5\fsp1.5\fs30\t(30,500,\blur0.2\fsp0)\fscx90\t(\fs28)\c&H54FFDC&\t(550,750,\c&H428656&)\t(765,840,\c&H6B2214&)\t(850,1100,\c&H000000&)\move(320,5,320,17)}Hôn Nhân Đom Đóm
Dialogue: 0,0:02:00.98,0:02:07.73,Default,Sign,0,0,0,,{\an9\bord0\shad0\b1\3a&H70&\blur0.2\fnSegoe UI\fscx90\fs22\c&HFFFFFF&\pos(570,23)\3c&HDEDEFA&}Tôi Sẽ Trả Lại Tự Do Cho Nàng
Dialogue: 0,0:02:01.71,0:02:07.73,Default,Shinpei,0,0,0,,Tôi đã rời khỏi phòng khi nàng bảo, \Nvà cố kìm nén cơn bốc đồng muốn xông vào.
Dialogue: 0,0:02:08.29,0:02:10.73,Default,Shinpei,0,0,0,,Ý tôi là chờ cho đến khi nàng tự quyết định ấy.
Dialogue: 0,0:02:10.73,0:02:11.84,Default,Nitobe,0,0,0,,Lùi lại!
Dialogue: 0,0:02:11.84,0:02:13.70,Default,Nitobe,0,0,0,,Mày mà bước tới thêm bước nữa, con nhỏ này sẽ—
Dialogue: 0,0:02:13.70,0:02:18.39,Default,Shinpei,0,0,0,,Tôi nghĩ mình nên xóa sổ bất kỳ kẻ nào \Ndám làm tổn thương vợ mình khỏi thế gian này,
Dialogue: 0,0:02:18.71,0:02:22.50,Default,Shinpei,0,0,0,,nhưng nếu nàng bảo tôi \Nđừng giết hắn, tôi sẽ nghe theo.
Dialogue: 0,0:02:24.00,0:02:27.50,Default,Shinpei,0,0,0,,Tôi làm {\i1}tất cả{\i0} chuyện này đều là vì nàng.
Dialogue: 0,0:02:27.94,0:02:30.63,Default,Nitobe,0,0,0,,Thằng quái này bị làm sao thế? \NHắn làm tao nổi cả gai ốc!
Dialogue: 0,0:02:30.86,0:02:31.59,Default,Nitobe,0,0,0,,Cút ra ngoài!
Dialogue: 0,0:02:33.59,0:02:34.88,Default,Nitobe,0,0,0,,Con khốn này!
Dialogue: 0,0:02:51.84,0:02:54.35,Default,Satoko,0,0,0,,Đủ rồi! Hắn bất tỉnh rồi kìa—
Dialogue: 0,0:02:54.35,0:02:56.20,Default,Shinpei,0,0,0,,Chừng này vẫn còn nhẹ chán.
Dialogue: 0,0:02:56.55,0:02:59.13,Default,Shinpei,0,0,0,,Tôi phải làm cho hắn hối hận tột cùng \Nvì những gì đã gây ra cho nàng.
Dialogue: 0,0:02:59.13,0:03:01.05,Default,Satoko,0,0,0,,Dù vậy thì hắn cũng...
Dialogue: 0,0:03:01.86,0:03:03.45,Default,Satoko,0,0,0,,Xin thứ lỗi! Anh có nghe thấy tôi nói không?!
Dialogue: 0,0:03:16.16,0:03:18.01,Default,Satoko,0,0,0,,Tôi đã bảo anh dừng lại cơ mà!
Dialogue: 0,0:03:19.60,0:03:20.68,Default,Satoko,0,0,0,,Máu ư?!
Dialogue: 0,0:03:20.93,0:03:23.91,Default,Satoko,0,0,0,,Tôi xin lỗi! Tại tôi lỡ tay quá đà!
Dialogue: 0,0:03:23.91,0:03:27.60,Default,Shinpei,0,0,0,,Đau đấy... Chảy máu rồi này.
Dialogue: 0,0:03:27.60,0:03:29.76,Default,Shinpei,0,0,0,,Lau máu cho tôi đi, Satoko.
Dialogue: 0,0:03:29.76,0:03:31.77,Default,Shinpei,0,0,0,,Lấy khăn tay lau cho tôi đi.
Dialogue: 0,0:03:31.77,0:03:33.71,Default,Satoko,0,0,0,,Phải xử lý vết thương trúng đạn của anh trước đã.
Dialogue: 0,0:03:33.71,0:03:37.82,Default,Shinpei,0,0,0,,Mặc kệ vết đạn đó đi. \NHãy dịu dàng lau trán cho tôi nào.
Dialogue: 0,0:03:43.73,0:03:44.75,Default,Satoko,0,0,0,,Ừm...
Dialogue: 0,0:03:45.28,0:03:48.17,Default,Satoko,0,0,0,,Cảm ơn anh vì đã cứu tôi.
Dialogue: 0,0:03:50.39,0:03:53.42,Default,Shinpei,0,0,0,,Sao nào? Giờ nàng đã yêu tôi nhiều hơn chút nào chưa?
Dialogue: 0,0:03:53.42,0:03:54.76,Default,Satoko,0,0,0,,Không hề.
Dialogue: 0,0:03:54.76,0:03:57.80,Default,Sign,0,0,0,,{\an8\shad0\b1\blur0.2\an7\move(172,78,164,72)\bord1.6\fs25\t(\fs26)\3c&HDEDCDD&\c&H020202&}Sụp đổ
Dialogue: 0,0:03:55.59,0:03:57.80,Default,Satoko,0,0,0,,Ơ-Ờ, không phải, ý tôi là...
Dialogue: 0,0:03:58.35,0:04:01.26,Default,Satoko,0,0,0,,Anh làm chuyện gì cũng đi quá giới hạn cả.
Dialogue: 0,0:04:01.26,0:04:04.31,Default,Satoko,0,0,0,,Hành xử kiểu đó không làm tôi rung động đâu.
Dialogue: 0,0:04:05.03,0:04:07.56,Default,Satoko,0,0,0,,Do cái nghề của anh, \Ncó lẽ anh không hiểu điều này,
Dialogue: 0,0:04:07.56,0:04:09.59,Default,Satoko,0,0,0,,nhưng bạo lực là sai trái.
Dialogue: 0,0:04:09.59,0:04:12.30,Default,Satoko,0,0,0,,Đấm đá người khác \Nvốn dĩ là hành vi hết sức man rợ.
Dialogue: 0,0:04:12.83,0:04:14.32,Default,Satoko,0,0,0,,Để tôi nói rõ cho anh biết.
Dialogue: 0,0:04:14.66,0:04:17.57,Default,Satoko,0,0,0,,Anh tuyệt đối không được giết người, \Nbất kể đối phương là ai đi chăng nữa.
Dialogue: 0,0:04:18.45,0:04:20.57,Default,Shinpei,0,0,0,,Nhưng chẳng phải lấy đèn lồng phang người ta cũng là bạo—
Dialogue: 0,0:04:20.57,0:04:21.82,Default,Satoko,0,0,0,,Và còn một chuyện nữa.
Dialogue: 0,0:04:22.35,0:04:25.33,Default,Satoko,0,0,0,,Anh đang bị trúng đạn thì đừng có cử động mạnh.
Dialogue: 0,0:04:25.33,0:04:29.83,Default,Satoko,0,0,0,,Anh mất quá nhiều máu rồi đấy. \NCũng chẳng trách được khi anh cứ làm loạn như thế.
Dialogue: 0,0:04:30.51,0:04:33.84,Default,Satoko,0,0,0,,Nếu anh lăn ra chết thì anh tính bắt tôi phải làm sao đây?
Dialogue: 0,0:04:36.92,0:04:39.21,Default,Shinpei,0,0,0,,Nàng không muốn tôi chết sao?
Dialogue: 0,0:04:39.21,0:04:41.43,Default,Satoko,0,0,0,,Tôi không trả lời câu hỏi đó đâu.
Dialogue: 0,0:04:42.13,0:04:44.99,Default,Shinpei,0,0,0,,Chuyện này hơi khác xa \Nso với những gì tôi hình dung đấy.
Dialogue: 0,0:04:44.99,0:04:48.31,Default,Satoko,0,0,0,,Tôi sẽ đi gọi người. Anh nằm xuống nghỉ đi.
Dialogue: 0,0:04:50.73,0:04:53.61,Default,Nitobe,0,0,0,,Thành thật xin lỗi tiểu thư!
Dialogue: 0,0:04:53.61,0:04:57.09,Default,Nitobe,0,0,0,,Nằm mơ tôi cũng không ngờ lúc say rượu \Nmình lại làm ra hành vi đồi bại đến thế.
Dialogue: 0,0:04:57.47,0:04:59.61,Default,Nitobe,0,0,0,,Tôi thực sự không biết phải chuộc lỗi với cô thế nào.
Dialogue: 0,0:04:59.61,0:05:02.61,Default,Satoko,0,0,0,,Nếu vậy, ngài có thể giúp tôi một việc được không?
Dialogue: 0,0:05:02.61,0:05:04.12,Default,Nitobe,0,0,0,,Bất cứ việc gì cũng được!
Dialogue: 0,0:05:04.67,0:05:07.62,Default,Satoko,0,0,0,,Vậy xin ngài hãy chuyển một lời nhắn \Nđến gia tộc Kirigaya giúp tôi.
Dialogue: 0,0:05:08.33,0:05:12.18,Default,Satoko,0,0,0,,Hãy báo với họ rằng Satoko đang bị giam cầm \Ntrên một hòn đảo biệt lập kiên cố,
Dialogue: 0,0:05:12.18,0:05:14.21,Default,Satoko,0,0,0,,nhưng nhất định cô ấy sẽ sống sót trở về nhà.
Dialogue: 0,0:05:14.63,0:05:17.61,Default,Nitobe,0,0,0,,Được thôi. Tôi xin hứa sẽ chuyển lời.
Dialogue: 0,0:05:18.08,0:05:21.67,Default,Nitobe,0,0,0,,Còn cậu nữa... Tôi thực sự {\i1}rất{\i0} lấy làm tiếc \Nvề phát súng vừa rồi.
Dialogue: 0,0:05:22.13,0:05:25.97,Default,Shinpei,0,0,0,,Nếu chuyện tương tự còn tái diễn lần nữa, \Ntôi sẽ giết ông đấy.
Dialogue: 0,0:05:26.43,0:05:28.52,Default,Shinpei,0,0,0,,Vậy nên cứ yên tâm \Nmà năng ghé lại đây chơi nhé.
Dialogue: 0,0:05:30.57,0:05:32.69,Default,Nitobe,0,0,0,,Tôi là bậc quân tử nhất ngôn cửu đỉnh!
Dialogue: 0,0:05:32.69,0:05:33.67,Default,Nitobe,0,0,0,,Xin cáo từ!
Dialogue: 0,0:05:34.53,0:05:36.46,Default,Shinpei,0,0,0,,Lần sau lại ghé nhé.
Dialogue: 0,0:05:37.05,0:05:38.56,Default,Satoko,0,0,0,,Tôi xin lỗi.
Dialogue: 0,0:05:39.15,0:05:42.47,Default,Satoko,0,0,0,,Vì sai lầm của tôi mà anh mới phải nhận vết thương đó.
Dialogue: 0,0:05:42.47,0:05:44.62,Default,Shinpei,0,0,0,,Đừng bận tâm. Tôi quen với chuyện này rồi.
Dialogue: 0,0:05:45.30,0:05:46.74,Default,Shinpei,0,0,0,,Quan trọng hơn là...
Dialogue: 0,0:05:46.74,0:05:49.71,Default,Shinpei,0,0,0,,Trong chén của hắn toàn là rượu sake.
Dialogue: 0,0:05:50.47,0:05:52.58,Default,Shinpei,0,0,0,,Có kẻ đã giở trò sau lưng.
Dialogue: 0,0:05:54.20,0:05:55.83,Default,Shinpei,0,0,0,,Còn nàng thì sao, Satoko?
Dialogue: 0,0:05:56.38,0:05:59.84,Default,Shinpei,0,0,0,,Trải qua từng ấy chuyện, \Nvết thương của nàng có bị đau không?
Dialogue: 0,0:06:00.36,0:06:02.67,Default,Satoko,0,0,0,,V-Vết thương của tôi ư?
Dialogue: 0,0:06:03.06,0:06:06.52,Italics,Satoko {M},0,0,0,,Anh ta đã nghe lỏm được tới đâu rồi?
Dialogue: 0,0:06:07.36,0:06:09.53,Italics,Satoko {M},0,0,0,,Chẳng lẽ anh ta đã nhìn thấy vết sẹo của mình?
Dialogue: 0,0:06:09.53,0:06:10.40,Default,Shinpei,0,0,0,,Satoko này.
Dialogue: 0,0:06:13.56,0:06:15.36,Default,Satoko,0,0,0,,S-Sao anh lại cởi trần thế kia?!
Dialogue: 0,0:06:15.36,0:06:16.52,Default,Shinpei,0,0,0,,Trên người tôi chằng chịt vết sẹo đây này. Thấy không?
Dialogue: 0,0:06:18.37,0:06:22.57,Default,Shinpei,0,0,0,,So với đống sẹo của tôi, \Nvết sẹo của nàng chẳng đáng phải bận tâm đâu.
Dialogue: 0,0:06:27.33,0:06:30.89,Italics,Satoko {M},0,0,0,,Có lẽ đây lại là một nỗ lực khác \Nđể dỗ dành mình theo cách riêng của anh ta.
Dialogue: 0,0:06:32.03,0:06:35.32,Italics,Satoko {M},0,0,0,,Mình đã che giấu vết sẹo này \Nsuốt từ thuở còn thơ bé.
Dialogue: 0,0:06:36.36,0:06:38.58,Italics,Satoko {M},0,0,0,,Thế nhưng chẳng hiểu sao, anh ta lại khiến mình...
Dialogue: 0,0:06:39.51,0:06:43.88,Default,Satoko,0,0,0,,Vết sẹo của tôi to hơn \Nvà sâu hơn bất kỳ vết sẹo nào của anh đấy.
Dialogue: 0,0:06:44.90,0:06:48.31,Default,Satoko,0,0,0,,Ấn tượng lắm đúng không? \NĐó là huy chương danh dự của tôi đấy.
Dialogue: 0,0:06:48.31,0:06:51.64,Italics,Satoko {M},0,0,0,,Anh ta khiến mình muốn trút bỏ mọi lớp phòng bị trước mặt anh.
Dialogue: 0,0:06:55.59,0:06:57.98,Default,Shinpei,0,0,0,,Nhưng về số lượng thì tôi vẫn nhiều hơn đấy nhé.
Dialogue: 0,0:06:57.98,0:07:00.50,Default,Satoko,0,0,0,,Chuyện này đâu cần phải đem ra thi đua.
Dialogue: 0,0:07:01.61,0:07:04.91,Default,Satoko,0,0,0,,Quan trọng hơn là chúng ta cần tìm \Nmột con đường khác để rời khỏi hòn đảo này.
Dialogue: 0,0:07:04.91,0:07:07.28,Default,Shinpei,0,0,0,,Ừm, nàng nói phải.
Dialogue: 0,0:07:08.16,0:07:11.63,Default,Satoko,0,0,0,,Nếu chúng ta dò hỏi khắp đảo, biết đâu...
Dialogue: 0,0:07:11.63,0:07:13.83,Default,Shinpei,0,0,0,,Nhưng nếu đi lại nhiều quá sẽ...
Dialogue: 0,0:07:15.71,0:07:17.37,Default,Shinpei,0,0,0,,Khoan đã, nàng có sao không?!
Dialogue: 0,0:07:17.37,0:07:18.57,Default,Satoko,0,0,0,,Tôi xin lỗi...
Dialogue: 0,0:07:19.53,0:07:20.94,Default,Satoko,0,0,0,,Một khi cơn đau đã phát tác, tôi không thể...
Dialogue: 0,0:07:26.26,0:07:27.29,Default,Satoko,0,0,0,,Hơ?
Dialogue: 0,0:07:29.18,0:07:30.25,Default,Shinpei,0,0,0,,Satoko!
Dialogue: 0,0:07:33.31,0:07:36.72,Flashback,Girls,0,0,0,,Các cậu đi đâu thế? Đi tới Higo.
Dialogue: 0,0:07:36.72,0:07:40.48,Flashback,Girls,0,0,0,,Đâu ở Higo cơ? Tới Kumamoto.
Dialogue: 0,0:07:40.48,0:07:42.11,Flashback,Girls,0,0,0,,Đâu ở Kumamoto cơ?
Dialogue: 0,0:07:43.34,0:07:44.62,Flashback,Young Satoko,0,0,0,,Mẫu thân!
Dialogue: 0,0:07:45.91,0:07:48.86,Flashback,Young Satoko,0,0,0,,Con xin phép ra ngoài một lát được không ạ? Chỉ một chút thôi.
Dialogue: 0,0:07:48.86,0:07:51.18,Flashback,Rie,0,0,0,,Tất nhiên là không được.
Dialogue: 0,0:07:51.18,0:07:53.70,Flashback,Rie,0,0,0,,Con mới vừa dứt cơn sốt cách đây ba ngày thôi.
Dialogue: 0,0:07:53.70,0:07:56.16,Flashback,Young Satoko,0,0,0,,Con chỉ đứng nhìn Miwako và các bạn chơi thôi ạ.
Dialogue: 0,0:07:56.16,0:07:58.47,Flashback,Young Satoko,0,0,0,,Con xin hứa sẽ không tham gia \Nvào trò chơi của các bạn đâu.
Dialogue: 0,0:07:59.59,0:08:04.63,Flashback,Rie,0,0,0,,Xem ra con vẫn chưa hiểu \Nmình sinh ra trên đời này để làm gì nhỉ.
Dialogue: 0,0:08:04.94,0:08:07.63,Flashback,Rie,0,0,0,,Con là tài sản của gia tộc Kirigaya.
Dialogue: 0,0:08:07.63,0:08:09.38,Flashback,Rie,0,0,0,,Nói cách khác, chỉ là một món công cụ.
Dialogue: 0,0:08:09.75,0:08:12.70,Flashback,Rie,0,0,0,,Ngày thường vốn dĩ con đã là gánh nặng của cái nhà này rồi,
Dialogue: 0,0:08:12.70,0:08:15.64,Flashback,Rie,0,0,0,,vậy nên ít nhất hãy làm tròn bổn phận của mình đi.
Dialogue: 0,0:08:15.64,0:08:18.66,Flashback,Rie,0,0,0,,Đừng có mơ tưởng rằng mình có quyền tự do.
Dialogue: 0,0:08:19.33,0:08:20.47,Default,Shinpei,0,0,0,,Satoko.
Dialogue: 0,0:08:21.83,0:08:22.91,Default,Shinpei,0,0,0,,Satoko.
Dialogue: 0,0:08:24.11,0:08:25.53,Default,Shinpei,0,0,0,,Satoko.
Dialogue: 0,0:08:26.31,0:08:27.40,Default,Shinpei,0,0,0,,Nàng tỉnh rồi à? Có sao không?
Dialogue: 0,0:08:29.47,0:08:30.66,Default,Satoko,0,0,0,,Đây là đâu...
Dialogue: 0,0:08:31.11,0:08:33.29,Default,Shinpei,0,0,0,,Một căn phòng ở Isekichi.
Dialogue: 0,0:08:33.29,0:08:36.04,Default,Shinpei,0,0,0,,Nàng đột nhiên ngất xỉu, \Nnên tôi nhờ người đưa nàng vào đây.
Dialogue: 0,0:08:36.40,0:08:38.47,Italics,Satoko {M},0,0,0,,Lại nữa rồi...
Dialogue: 0,0:08:38.47,0:08:40.04,Default,Shinpei,0,0,0,,May quá đi mất.
Dialogue: 0,0:08:40.04,0:08:43.21,Default,Shinpei,0,0,0,,Nàng mê man suốt ba ngày trời, \Nlàm tôi lo đến thắt ruột.
Dialogue: 0,0:08:43.21,0:08:44.65,Default,Satoko,0,0,0,,Suốt ba ngày liền ư?
Dialogue: 0,0:08:45.27,0:08:47.55,Default,Satoko,0,0,0,,Tôi xin lỗi. Tôi lại...
Dialogue: 0,0:08:47.55,0:08:48.86,Default,Shinpei,0,0,0,,Không sao đâu.
Dialogue: 0,0:08:48.86,0:08:52.14,Default,Shinpei,0,0,0,,Chăm sóc khi vợ đau ốm \Nvốn là nghĩa vụ của người làm chồng mà.
Dialogue: 0,0:08:52.40,0:08:54.97,Default,Shinpei,0,0,0,,Quan trọng hơn là \Nlúc ngủ nàng cứ rên rỉ mãi.
Dialogue: 0,0:08:55.40,0:08:57.03,Default,Shinpei,0,0,0,,Nàng gặp ác mộng sao?
Dialogue: 0,0:08:59.55,0:09:02.48,Default,Satoko,0,0,0,,Tôi mơ về hồi còn nhỏ.
Dialogue: 0,0:09:03.16,0:09:06.82,Default,Satoko,0,0,0,,Hồi ấy cơ thể tôi còn yếu ớt \Nhơn bây giờ rất nhiều.
Dialogue: 0,0:09:07.23,0:09:09.30,Default,Satoko,0,0,0,,Mỗi lần tôi đổ bệnh,
Dialogue: 0,0:09:09.30,0:09:12.85,Default,Satoko,0,0,0,,tôi đều bị cấm bước chân ra khỏi nhà suốt một thời gian dài, \Nngay cả khi đã bình phục.
Dialogue: 0,0:09:14.21,0:09:18.95,Default,Satoko,0,0,0,,Ý nghĩ phải chết dần chết mòn trong cô độc \Nnhư thế khiến tôi vô cùng khiếp sợ.
Dialogue: 0,0:09:22.10,0:09:23.33,Default,Shinpei,0,0,0,,Đợi tôi một lát nhé.
Dialogue: 0,0:09:28.34,0:09:29.30,Default,Shinpei,0,0,0,,Để nàng đợi lâu rồi.
Dialogue: 0,0:09:31.63,0:09:33.14,Default,Shinpei,0,0,0,,Tôi thổi tắt đèn một chút nhé.
Dialogue: 0,0:09:48.50,0:09:50.33,Default,Shinpei,0,0,0,,Tôi bắt được chúng ở ngoài bờ sông đấy.
Dialogue: 0,0:09:50.75,0:09:52.99,Default,Shinpei,0,0,0,,Thế này thì trong phòng cũng giống hệt ngoài trời rồi.
Dialogue: 0,0:09:57.10,0:10:01.04,Default,Shinpei,0,0,0,,Cho dù chúng ta có đi tới đâu, Satoko à, \Ntôi cũng sẽ trả lại tự do cho nàng.
Dialogue: 0,0:10:03.99,0:10:05.85,Italics,Satoko {M},0,0,0,,Thật là một con người kỳ lạ.
Dialogue: 0,0:10:06.28,0:10:09.23,Italics,Satoko {M},0,0,0,,Rõ ràng mình luôn cảm thấy anh ta \Nđáng sợ, thế nhưng...
Dialogue: 0,0:10:09.23,0:10:10.53,Default,Shinpei,0,0,0,,Nàng biết không...
Dialogue: 0,0:10:11.63,0:10:15.05,Default,Shinpei,0,0,0,,Tôi nghe nói đom đóm dành \Nphần lớn cuộc đời ở dưới nước.
Dialogue: 0,0:10:15.45,0:10:18.81,Default,Shinpei,0,0,0,,Sau khi bay lên bầu trời, \Nchẳng bao lâu sau chúng sẽ chết.
Dialogue: 0,0:10:19.79,0:10:22.31,Default,Shinpei,0,0,0,,Có lẽ để bù đắp cho điều đó, \Nchúng mới tỏa sáng rực rỡ đến vậy.
Dialogue: 0,0:10:29.31,0:10:31.19,Default,Shinpei,0,0,0,,Hở? Chắc con này đang thấy trong người không khỏe rồi.
Dialogue: 0,0:10:38.87,0:10:43.12,Default,Satoko,0,0,0,,Ừm, tôi thực sự rất trân trọng tấm lòng của anh,
Dialogue: 0,0:10:43.12,0:10:44.92,Default,Satoko,0,0,0,,nhưng phiền anh cho tôi thả chúng ra ngoài được không?
Dialogue: 0,0:10:46.75,0:10:51.25,Default,Satoko,0,0,0,,Nếu vòng đời của chúng ngắn ngủi như thế, \Nthì thay vì giam cầm chúng trong căn phòng này...
Dialogue: 0,0:10:54.69,0:10:58.49,Default,Satoko,0,0,0,,tôi muốn để đàn đom đóm được tự do \Ntỏa sáng ở bất cứ nơi nào chúng muốn.
Dialogue: 0,0:11:06.45,0:11:08.44,Default,Shinpei,0,0,0,,Nàng thật dịu dàng quá đỗi, Satoko.
Dialogue: 0,0:11:09.49,0:11:10.75,Default,Shinpei,0,0,0,,À, tôi nghĩ ra rồi.
Dialogue: 0,0:11:10.75,0:11:14.96,Default,Shinpei,0,0,0,,Khi nào trốn thoát khỏi đây, chúng mình hãy dựng một ngôi nhà \Nnơi mỗi năm đom đóm đều bay về nhé.
Dialogue: 0,0:11:14.96,0:11:19.70,Default,Shinpei,0,0,0,,Gần đó sẽ có một dòng sông, \Nđể mùa hè hai đứa mình cùng bơi lội và bắt cá.
Dialogue: 0,0:11:20.20,0:11:22.71,Default,Satoko,0,0,0,,Tôi chưa từng tắm sông bao giờ cả.
Dialogue: 0,0:11:22.71,0:11:24.45,Default,Shinpei,0,0,0,,Hả? Thật sao?
Dialogue: 0,0:11:24.74,0:11:27.71,Default,Satoko,0,0,0,,Nhưng có lẽ tôi cũng muốn thử xem sao.
Dialogue: 0,0:11:27.71,0:11:29.88,Default,Shinpei,0,0,0,,Tất nhiên là nàng sẽ thích mê cho xem. Quyết định vậy nhé!
Dialogue: 0,0:11:30.39,0:11:34.21,Default,Shinpei,0,0,0,,Tôi muốn dành trọn mọi khoảnh khắc bên nàng, \Nnên có lẽ tôi sẽ bớt nhận việc lại.
Dialogue: 0,0:11:36.66,0:11:40.18,Default,Satoko,0,0,0,,Anh định sống cả đời \Nbằng nghề sát thủ đánh thuê đấy ư?
Dialogue: 0,0:11:40.52,0:11:41.82,Default,Shinpei,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:11:41.82,0:11:45.14,Default,Shinpei,0,0,0,,Nếu tước bỏ việc giết chóc khỏi tôi, \Nthì tôi chẳng còn lại gì cả.
Dialogue: 0,0:11:45.78,0:11:48.96,Default,Shinpei,0,0,0,,Vả lại tôi cũng cần tiền \Nđể mang lại hạnh phúc cho nàng, đúng không?
Dialogue: 0,0:11:51.01,0:11:56.89,Default,Satoko,0,0,0,,Mọi dự định của anh dường như đều xoay quanh tôi. \NVậy còn bản thân {\i1}anh{\i0} muốn làm gì?
Dialogue: 0,0:11:57.74,0:12:00.74,Default,Satoko,0,0,0,,Anh thực sự sẵn lòng từ bỏ \Nnơi chôn nhau cắt rốn vì cuộc hôn nhân này sao?
Dialogue: 0,0:12:01.08,0:12:04.16,Default,Shinpei,0,0,0,,Tôi chẳng có gì vương vấn \Nvới cái hòn đảo này cả.
Dialogue: 0,0:12:04.16,0:12:05.66,Default,Satoko,0,0,0,,Thế còn cha mẹ anh thì sao?
Dialogue: 0,0:12:05.66,0:12:07.66,Default,Shinpei,0,0,0,,Tôi chẳng biết cha mình là ai.
Dialogue: 0,0:12:07.98,0:12:13.08,Default,Shinpei,0,0,0,,Còn người mẹ kỹ nữ của tôi thì bị một gã khách làng chơi \Ngiết chết khi tôi còn nhỏ.
Dialogue: 0,0:12:13.08,0:12:18.18,Default,Shinpei,0,0,0,,Gã đàn ông giết mẹ tôi \Nchính là kẻ đầu tiên tôi xuống tay sát hại.
Dialogue: 0,0:12:18.91,0:12:21.43,Default,Shinpei,0,0,0,,Nhưng tôi vẫn nhớ như in từng chi tiết.
Dialogue: 0,0:12:21.43,0:12:23.93,Default,Shinpei,0,0,0,,Hắn đã quằn quại trong đau đớn.
Dialogue: 0,0:12:24.53,0:12:26.70,Default,Shinpei,0,0,0,,Cảm giác lúc đó thật sự rất tuyệt.
Dialogue: 0,0:12:30.43,0:12:32.09,Default,Shinpei,0,0,0,,Nàng thấy thương hại tôi sao?
Dialogue: 0,0:12:33.08,0:12:36.07,Default,Shinpei,0,0,0,,Vậy thì ước gì nàng sẽ an ủi tôi nhỉ.
Dialogue: 0,0:12:36.07,0:12:39.40,Default,Shinpei,0,0,0,,Cuộc đời tôi bi thảm quá đi mất. Hu hu.
Dialogue: 0,0:12:39.40,0:12:44.20,Default,Satoko,0,0,0,,Lúc nào anh cũng che giấu lòng mình \Nđằng sau vẻ cợt nhả đó sao?
Dialogue: 0,0:12:47.69,0:12:51.42,Default,Satoko,0,0,0,,Tôi tin chắc anh cũng khao khát thoát khỏi hòn đảo này \Nkhông kém gì tôi.
Dialogue: 0,0:12:53.27,0:12:55.67,Default,Satoko,0,0,0,,Cố tình lảng tránh \Ncũng chẳng thay đổi được thực tại đâu.
Dialogue: 0,0:12:56.30,0:12:58.73,Default,Satoko,0,0,0,,Chạy trốn khỏi đây mới là hướng đi tích cực hơn.
Dialogue: 0,0:13:01.23,0:13:05.68,Default,Satoko,0,0,0,,Hãy cùng tôi rời khỏi nơi này và giành lấy tự do.
Dialogue: 0,0:13:08.23,0:13:10.44,Default,Shinpei,0,0,0,,Nàng chịu cao chạy xa bay cùng tôi sao?
Dialogue: 0,0:13:11.44,0:13:12.53,Default,Satoko,0,0,0,,Vâng.
Dialogue: 0,0:13:12.53,0:13:14.51,Italics,Satoko {M},0,0,0,,Nhưng chỉ cho đến khi bọn mình thoát khỏi hòn đảo này thôi.
Dialogue: 0,0:13:15.44,0:13:16.98,Default,Shinpei,0,0,0,,Tôi mừng lắm.
Dialogue: 0,0:13:16.98,0:13:19.36,Default,Shinpei,0,0,0,,Nếu vậy, chúng ta sẽ cần \Nmột kế hoạch đào tẩu mới—
Dialogue: 0,0:13:19.67,0:13:21.61,Default,Shinpei,0,0,0,,Hửm? Băng gạc của tôi bung ra rồi.
Dialogue: 0,0:13:21.61,0:13:24.25,Default,Shinpei,0,0,0,,Mà tự quấn lại thì phiền phức lắm.
Dialogue: 0,0:13:28.75,0:13:31.50,Default,Satoko,0,0,0,,Tôi lúc nào cũng phải dựa vào sự bảo vệ của anh.
Dialogue: 0,0:13:31.50,0:13:33.96,Default,Satoko,0,0,0,,Xin lỗi vì tôi không thể làm được gì nhiều hơn để báo đáp anh.
Dialogue: 0,0:13:34.24,0:13:37.59,Default,Shinpei,0,0,0,,Những gì nàng làm cho tôi hiện tại \Nđã đủ khiến tôi hạnh phúc lắm rồi.
Dialogue: 0,0:13:39.51,0:13:42.29,Italics,Satoko {M},0,0,0,,Việc không thể làm được gì nhiều hơn \Nthật sự khiến mình bức bối.
Dialogue: 0,0:13:42.98,0:13:45.95,Italics,Satoko {M},0,0,0,,Anh ta sẵn sàng chịu thương tích \Nđể giữ mình ở bên cạnh.
Dialogue: 0,0:13:45.95,0:13:51.23,Italics,Satoko {M},0,0,0,,Nếu mình không thể trở nên có ích, \Nmình sẽ chỉ mãi là một gánh nặng.
Dialogue: 0,0:13:51.91,0:13:52.95,Default,Shinpei,0,0,0,,Tuyệt thật đấy.
Dialogue: 0,0:13:53.60,0:13:54.84,Default,Shinpei,0,0,0,,Cảm ơn nàng nhé, Satoko.
Dialogue: 0,0:13:55.71,0:13:57.65,Default,Shinpei,0,0,0,,Đây là quà cảm ơn vì đã băng bó cho tôi.
Dialogue: 0,0:13:59.83,0:14:02.66,Default,Shinpei,0,0,0,,A, hạnh phúc quá đi mất.
Dialogue: 0,0:14:02.99,0:14:06.33,Default,Shinpei,0,0,0,,Chỉ cần có nàng ở bên cạnh thế này là đủ rồi.
Dialogue: 0,0:14:08.66,0:14:09.90,Default,Shinpei,0,0,0,,Nào.
Dialogue: 0,0:14:10.78,0:14:13.29,Default,Shinpei,0,0,0,,Cơ thể nàng vẫn đang hồi phục, \Nhãy quay lại giường nghỉ ngơi đi.
Dialogue: 0,0:14:15.03,0:14:16.33,Default,Satoko,0,0,0,,Được rồi.
Dialogue: 0,0:14:16.87,0:14:18.50,Italics,Satoko {M},0,0,0,,Kỳ lạ thật.
Dialogue: 0,0:14:19.12,0:14:23.01,Italics,Satoko {M},0,0,0,,Mình bỗng dưng lại để tâm đến anh ta một cách lạ thường.
Dialogue: 0,0:14:23.26,0:14:25.34,Default,Shinpei,0,0,0,,Nàng nhẹ cân thật đấy.
Dialogue: 0,0:14:25.34,0:14:27.01,Default,Satoko,0,0,0,,Tôi không nghĩ vậy đâu.
Dialogue: 0,0:14:27.23,0:14:29.81,Default,Shinpei,0,0,0,,Nàng là cô gái nhẹ nhất mà tôi từng bế đấy.
Dialogue: 0,0:14:32.01,0:14:33.56,Default,Satoko,0,0,0,,Nghe câu đó tôi chẳng thấy vui chút nào.
Dialogue: 0,0:14:33.56,0:14:35.89,Default,Shinpei,0,0,0,,Ủa? Trước giờ chưa ai nói với tôi như thế cả.
Dialogue: 0,0:14:35.89,0:14:38.42,Default,Shinpei,0,0,0,,Ai cũng thích được khen \Nlà mình mảnh mai nhẹ cân mà.
Dialogue: 0,0:14:42.15,0:14:43.92,Default,Satoko,0,0,0,,Cảm ơn anh rất nhiều.
Dialogue: 0,0:14:44.99,0:14:47.15,Default,Satoko,0,0,0,,Chắc hẳn anh đã quá quen với mấy chuyện bế bồng này rồi nhỉ.
Dialogue: 0,0:14:47.15,0:14:48.33,Default,Shinpei,0,0,0,,Đâu có đâu.
Dialogue: 0,0:14:50.22,0:14:51.49,Default,Satoko,0,0,0,,Ừm...
Dialogue: 0,0:14:51.82,0:14:56.25,Default,Satoko,0,0,0,,Tôi biết chuyện này đã hỏi rồi, \Nnhưng rốt cuộc anh thích điểm gì ở tôi chứ?
Dialogue: 0,0:14:56.25,0:14:57.75,Default,Shinpei,0,0,0,,Tôi thích tất cả mọi thứ thuộc về nàng,
Dialogue: 0,0:14:58.23,0:15:01.00,Default,Shinpei,0,0,0,,nhưng có lẽ khoảnh khắc tuyệt nhất \Nlà khi nàng chấp nhận con người tôi.
Dialogue: 0,0:15:02.24,0:15:05.85,Italics,Satoko {M},0,0,0,,Giờ thì mình đã hiểu vì sao anh ta lại đồng ý \Nlời cầu hôn đột ngột đến thế.
Dialogue: 0,0:15:06.53,0:15:09.35,Italics,Satoko {M},0,0,0,,Anh ta vốn chẳng hề yêu mình.
Dialogue: 0,0:15:10.55,0:15:14.62,Default,Satoko,0,0,0,,Vậy ra chỉ cần là người chấp nhận anh, \Nthì bất kỳ ai cũng được cả thôi.
Dialogue: 0,0:15:15.12,0:15:17.82,Default,Shinpei,0,0,0,,Không phải. Người tôi muốn cưới làm vợ là nàng, Satoko.
Dialogue: 0,0:15:17.82,0:15:21.61,Default,Satoko,0,0,0,,Liệu người ta có thể yêu sâu đậm một người \Nmới chỉ quen biết vài ngày đến mức đó sao?
Dialogue: 0,0:15:21.96,0:15:25.95,Default,Satoko,0,0,0,,Ngay từ đầu, một kẻ sát thủ như anh \Ncó thực sự hiểu tình yêu là gì không?
Dialogue: 0,0:15:25.95,0:15:31.70,Default,Satoko,0,0,0,,Tôi dám chắc thứ tình cảm anh dành cho tôi \Ncũng chỉ giống như thích một đứa trẻ hay con thú cưng mà thôi.
Dialogue: 0,0:15:32.96,0:15:35.05,Italics,Satoko {M},0,0,0,,Mình biết mình đang vô cớ gây sự.
Dialogue: 0,0:15:35.36,0:15:38.38,Italics,Satoko {M},0,0,0,,Bản thân mình cũng đâu có yêu anh ta.
Dialogue: 0,0:15:38.82,0:15:41.71,Default,Shinpei,0,0,0,,Vậy nàng có biết tình yêu là gì không?
Dialogue: 0,0:15:43.03,0:15:46.13,Default,Satoko,0,0,0,,T-Tình yêu ấy à, thì là...
Dialogue: 0,0:15:46.42,0:15:48.98,Default,Satoko,0,0,0,,là cảm giác trân trọng và lo nghĩ cho một người.
Dialogue: 0,0:15:48.98,0:15:50.39,Default,Satoko,0,0,0,,Nói cách khác...
Dialogue: 0,0:15:50.90,0:15:53.06,Default,Satoko,0,0,0,,đó là thứ tình cảm phải cùng nhau vun đắp qua năm tháng.
Dialogue: 0,0:15:55.60,0:15:57.95,Italics,Satoko {M},0,0,0,,Mình cũng chỉ biết định nghĩa nó một cách sách vở trừu tượng!
Dialogue: 0,0:15:58.70,0:16:01.75,Default,Satoko,0,0,0,,Dù sao đi nữa, anh không nên \Nbuông lời nói chuyện hôn nhân một cách tùy tiện như thế.
Dialogue: 0,0:16:01.75,0:16:04.11,Default,Shinpei,0,0,0,,Satoko, nàng đang giận chuyện gì thế?
Dialogue: 0,0:16:04.71,0:16:07.20,Default,Shinpei,0,0,0,,Tôi đã lỡ lời nói sai câu nào sao?
Dialogue: 0,0:16:08.22,0:16:10.66,Default,Satoko,0,0,0,,Không có gì. Tôi đi ngủ đây.
Dialogue: 0,0:16:10.93,0:16:13.66,Default,Shinpei,0,0,0,,Satoko, tôi yêu nàng.
Dialogue: 0,0:16:16.75,0:16:19.08,Default,Shinpei,0,0,0,,Chúng mình sẽ kết hôn với nhau, đúng không?
Dialogue: 0,0:16:20.99,0:16:22.34,Default,Satoko,0,0,0,,Ai mà biết được chứ?
Dialogue: 0,0:16:25.11,0:16:26.92,Default,Shinpei,0,0,0,,Chúng mình không cưới nhau sao?
Dialogue: 0,0:16:27.31,0:16:29.46,Default,Shinpei,0,0,0,,Chẳng lẽ lời hứa kết hôn với tôi là nói dối ư?
Dialogue: 0,0:16:30.91,0:16:32.33,Default,Shinpei,0,0,0,,Tôi đã nói với nàng rồi, nàng còn nhớ không?
Dialogue: 0,0:16:33.51,0:16:37.81,Default,Shinpei,0,0,0,,Nếu nàng nuốt lời hứa, \Nthì chi bằng cả hai đứa mình cùng—
Dialogue: 0,0:16:37.81,0:16:40.10,Default,Satoko,0,0,0,,Tôi ngủ đây.
Dialogue: 0,0:16:43.16,0:16:47.02,Italics,Satoko {M},0,0,0,,Trời đất ơi, mình đang nghĩ cái quái gì thế này?
Dialogue: 0,0:16:47.02,0:16:49.70,Italics,Satoko {M},0,0,0,,Anh ta đâu có làm gì sai.
Dialogue: 0,0:16:50.03,0:16:52.17,Italics,Satoko {M},0,0,0,,Thế nhưng chẳng hiểu sao lòng mình lại bực bội.
Dialogue: 0,0:16:52.48,0:16:55.20,Italics,Satoko {M},0,0,0,,Mình chỉ thấy tức giận với anh ta vô cùng.
Dialogue: 0,0:16:55.20,0:16:58.33,Italics,Satoko {M},0,0,0,,Rốt cuộc mình bị {\i0}làm sao{\i1} thế này?
Dialogue: 0,0:16:55.43,0:16:56.95,Default,Sign,0,0,0,,{\fad(750,0)\shad0\blur0.2\b1\fs15.5\t(\fs15.75)\bord1.8\move(232,72,231,77)\3c&HDDD7D4&\c&H412E26&}Ủ rũ
Dialogue: 0,0:16:56.95,0:16:59.96,Default,Sign,0,0,0,,{\shad0\blur0.2\b1\fs15.75\t(\fs16)\bord1.8\move(231,77,231,76)\3c&HDDD7D4&\c&H412E26&}Ủ rũ
Dialogue: 0,0:16:59.96,0:17:04.48,Default,Sign,0,0,0,,{\fad(0,1500)\fnSegoe UI\fs18\bord0\shad0\b1\fscx90\pos(563,170)\c&H020101&}Hôn Nhân\NĐom Đóm
Dialogue: 0,0:16:59.96,0:17:02.79,Default,Sign,0,0,0,,{\fnSegoe UI\b1\bord0\shad0\fs10\fax0.25\fscx95\blur0.2\c&H575153&\frz333.6\pos(218,209)\frx4\fry16}Isekichi
Dialogue: 0,0:17:05.54,0:17:07.33,Italics,Satoko {M},0,0,0,,Mình thấy đỡ hơn nhiều rồi.
Dialogue: 0,0:17:07.93,0:17:09.05,Default,Shinpei,0,0,0,,Satoko.
Dialogue: 0,0:17:09.05,0:17:09.91,Default,Shinpei,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:17:10.72,0:17:13.55,Default,Shinpei,0,0,0,,Nghe này, tôi có tin vui cho nàng đây.
Dialogue: 0,0:17:14.67,0:17:16.06,Default,Shinpei,0,0,0,,Đoán xem là chuyện gì nào?
Dialogue: 0,0:17:16.06,0:17:20.14,Default,Shinpei,0,0,0,,Hóa ra chúng ta có thể lên tàu \Nvà rời khỏi đảo một cách an toàn rồi.
Dialogue: 0,0:17:21.03,0:17:23.15,Default,Shinpei,0,0,0,,Tôi đã đút lót thành công cho một viên thuyền trưởng.
Dialogue: 0,0:17:23.50,0:17:25.67,Default,Shinpei,0,0,0,,Chỉ là phải mười ngày nữa tàu mới nhổ neo.
Dialogue: 0,0:17:25.67,0:17:26.65,Default,Satoko,0,0,0,,Anh nói thật chứ?
Dialogue: 0,0:17:26.65,0:17:28.17,Default,Satoko,0,0,0,,Mọi chuyện suôn sẻ dễ dàng vậy sao?
Dialogue: 0,0:17:28.17,0:17:30.31,Default,Shinpei,0,0,0,,Không hề dễ đâu nhé.
Dialogue: 0,0:17:30.31,0:17:32.99,Default,Shinpei,0,0,0,,Tôi phải mất mấy ngày liền mới thuyết phục được ông ta đấy.
Dialogue: 0,0:17:33.56,0:17:36.76,Italics,Satoko {M},0,0,0,,Nhưng mình nghe nói cách duy nhất để rời đảo \Nlà được khách chuộc thân cơ mà.
Dialogue: 0,0:17:36.76,0:17:39.04,Italics,Satoko {M},0,0,0,,Liệu cách này có thực sự an toàn không?
Dialogue: 0,0:17:40.29,0:17:43.52,Italics,Satoko {M},0,0,0,,Thôi kệ đi. Cách nào mà chẳng đi kèm rủi ro.
Dialogue: 0,0:17:43.52,0:17:45.67,Italics,Satoko {M},0,0,0,,Mình nên ăn mừng mới phải.
Dialogue: 0,0:17:45.98,0:17:47.47,Default,Satoko,0,0,0,,Cảm ơn anh nhiều lắm.
Dialogue: 0,0:17:47.47,0:17:51.38,Default,Shinpei,0,0,0,,Bên ngoài nguy hiểm lắm, \Nnên chúng ta hãy ở lại đây trong mười ngày tới nhé.
Dialogue: 0,0:17:51.38,0:17:54.34,Default,Shinpei,0,0,0,,Một phụ nữ đi lại bên ngoài lầu xanh \Nsẽ rất dễ gây chú ý.
Dialogue: 0,0:17:54.91,0:17:57.01,Default,Shinpei,0,0,0,,Giờ tôi sẽ đi kiếm chút gì đó cho hai đứa mình ăn.
Dialogue: 0,0:17:57.01,0:17:58.89,Default,Satoko,0,0,0,,Ồ, để tôi đi cùng—
Dialogue: 0,0:17:58.89,0:18:01.98,Default,Shinpei,0,0,0,,Dừng lại. Nàng vẫn cần phải tịnh dưỡng.
Dialogue: 0,0:18:02.52,0:18:04.98,Default,Shinpei,0,0,0,,Hãy dựa dẫm vào tôi thêm một chút nữa đi.
Dialogue: 0,0:18:11.57,0:18:13.58,Italics,Satoko {M},0,0,0,,Anh ta vẫn cư xử y hệt như mọi khi.
Dialogue: 0,0:18:13.91,0:18:16.41,Italics,Satoko {M},0,0,0,,Chỉ có một mình mình đa sầu đa cảm. \NThật nực cười làm sao.
Dialogue: 0,0:18:17.49,0:18:21.51,Italics,Satoko {M},0,0,0,,Mình không đời nào có thể nảy sinh thứ tình cảm đó \Nvới một gã sát thủ đánh thuê được.
Dialogue: 0,0:18:21.87,0:18:25.33,Italics,Satoko {M},0,0,0,,Trước hết, mình cần phải xin lỗi \Nvề thái độ vô lý của mình ngày hôm qua.
Dialogue: 0,0:18:26.68,0:18:27.96,Default,Courtesans,0,0,0,,Cậu Shinpei!
Dialogue: 0,0:18:27.96,0:18:28.98,Default,Courtesans,0,0,0,,Lâu quá rồi mới thấy cậu.
Dialogue: 0,0:18:28.98,0:18:29.98,Default,Courtesans,0,0,0,,Mấy hôm nay cậu đi đâu thế?
Dialogue: 0,0:18:33.79,0:18:35.89,Top,Courtesans,0,0,0,,Lúc nào trông cậu cũng tuấn tú hết mức.
Dialogue: 0,0:18:29.98,0:18:33.32,Default,Courtesan A,0,0,0,,Vui quá đi mất, mới sáng sớm \Nđã được gặp cậu rồi.
Dialogue: 0,0:18:33.32,0:18:35.89,Default,Courtesan B,0,0,0,,Hay là cậu dọn hẳn về đây ở luôn đi?
Dialogue: 0,0:18:37.80,0:18:39.49,Default,Shinpei,0,0,0,,Ồ, Satoko.
Dialogue: 0,0:18:39.49,0:18:41.34,Default,Shinpei,0,0,0,,Chỗ đồ ăn này trông cũng tươm tất đấy—
Dialogue: 0,0:18:41.34,0:18:42.77,Default,Shinpei,0,0,0,,Satoko?
Dialogue: 0,0:18:43.65,0:18:45.94,Default,Satoko,0,0,0,,Tôi chỉ định đi nhà vệ sinh thôi.
Dialogue: 0,0:18:48.11,0:18:51.28,Default,Shinpei,0,0,0,,Nh-Nhà vệ sinh ở hướng ngược lại cơ mà!
Dialogue: 0,0:18:53.33,0:18:55.53,Default,Aoi,0,0,0,,Rất vui được gặp em, Satoko.
Dialogue: 0,0:18:55.88,0:18:59.94,Default,Aoi,0,0,0,,Từ giờ chị sẽ tạm thời phụ trách hướng dẫn cho em. \NChị tên là Aoi.
Dialogue: 0,0:18:59.94,0:19:02.04,Default,Aoi,0,0,0,,Có điều gì thắc mắc thì em cứ hỏi chị nhé.
Dialogue: 0,0:19:02.04,0:19:03.96,Default,Satoko,0,0,0,,Mong được chị chỉ bảo thêm ạ.
Dialogue: 0,0:19:03.96,0:19:06.18,Default,Shinpei,0,0,0,,Sao nàng phải bận tâm làm việc làm gì?
Dialogue: 0,0:19:06.18,0:19:09.29,Default,Satoko,0,0,0,,Tôi đâu thể mặt dày ăn dầm nằm dề ở đây \Nmà không làm gì được.
Dialogue: 0,0:19:11.21,0:19:13.69,Default,Shinpei,0,0,0,,Chỉ nhận mấy việc nhẹ nhàng thôi đấy nhé?
Dialogue: 0,0:19:14.80,0:19:17.39,Italics,Satoko {M},0,0,0,,Đấy, mình lại cư xử gai góc nữa rồi.
Dialogue: 0,0:19:17.39,0:19:21.50,Default,Aoi,0,0,0,,Thứ lỗi cho chị tò mò, nhưng mối quan hệ giữa em \Nvà cậu Shinpei là thế nào vậy?
Dialogue: 0,0:19:22.22,0:19:25.34,Default,Aoi,0,0,0,,Mọi người ở đây đang xì xào bàn tán suốt đấy.
Dialogue: 0,0:19:25.34,0:19:29.56,Default,Aoi,0,0,0,,Cậu Shinpei dẫn một đại mỹ nhân tới đây \Nrồi ở lì suốt mấy ngày liền.
Dialogue: 0,0:19:29.56,0:19:32.28,Default,Satoko,0,0,0,,Giữa bọn em hoàn toàn không có gì đâu ạ.
Dialogue: 0,0:19:32.28,0:19:34.82,Default,Satoko,0,0,0,,Anh ấy chỉ đơn thuần đồng ý giới thiệu em \Nvào làm việc ở lầu xanh thôi.
Dialogue: 0,0:19:34.82,0:19:37.76,Default,Aoi,0,0,0,,Chị nhìn thì chẳng giống vậy chút nào.
Dialogue: 0,0:19:37.76,0:19:40.37,Default,Aoi,0,0,0,,Lúc em đổ bệnh, cậu ấy đã lo lắng đến mất ăn mất ngủ.
Dialogue: 0,0:19:40.65,0:19:42.82,Default,Aoi,0,0,0,,Cậu ấy đã thức trắng cả đêm để túc trực chăm sóc em đấy.
Dialogue: 0,0:19:45.37,0:19:49.21,Default,Satoko,0,0,0,,À, em cũng có một chuyện muốn hỏi chị.
Dialogue: 0,0:19:49.21,0:19:54.38,Default,Satoko,0,0,0,,Người đàn ông tên Goto Shinpei đó \Ncó vai trò gì ở nơi này vậy ạ?
Dialogue: 0,0:19:54.38,0:19:56.22,Default,Aoi,0,0,0,,Em đi cùng cậu ấy mà lại không biết sao?
Dialogue: 0,0:19:57.21,0:20:02.10,Default,Aoi,0,0,0,,Cậu Shinpei là hộ vệ \Ncho tất cả các lầu xanh trên hòn đảo này.
Dialogue: 0,0:20:02.62,0:20:06.97,Default,Aoi,0,0,0,,Cậu ấy thẳng tay trị tội những gã khách nguy hiểm \Nvà bảo vệ bọn chị,
Dialogue: 0,0:20:06.97,0:20:10.73,Default,Aoi,0,0,0,,nên không ít kỹ nữ ở đây thần tượng cậu ấy lắm.
Dialogue: 0,0:20:11.54,0:20:16.86,Default,Aoi,0,0,0,,Ngay cả các chủ lầu xanh cũng phải nể trọng cậu ấy. \NThật sự là một kỳ nhân đấy.
Dialogue: 0,0:20:17.46,0:20:21.65,Italics,Satoko {M},0,0,0,,Vậy là mình đoán không sai. \NKhông một ai biết anh ta là sát thủ.
Dialogue: 0,0:20:22.12,0:20:28.67,Default,Aoi,0,0,0,,Nhưng chị nghe nói cậu ấy chưa từng nặng lòng \Nvới bất kỳ kỹ nữ nào cả.
Dialogue: 0,0:20:28.67,0:20:31.96,Default,Sawarabi,0,0,0,,Ái chà, sao cô lại ăn mặc bộ dạng đó thế kia?
Dialogue: 0,0:20:31.96,0:20:35.13,Default,Hatsune,0,0,0,,Từ bỏ chuyện ra tiếp khách rồi à?
Dialogue: 0,0:20:35.13,0:20:38.38,Default,Sawarabi,0,0,0,,Mà kể ra thì \Ncô em cũng xui xẻo thật đấy.
Dialogue: 0,0:20:38.38,0:20:42.89,Default,Hatsune,0,0,0,,Nghe đồn người ta đã rót rượu sake \Nthay vì nước lọc cho ngài Nitobe phải không?
Dialogue: 0,0:20:43.18,0:20:45.81,Default,Hatsune,0,0,0,,Ai lại nhẫn tâm làm ra cái chuyện thất đức thế không biết?
Dialogue: 0,0:20:48.48,0:20:50.93,Default,Sawarabi,0,0,0,,Trong người cô đã khỏe hẳn chưa?
Dialogue: 0,0:20:50.93,0:20:53.88,Default,Satoko,0,0,0,,V-Vâng. Xin lỗi vì đã làm phiền mọi người.
Dialogue: 0,0:20:53.88,0:20:57.77,Default,Hatsune,0,0,0,,Sướng thật đấy nhé, \Nđược đích thân cậu Shinpei tận tình chăm sóc.
Dialogue: 0,0:20:58.09,0:21:00.70,Default,Hatsune,0,0,0,,Ước gì tôi cũng sinh ra mang thân thể ốm yếu bệnh tật như cô.
Dialogue: 0,0:21:01.52,0:21:03.07,Default,Satoko,0,0,0,,Tôi thấy lời nói đó hơi quá—
Dialogue: 0,0:21:04.84,0:21:08.45,Default,Sawarabi,0,0,0,,Đừng có giở thêm trò mèo gì nữa, ma mới.
Dialogue: 0,0:21:08.45,0:21:11.79,Default,Sawarabi,0,0,0,,Và cũng đừng có xớ rớ lại gần cậu Shinpei nữa.
Dialogue: 0,0:21:11.79,0:21:14.54,Default,Sawarabi,0,0,0,,Cậu ấy chỉ có duy nhất một người trong lòng thôi.
Dialogue: 0,0:21:14.95,0:21:16.80,Default,Sawarabi,0,0,0,,Và người đó chính là Yukari.
Dialogue: 0,0:22:50.72,0:22:55.25,Default,Sign,0,0,0,,{\fnSegoe UI\bord2\fs16\shad0\blur0.2\pos(320,330)\c&H494B5F&\3c&HC8C3ED&}Biên dịch & Phụ đề Việt ngữ: Amtia(NOFACE) | Ủy ban Sản xuất Anime Hôn Nhân Đom Đóm

