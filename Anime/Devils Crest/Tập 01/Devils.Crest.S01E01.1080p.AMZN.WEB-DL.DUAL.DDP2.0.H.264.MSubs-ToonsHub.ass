Dialogue: 0,0:00:03.50,0:00:07.42,Default,,0,0,0,,NGUYÊN TÁC: REKI KAWAHARA
Dialogue: 0,0:00:09.01,0:00:10.10,Default,,0,0,0,,{\i1}Yuu...{\i0}
Dialogue: 0,0:00:13.06,0:00:14.27,Default,,0,0,0,,{\i1}Anh Yuu.{\i0}
Dialogue: 0,0:00:16.52,0:00:18.94,Default,,0,0,0,,{\i1}Dậy đi mà, anh Yuu.{\i0}
Dialogue: 0,0:00:23.27,0:00:24.48,Default,,0,0,0,,Mình đang ở đâu thế này?
Dialogue: 0,0:00:29.86,0:00:32.90,Default,,0,0,0,,À phải rồi. Mình đang ở trong khoang Caliculus.
Dialogue: 0,0:00:33.53,0:00:35.32,Default,,0,0,0,,Sao xung quanh lại tối đen thế này?
Dialogue: 0,0:00:36.16,0:00:37.45,Default,,0,0,0,,Mất điện rồi sao?
Dialogue: 0,0:00:39.04,0:00:40.71,Default,,0,0,0,,Tiếng gì vừa nãy thế?
Dialogue: 0,0:00:41.79,0:00:44.38,Default,,0,0,0,,Nó đây rồi.
Dialogue: 0,0:00:53.05,0:00:54.97,Default,,0,0,0,,THỬ NGHIỆM\NKHOANG CHƠI GAME FULL-DIVE - CALICULUS
Dialogue: 0,0:01:01.60,0:01:03.48,Default,,0,0,0,,Rốt cuộc chuyện quái gì đã xảy ra thế này?
Dialogue: 0,0:01:06.15,0:01:07.49,Default,,0,0,0,,Sawa...
Dialogue: 0,0:01:16.58,0:01:18.54,Default,,0,0,0,,Mùi gì thế này?
Dialogue: 0,0:01:27.05,0:01:28.01,Default,,0,0,0,,Sawa?
Dialogue: 0,0:03:12.32,0:03:13.99,Default,,0,0,0,,{\an8}DEVILS' CREST
Dialogue: 0,0:03:13.99,0:03:17.66,Default,,0,0,0,,{\an8}TẬP 1: XÂM LẤN
Dialogue: 0,0:03:22.91,0:03:24.66,Default,,0,0,0,,Yuu, nó đang lao về phía cậu kìa!
Dialogue: 0,0:03:28.75,0:03:31.17,Default,,0,0,0,,{\an8}YUUMA\NTHỎ SỪNG KHỔNG LỒ - ĐỒNG BẰNG ĐÔNG CALCINA
Dialogue: 0,0:03:33.26,0:03:34.51,Default,,0,0,0,,Tenebri--
Dialogue: 0,0:03:35.55,0:03:36.68,Default,,0,0,0,,Chết tiệt!
Dialogue: 0,0:03:39.22,0:03:40.56,Default,,0,0,0,,Cậu làm được mà, Yuu!
Dialogue: 0,0:03:41.10,0:03:42.69,Default,,0,0,0,,Sắp xong rồi!
Dialogue: 0,0:03:44.35,0:03:45.43,Default,,0,0,0,,Tenebris!
Dialogue: 0,0:03:48.44,0:03:50.61,Default,,0,0,0,,Capere Anima!
Dialogue: 0,0:03:54.36,0:03:55.19,Default,,0,0,0,,Ignis.
Dialogue: 0,0:04:09.92,0:04:12.17,Default,,0,0,0,,{\an8}THỎ SỪNG KHỔNG LỒ
Dialogue: 0,0:04:12.17,0:04:14.84,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:04:15.84,0:04:17.38,Default,,0,0,0,,Làm tốt lắm, Yuu.
Dialogue: 0,0:04:17.38,0:04:18.84,Default,,0,0,0,,Cảm ơn nhé, Konken.
Dialogue: 0,0:04:21.43,0:04:22.35,Default,,0,0,0,,{\an8}YUUMA
Dialogue: 0,0:04:22.35,0:04:23.77,Default,,0,0,0,,{\an8}Thấy ghê chưa?
Dialogue: 0,0:04:23.76,0:04:25.97,Default,,0,0,0,,{\an8}Tớ đã lùa con quái vào đúng vị trí chúng ta cần đấy.
Dialogue: 0,0:04:26.56,0:04:28.02,Default,,0,0,0,,Đòi hỏi kỹ thuật đỉnh cao lắm mới làm được đấy nhé!
Dialogue: 0,0:04:28.02,0:04:28.94,Default,,0,0,0,,KONKEN
Dialogue: 0,0:04:28.94,0:04:29.86,Default,,0,0,0,,{\an8}SAWA
Dialogue: 0,0:04:29.85,0:04:31.69,Default,,0,0,0,,{\an8}Sao cậu lại vênh váo thế hả?
Dialogue: 0,0:04:31.69,0:04:32.61,Default,,0,0,0,,{\an8}NAGI
Dialogue: 0,0:04:32.61,0:04:35.11,Default,,0,0,0,,{\an8}Tỉ lệ thành công có được một nửa đâu cơ chứ?
Dialogue: 0,0:04:35.69,0:04:37.23,Default,,0,0,0,,Này, Yuu.
Dialogue: 0,0:04:37.24,0:04:40.49,Default,,0,0,0,,Thử triệu hồi nó\Nbằng kỹ năng Thu Phục Quái Thú xem sao.
Dialogue: 0,0:04:41.12,0:04:42.16,Default,,0,0,0,,Ngay bây giờ á?
Dialogue: 0,0:04:42.16,0:04:45.87,Default,,0,0,0,,Thì đợt chơi thử chỉ còn 50 phút nữa là hết rồi.
Dialogue: 0,0:04:45.87,0:04:48.00,Default,,0,0,0,,Hả, thật đấy à?
Dialogue: 0,0:04:48.58,0:04:50.29,Default,,0,0,0,,Thế thì gay go rồi.
Dialogue: 0,0:04:50.29,0:04:54.84,Default,,0,0,0,,Tớ lỡ cá cược với nhóm Sugamo\Nlà chúng ta sẽ hạ trùm trước bọn họ rồi.
Dialogue: 0,0:04:54.84,0:04:57.63,Default,,0,0,0,,Lại nữa rồi đấy.
Dialogue: 0,0:04:57.63,0:04:59.13,Default,,0,0,0,,Cậu đã cược cái gì hả?
Dialogue: 0,0:05:00.55,0:05:02.84,Default,,0,0,0,,Phần bánh pudding sô-cô-la của bữa trưa mai ở trường.
Dialogue: 0,0:05:02.85,0:05:05.23,Default,,0,0,0,,Đừng bảo là tớ không cảnh báo cậu trước đấy nhé.
Dialogue: 0,0:05:05.22,0:05:07.35,Default,,0,0,0,,Và tớ tuyệt đối không nhường phần của mình đâu.
Dialogue: 0,0:05:07.35,0:05:09.52,Default,,0,0,0,,Tớ đã cược... bốn phần luôn rồi...
Dialogue: 0,0:05:11.35,0:05:13.85,Default,,0,0,0,,Cái gì? Gì cơ chứ?
Dialogue: 0,0:05:13.86,0:05:17.61,Default,,0,0,0,,Khoan đã nào, Kenji Kondo.\NAi cho phép cậu tự tiện quyết định thế hả?
Dialogue: 0,0:05:17.61,0:05:20.45,Default,,0,0,0,,Tớ xin lỗi! Tớ xin lỗi thật mà!
Dialogue: 0,0:05:20.45,0:05:23.79,Default,,0,0,0,,Tớ xin lỗi được chưa?\NĐừng có réo tên thật của tớ trong game nữa!
Dialogue: 0,0:05:25.53,0:05:27.11,Default,,0,0,0,,Này, Konken.
Dialogue: 0,0:05:27.12,0:05:29.16,Default,,0,0,0,,Nghĩa là nếu chúng ta thắng vụ cược này,
Dialogue: 0,0:05:29.16,0:05:31.62,Default,,0,0,0,,thì sẽ được ăn tận bốn phần pudding đúng không?
Dialogue: 0,0:05:31.62,0:05:33.79,Default,,0,0,0,,Đương nhiên rồi.
Dialogue: 0,0:05:36.63,0:05:38.05,Default,,0,0,0,,Nghe hấp dẫn đấy chứ.
Dialogue: 0,0:05:42.47,0:05:45.89,Default,,0,0,0,,Hầm ngục của quái trùm khá là xa đấy.
Dialogue: 0,0:05:45.89,0:05:47.97,Default,,0,0,0,,Chỉ còn vỏn vẹn 50 phút thôi.
Dialogue: 0,0:05:47.97,0:05:51.35,Default,,0,0,0,,Chúng ta còn phải mất thời gian\Nbăng qua hầm ngục nữa.
Dialogue: 0,0:05:51.35,0:05:53.31,Default,,0,0,0,,E là thời gian sẽ sít sao lắm.
Dialogue: 0,0:05:54.90,0:05:57.86,Default,,0,0,0,,Đừng có nhìn tớ bằng ánh mắt đó mà! Tớ xin lỗi rồi!
Dialogue: 0,0:05:57.86,0:05:58.74,Default,,0,0,0,,Không sao.
Dialogue: 0,0:05:59.28,0:06:02.58,Default,,0,0,0,,Vẫn còn kịp, dù có hơi sát nút một chút.
Dialogue: 0,0:06:17.34,0:06:18.42,Default,,0,0,0,,Còn bao nhiêu thời gian nữa?
Dialogue: 0,0:06:18.42,0:06:20.13,Default,,0,0,0,,Ba mươi phút.
Dialogue: 0,0:06:20.67,0:06:24.59,Default,,0,0,0,,Tớ biết là tớ đã giục các cậu chạy thục mạng, nhưng...
Dialogue: 0,0:06:25.30,0:06:27.43,Default,,0,0,0,,Liệu chúng ta có còn cơ hội thắng cược\Nvới nhóm Sugamo không,
Dialogue: 0,0:06:27.43,0:06:30.47,Default,,0,0,0,,nếu như đã có người\Ntiêu diệt quái trùm trước rồi?
Dialogue: 0,0:06:30.47,0:06:32.14,Default,,0,0,0,,Đừng lo.
Dialogue: 0,0:06:32.14,0:06:33.39,Default,,0,0,0,,Trong sách hướng dẫn,
Dialogue: 0,0:06:33.39,0:06:35.93,Default,,0,0,0,,người ta có nói phòng trùm này
Dialogue: 0,0:06:35.94,0:06:37.19,Default,,0,0,0,,là một "phó bản".
Dialogue: 0,0:06:37.19,0:06:40.99,Default,,0,0,0,,"Mì ăn liền" á? Ý cậu là chỉ kéo dài\Nkhoảng ba phút thôi ấy hả?
Dialogue: 0,0:06:42.44,0:06:45.57,Default,,0,0,0,,Cậu nên về học lại tiểu học đi là vừa.
Dialogue: 0,0:06:45.57,0:06:48.11,Default,,0,0,0,,Hai đứa mình đều đang học tiểu học mà lị!
Dialogue: 0,0:06:48.12,0:06:50.16,Default,,0,0,0,,Để tớ giải thích "phó bản" là gì cho nghe.
Dialogue: 0,0:06:50.16,0:06:53.29,Default,,0,0,0,,Đó là một bản đồ riêng biệt\Nmà chỉ có thể được chinh phục
Dialogue: 0,0:06:53.29,0:06:54.58,Default,,0,0,0,,bởi chính cậu hoặc tổ đội của cậu.
Dialogue: 0,0:06:54.58,0:06:58.75,Default,,0,0,0,,Trong trường hợp này, ngay khoảnh khắc chúng ta bước qua\Ncánh cổng dẫn vào phòng trùm,
Dialogue: 0,0:06:58.75,0:07:01.84,Default,,0,0,0,,trò chơi sẽ dịch chuyển chúng ta\Ntới một bản đồ chuyên biệt.
Dialogue: 0,0:07:01.84,0:07:05.51,Default,,0,0,0,,Vậy có nghĩa là sẽ luôn có một con trùm
Dialogue: 0,0:07:05.51,0:07:07.09,Default,,0,0,0,,dành riêng cho mỗi tổ đội tiến vào.
Dialogue: 0,0:07:07.09,0:07:08.34,Default,,0,0,0,,Chuẩn xác.
Dialogue: 0,0:07:08.35,0:07:10.60,Default,,0,0,0,,Vậy giờ chúng ta tính sao đây?
Dialogue: 0,0:07:10.60,0:07:13.19,Default,,0,0,0,,Đừng làm mất thời gian nữa, nói mau đi chứ.
Dialogue: 0,0:07:13.18,0:07:15.27,Default,,0,0,0,,Cậu đã có kế hoạch khả thi\Nđể làm được việc này rồi đúng không?
Dialogue: 0,0:07:17.73,0:07:19.77,Default,,0,0,0,,Cậu định triệu hồi con thỏ đó ra sao?
Dialogue: 0,0:07:21.15,0:07:22.15,Default,,0,0,0,,Aperta!
Dialogue: 0,0:07:31.99,0:07:34.49,Default,,0,0,0,,- Trông hơi bé nhỉ.\N- Ừ.
Dialogue: 0,0:07:36.12,0:07:37.62,Default,,0,0,0,,Dễ...
Dialogue: 0,0:07:37.62,0:07:40.37,Default,,0,0,0,,Dễ thương quá đi mất!
Dialogue: 0,0:07:40.38,0:07:43.18,Default,,0,0,0,,Này, nó không phải thú cưng đâu nhé.
Dialogue: 0,0:07:43.88,0:07:46.01,Default,,0,0,0,,{\an8}ĐẶT TÊN ĐỂ KÍCH HOẠT KỸ NĂNG
Dialogue: 0,0:07:46.01,0:07:47.89,Default,,0,0,0,,{\an8}Tên á?
Dialogue: 0,0:07:47.89,0:07:50.52,Default,,0,0,0,,Tớ dở nhất khoản đặt tên đấy.
Dialogue: 0,0:07:50.51,0:07:52.39,Default,,0,0,0,,Anh Yuu, chúng ta sắp hết giờ rồi đấy.
Dialogue: 0,0:07:57.35,0:07:59.89,Default,,0,0,0,,Được rồi. Tên mày là Squeak.
Dialogue: 0,0:07:59.90,0:08:02.19,Default,,0,0,0,,Hả? Squeak á?
Dialogue: 0,0:08:02.19,0:08:04.27,Default,,0,0,0,,Nghe như tên của một chú cún vậy.
Dialogue: 0,0:08:04.28,0:08:07.83,Default,,0,0,0,,Squeak, nhận lệnh:\NDẫn đường cho bọn tao đến nơi sâu nhất của hầm ngục.
Dialogue: 0,0:08:10.91,0:08:12.20,Default,,0,0,0,,Này, Yuu!
Dialogue: 0,0:08:21.50,0:08:23.29,Default,,0,0,0,,Giờ nó đang làm cái gì thế kia?
Dialogue: 0,0:08:23.30,0:08:26.55,Default,,0,0,0,,Đó là kỹ năng Đào Hầm Tìm Kiếm của Squeak.
Dialogue: 0,0:08:26.55,0:08:28.09,Default,,0,0,0,,Nó có thể tìm kiếm vật phẩm,
Dialogue: 0,0:08:28.09,0:08:30.68,Default,,0,0,0,,hoặc dẫn đường băng qua hầm ngục.
Dialogue: 0,0:08:31.30,0:08:33.18,Default,,0,0,0,,Ở những hầm ngục sơ cấp như thế này,
Dialogue: 0,0:08:33.18,0:08:34.39,Default,,0,0,0,,việc đánh bại quái trùm
Dialogue: 0,0:08:34.39,0:08:37.81,Default,,0,0,0,,thường sẽ mở luôn lối thoát hiểm\Nngay tại chính vị trí đó.
Dialogue: 0,0:08:37.81,0:08:40.31,Default,,0,0,0,,Thế nên nếu ra lệnh cho nó dẫn tới điểm tận cùng,
Dialogue: 0,0:08:40.31,0:08:43.69,Default,,0,0,0,,nó sẽ dẫn thẳng tới phòng trùm đúng không?
Dialogue: 0,0:08:43.69,0:08:47.94,Default,,0,0,0,,Hóa ra đó là lý do cậu muốn bắt nó à?
Dialogue: 0,0:08:47.95,0:08:50.70,Default,,0,0,0,,Game là thứ duy nhất trên đời\Nmà anh Yuu giỏi đấy.
Dialogue: 0,0:08:50.70,0:08:52.49,Default,,0,0,0,,Em bỏ chữ "duy nhất" đi thì chết ai à.
Dialogue: 0,0:08:59.71,0:09:02.46,Default,,0,0,0,,Konken, cậu sợ rồi à?
Dialogue: 0,0:09:02.46,0:09:04.67,Default,,0,0,0,,Ai mà sợ chứ!
Dialogue: 0,0:09:04.67,0:09:08.13,Default,,0,0,0,,Tớ chính là Bậc Thầy Hầm Ngục\Ncủa Trường Tiểu học Yukihana đấy nhé!
Dialogue: 0,0:09:08.13,0:09:09.21,Default,,0,0,0,,Tớ vào đây!
Dialogue: 0,0:09:09.22,0:09:11.26,Default,,0,0,0,,Cậu phải đi phía sau bọn tớ chứ!
Dialogue: 0,0:09:16.22,0:09:18.14,Default,,0,0,0,,Khoan đã! Này!
Dialogue: 0,0:09:40.75,0:09:41.92,Default,,0,0,0,,Squeak, dừng lại.
Dialogue: 0,0:09:46.25,0:09:48.25,Default,,0,0,0,,Dễ thương quá à!
Dialogue: 0,0:09:49.01,0:09:50.34,Default,,0,0,0,,Được rồi, được rồi.
Dialogue: 0,0:09:51.30,0:09:52.43,Default,,0,0,0,,Cảm ơn mày nhé.
Dialogue: 0,0:09:53.76,0:09:55.05,Default,,0,0,0,,Tao sẽ lại gọi mày sau.
Dialogue: 0,0:09:57.76,0:09:59.43,Default,,0,0,0,,Clause.
Dialogue: 0,0:10:05.52,0:10:07.81,Default,,0,0,0,,{\an8}THỎ SỪNG KHỔNG LỒ
Dialogue: 0,0:10:26.50,0:10:29.46,Default,,0,0,0,,Này! Đợi bọn tớ với, Kondo!
Dialogue: 0,0:10:34.38,0:10:35.84,Default,,0,0,0,,Sugamo...
Dialogue: 0,0:10:44.77,0:10:46.60,Default,,0,0,0,,{\an8}CỔ THÀNH:\NĐẠI ĐỊA ĐẠO DƯỚI LÒNG ĐẤT
Dialogue: 0,0:10:46.61,0:10:48.36,Default,,0,0,0,,{\an8}Kondo. Phòng trùm...
Dialogue: 0,0:10:48.36,0:10:49.28,Default,,0,0,0,,LUCIUS
Dialogue: 0,0:10:49.27,0:10:50.19,Default,,0,0,0,,RIA
Dialogue: 0,0:10:50.19,0:10:52.11,Default,,0,0,0,,Bọn tôi vào trước đây!
Dialogue: 0,0:10:52.11,0:10:53.03,Default,,0,0,0,,KAI
Dialogue: 0,0:10:53.03,0:10:57.45,Default,,0,0,0,,Nghe này, phòng trùm này là một phó... phó gì nhỉ?
Dialogue: 0,0:10:59.28,0:11:00.87,Default,,0,0,0,,Phó bản!
Dialogue: 0,0:11:01.45,0:11:02.99,Default,,0,0,0,,Là phó bản đấy!
Dialogue: 0,0:11:03.00,0:11:05.54,Default,,0,0,0,,Thế nên ai vào trước cũng chẳng quan trọng đâu, Gamo!
Dialogue: 0,0:11:05.54,0:11:09.63,Default,,0,0,0,,Mỗi đội đều chiến đấu với trùm riêng biệt\Ntrong không gian của mình!
Dialogue: 0,0:11:09.63,0:11:13.42,Default,,0,0,0,,Này! Tôi đã bảo cậu đừng có gọi tôi\Nbằng cái tên đó từ lâu lắm rồi mà!
Dialogue: 0,0:11:13.42,0:11:16.01,Default,,0,0,0,,Phải đấy! Biệt danh kỳ quặc gì vậy hả?
Dialogue: 0,0:11:16.01,0:11:19.18,Default,,0,0,0,,Ở đây phải gọi cậu ấy là Lucius! Hiểu chưa hả?
Dialogue: 0,0:11:19.18,0:11:21.47,Default,,0,0,0,,Biết rồi, biết rồi. Tớ hiểu rồi, Miso.
Dialogue: 0,0:11:23.14,0:11:25.73,Default,,0,0,0,,Tôi đã bảo là không được gọi tôi như thế cơ mà!
Dialogue: 0,0:11:28.31,0:11:29.85,Default,,0,0,0,,Cậu cố tình chọc tức tôi đấy à?
Dialogue: 0,0:11:37.82,0:11:40.07,Default,,0,0,0,,Cậu định mua đôi này à?
Dialogue: 0,0:11:40.08,0:11:41.71,Default,,0,0,0,,Đôi này là mẫu mới nhất đấy!
Dialogue: 0,0:11:41.70,0:11:43.49,Default,,0,0,0,,Tớ vẫn đang phân vân đây.
Dialogue: 0,0:11:44.54,0:11:47.00,Default,,0,0,0,,Vẫn còn nhiều mẫu khác nữa mà.
Dialogue: 0,0:11:48.75,0:11:51.21,Default,,0,0,0,,Tớ thấy đôi nào cũng hợp với cậu hết.
Dialogue: 0,0:11:51.21,0:11:53.38,Default,,0,0,0,,Cậu thấy đôi nào là đẹp nhất?
Dialogue: 0,0:11:54.42,0:11:55.50,Default,,0,0,0,,Tớ...
Dialogue: 0,0:11:56.47,0:11:59.14,Default,,0,0,0,,Đôi này...
Dialogue: 0,0:12:00.43,0:12:04.02,Default,,0,0,0,,Cứ như cậu hiểu biết\Nvề các nhãn hiệu giày thể thao lắm vậy.
Dialogue: 0,0:12:07.85,0:12:11.98,Default,,0,0,0,,Tôi phải nhắc cậu bao nhiêu lần nữa đây hả?\NVào game thì phải gọi tôi là Ria!
Dialogue: 0,0:12:11.98,0:12:15.78,Default,,0,0,0,,Không, không đâu... tớ không dám thất lễ thế đâu, tiểu thư Misono.
Dialogue: 0,0:12:20.62,0:12:21.95,Default,,0,0,0,,{\an8}CỔ THÀNH:\NĐẠI ĐỊA ĐẠO DƯỚI LÒNG ĐẤT
Dialogue: 0,0:12:21.95,0:12:23.29,Default,,0,0,0,,{\an8}Watamaki.
Dialogue: 0,0:12:25.00,0:12:26.29,Default,,0,0,0,,SUMIKA
Dialogue: 0,0:12:28.21,0:12:30.05,Default,,0,0,0,,Sao cậu lại ở trong tổ đội của Gamo vậy?
Dialogue: 0,0:12:33.46,0:12:37.09,Default,,0,0,0,,Dĩ nhiên là Watamaki phải ở trong đội của tôi rồi.
Dialogue: 0,0:12:38.13,0:12:42.97,Default,,0,0,0,,Bọn tôi ở cái đẳng cấp hoàn toàn khác biệt\Nso với cái nhóm chơi cho vui như các cậu.
Dialogue: 0,0:12:43.64,0:12:46.23,Default,,0,0,0,,Vậy nên tránh đường ra!
Dialogue: 0,0:12:46.22,0:12:47.68,Default,,0,0,0,,Đi thôi mọi người!
Dialogue: 0,0:12:48.52,0:12:49.77,Default,,0,0,0,,Này, đợi đã!
Dialogue: 0,0:12:49.77,0:12:52.11,Default,,0,0,0,,Không sao đâu. Cứ để họ vào trước đi.
Dialogue: 0,0:12:55.78,0:12:57.95,Default,,0,0,0,,Chúc các cậu may mắn với chặng đường còn lại nhé!
Dialogue: 0,0:13:02.53,0:13:06.49,Default,,0,0,0,,Đừng có quên vụ cược\Nbánh pudding sô-cô-la đấy nhé, Kondo!
Dialogue: 0,0:13:09.04,0:13:11.38,Default,,0,0,0,,Thừa thãi năng lượng chỉ để đi chọc tức người khác.
Dialogue: 0,0:13:11.96,0:13:15.51,Default,,0,0,0,,Thiệt tình, ai lại cứ oang oang\Ngọi tên thật người ta như thế bao giờ chứ?
Dialogue: 0,0:13:15.50,0:13:17.46,Default,,0,0,0,,Khoan, lúc nãy cậu cũng làm thế với tớ còn gì...
Dialogue: 0,0:13:20.30,0:13:22.89,Default,,0,0,0,,Bỏ qua chuyện đó đi, tiến lên thôi!
Dialogue: 0,0:13:22.89,0:13:26.81,Default,,0,0,0,,Phải rồi. Chúng ta sẽ tiêu diệt con trùm này\Nvà thắng vụ cá cược.
Dialogue: 0,0:13:26.81,0:13:27.77,Default,,0,0,0,,Quyết chiến nào!
Dialogue: 0,0:13:28.93,0:13:31.68,Default,,0,0,0,,Sao tự dưng lại cố làm ra vẻ ngầu thế?\NChẳng giống cậu chút nào cả.
Dialogue: 0,0:13:37.44,0:13:39.36,Default,,0,0,0,,ĐUỐC
Dialogue: 0,0:13:51.08,0:13:53.08,Default,,0,0,0,,Rồng sao?
Dialogue: 0,0:13:53.08,0:13:55.87,Default,,0,0,0,,{\an8}Ngay tại hầm ngục đầu tiên này ư?
Dialogue: 0,0:13:55.88,0:13:57.34,Default,,0,0,0,,{\an8}RỒNG\NPHÒNG TRÙM SỐ 18
Dialogue: 0,0:13:57.34,0:14:01.01,Default,,0,0,0,,Xuất hiện với tư cách trùm thì cũng không lạ,\Nnhưng mà...
Dialogue: 0,0:14:07.10,0:14:09.06,Default,,0,0,0,,Đòn hơi thở tới kìa! Sawa!
Dialogue: 0,0:14:09.06,0:14:09.89,Default,,0,0,0,,Rõ rồi ạ!
Dialogue: 0,0:14:10.56,0:14:12.48,Default,,0,0,0,,Aqua! Murum!
Dialogue: 0,0:14:13.73,0:14:14.98,Default,,0,0,0,,Ardougne!
Dialogue: 0,0:14:14.98,0:14:16.65,Default,,0,0,0,,Tường Nước!
Dialogue: 0,0:14:18.23,0:14:20.36,Default,,0,0,0,,Nagi, cường hóa cho Konken!
Dialogue: 0,0:14:20.36,0:14:21.65,Default,,0,0,0,,Konken, tấn công!
Dialogue: 0,0:14:24.74,0:14:25.91,Default,,0,0,0,,Lumen.
Dialogue: 0,0:14:26.49,0:14:27.70,Default,,0,0,0,,Nubes.
Dialogue: 0,0:14:28.99,0:14:30.37,Default,,0,0,0,,Fusione...
Dialogue: 0,0:14:31.54,0:14:33.25,Default,,0,0,0,,Cường Hóa Ánh Sáng!
Dialogue: 0,0:14:42.22,0:14:44.89,Default,,0,0,0,,Tớ sẽ chặn đòn hơi thở của nó! Xông lên đi, Yuu!
Dialogue: 0,0:14:44.88,0:14:46.17,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:14:59.40,0:15:00.82,Default,,0,0,0,,SAWA
Dialogue: 0,0:15:10.12,0:15:11.54,Default,,0,0,0,,Chúng ta nắm chắc phần thắng rồi!
Dialogue: 0,0:15:11.54,0:15:13.04,Default,,0,0,0,,RỒNG
Dialogue: 0,0:15:13.04,0:15:15.29,Default,,0,0,0,,Đòn tấn công của nó không thể đơn giản thế này được.
Dialogue: 0,0:15:15.29,0:15:19.17,Default,,0,0,0,,Nếu nó không bay lượn, thì vũ khí chính\Nkhác của loài rồng sẽ là...
Dialogue: 0,0:15:19.17,0:15:20.59,Default,,0,0,0,,hơi thở, móng vuốt, và...
Dialogue: 0,0:15:22.76,0:15:23.59,Default,,0,0,0,,Cúi xuống mau!
Dialogue: 0,0:15:29.43,0:15:30.35,Default,,0,0,0,,Nagi!
Dialogue: 0,0:15:33.68,0:15:37.23,Default,,0,0,0,,Sawa! Konken, kéo khiêu khích mau! Nagi, yểm trợ tớ!
Dialogue: 0,0:15:37.94,0:15:39.48,Default,,0,0,0,,Đau quá...
Dialogue: 0,0:15:40.94,0:15:41.94,Default,,0,0,0,,Sawa!
Dialogue: 0,0:15:41.94,0:15:42.94,Default,,0,0,0,,Em không sao đâu!
Dialogue: 0,0:15:52.91,0:15:55.16,Default,,0,0,0,,Em lùi lại phía sau đi. Bọn anh sẽ lo phần còn lại.
Dialogue: 0,0:15:55.16,0:15:57.54,Default,,0,0,0,,Em đã bảo là em ổn mà!
Dialogue: 0,0:15:57.54,0:15:59.63,Default,,0,0,0,,Em vẫn còn vật phẩm hồi phục.
Dialogue: 0,0:15:59.63,0:16:00.63,Default,,0,0,0,,Không được!
Dialogue: 0,0:16:00.63,0:16:02.47,Default,,0,0,0,,Anh Yuuma?
Dialogue: 0,0:16:05.92,0:16:08.13,Default,,0,0,0,,Em thật sự không sao đâu mà.
Dialogue: 0,0:16:08.13,0:16:09.17,Default,,0,0,0,,Đi nào!
Dialogue: 0,0:16:14.89,0:16:16.98,Default,,0,0,0,,Nhát Chém Phẫn Nộ!
Dialogue: 0,0:16:17.52,0:16:19.48,Default,,0,0,0,,Tuyệt vời lắm, Lucius!
Dialogue: 0,0:16:19.48,0:16:22.27,Default,,0,0,0,,Đừng có gạt tôi ra rìa đấy... Tonitrus!
Dialogue: 0,0:16:23.02,0:16:24.27,Default,,0,0,0,,Sagitta!
Dialogue: 0,0:16:24.94,0:16:25.98,Default,,0,0,0,,Ignis!
Dialogue: 0,0:16:26.53,0:16:28.07,Default,,0,0,0,,Mũi Tên Sấm Sét!
Dialogue: 0,0:16:29.28,0:16:31.95,Default,,0,0,0,,RIA\NLUCIUS
Dialogue: 0,0:16:34.24,0:16:35.99,Default,,0,0,0,,Cảm ơn nhé, Watamaki!
Dialogue: 0,0:16:36.00,0:16:40.05,Default,,0,0,0,,Cố lên coi nào, Kai!\NÍt ra cũng phải làm được trò trống gì chứ!
Dialogue: 0,0:16:40.04,0:16:41.25,Default,,0,0,0,,Rõ rồi!
Dialogue: 0,0:16:44.55,0:16:45.88,Default,,0,0,0,,Kakeru, đòn hơi thở đấy.
Dialogue: 0,0:16:45.88,0:16:46.84,Default,,0,0,0,,Rõ!
Dialogue: 0,0:16:56.22,0:16:57.64,Default,,0,0,0,,Quả nhiên là dai sức thật.
Dialogue: 0,0:16:57.64,0:17:01.77,Default,,0,0,0,,Lẽ ra chúng ta nên lập tổ đội đông người hơn.
Dialogue: 0,0:17:02.86,0:17:05.28,Default,,0,0,0,,Chỉ hai đứa mình là đủ sức xử lý rồi.
Dialogue: 0,0:17:05.28,0:17:06.78,Default,,0,0,0,,Chẳng có gì khó khăn cả.
Dialogue: 0,0:17:07.69,0:17:09.02,Default,,0,0,0,,Nhất là nếu so với hồi đó.
Dialogue: 0,0:17:10.49,0:17:12.12,Default,,0,0,0,,Cũng đúng.
Dialogue: 0,0:17:12.12,0:17:13.58,Default,,0,0,0,,Lên nào, Haruki!
Dialogue: 0,0:17:13.58,0:17:14.79,Default,,0,0,0,,Ừ!
Dialogue: 0,0:17:26.38,0:17:28.13,Default,,0,0,0,,Sắp hạ được nó rồi!
Dialogue: 0,0:17:28.88,0:17:30.80,Default,,0,0,0,,Cả hai người, đồng loạt ra đòn!
Dialogue: 0,0:17:31.30,0:17:33.97,Default,,0,0,0,,Aqua. Sagitta.
Dialogue: 0,0:17:38.06,0:17:41.23,Default,,0,0,0,,Ignis. Mũi Tên Nước!
Dialogue: 0,0:17:42.31,0:17:43.14,Default,,0,0,0,,RỒNG
Dialogue: 0,0:17:57.79,0:17:59.62,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:17:59.62,0:18:01.46,Default,,0,0,0,,Chúng ta làm được rồi!
Dialogue: 0,0:18:10.55,0:18:12.47,Default,,0,0,0,,Bốn phút 33 giây.
Dialogue: 0,0:18:12.97,0:18:14.81,Default,,0,0,0,,Nhóm của Gamo đời nào đọ lại thời gian đó được!
Dialogue: 0,0:18:15.30,0:18:17.38,Default,,0,0,0,,Chưa chắc đâu nhé.
Dialogue: 0,0:18:17.39,0:18:20.06,Default,,0,0,0,,Trang bị của họ trông xịn hơn\Ncủa chúng ta khá nhiều đấy.
Dialogue: 0,0:18:20.06,0:18:24.27,Default,,0,0,0,,VRMMO không phụ thuộc vào trang bị đâu.\NKỹ năng mới là tất cả!
Dialogue: 0,0:18:24.81,0:18:27.52,Default,,0,0,0,,Một tên lính mới tò te mà mở mồm ra nói hay phết.
Dialogue: 0,0:18:27.52,0:18:30.31,Default,,0,0,0,,Chúng ta cũng mới chỉ chơi được có ba tiếng thôi mà.
Dialogue: 0,0:18:30.32,0:18:34.49,Default,,0,0,0,,Nhắc mới nhớ,\Nđợt chơi thử sắp kết thúc rồi đấy.
Dialogue: 0,0:18:34.49,0:18:37.12,Default,,0,0,0,,Vậy chúng ta chỉ việc đứng đây chờ hay sao...?
Dialogue: 0,0:18:38.41,0:18:43.29,Default,,0,0,0,,Lúc phổ biến thông tin,\Nhọ đâu có nói gì về việc đăng xuất đâu nhỉ.
Dialogue: 0,0:18:44.96,0:18:46.04,Default,,0,0,0,,BẠN BÈ\NSAWA - NAGI - KONKEN
Dialogue: 0,0:18:46.04,0:18:49.59,Default,,0,0,0,,Ừ, trong thanh bảng chọn cũng chẳng có nút đăng xuất nào cả.
Dialogue: 0,0:18:50.09,0:18:53.34,Default,,0,0,0,,Có lẽ là do họ không muốn
Dialogue: 0,0:18:53.34,0:18:55.30,Default,,0,0,0,,những người chơi thử tự ý đăng xuất giữa chừng thôi.
Dialogue: 0,0:18:55.30,0:18:57.26,Default,,0,0,0,,Tớ hiểu điều đó, nhưng mà...
Dialogue: 0,0:18:57.26,0:19:00.47,Default,,0,0,0,,Nhưng vậy nghĩa là chúng ta không có cách nào\Nđể rời khỏi trò chơi này ư?
Dialogue: 0,0:19:00.47,0:19:04.14,Default,,0,0,0,,Tức là... chúng ta bị kẹt trong Actual Magic rồi sao?
Dialogue: 0,0:19:04.81,0:19:08.10,Default,,0,0,0,,Thôi nào, sao chúng mình không thử chờ thêm xem sao?
Dialogue: 0,0:19:08.11,0:19:09.90,Default,,0,0,0,,Dù sao thì cũng sắp hết giờ rồi.
Dialogue: 0,0:19:13.32,0:19:14.66,Default,,0,0,0,,Cái quái gì thế này?
Dialogue: 0,0:19:31.55,0:19:32.76,Default,,0,0,0,,Sawa!
Dialogue: 0,0:19:32.76,0:19:34.22,Default,,0,0,0,,Anh Yuuma!
Dialogue: 0,0:19:55.45,0:19:56.58,Default,,0,0,0,,{\i1}Anh Yuuma!{\i0}
Dialogue: 0,0:20:10.08,0:20:12.04,Default,,0,0,0,,Sawa, Sawa!
Dialogue: 0,0:20:12.05,0:20:14.01,Default,,0,0,0,,Sawa, này!
Dialogue: 0,0:20:15.01,0:20:16.80,Default,,0,0,0,,Yuu, đè chặt vào vết thương mau!
Dialogue: 0,0:20:17.30,0:20:18.18,Default,,0,0,0,,Yuu!
Dialogue: 0,0:20:24.97,0:20:25.93,Default,,0,0,0,,Ai đó cứu với...
Dialogue: 0,0:20:33.57,0:20:36.45,Default,,0,0,0,,Tớ đi gọi thầy cô đây!
Dialogue: 0,0:20:41.07,0:20:42.07,Default,,0,0,0,,Sawa!
Dialogue: 0,0:20:42.83,0:20:44.83,Default,,0,0,0,,Anh Yuuma...
Dialogue: 0,0:20:45.41,0:20:49.00,Default,,0,0,0,,Sawa! Anh xin lỗi. Anh xin lỗi em!
Dialogue: 0,0:20:49.67,0:20:50.96,Default,,0,0,0,,Anh xin lỗi.
Dialogue: 0,0:20:51.58,0:20:53.04,Default,,0,0,0,,Anh thật lòng xin lỗi em!
Dialogue: 0,0:20:56.17,0:20:57.46,Default,,0,0,0,,Mình đang ở đâu thế này?
Dialogue: 0,0:21:09.23,0:21:10.36,Default,,0,0,0,,Sawa...
Dialogue: 0,0:21:19.45,0:21:21.45,Default,,0,0,0,,Mùi gì thế này?
Dialogue: 0,0:21:30.04,0:21:30.87,Default,,0,0,0,,Sawa?
Dialogue: 0,0:21:47.22,0:21:49.72,Default,,0,0,0,,Watamaki?
Dialogue: 0,0:23:27.99,0:23:28.91,Default,,0,0,0,,BIẾN DỊ
Dialogue: 0,0:23:28.91,0:23:29.91,Default,,0,0,0,,{\i1}Đừng giết cậu ấy!{\i0}
Dialogue: 0,0:23:29.91,0:23:31.08,Default,,0,0,0,,{\i1}Đang tìm kiếm thứ gì à?{\i0}
Dialogue: 0,0:23:31.08,0:23:32.21,Default,,0,0,0,,{\i1}Cậu đang nói cái gì vậy?{\i0}
Dialogue: 0,0:23:32.20,0:23:35.24,Default,,0,0,0,,{\i1}Cho đến tận vừa rồi, nó còn không thể mở ra\Ntừ cả hai phía.{\i0}
Dialogue: 0,0:23:35.25,0:23:36.71,Default,,0,0,0,,{\i1}Bên tôi cũng như thế.{\i0}
Dialogue: 0,0:23:36.71,0:23:38.25,Default,,0,0,0,,{\i1}Không thể nào có chuyện đó được!{\i0}
Dialogue: 0,0:23:38.25,0:23:39.92,Default,,0,0,0,,{\i1}Hiện thực chỉ toàn một màu đen kịt.{\i0}
Dialogue: 0,0:23:40.80,0:23:43.01,Default,,0,0,0,,{\i1}Đang làm cái trò gì thế hả, đồ óc bã đậu?{\i0}
Dialogue: 0,0:23:43.01,0:23:45.01,Default,,0,0,0,,Phụ đề tiếng Việt bởi Amtia(NOFACE)
