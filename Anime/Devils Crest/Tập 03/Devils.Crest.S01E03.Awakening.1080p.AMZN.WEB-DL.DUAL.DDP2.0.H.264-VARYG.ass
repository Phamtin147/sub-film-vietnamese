Dialogue: 0,0:00:13.93,0:00:14.76,Default,,0,0,0,,Chà, thật tình...
Dialogue: 0,0:00:27.32,0:00:28.70,Default,,0,0,0,,Khoan... Chuyện gì vậy?
Dialogue: 0,0:00:29.28,0:00:32.32,Default,,0,0,0,,Thật tình, đừng có tự tiện xông vào như thế chứ!
Dialogue: 0,0:00:32.41,0:00:33.58,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:00:35.87,0:00:38.16,Default,,0,0,0,,Ủa mà sao anh phải xin lỗi chứ?
Dialogue: 0,0:00:38.25,0:00:40.34,Default,,0,0,0,,Nếu bị cảm lạnh thì rắc rối to đấy cô nương!
Dialogue: 0,0:00:40.92,0:00:43.17,Default,,0,0,0,,Chuyện nào ra chuyện nấy nhé!
Dialogue: 0,0:00:43.25,0:00:45.54,Default,,0,0,0,,"Không được xâm phạm lãnh thổ của nhau."
Dialogue: 0,0:00:45.63,0:00:47.67,Default,,0,0,0,,Hồi lên lớp 6 đã giao ước thế rồi còn gì?
Dialogue: 0,0:00:50.05,0:00:51.68,Default,,0,0,0,,Cái kiểu gì vậy trời?
Dialogue: 0,0:00:53.89,0:00:55.22,Default,,0,0,0,,Này, anh Yu.
Dialogue: 0,0:00:55.31,0:00:56.35,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:00:57.06,0:00:58.94,Default,,0,0,0,,Cảm ơn nhé, cái khăn đắp.
Dialogue: 0,0:02:32.28,0:02:33.95,Default,,0,0,0,,{\an8}DEVILS' CREST
Dialogue: 0,0:02:34.03,0:02:37.91,Default,,0,0,0,,{\an8}TẬP 3: THỨC TỈNH
Dialogue: 0,0:02:41.91,0:02:45.96,Default,,0,0,0,,Chắc hẳn các bạn lớp 6-1\Nđang cố thủ ở bên trong.
Dialogue: 0,0:02:46.04,0:02:47.42,Default,,0,0,0,,Chúng ta phải làm gì đó thôi.
Dialogue: 0,0:02:49.42,0:02:50.80,Default,,0,0,0,,Vô ích thôi.
Dialogue: 0,0:02:50.88,0:02:54.09,Default,,0,0,0,,Tên kia chắc chắn có lượng HP\Nvà phòng thủ vật lý rất cao.
Dialogue: 0,0:02:54.17,0:02:55.67,Default,,0,0,0,,Nhưng đâu thể cứ bỏ mặc thế được.
Dialogue: 0,0:02:56.43,0:02:57.76,Default,,0,0,0,,Anh biết rồi.
Dialogue: 0,0:02:57.85,0:02:59.85,Default,,0,0,0,,Phải dùng ma thuật để chiến đấu,
Dialogue: 0,0:02:59.93,0:03:02.85,Default,,0,0,0,,nhưng MP của anh còn chưa\Nhồi lại nổi một nửa nữa.
Dialogue: 0,0:03:03.52,0:03:06.44,Default,,0,0,0,,{\i1}Nghĩ đi nào. Làm sao để đánh bại nó đây?{\i0}
Dialogue: 0,0:03:06.98,0:03:09.15,Default,,0,0,0,,{\i1}Cho dù hệ thống có vận hành giống trong game đi nữa,{\i0}
Dialogue: 0,0:03:09.23,0:03:11.40,Default,,0,0,0,,{\i1}thì ở đây cũng làm gì có cửa hàng vũ khí hay vật phẩm.{\i0}
Dialogue: 0,0:03:12.28,0:03:15.28,Default,,0,0,0,,{\i1}Đây là thực tại. Là thực tại thật sự đấy.{\i0}
Dialogue: 0,0:03:21.04,0:03:23.54,Default,,0,0,0,,Sawa, Konken, hai người chạy thoát được...
Dialogue: 0,0:03:23.62,0:03:26.33,Default,,0,0,0,,Không, khoan đã, hai người chạy vòng quanh\Ncầm chân nó một phút được không?
Dialogue: 0,0:03:28.67,0:03:29.50,Default,,0,0,0,,- Được.\N- Ừ.
Dialogue: 0,0:03:29.59,0:03:31.18,Default,,0,0,0,,Nhưng anh định tính làm gì thế?
Dialogue: 0,0:03:31.25,0:03:32.50,Default,,0,0,0,,Cứ để anh lo liệu trước đã.
Dialogue: 0,0:03:40.18,0:03:41.47,Default,,0,0,0,,Tớ sẽ hút sự chú ý của nó.
Dialogue: 0,0:03:41.56,0:03:43.48,Default,,0,0,0,,Cậu yểm trợ từ bên sườn nhé.
Dialogue: 0,0:03:43.56,0:03:44.44,Default,,0,0,0,,Rõ rồi!
Dialogue: 0,0:03:45.94,0:03:47.57,Default,,0,0,0,,Lại đây này, con quái vật kia!
Dialogue: 0,0:03:49.36,0:03:50.53,Default,,0,0,0,,Bên này, bên này này!
Dialogue: 0,0:03:50.61,0:03:52.11,Default,,0,0,0,,Này, mày đang nhìn đi đâu thế hả?
Dialogue: 0,0:03:55.28,0:03:56.11,Default,,0,0,0,,Chạy đi!
Dialogue: 0,0:03:58.24,0:03:59.12,Default,,0,0,0,,Này!
Dialogue: 0,0:04:02.49,0:04:05.87,Default,,0,0,0,,{\i1}Sawa, Konken, cố gắng cầm cự nhé!{\i0}
Dialogue: 0,0:04:06.79,0:04:07.75,Default,,0,0,0,,PHÒNG Y TẾ
Dialogue: 0,0:04:15.71,0:04:16.96,Default,,0,0,0,,Chừng này chắc là đủ rồi.
Dialogue: 0,0:04:18.97,0:04:21.14,Default,,0,0,0,,Này con quỷ kia, lại đây đi.
Dialogue: 0,0:04:21.72,0:04:22.60,Default,,0,0,0,,Nhào vô đây, nhào vô nào!
Dialogue: 0,0:04:35.19,0:04:36.15,Default,,0,0,0,,Nếm thử chiêu này đi!
Dialogue: 0,0:04:36.99,0:04:38.24,Default,,0,0,0,,Durendal!
Dialogue: 0,0:04:44.95,0:04:45.91,Default,,0,0,0,,Ái chà.
Dialogue: 0,0:04:54.67,0:04:55.55,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:04:58.13,0:04:59.92,Default,,0,0,0,,Anh Yu, thứ đó là gì vậy?
Dialogue: 0,0:05:00.01,0:05:01.55,Default,,0,0,0,,Cồn ethanol dùng để sát trùng đấy.
Dialogue: 0,0:05:01.64,0:05:04.44,Default,,0,0,0,,Ra vậy. Dùng để thay thế cho ma thuật à.
Dialogue: 0,0:05:04.51,0:05:05.55,Default,,0,0,0,,Ừ.
Dialogue: 0,0:05:05.64,0:05:07.93,Default,,0,0,0,,Nhưng mà anh định châm lửa bằng cách nào?
Dialogue: 0,0:05:09.44,0:05:10.44,Default,,0,0,0,,Ờ thì...
Dialogue: 0,0:05:10.52,0:05:12.94,Default,,0,0,0,,Anh chưa thèm nghĩ tới tận bước đó luôn hả?!
Dialogue: 0,0:05:13.02,0:05:13.90,Default,,0,0,0,,{\an8}YUMA ASHIHARA\NALTEA
Dialogue: 0,0:05:13.98,0:05:15.57,Default,,0,0,0,,{\an8}Nếu mình chạy câu giờ thêm một phút nữa,
Dialogue: 0,0:05:15.65,0:05:19.24,Default,,0,0,0,,{\an8}lượng MP hồi lại sẽ vừa đủ\Nđể tung một phát Flame Arrow.
Dialogue: 0,0:05:26.70,0:05:29.49,Default,,0,0,0,,Đợi đã, để em thử cách này trước xem sao.
Dialogue: 0,0:05:30.46,0:05:31.38,Default,,0,0,0,,Thử gì cơ?
Dialogue: 0,0:05:38.13,0:05:38.96,Default,,0,0,0,,Ngay bây giờ!
Dialogue: 0,0:05:45.72,0:05:49.89,Default,,0,0,0,,CHIẾN BINH ĐẦU CHÓP
Dialogue: 0,0:05:49.98,0:05:52.78,Default,,0,0,0,,Chà, hiệu quả thật kìa!
Dialogue: 0,0:05:52.85,0:05:55.81,Default,,0,0,0,,Nhưng lượng máu của nó tụt chậm hơn\Nem tưởng nhiều.
Dialogue: 0,0:05:56.36,0:05:58.86,Default,,0,0,0,,Chỉ tại con này máu trâu quá thôi.
Dialogue: 0,0:06:05.74,0:06:08.16,Default,,0,0,0,,CHIẾN BINH ĐẦU CHÓP
Dialogue: 0,0:06:09.33,0:06:13.63,Default,,0,0,0,,Tuy là quái vật, nhưng con này\Nhệt như một sinh vật sống thực thụ vậy...
Dialogue: 0,0:06:14.75,0:06:17.17,Default,,0,0,0,,Chẳng còn đơn thuần là vật thể 3D nữa rồi.
Dialogue: 0,0:06:17.88,0:06:20.67,Default,,0,0,0,,Nhưng chắc chỉ lúc chúng còn sống thôi.
Dialogue: 0,0:06:22.01,0:06:23.47,Default,,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:06:33.77,0:06:35.27,Default,,0,0,0,,Đùa nhau đấy à?!
Dialogue: 0,0:06:35.35,0:06:36.68,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:06:37.40,0:06:39.86,Default,,0,0,0,,Còn ngần ấy máu thì đáng lẽ\Nđòn vật lý phải...
Dialogue: 0,0:06:40.53,0:06:43.49,Default,,0,0,0,,Không được, mình phải đổ thêm\Ncồn mới lên người nó.
Dialogue: 0,0:06:49.16,0:06:50.08,Default,,0,0,0,,Yu!
Dialogue: 0,0:06:50.16,0:06:51.58,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:06:52.96,0:06:54.21,Default,,0,0,0,,Buông tao ra!
Dialogue: 0,0:07:01.92,0:07:02.80,Default,,0,0,0,,Yu!
Dialogue: 0,0:07:03.42,0:07:04.67,Default,,0,0,0,,Dừng lại mau!
Dialogue: 0,0:07:13.52,0:07:15.15,Default,,0,0,0,,Chạy mau đi, Yu!
Dialogue: 0,0:07:19.11,0:07:19.94,Default,,0,0,0,,Thả cậu ấy ra!
Dialogue: 0,0:07:20.02,0:07:22.31,Default,,0,0,0,,Đừng bỏ cuộc mà, anh Yu!
Dialogue: 0,0:07:25.90,0:07:27.57,Default,,0,0,0,,YUMA ASHIHARA
Dialogue: 0,0:07:48.43,0:07:49.60,Default,,0,0,0,,Đây là... đâu?
Dialogue: 0,0:07:53.85,0:07:56.73,Default,,0,0,0,,Những ngôi sao... đang rơi xuống.
Dialogue: 0,0:07:58.02,0:07:58.94,Default,,0,0,0,,Đúng vậy đấy.
Dialogue: 0,0:08:00.31,0:08:03.35,Default,,0,0,0,,Đó chính là thứ các cậu gọi là Ranh giới P-T.
Dialogue: 0,0:08:04.03,0:08:08.12,Default,,0,0,0,,Là thủ phạm đã châm ngòi cho cuộc\Nđại tuyệt chủng lớn nhất lịch sử Trái Đất
Dialogue: 0,0:08:08.20,0:08:10.33,Default,,0,0,0,,vào cuối kỷ Permi.
Dialogue: 0,0:08:11.74,0:08:17.25,Default,,0,0,0,,Chẳng bao lâu nữa, 95% mọi sự sống\Ntrên hành tinh này sẽ bị xóa sổ.
Dialogue: 0,0:08:17.75,0:08:19.79,Default,,0,0,0,,Không thể nào! Chúng ta phải làm gì đó đi chứ!
Dialogue: 0,0:08:21.29,0:08:22.88,Default,,0,0,0,,Tiếc thay, chẳng còn cách nào đâu.
Dialogue: 0,0:08:24.09,0:08:28.39,Default,,0,0,0,,Một khi đã đến nước này,\Ndù là thiên thần hay ác quỷ cũng không ngăn nổi nữa.
Dialogue: 0,0:08:28.47,0:08:31.14,Default,,0,0,0,,Thiên thần? Ác quỷ sao?
Dialogue: 0,0:08:31.72,0:08:36.98,Default,,0,0,0,,Vả lại, chuyện này đã xảy ra\Ntừ 250 triệu năm trước rồi.
Dialogue: 0,0:08:38.35,0:08:40.44,Default,,0,0,0,,Nếu không có cuộc đại tuyệt chủng ấy,
Dialogue: 0,0:08:41.02,0:08:45.23,Default,,0,0,0,,loài người hiện đại các cậu đã chẳng thể ra đời đâu, Yuma.
Dialogue: 0,0:08:45.73,0:08:48.27,Default,,0,0,0,,Anh là ai vậy?
Dialogue: 0,0:08:49.36,0:08:51.57,Default,,0,0,0,,Lúc này mà cậu còn tâm trí\Nbận tâm tới chuyện đó ư?
Dialogue: 0,0:08:52.16,0:08:55.04,Default,,0,0,0,,Cậu đang cận kề cái chết ngay lúc này đấy.
Dialogue: 0,0:08:56.75,0:08:59.34,Default,,0,0,0,,Tôi... chết rồi sao?
Dialogue: 0,0:08:59.83,0:09:02.00,Default,,0,0,0,,Sợi tơ sinh mệnh vẫn còn kết nối mà.
Dialogue: 0,0:09:03.63,0:09:07.13,Default,,0,0,0,,Nhưng làm thế nào trên đời\Ntôi mới sống sót qua tình cảnh đó được?
Dialogue: 0,0:09:07.21,0:09:09.59,Default,,0,0,0,,Điều chỉnh lại góc của thanh sắt chống
Dialogue: 0,0:09:10.30,0:09:12.76,Default,,0,0,0,,và vận dụng sức mạnh của Thuần Thú Sư đi.
Dialogue: 0,0:09:14.05,0:09:15.51,Default,,0,0,0,,Cùng một lúc đấy.
Dialogue: 0,0:09:16.10,0:09:17.69,Default,,0,0,0,,Sao anh lại biết rõ những chuyện này thế?
Dialogue: 0,0:09:18.98,0:09:20.40,Default,,0,0,0,,Giờ chuyện đó không quan trọng.
Dialogue: 0,0:09:21.02,0:09:24.02,Default,,0,0,0,,Cậu muốn sống?\NHay muốn chấp nhận cái chết?
Dialogue: 0,0:09:25.02,0:09:28.90,Default,,0,0,0,,Con quái vật đó sắp giết luôn cả\Nbạn của cậu và em gái cậu rồi đấy.
Dialogue: 0,0:09:32.07,0:09:34.41,Default,,0,0,0,,Được rồi. Tôi sẽ làm.
Dialogue: 0,0:09:34.49,0:09:35.57,Default,,0,0,0,,Tốt lắm.
Dialogue: 0,0:09:36.08,0:09:38.17,Default,,0,0,0,,Dù sao tôi cũng đã đặt cược vào cậu mà.
Dialogue: 0,0:09:39.37,0:09:41.21,Default,,0,0,0,,Nào, tỉnh dậy đi.
Dialogue: 0,0:09:42.04,0:09:45.21,Default,,0,0,0,,Ba, hai, một...
Dialogue: 0,0:09:58.43,0:09:59.47,Default,,0,0,0,,Aperta!
Dialogue: 0,0:10:28.63,0:10:30.30,Default,,0,0,0,,CHIẾN BINH ĐẦU CHÓP
Dialogue: 0,0:10:37.14,0:10:38.18,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:10:39.14,0:10:40.27,Default,,0,0,0,,Không sao đâu.
Dialogue: 0,0:11:01.16,0:11:02.33,Default,,0,0,0,,Sumika!
Dialogue: 0,0:11:02.41,0:11:03.45,Default,,0,0,0,,Watamaki...
Dialogue: 0,0:11:04.16,0:11:06.54,Default,,0,0,0,,Watamaki là sử ma của tôi.
Dialogue: 0,0:11:07.42,0:11:11.88,Default,,0,0,0,,Ít nhất thì cậu ấy sẽ không xem\Nbọn này là mục tiêu công kích đâu.
Dialogue: 0,0:11:15.59,0:11:16.88,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:11:26.10,0:11:30.52,Default,,0,0,0,,Ashihara... kun...
Dialogue: 0,0:11:31.15,0:11:32.15,Default,,0,0,0,,{\i1}Quả nhiên là vậy.{\i0}
Dialogue: 0,0:11:32.23,0:11:35.86,Default,,0,0,0,,{\i1}Sâu thẳm đâu đó,\NWatamaki thực sự vẫn còn ở đây.{\i0}
Dialogue: 0,0:11:46.00,0:11:47.63,Default,,0,0,0,,Cảm ơn nhé, Watamaki.
Dialogue: 0,0:11:48.17,0:11:50.21,Default,,0,0,0,,Tôi hứa nhất định sẽ đưa cậu trở lại như xưa.
Dialogue: 0,0:11:52.38,0:11:53.51,Default,,0,0,0,,Clause.
Dialogue: 0,0:12:06.06,0:12:08.52,Default,,0,0,0,,{\an8}ALTEA TẦNG 1
Dialogue: 0,0:12:08.60,0:12:10.89,Default,,0,0,0,,Nhưng đây là thế giới thực mà...
Dialogue: 0,0:12:11.44,0:12:13.36,Default,,0,0,0,,Tuyệt vời, bọn mình thăng cấp rồi!
Dialogue: 0,0:12:14.23,0:12:16.86,Default,,0,0,0,,Yu, cậu cũng lên cấp luôn rồi đúng không?
Dialogue: 0,0:12:16.95,0:12:19.45,Default,,0,0,0,,Vậy tức là chỉ cần đánh trúng\Ndù chỉ một đòn thôi,
Dialogue: 0,0:12:19.53,0:12:21.78,Default,,0,0,0,,chúng ta cũng được chia đều điểm kinh nghiệm ư?
Dialogue: 0,0:12:21.87,0:12:23.83,Default,,0,0,0,,Giống hệt như trong Actual Magic vậy.
Dialogue: 0,0:12:25.00,0:12:25.88,Default,,0,0,0,,BÚA NGHIỀN NÁT
Dialogue: 0,0:12:25.95,0:12:29.41,Default,,0,0,0,,Bảng thông báo Rơi Vật Phẩm hiện lên\Ncùng với bảng Thăng Cấp luôn kìa.
Dialogue: 0,0:12:29.50,0:12:31.79,Default,,0,0,0,,Rơi đồ á? Thật không vậy?
Dialogue: 0,0:12:32.34,0:12:34.43,Default,,0,0,0,,Nếu giống hệt như Actual Magic,
Dialogue: 0,0:12:34.50,0:12:36.00,Default,,0,0,0,,thì nó phải nằm trong túi đồ mới đúng.
Dialogue: 0,0:12:36.09,0:12:37.30,Default,,0,0,0,,THẺ CHỨNG NHẬN ĐỖ THỬ NGHIỆM
Dialogue: 0,0:12:37.92,0:12:41.34,Default,,0,0,0,,Ra vậy. Vậy là chúng ta cũng có túi đồ\Nở thế giới này luôn hả?
Dialogue: 0,0:12:42.01,0:12:43.51,Default,,0,0,0,,Nó mạnh thật sự đấy.
Dialogue: 0,0:12:43.60,0:12:46.14,Default,,0,0,0,,Chắc cậu kiếm được món đồ xịn lắm\Nđúng không?
Dialogue: 0,0:12:46.22,0:12:48.31,Default,,0,0,0,,Thẻ chứng nhận vượt qua đợt thử nghiệm...
Dialogue: 0,0:12:48.39,0:12:50.81,Default,,0,0,0,,Tấm thẻ cậu nhận được lúc chơi thử đó hả?
Dialogue: 0,0:12:50.90,0:12:53.07,Default,,0,0,0,,Thẻ Quái Vật, Squeak!
Dialogue: 0,0:12:54.32,0:12:56.45,Default,,0,0,0,,Squeak? Cái thẻ hồi đó ư?
Dialogue: 0,0:12:56.53,0:13:00.03,Default,,0,0,0,,Vũ khí và giáp trụ mình kiếm được\Nlúc chơi thử đều biến mất sạch,
Dialogue: 0,0:13:00.11,0:13:01.45,Default,,0,0,0,,vậy tại sao mình lại có thẻ Squeak chứ?
Dialogue: 0,0:13:01.53,0:13:03.45,Default,,0,0,0,,Này, cái này chẳng phải bình hồi máu sao?
Dialogue: 0,0:13:05.54,0:13:07.21,Default,,0,0,0,,BÌNH MÁU CẤP THẤP
Dialogue: 0,0:13:10.75,0:13:12.21,Default,,0,0,0,,Bình máu cấp thấp luôn hả trời?
Dialogue: 0,0:13:12.29,0:13:14.42,Default,,0,0,0,,Ngay cả bình cấp thấp cũng quý giá lắm đấy.
Dialogue: 0,0:13:15.17,0:13:17.71,Default,,0,0,0,,Khác với thuốc hay băng gạc ngoài đời thực,
Dialogue: 0,0:13:17.80,0:13:20.14,Default,,0,0,0,,uống vào một cái là hồi phục vết thương\Nngay lập tức luôn.
Dialogue: 0,0:13:20.80,0:13:22.01,Default,,0,0,0,,Chắc vậy rồi.
Dialogue: 0,0:13:22.09,0:13:23.47,Default,,0,0,0,,Ừm, chắc thế thật.
Dialogue: 0,0:13:23.55,0:13:24.55,Default,,0,0,0,,Cảm ơn cậu nhé.
Dialogue: 0,0:13:29.31,0:13:31.06,Default,,0,0,0,,Được rồi, tôi nắm được rồi.
Dialogue: 0,0:13:31.14,0:13:32.06,Default,,0,0,0,,Em cũng thế.
Dialogue: 0,0:13:33.81,0:13:34.90,Default,,0,0,0,,Nếu ra được bên ngoài,
Dialogue: 0,0:13:34.98,0:13:38.98,Default,,0,0,0,,chúng ta có thể gọi cảnh sát\Nhoặc cứu hỏa tới giúp đỡ.
Dialogue: 0,0:13:39.07,0:13:41.74,Default,,0,0,0,,Nhưng cửa tự động đâu có chịu mở đúng không?
Dialogue: 0,0:13:41.82,0:13:43.49,Default,,0,0,0,,Konken, dùng thử món này đi.
Dialogue: 0,0:13:43.57,0:13:44.49,Default,,0,0,0,,BÚA NGHIỀN NÁT
Dialogue: 0,0:13:45.99,0:13:47.99,Default,,0,0,0,,Cậu cũng nhặt được vũ khí à?
Dialogue: 0,0:13:48.58,0:13:50.83,Default,,0,0,0,,Được rồi, cứ để đó cho tớ!
Dialogue: 0,0:13:57.09,0:13:58.76,Default,,0,0,0,,Này, cậu không sao chứ?
Dialogue: 0,0:14:00.88,0:14:02.51,Default,,0,0,0,,Cái quái gì thế này?!
Dialogue: 0,0:14:03.09,0:14:05.84,Default,,0,0,0,,Chắc nó được bảo vệ\Nbằng một thứ ma pháp nào đó rồi.
Dialogue: 0,0:14:06.47,0:14:10.47,Default,,0,0,0,,Giờ có làm gì thì cũng chẳng\Nđập vỡ được tấm kính này đâu.
Dialogue: 0,0:14:10.56,0:14:11.48,Default,,0,0,0,,Ma pháp ư?
Dialogue: 0,0:14:12.39,0:14:13.47,Default,,0,0,0,,Cả tấm kính bên kia cũng thế.
Dialogue: 0,0:14:14.10,0:14:17.14,Default,,0,0,0,,Không, chắc mọi bức tường và cánh cửa\Nđều bị y như vậy hết rồi.
Dialogue: 0,0:14:18.11,0:14:21.53,Default,,0,0,0,,Vậy là bọn mình bị nhốt cứng ở đây rồi hả?
Dialogue: 0,0:14:21.61,0:14:23.78,Default,,0,0,0,,Không thoát khỏi Altea được sao?
Dialogue: 0,0:14:32.62,0:14:34.04,Default,,0,0,0,,Rồi sẽ ổn thôi mà.
Dialogue: 0,0:14:34.12,0:14:38.17,Default,,0,0,0,,Nếu đã là ma pháp thì ắt phải có cách\Nđể hóa giải nó chứ, đúng không?
Dialogue: 0,0:14:38.80,0:14:40.26,Default,,0,0,0,,Trước tiên, hãy đi tìm Nagi
Dialogue: 0,0:14:40.34,0:14:42.30,Default,,0,0,0,,và đưa Watamaki trở lại bình thường đã.
Dialogue: 0,0:14:44.26,0:14:45.30,Default,,0,0,0,,Anh Yu...
Dialogue: 0,0:14:46.30,0:14:47.88,Default,,0,0,0,,Tất nhiên rồi!
Dialogue: 0,0:14:47.97,0:14:50.85,Default,,0,0,0,,Mau tập hợp lại tổ đội bốn người\Ncàng sớm càng tốt thôi!
Dialogue: 0,0:14:55.52,0:14:57.23,Default,,0,0,0,,Vậy thì chúng ta quay lại thôi.
Dialogue: 0,0:14:57.31,0:15:00.69,Default,,0,0,0,,Phải báo cho các bạn lớp 6-1 biết\Nlà giờ đã an toàn rồi.
Dialogue: 0,0:15:00.78,0:15:02.53,Default,,0,0,0,,Khoan đã, trước khi làm thế,
Dialogue: 0,0:15:03.19,0:15:05.90,Default,,0,0,0,,ba người chúng ta cứ lập thành một tổ đội\Ntrước đi đã.
Dialogue: 0,0:15:06.45,0:15:08.49,Default,,0,0,0,,Chúng ta có thể nhìn thấy HP của nhau,
Dialogue: 0,0:15:08.58,0:15:11.21,Default,,0,0,0,,với lại dù không trực tiếp đánh\Nvẫn được chia điểm kinh nghiệm.
Dialogue: 0,0:15:11.29,0:15:12.17,Default,,0,0,0,,LỜI MỜI KẾT BẠN
Dialogue: 0,0:15:14.37,0:15:15.37,Default,,0,0,0,,BẠN CÓ MUỐN GIA NHẬP KHÔNG?
Dialogue: 0,0:15:15.46,0:15:16.29,Default,,0,0,0,,Chắc chắn rồi!
Dialogue: 0,0:15:16.37,0:15:18.75,Default,,0,0,0,,Nếu con quái vật đó còn xuất hiện lần nữa,
Dialogue: 0,0:15:18.84,0:15:22.18,Default,,0,0,0,,tớ sẽ nện cho nó bất tỉnh tại chỗ\Nbằng sức mạnh vật lý của tớ luôn!
Dialogue: 0,0:15:26.59,0:15:28.30,Default,,0,0,0,,SAWA ASHIHARA
Dialogue: 0,0:15:29.76,0:15:30.76,Default,,0,0,0,,{\an8}ALTEA TẦNG 1
Dialogue: 0,0:15:30.85,0:15:31.68,Default,,0,0,0,,{\an8}Gì vậy ạ?
Dialogue: 0,0:15:32.22,0:15:34.06,Default,,0,0,0,,À, không có gì đâu.
Dialogue: 0,0:15:34.14,0:15:35.27,Default,,0,0,0,,Này, anh Yu.
Dialogue: 0,0:15:35.98,0:15:37.19,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:15:37.27,0:15:40.32,Default,,0,0,0,,Chai cồn hồi nãy\Nanh tìm thấy ở đâu vậy?
Dialogue: 0,0:15:41.57,0:15:42.74,Default,,0,0,0,,Ở trong phòng kho phía sau ấy.
Dialogue: 0,0:15:43.90,0:15:44.94,Default,,0,0,0,,Em hiểu rồi.
Dialogue: 0,0:15:45.65,0:15:48.32,Default,,0,0,0,,Konken, cậu đi trước về chỗ mọi người\Ngiúp bọn tớ được không?
Dialogue: 0,0:15:49.53,0:15:51.57,Default,,0,0,0,,Thế còn hai anh em cậu thì sao?
Dialogue: 0,0:15:51.66,0:15:54.16,Default,,0,0,0,,Thì tớ đang ăn mặc thế này mà, thấy không?
Dialogue: 0,0:15:54.25,0:15:55.96,Default,,0,0,0,,Tớ muốn đi kiếm bộ đồ nào đó để mặc vào.
Dialogue: 0,0:15:58.71,0:15:59.84,Default,,0,0,0,,À ừ nhỉ, phải rồi.
Dialogue: 0,0:15:59.92,0:16:01.46,Default,,0,0,0,,Vậy tớ đi trước đây nhé.
Dialogue: 0,0:16:02.67,0:16:03.55,Default,,0,0,0,,Nhờ cậu nhé.
Dialogue: 0,0:16:10.64,0:16:13.48,Default,,0,0,0,,Chẳng phải em bảo\Nlà đi tìm quần áo mặc sao?
Dialogue: 0,0:16:13.56,0:16:14.98,Default,,0,0,0,,Sao bọn mình lại chui vào phòng y tế thế này?
Dialogue: 0,0:16:15.56,0:16:16.73,Default,,0,0,0,,Đưa tay em xem nào.
Dialogue: 0,0:16:21.27,0:16:23.90,Default,,0,0,0,,May quá. Chỉ là vết cắt nông thôi.
Dialogue: 0,0:16:24.53,0:16:26.16,Default,,0,0,0,,Em sát trùng lại cho anh cho chắc ăn.
Dialogue: 0,0:16:29.95,0:16:33.37,Default,,0,0,0,,THẺ CHỨNG NHẬN ĐỖ THỬ NGHIỆM\NTHẺ QUÁI VẬT - SQUEAK
Dialogue: 0,0:16:33.45,0:16:35.37,Default,,0,0,0,,CỒN SÁT TRÙNG
Dialogue: 0,0:16:35.95,0:16:37.20,Default,,0,0,0,,Em biết ngay mà!
Dialogue: 0,0:16:37.29,0:16:40.42,Default,,0,0,0,,Xem ra ta cũng cất được cả đồ vật\Nở thế giới thực vào kho đồ luôn đấy.
Dialogue: 0,0:16:41.54,0:16:44.75,Default,,0,0,0,,Anh Yu, mở kho đồ ra\Nrồi cất hết đồ ở đây vào trong đi.
Dialogue: 0,0:16:46.17,0:16:47.13,Default,,0,0,0,,Ừm, được thôi.
Dialogue: 0,0:16:57.18,0:16:58.85,Default,,0,0,0,,- Em định đập vỡ kính à?\N- Vâng.
Dialogue: 0,0:16:59.52,0:17:02.15,Default,,0,0,0,,Không đời nào. Dù có là tình huống khẩn cấp...
Dialogue: 0,0:17:02.94,0:17:04.73,Default,,0,0,0,,Anh Yu, bình tĩnh nghe em nói đã.
Dialogue: 0,0:17:05.40,0:17:08.40,Default,,0,0,0,,Em nghĩ bọn mình sẽ chưa thể\Nthoát khỏi đây trong một thời gian dài đâu.
Dialogue: 0,0:17:08.49,0:17:09.95,Default,,0,0,0,,Trong bao lâu cơ?
Dialogue: 0,0:17:10.03,0:17:12.16,Default,,0,0,0,,Hai ba ngày, có khi mười ngày,
Dialogue: 0,0:17:12.24,0:17:13.58,Default,,0,0,0,,hoặc tệ hơn là còn lâu hơn nữa.
Dialogue: 0,0:17:15.41,0:17:18.62,Default,,0,0,0,,Thôi nào, làm gì có chuyện\Nlâu đến mức đó được.
Dialogue: 0,0:17:19.12,0:17:21.91,Default,,0,0,0,,Giờ này bên ngoài chắc hẳn đang\Nnáo loạn hết cả lên rồi ấy chứ.
Dialogue: 0,0:17:23.75,0:17:26.92,Default,,0,0,0,,Chỉ cần điều máy ủi hay gì đó tới,\Nthì đến tấm kính kia chắc chắn cũng...
Dialogue: 0,0:17:27.01,0:17:28.68,Default,,0,0,0,,Anh cũng hiểu rõ rồi còn gì?
Dialogue: 0,0:17:28.76,0:17:30.26,Default,,0,0,0,,Altea hiện tại
Dialogue: 0,0:17:30.34,0:17:33.51,Default,,0,0,0,,đang dần bị thế giới của\NActual Magic nuốt chửng đấy.
Dialogue: 0,0:17:35.64,0:17:37.56,Default,,0,0,0,,Nhỡ đâu thứ cường hóa tấm kính kia
Dialogue: 0,0:17:37.64,0:17:40.64,Default,,0,0,0,,là một loại ma pháp tối thượng\Nmạnh đến mức chặn đứng được cả thiên thạch thì sao?
Dialogue: 0,0:17:41.23,0:17:43.36,Default,,0,0,0,,Anh nghĩ máy ủi có húc vỡ nổi không?
Dialogue: 0,0:17:45.48,0:17:47.86,Default,,0,0,0,,Với lại, đâu phải em tích trữ để ăn ngay bây giờ.
Dialogue: 0,0:17:48.36,0:17:52.57,Default,,0,0,0,,Nơi trú ẩn an toàn, thức ăn, nước uống và thuốc men,
Dialogue: 0,0:17:53.07,0:17:55.03,Default,,0,0,0,,những thứ đó sẽ trở nên vô cùng quan trọng đấy.
Dialogue: 0,0:17:55.87,0:17:57.79,Default,,0,0,0,,Rồi kiểu gì cũng xảy ra rắc rối cho xem.
Dialogue: 0,0:17:58.37,0:18:00.50,Default,,0,0,0,,Em định giữ hết mấy thứ này\Nlàm của riêng tụi mình à?
Dialogue: 0,0:18:00.58,0:18:01.79,Default,,0,0,0,,Không đời nào!
Dialogue: 0,0:18:01.87,0:18:04.75,Default,,0,0,0,,Em đi thu gom trước khi\Ncó kẻ khác chiếm mất
Dialogue: 0,0:18:04.83,0:18:06.71,Default,,0,0,0,,rồi đảm bảo chia đều công bằng cho mọi người thôi.
Dialogue: 0,0:18:06.80,0:18:08.51,Default,,0,0,0,,Thế thì đâu cần vội ngay bây giờ...
Dialogue: 0,0:18:08.59,0:18:10.68,Default,,0,0,0,,Em không muốn đến lúc quá muộn\Nmới ngồi hối hận đâu!
Dialogue: 0,0:18:15.39,0:18:18.27,Default,,0,0,0,,Hơn nữa, nếu trong tay có sẵn thuốc men và lương thực,
Dialogue: 0,0:18:18.35,0:18:21.69,Default,,0,0,0,,mình sẽ nắm thế chủ động hơn\Nnếu phải thương lượng với ai đó.
Dialogue: 0,0:18:28.32,0:18:31.74,Default,,0,0,0,,Em... có thật sự là Sawa không vậy?
Dialogue: 0,0:18:32.40,0:18:33.86,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:34.95,0:18:36.62,Default,,0,0,0,,Thôi, anh hiểu rồi.
Dialogue: 0,0:18:36.70,0:18:39.25,Default,,0,0,0,,Cùng nhét vào kho đồ càng nhiều\Ncàng tốt đi nào.
Dialogue: 0,0:18:41.54,0:18:44.54,Default,,0,0,0,,Không đập vỡ kính thì không lấy đồ bên trong ra được.
Dialogue: 0,0:18:44.62,0:18:48.37,Default,,0,0,0,,Nhưng em thật sự không muốn\Nđồ ăn bị dính đầy mảnh kính vụn đâu.
Dialogue: 0,0:18:49.13,0:18:51.01,Default,,0,0,0,,Vậy hay là anh em mình thử nghiệm xem sao?
Dialogue: 0,0:18:51.63,0:18:52.51,Default,,0,0,0,,Thử nghiệm á?
Dialogue: 0,0:18:55.39,0:18:57.52,Default,,0,0,0,,Anh sẽ thử cất thứ này vào kho đồ.
Dialogue: 0,0:19:08.86,0:19:11.78,Default,,0,0,0,,Ồ! Bụi bẩn rơi sạch ra ngoài hết kìa!
Dialogue: 0,0:19:11.86,0:19:14.49,Default,,0,0,0,,Ừ. Anh đoán là những thứ\Nkhông phải vật phẩm
Dialogue: 0,0:19:14.57,0:19:17.41,Default,,0,0,0,,thì hệ thống sẽ không cho cất vào đâu.
Dialogue: 0,0:19:17.49,0:19:20.41,Default,,0,0,0,,Ra là vậy. Nghĩ hay lắm anh Yu!
Dialogue: 0,0:19:26.79,0:19:30.09,Default,,0,0,0,,Ít nhất thì tạm thời nước uống, thức ăn\Nvà thuốc men đã ổn thỏa rồi nhé.
Dialogue: 0,0:19:30.92,0:19:33.05,Default,,0,0,0,,Cảm ơn đã phụ em nhé, anh Yu.
Dialogue: 0,0:19:34.55,0:19:36.68,Default,,0,0,0,,Sẵn tiện anh ở lại với em thêm một lát nữa\Nđược không?
Dialogue: 0,0:19:40.01,0:19:41.43,Default,,0,0,0,,PHÒNG THAY ĐỒ NỮ
Dialogue: 0,0:19:41.51,0:19:43.43,Default,,0,0,0,,Chà, hơi bị rộng phết đấy.
Dialogue: 0,0:19:46.06,0:19:48.94,Default,,0,0,0,,Nhưng thế này lại hay đấy.\NEm có thể giấu đôi cánh vào trong.
Dialogue: 0,0:19:49.77,0:19:51.11,Default,,0,0,0,,Quay lại sảnh chính thôi nào...
Dialogue: 0,0:19:51.19,0:19:52.69,Default,,0,0,0,,Khoan đã, dừng lại chút đi, Sawa!
Dialogue: 0,0:19:54.24,0:19:58.45,Default,,0,0,0,,Anh với Konken chỉ có biểu tượng QREST to ra thôi,
Dialogue: 0,0:19:58.53,0:20:00.99,Default,,0,0,0,,vậy mà chỉ có mình em mọc ra thứ như thế...
Dialogue: 0,0:20:01.08,0:20:02.92,Default,,0,0,0,,Chuyện đó vô lý quá đi mất!
Dialogue: 0,0:20:05.25,0:20:06.42,Default,,0,0,0,,Lại đây một chút được không anh?
Dialogue: 0,0:20:13.00,0:20:15.29,Default,,0,0,0,,Này, em lấy cái đó ở đâu ra vậy?
Dialogue: 0,0:20:15.38,0:20:16.84,Default,,0,0,0,,Ở trong tủ đồ.
Dialogue: 0,0:20:16.93,0:20:18.51,Default,,0,0,0,,Nhưng anh nhìn kỹ đi.
Dialogue: 0,0:20:23.18,0:20:25.43,Default,,0,0,0,,Tóc của anh biến thành màu xanh rồi!
Dialogue: 0,0:20:26.23,0:20:27.65,Default,,0,0,0,,Không chỉ riêng mình em đâu.
Dialogue: 0,0:20:28.23,0:20:31.28,Default,,0,0,0,,Tuy mức độ có khác nhau,\Nnhưng cơ thể của anh cũng đang biến đổi đấy.
Dialogue: 0,0:20:31.94,0:20:34.57,Default,,0,0,0,,Chắc chắn Konken\Nvà mọi người trong lớp cũng đều thế cả.
Dialogue: 0,0:20:37.15,0:20:39.15,Default,,0,0,0,,Anh thấy có chỗ gồ lên...
Dialogue: 0,0:20:40.82,0:20:42.07,Default,,0,0,0,,Cái gì đây thế này?
Dialogue: 0,0:20:43.37,0:20:46.75,Default,,0,0,0,,Lẽ nào chúng ta cũng đang trải qua\Nchuyện giống như Watamaki sao?
Dialogue: 0,0:20:47.29,0:20:49.46,Default,,0,0,0,,Rồi một ngày nào đó bọn anh cũng sẽ biến thành như vậy ư?
Dialogue: 0,0:20:50.25,0:20:53.25,Default,,0,0,0,,{\i1}Chắc là sẽ không biến thành giống Sumika đâu.{\i0}
Dialogue: 0,0:20:53.96,0:20:56.46,Default,,0,0,0,,{\i1}Sự biến đổi của cậu ấy\Nchỉ là một trường hợp ngoại lệ thôi.{\i0}
Dialogue: 0,0:20:59.38,0:21:00.63,Default,,0,0,0,,Này, Sawa,
Dialogue: 0,0:21:00.72,0:21:04.06,Default,,0,0,0,,em vẫn còn biết điều gì đó\Nmà chưa nói với anh đúng không?
Dialogue: 0,0:21:04.64,0:21:08.14,Default,,0,0,0,,Chuyện gì đang xảy ra với tụi mình, với cả Altea vậy?
Dialogue: 0,0:21:13.36,0:21:14.24,Default,,0,0,0,,Xin anh đấy,
Dialogue: 0,0:21:14.98,0:21:16.90,Default,,0,0,0,,hãy cho em thêm một chút thời gian nữa thôi.
Dialogue: 0,0:21:19.32,0:21:22.99,Default,,0,0,0,,Khi tình hình lắng xuống,\Nem sẽ kể cho anh tất cả những gì em biết.
Dialogue: 0,0:21:25.45,0:21:26.66,Default,,0,0,0,,Nhưng hiện giờ,
Dialogue: 0,0:21:26.74,0:21:29.16,Default,,0,0,0,,em muốn tìm hiểu thêm\Nvà suy nghĩ cho thấu đáo đã.
Dialogue: 0,0:21:30.21,0:21:31.13,Default,,0,0,0,,Vậy nên...
Dialogue: 0,0:21:33.79,0:21:35.17,Default,,0,0,0,,Ừ, anh hiểu rồi.
Dialogue: 0,0:21:36.42,0:21:39.17,Default,,0,0,0,,Xin lỗi vì đã nói như thể\Nanh không tin tưởng em nhé.
Dialogue: 0,0:21:39.84,0:21:42.93,Default,,0,0,0,,Anh biết là em đang cố gắng hết sức mà.
Dialogue: 0,0:21:49.43,0:21:51.43,Default,,0,0,0,,Đừng có ăn nói hàm hồ!
Dialogue: 0,0:21:52.27,0:21:55.19,Default,,0,0,0,,Chắc chắn mày cũng là một con quái vật giống tụi nó rồi!
Dialogue: 0,0:21:55.27,0:21:56.48,Default,,0,0,0,,Kondo!
Dialogue: 0,0:23:28.03,0:23:28.91,Default,,0,0,0,,NGHI NGỜ
Dialogue: 0,0:23:28.99,0:23:30.95,Default,,0,0,0,,{\i1}- Cậu nói cái quái gì vậy, Gamo?\N- Watamaki đâu rồi?{\i0}
Dialogue: 0,0:23:31.04,0:23:32.08,Default,,0,0,0,,{\i1}Chuyện gì khiến bọn mình biến thành quái vật thế này?{\i0}
Dialogue: 0,0:23:32.16,0:23:33.12,Default,,0,0,0,,{\i1}Chẳng lẽ mày giết cậu ấy rồi sao...{\i0}
Dialogue: 0,0:23:33.20,0:23:35.66,Default,,0,0,0,,{\i1}Đó là ma thuật đúng không?{\i0}
Dialogue: 0,0:23:36.17,0:23:37.30,Default,,0,0,0,,{\i1}Mo-yan?{\i0}
Dialogue: 0,0:23:37.38,0:23:39.92,Default,,0,0,0,,{\i1}Tomochi đã che chở cho tớ,{\i0}
Dialogue: 0,0:23:40.71,0:23:42.96,Default,,0,0,0,,{\i1}vậy mà tớ lại bỏ cậu ấy chạy mất...{\i0}
Dialogue: 0,0:23:43.05,0:23:45.05,Default,,0,0,0,,Phụ đề tiếng Việt bởi Amtia(NOFACE)
