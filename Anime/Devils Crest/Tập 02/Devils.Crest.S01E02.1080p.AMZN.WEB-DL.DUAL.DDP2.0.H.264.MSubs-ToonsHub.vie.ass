Dialogue: 0,0:00:04.46,0:00:07.92,Default,,0,0,0,,Chào buổi sáng, các em học sinh lớp 6-1!
Dialogue: 0,0:00:08.34,0:00:09.97,Default,,0,0,0,,Chúng em chào cô ạ!
Dialogue: 0,0:00:10.76,0:00:13.89,Default,,0,0,0,,Chào mừng các em đến với đợt chơi thử
Dialogue: 0,0:00:13.89,0:00:18.14,Default,,0,0,0,,tựa game VRMMORPG Nhập Thần Toàn Phần đầu tiên trên thế giới\Ncủa tập đoàn IO-TAGE,
Dialogue: 0,0:00:18.14,0:00:21.77,Default,,0,0,0,,{\an8}Actual Magic.
Dialogue: 0,0:00:21.77,0:00:23.94,Default,,0,0,0,,Rất cảm ơn các em đã có mặt tham gia ngày hôm nay.
Dialogue: 0,0:00:25.53,0:00:30.53,Default,,0,0,0,,Tất cả các em đã đeo thiết bị QREST,\Nkính i-Lens và tai nghe đầy đủ chưa nào?
Dialogue: 0,0:00:30.53,0:00:31.78,Default,,0,0,0,,Chết dở!
Dialogue: 0,0:00:31.78,0:00:33.20,Default,,0,0,0,,Tớ cũng quên mất tiêu.
Dialogue: 0,0:00:41.54,0:00:43.17,Default,,0,0,0,,Được rồi đây.
Dialogue: 0,0:00:43.79,0:00:46.75,Default,,0,0,0,,Giờ thì các em hãy mở thanh menu QREST
Dialogue: 0,0:00:46.76,0:00:48.72,Default,,0,0,0,,và xác nhận thông báo hiển thị nhé.
Dialogue: 0,0:00:50.59,0:00:52.22,Default,,0,0,0,,ĐÃ CÀI ĐẶT BẢN CÀI\NACTUAL MAGIC
Dialogue: 0,0:00:52.80,0:00:56.26,Default,,0,0,0,,Đó chính là chương trình cài đặt của Actual Magic.
Dialogue: 0,0:00:57.31,0:01:01.15,Default,,0,0,0,,Xin lưu ý rằng\Nlúc này các em vẫn chưa thể khởi chạy được nhé.
Dialogue: 0,0:01:02.56,0:01:04.10,Default,,0,0,0,,CẢNH BÁO: YÊU CẦU CẤP QUYỀN TRUY CẬP
Dialogue: 0,0:01:08.19,0:01:13.44,Default,,0,0,0,,{\an8}Giờ các em hãy di chuyển lên Phòng chơi số 1\Nở tầng hai
Dialogue: 0,0:01:13.45,0:01:17.20,Default,,0,0,0,,và bước vào khoang Caliculus,\Nthiết bị truyền sinh trắc học
Dialogue: 0,0:01:17.20,0:01:20.83,Default,,0,0,0,,sẽ đưa các em bước vào\Nthế giới của Actual Magic.
Dialogue: 0,0:01:23.58,0:01:28.46,Default,,0,0,0,,Trước hết, hệ thống sẽ quét toàn thân\Nđể tạo nhân vật đại diện cho các em.
Dialogue: 0,0:01:28.46,0:01:31.80,Default,,0,0,0,,Để quá trình quét thu thập\Nnhững chi tiết chuẩn xác nhất trên cơ thể,
Dialogue: 0,0:01:31.80,0:01:35.09,Default,,0,0,0,,vui lòng giữ yên tư thế\Ncho đến khi quá trình hoàn tất nhé.
Dialogue: 0,0:01:36.06,0:01:38.81,Default,,0,0,0,,Những chỉ dẫn cụ thể hơn\Ncho các bước tiếp theo
Dialogue: 0,0:01:38.81,0:01:41.15,Default,,0,0,0,,sẽ được thông báo bên trong khoang Caliculus.
Dialogue: 0,0:01:42.02,0:01:45.44,Default,,0,0,0,,Đợt chơi thử nghiệm dự kiến kéo dài ba tiếng.
Dialogue: 0,0:01:46.23,0:01:48.86,Default,,0,0,0,,Như cô đã dặn lúc sáng,
Dialogue: 0,0:01:48.86,0:01:51.70,Default,,0,0,0,,cô muốn tất cả các em phải tuân thủ nghiêm túc\Nquy tắc ứng xử trong game đấy nhé!
Dialogue: 0,0:02:03.50,0:02:06.25,Default,,0,0,0,,Watamaki?
Dialogue: 0,0:03:41.31,0:03:42.94,Default,,0,0,0,,{\an8}DEVILS' CREST
Dialogue: 0,0:03:43.60,0:03:47.52,Default,,0,0,0,,{\an8}TẬP 2: BIẾN DỊ
Dialogue: 0,0:03:57.03,0:03:58.70,Default,,0,0,0,,Watamaki, là cậu đấy ư?
Dialogue: 0,0:04:07.62,0:04:11.41,Default,,0,0,0,,Chạy đi, Yu! Mau chạy ra ngoài\Nvà gọi người lớn tới đây!
Dialogue: 0,0:04:11.42,0:04:12.67,Default,,0,0,0,,Konken.
Dialogue: 0,0:04:26.81,0:04:29.81,Default,,0,0,0,,Cậu làm cái quái gì thế hả Yu? Mau ra ngoài đi!
Dialogue: 0,0:04:29.81,0:04:31.73,Default,,0,0,0,,Làm sao tớ có thể bỏ cậu lại mà tháo chạy được chứ!
Dialogue: 0,0:04:39.20,0:04:40.08,Default,,0,0,0,,Yu!
Dialogue: 0,0:04:57.21,0:04:58.46,Default,,0,0,0,,Yu!
Dialogue: 0,0:04:58.47,0:04:59.39,Default,,0,0,0,,Flamma!
Dialogue: 0,0:05:01.89,0:05:02.98,Default,,0,0,0,,Sagitta!
Dialogue: 0,0:05:03.89,0:05:05.06,Default,,0,0,0,,Ignis!
Dialogue: 0,0:05:05.64,0:05:07.35,Default,,0,0,0,,Flame Arrow!
Dialogue: 0,0:05:14.94,0:05:16.19,Default,,0,0,0,,Sawa?
Dialogue: 0,0:05:19.19,0:05:22.28,Default,,0,0,0,,Anh Yu, khởi chạy Actual Magic mau lên!
Dialogue: 0,0:05:22.28,0:05:23.95,Default,,0,0,0,,- Hả?\N- Nhanh lên anh!
Dialogue: 0,0:05:23.95,0:05:25.24,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:05:55.44,0:05:57.44,Default,,0,0,0,,{\an8}ALTHEA TẦNG 2 - PHÒNG CHƠI 01
Dialogue: 0,0:05:57.44,0:05:59.86,Default,,0,0,0,,YUMA ASHIHARA
Dialogue: 0,0:06:03.95,0:06:05.87,Default,,0,0,0,,SAWA ASHIHARA
Dialogue: 0,0:06:06.66,0:06:07.66,Default,,0,0,0,,Tại sao...
Dialogue: 0,0:06:07.66,0:06:09.95,Default,,0,0,0,,- Chẳng lẽ chúng ta vẫn đang ở trong g--\N- Đây là thế giới thực đấy!
Dialogue: 0,0:06:09.95,0:06:12.37,Default,,0,0,0,,Nếu anh chết ở đây, anh sẽ chết thật đấy!
Dialogue: 0,0:06:16.71,0:06:18.63,Default,,0,0,0,,SUMIKA WATAMAKI
Dialogue: 0,0:06:21.22,0:06:24.06,Default,,0,0,0,,Phải mất 30 giây nữa\Nem mới thi triển phép tiếp theo được.
Dialogue: 0,0:06:24.76,0:06:26.30,Default,,0,0,0,,Anh ráng cầm chân cậu ấy đến lúc đó đi!
Dialogue: 0,0:06:26.30,0:06:28.22,Default,,0,0,0,,Chúng ta phải đánh tụt máu cậu ấy xuống vạch đỏ!
Dialogue: 0,0:06:28.22,0:06:29.64,Default,,0,0,0,,Cầm chân cậu ấy sao?
Dialogue: 0,0:06:29.64,0:06:30.77,Default,,0,0,0,,Cậu ấy lao tới kìa!
Dialogue: 0,0:06:41.32,0:06:42.86,Default,,0,0,0,,Sao mình lại...
Dialogue: 0,0:06:42.86,0:06:44.53,Default,,0,0,0,,Chỉ số của anh đã tăng lên rồi đấy!
Dialogue: 0,0:06:45.11,0:06:47.15,Default,,0,0,0,,Tiếp tục đi anh, câu thêm chút thời gian nữa!
Dialogue: 0,0:07:02.30,0:07:04.05,Default,,0,0,0,,Lùi lại mau! Flamma!
Dialogue: 0,0:07:04.05,0:07:05.93,Default,,0,0,0,,Khoan đã. Đừng giết cậu ấy!
Dialogue: 0,0:07:05.93,0:07:06.85,Default,,0,0,0,,SUMIKA WATAMAKI
Dialogue: 0,0:07:06.84,0:07:08.51,Default,,0,0,0,,Anh nói cái gì thế hả?
Dialogue: 0,0:07:08.51,0:07:11.47,Default,,0,0,0,,Nếu chúng ta không tiêu diệt,\Ncậu ấy sẽ tiếp tục tấn công chúng ta đấy!
Dialogue: 0,0:07:30.28,0:07:31.32,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:07:32.58,0:07:33.96,Default,,0,0,0,,Watamaki!
Dialogue: 0,0:07:33.95,0:07:35.45,Default,,0,0,0,,Cậu đang tìm gì thế à?
Dialogue: 0,0:07:36.12,0:07:39.21,Default,,0,0,0,,Tớ làm rơi mất kính i-Lens rồi.
Dialogue: 0,0:07:39.21,0:07:41.63,Default,,0,0,0,,Cậu có chắc là nó không chỉ bị lệch vị trí trong mắt thôi không?
Dialogue: 0,0:07:42.67,0:07:45.21,Default,,0,0,0,,Không, đúng thật rồi. Không có trong mắt tớ.
Dialogue: 0,0:07:46.18,0:07:47.72,Default,,0,0,0,,Để tớ tìm giúp cậu nhé.
Dialogue: 0,0:07:47.72,0:07:49.30,Default,,0,0,0,,Ấy không sao đâu, tớ...
Dialogue: 0,0:07:49.30,0:07:50.72,Default,,0,0,0,,Đừng ngại mà.
Dialogue: 0,0:07:51.89,0:07:53.22,Default,,0,0,0,,Đưa tay cho tớ một lát nào.
Dialogue: 0,0:07:57.19,0:07:58.61,Default,,0,0,0,,{\an8}ĐỊNH VỊ THIẾT BỊ
Dialogue: 0,0:08:05.03,0:08:06.24,Default,,0,0,0,,Nó kia rồi!
Dialogue: 0,0:08:11.78,0:08:14.78,Default,,0,0,0,,Cảm ơn cậu nhé. Nhưng làm sao cậu biết được...
Dialogue: 0,0:08:14.79,0:08:18.38,Default,,0,0,0,,Thiết bị QREST có tính năng định vị i-Lens và tai nghe
Dialogue: 0,0:08:18.37,0:08:20.25,Default,,0,0,0,,mỗi khi bị rơi mà.
Dialogue: 0,0:08:20.25,0:08:22.21,Default,,0,0,0,,Tớ làm mất suốt ấy mà.
Dialogue: 0,0:08:22.71,0:08:25.63,Default,,0,0,0,,Cậu mà cũng làm mất đồ sao?
Dialogue: 0,0:08:26.84,0:08:28.97,Default,,0,0,0,,Tất nhiên rồi. Sao lại không chứ?
Dialogue: 0,0:08:28.97,0:08:33.48,Default,,0,0,0,,Thì... cậu vừa giỏi thể thao lại học giỏi,\Ncòn làm người mẫu nữa,
Dialogue: 0,0:08:34.06,0:08:36.73,Default,,0,0,0,,nên tớ cứ ngỡ cậu là người hoàn hảo cơ.
Dialogue: 0,0:08:36.73,0:08:38.65,Default,,0,0,0,,Làm gì có chuyện đó.
Dialogue: 0,0:08:38.64,0:08:40.52,Default,,0,0,0,,Người ta cứ thêu dệt đủ điều,
Dialogue: 0,0:08:41.40,0:08:42.86,Default,,0,0,0,,chứ thực ra tớ...
Dialogue: 0,0:08:44.44,0:08:47.86,Default,,0,0,0,,tớ cũng chỉ là một đứa trẻ bình thường như bao người thôi.
Dialogue: 0,0:08:54.49,0:08:55.78,Default,,0,0,0,,Watamaki...
Dialogue: 0,0:08:57.25,0:08:58.92,Default,,0,0,0,,SUMIKA WATAMAKI
Dialogue: 0,0:09:01.04,0:09:02.96,Default,,0,0,0,,{\an8}YUMA\NĐẠI THỎ SỪNG - ĐỒNG BẰNG ĐÔNG CALCINA
Dialogue: 0,0:09:03.79,0:09:04.83,Default,,0,0,0,,Ignis!
Dialogue: 0,0:09:08.80,0:09:09.97,Default,,0,0,0,,Tenebris!
Dialogue: 0,0:09:11.80,0:09:13.05,Default,,0,0,0,,Capere Anima!
Dialogue: 0,0:09:22.94,0:09:23.90,Default,,0,0,0,,Ignis!
Dialogue: 0,0:09:41.00,0:09:42.88,Default,,0,0,0,,{\an8}SUMIKA WATAMAKI
Dialogue: 0,0:09:53.97,0:09:54.89,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:09:55.97,0:09:58.93,Default,,0,0,0,,Anh Yu? Này! Tỉnh lại đi anh!
Dialogue: 0,0:10:06.86,0:10:10.07,Default,,0,0,0,,Này, cậu chắc dùng cách đó an toàn chứ?
Dialogue: 0,0:10:10.07,0:10:12.74,Default,,0,0,0,,Trị khỏi cho cậu rồi thì anh ấy cũng không sao đâu.
Dialogue: 0,0:10:24.96,0:10:27.76,Default,,0,0,0,,Anh có sao không? Có thấy đau ở đâu không?
Dialogue: 0,0:10:28.38,0:10:29.67,Default,,0,0,0,,Sawa...
Dialogue: 0,0:10:35.59,0:10:39.30,Default,,0,0,0,,Đó là ma pháp Healing Droplet đúng không?
Dialogue: 0,0:10:39.31,0:10:41.64,Default,,0,0,0,,Nhưng chúng ta đang ở thế giới thực mà...
Dialogue: 0,0:10:41.64,0:10:45.14,Default,,0,0,0,,Thật đấy à Yu?\NCậu vẫn chưa hiểu chuyện gì đang xảy ra sao?
Dialogue: 0,0:10:45.15,0:10:47.78,Default,,0,0,0,,Lúc nãy anh cũng thấy em dùng Flame Arrow rồi còn gì?
Dialogue: 0,0:10:48.44,0:10:50.57,Default,,0,0,0,,Rồi còn nhìn lại việc anh vừa làm xem...
Dialogue: 0,0:10:57.16,0:10:59.87,Default,,0,0,0,,Không thể tin nổi là anh lại có thể thu phục được cậu ấy.
Dialogue: 0,0:10:59.87,0:11:01.83,Default,,0,0,0,,Rốt cuộc chuyện quái quỷ gì đang diễn ra thế này?
Dialogue: 0,0:11:03.25,0:11:05.42,Default,,0,0,0,,Konken! Cậu không sao chứ?
Dialogue: 0,0:11:05.42,0:11:09.26,Default,,0,0,0,,Ừ, cánh tay trái của tớ vẫn còn hơi đau nhức, nhưng mà...
Dialogue: 0,0:11:09.25,0:11:11.46,Default,,0,0,0,,Ý tớ là, lúc nãy cảm giác như gãy lìa rồi,
Dialogue: 0,0:11:12.09,0:11:13.67,Default,,0,0,0,,nhưng Saps đã dùng ma pháp chữa lành cho tớ.
Dialogue: 0,0:11:15.18,0:11:18.02,Default,,0,0,0,,Quan trọng hơn là chuyện này có thật không vậy?
Dialogue: 0,0:11:18.68,0:11:20.31,Default,,0,0,0,,Cả cậu cũng thế à?
Dialogue: 0,0:11:20.31,0:11:23.15,Default,,0,0,0,,Saps bảo tớ khởi chạy Actual Magic,
Dialogue: 0,0:11:23.14,0:11:24.68,Default,,0,0,0,,và nó liền xuất hiện ngay khi tớ vừa bật.
Dialogue: 0,0:11:24.68,0:11:27.68,Default,,0,0,0,,Cơn đau lúc đó còn dữ dội hơn\Ncả cú đấm của Watamaki nữa.
Dialogue: 0,0:11:29.19,0:11:32.32,Default,,0,0,0,,Đó thực sự là Watamaki sao?
Dialogue: 0,0:11:32.32,0:11:35.28,Default,,0,0,0,,Ừ. Chính là cậu ấy.
Dialogue: 0,0:11:36.57,0:11:40.32,Default,,0,0,0,,Nhưng mặt mũi cậu ấy đâu có còn nữa!
Dialogue: 0,0:11:40.33,0:11:43.00,Default,,0,0,0,,Đã thế cậu ấy còn lao vào đập chúng ta tơi tả...
Dialogue: 0,0:11:46.96,0:11:48.34,Default,,0,0,0,,Thật không đấy?
Dialogue: 0,0:11:48.92,0:11:52.63,Default,,0,0,0,,Biết đâu đây không phải giấc mơ,\Nmà chúng ta vẫn đang kẹt trong game thì sao.
Dialogue: 0,0:11:53.21,0:11:55.17,Default,,0,0,0,,- Này Sawa.\N- Dạ, sao anh?
Dialogue: 0,0:11:55.17,0:11:58.55,Default,,0,0,0,,Lúc nãy em bảo\Nđây là thế giới thực đúng không?
Dialogue: 0,0:11:58.55,0:12:00.93,Default,,0,0,0,,Và nếu chúng ta chết ở đây, chúng ta sẽ thực sự bỏ mạng.
Dialogue: 0,0:12:00.93,0:12:03.72,Default,,0,0,0,,Em có lý do cụ thể nào\Nđể khẳng định như vậy không?
Dialogue: 0,0:12:03.72,0:12:05.76,Default,,0,0,0,,Có chứ anh.
Dialogue: 0,0:12:05.77,0:12:07.90,Default,,0,0,0,,Chắc anh cũng biết điều này rồi mà, anh Yu.
Dialogue: 0,0:12:08.48,0:12:12.02,Default,,0,0,0,,Cảm giác ảo\Ndo khoang Caliculus mang lại
Dialogue: 0,0:12:12.02,0:12:13.56,Default,,0,0,0,,chỉ giới hạn ở xúc giác mà thôi.
Dialogue: 0,0:12:15.24,0:12:16.91,Default,,0,0,0,,Thị giác thì hiển thị qua kính i-Lens,
Dialogue: 0,0:12:17.57,0:12:20.49,Default,,0,0,0,,còn thính giác thì được truyền\Nqua tai nghe,
Dialogue: 0,0:12:20.49,0:12:24.70,Default,,0,0,0,,nhưng vị giác và khứu giác thì chưa được hỗ trợ.\NĐiều đó đồng nghĩa với việc...
Dialogue: 0,0:12:24.70,0:12:26.70,Default,,0,0,0,,Nếu chúng ta nếm hay ngửi thấy bất cứ thứ gì,
Dialogue: 0,0:12:26.71,0:12:29.67,Default,,0,0,0,,chứng tỏ chúng ta hoàn toàn không ở trong thế giới ảo.
Dialogue: 0,0:12:30.92,0:12:32.88,Default,,0,0,0,,Mùi gì thế này?
Dialogue: 0,0:12:36.97,0:12:39.72,Default,,0,0,0,,Vậy là... mọi chuyện này đều có thật sao?
Dialogue: 0,0:12:40.30,0:12:43.51,Default,,0,0,0,,Kính i-Lens và tai nghe dường như\Ncũng đã gắn liền thành một phần cơ thể rồi.
Dialogue: 0,0:12:43.51,0:12:45.47,Default,,0,0,0,,Nên đừng có dại mà giật mạnh ra nhé.
Dialogue: 0,0:12:45.47,0:12:48.89,Default,,0,0,0,,Sawa, sao em có thể bình tĩnh trước tất cả chuyện này vậy?
Dialogue: 0,0:12:50.19,0:12:54.78,Default,,0,0,0,,Không chỉ bình tĩnh đâu. Trông em cứ như biết rất rõ\Nnhững gì đang diễn ra vậy.
Dialogue: 0,0:12:54.77,0:12:56.94,Default,,0,0,0,,Có phải em đã biết trước chuyện này sẽ xảy ra
Dialogue: 0,0:12:56.94,0:12:59.11,Default,,0,0,0,,khi chúng ta khởi chạy Actual Magic không?
Dialogue: 0,0:12:59.70,0:13:00.78,Default,,0,0,0,,Hỏi chuẩn đấy.
Dialogue: 0,0:13:03.78,0:13:05.70,Default,,0,0,0,,Làm gì có chuyện đó chứ!
Dialogue: 0,0:13:05.70,0:13:08.54,Default,,0,0,0,,Em chỉ thử bật lên xem sao,\Nvà tự nhiên nó thành ra thế này thôi.
Dialogue: 0,0:13:10.58,0:13:15.08,Default,,0,0,0,,Bộ anh tưởng em thích biến thành cái bộ dạng này lắm à?
Dialogue: 0,0:13:21.13,0:13:23.01,Default,,0,0,0,,Anh làm cái trò gì đấy hả đồ ngốc này?
Dialogue: 0,0:13:23.72,0:13:25.97,Default,,0,0,0,,Anh chỉ tò mò chút thôi mà.
Dialogue: 0,0:13:25.97,0:13:29.64,Default,,0,0,0,,Đừng có chạm vào chỗ đó! Nhột chết đi được!
Dialogue: 0,0:13:31.23,0:13:32.81,Default,,0,0,0,,Thế còn đôi cánh kia thì sao?
Dialogue: 0,0:13:39.69,0:13:41.40,Default,,0,0,0,,Giờ chúng ta phải làm gì đây?
Dialogue: 0,0:13:42.74,0:13:46.49,Default,,0,0,0,,Trước hết phải đánh thức Nagi dậy đã.\NRồi sau đó hẵng tính tiếp.
Dialogue: 0,0:13:46.49,0:13:48.41,Default,,0,0,0,,Ừ. Phải đấy.
Dialogue: 0,0:13:56.59,0:13:58.68,Default,,0,0,0,,Nagi. Dậy đi nào, Nagi.
Dialogue: 0,0:14:02.22,0:14:03.68,Default,,0,0,0,,Tớ nghĩ là...
Dialogue: 0,0:14:07.01,0:14:08.10,Default,,0,0,0,,Nagi?
Dialogue: 0,0:14:21.86,0:14:25.11,Default,,0,0,0,,Cần gạt mở khẩn cấp bên trong\Nchưa hề được đụng tới.
Dialogue: 0,0:14:25.12,0:14:26.75,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:14:27.45,0:14:29.95,Default,,0,0,0,,Một khi đã giật cần gạt bên ngoài,
Dialogue: 0,0:14:29.95,0:14:33.66,Default,,0,0,0,,sẽ không thể gạt lại về vị trí cũ\Nnếu không khởi động lại khoang Caliculus.
Dialogue: 0,0:14:33.67,0:14:35.13,Default,,0,0,0,,Bên hướng dẫn đã dặn chúng ta như vậy lúc sáng rồi.
Dialogue: 0,0:14:35.13,0:14:36.09,Default,,0,0,0,,Ừ.
Dialogue: 0,0:14:36.63,0:14:38.63,Default,,0,0,0,,Vậy... điều đó có nghĩa là...
Dialogue: 0,0:14:38.63,0:14:40.59,Default,,0,0,0,,Cho tới tận lúc chúng ta mở ra vừa rồi,
Dialogue: 0,0:14:40.59,0:14:43.93,Default,,0,0,0,,tuyệt đối không một ai\Ncó thể ra hay vào khoang này được.
Dialogue: 0,0:14:43.93,0:14:47.27,Default,,0,0,0,,Cái gì? Vô lý hết sức!
Dialogue: 0,0:14:47.26,0:14:51.01,Default,,0,0,0,,Nagi tham gia thử nghiệm cùng cả nhóm mà,
Dialogue: 0,0:14:51.02,0:14:53.44,Default,,0,0,0,,cậu ấy chắc chắn phải ở bên trong chứ.
Dialogue: 0,0:14:53.44,0:14:56.90,Default,,0,0,0,,Sau khi chúng ta hạ gục con rồng đó...
Dialogue: 0,0:14:58.02,0:15:01.32,Default,,0,0,0,,{\i1}Tớ nhớ sàn phòng trùm đột ngột hóa đỏ rực.{\i0}
Dialogue: 0,0:15:02.03,0:15:03.95,Default,,0,0,0,,{\i1}Lúc đó tớ chẳng thể làm gì được cả.{\i0}
Dialogue: 0,0:15:07.78,0:15:09.03,Default,,0,0,0,,{\i1}Đến khi tớ nhận thức lại được,{\i0}
Dialogue: 0,0:15:09.03,0:15:11.91,Default,,0,0,0,,{\i1}thì đã nằm lại trong khoang Caliculus rồi.{\i0}
Dialogue: 0,0:15:13.29,0:15:15.67,Default,,0,0,0,,{\i1}Tớ gào gọi mãi mà không có ai tới,{\i0}
Dialogue: 0,0:15:15.67,0:15:17.92,Default,,0,0,0,,{\i1}nên đành tự giật cần để thoát ra.{\i0}
Dialogue: 0,0:15:19.67,0:15:21.13,Default,,0,0,0,,Tớ cũng y hệt như vậy.
Dialogue: 0,0:15:21.84,0:15:24.84,Default,,0,0,0,,Lúc trở về thực tại,\Nxung quanh chỉ toàn là một màu đen kịt...
Dialogue: 0,0:15:26.93,0:15:28.35,Default,,0,0,0,,Yu?
Dialogue: 0,0:15:32.35,0:15:34.81,Default,,0,0,0,,Ngay trước khi bước ra khỏi khoang,
Dialogue: 0,0:15:34.81,0:15:37.19,Default,,0,0,0,,tớ nghe như có tiếng ai đó thét lên.
Dialogue: 0,0:15:37.81,0:15:40.10,Default,,0,0,0,,Đó là cậu thét lên hả Konken?
Dialogue: 0,0:15:40.11,0:15:42.07,Default,,0,0,0,,Đâu có, tớ làm gì thét.
Dialogue: 0,0:15:42.61,0:15:44.44,Default,,0,0,0,,Đó là tiếng con trai hay con gái?
Dialogue: 0,0:15:44.44,0:15:47.86,Default,,0,0,0,,Âm sắc khá cao,\Nnhưng vì nghe vọng qua khoang nên...
Dialogue: 0,0:15:48.57,0:15:50.03,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:15:50.62,0:15:53.12,Default,,0,0,0,,Sawa! Em không nghĩ tiếng thét đó\Nlà của Nagi đấy chứ?
Dialogue: 0,0:15:53.12,0:15:55.54,Default,,0,0,0,,Đừng có hỏi em! Em cũng đâu có biết!
Dialogue: 0,0:16:03.05,0:16:05.39,Default,,0,0,0,,Thực ra tớ nghĩ khó có khả năng là cậu ấy.
Dialogue: 0,0:16:05.38,0:16:09.22,Default,,0,0,0,,Vì cần gạt chưa hề được giật,\NNagi không thể nào tự bước ra ngoài được.
Dialogue: 0,0:16:10.14,0:16:14.39,Default,,0,0,0,,Như vậy thì Watamaki cũng không tài nào tấn công cậu ấy được.
Dialogue: 0,0:16:14.39,0:16:17.43,Default,,0,0,0,,Đúng thế. Nhưng vậy thì giải thích thế nào...
Dialogue: 0,0:16:17.44,0:16:19.40,Default,,0,0,0,,Cậu ấy đâu thể bốc hơi biến mất được.
Dialogue: 0,0:16:20.15,0:16:23.65,Default,,0,0,0,,Cậu ấy chắc chắn phải ở đâu đó quanh đây, đúng không?\NNhất định phải thế.
Dialogue: 0,0:16:23.65,0:16:24.82,Default,,0,0,0,,Ừ.
Dialogue: 0,0:16:25.65,0:16:28.40,Default,,0,0,0,,Ừ. Tớ cũng nghĩ vậy.
Dialogue: 0,0:16:28.41,0:16:31.37,Default,,0,0,0,,Thế thì chúng ta phải đi tìm cậu ấy thôi.
Dialogue: 0,0:16:31.37,0:16:33.33,Default,,0,0,0,,Cái con nhỏ Nagimiso đó hay mít ướt lắm mà.
Dialogue: 0,0:16:33.91,0:16:37.29,Default,,0,0,0,,Tìm thấy cậu ấy rồi, tớ sẽ méch ngay là\Ncậu dám gọi cậu ấy là Nagimiso cho xem!
Dialogue: 0,0:16:38.00,0:16:40.55,Default,,0,0,0,,Khoan đã! Coi như tớ chưa từng nói gì đi, được chưa?!
Dialogue: 0,0:16:48.43,0:16:51.02,Default,,0,0,0,,Tớ sẽ đi tìm thầy cô xem sao!
Dialogue: 0,0:16:52.35,0:16:54.31,Default,,0,0,0,,Ngoài việc tìm kiếm Nagi ra,
Dialogue: 0,0:16:54.31,0:16:56.60,Default,,0,0,0,,chúng ta có thể thêm một mục tiêu nữa được không?
Dialogue: 0,0:16:57.43,0:16:59.22,Default,,0,0,0,,Trong lúc Watamaki đang ở dạng thẻ bài,
Dialogue: 0,0:16:59.23,0:17:02.44,Default,,0,0,0,,tớ muốn tìm cách\Nđưa cậu ấy trở lại bình thường.
Dialogue: 0,0:17:03.52,0:17:04.73,Default,,0,0,0,,Và tớ cần sự giúp đỡ của hai người.
Dialogue: 0,0:17:05.40,0:17:06.86,Default,,0,0,0,,Tất nhiên rồi.
Dialogue: 0,0:17:07.36,0:17:10.03,Default,,0,0,0,,Làm sao chúng ta có thể bỏ mặc\NWatamaki trong tình trạng như thế được chứ.
Dialogue: 0,0:17:19.08,0:17:20.16,Default,,0,0,0,,Sao thế em?
Dialogue: 0,0:17:20.17,0:17:21.63,Default,,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:17:22.13,0:17:23.67,Default,,0,0,0,,Giờ thì em hiểu rõ rồi.
Dialogue: 0,0:17:23.67,0:17:25.92,Default,,0,0,0,,Sumika là một cô bạn gái rất chi là dễ thương mà lại.
Dialogue: 0,0:17:25.92,0:17:29.67,Default,,0,0,0,,Chuyện đó chẳng liên quan gì hết!\NTrong tình cảnh hiểm nghèo này cơ mà!
Dialogue: 0,0:17:29.67,0:17:31.46,Default,,0,0,0,,Em biết rồi mà.
Dialogue: 0,0:17:31.47,0:17:33.64,Default,,0,0,0,,Em cũng muốn giúp cậu ấy trở lại bình thường.
Dialogue: 0,0:17:33.64,0:17:36.10,Default,,0,0,0,,Vậy kế hoạch cụ thể giờ là gì?
Dialogue: 0,0:17:38.77,0:17:41.44,Default,,0,0,0,,Trước mắt, chúng ta hãy xuống sảnh\Nở tầng một.
Dialogue: 0,0:17:41.44,0:17:43.98,Default,,0,0,0,,Nếu có ai khác cũng chui ra khỏi khoang Caliculus,
Dialogue: 0,0:17:43.98,0:17:46.06,Default,,0,0,0,,rất có thể họ sẽ tập trung về đó.
Dialogue: 0,0:17:46.07,0:17:47.70,Default,,0,0,0,,Nhưng trước đó...
Dialogue: 0,0:17:47.69,0:17:49.65,Default,,0,0,0,,Chúng ta phải lùng soát căn phòng này đã.
Dialogue: 0,0:17:49.65,0:17:51.74,Default,,0,0,0,,Biết đâu lại tìm thấy manh mối nào đó.
Dialogue: 0,0:17:52.49,0:17:54.20,Default,,0,0,0,,Ừ. Chuẩn đấy.
Dialogue: 0,0:17:54.20,0:17:55.62,Default,,0,0,0,,Chia nhau ra tìm đi.
Dialogue: 0,0:17:55.62,0:17:58.50,Default,,0,0,0,,Tớ kiểm tra bên này.\NHai người đi hướng kia nhé.
Dialogue: 0,0:17:58.50,0:18:01.21,Default,,0,0,0,,Thấy bất cứ thứ gì có thể dùng làm vũ khí\Nthì cứ vơ lấy hết.
Dialogue: 0,0:18:05.84,0:18:08.34,Default,,0,0,0,,Này, Saps với Nagimiso
Dialogue: 0,0:18:08.34,0:18:10.84,Default,,0,0,0,,lúc nào cũng trưng ra cái vẻ mặt kỳ quặc đó
Dialogue: 0,0:18:10.84,0:18:14.13,Default,,0,0,0,,mỗi khi chúng ta nhắc tới Watamaki nhỉ?
Dialogue: 0,0:18:14.14,0:18:16.43,Default,,0,0,0,,Dù rõ ràng mấy người chơi với nhau khá thân.
Dialogue: 0,0:18:17.26,0:18:18.59,Default,,0,0,0,,Nói cho mà biết nhé,
Dialogue: 0,0:18:18.60,0:18:21.60,Default,,0,0,0,,chỉ số của tôi tăng lên rồi,\Nthính giác cũng tăng theo đấy!
Dialogue: 0,0:18:21.60,0:18:23.10,Default,,0,0,0,,Tôi sẽ méch lại với cậu ấy không sót một chữ nào đâu!
Dialogue: 0,0:18:24.06,0:18:25.69,Default,,0,0,0,,Tớ xuống phía dưới xem sao.
Dialogue: 0,0:18:25.69,0:18:26.69,Default,,0,0,0,,Được.
Dialogue: 0,0:18:36.62,0:18:39.96,Default,,0,0,0,,Cái này... không đủ nặng.
Dialogue: 0,0:18:39.95,0:18:41.28,Default,,0,0,0,,Hóa ra là vậy.
Dialogue: 0,0:18:42.08,0:18:43.37,Default,,0,0,0,,Là sao cơ?
Dialogue: 0,0:18:43.37,0:18:45.08,Default,,0,0,0,,Biểu tượng quá tải trang bị
Dialogue: 0,0:18:45.08,0:18:48.00,Default,,0,0,0,,{\an8}vừa hiện lên bên dưới thanh trạng thái của tớ.
Dialogue: 0,0:18:48.59,0:18:49.93,Default,,0,0,0,,Thật á?
Dialogue: 0,0:19:00.06,0:19:02.10,Default,,0,0,0,,Trời đất, y như cơ chế trong game vậy.
Dialogue: 0,0:19:02.10,0:19:05.85,Default,,0,0,0,,Ừ. Cứ như thể hiện thực\Nđang bị ghi đè
Dialogue: 0,0:19:05.85,0:19:08.06,Default,,0,0,0,,bởi hệ thống của Actual Magic vậy.
Dialogue: 0,0:19:08.61,0:19:11.11,Default,,0,0,0,,Vậy tớ khỏe như vâm là vì mang class Chiến Binh sao?
Dialogue: 0,0:19:11.11,0:19:12.78,Default,,0,0,0,,Anh Yu! Konken!
Dialogue: 0,0:19:18.12,0:19:19.29,Default,,0,0,0,,Sawa?
Dialogue: 0,0:19:40.39,0:19:41.60,Default,,0,0,0,,Em xin lỗi...
Dialogue: 0,0:19:48.02,0:19:50.73,Default,,0,0,0,,LỚP 6-1
Dialogue: 0,0:19:56.78,0:19:58.24,Default,,0,0,0,,Nhìn chẳng giống cậu ấy một chút nào cả...
Dialogue: 0,0:20:06.41,0:20:08.75,Default,,0,0,0,,Cậu ấy... đã ăn quả tim của cậu ấy.
Dialogue: 0,0:20:13.71,0:20:15.34,Default,,0,0,0,,Tiếng thét lúc nãy...
Dialogue: 0,0:20:15.34,0:20:18.26,Default,,0,0,0,,Là của Miura.
Dialogue: 0,0:20:19.59,0:20:21.76,Default,,0,0,0,,Đó là Beroshi sao?
Dialogue: 0,0:20:25.93,0:20:29.27,Default,,0,0,0,,Watamaki... đã giết cậu ấy ư?
Dialogue: 0,0:20:35.03,0:20:37.37,Default,,0,0,0,,SUMIKA WATAMAKI\NNIGHT FIEND - CẤP 17
Dialogue: 0,0:20:37.36,0:20:40.36,Default,,0,0,0,,TAY PHẢI CỦA YUKIHISA MIURA\NCÔNG VẬT LÝ 18 - CÔNG MA PHÁP 3
Dialogue: 0,0:20:40.37,0:20:41.91,Default,,0,0,0,,Cái quái gì thế này?!
Dialogue: 0,0:20:41.91,0:20:43.91,Default,,0,0,0,,Beroshi đâu phải là nhân vật trong game đâu chứ...
Dialogue: 0,0:20:48.37,0:20:52.21,Default,,0,0,0,,Này, ít nhất chúng ta cũng nên\Nđặt cậu ấy ở một nơi yên nghỉ tử tế chứ?
Dialogue: 0,0:21:05.93,0:21:06.93,Default,,0,0,0,,Tiếng gì thế?
Dialogue: 0,0:21:10.94,0:21:12.07,Default,,0,0,0,,Từ tầng dưới vọng lên sao?
Dialogue: 0,0:21:13.31,0:21:14.31,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:21:25.70,0:21:27.03,Default,,0,0,0,,Tại sao...
Dialogue: 0,0:21:27.04,0:21:32.04,Default,,0,0,0,,{\an8}YUMA ASHIHARA\NALTHEA TẦNG 1
Dialogue: 0,0:21:32.04,0:21:35.29,Default,,0,0,0,,Cái gì thế này? Chuyện gì đang xảy ra vậy?
Dialogue: 0,0:21:49.77,0:21:51.44,Default,,0,0,0,,Con quái quỷ gì kia?
Dialogue: 0,0:21:51.44,0:21:53.90,Default,,0,0,0,,Tại sao lại có quái vật ở chỗ này?!
Dialogue: 0,0:23:27.99,0:23:28.91,Default,,0,0,0,,THỨC TỈNH
Dialogue: 0,0:23:28.91,0:23:30.83,Default,,0,0,0,,{\i1}Nghĩ đi nào. Làm sao để đánh bại nó đây?{\i0}
Dialogue: 0,0:23:30.83,0:23:32.33,Default,,0,0,0,,{\i1}Lại đây này, con quái vật kia!{\i0}
Dialogue: 0,0:23:32.33,0:23:34.08,Default,,0,0,0,,{\i1}Mình... chết rồi sao?{\i0}
Dialogue: 0,0:23:34.08,0:23:35.54,Default,,0,0,0,,{\i1}Được rồi, cứ để đó cho tớ!{\i0}
Dialogue: 0,0:23:35.54,0:23:37.33,Default,,0,0,0,,{\i1}Sợi tơ sinh mệnh đã được kết nối.{\i0}
Dialogue: 0,0:23:37.33,0:23:39.67,Default,,0,0,0,,{\i1}Tôi không muốn phải hối hận khi mọi chuyện đã quá muộn!{\i0}
Dialogue: 0,0:23:39.67,0:23:42.92,Default,,0,0,0,,{\i1}Cậu... thực sự là Sawa sao?{\i0}
