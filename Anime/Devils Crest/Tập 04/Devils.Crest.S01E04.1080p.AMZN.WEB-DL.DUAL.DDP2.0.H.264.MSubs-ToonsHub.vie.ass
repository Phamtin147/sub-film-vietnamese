Dialogue: 0,0:00:06.38,0:00:08.42,Default,,0,0,0,,Đừng có nói nhảm nữa!
Dialogue: 0,0:00:09.14,0:00:12.27,Default,,0,0,0,,Chắc chắn tụi mày cũng là quái vật luôn rồi!
Dialogue: 0,0:00:12.26,0:00:13.51,Default,,0,0,0,,Kondo!
Dialogue: 0,0:00:18.77,0:00:20.52,Default,,0,0,0,,Này, cậu làm cái trò gì thế?
Dialogue: 0,0:00:20.52,0:00:24.94,Default,,0,0,0,,Hai anh em nhà Ashihara. Cả tụi mày nữa à?\NĐừng có bước lại gần đây!
Dialogue: 0,0:02:02.33,0:02:04.00,Default,,0,0,0,,{\an8}DEVILS' CREST
Dialogue: 0,0:02:04.00,0:02:08.17,Default,,0,0,0,,{\an8}TẬP 4: NGHI NGỜ
Dialogue: 0,0:02:09.76,0:02:11.64,Default,,0,0,0,,Cậu đang nói cái gì thế hả, Gamo?
Dialogue: 0,0:02:11.63,0:02:14.01,Default,,0,0,0,,Sao cậu lại nghĩ tụi tớ là quái vật chứ?
Dialogue: 0,0:02:14.01,0:02:16.64,Default,,0,0,0,,Chứ còn giải thích thế nào được nữa!
Dialogue: 0,0:02:16.64,0:02:19.81,Default,,0,0,0,,Chính tụi mày đã hạ gục\Ncon quái vật khổng lồ kia đúng không?
Dialogue: 0,0:02:20.39,0:02:23.77,Default,,0,0,0,,Kẻ nào làm được chuyện đó thì\Nchỉ có thể là quái vật mà thôi.
Dialogue: 0,0:02:23.77,0:02:27.23,Default,,0,0,0,,Bên trong rào chắn có người bị thương đấy.
Dialogue: 0,0:02:27.23,0:02:28.94,Default,,0,0,0,,Đừng hòng tao cho chúng mày bước vào!
Dialogue: 0,0:02:29.57,0:02:33.16,Default,,0,0,0,,Có khi nói chuyện với Ohno\Nlại dễ lọt tai hơn đấy.
Dialogue: 0,0:02:33.15,0:02:34.82,Default,,0,0,0,,Tao biết tỏng tụi mày định làm gì rồi.
Dialogue: 0,0:02:34.82,0:02:37.61,Default,,0,0,0,,Chúng mày tính biến hình giống Watamaki
Dialogue: 0,0:02:37.62,0:02:39.58,Default,,0,0,0,,rồi lao vào tấn công bọn tao đúng không?
Dialogue: 0,0:02:42.79,0:02:47.63,Default,,0,0,0,,Ohno, cậu nhìn thấy Watamaki biến hình à?
Dialogue: 0,0:02:47.63,0:02:49.17,Default,,0,0,0,,Ừ, tớ thấy rồi.
Dialogue: 0,0:02:49.17,0:02:51.42,Default,,0,0,0,,Mọi người ở đây đều tận mắt chứng kiến hết.
Dialogue: 0,0:02:51.92,0:02:54.34,Default,,0,0,0,,Watamaki bước ra khỏi khoang Caliculus,
Dialogue: 0,0:02:54.88,0:02:56.80,Default,,0,0,0,,biến thành một con quái vật không mặt,
Dialogue: 0,0:02:57.34,0:02:59.34,Default,,0,0,0,,rồi lao vào tấn công Beroshi.
Dialogue: 0,0:02:59.93,0:03:01.10,Default,,0,0,0,,Chẳng lẽ các cậu...
Dialogue: 0,0:03:01.81,0:03:03.85,Default,,0,0,0,,Các cậu bỏ mặc Beroshi chết luôn ở đó sao?
Dialogue: 0,0:03:04.94,0:03:08.61,Default,,0,0,0,,Kondo, câm họng lại ngay.\NCậu chẳng biết chuyện gì đã xảy ra đâu.
Dialogue: 0,0:03:09.19,0:03:11.61,Default,,0,0,0,,Tada với Aida đang nằm trong cửa hàng với\Nvết thương nghiêm trọng
Dialogue: 0,0:03:11.61,0:03:14.32,Default,,0,0,0,,vì những gì Watamaki đã gây ra cho hai cậu ấy.
Dialogue: 0,0:03:14.32,0:03:18.07,Default,,0,0,0,,{\i1}Nếu không có Beroshi ở đó,\Nhẳn đã có nhiều người bỏ mạng hơn nữa rồi.{\i0}
Dialogue: 0,0:03:18.07,0:03:20.45,Default,,0,0,0,,{\i1}Cậu ấy đã lấy mạng sống ra đánh đổi\Nđể bảo vệ bọn tớ.{\i0}
Dialogue: 0,0:03:20.95,0:03:23.49,Default,,0,0,0,,{\i1}Không còn cách nào khác! Tụi tớ buộc phải chạy thoát thân!{\i0}
Dialogue: 0,0:03:24.08,0:03:27.50,Default,,0,0,0,,Sau đó tụi tớ cắm đầu chạy ra sảnh lớn,
Dialogue: 0,0:03:27.50,0:03:31.00,Default,,0,0,0,,chỉ để thấy con quái vật khổng lồ kia\Nđang nổi cơn thịnh nộ tàn phá.
Dialogue: 0,0:03:34.63,0:03:36.42,Default,,0,0,0,,{\i1}Bọn tớ dìu Tada và Aida tới đây{\i0}
Dialogue: 0,0:03:36.43,0:03:39.31,Default,,0,0,0,,{\i1}và suýt soát mới thoát chết chui vào được cửa hàng này.{\i0}
Dialogue: 0,0:03:39.89,0:03:41.06,Default,,0,0,0,,{\i1}Gamo nói đúng đấy.{\i0}
Dialogue: 0,0:03:41.06,0:03:44.48,Default,,0,0,0,,{\i1}Con người bình thường đời nào đấu lại nổi\Nmột con quái vật to lớn đến nhường ấy.{\i0}
Dialogue: 0,0:03:45.39,0:03:50.60,Default,,0,0,0,,Vậy nên cho tới khi các cậu chứng minh được\Nmình vẫn là con người giống tụi tớ,
Dialogue: 0,0:03:50.61,0:03:52.65,Default,,0,0,0,,bọn tớ tuyệt đối không để các cậu bước qua đây.
Dialogue: 0,0:03:53.69,0:03:56.32,Default,,0,0,0,,Tụi tớ đâu chỉ giao chiến với mỗi\Ntên quái đầu nhọn đó đâu.
Dialogue: 0,0:03:57.61,0:03:59.95,Default,,0,0,0,,Tụi tớ cũng đã vô hiệu hóa được Watamaki
Dialogue: 0,0:03:59.95,0:04:01.83,Default,,0,0,0,,khi chạm mặt cậu ấy trong Phòng Chơi (Playroom).
Dialogue: 0,0:04:02.41,0:04:07.83,Default,,0,0,0,,Và tụi tớ đã đặt Miura nằm yên nghỉ\Nbên trong một khoang Caliculus.
Dialogue: 0,0:04:10.46,0:04:11.59,Default,,0,0,0,,Beroshi...
Dialogue: 0,0:04:12.21,0:04:13.46,Default,,0,0,0,,Cậu ấy chết rồi sao?
Dialogue: 0,0:04:23.47,0:04:24.43,Default,,0,0,0,,Beroshi...
Dialogue: 0,0:04:25.43,0:04:27.31,Default,,0,0,0,,Này, thằng anh song sinh kia.
Dialogue: 0,0:04:27.31,0:04:30.31,Default,,0,0,0,,Dẹp hết mấy chuyện đó qua một bên đi.\NÝ mày "vô hiệu hóa" là sao hả?
Dialogue: 0,0:04:33.02,0:04:35.73,Default,,0,0,0,,Dẹp qua một bên cơ à?
Dialogue: 0,0:04:36.44,0:04:38.86,Default,,0,0,0,,Các cậu đã làm gì Watamaki rồi?
Dialogue: 0,0:04:38.86,0:04:41.45,Default,,0,0,0,,Đừng nói với tớ là các cậu giết cậu ấy rồi nhé!
Dialogue: 0,0:04:41.45,0:04:42.99,Default,,0,0,0,,Tụi tớ không hề giết Watamaki.
Dialogue: 0,0:04:43.49,0:04:46.20,Default,,0,0,0,,Nhưng có điều hơi khó...
Dialogue: 0,0:04:47.58,0:04:49.71,Default,,0,0,0,,để giải thích tụi tớ đã làm gì với cậu ấy.
Dialogue: 0,0:04:49.71,0:04:52.21,Default,,0,0,0,,Bớt xạo đi. Biết ngay mà. Tụi mày đích thị là--
Dialogue: 0,0:04:52.21,0:04:54.00,Default,,0,0,0,,Gamo, im miệng một lát đi!
Dialogue: 0,0:05:00.09,0:05:04.09,Default,,0,0,0,,Cái gì cơ? Tao là lớp trưởng đấy nhé.
Dialogue: 0,0:05:04.10,0:05:06.77,Default,,0,0,0,,Chính mày mới là kẻ phải ngậm mồm lại đấy!
Dialogue: 0,0:05:15.86,0:05:17.78,Default,,0,0,0,,Lớp trưởng cái nỗi gì không biết.
Dialogue: 0,0:05:17.78,0:05:20.62,Default,,0,0,0,,Lúc Beroshi bị Watamaki tấn công,
Dialogue: 0,0:05:20.61,0:05:22.95,Default,,0,0,0,,cậu bỏ chạy thẳng cẳng chẳng thèm giúp lấy một tay.
Dialogue: 0,0:05:26.83,0:05:29.71,Default,,0,0,0,,Vừa nãy cũng chính tụi này đứng chặn\Ngiữ hàng rào trong khi
Dialogue: 0,0:05:29.71,0:05:31.88,Default,,0,0,0,,cậu chỉ biết co rúm trốn tít đằng sau.
Dialogue: 0,0:05:36.34,0:05:37.55,Default,,0,0,0,,Chuyện đó là tại vì...
Dialogue: 0,0:05:39.05,0:05:40.80,Default,,0,0,0,,Tao là thủ lĩnh mà.
Dialogue: 0,0:05:40.80,0:05:44.05,Default,,0,0,0,,Tao mà ngã xuống thì ai đứng ra\Ngắn kết cả lớp đây?
Dialogue: 0,0:05:44.05,0:05:47.26,Default,,0,0,0,,Chính tao là người tìm ra\Nkhu an toàn này cho mọi người đấy!
Dialogue: 0,0:05:50.56,0:05:51.60,Default,,0,0,0,,Thôi được rồi.
Dialogue: 0,0:05:52.44,0:05:56.74,Default,,0,0,0,,Tụi này sẽ tự xử lý vụ Kondo và anh em Ashihara,\Ndù họ có khả năng là quái vật đi nữa.
Dialogue: 0,0:05:57.40,0:06:00.53,Default,,0,0,0,,Còn thủ lĩnh thì cứ việc trốn ở chỗ\Nan toàn đi là đúng bài rồi nhỉ?
Dialogue: 0,0:06:03.57,0:06:07.87,Default,,0,0,0,,Muốn tự gánh thì cứ tự nhiên đi mà lo.
Dialogue: 0,0:06:08.45,0:06:13.12,Default,,0,0,0,,Nhưng tuyệt đối không được cho bất kỳ ai\Ntrong ba đứa kia bước vào bằng mọi giá.
Dialogue: 0,0:06:18.50,0:06:20.63,Default,,0,0,0,,Gọi chỗ này là khu an toàn cơ đấy,
Dialogue: 0,0:06:20.63,0:06:23.38,Default,,0,0,0,,nhưng chẳng thấy an toàn tẹo nào cả.
Dialogue: 0,0:06:23.97,0:06:28.14,Default,,0,0,0,,Này, Yu, lỡ một tên Đầu Chóp nữa lao tới,
Dialogue: 0,0:06:28.14,0:06:31.48,Default,,0,0,0,,thì cái hàng rào kia chắc trụ không nổi mười giây đâu.
Dialogue: 0,0:06:36.56,0:06:37.39,Default,,0,0,0,,Với lại...
Dialogue: 0,0:06:38.32,0:06:41.32,Default,,0,0,0,,bộ cậu không còn cái gì tử tế hơn\Nđể khoác lên người thật đấy à?
Dialogue: 0,0:06:41.32,0:06:42.95,Default,,0,0,0,,Thì chỉ là cái áo khoác gió thôi mà.
Dialogue: 0,0:06:42.95,0:06:44.41,Default,,0,0,0,,Ồn ào quá đi, im miệng.
Dialogue: 0,0:06:44.99,0:06:47.24,Default,,0,0,0,,Ashihara, kể rõ cho tụi tớ nghe chuyện gì đã xảy ra đi.
Dialogue: 0,0:06:47.83,0:06:49.79,Default,,0,0,0,,Rốt cuộc cậu đã làm gì Watamaki?
Dialogue: 0,0:06:49.79,0:06:53.04,Default,,0,0,0,,Nếu không phải giết cậu ấy,\Nlàm sao cậu khiến cậu ấy ngừng tấn công được?
Dialogue: 0,0:06:55.92,0:06:57.05,Default,,0,0,0,,Tớ đã dùng ma pháp.
Dialogue: 0,0:07:17.65,0:07:19.36,Default,,0,0,0,,Được rồi, để tớ thử cầm xem nào.
Dialogue: 0,0:07:22.15,0:07:23.11,Default,,0,0,0,,Nhấc được rồi.
Dialogue: 0,0:07:23.11,0:07:24.19,Default,,0,0,0,,Gì cơ?!
Dialogue: 0,0:07:27.57,0:07:29.57,Default,,0,0,0,,Vậy chỉ cần biến đổi QREST giống của cậu,
Dialogue: 0,0:07:29.58,0:07:31.79,Default,,0,0,0,,là tụi tớ cũng nhấc nổi cây búa kia sao?
Dialogue: 0,0:07:31.79,0:07:32.83,Default,,0,0,0,,Chắc là thế đấy.
Dialogue: 0,0:07:33.58,0:07:34.96,Default,,0,0,0,,Làm thế nào mới được vậy?
Dialogue: 0,0:07:34.96,0:07:36.71,Default,,0,0,0,,Có phải nạp tiền hay trả phí gì không thế?
Dialogue: 0,0:07:36.71,0:07:38.34,Default,,0,0,0,,Nạp tiền cái gì chứ!
Dialogue: 0,0:07:39.08,0:07:40.17,Default,,0,0,0,,Tớ sẽ chỉ cho các cậu cách làm.
Dialogue: 0,0:07:40.84,0:07:44.05,Default,,0,0,0,,Nhưng chuyện này vô cùng quan trọng.
Dialogue: 0,0:07:44.05,0:07:45.84,Default,,0,0,0,,Tớ muốn giải thích rõ cho cả lớp cùng nghe.
Dialogue: 0,0:07:47.72,0:07:51.02,Default,,0,0,0,,Hiểu rồi. Để tớ vào thuyết phục Gamo.
Dialogue: 0,0:08:21.21,0:08:23.75,Default,,0,0,0,,{\i1}Vậy là có 17 người tới được đây.{\i0}
Dialogue: 0,0:08:24.80,0:08:26.34,Default,,0,0,0,,Mấy bạn còn lại đâu hết rồi?
Dialogue: 0,0:08:26.34,0:08:27.59,Default,,0,0,0,,Tụi tớ cũng không rõ.
Dialogue: 0,0:08:27.59,0:08:31.84,Default,,0,0,0,,Chẳng phải mọi người đã cùng nhau chạy xuống\Ntừ Phòng Chơi trên tầng hai sao?
Dialogue: 0,0:08:31.85,0:08:34.73,Default,,0,0,0,,Không. Thang máy lúc đó bị hỏng,
Dialogue: 0,0:08:34.72,0:08:36.89,Default,,0,0,0,,cầu thang bộ thì chen chúc nghẹt thở như cá mòi.
Dialogue: 0,0:08:36.89,0:08:40.27,Default,,0,0,0,,Những người bị kẹt ở phía sau\Nđã phải chạy ngược lên tầng ba.
Dialogue: 0,0:08:40.98,0:08:42.69,Default,,0,0,0,,{\i1}Bên nữ có Fujikawa...{\i0}
Dialogue: 0,0:08:43.57,0:08:44.61,Default,,0,0,0,,{\i1}...và Teragami.{\i0}
Dialogue: 0,0:08:45.53,0:08:47.28,Default,,0,0,0,,{\i1}Bên nam thì có Niki,{\i0}
Dialogue: 0,0:08:47.86,0:08:49.74,Default,,0,0,0,,{\i1}Haizaki, cùng đám bạn nhóm đó.{\i0}
Dialogue: 0,0:08:50.41,0:08:51.95,Default,,0,0,0,,Tầng ba sao...
Dialogue: 0,0:08:53.66,0:08:56.62,Default,,0,0,0,,Dù cho có con quái vật khác\Nxuất hiện trên tầng ba,
Dialogue: 0,0:08:56.62,0:09:00.96,Default,,0,0,0,,tớ chẳng nghĩ Niki hay Haizaki\Nlại dễ dàng gục ngã đến thế đâu.
Dialogue: 0,0:09:00.96,0:09:03.13,Default,,0,0,0,,Sao cậu lại cho tụi nó bước vào đây làm gì?
Dialogue: 0,0:09:03.13,0:09:05.59,Default,,0,0,0,,Giờ tính sao đây?\NBọn họ nguy hiểm lắm đấy.
Dialogue: 0,0:09:11.18,0:09:14.81,Default,,0,0,0,,Lúc nãy cậu bảo có cách cường hóa QREST.
Dialogue: 0,0:09:14.81,0:09:16.10,Default,,0,0,0,,Làm thế nào mới được vậy?
Dialogue: 0,0:09:22.69,0:09:25.65,Default,,0,0,0,,Này, đừng có câu giờ nữa. Nói toạc ra nhanh lên.
Dialogue: 0,0:09:25.65,0:09:28.53,Default,,0,0,0,,Đúng đấy, tụi tao còn khối việc khác phải làm.
Dialogue: 0,0:09:51.34,0:09:54.30,Default,,0,0,0,,Sau khi hạ xong con quái vật đầu nhọn,
Dialogue: 0,0:09:54.30,0:09:56.76,Default,,0,0,0,,bọn tớ đã đi kiểm tra khu vực lối ra vào.
Dialogue: 0,0:09:57.39,0:10:00.23,Default,,0,0,0,,Tụi tớ thử đập vỡ mấy ô cửa kính,\Nnhưng chẳng ăn thua gì.
Dialogue: 0,0:10:00.23,0:10:03.73,Default,,0,0,0,,Chuyện, thằng nhóc còi cọc như mày\Nlàm sao mà đập sứt mẻ nổi chứ.
Dialogue: 0,0:10:03.73,0:10:05.31,Default,,0,0,0,,Không phải Yu đập đâu.
Dialogue: 0,0:10:05.31,0:10:09.65,Default,,0,0,0,,Chính tao vung cây búa này nện thẳng vào,\Nmà kính còn chẳng rạn nổi một vết.
Dialogue: 0,0:10:21.46,0:10:23.09,Default,,0,0,0,,Tớ tin lời cậu ta đấy.
Dialogue: 0,0:10:24.00,0:10:25.25,Default,,0,0,0,,Cái thằng ngốc này.
Dialogue: 0,0:10:25.25,0:10:29.34,Default,,0,0,0,,Có lẽ không chỉ riêng cửa kính\Nvà cửa tự động mới không thể phá vỡ đâu.
Dialogue: 0,0:10:29.92,0:10:32.34,Default,,0,0,0,,Toàn bộ mặt kính ở sảnh chính\Nđều tối đen như mực,
Dialogue: 0,0:10:32.34,0:10:34.30,Default,,0,0,0,,tụi mình chẳng nhìn thấy gì bên ngoài cả,
Dialogue: 0,0:10:34.30,0:10:36.30,Default,,0,0,0,,và QREST cũng hoàn toàn mất kết nối mạng.
Dialogue: 0,0:10:36.93,0:10:41.02,Default,,0,0,0,,Nói cách khác, chừng nào chưa tìm ra\Nnguyên nhân gây ra chuyện này,
Dialogue: 0,0:10:41.02,0:10:43.73,Default,,0,0,0,,thì việc thoát khỏi khu Altea là bất khả thi.
Dialogue: 0,0:10:51.94,0:10:56.15,Default,,0,0,0,,Vậy nên trước mắt, chúng ta phải bảo vệ\Nnơi trú ẩn duy nhất hiện có
Dialogue: 0,0:10:56.16,0:10:59.29,Default,,0,0,0,,và trao cho tất cả mọi người ở đây\Nsức mạnh để tự vệ.
Dialogue: 0,0:10:59.28,0:11:00.70,Default,,0,0,0,,Đó chính là ưu tiên hàng đầu lúc này.
Dialogue: 0,0:11:01.20,0:11:03.62,Default,,0,0,0,,Chuyện đó không tới lượt mày quyết định.
Dialogue: 0,0:11:03.62,0:11:06.50,Default,,0,0,0,,Tao là lớp trưởng,\Nvà tao cũng là người tìm thấy chỗ này.
Dialogue: 0,0:11:06.50,0:11:09.88,Default,,0,0,0,,Nên hiển nhiên chính tao mới là người\Nquyết định bước tiếp theo phải làm gì!
Dialogue: 0,0:11:11.09,0:11:12.09,Default,,0,0,0,,Ventus!
Dialogue: 0,0:11:23.85,0:11:24.85,Default,,0,0,0,,Avis!
Dialogue: 0,0:11:32.36,0:11:33.53,Default,,0,0,0,,Ignis!
Dialogue: 0,0:11:48.88,0:11:51.80,Default,,0,0,0,,Đó là phép thuật, đúng không?
Dialogue: 0,0:11:52.63,0:11:53.88,Default,,0,0,0,,Trong tựa game Actual Magic.
Dialogue: 0,0:11:53.88,0:11:56.59,Default,,0,0,0,,Đời nào. Chắc chỉ là trò ảo thuật bịp bợm thôi.
Dialogue: 0,0:11:57.88,0:11:59.13,Default,,0,0,0,,Tớ không nghĩ vậy đâu.
Dialogue: 0,0:12:01.05,0:12:03.55,Default,,0,0,0,,Vừa nãy tớ cảm nhận rõ luồng gió thổi qua.
Dialogue: 0,0:12:04.52,0:12:07.98,Default,,0,0,0,,QREST vốn dĩ không hỗ trợ\Ncảm giác xúc giác vật lý,
Dialogue: 0,0:12:07.98,0:12:11.07,Default,,0,0,0,,vậy nên nếu cảm thấy gió thổi thực sự,\Nthì đó không phải hiệu ứng AR đâu.
Dialogue: 0,0:12:11.82,0:12:13.70,Default,,0,0,0,,Đó không phải trò bịp.
Dialogue: 0,0:12:13.69,0:12:15.65,Default,,0,0,0,,Đó chính là ma pháp thực thụ.
Dialogue: 0,0:12:15.65,0:12:20.65,Default,,0,0,0,,Vậy cậu đã dùng ma pháp\Nđể đánh bại con quái vật kia sao?
Dialogue: 0,0:12:20.66,0:12:23.66,Default,,0,0,0,,Không chỉ con quái đó đâu. Cả Watamaki nữa.
Dialogue: 0,0:12:23.66,0:12:24.91,Default,,0,0,0,,Không phải.
Dialogue: 0,0:12:24.91,0:12:27.29,Default,,0,0,0,,Đúng là tụi tớ đã tiêu diệt con quái vật kia.
Dialogue: 0,0:12:27.29,0:12:28.42,Default,,0,0,0,,Nhưng còn Watamaki thì...
Dialogue: 0,0:12:29.67,0:12:31.84,Default,,0,0,0,,Tụi tớ chỉ phong ấn cậu ấy lại\Nđể cậu ấy không thể cử động thôi.
Dialogue: 0,0:12:32.34,0:12:36.68,Default,,0,0,0,,Tớ nhất định sẽ tìm ra cách\Ngiúp Watamaki trở lại làm người.
Dialogue: 0,0:12:37.17,0:12:38.59,Default,,0,0,0,,Biến cậu ấy trở lại bình thường á?
Dialogue: 0,0:12:38.59,0:12:40.59,Default,,0,0,0,,Chuyện đó thật sự khả thi sao?
Dialogue: 0,0:12:41.18,0:12:42.76,Default,,0,0,0,,Tớ tin là sẽ có cách.
Dialogue: 0,0:12:43.60,0:12:45.10,Default,,0,0,0,,Chắc chắn phải có cách.
Dialogue: 0,0:12:47.18,0:12:48.10,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:12:49.06,0:12:51.90,Default,,0,0,0,,Ashihara, tớ tin cậu.
Dialogue: 0,0:12:51.90,0:12:54.65,Default,,0,0,0,,Từ giờ trở đi, tớ sẽ nghe theo chỉ dẫn của cậu.
Dialogue: 0,0:12:54.65,0:12:56.36,Default,,0,0,0,,Cảm ơn cậu nhé, Ohno.
Dialogue: 0,0:12:58.20,0:13:02.62,Default,,0,0,0,,Vậy thì được rồi.\NTớ sẽ chỉ cho tất cả mọi người cách sử dụng ma pháp.
Dialogue: 0,0:13:08.96,0:13:11.25,Default,,0,0,0,,{\i1}Liệu mình làm thế này có đúng không đây?{\i0}
Dialogue: 0,0:13:18.22,0:13:19.30,Default,,0,0,0,,Anh Yu?
Dialogue: 0,0:13:29.06,0:13:31.35,Default,,0,0,0,,Nào, chúng ta bắt đầu thôi.
Dialogue: 0,0:13:42.99,0:13:45.20,Default,,0,0,0,,Giờ tất cả mọi người đều đã chuyển đổi
Dialogue: 0,0:13:45.20,0:13:48.20,Default,,0,0,0,,sang đúng chức nghiệp đã chọn\Ntrong đợt thử nghiệm Actual Magic rồi.
Dialogue: 0,0:13:48.79,0:13:49.79,Default,,0,0,0,,Thật luôn hả?!
Dialogue: 0,0:13:49.79,0:13:53.21,Default,,0,0,0,,{\an8}YOICHI OHNO - HARUKI HOKARI\NTAKESHI MORO - TAKATO SERA
Dialogue: 0,0:13:53.96,0:13:57.71,Default,,0,0,0,,Pháp sư và tu sĩ hẳn là đã có thể\Nthực thi phép thuật,
Dialogue: 0,0:13:57.71,0:14:00.05,Default,,0,0,0,,chiến binh sẽ khỏe mạnh hơn hẳn,
Dialogue: 0,0:14:00.05,0:14:02.84,Default,,0,0,0,,còn đạo tặc và thợ săn\Nsẽ di chuyển linh hoạt nhanh nhẹn hơn.
Dialogue: 0,0:14:11.69,0:14:12.90,Default,,0,0,0,,Ashihara này.
Dialogue: 0,0:14:13.52,0:14:16.06,Default,,0,0,0,,Xin lỗi vì lúc nãy đã đối xử với cậu\Nnhư một con quái vật nhé.
Dialogue: 0,0:14:16.06,0:14:18.69,Default,,0,0,0,,Không đâu, tớ chẳng trách cậu chút nào cả.
Dialogue: 0,0:14:18.69,0:14:20.02,Default,,0,0,0,,Dù vậy tớ vẫn thấy day dứt không yên.
Dialogue: 0,0:14:20.03,0:14:22.07,Default,,0,0,0,,Giá mà tụi mình biết chuyện này sớm hơn,
Dialogue: 0,0:14:22.07,0:14:25.03,Default,,0,0,0,,có lẽ tụi mình đã cứu được Beroshi rồi.
Dialogue: 0,0:14:28.37,0:14:31.08,Default,,0,0,0,,Cậu cười cái gì thế hả?
Dialogue: 0,0:14:31.08,0:14:33.62,Default,,0,0,0,,Không cười thì làm gì được? Thua là thua rồi.
Dialogue: 0,0:14:33.62,0:14:35.33,Default,,0,0,0,,Đội bên kia chơi hay hơn tụi mình thật mà.
Dialogue: 0,0:14:35.33,0:14:36.79,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:14:36.79,0:14:39.13,Default,,0,0,0,,Đừng lo nhé, Yoi.
Dialogue: 0,0:14:39.13,0:14:42.59,Default,,0,0,0,,Rồi một ngày nào đó, tớ sẽ trở thành\Nhậu vệ xuất sắc nhất cả giải đấu
Dialogue: 0,0:14:42.59,0:14:44.63,Default,,0,0,0,,và giúp cậu giành chiến thắng.
Dialogue: 0,0:14:44.63,0:14:45.92,Default,,0,0,0,,Beroshi à.
Dialogue: 0,0:14:47.14,0:14:48.68,Default,,0,0,0,,Nghe cho rõ đây, thằng dự bị kia!
Dialogue: 0,0:14:48.68,0:14:51.18,Default,,0,0,0,,Tao là đội trưởng,\Nkhông tới lượt mày lên mặt dạy đời tao đâu!
Dialogue: 0,0:14:53.89,0:14:55.18,Default,,0,0,0,,Thế là ổn rồi, phải không?
Dialogue: 0,0:15:00.15,0:15:01.48,Default,,0,0,0,,Beroshi!
Dialogue: 0,0:15:02.15,0:15:04.86,Default,,0,0,0,,Chạy đi! Yoi!
Dialogue: 0,0:15:05.36,0:15:06.82,Default,,0,0,0,,Ohno ơi!
Dialogue: 0,0:15:13.91,0:15:16.16,Default,,0,0,0,,Beroshi đã cứu mạng tất cả bọn tớ.
Dialogue: 0,0:15:16.17,0:15:18.38,Default,,0,0,0,,Tụi mình nợ cậu ấy một lời thề phải sống sót thoát khỏi đây.
Dialogue: 0,0:15:20.17,0:15:21.42,Default,,0,0,0,,Mọi người tập trung nghe chút nhé.
Dialogue: 0,0:15:21.42,0:15:25.42,Default,,0,0,0,,Ở đây có ai chọn chức nghiệp tu sĩ\Nthì giơ tay lên giùm tớ.
Dialogue: 0,0:15:26.93,0:15:28.06,Default,,0,0,0,,Tớ chọn này.
Dialogue: 0,0:15:31.06,0:15:32.48,Default,,0,0,0,,Tớ nữa!
Dialogue: 0,0:15:33.93,0:15:35.56,Default,,0,0,0,,Đừng có vênh váo quá đấy.
Dialogue: 0,0:15:36.06,0:15:38.02,Default,,0,0,0,,Chỉ có ba người thôi à?
Dialogue: 0,0:15:38.02,0:15:40.65,Default,,0,0,0,,Ừ. Ít hơn tớ tưởng nhiều đấy.
Dialogue: 0,0:15:40.65,0:15:42.28,Default,,0,0,0,,Shimizu, Soga,
Dialogue: 0,0:15:42.28,0:15:45.66,Default,,0,0,0,,và Moro hẳn đều có thể\Ndùng được ma pháp trị liệu.
Dialogue: 0,0:15:45.65,0:15:48.11,Default,,0,0,0,,Nhờ ba cậu chữa trị cho những người bị thương nhé.
Dialogue: 0,0:15:49.03,0:15:51.95,Default,,0,0,0,,Phải rồi. Bọn mình có thể trị thương bằng ma pháp mà.
Dialogue: 0,0:15:56.29,0:15:57.12,Default,,0,0,0,,Moro.
Dialogue: 0,0:15:58.29,0:15:59.54,Default,,0,0,0,,Gì thế?
Dialogue: 0,0:16:01.21,0:16:04.38,Default,,0,0,0,,Làm ơn. Chữa cho Tada và Aida đi.
Dialogue: 0,0:16:04.38,0:16:06.84,Default,,0,0,0,,Beroshi đã hy sinh tính mạng để bảo vệ hai cậu ấy.
Dialogue: 0,0:16:08.13,0:16:10.09,Default,,0,0,0,,Ohno đang nhờ vả Mo-yan thật kìa?
Dialogue: 0,0:16:10.10,0:16:11.77,Default,,0,0,0,,Không thể tin nổi luôn.
Dialogue: 0,0:16:13.64,0:16:16.10,Default,,0,0,0,,Được thôi. Để tớ thử xem sao.
Dialogue: 0,0:16:19.10,0:16:20.73,Default,,0,0,0,,Mo-yan ngầu đét luôn!
Dialogue: 0,0:16:21.61,0:16:23.70,Default,,0,0,0,,Khoan, câu thần chú là gì vậy ta?
Dialogue: 0,0:16:24.61,0:16:26.57,Default,,0,0,0,,Đùa nhau đấy à?!
Dialogue: 0,0:16:33.20,0:16:34.20,Default,,0,0,0,,Sacre!
Dialogue: 0,0:16:40.17,0:16:41.05,Default,,0,0,0,,Premis!
Dialogue: 0,0:16:43.63,0:16:46.97,Default,,0,0,0,,Fusione! Thánh Trị Liệu!
Dialogue: 0,0:16:58.85,0:17:00.06,Default,,0,0,0,,Hết đau thật rồi!
Dialogue: 0,0:17:01.23,0:17:02.77,Default,,0,0,0,,À thực ra vẫn còn hơi nhói một tí.
Dialogue: 0,0:17:02.77,0:17:04.19,Default,,0,0,0,,Rốt cuộc là hết hay chưa thế hả?
Dialogue: 0,0:17:05.78,0:17:07.62,Default,,0,0,0,,Tớ ổn, tớ ổn hoàn toàn rồi.
Dialogue: 0,0:17:08.57,0:17:10.07,Default,,0,0,0,,Ma pháp đỉnh quá trời!
Dialogue: 0,0:17:10.70,0:17:12.20,Default,,0,0,0,,Thành công rồi!
Dialogue: 0,0:17:12.20,0:17:14.03,Default,,0,0,0,,Xin mời bệnh nhân tiếp theo!
Dialogue: 0,0:17:14.03,0:17:16.78,Default,,0,0,0,,Cậu nghe giống bác sĩ hơn là\Ntu sĩ rồi đấy.
Dialogue: 0,0:17:21.67,0:17:23.42,Default,,0,0,0,,Cơn đau biến mất thật luôn này!
Dialogue: 0,0:17:23.96,0:17:25.96,Default,,0,0,0,,Được rồi, nhưng đừng kích động quá!
Dialogue: 0,0:17:27.55,0:17:29.38,Default,,0,0,0,,Đỉnh quá đi mất, Mo-yan!
Dialogue: 0,0:17:29.38,0:17:30.63,Default,,0,0,0,,Thật không thể tin nổi!
Dialogue: 0,0:17:32.47,0:17:35.51,Default,,0,0,0,,Kể từ hôm nay trở đi,\Nmấy cậu cứ gọi tớ là Đại Tư Tế nhé!
Dialogue: 0,0:17:35.51,0:17:37.05,Default,,0,0,0,,Đừng có tự mãn thế chứ.
Dialogue: 0,0:17:37.06,0:17:39.31,Default,,0,0,0,,Mà công nhận đỉnh thật đấy.
Dialogue: 0,0:17:39.31,0:17:41.31,Default,,0,0,0,,Lát nữa chỉ bí kíp cho tớ với nhé?
Dialogue: 0,0:17:41.31,0:17:43.06,Default,,0,0,0,,Tớ nữa nhé.
Dialogue: 0,0:17:43.06,0:17:44.85,Default,,0,0,0,,Làm tốt lắm, Moro!
Dialogue: 0,0:17:45.44,0:17:46.48,Default,,0,0,0,,Các cậu...
Dialogue: 0,0:17:46.48,0:17:48.52,Default,,0,0,0,,Trông cậy cả vào ngài đấy, Đại Tư Tế!
Dialogue: 0,0:17:49.65,0:17:50.94,Default,,0,0,0,,Ừm!
Dialogue: 0,0:17:50.95,0:17:52.12,Default,,0,0,0,,Anh Yu!
Dialogue: 0,0:17:55.33,0:17:56.71,Default,,0,0,0,,Thứ gì kia?!
Dialogue: 0,0:18:10.47,0:18:12.14,Default,,0,0,0,,Yu, cứ giữ nguyên nó ở chỗ đó!
Dialogue: 0,0:18:24.19,0:18:26.07,Default,,0,0,0,,Hả? Đánh trúng luôn à?
Dialogue: 0,0:18:26.69,0:18:28.32,Default,,0,0,0,,Đó là sát thương lan đấy.
Dialogue: 0,0:18:29.90,0:18:33.49,Default,,0,0,0,,Mọi người ơi, đám bọ này dễ tiêu diệt lắm\Nnếu đánh trúng bằng thứ gì cứng cáp...
Dialogue: 0,0:18:40.91,0:18:43.41,Default,,0,0,0,,Tụi mình phải tự xử lý đám này thôi.
Dialogue: 0,0:18:43.41,0:18:45.58,Default,,0,0,0,,Sawa, đá văng lũ giun ra đi.
Dialogue: 0,0:18:45.58,0:18:47.67,Default,,0,0,0,,Konken, vung búa nghiền nát chúng đi.
Dialogue: 0,0:18:47.67,0:18:48.92,Default,,0,0,0,,Rõ!
Dialogue: 0,0:18:48.92,0:18:50.09,Default,,0,0,0,,Thế còn cậu?
Dialogue: 0,0:18:50.59,0:18:52.34,Default,,0,0,0,,Tớ sẽ lo phần mình bằng thứ này.
Dialogue: 0,0:18:58.56,0:19:01.98,Default,,0,0,0,,ẤU TRÙNG RUỒI ĐỊA NGỤC TABANUS
Dialogue: 0,0:19:04.06,0:19:05.06,Default,,0,0,0,,Bọn mình làm được mà!
Dialogue: 0,0:19:14.82,0:19:16.57,Default,,0,0,0,,{\i1}Chỉ còn bảy tám con nữa thôi.{\i0}
Dialogue: 0,0:19:20.70,0:19:23.45,Default,,0,0,0,,Ashihara! Mau cứu Ruki đi!
Dialogue: 0,0:19:23.45,0:19:25.49,Default,,0,0,0,,Nhanh lên! Làm ơn đấy!
Dialogue: 0,0:19:37.39,0:19:38.72,Default,,0,0,0,,Xong rồi.
Dialogue: 0,0:19:38.72,0:19:40.39,Default,,0,0,0,,Ruki!
Dialogue: 0,0:19:40.39,0:19:41.64,Default,,0,0,0,,Có lẽ là dính độc rồi.
Dialogue: 0,0:19:41.64,0:19:43.35,Default,,0,0,0,,Cậu ấy sắp chết sao?
Dialogue: 0,0:19:43.35,0:19:45.85,Default,,0,0,0,,Không, khả năng cao chỉ là độc gây tê liệt thôi.
Dialogue: 0,0:19:45.85,0:19:47.14,Default,,0,0,0,,Đợi một lát xem sao.
Dialogue: 0,0:19:47.69,0:19:50.36,Default,,0,0,0,,Ashihara ơi, Tomori bị...
Dialogue: 0,0:19:50.36,0:19:53.74,Default,,0,0,0,,Tomochi đã che chắn cho tớ,
Dialogue: 0,0:19:53.74,0:19:56.37,Default,,0,0,0,,vậy mà tớ chẳng làm được gì ngoài bỏ chạy.
Dialogue: 0,0:19:56.36,0:19:58.82,Default,,0,0,0,,Không phải lỗi của cậu đâu, Tsuda.
Dialogue: 0,0:19:58.82,0:20:01.28,Default,,0,0,0,,Tớ cũng có làm được gì kịp đâu.
Dialogue: 0,0:20:01.91,0:20:04.62,Default,,0,0,0,,Soga, cậu có dùng được phép giải độc không?
Dialogue: 0,0:20:04.62,0:20:06.83,Default,,0,0,0,,Ừ. Chắc là được đấy.
Dialogue: 0,0:20:06.83,0:20:09.67,Default,,0,0,0,,Vậy thử thi triển lên Shimizu xem.
Dialogue: 0,0:20:09.67,0:20:10.96,Default,,0,0,0,,Được.
Dialogue: 0,0:20:12.13,0:20:13.17,Default,,0,0,0,,Sacre.
Dialogue: 0,0:20:13.88,0:20:14.96,Default,,0,0,0,,Pluvia.
Dialogue: 0,0:20:16.38,0:20:17.59,Default,,0,0,0,,Tersus.
Dialogue: 0,0:20:18.89,0:20:21.56,Default,,0,0,0,,Thánh Tẩy!
Dialogue: 0,0:20:30.65,0:20:32.36,Default,,0,0,0,,Tomochi!
Dialogue: 0,0:20:32.90,0:20:34.65,Default,,0,0,0,,Cảm ơn cậu, Soga.
Dialogue: 0,0:20:34.65,0:20:36.69,Default,,0,0,0,,Cảm ơn cậu nhé, Ashihara.
Dialogue: 0,0:20:36.69,0:20:37.90,Default,,0,0,0,,Không có gì đâu.
Dialogue: 0,0:20:37.90,0:20:39.78,Default,,0,0,0,,Quan trọng hơn, hễ cậu cử động lại được rồi,
Dialogue: 0,0:20:39.78,0:20:41.32,Default,,0,0,0,,nhờ cậu và Soga tách nhau ra
Dialogue: 0,0:20:41.32,0:20:43.70,Default,,0,0,0,,rồi giải độc chữa trị cho tất cả những người bị tê liệt.
Dialogue: 0,0:20:43.70,0:20:45.62,Default,,0,0,0,,Ừ. Tớ hết sao rồi.
Dialogue: 0,0:20:46.33,0:20:47.66,Default,,0,0,0,,Moro đâu rồi?
Dialogue: 0,0:20:47.66,0:20:50.04,Default,,0,0,0,,Moro không có ở đây!
Dialogue: 0,0:20:50.04,0:20:52.33,Default,,0,0,0,,Ashihara, nhìn đằng kia kìa.
Dialogue: 0,0:21:08.02,0:21:09.23,Default,,0,0,0,,Mo-yan?
Dialogue: 0,0:21:11.65,0:21:13.32,Default,,0,0,0,,Thứ gì thế kia?
Dialogue: 0,0:21:13.31,0:21:15.10,Default,,0,0,0,,Một cái kén nhộng sao?
Dialogue: 0,0:21:16.65,0:21:17.69,Default,,0,0,0,,Konken, đập nát nó đi!
Dialogue: 0,0:21:22.37,0:21:24.66,Default,,0,0,0,,RUỒI ĐỊA NGỤC TABANUS
Dialogue: 0,0:21:24.66,0:21:28.20,Default,,0,0,0,,Chậm chừng mười giây nữa thôi là nó nở ra rồi.
Dialogue: 0,0:21:28.20,0:21:30.16,Default,,0,0,0,,Cậu ổn chứ, Moro?
Dialogue: 0,0:21:30.16,0:21:32.20,Default,,0,0,0,,Giờ cậu an toàn rồi.
Dialogue: 0,0:21:32.21,0:21:36.13,Default,,0,0,0,,Shimizu hoặc Soga có thể chữa cho cậu ngay lập tức.
Dialogue: 0,0:21:36.13,0:21:38.09,Default,,0,0,0,,Dậy nổi không, Mo-yan?
Dialogue: 0,0:21:46.68,0:21:47.85,Default,,0,0,0,,Có chuyện gì thế?
Dialogue: 0,0:21:48.56,0:21:49.77,Default,,0,0,0,,Cậu ấy chết rồi!
Dialogue: 0,0:23:27.99,0:23:28.91,Default,,0,0,0,,ÁC QUỶ
Dialogue: 0,0:23:28.91,0:23:30.16,Default,,0,0,0,,{\i1}Bảo vệ họ bằng mọi giá.{\i0}
Dialogue: 0,0:23:30.16,0:23:31.62,Default,,0,0,0,,{\i1}Xem ra chẳng cần nhiều người đến thế đâu nhỉ.{\i0}
Dialogue: 0,0:23:31.62,0:23:34.83,Default,,0,0,0,,{\i1}Ai cho phép mày tự tiện ra lệnh cho tụi tao thế?{\i0}
Dialogue: 0,0:23:34.83,0:23:35.96,Default,,0,0,0,,{\i1}Tỷ lệ đang tăng lên rồi.{\i0}
Dialogue: 0,0:23:35.96,0:23:36.96,Default,,0,0,0,,{\i1}Tớ nhìn thấy rồi đấy.{\i0}
Dialogue: 0,0:23:36.96,0:23:39.25,Default,,0,0,0,,{\i1}Sau đó, cậu ấy đã giúp Sera và Hokari.{\i0}
Dialogue: 0,0:23:39.25,0:23:40.79,Default,,0,0,0,,{\i1}Chỗ này thực sự có chuyện cực kỳ bất ổn rồi!{\i0}
Dialogue: 0,0:23:40.80,0:23:42.93,Default,,0,0,0,,{\i1}Rất vui được gặp cậu, Yuumy.{\i0}
